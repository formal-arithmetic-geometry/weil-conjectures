SHEAF_LIB="WeilConjectures Sheaf"   # stage 3: one package lean/, the source root WeilConjectures and the project root Sheaf
SHEAF_EARLY_REVIEW=0
SHEAF_FILE_TIMEOUT=60   # the human, 2026-10-12: every file compiles alone within 60 s; a file that does not has a badly written definition, which is what gets changed (never the limit)
SHEAF_FILE_RUN_LIMIT=120   # the human, 2026-10-26: a single-file compile runs up to 120 s (was 300 s; reduced the same night) so the slow part is shown; acceptance stays SHEAF_FILE_TIMEOUT=60
SHEAF_CLAIMS_PER_GROUP=4   # stage 3 (= slots per group, so no group holds items it cannot run); 8 until 23:25 JST; 30 until 2026-10-15 23:20 JST, when four groups held all 84 batch-2 items with 4 workers each
SHEAF_BUILD_THREADS=48   # 2026-10-25: 80-core server; the build runs at nice 0 and the compile spool at nice 19 under the slot governor, so the build takes the cores it needs (was 24; a 79-landing round rebuilt 5000+ modules in 80+ min)
SHEAF_BUILD_FAILFAST=0   # 2026-10-25 (the human): the global build runs to the end, every failure found in one build; the clean landings land from it (tools/batch_land.py land_rest)
SHEAF_CLAIM_TTL=72   # 2026-10-16: 6 h (default) expired the claims of returned deliveries, so their repairs were never dispatched

# Retirement of ~/weil-newtargets (2026-10-19): stages 1 and 2 of batches 2-5 run here. The DAG targets of stages 1/2
# (node ids); coord/nodes-batchN-targets.txt split them into batches (coord/batchN-targets.txt are the stage-3 target modules).
SHEAF_TARGET_LIST=coord/new-targets.txt

# Merge queue (the human, 2026-10-19): main = refs/heads/sheaf-verified, advanced only by green builds; every Lean
# change is a landing record; take-out = hard restore with the later landings of the same files (tools/landing.py)
SHEAF_MERGE_QUEUE=1

SHEAF_PIPELINE_BATCHES=0   # 2026-10-21 trial (the human): batch N+1 lands while the build of N runs (tools/batch_land.py NEXT); 0 = off
SHEAF_BATCH_POOL=24   # 2026-10-24 (the human: land everything ready at once while the build is idle; the slow check is capped at 120 s)
SHEAF_BATCH_MAX=1000000   # 2026-10-24 (the human): no cap, one landing round takes every checked delivery
