  "kind": "statement",
  "title": "Reality of coprime factors",
  "statement": "Let $A,B\\in1+T\\mathbf C[T]$ be coprime. If $A/B\\in\\mathbf R(T)$, then\n$A,B\\in\\mathbf R[T]$.",
  "source": {
    "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-general/sk-p-dl-general-relative-line/lem-zl-real-reduced-factors.md",
    "place": "node lem-zl-real-reduced-factors, order 2838"
  },
  "stmt_deps": [],
  "proof": [
    {
      "text": "Complex conjugation gives $A/B=\\overline A/\\overline B$, hence\n$A\\overline B=\\overline A B$. Unique factorization and coprimality show\nthat $A$ is a scalar multiple of $\\overline A$ and $B$ the same scalar\nmultiple of $\\overline B$. All four constant terms are one, so the\nscalar is one. Thus both polynomials are fixed by conjugation.",
      "uses": [],
      "elementary": null
    }
  ],
