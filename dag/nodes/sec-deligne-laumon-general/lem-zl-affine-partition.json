 "kind": "statement",
 "title": "A finite affine partition",
 "statement": "A Noetherian scheme $X$ has a finite partition by\nlocally closed reduced\naffine subschemes.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-general/sk-l-dl-general-normalization/lem-zl-affine-partition.md",
  "place": "node lem-zl-affine-partition, order 2825"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "Choose a finite affine open cover $U_1,\\ldots,U_m$.\nSet $S_i=U_i\\setminus\\bigcup_{j<i}U_j$, with its reduced\nclosed subscheme structure inside $U_i$.\nEach $S_i$ is affine, since it is closed in an affine scheme,\nand is locally closed in the sense of\n[def-weil-pbc-scheme-conventions]. Every point belongs\nto the piece indexed by the first $U_i$ containing it.\nHence these finitely many pieces are disjoint and cover $X$.",
   "uses": [
    "def-weil-pbc-scheme-conventions"
   ],
   "elementary": false
  }
 ],
