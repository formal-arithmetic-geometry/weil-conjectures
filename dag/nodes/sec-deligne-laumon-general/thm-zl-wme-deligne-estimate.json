{
 "id": "thm-zl-wme-deligne-estimate",
 "blueprint": {
  "is": "thm-zl-wme-deligne-estimate",
  "from": null,
  "same_as": null
 },
 "kind": "statement",
 "title": "General $Rf_!$ weight theorem",
 "statement": "For every separated finite-type morphism $f:X_0\\to Y_0$ of separated\nfinite-type $k_0$-schemes and every constructible $\\Qlb$-Weil complex\n$K$ (in the coefficient categories of\n[def-weil-pbc-qbar-category]),\n\n$$\nK\\in D_{\\le w}(X_0)\\quad\\Longrightarrow\\quad Rf_!K\\in D_{\\le w}(Y_0),\n$$\n\nwhere $D_{\\le w}$ is the complex-weight predicate of\n[def-weil-complex-weights].",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-general/sk-cor-dl-general-complex/thm-zl-wme-deligne-estimate.md",
  "place": "node thm-zl-wme-deligne-estimate, order 2851"
 },
 "stmt_deps": [
  "def-weil-pbc-qbar-category",
  "def-weil-complex-weights"
 ],
 "proof": [
  {
   "text": "By [cor-zl-rfshriek-sheaf], every mixed Weil sheaf $\\mathcal F$ of\nweights at most $v$ has $R^af_!\\mathcal F$ mixed of weights at most\n$v+a$, for every $a$. This is the hypothesis of\n[lem-zl-sheaves-to-complexes], which gives $Rf_!K\\in D_{\\le w}(Y_0)$.",
   "uses": [
    "cor-zl-rfshriek-sheaf",
    "lem-zl-sheaves-to-complexes"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
  "cor-zl-rfshriek-sheaf",
  "lem-zl-sheaves-to-complexes"
 ],
