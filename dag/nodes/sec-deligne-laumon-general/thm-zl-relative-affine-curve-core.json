 "kind": "statement",
 "title": "Pure lisse relative affine-curve step",
 "statement": "Fix the coefficient and weight conventions of\n[def-weil-punctual-weights]. Let $h:U_0\\to Y_0$ be a\nsmooth separated morphism\nbetween separated finite-type\n$k_0$-schemes, with every nonempty geometric fiber a smooth affine\ncurve. Let $\\mathcal F$ be a\nlisse\n$\\Qlb$-Weil sheaf that is\npunctually $\\iota$-pure of weight $w$.\nThen for every $i$, $R^ih_!\\mathcal F$ is $\\iota$-mixed of weights\nat most $w+i$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-general/sk-p-dl-general-relative-line/thm-zl-relative-affine-curve-core.md",
  "place": "node thm-zl-relative-affine-curve-core, order 2844"
 },
 "stmt_deps": [
  "def-weil-punctual-weights",
  "def-weil-pbc-constructible-complexes",
  "def-weil-pbc-scheme-conventions",
  "def-weil-scheme-morphism-properties"
 ],
 "proof": [
  {
   "text": "By [lem-zl-relative-curve-punctual], all local Frobenius\neigenvalues on $R^ih_!\\mathcal F$ have absolute value at most\n$q_y^{(w+i)/2}$. The curve-reduction lemma [lem-zl-relative-curve-mixedness]\nsupplies a finite mixed filtration of this sheaf. Apply\n[lem-zl-mixed-punctual-cutoff] with $v=w+i$.\nThis proves the bound without assuming that unrelated filtrations\nof the individual stalks glue to Weil subsheaves.",
   "uses": [
    "lem-zl-relative-curve-punctual",
    "lem-zl-relative-curve-mixedness",
    "lem-zl-mixed-punctual-cutoff"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
