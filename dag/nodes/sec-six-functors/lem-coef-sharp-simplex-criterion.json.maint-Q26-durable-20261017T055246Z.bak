  "statement": "theorem sharp_simplex_criterion (E B : SSet.{u}) (p : E ⟶ B) : (IsSharp p ↔ ∀ (n : ℕ) (σ : stdSimplex.{u}.obj ⦋n⦌ ⟶ B), IsHomotopyCartesian (pullback.fst p σ) (pullback.snd p σ) p σ) ∧ (IsSharp p ↔ ∀ (m n : ℕ) (δ : stdSimplex.{u}.obj ⦋m⦌ ⟶ stdSimplex.{u}.obj ⦋n⦌) (σ : stdSimplex.{u}.obj ⦋n⦌ ⟶ B), Enhanced.IsWeakHomotopyEquivalence (pullback.map p (δ ≫ σ) p σ (𝟙 E) δ (𝟙 B) (by simp) (by simp)))",
