  "thm-pur-weil-equivariance-of-purity-and-trace",
  "def-pur-scheme-geometric-frobenius"
 ],
 "proof": [
  {
   "text": "The isomorphisms $\\kappa_X,\\kappa_Y$ of\n[def-pur-scheme-geometric-frobenius] identify $L\\Phi^*$ with\n$Lg_\\gamma^*$ compatibly with the pullback-composition identifications\nand with $f$, so precomposing the vertical maps preserves the\ncommutativity of the squares.",
   "uses": [
    "def-pur-scheme-geometric-frobenius"
   ],
   "elementary": false
  }
 ],
