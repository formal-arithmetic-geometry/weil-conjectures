   "results": "[loogle] OK 12 hit(s)\n  {\"name\": \"CategoryTheory.Limits.IsColimit\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} (t : CategoryTheory.Limits.Cocone F) : Type (max (max u₁ u₃) v₃)\", \"doc\": \"A cocone `t` on `F` is a colimit cocone if each cocone on `F` admits a unique\\ncocone morphism from `t`. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.subsingleton\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {t : CategoryTheory.Limits.Cocone F} : Subsingleton (CategoryTheory.Limits.IsColimit t)\", \"doc\": \"\"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.ofCorepresentableBy\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {X : C} (h : F.cocones.CorepresentableBy X) : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.IsColimit.OfNatIso.colimitCocone h)\", \"doc\": \"If `F.cocones` is corepresentable, then the cocone corresponding to the identity morphism on\\nthe representing object is a colimit cocone.\\n\"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.corepresentableBy\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {t : CategoryTheory.Limits.Cocone F} (hc : CategoryTheory.Limits.IsColimit t) : F.cocones.CorepresentableBy t.pt\", \"doc\": \"Given a colimit cocone, `F.cocones` is corepresentable by the point of the cocone. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.desc\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {t : CategoryTheory.Limits.Cocone F} (self : CategoryTheory.Limits.IsColimit t) (s : CategoryTheory.Limits.Cocone F) : t.pt ⟶ s.pt\", \"doc\": \"`t.pt` maps to all other cocone covertices \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.ofIsoColimit\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {r t : CategoryTheory.Limits.Cocone F} (P : CategoryTheory.Limits.IsColimit r) (i : r ≅ t) : CategoryTheory.Limits.IsColimit t\", \"doc\": \"Transport evidence that a cocone is a colimit cocone across an isomorphism of cocones. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.uniqueUpToIso\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {s t : CategoryTheory.Limits.Cocone F} (P : CategoryTheory.Limits.IsColimit s) (Q : CategoryTheory.Limits.IsColimit t) : s ≅ t\", \"doc\": \"Colimit cocones on `F` are unique up to isomorphism. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.equivIsoColimit\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {r t : CategoryTheory.Limits.Cocone F} (i : r ≅ t) : CategoryTheory.Limits.IsColimit r ≃ CategoryTheory.Limits.IsColimit t\", \"doc\": \"Isomorphism of cocones preserves whether or not they are colimiting cocones. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.coconePointUniqueUpToIso\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {s t : CategoryTheory.Limits.Cocone F} (P : CategoryTheory.Limits.IsColimit s) (Q : CategoryTheory.Limits.IsColimit t) : s.pt ≅ t.pt\", \"doc\": \"Colimits of `F` are unique up to isomorphism. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.descCoconeMorphism\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {t : CategoryTheory.Limits.Cocone F} (h : CategoryTheory.Limits.IsColimit t) (s : CategoryTheory.Limits.Cocone F) : t ⟶ s\", \"doc\": \"The universal morphism from a colimit cocone to any other cocone. \"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.isoUniqueCoconeMorphism\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {t : CategoryTheory.Limits.Cocone F} : CategoryTheory.Limits.IsColimit t ≅ (s : CategoryTheory.Limits.Cocone F) → Unique (t ⟶ s)\", \"doc\": \"A cocone is a colimit cocone exactly if\\nthere is a unique cocone morphism to any other cocone.\\n\"}\n  {\"name\": \"CategoryTheory.Limits.IsColimit.ofPointIso\", \"module\": \"Mathlib.CategoryTheory.Limits.IsLimit\", \"type\": \" {J : Type u₁} [CategoryTheory.Category.{v₁, u₁} J] {C : Type u₃} [CategoryTheory.Category.{v₃, u₃} C] {F : CategoryTheory.Functor J C} {r t : CategoryTheory.Limits.Cocone F} (P : CategoryTheory.Limits.IsColimit r) [i : CategoryTheory.IsIso (P.desc t)] : CategoryTheory.Limits.IsColimit t\", \"doc\": \"If the canonical morphism to a cocone point from a colimiting cocone point is an iso, then the\\nfirst cocone was colimiting also.\\n\"}\n",
