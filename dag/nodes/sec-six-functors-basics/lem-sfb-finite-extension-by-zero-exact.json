 "kind": "statement",
 "title": "$j_!$ is exact",
 "statement": "For an open immersion $j$, the extension by zero $j_!$ of\n[def-sfb-finite-extension-by-zero] preserves finite limits. Being also a left adjoint, it\nis exact.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-six-functors-basics/sk-def-sfb-finite-lower-shriek/lem-sfb-finite-extension-by-zero-exact.md",
  "place": "node lem-sfb-finite-extension-by-zero-exact, order 1656"
 },
 "stmt_deps": [
  "def-sfb-finite-extension-by-zero"
 ],
 "proof": [
  {
   "text": "By the computation in the proof of [def-sfb-finite-extension-by-zero], the presheaf\n$\\operatorname{Lan}_{\\ell^{\\mathrm{op}}}F$ takes at $W$ either the value $F(W\\to U)$ or\n$0$, depending only on $W$. So $\\operatorname{Lan}_{\\ell^{\\mathrm{op}}}$ preserves finite\nlimits. The inclusion of sheaves into presheaves preserves limits, and sheafification is\nleft exact for a Grothendieck abelian $\\mathcal A$. Hence $j_!$ is left exact. It is right\nexact because it is a left adjoint ([def-sfb-finite-extension-by-zero-adjunction]).",
   "uses": [
    "def-sfb-finite-extension-by-zero",
    "def-sfb-finite-extension-by-zero-adjunction"
   ],
   "elementary": false
  }
 ],
