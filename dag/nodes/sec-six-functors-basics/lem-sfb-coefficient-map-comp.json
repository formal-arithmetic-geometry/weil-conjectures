  },
  "stmt_deps": [
    "def-sfb-coefficient-map"
  ],
  "proof": [
    {
      "text": "$(b\\circ a)_X=p_X^*(b\\circ a)=p_X^*b\\circ p_X^*a$, since the functor $p_X^*$ preserves\ncomposition.",
      "uses": [],
