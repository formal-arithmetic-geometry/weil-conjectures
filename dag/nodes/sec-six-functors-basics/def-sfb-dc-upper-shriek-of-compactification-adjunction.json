  "sk-def-sfb-dc-lower-shriek",
  "def-sfb-dc-open-lower-shriek-adjunction"
 ],
 "proof": [
  {
   "text": "Adjunctions compose. From $i_!\\dashv Li^*$ and $Rp_*\\dashv Rp^!$ one gets, naturally in $K$ and $L$,\n\n$$\n\\Hom(Rp_*i_!K,L)\\cong\\Hom(i_!K,Rp^!L)\\cong\\Hom(K,Li^*Rp^!L).\n$$",
   "uses": [],
   "elementary": null
  }
 ],
