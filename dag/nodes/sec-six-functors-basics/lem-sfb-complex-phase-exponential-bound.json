{
 "id": "lem-sfb-complex-phase-exponential-bound",
 "kind": "statement",
 "title": "Unit-phase exponential difference bound",
 "statement": "Over $\\mathbf R,\\mathbf C$ [def-weil-field], for every $t\\in\\mathbf R$ one has $$|e^{it}|=1,\\qquad |e^{it}-1|\\leq|t|,$$ where $e^{it}=\\operatorname{exp}(it)$ is the complex exponential. For all $z,w\\in\\mathbf C$, $$\\operatorname{exp}(z+w)=\\operatorname{exp}(z)\\operatorname{exp}(w).$$",
