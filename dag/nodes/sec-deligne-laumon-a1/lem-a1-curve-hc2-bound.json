 "kind": "statement",
 "title": "Top compact-support bound on a curve",
 "statement": "If $C_0$ is a smooth affine curve and $\\mathcal F$ is lisse and\npunctually $\\iota$-pure of weight $w$, then\n$H_c^2(C,\\mathcal F)$ has weights at most $w+2$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-a1/sk-l-dl-a1-endpoints/lem-a1-curve-hc2-bound.md",
  "place": "node lem-a1-curve-hc2-bound, order 2734"
 },
 "stmt_deps": [
  "def-weil-ordinary-compact-cohomology",
  "def-weil-punctual-weights"
 ],
 "proof": [
  {
   "text": "The coinvariant description [lem-a1-affine-hc2] realizes the group\nas a quotient of the local generic fiber $V=\\mathcal F_{\\bar\\eta}$\nfollowed by the twist $(-1)$. The quotient does not increase weights\nby [lem-a1-subquotient-extension-bounds] (every eigenvalue of a\nquotient is an eigenvalue of the pure module $V$ of weight $w$), and\nthe twist $(-1)$ in [lem-tw-tate-twist-weight-shift] raises\nweights by two, giving weights at most $w+2$.",
   "uses": [
    "lem-a1-affine-hc2",
    "lem-a1-subquotient-extension-bounds",
    "lem-tw-tate-twist-weight-shift"
   ],
   "elementary": false
  }
 ],
