 "kind": "statement",
 "title": "Cohomology of a finite boundary",
 "statement": "Let $Z_0$ be finite over $k_0$ and let $\\mathcal G$ be a\nconstructible Weil sheaf whose stalks have weights at most $w$. Then\n$H_c^r(Z,\\mathcal G)=0$ for $r\\neq0$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-a1/sk-i-dl-a1-local/lem-a1-finite-boundary-cohomology.md",
  "place": "node lem-a1-finite-boundary-cohomology, order 2725"
 },
 "stmt_deps": [
  "def-weil-punctual-weights"
 ],
 "proof": [
  {
   "text": "After geometric base change a finite scheme is a finite discrete space:\nits cohomology is concentrated in degree zero, and the higher\ncompact-support groups of [def-weil-ordinary-compact-cohomology]\nvanish since the scheme is zero-dimensional.",
   "uses": [
    "def-weil-ordinary-compact-cohomology"
   ],
   "elementary": false
  }
 ],
