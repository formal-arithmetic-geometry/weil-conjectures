 "kind": "statement",
 "title": "Weight of a constant twist",
 "statement": "If $\\mathcal F$ is lisse and punctually $\\iota$-pure of weight\n$w$, and $2\\log_q|\\iota(b)|=c$, then\n$\\mathcal F\\otimes\\mathcal B_b$ is punctually $\\iota$-pure of weight\n$w+c$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-deligne-laumon-a1/sk-l-dl-a1-energy/lem-wf-constant-twist-weight.md",
  "place": "node lem-wf-constant-twist-weight, order 2763"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "At a closed point $y$ of degree $m$, the twist\n[def-wf-constant-weil-twist] multiplies every eigenvalue of\n$F_y$ by $b^m$, so every eigenvalue $\\alpha$ of\n$\\mathcal F_{\\bar y}$ becomes $b^m\\alpha$, and\n\n$$\n|\\iota(b^m\\alpha)|=|\\iota(b)|^m\\,q_y^{w/2}=q^{mc/2}q^{mw/2}\n=q_y^{(w+c)/2},\n$$\n\nwhich is the punctual purity of weight $w+c$ of\n[def-weil-punctual-weights].",
   "uses": [
    "def-wf-constant-weil-twist",
    "def-weil-punctual-weights"
   ],
   "elementary": false
  }
 ],
