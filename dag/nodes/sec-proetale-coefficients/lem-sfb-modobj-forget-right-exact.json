{
  "id": "lem-sfb-modobj-forget-right-exact",
  "kind": "statement",
  "title": "The forgetful functor on module objects is right exact",
  "statement": "Under the hypotheses of [lem-sfb-modobj-abelian], the forgetful functor\n$\\Mod_{\\mathcal R}(\\mathcal C)\\to\\mathcal C$ preserves finite colimits.",
  "source": {
    "document": "literature/blueprint/main-20261015/blueprint/sec-proetale-coefficients/sk-prop-sfb-module-category/lem-sfb-modobj-forget-right-exact.md",
