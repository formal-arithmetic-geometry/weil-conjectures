 ],
 "proof": [
  {
   "text": "Both categories are abelian ([lem-sfb-modobj-abelian]). The forgetful functor is\nadditive, and it preserves cokernels by [lem-sfb-modobj-cokernels]. An additive functor\nbetween abelian categories that preserves cokernels preserves finite colimits.",
   "uses": [
    "lem-sfb-modobj-abelian",
    "lem-sfb-modobj-cokernels"
   ],
   "elementary": false
  }
 ],
