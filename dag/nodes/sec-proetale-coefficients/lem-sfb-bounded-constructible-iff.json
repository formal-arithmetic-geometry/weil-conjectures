 "kind": "statement",
 "title": "Bounded constructible complexes via cohomology",
 "statement": "In the situation of [def-sfb-bounded-constructible-complexes], a complex\n$K\\in D(\\Mod_{\\mathcal R})$ is bounded constructible if and only if there are integers\n$a\\le b$ such that $H^i(K)=0$ for $i<a$ and for $i>b$, and every $H^n(K)$ is\nconstructible.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-proetale-coefficients/sk-def-sfb-bounded-constructible/lem-sfb-bounded-constructible-iff.md",
  "place": "node lem-sfb-bounded-constructible-iff, order 1643"
 },
 "stmt_deps": [
  "def-sfb-bounded-constructible-complexes"
 ],
 "proof": [
  {
   "text": "For the canonical t-structure, $K\\in D^{\\ge a}$ if and only if $H^i(K)=0$ for all $i<a$,\nand $K\\in D^{\\le b}$ if and only if $H^i(K)=0$ for all $i>b$\n[def-weil-abstract-derived-category]. Bounded means lying in $D^{\\ge a}\\cap D^{\\le b}$ for\nsome $a,b$. The condition on the cohomology sheaves is the same on both sides.",
   "uses": [
    "def-weil-abstract-derived-category"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
  "def-weil-abstract-derived-category"
 ],
