 "kind": "definition",
 "title": "Torsion objects",
 "statement": "Let $\\mathcal T$ be a preadditive category that is linear over a commutative ring $R$,\nand let $M\\subseteq R$ be a submonoid. An object $X$ of $\\mathcal T$ is *$M$-torsion* if\n$m\\cdot\\mathrm{id}_X=0$ for some $m\\in M$. The $M$-torsion objects form a property of\nobjects closed under isomorphisms.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-proetale-coefficients/sk-def-sfb-rationalization/def-sfb-torsion-objects.md",
  "place": "node def-sfb-torsion-objects, order 1631"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "If $e\\colon X\\cong Y$, then $m\\cdot\\mathrm{id}_Y=e^{-1}\\circ(m\\cdot\\mathrm{id}_X)\\circ e$, so\n$m\\cdot\\mathrm{id}_X=0$ implies $m\\cdot\\mathrm{id}_Y=0$.",
   "uses": [],
   "elementary": null
  }
 ],
