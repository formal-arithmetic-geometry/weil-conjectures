{
  "id": "lem-sfb-profinite-to-proetale-continuous",
  "kind": "statement",
  "title": "$S\\mapsto\\Spec LC(S,\\Z)$ is continuous",
  "statement": "The functor $u$ is continuous. That is, for every sheaf $G$ on\n$(\\Spec\\Z)_{\\mathrm{proét}}$, the presheaf $S\\mapsto G(\\Spec LC(S,\\Z))$ is a\nsheaf on $*_{\\mathrm{proét}}$.",
  "source": {
    "document": "literature/blueprint/main-20261015/blueprint/sec-proetale-coefficients/sk-def-sfb-pullback-from-point/lem-sfb-profinite-to-proetale-continuous.md",
    "place": "node lem-sfb-profinite-to-proetale-continuous, order 1538"
  },
  "stmt_deps": [],
  "proof": [
    {
      "text": "By [lem-sfb-profinite-to-proetale-finite-limits], $u$ is a finite-limit\npreserving functor between finitely complete categories. Hence it is\nrepresentably flat, and so it preserves compatible families. By\n[lem-sfb-profinite-to-proetale-cover-preserving] it is cover preserving. A\ncover preserving functor that preserves compatible families is continuous.",
      "uses": [
        "lem-sfb-profinite-to-proetale-finite-limits",
        "lem-sfb-profinite-to-proetale-cover-preserving"
      ],
      "elementary": false
    }
