 "title": "The forgetful functor on module objects is left exact",
 "statement": "Under the hypotheses of [lem-sfb-modobj-abelian], the forgetful functor\n$\\Mod_{\\mathcal R}(\\mathcal C)\\to\\mathcal C$ preserves finite limits.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-proetale-coefficients/sk-prop-sfb-module-category/lem-sfb-modobj-forget-left-exact.md",
  "place": "node lem-sfb-modobj-forget-left-exact, order 1574"
 },
 "stmt_deps": [
  "lem-sfb-modobj-abelian"
 ],
 "proof": [
  {
   "text": "Both categories are abelian ([lem-sfb-modobj-abelian]). The forgetful functor is\nadditive, and it preserves kernels by [lem-sfb-modobj-kernels]. An additive functor between\nabelian categories that preserves kernels preserves finite limits, since finite limits are\nbuilt from finite biproducts and kernels.",
   "uses": [
    "lem-sfb-modobj-abelian",
    "lem-sfb-modobj-kernels"
   ],
   "elementary": false
  }
 ],
