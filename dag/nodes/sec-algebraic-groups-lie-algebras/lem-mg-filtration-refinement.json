 "kind": "statement",
 "title": "Refining a finite filtration",
 "statement": "Let $0=M_0\\subseteq M_1\\subseteq\\cdots\\subseteq M_s=M$ be a finite\nfiltration by Weil subrepresentations. In the terminology of\n[def-mg-weil-composition-series], the composition-factor multiset of\n$M$ is the disjoint union of the composition-factor multisets of the\nquotients $M_i/M_{i-1}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-algebraic-groups-lie-algebras/sk-r-linear-library/lem-mg-filtration-refinement.md",
  "place": "node lem-mg-filtration-refinement, order 2544"
 },
 "stmt_deps": [
  "def-mg-weil-composition-series"
 ],
 "proof": [
  {
   "text": "For every index with $M_i/M_{i-1}\\ne0$, choose a composition series,\nusing [lem-mg-composition-series-exists]; indices with zero quotient\ncontribute no factors. Pull the chosen terms back to $M_i$\nand concatenate the resulting chains. This refines the displayed\nfiltration to a composition series in the sense of\n[def-mg-weil-composition-series], and its factors are precisely the\nfactors of the successive quotients. Independence of all choices follows\nfrom [lem-mg-jordan-holder].",
   "uses": [
    "lem-mg-composition-series-exists",
    "def-mg-weil-composition-series",
    "lem-mg-jordan-holder"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
