 "kind": "statement",
 "title": "A rank-one character has constant modulus on a degree component",
 "statement": "Let $A,c,j_\\chi$ be as in\n[lem-wf-rank-one-algebraic-extension], and fix an embedding\n$\\iota:E\\hookrightarrow\\mathbf C$. If\n$z\\in G_{\\mathrm{arith}}(\\chi)^{[m]}$, then\n\n$$\n|\\iota(j_\\chi(z))|=|\\iota(c)|^m.\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-algebraic-groups-lie-algebras/sk-p-readout/lem-wf-rank-one-component-modulus.md",
  "place": "node lem-wf-rank-one-component-modulus, order 2555"
 },
 "stmt_deps": [
  "lem-wf-rank-one-algebraic-extension"
 ],
 "proof": [
  {
   "text": "By [def-wf-degree-components], write $z=(a,m)$. The description\nin [lem-wf-rank-one-algebraic-extension] gives\n$j_\\chi(z)=ac^m$, where $a\\in A$. Every element of the finite\nsubgroup $A\\subset E^\\times$ is a root of unity, so\n$|\\iota(a)|=1$. Taking complex absolute values proves the formula.",
   "uses": [
    "def-wf-degree-components",
    "lem-wf-rank-one-algebraic-extension"
   ],
   "elementary": false
  }
 ],
