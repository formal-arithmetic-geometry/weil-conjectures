 "kind": "statement",
 "title": "Closed subsets consisting of closed points",
 "statement": "Let $X$ be a scheme of finite type over a field $K$. A closed\nsubset of $X$ all of whose points are\nclosed is a finite set of points.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-finite-closed-subscheme.md",
  "place": "node lem-kun-finite-closed-subscheme, order 1704"
 },
 "stmt_deps": [
  "def-kun-support"
 ],
 "proof": [
  {
   "text": "A scheme of finite type over a field is Noetherian, so a closed subset\n$E\\subseteq X$ has finitely many irreducible components\n$E_1,\\ldots,E_n$. Write $\\eta_j$ for the generic point of\n$E_j$; by hypothesis $\\eta_j$ is a closed point, so\n$E_j=\\overline{\\{\\eta_j\\}}=\\{\\eta_j\\}$, whence $E$ is a finite set\nof points.",
   "uses": [],
   "elementary": null
  }
 ],
