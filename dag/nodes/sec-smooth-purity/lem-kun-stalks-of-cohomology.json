 "kind": "statement",
 "title": "Stalks of cohomology sheaves",
 "statement": "For $Q\\in D(T_{\\Et})$ and a geometric point $\\bar t$ of $T$,\n\n$$\n\\mathcal H^q(Q)_{\\bar t}=\\mathcal H^q(Q_{\\bar t}),\n$$\n\nwhere $Q_{\\bar t}$ denotes the pullback of $Q$ to the point.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-stalks-of-cohomology.md",
  "place": "node lem-kun-stalks-of-cohomology, order 1702"
 },
 "stmt_deps": [
  "def-weil-pbc-derived-categories",
  "def-weil-pbc-geometric-stalks"
 ],
 "proof": [
  {
   "text": "Choose a K-injective (or any) representative\n$\\mathcal Q^\\bullet$ of $Q$; the stalk of the $q$-th cohomology\nsheaf of $\\mathcal Q^\\bullet$ is the $q$-th cohomology of the\nstalked complex, because the stalk functor is exact by\n[prop-weil-pbc-geometric-stalks-exact] so it commutes with\nkernels and images of the differentials. By\n[lem-kun-stalk-as-pullback] the stalked complex is\n$Q_{\\bar t}$, which is the assertion.",
   "uses": [
    "prop-weil-pbc-geometric-stalks-exact",
    "lem-kun-stalk-as-pullback"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
