 "kind": "statement",
 "title": "Constant sheaves are constructible",
 "statement": "Let $X$ be a\nquasi-compact and\nquasi-separated scheme. For every finite abelian group (respectively\nfinite $\\Lambda$-module, $\\Lambda$ Noetherian) $M$, the constant\nsheaf $\\underline{M}$ of [def-kun-constant-sheaf] on $X_{\\Et}$\nis constructible.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-constant-constructible.md",
  "place": "node lem-kun-constant-constructible, order 1775"
 },
 "stmt_deps": [
  "def-kun-constant-sheaf",
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "The single-piece partition $X$ makes $\\underline{M}$ locally\nconstant with finite stalks (the stalk at every geometric point is\n$M$), which is constructibility according to\n[def-weil-pbc-constructible-complexes].",
   "uses": [
    "def-weil-pbc-constructible-complexes"
   ],
   "elementary": false
  }
 ],
