 "kind": "statement",
 "title": "Extension by zero preserves constructibility",
 "statement": "Let $X$ be of finite type over $k$, let $j:U\\hookrightarrow X$ be an\nopen immersion, and let $F$\nbe a constructible\n$\\Lambda$-sheaf on $U_{{\\mathrm{et}}}$. Then $j_!F$ of\n[def-weil-pbc-extension-by-zero] is constructible on\n$X_{{\\mathrm{et}}}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-cbc/lem-fin-extension-by-zero.md",
  "place": "node lem-fin-extension-by-zero, order 1590"
 },
 "stmt_deps": [
  "def-weil-pbc-extension-by-zero",
  "def-constructible-constant",
  "def-constructible-constructible",
  "def-constructible-finite",
  "def-constructible-finite-locally-constant",
  "def-constructible-locally-constant",
  "def-constructible-stratification",
  "def-kun-separably-closed",
  "def-weil-pbc-scheme-conventions",
  "sbc-def-coefficient-conventions"
 ],
 "proof": [
  {
   "text": "By [def-weil-pbc-constructible-complexes] $U$ has a finite\npartition $U=\\bigsqcup_\\alpha U_\\alpha$ into locally closed\nconstructible subschemes with $F|_{U_\\alpha}$ lisse. The pieces\n$U_\\alpha$ are locally closed constructible subschemes of $X$ (locally\nclosed in the open subscheme $U$), and $X$ is the disjoint union of\n$X\\setminus U$ and the $U_\\alpha$. By the stalk description of\n[def-weil-pbc-extension-by-zero] the restriction of $j_!F$ to\n$U_\\alpha$ is the lisse $F|_{U_\\alpha}$ and its restriction to\n$X\\setminus U$ is the zero sheaf, which is lisse; this is the finite\npartition with lisse restrictions of\n[def-weil-pbc-constructible-complexes].",
   "uses": [
    "def-weil-pbc-constructible-complexes",
    "def-weil-pbc-extension-by-zero"
   ],
   "elementary": false
  }
 ],
