 "kind": "statement",
 "title": "Co-projection for a closed immersion",
 "statement": "In the purity conventions of this chapter ([def-pur-conventions] fixed setting),\nlet $i:Z\\hookrightarrow W$ be a\nclosed immersion, let\n$K$ be an object on $W$ and $L$ an invertible object on $W$. Then\nthe canonical co-projection\n\n$$\nRi^!(K\\otimes^L_{\\Lambda_W}L)\\xrightarrow{\\ \\sim\\ }Ri^!K\\otimes^L_{\\Lambda_Z}Li^*L\n$$\n\nis an isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-lem-coprojection/lem-pur-coprojection.md",
  "place": "node lem-pur-coprojection, order 2006"
 },
 "stmt_deps": [
  "def-pur-conventions",
  "def-weil-derived-pullback-tensor-hom",
  "def-weil-derived-tensor",
  "def-weil-pbc-proetale-site",
  "def-weil-scheme-morphism-properties"
 ],
 "proof": [
  {
   "text": "For a test object $A$ on $Z$, tensor-Hom adjunction, the projection\nformula of [def-exchange-projection] for $Ri_!$, and the inverse\nof $L$ identify maps $A\\to Ri^!(K\\otimes^LL)$ with maps\n$Ri_!(A\\otimes^LLi^*L^{-1})\\to K$; Yoneda gives the assertion.",
   "uses": [
    "def-exchange-projection"
   ],
   "elementary": false
  }
 ],
