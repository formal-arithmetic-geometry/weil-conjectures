 "kind": "statement",
 "title": "Tensor unit",
 "statement": "For a commutative ring $\\Lambda$ and\n$E\\in D(T_{\\Et},\\Lambda)$, both canonical unit constraints\n$E\\kunotimes{\\Lambda}\\underline{\\Lambda}\\to E$ and\n$\\underline{\\Lambda}\\kunotimes{\\Lambda}E\\to E$ are isomorphisms.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-tensor-unit.md",
  "place": "node lem-kun-tensor-unit, order 1711"
 },
 "stmt_deps": [
  "def-kun-constant-sheaf",
  "def-weil-pbc-etale-sheaves"
 ],
 "proof": [
  {
   "text": "The constant sheaf $\\underline{\\Lambda}$ is a flat\n$\\Lambda$-module sheaf, so the (underived) tensor product computes the\nderived one; $E\\otimes_\\Lambda\\underline{\\Lambda}=E$ by the unit\nconstraint of the sheaf category, which is the assertion.",
   "uses": [],
   "elementary": null
  }
 ],
