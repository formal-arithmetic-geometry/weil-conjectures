 "kind": "statement",
 "title": "A stalk is inverse image to a geometric point",
 "statement": "If $\\bar t:\\Spec(\\Omega)\\to T$ is a geometric point, the stalk of a\nsheaf (or derived object) at $\\bar t$ is its inverse image along\n$\\bar t$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-stalk-as-pullback.md",
  "place": "node lem-kun-stalk-as-pullback, order 1677"
 },
 "stmt_deps": [
  "def-weil-pbc-etale-site",
  "def-weil-pbc-inverse-image",
  "def-weil-pbc-pointed-etale-neighbourhoods"
 ],
 "proof": [
  {
   "text": "Inverse image along $\\bar t:\\Spec(\\Omega)\\to T$ restricts a sheaf to\nthe site of $\\Spec(\\Omega)$; the sections over $\\Spec(\\Omega)$ of\nthat restriction are the colimit over the pointed etale\nneighbourhoods of $\\Cref{def-weil-pbc-pointed-etale-neighbourhoods}$,\nwhich is the stalk of [def-weil-pbc-geometric-stalks]. For\nderived objects, exactness of\n[prop-weil-pbc-geometric-stalks-exact] passes the statement to\ncomplexes.",
   "uses": [
    "def-weil-pbc-geometric-stalks",
    "prop-weil-pbc-geometric-stalks-exact"
   ],
   "elementary": false
  }
 ],
