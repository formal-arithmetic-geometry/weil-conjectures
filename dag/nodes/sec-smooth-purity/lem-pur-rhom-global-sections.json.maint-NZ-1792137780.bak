  "statement": "theorem rhom_global_sections {C : Type u₁} [SmallCategory C] (J : GrothendieckTopology C) (R : Sheaf J CommRingCat.{u₁}) [HasDerivedCategory.{w₁} (SheafOfModules.{u₁} ((sheafCompose J (forget₂ CommRingCat RingCat)).obj R))] : ∃ e : ∀ P : (DerivedCategory (SheafOfModules.{u₁} ((sheafCompose J (forget₂ CommRingCat RingCat)).obj R)))ᵒᵖ × DerivedCategory (SheafOfModules.{u₁} ((sheafCompose J (forget₂ CommRingCat RingCat)).obj R)), ((ringedSiteZerothHypercohomology J R).obj ((derivedInternalHom J R).obj P)) ≃+ (P.1.unop ⟶ P.2), ∀ (P P' : (DerivedCategory (SheafOfModules.{u₁} ((sheafCompose J (forget₂ CommRingCat RingCat)).obj R)))ᵒᵖ × DerivedCategory (SheafOfModules.{u₁} ((sheafCompose J (forget₂ CommRingCat RingCat)).obj R))) (f : P ⟶ P') (x : (ringedSiteZerothHypercohomology J R).obj ((derivedInternalHom J R).obj P)), e P' ((ringedSiteZerothHypercohomology J R).map ((derivedInternalHom J R).map f) x) = f.1.unop ≫ e P x ≫ f.2",
