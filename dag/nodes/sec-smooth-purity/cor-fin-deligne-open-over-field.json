 "kind": "statement",
 "title": "Higher open direct images over a field",
 "statement": "Let $k$ be a field of characteristic different from $\\ell$,\nlet $j:X\\hookrightarrow Y$ be an open immersion of finite-type\n$k$-schemes, and let $F$ be a constructible\n$\\mathbf F_\\ell$-sheaf. Then $Rj_*F\\in D^b_c(Y,\\mathbf F_\\ell)$.\nThe notation refers to ordinary derived categories.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-cbc/cor-fin-deligne-open-over-field.md",
  "place": "node cor-fin-deligne-open-over-field, order 1638"
 },
 "stmt_deps": [
  "def-weil-pbc-constructible-complexes",
  "def-weil-pbc-derived-categories",
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "Apply [thm-fin-deligne-generic-open] with\n$S=\\operatorname{Spec}k$. Its only nonempty open is $S$\nitself, so the generic conclusion is the assertion on all of $Y$.\nNo stratification of $Y$ and no closed-base-change assertion\nfor $Rj_*$ is needed here.",
   "uses": [
    "thm-fin-deligne-generic-open"
   ],
   "elementary": false
  }
 ],
