 ],
 "proof": [
  {
   "text": "On an object $V$ over the open subscheme, every object in a covering of $V$\nis still over that open subscheme. The presheaf defining $j_!M$ is therefore\nexactly $M$ on this slice, and sheafification leaves it unchanged there.\nUnder the extension-by-zero adjunction, the resulting identification\n$j^*j_!M=M$ sends the unit to the identity on every section. This proves the\nstatement for the named map.",
   "uses": [],
   "elementary": null
  }
 ],
