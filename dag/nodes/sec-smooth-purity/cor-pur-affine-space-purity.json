 "kind": "statement",
 "title": "Affine-space purity",
 "statement": "In the purity conventions of this chapter ([def-pur-conventions] fixed setting),\n$A=A_{E,n}$, let $d\\geq0$, and let $K\\in D^b_{ctf}(Y,\\Lambda)$. The\ncomparison\n\n$$\n\\gamma_{p_d,K}:Lp_d^*K(d)[2d]\\xrightarrow{\\ \\sim\\ }Rp_d^!K\n$$\n\nof [def-pur-affine-space-comparison] is an isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-an/cor-pur-affine-space-purity.md",
  "place": "node cor-pur-affine-space-purity, order 1978"
 },
 "stmt_deps": [
  "def-pur-conventions",
  "def-pur-affine-space-comparison",
  "def-coefficient-twists-detailed",
  "def-sbc-smooth-morphisms",
  "def-weil-pbc-proetale-site",
  "def-weil-scheme-morphism-properties"
 ],
 "proof": [
  {
   "text": "By induction on $d$: the case $d=0$ is the identity, and for\n$d\\geq1$ the composition law [prop-pur-affine-space-composition-law]\nexpresses $\\gamma_{p_d,K}$ as the composite of the isomorphism\n$\\gamma_{p_{d-1},Rp_1^!K}$ (the induction hypothesis applied to the\n$(d-1)$-fold affine space over the base-changed line) with the affine-line\npurity isomorphism $\\gamma_{p_1,K}$ of [thm-pur-affine-line-purity],\nboth conjugated by invertible reassociation isomorphisms; hence\n$\\gamma_{p_d,K}$ is an isomorphism.",
   "uses": [
    "prop-pur-affine-space-composition-law",
    "thm-pur-affine-line-purity"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
