 "kind": "statement",
 "title": "Left t-exactness of derived direct image",
 "statement": "Let $f:X\\to Y$ be a morphism of schemes and $E\\in\\Dplus(X_{\\Et})$.\nIf $\\mathcal H^i(E)=0$ for $i<b$, then\n$\\mathcal H^i(Rf_*E)=0$ for $i<b$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-tensor-t-est.md",
  "place": "node lem-kun-tensor-t-est, order 1727"
 },
 "stmt_deps": [
  "def-weil-pbc-derived-categories",
  "def-weil-pbc-direct-image"
 ],
 "proof": [
  {
   "text": "The hypercohomology spectral sequence of\n[def-weil-pbc-hypercohomology-filtrations] has\n$E_2^{p,q}=R^pf_*\\mathcal H^q(E)$; for $q<b$ all\n$\\mathcal H^q(E)$ vanish, so $E_2^{p,q}=0$ for $q<b$, and no\nterm with $p+q<b$ survives, giving\n$\\mathcal H^i(Rf_*E)=0$ for $i<b$.",
   "uses": [
    "def-weil-pbc-hypercohomology-filtrations"
   ],
   "elementary": false
  }
 ],
