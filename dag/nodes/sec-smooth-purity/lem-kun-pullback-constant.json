 "kind": "statement",
 "title": "Inverse image of a constant sheaf",
 "statement": "For a morphism of schemes $f:X\\to Y$ and a $\\Lambda$-module (or\ncomplex of $\\Lambda$-modules) $M$, the canonical morphism\n$f^{-1}\\underline{M}\\to\\underline{M}$ is an isomorphism on\n$X_{\\Et}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-pullback-constant.md",
  "place": "node lem-kun-pullback-constant, order 1712"
 },
 "stmt_deps": [
  "def-kun-constant-sheaf",
  "def-weil-pbc-geometric-stalks",
  "def-weil-pbc-inverse-image"
 ],
 "proof": [
  {
   "text": "At a geometric point $\\bar x$ of $X$, the\nstalk functor is the inverse\nimage of the point (see [lem-kun-stalk-as-pullback]), so\n$(f^{-1}\\underline{M})_{\\bar x}=(\\underline{M})_{f(\\bar x)}=M= (\\underline{M})_{\\bar x}$; the canonical map is an isomorphism on\nevery stalk hence an isomorphism of sheaves by\n[lemma-weil-pbc-geometric-stalk-conservative]; for a complex the\nsame argument applies degreewise.",
   "uses": [
    "lem-kun-stalk-as-pullback",
    "lemma-weil-pbc-geometric-stalk-conservative"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
