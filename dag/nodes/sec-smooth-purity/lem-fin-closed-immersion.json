 "kind": "statement",
 "title": "Closed immersions preserve constructibility",
 "statement": "Let $i:Z\\hookrightarrow X$ be a closed immersion with $X$ of finite type over $k$, and let $G$ be a constructible $\\Lambda$-sheaf on $Z_{{\\mathrm{et}}}$. Then $i_*G$ is constructible on $X_{{\\mathrm{et}}}$ and $R^qi_*G=0$ for $q>0$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-cbc/lem-fin-closed-immersion.md",
  "place": "node lem-fin-closed-immersion, order 1593"
 },
 "stmt_deps": [
  "def-weil-pbc-constructible-complexes"
 ],
 "proof": [
  {
   "text": "A closed immersion is affine and induced locally by a surjective ring\nhomomorphism, so $i_*\\mathcal O_Z$ is a finite $\\mathcal O_X$-algebra:\nthe source is a finite module over the target locally, which is the\nfiniteness condition of [def-weil-pbc-scheme-conventions].\nHence $i$ is finite in the sense of\n[def-weil-pbc-scheme-conventions] and\n[lem-fin-finite-morphism] applies.",
   "uses": [
    "def-weil-pbc-scheme-conventions",
    "lem-fin-finite-morphism"
   ],
   "elementary": false
  }
 ],
