 "kind": "statement",
 "title": "Constant-coefficient finiteness for projective smooth curves",
 "statement": "Let $S$ be Noetherian\nand let $f:X\\to S$ be\nprojective and\nsmooth, with geometric fibres\nof pure dimension one. If $\\ell$ is a prime invertible on $S$,\nevery higher direct image\n$R^rf_*\\mathbf F_\\ell$ is\nconstructible.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-cbc/thm-fin-projective-smooth-curve-finiteness.md",
  "place": "node thm-fin-projective-smooth-curve-finiteness, order 1611"
 },
 "stmt_deps": [
  "def-pc-projective-morphism",
  "def-sbc-smooth-morphisms",
  "def-weil-pbc-constructible-complexes",
  "def-weil-pbc-direct-image",
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "The morphism is proper by [lem-pc-projective-proper].\nProper base change [cor-weil-pbc-geometric-fiber-finite]\nidentifies its stalks with $H^r(X_{\\bar s},\\mathbf F_\\ell)$.\nThese stalks are finite and have constructible cardinalities by\n[lem-fin-projective-curve-betti-cardinalities].\nThe fully proved criterion\n[fin4-lem-stalk-constructibility-criterion] now applies to\nthe sheaf $R^rf_*\\mathbf F_\\ell$.\nProper base change was used only as an isomorphism; finiteness\nof the fibre groups came from the curve calculation.",
   "uses": [
    "lem-pc-projective-proper",
    "cor-weil-pbc-geometric-fiber-finite",
    "lem-fin-projective-curve-betti-cardinalities",
    "fin4-lem-stalk-constructibility-criterion"
   ],
   "elementary": false
  }
 ],
