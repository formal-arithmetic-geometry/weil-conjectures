 "kind": "statement",
 "title": "The diagonal is a regular immersion",
 "statement": "In the purity conventions of this chapter ([def-pur-conventions] fixed setting),\nlet $f:X\\to Y$ be smooth,\nseparated, of pure\nrelative dimension $d$, and put $W=X\\times_YX$ with projections\n$p_1,p_2$ and diagonal $\\Delta:X\\hookrightarrow W$. Then $\\Delta$\nis a regular closed immersion of\npure codimension $d$, and its normal bundle is canonically\n\n$$\nN_{\\Delta/W}\\;\\cong\\;T_{X/Y}\n$$\n\n(the relative tangent bundle of $f$).",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-lem-diag-reg/lem-pur-diagonal-regular-immersion.md",
  "place": "node lem-pur-diagonal-regular-immersion, order 2004"
 },
 "stmt_deps": [
  "def-pur-conventions",
  "def-pur-regular-immersion",
  "def-sbc-smooth-morphisms",
  "def-weil-scheme-morphism-properties"
 ],
 "proof": [
  {
   "text": "By [sbc-thm-etale-local-normal-form], $f$ is etale locally the\nprojection $\\mathbf A^d_Y\\to Y$; on the model, $\\Delta$ is the zero\nsection of $\\mathbf A^d$, a regular closed immersion of codimension\n$d$ with normal bundle the trivial rank-$d$ bundle, which under the\nidentification is $T_{X/Y}$. Regular immersions, their codimension\nand their normal bundles are etale local (and compatible with etale\nbase change), hence the assertion.",
   "uses": [
    "sbc-thm-etale-local-normal-form"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
  "sbc-thm-etale-local-normal-form"
 ],
