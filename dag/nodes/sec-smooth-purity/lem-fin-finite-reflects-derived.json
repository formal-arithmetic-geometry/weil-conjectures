 "kind": "statement",
 "title": "Finite direct image reflects bounded constructibility",
 "statement": "Let $p:Z\\to S$ be a\nfinite morphism of\nNoetherian schemes and let $\\Lambda$ be a finite commutative ring.\nOn ordinary derived\ncategories of etale modules, its\nderived direct image $Rp_*$\nreflects membership in\n$D^b_c$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-cbc/lem-fin-finite-reflects-derived.md",
  "place": "node lem-fin-finite-reflects-derived, order 1627"
 },
 "stmt_deps": [
  "def-weil-pbc-constructible-complexes",
  "def-weil-pbc-derived-categories",
  "def-weil-pbc-direct-image",
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "Exactness from [lemma-weil-pbc-finite-direct-image-exact] gives\n$\\mathcal H^q(Rp_*K)=p_*\\mathcal H^q(K)$.\nBy [lemma-weil-pbc-finite-stalk-formula], $p_*G=0$ forces\nevery $G_{\\bar z}=0$, and then $G=0$ by\n[lemma-weil-pbc-geometric-stalk-conservative].\nThus cohomological bounds on $Rp_*K$ also hold on $K$.\nApply [lem-fin-finite-reflects-constructibility] in each\nremaining degree to $G=\\mathcal H^q(K)$.",
   "uses": [
    "lemma-weil-pbc-finite-direct-image-exact",
    "lemma-weil-pbc-finite-stalk-formula",
    "lemma-weil-pbc-geometric-stalk-conservative",
    "lem-fin-finite-reflects-constructibility"
   ],
   "elementary": false
  }
 ],
