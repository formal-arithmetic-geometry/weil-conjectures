 ],
 "proof": [
  {
   "text": "The finite constant abelian sheaf $\\underline M$ is constructible\nby [def-weil-pbc-etale-sheaves]. The Noetherian finite-image\ntheorem [lem-weil-pbc-finite-pushforward-constructible-noetherian]\ntherefore applies directly. Its proof obtains a dense lisse open\nby an explicit finite-algebra calculation, and treats the closed\ncomplement by Noetherian induction and finite base change. In\nparticular it does not infer that the original finite morphism\nbecomes etale merely by ignoring inseparable contributions.",
   "uses": [
    "def-weil-pbc-etale-sheaves",
    "lem-weil-pbc-finite-pushforward-constructible-noetherian"
   ],
   "elementary": false
  }
 ],
