 "kind": "statement",
 "title": "Leray through a finite morphism",
 "statement": "Let $\\pi:X'\\to X$ and $h:Z\\to X'$ be morphisms of schemes with\n$\\pi$ finite. For every\nabelian sheaf $G$ on $Z$ and every $q\\ge0$,\n\n$$\nR^q(\\pi\\circ h)_*G=\\pi_*R^qh_*G.\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-leray-finite.md",
  "place": "node lem-kun-leray-finite, order 1698"
 },
 "stmt_deps": [
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "The Grothendieck spectral sequence of\n[lem-weil-pbc-grothendieck-spectral-sequence] for the composite\n$Z\\xrightarrow{h}X'\\xrightarrow{\\pi}X$ has\n$E_2^{p,q}=R^p\\pi_*R^qh_*G$. As $\\pi$ is finite,\n$R^p\\pi_*=0$ for $p>0$ by\n[lemma-weil-pbc-finite-direct-image-exact], so the spectral\nsequence degenerates at $E_2$ and its abutment in total degree $q$\nis the edge term $E_2^{0,q}=\\pi_*R^qh_*G$, which is the assertion.",
   "uses": [
    "lem-weil-pbc-grothendieck-spectral-sequence",
    "lemma-weil-pbc-finite-direct-image-exact"
   ],
   "elementary": false
  }
 ],
