 ],
 "proof": [
  {
   "text": "Let $F=\\varinjlim_iF_i$. By [prop-weil-pbc-geometric-stalks-exact]\nand the commutativity of stalks with filtered colimits\n([lem-kun-stalks-commute-colimits]),\n$F_{\\bar x}=\\varinjlim_i(F_i)_{\\bar x}$, each $(F_i)_{\\bar x}$ being\nmapped onto by $H^0(T_{\\Et},F_i)$; filtered colimits of abelian\ngroups preserve surjection, so the evaluation map of\n[def-kun-global-generated] is surjective on every stalk, and\nstalkwise surjectivity is global generation by\n[lem-kun-global-generated-stalkwise].",
   "uses": [
    "prop-weil-pbc-geometric-stalks-exact",
    "lem-kun-stalks-commute-colimits",
    "def-kun-global-generated",
    "lem-kun-global-generated-stalkwise"
   ],
   "elementary": false
  }
 ],
