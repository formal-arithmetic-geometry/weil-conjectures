 "kind": "statement",
 "title": "Finite extensions of a separably closed field are purely inseparable",
 "statement": "Let $K$ be a separably closed field and $L/K$ a finite field\nextension. Then $L/K$ is purely inseparable.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-sep-closed-finite-extension-purely-inseparable.md",
  "place": "node lem-kun-sep-closed-finite-extension-purely-inseparable, order 1670"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "Let $L_s$ be the maximal subfield of $L$ separable over $K$. It\nis a finite separable extension of $K$, hence $L_s=K$ by\n[def-kun-separably-closed]. For a finite extension the degree of\nthe maximal separable subfield is the separable degree of the\nextension, so $L_s=K$ says that $L/K$ has no nontrivial separable\nsubextension, i.e. that $L/K$ is purely inseparable.",
   "uses": [
    "def-kun-separably-closed"
   ],
   "elementary": false
  }
 ],
