 "kind": "statement",
 "title": "Symmetry and compatibilities of affine-space purity",
 "statement": "In the situation of [cor-pur-affine-space-purity], the comparison\n$\\gamma_{p_d,K}$ is symmetric under permutation of the affine\ncoordinates (the Koszul sign being $+1$ by\n[prop-pur-affine-space-composition-law]), compatible with the base\nchange of $Y$, and compatible with the products of affine-space\nprojections and with the composition law of\n[prop-pur-affine-space-composition-law].",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-an/prop-pur-affine-space-purity-compatibilities.md",
  "place": "node prop-pur-affine-space-purity-compatibilities, order 1979"
 },
 "stmt_deps": [
