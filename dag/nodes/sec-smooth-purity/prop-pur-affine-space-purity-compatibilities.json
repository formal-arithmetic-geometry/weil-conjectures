  "prop-pur-affine-space-composition-law",
  "def-coefficient-twists-detailed",
  "def-sbc-smooth-morphisms",
  "def-weil-pbc-proetale-site",
  "def-weil-scheme-morphism-properties"
 ],
 "proof": [
  {
   "text": "The symmetry is recorded in\n[prop-pur-affine-space-composition-law]; the base-change\ncompatibility is the base-change compatibility of the affine-line\npurity [thm-pur-affine-line-purity] transported along the tower of\naffine-space projections, the composition law of\n[prop-pur-affine-space-composition-law] being functorial.",
   "uses": [
    "prop-pur-affine-space-composition-law",
    "thm-pur-affine-line-purity"
   ],
   "elementary": false
  }
 ],
