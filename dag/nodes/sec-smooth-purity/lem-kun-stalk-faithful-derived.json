 "kind": "statement",
 "title": "Stalk faithfulness for derived objects",
 "statement": "A morphism in $D(T_{\\Et})$ is an isomorphism if and only if its\npullback to every geometric point of $T$ is an isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-stalk-faithful-derived.md",
  "place": "node lem-kun-stalk-faithful-derived, order 1703"
 },
 "stmt_deps": [
  "def-weil-pbc-derived-categories"
 ],
 "proof": [
  {
   "text": "Let $\\alpha:K\\to L$. The cone $C$ of $\\alpha$ is zero if and only\nif $\\alpha$ is an isomorphism; $\\mathcal H^q(C)=0$ for all $q$\niff $C=0$ by [lem-kun-d-zero-cohomology]. By\n[lem-kun-stalks-of-cohomology] and\n[lem-kun-stalk-as-pullback] the stalk of $\\mathcal H^q(C)$ at\n$\\bar t$ is $\\mathcal H^q(C_{\\bar t})$, and\n[lemma-weil-pbc-geometric-stalk-conservative] detects vanishing of\nsheaves on their stalks, so $C=0$ iff $C_{\\bar t}=0$ for all\n$\\bar t$, i.e. iff the pullbacks of $\\alpha$ are isomorphisms.",
   "uses": [
    "lem-kun-d-zero-cohomology",
    "lem-kun-stalks-of-cohomology",
    "lem-kun-stalk-as-pullback",
    "lemma-weil-pbc-geometric-stalk-conservative"
   ],
   "elementary": false
  }
 ],
