 },
 "kind": "statement",
 "title": "Inverse image along an open immersion is a left inverse of direct image",
 "statement": "Let $j:U\\to X$ be an\nopen immersion. Then\n$j^{-1}j_*=\\mathrm{id}$ on $\\Ab(U_{\\Et})$, and for every\n$F\\in D(U_{\\Et})$ the canonical morphism\n$\\RGamma(X_{\\Et},Rj_*F)\\to\\RGamma(U_{\\Et},F)$ of\n[lem-kun-leray-bdd] is an isomorphism (Leray for $j$).",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-open-immersion-restriction.md",
  "place": "node lem-kun-open-immersion-restriction, order 1699"
 },
 "stmt_deps": [
  "lem-kun-leray-bdd",
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "For an etale $V\\to U$, the direct image of\n[def-weil-pbc-direct-image] gives\n$(j_*F)(V)=F(V\\times_XU)=F(V)$, because\n$V\\times_XU=V$ since $V\\to X$ factors through the open $U$; this\nis $j^{-1}j_*=\\mathrm{id}$. The second assertion is\n[lem-kun-leray-bdd] applied to $j$.",
   "uses": [
    "def-weil-pbc-direct-image",
    "lem-kun-leray-bdd"
   ],
   "elementary": false
  }
 ],
