 "kind": "statement",
 "title": "Units of the ind-etale lift",
 "statement": "An element of $H_A(\\overline C)$, as constructed in\n[def-exc-ind-etale-closed-lift], is invertible if its image in $\\overline C$\nis invertible.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-open-closed-triangle/lem-exc-closed-lift-units.md",
  "place": "node lem-exc-closed-lift-units, order 1840"
 },
 "stmt_deps": [
  "def-exc-ind-etale-closed-lift"
 ],
 "proof": [
  {
   "text": "Represent the element by $b\\in B$ at a stage of the filtered colimit of\n[def-exc-ind-etale-closed-lift], [lem-exc-closed-lift-filtered]. Since the\nimage of $b$ is invertible in $\\overline C$, the localization $B_b$, with\nits extended map to $\\overline C$, is another object of the indexing\ncategory. The transition $B\\to B_b$ makes the given element invertible in\nthe colimit.",
   "uses": [
    "def-exc-ind-etale-closed-lift",
    "lem-exc-closed-lift-filtered"
   ],
   "elementary": false
  }
 ],
