 ],
 "proof": [
  {
   "text": "For each finite subset $S\\subseteq B$ let $K[S]\\subseteq B$ be the\nsubalgebra generated by $S$; $K[S]$ is finitely generated, the\nfamily is directed by inclusion, and $B=\\bigcup_SK[S]$ since each\nelement lies in the subalgebra it generates.",
   "uses": [],
   "elementary": null
  }
 ],
