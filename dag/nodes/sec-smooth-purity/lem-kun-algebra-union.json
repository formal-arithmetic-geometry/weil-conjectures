 "kind": "statement",
 "title": "Algebras are unions of finite type subalgebras",
 "statement": "Every $K$-algebra $B$ is the filtered union of its finitely\ngenerated $K$-subalgebras.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-algebra-union.md",
  "place": "node lem-kun-algebra-union, order 1747"
 },
 "stmt_deps": [
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "For each finite subset $S\\subseteq B$ let $K[S]\\subseteq B$ be the\nsubalgebra generated by $S$; $K[S]$ is finitely generated, the\nfamily is directed by inclusion, and $B=\\bigcup_SK[S]$ since each\nelement lies in the subalgebra it generates.",
   "uses": [],
   "elementary": null
  }
 ],
