  "def-weil-pbc-derived-exchange",
  "def-weil-pbc-underived-exchange"
 ],
 "proof": [
  {
   "text": "Both morphisms are defined as the same adjoint mate of the same\ncomposite and are independent of the K-injective model\n(lem:weil-pbc-derived-exchange-replacement), so they agree.",
   "uses": [],
   "elementary": null
  }
 ],
