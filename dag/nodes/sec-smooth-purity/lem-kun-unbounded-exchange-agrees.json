 "kind": "statement",
 "title": "The unbounded exchange extends the bounded exchange",
 "statement": "For $K\\in\\Dplus(X_{\\Et})$ the exchange morphism\n$\\Ex_{\\square,K}$ of [def-kun-unbounded-exchange] is the exchange\nmorphism of [def-weil-pbc-derived-exchange]; in particular for\nsheaves (complexes concentrated in degree $0$) with\n$\\Lambda$-module structure it agrees with the exchange morphism of\n[def-weil-pbc-underived-exchange].",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/lem-kun-unbounded-exchange-agrees.md",
  "place": "node lem-kun-unbounded-exchange-agrees, order 1667"
 },
 "stmt_deps": [
