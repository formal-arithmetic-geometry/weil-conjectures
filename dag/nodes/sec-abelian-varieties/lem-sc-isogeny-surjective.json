   }
  ]
 },
 "stmt_deps": [
  "def-sc-abelian-variety",
  "def-sc-mult-n"
 ],
 "proof": [
  {
   "text": "By [lem-sc-isogeny-facts](a), $[n]$ is a finite flat\nsurjective morphism, so it is surjective on $k$-points by\n[lem-sc-finite-flat-surj-points]\n(*reference: Stacks Project, Groupoid Schemes, Proposition\n39.9.11, parts (3) and (4), [Tag 03RP](https://stacks.math.columbia.edu/tag/03RP): $[n]$ is surjective, and\n$A(k)$ is divisible for $k$ algebraically closed*).",
   "uses": [
    "lem-sc-isogeny-facts",
    "lem-sc-finite-flat-surj-points"
   ],
   "elementary": false
  }
 ],
