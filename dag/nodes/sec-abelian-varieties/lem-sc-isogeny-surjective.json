 "kind": "statement",
 "title": "Surjectivity of the multiplication map on points",
 "statement": "Let $A$ be an abelian variety\nover an algebraically closed field $k$ and let $n\\geq1$. Then\n\n$$\n[n]:A(k)\\longrightarrow A(k)\n$$\n\nis surjective.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-abelian-varieties/sk-prop-av-divisible/lem-sc-isogeny-surjective.md",
  "place": "node lem-sc-isogeny-surjective, order 572",
  "external": [
