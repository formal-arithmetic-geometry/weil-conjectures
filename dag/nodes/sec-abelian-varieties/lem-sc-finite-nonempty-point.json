 "kind": "statement",
 "title": "Finite schemes over algebraically closed fields",
 "statement": "Let $X$ be a nonempty finite scheme over an algebraically closed\nfield $k$. Then $X$ has a $k$-point.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-abelian-varieties/sk-prop-av-divisible/lem-sc-finite-nonempty-point.md",
  "place": "node lem-sc-finite-nonempty-point, order 570"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "Write $X=\\operatorname{Spec}B$ with $B\\neq0$ a finite\n$k$-algebra, and let $\\mathfrak m\\subset B$ be a maximal ideal.\nThen $B/\\mathfrak m$ is a finite field extension of $k$, hence\nequal to $k$ (as $k$ is algebraically closed), and the projection\n$B\\to B/\\mathfrak m=k$ is a $k$-point of $X$.",
   "uses": [],
   "elementary": null
  }
 ],
