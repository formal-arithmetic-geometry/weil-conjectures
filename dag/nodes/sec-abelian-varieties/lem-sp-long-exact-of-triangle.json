 "kind": "statement",
 "title": "Long exact sequences of distinguished triangles",
 "statement": "Let $\\Phi:\\mathcal C\\to\\mathcal D$ be a homological functor\n[def-sp-homological-functor] with $\\mathcal D$ abelian\n[def-sp-abelian]. For every distinguished triangle $K_1\\to K_2\\to K_3\\to\nK_1[1]$ there is a long exact sequence\n\n$$\n \\cdots\\to\\Phi(K_1)\\to\\Phi(K_2)\\to\\Phi(K_3)\n \\xrightarrow{\\ \\delta\\ }\\Phi(K_1[1])\\to\\cdots\n$$\n\nwhose connecting map $\\delta$ is natural in the triangle.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-abelian-varieties/sk-prop-av-pqf-finite/lem-sp-long-exact-of-triangle.md",
  "place": "node lem-sp-long-exact-of-triangle, order 505"
 },
 "stmt_deps": [
  "def-sp-homological-functor",
  "def-sp-abelian"
 ],
 "proof": [
  {
   "text": "This is the definition of [def-sp-homological-functor] applied to $F=\\Phi$:\nthe exactness at the middle spots of the two halves of the triangle (the\nrotation of a distinguished triangle is distinguished) iterates to the\ninfinite long exact sequence, and the connecting map is obtained by applying\n$\\Phi$ to the rotation morphism $K_3\\to K_1[1]$ of the triangle.",
   "uses": [
    "def-sp-homological-functor"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
