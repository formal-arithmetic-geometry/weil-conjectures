 "kind": "statement",
 "title": "Finite morphisms are proper",
 "statement": "A finite [def-weil-pbc-scheme-conventions] morphism is proper.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-abelian-varieties/sk-prop-av-pqf-finite/lem-weil-pbc-finite-proper.md",
  "place": "node lem-weil-pbc-finite-proper, order 525"
 },
