 ],
 "proof": [
  {
   "text": "A finite morphism is affine, hence separated, since the diagonal of an affine\nmorphism is a closed immersion in the sense of\n[def-weil-pbc-scheme-conventions]; it is of finite type because an\n$A$-algebra that is a finite $A$-module is finitely generated as an\n$A$-algebra. It is universally closed: a finite ring map is integral ([pqf-lem-finite-integral-lft]), hence has going-up, hence\na finite morphism is closed, and finite morphisms are stable under base\nchange, so every base change of a finite morphism is closed. These are\nexactly the defining properties of properness in\n[def-weil-pbc-scheme-conventions].",
   "uses": [
    "def-weil-pbc-scheme-conventions",
    "pqf-lem-finite-integral-lft"
   ],
   "elementary": false
  }
 ],
