 "kind": "statement",
 "title": "Artin–Schreier on algebraically closed fields",
 "statement": "Let $k$ be an algebraically closed field of characteristic\n$p>0$. Then the Artin–Schreier map\n\n$$\n\\wp:k\\longrightarrow k,\\qquad \\wp(x)=x^p-x,\n$$\n\nis surjective, with kernel $\\mathbf F_p$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-abelian-varieties/sk-prop-av-lang-steinberg/lem-sc-artin-schreier-k.md",
  "place": "node lem-sc-artin-schreier-k, order 566"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "For $a\\in k$, the polynomial $X^p-X-a$ has derivative $-1$, so\nit is separable, and over the algebraically closed field $k$ it\nhas a root. The kernel is $\\{x\\in k:x^p=x\\}=\\mathbf F_p$.",
   "uses": [],
   "elementary": null
  }
 ],
