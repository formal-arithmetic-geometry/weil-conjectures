 "kind": "statement",
 "title": "A sheaf with vanishing stalks is zero",
 "statement": "Let $\\mathcal F$ be a sheaf of modules on a scheme $X$. If\n$\\mathcal F_x=0$ for all $x\\in X$, then $\\mathcal F=0$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-abelian-varieties/sk-prop-av-pqf-finite/pqf-lem-sheaf-zero-stalks.md",
  "place": "node pqf-lem-sheaf-zero-stalks, order 545"
 },
 "stmt_deps": [
  "pqf-def-coherent"
 ],
 "proof": [
  {
   "text": "A local section of $\\mathcal F$ is zero in its stalk at every point,\nhence zero in a neighbourhood of every point, hence zero globally by\nthe sheaf axioms and the definition of the stalks.",
   "uses": [],
   "elementary": null
  }
 ],
