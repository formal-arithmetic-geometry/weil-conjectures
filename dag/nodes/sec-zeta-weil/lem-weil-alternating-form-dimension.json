 "kind": "statement",
 "title": "Alternating-form dimension",
 "statement": "Let $K$ be a field with $\\operatorname{char}(K)\\neq2$, $V$ a\nfinite-dimensional $K$-vector space, and $\\beta:V\\times V\\to K$ a\nnondegenerate alternating bilinear form. Then $\\dim_K V$ is even.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-zeta-weil/sk-prop-reciprocity/lem-weil-alternating-form-dimension.md",
  "place": "node lem-weil-alternating-form-dimension, order 2918"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "With $B$ the Gram matrix of $\\beta$ one has $B^\\top=-B$; hence\n$\\det(B)=\\det(-B^\\top)=(-1)^n\\det(B)$, and $\\det(B)\\neq0$\n(nondegenerate, $K$ a field) with $\\operatorname{char}(K)\\neq2$ gives\n$(-1)^n=1$, i.e. $n=\\dim_K V$ is even.",
   "uses": [],
   "elementary": null
  }
 ],
