 "kind": "statement",
 "title": "The normalized reduced integral presentation exists and is unique",
 "statement": "In the situation of [prop-rational-descent], the point-count zeta\nseries has a unique\nnormalized reduced\nintegral presentation: there are unique $A,B\\in\\mathbf Z[T]$ with\n$A(0)=B(0)=1$, $\\gcd(A,B)=1$ in $\\mathbf Q[T]$, and\n$Z(X_0,T)=A(T)/B(T)$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-zeta-weil/sk-thm-intfactors/prop-weil-zeta-normalized-presentation.md",
  "place": "node prop-weil-zeta-normalized-presentation, order 2903"
 },
 "stmt_deps": [
  "prop-rational-descent"
 ],
 "proof": [
  {
   "text": "By [prop-weil-zeta-integral-rational] the series lies in\n$1+T\\mathbf Z[[T]]\\cap\\mathbf Q(T)$, and\n[prop-weil-integral-rational-series] applied to it supplies the\nexistence and uniqueness of the normalized reduced integral presentation\nof [def-weil-normalized-integral-fraction].",
   "uses": [
    "prop-weil-zeta-integral-rational",
    "prop-weil-integral-rational-series",
    "def-weil-normalized-integral-fraction"
   ],
   "elementary": false
  }
 ],
