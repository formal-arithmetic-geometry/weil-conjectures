 "kind": "statement",
 "title": "The zeta series is integral and rational",
 "statement": "In the situation of [prop-rational-descent], the\npoint-count zeta series satisfies\n\n$$\nZ(X_0,T)\\in1+T\\mathbf Z[[T]]\\cap\\mathbf Q(T).\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-zeta-weil/sk-thm-rationality/prop-weil-zeta-integral-rational.md",
  "place": "node prop-weil-zeta-integral-rational, order 2892"
 },
 "stmt_deps": [
  "prop-rational-descent"
 ],
 "proof": [
  {
   "text": "In the situation of [prop-rational-descent] the assumed closed-point\nproduct is the identity of [prop-euler-product], so the\n[def-weil-point-counts-zeta] series $Z(X_0,T)$ lies in\n$1+T\\mathbf Z[[T]]$; by [prop-rational-descent] it also lies in\n$\\mathbf Q(T)$. This is the assertion.",
   "uses": [
    "prop-rational-descent",
    "prop-euler-product",
    "def-weil-point-counts-zeta"
   ],
   "elementary": false
  }
 ],
