{
 "id": "det-thm-weil1",
 "kind": "statement",
 "title": "Weil conjectures I: rationality and Euler product",
 "statement": "Let $X_0$ be a scheme of finite type (quasi-compact and locally of finite\ntype) over $\\Fq$. Then there are $A,B\\in\\Z[T]$ with $B(0)=1$ and\n$B(T)\\,Z(X_0,T)=A(T)$ in $\\Q[[T]]$; in particular\n$Z(X_0,T)\\in1+T\\Z[[T]]\\cap\\Q(T)$. Moreover\n$Z(X_0,T)=\\prod_{x\\in|X_0|}(1-T^{\\deg(x)})^{-1}$ in $\\Q[[T]]$, the product\nover the closed points of $X_0$.",
 "source": {
  "document": "literature/blueprint/main-20261023-1620/blueprint/sec-zeta-weil/sk-lem-wweil-integer-rationality/det-thm-weil1.md",
  "place": "node det-thm-weil1, order 4120"
 },
