 "kind": "statement",
 "title": "Weil conjectures II: integral Frobenius factors",
 "statement": "There are unique $P_i\\in\\Z[T]$ with $P_i(0)=1$ and\n$P_i^{(\\ell)}=\\det(1-TF_{i,\\ell}\\mid H^{i}(X,\\Ql))$ for every $\\ell\\ne p$, and\n$Z(X_0,T)=\\prod_{i=0}^{2d}P_i(T)^{(-1)^{i+1}}$, independently of $\\ell$.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-zeta-weil/sk-thm-weil2/_section.md",
  "place": "node sk-thm-weil2, order 3271"
 },
