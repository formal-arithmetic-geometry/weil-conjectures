 "kind": "statement",
 "title": "Riemann hypothesis for smooth proper schemes",
 "statement": "Let $X_0/\\Fq$ be smooth, proper and geometrically connected of pure dimension\n$d$, and let $P_i\\in\\Z[T]$ be the integral Frobenius factors of\n[sk-thm-intfactors]. Then every reciprocal root $\\alpha$ of $P_i$ is an\nalgebraic integer and a $q$-Weil number of weight $i$:\n\n$$\n|\\tau(\\alpha)|=q^{i/2}\n\\qquad\\text{for every embedding }\\tau:\\Q(\\alpha)\\hookrightarrow\\C .\n$$\n\nEquivalently, $|\\tau(\\beta)|=q^{-i/2}$ for every ordinary root $\\beta$.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-zeta-weil/sk-thm-rh/_section.md",
  "place": "node sk-thm-rh, order 3253"
 },
 "stmt_deps": [
  "sk-thm-intfactors",
  "sk-def-zeta"
 ],
 "proof": [
  {
   "text": "By [sk-thm-intfactors], $P_i\\in\\Z[T]$ with $P_i(0)=1$, so the reversed\npolynomial $P_i^{\\#}$ is monic with integer coefficients and its roots — the\nreciprocal roots — are algebraic integers. Fix a reciprocal root $\\alpha$\nof $P_i$. Every embedding $\\tau:\\Q(\\alpha)\\hookrightarrow\\C$ extends to an\nisomorphism $\\Qlb\\cong\\C$, and [sk-prop-rootpurity], applied through that\nisomorphism, gives $|\\tau(\\alpha)|=q^{i/2}$. This is exactly the $q$-Weil\ncondition of [sk-def-roots]; inverting gives the ordinary-root form.",
   "uses": [
    "sk-thm-intfactors",
    "sk-def-roots"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
  "sk-thm-intfactors",
  "sk-def-roots"
