 "proof": [
  {
   "text": "By [def-weil-pbc-scheme-conventions], a universal homeomorphism $u$ is a\nmorphism every base change of which is a homeomorphism of underlying\ntopological spaces. If $v$ is a base change of $u$, then every base change of\n$v$ is, by associativity of fibre products, also a base change of $u$, hence\na homeomorphism; so $v$ is a universal homeomorphism.",
   "uses": [
    "def-weil-pbc-scheme-conventions"
   ],
   "elementary": false
  }
 ],
