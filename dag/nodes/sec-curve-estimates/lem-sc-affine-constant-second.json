 "kind": "statement",
 "title": "Second cohomology of a constant sheaf on an affine curve",
 "statement": "Let $C$ be a smooth affine connected curve\nover an algebraically closed field, and $\\ell$ any prime.\nThen $H^2(C,\\mathbf F_\\ell)=0$, with\netale cohomology.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-curve-estimates/sk-prop-cd-affine/lem-sc-affine-constant-second.md",
  "place": "node lem-sc-affine-constant-second, order 1013"
 },
 "stmt_deps": [
  "def-sc-curves",
  "def-weil-pbc-etale-cohomology"
 ],
 "proof": [
  {
   "text": "If $\\ell$ is invertible in the field, choosing a primitive\n$\\ell$-th root identifies $\\mathbf F_\\ell$ with $\\mu_\\ell$.\nThen [lem-sc-second-kummer-divisors] identifies the group with\n$\\operatorname{Pic}(C)/\\ell=0$, by [lem-sc-pic-affine].\nIn characteristic $\\ell$, use the long exact sequence of\n[lem-sc-as-sequence]; the adjacent groups\n$H^1(C,\\mathbf G_a)$ and $H^2(C,\\mathbf G_a)$ vanish by\n[lem-sc-etale-affine-qcoherent].",
   "uses": [
    "lem-sc-second-kummer-divisors",
    "lem-sc-pic-affine",
    "lem-sc-as-sequence",
    "lem-sc-etale-affine-qcoherent"
   ],
   "elementary": false
  }
 ],
