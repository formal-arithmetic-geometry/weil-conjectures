 "title": "Cohomological dimension of a smooth affine curve",
 "statement": "For a smooth affine connected curve $C$\nover an algebraically closed field and any torsion\netale sheaf $F$,\none has $H^q(C,F)=0$ for $q>1$, with cohomology as in\n[def-weil-pbc-etale-cohomology].",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-curve-estimates/sk-prop-cd-affine/lem-sc-affine-cohomological-dimension.md",
  "place": "node lem-sc-affine-cohomological-dimension, order 1018"
 },
 "stmt_deps": [
  "def-weil-pbc-etale-cohomology",
  "def-sc-curves",
  "def-weil-pbc-etale-sheaves"
 ],
 "proof": [
  {
   "text": "The degrees $q>2$ vanish by [lem-sc-cohomological-dimension].\nIn degree two, work componentwise and apply\n[lem-sc-generic-cohomology-comparison] with $M=\\eta^*F$;\nthe resulting group $H^2(C,\\eta_*M)$ vanishes by\n[lem-sc-affine-generic-second].",
   "uses": [
    "lem-sc-cohomological-dimension",
    "lem-sc-generic-cohomology-comparison",
    "lem-sc-affine-generic-second"
   ],
   "elementary": false
  }
