   }
  ]
 },
 "stmt_deps": [
  "def-sc-curves",
  "def-sc-gm-torsor"
 ],
 "proof": [
  {
   "text": "This is the case $X=C$ of [thm-sc-hilbert-90]. The group of\nisomorphism classes of invertible $\\mathcal O_C$-modules\n([def-sc-invertible-module]) under $\\otimes$ appearing there is\n$\\operatorname{Pic}(C)$ of [def-sc-picard-group] (same set, same group\nlaw), and the three maps of the statement are the ones of\n[thm-sc-hilbert-90] for $X=C$: $\\mathcal L\\mapsto[\\underline{\\operatorname{Isom}}(\\mathcal O_C,\\mathcal L)]$\ninto Zariski cohomology, the comparison map along\n$\\varepsilon:C_{\\Et}\\to C_{\\mathrm{Zar}}$, and their composite\n$\\mathcal L\\mapsto[\\underline{\\operatorname{Isom}}(\\mathcal O_{C_{\\Et}},\\mathcal L_{\\Et})]$.\n(*Stacks Project, Lemma 21.6.1, Tag [040E](https://stacks.math.columbia.edu/tag/040E)*,\nin Section 21.6: for a (locally) ringed site,\n$H^1(\\mathcal C,\\mathcal O^*)=\\operatorname{Pic}(\\mathcal O)$.)",
   "uses": [
    "thm-sc-hilbert-90",
    "def-sc-invertible-module",
    "def-sc-picard-group"
   ],
   "elementary": false
  }
 ],
