 "kind": "statement",
 "title": "The normalization over the normal locus",
 "statement": "Let $X$ be an integral scheme of finite type over a field $k$\nand $\\nu:X^{\\nu}\\to X$ its normalization\n([def-sc-normalization]). For every open $U\\subseteq X$\nwhich is normal, the induced morphism\n$X^{\\nu}\\times_XU\\to U$ is an isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-curve-estimates/sk-thm-br/lem-sc-normalization-over-normal-locus.md",
  "place": "node lem-sc-normalization-over-normal-locus, order 916"
 },
 "stmt_deps": [
  "def-sc-normalization"
 ],
 "proof": [
  {
   "text": "Over a normal open $U$, the integral closure of $\\mathcal O_U$ in $k(X)$ is $\\mathcal O_U$ itself (a normal domain is\nintegrally closed in its fraction field), so\n$X^{\\nu}\\times_XU\\to U$ is an isomorphism.",
   "uses": [],
   "elementary": null
  }
 ],
