 "kind": "statement",
 "title": "Characteristic torsion on an affine curve",
 "statement": "If $U$ is affine over an algebraically closed field of characteristic $p$,\nthen, for the classical constant sheaf $\\mathbf F_p$,\n\n$$\nH^1(U,\\mathbf F_p)=\n\\Gamma(U,\\cO_U)/(F-1)\\Gamma(U,\\cO_U),\\qquad\nH^q(U,\\mathbf F_p)=0\\quad(q>1).\n$$",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-curve-estimates/sk-lem-curve-affine-artin-schreier/_section.md",
  "place": "node sk-lem-curve-affine-artin-schreier, order 887"
 },
 "stmt_deps": [
  "sk-def-curve"
 ],
 "proof": [
  {
   "text": "Quasi-coherent cohomology on an affine scheme vanishes in positive degrees,\nso the long exact Artin–Schreier sequence on $U_{\\mathrm{ét}}$ gives both\nclaims. [sk-prop-sf-comparison] transports them to $U_{\\mathrm{proét}}$.",
   "uses": [
    "sk-prop-sf-comparison"
   ],
   "elementary": false
  }
 ],
