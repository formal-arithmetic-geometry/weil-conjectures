 "kind": "statement",
 "title": "Exactness of finite direct image",
 "statement": "For finite $f$, the functor $f_*:\\Ab(X_{\\Et})\\to\\Ab(Y_{\\Et})$ is exact.\nConsequently $R^qf_*=0$ for $q>0$ and $Rf_*=f_*$ on $\\Dplus(X_{\\Et})$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-curve-estimates/sk-prop-cd/lemma-weil-pbc-finite-direct-image-exact.md",
  "place": "node lemma-weil-pbc-finite-direct-image-exact, order 998"
 },
