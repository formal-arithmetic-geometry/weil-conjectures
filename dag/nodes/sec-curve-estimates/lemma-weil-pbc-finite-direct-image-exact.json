  "def-weil-pbc-direct-image",
  "def-weil-pbc-geometric-fibre",
  "def-weil-pbc-geometric-stalks",
  "def-weil-pbc-scheme-conventions"
 ],
 "proof": [
  {
   "text": "By [lemma-weil-pbc-finite-stalk-formula], a short exact sequence of sheaves\nbecomes, at every geometric stalk of the target, a finite direct sum of short\nexact sequences at the geometric points of the finite fibre; since the stalk\nfunctors are exact and jointly conservative, $f_*$ is exact. The vanishing of\nthe higher derived functors follows.",
   "uses": [
    "lemma-weil-pbc-finite-stalk-formula"
   ],
   "elementary": false
  }
 ],
