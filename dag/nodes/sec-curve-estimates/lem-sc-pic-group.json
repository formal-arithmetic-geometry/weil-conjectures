 "kind": "statement",
 "title": "$\\operatorname{Pic}(C)$ is a group",
 "statement": "Let $C$ be a curve. Tensor product makes\nthe set of isomorphism classes of\ninvertible modules an abelian\ngroup: associative with unit $\\mathcal O_C$, with inverse\n$\\mathcal L\\mapsto\\mathcal L^{\\vee}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-curve-estimates/sk-def-pic/lem-sc-pic-group.md",
  "place": "node lem-sc-pic-group, order 886"
 },
 "stmt_deps": [
  "def-sc-curves",
  "def-sc-invertible-module"
 ],
 "proof": [
  {
   "text": "Associativity, commutativity and the unit property of $\\otimes$ are\nthe standard properties of tensor product of quasi-coherent modules.\nBy [lem-sc-invertible-dual],\n$\\mathcal L\\otimes\\mathcal L^{\\vee}\\cong\\mathcal O_C$, so\n$\\mathcal L^{\\vee}$ is an inverse.",
   "uses": [
    "lem-sc-invertible-dual"
   ],
   "elementary": false
  }
 ],
