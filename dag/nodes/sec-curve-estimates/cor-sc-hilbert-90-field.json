 "kind": "statement",
 "title": "Hilbert 90 for a field",
 "statement": "Let $K$ be a field. Then $H^1(\\operatorname{Spec}K_{\\Et},\\mathbf G_m)=0$\n(and also $H^1((\\operatorname{Spec}K)_{\\mathrm{Zar}},\\mathcal O^{\\times})=0$).",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-curve-estimates/sk-prop-hilbert90/cor-sc-hilbert-90-field.md",
  "place": "node cor-sc-hilbert-90-field, order 883"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "By [thm-sc-hilbert-90] with $X=\\operatorname{Spec}K$, both groups are\nisomorphic to the group of isomorphism classes of invertible\n$\\mathcal O_X$-modules. The underlying space of $X$ is a point, so a\nquasi-coherent $\\mathcal O_X$-module is a $K$-vector space and an\ninvertible one is a one-dimensional $K$-vector space, i.e. isomorphic\nto $K=\\mathcal O_X$. Hence the group is trivial.",
   "uses": [
    "thm-sc-hilbert-90"
   ],
   "elementary": false
  }
 ],
