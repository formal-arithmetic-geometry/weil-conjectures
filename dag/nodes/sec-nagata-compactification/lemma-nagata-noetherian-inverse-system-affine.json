 "kind": "statement",
 "title": "Noetherian approximation of an affine scheme",
 "statement": "Let $S=\\operatorname{Spec}(A)$ be an affine scheme. Order the finitely\ngenerated $\\mathbf Z$-subalgebras $A_0\\subseteq A$ by inclusion. Then the\nspectra $\\operatorname{Spec}(A_0)$ form a cofiltered system of schemes of\nfinite type over $\\mathbf Z$ with affine transition morphisms, and $S$ is\nits inverse limit.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-prop-nagata-sketch-approximation/lemma-nagata-noetherian-inverse-system-affine.md",
  "place": "node lemma-nagata-noetherian-inverse-system-affine, order 343"
 },
 "stmt_deps": [
  "def-nagata-noetherian-inverse-system"
 ],
 "proof": [
  {
   "text": "Finitely generated $\\mathbf Z$-subalgebras are directed by\n[lemma-nagata-ring-finite-type-subalgebras], and each\n$\\operatorname{Spec}(A_0)$ is of finite type over $\\mathbf Z$, hence\nNoetherian by the Hilbert basis theorem. Every transition morphism is\n$\\operatorname{Spec}$ of a ring map and therefore affine. By the same\nlemma, $A$ is the filtered colimit of the $A_0$; since $\\operatorname{Spec}$\nis a right adjoint it takes this colimit of rings to a limit of schemes, so\n$S=\\varprojlim\\operatorname{Spec}(A_0)$.",
   "uses": [
    "lemma-nagata-ring-finite-type-subalgebras"
   ],
   "elementary": false
  }
 ],
