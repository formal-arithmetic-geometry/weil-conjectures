 "kind": "statement",
 "title": "Uniqueness of the homogeneous decomposition",
 "statement": "Let $E$ be a finite set of pairwise distinct degrees and choose one element\n$F_n\\in\\mathcal R_A(I)_n$ for each $n\\in E$. If\n$\\sum_{n\\in E}F_n=0$, then every $F_n$ is zero.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-def-nagata-sketch-data/lemma-nagata-rees-components-unique.md",
  "place": "node lemma-nagata-rees-components-unique, order 20"
 },
 "stmt_deps": [
  "def-nagata-rees-algebra",
  "def-nagata-rees-piece"
 ],
 "proof": [
  {
   "text": "Apply the coefficient projection in a fixed degree $n\\in E$. Every summand\nof degree different from $n$ has zero $n$th component, so the projection of\nthe displayed sum is $F_n=0$. This holds for every $n\\in E$.",
   "uses": [],
   "elementary": null
  }
