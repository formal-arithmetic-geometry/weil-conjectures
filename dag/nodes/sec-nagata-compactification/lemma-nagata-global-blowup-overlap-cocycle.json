 ],
 "proof": [
  {
   "text": "Cover the triple overlap by basic affine opens. On each such open,\n$\\omega_{jk,s}\\omega_{ij,s}=r_{k,s}r_{j,s}^{-1}r_{j,s}r_{i,s}^{-1} =r_{k,s}r_{i,s}^{-1}=\\omega_{ik,s}$; this is precisely the affine\nrestriction cocycle. Equality on the cover proves the claim.",
   "uses": [],
   "elementary": null
  }
 ],
