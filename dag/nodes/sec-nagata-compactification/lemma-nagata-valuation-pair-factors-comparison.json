 "kind": "statement",
 "title": "The pair of valuation extensions factors through $X_{12}$",
 "statement": "Let $A$ be a valuation ring with fraction field $K$. Suppose\n$\\operatorname{Spec}(K)\\to U_1\\cap U_2$ is an $S$-morphism and let\n$g_i\\colon\\operatorname{Spec}(A)\\to X_i$ be extensions. Then the pair\n\n$$\n(g_1,g_2)\\colon\\operatorname{Spec}(A)\\to X_1\\times_SX_2\n$$\n\nfactors through $X_{12}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-thm-nagata-sketch-two-open/lemma-nagata-valuation-pair-factors-comparison.md",
  "place": "node lemma-nagata-valuation-pair-factors-comparison, order 292"
 },
 "stmt_deps": [
