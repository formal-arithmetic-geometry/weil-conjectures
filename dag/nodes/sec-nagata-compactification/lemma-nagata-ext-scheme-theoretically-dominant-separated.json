 "kind": "statement",
 "title": "Morphisms into a separated target agreeing on a scheme-theoretically dominant subscheme",
 "statement": "Let $s\\colon Y\\to Z$ be separated and let $f,g\\colon T\\to Y$ satisfy\n$s\\circ f=s\\circ g$. If $\\iota\\colon W\\to T$ is scheme-theoretically\ndominant and $f\\circ\\iota=g\\circ\\iota$, then $f=g$. In particular two\n$Z$-morphisms $T\\to Y$ into a separated $Z$-scheme $Y$ that agree on a\nscheme-theoretically dense open of $T$ are equal.\n\nNo reducedness of $T$ is needed: this is the scheme-theoretic analogue of the\nclassical statement for a dominant $\\iota$ and reduced $T$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-thm-nagata-sketch-conrad/lemma-nagata-ext-scheme-theoretically-dominant-separated.md",
  "place": "node lemma-nagata-ext-scheme-theoretically-dominant-separated, order 211"
 },
 "stmt_deps": [
  "def-nagata-dense-compactification",
  "def-nagata-scheme-theoretically-dense-open"
 ],
 "proof": [
  {
   "text": "Passing to $Z$-schemes, the equalizer $E$ of $f$ and $g$ maps to $T$ by a\nclosed immersion $e$ because $s$ is separated. As $f\\circ\\iota=g\\circ\\iota$,\nthe morphism $\\iota$ factors as $\\iota=e\\circ l$, so the kernel ideal of $e$\nis contained in that of $\\iota$, which is trivial by scheme-theoretic\ndominance. A closed immersion with trivial kernel is an isomorphism, hence\n$e$ is an epimorphism and $f=g$ follows from $f\\circ e=g\\circ e$.",
   "uses": [],
   "elementary": null
  }
 ],
