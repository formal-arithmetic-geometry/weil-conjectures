 "kind": "statement",
 "title": "The power-torsion quotient has no exceptional torsion",
 "statement": "Multiplication by $a$ on $M/\\Gamma_{(a)}(M)$ is injective. More generally,\nno nonzero class in the quotient is killed by a power of $a$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-power-torsion-quotient-torsionfree.md",
  "place": "node lemma-nagata-power-torsion-quotient-torsionfree, order 142"
 },
 "stmt_deps": [
  "def-nagata-power-torsion"
 ],
 "proof": [
  {
   "text": "If $a^n[m]=0$, then $a^nm$ belongs to the power-torsion submodule, so some\nfurther power of $a$ kills $m$. Thus $m$ already represents zero in the\nquotient.",
   "uses": [],
   "elementary": null
  }
 ],
