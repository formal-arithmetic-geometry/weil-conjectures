 "proof": [
  {
   "text": "A finite-type morphism over a quasi-compact base has quasi-compact source,\nand separatedness makes that source quasi-separated, so the model system is\navailable. Its property lemma makes every term finite presentation and\nevery structural map $i_\\alpha$ a closed immersion. At the explicitly\nselected stage $\\alpha^{X/S}_{\\mathrm{sep}}$, separatedness follows from\n[lemma-nagata-fixed-base-separated-eventually]. These are exactly the\nthree assertions for the named envelope.",
   "uses": [
    "lemma-nagata-fixed-base-separated-eventually"
   ],
   "elementary": false
  }
 ],
