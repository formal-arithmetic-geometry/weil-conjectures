 ],
 "proof": [
  {
   "text": "The final component $h_n$ of the dependent recursive datum in\n[def-nagata-noetherian-compactification] has the three fields required\nby [def-nagata-compactification], and $X_n=X$. Thus\n$\\mathsf C_{\\mathrm{Noeth}}(X/S)$ is a compactification of $X\\to S$. No\nlater induction theorem is used to define any earlier $\\mathsf C_r$.",
   "uses": [
    "def-nagata-noetherian-compactification",
    "def-nagata-compactification"
   ],
   "elementary": false
  }
 ],
