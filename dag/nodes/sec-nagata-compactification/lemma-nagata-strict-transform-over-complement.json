 "kind": "statement",
 "title": "Strict transform on the preserved open",
 "statement": "Let $f\\colon Y\\to X$, let $\\mathcal I$ be a finite-type quasi-coherent\nideal, and put $X'=\\operatorname{Bl}_{\\mathcal I}(X)$. Over\n$U=X\\setminus V(\\mathcal I)$, the strict transform is canonically\n$Y\\times_XU$, and its map to $Y$ is the ordinary pullback isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-strict-transform-over-complement.md",
  "place": "node lemma-nagata-strict-transform-over-complement, order 160"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "The blow-up is the identity over $U$ by\n[thm-nagata-global-blowup-complement]. Under this specified\nisomorphism the open whose closure defines the strict transform is all of\n$Y\\times_XU$. It is already a closed subscheme of itself, so the minimal\nclosed-subscheme characterization of\n[lemma-nagata-strict-transform-closure-characterization] identifies\nthe restriction with $Y\\times_XU$. On charts this is the quotient by the\nzero torsion ideal after $a$ is inverted; these identifications agree on\noverlaps by the closed chart model in\n[prop-nagata-strict-transform-closed-fiber-product]. The projection\nequality is the one induced by the fibre-product square.",
   "uses": [
    "thm-nagata-global-blowup-complement",
    "lemma-nagata-strict-transform-closure-characterization",
    "prop-nagata-strict-transform-closed-fiber-product"
   ],
   "elementary": false
  }
 ],
