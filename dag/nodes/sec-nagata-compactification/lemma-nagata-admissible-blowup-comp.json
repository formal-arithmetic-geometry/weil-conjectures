 "kind": "statement",
 "title": "Composition of admissible blow-ups, [stacks-project]",
 "statement": "Let $X$ be quasi-compact and quasi-separated and let $U\\subseteq X$ be\nquasi-compact. A composition of two $U$-admissible blow-ups is a\n$U$-admissible blow-up. The chosen isomorphism over $U$ is the composite of\nthe chosen pullback isomorphisms.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-admissible-blowup-comp.md",
  "place": "node lemma-nagata-admissible-blowup-comp, order 162"
 },
 "stmt_deps": [
  "def-nagata-admissible-blowup",
  "def-nagata-composition-of-blowups-comparison",
  "def-nagata-global-blowup"
 ],
 "proof": [
  {
   "text": "Apply [thm-nagata-composition-of-blowups]. It writes the composite as\nthe blow-up of a finite-presentation center $Y\\hookrightarrow X$ whose\nsupport is the union of the first center and the image of the second center.\nBoth sets are disjoint from $U$, because the first blow-up is the identity\nover $U$ by [lemma-nagata-admissible-blowup-over-open], and the second\ncenter is disjoint from its inverse image. Thus $Y\\cap U=\\varnothing$,\nequivalently its defining ideal restricts to the unit ideal on $U$, so the\nresulting blow-up is $U$-admissible. The isomorphism supplied by the\ncomposition theorem is over $X$. Pulling it back to $U$ identifies the\ncomposite with the composite of the two specified pullback isomorphisms;\nthe equality follows after composing with the structure maps, where it is\nthe associativity equality for fibre products.",
   "uses": [
    "thm-nagata-composition-of-blowups",
    "lemma-nagata-admissible-blowup-over-open"
   ],
   "elementary": false
  }
 ],
