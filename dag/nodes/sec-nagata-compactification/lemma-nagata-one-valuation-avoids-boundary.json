 "kind": "statement",
 "title": "One valuation extension avoids the forbidden boundary",
 "statement": "Let $A$ be a valuation ring with fraction field $K$. Let\n$\\operatorname{Spec}(K)\\to U_1\\cap U_2$ be an $S$-morphism and let\n$g_i\\colon\\operatorname{Spec}(A)\\to X_i$ be extensions. At least one\n$g_i$ factors through $X_i\\setminus\\overline Z_{i,j}$, and hence determines\na map $\\operatorname{Spec}(A)\\to W_i$ extending the given generic map.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-thm-nagata-sketch-two-open/lemma-nagata-one-valuation-avoids-boundary.md",
  "place": "node lemma-nagata-one-valuation-avoids-boundary, order 294"
 },
