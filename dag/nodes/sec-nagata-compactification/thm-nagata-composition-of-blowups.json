 "kind": "statement",
 "title": "[stacks-project]",
 "statement": "With $Z=V(\\mathcal I)$ as above, the two constructed comparison maps are\ninverse over $X$. Hence the\ncomposite is the blow-up of the finite-presentation center\n$Y(Z')=V(\\mathcal K(Z'))\\hookrightarrow X$, whose support satisfies\n\n$$\n|Y(Z')|=|Z|\\cup b(|Z'|).\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/thm-nagata-composition-of-blowups.md",
  "place": "node thm-nagata-composition-of-blowups, order 135"
 },
 "stmt_deps": [
