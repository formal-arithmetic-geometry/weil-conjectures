 "kind": "statement",
 "title": "[stacks-project]",
 "statement": "Let $X$ be qcqs, let $U\\subseteq X$ be a quasi-compact open, and let\n$\\mathcal I_1,\\mathcal I_2$ be finite-type quasi-coherent ideals on $X$ with\n$\\mathcal I_1|_U=\\mathcal I_2|_U=\\mathcal O_U$. The blow-up of\n$\\mathcal I_1\\mathcal I_2$ canonically dominates the blow-ups of\n$\\mathcal I_1$ and of $\\mathcal I_2$, and all three blow-ups are\n$U$-admissible.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-product-ideal-common-blowup.md",
  "place": "node lemma-nagata-product-ideal-common-blowup, order 127"
 },
 "stmt_deps": [
  "def-nagata-admissible-blowup",
  "def-nagata-effective-cartier-ideal",
  "def-nagata-extended-ideal",
  "def-nagata-global-blowup",
  "def-nagata-invertible-ideal"
 ],
 "proof": [
  {
   "text": "Let $\\pi_i\\colon\\operatorname{Bl}_{\\mathcal I_1\\mathcal I_2}(X) \\to\\operatorname{Bl}_{\\mathcal I_i}(X)$ be the two maps supplied by\n[cor-nagata-blowup-product-common-refinement]. The product ideal is\nalso the unit ideal on $U$, so each of the three blow-ups restricts to $U$\nby [thm-nagata-global-blowup-complement]; hence all are\n$U$-admissible and the displayed maps are the required domination maps.",
   "uses": [
    "cor-nagata-blowup-product-common-refinement",
    "thm-nagata-global-blowup-complement"
   ],
   "elementary": false
  }
 ],
