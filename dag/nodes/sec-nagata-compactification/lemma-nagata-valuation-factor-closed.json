 "kind": "statement",
 "title": "Factorization through a closed subscheme over a valuation ring",
 "statement": "Let $A$ be a valuation ring with fraction field $K$, let $Z\\hookrightarrow Y$\nbe a closed immersion, and let $g\\colon\\operatorname{Spec}(A)\\to Y$. If the\nrestriction of $g$ to $\\operatorname{Spec}(K)$ factors through $Z$, then\n$g$ factors through $Z$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-dense-valuative/lemma-nagata-valuation-factor-closed.md",
  "place": "node lemma-nagata-valuation-factor-closed, order 277"
 },
 "stmt_deps": [
  "def-nagata-dense-compactification",
  "def-nagata-scheme-image-comparison"
 ],
 "proof": [
  {
   "text": "Pull the defining ideal of $Z$ back to $A$. It becomes zero after applying\nthe injective map $A\\hookrightarrow K$, so it was already zero in $A$.",
   "uses": [],
   "elementary": null
  }
 ],
