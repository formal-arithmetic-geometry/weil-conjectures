 "proof": [
  {
   "text": "The complement is covered by the basic opens $D(a)$, $a\\in I$. On $D(a)$\nthe localized ideal is the unit ideal, so\n[prop-nagata-affine-blowup-restrict] and\n[lemma-nagata-affine-blowup-top] identify the blow-up with $D(a)$.\nThe identifications agree on overlaps by\n[lemma-nagata-affine-blowup-restrict-cocycle], and hence glue.",
   "uses": [
    "prop-nagata-affine-blowup-restrict",
    "lemma-nagata-affine-blowup-top",
    "lemma-nagata-affine-blowup-restrict-cocycle"
   ],
   "elementary": false
  }
 ],
