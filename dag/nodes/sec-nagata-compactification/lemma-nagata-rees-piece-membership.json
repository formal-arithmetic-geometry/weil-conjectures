 "kind": "statement",
 "title": "Membership in one Rees piece",
 "statement": "An element $F\\in\\mathcal R_A(I)$ lies in $\\mathcal R_A(I)_n$ if and only if\nthere is $a\\in I^n$ such that the underlying polynomial of $F$ is\n$at^n$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-def-nagata-sketch-data/lemma-nagata-rees-piece-membership.md",
  "place": "node lemma-nagata-rees-piece-membership, order 16"
 },
 "stmt_deps": [
  "def-nagata-rees-algebra",
  "def-nagata-rees-piece"
 ],
 "proof": [
  {
   "text": "If $F$ is supported in degree $n$, coefficient extensionality gives\n$F=\\operatorname{monomial}(n,F_n)$. Membership in the Rees algebra gives\n$F_n\\in I^n$. Conversely, if the underlying polynomial is $at^n$ with $a\\in I^n$, its\nsupport is the singleton degree $n$ and the coefficient lies in the required\npiece, so the defining membership condition for\n$\\mathcal R_A(I)_n$ holds.",
   "uses": [],
   "elementary": null
  }
 ],
