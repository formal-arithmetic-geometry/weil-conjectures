 "kind": "statement",
 "title": "Nagata compactification, [stacks-project]",
 "statement": "The explicitly constructed factorization\n$\\mathsf C_{\\mathrm{Nag}}(f)$ is a compactification of $f$. In particular,\nevery separated finite type morphism to a quasi-compact and\nquasi-separated scheme is compactifiable.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-thm-nagata-compactification/thm-nagata-compactification.md",
  "place": "node thm-nagata-compactification, order 407"
 },
 "stmt_deps": [
  "def-nagata-compactifiable",
  "def-nagata-final-compactification"
 ],
 "proof": [
  {
   "text": "$\\mathsf C_{\\mathrm{Nag}}(f)$ is the composition of two maps $j_f$ and $p_f$. The first map is a quasi-compact open immersion by\n[lemma-nagata-final-open-immersion]; the second is proper by\n[lemma-nagata-final-ambient-proper]; and their composite is $f$ by\n[lemma-nagata-final-factorization]. These are exactly the fields of\n[def-nagata-compactification]. Hence the named construction is a\ncompactification, and its existence witnesses compactifiability.",
   "uses": [
    "lemma-nagata-final-open-immersion",
    "lemma-nagata-final-ambient-proper",
    "lemma-nagata-final-factorization",
    "def-nagata-compactification"
   ],
   "elementary": false
  }
 ],
