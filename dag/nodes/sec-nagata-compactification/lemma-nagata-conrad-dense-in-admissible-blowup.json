 "kind": "statement",
 "title": "Density in an admissible blow-up",
 "statement": "Let $X$ be qcqs, let $U\\subseteq X$ be a dense quasi-compact open and let\n$\\pi\\colon\\widetilde X=\\operatorname{Bl}_{\\mathcal I}(X)\\to X$ be a\n$U$-admissible blow-up. Then $U$, viewed as an open subscheme of\n$\\widetilde X$ via [thm-nagata-global-blowup-complement], is\ntopologically dense in $\\widetilde X$. If moreover\n$V(\\mathcal I)=X\\setminus U$, then $U$ is scheme-theoretically dense in\n$\\widetilde X$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-conrad-dense-in-admissible-blowup.md",
  "place": "node lemma-nagata-conrad-dense-in-admissible-blowup, order 175"
 },
 "stmt_deps": [
  "thm-nagata-global-blowup-complement",
  "def-nagata-admissible-blowup",
  "def-nagata-dense-compactification",
  "def-nagata-global-blowup",
  "def-nagata-scheme-theoretically-dense-open"
 ],
 "proof": [
  {
   "text": "Write $\\mathcal I'=\\mathcal I\\cdot\\mathcal O_{\\widetilde X}$, a finite type\ninvertible ideal by [thm-nagata-blowup-principalizes-center]. Its\ncomplement $\\widetilde X\\setminus V(\\mathcal I')$ is a quasi-compact open\nsubscheme, and $\\pi$ restricts over it to an isomorphism onto\n$X\\setminus V(\\mathcal I)$ by [thm-nagata-global-blowup-complement].\nAn invertible ideal is locally generated by a nonzerodivisor, so\n$\\mathcal O_{\\widetilde X}\\to j_*\\mathcal O_{\\widetilde X\\setminus V(\\mathcal I')}$ is injective for the inclusion $j$ of that complement:\nthe complement is scheme-theoretically dense, hence topologically dense.\nSince $\\mathcal I$ is the unit ideal on $U$ we have\n$U\\subseteq X\\setminus V(\\mathcal I)$, and $U$ is dense there because it is\ndense in $X$. Density is transitive along the two displayed inclusions, so\n$U$ is dense in $\\widetilde X$.",
   "uses": [
    "thm-nagata-blowup-principalizes-center",
    "thm-nagata-global-blowup-complement"
   ],
   "elementary": false
  },
  {
   "text": "If $V(\\mathcal I)=X\\setminus U$ then $X\\setminus V(\\mathcal I)=U$, so the\ndisplayed scheme-theoretically dense complement *is* $U$.",
   "uses": [],
   "elementary": null
  }
 ],
