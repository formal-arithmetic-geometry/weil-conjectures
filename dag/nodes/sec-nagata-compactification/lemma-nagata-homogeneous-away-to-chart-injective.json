 "proof": [
  {
   "text": "If $x/a^n$ is zero in $A_a$, then $a^N x=0$ for some $N$. Multiplying the\nhomogeneous numerator and denominator by $(at)^N$ shows that the original\nhomogeneous fraction is zero.",
   "uses": [],
   "elementary": null
  }
 ],
