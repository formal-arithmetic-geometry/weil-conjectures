 ],
 "proof": [
  {
   "text": "On each standard chart, the map for $s=1$ is induced by the identity of the\nRees algebra, hence is the identity. For $s,t$, both composites send a\nhomogeneous fraction to its image in the localization at $st$; the two\ncoefficient maps are equal by [lemma-nagata-rees-localization-one]\nand [lemma-nagata-rees-localization-mul].\nThe chart maps therefore agree on a cover, proving the asserted identity\nand cocycle equalities globally.",
   "uses": [
    "lemma-nagata-rees-localization-one",
    "lemma-nagata-rees-localization-mul"
   ],
   "elementary": false
  }
 ],
