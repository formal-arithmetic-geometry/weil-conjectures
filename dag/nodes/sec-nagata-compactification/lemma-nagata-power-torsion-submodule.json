 "proof": [
  {
   "text": "Zero is killed by $a^0$. If $a^mm_1=0$ and $a^nm_2=0$, then\n$a^{m+n}(m_1+m_2)=0$. If $r\\in R$, then\n$a^m(rm_1)=r(a^mm_1)=0$.",
   "uses": [],
   "elementary": null
  }
 ],
