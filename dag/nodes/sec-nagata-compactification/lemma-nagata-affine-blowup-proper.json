 "kind": "statement",
 "title": "Properness of the affine blow-up",
 "statement": "If $I$ is finitely generated, the affine blow-up morphism is proper.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-affine-blowup-proper.md",
