 },
 "kind": "statement",
 "title": "A specialization leaving $U_i$ meets the forbidden boundary",
 "statement": "Let a point in the image of $U_i$ specialize in $U\\times_SX_i$ to a point\n$(u,x)$. There is a point $v\\in V_i$ with\n$\\psi_i(v)=u$ and image $x$ in $X_i$. If $u\\notin U_i$, then\n$v\\in Z_{i,j}$ and $x\\in\\overline Z_{i,j}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-thm-nagata-sketch-two-open/lemma-nagata-intermediate-specialization-boundary.md",
  "place": "node lemma-nagata-intermediate-specialization-boundary, order 288"
 },
 "stmt_deps": [
  "def-nagata-two-open-boundary-loci",
  "def-nagata-two-open-graph-extensions",
  "def-nagata-two-open-intermediate-schemes",
  "def-nagata-two-open-prepared-boundaries"
 ],
 "proof": [
  {
   "text": "The image of $U_i$ is contained in the image of\n$\\gamma_i\\colon V_i\\to U\\times_SX_i$. The latter image is closed by\n[lemma-nagata-proper-extension-graph-closed]; hence the specialization\n$(u,x)$ is $\\gamma_i(v)$ for some $v\\in V_i$. Thus\n$\\psi_i(v)=u$ and the image of $v$ in $X_i$ is $x$. If $u\\notin U_i$, then\n$u\\in Z_j$, so $v\\in Z_{i,j}=\\psi_i^{-1}(Z_j)$. Therefore\n$x\\in Z_{i,j}\\subseteq\\overline Z_{i,j}$.",
   "uses": [
    "lemma-nagata-proper-extension-graph-closed"
   ],
   "elementary": false
  }
 ],
