 ],
 "proof": [
  {
   "text": "Since $a\\in I=I^1$, the monomial $at$ belongs to the degree-one piece by\n[lemma-nagata-rees-piece-membership]. The underlying-polynomial and\ncoefficient formulas follow from the corresponding formulas for a\npolynomial monomial.",
   "uses": [
    "lemma-nagata-rees-piece-membership"
   ],
   "elementary": false
  }
 ],
