 },
 "kind": "statement",
 "title": "A quasi-finite morphism is quasi-affine",
 "statement": "Let $f\\colon X\\to Y$ be separated, quasi-compact, locally quasi-finite and\nlocally of finite type. Then $f$ is quasi-affine in the sense of\n[def-nagata-quasi-affine-morphism]. No hypothesis on $Y$ is needed.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-prop-nagata-sketch-zmt/lemma-nagata-quasi-affine-morphism-of-quasi-finite.md",
  "place": "node lemma-nagata-quasi-affine-morphism-of-quasi-finite, order 187"
 },
 "stmt_deps": [
  "def-nagata-quasi-affine-morphism"
 ],
 "proof": [
  {
   "text": "Let $Y'\\subseteq Y$ be an affine open. All four hypotheses are stable under\nrestricting the base to an open subscheme, so $f^{-1}(Y')\\to Y'$ is again\nseparated, quasi-compact, locally quasi-finite and locally of finite type.\nIts target $Y'$ is affine, hence quasi-affine, so\n[lemma-nagata-zmt-quasi-affine-source] makes $f^{-1}(Y')$ a quasi-affine\nscheme.",
   "uses": [
    "lemma-nagata-zmt-quasi-affine-source"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
  "lemma-nagata-zmt-quasi-affine-source",
