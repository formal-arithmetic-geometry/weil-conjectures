 "kind": "statement",
 "title": "An invertible ideal is effective Cartier",
 "statement": "An invertible ideal sheaf, viewed as an ideal by its specified inclusion into\nthe structure sheaf, is an effective Cartier ideal.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-invertible-ideal-is-effective-cartier.md",
  "place": "node lemma-nagata-invertible-ideal-is-effective-cartier, order 99"
 },
 "stmt_deps": [
  "def-nagata-effective-cartier-ideal",
  "def-nagata-invertible-ideal"
 ],
 "proof": [
  {
   "text": "On an open set where the invertible ideal is free with basis $a$, the map\n$\\mathcal O_X\\to\\mathcal I$ sending $1$ to $a$ is an isomorphism. The\ninclusion $\\mathcal I\\hookrightarrow\\mathcal O_X$ is injective because\n$\\mathcal I$ is an ideal submodule, so the composite\n$\\mathcal O_X\\to\\mathcal O_X$ is multiplication by $a$ and is injective.\nThus $a$ is a non-zero-divisor on every member of this cover, which is\nexactly the effective-Cartier condition.",
   "uses": [],
   "elementary": null
  }
 ],
