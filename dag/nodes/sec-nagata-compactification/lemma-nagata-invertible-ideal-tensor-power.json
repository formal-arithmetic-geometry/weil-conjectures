 "kind": "statement",
 "title": "Tensor powers of an invertible ideal",
 "statement": "If $\\mathcal L\\subseteq\\mathcal O_Y$ is an invertible ideal, then for every\n$n\\geq0$ the multiplication map\n\n$$\n\\mathcal L^{\\otimes n}\\longrightarrow\\mathcal L^n\n$$\n\nis an isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-invertible-ideal-tensor-power.md",
  "place": "node lemma-nagata-invertible-ideal-tensor-power, order 106"
 },
 "stmt_deps": [
  "def-nagata-effective-cartier-ideal",
  "def-nagata-invertible-ideal"
 ],
 "proof": [
  {
   "text": "By [lemma-nagata-invertible-ideal-is-effective-cartier], work on an\nopen cover where $\\mathcal L=(a)$ with $a$ a non-zero-divisor. The source\nhas basis $a^{\\otimes n}$ and the target has basis $a^n$; multiplication\nsends the first basis to the second. Hence it is an isomorphism on this\ncover, and is therefore an isomorphism of sheaves.",
   "uses": [
    "lemma-nagata-invertible-ideal-is-effective-cartier"
   ],
   "elementary": false
  }
 ],
