 },
 "stmt_deps": [
  "def-nagata-two-open-boundary-loci",
  "def-nagata-two-open-graph-extensions",
  "def-nagata-two-open-intermediate-schemes"
 ],
 "proof": [
  {
   "text": "By [lemma-nagata-intermediate-overlap-constructible], the image is\nconstructible. By\n[lemma-nagata-intermediate-overlap-specialization-closed], it is stable\nunder specialization. The target is Noetherian, so the image is closed.\nFactor the given immersion as a closed immersion into an open subscheme\n$T'\\subseteq T$, where\n$T=U\\times_S(X_i\\setminus\\overline Z_{i,j})$. Over $T'$ the map is a\nclosed immersion by construction. Over the open complement of its closed\nimage in $T$, its inverse image is empty, hence is also a closed immersion.\nThese two opens cover $T$: every point outside $T'$ is outside the image.\nSince being a closed immersion is local on the target, the original\nimmersion is a closed immersion.",
   "uses": [
    "lemma-nagata-intermediate-overlap-constructible",
    "lemma-nagata-intermediate-overlap-specialization-closed"
   ],
   "elementary": false
  }
 ],
