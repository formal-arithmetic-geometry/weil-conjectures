 "proof": [
  {
   "text": "Since $I^0=A$, a degree-zero Rees element is exactly a constant polynomial.\nThe inverse sends $a$ to the constant monomial $at^0$. The two composites\nare identities by coefficient extensionality.",
   "uses": [],
   "elementary": null
