 ],
 "proof": [
  {
   "text": "By [def-nagata-two-open-graph-extensions], the morphism\n$\\psi_i\\colon V_i\\to U$ is proper. Regard\n$\\gamma_i\\colon V_i\\to U\\times_SX_i$ as a morphism over $U$. The target\nprojection $U\\times_SX_i\\to U$ is separated because it is the base change\nof the separated morphism $X_i\\to S$. Apply\n[lemma-nagata-proper-to-separated-target] with\n$T=V_i$, $Y=U\\times_SX_i$, and $B=U$. It makes $\\gamma_i$ proper.\nProper morphisms are universally closed, so the image of $\\gamma_i$ is\nclosed.",
   "uses": [
    "def-nagata-two-open-graph-extensions",
    "lemma-nagata-proper-to-separated-target"
   ],
   "elementary": false
  }
 ],
