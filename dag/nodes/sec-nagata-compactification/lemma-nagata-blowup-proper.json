 "kind": "statement",
 "title": "Properness of a blow-up",
 "statement": "Let $X$ be a scheme and let $\\mathcal I$ be a finite-type quasi-coherent\nideal on $X$. Its blow-up is proper over $X$. In particular,\nevery admissible blow-up used in this chapter is proper.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-blowup-proper.md",
  "place": "node lemma-nagata-blowup-proper, order 163"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "A finite type quasi-coherent ideal defines the global blow-up of\n[def-nagata-global-blowup]. Its structure map is proper by\n[thm-nagata-global-blowup-proper]. An admissible blow-up is a blow-up\nof precisely this form.",
   "uses": [
    "def-nagata-global-blowup",
    "thm-nagata-global-blowup-proper"
   ],
   "elementary": false
  }
 ],
