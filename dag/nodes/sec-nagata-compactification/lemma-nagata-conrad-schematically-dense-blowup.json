 "kind": "statement",
 "title": "An admissible blow-up making the open scheme-theoretically dense",
 "statement": "Let $X$ be qcqs and let $U\\subseteq X$ be a quasi-compact open. There is a\n$U$-admissible blow-up $X_1\\to X$ in which $U$ is scheme-theoretically\ndense. If $U$ is dense in $X$ and $\\widetilde X\\to X$ is any $U$-admissible\nblow-up, the same applies to $\\widetilde X$, and the composite\n$X_1\\to\\widetilde X\\to X$ is again a $U$-admissible blow-up of $X$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-conrad-schematically-dense-blowup.md",
  "place": "node lemma-nagata-conrad-schematically-dense-blowup, order 176"
 },
 "stmt_deps": [
  "def-nagata-admissible-blowup",
  "def-nagata-constructible-closed-support",
  "def-nagata-dense-compactification",
  "def-nagata-global-blowup",
  "def-nagata-qc-open-complement-ideal"
 ],
 "proof": [
  {
   "text": "By [lemma-nagata-qc-open-complement-ideal-exists] there is a finite\ntype quasi-coherent ideal $\\mathcal I_0\\subseteq\\mathcal O_X$ with\n$V(\\mathcal I_0)=X\\setminus U$. Its blow-up is $U$-admissible, and $U$ is\nscheme-theoretically dense in it by the second assertion of\n[lemma-nagata-conrad-dense-in-admissible-blowup]. Applying this to\n$\\widetilde X$ in place of $X$ — legitimate because the preserved open of\na $U$-admissible blow-up is again quasi-compact — and composing,\n[lemma-nagata-admissible-blowup-comp] identifies the composite with a\nsingle $U$-admissible blow-up of $X$.",
   "uses": [
    "lemma-nagata-qc-open-complement-ideal-exists",
    "lemma-nagata-conrad-dense-in-admissible-blowup",
    "lemma-nagata-admissible-blowup-comp"
   ],
   "elementary": false
  }
 ],
