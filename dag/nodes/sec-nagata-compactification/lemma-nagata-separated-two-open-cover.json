 },
 "kind": "statement",
 "title": "[stacks-project]",
 "statement": "Let $X=U\\cup V$ be an open cover over $S$. Assume that $U\\to S$ and\n$V\\to S$ are separated and that\n\n$$\nU\\cap V\\longrightarrow U\\times_SV\n$$\n\nis a closed immersion. Then $X\\to S$ is separated.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-common/lemma-nagata-separated-two-open-cover.md",
  "place": "node lemma-nagata-separated-two-open-cover, order 236"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "The target of $\\Delta_{X/S}$ is covered by\n\n$$\nU\\times_SU,\\quad U\\times_SV,\\quad\nV\\times_SU,\\quad V\\times_SV.\n$$",
   "uses": [],
   "elementary": null
  },
  {
   "text": "On the two unmixed pieces the diagonal is closed by separatedness of $U/S$\nand $V/S$. On the mixed pieces use\n[lemma-nagata-diagonal-mixed-open]. Closed immersions are local on the\ntarget, so $\\Delta_{X/S}$ is closed.",
   "uses": [
    "lemma-nagata-diagonal-mixed-open"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
  "lemma-nagata-diagonal-mixed-open"
 ],
