  "def-nagata-effective-cartier-ideal",
  "def-nagata-extended-ideal",
  "def-nagata-global-blowup",
  "def-nagata-invertible-ideal"
 ],
 "proof": [
  {
   "text": "The maps are composites over $X$ by definition. On $U$, all three ideals\nare the unit ideal, so all three blow-ups are identified with $U$ by the\ncomplement theorem. The universal maps are unique over $U$, hence become\nthe identity under these identifications.",
   "uses": [],
   "elementary": null
  }
 ],
