 },
 "kind": "statement",
 "title": "Principalization of the center ideal",
 "statement": "If $\\mathcal I$ is a finite type quasi-coherent ideal on $X$, then on\n$\\operatorname{Bl}_{\\mathcal I}(X)$ the extended ideal\n$\\mathcal I\\mathcal O_{\\operatorname{Bl}_{\\mathcal I}(X)}$ is locally\nprincipal, generated locally by a non-zero-divisor, and hence is an\ninvertible ideal defining an effective Cartier divisor.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/thm-nagata-blowup-principalizes-center.md",
  "place": "node thm-nagata-blowup-principalizes-center, order 102"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "Work locally on an arbitrary affine open of $X$. Finite type of\n$\\mathcal I$ gives finitely many generators on that affine, and the\ncorresponding standard charts cover its blow-up. Use\n[lemma-nagata-chart-extended-ideal-principal] and\n[lemma-nagata-chart-generator-regular]. The local principal ideals\nglue because their generators differ by units by\n[lemma-nagata-chart-generators-associated].",
   "uses": [
    "lemma-nagata-chart-extended-ideal-principal",
    "lemma-nagata-chart-generator-regular",
    "lemma-nagata-chart-generators-associated"
   ],
   "elementary": false
  }
 ],
