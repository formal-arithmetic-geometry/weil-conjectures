 "kind": "statement",
 "title": "[stacks-project]",
 "statement": "Let $Z\\hookrightarrow X$ be a closed immersion and let $X'\\to X$ be a\nblow-up. Blowing up $Z$ in the pulled-back center gives the strict transform\nof $Z$ in $X'$. Strict transforms computed inside $Z$ and inside $X$ agree\nunder the induced closed immersion.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-strict-transform-ambient-closed.md",
  "place": "node lemma-nagata-strict-transform-ambient-closed, order 164"
 },
 "stmt_deps": [
  "def-nagata-extended-ideal",
  "def-nagata-global-blowup",
  "def-nagata-strict-transform"
 ],
 "proof": [
  {
   "text": "By [thm-nagata-strict-transform-is-blowup], the strict transform is the\nblow-up of $Z$ in the extended center ideal. On an affine chart\n$X=\\operatorname{Spec}(A)$ with $Z=\\operatorname{Spec}(B)$, the induced\nmap to $Z\\times_XX'$ is the quotient map\n$B\\otimes_AA[I/a]\\twoheadrightarrow B\\otimes_AA[I/a]/\\Gamma_{(a)}$. The target chart of the blow-up of $Z$ is\nidentified with this quotient by\n[prop-nagata-strict-transform-chart-iso]. It is therefore precisely\nthe closed immersion of the closed chart model. These identifications\ncommute with localization and agree on overlaps by\n[prop-nagata-strict-transform-closed-fiber-product]; gluing proves\nequality of the two global closed subschemes, as well as the claimed\ncompatibility with the induced closed immersion.",
   "uses": [
    "thm-nagata-strict-transform-is-blowup",
    "prop-nagata-strict-transform-chart-iso",
    "prop-nagata-strict-transform-closed-fiber-product"
   ],
   "elementary": false
  }
 ],
