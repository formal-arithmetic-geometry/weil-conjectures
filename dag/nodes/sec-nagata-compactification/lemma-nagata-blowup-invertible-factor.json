 },
 "kind": "statement",
 "title": "Blow-up is unchanged after multiplying by an invertible factor",
 "statement": "Let $X$ be a scheme, let $\\mathcal L$ be an invertible ideal on $X$, and\nlet $\\mathcal J$ be a quasi-coherent ideal (finite-typeness is not needed).\nThen the blow-ups of $\\mathcal L\\mathcal J$ and of $\\mathcal J$ are\ncanonically isomorphic over $X$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-blowup-invertible-factor.md",
  "place": "node lemma-nagata-blowup-invertible-factor, order 131"
 },
 "stmt_deps": [
  "def-nagata-effective-cartier-ideal",
  "def-nagata-extended-ideal",
  "def-nagata-global-blowup",
  "def-nagata-invertible-ideal"
 ],
 "proof": [
  {
   "text": "Tensor the tautological quotient for $\\mathcal J$ with the pullback of the\ninvertible ideal $\\mathcal L$ to obtain an invertible quotient of\n$\\mathcal L\\mathcal J$; this gives a lift from\n$\\operatorname{Bl}_{\\mathcal J}(X)$ to\n$\\operatorname{Bl}_{\\mathcal L\\mathcal J}(X)$. Conversely, tensor the\ntautological quotient of $\\mathcal L\\mathcal J$ with the dual of the\npulled-back invertible module $\\mathcal L$. The evaluation isomorphism\ngives an invertible quotient of $\\mathcal J$ and hence a reverse lift.\nLocally this is division by a basis of $\\mathcal L$, so the quotient maps\nare compatible with the specified ideal inclusions and glue independently\nof the chosen bases. Both composites induce the original tautological\nquotient, so uniqueness in\n[thm-nagata-blowup-universal-property] makes them identities.",
   "uses": [
    "thm-nagata-blowup-universal-property"
   ],
   "elementary": false
  }
 ],
