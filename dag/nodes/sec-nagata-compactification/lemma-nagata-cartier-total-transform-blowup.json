 "kind": "statement",
 "title": "Total transform of a Cartier ideal under a blow-up",
 "statement": "Let $\\mathcal L\\subseteq\\mathcal O_T$ be an effective Cartier ideal and let\n$T'\\to T$ be a blow-up. Then the extended ideal\n$\\mathcal L\\mathcal O_{T'}$ is again effective Cartier, and in particular\nis invertible.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-cartier-total-transform-blowup.md",
  "place": "node lemma-nagata-cartier-total-transform-blowup, order 121"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "Work over an affine open $\\operatorname{Spec}(A)\\subseteq T$ on which\n$\\mathcal L=(x)$ with $x$ a non-zero-divisor. A standard chart of the\nblow-up has ring $A[I/a]\\subseteq A_a$. If\n$x(y/a^n)=0$ in this chart, then $a^mxy=0$ in $A$ for some $m$; regularity\nof $x$ gives $a^my=0$, hence $y/a^n=0$. Thus the image of $x$ is regular\non every blow-up chart. It generates the extended ideal there, so these\nlocal equations make $\\mathcal L\\mathcal O_{T'}$ an effective Cartier\nideal, hence an invertible one.",
   "uses": [],
   "elementary": null
  }
 ],
