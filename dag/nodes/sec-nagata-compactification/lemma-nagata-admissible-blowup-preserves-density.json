 "kind": "statement",
 "title": "Density is preserved by an admissible blow-up",
 "statement": "Let $U\\hookrightarrow X$ be a quasi-compact scheme-theoretically dense open\nimmersion, and let $\\mathcal I$ be a finite type quasi-coherent ideal with\n$\\mathcal I|_U=\\mathcal O_U$. Then the inverse image of $U$ is\nscheme-theoretically dense in $\\operatorname{Bl}_{\\mathcal I}(X)$.\nConsequently the same assertion holds after any finite composite of\n$U$-admissible blow-ups.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-admissible-blowup-preserves-density.md",
  "place": "node lemma-nagata-admissible-blowup-preserves-density, order 103"
 },
 "stmt_deps": [
