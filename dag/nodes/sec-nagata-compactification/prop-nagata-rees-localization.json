 ],
 "proof": [
  {
   "text": "For each $n$, let $\\rho_{s,n}$ be the equivalence of\n[lemma-nagata-localization-rees-piece]. Taking their direct sum is\nlegitimate because every Rees element has finite homogeneous support. On\nhomogeneous tensors of degrees $m,n$, both ways around the multiplication\nsquare have coefficient $(xy)/1$ in degree $m+n$; the equality of localized\nideal powers from [lemma-nagata-localization-ideal-pow] proves\nmultiplicativity. The direct sum of the inverse maps is constructed in\nthe same way, and the two composites are identities in each degree, hence\non finite sums. This gives the claimed graded ring equivalence.",
   "uses": [
    "lemma-nagata-localization-rees-piece",
    "lemma-nagata-localization-ideal-pow"
   ],
   "elementary": false
  }
 ],
