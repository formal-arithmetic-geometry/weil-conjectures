 "proof": [
  {
   "text": "By [lemma-nagata-chart-ring-normal-form], the target is generated as a\n$B$-algebra by the fractions $z/b$ with $z\\in J$. Write\n$z=\\sum_k y_k\\overline{x_k}$ with $x_k\\in I$. Then\n\n$$\nz/b=\\sum_k\\sigma_a\\bigl(y_k\\otimes(x_k/a)\\bigr),\n$$\n\nproving surjectivity.",
   "uses": [
    "lemma-nagata-chart-ring-normal-form"
   ],
   "elementary": false
  }
 ],
