 "kind": "statement",
 "title": "An admissible blow-up is unchanged over the preserved open",
 "statement": "If $\\pi\\colon X'\\to X$ is $U$-admissible, then its center ideal restricts to\nthe unit ideal on $U$, and the induced morphism\n$X'\\times_XU\\to U$ is an isomorphism. The inverse and the equality over\n$U$ are part of the resulting specified isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-def-nagata-sketch-data/lemma-nagata-admissible-blowup-over-open.md",
  "place": "node lemma-nagata-admissible-blowup-over-open, order 62"
 },
 "stmt_deps": [
  "def-nagata-global-blowup"
 ],
 "proof": [
  {
   "text": "Choose the ideal and blow-up identification from\n[def-nagata-admissible-blowup]. The unit-ideal restriction is the\ndisjointness condition on the center. Apply\n[thm-nagata-global-blowup-complement] to identify the blow-up over $U$\nwith $U$, then transport that isomorphism across the chosen identification\nwith $X'$.",
   "uses": [
    "def-nagata-admissible-blowup",
    "thm-nagata-global-blowup-complement"
   ],
   "elementary": false
  }
 ],
