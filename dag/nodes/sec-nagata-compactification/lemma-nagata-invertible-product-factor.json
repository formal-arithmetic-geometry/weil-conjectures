 "kind": "statement",
 "title": "[stacks-project]",
 "statement": "Let $X$ be a scheme and let $\\mathcal I,\\mathcal J$ be quasi-coherent\nideals on $X$. If the product\n$\\mathcal I\\mathcal J$ defines an effective Cartier divisor, then each of\n$\\mathcal I$ and $\\mathcal J$ defines an effective Cartier divisor.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-invertible-product-factor.md",
  "place": "node lemma-nagata-invertible-product-factor, order 120"
 },
 "stmt_deps": [
  "def-nagata-effective-cartier-ideal",
  "def-nagata-invertible-ideal"
 ],
 "proof": [
  {
   "text": "Work on affine opens and apply\n[lemma-nagata-ideal-invertible-product-factor] to the corresponding\nideals. The resulting local invertible-module structures and regular\ngenerators are compatible under localization, so both ideal sheaves define\neffective Cartier divisors.",
   "uses": [
    "lemma-nagata-ideal-invertible-product-factor"
   ],
   "elementary": false
  }
 ],
