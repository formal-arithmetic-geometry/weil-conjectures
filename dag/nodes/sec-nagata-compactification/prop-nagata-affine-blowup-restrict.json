 "proof": [
  {
   "text": "By [prop-nagata-rees-localization], the coefficientwise localization\nof the Rees algebra is the Rees algebra of $IA_s$. On the standard open\nindexed by a homogeneous generator, the induced map is the isomorphism of\ndegree-zero chart rings from the localization equivalence. These chart\nisomorphisms agree on overlaps by the localization cocycle, and therefore\nglue to an inverse to $r_s$. The degree-zero piece is $A_s$ on both sides,\nso the glued inverse and $r_s$ are morphisms over $\\operatorname{Spec}(A_s)$.",
   "uses": [
    "prop-nagata-rees-localization"
   ],
   "elementary": false
  }
 ],
