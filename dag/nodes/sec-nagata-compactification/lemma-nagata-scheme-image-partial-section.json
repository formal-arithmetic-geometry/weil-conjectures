 },
 "kind": "statement",
 "title": "Scheme-theoretic image of a partial section",
 "statement": "Let $U\\hookrightarrow X$ be a quasi-compact open immersion, let\n$Y\\to S$ be separated, and let\n$U\\to X\\times_SY$ be a morphism whose first projection is the given open\nimmersion. If $Z$ is its scheme-theoretic image, then the projection\n$Z\\to X$ has inverse image $U$ over the open $U\\subseteq X$, and this\ninverse image maps isomorphically to $U$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-common/lemma-nagata-scheme-image-partial-section.md",
  "place": "node lemma-nagata-scheme-image-partial-section, order 238"
 },
 "stmt_deps": [
  "def-nagata-extended-ideal",
  "def-nagata-scheme-image-factor",
  "def-nagata-scheme-theoretic-closure",
  "def-nagata-scheme-theoretic-image"
 ],
 "proof": [
  {
   "text": "By [lemma-nagata-scheme-image-restrict-open], restriction to\n$U\\times_SY$ commutes with taking the scheme-theoretic image. On this\nopen target the original map is a section of\n$U\\times_SY\\to U$. That projection is separated, so its section is a\nclosed immersion. By\n[lemma-nagata-scheme-image-of-closed-immersion], its\nscheme-theoretic image is canonically its source, compatibly with the\nprojection to $U$.",
   "uses": [
    "lemma-nagata-scheme-image-restrict-open",
    "lemma-nagata-scheme-image-of-closed-immersion"
   ],
   "elementary": false
  }
 ],
