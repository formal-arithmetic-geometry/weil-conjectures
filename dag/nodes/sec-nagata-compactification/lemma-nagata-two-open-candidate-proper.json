 "proof": [
  {
   "text": "The morphism $U_1\\cap U_2\\to W$ is quasi-compact and dense by\n[lemma-nagata-final-density], and its valuation diagrams admit unique\nlifts by [lemma-nagata-two-open-valuative-lifting]. The dense-source\nvaluative criterion makes $W\\to S$ universally closed. It is separated\nand of finite type by\n[lemma-nagata-two-open-final-modification]; hence it is proper.",
   "uses": [
    "lemma-nagata-final-density",
    "lemma-nagata-two-open-valuative-lifting",
    "lemma-nagata-two-open-final-modification"
   ],
   "elementary": false
  }
 ],
