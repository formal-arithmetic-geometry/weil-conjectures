 },
 "kind": "statement",
 "title": "Existence of constructible closed separators in a spectral space",
 "statement": "If $T,T'$ are disjoint closed subsets of a spectral space $V$, there exist\nquasi-compact opens $W,W'\\subseteq V$ such that\n\n$$\nT'\\subseteq W,\\quad W\\cap T=\\varnothing,\\quad\nV\\setminus W\\subseteq W',\\quad W'\\cap T'=\\varnothing.\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-boundary/lemma-nagata-spectral-constructible-separation-exists.md",
  "place": "node lemma-nagata-spectral-constructible-separation-exists, order 252"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "Quasi-compact opens form a basis of a spectral space. For each $x\\in T'$,\nchoose a quasi-compact open neighbourhood contained in $V\\setminus T$.\nThe closed subset $T'$ is quasi-compact, so finitely many suffice; their\nunion is a quasi-compact open $W$ containing $T'$ and disjoint from $T$.\nThe closed subset $V\\setminus W$ is quasi-compact and lies in the open\n$V\\setminus T'$. Cover it by finitely many quasi-compact opens contained\nin $V\\setminus T'$ and let $W'$ be their union.",
   "uses": [],
   "elementary": null
  }
 ],
