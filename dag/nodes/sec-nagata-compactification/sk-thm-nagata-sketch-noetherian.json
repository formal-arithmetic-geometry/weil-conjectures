 "proof": [
  {
   "text": "Compactify the affine opens from [sk-lem-nagata-sketch-affine-cover].\nInduct on $X_r=U_1\\cup\\cdots\\cup U_r$. The overlap\n$X_{r-1}\\cap U_r$ contains the dense total intersection, so\n[sk-thm-nagata-sketch-two-open] compactifies $X_r$ at each step.\nThe last union is $X$; the empty scheme causes no exception.",
   "uses": [
    "sk-lem-nagata-sketch-affine-cover"
   ],
   "elementary": false
  }
 ],
