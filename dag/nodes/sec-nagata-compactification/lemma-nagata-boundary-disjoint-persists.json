 "kind": "statement",
 "title": "Disjoint boundary closures persist",
 "statement": "If $\\overline Z_{i,i}$ and $\\overline Z_{i,j}$ are disjoint, then their\nstrict transforms remain disjoint after every further $V_i$-admissible\nblow-up.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-prop-nagata-sketch-prepared/lemma-nagata-boundary-disjoint-persists.md",
  "place": "node lemma-nagata-boundary-disjoint-persists, order 269"
 },
 "stmt_deps": [
  "def-nagata-strict-transform"
 ],
 "proof": [
  {
   "text": "Let $b\\colon X'_i\\to X_i$ be a further $V_i$-admissible blow-up. By\n[lemma-nagata-strict-transform-restrict], the strict transform of\n$\\overline Z_{i,k}$ is the closure of its restriction over the open on\nwhich $b$ is an isomorphism. It is therefore contained in\n$b^{-1}(\\overline Z_{i,k})$. The inverse images of the disjoint closed\nsubschemes $\\overline Z_{i,i}$ and $\\overline Z_{i,j}$ are disjoint, so\ntheir contained strict transforms are disjoint as well.",
   "uses": [
    "lemma-nagata-strict-transform-restrict"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
