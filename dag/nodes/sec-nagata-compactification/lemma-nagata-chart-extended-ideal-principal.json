 "kind": "statement",
 "title": "Principalization on one affine chart",
 "statement": "In $A[I/a]$, the extended ideal satisfies\n\n$$\nI\\,A[I/a]=(a).\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-blowups/lemma-nagata-chart-extended-ideal-principal.md",
