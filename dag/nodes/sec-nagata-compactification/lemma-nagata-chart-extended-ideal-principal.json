 "stmt_deps": [
  "def-nagata-blowup-chart-ring",
  "def-nagata-homogeneous-localization-degree-zero",
  "def-nagata-rees-algebra",
  "def-nagata-rees-piece"
 ],
 "proof": [
  {
   "text": "For $x\\in I$, the identity $x=a(x/a)$ gives\n$IA[I/a]\\subseteq(a)$. Since $a\\in I$ and $1\\in A[I/a]$, the element\n$a=a\\cdot1$ belongs to $IA[I/a]$, so every multiple of $a$ belongs to that\nideal and $(a)\\subseteq IA[I/a]$.",
   "uses": [],
   "elementary": null
  }
 ],
