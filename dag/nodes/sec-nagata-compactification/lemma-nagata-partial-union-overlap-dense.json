 ],
 "proof": [
  {
   "text": "The overlap contains $D_X$. Since $X_r$ is open in $X$ and $D_X$ is dense\nin $X$, it is dense in $X_r$; therefore the larger subset\n$X_{r-1}\\cap U_r$ is dense in $X_r$.",
   "uses": [],
   "elementary": null
  }
 ],
