 "proof": [
  {
   "text": "Cover $X$ by affine opens. Under\n[prop-nagata-global-blowup-cover-independent], the restriction over each\naffine is the affine complement isomorphism of\n[lemma-nagata-affine-blowup-complement]. These local isomorphisms glue,\nand isomorphisms are local on source and target.",
   "uses": [
    "prop-nagata-global-blowup-cover-independent",
