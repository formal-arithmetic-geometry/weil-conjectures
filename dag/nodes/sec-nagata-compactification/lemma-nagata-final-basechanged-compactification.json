 "proof": [
  {
   "text": "Base change preserves every compactification field by\n[lemma-nagata-compactification-base-change]. Transporting the source\nacross the isomorphism $\\epsilon_Y$ preserves the open-immersion,\nquasi-compactness, properness, and factorization equalities.",
   "uses": [
    "lemma-nagata-compactification-base-change"
