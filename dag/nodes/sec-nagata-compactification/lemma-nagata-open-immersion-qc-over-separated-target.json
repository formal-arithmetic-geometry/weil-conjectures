 "kind": "statement",
 "title": "Quasi-compactness of an open map to a separated target",
 "statement": "Let $T\\to Y\\to B$ be a commutative triangle. Assume that $T\\to B$ is\nof finite type, that $Y\\to B$ is separated, and that $T\\to Y$ is an\nopen immersion. Then $T\\to Y$ is a quasi-compact open immersion.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-closure/lemma-nagata-open-immersion-qc-over-separated-target.md",
  "place": "node lemma-nagata-open-immersion-qc-over-separated-target, order 79"
 },
 "stmt_deps": [],
 "proof": [
  {
   "text": "By [lemma-nagata-finite-type-to-separated-target], the open immersion\nis of finite type. An open immersion is locally of finite type, and it is\nof finite type exactly when it is quasi-compact.",
   "uses": [
    "lemma-nagata-finite-type-to-separated-target"
   ],
   "elementary": false
  }
 ],
