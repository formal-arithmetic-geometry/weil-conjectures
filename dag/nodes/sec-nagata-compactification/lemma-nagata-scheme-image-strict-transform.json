  "def-nagata-strict-transform"
 ],
 "proof": [
  {
   "text": "Apply [lemma-nagata-scheme-image-transport-strict-transform] to the\ngiven map $V\\to X\\times_SY$. Its lifted map is exactly the map specified in\nthe statement through $\\varepsilon^{-1}$, so the resulting image equality is\nthe claimed identification with the strict transform.",
   "uses": [
    "lemma-nagata-scheme-image-transport-strict-transform"
