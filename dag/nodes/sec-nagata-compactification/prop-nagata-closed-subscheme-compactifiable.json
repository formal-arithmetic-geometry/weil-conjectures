 "title": "The closed-subscheme construction is a compactification",
 "statement": "The constructed factorization $\\mathsf{Closed}(i,C')$ is a compactification\nof $X\\to S$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-nagata-compactification/sk-lem-nagata-sketch-closure/prop-nagata-closed-subscheme-compactifiable.md",
  "place": "node prop-nagata-closed-subscheme-compactifiable, order 86"
 },
 "stmt_deps": [
  "def-nagata-closed-subscheme-compactification",
  "def-nagata-compactifiable",
  "def-nagata-compactification"
 ],
 "proof": [
  {
   "text": "Its ambient scheme $\\overline X$ is closed in the proper scheme\n$\\overline X'$, hence is proper over $S$. By\n[lemma-nagata-scheme-image-restrict-open], its pullback to the open\n$X'\\subseteq\\overline X'$ is the scheme-theoretic image of\n$i\\colon X\\hookrightarrow X'$. By\n[lemma-nagata-scheme-image-of-closed-immersion], the factor map for\n$i$ is an isomorphism, and compatibility with the image inclusion identifies\nthe pullback image with $X$. Hence\n\n$$\nX\\cong\\overline X\\times_{\\overline X'}X',\n$$\n\nso $X\\to\\overline X$ is identified with the base change of the\nquasi-compact open immersion $X'\\to\\overline X'$.",
   "uses": [
    "lemma-nagata-scheme-image-restrict-open",
    "lemma-nagata-scheme-image-of-closed-immersion"
   ],
   "elementary": false
  }
 ],
