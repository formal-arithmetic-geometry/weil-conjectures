 "kind": "statement",
 "title": "Constant coefficients have unit stalk trace",
 "statement": "For the constant complex $K=A_X$ in degree zero and the canonical\nmap $u:Lh^*A_X\\simeq A_X$, every fixed geometric stalk has\ncategorical trace equal to $1$.\nThe complex is site-perfect.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-trace-formula/sk-p-pairing/cor-trf-constant-stalk-trace.md",
  "place": "node cor-trf-constant-stalk-trace, order 2322"
 },
 "stmt_deps": [
  "def-trf-categorical-trace"
 ],
 "proof": [
  {
   "text": "The complex consists of a single free rank-one sheaf, so it satisfies\n[def-weil-site-perfect-complex]. Pullback preserves the unit by\n[def-weil-derived-pullback-tensor-hom]; its canonical map is the\nidentity on each rank-one stalk. The degree-zero chain trace in\n[lem-trf-chain-supertrace] is therefore $1$.",
   "uses": [
    "def-weil-site-perfect-complex",
    "def-weil-derived-pullback-tensor-hom",
    "lem-trf-chain-supertrace"
   ],
   "elementary": false
  }
 ],
