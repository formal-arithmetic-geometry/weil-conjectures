{
 "id": "lem-trf-algebraic-space-coproduct",
 "kind": "statement",
 "title": "Coproducts of algebraic spaces",
 "statement": "Let $S$ be a scheme [def-pc-scheme]. Let $I$ be a set and let $(F_i)_{i\\in I}$ be algebraic spaces over $S$ [def-trf-algebraic-space]. Assume there are surjective etale maps from schemes $U_i\\to F_i$ whose coproduct $\\coprod_{i\\in I}U_i$ is a scheme over $S$. Then the sheaf coproduct $F=\\coprod_{i\\in I}F_i$ on $(\\mathit{Sch}/S)_{fppf}$ is an algebraic space over $S$.",
 "source": {
  "document": "literature/stacks-project/spaces.tex",
  "place": "Tag 02WQ (coproduct-algebraic-spaces), including its size hypothesis."
 },
 "stmt_deps": [
