 "kind": "statement",
 "title": "Pullback of a stratification",
 "statement": "Let $g\\colon Y\\to X$ be a morphism and let $(\\iota_k\\colon Z_k\\to X)_{k<n}$\nbe a stratification of $X$. Then the base changes\n$(\\iota'_k\\colon Z_k\\times_XY\\to Y)_{k<n}$ form a stratification of $Y$,\nwith strata $g^{-1}(X_k)$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-p1/lemma-constructible-pullback-stratification.md",
  "place": "node lemma-constructible-pullback-stratification, order 1164"
 },
 "stmt_deps": [
  "def-constructible-stratification"
 ],
 "proof": [
  {
   "text": "Immersions are stable under base change, and the image of the base change\n$Z_k\\times_XY\\to Y$ of $\\iota_k$ is the preimage $g^{-1}(\\iota_k(Z_k))$:\nthe underlying set of a fibre product of schemes surjects onto the\nset-theoretic fibre product, so the image of the projection to $Y$ is\nexactly the set of points of $Y$ whose image in $X$ lies in the image of\n$\\iota_k$. The sets $g^{-1}(X_k)$ are locally closed, pairwise disjoint and\ncover $Y$, as preimages of the locally closed, pairwise disjoint sets $X_k$\ncovering $X$.",
   "uses": [],
   "elementary": null
  }
 ],
