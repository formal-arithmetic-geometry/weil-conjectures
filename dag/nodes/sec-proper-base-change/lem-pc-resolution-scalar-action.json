{
 "id": "lem-pc-resolution-scalar-action",
 "kind": "statement",
 "title": "Multiplication on derived global sections",
 "statement": "Let $X$ be a scheme, $M$ an $\\mathcal O_X$-module, $I$ an injective resolution of $M$ [def-sp-injective-resolutions], $p\\in\\mathbb N$, and $a\\in\\Gamma(X,\\mathcal O_X)$. For every $x\\in H^p_{\\mathrm{Mod}}(X,M)$ [pqf-def-cohomology], the map on cohomology induced by multiplication by $a$ on $M$ takes $x$ to $a x$.",
 "source": {
  "document": "https://stacks.math.columbia.edu/tag/01E4",
  "place": "Tags 01E4 and 01E5; linearity of section complexes and their cohomology"
 },
 "stmt_deps": [
  "def-sp-injective-resolutions",
  "def-sc-ringed-space-module-cohomology"
 ],
 "proof": [
  {
   "text": "Proof: Multiplication by the global section termwise on an injective resolution lifts\nmultiplication on the resolved module, by naturality of multiplication. After global\nsections this is scalar multiplication on the complex. Homology preserves this scalar\nendomorphism, and naturality of the linear resolution comparison gives the result.",
   "uses": [
    "def-sc-ringed-space-module-cohomology",
    "lem-sp-derived-well-defined",
    "lem-weil-pbc-scheme-modules-enough-injectives"
   ],
   "elementary": false
  }
 ],
