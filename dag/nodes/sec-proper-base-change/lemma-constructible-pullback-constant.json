 "kind": "statement",
 "title": "Pullback of a constant sheaf",
 "statement": "For $g\\colon Y\\to X$ and $M\\in\\mathcal A$ there is a natural isomorphism\n$g^*(M_X)\\cong M_Y$. In particular $g^*$ sends constant sheaves to constant\nsheaves.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-p1/lemma-constructible-pullback-constant.md",
  "place": "node lemma-constructible-pullback-constant, order 1160"
 },
 "stmt_deps": [
  "def-constructible-constant"
 ],
 "proof": [
  {
   "text": "Both $M\\mapsto g^*(M_X)$ and $M\\mapsto M_Y$ are left adjoint to\n$\\mathcal G\\mapsto\\Gamma(Y,\\mathcal G)=\\Gamma(X,g_*\\mathcal G)$, because\nbase change along $g$ preserves the terminal object of the site\n($Y\\times_XX\\cong Y$); left adjoints are unique up to unique isomorphism.",
   "uses": [],
   "elementary": null
  }
 ],
