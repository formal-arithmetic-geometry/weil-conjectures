{
 "id": "lem-weil-pbc-vanishing-descends-retract",
 "kind": "statement",
 "title": "Vanishing descends to a retract",
 "statement": "If $I$ is a direct summand of $M$ and $R^qh_*M=0$ for $q>0$, then\n$R^qh_*I=0$ for $q>0$. This remains true after arbitrary base change.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-reduction/lem-weil-pbc-vanishing-descends-retract.md",
  "place": "node lem-weil-pbc-vanishing-descends-retract, order 1188"
 },
 "stmt_deps": [
  "def-weil-pbc-direct-image"
 ],
 "proof": [
  {
   "text": "The higher direct image functors are additive, and additive functors preserve\nretracts, so the direct summand structure on $I$ is preserved by $R^qh_*$; the\nasserted vanishing follows from the vanishing on $M$. The argument is\ninsensitive to base change.",
   "uses": [],
   "elementary": null
  }
 ],
