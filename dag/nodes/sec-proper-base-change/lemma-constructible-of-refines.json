 "kind": "statement",
 "title": "Constructibility passes to refinements",
 "statement": "Let $(\\iota_k\\colon Z_k\\to X)_k$ be a stratification with all\n$\\iota_k^*\\mathcal F$ finite locally constant, and let\n$(\\kappa_l\\colon W_l\\to X)_l$ refine it. Then all $\\kappa_l^*\\mathcal F$\nare finite locally constant.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-properbasechange/lemma-constructible-of-refines.md",
  "place": "node lemma-constructible-of-refines, order 1294"
 },
 "stmt_deps": [
  "def-constructible-constructible",
  "def-constructible-finite-locally-constant",
  "def-constructible-refines",
  "def-constructible-stratification"
 ],
 "proof": [
  {
   "text": "Fix $l$ and choose $k$ with $X'_l\\subseteq X_k$. The base change\n$\\kappa'_l\\colon W_l\\times_XZ_k\\to Z_k$ of $\\kappa_l$ is an immersion, and\nthe composite $\\iota_k\\circ\\kappa'_l\\colon W_l\\times_XZ_k\\to X$ is an\nimmersion with image $\\iota_k(\\iota_k^{-1}(X'_l))=X'_l$, the same image as\n$\\kappa_l$. Its pullback of $\\mathcal F$ is\n$\\kappa_l'^*\\iota_k^*\\mathcal F$, finite locally constant by\n[prop-constructible-pullback] (its lemmas for locally constant and\nfinite sheaves). By [lemma-constructible-immersion-independence],\n$\\kappa_l^*\\mathcal F$ is finite locally constant.",
   "uses": [
    "prop-constructible-pullback",
    "lemma-constructible-immersion-independence"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
