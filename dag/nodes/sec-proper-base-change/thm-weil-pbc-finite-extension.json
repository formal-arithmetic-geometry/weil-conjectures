 ],
 "proof": [
  {
   "text": "Choose an integral lattice for $K$: the isomorphism of\n[cor-weil-pbc-constructible-complete] is an isomorphism of\n$\\mathcal O_E$-linear functors on the integral constructible categories, so\nby [prop-weil-pbc-rational-transport] it remains an isomorphism after\nrationalization. The independence and coherence assertions are inherited\nfrom the integral level.",
   "uses": [
    "cor-weil-pbc-constructible-complete",
    "prop-weil-pbc-rational-transport"
   ],
   "elementary": false
  }
 ],
