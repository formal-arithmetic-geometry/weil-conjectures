 "kind": "statement",
 "title": "Proper base change over a finite extension",
 "statement": "For every finite $E/\\Ql$, every cartesian square\n[def-weil-pbc-cartesian-square] with $f$ proper, and every\n$K\\in\\Dbc(X,E)$,\n$$\n Lg^*Rf_*K\\xrightarrow{\\sim}Rf'_*Lg'^*K\n \\quad\\text{in }\\Dbc(Y',E).\n$$",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-properbasechange/thm-weil-pbc-finite-extension.md",
  "place": "node thm-weil-pbc-finite-extension, order 1357"
 },
