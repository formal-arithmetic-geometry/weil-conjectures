{
 "id": "lem-sc-c2",
 "kind": "statement",
 "title": "C2: vanishing on affine curves",
 "statement": "Let $k$ be algebraically closed, let $C$ be a\nsmooth affine connected curve over $k$, and let\n$n$ be a prime. Then the constant sheaf $\\mathbf F_n$ satisfies\n$\\mathcal C_2(C,\\mathbf F_n)$ of\n[def-weil-pbc-eight-curve-assertions]: $H^q(C_{\\Et},\\mathbf F_n)=0$\nfor every $q>1$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-p1/lem-sc-c2.md",
  "place": "node lem-sc-c2, order 1113"
 },
 "stmt_deps": [
  "def-weil-pbc-eight-curve-assertions",
  "def-sc-curves"
 ],
 "proof": [
  {
   "text": "If $n\\neq\\operatorname{char}k$, this is\n[thm-sc-affine-cohomology]. If $n=\\operatorname{char}k=p>0$,\nthen $\\mathbf F_p$ is $p$-primary and the assertion follows from\n[lem-sc-artin-schreier-dimension] (and\n[lem-sc-affine-cohomological-dimension] directly).",
   "uses": [
    "thm-sc-affine-cohomology",
    "lem-sc-artin-schreier-dimension",
    "lem-sc-affine-cohomological-dimension"
   ],
   "elementary": false
  }
 ],
