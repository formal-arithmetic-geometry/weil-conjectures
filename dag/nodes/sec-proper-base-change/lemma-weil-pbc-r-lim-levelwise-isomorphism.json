 "kind": "statement",
 "title": "Limits preserve compatible levelwise isomorphisms",
 "statement": "If $u_n:M_n\\to N_n$ is a compatible map of towers and every $u_n$ is an\nisomorphism, then $R\\varprojlim u_n$ is an isomorphism.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-properbasechange/lemma-weil-pbc-r-lim-levelwise-isomorphism.md",
  "place": "node lemma-weil-pbc-r-lim-levelwise-isomorphism, order 1326"
 },
 "stmt_deps": [
