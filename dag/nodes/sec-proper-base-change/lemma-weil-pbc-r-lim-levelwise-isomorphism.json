 ],
 "proof": [
  {
   "text": "The maps $\\prod_nu_n$ are isomorphisms and commute with\n$1-\\mathrm{shift}$. Taking fibres in the homotopy-limit triangles preserves\nthe isomorphism.",
   "uses": [],
   "elementary": null
  }
 ],
