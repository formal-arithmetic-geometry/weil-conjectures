 "kind": "statement",
 "title": "Pullback of constructible sheaves",
 "statement": "Let $g\\colon Y\\to X$ be a morphism and let $\\mathcal F\\in\\shv{\\et X}$ be\nconstructible. Then $g^*\\mathcal F$ is constructible. In particular\nconstructibility is preserved by restriction to an open, to a closed\nsubscheme, and to any locally closed subscheme.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-p1/prop-constructible-pullback.md",
  "place": "node prop-constructible-pullback, order 1165"
 },
 "stmt_deps": [
  "def-constructible-constructible",
  "def-constructible-finite",
  "def-constructible-finite-locally-constant",
  "def-constructible-locally-constant",
  "def-constructible-stratification"
 ],
 "proof": [
  {
   "text": "Let $(\\iota_k\\colon Z_k\\to X)_k$ be a stratification of $X$ with all\n$\\iota_k^*\\mathcal F$ finite locally constant, and let\n$(\\iota'_k\\colon Z_k\\times_XY\\to Y)_k$ be its pullback\n([lemma-constructible-pullback-stratification]), with projections\n$g_k\\colon Z_k\\times_XY\\to Z_k$. Since $\\iota_k\\circ g_k=g\\circ\\iota'_k$\nand pullback is functorial up to natural isomorphism,\n$\\iota_k'^*g^*\\mathcal F\\cong g_k^*\\iota_k^*\\mathcal F$, which is finite\nlocally constant by\n[lemma-constructible-pullback-locally-constant], [lemma-constructible-pullback-finite]\nand [lemma-constructible-iso-invariance].",
   "uses": [
    "lemma-constructible-pullback-stratification",
    "lemma-constructible-pullback-locally-constant",
    "lemma-constructible-pullback-finite",
    "lemma-constructible-iso-invariance"
   ],
   "elementary": false
  }
 ],
