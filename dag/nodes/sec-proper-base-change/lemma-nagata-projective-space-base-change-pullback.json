 "kind": "statement",
 "title": "Projective space commutes with base change",
 "statement": "For every index set $n$ and every morphism of schemes $g\\colon X\\to S$, the\nsquare\n\n$$\n\\begin{array}{ccc}\n\\mathbf P(n;X) & \\longrightarrow & \\mathbf P(n;S)\\\\\n\\downarrow & & \\downarrow\\\\\nX & \\xrightarrow{\\ g\\ } & S\n\\end{array}\n$$\n\nis cartesian, that is, $\\mathbf P(n;X)\\cong X\\times_S\\mathbf P(n;S)$ over\n$X$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-reduction/lemma-nagata-projective-space-base-change-pullback.md",
  "place": "node lemma-nagata-projective-space-base-change-pullback, order 1191"
 },
 "stmt_deps": [
  "def-nagata-affine-proj"
 ],
 "proof": [
  {
   "text": "By [def-nagata-projective-space-base-change] the square\n\n$$\n\\begin{array}{ccc}\n\\mathbf P(n;S) & \\longrightarrow & \\mathbf P^n_{\\mathbf Z}\\\\\n\\downarrow & & \\downarrow\\\\\nS & \\longrightarrow & \\ast\n\\end{array}\n$$\n\nis cartesian, and likewise for $X$ in place of $S$. The latter is the\nrectangle obtained by pasting the square of the statement onto the former,\nso by the pasting lemma for cartesian squares the square of the statement is\ncartesian.",
   "uses": [
    "def-nagata-projective-space-base-change"
   ],
   "elementary": false
  }
 ],
