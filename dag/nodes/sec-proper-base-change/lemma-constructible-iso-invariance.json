 "kind": "statement",
 "title": "Invariance under isomorphism",
 "statement": "If $\\mathcal F\\cong\\mathcal F'$ in $\\shv{\\et X}$, then $\\mathcal F$ is\nlocally constant (finite, finite locally constant, constructible) if and\nonly if $\\mathcal F'$ is.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-proper-base-change/sk-thm-p1/lemma-constructible-iso-invariance.md",
  "place": "node lemma-constructible-iso-invariance, order 1161"
 },
 "stmt_deps": [
