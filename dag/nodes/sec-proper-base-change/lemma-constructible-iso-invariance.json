  "def-constructible-finite",
  "def-constructible-finite-locally-constant",
  "def-constructible-locally-constant",
  "def-constructible-stratification",
  "def-kun-separably-closed"
 ],
 "proof": [
  {
   "text": "An isomorphism of sheaves induces isomorphisms of the restrictions to every\nlocalised site, of all stalks, and of all pullbacks, and each of the four\nnotions is a condition on these. A trivialising datum, respectively a\nstratification, for $\\mathcal F$ is therefore one for $\\mathcal F'$.",
   "uses": [],
   "elementary": null
  }
 ],
