 },
 "stmt_deps": [
  "def-pc-ext"
 ],
 "proof": [
  {
   "text": "Base change is an equivalence of the underlying categories and matches the\ncovering families, hence is an equivalence of sites; so restriction along it\nis an equivalence of the categories of sheaves, and pullback, being its left\nadjoint, is a quasi-inverse. Cohomology is the $\\operatorname{Ext}$-groups\nout of the constant sheaf $\\mathbf Z$, and an exact equivalence carrying the\nconstant sheaf to the constant sheaf induces an isomorphism on those groups.",
   "uses": [],
   "elementary": null
  }
 ],
