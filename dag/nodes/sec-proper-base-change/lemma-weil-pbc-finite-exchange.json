 "blueprint_sketch": [
  {
   "statement": "For a finite Cartesian square, the underived exchange map is an isomorphism;\ntherefore all its derived exchange maps are isomorphisms.",
   "proof": "At a geometric point $\\bar y'\\to Y'$, the fibre of $f'$ is the base change of\nthe finite fibre of $f$ along $\\kappa(\\bar y)\\to\\kappa(\\bar y')$. The stalk\nformula identifies both sides with the same finite product indexed by these\npoints, and the exchange map is the identity on each factor. Thus it is a\nstalkwise bijection and hence an isomorphism. Exactness from the preceding\nlemma means injective resolutions remain direct-image acyclic, so the same\ndegreewise argument computes the derived map.",
   "cites": []
  }
 ],
