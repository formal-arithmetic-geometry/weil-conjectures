 "proof": [
  {
   "text": "Represent Z restricted to W by an ideal in the coordinate ring of W. Express the ideal as a directed union of finitely generated subideals and choose finitely many generators; their basic opens give the asserted characterization.",
   "uses": [],
   "elementary": false
  }
