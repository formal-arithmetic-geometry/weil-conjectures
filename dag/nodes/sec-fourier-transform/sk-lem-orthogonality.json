 "kind": "statement",
 "title": "Orthogonality",
 "statement": "$\\sum_{x\\in k_0}c\\,\\psi_a(x)=cq$ if $\\psi_a=1$, and $0$ otherwise; and\n$\\sum_{y\\in\\mathbf F_{q^n}}\\psi_n((x-x')y)=q^n$ if $x=x'$, and $0$ otherwise.",
 "source": {
  "document": "literature/blueprint/main-20261015/blueprint/sec-fourier-transform/sk-lem-orthogonality/_section.md",
  "place": "node sk-lem-orthogonality, order 3017"
 },
 "stmt_deps": [
  "sk-def-char"
 ],
 "proof": [
  {
   "text": "If $\\psi_a\\neq1$ choose $y$ with $\\psi_a(y)\\neq1$; translation is a\nbijection, so $S=\\psi_a(y)S$, hence $S=0$. The second identity is the first\napplied to $y\\mapsto\\psi_n((x-x')y)$, which is nontrivial exactly when\n$x\\neq x'$. The same sums separate the $\\psi_a$ for distinct $a$, so every\nnondegenerate character of $k_0$ is some $\\psi_a$.",
   "uses": [],
   "elementary": null
  }
 ],
