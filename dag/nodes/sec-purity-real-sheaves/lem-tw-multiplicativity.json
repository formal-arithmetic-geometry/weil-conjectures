 "kind": "statement",
 "title": "Weights multiply under tensor product",
 "statement": "If $\\alpha,\\beta$ are eigenvalues of weights $w_1,w_2$ (as in\n[def-tw-eigenvalue]), then $\\alpha\\beta$ has weight\n$w_1+w_2$, and $\\alpha^{-1}$ has weight $-w_1$ when\n$\\alpha\\neq0$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-purity-real-sheaves/sk-r-real-linear/lem-tw-multiplicativity.md",
  "place": "node lem-tw-multiplicativity, order 2598"
 },
 "stmt_deps": [
  "def-tw-eigenvalue"
 ],
 "proof": [
  {
   "text": "In the absolute-value convention of [def-tw-eigenvalue] the\nabsolute value is multiplicative:\n$|\\alpha\\beta|=|\\alpha||\\beta|=q^{(w_1+w_2)/2}$, and\n$|\\alpha^{-1}|=|\\alpha|^{-1}$; the same holds in every finite extension\nand every embedding.",
   "uses": [
    "def-tw-eigenvalue"
   ],
   "elementary": false
  }
 ],
