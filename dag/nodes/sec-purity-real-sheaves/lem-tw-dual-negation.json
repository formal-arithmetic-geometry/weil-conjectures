 "kind": "statement",
 "title": "Weight of the linear dual",
 "statement": "In the setting of [def-weil-punctual-weights], if a lisse\nWeil sheaf $\\mathcal F$ is\npunctually $\\iota$-pure of weight $w$, then its linear dual\n$\\mathcal F^\\vee$ ([def-real-weil-representation-operations]) is punctually $\\iota$-pure of weight $-w$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-purity-real-sheaves/sk-r-real-linear/lem-tw-dual-negation.md",
  "place": "node lem-tw-dual-negation, order 2599"
 },
 "stmt_deps": [
  "def-weil-punctual-weights",
  "def-real-weil-representation-operations",
  "def-weil-weil-sheaf-complex"
 ],
 "proof": [
  {
   "text": "The Frobenius eigenvalues on the dual stalk at a closed point $y$ are\nthe inverses of the eigenvalues of $F_y$ on $\\mathcal F_{\\bar y}$ ([p-linear-spectra])\n(the dual representation), so the complex moduli are\n$q_y^{-w/2}$ by [lem-tw-multiplicativity], which is weight $-w$\nin [def-weil-punctual-weights].",
   "uses": [
    "p-linear-spectra",
    "lem-tw-multiplicativity",
    "def-weil-punctual-weights"
   ],
   "elementary": false
  }
 ],
