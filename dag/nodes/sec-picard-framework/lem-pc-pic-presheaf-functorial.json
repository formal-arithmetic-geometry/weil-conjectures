 "kind": "statement",
 "title": "The Picard presheaf is a functor",
 "statement": "Let $f:X\\to S$ be a morphism of schemes. The assignment of\nDefinition [def-pc-picard-presheaf]\n$T\\mapsto\\operatorname{Pic}(X_T)$ is a functor\n$(\\mathit{Sch}/S)^{\\mathrm{op}}\\to\\textit{Sets}$: for $g:T'\\to T$ with\n$g_X:X_{T'}\\to X_T$ the map $\\mathcal{L}\\mapsto g_X^*\\mathcal{L}$ sends invertible\nmodules to invertible modules, respects isomorphisms and satisfies\n$(g_1\\circ g_2)^*=g_2^*g_1^*$ and $(\\mathrm{id})^*=\\mathrm{id}$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-def-picard-pic/lem-pc-pic-presheaf-functorial.md",
  "place": "node lem-pc-pic-presheaf-functorial, order 803"
 },
 "stmt_deps": [
  "def-pc-picard-presheaf",
  "def-pc-base-change",
  "def-sc-invertible-module"
 ],
 "proof": [
  {
   "text": "If $\\mathcal{L}$ is invertible on $X_T$, then $g_X^*\\mathcal{L}$ is invertible on\n$X_{T'}$: local on $X_{T'}$, $g_X^*\\mathcal{L}$ is the base change of a locally\nfree rank one module (trivializing by an open cover and using that\n$g_X^*$ preserves admits an exactness: $g_X^*$ of a free module of rank\none is free of rank one). The two functoriality equations are the\nstandard $(g_1g_2)^*=g_2^*g_1^*$ and $(\\mathrm{id})^*=\\mathrm{id}$ for the pullback\nfunctor (a straightforward identity of the corresponding module\nsections), and isomorphisms are sent to isomorphisms, so the map is\nwell defined on isomorphism classes.",
   "uses": [],
   "elementary": null
  }
 ],
 "proof_deps": [
  "lem-pc-tensor-dual-invertible"
 ],
