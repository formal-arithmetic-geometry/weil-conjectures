 "kind": "statement",
 "title": "$\\operatorname{Pic}$ of a field",
 "statement": "Let $k$ be a field. Then the\nPicard group of $\\operatorname{Spec}(k)$ is trivial:\nevery invertible $\\mathcal{O}_k$-module is isomorphic to $\\mathcal{O}_k$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-def-picard-pic/lem-pc-pic-of-field.md",
  "place": "node lem-pc-pic-of-field, order 802"
 },
 "stmt_deps": [
  "def-pc-scheme",
  "def-sc-invertible-module",
  "def-sc-picard-group"
 ],
 "proof": [
  {
   "text": "An invertible $\\mathcal{O}_k$-module is locally free of rank $1$; an $\\mathcal{O}_k$-module\nis the same as a $k$-vector space, and a locally free rank $1$ $k$-module\nis free of rank $1$ (a module over a field is free; every nonzero\nelement of a basis is a basis), hence isomorphic to $k=\\Gamma(\\operatorname{Spec} k,\\mathcal{O})$.",
   "uses": [],
   "elementary": null
  }
 ],
