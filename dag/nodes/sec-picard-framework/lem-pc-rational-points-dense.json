 "kind": "statement",
 "title": "Rational points on smooth schemes over separably closed fields",
 "statement": "Let $k$ be a separably closed field,\nlet $X$ be a scheme over $k$ which is smooth over $k$. Then $X(k)$ is\ndense in $X$; if $X$ is nonempty, then $X(k)\\neq\\emptyset$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-prop-picard-dense-points/lem-pc-rational-points-dense.md",
  "place": "node lem-pc-rational-points-dense, order 752"
 },
 "stmt_deps": [
  "def-pc-separably-closed"
 ],
 "proof": [
  {
   "text": "By [lem-pc-dense-separable-points] the set of closed points $x$ with\n$\\kappa(x)/k$ finite separable is dense in $X$. For such an $x$,\n$\\kappa(x)=k$ by [lem-pc-sepclosed-finite-sep-trivial], so $x$ is a\n$k$-rational point and the assertion follows.",
   "uses": [
    "lem-pc-dense-separable-points",
    "lem-pc-sepclosed-finite-sep-trivial"
   ],
   "elementary": false
  }
 ],
