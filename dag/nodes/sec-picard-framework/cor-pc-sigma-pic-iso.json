 "kind": "statement",
 "title": "$\\operatorname{Pic}_{X/k,\\sigma}$ is isomorphic to $\\operatorname{Pic}_{X/k}$",
 "statement": "Let $k$ be a field and let $X$ be a smooth projective curve over $k$ with\na $k$-rational point $\\sigma$. Then the functors\n$\\operatorname{Pic}_{X/k,\\sigma}$ and\n$\\operatorname{Pic}_{X/k}$ on\n$(\\mathit{Sch}/k)_{fppf}$ are isomorphic. In particular\n$\\operatorname{Pic}_{X/k,\\sigma}$ is an fppf sheaf (represented once $\\operatorname{Pic}_{X/k}$ is;\nand covariantly: if $\\operatorname{Pic}_{X/k,\\sigma}$ is representable, then so is\n$\\operatorname{Pic}_{X/k}$, by the group law of [thm-pc-pic-split]).",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-prop-picard-pic-split/cor-pc-sigma-pic-iso.md",
  "place": "node cor-pc-sigma-pic-iso, order 817"
 },
 "stmt_deps": [
  "thm-pc-pic-split",
  "def-pc-picard-functor"
 ],
 "proof": [
  {
   "text": "By [lem-pc-rational-hyp] and [thm-pc-pic-split],\n$\\operatorname{Pic}_{X/k}$ is the fppf sheafification of the presheaf\n$K(T)=\\operatorname{Ker}(\\sigma_T^*)$, and by [lem-pc-k-sheaf] the\npresheaf $K$ is itself an fppf sheaf; since\n$\\operatorname{Pic}_{X/k,\\sigma}=K$ ([def-pc-pic-sigma-functor]), the two functors\nare naturally isomorphic. [The reference is the discussion in Stacks\nProject, Picard Schemes of Curves, Section 44.6, after Lemma 44.6.1.]",
   "uses": [
    "lem-pc-rational-hyp",
    "thm-pc-pic-split",
    "lem-pc-k-sheaf",
    "def-pc-pic-sigma-functor"
   ],
   "elementary": false
  }
 ],
