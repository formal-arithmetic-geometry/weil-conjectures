 "kind": "statement",
 "title": "Cohomology above the number of projective coordinates",
 "statement": "For any commutative ring $A$, any $n\\ge0$, and any\nquasi-coherent module $\\mathcal F$ on\n$\\hyperref[def-pc-projective-space-twist]{\\mathbf P^n_A}$,\none has $H^q(\\mathbf P^n_A,\\mathcal F)=0$ for $q>n$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-thm-picard-pn/lem-pc-projective-space-cohomology-bound.md",
  "place": "node lem-pc-projective-space-cohomology-bound, order 621"
 },
 "stmt_deps": [
  "def-pc-projective-space-twist",
  "pqf-def-coherent",
  "pqf-def-cohomology"
 ],
 "proof": [
  {
   "text": "The $n+1$ standard opens of [def-pc-projective-space-twist]\nhave affine intersections, so [lem-pc-cech-computes] applies.\nThe alternating Cech complex has no terms in degrees greater than\n$n$, because no subset of the $n+1$ indices has more than $n+1$\nelements. Its cohomology in those degrees is zero.",
   "uses": [
    "def-pc-projective-space-twist",
    "lem-pc-cech-computes"
   ],
   "elementary": false
  }
 ],
