 "kind": "statement",
 "title": "Positive degree implies ample",
 "statement": "Let $C$ be a proper smooth connected curve of\ngenus $g$ over an algebraically closed field $k$ and\n$\\mathcal L$ a line bundle with $\\deg\\mathcal L>0$\n([def-sc-pic0]). Then $\\mathcal L$ is\nample.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-thm-picard-rr/lem-sc-positive-degree-ample.md",
  "place": "node lem-sc-positive-degree-ample, order 719"
 },
 "stmt_deps": [
  "def-sc-pic0",
  "def-sc-curves"
 ],
 "proof": [
  {
   "text": "Since $\\deg$ is a homomorphism ([def-sc-pic0]),\n$\\deg(\\mathcal L^{\\otimes m})=m\\deg\\mathcal L\\to\\infty$, so for\n$m\\gg0$ one has $\\deg(\\mathcal L^{\\otimes m})\\geq2g+1$, and by\n[lem-sc-degree-2g1-very-ample] the bundle\n$\\mathcal L^{\\otimes m}$ is very ample; by definition\n([def-sc-ample]) $\\mathcal L$ is ample.",
   "uses": [
    "def-sc-pic0",
    "lem-sc-degree-2g1-very-ample",
    "def-sc-ample"
   ],
   "elementary": false
  }
 ],
