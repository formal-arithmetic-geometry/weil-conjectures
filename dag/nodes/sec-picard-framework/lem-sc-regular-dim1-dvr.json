 "title": "One-dimensional regular local rings",
 "statement": "A regular local ring of dimension one is a discrete valuation ring.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-thm-picard-duality/lem-sc-regular-dim1-dvr.md",
  "place": "node lem-sc-regular-dim1-dvr, order 693",
