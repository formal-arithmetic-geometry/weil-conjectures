 "kind": "statement",
 "title": "Line bundles of negative degree",
 "statement": "Let $C$ be a proper smooth curve over an algebraically closed\nfield $k$, and $\\mathcal M$ a line bundle on $C$ with\n$\\deg\\mathcal M<0$ ([def-sc-pic0]). Then\n$H^0(C,\\mathcal M)=0$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-thm-picard-rr/lem-sc-negative-degree-no-sections.md",
  "place": "node lem-sc-negative-degree-no-sections, order 716"
 },
 "stmt_deps": [
  "def-sc-pic0"
 ],
 "proof": [
  {
   "text": "A section $s\\neq0$ gives\n$\\mathcal M\\cong\\mathcal O(\\operatorname{div}s)$ with\n$\\operatorname{div}s$ effective by\n[lem-sc-line-bundle-rational-section], so\n$\\deg\\mathcal M=\\deg\\operatorname{div}s\\geq0$, the degree being\nwell defined by [lem-sc-deg-principal-zero]; contradiction.",
   "uses": [
    "lem-sc-line-bundle-rational-section",
    "lem-sc-deg-principal-zero"
   ],
   "elementary": false
  }
 ],
 "proof_deps": [
