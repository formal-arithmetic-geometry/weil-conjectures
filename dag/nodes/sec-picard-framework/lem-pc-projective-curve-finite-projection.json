 "kind": "statement",
 "title": "A finite map from an integral projective curve to the projective line",
 "statement": "Let $k$ be an infinite field and $X$ a\nprojective\ncurve over $k$.\nThere exists a finite morphism\n$X\\to\\mathbf P^1_k$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-thm-picard-coherence/lem-pc-projective-curve-finite-projection.md",
  "place": "node lem-pc-projective-curve-finite-projection, order 654"
 },
 "stmt_deps": [
  "def-pc-curve",
  "def-pc-morphism-conventions",
  "def-sc-p1-standard"
 ],
 "proof": [
  {
   "text": "Choose a closed immersion $X\\hookrightarrow\\mathbf P^n_k$ from\n[def-pc-projective-morphism]. The coordinate model\n[lem-pc-projective-coordinate-model] identifies $X$ with\n$\\operatorname{Proj}(S)$ for an integral standard graded algebra.\nChoose $l_0,l_1$ by [lem-pc-projective-curve-linear-pair] and\nform $\\pi_{l_0,l_1}$ as in [def-pc-linear-pair-morphism], which\nexists by [lem-pc-linear-pair-morphism-gluing].\nIt is finite by [lem-pc-linear-pair-morphism-finite].",
   "uses": [
    "def-pc-projective-morphism",
    "lem-pc-projective-coordinate-model",
    "lem-pc-projective-curve-linear-pair",
    "def-pc-linear-pair-morphism",
    "lem-pc-linear-pair-morphism-gluing",
    "lem-pc-linear-pair-morphism-finite"
   ],
   "elementary": false
  }
 ],
