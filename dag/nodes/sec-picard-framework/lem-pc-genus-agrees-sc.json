 "kind": "statement",
 "title": "Agreement with the genus of file 06",
 "statement": "Let $k$ be an algebraically closed field and $C$ a\nsmooth projective curve over\n$k$ (or, more generally, a proper smooth connected curve in the sense of\n[def-sc-curves] with $\\dim H^0(C,\\mathcal{O}_C)=1$). Then the genus\n$g(C)$ of [def-pc-genus] equals the genus of\n[def-sc-genus].",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-prop-picard-pic-split/lem-pc-genus-agrees-sc.md",
  "place": "node lem-pc-genus-agrees-sc, order 811",
  "external": [
   {
    "document": "Stacks Project",
    "place": "Tag 0BY7"
   }
  ]
 },
 "stmt_deps": [
  "def-sc-curves",
  "def-pc-genus",
  "def-sc-genus",
  "def-pc-smooth-projective-curve"
 ],
 "proof": [
  {
   "text": "Both definitions are $g=\\dim_kH^1(C,\\mathcal{O}_C)$ (Definition 44.6.3 in the\nfirst case, specific to the geometric irreducible smooth projective\ncurve; Definition 53.8.1 (Tag\n[0BY7](https://stacks.math.columbia.edu/tag/0BY7)) in the second),\nso they agree.",
   "uses": [],
   "elementary": null
  }
 ],
