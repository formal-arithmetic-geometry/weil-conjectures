 },
 "kind": "statement",
 "title": "Coherent cohomology of a projective scheme over a Noetherian ring",
 "statement": "Let $A$ be Noetherian, let $f:X\\to\\operatorname{Spec}(A)$ be\nprojective, and let\n$\\mathcal F$ be a coherent module.\nThen $H^q(X,\\mathcal F)$ is a finite $A$-module for every $q$.\nFor an embedding $X\\hookrightarrow\\mathbf P^n_A$, these groups\nvanish for $q>n$.",
 "source": {
  "document": "literature/blueprint/master/blueprint/sec-picard-framework/sk-thm-picard-coherence/lem-pc-projective-coherent-finiteness.md",
  "place": "node lem-pc-projective-coherent-finiteness, order 656"
 },
 "stmt_deps": [
  "def-pc-projective-space-twist",
  "pqf-def-coherent",
  "pqf-def-cohomology"
 ],
 "proof": [
  {
   "text": "Take a closed immersion $i:X\\hookrightarrow\\mathbf P^n_A$ from\n[def-pc-projective-morphism]. Its affine charts are finite\ntype over the Noetherian ring $A$, so $X$ is locally Noetherian.\nBy [lem-pc-closed-immersion-coherent-cohomology],\n$i_*\\mathcal F$ is coherent and has the same cohomology as\n$\\mathcal F$. Apply\n[lem-pc-projective-space-coherent-finiteness], [lem-pc-projective-space-cohomology-bound]\nto $i_*\\mathcal F$ on $\\mathbf P^n_A$.",
   "uses": [
    "def-pc-projective-morphism",
    "lem-pc-closed-immersion-coherent-cohomology",
    "lem-pc-projective-space-coherent-finiteness",
    "lem-pc-projective-space-cohomology-bound"
   ],
   "elementary": false
  }
 ],
