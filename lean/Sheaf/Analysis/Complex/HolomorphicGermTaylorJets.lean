module

public import Sheaf.Analysis.Complex.HolomorphicGerm
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Analysis.Calculus.FDeriv.Basic
public import Mathlib.LinearAlgebra.Finsupp.Pi
public import Mathlib.Data.List.FinRange

import Mathlib.Analysis.Calculus.FDeriv.Analytic
import Mathlib.Analysis.Analytic.Composition
import Mathlib.Analysis.Calculus.InverseFunctionTheorem.FDeriv

/-! # Finite Taylor jets of holomorphic germs

Source: Serre, GAGA, no.4, printed p.6, and no.6, Proposition 3, printed pp.9--10,
affine-space calculation. The finite-jet refinement is the DAG's agent-written argument.
(blueprint: lem-sfb-holomorphic-germ-taylor-jets)
-/

@[expose] public section

set_option autoImplicit false

namespace Complex

/-- The variables ideal in the multivariate polynomial algebra. Source: Serre,
GAGA, no.6, Proposition 3, affine-space calculation, printed p.10.
(blueprint: lem-sfb-holomorphic-germ-taylor-jets) -/
noncomputable def holomorphicJetPolynomialIdeal (d : ℕ) : Ideal (MvPolynomial (Fin d) ℂ) :=
  Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) ℂ))

/-- Iterate coordinate derivatives in increasing coordinate order, taking `α i`
derivatives in coordinate `i`. Source: the Taylor refinement of Serre, GAGA,
no.4 and no.6, Proposition 3, in the DAG proof, steps 4--5.
(blueprint: lem-sfb-holomorphic-germ-taylor-jets) -/
noncomputable def orderedCoordinateDerivative (d : ℕ) (α : Fin d → ℕ)
    (f : (Fin d → ℂ) → ℂ) : (Fin d → ℂ) → ℂ :=
  ((List.finRange d).flatMap fun i ↦ List.replicate (α i) i).foldl
    (fun h i ↦ fun x ↦ fderiv ℂ h x (Pi.single i 1)) f

/-- The Taylor polynomial of total degree strictly below `r`. Each multi-index
of total degree below `r` has all coordinates below `r`, so the displayed bounded
sum lists exactly the required monomials, including the sole empty multi-index
when `d = 0` and `r ≥ 1`. Source: the Taylor refinement of Serre, GAGA,
no.4 and no.6, Proposition 3, in the DAG proof, steps 3--6.
(blueprint: lem-sfb-holomorphic-germ-taylor-jets) -/
noncomputable def holomorphicTaylorPolynomial (d r : ℕ) (f : (Fin d → ℂ) → ℂ) :
    MvPolynomial (Fin d) ℂ :=
  ∑ α : Fin d → Fin r,
    if (∑ i, (α i).val) < r then
      MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm (fun i ↦ (α i).val))
        (orderedCoordinateDerivative d (fun i ↦ (α i).val) f 0 /
          ∏ i, (Nat.factorial (α i).val : ℂ))
    else 0

/-- The vanishing ideal is generated by coordinate germs. Polynomial evaluation
induces compatible isomorphisms on all positive ideal-power quotients, with the
inverse given by the Taylor polynomial. In dimension zero the evaluation maps
identify both algebras with `ℂ`, and both ideals vanish.

Source: Serre, GAGA, no.4, printed p.6; no.6, Proposition 3, printed pp.9--10,
affine-space calculation; the finite-jet refinement is the accepted DAG proof.
(blueprint: lem-sfb-holomorphic-germ-taylor-jets)

Proof plan:
1. For `d = 0` germs are their values and polynomials are constants, so both
   ideals vanish and every jet map is the identity under these identifications.
2. Apply lem-sfb-holomorphic-coordinate-division with no parameter variables:
   `g - g(0) = ∑ i, z_i h_i`. This identifies the vanishing ideal with `(z_i)`.
3. Iterate this division on each remainder to write `g = p_r(z) + ∑ w, z_w h_w`,
   where `w` has length `r` and `p_r` has total degree less than `r`.
4. The strict derivatives of lem-sfb-complex-analytic-inverse-toolkit are ordinary
   derivatives; lem-sfb-complex-analytic-derivative-rules and analytic function
   operations make repeated coordinate derivatives analytic and representative
   independent. Their sum and product rules give the coordinate Kronecker formula.
5. A derivative of total order less than `r` annihilates every `z_w h_w` at zero.
   Differentiating monomials identifies the coefficient of `T^α` in `p_r` with
   `∂^α g(0)/α!`; factorials are nonzero over `ℂ`.
6. Expanding finite monomials shows that membership in `J^r` is exactly vanishing
   of coefficients of degrees below `r`: a monomial of degree at least `r` is
   divisible by a product of `r` variables. Thus low-degree representatives are unique.
7. The polynomial universal property gives evaluation. The coordinate ideal
   equality makes the quotient map well-defined; step 3 proves surjectivity and
   steps 5--6 prove injectivity. The Taylor formula is its inverse and is unchanged
   on changing either the analytic or the ideal-power quotient representative.
8. Both reduction composites send the class of any polynomial `p` to the class
   of `p(z)`, proving compatibility from exponent `r+1` to exponent `r`. -/
theorem holomorphic_germ_taylor_jets (d : ℕ) :
    holomorphicGermVanishingIdeal d =
      Ideal.span (Set.range (holomorphicGermCoordinate d)) ∧
    (∃ e : (r : ℕ) → 1 ≤ r →
        (MvPolynomial (Fin d) ℂ ⧸ holomorphicJetPolynomialIdeal d ^ r) ≃ₐ[ℂ]
          (HolomorphicGerm d ⧸ holomorphicGermVanishingIdeal d ^ r),
      (∀ (r : ℕ) (hr : 1 ≤ r) (p : MvPolynomial (Fin d) ℂ),
        e r hr (Ideal.Quotient.mk _ p) =
          Ideal.Quotient.mk _ (MvPolynomial.aeval (holomorphicGermCoordinate d) p)) ∧
      (∀ (r : ℕ) (hr : 1 ≤ r) (f : analyticAtZeroSubalgebra d),
        (e r hr).symm (Ideal.Quotient.mk _ (holomorphicGermMk d f)) =
          Ideal.Quotient.mk _ (holomorphicTaylorPolynomial d r f)) ∧
      (∀ (r : ℕ) (hr : 1 ≤ r)
          (x : MvPolynomial (Fin d) ℂ ⧸ holomorphicJetPolynomialIdeal d ^ (r + 1)),
        Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ r))
            (e (r + 1) (Nat.le_trans hr (Nat.le_succ r)) x) =
          e r hr (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ r)) x))) ∧
    (d = 0 →
      (∃ eg : HolomorphicGerm d ≃ₐ[ℂ] ℂ,
        ∀ f : analyticAtZeroSubalgebra d, eg (holomorphicGermMk d f) = f.val 0) ∧
      (∃ ep : MvPolynomial (Fin d) ℂ ≃ₐ[ℂ] ℂ,
        ∀ p : MvPolynomial (Fin d) ℂ, ep p = MvPolynomial.constantCoeff p) ∧
      holomorphicGermVanishingIdeal d = ⊥ ∧ holomorphicJetPolynomialIdeal d = ⊥) := by
  sorry

end Complex
