/-! # Approximation data with the base colimit
Source: Stacks Tag 00R0, expanded from the non-local version of Tag 00QV.
(blueprint: lem-weil-pbc-limit-finite-presentation-core)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace Algebra

/-- The finite-type models, their pushout squares, and the base colimit.
Source: Stacks Tag 00R0, expanded from the non-local version of Tag 00QV.
Proof: choose a finite polynomial quotient presentation of `S` over `R`. Let `C`
be the integer subalgebra generated by all coefficients of its finitely many
relations. Index by the finitely generated integer subalgebras `T` of `R`
containing `C`. This is a small nonempty directed preorder: it contains `C`,
and adjoining the union of two finite sets of generators gives an upper bound.
Every element `r` of `R` belongs to the subalgebra generated by `C` and `r`.
Thus compatible maps from all these subalgebras define a unique map on `R`:
choose a subalgebra containing an element to define its image; common upper
bounds prove independence and the ring laws. This proves the base colimit.
Define `S_T` as the polynomial quotient over `T` by the same relations.
Inclusions induce maps of quotients; these fix variable classes, hence preserve
identities, composition, and compatibility with the presentation map to `S`.
The variable classes generate `S_T` over `T`; each `T` is finite type over ℤ.
For `T ≤ U`, polynomial scalar extension and the quotient universal property
identify `S_T ⊗[T] U` with `S_U`: maps in both directions fix coefficients and
variable classes, hence are inverse. The tensor-product universal property
makes the transition square a pushout. Taking `U = R` and composing with the
chosen presentation gives the final pushout square at every index. The same
argument permits zero variables, zero relations, and the zero ring.
(blueprint: lem-weil-pbc-limit-finite-presentation-core)
-/
theorem exists_limit_finite_presentation_core
    {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : RingHom.FinitePresentation φ) :
    ∃ (Λ : Type u) (_hpo : Preorder Λ) (_hne : Nonempty Λ)
      (_hdir : IsDirected Λ (fun a b => a ≤ b))
      (Rfun : Λ ⥤ CommRingCat) (Sfun : Λ ⥤ CommRingCat)
      (η : Rfun ⟶ Sfun) (cR : Cocone Rfun) (cS : Cocone Sfun),
      cR.pt = CommRingCat.of R ∧ cS.pt = CommRingCat.of S ∧
      (∀ l (hR : cR.pt = CommRingCat.of R) (hS : cS.pt = CommRingCat.of S),
        η.app l ≫ cS.ι.app l = cR.ι.app l ≫
          (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm)) ∧
      (∀ l, RingHom.FiniteType (η.app l).hom) ∧
      (∀ l, RingHom.FiniteType (algebraMap ℤ (Rfun.obj l))) ∧
      (∀ l m (h : l ≤ m),
        Nonempty (CategoryTheory.IsPushout (η.app l) (Rfun.map (homOfLE h))
          (Sfun.map (homOfLE h)) (η.app m))) ∧
      (∀ l (hR : cR.pt = CommRingCat.of R) (hS : cS.pt = CommRingCat.of S),
        Nonempty (CategoryTheory.IsPushout (η.app l) (cR.ι.app l) (cS.ι.app l)
          (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm))) ∧
      Nonempty (IsColimit cR)
:= by
  classical
  obtain ⟨j, T, g, hg, k, hp⟩ :=
    CommRingCat.exists_isPushout_of_finitePresentation
      (CommRingCat.fgSubalgebraDiagram R) (CommRingCat.fgSubalgebraCocone R)
      (CommRingCat.isColimitFgSubalgebraCocone R) (CommRingCat.ofHom φ) hφ
  let P : Subalgebra ℤ R → Prop := fun A ↦ A.FG ∧ j.1 ≤ A
  let Λ := {A : Subalgebra ℤ R // P A}
  let : Nonempty Λ := ⟨⟨j.1, j.2, le_rfl⟩⟩
  let : IsDirectedOrder Λ := ⟨fun A B ↦
    ⟨⟨A.1 ⊔ B.1, A.2.1.sup B.2.1, A.2.2.trans le_sup_left⟩,
      Subtype.coe_le_coe.mp le_sup_left, Subtype.coe_le_coe.mp le_sup_right⟩⟩
  have hsup : ⨆ A : Λ, A.1 = ⊤ := by
    apply top_unique
    intro x _
    let A : Λ := ⟨j.1 ⊔ (Subalgebra.fgAdjoinSingleton ℤ R x).1,
      j.2.sup (Subalgebra.fgAdjoinSingleton ℤ R x).2, le_sup_left⟩
    exact le_iSup (fun A : Λ ↦ A.1) A
      ((show (Subalgebra.fgAdjoinSingleton ℤ R x).1 ≤ A.1 from le_sup_right)
        (Subalgebra.self_mem_fgAdjoinSingleton ℤ R x))
  let F := CommRingCat.subalgebraDiagram R P
  let c := CommRingCat.subalgebraCocone R P
  let a (l : Λ) : CommRingCat.of j.1 ⟶ F.obj l :=
    CommRingCat.ofHom (Subalgebra.inclusion l.2.2).toRingHom
  have ha {l m : Λ} (f : l ⟶ m) : a l ≫ F.map f = a m := by
    ext x
    rfl
  have hac (l : Λ) : a l ≫ c.ι.app l =
      (CommRingCat.fgSubalgebraCocone R).ι.app j := by
    ext x
    rfl
  let G : Λ ⥤ CommRingCat :=
    { obj := fun l ↦ pushout (a l) g
      map := fun {l m} f ↦ pushout.desc
        (F.map f ≫ pushout.inl (a m) g) (pushout.inr (a m) g) (by
          rw [← Category.assoc, ha, pushout.condition])
      map_id := by
        intro l
        apply pushout.hom_ext <;> simp
      map_comp := by
        intro l m n f h
        apply pushout.hom_ext <;> simp [Category.assoc] }
  let η : F ⟶ G :=
    { app := fun l ↦ pushout.inl (a l) g
      naturality := by
        intro l m f
        simp [G] }
  let d : Cocone G :=
    { pt := CommRingCat.of S
      ι :=
        { app := fun l ↦ pushout.desc (c.ι.app l ≫ CommRingCat.ofHom φ) k (by
            rw [← Category.assoc, hac, hp.w])
          naturality := by
            intro l m f
            apply pushout.hom_ext <;> simp [G, Category.assoc] } }
  refine ⟨Λ, inferInstance, inferInstance, inferInstance, F, G, η, c, d,
    rfl, rfl, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro l hR hS
    simp [η, d, c]
  · intro l
    exact RingHom.finiteType_isStableUnderBaseChange.pushout_inl
      RingHom.finiteType_respectsIso (a l) g (RingHom.FiniteType.of_finitePresentation hg)
  · intro l
    exact RingHom.finiteType_algebraMap.mpr ((l.1.fg_iff_finiteType).mp l.2.1)
  · intro l m h
    have hm := CategoryTheory.IsPushout.of_hasPushout (a m) g
    have hl := CategoryTheory.IsPushout.of_hasPushout (a l) g
    have hw : η.app l ≫ G.map (homOfLE h) = F.map (homOfLE h) ≫ η.app m := by
      simp [η, G]
    refine ⟨?_⟩
    apply IsPushout.flip
    apply IsPushout.of_left (t := hl) (p := hw.symm)
    simpa [G, η, ha] using hm
  · intro l hR hS
    have hp' : CategoryTheory.IsPushout g (a l ≫ c.ι.app l) k (CommRingCat.ofHom φ) := by
      rw [hac]
      exact hp.flip
    refine ⟨?_⟩
    have hw : η.app l ≫ d.ι.app l = c.ι.app l ≫ CommRingCat.ofHom φ := by
      simp [η, d]
    have hfinal : CategoryTheory.IsPushout (η.app l) (c.ι.app l) (d.ι.app l)
        (CommRingCat.ofHom φ) := by
      apply IsPushout.of_top (t := (IsPushout.of_hasPushout (a l) g).flip) (p := hw)
      simpa [d] using hp'
    simpa [c, d] using hfinal
  · exact ⟨CommRingCat.isColimitSubalgebraCocone R P hsup⟩

end Algebra
