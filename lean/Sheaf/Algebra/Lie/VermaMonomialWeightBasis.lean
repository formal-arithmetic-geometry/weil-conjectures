module

public import Sheaf.Algebra.Lie.SplitSemisimpleRootDecomposition
public import Mathlib.Algebra.Lie.UniversalEnveloping
public import Mathlib.Algebra.Algebra.Tower
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.Data.List.FinRange

/-!
# The explicit rational Verma quotient

Source: Milne, Algebraic Groups (2017), Section 23h, printed pp.508–511;
Serre, Complex Semisimple Lie Algebras, Chapter VII (background source WANTED).
(blueprint: lem-sfb-verma-monomial-weight-basis).
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

namespace LieAlgebra

variable {g : Type u} [LieRing g] [LieAlgebra ℚ g]

/-- The left ideal generated by positive root spaces and the Cartan character relations.
Source: explicit rational quotient in Milne §23h's highest-weight background;
Serre, Chapter VII (blueprint: lem-sfb-verma-monomial-weight-basis). -/
def vermaIdeal (H : LieSubalgebra ℚ g) (P : Set (Module.Dual ℚ H))
    (η : Module.Dual ℚ H) :
    Submodule (UniversalEnvelopingAlgebra ℚ g) (UniversalEnvelopingAlgebra ℚ g) :=
  Submodule.span (UniversalEnvelopingAlgebra ℚ g)
    ((UniversalEnvelopingAlgebra.ι ℚ) ''
        (↑(⨆ (α : P), (LieModule.weightSpace g (α.1 : H → ℚ)).toSubmodule) : Set g) ∪
      Set.range (fun h : H ↦ UniversalEnvelopingAlgebra.ι ℚ (h : g) -
        algebraMap ℚ (UniversalEnvelopingAlgebra ℚ g) (η h)))

/-- The actual left-ideal quotient, with its inherited rational and enveloping-algebra actions.
Source: Serre, Chapter VII, rational model (blueprint: lem-sfb-verma-monomial-weight-basis). -/
abbrev VermaModule (H : LieSubalgebra ℚ g) (P : Set (Module.Dual ℚ H))
    (η : Module.Dual ℚ H) :=
  UniversalEnvelopingAlgebra ℚ g ⧸ vermaIdeal H P η

/-- The class of one in the explicit Verma quotient.
Source: Serre, Chapter VII (blueprint: lem-sfb-verma-monomial-weight-basis). -/
def vermaHighestVector (H : LieSubalgebra ℚ g) (P : Set (Module.Dual ℚ H))
    (η : Module.Dual ℚ H) : VermaModule H P η :=
  Submodule.Quotient.mk 1

/-- Left multiplication restricted along the canonical Lie map into the enveloping algebra.
Source: Serre, Chapter VII (blueprint: lem-sfb-verma-monomial-weight-basis). -/
def vermaRepresentation (H : LieSubalgebra ℚ g) (P : Set (Module.Dual ℚ H))
    (η : Module.Dual ℚ H) :
    @LieHom ℚ g (Module.End ℚ (VermaModule H P η)) _ _ _
      LieRing.ofAssociativeRing LieAlgebra.ofAssociativeAlgebra := by
  letI : LieRing (UniversalEnvelopingAlgebra ℚ g) := LieRing.ofAssociativeRing
  letI : LieRing (Module.End ℚ (VermaModule H P η)) := LieRing.ofAssociativeRing
  exact (Algebra.lsmul ℚ ℚ (VermaModule H P η)).toLieHom.comp
    (UniversalEnvelopingAlgebra.ι ℚ)

/-- The Lie-ring action underlying the canonical Verma representation.
Source: Serre, Chapter VII (blueprint: lem-sfb-verma-monomial-weight-basis). -/
instance vermaLieRingModule (H : LieSubalgebra ℚ g) (P : Set (Module.Dual ℚ H))
    (η : Module.Dual ℚ H) : LieRingModule g (VermaModule H P η) :=
  letI : LieRing (Module.End ℚ (VermaModule H P η)) := LieRing.ofAssociativeRing
  LieRingModule.compLieHom (VermaModule H P η) (vermaRepresentation H P η)

/-- Linearity of the canonical Verma Lie action, inherited from its endomorphism representation.
Source: Serre, Chapter VII (blueprint: lem-sfb-verma-monomial-weight-basis). -/
instance vermaLieModule (H : LieSubalgebra ℚ g) (P : Set (Module.Dual ℚ H))
    (η : Module.Dual ℚ H) : LieModule ℚ g (VermaModule H P η) :=
  letI : LieRing (Module.End ℚ (VermaModule H P η)) := LieRing.ofAssociativeRing
  LieModule.compLieHom (VermaModule H P η) (vermaRepresentation H P η)

open Classical in
/-- Ordered negative-root monomials form an ordinary weight basis of the explicit Verma
quotient, with a nonzero cyclic highest vector, a one-dimensional highest weight space,
and finite-dimensional weight spaces.

Source: Milne, Algebraic Groups (2017), §23h, printed pp.508–511, weight representations;
Serre, Complex Semisimple Lie Algebras, Chapter VII (background source WANTED).
(blueprint: lem-sfb-verma-monomial-weight-basis).

Proof plan:
1. `lem-sfb-split-semisimple-root-decomposition` gives the ordered basis (y,t,x) and
   the Borel subalgebra H + n+. The map h+x ↦ η(h) kills brackets. By
   `lem-sfb-enveloping-universal-property` it extends to a character χ of U(H+n+).
2. Apply `lem-sfb-rational-pbw` to the Borel and to g. Its inclusion extends to an
   injective enveloping-algebra map, since its PBW monomials are a subfamily of those
   of g. Grouping PBW terms gives U(g) = direct sum over a of y^a U(H+n+), as right
   modules. This works for every ordering and every nonzero choice of root vectors.
3. The kernel K of χ is generated as a left ideal by z-χ(z). For a word, telescope
   word-χ(word) into the sum of prefix times (z-χ(z)) times the remaining scalar
   characters. Writing z=h+x identifies these generators with x and h-η(h).
4. Thus Iη = U(g)K = direct sum of y^a K. Taking character values of the right Borel
   coefficients has exactly this kernel and maps onto the free rational vector space
   on the exponent tuples. The quotient monomials are a basis and the empty monomial
   is nonzero.
5. Left multiplication descends through a left ideal. The defining enveloping relation
   gives the Lie representation. The ideal generators give the highest weight and n+
   annihilation equations. Every class is u times the highest vector; U is generated
   by g, so the Lie submodule generated by that vector is the whole quotient.
6. The root-space equations give [h,y_j]=-β_j(h)y_j. The commutator derivation rule
   and induction on powers give the ordinary eigenweight η-sum a_j β_j.
7. Expand an arbitrary simultaneous eigenvector in this basis. Coefficient comparison
   for every h forces each nonzero coefficient to have exactly the given weight.
8. Each positive root has nonnegative simple coordinates with positive total height.
   Hence every weight is in η minus the positive simple monoid. Total height zero
   forces all exponents zero, giving the highest line. At any fixed weight, total
   height bounds each exponent, giving finitely many tuples and finite dimension.
   For the empty root set, the exponent type has just its empty tuple and the basis
   consists of the class of one. -/
theorem exists_verma_monomial_weight_basis
    [FiniteDimensional ℚ g] [HasTrivialRadical ℚ g]
    (H : LieSubalgebra ℚ g) [IsLieAbelian H]
    (hmax : ∀ A : LieSubalgebra ℚ g, H ≤ A → IsLieAbelian A → A = H)
    (hsplit : ∀ h : H, (⨆ q : ℚ, (ad ℚ g (h : g)).eigenspace q) = ⊤)
    (R : Set (Module.Dual ℚ H))
    (hR : ∀ α : Module.Dual ℚ H, α ∈ R ↔
      α ≠ 0 ∧ LieModule.weightSpace g (α : H → ℚ) ≠ ⊥)
    (Δ : Finset R) (b : Module.Basis Δ ℚ (Module.Dual ℚ H))
    (hb : ∀ i : Δ, b i = i.1.1)
    (hsign : ∀ α : R,
      α.1 ∈ AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1)) ∨
      -α.1 ∈ AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1)))
    (P : Set (Module.Dual ℚ H))
    (hP : P = R ∩ AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1)))
    (η : Module.Dual ℚ H) (N : ℕ) (β : Fin N ≃ P) (y : Fin N → g)
    (hy : ∀ j : Fin N,
      y j ∈ LieModule.weightSpace g ((-(β j).1) : H → ℚ) ∧ y j ≠ 0) :
    (∀ (x : g) (m : VermaModule H P η),
      ⁅x, m⁆ = UniversalEnvelopingAlgebra.ι ℚ x • m) ∧
    vermaHighestVector H P η ≠ 0 ∧
    (∀ h : H, ⁅h, vermaHighestVector H P η⁆ = η h • vermaHighestVector H P η) ∧
    (∀ x : g,
      x ∈ (⨆ α : P, (LieModule.weightSpace g (α.1 : H → ℚ)).toSubmodule) →
        ⁅x, vermaHighestVector H P η⁆ = 0) ∧
    (LieSubmodule.lieSpan ℚ g {vermaHighestVector H P η} = ⊤) ∧
    (∀ μ : Module.Dual ℚ H,
      LieModule.weightSpace (VermaModule H P η) (μ : H → ℚ) ≠ ⊥ →
        η - μ ∈ AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1))) ∧
    (LieModule.weightSpace (VermaModule H P η) (η : H → ℚ)).toSubmodule =
      Submodule.span ℚ {vermaHighestVector H P η} ∧
    (∀ μ : Module.Dual ℚ H,
      FiniteDimensional ℚ (LieModule.weightSpace (VermaModule H P η) (μ : H → ℚ))) ∧
    ∃ B : Module.Basis (Fin N → ℕ) ℚ (VermaModule H P η),
      (∀ a : Fin N → ℕ,
        B a = ((List.finRange N).map
          (fun j ↦ UniversalEnvelopingAlgebra.ι ℚ (y j) ^ a j)).prod •
            vermaHighestVector H P η) ∧
      (∀ a : Fin N → ℕ,
        B a ∈ LieModule.weightSpace (VermaModule H P η)
          ((η - ∑ j : Fin N, a j • (β j).1) : H → ℚ)) ∧
      (P = ∅ → ∀ a : Fin N → ℕ, B a = vermaHighestVector H P η) := by
  sorry

end LieAlgebra
