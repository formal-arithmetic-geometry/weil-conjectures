module

public import Mathlib.Algebra.Lie.Semisimple.Basic
public import Mathlib.Algebra.Lie.Weights.Basic
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.LinearAlgebra.RootSystem.Reduced
public import Mathlib.LinearAlgebra.RootSystem.WeylGroup
import Mathlib.Algebra.Lie.Weights.RootSystem
import Mathlib.LinearAlgebra.RootSystem.BaseExists

/-!
# Split semisimple root decomposition and simple-root generators

Source: Milne, Algebraic Groups (2017), Section 23h, printed pp.503 and 508–509;
Serre, Complex Semisimple Lie Algebras, Chapters V–VI, split rational-field form
(blueprint: lem-sfb-split-semisimple-root-decomposition).

Ordinary simultaneous eigenspaces are `LieModule.weightSpace`. The root set is specified by
its defining equivalence, and the root pairing uses evaluation on the given abelian subalgebra.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

namespace LieAlgebra

open Classical in
/-- A maximal abelian subalgebra with rationally diagonalizable adjoint operators gives
an internal root decomposition, a finite reduced crystallographic evaluation root pairing,
and positive and negative subalgebras generated by any prescribed simple-root vectors.

Source: Milne, Algebraic Groups (2017), Section 23h, printed pp.503 and 508–509;
Serre, Complex Semisimple Lie Algebras, Chapters V–VI, split rational-field form
(blueprint: lem-sfb-split-semisimple-root-decomposition).

Proof plan:
1. By `sk-lem-walg-killing` the Killing form is nondegenerate. If an element normalizes
   `H`, each adjoint operator from `H` squares to zero on it. Diagonalizability implies
   that each operator already kills it. Maximal abelianness identifies the centralizer
   with `H`, so `H` is a nilpotent self-normalizing Cartan subalgebra.
2. Apply `lem-sfb-nilpotent-module-generalized-weight-decomposition`. In a diagonal basis,
   generalized eigenspaces equal eigenspaces. Nonzero simultaneous eigenvectors force
   their weights to be linear. The zero space is the centralizer `H`. This gives the
   finite internal decomposition, including the zero algebra.
3. By `lem-sfb-killing-cartan-rank-one-spaces`, each nonzero root space is a line and
   has a rank-one triple. Its bracket line has a unique element evaluating to two.
   `lem-sfb-killing-cartan-reduced-root-pairing` supplies spanning roots and coroots,
   integral pairings, reducedness and simultaneous reflection permutations.
4. The group generated by reflections acts faithfully on the finite root set, since
   the roots span the dual. Hence the group is finite, also for the empty root set.
5. Rescale each rank-one triple to the prescribed positive root vector. Jacobi puts a
   bracket of weights alpha and beta in weight alpha + beta. Distinct simple roots have
   mixed-sign difference, which is not a root; hence the mixed simple brackets vanish.
   The same identity makes the sums of positive and negative root spaces subalgebras.
6. `lem-sfb-root-base-rational-integral-spans` extends the given rational simple base
   to a root-pairing base. `lem-sfb-positive-root-word-partial-sums` expresses each
   positive root as a word in simple roots whose nonempty partial sums are roots.
7. Successive brackets along that word are nonzero by
   `lem-sfb-nonopposite-root-bracket-nonvanishing`. The last bracket spans the required
   one-dimensional root space. This proves positive generation. Negative words prove
   negative generation; empty families generate zero.
8. Iterated adjoint action of a vector of weight alpha carries weight beta to
   beta + N alpha. Since alpha is nonzero and the weights form a finite set, choose a
   positive N for which none of these target weights occurs. The decomposition then
   makes the N-th power zero on the whole algebra. -/
theorem exists_splitSemisimple_rootDecomposition
    (g : Type u) [LieRing g] [LieAlgebra ℚ g] [FiniteDimensional ℚ g]
    [HasTrivialRadical ℚ g] (H : LieSubalgebra ℚ g) [IsLieAbelian H]
    (hmax : ∀ A : LieSubalgebra ℚ g, H ≤ A → IsLieAbelian A → A = H)
    (hsplit : ∀ h : H, (⨆ a : ℚ, (ad ℚ g (h : g)).eigenspace a) = ⊤)
    (R : Set (Module.Dual ℚ H))
    (hR : ∀ α : Module.Dual ℚ H, α ∈ R ↔
      α ≠ 0 ∧ LieModule.weightSpace g (α : H → ℚ) ≠ ⊥) :
    R.Finite ∧
    DirectSum.IsInternal
      (Sum.elim (fun _ : Unit ↦ H.toSubmodule)
        (fun α : R ↦ (LieModule.weightSpace g (α.1 : H → ℚ)).toSubmodule)) ∧
    (∀ α : R, Module.finrank ℚ (LieModule.weightSpace g (α.1 : H → ℚ)) = 1) ∧
    (∀ (α : R) (x : g), x ∈ LieModule.weightSpace g (α.1 : H → ℚ) →
      x ≠ 0 → IsNilpotent (ad ℚ g x)) ∧
    (Subsingleton g → R = ∅) ∧
    ∃ P : RootPairing R ℚ (Module.Dual ℚ H) H,
      (∀ α : R, P.root α = α.1) ∧
      (∀ (ξ : Module.Dual ℚ H) (h : H), P.toLinearMap ξ h = ξ h) ∧
      P.IsRootSystem ∧ P.IsCrystallographic ∧ P.IsReduced ∧
      Finite (Subgroup.closure (Set.range P.reflection)) ∧
      (∀ α : R,
        Submodule.span ℚ {z : g | ∃ x y : g,
          x ∈ LieModule.weightSpace g (α.1 : H → ℚ) ∧
          y ∈ LieModule.weightSpace g ((-α.1) : H → ℚ) ∧ ⁅x, y⁆ = z} =
            Submodule.span ℚ {(P.coroot α : g)} ∧
        ∃! h : H, (h : g) ∈ Submodule.span ℚ {(P.coroot α : g)} ∧ α.1 h = 2) ∧
      ∀ (Δ : Finset R) (b : Module.Basis Δ ℚ (Module.Dual ℚ H)),
        (∀ i : Δ, b i = i.1.1) →
        (∀ α : R,
          α.1 ∈ AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1)) ∨
          -α.1 ∈ AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1))) →
        ∀ e : Δ → g,
          (∀ i : Δ, e i ∈ LieModule.weightSpace g (i.1.1 : H → ℚ) ∧ e i ≠ 0) →
          ∃ f : Δ → g,
            (∀ i : Δ,
              f i ∈ LieModule.weightSpace g ((-i.1.1) : H → ℚ) ∧
              ⁅e i, f i⁆ = (P.coroot i.1 : g) ∧
              ⁅(P.coroot i.1 : g), e i⁆ = (2 : ℚ) • e i ∧
              ⁅(P.coroot i.1 : g), f i⁆ = (-2 : ℚ) • f i) ∧
            (∀ i j : Δ, i ≠ j → ⁅e i, f j⁆ = 0) ∧
            (LieSubalgebra.lieSpan ℚ g (Set.range e)).toSubmodule =
              ⨆ (α : R) (_ : α.1 ∈
                AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1))),
                  (LieModule.weightSpace g (α.1 : H → ℚ)).toSubmodule ∧
            (LieSubalgebra.lieSpan ℚ g (Set.range f)).toSubmodule =
              ⨆ (α : R) (_ : α.1 ∈
                AddSubmonoid.closure (Set.range (fun i : Δ ↦ i.1.1))),
                  (LieModule.weightSpace g ((-α.1) : H → ℚ)).toSubmodule := by
  sorry

end LieAlgebra
