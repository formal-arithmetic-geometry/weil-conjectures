module

public import Sheaf.LinearAlgebra.RootDatumLatticeEmbedding
public import Mathlib.Algebra.Lie.Semisimple.Basic
public import Mathlib.Algebra.Lie.Weights.Basic
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.Module.Lattice
import Sheaf.Algebra.Lie.RationalSerrePresentation
import Sheaf.Algebra.Lie.ChevalleyRootNormalization
import Sheaf.Algebra.Lie.RationalHighestWeightModules
import Sheaf.Algebra.Lie.KostantIntegralPBW
import Mathlib.LinearAlgebra.FreeModule.PID

/-!
# A rational Chevalley algebra with a full-weight admissible representation

Source: Milne, Algebraic Groups (2017), Section 23h, Theorems 23.63 and 23.71,
printed pp.503--509; admissible lattices and equation (152), p.510; Corollary 23.73, p.511
(blueprint: lem-sfb-chevalley-admissible-representation).

The rational root-system axioms and integral-weight condition are those in
`RootDatumLattice.lattice_embedding`, stated on an arbitrary rational vector space.
No integral root datum is required as input. The identification `θ : H ≃ₗ[ℚ] Vᵛ`
dualizes, using finite-dimensional evaluation, to the asserted `Hᵛ ≃ₗ[ℚ] V`.
The lattice intersections are submodules of the lattice itself, so their internal
direct sum asserts precisely the integral weight decomposition.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

namespace LieAlgebra

open Classical in
/-- A reduced rational root system has Chevalley data and a faithful representation with
weights generating its whole weight lattice and a weight-decomposed admissible lattice.

Source: Milne, Algebraic Groups (2017), Section 23h, Theorem 23.63 and its rational extension,
pp.503--508; Theorem 23.71, pp.508--509; admissibility and (152), p.510; Corollary 23.73, p.511
(blueprint: lem-sfb-chevalley-admissible-representation).

Proof plan:
1. For empty roots spanning forces V = 0. Take g = H = 0, W = ℚ, the integer lattice,
   and the singleton zero weight. Faithfulness of the zero action and all decompositions
   are immediate, and there are no divided-power conditions indexed by roots.
2. Otherwise apply `lem-sfb-serre-rational-presentation` to choose a simple base and its
   rational Serre quotient. Its Cartan identification sends each H_i to the given coroot.
   Apply `lem-sfb-chevalley-root-normalization` to the simple generators. The root vectors
   and simple coroots give the required basis, direct sum, and bracket constants.
3. Apply `lem-sfb-rational-highest-weight-modules` to each fundamental weight. Their direct
   sum W has finitely many integral weights Ω containing every fundamental weight, so
   their integer span is exactly P.
4. The kernel of the action is an ideal. Choose a rational Cartan element separating all
   root weights and zero, by avoiding finitely many roots of difference polynomials.
   Lagrange interpolation in its adjoint operator splits the kernel into weight spaces.
   A Cartan element in the kernel annihilates all fundamental highest vectors and hence
   is zero. A nonzero root component would contain e_a, and its bracket with e_(-a)
   would give a nonzero coroot in that Cartan intersection. Thus the action is faithful.
5. By `lem-sfb-kostant-integral-pbw`, the subgroup U_ℤ v_i is generated by the negative
   divided-power monomials on the highest vector: positive factors kill it, and Cartan
   binomials act by integers. Cyclicity shows its rational span is the whole module.
   Its construction makes every divided root power preserve it.
6. Such a nonzero monomial has weight ω_i minus its nonnegative sum of positive roots.
   Heights bound the sum of its exponents by the maximum of finitely many weight heights.
   There are finitely many such tuples. These generators are homogeneous, which gives
   the direct sum of the intersections with weight spaces.
7. Clear denominators of the finitely many generators in rational coordinates, embedding
   a multiple of this subgroup in a finite free integer group. Apply
   `lem-weil-subgroup-finite-free-abelian-group-free` to obtain finite freeness.
   Its integer basis becomes a rational basis by clearing denominators in relations.
   The direct sum of these lattices is full and has the required integral decomposition.
8. The representation identity shows that a root operator shifts weight μ to μ + a.
   Since a is nonzero and Ω finite, a uniform sufficiently long iterate is zero.
   Its m-th divided power is the corresponding enveloping divided-power action, already
   preserving the lattice, including m = 0 when the operator is the identity. -/
theorem exists_chevalley_admissible_representation
    (V : Type u) [AddCommGroup V] [Module ℚ V] [FiniteDimensional ℚ V]
    (R : Set V) (c : R → Module.Dual ℚ V)
    (hfinite : R.Finite) (hne : ∀ a : R, (a : V) ≠ 0)
    (hspan : Submodule.span ℚ R = ⊤)
    (htwo : ∀ a : R, c a a = 2)
    (hint : ∀ a b : R, ∃ n : ℤ, c a b = (n : ℚ))
    (hreflect : ∀ a : R, Set.BijOn (fun v : V ↦ v - c a v • (a : V)) R R)
    (hreduced : ∀ a : R,
      R ∩ (Submodule.span ℚ ({(a : V)} : Set V) : Set V) = {(a : V), -(a : V)})
    (P : Submodule ℤ V)
    (hP : ∀ v : V, v ∈ P ↔ ∀ a : R, ∃ n : ℤ, c a v = (n : ℚ)) :
    ∃ (g : Type u) (_ : LieRing g) (_ : LieAlgebra ℚ g)
      (_ : FiniteDimensional ℚ g),
      HasTrivialRadical ℚ g ∧
      ∃ H : LieSubalgebra ℚ g,
        IsLieAbelian H ∧
        (∀ K : LieSubalgebra ℚ g, H ≤ K → IsLieAbelian K → K = H) ∧
        ∃ (θ : H ≃ₗ[ℚ] Module.Dual ℚ V) (e : R → g),
          (∀ a : R, e a ≠ 0 ∧
            ∀ h : H, ⁅(h : g), e a⁆ = θ h a • e a) ∧
          DirectSum.IsInternal (Sum.elim (fun _ : Unit ↦ H.toSubmodule)
            (fun a : R ↦ Submodule.span ℚ ({e a} : Set g))) ∧
          (∃ (r : ℕ) (b : Module.Basis (Fin r) ℚ V) (hb : ∀ i, b i ∈ R),
            (∀ a : R, (∀ i, ∃ n : ℤ, b.repr a i = (n : ℚ)) ∧
              ((∀ i, 0 ≤ b.repr a i) ∨ (∀ i, b.repr a i ≤ 0))) ∧
            ∃ B : Module.Basis (Fin r ⊕ R) ℚ g,
              (∀ i, B (Sum.inl i) = (θ.symm (c ⟨b i, hb i⟩) : g)) ∧
              (∀ a : R, B (Sum.inr a) = e a)) ∧
          (∀ a b : R, (b : V) = -(a : V) →
            ⁅e a, e b⁆ = (θ.symm (c a) : g)) ∧
          (∀ a b k : R, (a : V) + (b : V) = (k : V) →
            ∃ p : ℕ, (b : V) - p • (a : V) ∈ R ∧
              (∀ n : ℕ, (b : V) - n • (a : V) ∈ R → n ≤ p) ∧
              ∃ ε : ℤ, (ε = 1 ∨ ε = -1) ∧
                ⁅e a, e b⁆ = ((ε : ℚ) * (p + 1 : ℚ)) • e k) ∧
          (∀ a b : R, (a : V) + (b : V) ≠ 0 → (a : V) + (b : V) ∉ R →
            ⁅e a, e b⁆ = 0) ∧
          ∃ (W : Type u) (_ : AddCommGroup W) (_ : Module ℚ W)
            (_ : LieRingModule g W) (_ : LieModule ℚ g W),
            FiniteDimensional ℚ W ∧ LieModule.IsFaithful ℚ g W ∧
            ∃ (Λ : Submodule ℤ W) (Ω : Finset V),
              Submodule.IsLattice ℚ Λ ∧ Module.Free ℤ Λ ∧
              (∀ μ ∈ Ω, μ ∈ P ∧ LieModule.weightSpace W (fun h : H ↦ θ h μ) ≠ ⊥) ∧
              DirectSum.IsInternal (fun μ : Ω ↦
                (LieModule.weightSpace W (fun h : H ↦ θ h μ)).toSubmodule) ∧
              Submodule.span ℤ (Ω : Set V) = P ∧
              DirectSum.IsInternal (fun μ : Ω ↦
                ((LieModule.weightSpace W (fun h : H ↦ θ h μ)).toSubmodule.restrictScalars
                  ℤ).comap Λ.subtype) ∧
              (∀ a : R, IsNilpotent (LieModule.toEnd ℚ g W (e a))) ∧
              (∀ (a : R) (m : ℕ) (w : W), w ∈ Λ →
                ((Nat.factorial m : ℚ)⁻¹ • (LieModule.toEnd ℚ g W (e a)) ^ m) w ∈ Λ) ∧
              (R = ∅ → Subsingleton g ∧
                ∃ ψ : W ≃ₗ[ℚ] ℚ,
                  Λ.map (ψ.toLinearMap.restrictScalars ℤ) =
                    LinearMap.range (Int.castAddHom ℚ).toIntLinearMap ∧ Ω = {0}) := by
  sorry

end LieAlgebra
