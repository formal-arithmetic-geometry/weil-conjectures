module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.CharP.Defs
public import Mathlib.Algebra.Field.Defs
public import Mathlib.LinearAlgebra.TensorAlgebra.Basic
public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import Mathlib.Order.Interval.Finset.Nat

/-!
# Restricted operations and their tensor enveloping quotient

Source: Milne, Algebraic Groups (2017), Definition 10.39, printed pp. 206–207
(blueprint: def-sfb-restricted-enveloping-algebra).

The Jacobson coefficients are computed by a finite recursion on coefficients of
`ad(tx+y)^m(x)`. The quotient is by the two-sided ideal of all bracket and p-relations.
-/

@[expose] public section

universe u v

set_option autoImplicit false

namespace LieAlgebra

/-- Coefficient `k` in `ad(tx+y)^m(x)`, computed in the scalar extension to `F[t]`.
The recursion uses that the coefficient of a bracket with `tx+y` is
`[x, q_(k-1)] + [y, q_k]`, with negative coefficients zero. Thus it works over
finite fields as well as infinite ones and uses formal coefficients, not evaluation.
Source: Milne, Definition 10.39 and Proposition 10.38(b), printed pp. 205–206
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def jacobsonAdjointCoefficients {L : Type v} [LieRing L] (x y : L) : ℕ → ℕ → L
  | 0, k => if k = 0 then x else 0
  | m + 1, 0 => ⁅y, jacobsonAdjointCoefficients x y m 0⁆
  | m + 1, k + 1 =>
      ⁅x, jacobsonAdjointCoefficients x y m k⁆ +
        ⁅y, jacobsonAdjointCoefficients x y m (k + 1)⁆

/-- The normalized Jacobson term `s_i(x,y)`. For `0 < i < p`, division by `i`
is valid in characteristic `p`, so `i s_i` is precisely the prescribed coefficient.
Source: Milne, Definition 10.39, printed p. 206
(blueprint: def-sfb-restricted-enveloping-algebra). -/
noncomputable def restrictedJacobsonTerm (F : Type u) [Field F] {L : Type v}
    [LieRing L] [LieAlgebra F L] (p : ℕ) (x y : L) (i : ℕ) : L :=
  (i : F)⁻¹ • jacobsonAdjointCoefficients x y (p - 1) (i - 1)

/-- The scalar, adjoint, and sum axioms of a restricted operation in characteristic `p`.
Source: Milne, Definition 10.39(a)–(c), printed p. 206
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def IsRestrictedOperation (F : Type u) [Field F] {L : Type v} [LieRing L]
    [LieAlgebra F L] (p : ℕ) (q : L → L) : Prop :=
  (∀ (c : F) (x : L), q (c • x) = c ^ p • q x) ∧
    (∀ x : L, ad F L (q x) = ad F L x ^ p) ∧
    (∀ x y : L, q (x + y) = q x + q y +
      ∑ i ∈ Finset.Ico 1 p, restrictedJacobsonTerm F p x y i)

/-- The tensor bracket relation `ι(x)ι(y)-ι(y)ι(x)-ι([x,y])`.
Source: Milne, Definition 10.39 via the tensor construction of `U(L)`, pp. 200, 206
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def tensorBracketRelation (F : Type u) [Field F] {L : Type v} [LieRing L]
    [LieAlgebra F L] (x y : L) : TensorAlgebra F L :=
  TensorAlgebra.ι F x * TensorAlgebra.ι F y -
    TensorAlgebra.ι F y * TensorAlgebra.ι F x - TensorAlgebra.ι F ⁅x, y⁆

/-- The tensor p-relation `ι(x)^p-ι(q(x))`.
Source: Milne, Definition 10.39, printed pp. 206–207
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def tensorRestrictedRelation (F : Type u) [Field F] {L : Type v} [LieRing L]
    [LieAlgebra F L] (p : ℕ) (q : L → L) (x : L) : TensorAlgebra F L :=
  TensorAlgebra.ι F x ^ p - TensorAlgebra.ι F (q x)

/-- The two-sided ideal generated by all bracket and p-relations in the tensor algebra.
Source: Milne, Definition 10.39, printed pp. 206–207
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def restrictedEnvelopingIdeal (F : Type u) [Field F] {L : Type v} [LieRing L]
    [LieAlgebra F L] (p : ℕ) (q : L → L) : TwoSidedIdeal (TensorAlgebra F L) :=
  TwoSidedIdeal.span
    ({z | ∃ x y : L, z = tensorBracketRelation F x y} ∪
      Set.range (tensorRestrictedRelation F p q))

end LieAlgebra

/-- The restricted enveloping algebra as the tensor quotient by all defining relations.
The construction makes sense for every function `q`; the restricted axioms are imposed
when its PBW theorem is stated. Ring and algebra structures are inherited from the quotient.
Source: Milne, Definition 10.39, printed pp. 206–207
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def RestrictedEnvelopingAlgebra (F : Type u) [Field F] (L : Type v) [LieRing L]
    [LieAlgebra F L] (p : ℕ) (q : L → L) :=
  (LieAlgebra.restrictedEnvelopingIdeal F p q).ringCon.Quotient
deriving Inhabited, Ring, Algebra F

namespace RestrictedEnvelopingAlgebra

/-- The degree-one map to the tensor quotient, giving the images of basis vectors.
Source: Milne, Definition 10.39, printed pp. 206–207
(blueprint: def-sfb-restricted-enveloping-algebra). -/
def ι (F : Type u) [Field F] {L : Type v} [LieRing L] [LieAlgebra F L]
    (p : ℕ) (q : L → L) : L →ₗ[F] RestrictedEnvelopingAlgebra F L p q :=
  (RingCon.mkₐ F (LieAlgebra.restrictedEnvelopingIdeal F p q).ringCon).toLinearMap.comp
    (TensorAlgebra.ι F)

end RestrictedEnvelopingAlgebra
