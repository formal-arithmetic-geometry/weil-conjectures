module

public import Mathlib.Algebra.Lie.SerreConstruction
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Prod

/-!
# Free normal form for the Weyl-only Lie presentation

Source: Milne, Algebraic Groups (2017), Theorem 23.63, first proof, printed p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form)

The four Weyl relation families are imposed over ℚ for an arbitrary rational matrix.
There are no Serre relations. The two free Lie algebras use the same index type, with
separate canonical maps into the quotient; the Cartan vector space is `I →₀ ℚ`.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace LieAlgebra

/-- The ideal generated by precisely the four Weyl relation families, with rational
matrix coefficients. `HH` and `EF` are Mathlib's existing relation families.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form) -/
noncomputable def weylOnlyIdeal {I : Type u} (B : Matrix I I ℚ) :
    LieIdeal ℚ (FreeLieAlgebra ℚ (CartanMatrix.Generators I)) := by
  classical
  exact LieSubmodule.lieSpan ℚ _
    (Set.range (CartanMatrix.Relations.HH ℚ) ∪
      Set.range (CartanMatrix.Relations.EF ℚ) ∪
      Set.range (fun p : I × I ↦
        ⁅FreeLieAlgebra.of ℚ (CartanMatrix.Generators.H p.1),
          FreeLieAlgebra.of ℚ (CartanMatrix.Generators.E p.2)⁆ -
          B p.1 p.2 • FreeLieAlgebra.of ℚ (CartanMatrix.Generators.E p.2)) ∪
      Set.range (fun p : I × I ↦
        ⁅FreeLieAlgebra.of ℚ (CartanMatrix.Generators.H p.1),
          FreeLieAlgebra.of ℚ (CartanMatrix.Generators.F p.2)⁆ +
          B p.1 p.2 • FreeLieAlgebra.of ℚ (CartanMatrix.Generators.F p.2)))

/-- The actual free rational Lie algebra quotient by the Weyl-only ideal.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form) -/
abbrev WeylOnly {I : Type u} (B : Matrix I I ℚ) :=
  FreeLieAlgebra ℚ (CartanMatrix.Generators I) ⧸ weylOnlyIdeal B

/-- The images of the generators `H i`, `E i`, and `F i` in the Weyl-only quotient.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form) -/
noncomputable def weylOnlyGenerator {I : Type u} (B : Matrix I I ℚ)
    (g : CartanMatrix.Generators I) : WeylOnly B :=
  LieSubmodule.Quotient.mk' (weylOnlyIdeal B) (FreeLieAlgebra.of ℚ g)

/-- The canonical negative free-Lie map, sending the generator indexed by `i` to `f_i`.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form) -/
noncomputable def weylOnlyNegative {I : Type u} (B : Matrix I I ℚ) :
    FreeLieAlgebra ℚ I →ₗ⁅ℚ⁆ WeylOnly B :=
  FreeLieAlgebra.lift ℚ (fun i ↦ weylOnlyGenerator B (CartanMatrix.Generators.F i))

/-- The canonical positive free-Lie map, sending the generator indexed by `i` to `e_i`.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form) -/
noncomputable def weylOnlyPositive {I : Type u} (B : Matrix I I ℚ) :
    FreeLieAlgebra ℚ I →ₗ⁅ℚ⁆ WeylOnly B :=
  FreeLieAlgebra.lift ℚ (fun i ↦ weylOnlyGenerator B (CartanMatrix.Generators.E i))

/-- The normal-form linear map `(y,c,x) ↦ ι₋(y) + ∑ i, cᵢ hᵢ + ι₊(x)`.
Finite direct sums of three vector spaces are represented by their product.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504.
(blueprint: lem-sfb-weyl-relations-free-normal-form) -/
noncomputable def weylOnlyNormalFormMap {I : Type u} (B : Matrix I I ℚ) :
    (FreeLieAlgebra ℚ I × (I →₀ ℚ) × FreeLieAlgebra ℚ I) →ₗ[ℚ] WeylOnly B :=
  (weylOnlyNegative B).toLinearMap.coprod
    ((Finsupp.linearCombination ℚ
      (fun i ↦ weylOnlyGenerator B (CartanMatrix.Generators.H i))).coprod
      (weylOnlyPositive B).toLinearMap)

/-- The normal-form map is a rational vector-space isomorphism, both free-Lie maps
are injective, and the empty-index free, Cartan and quotient spaces are zero.
Source: Milne, Algebraic Groups, Theorem 23.63, first proof, p.504; the arbitrary
rational-matrix proof is the agent argument recorded in the DAG node.
(blueprint: lem-sfb-weyl-relations-free-normal-form)

Proof plan:
1. Bracket words span a free Lie algebra by its universal property. Extend the word
   operators of lem-sfb-weyl-word-operators to a representation ρ_λ of this quotient
   for each λ : I → ℚ; all four relations lie in its kernel.
2. Apply a putative normal-form relation to the empty word. Positive words kill it,
   negative words act by left multiplication, and h_i acts by λ_i. The embedding
   of lem-sfb-free-lie-word-embedding has no empty-word coefficient. Setting λ = 0
   gives y = 0, and coordinate weights give every Cartan coefficient zero.
3. The generator exchange h_i ↦ -h_i, e_i ↦ f_i, f_i ↦ e_i respects all four
   relations and is involutive. It converts a positive kernel element to a negative
   one, proving injectivity of the positive map and of the whole normal-form map.
4. Jacobi induction on same-sign bracket words gives [H,N] ⊆ N, [H,P] ⊆ P,
   with the coefficient equal to the signed sum of the matrix entries, and [H,H] = 0.
5. Induction on negative word length gives [e_i,v] in H for length one and in N
   for larger length. By the exchange involution the corresponding positive claim
   holds. Thus all generator adjoints preserve S = N + H + P.
6. The set of elements whose adjoints preserve S is a Lie subalgebra by Jacobi,
   and contains all generators, hence is the whole quotient. Therefore S is itself
   a Lie subalgebra containing all generators, so S is the quotient, proving
   surjectivity. With no indices the bracket-word spans and Cartan space are zero.
No step requires a diagonal, rank, sign, or finite-type assumption on B.
-/
theorem weylOnlyNormalForm {I : Type u} [Finite I] (B : Matrix I I ℚ) :
    Function.Bijective (weylOnlyNormalFormMap B) ∧
      Function.Injective (weylOnlyNegative B) ∧
      Function.Injective (weylOnlyPositive B) ∧
      (IsEmpty I → Subsingleton (FreeLieAlgebra ℚ I) ∧
        Subsingleton (I →₀ ℚ) ∧ Subsingleton (WeylOnly B)) := by
  sorry

end LieAlgebra
