module

public import Mathlib.Algebra.Lie.UniversalEnveloping
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Data.List.OfFn
public import Mathlib.LinearAlgebra.Basis.Defs

/-!
# The integral form generated by root divided powers

Source: Milne, Algebraic Groups (2017), Section 23h, pp. 508–510, the divided powers
preceding equation (152), and the Kostant integral-form input to admissible lattices
(blueprint: def-sfb-kostant-integral-form).

The enveloping algebra is Mathlib's tensor-algebra quotient. Its integral form is an actual
unital integer subalgebra, constructed by adjoining all specified divided powers. Ordered
products use lists, so they retain the chosen root order in this noncommutative algebra.
-/

@[expose] public section

universe u v

namespace Algebra

/-- The divided power `x^n / n!` in an associative rational algebra, including `n = 0`.
Source: Milne, Algebraic Groups (2017), Section 23h, p. 510, before (152)
(blueprint: def-sfb-kostant-integral-form). -/
def rationalDividedPower {A : Type u} [Ring A] [Algebra ℚ A] (x : A) (n : ℕ) : A :=
  (1 / (n.factorial : ℚ)) • x ^ n

/-- The falling binomial `x(x-1)⋯(x-n+1)/n!` in an associative rational algebra.
The empty product is one. Source: the toral binomials in the Kostant integral PBW input to
Milne, Algebraic Groups (2017), Section 23h, p. 510
(blueprint: def-sfb-kostant-integral-form). -/
def rationalBinomial {A : Type u} [Ring A] [Algebra ℚ A] (x : A) (n : ℕ) : A :=
  (1 / (n.factorial : ℚ)) • ((List.range n).map (fun k : ℕ ↦ x - (k : A))).prod

end Algebra

namespace LieAlgebra

/-- The unital integer subalgebra of the rational enveloping algebra generated by all
root divided powers. No basis or integrality theorem enters this construction.
Source: Kostant's integral-form input to Milne, Algebraic Groups (2017), Section 23h, p. 510
(blueprint: def-sfb-kostant-integral-form). -/
def kostantIntegralForm {L : Type u} [LieRing L] [LieAlgebra ℚ L]
    {I : Type v} (e : I → L) : Subalgebra ℤ (UniversalEnvelopingAlgebra ℚ L) :=
  Algebra.adjoin ℤ {x | ∃ (i : I) (n : ℕ),
    x = Algebra.rationalDividedPower (UniversalEnvelopingAlgebra.ι ℚ (e i)) n}

/-- The triangular monomial with negative-root exponents, toral exponents, and positive-root
exponents. The three lists follow the orders on `Fin N`, `Fin r`, and `Fin N`, respectively.
Source: the Kostant integral PBW input to Milne, Algebraic Groups (2017), Section 23h, p. 510
(blueprint: def-sfb-kostant-integral-form). -/
def kostantPBWMonomial {L : Type u} [LieRing L] [LieAlgebra ℚ L] {r N : ℕ}
    (h : Fin r → L) (f e : Fin N → L)
    (d : (Fin N → ℕ) × (Fin r → ℕ) × (Fin N → ℕ)) :
    UniversalEnvelopingAlgebra ℚ L :=
  (List.ofFn (fun j ↦ Algebra.rationalDividedPower
    (UniversalEnvelopingAlgebra.ι ℚ (f j)) (d.1 j))).prod *
  (List.ofFn (fun i ↦ Algebra.rationalBinomial
    (UniversalEnvelopingAlgebra.ι ℚ (h i)) (d.2.1 i))).prod *
  (List.ofFn (fun j ↦ Algebra.rationalDividedPower
    (UniversalEnvelopingAlgebra.ι ℚ (e j)) (d.2.2 j))).prod

end LieAlgebra
