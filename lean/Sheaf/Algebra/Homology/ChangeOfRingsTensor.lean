/-!
# Change of rings for the derived tensor

Source: literature/blueprint/master/blueprint/sec-smooth-purity/
  sk-prop-sf-kunneth-ordinary/lem-kun-change-of-rings-tensor.md,
node lem-kun-change-of-rings-tensor (blueprint: lem-kun-change-of-rings-tensor).
-/

@[expose] public section

universe u wR wk

open CategoryTheory CategoryTheory.Limits

namespace DerivedCategory

/-- The quotient of an `R`-module by the submodule generated by multiplication by `l`,
viewed as a `ULift (ZMod l)`-module. This is the module denoted `M / l M`
in the blueprint.
Source: blueprint node lem-kun-change-of-rings-tensor
(blueprint: lem-kun-change-of-rings-tensor). -/
noncomputable def quotientByNat
    (R : Type u) [CommRing R] (l : ℕ) (M : ModuleCat.{u} R) :
    ModuleCat.{u} (ULift.{u} (ZMod l)) := by
  let H : AddSubgroup M :=
    (Submodule.span R (Set.range (fun x : M ↦ (l : R) • x))).toAddSubgroup
  let hH : ∀ x : M, l • x ∈ H := by
    intro x
    apply Submodule.subset_span
    exact ⟨x, Nat.cast_smul_eq_nsmul R l x⟩
  letI : Module (ZMod l) (M ⧸ H) := QuotientAddGroup.zmodModule hH
  letI : Module (ULift.{u} (ZMod l)) (M ⧸ H) := ULift.module
  exact ModuleCat.of (ULift.{u} (ZMod l)) (M ⧸ H)

/-- The canonical coefficient action on a complex killed degreewise by `l`.
Its differentials are the original additive maps; `ZMod.map_smul` makes them linear.
Source: blueprint node lem-kun-change-of-rings-tensor, proof Step 1
(blueprint: lem-kun-change-of-rings-tensor). -/
noncomputable def torsionByNatComplex
    {R : Type u} [CommRing R] (l : ℕ) (N : CochainComplex (ModuleCat.{u} R) ℤ)
    (hN : ∀ q : ℤ, ∀ x : N.X q, l • x = 0) :
    CochainComplex (ModuleCat.{u} (ULift.{u} (ZMod l))) ℤ := by
  letI (q : ℤ) : Module (ZMod l) (N.X q) := AddCommGroup.zmodModule (hN q)
  letI (q : ℤ) : Module (ULift.{u} (ZMod l)) (N.X q) := ULift.module
  exact
    { X := fun q ↦ ModuleCat.of (ULift.{u} (ZMod l)) (N.X q)
      d := fun i j ↦ ModuleCat.ofHom
        { toFun := (N.d i j).hom
          map_add' := (N.d i j).hom.map_add
          map_smul' := fun c x ↦ ZMod.map_smul (N.d i j).hom.toAddMonoidHom c.down x }
      shape := fun i j h ↦ by
        ext x
        exact congrArg (fun f ↦ f.hom x) (N.shape i j h)
      d_comp_d' := fun i j k _ _ ↦ by
        ext x
        exact congrArg (fun f ↦ f.hom x) (N.d_comp_d i j k) }

/-- The quotient coefficient map, including negative and zero integer moduli.
`Int.quotientSpanEquivZMod` identifies this encoding with `ℤ/(n)`.
Source: blueprint node lem-kun-change-of-rings-tensor, proof Step 1
(blueprint: lem-kun-change-of-rings-tensor). -/
noncomputable def quotientToPrime (n m : ℤ) (l : ℕ) (hnm : n = (l : ℤ) * m) :
    ULift.{u} (ZMod n.natAbs) →+* ULift.{u} (ZMod l) :=
  RingHom.ulift (ZMod.castHom (by
    refine ⟨m.natAbs, ?_⟩
    rw [hnm, Int.natAbs_mul, Int.natAbs_natCast]) (ZMod l))

/-- A choice of the published left-derived tensor functor, determined up to its
unique comparison isomorphism by its universal property.
Source: Stacks Project, Tag 06Y6, via lem-pc-derived-tensor-second-factor-functor
(blueprint: lem-kun-change-of-rings-tensor). -/
noncomputable abbrev changeOfRingsFixedTensor
    {R A : Type u} [CommRing R] [CommRing A]
    [HasDerivedCategory.{wR} (ModuleCat.{u} R)]
    [HasDerivedCategory.{wk} (ModuleCat.{u} A)] (f : R →+* A) :=
  Classical.choose (exists_derivedTensor_second_factor_functor f).2

/-- The published K-flat computation map of the chosen left-derived tensor.
Source: Stacks Project, Tag 06Y6, via lem-pc-derived-tensor-second-factor-functor
(blueprint: lem-kun-change-of-rings-tensor). -/
noncomputable abbrev changeOfRingsFixedTensorComparison
    {R A : Type u} [CommRing R] [CommRing A]
    [HasDerivedCategory.{wR} (ModuleCat.{u} R)]
    [HasDerivedCategory.{wk} (ModuleCat.{u} A)] (f : R →+* A) :=
  Classical.choose (Classical.choose_spec (exists_derivedTensor_second_factor_functor f).2)

/-- Change of rings for the derived tensor, with its canonical representative map.
Source: blueprint node lem-kun-change-of-rings-tensor, order 1749; Stacks Project,
Tags 00HB, 064K and 06Y6 (blueprint: lem-kun-change-of-rings-tensor).

Proof (the four steps of the node):
1. The quotient map `R → k` is well-defined since `l ∣ n`. Degreewise annihilation
   gives the unique `k`-action on `N`; the same construction applies to `M/lM`.
   The balanced map `x ⊗ y ↦ x̄ ⊗ y` has inverse `x̄ ⊗ y ↦ x ⊗ y`:
   changing a lift by `l z` contributes `z ⊗ l y = 0`. Balancing over `k` follows
   by lifting its scalars to `R`. The composites fix pure tensors, and the formula
   commutes with every map of second factors.
2. For an injection of `k`-modules, restriction to `R` remains injective. Flatness
   of `M` and the natural identifications in step 1 show that tensoring with `M/lM`
   preserves this injection, hence `M/lM` is flat (`lem-weil-pbc-flat-tensor-exact`).
3. Both degree-zero complexes are bounded above and flat, hence K-flat by
   `lem-pc-module-bounded-flat-kflat`. Apply the published comparison maps of
   `lem-pc-derived-tensor-second-factor-functor` to their identity resolutions.
   The total complex has only the summand `(0,q)` in degree `q`, with differential
   `1 ⊗ d_N` and sign `+1` (`def-pc-tensor-complex-sheaves`). No bound on `N` is used.
4. Naturality in step 1 makes the degreewise maps an isomorphism of total complexes.
   Restriction of scalars preserves cohomology and quasi-isomorphisms. Localize this
   isomorphism and compose with the two K-flat comparison maps. Their universal
   characterization makes the resulting isomorphism unique and independent of models.

The mixed tensor convention represents `x ⊗ y` as `y ⊗ (1 ⊗ x)`.
The displayed formula on generators is therefore exactly `x ⊗ y ↦ x̄ ⊗ y`.
The final equation fixes the derived isomorphism through the published computation
maps, so the conclusion specifies the canonical isomorphism, not merely its existence. -/
theorem changeOfRingsTensor
    (n m : ℤ) (l : ℕ) (hl : Nat.Prime l) (hnm : n = (l : ℤ) * m)
    [HasDerivedCategory.{wR} (ModuleCat.{u} (ULift.{u} (ZMod n.natAbs)))]
    [HasDerivedCategory.{wk} (ModuleCat.{u} (ULift.{u} (ZMod l)))]
    (M : ModuleCat.{u} (ULift.{u} (ZMod n.natAbs)))
    (hM : Module.Flat (ULift.{u} (ZMod n.natAbs)) M)
    (N : CochainComplex (ModuleCat.{u} (ULift.{u} (ZMod n.natAbs))) ℤ)
    (hN : ∀ q : ℤ, ∀ x : N.X q, l • x = 0) :
    ∃! e :
      (ModuleCat.restrictScalars (quotientToPrime n m l hnm)).mapDerivedCategory.obj
        (((changeOfRingsFixedTensor (quotientToPrime n m l hnm)).obj
          (torsionByNatComplex l N hN)).obj (Q.obj
            ((CochainComplex.singleFunctor
              (ModuleCat.{u} (ULift.{u} (ZMod n.natAbs))) (0 : ℤ)).obj M))) ≅
      (ModuleCat.restrictScalars (quotientToPrime n m l hnm)).mapDerivedCategory.obj
        (((changeOfRingsFixedTensor (RingHom.id (ULift.{u} (ZMod l)))).obj
          (torsionByNatComplex l N hN)).obj (Q.obj
            ((CochainComplex.singleFunctor (ModuleCat.{u} (ULift.{u} (ZMod l))) (0 : ℤ)).obj
              (quotientByNat (ULift.{u} (ZMod n.natAbs)) l M)))),
      ∃ t :
        (CochainComplex.mapBifunctor
          ((CochainComplex.singleFunctor
              (ModuleCat.{u} (ULift.{u} (ZMod n.natAbs))) (0 : ℤ)).obj M)
          (torsionByNatComplex l N hN) (ModuleCat.mixedTensor (quotientToPrime n m l hnm)).flip) ≅
        (CochainComplex.mapBifunctor
          ((CochainComplex.singleFunctor (ModuleCat.{u} (ULift.{u} (ZMod l))) (0 : ℤ)).obj
              (quotientByNat (ULift.{u} (ZMod n.natAbs)) l M))
          (torsionByNatComplex l N hN)
            (ModuleCat.mixedTensor (RingHom.id (ULift.{u} (ZMod l)))).flip),
        (∀ (q : ℤ) (x : M) (y : (torsionByNatComplex l N hN).X q)
          (a : ULift.{u} (ZMod l)),
          (t.hom.f q).hom
            ((CochainComplex.ιMapBifunctor
            ((CochainComplex.singleFunctor
              (ModuleCat.{u} (ULift.{u} (ZMod n.natAbs))) (0 : ℤ)).obj M)
            (torsionByNatComplex l N hN) (ModuleCat.mixedTensor (quotientToPrime n m l hnm)).flip
            0 q q (zero_add q)).hom
              (y ⊗ₜ[ULift.{u} (ZMod l)]
                (a ⊗ₜ[ULift.{u} (ZMod n.natAbs)]
                  (HomologicalComplex.singleObjXSelf (.up ℤ) 0 M).inv.hom x))) =
          (CochainComplex.ιMapBifunctor
            ((CochainComplex.singleFunctor (ModuleCat.{u} (ULift.{u} (ZMod l))) (0 : ℤ)).obj
              (quotientByNat (ULift.{u} (ZMod n.natAbs)) l M))
            (torsionByNatComplex l N hN)
            (ModuleCat.mixedTensor (RingHom.id (ULift.{u} (ZMod l)))).flip
            0 q q (zero_add q)).hom
            (y ⊗ₜ[ULift.{u} (ZMod l)]
              (a ⊗ₜ[ULift.{u} (ZMod l)]
                (HomologicalComplex.singleObjXSelf (.up ℤ) 0
                    (quotientByNat (ULift.{u} (ZMod n.natAbs)) l M)).inv.hom
                  (QuotientAddGroup.mk x)))) ∧
        e.hom ≫ (ModuleCat.restrictScalars (quotientToPrime n m l hnm)).mapDerivedCategory.map
          ((changeOfRingsFixedTensorComparison (RingHom.id (ULift.{u} (ZMod l)))
            (torsionByNatComplex l N hN)).app
              ((CochainComplex.singleFunctor (ModuleCat.{u} (ULift.{u} (ZMod l))) (0 : ℤ)).obj
              (quotientByNat (ULift.{u} (ZMod n.natAbs)) l M))) =
        (ModuleCat.restrictScalars (quotientToPrime n m l hnm)).mapDerivedCategory.map
          ((changeOfRingsFixedTensorComparison (quotientToPrime n m l hnm)
            (torsionByNatComplex l N hN)).app
              ((CochainComplex.singleFunctor
              (ModuleCat.{u} (ULift.{u} (ZMod n.natAbs))) (0 : ℤ)).obj M)) ≫
        (ModuleCat.restrictScalars (quotientToPrime n m l hnm)).mapDerivedCategory.map
          (Q.map t.hom) := by sorry

end DerivedCategory
