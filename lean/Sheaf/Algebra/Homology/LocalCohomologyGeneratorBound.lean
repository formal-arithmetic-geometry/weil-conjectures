module

public import Sheaf.Algebra.Homology.LocalCohomologicalDimension
public import Sheaf.Algebra.Homology.IdealPowerTorsionFunctor
public import Mathlib.RingTheory.Ideal.Operations
import Sheaf.Algebra.Homology.IdealTorsionCechComputation
import Sheaf.Algebra.Homology.LocalCohomologySumSpectral

/-!
# Local cohomological dimension: generator and proper-sum bounds

Source: Stacks Project, Local Cohomology, Tags 0DX8, 0DX7, 0DX9, and 0ECP
(blueprint: lem-per-local-cohomology-generator-bound).
-/

@[expose] public section

universe u

open Set

namespace ModuleCat

/-- For a nonzero commutative Noetherian ring, local cohomological dimension is bounded by
numbers of generators and is subadditive for proper sums.

Source: Stacks Project, Local Cohomology, Tags 0DX8, 0DX7, 0DX9, and 0ECP
(blueprint: lem-per-local-cohomology-generator-bound).

Proof: choose generators and apply the Cech complex bound
`lem-per-local-cohomology-cech-bound`; its terms vanish above the number of generators,
which gives existence of the least bound and the upper bound. For a proper ideal, apply
`Γ_I` to the nonzero module `A/I` to show that degree zero is nonzero, excluding the
bound `-1`. For a proper sum, use the spectral sequence
`lem-per-local-cohomology-sum-spectral`; all `E₂` terms above the sum of the two bounds
vanish, so the finite filtration of the abutment has zero graded pieces. Finally apply
the generator bound to the ideal generated by the additional finite list and substitute
its bound into the sum inequality. The empty list gives the zero ideal and the same
argument applies.
-/
theorem localCohomology_generator_bound
    (A : Type u) [CommRing A] [Nontrivial A] [IsNoetherianRing A] :
    (∀ (I : Ideal A) (r : ℕ) (f : Fin r → A),
      I = Ideal.span (Set.range f) → I ≠ ⊤ →
        0 ≤ localCohomologicalDimension I ∧
          localCohomologicalDimension I ≤ r) ∧
    (∀ (I J : Ideal A), I.FG → J.FG → I + J ≠ ⊤ →
      localCohomologicalDimension (I + J) ≤
        localCohomologicalDimension I + localCohomologicalDimension J) ∧
    (∀ (I : Ideal A) (e : ℕ) (f : Fin e → A), I.FG →
      I + Ideal.span (Set.range f) ≠ ⊤ →
        localCohomologicalDimension (I + Ideal.span (Set.range f)) ≤
          localCohomologicalDimension I + e) := by
  sorry

end ModuleCat
