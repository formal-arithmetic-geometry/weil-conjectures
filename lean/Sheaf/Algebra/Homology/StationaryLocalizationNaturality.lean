module

public import Mathlib.Algebra.Homology.SpectralSequence.Basic
public import Mathlib.CategoryTheory.Localization.Construction

/-! # Stationary naturality through localization

Source: Stacks Project, Tags 012O, 012W and 04VK.
(blueprint: lem-kun-stationary-localization-naturality).
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u v w z

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory

private theorem stationary_square_previous
    {C : Type u} [Category.{v} C] [Abelian C]
    (E F : CohomologicalSpectralSequence C 1) (m : E ⟶ F)
    (a b r : ℤ) (hr : 1 ≤ r) {X Y : C} (f : X ⟶ Y)
    (c : (E.page r hr).X (a, b) ⟶ X)
    (c' : (E.page (r + 1) (by omega)).X (a, b) ⟶ X)
    (e : (F.page r hr).X (a, b) ⟶ Y)
    (e' : (F.page (r + 1) (by omega)).X (a, b) ⟶ Y)
    [Epi ((E.page r hr).iCycles (a, b))]
    (hc : (E.page r hr).iCycles (a, b) ≫ c =
      (E.page r hr).homologyπ (a, b) ≫ (E.iso r (r + 1) (a, b) rfl hr).hom ≫ c')
    (he : (F.page r hr).iCycles (a, b) ≫ e =
      (F.page r hr).homologyπ (a, b) ≫ (F.iso r (r + 1) (a, b) rfl hr).hom ≫ e')
    (hn : (m.hom (r + 1) (by omega)).f (a, b) ≫ e' = c' ≫ f) :
    (m.hom r hr).f (a, b) ≫ e = c ≫ f := by
  apply (cancel_epi ((E.page r hr).iCycles (a, b))).1
  calc
    _ = HomologicalComplex.cyclesMap (m.hom r hr) (a, b) ≫
        (F.page r hr).iCycles (a, b) ≫ e := by
      simpa only [Category.assoc] using congrArg (· ≫ e)
        (HomologicalComplex.cyclesMap_i (m.hom r hr) (a, b)).symm
    _ = HomologicalComplex.cyclesMap (m.hom r hr) (a, b) ≫
        (F.page r hr).homologyπ (a, b) ≫
        (F.iso r (r + 1) (a, b) rfl hr).hom ≫ e' := by rw [he]
    _ = (E.page r hr).homologyπ (a, b) ≫
        HomologicalComplex.homologyMap (m.hom r hr) (a, b) ≫
        (F.iso r (r + 1) (a, b) rfl hr).hom ≫ e' := by
      rw [← Category.assoc, ← HomologicalComplex.homologyπ_naturality, Category.assoc]
    _ = (E.page r hr).homologyπ (a, b) ≫
        (E.iso r (r + 1) (a, b) rfl hr).hom ≫ c' ≫ f := by
      rw [reassoc_of% (m.comm r (r + 1) (a, b) rfl hr), hn]
    _ = _ := by simpa only [Category.assoc] using congrArg (· ≫ f) hc.symm

/-- Compatible stationary comparisons natural on the generators are natural on the
whole localization, at every index stationary for both endpoints.
Source: Stacks Project, Tags 012O, 012W and 04VK.
(blueprint: lem-kun-stationary-localization-naturality).

Proof. Say a localized map is eventually natural if its square commutes at every
sufficiently large index. This property is closed under composition, by taking a
common bound for both maps and the intermediate object. It is closed under
inversion of an isomorphism by cancellation of its invertible page maps. The
localization is generated by original maps and inverses, so eventual naturality
holds for every localized map. Starting at a common sufficiently large index,
descend one page at a time. Precompose with the epimorphic inclusion of cycles;
cycle and homology naturality, the spectral-sequence commutation equation and
the two successor equations turn the next-page square into the current square.
Cancel that epimorphism and induct on the finite difference of the indices. -/
theorem localization_stationary_naturality
    {A : Type u} [Category.{v} A] {C : Type w} [Category.{z} C] [Abelian C]
    (W : MorphismProperty A)
    (E : W.Localization ⥤ CohomologicalSpectralSequence C 1)
    (H : W.Localization ⥤ C) (a b : ℤ) (B : W.Localization → ℤ)
    (c : ∀ (X : W.Localization) (r : ℤ) (hr : 1 ≤ r), B X ≤ r →
      (((E.obj X).page r hr).X (a, b) ≅ H.obj X))
    (hcycle : ∀ (X : W.Localization) (r : ℤ) (hr : 1 ≤ r) (_ : B X ≤ r),
      Epi (((E.obj X).page r hr).iCycles (a, b)))
    (hsucc : ∀ (X : W.Localization) (r : ℤ) (hr : 1 ≤ r) (hX : B X ≤ r),
      ((E.obj X).page r hr).iCycles (a, b) ≫ (c X r hr hX).hom =
        ((E.obj X).page r hr).homologyπ (a, b) ≫
          ((E.obj X).iso r (r + 1) (a, b) rfl hr).hom ≫
            (c X (r + 1) (by omega) (by omega)).hom)
    (hgen : ∀ {X Y : A} (f : X ⟶ Y), ∃ R : ℤ,
      ∀ (r : ℤ) (hr : 1 ≤ r) (hX : B (W.Q.obj X) ≤ r) (hY : B (W.Q.obj Y) ≤ r),
        R ≤ r → ((E.map (W.Q.map f)).hom r hr).f (a, b) ≫
          (c (W.Q.obj Y) r hr hY).hom =
            (c (W.Q.obj X) r hr hX).hom ≫ H.map (W.Q.map f)) :
    ∀ {X Y : W.Localization} (f : X ⟶ Y)
      (r : ℤ) (hr : 1 ≤ r) (hX : B X ≤ r) (hY : B Y ≤ r),
      ((E.map f).hom r hr).f (a, b) ≫ (c Y r hr hY).hom =
        (c X r hr hX).hom ≫ H.map f := by
  let J (r : ℤ) (hr : 1 ≤ r) : W.Localization ⥤ C :=
    E ⋙ SpectralSequence.pageFunctor C (fun t ↦ ComplexShape.up' (t, 1 - t)) 1 r hr ⋙
      HomologicalComplex.eval C (ComplexShape.up' (r, 1 - r)) (a, b)
  let P : MorphismProperty W.Localization := fun {X Y} f ↦ ∃ R : ℤ,
    ∀ (r : ℤ) (hr : 1 ≤ r) (hX : B X ≤ r) (hY : B Y ≤ r),
      R ≤ r → (J r hr).map f ≫ (c Y r hr hY).hom =
        (c X r hr hX).hom ≫ H.map f
  have : P.IsStableUnderComposition := ⟨by
    intro X Y Z f g hf hg
    obtain ⟨Rf, hf⟩ := hf
    obtain ⟨Rg, hg⟩ := hg
    refine ⟨max Rf (max Rg (B Y)), ?_⟩
    intro r hr hX hZ hR
    have hY : B Y ≤ r := by omega
    change (J r hr).map (f ≫ g) ≫ _ = _
    rw [Functor.map_comp, Functor.map_comp, Category.assoc, hg r hr hY hZ (by omega)]
    rw [← Category.assoc, hf r hr hX hY (by omega), Category.assoc]⟩
  have htop : P = ⊤ := Localization.Construction.morphismProperty_eq_top' (W := W) P
    (by intro X Y f; exact hgen f) (by
      intro X Y e he
      obtain ⟨R, he⟩ := he
      refine ⟨R, ?_⟩
      intro r hr hY hX hR
      apply (cancel_epi ((J r hr).map e.hom)).1
      simp only [← Category.assoc, ← Functor.map_comp, Iso.hom_inv_id,
        Functor.map_id, Category.id_comp]
      rw [Category.assoc, reassoc_of% (he r hr hX hY hR)]
      simp only [← Functor.map_comp, Iso.hom_inv_id, Functor.map_id, Category.comp_id])
  intro X Y f r hr hX hY
  have hp : P f := by rw [htop]; trivial
  obtain ⟨R, hR⟩ := hp
  let T := max R r
  have hn := hR T (by dsimp [T]; omega) (by dsimp [T]; omega)
    (by dsimp [T]; omega) (by dsimp [T]; omega)
  have down (k : ℕ) : ∀ (s : ℤ) (hs : 1 ≤ s) (hXs : B X ≤ s) (hYs : B Y ≤ s),
      s + k = T → (J s hs).map f ≫ (c Y s hs hYs).hom =
        (c X s hs hXs).hom ≫ H.map f := by
    induction k with
    | zero =>
      intro s hs hXs hYs heq
      have heq : s = T := by simpa using heq
      subst s
      exact hn
    | succ k ih =>
      intro s hs hXs hYs heq
      have : Epi (((E.obj X).page s hs).iCycles (a, b)) := hcycle X s hs hXs
      exact stationary_square_previous (E.obj X) (E.obj Y) (E.map f) a b s hs
        (H.map f) (c X s hs hXs).hom (c X (s + 1) (by omega) (by omega)).hom
        (c Y s hs hYs).hom (c Y (s + 1) (by omega) (by omega)).hom
        (hsucc X s hs hXs) (hsucc Y s hs hYs)
        (ih (s + 1) (by omega) (by omega) (by omega) (by omega))
  exact down (T - r).toNat r hr hX hY (by dsimp [T]; omega)

end CategoryTheory
