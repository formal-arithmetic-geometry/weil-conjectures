module

public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.CategoryTheory.Filtered.Basic
import Sheaf.Algebra.LimitFinitePresentation.Core
import Sheaf.Algebra.LimitFinitePresentation.Colimits

/-! # Noetherian approximation of a finitely presented ring map
Source: literature/stacks-project/algebra.tex, Lemma Tag 00R0
(blueprint: lem-weil-pbc-limit-finite-presentation).
-/

set_option linter.unusedVariables false

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace Algebra

/-- Noetherian approximation of a finitely presented ring map (Stacks Tag 00R0).
(blueprint: lem-weil-pbc-limit-finite-presentation)
Proof (Stacks Tag 00R0, expanded from the non-local version of Tag 00QV):
1. Choose a finite polynomial quotient presentation of `S` over `R`. Let `C` be the
   integer subalgebra generated by the finitely many relation coefficients
   [def-weil-pbc-finitely-presented-algebra], also for zero variables or relations.
2. Index by finitely generated integer subalgebras `T` of `R` containing `C`.
   The index contains `C`; adjoining the union of two finite generating sets
   supplies an upper bound. Adjoining any element of `R` shows the union is `R`.
   Thus `R` is their ring colimit [lemma-nagata-ring-finite-type-subalgebras],
   and each base model is finite type [def-weil-pbc-finite-type-algebra].
3. Define `S_T` by the same polynomial relations over `T`. Coefficient inclusions
   induce compatible transition maps and maps to `S`
   [def-weil-pbc-algebra-hom-quotient]. The variable classes generate `S_T` over `T`.
4. For `T ≤ U`, identify `S_T ⊗[T] U` with the same polynomial quotient over `U`
   [lem-weil-pbc-polynomial-scalar-extension]. The maps sending variables to their
   classes and coefficients to their images descend through the quotients
   [def-weil-pbc-algebra-hom-quotient]; the composites fix coefficients and variables.
   This proves the transition pushout clause.
5. Apply the same construction with `U = R` and compose with the chosen presentation
   isomorphism. The map sends `s ⊗ r` to `κ_T(s) * φ(r)` and is an isomorphism,
   proving the final pushout clause (compare Tag 00R1).
6. A compatible cocone from the `S_T` to a ring `B` determines a unique map `R → B`
   by Step 2, and common images of all variable classes. Relations vanish already
   at `C`, so the presentation induces a unique map `S → B`
   [def-weil-pbc-algebra-hom-quotient]. It agrees with the cocone on coefficients
   and variables, giving the second colimit [def-weil-pbc-category-colimit].
-/
theorem exists_limit_finite_presentation
    {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : RingHom.FinitePresentation φ) :
    ∃ (Λ : Type u) (hpo : Preorder Λ) (hne : Nonempty Λ)
      (hdir : IsDirected Λ (fun a b => a ≤ b))
      (Rfun : Λ ⥤ CommRingCat) (Sfun : Λ ⥤ CommRingCat)
      (η : Rfun ⟶ Sfun) (cR : Cocone Rfun) (cS : Cocone Sfun),
      cR.pt = CommRingCat.of R ∧ cS.pt = CommRingCat.of S ∧
      (∀ l (hR : cR.pt = CommRingCat.of R) (hS : cS.pt = CommRingCat.of S),
        η.app l ≫ cS.ι.app l = cR.ι.app l ≫
          (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm)) ∧
      (∀ l, RingHom.FiniteType (η.app l).hom) ∧
      (∀ l, RingHom.FiniteType (algebraMap ℤ (Rfun.obj l))) ∧
      (∀ l m (h : l ≤ m),
        Nonempty (CategoryTheory.IsPushout (η.app l) (Rfun.map (homOfLE h))
          (Sfun.map (homOfLE h)) (η.app m))) ∧
      (∀ l (hR : cR.pt = CommRingCat.of R) (hS : cS.pt = CommRingCat.of S),
        Nonempty (CategoryTheory.IsPushout (η.app l) (cR.ι.app l) (cS.ι.app l)
          (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm))) ∧
      Nonempty (IsColimit cR) ∧ Nonempty (IsColimit cS)
:= by
  obtain ⟨Λ, hpo, hne, hdir, Rfun, Sfun, η, cR, cS, hcore⟩ :=
    exists_limit_finite_presentation_core φ hφ
  rcases hcore with ⟨hR, hS, hcompat, hft, hRft, hpush, hfinal, hcolR⟩
  let : Nonempty Λ := hne
  let : IsDirected Λ (fun a b => a ≤ b) := hdir
  have hcolS := colimits_of_limit_finite_presentation_core η cR cS
    (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm)
    (fun l => hfinal l hR hS) hcolR.some
  exact ⟨Λ, hpo, hne, hdir, Rfun, Sfun, η, cR, cS, hR, hS, hcompat, hft,
    hRft, hpush, hfinal, hcolR, hcolS⟩

end Algebra
