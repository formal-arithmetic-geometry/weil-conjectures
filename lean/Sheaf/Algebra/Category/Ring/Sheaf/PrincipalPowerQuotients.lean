module

public import Mathlib.Algebra.Category.Ring.Basic
public import Mathlib.CategoryTheory.Sites.Sheafification
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Principal-power quotient ring sheaves

Source: blueprint, integral criterion reductions, second paragraph; Stacks Project,
Sites, Section 00YR
(blueprint: def-pe-principal-power-ring-quotients).
The quotient is the sheafification of the actual sectionwise quotient rings.
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u v r
open CategoryTheory

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  (B : Sheaf J CommRingCat.{r}) (t : (B.obj ⋙ forget CommRingCat.{r}).sections)

/-- The principal ideal generated by the indicated power of the section.
Source: blueprint, integral criterion reductions, coefficient sequence
(blueprint: def-pe-principal-power-ring-quotients). -/
def sectionPowerIdeal (n : ℕ) (U : Cᵒᵖ) : Ideal (B.obj.obj U) :=
  Ideal.span {(@id (B.obj.obj U) (t.val U)) ^ n}

/-- Restriction carries the power ideal into the power ideal.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients).
Proof: restriction sends the generator t_U^n to t_V^n by naturality of t and
preservation of powers by ring homomorphisms; it therefore preserves its ideal. -/
theorem sectionPowerIdeal_restrict (n : ℕ) {U V : Cᵒᵖ} (f : U ⟶ V) :
    sectionPowerIdeal B t n U ≤
      Ideal.comap (B.obj.map f).hom (sectionPowerIdeal B t n V) := sorry

/-- The actual quotient-ring restriction homomorphism.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients). -/
def sectionPowerQuotientMap (n : ℕ) {U V : Cᵒᵖ} (f : U ⟶ V) :
    CommRingCat.of (B.obj.obj U ⧸ sectionPowerIdeal B t n U) ⟶
      CommRingCat.of (B.obj.obj V ⧸ sectionPowerIdeal B t n V) :=
  CommRingCat.ofHom (Ideal.quotientMap (sectionPowerIdeal B t n V)
    (B.obj.map f).hom (sectionPowerIdeal_restrict B t n f))

/-- Identity restrictions on the quotient rings.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients).
Proof: every quotient class lifts to a section; both sides send its class to itself. -/
theorem sectionPowerQuotientMap_id (n : ℕ) (U : Cᵒᵖ) :
    sectionPowerQuotientMap B t n (𝟙 U) = 𝟙 _ := sorry

/-- Composition of restrictions on the quotient rings.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients).
Proof: lift a quotient class to a section and apply the composition law of B. -/
theorem sectionPowerQuotientMap_comp (n : ℕ) {U V W : Cᵒᵖ}
    (f : U ⟶ V) (g : V ⟶ W) :
    sectionPowerQuotientMap B t n (f ≫ g) =
      sectionPowerQuotientMap B t n f ≫ sectionPowerQuotientMap B t n g := sorry

/-- The presheaf of sectionwise principal-power quotient rings.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients). -/
def sectionPowerQuotientPresheaf (n : ℕ) : Cᵒᵖ ⥤ CommRingCat.{r} where
  obj U := CommRingCat.of (B.obj.obj U ⧸ sectionPowerIdeal B t n U)
  map f := sectionPowerQuotientMap B t n f
  map_id := sectionPowerQuotientMap_id B t n
  map_comp := sectionPowerQuotientMap_comp B t n

/-- Naturality of taking a section's quotient class.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients).
Proof: both composites send b to the class of its restriction. -/
theorem sectionPowerQuotientProjection_naturality (n : ℕ) {U V : Cᵒᵖ} (f : U ⟶ V) :
    B.obj.map f ≫ CommRingCat.ofHom (Ideal.Quotient.mk (sectionPowerIdeal B t n V)) =
      CommRingCat.ofHom (Ideal.Quotient.mk (sectionPowerIdeal B t n U)) ≫
        (sectionPowerQuotientPresheaf B t n).map f := sorry

/-- The sectionwise quotient projection.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients). -/
def sectionPowerQuotientProjection (n : ℕ) : B.obj ⟶ sectionPowerQuotientPresheaf B t n where
  app U := CommRingCat.ofHom (Ideal.Quotient.mk (sectionPowerIdeal B t n U))
  naturality := fun {_ _} f ↦ sectionPowerQuotientProjection_naturality B t n f

variable [HasSheafify J CommRingCat.{r}]

/-- The ring sheaf B/t^nB, obtained by sheafifying the sectionwise quotient rings.
Source: blueprint, integral criterion reductions, coefficient sequence; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients). -/
def principalPowerRingQuotient (n : ℕ) : Sheaf J CommRingCat.{r} :=
  (presheafToSheaf J CommRingCat.{r}).obj (sectionPowerQuotientPresheaf B t n)

/-- The canonical ring-sheaf projection B to B/t^nB.
Source: blueprint, integral criterion reductions; Stacks 00YR
(blueprint: def-pe-principal-power-ring-quotients). -/
def principalPowerRingProjection (n : ℕ) : B ⟶ principalPowerRingQuotient B t n :=
  ⟨sectionPowerQuotientProjection B t n ≫
    toSheafify J (sectionPowerQuotientPresheaf B t n)⟩

attribute [irreducible] principalPowerRingQuotient

end CategoryTheory
