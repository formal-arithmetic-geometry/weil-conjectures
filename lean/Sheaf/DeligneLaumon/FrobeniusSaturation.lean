module

public import WeilConjectures.CategoryTheory.Endofunctor.IsoAlgebra
public import Mathlib.CategoryTheory.Abelian.Images

/-! # The explicit Frobenius saturation of a subsheaf

Source: blueprint `sk-i-dl-general-real`, the geometric-socle/Frobenius orbit step.
(blueprint: def-zl-frobenius-saturation).
-/

@[expose] public section
set_option autoImplicit false

universe u₁ u₂ v₁ v₂
open CategoryTheory Limits Endofunctor

namespace CategoryTheory.Endofunctor.IsoAlgebra

variable {A : Type u₁} [Category.{v₁} A] [Abelian A]
  {B : Type u₂} [Category.{v₂} B]
  (F : A ⥤ A) [F.IsEquivalence] [F.Additive]
  [HasColimitsOfShape (Discrete ℤ) A]
  (L : B ⥤ A) (P : A ⥤ B) (adj : L ⊣ P)
  (V : IsoAlgebra F) (M : B) (s : M ⟶ P.obj V.carrier)

/-- The map from the free Frobenius algebra generated by the adjoint of `s`.
Source: the Frobenius-orbit construction in `sk-i-dl-general-real`.
(blueprint: def-zl-frobenius-saturation). -/
noncomputable def saturationMap : Free.algebra F (L.obj M) ⟶ V :=
  Free.desc V ((adj.homEquiv M V.carrier).symm s)

/-- The explicit image of the sum of all Frobenius translates of the initial map.
Source: the Frobenius-orbit construction in `sk-i-dl-general-real`.
(blueprint: def-zl-frobenius-saturation). -/
noncomputable def saturation : IsoAlgebra F :=
  image (saturationMap F L P adj V M s)

/-- The canonical monomorphism from the saturation into the ambient Weil object.
Source: the Frobenius-orbit construction in `sk-i-dl-general-real`.
(blueprint: def-zl-frobenius-saturation). -/
noncomputable def saturationι : saturation F L P adj V M s ⟶ V :=
  image.ι (saturationMap F L P adj V M s)

instance : Mono (saturationι F L P adj V M s) :=
  inferInstanceAs (Mono (image.ι _))

/-- The initial sheet maps into the restriction of the saturation via the zero-th summand.
Source: the Frobenius-orbit construction in `sk-i-dl-general-real`.
(blueprint: def-zl-frobenius-saturation). -/
noncomputable def saturationUnit : M ⟶ P.obj (saturation F L P adj V M s).carrier :=
  adj.unit.app M ≫ P.map (Sigma.ι (Free.obj F (L.obj M)) 0 ≫
    (factorThruImage (saturationMap F L P adj V M s)).hom.f)

/-- The canonical initial-sheet map recovers the original map after inclusion.
Source: the Frobenius-orbit construction in `sk-i-dl-general-real`.
Proof: the image factorization recovers the free map, whose zero-th summand is the
adjoint of `s`; the adjunction triangle recovers `s`.
(blueprint: def-zl-frobenius-saturation). -/
@[reassoc]
theorem saturationUnit_comp_map_ι :
    saturationUnit F L P adj V M s ≫ P.map (saturationι F L P adj V M s).hom.f = s := by
  have h : (factorThruImage (saturationMap F L P adj V M s)).hom.f ≫
      (saturationι F L P adj V M s).hom.f =
      (saturationMap F L P adj V M s).hom.f :=
    congrArg (fun f ↦ f.hom.f) (image.fac (saturationMap F L P adj V M s))
  simp only [saturationUnit, Category.assoc, ← P.map_comp]
  rw [h]
  change adj.unit.app M ≫ P.map (Sigma.ι (Free.obj F (L.obj M)) 0 ≫
    (Free.desc V ((adj.homEquiv M V.carrier).symm s)).hom.f) = s
  rw [Free.ι_desc_hom_f]
  exact (adj.homEquiv M V.carrier).apply_symm_apply s

/-- An underlying factor of an equivariant map through an equivariant monomorphism is
itself equivariant. Source: the subobject step in `sk-i-dl-general-real`.
Proof: compose the equivariance equation with the monomorphism, use equivariance
of both given maps, and cancel the monomorphism.
(blueprint: def-zl-frobenius-saturation). -/
def liftThroughMono {E : B ⥤ B} {U W T : IsoAlgebra E}
    (j : U ⟶ W) [Mono j.hom.f] (i : T ⟶ W)
    (a : T.carrier ⟶ U.carrier) (ha : a ≫ j.hom.f = i.hom.f) : T ⟶ U :=
  ObjectProperty.homMk
    { f := a
      h := by
        change E.map a ≫ U.obj.str = T.obj.str ≫ a
        apply (cancel_mono j.hom.f).1
        simp only [Category.assoc]
        rw [← j.hom.h, ← E.map_comp_assoc, ha, i.hom.h] }

/-- If the canonical generator is epi, restriction of the saturation recovers the
initial subobject. Source: the cyclic subobject argument in `sk-i-dl-general-real`.
Proof: its composite with the restricted inclusion is the given mono, so the generator
is also mono and hence an isomorphism. Equivariance follows by cancellation against
the restricted equivariant inclusion. Invert this canonical map.
(blueprint: def-zl-frobenius-saturation). -/
theorem saturation_restrict_iso [Abelian B]
    (E : B ⥤ B) [E.IsEquivalence] [E.Additive]
    (Q : IsoAlgebra F ⥤ IsoAlgebra E) [PreservesFiniteLimits Q]
    (H : Q ⋙ forget E ≅ forget F ⋙ P)
    (T : IsoAlgebra E) (i : T ⟶ Q.obj V) [Mono i]
    (hep : Epi (saturationUnit F L P adj V T.carrier
      (i.hom.f ≫ H.hom.app V))) :
    ∃ e : Q.obj (saturation F L P adj V T.carrier (i.hom.f ≫ H.hom.app V)) ≅ T,
      Q.map (saturationι F L P adj V T.carrier (i.hom.f ≫ H.hom.app V)) = e.hom ≫ i := by
  let s : T.carrier ⟶ P.obj V.carrier := i.hom.f ≫ H.hom.app V
  let U := saturation F L P adj V T.carrier s
  let j : U ⟶ V := saturationι F L P adj V T.carrier s
  let a := saturationUnit F L P adj V T.carrier s
  have ha : a ≫ P.map j.hom.f = s := saturationUnit_comp_map_ι F L P adj V T.carrier s
  have : Mono i.hom.f := (forget E).map_mono i
  have : Mono s := by dsimp only [s]; infer_instance
  have : Mono a := mono_of_mono_fac ha
  have : Epi a := hep
  have : IsIso a := isIso_of_mono_of_epi a
  let a' : T.carrier ⟶ (Q.obj U).carrier := a ≫ H.inv.app U
  have ha' : a' ≫ (Q.map j).hom.f = i.hom.f := by
    apply (cancel_mono (H.hom.app V)).1
    dsimp only [a']
    have hn : (Q.map j).hom.f ≫ H.hom.app V =
        H.hom.app U ≫ P.map j.hom.f := H.hom.naturality j
    rw [Category.assoc, hn]
    simpa only [Category.assoc, H.inv_hom_id_app_assoc] using ha
  have : Mono (Q.map j).hom.f := (forget E).map_mono (Q.map j)
  let a₀ : T ⟶ Q.obj U := liftThroughMono (Q.map j) i a' ha'
  have : IsIso a' := by dsimp only [a']; infer_instance
  have : IsIso a₀ := by
    have : IsIso ((forget E).map a₀) := inferInstanceAs (IsIso a')
    exact isIso_of_reflects_iso a₀ (forget E)
  have ha₀ : a₀ ≫ Q.map j = i := by
    apply (forget E).map_injective
    exact ha'
  refine ⟨(asIso a₀).symm, ?_⟩
  exact ((IsIso.inv_comp_eq a₀).2 ha₀.symm).symm

/-- Restrict a factorization isomorphism to full subcategories using their specified
comparison. Source: constructibility in the subobject step of `sk-i-dl-general-real`.
(blueprint: def-zl-frobenius-saturation). -/
theorem fullSubcategory_restrict_iso
    {C₁ : Type*} [Category C₁] {C₂ : Type*} [Category C₂]
    (S : ObjectProperty C₁) (T : ObjectProperty C₂)
    (Q : C₁ ⥤ C₂) (R : S.FullSubcategory ⥤ T.FullSubcategory)
    (I : R ⋙ T.ι ≅ S.ι ⋙ Q)
    {U V : S.FullSubcategory} {G : T.FullSubcategory}
    (j : U ⟶ V) (i : G ⟶ R.obj V)
    (e : Q.obj U.obj ≅ G.obj)
    (he : Q.map j.hom = e.hom ≫ i.hom ≫ I.hom.app V) :
    ∃ e' : R.obj U ≅ G, R.map j = e'.hom ≫ i := by
  let e' : R.obj U ≅ G := T.isoMk (I.app U ≪≫ e)
  refine ⟨e', ?_⟩
  apply T.ι.map_injective
  simp only [ObjectProperty.ι_map]
  apply (cancel_mono (I.hom.app V)).1
  have hn : (R.map j).hom ≫ I.hom.app V = I.hom.app U ≫ Q.map j.hom :=
    I.hom.naturality j
  rw [hn, he]
  simp only [e', ObjectProperty.isoMk_hom, Iso.trans_hom,
    ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.homMk_hom,
    Iso.app_hom, Category.assoc]

/-- Package an explicit subobject and its restriction isomorphism in full subcategories.
Source: the constructibility step of `sk-i-dl-general-real`.
Proof: attach the given property proof to the explicit object, reflect monicity through
the faithful inclusion, and use the natural comparison to descend the isomorphism.
(blueprint: def-zl-frobenius-saturation). -/
theorem fullSubcategory_subobject
    {C₁ : Type*} [Category C₁] {C₂ : Type*} [Category C₂]
    (S : ObjectProperty C₁) (T : ObjectProperty C₂)
    (Q : C₁ ⥤ C₂) (R : S.FullSubcategory ⥤ T.FullSubcategory)
    (I : R ⋙ T.ι ≅ S.ι ⋙ Q)
    (V : S.FullSubcategory) (G : T.FullSubcategory) (i : G ⟶ R.obj V)
    (U₀ : C₁) (j₀ : U₀ ⟶ V.obj) [Mono j₀]
    (e₀ : Q.obj U₀ ≅ G.obj)
    (he₀ : Q.map j₀ = e₀.hom ≫ i.hom ≫ I.hom.app V)
    (hU₀ : S U₀) (J : ObjectProperty C₁) (hJ : J U₀) :
    ∃ (U : S.FullSubcategory) (j : U ⟶ V), Mono j ∧ J U.obj ∧
      ∃ e : R.obj U ≅ G, R.map j = e.hom ≫ i := by
  let U : S.FullSubcategory := ⟨U₀, hU₀⟩
  let j : U ⟶ V := ObjectProperty.homMk j₀
  have : Mono j := S.ι.mono_of_mono_map (inferInstanceAs (Mono j₀))
  obtain ⟨e, he⟩ := fullSubcategory_restrict_iso S T Q R I j i e₀ (by
    simpa only [j, ObjectProperty.homMk_hom] using he₀)
  exact ⟨U, j, inferInstance, hJ, e, he⟩

/-- Assemble a saturated subobject directly in the prescribed full subcategories.
Source: constructibility and restriction in `sk-i-dl-general-real`.
Proof: the initial morphism stays monic after the inclusion comparison. Apply the
proved saturation restriction isomorphism and package its explicit image in the full
subcategory using its given properties. All categorical conversions occur here.
(blueprint: def-zl-frobenius-saturation). -/
theorem fullSubcategory_saturation [Abelian B]
    (E : B ⥤ B) [E.IsEquivalence] [E.Additive]
    (Q : IsoAlgebra F ⥤ IsoAlgebra E) [PreservesFiniteLimits Q]
    (H : Q ⋙ forget E ≅ forget F ⋙ P)
    (S : ObjectProperty (IsoAlgebra F)) (T : ObjectProperty (IsoAlgebra E))
    (R : S.FullSubcategory ⥤ T.FullSubcategory) (I : R ⋙ T.ι ≅ S.ι ⋙ Q)
    (V : S.FullSubcategory) (G : T.FullSubcategory) (i : G ⟶ R.obj V) [Mono i.hom]
    (J : ObjectProperty (IsoAlgebra F))
    (hJ : J (saturation F L P adj V.obj G.obj.carrier
      ((i.hom ≫ I.hom.app V).hom.f ≫ H.hom.app V.obj)))
    (hS : S (saturation F L P adj V.obj G.obj.carrier
      ((i.hom ≫ I.hom.app V).hom.f ≫ H.hom.app V.obj)))
    (hep : Epi (saturationUnit F L P adj V.obj G.obj.carrier
      ((i.hom ≫ I.hom.app V).hom.f ≫ H.hom.app V.obj))) :
    ∃ (U : S.FullSubcategory) (j : U ⟶ V), Mono j ∧ J U.obj ∧
      ∃ e : R.obj U ≅ G, R.map j = e.hom ≫ i := by
  let i₀ : G.obj ⟶ Q.obj V.obj := i.hom ≫ I.hom.app V
  let s : G.obj.carrier ⟶ P.obj V.obj.carrier := i₀.hom.f ≫ H.hom.app V.obj
  let U₀ := saturation F L P adj V.obj G.obj.carrier s
  let j₀ : U₀ ⟶ V.obj := saturationι F L P adj V.obj G.obj.carrier s
  have : Mono i₀ := by dsimp only [i₀]; infer_instance
  obtain ⟨e₀, he₀⟩ := saturation_restrict_iso F L P adj V.obj E Q H G.obj i₀ hep
  exact fullSubcategory_subobject S T Q R I V G i U₀ j₀ e₀ he₀ hS J hJ

end CategoryTheory.Endofunctor.IsoAlgebra
