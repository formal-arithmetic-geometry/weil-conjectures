/-! # Stalk range of selected integer-labelled generators

Source: Stacks Project, Cohomology, Lemma 0A38, filtration paragraph.
(blueprint: lem-sc-constant-subsheaf-selected-stalk-range).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace TopCat.Sheaf

private theorem integer_hom_mem (α : ULift.{u} ℤ →+ ULift.{u} ℤ)
    (H : AddSubgroup (ULift.{u} ℤ)) (z : ULift.{u} ℤ) (hz : z ∈ H) : α z ∈ H := by
  have he : α z = (α (ULift.up 1)).down • z := by
    have hz : z = z.down • (ULift.up 1 : ULift.{u} ℤ) := by
      apply ULift.ext
      simp
    calc
      α z = z.down • α (ULift.up 1) := by rw [hz, map_zsmul]; simp
      _ = (α (ULift.up 1)).down • z := by
        apply ULift.ext
        simp [mul_comm]
  rw [he]
  exact H.zsmul_mem hz _

private theorem integer_iso_range {M : AddCommGrpCat.{u}}
    (h : M ⟶ AddCommGrpCat.of (ULift.{u} ℤ))
    (e : AddCommGrpCat.of (ULift.{u} ℤ) ≅ AddCommGrpCat.of (ULift.{u} ℤ)) :
    (h ≫ e.hom).hom.range = h.hom.range := by
  apply le_antisymm
  · rintro z ⟨v, rfl⟩
    exact integer_hom_mem e.hom.hom h.hom.range (h v) ⟨v, rfl⟩
  · intro z hz
    have hi := integer_hom_mem e.inv.hom h.hom.range z hz
    obtain ⟨v, hv⟩ := hi
    refine ⟨v, ?_⟩
    change e.hom (h v) = z
    rw [hv]
    exact congrArg (fun k ↦ (ConcreteCategory.hom k) z) e.inv_hom_id

set_option backward.isDefEq.respectTransparency false in
/-- The selected presentation map has stalk range generated by the active selected labels.
Source: Stacks Project, Cohomology, Lemma 0A38, filtration paragraph.
(blueprint: lem-sc-constant-subsheaf-selected-stalk-range).

Proof: The sheaf stalk functor preserves coproducts. By the extension-by-zero stalk
formula, the summand at x is zero if x is outside A i, and is the constant integer
stalk otherwise. The canonical unit germ generates that integer stalk. Naturality
of germs, hsection and hvalue identify the image of that generator with c i under
the canonical constant-sheaf stalk coordinates. The selected map is zero on the
unselected summands. Consequently its range is the subgroup generated by the active
selected labels. Any other isomorphism e x differs from canonical coordinates by
an automorphism of the additive integers. Such an automorphism sends 1 to 1 or -1,
so it preserves every subgroup generated by integer labels. This proves the displayed
formula even for an empty family, no active labels, zero labels, and an empty space.
In Lean we avoid choosing a sign: every additive endomorphism of the integers sends
z to the integer multiple α(1) z, so preserves every subgroup. Applying this to an
isomorphism and its inverse proves invariance of the range. No epimorphism or
monomorphism assumption on the presentation maps is needed. -/
theorem constantSubsheaf_selected_stalk_range
    (X : TopCat.{u}) (K C : Sheaf AddCommGrpCat X) (ι : K ⟶ C)
    (isoC : C ≅ (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ)))
    (n : ℕ) (A : Fin n → Opens X) (c : Fin n → ℕ)
    (g : (∐ fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K)
    (s : ∀ i, K.obj.obj (op (A i)))
    (hsection : ∀ i,
      (Sigma.ι (fun j => (abelianOpenExtensionByZero (A j)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A j)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) i ≫ g).hom.app
        (op (A i))
        (abelianOpenExtensionSection (A i)
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (A i) le_rfl
          ((toSheafify (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            ((Functor.const (Opens ((Opens.toTopCat X).obj (A i)))ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op ((Opens.map (A i).inclusion').obj (A i))) (ULift.up 1))) = s i)
    (hvalue : ∀ i, (ι ≫ isoC.hom).hom.app (op (A i)) (s i) =
      (toSheafify (Opens.grothendieckTopology X)
        ((Functor.const (Opens X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u} ℤ)))).app
          (op (A i)) (ULift.up (c i : ℤ)))
    (P : Fin n → Prop) [DecidablePred P]
    (e : ∀ x : X, TopCat.Presheaf.stalk C.obj x ≅ AddCommGrpCat.of (ULift.{u} ℤ)) :
    let D := fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
    let f : (∐ D) ⟶ K := Sigma.desc (fun i ↦
      if P i then Sigma.ι D i ≫ g else 0)
    ∀ x : X,
      Set.range (fun t : ToType (TopCat.Presheaf.stalk (∐ D).obj x) ↦
        (e x).hom ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
          (f ≫ ι).hom t)) =
      (AddSubgroup.closure {z : ULift.{u} ℤ | ∃ i, x ∈ A i ∧ P i ∧
        z = ULift.up (c i : ℤ)} : Set (ULift.{u} ℤ)) := by
  classical
  dsimp only
  let Z := AddCommGrpCat.of (ULift.{u} ℤ)
  let C0 := (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj Z
  let G (i : Fin n) :=
    (constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
      AddCommGrpCat.{u}).obj Z
  let D (i : Fin n) := (abelianOpenExtensionByZero (A i)).obj (G i)
  let f : (∐ D) ⟶ K := Sigma.desc (fun i ↦
    if P i then Sigma.ι D i ≫ g else 0)
  let δ (i : Fin n) : D i ⟶ C0 := Sigma.ι D i ≫ g ≫ ι ≫ isoC.hom
  let η (i : Fin n) := toSheafify
    (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
    ((Functor.const (Opens ((Opens.toTopCat X).obj (A i)))ᵒᵖ).obj Z)
  obtain ⟨eZ, heZ⟩ := constantSubsheaf_canonical_stalks X Z
  intro x
  let sf := forget AddCommGrpCat.{u} X ⋙
    TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
  let h : sf.obj (∐ D) ⟶ Z := sf.map (f ≫ ι ≫ isoC.hom) ≫ (eZ x).hom
  let S := AddSubgroup.closure
    {z : ULift.{u} ℤ | ∃ i, x ∈ A i ∧ P i ∧ z = ULift.up (c i : ℤ)}
  have hcomponent (i : Fin n) (hx : x ∈ A i) :
      ∃ q : Z ≅ sf.obj (D i),
        (q.hom ≫ sf.map (δ i) ≫ (eZ x).hom) (ULift.up 1) = ULift.up (c i : ℤ) := by
    let xi : A i := ⟨x, hx⟩
    obtain ⟨eG, heG⟩ := constantSubsheaf_canonical_stalks ((Opens.toTopCat X).obj (A i)) Z
    obtain ⟨eD, heD, _, _, _⟩ := abelianOpenExtensionByZero_stalks X (A i)
    let q : Z ≅ sf.obj (D i) := (eG xi).symm.trans (eD xi (G i))
    have hunit : (eG xi).inv = (η i).app
        (op ((Opens.map (A i).inclusion').obj (A i))) ≫
      TopCat.Presheaf.germ (G i).obj ((Opens.map (A i).inclusion').obj (A i)) xi hx := by
      apply (cancel_mono (eG xi).hom).mp
      simp only [Iso.inv_hom_id]
      exact (heG xi ((Opens.map (A i).inclusion').obj (A i)) hx).symm
    have hq : q.hom ≫ sf.map (δ i) ≫ (eZ x).hom =
        (η i).app (op ((Opens.map (A i).inclusion').obj (A i))) ≫
        abelianOpenExtensionSection (A i) (G i) (A i) le_rfl ≫
        (δ i).hom.app (op (A i)) ≫ TopCat.Presheaf.germ C0.obj (A i) x hx ≫
        (eZ x).hom := by
      dsimp only [q, Iso.trans_hom, Iso.symm_hom]
      rw [hunit]
      have hh := congrArg (fun k ↦ k ≫ sf.map (δ i) ≫ (eZ x).hom)
        (heD xi (G i) (A i) le_rfl hx)
      have hh' :
          TopCat.Presheaf.germ (G i).obj ((Opens.map (A i).inclusion').obj (A i))
            xi hx ≫ (eD xi (G i)).hom ≫ sf.map (δ i) ≫ (eZ x).hom =
          abelianOpenExtensionSection (A i) (G i) (A i) le_rfl ≫
            TopCat.Presheaf.germ (D i).obj (A i) x hx ≫ sf.map (δ i) ≫
            (eZ x).hom := by
        simpa only [Category.assoc] using hh
      change (η i).app (op ((Opens.map (A i).inclusion').obj (A i))) ≫
        (TopCat.Presheaf.germ (G i).obj ((Opens.map (A i).inclusion').obj (A i))
          xi hx ≫ (eD xi (G i)).hom ≫ sf.map (δ i) ≫ (eZ x).hom) = _
      rw [hh']
      dsimp only [sf, Functor.comp_map]
      erw [TopCat.Presheaf.stalkFunctor_map_germ_assoc]
      rfl
    refine ⟨q, ?_⟩
    rw [hq]
    change (eZ x).hom (TopCat.Presheaf.germ C0.obj (A i) x hx
      ((ι ≫ isoC.hom).hom.app (op (A i))
        ((Sigma.ι D i ≫ g).hom.app (op (A i))
          (abelianOpenExtensionSection (A i) (G i) (A i) le_rfl
            ((η i).app (op ((Opens.map (A i).inclusion').obj (A i)))
              (ULift.up 1)))))) = ULift.up (c i : ℤ)
    erw [hsection i, hvalue i]
    exact congrArg (fun k ↦ (ConcreteCategory.hom k) (ULift.up (c i : ℤ)))
      (heZ x (A i) hx)
  have hf (i : Fin n) : Sigma.ι D i ≫ f =
      if P i then Sigma.ι D i ≫ g else 0 := by
    simp [f]
  have hsel (i : Fin n) (hi : P i) :
      sf.map (Sigma.ι D i) ≫ h = sf.map (δ i) ≫ (eZ x).hom := by
    dsimp only [h, δ]
    rw [← sf.map_comp_assoc, ← Category.assoc, hf, if_pos hi]
    simp only [Functor.map_comp, Category.assoc]
  have hnsel (i : Fin n) (hi : ¬ P i) : sf.map (Sigma.ι D i) ≫ h = 0 := by
    dsimp only [h]
    rw [← sf.map_comp_assoc, ← Category.assoc, hf, if_neg hi]
    simp
  have hr : h.hom.range = S := by
    apply le_antisymm
    · let π : Z ⟶ AddCommGrpCat.of ((ULift.{u} ℤ) ⧸ S) :=
        AddCommGrpCat.ofHom (QuotientAddGroup.mk' S)
      have hz : h ≫ π = 0 := by
        apply (isColimitOfHasCoproductOfPreservesColimit sf D).hom_ext
        intro k
        let i := k.as
        change sf.map (Sigma.ι D i) ≫ (h ≫ π) = sf.map (Sigma.ι D i) ≫ 0
        simp only [comp_zero, ← Category.assoc]
        by_cases hi : P i
        · by_cases hx : x ∈ A i
          · obtain ⟨q, hq⟩ := hcomponent i hx
            apply (cancel_epi q.hom).mp
            simp only [comp_zero, Category.assoc]
            rw [← Category.assoc (sf.map (Sigma.ι D i)) h π, hsel i hi]
            simp only [← Category.assoc]
            apply constantSubsheaf_integer_hom_zero
            change π ((q.hom ≫ sf.map (δ i) ≫ (eZ x).hom) (ULift.up 1)) = 0
            rw [hq]
            exact (QuotientAddGroup.eq_zero_iff _).mpr
              (AddSubgroup.subset_closure ⟨i, hx, hi, rfl⟩)
          · obtain ⟨_, _, _, hz, _⟩ := abelianOpenExtensionByZero_stalks X (A i)
            exact (hz (G i) x hx).eq_of_src _ _
        · rw [hnsel i hi, zero_comp]
      rintro z ⟨v, rfl⟩
      apply (QuotientAddGroup.eq_zero_iff _).mp
      exact congrArg (fun k ↦ (ConcreteCategory.hom k) v) hz
    · apply (AddSubgroup.closure_le _).mpr
      rintro z ⟨i, hx, hi, rfl⟩
      obtain ⟨q, hq⟩ := hcomponent i hx
      refine ⟨sf.map (Sigma.ι D i) (q.hom (ULift.up 1)), ?_⟩
      change (q.hom ≫ sf.map (Sigma.ι D i) ≫ h) (ULift.up 1) = _
      rw [hsel i hi]
      exact hq
  let ec : sf.obj C ≅ Z := (sf.mapIso isoC).trans (eZ x)
  let a : Z ≅ Z := ec.symm.trans (e x)
  have hh : h = sf.map (f ≫ ι) ≫ ec.hom := by
    simp only [h, ec, Iso.trans_hom, Functor.mapIso_hom, Functor.map_comp, Category.assoc]
  have heq : sf.map (f ≫ ι) ≫ (e x).hom = h ≫ a.hom := by
    rw [hh]
    change sf.map (f ≫ ι) ≫ (e x).hom =
      (sf.map (f ≫ ι) ≫ ec.hom) ≫ (ec.inv ≫ (e x).hom)
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  have ha : (sf.map (f ≫ ι) ≫ (e x).hom).hom.range = S := by
    rw [heq, integer_iso_range h a, hr]
  change Set.range (fun t : ToType (sf.obj (∐ D)) ↦
    (sf.map (f ≫ ι) ≫ (e x).hom) t) = (S : Set (ULift.{u} ℤ))
  exact congrArg SetLike.coe ha

end TopCat.Sheaf
