module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.Topology.Sheaves.Abelian
public import Sheaf.Topology.AbelianOpenExtensionByZero
import Sheaf.Topology.AbelianOpenExtensionByZeroStalks
import Sheaf.Topology.PresheafModuleStalkFunctor

/-! # ConstantSubsheafLowerImageStalks

Source: Stacks Project, Cohomology, Lemma 0A38
(blueprint: lem-sc-constant-subsheaf-lower-image-stalks).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace TopCat.Sheaf

/-- Source: Stacks Project, Cohomology, Lemma 0A38.
Proof: The stalk functor is exact and preserves coproducts and images. A summand
vanishes outside A i and has integer stalk inside A i. By hsection and hvalue its map
into C sends 1 to c i in canonical integer coordinates. Therefore the stalk image of f
is generated by precisely the active labels at most b. If none is active it is zero;
otherwise its positive gcd divides an active label and is at most b. Automorphisms
between canonical coordinates and e are signs, which preserve these subgroups. On V
an active low label exists. The attained divisor supplied by hgcd divides it and hence
is also at most b. It generates the whole K stalk, so l is an isomorphism on V. Outside
U all generating summands and K vanish. Exactness then makes the cokernel stalk zero
on V and outside U. Outside V all components of f are zero, so its image stalk is zero.
This also treats b=0 and the empty family.
(blueprint: lem-sc-constant-subsheaf-lower-image-stalks). -/
theorem constantSubsheaf_lower_image_stalks
    (X : TopCat.{u}) (K C : Sheaf AddCommGrpCat X) (ι : K ⟶ C) [Mono ι]
    (isoC : C ≅ (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ)))
    (n : ℕ) (A : Fin n → Opens X) (c : Fin n → ℕ)
    (g : (∐ fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K) [Epi g]
    (s : ∀ i, K.obj.obj (op (A i)))
    (hsection : ∀ i,
      (Sigma.ι (fun j => (abelianOpenExtensionByZero (A j)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A j)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) i ≫ g).hom.app
        (op (A i))
        (abelianOpenExtensionSection (A i)
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (A i) le_rfl
          ((toSheafify (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            ((Functor.const (Opens ((Opens.toTopCat X).obj (A i)))ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op ((Opens.map (A i).inclusion').obj (A i))) (ULift.up 1))) = s i)
    (hvalue : ∀ i, (ι ≫ isoC.hom).hom.app (op (A i)) (s i) =
      (toSheafify (Opens.grothendieckTopology X)
        ((Functor.const (Opens X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u} ℤ)))).app
          (op (A i)) (ULift.up (c i : ℤ)))
    (b : ℕ) (hc : ∀ i, 0 < c i ∧ c i ≤ b + 1)
    (hgcd : ∀ x : X, x ∈ iSup A →
      ∃ i, x ∈ A i ∧ ∀ j, x ∈ A j → c i ∣ c j)
    (e : ∀ x : X, TopCat.Presheaf.stalk C.obj x ≅ AddCommGrpCat.of (ULift.{u} ℤ)) :
    let D := fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
    let f : (∐ D) ⟶ K := Sigma.desc (fun i ↦
      if c i ≤ b then Sigma.ι D i ≫ g else 0)
    let L := image f
    let l : L ⟶ K := image.ι f
    let U := iSup A
    let V := ⨆ i : Fin n, if c i ≤ b then A i else ⊥
    (∀ x : X, ∃ a : ℕ, a ≤ b ∧
      Set.range (fun t : ToType (TopCat.Presheaf.stalk L.obj x) ↦
        (e x).hom ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
          (l ≫ ι).hom t)) =
      Set.range (fun z : ULift.{u} ℤ ↦ (a : ℤ) • z)) ∧
    (∀ x : X, x ∈ V ∨ x ∉ U →
      IsZero (TopCat.Presheaf.stalk (cokernel l).obj x)) ∧
    (∀ x : X, x ∉ V → IsZero (TopCat.Presheaf.stalk L.obj x)) := by
  sorry

end TopCat.Sheaf
