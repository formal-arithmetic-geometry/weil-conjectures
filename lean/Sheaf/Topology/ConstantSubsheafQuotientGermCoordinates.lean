module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.Topology.Sheaves.Abelian
public import Sheaf.Topology.AbelianOpenExtensionByZero
import Sheaf.Topology.AbelianOpenExtensionByZeroStalks
import Sheaf.Topology.AbelianOpenExtensionIntegerGermCoordinates

/-! # Constant subsheaf quotient germ coordinates

Source: Stacks Project, Cohomology, Lemma 0A38
(blueprint: lem-sc-constant-subsheaf-quotient-germ-coordinates).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace TopCat.Sheaf

/-- Source: Stacks Project, Cohomology, Lemma 0A38, final paragraph.
Proof: At x outside the lower-label union, every active summand has label b+1.
The stalk of the constant integer sheaf is the integers, with the sheafification
unit giving its coordinates. Extension by zero has zero stalk for inactive
indices and integer stalk generated by its unit for active indices. Stalks
preserve the coproduct and the epimorphism g, so the active section germs generate
K_x. Stalks preserve the monomorphism iota. All active germs have image b+1
in the constant integer stalk and thus are equal, by injectivity. Their common
germ has infinite order because b+1 is nonzero. Consequently each element of K_x
has a unique integer coordinate in this generator. Since L_x is zero, exactness
of stalks identifies K_x with the stalk of the cokernel of l, preserving these
coordinates. This also works for b=0; the chosen active index rules out an empty
family and ensures the generator is present.
(blueprint: lem-sc-constant-subsheaf-quotient-germ-coordinates). -/
theorem constantSubsheaf_quotient_germ_coordinates
    (X : TopCat.{u}) (K C : Sheaf AddCommGrpCat X) (ι : K ⟶ C) [Mono ι]
    (isoC : C ≅ (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ)))
    (n : ℕ) (A : Fin n → Opens X) (c : Fin n → ℕ)
    (g : (∐ fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K) [Epi g]
    (s : ∀ i, K.obj.obj (op (A i)))
    (hsection : ∀ i,
      (Sigma.ι (fun j => (abelianOpenExtensionByZero (A j)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A j)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) i ≫ g).hom.app
        (op (A i))
        (abelianOpenExtensionSection (A i)
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (A i) le_rfl
          ((toSheafify (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            ((Functor.const (Opens ((Opens.toTopCat X).obj (A i)))ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op ((Opens.map (A i).inclusion').obj (A i))) (ULift.up 1))) = s i)
    (hvalue : ∀ i, (ι ≫ isoC.hom).hom.app (op (A i)) (s i) =
      (toSheafify (Opens.grothendieckTopology X)
        ((Functor.const (Opens X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u} ℤ)))).app
          (op (A i)) (ULift.up (c i : ℤ)))
    (b : ℕ) (hc : ∀ i, 0 < c i ∧ c i ≤ b + 1)
    (L : Sheaf AddCommGrpCat X) (l : L ⟶ K) [Mono l]
    (x : X) (hxL : IsZero (TopCat.Presheaf.stalk L.obj x))
    (hxV : x ∉ ⨆ j : Fin n, if c j ≤ b then A j else ⊥)
    (i : Fin n) (hxi : x ∈ A i) :
    ∀ t : ↑(TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (cokernel l).obj x),
      ∃! z : ℤ, z • (TopCat.Presheaf.germ (cokernel l).obj (A i) x hxi
        ((cokernel.π l).hom.app (op (A i)) (s i))) = t := by sorry

end TopCat.Sheaf
