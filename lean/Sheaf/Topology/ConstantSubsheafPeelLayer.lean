module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.Topology.Sheaves.Abelian
public import Sheaf.Topology.AbelianOpenExtensionByZero
/-! # One layer of the integer subsheaf filtration

Source: Stacks Project, Cohomology, Lemma 0A38, filtration and final paragraphs
(blueprint: lem-sc-constant-subsheaf-peel-layer).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace TopCat.Sheaf

/-- Remove the layer with positive stalk generator b + 1, retaining finite generation.
The bound is independent of signs in the chosen integer stalk identifications.
This constructs just one subobject and one quotient, not a finite filtration.

Source: Stacks Project, Cohomology, Lemma 0A38, filtration and final paragraphs.
Proof: normalize the finite sections into constant integers on compact clopen pieces,
discard zero sections, and flip signs to make the remaining integers positive. For each
nonempty finite set of indices, adjoin its intersection labelled by the gcd; Bezout
expresses every new section using the old ones. Compactness of intersections uses hqc.
At each point the positive stalk generator is attained by a member of this enlarged
family. Discard
members of value greater than b + 1: the remaining family has the same stalk images,
hence generates K. Let L be generated by members of value at most b. It is finitely
generated on compact opens, its inclusion l is monic, and its positive stalk generator
is at most b. Let U be the union of the remaining opens and V the union for values at
most b. Both are compact and V is contained in U. Gcd closure shows that L and K have
equal stalks on V. On U minus V, K has stalk (b + 1)Z and L has zero stalk; outside U
both vanish. On the union W of the opens of value b + 1, take the class of that integer
in cokernel l. Glue it to zero on V, using the vanishing quotient on the intersection,
to obtain a section on U. This induces the second arrow of a complex whose first arrow
is the canonical inclusion from extension by zero on V to that on U. Their composite
is zero. Extension-by-zero stalks give respectively the identity then zero on V, zero
then the isomorphism Z to (b + 1)Z on U minus V, and the zero complex outside U.
Stalkwise short exactness proves the assertion. If the b + 1 layer is empty, take U = V;
the quotient is zero and the first arrow is identity. No strict inclusion is asserted.
(blueprint: lem-sc-constant-subsheaf-peel-layer). -/
theorem constantSubsheaf_peel_layer
    (X : TopCat.{u})
    (hqc : ∀ U V : Opens X, IsCompact (U : Set X) → IsCompact (V : Set X) →
      IsCompact ((U ⊓ V : Opens X) : Set X))
    (K C : Sheaf AddCommGrpCat X)
    (ι : K ⟶ C)
    [Mono ι]
    (hC : Nonempty (C ≅
      (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))))
    (hgen : ∃ (n : ℕ) (U : Fin n → Opens X)
      (_ : ∀ i, IsCompact ((U i : Opens X) : Set X)),
      ∃ g : (∐ fun i => (abelianOpenExtensionByZero (U i)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (U i)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K, Epi g)
    (e : ∀ x : X, TopCat.Presheaf.stalk C.obj x ≅ AddCommGrpCat.of (ULift.{u} ℤ))
    (b : ℕ)
    (hb : ∀ x : X, ∃ a : ℕ, a ≤ b + 1 ∧
      Set.range (fun t : ToType (TopCat.Presheaf.stalk K.obj x) ↦
        (e x).hom ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map ι.hom t)) =
      Set.range (fun z : ULift.{u} ℤ ↦ (a : ℤ) • z)) :
    ∃ (L : Sheaf AddCommGrpCat X) (l : L ⟶ K), Mono l ∧
      (∃ (n : ℕ) (U : Fin n → Opens X)
      (_ : ∀ i, IsCompact ((U i : Opens X) : Set X)),
      ∃ g : (∐ fun i => (abelianOpenExtensionByZero (U i)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (U i)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ L, Epi g) ∧
      (∀ x : X, ∃ a : ℕ, a ≤ b ∧
      Set.range (fun t : ToType (TopCat.Presheaf.stalk L.obj x) ↦
        (e x).hom ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map (l ≫ ι).hom t)) =
      Set.range (fun z : ULift.{u} ℤ ↦ (a : ℤ) • z)) ∧
      ∃ S : ShortComplex (Sheaf AddCommGrpCat X), S.ShortExact ∧
        ∃ (U V : Opens X),
        IsCompact (U : Set X) ∧ IsCompact (V : Set X) ∧ V ≤ U ∧
        Nonempty (S.X₁ ≅ (abelianOpenExtensionByZero V).obj
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj V))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ∧
        Nonempty (S.X₂ ≅ (abelianOpenExtensionByZero U).obj
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj U))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ∧
        Nonempty (S.X₃ ≅ cokernel l) := by sorry

end TopCat.Sheaf
