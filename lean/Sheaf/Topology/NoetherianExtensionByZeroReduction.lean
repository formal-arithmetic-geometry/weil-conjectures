import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic
import Mathlib.Topology.Sheaves.Abelian
import Mathlib.Topology.Compactness.Compact
import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.HasExt
import Sheaf.Topology.AbelianOpenExtensionByZeroStalks

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace TopCat

/-! # Extension-by-zero reduction for Noetherian cohomology

Source: literature/stacks-project/cohomology.tex, Lemma 02UX.
(blueprint: lem-sc-noetherian-extension-by-zero-reduction).
-/

/-- Vanishing of cohomology for extensions by zero of constant sheaves on
quasi-compact opens implies vanishing for every abelian sheaf.
Source: literature/stacks-project/cohomology.tex, Lemma 02UX.
(blueprint: lem-sc-noetherian-extension-by-zero-reduction).

Proof:
1. Express an arbitrary sheaf as a filtered colimit of subsheaves generated by
   finitely many sections over quasi-compact opens, and use
   `lem-sc-topological-filtered-cohomology`.
2. Induct on the number of generators, using the long exact sequence from
   `def-sc-topological-abelian-cohomology`, reducing to a one-generator sheaf.
3. A one-generator sheaf is a quotient of j_! ℤ_U. Write its kernel K as the
   filtered colimit of finitely generated subsheaves K_λ and form F_λ = j_! ℤ_U / K_λ.
   Exactness of filtered colimits (`lem-weil-pbc-site-abelian-sheaves-filtered-colimits-exact`)
   identifies F with the colimit of F_λ. The filtered-cohomology comparison reduces
   to finitely generated kernels. The long exact sequence reduces vanishing for F_λ
   in degree p > d to vanishing for K_λ in degree p + 1 > d.
4. View K_λ as a subsheaf of the constant integer sheaf, via j_! ℤ_U → ℤ_X,
   and apply `lem-sc-constant-subsheaf-finite-filtration`. Every successive quotient Q
   fits into 0 → j'_! ℤ_V → j_! ℤ_W → Q → 0, with V and W quasi-compact opens.
   The hypothesis and the long exact sequence give vanishing for Q above d.
   Induction along the finite filtration gives vanishing for K_λ above d.
5. Pass from the finitely generated subsheaves to the original sheaf by the
   filtered-colimit comparison.
-/
theorem noetherian_extensionByZero_reduction
    (X : TopCat.{u}) [CompactSpace X]
    (d : ℕ)
    (hbas : ∀ (U : Set X), IsOpen U → ∀ x ∈ U, ∃ V : Set X, IsOpen V ∧
      IsCompact V ∧ x ∈ V ∧ V ⊆ U)
    (hint : ∀ (U V : Set X), IsOpen U → IsOpen V → IsCompact U → IsCompact V →
      IsCompact (U ∩ V))
    (hvanish : ∀ (p : ℕ), d < p → ∀ (U : Opens X), IsCompact (U : Set X) →
      IsZero (CategoryTheory.Sheaf.H'
        ((TopCat.Sheaf.abelianOpenExtensionByZero U).obj
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj U))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) p
        (⊤ : Opens X)))
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    (p : ℕ) (hp : d < p) :
    IsZero (CategoryTheory.Sheaf.H' F p (⊤ : Opens X)) := by
  sorry

end TopCat
