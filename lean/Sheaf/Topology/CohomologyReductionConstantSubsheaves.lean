module

public import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic
public import Mathlib.Topology.Sheaves.Abelian
public import Mathlib.Topology.Compactness.Compact
public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.HasExt
public import Sheaf.Topology.AbelianOpenExtensionByZeroStalks
import Sheaf.Topology.TopologicalFilteredCohomology

/-! # Finite-generation reduction for topological cohomology

Source: Stacks Project, Cohomology, Lemma 02UX, first three paragraphs of the proof.
(blueprint: lem-sc-cohomology-reduction-constant-subsheaves).
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
namespace TopCat

/-- It suffices to control the finitely generated subsheaves of the constant integer sheaf,
 in addition to the compact-open extension-by-zero generators themselves.

Source: Stacks Project, Cohomology, Lemma 02UX
(label `lemma-vanishing-generated-one-section`), first three paragraphs of the proof.
(blueprint: lem-sc-cohomology-reduction-constant-subsheaves).

Proof:
1. Take the directed poset of finite sets of sections of F on quasi-compact opens.
   The corresponding generated subsheaves have colimit F: every germ is represented
   on a basis open, and the inclusions identify precisely the same germs. Apply the
   filtered-cohomology comparison (Stacks 01FF) over X, which is quasi-compact.
2. For a sheaf generated by n sections, the subsheaf generated by the first n-1
   sections has a one-section-generated quotient. The long exact sequence and
   induction on n reduce to a quotient of j_! Z_U. The base n=0 is the zero sheaf.
3. Write its kernel K as the directed union of subsheaves generated by finitely
   many sections on quasi-compact opens. Exactness of filtered colimits identifies
   the quotient with the colimit of j_! Z_U/K_a. The canonical map j_! Z_U to Z_X
   is monic: on U its stalk map is the identity and outside U its source is zero.
   Thus each K_a is a finitely generated subsheaf of Z_X, and hsub applies.
4. For every p>d, the exact segment H^p(j_! Z_U) to H^p(j_! Z_U/K_a) to
   H^(p+1)(K_a) has zero outer terms by hvanish and hsub. Hence every quotient
   stage vanishes. Apply 01FF again, then the finite-generator induction and the
   first directed union, to obtain the assertion for F. -/
theorem noetherian_vanishing_of_constant_subsheaves
    (X : TopCat.{u}) [CompactSpace X]
    (d : ℕ)
    (hbas : ∀ (U : Set X), IsOpen U → ∀ x ∈ U, ∃ V : Set X, IsOpen V ∧
      IsCompact V ∧ x ∈ V ∧ V ⊆ U)
    (hint : ∀ (U V : Set X), IsOpen U → IsOpen V → IsCompact U → IsCompact V →
      IsCompact (U ∩ V))
    (hvanish : ∀ (p : ℕ), d < p → ∀ (U : Opens X), IsCompact (U : Set X) →
      IsZero (CategoryTheory.Sheaf.H'
        ((TopCat.Sheaf.abelianOpenExtensionByZero U).obj
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj U))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) p
        (⊤ : Opens X)))
    (hsub : ∀ (K : X.Sheaf AddCommGrpCat.{u})
      (ι : K ⟶ (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))), Mono ι →
      (∃ (n : ℕ) (U : Fin n → Opens X)
        (_ : ∀ i, IsCompact ((U i : Opens X) : Set X)),
        ∃ g : (∐ fun i ↦ (TopCat.Sheaf.abelianOpenExtensionByZero (U i)).obj
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (U i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K, Epi g) →
      ∀ (q : ℕ), d < q → IsZero (CategoryTheory.Sheaf.H' K q (⊤ : Opens X)))
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    (p : ℕ) (hp : d < p) :
    IsZero (CategoryTheory.Sheaf.H' F p (⊤ : Opens X)) := by sorry

end TopCat
