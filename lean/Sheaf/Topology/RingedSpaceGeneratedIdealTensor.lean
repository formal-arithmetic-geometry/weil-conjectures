@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

namespace AlgebraicGeometry.RingedSpace

set_option autoImplicit false

private theorem mono_range_of_local (X : RingedSpace.{u})
    {F G : SheafOfModules.{u} (moduleRings X)} (i : F ⟶ G) [Mono i]
    (U : Opens X) (s : G.val.obj (op U))
    (h : ∀ x : X, x ∈ U → ∃ (V : Opens X) (hVU : V ≤ U),
      x ∈ V ∧ ∃ t : F.val.obj (op V), i.val.app (op V) t =
        G.val.map (homOfLE hVU).op s) :
    s ∈ Set.range (i.val.app (op U)) := by
  set_option backward.isDefEq.respectTransparency false in
    let q := cokernel.π i
    let H := cokernel i
    have hz : q.val.app (op U) s = 0 := by
      have hc : Presheaf.equalizerSieve (F := H.val.presheaf)
          (q.val.app (op U) s) (0 : H.val.obj (op U)) ∈
          Opens.grothendieckTopology X U := by
        rw [Opens.mem_grothendieckTopology]
        intro x hx
        obtain ⟨V, hVU, hxV, t, ht⟩ := h x hx
        refine ⟨V, homOfLE hVU, ?_, hxV⟩
        change H.val.map (homOfLE hVU).op (q.val.app (op U) s) =
          H.val.map (homOfLE hVU).op 0
        rw [map_zero, ← PresheafOfModules.naturality_apply q.val, ← ht]
        exact congrArg (fun f ↦ f.val.app (op V) t) (cokernel.condition i)
      exact H.isSheaf.isSeparated _ _ hc _ _ (fun _ _ hf ↦ hf)
    let S := ShortComplex.mk i q (cokernel.condition i)
    have he : S.Exact := S.exact_of_g_is_cokernel (cokernelIsCokernel i)
    have he' := he.map_of_mono_of_preservesKernel
      (SheafOfModules.evaluation (moduleRings X) (op U)) inferInstance inferInstance
    exact (ShortComplex.moduleCat_exact_iff _).mp he' s hz

private theorem epi_local_lift (X : RingedSpace.{u})
    {F G : SheafOfModules.{u} (moduleRings X)} (f : F ⟶ G) [Epi f]
    (U : Opens X) (s : G.val.obj (op U)) :
    ∀ x : X, x ∈ U → ∃ (V : Opens X) (hVU : V ≤ U),
      x ∈ V ∧ ∃ t : F.val.obj (op V), f.val.app (op V) t =
        G.val.map (homOfLE hVU).op s := by
  set_option backward.isDefEq.respectTransparency false in
    let adj := PresheafOfModules.sheafificationAdjunction (𝟙 (moduleRings X).obj)
    let q : G ⟶ (PresheafOfModules.sheafification (𝟙 (moduleRings X).obj)).obj (cokernel f.val) :=
      ⟨cokernel.π f.val ≫ adj.unit.app (cokernel f.val)⟩
    obtain ⟨hq, _, hzero⟩ := sheafified_cokernel_local_image X f q rfl
    have hqzero : q = 0 := by
      apply (cancel_epi f).mp
      simpa using hzero
    apply (hq U s).mp
    rw [hqzero]
    rfl

private theorem image_range_local_iff (X : RingedSpace.{u})
    {F G : SheafOfModules.{u} (moduleRings X)} (f : F ⟶ G)
    (U : Opens X) (s : G.val.obj (op U)) :
    s ∈ Set.range ((image.ι f).val.app (op U)) ↔
      ∀ x : X, x ∈ U → ∃ (V : Opens X) (hVU : V ≤ U),
        x ∈ V ∧ ∃ t : F.val.obj (op V), f.val.app (op V) t =
          G.val.map (homOfLE hVU).op s := by
  set_option backward.isDefEq.respectTransparency false in
    constructor
    · rintro ⟨t, rfl⟩ x hx
      obtain ⟨V, hVU, hxV, z, hz⟩ := epi_local_lift X (factorThruImage f) U t x hx
      refine ⟨V, hVU, hxV, z, ?_⟩
      have hf := congrArg (fun g ↦ g.val.app (op V) z) (image.fac f)
      change (image.ι f).val.app (op V) ((factorThruImage f).val.app (op V) z) =
        f.val.app (op V) z at hf
      rw [← hf, hz, PresheafOfModules.naturality_apply]
    · intro h
      apply mono_range_of_local X (image.ι f) U s
      intro x hx
      obtain ⟨V, hVU, hxV, t, ht⟩ := h x hx
      refine ⟨V, hVU, hxV, (factorThruImage f).val.app (op V) t, ?_⟩
      exact (congrArg (fun g ↦ g.val.app (op V) t) (image.fac f)).trans ht

private theorem tensor_local_lift (X : RingedSpace.{u})
    (F G : SheafOfModules.{u} (moduleRings X))
    (U : Opens X) (s : ((SheafOfModules.siteSheafTensorRight G).obj F).val.obj (op U)) :
    ∀ x : X, x ∈ U → ∃ (V : Opens X) (hVU : V ≤ U), x ∈ V ∧
      ∃ t : TensorProduct (X.sheaf.obj.obj (op V))
        (F.val.obj (op V)) (G.val.obj (op V)),
        ((PresheafOfModules.sheafificationAdjunction (𝟙 (moduleRings X).obj)).unit.app
          (SheafOfModules.siteTensorPresheaf F.val G.val)).app (op V) t =
            ((SheafOfModules.siteSheafTensorRight G).obj F).val.map (homOfLE hVU).op s := by
  set_option backward.isDefEq.respectTransparency false in
    let P := SheafOfModules.siteTensorPresheaf F.val G.val
    have hc := Presheaf.imageSieve_mem (Opens.grothendieckTopology X)
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X) P.presheaf) s
    rw [Opens.mem_grothendieckTopology] at hc
    intro x hx
    obtain ⟨V, i, hi, hxV⟩ := hc x hx
    exact ⟨V, i.le, hxV, hi⟩

/-- Tensor multiplication realizes the ideal subsheaf generated by an O-linear map.
The section set of the categorical image is the range of the image inclusion, not
necessarily the range of multiplication on sections of the original open. An ideal
subsheaf in the minimality clause is represented by a module sheaf with a monomorphism
into the algebra whose sectionwise ranges are ideals.

Source: Stacks Project, Properties, Tag 05JS (the B_i-ideal generated by F_{i,j});
Sheaves, Tags 007Z, 0085, 0089; Modules, Section 01AF; Modules on Sites, Section 03EK.
(blueprint: lem-weil-pbc-ringed-space-generated-ideal-tensor)

Proof: (1) The pairing (b,s) ↦ b e(s) is O-bilinear and compatible with restrictions,
by commutativity of B and linearity and naturality of e. The tensor universal property
[lem-pc-sites-sheaf-tensor-bilinear-universal] gives the unique multiplication map.
(2) By [lem-pc-presheaf-module-sheafification-ring], the underlying abelian sheaf of
the tensor is the sheafification of the sectionwise tensor presheaf. Its stalks agree
with those of that presheaf [lem-weil-pbc-stalk-sheafification-space], so each tensor
section is locally a finite sum of pure tensors, including the empty sum for zero.
(3) Module sheaves form an abelian category [def-weil-sheaf-of-modules-category];
the image is the kernel of the sheafified sectionwise cokernel. The local-image
criterion [lem-weil-pbc-sheaf-cokernel-local-image] identifies its sections with
sections locally lifting to the tensor. (4) Applying (2) to those local lifts and
then (1) proves the displayed finite-sum criterion. Conversely, a finite sum lifts
to the corresponding sum of pure tensors. (5) Zero, addition, negation and
multiplication by a B-section preserve that local criterion: intersect the
representing neighbourhoods, concatenate sums, negate coefficients, and multiply
coefficients respectively. Hence the sectionwise image is an ideal. (6) The
one-term expression 1 e(s) includes every e(s). Any ideal subsheaf containing all
such e(s) contains every local finite sum; its sheaf axiom glues these local
memberships, since its inclusion is injective. This proves minimality, also on
the empty open using its empty covering. -/
theorem exists_generatedIdeal_tensor (X : RingedSpace.{u}) (A : Under X.sheaf)
    (E : ringedSiteModules.{u} (moduleRings X))
    (e : E ⟶ commAlgebraSheafModule X.sheaf A) :
    ∃ μ : (SheafOfModules.siteSheafTensorRight E).obj
        (commAlgebraSheafModule X.sheaf A) ⟶ commAlgebraSheafModule X.sheaf A,
      (∀ (U : Opens X) (b : A.right.obj.obj (op U)) (s : E.val.obj (op U)),
        μ.val.app (op U) (SheafOfModules.siteSheafTensorTmul
          (commAlgebraSheafModule X.sheaf A) E (op U) b s) =
            b * @id (A.right.obj.obj (op U)) (e.val.app (op U) s)) ∧
      (∀ ν : (SheafOfModules.siteSheafTensorRight E).obj
          (commAlgebraSheafModule X.sheaf A) ⟶ commAlgebraSheafModule X.sheaf A,
        (∀ (U : Opens X) (b : A.right.obj.obj (op U)) (s : E.val.obj (op U)),
          ν.val.app (op U) (SheafOfModules.siteSheafTensorTmul
            (commAlgebraSheafModule X.sheaf A) E (op U) b s) =
              b * @id (A.right.obj.obj (op U)) (e.val.app (op U) s)) → ν = μ) ∧
      (∀ U : Opens X, ∃ I : Ideal (A.right.obj.obj (op U)),
        (I : Set (A.right.obj.obj (op U))) =
          Set.range (fun t ↦ (image.ι μ).val.app (op U) t)) ∧
      (∀ (U : Opens X) (a : A.right.obj.obj (op U)),
        a ∈ Set.range (fun t ↦ (image.ι μ).val.app (op U) t) ↔
          ∀ x : X, x ∈ U → ∃ (V : Opens X) (hVU : V ≤ U), x ∈ V ∧
            ∃ (n : ℕ) (b : Fin n → A.right.obj.obj (op V))
              (s : Fin n → E.val.obj (op V)),
              A.right.obj.map (homOfLE hVU).op a =
                ∑ j, b j * @id (A.right.obj.obj (op V)) (e.val.app (op V) (s j))) ∧
      (∀ (U : Opens X) (s : E.val.obj (op U)),
        e.val.app (op U) s ∈ Set.range (fun t ↦ (image.ι μ).val.app (op U) t)) ∧
      (∀ (K : ringedSiteModules.{u} (moduleRings X))
          (ι : K ⟶ commAlgebraSheafModule X.sheaf A), Mono ι →
        (∀ U : Opens X, ∃ J : Ideal (A.right.obj.obj (op U)),
          (J : Set (A.right.obj.obj (op U))) =
            Set.range (fun t ↦ ι.val.app (op U) t)) →
        (∀ (U : Opens X) (s : E.val.obj (op U)),
          e.val.app (op U) s ∈ Set.range (fun t ↦ ι.val.app (op U) t)) →
        ∀ U : Opens X,
          Set.range (fun t ↦ (image.ι μ).val.app (op U) t) ⊆
            Set.range (fun t ↦ ι.val.app (op U) t)) := by
  set_option backward.isDefEq.respectTransparency false in
    classical
    let B := commAlgebraSheafModule X.sheaf A
    let P := SheafOfModules.siteTensorPresheaf B.val E.val
    let β (U : (Opens X)ᵒᵖ) :
        B.val.obj U →ₗ[X.sheaf.obj.obj U] E.val.obj U →ₗ[X.sheaf.obj.obj U] B.val.obj U :=
      { toFun := fun b ↦
          { toFun := fun s ↦ @id (A.right.obj.obj U) b * @id (A.right.obj.obj U) (e.val.app U s)
            map_add' := by
              intro s t
              change A.right.obj.obj U at b
              change @id (A.right.obj.obj U) b * (@id (A.right.obj.obj U) (e.val.app U (s + t))) =
                b * @id (A.right.obj.obj U) (e.val.app U s) +
                  b * @id (A.right.obj.obj U) (e.val.app U t)
              rw [map_add]
              change b * (@id (A.right.obj.obj U) (e.val.app U s) +
                @id (A.right.obj.obj U) (e.val.app U t)) = _
              exact mul_add _ _ _
            map_smul' := by
              intro r s
              rw [map_smul]
              change A.right.obj.obj U at b
              change b * ((A.hom.hom.app U r) * @id (A.right.obj.obj U) (e.val.app U s)) =
                (A.hom.hom.app U r) *
                (@id (A.right.obj.obj U) b * @id (A.right.obj.obj U) (e.val.app U s))
              exact mul_left_comm _ _ _ }
        map_add' := by
          intro b c
          change A.right.obj.obj U at b c
          ext s
          change (@id (A.right.obj.obj U) b + c) * @id (A.right.obj.obj U) (e.val.app U s) =
            b * @id (A.right.obj.obj U) (e.val.app U s) +
              c * @id (A.right.obj.obj U) (e.val.app U s)
          exact add_mul _ _ _
        map_smul' := by
          intro r b
          change A.right.obj.obj U at b
          ext s
          change ((A.hom.hom.app U r) * b) * @id (A.right.obj.obj U) (e.val.app U s) =
            (A.hom.hom.app U r) *
                (@id (A.right.obj.obj U) b * @id (A.right.obj.obj U) (e.val.app U s))
          exact mul_assoc _ _ _ }
    let p : P ⟶ B.val :=
      { app := fun U ↦ ModuleCat.ofHom (X := P.obj U) (Y := B.val.obj U)
          (TensorProduct.lift (M := B.val.obj U) (N := E.val.obj U) (β U))
        naturality := by
          intro U V f
          apply ModuleCat.hom_ext
          apply TensorProduct.ext'
          intro b s
          symm
          change B.val.map f (@id (A.right.obj.obj U) b * @id (A.right.obj.obj U) (e.val.app U s)) =
            @id (A.right.obj.obj V) (B.val.map f b) *
              @id (A.right.obj.obj V) (e.val.app V (E.val.map f s))
          change A.right.obj.map f
            (@id (A.right.obj.obj U) b * @id (A.right.obj.obj U) (e.val.app U s)) = _
          rw [map_mul, PresheafOfModules.naturality_apply e.val]
          rfl }
    let adj := PresheafOfModules.sheafificationAdjunction (𝟙 (moduleRings X).obj)
    let μ : (SheafOfModules.siteSheafTensorRight E).obj B ⟶ B :=
      (adj.homEquiv P B).symm p
    have hμp : adj.unit.app P ≫ μ.val = p := by
      exact (adj.homEquiv P B).apply_symm_apply p
    have hμ (U : Opens X) (b : A.right.obj.obj (op U)) (s : E.val.obj (op U)) :
        μ.val.app (op U) (SheafOfModules.siteSheafTensorTmul B E (op U) b s) =
          b * @id (A.right.obj.obj (op U)) (e.val.app (op U) s) := by
      exact congrArg (fun f ↦ f.app (op U) (b ⊗ₜ[X.sheaf.obj.obj (op U)] s)) hμp
    have hchar (U : Opens X) (a : A.right.obj.obj (op U)) :
        a ∈ Set.range ((image.ι μ).val.app (op U)) ↔
          ∀ x : X, x ∈ U → ∃ (V : Opens X) (hVU : V ≤ U), x ∈ V ∧
            ∃ (n : ℕ) (b : Fin n → A.right.obj.obj (op V))
              (s : Fin n → E.val.obj (op V)),
              A.right.obj.map (homOfLE hVU).op a =
                ∑ j, b j * @id (A.right.obj.obj (op V)) (e.val.app (op V) (s j)) := by
      rw [image_range_local_iff X μ]
      constructor
      · intro h x hx
        obtain ⟨W, hWU, hxW, t, ht⟩ := h x hx
        obtain ⟨V, hVW, hxV, z, hz⟩ := tensor_local_lift X B E W t x hxW
        obtain ⟨n, b, s, hs⟩ := TensorProduct.exists_sum_tmul_eq z
        refine ⟨V, hVW.trans hWU, hxV, n, b, s, ?_⟩
        have hp := congrArg (fun f ↦ f.app (op V) z) hμp
        change μ.val.app (op V) ((adj.unit.app P).app (op V) z) =
          TensorProduct.lift (M := B.val.obj (op V)) (β (op V)) z at hp
        rw [hz, PresheafOfModules.naturality_apply μ.val, ht] at hp
        change B.val.map (homOfLE hVW).op (B.val.map (homOfLE hWU).op a) = _ at hp
        rw [← B.val.map_comp_apply] at hp
        change B.val.map (homOfLE (hVW.trans hWU)).op a = _ at hp
        change B.val.map (homOfLE (hVW.trans hWU)).op a = _
        rw [hp, hs, map_sum]
        rfl
      · intro h x hx
        obtain ⟨V, hVU, hxV, n, b, s, hs⟩ := h x hx
        refine ⟨V, hVU, hxV,
          ∑ j, SheafOfModules.siteSheafTensorTmul B E (op V) (b j) (s j), ?_⟩
        rw [map_sum]
        erw [hs]
        exact Finset.sum_congr rfl (fun j _ ↦ hμ V (b j) (s j))
    refine ⟨μ, hμ, ?_, ?_, hchar, ?_, ?_⟩
    · intro ν hν
      apply (adj.homEquiv P B).injective
      rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit]
      apply PresheafOfModules.hom_ext
      intro U
      apply ModuleCat.hom_ext
      apply TensorProduct.ext'
      intro b s
      exact (hν U.unop b s).trans (hμ U.unop b s).symm
    · intro U
      let M := LinearMap.range ((image.ι μ).val.app (op U)).hom
      refine ⟨{ carrier := Set.range ((image.ι μ).val.app (op U))
                zero_mem' := M.zero_mem
                add_mem' := M.add_mem
                smul_mem' := ?_ }, rfl⟩
      intro c a ha
      apply (hchar U (c * a)).mpr
      intro x hx
      obtain ⟨V, hVU, hxV, n, b, s, hs⟩ := (hchar U a).mp ha x hx
      refine ⟨V, hVU, hxV, n,
        fun j ↦ A.right.obj.map (homOfLE hVU).op c * b j, s, ?_⟩
      rw [map_mul, hs, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ ↦ (mul_assoc _ _ _).symm)
    · intro U s
      refine ⟨(factorThruImage μ).val.app (op U)
        (SheafOfModules.siteSheafTensorTmul B E (op U) (1 : A.right.obj.obj (op U)) s), ?_⟩
      have hf := congrArg (fun f ↦ f.val.app (op U)
        (SheafOfModules.siteSheafTensorTmul B E (op U)
          (1 : A.right.obj.obj (op U)) s)) (image.fac μ)
      change _ = μ.val.app (op U) (SheafOfModules.siteSheafTensorTmul B E (op U)
        (1 : A.right.obj.obj (op U)) s) at hf
      change (image.ι μ).val.app (op U)
        ((factorThruImage μ).val.app (op U)
          (SheafOfModules.siteSheafTensorTmul B E (op U)
            (1 : A.right.obj.obj (op U)) s)) = _ at hf
      exact hf.trans ((hμ U 1 s).trans
        (one_mul (@id (A.right.obj.obj (op U)) (e.val.app (op U) s))))
    · intro K ι hmono hideal hcontains U a ha
      have : Mono ι := hmono
      apply mono_range_of_local X ι U a
      intro x hx
      obtain ⟨V, hVU, hxV, n, b, s, hs⟩ := (hchar U a).mp ha x hx
      obtain ⟨J, hJ⟩ := hideal V
      have hj : ∑ j, b j * @id (A.right.obj.obj (op V)) (e.val.app (op V) (s j)) ∈ J := by
        apply J.sum_mem
        intro j _
        apply J.mul_mem_left
        change @id (A.right.obj.obj (op V)) (e.val.app (op V) (s j)) ∈ (J : Set _)
        rw [hJ]
        exact hcontains V (s j)
      rw [← hs] at hj
      change A.right.obj.map (homOfLE hVU).op a ∈
        (J : Set (A.right.obj.obj (op V))) at hj
      rw [hJ] at hj
      exact ⟨V, hVU, hxV, hj⟩

end AlgebraicGeometry.RingedSpace
