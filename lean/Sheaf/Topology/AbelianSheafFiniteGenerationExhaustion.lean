module

public import Mathlib.Topology.Sheaves.Abelian
public import Mathlib.Topology.Compactness.Compact
public import Sheaf.Topology.AbelianOpenExtensionByZero
import Sheaf.Topology.AbelianOpenExtensionByZeroStalks

/-! # AbelianSheafFiniteGenerationExhaustion

Source: Stacks Project, Cohomology, Lemma 02UX.
(blueprint: lem-sc-abelian-sheaf-finite-generation-exhaustion).
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
namespace TopCat

/-- Every abelian sheaf is a directed colimit of subsheaves generated by finitely many
sections on quasi-compact opens.

Source: Stacks Project, Cohomology, Lemma 02UX
(label `lemma-vanishing-generated-one-section`), first paragraph of the proof.

Proof:
1. Let S be the disjoint union of F(U) over the quasi-compact opens U. Take the
   nonempty directed poset of finite subsets A of S, ordered by inclusion.
2. Each section determines a map from the integer extension by zero E_U, by the
   extension-by-zero adjunction and the constant-sheaf adjunction. Define D(A) as
   the image of the sum of these finitely many maps into F. This supplies the
   asserted monomorphism and the epimorphism from a finite coproduct.
3. Inclusions A ⊆ B give compatible inclusions D(A) → D(B). Every germ of F can
   be represented on a quasi-compact basis open, and occurs in a singleton stage.
4. To check the colimit universal property, take a cocone from D to a sheaf T.
   For s ∈ F(V), cover V by quasi-compact basis opens W. The restriction s|W
   lifts to the singleton stage indexed by (W, s|W); apply that cocone map.
   Two choices give equal sections locally: pass to the union of their finite
   index sets and use the monomorphism of that stage into F. Therefore the
   sections in T agree on overlaps and glue uniquely on V. The same argument
   using unions of finite index sets proves additivity, restriction compatibility
   and uniqueness, giving the required sheaf morphism F → T. The empty stage
   is zero, so this also covers F = 0 and the empty space.
(blueprint: lem-sc-abelian-sheaf-finite-generation-exhaustion). -/
theorem abelianSheaf_finiteGeneration_exhaustion
    (X : TopCat.{u})
    (hbas : ∀ (U : Set X), IsOpen U → ∀ x ∈ U, ∃ V : Set X, IsOpen V ∧
      IsCompact V ∧ x ∈ V ∧ V ⊆ U)
    (F : X.Sheaf AddCommGrpCat.{u}) :
    ∃ (I : Type u) (_ : Preorder I) (_ : Nonempty I) (_ : IsDirected I (· ≤ ·))
      (D : I ⥤ X.Sheaf AddCommGrpCat.{u}) (c : D ⟶ (Functor.const I).obj F),
      Nonempty (IsColimit (Cocone.mk F c)) ∧
      ∀ i : I, Mono (c.app i) ∧
      (∃ (n : ℕ) (U : Fin n → Opens X)
        (_ : ∀ i, IsCompact ((U i : Opens X) : Set X)),
        ∃ g : (∐ fun i ↦
          (TopCat.Sheaf.abelianOpenExtensionByZero (U i)).obj
          ((constantSheaf
            (Opens.grothendieckTopology ((Opens.toTopCat X).obj (U i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ (D.obj i), Epi g) := by
  sorry

end TopCat
