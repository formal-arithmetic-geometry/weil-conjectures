module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.Topology.Sheaves.Abelian
public import Sheaf.Topology.AbelianOpenExtensionByZero
import Sheaf.Topology.ConstantSubsheafSelectedStalkRange

/-! # Retaining an active divisor preserves a presentation epimorphism

Source: Stacks Project, Cohomology, Lemma 0A38, normalized generators and filtration.
(blueprint: lem-sc-constant-subsheaf-divisor-subfamily-epi)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace TopCat.Sheaf

/-- Retain a subfamily containing an active divisor of every active label at each point.
Source: Stacks Project, Cohomology, Lemma 0A38, normalized generators and filtration.
(blueprint: lem-sc-constant-subsheaf-divisor-subfamily-epi)

Proof: The range of the original stalk map into the constant integer sheaf is the
subgroup generated by the active labels. The reindexed coproduct map has range generated
by the retained active labels, by the same selected-stalk-range formula. The latter
subgroup is contained in the former. Conversely, a retained active divisor generates
all original active labels by integer multiples, so the ranges coincide. The original
map is epi, hence surjective on stalks, and the inclusion of K is injective on stalks.
Range equality therefore makes the retained map surjective on stalks. Its cokernel has
zero stalks and is zero; the retained map is epi. If there are no active labels both
subgroups are zero, and the same reasoning works. Repetitions in q are harmless. -/
theorem constantSubsheaf_divisor_subfamily_epi
    (X : TopCat.{u}) (K C : Sheaf AddCommGrpCat X) (ι : K ⟶ C) [Mono ι]
    (isoC : C ≅ (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ)))
    (n : ℕ) (A : Fin n → Opens X) (c : Fin n → ℕ)
    (g : (∐ fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K)
    (_hg : Epi g)
    (s : ∀ i, K.obj.obj (op (A i)))
    (hsection : ∀ i,
      (Sigma.ι (fun j => (abelianOpenExtensionByZero (A j)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A j)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) i ≫ g).hom.app
        (op (A i))
        (abelianOpenExtensionSection (A i)
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (A i) le_rfl
          ((toSheafify (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            ((Functor.const (Opens ((Opens.toTopCat X).obj (A i)))ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op ((Opens.map (A i).inclusion').obj (A i))) (ULift.up 1))) = s i)
    (hvalue : ∀ i, (ι ≫ isoC.hom).hom.app (op (A i)) (s i) =
      (toSheafify (Opens.grothendieckTopology X)
        ((Functor.const (Opens X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u} ℤ)))).app
          (op (A i)) (ULift.up (c i : ℤ)))
    (m : ℕ) (q : Fin m → Fin n)
    (hretain : ∀ x : X, x ∈ iSup A →
      ∃ k, x ∈ A (q k) ∧ ∀ j, x ∈ A j → c (q k) ∣ c j)
    (e : ∀ x : X, TopCat.Presheaf.stalk C.obj x ≅ AddCommGrpCat.of (ULift.{u} ℤ)) :
    let D := fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
    Epi (Sigma.desc (fun k ↦ Sigma.ι D (q k) ≫ g)) := by
  classical
  let D := fun i => (abelianOpenExtensionByZero (A i)).obj
    ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
  let f : (∐ fun k ↦ D (q k)) ⟶ K :=
    Sigma.desc (fun k ↦ Sigma.ι D (q k) ≫ g)
  change Epi f
  have hsf : ∀ k,
      (Sigma.ι (fun k ↦ D (q k)) k ≫ f).hom.app (op (A (q k)))
        (abelianOpenExtensionSection (A (q k))
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A (q k))))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (A (q k)) le_rfl
          ((toSheafify (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A (q k))))
            ((Functor.const (Opens ((Opens.toTopCat X).obj (A (q k))))ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op ((Opens.map (A (q k)).inclusion').obj (A (q k)))) (ULift.up 1))) =
        s (q k) := by
    intro k
    simpa only [f, Sigma.ι_desc] using hsection (q k)
  have hg' : Sigma.desc (fun i ↦ if True then Sigma.ι D i ≫ g else 0) = g := by
    apply Sigma.hom_ext
    intro i
    simp
  have hf' : Sigma.desc (fun k ↦
      if True then Sigma.ι (fun k ↦ D (q k)) k ≫ f else 0) = f := by
    apply Sigma.hom_ext
    intro k
    simp
  apply Preadditive.epi_of_isZero_cokernel
  apply (isZero_iff_stalkFunctor_obj_isZero (cokernel f)).mpr
  intro x
  let F := forget AddCommGrpCat X ⋙ TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
  have hr := constantSubsheaf_selected_stalk_range X K C ι isoC n A c g s
    hsection hvalue (fun _ ↦ True) e x
  have hs := constantSubsheaf_selected_stalk_range X K C ι isoC m
    (fun k ↦ A (q k)) (fun k ↦ c (q k)) f (fun k ↦ s (q k)) hsf
    (fun k ↦ hvalue (q k)) (fun _ ↦ True) e x
  change Set.range (fun t ↦ (e x).hom
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((Sigma.desc (fun i ↦ if True then Sigma.ι D i ≫ g else 0)) ≫ ι).hom t)) = _ at hr
  rw [hg'] at hr
  change Set.range (fun t ↦ (e x).hom
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((Sigma.desc (fun k ↦
        if True then Sigma.ι (fun k ↦ D (q k)) k ≫ f else 0)) ≫ ι).hom t)) = _ at hs
  rw [hf'] at hs
  simp only [true_and] at hr hs
  have he : AddSubgroup.closure {z : ULift.{u} ℤ | ∃ i, x ∈ A i ∧
        z = ULift.up (c i : ℤ)} =
      AddSubgroup.closure {z : ULift.{u} ℤ | ∃ k, x ∈ A (q k) ∧
        z = ULift.up (c (q k) : ℤ)} := by
    apply le_antisymm
    · apply (AddSubgroup.closure_le _).mpr
      rintro z ⟨i, hi, rfl⟩
      obtain ⟨k, hk, hd⟩ := hretain x (Opens.mem_iSup.mpr ⟨i, hi⟩)
      obtain ⟨a, ha⟩ := hd i hi
      have hmem : ULift.up (c (q k) : ℤ) ∈ AddSubgroup.closure
          {z : ULift.{u} ℤ | ∃ k, x ∈ A (q k) ∧
            z = ULift.up (c (q k) : ℤ)} :=
        AddSubgroup.subset_closure ⟨k, hk, rfl⟩
      have hm := (AddSubgroup.closure _).zsmul_mem hmem (a : ℤ)
      have hz : (ULift.up (c i : ℤ) : ULift.{u} ℤ) =
          (a : ℤ) • ULift.up (c (q k) : ℤ) := by
        apply ULift.ext
        simp [ha, mul_comm]
      rw [hz]
      exact hm
    · apply AddSubgroup.closure_mono
      rintro z ⟨k, hk, hz⟩
      exact ⟨q k, hk, hz⟩
  have : F.PreservesEpimorphisms :=
    NormalMonoCategory.preservesEpimorphisms_of_preservesCokernels F
  have hp : Function.Surjective (F.map g) :=
    (AddCommGrpCat.epi_iff_surjective _).mp (inferInstance : Epi (F.map g))
  have hi : Function.Injective (fun t ↦ (e x).hom (F.map ι t)) :=
    (AddCommGrpCat.mono_iff_injective _).mp
      (inferInstance : Mono (F.map ι ≫ (e x).hom))
  have hsurj : Function.Surjective (F.map f) := by
    intro t
    obtain ⟨v, hv⟩ := hp t
    have ht : (e x).hom (F.map ι t) ∈
        Set.range (fun v ↦ (e x).hom (F.map (g ≫ ι) v)) := by
      refine ⟨v, ?_⟩
      simp only [Functor.map_comp, AddCommGrpCat.comp_apply, hv]
    change (e x).hom (F.map ι t) ∈ Set.range (fun v ↦
      (e x).hom ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
        (g ≫ ι).hom v)) at ht
    rw [hr, he, ← hs] at ht
    obtain ⟨w, hw⟩ := ht
    refine ⟨w, hi ?_⟩
    change (e x).hom (F.map (f ≫ ι) w) = (e x).hom (F.map ι t) at hw
    simpa only [Functor.map_comp, AddCommGrpCat.comp_apply] using hw
  have : Epi (F.map f) := (AddCommGrpCat.epi_iff_surjective _).mpr hsurj
  exact (isZero_cokernel_of_epi (F.map f)).of_iso (PreservesCokernel.iso F f)

end TopCat.Sheaf
