module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.Topology.Sheaves.Abelian
public import Sheaf.Topology.AbelianOpenExtensionByZero
import Sheaf.Topology.ConstantSheafLocallyConstantComparison
import Sheaf.Topology.AbelianOpenExtensionByZeroStalks

/-! # Positive generators with attained divisors

Source: Stacks Project, Cohomology, Lemma 0A38, first two proof paragraphs.
https://stacks.math.columbia.edu/tag/0A38
(blueprint: lem-sc-constant-subsheaf-unbounded-normalization)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace TopCat.Sheaf

/-- A finite positive constant presentation with an attained divisor at every active point.
Source: Stacks Project, Cohomology, Lemma 0A38, first two proof paragraphs.
(blueprint: lem-sc-constant-subsheaf-unbounded-normalization)

Proof: Take the finite compact-open presentation in hgen and evaluate each component
on the canonical unit section. Under isoC its image is a locally constant integer
function. Each compact open splits into finitely many clopen fibres of this function;
these fibres are compact in X. Restrict the section to each fibre. Omit the zero fibres
(their sections vanish by the monomorphism), and negate negative sections and their
component maps. These operations preserve the stalk subgroup generated by the family.
For each nonempty subset of the remaining finite family, add the intersection of its
opens and the positive gcd of its labels. These intersections are compact, by induction
using hqc, with a nonempty subset ensuring that no compactness of X is required.
An integer Bezout combination of the restricted sections gives the gcd section in K.
Its image under the monomorphism is the constant gcd section. The universal property
of the constant sheaf and extension by zero gives the component map whose unit image
is that section. Form the coproduct map. The original generators remain, and all new
sections lie in their generated stalk subgroup, so this map is epi on every stalk,
hence epi as a sheaf map. At a point with active generators, intersect precisely their
original opens: the adjoined gcd divides every original active label and every adjoined
active gcd, and is itself active. Thus the attained-divisor condition holds. If the
original stalk is zero, no nonzero fibre contains the point. The empty generating family
produces n=0; an empty intersection is never adjoined. This result has no stalk bound:
labels may be arbitrarily large. -/
theorem constantSubsheaf_unbounded_normalization
    (X : TopCat.{u}) (K C : Sheaf AddCommGrpCat X) (ι : K ⟶ C) [Mono ι]
    (isoC : C ≅ (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ)))
    (hqc : ∀ U V : Opens X, IsCompact (U : Set X) → IsCompact (V : Set X) →
      IsCompact ((U ⊓ V : Opens X) : Set X))
    (hgen : ∃ (n : ℕ) (U : Fin n → Opens X)
      (_ : ∀ i, IsCompact ((U i : Opens X) : Set X)),
      ∃ g : (∐ fun i => (abelianOpenExtensionByZero (U i)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (U i)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K, Epi g) :
    ∃ (n : ℕ) (A : Fin n → Opens X) (_ : ∀ i, IsCompact (A i : Set X))
      (c : Fin n → ℕ), (∀ i, 0 < c i) ∧
      ∃ (g : (∐ fun i => (abelianOpenExtensionByZero (A i)).obj
      ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ K), Epi g ∧
        ∃ s : ∀ i, K.obj.obj (op (A i)),
          ( ∀ i,
      (Sigma.ι (fun j => (abelianOpenExtensionByZero (A j)).obj
        ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A j)))
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) i ≫ g).hom.app
        (op (A i))
        (abelianOpenExtensionSection (A i)
          ((constantSheaf (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (A i) le_rfl
          ((toSheafify (Opens.grothendieckTopology ((Opens.toTopCat X).obj (A i)))
            ((Functor.const (Opens ((Opens.toTopCat X).obj (A i)))ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op ((Opens.map (A i).inclusion').obj (A i))) (ULift.up 1))) = s i) ∧
          ( ∀ i, (ι ≫ isoC.hom).hom.app (op (A i)) (s i) =
      (toSheafify (Opens.grothendieckTopology X)
        ((Functor.const (Opens X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u} ℤ)))).app
          (op (A i)) (ULift.up (c i : ℤ))) ∧
          (∀ x : X, x ∈ iSup A →
            ∃ i, x ∈ A i ∧ ∀ j, x ∈ A j → c i ∣ c j)  := by
  sorry

end TopCat.Sheaf
