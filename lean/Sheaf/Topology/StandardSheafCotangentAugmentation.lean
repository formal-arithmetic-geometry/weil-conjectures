/-!
# The standard sheaf cotangent augmentation

Source: Stacks Project, cotangent.tex, Tags 08PN, 08QF, 08SS, 08UR and 08UV;
sites-modules.tex, Tags 08TP and 08TQ
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation).

The canonical chain maps are characterized on all standard differential tensors.
The ring presentation records the image of the actual first differential, rather
than substituting a different two-term cotangent complex. Naturality is an equality
of chain maps, including continuous inverse image and ordinary scalar extension.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace Simplicial
open Algebra.CotangentResolution
open scoped ChangeOfRings

namespace TopCat.SheafCotangent

variable [∀ B : CommRingCat.{u}, HasDerivedCategory.{u + 1} (ModuleCat.{u} B)]

/-- The free module on the symbols `δ_b`, for the explicit face presentation.
Source: Stacks 08PN and 08QF
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
abbrev cotangentSymbols (f : Arrow CommRingCat.{u}) := f.right →₀ f.right

/-- A face relation, with the sign in the displayed cokernel presentation.
The finite sum includes every variable occurring in the polynomial.
Source: Stacks 08PN, standard faces, and 00RX
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def cotangentFaceRelation (f : Arrow CommRingCat.{u})
    (p : MvPolynomial f.right f.left) : cotangentSymbols f :=
  Finsupp.single (standardAugmentation f 0 p) 1 -
    ∑ b ∈ p.vars, (standardAugmentation f 0 (MvPolynomial.pderiv b p)) •
      Finsupp.single b 1

/-- The submodule generated by the first-face relations.
Source: Stacks 08PN and 08QF
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def cotangentFaceRelations (f : Arrow CommRingCat.{u}) :
    Submodule f.right (cotangentSymbols f) :=
  Submodule.span f.right (Set.range (cotangentFaceRelation f))

/-- The additivity, Leibniz and base-annihilation relation submodule. This is
Mathlib's `KaehlerDifferential.kerTotal` for the algebra structure given by `f`,
spanned by `d(b+c) - db - dc`, `d(bc) - b dc - c db` and `d(f a)`, up to sign.
Source: Stacks 07BK and 08TP
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
abbrev cotangentDerivationRelations (f : Arrow CommRingCat.{u}) :
    Submodule f.right (cotangentSymbols f) :=
  letI := f.hom.hom.toAlgebra
  KaehlerDifferential.kerTotal f.left f.right

/-- The ring differential module placed in degree zero.
Source: Stacks 08QF
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def ringOmegaComplex (f : Arrow CommRingCat.{u}) :=
  (HomologicalComplex.single (ModuleCat.{u} f.right) (.up ℤ) 0).obj
    (CommRingCat.KaehlerDifferential f.hom)

/-- The canonical degree-zero coordinate of the ring differential complex.
Source: Stacks 08QF
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def ringOmegaZero (f : Arrow CommRingCat.{u}) :=
  (HomologicalComplex.singleObjXSelf (.up ℤ) 0
    (CommRingCat.KaehlerDifferential f.hom)).hom

/-- The existing sheafification of sectionwise differentials, placed in degree zero.
Source: Stacks 08TP and 08UR
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def sheafOmegaComplex {T : TopCat.{u}} (f : Arrow (T.Sheaf CommRingCat.{u})) :=
  (HomologicalComplex.single
    (ringedSiteModules.{u} (CategoryTheory.SheafDifferentials.ring f.right)) (.up ℤ) 0).obj
      (CategoryTheory.SheafDifferentials.omega f.hom)

/-- The canonical degree-zero coordinate of the sheaf differential complex.
Source: Stacks 08UR
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def sheafOmegaZero {T : TopCat.{u}} (f : Arrow (T.Sheaf CommRingCat.{u})) :=
  (HomologicalComplex.singleObjXSelf (.up ℤ) 0
    (CategoryTheory.SheafDifferentials.omega f.hom)).hom

/-- Forget the coefficients of the degree-zero differential complex.
Source: Stacks 08SV and 08TQ
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
def additiveOmegaComplex {T : TopCat.{u}} (f : Arrow (T.Sheaf CommRingCat.{u})) :=
  ((SheafOfModules.toSheaf (CategoryTheory.SheafDifferentials.ring f.right)).mapHomologicalComplex
    (.up ℤ)).obj (sheafOmegaComplex f)

/-- The ring augmentation, normalized on every tensor, together with the actual
first-differential presentation. The basis is fixed by `δ_b = dx_b ⊗ 1`.
Its cokernel property identifies the quotient with differentials, sending `δ_b`
to `db`; equality of submodules asserts exactly the three derivation relations.
Source: Stacks 08PN, 08QF, 07BK and 00RX
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
structure RingCotangentAugmentation (C : Coherence.{u}) (f : Arrow CommRingCat.{u}) where
  map : standardComplex C f ⟶ ringOmegaComplex f
  formula : ∀ (r : f.right) (p : (C.standard f).algebra.obj (op ⦋0⦌)),
    ringOmegaZero f (map.f 0 (complexGenerator (C.differentials (C.standard f)) 0 r p)) =
      r • CommRingCat.KaehlerDifferential.d ((C.standard f).augmentation.app (op ⦋0⦌) p)
  negative : ∀ (i : ℤ), i < 0 → map.f i = 0
  symbols : ModuleCat.of f.right (cotangentSymbols f) ≅ (standardComplex C f).X 0
  symbols_formula : ∀ b : f.right, symbols.hom (Finsupp.single b 1) =
    variableDifferential C f 0 b
  first_differential : ∀ p : MvPolynomial f.right f.left,
    (standardComplex C f).d (-1) 0 (variableDifferential C f 1 p) =
      -symbols.hom (cotangentFaceRelation f p)
  image : LinearMap.range
      ((symbols.inv.hom).comp ((standardComplex C f).d (-1) 0).hom) =
    cotangentFaceRelations f
  relations : cotangentFaceRelations f = cotangentDerivationRelations f
  cokernel : ∃ h : (standardComplex C f).d (-1) 0 ≫ (map.f 0 ≫ ringOmegaZero f) = 0,
    Nonempty (IsColimit (CokernelCofork.ofπ (map.f 0 ≫ ringOmegaZero f) h))
  h0 : IsIso (HomologicalComplex.homologyMap map 0)

/-- The augmentation and all its compatibilities on the already recorded standard
models. Ring squares over a continuous map include ordinary ring squares and open
restriction. Their differential arrows are fixed on universal differentials.
The adjoint inverse-image differential arrow is an isomorphism, and the full chain
square commutes. Applying zeroth homology gives naturality of the induced H0
isomorphism, with the exact inverse-image comparison from Stacks 08TQ.
Source: Stacks 08QF, 08SS, 08SV, 08UR, 08UV, 08TP and 08TQ
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation). -/
structure StandardCotangentAugmentation (C : Coherence.{u}) (S : Comparison C) where
  rings : ∀ f : Arrow CommRingCat.{u}, RingCotangentAugmentation C f
  map : ∀ {T : TopCat.{u}} (f : Arrow (T.Sheaf CommRingCat.{u})),
    standardSheafComplex C S f ⟶ sheafOmegaComplex f
  formula : ∀ (T : TopCat.{u}) (f : Arrow (T.Sheaf CommRingCat.{u}))
    (V : (Opens T)ᵒᵖ) (r : f.right.obj.obj V)
    (p : (C.standard (sectionArrow f V)).algebra.obj (op ⦋0⦌)),
    (sheafOmegaZero f).val.app V (((map f).f 0).val.app V
      (sectionElement (S.sheaves T f).sections V 0
        (complexGenerator (C.differentials (C.standard (sectionArrow f V))) 0 r p))) =
      r • (CategoryTheory.SheafDifferentials.derivation f.hom).d
        ((C.standard (sectionArrow f V)).augmentation.app (op ⦋0⦌) p)
  negative : ∀ (T : TopCat.{u}) (f : Arrow (T.Sheaf CommRingCat.{u})) (i : ℤ),
    i < 0 → (map f).f i = 0
  section_augmentation : ∀ (T : TopCat.{u}) (f : Arrow (T.Sheaf CommRingCat.{u}))
    (V : (Opens T)ᵒᵖ) (x : (standardComplex C (sectionArrow f V)).X 0),
    (sheafOmegaZero f).val.app V (((map f).f 0).val.app V
      (sectionElement (S.sheaves T f).sections V 0 x)) =
      (((PresheafOfModules.sheafificationAdjunction.{u, u, u, u}
        (𝟙 (CategoryTheory.SheafDifferentials.ring f.right).obj)).unit.app
          (PresheafOfModules.DifferentialsConstruction.relativeDifferentials'
            f.hom.hom)).app V)
        (ringOmegaZero (sectionArrow f V) ((rings (sectionArrow f V)).map.f 0 x))
  h0 : ∀ (T : TopCat.{u}) (f : Arrow (T.Sheaf CommRingCat.{u})),
    IsIso (HomologicalComplex.homologyMap (map f) 0)
  differential : ∀ {T T' : TopCat.{u}} {v : T' ⟶ T}
    {f : Arrow (T.Sheaf CommRingCat.{u})} {g : Arrow (T'.Sheaf CommRingCat.{u})}
    (_q : RingSquare v f g),
    additiveOmegaComplex f ⟶ (pushforwardComplex v).obj (additiveOmegaComplex g)
  differential_formula : ∀ {T T' : TopCat.{u}} {v : T' ⟶ T}
    {f : Arrow (T.Sheaf CommRingCat.{u})} {g : Arrow (T'.Sheaf CommRingCat.{u})}
    (q : RingSquare v f g) (V : (Opens T)ᵒᵖ) (b : f.right.obj.obj V),
    (sheafOmegaZero g).val.app ((Opens.map v).op.obj V)
      (((differential q).f 0).hom.app V
        ((HomologicalComplex.singleObjXSelf (.up ℤ) 0
          (CategoryTheory.SheafDifferentials.omega f.hom)).inv.val.app V
            ((CategoryTheory.SheafDifferentials.derivation f.hom).d b))) =
      (CategoryTheory.SheafDifferentials.derivation g.hom).d (q.right.hom.app V b)
  differential_scalar : ∀ {T T' : TopCat.{u}} {v : T' ⟶ T}
    {f : Arrow (T.Sheaf CommRingCat.{u})} {g : Arrow (T'.Sheaf CommRingCat.{u})}
    (q : RingSquare v f g) (V : (Opens T)ᵒᵖ) (r : f.right.obj.obj V)
    (x : ((sheafOmegaComplex f).X 0).val.obj V),
    (((differential q).f 0).hom.app V) (r • x) =
      @SMul.smul (g.right.obj.obj ((Opens.map v).op.obj V))
        (((sheafOmegaComplex g).X 0).val.obj ((Opens.map v).op.obj V)) inferInstance
          (q.right.hom.app V r) ((((differential q).f 0).hom.app V) x)
  naturality : ∀ {T T' : TopCat.{u}} {v : T' ⟶ T}
    {f : Arrow (T.Sheaf CommRingCat.{u})} {g : Arrow (T'.Sheaf CommRingCat.{u})}
    (q : RingSquare v f g),
    ((SheafOfModules.toSheaf _).mapHomologicalComplex (.up ℤ)).map (map f) ≫
        differential q =
      (S.maps q).map ≫ (pushforwardComplex v).map
        (((SheafOfModules.toSheaf _).mapHomologicalComplex (.up ℤ)).map (map g))
  h0_naturality : ∀ {T T' : TopCat.{u}} {v : T' ⟶ T}
    {f : Arrow (T.Sheaf CommRingCat.{u})} {g : Arrow (T'.Sheaf CommRingCat.{u})}
    (q : RingSquare v f g),
    HomologicalComplex.homologyMap
        (((SheafOfModules.toSheaf _).mapHomologicalComplex (.up ℤ)).map (map f)) 0 ≫
        HomologicalComplex.homologyMap (differential q) 0 =
      HomologicalComplex.homologyMap (S.maps q).map 0 ≫
        HomologicalComplex.homologyMap ((pushforwardComplex v).map
          (((SheafOfModules.toSheaf _).mapHomologicalComplex (.up ℤ)).map (map g))) 0
  inverse_differentials : ∀ {T T' : TopCat.{u}} (v : T' ⟶ T)
    (f : Arrow (T.Sheaf CommRingCat.{u})),
    IsIso (((inverseAdjunction v).homEquiv _ _).symm
      (differential (inverseImageSquare v f)))
  inverse_naturality : ∀ {T T' : TopCat.{u}} (v : T' ⟶ T)
    (f : Arrow (T.Sheaf CommRingCat.{u})),
    (pullbackComplex v).map
        (((SheafOfModules.toSheaf _).mapHomologicalComplex (.up ℤ)).map (map f)) ≫
        ((inverseAdjunction v).homEquiv _ _).symm
          (differential (inverseImageSquare v f)) =
      inverseStandardMap C S v f ≫
        ((SheafOfModules.toSheaf _).mapHomologicalComplex (.up ℤ)).map
          (map (inverseImageArrow v f))
  scalar : ∀ {T : TopCat.{u}} {f g : Arrow (T.Sheaf CommRingCat.{u})} (q : f ⟶ g)
    [HasDerivedCategory.{u + 1}
      (ringedSiteModules.{u} (CategoryTheory.SheafDifferentials.ring f.right))]
    [HasDerivedCategory.{u + 1}
      (ringedSiteModules.{u} (CategoryTheory.SheafDifferentials.ring g.right))]
    (D : SheafOfModules.DerivedChangeOfRingsCochainModel.{u, u, u, u + 1, u + 1} q.right)
    (l : StandardLinearization C S q D),
    ∃ b : (D.E.mapHomologicalComplex (.up ℤ)).obj (sheafOmegaComplex f) ⟶
        sheafOmegaComplex g,
      (∀ (V : (Opens T)ᵒᵖ) (r : g.right.obj.obj V) (s : f.right.obj.obj V),
        (sheafOmegaZero g).val.app V ((b.f 0).val.app V
          ((eqToHom (D.obj_eq ((sheafOmegaComplex f).X 0)).symm).val.app V
            (scalarExtensionSection q.right ((sheafOmegaComplex f).X 0) V r
              ((HomologicalComplex.singleObjXSelf (.up ℤ) 0
                (CategoryTheory.SheafDifferentials.omega f.hom)).inv.val.app V
                  ((CategoryTheory.SheafDifferentials.derivation f.hom).d s))))) =
          r • (CategoryTheory.SheafDifferentials.derivation g.hom).d (q.right.hom.app V s)) ∧
      (D.E.mapHomologicalComplex (.up ℤ)).map (map f) ≫ b = l.map ≫ map g

/-- The standard cotangent augmentation induces the canonical H0 isomorphism,
with its explicit face presentation and all square, inverse-image and scalar
compatibilities. The data `C` and `S` are the already specified canonical models;
there is no flatness assumption on any ring map.
Source: Stacks 08PN, 08QF, 08SS, 08SV, 08UR, 08UV, 08TP and 08TQ
(blueprint: lem-sfb-standard-sheaf-cotangent-augmentation).

Proof:
1. In the ring standard resolution, use lem-trf-cotangent-resolution-coherence
   for P0 = A[x_b], P1 = A[y_p], and the two faces y_p to p and x_(epsilon p).
   By lem-weil-pbc-polynomial-ring-kahler-basis-any-variables the first differential
   sends dy_p tensor 1 to the negative of cotangentFaceRelation p. Its image
   therefore gives precisely the displayed cokernel presentation.
2. The A-derivation p to d(epsilon p) gives the balanced linear map
   r tensor dp to r d(epsilon p), by def-weil-pbc-kahler-differentials.
   Both faces have the same image. Their difference is killed; taking zero in
   negative degrees gives the chain augmentation.
3. Substitute p = x_b + x_c, x_b*x_c, and a constant a. The resulting face
   relations are exactly additivity, Leibniz and vanishing on A, up to sign.
   This works for coincident labels and in characteristic two.
4. Conversely repeated Leibniz differentiates each monomial, counting repeated
   variables with multiplicity; the constant monomial contributes zero. Summing
   gives the partial-derivative formula for every polynomial. Thus the two
   relation submodules agree. The cokernel is the universal differential module,
   with delta_b sent to db. Positive terms vanish, so this is the induced H0 map.
5. Use lem-trf-affine-cotangent-comparison for sectionwise standard complexes.
   The formulas respect restrictions, so sheafify the augmentation. By
   lem-trf-sheafified-module-differentials-cokernel its target and derivation
   are the existing omega and derivation. By the adjunction of
   def-weil-presheaf-modules-sheafification, sheafification preserves cokernels:
   maps out of either cokernel are exactly maps killing the first differential.
   Hence the sheaf augmentation induces the asserted H0 isomorphism.
6. In any ring square, the standard map of
   lem-sfb-standard-sheaf-cotangent-flat-functorial-model sends dp tensor r to
   d(p') tensor beta(r), with epsilon(p') = beta(epsilon(p)). Both routes
   therefore give beta(r) d(beta(epsilon(p))); negative components are zero.
   The differential map is fixed by db to d(beta(b)), with restricted scalars.
7. Apply lem-trf-topos-inverse-image-differentials and the normalized inverse
   comparison of lem-trf-affine-cotangent-comparison. They preserve universal
   derivations, polynomial augmentations and tensor generators, giving the
   inverse-image chain square. By lem-pc-inverse-image-module-functor-exact,
   continuous inverse image preserves the H0 cokernel, giving H0 naturality.
8. For A to B to C, extend the universal derivation by c tensor db to c d(j(b)).
   Balancing holds since both c*j(b0) tensor db and c tensor b0*db map to
   c*j(b0)*d(j(b)). The two chain composites send (dp tensor r) tensor c to
   c*j(r)*d(j(epsilon(p))). Negative components are zero. This uses ordinary
   tensor products only, with no flatness requirement. The same calculation
   works for a general base-changing square, as already included in step 6.
-/
theorem exists_standardCotangentAugmentation (C : Coherence.{u}) (S : Comparison C) :
    Nonempty (StandardCotangentAugmentation C S) := by
  sorry

end TopCat.SheafCotangent
