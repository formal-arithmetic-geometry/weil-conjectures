module

public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Sheaf.RingTheory.StrictlyStandardElement
public import Sheaf.RingTheory.SingularIdeal
import Sheaf.RingTheory.DesingularizeStrictlyStandard
import Sheaf.RingTheory.PopescuLiftingWitness
import Sheaf.RingTheory.SingularIdealLocalizationSmooth

/-!
# Lifting a factorization modulo pi^8 (Popescu)

Source: Stacks Project, Smoothing Ring Maps, Lemma Tag 07F0 (blueprint:
`lem-weil-pbc-popescu-desingularize-lifting-apply`).

## Main statements

* `popescu_desingularize_lifting_apply`.
-/

@[expose] public section

universe u v w z

namespace Algebra

/-- Popescu's desingularization lifting lemma, in the modulo `π ^ 8` form.
The quotient algebra structures `R ⧸ (π ^ 8) → A ⧸ (π ^ 8) A` and
`R ⧸ (π ^ 8) → Λ ⧸ (π ^ 8) Λ` are Mathlib's `Ideal.Quotient.algebraQuotientMapQuotient`;
clause (a) uses the algebra structure of `Localization.awayMap`, and clause (b) is the
containment in the image of the radical of the ideal of `Λ` generated by `β (H_{B/R})`.

Source: Stacks Project, Smoothing Ring Maps, Lemma Tag 07F0
(blueprint: lem-weil-pbc-popescu-desingularize-lifting-apply).

Proof (the eight steps of the node):
1. From `Ann(π) = Ann(π²)` in `R` and in `Λ`, induction gives `Ann(πⁿ) = Ann(π)` for
`n ≥ 1`, so `π' = π⁴` satisfies `Ann(π') = Ann(π'²)` in `R` and `Λ`, and `π'² = π⁸`.
2. Apply lem-weil-pbc-popescu-lifting (07CP) to `R`, `Λ`, `π⁴` and
`R/π⁸R → C̄ → Λ/π⁸Λ`: a finitely presented `R`-algebra `D`, `δ : D → Λ` and
`ρ : C̄ → D/π⁴D` compatible with the maps to `Λ/π⁴Λ`, with `R → D` smooth at primes not
containing `π`, and smooth at primes `q ∋ π⁴` with `ρ⁻¹(q/π⁴D)` a smooth prime of `C̄`.
3. The composite `A → A/π⁸A → C̄ → D/π⁴D` factors through an `R`-algebra map
`A/π⁴A → D/π⁴D` compatible with the maps to `Λ/π⁴Λ`.
4. Apply lem-weil-pbc-popescu-desingularize-strictly-standard (07CT) to `α` and `δ`:
a finitely presented `R`-algebra `B`, `β : B → Λ`, `A → B`, `D → B` with
`β ∘ (A → B) = α`, `β ∘ (D → B) = δ` and `H_{D/R} B ⊆ H_{B/R}`.
5. Every prime containing `H_{D/R}` contains `π` (step 2), so `π ∈ H_{D/R}` (radical),
hence the image of `π` lies in `H_{B/R}` and `π⁸Λ ⊆ J := H_{B/R}Λ`
(def-weil-pbc-singular-ideal, lem-weil-pbc-zero-locus-eq-iff-radical-eq).
6. (a): `B_π` is smooth over `R` (lem-weil-pbc-singular-ideal-localization-smooth); base
change to `R_π` and `B_π ⊗_R R_π ≅ B_π` give smoothness of `R_π → B_π`
(lem-weil-pbc-smooth-ring-map-base-change-composition, lem-weil-pbc-localization-base-change).
7. For a prime `p ⊇ J` of `Λ`, the inverse image of `p/π⁸Λ` in `C̄` contains
`H_{C̄/(R/π⁸R)}`: otherwise step 2 makes `R → D` smooth at `δ⁻¹(p)`, giving `d ∈ H_{D/R}`
with `δ(d) ∉ p`, while `δ(d) = β(d_B) ∈ J ⊆ p` by step 4.
8. (b): by step 7 every lift of an element of the image of `H_{C̄/(R/π⁸R)}` lies in every
prime containing `J`, hence in `√J`; the image of `√J` in `Λ/π⁸Λ` is an ideal, so it
contains the generated ideal.
-/
theorem popescu_desingularize_lifting_apply
    (R : Type u) (A : Type v) (Λ : Type w)
    [CommRing R] [CommRing A] [CommRing Λ]
    [Algebra R A] [Algebra R Λ] [IsNoetherianRing R]
    (π : R)
    (hAnnR : Module.annihilator R (Ideal.span ({π} : Set R)) =
      Module.annihilator R (Ideal.span ({π ^ 2} : Set R)))
    (hAnnΛ : Module.annihilator Λ (Ideal.span ({algebraMap R Λ π} : Set Λ)) =
      Module.annihilator Λ (Ideal.span ({(algebraMap R Λ π) ^ 2} : Set Λ)))
    (α : A →ₐ[R] Λ) [FinitePresentation R A]
    (hstandard : IsStrictlyStandardElement (R := R) (algebraMap R A π))
    (C : Type z) [CommRing C]
    [Algebra (R ⧸ Ideal.span ({π ^ 8} : Set R)) C]
    [FinitePresentation (R ⧸ Ideal.span ({π ^ 8} : Set R)) C]
    (σ : (A ⧸ Ideal.map (algebraMap R A) (Ideal.span ({π ^ 8} : Set R)))
      →ₐ[R ⧸ Ideal.span ({π ^ 8} : Set R)] C)
    (τ : C →ₐ[R ⧸ Ideal.span ({π ^ 8} : Set R)]
      (Λ ⧸ Ideal.map (algebraMap R Λ) (Ideal.span ({π ^ 8} : Set R))))
    (hfactor : ∀ a : A,
      τ (σ (Ideal.Quotient.mk
        (Ideal.map (algebraMap R A) (Ideal.span ({π ^ 8} : Set R))) a)) =
        Ideal.Quotient.mk
          (Ideal.map (algebraMap R Λ) (Ideal.span ({π ^ 8} : Set R))) (α a)) :
    ∃ (B : Type (max u v w z)) (_ : CommRing B) (_ : Algebra R B),
      FinitePresentation R B ∧
      ∃ (β : B →ₐ[R] Λ) (aB : A →ₐ[R] B),
        β.comp aB = α ∧
        @Smooth (Localization.Away π) _ (Localization.Away (algebraMap R B π)) _
          (Localization.awayMap (algebraMap R B) π).toAlgebra ∧
        Ideal.map τ.toRingHom (singularIdeal (R ⧸ Ideal.span ({π ^ 8} : Set R)) C) ≤
          Ideal.map
            (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (Ideal.span ({π ^ 8} : Set R))))
            (Ideal.map β.toRingHom (singularIdeal R B)).radical := by
  obtain ⟨D, instD, instRD, hfpD, δ, hquot, hπD, hsingD⟩ :=
    popescu_lifting_witness R A Λ π hAnnR hAnnΛ α C σ τ hfactor
  let : CommRing D := instD
  let : Algebra R D := instRD
  let : FinitePresentation R D := hfpD
  have hR : ∀ r : R, r * π = 0 ↔ r * π ^ 2 = 0 := by
    intro r
    have h := SetLike.ext_iff.mp hAnnR r
    change r ∈ (Ideal.span ({π} : Set R)).annihilator ↔
      r ∈ (Ideal.span ({π ^ 2} : Set R)).annihilator at h
    simpa only [Submodule.mem_annihilator_span_singleton, smul_eq_mul] using h
  have hΛ : ∀ l : Λ, l * algebraMap R Λ π = 0 ↔
      l * (algebraMap R Λ π) ^ 2 = 0 := by
    intro l
    have h := SetLike.ext_iff.mp hAnnΛ l
    change l ∈ (Ideal.span ({algebraMap R Λ π} : Set Λ)).annihilator ↔
      l ∈ (Ideal.span ({(algebraMap R Λ π) ^ 2} : Set Λ)).annihilator at h
    simpa only [Submodule.mem_annihilator_span_singleton, smul_eq_mul] using h
  obtain ⟨B, instB, instRB, hfpB, β, aB, dB, ha, hd, _, hHD⟩ :=
    exists_desingularization_strictlyStandard R Λ A D π α δ hR hΛ hstandard hquot
  let : CommRing B := instB
  let : Algebra R B := instRB
  let : FinitePresentation R B := hfpB
  have hπB : algebraMap R B π ∈ singularIdeal R B := by
    rw [← dB.commutes π]
    exact hHD (Ideal.mem_map_of_mem dB.toRingHom hπD)
  have : Smooth R (Localization.Away (algebraMap R B π)) :=
    smooth_localization_of_mem_singularIdeal R B _ hπB
  have hsmooth :
      @Smooth (Localization.Away π) _ (Localization.Away (algebraMap R B π)) _
        (Localization.awayMap (algebraMap R B) π).toAlgebra := by
    let : Algebra (Localization.Away π) (Localization.Away (algebraMap R B π)) :=
      (Localization.awayMap (algebraMap R B) π).toAlgebra
    have : IsScalarTower R (Localization.Away π)
        (Localization.Away (algebraMap R B π)) := by
      apply IsScalarTower.of_algebraMap_eq
      intro r
      change algebraMap B _ (algebraMap R B r) =
        Localization.awayMap (algebraMap R B) π (algebraMap R _ r)
      simp [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq]
    have : FormallyUnramified R (Localization.Away π) :=
      FormallyUnramified.of_isLocalization (Submonoid.powers π)
    exact ⟨FormallySmooth.of_restrictScalars R (Localization.Away π)
        (Localization.Away (algebraMap R B π)),
      FinitePresentation.of_restrict_scalars_finitePresentation R (Localization.Away π)
        (Localization.Away (algebraMap R B π))⟩
  refine ⟨B, instB, instRB, hfpB, β, aB, ha, hsmooth, ?_⟩
  apply hsingD.trans
  apply Ideal.map_mono
  apply Ideal.radical_mono
  calc
    Ideal.map δ.toRingHom (singularIdeal R D) =
        Ideal.map β.toRingHom (Ideal.map dB.toRingHom (singularIdeal R D)) := by
      rw [Ideal.map_map]
      change Ideal.map δ.toRingHom (singularIdeal R D) =
        Ideal.map (β.comp dB).toRingHom (singularIdeal R D)
      rw [hd]
    _ ≤ Ideal.map β.toRingHom (singularIdeal R B) := Ideal.map_mono hHD

end Algebra
