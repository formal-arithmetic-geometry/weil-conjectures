module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.MvPowerSeries.Equiv
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic

/-! # Completion of a monomial quotient at the coordinate origin

Source: Stacks Project, Algebra, Section 00M9, with Tag 0315 as supporting context;
the explicit coefficient and fraction calculation in the DAG node
(blueprint: lem-sfb-monomial-local-completion).

The auxiliary abbreviations name the actual polynomial ideal, its extension to power
series, the coordinate ideals, and the localization and completion. The statement includes
normal representatives, the canonical polynomial normalization, and both compatible systems
of finite quotients. No choice of an unspecified comparison map is used.
-/

@[expose] public section

set_option autoImplicit false

universe u

noncomputable section

namespace MonomialLocalCompletion

/-- The finitely generated polynomial monomial ideal `J`.
Source: Stacks, Algebra 00M9, explicit monomial calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev polynomialIdeal (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) : Ideal (MvPolynomial (Fin r) k) :=
  Ideal.span (Set.range (fun i ↦ MvPolynomial.monomial (α i) (1 : k)))

/-- The actual extended ideal `J k[[T]]`, using the polynomial inclusion.
Source: Stacks, Algebra 00M9, explicit monomial calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev seriesIdeal (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) : Ideal (MvPowerSeries (Fin r) k) :=
  (polynomialIdeal k α).map MvPolynomial.coeToMvPowerSeries.ringHom

/-- The polynomial quotient `A = P/J`.
Source: Stacks, Algebra 00M9, explicit monomial calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev PolynomialQuotient (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) :=
  MvPolynomial (Fin r) k ⧸ polynomialIdeal k α

/-- The series quotient `Q = k[[T]]/J k[[T]]`.
Source: Stacks, Algebra 00M9, explicit monomial calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev SeriesQuotient (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) :=
  MvPowerSeries (Fin r) k ⧸ seriesIdeal k α

/-- The coordinate ideal `m` of the polynomial quotient.
Source: Stacks, Algebra 00M9, explicit monomial calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev polynomialOrigin (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) : Ideal (PolynomialQuotient k α) :=
  (MvPolynomial.idealOfVars (Fin r) k).map (Ideal.Quotient.mk (polynomialIdeal k α))

/-- The coordinate ideal `n` of the series quotient.
Source: Stacks, Algebra 00M9, explicit monomial calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev seriesOrigin (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) : Ideal (SeriesQuotient k α) :=
  Ideal.span (Set.range (fun i : Fin r ↦
    Ideal.Quotient.mk (seriesIdeal k α) (MvPowerSeries.X i)))

/-- The localization `A_p`, used at the prime whose ideal is the coordinate origin.
Source: Stacks, Algebra 00M9, explicit fraction calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev LocalRing (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) (p : PrimeSpectrum (PolynomialQuotient k α)) :=
  Localization.AtPrime p.asIdeal

/-- The maximal-ideal-adic completion of the actual localization `A_p`.
Source: Stacks, Algebra 00M9, compatible inverse-limit description
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev CompleteLocalRing (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) (p : PrimeSpectrum (PolynomialQuotient k α)) :=
  AdicCompletion (IsLocalRing.maximalIdeal (LocalRing k α p)) (LocalRing k α p)

/-- A polynomial class mapped to its germ and then to the completion.
Source: Stacks, Algebra 00M9, canonical map to the inverse limit
(blueprint: lem-sfb-monomial-local-completion). -/
def completedGerm (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) (p : PrimeSpectrum (PolynomialQuotient k α))
    (a : PolynomialQuotient k α) : CompleteLocalRing k α p :=
  algebraMap (LocalRing k α p) (CompleteLocalRing k α p)
    (algebraMap (PolynomialQuotient k α) (LocalRing k α p) a)

/-- The ideal generated by coordinate germs in the completed local ring.
Source: Stacks, Algebra 00M9, explicit coordinate calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev completedOrigin (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) (p : PrimeSpectrum (PolynomialQuotient k α)) :
    Ideal (CompleteLocalRing k α p) :=
  Ideal.span (Set.range (fun i : Fin r ↦
    completedGerm k α p (Ideal.Quotient.mk (polynomialIdeal k α) (MvPolynomial.X i))))

/-- The finite polynomial quotient `B_N = P/(J + (T)^N)`.
Source: Stacks, Algebra 00M9, explicit truncation calculation in the node
(blueprint: lem-sfb-monomial-local-completion). -/
abbrev FiniteQuotient (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) (N : ℕ) :=
  MvPolynomial (Fin r) k ⧸
    (polynomialIdeal k α ⊔ MvPolynomial.idealOfVars (Fin r) k ^ N)

/-- The canonical polynomial transition `B_M → B_N` for `N ≤ M`.
Source: Stacks, Algebra 00M9, compatible quotient sequences
(blueprint: lem-sfb-monomial-local-completion). -/
def finiteTransition (k : Type u) [Field k] {r s : ℕ}
    (α : Fin s → (Fin r →₀ ℕ)) {N M : ℕ} (h : N ≤ M) :
    FiniteQuotient k α M →+* FiniteQuotient k α N :=
  Ideal.Quotient.factor (sup_le_sup_left (Ideal.pow_le_pow_right h) (polynomialIdeal k α))

/-- Completion of a monomial quotient, including its normal forms and all positive
finite-level comparisons.

Source: Stacks, Algebra Section 00M9, Tag 0315 as supporting context; the explicit
coefficientwise calculation of this DAG node
(blueprint: lem-sfb-monomial-local-completion).

Proof plan (the eight steps of the node):
1. In `B_N`, the surviving monomials are exactly the exponents not divisible by a generator
   and of total degree less than `N`. Evaluation at zero gives `A/m = k`, so `m` is maximal.
2. A series lies in the extended monomial ideal exactly when its coefficients outside the
   upper set `D` vanish: partition each exponent in `D` by the least dividing generator,
   and factor that generator. Deleting the `D` coefficients gives the unique normal form.
3. Partition exponents of degree at least `N` by a dividing degree-`N` monomial. The finite
   partition shows that such series form the `N`th coordinate-ideal power.
4. A series with nonzero constant coefficient has inverse given coefficientwise by the
   geometric series. Thus the coordinate ideal in the series quotient is maximal and local.
5. Total-degree truncation is multiplicative modulo `J + (T)^N`; its kernel in `Q` is `n^N`.
   This gives the first finite-level comparison, compatibly with every reduction.
6. Every denominator outside `m` becomes a unit in `B_N`, by its finite geometric inverse.
   Fractions therefore give `A_m/(m A_m)^N ≅ B_N`, compatibly with polynomial germs.
7. Use these compatible comparisons to map a normal series into the completion. Read the
   coefficient at exponent `β` at level `degree β + 1` to construct its inverse. This proves
   the canonical isomorphism and its normalization on every polynomial.
8. The isomorphism maps coordinate generators to completed germs, so it maps the powers
   of the coordinate ideals to one another. Transport step 5 to obtain the second finite
   comparison and both commuting transition diagrams. With zero variables, nonzero
   exponents do not exist, the generator list is empty, and polynomial normalization is
   the identity on `k`. Empty or redundant lists in positive dimension work as well.
-/
theorem monomial_local_completion (k : Type u) [Field k] (r s : ℕ)
    (α : Fin s → (Fin r →₀ ℕ)) (hα : ∀ i, α i ≠ 0) :
    (r = 0 → s = 0) ∧
    (∀ x : SeriesQuotient k α, ∃! F : MvPowerSeries (Fin r) k,
      Ideal.Quotient.mk (seriesIdeal k α) F = x ∧
        ∀ β : Fin r →₀ ℕ, (∃ i : Fin s, α i ≤ β) → MvPowerSeries.coeff β F = 0) ∧
    ∃ p : PrimeSpectrum (PolynomialQuotient k α),
      p.asIdeal = polynomialOrigin k α ∧ p.asIdeal.IsMaximal ∧
      (seriesOrigin k α).IsMaximal ∧
      ∃ e : SeriesQuotient k α ≃+* CompleteLocalRing k α p,
        (∀ f : MvPolynomial (Fin r) k,
          e (Ideal.Quotient.mk (seriesIdeal k α) (f : MvPowerSeries (Fin r) k)) =
            completedGerm k α p (Ideal.Quotient.mk (polynomialIdeal k α) f)) ∧
        (completedOrigin k α p).IsMaximal ∧
        ∃ E : ∀ N : ℕ, 1 ≤ N →
            (SeriesQuotient k α ⧸ seriesOrigin k α ^ N) ≃+* FiniteQuotient k α N,
          ∃ F : ∀ N : ℕ, 1 ≤ N →
              (CompleteLocalRing k α p ⧸ completedOrigin k α p ^ N) ≃+*
                FiniteQuotient k α N,
            (∀ (N : ℕ) (hN : 1 ≤ N) (G : MvPowerSeries (Fin r) k),
              E N hN (Ideal.Quotient.mk (seriesOrigin k α ^ N)
                (Ideal.Quotient.mk (seriesIdeal k α) G)) =
                  Ideal.Quotient.mk
                    (polynomialIdeal k α ⊔ MvPolynomial.idealOfVars (Fin r) k ^ N)
                    (MvPowerSeries.truncTotal N G)) ∧
            (∀ (N : ℕ) (hN : 1 ≤ N) (x : SeriesQuotient k α),
              F N hN (Ideal.Quotient.mk (completedOrigin k α p ^ N) (e x)) =
                E N hN (Ideal.Quotient.mk (seriesOrigin k α ^ N) x)) ∧
            (∀ (N M : ℕ) (hN : 1 ≤ N) (hM : 1 ≤ M) (h : N ≤ M)
                (x : SeriesQuotient k α ⧸ seriesOrigin k α ^ M),
              finiteTransition k α h (E M hM x) =
                E N hN (Ideal.Quotient.factor (Ideal.pow_le_pow_right h) x)) ∧
            (∀ (N M : ℕ) (hN : 1 ≤ N) (hM : 1 ≤ M) (h : N ≤ M)
                (x : CompleteLocalRing k α p ⧸ completedOrigin k α p ^ M),
              finiteTransition k α h (F M hM x) =
                F N hN (Ideal.Quotient.factor (Ideal.pow_le_pow_right h) x)) := by
  sorry

end MonomialLocalCompletion
