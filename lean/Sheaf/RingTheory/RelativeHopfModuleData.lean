module

public import Mathlib.RingTheory.Bialgebra.Quotient
public import Mathlib.LinearAlgebra.TensorProduct.Tower

/-! # Relative Hopf-module data

Source: Bichon, arXiv:2301.05480v2, section 2.1.
(blueprint: def-sfb-relative-hopf-module-data)

The coaction is on the left. The tensor action is the bilinear action of H tensor H,
composed with the comultiplication when expressing compatibility. All tensor products,
quotients and actions below are the actual Mathlib constructions.
-/

@[expose] public section

set_option autoImplicit false

universe u v w z z'

open scoped TensorProduct

namespace RelativeHopf

variable (k : Type u) [Field k] (H : Type v) [CommRing H] [Bialgebra k H]

/-- Right coideal condition on a unital subalgebra.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
def IsRightCoideal (A : Subalgebra k H) : Prop :=
  ∀ a : A, Coalgebra.comul (R := k) (a : H) ∈
    LinearMap.range (TensorProduct.map A.val.toLinearMap (LinearMap.id : H →ₗ[k] H))

/-- The ideal generated by the augmentation ideal of A inside H.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
def augmentationIdeal (A : Subalgebra k H) : Ideal H :=
  Ideal.span {h : H | ∃ a : A, Coalgebra.counit (R := k) (a : H) = 0 ∧ (a : H) = h}

/-- The quotient H / HA⁺, with its canonical quotient ring and H-action.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
abbrev Quotient (A : Subalgebra k H) := H ⧸ augmentationIdeal k H A

/-- The canonical quotient map, as a k-linear map.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
def quotientMap (A : Subalgebra k H) : H →ₗ[k] Quotient k H A :=
  (Ideal.Quotient.mkₐ k (augmentationIdeal k H A)).toLinearMap

variable (C : Type w) [AddCommGroup C] [Module k C] [Module H C]
variable [IsScalarTower k H C]
variable (X : Type z) [AddCommGroup X] [Module k X] [Module H X]
variable [IsScalarTower k H X]

/-- The action (g tensor h)(c tensor x) = gc tensor hx.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
def tensorAction : H ⊗[k] H →ₗ[k] (C ⊗[k] X →ₗ[k] C ⊗[k] X) :=
  TensorProduct.lift
    (((TensorProduct.mapBilinear (RingHom.id k) C X C X).comp
      (Algebra.lsmul k k C).toLinearMap).compl₂ (Algebra.lsmul k k X).toLinearMap)

variable [Coalgebra k C]

/-- A left C-coaction on an H-module with the relative Hopf compatibility identity.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
structure Coaction where
  /-- The k-linear coaction. -/
  map : X →ₗ[k] C ⊗[k] X
  /-- Coassociativity, with the standard associator. -/
  coassoc : (TensorProduct.assoc k C C X).toLinearMap ∘ₗ
    (Coalgebra.comul (R := k) (A := C)).rTensor X ∘ₗ map = map.lTensor C ∘ₗ map
  /-- The counit identity, with the standard left unitor. -/
  counit : (TensorProduct.lid k X).toLinearMap ∘ₗ
    (Coalgebra.counit (R := k) (A := C)).rTensor X ∘ₗ map = LinearMap.id
  /-- Compatibility with the H-action via its comultiplication. -/
  compatible : ∀ (h : H) (x : X), map (h • x) =
    tensorAction k H C X (Coalgebra.comul h) (map x)

/-- Coinvariants with respect to a specified group-like element e.
Source: Bichon, section 2.1, e = pi(1). (blueprint: def-sfb-relative-hopf-module-data) -/
def coinvariants (e : C) (α : Coaction k H C X) : Set X :=
  {x | α.map x = e ⊗ₜ[k] x}

variable (Y : Type z') [AddCommGroup Y] [Module k Y] [Module H Y]
variable [IsScalarTower k H Y]

/-- Relative Hopf-module morphisms are H-linear maps commuting with coactions.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
def IsMorphism (α : Coaction k H C X) (β : Coaction k H C Y) (f : X →ₗ[H] Y) : Prop :=
  β.map ∘ₗ f.restrictScalars k = (f.restrictScalars k).lTensor C ∘ₗ α.map

section Induction

variable (A : Subalgebra k H)
variable [((augmentationIdeal k H A).restrictScalars k).IsCoideal]
variable (M : Type z) [AddCommGroup M] [Module A M]
variable [Module k M] [IsScalarTower k A M]

/-- The generator formula characterizing the coaction on H tensor_A M.
Source: Bichon, section 2.1. (blueprint: def-sfb-relative-hopf-module-data) -/
def IsInduced (α : Coaction k H (Quotient k H A) (H ⊗[A] M)) : Prop :=
  ∀ (h : H) (m : M), α.map (h ⊗ₜ[A] m) =
    TensorProduct.map (quotientMap k H A)
      (((TensorProduct.mk A H M).flip m).restrictScalars k) (Coalgebra.comul h)

end Induction

end RelativeHopf
