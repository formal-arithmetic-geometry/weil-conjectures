/-! # Properties of the retained localization

Source: blueprint, proper base change, order 1225, Properties of the retained localization
(blueprint: lem-weil-pbc-retained-localization).
-/

@[expose] public section

universe u

namespace PrincipalWLocalization.Retained

variable {R : Type u} [CommRing R]

/-- The canonical composite `R → R^w → R_[T]`.
Source: blueprint order 1225 (blueprint: lem-weil-pbc-retained-localization). -/
noncomputable def structuralMap (T : Set (PrimeSpectrum R)) (hT : IsClosed T) :
    R →+* algebra T hT :=
  (algebraMap (PrincipalWLocalization.algebra R) (algebra T hT)).comp
    (algebraMap R (PrincipalWLocalization.algebra R))

/-- The retained localization is ind-Zariski, has the listed prime pairs and canonical local
rings, and under the closed-point hypothesis is w-local with patch closed-point space `T`.
The quotient assertion concerns the canonical map, not merely an abstract ring equivalence.
Source: blueprint order 1225 (blueprint: lem-weil-pbc-retained-localization).

Proof:
1. The map to `R^w` is ind-Zariski by def-weil-pbc-w-localization. Each selector localization
is principal. Composition and filtered-colimit stability (lem-weil-pbc-ind-etale-stability)
prove the first clause; the index is the filtered set of constructible supersets.
2. Inverting an idempotent imposes that it is one. Thus the retained ring is `R^w/K`, where
`K` is generated by all `1-e_E`. Its primes contain `K`, and its local rings agree with those
of `R^w`: at such a prime every `e_E` is one, so `K` vanishes in the local ring. The fraction
maps induced by the quotient are inverse (def-weil-pbc-localization-at-prime).
3. By lem-weil-pbc-w-localization-points the ambient primes are `(x,y)` with `y ≤ x`, and
have local ring `R_y`. The selectors retain exactly `x` in all constructible supersets of
`T`. Their intersection is `T`: if `x ∉ V(I)`, some `f ∈ I` avoids `x`, and `V(f)` separates
it from `T`. This proves precisely the retained pairs and canonical local-ring assertion.
4. Selector clopens separate first coordinates. Each retained fibre is the whole connected
fibre `Spec R_x`, and its unique closed point is `(x,x)`. The diagonal remains closed and
has the patch subspace topology on `T`. This gives w-locality and the stated homeomorphism,
in particular under the closed-point hypothesis (def-weil-pbc-w-local).
5. If `T=V(J)` consists of closed points, quotient primes satisfy `J ≤ y ≤ x`, forcing
`y=x`. Thus the quotient spectrum map is a continuous bijection between zero-dimensional
spectra (lem-weil-pbc-zero-dimensional-spectrum-profinite), hence a homeomorphism by
lem-weil-pbc-compact-hausdorff-bijection.
6. Quotient and localization commute by the fraction maps `(a+J)/s ↔ a/s + JR_x`.
Both quotient local rings are `R_x/JR_x`, and their canonical map is the identity on these
fractions. Apply lem-weil-pbc-affine-homeomorphism-local-rings to obtain the quotient
isomorphism. All arguments include the empty spectrum and empty retained subset.
-/
theorem properties (T : Set (PrimeSpectrum R)) (hT : IsClosed T) :
    @Algebra.IsIndPrincipalZariski R (algebra T hT) _ _ (structuralMap T hT).toAlgebra ∧
    (∃ e : PrimeSpectrum (algebra T hT) ≃
        {p : PrimeSpectrum R × PrimeSpectrum R // p.1 ∈ T ∧ p.2.asIdeal ≤ p.1.asIdeal},
      (∀ q : PrimeSpectrum (algebra T hT),
        ∃ hq : (e q).val.2.asIdeal = q.asIdeal.comap (structuralMap T hT),
          Function.Bijective (Localization.localRingHom (e q).val.2.asIdeal q.asIdeal
            (structuralMap T hT) hq)) ∧
      ((∀ x ∈ T, IsClosed ({x} : Set (PrimeSpectrum R))) →
        IsWLocalRing (algebra T hT) ∧
        (∃ h : @Homeomorph T (closedPoints (PrimeSpectrum (algebra T hT)))
            (TopologicalSpace.induced Subtype.val (constructibleTopology (PrimeSpectrum R)))
            inferInstance,
          ∀ x : T, (e (h x).val).val = (x.val, x.val)))) ∧
    ((∀ x ∈ T, IsClosed ({x} : Set (PrimeSpectrum R))) →
      ∀ J : Ideal R, T = PrimeSpectrum.zeroLocus (J : Set R) →
        Function.Bijective (Ideal.quotientMap (J.map (structuralMap T hT))
          (structuralMap T hT) Ideal.le_comap_map)) := by
  sorry

end PrincipalWLocalization.Retained
