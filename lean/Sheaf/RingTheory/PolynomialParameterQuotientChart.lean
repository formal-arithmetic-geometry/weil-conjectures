module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.RingTheory.Polynomial.Basic

/-!
# A polynomial quotient chart for parameter representatives

Source: Stacks Project, Smoothing Ring Maps, Lemma 07FJ, `lemma-resolve-general`,
items `item-set-map-R`, `item-sixth-resolve`, and `item-eighth-resolve`.
(blueprint: lem-weil-pbc-polynomial-parameter-quotient-chart).
-/

@[expose] public section

set_option autoImplicit false

universe u w
namespace Algebra

/-- Form the coefficient quotient of a polynomial parameter chart. Source: Stacks Project,
Smoothing Ring Maps, Lemma 07FJ, `lemma-resolve-general`, items `item-set-map-R`,
`item-sixth-resolve`, and `item-eighth-resolve`.
(blueprint: lem-weil-pbc-polynomial-parameter-quotient-chart).

Proof: Write P=k[y], T=P[t], p₀=φ⁻¹(q). Under E identify H with p₀T.
Since each t_i maps outside q, it is invertible in Q. Every element outside p₀ is
also invertible in Q, so the parameter generation identity in P_(p₀) extends to Q.
It says HQ is generated by uP_i; multiplying by the units t_i gives the stated HQ.
The image of H in L is p₀L, which is m_L by the assumed extended-prime equality.
Ideal.map_pow gives H^n corresponding to p₀^nT. Coefficient reduction
T→(P/p₀^n)[t] is surjective: lift each of the finitely many coefficients of a polynomial.
Its kernel is the extension of p₀^n, since coefficient reduction vanishes exactly
when every coefficient belongs to p₀^n. The quotient universal property therefore gives
the k-algebra equivalence e. On coefficients it is quotient reduction and on variables
it is the identity, proving both displayed formulas. This argument also applies to d=0,
when T=P, and to n=0, when both quotient rings are zero. No coefficient enlargement,
rescaling, kernel equality, or map out of A is asserted here. -/
theorem exists_polynomial_parameter_quotient_chart
    {k : Type u} {Λ : Type w} [Field k] [CommRing Λ] [Algebra k Λ]
    (m₀ m d n : ℕ) (φ : MvPolynomial (Fin m₀) k →ₐ[k] Λ)
    (q : PrimeSpectrum Λ)
    [Algebra (MvPolynomial (Fin m) k) Λ]
    (E : MvPolynomial (Fin m) k ≃ₐ[k]
      MvPolynomial (Fin d) (MvPolynomial (Fin m₀) k))
    (uP : Fin d → MvPolynomial (Fin m₀) k) (tΛ : Fin d → Λ)
    (hparameters : Ideal.span
      (Set.range (fun i ↦ algebraMap (MvPolynomial (Fin m₀) k)
        (Localization.AtPrime (q.asIdeal.comap φ.toRingHom)) (uP i))) =
      (q.asIdeal.comap φ.toRingHom).map
        (algebraMap (MvPolynomial (Fin m₀) k)
          (Localization.AtPrime (q.asIdeal.comap φ.toRingHom))))
    (hideal : q.asIdeal.map (algebraMap Λ (Localization.AtPrime q.asIdeal)) =
      (q.asIdeal.comap φ.toRingHom).map
        ((algebraMap Λ (Localization.AtPrime q.asIdeal)).comp φ.toRingHom))
    (ht : ∀ i, tΛ i ∉ q.asIdeal)
    (hC : ∀ z : MvPolynomial (Fin m₀) k,
      algebraMap (MvPolynomial (Fin m) k) Λ (E.symm (MvPolynomial.C z)) = φ z)
    (hX : ∀ i,
      algebraMap (MvPolynomial (Fin m) k) Λ (E.symm (MvPolynomial.X i)) = tΛ i) :
    let R := MvPolynomial (Fin m) k
    let P := MvPolynomial (Fin m₀) k
    let p₀ := q.asIdeal.comap φ.toRingHom
    let B := P ⧸ p₀ ^ n
    let Q := Localization.AtPrime (q.asIdeal.under R)
    let L := Localization.AtPrime q.asIdeal
    ∃ (H : Ideal R) (e : (R ⧸ H ^ n) ≃ₐ[k] MvPolynomial (Fin d) B),
      H.map (algebraMap R Q) = Ideal.span
        (Set.range (fun i ↦ algebraMap R Q
          (E.symm (MvPolynomial.C (uP i) * MvPolynomial.X i)))) ∧
      H.map ((algebraMap Λ L).comp (algebraMap R Λ)) = IsLocalRing.maximalIdeal L ∧
      (∀ z : P, e (Ideal.Quotient.mk (H ^ n) (E.symm (MvPolynomial.C z))) =
        MvPolynomial.C (Ideal.Quotient.mk (p₀ ^ n) z)) ∧
      (∀ i, e (Ideal.Quotient.mk (H ^ n) (E.symm (MvPolynomial.X i))) =
        MvPolynomial.X i) := by
  classical
  let R := MvPolynomial (Fin m) k
  let P := MvPolynomial (Fin m₀) k
  let p₀ := q.asIdeal.comap φ.toRingHom
  let B := P ⧸ p₀ ^ n
  let T := MvPolynomial (Fin d) P
  let Q := Localization.AtPrime (q.asIdeal.under R)
  let L := Localization.AtPrime q.asIdeal
  let cp : P →+* R := E.symm.toRingHom.comp MvPolynomial.C
  let H : Ideal R := (p₀.map (MvPolynomial.C : P →+* T)).map E.symm.toRingHom
  have hH : H = p₀.map cp := Ideal.map_map _ _
  let θ : R →ₐ[k] MvPolynomial (Fin d) B :=
    (MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ k (p₀ ^ n))).comp E.toAlgHom
  have hθ : Function.Surjective θ :=
    (MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective).comp E.surjective
  have hker : RingHom.ker θ.toRingHom = H ^ n := by
    change RingHom.ker ((MvPolynomial.map (Ideal.Quotient.mk (p₀ ^ n))).comp
      E.toRingHom) = H ^ n
    rw [← RingHom.comap_ker, MvPolynomial.ker_map, Ideal.mk_ker]
    change (Ideal.map MvPolynomial.C (p₀ ^ n)).comap E.toRingHom =
      ((p₀.map (MvPolynomial.C : P →+* T)).map E.symm.toRingHom) ^ n
    rw [← Ideal.map_pow, ← Ideal.map_pow]
    ext z
    change E z ∈ Ideal.map MvPolynomial.C (p₀ ^ n) ↔
      z ∈ (Ideal.map MvPolynomial.C (p₀ ^ n)).map E.symm.toRingHom
    rw [Ideal.mem_map_iff_of_surjective E.symm.toRingHom E.symm.surjective]
    constructor
    · intro hz
      exact ⟨E z, hz, E.symm_apply_apply z⟩
    · rintro ⟨y, hy, hzy⟩
      change E.symm y = z at hzy
      rw [← hzy, AlgEquiv.apply_symm_apply]
      exact hy
  let e : (R ⧸ H ^ n) ≃ₐ[k] MvPolynomial (Fin d) B :=
    (Ideal.quotientEquivAlgOfEq k hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hθ)
  have he (z : R) : e (Ideal.Quotient.mk (H ^ n) z) = θ z := by
    simp only [e, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk]
    exact Ideal.quotientKerAlgEquivOfSurjective_mk hθ z
  have heC (z : P) : e (Ideal.Quotient.mk (H ^ n) (E.symm (MvPolynomial.C z))) =
      MvPolynomial.C (Ideal.Quotient.mk (p₀ ^ n) z) := by
    rw [he]
    change MvPolynomial.map (Ideal.Quotient.mk (p₀ ^ n))
      (E (E.symm (MvPolynomial.C z))) = _
    rw [AlgEquiv.apply_symm_apply, MvPolynomial.map_C]
  have heX (i : Fin d) :
      e (Ideal.Quotient.mk (H ^ n) (E.symm (MvPolynomial.X i))) =
      MvPolynomial.X i := by
    rw [he]
    change MvPolynomial.map (Ideal.Quotient.mk (p₀ ^ n))
      (E (E.symm (MvPolynomial.X i))) = _
    rw [AlgEquiv.apply_symm_apply, MvPolynomial.map_X]
  have hHL : H.map ((algebraMap Λ L).comp (algebraMap R Λ)) =
      IsLocalRing.maximalIdeal L := by
    have hcomp : ((algebraMap Λ L).comp (algebraMap R Λ)).comp cp =
        (algebraMap Λ L).comp φ.toRingHom := by
      apply RingHom.ext
      intro z
      change algebraMap Λ L (algebraMap R Λ (E.symm (MvPolynomial.C z))) = _
      rw [hC]
      rfl
    rw [hH, Ideal.map_map, hcomp, ← hideal]
    exact Localization.AtPrime.map_eq_maximalIdeal
  have hHQ : H.map (algebraMap R Q) = Ideal.span
      (Set.range (fun i ↦ algebraMap R Q
        (E.symm (MvPolynomial.C (uP i) * MvPolynomial.X i)))) := by
    let j : P →+* Q := (algebraMap R Q).comp cp
    have hjunit (z : p₀.primeCompl) : IsUnit (j z) := by
      change IsUnit (algebraMap R Q (cp z))
      refine IsLocalization.map_units Q
        (⟨cp z, ?_⟩ : (q.asIdeal.under R).primeCompl)
      change algebraMap R Λ (E.symm (MvPolynomial.C (z : P))) ∉ q.asIdeal
      rw [hC]
      exact z.property
    let η : Localization.AtPrime p₀ →+* Q :=
      IsLocalization.lift (S := Localization.AtPrime p₀) (g := j) hjunit
    have hη : η.comp (algebraMap P (Localization.AtPrime p₀)) = j := by
      apply RingHom.ext
      intro z
      exact IsLocalization.lift_eq (S := Localization.AtPrime p₀) (g := j) hjunit z
    have hgen : H.map (algebraMap R Q) =
        Ideal.span (Set.range (fun i ↦ j (uP i))) := by
      have h := congrArg (Ideal.map η) hparameters
      rw [Ideal.map_map, hη, Ideal.map_span] at h
      have himage : η '' Set.range
          (fun i ↦ algebraMap P (Localization.AtPrime p₀) (uP i)) =
          Set.range (fun i ↦ j (uP i)) := by
        ext z
        constructor
        · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
          exact ⟨i, (IsLocalization.lift_eq
            (S := Localization.AtPrime p₀) (g := j) hjunit (uP i)).symm⟩
        · rintro ⟨i, rfl⟩
          exact ⟨algebraMap P (Localization.AtPrime p₀) (uP i), ⟨i, rfl⟩,
            IsLocalization.lift_eq (S := Localization.AtPrime p₀) (g := j) hjunit (uP i)⟩
      rw [himage] at h
      rw [hH, Ideal.map_map]
      exact h.symm
    have htunit (i : Fin d) :
        IsUnit (algebraMap R Q (E.symm (MvPolynomial.X i))) := by
      refine IsLocalization.map_units Q
        (⟨E.symm (MvPolynomial.X i), ?_⟩ : (q.asIdeal.under R).primeCompl)
      change algebraMap R Λ (E.symm (MvPolynomial.X i)) ∉ q.asIdeal
      rw [hX]
      exact ht i
    rw [hgen]
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      apply (Ideal.mul_unit_mem_iff_mem _ (htunit i)).mp
      have hi := Ideal.subset_span (Set.mem_range_self i :
        algebraMap R Q (E.symm (MvPolynomial.C (uP i) * MvPolynomial.X i)) ∈
          Set.range (fun i ↦ algebraMap R Q
            (E.symm (MvPolynomial.C (uP i) * MvPolynomial.X i))))
      change algebraMap R Q (E.symm (MvPolynomial.C (uP i) * MvPolynomial.X i)) ∈ _ at hi
      rw [map_mul, map_mul] at hi
      change algebraMap R Q (E.symm (MvPolynomial.C (uP i))) *
        algebraMap R Q (E.symm (MvPolynomial.X i)) ∈ _
      exact hi
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      change algebraMap R Q (E.symm (MvPolynomial.C (uP i) * MvPolynomial.X i)) ∈ _
      rw [map_mul, map_mul]
      apply Ideal.mul_mem_right
      change j (uP i) ∈ _
      exact Ideal.subset_span (Set.mem_range_self i)
  exact ⟨H, e, hHQ, hHL, heC, heX⟩


end Algebra
