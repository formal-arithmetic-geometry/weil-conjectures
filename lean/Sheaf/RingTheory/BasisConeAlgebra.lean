module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.Algebra.Group.Submonoid.BigOperators
public import Mathlib.Algebra.Field.Defs

/-! # The algebra of the nonnegative cone of an integral basis

Source: ILO, Travaux de Gabber, Exposé VIII, Lemma 3.2.12, printed p.104 (PDF p.110),
expanded positive-basis monoid-algebra construction (blueprint: def-trf-basis-cone-algebra).

## Main definitions

* `basisCone`: the additive submonoid generated by the integral basis.
* `basisConeVariable`: the basis monomial in its additive monoid algebra.
* `basisConeInclusion`: extension of coefficients by zero into the group algebra.
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace AddMonoidAlgebra

variable {k : Type u} [Field k] {G : Type v} [AddCommGroup G] {r : ℕ}

/-- The nonnegative cone of the specified integral basis, using additive-submonoid closure.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded basis-cone calculation
(blueprint: def-trf-basis-cone-algebra). -/
def basisCone (b : Module.Basis (Fin r) ℤ G) : AddSubmonoid G :=
  AddSubmonoid.closure (Set.range b)

/-- The basis monomial in the cone algebra. Its exponent belongs to the cone by construction.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded basis-cone calculation
(blueprint: def-trf-basis-cone-algebra). -/
noncomputable def basisConeVariable (b : Module.Basis (Fin r) ℤ G) (i : Fin r) :
    AddMonoidAlgebra k (basisCone b) :=
  single ⟨b i, AddSubmonoid.subset_closure (Set.mem_range_self i)⟩ 1

/-- The coefficientwise inclusion of the cone algebra into the lattice group algebra.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded basis-cone calculation
(blueprint: def-trf-basis-cone-algebra). -/
noncomputable def basisConeInclusion (b : Module.Basis (Fin r) ℤ G) :
    AddMonoidAlgebra k (basisCone b) →ₐ[k] AddMonoidAlgebra k G :=
  mapDomainAlgHom k k (basisCone b).subtype

end AddMonoidAlgebra
