module

public import Mathlib.RingTheory.MvPowerSeries.Substitution
public import Mathlib.RingTheory.Ideal.Colon
public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.Data.ENat.Lattice
import WeilConjectures.RingTheory.PowerSeriesCombinedIdealCoefficients

/-! # Exact orders for isotropic formal cylinders

Source: the agent coefficient calculation in the DAG, on the cylinder-test route
of Bierstone--Milman, Functoriality in resolution of singularities (2008),
Theorem 6.1, pp.631--632; historical context ILO VIII 2.3.11--2.3.13.
(blueprint: lem-trf-isotropic-cylinder-order-calculation).
The four definitions below are the order and controlled transforms explicitly
introduced by this node. The last variable of `Fin (n + 1)` is `t`.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace MvPowerSeries

/-- Order of an ideal with respect to the displayed ideal: the supremum of the
natural powers containing it, in the extended natural numbers.
Source: the node's agent coefficient calculation, step 1, on the BM 2008,
Theorem 6.1 cylinder-test route.
(blueprint: lem-trf-isotropic-cylinder-order-calculation). -/
noncomputable def cylinderIdealOrder {A : Type u} [CommRing A]
    (K J : Ideal A) : ℕ∞ :=
  ⨆ q : {q : ℕ // K ≤ J ^ q}, (q.val : ℕ∞)

/-- The coefficient shift representing `t^(-k*d) f(t^k*u)`. The substitution is
Mathlib's formal substitution; shifting coefficients is actual power-series data.
Under the node's containment hypothesis, the theorem below certifies that no
terms were lost in this division.
Source: the node's agent coefficient calculation, steps 2--3, on the BM 2008,
Theorem 6.1 cylinder-test route.
(blueprint: lem-trf-isotropic-cylinder-order-calculation). -/
noncomputable def isotropicCylinderSeries {F : Type u} [CommRing F] {n : ℕ}
    (k d : ℕ) (f : MvPowerSeries (Fin n) F) : MvPowerSeries (Fin (n + 1)) F :=
  fun E ↦ coeff (E + Finsupp.single (Fin.last n) (k * d))
    (subst (fun j : Fin n ↦
      (X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F) ^ k * X j.castSucc) f)

/-- The cylinder ideal, generated by the divided substitutions of all elements of
`K`. The theorem identifies this canonical construction with the construction
from any finite generating set.
Source: the node's agent coefficient calculation, step 3, on the BM 2008,
Theorem 6.1 cylinder-test route.
(blueprint: lem-trf-isotropic-cylinder-order-calculation). -/
noncomputable def isotropicCylinderIdeal {F : Type u} [CommRing F] {n : ℕ}
    (K : Ideal (MvPowerSeries (Fin n) F)) (k d : ℕ) :
    Ideal (MvPowerSeries (Fin (n + 1)) F) :=
  Ideal.span (isotropicCylinderSeries k d '' (K : Set (MvPowerSeries (Fin n) F)))

/-- Controlled division of the cylinder ideal by `t^(i*d)`, as the ideal of all
power series whose product with that monomial belongs to the cylinder ideal.
The theorem certifies that multiplication recovers the entire cylinder ideal
when the indicated divisibility bound holds.
Source: the node's agent coefficient calculation, step 5, on the BM 2008,
Theorem 6.1 cylinder-test route.
(blueprint: lem-trf-isotropic-cylinder-order-calculation). -/
noncomputable def controlledCylinderIdeal {F : Type u} [CommRing F] {n : ℕ}
    (K : Ideal (MvPowerSeries (Fin n) F)) (k d i : ℕ) :
    Ideal (MvPowerSeries (Fin (n + 1)) F) :=
  (isotropicCylinderIdeal K k d).colon
    {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F) ^ (i * d)}

/-- Exact exceptional and total orders of the controlled isotropic cylinder ideal.

Source: the agent coefficient calculation in this DAG node, on the BM 2008,
Theorem 6.1, pp.631--632 cylinder-test route; ILO VIII 2.3.11--2.3.13 gives
historical resolution context only.
(blueprint: lem-trf-isotropic-cylinder-order-calculation).

Proof: (1) Apply `power_series_mem_combined_ideal_pow_iff` with coefficient ideal
zero in `n` and `n+1` variables. Membership in the variables ideal to power `q`
means vanishing below total degree `q`. For a finite family generating nonzero
`K`, the least degree of a nonzero coefficient is a finite `m`, is its ideal
order, and satisfies `d ≤ m`.
(2) Formal substitution sends a coefficient at exponent `alpha` to the same
coefficient at `(alpha,k*|alpha|)`. Finite Cauchy convolution shows this is an
algebra map. The retained `u` exponents prevent collisions.
(3) Membership in `(t)^a` is vanishing of coefficients with `t` exponent below
`a`; division shifts that exponent by `a`. Multiplication by `t^a` is injective.
All elements of `K` have degrees at least `d`, so division by `t^(k*d)` loses no
terms. Additivity and `T(a*f)=phi(a)*T(f)` show that any finite generating set
gives the ideal generated by all divided elements of `K`.
(4) Every nonzero generator coefficient has degree at least `m`, and some has
degree `m`. Its image has `t` exponent at least `k*(m-d)` and total degree at
least `(k+1)*m-k*d`, with simultaneous equality for that coefficient. The
coefficient criteria give both exact orders.
(5) If `i*d ≤ k*(m-d)`, divide each transformed generator by `t^(i*d)`.
Cancellation identifies their ideal with the colon ideal defined above, and
multiplication recovers the original ideal. Subtract `i*d` from the two least
degrees. Containment in `(t)^d` is precisely `k*(m-d) ≥ (i+1)*d`, including equality.
(6) If `K=0`, substitution and every quotient are zero; cancellation gives zero
colon ideals, whose orders are infinite and which lie in every power of `(t)`.
If `n=0`, the variables ideal is zero and `d ≥ 1` forces `K=0`. -/
theorem isotropicCylinder_order_calculation
    (F : Type u) [Field F] (n d : ℕ)
    (K : Ideal (MvPowerSeries (Fin n) F)) (hfg : K.FG) (hd : 1 ≤ d)
    (hK : K ≤ (Ideal.span
      (Set.range (X : Fin n → MvPowerSeries (Fin n) F))) ^ d) :
    (∀ k : ℕ, 1 ≤ k →
      (∀ f ∈ K,
        (X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F) ^ (k * d) *
            isotropicCylinderSeries k d f =
          subst (fun j : Fin n ↦
            (X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F) ^ k * X j.castSucc) f) ∧
      (∀ g : Finset (MvPowerSeries (Fin n) F), Ideal.span (g : Set _) = K →
        Ideal.span (isotropicCylinderSeries k d '' (g : Set _)) =
          isotropicCylinderIdeal K k d)) ∧
    (K ≠ ⊥ → ∃ m : ℕ,
      cylinderIdealOrder K (Ideal.span
        (Set.range (X : Fin n → MvPowerSeries (Fin n) F))) = (m : ℕ∞) ∧
      d ≤ m ∧
      ∀ k : ℕ, 1 ≤ k →
        cylinderIdealOrder (isotropicCylinderIdeal K k d)
          (Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F)}) =
            ((k * (m - d) : ℕ) : ℕ∞) ∧
        cylinderIdealOrder (isotropicCylinderIdeal K k d)
          (Ideal.span (Set.range (X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) F))) =
            (((k + 1) * m - k * d : ℕ) : ℕ∞) ∧
        ∀ i : ℕ, i * d ≤ k * (m - d) →
          Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F) ^ (i * d)} *
              controlledCylinderIdeal K k d i = isotropicCylinderIdeal K k d ∧
          cylinderIdealOrder (controlledCylinderIdeal K k d i)
            (Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F)}) =
              ((k * (m - d) - i * d : ℕ) : ℕ∞) ∧
          cylinderIdealOrder (controlledCylinderIdeal K k d i)
            (Ideal.span (Set.range (X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) F))) =
              (((k + 1) * m - (k + i) * d : ℕ) : ℕ∞) ∧
          (controlledCylinderIdeal K k d i ≤
              (Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F)}) ^ d ↔
            (i + 1) * d ≤ k * (m - d))) ∧
    (K = ⊥ → ∀ k : ℕ, 1 ≤ k →
      isotropicCylinderIdeal K k d = ⊥ ∧
      cylinderIdealOrder (isotropicCylinderIdeal K k d)
        (Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F)}) = ⊤ ∧
      cylinderIdealOrder (isotropicCylinderIdeal K k d)
        (Ideal.span (Set.range (X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) F))) = ⊤ ∧
      ∀ i : ℕ,
        controlledCylinderIdeal K k d i = ⊥ ∧
        cylinderIdealOrder (controlledCylinderIdeal K k d i)
          (Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F)}) = ⊤ ∧
        cylinderIdealOrder (controlledCylinderIdeal K k d i)
          (Ideal.span (Set.range (X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) F))) = ⊤ ∧
        ∀ q : ℕ, controlledCylinderIdeal K k d i ≤
          (Ideal.span {(X (Fin.last n) : MvPowerSeries (Fin (n + 1)) F)}) ^ q) ∧
    (n = 0 → K = ⊥) := by
  sorry

end MvPowerSeries
