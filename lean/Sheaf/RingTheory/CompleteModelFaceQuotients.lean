module

public import Sheaf.RingTheory.CompleteToricModel
public import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
public import WeilConjectures.RingTheory.CohenRing
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Sheaf.TraceFormula.SharpFsOrthantEmbedding
import Sheaf.RingTheory.LogRegularSaturationNormality
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.RingTheory.Polynomial.RationalRoot

/-!
# Face projections and prime quotients of complete monoid models

Source: ILO, Travaux de Gabber, Exposé VI 1.6(i)--(ii), printed p. 70, for model
notation; the face projection and quotient argument is the agent-formulated refinement
in the DAG (blueprint: lem-trf-complete-model-face-quotients).

The coefficient descriptions below are pinned down by approximation with polynomial
representatives, in every power of the coefficient maximal ideal. Thus the coefficient
maps in the statement describe the given completion, including its original monomials.
-/

@[expose] public section

set_option autoImplicit false

universe u v

noncomputable section

namespace ToricMonoid

/-- A coefficient-family description of the complete model: an `L`-linear equivalence
whose values are the maximal-ideal limits of polynomial representative coefficients.
The condition quantifies over every representative of a sufficiently deep truncation,
so it uniquely specifies the coefficients when `L` is separated.
Source: coefficient argument, steps 2--3 of the agent refinement of ILO VI 1.6,
printed p. 70 (blueprint: lem-trf-complete-model-face-quotients). -/
def IsModelCoefficientDescription (L : Type v) [CommRing L] [IsLocalRing L]
    (P : Type u) [AddCommMonoid P] (n : ℕ)
    (c : Complete L P n ≃ₗ[L] (P → (Fin n →₀ ℕ) → L)) : Prop :=
  ∀ (x : Complete L P n) (q : P) (e : Fin n →₀ ℕ) (k : ℕ),
    ∃ N : ℕ, ∀ f : PolynomialRing L P n,
      AdicCompletion.evalₐ (completionIdeal L P n) N x =
          Ideal.Quotient.mk ((completionIdeal L P n) ^ N) f →
        c x q e - (MvPolynomial.coeff e f).coeff q ∈ (IsLocalRing.maximalIdeal L) ^ k

/-- The ideal `J_S` generated by all completed monomials with exponent outside `S`.
Source: face coefficient argument, step 4 of the agent refinement of ILO VI 1.6,
printed p. 70 (blueprint: lem-trf-complete-model-face-quotients). -/
def faceMonomialIdeal (L : Type v) [CommRing L] [IsLocalRing L]
    (P : Type u) [AddCommMonoid P] (n : ℕ) (S : AddSubmonoid P) :
    Ideal (Complete L P n) :=
  Ideal.span {a | ∃ q : P, q ∉ S ∧ a = monomial L P n q}

/-- The image of `J_S` in the Cohen hypersurface ring `B_L(P,n)/(θ)`.
Source: quotient-kernel argument, step 5 of the agent refinement of ILO VI 1.6,
printed p. 70 (blueprint: lem-trf-complete-model-face-quotients). -/
def hypersurfaceFaceIdeal (L : Type v) [CommRing L] [IsLocalRing L]
    (P : Type u) [AddCommMonoid P] (n : ℕ) (S : AddSubmonoid P)
    (θ : Complete L P n) : Ideal (Complete L P n ⧸ Ideal.span {θ}) :=
  (faceMonomialIdeal L P n S).map (Ideal.Quotient.mk (Ideal.span {θ}))

/-- A face is sharp fs, its generators are precisely the surviving generators, and
restriction to its coefficient families gives the stated surjection, kernel and prime
quotient descriptions in both coefficient cases.
Source: ILO VI 1.6(i)--(ii), printed p. 70, supplies only the model notation; this is
an agent-formulated refinement (blueprint: lem-trf-complete-model-face-quotients).

Proof:
1. In any generator expression for an element of `S`, the face condition forces each
summand into `S`. Integrality and sharpness are inherited. Embed `S^gp` into `P^gp`;
saturation of `P` and the face condition for a positive multiple prove saturation of `S`.
2. Use `lem-trf-sharp-fs-orthant-embedding` to embed `P` in an orthant and adjoin the
variable coordinates. Their coordinate sum is positive away from zero. A field and a
Cohen ring are complete separated Noetherian domains, by `def-weil-pbc-cohen-ring`
and `lem-weil-pbc-pid-noetherian-normal`. Apply
`lem-trf-complete-model-coefficient-nonvanishing` to identify the completions with all
coefficient families. The polynomial renaming preserves their defining ideals.
3. Restriction to `S` is multiplicative since every decomposition of an element of
`S` has both summands in `S`. It fixes constants. Extension by zero proves surjectivity.
4. Every exponent outside `S` has some generator outside `S` as a summand. Partition
these exponents by their first eligible generator. Shifting each part by that generator
writes every kernel family as a finite sum of its monomial multiples. Conversely these
multiples are supported outside `S`. This proves both kernel presentations.
5. The first isomorphism theorem gives the field quotient. In the Cohen case the
kernel of `b ↦ [ρ b]` is `J_S + (θ)`: lift a coefficient of `ρ θ` under `ρ` and subtract
the resulting multiple of `θ`. Passing first modulo `θ` gives the displayed quotient.
All maps preserve constants and surviving monomials. Applying `ρ` sends the chart ideal
into the face chart ideal and proves the condition on `ρ θ - p`.
6. Apply `lem-trf-log-regular-saturation-normality` to `S`, using step 1 and the
condition from step 5. Both displayed quotients are nonzero normal domains, so their
surjective-map kernels are prime.
7. An outside monomial is in the kernel. A surviving monomial has coefficient 1 in
the field model. In the Cohen model `ρ θ` has constant coefficient exactly the nonzero
uniformizer `p`, since chart generators have zero constant coefficient. Apply
`lem-trf-complete-model-coefficient-nonvanishing` to show its monomials survive modulo
`ρ θ`. Empty outside-generator lists, `S=P`, `S={0}`, `P={0}` and `n=0` use the same formulas.
-/
theorem complete_model_face_quotients
    (P : Type u) [AddCommMonoid P]
    (hfs : AlgebraicGeometry.IsFineSaturatedMonoid (Multiplicative P))
    (hsharp : ∀ a b : P, a + b = 0 → a = 0 ∧ b = 0)
    (n : ℕ) (S : AddSubmonoid P)
    (hface : ∀ a b : P, a + b ∈ S → a ∈ S ∧ b ∈ S) :
    AlgebraicGeometry.IsFineSaturatedMonoid (Multiplicative S) ∧
    (∀ a b : S, a + b = 0 → a = 0 ∧ b = 0) ∧
    (∀ (s : ℕ) (g : Fin s → P), AddSubmonoid.closure (Set.range g) = ⊤ →
      AddSubmonoid.closure (Set.range g ∩ (S : Set P)) = S) ∧
    ∀ (L : Type v) [CommRing L] [IsLocalRing L],
      (IsField L ∨ ∃ p : ℕ, IsCohenRing p L) →
      ∃ (cP : Complete L P n ≃ₗ[L] (P → (Fin n →₀ ℕ) → L))
        (cS : Complete L S n ≃ₗ[L] (S → (Fin n →₀ ℕ) → L))
        (ρ : Complete L P n →ₐ[L] Complete L S n),
        IsModelCoefficientDescription L P n cP ∧
        IsModelCoefficientDescription L S n cS ∧
        Function.Surjective ρ ∧
        (∀ (b : Complete L P n) (q : S) (e : Fin n →₀ ℕ),
          cS (ρ b) q e = cP b q.val e) ∧
        RingHom.ker ρ.toRingHom = faceMonomialIdeal L P n S ∧
        (∀ (s : ℕ) (g : Fin s → P), AddSubmonoid.closure (Set.range g) = ⊤ →
          faceMonomialIdeal L P n S =
            Ideal.span {a | ∃ i : Fin s, g i ∉ S ∧ a = monomial L P n (g i)}) ∧
        (IsField L →
          (∃ E : (Complete L P n ⧸ faceMonomialIdeal L P n S) ≃ₐ[L] Complete L S n,
            (∀ b : Complete L P n,
              E (Ideal.Quotient.mk _ b) = ρ b) ∧
            ∀ q : S, E (Ideal.Quotient.mk _ (monomial L P n q.val)) =
              monomial L S n q) ∧
          IsDomain (Complete L S n) ∧ IsIntegrallyClosed (Complete L S n) ∧
          (faceMonomialIdeal L P n S).IsPrime ∧
          ∀ q : P, monomial L P n q ∈ faceMonomialIdeal L P n S ↔ q ∉ S) ∧
        (∀ (p : ℕ), IsCohenRing p L → ∀ θ : Complete L P n,
          θ - (p : Complete L P n) ∈ completedChartIdeal L P n →
          ρ θ - (p : Complete L S n) ∈ completedChartIdeal L S n ∧
          (∃ E : ((Complete L P n ⧸ Ideal.span {θ}) ⧸
              hypersurfaceFaceIdeal L P n S θ) ≃ₐ[L]
                (Complete L S n ⧸ Ideal.span {ρ θ}),
            (∀ b : Complete L P n,
              E (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ b)) =
                Ideal.Quotient.mk _ (ρ b)) ∧
            ∀ q : S,
              E (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (monomial L P n q.val))) =
                Ideal.Quotient.mk _ (monomial L S n q)) ∧
          IsDomain (Complete L S n ⧸ Ideal.span {ρ θ}) ∧
          IsIntegrallyClosed (Complete L S n ⧸ Ideal.span {ρ θ}) ∧
          (hypersurfaceFaceIdeal L P n S θ).IsPrime ∧
          ∀ q : P, Ideal.Quotient.mk (Ideal.span {θ}) (monomial L P n q) ∈
            hypersurfaceFaceIdeal L P n S θ ↔ q ∉ S) := by
  sorry

end ToricMonoid
