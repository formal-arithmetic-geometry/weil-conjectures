/-! # Residue differentials of the algebra adjoining p-th roots

Source: Stacks Project, More on Algebra, Tag 07E5, proof of (2) ⇒ (4).
-/

@[expose] public section

universe u v

open scoped TensorProduct

namespace Algebra

/-- Absolute differentials compared over the residue field of the upper ring.
This is scalar extension of `mapBaseChange`, with its source reassociated. -/
noncomputable def residueDifferentialComparison (p : ℕ) (A : Type u) (B : Type v)
    [CommRing A] [CommRing B] [Algebra (ZMod p) A] [Algebra A B]
    [Algebra (ZMod p) B] [IsScalarTower (ZMod p) A B] [IsLocalRing B] :
    IsLocalRing.ResidueField B ⊗[A] KaehlerDifferential (ZMod p) A →ₗ[
      IsLocalRing.ResidueField B]
      IsLocalRing.ResidueField B ⊗[B] KaehlerDifferential (ZMod p) B :=
  ((KaehlerDifferential.mapBaseChange (ZMod p) A B).baseChange
    (IsLocalRing.ResidueField B)).comp
      (TensorProduct.AlgebraTensorModule.cancelBaseChange A B (IsLocalRing.ResidueField B)
        (IsLocalRing.ResidueField B) (KaehlerDifferential (ZMod p) A)).symm.toLinearMap

private theorem baseChange_exact_of_projective_cokernel
    {R S M N P Q : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [AddCommGroup N] [AddCommGroup P] [AddCommGroup Q]
    [Module R M] [Module R N] [Module R P] [Module R Q] [Module.Projective R Q]
    (f : M →ₗ[R] N) (g : N →ₗ[R] P) (h : P →ₗ[R] Q)
    (hfg : Function.Exact f g) (hgh : Function.Exact g h)
    (hsur : Function.Surjective h) :
    Function.Exact (f.baseChange S) (g.baseChange S) := by
  obtain ⟨s, hs⟩ := h.exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr hsur)
  let q : P →ₗ[R] h.ker :=
    (LinearMap.id - s.comp h).codRestrict h.ker (fun x ↦ by
      simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.comp_apply, map_sub]
      have hx := DFunLike.congr_fun hs (h x)
      simpa only [LinearMap.comp_apply, LinearMap.id_apply] using sub_eq_zero.mpr hx.symm)
  have hq : q.comp h.ker.subtype = LinearMap.id := by
    ext x
    simp [q]
  have hj : Function.Injective (h.ker.subtype.baseChange S) := by
    have hi : (q.baseChange S).comp (h.ker.subtype.baseChange S) = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hq, LinearMap.baseChange_id]
    exact Function.LeftInverse.injective (fun x ↦ DFunLike.congr_fun hi x)
  let g' : N →ₗ[R] h.ker := g.codRestrict h.ker (fun x ↦ (hgh (g x)).mpr ⟨x, rfl⟩)
  have hsur' : Function.Surjective g' := by
    intro x
    obtain ⟨y, hy⟩ := (hgh x.val).mp x.property
    exact ⟨y, Subtype.ext hy⟩
  have hex : Function.Exact f g' := by
    intro x
    simpa only [g', LinearMap.codRestrict_apply, Subtype.ext_iff, ZeroMemClass.coe_zero]
      using hfg x
  have hb : Function.Exact (f.baseChange S) (g'.baseChange S) :=
    _root_.lTensor_exact S hex hsur'
  have hg : h.ker.subtype.comp g' = g := rfl
  rw [← hg, LinearMap.baseChange_comp]
  exact hb.comp_injective _ hj (map_zero _)

/-- The p-root algebra is local over A. Over its residue field, the comparison of
absolute differentials has kernel generated by the coefficient differentials and
cokernel dimension n.

Source: Stacks Project, More on Algebra, Tag 07E5, proof of (2) ⇒ (4), the p-root
presentation and the exact sequence after tensoring with K'.
(blueprint: lem-weil-pbc-pth-root-residue-differentials).

Proof: The quotient has the monomial A-basis with exponents less than p. Every
prime over a fixed prime of A is unique: after passing to its residue field,
each X_i has a unique p-th root in an algebraic closure. Thus the finite integral
map has exactly one maximal ideal over the maximal ideal of A, and is local.
Apply pthRootPresentation_differentials to this actual quotient. The relative
module is free of rank n. Hence the surjection from absolute to relative
differentials splits. Its kernel N gives two exact sequences: the right exact
sequence A'^n → A' tensor_A Omega_A → N → 0 and the split short exact sequence
0 → N → Omega_A' → Omega_A'/A → 0. Tensor both with the residue field of A'.
Right exactness preserves the first sequence; splitting preserves the second.
Splice them and reassociate the source tensor product. This identifies the kernel
with the span of the n coefficient differentials, and the cokernel with the
residue scalar extension of the free relative module, of dimension n. For n = 0
this is the identity quotient and both kernel and cokernel are zero. -/
theorem pthRoot_residue_differentials (p n : ℕ) [Fact p.Prime]
    (A : Type u) [CommRing A] [Algebra (ZMod p) A] [IsLocalRing A]
    (a : Fin n → A) :
    ∃ hlocal : IsLocalRing (pthRootAlgebra p n A a),
      letI := hlocal
      IsLocalHom (algebraMap A (pthRootAlgebra p n A a)) ∧
      let B := pthRootAlgebra p n A a
      let L := IsLocalRing.ResidueField B
      let β := residueDifferentialComparison p A B
      β.ker = Submodule.span L (Set.range (fun i : Fin n ↦
        (1 : L) ⊗ₜ[A] KaehlerDifferential.D (ZMod p) A (a i))) ∧
      Module.finrank L ((L ⊗[B] KaehlerDifferential (ZMod p) B) ⧸ β.range) = n := by
  classical
  obtain ⟨hlocal, hmap⟩ := pthRootAlgebra_local p n A a
  let : IsLocalRing (pthRootAlgebra p n A a) := hlocal
  refine ⟨hlocal, hmap, ?_⟩
  let B := pthRootAlgebra p n A a
  let L := IsLocalRing.ResidueField B
  let M := KaehlerDifferential (ZMod p) A
  let w := KaehlerDifferential.mapBaseChange (ZMod p) A B
  let z := KaehlerDifferential.map (ZMod p) A B B
  let ε := Finsupp.linearCombination B (fun i : Fin n ↦
    (1 : B) ⊗ₜ[A] KaehlerDifferential.D (ZMod p) A (a i))
  obtain ⟨⟨b, _⟩, hεw, hwz, hz⟩ :=
    KaehlerDifferential.pthRootPresentation_differentials p n A a
  have : Module.Free B (KaehlerDifferential A B) := Module.Free.of_basis b
  have hex : Function.Exact (ε.baseChange L) (w.baseChange L) :=
    baseChange_exact_of_projective_cokernel ε w z hεw hwz hz
  have hex' : Function.Exact (w.baseChange L) (z.baseChange L) :=
    _root_.lTensor_exact L hwz hz
  have hz' : Function.Surjective (z.baseChange L) := LinearMap.lTensor_surjective L hz
  let e := TensorProduct.AlgebraTensorModule.cancelBaseChange A B L L M
  have hrε : (ε.baseChange L).range = (ε.range).baseChange L := by
    ext x
    exact SetLike.ext_iff.mp (LinearMap.lTensor_range (g := ε) L) x
  have hrw : (residueDifferentialComparison p A B).range = (w.baseChange L).range := by
    change (w.baseChange L ∘ₗ e.symm.toLinearMap).range = _
    apply SetLike.coe_injective
    exact e.symm.surjective.range_comp (w.baseChange L)
  constructor
  · change (w.baseChange L ∘ₗ e.symm.toLinearMap).ker = _
    rw [LinearMap.ker_comp, hex.linearMap_ker_eq, hrε,
      ← Submodule.map_equiv_eq_comap_symm, Finsupp.range_linearCombination,
      Submodule.baseChange_span, Submodule.map_span]
    congr 1
    ext x
    simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and]
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i, by simp [e, M]⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, by simp [e, M]⟩
  · change Module.finrank L (_ ⧸ (residueDifferentialComparison p A B).range) = n
    rw [hrw, ← hex'.linearMap_ker_eq]
    rw [(LinearMap.quotKerEquivOfSurjective (z.baseChange L) hz').finrank_eq]
    simpa using Module.finrank_eq_card_basis (b.baseChange L)

end Algebra
