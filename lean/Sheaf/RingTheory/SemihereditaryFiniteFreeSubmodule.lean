module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Finiteness.Defs

import Mathlib.RingTheory.Finiteness.Basic

/-! # Finite submodules over semihereditary rings

Source: Hemo--Richarz--Scholbach, Constructible sheaves on schemes, Lemma 6.7(1),
algebraic sublemma extracted in the DAG; the rank induction uses the projective-module
lifting characterization of Stacks Tags 05CE and 05CF
(blueprint: lem-sfb-semihereditary-finite-free-submodule).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Submodule

/-- Every finitely generated submodule of `R^n` is projective if every finitely generated
ideal of the commutative ring `R` is projective.

Source: Hemo--Richarz--Scholbach, Lemma 6.7(1), extracted algebraic sublemma;
Stacks Tags 05CE/05CF for the lifting characterization of projectivity
(blueprint: lem-sfb-semihereditary-finite-free-submodule).

Proof: induct on n. For n = 0 the submodule is zero, and the zero map supplies every
required lift (def-weil-pbc-projective-module). At rank n + 1, project K onto the last
coordinate. Its image I is an ideal generated by the images of any finite generating
family of K (def-weil-finitely-generated-module), hence projective by the hypothesis.
Lift the identity of I through K onto I to obtain a section s
(def-weil-pbc-projective-module). Write p for this projection with codomain I and put
L = ker p. The retraction q(k) = k - s(p(k)) onto L sends the chosen generators of K
to generators of L (def-weil-finitely-generated-module). Deleting the last coordinate
identifies L with a finitely generated submodule of R^n. Induction makes that submodule
projective, and transporting lifts along the identification makes L projective
(def-weil-pbc-projective-module). Finally, given a surjection t : A onto B and a linear
map f : K to B, lift f restricted to L to a map vL : L to A and lift f composed with s
to a map vI : I to A. Then v(k) = vL(q(k)) + vI(p(k)) is linear and t(v(k)) = f(k).
The lifting characterization proves K projective (def-weil-pbc-projective-module). -/
theorem projective_of_finite_of_projective_ideals
    (R : Type u) [CommRing R]
    (hR : ∀ I : Ideal R, I.FG → Module.Projective R I)
    (n : ℕ) (K : Submodule R (Fin n → R)) [Module.Finite R K] :
    Module.Projective R K := by
  induction n with
  | zero => infer_instance
  | succ n ih =>
    let p : K →ₗ[R] R := (LinearMap.proj (0 : Fin (n + 1))).comp K.subtype
    let I : Ideal R := p.range
    have : Module.Projective R I := hR I (Submodule.fg_range p)
    obtain ⟨s, hs⟩ := Module.projective_lifting_property p.rangeRestrict
      (LinearMap.id : I →ₗ[R] I) p.surjective_rangeRestrict
    have hs' (x : I) : p (s x) = x := by
      exact congrArg Subtype.val (DFunLike.congr_fun hs x)
    let q : K →ₗ[R] LinearMap.ker p :=
      (LinearMap.id - s.comp p.rangeRestrict).codRestrict (LinearMap.ker p) (by
        intro x
        change p (x - s (p.rangeRestrict x)) = 0
        rw [map_sub, hs']
        exact sub_self _)
    have hq (x : LinearMap.ker p) : q x = x := by
      apply Subtype.ext
      change (x : K) - s (p.rangeRestrict x) = x
      have hx : p.rangeRestrict x = 0 := Subtype.ext x.property
      rw [hx, map_zero, sub_zero]
    have : Module.Finite R (LinearMap.ker p) :=
      Module.Finite.of_surjective q (fun x ↦ ⟨x, hq x⟩)
    let d : LinearMap.ker p →ₗ[R] (Fin n → R) :=
      { toFun := fun x i ↦ (x : K).val i.succ
        map_add' := fun x y ↦ rfl
        map_smul' := fun a x ↦ rfl }
    have hd : Function.Injective d := by
      intro x y h
      apply Subtype.ext
      apply Subtype.ext
      funext i
      refine Fin.cases ?_ (fun j ↦ congrFun h j) i
      exact x.property.trans y.property.symm
    have : Module.Projective R d.range := ih d.range
    have : Module.Projective R (LinearMap.ker p) :=
      Module.Projective.of_equiv (LinearEquiv.ofInjective d hd).symm
    apply Module.Projective.of_lifting_property
    intro A B _ _ _ _ t f ht
    obtain ⟨vL, hvL⟩ := Module.projective_lifting_property t
      (f.comp (LinearMap.ker p).subtype) ht
    obtain ⟨vI, hvI⟩ := Module.projective_lifting_property t (f.comp s) ht
    refine ⟨vL.comp q + vI.comp p.rangeRestrict, ?_⟩
    ext x
    change t (vL (q x) + vI (p.rangeRestrict x)) = f x
    rw [map_add]
    change (t.comp vL) (q x) + (t.comp vI) (p.rangeRestrict x) = f x
    rw [hvL, hvI]
    change f (x - s (p.rangeRestrict x)) + f (s (p.rangeRestrict x)) = f x
    rw [map_sub, sub_add_cancel]

end Submodule
