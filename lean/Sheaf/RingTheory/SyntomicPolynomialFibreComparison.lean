module

public import Mathlib.RingTheory.LocalRing.ResidueField.Fiber
public import Sheaf.RingTheory.CompleteIntersectionOverField
import Mathlib.RingTheory.TensorProduct.MvPolynomial
import Sheaf.RingTheory.FibreLocalRingNaturalIso

/-! # Comparison of a fixed polynomial presentation with its closed fibre

Source: Stacks Project, Tag 00SY, proof of (3) implies (2), first two paragraphs;
Tag 0H9M for the localized fibre comparison.
(blueprint: lem-weil-pbc-syntomic-polynomial-fibre-comparison).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

@[expose] public section

universe u v

open scoped TensorProduct

namespace Algebra

set_option backward.isDefEq.respectTransparency.types false in
private noncomputable def polynomial_fiber_equiv_quotient
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (n : ℕ) (φ : MvPolynomial (Fin n) R →ₐ[R] S) (hφ : Function.Surjective φ)
    (p : Ideal R) [p.IsPrime] :
    p.Fiber S ≃ₐ[p.ResidueField] MvPolynomial (Fin n) p.ResidueField ⧸
      ((RingHom.ker φ.toRingHom).map (MvPolynomial.map (algebraMap R p.ResidueField))) := by
  let k := p.ResidueField
  let Ibar := (RingHom.ker φ.toRingHom).map (MvPolynomial.map (algebraMap R k))
  let D := MvPolynomial (Fin n) k ⧸ Ibar
  refine .ofAlgHom (Algebra.TensorProduct.lift (Algebra.ofId k D)
    (AlgHom.liftOfSurjective φ hφ
      ((Ideal.Quotient.mkₐ R Ibar).comp (MvPolynomial.mapAlgHom (Algebra.ofId R k))) ?_)
    (fun _ _ ↦ .all _ _))
    (Ideal.Quotient.liftₐ Ibar
      (MvPolynomial.aeval (fun i ↦ (1 ⊗ₜ[R] φ (MvPolynomial.X i) : p.Fiber S))) ?_) ?_ ?_
  · simp [Ibar, AlgHom.comp_toRingHom, ← RingHom.comap_ker,
      ← Ideal.map_le_iff_le_comap]
  · change Ibar ≤ RingHom.ker (MvPolynomial.aeval _).toRingHom
    rw [Ideal.map_le_iff_le_comap, RingHom.comap_ker]
    have hh : ((MvPolynomial.aeval
        (fun i ↦ (1 ⊗ₜ[R] φ (MvPolynomial.X i) : p.Fiber S))).restrictScalars R).comp
        (MvPolynomial.mapAlgHom (Algebra.ofId R k)) =
        Algebra.TensorProduct.includeRight.comp φ := by
      ext i
      simp
    exact .trans_eq (by intro; aesop) congr(RingHom.ker $hh).symm
  · apply Ideal.Quotient.algHom_ext
    ext i
    simp [Ibar, k, Ideal.Quotient.liftₐ]
  · ext x
    obtain ⟨x, rfl⟩ := hφ x
    have hh : ((MvPolynomial.aeval
        (fun i ↦ (1 ⊗ₜ[R] φ (MvPolynomial.X i) : p.Fiber S))).restrictScalars R).comp
        (MvPolynomial.mapAlgHom (Algebra.ofId R k)) =
        Algebra.TensorProduct.includeRight.comp φ := by
      ext i
      simp
    simp only [AlgHom.restrictScalars_apply, Algebra.TensorProduct.includeRight_apply,
      AlgHom.id_apply, Algebra.TensorProduct.lift_tmul, map_one, one_mul,
      AlgHom.liftOfSurjective_apply, AlgHom.comp_apply]
    exact AlgHom.congr_fun hh x


private theorem polynomial_fiber_equiv_quotient_tmul
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (n : ℕ) (φ : MvPolynomial (Fin n) R →ₐ[R] S) (hφ : Function.Surjective φ)
    (p : Ideal R) [p.IsPrime] (a : p.ResidueField) (b : MvPolynomial (Fin n) R) :
    polynomial_fiber_equiv_quotient n φ hφ p (a ⊗ₜ[R] φ b) =
      Ideal.Quotient.mk _
        (MvPolynomial.C a * MvPolynomial.map (algebraMap R p.ResidueField) b) := by
  simp only [polynomial_fiber_equiv_quotient, AlgEquiv.ofAlgHom_apply,
    Algebra.TensorProduct.lift_tmul, AlgHom.liftOfSurjective_apply,
    AlgHom.comp_apply, MvPolynomial.mapAlgHom_apply]
  change algebraMap p.ResidueField _ a * Ideal.Quotient.mk _ _ = _
  rw [← Ideal.Quotient.mk_algebraMap, ← map_mul]
  rfl

private theorem completeIntersection_of_algEquiv
    {k T U : Type*} [Field k] [CommRing T] [CommRing U] [Algebra k T] [Algebra k U]
    (e : T ≃ₐ[k] U) (h : IsGlobalCompleteIntersection k U) :
    IsGlobalCompleteIntersection k T := by
  rcases h with hzero | ⟨n, c, f, hcn, ⟨E⟩, hdim⟩
  · exact Or.inl (e.toEquiv.subsingleton_congr.mpr hzero)
  · refine Or.inr ⟨n, c, f, hcn, ⟨E.trans e.symm⟩, ?_⟩
    let H := PrimeSpectrum.homeomorphOfRingEquiv e.toRingEquiv
    exact H.isHomeomorph.topologicalKrullDim_eq.trans hdim

set_option maxHeartbeats 800000 in
-- The three comparison equivalences involve several localization algebra towers.
/-- Base change and localization identify the presentation ideal in the closed fibre.
This is a comparison assertion and contains no generator-count conclusion.
Source: Stacks Project, Tag 00SY, proof of (3) implies (2), first two paragraphs;
Tag 0H9M. (blueprint: lem-weil-pbc-syntomic-polynomial-fibre-comparison).

Proof: Put p=q∩R, k=κ(p), P=R[x], I=ker φ, Q=φ⁻¹(q), A=P_Q,
and m=pA. Let Ibar be the ideal generated by the coefficientwise images of I
in k[x]. Surjectivity of φ identifies S with P/I. Right exactness of base
change and the polynomial scalar-extension equivalence identify p.Fiber S
with k[x]/Ibar as k-algebras. Let t be the inverse image, under this equivalence,
of the fibre prime corresponding to q. Pulling a principal CI neighbourhood back
through the equivalence gives the stated neighbourhood at t: localization away
from corresponding elements gives k-algebra equivalent rings, which preserve
both polynomial quotient presentations and Krull dimension.
The inverse image of t in k[x] corresponds under polynomial scalar extension
to the fibre prime over Q. The natural local fibre comparison identifies A/m
with k[x] localized at that inverse image. Its formula sends the class of f/1
to the coefficientwise image of f divided by 1. Mapping the ideal I along this
formula and using preservation of ideal spans gives the displayed ideal equality.
No flatness or finiteness of I is used: tensor products preserve quotient
presentations by right exactness. The given prime excludes the zero local fibre;
zero variables and a zero presentation ideal cause no change in the comparisons. -/
theorem exists_syntomic_polynomial_fibre_comparison
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (q : PrimeSpectrum S) (n : ℕ) (φ : MvPolynomial (Fin n) R →ₐ[R] S)
    (hφ : Function.Surjective φ)
    (hci : ∃ h : (q.asIdeal.comap (algebraMap R S)).Fiber S,
      h ∉ (PrimeSpectrum.preimageEquivFiber R S (q.comap (algebraMap R S))
        ⟨q, rfl⟩).asIdeal ∧
      IsGlobalCompleteIntersection (q.asIdeal.comap (algebraMap R S)).ResidueField
        (Localization.Away h)) :
    let p := q.asIdeal.comap (algebraMap R S)
    let k := p.ResidueField
    let P := MvPolynomial (Fin n) R
    let A := Localization.AtPrime (q.asIdeal.comap φ.toRingHom)
    let m := p.map (algebraMap R A)
    let Ibar := (RingHom.ker φ.toRingHom).map (MvPolynomial.map (algebraMap R k))
    ∃ t : PrimeSpectrum (MvPolynomial (Fin n) k ⧸ Ibar),
      (∃ h : MvPolynomial (Fin n) k ⧸ Ibar,
        h ∉ t.asIdeal ∧ IsGlobalCompleteIntersection k (Localization.Away h)) ∧
      ∃ e : (A ⧸ m) ≃+*
          Localization.AtPrime (t.asIdeal.comap (Ideal.Quotient.mk Ibar)),
        ((RingHom.ker φ.toRingHom).map (algebraMap P A)).map
            (e.toRingHom.comp (Ideal.Quotient.mk m)) =
          Ibar.map (algebraMap _
            (Localization.AtPrime (t.asIdeal.comap (Ideal.Quotient.mk Ibar)))) := by
  classical
  dsimp only
  let p := q.asIdeal.comap (algebraMap R S)
  let k := p.ResidueField
  let P := MvPolynomial (Fin n) R
  let Pk := MvPolynomial (Fin n) k
  let I := RingHom.ker φ.toRingHom
  let Q := q.asIdeal.comap φ.toRingHom
  let A := Localization.AtPrime Q
  let m := p.map (algebraMap R A)
  let ρ : P →+* Pk := MvPolynomial.map (algebraMap R k)
  let Ibar := I.map ρ
  let F := p.Fiber P
  let j : P →+* F := Algebra.TensorProduct.includeRight.toRingHom
  let E : F ≃ₐ[k] Pk := MvPolynomial.algebraTensorAlgEquiv R k
  let EF := PrimeSpectrum.preimageEquivFiber R S (q.comap (algebraMap R S))
  let qb := EF ⟨q, rfl⟩
  let eF : p.Fiber S ≃ₐ[k] (Pk ⧸ Ibar) := polynomial_fiber_equiv_quotient n φ hφ p
  let t : PrimeSpectrum (Pk ⧸ Ibar) := qb.comap eF.symm.toRingHom
  let Qk := t.asIdeal.comap (Ideal.Quotient.mk Ibar)
  let U := Qk.comap E.toRingHom
  have hq : qb.asIdeal.comap Algebra.TensorProduct.includeRight.toRingHom = q.asIdeal := by
    exact congrArg (fun z ↦ z.val.asIdeal) (EF.symm_apply_apply ⟨q, rfl⟩)
  have heF (a : P) : eF (1 ⊗ₜ[R] φ a) = Ideal.Quotient.mk Ibar (ρ a) := by
    simpa only [eF, Ibar, ρ, I, Pk, k, MvPolynomial.C_1, one_mul] using
      polynomial_fiber_equiv_quotient_tmul n φ hφ p 1 a
  have hgj (a : P) : E (j a) = ρ a := by
    change MvPolynomial.algebraTensorAlgEquiv R k (1 ⊗ₜ[R] a) = ρ a
    rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
  have hcontract : U.comap j = Q := by
    ext a
    change E (j a) ∈ Qk ↔ φ a ∈ q.asIdeal
    rw [hgj]
    change eF.symm (Ideal.Quotient.mk Ibar (ρ a)) ∈ qb.asIdeal ↔ φ a ∈ q.asIdeal
    rw [← heF, eF.symm_apply_apply]
    exact (show (1 ⊗ₜ[R] φ a) ∈ qb.asIdeal ↔ φ a ∈ q.asIdeal by
      change φ a ∈ qb.asIdeal.comap Algebra.TensorProduct.includeRight.toRingHom ↔ _
      rw [hq])
  have hcit : ∃ h : Pk ⧸ Ibar,
      h ∉ t.asIdeal ∧ IsGlobalCompleteIntersection k (Localization.Away h) := by
    obtain ⟨h, hh, hci⟩ := hci
    refine ⟨eF h, ?_, ?_⟩
    · change eF.symm (eF h) ∉ qb.asIdeal
      rwa [eF.symm_apply_apply]
    · let EL : Localization.Away (eF h) ≃ₐ[k] Localization.Away h :=
        IsLocalization.algEquivOfAlgEquiv
          (M := Submonoid.powers (eF h)) (T := Submonoid.powers h)
          (Localization.Away (eF h)) (Localization.Away h) eF.symm (by
          rw [Submonoid.map_powers]
          exact congrArg Submonoid.powers (eF.symm_apply_apply h))
      exact completeIntersection_of_algEquiv EL hci
  have model : ∀ (Q' : Ideal P) [Q'.IsPrime], Q' = U.comap j →
      ∃ e : (Localization.AtPrime Q' ⧸
          (p.map (algebraMap R P)).map (algebraMap P (Localization.AtPrime Q'))) ≃+*
          Localization.AtPrime U,
        ∀ a : P, e (Ideal.Quotient.mk _ (algebraMap P (Localization.AtPrime Q') a)) =
          algebraMap F (Localization.AtPrime U) (j a) := by
    intro Q' hQ' hQU
    subst Q'
    obtain ⟨_, _, _, e, he⟩ := Ideal.Fiber.localRingHom_surjective_ker_quotientEquiv p U
    refine ⟨e, fun a ↦ ?_⟩
    rw [he]
    exact Localization.localRingHom_to_map _ _ _ rfl a
  obtain ⟨e₀, he₀⟩ := model Q hcontract.symm
  have hm : m = (p.map (algebraMap R P)).map (algebraMap P A) := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  let e₁ := Localization.localRingEquiv U Qk E.toRingEquiv rfl
  let e₂ := Ideal.quotientEquivAlgOfEq A hm
  let e := e₂.toRingEquiv.trans (e₀.trans e₁)
  have he (a : P) : e (Ideal.Quotient.mk m (algebraMap P A a)) =
      algebraMap Pk (Localization.AtPrime Qk) (ρ a) := by
    change e₁ (e₀ (e₂ (Ideal.Quotient.mk m (algebraMap P A a)))) = _
    rw [Ideal.quotientEquivAlgOfEq_mk, he₀]
    change Localization.localRingHom U Qk E.toRingHom rfl
      (algebraMap F (Localization.AtPrime U) (j a)) = _
    rw [Localization.localRingHom_to_map]
    exact congrArg (algebraMap Pk (Localization.AtPrime Qk)) (hgj a)
  refine ⟨t, hcit, e, ?_⟩
  change (I.map (algebraMap P A)).map (e.toRingHom.comp (Ideal.Quotient.mk m)) =
    (I.map ρ).map (algebraMap Pk (Localization.AtPrime Qk))
  rw [Ideal.map_map, Ideal.map_map]
  exact congrArg (fun f ↦ I.map f) (RingHom.ext he)

end Algebra
