import WeilConjectures.Mathlib.RingTheory.Henselian

/-!
# Henselian maximal-ideal pairs descend to quotients

Source: Stacks Project, More on Algebra, Tags 09XK and 0DYD, with the finite-algebra
criterion of Tag 09XI (3) (blueprint: lem-weil-pbc-quotient-henselian-pair).
-/

universe u

namespace IsLocalRing

/-- If the maximal-ideal pair of a local ring `A` is henselian and `I` is contained in
its maximal ideal, the pair `(A/I, m/I)` is henselian (`HenselianRing`, the recorded notion of
def-weil-pbc-henselian-terminology; the node's finite-algebra idempotent wording is its
equivalent form, Tag 09XI (3)).
Source: Stacks Project, More on Algebra, Tag 09XK applied to the quotient map, as in
Tag 0DYD, (2) ⇒ (1), using Tag 09XI (3)
(blueprint: lem-weil-pbc-quotient-henselian-pair).

Proof:
1. A finite `A/I`-algebra is finite over `A`: lift the coefficients of a finite set
   of module generators through the surjection `A → A/I`.
2. The ideals `(m/I)B` and `mB` coincide: both are generated by the images in `B`
   of the elements of `m`, under the composite structure map `A → A/I → B`.
3. Henselianity of `(A,m)` in `def-weil-pbc-henselian-terminology` gives unique
   idempotent lifts in every such finite `A`-algebra. Step 2 identifies their reduction
   with reduction modulo `(m/I)B`. Thus Tag 09XI (3) gives henselianity of `(A/I,m/I)`.
   `HenselianRing` is the equivalent recorded predicate of that definition node. -/
theorem henselianRing_quotient_maximalIdeal
    (A : Type u) [CommRing A] [IsLocalRing A]
    [HenselianRing A (maximalIdeal A)] (I : Ideal A) (hI : I ≤ maximalIdeal A) :
    HenselianRing (A ⧸ I) ((maximalIdeal A).map (Ideal.Quotient.mk I)) := by
  sorry

end IsLocalRing
