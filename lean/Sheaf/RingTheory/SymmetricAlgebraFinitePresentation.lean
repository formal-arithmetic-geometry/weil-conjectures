import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.RingTheory.FinitePresentation
import Mathlib.RingTheory.Extension.Presentation.Basic

/-!
# Generators and finite presentation of symmetric algebras

Source: Stacks Project, Algebra, Section 00DM, Lemma 00DO, and Definitions 0518 and 00F3
(blueprint: lem-weil-pbc-symmetric-algebra-finite-presentation).
-/

universe u v

open scoped BigOperators

namespace SymmetricAlgebra

/-- Module generators give algebra generators, and a finitely presented module has a
finitely presented symmetric algebra, explicitly a presentation (`Algebra.Presentation`)
as a polynomial algebra modulo linear forms.
Every quotient by a finitely generated ideal is then finitely presented over the same ring.
Source: Stacks Project, Algebra, Section 00DM, Lemma 00DO, Definitions 0518 and 00F3,
and Lemma 00R2 (blueprint: lem-weil-pbc-symmetric-algebra-finite-presentation).

Proof:
1. The subalgebra generated by `ι(M)` is all of `Sym(M)`: the universal property
   (lem-weil-pbc-symmetric-algebra-universal-property) gives a map back to this subalgebra,
   whose composite with inclusion is the identity by uniqueness.
2. Linearity expresses every `ι(x)` in terms of the images of the chosen module generators.
3. Choose a finite module presentation. By lem-weil-pbc-symmetric-algebra-quotient-module,
   its symmetric algebra is the quotient of the symmetric algebra of the finite free
   module by the ideal generated by the images of the finitely many module relations.
4. By lem-weil-pbc-symmetric-algebra-free-module-polynomial, the free symmetric algebra
   is a polynomial algebra. Each relation becomes the linear form given by its coordinates.
   This gives the asserted `Algebra.Presentation` (variables the images of the module
   generators, relations the linear forms) and hence finite presentation.
5. Apply lem-weil-pbc-finite-presentation-quotient-fg-ideal to each finitely generated ideal;
   equivalently append lifts of its generators to the finite polynomial relations. -/
theorem generators_and_finitePresentation (R : Type u) (M : Type v) [CommRing R]
    [AddCommGroup M] [Module R M] :
    (∀ (n : ℕ) (x : Fin n → M), Submodule.span R (Set.range x) = ⊤ →
      Algebra.adjoin R (Set.range (fun i : Fin n ↦ ι R M (x i))) = ⊤) ∧
    (Module.FinitePresentation R M →
      Algebra.FinitePresentation R (SymmetricAlgebra R M) ∧
      (∃ (n m : ℕ) (P : Algebra.Presentation R (SymmetricAlgebra R M) (Fin n) (Fin m))
        (a : Fin m → Fin n → R),
        ∀ j : Fin m, P.relation j =
          ∑ i : Fin n, a j i • (MvPolynomial.X i : MvPolynomial (Fin n) R)) ∧
      (∀ I : Ideal (SymmetricAlgebra R M), I.FG →
        Algebra.FinitePresentation R (SymmetricAlgebra R M ⧸ I))) := by
  sorry

end SymmetricAlgebra
