module

public import Sheaf.RingTheory.CohenRing
public import Mathlib.RingTheory.LocalRing.ResidueField.Defs
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Sheaf.RingTheory.IsRegularSystemOfParameters
import Mathlib.Algebra.CharP.Algebra
import Sheaf.RingTheory.CohenStructurePowerSeriesSurjection
import Sheaf.RingTheory.PowerSeriesFieldCohenRegularComplete

/-!
# Cohen power series presentations

Source: Stacks Project, Algebra, Theorem Tag 032A and Remark Tag 032C
(blueprint: lem-weil-pbc-cohen-power-series-presentation).
-/

@[expose] public section

universe u

namespace IsLocalRing

/-- A Noetherian complete local ring has a surjective local power series presentation,
with induced residue isomorphisms and the indicated regular system of parameters.
Source: Stacks Project, Algebra, Theorem Tag 032A, part (2) and final proof paragraph;
Remark Tag 032C (blueprint: lem-weil-pbc-cohen-power-series-presentation).

Proof:
1. Apply lem-weil-pbc-cohen-structure-power-series-surjection to obtain the surjection
   from power series over a characteristic-zero field or a Cohen ring of the residue
   characteristic. Noetherianity makes the maximal ideal finitely generated.
2. Apply lem-weil-pbc-power-series-field-cohen-regular-complete: the source is local,
   Noetherian, complete and regular, its residue field is that of the coefficients, and
   its maximal ideal is generated by the variables, together with p in the Cohen case.
   Its dimension is n in the field case and n+1 in the Cohen case.
3. The inverse image of the target maximal ideal is maximal by surjectivity. Locality
   of the source identifies it with the source maximal ideal. Thus the map is local,
   and surjectivity maps the source maximal ideal onto the target maximal ideal.
4. The induced residue map is surjective with zero kernel, hence an isomorphism.
   Composing the coefficient residue isomorphism from step 2 gives the indicated
   coefficient map to the target residue field. The commuting equalities identify
   these equivalences with the maps induced by the chosen surjection.
5. Map the source maximal ideal generators across the surjection. Their ideal spans
   give precisely the target maximal ideal by step 3.
6. Step 2 gives completeness and regularity. The listed generators (the variables, preceded
   by p in the Cohen case) number exactly the Krull dimension, so they form a regular system
   of parameters (def-weil-pbc-regular-system-of-parameters). -/
theorem cohen_power_series_presentation
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] :
    ∃ (n : ℕ) (Λ : Type u) (_ : CommRing Λ) (_ : IsLocalRing Λ)
      (_ : IsRegularLocalRing (MvPowerSeries (Fin n) Λ)),
      IsAdicComplete (maximalIdeal (MvPowerSeries (Fin n) Λ))
        (MvPowerSeries (Fin n) Λ) ∧
      ∃ q : MvPowerSeries (Fin n) Λ →+* A,
        Function.Surjective q ∧ IsLocalHom q ∧
        (∃ e : ResidueField (MvPowerSeries (Fin n) Λ) ≃+* ResidueField A,
          ∀ f, e (residue (MvPowerSeries (Fin n) Λ) f) = residue A (q f)) ∧
        ((IsField Λ ∧ CharZero (ResidueField A) ∧
          (∃ e : Λ ≃+* ResidueField A,
            ∀ a, e a = residue A (q (MvPowerSeries.C a))) ∧
          Ideal.span (Set.range (fun i : Fin n ↦ q (MvPowerSeries.X i))) =
            maximalIdeal A ∧
          IsRegularSystemOfParameters
            (List.ofFn (fun i : Fin n ↦ (MvPowerSeries.X i : MvPowerSeries (Fin n) Λ)))) ∨
        (∃ p : ℕ, CharP (ResidueField A) p ∧ IsCohenRing p Λ ∧
          (∃ e : (Λ ⧸ Ideal.span {(p : Λ)}) ≃+* ResidueField A,
            ∀ a, e (Ideal.Quotient.mk _ a) = residue A (q (MvPowerSeries.C a))) ∧
          Ideal.span (insert (q (MvPowerSeries.C (p : Λ)))
            (Set.range (fun i : Fin n ↦ q (MvPowerSeries.X i)))) = maximalIdeal A ∧
          IsRegularSystemOfParameters
            (MvPowerSeries.C (p : Λ) :: List.ofFn (fun i : Fin n ↦
              (MvPowerSeries.X i : MvPowerSeries (Fin n) Λ))))) := by
  classical
  let p := ringChar (ResidueField A)
  obtain ⟨n, Λ, hcomm, hzero, hpos, q, hq⟩ :=
    cohen_structure_power_series_surjection A (maximalIdeal A).fg_of_isNoetherianRing p
  let _ := hcomm
  have hΛ : IsField Λ ∨ ∃ r : ℕ, IsCohenRing r Λ := by
    by_cases hp : p = 0
    · exact Or.inl (hzero hp).1
    · exact Or.inr ⟨p, hpos (Nat.pos_of_ne_zero hp)⟩
  rcases MvPowerSeries.power_series_field_cohen_regular_complete n hΛ with
    ⟨hfield, hnoeth, hdomain, hlocal, hm, e, he, hcomplete, hregular, hdim⟩ |
    ⟨r, hcohen, hnoeth, hdomain, hlocal, hm, e, he, hcomplete, hregular, hdim⟩
  · let _ := hfield.toField
    let _ := hnoeth
    let _ := hdomain
    let _ := hlocal
    let _ := hregular
    have hqLocal := IsLocalHom.of_surjective q hq
    let f := ResidueField.map q
    have hf : Function.Bijective f := by
      refine ⟨f.injective, ?_⟩
      intro a
      obtain ⟨a, rfl⟩ := residue_surjective a
      obtain ⟨b, rfl⟩ := hq a
      exact ⟨residue _ b, rfl⟩
    let eq := RingEquiv.ofBijective f hf
    have heq (b) : eq (residue _ b) = residue A (q b) := rfl
    let ec := ((RingEquiv.quotientBot Λ).symm.trans e).trans eq
    have hec (a : Λ) : ec a = residue A (q (MvPowerSeries.C a)) := by
      change eq (e (Ideal.Quotient.mk _ a)) = _
      rw [he]
      exact heq _
    have hp : p = 0 := by
      by_contra hp
      obtain ⟨_, hd, hv, _, _⟩ := hpos (Nat.pos_of_ne_zero hp)
      let _ := hd
      let _ := hv
      exact IsDiscreteValuationRing.not_isField Λ hfield
    have hcharΛ := (hzero hp).2
    have hchar : CharZero (ResidueField A) :=
      charZero_of_injective_ringHom (f := ec.toRingHom) ec.injective
    refine ⟨n, Λ, inferInstance, inferInstance, hregular, hcomplete,
      q, hq, hqLocal, ⟨eq, heq⟩, Or.inl ?_⟩
    refine ⟨hfield, hchar, ⟨ec, hec⟩, ?_, ?_⟩
    · have hmap := map_maximalIdeal_of_surjective q hq
      rw [hm, Ideal.map_span, ← Set.range_comp] at hmap
      exact hmap
    · constructor
      · simpa only [List.mem_ofFn', Set.ofPred_mem_eq] using hm.symm
      · simpa only [List.length_ofFn] using hdim.symm
  · have hcohenCopy := hcohen
    obtain ⟨hprime, hd, hv, _, _⟩ := hcohen
    let _ := hd
    let _ := hv
    let _ := hnoeth
    let _ := hdomain
    let _ := hlocal
    let _ := hregular
    have hqLocal := IsLocalHom.of_surjective q hq
    let f := ResidueField.map q
    have hf : Function.Bijective f := by
      refine ⟨f.injective, ?_⟩
      intro a
      obtain ⟨a, rfl⟩ := residue_surjective a
      obtain ⟨b, rfl⟩ := hq a
      exact ⟨residue _ b, rfl⟩
    let eq := RingEquiv.ofBijective f hf
    have heq (b) : eq (residue _ b) = residue A (q b) := rfl
    let ec := e.trans eq
    have hec (a : Λ) : ec (Ideal.Quotient.mk _ a) =
        residue A (q (MvPowerSeries.C a)) := by
      change eq (e (Ideal.Quotient.mk _ a)) = _
      rw [he]
      exact heq _
    have hchar : CharP (ResidueField A) r := by
      apply (CharP.charP_iff_prime_eq_zero hprime).mpr
      have hr : Ideal.Quotient.mk (Ideal.span {(r : Λ)}) (r : Λ) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      simpa only [map_natCast, map_zero] using congrArg ec hr
    refine ⟨n, Λ, inferInstance, inferInstance, hregular, hcomplete,
      q, hq, hqLocal, ⟨eq, heq⟩, Or.inr ?_⟩
    refine ⟨r, hchar, hcohenCopy, ⟨ec, hec⟩, ?_, ?_⟩
    · have hmap := map_maximalIdeal_of_surjective q hq
      rw [hm, Ideal.map_span, Set.image_insert_eq, ← Set.range_comp] at hmap
      exact hmap
    · constructor
      · simpa only [List.mem_cons, List.mem_ofFn', Set.ofPred_or, Set.ofPred_eq_eq_singleton,
          Set.singleton_union, Set.ofPred_mem_eq] using hm.symm
      · simpa only [List.length_cons, List.length_ofFn] using hdim.symm

end IsLocalRing
