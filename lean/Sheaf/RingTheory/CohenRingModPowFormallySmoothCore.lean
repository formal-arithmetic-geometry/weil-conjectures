module
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.Data.ZMod.Basic
public import Sheaf.RingTheory.CohenRing
import Sheaf.RingTheory.ExistsLiftOfFieldCharP
import Sheaf.RingTheory.CohenRingModPowFormallySmoothStep
import Mathlib.Algebra.CharP.Basic

@[expose] public section
universe u
namespace IsDiscreteValuationRing
/-- The formal smoothness clause for a Cohen ring modulo a prime power.
Source: Stacks Project, Algebra, Lemma Tag 0329.
(blueprint: lem-weil-pbc-cohen-ring-mod-pn-formally-smooth-core)

The proof is the induction on the exponent in Tag 0329.  For exponent one, the quotient is
the residue field of `Λ`, which has characteristic `p`, so the residue-field square-zero
lifting theorem gives formal smoothness.  For the induction step, apply the flat square-zero
quotient criterion to `ZMod (p ^ (m+1)) → Λ ⧸ (p ^ (m+1))`: the kernel generated by `p^m`
is square-zero, the map is flat because a Cohen ring is torsion-free over `ℤ`, and the
quotient map is the induction hypothesis.  The identification of the lifting property with
`Algebra.FormallySmooth` is the standard `iff_comp_surjective` characterization. -/
theorem cohenRing_mod_pow_formallySmooth_core
    (p : ℕ) (Λ : Type u) [CommRing Λ] (hΛ : IsCohenRing p Λ)
    (n : ℕ) (hn : 1 ≤ n) :
    ∀ [Algebra (ZMod (p ^ n)) (Λ ⧸ Ideal.span {(p : Λ) ^ n})],
      Algebra.FormallySmooth (ZMod (p ^ n)) (Λ ⧸ Ideal.span {(p : Λ) ^ n}) := by
  obtain ⟨hp, hdomain, hdvr, hmax, hcomplete⟩ := hΛ
  let := hdomain
  let := hdvr
  have hbase : ∀ [Algebra (ZMod p) (Λ ⧸ Ideal.span {(p : Λ)})],
      Algebra.FormallySmooth (ZMod p) (Λ ⧸ Ideal.span {(p : Λ)}) := by
    intro _
    let K := Λ ⧸ Ideal.span {(p : Λ)}
    let : (Ideal.span {(p : Λ)}).IsMaximal := hmax ▸ inferInstance
    let : Field K := Ideal.Quotient.field _
    have hpK : (p : K) = 0 := by
      rw [← map_natCast (Ideal.Quotient.mk _) p]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    let : CharP K p := (CharP.charP_iff_prime_eq_zero hp).mpr hpK
    apply Algebra.FormallySmooth.iff_comp_surjective.mpr
    intro D _ _ J hJ g
    have hpD : (p : D) = 0 := by
      have := congrArg (algebraMap (ZMod p) D) (CharP.cast_eq_zero (ZMod p) p)
      simpa only [map_natCast, map_zero] using this
    obtain ⟨f, hf⟩ := RingHom.exists_lift_of_field_charP K D p hp.pos hpD J 2
      (by decide) hJ g.toRingHom
    refine ⟨{ toRingHom := f, commutes' := ?_ }, ?_⟩
    · intro r
      obtain ⟨k, rfl⟩ := ZMod.intCast_surjective r
      simp
    · ext x
      exact DFunLike.congr_fun hf x
  have hall : ∀ m, ∀ [Algebra (ZMod (p ^ (m + 1)))
      (Λ ⧸ Ideal.span {(p : Λ) ^ (m + 1)})],
      Algebra.FormallySmooth (ZMod (p ^ (m + 1)))
        (Λ ⧸ Ideal.span {(p : Λ) ^ (m + 1)}) := by
    intro m
    induction m with
    | zero =>
      rw [Nat.zero_add, pow_one, pow_one]
      exact @hbase
    | succ m ih =>
      exact cohenRing_mod_pow_formallySmooth_step p Λ ⟨hp, hdomain, hdvr, hmax,
        hcomplete⟩ (m + 1) (by omega) (@ih)
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hn
  have heq : 1 + m = m + 1 := Nat.add_comm _ _
  rw [heq]
  exact @hall m
end IsDiscreteValuationRing
