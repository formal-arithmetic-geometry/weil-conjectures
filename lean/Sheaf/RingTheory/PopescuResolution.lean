import Sheaf.RingTheory.SingularIdeal
import Mathlib.RingTheory.FinitePresentation

/-!
# Resolutions of Popescu's local problem

Source: Stacks Project, Smoothing Ring Maps, Situation 07F7 and the paragraph following it
in Section 07F6 (blueprint: def-weil-pbc-popescu-resolution).

## Main definitions

* `Algebra.popescuIdeal`: the radical of the extended singular ideal, formed with a given map.
* `Algebra.IsPopescuResolution`: the conditions on a factorization resolving the local problem.
* `Algebra.CanBePopescuResolved`: existence of such a factorization.
-/

universe u v w t

namespace Algebra

/-- The ideal `h_A = sqrt(H_{A/R} Λ)`, with extension formed using `α`.
`Ideal.map` is the ideal generated by the image, rather than just the image as a set.
Source: Stacks Project, Smoothing Ring Maps, Situation 07F7
(blueprint: def-weil-pbc-popescu-resolution). -/
def popescuIdeal {R : Type u} {A : Type v} {Λ : Type t}
    [CommRing R] [CommRing A] [CommRing Λ] [Algebra R A] [Algebra R Λ]
    (α : A →ₐ[R] Λ) : Ideal Λ :=
  (Ideal.map α.toRingHom (singularIdeal R A)).radical

/-- A factorization `A → B → Λ` resolves the local problem at the prime `q` if `B` is
finitely presented over `R`, its composite is `α`, and `h_A ≤ h_B` while `h_B ≰ q`.
The inclusion of the two extended singular ideals is imposed, not inferred from the maps.
Source: Stacks Project, Smoothing Ring Maps, the definition following Situation 07F7
in Section 07F6 (blueprint: def-weil-pbc-popescu-resolution). -/
def IsPopescuResolution {R : Type u} {A : Type v} {B : Type w} {Λ : Type t}
    [CommRing R] [CommRing A] [CommRing B] [CommRing Λ]
    [Algebra R A] [Algebra R B] [Algebra R Λ]
    [IsNoetherianRing R] [FinitePresentation R A]
    (α : A →ₐ[R] Λ) (q : PrimeSpectrum Λ) (β : A →ₐ[R] B) (γ : B →ₐ[R] Λ) : Prop :=
  FinitePresentation R B ∧ γ.comp β = α ∧
    popescuIdeal α ≤ popescuIdeal γ ∧ ¬ popescuIdeal γ ≤ q.asIdeal

/-- The local problem can be resolved if it admits a finitely presented intermediate
`R`-algebra and maps satisfying `IsPopescuResolution`. The intermediate carrier is taken
in `max u v`: every finitely presented `R`-algebra can be represented there, since it is
an algebra quotient of a polynomial ring in finitely many variables over `R`.
Source: Stacks Project, Smoothing Ring Maps, the definition following Situation 07F7
in Section 07F6 (blueprint: def-weil-pbc-popescu-resolution). -/
def CanBePopescuResolved {R : Type u} {A : Type v} {Λ : Type t}
    [CommRing R] [CommRing A] [CommRing Λ] [Algebra R A] [Algebra R Λ]
    [IsNoetherianRing R] [FinitePresentation R A]
    (α : A →ₐ[R] Λ) (q : PrimeSpectrum Λ) : Prop :=
  ∃ (B : Type (max u v)) (_ : CommRing B) (_ : Algebra R B),
    ∃ (β : A →ₐ[R] B) (γ : B →ₐ[R] Λ), IsPopescuResolution α q β γ

end Algebra
