module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.LinearAlgebra.TensorProduct.Basis

/-!
# Coefficient algebra for maps into a finite free algebra

Source: Stacks Project, Tag 05Y6, proof of lemma-hom-from-finite-free-into-affine,
in the relative B-algebra form of BLR 7.6, Theorem 4 and Proposition 5(c),(d)
(blueprint: lem-sfb-finite-free-algebra-map-coordinates).

The coefficient quotient is constructed explicitly. Its Hom bijection is characterized
on the polynomial generators and is natural in the test algebra, including rank zero.
-/

@[expose] public section

universe u v w z t

open scoped TensorProduct BigOperators

namespace Algebra.FiniteFreeAlgebraMapCoordinates

variable {R : Type u} {B : Type v} {I : Type w} {K : Type z}
variable [CommRing R] [CommRing B] [Algebra R B] {d : ℕ}

/-- The universal B-algebra evaluation Ψ sending xᵢ to ∑ⱼ eⱼ ⊗ aᵢⱼ.
Source: Stacks, Tag 05Y6, coefficient construction, with the B-structure fixed
(blueprint: lem-sfb-finite-free-algebra-map-coordinates). -/
noncomputable def psi (e : Module.Basis (Fin d) R B) :
    MvPolynomial I B →ₐ[B] B ⊗[R] MvPolynomial (I × Fin d) R :=
  MvPolynomial.aeval (fun i ↦ ∑ j : Fin d, e j ⊗ₜ[R] MvPolynomial.X (i, j))

/-- The coefficient cₖⱼ of Ψ(fₖ), extracted by the tensor coordinate equivalence of the
specified basis. Source: Stacks, Tag 05Y6, coefficient construction
(blueprint: lem-sfb-finite-free-algebra-map-coordinates). -/
noncomputable def coefficient (e : Module.Basis (Fin d) R B)
    (f : K → MvPolynomial I B) (k : K) (j : Fin d) : MvPolynomial (I × Fin d) R :=
  TensorProduct.equivFinsuppOfBasisLeft e (psi e (f k)) j

/-- The ideal generated by all the coefficients cₖⱼ of the relations.
Source: Stacks, Tag 05Y6, coefficient ideal J
(blueprint: lem-sfb-finite-free-algebra-map-coordinates). -/
noncomputable def coefficientIdeal (e : Module.Basis (Fin d) R B)
    (f : K → MvPolynomial I B) : Ideal (MvPolynomial (I × Fin d) R) :=
  Ideal.span (Set.range (fun kj : K × Fin d ↦ coefficient e f kj.1 kj.2))

/-- The explicit coefficient algebra D = R[aᵢⱼ]/(cₖⱼ).
Source: Stacks, Tag 05Y6, representing affine coordinate ring
(blueprint: lem-sfb-finite-free-algebra-map-coordinates). -/
noncomputable abbrev coefficientAlgebra (e : Module.Basis (Fin d) R B)
    (f : K → MvPolynomial I B) :=
  MvPolynomial (I × Fin d) R ⧸ coefficientIdeal e f

/-- The coefficient construction represents B-algebra maps from the presented algebra
C to B ⊗ A, naturally in A; the coefficients are unique and rank zero gives D ≃ R.
Source: Stacks, Tag 05Y6, proof, in the relative B-algebra form of BLR 7.6,
Theorem 4 and Proposition 5(c),(d)
(blueprint: lem-sfb-finite-free-algebra-map-coordinates).

Proof: (1) Base change of e gives unique expansions in B ⊗ A, also for A = P;
`lem-weil-pbc-free-module-base-change-free` supplies this basis. The polynomial
universal property defines Ψ and the tensor pushout supplies the structural B-map.
(2) For u : P → A, tensoring u gives tᵤ(b ⊗ p) = b ⊗ u(p), and polynomial
uniqueness shows θᵤ = tᵤ Ψ. Hence θᵤ(fₖ) = ∑ⱼ eⱼ ⊗ u(cₖⱼ).
(3) Basis uniqueness implies θᵤ kills every fₖ exactly when u kills every cₖⱼ.
Killing these families is equivalent to killing their generated ideals, by writing
ideal elements as finite sums of multiples of generators.
(4) A map v : D → A therefore induces hᵥ : C → B ⊗ A by polynomial evaluation
and quotient descent, preserving the B-structure.
(5) Conversely, expand h(xᵢ) uniquely, evaluate P at these coefficients, and descend
to D using (3). Polynomial uniqueness and quotient surjectivity show these operations
are inverse; these use the recorded polynomial and quotient universal properties.
(6) Tensoring any s : A → A' applies s to every coefficient, proving naturality.
If d = 0, the empty basis makes B and C zero, there are no coefficient variables or
relations, and D is canonically R. Empty I or K use the same universal properties. -/
theorem represents (e : Module.Basis (Fin d) R B) (f : K → MvPolynomial I B) :
    (∀ (k : K) (c : Fin d → MvPolynomial (I × Fin d) R),
      psi e (f k) = ∑ j : Fin d, e j ⊗ₜ[R] c j ↔ c = coefficient e f k) ∧
    (∃ E : (A : Type (max u t)) → [CommRing A] → [Algebra R A] →
        (coefficientAlgebra e f →ₐ[R] A) ≃
          ((MvPolynomial I B ⧸ Ideal.span (Set.range f)) →ₐ[B] B ⊗[R] A),
      (∀ (A : Type (max u t)) [CommRing A] [Algebra R A]
          (v : coefficientAlgebra e f →ₐ[R] A) (i : I),
        E A v (Ideal.Quotient.mk _ (MvPolynomial.X i)) =
          ∑ j : Fin d, e j ⊗ₜ[R]
            v (Ideal.Quotient.mk (coefficientIdeal e f) (MvPolynomial.X (i, j)))) ∧
      (∀ (A A' : Type (max u t)) [CommRing A] [Algebra R A]
          [CommRing A'] [Algebra R A'] (s : A →ₐ[R] A')
          (v : coefficientAlgebra e f →ₐ[R] A),
        E A' (s.comp v) =
          (Algebra.TensorProduct.map (AlgHom.id B B) s).comp (E A v))) ∧
    (d = 0 → Subsingleton B ∧
      Subsingleton (MvPolynomial I B ⧸ Ideal.span (Set.range f)) ∧
      Nonempty (coefficientAlgebra e f ≃ₐ[R] R)) := by
  sorry

end Algebra.FiniteFreeAlgebraMapCoordinates
