/-!
# Localizing the scalar map to a finite tensor factor

Source: Stacks Project, More on Algebra, Tag 0EM0, the Nakayama localization step.
-/

@[expose] public section

universe u v

namespace Algebra

private theorem quotient_localization_bijective
    {R : Type u} [CommRing R] (I : Ideal R) (a : R)
    (S : Type u) [CommRing S] [Algebra R S] [IsLocalization (Submonoid.powers a) S]
    (ha : Ideal.Quotient.mk I a = 1) :
    Function.Bijective (Ideal.quotientMap
      (I.map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map) := by
  let D := S
  let φ := algebraMap R D
  let q := Ideal.Quotient.mk I
  let qD := Ideal.Quotient.mk (I.map φ)
  let f := Ideal.quotientMap (I.map φ) φ Ideal.le_comap_map
  let τ : D →+* R ⧸ I := IsLocalization.Away.lift a (ha ▸ isUnit_one)
  have hτ : ∀ r : R, τ (φ r) = q r := fun r => IsLocalization.Away.lift_eq _ _ r
  have hker : I.map φ ≤ RingHom.ker τ := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    change τ (φ r) = 0
    rw [hτ]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
  let g := Ideal.Quotient.lift (I.map φ) τ (fun d hd => hker hd)
  have hleft : Function.LeftInverse g f := by
    intro r
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    change τ (φ r) = q r
    exact hτ r
  have hright : Function.RightInverse g f := by
    have hcomp : f.comp τ = qD := by
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      ext r
      change f (τ (φ r)) = qD (φ r)
      rw [hτ]
      rfl
    intro d
    obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective d
    exact RingHom.congr_fun hcomp d
  exact ⟨hleft.injective, hright.surjective⟩


/-- A finite tensor factor generated by scalars modulo an ideal is generated by
scalars after a flat localization preserving that ideal's quotient.
Source: Stacks Project, More on Algebra, Tag 0EM0, the sentence applying Nakayama
(Tag 00DV) to make the first factor's structure map surjective.
(blueprint: lem-weil-pbc-finite-tensor-factor-localization)

Proof: Let Q be (D tensor_A B)/(1-e). It is finite over D because B is finite
 over A. Let N be the image of D in Q as a D-submodule. The hypothesis says
 Q = N + JQ. Apply Nakayama 00DV to the finite D-module Q/N: there is g with
 g-1 in J and g(Q/N)=0. Set C=D[1/g], and psi the localization map. It is flat.
 The quotient map D/J to C/JC is bijective: since g=1 modulo J, its inverse
 sends d/g^n to d modulo J. The tensor map induces a map from Q to the new
 factor. If gy is the scalar d in Q, its image there is the scalar d/g.
 Apply this to y=1 tensor b. Every pure tensor c tensor b is c times such
 an element; induction on tensors proves that every element of the new
 factor is a scalar. This proves the required surjectivity. No idempotency is
 needed for this scalar-map argument.
 If J is the unit ideal, g may be zero and C the zero ring; the proof still
 applies. It also applies when Q is zero, with g=1. -/
theorem exists_flat_tensor_factor_localization
    {A : Type u} {B : Type v} {D : Type u}
    [CommRing A] [CommRing B] [CommRing D] [Algebra A B] [Algebra A D]
    [Module.Finite A B] (J : Ideal D) (e : TensorProduct A D B)
    (h : ∀ t : TensorProduct A D B, ∃ d : D,
      t - algebraMap D (TensorProduct A D B) d ∈
        Ideal.span {1 - e} ⊔ J.map (algebraMap D (TensorProduct A D B))) :
    ∃ (C : CommRingCat.{u}) (ψ : D →+* C),
      letI : Algebra A C := (ψ.comp (algebraMap A D)).toAlgebra
      let ψA : D →ₐ[A] C := { ψ with commutes' := fun _ => rfl }
      let m := Algebra.TensorProduct.map ψA (AlgHom.id A B)
      ψ.Flat ∧
        Function.Bijective (Ideal.quotientMap (J.map ψ) ψ Ideal.le_comap_map) ∧
        Function.Surjective
          (algebraMap C (TensorProduct A C B ⧸ Ideal.span {1 - m e})) := by
  classical
  let T := TensorProduct A D B
  let K : Ideal T := Ideal.span {1 - e}
  let Q := T ⧸ K
  let q := Ideal.Quotient.mk K
  let N := (Algebra.linearMap D Q).range
  have htop : (⊤ : Submodule D Q) ≤ N ⊔ J • (⊤ : Submodule D Q) := by
    intro y _
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨d, hd⟩ := h t
    have hmem : q (t - algebraMap D T d) ∈
        J.map (algebraMap D Q) := by
      have hh : t - algebraMap D T d ∈
          J.map (algebraMap D T) ⊔ K := by simpa only [sup_comm] using hd
      have hh' := Ideal.mem_quotient_iff_mem_sup.mpr hh
      rw [Ideal.map_map] at hh'
      exact hh'
    have hmem' : q t - algebraMap D Q d ∈ J • (⊤ : Submodule D Q) := by
      rw [Ideal.smul_top_eq_map]
      exact hmem
    have hscalar : algebraMap D Q d ∈ N := ⟨d, rfl⟩
    have hh := (N ⊔ J • (⊤ : Submodule D Q)).add_mem
      (Submodule.mem_sup_left hscalar) (Submodule.mem_sup_right hmem')
    simpa only [add_sub_cancel] using hh
  obtain ⟨g, hg, hgN⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
    (I := J) (N := N) (N' := ⊤) (P := ⊤) Module.Finite.fg_top le_rfl htop
  have hscalar (t : T) : ∃ d : D, algebraMap D Q d = g • q t := by
    exact hgN (Submodule.smul_mem_pointwise_smul (q t) g ⊤ (by trivial))
  have hex : ∃ (C : CommRingCat.{u}) (ψ : D →+* C),
      letI : Algebra D C := ψ.toAlgebra
      IsLocalization (Submonoid.powers g) C := by
    refine ⟨CommRingCat.of (Localization.Away g), algebraMap D (Localization.Away g), ?_⟩
    dsimp only
    rw [toAlgebra_algebraMap]
    infer_instance
  obtain ⟨C, ψ, hloc⟩ := hex
  let : Algebra D C := ψ.toAlgebra
  have : IsLocalization (Submonoid.powers g) C := hloc
  let : Algebra A C := (ψ.comp (algebraMap A D)).toAlgebra
  let ψA : D →ₐ[A] C := { ψ with commutes' := fun _ => rfl }
  let m := Algebra.TensorProduct.map ψA (AlgHom.id A B)
  let S := TensorProduct A C B
  let KC : Ideal S := Ideal.span {1 - m e}
  let p := Ideal.Quotient.mk KC
  have hK : K ≤ KC.comap m.toRingHom := by
    apply Ideal.span_le.mpr
    intro t ht
    obtain rfl := Set.mem_singleton_iff.mp ht
    change m (1 - e) ∈ KC
    rw [map_sub, map_one]
    exact Ideal.mem_span_singleton_self _
  let qmap := Ideal.quotientMap KC m.toRingHom hK
  have hmap (d : D) : qmap (algebraMap D Q d) =
      algebraMap C (S ⧸ KC) (ψ d) := by
    change p (m (d ⊗ₜ[A] (1 : B))) = _
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    rfl
  obtain ⟨c, hc⟩ := (IsLocalization.Away.algebraMap_isUnit (S := C) g).exists_left_inv
  change c * ψ g = 1 at hc
  have hgen (b : B) : ∃ a : C,
      algebraMap C (S ⧸ KC) a = p ((1 : C) ⊗ₜ[A] b) := by
    obtain ⟨d, hd⟩ := hscalar ((1 : D) ⊗ₜ[A] b)
    have hh := congrArg qmap hd
    rw [hmap] at hh
    have hh' : algebraMap C (S ⧸ KC) (ψ d) =
        algebraMap C (S ⧸ KC) (ψ g) * p ((1 : C) ⊗ₜ[A] b) := by
      simp only [Algebra.smul_def] at hh
      rw [map_mul, hmap] at hh
      change _ = algebraMap C (S ⧸ KC) (ψ g) *
        p (m ((1 : D) ⊗ₜ[A] b)) at hh
      rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply] at hh
      exact hh
    refine ⟨c * ψ d, ?_⟩
    rw [map_mul, hh', ← mul_assoc, ← map_mul, hc, map_one, one_mul]
  have hsurj : Function.Surjective (algebraMap C (S ⧸ KC)) := by
    intro y
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul a b =>
        obtain ⟨d, hd⟩ := hgen b
        refine ⟨a * d, ?_⟩
        rw [map_mul, hd]
        change p (a ⊗ₜ[A] (1 : B)) * p ((1 : C) ⊗ₜ[A] b) = p (a ⊗ₜ[A] b)
        rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add t s ht hs =>
        obtain ⟨a, ha⟩ := ht
        obtain ⟨b, hb⟩ := hs
        exact ⟨a + b, by rw [map_add, ha, hb, map_add]⟩
  have hgq : Ideal.Quotient.mk J g = 1 := by
    apply sub_eq_zero.mp
    rw [← map_one (Ideal.Quotient.mk J), ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hg
  exact ⟨C, ψ, RingHom.flat_algebraMap_iff.mpr
    (IsLocalization.flat C (Submonoid.powers g)),
    quotient_localization_bijective J g C hgq, hsurj⟩

end Algebra
