import Sheaf.RingTheory.GlobalDimension
import Mathlib.RingTheory.KrullDimension.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Projective dimension of the residue field

Source: Stacks Project, Algebra, Lemma Tag 00OB (lemma-dim-gl-dim)
(blueprint: lem-weil-pbc-residue-field-pd-le-krull-dimension).
-/

universe u

namespace Ring

/-- Let `(R, m)` be a Noetherian local ring. If its residue field has finite
projective dimension as an `R`-module, then that projective dimension is at most
its Krull dimension. If the Krull dimension is finite, the residue field has a
projective resolution of length at most that dimension.
Source: Stacks Project, Algebra, Lemma Tag 00OB (lemma-dim-gl-dim)
(blueprint: lem-weil-pbc-residue-field-pd-le-krull-dimension).

Proof:
1. Put `d = pd_R κ`. The minimum-length property gives a projective resolution of
   length at most `d` (`lem-weil-pbc-projective-dimension-well-defined`). The module
   `κ = R/m` is generated by the class of `1`. Apply
   `lem-weil-pbc-minimal-finite-free-resolution-local` (Stacks 0CXF and 00MT) to
   obtain an exact finite free resolution with all differential coefficients in `m`.
2. Let `n` be the last index with a nonzero free term; such an index exists because
   `κ` is nonzero. Remove the trailing zero terms. The truncated resolution remains
   exact, including injectivity of its last differential, and gives `pd_R κ ≤ n`
   (`lem-weil-pbc-projective-dimension-well-defined`). If `n = 0`, the maximal
   ideal is prime, so `0 ≤ dim R` and the inequality follows.
3. For `n ≥ 1`, apply `lem-weil-pbc-exact-free-complex-last-minors-regular-sequence`
   (Buchsbaum--Eisenbud, Stacks 00N1) to the exact free complex. The ideal `I` of
   maximal minors of its last differential is either the whole ring or contains
   an `R`-regular sequence of length `n`.
4. The last free term has positive rank. Each maximal minor is a sum of products
   of positive numbers of coefficients in `m`, so `I ⊆ m` and `I` is proper.
   Thus the regular sequence lies in `m`, giving `depth R ≥ n`
   (`def-weil-pbc-matrix-determinant`, `def-weil-pbc-regular-sequence`,
   `def-weil-pbc-depth`).
5. Apply `lem-weil-pbc-depth-le-support-dimension` (Stacks 00LK) to the nonzero
   finite module `R`. Its support is all of `Spec R`: at each prime, `1/1` cannot
   vanish, since this would require a zero element outside that prime. Hence
   `pd_R κ ≤ n ≤ depth R ≤ dim R`. If `dim R = D` is finite, the minimum-length
   property gives a projective resolution of length at most `D`
   (`lem-weil-pbc-projective-dimension-well-defined`). -/
lemma residueField_projectiveDimension_le_ringKrullDim
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (h : ModuleCat.HasFiniteProjectiveDimension
      (ModuleCat.of R (IsLocalRing.ResidueField R))) :
    (ModuleCat.projectiveDimension
      (ModuleCat.of R (IsLocalRing.ResidueField R)) h : WithBot ℕ∞) ≤ ringKrullDim R ∧
      ∀ D : ℕ, ringKrullDim R = (D : WithBot ℕ∞) →
        ModuleCat.HasProjectiveResolutionLE
          (ModuleCat.of R (IsLocalRing.ResidueField R)) D := by
  sorry

end Ring
