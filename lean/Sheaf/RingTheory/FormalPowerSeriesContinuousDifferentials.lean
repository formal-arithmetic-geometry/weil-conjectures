module

public import Sheaf.RingTheory.AdicContinuousDifferentials
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.MvPowerSeries.Derivative
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# The continuous Jacobian presentation of a formal power-series quotient

Source: Stacks Project, Curves, Tags 0C4B and 0C4D, and Algebra, Tags 00RU,
00RX and 02HQ (blueprint: lem-trf-formal-power-series-continuous-differentials).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace MvPowerSeries

/-- The coordinate ideal `(t_1, …, t_n)` of a formal power-series ring.
Source: Stacks Project, Curves, Tags 0C4B and 0C4D
(blueprint: lem-trf-formal-power-series-continuous-differentials). -/
noncomputable def coordinateIdeal (F : Type u) [Field F] (n : ℕ) :
    Ideal (MvPowerSeries (Fin n) F) :=
  Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) F))

/-- The ideal generated by the specified finite family of relations.
Source: Stacks Project, Curves, Tags 0C4B and 0C4D
(blueprint: lem-trf-formal-power-series-continuous-differentials). -/
noncomputable def relationIdeal (F : Type u) [Field F] {n s : ℕ}
    (f : Fin s → MvPowerSeries (Fin n) F) : Ideal (MvPowerSeries (Fin n) F) :=
  Ideal.span (Set.range f)

/-- The Jacobian linear map over the quotient by the relations, with column `j`
given by the images of the formal partial derivatives of `f j`.
Source: Stacks Project, Curves, Tags 0C4B and 0C4D
(blueprint: lem-trf-formal-power-series-continuous-differentials). -/
noncomputable def quotientJacobian (F : Type u) [Field F] {n s : ℕ}
    (f : Fin s → MvPowerSeries (Fin n) F) :
    (Fin s →₀ MvPowerSeries (Fin n) F ⧸ relationIdeal F f) →ₗ[
      MvPowerSeries (Fin n) F ⧸ relationIdeal F f]
    (Fin n →₀ MvPowerSeries (Fin n) F ⧸ relationIdeal F f) :=
  Finsupp.linearCombination _ fun j ↦
    ∑ i : Fin n, Finsupp.single i
      (Ideal.Quotient.mk (relationIdeal F f) (MvPowerSeries.pderiv F i (f j)))

/-- Continuous differentials of a formal power-series quotient are the Jacobian cokernel,
with the specified canonical derivation and map on coordinate vectors. The derivation is
characterized on every element by its value in every truncation. Thus neither the derivation
nor the cokernel isomorphism is arbitrary.

Source: Stacks Project, Curves, Tags 0C4B and 0C4D, and Algebra, Tags 00RU, 00RX and 02HQ
(blueprint: lem-trf-formal-power-series-continuous-differentials).

Proof plan:
1. Apply lem-trf-formal-power-series-continuous-free to identify continuous differentials
   of the ambient power-series ring with the free module on its coordinate differentials.
2. Apply lem-trf-formal-power-series-continuous-conormal to identify the quotient's
   continuous differentials with the cokernel of the differentials of the relations.
3. The free-module derivative formula identifies the differential of `f j` with the
   column of its formal partial derivatives, reduced modulo the relation ideal.
4. Compose the resulting cokernel isomorphisms. On each coordinate vector the map is the
   continuous differential of that coordinate; evaluation in every truncation gives the
   displayed formula, so this is the stipulated map rather than an arbitrary isomorphism. -/
theorem exists_quotientJacobian_equiv_adicContinuousDifferentials
    (F : Type u) [Field F] (n s : ℕ) (f : Fin s → MvPowerSeries (Fin n) F)
    (hf : ∀ j : Fin s, f j ∈ coordinateIdeal F n) :
    ∃ d : Derivation F (MvPowerSeries (Fin n) F ⧸ relationIdeal F f)
        (KaehlerDifferential.adicContinuousDifferentials F
          (MvPowerSeries (Fin n) F ⧸ relationIdeal F f)
          ((coordinateIdeal F n).map (Ideal.Quotient.mk (relationIdeal F f)))),
      (∀ (x : MvPowerSeries (Fin n) F ⧸ relationIdeal F f) (r : ℕ),
        (d x).val r = KaehlerDifferential.D F _
          (Ideal.Quotient.mk
            (((coordinateIdeal F n).map (Ideal.Quotient.mk (relationIdeal F f))) ^ r) x)) ∧
      ∃ e : ((Fin n →₀ MvPowerSeries (Fin n) F ⧸ relationIdeal F f) ⧸
          LinearMap.range (quotientJacobian F f)) ≃ₗ[
            MvPowerSeries (Fin n) F ⧸ relationIdeal F f]
          KaehlerDifferential.adicContinuousDifferentials F
            (MvPowerSeries (Fin n) F ⧸ relationIdeal F f)
            ((coordinateIdeal F n).map (Ideal.Quotient.mk (relationIdeal F f))),
        ∀ i : Fin n, e (Submodule.Quotient.mk (Finsupp.single i 1)) =
          d (Ideal.Quotient.mk (relationIdeal F f) (MvPowerSeries.X i)) := by
  sorry

end MvPowerSeries
