module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Idempotent splitting of an étale algebra with a section

Source: Stacks Project, Tag 09XI, proof of (5) implies (2), first paragraph, with Tags
00U7, 00U8 and 00EH (blueprint: lem-weil-pbc-etale-section-idempotent-splitting).
-/

@[expose] public section

universe u v

namespace Algebra.Etale

/-- An étale algebra with a section splits off the base ring. The complementary factor
is the corner of `1 - e`, namely `(1 - e)S` with identity `1 - e`. Its algebra map is
specified explicitly, and the localization equivalence extends the given section.
Source: Stacks Project, Tag 09XI, proof of (5) implies (2), and Tags 00U7, 00U8, 00EH
(blueprint: lem-weil-pbc-etale-section-idempotent-splitting).

Proof:
1. The algebra homomorphism `s` is surjective since it fixes the image of the base ring.
It is étale by cancellation (lem-weil-pbc-etale-composition-cancellation, Tag 00U7).
2. Its kernel is finitely generated and idempotent
(lem-weil-pbc-surjective-etale-kernel-idempotent-fg, Tag 00U8), hence generated by an
idempotent `e'` (lem-weil-pbc-fg-idempotent-ideal-idempotent-generator, Tag 00EH).
3. Set `e = 1 - e'`. Then `e` is idempotent, `s e = 1`, and the kernel is `(1 - e)S`.
4. The map `x ↦ (s x, (1 - e) * x)` is an algebra isomorphism: its inverse sends
`(r, y)` to `e * algebraMap R S r + y`. This proves the product assertion with the
specified first projection and complementary algebra map.
5. A surjective map with kernel `(1 - e)S` identifies its target with the localization
away from the idempotent `e` (lem-weil-pbc-fg-idempotent-ideal-idempotent-generator,
Tag 00EH). Since `s e = 1`, the induced equivalence extends `s` and is an algebra map. -/
theorem exists_idempotent_splitting_of_algHom
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.Etale R S] (s : S →ₐ[R] R) :
    ∃ (e : S) (he : IsIdempotentElem e),
      s e = 1 ∧ RingHom.ker s.toRingHom = Ideal.span {1 - e} ∧
      (∃ (_ : Algebra R he.one_sub.Corner),
        (∀ r : R, (algebraMap R he.one_sub.Corner r).1 =
          (1 - e) * algebraMap R S r) ∧
        ∃ Φ : S ≃ₐ[R] R × he.one_sub.Corner, ∀ x : S, (Φ x).1 = s x) ∧
      (∃ ψ : Localization.Away e ≃ₐ[R] R,
        ∀ x : S, ψ (algebraMap S (Localization.Away e) x) = s x) := by
  sorry

end Algebra.Etale
