module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Sheaf.RingTheory.GlobalDimension
import Sheaf.RingTheory.ResidueFieldProjectiveDimension
import Sheaf.RingTheory.ResidueFieldProjectiveDimensionLowerBound
import Sheaf.RingTheory.ResidueFieldFiniteProjectiveDimensionOfGlobalDimension

/-!
# Regularity from finite global dimension

Source: Stacks Project, Algebra, Proposition 00OC, implication (2) ⇒ (3)
(blueprint: lem-weil-pbc-finite-gl-dim-regular-local).
-/

@[expose] public section

universe u v

namespace IsRegularLocalRing

/-- A Noetherian local ring of finite global dimension is regular.
Source: Stacks Project, Algebra, Proposition 00OC, implication (2) ⇒ (1) ⇒ (3)
(blueprint: lem-weil-pbc-finite-gl-dim-regular-local).

Proof:
1. Finite global dimension gives a finite projective resolution of the residue field
   (`def-weil-pbc-finite-global-dimension`).
2. The Krull dimension `D` is finite (`lem-weil-pbc-noetherian-local-system-of-parameters`),
   and the residue field has a projective resolution of length at most `D`
   (`lem-weil-pbc-residue-field-pd-le-krull-dimension`, Stacks 00OB).
3. If `n` is the dimension of the cotangent space over the residue field, then `n ≤ D`
   (`lem-weil-pbc-residue-field-pd-ge-embedding-dimension`, Stacks 00OA).
4. Lift a basis of that cotangent space to `n` elements of the maximal ideal. Noetherianity
   makes this ideal finitely generated (`def-weil-pbc-noetherian-ring`); Nakayama's lemma
   shows the lifts generate it (`lem-weil-pbc-nakayama-local-generators`).
5. Pad these generators with `D - n` zeros. The maximal ideal is generated by `D` elements,
   so the ring is regular (`def-weil-regular-scheme`, Stacks 00KU). -/
theorem of_hasFiniteGlobalDimension (R : Type u) [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (h : Ring.HasFiniteGlobalDimension.{u, max u v} R) :
    IsRegularLocalRing R := by
  have hres : ModuleCat.HasFiniteProjectiveDimension
      (ModuleCat.of R (IsLocalRing.ResidueField R)) :=
    Ring.residueField_hasFiniteProjectiveDimension R h
  obtain ⟨a, ha⟩ : ∃ a : ℕ∞, (a : WithBot ℕ∞) = ringKrullDim R :=
    WithBot.ne_bot_iff_exists.mp (ringKrullDim_ne_bot (R := R))
  obtain ⟨D, hDa⟩ : ∃ D : ℕ, (D : ℕ∞) = a := ENat.ne_top_iff_exists.mp (by
    intro haTop
    exact (ringKrullDim_ne_top (R := R)) (ha.symm.trans (by simp [haTop])) )
  have hD : ringKrullDim R = (D : WithBot ℕ∞) := by
    exact ha.symm.trans (congrArg (fun x : ℕ∞ => (x : WithBot ℕ∞)) hDa.symm)
  have hle := (Ring.residueField_projectiveDimension_le_ringKrullDim R hres).2 D hD
  have hcot := IsLocalRing.finrank_cotangentSpace_le_of_hasProjectiveResolutionLE R D hle
  apply (IsRegularLocalRing.iff_finrank_cotangentSpace R).2
  apply le_antisymm
  · rw [hD]
    exact_mod_cast hcot
  · rw [← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    exact ringKrullDim_le_spanFinrank_maximalIdeal R

end IsRegularLocalRing
