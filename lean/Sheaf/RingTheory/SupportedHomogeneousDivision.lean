module

public import Mathlib.Data.Finsupp.MonomialOrder.DegLex
public import Mathlib.Order.Minimal
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! # Supported homogeneous division for a monomial diagram

Source: Bierstone--Milman, Invent. Math. 128 (1997), section 8, pp.273--275,
with the degree-prefix convention of section 7, (7.2).
(blueprint: def-trf-supported-homogeneous-division)

Polynomials use Mathlib's `MvPolynomial`, identified with finite-support formal
series by its canonical inclusion into `MvPowerSeries`. The family remains indexed:
equal polynomial values at different indices are not identified.
-/

@[expose] public section

universe u

namespace MonomialDiagram

/-- An additive diagram closed under moving a whole coordinate to a later variable.
Source: Bierstone--Milman, section 7 and section 8, p.273.
(blueprint: def-trf-supported-homogeneous-division). -/
def IsMonotone {σ : Type} [LinearOrder σ] (D : Set (σ →₀ ℕ)) : Prop :=
  (∀ a ∈ D, ∀ b : σ →₀ ℕ, a + b ∈ D) ∧
    ∀ a ∈ D, ∀ i j : σ, i < j →
      a - Finsupp.single i (a i) + Finsupp.single j (a i) ∈ D

/-- A finite indexed vertex list, without repetitions, in ascending degree-lex order.
Minimality uses the coordinatewise partial order on exponents.
Source: Bierstone--Milman, section 8, p.273.
(blueprint: def-trf-supported-homogeneous-division). -/
def IsOrderedVertexFamily {σ ι : Type} [LinearOrder σ] [LinearOrder ι]
    (D : Set (σ →₀ ℕ)) (a : ι → σ →₀ ℕ) : Prop :=
  (∀ e : σ →₀ ℕ, Minimal (fun x => x ∈ D) e ↔ ∃ i : ι, a i = e) ∧
    ∀ i j : ι, i < j → Finsupp.DegLex (· < ·) (· < ·) (a i) (a j)

/-- The union of orthants generated by an indexed vertex family.
Source: Bierstone--Milman, section 8, p.273.
(blueprint: def-trf-supported-homogeneous-division). -/
def generated {σ ι : Type} (a : ι → σ →₀ ℕ) : Set (σ →₀ ℕ) :=
  {e | ∃ i : ι, a i ≤ e}

/-- The quotient support assigned to vertex `i` by the first-dividing-vertex rule.
Source: Bierstone--Milman, section 8, p.273 (their translated supports).
(blueprint: def-trf-supported-homogeneous-division). -/
def quotientSupport {σ ι : Type} [LinearOrder ι] (a : ι → σ →₀ ℕ)
    (i : ι) : Set (σ →₀ ℕ) :=
  {b | ∀ j : ι, j < i → ¬ a j ≤ a i + b}

/-- Indices of the disjoint union of supported multiples and remainder monomials.
Source: Bierstone--Milman, section 8, p.274, the family `P(k)`.
(blueprint: def-trf-supported-homogeneous-division). -/
def DivisionIndex {σ ι : Type} [LinearOrder ι] (D : Set (σ →₀ ℕ))
    (a : ι → σ →₀ ℕ) (t : ℕ) : Type :=
  {p : ι × (σ →₀ ℕ) | p.2 ∈ quotientSupport a p.1 ∧ p.2.degree + (a p.1).degree = t} ⊕
    {e : σ →₀ ℕ | e ∉ D ∧ e.degree = t}

/-- The indexed polynomial `Y^b H_i` or `Y^e` at an index of `P(t)`.
Source: Bierstone--Milman, section 8, p.274.
(blueprint: def-trf-supported-homogeneous-division). -/
noncomputable def divisionFamily {σ ι : Type} [LinearOrder ι] {A : Type u} [CommRing A]
    (D : Set (σ →₀ ℕ)) (a : ι → σ →₀ ℕ) (H : ι → MvPolynomial σ A) (t : ℕ) :
    DivisionIndex D a t → MvPolynomial σ A
  | .inl p => MvPolynomial.monomial p.val.2 1 * H p.val.1
  | .inr e => MvPolynomial.monomial e.val 1

/-- Spanning the homogeneous degree-`t` module by the specified indexed family.
Source: Bierstone--Milman, Theorem 8.1, p.274.
(blueprint: def-trf-supported-homogeneous-division). -/
def SpansDegree {σ ι : Type} [LinearOrder ι] {A : Type u} [CommRing A]
    (D : Set (σ →₀ ℕ)) (a : ι → σ →₀ ℕ) (H : ι → MvPolynomial σ A) (t : ℕ) : Prop :=
  Submodule.span A (Set.range (divisionFamily D a H t)) =
    MvPolynomial.homogeneousSubmodule σ A t

/-- Unique supported homogeneous division is unique finite coefficients in `P(t)`.
Grouping the left indices with the same vertex gives its quotient polynomial;
the right indices give the remainder. This includes the degrees below a vertex degree.
Source: Bierstone--Milman, (7.2)(2) and section 8, pp.273--274.
(blueprint: def-trf-supported-homogeneous-division). -/
def HasUniqueDivision {σ ι : Type} [LinearOrder ι] {A : Type u} [CommRing A]
    (D : Set (σ →₀ ℕ)) (a : ι → σ →₀ ℕ) (H : ι → MvPolynomial σ A) (t : ℕ) : Prop :=
  ∀ P : MvPolynomial σ A, P.IsHomogeneous t →
    ∃! c : DivisionIndex D a t →₀ A,
      Finsupp.linearCombination A (divisionFamily D a H t) c = P

/-- A bound for propagation, the basis assertion, and the finite test for unique division.
The coefficient ring is a parameter, so the theorem can quantify over rings after the bound.
Source: Bierstone--Milman, Theorem 8.1 and the preceding basis observation, p.274.
(blueprint: def-trf-supported-homogeneous-division). -/
def IsFiniteDivisionTest {σ ι : Type} [LinearOrder ι] (D : Set (σ →₀ ℕ))
    (a : ι → σ →₀ ℕ) (A : Type u) [CommRing A] (b : ℕ) : Prop :=
  ∀ H : ι → MvPolynomial σ A, (∀ i : ι, (H i).IsHomogeneous (a i).degree) →
    (∀ q : ℕ, b ≤ q → SpansDegree D a H q →
      ∀ t : ℕ, q ≤ t → SpansDegree D a H t) ∧
    (∀ t : ℕ, SpansDegree D a H t → LinearIndependent A (divisionFamily D a H t)) ∧
    ((∀ t : ℕ, t ≤ b → SpansDegree D a H t) ↔
      ∀ t : ℕ, HasUniqueDivision D a H t)

/-- A degree prefix retains all vertices of degree at most `d`, in the inherited order.
Source: Bierstone--Milman, (7.2)(2) and Theorem 8.1.
(blueprint: def-trf-supported-homogeneous-division). -/
def prefixVertices {σ ι : Type} (a : ι → σ →₀ ℕ) (d : ℕ) :
    {i : ι // (a i).degree ≤ d} → σ →₀ ℕ :=
  fun i => a i.val

/-- Essential variables are exactly those appearing in some vertex monomial.
Source: Bierstone--Milman, section 8 and the application in Theorem 9.6, p.282.
(blueprint: def-trf-supported-homogeneous-division). -/
def EssentialVariables {σ ι : Type} (a : ι → σ →₀ ℕ) : Type :=
  {j : σ // ∃ i : ι, a i j ≠ 0}

/-- Delete the unused coordinates of every vertex, retaining its original index.
The diagram after restriction is the union of the orthants of these vertices.
Source: Bierstone--Milman, section 8 and Theorem 9.6, p.282.
(blueprint: def-trf-supported-homogeneous-division). -/
noncomputable def essentialVertices {σ ι : Type} (a : ι → σ →₀ ℕ) :
    ι → EssentialVariables a →₀ ℕ :=
  fun i => (a i).subtypeDomain (fun j => ∃ k : ι, a k j ≠ 0)

end MonomialDiagram
