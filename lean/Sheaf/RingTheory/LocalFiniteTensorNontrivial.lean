module

public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.LocalRing.Defs
public import Mathlib.LinearAlgebra.TensorProduct.Defs
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic

/-!
# Nonvanishing of tensor products of finite modules over a local ring

Source: Stacks Project, Algebra, Nakayama's lemma (Tag 00DV, lemma-NAK), and
Tensor products (Tags 00CV and 00CX, lemma-tensor-product)
(blueprint: lem-trf-local-finite-module-tensor-nonzero).
-/

@[expose] public section

universe u v w

namespace IsLocalRing

/-- Two nonzero finitely generated modules over a commutative local ring have nonzero tensor
product. The maximal ideal and residue field are the canonical ones attached to the local ring.

Source: Stacks Project, Algebra, Tag 00DV, lemma-NAK, parts (2) and (4), and Tag 00CX,
lemma-tensor-product (blueprint: lem-trf-local-finite-module-tensor-nonzero).

Proof:
1. Write m for the maximal ideal and k for the residue field. The quotients M/mM and N/mN
   are k-vector spaces via [r][x] = [rx]. Each is nonzero: otherwise the image of the zero
   submodule is the whole residue quotient, and Nakayama's local generator criterion
   (lem-weil-pbc-nakayama-local-generators, IsLocalRing.map_mkQ_eq_top) would make the
   corresponding finite module zero, contradicting its nontriviality.
2. Their tensor T over k is nonzero by lem-pur-field-vector-space-tensor-nontrivial:
   vector spaces are free (Module.Free.of_divisionRing), so a nonzero vector space is
   faithfully flat and Module.FaithfullyFlat.lTensor_nontrivial applies.
3. Regard T as an R-module via R -> k. The map (x,y) -> [x] tensor [y] is R-bilinear,
   since the quotient maps are additive and [rx] tensor [y] = [r]([x] tensor [y])
   = [x] tensor [ry]. By def-weil-pbc-module-tensor-product it induces an R-linear map
   M tensor_R N -> T. This map is surjective: T is generated by pure tensors, whose
   factors lift along the quotient maps; absorb scalar coefficients in the first factor
   and lift finite sums. If the source were zero, T would be zero, contradicting step 2. -/
theorem nontrivial_tensorProduct_of_finite
    (R : Type u) [CommRing R] [IsLocalRing R]
    (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (N : Type w) [AddCommGroup N] [Module R N] [Module.Finite R N] [Nontrivial N] :
    Nontrivial (TensorProduct R M N) := by
  sorry

end IsLocalRing
