module

public import Sheaf.RingTheory.RestrictedSeriesCoefficientExtension

/-!
# Separate bounded monic relations in Tate algebras

Source: Bosch, Lectures on Formal and Rigid Geometry (April 2008), Section 1.2,
Theorem 8 and Proposition 14 proof, printed pp. 12--13 and 15--16; the node's
several-variable extension (blueprint: lem-trf-tate-separated-monic-quotient).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

@[expose] public section

universe u

namespace RestrictedSeries

/-- The separate monic relation in the `i`th polynomial variable, with coefficients
in the Tate algebra on the first `r` variables. Source: Bosch, Section 1.2,
Theorem 8 and Proposition 14 proof, printed pp. 12--13 and 15--16
(blueprint: lem-trf-tate-separated-monic-quotient). -/
noncomputable def separatedMonicRelation
    (K : Type u) [NormedField K] [IsUltrametricDist K] (r s : ℕ)
    (d : Fin s → ℕ)
    (a : (i : Fin s) → Fin (d i) →
      MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) (i : Fin s) :
    MvPolynomial (Fin s)
      (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :=
  MvPolynomial.X i ^ d i +
    ∑ j : Fin (d i), MvPolynomial.C (a i j) * MvPolynomial.X i ^ j.val

/-- The polynomial ideal generated by the separate monic relations.
Source: Bosch, Section 1.2, Proposition 14 proof, printed pp. 15--16
(blueprint: lem-trf-tate-separated-monic-quotient). -/
noncomputable def separatedMonicIdeal
    (K : Type u) [NormedField K] [IsUltrametricDist K] (r s : ℕ)
    (d : Fin s → ℕ)
    (a : (i : Fin s) → Fin (d i) →
      MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :
    Ideal (MvPolynomial (Fin s)
      (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ)))) :=
  Ideal.span (Set.range (separatedMonicRelation K r s d a))

/-- The canonical map from the polynomial quotient to the restricted-series quotient
by separate bounded monic relations is bijective. It is already an algebra homomorphism
over the Tate algebra on the first `r` variables, so this states that it is an isomorphism
of those algebras. Source: Bosch, Section 1.2, Theorem 8 and Proposition 14 proof,
printed pp. 12--13 and 15--16, extended to separate monic relations
(blueprint: lem-trf-tate-separated-monic-quotient).

Proof:
1. For each variable `Y_i`, relabel it last and use
lem-trf-restricted-series-gauss-completion to regroup the restricted series. Apply
lem-trf-tate-weierstrass-norm-division to `f_i`, whose leading coefficient is one,
lower coefficients have Gauss norm at most one, and upper tail is zero. Uniqueness
makes its quotient and remainder operators additive and linear over the other variables;
it also gives `R_i(f_i h) = 0`.
2. If `j` differs from `i`, expand an input of `Y_j`-degree less than `d_j` in finitely
many powers of `Y_j`. Its coefficients remain restricted by coefficient decay. Since
`f_i` has coefficients in the original coefficient ring, divide each coefficient in
`Y_i`. Uniqueness identifies their sum with the remainder in the full Tate algebra,
which still has `Y_j`-degree less than `d_j`. Linearity also gives
`R_i(f_j h) = f_j R_i(h)` for `j` different from `i`.
3. Apply the remainder operators in order. The final normal form `N(h)` is supported
in the finite box with `Y_i`-exponents less than `d_i`, so belongs to the polynomial
ring. Telescoping gives `h - N(h)` in the extended ideal. Earlier reductions retain
a factor `f_j`, the `j`th kills it, and later ones preserve zero. Thus `N` annihilates
the extended ideal, and every quotient class has a polynomial representative.
4. For polynomial inputs, cancel the leading term in `Y_i` by subtracting a polynomial
multiple of the monic `f_i`. The degree strictly decreases until it is less than `d_i`.
The polynomial quotient and remainder agree with analytic division by uniqueness in
lem-trf-tate-weierstrass-norm-division. Iterating gives `p - N(p)` in the polynomial ideal.
5. Ideal.quotientMapₐ is the induced algebra homomorphism of
def-weil-pbc-algebra-hom-quotient. Step 3 proves surjectivity. If a polynomial class
maps to zero, its representative is in the extended ideal, so its normal form is zero.
Step 4 puts the polynomial in the polynomial ideal, proving injectivity. The inverse
is `[h]` mapped to `[N(h)]`, independent of representatives by step 3; the two inverse
identities follow from steps 3 and 4. Multiplicativity and scalar compatibility follow
by applying the injective forward algebra map. For `s = 0` there are no reductions,
the two rings are the coefficient ring and the ideals are zero. For `r = 0` the
coefficient ring is `K`. Repeated roots require no change in the argument.
-/
theorem tate_separated_monic_quotient
    (K : Type u) [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
    (hK : ∃ x : K, x ≠ 0 ∧ ‖x‖ ≠ 1) (r s : ℕ)
    (d : Fin s → ℕ) (hd : ∀ i : Fin s, 1 ≤ d i)
    (a : (i : Fin s) → Fin (d i) →
      MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ)))
    (ha : ∀ (i : Fin s) (j : Fin (d i)),
      MvPowerSeries.gaussNorm (norm : K → ℝ) (fun _ : Fin r ↦ 1) (a i j).val ≤ 1) :
    Function.Bijective
      (coefficientPolynomialQuotientMap K r s (separatedMonicIdeal K r s d a)) := by
  sorry

end RestrictedSeries
