module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.LocalRing.RingHom.Basic
import WeilConjectures.RingTheory.RegularLocalGeneratorsRegularSequence
import Mathlib.RingTheory.LocalRing.Quotient
import Sheaf.RingTheory.IsRegularIffDimensionDrop

/-!
# Parameter cuts of tuples of the expected codimension

Source: Stacks Project, Algebra, Tag 00SE (lemma-ci-well-defined), final paragraph;
Tags 00NQ and 02JN (blueprint: lem-trf-parameter-cut-expected-codimension-tuple).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace IsRegularLocalRing

/-- Cutting a parameter from a generating tuple of the expected codimension leaves the
specified remaining tuple regular. All quotient maps are Mathlib's canonical projections.
The isomorphisms and the factored surjection are characterized on residue classes, so their
existential formulation specifies the canonical maps uniquely.
Source: Stacks Project, Algebra, Tag 00SE, final paragraph; Tags 00NQ and 02JN
(blueprint: lem-trf-parameter-cut-expected-codimension-tuple).

Proof:
1. Apply `isRegular_and_quotients_of_generators` at prefix length one to `x :: ts`.
   This gives a regular local quotient of dimension `d - 1`. Quotient local structure
   (lem-weil-pbc-quotient-local-structure) identifies its maximal ideal with the image of
   the original maximal ideal, containing the images of every entry of `zs`.
2. The image of `x` is zero, so the image of the ideal generated by `x :: zs` is generated
   by the images of `zs`. The inverse residue-class maps `[q(r)] ↦ [r]` and `[r] ↦ [q(r)]`
   identify the double quotient with `R/I`. They preserve strict prime chains
   (def-weil-pbc-krull-dimension-ring), giving dimension `d - b = (d - 1) - (b - 1)`.
   If `b = 1`, the remaining list is empty and its ideal is zero.
3. Apply lem-trf-regular-local-regular-sequence-depth to the empty regular sequence in
   the regular local quotient. It is Noetherian local with depth equal to `d - 1`.
4. Apply `RingTheory.Sequence.isRegular_iff_dimension_drop`
   (lem-trf-cm-regular-sequence-generator-count) to the image of `zs`, using steps 1--3.
   This proves regularity of this ordered tuple, including its empty case.
5. For a local surjection `f` killing `x`, the formula `f'(q(r)) = f(r)` is well-defined:
   differences of representatives lie in `(x)`, hence in its kernel. It is surjective,
   and maps the quotient maximal ideal into the target maximal ideal. Pulling strict
   prime chains back through `f` bounds the finite target dimension by `d`. Subtracting
   that dimension from the dimension equality in step 1 gives the asserted integer
   difference formula. For the empty tuple the zero-ideal quotient identifies with the
   parameter quotient by `[a] ↦ a`.
-/
theorem parameterCut_expectedCodimension_tuple
    (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (d : ℕ) (hdpos : 1 ≤ d) (hd : ringKrullDim R = (d : WithBot ℕ∞))
    (x : R) (ts : List R) (htlen : (x :: ts).length = d)
    (htmem : ∀ a ∈ x :: ts, a ∈ IsLocalRing.maximalIdeal R)
    (htspan : Ideal.ofList (x :: ts) = IsLocalRing.maximalIdeal R)
    (b : ℕ) (hbpos : 1 ≤ b) (hbd : b ≤ d)
    (zs : List R) (hzlen : zs.length = b - 1)
    (hzmem : ∀ z ∈ zs, z ∈ IsLocalRing.maximalIdeal R)
    (I : Ideal R) (hI : I = Ideal.ofList (x :: zs))
    (hcodim : ringKrullDim (R ⧸ I) = ((d - b : ℕ) : WithBot ℕ∞)) :
    ∃ hQ : IsRegularLocalRing (R ⧸ Ideal.span {x}),
      ringKrullDim (R ⧸ Ideal.span {x}) = ((d - 1 : ℕ) : WithBot ℕ∞) ∧
      @IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x}) _ hQ.toIsLocalRing =
        (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x})) ∧
      RingTheory.Sequence.IsRegular (R ⧸ Ideal.span {x})
        (zs.map (Ideal.Quotient.mk (Ideal.span {x}))) ∧
      (∀ z ∈ zs.map (Ideal.Quotient.mk (Ideal.span {x})),
        z ∈ @IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x}) _ hQ.toIsLocalRing) ∧
      Ideal.ofList (zs.map (Ideal.Quotient.mk (Ideal.span {x}))) =
        I.map (Ideal.Quotient.mk (Ideal.span {x})) ∧
      (∃ e : ((R ⧸ Ideal.span {x}) ⧸ I.map (Ideal.Quotient.mk (Ideal.span {x}))) ≃+*
          R ⧸ I,
        ∀ r : R, e (Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.span {x}) r)) =
          Ideal.Quotient.mk I r) ∧
      ringKrullDim ((R ⧸ Ideal.span {x}) ⧸ I.map (Ideal.Quotient.mk (Ideal.span {x}))) =
        (((d - 1) - (b - 1) : ℕ) : WithBot ℕ∞) ∧
      (∀ (S : Type v) [CommRing S] [IsLocalRing S] (f : R →+* S),
        Function.Surjective f → IsLocalHom f → x ∈ RingHom.ker f →
        ∃ f' : (R ⧸ Ideal.span {x}) →+* S,
          f'.comp (Ideal.Quotient.mk (Ideal.span {x})) = f ∧
          Function.Surjective f' ∧ IsLocalHom f' ∧
          ∃ s : ℕ, ringKrullDim S = (s : WithBot ℕ∞) ∧
            ((d - 1 : ℕ) : ℤ) - (s : ℤ) = ((d : ℤ) - (s : ℤ)) - 1) ∧
      (b = 1 → zs = [] ∧ I.map (Ideal.Quotient.mk (Ideal.span {x})) = ⊥ ∧
        ∃ e₀ : ((R ⧸ Ideal.span {x}) ⧸ I.map (Ideal.Quotient.mk (Ideal.span {x}))) ≃+*
            (R ⧸ Ideal.span {x}),
          ∀ a : R ⧸ Ideal.span {x}, e₀ (Ideal.Quotient.mk _ a) = a) := by
  sorry

end IsRegularLocalRing
