module

public import Mathlib.Algebra.Polynomial.RingDivision
public import Mathlib.RingTheory.Polynomial.Quotient
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Quotient by distinct linear factors

Source: Stacks Project, Algebra, Lemma Tag 00U3, the separable-polynomial case and its
Chinese-remainder decomposition into linear factors
(blueprint: lem-pc-polynomial-quotient-distinct-linear-crt).
-/

@[expose] public section

universe u

open scoped Polynomial

namespace Polynomial

/-- (blueprint: lem-pc-polynomial-quotient-distinct-linear-crt) For pairwise distinct
`ρ i` in a field `Ω`, evaluation gives an `Ω`-algebra equivalence from the quotient by
`∏ i, (X - C (ρ i))` to the indexed product of copies of `Ω` (Stacks, Tag 00U3).

The distinct factors are pairwise coprime by
`Polynomial.pairwise_coprime_X_sub_C`. Their principal ideals intersect in the ideal
generated by the product by `Ideal.iInf_span_singleton`. The Chinese remainder equivalence
`Ideal.quotientInfRingEquivPiQuotient` then identifies the quotient with the product of
linear-factor quotients. On each factor, `Polynomial.quotientSpanXSubCAlgEquiv` is evaluation
at `ρ i`. Their composite preserves constants, hence is an `Ω`-algebra equivalence, and
its value on the class of `p` is the family `i ↦ p.eval (ρ i)`. -/
theorem quotient_prod_X_sub_C_algEquiv_pi {Ω : Type u} [Field Ω] (n : ℕ)
    (ρ : Fin n → Ω) (hρ : Function.Injective ρ) :
    ∃ e : (Ω[X] ⧸ Ideal.span
        ({∏ i : Fin n, (X - C (ρ i))} : Set Ω[X])) ≃ₐ[Ω] (Fin n → Ω),
      ∀ (p : Ω[X]) (i : Fin n),
        e (Ideal.Quotient.mk _ p) i = p.eval (ρ i) := by
  let I : Fin n → Ideal Ω[X] := fun i ↦ Ideal.span {X - C (ρ i)}
  have hcop := pairwise_coprime_X_sub_C hρ
  have hI : Pairwise (fun i j ↦ IsCoprime (I i) (I j)) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).2 (hcop hij)
  have hprod : (⨅ i, I i) = Ideal.span {∏ i : Fin n, (X - C (ρ i))} :=
    Ideal.iInf_span_singleton hcop
  let e₁ := Ideal.quotEquivOfEq hprod.symm
  let e₂ := Ideal.quotientInfRingEquivPiQuotient I hI
  let e₃ := RingEquiv.piCongrRight fun i ↦ (quotientSpanXSubCAlgEquiv (ρ i)).toRingEquiv
  let e := (e₁.trans e₂).trans e₃
  have he (p : Ω[X]) (i : Fin n) :
      e (Ideal.Quotient.mk _ p) i = p.eval (ρ i) := by
    change quotientSpanXSubCAlgEquiv (ρ i)
      (e₂ (e₁ (Ideal.Quotient.mk _ p)) i) = _
    rw [Ideal.quotEquivOfEq_mk]
    rfl
  refine ⟨{ e with commutes' := ?_ }, he⟩
  intro c
  ext i
  exact (he (C c) i).trans eval_C

end Polynomial
