module

public import Sheaf.RingTheory.EppWeakSolution
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.Separable
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Sheaf.RingTheory.PrincipalRegularLocalCompletionDVR
import Sheaf.RingTheory.DvrStrictResidueSquare
import Sheaf.RingTheory.DvrCompletionExtensionApproximation

/-! # Strict residue and completion reduction for Epp's theorem

Source: Stacks Project, More on Algebra, Tags 09ET, 09F9, 09EJ and 09ES
(blueprint: lem-sfb-epp-strict-complete-reduction).
-/

@[expose] public section

set_option autoImplicit false

universe u v w x z

namespace IsDiscreteValuationRing

/-- The strict-residue square followed by completion exists independently of any
weak solution; suitable weak solutions over its complete lower fraction field descend.

Source: Stacks Project, More on Algebra, Tags 09ET and 09F9, strict-residue and
completion paragraphs; Tags 09EJ and 09ES
(blueprint: lem-sfb-epp-strict-complete-reduction).

Proof:
1. Apply lem-sfb-dvr-strict-residue-square. The new residues are separable closures,
   and the lower maximal ideal is unchanged after extension. Since the lower residue
   is perfect, its separable closure is algebraically closed: an irreducible polynomial
   with zero derivative would be a pth power by taking roots of its coefficients.
2. For x in the perfect core of the new upper residue and y^(p^n) = x, separability
   gives l(y) = l(x). The minimal polynomial of x is obtained by taking p^n powers
   of the coefficients of that of y. Hence its coefficients lie in the original
   perfect core and are algebraic over k. Thus x lies in the algebraically closed
   lower residue. Conversely, algebraic closedness supplies every p-power root there.
3. Complete both DVRs. By lem-sfb-principal-regular-local-completion-dvr their
   residues are unchanged and their uniformizers still generate the maximal ideals.
   Injectivity follows by writing nonzero elements as units times uniformizer powers
   (lem-weil-pbc-dvr-unit-times-uniformizer-power). Write the image of the lower
   uniformizer as u*t^e, e >= 1. Compatible quotient maps construct the map of
   completions. The same identity makes this map local and injective.
4. Given a weak solution H over the completed lower fraction field, apply
   lem-sfb-dvr-completion-extension-approximation to descend H to a finite N/F.
   In characteristic zero H is separable; in characteristic p use exactly the
   prescribed uniformizer-root compositum. Tensor associativity identifies the
   reduced upper generic tensor with the one defining the weak solution H.
5. Apply lem-sfb-dvr-index-one-separable-base-change to the lower completion map.
   Its unconditional local assertion and the weak solution H give equality of
   maximal ideals for N over the completed upper DVR. Maximal contractions and
   both DVR localizations follow from lem-sfb-dvr-algebraic-normalization-structure.
6. Descend across the upper completion. Reduction commutes with tensoring and
   reducing again, since the kernel generated by nilpotents is nil. The finite-case
   normalization structure gives a branch above each original branch. If the two
   local ramification indices are a,b >= 1, step 5 gives ab = 1, hence a = 1.
   Thus N is a weak solution before completing either DVR.
7. Apply the weak-solution descent of lem-sfb-dvr-strict-residue-square. This gives
   a finite weak solution of the original map with every maximal contraction,
   both DVR localizations and the asserted ideal equality. -/
theorem exists_epp_strict_complete_reduction
    (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (B : Type v) [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)]
    (hinj : Function.Injective (algebraMap A B))
    (K : Type w) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type x) [Field L] [Algebra B L] [IsFractionRing B L]
    [Algebra A L] [Algebra K L] [IsScalarTower A B L] [IsScalarTower A K L]
    (p : ℕ) (hp : 0 < p) [CharP (IsLocalRing.ResidueField A) p]
    (hperfect : ∀ a : IsLocalRing.ResidueField A,
      ∃ b : IsLocalRing.ResidueField A, b ^ p = a)
    (hcore : ∀ a : IsLocalRing.ResidueField B,
      (∀ n : ℕ, ∃ b : IsLocalRing.ResidueField B, b ^ (p ^ n) = a) →
        IsSeparable (IsLocalRing.ResidueField A) a)
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) :
    ∃ (A' B' : Type (max u v w x)) (_ : CommRing A') (_ : IsDomain A')
      (_ : IsDiscreteValuationRing A') (_ : CommRing B') (_ : IsDomain B')
      (_ : IsDiscreteValuationRing B')
      (_ : Algebra A A') (_ : Algebra B B') (_ : Algebra A' B') (_ : Algebra A B')
      (_ : IsScalarTower A B B') (_ : IsScalarTower A A' B')
      (_ : IsLocalHom (algebraMap A A')) (_ : IsLocalHom (algebraMap B B'))
      (_ : IsLocalHom (algebraMap A' B')),
      Function.Injective (algebraMap A A') ∧ Function.Injective (algebraMap B B') ∧
      Function.Injective (algebraMap A' B') ∧
      IsAdicComplete (IsLocalRing.maximalIdeal A') A' ∧
      IsAdicComplete (IsLocalRing.maximalIdeal B') B' ∧
      IsLocalRing.maximalIdeal A' = Ideal.span {algebraMap A A' π} ∧
      IsAlgClosure (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField A') ∧
      (∀ a : IsLocalRing.ResidueField B',
        (∃ b : IsLocalRing.ResidueField A',
          algebraMap (IsLocalRing.ResidueField A') (IsLocalRing.ResidueField B') b = a) ↔
        ∀ n : ℕ, ∃ b : IsLocalRing.ResidueField B', b ^ (p ^ n) = a) ∧
      ∃ (K' L' : Type (max u v w x)) (_ : Field K') (_ : Field L')
        (_ : Algebra A' K') (_ : IsFractionRing A' K')
        (_ : Algebra B' L') (_ : IsFractionRing B' L')
        (_ : Algebra A' L') (_ : Algebra K' L')
        (_ : IsScalarTower A' B' L') (_ : IsScalarTower A' K' L'),
        ∀ (H : Type (max u v w x z)) [Field H] [Algebra K' H]
          [Algebra A' H] [IsScalarTower A' K' H],
          IsEppWeakSolution A' B' K' L' H →
          (CharP K p → ∃ E : IntermediateField K' H,
            Module.Finite K' E ∧ Algebra.IsSeparable K' E ∧
            ∃ (r : ℕ) (t : H),
              t ^ (p ^ r) = algebraMap K' H (algebraMap A' K' (algebraMap A A' π)) ∧
              E ⊔ IntermediateField.adjoin K' {t} = ⊤) →
          ∃ (N : Type (max u v w x z)) (_ : Field N) (_ : Algebra K N)
            (_ : Algebra A N) (_ : IsScalarTower A K N), IsEppWeakSolution A B K L N := by
  sorry

end IsDiscreteValuationRing
