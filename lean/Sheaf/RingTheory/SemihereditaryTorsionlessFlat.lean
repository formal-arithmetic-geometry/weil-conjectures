module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.RingHom.Flat

import Mathlib.RingTheory.Flat.EquationalCriterion

/-! # Flatness of torsionless modules over semihereditary rings

Source: Hemo--Richarz--Scholbach, Constructible sheaves on schemes, Lemma 6.10,
proof, last sentence, citing Lam, Lectures on modules and rings (1999),
Definition 4.64 and Theorem 4.67 (Chase).
(blueprint: lem-sfb-semihereditary-torsionless-flat)
-/

@[expose] public section

set_option autoImplicit false

universe u v w

namespace Module.Flat

/-- A module embedding linearly into an unrestricted product of copies of a commutative
ring is flat if every finitely generated ideal of the ring is projective.

Source: Hemo--Richarz--Scholbach, Constructible sheaves on schemes, Lemma 6.10,
proof, last sentence; Lam, Lectures on modules and rings (1999), Definition 4.64 and
Theorem 4.67 (Chase). The following direct proof is the agent-written proof of the node,
using Stacks Tags 05CF and 00HK.
(blueprint: lem-sfb-semihereditary-torsionless-flat)

Proof: fix a finite relation sum_i f_i x_i = 0 in M, and let I be the ideal generated by
the f_i. The surjection q : R^n -> I, sending (r_i) to sum_i f_i r_i, has a section s
because I is finitely generated and hence projective by hR. Use the lifting property
of def-weil-pbc-projective-module (Module.projective_lifting_property) with id_I.
Set p = id - s q. Then q p = 0 and p is the identity on ker(q).
For the j-th coordinate vector b_j, write p(b_j)_i = a_ij. The first identity gives
sum_i f_i a_ij = 0. For every alpha in A, the vector v_alpha = (e(x_i)(alpha))_i
lies in ker(q), by linearity of e and the given relation. Expanding p(v_alpha) in the
coordinate vectors gives e(x_i)(alpha) = sum_j a_ij e(x_j)(alpha). Equality of
functions and injectivity of e give x_i = sum_j a_ij x_j. Thus the relation is trivial,
with m = n and y_j = x_j, in the sense of lem-weil-pbc-flat-equational-criterion
(Module.IsTrivialRelation). Module.Flat.iff_forall_isTrivialRelation then proves
flatness. For n = 0 the empty matrix and empty family give the same argument. -/
theorem of_injective_pi_of_projective_fg_ideals
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    (hR : ∀ I : Ideal R, I.FG → Module.Projective R I)
    {A : Type w} (e : M →ₗ[R] (A → R)) (he : Function.Injective e) :
    Module.Flat R M := by
  classical
  apply Module.Flat.of_forall_isTrivialRelation
  intro n f x hfx
  let q : (Fin n → R) →ₗ[R] R := ∑ i, f i • LinearMap.proj i
  have hq (v : Fin n → R) : q v = ∑ i, f i * v i := by
    simp [q, LinearMap.sum_apply, LinearMap.smul_apply]
  let I : Ideal R := q.range
  let : Module.Projective R I := hR I (Submodule.fg_range q)
  obtain ⟨s, hs⟩ := Module.projective_lifting_property q.rangeRestrict
    (LinearMap.id : I →ₗ[R] I) q.surjective_rangeRestrict
  let p : (Fin n → R) →ₗ[R] (Fin n → R) := LinearMap.id - s.comp q.rangeRestrict
  have hqp (v : Fin n → R) : q (p v) = 0 := by
    have hv := congrArg Subtype.val (LinearMap.congr_fun hs (q.rangeRestrict v))
    change q (s (q.rangeRestrict v)) = q v at hv
    change q (v - s (q.rangeRestrict v)) = 0
    rw [map_sub, hv, sub_self]
  have hp (v : Fin n → R) (hv : q v = 0) : p v = v := by
    have hv' : q.rangeRestrict v = 0 := Subtype.ext hv
    change v - s (q.rangeRestrict v) = v
    rw [hv', map_zero, sub_zero]
  have hexpand (v : Fin n → R) :
      p v = ∑ j, v j • p (Pi.single j 1) := by
    simp_rw [← map_smul]
    rw [← map_sum]
    congr 1
    simp only [← Pi.single_smul, smul_eq_mul, mul_one, Finset.univ_sum_single]
  refine ⟨n, fun i j ↦ p (Pi.single j 1) i, x, ?_, ?_⟩
  · intro i
    apply he
    ext α
    let v : Fin n → R := fun j ↦ e (x j) α
    have hv : q v = 0 := by
      rw [hq]
      have h := congrArg (fun z ↦ e z α) hfx
      simpa [map_sum, map_smul, Finset.sum_apply] using h
    have hi := congrFun ((hp v hv).symm.trans (hexpand v)) i
    simpa [v, map_sum, map_smul, Finset.sum_apply, mul_comm] using hi
  · intro j
    exact (hq _).symm.trans (hqp _)

end Module.Flat
