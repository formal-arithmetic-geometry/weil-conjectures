/-! # Straightening coefficients in a split node

Source: Stacks Project, Curves, Tags 0C4D and 0CBW, coefficient-field convention
(blueprint: lem-trf-nodal-coefficient-straightening).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace MvPowerSeries

private theorem noetherian_ring_hopfian {R : Type u} [CommRing R] [IsNoetherianRing R]
    (f : R →+* R) (hf : Function.Surjective f) : Function.Injective f := by
  let F : ℕ → R →+* R := Nat.rec (RingHom.id R) (fun _ g ↦ f.comp g)
  have hF : ∀ n, Function.Surjective (F n) := by
    intro n
    induction n with
    | zero => exact Function.surjective_id
    | succ n hn => exact hf.comp hn
  have hmono : Monotone (fun n ↦ RingHom.ker (F n)) := by
    apply monotone_nat_of_le_succ
    intro n x hx
    change f (F n x) = 0
    rw [show F n x = 0 from hx, map_zero]
  obtain ⟨n, hn⟩ := monotone_stabilizes_iff_noetherian.mpr
    (inferInstance : IsNoetherian R R) ⟨_, hmono⟩
  rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
  intro x hx
  obtain ⟨y, hy⟩ := hF n x
  have hmem : y ∈ RingHom.ker (F (n + 1)) := by
    change f (F n y) = 0
    rw [hy, hx]
  have heq : RingHom.ker (F n) = RingHom.ker (F (n + 1)) :=
    hn (n + 1) (Nat.le_succ n)
  rw [← heq] at hmem
  exact hy.symm.trans hmem

/-- Any coefficient field of the standard split node which surjects onto its residue
field can be taken to the standard coefficients by a ring automorphism.
The residue condition is expressed modulo the ideal generated by the two variables.

Source: Stacks Project, Curves, Tags 0C4D and 0CBW
(blueprint: lem-trf-nodal-coefficient-straightening).

Proof: The node is complete for its variable ideal: it is a finite module over the
complete Noetherian power-series ring. Evaluate power series using the proposed
coefficient map and the two standard variables. Their product is zero, so evaluation
factors through the node. It is surjective modulo the variable ideal by hypothesis,
and the image of the source variable ideal is precisely the target variable ideal.
Complete-source lifting therefore makes the factor map surjective. A surjective
endomorphism of a Noetherian ring is injective: the ascending kernels of its iterates
stabilize, and surjectivity pulls any element of the first kernel back to the stable
kernel, forcing it to vanish. The inverse automorphism has the claimed scalar values.
This argument works over every field and in every characteristic. -/
theorem nodal_coefficient_straightening (k : Type u) [Field k]
    (α : k →+* (MvPowerSeries (Fin 2) k ⧸
      Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1}))
    (hα : ∀ z, ∃ a : k, z - α a ∈
      (Ideal.span (Set.range (X : Fin 2 → MvPowerSeries (Fin 2) k))).map
        (Ideal.Quotient.mk (Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1}))) :
    ∃ e : (MvPowerSeries (Fin 2) k ⧸
        Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1}) ≃+*
        (MvPowerSeries (Fin 2) k ⧸
          Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1}),
      ∀ a : k, e (α a) = Ideal.Quotient.mk _ (C a) := by
  classical
  let S := MvPowerSeries (Fin 2) k
  let I : Ideal S := Ideal.span {(X 0 : S) * X 1}
  let T := S ⧸ I
  let q : S →+* T := Ideal.Quotient.mk I
  let p : Ideal S := Ideal.span (Set.range (X : Fin 2 → S))
  let m : Ideal T := p.map q
  have : IsNoetherianRing T :=
    isNoetherianRing_of_surjective S T q Ideal.Quotient.mk_surjective
  have : IsAdicComplete p S := inferInstance
  have : IsAdicComplete p T := finite_module_complete_over_complete_noetherian S p T
  have : IsAdicComplete m T := (IsAdicComplete.map_algebraMap_iff p T).mpr inferInstance
  have ht (j : Fin 2) : q (X j) ∈ m :=
    Ideal.mem_map_of_mem q (Ideal.subset_span (Set.mem_range_self j))
  obtain ⟨Φ, hC, hX, _, _⟩ := exists_ringHom_of_isAdicComplete m α 2
    (fun j ↦ q (X j)) ht
  have hI : I ≤ RingHom.ker Φ := by
    apply Ideal.span_le.mpr
    rintro _ rfl
    change Φ ((X 0 : S) * X 1) = 0
    rw [map_mul, hX, hX, ← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  let θ : T →+* T := Ideal.Quotient.lift I Φ hI
  have hθ (v : S) : θ (q v) = Φ v := rfl
  have hmap : p.map Φ = m := by
    change p.map Φ = p.map q
    dsimp [p]
    rw [Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
    exact congrArg (fun v : Fin 2 → T ↦ Ideal.span (Set.range v)) (funext hX)
  have : IsHausdorff (p.map Φ) T := hmap.symm ▸ inferInstance
  have hΦ : Function.Surjective Φ := by
    apply surjective_of_mk_map_comp_surjective (I := p)
    intro z
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨a, ha⟩ := hα z
    refine ⟨C a, ?_⟩
    change Ideal.Quotient.mk (p.map Φ) (Φ (C a)) = _
    rw [hC, Ideal.Quotient.mk_eq_mk_iff_sub_mem, hmap]
    simpa only [neg_sub] using m.neg_mem ha
  have hsurj : Function.Surjective θ := by
    intro z
    obtain ⟨v, hv⟩ := hΦ z
    exact ⟨q v, hv⟩
  let E := RingEquiv.ofBijective θ ⟨noetherian_ring_hopfian θ hsurj, hsurj⟩
  refine ⟨E.symm, fun a ↦ E.injective ?_⟩
  change E (E.symm (α a)) = θ (q (C a))
  rw [E.apply_symm_apply, hθ, hC]

end MvPowerSeries
