module

public import Sheaf.RingTheory.PresentationFittingIdeal
public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.Algebra.Algebra.Prod
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.LinearAlgebra.TensorProduct.Basis
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Finite relations and Fitting generators for split tensor quotients

Source: Stacks Project, Tags 0812, 07Z8 and 07ZA(4)
(blueprint: lem-trf-split-tensor-quotient-finite-fitting).

The helper maps and relation lists are the canonical constructions in the statement.
Coordinates on `C ⊗[A] B` are computed by flipping to `B ⊗[A] C` and using `e.baseChange B`.
-/

@[expose] public section

universe u v w z

open scoped TensorProduct

namespace Algebra.TensorProduct

/-- The ideal `H` generated by the second components of `θ(k ⊗ 1)`, for `k ∈ K`.
Source: Stacks Project, Tag 0812
(blueprint: lem-trf-split-tensor-quotient-finite-fitting). -/
def splitComplementIdeal {A : Type u} {C : Type v} {B : Type w} {D : Type z}
    [CommRing A] [CommRing C] [CommRing B] [CommRing D] [Algebra A C] [Algebra A B]
    (θ : C ⊗[A] B ≃+* B × D) (K : Ideal C) : Ideal D :=
  Ideal.map ((RingHom.snd B D).comp (θ.toRingHom.comp includeLeftRingHom)) K

/-- The canonical map `q_B : C ⊗[A] B → D/H`, second projection followed by quotient.
Source: Stacks Project, Tag 0812
(blueprint: lem-trf-split-tensor-quotient-finite-fitting). -/
def splitComplementQuotient {A : Type u} {C : Type v} {B : Type w} {D : Type z}
    [CommRing A] [CommRing C] [CommRing B] [CommRing D] [Algebra A C] [Algebra A B]
    (θ : C ⊗[A] B ≃+* B × D) (K : Ideal C) :
    C ⊗[A] B →+* D ⧸ splitComplementIdeal θ K :=
  (Ideal.Quotient.mk (splitComplementIdeal θ K)).comp ((RingHom.snd B D).comp θ.toRingHom)

/-- The finite list `w_{ji} = (k_j ⊗ 1)(e_i ⊗ 1)`.
Source: Stacks Project, Tags 0812 and 07ZA(4)
(blueprint: lem-trf-split-tensor-quotient-finite-fitting). -/
noncomputable def splitTensorRelations {A : Type u} {C : Type v} {B : Type w}
    [CommRing A] [CommRing C] [CommRing B] [Algebra A C] [Algebra A B]
    {d r : ℕ} (e : Module.Basis (Fin d) A C) (k : Fin r → C) :
    Fin r × Fin d → C ⊗[A] B :=
  fun a ↦ (k a.1 ⊗ₜ[A] (1 : B)) * (e a.2 ⊗ₜ[A] (1 : B))

/-- The finite list consisting of `ε = θ⁻¹(1,0)` followed by all `w_{ji}`.
Source: Stacks Project, Tags 0812 and 07ZA(4)
(blueprint: lem-trf-split-tensor-quotient-finite-fitting). -/
noncomputable def splitComplementRelations {A : Type u} {C : Type v} {B : Type w} {D : Type z}
    [CommRing A] [CommRing C] [CommRing B] [CommRing D] [Algebra A C] [Algebra A B]
    {d r : ℕ} (θ : C ⊗[A] B ≃+* B × D) (e : Module.Basis (Fin d) A C)
    (k : Fin r → C) : Option (Fin r × Fin d) → C ⊗[A] B
  | none => θ.symm (1, 0)
  | some a => splitTensorRelations e k a

/-- The rank-`d` presentation sending the standard vector `i` to `q_B(e_i ⊗ 1)`.
Source: Stacks Project, Tags 0812 and 07Z8
(blueprint: lem-trf-split-tensor-quotient-finite-fitting). -/
noncomputable def splitComplementPresentation
    {A : Type u} {C : Type v} {B : Type w} {D : Type z}
    [CommRing A] [CommRing C] [CommRing B] [CommRing D]
    [Algebra A C] [Algebra A B] [Algebra B D]
    {d : ℕ} (θ : C ⊗[A] B ≃+* B × D) (e : Module.Basis (Fin d) A C) (K : Ideal C) :
    (Fin d → B) →ₗ[B] D ⧸ splitComplementIdeal θ K :=
  (Pi.basisFun B (Fin d)).constr B
    (fun i ↦ splitComplementQuotient θ K (e i ⊗ₜ[A] (1 : B)))

/-- Finite kernel relations, finite presentations and finite determinant generators for
both quotients of a split tensor algebra. The `id` application supplies exactly the
right-factor algebra structure; it does not quantify over additional algebra structures.
The two presentation ideals are the presentation-independent `I₀` of Tag 07Z8.
Source: Stacks Project, Tags 0812, 07Z8 and 07ZA(4)
(blueprint: lem-trf-split-tensor-quotient-finite-fitting).

Proof plan:
1. Define `f(c) = (θ(c ⊗ 1)).1`. Tensor multiplication and B-linearity give an A-algebra
   map and `(θ(c ⊗ b)).1 = b * f(c)`. Apply
   lem-trf-split-tensor-quotient-decomposition: the `e_i ⊗ 1` form a B-basis and
   `θ(J) = KB × H`. This uses lem-weil-pbc-algebra-tensor-pushout-universal-property.
2. The quotient kernel is K by def-weil-pbc-algebra-hom-quotient. Express every element
   of K as a sum of multiples of the k_j, and expand each coefficient in e. This gives
   the first kernel span, with the reverse containment from the ideal property.
3. Tensor the same ideal-generator expansion. Expand all tensor-algebra coefficients
   in the scalar-extended basis to obtain precisely the span of the w_{ji}.
4. If θ(t) = (b,h) with h in H, the product-ideal description supplies j in J with
   θ(j) = (0,h). Hence t = b ε + j. Conversely both summands are killed by q_B.
   Surjectivity follows by lifting a residue class of h with θ⁻¹(0,h).
5. The kernels give finite exact presentations of ranks rd → d and 1+rd → d,
   proving finite presentation in the sense of def-sc-finitely-presented-module.
6. Apply lem-trf-fitting-ideal-independence-base-change to the displayed surjections.
   Expand a determinant of arbitrary kernel rows in the finite relation list using
   the permutation formula of def-weil-pbc-matrix-determinant. Each determinant is a
   linear combination of ordered-tuple determinants; each displayed determinant is
   itself a kernel determinant. This proves the two ideal equalities.
7. The tuple index sets are finite, hence the two ideals are finitely generated.
   When d = 0 the unique empty determinant is 1 and both ideals are the unit ideals.
   No step assumes a Noetherian ring, flatness of B over A, or nonzero ranks. -/
theorem splitTensorQuotient_finite_fitting
    {A : Type u} {C : Type v} {B : Type w} {D : Type z}
    [CommRing A] [CommRing C] [CommRing B] [CommRing D]
    [Algebra A C] [Algebra A B] [Algebra B D]
    {d r : ℕ} (e : Module.Basis (Fin d) A C) (K : Ideal C) (k : Fin r → C)
    (hK : K = Ideal.span (Set.range k)) :
    @_root_.id (∀ [Algebra B (C ⊗[A] B)], Prop)
      (fun [Algebra B (C ⊗[A] B)] ↦
        ∀ θ : C ⊗[A] B ≃ₐ[B] B × D,
          Function.Surjective (splitComplementQuotient θ.toRingEquiv K) ∧
          LinearMap.ker (Ideal.Quotient.mkₐ A K).toLinearMap =
            Submodule.span A (Set.range (fun a : Fin r × Fin d ↦ k a.1 * e a.2)) ∧
          (Ideal.map (includeLeftRingHom : C →+* C ⊗[A] B) K).restrictScalars B =
            Submodule.span B (Set.range (splitTensorRelations e k)) ∧
          (RingHom.ker (splitComplementQuotient θ.toRingEquiv K)).restrictScalars B =
            Submodule.span B {θ.symm (1, 0)} ⊔
              (Ideal.map (includeLeftRingHom : C →+* C ⊗[A] B) K).restrictScalars B ∧
          (RingHom.ker (splitComplementQuotient θ.toRingEquiv K)).restrictScalars B =
            Submodule.span B (Set.range (splitComplementRelations θ.toRingEquiv e k)) ∧
          Module.FinitePresentation A (C ⧸ K) ∧
          Module.FinitePresentation B (D ⧸ splitComplementIdeal θ.toRingEquiv K) ∧
          LinearMap.presentationFittingIdeal
              ((Ideal.Quotient.mkₐ A K).toLinearMap.comp e.equivFun.symm.toLinearMap) 0 =
            Ideal.span (Set.range (fun t : Fin d → Fin r × Fin d ↦
              Matrix.det (fun i l ↦ e.repr (k (t i).1 * e (t i).2) l))) ∧
          (splitComplementPresentation θ.toRingEquiv e K).presentationFittingIdeal 0 =
            Ideal.span (Set.range (fun t : Fin d → Option (Fin r × Fin d) ↦
              Matrix.det (fun i l ↦ (e.baseChange B).repr
                (_root_.TensorProduct.comm A C B
                  (splitComplementRelations θ.toRingEquiv e k (t i))) l))) ∧
          (LinearMap.presentationFittingIdeal
            ((Ideal.Quotient.mkₐ A K).toLinearMap.comp e.equivFun.symm.toLinearMap) 0).FG ∧
          ((splitComplementPresentation θ.toRingEquiv e K).presentationFittingIdeal 0).FG)
      (rightAlgebra (R := A) (A := C) (B := B)) := by
  sorry

end Algebra.TensorProduct
