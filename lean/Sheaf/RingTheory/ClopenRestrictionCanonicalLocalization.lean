module

public import WeilConjectures.RingTheory.ProEtale.WContractible
public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.GroupTheory.MonoidLocalization.Away
public import Mathlib.CategoryTheory.Limits.HasLimits
public import Mathlib.RingTheory.Localization.Defs
public import Mathlib.RingTheory.Localization.AtPrime.Basic
import WeilConjectures.RingTheory.LocalizationPrimeResidueFieldIso
import Mathlib.Topology.Separation.Profinite

/-! # Canonical closed restriction by clopen idempotent localization

Source: Stacks Project, Tag 097C, `lemma-construct`, and the Preliminaries of the blueprint
`det-pe-wc-cover-second-stage`
(blueprint: lem-pe-clopen-restriction-canonical-localization).

The diagram uses the existing idempotent localizations and transition maps in
`WContractification.RestrictClopen`. Only its index is pulled back along the given map.
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

namespace WContractification.ClopenRestriction

variable {R P : Type u} [CommRing R] [TopologicalSpace P]

/-- Clopen neighbourhoods, with arrows in reverse inclusion. Source: Stacks 097C,
`lemma-construct` (blueprint: lem-pe-clopen-restriction-canonical-localization). -/
abbrev Index (Z : Set P) := {U : Clopens P // Z ⊆ (U : Set P)}ᵒᵖ

/-- Pull back a clopen to the spectrum. Source: blueprint Preliminaries,
`det-pe-wc-cover-second-stage`
(blueprint: lem-pe-clopen-restriction-canonical-localization). -/
def preimage (g : C(PrimeSpectrum R, P)) (U : Clopens P) : Clopens (PrimeSpectrum R) :=
  ⟨g ⁻¹' (U : Set P), U.isClopen.preimage g.continuous⟩

/-- The unique clopen idempotent, using Mathlib's equivalence (Stacks 00EE).
Source: blueprint Preliminaries
(blueprint: lem-pe-clopen-restriction-canonical-localization). -/
noncomputable abbrev idempotent (g : C(PrimeSpectrum R, P)) (U : Clopens P) : R :=
  (PrimeSpectrum.isIdempotentElemEquivClopens.symm (preimage g U)).val

/-- The prescribed diagram of localizations away from the pulled-back idempotents.
Source: Stacks 097C, `lemma-construct`
(blueprint: lem-pe-clopen-restriction-canonical-localization).
The functor laws are supplied by uniqueness of algebra maps out of a localization. -/
noncomputable abbrev diagram (g : C(PrimeSpectrum R, P)) (Z : Set P) :
    Index Z ⥤ CommAlgCat R where
  obj U := .of R (RestrictClopen (preimage g U.unop.val))
  map {_ _} f := CommAlgCat.ofHom (RestrictClopen.map (fun _ hx ↦ f.unop.le hx))
  map_id U := CommAlgCat.hom_ext <|
    @Subsingleton.elim _ (IsLocalization.algHom_subsingleton
      (Submonoid.powers (idempotent g U.unop.val))) _ _
  map_comp {U _ _} _ _ := CommAlgCat.hom_ext <|
    @Subsingleton.elim _ (IsLocalization.algHom_subsingleton
      (Submonoid.powers (idempotent g U.unop.val))) _ _

/-- The canonical colimit algebra. Source: Stacks 097C, `lemma-construct`
(blueprint: lem-pe-clopen-restriction-canonical-localization). -/
noncomputable abbrev algebra (g : C(PrimeSpectrum R, P)) (Z : Set P) : CommAlgCat R :=
  colimit (diagram g Z)

/-- Denominators generated by the neighbourhood idempotents. The main theorem says that
its carrier is already exactly their image, so no denominators are added by closure.
Source: Stacks 097C and blueprint Preliminaries
(blueprint: lem-pe-clopen-restriction-canonical-localization). -/
noncomputable def denominators (g : C(PrimeSpectrum R, P)) (Z : Set P) : Submonoid R :=
  Submonoid.closure (Set.range (fun U : Index Z ↦ idempotent g U.unop.val))

/-- Inclusion of neighbourhood diagrams for `Z ⊆ Z'`. Source: blueprint Preliminaries
(blueprint: lem-pe-clopen-restriction-canonical-localization). -/
def inclusion {Z Z' : Set P} (h : Z ⊆ Z') : Index Z' ⥤ Index Z where
  obj U := op ⟨U.unop.val, h.trans U.unop.property⟩
  map f := (homOfLE f.unop.le).op

/-- The restriction map is induced by restricting the actual colimit cocone, not by
choosing an abstract homomorphism. Source: blueprint Preliminaries
(blueprint: lem-pe-clopen-restriction-canonical-localization). -/
noncomputable def restriction (g : C(PrimeSpectrum R, P)) {Z Z' : Set P} (h : Z ⊆ Z') :
    algebra g Z' ⟶ algebra g Z :=
  colimit.pre (diagram g Z) (inclusion h)

private theorem index_nonempty (Z : Set P) : Nonempty (Index Z) :=
  ⟨op ⟨⊤, Set.subset_univ Z⟩⟩

private theorem index_filtered (Z : Set P) : IsFiltered (Index Z) where
  nonempty := index_nonempty Z
  cocone_objs U V := by
    let W : {U : Clopens P // Z ⊆ (U : Set P)} :=
      ⟨U.unop.val ⊓ V.unop.val, fun x hx ↦
        ⟨U.unop.property hx, V.unop.property hx⟩⟩
    exact ⟨op W, (homOfLE (show W ≤ U.unop from Subtype.mk_le_mk.mpr inf_le_left)).op,
      (homOfLE (show W ≤ V.unop from Subtype.mk_le_mk.mpr inf_le_right)).op, trivial⟩
  cocone_maps _ _ f _ := ⟨_, 𝟙 _, Subsingleton.elim _ _⟩

private theorem denominators_eq (g : C(PrimeSpectrum R, P)) (Z : Set P) :
    (denominators g Z : Set R) =
      Set.range (fun U : Index Z ↦ idempotent g U.unop.val) := by
  let M : Submonoid R :=
    { carrier := Set.range (fun U : Index Z ↦ idempotent g U.unop.val)
      one_mem' := by
        refine ⟨op ⟨⊤, Set.subset_univ Z⟩, ?_⟩
        change (PrimeSpectrum.isIdempotentElemEquivClopens.symm ⊤).val = 1
        rw [PrimeSpectrum.isIdempotentElemEquivClopens_symm_top]
      mul_mem' := by
        rintro a b ⟨U, rfl⟩ ⟨V, rfl⟩
        refine ⟨op ⟨U.unop.val ⊓ V.unop.val,
          fun x hx ↦ ⟨U.unop.property hx, V.unop.property hx⟩⟩, ?_⟩
        change (PrimeSpectrum.isIdempotentElemEquivClopens.symm
          (preimage g U.unop.val ⊓ preimage g V.unop.val)).val = _
        exact congrArg Subtype.val
          (PrimeSpectrum.isIdempotentElemEquivClopens_symm_inf _ _) }
  exact congrArg (fun N : Submonoid R ↦ (N : Set R))
    (Submonoid.closure_eq_of_le
      (show Set.range (fun U : Index Z ↦ idempotent g U.unop.val) ⊆ (M : Set R)
      from fun _ hx ↦ hx)
      (fun _ hx ↦ Submonoid.subset_closure hx))

private theorem colimit_localization (g : C(PrimeSpectrum R, P)) (Z : Set P) :
    IsLocalization (denominators g Z) (algebra g Z) := by
  let M := denominators g Z
  have hmem (U : Index Z) : idempotent g U.unop.val ∈ M :=
    Submonoid.subset_closure ⟨U, rfl⟩
  let c : Cocone (diagram g Z) :=
    { pt := CommAlgCat.of R (Localization M)
      ι :=
        { app := fun U ↦ CommAlgCat.ofHom
            { toRingHom := IsLocalization.Away.lift (idempotent g U.unop.val)
                (IsLocalization.map_units (Localization M) ⟨_, hmem U⟩)
              commutes' := fun r ↦ IsLocalization.Away.lift_eq _ _ r }
          naturality := fun U V f ↦ CommAlgCat.hom_ext <|
            @Subsingleton.elim _ (IsLocalization.algHom_subsingleton
              (Submonoid.powers (idempotent g U.unop.val))) _ _ } }
  have hu (s : Cocone (diagram g Z)) : ∀ m : M, IsUnit (algebraMap R s.pt m) := by
    have hle : M ≤ (IsUnit.submonoid s.pt).comap (algebraMap R s.pt) := by
      apply Submonoid.closure_le.mpr
      rintro _ ⟨U, rfl⟩
      change IsUnit (algebraMap R s.pt (idempotent g U.unop.val))
      have he : (s.ι.app U).hom
          (algebraMap R (RestrictClopen (preimage g U.unop.val))
            (idempotent g U.unop.val)) = algebraMap R s.pt (idempotent g U.unop.val) :=
        (s.ι.app U).hom.commutes _
      rw [← he]
      exact (IsLocalization.Away.algebraMap_isUnit (idempotent g U.unop.val)).map
        (s.ι.app U).hom.toRingHom
    exact fun m ↦ hle m.property
  let hc : IsColimit c :=
    { desc := fun s ↦ CommAlgCat.ofHom
        { toRingHom := IsLocalization.lift (hu s)
          commutes' := fun r ↦ IsLocalization.lift_eq (hu s) r }
      fac := fun s U ↦ CommAlgCat.hom_ext <|
        @Subsingleton.elim _ (IsLocalization.algHom_subsingleton
          (Submonoid.powers (idempotent g U.unop.val))) _ _
      uniq := fun s m _ ↦ CommAlgCat.hom_ext <|
        @Subsingleton.elim _ (IsLocalization.algHom_subsingleton M) _ _ }
  exact IsLocalization.isLocalization_of_algEquiv M
    (CommAlgCat.algEquivOfIso (hc.coconePointUniqueUpToIso (colimit.isColimit _)))

private theorem idempotent_not_mem (g : C(PrimeSpectrum R, P))
    (U : Clopens P) (x : PrimeSpectrum R) :
    idempotent g U ∉ x.asIdeal ↔ g x ∈ U := by
  change x ∈ PrimeSpectrum.basicOpen (idempotent g U) ↔ _
  rw [show PrimeSpectrum.basicOpen (idempotent g U) = (preimage g U).toOpens from
    PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm _]
  rfl

private theorem spectrum_range [CompactSpace P] [T2Space P] [TotallyDisconnectedSpace P]
    (g : C(PrimeSpectrum R, P)) (Z : Set P) (hZ : IsClosed Z)
    [IsLocalization (denominators g Z) (algebra g Z)] :
    Set.range (PrimeSpectrum.comap (algebraMap R (algebra g Z))) = g ⁻¹' Z := by
  rw [PrimeSpectrum.localization_comap_range (algebra g Z) (denominators g Z)]
  ext x
  change Disjoint (denominators g Z : Set R) (x.asIdeal : Set R) ↔ g x ∈ Z
  rw [denominators_eq, Set.disjoint_left]
  constructor
  · intro hx
    by_contra hn
    obtain ⟨W, hW, hp, hsub⟩ :=
      compact_exists_isClopen_in_isOpen hZ.isOpen_compl hn
    let U : Clopens P := ⟨Wᶜ, hW.compl⟩
    have hU : Z ⊆ (U : Set P) := fun z hz hw ↦ hsub hw hz
    have he := (idempotent_not_mem g U x).mp
      (hx ⟨op ⟨U, hU⟩, rfl⟩)
    exact he hp
  · intro hx a ha
    obtain ⟨U, rfl⟩ := ha
    exact (idempotent_not_mem g U.unop.val x).mpr (U.unop.property hx)

/-- Canonical closed restriction: the index is nonempty and filtered, its idempotents
form a multiplicative set, and its specified colimit is the localization at that set.
Contraction identifies its spectrum and gives the canonical local-ring isomorphisms.
Source: Stacks 097C, `lemma-construct`, Stacks 00CP, 00E3, 00C9, and blueprint Preliminaries
(blueprint: lem-pe-clopen-restriction-canonical-localization).

Proof:
1. The top clopen is a neighbourhood and intersections receive arrows from both
   neighbourhoods; the poset has no distinct parallel arrows. This gives filteredness
   and nonemptiness (def-weil-size-convention, def-weil-pbc-category-colimit).
2. The clopen-idempotent bijection (lem-weil-pbc-spec-clopen-idempotent) gives
   e_top = 1 and e_(U intersection V) = e_U e_V. Thus the displayed image is already
   multiplicative. For V contained in U, e_U e_V = e_V makes e_U invertible in R[1/e_V].
   The localization universal property gives the unique transitions and their laws
   (def-weil-ring-localization-away, lem-weil-pbc-ring-localization-universal-property).
3. Each neighbourhood localization maps canonically to M_Z^{-1}R. Conversely any
   cocone makes every e_U invertible in its vertex, hence uniquely factors through
   M_Z^{-1}R by Stacks 00CP. Uniqueness on R gives compatibility with every leg.
   Thus this localization is a colimit, and the chosen colimit is canonically the
   same R-algebra (def-weil-pbc-category-colimit).
4. A closed subset of a profinite space is the intersection of its clopen
   neighbourhoods: separate a point outside it using the clopen basis
   (lem-weil-pbc-profinite-clopen-basis). A prime misses every e_U precisely when
   its image lies in that intersection. The localization spectrum embedding
   (lem-weil-pbc-localization-spectrum-embedding) therefore has exactly the stated range.
5. At a prime q, apply lem-weil-pbc-localization-prime-residue-field-iso (2) to the
   localization just identified. It gives the canonical local map a/s ↦ a/ s after
   applying the structure map, not merely an abstract local-ring isomorphism
   (def-weil-pbc-localization-at-prime). -/
theorem canonical_localization [CompactSpace P] [T2Space P] [TotallyDisconnectedSpace P]
    (g : C(PrimeSpectrum R, P)) (Z : Set P) (hZ : IsClosed Z) :
    Nonempty (Index Z) ∧ IsFiltered (Index Z) ∧
    (denominators g Z : Set R) =
      Set.range (fun U : Index Z ↦ idempotent g U.unop.val) ∧
    IsLocalization (denominators g Z) (algebra g Z) ∧
    (∃ E : algebra g Z ≃ₐ[R] Localization (denominators g Z),
      ∀ (U : Index Z)
        (κ : RestrictClopen (preimage g U.unop.val) →ₐ[R]
          Localization (denominators g Z)),
        E.toAlgHom.comp (colimit.ι (diagram g Z) U).hom = κ) ∧
    (∃ H : PrimeSpectrum (algebra g Z) ≃ₜ (g ⁻¹' Z),
      ∀ q, (H q).val = PrimeSpectrum.comap (algebraMap R (algebra g Z)) q) ∧
    (∀ q : PrimeSpectrum (algebra g Z),
      ∃ α : Localization.AtPrime
          (q.asIdeal.comap (algebraMap R (algebra g Z))) ≃ₐ[R]
          Localization.AtPrime q.asIdeal,
        α.toRingHom = Localization.localRingHom
          (q.asIdeal.comap (algebraMap R (algebra g Z))) q.asIdeal
          (algebraMap R (algebra g Z)) rfl) := by
  let := colimit_localization g Z
  refine ⟨index_nonempty Z, index_filtered Z, denominators_eq g Z, inferInstance, ?_, ?_, ?_⟩
  · refine ⟨IsLocalization.algEquiv (denominators g Z) (algebra g Z)
      (Localization (denominators g Z)), ?_⟩
    intro U κ
    exact @Subsingleton.elim _ (IsLocalization.algHom_subsingleton
      (Submonoid.powers (idempotent g U.unop.val))) _ _
  · refine ⟨(PrimeSpectrum.localization_comap_isEmbedding (algebra g Z)
      (denominators g Z)).toHomeomorph.trans
        (Homeomorph.setCongr (spectrum_range g Z hZ)), ?_⟩
    intro q
    rfl
  · intro q
    obtain ⟨α, hα, _⟩ := (IsLocalization.prime_localRing_residueField_iso R
      (algebra g Z) (denominators g Z) q.asIdeal).2.2.2.2.2.2
    exact ⟨α, hα⟩

/-- Restriction maps compose, induce inclusions on spectra, and become identity maps
under the canonical local-ring identifications. Source: blueprint Preliminaries and
Stacks 00CP (blueprint: lem-pe-clopen-restriction-canonical-localization).

Proof:
6. For Z contained in Z', restrict the colimit cocone along the inclusion of indices.
   This is exactly `restriction`; under the localization description it is the unique
   R-algebra map fixing R. Its identity and composition laws follow by localization
   uniqueness (lem-weil-pbc-ring-localization-universal-property).
7. Contracting a prime along this R-algebra map and then to R gives the original
   contraction. The homeomorphisms in canonical_localization consequently identify
   the spectrum map with the inclusion of inverse images (def-weil-affine-spectrum).
8. If q' is the contraction of q, the induced local map sends b/t to its image
   fraction. For a/s in R_x the composite is λ_Z(a)/λ_Z(s), exactly the direct
   canonical map. Every element is a fraction, so the two maps agree. Since the
   two canonical maps from R_x are isomorphisms, conjugating gives its identity
   (def-weil-pbc-localization-at-prime, lem-weil-pbc-ring-localization-universal-property).
-/
theorem restriction_naturality [CompactSpace P] [T2Space P] [TotallyDisconnectedSpace P]
    (g : C(PrimeSpectrum R, P)) :
    (∀ (Z : Set P) (_hZ : IsClosed Z), restriction g (Set.Subset.refl Z) = 𝟙 _) ∧
    (∀ (Z Z' Z'' : Set P) (_hZ : IsClosed Z) (_hZ' : IsClosed Z')
      (_hZ'' : IsClosed Z'') (h : Z ⊆ Z') (h' : Z' ⊆ Z''),
      restriction g h' ≫ restriction g h = restriction g (h.trans h')) ∧
    (∀ (Z Z' : Set P) (_hZ : IsClosed Z) (_hZ' : IsClosed Z') (h : Z ⊆ Z')
      (q : PrimeSpectrum (algebra g Z)),
      PrimeSpectrum.comap (algebraMap R (algebra g Z'))
        (PrimeSpectrum.comap (restriction g h).hom.toRingHom q) =
        PrimeSpectrum.comap (algebraMap R (algebra g Z)) q) ∧
    (∀ (Z Z' : Set P) (_hZ : IsClosed Z) (_hZ' : IsClosed Z') (h : Z ⊆ Z')
      (q : PrimeSpectrum (algebra g Z)) (x : Ideal R) [x.IsPrime]
      (hx : x = q.asIdeal.comap (algebraMap R (algebra g Z)))
      (hx' : x = (q.asIdeal.comap (restriction g h).hom.toRingHom).comap
        (algebraMap R (algebra g Z'))),
      (Localization.localRingHom (q.asIdeal.comap (restriction g h).hom.toRingHom)
        q.asIdeal (restriction g h).hom.toRingHom rfl).comp
        (Localization.localRingHom x (q.asIdeal.comap (restriction g h).hom.toRingHom)
          (algebraMap R (algebra g Z')) hx') =
        Localization.localRingHom x q.asIdeal (algebraMap R (algebra g Z)) hx) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro Z _
    apply CommAlgCat.hom_ext
    let := colimit_localization g Z
    exact @Subsingleton.elim _ (IsLocalization.algHom_subsingleton (denominators g Z)) _ _
  · intro Z Z' Z'' _ _ _ h h'
    apply CommAlgCat.hom_ext
    let := colimit_localization g Z''
    exact @Subsingleton.elim _ (IsLocalization.algHom_subsingleton (denominators g Z'')) _ _
  · intro Z Z' _ _ h q
    rw [← PrimeSpectrum.comap_comp_apply]
    congr 1
    exact (restriction g h).hom.comp_algebraMap
  · intro Z Z' _ _ h q x _ hx hx'
    rw [← Localization.localRingHom_comp]
    congr 1
    exact (restriction g h).hom.comp_algebraMap

end WContractification.ClopenRestriction
