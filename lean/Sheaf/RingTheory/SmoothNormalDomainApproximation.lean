module

public import Mathlib.Algebra.Category.Ring.Basic
public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.CategoryTheory.Limits.HasLimits
public import Mathlib.RingTheory.RingHom.Smooth
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Noetherian.Defs

/-!
# Noetherian approximation of smooth algebras over normal domains

Source: Stacks Project, Algebra, proof of Tag 033C, third paragraph.
(blueprint: lem-weil-pbc-smooth-normal-domain-approximation).
-/

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits

namespace RingHom.Smooth

/-- A smooth algebra over a normal domain is a filtered colimit of smooth algebras
whose base rings are Noetherian and normal.

Source: Stacks Project, Algebra, proof of Tag 033C, third paragraph; Tags 00TP,
0335 and 00DD. (blueprint: lem-weil-pbc-smooth-normal-domain-approximation)

Proof: descend the smooth algebra to a smooth algebra S₀ over a finitely generated
subring R₀ of R, using smooth Noetherian descent (Tag 00TP). Normalize each finitely
generated subring of R containing R₀ in its fraction field. Its normalization lies
in R since R is integrally closed. It is finite over the original subring by
Tag 0335, so is itself finitely generated over Z and Noetherian. These normal
subrings form a nonempty directed family: normalize the ring generated by two
members to obtain an upper bound. Their union is R since normalizing R₀[x]
produces a member containing any given x in R. For each member A use the smooth
A-algebra A ⊗[R₀] S₀, with transition maps induced by inclusions of subrings.
Tensor products commute with the directed union (Tag 00DD), so the colimit is S.
Take the small category of these subrings as the index category; all rings and
indices fit in the maximum of the two original universes, using universe lifts
where necessary. Localizations of the normal domains A are normal domains,
which gives the displayed normality of each base. The target S need not be a
domain or nonzero; neither is required for the tensor-product construction.
-/
theorem exists_noetherian_normal_model_colimit
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [IsDomain R] [IsIntegrallyClosed R] {f : R →+* S} (hf : f.Smooth) :
    ∃ (I : Type (max u v)) (_ : SmallCategory I) (_ : IsFiltered I)
      (F : I ⥤ CommRingCat.{max u v}) (_ : HasColimit F),
      Nonempty ((colimit F : CommRingCat.{max u v}) ≃+* S) ∧
      ∀ i : I, ∃ (A : Type (max u v)) (_ : CommRing A) (_ : IsNoetherianRing A)
        (g : A →+* F.obj i), g.Smooth ∧
        ∀ (p : Ideal A) [p.IsPrime],
          IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p) := by
  sorry

end RingHom.Smooth
