module

public import Sheaf.AlgebraicGeometry.FineFanBlowup
public import Sheaf.AlgebraicGeometry.MonoschemeToricRealization
public import Mathlib.Algebra.MonoidAlgebra.Ideal
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# Equivariant ideals on affine toric charts

Source: ILO, Exposé VIII, Proposition 3.2.2 and 3.2.14--3.2.15, pp. 103, 105
(blueprint: lem-trf-affine-toric-equivariant-ideals).

As in the recorded fan interface, monoids are written multiplicatively: `1` is the
additive identity, multiplication is addition, and division in the completion is subtraction.
-/

@[expose] public section

set_option autoImplicit false

universe u v w z

open Algebra AlgebraicGeometry
open scoped TensorProduct

namespace MonoidAlgebra

/-- The affine monomial ideal, with the empty generating set allowed. This is the ring-level
ideal used by `Monoscheme.chartRingIdeal`, before passage to the affine ideal sheaf.
Source: ILO VIII 3.2.14 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def toricIdeal (k : Type v) [Field k] {P : Type u} [CommMonoid P]
    (I : SemigroupIdeal P) : Ideal (MonoidAlgebra k P) :=
  Ideal.span (MonoidAlgebra.of k P '' (I : Set P))

/-- Exponents whose unit-coefficient monomial belongs to a ring ideal.
Source: ILO VIII 3.2.14 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def toricExponents (k : Type v) [Field k] {P : Type u} [CommMonoid P]
    (J : Ideal (MonoidAlgebra k P)) : SemigroupIdeal P where
  carrier := {p | MonoidAlgebra.of k P p ∈ J}
  smul_mem' p q hq := by
    change MonoidAlgebra.of k P (p * q) ∈ J
    rw [map_mul]
    exact J.mul_mem_left _ hq

/-- The affine coaction in the tensor order of the node: `e^p ↦ e^p ⊗ e^[p]`.
This is the affine version of `Monoscheme.coaction`, with the two factors interchanged.
Source: ILO VIII 3.2.4, 3.2.15 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def affineToricCoaction (k : Type v) [Field k]
    (P : Type u) [CommMonoid P] :
    MonoidAlgebra k P →ₐ[k]
      MonoidAlgebra k P ⊗[k] MonoidAlgebra k (GrothendieckGroup P) :=
  MonoidAlgebra.lift k _ P
    { toFun := fun p ↦ MonoidAlgebra.of k P p ⊗ₜ[k]
        MonoidAlgebra.of k (GrothendieckGroup P) (GrothendieckGroup.of p)
      map_one' := by simp only [map_one]; rfl
      map_mul' := fun p q ↦ by
        simp only [map_mul, Algebra.TensorProduct.tmul_mul_tmul] }

/-- Equivariance means equality of the action and projection extensions of the ideal.
Over a field the projection extension is precisely the image of `J ⊗ k[G]`.
Source: ILO VIII Lemma 3.2.15 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
def IsAffineToricEquivariant (k : Type v) [Field k] {P : Type u} [CommMonoid P]
    (J : Ideal (MonoidAlgebra k P)) : Prop :=
  J.map (affineToricCoaction k P).toRingHom =
    J.map (Algebra.TensorProduct.includeLeft : MonoidAlgebra k P →ₐ[k]
      MonoidAlgebra k P ⊗[k] MonoidAlgebra k (GrothendieckGroup P)).toRingHom

/-- Extension of a monoid ideal is the ideal generated by its image, `h(I)P'`.
Source: ILO VIII 3.2.2, 3.2.14 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
def toricIdealExtension {P : Type u} {Q : Type w} [CommMonoid P] [CommMonoid Q]
    (h : P →* Q) (I : SemigroupIdeal P) : SemigroupIdeal Q :=
  SemigroupIdeal.closure (h '' (I : Set P))

/-- The monoid map into the recorded fraction submonoid `P-S ⊆ P^gp`.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
def toricLocalizationInclusion {P : Type u} [CommMonoid P] (S : Submonoid P) :
    P →* Algebra.faceLocalization P S where
  toFun p := ⟨GrothendieckGroup.of p, p, 1, by simp⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' p q := Subtype.ext (map_mul _ p q)

/-- Every denominator in the localized monoid has its specified inverse fraction.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
def toricLocalizationUnit {P : Type u} [CommMonoid P] (S : Submonoid P) (a : S) :
    Units (Algebra.faceLocalization P S) where
  val := toricLocalizationInclusion S a.1
  inv := ⟨(GrothendieckGroup.of a.1)⁻¹, 1, a, by simp⟩
  val_inv := Subtype.ext (mul_inv_cancel _)
  inv_val := Subtype.ext (inv_mul_cancel _)

/-- The canonical map on monoid algebras into the fraction monoid algebra.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def toricLocalizationRingMap (k : Type v) [Field k]
    {P : Type u} [CommMonoid P] (S : Submonoid P) :
    MonoidAlgebra k P →+* MonoidAlgebra k (Algebra.faceLocalization P S) :=
  MonoidAlgebra.mapDomainRingHom k (toricLocalizationInclusion S)

/-- The canonical fraction map, constructed by the localization universal property.
Its inverse, when `S` consists of powers of `a`, is asserted in the main theorem.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def toricFractionMap (k : Type v) [Field k]
    {P : Type u} [CommMonoid P] (S : Submonoid P) (a : P) (ha : a ∈ S) :
    Localization.Away (MonoidAlgebra.of k P a) →+*
      MonoidAlgebra k (Algebra.faceLocalization P S) :=
  Localization.awayLift (toricLocalizationRingMap k S) (MonoidAlgebra.of k P a)
    (by
      change IsUnit (MonoidAlgebra.mapDomainRingHom k (toricLocalizationInclusion S)
        (MonoidAlgebra.of k P a))
      simpa [toricLocalizationUnit, MonoidAlgebra.mapDomainRingHom, MonoidAlgebra.of] using
        (toricLocalizationUnit S ⟨a, ha⟩).isUnit.map
        (MonoidAlgebra.of k (Algebra.faceLocalization P S)))

/-- The canonical transition between fraction monoids, in the same completion.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
def toricLocalizationTransition {P : Type u} [CommMonoid P] {S T : Submonoid P}
    (h : S ≤ T) : Algebra.faceLocalization P S →* Algebra.faceLocalization P T where
  toFun x := ⟨x.1, by
    obtain ⟨p, s, hs⟩ := x.2
    exact ⟨p, ⟨s.1, h s.2⟩, hs⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

/-- A fraction with its displayed natural-number denominator exponent.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
def toricFraction {R : Type w} [CommRing R] (a f : R) (n : ℕ) : Localization.Away a :=
  Localization.mk f ⟨a ^ n, n, rfl⟩

/-- A second localization maps into the same fraction monoid algebra whenever both
specified denominators lie in `S`. This is an actual iterated localization map.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def toricDoubleFractionMap (k : Type v) [Field k]
    {P : Type u} [CommMonoid P] (S : Submonoid P)
    (a : P) (ha : a ∈ S) (b : P) (hb : b ∈ S) :
    Localization.Away (algebraMap (MonoidAlgebra k P)
      (Localization.Away (MonoidAlgebra.of k P a)) (MonoidAlgebra.of k P b)) →+*
      MonoidAlgebra k (Algebra.faceLocalization P S) :=
  Localization.awayLift (toricFractionMap k S a ha) _ (by
    rw [toricFractionMap, Localization.awayLift, IsLocalization.Away.lift_eq]
    change IsUnit (MonoidAlgebra.mapDomainRingHom k (toricLocalizationInclusion S)
      (MonoidAlgebra.of k P b))
    simpa [toricLocalizationUnit, MonoidAlgebra.mapDomainRingHom, MonoidAlgebra.of] using
        (toricLocalizationUnit S ⟨b, hb⟩).isUnit.map
      (MonoidAlgebra.of k (Algebra.faceLocalization P S)))

/-- The map on fraction monoids induced by a monoid homomorphism.
Source: ILO VIII Proposition 3.2.2 (blueprint: lem-trf-affine-toric-equivariant-ideals). -/
noncomputable def toricLocalizedHom {P : Type u} {Q : Type w}
    [CommMonoid P] [CommMonoid Q] (h : P →* Q) (S : Submonoid P) :
    Algebra.faceLocalization P S →* Algebra.faceLocalization Q (S.map h) where
  toFun x := ⟨GrothendieckGroup.lift (GrothendieckGroup.of.comp h) x.1, by
    obtain ⟨p, s, hs⟩ := x.2
    refine ⟨h p, ⟨h s.1, Submonoid.mem_map.mpr ⟨s.1, s.2, rfl⟩⟩, ?_⟩
    rw [hs, map_mul, map_inv]
    have hc : (GrothendieckGroup.lift (GrothendieckGroup.of.comp h)).comp
        GrothendieckGroup.of = GrothendieckGroup.of.comp h :=
      GrothendieckGroup.lift.symm_apply_apply (GrothendieckGroup.of.comp h)
    exact congrArg₂ (fun x y ↦ x * y⁻¹)
      (congrArg (fun f : P →* GrothendieckGroup Q ↦ f p) hc)
      (congrArg (fun f : P →* GrothendieckGroup Q ↦ f s.1) hc)⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ x.1 y.1)

/-- Affine toric equivariant ideals are exactly monomial ideals. The canonical fraction
maps are bijective ring homomorphisms, hence the canonical ring isomorphisms, with the
specified formulas and compatibility for successive localizations and homomorphisms.

Source: ILO VIII Proposition 3.2.2, 3.2.14 and Lemma 3.2.15, pp. 103, 105
(blueprint: lem-trf-affine-toric-equivariant-ideals).

Proof:
1. Apply lem-trf-monoid-algebra-ideal-support to identify the span with the finite sums
   supported on the monoid ideal. The coefficient of a monomial is 1, so it detects its
   exponent, including for the empty and whole ideals.
2. For an equivariant ideal apply each group-algebra coefficient functional to its coaction.
   Injectivity into the completion, supplied by fineness, isolates each coefficient monomial.
   Invert a nonzero field coefficient to recover the corresponding unit monomial. This works
   also over finite fields. Conversely `e^i ⊗ 1 = μ(e^i)(1 ⊗ e^(-i))` proves equivariance.
3. A finite set of ideal exponents generates the ring ideal. In the other direction take
   the union of the finite supports of ring generators and apply the same support lemma.
4. The fraction map sends `e^p/(e^a)^n` to `e^(p-na)`. Its inverse is independent of the
   expression since equality in the completion gives equality after cross multiplication
   in the integral monoid. These maps respect products and finite sums and are inverse.
5. Apply the support lemma to the extended monomial generators: their exponents are
   exactly `I-ℕa`. For an arbitrary homomorphism the exponents are `h(I)+Q`, even when
   distinct image exponents collide. Finite supports make these identifications explicit.
6. Successive fractions have exponent `p-na-mb` in either order; the maps to a common
   localized monoid algebra agree. Repeating a denominator adds its powers. For successive
   homomorphisms use `u(h(I)+Q)+R = u(h(I))+R`. A localized homomorphism sends `p-na`
   to `h(p)-nh(a)`, so extension and localization commute on monomials and ideal generators.
The tensor universal property is def-weil-pbc-module-tensor-product; the fraction relation
is def-weil-ring-localization-away. Empty ideals and empty sets of generators are included. -/
theorem affine_toric_equivariant_ideals (k : Type v) [Field k]
    (P : Type u) [CommMonoid P] (hP : FineFan.IsFine P)
    [IsMulTorsionFree (GrothendieckGroup P)] :
    (∀ I : SemigroupIdeal P,
      IsAffineToricEquivariant k (toricIdeal k I) ∧
      toricExponents k (toricIdeal k I) = I ∧
      ((toricIdeal k I).FG ↔ I.FG) ∧
      (toricIdeal k I = ⊥ ↔ I = ⊥) ∧
      (toricIdeal k I = ⊤ ↔ I = ⊤) ∧
      (∀ f : MonoidAlgebra k P, f ∈ toricIdeal k I ↔
        ∀ p ∈ f.coeff.support, p ∈ I)) ∧
    (∀ J : Ideal (MonoidAlgebra k P), IsAffineToricEquivariant k J →
      toricIdeal k (toricExponents k J) = J ∧
      ((toricExponents k J).FG ↔ J.FG)) ∧
    (∀ a : P,
      Function.Bijective (toricFractionMap k (Submonoid.powers a) a
        (Submonoid.mem_powers a)) ∧
      (∀ (p : P) (n : ℕ),
        MonoidAlgebra.mapDomainRingHom k (Algebra.faceLocalization P
          (Submonoid.powers a)).subtype
          (toricFractionMap k (Submonoid.powers a) a (Submonoid.mem_powers a)
            (toricFraction (MonoidAlgebra.of k P a) (MonoidAlgebra.of k P p) n)) =
        MonoidAlgebra.of k (GrothendieckGroup P)
          (GrothendieckGroup.of p * (GrothendieckGroup.of a)⁻¹ ^ n)) ∧
      (∀ I : SemigroupIdeal P,
        (toricIdeal k I).map ((toricFractionMap k (Submonoid.powers a) a
          (Submonoid.mem_powers a)).comp (algebraMap _ _)) =
          toricIdeal k (toricIdealExtension
            (toricLocalizationInclusion (Submonoid.powers a)) I)) ∧
      (∀ (I : SemigroupIdeal P) (x : Algebra.faceLocalization P (Submonoid.powers a)),
        x ∈ toricIdealExtension (toricLocalizationInclusion (Submonoid.powers a)) I ↔
          ∃ i ∈ I, ∃ n : ℕ,
            x.1 = GrothendieckGroup.of i * (GrothendieckGroup.of a)⁻¹ ^ n)) ∧
    (∀ (Q : Type w) [CommMonoid Q], FineFan.IsFine Q →
      ∀ (h : P →* Q) (I : SemigroupIdeal P),
        (toricIdeal k I).map (MonoidAlgebra.mapDomainRingHom k h) =
          toricIdeal k (toricIdealExtension h I)) ∧
    (∀ (Q : Type w) (R : Type z) [CommMonoid Q] [CommMonoid R],
      FineFan.IsFine Q → FineFan.IsFine R →
      ∀ (h : P →* Q) (g : Q →* R) (I : SemigroupIdeal P),
        toricIdealExtension g (toricIdealExtension h I) =
          toricIdealExtension (g.comp h) I ∧
        (MonoidAlgebra.mapDomainRingHom k g).comp (MonoidAlgebra.mapDomainRingHom k h) =
          MonoidAlgebra.mapDomainRingHom k (g.comp h)) ∧
    (∀ (a b p : P) (n m : ℕ)
      (ha : a ∈ Submonoid.powers a ⊔ Submonoid.powers b)
      (hb : b ∈ Submonoid.powers a ⊔ Submonoid.powers b),
      MonoidAlgebra.mapDomainRingHom k
        (Algebra.faceLocalization P (Submonoid.powers a ⊔ Submonoid.powers b)).subtype
        (toricDoubleFractionMap k (Submonoid.powers a ⊔ Submonoid.powers b) a ha b hb
          (toricFraction
            (algebraMap _ (Localization.Away (MonoidAlgebra.of k P a))
              (MonoidAlgebra.of k P b))
            (toricFraction (MonoidAlgebra.of k P a) (MonoidAlgebra.of k P p) n) m)) =
        MonoidAlgebra.of k (GrothendieckGroup P)
          (GrothendieckGroup.of p * (GrothendieckGroup.of a)⁻¹ ^ n *
            (GrothendieckGroup.of b)⁻¹ ^ m) ∧
      MonoidAlgebra.mapDomainRingHom k
        (Algebra.faceLocalization P (Submonoid.powers a ⊔ Submonoid.powers b)).subtype
        (toricDoubleFractionMap k (Submonoid.powers a ⊔ Submonoid.powers b) b hb a ha
          (toricFraction
            (algebraMap _ (Localization.Away (MonoidAlgebra.of k P b))
              (MonoidAlgebra.of k P a))
            (toricFraction (MonoidAlgebra.of k P b) (MonoidAlgebra.of k P p) m) n)) =
        MonoidAlgebra.of k (GrothendieckGroup P)
          (GrothendieckGroup.of p * (GrothendieckGroup.of a)⁻¹ ^ n *
            (GrothendieckGroup.of b)⁻¹ ^ m)) ∧
    (∀ (a b : P) (I : SemigroupIdeal P),
      toricIdealExtension
        (toricLocalizationTransition (S := Submonoid.powers a)
          (T := Submonoid.powers a ⊔ Submonoid.powers b) le_sup_left)
        (toricIdealExtension (toricLocalizationInclusion (Submonoid.powers a)) I) =
      toricIdealExtension (toricLocalizationInclusion
        (Submonoid.powers a ⊔ Submonoid.powers b)) I ∧
      toricIdealExtension
        (toricLocalizationTransition (S := Submonoid.powers b)
          (T := Submonoid.powers a ⊔ Submonoid.powers b) le_sup_right)
        (toricIdealExtension (toricLocalizationInclusion (Submonoid.powers b)) I) =
      toricIdealExtension (toricLocalizationInclusion
        (Submonoid.powers a ⊔ Submonoid.powers b)) I) ∧
    (∀ (Q : Type w) [CommMonoid Q], FineFan.IsFine Q →
      ∀ (h : P →* Q) (a : P) (I : SemigroupIdeal P),
      toricIdealExtension (toricLocalizedHom h (Submonoid.powers a))
        (toricIdealExtension (toricLocalizationInclusion (Submonoid.powers a)) I) =
      toricIdealExtension (toricLocalizationInclusion ((Submonoid.powers a).map h))
        (toricIdealExtension h I) ∧
      (MonoidAlgebra.mapDomainRingHom k (toricLocalizedHom h (Submonoid.powers a))).comp
        (toricLocalizationRingMap k (Submonoid.powers a)) =
      (toricLocalizationRingMap k ((Submonoid.powers a).map h)).comp
        (MonoidAlgebra.mapDomainRingHom k h)) := by
  sorry

end MonoidAlgebra
