module

public import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
public import WeilConjectures.RingTheory.CohenRing
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Sheaf.RingTheory.CompletedMonoidSupportProjection
import WeilConjectures.RingTheory.PowerSeriesFieldCohenRegularComplete
import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs
import Sheaf.RingTheory.RegularLocalLocalization
import Sheaf.RingTheory.RegularRingNormal
import Sheaf.TraceFormula.SharpFsOrthantEmbedding

/-!
# Normality of saturated complete monoid local models

Source: ILO, Travaux de Gabber, Exposé VI 1.6(i)--(ii), printed p. 70
(blueprint: lem-trf-log-regular-saturation-normality).
The models are those in the source; the normality argument is the agent-origin
supported-series retraction proof recorded in the DAG, not an attribution to the
unavailable Kato (1994), Theorem 4.1.
-/

@[expose] public section

universe u v

namespace AddMonoidAlgebra

/-- The ideal `(z^q : q ≠ 0, t₁, …, tₙ)` in `L[P][t₁, …, tₙ]`.
Source: ILO VI 1.6(i)--(ii), p. 70
(blueprint: lem-trf-log-regular-saturation-normality). -/
noncomputable def localModelBoundaryIdeal (L : Type u) [CommRing L]
    (P : Type v) [AddCommMonoid P] (n : ℕ) :
    Ideal (MvPolynomial (Fin n) (AddMonoidAlgebra L P)) :=
  Ideal.span {f | ∃ q : P, q ≠ 0 ∧ f = MvPolynomial.C (single q (1 : L))} ⊔
    Ideal.span (Set.range (MvPolynomial.X :
      Fin n → MvPolynomial (Fin n) (AddMonoidAlgebra L P)))

/-- The completion ideal `(m_L, z^q : q ≠ 0, t₁, …, tₙ)`.
Source: ILO VI 1.6(i)--(ii), p. 70
(blueprint: lem-trf-log-regular-saturation-normality). -/
noncomputable def localModelCompletionIdeal (L : Type u) [CommRing L] [IsLocalRing L]
    (P : Type v) [AddCommMonoid P] (n : ℕ) :
    Ideal (MvPolynomial (Fin n) (AddMonoidAlgebra L P)) :=
  Ideal.map (algebraMap L (MvPolynomial (Fin n) (AddMonoidAlgebra L P)))
      (IsLocalRing.maximalIdeal L) ⊔ localModelBoundaryIdeal L P n

/-- The ring `B_L(P,n)`, the specified adic completion of the monoid polynomial ring.
Source: ILO VI 1.6(i)--(ii), p. 70
(blueprint: lem-trf-log-regular-saturation-normality). -/
abbrev CompletedLocalModel (L : Type u) [CommRing L] [IsLocalRing L]
    (P : Type v) [AddCommMonoid P] (n : ℕ) :=
  AdicCompletion (localModelCompletionIdeal L P n)
    (MvPolynomial (Fin n) (AddMonoidAlgebra L P))

/-- The extension of the monomial and variable ideal to `B_L(P,n)`.
Source: ILO VI 1.6(ii), p. 70
(blueprint: lem-trf-log-regular-saturation-normality). -/
noncomputable def completedLocalModelBoundaryIdeal (L : Type u) [CommRing L] [IsLocalRing L]
    (P : Type v) [AddCommMonoid P] (n : ℕ) : Ideal (CompletedLocalModel L P n) :=
  Ideal.map
    (algebraMap (MvPolynomial (Fin n) (AddMonoidAlgebra L P)) (CompletedLocalModel L P n))
    (localModelBoundaryIdeal L P n)

/-- Both saturated complete local models are nonzero integrally closed domains.
The multiplicative type tag lets the additive monoid use the recorded fs predicate.
Source: ILO VI 1.6(i)--(ii), p. 70, specifies the models
(blueprint: lem-trf-log-regular-saturation-normality).

Proof: (1) By `lem-trf-sharp-fs-orthant-embedding`, embed the group completion of
`P` into `ℤ^r`, with `P` the intersection with the positive orthant. Adjoin the `n`
variable coordinates. Relabeling basis monomials identifies the polynomial ring
with the algebra of `Q = (λ(G) × ℤ^n) ∩ ℕ^(r+n)` and identifies the completion ideals.
(2) The coefficient ring is complete local with finitely generated maximal ideal:
zero for a field, generated by `p` for a Cohen ring. Apply
`lem-trf-completed-monoid-support-projection` to identify the completion with the
supported subring of `A = L[[X₁, …, Xᵣ, t₁, …, tₙ]]`, with an `R`-linear retraction.
(3) `lem-weil-pbc-power-series-field-cohen-regular-complete` makes `A` regular local.
In the Cohen case the image `Θ` of `θ` has constant coefficient exactly `p`, hence
belongs to the maximal ideal but not its square: constant coefficients in its
square belong to `p²C`, whereas the nonunit uniformizer `p` does not. Apply
`lem-weil-pbc-regular-local-hypersurface-criterion` to `A/(Θ)`. This also covers
`r+n=0`, when the quotient is `C/pC`.
(4) The retraction satisfies `ρ(Θa)=θρ(a)`, so the intersection of `ΘA` with the
supported subring is `θR`. It descends to an injection and a linear retraction
of the quotients. In the field case keep the original injection and retraction.
(5) By `lem-weil-pbc-regular-local-localization` and
`lem-weil-pbc-regular-ring-normal`, the ambient regular local ring is a normal
domain: its localization at its maximal ideal is itself.
(6) The unital injection into that domain makes the model a nonzero domain.
For a fraction `a/b` integral over the model, the same monic equation makes it
integral over the ambient normal domain, so it lies there. Apply the linear
retraction to `b(a/b)=a`. It gives `bρ(a/b)=a`, proving that the fraction belongs
to the model. This descends integral closure in both cases. -/
theorem completedLocalModel_normal (P : Type v) [AddCommMonoid P]
    (hfs : AlgebraicGeometry.IsFineSaturatedMonoid (Multiplicative P))
    (hsharp : ∀ a b : P, a + b = 0 → a = 0 ∧ b = 0) (n : ℕ) :
    (∀ (k : Type u) [Field k],
      IsDomain (CompletedLocalModel k P n) ∧ IsIntegrallyClosed (CompletedLocalModel k P n)) ∧
    (∀ (C : Type u) [CommRing C] [IsLocalRing C] (p : ℕ), IsCohenRing p C →
      ∀ θ : CompletedLocalModel C P n,
        θ - (p : CompletedLocalModel C P n) ∈ completedLocalModelBoundaryIdeal C P n →
        IsDomain (CompletedLocalModel C P n ⧸ Ideal.span {θ}) ∧
          IsIntegrallyClosed (CompletedLocalModel C P n ⧸ Ideal.span {θ})) := by
  sorry

end AddMonoidAlgebra
