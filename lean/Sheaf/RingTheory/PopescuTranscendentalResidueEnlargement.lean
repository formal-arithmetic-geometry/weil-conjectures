module

public import Sheaf.RingTheory.PopescuAdmissibleSubalgebra
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.Algebraic.Defs


/-!
# Geometric residue-power capture in an Artinian local algebra

Source: Stacks Project, Tags 07FH and 07FI.
(blueprint: lem-weil-pbc-popescu-transcendental-residue-enlargement).
-/

@[expose] public section
set_option autoImplicit false
universe u v
namespace Algebra

/-- The transcendental branch of geometric enlargement, containing the unit itself.
Source: Stacks Project, Tag 07FI, transcendental case, and Tag 07FH.

Proof: Evaluate A₀[T] in B at x. Reduction modulo m_B is the injective map
F₀[T] → K sending T to the transcendental residue α of x. The inverse image
of m_B is therefore m₀[T]. Localize at this prime to obtain D with a local map
D → B, since all denominators map to units. D is Noetherian; its maximal ideal
is the extension of the nilpotent m₀, and its residue is F₀(T). Consequently D
is Artinian local. Apply the fibre flatness criterion to A₀ → D → B: B is flat
over A₀ and the closed fibre is a vector space over F₀(T). The local flat map
D → B is faithfully flat, hence injective. Its image A contains A₀ and x and
has m_A B = m_B. It is Artinian local. F₀ is essentially of finite type over k
by admissibility, as is the rational extension F₀(α). The Artinian local residue
criterion then makes A essentially of finite type over k, so A is admissible.
Take a mapping to x. The induced residue algebra of inclusion A₀ → A has
residue field F₀(α), generated by the transcendental residue of a, and its
k-scalar tower and compatibility follow by quotient functoriality.
(blueprint: lem-weil-pbc-popescu-transcendental-residue-enlargement). -/
theorem exists_popescu_transcendental_residue_enlargement
    (k : Type u) (B : Type v) [Field k] [CommRing B] [Algebra k B]
    [IsArtinianRing B] [IsLocalRing B]
    (p : ℕ) [CharP k p] (hp : 0 < p)
    (A₀ : Subalgebra k B) [IsLocalRing A₀]
    (hA₀ : A₀.IsPopescuAdmissible (IsLocalRing.maximalIdeal B))
    (x : B) (hx : IsUnit x)
    [IsLocalHom A₀.val]
    [Algebra (IsLocalRing.ResidueField A₀) (IsLocalRing.ResidueField B)]
    [IsScalarTower k (IsLocalRing.ResidueField A₀) (IsLocalRing.ResidueField B)]
    (hmap : ∀ a₀ : A₀, algebraMap (IsLocalRing.ResidueField A₀)
      (IsLocalRing.ResidueField B) (IsLocalRing.residue A₀ a₀) =
        IsLocalRing.residue B (a₀ : B))
    (hα : Transcendental (IsLocalRing.ResidueField A₀) (IsLocalRing.residue B x)) :
    ∃ (A : Subalgebra k B) (_ : IsLocalRing A), ∃ hle : A₀ ≤ A,
      A.IsPopescuAdmissible (IsLocalRing.maximalIdeal B) ∧
      ∃ a : A, (a : B) = x ∧
        ∃ (alg : Algebra (IsLocalRing.ResidueField A₀) (IsLocalRing.ResidueField A)),
          letI := alg
          IsScalarTower k (IsLocalRing.ResidueField A₀) (IsLocalRing.ResidueField A) ∧
          (∀ a₀ : A₀, algebraMap (IsLocalRing.ResidueField A₀)
            (IsLocalRing.ResidueField A) (IsLocalRing.residue A₀ a₀) =
              IsLocalRing.residue A (Subalgebra.inclusion hle a₀)) ∧
          Transcendental (IsLocalRing.ResidueField A₀) (IsLocalRing.residue A a) ∧
          IntermediateField.adjoin (IsLocalRing.ResidueField A₀)
            {IsLocalRing.residue A a} = ⊤ := by sorry

end Algebra
