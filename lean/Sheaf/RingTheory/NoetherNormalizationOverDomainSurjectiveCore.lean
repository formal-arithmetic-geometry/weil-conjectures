module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Finiteness.Defs

@[expose] public section
set_option autoImplicit false
universe u v
namespace Algebra.FiniteType

/-- Finite subalgebra construction containing scaled algebra generators.
Source: Stacks Project, Algebra, Lemma 07NA, proof through the construction of `S'`.
(blueprint: new-noether-normalization-over-domain-surjective-core)
Proof: Let K be the fraction field of R. Apply field Noether normalization to S tensor K,
using triangular polynomial changes of the given generators to choose coordinates y in S.
Evaluation over K is injective; localization of the domain R is injective, so evaluation
on R-polynomials is injective too. Each generator x is integral over K[y]. Choose monic
integral equations and a common nonzero denominator f for their coefficients. The cleared
equations vanish in the generic fibre; multiply f by the finitely many nonzero factors
needed to make them vanish already in S. If P has degree m, the rescaled equation
f^m P(T/f) is monic with coefficients in R[y] and annihilates f*x. Thus each f*x is integral
over R[y]. Construct S' as the R-subalgebra generated by the coordinates y and these f*x.
It contains R[y], and adjoining finitely many integral elements gives a finite module over
R[y]. By construction every scaled generator lies in S'. This proves precisely the data
below, before the separate argument extending clearing to all of S and to localizations. -/
theorem exists_finite_subalgebra_away_core
    (R : Type u) (S : Type v) [CommRing R] [IsDomain R] [CommRing S]
    [Algebra R S]
    (hinj : Function.Injective (algebraMap R S))
    (g : Finset S) (hgen : Algebra.adjoin R (g : Set S) = ⊤) :
    ∃ (d : ℕ) (y : Fin d → S) (S' : Subalgebra R S),
      Function.Injective (MvPolynomial.aeval (R := R) y) ∧
      ∃ h : (MvPolynomial.aeval (R := R) y).range ≤ S',
        (letI := (Subalgebra.inclusion h).toRingHom.toAlgebra
         Module.Finite (MvPolynomial.aeval (R := R) y).range S') ∧
        ∃ f : R, f ≠ 0 ∧ ∀ x ∈ g, algebraMap R S f * x ∈ S' := by
  sorry

end Algebra.FiniteType
