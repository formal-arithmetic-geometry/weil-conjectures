import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.RingHom.Flat

/-!
# Regularity along a flat local map with regular closed fibre

Source: Stacks Project, Algebra, Lemma 031E
(blueprint: lem-weil-pbc-flat-over-regular-with-regular-fibre).
-/

universe u v

namespace IsRegularLocalRing

/-- A flat local map of Noetherian local rings with regular source and regular closed fibre
has regular target. Source: Stacks Project, Algebra, Lemma 031E
(blueprint: lem-weil-pbc-flat-over-regular-with-regular-fibre).

Proof:
1. Locality gives f⁻¹(m_S) = m_R and m_R S ⊆ m_S. Hence the closed fibre S/m_R S is
   nonzero and local with maximal ideal m_S/m_R S, and is Noetherian by
   lem-weil-pbc-surjective-image-noetherian. Use def-weil-pbc-noetherian-ring and
   def-weil-regular-scheme for these notions.
2. Apply lem-weil-pbc-flat-height-formula (Stacks 00ON) at m_S and m_R. Localization
   at the maximal ideal of a local ring is an isomorphism, by
   def-weil-pbc-localization-at-prime, so dim S = dim R + dim(S/m_R S).
   The flatness hypothesis is def-weil-pbc-flat-ring-map.
3. Choose dim R generators x_i of m_R, and lift dim(S/m_R S) generators of the
   fibre's maximal ideal to elements y_j of m_S, by def-weil-regular-scheme.
   For s ∈ m_S, subtract a linear combination of the y_j lifting its image in the
   fibre. The remainder lies in m_R S, generated by the f(x_i). Thus these two
   families together generate m_S.
4. Their total length is dim S by step 2, so S is regular local by
   def-weil-regular-scheme. This also covers either family having length zero. -/
theorem of_flat_of_regular_closedFiber
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [IsRegularLocalRing R] [IsLocalRing S] [IsNoetherianRing S]
    (f : R →+* S) [IsLocalHom f]
    (hflat : f.Flat)
    (hfibre : IsRegularLocalRing (S ⧸ (IsLocalRing.maximalIdeal R).map f)) :
    IsRegularLocalRing S := by
  sorry

end IsRegularLocalRing
