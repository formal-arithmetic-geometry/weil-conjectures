module

public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra

/-!
# A localized coefficient relation with controlled residues

Source: Stacks Project, Smoothing Ring Maps, Tag 07FJ, ad (13), first paragraph.
-/

@[expose] public section

set_option autoImplicit false

universe v w
namespace Algebra

/-- Lift a power relation while keeping the residues of its coefficients in the given ring.
Source: Stacks Project, Smoothing Ring Maps, Tag 07FJ, ad (13), first paragraph.
(blueprint: lem-weil-pbc-popescu-localized-coefficient-relation).

Proof: Write L = Lambda_q, m = maximalIdeal L, S = L/m^n, and U for the image of u.
The flat local map g is faithfully flat and injective. Choose a in D with g(a) equal
to the residue of U. Since U is in m and m^N is in the extended ideal of the z_j,
the residue of U^N is in the ideal generated by g(b_j). Faithful flat ideal
contraction gives a^N = sum b_j*d_j in D. Lift each g(d_j) to c_j in L. Then the
error U^N - sum z_j*c_j belongs to m^n. As N <= n, m^n = m^(n-N)*m^N is contained
in m^(n-N) times the ideal generated by the z_j. Expand an element of this product
as a finite sum and collect the coefficients of each z_j, obtaining cprime_j in
m^(n-N) with error = sum z_j*cprime_j. Put w_j = U^N*(c_j+cprime_j). Multiplying
the corrected equation by U^N gives U^(2N) = sum w_j*z_j. The correction U^N*cprime_j
belongs to m^n and hence vanishes in S. Thus the residue of w_j equals g(a^N*d_j).
The argument includes n=N, where m^(n-N) is the unit ideal, and an empty family z,
where the coefficient sums are zero. No regular-sequence hypothesis is needed. -/
theorem exists_popescu_localized_coefficient_relation
    {Λ : Type v} [CommRing Λ] (q : PrimeSpectrum Λ)
    (N n : ℕ) (hN : 0 < N) (hn : N ≤ n)
    (u : Λ) (hu : u ∈ q.asIdeal) (s : ℕ) (z : Fin s → Λ)
    (hpower : IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) ^ N ≤
      (Ideal.span (Set.range z)).map (algebraMap Λ (Localization.AtPrime q.asIdeal)))
    (D : Type w) [CommRing D] [IsLocalRing D]
    (g : D →+* Localization.AtPrime q.asIdeal ⧸
      IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) ^ n)
    [IsLocalRing (Localization.AtPrime q.asIdeal ⧸
      IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) ^ n)]
    [IsLocalHom g] (hgflat : g.Flat) (b : Fin s → D)
    (hb : ∀ j, g (b j) = Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) ^ n)
      (algebraMap Λ (Localization.AtPrime q.asIdeal) (z j)))
    (hinc : Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) ^ n)
      (algebraMap Λ (Localization.AtPrime q.asIdeal) u) ∈ Set.range g) :
    ∃ w : Fin s → Localization.AtPrime q.asIdeal,
      (algebraMap Λ (Localization.AtPrime q.asIdeal) u) ^ (2 * N) =
        ∑ j : Fin s, w j * algebraMap Λ (Localization.AtPrime q.asIdeal) (z j) ∧
      ∀ j, Ideal.Quotient.mk
        (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) ^ n) (w j) ∈
        Set.range g := by
  classical
  have _ := hN
  let L := Localization.AtPrime q.asIdeal
  let m := IsLocalRing.maximalIdeal L
  let S := L ⧸ m ^ n
  let f := algebraMap Λ L
  let res := Ideal.Quotient.mk (m ^ n)
  let U := f u
  let Z : Fin s → L := fun j ↦ f (z j)
  let J : Ideal L := Ideal.span (Set.range Z)
  have hJ : (Ideal.span (Set.range z)).map f = J := by
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have huL : U ∈ m := by
    change f u ∈ IsLocalRing.maximalIdeal L
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (p := q.asIdeal)]
    exact Ideal.mem_map_of_mem f hu
  have hUN : U ^ N ∈ m ^ N := Ideal.pow_mem_pow huL N
  have hUNJ : U ^ N ∈ J := by
    rw [← hJ]
    exact hpower hUN
  let : Algebra D S := g.toAlgebra
  have : Module.Flat D S := hgflat
  have : IsLocalHom (algebraMap D S) := ‹IsLocalHom g›
  have : Module.FaithfullyFlat D S := Module.FaithfullyFlat.of_flat_of_isLocalHom
  obtain ⟨a, ha⟩ := hinc
  have hspan : (Ideal.span (Set.range b)).map g = J.map res := by
    rw [Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
    apply congrArg Ideal.span
    apply congrArg Set.range
    funext j
    exact hb j
  have haN : a ^ N ∈ Ideal.span (Set.range b) := by
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := S) (Ideal.span (Set.range b))]
    change g (a ^ N) ∈ (Ideal.span (Set.range b)).map g
    rw [hspan, map_pow, ha]
    exact Ideal.mem_map_of_mem res hUNJ
  obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.mp haN
  choose c hc using fun j ↦ Ideal.Quotient.mk_surjective (g (d j))
  let err := U ^ N - ∑ j, c j * Z j
  have herr : err ∈ m ^ n := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change res err = 0
    dsimp only [err]
    rw [map_sub, map_pow, map_sum]
    have hsum : ∑ j, res (c j * Z j) = res U ^ N := by
      calc
        _ = g (∑ j, d j * b j) := by
          rw [map_sum]
          apply Finset.sum_congr rfl
          intro j _
          change res (c j * f (z j)) = g (d j * b j)
          rw [map_mul, map_mul]
          rw [show res (c j) = g (d j) from hc j,
            show res (f (z j)) = g (b j) from (hb j).symm]
        _ = res U ^ N := by rw [hd, map_pow, ha]
    rw [hsum, sub_self]
  have herr' : err ∈ m ^ (n - N) * J := by
    have hm : m ^ n ≤ m ^ (n - N) * J := by
      calc
        m ^ n = m ^ (n - N) * m ^ N := by rw [← pow_add, Nat.sub_add_cancel hn]
        _ ≤ m ^ (n - N) * J :=
          Ideal.mul_mono (le_refl _) (by rwa [hJ] at hpower)
    exact hm herr
  obtain ⟨cp, hcp, hcpEq⟩ :=
    (Submodule.mem_ideal_smul_span_iff_exists_sum (m ^ (n - N)) Z err).mp
      (by simpa only [Ideal.smul_eq_mul] using herr')
  have hcpSum : ∑ j, cp j * Z j = err := by
    rw [Finsupp.sum_fintype] at hcpEq
    · simpa only [smul_eq_mul] using hcpEq
    · intro j
      exact zero_smul _ _
  have hcorrect : ∑ j, (c j + cp j) * Z j = U ^ N := by
    simp only [add_mul, Finset.sum_add_distrib, hcpSum, err]
    ring
  refine ⟨fun j ↦ U ^ N * (c j + cp j), ?_, ?_⟩
  · change U ^ (2 * N) = ∑ j, U ^ N * (c j + cp j) * Z j
    rw [show 2 * N = N + N by omega, pow_add, ← hcorrect, Finset.mul_sum]
    simp only [mul_assoc]
  · intro j
    have hzero : res (U ^ N * cp j) = 0 := by
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      have hmem := Ideal.mul_mem_mul hUN (hcp j)
      rwa [← pow_add, Nat.add_sub_of_le hn] at hmem
    refine ⟨a ^ N * d j, ?_⟩
    change g (a ^ N * d j) = res (U ^ N * (c j + cp j))
    rw [mul_add, map_add, hzero, add_zero, map_mul, map_mul, map_pow, map_pow,
      ha, hc j]

end Algebra
