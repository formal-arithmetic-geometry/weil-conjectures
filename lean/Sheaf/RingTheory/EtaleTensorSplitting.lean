/-!
# Tensor decomposition over an étale localization

Source: Stacks Project, Tag 0812, proof of `lemma-trick-fitting-ideal`, using
Tags 00U7, 00U8 and 00EH (blueprint: lem-trf-etale-tensor-splitting).
-/

@[expose] public section

universe u

open scoped TensorProduct

namespace Algebra

/-- The tensor algebra over an étale localization splits with multiplication as its
first projection. The algebra structure on the tensor product is through the second factor.

Source: Stacks Project, Tag 0812, proof of `lemma-trick-fitting-ideal`
(blueprint: lem-trf-etale-tensor-splitting).

Proof:
1. The tensor pushout gives multiplication `mu : C tensor_A B → B`. Viewed as a
   `B`-algebra map through the second factor, it is surjective since it fixes `B`.
2. Translate spectrum-etaleness into algebra-etaleness. Base change makes
   `C → C tensor_A B` etale, and localization makes `C → B` etale. The tensor
   multiplication is compatible with these maps, so etale cancellation makes it etale.
3. The kernel of this surjection is finitely generated and idempotent. Hence it is
   generated by an idempotent `e`.
4. Complementary idempotents give `T ≃ T/(e) × T/(1-e)`. The first isomorphism
   theorem identifies `T/(e)` with `B`, and its quotient formula identifies the first
   projection with the original multiplication. Take `D = T/(1-e)`.

All ingredients are Mathlib lemmas; no freeness or finiteness hypothesis is needed
for this argument. -/
theorem exists_etaleLocalization_tensor_splitting
    (A C : Type u) [CommRing A] [CommRing C] [Algebra A C]
    [Module.Free A C] [Module.Finite A C] (h : C)
    [AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away h))))] :
    ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (Localization.Away h) D)
      (θ : @AlgEquiv (Localization.Away h) (C ⊗[A] Localization.Away h)
        (Localization.Away h × D) _ _ _
        (Algebra.TensorProduct.rightAlgebra (R := A) (A := C) (B := Localization.Away h)) _),
      ∀ t : C ⊗[A] Localization.Away h,
        (θ t).1 = Algebra.TensorProduct.productMap
          (IsScalarTower.toAlgHom A C (Localization.Away h))
          (AlgHom.id A (Localization.Away h)) t := by
  let B := Localization.Away h
  let T := C ⊗[A] B
  let : Algebra B T := Algebra.TensorProduct.rightAlgebra
  let μ₀ : T →ₐ[A] B := Algebra.TensorProduct.productMap
    (IsScalarTower.toAlgHom A C B) (AlgHom.id A B)
  let μ : T →ₐ[B] B :=
    { μ₀.toRingHom with
      commutes' := fun b ↦ by
        change μ₀ (1 ⊗ₜ[A] b) = b
        exact Algebra.TensorProduct.productMap_right_apply
          (IsScalarTower.toAlgHom A C B) (AlgHom.id A B) b }
  have hμ : Function.Surjective μ := fun b ↦
    ⟨algebraMap B T b, μ.commutes b⟩
  have hAB : Algebra.Etale A B := by
    apply (RingHom.etale_algebraMap).mp
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)
      (φ := CommRingCat.ofHom (algebraMap A B))).mp inferInstance
  have : Algebra.Etale C T := inferInstance
  have : Algebra.Etale C B := Algebra.Etale.of_isLocalizationAway h
  let : Algebra T B := μ.toRingHom.toAlgebra
  have : IsScalarTower C T B := IsScalarTower.of_algebraMap_eq fun c ↦ by
    change algebraMap C B c = μ₀ (c ⊗ₜ[A] 1)
    exact (Algebra.TensorProduct.productMap_left_apply
      (IsScalarTower.toAlgHom A C B) (AlgHom.id A B) c).symm
  have : Algebra.Etale T B := Algebra.Etale.of_restrictScalars C T B
  have hidem : IsIdempotentElem (RingHom.ker μ) :=
    (Algebra.FormallyEtale.iff_of_surjective hμ).mp inferInstance
  have hfg : (RingHom.ker μ).FG :=
    Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId T B) hμ
  obtain ⟨e, he, hker⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hidem
  have hker' : RingHom.ker μ = Ideal.span {e} := hker
  let θ₁ : T ≃ₐ[B] (T ⧸ Ideal.span {e}) × (T ⧸ Ideal.span {1 - e}) :=
    AlgEquiv.prodQuotientOfIsIdempotentElem (R := B) he he.one_sub (by ring)
      (by rw [mul_sub, mul_one, he.eq, sub_self])
  let θ₂ : (T ⧸ Ideal.span {e}) ≃ₐ[B] B :=
    ((Ideal.span {e}).quotientEquivAlgOfEq B hker'.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hμ)
  refine ⟨T ⧸ Ideal.span {1 - e}, inferInstance, inferInstance,
    θ₁.trans (AlgEquiv.prodCongr θ₂ AlgEquiv.refl), fun t ↦ ?_⟩
  simp only [θ₁, θ₂, Ideal.quotientKerAlgEquivOfSurjective]
  exact RingHom.kerLift_mk (μ : T →+* B) t

end Algebra
