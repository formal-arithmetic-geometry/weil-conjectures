import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# The singular ideal of a ring map

Source: Stacks Project, Smoothing Ring Maps, Definition 07C5 and Algebra, Definition 00TB
(blueprint: def-weil-pbc-singular-ideal).
-/

universe u v

namespace Algebra

/-- Smoothness of `R → A` at a prime: some principal localization outside the prime is a
smooth `R`-algebra. Source: Stacks Project, Algebra, Definition 00TB
(blueprint: def-weil-pbc-singular-ideal). -/
def IsSmoothAtPrime (R : Type u) {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
    (q : PrimeSpectrum A) : Prop :=
  ∃ g : A, g ∉ q.asIdeal ∧ Smooth R (Localization.Away g)

/-- The elements whose principal localizations are smooth over `R`. Source: Stacks Project,
Smoothing Ring Maps, Definition 07C5 (blueprint: def-weil-pbc-singular-ideal). -/
def smoothElements (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A] :
    Set A :=
  {g | Smooth R (Localization.Away g)}

/-- The singular ideal `H_{A/R}` is the radical of the ideal generated by elements `g`
for which `A_g` is smooth over `R`. Source: Stacks Project, Smoothing Ring Maps,
Definition 07C5 (blueprint: def-weil-pbc-singular-ideal). -/
def singularIdeal (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A] :
    Ideal A :=
  (Ideal.span (smoothElements R A)).radical

/-- The singular ideal is radical by construction: the radical of any ideal is radical.
Source: Stacks Project, Smoothing Ring Maps, Definition 07C5
(blueprint: def-weil-pbc-singular-ideal). -/
theorem singularIdeal_isRadical (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] : (singularIdeal R A).IsRadical := by
  sorry

/-- The smooth locus is the union of the basic opens of smooth principal localizations.
For a prime `q`, membership on either side means there is a `g` outside `q` whose
localization is smooth. This is the definition of smoothness at a prime.
Source: Stacks Project, Smoothing Ring Maps, after Definition 07C5
(blueprint: def-weil-pbc-singular-ideal). -/
theorem smoothAtPrime_locus_eq (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] :
    {q : PrimeSpectrum A | IsSmoothAtPrime R q} =
      ⋃ g ∈ smoothElements R A, (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum A)) := by
  sorry

/-- The smooth locus is open: by `smoothAtPrime_locus_eq` it is a union of basic
opens, each of which is open. Source: Stacks Project,
Smoothing Ring Maps, after Definition 07C5 (blueprint: def-weil-pbc-singular-ideal). -/
theorem isOpen_smoothAtPrime_locus (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] :
    IsOpen {q : PrimeSpectrum A | IsSmoothAtPrime R q} := by
  sorry

/-- The zero locus of `H_{A/R}` is precisely the nonsmooth locus, or equivalently the
intersection of the zero loci of all smooth localization elements. A prime contains
the radical of a generated ideal exactly when it contains every generator: containment
of the generators is equivalent to containment of their span, and a prime contains an
ideal if and only if it contains its radical. Negating the existential definition of
`IsSmoothAtPrime` then identifies this with the nonsmooth locus.
Source: Stacks Project, Smoothing Ring Maps, Definition 07C5
(blueprint: def-weil-pbc-singular-ideal). -/
theorem singularIdeal_zeroLocus (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] :
    PrimeSpectrum.zeroLocus (singularIdeal R A : Set A) =
      {q : PrimeSpectrum A | ¬ IsSmoothAtPrime R q} ∧
    PrimeSpectrum.zeroLocus (singularIdeal R A : Set A) =
      ⋂ g ∈ smoothElements R A, PrimeSpectrum.zeroLocus ({g} : Set A) := by
  sorry

/-- `H_{A/R}` is the unique radical ideal with the nonsmooth locus as its zero locus.
By `singularIdeal_zeroLocus`, `J` and `H_{A/R}` have the same zero locus. The
zero-locus equality criterion gives equality of their radicals. Since `J` is radical
by hypothesis and `H_{A/R}` is radical by `singularIdeal_isRadical`, they are equal.
Source: Stacks Project, Smoothing Ring Maps, Definition 07C5; Algebra, Lemma 00E0
(blueprint: def-weil-pbc-singular-ideal). -/
theorem singularIdeal_unique (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] (J : Ideal A) (hJ : J.IsRadical)
    (hV : PrimeSpectrum.zeroLocus (J : Set A) =
      {q : PrimeSpectrum A | ¬ IsSmoothAtPrime R q}) :
    J = singularIdeal R A := by
  sorry

end Algebra
