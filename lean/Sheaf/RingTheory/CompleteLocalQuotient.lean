module

public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.Noetherian.Basic
import Sheaf.RingTheory.FiniteModuleComplete
import Mathlib.RingTheory.LocalRing.RingHom.Basic

/-!
# Quotients of complete Noetherian local rings

Source: Stacks Project, Algebra, Lemma Tag 0325 (lemma-quotient-complete-local),
first sentence and proof (blueprint: lem-weil-pbc-complete-local-quotient).
-/

@[expose] public section


universe u

/-- Any proper quotient of a Noetherian adically complete local ring is Noetherian,
local, and complete for the quotient of its maximal ideal.
Source: Stacks Project, Algebra, Lemma Tag 0325 (lemma-quotient-complete-local),
first sentence and proof (blueprint: lem-weil-pbc-complete-local-quotient).

The proof follows the four steps of the node:
1. The quotient map pi : R -> R/I is surjective, so Noetherianity descends
   by lem-weil-pbc-surjective-image-noetherian (Stacks Tag 00FN).
2. Since I is proper, it lies in the unique maximal ideal m. Thus R/I is
   nonzero and local, with maximal ideal pi(m) = m/I, by
   lem-weil-pbc-quotient-local-structure.
3. N = R/I is a finite R-module, generated by the class of 1
   (def-weil-finitely-generated-module). By
   lem-weil-pbc-finite-module-complete-over-complete-noetherian (Stacks Tag 00MA(3)),
   N is m-adically complete: its canonical map to the inverse limit of N/m^n N
   is bijective.
4. For every n, m^n N = pi(m^n) = pi(m)^n = (m/I)^n: the equality follows by
   mapping the generating products through pi. The module and ring quotient
   systems have the same reduction maps, hence the same canonical completion map
   (def-weil-pbc-adic-completion). Its bijectivity gives (m/I)-adic completeness
   (def-weil-pbc-adically-complete-ring), completing the assertion. -/
theorem quotient_complete_local
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    (I : Ideal R) (hI : I ≠ ⊤) :
    letI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    letI : IsLocalRing (R ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    IsNoetherianRing (R ⧸ I) ∧
      IsLocalRing (R ⧸ I) ∧
      IsLocalRing.maximalIdeal (R ⧸ I) =
        (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I) ∧
      IsAdicComplete (IsLocalRing.maximalIdeal (R ⧸ I)) (R ⧸ I) := by
  set_option linter.style.haveILetI false in
    letI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  set_option linter.style.haveILetI false in
    letI : IsLocalRing (R ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hnoeth : IsNoetherianRing (R ⧸ I) :=
    isNoetherianRing_of_surjective R (R ⧸ I) (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  have hmax : IsLocalRing.maximalIdeal (R ⧸ I) =
      (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I) := by
    symm
    exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  have hcomp : IsAdicComplete
      ((IsLocalRing.maximalIdeal R).map (algebraMap R (R ⧸ I))) (R ⧸ I) := by
    rw [IsAdicComplete.map_algebraMap_iff]
    exact finite_module_complete_over_complete_noetherian R
      (IsLocalRing.maximalIdeal R) (R ⧸ I)
  refine ⟨hnoeth, inferInstance, hmax, ?_⟩
  rw [hmax]
  convert hcomp using 1
  all_goals rfl
