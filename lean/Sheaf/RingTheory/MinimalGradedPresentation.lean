module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.DirectSum.Decomposition
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Submodule
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Minimal finite graded free presentations over a two-variable polynomial ring

Source: the blueprint, `lem-sc-p1-graded-resolution`, graded free resolutions;
Stacks Project, Algebra, Section 00JL (blueprint: def-sc-p1-minimal-graded-presentation).
-/

@[expose] public section

universe u

namespace MvPolynomial

/-- A minimal finite graded free presentation over `k[x₀,x₁]`, with its total-degree grading.
The modules are internally Z-graded, scalar multiplication adds degrees, the target is
generated by finitely many homogeneous elements (the form of
`MvPolynomial.graded_submodule_finite`), the free module has a finite homogeneous basis,
and the surjection preserves degrees. Minimality is stated as `q⁻¹(S₊N) ⊆ S₊F`: together with
surjectivity this says precisely that the induced map `F/S₊F → N/S₊N` is an isomorphism.
The opposite containment follows from linearity.
Source: blueprint `lem-sc-p1-graded-resolution`, graded free resolutions; Stacks, Section 00JL.
(blueprint: def-sc-p1-minimal-graded-presentation) -/
structure MinimalGradedPresentation (k : Type u) [Field k] where
  /-- The finitely generated target. -/
  N : ModuleCat.{u} (MvPolynomial (Fin 2) k)
  /-- The source of the presentation. -/
  F : ModuleCat.{u} (MvPolynomial (Fin 2) k)
  /-- The homogeneous components of the target. -/
  nGrading : ℤ → AddSubgroup N
  /-- The homogeneous components of the source. -/
  fGrading : ℤ → AddSubgroup F
  /-- Every target element is a unique finite sum of homogeneous elements. -/
  nDecomposition : DirectSum.IsInternal nGrading
  /-- Finite graded generation of the target: finitely many homogeneous generators. -/
  finite : ∃ s : Set N, s.Finite ∧ (∀ x ∈ s, SetLike.IsHomogeneousElem nGrading x) ∧
    Submodule.span (MvPolynomial (Fin 2) k) s = ⊤
  /-- Every source element is a unique finite sum of homogeneous elements. -/
  fDecomposition : DirectSum.IsInternal fGrading
  /-- Compatibility of the target grading with the standard grading of the ring. -/
  n_smul : ∀ (i : ℕ) (j : ℤ) (s : MvPolynomial (Fin 2) k) (x : N),
    s ∈ homogeneousSubmodule (Fin 2) k i → x ∈ nGrading j → s • x ∈ nGrading ((i : ℤ) + j)
  /-- Compatibility of the source grading with the standard grading of the ring. -/
  f_smul : ∀ (i : ℕ) (j : ℤ) (s : MvPolynomial (Fin 2) k) (x : F),
    s ∈ homogeneousSubmodule (Fin 2) k i → x ∈ fGrading j → s • x ∈ fGrading ((i : ℤ) + j)
  /-- The rank of the finite graded free source. -/
  rank : ℕ
  /-- A homogeneous basis, allowing arbitrary integer shifts. -/
  basis : Module.Basis (Fin rank) (MvPolynomial (Fin 2) k) F
  /-- The degrees of the basis elements. -/
  degree : Fin rank → ℤ
  /-- Homogeneity of the basis. -/
  basis_mem : ∀ i : Fin rank, basis i ∈ fGrading (degree i)
  /-- The presentation map. -/
  q : F →ₗ[MvPolynomial (Fin 2) k] N
  /-- A presentation is surjective. -/
  surjective : Function.Surjective q
  /-- The presentation map has degree zero. -/
  graded : ∀ (j : ℤ) (x : F), x ∈ fGrading j → q x ∈ nGrading j
  /-- Injectivity of the induced map modulo the irrelevant ideal. -/
  minimal : ∀ x : F,
    q x ∈ Ideal.span (Set.range (X : Fin 2 → MvPolynomial (Fin 2) k)) •
      (⊤ : Submodule (MvPolynomial (Fin 2) k) N) →
    x ∈ Ideal.span (Set.range (X : Fin 2 → MvPolynomial (Fin 2) k)) •
      (⊤ : Submodule (MvPolynomial (Fin 2) k) F)

end MvPolynomial
