/-! # Binomial normal forms and Laurent intersections

Source: the coefficient-reduction argument in the DAG node, steps 1--9;
Stacks Project, Algebra, Tags 030A and 00GY for the normality inputs
(blueprint: lem-sfb-binomial-laurent-normal-form).

The quotient is the existing `AlgebraicGeometry.strictNodalRing`. A basis indexed by
integers records its unique finite normal forms. The two generated subalgebras of
`RatFunc (FractionRing R)` describe the actual Laurent rings inside the common field.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

namespace AlgebraicGeometry

/-- The canonical coefficient algebra on the existing nodal quotient.
Source: the quotient construction in steps 1--2 of the DAG node
(blueprint: lem-sfb-binomial-laurent-normal-form). -/
instance strictNodalRingAlgebra (R : CommRingCat.{u}) (a : R) :
    Algebra R (strictNodalRing R a) :=
  inferInstanceAs (Algebra R ((MvPolynomial (Fin 2) R) ⧸
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} :
      Set (MvPolynomial (Fin 2) R))))

/-- The normal-form basis over every commutative ring, including `a = 0`.
Source: the agent monomial-reduction argument, steps 1--2 of the DAG node
(blueprint: lem-sfb-binomial-laurent-normal-form).

Proof: On `R[x,y]` send `x^i*y^j` to `a^m*x^(i-m)*y^(j-m)` for `m = min i j`.
Extend this map R-linearly. Its image is the span of `1,x^i,y^j` with positive
exponents, and it fixes that span. The identity
`(xy)^m-a^m = (xy-a)*sum_{r<m} (xy)^(m-1-r)*a^r` shows that every polynomial
and its reduction have the same quotient class. Moreover
`N(x^(i+1)*y^(j+1)) = a*N(x^i*y^j)`, so the reduction kills the defining ideal.
It therefore identifies the quotient with the free coefficient module on these
monomials, proving both existence and uniqueness of finite normal forms. This uses
only the polynomial, quotient and free-module definitions in the dependency nodes;
there is no cancellation by `a` and no domain or nontriviality assumption. -/
theorem strictNodalRing_basis_exists (R : CommRingCat.{u}) (a : R) :
    ∃ b : Module.Basis ℤ R (strictNodalRing R a),
      (∀ n : ℕ, b (Int.ofNat n) =
        (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ^ n) ∧
      (∀ n : ℕ, b (Int.negSucc n) =
        (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ^ (n + 1)) := by
  sorry

/-- The canonical rational-function embedding, its two Laurent localization images,
their intersection, and normality, without a Noetherian hypothesis.
Source: the agent coefficient and intersection argument, steps 3--9 of the DAG node;
Stacks Project, Algebra, Tags 030A and 00GY
(blueprint: lem-sfb-binomial-laurent-normal-form).

Proof:
3. Evaluate `x` at `T` and `y` at `U = a*T⁻¹`; the defining relation vanishes.
The normal form from steps 1--2 maps to a finite Laurent sum with coefficients
`c_i` in positive degrees and `d_j*a^j` in negative degrees. Uniqueness of
Laurent coefficients, injectivity of `R -> FractionRing R`, and `a ≠ 0` prove
injectivity. The image is precisely the R-subalgebra generated by `T,U`.
4. Clear the finitely many R-denominators in a numerator and denominator over
`FractionRing R` simultaneously. Thus every element of the rational function field
is a quotient of elements of `R[T]`, hence of the image of the nodal ring.
5. The localization maps send `h/x^m` to `f(h)/T^m` and `h/y^m` to `f(h)/U^m`.
Their denominators are nonzero, proving injectivity; their images are generated by
`T,T⁻¹` and `U,U⁻¹`, respectively, since `U=a*T⁻¹` and `T=a*U⁻¹`.
6. In a finite Laurent sum, membership in both rings means that the coefficient
of `T^n` lies in R for `n ≥ 0` and in `a^j*R` for `n=-j<0`. These are exactly
the images of the normal forms, proving the displayed intersection equality.
7. If R is integrally closed, Tag 030A (lem-weil-pbc-polynomial-ring-normal-domain)
and Tag 00GY (lem-weil-pbc-localization-normal-domain) make both Laurent rings
normal domains: `T -> a*T⁻¹` is an involution of the common rational function field.
8. An element integral over their intersection is integral over each Laurent ring,
hence lies in both and therefore in the intersection. Transport along the injection
gives normality of the nodal ring (def-weil-pbc-normal-ring).
9. Tag 00GY applied to each prime complement gives normal domains at every prime
(def-weil-pbc-localization-at-prime). All these arguments allow nonunits `a` and
arbitrary characteristic, and neither normality input assumes Noetherianity. -/
theorem strictNodalRing_laurent_normal_form (R : CommRingCat.{u}) [IsDomain R]
    (a : R) (ha : a ≠ 0) :
    ∃ f : strictNodalRing R a →ₐ[R] RatFunc (FractionRing R),
      f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = RatFunc.X ∧
      f (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
        algebraMap R (RatFunc (FractionRing R)) a * RatFunc.X⁻¹ ∧
      Function.Injective f ∧
      f.range = Algebra.adjoin R
        {RatFunc.X, algebraMap R (RatFunc (FractionRing R)) a * RatFunc.X⁻¹} ∧
      IsFractionRing f.range (RatFunc (FractionRing R)) ∧
      (∃ fx : Localization.Away
          (@id (strictNodalRing R a) (Ideal.Quotient.mk _ (MvPolynomial.X 0))) →+*
            RatFunc (FractionRing R),
        (∀ h : strictNodalRing R a,
          fx (algebraMap (strictNodalRing R a)
            (Localization.Away
              (@id (strictNodalRing R a) (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) h) = f h) ∧
        Function.Injective fx ∧
        fx.range = (Algebra.adjoin R
          ({RatFunc.X, RatFunc.X⁻¹} : Set (RatFunc (FractionRing R)))).toSubring) ∧
      (∃ fy : Localization.Away
          (@id (strictNodalRing R a) (Ideal.Quotient.mk _ (MvPolynomial.X 1))) →+*
            RatFunc (FractionRing R),
        (∀ h : strictNodalRing R a,
          fy (algebraMap (strictNodalRing R a)
            (Localization.Away
              (@id (strictNodalRing R a) (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) h) = f h) ∧
        Function.Injective fy ∧
        fy.range = (Algebra.adjoin R
          {algebraMap R (RatFunc (FractionRing R)) a * RatFunc.X⁻¹,
            (algebraMap R (RatFunc (FractionRing R)) a * RatFunc.X⁻¹)⁻¹}).toSubring) ∧
      Algebra.adjoin R ({RatFunc.X, RatFunc.X⁻¹} : Set (RatFunc (FractionRing R))) ⊓
        Algebra.adjoin R
          {algebraMap R (RatFunc (FractionRing R)) a * RatFunc.X⁻¹,
            (algebraMap R (RatFunc (FractionRing R)) a * RatFunc.X⁻¹)⁻¹} = f.range ∧
      (IsIntegrallyClosed R →
        IsDomain (strictNodalRing R a) ∧ IsIntegrallyClosed (strictNodalRing R a) ∧
          ∀ (p : Ideal (strictNodalRing R a)) [p.IsPrime],
            IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p)) := by
  sorry

end AlgebraicGeometry
