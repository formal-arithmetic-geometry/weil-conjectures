module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.TensorProduct.Quotient
import Sheaf.RingTheory.FiniteIntegralAwayApproximation
import Sheaf.RingTheory.QuotientSectionFactorTransfer
import Sheaf.Paper.IntegralClosureFiniteFibrePartLocalization
import Sheaf.RingTheory.EtaleSectionIdempotentSplitting

/-!
# A finite model for the closed-fibre section of an étale algebra

Source: Stacks Project, Tag 09XI, proof of (5) implies (2), through the finite
subalgebra construction, before applying Tag 0EM0.
-/

@[expose] public section

universe u v

namespace Algebra

/-- The closed-fibre section has a finite subalgebra model whose localization agrees
with that of the original étale algebra. No root-lifting assumption is needed.

Source: Stacks Project, Tag 09XI (lemma-characterize-henselian-pair), proof of
(5) implies (2), paragraphs constructing the section decomposition, the integral
closure, and the finite subalgebra; Tag 09XH (lemma-helper-finite-type).
(blueprint: lem-weil-pbc-finite-gabber-section-model)

Proof:
1. Factor the section through B/IB. Étale base change and the section-idempotent
splitting give B/IB = A/I × C with the section as first projection.
2. Apply the integral-closure finite-fibre localization theorem, with finite first
factor A/I. Obtain b in the integral closure lifting its first-factor idempotent,
and an isomorphism from the integral closure localized at b to B localized at b.
3. Express b²-b as a finite sum of I-coefficients times elements of the integral
closure. The localization of B is of finite type over A, so choose finitely many
numerators generating the integral-closure localization. Let D be the subalgebra
of B generated by b, these numerators, and the elements in the expression for b²-b.
All generators are integral, so D is finite over A. Its localization maps
injectively to the integral-closure localization (localization preserves injections)
and surjectively because it contains the chosen generators and b⁻¹.
4. In D/ID the image of b is idempotent. Its corner is A/I: quotient commutes
with localization, and the localized quotient was the first integral-closure
factor A/I. Split D/ID into this corner and its complementary corner C. Choose
the first-factor identification induced by the original section. The resulting
product map respects the A/I structure and has the asserted first projection. -/
theorem exists_finite_gabber_section_model
    (A : Type u) [CommRing A] (I : Ideal A)
    (B : Type v) [CommRing B] [Algebra A B] [Etale A B]
    (σ : B →ₐ[A] A ⧸ I) :
    ∃ (D : Subalgebra A B) (_ : Module.Finite A D)
      (C : Type v) (_ : CommRing C) (_ : Algebra (A ⧸ I) C)
      (Φ : (D ⧸ I.map (algebraMap A D)) ≃+* ((A ⧸ I) × C)) (b : D),
      (∀ a : A, Φ (Ideal.Quotient.mk _ (algebraMap A D a)) =
        (algebraMap (A ⧸ I) (A ⧸ I) (Ideal.Quotient.mk I a),
          algebraMap (A ⧸ I) C (Ideal.Quotient.mk I a))) ∧
      Φ (Ideal.Quotient.mk _ b) = (1, 0) ∧
      (∀ x : D, (Φ (Ideal.Quotient.mk _ x)).1 = σ x.1) ∧
      Function.Bijective (Localization.awayMap D.val.toRingHom b) := by
  classical
  let J := I.map (algebraMap A B)
  have hJ : J ≤ RingHom.ker σ.toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    change σ (algebraMap A B a) = 0
    rw [σ.commutes]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
  let s : (B ⧸ J) →ₐ[A ⧸ I] A ⧸ I :=
    (Ideal.Quotient.liftₐ J σ hJ).extendScalarsOfSurjective Ideal.Quotient.mk_surjective
  let : Etale (A ⧸ I) (B ⧸ J) :=
    Etale.of_equiv (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B I).symm
  obtain ⟨ε, hε, hsε, hker, ⟨hC, _, e, hes⟩, _⟩ :=
    Etale.exists_idempotent_splitting_of_algHom s
  let := hC
  have he : ∀ a : A, e (Ideal.Quotient.mk J (algebraMap A B a)) =
      (algebraMap (A ⧸ I) (A ⧸ I) (Ideal.Quotient.mk I a),
        algebraMap (A ⧸ I) hε.one_sub.Corner (Ideal.Quotient.mk I a)) := by
    intro a
    exact e.commutes (Ideal.Quotient.mk I a)
  have heε : e ε = (1, 0) := by
    have hy : s (e.symm (0, 1)) = 0 := by
      simpa using (hes (e.symm (0, 1))).symm
    have hyker : e.symm (0, 1) ∈ Ideal.span {1 - ε} :=
      hker ▸ RingHom.mem_ker.mpr hy
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hyker
    have hmul : ε * e.symm (0, 1) = 0 := by
      rw [hz, ← mul_assoc, mul_sub, mul_one, hε.eq, sub_self, zero_mul]
    have hsecond := congrArg (fun x ↦ (e x).2) hmul
    apply Prod.ext
    · exact (hes ε).trans hsε
    · simpa using hsecond
  obtain ⟨ε', g, q, hq, hε', hqε, _, _, _, hg, hloc⟩ :=
    integralClosure_finiteFibrePart_localization A B I (A ⧸ I)
      hε.one_sub.Corner e.toRingEquiv he ε heε
  obtain ⟨D, hD, b, hbg, hb, hDb⟩ :=
    exists_finite_integral_away_approximation A B I g (hg ▸ hε') hloc
  obtain ⟨C, hC', hAC, Φ, hΦ, hΦb, hΦs⟩ :=
    quotient_section_factor_transfer I σ hε.one_sub.Corner e.toRingEquiv
      (fun x ↦ hes (Ideal.Quotient.mk J x)) D b hb hDb (by
        rw [hbg]
        have h := hq g
        rw [hg, hqε] at h
        exact h.symm ▸ heε)
  exact ⟨D, hD, C, hC', hAC, Φ, b, hΦ, hΦb, hΦs, hDb⟩

end Algebra
