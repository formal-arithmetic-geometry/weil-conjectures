module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.RingTheory.KrullDimension.Regular

/-!
# Regularity lifts from a regular-sequence quotient

Source: Stacks Project, Algebra, Tag 00NU, lemma-regular-mod-x, second assertion
(blueprint: lem-exc-regular-local-lift-regular-sequence-quotient).
-/

@[expose] public section

universe u

namespace RingTheory

open IsLocalRing

/-- If a Noetherian local ring is cut out by a regular sequence in its maximal ideal
to a regular local quotient, then the original ring is regular local.

Source: Stacks Project, Algebra, Tag 00NU, lemma-regular-mod-x, second assertion.
Proof, following the five steps of the DAG node:
1. Write `Iᵢ` for the ideal of the first `i` elements and `Rᵢ = R/Iᵢ`.
   Each `Iᵢ` is contained in the maximal ideal. Ideals of `Rᵢ` are finitely
   generated by lifting to `R` (`def-weil-pbc-noetherian-ring`). The correspondence
   of maximal ideals under a quotient shows that `Rᵢ` is local and nonzero.
2. The next element has regular image `aᵢ` in `Rᵢ` by
   `def-weil-pbc-regular-sequence`. The next quotient map has kernel `(aᵢ)`;
   representatives give a ring isomorphism `Rᵢ/(aᵢ) ≃ Rᵢ₊₁`.
3. The node `lem-weil-pbc-noetherian-local-finite-krull-dimension` gives finite
   dimensions `dᵢ`. The node `lem-weil-pbc-dimension-quotient-nonzerodivisor`
   gives `dᵢ₊₁ + 1 = dᵢ`. The quotient isomorphism preserves prime chains.
4. If `Rᵢ₊₁` is regular, lift its `dᵢ₊₁` maximal-ideal generators to `Rᵢ`.
   Subtracting a lifted linear combination from any element of the preceding
   maximal ideal leaves an element of `(aᵢ)`. Adjoining `aᵢ` therefore gives
   `dᵢ` generators, proving regularity by `def-weil-regular-scheme`.
5. Descending induction starts with the assumed regularity of the final quotient
   and ends at `R/(0) ≃ R`. The empty list already starts at that conclusion;
   a zero-dimensional final quotient uses the empty generating list in step 4.
(blueprint: lem-exc-regular-local-lift-regular-sequence-quotient) -/
theorem isRegularLocalRing_of_regularSequence_quotient
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (xs : List R) (hmem : ∀ x ∈ xs, x ∈ maximalIdeal R)
    (hseq : RingTheory.Sequence.IsRegular R xs)
    [IsRegularLocalRing (R ⧸ Ideal.ofList xs)] :
    IsRegularLocalRing R := by
  classical
  -- Lift the final quotient generators together, rather than one element at a time.
  let I := Ideal.ofList xs
  let q := Ideal.Quotient.mk I
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  let g := Function.surjInv hq
  have hg : Function.RightInverse g q := Function.rightInverse_surjInv hq
  obtain ⟨s, hcard, hs⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (maximalIdeal (R ⧸ I)).fg_of_isNoetherianRing
  change Ideal.span (s : Set (R ⧸ I)) = maximalIdeal (R ⧸ I) at hs
  let t := s.image g
  have himage : q '' (t : Set R) = (s : Set (R ⧸ I)) := by
    simp only [t, Finset.coe_image, ← Set.image_comp]
    have hcomp : (q ∘ g) = id := funext hg
    rw [hcomp, Set.image_id]
  have hmap : Ideal.map q (Ideal.span (t : Set R)) = Ideal.map q (maximalIdeal R) := by
    rw [Ideal.map_span, himage, hs, map_maximalIdeal_of_surjective q hq]
  have hI : I ≤ maximalIdeal R := Ideal.span_le.mpr hmem
  have hgen : Ideal.span ((t ∪ xs.toFinset : Finset R) : Set R) = maximalIdeal R := by
    have h := (Ideal.map_eq_iff_sup_ker_eq_of_surjective q hq).mp hmap
    simpa only [q, Ideal.mk_ker, sup_eq_left.mpr hI, Finset.coe_union,
      Ideal.span_union, List.coe_toFinset, Ideal.ofList, I] using h
  have hbound : (maximalIdeal R).spanFinrank ≤
      (maximalIdeal (R ⧸ I)).spanFinrank + xs.length := by
    rw [← hgen]
    apply (Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)).trans
    rw [Set.ncard_coe_finset]
    exact (Finset.card_union_le t xs.toFinset).trans
      (Nat.add_le_add ((Finset.card_image_le).trans_eq hcard) xs.toFinset_card_le)
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  calc
    ((maximalIdeal R).spanFinrank : WithBot ℕ∞) ≤
        ((maximalIdeal (R ⧸ I)).spanFinrank + xs.length : ℕ) := by exact_mod_cast hbound
    _ = ringKrullDim (R ⧸ I) + xs.length := by
      rw [Nat.cast_add, IsRegularLocalRing.spanFinrank_maximalIdeal]
    _ = ringKrullDim R := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular xs hseq

end RingTheory

end
