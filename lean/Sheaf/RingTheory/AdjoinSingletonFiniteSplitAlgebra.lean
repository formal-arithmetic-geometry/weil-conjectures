module

public import Sheaf.RingTheory.NagataRing
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.Algebra.Polynomial.Splits
import Sheaf.RingTheory.MonogenicResiduePolynomialModel
import Sheaf.RingTheory.MonogenicRelationFiniteSplitting

/-! # Finite split coefficient extension before maximal localization
Source: Stacks Project, Algebra, Tag 0334, Step 5.
(blueprint: lem-weil-pbc-monogenic-finite-split-algebra). -/

@[expose] public section

universe u v

/-- Construct the split polynomial over a finite extension of a principal localization.
Source: Stacks Project, Algebra, Tag 0334, Step 5.
(blueprint: lem-weil-pbc-monogenic-finite-split-algebra).

Proof: Write S = R[x] and n = m cap R. The field S/m is generated by the residue of x
as an algebra over Frac(R/n), hence is finite by Zariski's lemma. Its monic minimal
polynomial has positive degree. Lift the finitely many coefficients to R_n and invert
the product a of their denominators. Then a is outside n, its image s in S is outside m,
and the lifted monic polynomial evaluates into mS_s. Choose a finite splitting field L
of this polynomial over K. The integral closure R' of R_a in L is finite by the Nagata
property, normal with fraction field L, and Nagata by finite descent of that property.
The roots belong to R' because the polynomial is monic. Its factorization in L descends
to R'[X] by injectivity. Set z to be the image of x and T = R'[z]. The finite R_a-module
generators of R' generate T over S_s: expand a polynomial in z and express every
coefficient in these generators. This constructs an injective finite map g : S_s -> T.
Its extended maximal ideal contains the evaluation, by functoriality of evaluation
and ideal extension. Lift the rings and fields into Type(max u v) when necessary.
No localization at the complement of m, and no maximal-ideal assertion about such a
localization, is made here. -/
theorem exists_adjoin_singleton_finite_split_algebra
    (R : Type u) (K : Type v) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [Field K] [Algebra R K] [IsFractionRing R K] (hR : IsNagataRing R) (x : K)
    (m : Ideal (Algebra.adjoin R ({x} : Set K))) [m.IsMaximal] :
    ∃ (s : Algebra.adjoin R ({x} : Set K)), s ∉ m ∧
      ∃ (R' K' : Type (max u v)) (_ : CommRing R') (_ : IsDomain R')
        (_ : IsIntegrallyClosed R') (_ : Field K') (_ : Algebra R' K')
        (_ : IsFractionRing R' K'),
        IsNagataRing R' ∧ ∃ (z : K')
          (g : Localization.Away s →+* Algebra.adjoin R' ({z} : Set K')),
          Function.Injective g ∧ g.Finite ∧ ∃ f : Polynomial R',
            f.Monic ∧ 0 < f.natDegree ∧ f.Splits ∧
            Polynomial.aeval
              (⟨z, Algebra.subset_adjoin (Set.mem_singleton z)⟩ :
                Algebra.adjoin R' ({z} : Set K')) f ∈
              m.map (g.comp (algebraMap _ (Localization.Away s))) := by
  obtain ⟨s, hs, A, L, instCR, instD, instIC, instF, instA, instFR, hA, y, e, f,
      hf, hd, heval⟩ := exists_monogenic_residue_polynomial_model R K hR x m
  let : CommRing A := instCR
  let : IsDomain A := instD
  let : IsIntegrallyClosed A := instIC
  let : Field L := instF
  let : Algebra A L := instA
  let : IsFractionRing A L := instFR
  obtain ⟨R', K', instCR', instD', instIC', instF', instA', instFR', hR', z, g,
      hg, hgf, f', hf', hd', hs', heval'⟩ :=
    exists_monogenic_relation_finite_splitting A L hA y
      (m.map (e.toRingHom.comp (algebraMap _ (Localization.Away s)))) f hf hd heval
  refine ⟨s, hs, R', K', instCR', instD', instIC', instF', instA', instFR', hR', z,
    g.comp e.toRingHom, hg.comp e.injective, hgf.comp e.finite, f', hf', hd', hs', ?_⟩
  simpa only [Ideal.map_map, RingHom.comp_assoc] using heval'

