module

public import Mathlib.LinearAlgebra.TensorProduct.Tower
public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.FiniteLength
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.RingTheory.AdicCompletion.AsTensorProduct

/-! # Completion comparison for a finite-colength algebra inclusion

Source: Stacks Project, varieties.tex, Tag 0C1R (lemma-prepare-delta-invariant),
parts (7) and (9), and Tag 0C3V (lemma-normalization-same-after-completion);
algebra.tex, Tags 00MA and 00MB.
(blueprint: lem-trf-finite-colength-completion-comparison)

The module and ring versions of the completion of C are identified coordinatewise.
Both cokernels below are quotients by submodules, never by ideals.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

@[expose] public section

universe u v

open TensorProduct

namespace AdicCompletion.FiniteColength

variable (A : Type u) [CommRing A] (C : Type v) [CommRing C] [Algebra A C]

/-- The module quotient C/f(A), for the structural homomorphism f.
Source: Stacks Project, Tag 0C1R, part (9).
(blueprint: lem-trf-finite-colength-completion-comparison) -/
abbrev Quotient := C ⧸ LinearMap.range (Algebra.linearMap A C)

/-- The ring presentation of the I-adic completion of the A-algebra C.
Source: Stacks Project, Tags 00M9 and 0C3V; (IC)^n = I^n C.
(blueprint: lem-trf-finite-colength-completion-comparison) -/
abbrev AlgebraCompletion (I : Ideal A) := AdicCompletion (I.map (algebraMap A C)) C

/-- The completed inclusion, with scalars restricted to A.
Source: Stacks Project, Tag 00MA, part (2).
(blueprint: lem-trf-finite-colength-completion-comparison) -/
noncomputable abbrev inclusion (I : Ideal A) : AdicCompletion I A →ₗ[A] AdicCompletion I C :=
  (AdicCompletion.map I (Algebra.linearMap A C)).restrictScalars A

/-- The completed module quotient map, with scalars restricted to A.
Source: Stacks Project, Tag 00MA, part (2).
(blueprint: lem-trf-finite-colength-completion-comparison) -/
noncomputable abbrev projection (I : Ideal A) :
    AdicCompletion I C →ₗ[A] AdicCompletion I (Quotient A C) :=
  (AdicCompletion.map I (LinearMap.range (Algebra.linearMap A C)).mkQ).restrictScalars A

/-- The cokernel of the completed inclusion as an A-module.
Source: Stacks Project, Tag 0C1R, part (9).
(blueprint: lem-trf-finite-colength-completion-comparison) -/
abbrev CompletedQuotient (I : Ideal A) :=
  AdicCompletion I C ⧸ LinearMap.range (inclusion A C I)

/-- Completion preserves the finite-length cokernel of an injective finite algebra,
and the tensor comparison is an algebra isomorphism with the specified base inclusion.
The existential equivalences are characterized by their values on quotient representatives,
completion coordinates, or pure tensors, so all comparisons are canonical.

Source: Stacks Project, varieties.tex, Tags 0C1R (7), (9) and 0C3V;
algebra.tex, Tags 00MA and 00MB.
(blueprint: lem-trf-finite-colength-completion-comparison)

Proof:
1. A simple A-module is generated by any nonzero element. Its annihilator is maximal,
   hence is m by locality. Thus m kills each successive quotient of the filtration s.
2. Descending the filtration gives m^j M_r contained in M_(r-j), so m^r M = 0.
   When r = 0, M = 0 already. Every later power also kills M. Quotienting by zero
   identifies every tail coordinate with M and every transition with the identity.
   Evaluation at max(1,r) is inverse to the completion map of M.
3. The sequence A -> C -> M is short exact, and all three modules are finite.
   Apply lem-weil-pbc-completion-exact-finite-modules (Mathlib's map_injective,
   map_exact and map_surjective) to obtain the displayed completed short exact sequence.
4. Its cokernel isomorphism beta sends the class of z to the completed quotient map of z.
   The map alpha sends the class of c to the class of its completion. It is well defined:
   changing c by f(a) changes its completion by the completed inclusion of iota_A(a).
   Coordinatewise, beta composed with alpha is iota_M; both beta and iota_M are bijective,
   so alpha is bijective as well.
5. The ideals (mC)^n and m^n C agree. The resulting quotient identifications in every
   coordinate yield the linear equivalence e between module and ring presentations
   of the completion. Coordinatewise application of f gives the algebra map fhat;
   it agrees with e composed with the completed module inclusion.
6. Apply lem-weil-pbc-completion-finite-module-tensor (Mathlib's
   ofTensorProductEquivOfFiniteNoetherian) to C. On pure tensors its formula is
   a tensor c -> a smul iota_C(c) = fhat(a) * iota_C(c), giving T after e.
7. The pure-tensor product formula shows T is multiplicative, unital, and respects
   the completed base inclusion a -> a tensor 1. Its inverse therefore makes it an
   algebra equivalence. Compose with the tensor flip to get U, with the right-factor
   completed-base algebra structure. Both structural inclusions have image fhat(a). -/
theorem comparison [IsNoetherianRing A] [IsLocalRing A] [Module.Finite A C]
    (hf : Function.Injective (algebraMap A C))
    (r : ℕ) (s : CompositionSeries (Submodule A (Quotient A C)))
    (hs₀ : s.head = ⊥) (hsr : s.last = ⊤) (hlen : s.length = r) :
    ((IsLocalRing.maximalIdeal A) ^ r • ⊤ : Submodule A (Quotient A C)) = ⊥ ∧
    (∀ n : ℕ, r ≤ n →
      ((IsLocalRing.maximalIdeal A) ^ n • ⊤ : Submodule A (Quotient A C)) = ⊥) ∧
    (∃ ε : ∀ (n : ℕ), r ≤ n →
        ((Quotient A C) ⧸ ((IsLocalRing.maximalIdeal A) ^ n • ⊤ :
          Submodule A (Quotient A C))) ≃ₗ[A] Quotient A C,
      (∀ (n : ℕ) (hn : r ≤ n) (x : Quotient A C),
        ε n hn (Submodule.Quotient.mk x) = x) ∧
      (∀ (n k : ℕ) (hn : r ≤ n) (hnk : n ≤ k)
          (x : (Quotient A C) ⧸ ((IsLocalRing.maximalIdeal A) ^ k • ⊤ :
            Submodule A (Quotient A C))),
        ε n hn (AdicCompletion.transitionMap (IsLocalRing.maximalIdeal A)
          (Quotient A C) hnk x) = ε k (hn.trans hnk) x)) ∧
    Function.Bijective (AdicCompletion.of (IsLocalRing.maximalIdeal A) (Quotient A C)) ∧
    Function.Injective (inclusion A C (IsLocalRing.maximalIdeal A)) ∧
    Function.Exact (inclusion A C (IsLocalRing.maximalIdeal A))
      (projection A C (IsLocalRing.maximalIdeal A)) ∧
    Function.Surjective (projection A C (IsLocalRing.maximalIdeal A)) ∧
    (∃ (α : Quotient A C ≃ₗ[A]
          CompletedQuotient A C (IsLocalRing.maximalIdeal A))
        (β : CompletedQuotient A C (IsLocalRing.maximalIdeal A) ≃ₗ[A]
          AdicCompletion (IsLocalRing.maximalIdeal A) (Quotient A C)),
      (∀ c : C, α (Submodule.Quotient.mk c) =
        Submodule.Quotient.mk (AdicCompletion.of (IsLocalRing.maximalIdeal A) C c)) ∧
      (∀ z : AdicCompletion (IsLocalRing.maximalIdeal A) C,
        β (Submodule.Quotient.mk z) = projection A C (IsLocalRing.maximalIdeal A) z) ∧
      β.toLinearMap.comp α.toLinearMap =
        AdicCompletion.of (IsLocalRing.maximalIdeal A) (Quotient A C)) ∧
    ∃ (e : AdicCompletion (IsLocalRing.maximalIdeal A) C ≃ₗ[A]
          AlgebraCompletion A C (IsLocalRing.maximalIdeal A))
        (fhat : AdicCompletion (IsLocalRing.maximalIdeal A) A →ₐ[A]
          AlgebraCompletion A C (IsLocalRing.maximalIdeal A)),
      (∀ (z : AdicCompletion (IsLocalRing.maximalIdeal A) C) (n : ℕ) (c : C),
        AdicCompletion.eval (IsLocalRing.maximalIdeal A) C n z =
          Submodule.Quotient.mk c →
        AdicCompletion.evalₐ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)) n (e z) =
          Ideal.Quotient.mk _ c) ∧
      (∀ a : AdicCompletion (IsLocalRing.maximalIdeal A) A,
        fhat a = e (inclusion A C (IsLocalRing.maximalIdeal A) a)) ∧
      ∃ T : @AlgEquiv (AdicCompletion (IsLocalRing.maximalIdeal A) A)
          (AdicCompletion (IsLocalRing.maximalIdeal A) A ⊗[A] C)
          (AlgebraCompletion A C (IsLocalRing.maximalIdeal A))
          _ _ _ _ fhat.toRingHom.toAlgebra,
        (∀ (a : AdicCompletion (IsLocalRing.maximalIdeal A) A) (c : C),
          T (a ⊗ₜ[A] c) = fhat a *
            algebraMap C (AlgebraCompletion A C (IsLocalRing.maximalIdeal A)) c) ∧
        (∀ a : AdicCompletion (IsLocalRing.maximalIdeal A) A,
          T (a ⊗ₜ[A] (1 : C)) = fhat a) ∧
        ∃ U : @AlgEquiv (AdicCompletion (IsLocalRing.maximalIdeal A) A)
            (C ⊗[A] AdicCompletion (IsLocalRing.maximalIdeal A) A)
            (AlgebraCompletion A C (IsLocalRing.maximalIdeal A))
            _ _ _ Algebra.TensorProduct.rightAlgebra fhat.toRingHom.toAlgebra,
          (∀ z : C ⊗[A] AdicCompletion (IsLocalRing.maximalIdeal A) A,
            U z = T (Algebra.TensorProduct.comm A C
              (AdicCompletion (IsLocalRing.maximalIdeal A) A) z)) ∧
          (∀ a : AdicCompletion (IsLocalRing.maximalIdeal A) A,
            U ((1 : C) ⊗ₜ[A] a) = fhat a) := by
  sorry

end AdicCompletion.FiniteColength
