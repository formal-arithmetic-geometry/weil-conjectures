module

public import Mathlib.RingTheory.Extension.Presentation.Basic
public import Mathlib.RingTheory.Localization.Away.Basic

/-! # The desingularization quotient after inverting the parameter

Source: Stacks Project, Smoothing Ring Maps, proof of Tag 07CR, the identification
`B_π = A_π[v]`.
-/

@[expose] public section

universe u w

namespace Algebra

open MvPolynomial

/-- A localized affine substitution leaves the auxiliary variables free.

Source: Stacks Project, Smoothing Ring Maps, proof of Tag 07CR, the equations `hᵢ`
and the identification `B_π ≅ A_π[v]`.
(blueprint: lem-weil-pbc-popescu-desingularization-inverted-quotient).

Proof: localize the coefficients at `r`. Localization commutes with the quotient,
so its relations become `fⱼ(t(v) + r^d w)`. The affine change of variables fixing
`v` and sending `wᵢ` to `tᵢ(v) + r^d wᵢ` is an automorphism: its inverse sends
`wᵢ` to `r^(-d) (wᵢ - tᵢ(v))`. These formulas are inverse on every variable and
coefficient. It carries the ideal generated by `fⱼ(w)` to the substituted ideal.
The quotient by `fⱼ(w)` is the polynomial ring in `v` over the localized algebra
presented by `P`, by the presentation kernel equality and coefficientwise
polynomial quotient. Compose these equivalences. Renaming the lifted variables
is an equivalence and changes none of the formulas. This proof permits empty
variable or relation sets, exponent zero, and the zero localization. -/
private theorem localized_affine_presentation_quotient_equiv
    (R : Type u) (A : Type w) [CommRing R] [CommRing A] [Algebra R A]
    (r : R) (n m c d : ℕ) (P : Presentation R A (Fin n) (Fin m))
    (t : Fin n → MvPolynomial (Fin c) R) :
    let Q := MvPolynomial (ULift.{w} (Fin c ⊕ Fin n)) R
    let ξ : Fin n → Q := fun i ↦
      rename (fun k ↦ ULift.up (Sum.inl k)) (t i) +
        C r ^ d * X (ULift.up (Sum.inr i))
    let I := Ideal.span (Set.range (fun j : Fin m ↦ aeval (R := R) ξ (P.relation j)))
    Nonempty (Localization.Away (algebraMap R (Q ⧸ I) r) ≃ₐ[R]
      MvPolynomial (Fin c) (Localization.Away (algebraMap R A r))) := by
  classical
  let Q := MvPolynomial (ULift.{w} (Fin c ⊕ Fin n)) R
  let ιv : Fin c → ULift.{w} (Fin c ⊕ Fin n) := fun k ↦ ULift.up (Sum.inl k)
  let ιw : Fin n → ULift.{w} (Fin c ⊕ Fin n) := fun i ↦ ULift.up (Sum.inr i)
  let ξ : Fin n → Q := fun i ↦ rename ιv (t i) + C r ^ d * X (ιw i)
  let I : Ideal Q := Ideal.span (Set.range (fun j ↦ aeval ξ (P.relation j)))
  let B := Q ⧸ I
  let L := Localization.Away (algebraMap R B r)
  let Ap := Localization.Away (algebraMap R A r)
  let V := MvPolynomial (Fin c) Ap
  let α : Q →ₐ[R] L := (Algebra.algHom R B L).comp (Ideal.Quotient.mkₐ R I)
  let z : MvPolynomial (Fin n) R →ₐ[R] L := α.comp (aeval ξ)
  have hz : P.ker ≤ RingHom.ker z.toRingHom := by
    rw [← P.span_range_relation_eq_ker]
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change algebraMap B L (Ideal.Quotient.mk I (aeval ξ (P.relation j))) = 0
    have hmem : aeval ξ (P.relation j) ∈ I := Ideal.subset_span ⟨j, rfl⟩
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
  let aA : A →ₐ[R] L :=
    (Ideal.Quotient.liftₐ P.ker z (fun x hx ↦ hz hx)).comp
      (P.quotientEquiv.restrictScalars R).symm.toAlgHom
  have hA (p : MvPolynomial (Fin n) R) : aA (aeval P.val p) = z p := by
    have he : P.quotientEquiv.symm (aeval P.val p) = Ideal.Quotient.mk P.ker p := by
      apply P.quotientEquiv.injective
      simp [P.algebraMap_apply]
    change Ideal.Quotient.liftₐ P.ker z (fun x hx ↦ hz hx)
      (P.quotientEquiv.symm (aeval P.val p)) = _
    rw [he]
    rfl
  have hAval (i : Fin n) : aA (P.val i) = α (ξ i) := by
    simpa [z] using hA (X i)
  have hunitL : IsUnit (algebraMap R L r) := by
    rw [IsScalarTower.algebraMap_apply R B L]
    exact IsLocalization.Away.algebraMap_isUnit (algebraMap R B r)
  let aAp : Ap →ₐ[R] L := IsLocalization.Away.liftAlgHom
    (algebraMap R A r) (show IsUnit (aA (algebraMap R A r)) by simpa using hunitL)
  have hAp (x : A) : aAp (algebraMap A Ap x) = aA x :=
    IsLocalization.Away.lift_eq _
      (show IsUnit (aA (algebraMap R A r)) by simpa using hunitL) x
  let back : V →ₐ[R] L := aevalTower aAp (fun k ↦ α (X (ιv k)))
  let b : Ap := algebraMap R Ap r
  let b' : Ap := IsLocalization.Away.invSelf (algebraMap R A r)
  have hbb : b * b' = 1 := IsLocalization.Away.mul_invSelf (algebraMap R A r)
  let tv : Fin n → V := fun i ↦ map (algebraMap R Ap) (t i)
  let xs : ULift.{w} (Fin c ⊕ Fin n) → V := fun j ↦ match j.down with
    | Sum.inl k => X k
    | Sum.inr i => C b' ^ d * (C (algebraMap A Ap (P.val i)) - tv i)
  let θ : Q →ₐ[R] V := aeval xs
  have hθX (j : ULift.{w} (Fin c ⊕ Fin n)) : θ (X j) = xs j :=
    aeval_X xs j
  have hbackX (k : Fin c) : back (X k) = α (X (ιv k)) :=
    aevalTower_X aAp _ k
  have hbackC (x : Ap) : back (C x) = aAp x := aevalTower_C aAp _ x
  have hθt (p : MvPolynomial (Fin c) R) :
      θ (rename ιv p) = map (algebraMap R Ap) p := by
    have he : θ.comp (rename ιv) = mapAlgHom (Algebra.ofId R Ap) := by
      apply MvPolynomial.algHom_ext
      intro k
      change θ (rename ιv (X k)) = map (algebraMap R Ap) (X k)
      rw [rename_X, hθX, map_X]
    exact AlgHom.congr_fun he p
  have hθξ (i : Fin n) : θ (ξ i) = C (algebraMap A Ap (P.val i)) := by
    simp only [ξ, map_add, map_mul, map_pow, hθt]
    have hc : θ (C r) = C b := by
      change aeval xs (C r) = C b
      rw [aeval_C]
      rfl
    have hx : θ (X (ιw i)) =
        C b' ^ d * (C (algebraMap A Ap (P.val i)) - tv i) := by
      exact hθX (ιw i)
    rw [hc, hx, ← mul_assoc, ← mul_pow, ← map_mul, hbb, map_one, one_pow, one_mul]
    exact add_sub_cancel _ _
  have hθz : θ.comp (aeval ξ) =
      (Algebra.algHom R A V).comp (aeval P.val) := by
    apply MvPolynomial.algHom_ext
    intro i
    change θ (aeval ξ (X i)) = (Algebra.algHom R A V) (aeval P.val (X i))
    rw [aeval_X, aeval_X, hθξ]
    rfl
  have hI : I ≤ RingHom.ker θ.toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change θ (aeval ξ (P.relation j)) = 0
    have he := AlgHom.congr_fun hθz (P.relation j)
    simpa using he
  let θB : B →ₐ[R] V := Ideal.Quotient.liftₐ I θ (fun x hx ↦ hI hx)
  have hunitV : IsUnit (algebraMap R V r) := by
    change IsUnit (C b)
    apply IsUnit.map
    change IsUnit (algebraMap R Ap r)
    rw [IsScalarTower.algebraMap_apply R A Ap]
    exact IsLocalization.Away.algebraMap_isUnit (algebraMap R A r)
  let forward : L →ₐ[R] V := IsLocalization.Away.liftAlgHom
    (algebraMap R B r) (show IsUnit (θB (algebraMap R B r)) by simpa using hunitV)
  have hforward (x : B) : forward (algebraMap B L x) = θB x :=
    IsLocalization.Away.lift_eq _
      (show IsUnit (θB (algebraMap R B r)) by simpa using hunitV) x
  have hforwardα (p : Q) : forward (α p) = θ p := hforward (Ideal.Quotient.mk I p)
  have hbacktv (p : MvPolynomial (Fin c) R) :
      back (map (algebraMap R Ap) p) = α (rename ιv p) := by
    have he : back.comp (mapAlgHom (Algebra.ofId R Ap)) = α.comp (rename ιv) := by
      apply MvPolynomial.algHom_ext
      intro k
      change back (map (algebraMap R Ap) (X k)) = α (rename ιv (X k))
      rw [map_X, hbackX, rename_X]
    exact AlgHom.congr_fun he p
  have hforwardA : forward.comp aA = Algebra.algHom R A V := by
    apply (AlgHom.cancel_right P.aeval_val_surjective).mp
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, aeval_X, hAval, hforwardα, hθξ]
    rfl
  have hforwardAp : forward.comp aAp = Algebra.algHom R Ap V := by
    apply IsLocalization.algHom_ext (Submonoid.powers (algebraMap R A r))
    apply AlgHom.ext
    intro x
    change forward (aAp (algebraMap A Ap x)) = C (algebraMap A Ap x)
    rw [hAp]
    exact AlgHom.congr_fun hforwardA x
  have hfb : forward.comp back = AlgHom.id R V := by
    apply MvPolynomial.algHom_ext'
    · apply AlgHom.ext
      intro x
      change forward (back (C x)) = C x
      rw [hbackC]
      exact AlgHom.congr_fun hforwardAp x
    · intro k
      change forward (back (X k)) = X k
      rw [hbackX, hforwardα, hθX]
  have hbf : back.comp forward = AlgHom.id R L := by
    apply IsLocalization.algHom_ext (Submonoid.powers (algebraMap R B r))
    apply Ideal.Quotient.algHom_ext
    apply MvPolynomial.algHom_ext
    intro j
    change back (forward (α (X j))) = α (X j)
    rw [hforwardα]
    rcases j with ⟨j⟩
    rcases j with k | i
    · rw [hθX]
      exact hbackX k
    · rw [hθX]
      change back (C b' ^ d * (C (algebraMap A Ap (P.val i)) - tv i)) = α (X (ιw i))
      rw [map_mul, map_pow, map_sub]
      have hb' : back (C b') * α (C r) = 1 := by
        have hcb : back (C b) = α (C r) := by
          rw [hbackC]
          change aAp (algebraMap R Ap r) = α (algebraMap R Q r)
          rw [aAp.commutes, α.commutes]
        have he := congrArg (fun x ↦ back (C x)) hbb
        rw [map_mul, map_one, map_mul, map_one, hcb] at he
        rwa [mul_comm]
      have hx : back (C (algebraMap A Ap (P.val i))) = α (ξ i) := by
        rw [hbackC, hAp, hAval]
      rw [hx, hbacktv]
      simp only [ξ, map_add, map_mul, map_pow, add_sub_cancel_left]
      rw [← mul_assoc, ← mul_pow, hb', one_pow, one_mul]
  exact ⟨AlgEquiv.ofAlgHom forward back hfb hbf⟩

private theorem remove_redundant_localized_relations
    {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]
    (r : R) (I J : Ideal B)
    (hJ : J ≤ RingHom.ker
      ((Algebra.algHom R (B ⧸ I)
        (Localization.Away (algebraMap R (B ⧸ I) r))).comp
          (Ideal.Quotient.mkₐ R I)).toRingHom) :
    let D := (B ⧸ J) ⧸ I.map (Ideal.Quotient.mk J)
    Nonempty (Localization.Away (algebraMap R D r) ≃ₐ[R]
      Localization.Away (algebraMap R (B ⧸ I) r)) := by
  classical
  let K := I.map (Ideal.Quotient.mk J)
  let D := (B ⧸ J) ⧸ K
  let T := Localization.Away (algebraMap R (B ⧸ I) r)
  let U := Localization.Away (algebraMap R D r)
  let a : B →ₐ[R] T :=
    (Algebra.algHom R (B ⧸ I) T).comp (Ideal.Quotient.mkₐ R I)
  let b : B ⧸ J →ₐ[R] T := Ideal.Quotient.liftₐ J a (fun x hx ↦ hJ hx)
  have hb : K ≤ RingHom.ker b.toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    change a x = 0
    change algebraMap (B ⧸ I) T (Ideal.Quotient.mk I x) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
  let d : D →ₐ[R] T := Ideal.Quotient.liftₐ K b (fun x hx ↦ hb hx)
  have ht : IsUnit (algebraMap R T r) := by
    rw [IsScalarTower.algebraMap_apply R (B ⧸ I) T]
    exact IsLocalization.Away.algebraMap_isUnit (algebraMap R (B ⧸ I) r)
  let f : U →ₐ[R] T := IsLocalization.Away.liftAlgHom
    (algebraMap R D r) (show IsUnit (d (algebraMap R D r)) by simpa using ht)
  let q : B →ₐ[R] U := (Algebra.algHom R D U).comp
    ((Ideal.Quotient.mkₐ R K).comp (Ideal.Quotient.mkₐ R J))
  have hq : ∀ x ∈ I, q x = 0 := by
    intro x hx
    change algebraMap D U (Ideal.Quotient.mk K (Ideal.Quotient.mk J x)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hx), map_zero]
  let e : B ⧸ I →ₐ[R] U := Ideal.Quotient.liftₐ I q hq
  have hu : IsUnit (algebraMap R U r) := by
    rw [IsScalarTower.algebraMap_apply R D U]
    exact IsLocalization.Away.algebraMap_isUnit (algebraMap R D r)
  let g : T →ₐ[R] U := IsLocalization.Away.liftAlgHom
    (algebraMap R (B ⧸ I) r)
    (show IsUnit (e (algebraMap R (B ⧸ I) r)) by simpa using hu)
  have hf (x : D) : f (algebraMap D U x) = d x :=
    IsLocalization.Away.lift_eq _
      (show IsUnit (d (algebraMap R D r)) by simpa using ht) x
  have hg (x : B ⧸ I) : g (algebraMap (B ⧸ I) T x) = e x :=
    IsLocalization.Away.lift_eq _
      (show IsUnit (e (algebraMap R (B ⧸ I) r)) by simpa using hu) x
  refine ⟨AlgEquiv.ofAlgHom f g ?_ ?_⟩
  · apply IsLocalization.algHom_ext (Submonoid.powers (algebraMap R (B ⧸ I) r))
    apply Ideal.Quotient.algHom_ext
    ext x
    change f (g (algebraMap (B ⧸ I) T (Ideal.Quotient.mk I x))) = _
    rw [hg]
    change f (algebraMap D U (Ideal.Quotient.mk K (Ideal.Quotient.mk J x))) = _
    rw [hf]
    rfl
  · apply IsLocalization.algHom_ext (Submonoid.powers (algebraMap R D r))
    apply Ideal.Quotient.algHom_ext
    apply Ideal.Quotient.algHom_ext
    ext x
    change g (f (algebraMap D U (Ideal.Quotient.mk K (Ideal.Quotient.mk J x)))) = _
    rw [hf]
    change g (algebraMap (B ⧸ I) T (Ideal.Quotient.mk I x)) = _
    rw [hg]
    rfl

/-- Inverting the parameter in the substituted quotient eliminates the `w` variables.
This is a purely algebraic assertion, independent of smoothness and the map to `Λ`.

Source: Stacks Project, Smoothing Ring Maps, proof of Tag 07CR, paragraph beginning
with the identification of `B_π` with `A_π[v]`.
(blueprint: lem-weil-pbc-popescu-desingularization-inverted-quotient).

Proof: write `Q = R[v,w]`, `Fⱼ = fⱼ(ξ)` and `ξᵢ = π²Σₖsᵢₖvₖ + π³wᵢ`.
The iterated quotient in the statement is `Q/(g,F)`. After inverting `π`, each `gⱼ`
is already in `(F)` because `π³gⱼ = Fⱼ`. Thus its localization is `Q_π/(F)`.
Adjoin the original variables `x` to this presentation and impose `xᵢ = ξᵢ`.
Eliminating `x` gives `Q_π/(F)`. Alternatively impose `f(x)=0` first, obtaining
`A_π[v,w]/(xᵢ-π²Σₖsᵢₖvₖ-π³wᵢ)`. Since `π³` is a unit, each displayed equation
solves uniquely for `wᵢ`, and elimination identifies the result with `A_π[v]`.
These maps preserve `R`, are mutually inverse on every generator, and also work for
empty sets of variables or relations. Localization commutes with each quotient by
its universal property. The lifted variable indices simply rename the polynomial
ring. -/
theorem desingularization_inverted_quotient_equiv
    (R : Type u) (A : Type w) [CommRing R] [CommRing A] [Algebra R A]
    (π : R) (n m c : ℕ) (P : Presentation R A (Fin n) (Fin m))
    (hc : c ≤ m) (s : Fin n → Fin c → R)
    (g : Fin c → MvPolynomial (ULift.{w} (Fin c ⊕ Fin n)) R)
    (hg : ∀ j : Fin c,
      aeval (R := R) (fun i : Fin n ↦
        C π ^ 2 * ∑ k, C (s i k) *
          X (σ := ULift.{w} (Fin c ⊕ Fin n)) (ULift.up (Sum.inl k)) +
        C π ^ 3 * X (σ := ULift.{w} (Fin c ⊕ Fin n)) (ULift.up (Sum.inr i)))
        (P.relation (Fin.castLE hc j)) = C π ^ 3 * g j) :
    let Q := MvPolynomial (ULift.{w} (Fin c ⊕ Fin n)) R
    let ξ : Fin n → Q := fun i ↦
      C π ^ 2 * ∑ k, C (s i k) * X (ULift.up (Sum.inl k)) +
        C π ^ 3 * X (ULift.up (Sum.inr i))
    let S := Q ⧸ Ideal.span (Set.range g)
    let K := Ideal.map (Ideal.Quotient.mk (Ideal.span (Set.range g)))
      (Ideal.span (Set.range (fun j : Fin m ↦ aeval (R := R) ξ (P.relation j))))
    Nonempty (Localization.Away (algebraMap R (S ⧸ K) π) ≃ₐ[R]
      MvPolynomial (Fin c) (Localization.Away (algebraMap R A π))) := by
  classical
  let Q := MvPolynomial (ULift.{w} (Fin c ⊕ Fin n)) R
  let ξ : Fin n → Q := fun i ↦
    C π ^ 2 * ∑ k, C (s i k) * X (ULift.up (Sum.inl k)) +
      C π ^ 3 * X (ULift.up (Sum.inr i))
  let I : Ideal Q := Ideal.span
    (Set.range (fun j : Fin m ↦ aeval (R := R) ξ (P.relation j)))
  let J : Ideal Q := Ideal.span (Set.range g)
  let T := Localization.Away (algebraMap R (Q ⧸ I) π)
  let a : Q →ₐ[R] T :=
    (Algebra.algHom R (Q ⧸ I) T).comp (Ideal.Quotient.mkₐ R I)
  have hJ : J ≤ RingHom.ker a.toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change a (g j) = 0
    have hrel : a (aeval (R := R) ξ (P.relation (Fin.castLE hc j))) = 0 := by
      change algebraMap (Q ⧸ I) T (Ideal.Quotient.mk I _) = 0
      have hmem : aeval (R := R) ξ (P.relation (Fin.castLE hc j)) ∈ I :=
        Ideal.subset_span ⟨Fin.castLE hc j, rfl⟩
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
    have hunit : IsUnit (a (C π)) := by
      change IsUnit (a (algebraMap R Q π))
      rw [a.commutes, IsScalarTower.algebraMap_apply R (Q ⧸ I) T]
      exact IsLocalization.Away.algebraMap_isUnit (algebraMap R (Q ⧸ I) π)
    rw [hg j, map_mul, map_pow] at hrel
    exact (hunit.pow 3).mul_left_cancel (hrel.trans (mul_zero _).symm)
  obtain ⟨e₁⟩ := remove_redundant_localized_relations π I J hJ
  let t : Fin n → MvPolynomial (Fin c) R := fun i ↦
    C π ^ 2 * ∑ k, C (s i k) * X k
  have hξ : (fun i ↦ rename (fun k ↦ ULift.up (Sum.inl k)) (t i) +
      C π ^ 3 * X (ULift.up (Sum.inr i))) = ξ := by
    funext i
    simp [t, ξ]
  have he₂ := localized_affine_presentation_quotient_equiv R A π n m c 3 P t
  dsimp only at he₂
  rw [hξ] at he₂
  obtain ⟨e₂⟩ := he₂
  exact ⟨e₁.trans e₂⟩

end Algebra
