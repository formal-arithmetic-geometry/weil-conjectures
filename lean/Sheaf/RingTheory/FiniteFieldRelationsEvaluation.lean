module

public import Sheaf.Paper.FiniteFieldFiber
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Ideal.Basic
import Mathlib.Combinatorics.Nullstellensatz
import Mathlib.FieldTheory.Finite.Polynomial

/-!
# Evaluation of finite-field polynomial relations

Source: blueprint main-20261015, `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation).

The auxiliary definitions name the ideals, solution set and algebra maps in that step.
Both quotient equivalences below are characterized on every polynomial representative.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace WeilConjectures

/-- The ideal generated by the coordinate equations `t_i ^ (q ^ m) - t_i`.
Source: blueprint Frobenius fixed points proof, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
noncomputable def finiteFieldRelationsIdeal (D : FiniteFieldDatum.{u}) (m r : ℕ) :
    Ideal (MvPolynomial (Fin r) D.k) :=
  Ideal.span (Set.range fun i : Fin r ↦
    (MvPolynomial.X i : MvPolynomial (Fin r) D.k) ^ (D.q ^ m) - MvPolynomial.X i)

/-- Extension of the model relations along the specified base-field inclusion.
Source: blueprint Frobenius fixed points proof, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
noncomputable def finiteFieldRelationsExtendedIdeal (D : FiniteFieldDatum.{u}) (r : ℕ)
    (a : Ideal (MvPolynomial (Fin r) D.k₀)) : Ideal (MvPolynomial (Fin r) D.k) :=
  Ideal.map (MvPolynomial.map (algebraMap D.k₀ D.k)) a

/-- The tuples in the specified finite subfield at which all model relations vanish.
Source: blueprint Frobenius fixed points proof, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
noncomputable def finiteFieldRelationsSolutions (D : FiniteFieldDatum.{u}) (m : ℕ) (hm : 1 ≤ m)
    (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) :
    Set (Fin r → D.extensionSubfield m hm) :=
  {x | ∀ f ∈ a, MvPolynomial.eval₂ (D.extensionEmbedding m hm) x f = 0}

/-- The coordinate ideal generated by evaluations of all model relations in `k`.
Source: blueprint Frobenius fixed points proof, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
noncomputable def finiteFieldRelationsCoordinateIdeal (D : FiniteFieldDatum.{u})
    (m : ℕ) (hm : 1 ≤ m) (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀))
    (x : Fin r → D.extensionSubfield m hm) : Ideal D.k :=
  Ideal.span {z | ∃ f ∈ a, MvPolynomial.eval₂ (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f = z}

/-- The actual `k₀`-algebra homomorphisms to the specified finite extension, equipped
with exactly the algebra structure given by `D.extensionEmbedding`.
Source: blueprint Frobenius fixed points proof, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
abbrev FiniteFieldRelationsPointMaps (D : FiniteFieldDatum.{u}) (m : ℕ) (hm : 1 ≤ m)
    (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) : Type u :=
  @AlgHom D.k₀ (MvPolynomial (Fin r) D.k₀ ⧸ a) (D.extensionSubfield m hm)
    _ _ _ _ (D.extensionEmbedding m hm).toAlgebra

private theorem subfield_grid_product {K : Type u} [Field K] (E : Subfield K)
    [Fintype E] {r : ℕ} (i : Fin r) :
    (∏ c : E, (MvPolynomial.X i - MvPolynomial.C c.val)) =
      (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E - MvPolynomial.X i := by
  classical
  have hmon : (Polynomial.X ^ Fintype.card E - Polynomial.X : Polynomial E).Monic :=
    Polynomial.monic_X_pow_sub (by simpa using Fintype.one_lt_card (α := E))
  have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmon
    (by simp [FiniteField.roots_X_pow_card_sub_X,
      FiniteField.X_pow_card_sub_X_natDegree_eq E Fintype.one_lt_card])
  rw [FiniteField.roots_X_pow_card_sub_X] at hprod
  have h := congrArg
    (Polynomial.eval₂RingHom (MvPolynomial.C.comp E.subtype) (MvPolynomial.X i)) hprod
  simpa using h

private theorem subfield_grid_surjective {K : Type u} [Field K] (E : Subfield K)
    [Finite E] (r : ℕ) : Function.Surjective
      (fun f : MvPolynomial (Fin r) K ↦ fun x : Fin r → E ↦
        MvPolynomial.eval (fun i ↦ (x i).val) f) := by
  classical
  let _ : Fintype E := Fintype.ofFinite E
  have heval (x y : Fin r → E) :
      MvPolynomial.eval (fun i ↦ (y i).val)
          (MvPolynomial.map E.subtype (MvPolynomial.indicator x)) =
        if y = x then 1 else 0 := by
    change MvPolynomial.eval (E.subtype ∘ y)
      (MvPolynomial.map E.subtype (MvPolynomial.indicator x)) = _
    rw [← MvPolynomial.map_eval]
    by_cases h : y = x
    · subst y
      simp [MvPolynomial.eval_indicator_apply_eq_one]
    · simp [h, MvPolynomial.eval_indicator_apply_eq_zero y x h]
  intro z
  refine ⟨∑ x : Fin r → E, MvPolynomial.C (z x) *
    MvPolynomial.map E.subtype (MvPolynomial.indicator x), ?_⟩
  funext y
  simp [heval]

private theorem subfield_grid_kernel {K : Type u} [Field K] (E : Subfield K)
    [Fintype E] (r : ℕ) (f : MvPolynomial (Fin r) K) :
    (∀ x : Fin r → E, MvPolynomial.eval (fun i ↦ (x i).val) f = 0) ↔
      f ∈ Ideal.span (Set.range fun i : Fin r ↦
        (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E -
          MvPolynomial.X i) := by
  classical
  let S : Finset K := Finset.univ.map (⟨Subtype.val, Subtype.val_injective⟩ : E ↪ K)
  have hS : ∀ x : K, x ∈ S ↔ x ∈ E := by simp [S]
  have hprod (i : Fin r) :
      (∏ c ∈ S, (MvPolynomial.X i - MvPolynomial.C c)) =
        (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E -
          MvPolynomial.X i := by
    simpa [S] using subfield_grid_product E i
  constructor
  · intro hf
    obtain ⟨h, _, hh⟩ := MvPolynomial.combinatorial_nullstellensatz_exists_linearCombination
      (fun _ : Fin r ↦ S) (fun _ ↦ ⟨0, (hS 0).2 E.zero_mem⟩) f
      (fun x hx ↦ by simpa using hf (fun i ↦ ⟨x i, (hS _).1 (hx i)⟩))
    simp_rw [hprod] at hh
    rw [hh, Finsupp.linearCombination_apply, Finsupp.sum]
    exact Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _
      (Ideal.subset_span (Set.mem_range_self i))
  · intro hf x
    have hle : Ideal.span (Set.range fun i : Fin r ↦
        (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E -
          MvPolynomial.X i) ≤ RingHom.ker (MvPolynomial.eval (fun i ↦ (x i).val)) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      have h := congrArg E.subtype (FiniteField.pow_card (x i))
      simpa [RingHom.mem_ker, sub_eq_zero] using h
    exact hle hf

/-- Evaluation gives the two quotient algebra isomorphisms, sends the extended relation
ideal to the product of its coordinate ideals, and identifies the surviving factors
with the model's finite-extension-valued points. The last formula specifies scalar
extension on pure tensors, represented by `C c * map (algebraMap k₀ k) f`.

Source: blueprint main-20261015, `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation).

Proof plan:
1. Factor `X ^ (q ^ m) - X` using `lem-weil-alg-closed-linear-factorization`.
   Its roots are simple by `lem-weil-frobenius-polynomial-simple-roots` and are
   exactly the specified finite subfield by `lem-weil-unique-subfield-of-closure`.
2. Evaluation kills the coordinate ideal by `lem-weil-finite-field-pow-card`.
   Conversely `lem-trf-grid-vanishing-linear-combination` writes every polynomial
   vanishing on the grid as a sum of multiples of these coordinate equations.
3. Products of univariate Lagrange polynomials evaluate to the coordinate delta
   functions. Summing their scalar multiples proves surjectivity, hence the first
   equivalence, with the displayed evaluation formula.
4. In the finite product, the ideal generated by evaluated relations is precisely
   the product of the coordinate ideals: multiply relations by delta functions
   to isolate each coordinate, then sum the finitely many coordinate expressions.
5. At a solution the coordinate ideal is zero; otherwise one nonzero evaluated
   relation generates the unit ideal. Restriction to solutions has this ideal as
   kernel, giving the second equivalence and its evaluation formula.
6. The solution set is finite, as a subset of a finite grid. The polynomial universal
   property `def-weil-pbc-mv-polynomial-ring` identifies solutions with algebra maps
   from the model quotient, by the values on coordinate classes.
7. Scalar extension sends `f ⊗ c` to `c * φ(f)`, exactly the factor projection on
   the displayed representatives. For zero variables the grid is the singleton empty
   tuple and the interpolation product is one. For no solutions the quotient is the
   zero algebra, the empty product; none of the arguments assumes a nonzero quotient. -/
theorem finiteFieldRelationsEvaluation (D : FiniteFieldDatum.{u}) (m : ℕ) (hm : 1 ≤ m)
    (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) :
    ∃ e₁ : (MvPolynomial (Fin r) D.k ⧸ finiteFieldRelationsIdeal D m r) ≃ₐ[D.k]
        ((Fin r → D.extensionSubfield m hm) → D.k),
    ∃ e₂ : (MvPolynomial (Fin r) D.k ⧸
        (finiteFieldRelationsExtendedIdeal D r a ⊔ finiteFieldRelationsIdeal D m r)) ≃ₐ[D.k]
        (finiteFieldRelationsSolutions D m hm r a → D.k),
    ∃ points : finiteFieldRelationsSolutions D m hm r a ≃
        FiniteFieldRelationsPointMaps D m hm r a,
      (∀ (f : MvPolynomial (Fin r) D.k) (x : Fin r → D.extensionSubfield m hm),
        e₁ (Ideal.Quotient.mk (finiteFieldRelationsIdeal D m r) f) x =
          MvPolynomial.eval (fun i ↦ (x i).val) f) ∧
      (∀ (f : MvPolynomial (Fin r) D.k) (x : finiteFieldRelationsSolutions D m hm r a),
        e₂ (Ideal.Quotient.mk
          (finiteFieldRelationsExtendedIdeal D r a ⊔ finiteFieldRelationsIdeal D m r) f) x =
          MvPolynomial.eval (fun i ↦ (x.val i).val) f) ∧
      Ideal.map (e₁.toRingHom.comp (Ideal.Quotient.mk (finiteFieldRelationsIdeal D m r)))
        (finiteFieldRelationsExtendedIdeal D r a) =
          Ideal.pi (finiteFieldRelationsCoordinateIdeal D m hm r a) ∧
      (∀ x ∈ finiteFieldRelationsSolutions D m hm r a,
        finiteFieldRelationsCoordinateIdeal D m hm r a x = ⊥) ∧
      (∀ x ∉ finiteFieldRelationsSolutions D m hm r a,
        finiteFieldRelationsCoordinateIdeal D m hm r a x = ⊤) ∧
      (finiteFieldRelationsSolutions D m hm r a).Finite ∧
      (∀ (x : finiteFieldRelationsSolutions D m hm r a) (i : Fin r),
        points x (Ideal.Quotient.mk a (MvPolynomial.X i)) = x.val i) ∧
      (∀ (x : finiteFieldRelationsSolutions D m hm r a) (f : MvPolynomial (Fin r) D.k₀)
          (c : D.k),
        e₂ (Ideal.Quotient.mk
          (finiteFieldRelationsExtendedIdeal D r a ⊔ finiteFieldRelationsIdeal D m r)
          (MvPolynomial.C c * MvPolynomial.map (algebraMap D.k₀ D.k) f)) x =
          c * (D.extensionSubfield m hm).subtype (points x (Ideal.Quotient.mk a f))) := by
  classical
  let E := D.extensionSubfield m hm
  let ι := D.extensionEmbedding m hm
  have hspec := (FiniteField.exists_unique_subfield_of_closure D.p D.a D.q D.prime
    D.exponent_pos D.cardinality_eq D.k₀ D.card_base D.k m hm).choose_spec
  have hcard : Nat.card E = D.q ^ m := hspec.2.1
  have hι : E.subtype.comp ι = algebraMap D.k₀ D.k := hspec.2.2.2.2.2.2.choose_spec
  have hqpos : 0 < D.q := by
    rw [D.cardinality_eq]
    exact pow_pos D.prime.pos _
  have : Finite E := (Nat.card_pos_iff.mp (by rw [hcard]; exact pow_pos hqpos m)).2
  let _ : Fintype E := Fintype.ofFinite E
  have hc : Fintype.card E = D.q ^ m := by rwa [← Nat.card_eq_fintype_card]
  let T := Fin r → E
  let P := MvPolynomial (Fin r) D.k
  let J := finiteFieldRelationsIdeal D m r
  let A := finiteFieldRelationsExtendedIdeal D r a
  let S := finiteFieldRelationsSolutions D m hm r a
  let L := finiteFieldRelationsCoordinateIdeal D m hm r a
  let v : P →ₐ[D.k] (T → D.k) :=
    AlgHom.pi (fun x ↦ MvPolynomial.aeval (fun i ↦ (x i).val))
  have hv (f : P) (x : T) : v f x = MvPolynomial.eval (fun i ↦ (x i).val) f := rfl
  have hsurj : Function.Surjective v := subfield_grid_surjective E r
  have hker : RingHom.ker v = J := by
    ext f
    change v f = 0 ↔ f ∈ J
    rw [funext_iff]
    simpa only [hv, Pi.zero_apply, J, finiteFieldRelationsIdeal, ← hc] using
      subfield_grid_kernel E r f
  let e₁ : (P ⧸ J) ≃ₐ[D.k] (T → D.k) :=
    (Ideal.quotientEquivAlgOfEq D.k hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  have he₁ (f : P) : e₁ (Ideal.Quotient.mk J f) = v f := by
    exact Ideal.quotientKerAlgEquivOfSurjective_mk hsurj f
  have hval (x : T) (f : MvPolynomial (Fin r) D.k₀) :
      E.subtype (MvPolynomial.eval₂ ι x f) =
        MvPolynomial.eval₂ (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f := by
    rw [MvPolynomial.eval₂_comp_left, hι]
    rfl
  have hcoord (x : T) :
      Ideal.map (Pi.evalRingHom (fun _ : T ↦ D.k) x) (Ideal.map v.toRingHom A) = L x := by
    rw [Ideal.map_map]
    change Ideal.map _ (Ideal.map _ a) = _
    rw [Ideal.map_map]
    have heq :
        (Pi.evalRingHom (fun _ : T ↦ D.k) x).comp
            (v.toRingHom.comp (MvPolynomial.map (algebraMap D.k₀ D.k))) =
          MvPolynomial.eval₂Hom (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) := by
      apply RingHom.ext
      intro f
      exact MvPolynomial.eval_map (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f
    rw [RingHom.comp_assoc, heq]
    rfl
  have hmap : Ideal.map v.toRingHom A = Ideal.pi L := by
    have h := (Ideal.piOrderIso (R := fun _ : T ↦ D.k)).symm_apply_apply
      (Ideal.map v.toRingHom A)
    change Ideal.pi (fun x ↦ Ideal.map (Pi.evalRingHom (fun _ : T ↦ D.k) x)
      (Ideal.map v.toRingHom A)) = _ at h
    simpa only [hcoord] using h.symm
  have hbot (x : T) (hx : x ∈ S) : L x = ⊥ := by
    apply le_antisymm _ bot_le
    apply Ideal.span_le.mpr
    rintro z ⟨f, hf, rfl⟩
    change MvPolynomial.eval₂ (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f = 0
    rw [← hval, hx f hf, map_zero]
  have htop (x : T) (hx : x ∉ S) : L x = ⊤ := by
    have hn : ∃ f ∈ a, MvPolynomial.eval₂ ι x f ≠ 0 := by
      change ¬ ∀ f ∈ a, MvPolynomial.eval₂ ι x f = 0 at hx
      push Not at hx
      exact hx
    obtain ⟨f, hf, hnf⟩ := hn
    have hne : MvPolynomial.eval₂ (algebraMap D.k₀ D.k)
        (fun i ↦ (x i).val) f ≠ 0 := by
      rw [← hval]
      exact (map_ne_zero E.subtype).mpr hnf
    exact Ideal.eq_top_of_isUnit_mem _
      (Ideal.subset_span ⟨f, hf, rfl⟩) (isUnit_iff_ne_zero.mpr hne)
  let ρ : (T → D.k) →ₐ[D.k] (S → D.k) :=
    AlgHom.pi (fun x ↦ Pi.evalAlgHom D.k (fun _ : T ↦ D.k) x.val)
  have hρsurj : Function.Surjective ρ := by
    intro z
    refine ⟨fun x ↦ if hx : x ∈ S then z ⟨x, hx⟩ else 0, ?_⟩
    ext x
    simp [ρ, x.property]
  have hρker : RingHom.ker ρ = Ideal.pi L := by
    ext z
    change (fun x : S ↦ z x.val) = 0 ↔ ∀ x, z x ∈ L x
    rw [funext_iff]
    constructor
    · intro hz x
      by_cases hx : x ∈ S
      · simpa only [hbot x hx, Ideal.mem_bot, Pi.zero_apply] using hz ⟨x, hx⟩
      · rw [htop x hx]
        exact Submodule.mem_top
    · intro hz x
      simpa only [hbot x.val x.property, Ideal.mem_bot, Pi.zero_apply] using hz x.val
  let w : P →ₐ[D.k] (S → D.k) := ρ.comp v
  have hwsurj : Function.Surjective w := hρsurj.comp hsurj
  have hwker : RingHom.ker w = A ⊔ J := by
    change Ideal.comap v.toRingHom (RingHom.ker ρ) = _
    rw [hρker, ← hmap, Ideal.comap_map_of_surjective v.toRingHom hsurj,
      ← RingHom.ker_eq_comap_bot]
    exact congrArg (A ⊔ ·) hker
  let e₂ : (P ⧸ (A ⊔ J)) ≃ₐ[D.k] (S → D.k) :=
    (Ideal.quotientEquivAlgOfEq D.k hwker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hwsurj)
  have he₂ (f : P) : e₂ (Ideal.Quotient.mk (A ⊔ J) f) = w f := by
    exact Ideal.quotientKerAlgEquivOfSurjective_mk hwsurj f
  let _ : Algebra D.k₀ E := ι.toAlgebra
  let point (x : S) : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E :=
    Ideal.Quotient.liftₐ a (MvPolynomial.aeval x.val) x.property
  let tuple (φ : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E) : T :=
    fun i ↦ φ (Ideal.Quotient.mk a (MvPolynomial.X i))
  have htuple (φ : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E)
      (f : MvPolynomial (Fin r) D.k₀) :
      MvPolynomial.eval₂ ι (tuple φ) f = φ (Ideal.Quotient.mk a f) := by
    have heq : MvPolynomial.aeval (tuple φ) = φ.comp (Ideal.Quotient.mkₐ D.k₀ a) := by
      ext i
      simp only [MvPolynomial.aeval_X]
      rfl
    exact AlgHom.congr_fun heq f
  let back (φ : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E) : S :=
    ⟨tuple φ, fun f hf ↦ by rw [htuple, Ideal.Quotient.eq_zero_iff_mem.mpr hf, map_zero]⟩
  let points : S ≃ FiniteFieldRelationsPointMaps D m hm r a :=
    { toFun := point
      invFun := back
      left_inv := fun x ↦ by
        apply Subtype.ext
        funext i
        exact MvPolynomial.eval₂_X ι x.val i
      right_inv := fun φ ↦ by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro i
        change MvPolynomial.eval₂ ι (tuple φ) (MvPolynomial.X i) = _
        exact htuple φ (MvPolynomial.X i) }
  refine ⟨e₁, e₂, points, ?_, ?_, ?_, hbot, htop, Set.toFinite S, ?_, ?_⟩
  · intro f x
    exact congrFun (he₁ f) x
  · intro f x
    exact congrFun (he₂ f) x
  · have heq : e₁.toRingHom.comp (Ideal.Quotient.mk J) = v.toRingHom :=
      RingHom.ext he₁
    rw [heq]
    exact hmap
  · intro x i
    exact MvPolynomial.eval₂_X ι x.val i
  · intro x f c
    rw [he₂]
    change MvPolynomial.eval (fun i ↦ (x.val i).val)
      (MvPolynomial.C c * MvPolynomial.map (algebraMap D.k₀ D.k) f) =
        c * E.subtype (MvPolynomial.eval₂ ι x.val f)
    rw [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_map, hval]

end WeilConjectures
