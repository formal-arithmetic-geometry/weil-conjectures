module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.LocalRing.Module
import WeilConjectures.RingTheory.RegularLocalGeneratorsRegularSequence

/-!
# Regularity and cotangent spaces of tame local fixed quotients

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, VI Proposition 4.2, pp.76--77,
and VIII Lemma 4.2.3, p.119 (blueprint: lem-per-tame-fixed-local-regularity).

The quotient cotangent space is bundled over the original residue field, using the
canonical quotient map on scalars. No coefficient field in the local ring is chosen.
The canonical cotangent surjection and its induced isomorphism are characterized on
all representatives, so their existential presentation leaves no freedom in either map.
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace IsLocalRing

section Definitions

variable (R : Type u) [CommRing R] [IsLocalRing R]
variable (H : Type v) [Group H] (σ : H →* (R ≃+* R))

/-- The ideal of the fixed subscheme, generated by all `σ h a - a`.
Source: Travaux de Gabber, VI Proposition 4.2, pp.76--77
(blueprint: lem-per-tame-fixed-local-regularity). -/
def fixedActionIdeal : Ideal R :=
  Ideal.span (Set.range fun ha : H × R ↦ σ ha.1 ha.2 - ha.2)

/-- The subspace `D_H` in the cotangent space. We take differences on representatives
in the maximal ideal. Since every cotangent vector has such a representative, this
is exactly the span of `h(v) - v` for the induced action, when the residue action is
trivial. Ring automorphisms preserve the maximal ideal automatically.
Source: Travaux de Gabber, VI Proposition 4.2 and VIII Lemma 4.2.3, p.119
(blueprint: lem-per-tame-fixed-local-regularity). -/
noncomputable def fixedActionCotangentRelations : Submodule (ResidueField R) (CotangentSpace R) :=
  Submodule.span (ResidueField R)
    (Set.range fun hx : H × maximalIdeal R ↦
      (maximalIdeal R).toCotangent
        ⟨σ hx.1 hx.2, fun hu ↦ hx.2.property ((MulEquiv.isUnit_map (σ hx.1)).mp hu)⟩ -
      (maximalIdeal R).toCotangent hx.2)

/-- The actual quotient cotangent space `(m/I_H)/(m/I_H)^2`, bundled as a vector
space over `k = R/m`. Its scalar structure is restriction along the canonical map
`R/m → (R/I_H)/(m/I_H)`, constructed by `Ideal.quotientMap`; its additive group
is Mathlib's cotangent module of the image of `m` in `R/I_H`.
Source: Travaux de Gabber, VI Proposition 4.2 and VIII Lemma 4.2.3, p.119
(blueprint: lem-per-tame-fixed-local-regularity). -/
noncomputable def fixedActionQuotientCotangent : ModuleCat.{u} (ResidueField R) :=
  @ModuleCat.of (ResidueField R) _
    ((maximalIdeal R).map (Ideal.Quotient.mk (fixedActionIdeal R H σ))).Cotangent _
    (Module.compHom _
      (Ideal.quotientMap
        ((maximalIdeal R).map (Ideal.Quotient.mk (fixedActionIdeal R H σ)))
        (Ideal.Quotient.mk (fixedActionIdeal R H σ)) Ideal.le_comap_map))

end Definitions
/-- A tame finite local action has a regular fixed quotient and the expected
coinvariant cotangent space. The formula on every `x : maximalIdeal R` specifies
exactly the canonical surjection; the final formula specifies its quotient isomorphism.
Source: Travaux de Gabber, VI Proposition 4.2, pp.76--77, and VIII Lemma 4.2.3, p.119
(blueprint: lem-per-tame-fixed-local-regularity).

Proof: put `I = I_H`, `n = |H|`. Triviality of the residue action gives `I ≤ m`,
and invertibility of `n` in the residue field makes it a unit of `R`. Average by
`E(a) = n⁻¹ ∑ h, σ h a`. Reindexing gives `gE = E = Eg`, `E² = E`, and linearity
over invariant elements. Since `a - E(a) ∈ m`, all generators of `I` can be taken
with arguments in `m`; both `I` and `mI` are stable. For `u,v ∈ m`, expand
`g(uv) - uv = g(u)(g(v)-v) + (g(u)-u)v` to obtain `g(y)-y ∈ mI` for `y ∈ m²`.
For a generator `a(g(b)-b)` of `I`, replacing `a` by `E(a)` modulo `mI` shows
`E(I) ⊆ mI`. Hence `I ∩ m² = mI`. Thus `I/mI → m/m²` is injective with image
precisely the residue-field span of the differences, namely `D_H`.

By `lem-weil-pbc-regular-local-cotangent-dimension`, choose a basis of `D_H` and
extend it to one of `m/m²`, of dimension `dim R`. Lift the first basis elements to
`I` and the remaining ones to `m`. Noetherianity and
`lem-weil-pbc-nakayama-local-generators` show that the first lifts generate `I`
and all lifts generate `m`. Apply
`lem-weil-pbc-regular-local-generators-regular-sequence` to obtain regularity of
`R/I`, including empty parameter lists. Finally the image ideal is `m/I`, and
`(m/I)² = (m²+I)/I`. The representative map on cotangent spaces is surjective
with kernel the image of `I`, namely `D_H`. The first isomorphism theorem gives
the displayed isomorphism, with its specified value on every cotangent class. -/
theorem tame_fixed_local_regularity
    (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (H : Type v) [Group H] [Finite H] (σ : H →* (R ≃+* R))
    (hres : ∀ (h : H) (a : R), residue R (σ h a) = residue R a)
    (htame : IsUnit (Nat.card H : ResidueField R)) :
    fixedActionIdeal R H σ ≤ maximalIdeal R ∧
      IsRegularLocalRing (R ⧸ fixedActionIdeal R H σ) ∧
      ∃ f : CotangentSpace R →ₗ[ResidueField R] fixedActionQuotientCotangent R H σ,
        (∀ x : maximalIdeal R,
          f ((maximalIdeal R).toCotangent x) =
            ((maximalIdeal R).map (Ideal.Quotient.mk (fixedActionIdeal R H σ))).toCotangent
              ⟨Ideal.Quotient.mk (fixedActionIdeal R H σ) x,
                Ideal.mem_map_of_mem _ x.property⟩) ∧
        Function.Surjective f ∧
        LinearMap.ker f = fixedActionCotangentRelations R H σ ∧
        ∃ e : (CotangentSpace R ⧸ fixedActionCotangentRelations R H σ) ≃ₗ[ResidueField R]
            fixedActionQuotientCotangent R H σ,
          ∀ v : CotangentSpace R, e (Submodule.Quotient.mk v) = f v := by
  sorry

end IsLocalRing
