module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.Topology.Constructions

/-!
# Spectra and principal localizations of ring fibre products

Source: Stacks Project, More on Algebra, Tags 0B7J and 01Z8
(blueprint: lem-sfb-ring-fibre-product-spectrum).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits

namespace CommRingCat

/-- The canonical map of principal localizations with a specified target denominator.
Source: Stacks, Tag 01Z8 (blueprint: lem-sfb-ring-fibre-product-spectrum). -/
noncomputable def awayMapTo {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (r : R) (s : S) (h : f r = s) :
    Localization.Away r →+* Localization.Away s :=
  (RingEquiv.cast (R := fun x : S ↦ Localization.Away x) h).toRingHom.comp
    (Localization.awayMap f r)

/-- The pullback of the two principal localizations at the coordinates of `h`.
The second map uses the equality carried by `h` to choose the common denominator.
Source: Stacks, Tag 01Z8 (blueprint: lem-sfb-ring-fibre-product-spectrum). -/
noncomputable def principalFibreProduct {A D E : CommRingCat.{u}}
    (α : A ⟶ D) (β : E ⟶ D) (h : (pullbackCone α β).pt) :
    PullbackCone
      (ofHom (Localization.awayMap α.hom h.val.1))
      (ofHom (awayMapTo β.hom h.val.2 (α.hom h.val.1) h.property.symm)) :=
  pullbackCone _ _

/-- The generating identifications in the disjoint union of the two prime spectra.
`Quot` automatically takes the equivalence relation generated by these pairs, with
its quotient topology.
Source: Stacks, Tag 0B7J (blueprint: lem-sfb-ring-fibre-product-spectrum). -/
def fibreProductSpectrumRelation {A D E : CommRingCat.{u}}
    (α : A ⟶ D) (β : E ⟶ D)
    (x y : PrimeSpectrum A ⊕ PrimeSpectrum E) : Prop :=
  ∃ z : PrimeSpectrum D,
    x = Sum.inl (PrimeSpectrum.comap α.hom z) ∧
    y = Sum.inr (PrimeSpectrum.comap β.hom z)

/-- The spectrum is the quotient pushout, and the canonical principal localization
comparisons are isomorphisms compatible with further principal localization.

Source: Stacks Project, More on Algebra, Tags 0B7J and 01Z8
(blueprint: lem-sfb-ring-fibre-product-spectrum).

Proof:
1. By lem-sfb-fibre-product-spectrum-topology, the projection-induced spectral maps
   are jointly surjective and satisfy the topological pushout universal property.
   The quotient by the displayed generating pairs has the same universal property.
   The induced continuous maps in both directions are inverse, by joint surjectivity.
2. For h = (a,e), define the comparison on fractions by
   (x,y)/h^n ↦ (x/a^n,y/e^n). The equality of the two images in D_d makes this
   a point of the pullback. The localization fraction equality criterion shows
   independence of representatives and preservation of addition, multiplication and 1.
3. If the image vanishes, powers a^r and e^s kill the two numerators. Their maximum
   kills the pair, so the original fraction vanishes. Apply this to differences
   to obtain injectivity.
4. For a compatible pair of fractions, replace both denominators by the same power
   N. Their images agree after a further power d^L. Multiplying both numerators
   by the corresponding powers a^L and e^L gives an element of the original
   pullback; dividing by h^(N+L) gives the desired preimage.
5. Apply the same construction to the localized pullback and any element z of B_h.
   The resulting comparison sends fractions to their coordinate fractions. Thus
   its projection maps are the localizations of the projection maps composed with
   the first comparison, which is the asserted compatibility square. This includes
   z = t/h^r, not just images of elements of B. All zero rings and denominators
   are allowed: only multiplication by powers, never cancellation, was used. -/
theorem ringFibreProduct_spectrum_localization
    {A D E : CommRingCat.{u}} (α : A ⟶ D) (β : E ⟶ D)
    (hα : Function.Surjective α.hom) :
    (∃ e : Quot (fibreProductSpectrumRelation α β) ≃ₜ
        PrimeSpectrum (pullbackCone α β).pt,
      (∀ x : PrimeSpectrum A,
        e (Quot.mk _ (Sum.inl x)) = PrimeSpectrum.comap (pullbackCone α β).fst.hom x) ∧
      (∀ x : PrimeSpectrum E,
        e (Quot.mk _ (Sum.inr x)) = PrimeSpectrum.comap (pullbackCone α β).snd.hom x)) ∧
    (∃ e : ∀ h : (pullbackCone α β).pt,
        Localization.Away h ≃+* (principalFibreProduct α β h).pt,
      (∀ h : (pullbackCone α β).pt,
        (principalFibreProduct α β h).fst.hom.comp (e h).toRingHom =
          Localization.awayMap (pullbackCone α β).fst.hom h ∧
        (principalFibreProduct α β h).snd.hom.comp (e h).toRingHom =
          Localization.awayMap (pullbackCone α β).snd.hom h) ∧
      ∀ (h : (pullbackCone α β).pt) (z : Localization.Away h),
        ∃ ez : Localization.Away z ≃+*
            (principalFibreProduct
              (ofHom (Localization.awayMap α.hom h.val.1))
              (ofHom (awayMapTo β.hom h.val.2 (α.hom h.val.1) h.property.symm))
              (e h z)).pt,
          (principalFibreProduct
            (ofHom (Localization.awayMap α.hom h.val.1))
            (ofHom (awayMapTo β.hom h.val.2 (α.hom h.val.1) h.property.symm))
            (e h z)).fst.hom.comp ez.toRingHom =
              Localization.awayMap
                ((principalFibreProduct α β h).fst.hom.comp (e h).toRingHom) z ∧
          (principalFibreProduct
            (ofHom (Localization.awayMap α.hom h.val.1))
            (ofHom (awayMapTo β.hom h.val.2 (α.hom h.val.1) h.property.symm))
            (e h z)).snd.hom.comp ez.toRingHom =
              Localization.awayMap
                ((principalFibreProduct α β h).snd.hom.comp (e h).toRingHom) z) := by
  sorry

end CommRingCat
