/-!
# Geometric splitting of a separable quadratic completion

Source: Stacks Project, curves.tex, Tags 0C49 and 0C4D (lemma-nodal-algebraic and
lemma-nodal); varieties.tex, Tag 0C54 (lemma-base-change-complete-local-ring)
(blueprint: lem-trf-quadratic-completion-geometric-splitting).
-/

@[expose] public section

set_option autoImplicit false

universe u v w

open scoped TensorProduct

namespace Algebra

/-- A nondegenerate binary quadratic completed local ring splits over every geometric
point specified by a residue-field embedding.

At a maximal ideal, `p.ResidueField` is canonically `S / p`. The coefficient equation for
`e₀` gives the `F`-algebra structure through the chosen section `σ`, without installing a
second algebra instance. An equivalence of local rings preserves maximal ideals and their
powers, so its two directions are continuous for the maximal-ideal-adic topologies.
The constant-series equation for `e` similarly says exactly that it is an `Ω`-algebra
isomorphism for the structural action `c ↦ 1 ⊗ c`. The equation for `ρ` identifies the
residue field via evaluation, rather than via an unspecified field isomorphism.

Source: Stacks Project, curves.tex, Tags 0C49 and 0C4D, and varieties.tex, Tag 0C54
(blueprint: lem-trf-quadratic-completion-geometric-splitting).

Proof:
1. Apply `lem-trf-separable-evaluation-local-base-change` with `K = Ω` and `ι`.
   Evaluation is surjective, its kernel contracts to `p`, and its localized residue
   field is `Ω`. This proves the contraction and the assertion about `ρ`.
2. Invert `e₀` to obtain the chosen continuous power-series presentation with kernel
   generated by `a*u^2+b*u*v+c*v^2`. Its constant coefficients act through `σ`.
   Apply `lem-trf-field-extension-completion-presentation` with two variables and this
   single relation. The transported discriminant is nonzero because `ι` is injective.
3. Write the transported coefficients as `a₀,b₀,c₀`. If `a₀ = 0`, take the linear forms
   `v` and `b₀*u+c₀*v`; their determinant is `-b₀ ≠ 0`. Otherwise choose a root `r` of
   `a₀*T^2+b₀*T+c₀`, put `s = -b₀/a₀-r`, and take `u-r*v` and `a₀*(u-s*v)`.
   Their product is the transported quadratic, and their determinant `a₀*(r-s)` is
   nonzero since `a₀^2*(r-s)^2 = b₀^2-4*a₀*c₀`. No division by two is used.
4. By `lem-weil-pbc-power-series-field-cohen-regular-complete`, the power-series rings
   are complete. Apply `lem-weil-pbc-power-series-universal-property-complete` to the
   invertible linear matrix and its inverse. Uniqueness makes the substitutions
   mutually inverse; they preserve the variable ideals and their powers.
5. The substitutions send the product of the new variables to the quadratic and back,
   so descend to inverse maps of the quotients. Compose with the equivalence in step 2.
   They fix constants and preserve maximal ideals and their powers, giving the required
   complete local `Ω`-algebra equivalence, including in characteristic two.
-/
theorem quadratic_completion_geometric_splitting
    {k : Type u} {S : Type v} [Field k] [CommRing S] [Algebra k S]
    [Algebra.FiniteType k S] (p : Ideal S) [p.IsMaximal]
    [FiniteDimensional k p.ResidueField] [Algebra.IsSeparable k p.ResidueField]
    (σ : p.ResidueField →ₐ[k]
      AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime p))
        (Localization.AtPrime p))
    (hσ : ∀ d : p.ResidueField,
      AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal (Localization.AtPrime p)) (σ d) = d)
    (a b c : p.ResidueField) (hΔ : b ^ 2 - 4 * a * c ≠ 0)
    (e₀ : (MvPowerSeries (Fin 2) p.ResidueField ⧸ Ideal.span
        {MvPowerSeries.C a * MvPowerSeries.X 0 ^ 2 +
          MvPowerSeries.C b * MvPowerSeries.X 0 * MvPowerSeries.X 1 +
          MvPowerSeries.C c * MvPowerSeries.X 1 ^ 2}) ≃+*
      AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime p))
        (Localization.AtPrime p))
    (he₀ : ∀ d : p.ResidueField, e₀ (Ideal.Quotient.mk _ (MvPowerSeries.C d)) = σ d)
    (Ω : Type w) [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (ι : p.ResidueField →ₐ[k] Ω)
    (q : Ideal (S ⊗[k] Ω)) [q.IsPrime]
    (hq : q = RingHom.ker
      (Algebra.TensorProduct.lift
        (ι.comp (IsScalarTower.toAlgHom k S p.ResidueField)) (AlgHom.id k Ω)
        (fun _ _ ↦ Commute.all _ _)).toRingHom) :
    q.comap (Algebra.TensorProduct.includeLeft : S →ₐ[k] S ⊗[k] Ω).toRingHom = p ∧
    (∃ ρ : q.ResidueField ≃+* Ω,
      ∀ d : Ω, ρ (algebraMap (S ⊗[k] Ω) q.ResidueField ((1 : S) ⊗ₜ[k] d)) = d) ∧
    ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime q))
        (Localization.AtPrime q) ≃+*
      (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span
        {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω) * MvPowerSeries.X 1}),
      (∀ d : Ω,
        e (algebraMap (Localization.AtPrime q)
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime q))
            (Localization.AtPrime q))
          (algebraMap (S ⊗[k] Ω) (Localization.AtPrime q) ((1 : S) ⊗ₜ[k] d))) =
        Ideal.Quotient.mk _ (MvPowerSeries.C d)) ∧
      ∃ (_ : IsLocalRing
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime q))
            (Localization.AtPrime q)))
        (_ : IsLocalRing (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span
          {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω) * MvPowerSeries.X 1})),
        IsLocalHom e.toRingHom ∧
        IsAdicComplete
          (IsLocalRing.maximalIdeal
            (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime q))
              (Localization.AtPrime q)))
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime q))
            (Localization.AtPrime q)) ∧
        IsAdicComplete
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span
            {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω) * MvPowerSeries.X 1}))
          (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span
            {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω) * MvPowerSeries.X 1}) := by
  sorry

end Algebra
