module

public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.Noetherian.Defs
import Sheaf.RingTheory.PowerSeriesCombinedIdealCoefficients

/-!
# Completeness of power series over a complete base

Source: literature/stacks-project/algebra.tex, used in Remark Tag 032C
(blueprint: lem-weil-pbc-power-series-complete-over-complete-base).
-/

@[expose] public section

universe u

/--
Power series over a Noetherian ring complete for an ideal are complete for the
ideal generated by that ideal and the variables.
Source: literature/stacks-project/algebra.tex, Remark Tag 032C
(blueprint: lem-weil-pbc-power-series-complete-over-complete-base).

Proof (the node's six steps; the general assertion is agent-formulated):
1. Write `a_E(F)` for the coefficient of exponent `E` and `|E|` for its total degree
   [def-weil-pbc-multivariate-power-series]. Let `S_n` consist of series with
   `a_E(F)` in `J^(n-|E|)` when `|E| < n`, and `U_n` of series with those coefficients
   zero. Both are ideals, `S_0 = U_0 = R`, and the finite Cauchy product gives
   `S_n * S_m ⊆ S_(n+m)` (interpret nonpositive powers of `J` as the whole ring).
2. The nth power of the variables ideal is `U_n`: one inclusion follows from the
   coefficients of monomials. For the reverse inclusion, group the terms of a series
   in `U_n` by a chosen degree-n monomial dividing each exponent. There are finitely
   many such monomials, giving a finite sum of their multiples.
3. Write `a = JR + (X_1, ..., X_d)`. Its generators belong to `S_1`, so `a^n ⊆ S_n`.
   Conversely split a series in `S_n` into its finite part of degree below n and
   its tail in `U_n`. Each low-degree term is in `a^n`, as its coefficient is in
   `J^(n-|E|)` and its monomial is in the `|E|`th power of the variables ideal;
   the tail is in `a^n` by step 2. Thus `a^n = S_n`, including n = 0.
4. If a series maps to zero in the inverse limit of `R/a^n`, its coefficient at E
   belongs to every `J^m` by taking `n = m + |E|`. Injectivity of the base completion
   map [def-weil-pbc-adically-complete-ring] makes every coefficient zero.
5. For a compatible family in `R/a^n`, choose representatives `F_n`. At each E,
   the coefficients of `F_(k+|E|)` modulo `J^k` form a compatible family. Base
   completeness [def-weil-pbc-adically-complete-ring] supplies a coefficient `b_E`.
   The series with coefficients `b_E` [def-weil-pbc-multivariate-power-series]
   differs from `F_n` by an element of `S_n = a^n`, so represents the given family.
6. The canonical completion map is therefore bijective, which is adic completeness
   [def-weil-pbc-adically-complete-ring]. Retain the node's Noetherian hypothesis,
   although the coefficient argument does not use it.
-/
theorem power_series_complete_over_complete_base
    (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ]
    (J : Ideal Λ) [IsAdicComplete J Λ] (d : ℕ) :
    IsAdicComplete
      (Ideal.map (algebraMap Λ (MvPowerSeries (Fin d) Λ)) J ⊔
        Ideal.span (Set.range (MvPowerSeries.X : Fin d → MvPowerSeries (Fin d) Λ)))
      (MvPowerSeries (Fin d) Λ) := by
  classical
  let a : Ideal (MvPowerSeries (Fin d) Λ) :=
    Ideal.map (algebraMap Λ (MvPowerSeries (Fin d) Λ)) J ⊔
      Ideal.span (Set.range (MvPowerSeries.X : Fin d → MvPowerSeries (Fin d) Λ))
  change IsAdicComplete a (MvPowerSeries (Fin d) Λ)
  have hcoeff (n : ℕ) (F G : MvPowerSeries (Fin d) Λ) :
      F ≡ G [SMOD (a ^ n • ⊤ : Ideal (MvPowerSeries (Fin d) Λ))] ↔
      ∀ E : Fin d →₀ ℕ, E.degree < n →
        MvPowerSeries.coeff E F ≡ MvPowerSeries.coeff E G
          [SMOD (J ^ (n - E.degree) • ⊤ : Ideal Λ)] := by
    simp only [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    rw [power_series_mem_combined_ideal_pow_iff Λ J d n]
    simp only [map_sub]
  refine { toIsHausdorff := ⟨?haus⟩, toIsPrecomplete := ⟨?prec⟩ }
  case haus =>
    intro F hF
    apply MvPowerSeries.ext
    intro E
    apply IsHausdorff.haus' (I := J)
    intro n
    have h := (hcoeff (n + E.degree + 1) F 0).mp (hF _)
    have hE := h E (by omega)
    have hexp : n + E.degree + 1 - E.degree = n + 1 := by omega
    rw [hexp] at hE
    exact SModEq.mono (Submodule.pow_smul_top_le J Λ (Nat.le_succ n)) hE
  case prec =>
    intro f hf
    have hlim (E : Fin d →₀ ℕ) : ∃ b : Λ, ∀ k : ℕ,
        MvPowerSeries.coeff E (f (k + E.degree + 1)) ≡ b [SMOD (J ^ k • ⊤ : Ideal Λ)] := by
      apply IsPrecomplete.prec' (I := J)
      intro m n hmn
      have h := (hcoeff (m + E.degree + 1) _ _).mp
        (hf (Nat.add_le_add_right (Nat.add_le_add_right hmn E.degree) 1))
      have hE := h E (by omega)
      have hexp : m + E.degree + 1 - E.degree = m + 1 := by omega
      rw [hexp] at hE
      exact SModEq.mono (Submodule.pow_smul_top_le J Λ (Nat.le_succ m)) hE
    choose b hb using hlim
    refine ⟨(b : MvPowerSeries (Fin d) Λ), ?_⟩
    intro n
    apply (hcoeff n _ _).mpr
    intro E hE
    have hstep := (hcoeff n _ _).mp
      (hf (show n ≤ (n - E.degree) + E.degree + 1 by omega))
    have hfirst := hstep E hE
    have hlast := hb E (n - E.degree)
    exact hfirst.trans hlast
