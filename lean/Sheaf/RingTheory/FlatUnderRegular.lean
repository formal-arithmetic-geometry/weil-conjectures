module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.RingHom.Flat
import WeilConjectures.Mathlib.RingTheory.Regular.ProjectiveDimension

/-!
# Regularity descends along flat local homomorphisms

Source: Stacks Project, Algebra, Lemma 10.110.9 (Tag 00OF)
(blueprint: lem-weil-pbc-flat-under-regular).
-/

@[expose] public section

universe u v

namespace IsRegularLocalRing

/-- If `φ : R → S` is a flat local homomorphism of Noetherian local rings and `S` is a regular
local ring, then `R` is a regular local ring.
Source: Stacks Project, Algebra, Lemma 10.110.9 (Tag 00OF)
(blueprint: lem-weil-pbc-flat-under-regular).

Proof: Let `κ` be the residue field of `R` and `d = dim S`, finite since `S` is Noetherian
local. As `R` is Noetherian, `κ` has a resolution by finite free modules `F_i`; let `K` be `κ`
if `d = 0` and the kernel of `F_{d-1} → F_{d-2}` otherwise, a finitely generated `R`-module
with `0 → K → F_{d-1} → ⋯ → F_0 → κ → 0` exact. Tensoring with the flat `R`-module `S` keeps
the sequence exact, with the `F_i ⊗ S` finite free over `S`. Since the regular local ring `S`
has global dimension `d` (Stacks 00O7), `K ⊗ S` is projective by independence of the
resolution (Stacks 00O5). As `φ` is flat and local and `K` is finite, `K` is finite free over
`R` (Stacks 00O1), so `κ` has finite projective dimension. Then `R` has finite global
dimension `D ≥ dim R` (Stacks 00OB), `D ≥ dim_κ 𝔪/𝔪²` (Stacks 00OA), and by Nakayama `𝔪`
is generated by `dim_κ 𝔪/𝔪²` elements; so `𝔪` is generated by `dim R` elements and `R` is
regular (Serre, Stacks 00OC). The source declaration `IsRegularLocalRing.of_flat` proves the
same statement for an algebra structure with both rings in one universe. -/
theorem of_ringHom_flat {R : Type u} {S : Type v} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsNoetherianRing R] [IsRegularLocalRing S] (φ : R →+* S) [IsLocalHom φ] (hφ : φ.Flat) :
    IsRegularLocalRing R := by
  let φ' : ULift.{v} R →+* ULift.{u} S := φ.ulift
  let : IsLocalRing (ULift.{v} R) := ULift.ringEquiv.symm.isLocalRing
  let : IsNoetherianRing (ULift.{v} R) :=
    isNoetherianRing_of_ringEquiv R ULift.ringEquiv.symm
  let : IsRegularLocalRing (ULift.{u} S) := of_ringEquiv ULift.ringEquiv.symm
  let : Algebra (ULift.{v} R) (ULift.{u} S) := φ'.toAlgebra
  have : IsLocalHom φ' := by
    dsimp [φ', RingHom.ulift]
    infer_instance
  have : IsLocalHom (algebraMap (ULift.{v} R) (ULift.{u} S)) := ‹IsLocalHom φ'›
  have : Module.Flat (ULift.{v} R) (ULift.{u} S) :=
    (RingHom.Flat.ulift_iff).mpr hφ
  have : IsRegularLocalRing (ULift.{v} R) := of_flat (S := ULift.{u} S)
  exact of_ringEquiv ULift.ringEquiv

end IsRegularLocalRing
