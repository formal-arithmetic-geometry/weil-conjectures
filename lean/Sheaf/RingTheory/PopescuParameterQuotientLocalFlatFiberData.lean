/-! # Flatness and the closed fiber of the local parameter quotient

Source: Stacks Project, Smoothing Ring Maps, proof of Lemma 07FE, steps 10--11.
-/

@[expose] public section

universe u v w

namespace Algebra

private theorem origin_local_data
    {k : Type u} [Field k] (d : ℕ)
    (p : Ideal (MvPolynomial (Fin d) k)) [p.IsPrime]
    (hp : p = Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) k))) :
    IsRegularLocalRing (Localization.AtPrime p) ∧
      ringKrullDim (Localization.AtPrime p) = (d : WithBot ℕ∞) ∧
      Ideal.span (Set.range (fun i : Fin d ↦
        algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime p) (MvPolynomial.X i))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
  obtain ⟨ho, _, hregular, hdim, _, hgen⟩ :=
    MvPolynomial.polynomial_origin_regularLocal k d
  subst p
  exact ⟨hregular, hdim, hgen.symm⟩

private theorem parameter_local_map_flat
    {k : Type u} {Λ : Type w} [Field k] [CommRing Λ] [Algebra k Λ]
    (d : ℕ) (φ : MvPolynomial (Fin d) k →ₐ[k] Λ)
    (q : PrimeSpectrum Λ) [IsNoetherianRing Λ]
    [IsRegularLocalRing (Localization.AtPrime q.asIdeal)]
    (hdim : ringKrullDim (Localization.AtPrime q.asIdeal) = (d : WithBot ℕ∞))
    (hgen : Ideal.span (Set.range (fun i : Fin d ↦
      algebraMap Λ (Localization.AtPrime q.asIdeal) (φ (MvPolynomial.X i)))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) :
    (Localization.localRingHom (q.asIdeal.comap φ.toRingHom) q.asIdeal
      φ.toRingHom rfl).Flat := by
  classical
  let P := MvPolynomial (Fin d) k
  let p : Ideal P := q.asIdeal.comap φ.toRingHom
  let o : Ideal P := Ideal.span (Set.range (MvPolynomial.X : Fin d → P))
  obtain ⟨ho, _⟩ :=
    MvPolynomial.polynomial_origin_regularLocal k d
  have hop : o ≤ p := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply (IsLocalization.AtPrime.to_map_mem_maximal_iff
      (Localization.AtPrime q.asIdeal) q.asIdeal _).mp
    rw [← hgen]
    exact Ideal.subset_span (Set.mem_range_self i)
  have hpo : p = o := (ho.eq_of_le (Ideal.comap_isPrime φ.toRingHom q.asIdeal).ne_top hop).symm
  obtain ⟨hregP, hdP, hgP⟩ := origin_local_data d p hpo
  let f := Localization.localRingHom p q.asIdeal φ.toRingHom rfl
  let xs : List (Localization.AtPrime p) := List.ofFn (fun i : Fin d ↦
    algebraMap P (Localization.AtPrime p) (MvPolynomial.X i))
  have hxs : Ideal.ofList xs = IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
    simpa [xs, Ideal.ofList, Set.range] using hgP
  have hys : Ideal.ofList (xs.map f) =
      IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal) := by
    simpa [xs, Ideal.ofList, f, List.map_ofFn,
      Localization.localRingHom_to_map, Set.range] using hgen
  have hlen : xs.length = d := by simp [xs]
  have hparameters : IsLocalRing.IsRegularSystemOfParameters (xs.map f) := by
    refine ⟨hys, ?_⟩
    simp only [List.length_map, hlen, hdim]
  have hsequence := (IsRegularLocalRing.isRegular_and_quotients_of_generators
    (Localization.AtPrime q.asIdeal) d hdim (xs.map f) hparameters).1
  exact RingHom.flat_of_regular_parameters f d xs hdP hlen hxs hsequence

/-- The reduced local map is flat and its closed fiber is ind-smooth over its residue base.

Source: Stacks Project, Smoothing Ring Maps, proof of Lemma 07FE, steps 10--11.
(blueprint: lem-weil-pbc-popescu-parameter-quotient-local-flat-fiber-data).

Proof: Write P=k[x_i], p=φ⁻¹(q), e=8c, and π_i=φ(x_i). Each π_i lies in q,
since its image in Λ_q belongs to the maximal ideal and that ideal contracts to q.
Thus p contains the origin ideal (x_i); the origin ideal is maximal with quotient k,
so p=(x_i). The d elements π_i generate the maximal ideal of the d-dimensional
regular local ring Λ_q and hence form a regular sequence. The polynomial-origin
localization P_p is regular of dimension d, generated by the x_i. Its local map to
Λ_q is therefore flat by the flat-over-regular criterion.

Compose P→P_p with the flat local map to get P→Λ_q flat. Quotient base change
makes Λ_q/JΛ_q flat over P/J. Localization of the quotient identifies this target
with L₀, compatibly as a P/J-algebra. Flatness over P/J is equivalent to flatness
over its localization R₀. Apply the localized quotient lemma and then
Module.Flat.ulift_right_iff to obtain flatness R₀→L.

The maximal ideal I of R₀ is generated by the images of x_i, and R₀/I is canonically
k by evaluation at zero. In L₀ the extended ideal IL₀ is generated by the π_i,
and the parameter-generation hypothesis identifies it with the image of the
maximal ideal of Λ_q. Thus L₀/IL₀ is canonically κ(q). Both residue identifications
send constants in k to their original images, so the induced residue-base map is
the given separable extension κ(q)/k. Apply the separable smooth-subalgebra colimit
theorem to that extension. Regard its subalgebras as R₀/I-algebras via R₀/I≃k;
their universal colimit property holds for algebra maps because their inclusions
commute with the constants. Lift their carriers and index category to max(u,v,w),
and use the ULift quotient equivalence L/IL≃L₀/IL₀ followed by the residue-field
identification to obtain the displayed ind-smooth presentation. For d=0 all
parameter ideals are zero; P=k, and hgen says Λ_q has zero maximal ideal, so the
same identifications and field argument apply. No source-algebra factorization
or Popescu resolution is asserted here. -/
theorem parameter_quotient_local_flat_fiber_data
    {k : Type u} {Λ : Type w}
    [Field k] [CommRing Λ] [Algebra k Λ]
    (d c : ℕ) (hc : 1 ≤ c) (φ : MvPolynomial (Fin d) k →ₐ[k] Λ)
    (q : PrimeSpectrum Λ) [IsNoetherianRing Λ]
    [IsRegularLocalRing (Localization.AtPrime q.asIdeal)]
    (hdim : ringKrullDim (Localization.AtPrime q.asIdeal) = (d : WithBot ℕ∞))
    (hgen : Ideal.span (Set.range (fun i : Fin d ↦
      algebraMap Λ (Localization.AtPrime q.asIdeal) (φ (MvPolynomial.X i)))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal))
    (hsep : IsSeparableExtension k q.asIdeal.ResidueField) :
    letI := φ.toRingHom.toAlgebra
    let J : Ideal (MvPolynomial (Fin d) k) :=
      Ideal.span (Set.range (fun i : Fin d ↦ (MvPolynomial.X i ^ c) ^ 8))
    let J_Λ := Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) J
    ∀ (q₀ : PrimeSpectrum (Λ ⧸ J_Λ)),
      PrimeSpectrum.comap (Ideal.Quotient.mk J_Λ) q₀ = q →
    letI := Localization.AtPrime.algebraOfLiesOver
      (q₀.asIdeal.under (MvPolynomial (Fin d) k ⧸ J)) q₀.asIdeal
    let R₀ := Localization.AtPrime (q₀.asIdeal.under (MvPolynomial (Fin d) k ⧸ J))
    let L₀ := Localization.AtPrime q₀.asIdeal
    let L := ULift.{max u v} L₀
    let I := IsLocalRing.maximalIdeal R₀
    RingHom.Flat (algebraMap R₀ L) ∧
      CategoryTheory.ObjectProperty.ind.{max u v w}
        (fun B : CommAlgCat.{max u v w} (R₀ ⧸ I) ↦ Smooth (R₀ ⧸ I) B)
        (CommAlgCat.of (R₀ ⧸ I) (L ⧸ I.map (algebraMap R₀ L))) := by
  let := φ.toRingHom.toAlgebra
  let J : Ideal (MvPolynomial (Fin d) k) :=
    Ideal.span (Set.range (fun i : Fin d ↦ (MvPolynomial.X i ^ c) ^ 8))
  let J_Λ := Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) J
  dsimp only
  intro q₀ hq₀
  subst q
  let q := PrimeSpectrum.comap (Ideal.Quotient.mk J_Λ) q₀
  obtain ⟨eR, eL, hcompat⟩ :=
    parameter_quotient_residue_ringEquivs.{u, v, w} d c hc φ q hgen q₀ rfl
  have hf := parameter_local_map_flat d φ q hdim hgen
  have hfquot := RingHom.flat_localized_quotient_of_flat_localRingHom J q₀ hf
  let := Localization.AtPrime.algebraOfLiesOver
    (q₀.asIdeal.under (MvPolynomial (Fin d) k ⧸ J)) q₀.asIdeal
  let R₀ := Localization.AtPrime (q₀.asIdeal.under (MvPolynomial (Fin d) k ⧸ J))
  let L₀ := Localization.AtPrime q₀.asIdeal
  have hfL : RingHom.Flat (algebraMap R₀ (ULift.{max u v} L₀)) := by
    apply RingHom.flat_algebraMap_iff.mpr
    exact (Module.Flat.ulift_right_iff).mpr (RingHom.flat_algebraMap_iff.mp hfquot)
  exact ⟨hfL, ind_smooth_of_separable_ringEquivs.{u, v, w} hsep eR eL hcompat⟩

end Algebra
