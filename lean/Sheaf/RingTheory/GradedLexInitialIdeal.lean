module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.Data.Finsupp.Lex

/-! # Least-monomial graded initial ideals

Source: the definition of the graded initial ideal in the generic-coordinate input recalled
in Bierstone--Milman 1997, §8 and before Theorem 9.6
(blueprint: def-trf-graded-lex-initial-ideal).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u

namespace MvPolynomial

/-- The ideal generated by the least lexicographic monomials of homogeneous members of `H`.
The support condition excludes the zero polynomial; coefficients of generators are normalized
to one. The order compares exponents starting at the smallest variable index.
Source: BM 1997, §8 and before Theorem 9.6, graded generic-coordinate convention
(blueprint: def-trf-graded-lex-initial-ideal). -/
def gradedLexInitialIdeal {n : ℕ} {L : Type u} [Field L]
    (H : Ideal (MvPolynomial (Fin n) L)) : Ideal (MvPolynomial (Fin n) L) :=
  Ideal.span ((fun α : Fin n →₀ ℕ ↦ monomial α (1 : L)) ''
    {α | ∃ (p : MvPolynomial (Fin n) L), p ∈ H ∧
      (∃ q : ℕ, p.IsHomogeneous q) ∧ α ∈ p.support ∧
      ∀ β ∈ p.support, toLex α ≤ toLex β})

end MvPolynomial
