module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.Algebra.MonoidAlgebra.Ideal
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.GroupTheory.Finiteness
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.LinearAlgebra.TensorProduct.Tower
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.AdicCompletion.AsTensorProduct
import Mathlib.RingTheory.Flat.Basic

/-!
# Monomial ideal tensors in completed monoid polynomial rings

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, VI 1.6(i)--(ii), p. 70,
and VIII 3.4.3, p. 110; the coefficient-basis and flat-completion algebra input
(blueprint: lem-trf-completed-monomial-ideal-tensor).

The coefficient factor is written first in each tensor, using the canonical tensor
symmetry. Thus `b ⊗ z^q` here is `z^q ⊗ b` in the node. This gives the standard
`B`-module structure directly, with scalar multiplication on the coefficient factor.
-/

@[expose] public section

set_option autoImplicit false

universe u v w

open scoped TensorProduct AlgebraMonoidAlgebra

namespace AddMonoidAlgebra

/-- The specified basis monomial in the monomial ideal.
Source: ILO VI 1.6(i)--(ii), p. 70
(blueprint: lem-trf-completed-monomial-ideal-tensor). -/
noncomputable def monomialSpanGenerator (D : Type v) [CommRing D]
    {P : Type u} [AddCommMonoid P] (I : Set P) (q : I) :
    Ideal.span (AddMonoidAlgebra.of' D P '' I) :=
  ⟨AddMonoidAlgebra.of' D P q, Ideal.subset_span ⟨q, q.property, rfl⟩⟩

/-- Multiplication from the monomial ideal tensor an algebra: `b ⊗ x ↦ b * image(x)`.
This is the base change of the actual ideal inclusion followed by scalar cancellation.
Source: ILO VIII 3.4.3, p. 110; Stacks 00CX
(blueprint: lem-trf-completed-monomial-ideal-tensor). -/
noncomputable def monomialTensorMul (D : Type v) [CommRing D]
    {P : Type u} [AddCommMonoid P] (I : Set P)
    (B : Type w) [CommRing B] [Algebra (AddMonoidAlgebra D P) B] :
    B ⊗[AddMonoidAlgebra D P] (Ideal.span (AddMonoidAlgebra.of' D P '' I)) →ₗ[B] B :=
  (TensorProduct.AlgebraTensorModule.rid (AddMonoidAlgebra D P) B B).toLinearMap.comp
    (((Ideal.span (AddMonoidAlgebra.of' D P '' I))).subtype.baseChange B)

/-- Monomial-ideal coefficient comparison, multiplication injectivity and its image
in an arbitrary ideal-adic completion of `L[P][t₁,...,tₙ]`. Tensor symmetry restores
exactly the tensor order in the source statement. The formula specifies the actual
comparison, and the next conjunct is equality of its multiplication composites.

Source: ILO VI 1.6(i)--(ii), p. 70, and VIII 3.4.3, p. 110
(blueprint: lem-trf-completed-monomial-ideal-tensor).

Proof plan:
1. For d = 0,n the finite sums l z^q t^alpha with q in I form an ideal T_d
   in C_d = L[P][t₁,...,t_d]. Polynomial coefficient uniqueness gives its basis;
   I + P ⊆ I gives stability under multiplication.
2. Multiplication identifies C_d tensor_Z[P] Z[I] with T_d. Its inverse sends
   sum l_(q,alpha) z^q t^alpha to sum (l_(q,alpha) t^alpha) tensor z^q.
   The balancing relation moves z^r across the tensor and verifies both inverse
   identities and C_d-linearity. No cancellation in P or Z-flatness of L is used.
3. Finite generation of P presents S as a quotient of a polynomial L-algebra
   in finitely many variables. Apply lem-weil-pbc-finite-type-algebra-noetherian
   and lem-weil-pbc-noetherian-completion-flat: B is flat over S for any a.
4. Apply lem-trf-flat-tensor-preserves-injection to T_n ↪ S. Identify its base
   change with B tensor_Z[P] Z[I] by step 2 and
   lem-trf-scalar-tensor-cancel-base-change. The resulting map is multiplication,
   so it is injective. Tensor symmetry gives the source's displayed order.
5. Repeat cancellation with d = 0 to obtain the B-linear coefficient comparison.
   Its inverse sends b tensor (sum l_q z^q) to sum (l_q b) tensor z^q.
   Balancing over L[P] verifies the inverse, and multiplication agrees on every
   pure tensor. This gives equality of the actual multiplication composites.
6. Every tensor is a finite sum b_q tensor z^q. Its image is therefore exactly
   the ideal generated by the images of z^q for q in I; conversely each such
   finite sum is an image. For I empty both tensor sources and the ideal vanish. -/
theorem completed_monomial_ideal_tensor (L : Type v) [CommRing L] [IsNoetherianRing L]
    (P : Type u) [AddCommMonoid P] [AddMonoid.FG P] (n : ℕ)
    (a : Ideal (MvPolynomial (Fin n) (AddMonoidAlgebra L P)))
    (I : Set P) (hI : ∀ q ∈ I, ∀ r : P, q + r ∈ I) :
    (∃ e :
      AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P)) ⊗[AddMonoidAlgebra ℤ P]
        (Ideal.span (AddMonoidAlgebra.of' ℤ P '' I))
          ≃ₗ[AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P))]
      AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P)) ⊗[AddMonoidAlgebra L P]
        (Ideal.span (AddMonoidAlgebra.of' L P '' I)),
      (∀ (q : I) (b : AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P))),
        e (b ⊗ₜ monomialSpanGenerator ℤ I q) = b ⊗ₜ monomialSpanGenerator L I q) ∧
      (monomialTensorMul L I _).comp e.toLinearMap = monomialTensorMul ℤ I _) ∧
    Function.Injective (monomialTensorMul ℤ I
      (AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P)))) ∧
    Set.range (monomialTensorMul ℤ I
      (AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P)))) =
      (Ideal.span ((fun q : P ↦
        algebraMap (AddMonoidAlgebra L P)
          (AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P)))
            (AddMonoidAlgebra.of' L P q)) '' I) : Set
              (AdicCompletion a (MvPolynomial (Fin n) (AddMonoidAlgebra L P)))) := by
  sorry

end AddMonoidAlgebra
