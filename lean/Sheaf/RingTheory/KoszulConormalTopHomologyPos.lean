module

public import Sheaf.RingTheory.KoszulConormalComparison

/-! Positive-rank top homology comparison.

(blueprint: lem-sc-koszul-conormal-top-homology-pos).

Proof in words: Evaluate the signed dual Koszul complex on the top wedge; the incoming
image is generated by the entries of f, so top cohomology is A/I. The determinant normalization
and conormal basis identify the induced map with multiplication by the unit sign, hence it is an
isomorphism.
Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext.
(blueprint: lem-sc-koszul-conormal-top-homology-pos).

The proof is the explicit signed determinant computation: evaluation on the top
wedge identifies the incoming image with the ideal generated by `f`, while the
normalization identifies the determinant generator up to a unit sign.
-/

@[expose] public section

universe u

open CategoryTheory

namespace ExteriorAlgebra

/-- Positive-rank top homology determinant calculation. The signed dual Koszul top wedge has
incoming image generated by f, so its top cohomology is A/I. The determinant normalization and
conormal basis identify the induced map with multiplication by a unit sign, hence it is an
isomorphism. (blueprint: lem-sc-koszul-conormal-top-homology-pos). -/
theorem koszul_conormal_comparison_isIso_top_homology_pos
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hr : 0 < r) (hf : Ideal.span (Set.range f) = I)
    (b : Module.Basis (Fin r) (A ⧸ I) I.Cotangent)
    (hb : ∀ i, b i = koszulConormalVector A I r f hf (Finsupp.single i 1))
    (φ : koszulDualComplex A r f ⟶
      (HomologicalComplex.single (ModuleCat A) (ComplexShape.up ℕ) r).obj
        (koszulNormalDeterminant A I r))
    (hφ : IsKoszulConormalComparison A I r f hf φ) :
    IsIso (HomologicalComplex.homologyMap φ r) := by sorry

end ExteriorAlgebra
