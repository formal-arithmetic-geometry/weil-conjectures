module

public import Sheaf.RingTheory.KoszulConormalComparison
import Mathlib.LinearAlgebra.ExteriorPower.Basis
import Mathlib.LinearAlgebra.Determinant

/-! Positive-rank top homology comparison.

(blueprint: lem-sc-koszul-conormal-top-homology-pos).

Proof in words: Evaluate the signed dual Koszul complex on the top wedge; the incoming
image is generated by the entries of f, so top cohomology is A/I. The determinant normalization
and conormal basis identify the induced map with multiplication by the unit sign, hence it is an
isomorphism.
Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext.
(blueprint: lem-sc-koszul-conormal-top-homology-pos).

The proof is the explicit signed determinant computation: evaluation on the top
wedge identifies the incoming image with the ideal generated by `f`, while the
normalization identifies the determinant generator up to a unit sign.
-/

@[expose] public section

universe u

open CategoryTheory

namespace ExteriorAlgebra

set_option backward.isDefEq.respectTransparency false in
private theorem top_evaluation_injective (A : Type u) [CommRing A] (r : ℕ)
    (f : Fin r → A) :
    Function.Injective (fun x : (koszulComplex A r f).X r ⟶ ModuleCat.of A A ↦
      x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) := by
  intro x y h
  dsimp only at h
  simp only [koszulComplex] at x y h ⊢
  apply ModuleCat.hom_ext
  apply exteriorPower.linearMap_ext
  let e := Finsupp.basisSingleOne (R := A) (ι := Fin r)
  rw [(x.hom.compAlternatingMap (exteriorPower.ιMulti A r)).eq_smul_basis_det e,
    (y.hom.compAlternatingMap (exteriorPower.ιMulti A r)).eq_smul_basis_det e]
  congr 1

set_option backward.isDefEq.respectTransparency false in
private theorem boundary_top_formula
    (A : Type u) [CommRing A] (n : ℕ) (f : Fin (n + 1) → A) :
    koszulBoundary A (n + 1) f n
        (exteriorPower.ιMulti A (n + 1) (fun i ↦ Finsupp.single i 1)) =
      ∑ i : Fin (n + 1), (((-1 : A) ^ (i.val + 2)) * f i) •
        exteriorPower.ιMulti A n (fun j ↦ Finsupp.single (i.succAbove j) 1) := by
  classical
  let e : Fin (n + 1) → (Fin (n + 1) →₀ A) := fun i ↦ Finsupp.single i 1
  let l := Finsupp.linearCombination A f
  obtain ⟨D, hD1, hrec, huniq, hgen, hzero, hdeg, hform, hleib, hdu⟩ :=
    koszul_differential A (Fin (n + 1) →₀ A) l
  have hc : CliffordAlgebra.contractLeft
      (Q := (0 : QuadraticForm A (Fin (n + 1) →₀ A))) l = D := by
    apply huniq
    · exact CliffordAlgebra.contractLeft_one _ _
    · intro v y
      simpa only [Algebra.smul_def] using
        CliffordAlgebra.contractLeft_ι_mul
          (Q := (0 : QuadraticForm A (Fin (n + 1) →₀ A))) l v y
  apply Subtype.ext
  change CliffordAlgebra.contractLeft _ _ = _
  rw [hc]
  change D (ExteriorAlgebra.ιMulti A (n + 1) e) = _
  rw [hform]
  simp [l, e, Algebra.smul_def, Function.comp_def]

private theorem complement_pairing (A : Type u) [CommRing A] (n : ℕ)
    (i j : Fin (n + 1)) :
    exteriorPower.pairingDual A (Fin (n + 1) →₀ A) n
      (exteriorPower.ιMulti A n
        (fun k ↦ (Finsupp.basisSingleOne :
          Module.Basis (Fin (n + 1)) A (Fin (n + 1) →₀ A)).coord (i.succAbove k)))
      (exteriorPower.ιMulti A n (fun k ↦ Finsupp.single (j.succAbove k) 1)) =
        if i = j then 1 else 0 := by
  classical
  let b : Module.Basis (Fin (n + 1)) A (Fin (n + 1) →₀ A) := Finsupp.basisSingleOne
  by_cases hij : i = j
  · subst j
    simp only [ite_true]
    simpa [b, Function.comp_def, Fin.succAboveOrderEmb] using
      exteriorPower.pairingDual_apply_apply_eq_one b b.coord
        (by intro i; simp) (by intro i j h; simp [h]) n i.succAboveOrderEmb
  · rw [if_neg hij]
    have he : i.succAboveOrderEmb ≠ j.succAboveOrderEmb := by
      intro h
      apply hij
      apply Fin.succAbove_left_injective
      exact congrArg (fun e : Fin n ↪o Fin (n + 1) ↦ (e : Fin n → Fin (n + 1))) h
    simpa [b, Function.comp_def, Fin.succAboveOrderEmb] using
      exteriorPower.pairingDual_apply_apply_eq_one_zero b b.coord
        (by intro i j h; simp [h]) n i.succAboveOrderEmb j.succAboveOrderEmb he

/-- The incoming boundaries are exactly the top functionals whose value on the ordered
standard top wedge vanishes modulo the ideal generated by the sequence.
Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext, local dual Koszul
calculation.

Proof: The top exterior power of A^r has the ordered standard top wedge as its single
basis vector, so evaluation identifies its dual with A. The Koszul boundary of that
wedge is the sum of the complementary ordered wedges with coefficients ± f_i.
Precomposition with this boundary, including the dual differential sign (-1)^r,
therefore has image contained in (f). Conversely the coordinate functional of each
complementary wedge gives ± f_i; the sign is a unit, so every f_i lies in the image.
The image is an A-submodule and hence contains their ideal span, giving equality
with I. Finally the kernel of A -> A/I is I, and top evaluation is injective, so
membership in the incoming image is equivalent to vanishing of the reduced value.
This uses positive rank to have an incoming degree r-1; it does not use regularity.
For I=A both conditions hold for every functional, including over the zero ring. -/
private theorem koszulDual_mem_range_top_iff
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hr : 0 < r) (hf : Ideal.span (Set.range f) = I)
    (x : (koszulDualComplex A r f).X r) :
    x ∈ LinearMap.range ((koszulDualComplex A r f).d (r - 1) r).hom ↔
      Ideal.Quotient.mk I
        (x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) = 0 := by
  classical
  cases r with
  | zero => omega
  | succ n =>
    let e := exteriorPower.ιMulti A (n + 1) (fun i : Fin (n + 1) ↦ Finsupp.single i (1 : A))
    let t : ((koszulComplex A (n + 1) f).X (n + 1) ⟶ ModuleCat.of A A) →ₗ[A] A :=
      { toFun := fun x ↦ x.hom e
        map_add' := by intros; rfl
        map_smul' := by intros; rfl }
    let d := ((koszulDualComplex A (n + 1) f).d n (n + 1)).hom
    have ht : Function.Injective t := top_evaluation_injective A (n + 1) f
    have hval (y : (koszulDualComplex A (n + 1) f).X n) :
        t (d y) = (-1 : A) ^ (n + 1) * y.hom (koszulBoundary A (n + 1) f n e) := by
      simp [t, d, koszulDualComplex, CochainComplex.of_d, koszulDualBoundary,
        Linear.leftComp, koszulComplex, ChainComplex.of_d]
    have hmem (y : (koszulDualComplex A (n + 1) f).X n) : t (d y) ∈ I := by
      rw [hval]
      apply I.mul_mem_left
      dsimp [e]
      rw [boundary_top_formula, map_sum]
      apply Submodule.sum_mem
      intro i hi
      rw [map_smul, smul_eq_mul]
      apply I.mul_mem_right
      apply I.mul_mem_left
      exact hf ▸ Ideal.subset_span (Set.mem_range_self i)
    let b : Module.Basis (Fin (n + 1)) A (Fin (n + 1) →₀ A) := Finsupp.basisSingleOne
    let y (i : Fin (n + 1)) : (koszulDualComplex A (n + 1) f).X n :=
      ModuleCat.ofHom (exteriorPower.pairingDual A (Fin (n + 1) →₀ A) n
        (exteriorPower.ιMulti A n (fun k ↦ b.coord (i.succAbove k))))
    have hy (i : Fin (n + 1)) :
        t (d (y i)) = (-1 : A) ^ (n + 1) * ((-1 : A) ^ (i.val + 2) * f i) := by
      rw [hval]
      dsimp [e]
      rw [boundary_top_formula, map_sum]
      congr 1
      simp only [map_smul, smul_eq_mul, y, ModuleCat.hom_ofHom, b]
      change (∑ j : Fin (n + 1), ((-1 : A) ^ (j.val + 2) * f j) *
        exteriorPower.pairingDual A (Fin (n + 1) →₀ A) n
          (exteriorPower.ιMulti A n (fun k ↦ b.coord (i.succAbove k)))
          (exteriorPower.ιMulti A n (fun k ↦ Finsupp.single (j.succAbove k) 1))) = _
      simp only [b, complement_pairing]
      simp
    have hgen (i : Fin (n + 1)) : f i ∈ LinearMap.range (t.comp d) := by
      let ε := (-1 : A) ^ (n + 1) * (-1 : A) ^ (i.val + 2)
      have hε : ε * ε = 1 := by
        dsimp [ε]
        calc
          _ = ((-1 : A) ^ (n + 1) * (-1 : A) ^ (n + 1)) *
              ((-1 : A) ^ (i.val + 2) * (-1 : A) ^ (i.val + 2)) := by ring
          _ = 1 := by rw [← mul_pow, ← mul_pow]; simp
      refine ⟨ε • y i, ?_⟩
      change t (d (ε • y i)) = f i
      rw [map_smul, map_smul, smul_eq_mul, hy]
      rw [← mul_assoc ((-1 : A) ^ (n + 1)), ← mul_assoc, hε, one_mul]
    have hI : (I : Submodule A A) = LinearMap.range (t.comp d) := by
      apply le_antisymm
      · rw [← hf]
        apply Ideal.span_le.mpr
        rintro a ⟨i, rfl⟩
        exact hgen i
      · rintro a ⟨y, rfl⟩
        exact hmem y
    change x ∈ LinearMap.range d ↔ Ideal.Quotient.mk I (t x) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    constructor
    · rintro ⟨y, rfl⟩
      exact hmem y
    · intro hx
      have hx' : t x ∈ LinearMap.range (t.comp d) := hI ▸ hx
      obtain ⟨y, hy⟩ := hx'
      exact ⟨y, ht hy⟩

private theorem top_powerset_subsingleton (r : ℕ) :
    Subsingleton (Set.powersetCard (Fin r) r) := by
  classical
  refine ⟨fun s t ↦ Subtype.ext ?_⟩
  have hs : s.val = Finset.univ :=
    Finset.eq_univ_of_card s.val (by simp)
  have ht : t.val = Finset.univ :=
    Finset.eq_univ_of_card t.val (by simp)
  exact hs.trans ht.symm

private theorem top_pairing_bijective {R M : Type u} [CommRing R] [AddCommGroup M]
    [Module R M] (r : ℕ) (b : Module.Basis (Fin r) R M) :
    Function.Bijective (fun z : ⋀[R]^r (Module.Dual R M) ↦
      exteriorPower.pairingDual R M r z (exteriorPower.ιMulti R r b)) := by
  classical
  have := top_powerset_subsingleton r
  let s : Set.powersetCard (Fin r) r :=
    Set.powersetCard.ofFinEmbEquiv ((OrderIso.refl (Fin r)).toOrderEmbedding)
  let : Unique (Set.powersetCard (Fin r) r) := ⟨⟨s⟩, fun t ↦ Subsingleton.elim t s⟩
  let B := b.dualBasis.exteriorPower r
  have hBs : B s = exteriorPower.ιMulti R r b.dualBasis := by
    simp [B, exteriorPower.basis_apply, exteriorPower.ιMulti_family, s]
  have hpair : exteriorPower.pairingDual R M r (B s)
      (exteriorPower.ιMulti R r b) = 1 := by
    rw [hBs]
    simpa using exteriorPower.pairingDual_apply_apply_eq_one
      b b.dualBasis (by intro i; simp) (by intro i j h; simp [h]) r
      ((OrderIso.refl (Fin r)).toOrderEmbedding)
  have hspan (z : ⋀[R]^r (Module.Dual R M)) : z = B.repr z s • B s := by
    simpa only [Finset.univ_unique, Finset.sum_singleton, Subsingleton.elim (default) s]
      using (B.sum_repr z).symm
  have hcoord (z : ⋀[R]^r (Module.Dual R M)) :
      exteriorPower.pairingDual R M r z (exteriorPower.ιMulti R r b) = B.repr z s := by
    conv_lhs => rw [hspan z]
    rw [map_smul, LinearMap.smul_apply, hpair, smul_eq_mul, mul_one]
  constructor
  · intro x y h
    dsimp only at h
    rw [hcoord x, hcoord y] at h
    rw [hspan x, hspan y, h]
  · intro a
    refine ⟨a • B s, ?_⟩
    dsimp only
    rw [map_smul, LinearMap.smul_apply, hpair, smul_eq_mul, mul_one]

private theorem top_evaluation_surjective (A : Type u) [CommRing A] (r : ℕ)
    (f : Fin r → A) :
    Function.Surjective (fun x : (koszulComplex A r f).X r ⟶ ModuleCat.of A A ↦
      x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) := by
  classical
  let b : Module.Basis (Fin r) A (Fin r →₀ A) := Finsupp.basisSingleOne
  let s : Set.powersetCard (Fin r) r :=
    Set.powersetCard.ofFinEmbEquiv (OrderIso.refl (Fin r)).toOrderEmbedding
  have htop : exteriorPower.ιMulti_family A r b s =
      exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1) := by
    simp [exteriorPower.ιMulti_family, s, b]
  intro a
  refine ⟨ModuleCat.ofHom (a • exteriorPower.ιMultiDual A r b s), ?_⟩
  change (a • exteriorPower.ιMultiDual A r b s)
    (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1)) = a
  rw [← htop, LinearMap.smul_apply, exteriorPower.ιMultiDual_apply_diag]
  simp

private theorem normalized_top_component (A : Type u) [CommRing A] (I : Ideal A)
    (r : ℕ) (f : Fin r → A) (hf : Ideal.span (Set.range f) = I)
    (b : Module.Basis (Fin r) (A ⧸ I) I.Cotangent)
    (hb : ∀ i, b i = koszulConormalVector A I r f hf (Finsupp.single i 1))
    (φ : koszulDualComplex A r f ⟶
      (HomologicalComplex.single (ModuleCat A) (ComplexShape.up ℕ) r).obj
        (koszulNormalDeterminant A I r))
    (hφ : IsKoszulConormalComparison A I r f hf φ) :
    Function.Surjective (φ.f r) ∧
      ∀ x, φ.f r x = 0 ↔ Ideal.Quotient.mk I
        (x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) = 0 := by
  let e := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) r
    (koszulNormalDeterminant A I r)
  let p := fun z : ⋀[A ⧸ I]^r (Module.Dual (A ⧸ I) I.Cotangent) ↦
    exteriorPower.pairingDual (A ⧸ I) I.Cotangent r z
      (exteriorPower.ιMulti (A ⧸ I) r b)
  have hp := top_pairing_bijective r b
  change Function.Bijective p at hp
  let ε := (-1 : A ⧸ I) ^ (r * (r - 1) / 2)
  have hε : ε * ε = 1 := by
    dsimp [ε]
    rw [← mul_pow]
    simp
  have hnorm (x : (koszulDualComplex A r f).X r) :
      p (e.hom (φ.f r x)) = ε * Ideal.Quotient.mk I
        (x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) := by
    have h := hφ x (fun i ↦ Finsupp.single i 1)
    simpa only [← hb, koszulComparisonValue] using h
  have he : Function.Bijective e.hom :=
    (ConcreteCategory.isIso_iff_bijective e.hom).mp inferInstance
  constructor
  · intro y
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
      (ε * p (e.hom y))
    obtain ⟨x, hx⟩ := top_evaluation_surjective A r f a
    dsimp only at hx
    refine ⟨x, he.injective (hp.injective ?_)⟩
    rw [hnorm, hx, ha, ← mul_assoc, hε, one_mul]
  · intro x
    constructor
    · intro hx
      have h := hnorm x
      rw [hx] at h
      have h0 : p (e.hom 0) = 0 := by simp [p]
      rw [h0] at h
      calc
        Ideal.Quotient.mk I
            (x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) =
            ε * (ε * Ideal.Quotient.mk I
              (x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1)))) := by
                rw [← mul_assoc, hε, one_mul]
        _ = 0 := by rw [← h, mul_zero]
    · intro hx
      apply he.injective
      apply hp.injective
      rw [hnorm, hx, mul_zero]
      simp [p]

private theorem shortComplex_quasiIso_of_surjective {A : Type u} [CommRing A]
    {S T : ShortComplex (ModuleCat.{u} A)} (φ : S ⟶ T)
    (hgS : S.g = 0) (hfT : T.f = 0) (hgT : T.g = 0)
    (hsurj : Function.Surjective φ.τ₂)
    (hker : ∀ x, φ.τ₂ x = 0 → x ∈ LinearMap.range S.f.hom) :
    ShortComplex.QuasiIso φ := by
  rw [ShortComplex.quasiIso_iff_isIso_descOpcycles φ hgS hfT hgT]
  let d := S.descOpcycles φ.τ₂ (by rw [← φ.comm₁₂, hfT]; simp)
  have hp : Function.Surjective S.pOpcycles :=
    (ModuleCat.epi_iff_surjective _).mp inferInstance
  have hd (x : S.X₂) : d (S.pOpcycles x) = φ.τ₂ x := by
    exact ConcreteCategory.congr_hom (S.p_descOpcycles φ.τ₂ _) x
  apply (ConcreteCategory.isIso_iff_bijective d).mpr
  constructor
  · intro x y h
    apply sub_eq_zero.mp
    obtain ⟨z, hz⟩ := hp (x - y)
    have hz0 : φ.τ₂ z = 0 := by
      rw [← hd, hz, map_sub, h, sub_self]
    have hzrange := hker z hz0
    have := (S.moduleCat_pOpcycles_eq_zero_iff z).mpr hzrange
    rwa [hz] at this
  · intro y
    obtain ⟨z, hz⟩ := hsurj y
    exact ⟨S.pOpcycles z, (hd z).trans hz⟩

private theorem koszulDual_outgoing_zero (A : Type u) [CommRing A] (r : ℕ)
    (f : Fin r → A) : (koszulDualComplex A r f).d r (r + 1) = 0 := by
  classical
  let b := (Finsupp.basisSingleOne : Module.Basis (Fin r) A (Fin r →₀ A)).exteriorPower
    (r + 1)
  have : IsEmpty (Set.powersetCard (Fin r) (r + 1)) := ⟨fun s ↦ by
    have hcard : s.val.card ≤ r := by simpa using Finset.card_le_univ s.val
    have hscard : s.val.card = r + 1 := s.property
    omega⟩
  have : Subsingleton (⋀[A]^(r + 1) (Fin r →₀ A)) := b.repr.injective.subsingleton
  have : Subsingleton ((koszulComplex A r f).X (r + 1) ⟶ ModuleCat.of A A) := by
    change Subsingleton
      (ModuleCat.of A (⋀[A]^(r + 1) (Fin r →₀ A)) ⟶ ModuleCat.of A A)
    refine ⟨fun x y ↦ ?_⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro v
    have hv : v = 0 := Subsingleton.elim _ _
    simp [hv]
  have : Subsingleton ((koszulDualComplex A r f).X (r + 1)) := ‹_›
  ext x
  exact Subsingleton.elim _ _

/-- Positive-rank top homology determinant calculation. The signed dual Koszul top wedge has
incoming image generated by f, so its top cohomology is A/I. The determinant normalization and
conormal basis identify the induced map with multiplication by a unit sign, hence it is an
isomorphism. (blueprint: lem-sc-koszul-conormal-top-homology-pos). -/
theorem koszul_conormal_comparison_isIso_top_homology_pos
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hr : 0 < r) (hf : Ideal.span (Set.range f) = I)
    (b : Module.Basis (Fin r) (A ⧸ I) I.Cotangent)
    (hb : ∀ i, b i = koszulConormalVector A I r f hf (Finsupp.single i 1))
    (φ : koszulDualComplex A r f ⟶
      (HomologicalComplex.single (ModuleCat A) (ComplexShape.up ℕ) r).obj
        (koszulNormalDeterminant A I r))
    (hφ : IsKoszulConormalComparison A I r f hf φ) :
    IsIso (HomologicalComplex.homologyMap φ r) := by
  obtain ⟨hsurj, hker⟩ := normalized_top_component A I r f hf b hb φ hφ
  let ψ := (HomologicalComplex.shortComplexFunctor (ModuleCat A) (ComplexShape.up ℕ) r).map φ
  change IsIso (ShortComplex.homologyMap ψ)
  apply (ShortComplex.quasiIso_iff ψ).mp
  apply shortComplex_quasiIso_of_surjective ψ
  · change (koszulDualComplex A r f).d r ((ComplexShape.up ℕ).next r) = 0
    have hn : (ComplexShape.up ℕ).next r = r + 1 :=
      (ComplexShape.up ℕ).next_eq' rfl
    rw [hn]
    exact koszulDual_outgoing_zero A r f
  · rfl
  · rfl
  · exact hsurj
  · intro x hx
    have hp : (ComplexShape.up ℕ).prev r = r - 1 :=
      (ComplexShape.up ℕ).prev_eq' (by change r - 1 + 1 = r; omega)
    change x ∈ LinearMap.range
      ((koszulDualComplex A r f).d ((ComplexShape.up ℕ).prev r) r).hom
    rw [hp]
    exact (koszulDual_mem_range_top_iff A I r f hr hf x).mpr ((hker x).mp hx)

end ExteriorAlgebra
