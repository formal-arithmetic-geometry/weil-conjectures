module
public import Mathlib.RingTheory.OrderOfVanishing.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Data.Finsupp.Basic

/-!
# Weil divisors and the Weil divisor class group of a commutative ring

Source: Stacks Project, Divisors, Section 0BE0 (Weil divisors), Definitions 0BE2
(Weil divisor), 0BE3 (principal divisor) and 0BE4 (Weil divisor class group), for the
affine scheme `Spec R`; the order of vanishing is Algebra, Definition 02MD
(blueprint: def-trf-affine-weil-divisor-class-group).
-/

@[expose] public section

universe u

namespace Ring

/-- The height-one primes of `R`: nonzero primes with no prime strictly between them
and `(0)`.
Source: Stacks Project, Divisors, Definition 0BE2, prime divisors of `Spec R`
(blueprint: def-trf-affine-weil-divisor-class-group). -/
def WeilHeightOnePrime (R : Type u) [CommRing R] :=
  {q : PrimeSpectrum R // q.asIdeal ≠ ⊥ ∧
    ∀ r : PrimeSpectrum R, r.asIdeal < q.asIdeal → r.asIdeal = ⊥}

/-- Affine Weil divisors: finitely supported integer combinations of height-one primes.
Source: Stacks Project, Divisors, Definition 0BE2
(blueprint: def-trf-affine-weil-divisor-class-group). -/
abbrev AffineWeilDivisor (R : Type u) [CommRing R] :=
  WeilHeightOnePrime R →₀ ℤ

/-- The order of vanishing of `a` at a height-one prime `q`: the length of
`R_q/(a)`, which for a discrete valuation ring `R_q` and `a ≠ 0` is the normalized
valuation of `a`.
Source: Stacks Project, Algebra, Definition 02MD, and Divisors, Definition 02RJ
(blueprint: def-trf-affine-weil-divisor-class-group). -/
noncomputable def weilOrder {R : Type u} [CommRing R]
    (q : WeilHeightOnePrime R) (a : R) : ℤ :=
  ((Ring.ord (Localization.AtPrime q.1.asIdeal)
    (algebraMap R (Localization.AtPrime q.1.asIdeal) a)).toNat : ℤ)

/-- The subgroup of principal divisors, generated by the divisors of fractions `a/b`
with `a, b ≠ 0`.
Source: Stacks Project, Divisors, Definition 0BE3
(blueprint: def-trf-affine-weil-divisor-class-group). -/
noncomputable def principalAffineWeilDivisors (R : Type u) [CommRing R] :
    AddSubgroup (AffineWeilDivisor R) :=
  AddSubgroup.closure {d | ∃ a b : R, a ≠ 0 ∧ b ≠ 0 ∧
    ∀ q : WeilHeightOnePrime R, d q = weilOrder q a - weilOrder q b}

/-- The Weil divisor class group: Weil divisors modulo principal divisors.
Source: Stacks Project, Divisors, Definition 0BE4
(blueprint: def-trf-affine-weil-divisor-class-group). -/
abbrev AffineWeilClassGroup (R : Type u) [CommRing R] :=
  AffineWeilDivisor R ⧸ principalAffineWeilDivisors R

end Ring
