module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.RingTheory.Spectrum.Prime.Module

/-!
# A finitely generated ideal cutting out the support of a finitely presented module

Source: Stacks Project, Algebra, Tag 051B, lemma-support-finite-presentation-constructible.
(blueprint: lem-pur-finitely-presented-support-ideal)

The proof constructs the ideal generated by the maximal minors of a finite presentation.
The determinant and localization argument is recorded in the parent node and is split here
as a strictly smaller intermediate statement.
-/

@[expose] public section

universe u v

namespace Module

/-- A finitely presented module has support equal to the zero locus of a finitely generated ideal.
Source: Stacks Project, Algebra, Tag 051B.
(blueprint: lem-pur-finitely-presented-support-ideal)

Proof: choose a finite presentation `B^u → B^v → M → 0`, and let `I` be generated by the
maximal `v × v` minors of its matrix. The maximal-minor criterion, using Cauchy--Binet for
the implication from vanishing localization and the adjugate identity for the converse,
shows that a prime lies in the support exactly when it contains every generator of `I`.
There are finitely many minors, so `I.FG`. The empty minor handles `v = 0`, and if `u < v`
the determinant identity forces the vanishing-localization case to be impossible outside
the zero locus. This is precisely the support calculation in Tag 051B.
-/
theorem exists_fg_ideal_eq_support
    (B : Type u) (M : Type v) [CommRing B] [AddCommGroup M] [Module B M]
    [Module.FinitePresentation B M] :
    ∃ I : Ideal B, I.FG ∧ Module.support B M = PrimeSpectrum.zeroLocus I := by
  sorry

end Module
