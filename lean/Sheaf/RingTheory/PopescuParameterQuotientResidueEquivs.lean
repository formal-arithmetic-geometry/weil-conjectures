module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-! # Residue identifications for a powered parameter quotient

Source: Stacks Project, Smoothing Ring Maps, Lemma 07FE (lemma-resolve-special),
final paragraph, identification of the residue field extension.
(blueprint: lem-weil-pbc-popescu-parameter-quotient-residue-equivs).
-/

@[expose] public section

universe u v w

namespace Algebra

/-- The residue base and closed fiber of a powered parameter quotient identify with
k and κ(q), compatibly with the original field map.

Source: Stacks Project, Smoothing Ring Maps, Lemma 07FE (lemma-resolve-special),
final paragraph, before applying Lemma 07BV.
(blueprint: lem-weil-pbc-popescu-parameter-quotient-residue-equivs).

Proof: Let P=k[X_i] and p=φ⁻¹(q). Each image φ(X_i) belongs to q because its
image in Λ_q belongs to the maximal ideal, and that maximal ideal contracts to q.
Thus p contains the variable ideal. Evaluation at zero identifies the quotient
by the variable ideal with k, so that ideal is maximal and equals p. Because c≥1,
the powered ideal J is contained in p. The inverse-image prime of p₀ in P is p:
contraction through P → Λ → Λ/JΛ agrees with contraction through P/J → Λ/JΛ.
Localizing and quotienting by the maximal ideal therefore identifies R₀/I with
P/p=k, and this identification sends the class of every constant to itself.
Localization commutes with quotient on Λ as well: L₀ identifies with
Λ_q/(JΛ_q). Since all powered parameters lie in the maximal ideal of Λ_q,
that quotient is local, with maximal ideal the image of the old maximal ideal.
The extension of I is generated by the images of the X_i, hence by hgen equals
this maximal ideal. Consequently L₀/IL₀ identifies with κ(q). The ring equivalence
ULift.down induces the same identification for L/IL. On a class of a polynomial,
both induced scalar maps evaluate its variables at zero and send its constant
to the given image in κ(q); the same equality on inverses establishes it after
localization. Thus the displayed maps commute. For d=0, P=k and hgen says that
Λ_q has zero maximal ideal; the argument gives the same field identifications.
No regularity, dimension, Noetherian, or separability hypothesis is needed here. -/
theorem parameter_quotient_residue_ringEquivs
    {k : Type u} {Λ : Type w} [Field k] [CommRing Λ] [Algebra k Λ]
    (d c : ℕ) (hc : 1 ≤ c) (φ : MvPolynomial (Fin d) k →ₐ[k] Λ)
    (q : PrimeSpectrum Λ)
    (hgen : Ideal.span (Set.range (fun i : Fin d ↦
      algebraMap Λ (Localization.AtPrime q.asIdeal) (φ (MvPolynomial.X i)))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) :
    letI := φ.toRingHom.toAlgebra
    let J : Ideal (MvPolynomial (Fin d) k) :=
      Ideal.span (Set.range (fun i : Fin d ↦ (MvPolynomial.X i ^ c) ^ 8))
    let J_Λ := Ideal.map (algebraMap (MvPolynomial (Fin d) k) Λ) J
    ∀ (q₀ : PrimeSpectrum (Λ ⧸ J_Λ)),
      PrimeSpectrum.comap (Ideal.Quotient.mk J_Λ) q₀ = q →
    letI := Localization.AtPrime.algebraOfLiesOver
      (q₀.asIdeal.under (MvPolynomial (Fin d) k ⧸ J)) q₀.asIdeal
    let R₀ := Localization.AtPrime (q₀.asIdeal.under (MvPolynomial (Fin d) k ⧸ J))
    let L₀ := Localization.AtPrime q₀.asIdeal
    let L := ULift.{max u v} L₀
    let I := IsLocalRing.maximalIdeal R₀
    ∃ eR : (R₀ ⧸ I) ≃+* k,
      ∃ eL : (L ⧸ I.map (algebraMap R₀ L)) ≃+* q.asIdeal.ResidueField,
        ∀ r : R₀ ⧸ I,
          eL (algebraMap (R₀ ⧸ I) (L ⧸ I.map (algebraMap R₀ L)) r) =
            algebraMap k q.asIdeal.ResidueField (eR r) := by sorry

end Algebra
