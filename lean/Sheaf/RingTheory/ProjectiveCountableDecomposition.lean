module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Data.Set.Countable
import Mathlib.Algebra.DirectSum.Finsupp
import Sheaf.RingTheory.ProjectiveKaplanskyDirectSummand

/-!
# Decomposition of projective modules into countably generated projective modules

Source: Stacks Project, Algebra, Tag 058Y, theorem-projective-direct-sum.
(blueprint: lem-trf-projective-countable-decomposition)
-/

@[expose] public section

set_option autoImplicit false

universe u v

open DirectSum

namespace Module

open Classical in
/-- Every projective module over a commutative ring is a direct sum of countably generated
projective modules. Countable generation means that a countable subset spans the module;
the direct sum consists of families with finite support.
Source: Stacks Project, Algebra, Tag 058Y, theorem-projective-direct-sum.
(blueprint: lem-trf-projective-countable-decomposition)

Proof:
1. By `def-weil-pbc-projective-module` (`Module.projective_def'`), realize `P` as a
   retract of the canonical free module `P →₀ R`. This is the direct sum indexed by `P`
   of copies of `R`, each generated by the countable singleton `{1}`.
2. Apply `lem-trf-projective-kaplansky-direct-summand` (Stacks Tag 058X) to this direct
   sum and its retract `P`. It gives a direct-sum decomposition of `P` into countably
   generated modules `Q i`.
3. Each `Q i` is a retract of the direct sum via its coordinate inclusion and projection,
   hence a retract of `P` after transporting along the isomorphism. Apply
   `lem-weil-pbc-projective-direct-summand` (`Module.Projective.of_split`) to conclude
   that each `Q i` is projective. This gives both required properties of the summands.

The canonical free module is indexed by `P`, so the Kaplansky theorem directly gives both
its index and its summand types in the universe of `P`, independently of the universe of
`R`. This also applies to the zero module and the zero ring. No finite-generation
hypothesis is imposed. -/
theorem exists_directSum_countablyGenerated_projective
    (R : Type u) [CommRing R] (P : Type v) [AddCommGroup P] [Module R P]
    [Module.Projective R P] :
    ∃ (I : Type v) (Q : I → Type v) (_ : ∀ i, AddCommGroup (Q i))
      (_ : ∀ i, Module R (Q i)),
      (∀ i, Module.Projective R (Q i)) ∧
      (∀ i, ∃ s : Set (Q i), s.Countable ∧ Submodule.span R s = ⊤) ∧
      Nonempty ((⨁ i : I, Q i) ≃ₗ[R] P) := by
  classical
  obtain ⟨a, ha⟩ := (projective_def' (R := R) (P := P)).mp inferInstance
  have hR : ∀ _ : P, ∃ s : Set R, s.Countable ∧ Submodule.span R s = ⊤ := by
    intro _
    refine ⟨{1}, Set.countable_singleton 1, ?_⟩
    exact (Submodule.span_singleton_eq_top_iff (R := R) (1 : R)).mpr
      (fun r ↦ ⟨r, by simp⟩)
  obtain ⟨I, Q, hAdd, hMod, hQ, ⟨e⟩⟩ := exists_directSum_countablyGenerated_of_split
    R (P →₀ R) P (fun _ ↦ R) hR ⟨(finsuppLEquivDirectSum R R P).symm⟩
    P a (Finsupp.linearCombination R id) ha
  let := hAdd
  let := hMod
  have : Module.Projective R (⨁ i : I, Q i) := Projective.of_equiv' e.symm
  exact ⟨I, Q, hAdd, hMod, Projective.directSum_iff.mp inferInstance, hQ, ⟨e⟩⟩

end Module
