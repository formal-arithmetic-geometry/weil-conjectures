/-!
# Finite coefficient subrings and their fraction subfields

Source: Stacks Project, More on Algebra, Tag 07P5.
(blueprint: lem-weil-pbc-power-series-finite-subfield-family)
-/

@[expose] public section
set_option autoImplicit false
universe u v t
attribute [local instance] ZMod.algebra

namespace RingTheory


private noncomputable def coefficientSubring
    (p : ℕ) (k : Type t) [Field k] (n m : ℕ) (S : Subfield k) :
    Subring (MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)) := by
  classical
  let c := fun (f : MvPolynomial (Fin m) (MvPowerSeries (Fin n) k))
    (a : Fin n →₀ ℕ) (g : Fin m →₀ ℕ) =>
    MvPowerSeries.coeff a (MvPolynomial.coeff g f)
  let good := fun (a : Fin n →₀ ℕ) (g : Fin m →₀ ℕ) =>
    (∀ i, p ∣ a i) ∧ (∀ j, p ∣ g j)
  let pred := fun f => ∀ a g, c f a g ∈ S ∧ (c f a g ≠ 0 → good a g)
  have hsum {β : Type} (s : Finset β) (f : β → k)
      (h : ∀ b ∈ s, f b ∈ S) : ∑ b ∈ s, f b ∈ S := S.sum_mem h
  refine
    { carrier := {f | pred f}
      zero_mem' := ?_
      one_mem' := ?_
      add_mem' := ?_
      neg_mem' := ?_
      mul_mem' := ?_ }
  · intro f h hf hh a g
    have heq : c (f * h) a g =
        ∑ q ∈ (Finset.antidiagonal g : Finset ((Fin m →₀ ℕ) × (Fin m →₀ ℕ))),
        ∑ r ∈ (Finset.antidiagonal a : Finset ((Fin n →₀ ℕ) × (Fin n →₀ ℕ))),
          c f (r : (Fin n →₀ ℕ) × (Fin n →₀ ℕ)).1
            (q : (Fin m →₀ ℕ) × (Fin m →₀ ℕ)).1 * c h r.2 q.2 := by
      simp only [c, MvPolynomial.coeff_mul, map_sum, MvPowerSeries.coeff_mul]
    change c (f * h) a g ∈ S ∧ _
    rw [heq]
    refine ⟨hsum (Finset.antidiagonal g) _ (fun q _ =>
      hsum (Finset.antidiagonal a) _ (fun r _ =>
      S.mul_mem (hf r.1 q.1).1 (hh r.2 q.2).1)), ?_⟩
    intro hne
    obtain ⟨q, hq, hqne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    obtain ⟨r, hr, hrne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hqne
    have hfne := (mul_ne_zero_iff.mp hrne).1
    have hhne := (mul_ne_zero_iff.mp hrne).2
    obtain ⟨hfa, hfg⟩ := (hf r.1 q.1).2 hfne
    obtain ⟨hha, hhg⟩ := (hh r.2 q.2).2 hhne
    have ha : r.1 + r.2 = a := Finset.mem_antidiagonal.mp hr
    have hg : q.1 + q.2 = g := Finset.mem_antidiagonal.mp hq
    constructor
    · intro i
      rw [← ha, Finsupp.add_apply]
      exact dvd_add (hfa i) (hha i)
    · intro j
      rw [← hg, Finsupp.add_apply]
      exact dvd_add (hfg j) (hhg j)
  · intro a g
    by_cases hg : g = 0
    · subst g
      by_cases ha : a = 0
      · subst a
        simp [c, MvPolynomial.coeff_one, MvPowerSeries.coeff_one, good]
      · simp [c, MvPolynomial.coeff_one, MvPowerSeries.coeff_one, ha]
    · simp [c, MvPolynomial.coeff_one, Ne.symm hg]
  · intro f h hf hh a g
    obtain ⟨hfS, hfG⟩ := hf a g
    obtain ⟨hhS, hhG⟩ := hh a g
    change c (f + h) a g ∈ S ∧ _
    have heq : c (f + h) a g = c f a g + c h a g := by simp [c]
    rw [heq]
    refine ⟨S.add_mem hfS hhS, ?_⟩
    intro hne
    by_cases hf0 : c f a g = 0
    · apply hhG
      simpa [hf0] using hne
    · exact hfG hf0
  · intro a g
    simp [c]
  · intro f hf a g
    have heq : c (-f) a g = -c f a g := by simp [c, MvPolynomial.coeff_neg]
    change c (-f) a g ∈ S ∧ _
    rw [heq]
    exact ⟨S.neg_mem (hf a g).1, fun h => (hf a g).2 (neg_ne_zero.mp h)⟩

/-- A power-series polynomial domain has a downward directed family of finite
coefficient subrings whose fraction subfields intersect in the pth powers.
Source: Stacks Project, More on Algebra, Tag 07P5, the construction preceding
and the three properties following the finiteness assertion.
(blueprint: lem-weil-pbc-power-series-finite-subfield-family)

Proof: choose a p-basis t_i of k using Field.exists_p_basis. Index by finite
subsets J of its index set. Let k_J be the subfield generated by k^p and the
basis elements outside J. Construct B_J inside the displayed polynomial ring
by the coefficient condition: every coefficient belongs to k_J and every
nonzero coefficient has all its power-series and polynomial exponents divisible
by p. This condition is closed under zero, one, addition, negation and products:
coefficients of products are finite convolutions, and sums of p-divisible
exponents are p-divisible. Transport B_J to C by e.symm. Construct F_J as the
subfield of K consisting of quotients of images of elements of this subring
with nonzero denominator; the fraction map is injective, so the quotient set
is closed under all field operations. It contains the prime field, since
constants in F_p are pth powers. Apply RingTheory.powerSeriesRingSubfields
with these explicitly constructed coefficient and quotient families. Its four
clauses give finiteness, containment of K^p, intersection K^p and directedness
(the index for two finite sets is their union). Transport finiteness across e;
the image containment follows by writing a ring element over denominator one.
For n=0 or m=0 the corresponding exponent functions are empty and the same
construction applies. If k is perfect and n=m=0, the singleton family C,K
already has the required properties. No finite extension or differential is
involved in this construction. -/
theorem exists_powerSeries_finite_subfield_family
    (p : ℕ) [Fact p.Prime]
    (k : Type t) [Field k] [CharP k p] (n m : ℕ)
    (C : Type u) [CommRing C] [IsDomain C]
    (e : C ≃+* MvPolynomial (Fin m) (MvPowerSeries (Fin n) k))
    (K : Type v) [Field K] [CharP K p] [Algebra C K] [IsFractionRing C K] :
    ∃ (ι : Type t) (A : ι → Subring C) (F : ι → IntermediateField (ZMod p) K),
      (∀ i, Module.Finite (A i) C) ∧
      (∀ i (a : A i), algebraMap C K a ∈ F i) ∧
      (∀ i, Set.range (fun x : K => x ^ p) ⊆ (F i : Set K)) ∧
      (Set.range (fun x : K => x ^ p) =
        ((⨅ i, F i : IntermediateField (ZMod p) K) : Set K)) ∧
      (∀ i j, ∃ l, F l ≤ F i ⊓ F j) := by
  classical
  let P := MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)
  let _ : Algebra P K := ((algebraMap C K).comp e.symm.toRingHom).toAlgebra
  have : IsFractionRing P K :=
    (IsFractionRing.isFractionRing_iff_of_base_ringEquiv K e).mp inferInstance
  obtain ⟨I, t, b, hb⟩ := Field.exists_p_basis p k
  let kJ : Finset I → Subfield k := fun J => Subfield.closure
    (Set.range (fun x : k => x ^ p) ∪ {x : k | ∃ i : I, i ∉ J ∧ t i = x})
  let BJ : Finset I → Subring P := fun J => coefficientSubring p k n m (kJ J)
  have hBJ : ∀ J f, f ∈ BJ J ↔
      ∀ (a : Fin n →₀ ℕ) (g : Fin m →₀ ℕ),
        MvPowerSeries.coeff a (MvPolynomial.coeff g f) ∈ kJ J ∧
        (MvPowerSeries.coeff a (MvPolynomial.coeff g f) ≠ 0 →
          (∀ i, p ∣ a i) ∧ (∀ j, p ∣ g j)) := by
    intro J f
    rfl
  let KJ : Finset I → Subfield K := fun J =>
    Subfield.closure ((BJ J).map (algebraMap P K) : Set K)
  have hKJ : ∀ J z, z ∈ KJ J ↔
      ∃ a b : BJ J, (b : P) ≠ 0 ∧
        z = algebraMap P K a / algebraMap P K b := by
    intro J z
    constructor
    · intro hz
      obtain ⟨a, ha, b, hb, heq⟩ := Subfield.mem_closure_iff.mp hz
      rw [Subring.closure_eq] at ha hb
      obtain ⟨a, ha, rfl⟩ := ha
      obtain ⟨b, hb, rfl⟩ := hb
      by_cases hb0 : b = 0
      · have hz0 : z = 0 := by simpa [hb0] using heq.symm
        refine ⟨0, 1, one_ne_zero, ?_⟩
        simpa using hz0
      · exact ⟨⟨a, ha⟩, ⟨b, hb⟩, hb0, heq.symm⟩
    · rintro ⟨a, b, hb, rfl⟩
      apply (KJ J).div_mem
      · exact Subfield.subset_closure ⟨a, a.property, rfl⟩
      · exact Subfield.subset_closure ⟨b, b.property, rfl⟩
  obtain ⟨hfinite, hpower, hinter, hdir⟩ :=
    powerSeriesRingSubfields p k I t ⟨b, hb⟩ n m K kJ (fun _ => rfl)
      BJ hBJ KJ hKJ
  let A : Finset I → Subring C := fun J => (BJ J).comap e.toRingHom
  have hbase (J : Finset I) (a : ZMod p) : algebraMap (ZMod p) K a ∈ KJ J := by
    apply hpower J
    obtain ⟨b, hb⟩ := surjective_frobenius (ZMod p) p a
    refine ⟨algebraMap (ZMod p) K b, ?_⟩
    change (algebraMap (ZMod p) K b) ^ p = algebraMap (ZMod p) K a
    rw [← map_pow]
    exact congrArg (algebraMap (ZMod p) K) hb
  let F : Finset I → IntermediateField (ZMod p) K := fun J =>
    (KJ J).toIntermediateField (hbase J)
  refine ⟨Finset I, A, F, ?_, ?_, hpower, ?_, ?_⟩
  · intro J
    have : Module.Finite (BJ J) P := hfinite J
    let eA : BJ J ≃+* A J :=
      { toFun := fun a => ⟨e.symm a, by
          change e (e.symm a) ∈ BJ J
          simpa only [e.apply_symm_apply] using a.property⟩
        invFun := fun a => ⟨e a, a.property⟩
        left_inv := fun a => Subtype.ext (e.apply_symm_apply a)
        right_inv := fun a => Subtype.ext (e.symm_apply_apply a)
        map_mul' := fun a b => Subtype.ext (map_mul e.symm (a : P) (b : P))
        map_add' := fun a b => Subtype.ext (map_add e.symm (a : P) (b : P)) }
    apply Module.Finite.of_equiv_equiv eA e.symm
    ext a
    rfl
  · intro J a
    apply (hKJ J _).mpr
    refine ⟨⟨e a, a.property⟩, 1, one_ne_zero, ?_⟩
    change algebraMap C K a = algebraMap C K (e.symm (e a)) /
      algebraMap C K (e.symm 1)
    simp
  · simpa only [IntermediateField.coe_iInf, F,
      Subfield.coe_toIntermediateField] using hinter
  · intro J J'
    exact ⟨J ∪ J', hdir J J'⟩

end RingTheory

