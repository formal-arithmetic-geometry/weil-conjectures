module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Localization.Away.Basic
import Sheaf.RingTheory.NoetherNormalizationOverDomainSurjective

/-!
# Noether normalization over a domain

Source: Stacks Project, Algebra, Lemma 07NA (`lemma-Noether-normalization-over-a-domain`)
(blueprint: lem-weil-pbc-noether-normalization-over-domain).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace Algebra.FiniteType

/-- Stacks Project, Algebra, Lemma 07NA (`lemma-Noether-normalization-over-a-domain`).
(blueprint: lem-weil-pbc-noether-normalization-over-domain)
An injective finite type algebra over a domain contains a finite extension of a polynomial
subalgebra which becomes the whole algebra after inverting a nonzero base element.

Proof:
1. Choose finite algebra generators `xᵢ` of `S`. Localize at the nonzero elements of `R`.
   The resulting algebra over the fraction field `K` is nonzero (injectivity of `R → S`)
   and finite type, by def-weil-pbc-module-localization and def-weil-pbc-finite-type-algebra.
2. Apply lem-weil-pbc-noether-normalization-field to obtain a finite injective polynomial
   algebra map over `K`. Write each coordinate as `sⱼ/uⱼ`, and rescale its variable by `uⱼ`.
   This polynomial automorphism preserves the image and finiteness and puts the coordinates
   in `S`, by the universal property of def-weil-pbc-mv-polynomial-ring.
3. Evaluation over `R` followed by localization equals evaluation over `K` after coefficient
   extension. Coefficient extension is injective because `R` is a domain, so evaluation
   over `R` is injective too. Its range is the polynomial subalgebra `R[y]`.
4. By lem-weil-pbc-finite-algebra-is-integral, each localized generator satisfies a monic
   equation over `K[y]` (def-weil-pbc-integral-closure).
5. Clear the finitely many coefficient denominators by a common nonzero `f₀`. Each resulting
   equation vanishes after localization, so multiply by further nonzero base elements to
   make it vanish in `S` itself. Their product with `f₀` is a nonzero element `f`.
6. Put `xᵢ' = f*xᵢ` and let `S'` be generated by the `yⱼ` and `xᵢ'`. Multiplying each
   degree-`m` equation by `f^(m-1)` gives a monic equation for `xᵢ'` over `R[y]`.
   Thus S' is finite over R[y] by lem-weil-pbc-finite-of-integral-generators, with
   finiteness understood as def-weil-finitely-generated-module.
7. Localization of the inclusion `S' ⊆ S` is injective: equality of fractions is the same
   equation after multiplying by a power of `f` in either ring. It is surjective: express
   any `s` as a polynomial in the `xᵢ`, and choose `N` at least its total degree. Then
   `f^N*s` is a polynomial in the `xᵢ'` with coefficients in `R`, hence belongs to `S'`.
   Therefore `s/f^e` comes from `(f^N*s)/f^(N+e)`. -/
theorem exists_finite_subalgebra_away
    (R : Type u) (S : Type v) [CommRing R] [IsDomain R] [CommRing S]
    [Algebra R S] [Algebra.FiniteType R S]
    (hinj : Function.Injective (algebraMap R S)) :
    ∃ (d : ℕ) (y : Fin d → S) (S' : Subalgebra R S),
      Function.Injective (MvPolynomial.aeval (R := R) y) ∧
      ∃ h : (MvPolynomial.aeval (R := R) y).range ≤ S',
        (letI := (Subalgebra.inclusion h).toRingHom.toAlgebra
         Module.Finite (MvPolynomial.aeval (R := R) y).range S') ∧
        ∃ f : R, f ≠ 0 ∧
          Function.Bijective
            (IsLocalization.Away.map
              (Localization.Away (algebraMap R S' f))
              (Localization.Away (S'.val (algebraMap R S' f)))
              S'.val.toRingHom (algebraMap R S' f)) := by
  obtain ⟨d, y, S', hay, h, hfin, f, hf, hsurj⟩ :=
    exists_finite_subalgebra_away_surjective R S hinj
  refine ⟨d, y, S', hay, h, hfin, f, hf, ?_⟩
  refine ⟨IsLocalization.map_injective_of_injective _ _ _ Subtype.val_injective, hsurj⟩

end Algebra.FiniteType
