module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Sheaf.LinearAlgebra.SymmetricAlgebra.DegreeExact

@[expose] public section

universe u v w

/-- (blueprint: lem-weil-pbc-symmetric-algebra-quotient-module-kernel)
The symmetric algebra map induced by a surjective linear map is surjective and
has kernel generated by the images of the source kernel.

This is the graded summation of the degreewise exactness theorem for symmetric
algebras (Stacks Project, Algebra, Lemma 00DO). -/
theorem symmetricAlgebra_quotient_module_kernel
    (R : Type u) [CommRing R]
    (N : Type v) (M : Type w) [AddCommGroup N] [AddCommGroup M]
    [Module R N] [Module R M]
    (p : N →ₗ[R] M) (hp : Function.Surjective p) :
    Function.Surjective
        (SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)) ∧
      RingHom.ker (SymmetricAlgebra.lift
        ((SymmetricAlgebra.ι R M).comp p)).toRingHom =
        Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N)) := by
  sorry
