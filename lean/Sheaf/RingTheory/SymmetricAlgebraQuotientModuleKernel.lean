module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.Isomorphisms

@[expose] public section

universe u v w

/-- (blueprint: lem-weil-pbc-symmetric-algebra-quotient-module-kernel)
The symmetric algebra map induced by a surjective linear map is surjective and
has kernel generated by the images of the source kernel.

Source: Stacks Project, Algebra, Lemma 00DO, summed over the symmetric degrees.
Proof: induct on the symmetric algebra to lift scalars, generators, sums and
products. For the kernel equality, quotient the source algebra by the ideal
of kernel generators. Its linear generator map factors uniquely through `p`
via the first isomorphism theorem. Lift this factor to an algebra map; its
composite with the induced symmetric algebra map is the quotient map, as
checked on generators. Hence the kernel is contained in the ideal. The
opposite inclusion follows because each ideal generator maps to zero. -/
theorem symmetricAlgebra_quotient_module_kernel
    (R : Type u) [CommRing R]
    (N : Type v) (M : Type w) [AddCommGroup N] [AddCommGroup M]
    [Module R N] [Module R M]
    (p : N →ₗ[R] M) (hp : Function.Surjective p) :
    Function.Surjective
        (SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)) ∧
      RingHom.ker (SymmetricAlgebra.lift
        ((SymmetricAlgebra.ι R M).comp p)).toRingHom =
        Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N)) := by
  let f := SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)
  constructor
  · intro z
    induction z using SymmetricAlgebra.induction with
    | algebraMap r => exact ⟨algebraMap R (SymmetricAlgebra R N) r, f.commutes r⟩
    | ι m =>
      obtain ⟨n, rfl⟩ := hp m
      exact ⟨SymmetricAlgebra.ι R N n, SymmetricAlgebra.lift_ι_apply _ n⟩
    | mul x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a * b, f.map_mul a b⟩
    | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, f.map_add a b⟩
  · let I := Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N))
    let q := Ideal.Quotient.mkₐ R I
    have hq : LinearMap.ker p ≤
        LinearMap.ker (q.toLinearMap.comp (SymmetricAlgebra.ι R N)) := by
      intro x hx
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨x, hx, rfl⟩)
    let g : M →ₗ[R] SymmetricAlgebra R N ⧸ I :=
      ((LinearMap.ker p).liftQ (q.toLinearMap.comp (SymmetricAlgebra.ι R N)) hq).comp
        (p.quotKerEquivOfSurjective hp).symm.toLinearMap
    have hg (x : N) : g (p x) = q (SymmetricAlgebra.ι R N x) := by
      simp [g, LinearMap.quotKerEquivOfSurjective_symm_apply]
    have heq : (SymmetricAlgebra.lift g).comp f = q := by
      apply SymmetricAlgebra.algHom_ext
      ext x
      change SymmetricAlgebra.lift g
        (SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)
          (SymmetricAlgebra.ι R N x)) = q (SymmetricAlgebra.ι R N x)
      rw [SymmetricAlgebra.lift_ι_apply]
      change SymmetricAlgebra.lift g (SymmetricAlgebra.ι R M (p x)) =
        q (SymmetricAlgebra.ι R N x)
      rw [SymmetricAlgebra.lift_ι_apply]
      exact hg x
    apply le_antisymm
    · intro x hx
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      have hx' : f x = 0 := hx
      change q x = 0
      rw [← heq, AlgHom.comp_apply, hx', map_zero]
    · apply Ideal.span_le.mpr
      rintro _ ⟨x, hx, rfl⟩
      change SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)
        (SymmetricAlgebra.ι R N x) = 0
      rw [SymmetricAlgebra.lift_ι_apply]
      simp [LinearMap.mem_ker.mp hx]

