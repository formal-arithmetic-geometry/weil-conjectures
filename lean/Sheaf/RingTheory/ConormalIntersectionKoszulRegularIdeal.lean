module

public import Mathlib.RingTheory.Localization.Away.Basic
public import WeilConjectures.RingTheory.KoszulRegularSequence
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.RingTheory.LocalProperties.Basic

/-!
# Conormal intersection for a locally Koszul-regular quotient ideal

Source: Stacks Project, More on Algebra, Tag 07CX
(lemma-conormal-sequence-H1-regular-ideal), specialized using Koszul-regularity;
the local generation condition is Tag 07CV (definition-regular-ideal), clause (2).
(blueprint: lem-sfb-conormal-intersection-koszul-regular-ideal)
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Ideal

/-- If `L ≤ K` and `K/L` is locally generated by Koszul-regular sequences, then
`L ∩ K² = LK`. The quotient ideal is `K.map (Ideal.Quotient.mk L)`. The statement
allows the zero ring, improper ideals, and empty sequences, without Noetherianity,
locality, or flatness assumptions.

Source: Stacks Project, More on Algebra, Tag 07CX
(lemma-conormal-sequence-H1-regular-ideal), with Tag 07CV, clause (2), expanded.
(blueprint: lem-sfb-conormal-intersection-koszul-regular-ideal)

Proof plan (the six steps of the DAG node):

1. The inclusion `LK ≤ L ∩ K²` follows from `L ≤ K`. For the reverse inclusion,
   fix `x ∈ L ∩ K²` and test membership in `LK` at every maximal ideal `m` of `T`.
2. If `K` is not contained in `m`, choose `k ∈ K` outside `m`. Then `xk ∈ LK`
   and `x/1 = (xk)/k` in the localization at `m`.
3. Otherwise `m/L` is prime in `T/L` and contains `K/L`. Choose the supplied
   principal chart `h` and lift it to `t ∉ m`. Set `A = T_t`, `I = LA`, `J = KA`.
   By lem-weil-pbc-localization-quotient-commute, `A/I` identifies with `(T/L)_h`,
   and `J/I` with the extension of `K/L`. Lift its given generators to elements
   of `J`. Their images are H₁-regular, since Koszul-regularity includes degree one
   vanishing (def-weil-pbc-koszul-regular-sequence).
4. Apply lem-sfb-h1-regular-quotient-ideal-intersection to `I ≤ J`: it gives
   `I ∩ J² = IJ`. Thus `x/1 ∈ IJ = (LK)A`; the last equality follows by expanding
   finite sums of products of the extended generators. Empty tuples are allowed.
5. Write `x/1` as a finite sum of fractions with numerators in `LK`, and clear
   their denominators to obtain `x/1 = b/t^N`, where `b ∈ LK`. Equality of
   fractions gives `t^q(t^N x - b) = 0` for some `q`, hence
   `t^(N+q) x = t^q b ∈ LK`. Since `t ∉ m`, this proves the desired membership
   at `m`. A zero sum permits `N = 0`.
6. Apply lem-weil-pbc-ideal-membership-at-maximal-localizations, namely
   `Ideal.mem_of_localization_maximal`, to conclude `x ∈ LK`. This also covers
   the zero ring, where there are no maximal ideals.
-/
theorem inf_sq_eq_mul_of_locally_koszulRegular_quotient
    {T : Type u} [CommRing T] (L K : Ideal T) (hLK : L ≤ K)
    (hlocal : ∀ p : Ideal (T ⧸ L), p.IsPrime → K.map (Ideal.Quotient.mk L) ≤ p →
      ∃ h : T ⧸ L, h ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away h,
        (K.map (Ideal.Quotient.mk L)).map
            (algebraMap (T ⧸ L) (Localization.Away h)) = Ideal.span (Set.range f) ∧
          RingTheory.Sequence.IsKoszulRegular f) :
    L ⊓ K ^ 2 = L * K := by
  sorry

end Ideal
