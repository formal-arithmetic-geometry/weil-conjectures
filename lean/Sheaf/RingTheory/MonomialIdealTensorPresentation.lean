module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.TensorProduct.Basic

import Mathlib.Algebra.MonoidAlgebra.Ideal

/-! # Monomial generators and relations for an ideal tensor

Source: Stacks, Tag 00CX, and the finite monomial calculation in ILO VI 3.7(a)
and VIII 3.4.3 (blueprint: lem-trf-monomial-ideal-tensor-presentation).
-/

@[expose] public section

set_option autoImplicit false

universe u w t

open scoped TensorProduct

namespace MonoidAlgebra.MonomialIdealTensorPresentation

variable {Q : Type u} [CommMonoid Q] (K : Set Q)
variable (I : Ideal (MonoidAlgebra ℤ Q))
variable (hI : I = Ideal.span (MonoidAlgebra.of ℤ Q '' K))

/-- A specified monomial of the ideal. -/
noncomputable def monomial (q : Q) (hq : q ∈ K) : I :=
  ⟨MonoidAlgebra.of ℤ Q q, hI ▸ Ideal.subset_span (Set.mem_image_of_mem _ hq)⟩

variable {K I}

@[simp] theorem monomial_coe (q : Q) (hq : q ∈ K) :
    (monomial K I hI q hq : MonoidAlgebra ℤ Q) = MonoidAlgebra.of ℤ Q q := rfl

theorem monomial_mul (hK : ∀ q ∈ K, ∀ r : Q, q * r ∈ K)
    (q : Q) (hq : q ∈ K) (r : Q) :
    monomial K I hI (q * r) (hK q hq r) =
      MonoidAlgebra.of ℤ Q r • monomial K I hI q hq := by
  apply Subtype.ext
  simp [smul_eq_mul, mul_comm]

variable {A : Type w} [CommRing A] (e : MonoidAlgebra ℤ Q →+* A)

/-- Balancing on monomial generators. -/
theorem tmul_monomial_mul (hK : ∀ q ∈ K, ∀ r : Q, q * r ∈ K)
    (q : Q) (hq : q ∈ K) (r : Q) (a : A) :
    letI := e.toAlgebra
    a ⊗ₜ[MonoidAlgebra ℤ Q] monomial K I hI (q * r) (hK q hq r) =
      (e (MonoidAlgebra.of ℤ Q r) * a) ⊗ₜ[MonoidAlgebra ℤ Q] monomial K I hI q hq := by
  let := e.toAlgebra
  rw [monomial_mul hI hK q hq r, TensorProduct.tmul_smul]
  rfl

/-- Additive maps out of this tensor are determined on monomial pure tensors. -/
theorem addHom_ext {N : Type t} [AddCommGroup N]
    (f g : (letI := e.toAlgebra; A ⊗[MonoidAlgebra ℤ Q] I) →+ N)
    (h : ∀ q (hq : q ∈ K) (a : A),
      f (by letI := e.toAlgebra; exact a ⊗ₜ monomial K I hI q hq) =
        g (by letI := e.toAlgebra; exact a ⊗ₜ monomial K I hI q hq)) : f = g := by
  let := e.toAlgebra
  subst I
  apply AddMonoidHom.ext
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simp [hx, hy]
  | tmul a x =>
    suffices H : ∀ a, f (a ⊗ₜ x) = g (a ⊗ₜ x) from H a
    obtain ⟨x, hx⟩ := x
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      exact fun a ↦ h q hq a
    | zero =>
      intro a
      change f (a ⊗ₜ (0 : Ideal.span _)) = g (a ⊗ₜ (0 : Ideal.span _))
      simp
    | add x y hx hy ihx ihy =>
      intro a
      change f (a ⊗ₜ ((⟨x, hx⟩ : Ideal.span _) + ⟨y, hy⟩)) =
        g (a ⊗ₜ ((⟨x, hx⟩ : Ideal.span _) + ⟨y, hy⟩))
      simp only [TensorProduct.tmul_add, map_add, ihx, ihy]
    | smul r x hx ih =>
      intro a
      change f (a ⊗ₜ (r • (⟨x, hx⟩ : Ideal.span _))) =
        g (a ⊗ₜ (r • (⟨x, hx⟩ : Ideal.span _)))
      rw [TensorProduct.tmul_smul]
      exact ih _

include hI in
private theorem ideal_support (hK : ∀ q ∈ K, ∀ r : Q, q * r ∈ K) :
    I.restrictScalars ℤ = MonoidAlgebra.supported ℤ ℤ K := by
  ext x
  change x ∈ I ↔ ∀ q ∈ x.coeff.support, q ∈ K
  rw [hI, MonoidAlgebra.mem_ideal_span_of_image]
  constructor
  · intro h q hq
    obtain ⟨q₀, hq₀, r, hr⟩ := h q hq
    rw [hr, mul_comm]
    exact hK q₀ hq₀ r
  · intro h q hq
    exact ⟨q, h q hq, 1, by simp⟩

private noncomputable def monomialBasis
    (hK : ∀ q ∈ K, ∀ r : Q, q * r ∈ K) : Module.Basis K ℤ I :=
  Module.Basis.ofRepr
    ((LinearEquiv.ofEq _ _ (ideal_support hI hK)).trans
      (MonoidAlgebra.supportedEquivFinsupp K))

private theorem monomialBasis_apply (hK : ∀ q ∈ K, ∀ r : Q, q * r ∈ K)
    (q : Q) (hq : q ∈ K) :
    monomialBasis hI hK ⟨q, hq⟩ = monomial K I hI q hq := by
  apply Subtype.ext
  change MonoidAlgebra.ofCoeff
    (((Finsupp.supportedEquivFinsupp (R := ℤ) K).symm
      (Finsupp.single (⟨q, hq⟩ : K) 1) : Finsupp.supported ℤ ℤ K) : Q →₀ ℤ) = _
  rw [Finsupp.supportedEquivFinsupp_symm_single]
  rfl

/-- The monomial presentation of an ideal tensor: a family of vectors indexed by
an ideal of a commutative monoid extends to a coefficient-linear map precisely when
multiplication of indices agrees with the evaluated scalar action.

Source: Stacks, Tag 00CX (tensor universal property), applied to the finite-monomial
calculation of ILO VI 3.7(a), printed p. 75, and VIII 3.4.3, printed p. 110.
(blueprint: lem-trf-monomial-ideal-tensor-presentation).

Proof: Since K is closed under multiplication by Q, the ideal generated by its
monomials consists exactly of the finite integer sums supported on K. Its underlying
abelian group is therefore free on those monomials, including when K is empty.
Send each basis monomial z^q to b(q) and extend by integer linearity. The displayed
relation implies f(z^r z^q) = e(z^r) f(z^q). Integer linearity in both factors extends
this to f(sx) = e(s) f(x) for every s in Z[Q] and x in I. Thus (a,x) maps to a f(x)
bilinearly and is balanced over Z[Q]. The tensor universal property gives the
A-linear map with the stated values. No cancellation or nonzero character value
is needed. -/
theorem exists_lift (hK : ∀ q ∈ K, ∀ r : Q, q * r ∈ K)
    {N : Type t} [AddCommGroup N] [Module A N]
    (b : K → N)
    (hb : ∀ (q : Q) (hq : q ∈ K) (r : Q),
      b ⟨q * r, hK q hq r⟩ = e (MonoidAlgebra.of ℤ Q r) • b ⟨q, hq⟩) :
    letI := e.toAlgebra
    ∃ f : A ⊗[MonoidAlgebra ℤ Q] I →ₗ[A] N,
      ∀ (q : Q) (hq : q ∈ K) (a : A),
        f (a ⊗ₜ monomial K I hI q hq) = a • b ⟨q, hq⟩ := by
  classical
  let B := monomialBasis hI hK
  let l : I →ₗ[ℤ] N := B.constr ℤ b
  have hl (q : Q) (hq : q ∈ K) : l (monomial K I hI q hq) = b ⟨q, hq⟩ := by
    rw [← monomialBasis_apply hI hK q hq]
    exact B.constr_basis ℤ b ⟨q, hq⟩
  have H : ∀ r : MonoidAlgebra ℤ Q, ∀ x : I, l (r • x) = e r • l x := by
    intro r
    induction r using MonoidAlgebra.induction_on with
    | of r =>
      have H : l.comp (DistribSMul.toLinearMap ℤ I (MonoidAlgebra.of ℤ Q r)) =
          e (MonoidAlgebra.of ℤ Q r) • l := by
        apply B.ext
        rintro ⟨q, hq⟩
        change l (MonoidAlgebra.of ℤ Q r • B ⟨q, hq⟩) =
          e (MonoidAlgebra.of ℤ Q r) • l (B ⟨q, hq⟩)
        rw [show B ⟨q, hq⟩ = monomial K I hI q hq from monomialBasis_apply hI hK q hq,
          ← monomial_mul hI hK q hq r, hl, hl]
        exact hb q hq r
      exact fun x ↦ LinearMap.congr_fun H x
    | add r s hr hs =>
      intro x
      simp only [add_smul, map_add, hr, hs]
    | smul n r hr =>
      intro x
      simp only [smul_assoc, map_smul, map_zsmul, hr]
  let := e.toAlgebra
  let := Module.compHom N e
  let : IsScalarTower (MonoidAlgebra ℤ Q) A N :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let lR : I →ₗ[MonoidAlgebra ℤ Q] N :=
    { l.toAddMonoidHom with map_smul' := fun r x ↦ H r x }
  refine ⟨lR.liftBaseChange A, ?_⟩
  intro q hq a
  rw [LinearMap.liftBaseChange_tmul]
  exact congrArg (a • ·) (hl q hq)

end MonoidAlgebra.MonomialIdealTensorPresentation
