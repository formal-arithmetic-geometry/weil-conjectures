module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Affine dilatation algebra

Source: BLR, Neron Models, 3.2, printed pp.62-63 (PDF pp.68-69).
(blueprint: def-sfb-affine-dilatation-algebra)
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Algebra

/-- The fraction `b / π` in `B[1/π]`.
Source: BLR 3.2, affine construction, printed pp.62-63.
(blueprint: def-sfb-affine-dilatation-algebra) -/
noncomputable def dilatationFraction {B : Type u} [CommRing B] (π b : B) :
    Localization.Away π :=
  algebraMap B (Localization.Away π) b *
    IsLocalization.Away.invSelf (S := Localization.Away π) π

/-- The actual `B`-subalgebra of `B[1/π]` generated by the fractions `b/π`, `b ∈ I`.
Source: BLR 3.2, affine construction, printed pp.62-63.
(blueprint: def-sfb-affine-dilatation-algebra) -/
noncomputable def affineDilatationAlgebra {B : Type u} [CommRing B] (π : B) (I : Ideal B) :
    Subalgebra B (Localization.Away π) :=
  Algebra.adjoin B (dilatationFraction π '' (I : Set B))

/-- The canonical generator `b/π` of the affine dilatation algebra.
Source: BLR 3.2, affine construction, printed pp.62-63.
(blueprint: def-sfb-affine-dilatation-algebra) -/
noncomputable def affineDilatationGenerator {B : Type u} [CommRing B]
    (π : B) (I : Ideal B) (b : I) : affineDilatationAlgebra π I :=
  ⟨dilatationFraction π b, Algebra.subset_adjoin ⟨b, b.property, rfl⟩⟩

end Algebra
