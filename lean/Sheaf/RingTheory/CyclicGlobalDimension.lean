module
public import Sheaf.RingTheory.GlobalDimension
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.Algebra.Module.ULift
@[expose] public section
universe u v
namespace Ring
/-- Cyclic modules control global dimension via the well-ordered filtration argument.

Source: Stacks Project, Algebra, Lemma 065T (lines 26867--26878).
(blueprint: lem-weil-pbc-global-dimension-finite-modules-suffice-cyclic-to-global)

Proof plan: for an arbitrary module `M`, well-order a generating set and filter `M` by the
submodules generated by initial segments.  Each successive quotient is generated by one
class, hence is a quotient `R ⧸ I` of `R` for the kernel of the map sending `r` to the
corresponding scalar multiple of that class.  Transport the assumed projective resolution
of `R ⧸ I` across this cyclic identification.  The well-ordered-union projective-dimension
lemma then gives a projective resolution of `M` of length at most `n`; since `M` was
arbitrary, this is `HasGlobalDimensionLE R n`.  The formal proof is split off here because
this filtration and transport argument is not yet available in the library.
-/
theorem hasGlobalDimensionLE_of_cyclic
    (R : Type u) [CommRing R] (n : ℕ)
    (hcyc : ∀ I : Ideal R,
      ModuleCat.HasProjectiveResolutionLE
        (ModuleCat.of R (ULift.{v} (R ⧸ I))) n) :
    HasGlobalDimensionLE.{u, max u v} R n := by
  sorry
end Ring
