module

public import Mathlib.Algebra.MonoidAlgebra.Ideal
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Map
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Defs

/-!
# Residue surjections from quotients of monomial ideals

Source: Illusie–Laszlo–Orgogozo, Travaux de Gabber, Exposé VIII, Lemma 3.4.3,
proof, printed p. 110 (PDF p. 116)
(blueprint: lem-trf-monomial-quotient-residue-surjection).

The final map is given as an additive homomorphism with its full A-scalar law.
The action of c on Q tensor A is the tensor of the identity with multiplication by c.
This keeps the source factors in the order used in the source statement.
-/

@[expose] public section

set_option autoImplicit false

universe u v

open scoped TensorProduct

namespace AddMonoidAlgebra

/-- The ideal generated by the monomials with exponents in I.
Source: ILO VIII, Lemma 3.4.3 proof, printed p. 110
(blueprint: lem-trf-monomial-quotient-residue-surjection). -/
noncomputable abbrev monomialSpan {P : Type u} [AddCommMonoid P] (I : Set P) :
    Ideal (AddMonoidAlgebra ℤ P) :=
  Ideal.span (of' ℤ P '' I)

/-- The module quotient KR/JR, with JR pulled back along the inclusion KR into R.
Source: ILO VIII, Lemma 3.4.3 proof, printed p. 110
(blueprint: lem-trf-monomial-quotient-residue-surjection). -/
noncomputable abbrev monomialQuotient {P : Type u} [AddCommMonoid P] (J K : Set P) :=
  (monomialSpan K : Type u) ⧸
    (Submodule.comap
      (R := AddMonoidAlgebra ℤ P) (R₂ := AddMonoidAlgebra ℤ P)
      (monomialSpan K : Submodule (AddMonoidAlgebra ℤ P) (AddMonoidAlgebra ℤ P)).subtype
      (monomialSpan J : Submodule (AddMonoidAlgebra ℤ P) (AddMonoidAlgebra ℤ P)))

/-- The extended ideal generated by the nonzero monomials in an R-algebra A.
Source: ILO VIII, Lemma 3.4.3 proof, printed p. 110
(blueprint: lem-trf-monomial-quotient-residue-surjection). -/
noncomputable abbrev monomialResidueIdeal (P : Type u) [AddCommMonoid P]
    (A : Type v) [CommRing A] [Algebra (AddMonoidAlgebra ℤ P) A] : Ideal A :=
  (monomialSpan {q : P | q ≠ 0}).map (algebraMap (AddMonoidAlgebra ℤ P) A)

/-- A minimal surviving monomial coefficient gives the residue surjection and its base change.
Source: ILO VIII, Lemma 3.4.3 proof, printed p. 110 (PDF p. 116)
(blueprint: lem-trf-monomial-quotient-residue-surjection).

Proof:
1. For a monoid ideal I, finite sums supported in I form a ring ideal: multiplying
   by a monomial preserves support in I, and finite expansion handles all multipliers.
   This ideal contains the generators of IR; conversely each supported term lies in IR.
2. Delete coordinates in J. Its kernel on KR is JR by step 1, and reinsertion of the
   remaining coordinates gives an inverse on the quotient. Thus the surviving monomial
   classes form a Z-basis indexed by K minus J.
3. Sharpness forces any pair summing to zero to be (0,0), so constant coefficient
   is multiplicative. Its kernel is the nonzero-monomial ideal by step 1. Constants
   give the inverse of the induced ring isomorphism R/m to Z.
4. In a product a*r with r in KR, a contribution at p with a nonzero exponent from a
   contradicts the indecomposability assumption on p. Hence (a*r)_p = a_0*r_p.
   The coefficient vanishes on JR since p is outside J, giving the semilinear map.
   The class of n*e_p maps to n, proving surjectivity.
5. For B = A/mA, finite expansion gives f(a) = a_0 in B. The bilinear map
   (n,b) to n*b in B identifies Z tensor_R A with B by the tensor universal property
   of def-weil-pbc-module-tensor-product. Its inverse sends the class of b to 1 tensor b:
   it kills each f(e_q)*b for q nonzero since e_q acts as zero on Z. These maps are
   inverse on pure tensors and on quotient representatives.
6. Tensor the coefficient map with id_A and compose with step 5. On pure tensors
   it sends [r] tensor b to r_p*b modulo mA. Multiplication on the second factor
   commutes with f(a), so it respects the tensor relations and gives the A-scalar law.
   Every class of b has preimage [e_p] tensor b, including when the target ring is zero.
-/
theorem monomial_quotient_residue_surjection
    (P : Type u) [AddCancelCommMonoid P]
    (hsharp : ∀ x y : P, x + y = 0 → x = 0 ∧ y = 0)
    (J K : Set P) (hJK : J ⊆ K)
    (hJ : ∀ j ∈ J, ∀ q : P, j + q ∈ J)
    (hK : ∀ k ∈ K, ∀ q : P, k + q ∈ K)
    (p : P) (hpK : p ∈ K) (hpJ : p ∉ J)
    (hp : ∀ k ∈ K, ∀ q : P, q ≠ 0 → k + q ≠ p) :
    (∀ (I : Set P), (∀ i ∈ I, ∀ q : P, i + q ∈ I) →
      ∀ r : AddMonoidAlgebra ℤ P,
        r ∈ monomialSpan I ↔ ∀ q : P, r.coeff q ≠ 0 → q ∈ I) ∧
    (∃ b : Module.Basis {k : P // k ∈ K \ J} ℤ (monomialQuotient J K),
      ∀ k : {k : P // k ∈ K \ J},
        b k = Submodule.Quotient.mk
          ⟨of' ℤ P k.val, Ideal.subset_span (Set.mem_image_of_mem _ k.property.1)⟩) ∧
    ∃ ε : AddMonoidAlgebra ℤ P →+* ℤ,
      (∀ r : AddMonoidAlgebra ℤ P, ε r = r.coeff 0) ∧
      RingHom.ker ε = monomialSpan {q : P | q ≠ 0} ∧
      (∃ e : (AddMonoidAlgebra ℤ P ⧸ monomialSpan {q : P | q ≠ 0}) ≃+* ℤ,
        ∀ r : AddMonoidAlgebra ℤ P,
          e (Ideal.Quotient.mk (monomialSpan {q : P | q ≠ 0}) r) = ε r) ∧
      (∃ φ : monomialQuotient J K →ₛₗ[ε] ℤ,
        Function.Surjective φ ∧
        ∀ r : monomialSpan K, φ (Submodule.Quotient.mk r) = r.val.coeff p) ∧
      ∀ (A : Type v) [CommRing A] [Algebra (AddMonoidAlgebra ℤ P) A],
        ∃ Φ : (monomialQuotient J K ⊗[AddMonoidAlgebra ℤ P] A) →+
            (A ⧸ monomialResidueIdeal P A),
          Function.Surjective Φ ∧
          (∀ (c : A) (x : monomialQuotient J K ⊗[AddMonoidAlgebra ℤ P] A),
            Φ ((LinearMap.lTensor (monomialQuotient J K)
              (LinearMap.mulLeft (AddMonoidAlgebra ℤ P) c)) x) = c • Φ x) ∧
          ∀ (r : monomialSpan K) (b : A),
            Φ ((Submodule.Quotient.mk r) ⊗ₜ[AddMonoidAlgebra ℤ P] b) =
              Ideal.Quotient.mk (monomialResidueIdeal P A) ((r.val.coeff p : A) * b) := by
  sorry

end AddMonoidAlgebra
