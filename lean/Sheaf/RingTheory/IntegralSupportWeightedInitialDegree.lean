import Mathlib.Algebra.MonoidAlgebra.MapDomain
import Mathlib.GroupTheory.Finiteness
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import Sheaf.AlgebraicGeometry.FineFanBlowup

/-!
# Negative support weights obstruct integrality

Source: Illusie--Laszlo--Orgogozo, Exposé VIII, Lemma 3.2.9 and the monomial-basis
normalization argument, printed p.104. The least-weight argument is expanded in the DAG
(blueprint: lem-trf-integral-support-weighted-initial-degree).
-/

set_option autoImplicit false

universe u v

namespace AddMonoidAlgebra

/-- An element with a negative-weight exponent in its actual support is not integral over
an additive submonoid algebra all of whose monomials have nonnegative weight.
The inclusion is the canonical monomial map, so integrality refers to this particular map.
Source: Illusie--Laszlo--Orgogozo, Exposé VIII, Lemma 3.2.9, printed p.104; the explicit
least-weight argument in the DAG is agent-written
(blueprint: lem-trf-integral-support-weighted-initial-degree).

Proof:
1. In the finite nonempty actual support of `x`, choose the minimum weight `m < 0`.
   The weight-`m` component `y` is nonzero, since it retains a nonzero coefficient attaining
   the minimum. Taking a fixed weight component is additive. The canonical monomial map
   from `k[P]` is injective by comparing coefficients at each element of `P`.
2. Choose finitely many group generators of `H`. The additive submonoid generated by them
   and their negatives is all of `H`. Applying `lem-trf-monoid-algebra-domain-fraction`
   gives that `k[H]` is a domain, so `y^j` is nonzero for every natural number `j`.
3. By finite-convolution induction, every support exponent of `x^j` has weight at least
   `j*m`, and its weight-`j*m` component is `y^j`. At `j = 0`, both components are `1`.
   In the induction step, a pair of exponents can attain `(j+1)*m` only if its two weights
   attain their respective lower bounds `j*m` and `m`. Thus the component of the product
   is exactly `y^j*y`. Cancellation can remove exponents but cannot create lower ones.
4. A monic equation for `x` over `k[P]` has positive degree `n`, since a monic constant
   polynomial is `1` and `k[H]` is nontrivial. Each coefficient has nonnegative support
   weights. Hence its product with `x^i`, for `i < n`, has weights at least `i*m > n*m`.
   Taking the weight-`n*m` component of the equation gives `y^n = 0`, a contradiction.
-/
theorem not_isIntegralElem_of_negative_support_weight
    {k : Type u} [Field k] {H : Type v} [AddCommGroup H]
    [AddGroup.FG H] [IsAddTorsionFree H]
    (P : AddSubmonoid H) (w : H →+ ℤ) (hw : ∀ p ∈ P, 0 ≤ w p)
    (x : AddMonoidAlgebra k H) (hx : x ≠ 0)
    (hneg : ∃ g ∈ x.coeff.support, w g < 0) :
    ¬ (AddMonoidAlgebra.mapDomainRingHom k P.subtype).IsIntegralElem x := by
  sorry

end AddMonoidAlgebra
