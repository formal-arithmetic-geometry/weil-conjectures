import WeilConjectures.Mathlib.RingTheory.DiscreteValuationRing.TFAE

/-!
# Monic Eisenstein quotients of discrete valuation rings

Source: Stacks Project, more-algebra.tex, Tag 09ER, proof of
`lemma-weakly-unramified-goes-up-along-totally-ramified`, final sentence;
algebra.tex, Tag 00PD (blueprint: lem-sfb-eisenstein-quotient-dvr).

The quotient is the existing `AdjoinRoot P`, and its distinguished element is
`AdjoinRoot.root P`. No completeness, separability or characteristic restriction is needed.
-/

@[expose] public section

universe u

set_option autoImplicit false

namespace IsDiscreteValuationRing

/-- A monic Eisenstein quotient of a DVR is a DVR with maximal ideal generated by the root.

Source: Stacks Project, more-algebra.tex, Tag 09ER, final sentence of the proof of
`lemma-weakly-unramified-goes-up-along-totally-ramified`; algebra.tex, Tag 00PD.
(blueprint: lem-sfb-eisenstein-quotient-dvr)

Proof:
1. The DVR is a local PID, hence Noetherian by `lem-weil-pbc-pid-noetherian-normal`.
   By `lem-weil-pbc-monic-quotient-free`, the quotient has basis `1, x, ..., x^(n-1)`.
   Since `n > 0`, constants inject into the quotient. Finite generation makes the
   quotient integral and Noetherian by `lem-weil-pbc-finite-algebra-is-integral` and
   `lem-weil-pbc-finite-algebra-noetherian`.
2. Write `a₀ = πu`. If `u` were a nonunit, it would lie in `(π)`, contradicting
   `a₀ ∉ (π²)`. Thus `u` is a unit. The polynomial relation gives
   `πu = -x * (x^(n-1) + ∑ (1 ≤ i < n), aᵢ * x^(i-1))`, so `π ∈ (x)`.
   Evaluation at zero modulo `π` and the constants map identify the quotient by
   `(x)` with `R/(π)`. Therefore `(x)` is maximal.
3. By `lem-weil-pbc-integral-maximal-contracts-maximal`, every maximal ideal of the
   quotient contracts to `(π)`. The polynomial relation gives `x^n` in that ideal;
   primality and `n > 0` imply it contains `x`. Maximality of `(x)` forces equality,
   so the quotient is local and its maximal ideal is `(x)`.
4. Write `aᵢ = πbᵢ` with `b₀ = u`. Then `x^n = -πv`, where
   `v = u + ∑ (1 ≤ i < n), bᵢ * x^i` is a unit in the local quotient. Consequently
   `(x^(nk)) = (π^k)` for all `k`. By `lem-weil-pbc-dvr-unit-times-uniformizer-power`,
   each nonzero element of `R` is a unit times a power of `π`; cancellation shows
   it does not lie in the next power. Thus the intersection of the powers of `(π)`
   in `R` is zero. The free basis gives the same intersection assertion in the
   quotient, hence the intersection of the powers of `(x)` is zero. Every nonzero
   quotient element is therefore `x^k` times a unit, by choosing the largest power
   of `(x)` containing it. A product of two such nonzero elements cannot be zero:
   otherwise a power of `x` vanishes, hence a power of `π` vanishes by `x^n = -πv`,
   contradicting the injection from the domain `R`. The quotient is a domain.
5. If `x = 0`, then `a₀ = 0` in the quotient, hence in `R`, contrary to
   `a₀ ∉ (π²)`. Now `lem-sc-principal-ideal-dvr` applies to the Noetherian local
   domain with nonzero principal maximal-ideal generator `x` and proves it is a DVR.
-/
theorem adjoinRoot_of_monic_eisenstein
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (n : ℕ) (hn : 1 ≤ n) (P : Polynomial R) (hP : P.Monic) (hdeg : P.natDegree = n)
    (hcoeff : ∀ i : ℕ, i < n → P.coeff i ∈ Ideal.span {π})
    (hconst : P.coeff 0 ∉ Ideal.span {π ^ 2}) :
    ∃ (_ : IsDomain (AdjoinRoot P)) (_ : IsDiscreteValuationRing (AdjoinRoot P)),
      IsLocalRing.maximalIdeal (AdjoinRoot P) = Ideal.span {AdjoinRoot.root P} := by
  classical
  let A := AdjoinRoot P
  let x : A := AdjoinRoot.root P
  have hnpos : 0 < n := hn
  have hei : P.IsEisensteinAt (Ideal.span {π}) := by
    apply hP.isEisensteinAt_of_mem_of_notMem
    · rw [← hπ]
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    · intro i hi
      exact hcoeff i (hdeg ▸ hi)
    · simpa only [Ideal.span_singleton_pow] using hconst
  have hirr : Irreducible P := hei.irreducible
    (by rw [← hπ]; infer_instance) hP.isPrimitive (hdeg ▸ hnpos)
  let hdom : IsDomain A := AdjoinRoot.isDomain_of_prime hirr.prime
  let := hP.finite_adjoinRoot
  let : Algebra.IsIntegral R A := Algebra.IsIntegral.of_finite R A
  let : IsNoetherianRing A := IsNoetherianRing.of_finite R A
  have hinj : Function.Injective (algebraMap R A) := by
    apply AdjoinRoot.of.injective_of_degree_ne_zero
    rw [Polynomial.degree_eq_natDegree hP.ne_zero, hdeg]
    exact_mod_cast hnpos.ne'
  obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp (hcoeff 0 hnpos)
  have huunit : IsUnit u := by
    by_contra h
    have humem : u ∈ Ideal.span {π} := by
      rw [← hπ]
      exact h
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton.mp humem
    apply hconst
    apply Ideal.mem_span_singleton.mpr
    refine ⟨v, ?_⟩
    rw [hu, hv]
    ring
  let J : Ideal A := Ideal.span {x}
  let θ : A →+* A ⧸ J := Ideal.Quotient.mk J
  have hx : θ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_span_singleton_self x)
  have hc0 : θ (algebraMap R A (P.coeff 0)) = 0 := by
    have h := congrArg θ (AdjoinRoot.eval₂_root P)
    rw [Polynomial.hom_eval₂, hx, Polynomial.eval₂_at_zero, map_zero] at h
    exact h
  have hπ0 : θ (algebraMap R A π) = 0 := by
    rw [hu, map_mul, map_mul] at hc0
    exact (huunit.map (θ.comp (algebraMap R A))).mul_left_eq_zero.mp hc0
  let k := R ⧸ Ideal.span {π}
  let : (Ideal.span {π}).IsMaximal := by rw [← hπ]; infer_instance
  let : Field k := Ideal.Quotient.field _
  let φ : A →+* k := AdjoinRoot.lift (f := P) (Ideal.Quotient.mk _) 0 (by
    rw [Polynomial.eval₂_at_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hcoeff 0 hnpos))
  have hφ : Function.Surjective φ := by
    intro b
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    exact ⟨AdjoinRoot.of P b, AdjoinRoot.lift_of _⟩
  let ψ : k →+* A ⧸ J := Ideal.Quotient.lift (Ideal.span {π})
    (θ.comp (algebraMap R A)) (by
      intro b hb
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp hb
      simp [hπ0])
  have hcomp : ψ.comp φ = θ := by
    apply AdjoinRoot.ringHom_ext
    · ext b
      change ψ (φ (AdjoinRoot.of P b)) = θ (AdjoinRoot.of P b)
      rw [show φ (AdjoinRoot.of P b) = Ideal.Quotient.mk (Ideal.span {π}) b
        from AdjoinRoot.lift_of _]
      exact Ideal.Quotient.lift_mk _ _ _
    · change ψ (φ x) = θ x
      rw [show φ x = 0 from AdjoinRoot.lift_root _, map_zero, hx]
  have hker : RingHom.ker φ = J := by
    apply le_antisymm
    · intro b hb
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change θ b = 0
      rw [← hcomp]
      simp only [RingHom.comp_apply, RingHom.mem_ker.mp hb, map_zero]
    · apply Ideal.span_le.mpr
      intro b hb
      obtain rfl := Set.mem_singleton_iff.mp hb
      change φ x = 0
      exact AdjoinRoot.lift_root _
  have hJ : J.IsMaximal := hker ▸ RingHom.ker_isMaximal_of_surjective φ hφ
  have hpow : x ^ n ∈ (Ideal.span {π}).map (algebraMap R A) := by
    apply hei.isWeaklyEisensteinAt.pow_natDegree_le_of_aeval_zero_of_monic_mem_map
      (by exact AdjoinRoot.eval₂_root P) hP
    rw [hP.natDegree_map, hdeg]
  have huniq : ∀ M : Ideal A, M.IsMaximal → M = J := by
    intro M hM
    let := hM
    have hc : M.comap (algebraMap R A) = IsLocalRing.maximalIdeal R :=
      IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal M)
    have hle : (Ideal.span {π}).map (algebraMap R A) ≤ M := by
      rw [Ideal.map_le_iff_le_comap, hc, hπ]
    have hxM : x ∈ M := hM.isPrime.mem_of_pow_mem n (hle hpow)
    exact (hJ.eq_of_le hM.ne_top
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxM))).symm
  let : IsLocalRing A := IsLocalRing.of_unique_max_ideal ⟨J, hJ, huniq⟩
  have hmax : IsLocalRing.maximalIdeal A = J := (IsLocalRing.eq_maximalIdeal hJ).symm
  have hxne : x ≠ 0 := by
    intro hx0
    have hc0A : algebraMap R A (P.coeff 0) = 0 := by
      simpa only [show AdjoinRoot.root P = x from rfl, hx0,
        Polynomial.eval₂_at_zero, ← AdjoinRoot.algebraMap_eq] using AdjoinRoot.eval₂_root P
    have hc0R : P.coeff 0 = 0 := hinj (hc0A.trans (map_zero _).symm)
    exact hconst (hc0R ▸ Ideal.zero_mem _)
  exact ⟨hdom, of_maximalIdeal_eq_span_singleton hxne hmax, hmax⟩

end IsDiscreteValuationRing
