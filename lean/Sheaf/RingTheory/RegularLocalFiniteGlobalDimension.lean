module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Sheaf.RingTheory.GlobalDimension

/-!
# Global dimension of a regular local ring

Source: Stacks Project, Algebra, Proposition Tag 00O7, last assertion
(blueprint: lem-weil-pbc-regular-local-finite-gl-dim).
-/

@[expose] public section

universe u v

namespace IsRegularLocalRing

/-- A regular local ring of Krull dimension `d` has global dimension at most `d`:
every module, without a finite generation assumption, has a projective resolution
of length at most `d`. In particular its global dimension is finite.
Source: Stacks Project, Algebra, Proposition Tag 00O7, last assertion
(blueprint: lem-weil-pbc-regular-local-finite-gl-dim).

Proof:
1. The maximal ideal is generated by `d` elements, forming a regular sequence by
   `lem-weil-pbc-regular-local-generators-regular-sequence` (00NQ). Thus depth of
   the ring is at least `d` (`def-weil-pbc-depth`).
2. For a nonzero finite module `M` of depth `e`, apply
   `lem-weil-pbc-cm-local-free-resolution-to-mcm` (00NG): `e ≤ d`, and there is an
   exact finite free resolution ending in a finite module `K`, either zero or of
   depth `d`, with `d - e` steps. If `e = d`, then `K` is isomorphic to `M`.
3. The zero module is free of rank zero; otherwise
   `lem-weil-pbc-regular-local-mcm-free` (00NT) makes `K` free. This gives a free
   resolution of `M` of length `d - e`.
4. Free modules are projective (`def-weil-pbc-projective-module`). Pad the
   resolution with zeros up to degree `d`, using
   `lem-weil-pbc-projective-dimension-well-defined` (1). For `M = 0`, use the zero
   resolution. Every finite module therefore has a projective resolution of
   length at most `d` (`def-weil-pbc-finite-global-dimension`).
5. Apply `lem-weil-pbc-global-dimension-finite-modules-suffice` (065T), implication
   (2) to (1), to pass from finite modules to all modules. This is global
   dimension at most `d`, hence finite global dimension. -/
theorem hasGlobalDimensionLE_of_ringKrullDim_eq
    (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (d : ℕ) (hd : ringKrullDim R = (d : WithBot ℕ∞)) :
    Ring.HasGlobalDimensionLE.{u, max u v} R d := by
  sorry

end IsRegularLocalRing
