module

public import Mathlib.RingTheory.Extension.Presentation.Basic
public import Mathlib.RingTheory.Extension.Cotangent.Basic

/-! Auxiliary stabilization result for localized conormal bases. -/

@[expose] public section

universe u v
open scoped TensorProduct

namespace Algebra

/-- Realize a stable trivialization by adjoining exactly `r` zero variables and choosing
initial relations whose localized conormal classes form a basis of rank exactly `q`.
No smoothness hypothesis or rank bound on the polynomial variables is used here.

Source: Stacks Project, Tag 07EZ, proof of part (e), stabilization and choice of relations
(blueprint: lem-weil-pbc-smooth-stable-conormal-basis-unbounded).

Proof: write `I` for the kernel of the original polynomial presentation. Adjoin `r` variables
`z_i` sent to zero. The new kernel `J` is generated by the old relations and the `z_i`.
Constant terms and linear coefficients in `z_i` induce an isomorphism
`J/J² ≃ (I/I²) × A^r`: the constant term is taken modulo `I²` and each linear coefficient
modulo `I`. For the inverse, lift the coefficients to the old polynomial ring and send
`(g, (b_i))` to `g + ∑ lift(b_i) z_i` modulo `J²`. Different lifts differ by elements of
`J²`, and terms of degree at least two in the new variables vanish modulo `J²`. Thus these
maps are well defined, A-linear and mutually inverse. Localizing and composing with the
input equivalence makes the new localized conormal module free with basis indexed by
`Fin q`. Each basis vector is a class of an element of `J` divided by a power of `a`:
localization commutes with the conormal quotient. Multiply that vector by the corresponding
invertible power of `a` to obtain a basis of numerator classes. Place these `q` numerator
relations first, followed by the old relations and the `r` new variables; they generate `J`.
Reindex the variables by `Fin (n₀ + r)` and the relations by a finite ordinal, keeping the
numerator relations first. This proves `q ≤ m` and the displayed basis values, including
`q = 0` or a zero localization. Only existential theorem data are produced. -/
theorem exists_stabilized_presentation_localized_conormal_basis
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]
    [FinitePresentation R A] (a : A)
    {n₀ m₀ : ℕ} (P₀ : Presentation R A (Fin n₀) (Fin m₀)) (r q : ℕ)
    (hstable : Nonempty
      (((Localization.Away a ⊗[A] P₀.toExtension.Cotangent) ×
        (Fin r → Localization.Away a)) ≃ₗ[Localization.Away a]
        (Fin q → Localization.Away a))) :
    ∃ (m : ℕ) (P : Presentation R A (Fin (n₀ + r)) (Fin m)) (hc : q ≤ m)
      (b : Module.Basis (Fin q) (Localization.Away a)
        (Localization.Away a ⊗[A] P.toExtension.Cotangent)),
      ∀ j : Fin q, b j = 1 ⊗ₜ[A]
        (Extension.Cotangent.mk (P := P.toExtension)
          ⟨P.relation (Fin.castLE hc j),
            P.relation_mem_ker _⟩) := by
  sorry

end Algebra
