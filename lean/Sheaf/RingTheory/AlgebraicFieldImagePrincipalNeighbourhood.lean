module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
import Mathlib.RingTheory.Artinian.Module
import Mathlib.RingTheory.Ideal.Operations

/-!
# Principal neighbourhoods of images of spectra of integral field algebras

Source: Stacks Project, Tag 0E21, `lemma-ample-profinite-set-in-principal-affine`,
the affine case with the trivial ample invertible sheaf
(blueprint: lem-sfb-algebraic-field-image-principal-neighbourhood).
-/

@[expose] public section

universe u v w

namespace PrimeSpectrum

/-- The image of the spectrum of an integral algebra over a field has a principal
open neighbourhood inside every open neighbourhood of its image. The map `comap φ`
is the underlying map of `AlgebraicGeometry.Spec.map`; using prime spectra allows
independent universes for the rings. The algebra may be the zero ring.

Source: Stacks Project, Tag 0E21, `lemma-ample-profinite-set-in-principal-affine`,
affine case with the trivial ample invertible sheaf
(blueprint: lem-sfb-algebraic-field-image-principal-neighbourhood).

Proof:
1. Use the basic-open basis and the image hypothesis to cover `Spec A` by
   `D(φ g)` with `D(g) ≤ W`. The basic-open unit-ideal criterion gives a
   finitely supported relation `∑ i, aᵢ * φ gᵢ = 1`.
2. Adjoin the finitely many coefficients `aᵢ` and elements `φ gᵢ` to `k` inside
   `A`. Integrality makes the resulting subalgebra `B` finite over `k`, hence
   Artinian with finite prime spectrum. The unit relation holds in `B`.
3. Take the inverse-image subring `S = φ⁻¹(B)` of `R`, with its restricted map
   `ψ : S → B`, and let `J` be the ideal of `S` generated by the `gᵢ`.
   The unit relation shows that `J` is contained in no contracted prime of `B`.
4. Finite prime avoidance gives `f ∈ J` avoiding every contracted prime.
   If `Spec B` is empty, take `f = 0`; the avoidance condition is vacuous.
5. Any prime of `A` contracts to a prime of `B`, so its contraction to `R`
   avoids `f`. Any prime of `R` outside `W` contains every `gᵢ`, hence contains
   `f` by the span property. These are the two required inclusions. -/
theorem exists_basicOpen_image_subset_of_integral_field_algebra
    {R : Type u} [CommRing R] {k : Type v} [Field k]
    {A : Type w} [CommRing A] [Algebra k A]
    (hA : ∀ a : A, IsIntegral k a) (φ : R →+* A)
    (W : TopologicalSpace.Opens (PrimeSpectrum R))
    (hW : Set.range (PrimeSpectrum.comap φ) ⊆ (W : Set (PrimeSpectrum R))) :
    ∃ f : R, Set.range (PrimeSpectrum.comap φ) ⊆
      (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) ∧ PrimeSpectrum.basicOpen f ≤ W := by
  classical
  let G := {g : R // PrimeSpectrum.basicOpen g ≤ W}
  have hcover : (⨆ g : G, PrimeSpectrum.basicOpen (φ g)) = ⊤ := by
    apply top_unique
    intro q _
    obtain ⟨U, ⟨g, rfl⟩, hq, hg⟩ :=
      (PrimeSpectrum.isTopologicalBasis_basic_opens.mem_nhds_iff).mp
        (W.isOpen.mem_nhds (hW ⟨q, rfl⟩))
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hg⟩, hq⟩
  have hspan : (1 : A) ∈ Ideal.span (Set.range fun g : G ↦ φ g) := by
    rw [PrimeSpectrum.iSup_basicOpen_eq_top_iff.mp hcover]
    trivial
  obtain ⟨c, hc⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp hspan
  let ι := c.support
  let g : ι → R := fun i ↦ (i.val : R)
  let a : ι → A := fun i ↦ c i.val
  have hsum : ∑ i : ι, a i * φ (g i) = 1 := by
    change ∑ i : c.support, c i.val * φ (i.val : R) = 1
    exact (Finset.sum_coe_sort c.support (fun i : G ↦ c i * φ i)).trans hc
  let T : Set A := Set.range a ∪ Set.range (fun i ↦ φ (g i))
  let B := Algebra.adjoin k T
  have hfinite : T.Finite := (Set.finite_range a).union (Set.finite_range _)
  have : Module.Finite k B :=
    Algebra.finite_adjoin_of_finite_of_isIntegral hfinite (fun x _ ↦ hA x)
  have : IsArtinianRing B := IsArtinianRing.of_finite k B
  let : Fintype (PrimeSpectrum B) := Fintype.ofFinite _
  let S : Subring R := B.toSubring.comap φ
  have hg (i : ι) : φ (g i) ∈ B :=
    Algebra.subset_adjoin (Or.inr ⟨i, rfl⟩)
  have ha (i : ι) : a i ∈ B := Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)
  let ψ : S →+* B :=
    { toFun := fun r ↦ ⟨φ r.val, r.property⟩
      map_one' := Subtype.ext (map_one φ)
      map_mul' := fun x y ↦ Subtype.ext (map_mul φ x.val y.val)
      map_zero' := Subtype.ext (map_zero φ)
      map_add' := fun x y ↦ Subtype.ext (map_add φ x.val y.val) }
  let gS : ι → S := fun i ↦ ⟨g i, hg i⟩
  let aB : ι → B := fun i ↦ ⟨a i, ha i⟩
  have hsumB : ∑ i, aB i * ψ (gS i) = 1 := by
    apply Subtype.val_injective
    simpa [aB, ψ, gS] using hsum
  let J : Ideal S := Ideal.span (Set.range gS)
  let P : PrimeSpectrum B → Ideal S := fun q ↦ q.asIdeal.comap ψ
  have hnot (q : PrimeSpectrum B) : ¬ J ≤ P q := by
    intro h
    have hall (i : ι) : ψ (gS i) ∈ q.asIdeal :=
      h (Ideal.subset_span ⟨i, rfl⟩)
    have hone : (1 : B) ∈ q.asIdeal := by
      rw [← hsumB]
      exact q.asIdeal.sum_mem fun i _ ↦ q.asIdeal.mul_mem_left _ (hall i)
    exact q.isPrime.one_notMem hone
  have havoid : ∃ f : S, f ∈ J ∧ ∀ q : PrimeSpectrum B, f ∉ P q := by
    by_cases hB : IsEmpty (PrimeSpectrum B)
    · exact ⟨0, J.zero_mem, fun q ↦ (hB.false q).elim⟩
    · have : Nonempty (PrimeSpectrum B) := not_isEmpty_iff.mp hB
      let q₀ : PrimeSpectrum B := Classical.choice this
      have hn : ¬ (J : Set S) ⊆ ⋃ q ∈ (Finset.univ : Finset (PrimeSpectrum B)),
          (P q : Set S) := by
        intro h
        obtain ⟨q, _, hq⟩ :=
          (Ideal.subset_union_prime (s := Finset.univ) (f := P) q₀ q₀
            (fun q _ _ _ ↦ q.isPrime.comap ψ)).mp h
        exact hnot q hq
      obtain ⟨f, hf, hfp⟩ := Set.not_subset.mp hn
      refine ⟨f, hf, fun q hq ↦ hfp ?_⟩
      exact Set.mem_iUnion₂.mpr ⟨q, Finset.mem_univ q, hq⟩
  obtain ⟨f, hf, hfp⟩ := havoid
  refine ⟨f.val, ?_, ?_⟩
  · rintro _ ⟨q, rfl⟩
    exact hfp (PrimeSpectrum.comap B.val.toRingHom q)
  · intro q hq
    by_contra hqW
    have hJ : J ≤ q.asIdeal.comap S.subtype := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      change g i ∈ q.asIdeal
      by_contra hgi
      exact hqW ((i.val : G).property hgi)
    exact hq (hJ hf)

end PrimeSpectrum
