module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Regular.RegularSequence
public import Sheaf.RingTheory.IsRegularSystemOfParameters
import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Parameters for a regular local quotient

Source: Stacks Project, Algebra, Tag 00NR, lemma-regular-quotient-regular
(blueprint: lem-weil-pbc-regular-local-quotient-kernel-parameters).
-/

@[expose] public section

universe u

namespace RingTheory

open IsLocalRing

/-- The kernel of a regular local quotient is generated by an initial segment of a
regular system of parameters (`IsLocalRing.IsRegularSystemOfParameters`,
def-weil-pbc-regular-system-of-parameters).

Source: Stacks Project, Algebra, Tag 00NR, lemma-regular-quotient-regular
(blueprint: lem-weil-pbc-regular-local-quotient-kernel-parameters).

The proof follows Tag 00NR. Since `I` is proper in the local ring, it lies in the
maximal ideal. The independent-generator result
`lem-weil-pbc-regular-local-quotient-independent-generators` supplies finitely many
generators of `I` with independent cotangent classes. Their classes are extended to
a basis using the cotangent-dimension result
`lem-weil-pbc-regular-local-cotangent-dimension`; lifts of the remaining basis
vectors lie in the maximal ideal. The Nakayama result
`lem-weil-pbc-nakayama-local-generators` then gives that the resulting list of `d`
elements generates the maximal ideal, i.e. is a regular system of parameters.
Enumerating the original generators first identifies `I` with the ideal of the
initial segment.
(blueprint: lem-weil-pbc-regular-local-quotient-kernel-parameters) -/
theorem exists_parameters_regularLocalQuotient
    (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (d : ℕ) (hd : ringKrullDim R = (d : WithBot ℕ∞))
    (I : Ideal R) (hI : I ≠ ⊤)
    [IsRegularLocalRing (R ⧸ I)] :
    ∃ (xs : List R) (c : ℕ), c ≤ d ∧
      IsLocalRing.IsRegularSystemOfParameters xs ∧
      I = Ideal.ofList (xs.take c) := by
  sorry

end RingTheory
