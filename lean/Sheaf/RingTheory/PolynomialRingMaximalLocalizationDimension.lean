import Mathlib.RingTheory.KrullDimension.Polynomial

/-!
# Dimension of a localized polynomial ring at a maximal ideal

Source: literature/stacks-project/algebra.tex, Algebra, Lemma Tag 00OP
(lemma-dim-affine-space, line 27660) (blueprint:
lem-weil-pbc-polynomial-ring-maximal-localization-dimension).
-/

universe u

namespace MvPolynomial

/--
For a field `k`, the localization of `k[X₁, …, Xₙ]` at any maximal ideal has
Krull dimension `n`.
Source: literature/stacks-project/algebra.tex, Algebra, Lemma Tag 00OP
(lemma-dim-affine-space).
(blueprint: lem-weil-pbc-polynomial-ring-maximal-localization-dimension).

Proof, following the six steps of the node:
1. The residue field κ = P/M is a finite extension of k by
   `lem-weil-pbc-zariski-lemma`. Write αᵢ for the images of the variables and
   κᵢ = k(α₁, …, αᵢ), with κ₀ = k and κₙ = κ.
2. Each αᵢ has a monic minimal polynomial over κᵢ₋₁. By
   `lem-weil-pbc-minimal-polynomial-quotient-field-iso`, evaluation identifies
   its quotient with κᵢ, so κᵢ = k[α₁, …, αᵢ]. Lift its coefficients to
   Rᵢ₋₁ = k[X₁, …, Xᵢ₋₁], preserving the leading coefficient 1, and evaluate
   at Xᵢ to obtain fᵢ ∈ M of positive degree in Xᵢ.
3. Inductively the surjection Rᵢ → κᵢ has kernel (f₁, …, fᵢ).
   Identify Rᵢ₊₁ with Rᵢ[T] using `def-weil-pbc-mv-polynomial-ring`.
   By `lem-weil-pbc-polynomial-coefficient-map-kernel`, the coefficient map
   to κᵢ[T] has kernel (f₁, …, fᵢ)Rᵢ₊₁; the evaluation kernel there is
   the minimal-polynomial ideal. Lifting its multiples gives precisely
   the additional generator fᵢ₊₁.
4. Hence M = (f₁, …, fₙ). For pᵢ = (f₁, …, fᵢ)P, the same coefficient-map
   lemma gives P/pᵢ ≅ κᵢ[Xᵢ₊₁, …, Xₙ], a domain by
   `lem-weil-pbc-polynomial-ring-domain`. Thus all pᵢ are prime, and
   pᵢ ⊊ pᵢ₊₁ because fᵢ₊₁ maps to its nonzero monic minimal polynomial.
5. This chain from (0) to M has length n, giving dim P_M ≥ n by
   `lem-weil-pbc-localization-dimension-chains-below-prime`.
6. A field is Noetherian (`def-weil-pbc-noetherian-ring`), and P and P_M
   are Noetherian by `lem-weil-pbc-finite-type-algebra-noetherian` and
   `lem-weil-pbc-localization-noetherian`. The local maximal ideal MP_M
   (`def-weil-pbc-localization-at-prime`) is generated by the n images fᵢ/1.
   By `lem-weil-pbc-noetherian-local-dimension-le-generators`, dim P_M ≤ n.
   The two bounds give equality, using `def-weil-pbc-krull-dimension-ring`.
-/
theorem ringKrullDim_localizationAtMaximal {k : Type u} [Field k] (n : ℕ)
    (M : Ideal (MvPolynomial (Fin n) k)) [M.IsMaximal] :
    ringKrullDim (Localization.AtPrime M) = (n : WithBot ℕ∞) := by
  sorry

end MvPolynomial
