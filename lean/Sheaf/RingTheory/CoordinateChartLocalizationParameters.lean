module

public import WeilConjectures.Blowup.Affine.ChartAlgebra
public import WeilConjectures.RingTheory.IsRegularSystemOfParameters
public import Sheaf.RingTheory.ChartCoordinateNonzerodivisors
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.TensorProduct.Basic
import Sheaf.RingTheory.ParameterBlowupCoordinateQuotients
import Mathlib.RingTheory.FiniteType

/-! # Localization and parameter systems on global coordinate blowup charts

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, Expose VIII, Lemma 4.2.9,
printed p. 121, and 4.1.8, printed p. 118
(blueprint: lem-trf-coordinate-chart-localization-parameters).

The auxiliary names abbreviate the specified chart, its labelled coordinates,
and its local rings. All chart algebras and parameter systems are existing definitions.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open scoped TensorProduct

namespace AlgebraicGeometry.AffineBlowup.CoordinateChart

variable {A : Type u} [CommRing A] {m : ℕ}

/-- The given global chart, with no locality assumption on the base or the chart.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
abbrev Chart (t : Fin m → A) (i : Fin m) :=
  chartRing (Ideal.span (Set.range t)) (t i)

/-- The named fraction t_j/t_i, including z_i. Membership uses the defining generators.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
def ratio (t : Fin m → A) (i j : Fin m) : Chart t i :=
  ⟨chartFraction (t i) 1 (t j), Algebra.subset_adjoin
    ⟨⟨t j, Ideal.subset_span (Set.mem_range_self j)⟩, rfl⟩⟩

/-- The exceptional coefficient and the distinct nonpivot ratio labels.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
def coordinate (t : Fin m → A) (i : Fin m) :
    Option {j : Fin m // j ≠ i} → Chart t i
  | none => algebraMap A _ (t i)
  | some j => ratio t i j.val

/-- The contraction of the chosen chart point to the base.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
def basePrime (t : Fin m → A) (i : Fin m) (y : PrimeSpectrum (Chart t i)) :
    PrimeSpectrum A :=
  PrimeSpectrum.comap (algebraMap A (Chart t i)) y

/-- The base local ring at the contraction.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
abbrev BaseLocal (t : Fin m → A) (i : Fin m) (y : PrimeSpectrum (Chart t i)) :=
  Localization.AtPrime (basePrime t i y).asIdeal

/-- The local ring at the chart point.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
abbrev ChartLocal (t : Fin m → A) (i : Fin m) (y : PrimeSpectrum (Chart t i)) :=
  Localization.AtPrime y.asIdeal

/-- The same chart construction over the base local ring, inside its away localization.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
abbrev LocalBaseChart (t : Fin m → A) (i : Fin m) (y : PrimeSpectrum (Chart t i)) :=
  chartRing ((Ideal.span (Set.range t)).map (algebraMap A (BaseLocal t i y)))
    (algebraMap A (BaseLocal t i y) (t i))

/-- The canonical local map R to S induced by the original structure map.
Source: ILO VIII, 4.2.9 (blueprint: lem-trf-coordinate-chart-localization-parameters). -/
def baseToLocal (t : Fin m → A) (i : Fin m) (y : PrimeSpectrum (Chart t i)) :
    BaseLocal t i y →+* ChartLocal t i y :=
  Localization.localRingHom (basePrime t i y).asIdeal y.asIdeal
    (algebraMap A (Chart t i)) rfl

/-- Global chart identities, their canonical local identifications, and simultaneous
labelled parameter positions at every point.

Source: ILO VIII, Lemma 4.2.9, printed p. 121, and 4.1.8, printed p. 118
(blueprint: lem-trf-coordinate-chart-localization-parameters).

Proof:
1. The finitely many ratios generate the chart over A, so the finite-type Noetherian
   theorem makes it Noetherian. In the ambient localization t_j=a*z_j, whence IC=(a).
2. Put T=A minus p. The inverse fraction maps c tensor (b/s) to bc/s and c/s to
   c tensor (1/s) identify the tensor ring with T^{-1}C. Localizing the inclusion
   C into A[1/a] stays injective by the fraction-zero criterion. The resulting
   subalgebra of R[1/a] is generated by the same ratios, hence is R[IR/a].
3. The induced prime is T^{-1}y. The maps (c/s)/(d/v) to cv/(sd) and c/d to
   (c/1)/(d/1) identify its localization canonically with C_y. Their contraction
   to R is the maximal ideal pR.
4. If some t_k is outside p, it is a unit in S. Since t_k=a*z_k, a is a unit.
   Contraction forces t_i outside p, so R[1/a]=R and R[IR/a]=R. Localizing its
   maximal ideal changes nothing, giving the claimed canonical isomorphism R to S.
5. In that case regularity comes from R. Divide precisely the nonunit original
   parameters by the unit a. Their positions stay distinct and they still generate
   the same maximal ideal, so they remain part of a regular parameter system.
6. If all t_j lie in p, extend them at distinct positions in a parameter system of R.
   Apply lem-trf-parameter-blowup-algebra-regular to their polynomial chart.
   Multiplication by a is injective and inverting a gives R[1/a]. Thus its image
   there is exactly R[IR/a], preserving coefficients and every ratio. Its localization
   at the induced prime is S and is regular local.
7. Apply lem-trf-parameter-blowup-coordinate-quotients to this polynomial chart.
   All vanishing labelled coordinates occupy distinct positions in one parameter
   system. Retain a and the nonpivot ratios and transport to S. Every other member
   is outside the maximal ideal, hence is a unit. Together with step 5 this covers
   every chart point, without assuming that A or C is local.
-/
theorem localization_and_parameters
    {A : Type u} [CommRing A] [IsRegularRing A]
    (m : ℕ) (hm : 1 ≤ m) (t : Fin m → A) (i : Fin m)
    (ht : ∀ p : PrimeSpectrum A,
      ∃ s : List (Localization.AtPrime p.asIdeal),
        IsLocalRing.IsRegularSystemOfParameters s ∧
        ∃ f : {j : Fin m // t j ∈ p.asIdeal} → Fin s.length,
          Function.Injective f ∧ ∀ j,
            s.get (f j) = algebraMap A (Localization.AtPrime p.asIdeal) (t j.val)) :
    IsNoetherianRing (Chart t i) ∧
    (Ideal.span (Set.range t)).map (algebraMap A (Chart t i)) =
      Ideal.span {algebraMap A (Chart t i) (t i)} ∧
    ratio t i i = 1 ∧
    (∀ j, algebraMap A (Chart t i) (t j) =
      algebraMap A (Chart t i) (t i) * ratio t i j) ∧
    ∀ y : PrimeSpectrum (Chart t i),
      (∃ e : (Chart t i ⊗[A] BaseLocal t i y) ≃ₐ[A] LocalBaseChart t i y,
        (∀ (c : Chart t i) (r : BaseLocal t i y),
          (e (c ⊗ₜ[A] r) :
              Localization.Away (algebraMap A (BaseLocal t i y) (t i))) =
            algebraMap (BaseLocal t i y) _ r *
              Localization.awayMap (algebraMap A (BaseLocal t i y)) (t i) c.val) ∧
        ∃ P : PrimeSpectrum (LocalBaseChart t i y),
          (∀ c : Chart t i, e (c ⊗ₜ[A] 1) ∈ P.asIdeal ↔ c ∈ y.asIdeal) ∧
          ∃ eS : Localization.AtPrime P.asIdeal ≃+* ChartLocal t i y,
            ∀ c : Chart t i,
              eS (algebraMap (LocalBaseChart t i y) _ (e (c ⊗ₜ[A] 1))) =
                algebraMap (Chart t i) (ChartLocal t i y) c) ∧
      (¬ Ideal.span (Set.range t) ≤ (basePrime t i y).asIdeal →
        ∃ a : (ChartLocal t i y)ˣ,
          (a : ChartLocal t i y) =
            algebraMap (Chart t i) (ChartLocal t i y) (algebraMap A (Chart t i) (t i)) ∧
          Function.Bijective (baseToLocal t i y) ∧
          ∀ j : Fin m,
            algebraMap (Chart t i) (ChartLocal t i y) (ratio t i j) =
              baseToLocal t i y (algebraMap A (BaseLocal t i y) (t j)) * ↑(a⁻¹)) ∧
      (Ideal.span (Set.range t) ≤ (basePrime t i y).asIdeal →
        (∃ s : List (BaseLocal t i y), IsLocalRing.IsRegularSystemOfParameters s ∧
          ∃ f : Fin m → Fin s.length, Function.Injective f ∧
            ∀ j, s.get (f j) = algebraMap A (BaseLocal t i y) (t j)) ∧
        ∃ eQ : traceChartRing (fun j ↦ algebraMap A (BaseLocal t i y) (t j))
            Finset.univ i ≃+* LocalBaseChart t i y,
          (∀ r : BaseLocal t i y,
            eQ (algebraMap (BaseLocal t i y) _ r) =
              algebraMap (BaseLocal t i y) (LocalBaseChart t i y) r) ∧
          ∀ (j : Fin m) (hj : j ∈ (Finset.univ : Finset (Fin m)).erase i),
            (eQ (traceChartCoordinate
                (fun k ↦ algebraMap A (BaseLocal t i y) (t k)) Finset.univ i j hj) :
                  Localization.Away (algebraMap A (BaseLocal t i y) (t i))) =
              chartFraction (algebraMap A (BaseLocal t i y) (t i)) 1
                (algebraMap A (BaseLocal t i y) (t j))) ∧
      (∃ hS : IsRegularLocalRing (ChartLocal t i y),
        ∃ s : List (ChartLocal t i y),
          @IsLocalRing.IsRegularSystemOfParameters (ChartLocal t i y) _
            hS.toIsLocalRing hS.toIsNoetherian s ∧
          ∃ f : {l : Option {j : Fin m // j ≠ i} // coordinate t i l ∈ y.asIdeal} →
              Fin s.length,
            Function.Injective f ∧ ∀ l,
              s.get (f l) =
                algebraMap (Chart t i) (ChartLocal t i y) (coordinate t i l.val)) ∧
      (∀ l : Option {j : Fin m // j ≠ i}, coordinate t i l ∉ y.asIdeal →
        IsUnit (algebraMap (Chart t i) (ChartLocal t i y) (coordinate t i l))) := by
  sorry

end AlgebraicGeometry.AffineBlowup.CoordinateChart
