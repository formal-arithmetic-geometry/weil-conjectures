module

public import Mathlib.CategoryTheory.Limits.HasLimits
public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.RingTheory.TensorProduct.Maps
public import WeilConjectures.AlgebraicGeometry.RelativeGlobalCompleteIntersectionPresentation
import Sheaf.Paper.NoetherianApproximation
import Sheaf.Paper.RelativeGlobalCompleteIntersectionBaseChange
import WeilConjectures.RingTheory.FinitePresentationModelStage

/-! # Relative global complete intersections descend along directed ring colimits

Source: Stacks Project, Algebra, Tag 0C33 (lemma-colimit-lci), first proof paragraph,
with persistence by Tag 00SS (1).
(blueprint: lem-trf-relative-global-ci-ring-colimit-descent).

The scalar-action adapter below applies the existing ring-map predicate to the canonical
map `1 ⊗ φ₀`. Its definition installs the algebra structure determined by the given base
ring homomorphism; no additional algebra structure or comparison map is assumed.
-/

@[expose] public section

set_option autoImplicit false

universe u v w x

open CategoryTheory CategoryTheory.Limits

namespace Algebra

/-- The existing relative-global-complete-intersection predicate on `1 ⊗ φ₀`, after
base change along the specified ring map `ρ`. This is a transparent scalar-action adapter.
Source: Stacks Project, Algebra, Tag 0C33, the map in hypothesis (1), and Tag 00SP.
(blueprint: lem-trf-relative-global-ci-ring-colimit-descent). -/
def relativeGlobalCompleteIntersectionBaseChangeCondition
    {R : Type u} {S : Type v} {B₀ : Type w} {C₀ : Type x}
    [CommRing R] [CommRing S] [CommRing B₀] [CommRing C₀]
    [Algebra R B₀] [Algebra R C₀]
    (ρ : R →+* S) (φ₀ : B₀ →ₐ[R] C₀) : Prop :=
  letI : Algebra R S := ρ.toAlgebra
  IsRelativeGlobalCompleteIntersection
    (TensorProduct.map (Algebra.ofId S S) φ₀).toRingHom

/-- A relative global complete intersection at the colimit is one at all sufficiently
late stages. Only `φ₀`, not either original algebra over the base, is finitely presented.
Source: Stacks Project, Algebra, Tag 0C33 (lemma-colimit-lci), first proof paragraph;
persistence follows from Tag 00SS (1).
(blueprint: lem-trf-relative-global-ci-ring-colimit-descent).

Proof:
1. Choose a finite polynomial quotient presentation of the specified colimit map, whose
   nonzero residue-field fibres have dimension the number of variables minus equations.
   Its presentation isomorphism is linear for the source algebra, so its structure map
   is precisely `1 ⊗ φ₀` (def-weil-pbc-relative-global-complete-intersection).
2. Apply lem-weil-pbc-relative-global-complete-intersection-noetherian-approximation to
   obtain a finite type integer subalgebra `P` containing the coefficients, and the same
   relative-global-complete-intersection presentation `Q` over `P`. The ring `P` is finitely
   presented over the integers by lem-weil-pbc-finite-type-noetherian-finite-presentation:
   the integers are Noetherian, since every nonzero ideal is generated by its least positive
   element by Euclidean division, and the zero ideal is principal. The displayed presentation
   makes `Q` finitely presented over `P`. Part (a) of
   lem-weil-pbc-relative-global-complete-intersection-base-change identifies the colimit
   target with the source tensored with `Q` over `P`, compatibly with `1 ⊗ φ₀`.
3. Apply lem-weil-pbc-finite-presentation-model-stage, using finite presentation of `φ₀`,
   of `P` over the integers, and of `Q` over `P`. It gives a stage `i ≥ i₀`, a map from `P`
   to its source, and a compatible isomorphism from that source tensored with `Q` to its
   target. Base change of the presentation gives the required condition at `i`.
4. For `j ≥ i`, identify `Bⱼ ⊗[Bᵢ] Cᵢ` with `Cⱼ`. The first comparison sends
   `(r ⊗ b) ⊗ z` to `r ⊗ ((1 ⊗ φ₀(b))z)`, and its inverse sends `r ⊗ z` to
   `(r ⊗ 1) ⊗ z`. Then apply lem-weil-pbc-tensor-cancel-base-change to cancel the
   intermediate base ring. Balancing verifies these formulas and both inverse identities
   on pure tensors; the structure map is `r ⊗ b ↦ r ⊗ φ₀(b)`. Apply both parts of
   lem-weil-pbc-relative-global-complete-intersection-base-change and transport the
   presentation across this comparison. This proves the condition at every `j ≥ i`.
-/
theorem exists_eventually_relativeGlobalCompleteIntersection
    {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    (F : I ⥤ CommRingCat.{u}) (i₀ : I)
    (B₀ : Type w) (C₀ : Type x) [CommRing B₀] [CommRing C₀]
    [Algebra (F.obj i₀) B₀] [Algebra (F.obj i₀) C₀]
    (φ₀ : B₀ →ₐ[F.obj i₀] C₀) (hfp : φ₀.toRingHom.FinitePresentation)
    (hci : relativeGlobalCompleteIntersectionBaseChangeCondition (colimit.ι F i₀).hom φ₀) :
    ∃ (i : I) (hi : i₀ ≤ i), ∀ (j : I) (hij : i ≤ j),
      relativeGlobalCompleteIntersectionBaseChangeCondition
        (F.map (homOfLE (hi.trans hij))).hom φ₀ := by
  sorry

end Algebra
