module

public import Sheaf.TraceFormula.AffineEtaleCoverComponentCriterion
public import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.AlgebraicGeometry.Morphisms.QuasiSeparated
import WeilConjectures.Topology.SpectralSpace.ConnectedComponent

/-!
# Component quotients of tensor products

Source: Stacks Project, Algebra, Tag 00EG (`lemma-connected-component`), applied to the
factor projections and the idempotent quotient of the tensor product
(blueprint: lem-trf-tensor-component-from-factor-components).
-/

@[expose] public section

universe u v w

open scoped TensorProduct

namespace AlgebraicGeometry

/-- A component quotient of a tensor product factors through the tensor product of the
component quotients of its factors, and is itself a component quotient of that tensor product.
The final equality identifies the quotient map, hence also its composites with both factor
maps, including the maps from the original algebras.

Source: Stacks Project, Algebra, Tag 00EG (`lemma-connected-component`); component reduction
implicit in Hübner–Schmidt, Theorem 6.4, printed p. 13
(blueprint: lem-trf-tensor-component-from-factor-components).

Proof:
1. Every affine spectrum is quasi-compact, quasi-separated and has a compact-open basis
   (`lem-weil-pbc-spec-basic-opens-unit-ideal-quasi-compact`,
   `lem-weil-pbc-quasi-separated-affine-cover-criterion`, `lem-weil-pbc-qcqs-scheme-spectral`).
2. By `lem-weil-pbc-quasicompact-components-clopen-intersection` and
   `lem-weil-pbc-spec-clopen-idempotent`, the component of z is V(I_z). The quotient-spectrum
   homeomorphism (`lem-weil-pbc-spec-quotient-homeomorphism-zero-locus`) identifies its
   component ring spectrum with this nonempty connected subset.
3. The continuous images under the two projections are connected and nonempty. Choose the
   components of the images of z; maximality puts the whole projected component in each.
4. Every generating idempotent of either factor component ideal maps to a generating
   idempotent of I_z. The two factor maps to the component ring therefore descend to D₁,D₂.
   The tensor pushout universal property gives r and r q = p. Lift pure tensors through the
   two quotient maps to see q is surjective; since p is surjective, r is surjective too.
5. The kernel K of r is q(I_z), hence is generated by the images of the generating
   idempotents of I_z. This does not require arbitrary idempotents to lift through q.
6. The quotient-spectrum embeddings identify W = V(K) with the component of z. A larger
   connected subset of Spec E would map to a larger connected subset containing that
   component. Injectivity and maximality show W is a component of Spec E.
7. Its component ideal I_W equals K: the idempotent generators of K vanish on W; conversely
   an idempotent vanishing on W maps to an idempotent in every prime of C, hence to zero by
   uniqueness in the clopen/idempotent correspondence. Thus E/I_W ≅ C over E. This equality
   of quotient maps supplies all factor compatibilities. A zero tensor product has no z.
-/
theorem tensor_component_from_factor_components
    (A : Type u) (B₁ : Type v) (B₂ : Type w)
    [CommRing A] [CommRing B₁] [CommRing B₂] [Algebra A B₁] [Algebra A B₂]
    (z : PrimeSpectrum (B₁ ⊗[A] B₂)) :
    ∃ (z₁ : PrimeSpectrum B₁) (z₂ : PrimeSpectrum B₂),
      (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A] B₁ ⊗[A] B₂).toRingHom) ''
          connectedComponent z ⊆ connectedComponent z₁ ∧
      (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : B₂ →ₐ[A] B₁ ⊗[A] B₂).toRingHom) ''
          connectedComponent z ⊆ connectedComponent z₂ ∧
      Function.Surjective
        (Algebra.TensorProduct.map
          (Ideal.Quotient.mkₐ A (componentIdeal B₁ z₁))
          (Ideal.Quotient.mkₐ A (componentIdeal B₂ z₂))) ∧
      ∃ r : ((B₁ ⧸ componentIdeal B₁ z₁) ⊗[A] (B₂ ⧸ componentIdeal B₂ z₂)) →ₐ[A]
          ((B₁ ⊗[A] B₂) ⧸ componentIdeal (B₁ ⊗[A] B₂) z),
        Function.Surjective r ∧
        r.comp (Algebra.TensorProduct.map
          (Ideal.Quotient.mkₐ A (componentIdeal B₁ z₁))
          (Ideal.Quotient.mkₐ A (componentIdeal B₂ z₂))) =
            Ideal.Quotient.mkₐ A (componentIdeal (B₁ ⊗[A] B₂) z) ∧
        ∃ (y : PrimeSpectrum
          ((B₁ ⧸ componentIdeal B₁ z₁) ⊗[A] (B₂ ⧸ componentIdeal B₂ z₂)))
          (e : (((B₁ ⧸ componentIdeal B₁ z₁) ⊗[A] (B₂ ⧸ componentIdeal B₂ z₂)) ⧸
            componentIdeal ((B₁ ⧸ componentIdeal B₁ z₁) ⊗[A]
              (B₂ ⧸ componentIdeal B₂ z₂)) y) ≃ₐ[A]
            ((B₁ ⊗[A] B₂) ⧸ componentIdeal (B₁ ⊗[A] B₂) z)),
          e.toAlgHom.comp (Ideal.Quotient.mkₐ A
            (componentIdeal
              ((B₁ ⧸ componentIdeal B₁ z₁) ⊗[A] (B₂ ⧸ componentIdeal B₂ z₂)) y)) = r := by
  sorry

end AlgebraicGeometry
