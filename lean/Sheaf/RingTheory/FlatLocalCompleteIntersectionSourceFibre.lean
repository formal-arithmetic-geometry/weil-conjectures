module

public import Sheaf.RingTheory.CompleteIntersectionLocalAlgebra
public import Mathlib.RingTheory.EssentialFiniteness
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.LocalRing.RingHom.Basic
import Sheaf.TraceFormula.EssentiallyFiniteTypeCIKernelInvariance
import Mathlib.RingTheory.Flat.Stability
import Mathlib.RingTheory.LocalRing.Quotient
import Mathlib.RingTheory.Noetherian.Basic

/-!
# Complete intersections under flat local maps

Source: Stacks Project, Divided Power Algebra, Tags 09Q7 (lemma-avramov)
and 09Q6 (lemma-check-lci-agrees), part (1)
(blueprint: lem-sfb-flat-local-ci-source-fibre).
-/

@[expose] public section

set_option autoImplicit false

universe u v w

namespace Algebra

/-- A flat local map between local algebras essentially of finite type over a field
has complete-intersection target if and only if its source and closed fibre are
complete intersections. The closed fibre has the quotient's induced algebra structure;
it is local and essentially of finite type. No completeness or separability is assumed.

Source: Stacks Project, Divided Power Algebra, Tag 09Q7 (lemma-avramov),
equivalence of (1) and (2), and Tag 09Q6 (lemma-check-lci-agrees), part (1)
(blueprint: lem-sfb-flat-local-ci-source-fibre).

Proof:
1. Choose compatible regular local essentially finite type presentations
   `q : R → A`, `v : S → B`, and a flat local map `u : R → S` with `v u = φ q`,
   using lem-sfb-compatible-regular-local-field-presentations. Write `I = ker q`,
   `J = ker v`, and `F = S / m_R S`. Surjectivity identifies `A = R/I` and `B = S/J`.
   The commutative square gives `IS ≤ J`; locality puts both kernels in their
   maximal ideals. Since `q(m_R) = m_A`, the closed fibre is `F/L`, where
   `L = (J + m_R S)/m_R S`. Locality makes `m_A B` proper, so quotient locality
   (lem-weil-pbc-quotient-local-structure) makes this fibre nonzero and local.
   A quotient of a localization of a finite type algebra is the localization of
   its quotient by the contracted ideal; the images of the finite generators
   generate the latter quotient. Thus the fibre is essentially of finite type,
   as in def-weil-pbc-essentially-finite-type-algebra.
2. For each presentation `R → A`, `S → B`, and `F → F/L`, the recorded definition
   def-trf-complete-intersection-local-algebra and
   lem-trf-essentially-finite-type-ci-kernel-invariance identify the corresponding
   complete-intersection condition with regular-sequence generation of `I`, `J`,
   and `L`, respectively. The empty sequence remains allowed.
3. Put `T = S/IS` and `K = J/IS`. These quotient rings are Noetherian by
   lem-weil-pbc-surjective-image-noetherian. Quotient locality makes `A → T` local;
   the identification `T = (R/I) ⊗[R] S` and lem-weil-pbc-flat-module-base-change
   make it flat. Its quotient `T/K = B` is flat over `A` by hypothesis.
   Since `I ≤ m_R`, its closed fibre is `T/m_A T = F`, and the image of `K` is `L`.
4. Apply lem-sfb-flat-quotient-nested-regular-ideals to `R → S` and `I,J`:
   `J` is generated by a regular sequence exactly when both `I` and `K` are.
   The regularity of `F` comes from the compatible presentations, and the
   induced quotient map is the original flat map `A → B`.
5. Apply lem-sfb-flat-quotient-ideal-fibre-regularity to `A → T` and `K`,
   using flatness of `T/K = B`. It identifies regular-sequence generation
   of `K` with that of `L` in `F`.
6. Combine these equivalences and the three identifications in step 2 to obtain
   the claimed equivalence, together with the fibre properties from step 1.
-/
theorem isCompleteIntersectionLocalAlgebra_iff_source_closedFibre
    (k : Type u) [Field k]
    (A : Type v) [CommRing A] [Algebra k A] [IsLocalRing A] [EssFiniteType k A]
    (B : Type w) [CommRing B] [Algebra k B] [IsLocalRing B] [EssFiniteType k B]
    (φ : A →ₐ[k] B) [IsLocalHom φ.toRingHom] (hφ : φ.toRingHom.Flat) :
    IsLocalRing (B ⧸ (IsLocalRing.maximalIdeal A).map φ.toRingHom) ∧
      EssFiniteType k (B ⧸ (IsLocalRing.maximalIdeal A).map φ.toRingHom) ∧
      (IsCompleteIntersectionLocalAlgebra k B ↔
        IsCompleteIntersectionLocalAlgebra k A ∧
          IsCompleteIntersectionLocalAlgebra k
            (B ⧸ (IsLocalRing.maximalIdeal A).map φ.toRingHom)) := by
  sorry

end Algebra
