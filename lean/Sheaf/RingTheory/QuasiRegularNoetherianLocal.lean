module

public import Sheaf.RingTheory.RegularSequenceGradedPolynomial
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
public import WeilConjectures.RingTheory.AssociatedGradedRing
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.Finiteness.Defs
import Sheaf.RingTheory.QuasiRegularPrefixQuotient

/-!
# Polynomial associated graded algebras and regular sequences

Source: Stacks Project, Algebra, Tag 061S (lemma-quasi-regular-regular),
using Tag 061P (definition-quasi-regular-sequence)
(blueprint: lem-pur-quasi-regular-noetherian-local).

The statement was independently checked in the Q35 second reading against
the Stacks hypotheses and the recorded canonical associated-graded map.
-/

@[expose] public section

universe u

namespace RingTheory

namespace Sequence

variable {A : Type u} [CommRing A]

/-- In a Noetherian local ring, a polynomial associated graded algebra on
generators in the maximal ideal forces those generators to be regular.
Source: Stacks Project, Algebra, Tag 061S (lemma-quasi-regular-regular),
with the quasi-regular hypothesis expanded using Tag 061P
(blueprint: lem-pur-quasi-regular-noetherian-local).

Proof:
1. The generated ideal `J` is contained in the maximal ideal, hence in the
   Jacobson radical, and `A/J` is nonzero. Every prefix quotient `B_i` is a
   cyclic, thus finite, `A`-module. The image ideal of `J` is generated by the
   remaining generators and its powers agree with `J^n B_i`.
2. Apply `lem-pur-quasi-regular-prefix-quotient` (Stacks 061R) to obtain the
   polynomial associated graded isomorphism on each prefix quotient.
3. Apply `lem-weil-pbc-krull-intersection-jacobson` (Stacks 00IQ (2)) to `B_i`.
   The intersection of the ideal powers is zero. For any nonzero element,
   the least power not containing it gives a nonzero initial class.
4. Multiplication by the next polynomial variable is injective over any
   coefficient ring. Transport through the graded isomorphism and use
   `lem-weil-pbc-associated-graded-ring-structure` to see that the product
   of the next generator with that nonzero element is nonzero. Applying this
   to a difference proves injectivity on the prefix quotient.
5. These injectivity statements and the nonzero final quotient are precisely
   the regular-sequence conditions. If `b = 0`, there are no injectivity
   conditions and the final quotient is the nontrivial ring `A`. -/
theorem quasiRegularNoetherianLocal
    (b : ℕ) (f : Fin b → A) [IsLocalRing A]
    [IsNoetherianRing A]
    (hf : ∀ j : Fin b, f j ∈ IsLocalRing.maximalIdeal A)
    (hiso : Function.Bijective (Ideal.regularSequenceGradedPolynomialMap f)) :
    RingTheory.Sequence.IsRegular A (List.ofFn f) := by
  sorry

end Sequence

end RingTheory
