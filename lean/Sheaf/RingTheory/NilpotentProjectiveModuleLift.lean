module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.RingTheory.Idempotents

/-!
# Lifting projective modules across nilpotent quotients

Source: Stacks Project, Algebra, Tag 07LV, `lemma-lift-projective-module`
(blueprint: lem-weil-pbc-nilpotent-projective-module-lift).
-/

@[expose] public section

universe u v

open scoped Pointwise

namespace Module

/-- A projective module over a nilpotent quotient lifts to a projective module, without any
finite generation assumption. Source: Stacks Project, Algebra, Tag 07LV
(blueprint: lem-weil-pbc-nilpotent-projective-module-lift).

Proof plan:
1. By the direct-summand characterization `Module.Projective.iff_split`
   (def-weil-pbc-projective-module), realize `Pbar` as the image of an idempotent `pbar`
   on a free module `(A / I)^(S)`. Set `F = A^(S)`.
2. Coordinate reduction `q : F → (A / I)^(S)` is surjective with kernel `IF`, since
   vectors have finite support. Lift the image of each basis vector under `pbar` and
   extend linearly to an endomorphism `p` of `F`, with `q p = pbar q`.
3. Put `x = p² - p`. Its image lies in `IF`, and linearity gives
   `x(I^k F) ⊆ I^(k+1) F`. Thus `x^N = 0`.
4. In the commutative ring `Z[t] / ((t² - t)^N)`, let `z` be the class of `t`.
   The ideal generated by `z² - z` is nilpotent. Lift its quotient idempotent using
   lem-weil-pbc-lift-idempotents-locally-nilpotent (Stacks, Tag 00J9), obtaining an
   idempotent `w` congruent to `z` modulo this ideal.
5. Evaluate at `p` in the possibly noncommutative ring `End_A(F)`. Integer scalars
   commute with `p`, and the relation vanishes by step 3, so evaluation is defined.
   The image `e` of `w` is idempotent and `e - p` maps `F` into `IF`; hence
   `q e = pbar q`. This is the polynomial correction of Stacks, Tag 05BU.
6. Set `P = im(e)`. It is a direct summand of `F`, hence projective by
   def-weil-pbc-projective-module. Reduction maps it onto `im(pbar)` with kernel `IP`:
   if `y ∈ P ∩ IF`, express `y` as a finite sum of `a_j f_j` with `a_j ∈ I` and apply
   `e` to obtain `y = ∑ a_j e(f_j) ∈ IP`. The reverse inclusion is immediate.
   Composing reduction with the retraction onto `Pbar` gives `P/IP ≃ Pbar`.
   Its inverse sends `z ∈ Pbar` to the class of `e(f)` for a lift `f` of its inclusion
   in the free quotient module. Different lifts differ in `IF`, so this is well-defined;
   the two composites are identities because `e² = e` and the retraction splits the
   inclusion. Both maps are `A/I`-linear with the canonical quotient scalar action. -/
theorem exists_projective_lift_of_nilpotent_ideal
    (A : Type u) [CommRing A] (I : Ideal A) (N : ℕ) (hN : 1 ≤ N)
    (hI : I ^ N = ⊥) (Pbar : Type v) [AddCommGroup Pbar] [Module (A ⧸ I) Pbar]
    [Module.Projective (A ⧸ I) Pbar] :
    ∃ P : ModuleCat.{max u v} A, Module.Projective A P ∧
      Nonempty ((P ⧸ (I • (⊤ : Submodule A P))) ≃ₗ[A ⧸ I] Pbar) := by
  sorry

end Module
