/-! # Finite-stage detection of a localized polynomial ideal relation

Source: Stacks Project, Algebra, Tag 00SV, the filtered-colimit argument for
prefix quotients.
-/

@[expose] public section

universe u

namespace RingTheory.Sequence

private theorem finite_polynomials_stage
    {R : Type u} [CommRing R] (R₀ : Subring R)
    (hR₀ : Algebra.FiniteType ℤ R₀) {n : ℕ}
    (s : Finset (MvPolynomial (Fin n) R)) :
    ∃ (B : Subring R), R₀ ≤ B ∧ Algebra.FiniteType ℤ B ∧
      ∀ p ∈ s, p ∈ Set.range (MvPolynomial.map B.subtype) := by
  classical
  let : Algebra R₀ R := R₀.subtype.toAlgebra
  let cs : Set R := ⋃ p ∈ (s : Set (MvPolynomial (Fin n) R)), (p.coeffs : Set R)
  have hcs : cs.Finite :=
    s.finite_toSet.biUnion fun p _ ↦ p.coeffs.finite_toSet
  let A := Algebra.adjoin R₀ cs
  let B := A.toSubring
  have hB : R₀ ≤ B := by
    intro x hx
    exact A.algebraMap_mem ⟨x, hx⟩
  have hfg : A.FG := Subalgebra.fg_def.mpr ⟨cs, hcs, rfl⟩
  have hft : Algebra.FiniteType R₀ A := A.fg_iff_finiteType.mp hfg
  have hftZ : Algebra.FiniteType ℤ A := Algebra.FiniteType.trans hR₀ hft
  refine ⟨B, hB, hftZ, ?_⟩
  intro p hp
  apply MvPolynomial.mem_range_map_iff_coeffs_subset.mpr
  intro x hx
  exact ⟨⟨x, Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨p, hp, hx⟩)⟩, rfl⟩

/-- A single ideal-membership relation in a polynomial local ring is witnessed over
one finite type coefficient subring containing the given coefficient ring.
Source: Stacks Project, Algebra, Tag 00SV, filtered-colimit paragraphs concerning
prefix quotients.
(blueprint: lem-weil-pbc-polynomial-local-ideal-relation-finite-stage).

Proof: Write `x = z/d`, with `d` outside `Q`. The localized membership criterion
provides a polynomial `t` outside `Q` such that `t * a * z` belongs to the polynomial
ideal generated by `ps`. Express this membership as a finite sum of polynomial
multipliers times the entries of `ps`. Adjoin to `R₀` the coefficients of `z`, `d`,
`t`, and these finitely many multipliers. This explicitly constructed subalgebra is
finite type over `R₀`, hence over the integers; its underlying subring is `B`.
Each selected polynomial lifts coefficientwise to `B`. Both `d` and `t` remain
outside the contracted prime. Localizing the polynomial inclusion defines `φ`.
Injectivity of the polynomial coefficient inclusion transfers the finite sum equality
to `B`, and the localized membership criterion there gives the required relation for
`y = z_B/d_B`. Compatibility on fractions gives `φ y = x`. For an empty list the
finite sum is zero, so the same argument proves the vanishing relation. No flatness
or injectivity of the localized inclusion is assumed. The finite subring is constructed
as an adjoin; no data definition chooses a witness from an unproved existence theorem.
-/
theorem exists_finiteType_subring_local_ideal_relation
    {R : Type u} [CommRing R] (R₀ : Subring R)
    (hR₀ : Algebra.FiniteType ℤ R₀) {n : ℕ}
    (ps : List (MvPolynomial (Fin n) R₀)) (a : MvPolynomial (Fin n) R₀)
    (Q : Ideal (MvPolynomial (Fin n) R)) [Q.IsPrime]
    (x : Localization.AtPrime Q)
    (hx : algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime Q)
        (MvPolynomial.map R₀.subtype a) * x ∈
      Ideal.ofList (ps.map (fun p ↦
        algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime Q)
          (MvPolynomial.map R₀.subtype p)))) :
    ∃ (B : Subring R) (hB : R₀ ≤ B), Algebra.FiniteType ℤ B ∧
      ∃ (φ : Localization.AtPrime (Q.comap (MvPolynomial.map B.subtype)) →+*
          Localization.AtPrime Q),
        (∀ p : MvPolynomial (Fin n) B,
          φ (algebraMap (MvPolynomial (Fin n) B)
              (Localization.AtPrime (Q.comap (MvPolynomial.map B.subtype))) p) =
            algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime Q)
              (MvPolynomial.map B.subtype p)) ∧
        ∃ y : Localization.AtPrime (Q.comap (MvPolynomial.map B.subtype)),
          φ y = x ∧
          algebraMap (MvPolynomial (Fin n) B)
              (Localization.AtPrime (Q.comap (MvPolynomial.map B.subtype)))
              (MvPolynomial.map (Subring.inclusion hB) a) * y ∈
            Ideal.ofList (ps.map (fun p ↦
              algebraMap (MvPolynomial (Fin n) B)
                (Localization.AtPrime (Q.comap (MvPolynomial.map B.subtype)))
                (MvPolynomial.map (Subring.inclusion hB) p))) := by
  classical
  let P := MvPolynomial (Fin n) R
  let L := Localization.AtPrime Q
  let e := MvPolynomial.map (σ := Fin n) R₀.subtype
  let f := algebraMap P L
  obtain ⟨z, d, hd⟩ := IsLocalization.exists_mk'_eq Q.primeCompl x
  have hlist : Ideal.ofList (ps.map (fun p ↦ f (e p))) =
      (Ideal.ofList (ps.map e)).map f := by
    simpa only [List.map_map, Function.comp_def] using
      (Ideal.map_ofList f (ps.map e)).symm
  rw [hlist, ← hd] at hx
  have hmul : f (e a) * IsLocalization.mk' L z d =
      IsLocalization.mk' L (e a * z) d := by
    rw [← IsLocalization.mk'_one (M := Q.primeCompl), ← IsLocalization.mk'_mul]
    simp
  rw [hmul] at hx
  obtain ⟨t, ht, hmem⟩ :=
    (IsLocalization.mk'_mem_map_algebraMap_iff Q.primeCompl L
      (Ideal.ofList (ps.map e)) (e a * z) d).mp hx
  have hspan : Ideal.ofList (ps.map e) =
      Ideal.span (Set.range (fun i : Fin ps.length ↦ e (ps.get i))) := by
    apply congrArg Ideal.span
    ext v
    change (v ∈ ps.map e) ↔ ∃ i : Fin ps.length, e (ps.get i) = v
    constructor
    · intro hv
      obtain ⟨p, hp, hev⟩ := List.mem_map.mp hv
      obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hp
      exact ⟨i, hev⟩
    · rintro ⟨i, rfl⟩
      exact List.mem_map.mpr ⟨_, List.get_mem _ _, rfl⟩
  rw [hspan] at hmem
  obtain ⟨cs, hcs⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  obtain ⟨B, hB, hft, hpoly⟩ := finite_polynomials_stage R₀ hR₀
    ({z, d.1, t} ∪ Finset.univ.image cs)
  obtain ⟨zB, hzB⟩ := hpoly z (by simp)
  obtain ⟨dB, hdB⟩ := hpoly d.1 (by simp)
  obtain ⟨tB, htB⟩ := hpoly t (by simp)
  have hcsB (i : Fin ps.length) : cs i ∈ Set.range (MvPolynomial.map B.subtype) :=
    hpoly (cs i) (by simp)
  choose csB hcsB using hcsB
  let eB := MvPolynomial.map (σ := Fin n) B.subtype
  let gB := MvPolynomial.map (σ := Fin n) (Subring.inclusion hB)
  let QB := Q.comap eB
  let LB := Localization.AtPrime QB
  let fB := algebraMap (MvPolynomial (Fin n) B) LB
  have hg (p : MvPolynomial (Fin n) R₀) : eB (gB p) = e p := by
    rw [MvPolynomial.map_map]
    rfl
  have hdB' : dB ∈ QB.primeCompl := by
    change eB dB ∉ Q
    rw [hdB]
    exact d.2
  have htB' : tB ∈ QB.primeCompl := by
    change eB tB ∉ Q
    rw [htB]
    exact ht
  let φ : LB →+* L :=
    IsLocalization.map (M := QB.primeCompl) (S := LB) (T := Q.primeCompl) L eB
      (by intro s hs; exact hs)
  refine ⟨B, hB, hft, φ, ?_, IsLocalization.mk' LB zB ⟨dB, hdB'⟩, ?_, ?_⟩
  · intro p
    exact IsLocalization.map_eq _ p
  · rw [IsLocalization.map_mk', hzB]
    convert hd using 2
    exact Subtype.ext hdB
  · have heq : ∑ i, csB i * gB (ps.get i) = tB * (gB a * zB) := by
      apply MvPolynomial.map_injective B.subtype Subtype.val_injective
      change eB (∑ i, csB i * gB (ps.get i)) = eB (tB * (gB a * zB))
      simp only [map_sum, map_mul, hg]
      dsimp only [eB]
      rw [htB, hzB]
      simp only [hcsB]
      exact hcs
    have hm : tB * (gB a * zB) ∈ Ideal.ofList (ps.map gB) := by
      rw [← heq]
      apply Ideal.sum_mem
      intro i _
      apply Ideal.mul_mem_left
      exact Ideal.subset_span (List.mem_map.mpr ⟨_, List.get_mem _ _, rfl⟩)
    have hm' : IsLocalization.mk' LB (gB a * zB) ⟨dB, hdB'⟩ ∈
        (Ideal.ofList (ps.map gB)).map fB := by
      apply (IsLocalization.mk'_mem_map_algebraMap_iff QB.primeCompl LB _ _ _).mpr
      exact ⟨tB, htB', hm⟩
    rw [Ideal.map_ofList, List.map_map] at hm'
    have hmulB : fB (gB a) * IsLocalization.mk' LB zB ⟨dB, hdB'⟩ =
        IsLocalization.mk' LB (gB a * zB) ⟨dB, hdB'⟩ := by
      rw [← IsLocalization.mk'_one (M := QB.primeCompl), ← IsLocalization.mk'_mul]
      simp
    change fB (gB a) * IsLocalization.mk' LB zB ⟨dB, hdB'⟩ ∈ _
    rw [hmulB]
    exact hm'

end RingTheory.Sequence
