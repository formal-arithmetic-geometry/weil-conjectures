module

public import Sheaf.RingTheory.RestrictedSeriesPresentation
public import Mathlib.RingTheory.MvPowerSeries.Derivative
public import Mathlib.RingTheory.Ideal.Colon
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.Data.Finset.Sort

/-!
# Continuous Jacobian data for restricted series

Source: Temkin, Desingularization of quasi-excellent schemes in characteristic zero,
Proposition 3.3.2 and the preceding Jacobian formula, pp. 20--21
(blueprint: def-per-restricted-series-jacobian).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace RestrictedSeries

/-- Isometric coefficient extension preserves restricted series of radius one.
Source: Temkin, Proposition 3.3.2, coefficient extension of affinoid presentations
(blueprint: def-per-restricted-series-jacobian).
Proof: the coefficient formula for `MvPowerSeries.map` and the isometry identify
all coefficient norms, hence the cofinite convergence conditions are identical. -/
theorem map_isRestricted {K : Type u} {L : Type v} [NormedField K] [NormedField L]
    [IsUltrametricDist K] (r : ℕ) (φ : K →+* L) (hφ : Isometry φ)
    (f : MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :
    MvPowerSeries.IsRestricted (fun _ : Fin r ↦ (1 : ℝ))
      (MvPowerSeries.map φ f.val) := by
  sorry

/-- The canonical coefficient extension on Tate algebras, using Mathlib's subring.
Source: Temkin, Proposition 3.3.2 (blueprint: def-per-restricted-series-jacobian). -/
noncomputable def map {K : Type u} {L : Type v} [NormedField K] [NormedField L]
    [IsUltrametricDist K] [IsUltrametricDist L] (r : ℕ)
    (φ : K →+* L) (hφ : Isometry φ) :
    MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ)) →+*
      MvPowerSeries.IsRestricted.subring (R := L) (fun _ : Fin r ↦ (1 : ℝ)) :=
  ((MvPowerSeries.map φ).comp
    (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))).subtype).codRestrict
      _ (map_isRestricted r φ hφ)

/-- Termwise partial differentiation preserves restricted series of radius one.
Source: Temkin, Proposition 3.3.2, continuous differentials
(blueprint: def-per-restricted-series-jacobian).
Proof: the coefficient at ν is the coefficient at ν+eᵢ times νᵢ+1. In a
nonarchimedean field the integer multiplier has norm at most one. Translation
of multiindices is injective, so it pulls a cofinite null family back to one;
the norm bound then gives the required coefficient decay. -/
theorem pderiv_isRestricted {K : Type u} [NormedField K] [IsUltrametricDist K]
    (r : ℕ) (i : Fin r)
    (f : MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :
    MvPowerSeries.IsRestricted (fun _ : Fin r ↦ (1 : ℝ))
      (MvPowerSeries.pderiv K i f.val) := by
  sorry

/-- The continuous partial derivative, with the usual termwise coefficient formula.
Source: Temkin, Proposition 3.3.2 (blueprint: def-per-restricted-series-jacobian). -/
noncomputable def pderiv {K : Type u} [NormedField K] [IsUltrametricDist K]
    (r : ℕ) (i : Fin r)
    (f : MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :
    MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ)) :=
  ⟨MvPowerSeries.pderiv K i f.val, pderiv_isRestricted r i f⟩

/-- The ideal generated by a finite family of restricted series.
Source: Temkin, formula preceding Proposition 3.3.2
(blueprint: def-per-restricted-series-jacobian). -/
noncomputable def relationIdeal {K : Type u} [NormedField K] [IsUltrametricDist K]
    {r s : ℕ}
    (f : Fin s → MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :
    Ideal (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :=
  Ideal.span (Set.range f)

/-- The Jacobian minor with rows T and columns E, both in increasing order.
The empty minor is Mathlib's empty determinant, hence one.
Source: Temkin, formula preceding Proposition 3.3.2 (transpose convention)
(blueprint: def-per-restricted-series-jacobian). -/
noncomputable def jacobianMinor {K : Type u} [NormedField K] [IsUltrametricDist K]
    {r s : ℕ}
    (f : Fin s → MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ)))
    (E : Finset (Fin s)) (T : Finset (Fin r)) (h : T.card = E.card) :
    MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ)) :=
  Matrix.det (fun i j : Fin E.card ↦
    pderiv r (T.orderEmbOfFin h i) (f (E.orderEmbOfFin rfl j)))

/-- The sum of the images of colon ideals times the corresponding Jacobian minors.
The subset ideal is the span of the selected relations; the sum ranges over every
pair of subsets of equal cardinality, including the empty pair.
Source: Temkin, formula preceding Proposition 3.3.2
(blueprint: def-per-restricted-series-jacobian). -/
noncomputable def jacobianIdeal {K : Type u} [NormedField K] [IsUltrametricDist K]
    {r s : ℕ}
    (f : Fin s → MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) :
    Ideal ((MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin r ↦ (1 : ℝ))) ⧸
      relationIdeal f) :=
  ⨆ (E : Finset (Fin s)) (T : Finset (Fin r)) (h : T.card = E.card),
    Ideal.map (Ideal.Quotient.mk (relationIdeal f))
      ((Ideal.span (f '' (E : Set (Fin s)))).colon (relationIdeal f : Set _)) *
    Ideal.span {Ideal.Quotient.mk (relationIdeal f) (jacobianMinor f E T h)}

end RestrictedSeries
