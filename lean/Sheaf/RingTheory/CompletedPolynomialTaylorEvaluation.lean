module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.AdicCompletion.Algebra
import Mathlib.RingTheory.AdicCompletion.Completeness

/-! # Evaluation and Taylor congruences for completed polynomial rings

Source: Stacks Project, restricted.tex, Tag 0AK3 (remark-linear-approximation), and
formal-spaces.tex, Tags 0AJM and 0AJN (universal property and comparison with completion).
(blueprint: lem-per-completed-polynomial-taylor-evaluation)

The abbreviation below is the displayed composite of Mathlib's polynomial ring and adic
completion. Continuity is expressed using the ideal-power neighbourhood bases at zero.
For the additive maps in this statement this is exactly continuity in the stipulated adic
topologies. The submodule `I ^ n • ⊤` is the ideal generated by the image of `I ^ n`.
-/

@[expose] public section

universe u v

namespace MvPolynomial

/-- The completion of `A[x₁, …, xᵣ]` for the ideal extended from `I`, using exactly
Mathlib's polynomial ring and completion; no completeness of `A` is assumed.
Source: Stacks Project, formal-spaces.tex, Tag 0AJN.
(blueprint: lem-per-completed-polynomial-taylor-evaluation) -/
abbrev adicCompletion {A : Type u} [CommRing A] (I : Ideal A) (r : ℕ) : Type u :=
  AdicCompletion (I.map (algebraMap A (MvPolynomial (Fin r) A))) (MvPolynomial (Fin r) A)

/-- Evaluation at arbitrary coordinates, continuous partial derivatives, and the linear and
quadratic Taylor congruences for the completion of a polynomial ring.
Source: Stacks Project, restricted.tex, Tag 0AK3 (remark-linear-approximation), and
formal-spaces.tex, Tags 0AJM and 0AJN.
(blueprint: lem-per-completed-polynomial-taylor-evaluation)

Proof:
1. Put `S = A[x₁, …, xᵣ]` and `J = IS`. The finite generation of `I` gives that of `J`.
   Apply `lem-weil-pbc-module-completion-complete` (Stacks 05GG) to `S`, `J`, and `S`:
   its completion is complete and separated, and reduction modulo `J ^ n` is surjective
   with kernel `I ^ n P`. Thus every completed element has polynomial approximations
   modulo every `I ^ n P`, without any completeness assumption on `A`.
2. By `def-weil-pbc-mv-polynomial-ring`, evaluation at any tuple `y` gives `S →ₐ[A] T`.
   It preserves the powers of `I`, so it descends to compatible maps of all quotients.
   Completeness of `T`, as in `def-weil-pbc-adic-completion`, gives their unique limit
   `E y`. Operations and the values on variables are checked in each quotient.
3. Every `A`-algebra map preserves `I ^ n` times the whole module: apply linearity to
   finite sums of scalar multiples. Hence `E y` is continuous. Any other map with the
   same variable values agrees on polynomials, by their universal property; polynomial
   approximation and separatedness of `T` force agreement on the completion.
4. The polynomial `pderiv i` of `def-weil-pbc-polynomial-partial-derivative` is `A`-linear,
   so it preserves every `J ^ n`. Its maps on the quotients are compatible. Their limit
   defines the `A`-linear extension `D i`, preserves every `I ^ n P`, and is continuous.
5. The polynomial Leibniz rule descends to the quotients, hence holds in their limit.
   Any other continuous `A`-linear extension agrees on polynomial approximations and
   therefore everywhere by separatedness of `P`. This proves uniqueness among linear
   extensions, without requiring a competing extension to satisfy Leibniz in advance.
6. For a polynomial monomial, expand the finite product at `y + z`. The term with no
   `z` is its value at `y`; the terms with one `z` sum to its evaluated derivatives
   times `z i`; every other term contains at least two `z` factors. Thus the first
   difference lies in `I ^ s T` and the quadratic remainder lies in `I ^ (2 * s) T`.
   Sum over the finitely many monomials. No factorial is inverted.
7. Approximate a completed element by a polynomial modulo `I ^ (2 * s) P`. Evaluations
   and partial derivatives preserve this ideal, so both remainders agree modulo the
   indicated ideals with their polynomial counterparts. For `r = 0`, tuples and the
   derivative family are empty, the evaluation maps coincide, and both remainders vanish.
-/
theorem exists_adicCompletion_taylor_evaluation
    {A : Type u} [CommRing A] (I : Ideal A) (hI : I.FG) (r : ℕ) :
    ∃ D : Fin r → adicCompletion I r →ₗ[A] adicCompletion I r,
      (∀ i : Fin r, ∀ n : ℕ, ∃ m : ℕ,
        ∀ f ∈ I ^ m • (⊤ : Submodule A (adicCompletion I r)),
          D i f ∈ I ^ n • (⊤ : Submodule A (adicCompletion I r))) ∧
      (∀ (i : Fin r) (p : MvPolynomial (Fin r) A),
        D i (algebraMap (MvPolynomial (Fin r) A) (adicCompletion I r) p) =
          algebraMap (MvPolynomial (Fin r) A) (adicCompletion I r) (pderiv i p)) ∧
      (∀ (i : Fin r) (f g : adicCompletion I r),
        D i (f * g) = f * D i g + g * D i f) ∧
      (∀ (i : Fin r) (d : adicCompletion I r →ₗ[A] adicCompletion I r),
        (∀ n : ℕ, ∃ m : ℕ,
          ∀ f ∈ I ^ m • (⊤ : Submodule A (adicCompletion I r)),
            d f ∈ I ^ n • (⊤ : Submodule A (adicCompletion I r))) →
        (∀ p : MvPolynomial (Fin r) A,
          d (algebraMap (MvPolynomial (Fin r) A) (adicCompletion I r) p) =
            algebraMap (MvPolynomial (Fin r) A) (adicCompletion I r) (pderiv i p)) →
        d = D i) ∧
      ∀ (T : Type v) [CommRing T] [Algebra A T] [IsAdicComplete I T],
        ∃ E : (Fin r → T) → adicCompletion I r →ₐ[A] T,
          (∀ (y : Fin r → T) (i : Fin r),
            E y (algebraMap (MvPolynomial (Fin r) A) (adicCompletion I r) (X i)) = y i) ∧
          (∀ (y : Fin r → T) (n : ℕ), ∃ m : ℕ,
            ∀ f ∈ I ^ m • (⊤ : Submodule A (adicCompletion I r)),
              E y f ∈ I ^ n • (⊤ : Submodule A T)) ∧
          (∀ (y : Fin r → T) (e : adicCompletion I r →ₐ[A] T),
            (∀ n : ℕ, ∃ m : ℕ,
              ∀ f ∈ I ^ m • (⊤ : Submodule A (adicCompletion I r)),
                e f ∈ I ^ n • (⊤ : Submodule A T)) →
            (∀ i : Fin r,
              e (algebraMap (MvPolynomial (Fin r) A) (adicCompletion I r) (X i)) = y i) →
            e = E y) ∧
          ∀ (s : ℕ), 1 ≤ s → ∀ (y z : Fin r → T),
            (∀ i : Fin r, z i ∈ I ^ s • (⊤ : Submodule A T)) →
            ∀ f : adicCompletion I r,
              (E (y + z) f - E y f ∈ I ^ s • (⊤ : Submodule A T)) ∧
              (E (y + z) f - E y f - ∑ i : Fin r, E y (D i f) * z i ∈
                I ^ (2 * s) • (⊤ : Submodule A T)) := by
  sorry

end MvPolynomial
