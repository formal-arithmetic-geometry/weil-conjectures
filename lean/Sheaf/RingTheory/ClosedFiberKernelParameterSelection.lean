/-! # Removing the equations of a regular closed fibre

Source: Stacks Project, Tag 07NQ, proof of (2) implies (3), through the isomorphism
S tensor_R A -> B. (blueprint: lem-weil-pbc-flat-closed-fibre-power-series-model)
-/

@[expose] public section

universe u v w x

open IsLocalRing

namespace RingHom

private theorem lift_list {α β : Type*} (f : α → β) (P : α → Prop)
    (ys : List β) (h : ∀ y ∈ ys, ∃ x, P x ∧ f x = y) :
    ∃ xs : List α, xs.map f = ys ∧ ∀ x ∈ xs, P x := by
  induction ys with
  | nil => exact ⟨[], rfl, by simp⟩
  | cons y ys ih =>
    obtain ⟨x, hx, hxy⟩ := h y List.mem_cons_self
    obtain ⟨xs, hxs, hP⟩ := ih (fun y hy ↦ h y (List.mem_cons_of_mem _ hy))
    refine ⟨x :: xs, by simp only [List.map_cons, hxs, hxy], ?_⟩
    intro a ha
    rcases List.mem_cons.mp ha with rfl | ha
    · exact hx
    · exact hP a ha

/-- The equations of a regular closed fibre lift into the actual presentation kernel
and extend the specified base parameters to a full parameter system.

Source: Stacks Project, Tag 07NQ, proof of (2) implies (3), the paragraph lifting
xbar_1,...,xbar_r to x_1,...,x_r in J; Algebra, Tag 00NR.
(blueprint: lem-weil-pbc-closed-fibre-kernel-parameter-selection)

Proof: The closed fibre E = B/m_A B is regular local by adic formal smoothness
(07EI). Put M = m_R S, generated by i(t). The parameter quotient theorem makes
S/M regular local of dimension length(z). The surjections q and b and their
compatibility give b(M) = m_A B. Thus b induces a surjection w : S/M -> E.
Apply Tag 00NR to its regular local quotient: choose a full parameter list bs
of S/M whose initial c entries generate ker w. For each initial entry, choose
a representative s. Its b-image lies in m_A B = b(M), so subtract a suitable
s' in M with b(s') = b(s). The corrected representative belongs to ker b and
has the same image in S/M. Collect these in x and lift the remaining entries
arbitrarily to y. Then (x ++ y) maps to bs. The ideal generated by (i(t),x,y)
contains M and maps to the maximal ideal of S/M. Taking preimages shows it
is exactly m_S. Its length is length(t) + length(z), because x ++ y has the
same length as bs, namely length(z). This equals dim S by the original
parameter system. Hence (i(t),x,y), and by permutation (x,i(t),y), is a regular
system of parameters. The chosen x lie in ker b, and taking the preimage of
ker w = (x mod M) gives the required kernel identity. Empty x and t lists
use these same ideal and length equalities. No coefficient rings or flatness
are needed. -/
theorem exists_closedFiber_kernel_parameters
    (A : Type u) (B : Type v) (R : Type w) (S : Type x)
    [CommRing A] [CommRing B] [CommRing R] [CommRing S]
    [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B]
    [IsRegularLocalRing R] [IsRegularLocalRing S]
    (f : A →+* B) [IsLocalHom f]
    (q : R →+* A) [IsLocalHom q] (b : S →+* B) [IsLocalHom b]
    (i : R →+* S) [IsLocalHom i]
    (hq : Function.Surjective q) (hb : Function.Surjective b)
    (hcomm : b.comp i = f.comp q)
    (t : List R) (z : List S)
    (ht : IsRegularSystemOfParameters t)
    (hz : IsRegularSystemOfParameters (t.map i ++ z)) :
    letI : Algebra A B := f.toAlgebra
    let I : Ideal B := (maximalIdeal A).map f
    letI : Algebra (A ⧸ maximalIdeal A) (B ⧸ I) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
        maximalIdeal A ≤ I.comap (algebraMap A B))
    Algebra.FormallySmoothAdic (A ⧸ maximalIdeal A) (B ⧸ I)
      ((maximalIdeal B).map (Ideal.Quotient.mk I)) →
    ∃ x y : List S,
      IsRegularSystemOfParameters (x ++ (t.map i ++ y)) ∧
      Ideal.ofList x ≤ RingHom.ker b ∧
      RingHom.ker ((Ideal.Quotient.mk I).comp b) =
        Ideal.ofList x ⊔ (maximalIdeal R).map i := by
  classical
  dsimp only
  intro hsmooth
  let : Algebra A B := f.toAlgebra
  let I := (maximalIdeal A).map f
  let E := B ⧸ I
  let : Algebra (A ⧸ maximalIdeal A) E :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
      maximalIdeal A ≤ I.comap (algebraMap A B))
  have hIm : I ≤ maximalIdeal B := Ideal.map_le_iff_le_comap.mpr (by
    intro a ha
    exact map_nonunit f a ha)
  have hIne : I ≠ ⊤ := ne_top_of_le_ne_top (maximalIdeal.isMaximal B).ne_top hIm
  have : Nontrivial E := Ideal.Quotient.nontrivial_iff.mpr hIne
  have : IsLocalRing E := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have hE : Algebra.FormallySmoothAdic (A ⧸ maximalIdeal A) E (maximalIdeal E) := by
    rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective]
    exact hsmooth
  let : Algebra (ResidueField A) E :=
    (inferInstance : Algebra (A ⧸ maximalIdeal A) E)
  have : IsRegularLocalRing E :=
    Algebra.isRegularLocalRing_of_formallySmoothAdic (ResidueField A) E hE
  let a := t.map i
  let M := (maximalIdeal R).map i
  have hM : M = Ideal.ofList a := by
    change (maximalIdeal R).map i = Ideal.ofList (t.map i)
    rw [← ht.1, Ideal.map_ofList]
  let π := Ideal.Quotient.mk M
  have hSbar := (IsRegularLocalRing.isRegular_and_quotients_of_generators
    S (a ++ z).length hz.2.symm (a ++ z) hz).2.1 a.length (by simp)
  rw [List.take_left, ← hM] at hSbar
  let := hSbar.1
  have hdim : ringKrullDim (S ⧸ M) = (z.length : WithBot ℕ∞) := by
    simpa only [List.length_append, Nat.add_sub_cancel_left] using hSbar.2
  have hbM : M.map b = I := by
    rw [Ideal.map_map, hcomm, ← Ideal.map_map, map_maximalIdeal_of_surjective q hq]
  have hkill : M ≤ RingHom.ker ((Ideal.Quotient.mk I).comp b) := by
    intro s hs
    change Ideal.Quotient.mk I (b s) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    rw [← hbM]
    exact Ideal.mem_map_of_mem b hs
  let w : (S ⧸ M) →+* E := Ideal.Quotient.lift M ((Ideal.Quotient.mk I).comp b) hkill
  have hw : Function.Surjective w := Ideal.Quotient.lift_surjective_of_surjective M hkill
    (Ideal.Quotient.mk_surjective.comp hb)
  have : IsRegularLocalRing ((S ⧸ M) ⧸ RingHom.ker w) :=
    IsRegularLocalRing.of_ringEquiv (w.quotientKerEquivOfSurjective hw).symm
  obtain ⟨bs, c, hc, hbs, hbsKer⟩ :=
    RingTheory.exists_parameters_regularLocalQuotient (S ⧸ M) z.length hdim
      (RingHom.ker w) (RingHom.ker_ne_top w)
  have hlift : ∀ r ∈ bs.take c, ∃ s, s ∈ RingHom.ker b ∧ π s = r := by
    intro r hr
    have hrker : r ∈ RingHom.ker w := hbsKer ▸ Ideal.subset_span hr
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective r
    have hs : b s ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hrker
    rw [← hbM] at hs
    obtain ⟨s', hs', heq⟩ := (Ideal.mem_map_iff_of_surjective b hb).mp hs
    refine ⟨s - s', ?_, ?_⟩
    · change b (s - s') = 0
      rw [map_sub, heq, sub_self]
    · change π (s - s') = π s
      rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hs', sub_zero]
  obtain ⟨x, hxmap, hxker⟩ := lift_list π (fun s ↦ s ∈ RingHom.ker b) (bs.take c) hlift
  obtain ⟨y, hymap⟩ := Ideal.Quotient.mk_surjective.list_map (bs.drop c)
  change y.map π = bs.drop c at hymap
  have hxymap : (x ++ y).map π = bs := by
    rw [List.map_append, hxmap, hymap, List.take_append_drop]
  have hlen : (x ++ y).length = z.length := by
    have h := hbs.2.trans hdim
    rw [← hxymap, List.length_map] at h
    exact_mod_cast h
  have hspan : Ideal.ofList (a ++ (x ++ y)) = maximalIdeal S := by
    have hmap : (Ideal.ofList (a ++ (x ++ y))).map π = maximalIdeal (S ⧸ M) := by
      rw [Ideal.ofList_append, Ideal.map_sup, ← hM, Ideal.map_quotient_self,
        bot_sup_eq, Ideal.map_ofList, hxymap]
      exact hbs.1
    have hinc : M ≤ Ideal.ofList (a ++ (x ++ y)) := by
      rw [hM, Ideal.ofList_append]
      exact le_sup_left
    have hMm : M ≤ maximalIdeal S := by
      rw [hM]
      apply Ideal.span_le.mpr
      intro s hs
      exact hz.1 ▸ Ideal.subset_span (List.mem_append_left z hs)
    have hm := map_maximalIdeal_of_surjective π Ideal.Quotient.mk_surjective
    apply_fun (Ideal.comap π) at hmap
    rw [Ideal.comap_map_mk hinc, ← hm, Ideal.comap_map_mk hMm] at hmap
    exact hmap
  have hfull : IsRegularSystemOfParameters (a ++ (x ++ y)) := by
    refine ⟨hspan, ?_⟩
    simpa only [List.length_append, hlen] using hz.2
  have hperm : (a ++ (x ++ y)).Perm (x ++ (a ++ y)) := by
    simpa only [List.append_assoc] using
      (List.Perm.append_right y (List.perm_append_comm (l₁ := a) (l₂ := x)))
  have hparam := (IsRegularLocalRing.isRegular_and_quotients_of_generators
    S _ hfull.2.symm _ hfull).2.2 _ hperm |>.1
  have hx : Ideal.ofList x ≤ RingHom.ker b := Ideal.span_le.mpr hxker
  have hxm : (Ideal.ofList x).map π = RingHom.ker w := by
    rw [Ideal.map_ofList, hxmap, hbsKer]
  have hker : RingHom.ker ((Ideal.Quotient.mk I).comp b) = Ideal.ofList x ⊔ M := by
    rw [show (Ideal.Quotient.mk I).comp b = w.comp π from rfl,
      ← RingHom.comap_ker, ← hxm, Ideal.comap_map_quotientMk, sup_comm]
  exact ⟨x, y, hparam, hx, hker⟩


end RingHom
