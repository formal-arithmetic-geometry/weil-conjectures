module

public import Sheaf.RingTheory.BasisConeAlgebra
public import Mathlib.Algebra.GroupWithZero.Units.Basic
public import Mathlib.RingTheory.Localization.Basic

/-! # Localization of a basis-cone algebra

Source: ILO, Travaux de Gabber, Exposé VIII, Lemma 3.2.12, printed p.104 (PDF p.110),
identification of the lattice group algebra; the explicit localization calculation is the
agent-written expansion in the DAG (blueprint: lem-trf-basis-cone-group-localization).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace AddMonoidAlgebra

variable {k : Type u} [Field k] {G : Type v} [AddCommGroup G] {r : ℕ}

/-- The multiplicative submonoid generated by the basis monomials, including the empty product.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded basis-cone calculation
(blueprint: lem-trf-basis-cone-group-localization). -/
noncomputable def basisConeDenominators (b : Module.Basis (Fin r) ℤ G) :
    Submonoid (AddMonoidAlgebra k (basisCone b)) :=
  Submonoid.closure (Set.range (basisConeVariable (k := k) b))

/-- The specified product of basis monomials as an element of the denominator submonoid.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded basis-cone calculation
(blueprint: lem-trf-basis-cone-group-localization). -/
noncomputable def basisConeDenominator (b : Module.Basis (Fin r) ℤ G) (a : Fin r → ℕ) :
    basisConeDenominators (k := k) b :=
  ⟨∏ i, basisConeVariable (k := k) b i ^ a i,
    prod_mem fun i _ ↦ pow_mem (Submonoid.subset_closure (Set.mem_range_self i)) (a i)⟩

/-- The cone algebra embeds in the group algebra, and localizing at its basis monomials
identifies the two, uniquely extending this inclusion. Fractions have the usual formula;
the inverse is a `k`-linear ring homomorphism with the positive/negative exponent formula.
Source: ILO VIII, Lemma 3.2.12, p.104 (PDF p.110); explicit agent-written calculation in
(blueprint: lem-trf-basis-cone-group-localization).

Proof plan:
1. The inclusion is coefficientwise and injective. Products of basis monomials have
   coefficient one at their exponent, so zero is not a denominator. In the group algebra
   their inverses are the monomials at the negatives of their exponents.
2. Use lem-weil-pbc-ring-localization-universal-property (Stacks 00CP, `IsLocalization.lift`
   and `IsLocalization.ringHom_ext`) to extend the inclusion uniquely, with the fraction
   formula. Constants are preserved, giving a `k`-algebra map.
3. Clear denominators in the group algebra. Injectivity of the inclusion then proves
   injectivity of the localization map, using multiplier one in the fraction relation.
4. Write every exponent in its unique basis coordinates and split each integer into its
   positive and negative parts. Send its monomial to the resulting fraction and extend
   `k`-linearly. The forward composite is the identity, proving surjectivity.
5. Injectivity gives the other composite identity and multiplicativity and preservation
   of one of the inverse. Uniqueness follows from the localization universal property.
6. For `r = 0`, the group and cone are zero, both algebras are `k`, and the sole denominator
   is the empty product one. The same fraction and inverse formulas apply. -/
theorem basisCone_group_localization (b : Module.Basis (Fin r) ℤ G) :
    Function.Injective (basisConeInclusion (k := k) b) ∧
    (0 : AddMonoidAlgebra k (basisCone b)) ∉ basisConeDenominators (k := k) b ∧
    (∀ s : AddMonoidAlgebra k (basisCone b),
      s ∈ basisConeDenominators (k := k) b ↔
        ∃ a : Fin r → ℕ, (basisConeDenominator (k := k) b a).val = s) ∧
    ∃ θ : Localization (basisConeDenominators (k := k) b) ≃ₐ[k] AddMonoidAlgebra k G,
      (∀ a : AddMonoidAlgebra k (basisCone b),
        θ (algebraMap (AddMonoidAlgebra k (basisCone b))
          (Localization (basisConeDenominators (k := k) b)) a) = basisConeInclusion (k := k) b a) ∧
      (∀ φ : Localization (basisConeDenominators (k := k) b) →ₐ[k] AddMonoidAlgebra k G,
        (∀ a : AddMonoidAlgebra k (basisCone b),
          φ (algebraMap (AddMonoidAlgebra k (basisCone b))
            (Localization (basisConeDenominators (k := k) b)) a) =
            basisConeInclusion (k := k) b a) → φ = θ.toAlgHom) ∧
      (∀ (a : AddMonoidAlgebra k (basisCone b)) (s : basisConeDenominators (k := k) b),
        θ (Localization.mk a s) = basisConeInclusion (k := k) b a *
          Ring.inverse (basisConeInclusion (k := k) b s.val)) ∧
      (∀ n : Fin r → ℤ,
        θ.symm (single (∑ i, n i • b i) 1) =
          Localization.mk
            (basisConeDenominator (k := k) b (fun i ↦ (n i).toNat)).val
            (basisConeDenominator (k := k) b (fun i ↦ (-n i).toNat))) := by
  sorry

end AddMonoidAlgebra
