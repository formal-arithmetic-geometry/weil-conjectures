module

public import Sheaf.AlgebraicGeometry.FormalTaylorJetMatrices
public import Sheaf.RingTheory.SupportedHomogeneousDivision
public import Sheaf.RingTheory.PresentationFittingIdeal
public import Mathlib.RingTheory.MvPowerSeries.Trunc
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.MvPowerSeries.Inverse

/-! # Supported Taylor presentations and diagram pivots

Source: Bierstone--Milman, Invent. Math. 128 (1997), Lemma 7.7, Definitions 7.9,
7.12--7.13, Remark 7.11 and Theorem 7.14, pp.263--268; Stacks 07Z8 and 07ZA(3).
(blueprint: lem-trf-supported-taylor-presentation-pivots)

The jet matrices, factorials, degree-bounded monomials, and supported-division
notions are reused from their existing modules. The additional constructions are
canonical maps and restrictions for this presentation, with no existence choices.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u w

namespace AlgebraicGeometry.HilbertCoefficient

/-- Formal translation, defined by its normalized derivative coefficients.
Source: BM Definition 7.9, pp.265--266.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def formalTaylor {d : ℕ} {L : Type u} [Field L]
    (h : MvPowerSeries (Fin d) L) :
    MvPowerSeries (Fin d) (MvPowerSeries (Fin d) L) :=
  fun ν ↦ MvPowerSeries.C ((multiFactorial L ν)⁻¹) * iteratedPartial ν h

/-- The truncated polynomial ring `A[Y]/(Y)^(t+1)`.
Source: BM Definitions 7.9 and 7.12, pp.265--266.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def taylorTruncationIdeal (d : ℕ) (L : Type u) [Field L] (t : ℕ) :
    Ideal (MvPolynomial (Fin d) (MvPowerSeries (Fin d) L)) :=
  (Ideal.span (Set.range MvPolynomial.X)) ^ (t + 1)

/-- The ring of Taylor polynomials of order at most `t`.
Source: BM Definitions 7.9 and 7.12, pp.265--266.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
abbrev TaylorTruncation (d : ℕ) (L : Type u) [Field L] (t : ℕ) :=
  MvPolynomial (Fin d) (MvPowerSeries (Fin d) L) ⧸ taylorTruncationIdeal d L t

/-- Taylor translation reduced modulo `(Y)^(t+1)`.
Source: BM Definition 7.9, p.265.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def truncatedTaylor {d : ℕ} {L : Type u} [Field L] (t : ℕ)
    (h : MvPowerSeries (Fin d) L) : TaylorTruncation d L t :=
  Ideal.Quotient.mk _ (MvPowerSeries.truncTotal (t + 1) (formalTaylor h))

/-- The monomial class in the truncated Taylor ring.
Source: BM Definition 7.12, p.266.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def taylorMonomial {d : ℕ} {L : Type u} [Field L] (t : ℕ) (β : Fin d →₀ ℕ) :
    TaylorTruncation d L t :=
  Ideal.Quotient.mk _ (MvPolynomial.monomial β 1)

/-- The Taylor ideal generated by translates of all elements of `K`.
Source: BM Definition 7.9, p.265.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def taylorRelationIdeal {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) (t : ℕ) : Ideal (TaylorTruncation d L t) :=
  Ideal.span {z | ∃ h ∈ K, z = truncatedTaylor t h}

/-- The actual Taylor quotient `T_t/M_t`, with its canonical coefficient algebra.
Source: BM Definition 7.10, p.265.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
abbrev TaylorQuotient {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) (t : ℕ) :=
  TaylorTruncation d L t ⧸ taylorRelationIdeal K t

open Classical in
/-- The canonical monomial presentation of the actual Taylor quotient, indexed by `Fin N_t`.
Source: BM Remark 7.11 and Definition 7.12, pp.265--266; Stacks 07Z8.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def taylorPresentation {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) (t : ℕ) :
    (Fin (Fintype.card ↥(jetExponents (Fin d) t)) → MvPowerSeries (Fin d) L) →ₗ[
      MvPowerSeries (Fin d) L] TaylorQuotient K t :=
  Fintype.linearCombination _ (fun i ↦ Ideal.Quotient.mk (taylorRelationIdeal K t)
    (taylorMonomial t ((Fintype.equivFin ↥(jetExponents (Fin d) t)).symm i).val))

/-- Supported column indices, retaining their generator and monomial labels.
Source: BM Theorem 7.14, final paragraph, pp.267--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
abbrev SupportedTaylorIndex {d s : ℕ} (a : Fin s → Fin d →₀ ℕ) (t : ℕ) :=
  {p : Fin s × ↥(jetExponents (Fin d) t) // inDelta a p.1 p.2.val}

open Classical in
/-- Restrict the existing unrestricted matrix to the supported monomial columns.
Source: BM Theorem 7.14, final paragraph, pp.267--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def supportedTaylorMatrix {d s : ℕ} {L : Type u} [Field L]
    (a : Fin s → Fin d →₀ ℕ) (f : Fin s → MvPowerSeries (Fin d) L) (t : ℕ) :
    Matrix ↥(jetExponents (Fin d) t) (SupportedTaylorIndex a t) (MvPowerSeries (Fin d) L) :=
  (formalJetMatrix f t).submatrix id Subtype.val

/-- Supported columns whose least degree survives truncation.
Source: BM Lemma 7.7 and Theorem 7.14, pp.263--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
abbrev TaylorPivotIndex {d s : ℕ} (a : Fin s → Fin d →₀ ℕ) (t : ℕ) :=
  {p : SupportedTaylorIndex a t // p.val.2.val.degree + (a p.val.1).degree ≤ t}

/-- Rows of the truncated diagram.
Source: BM Definition 7.12 and Theorem 7.14, pp.266--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
abbrev TaylorDiagramIndex {d s : ℕ} (a : Fin s → Fin d →₀ ℕ) (t : ℕ) :=
  {γ : ↥(jetExponents (Fin d) t) // γ.val ∈ MonomialDiagram.generated a}

/-- Monomial rows outside the diagram.
Source: BM Lemma 7.7 and Theorem 7.14, pp.263--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
abbrev TaylorOutsideIndex {d s : ℕ} (a : Fin s → Fin d →₀ ℕ) (t : ℕ) :=
  {γ : ↥(jetExponents (Fin d) t) // γ.val ∉ MonomialDiagram.generated a}

open Classical in
/-- The claimed basis: specialized supported columns followed by outside monomials.
Source: BM Lemma 7.7 and Theorem 7.14, pp.263--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def taylorPivotFamily {d s : ℕ} {L : Type u} [Field L]
    (a : Fin s → Fin d →₀ ℕ) (f : Fin s → MvPowerSeries (Fin d) L) (t : ℕ) :
    TaylorPivotIndex a t ⊕ TaylorOutsideIndex a t → (↥(jetExponents (Fin d) t) → L)
  | .inl p => fun γ ↦ MvPowerSeries.constantCoeff (supportedTaylorMatrix a f t γ p.val)
  | .inr η => fun γ ↦ if γ = η.val then 1 else 0

open Classical in
/-- The supported column as an element of the truncated Taylor ring.
Source: BM Theorem 7.14, final paragraph, pp.267--268.
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
def supportedTaylorColumn {d s : ℕ} {L : Type u} [Field L]
    (a : Fin s → Fin d →₀ ℕ) (f : Fin s → MvPowerSeries (Fin d) L) (t : ℕ)
    (p : SupportedTaylorIndex a t) : TaylorTruncation d L t :=
  taylorMonomial t p.val.2.val * truncatedTaylor t (f p.val.1)

open Classical in
/-- Supported Taylor columns give the intrinsic quotient presentation and unit diagram pivot.

Proof (the eight DAG steps):
1. Formal transverse shift calculus with identity graph gives translation into the jointly
   completed ring. Regroup coefficients to obtain `A[[Y]]`; the binomial formula gives
   the normalized iterated derivative coefficients and multiplicativity.
2. The coefficient-module span of all translates is stable under each `Y_j`, since
   `Y_j τ(h) = τ(X_j*h) - X_j*τ(h)`. It therefore equals the Taylor ideal.
3. Each first-vertex quotient support is downward closed. Taylor translating a supported
   quotient keeps every `Y` exponent in that support. Apply supported generation of `K`
   to express each translate in the supported columns; the converse follows from step 2.
   Unrestricted and supported columns thus both present `T_t/M_t`.
4. Full-prefix homogeneous division supplies a homogeneous basis in each degree. Eliminate
   degrees successively through `t` to get the displayed truncated basis. A lowest-degree
   nonzero relation contradicts independence in that degree.
5. The disjoint sets `a_i + Δ_i` partition the diagram. The active columns number exactly
   its truncated cardinality; the remaining specialized columns vanish. Evaluated mutual
   column expressions give the same rank for the unrestricted matrix.
6. Adjoin the outside monomials. The specialized matrix has block form `[C,0;*,1]`, so
   `det C` has nonzero constant term. The power-series unit criterion makes it a unit.
   Empty determinants are one.
7. For positive `H=N-r`, the kernel-row Fitting ideal at `H-1` is generated by minors of
   size `r+1` of either matrix: expand determinants multilinearly in the generating columns.
   Apply presentation independence and arbitrary base change (Stacks 07Z8/07ZA). If `H=0`,
   the minors exceed the row count and their ideal is zero.
8. Any other finite ideal generators have the same translated ideal by multiplicativity.
   Their monomial columns present the same quotient, hence give the same minors ideal.
   The empty list, a degree-zero vertex and zero variables obey these arguments unchanged.

Source: BM Lemma 7.7, Definitions 7.9, 7.12--7.13, Remark 7.11 and Theorem 7.14,
pp.263--268; Stacks 07Z8 and 07ZA(3).
(blueprint: lem-trf-supported-taylor-presentation-pivots). -/
theorem supportedTaylorPresentation_pivots
    {L : Type u} [Field L] [CharZero L] {d s : ℕ}
    (a : Fin s → Fin d →₀ ℕ) (K : Ideal (MvPowerSeries (Fin d) L))
    (f : Fin s → MvPowerSeries (Fin d) L)
    (hdegree : ∀ i j : Fin s, i < j → (a i).degree ≤ (a j).degree)
    (hminimal : ∀ i j : Fin s, a i ≤ a j → i = j)
    (horder : ∀ i : Fin s, f i ∈ K ∧ (f i).order = ((a i).degree : ℕ∞))
    (hgeneration : ∀ h ∈ K, ∃ q : Fin s → MvPowerSeries (Fin d) L,
      h = ∑ i : Fin s, q i * f i ∧ ∀ i : Fin s, supported (q i) (inDelta a i))
    (hdivision : ∀ b k : ℕ, MonomialDiagram.HasUniqueDivision
      (MonomialDiagram.generated (MonomialDiagram.prefixVertices a b))
      (MonomialDiagram.prefixVertices a b)
      (fun i ↦ MvPowerSeries.truncTotal ((a i.val).degree + 1)
        (MvPowerSeries.homogeneousComponent (a i.val).degree (f i.val))) k)
    (t : ℕ) :
    ((formalTaylor (1 : MvPowerSeries (Fin d) L) = 1) ∧
      (∀ h g : MvPowerSeries (Fin d) L,
        formalTaylor (h + g) = formalTaylor h + formalTaylor g ∧
        formalTaylor (h * g) = formalTaylor h * formalTaylor g) ∧
      (∀ j : Fin d, formalTaylor (MvPowerSeries.X j : MvPowerSeries (Fin d) L) =
        MvPowerSeries.C (MvPowerSeries.X j) + MvPowerSeries.X j) ∧
      (∀ (h : MvPowerSeries (Fin d) L) (ν : Fin d →₀ ℕ),
        MvPowerSeries.coeff ν (formalTaylor h) =
          MvPowerSeries.C ((multiFactorial L ν)⁻¹) * iteratedPartial ν h)) ∧
    (taylorRelationIdeal K t).restrictScalars (MvPowerSeries (Fin d) L) =
      Submodule.span (MvPowerSeries (Fin d) L) {z | ∃ h ∈ K, z = truncatedTaylor t h} ∧
    (taylorRelationIdeal K t).restrictScalars (MvPowerSeries (Fin d) L) =
      Submodule.span (MvPowerSeries (Fin d) L) (Set.range (supportedTaylorColumn a f t)) ∧
    Function.Surjective (taylorPresentation K t) ∧
    Matrix.rank (fun γ p ↦ MvPowerSeries.constantCoeff (formalJetMatrix f t γ p)) =
      Fintype.card (TaylorDiagramIndex a t) ∧
    Matrix.rank (fun γ p ↦ MvPowerSeries.constantCoeff (supportedTaylorMatrix a f t γ p)) =
      Fintype.card (TaylorDiagramIndex a t) ∧
    LinearIndependent L (taylorPivotFamily a f t) ∧
    Submodule.span L (Set.range (taylorPivotFamily a f t)) = ⊤ ∧
    (∃ e : TaylorPivotIndex a t ≃ TaylorDiagramIndex a t,
      IsUnit (Matrix.det (fun i j : TaylorPivotIndex a t ↦
        supportedTaylorMatrix a f t (e i).val j.val))) ∧
    finiteMinorIdeal (formalJetMatrix f t) (formalJetRank f t + 1) =
      finiteMinorIdeal (supportedTaylorMatrix a f t) (formalJetRank f t + 1) ∧
    (0 < Fintype.card ↥(jetExponents (Fin d) t) - formalJetRank f t →
      finiteMinorIdeal (formalJetMatrix f t) (formalJetRank f t + 1) =
        (taylorPresentation K t).presentationFittingIdeal
          (Fintype.card ↥(jetExponents (Fin d) t) - formalJetRank f t - 1)) ∧
    (Fintype.card ↥(jetExponents (Fin d) t) - formalJetRank f t = 0 →
      finiteMinorIdeal (formalJetMatrix f t) (formalJetRank f t + 1) = ⊥) ∧
    (∀ (s' : ℕ) (g : Fin s' → MvPowerSeries (Fin d) L),
      Ideal.span (Set.range g) = K →
        formalJetMinorIdeal f t = formalJetMinorIdeal g t) ∧
    (0 < Fintype.card ↥(jetExponents (Fin d) t) - formalJetRank f t →
      ∀ (A' : Type w) [CommRing A'] [Algebra (MvPowerSeries (Fin d) L) A'],
        Ideal.map (algebraMap (MvPowerSeries (Fin d) L) A')
          (finiteMinorIdeal (formalJetMatrix f t) (formalJetRank f t + 1)) =
        ((taylorPresentation K t).baseChangePresentation A').presentationFittingIdeal
          (Fintype.card ↥(jetExponents (Fin d) t) - formalJetRank f t - 1)) := by
  sorry

end AlgebraicGeometry.HilbertCoefficient
