module

public import Sheaf.RingTheory.NagataRing
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Localization.AtPrime.Basic
import Sheaf.RingTheory.AdjoinSingletonFiniteSplitAlgebra
import Sheaf.RingTheory.FiniteAwayMaximalLocalization
import Mathlib.Algebra.BigOperators.Fin

/-! # Split polynomial data for a finite localized cover
Source: Stacks Project, Algebra, Tag 0334, Step 5. -/

@[expose] public section

universe u v

set_option maxHeartbeats 600000 in
-- The existential ring structures and localization algebra make elaboration expensive.
/-- A finite localized splitting cover carries a single positive-degree split polynomial
whose evaluation belongs to every maximal contraction.
Source: Stacks Project, Algebra, Tag 0334, Step 5, before extracting a linear factor.
(blueprint: lem-weil-pbc-monogenic-splitting-polynomial-cover).

Proof: Put S = R[x], A = S_m and n = m ∩ R. The residue field of m is generated by
x over Frac(R/n), hence is a finite extension by Zariski's lemma. Take the monic minimal
polynomial of the residue of x; its degree d is positive. Lift its coefficients to R_n,
then invert one product s of their denominators, all outside n. This gives a monic
polynomial f over R_s with f(x) in mS_s. Embed K in a finite splitting field L of f and
let R' be the integral closure of R_s in L. The Nagata localization theorem and the N-2
property make R' finite over R_s. Integral closure is normal and has fraction field L;
finiteness over a Nagata ring makes R' Nagata. Each of the d roots of f is integral over
R_s by monicity, so lies in R'. Enumerate the roots with multiplicities by Fin d.
Let z be the image of x in L, T = R'[z], and M the image in T of S minus m. The finite
R_s-module generators of R' also generate T over S_s: expand each polynomial in z and
collect the coefficients in those generators. Localizing this finite inclusion gives
an injective finite A-algebra B = M⁻¹T, since s is already invertible in A. The maps
into L are injective, so the elements of M are nonzero divisors in the domain T.
For any maximal ideal q of B, integrality over the local ring A makes its contraction
mA. Its contraction n0 to T therefore lies over mS_s. Since T is integral over S_s,
n0 is maximal. The element f(z) is in n0 because f(x) is in mS_s. Evaluating the monic
factorization of f gives f(z) = ∏ i, (z - roots i), proving the asserted product membership
simultaneously for every q. Use universe lifts of R_s and L to Type(max u v).
The extraction of a single factor from this product is not part of this construction. -/
theorem exists_adjoin_singleton_splitting_polynomial_cover
    (R : Type u) (K : Type v) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [Field K] [Algebra R K] [IsFractionRing R K] (hR : IsNagataRing R) (x : K)
    (m : Ideal (Algebra.adjoin R ({x} : Set K))) [m.IsMaximal] :
    ∃ (R' K' : Type (max u v)) (_ : CommRing R') (_ : IsDomain R')
      (_ : IsIntegrallyClosed R') (_ : Field K') (_ : Algebra R' K')
      (_ : IsFractionRing R' K'),
      IsNagataRing R' ∧ ∃ (z : K') (M : Submonoid (Algebra.adjoin R' ({z} : Set K'))),
        M ≤ nonZeroDivisors (Algebra.adjoin R' ({z} : Set K')) ∧
        ∃ (_ : Algebra (Localization.AtPrime m) (Localization M)),
          Function.Injective (algebraMap (Localization.AtPrime m) (Localization M)) ∧
          Module.Finite (Localization.AtPrime m) (Localization M) ∧
          ∃ (d : ℕ) (roots : Fin d → R'), 0 < d ∧
            ∀ (q : Ideal (Localization M)) [q.IsMaximal],
              (q.comap (algebraMap (Algebra.adjoin R' ({z} : Set K'))
                (Localization M))).IsMaximal ∧
              (∏ i : Fin d,
                ((⟨z, Algebra.subset_adjoin (Set.mem_singleton z)⟩ :
                  Algebra.adjoin R' ({z} : Set K')) -
                  algebraMap R' (Algebra.adjoin R' ({z} : Set K')) (roots i))) ∈
                q.comap (algebraMap (Algebra.adjoin R' ({z} : Set K'))
                  (Localization M)) := by
  classical
  obtain ⟨s, hs, R', K', cR, dR, nR, cK, aK, frac, hR', z, g, hg, hfin, f, hf, hd, hsplit,
    hmem⟩ := exists_adjoin_singleton_finite_split_algebra R K hR x m
  let S := Algebra.adjoin R ({x} : Set K)
  let T := Algebra.adjoin R' ({z} : Set K')
  let h : S →+* T := g.comp (algebraMap S (Localization.Away s))
  let M := m.primeCompl.map h
  have hs0 : s ≠ 0 := fun e ↦ hs (e ▸ m.zero_mem)
  have hinj : Function.Injective h := hg.comp
    (IsLocalization.injective (Localization.Away s) (Submonoid.powers_le.mpr
      (mem_nonZeroDivisors_iff_ne_zero.mpr hs0)))
  have hM : M ≤ nonZeroDivisors T := by
    rintro t ⟨a, ha, rfl⟩
    apply mem_nonZeroDivisors_iff_ne_zero.mpr
    intro he
    have ha0 : a = 0 := hinj (he.trans h.map_zero.symm)
    exact ha (ha0 ▸ m.zero_mem)
  obtain ⟨alg, hi, hfinite, hq⟩ :=
    exists_finite_away_maximal_localization S T m s hs g hg hfin
  let := alg
  let t : T := ⟨z, Algebra.subset_adjoin (Set.mem_singleton z)⟩
  let l := f.roots.toList
  let roots : Fin l.length → R' := l.get
  have hlen : l.length = f.natDegree := by
    simpa [l] using hsplit.natDegree_eq_card_roots.symm
  have heval : (∏ i : Fin l.length, (t - algebraMap R' T (roots i))) =
      Polynomial.aeval t f := by
    rw [hsplit.eq_prod_roots_of_monic hf]
    simp only [map_multiset_prod, Multiset.map_map, Function.comp_def, map_sub,
      Polynomial.aeval_X, Polynomial.aeval_C]
    change (∏ i : Fin l.length, (t - algebraMap R' T (l.get i))) =
      (f.roots.map (fun a ↦ t - algebraMap R' T a)).prod
    rw [← List.prod_ofFn]
    have he : List.ofFn (fun i ↦ t - algebraMap R' T (l.get i)) =
        l.map (fun a ↦ t - algebraMap R' T a) := by
      simpa only [Function.comp_def, List.ofFn_get] using
        (List.map_ofFn (f := l.get) (g := fun a ↦ t - algebraMap R' T a)).symm
    rw [he]
    simp [l]
  refine ⟨R', K', cR, dR, nR, cK, aK, frac, hR', z, M, hM, alg, hi, hfinite,
    l.length, roots, hlen.symm ▸ hd, ?_⟩
  intro q hqmax
  obtain ⟨hqM, hle⟩ := hq q
  refine ⟨hqM, ?_⟩
  change (∏ i : Fin l.length, (t - algebraMap R' T (roots i))) ∈ _
  rw [heval]
  exact hle hmem

