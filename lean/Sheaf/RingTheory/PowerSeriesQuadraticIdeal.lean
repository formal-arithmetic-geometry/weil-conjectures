module

public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.Ideal.Operations

/-!
# Power series with vanishing terms of degree less than two

Source: Stacks Project, More on Algebra, Tag 07EI, construction of f₁.
(blueprint: lem-weil-pbc-power-series-quadratic-ideal).
-/

@[expose] public section

universe u v

namespace MvPowerSeries

/-- A power series with zero constant and linear coefficients belongs to the square
of the ideal generated by the variables, provided there are finitely many variables.
Source: Stacks Project, More on Algebra, Tag 07EI, construction of f₁, expanded
coefficient description of its first-order power-series quotient.
(blueprint: lem-weil-pbc-power-series-quadratic-ideal)

Proof: For every exponent E admitting a pair of variable factors, choose one such
pair (i,j), allowing repetition. Such a pair exists unless E is zero or a single
unit vector: choose one factor i of nonzero E, and then a factor j of E - e_i if
that difference is nonzero. The coefficients at the two excluded forms vanish
by the hypotheses. For each pair define f_ij coefficientwise: its coefficient
at D is the coefficient of f at D + e_i + e_j if that exponent is assigned to
(i,j), and is zero otherwise.
Then f = sum_ij X_i X_j f_ij. Check coefficients: an exponent of degree at least
two occurs in exactly its assigned summand, whose two removed factors recover
its coefficient. At degrees zero and one both sides have coefficient zero by the
hypotheses. Each summand lies in N² because X_i and X_j lie in N, and there are
finitely many summands. If the variable set is empty, every exponent is zero and
the constant-coefficient hypothesis already says f = 0. The argument works over
any commutative ring, including the zero ring and positive characteristic. -/
theorem mem_span_X_sq_of_coeff_eq_zero (σ : Type u) [Finite σ]
    (R : Type v) [CommRing R] (f : MvPowerSeries σ R)
    (h0 : constantCoeff f = 0)
    (h1 : ∀ i : σ, coeff (Finsupp.single i 1) f = 0) :
    f ∈ (Ideal.span (Set.range (fun i ↦ (X i : MvPowerSeries σ R)))) ^ 2 := by
  classical
  let := Fintype.ofFinite σ
  have hex (m : σ →₀ ℕ) (hm : m ≠ 0) : ∃ i, Finsupp.single i 1 ≤ m := by
    obtain ⟨i, hi⟩ := DFunLike.ne_iff.mp hm
    refine ⟨i, Finsupp.single_le_iff.mpr ?_⟩
    exact Nat.one_le_iff_ne_zero.mpr (by simpa using hi)
  let pair (p : σ × σ) : σ →₀ ℕ := Finsupp.single p.1 1 + Finsupp.single p.2 1
  have hlow (m : σ →₀ ℕ) (hm : ¬ ∃ p, pair p ≤ m) : coeff m f = 0 := by
    by_cases hzero : m = 0
    · subst m
      exact h0
    obtain ⟨i, hi⟩ := hex m hzero
    by_cases hsub : m - Finsupp.single i 1 = 0
    · have heq : m = Finsupp.single i 1 := le_antisymm (tsub_eq_zero_iff_le.mp hsub) hi
      rw [heq]
      exact h1 i
    obtain ⟨j, hj⟩ := hex _ hsub
    apply False.elim
    apply hm
    refine ⟨(i, j), ?_⟩
    calc
      pair (i, j) = Finsupp.single j 1 + Finsupp.single i 1 := add_comm _ _
      _ ≤ (m - Finsupp.single i 1) + Finsupp.single i 1 := add_le_add hj le_rfl
      _ = m := tsub_add_cancel_of_le hi
  cases isEmpty_or_nonempty σ with
  | inl hempty =>
    let := hempty
    have hf : f = 0 := by
      ext m
      have hm : m = 0 := Subsingleton.elim _ _
      simpa only [hm, coeff_zero_eq_constantCoeff_apply, map_zero] using h0
    rw [hf]
    exact Ideal.zero_mem _
  | inr hnonempty =>
    let := hnonempty
    let pick (m : σ →₀ ℕ) : σ × σ :=
      if h : ∃ p, pair p ≤ m then h.choose else Classical.choice inferInstance
    have hpick (m : σ →₀ ℕ) (hm : ∃ p, pair p ≤ m) : pair (pick m) ≤ m := by
      dsimp only [pick]
      rw [dif_pos hm]
      exact hm.choose_spec
    let g (p : σ × σ) : MvPowerSeries σ R := fun d ↦
      if pick (d + pair p) = p then coeff (d + pair p) f else 0
    let t (p : σ × σ) : MvPowerSeries σ R := monomial (pair p) 1 * g p
    have hsum : f = ∑ p : σ × σ, t p := by
      ext m
      rw [map_sum]
      by_cases hm : ∃ p, pair p ≤ m
      · have hm' := hpick m hm
        rw [Finset.sum_eq_single (pick m)]
        · change coeff m f = coeff m (monomial (pair (pick m)) 1 * g (pick m))
          rw [coeff_monomial_mul, if_pos hm', one_mul]
          change coeff m f = if pick (m - pair (pick m) + pair (pick m)) = pick m
            then coeff (m - pair (pick m) + pair (pick m)) f else 0
          rw [tsub_add_cancel_of_le hm', if_pos rfl]
        · intro p _ hp
          change coeff m (monomial (pair p) 1 * g p) = 0
          rw [coeff_monomial_mul]
          by_cases hpm : pair p ≤ m
          · rw [if_pos hpm, one_mul]
            change (if pick (m - pair p + pair p) = p
              then coeff (m - pair p + pair p) f else 0) = 0
            rw [tsub_add_cancel_of_le hpm, if_neg (Ne.symm hp)]
          · rw [if_neg hpm]
        · simp
      · rw [hlow m hm]
        apply Eq.symm
        apply Finset.sum_eq_zero
        intro p _
        change coeff m (monomial (pair p) 1 * g p) = 0
        rw [coeff_monomial_mul, if_neg (fun hp ↦ hm ⟨p, hp⟩)]
    rw [hsum]
    apply Submodule.sum_mem
    intro p _
    have hmono : (monomial (pair p) 1 : MvPowerSeries σ R) = X p.1 * X p.2 := by
      simp only [X, monomial_mul_monomial, one_mul, pair]
    change monomial (pair p) 1 * g p ∈ _
    rw [hmono]
    apply Ideal.mul_mem_right
    rw [pow_two]
    exact Ideal.mul_mem_mul (Ideal.subset_span ⟨p.1, rfl⟩)
      (Ideal.subset_span ⟨p.2, rfl⟩)

end MvPowerSeries
