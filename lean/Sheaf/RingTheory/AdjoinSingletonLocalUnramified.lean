/-!
# The local calculation for a fractional monogenic algebra

Source: Stacks Project, Algebra, Tag 0334, Step 5, after replacing `x` by `x - r`.
(blueprint: lem-weil-pbc-monogenic-generator-in-maximal-unramified).
-/

@[expose] public section

universe u v

/-- A maximal localization containing the adjoined fraction is analytically unramified.
Source: Stacks Project, Algebra, Tag 0334, Step 5, lines 46169--46221.
(blueprint: lem-weil-pbc-monogenic-generator-in-maximal-unramified).

Proof:
1. If `x = 0`, the algebra is `R`, and its maximal localization is a Nagata local
   domain by Tag 032U, hence analytically unramified by Tag 0331.
2. Otherwise let `I` be the kernel of `R[T] → R[x]`. For a polynomial vanishing at `x`,
   its leading coefficient times `x` is integral (Tag 00PQ), hence belongs to `R`.
   Subtract the resulting linear relation times the appropriate power of `T` and
   induct on degree. Thus `I` is generated by the linear relations `cT - d` with `cx = d`.
   Modulo `T` this gives `R[x]/xR[x] = R/J`, where `J = R ∩ xR`.
3. Tag 031T gives no embedded associated primes of `R/J`, all of height one. Transport
   these primes across the quotient identification and localize at the maximal ideal.
   For each surviving prime `q` and its contraction `p`, the ring `R_p` is a DVR
   (Tag 00PD). The valuation of `x` cannot be negative: otherwise `x⁻¹` and `x` would
   both lie in `qR[x]_q`. Thus `x ∈ R_p`, so `R[x]_q = R_p`, which is regular.
4. Since `x ∈ q`, the prime quotient `R[x]/q` is `R/p`. Its localization at the chosen
   maximal ideal is Nagata by Tags 032T and 032U and is analytically unramified by
   Tag 0331. Thus the nonzero element `x` of the local maximal ideal satisfies all
   three hypotheses of Tag 0330: no embedded primes, regular associated-prime
   localizations, and analytically unramified prime quotients. Apply that criterion. -/
theorem isAnalyticallyUnramified_adjoin_singleton_atPrime_of_mem
    (R : Type u) (K : Type v) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [IsNoetherianRing R] [Field K] [Algebra R K] [IsFractionRing R K]
    (hR : IsNagataRing R) (x : K)
    [IsNoetherianRing (Algebra.adjoin R ({x} : Set K))]
    (m : Ideal (Algebra.adjoin R ({x} : Set K))) [m.IsMaximal]
    (hx : (⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩ :
      Algebra.adjoin R ({x} : Set K)) ∈ m) :
    IsAnalyticallyUnramified (Localization.AtPrime m) := by
  classical
  let S := Algebra.adjoin R ({x} : Set K)
  let A := Localization.AtPrime m
  by_cases hx0 : x = 0
  · have hxIntegral : IsIntegral R x := hx0 ▸ isIntegral_zero
    let : Module.Finite R S := Algebra.finite_adjoin_simple_of_isIntegral hxIntegral
    have hS : IsNagataRing S := (finite_over_nagata_is_nagata R S hR).1
    have hA : IsNagataRing A := (isNagataRing_localization S m.primeCompl hS).2.1 m
    exact isAnalyticallyUnramified_of_isNagataRing A hA
  · let tS : S := ⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩
    let t : A := algebraMap S A tS
    have htS : tS ≠ 0 := by
      intro h
      exact hx0 (congrArg (fun z : S ↦ (z : K)) h)
    have ht : t ≠ 0 := by
      exact fun h ↦ htS ((IsLocalization.injective A m.primeCompl_le_nonZeroDivisors)
        (by simpa only [map_zero] using h))
    have htm : t ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m A]
      exact Ideal.mem_map_of_mem (algebraMap S A) hx
    obtain ⟨hnoEmbedded, hregular, hunramified⟩ :=
      adjoin_singleton_atPrime_principal_quotient_conditions R K hR x hx0 m hx
    exact isAnalyticallyUnramified_of_principal_quotient A t ht htm
      hnoEmbedded hregular hunramified
