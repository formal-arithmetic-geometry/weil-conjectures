module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Smooth.Basic

/-! # Unramified localization of the corrected-coordinate map

Source: Stacks Project, proof of Lemma 07CH.
(blueprint: lem-weil-pbc-conormal-chart-unramified-localization).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Algebra

/-- A right inverse to the equation Jacobian makes the explicit corrected-coordinate map
unramified after localizing at an element with constant coefficient one.

Source: Stacks Project, proof of Lemma 07CH, the differential calculation and Nakayama
paragraph (smoothing.tex, lines 606--671), https://stacks.math.columbia.edu/tag/07CH.
(blueprint: lem-weil-pbc-conormal-chart-unramified-localization).

Proof. Put C = R[x]/(f), D = C[y], and z_i = x_i - sum_j a_ij y_j. The module of
D-differentials relative to R[z] is generated by the dx_i and dy_j: these elements generate
D as an R-algebra. Modulo (y) times this module, dz_i = 0 gives
 dx_i = sum_j a_ij dy_j. Differentiating f_j = 0 and using the assumed right-inverse
identity then gives dy_j = 0 modulo (y). Thus all the generators belong to (y) times the
module. This module is finite, since D is finite type over R[z] (the original x and y
still generate it). Nakayama's determinant argument gives g - 1 in (y) annihilating the
module. The constant-coefficient map kills every y_j, so constantCoeff g = 1.
Localization of differentials identifies the relative differentials of D_g with the
localization of this annihilated module; since g becomes a unit, that module is zero.
Vanishing of relative differentials is formal unramifiedness. The argument includes
empty sets of variables or equations and zero coefficient rings. -/
theorem exists_unramified_conormal_polynomial_chart
    (R : Type u) [CommRing R] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) R)
    (a : Fin n → Fin c → MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f))
    (ha : ∀ j k, ∑ i, Ideal.Quotient.mk (Ideal.span (Set.range f))
      (MvPolynomial.pderiv i (f j)) * a i k = if j = k then 1 else 0) :
    let C := MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)
    let D := MvPolynomial (Fin c) C
    let θ : MvPolynomial (Fin n) R →ₐ[R] D := MvPolynomial.aeval
      (fun i ↦ MvPolynomial.C (Ideal.Quotient.mk (Ideal.span (Set.range f))
        (MvPolynomial.X i)) - ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X j)
    ∃ g : D, MvPolynomial.constantCoeff g = 1 ∧
      @FormallyUnramified (MvPolynomial (Fin n) R) (Localization.Away g) _ _
        (((IsScalarTower.toAlgHom R D (Localization.Away g)).comp θ).toRingHom.toAlgebra) := by
  sorry

end Algebra
