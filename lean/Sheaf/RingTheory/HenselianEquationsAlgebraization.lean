/-!
# Algebraization of equations from a pair henselization

Source: Stacks Project, Tag 0GAS, `lemma-algebraize-easy`, and the last displayed
identity in the proof of `proposition-approximate` in `restricted.tex`
(blueprint: lem-per-henselian-equations-algebraization).
-/

@[expose] public section

set_option autoImplicit false

universe u v

open CategoryTheory CategoryTheory.Limits

namespace RingTheory

/-- A quotient of the completion by equations from the pair henselization has a finite
 type algebraic model. The cocone and its colimit witness present the henselization,
 exactly as in `pair_henselization`. The projection condition on `θ` is the normalization
 in `pair_henselization_noetherian_completion`. The ideal on the right is `Q` extended
 along `γ = θ.symm ∘ (H → Ĥ)`, hence is generated by the images of all elements of `Q`.

Source: Stacks Project, Tag 0GAS, `lemma-algebraize-easy`, in the quotient-of-completion
form of the last displayed identity in the proof of `proposition-approximate`
(blueprint: lem-per-henselian-equations-algebraization).

Proof:
1. `lem-weil-pbc-finite-type-algebra-noetherian` makes `S` Noetherian. Apply
   `lem-weil-pbc-henselization-noetherian-completion` to `(S, IS)` to make `H`
   Noetherian and identify its completion canonically. Choose finite generators
   `q₁, …, qₘ` of `Q` using `def-weil-pbc-noetherian-ring`, allowing `m = 0`.
2. Use essential smallness and filteredness from `lem-weil-pbc-pair-henselization`
   and representatives from `lem-weil-pbc-filtered-colimit-algebras-elementwise`.
   All the generators lift to a common etale stage `D` trivial modulo `IS`.
   For the empty family choose the identity stage. Lift `qⱼ` to `dⱼ`, put
   `J = (d₁, …, dₘ)` in `D`, and take `C = D/J`.
3. By `lem-weil-pbc-etale-algebra-finite-presentation-localization`, `D` is finite
   type over `S`. Combine generators for `S/A` and `D/S`, then pass to the quotient:
   `C` is finite type over `A` in `def-weil-pbc-finite-type-algebra`'s sense.
   `lem-weil-pbc-finite-type-algebra-noetherian` also makes `D` Noetherian.
4. `lem-weil-pbc-etale-algebra-flat` makes `S → D` flat. Apply
   `lem-weil-pbc-flat-iso-mod-ideal-powers` to its isomorphism modulo `IS`.
   The compatible quotient isomorphisms give `a : Ŝ ≃ D̂`, with inverse `β`.
   If `f : D → H` is the coprojection, its completion satisfies `f̂ a = θ` by
   the quotient normalization of `lem-weil-pbc-henselization-noetherian-completion`.
   Consequently `β c_D = γ f`, where `c_D` is the completion map.
5. Apply `lem-weil-pbc-completion-exact-finite-modules` to `0 → J → D → C → 0`.
   The coordinatewise quotient map `D̂ → Ĉ` is surjective. By
   `lem-weil-pbc-completion-finite-module-tensor`, the image of `Ĵ` is precisely
   the ideal generated by the `c_D(dⱼ)`. Thus `Ĉ ≃ D̂/JD̂`. Transport this quotient
   by `β`: its ideal becomes `(γ(q₁), …, γ(qₘ)) = Q Ŝ`. Taking the inverse
   quotient comparison gives the asserted `A`-algebra isomorphism. -/
theorem henselian_equations_algebraization
    (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    (S : Type v) [CommRing S] [Algebra A S]
    (hS : (algebraMap A S).FiniteType)
    (c : Cocone (ObjectProperty.ι
      (fun D : Under (CommRingCat.of S) ↦
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map D.hom) ∧
          Function.Bijective (Ideal.quotientMap
            ((I.map (algebraMap A S)).map D.hom.hom) D.hom.hom Ideal.le_comap_map))))
    (hc : IsColimit c)
    (θ : AdicCompletion (I.map (algebraMap A S)) S ≃+*
      AdicCompletion ((I.map (algebraMap A S)).map c.pt.hom.hom) c.pt.right)
    (hθ : ∀ (n : ℕ) (x : AdicCompletion (I.map (algebraMap A S)) S) (s : S),
      AdicCompletion.evalₐ (I.map (algebraMap A S)) n x =
          Ideal.Quotient.mk ((I.map (algebraMap A S)) ^ n) s →
        AdicCompletion.evalₐ ((I.map (algebraMap A S)).map c.pt.hom.hom) n (θ x) =
          Ideal.Quotient.mk (((I.map (algebraMap A S)).map c.pt.hom.hom) ^ n)
            (c.pt.hom.hom s))
    (Q : Ideal c.pt.right) :
    ∃ (C : CommRingCat.{max u v}) (_ : Algebra A C),
      (algebraMap A C).FiniteType ∧
        Nonempty (AdicCompletion (I.map (algebraMap A C)) C ≃ₐ[A]
          (AdicCompletion (I.map (algebraMap A S)) S) ⧸
            Q.map (θ.symm.toRingHom.comp
              (algebraMap c.pt.right
                (AdicCompletion ((I.map (algebraMap A S)).map c.pt.hom.hom)
                  c.pt.right)))) := by
  sorry

end RingTheory
