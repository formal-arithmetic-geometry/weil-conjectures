module

public import Sheaf.RingTheory.PopescuLiftPresentation
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.Tactic.Ring

/-! # Clearing the conormal transition coefficients

Source: Stacks Project, Tag 07CP, comparison of the two conormal expressions.
(blueprint: lem-weil-pbc-popescu-conormal-transition-coefficients).
-/

@[expose] public section

universe a c

namespace Algebra.PopescuLiftPresentation

/-- A power of the chart element clears each conormal transition coefficient.

Source: Stacks Project, Tag 07CP (lemma-lifting), the coefficient comparison
in the final part of the proof, immediately before the expansion modulo pi.
(blueprint: lem-weil-pbc-popescu-conormal-transition-coefficients).

Proof: Reduce the prepared relations modulo pi squared. In the conormal module,
multiply the k-th expression for f_l by a_k', and multiply the k'-th expression
by a_k. Substitute the k-th expression for every f_j' in the latter sum.
Commutativity identifies the left sides. Subtracting gives the linear combination
of the classes of f_j, j in E_k, with coefficients
b_j = a_k' h_klj - sum_{j' in E_k'} h_k'lj' h_kj'j.
Localize this identity at the image of a_k in the reduced quotient. The specified
basis consists exactly of these classes, so its linear independence forces every
coefficient b_j to vanish in that localized quotient. The localization equality
criterion gives an exponent N with a_k^N b_j in the reduced ideal. Express this
membership as a finite sum of multiples of the reduced f_i, and lift its
coefficients through the surjective reduction map on multivariate polynomials.
The difference between a_k^N b_j and the lifted sum lies in the kernel of
coefficient reduction, the ideal generated by the constant polynomial pi squared.
Thus the unreduced product belongs to the sum of the two displayed ideals.
No nonzero-ring assumption is used; an empty E_k makes the assertion vacuous.
-/
theorem conormal_transition_coefficients
    {R : Type a} {Cbar : Type c} [CommRing R] [CommRing Cbar] [Algebra R Cbar] {π : R}
    [Algebra (R ⧸ Ideal.span ({π ^ 2} : Set R)) Cbar]
    (d : PopescuLiftPresentation R Cbar π) (hd : d.Prepared)
    (k k' : Fin d.r) (l j : Fin d.m) (hj : j ∈ d.E k) :
    ∃ N : ℕ, d.a k ^ N *
        (d.a k' * d.h k l j - ∑ j' ∈ d.E k', d.h k' l j' * d.h k j' j) ∈
      Ideal.span (Set.range d.f) ⊔
        Ideal.span ({MvPolynomial.C (π ^ 2)} : Set (MvPolynomial (Fin d.n) R)) := by
  classical
  let P := MvPolynomial (Fin d.n) (R ⧸ Ideal.span ({π ^ 2} : Set R))
  let I : Ideal P := d.reducedIdeal
  let A := P ⧸ I
  let ak : A := d.reducedElement k
  let L := Localization.Away ak
  let M := LocalizedModule.Away ak I.Cotangent
  let red : MvPolynomial (Fin d.n) R →+* P := MvPolynomial.map (Ideal.Quotient.mk _)
  let q : P →+* A := Ideal.Quotient.mk I
  let σ : MvPolynomial (Fin d.n) R →+* L :=
    (algebraMap A L).comp (q.comp red)
  let μ := LocalizedModule.mkLinearMap (Submonoid.powers ak) I.Cotangent
  let v (i : Fin d.m) : I := ⟨red (d.f i), Ideal.subset_span ⟨i, rfl⟩⟩
  let w (i : Fin d.m) : M := μ (I.toCotangent (v i))
  have hred (s : Fin d.r) (i : Fin d.m) :
      red (d.a s) * red (d.f i) = ∑ t ∈ d.E s, red (d.h s i t) * red (d.f t) := by
    have hi := congrArg red (hd.relation s i)
    have hπ2 : red (MvPolynomial.C (π ^ 2)) = 0 := by
      change MvPolynomial.map (Ideal.Quotient.mk (Ideal.span ({π ^ 2} : Set R)))
        (MvPolynomial.C (π ^ 2)) = 0
      rw [MvPolynomial.map_C]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _)),
        MvPolynomial.C_0]
    simpa only [map_mul, map_add, map_sum, hπ2, zero_mul, add_zero] using hi
  have hrel (s : Fin d.r) (i : Fin d.m) :
      σ (d.a s) • w i = ∑ t ∈ d.E s, σ (d.h s i t) • w t := by
    have hi : red (d.a s) • v i = ∑ t ∈ d.E s, red (d.h s i t) • v t := by
      apply Subtype.ext
      simpa only [Submodule.coe_smul, Submodule.coe_sum, smul_eq_mul] using hred s i
    have hi' := congrArg (fun x : I ↦ μ (I.toCotangent x)) hi
    simp only [map_sum, map_smul, LinearMap.map_smul_of_tower] at hi'
    have hq (p : P) (x : M) : q p • x = p • x :=
      IsScalarTower.algebraMap_smul A p x
    change algebraMap A L (q (red (d.a s))) • w i =
      ∑ t ∈ d.E s, algebraMap A L (q (red (d.h s i t))) • w t
    simp only [IsScalarTower.algebraMap_smul, hq]
    exact hi'
  obtain ⟨basis, hb⟩ := hd.conormal k
  let coord : M →ₗ[L] L := basis.coord ⟨j, hj⟩
  have hc (t : Fin d.m) (ht : t ∈ d.E k) : coord (w t) = if t = j then 1 else 0 := by
    have hw : w t = basis ⟨t, ht⟩ := (hb ⟨t, ht⟩).symm
    rw [hw]
    change basis.repr (basis ⟨t, ht⟩) ⟨j, hj⟩ = _
    rw [basis.repr_self_apply]
    simp only [Subtype.mk.injEq]
  have hcoord (s : Fin d.r) (i : Fin d.m) :
      σ (d.a s) * coord (w i) = ∑ t ∈ d.E s, σ (d.h s i t) * coord (w t) := by
    have hi := congrArg coord (hrel s i)
    simpa only [map_smul, map_sum, smul_eq_mul] using hi
  have hchosen (i : Fin d.m) : σ (d.a k) * coord (w i) = σ (d.h k i j) := by
    rw [hcoord]
    rw [Finset.sum_eq_single j]
    · rw [hc j hj, if_pos rfl, mul_one]
    · intro t ht htj
      rw [hc t ht, if_neg htj, mul_zero]
    · exact fun h ↦ (h hj).elim
  have hcoef : σ (d.a k' * d.h k l j -
      ∑ j' ∈ d.E k', d.h k' l j' * d.h k j' j) = 0 := by
    simp only [map_sub, map_mul, map_sum]
    rw [← hchosen l]
    have hsum : (∑ t ∈ d.E k', σ (d.h k' l t) * σ (d.h k t j)) =
        σ (d.a k) * ∑ t ∈ d.E k', σ (d.h k' l t) * coord (w t) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro t _
      rw [← hchosen t]
      ring
    rw [hsum, ← hcoord k' l]
    ring
  let b := d.a k' * d.h k l j - ∑ j' ∈ d.E k', d.h k' l j' * d.h k j' j
  have hz : algebraMap A L (q (red b)) = algebraMap A L 0 := by
    simpa only [σ, RingHom.comp_apply, map_zero] using hcoef
  obtain ⟨N, hN⟩ := IsLocalization.Away.exists_of_eq (x := ak) hz
  have hm : red (d.a k ^ N * b) ∈ I := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q (red (d.a k ^ N * b)) = 0
    simpa only [map_mul, map_pow, ak, reducedElement, reduced, red, q,
      mul_zero] using hN
  let F := Ideal.span (Set.range d.f)
  have hmap : Ideal.map red F = I := by
    rw [Ideal.map_span]
    change Ideal.span (red '' Set.range d.f) = Ideal.span (Set.range (fun i ↦ red (d.f i)))
    rw [← Set.range_comp, Function.comp_def]
  have hsurj : Function.Surjective red :=
    MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hker : RingHom.ker red =
      Ideal.span ({MvPolynomial.C (π ^ 2)} : Set (MvPolynomial (Fin d.n) R)) := by
    rw [MvPolynomial.ker_map, Ideal.mk_ker, Ideal.map_span, Set.image_singleton]
  refine ⟨N, ?_⟩
  have hpre : d.a k ^ N * b ∈ Ideal.comap red (Ideal.map red F) := by
    rw [hmap]
    exact hm
  rw [Ideal.comap_map_of_surjective red hsurj, ← RingHom.ker_eq_comap_bot, hker] at hpre
  exact hpre

end Algebra.PopescuLiftPresentation
