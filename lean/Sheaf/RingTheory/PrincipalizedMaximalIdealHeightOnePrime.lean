module

public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Defs
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import Mathlib.RingTheory.Ideal.Height
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-!
# A height-one prime above a principalized local maximal ideal

Source: Stacks Project, Algebra, Tag 00P8, lemma-dominate-by-dimension-1,
the minimal prime over the extended principal maximal ideal in the proof.
(blueprint: lem-sfb-principalized-maximal-ideal-height-one-prime).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace IsLocalRing

/-- If the maximal ideal of a local domain extends to a proper principal ideal
with a nonzero generator in a Noetherian overdomain, there is a height-one
minimal prime over that principal ideal contracting to the original maximal ideal.
The injective ring map `f` represents the inclusion of domains.

Source: Stacks Project, Algebra, Tag 00P8, lemma-dominate-by-dimension-1,
proof, choosing the minimal prime over `x_r S`; also Tags 00E0 and 00KV(1).
(blueprint: lem-sfb-principalized-maximal-ideal-height-one-prime).

Proof:
1. Since the principal ideal generated by `f a` is proper, choose a minimal
   prime `q` over it using `lem-weil-pbc-minimal-prime-over-proper-ideal`,
   namely `Ideal.nonempty_minimalPrimes` (Tag 00E0).
2. The contraction of `q` to `B` is proper and contains the maximal ideal,
   since its extension is the principal ideal contained in `q`. Maximality
   therefore makes the contraction equal to the maximal ideal of `B`.
3. By `lem-sfb-krull-principal-ideal-height-bound`, namely
   `Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes` (Tag 00KV(1)),
   the height of `q` is at most one, since `S` is Noetherian.
4. Injectivity preserves the nonzero element `a`, and `f a` belongs to `q`.
   Thus `q` is nonzero. In the domain `S` the zero ideal is prime, so
   `(0) < q` is a strict prime chain of length one. The height of `q` is
   at least one and hence exactly one. Together with steps 1 and 2 this
   gives all three required properties.
-/
theorem exists_height_one_minimalPrime_of_principalized_maximalIdeal
    {B : Type u} {S : Type v} [CommRing B] [IsDomain B] [IsLocalRing B]
    [CommRing S] [IsDomain S] [IsNoetherianRing S]
    (f : B →+* S) (hf : Function.Injective f)
    (a : B) (ha : a ≠ 0) (ha_mem : a ∈ IsLocalRing.maximalIdeal B)
    (hprincipal : Ideal.map f (IsLocalRing.maximalIdeal B) = Ideal.span {f a})
    (hproper : Ideal.span {f a} ≠ (⊤ : Ideal S)) :
    ∃ q ∈ (Ideal.span {f a}).minimalPrimes,
      Ideal.comap f q = IsLocalRing.maximalIdeal B ∧ q.height = 1 := by
  sorry

end IsLocalRing
