module

public import Sheaf.RingTheory.GlobalDimension
public import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.Algebra.Module.ULift
import Sheaf.RingTheory.WellOrderedUnionProjectiveDimension
import Sheaf.RingTheory.CyclicGlobalDimension

/-!
# Testing global dimension on finite and cyclic modules

Source: Stacks Project, Algebra, Lemma 065T
(blueprint: lem-weil-pbc-global-dimension-finite-modules-suffice).
-/

@[expose] public section

universe u v

namespace Ring

/-- Global dimension at most `n` can be tested on finite modules or on cyclic quotients.
Here rings are commutative with identity, including the zero ring (Stacks, Algebra, 00AQ).
The lift of `R ⧸ I` only puts the quotient in the universe of the test modules.
Source: Stacks Project, Algebra, Lemma 065T
(blueprint: lem-weil-pbc-global-dimension-finite-modules-suffice).

Proof:
1. A uniform resolution bound applies to finite modules. Each quotient `R/I` is generated by
   the class of `1`, so the finite-module bound applies to every cyclic quotient
   (`def-weil-pbc-finite-global-dimension`, `def-weil-finitely-generated-module`).
2. Conversely, well-order a generating set `E` of an arbitrary module `M`, using
   `lem-weil-pbc-well-ordering-theorem`. Let `M_e` be the span of the generators at most `e`.
   These submodules are increasing and exhaust `M`: a finite linear combination belongs
   to the submodule indexed by its largest generator.
3. The quotient of `M_e` by the union of its predecessors is generated by the class of `e`.
   The surjective linear map from `R` sending `r` to `r` times that class identifies this
   quotient with `R/I`, where `I` is its kernel. This includes the zero quotient, with `I = R`.
   Transport the bounded projective resolution of `R/I` along this linear isomorphism.
4. Apply `lem-weil-pbc-well-ordered-union-projective-dimension` to this filtration.
   It gives a resolution of `M` of length at most `n`. Since `M` was arbitrary, this is
   `HasGlobalDimensionLE R n`. Together with step 1 this proves both equivalences. -/
theorem hasGlobalDimensionLE_iff_finite_iff_cyclic (R : Type u) [CommRing R] (n : ℕ) :
    (HasGlobalDimensionLE.{u, max u v} R n ↔
      ∀ M : ModuleCat.{max u v} R, Module.Finite R M →
        ModuleCat.HasProjectiveResolutionLE M n) ∧
    ((∀ M : ModuleCat.{max u v} R, Module.Finite R M →
        ModuleCat.HasProjectiveResolutionLE M n) ↔
      ∀ I : Ideal R,
        ModuleCat.HasProjectiveResolutionLE (ModuleCat.of R (ULift.{v} (R ⧸ I))) n) := by
  let P : Prop := ∀ M : ModuleCat.{max u v} R, Module.Finite R M →
    ModuleCat.HasProjectiveResolutionLE M n
  let C : Prop := ∀ I : Ideal R,
    ModuleCat.HasProjectiveResolutionLE (ModuleCat.of R (ULift.{v} (R ⧸ I))) n
  have hGC : C → HasGlobalDimensionLE.{u, max u v} R n :=
    hasGlobalDimensionLE_of_cyclic R n
  have hGF : HasGlobalDimensionLE.{u, max u v} R n → P := by
    intro h M hM
    exact h M
  have hFC : P → C := by
    intro h I
    apply h
    infer_instance
  have hCF : C → P := fun h => hGF (hGC h)
  exact ⟨⟨hGF, fun h => hGC (hFC h)⟩, ⟨hFC, hCF⟩⟩

end Ring
