module

public import Sheaf.RingTheory.KoszulConormalComparison
import Sheaf.RingTheory.KoszulConormalTopHomologyPos
import Sheaf.RingTheory.KoszulConormalTopHomologyZero

/-!
# Top cohomology of a normalized conormal comparison

Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext, top cohomology calculation.
(blueprint: lem-sc-koszul-conormal-top-homology).
-/

@[expose] public section

universe u

open CategoryTheory

namespace ExteriorAlgebra

/- The standard top wedge identifies the degree-r dual term with A, and the incoming
   image is the ideal generated by f (zero when r = 0). The conormal basis and determinant
   normalization identify the induced map with multiplication by the unit sign
   (-1)^(r*(r-1)/2), hence it is an isomorphism. -/
theorem koszul_conormal_comparison_isIso_top_homology
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hf : Ideal.span (Set.range f) = I)
    (b : Module.Basis (Fin r) (A ⧸ I) I.Cotangent)
    (hb : ∀ i, b i = koszulConormalVector A I r f hf (Finsupp.single i 1))
    (φ : koszulDualComplex A r f ⟶
      (HomologicalComplex.single (ModuleCat A) (ComplexShape.up ℕ) r).obj
        (koszulNormalDeterminant A I r))
    (hφ : IsKoszulConormalComparison A I r f hf φ) :
    IsIso (HomologicalComplex.homologyMap φ r) := by
  by_cases hr : r = 0
  · subst r
    exact koszul_conormal_comparison_isIso_top_homology_zero A I f hf b hb φ hφ
  · exact koszul_conormal_comparison_isIso_top_homology_pos A I r f
      (Nat.pos_of_ne_zero hr) hf b hb φ hφ

end ExteriorAlgebra
