/-!
# Finite coefficient presentations of Artinian local algebras

Source: Stacks Project, Tag 07FG, the coefficient-field claim and its presentation argument
(blueprint: lem-weil-pbc-artinian-coefficient-presentation).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace Algebra

/-- The subalgebra generated by a fixed finite family of elements and the image of the
field generated by a finite coefficient set. This is an explicit construction, even when
its later structural properties have not yet been proved.

Source: Stacks Project, Tag 07FG, the images of `F[x_1,...,x_d]`
(blueprint: def-weil-pbc-artinian-coefficient-subalgebra). -/
noncomputable def artinianCoefficientSubalgebra
    (k : Type u) [Field k] (Λ : Type v) [CommRing Λ] [Algebra k Λ]
    [IsLocalRing Λ]
    (σ : IsLocalRing.ResidueField Λ →+* Λ) (t : Finset Λ)
    (s : Finset (IsLocalRing.ResidueField Λ)) : Subalgebra k Λ :=
  Algebra.adjoin k ((t : Set Λ) ∪
    σ '' (IntermediateField.adjoin k (s : Set (IsLocalRing.ResidueField Λ)) :
      Set (IsLocalRing.ResidueField Λ)))

private theorem complete_of_nilpotent {R : Type*} [CommRing R]
    (I : Ideal R) (hI : IsNilpotent I) : IsAdicComplete I R := by
  obtain ⟨N, hN⟩ := hI
  refine { haus' := fun x hx ↦ ?_, prec' := fun f hf ↦ ⟨f N, fun m ↦ ?_⟩ }
  · simpa [hN, SModEq.bot] using hx N
  · by_cases hm : m ≤ N
    · exact hf hm
    · have hNm : N ≤ m := by omega
      have heq : f N = f m := by simpa [hN, SModEq.bot] using hf hNm
      rw [heq]

private theorem adjoin_eq_top_of_residue_section
    (k : Type u) [Field k] (Λ : Type v) [CommRing Λ] [Algebra k Λ]
    [IsLocalRing Λ] (σ : IsLocalRing.ResidueField Λ →+* Λ)
    (hσ : (IsLocalRing.residue Λ).comp σ = RingHom.id _)
    (t : Finset Λ) (ht : Ideal.span (t : Set Λ) = IsLocalRing.maximalIdeal Λ)
    (hnil : IsNilpotent (IsLocalRing.maximalIdeal Λ)) :
    Algebra.adjoin k ((t : Set Λ) ∪ Set.range σ) = ⊤ := by
  let S := Algebra.adjoin k ((t : Set Λ) ∪ Set.range σ)
  let f : S →+* Λ := S.toSubring.subtype
  let m := IsLocalRing.maximalIdeal Λ
  let J := m.comap f
  have hmap : J.map f = m := by
    apply le_antisymm
    · exact Ideal.map_le_iff_le_comap.mpr le_rfl
    · change IsLocalRing.maximalIdeal Λ ≤ _
      rw [← ht]
      apply Ideal.span_le.mpr
      intro x hx
      have hxS : x ∈ S := Algebra.subset_adjoin (Or.inl hx)
      have hxm : x ∈ m := by
        change x ∈ IsLocalRing.maximalIdeal Λ
        rw [← ht]
        exact Ideal.subset_span hx
      exact Ideal.mem_map_of_mem f (show (⟨x, hxS⟩ : S) ∈ J from hxm)
  have hJ : IsNilpotent J := by
    obtain ⟨N, hN⟩ := hnil
    refine ⟨N, eq_bot_iff.mpr ?_⟩
    intro x hx
    have hx' := Ideal.le_comap_pow f N hx
    have hz : f x = 0 := by simpa [m, hN] using hx'
    exact Subtype.val_injective (by simpa [f] using hz)
  let : IsAdicComplete J S := complete_of_nilpotent J hJ
  let : IsAdicComplete (J.map f) Λ := hmap ▸ complete_of_nilpotent m hnil
  have hsurj : Function.Surjective ((Ideal.Quotient.mk (J.map f)).comp f) := by
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hσS : σ (IsLocalRing.residue Λ a) ∈ S :=
      Algebra.subset_adjoin (Or.inr ⟨_, rfl⟩)
    refine ⟨⟨σ (IsLocalRing.residue Λ a), hσS⟩, ?_⟩
    change Ideal.Quotient.mk (J.map f) (σ (IsLocalRing.residue Λ a)) =
      Ideal.Quotient.mk (J.map f) a
    rw [hmap]
    change IsLocalRing.residue Λ (σ (IsLocalRing.residue Λ a)) =
      IsLocalRing.residue Λ a
    exact RingHom.congr_fun hσ _
  have hf : Function.Surjective f := surjective_of_mk_map_comp_surjective f hsurj
  apply top_unique
  intro x _
  obtain ⟨y, rfl⟩ := hf x
  exact y.property

/-- A coefficient-field section and finitely many coefficients capture the structure map.
The section need not be a `k`-algebra map. The last clause is the surjectivity of the
polynomial evaluation with all residue-field coefficients, expressed as algebra generation.

Source: Stacks Project, Tag 07FG, proof of the claim and the paragraph beginning
"Choose sigma and F as in the claim" (steps 1--8 of the parent node)
(blueprint: lem-weil-pbc-artinian-coefficient-presentation).

Proof:
1. The Artinian local ring is Noetherian and its maximal ideal is nilpotent. Choose a finite
   generating set t for that ideal. In positive characteristic the residue field has a ring
   section by formal smoothness over the prime field (Tag 0320).
2. Induct on the nilpotence exponent n to adjust this section so that the image of k lies
   in the ring generated by t and a subfield finitely generated over k. For n=1 the ring is
   its residue field and the section is the inverse of the residue map; no coefficients
   beyond k are needed.
3. For n>1 pass to the quotient by I=m^(n-1). Here I^2=mI=0. Apply induction, then lift the
   resulting section and the map from k into the truncated polynomial algebra along their
   nilpotent kernels, using Tag 0320 as in the field lifting node.
4. The discrepancy between the lifted map and the structure map is a derivation k -> I.
   Changing the section by a derivation K -> I subtracts its restriction to k from that
   discrepancy. Positive degree monomials do not contribute, because mI=0.
5. Exactness of the Jacobi--Zariski sequence at K tensor Omega_k, and finite dimensionality
   of H1(K/k), put its kernel in the span of finitely many members of a differential basis
   dy_j. The remaining images are independent in Omega_K. Extend them to a basis and choose
   a linear map Omega_K -> I agreeing with the discrepancy on them. Its derivation adjusts
   the section so that the remaining discrepancy has only finitely many values f_j.
6. Write each f_j as a linear combination over K of degree n-1 monomials in t. Adjoin their
   finitely many coefficients to the field supplied by induction. Both the lifted map and
   the discrepancy now take values in the resulting polynomial image, so their sum, the
   structure map, does too. A finite generating set c for this subfield gives the closure
   clause below. This uses ring closure rather than k-algebra generation, so the clause does
   not become automatic merely because the structure map is part of an algebra structure.
7. Finally Lambda = sigma(K)+m. Repeated substitution of the generators of m gives
   Lambda = image(K[t])+m^r for each r. At r=n the remainder vanishes. Thus t and sigma(K)
   generate Lambda, which is the final algebra-generation clause. -/
theorem exists_artinian_coefficient_presentation
    (k : Type u) [Field k] (Λ : Type v) [CommRing Λ] [Algebra k Λ]
    [IsArtinianRing Λ] [IsLocalRing Λ] (p : ℕ) [CharP k p] (hp : 0 < p)
    (hH : Module.Finite (IsLocalRing.ResidueField Λ)
      (H1Cotangent k (IsLocalRing.ResidueField Λ))) :
    ∃ (σ : IsLocalRing.ResidueField Λ →+* Λ) (t : Finset Λ)
      (c : Finset (IsLocalRing.ResidueField Λ)),
      (IsLocalRing.residue Λ).comp σ = RingHom.id _ ∧
      Ideal.span (t : Set Λ) = IsLocalRing.maximalIdeal Λ ∧
      (∀ a : k, algebraMap k Λ a ∈ Subring.closure ((t : Set Λ) ∪
        σ '' (IntermediateField.adjoin k (c : Set (IsLocalRing.ResidueField Λ)) :
          Set (IsLocalRing.ResidueField Λ)))) ∧
      Algebra.adjoin k ((t : Set Λ) ∪ Set.range σ) = ⊤ := by
  classical
  obtain ⟨t, ht⟩ := (IsNoetherian.noetherian (IsLocalRing.maximalIdeal Λ))
  have hnil := (isArtinianRing_iff_isNilpotent_maximalIdeal Λ).mp
    (inferInstance : IsArtinianRing Λ)
  obtain ⟨σ, c, hσ, hc⟩ :=
    exists_nilpotent_coefficient_adjustment k Λ t ht hnil p hp hH
  exact ⟨σ, t, c, hσ, ht, hc, adjoin_eq_top_of_residue_section k Λ σ hσ t ht hnil⟩

end Algebra
