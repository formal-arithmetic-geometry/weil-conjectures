/-!
# Conormal generators and global complete intersections

Source: Stacks Project, Algebra, Lemma 00SC (lemma-lci), implication (3) => (1)
(blueprint: lem-weil-pbc-lci-conormal-generators-global-complete-intersection).
-/

@[expose] public section

universe u

namespace Algebra

/-- (blueprint: lem-weil-pbc-lci-conormal-generators-global-complete-intersection)
Stacks Project, Algebra, Lemma 00SC, implication (3) ⇒ (1). The conormal module at a
prime generated by the codimension number of elements yields a principal localization
which is a global complete intersection.

Proof:
1. Pull `q` back to a prime `q'` of the polynomial ring. By
   `lem-weil-pbc-polynomial-quotient-dimension-at-point-height-difference`, the local
   dimension is `d = n - height(q') + height(q)`, with `0 ≤ d ≤ n`. Put `c = n - d`.
2. Represent the `c` conormal generators as fractions of classes of elements `f'_j ∈ I`.
   Multiplying each generator by its unit denominator preserves generation. Let
   `J = (f'_1, ..., f'_c) ⊆ I`.
3. In `R = P_{q'}`, put `M = IR` and `N = JR`. The polynomial ring is Noetherian by
   `lem-weil-pbc-polynomial-ring-field-regular-ring`, so `M` is finitely generated.
   Conormal generation gives `M = N + I²R`; since `I ⊆ q'`, this gives
   `M = N + (q'R)M`. Apply `lem-weil-pbc-nakayama-local-generators` to obtain `M = N`.
4. Clear denominators in expressions for finitely many generators of `I` in `JR`.
   Their product gives `g' ∉ q'` with `g'I ⊆ J`, and hence `I_{g'} = J_{g'}`.
5. By `def-kun-topological-dimension-at-point`, choose an open neighbourhood of `q`
   of dimension `d`. By `lem-weil-pbc-spec-localization-away-basic-open`, choose a
   principal neighbourhood inside it and lift its defining element to `g'' ∉ q'`.
   Let `g` be the image of `g'g''` in `S`; primality gives `g ∉ q`.
6. The dimension of `D(g)` is at least `d` by the definition of local dimension and
   at most `d` by `lem-weil-pbc-open-subspace-dimension-monotone`. The homeomorphism
   of `Spec S_g` with `D(g)` gives `dim S_g = d = n - c`.
7. The surjection `P/J → S` induces an isomorphism `(P/J)_r ≅ S_g`, where `r` is
   the class of `g'g''`: injectivity follows from `g'I ⊆ J`. By
   `lem-weil-pbc-localization-away-polynomial-quotient`, adjoining an inverse of `r`
   presents this ring as `k[x₁, ..., xₙ, xₙ₊₁]/(f'_1, ..., f'_c, xₙ₊₁g'g'' - 1)`.
8. This presentation has `n + 1` variables and `c + 1` equations, and its dimension
   is `(n + 1) - (c + 1)`. Apply `def-weil-pbc-complete-intersection-over-field` to
   conclude, with the element `g ∉ q` chosen in step 5. -/
theorem conormal_generators_global_complete_intersection
    (k : Type u) [Field k] (n : ℕ)
    (I : Ideal (MvPolynomial (Fin n) k))
    (q : Ideal (MvPolynomial (Fin n) k ⧸ I)) [q.IsPrime] :
    ∃ d : ℕ,
      topologicalKrullDimAt (⟨q, inferInstance⟩ : PrimeSpectrum (MvPolynomial (Fin n) k ⧸ I)) =
          (d : WithBot ℕ∞) ∧ d ≤ n ∧
        ((∃ gens : Fin (n - d) →
              LocalizedModule q.primeCompl (Ideal.Cotangent I),
            Submodule.span (R := Localization.AtPrime q) (Set.range gens) = ⊤) →
          ∃ g : (MvPolynomial (Fin n) k ⧸ I), g ∉ q ∧
            IsGlobalCompleteIntersection k (Localization.Away g)) := by
  sorry

end Algebra
