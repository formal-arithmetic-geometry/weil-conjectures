module

public import Sheaf.RingTheory.FormallySmoothAdic
import Sheaf.RingTheory.SquareZeroSmallModel

@[expose] public section

universe u v z

namespace Algebra

/-- Universe-polymorphic form of adic formal smoothness, needed when a lifting target
has a larger universe than the one occurring in the source definition.
Source: the lifting definition of Stacks Project, More on Algebra, Tag 07EB
(blueprint: lem-weil-pbc-fs-adic-universe-lift).

Proof (size reduction, written by J2 from the lifting definition):
Let q : D → D/J be the quotient map. Choose for each s : S a representative
b(s) : D of g(s), using the surjectivity of q. Let A be the R-subalgebra of D
generated by these representatives, and let K be the inverse image of J in A.
Products of two elements of K vanish in D by J² = 0, and hence in A because
A → D is injective. Thus K² = 0. The induced R-algebra map j : A/K → D/J
is injective: its kernel is zero by the definition of K. Its image contains
every g(s), since b(s) belongs to A. Consequently g factors uniquely as
j ∘ g₀ for an R-algebra map g₀ : S → A/K. If g kills n^k then g₀ does too,
by injectivity of j, with the same positive exponent k.

The evaluation map from the polynomial algebra R[X_s | s ∈ S] onto A is
surjective: its image is exactly the subalgebra generated by the b(s).
This polynomial algebra lives in Type (max u v), so its quotient by the
kernel supplies a model A₀ : Type (max u v) R-algebra isomorphic to A.
Transport K and g₀ across this isomorphism and its quotient isomorphism.
Apply h to this lifting problem in A₀; its square-zero and power-vanishing
conditions were checked above. Composing the resulting lift S → A₀ with
A₀ ≃ A and A → D gives f. In D/J its composite equals j ∘ g₀ = g,
which is the asserted quotient equation. Only representatives are chosen
in this proof; no data definition is made from an unproved existence theorem. -/
theorem formallySmoothAdic_lift_universe
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    (n : Ideal S) (h : FormallySmoothAdic R S n)
    (D : Type z) [CommRing D] [Algebra R D] (J : Ideal D) (hJ : J ^ 2 = ⊥)
    (g : S →ₐ[R] D ⧸ J)
    (hg : ∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, g x = 0) :
    ∃ f : S →ₐ[R] D, (Ideal.Quotient.mkₐ R J).comp f = g := by
  obtain ⟨D₀, instRing, instAlg, e, K, q, g₀, hK, hq, hqe, hqg⟩ :=
    exists_squareZero_small_model R S D J hJ g
  let := instRing
  let := instAlg
  obtain ⟨k, hk, hgk⟩ := hg
  have hg₀ : ∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, g₀ x = 0 := by
    refine ⟨k, hk, fun x hx ↦ hq ?_⟩
    have hxg : q (g₀ x) = g x := DFunLike.congr_fun hqg x
    rw [hxg, hgk x hx, map_zero]
  obtain ⟨f₀, hf₀⟩ := h K hK g₀ hg₀
  refine ⟨e.comp f₀, ?_⟩
  calc
    (Ideal.Quotient.mkₐ R J).comp (e.comp f₀) =
        ((Ideal.Quotient.mkₐ R J).comp e).comp f₀ := (AlgHom.comp_assoc _ _ _).symm
    _ = (q.comp (Ideal.Quotient.mkₐ R K)).comp f₀ := by rw [hqe]
    _ = q.comp ((Ideal.Quotient.mkₐ R K).comp f₀) := AlgHom.comp_assoc _ _ _
    _ = q.comp g₀ := by rw [hf₀]
    _ = g := hqg

end Algebra
