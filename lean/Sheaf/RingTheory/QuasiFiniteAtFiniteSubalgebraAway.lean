import Sheaf.RingTheory.QuasiFiniteAtPrime
import Mathlib.RingTheory.Localization.Away.Basic

/-!
# A finite subalgebra agreeing near a quasi-finite prime

Source: Stacks Project, Algebra, Theorem Tag 00Q9 and the finite-subalgebra construction
in the proof of Lemma Tag 00QA, also used in Lemma Tag 00QB (3).
(blueprint: lem-weil-pbc-quasi-finite-at-finite-subalgebra-away)
-/

universe u v

namespace Algebra

/-- At a quasi-finite prime of a finite-type algebra, a finite subalgebra has the same
localization away from some element outside the prime.
Source: Stacks Project, Algebra, Tags 00Q9, 00QA and 00QB (3).
(blueprint: lem-weil-pbc-quasi-finite-at-finite-subalgebra-away)

Proof:
1. Apply `lem-weil-pbc-integral-closure-zariski-main-away` (00Q9) to the integral
   closure `C` of `R` in `S`. It gives `g ∈ C` outside `q` and a bijective map `C_g → S_g`.
2. Choose finitely many algebra generators `sᵢ` of `S`. Surjectivity gives numerators
   `yᵢ ∈ C` and exponents `nᵢ` with `yᵢ/g^nᵢ = sᵢ/1` in `S_g`. Equality of fractions
   means `g^kᵢ * (yᵢ - g^nᵢ * sᵢ) = 0` for some `kᵢ`.
3. Let `S'` be the subalgebra generated by `g` and the `yᵢ`. These generators are integral
   over `R`, since they lie in `C`; the same monic equations hold in `S'`. Thus
   `lem-weil-pbc-finite-of-integral-generators` makes `S'` a finite `R`-module.
4. The localized inclusion is injective: if a numerator `y ∈ S'` vanishes in `S_g`,
   some `g^k * y` is zero in `S`, hence also in the subring `S'`, so its fraction is zero.
5. The image contains `1/g` and each `sᵢ/1 = yᵢ/g^nᵢ`. Since every `s ∈ S` is a
   polynomial in the `sᵢ` over `R`, every fraction `s/g^n` lies in the image. This proves
   surjectivity and hence the claimed isomorphism of the canonical ring map.

The fraction calculations use `def-weil-ring-localization-away` and its ring specialization
of `def-weil-pbc-module-localization-away`; finiteness is `def-weil-finitely-generated-module`.
-/
theorem exists_finite_subalgebra_away_of_isQuasiFiniteAtPrime
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.FiniteType R S] (q : PrimeSpectrum S) (hq : IsQuasiFiniteAtPrime R S q) :
    ∃ S' : Subalgebra R S, Module.Finite R S' ∧
      ∃ g : S', g.1 ∉ q.asIdeal ∧
        Function.Bijective (Localization.awayMap S'.val.toRingHom g) := by
  sorry

end Algebra
