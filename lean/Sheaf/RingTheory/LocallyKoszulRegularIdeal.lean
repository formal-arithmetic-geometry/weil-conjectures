module

public import Mathlib.RingTheory.Localization.Away.Basic
public import WeilConjectures.RingTheory.KoszulRegularSequence

/-!
# Ideals locally generated by Koszul-regular sequences

Source: Stacks Project, More on Algebra, Tag 07CV, Definition `definition-regular-ideal`,
clause (2) (blueprint: def-sfb-locally-koszul-regular-ideal).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Ideal

/-- An ideal is locally Koszul-regular if, at each prime containing it, some principal
neighbourhood admits a finite Koszul-regular generating sequence for its extension.
Source: Stacks Project, More on Algebra, Tag 07CV, clause (2)
(blueprint: def-sfb-locally-koszul-regular-ideal).
The empty sequence is permitted; the unit ideal satisfies the condition vacuously. -/
def IsLocallyKoszulRegular {T : Type u} [CommRing T] (L : Ideal T) : Prop :=
  ∀ p : Ideal T, p.IsPrime → L ≤ p →
    ∃ u : T, u ∉ p ∧ ∃ (r : ℕ) (a : Fin r → Localization.Away u),
      L.map (algebraMap T (Localization.Away u)) = Ideal.span (Set.range a) ∧
        RingTheory.Sequence.IsKoszulRegular a

end Ideal
