import Sheaf.AlgebraicGeometry.FineFanBlowup
import Mathlib.Algebra.MonoidAlgebra.MapDomain
import Mathlib.Algebra.MonoidAlgebra.Support
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import Mathlib.Algebra.Group.Torsion
import Mathlib.LinearAlgebra.FreeModule.PID
import Sheaf.TraceFormula.RationalConeDualFinite

/-!
# Support of an integral group-algebra element

Source: ILO, Travaux de Gabber, Exposé VIII, Lemma 3.2.9, printed p. 104;
the monomial-basis normalization argument (blueprint: lem-trf-integral-support-saturation).

We use multiplicative notation for the abelian group and its submonoid, as in
`AlgebraicGeometry.FineFan.saturation`: the additive multiple `n • g` is written `g ^ n`.
The canonical map on monoid algebras identifies `k[P]` with its image in `k[G]`.
-/

set_option autoImplicit false

universe u v

namespace MonoidAlgebra

/-- An element integral over a finitely generated monoid algebra has every exponent of its
support in the saturation of the monoid inside the ambient torsion-free abelian group.
Source: ILO, Travaux de Gabber, Exposé VIII, Lemma 3.2.9 and the monomial-basis
normalization argument, printed p. 104 (blueprint: lem-trf-integral-support-saturation).

Proof plan:
1. Suppose an exponent `g` in the support lies outside the saturation. Inside the ambient
   group take the subgroup generated by monoid generators, the support of `x`, and the
   supports of all coefficients in a chosen monic integral equation. It is finitely generated
   and torsion free. By `lem-trf-fg-torsionfree-group-free`
   (`Module.basisOfFiniteTypeTorsionFree'` over the integers), choose a finite integer basis.
2. In its rational vector space form the cone generated by the monoid generators. If `g`
   belonged to the cone, clearing positive denominators would put a positive power of `g`
   in `P`. Thus `g` lies outside the cone. By `lem-trf-rational-cone-dual-finite`, a rational
   linear form is nonnegative on the cone and negative on `g`. Clear its denominators on
   the finite basis to obtain an integer weight on this subgroup.
3. Every coefficient monomial in the integral equation has nonnegative weight, whereas
   `x` has a support exponent of negative weight. Apply
   `lem-trf-integral-support-weighted-initial-degree`: the negative lowest-weight component
   of the highest power in the monic equation cannot cancel with any of its other terms.
   This contradicts integrality, so every exponent belongs to the saturation.
-/
theorem support_subset_saturation_of_isIntegral
    {k : Type u} [Field k] {G : Type v} [CommGroup G] [IsMulTorsionFree G]
    (P : Submonoid G) (hP : P.FG) (x : MonoidAlgebra k G)
    (hx : (MonoidAlgebra.mapDomainRingHom k P.subtype).IsIntegralElem x) :
    ∀ g ∈ x.coeff.support, g ∈ AlgebraicGeometry.FineFan.saturation P := by
  sorry

end MonoidAlgebra
