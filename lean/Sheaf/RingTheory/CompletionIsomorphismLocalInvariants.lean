module

public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.LocalRing.RingHom.Basic
import Mathlib.RingTheory.AdicCompletion.LocalRing
import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.RingTheory.LocalRing.Module

/-!
# Local invariants of an isomorphism of completions

Source: Stacks Project, Tag 0CAV, `lemma-isomorphism-approximation`, first proof paragraph;
algebraic sublemma using Tags 05GI, 05GG and 00DV.
(blueprint: lem-trf-completion-isomorphism-local-invariants)
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace RingHom

/-- An isomorphism on maximal-ideal completions induced by a local map identifies the
extended maximal ideals, all their positive powers, and the actual finite quotient maps.
It also identifies the residue fields and makes the target maximal ideal generated by the
source maximal ideal. The hypothesis `hcoord` specifies the coordinatewise map on compatible
sequences: each coordinate of `h x` is obtained by applying the quotient map induced by `φ`
to that coordinate of `x`. It determines `h` uniquely, including its composite with the
canonical maps from the original rings.

Source: Stacks Project, Tag 0CAV, `lemma-isomorphism-approximation`, first proof paragraph,
with the algebraic subargument from Tags 05GI, 05GG and 00DV.
(blueprint: lem-trf-completion-isomorphism-local-invariants)

Proof:
1. By `lem-weil-pbc-local-completion-local-ring`, both completions are local, with maximal
   ideals the extensions of the original maximal ideals. An isomorphism and its inverse
   preserve units and hence nonunits, so `h` carries these ideals onto each other. Expanding
   ideal products gives the same assertion for every positive power.
2. Noetherianity makes the maximal ideals finitely generated. Apply
   `lem-weil-pbc-adic-completion-mod-power`: each completion projection is surjective, its
   composite with the original completion map is the quotient map, and its kernel is the
   extension of the corresponding power. Extension commutes with powers by expanding products.
3. The isomorphism `h` therefore descends to an isomorphism between the quotients by these
   kernels. Identify these quotients with the original finite quotients. On `[a]` the induced
   map sends `[a]` to `[φ a]`, by `hcoord`, so this is the actual `Ideal.quotientMap`. The same
   coordinate formula proves compatibility with the completion projections. Degree one is
   the residue-field assertion.
4. Put `J = (maximalIdeal A).map φ`, which is contained in `maximalIdeal B` by locality.
   Surjectivity modulo the square lifts every element of the target maximal ideal modulo
   its square to an element of `A`; locality forces the lift into the source maximal ideal.
   Thus `maximalIdeal B = J + (maximalIdeal B)^2`. Noetherianity makes this ideal a finite
   module. Apply `lem-weil-pbc-nakayama-local-generators` in its submodule form to obtain
   `J = maximalIdeal B`.
-/
theorem completion_isomorphism_local_invariants
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    (φ : A →+* B) [IsLocalHom φ]
    (h : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
      AdicCompletion (IsLocalRing.maximalIdeal B) B)
    (hcoord : ∀ (n : ℕ) (x : AdicCompletion (IsLocalRing.maximalIdeal A) A) (a : A),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x =
          Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A) ^ n) a →
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n (h x) =
          Ideal.Quotient.mk ((IsLocalRing.maximalIdeal B) ^ n) (φ a))
    (hiso : Function.Bijective h) :
    ((IsLocalRing.maximalIdeal A).map
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))).map h =
      (IsLocalRing.maximalIdeal B).map
        (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)) ∧
    (∀ n : ℕ, 1 ≤ n →
      (((IsLocalRing.maximalIdeal A).map
          (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) ^ n).map h =
        ((IsLocalRing.maximalIdeal B).map
          (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B))) ^ n) ∧
    (∀ n : ℕ, 1 ≤ n →
      Function.Bijective
        (Ideal.quotientMap ((IsLocalRing.maximalIdeal B) ^ n) φ
          ((pow_le_pow_left' (IsLocalRing.maximalIdeal_comap φ).symm.le n).trans
            (Ideal.le_comap_pow φ n))) ∧
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n).toRingHom.comp h =
        (Ideal.quotientMap ((IsLocalRing.maximalIdeal B) ^ n) φ
          ((pow_le_pow_left' (IsLocalRing.maximalIdeal_comap φ).symm.le n).trans
            (Ideal.le_comap_pow φ n))).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom) ∧
    Function.Bijective
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B) φ
        (IsLocalRing.maximalIdeal_comap φ).symm.le) ∧
    (IsLocalRing.maximalIdeal A).map φ = IsLocalRing.maximalIdeal B := by
  sorry

end RingHom
