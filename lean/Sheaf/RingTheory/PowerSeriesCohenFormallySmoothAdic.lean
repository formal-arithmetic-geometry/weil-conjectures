/-!
# Adic formal smoothness of power series over fields and Cohen rings

Source: Stacks Project, More on Algebra, Lemma Tag 07NL, parts (1) and (3)
(blueprint: lem-weil-pbc-power-series-cohen-formally-smooth-adic).
-/

@[expose] public section

universe u

namespace MvPowerSeries

-- Every module is complete for a nilpotent ideal: Cauchy sequences stabilize.
private theorem complete_of_nilpotent {T M : Type*} [CommRing T]
    [AddCommGroup M] [Module T M]
    (a : Ideal T) (ha : IsNilpotent a) : IsAdicComplete a M := by
  obtain ⟨N, hN⟩ := ha
  refine { haus' := fun x hx ↦ ?_, prec' := fun f hf ↦ ⟨f N, fun m ↦ ?_⟩ }
  · simpa [hN, Submodule.bot_smul, SModEq.bot] using hx N
  · by_cases hm : m ≤ N
    · exact hf hm
    · have hNm : N ≤ m := by omega
      have heq : f N = f m := by
        simpa [hN, Submodule.bot_smul, SModEq.bot] using hf hNm
      rw [heq]

-- Finite generation turns membership in the nilradical into ideal nilpotence.
private theorem nilpotent_span {T ι : Type*} [CommRing T] [Finite ι]
    (t : ι → T) (ht : ∀ i, IsNilpotent (t i)) :
    IsNilpotent (Ideal.span (Set.range t)) := by
  apply (Ideal.FG.isNilpotent_iff_le_nilradical
    (Submodule.fg_span (Set.finite_range t))).2
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact mem_nilradical.mpr (ht i)

-- Once the coefficients lift, nilpotent variable images suffice for the extension.
private theorem lift_powerSeries {Λ D : Type*} [CommRing Λ] [CommRing D]
    (n : ℕ) (J : Ideal D) (g : MvPowerSeries (Fin n) Λ →+* D ⧸ J)
    (h : Λ →+* D) (hh : (Ideal.Quotient.mk J).comp h = g.comp C)
    (hX : ∀ i : Fin n, IsNilpotent (g (X i))) (hJ : J ^ 2 = ⊥) :
    ∃ f : MvPowerSeries (Fin n) Λ →+* D, (Ideal.Quotient.mk J).comp f = g := by
  classical
  choose d hd using fun i : Fin n ↦ Ideal.Quotient.mk_surjective (g (X i))
  have hdn (i : Fin n) : IsNilpotent (d i) := by
    obtain ⟨k, hk⟩ := hX i
    have hdk : d i ^ k ∈ J := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_pow, hd, hk]
    refine ⟨k * 2, ?_⟩
    have hm := Ideal.pow_mem_pow hdk 2
    rw [hJ] at hm
    simpa only [Ideal.mem_bot, pow_mul] using hm
  let a : Ideal D := Ideal.span (Set.range d)
  have : IsAdicComplete a D := complete_of_nilpotent a (nilpotent_span d hdn)
  obtain ⟨f, hfC, hfX, _, _⟩ := exists_ringHom_of_isAdicComplete a h n d
    (fun i ↦ Ideal.subset_span ⟨i, rfl⟩)
  let b : Ideal (D ⧸ J) := Ideal.span (Set.range (fun i : Fin n ↦ g (X i)))
  have : IsAdicComplete b (D ⧸ J) := complete_of_nilpotent b (nilpotent_span _ hX)
  obtain ⟨φ, _, _, _, huniq⟩ := exists_ringHom_of_isAdicComplete b
    (g.comp C) n (fun i ↦ g (X i)) (fun i ↦ Ideal.subset_span ⟨i, rfl⟩)
  refine ⟨f, ?_⟩
  apply (huniq _ ?_ ?_).trans (huniq g (fun _ ↦ rfl) (fun _ ↦ rfl)).symm
  · intro r
    change Ideal.Quotient.mk J (f (C r)) = g (C r)
    rw [hfC]
    exact RingHom.congr_fun hh r
  · intro i
    change Ideal.Quotient.mk J (f (X i)) = g (X i)
    rw [hfX, hd]

/-- Power series over a characteristic-zero field are adically formally smooth over `ℚ`.
Source: Stacks Project, More on Algebra, Lemma Tag 07NL (1).
(blueprint: lem-weil-pbc-power-series-cohen-formally-smooth-adic)

Proof: Given a square-zero ideal `J` in a test `ℚ`-algebra `D` and a map `g` killing
`m ^ k`, choose lifts `dᵢ` of its variable images. Each `dᵢ ^ k` lies in `J`, so
`dᵢ ^ (2 * k) = 0`. The ideal generated by the finitely many `dᵢ` is nilpotent:
a product of `(n + 1) * (2 * k - 1) + 1` generators repeats one at least `2 * k` times.
Thus `D` and `D/J` are complete for this ideal and its image
(def-weil-pbc-adically-complete-ring). Lift the coefficient map `K → D/J` to `K → D`
by lem-weil-pbc-char-zero-field-extension-formally-smooth (Stacks Tag 0322).
The existence part of lem-weil-pbc-power-series-universal-property-complete extends
this coefficient map with the variable images `dᵢ`. Its uniqueness part in `D/J`
identifies the composite with `g`. The lift is a `ℚ`-algebra map because a ring map
from `ℚ` is unique. This is precisely def-weil-pbc-formally-smooth-adic. -/
theorem formallySmoothAdic_rat (K : Type u) [Field K] [CharZero K] (n : ℕ) :
    Algebra.FormallySmoothAdic ℚ (MvPowerSeries (Fin n) K)
      (Ideal.span (Set.range (fun i : Fin n ↦ (X i : MvPowerSeries (Fin n) K)))) := by
  classical
  intro D _ _ J hJ g hg
  obtain ⟨k, _, hgk⟩ := hg
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis ℚ K
  have : Algebra.IsAlgebraic
      (IntermediateField.adjoin ℚ (Set.range ((↑) : s → K))) K := hs.isAlgebraic_field
  have : Algebra.FormallySmooth ℚ K :=
    Algebra.FormallySmooth.of_algebraicIndependent_of_isSeparable hs.1
  let gK : K →ₐ[ℚ] D ⧸ J :=
    { toRingHom := g.toRingHom.comp C
      commutes' := fun q ↦ RingHom.map_rat_algebraMap _ q }
  obtain ⟨h, hh⟩ := Algebra.FormallySmooth.exists_lift J ⟨2, hJ⟩ gK
  have hX (i : Fin n) : IsNilpotent (g (X i)) := by
    refine ⟨k, ?_⟩
    rw [← map_pow]
    exact hgk _ (Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) k)
  obtain ⟨f, hf⟩ := lift_powerSeries n J g.toRingHom h.toRingHom
    (congrArg AlgHom.toRingHom hh) hX hJ
  let fₐ : MvPowerSeries (Fin n) K →ₐ[ℚ] D :=
    { toRingHom := f
      commutes' := fun q ↦ RingHom.map_rat_algebraMap _ q }
  refine ⟨fₐ, ?_⟩
  ext F
  exact RingHom.congr_fun hf F

/-- Power series over a Cohen ring of residue characteristic `p` are adically formally
smooth over `ℤ` for the ideal generated by `p` and the variables.
Source: Stacks Project, More on Algebra, Lemma Tag 07NL (3).
(blueprint: lem-weil-pbc-power-series-cohen-formally-smooth-adic)

Proof: Given `D`, `J`, `g` and `k` as in def-weil-pbc-formally-smooth-adic, choose
lifts `dᵢ` of the variables and put `d₀ = p`. As `g` kills `m ^ k`, each of these
elements has its `k`-th power in `J` and its `2 * k`-th power zero. Their finitely
generated ideal is nilpotent by the same pigeonhole bound as in the field case.
Consequently `D` and `D/J` are complete for it and its image. The coefficient map
kills `p ^ (2 * k)` and factors through `Λ / (p ^ (2 * k))`. Apply
lem-weil-pbc-cohen-ring-mod-pn-formally-smooth (Stacks Tag 0329), using
`p ^ (2 * k) = 0` in `D`, to lift this coefficient map to `Λ → D`.
Extend it with the images `dᵢ` by lem-weil-pbc-power-series-universal-property-complete.
Uniqueness in `D/J` identifies the composite with `g`. Every ring map is a
`ℤ`-algebra map, giving the required lift and hence adic formal smoothness. -/
theorem formallySmoothAdic_int_of_isCohenRing (p : ℕ) (Λ : Type u) [CommRing Λ]
    (hΛ : IsCohenRing p Λ) (n : ℕ) :
    Algebra.FormallySmoothAdic ℤ (MvPowerSeries (Fin n) Λ)
      (Ideal.span (insert (C (p : Λ))
        (Set.range (fun i : Fin n ↦ (X i : MvPowerSeries (Fin n) Λ))))) := by
  classical
  intro D _ _ J hJ g hg
  obtain ⟨k, hk, hgk⟩ := hg
  have hpq : (p : D ⧸ J) ^ k = 0 := by
    have hc : C (p : Λ) ∈ Ideal.span (insert (C (p : Λ))
        (Set.range (fun i : Fin n ↦ (X i : MvPowerSeries (Fin n) Λ)))) :=
      Ideal.subset_span (Set.mem_insert _ _)
    have h := hgk _ (Ideal.pow_mem_pow hc k)
    simpa only [map_pow, map_natCast] using h
  have hpk : (p : D) ^ k ∈ J := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    simpa only [map_pow, map_natCast] using hpq
  have hpD : (p : D) ^ (k * 2) = 0 := by
    have hm := Ideal.pow_mem_pow hpk 2
    rw [hJ] at hm
    simpa only [Ideal.mem_bot, pow_mul] using hm
  let I : Ideal Λ := Ideal.span {(p : Λ) ^ (k * 2)}
  have hkill : ∀ x ∈ I, (g.toRingHom.comp C) x = 0 := by
    change I ≤ RingHom.ker (g.toRingHom.comp C)
    apply Ideal.span_le.mpr
    rintro x (rfl : x = (p : Λ) ^ (k * 2))
    change g (C ((p : Λ) ^ (k * 2))) = 0
    simp only [map_pow, map_natCast, pow_mul, hpq, zero_pow (by decide : 2 ≠ 0)]
  let gΛ : Λ ⧸ I →+* D ⧸ J := Ideal.Quotient.lift I (g.toRingHom.comp C) hkill
  obtain ⟨h, hh⟩ := (IsDiscreteValuationRing.cohenRing_mod_pow_formallySmooth
    p Λ hΛ (k * 2) (by omega)).2 D hpD J hJ gΛ
  have hhΛ : (Ideal.Quotient.mk J).comp (h.comp (Ideal.Quotient.mk I)) =
      g.toRingHom.comp C := by
    rw [← RingHom.comp_assoc, hh]
    exact Ideal.Quotient.lift_comp_mk I _ hkill
  have hX (i : Fin n) : IsNilpotent (g (X i)) := by
    refine ⟨k, ?_⟩
    rw [← map_pow]
    exact hgk _ (Ideal.pow_mem_pow
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_range_self i))) k)
  obtain ⟨f, hf⟩ := lift_powerSeries n J g.toRingHom
    (h.comp (Ideal.Quotient.mk I)) hhΛ hX hJ
  let fₐ : MvPowerSeries (Fin n) Λ →ₐ[ℤ] D :=
    { toRingHom := f
      commutes' := by intro z; simp }
  refine ⟨fₐ, ?_⟩
  ext F
  exact RingHom.congr_fun hf F

end MvPowerSeries
