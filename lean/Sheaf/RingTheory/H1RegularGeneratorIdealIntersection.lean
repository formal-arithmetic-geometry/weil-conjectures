module

public import WeilConjectures.RingTheory.KoszulRegularSequence
import WeilConjectures.AlgebraicGeometry.KoszulComplex
import Sheaf.Paper.KoszulDifferentialSquareZero
import Mathlib.LinearAlgebra.ExteriorPower.Basis

/-!
# Intersection with an ideal generated by an H₁-regular sequence modulo an ideal

Source: Stacks Project, More on Algebra, Tag 0665 (lemma-H1-regular-in-quotient),
full statement, lines 7471–7477 (blueprint: lem-sfb-h1-regular-generator-ideal-intersection).
-/

@[expose] public section

universe u

namespace Ideal

/-- If the images of a finite sequence are H₁-regular modulo `I`, its generated ideal
intersects `I` in the product ideal. Source: Stacks Project, More on Algebra, Tag 0665
(lemma-H1-regular-in-quotient), full statement, lines 7471–7477.

Proof: Reduce the degree-zero, one and two terms of the Koszul complex modulo `I`.
The exterior-power bases and the Koszul formulas identify the differentials with
`d₁(eᵢ) = gᵢ` and `d₂(eᵢ ∧ eⱼ) = gᵢeⱼ - gⱼeᵢ`; coefficient lifting gives surjective
maps in these degrees and identifies the degree-one kernel with coefficient vectors
in `I`. For an element of `I ∩ (g)`, choose a degree-one presentation; its reduction
is a cycle. H₁-regularity makes it a degree-two boundary, which can be lifted and
subtracted. The resulting coefficients lie in `I`, and the square-zero Koszul
identity preserves the element, proving the inclusion into `I * (g)`. Conversely,
every product of an element of `I` and an element of `(g)` lies in both ideals.
The empty sequence, singleton sequence, unit ideal, zero ideal, and zero ring are
included by the same formulas. (blueprint: lem-sfb-h1-regular-generator-ideal-intersection)
-/
theorem inf_span_eq_mul_of_h1_regular_quotient {A : Type u} [CommRing A]
    (I : Ideal A) {r : ℕ} (g : Fin r → A)
    (hreg : RingTheory.Sequence.IsH1Regular (R := A ⧸ I)
      (fun i : Fin r ↦ Ideal.Quotient.mk I (g i))) :
    I ⊓ Ideal.span (Set.range g) = I * Ideal.span (Set.range g) := by
  sorry

end Ideal
