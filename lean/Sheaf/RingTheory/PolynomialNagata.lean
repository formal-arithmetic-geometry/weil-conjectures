module

public import Sheaf.RingTheory.NagataRing
public import Mathlib.Algebra.Polynomial.Basic
import Sheaf.RingTheory.MonogenicNagataDomainN2
import Sheaf.RingTheory.FiniteOverNagata

/-!
# Polynomial rings over Nagata rings

Source: Stacks Project, Algebra, Proposition Tag 0334, Steps 2--4
(blueprint: lem-weil-pbc-polynomial-nagata).
-/

@[expose] public section

universe u

/-- A polynomial ring in one variable over a Nagata ring is Nagata.

Source: Stacks Project, Algebra, Proposition Tag 0334, Steps 2--4
(blueprint: lem-weil-pbc-polynomial-nagata).

Proof: The polynomial ring is Noetherian by the Hilbert basis theorem. For each prime
`q` of `R[X]`, contract it to a prime `p` of `R`. The domain `R/p` is Nagata because
it is finite over `R`. The quotient `R[X]/q` is a domain generated by the image of `X`
over `R/p`, and the induced map from `R/p` is injective. If this generator is
transcendental over the fraction field of `R/p`, this domain is a polynomial ring,
which is N-2 by Tag 032O. Otherwise its fraction field is a finite extension. For a
finite extension `M` of this field, take the integral closure `A'` of `R/p` in `M`.
It is finite over `R/p`, normal, Nagata, and has fraction field `M`. The algebra
`A'[x]` is finite over `R[X]/q`, and its integral closure in `M` equals the integral
closure of `R[X]/q` by transitivity of integrality. Tag 0334's claim (***) makes
`A'[x]` N-1. The tower law for finite modules therefore makes this integral closure
finite over `R[X]/q`. Thus every prime quotient is N-2, proving the assertion. -/
theorem isNagataRing_polynomial (R : Type u) [CommRing R]
    (hR : IsNagataRing R) : IsNagataRing (Polynomial R) := by
  let : IsNoetherianRing R := hR.1
  refine ⟨inferInstance, ?_⟩
  intro q hq
  let p : Ideal R := q.comap (algebraMap R (Polynomial R))
  have hp : p.IsPrime := Ideal.IsPrime.comap (algebraMap R (Polynomial R))
  let : p.IsPrime := hp
  have hA : IsNagataRing (R ⧸ p) :=
    (finite_over_nagata_is_nagata R R hR).2 p
  let x : Polynomial R ⧸ q := Ideal.Quotient.mk q Polynomial.X
  apply isN2_of_monogenic_nagata_domain (R ⧸ p) (Polynomial R ⧸ q) hA
    Ideal.algebraMap_quotient_injective x
  apply eq_top_iff.mpr
  intro b hb
  clear hb
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective b
  induction f using Polynomial.induction_on' with
  | add f g hf hg =>
      exact (Algebra.adjoin (R ⧸ p) ({x} : Set (Polynomial R ⧸ q))).add_mem hf hg
  | monomial n r =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
      apply Subalgebra.mul_mem
      · exact (Algebra.adjoin (R ⧸ p) ({x} : Set (Polynomial R ⧸ q))).algebraMap_mem
          (Ideal.Quotient.mk p r)
      · exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton x)) n

