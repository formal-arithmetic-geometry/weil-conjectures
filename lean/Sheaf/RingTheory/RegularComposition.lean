module

public import Sheaf.RingTheory.GRing
import Sheaf.RingTheory.GeometricallyRegularFieldExtension
import Sheaf.RingTheory.RegularBaseChange
import Sheaf.RingTheory.RegularLocalOfFlatWithRegularClosedFiber

/-!
# Composition of regular ring maps

Source: Stacks Project, More on Algebra, Lemma 07QI (blueprint:
lem-weil-pbc-regular-composition).
-/

@[expose] public section

universe u v w

namespace RingHom

/-- The composite of regular ring maps is regular when its fibres over the source
are Noetherian. Source: Stacks Project, More on Algebra, Lemma 07QI
(blueprint: lem-weil-pbc-regular-composition).

Proof:
1. Fix a prime `p` of `A` and a finite purely inseparable extension `k` of its residue
   field. Localize `A → B` at `p`: flatness follows from
   `lem-weil-pbc-flat-module-base-change`, and its fibres are the original fibres, so
   the localized map is regular by `def-weil-pbc-g-ring`. Apply
   `lem-weil-pbc-regular-base-change` first to the residue-field quotient and then to
   the finite extension. Thus `B ⊗[A] k` is Noetherian and regular. The hypothesis
   makes `C ⊗[A] κ(p)` Noetherian, and `lem-weil-pbc-finite-type-algebra-noetherian`
   makes `C ⊗[A] k` Noetherian.
2. The map `B ⊗[A] k → C ⊗[A] k` is flat by
   `lem-weil-pbc-flat-module-base-change`. At a prime `q'` over a prime `q` of `B`,
   its fibre is the original fibre at `q`, extended from `κ(q)` to `κ(q')`.
   This field extension is finitely generated by
   `lem-weil-pbc-finite-type-residue-field-extension-finitely-generated`.
   Apply `lem-weil-pbc-geometrically-regular-finitely-generated-extensions` also
   to finite purely inseparable extensions of `κ(q')`: the new fibre is Noetherian
   and geometrically regular. Its Noetherianity also follows from its description
   as a localization of a quotient of `C ⊗[A] k`, using
   `def-weil-pbc-localization-at-prime` and `lem-weil-pbc-surjective-image-noetherian`.
3. At each prime of `C ⊗[A] k`, the induced local map is flat, its source is
   regular local, and its closed fibre is regular. Apply
   `lem-weil-pbc-flat-over-regular-with-regular-fibre` (Algebra, Tag 031E).
   Since `C ⊗[A] k` is Noetherian, regularity of all these local rings gives its
   regularity (`def-weil-regular-scheme`). This proves geometric regularity of every
   composite fibre. Compose flatness by `lem-weil-pbc-flat-ring-map-comp` and use
   `def-weil-pbc-g-ring` to conclude. -/
theorem IsRegular.comp_of_fiber_noetherian
    {A : Type u} {B : Type v} {C : Type w}
    [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C]
    (hf : (algebraMap A B).IsRegular) (hg : (algebraMap B C).IsRegular)
    (h : ∀ (p : Ideal A) [p.IsPrime], IsNoetherianRing (p.Fiber C)) :
    (algebraMap A C).IsRegular := by
  sorry

end RingHom
