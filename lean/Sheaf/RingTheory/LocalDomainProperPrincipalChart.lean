module

public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Valuation.LocalSubring
import Mathlib.RingTheory.Valuation.ValuationRing
import Mathlib.RingTheory.FiniteType

/-! # A proper principal fraction chart of a local domain

Source: Stacks Project, Tag 00P8, proof of `algebra-lemma-dominate-by-dimension-1`,
through the construction of the ring S and the properness of its principal extended ideal
(blueprint: lem-sfb-local-domain-proper-principal-chart).
-/

@[expose] public section

universe u v

namespace IsLocalRing

/-- A nonfield Noetherian local domain has a finite fraction chart in which its extended
maximal ideal is proper and generated by one of the original maximal-ideal generators.
Source: Stacks Project, Tag 00P8, proof through the construction of S and properness of x_r S
(blueprint: lem-sfb-local-domain-proper-principal-chart).

Proof:
1. By `def-weil-pbc-noetherian-ring`, choose finitely many generators of the maximal ideal.
   Delete the zero generators. Since the ideal is nonzero, the remaining family is nonempty.
2. By `lemma-nagata-local-domain-valuation-dominates` (Stacks Tag 00IA), choose a valuation
   subring V of K dominating B. Each chosen generator then belongs to the maximal ideal of V.
3. By the fraction-field condition of `def-trf-valuation-ring`, among the finitely many
   generators choose a nonzero a = x_j dividing all others in V: start with the first
   generator; at each step keep a if x_i/a is in V, and otherwise replace a by x_i.
   In the latter case a/x_i is in V and multiplying earlier quotients preserves membership.
4. Put S = B[x_i/a]. All quotients are in V, hence S is contained in V. Each x_i equals
   a times x_i/a in S, giving m_B S contained in aS; a in m_B gives the reverse inclusion.
5. Since a lies in the maximal ideal of V, and S is contained in V, 1 cannot belong to aS.
6. Evaluation from the polynomial ring B[T_1,...,T_r] onto S is surjective, and identifies
   S with its quotient by the kernel. Thus `lem-weil-pbc-finite-type-algebra-noetherian`
   (Stacks Tag 00FN) gives that S is Noetherian.
-/
theorem exists_properPrincipalFractionChart
    (B : Type u) [CommRing B] [IsNoetherianRing B] [IsLocalRing B] [IsDomain B]
    (K : Type v) [Field K] [Algebra B K] [IsFractionRing B K]
    (hm : maximalIdeal B ≠ ⊥) :
    ∃ (r : ℕ) (x : Fin r → B) (j : Fin r) (S : Subalgebra B K),
      0 < r ∧
      (∀ i : Fin r, x i ≠ 0 ∧ x i ∈ maximalIdeal B) ∧
      Ideal.span (Set.range x) = maximalIdeal B ∧
      S = Algebra.adjoin B (Set.range (fun i : Fin r ↦
        algebraMap B K (x i) / algebraMap B K (x j))) ∧
      IsNoetherianRing S ∧
      Ideal.map (algebraMap B S) (maximalIdeal B) =
        Ideal.span {algebraMap B S (x j)} ∧
      Ideal.span {algebraMap B S (x j)} ≠ ⊤ := by
  sorry

end IsLocalRing
