import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.KrullDimension.Basic

/-!
# A principal maximal ideal in dimension one gives regularity

Source: literature/stacks-project/algebra.tex, Algebra, Lemma Tag 00PD
(condition (4) implies the regular-local assertion in condition (3))
(blueprint: lem-weil-pbc-principal-maximal-dim-one-regular)
-/

universe u

namespace Ring

/-- A one-dimensional Noetherian local domain whose maximal ideal is principal is
regular local (Stacks, Tag 00PD).

Proof: By hypothesis the maximal ideal is generated by one element and the
Krull dimension is one, so the maximal ideal can be generated by `dim A`
elements. This is exactly the definition of `IsRegularLocalRing`.
(blueprint: lem-weil-pbc-principal-maximal-dim-one-regular) -/
theorem isRegularLocalRing_of_principal_maximalIdeal
    (A : Type u) [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsNoetherianRing A] (hdim : ringKrullDim A = 1)
    {π : A} (hπ : π ≠ 0)
    (hmax : IsLocalRing.maximalIdeal A = Ideal.span ({π} : Set A)) :
    IsRegularLocalRing A := by
  sorry

end Ring
