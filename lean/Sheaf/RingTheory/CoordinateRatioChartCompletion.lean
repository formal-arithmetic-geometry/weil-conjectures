module

public import Mathlib.RingTheory.MvPowerSeries.Trunc
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import WeilConjectures.Blowup.Affine.ChartAlgebra
import Mathlib.RingTheory.AdicCompletion.Completeness
import WeilConjectures.RingTheory.PowerSeriesAdicEvaluation
import Sheaf.AlgebraicGeometry.BlowupChartPresentationPowerTorsion

/-! # Completion of a coordinate-ratio chart

Source: Stacks Project, Algebra, Tag 0G8S, lemma-affine-blowup-quotient-description,
coordinate specialization and completion; Tag 0317, definition-complete. The explicit
completion comparison is the agent-written finite-truncation consequence in the DAG.
(blueprint: lem-trf-coordinate-ratio-chart-completion).

The helpers below name the rings, coordinates and ideal of this single statement.
The original and primed series rings use the same labelled `Fin n` index type.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace MvPowerSeries

variable (L : Type u) [Field L] {n : ℕ}

/-- The ratio chart inside the localization at `X h`. Fractions of elements of the
variable ideal are generated by `1` and the ratios `X j / X h` for `j ∈ J`, `j ≠ h`.
Source: Stacks Tag 0G8S, coordinate specialization
(blueprint: lem-trf-coordinate-ratio-chart-completion). -/
noncomputable abbrev CoordinateRatioChart (J : Set (Fin n)) (h : Fin n) : Type u :=
  AlgebraicGeometry.AffineBlowup.chartRing
    (Ideal.span ((X : Fin n → MvPowerSeries (Fin n) L) '' J)) (X h)

/-- A ratio as an element of the actual chart subalgebra, not an abstract generator.
Source: Stacks Tag 0G8S, coordinate specialization
(blueprint: lem-trf-coordinate-ratio-chart-completion). -/
noncomputable def coordinateRatioChartRatio (J : Set (Fin n)) (h : Fin n) (j : J) :
    CoordinateRatioChart L J h :=
  ⟨AlgebraicGeometry.AffineBlowup.chartFraction (X h) 1 (X (R := L) j.val),
    AlgebraicGeometry.AffineBlowup.chartFraction_mem_chartRing _
      ((pow_one (Ideal.span ((X : Fin n → MvPowerSeries (Fin n) L) '' J))).symm ▸
        Ideal.subset_span (Set.mem_image_of_mem X j.property))⟩

/-- The centered chart coordinates: `e`, the unaffected variables, and `r_j - ξ_j`.
Source: Stacks Tag 0G8S, completion at the specified rational exceptional point
(blueprint: lem-trf-coordinate-ratio-chart-completion). -/
noncomputable def coordinateRatioChartParameter (J : Set (Fin n)) (h : Fin n)
    (ξ : {j : Fin n // j ∈ J ∧ j ≠ h} → L) (i : Fin n) :
    CoordinateRatioChart L J h := by
  classical
  exact if hi : i ∈ J ∧ i ≠ h then
    coordinateRatioChartRatio L J h ⟨i, hi.1⟩ -
      algebraMap (MvPowerSeries (Fin n) L) _ (C (ξ ⟨i, hi⟩))
  else algebraMap (MvPowerSeries (Fin n) L) _ (X i)

/-- The ideal of the chosen rational point of the exceptional divisor.
Source: Stacks Tag 0G8S, completion at the specified rational exceptional point
(blueprint: lem-trf-coordinate-ratio-chart-completion). -/
noncomputable def coordinateRatioChartIdeal (J : Set (Fin n)) (h : Fin n)
    (ξ : {j : Fin n // j ∈ J ∧ j ≠ h} → L) : Ideal (CoordinateRatioChart L J h) :=
  Ideal.span (Set.range (coordinateRatioChartParameter L J h ξ))

/-- The images of the original variables under continuous chart substitution.
Source: Stacks Tag 0G8S, coordinate specialization and elimination of the chart relations
(blueprint: lem-trf-coordinate-ratio-chart-completion). -/
noncomputable def coordinateRatioChartSubstitution (J : Set (Fin n)) (h : Fin n)
    (ξ : {j : Fin n // j ∈ J ∧ j ≠ h} → L) (i : Fin n) :
    MvPowerSeries (Fin n) L := by
  classical
  exact if hi : i ∈ J ∧ i ≠ h then X h * (C (ξ ⟨i, hi⟩) + X i) else X i

/-- Completion at any rational exceptional point gives the primed formal coordinates.
The truncation congruences specify the continuous substitution on every original
formal series, while the ratio formula specifies its extension to the chart.

Source: Stacks Tag 0G8S, lemma-affine-blowup-quotient-description, followed by completion
and elimination of `X_j - e(ξ_j + X'_j)`; Tag 0317, definition-complete. Compare
Bierstone--Milman (1997), section 7.2, pp. 267--268.
(blueprint: lem-trf-coordinate-ratio-chart-completion).

Proof (the node's seven-step finite-truncation argument):
1. Put `a = (X_i)` and `q = (X'_i)`. In each series ring, the m-th variable ideal
   power consists of series without terms of degree below m. Group each monomial
   by a degree-m divisor to prove the converse. Thus truncation computes reduction
   modulo these powers. The chart relations give `a C ⊆ n`.
2. By lem-weil-pbc-power-series-variables-complete the target is q-adically complete.
   Apply lem-weil-pbc-power-series-adic-evaluation to the displayed substitution:
   each substituted variable lies in q, including nonzero values of ξ. This gives
   the continuous map on all series and its finite-truncation congruences.
3. Apply lem-trf-blowup-chart-presentation-power-torsion. The substitution respects
   the polynomial chart relations. Multiplication by `X'_h` is injective by shifting
   coefficients, so it kills the whole power-torsion kernel and descends to C.
   Each centered coordinate maps to its primed variable, hence n^m maps into q^m.
4. Evaluate the degree-below-m truncation of a primed series at the centered chart
   coordinates modulo n^m. The Cauchy product formula makes this a ring map, killing
   q^m. These maps and those from step 3 commute with all quotient transitions.
5. The composites are identities: on the primed side use truncation; on C use
   truncation of the original series and `e(ξ_j + (r_j - ξ_j)) = X_j`. The omitted
   tail lies in a^m C ⊆ n^m. The composites also fix every ratio, which generates C.
6. At m = 1 this identifies C/n with B/q = L via constant coefficients. The residue
   identification fixes L, proving that n is maximal for arbitrary ξ.
7. Apply def-weil-pbc-adic-completion coordinatewise to the compatible inverse
   quotient maps and use completeness of B. The resulting isomorphism agrees with
   the chart substitution on C. The centered generators map to all primed variables,
   so the extended ideal maps to q. Both maps preserve all ideal powers and hence
   are continuous. The empty ratio list for J = {h}, full center, and n = 1 all work.
-/
theorem exists_coordinateRatioChartCompletion (J : Set (Fin n)) (h : Fin n) (hh : h ∈ J)
    (ξ : {j : Fin n // j ∈ J ∧ j ≠ h} → L) :
    (coordinateRatioChartIdeal L J h ξ).IsMaximal ∧
    (∃ ρ : (CoordinateRatioChart L J h ⧸ coordinateRatioChartIdeal L J h ξ) ≃+* L,
      ∀ c : L, ρ (Ideal.Quotient.mk _
        (algebraMap (MvPowerSeries (Fin n) L) (CoordinateRatioChart L J h) (C c))) = c) ∧
    ∃ (φ : CoordinateRatioChart L J h →+* MvPowerSeries (Fin n) L)
      (E : AdicCompletion (coordinateRatioChartIdeal L J h ξ) (CoordinateRatioChart L J h)
        ≃+* MvPowerSeries (Fin n) L),
      (∀ c : L, φ (algebraMap (MvPowerSeries (Fin n) L) _ (C c)) = C c) ∧
      (∀ i : Fin n, φ (algebraMap (MvPowerSeries (Fin n) L) _ (X i)) =
        coordinateRatioChartSubstitution L J h ξ i) ∧
      (∀ j : {j : Fin n // j ∈ J ∧ j ≠ h},
        φ (coordinateRatioChartRatio L J h ⟨j.val, j.property.1⟩) = C (ξ j) + X j.val) ∧
      (∀ (F : MvPowerSeries (Fin n) L) (m : ℕ),
        φ (algebraMap (MvPowerSeries (Fin n) L) _ F) -
          MvPolynomial.eval₂ C (coordinateRatioChartSubstitution L J h ξ) (F.truncTotal m)
            ∈ (Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) L))) ^ m) ∧
      (∀ c : CoordinateRatioChart L J h,
        E (AdicCompletion.of (coordinateRatioChartIdeal L J h ξ) _ c) = φ c) ∧
      Ideal.map E.toRingHom
        ((coordinateRatioChartIdeal L J h ξ).map
          (algebraMap (CoordinateRatioChart L J h)
            (AdicCompletion (coordinateRatioChartIdeal L J h ξ) (CoordinateRatioChart L J h))))
        = Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) L)) := by
  sorry

end MvPowerSeries
