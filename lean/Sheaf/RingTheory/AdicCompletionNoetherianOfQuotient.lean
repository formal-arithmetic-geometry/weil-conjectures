module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.RingTheory.AdicCompletion.Completeness
import Sheaf.RingTheory.AssociatedGradedFiniteType
import Sheaf.RingTheory.CompleteIdealFiniteOfAssociatedGraded

/-!
# Noetherian completion from a Noetherian quotient

Source: Stacks Project, Commutative Algebra, Lemma 10.97.5 (Tag 05GH)
(blueprint: lem-weil-pbc-completion-noetherian-quotient-noetherian).
-/

@[expose] public section

universe u

namespace AdicCompletion

/-- If `R ⧸ I` is Noetherian and `I` is finitely generated, the `I`-adic completion is
Noetherian and complete for the ideal generated by the image of `I`.
Source: Stacks Project, Commutative Algebra, Lemma 10.97.5 (Tag 05GH)
(blueprint: lem-weil-pbc-completion-noetherian-quotient-noetherian).

Proof:
1. Put `A = AdicCompletion I R` and `J = I.map (algebraMap R A)`. The images of finitely
   many generators of `I` generate `J`. By `lem-weil-pbc-adic-completion-mod-ideal` (05GG),
   `A` is `J`-adically complete and `A ⧸ J` is isomorphic to `R ⧸ I`. Thus `A ⧸ J` is
   Noetherian by `lem-weil-pbc-surjective-image-noetherian`. This proves completeness and
   reduces Noetherianity to a complete ring with a finitely generated ideal and
   Noetherian quotient, using `def-weil-pbc-adic-completion`,
   `def-weil-pbc-adically-complete-ring`, and `def-weil-pbc-noetherian-ring`.
2. The generators of `J` in degree one induce a surjection from a polynomial ring over
   `A ⧸ J` onto the associated graded ring. Products of generators span every power of
   `J`, proving surjectivity degree by degree. The graded ring is Noetherian by
   `lem-weil-pbc-finite-type-algebra-noetherian`, using
   `def-weil-pbc-associated-graded-ring` and `def-weil-pbc-mv-polynomial-ring`.
3. For an ideal `K` of `A`, the images of `K ∩ Jⁿ` in `Jⁿ / Jⁿ⁺¹` form a homogeneous ideal
   of the graded ring. Noetherianity gives finitely many homogeneous generators, of
   degrees `dⱼ`, with lifts `hⱼ ∈ K ∩ Jᵈⱼ`, using the associated graded ring and
   Noetherian ring definitions just cited.
4. For `x ∈ K ∩ Jⁿ`, express its initial form in these generators and compare degree `n`.
   Lift the coefficients to `aⱼ ∈ J^(n-dⱼ)`, taking zero when `dⱼ > n`. Then
   `x - ∑ aⱼ hⱼ ∈ K ∩ Jⁿ⁺¹`, by the associated graded ring definition.
5. Starting from `x ∈ K`, iterate this approximation to obtain coefficients `aⱼ,ₙ` and
   remainders `xₙ₊₁ ∈ K ∩ Jⁿ⁺¹`, with `x = ∑ₙ₌₀ᴺ ∑ⱼ aⱼ,ₙ hⱼ + xₙ₊₁`.
6. The partial sums of each coefficient are Cauchy, since `aⱼ,ₙ ∈ J^(n-dⱼ)` once
   `n ≥ dⱼ`. Completeness gives limits `Aⱼ`. For every positive `k`, sufficiently late
   partial sums agree with their limits modulo `Jᵏ`, and the remainder lies in `Jᵏ`.
   Hence `x - ∑ Aⱼ hⱼ` belongs to every `Jᵏ`; separatedness makes it zero. Thus the `hⱼ`
   generate `K`. Every ideal is finitely generated, so `A` is Noetherian, using
   `def-weil-pbc-adic-completion`, `def-weil-pbc-adically-complete-ring`, and
   `def-weil-pbc-noetherian-ring`. -/
theorem isNoetherianRing_and_isAdicComplete_of_quotient {R : Type u} [CommRing R]
    (I : Ideal R) [IsNoetherianRing (R ⧸ I)] (hI : I.FG) :
    IsNoetherianRing (AdicCompletion I R) ∧
      IsAdicComplete (I.map (algebraMap R (AdicCompletion I R))) (AdicCompletion I R) := by
  let A := AdicCompletion I R
  let J := I.map (algebraMap R A)
  have hJ : J.FG := hI.map _
  have hcomplete : IsAdicComplete J A :=
    (IsAdicComplete.map_algebraMap_iff I A).mpr (AdicCompletion.isAdicComplete hI)
  have hquotient : IsNoetherianRing (A ⧸ J) := by
    have hker := AdicCompletion.ker_evalOneₐ_eq_map I hI
    change IsNoetherianRing (AdicCompletion I R ⧸ I.map (algebraMap R A))
    rw [← hker]
    exact isNoetherianRing_of_ringEquiv (R ⧸ I)
      ((AdicCompletion.evalOneₐ I).toRingHom.quotientKerEquivOfSurjective
        (AdicCompletion.evalOneₐ_surjective I)).symm
  have hfinite : Algebra.FiniteType (A ⧸ J) (Ideal.associatedGraded J) :=
    Ideal.associatedGraded_finiteType J hJ
  have hgraded : IsNoetherianRing (Ideal.associatedGraded J) :=
    Algebra.FiniteType.isNoetherianRing (A ⧸ J) (Ideal.associatedGraded J)
  refine ⟨(isNoetherianRing_iff_ideal_fg A).mpr ?_, hcomplete⟩
  intro K
  exact Ideal.fg_of_isAdicComplete_of_associatedGraded J K

end AdicCompletion
