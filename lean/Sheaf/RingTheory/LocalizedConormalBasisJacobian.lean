import Sheaf.RingTheory.SmoothLocalizationConormalSplit

/-!
# Localized consequences of a conormal basis

Source: Stacks Project, Tag 07EZ, proof of part (e), spanning and split differential
(blueprint: lem-weil-pbc-localized-conormal-basis-jacobian).
-/

@[expose] public section

universe u v
open scoped TensorProduct

namespace Algebra.Presentation

/-- A conormal basis gives localized ideal membership for the remaining relations and a
left inverse of the localized Jacobian. No exponent bound or strictly standard element
is asserted here.

Source: Stacks Project, Tag 07EZ, proof of part (e), the sentences beginning
"Then ... holds ... by construction" and "Moreover, since ... is a split injection"
(blueprint: lem-weil-pbc-localized-conormal-basis-jacobian).

Proof: every relation class is a linear combination of the given basis classes after
localizing. Express the coefficients as fractions of elements of `A` and lift numerators
to the polynomial ring. Equality in the localized conormal quotient says precisely that
the relation belongs to the localization of the ideal generated by the first relations
plus the square of the kernel. This ideal membership uses the lift `P.σ a`; changing the
lift has no effect on the conormal module because the kernel annihilates it. For the
Jacobian, identify the polynomial differential module with the free module on its
variables. The differential of a relation has coordinates its evaluated partial
derivatives. Smoothness splits the localized conormal injection. Compose its left
inverse with the coordinate map of the conormal basis, and write the composite as a
matrix. Applied to each coordinate basis vector this gives the asserted matrix identity.
The reasoning also applies to empty bases and to the zero localization. Transport the
split sequence from the polynomial quotient to `A` using `P.quotientEquiv`. -/
theorem localized_conormal_basis_jacobian
    {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
    {n m c : ℕ} (P : Presentation R A (Fin n) (Fin m))
    (hc : c ≤ min n m) (a : A) [Smooth R (Localization.Away a)]
    (b : Module.Basis (Fin c) (Localization.Away a)
      (Localization.Away a ⊗[A] P.toExtension.Cotangent))
    (hb : ∀ j : Fin c, b j = 1 ⊗ₜ[A]
      (Extension.Cotangent.mk (P := P.toExtension)
        ⟨P.relation (Fin.castLE (le_trans hc (min_le_right n m)) j),
          P.relation_mem_ker _⟩)) :
    (∀ j : Fin m, c ≤ j.val →
      algebraMap (MvPolynomial (Fin n) R) (Localization.Away (P.σ a)) (P.relation j) ∈
        Ideal.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away (P.σ a)))
          (Ideal.span {f | ∃ k : Fin m, k.val < c ∧ f = P.relation k} +
            (Ideal.span (Set.range P.relation)) ^ 2)) ∧
    let D : Matrix (Fin n) (Fin c) (Localization.Away a) :=
      fun i j ↦ algebraMap A (Localization.Away a)
        (MvPolynomial.aeval P.val (MvPolynomial.pderiv i
          (P.relation (Fin.castLE (le_trans hc (min_le_right n m)) j))))
    ∃ L : Matrix (Fin c) (Fin n) (Localization.Away a), L * D = 1 := by sorry

end Algebra.Presentation
