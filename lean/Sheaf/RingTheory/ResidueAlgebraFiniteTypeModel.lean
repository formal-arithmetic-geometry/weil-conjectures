module

public import Mathlib.Algebra.Field.IsField
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.LocalRing.ResidueField.Defs
public import Mathlib.RingTheory.Noetherian.Defs

import Mathlib.RingTheory.Ideal.Quotient.Basic

/-! # Reduction of a specified algebra generating family over a local ring

Source: Stacks Project, algebra.tex, Tags 00AQ, 00AR, 00F3 and 00FM;
fields.tex, Tag 09FB (blueprint: lem-trf-residue-algebra-finite-type-model).

The residue action is specified by its value on every residue class, with uniqueness.
Generation and the polynomial reduction formula refer to the original chosen family.
-/

@[expose] public section

universe u v

namespace IsLocalRing

/-- Reduction of a chosen finite algebra generating family gives a finite type algebra over
its Noetherian residue field. Source: Stacks Project, algebra.tex, Tags 00AQ, 00AR, 00F3(1),
00FM, and fields.tex, Tag 09FB
(blueprint: lem-trf-residue-algebra-finite-type-model).

Proof:
1. The maximal ideal is maximal, so its quotient is a field by
   `lem-weil-common-extension-fields-quotient-field` (`Ideal.Quotient.field`).
2. Every ideal in that field is either zero or contains a nonzero element, hence a unit,
   and is the unit ideal. These ideals are generated by the empty set or by one, respectively.
   Thus the residue field is Noetherian (`def-weil-field`, `def-weil-pbc-noetherian-ring`).
3. Define the coefficient map by sending the class of `a` to the class of `algebraMap A C a`.
   This is well defined because the image of the maximal ideal lies in its extended ideal.
   It preserves the ring operations, and surjectivity of the residue map gives uniqueness
   (`def-weil-pbc-algebra-hom-quotient`).
4. The quotient map preserves sums, products and powers. Applying it to a polynomial
   expression therefore reduces its coefficients and its specified generators. Every element
   of the quotient lifts to C, where it has a polynomial expression in the chosen family.
   Reducing this expression proves generation over the residue field and finite type
   (`def-weil-pbc-finite-type-algebra`, Tag 00F3(1)). Empty products equal one, so this includes
   the empty generating family. The quotient is allowed to be the zero ring. -/
theorem residue_algebra_finite_type_model
    (A : Type u) (C : Type v) [CommRing A] [IsLocalRing A] [CommRing C] [Algebra A C]
    (n : ℕ) (c : Fin n → C) (hc : Function.Surjective (MvPolynomial.aeval (R := A) c)) :
    IsField (ResidueField A) ∧ IsNoetherianRing (ResidueField A) ∧
      ∃ β : ResidueField A →+* C ⧸ (maximalIdeal A).map (algebraMap A C),
        (∀ a : A, β (residue A a) =
          Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A C)) (algebraMap A C a)) ∧
        (∀ γ : ResidueField A →+* C ⧸ (maximalIdeal A).map (algebraMap A C),
          (∀ a : A, γ (residue A a) =
            Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A C)) (algebraMap A C a)) →
          γ = β) ∧
        Function.Surjective (MvPolynomial.eval₂Hom β
          (fun i ↦ Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A C)) (c i))) ∧
        (∀ P : MvPolynomial (Fin n) A,
          Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A C))
              (MvPolynomial.aeval c P) =
            MvPolynomial.eval₂ β
              (fun i ↦ Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A C)) (c i))
              (MvPolynomial.map (residue A) P)) ∧
        β.FiniteType := by
  sorry

end IsLocalRing
