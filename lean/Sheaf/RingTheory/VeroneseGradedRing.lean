module

public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.Data.PNat.Basic

/-! # The Veronese subring with its regraded components

Source: Stacks Project, algebra.tex, immediately before Tag 0EGH
(blueprint: def-sfb-veronese-graded-ring).
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace GradedAlgebra

variable {k : Type v} {R : Type u} [CommRing k] [CommRing R] [Algebra k R]
  (𝒜 : ℕ → Submodule k R) [GradedRing 𝒜]

/-- The actual subring generated by the components with degree divisible by `d`.
Source: Stacks Project, algebra.tex, before Tag 0EGH
(blueprint: def-sfb-veronese-graded-ring). -/
def veroneseSubring (d : ℕ+) : Subring R :=
  Subring.closure (⋃ n : ℕ, (𝒜 (n * (d : ℕ)) : Set R))

/-- Degree `n` in the Veronese ring is original degree `n*d`, pulled back along inclusion.
Source: Stacks Project, algebra.tex, before Tag 0EGH
(blueprint: def-sfb-veronese-graded-ring). -/
def veroneseGrade (d : ℕ+) (n : ℕ) : AddSubgroup (veroneseSubring 𝒜 d) :=
  (𝒜 (n * (d : ℕ))).toAddSubgroup.comap (veroneseSubring 𝒜 d).subtype.toAddMonoidHom

/-- The regraded components respect the inherited multiplication and unit.
Source: Stacks Project, algebra.tex, before Tag 0EGH
(blueprint: def-sfb-veronese-graded-ring). -/
instance veroneseGradedMonoid (d : ℕ+) : SetLike.GradedMonoid (veroneseGrade 𝒜 d) where
  one_mem := by
    change (1 : R) ∈ 𝒜 (0 * (d : ℕ))
    simpa using SetLike.one_mem_graded 𝒜
  mul_mem := by
    intro i j a b ha hb
    change (a : R) ∈ 𝒜 (i * (d : ℕ)) at ha
    change (b : R) ∈ 𝒜 (j * (d : ℕ)) at hb
    change (a : R) * (b : R) ∈ 𝒜 ((i + j) * (d : ℕ))
    simpa only [Nat.add_mul] using SetLike.mul_mem_graded (A := 𝒜) ha hb

/-- Every element of the explicitly constructed Veronese subring has a unique finite
sum decomposition in the regraded components.
Source: Stacks Project, algebra.tex, before Tag 0EGH
(blueprint: def-sfb-veronese-graded-ring).

Proof: distinct multiples `n*d` are distinct since `d>0`, so independence follows from
that of the original direct-sum grading. The finite sums of these components form a
subring: products have degree `(n+m)*d`, and the degree-zero component contains one.
This subring contains the generators of `veroneseSubring`, and conversely every such
finite sum belongs to that closure. Thus recomposition is both injective and surjective.
Only this proof is postponed; the subring and each component above are explicit. -/
theorem veroneseGrade_isInternal (d : ℕ+) :
    DirectSum.IsInternal (veroneseGrade 𝒜 d) := by
  have hA : DirectSum.IsInternal (fun n ↦ (𝒜 n).toAddSubgroup) :=
    DirectSum.Decomposition.isInternal 𝒜
  have hind : iSupIndep (fun n ↦ (𝒜 (n * (d : ℕ))).toAddSubgroup) :=
    hA.addSubgroup_iSupIndep.comp (mul_left_injective₀ d.ne_zero)
  have hV : iSupIndep (veroneseGrade 𝒜 d) := by
    intro i
    apply AddSubgroup.disjoint_def.mpr
    intro x hx hx'
    have hle : (⨆ j ≠ i, veroneseGrade 𝒜 d j) ≤
        (⨆ j ≠ i, (𝒜 (j * (d : ℕ))).toAddSubgroup).comap
          (veroneseSubring 𝒜 d).subtype.toAddMonoidHom := by
      refine iSup_le fun j ↦ iSup_le fun hji ↦ ?_
      exact AddSubgroup.comap_mono (le_iSup_of_le j (le_iSup_of_le hji le_rfl))
    exact Subtype.ext (AddSubgroup.disjoint_def.mp (hind i) hx (hle hx'))
  refine ⟨hV.dfinsuppSumAddHom_injective, ?_⟩
  let f := DirectSum.coeRingHom (veroneseGrade 𝒜 d)
  intro x
  change ∃ a, f a = x
  have h : ∀ (r : R) (hr : r ∈ veroneseSubring 𝒜 d), ∃ a, f a = ⟨r, hr⟩ := by
    intro r hr
    induction hr using Subring.closure_induction with
    | mem r hr =>
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hr
      exact ⟨DirectSum.of _ n ⟨⟨r, Subring.subset_closure hr⟩, hn⟩,
        DirectSum.coeRingHom_of _ _ _⟩
    | zero => exact ⟨0, map_zero f⟩
    | one => exact ⟨1, map_one f⟩
    | add r s hr hs ihr ihs =>
      obtain ⟨a, ha⟩ := ihr
      obtain ⟨b, hb⟩ := ihs
      exact ⟨a + b, by rw [map_add, ha, hb]; rfl⟩
    | neg r hr ihr =>
      obtain ⟨a, ha⟩ := ihr
      exact ⟨-a, by rw [map_neg, ha]; rfl⟩
    | mul r s hr hs ihr ihs =>
      obtain ⟨a, ha⟩ := ihr
      obtain ⟨b, hb⟩ := ihs
      exact ⟨a * b, by rw [map_mul, ha, hb]; rfl⟩
  exact h x.val x.property

/-- The uniquely determined direct-sum decomposition supplies the Veronese grading.
Source: Stacks Project, algebra.tex, before Tag 0EGH
(blueprint: def-sfb-veronese-graded-ring). -/
noncomputable instance veroneseGradedRing (d : ℕ+) : GradedRing (veroneseGrade 𝒜 d) where
  __ := veroneseGradedMonoid 𝒜 d
  __ := (veroneseGrade_isInternal 𝒜 d).chooseDecomposition

end GradedAlgebra
