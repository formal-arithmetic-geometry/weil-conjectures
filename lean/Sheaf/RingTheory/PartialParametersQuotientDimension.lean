/-!
# Dimension of quotients by initial parts of a system of parameters

Source: Stacks Project, Algebra, Tag 02IE, `lemma-elements-generate-ideal-definition`;
Tag 07DU, `definition-ideal-definition`
(blueprint: lem-per-partial-parameters-quotient-dimension).
-/

@[expose] public section

universe u

namespace IsLocalRing

/-- The quotient by the first `i` members of a system of `d` parameters has dimension `d - i`.
The family is indexed starting at zero: `a j` corresponds to the paper's `a_{j+1}`.
Source: Stacks Project, Algebra, Tag 02IE; an ideal of definition is as in Tag 07DU.
(blueprint: lem-per-partial-parameters-quotient-dimension).

Proof:
1. Fix `1 ≤ i ≤ d`, set `I = (a₁, ..., aᵢ)`, `B = A/I`, and `n = m/I`.
   The quotient map is surjective with kernel `I`
   (def-weil-pbc-algebra-hom-quotient). Inverse image identifies ideals of `B` with
   ideals of `A` containing `I`, preserving prime and maximal ideals and strict inclusions.
   Since `I ⊆ m` is proper, `B` is nonzero local with maximal ideal `n`. Images of finite
   generators show that `B` is Noetherian (def-weil-pbc-noetherian-ring). Prime chains lift,
   so `e = dim B` is finite, `0 ≤ e ≤ d` (def-weil-pbc-krull-dimension-ring). In a local ring
   every prime lies in its maximal ideal, so `height m = d` and `height n = e`.
2. Apply lem-weil-pbc-noetherian-height-quotient-bound to the `i` generators of `I`
   and the prime `m`. It yields `d ≤ e + i`.
3. Let `K` in `B` be generated by the remaining `d - i` parameter images, and set `C = B/K`.
   The composite `A → C` has kernel `J = (a₁, ..., a_d)`, so `C` is isomorphic to `A/J`.
   It is nonzero since `J ⊆ m`. If a prime of `A` contains `J`, it contains its radical `m`,
   hence equals `m`. The prime correspondence therefore gives exactly one prime of `C`,
   namely `n/K`. Thus `dim C = 0` and `height (n/K) = 0`.
4. Apply lem-weil-pbc-noetherian-height-quotient-bound in `B` to the remaining `d - i`
   generators and `n`: `e ≤ 0 + (d - i)`. This also covers `i = d`, with no remaining
   generators and `K = 0`.
5. The two inequalities give `e = d - i`. If `d = 0`, the stated range of `i` is empty.
-/
theorem ringKrullDim_quotient_initial_parameters
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (d : ℕ) (hd : ringKrullDim A = (d : WithBot ℕ∞))
    (a : Fin d → A) (ha : ∀ j : Fin d, a j ∈ maximalIdeal A)
    (hrad : (Ideal.span (Set.range a)).radical = maximalIdeal A) :
    ∀ (i : ℕ), 1 ≤ i → i ≤ d →
      ringKrullDim (A ⧸ Ideal.span (a '' {j : Fin d | j.val < i})) =
        ((d - i : ℕ) : WithBot ℕ∞) := by
  sorry

end IsLocalRing
