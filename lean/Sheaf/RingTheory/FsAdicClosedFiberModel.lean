module

public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Sheaf.RingTheory.FormallySmoothAdic
import Sheaf.RingTheory.CompleteLocalQuotient
import Sheaf.RingTheory.ResidueFormallySmoothTransport
import Sheaf.RingTheory.ModelOfResidueSmooth

/-!
# A formally smooth model of the closed fibre

Source: Stacks Project, Remark 07NS, first paragraph, and Lemma 07NR.
(blueprint: lem-weil-pbc-fs-adic-closed-fiber-model)
-/

@[expose] public section

universe u v w

namespace RingHom

/-- Construct the smooth coefficient ring and its quotient map to the closed fibre.
Source: Stacks Project, Remark 07NS, first paragraph, and Lemma 07NR.
(blueprint: lem-weil-pbc-fs-adic-closed-fiber-model)

Proof:
1. Locality of φ puts J = m_A B inside m_B. The proper quotient E = B/J is
   Noetherian, local, and complete by `quotient_complete_local`, with maximal
   ideal the image of m_B. Regard E as a k-algebra, k = A/m_A.
2. The residue isomorphism k₀ = A₀/m₀ → k transports the given adic formal
   smoothness to k₀. Explicitly, restrict each test algebra along the inverse
   residue isomorphism, apply the given lifting condition, and restrict the lift
   back. The ideals and continuity bounds do not change.
3. Apply `Algebra.exists_formallySmoothAdic_lift_residue_field` over A₀ to E.
   It gives C, γ, and an A₀-algebra isomorphism σ : C/m₀C ≅ E. Set θ equal to
   σ composed with the quotient map. Surjectivity follows from the two factors;
   injectivity of σ identifies its kernel with m₀C. Algebra compatibility gives
   θγ = πφα. Transport C and the maps to its ULift in the displayed universe
   if needed; all ring, local, complete, and lifting properties transport along
   the canonical ring equivalence. For a test algebra in an enlarged universe,
   choose representatives of the quotient images of C and take the subalgebra
   generated by them and the base ring. This subalgebra is small in the original
   universe; its intersection with the test ideal is square-zero. Restrict the
   lifting problem to its quotient, shrink its carrier, apply formal smoothness,
   and compose the lift with the subalgebra inclusion. This proves the required
   universe transport. No finite-map or flatness assumption is used.
-/
theorem exists_fs_adic_closed_fiber_model
    {A₀ : Type u} {A : Type v} {B : Type w}
    [CommRing A₀] [CommRing A] [CommRing B]
    [Algebra A₀ A] [Algebra A B]
    [IsNoetherianRing A₀] [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A₀] [IsLocalRing A] [IsLocalRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal A₀) A₀]
    [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B]
    (α : A₀ →+* A) (hα : algebraMap A₀ A = α) [IsLocalHom α]
    (hres : Function.Bijective (IsLocalRing.ResidueField.map α))
    (φ : A →+* B) (hφ : algebraMap A B = φ) [IsLocalHom φ] :
    letI : Algebra (IsLocalRing.ResidueField A)
        (B ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) :=
      Ideal.Quotient.algebraQuotientOfLEComap
        (Eq.mpr (congrArg (fun f : A →+* B => IsLocalRing.maximalIdeal A ≤
          (Ideal.map φ (IsLocalRing.maximalIdeal A)).comap f) hφ)
          Ideal.le_comap_map)
    Algebra.FormallySmoothAdic (IsLocalRing.ResidueField A)
      (B ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A))
      (Ideal.map (Ideal.Quotient.mk (Ideal.map φ (IsLocalRing.maximalIdeal A)))
        (IsLocalRing.maximalIdeal B)) →
    ∃ (C : Type (max u v w)) (_ : CommRing C) (_ : IsLocalRing C)
      (_ : Algebra A₀ C),
      IsNoetherianRing C ∧
      IsAdicComplete (IsLocalRing.maximalIdeal C) C ∧
      ∃ (γ : A₀ →+* C),
        algebraMap A₀ C = γ ∧ IsLocalHom γ ∧
        Algebra.FormallySmoothAdic A₀ C (IsLocalRing.maximalIdeal C) ∧
        ∃ θ : C →+* B ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A),
          Function.Surjective θ ∧
          RingHom.ker θ = (IsLocalRing.maximalIdeal A₀).map γ ∧
          θ.comp γ =
            (Ideal.Quotient.mk (Ideal.map φ (IsLocalRing.maximalIdeal A))).comp
              (φ.comp α) := by
  intro hfs
  let E := B ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)
  let : Algebra (IsLocalRing.ResidueField A) E :=
    Ideal.Quotient.algebraQuotientOfLEComap
      (Eq.mpr (congrArg (fun f : A →+* B => IsLocalRing.maximalIdeal A ≤
        (Ideal.map φ (IsLocalRing.maximalIdeal A)).comap f) hφ)
        Ideal.le_comap_map)
  let J : Ideal B := Ideal.map φ (IsLocalRing.maximalIdeal A)
  have hJ : J ≤ IsLocalRing.maximalIdeal B := IsLocalRing.map_maximalIdeal_le φ
  have hproper : J ≠ ⊤ := ne_top_of_le_ne_top
    (IsLocalRing.maximalIdeal.isMaximal B).ne_top hJ
  let : Nontrivial E := Ideal.Quotient.nontrivial_iff.mpr hproper
  let : IsLocalRing E := IsLocalRing.of_surjective' (Ideal.Quotient.mk J)
    Ideal.Quotient.mk_surjective
  let : IsNoetherianRing E := isNoetherianRing_of_surjective B E
    (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  have hmax : IsLocalRing.maximalIdeal E =
      (IsLocalRing.maximalIdeal B).map (Ideal.Quotient.mk J) :=
    (IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective).symm
  let : IsAdicComplete (IsLocalRing.maximalIdeal E) E := by
    exact (quotient_complete_local B J hproper).2.2.2
  let : Algebra (IsLocalRing.ResidueField A₀) E :=
    ((algebraMap (IsLocalRing.ResidueField A) E).comp
      (IsLocalRing.ResidueField.map α)).toAlgebra
  let : Algebra A₀ E := ((Ideal.Quotient.mk J).comp (φ.comp α)).toAlgebra
  have : IsScalarTower A₀ (IsLocalRing.ResidueField A₀) E := by
    apply IsScalarTower.of_algebraMap_eq'
    ext a
    change (Ideal.Quotient.mk J) (φ (α a)) =
      algebraMap (IsLocalRing.ResidueField A) E
        (IsLocalRing.ResidueField.map α (IsLocalRing.residue A₀ a))
    rw [IsLocalRing.ResidueField.map_residue]
    change (Ideal.Quotient.mk J) (φ (α a)) =
      (Ideal.Quotient.mk J) (algebraMap A B (α a))
    rw [← hα, hφ]
  have hE := residue_formallySmooth_transport
    (Ideal.map (Ideal.Quotient.mk J) (IsLocalRing.maximalIdeal B)) α hres hfs
  have hE' : Algebra.FormallySmoothAdic (IsLocalRing.ResidueField A₀) E
      (IsLocalRing.maximalIdeal E) := by simpa [hmax] using hE
  obtain ⟨C, instC, instLocalC, instAlgC, hnoeth, hcomplete, γ, hγ, hlocalγ,
    hsmooth, θ, hsurj, hker, hcomp⟩ := model_of_residue_smooth (A := A) hE'
  let : CommRing C := instC
  let : IsLocalRing C := instLocalC
  let : Algebra A₀ C := instAlgC
  refine ⟨C, instC, instLocalC, instAlgC, hnoeth, hcomplete, γ, hγ, hlocalγ,
    hsmooth, θ, hsurj, hker, ?_⟩
  rw [hcomp]
  ext a
  rfl

end RingHom
