module

public import Mathlib.Algebra.Category.ModuleCat.Colimits
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.LinearAlgebra.TensorProduct.Map
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
import Mathlib.RingTheory.RingHom.Flat
import Mathlib.RingTheory.Flat.EquationalCriterion

/-! # Lazard presentation of a tensor-exact module

Source: Stacks Project, Algebra, Tag 058G, forward direction of Lazard's theorem.
(blueprint: lem-kun-lazard-flat-module)
-/

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits

namespace Module

/-- A module whose right tensor functor preserves short exact sequences is a
colimit of finite free modules indexed by a small nonempty directed partial order.

Source: Stacks Project, Algebra, Tag 058G (theorem-lazard), forward direction.
(blueprint: lem-kun-lazard-flat-module)

Proof:
1. Apply the hypothesis to an injection and its quotient sequence to obtain
flatness in the sense of def-weil-pbc-flat-ring-map.
2. Use lem-weil-pbc-flat-equational-criterion to factor a map from a finite free
module through another finite free module, killing one specified kernel vector.
Induct on a finite list of vectors to kill any finitely generated kernel submodule.
3. Present M by the free module on M times the integers. Index finite presentations
by pairs (J, N), where J is a finite set of labels and N is a finitely generated
submodule of the kernel supported on J. Inclusion gives a nonempty directed
partial order and compatible quotient modules mapping to M.
4. Verify its colimit universal property (def-weil-pbc-category-colimit) on basis
vectors: a compatible cocone defines a linear map on the free module, kills its
kernel using the stages generated by individual relations, and descends uniquely.
5. Factor a finite presentation through a finite free module using step 2. Choose
fresh integer-labelled coordinates for its basis, and adjoin them to J. The map
from the enlarged coordinate module to this free module splits; its kernel is
explicitly generated by the old basis vectors minus their images on the new
coordinates. This gives a finite free stage above the prescribed stage.
6. Restrict to the cofinal subset of finite free stages. It is nonempty and
directed. Extend any cocone back to all stages by choosing a free upper stage;
a common free upper bound makes this independent of the choice. Step 4 gives
existence and uniqueness of its mediating map, so the restricted cocone is colimiting.
7. Each restricted stage is linearly isomorphic to a finite coordinate module.
The canonical map from the chosen categorical colimit to M is an isomorphism by
that universal property, giving all the asserted data. -/
theorem exists_directed_finite_free_presentation
    (R : Type u) [CommRing R] (M : Type (max u v)) [AddCommGroup M] [Module R M]
    (hM : ∀ (A B C : Type (max u v))
      [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
      [AddCommGroup C] [Module R C] (f : A →ₗ[R] B) (g : B →ₗ[R] C),
      Function.Injective f → Function.Exact f g → Function.Surjective g →
        Function.Injective (f.rTensor M) ∧
        Function.Exact (f.rTensor M) (g.rTensor M) ∧ Function.Surjective (g.rTensor M)) :
    ∃ (I : Type (max u v)) (_ : PartialOrder I) (_ : Nonempty I)
      (_ : IsDirected I (· ≤ ·)) (F : I ⥤ ModuleCat.{max u v} R)
      (ι : F ⟶ (Functor.const I).obj (ModuleCat.of R M)),
      (∀ i : I, ∃ r : ℕ, Nonempty ((F.obj i) ≃ₗ[R] (Fin r → R))) ∧
        IsIso (colimit.desc F (Cocone.mk (ModuleCat.of R M) ι)) := by
  sorry

end Module
