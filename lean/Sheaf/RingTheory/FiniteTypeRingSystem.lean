module

public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.RingTheory.FiniteType
import Mathlib.Algebra.Category.Ring.FilteredColimits
import Mathlib.CategoryTheory.Limits.ConcreteCategory.Basic

/-! # A finite type algebra as a compatible ring system

Source: the finite-generator construction underlying Stacks Project, Algebra, Tag 00QV.
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits
namespace RingHom

-- A named construction keeps the stage ring structures shared in conversion checks.
private def stageDiagram
    {J : Type u} [Preorder J] (Q : Type u) [CommRing Q] (S : J → Subring Q)
    (hmono : ∀ (i j : J), i ≤ j → S i ≤ S j) :
    J ⥤ CommRingCat.{u} where
  obj i := CommRingCat.of (S i)
  map {i j} a := CommRingCat.ofHom
    { toFun := fun x ↦ ⟨x.val, hmono i j (leOfHom a) x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  map_id i := by ext x; rfl
  map_comp a b := by ext x; rfl

private def stageCocone
    {J : Type u} [Preorder J] (Q : Type u) [CommRing Q] (S : J → Subring Q)
    (hmono : ∀ (i j : J), i ≤ j → S i ≤ S j) :
    Cocone (stageDiagram Q S hmono) where
  pt := CommRingCat.of Q
  ι :=
    { app := fun i ↦ CommRingCat.ofHom (S i).subtype
      naturality := by intro i j a; ext x; rfl }

/-- A finite type algebra over a directed ring colimit is a colimit of finite type
stage algebras, with compatible structure maps.

Source: Stacks Project, Algebra, Tag 00QV, with the finite type conclusion only.
(blueprint: lem-weil-pbc-finite-type-ring-system)

Proof: Choose finite algebra generators of P. At each stage take the subring of P
generated by these elements over the image of that stage, constructed as the image
of polynomial evaluation. Its underlying subring grows with the stage, so inclusions
give the transition maps and are compatible with the base maps. Each stage algebra is
of finite type by construction. The union is P: algebra generators occur everywhere,
and any coefficient from the base colimit occurs at a stage; common upper bounds
handle sums and products. The canonical ring colimit therefore maps bijectively to P:
surjectivity is the union assertion, and equality is detected in a common subring of P.
This bijection is the required ring equivalence. Unlike finite-presentation descent,
this construction requires no relation lifting and asserts no finite presentation of
the stage maps. Empty generating sets and noninjective base maps are included. -/
theorem exists_finiteType_ring_system
    {I : Type u} [Preorder I] [Nonempty I] [IsDirected I (· ≤ ·)]
    (F : I ⥤ CommRingCat.{u}) (c : Cocone F) (hc : IsColimit c)
    (P : Type u) [CommRing P] [Algebra c.pt P] [Algebra.FiniteType c.pt P] :
    ∃ i₀ : I, ∃ D : {i : I // i₀ ≤ i} ⥤ CommRingCat.{u},
      ∃ (σ : ∀ i : {i : I // i₀ ≤ i}, F.obj i.1 →+* D.obj i)
        (e : (colimit D : CommRingCat.{u}) ≃+* P),
        (∀ i, (σ i).FiniteType) ∧
        (∀ i, e.toRingHom.comp ((colimit.ι D i).hom.comp (σ i)) =
          (algebraMap c.pt P).comp (c.ι.app i.1).hom) ∧
        (∀ (i j : {i : I // i₀ ≤ i}) (h : i ≤ j),
          (D.map (homOfLE h)).hom.comp (σ i) =
            (σ j).comp (F.map (homOfLE h)).hom) := by
  classical
  let Q := P
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := c.pt) (A := Q)
  let i₀ : I := Classical.choice inferInstance
  let J := {i : I // i₀ ≤ i}
  have : Nonempty J := ⟨⟨i₀, le_rfl⟩⟩
  have : IsDirected J (· ≤ ·) := ⟨fun i j ↦ by
    obtain ⟨k, hik, hjk⟩ := exists_ge_ge i.val j.val
    exact ⟨⟨k, i.property.trans hik⟩, hik, hjk⟩⟩
  let ρ (i : J) : F.obj i.1 →+* Q :=
    (algebraMap c.pt Q).comp (c.ι.app i.1).hom
  let E (i : J) : MvPolynomial s (F.obj i.1) →+* Q :=
    MvPolynomial.eval₂Hom (ρ i) (fun x : s ↦ x.val)
  let S (i : J) : Subring Q := (E i).range
  have hρ (i j : J) (h : i ≤ j) :
      (ρ j).comp (F.map (homOfLE h)).hom = ρ i := by
    ext x
    exact congrArg (algebraMap c.pt Q) (ConcreteCategory.congr_hom (c.w (homOfLE h)) x)
  have hmono (i j : J) (h : i ≤ j) : S i ≤ S j := by
    rintro x ⟨p, rfl⟩
    refine ⟨MvPolynomial.map (F.map (homOfLE h)).hom p, ?_⟩
    change MvPolynomial.eval₂Hom (ρ j) (fun x : s ↦ x.val)
      (MvPolynomial.map (F.map (homOfLE h)).hom p) = E i p
    rw [MvPolynomial.eval₂Hom_map_hom, hρ]
  let D := stageDiagram Q S hmono
  let d := stageCocone Q S hmono
  have hcover (x : Q) : ∃ i : J, x ∈ S i := by
    have hx : x ∈ Algebra.adjoin c.pt (s : Set Q) := by rw [hs]; trivial
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨⟨i₀, le_rfl⟩, ?_⟩
      exact ⟨MvPolynomial.X ⟨x, hx⟩, MvPolynomial.eval₂Hom_X' (ρ _) _ _⟩
    | algebraMap a =>
      obtain ⟨i, y, hy⟩ := Concrete.isColimit_exists_rep F hc a
      obtain ⟨k, hik, h₀k⟩ := exists_ge_ge i i₀
      let j : J := ⟨k, h₀k⟩
      refine ⟨j, ?_⟩
      have he : ρ j ((F.map (homOfLE hik)).hom y) = algebraMap c.pt Q a := by
        change algebraMap c.pt Q ((c.ι.app k).hom ((F.map (homOfLE hik)).hom y)) = _
        exact congrArg (algebraMap c.pt Q)
          ((ConcreteCategory.congr_hom (c.w (homOfLE hik)) y).trans hy)
      rw [← he]
      exact ⟨MvPolynomial.C ((F.map (homOfLE hik)).hom y),
        MvPolynomial.eval₂Hom_C (ρ j) _ _⟩
    | add x y _ _ hx hy =>
      obtain ⟨i, hi⟩ := hx
      obtain ⟨j, hj⟩ := hy
      obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
      exact ⟨k, (S k).add_mem (hmono i k hik hi) (hmono j k hjk hj)⟩
    | mul x y _ _ hx hy =>
      obtain ⟨i, hi⟩ := hx
      obtain ⟨j, hj⟩ := hy
      obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
      exact ⟨k, (S k).mul_mem (hmono i k hik hi) (hmono j k hjk hj)⟩
  let v : (colimit D : CommRingCat.{u}) →+* Q := (colimit.desc D d).hom
  have hv (i : J) (x : D.obj i) : v ((colimit.ι D i).hom x) = ((show S i from x) : Q) :=
    ConcreteCategory.congr_hom (colimit.ι_desc d i) x
  have hbij : Function.Bijective v := by
    constructor
    · intro x y hxy
      obtain ⟨i, xi, rfl⟩ := Concrete.isColimit_exists_rep D (colimit.isColimit D) x
      obtain ⟨j, yj, rfl⟩ := Concrete.isColimit_exists_rep D (colimit.isColimit D) y
      change v ((colimit.ι D i).hom xi) = v ((colimit.ι D j).hom yj) at hxy
      change (colimit.ι D i).hom xi = (colimit.ι D j).hom yj
      rw [hv, hv] at hxy
      obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
      have he : (D.map (homOfLE hik)).hom xi = (D.map (homOfLE hjk)).hom yj :=
        Subtype.ext hxy
      have hi := ConcreteCategory.congr_hom (colimit.w D (homOfLE hik)) xi
      have hj := ConcreteCategory.congr_hom (colimit.w D (homOfLE hjk)) yj
      exact hi.symm.trans ((congrArg (colimit.ι D k).hom he).trans hj)
    · intro x
      obtain ⟨i, hi⟩ := hcover x
      exact ⟨(colimit.ι D i).hom ⟨x, hi⟩, hv i ⟨x, hi⟩⟩
  let e : (colimit D : CommRingCat.{u}) ≃+* P := RingEquiv.ofBijective v hbij
  let σ (i : J) : F.obj i.1 →+* D.obj i :=
    (E i).rangeRestrict.comp MvPolynomial.C
  refine ⟨i₀, D, σ, e, ?_, ?_, ?_⟩
  · intro i
    have hC : (MvPolynomial.C (σ := s) :
        F.obj i.1 →+* MvPolynomial s (F.obj i.1)).FiniteType := by
      change (algebraMap (F.obj i.1) (MvPolynomial s (F.obj i.1))).FiniteType
      exact finiteType_algebraMap.mpr inferInstance
    exact (FiniteType.of_surjective _ (E i).rangeRestrict_surjective).comp hC
  · intro i
    ext x
    change v ((colimit.ι D i).hom (σ i x)) = _
    rw [hv]
    exact MvPolynomial.eval₂Hom_C (ρ i) _ x
  · intro i j h
    apply RingHom.ext
    intro x
    apply Subtype.ext
    change E i (MvPolynomial.C x) = E j (MvPolynomial.C ((F.map (homOfLE h)).hom x))
    simpa only [E, MvPolynomial.eval₂Hom_C, RingHom.comp_apply] using
      (DFunLike.congr_fun (hρ i j h) x).symm

end RingHom
