import Sheaf.RingTheory.FormallySmoothAdic
import Sheaf.RingTheory.GRing

/-!
# Flatness and geometric regularity of the closed fibre of an adically formally smooth map

Source: Stacks Project, More on Algebra, Proposition 15.41.5 (Tag 07NQ), implication
(3) ⇒ (1) (blueprint: lem-weil-pbc-fs-adic-flat-geometrically-regular-closed-fibre).
-/

universe u v

open IsLocalRing

namespace RingHom

/-- A local homomorphism of Noetherian local rings that is formally smooth for the
maximal-ideal-adic topology on the target is flat, with geometrically regular closed fibre.
The residue field is the quotient `A ⧸ maximalIdeal A` (field structure
`Ideal.Quotient.field`) and the closed fibre is the quotient `B ⧸ m_A B`, with the induced
quotient algebra structure, as in the converse
`RingHom.formallySmoothAdic_of_flat_closedFiber` (Tag 07NQ, (2) ⇒ (3)).
Source: Stacks Project, More on Algebra, Proposition 15.41.5 (Tag 07NQ), (3) ⇒ (1).
(blueprint: lem-weil-pbc-fs-adic-flat-geometrically-regular-closed-fibre)

Proof:
1. Apply `lem-weil-pbc-fs-adic-local-flat` (Tag 07NP) to obtain flatness of the local map.
2. Locality gives `m_A B ⊆ m_B`, so the quotient by `m_A B` is a nonzero local ring by
   `lem-weil-pbc-quotient-local-structure`, and is Noetherian by
   `lem-weil-pbc-surjective-image-noetherian`. The quotient carries its natural residue-field
   algebra structure. By `lem-weil-pbc-tensor-quotient-base-change`, it is isomorphic to the
   base change `B ⊗_A k`, with its maximal ideal corresponding to the ideal generated by `m_B`.
3. Base change formal smoothness along `A → A / m_A`, using
   `lem-weil-pbc-fs-adic-base-change` (Tag 07EG). Transport it along the quotient/tensor
   isomorphism: precompose a test map with the inverse isomorphism, lift, and compose the
   lift with the isomorphism. Powers of the corresponding maximal ideals are preserved.
4. Apply `lem-weil-pbc-fs-adic-field-geometrically-regular` (Tag 07EL, (2) ⇒ (1)) to this
   Noetherian local residue-field algebra. Every finite purely inseparable extension of the
   residue field therefore gives a regular base-changed ring. Combine this with step 1. -/
theorem flat_and_isGeometricallyRegular_closedFiber_of_formallySmoothAdic
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    (φ : A →+* B) [IsLocalHom φ] :
    letI : Algebra A B := φ.toAlgebra
    letI : Field (A ⧸ maximalIdeal A) := Ideal.Quotient.field (maximalIdeal A)
    let I : Ideal B := Ideal.map φ (maximalIdeal A)
    letI : Algebra (A ⧸ maximalIdeal A) (B ⧸ I) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
        maximalIdeal A ≤ I.comap (algebraMap A B))
    Algebra.FormallySmoothAdic A B (maximalIdeal B) →
      φ.Flat ∧ Algebra.IsGeometricallyRegular (A ⧸ maximalIdeal A) (B ⧸ I) := by
  sorry

end RingHom
