module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed

/-!
# Regularity and normality for one-dimensional Noetherian local rings

Source: Stacks Project, Algebra, Lemma 10.119.7 (Tag 00PD), equivalence of (3) and (5)
(blueprint: lem-weil-pbc-regular-local-dim-one-iff-normal).
-/

@[expose] public section

universe u

namespace IsRegularLocalRing

/-- A one-dimensional Noetherian local ring is regular exactly when it is a normal domain.
Source: Stacks Project, Algebra, Tag 00PD, equivalence of (3) and (5)
(blueprint: lem-weil-pbc-regular-local-dim-one-iff-normal).

Proof:
1. If `A` is regular, it is a domain by `lem-sc-regular-local-domain`. In dimension one
   its maximal ideal is generated by one element (`def-weil-regular-scheme` and
   `def-weil-pbc-krull-dimension-ring`), so `lem-sc-regular-dim1-dvr` makes it a discrete
   valuation ring. It is therefore a valuation ring, and `lem-weil-pbc-valuation-ring-normal`
   makes it integrally closed in its fraction field. Together with the domain property this
   is normality as in `def-weil-pbc-normal-ring`.
2. Conversely, a normal local domain of dimension one is a discrete valuation ring by
   `lem-sc-normal-dim1-dvr`. Its maximal ideal has a single nonzero generator, so
   `lem-weil-pbc-principal-maximal-dim-one-regular` makes it regular. This proves the
   equivalence. -/
theorem iff_isDomain_and_isIntegrallyClosed_of_dim_one (A : Type u) [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] (hdim : ringKrullDim A = 1) :
    IsRegularLocalRing A ↔ IsDomain A ∧ IsIntegrallyClosed A := by
  sorry

end IsRegularLocalRing
