module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.RegularLocalRing.Polynomial
import WeilConjectures.Mathlib.RingTheory.KrullDimension.Polynomial

/-!
# The polynomial ring localized at the origin

Source: Stacks Project, Algebra, Tag 00OP, specialized to the ideal of all variables
(blueprint: lem-weil-pbc-polynomial-ring-origin-regular-local).
-/

@[expose] public section

universe u

namespace MvPolynomial

/-- Evaluation at zero has the variable ideal as kernel (Stacks Tag 00OP, origin case). -/
private theorem origin_ker (k : Type u) [Field k] (σ : Type*) :
    Ideal.span (Set.range (X : σ → MvPolynomial σ k)) =
      RingHom.ker (aeval (fun _ : σ ↦ (0 : k))) := by
  let p := Ideal.span (Set.range (X : σ → MvPolynomial σ k))
  let f := aeval (R := k) (fun _ : σ ↦ (0 : k))
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp
  · intro q hq
    have h : q - C (f q) ∈ p := by
      clear hq
      induction q using MvPolynomial.induction_on with
      | C a => simp [f]
      | add a b ha hb =>
        simpa [map_add, sub_add_sub_comm] using p.add_mem ha hb
      | mul_X a i ha =>
        simpa [f] using p.mul_mem_left a (Ideal.subset_span (Set.mem_range_self i))
    simpa [f, RingHom.mem_ker.mp hq] using h

/-- The origin is maximal because evaluation at zero surjects onto the field. -/
private theorem origin_maximal (k : Type u) [Field k] (σ : Type*) :
    (Ideal.span (Set.range (X : σ → MvPolynomial σ k))).IsMaximal := by
  rw [origin_ker]
  exact RingHom.ker_isMaximal_of_surjective _ (fun a ↦ ⟨C a, by simp⟩)

/-- Stacks Project, Algebra, Tag 00OP, specialized to the origin
(blueprint: lem-weil-pbc-polynomial-ring-origin-regular-local).

For every field `k` and number `d` of variables, the ideal generated by all variables is
maximal, its quotient is `k`, and its localization is regular local of dimension `d`.
The extended ideal is the maximal ideal, generated by the images of the variables.

Proof:
1. Evaluation at zero is surjective, with kernel the variable ideal. Polynomial induction
   shows that a polynomial minus its evaluated constant lies in this ideal. The first
   isomorphism theorem gives the quotient algebra isomorphism and maximality.
2. The proved upstream theorem `MvPolynomial.height_eq_of_isMaximal` computes the height
   of every maximal ideal in `k[X₁, …, X_d]` as `d`, including the origin ideal.
3. `IsLocalization.AtPrime.ringKrullDim_eq_height` turns this height into the dimension
   of the localization. The polynomial ring is regular by
   `MvPolynomial.isRegularRing_of_isRegularRing`, so its prime localization is regular local.
4. `Localization.AtPrime.map_eq_maximalIdeal` identifies the extended ideal with the
   maximal ideal. Mapping a span identifies its generators with the variable images.

The existential maximality proof supplies the prime instance needed to form `AtPrime`;
it is part of the conclusion, not a hypothesis. -/
theorem polynomial_origin_regularLocal (k : Type u) [Field k] (d : ℕ) :
    ∃ hp : (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))).IsMaximal,
      letI : (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))).IsPrime :=
        hp.isPrime
      Nonempty ((MvPolynomial (Fin d) k ⧸
        Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))) ≃ₐ[k] k) ∧
      IsRegularLocalRing (Localization.AtPrime
        (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) ∧
      ringKrullDim (Localization.AtPrime
        (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) = (d : WithBot ℕ∞) ∧
      Ideal.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))))
        (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) =
        Ideal.span (Set.range (fun i : Fin d ↦
          algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime
            (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) (X i))) := by
  classical
  let p := Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))
  have hp := origin_maximal k (Fin d)
  refine ⟨hp, ?_⟩
  let : p.IsPrime := hp.isPrime
  have he : Nonempty ((MvPolynomial (Fin d) k ⧸ p) ≃ₐ[k] k) := by
    refine ⟨(Ideal.quotientEquivAlgOfEq k (origin_ker k (Fin d))).trans ?_⟩
    exact Ideal.quotientKerAlgEquivOfSurjective (fun a ↦ ⟨C a, by simp⟩)
  have hm : Ideal.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime p)) p =
      IsLocalRing.maximalIdeal (Localization.AtPrime p) :=
    Localization.AtPrime.map_eq_maximalIdeal
  refine ⟨he, inferInstance, ?_, hm, ?_⟩
  · rw [IsLocalization.AtPrime.ringKrullDim_eq_height p,
      MvPolynomial.height_eq_of_isMaximal d p]
    rfl
  · rw [← hm, Ideal.map_span, ← Set.range_comp]
    rfl

end MvPolynomial
