import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The polynomial ring localized at the origin

Source: Stacks Project, Algebra, Tag 00OP, specialized to the ideal of all variables
(blueprint: lem-weil-pbc-polynomial-ring-origin-regular-local).
-/

universe u

namespace MvPolynomial

/-- Stacks Project, Algebra, Tag 00OP, specialized to the origin
(blueprint: lem-weil-pbc-polynomial-ring-origin-regular-local).

For every field `k` and number `d` of variables, the ideal generated by all variables is
maximal, its quotient is `k`, and its localization is regular local of dimension `d`.
The extended ideal is the maximal ideal, generated by the images of the variables.

Proof (the node's six steps):
1. Evaluation at zero is surjective, with kernel the variable ideal: a polynomial minus
   its constant coefficient is a sum of monomials divisible by variables. Thus the quotient
   is `k` and the ideal is maximal (def-weil-pbc-mv-polynomial-ring).
2. The polynomial ring is Noetherian since it is finite type over the Noetherian field
   (lem-weil-pbc-finite-type-algebra-noetherian). Localization is Noetherian local
   (lem-weil-pbc-localization-noetherian, def-weil-pbc-localization-at-prime), and extending
   the variable ideal generates the maximal ideal by the images of the variables.
3. Krull's height theorem bounds the local dimension by `d`
   (lem-weil-pbc-noetherian-local-dimension-le-generators, Stacks Tag 00KQ).
4. The ideals generated by the first `i` variables, for `0 ≤ i ≤ d`, form a strictly
   increasing chain of primes: the quotients are polynomial rings over `k` in the remaining
   variables, hence domains (lem-weil-pbc-polynomial-ring-domain).
5. The prime correspondence for localization transports this chain, with strictness
   preserved by contraction (lem-weil-pbc-localization-prime-residue-field-iso).
   This bounds the local dimension below by `d`.
6. The dimension is therefore `d`; the Noetherian local ring has a maximal ideal generated
   by `d` elements, hence is regular local (def-weil-regular-scheme).

The existential maximality proof supplies the prime instance needed to form `AtPrime`;
it is part of the conclusion, not a hypothesis. -/
theorem polynomial_origin_regularLocal (k : Type u) [Field k] (d : ℕ) :
    ∃ hp : (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))).IsMaximal,
      letI : (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))).IsPrime :=
        hp.isPrime
      Nonempty ((MvPolynomial (Fin d) k ⧸
        Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))) ≃ₐ[k] k) ∧
      IsRegularLocalRing (Localization.AtPrime
        (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) ∧
      ringKrullDim (Localization.AtPrime
        (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) = (d : WithBot ℕ∞) ∧
      Ideal.map (algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))))
        (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) =
        Ideal.span (Set.range (fun i : Fin d ↦
          algebraMap (MvPolynomial (Fin d) k) (Localization.AtPrime
            (Ideal.span (Set.range (X : Fin d → MvPolynomial (Fin d) k)))) (X i))) := by
  sorry

end MvPolynomial
