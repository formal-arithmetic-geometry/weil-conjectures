module

public import Sheaf.RingTheory.FormallySmoothAdic
import Mathlib.RingTheory.Ideal.Quotient.PowTransition

/-! # Reduction to square-zero kernels annihilated by the adic ideal

Source: Stacks Project, Tag 07NQ, filtration of the lifting kernel.
(blueprint: lem-weil-pbc-fs-adic-small-kernel-criterion)
-/

@[expose] public section

universe u v

namespace Algebra

/-- It suffices to solve continuous lifting problems whose kernel is annihilated by
representatives of the image of the adic ideal.
Source: Stacks Project, Tag 07NQ, proof of (2) implies (3), filtration of J.
(blueprint: lem-weil-pbc-fs-adic-small-kernel-criterion)

Proof: Let a be the preimage in D of the ideal generated by g(n), and put
I_e = a^e J. If g kills n^k then a^k is contained in J, so I_k = 0 by J^2 = 0;
also I_0 = J. Lift successively from D/I_e to D/I_(e+1). The kernel of this
surjection is the image of I_e. It has square zero since I_e is contained in J.
A representative of the image of x in n lies in a, and multiplying it by I_e
lands in I_(e+1), proving the small-kernel condition. Identify each surjection
with the quotient by its kernel, and apply the hypothesis. Each lift remains
continuous: a lift of a map killing n^b kills n^(2*b), by squaring the kernel
containment. Induction gives a map into D/I_k, which identifies with D. Its
composite into D/J is the original g. All quotients stay in the permitted universe.
The same construction covers n = 0 and J = 0.
-/
theorem formallySmoothAdic_of_smallKernel_lifts
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    (n : Ideal S)
    (h : ∀ ⦃D : Type (max u v)⦄ [CommRing D] [Algebra R D]
      (J : Ideal D), J ^ 2 = ⊥ → ∀ g : S →ₐ[R] D ⧸ J,
      (∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, g x = 0) →
      (∀ x ∈ n, ∀ d : D, Ideal.Quotient.mk J d = g x →
        ∀ j ∈ J, d * j = 0) →
      ∃ f : S →ₐ[R] D, (Ideal.Quotient.mkₐ R J).comp f = g) :
    FormallySmoothAdic R S n := by
  classical
  have lift_surj : ∀ (E F : Type (max u v)) [CommRing E] [CommRing F]
      [Algebra R E] [Algebra R F] (p : E →ₐ[R] F), Function.Surjective p →
      (RingHom.ker p.toRingHom) ^ 2 = ⊥ → ∀ g : S →ₐ[R] F,
      (∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, g x = 0) →
      (∀ x ∈ n, ∀ d : E, p d = g x →
        ∀ j ∈ RingHom.ker p.toRingHom, d * j = 0) →
      ∃ f : S →ₐ[R] E, p.comp f = g := by
    intro E F _ _ _ _ p hp hp2 g hg hsmall
    let e := Ideal.quotientKerAlgEquivOfSurjective hp
    let g' : S →ₐ[R] E ⧸ RingHom.ker p.toRingHom := e.symm.toAlgHom.comp g
    have hg' : ∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, g' x = 0 := by
      obtain ⟨k, hk, hgk⟩ := hg
      exact ⟨k, hk, fun x hx ↦ by
        change e.symm (g x) = 0
        rw [hgk x hx, map_zero]⟩
    have hsmall' : ∀ x ∈ n, ∀ d : E,
        Ideal.Quotient.mk (RingHom.ker p.toRingHom) d = g' x →
        ∀ j ∈ RingHom.ker p.toRingHom, d * j = 0 := by
      intro x hx d hd j hj
      apply hsmall x hx d ?_ j hj
      have := congrArg e hd
      change p d = e (e.symm (g x)) at this
      simpa only [AlgEquiv.apply_symm_apply] using this
    obtain ⟨f, hf⟩ := h (RingHom.ker p.toRingHom) hp2 g' hg' hsmall'
    refine ⟨f, ?_⟩
    ext x
    change p (f x) = g x
    have := congrArg e (AlgHom.congr_fun hf x)
    change p (f x) = e (e.symm (g x)) at this
    simpa only [AlgEquiv.apply_symm_apply] using this
  have continuous_lift : ∀ (E F : Type (max u v)) [CommRing E] [CommRing F]
      [Algebra R E] [Algebra R F] (p : E →ₐ[R] F),
      (RingHom.ker p.toRingHom) ^ 2 = ⊥ → ∀ (f : S →ₐ[R] E) (g : S →ₐ[R] F),
      p.comp f = g → (∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, g x = 0) →
      ∃ k : ℕ, 1 ≤ k ∧ ∀ x ∈ n ^ k, f x = 0 := by
    intro E F _ _ _ _ p hp2 f g hfg hg
    obtain ⟨k, hk, hgk⟩ := hg
    have hle : n ^ k ≤ (RingHom.ker p.toRingHom).comap f.toRingHom := by
      intro x hx
      change p (f x) = 0
      exact (AlgHom.congr_fun hfg x).trans (hgk x hx)
    have hle2 : n ^ (k * 2) ≤ (⊥ : Ideal E).comap f.toRingHom := by
      calc
        n ^ (k * 2) = (n ^ k) ^ 2 := pow_mul n k 2
        _ ≤ ((RingHom.ker p.toRingHom).comap f.toRingHom) ^ 2 :=
          pow_le_pow_left' hle 2
        _ ≤ ((RingHom.ker p.toRingHom) ^ 2).comap f.toRingHom :=
          Ideal.le_comap_pow f.toRingHom 2
        _ = (⊥ : Ideal E).comap f.toRingHom := by rw [hp2]
    refine ⟨k * 2, by omega, ?_⟩
    intro x hx
    exact Ideal.mem_bot.mp (hle2 hx)
  intro D _ _ J hJ g hg
  obtain ⟨k, hk, hgk⟩ := hg
  let q := Ideal.Quotient.mk J
  let a : Ideal D := (n.map g.toRingHom).comap q
  let I (e : ℕ) : Ideal D := a ^ e * J
  have hIJ (e : ℕ) : I e ≤ J := Ideal.mul_le_right
  have hstep (e : ℕ) : I (e + 1) ≤ I e := by
    dsimp [I]
    rw [pow_succ', mul_assoc]
    exact Ideal.mul_le_right
  have hIzero : I 0 = J := by simp [I]
  have hIk : I k = ⊥ := by
    have hgn : (n ^ k).map g.toRingHom ≤ ⊥ := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact Ideal.mem_bot.mpr (hgk x hx)
    have hak : a ^ k ≤ J := by
      intro d hd
      have hd' := Ideal.le_comap_pow q k hd
      change q d ∈ (n.map g.toRingHom) ^ k at hd'
      rw [← Ideal.map_pow] at hd'
      exact Ideal.Quotient.eq_zero_iff_mem.mp (Ideal.mem_bot.mp (hgn hd'))
    apply le_antisymm _ bot_le
    calc
      I k ≤ J * J := Ideal.mul_mono hak le_rfl
      _ = ⊥ := by rw [← pow_two, hJ]
  have lifts (e : ℕ) : ∃ f : S →ₐ[R] D ⧸ I e,
      (Ideal.Quotient.factorₐ R (hIJ e)).comp f = g ∧
      (∃ b : ℕ, 1 ≤ b ∧ ∀ x ∈ n ^ b, f x = 0) := by
    induction e with
    | zero =>
      let eqv := Ideal.quotientEquivAlgOfEq R hIzero
      refine ⟨eqv.symm.toAlgHom.comp g, ?_, ?_⟩
      · ext x
        change eqv (eqv.symm (g x)) = g x
        exact eqv.apply_symm_apply (g x)
      · refine ⟨k, hk, ?_⟩
        intro x hx
        change eqv.symm (g x) = 0
        rw [hgk x hx, map_zero]
    | succ e ih =>
      obtain ⟨f, hf, hfc⟩ := ih
      let p : (D ⧸ I (e + 1)) →ₐ[R] D ⧸ I e :=
        Ideal.Quotient.factorₐ R (hstep e)
      have hp : Function.Surjective p := Ideal.Quotient.factor_surjective (hstep e)
      have hker : RingHom.ker p.toRingHom =
          (I e).map (Ideal.Quotient.mk (I (e + 1))) :=
        Ideal.Quotient.factor_ker (hstep e)
      have hp2 : (RingHom.ker p.toRingHom) ^ 2 = ⊥ := by
        rw [hker, ← Ideal.map_pow]
        have hIe : (I e) ^ 2 = ⊥ := by
          apply le_antisymm _ bot_le
          exact (pow_le_pow_left' (hIJ e) 2).trans_eq hJ
        rw [hIe, Ideal.map_bot]
      have hsmall : ∀ x ∈ n, ∀ d : D ⧸ I (e + 1), p d = f x →
          ∀ j ∈ RingHom.ker p.toRingHom, d * j = 0 := by
        intro x hx d hd j hj
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective d
        rw [hker] at hj
        obtain ⟨j, hjmem, rfl⟩ :=
          (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hj
        have hqd : q d = g x := by
          have h := congrArg (Ideal.Quotient.factorₐ R (hIJ e)) hd
          exact h.trans (AlgHom.congr_fun hf x)
        have hda : d ∈ a := by
          change q d ∈ n.map g.toRingHom
          rw [hqd]
          exact Ideal.mem_map_of_mem _ hx
        change Ideal.Quotient.mk (I (e + 1)) d *
          Ideal.Quotient.mk (I (e + 1)) j = 0
        rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
        have hmem := Ideal.mul_mem_mul hda hjmem
        simpa only [I, pow_succ', mul_assoc] using hmem
      obtain ⟨f', hf'⟩ := lift_surj _ _ p hp hp2 f hfc hsmall
      refine ⟨f', ?_, continuous_lift _ _ p hp2 f' f hf' hfc⟩
      rw [← hf, ← hf', ← AlgHom.comp_assoc]
      congr 1
      exact (Ideal.Quotient.factorₐ_comp R (hstep e) (hIJ e)).symm
  obtain ⟨f, hf, _⟩ := lifts k
  let eqv := Ideal.quotientEquivAlgOfEq R hIk
  let l := (AlgEquiv.quotientBot R D).toAlgHom.comp (eqv.toAlgHom.comp f)
  refine ⟨l, ?_⟩
  ext x
  obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (f x)
  have := AlgHom.congr_fun hf x
  change Ideal.Quotient.factorₐ R (hIJ k) (f x) = g x at this
  rw [← hd] at this
  have hlx : l x = d := by
    change AlgEquiv.quotientBot R D (eqv (f x)) = d
    rw [← hd]
    change AlgEquiv.quotientBot R D
      (Ideal.quotientEquivAlgOfEq R hIk (Ideal.Quotient.mk (I k) d)) = d
    rw [Ideal.quotientEquivAlgOfEq_mk, AlgEquiv.quotientBot_mk]
  change Ideal.Quotient.mk J (l x) = g x
  rw [hlx]
  exact this

end Algebra
