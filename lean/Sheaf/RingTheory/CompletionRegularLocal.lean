module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Regularity and completion of Noetherian local rings

Source: Stacks Project, More on Algebra, Lemma Tag 07NY
(blueprint: lem-weil-pbc-completion-regular-local).
-/

@[expose] public section

universe u

namespace AdicCompletion

/-- A Noetherian local ring is regular if and only if its maximal-ideal-adic completion
is regular. Source: Stacks Project, More on Algebra, Lemma Tag 07NY
(blueprint: lem-weil-pbc-completion-regular-local).

Proof:
1. The completion is Noetherian (`lem-weil-pbc-adic-completion-noetherian`) and local with
   maximal ideal the extension of the original maximal ideal
   (`lem-weil-pbc-local-completion-local-ring`). Its Krull dimension is the original dimension
   (`lem-weil-pbc-completion-dimension`, Stacks Tag 07NV). By `def-weil-regular-scheme`,
   regularity means that the maximal ideal is generated by that many elements.
2. If the original ring is regular, choose generators of its maximal ideal numbering its
   dimension. Their images generate the extended maximal ideal. The dimension equality makes
   this a generating family of the required size for the completion, so it is regular.
3. Conversely, the two maximal ideals have equal minimal numbers of generators
   (`lem-weil-pbc-completion-maximal-ideal-generators`, using Stacks Tags 05GG and 00DV;
   Mathlib's `AdicCompletion.spanFinrank_maximalIdeal_eq`). If the completion is regular,
   this number is its dimension, hence the dimension of the original ring. The original
   ring is therefore regular. This is the node's generator-count version of the converse
   that Stacks proves by flat descent (Tag 00OF). -/
theorem isRegularLocalRing_iff (A : Type u) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] :
    IsRegularLocalRing A ↔ IsRegularLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
  sorry

end AdicCompletion
