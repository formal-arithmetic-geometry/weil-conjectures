module

public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.RingTheory.Localization.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.Algebra.BigOperators.Ring.Finset

/-!
# Localization certificates modulo an arbitrary base ideal

Source: Stacks Project, Tag 00CT (`proposition-localize-quotient`) and Tag 00CM
(`section-localization`), applied to an extended base ideal.
(blueprint: lem-trf-base-ideal-localization-certificates)
-/

@[expose] public section

universe u v t

open scoped BigOperators

namespace Ideal

/-- The quotient-base map has unit denominators, fraction representatives, kernel witnesses,
and the prescribed product-denominator certificate, without finiteness assumptions on the ideal.
Source: Stacks Project, Tags 00CT (`proposition-localize-quotient`), 00CM
(`section-localization`) and 00AR (`section-rings-basic`).
(blueprint: lem-trf-base-ideal-localization-certificates)

Proof:
1. For either target ring, the extended ideal consists of finite sums of multiples of images of
   elements of `I`: these sums form an ideal and are exactly the ideal generated by those images.
2. The map `c ↦ c/1 mod IB` kills `IC`, since it takes each such finite sum into `IB`.
   It therefore descends to the ring map `φ`. Its formula on representatives characterizes it
   uniquely, by surjectivity of the quotient map. These use the quotient and localization
   constructions of `def-weil-pbc-algebra-hom-quotient` and `def-weil-pbc-module-localization`.
3. The fraction multiplication rule gives `(w/1)(1/w) = 1`; applying the quotient map proves
   that `φ(w mod IC)` is a unit with the stated inverse, by the same two definition nodes.
4. Lift a quotient element to a localization element, write that element as `c/w`, and use
   `c/w = (c/1)(1/w)` to obtain the fraction representation, using those definition nodes.
5. For the finite relation, put `p = ∏ i, w i` and `e = ∑ i, f(a i)d i ∏ j ≠ i, w j`.
   Multiplying the relation by `p/1` gives `(p*c-e)/1 = 0`. The localization zero criterion
   of `def-weil-pbc-module-localization` gives `u ∈ W` with `u*(p*c-e) = 0`.
   Thus `(u*p)*c = u*e ∈ IC`, since each summand of `e` belongs to `IC`.
   For the empty family this is exactly the zero criterion, with `p = 1` and `e = 0`.
6. If `φ(c mod IC) = 0`, then `c/1 ∈ IB`. Express this as a finite sum from step 1 and
   represent each coefficient by a fraction. Step 5 gives a multiplier `v = u*p ∈ W`
   with `v*c ∈ IC`; hence the product of their residue classes is zero. This uses the
   quotient kernel description of `def-weil-pbc-algebra-hom-quotient`, with no cancellation.
-/
theorem baseIdealLocalization_certificates
    {A : Type u} {C : Type v} [CommRing A] [CommRing C]
    (f : A →+* C) (I : Ideal A) (W : Submonoid C) :
    (∃ φ : (C ⧸ I.map f) →+*
        (Localization W ⧸ I.map ((algebraMap C (Localization W)).comp f)),
      (∀ c : C, φ (Ideal.Quotient.mk (I.map f) c) =
        Ideal.Quotient.mk (I.map ((algebraMap C (Localization W)).comp f))
          (Localization.mk c (1 : W))) ∧
      (∀ ψ : (C ⧸ I.map f) →+*
          (Localization W ⧸ I.map ((algebraMap C (Localization W)).comp f)),
        (∀ c : C, ψ (Ideal.Quotient.mk (I.map f) c) =
          Ideal.Quotient.mk (I.map ((algebraMap C (Localization W)).comp f))
            (Localization.mk c (1 : W))) → ψ = φ) ∧
      (∀ w : W, IsUnit (φ (Ideal.Quotient.mk (I.map f) (w : C))) ∧
        φ (Ideal.Quotient.mk (I.map f) (w : C)) *
          Ideal.Quotient.mk (I.map ((algebraMap C (Localization W)).comp f))
            (Localization.mk 1 w) = 1) ∧
      (∀ r : Localization W ⧸ I.map ((algebraMap C (Localization W)).comp f),
        ∃ (c : C) (w : W), r = φ (Ideal.Quotient.mk (I.map f) c) *
          Ideal.Quotient.mk (I.map ((algebraMap C (Localization W)).comp f))
            (Localization.mk 1 w)) ∧
      (∀ c : C, φ (Ideal.Quotient.mk (I.map f) c) = 0 →
        ∃ v : W, (v : C) * c ∈ I.map f ∧
          Ideal.Quotient.mk (I.map f) (v : C) * Ideal.Quotient.mk (I.map f) c = 0)) ∧
    (∀ (ι : Type t) [Fintype ι] [DecidableEq ι]
        (a : ι → I) (d : ι → C) (w : ι → W) (c : C) (p : W) (e : C),
      p = ∏ i, w i →
      e = ∑ i, f (a i) * d i * ∏ j ∈ Finset.univ.erase i, (w j : C) →
      (Localization.mk c (1 : W) : Localization W) =
        ∑ i, Localization.mk (f (a i) * d i) (w i) →
      ∃ u : W, (u : C) * ((p : C) * c - e) = 0 ∧
        ((u * p : W) : C) * c = (u : C) * e ∧ (u : C) * e ∈ I.map f) := by
  sorry

end Ideal
