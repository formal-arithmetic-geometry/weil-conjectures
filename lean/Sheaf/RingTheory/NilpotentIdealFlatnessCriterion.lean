@[expose] public section

set_option autoImplicit false

universe u v

namespace Module.Flat

/-- Flatness lifts across a nilpotent ideal when ideal multiplication is injective.
Source: Stacks Project, Algebra, Tag 051C, final sentence, and Tag 00M6
(blueprint: lem-sfb-nilpotent-ideal-flatness-criterion).

Proof: Apply `lem-sfb-nilpotent-ideal-module-flatness` with its ideal `I` equal to
`J`, the same ring `R`, module `M`, and positive exponent `n`. The submodule `IM`
is `J • ⊤`, since both are generated by products of ideal elements and module elements.
Thus its reduced ring and module are exactly `R ⧸ J` and `M ⧸ J • ⊤`, with the
canonical quotient action. Its multiplication map is the displayed tensor lift:
both send `j ⊗ m` to `(j : R) • m`. The nilpotence, quotient flatness and injectivity
hypotheses therefore agree exactly. The cited criterion gives `Module.Flat R M`.
It requires no Noetherian, finite-generation or completeness condition. -/
theorem of_nilpotent_ideal_multiplication_injective
    {R : Type u} [CommRing R] (J : Ideal R)
    {M : Type v} [AddCommGroup M] [Module R M]
    (n : ℕ) (hn : 1 ≤ n) (hJ : J ^ n = ⊥)
    (hflat : Module.Flat (R ⧸ J) (M ⧸ J • (⊤ : Submodule R M)))
    (hinj : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul R M).comp J.subtype))) :
    Module.Flat R M := by
  sorry

end Module.Flat
