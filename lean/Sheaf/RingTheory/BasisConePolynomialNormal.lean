module

public import Sheaf.RingTheory.BasisConeAlgebra
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Algebra.Category.CommAlgCat.Basic
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.RingTheory.Polynomial.IsIntegral

/-! # The polynomial algebra of a basis cone

Source: ILO, Travaux de Gabber, Exposé VIII, Lemma 3.2.12, printed pp.104–105;
the explicit positive-basis calculation in the DAG and Stacks Tag 030A
(blueprint: lem-trf-basis-cone-polynomial-normal).

## Main definitions and statement

* `basisConePolynomialRing`: the literal tower of one-variable polynomial rings.
* `basisConeSupportedAlgebra`: the cone algebra inside the lattice group algebra.
* `basisConePolynomialEvaluation`: evaluation at the basis monomials.
* `basisCone_polynomial_normal`: the evaluation isomorphism and normality.
-/

@[expose] public section

set_option autoImplicit false

universe u v w

namespace AddMonoidAlgebra

/-- The tower `B₀ = k`, `Bᵢ₊₁ = Bᵢ[X]` in the positive-basis calculation.
Source: ILO VIII, Lemma 3.2.12, pp.104–105, expanded polynomial identification
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConePolynomialRing (k : Type u) [Field k] : ℕ → CommAlgCat.{u} k
  | 0 => CommAlgCat.of k k
  | n + 1 => CommAlgCat.of k (Polynomial (basisConePolynomialRing k n))

/-- The variables of the tower, with old variables included as constant polynomials.
Source: ILO VIII, Lemma 3.2.12, pp.104–105, expanded polynomial identification
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConePolynomialVariable (k : Type u) [Field k] :
    (n : ℕ) → Fin n → basisConePolynomialRing k n
  | 0 => Fin.elim0
  | n + 1 => Fin.lastCases Polynomial.X
      (fun i ↦ Polynomial.C (basisConePolynomialVariable k n i))

/-- Evaluation in the tower, applying one-variable evaluation at each stage.
Source: ILO VIII, Lemma 3.2.12, pp.104–105, expanded evaluation construction
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConePolynomialEval (k : Type u) [Field k]
    {A : Type w} [CommRing A] [Algebra k A] :
    (n : ℕ) → (Fin n → A) → basisConePolynomialRing k n →ₐ[k] A
  | 0, _ => Algebra.ofId k A
  | n + 1, x => Polynomial.aevalTower
      (basisConePolynomialEval k n (fun i ↦ x i.castSucc)) (x (Fin.last n))

variable {k : Type u} [Field k] {G : Type v} [AddCommGroup G] {r : ℕ}

/-- The concrete subalgebra of the group algebra obtained by extending cone coefficients by zero.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded cone-algebra construction
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConeSupportedAlgebra (b : Module.Basis (Fin r) ℤ G) :
    Subalgebra k (AddMonoidAlgebra k G) :=
  (basisConeInclusion (k := k) b).range

/-- A nonnegative coordinate tuple regarded as an element of the basis cone.
Source: ILO VIII, Lemma 3.2.12, pp.104–105, expanded coordinate construction
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConeExponent (b : Module.Basis (Fin r) ℤ G) (a : Fin r → ℕ) : basisCone b :=
  ⟨∑ i, a i • b i, AddSubmonoid.sum_mem _ fun i _ ↦
    AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (Set.mem_range_self i)) _⟩

/-- A cone monomial in the specified subalgebra of the group algebra.
Source: ILO VIII, Lemma 3.2.12, p.104, expanded extension-by-zero construction
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConeSupportedMonomial (b : Module.Basis (Fin r) ℤ G)
    (h : basisCone b) (c : k) : basisConeSupportedAlgebra (k := k) b :=
  (basisConeInclusion (k := k) b).rangeRestrict (single h c)

/-- The specified evaluation homomorphism, with variable images the basis monomials.
Source: ILO VIII, Lemma 3.2.12, pp.104–105, expanded polynomial identification
(blueprint: lem-trf-basis-cone-polynomial-normal). -/
noncomputable def basisConePolynomialEvaluation (b : Module.Basis (Fin r) ℤ G) :
    basisConePolynomialRing k r →ₐ[k] basisConeSupportedAlgebra (k := k) b :=
  basisConePolynomialEval k r (fun i ↦
    (basisConeInclusion (k := k) b).rangeRestrict (basisConeVariable (k := k) b i))

/-- The basis-cone subalgebra is the iterated polynomial algebra, with the specified evaluation
and inverse monomial formulas, and both algebras are normal domains.
Source: ILO VIII, Lemma 3.2.12, printed pp.104–105; expanded positive-basis calculation,
and Stacks Tag 030A (blueprint: lem-trf-basis-cone-polynomial-normal).

Proof plan:
1. For a nonnegative tuple a, put h(a) = ∑ i, aᵢ • bᵢ. The coordinate map is onto
   the cone because the latter is the additive submonoid generated by the bᵢ. It is
   injective by uniqueness of integral-basis coordinates. It preserves zero and sums.
   Extension of a coefficient list by zero outside the cone respects one, addition and
   convolution: all nonzero summands in a product have both exponents in the cone.
   It is injective coefficientwise, with image exactly the lists supported on the cone.
2. Using def-weil-polynomial-ring, expand a polynomial in Bᵢ uniquely as a finite list
   of coefficients in Bᵢ₋₁. Induction from B₀ = k gives the unique finite expansion
   ∑ a, cₐ Xᵃ in Bᵣ, appending the new exponent at each step. Addition adds coefficients;
   convolution and multiplication of powers give Xᵃ Xᵈ = Xᵃ⁺ᵈ.
3. Define φ(∑ a, cₐ Xᵃ) = ∑ a, cₐ eʰ⁽ᵃ⁾. Define its inverse by sending eʰ⁽ᵃ⁾
   to Xᵃ and extending k-linearly. Both sums are finite by the coordinate bijection.
   Both maps preserve sums and scalars; on products a pair of basis terms indexed by
   a,d is sent to the term indexed by a+d with the product coefficient. Distributing
   the finite sums proves multiplicativity and preservation of one. Reindexing proves
   both composites are identities. Coordinate unit vectors give φ(Xᵢ) = eᵇⁱ; the
   zero tuple gives preservation of constants. Any k-algebra homomorphism with these
   variable images has the displayed formula on monomials and hence on all polynomials.
   Thus φ is exactly the recursively defined evaluation, with the stated inverse.
4. A field (def-weil-field) is a domain, by multiplying a zero product by the inverse
   of its nonzero factor. Every fraction a/b already equals a b⁻¹ in k, so k is a normal
   domain (def-weil-pbc-normal-ring). Successively apply
   lem-weil-pbc-polynomial-ring-normal-domain (Stacks 030A) to obtain normality of Bᵣ.
5. Write ψ for φ⁻¹. Since ψ preserves one and is injective, one in C is nonzero;
   ψ(xy) = ψ(x)ψ(y) proves that C is a domain. Extend ψ to fractions by
   x/y ↦ ψ(x)/ψ(y), whose denominator is nonzero. Cross multiplication proves this
   is well-defined, and the fraction formulas prove it is a ring homomorphism, inverse
   to a/b ↦ φ(a)/φ(b). Apply this map to a monic equation for z in Frac(C), obtaining
   the monic equation with coefficients ψ(cⱼ) for its image. Normality of Bᵣ puts that
   image in Bᵣ. Applying the inverse fraction map then puts z in C. At rank zero,
   all exponent tuples are empty, G and its cone are zero, and both maps are the
   identity of k under the constant-monomial identification. -/
theorem basisCone_polynomial_normal (b : Module.Basis (Fin r) ℤ G) :
    (∀ f : AddMonoidAlgebra k G,
      f ∈ basisConeSupportedAlgebra (k := k) b ↔
        ∀ g : G, g ∉ basisCone b → f.coeff g = 0) ∧
    ∃ φ : basisConePolynomialRing k r ≃ₐ[k] basisConeSupportedAlgebra (k := k) b,
      φ.toAlgHom = basisConePolynomialEvaluation (k := k) b ∧
      (∀ i : Fin r,
        φ (basisConePolynomialVariable k r i) =
          (basisConeInclusion (k := k) b).rangeRestrict (basisConeVariable (k := k) b i)) ∧
      (∀ (a : Fin r → ℕ) (c : k),
        φ.symm (basisConeSupportedMonomial b (basisConeExponent b a) c) =
          c • ∏ i, basisConePolynomialVariable k r i ^ a i) ∧
      IsDomain (basisConePolynomialRing k r) ∧
      IsIntegrallyClosed (basisConePolynomialRing k r) ∧
      IsDomain (basisConeSupportedAlgebra (k := k) b) ∧
      IsIntegrallyClosed (basisConeSupportedAlgebra (k := k) b) := by
  sorry

end AddMonoidAlgebra
