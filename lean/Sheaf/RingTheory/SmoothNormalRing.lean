import Mathlib.RingTheory.RingHom.Smooth
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# Smooth algebras over normal rings

Source: Stacks Project, Algebra, Lemma Tag 033C
(blueprint: lem-weil-pbc-smooth-over-normal-ring-normal).
-/

universe uR uS

namespace RingHom

/-- A smooth algebra over a normal ring is normal.

Source: Stacks Project, Algebra, Lemma Tag 033C
(blueprint: lem-weil-pbc-smooth-over-normal-ring-normal)

Proof, following the node's seven steps:
1. If R is Noetherian, finite presentation makes S Noetherian
   (lem-weil-pbc-finite-type-algebra-noetherian). Smoothness gives flatness
   (lem-weil-pbc-smooth-ring-map-flat). The fibres are smooth over fields by
   lem-weil-pbc-smooth-ring-map-base-change-composition, hence regular by
   lem-weil-pbc-field-regular-ring and lem-weil-pbc-regular-ring-smooth-ascent,
   and normal by lem-weil-pbc-regular-ring-normal. Apply
   lem-weil-pbc-flat-normal-fibres-noetherian-normal (Tag 0C22).
2. For a prime q of S let p be its inverse image in R. Base change to R_p,
   a normal domain. By lem-weil-pbc-localization-base-change the base change S'
   is the localization at the image of R minus p; its localization at qS'
   is S_q. Thus it suffices to treat a normal domain R.
3. By lem-weil-pbc-smooth-algebra-finite-type-model descend the smooth map to
   R_0 -> S_0 with R_0 a finitely generated subring of R and S = R tensor S_0.
4. For any finitely generated subring A of R, its normalization A' in its
   fraction field is normal (lem-weil-pbc-integral-closure-algebraic-extension-normal)
   and lies in R because R is integrally closed. It is finite over A by
   lem-weil-pbc-finite-type-z-domain-normalization-finite, hence finitely generated
   and Noetherian. If A contains R_0, then A' contains R_0'.
5. The normal finitely generated subrings A containing R_0 form a nonempty
   directed set: normalize the subring generated by any two of them. Their
   union is R, since the normalization of R_0[x] contains x. Each A is Noetherian
   and normal also in the local sense (lem-weil-pbc-localization-normal-domain).
   Each S_A = A tensor S_0 is smooth over A and normal by step 1.
6. By lem-weil-pbc-tensor-cancel-base-change write these tensor products over
   R_0' using M_0 = R_0' tensor S_0. The union R is the colimit of the A.
   By lem-weil-pbc-directed-colimit-base-change-elementwise every element of S
   comes from some S_A, and every element becoming zero becomes zero at a later
   stage. These facts and directedness give the colimit universal property for S.
7. Apply lem-weil-pbc-filtered-colimit-normal-ring (Tag 037D) to the normal rings
   S_A. Their colimit S is normal; step 2 gives the assertion for general R.
-/
theorem Smooth.isNormalRing {R : Type uR} {S : Type uS} [CommRing R] [CommRing S]
    {f : R →+* S} (hf : f.Smooth)
    (hR : ∀ (p : Ideal R) [p.IsPrime],
      IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p)) :
    ∀ (q : Ideal S) [q.IsPrime],
      IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) := by
  sorry

end RingHom
