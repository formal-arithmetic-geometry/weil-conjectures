/-!
# Removing the equations of a regular closed fibre

Source: Stacks Project, More on Algebra, Tag 07NR, the parameter-quotient construction.
(blueprint: lem-weil-pbc-regular-presentation-flat-fiber)
-/

@[expose] public section

universe u v

namespace RingHom

/-- A compatible regular presentation can be replaced by a flat complete local model
whose closed fibre is the prescribed formally smooth residue-field algebra.

Source: Stacks Project, More on Algebra, Tag 07NR (lemma-lift-fs), from the first
regular presentation through the replacement by the quotient by the lifted equations.
(blueprint: lem-weil-pbc-regular-presentation-flat-fiber)

Proof: Put Sbar = S/m_R S. It is regular local by the hypothesis. The diagram and
q's residue-field isomorphism make the induced surjection Sbar → E a k_A-algebra map.
Adic formal smoothness of E over k_A implies regular locality directly (07EI).
The kernel of Sbar → E is generated by
an initial segment of a regular system of parameters (Algebra 00NR). Lift those
parameters to x_i in S; the diagram makes their images in E zero. The classes of
the images of the parameters of R are independent in m_S/m_S², and the x_i classes
are independent modulo their span. Their union is independent. Extend it to a basis
of the cotangent space, lift the remaining vectors, and apply Nakayama and the
regular-local cotangent dimension formula to obtain a regular system of parameters.
Set T = S/(x_i). After putting the x_i first, Algebra 00NQ gives that T is regular
local and the images of the R-parameters form a regular sequence. Algebra 07DY
therefore gives flatness of R → T. The quotient is complete Noetherian local by
Algebra 0325. Quotienting T by m_R T gives Sbar/(xbar_i), which is E by the kernel
calculation; the diagram proves the stated compatibility. Finally the isomorphism
R/m_R ≅ A/m_A and this closed-fibre isomorphism transport the lifting property:
precompose each lifting problem with the isomorphism, solve it on E, and compose
back. Their maximal ideals correspond because ring isomorphisms preserve units.
The empty parameter list and empty kernel-generator list give the same construction
in dimension zero and when Sbar → E is already an isomorphism. -/
theorem exists_flat_complete_model_of_regular_presentation
    (A : Type u) (E : Type v)
    [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [CommRing E] [IsNoetherianRing E] [IsLocalRing E]
    [Algebra (IsLocalRing.ResidueField A) E] [Algebra A E]
    [IsScalarTower A (IsLocalRing.ResidueField A) E]
    (hE : Algebra.FormallySmoothAdic (IsLocalRing.ResidueField A) E
      (IsLocalRing.maximalIdeal E))
    (R S : Type (max u v)) [CommRing R] [CommRing S]
    [IsRegularLocalRing R] [IsRegularLocalRing S]
    [IsAdicComplete (IsLocalRing.maximalIdeal S) S]
    (q : R →+* A) (v : S →+* E) (u : R →+* S)
    (hq : Function.Surjective q) (hv : Function.Surjective v)
    [IsLocalHom q] [IsLocalHom v] [IsLocalHom u]
    (hcomm : v.comp u = (algebraMap A E).comp q)
    (hres : ∃ e : (R ⧸ IsLocalRing.maximalIdeal R) ≃+*
        (A ⧸ IsLocalRing.maximalIdeal A),
      ∀ r : R, e (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) r) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) (q r))
    (hparams : ∃ (t : List R) (z : List S),
      IsLocalRing.IsRegularSystemOfParameters t ∧
      IsLocalRing.IsRegularSystemOfParameters (t.map u ++ z))
    (hfiber : IsRegularLocalRing (S ⧸ (IsLocalRing.maximalIdeal R).map u)) :
    ∃ (T : Type (max u v)) (_ : CommRing T) (_ : IsNoetherianRing T)
      (_ : IsLocalRing T) (_ : IsAdicComplete (IsLocalRing.maximalIdeal T) T)
      (_ : Algebra R T),
      IsLocalHom (algebraMap R T) ∧ (algebraMap R T).Flat ∧
      ∃ e : (T ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R T)) ≃+* E,
        (∀ r : R,
          e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (algebraMap R T))
            (algebraMap R T r)) = algebraMap A E (q r)) ∧
        (let f := algebraMap R T
         letI : Algebra R T := f.toAlgebra
         let I := (IsLocalRing.maximalIdeal R).map f
         letI : Algebra (R ⧸ IsLocalRing.maximalIdeal R) (T ⧸ I) :=
           Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
             IsLocalRing.maximalIdeal R ≤ I.comap (algebraMap R T))
         Algebra.FormallySmoothAdic (R ⧸ IsLocalRing.maximalIdeal R) (T ⧸ I)
           ((IsLocalRing.maximalIdeal T).map (Ideal.Quotient.mk I))) := by
  have _hq := hq
  have hregular : IsRegularLocalRing E :=
    Algebra.isRegularLocalRing_of_formallySmoothAdic (IsLocalRing.ResidueField A) E hE
  have hkill : (IsLocalRing.maximalIdeal R).map u ≤ RingHom.ker v := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    change v (u r) = 0
    have hc := RingHom.congr_fun hcomm r
    change v (u r) = algebraMap A E (q r) at hc
    rw [hc, IsScalarTower.algebraMap_apply A (IsLocalRing.ResidueField A) E]
    have hqr : q r ∈ IsLocalRing.maximalIdeal A := map_nonunit q r hr
    have hz : algebraMap A (IsLocalRing.ResidueField A) (q r) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hqr
    rw [hz, map_zero]
  obtain ⟨J, hJ, hker, t, ht, hseq⟩ :=
    exists_regular_fiber_kernel_parameter_quotient R S E u v hv hkill hparams hfiber
  let T := S ⧸ J
  have : Nontrivial T := Ideal.Quotient.nontrivial_iff.mpr hJ
  have : IsLocalRing T :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  let f : R →+* T := (Ideal.Quotient.mk J).comp u
  let : Algebra R T := f.toAlgebra
  have : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hf : IsLocalHom f := RingHom.isLocalHom_comp _ _
  have hflat : f.Flat := flat_of_regular_parameters f t.length t ht.2.symm rfl ht.1 hseq
  have hcomplete := (quotient_complete_local S J hJ).2.2.2
  let I := (IsLocalRing.maximalIdeal R).map f
  have hI : I = ((IsLocalRing.maximalIdeal R).map u).map (Ideal.Quotient.mk J) := by
    exact (Ideal.map_map _ _).symm
  let e : (T ⧸ I) ≃+* E :=
    ((Ideal.quotEquivOfEq hI).trans
      (DoubleQuot.quotQuotEquivQuotSup J ((IsLocalRing.maximalIdeal R).map u))).trans
      ((Ideal.quotEquivOfEq hker.symm).trans (v.quotientKerEquivOfSurjective hv))
  have he (s : S) : e (Ideal.Quotient.mk I (Ideal.Quotient.mk J s)) = v s := by
    change v.quotientKerEquivOfSurjective hv
      (Ideal.quotEquivOfEq hker.symm
        (DoubleQuot.quotQuotEquivQuotSup J ((IsLocalRing.maximalIdeal R).map u)
          (DoubleQuot.quotQuotMk J ((IsLocalRing.maximalIdeal R).map u) s))) = v s
    rw [DoubleQuot.quotQuotEquivQuotSup_quotQuotMk, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
  have hcompat (r : R) : e (Ideal.Quotient.mk I (f r)) = algebraMap A E (q r) := by
    rw [show f r = Ideal.Quotient.mk J (u r) from rfl, he]
    exact RingHom.congr_fun hcomm r
  refine ⟨T, inferInstance, inferInstance, inferInstance, hcomplete, inferInstance,
    hf, hflat, e, hcompat, ?_⟩
  obtain ⟨eR, heR⟩ := hres
  let K := R ⧸ IsLocalRing.maximalIdeal R
  let eR' : K ≃+* IsLocalRing.ResidueField A := eR
  let : Algebra K E :=
    ((algebraMap (IsLocalRing.ResidueField A) E).comp eR.toRingHom).toAlgebra
  have hEK : Algebra.FormallySmoothAdic K E (IsLocalRing.maximalIdeal E) :=
    hE.of_ringEquiv eR' (IsLocalRing.maximalIdeal E)
  let : Algebra K (T ⧸ I) :=
    Ideal.Quotient.algebraQuotientOfLEComap
      (Ideal.le_comap_map : IsLocalRing.maximalIdeal R ≤ I.comap (algebraMap R T))
  let ealg : (T ⧸ I) ≃ₐ[K] E :=
    { e with
      commutes' := by
        intro r
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        change e (Ideal.Quotient.mk I (f r)) =
          algebraMap (IsLocalRing.ResidueField A) E
            (eR (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) r))
        rw [hcompat, heR]
        exact IsScalarTower.algebraMap_apply A (IsLocalRing.ResidueField A) E (q r) }
  have : IsLocalRing (T ⧸ I) := e.symm.isLocalRing
  have hmax : (IsLocalRing.maximalIdeal E).map e.symm.toRingHom =
      (IsLocalRing.maximalIdeal T).map (Ideal.Quotient.mk I) := by
    exact (IsLocalRing.map_ringEquiv_maximalIdeal e.symm).trans
      (IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm
  change Algebra.FormallySmoothAdic K (T ⧸ I)
    ((IsLocalRing.maximalIdeal T).map (Ideal.Quotient.mk I))
  intro D _ _ L hL g hg
  let g' := g.comp ealg.symm.toAlgHom
  obtain ⟨k, hk, hgk⟩ := hg
  have hg' : ∃ k : ℕ, 1 ≤ k ∧
      ∀ x ∈ (IsLocalRing.maximalIdeal E) ^ k, g' x = 0 := by
    refine ⟨k, hk, ?_⟩
    intro x hx
    apply hgk
    rw [← hmax, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem e.symm.toRingHom hx
  obtain ⟨l, hl⟩ := hEK L hL g' hg'
  refine ⟨l.comp ealg.toAlgHom, ?_⟩
  ext x
  have hx := DFunLike.congr_fun hl (ealg x)
  simpa [g'] using hx

end RingHom
