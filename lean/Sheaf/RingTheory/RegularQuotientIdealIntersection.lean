import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Ideal intersection for a sequence regular modulo an ideal

Source: Stacks Project, More on Algebra, Tag 0665, specialized using Tags 062F and 0CEM
(blueprint: lem-weil-pbc-regular-quotient-ideal-intersection).
-/

universe u

namespace Ideal

/-- If the images of a finite sequence `gs` in `R/I` form a regular sequence, the
intersection of `I` with the ideal generated by `gs` is their ideal product.
Source: Stacks Project, More on Algebra, Tags 0665, 062F and 0CEM
(blueprint: lem-weil-pbc-regular-quotient-ideal-intersection).

Proof:
1. Regularity of the images (def-weil-pbc-regular-sequence) implies Koszul regularity
   by lem-weil-pbc-regular-sequence-koszul-regular (Tag 062F), hence H₁-regularity
   by Tag 0CEM and def-weil-pbc-koszul-regular-sequence.
2. In degrees zero, one and two, the Koszul complex (def-weil-pbc-koszul-complex)
   has terms `R`, the free module on `eᵢ`, and the free module on `eᵢ ∧ eⱼ`.
   Its differentials send `eᵢ` to `gᵢ` and `eᵢ ∧ eⱼ` to `gᵢ eⱼ - gⱼ eᵢ`.
   Reducing coordinates modulo `I` gives surjective chain maps, whose degree-one
   kernel consists of vectors with coordinates in `I`.
3. Given `x ∈ I ∩ (gs)`, choose a degree-one vector `a` with differential `x`.
   Its reduction is a cycle. Since H₁ of the quotient Koszul complex vanishes,
   that reduction is the differential of a degree-two vector `β`. Lift `β` to `b`.
   Then `c = a - d₂(b)` has coordinates in `I`, and `d₁(c) = x` because `d₁ d₂ = 0`.
   Thus `x` is a linear combination of the generators with coefficients in `I`,
   and belongs to `I * (gs)`.
4. Conversely, the product ideal is contained in both factors, so in their intersection.
   For the empty sequence both sides are the zero ideal. -/
theorem inf_ofList_eq_mul_of_regular_quotient {R : Type u} [CommRing R]
    (I : Ideal R) (gs : List R)
    (hgs : RingTheory.Sequence.IsRegular (R ⧸ I) (gs.map (Ideal.Quotient.mk I))) :
    I ⊓ Ideal.ofList gs = I * Ideal.ofList gs := by
  sorry

end Ideal
