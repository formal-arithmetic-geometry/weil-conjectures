module

public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.LinearAlgebra.Basis.Defs

/-! # Clearing the relations on one conormal chart

Source: Stacks Project, Tag 07CP, preparation (3)--(4).
(blueprint: lem-weil-pbc-popescu-clear-conormal-chart).
-/

@[expose] public section

universe u

namespace Algebra

/-- A selected conormal basis can be refined to exact polynomial relations modulo π².

Source: Stacks Project, Tag 07CP, proof between preparations (2) and (4).
(blueprint: lem-weil-pbc-popescu-clear-conormal-chart).

Proof: Write Pbar = (R/π²)[x], I = (reduced f), and I_E = (reduced f_j, j in E).
Localize Pbar at the reduction of a0. The basis hypothesis implies
I = I_E + I² after this localization. Thus the finite module M = I/I_E satisfies
M = IM. Nakayama (Tag 00DV) gives an annihilator e with e-1 in the localized I.
Write e = 1+b/a0^N, with b in I, clearing its denominator, and lift b to a linear
combination of the original f_j. Replace a0 by a0*(a0^N+b). In Pbar/I its value
is the positive power val(a0)^(N+1), and in the polynomial localization the
annihilator is invertible, so I and I_E become equal. For each of the finitely
many f_l, express its reduction in I_E after localization. Clear the coefficient
denominators and the residual localization kernel. Take a common positive exponent
t for these finitely many identities, and replace the new element by its t-th power.
Lift each coefficient to R[x]. The residual polynomial maps to zero under reduction,
so it lies in the principal ideal generated by C(π²), giving the polynomial g_l.
The final image in Pbar/I is a positive power of val(a0). Localization at a positive
power is canonically the same algebra as localization at the original element;
transport smoothness, the prescribed conormal basis, and the differential basis
along these canonical localization equivalences. The conormal generators are preserved
by those equivalences. When m=0 there are no identities to clear; use exponent 1.
When E is empty Nakayama still applies, and every localized f_l vanishes. The same
argument also works in the zero ring and when π is zero or a unit. -/
theorem exists_popescu_cleared_conormal_chart
    {R : Type u} [CommRing R] (π : R) (n m : ℕ)
    (f : Fin m → MvPolynomial (Fin n) R)
    (a0 : MvPolynomial (Fin n) R) (E : Finset (Fin m)) :
    let red := MvPolynomial.map (Ideal.Quotient.mk (Ideal.span ({π ^ 2} : Set R)))
    let I := Ideal.span (Set.range (fun j ↦ red (f j)))
    let val := fun a ↦ Ideal.Quotient.mk I (red a)
    Smooth (R ⧸ Ideal.span ({π ^ 2} : Set R)) (Localization.Away (val a0)) →
    (∃ b : Module.Basis E (Localization.Away (val a0))
        (LocalizedModule.Away (val a0) I.Cotangent),
      ∀ j : E, b j = LocalizedModule.mkLinearMap (Submonoid.powers (val a0))
        I.Cotangent (I.toCotangent ⟨red (f j), Ideal.subset_span ⟨j, rfl⟩⟩)) →
    Nonempty (Module.Basis (Fin (n - E.card)) (Localization.Away (val a0))
      (KaehlerDifferential (R ⧸ Ideal.span ({π ^ 2} : Set R)) (Localization.Away (val a0)))) →
    ∃ (a : MvPolynomial (Fin n) R)
      (h : Fin m → Fin m → MvPolynomial (Fin n) R)
      (g : Fin m → MvPolynomial (Fin n) R) (s : ℕ),
      0 < s ∧ val a = val a0 ^ s ∧
      Smooth (R ⧸ Ideal.span ({π ^ 2} : Set R)) (Localization.Away (val a)) ∧
      (∃ b : Module.Basis E (Localization.Away (val a))
        (LocalizedModule.Away (val a) I.Cotangent),
      ∀ j : E, b j = LocalizedModule.mkLinearMap (Submonoid.powers (val a))
        I.Cotangent (I.toCotangent ⟨red (f j), Ideal.subset_span ⟨j, rfl⟩⟩)) ∧
      Nonempty (Module.Basis (Fin (n - E.card)) (Localization.Away (val a))
      (KaehlerDifferential (R ⧸ Ideal.span ({π ^ 2} : Set R)) (Localization.Away (val a)))) ∧
      ∀ l : Fin m,
        a * f l = ∑ j ∈ E, h l j * f j + MvPolynomial.C (π ^ 2) * g l := by sorry

end Algebra
