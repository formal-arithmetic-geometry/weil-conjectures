module

public import Sheaf.RingTheory.PopescuLiftPresentation
import Sheaf.RingTheory.PopescuSpecialChartInjective
import Sheaf.RingTheory.PopescuSpecialChartSurjective

/-! # Polynomial model of a prepared lifting chart

Source: Stacks Project, Tag 07CP, polynomial chart calculation and comparison of charts.
(blueprint: lem-weil-pbc-popescu-special-chart-polynomial).
-/

@[expose] public section

universe a c b

namespace Algebra

/-- The prepared special chart is a polynomial algebra over the localized coefficient
quotient. Source: Stacks Project, Tag 07CP, displayed calculation of the chart modulo pi
and coefficient comparison for the other charts.
(blueprint: lem-weil-pbc-popescu-special-chart-polynomial).

Proof: Modulo pi all the f_l vanish. Invert a_k and solve the k-th chart relations for
z_l outside E_k, by z_l = a_k inverse times the sum of h_klj z_j over j in E_k.
Normalized coefficients make the relations for l in E_k identically zero. For each
other chart k', compare the two expressions for a_k a_k' f_l in the reduced conormal
module. Its basis of f_j for j in E_k forces the coefficient
b_j = a_k' h_klj - sum over j' in E_k' of h_k'lj' h_kj'j to vanish in Cbar[1/a_k].
Clear its localization denominator. The resulting multiple lies in the kernel of
localized epsilon, namely the ideal generated by the reduced f_l. Modulo pi every
f_l vanishes, so the b_j vanish after localization of the coefficient quotient.
Substitution therefore kills the remaining chart relations. The substitution map
and the map sending the free variables to the corresponding z_j are inverse: check
original x_i, free z_j, and eliminated z_l using their equations. Surjectivity and
kernel of epsilon identify the coefficient quotient. The equations hc and hcmod
identify its structural map with cmod. Transport the quotient through ULift. -/
theorem popescu_special_chart_polynomial (R : Type a) (Cbar : Type c)
    [CommRing R] [CommRing Cbar] [Algebra R Cbar] (π : R)
    [Algebra (R ⧸ Ideal.span ({π ^ 2} : Set R)) Cbar]
    [IsScalarTower R (R ⧸ Ideal.span ({π ^ 2} : Set R)) Cbar]
    (d : PopescuLiftPresentation R Cbar π) (hd : d.Prepared)
    (c : Cbar →ₐ[R] (d.liftingAlgebra ⧸
      Ideal.span ({algebraMap R d.liftingAlgebra π} : Set d.liftingAlgebra)))
    (cmod : (Cbar ⧸ Ideal.span ({algebraMap R Cbar π} : Set Cbar)) →+*
      (d.liftingAlgebra ⧸
        Ideal.span ({algebraMap R d.liftingAlgebra π} : Set d.liftingAlgebra)))
    (hc : ∀ i : Fin d.n, c (d.ε (MvPolynomial.X i)) = Ideal.Quotient.mk _ (d.x i))
    (hcmod : cmod.comp (Ideal.Quotient.mk _) = c.toRingHom)
    (k : Fin d.r) :
    let C₀ := Cbar ⧸ Ideal.span ({algebraMap R Cbar π} : Set Cbar)
    letI := cmod.toAlgebra
    Nonempty (MvPolynomial (d.E k)
      (Localization.Away (Ideal.Quotient.mk
        (Ideal.span ({algebraMap R Cbar π} : Set Cbar)) (d.ε (d.reduced (d.a k))))) ≃ₐ[C₀]
      Localization.Away (c (d.ε (d.reduced (d.a k))))) := by
  let C₀ := Cbar ⧸ Ideal.span ({algebraMap R Cbar π} : Set Cbar)
  let := cmod.toAlgebra
  exact ⟨AlgEquiv.ofBijective (popescu_special_chart_map R Cbar π d c cmod hcmod k)
    ⟨popescu_special_chart_map_injective R Cbar π d hd c cmod hc hcmod k,
      popescu_special_chart_map_surjective R Cbar π d c cmod hc hcmod k⟩⟩

end Algebra
