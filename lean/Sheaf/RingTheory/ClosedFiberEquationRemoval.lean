/-! # Removing the equations of a regular closed fibre

Source: Stacks Project, Tag 07NQ, proof of (2) implies (3), through the isomorphism
S tensor_R A -> B. (blueprint: lem-weil-pbc-flat-closed-fibre-power-series-model)
-/

@[expose] public section

universe u v w

open IsLocalRing

namespace RingHom

private theorem quotient_parameters
    {S : Type w} [CommRing S] [IsRegularLocalRing S] (x a : List S)
    (h : IsRegularSystemOfParameters (x ++ a)) :
    ∃ (_ : IsRegularLocalRing (S ⧸ Ideal.ofList x)),
      IsRegularSystemOfParameters (a.map (Ideal.Quotient.mk (Ideal.ofList x))) := by
  have hq := (IsRegularLocalRing.isRegular_and_quotients_of_generators
    S (x ++ a).length h.2.symm (x ++ a) h).2.1 x.length (by simp)
  rw [List.take_left] at hq
  let := hq.1
  refine ⟨hq.1, ?_, ?_⟩
  · rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk (Ideal.ofList x))
      Ideal.Quotient.mk_surjective, ← h.1]
    change Ideal.ofList _ = (Ideal.ofList (x ++ a)).map _
    rw [Ideal.ofList_append, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
      Ideal.map_ofList]
  · simpa only [List.length_map, List.length_append, Nat.add_sub_cancel_left] using hq.2.symm

private theorem parameters_equiv
    {S T : Type w} [CommRing S] [CommRing T]
    [IsRegularLocalRing S] [IsRegularLocalRing T]
    (e : S ≃+* T) (a : List S) (h : IsRegularSystemOfParameters a) :
    IsRegularSystemOfParameters (a.map e) := by
  constructor
  · rw [← map_ringEquiv_maximalIdeal e, ← h.1]
    exact (Ideal.map_ofList e.toRingHom a).symm
  · rw [List.length_map, h.2, ringKrullDim_eq_of_ringEquiv e]

/-- Removing the regular closed-fibre equations gives a power-series presentation with
no extra kernel on the closed fibre. This construction uses no flatness of A -> B.
It does not identify the kernel over A; that is a separate flatness/Nakayama argument.

Source: Stacks Project, Tag 07NQ, proof of (2) implies (3), from the compatible
presentation through the replacement S/(x_1,...,x_r); Tags 00NR and 07NM.
(blueprint: lem-weil-pbc-closed-fibre-equation-removal)

Proof: Apply the closed-fibre kernel-parameter selection theorem to obtain x,y
with (x,i(t),y) a full regular parameter system, (x) contained in ker b, and
ker(S -> B/m_A B) = (x) + m_R S. Put Q = S/(x). The initial-parameter
quotient theorem makes Q regular local and gives the correct dimension.
Its maximal ideal is generated by the images of (i(t),y), so these are again
parameters. Descend b to a surjection Q -> B and i to a local map R -> Q.
For field coefficients apply the field parameter-quotient equivalence of Tag
07NM. For Cohen coefficients write t=p::ts using the head hypothesis; i(p)=p,
so permuting p ahead of x gives the system required by the Cohen clause of
Tag 07NM. This identifies Q with a power-series ring T over Lambda_S.
Transport the maps and parameters to T along this equivalence. The fibre-composite
kernel identity transports to ker(T -> B/m_A B)=m_R T, proving the stated
containment for ker v. The residue-field map of q is bijective because q is
surjective local. The quotient-kernel equivalence identifies T/m_R T with
B/m_A B, compatibly over these residue fields. Transfer formal smoothness
along the residue-field equivalence. Precompose a test map with the inverse
fibre equivalence, transfer its positive-power vanishing using the equality
of maximal ideals, apply the universe-lifting theorem to obtain a lift, and
compose back. This proves the required lifting property. No flatness is used.
Empty equation lists give the zero ideal; zero-dimensional parameter lists
and power series in zero variables are allowed. In the Cohen case p is retained
as the coefficient parameter. -/
theorem exists_closedFiber_equation_removal
    (A : Type u) (B : Type v) [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B]
    (f : A →+* B) [IsLocalHom f]
    (ΛR ΛS : Type w) [CommRing ΛR] [CommRing ΛS] (n m : ℕ)
    [IsRegularLocalRing (MvPowerSeries (Fin n) ΛR)]
    [IsRegularLocalRing (MvPowerSeries (Fin m) ΛS)]
    (q : MvPowerSeries (Fin n) ΛR →+* A) [IsLocalHom q]
    (b : MvPowerSeries (Fin m) ΛS →+* B) [IsLocalHom b]
    (i : MvPowerSeries (Fin n) ΛR →+* MvPowerSeries (Fin m) ΛS) [IsLocalHom i]
    (hq : Function.Surjective q) (hb : Function.Surjective b)
    (hcomm : b.comp i = f.comp q)
    (t : List (MvPowerSeries (Fin n) ΛR))
    (z : List (MvPowerSeries (Fin m) ΛS))
    (ht : IsRegularSystemOfParameters t)
    (hz : IsRegularSystemOfParameters (t.map i ++ z))
    (hcoeff : (IsField ΛR ∧ IsField ΛS ∧ CharZero ΛR ∧ CharZero ΛS) ∨
      ∃ p : ℕ, p.Prime ∧ IsCohenRing p ΛR ∧ IsCohenRing p ΛS ∧
        t.head? = some (p : MvPowerSeries (Fin n) ΛR)) :
    letI : Algebra A B := f.toAlgebra
    let I : Ideal B := Ideal.map f (maximalIdeal A)
    letI : Algebra (A ⧸ maximalIdeal A) (B ⧸ I) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
        maximalIdeal A ≤ I.comap (algebraMap A B))
    Algebra.FormallySmoothAdic (A ⧸ maximalIdeal A) (B ⧸ I)
        (Ideal.map (Ideal.Quotient.mk I) (maximalIdeal B)) →
    ∃ m' : ℕ, let T := MvPowerSeries (Fin m') ΛS
      ∃ (_ : IsRegularLocalRing T)
        (v : T →+* B) (j : MvPowerSeries (Fin n) ΛR →+* T),
        Function.Surjective v ∧ IsLocalHom j ∧
        v.comp j = f.comp q ∧ RingHom.ker v ≤ (maximalIdeal (MvPowerSeries (Fin n) ΛR)).map j ∧
        ∃ y : List T, IsRegularSystemOfParameters (t.map j ++ y) ∧
          (let R := MvPowerSeries (Fin n) ΛR
           letI : Algebra R T := j.toAlgebra
           let L : Ideal T := (maximalIdeal R).map j
           letI : Algebra (R ⧸ maximalIdeal R) (T ⧸ L) :=
             Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
               maximalIdeal R ≤ L.comap (algebraMap R T))
           Algebra.FormallySmoothAdic (R ⧸ maximalIdeal R) (T ⧸ L)
             ((maximalIdeal T).map (Ideal.Quotient.mk L))) := by
  dsimp only
  intro hsmooth
  let R := MvPowerSeries (Fin n) ΛR
  let S := MvPowerSeries (Fin m) ΛS
  let : Algebra A B := f.toAlgebra
  let I := (maximalIdeal A).map f
  let : Algebra (A ⧸ maximalIdeal A) (B ⧸ I) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map :
      maximalIdeal A ≤ I.comap (algebraMap A B))
  obtain ⟨x, y, hparams, hx, hker⟩ :=
    exists_closedFiber_kernel_parameters A B R S f q b i hq hb hcomm t z ht hz hsmooth
  let J := Ideal.ofList x
  let Q := S ⧸ J
  let π := Ideal.Quotient.mk J
  obtain ⟨hQ, hQparams⟩ := quotient_parameters x (t.map i ++ y) hparams
  let := hQ
  let bQ : Q →+* B := Ideal.Quotient.lift J b hx
  have hbQ : Function.Surjective bQ :=
    Ideal.Quotient.lift_surjective_of_surjective J hx hb
  let jQ : R →+* Q := π.comp i
  have : IsLocalHom π := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have : IsLocalHom jQ := RingHom.isLocalHom_comp _ _
  have he : ∃ d : ℕ, Nonempty (MvPowerSeries (Fin d) ΛS ≃+* Q) := by
    rcases hcoeff with hfield | ⟨p, _, _, hcohen, hp⟩
    · let := hfield.2.1.toField
      obtain ⟨_, _, e, _⟩ :=
        MvPowerSeries.exists_algEquiv_quotient_parameters_field ΛS m x (t.map i ++ y)
          hparams
      exact ⟨(t.map i ++ y).length, ⟨e.toRingEquiv⟩⟩
    · have hcohen' := hcohen
      obtain ⟨_, hdom, hdvr, _, _⟩ := hcohen'
      let := hdom
      let := hdvr
      cases t with
      | nil => simp at hp
      | cons r ts =>
        have hr : r = (p : R) := by simpa using hp
        subst r
        have hparams' : IsRegularSystemOfParameters
            (MvPowerSeries.C (p : ΛS) :: (x ++ (ts.map i ++ y))) := by
          have hperm : (x ++ (((p : R) :: ts).map i ++ y)).Perm
              (MvPowerSeries.C (p : ΛS) :: (x ++ (ts.map i ++ y))) := by
            simp only [List.map_cons, map_natCast, List.cons_append]
            exact (List.perm_middle (a := (p : S)) (l₁ := x)
              (l₂ := ts.map i ++ y))
          exact (IsRegularLocalRing.isRegular_and_quotients_of_generators
            S _ hparams.2.symm _ hparams).2.2 _ hperm |>.1
        obtain ⟨_, _, e, _⟩ :=
          MvPowerSeries.exists_algEquiv_quotient_parameters_cohen ΛS p m hcohen x
            (ts.map i ++ y) hparams'
        exact ⟨(ts.map i ++ y).length, ⟨e.toRingEquiv⟩⟩
  obtain ⟨d, ⟨e⟩⟩ := he
  let T := MvPowerSeries (Fin d) ΛS
  have hT : IsRegularLocalRing T := IsRegularLocalRing.of_ringEquiv e.symm
  let := hT
  let v : T →+* B := bQ.comp e.toRingHom
  let j : R →+* T := e.symm.toRingHom.comp jQ
  have hv : Function.Surjective v := hbQ.comp e.surjective
  have : IsLocalHom e.symm.toRingHom := IsLocalHom.of_surjective _ e.symm.surjective
  have hj : IsLocalHom j := RingHom.isLocalHom_comp _ _
  have hcomm' : v.comp j = f.comp q := by
    ext r
    change bQ (e (e.symm (π (i r)))) = f (q r)
    rw [e.apply_symm_apply]
    exact RingHom.congr_fun hcomm r
  have hparamT : IsRegularSystemOfParameters (t.map j ++ y.map (e.symm ∘ π)) := by
    convert parameters_equiv e.symm _ hQparams using 1
    simp only [List.map_append, List.map_map]
    rfl
  let L := (maximalIdeal R).map j
  let c : T →+* B ⧸ I := (Ideal.Quotient.mk I).comp v
  have hc : Function.Surjective c := Ideal.Quotient.mk_surjective.comp hv
  have hcL : RingHom.ker c = L := by
    have hQker : RingHom.ker ((Ideal.Quotient.mk I).comp bQ) =
        (maximalIdeal R).map jQ := by
      apply (Ideal.comap_injective_of_surjective π Ideal.Quotient.mk_surjective)
      rw [RingHom.comap_ker]
      change RingHom.ker ((Ideal.Quotient.mk I).comp b) = _
      rw [hker]
      change J ⊔ (maximalIdeal R).map i =
        ((maximalIdeal R).map (π.comp i)).comap π
      rw [← Ideal.map_map, Ideal.comap_map_quotientMk, sup_comm]
    rw [show c = ((Ideal.Quotient.mk I).comp bQ).comp e.toRingHom from rfl,
      ← RingHom.comap_ker, hQker]
    change ((maximalIdeal R).map jQ).comap e.toRingHom =
      (maximalIdeal R).map (e.symm.toRingHom.comp jQ)
    rw [← Ideal.map_map jQ e.symm.toRingHom]
    exact (Ideal.map_comap_of_equiv e.symm).symm
  have hker' : RingHom.ker v ≤ L := by
    rw [← hcL]
    intro a ha
    change Ideal.Quotient.mk I (v a) = 0
    rw [show v a = 0 from ha, map_zero]
  refine ⟨d, hT, v, j, hv, hj, hcomm', hker', y.map (e.symm ∘ π), hparamT, ?_⟩
  let : Algebra R T := j.toAlgebra
  let K := R ⧸ maximalIdeal R
  let : Algebra K (T ⧸ L) :=
    Ideal.Quotient.algebraQuotientOfLEComap
      (Ideal.le_comap_map : maximalIdeal R ≤ L.comap (algebraMap R T))
  let qr := ResidueField.map q
  have hqr : Function.Surjective qr := by
    intro a
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨r, rfl⟩ := hq a
    exact ⟨Ideal.Quotient.mk (maximalIdeal R) r, rfl⟩
  let er : K ≃+* (A ⧸ maximalIdeal A) := RingEquiv.ofBijective qr ⟨qr.injective, hqr⟩
  let E := B ⧸ I
  have hIm : I ≤ maximalIdeal B := Ideal.map_le_iff_le_comap.mpr (by
    intro a ha
    exact map_nonunit f a ha)
  have hIne : I ≠ ⊤ := ne_top_of_le_ne_top (maximalIdeal.isMaximal B).ne_top hIm
  have : Nontrivial E := Ideal.Quotient.nontrivial_iff.mpr hIne
  have : IsLocalRing E := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have hE : Algebra.FormallySmoothAdic (A ⧸ maximalIdeal A) E (maximalIdeal E) := by
    rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective]
    exact hsmooth
  let : Algebra K E := ((algebraMap (A ⧸ maximalIdeal A) E).comp er.toRingHom).toAlgebra
  have hEK : Algebra.FormallySmoothAdic K E (maximalIdeal E) :=
    hE.of_ringEquiv er (maximalIdeal E)
  let eF : (T ⧸ L) ≃+* E := (Ideal.quotEquivOfEq hcL.symm).trans
    (c.quotientKerEquivOfSurjective hc)
  have heF (a : T) : eF (Ideal.Quotient.mk L a) = c a := by
    change c.quotientKerEquivOfSurjective hc
      (Ideal.quotEquivOfEq hcL.symm (Ideal.Quotient.mk L a)) = c a
    rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  let ealg : (T ⧸ L) ≃ₐ[K] E :=
    { eF with
      commutes' := by
        intro r
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        change eF (Ideal.Quotient.mk L (j r)) = Ideal.Quotient.mk I (f (q r))
        rw [heF]
        change Ideal.Quotient.mk I (v (j r)) = Ideal.Quotient.mk I (f (q r))
        rw [show v (j r) = f (q r) from RingHom.congr_fun hcomm' r] }
  have : IsLocalRing (T ⧸ L) := eF.symm.isLocalRing
  have hmax : (maximalIdeal E).map eF.symm.toRingHom =
      (maximalIdeal T).map (Ideal.Quotient.mk L) :=
    (map_ringEquiv_maximalIdeal eF.symm).trans
      (map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm
  change Algebra.FormallySmoothAdic K (T ⧸ L)
    ((maximalIdeal T).map (Ideal.Quotient.mk L))
  intro D _ _ H hH g hg
  let g' := g.comp ealg.symm.toAlgHom
  obtain ⟨k, hk, hgk⟩ := hg
  have hg' : ∃ k : ℕ, 1 ≤ k ∧ ∀ a ∈ (maximalIdeal E) ^ k, g' a = 0 := by
    refine ⟨k, hk, ?_⟩
    intro a ha
    apply hgk
    rw [← hmax, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem eF.symm.toRingHom ha
  obtain ⟨l, hl⟩ := Algebra.formallySmoothAdic_lift_universe K E (maximalIdeal E)
    hEK D H hH g' hg'
  refine ⟨l.comp ealg.toAlgHom, ?_⟩
  ext a
  have ha := DFunLike.congr_fun hl (ealg a)
  simpa [g'] using ha



end RingHom
