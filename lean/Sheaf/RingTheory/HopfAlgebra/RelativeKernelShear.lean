module

public import Mathlib.RingTheory.HopfAlgebra.Quotient

/-! # Relative Hopf kernel shear isomorphisms

Source: Milne, Algebraic Groups (2017), Exercises 2-1 and 2-2, printed pp. 61--62,
Proposition 3.12, p. 67, and the two diagrams of Theorem 3.31, p. 74.
(blueprint: lem-sfb-hopf-relative-kernel-shear)
-/

@[expose] public section

universe u v w z

open scoped TensorProduct

namespace HopfAlgebra

/-- The ideal generated by the image of the augmentation ideal under a Hopf map.
It is the ideal denoted `v(C⁺)X` in the relative kernel construction.

Source: Milne, Algebraic Groups (2017), Proposition 3.12 and Theorem 3.31.
(blueprint: lem-sfb-hopf-relative-kernel-shear). -/
def relativeKernelIdeal {k : Type u} {C : Type v} {X : Type w}
    [Field k] [CommRing C] [CommRing X] [HopfAlgebra k C] [HopfAlgebra k X]
    (v : C →ₐc[k] X) : Ideal X :=
  (RingHom.ker (Bialgebra.counitAlgHom k C)).map v.toAlgHom.toRingHom

/-- The kernel quotients have their induced Hopf structures, and the two relative
shears are isomorphisms of `B`-algebras for the second-factor actions. The formulas
are asserted for every finite presentation of a comultiplication, including the
empty presentation. Inverse formulas quantify over every lift of the quotient element.
The final equality is the naturality square on the entire relative tensor product.
The two structure-map equalities specify exactly the `C`-algebras through `u` and `i ∘ u`.

Source: Milne, Algebraic Groups (2017), Exercises 2-1 and 2-2, printed pp. 61--62,
Proposition 3.12, p. 67, and the two diagrams of Theorem 3.31, p. 74.
(blueprint: lem-sfb-hopf-relative-kernel-shear).

Proof plan:
1. For either `(X,v,h) = (A,u,i)` or `(B,i ∘ u,id)`, put `I = v(C⁺)X` and
   `q : X → X/I`. The identity `q(v(c)) = ε(c)` and `ε(S(c)) = ε(c)` show that
   `(q ⊗ q)Δ`, `ε`, and `qS` kill the generators of `I` and hence all of `I`.
   Use def-weil-pbc-algebra-hom-quotient for the quotient maps.
2. Descend these maps to `X/I`; the Hopf axioms follow after the surjection `q`
   from the axioms on `X`. These are precisely Mathlib's Hopf-ideal quotient structures.
3. The map `i` carries generators of the first ideal into the second, and so descends
   to `α`. Its coalgebra and antipode compatibilities follow on quotient representatives.
4. The algebra map `(q ⊗ h)Δ` agrees on `C` with `b ↦ 1 ⊗ b`; by
   lem-weil-pbc-algebra-tensor-pushout-universal-property it defines `Φ_X` over `B`.
5. The algebra map `T(x) = ∑ x₁ ⊗ h(S(x₂))` satisfies `T(v(c)) = ε(c)(1 ⊗ 1)`
   by balancing and the antipode equation. Thus it descends to `X/I`. The same tensor
   universal property gives `Ψ_X(q(x) ⊗ b) = ∑ x₁ ⊗ h(S(x₂))b`, independent of lifts.
6. Coassociativity gives `Ψ_X Φ_X(x ⊗ b) = ∑ x₁ ⊗ h(S(x₂)x₃)b = x ⊗ b`
   and `Φ_X Ψ_X(q(x) ⊗ b) = ∑ q(x₁) ⊗ h(x₂S(x₃))b = q(x) ⊗ b` by the two
   antipode identities and counitality. Additivity extends these identities everywhere.
7. Specialize to both triples. On `a ⊗ b`, compatibility of `i` with comultiplication
   and `α(q_A(a)) = q_B(i(a))` proves the square. Tensor additivity extends it to all
   tensors. No injectivity, flatness, finite type, or surjectivity of `u` or `i` is used. -/
theorem exists_relativeKernelShear
    (k : Type u) (C : Type v) (A : Type w) (B : Type z)
    [Field k] [CommRing C] [CommRing A] [CommRing B]
    [HopfAlgebra k C] [HopfAlgebra k A] [HopfAlgebra k B]
    (u : C →ₐc[k] A) (i : A →ₐc[k] B)
    (huS : ∀ c : C, u (antipode k c) = antipode k (u c))
    (hiS : ∀ a : A, i (antipode k a) = antipode k (i a))
    [Algebra C A] [Algebra C B]
    (hu : algebraMap C A = u.toAlgHom.toRingHom)
    (hiu : algebraMap C B = (i.comp u).toAlgHom.toRingHom) :
    (relativeKernelIdeal u).IsHopfIdeal k ∧
    (relativeKernelIdeal (i.comp u)).IsHopfIdeal k ∧
    ∀ [hD : (relativeKernelIdeal u).IsHopfIdeal k]
      [hE : (relativeKernelIdeal (i.comp u)).IsHopfIdeal k],
    ∃ α : (A ⧸ relativeKernelIdeal u) →ₐc[k] (B ⧸ relativeKernelIdeal (i.comp u)),
      (∀ a : A, α (Ideal.Quotient.mk (relativeKernelIdeal u) a) =
        Ideal.Quotient.mk (relativeKernelIdeal (i.comp u)) (i a)) ∧
      (∀ d : A ⧸ relativeKernelIdeal u, α (antipode k d) = antipode k (α d)) ∧
      ∃ ΦA : @AlgEquiv B (A ⊗[C] B) ((A ⧸ relativeKernelIdeal u) ⊗[k] B) _ _ _
          (Algebra.TensorProduct.rightAlgebra (R := C))
          (Algebra.TensorProduct.rightAlgebra (R := k)),
      ∃ ΦB : @AlgEquiv B (B ⊗[C] B) ((B ⧸ relativeKernelIdeal (i.comp u)) ⊗[k] B)
          _ _ _ (Algebra.TensorProduct.rightAlgebra (R := C))
          (Algebra.TensorProduct.rightAlgebra (R := k)),
        (∀ (a : A) (b : B) (n : ℕ) (l r : Fin n → A),
          Coalgebra.comul a = ∑ j, l j ⊗ₜ[k] r j →
          ΦA (a ⊗ₜ[C] b) =
            ∑ j, Ideal.Quotient.mk (relativeKernelIdeal u) (l j) ⊗ₜ[k] (i (r j) * b)) ∧
        (∀ (x b : B) (n : ℕ) (l r : Fin n → B),
          Coalgebra.comul x = ∑ j, l j ⊗ₜ[k] r j →
          ΦB (x ⊗ₜ[C] b) = ∑ j,
            Ideal.Quotient.mk (relativeKernelIdeal (i.comp u)) (l j) ⊗ₜ[k] (r j * b)) ∧
        (∀ (a : A) (b : B) (n : ℕ) (l r : Fin n → A),
          Coalgebra.comul a = ∑ j, l j ⊗ₜ[k] r j →
          (@AlgEquiv.symm B _ _ _ _ _
            (Algebra.TensorProduct.rightAlgebra (R := C))
            (Algebra.TensorProduct.rightAlgebra (R := k)) ΦA)
              (Ideal.Quotient.mk (relativeKernelIdeal u) a ⊗ₜ[k] b) =
            ∑ j, l j ⊗ₜ[C] (i (antipode k (r j)) * b)) ∧
        (∀ (x b : B) (n : ℕ) (l r : Fin n → B),
          Coalgebra.comul x = ∑ j, l j ⊗ₜ[k] r j →
          (@AlgEquiv.symm B _ _ _ _ _
            (Algebra.TensorProduct.rightAlgebra (R := C))
            (Algebra.TensorProduct.rightAlgebra (R := k)) ΦB)
              (Ideal.Quotient.mk (relativeKernelIdeal (i.comp u)) x ⊗ₜ[k] b) =
            ∑ j, l j ⊗ₜ[C] (antipode k (r j) * b)) ∧
        ∃ aᵢ : (A ⊗[C] B) →ₐ[C] (B ⊗[C] B),
          (∀ (a : A) (b : B), aᵢ (a ⊗ₜ[C] b) = i a ⊗ₜ[C] b) ∧
          ∀ t : A ⊗[C] B, ΦB (aᵢ t) =
            Algebra.TensorProduct.map α.toAlgHom (AlgHom.id k B) (ΦA t) := by
  sorry

end HopfAlgebra
