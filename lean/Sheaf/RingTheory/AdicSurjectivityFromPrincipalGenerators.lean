module

public import Mathlib.RingTheory.AdicCompletion.Basic

/-! # Adic surjectivity from principal generators

Source: Stacks Project, Algebra, Tag 090S (lemma-when-surjective-to-completion),
specialized to the ring as a module over itself.
(blueprint: lem-sfb-adic-surjectivity-from-principal-generators)
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace AdicCompletion

/-- Surjectivity to each principal-generator completion implies surjectivity to the
completion at the ideal generated by the whole finite family.

Source: Stacks Project, Algebra, Tag 090S (lemma-when-surjective-to-completion),
specialization `M = A`.
(blueprint: lem-sfb-adic-surjectivity-from-principal-generators)

Proof:
1. If `r = 0`, the generated ideal is zero. By def-weil-pbc-adic-completion its completion
   consists of constant compatible sequences in `A`, so the canonical map is surjective.
   For the remaining steps suppose `r` is positive and write `I` for the generated ideal.
2. For positive `n` put `J_n = (f_i^n)_i`. Then `J_n` is contained in `I^n`, and `I^(r*n)`
   is contained in `J_n`: expand ideal products as finite sums of generator monomials.
   In a monomial of degree `r*n` some generator occurs at least `n` times, since otherwise
   its degree is at most `r*(n-1) < r*n`.
3. Given a compatible family `xi` in the `I`-adic completion, choose `a_n` representing
   its coordinate at `r*n`, for positive `n`, using def-weil-pbc-adic-completion.
   Compatibility gives `a_(n+1) - a_n` in `I^(r*n)`, hence in `J_n`. Choose coefficients
   `x_(n,i)` with this difference equal to `sum_i f_i^n * x_(n,i)`. Finite telescoping
   gives `a_N = a_1 + sum_(n=1)^(N-1) sum_i f_i^n * x_(n,i)`.
4. Put `s_(i,N) = sum_(n=1)^(N-1) f_i^n * x_(n,i)`. For `M >= N`, the difference
   `s_(i,M) - s_(i,N)` lies in `f_i^N A`, as every summand has exponent at least `N`.
   Thus these residues form a principal compatible family by def-weil-pbc-adic-completion.
   Apply the corresponding surjectivity hypothesis to obtain `b_i` with
   `b_i - s_(i,N)` in `f_i^N A` for all positive `N`.
5. Set `a = a_1 + sum_i b_i`. Telescoping and interchanging finite sums give
   `a - a_N = sum_i (b_i - s_(i,N))` in `J_N`, hence in `I^N`. Since `r*N >= N`,
   compatibility makes `a_N` also represent `xi_N`. Equality at every positive coordinate
   proves that `a` maps to `xi`, by def-weil-pbc-adic-completion. No uniqueness of the
   principal lifts, cancellation, separatedness, Noetherianity or completeness is used.
-/
theorem of_surjective_of_principal_generators (A : Type u) [CommRing A]
    (r : ℕ) (f : Fin r → A)
    (h : ∀ i : Fin r, Function.Surjective (AdicCompletion.of (Ideal.span {f i}) A)) :
    Function.Surjective (AdicCompletion.of (Ideal.span (Set.range f)) A) := by
  sorry

end AdicCompletion
