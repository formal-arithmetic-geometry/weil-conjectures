import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.Finiteness.Defs

/-!
# Surjectivity of a finite local homomorphism from its cotangent map

Source: Stacks Project, Algebra, Tag 0E8M, with the finite-generation refinement in the DAG
(blueprint: lem-sc-point-tangent-finite-local-cotangent-surjective).
-/

universe u v w

namespace RingHom

/-- A finite local homomorphism inducing the identity on a common residue field and a
surjection on cotangent spaces is surjective. The equivalences `iA` and `iB` identify the two
residue fields with the common field `k`; `hres` says that the induced map is the identity
under these identifications. No coefficient-field embeddings in the rings are assumed.

Source: Stacks Project, Algebra, Tag 0E8M, with the refinement recorded in
(blueprint: lem-sc-point-tangent-finite-local-cotangent-surjective).

Proof:
1. Cotangent surjectivity says that every element of the maximal ideal `n` of `B` is
congruent modulo `n²` to the image of an element of the maximal ideal `m` of `A`.
Consequently `n = mB + n²`.
2. The quotient `B/mB` is finite-dimensional over `k`, since `B` is finite over `A`.
Its maximal ideal `n/mB` is therefore finitely generated, belongs to its Jacobson radical,
and equals its square by Step 1. Apply `lem-weil-pbc-nakayama-jacobson` to this ideal as a
module over `B/mB`: it vanishes. Thus `n = mB`.
3. The quotient `B/mB = B/n = k` is generated by the image of `1`. Apply
`lem-weil-pbc-nakayama-local-generators` to the finite `A`-module `B`: `1` generates `B`.
This is precisely surjectivity of the ring homomorphism. -/
theorem surjective_of_finite_of_cotangent
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] (f : A →+* B) [IsLocalHom f]
    (hfinite : f.Finite) (k : Type w) [Field k]
    (iA : IsLocalRing.ResidueField A ≃+* k)
    (iB : IsLocalRing.ResidueField B ≃+* k)
    (hres : iB.toRingHom.comp (IsLocalRing.ResidueField.map f) = iA.toRingHom)
    (hcot : Function.Surjective
      (Ideal.mapCotangent (IsLocalRing.maximalIdeal A) (IsLocalRing.maximalIdeal B)
        f.toIntAlgHom (fun a ha => map_nonunit f a ha))) :
    Function.Surjective f := by
  sorry

end RingHom
