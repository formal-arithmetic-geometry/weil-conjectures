module

public import Sheaf.RingTheory.KoszulRegularSequence
public import Sheaf.Algebra.Homology.DerivedTensorSecondFactorFunctor
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.TensorProduct.Quotient
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import WeilConjectures.FromJoel.Algebra.Homology.BifunctorSingle
import Sheaf.RingTheory.RegularSequenceKoszulRegular
import WeilConjectures.Algebra.Homology.BoundedFlatKFlat
import Sheaf.RingTheory.KoszulBaseChangeIso
import WeilConjectures.AlgebraicGeometry.KoszulComplex

/-!
# A Koszul-regular quotient as a derived polynomial base change

Source: Stacks Project, cotangent.tex, Tag 08SJ, proof of lemma-mod-regular-sequence.
(blueprint: lem-trf-koszul-derived-quotient).

The polynomial ring uses a universe lift of the integers. Its zero-section module is
literally the quotient by the variables. The comparison below is the derived counit
followed by the ordinary tensor/quotient isomorphism, with the action of `R` through
its degree-zero second factor. The derived functor and counit are universally
quantified choices of the interface supplied by the statement dependency.
-/

@[expose] public section

set_option autoImplicit false
universe u wP wR
open CategoryTheory MonoidalCategory

namespace RingTheory.KoszulDerivedQuotient

/-- The universe-compatible copy of the integer polynomial ring in `r` variables.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
abbrev PolynomialRing (r : ℕ) : Type u := MvPolynomial (Fin r) (ULift.{u} ℤ)

/-- The map of the polynomial ring sending its variables to the given sequence.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable def polynomialMap {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) :
    PolynomialRing.{u} r →+* R :=
  MvPolynomial.eval₂Hom ((Int.castRingHom R).comp ULift.ringEquiv.toRingHom) f

/-- The ideal of the zero section, generated by all polynomial variables.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable def variableIdeal (r : ℕ) : Ideal (PolynomialRing.{u} r) :=
  Ideal.span (Set.range (MvPolynomial.X : Fin r → PolynomialRing.{u} r))

/-- The module `ℤ = P/(x₁,…,xᵣ)`, with its canonical `P`-action.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable abbrev zeroSection (r : ℕ) : ModuleCat.{u} (PolynomialRing.{u} r) :=
  ModuleCat.of (PolynomialRing.{u} r) (PolynomialRing.{u} r ⧸ variableIdeal r)

/-- The second factor `R[0]`, carrying the resulting `R`-action.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable abbrev ringComplex (R : Type u) [CommRing R] :
    CochainComplex (ModuleCat.{u} R) ℤ :=
  (CochainComplex.singleFunctor (ModuleCat.{u} R) (0 : ℤ)).obj (ModuleCat.of R R)

/-- The zero-section complex `ℤ[0]` over `P`.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable abbrev zeroSectionComplex (r : ℕ) :
    CochainComplex (ModuleCat.{u} (PolynomialRing.{u} r)) ℤ :=
  (CochainComplex.singleFunctor (ModuleCat.{u} (PolynomialRing.{u} r)) (0 : ℤ)).obj
    (zeroSection r)

/-- The ordinary comparison `R ⊗_P ℤ ≅ R/(f₁,…,fᵣ)`, with the mixed tensor's
extra unit factor removed by its left unitor. On pure tensors it sends
`a ⊗ (b ⊗ p̄)` to the class of `ab p(f)`.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable def ordinaryModuleIso {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) :
    ((ModuleCat.mixedTensor (polynomialMap f)).obj (ModuleCat.of R R)).obj
        (zeroSection r) ≅ ModuleCat.of R (R ⧸ Ideal.span (Set.range f)) := by
  letI : Algebra (PolynomialRing.{u} r) R := (polynomialMap f).toAlgebra
  let t := ModuleCat.tensorEquivExtendScalars (PolynomialRing.{u} r) R (zeroSection r)
  let q := Algebra.TensorProduct.quotIdealMapEquivTensorQuot R (variableIdeal r)
  let e : (R ⧸ (variableIdeal r).map (algebraMap (PolynomialRing.{u} r) R)) ≃ₐ[R]
      R ⧸ Ideal.span (Set.range f) :=
    Ideal.quotientEquivAlgOfEq (R₁ := R) (by
      change (variableIdeal r).map (polynomialMap f) = Ideal.span (Set.range f)
      simp [variableIdeal, Ideal.map_span, ← Set.range_comp, Function.comp_def, polynomialMap])
  exact (λ_ ((ModuleCat.extendScalars (polynomialMap f)).obj (zeroSection r))) ≪≫
    t.symm.toModuleIso ≪≫ q.symm.toLinearEquiv.toModuleIso ≪≫ e.toLinearEquiv.toModuleIso

/-- The ordinary total tensor comparison to the quotient placed in degree zero.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable def ordinaryComplexIso {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) :
    (((ModuleCat.mixedTensor (polynomialMap f)).flip.map₂CochainComplex).obj
      (zeroSectionComplex r)).obj (ringComplex R) ≅
      (CochainComplex.singleFunctor (ModuleCat.{u} R) (0 : ℤ)).obj
        (ModuleCat.of R (R ⧸ Ideal.span (Set.range f))) :=
  CochainComplex.mapBifunctorSingle₂Iso (ModuleCat.mixedTensor (polynomialMap f)).flip
      (ModuleCat.of R R) (zeroSectionComplex r) ≪≫
    (HomologicalComplex.singleMapHomologicalComplex
      ((ModuleCat.mixedTensor (polynomialMap f)).obj (ModuleCat.of R R))
        (.up ℤ) (0 : ℤ)).app (zeroSection r) ≪≫
    (CochainComplex.singleFunctor (ModuleCat.{u} R) (0 : ℤ)).mapIso (ordinaryModuleIso f)

/-- The canonical derived-to-ordinary map followed by the tensor/quotient comparison.
`L, ε` describe the left derived fixed-second-factor tensor of the dependency;
no flatness of the polynomial map is involved in the construction.
Source: Stacks, Tag 08SJ (blueprint: lem-trf-koszul-derived-quotient). -/
noncomputable def comparison {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    [HasDerivedCategory.{wP} (ModuleCat.{u} (PolynomialRing.{u} r))]
    [HasDerivedCategory.{wR} (ModuleCat.{u} R)]
    (L : DerivedCategory (ModuleCat.{u} (PolynomialRing.{u} r)) ⥤
      DerivedCategory (ModuleCat.{u} R))
    (ε : DerivedCategory.Q ⋙ L ⟶
      ((ModuleCat.mixedTensor (polynomialMap f)).flip.map₂CochainComplex).flip.obj
        (ringComplex R) ⋙ DerivedCategory.Q) :
    L.obj (DerivedCategory.Q.obj (zeroSectionComplex r)) ⟶
      DerivedCategory.Q.obj
        ((CochainComplex.singleFunctor (ModuleCat.{u} R) (0 : ℤ)).obj
          (ModuleCat.of R (R ⧸ Ideal.span (Set.range f)))) :=
  ε.app (zeroSectionComplex r) ≫ DerivedCategory.Q.map (ordinaryComplexIso f).hom

/-- The canonical comparison from derived polynomial base change to the quotient is invertible.
Source: Stacks, Tag 08SJ, proof of lemma-mod-regular-sequence
(blueprint: lem-trf-koszul-derived-quotient).

Proof:
1. Successive quotients of `P` by its variables are polynomial rings in the remaining
   variables. Multiplication by the next variable shifts its exponent and is injective.
   The final quotient is `ℤ`; this includes the empty sequence.
2. Apply `lem-weil-pbc-regular-sequence-koszul-regular` over `P` to its variables.
   The degree-zero Koszul differential has image the variable ideal, so the quotient
   augmentation is a quasi-isomorphism to `ℤ[0]`. Reindex chain degree `q` as cochain
   degree `-q`. Exterior-power bases give finite free terms supported in `[-r,0]`
   (`def-weil-pbc-koszul-complex`, `def-weil-abstract-derived-category`).
3. Finite free modules are flat. By `lem-pc-module-bounded-flat-kflat` this resolution
   is K-flat. Clause (2) of `lem-pc-derived-tensor-second-factor-functor` computes the
   derived extension using it. The counit is represented by its augmentation tensor `R`.
   The left-derived universal property identifies this calculation with any `L, ε` below.
4. `lem-sc-koszul-base-change-iso` identifies the tensor resolution with `K_R(f)`:
   wedge basis vectors go to their corresponding wedges and each variable becomes `f i`.
   The ordinary comparison is `ordinaryModuleIso`, the balanced multiplication map.
   Hence the displayed comparison is represented by the quotient augmentation of `K_R(f)`.
5. `hreg` kills all positive Koszul homology, and its degree-zero homology is the quotient
   by the image `(f₁,…,fᵣ)` of the first differential. The augmentation is therefore a
   quasi-isomorphism and becomes invertible in `D(R)`. When `r=0` it is the quotient by
   the zero ideal. No properness of the ideal or nontriviality of `R` is used. -/
theorem isIso_comparison {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (hreg : RingTheory.Sequence.IsKoszulRegular f)
    [HasDerivedCategory.{wP} (ModuleCat.{u} (PolynomialRing.{u} r))]
    [HasDerivedCategory.{wR} (ModuleCat.{u} R)]
    (L : DerivedCategory (ModuleCat.{u} (PolynomialRing.{u} r)) ⥤
      DerivedCategory (ModuleCat.{u} R))
    (ε : DerivedCategory.Q ⋙ L ⟶
      ((ModuleCat.mixedTensor (polynomialMap f)).flip.map₂CochainComplex).flip.obj
        (ringComplex R) ⋙ DerivedCategory.Q)
    [L.IsLeftDerivedFunctor ε
      (HomologicalComplex.quasiIso (ModuleCat.{u} (PolynomialRing.{u} r)) (.up ℤ))] :
    IsIso (comparison f L ε) := by
  sorry

end RingTheory.KoszulDerivedQuotient
