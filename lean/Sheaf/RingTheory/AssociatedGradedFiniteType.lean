module

public import Sheaf.RingTheory.AssociatedGradedRing
public import Mathlib.RingTheory.FiniteType

/-!
# Finite type of the associated graded ring

Source: Stacks Project, Algebra, Lemma 05GH, proof, second paragraph
(blueprint: lem-weil-pbc-associated-graded-finite-type).
-/

@[expose] public section

universe u

namespace Ideal

/-- The associated graded ring of a finitely generated ideal is finite type over the quotient.
Source: Stacks Project, Algebra, Lemma 05GH, proof, second paragraph
(blueprint: lem-weil-pbc-associated-graded-finite-type).

Proof: Choose a finite generating family `f : Fin t → A` of `J`, allowing `t = 0`.
Let `S` be the `A/J`-subalgebra generated by their degree-one classes. By induction
on ideal-span membership, every degree-one class belongs to `S`: addition of classes
preserves membership, and multiplication by a representative `a ∈ A` is the scalar
action of `a mod J`.
Induct on `n` to show that every class in `J^n/J^(n+1)` belongs to `S`. The degree-zero
case is the algebra map from `A/J`. For the successor case write `J^(n+1) = J^n J`
and induct on ideal-product membership. The class of a product is the product of its
classes, while addition of representatives gives addition of classes. Finally induct
on the additive direct sum to conclude that every graded element belongs to `S`.
Thus the finite range of the degree-one classes generates the entire algebra, giving
finite type. This is the degree-by-degree surjectivity argument in the source, stated
using algebraic generation rather than constructing the polynomial evaluation map. -/
theorem associatedGraded_finiteType {A : Type u} [CommRing A] (J : Ideal A)
    (hJ : J.FG) : Algebra.FiniteType (A ⧸ J) (associatedGraded J) := by
  classical
  obtain ⟨t, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hJ
  let q (n : ℕ) (x : (J ^ n : Ideal A)) : associatedGraded J :=
    DirectSum.of (fun k : ℕ => associatedGradedPiece J k) n (Submodule.Quotient.mk x)
  have qadd (n : ℕ) (x y : (J ^ n : Ideal A)) : q n (x + y) = q n x + q n y := by
    dsimp [q]
    rw [map_add]
  have qzero (n : ℕ) : q n 0 = 0 := by
    dsimp [q]
    rw [map_zero]
  have qsmul (n : ℕ) (a : A) (x : (J ^ n : Ideal A)) :
      q n (a • x) = (Ideal.Quotient.mk J a) • q n x := by
    exact (associatedGraded_smul J a n x).symm
  let g (i : Fin t) : associatedGraded J :=
    q 1 ⟨f i, by simpa [hf] using
      (Submodule.subset_span (Set.mem_range_self i) : f i ∈ Submodule.span A (Set.range f))⟩
  let S := Algebra.adjoin (A ⧸ J) (Set.range g)
  have h1 (x : (J ^ 1 : Ideal A)) : q 1 x ∈ S := by
    have hx : x.val ∈ Submodule.span A (Set.range f) := by
      simpa [hf] using x.property
    have h : ∀ (y : A) (hy : y ∈ Submodule.span A (Set.range f)),
        q 1 ⟨y, by simpa [hf] using hy⟩ ∈ S := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        exact Algebra.subset_adjoin (Set.mem_range_self i)
      | zero => simpa only [show (⟨0, _⟩ : (J ^ 1 : Ideal A)) = 0 from rfl, qzero]
          using S.zero_mem
      | add y z hy hz ihy ihz =>
        change q 1 ((⟨y, by simpa [hf] using hy⟩ : (J ^ 1 : Ideal A)) +
          ⟨z, by simpa [hf] using hz⟩) ∈ S
        rw [qadd]
        exact S.add_mem ihy ihz
      | smul a y hy ih =>
        change q 1 (a • (⟨y, by simpa [hf] using hy⟩ : (J ^ 1 : Ideal A))) ∈ S
        rw [qsmul]
        exact S.smul_mem ih (Ideal.Quotient.mk J a)
    exact h x.val hx
  have hn (n : ℕ) (x : (J ^ n : Ideal A)) : q n x ∈ S := by
    induction n with
    | zero =>
      have heq : q 0 x = algebraMap (A ⧸ J) (associatedGraded J)
          (Ideal.Quotient.mk J x.val) := rfl
      rw [heq]
      exact S.algebraMap_mem _
    | succ n ih =>
      have hx : x.val ∈ (J ^ n) * (J ^ 1) := by
        rw [pow_one, ← pow_succ]
        exact x.property
      have h : ∀ (y : A) (hy : y ∈ (J ^ n) * (J ^ 1)),
          q (n + 1) ⟨y, by simpa [pow_succ] using hy⟩ ∈ S := by
        intro y hy
        induction hy using Submodule.mul_induction_on' with
        | mem_mul_mem a ha b hb =>
          have hab : a * b ∈ J ^ (n + 1) := by
            simpa [pow_succ] using (Ideal.mul_mem_mul ha hb)
          have heq : q (n + 1) ⟨a * b, hab⟩ = q n ⟨a, ha⟩ * q 1 ⟨b, hb⟩ := by
            exact (associatedGraded_mul J n 1 ⟨a, ha⟩ ⟨b, hb⟩).symm
          rw [heq]
          exact S.mul_mem (ih ⟨a, ha⟩) (h1 ⟨b, hb⟩)
        | add y hy z hz ihy ihz =>
          change q (n + 1) ((⟨y, by simpa [pow_succ] using hy⟩ :
            (J ^ (n + 1) : Ideal A)) + ⟨z, by simpa [pow_succ] using hz⟩) ∈ S
          rw [qadd]
          exact S.add_mem ihy ihz
      exact h x.val hx
  have hS : S = ⊤ := by
    apply top_unique
    intro x hx
    clear hx
    induction x using DirectSum.induction_on with
    | zero => exact S.zero_mem
    | of n x =>
      induction x using Submodule.Quotient.induction_on with
      | _ x => exact hn n x
    | add x y ihx ihy => exact S.add_mem ihx ihy
  exact ⟨Subalgebra.fg_def.mpr ⟨Set.range g, Set.finite_range g, hS⟩⟩

end Ideal
