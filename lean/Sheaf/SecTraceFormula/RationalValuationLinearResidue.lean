module

public import Mathlib.FieldTheory.IsSepClosed
public import Mathlib.RingTheory.Valuation.ValuationSubring
public import Mathlib.RingTheory.AlgebraicIndependent.Basic
public import Mathlib.Algebra.Polynomial.Eval.Defs
public import Sheaf.RingTheory.ValuationComapResidue

import Sheaf.FieldTheory.NormalizedPolynomialResidueGeneration
import Sheaf.TraceFormula.ResidualCurveValueGroup
import Sheaf.FieldTheory.ValueGroupDivisible
import Sheaf.TraceFormula.SeparablePerturbationFactorSelection

/-!
# A linear rational coordinate with transcendental residue

Source: Temkin, *Stable modification of relative curves*, Proposition 4.3.1,
proof, second stage on p. 28 (blueprint: lem-trf-rational-valuation-linear-residue).

## Main definitions

* `rationalValuationClosedCentre` expresses the maximal-contraction condition on
  the polynomial subring generated by the indeterminate.

The constant restriction and residue inclusion reuse `ValuationSubring.comap` and
`ValuationSubring.comapResidueFieldMap` through the recorded dependency
`def-trf-valuation-comap-residue`.

## Main statement

* `rationalValuationLinearResidue` states the normalized linear coordinate theorem.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u v

noncomputable section

open Polynomial

namespace WeilConjectures

/-- The polynomial subring generated by the constants and the indeterminate, reduced
modulo the maximal ideal of `O`.
Source: Temkin, Proposition 4.3.1, p. 28 (blueprint: lem-trf-rational-valuation-linear-residue). -/
def rationalValuationClosedCentre
    (K : Type u) (F : Type v) [Field K] [Field F] [Algebra K F]
    (O : ValuationSubring F) (t : F) (ht : t ∈ O) : Prop :=
  let R := (O.comap (algebraMap K F))
  let f := Polynomial.eval₂RingHom
    ((O.comapInclusion (algebraMap K F))) (⟨t, ht⟩ : O)
  let p : Ideal (Polynomial R) := Ideal.comap f (IsLocalRing.maximalIdeal O)
  p.IsMaximal ∧ Ideal.comap Polynomial.C p = IsLocalRing.maximalIdeal R

/--
If `K` is separably closed and `O` is a valuation subring of the rational function
field `K(t)` with residue transcendence degree one over the residue field of its
constant restriction, then a translated and rescaled indeterminate has a
transcendental residue. Under the closed-centre hypothesis the translation lies in
`R` and the scale lies in the nonzero maximal ideal of `R`.

Source: Temkin, *Stable modification of relative curves*, Proposition 4.3.1,
proof, second stage on p. 28 (blueprint: lem-trf-rational-valuation-linear-residue).
Proof, following the six DAG steps:
1. `lem-trf-separably-closed-value-group-divisible` and
   `lem-trf-residual-curve-value-group` normalize every nonzero rational function
   by a ground-field scalar. `lem-trf-normalized-polynomial-residue-generation`
   then gives a normalized monic irreducible factor with transcendental residue.
2. `lem-trf-separable-perturbation-factor-selection` supplies a separable
   irreducible factor with transcendental normalized residue. Separably closedness
   makes this factor linear, giving the unrestricted coordinate.
3. Restriction identifies units and maximal ideals on constants, and induces the
   canonical residue inclusion. `lem-trf-valuation-inverse-maximal-ideal` puts
   the inverse of any element outside the valuation ring in its maximal ideal.
4. Under the closed-centre hypotheses, the quotient of R[T] by the centre prime
   is a one-generator field algebra over the residue field of R.
   `lem-weil-pbc-zariski-lemma` makes it finite dimensional; the residue of t is
   consequently algebraic.
5. If a were outside R, its inverse would have positive value by
   `lem-trf-valuation-inverse-maximal-ideal`. The unit 1-t/a has residue one.
   Dividing z by this unit would make its residue a constant, a contradiction.
   Hence a belongs to R.
6. If t-a were a unit, the scale would be a constant unit and the residue of z
   would belong to the finite extension in step 4, contradicting transcendence.
   Thus t-a is nonzero in the maximal ideal. The final clause of
   `lem-trf-residual-curve-value-group` normalizes it by a nonzero element of
   the maximal ideal of R. This changes the residue by a nonzero residue scalar,
   preserving transcendence.
-/
theorem rationalValuationLinearResidue
    (K : Type u) (F : Type v) [Field K] [IsSepClosed K] [Field F] [Algebra K F]
    [Algebra (Polynomial K) F] [IsFractionRing (Polynomial K) F]
    [IsScalarTower K (Polynomial K) F]
    (t : F)
    (hX : t = algebraMap (Polynomial K) F Polynomial.X)
    (O : ValuationSubring F)
    (htr : @Algebra.trdeg
      (IsLocalRing.ResidueField ((O.comap (algebraMap K F))))
      (IsLocalRing.ResidueField O) _ _
      (RingHom.toAlgebra ((O.comapResidueFieldMap (algebraMap K F)))) = 1) :
    (∃ (a : K) (π : Kˣ) (z : Oˣ),
      (z : F) = (t - algebraMap K F a) / algebraMap K F (π : K) ∧
      ∀ (p : Polynomial (IsLocalRing.ResidueField
          ((O.comap (algebraMap K F))))),
        p ≠ 0 →
          Polynomial.eval₂ ((O.comapResidueFieldMap (algebraMap K F)))
            (IsLocalRing.residue O z) p ≠ 0) ∧
    (∀ (ht : t ∈ O), rationalValuationClosedCentre K F O t ht →
      ∃ (a : (O.comap (algebraMap K F)))
        (π : (O.comap (algebraMap K F))),
        π ≠ 0 ∧
        π ∈ IsLocalRing.maximalIdeal ((O.comap (algebraMap K F))) ∧
        ∃ (z : Oˣ),
          (z : F) = (t - algebraMap K F (a : K)) /
            algebraMap K F (π : K) ∧
          ∀ (p : Polynomial (IsLocalRing.ResidueField
              ((O.comap (algebraMap K F))))),
            p ≠ 0 →
              Polynomial.eval₂ ((O.comapResidueFieldMap (algebraMap K F)))
                (IsLocalRing.residue O z) p ≠ 0) := by
  sorry

end WeilConjectures

end
