module

public import Sheaf.SixFunctors.SchemeGaloisComparison
public import Sheaf.Paper.TraceFormulaCoefficientConventions
import Mathlib.Algebra.CharP.CharAndCard

/-!
# The specified scheme/Galois comparison at finite coefficient level

Source: main-20261015, `prop-trf-scheme-galois-comparison` and its displayed construction
(blueprint: prop-trf-scheme-galois-comparison).

The existing theorem specifies the comparison by relative Frobenius on site objects,
the sectionwise adjunction-unit equation, and canonical pullback composition. We expose
its finite-level specialization, retaining that characterization through witness selection.
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme
namespace WeilConjectures.FiniteFieldDatum

/-- The specified comparison on every finite ring allowed by the original node.
The iterate family is selected once from the theorem with all its projection, section-unit,
factorization and multiplicativity clauses. Those normalizations determine its maps.
Source: main-20261015, `prop-trf-scheme-galois-comparison`, first displayed construction
(blueprint: prop-trf-scheme-galois-comparison). -/
def canonicalSchemeGaloisComparison (D : WeilConjectures.FiniteFieldDatum.{u})
    (Z₀ : Over (Spec (CommRingCat.of D.k₀)))
    [LocallyOfFiniteType Z₀.hom] [QuasiCompact Z₀.hom]
    (A : Type u) [CommRing A] [Finite A]
    (hA : ∃ n : ℕ, IsUnit (n : D.k) ∧ ∀ a : A, n • a = 0)
    (m : ℕ) (hm : 1 ≤ m) :
    proEtaleConstantRingDerivedPullback A (D.schemeFrobeniusIterate Z₀ m) ≅
      proEtaleConstantRingDerivedPullback A
        (HPow.hPow (α := End (D.geometricFiber Z₀).left)
          (D.geometricGaloisFrobenius Z₀) m) :=
  (D.schemeGaloisComparison Z₀ A hA).choose_spec.choose m hm

end WeilConjectures.FiniteFieldDatum

namespace WeilConjectures.TraceFormulaCoefficientConventions

/-- Finiteness of the specified positive-level quotient coefficient ring.
Source: Serre, Local Fields, II §2; the coefficient convention in
`prop-trf-scheme-galois-comparison` (blueprint: prop-trf-scheme-galois-comparison). -/
noncomputable instance coefficientRingFinite (T : TraceFormulaCoefficientConventions.{u}) :
    Finite T.coefficientRing :=
  Padic.finite_coefficientExtensionRing T.coefficients.l T.coefficientField T.level T.level_pos

/-- The coefficient ring meets the torsion hypothesis of the comparison theorem.
Source: main-20261015, `prop-trf-scheme-galois-comparison`, finite coefficient convention
(blueprint: prop-trf-scheme-galois-comparison).
Proof: in the valuation ring of the finite extension E of Q_l, l has positive valuation,
so some power l^r belongs to the ideal generated by the positive-level power of the
uniformizer. Hence l^r is zero in A, and multiplication by it kills every element.
The field k has characteristic p and l differs from p, so l, and therefore l^r, is a unit
in k. This supplies exactly the annihilator required by schemeGaloisComparison. -/
theorem comparisonCoefficientAnnihilator (T : TraceFormulaCoefficientConventions.{u}) :
    ∃ n : ℕ, IsUnit (n : T.datum.k) ∧ ∀ a : T.coefficientRing, n • a = 0 := by
  classical
  let l := T.coefficients.l
  let E := T.coefficientField
  let O := Padic.coefficientExtensionIntegers l E
  have h := (Padic.extension_integers_dvr l E
    (Padic.coefficientExtensionAbsoluteValue l E)
    (spectralNorm_extends (K := Padic l) (L := E))).choose_spec.choose_spec
  have hm : ∀ x : O, x ∈ Padic.coefficientExtensionMaximalIdeal l E ↔
      Padic.coefficientExtensionAbsoluteValue l E (x : E) < 1 := h.2.1
  have hgen : Ideal.span ({Padic.coefficientExtensionUniformizer l E} : Set O) =
      Padic.coefficientExtensionMaximalIdeal l E :=
    h.2.2.2.2.2.2.2.2.2.2.2.2.2.1.choose_spec
  have hlm : (l : O) ∈ Padic.coefficientExtensionMaximalIdeal l E := by
    apply (hm _).mpr
    change spectralNorm (Padic l) E (l : E) < 1
    have he := spectralNorm_extends (K := Padic l) (L := E) (l : Padic l)
    simpa only [map_natCast] using he.trans_lt (Padic.norm_p_lt_one (p := l))
  have hpow : ((l : O) ^ T.level) ∈ Padic.coefficientExtensionIdeal l E T.level := by
    change (l : O) ^ T.level ∈ Ideal.span ({Padic.coefficientExtensionUniformizer l E} :
      Set O) ^ T.level
    rw [hgen]
    exact Ideal.pow_mem_pow hlm T.level
  have hzero : ((l ^ T.level : ℕ) : T.coefficientRing) = 0 := by
    change ((l ^ T.level : ℕ) : O ⧸ Padic.coefficientExtensionIdeal l E T.level) = 0
    rw [← map_natCast (Ideal.Quotient.mk _) (l ^ T.level)]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    simpa only [Nat.cast_pow] using hpow
  let _ : Fintype T.datum.k₀ := Fintype.ofFinite T.datum.k₀
  have hc : Fintype.card T.datum.k₀ = T.datum.p ^ T.datum.a := by
    simpa only [Nat.card_eq_fintype_card] using
      T.datum.card_base.trans T.datum.cardinality_eq
  have _ : Fact T.datum.p.Prime := ⟨T.datum.prime⟩
  have _ : CharP T.datum.k₀ T.datum.p := charP_of_card_eq_prime_pow hc
  have _ : CharP T.datum.k T.datum.p :=
    charP_of_injective_algebraMap' T.datum.k₀ T.datum.p
  have hl : (l : T.datum.k) ≠ 0 := by
    intro hz
    have hd := (CharP.cast_eq_zero_iff T.datum.k T.datum.p l).mp hz
    exact T.coefficients.different
      ((Nat.prime_dvd_prime_iff_eq T.datum.prime (Fact.out : l.Prime)).mp hd).symm
  refine ⟨l ^ T.level, ?_, ?_⟩
  · rw [Nat.cast_pow]
    exact (isUnit_iff_ne_zero.mpr hl).pow T.level
  · intro a
    rw [nsmul_eq_mul, hzero, zero_mul]

/-- The actual positive-iterate comparison, selected together with all of its defining
normalizations from the existing comparison theorem. Relative Frobenius fixes r by its
projections; the section-unit equation fixes tau by adjunction; the displayed construction
then fixes kappa. Thus this selection is of a determined map, not an unspecified isomorphism.
Source: main-20261015, `prop-trf-scheme-galois-comparison`, first displayed construction
(blueprint: prop-trf-scheme-galois-comparison). -/
def selectedSchemeGaloisComparison (T : TraceFormulaCoefficientConventions.{u})
    (Z₀ : Over (Spec (CommRingCat.of T.datum.k₀)))
    [LocallyOfFiniteType Z₀.hom] [QuasiCompact Z₀.hom] (m : ℕ) (hm : 1 ≤ m) :
    proEtaleConstantRingDerivedPullback T.coefficientRing
        (T.datum.schemeFrobeniusIterate Z₀ m) ≅
      proEtaleConstantRingDerivedPullback T.coefficientRing
        (HPow.hPow (α := End (T.datum.geometricFiber Z₀).left)
          (T.datum.geometricGaloisFrobenius Z₀) m) :=
  T.datum.canonicalSchemeGaloisComparison Z₀ T.coefficientRing
    T.comparisonCoefficientAnnihilator m hm

end WeilConjectures.TraceFormulaCoefficientConventions
