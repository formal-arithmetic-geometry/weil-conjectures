/-!
# Stable Frobenius affine charts and their equalizer presentations

Source: current Weil conjectures blueprint, sec-six-functors-basics,
sk-prop-sf-rf-shriek-preservation, thm-trf-frobenius-fixed-points.proof.md,
Steps 0--1 (blueprint: lem-trf-frobenius-affine-equalizer-presentation).

The helpers spell out the tensor algebra, its Frobenius and difference ideal, the
canonical chart inclusion, and the two polynomial ideals. The main statement includes
all affine charts, all finite polynomial presentations, and arbitrary smaller model
affines. The existing fixed-scheme construction is used without a separatedness assumption.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped TensorProduct

namespace WeilConjectures.FiniteFieldDatum.FrobeniusAffineEqualizer

/-- The affine model as an object over the finite base field.
Source: blueprint Steps 0--1 (blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
def model (D : FiniteFieldDatum.{u}) (A : CommAlgCat.{u} D.k₀) :
    Over (Spec (.of D.k₀)) :=
  Over.mk (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ A)))

/-- Scalar extension of the inclusion of a model affine, using the canonical tensor chart.
Source: blueprint Step 0 (blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
def chartMap (D : FiniteFieldDatum.{u}) (X₀ : Over (Spec (.of D.k₀)))
    [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom]
    (A : CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀) :
    Spec (.of (A ⊗[D.k₀] D.k)) ⟶ (D.geometricFiber X₀).left :=
  (pullbackSpecIso D.k₀ A D.k).inv ≫
    ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ D.k)))).map j).left

/-- The actual tensor endomorphism: q-power Frobenius on the model factor, identity on k.
Source: blueprint Steps 0--1 (blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
def tensorFrobenius (D : FiniteFieldDatum.{u}) (A : CommAlgCat.{u} D.k₀) (m : ℕ) :
    A ⊗[D.k₀] D.k →ₐ[D.k₀] A ⊗[D.k₀] D.k :=
  Algebra.TensorProduct.map
    ((@FiniteField.frobeniusAlgHom D.k₀ A _ (Fintype.ofFinite D.k₀) _ _) ^ m)
    (AlgHom.id D.k₀ D.k)

/-- The ideal generated by all differences, rather than the kernel of their additive map.
Source: blueprint Steps 0--1 (blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
def differenceIdeal (D : FiniteFieldDatum.{u}) (A : CommAlgCat.{u} D.k₀) (m : ℕ) :
    Ideal (A ⊗[D.k₀] D.k) :=
  Ideal.span (Set.range (fun b ↦ tensorFrobenius D A m b - b))

/-- Extension of the model relations by coefficientwise scalar extension.
Source: blueprint Step 1 (blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
def extendedIdeal (D : FiniteFieldDatum.{u}) (r : ℕ)
    (a : Ideal (MvPolynomial (Fin r) D.k₀)) : Ideal (MvPolynomial (Fin r) D.k) :=
  a.map (MvPolynomial.map (algebraMap D.k₀ D.k))

/-- The power-difference ideal in the polynomial ring, before quotienting by the relations.
Source: blueprint Step 1 (blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
def powerIdeal (D : FiniteFieldDatum.{u}) (m r : ℕ) : Ideal (MvPolynomial (Fin r) D.k) :=
  Ideal.span (Set.range (fun i : Fin r ↦
    (MvPolynomial.X i : MvPolynomial (Fin r) D.k) ^ (D.q ^ m) - MvPolynomial.X i))

/-- All assertions of the stable-affine equalizer presentation, with canonical maps.
Source: blueprint Steps 0--1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation).

Proof to be supplied in stage 3:
1. Finite type over the affine base gives a finite affine cover by finitely generated
   algebras (def-weil-finite-type-morphism).
2. Absolute Frobenius is the identity on points and takes sections to q-th powers
   (def-weil-absolute-frobenius-scheme). Base change, iteration, the affine fibre-product
   formula (lem-weil-pbc-fibre-product-affine-spectra), and the tensor multiplication
   (lem-weil-pbc-algebra-tensor-pushout-universal-property) give stability and the formula
   a tensor c maps to a^(q^m) tensor c. The latter fixes the right scalar inclusion.
3. For any polynomial presentation, extend coefficients and evaluate at the tensor
   generators. These maps descend through the relation ideals and are mutually inverse
   on pure tensors, constants and variables (def-weil-pbc-mv-polynomial-ring and
   def-weil-pbc-module-tensor-product). This constructs the specified theta.
4. The affine adjunction (lem-a1-locally-ringed-space-affine-adjunction) identifies maps
   to Spec(B/J) with maps to Spec B equalizing Frobenius and the identity. The pullback
   description (def-pc-fibre-product) gives the same functor for the restricted fixed
   scheme. Hom-set isomorphism detection (lem-coef-joyal-homset-iso-detection) gives e,
   whose map to the chart is Spec of the quotient map. This also fixes its canonicity.
5. The coordinate differences lie in J. Conversely, modulo their ideal the two k-linear
   maps phi and identity agree on every variable and every scalar, so polynomial
   extensionality gives the opposite ideal inclusion. No assertion c^(q^m)=c on k is used.
6. Lift the finitely many multipliers in an expression in the coordinate ideal to the
   polynomial ring. The composite quotient has kernel a_k plus the power ideal. The
   resulting quotient equivalence nu is characterized by its value on polynomial tensors;
   contravariant Spec gives the displayed polynomial spectrum chart.
7. On any smaller model affine, restriction of the tensor maps commutes with phi and
   carries J into J'. The quotient restriction rho and the pullback restriction s commute
   with the comparison by their universal properties. These arguments use neither
   separatedness nor affine intersections, and include the empty scheme and r=0. -/
theorem presentation (D : FiniteFieldDatum.{u})
    (X₀ : Over (Spec (.of D.k₀)))
    [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom] (m : ℕ) (_hm : 1 ≤ m) :
    (∃ (n : ℕ) (A : Fin n → CommAlgCat.{u} D.k₀)
        (j : ∀ i, model D (A i) ⟶ X₀),
      (∀ i, Algebra.FiniteType D.k₀ (A i) ∧ IsOpenImmersion (j i).left) ∧
        (∀ x : X₀.left, ∃ i, x ∈ Set.range (j i).left)) ∧
    (∀ U : X₀.left.Opens,
      X₀.left.iterateFrobenius D.prime (D.model_characteristic X₀.hom) (D.a * m) ⁻¹ᵁ U = U) ∧
    ∃ h : D.geometricFiber X₀ ⟶ D.geometricFiber X₀,
      h.left = D.schemeFrobeniusIterate X₀ m ∧
      ∀ (A : CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀),
        IsOpenImmersion j.left →
        (∀ a : A, ∀ c : D.k,
          tensorFrobenius D A m (a ⊗ₜ c) = (a ^ (D.q ^ m)) ⊗ₜ c) ∧
        (Spec.map (CommRingCat.ofHom (tensorFrobenius D A m).toRingHom) ≫
          chartMap D X₀ A j = chartMap D X₀ A j ≫ h.left) ∧
        (h.left ⁻¹' Set.range (chartMap D X₀ A j) = Set.range (chartMap D X₀ A j)) ∧
        ∃ e : pullback (WeilConjectures.trfEndomorphismFixedInclusion
            (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅
            Spec (.of ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m)),
          e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (differenceIdeal D A m))) =
            pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
              (D.geometricFiber X₀) h) (chartMap D X₀ A j) ∧
          (∀ (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀))
              (p : (MvPolynomial (Fin r) D.k₀ ⧸ a) ≃ₐ[D.k₀] A),
            ∃ θ : (A ⊗[D.k₀] D.k) ≃+*
                (MvPolynomial (Fin r) D.k ⧸ extendedIdeal D r a),
              (∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
                θ (p (Ideal.Quotient.mk a f) ⊗ₜ c) =
                  Ideal.Quotient.mk (extendedIdeal D r a)
                    (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c)) ∧
              (differenceIdeal D A m).map θ.toRingHom =
                (powerIdeal D m r).map (Ideal.Quotient.mk (extendedIdeal D r a)) ∧
              ∃ ν : ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m) ≃+*
                  (MvPolynomial (Fin r) D.k ⧸
                    (extendedIdeal D r a ⊔ powerIdeal D m r)),
                (∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
                  ν (Ideal.Quotient.mk (differenceIdeal D A m)
                    (p (Ideal.Quotient.mk a f) ⊗ₜ c)) =
                      Ideal.Quotient.mk (extendedIdeal D r a ⊔ powerIdeal D m r)
                        (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c)) ∧
                ∃ ep : pullback (WeilConjectures.trfEndomorphismFixedInclusion
                    (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅
                    Spec (.of (MvPolynomial (Fin r) D.k ⧸
                      (extendedIdeal D r a ⊔ powerIdeal D m r))),
                  ep.hom = e.hom ≫ Spec.map (CommRingCat.ofHom ν.symm.toRingHom)) ∧
          (∀ (A' : CommAlgCat.{u} D.k₀) (j' : model D A' ⟶ X₀)
              (f : A →ₐ[D.k₀] A'),
            IsOpenImmersion j'.left →
            Spec.map (CommRingCat.ofHom f.toRingHom) ≫ j.left = j'.left →
            ∀ e' : pullback (WeilConjectures.trfEndomorphismFixedInclusion
                (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ≅
                Spec (.of ((A' ⊗[D.k₀] D.k) ⧸ differenceIdeal D A' m)),
              e'.hom ≫ Spec.map (CommRingCat.ofHom
                  (Ideal.Quotient.mk (differenceIdeal D A' m))) =
                pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
                  (D.geometricFiber X₀) h) (chartMap D X₀ A' j') →
              ∃ ρ : ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m) →+*
                  ((A' ⊗[D.k₀] D.k) ⧸ differenceIdeal D A' m),
                (∀ b : A ⊗[D.k₀] D.k,
                  ρ (Ideal.Quotient.mk (differenceIdeal D A m) b) =
                    Ideal.Quotient.mk (differenceIdeal D A' m)
                      (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k) b)) ∧
                ∃ s : pullback (WeilConjectures.trfEndomorphismFixedInclusion
                    (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ⟶
                    pullback (WeilConjectures.trfEndomorphismFixedInclusion
                      (D.geometricFiber X₀) h) (chartMap D X₀ A j),
                  s ≫ pullback.fst (WeilConjectures.trfEndomorphismFixedInclusion
                      (D.geometricFiber X₀) h) (chartMap D X₀ A j) =
                    pullback.fst (WeilConjectures.trfEndomorphismFixedInclusion
                      (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ∧
                  s ≫ pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
                      (D.geometricFiber X₀) h) (chartMap D X₀ A j) =
                    pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
                      (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ≫
                        Spec.map (CommRingCat.ofHom
                          (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)).toRingHom) ∧
                  s ≫ e.hom = e'.hom ≫ Spec.map (CommRingCat.ofHom ρ)) := by
  sorry

end WeilConjectures.FiniteFieldDatum.FrobeniusAffineEqualizer
