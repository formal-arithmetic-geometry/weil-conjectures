module

public import Sheaf.Paper.ConstantCompletionBasic

/-! Kernel characterization for a finite constant quotient.
Source: Stacks Project, Tag 093M (blueprint: new-e4-constant-completion-quotient-kernel).
The proof is the local-to-global kernel argument for sheafified constant rings: locally
zero classes are represented by elements of the coefficient ideal, and finite generation
of the ideal lets the local expressions glue through the sheaf of constant rings. -/
@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits Opposite
universe u
namespace CategoryTheory.ConstantCompletion
variable {C : Type u} [SmallCategory C]

/-- The kernel of the section map of a finite constant quotient is generated by the
constant sections of the defining ideal power.  This is the kernel component of the
quotient theorem; it is strictly weaker than the theorem asserting both this identity
and sectionwise surjectivity.
Source: Stacks Project, Tag 093M, kernel part of lemma-completion-flat.
Proof plan: use the sheafification unit to test vanishing locally, lift each local
coefficient to the original ring, and use finite generation of `I ^ (n+1)` to express
the resulting section as a finite sum of constant ideal sections times arbitrary
sections.  The reverse inclusion follows because the quotient map kills every element
of `I ^ (n+1)`. -/
theorem constant_quotient_kernel (J : GrothendieckTopology C) (A : Type u)
    [CommRing A] [IsNoetherianRing A] (I : Ideal A) (n : ℕ) (U : C) :
    RingHom.ker ((quotient J A I n).hom.app (op U)).hom =
      Ideal.span (Set.range (fun a : ↥(I ^ (n + 1)) ↦
        (constantSection (J := J) (a : A)).val (op U))) := by
  sorry

end CategoryTheory.ConstantCompletion
