module

public import Sheaf.Paper.DiagonalCoefficientRouteSquare

/-! # The source equation for an existing normalized restriction comparison

Source: diagonal tower coefficient changes (1), scalar units and finite constants.
(blueprint: lem-diagonal-cyclic-uniformizer-source-equation).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option genSizeOf false
set_option genInjectivity false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits
open scoped CategoryTheory.Obj CategoryTheory.Functor
namespace AlgebraicGeometry.ProEtale.DiagonalCoefficients

-- Use the module-sheaf abelian structure of GeoCartierClass.
attribute [local instance 100000] sheafIsAbelian
attribute [local instance 200000] AlgebraicGeometry.ProEtale.diagonalAbSheafAbelian
attribute [local instance 300000] CommRing.toRing
attribute [local instance 400000] AlgebraicGeometry.ProEtale.diagonalModuleSheafAbelian

-- Keep the coefficient category choices of the existing criterion in the signature.
-- This emits its ordinary endpoint equality, not an additional predicate.
local elab "sourceEquation% " f:term:max s:term:max : term => do
  let ef ← Lean.Elab.Term.elabTerm f none
  let es ← Lean.Elab.Term.elabTerm s none
  let .forallE _ domain _ _ ← Lean.Meta.whnf (← Lean.Meta.inferType ef)
    | throwError "criterion has no source hypothesis"
  let pred := domain.getAppArgs.back!
  let conjunction ← Lean.Meta.whnf (Lean.mkApp pred es)
  unless conjunction.isAppOf ``And do
    throwError "criterion source is not a conjunction"
  return conjunction.getAppArgs.back!

/-- The mate of a normalized ordinary restriction comparison has the prescribed
supported constant endpoint. This lemma assumes the comparison and does not assert
its existence or uniqueness.

Source: latest blueprint, sec-six-functors-basics/sk-prop-diagonal-tower/
sk-prop-diagonal-tower-coefficients.proof.md (1), scalar units; step 2 of
lem-diagonal-cyclic-uniformizer-source.
(blueprint: lem-diagonal-cyclic-uniformizer-source-equation).

Proof: transpose the equation under cyclicAdjunction. The definition of
restrictionMate turns the left side into the quotient endpoint's transpose
followed by the derived ordinary restriction comparison. First transpose the
finite-realization single comparison under its equivalence adjunction. Its
transpose is the single of the ordinary equivalence transpose followed by the
inverse single comparison of the inverse equivalence. Then use
Endpoint.normalization for the cyclic scalar endpoint and both successive
scalar endpoints. Naturality and composition of exact single comparisons reduce
the equation to one of ordinary module maps. Forget to abelian sheaves. The
hypothesis on s cancels the inverse-realization counits on both sides.
FiniteSourceComparison.normalization moves both maps inside the diagonal direct
image. FiniteRealization.unit_normalization identifies their coefficient-unit
maps with the supplied unital ring isomorphisms. The two maps from pulled-back
Z_l to constant A agree: reduction modulo l^(n+1) is the cokernel of its power,
and the resulting constant cyclic ring is generated by one; both maps are
unital and the target is killed by that power. The source_normalization of
maps.source identifies its constant-generator map with this same coefficient
map. Sheafification's universal property gives equality on the whole constant
sheaf. Apply the ordinary direct-image functor, then the single functor, and
reverse the transpositions. This proof does not use a root-line endpoint or
any diagonal-class equation. For the empty base all maps are unique, and for
the zero coefficient ring all ordinary target modules are zero. -/
theorem diagonalCyclic_uniformizerSource_equation
    (l : ℕ) [Fact l.Prime] (Y : Scheme.{u})
    (E : PadicAlgCl.FiniteIntermediateField l) (π : PadicAlgCl.integers l E) (n : ℕ)
    (A : Type (u + 1)) [CommRing A]
    (hA : ((l ^ (n + 1) : ℕ) : A) = 0)
    (q : UniformizerSquareData l Y E π n A hA)
    (s : q.quotientRight ≅ q.restriction ⋙ q.cyclicRight)
    (hs : q.RestrictionNormalized s) :
    sourceEquation% (UniformizerSquareData.endpointSquare l Y E π n A hA q) s := by sorry

end AlgebraicGeometry.ProEtale.DiagonalCoefficients
