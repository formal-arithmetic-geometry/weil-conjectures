module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Spectrum.Prime.Defs
import Mathlib.RingTheory.Spectrum.Prime.Topology

/-! # Finite coefficient models for principal covers

Source: Stacks Project, Algebra, proof of Tag 00SU, final paragraph.
(blueprint: lem-weil-pbc-noetherian-principal-cover-model).
-/

@[expose] public section

universe u v

namespace Algebra

/-- Descend the covering property alone to a finite type coefficient ring containing the
original coefficient ring.

Source: Stacks Project, Algebra, proof of Tag 00SU, final paragraph.
(blueprint: lem-weil-pbc-noetherian-principal-cover-model).

Proof: The images of the G_j generate the unit ideal of the quotient over R, since no
prime contains them all. Membership of 1 in this ideal uses finitely many indices and
coefficients. Lift the finitely many quotient coefficients to polynomials over R. The
resulting difference from 1 belongs to the ideal generated by the f_i, so express it
as a finite sum of polynomial multiples of the f_i. Adjoin all coefficients of these
multipliers to R₀, forming the subring generated by R₀ and this finite set. It is finite
type over the finite type integer algebra R₀, hence over ℤ. Map f₀ and G into this
subring using its inclusion of R₀. Injectivity into R gives the same polynomial identity
in this subring. Modulo the equations the selected G_j generate 1, so every prime avoids
one of them. If the indexing type is empty, the identity is 1 in the equation ideal,
so the descended quotient is zero and its spectrum is empty. -/
theorem exists_finiteType_principal_cover_model
    (R : Type u) [CommRing R] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) R)
    (R₀ : Subring R) (hR₀ : Algebra.FiniteType ℤ R₀)
    (f₀ : Fin c → MvPolynomial (Fin n) R₀)
    (hf₀ : ∀ i, MvPolynomial.map R₀.subtype (f₀ i) = f i)
    (ι : Type v) (G : ι → MvPolynomial (Fin n) R₀)
    (hcover : ∀ q : PrimeSpectrum (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)),
      ∃ j, Ideal.Quotient.mk (Ideal.span (Set.range f))
        (MvPolynomial.map R₀.subtype (G j)) ∉ q.asIdeal) :
    ∃ (R₁ : Subring R) (h₀₁ : R₀ ≤ R₁), Algebra.FiniteType ℤ R₁ ∧
      ∀ q : PrimeSpectrum (MvPolynomial (Fin n) R₁ ⧸
        Ideal.span (Set.range (fun i ↦ MvPolynomial.map (Subring.inclusion h₀₁) (f₀ i)))),
        ∃ j, Ideal.Quotient.mk
          (Ideal.span (Set.range (fun i ↦ MvPolynomial.map (Subring.inclusion h₀₁) (f₀ i))))
          (MvPolynomial.map (Subring.inclusion h₀₁) (G j)) ∉ q.asIdeal := by
  classical
  let : Algebra R₀ R := R₀.subtype.toAlgebra
  let := hR₀
  let S := MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)
  let g : ι → S := fun j ↦ Ideal.Quotient.mk _ (MvPolynomial.map R₀.subtype (G j))
  have hunit : Ideal.span (Set.range g) = ⊤ := by
    apply PrimeSpectrum.iSup_basicOpen_eq_top_iff.mp
    apply top_unique
    intro q _
    obtain ⟨j, hj⟩ := hcover q
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨j, hj⟩
  obtain ⟨J, hJ, hu⟩ := (Ideal.span_eq_top_iff_finite (Set.range g)).mp hunit
  choose j hj using fun x : J ↦ hJ x.2
  have hu' : Ideal.span (Set.range (fun x : J ↦ (x : S))) = ⊤ := by
    convert hu using 2
    ext x
    simp
  obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.mp
    (show (1 : S) ∈ Ideal.span (Set.range (fun x : J ↦ (x : S))) by rw [hu']; trivial)
  choose H hH using fun x : J ↦ Ideal.Quotient.mk_surjective (b x)
  let t : MvPolynomial (Fin n) R :=
    1 - ∑ x : J, H x * MvPolynomial.map R₀.subtype (G (j x))
  have ht : t ∈ Ideal.span (Set.range f) := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    dsimp only [t]
    rw [map_sub, map_one, map_sum]
    simp only [map_mul, hH]
    change 1 - ∑ x : J, b x * g (j x) = 0
    simp only [hj]
    exact sub_eq_zero.mpr hb.symm
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp ht
  let C : Finset R := (Finset.univ.biUnion fun i ↦ (a i).coeffs) ∪
    (Finset.univ.biUnion fun x : J ↦ (H x).coeffs)
  let A₁ := Algebra.adjoin R₀ (C : Set R)
  let R₁ := A₁.toSubring
  have h₀₁ : R₀ ≤ R₁ := by
    intro r hr
    exact A₁.algebraMap_mem (⟨r, hr⟩ : R₀)
  let : Algebra R₀ R₁ := (Subring.inclusion h₀₁).toAlgebra
  have hFT : Algebra.FiniteType R₀ R₁ := Algebra.FiniteType.adjoin_of_finite C.finite_toSet
  have hFTZ : Algebra.FiniteType ℤ R₁ := Algebra.FiniteType.trans hR₀ hFT
  have hC : ∀ r ∈ C, r ∈ R₁ := fun r hr ↦ Algebra.subset_adjoin hr
  have haC (i : Fin c) : ((a i).coeffs : Set R) ⊆ Set.range R₁.subtype := by
    intro r hr
    exact ⟨⟨r, hC r (Finset.mem_union_left _ (Finset.mem_biUnion.mpr
      ⟨i, Finset.mem_univ i, hr⟩))⟩, rfl⟩
  have hHC (x : J) : ((H x).coeffs : Set R) ⊆ Set.range R₁.subtype := by
    intro r hr
    exact ⟨⟨r, hC r (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
      ⟨x, Finset.mem_univ x, hr⟩))⟩, rfl⟩
  choose a₁ ha₁ using fun i ↦ MvPolynomial.mem_range_map_iff_coeffs_subset.mpr (haC i)
  choose H₁ hH₁ using fun x ↦ MvPolynomial.mem_range_map_iff_coeffs_subset.mpr (hHC x)
  let f₁ := fun i ↦ MvPolynomial.map (Subring.inclusion h₀₁) (f₀ i)
  let G₁ := fun x : J ↦ MvPolynomial.map (Subring.inclusion h₀₁) (G (j x))
  have hf₁ (i) : MvPolynomial.map R₁.subtype (f₁ i) = f i := by
    dsimp only [f₁]
    rw [MvPolynomial.map_map]
    exact hf₀ i
  have hG₁ (x) : MvPolynomial.map R₁.subtype (G₁ x) =
      MvPolynomial.map R₀.subtype (G (j x)) := by
    dsimp only [G₁]
    rw [MvPolynomial.map_map]
    rfl
  have hid : ∑ i, a₁ i * f₁ i = 1 - ∑ x : J, H₁ x * G₁ x := by
    apply MvPolynomial.map_injective R₁.subtype R₁.subtype_injective
    simp only [map_sum, map_sub, map_one, map_mul, ha₁, hH₁, hf₁, hG₁]
    exact ha
  refine ⟨R₁, h₀₁, hFTZ, ?_⟩
  intro q
  by_contra! hq
  have hsum : ∑ x : J, Ideal.Quotient.mk (Ideal.span (Set.range f₁)) (H₁ x) *
      Ideal.Quotient.mk (Ideal.span (Set.range f₁)) (G₁ x) = 1 := by
    have he := congrArg (Ideal.Quotient.mk (Ideal.span (Set.range f₁))) hid
    have hfzero : ∀ i, Ideal.Quotient.mk (Ideal.span (Set.range f₁)) (f₁ i) = 0 :=
      fun i ↦ Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
    simp only [map_sum, map_mul, hfzero, mul_zero, Finset.sum_const_zero, map_sub,
      map_one] at he
    exact (sub_eq_zero.mp he.symm).symm
  have hone : (1 : MvPolynomial (Fin n) R₁ ⧸ Ideal.span (Set.range f₁)) ∈ q.asIdeal := by
    rw [← hsum]
    exact q.asIdeal.sum_mem fun x _ ↦ q.asIdeal.mul_mem_left _ (hq (j x))
  exact q.isPrime.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr hone)

end Algebra
