import Sheaf.Paper.FlatRingedIdealCompleteEquivalence
import Sheaf.Paper.IntegralModelsCoefficientPresentation
/-! # Reflection of local completeness under embedded scalar restriction

Source: blueprint main-20261015, integral models, proof steps 2 and 6.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace CategoryTheory.ConstantCompletion
private theorem complete_reflection {C : Type u} [SmallCategory C]
    (J : GrothendieckTopology C) (A : Type u) [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) (r : ℕ) (a : Fin r → A) (ha : Ideal.span (Set.range a) = I)
    (M : D (completed J A I)) :
    IsComplete (quotient J A I 0) ((dres (coefficientMap J A I)).obj M) ↔
      IsComplete (projection J A I 0) M := by
  let : HasDerivedCategory (Mod (constant J A)) := HasDerivedCategory.standard _
  let : HasDerivedCategory (Mod (completed J A I)) := HasDerivedCategory.standard _
  have : (dres (coefficientMap J A I)).ReflectsIsomorphisms :=
    siteDerivedRestrictScalars_reflectsIsomorphisms _
  obtain ⟨_, _, _, _, hR⟩ := koszul_quotient_reflector J A I false r a ha
  obtain ⟨_, _, _, _, hB⟩ := koszul_quotient_reflector J A I true r a ha
  obtain ⟨e, he⟩ := completion_restriction J A I
  simp only [finiteMap] at hR hB
  rw [← hR, ← hB]
  rw [← isIso_iff_of_reflects_iso _ (dres (coefficientMap J A I)), ← he M]
  exact (isIso_comp_right_iff _ (e.hom.app M)).symm
end CategoryTheory.ConstantCompletion
namespace AlgebraicGeometry.ProEtale
open WeilConjectures.SixFunctors
private theorem complete_of_iso
    {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    {R S : Sheaf J CommRingCat.{u}} (q : R ⟶ S)
    {M N : ConstantCompletion.D R} (e : M ≅ N)
    (h : ConstantCompletion.IsComplete q M) : ConstantCompletion.IsComplete q N := by
  let : HasDerivedCategory (ConstantCompletion.Mod R) := HasDerivedCategory.standard _
  let := fun U : C ↦ HasDerivedCategory.standard
    (ConstantCompletion.Mod (R.over U))
  intro U f hf
  exact (h U f hf).of_iso ((derivedInternalHom (J.over U) (R.over U)).mapIso
    ((Iso.refl _).prod ((ringedDerivedRestriction R U).mapIso e))).symm

/-- Restriction along the embedded scalar map preserves and reflects completeness
for every complex, without a boundedness or constructibility hypothesis.

Source: blueprint main-20261015, sk-lem-integral-models, proof step 6;
Stacks Tags 099I and 099L.
(blueprint: lem-sfb-embedded-integral-complete-reflection).

Proof: the ambient coefficient presentation identifies the two local completeness
predicates and scalar restriction with the canonical constant-to-quotient-limit model.
The quotient ideal is principal, generated by the lift of pi. The Koszul reflector
criterion identifies completeness with invertibility of its completion unit on each
side. The completion-restriction isomorphism intertwines those two units. Derived
restriction reflects isomorphisms because it leaves underlying additive cohomology
unchanged. Cancelling the invertible comparison proves the equivalence. Finally local
completeness is invariant under isomorphisms, since the derived internal-Hom vanishing
tests are invariant under isomorphisms. This includes unbounded and zero complexes. -/
theorem embeddedIntegral_complete_iff
    (ℓ : ℕ) [Fact ℓ.Prime] (E : PadicAlgCl.FiniteIntermediateField ℓ)
    (π : PadicAlgCl.integers ℓ E.1)
    (hπ : Ideal.span {π} = IsLocalRing.maximalIdeal (PadicAlgCl.integers ℓ E.1))
    (X : Scheme.{u}) [IsNoetherian X]
    (K : DerivedCategory.{u + 1} (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (integralCoefficientObject X ℓ E))) :
    IntegralModelsEmbedded.constantComplete ℓ E π X
      ((IntegralModelsEmbedded.restriction ℓ E X).obj K) ↔
      IntegralModelsEmbedded.completedComplete ℓ E π X K := by
  let A := ULift.{u + 1} (PadicAlgCl.integers ℓ E.1)
  let I : Ideal A := Ideal.map ULift.ringEquiv.symm.toRingHom (Ideal.span {π})
  let J := Scheme.coefficientProEtaleModelTopology.{u, u} X
  have : IsNoetherianRing A := isNoetherianRing_of_ringEquiv _ ULift.ringEquiv.symm
  have ha : Ideal.span (Set.range (fun _ : Fin 1 ↦ (ULift.up π : A))) = I := by
    simp only [Set.range_const, I, Ideal.map_span, Set.image_singleton]
    rfl
  obtain ⟨eB, eR, hB, hR, ⟨α⟩⟩ := embeddedIntegral_coefficient_presentation ℓ E π hπ X
  rw [hR, hB]
  let e := α.app K
  exact (Iff.intro (complete_of_iso _ e.symm) (complete_of_iso _ e)).trans
    (CategoryTheory.ConstantCompletion.complete_reflection J A I 1 _ ha (eB.functor.obj K))
end AlgebraicGeometry.ProEtale
