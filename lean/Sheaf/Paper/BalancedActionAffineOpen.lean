module

public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import WeilConjectures.AlgebraicGeometry.Cohomology.Defs
import Mathlib.AlgebraicGeometry.Morphisms.Flat
import Sheaf.Paper.AffineBaseChangeSectionsInduction

/-! # A balanced action on one affine open

Source: Stacks Project, Tags 01LX (2)-(3), 01SB and 0897.
(blueprint: lem-weil-pbc-balanced-action-affine-open).
-/

@[expose] public section

set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
namespace AlgebraicGeometry
open scoped IsMulCommutative

/-- On a single affine open the two factor actions extend uniquely.

Source: Stacks Project, Tags 01LX (2)-(3) and 0897, relative-spectrum paragraph;
tensor universal-property calculation underlying Tag 01SB.
(blueprint: lem-weil-pbc-balanced-action-affine-open).

Proof: Put D = O_X(U) and N = M(U). Mathlib's affine pushout-section theorem
identifies the section ring O_Y(pi inverse U) as the pushout of D and the
global sections of Spec B over those of Spec A. Evaluate rho on U to get a
ring homomorphism to additive endomorphisms of N. D-linearity shows that its
image commutes with the scalar-multiplication image of D. Each image is
commutative, so the subring generated by their union is a commutative ring.
Corestrict the two actions to this subring. The scalar hypothesis, evaluated
on U, and naturality of the global-sections/Spec isomorphism show they agree
over the global sections of Spec A. Descend through the pushout, then compose
with the subring inclusion to obtain the required action. The two pushout
projection identities give the two displayed generator identities. For any
other action, apply affineBaseChange_sections_induction to equality on every
module element: equality holds on the two factor generators and is preserved
under addition and multiplication. This proves uniqueness, including zero
rings, zero modules and the empty affine open. Quasi-coherence is unnecessary.
No restriction compatibility between different affine opens is claimed here. -/
theorem balancedAction_affine_open
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    (M : X.Modules) (_hM : M.IsQuasicoherent)
    (rho : B →+* End M)
    (hscalar : ∀ a : A, rho (algebraMap A B a) =
      M.smulHom (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a))
    (U : X.affineOpens) :
    let g := Spec.map (CommRingCat.ofHom (algebraMap A B))
    let Y := pullback f g
    let pi : Y ⟶ X := pullback.fst f g
    let fB : Y ⟶ Spec (.of B) := pullback.snd f g
    let C := (TopCat.Sheaf.pushforward CommRingCat.{u} pi.base).obj Y.sheaf
    ∃! tau : C.obj.obj (op U.val) →+* AddMonoid.End (M.val.obj (op U.val)),
      (∀ (r : X.presheaf.obj (op U.val)) (x : M.val.obj (op U.val)),
        tau (pi.app U.val r) x = r • x) ∧
      (∀ (b : B) (x : M.val.obj (op U.val)),
        tau (Y.presheaf.map (homOfLE (le_top (a := pi ⁻¹ᵁ U.val))).op
          (((Scheme.ΓSpecIso (.of B)).inv ≫ fB.appTop).hom b)) x =
            (rho b).val.app (op U.val) x) := by
  classical
  dsimp only
  let g := Spec.map (CommRingCat.ofHom (algebraMap A B))
  let Y := pullback f g
  let pi : Y ⟶ X := pullback.fst f g
  let fB : Y ⟶ Spec (.of B) := pullback.snd f g
  let W := pi ⁻¹ᵁ U.val
  let D := X.presheaf.obj (op U.val)
  let N := M.val.obj (op U.val)
  let dact : D →+* AddMonoid.End N := Module.toAddMonoidEnd D N
  let bact : B →+* AddMonoid.End N :=
    { toFun := fun b ↦ ((rho b).val.app (op U.val)).hom.toAddMonoidHom
      map_one' := by rw [map_one]; rfl
      map_zero' := by rw [map_zero]; rfl
      map_add' := fun b c ↦ by rw [map_add]; rfl
      map_mul' := fun b c ↦ by rw [map_mul]; rfl }
  have hcomm : ∀ x ∈ Set.range dact ∪ Set.range bact,
      ∀ y ∈ Set.range dact ∪ Set.range bact, x * y = y * x := by
    rintro x (⟨d, rfl⟩ | ⟨b, rfl⟩) y (⟨e, rfl⟩ | ⟨c, rfl⟩)
    · rw [← map_mul, ← map_mul, mul_comm]
    · ext n
      exact (((rho c).val.app (op U.val)).hom.map_smul d n).symm
    · ext n
      exact ((rho b).val.app (op U.val)).hom.map_smul e n
    · rw [← map_mul, ← map_mul, mul_comm]
  let S := Subring.closure (Set.range dact ∪ Set.range bact)
  have : IsMulCommutative S := Subring.isMulCommutative_closure hcomm
  let : CommRing S := inferInstance
  let left : D ⟶ CommRingCat.of S := CommRingCat.ofHom
    (dact.codRestrict S fun d ↦ Subring.subset_closure (Or.inl ⟨d, rfl⟩))
  let rightB : B →+* S :=
    bact.codRestrict S fun b ↦ Subring.subset_closure (Or.inr ⟨b, rfl⟩)
  let right : (Spec (.of B)).presheaf.obj (op ⊤) ⟶ CommRingCat.of S :=
    (Scheme.ΓSpecIso (.of B)).hom ≫ CommRingCat.ofHom rightB
  have hw : W = pi ⁻¹ᵁ U.val ⊓ fB ⁻¹ᵁ ⊤ := by simp [W]
  have hs : IsIso (pushoutSection (IsPullback.of_hasPullback f g)
      (show ⊤ ≤ g ⁻¹ᵁ ⊤ by simp)
      (show U.val ≤ f ⁻¹ᵁ ⊤ by simp) hw) :=
    isIso_pushoutSection_of_isAffineOpen _ _ _ _
      (isAffineOpen_top (Spec (.of A))) (isAffineOpen_top (Spec (.of B))) U.property
  have hp := (isIso_pushoutSection_iff (IsPullback.of_hasPullback f g)
    (show ⊤ ≤ g ⁻¹ᵁ ⊤ by simp)
    (show U.val ≤ f ⁻¹ᵁ ⊤ by simp) hw).mp hs
  have hc : f.appLE ⊤ U.val (by simp) ≫ left = g.appLE ⊤ ⊤ (by simp) ≫ right := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro z
    apply Subtype.ext
    obtain ⟨a, rfl⟩ := (ConcreteCategory.bijective_of_isIso
      (Scheme.ΓSpecIso (.of A)).inv).2 z
    have hg := CategoryTheory.congr_fun
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap A B))) a
    have hsa := hscalar a
    ext n
    change (f.appLE ⊤ U.val (by simp)
      ((Scheme.ΓSpecIso (.of A)).inv a)) • n =
      (rho ((Scheme.ΓSpecIso (.of B)).hom
        (g.appLE ⊤ ⊤ (by simp) ((Scheme.ΓSpecIso (.of A)).inv a)))).val.app (op U.val) n
    have hg' : g.appLE ⊤ ⊤ (by simp) ((Scheme.ΓSpecIso (.of A)).inv a) =
        (Scheme.ΓSpecIso (.of B)).inv (algebraMap A B a) := by
      change (Scheme.ΓSpecIso (.of B)).inv (algebraMap A B a) =
        g.appTop ((Scheme.ΓSpecIso (.of A)).inv a) at hg
      have htop : g.appLE ⊤ ⊤ (by simp) = g.appTop := by
        simp [Scheme.Hom.appLE]
      rw [htop]
      exact hg.symm
    rw [hg']
    simp only [Iso.inv_hom_id_apply]
    rw [hsa]
    rfl
  let lift := hp.desc left right hc
  let tau : Y.presheaf.obj (op W) →+* AddMonoid.End N := S.subtype.comp lift.hom
  have hd (d : D) (x : N) : tau (pi.app U.val d) x = d • x := by
    have he := CategoryTheory.congr_fun (hp.inl_desc left right hc) d
    change lift (pi.appLE U.val W (by simp [W]) d) = left d at he
    change (lift (pi.app U.val d)).val x = d • x
    rw [pi.app_eq_appLE, he]
    rfl
  have hb (b : B) (x : N) : tau (Y.presheaf.map
      (homOfLE (le_top (a := W))).op
      (((Scheme.ΓSpecIso (.of B)).inv ≫ fB.appTop).hom b)) x =
        (rho b).val.app (op U.val) x := by
    have he := CategoryTheory.congr_fun (hp.inr_desc left right hc)
      ((Scheme.ΓSpecIso (.of B)).inv b)
    change lift (fB.appLE ⊤ W (by simp) ((Scheme.ΓSpecIso (.of B)).inv b)) =
      right ((Scheme.ΓSpecIso (.of B)).inv b) at he
    have hr : right ((Scheme.ΓSpecIso (.of B)).inv b) = rightB b := by
      simp [right]
    rw [hr] at he
    change (lift _).val x = _
    have he' : fB.appLE ⊤ W (by simp) ((Scheme.ΓSpecIso (.of B)).inv b) =
        Y.presheaf.map (homOfLE (le_top (a := W))).op
          (((Scheme.ΓSpecIso (.of B)).inv ≫ fB.appTop).hom b) := by
      simp [Scheme.Hom.appLE]
    rw [← he', he]
    rfl
  refine ⟨tau, ⟨hd, hb⟩, ?_⟩
  intro tau' ht
  ext r x
  have he : ∀ r : Y.presheaf.obj (op W), ∀ x : N, tau' r x = tau r x := by
    apply affineBaseChange_sections_induction f U
    · intro d x
      exact (ht.1 d x).trans (hd d x).symm
    · intro b x
      exact (ht.2 b x).trans (hb b x).symm
    · intro r s hr hs x
      rw [map_add, map_add]
      change tau' r x + tau' s x = tau r x + tau s x
      rw [hr, hs]
    · intro r s hr hs x
      rw [map_mul, map_mul]
      change tau' r (tau' s x) = tau r (tau s x)
      rw [hr, hs]
  exact he r x

end AlgebraicGeometry
