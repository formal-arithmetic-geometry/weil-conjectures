/-!
# Prime-field tensor generators for constructible complexes

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, Expose XVII,
Propositions 7.4.1 and 7.4.6, pp. 305--308
(blueprint: lem-per-prime-field-tensor-devissage).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Etale

/-- Tensor a prime-field module sheaf with a fixed coefficient module, with its action
on the first tensor factor. It is sheafification of the sectionwise mixed tensor
`N ⊗_A (A ⊗_Λ -)`, canonically `N ⊗_Λ -`.
Source: ILO XVII, 7.4.1, pp. 305, 308
(blueprint: lem-per-prime-field-tensor-devissage). -/
noncomputable def primeFieldTensorSheaf (X : Scheme.{u}) (ℓ : ℕ)
    (A : Type (u + 1)) [CommRing A] [Algebra (ULift.{u + 1} (ZMod ℓ)) A]
    (N : ModuleCat.{u + 1} A) :
    Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} (ULift.{u + 1} (ZMod ℓ))) ⥤
      Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} A) :=
  sheafToPresheaf X.smallEtaleTopology _ ⋙
    (Functor.whiskeringRight _ _ _).obj
      ((ModuleCat.mixedTensor (algebraMap (ULift.{u + 1} (ZMod ℓ)) A)).obj N) ⋙
    presheafToSheaf X.smallEtaleTopology _

/-- The sectionwise tensor and sheafification preserve zero morphisms.
Source: ILO XVII, 7.4.1 (blueprint: lem-per-prime-field-tensor-devissage).
Proof: on every etale object the zero natural transformation is sent to zero by
ModuleCat.mixedTensor_obj_preservesZeroMorphisms. Sheafification is additive and
therefore preserves the resulting zero natural transformation. -/
@[instance] theorem primeFieldTensorSheaf_preservesZeroMorphisms
    (X : Scheme.{u}) (ℓ : ℕ) (A : Type (u + 1)) [CommRing A]
    [Algebra (ULift.{u + 1} (ZMod ℓ)) A] (N : ModuleCat.{u + 1} A) :
    (primeFieldTensorSheaf X ℓ A N).PreservesZeroMorphisms := by
  sorry

/-- Tensor generators, using all representative complexes of bounded constructible
prime-field objects. Over the field `Λ`, the degree-zero sheaf `N_X` is K-flat, so
termwise tensor computes `N_X ⊗^L_Λ F`. The isomorphism is in the A-linear derived
category, and the mixed tensor fixes the A-action through N.
Source: ILO XVII, 7.4.1 and 7.4.6, pp. 305--308
(blueprint: lem-per-prime-field-tensor-devissage). -/
def primeFieldTensorGenerators (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime]
    (A : Type (u + 1)) [CommRing A] [Algebra (ULift.{u + 1} (ZMod ℓ)) A] :
    ObjectProperty (DerivedCategoryModule A X) :=
  fun K ↦ ∃ (N : ModuleCat.{u + 1} A), Module.Finite A N ∧
    ∃ C : CochainComplex
        (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} (ULift.{u + 1} (ZMod ℓ)))) ℤ,
      DerivedCategory.isBoundedConstructible (ULift.{u + 1} (ZMod ℓ)) X
        (_root_.DerivedCategory.Q.obj C) ∧
      Nonempty (K ≅ _root_.DerivedCategory.Q.obj
        (((primeFieldTensorSheaf X ℓ A N).mapHomologicalComplex (.up ℤ)).obj C))

/-- Constructible complexes over a Noetherian prime-field algebra are exactly the thick
subcategory generated by mixed tensors with finite coefficient modules.
Source: ILO XVII, 7.4.1 and 7.4.6, pp. 305--308
(blueprint: lem-per-prime-field-tensor-devissage).

Proof:
1. The weak Serre theorem lem-sfb-discrete-noetherian-constructible-serre and the
   global comparison lem-sfb-noetherian-global-constructibility show closure of
   constructible cohomology under kernels, cokernels and extensions. The long exact
   sequence lem-sf-derived-homology-long-exact gives closure under cones. Shifts and
   finite sums preserve boundedness. A retract has cohomology the image of an
   idempotent, or equivalently the kernel of one minus that idempotent.
2. By lem-pod-etale-stalk-tensor-scalar and prop-weil-pbc-geometric-stalks-exact,
   tensoring with N_X is exact: on stalks this is tensor over a field, and a short
   exact sequence of vector spaces splits. The degree-zero N_X is consequently
   K-flat. Tensoring a locally constant finite-dimensional sheaf with N has local
   model a finite direct sum of N, using lem-pod-lisse-tensor-and-scalar-extension
   and geometric stalk detection. Thus every generator is bounded constructible.
3. Apply lem-per-constructible-finite-monodromy-filtration to a constructible
   A-sheaf. Each quotient is an extension by zero k_!L from a stratum, and its
   short exact sequences give triangles by lem-sf-derived-ses-triangle.
4. For a finite Galois trivialization c:Y→S, use
   lem-per-galois-cover-module-descent with B=Λ[G], then apply
   lem-per-finite-algebra-external-tensor-filtration. Descent yields a filtration
   whose quotients are retracts of N_S tensor L_0. A simple B-module is finite
   dimensional since a nonzero vector gives a surjection B→V.
5. The stratum extension k_!=j_!i_* is exact, by
   lem-weil-pbc-extension-by-zero-exact and lemma-weil-pbc-finite-stalk-formula,
   so it preserves these filtrations and retractions.
6. Set F_0=k_!L_0. The extension-by-zero stalk formulas make it constructible.
   Construct N_X tensor k_!L_0 → k_!(N_S tensor L_0) on sections and sheafify.
   It is the identity tensor map on S and 0→0 elsewhere, hence an isomorphism
   by lem-weil-pbc-sets-etale-iso-on-geometric-stalks. Its source computes the
   derived tensor by step 2, so every quotient is a retract of a generator.
7. Induct on the two finite filtrations using their short exact triangles,
   including the empty filtration, to obtain every constructible sheaf in degree 0.
8. Use lem-weil-pbc-truncation-cohomology and lem-weil-pbc-truncation-triangle:
   starting from the zero truncation below the cohomology interval, successively
   attach H^q(K)[-q]. The final truncation is isomorphic to K. This proves the
   reverse inclusion and hence equality. -/
theorem primeFieldTensor_devissage (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) [IsNoetherian X] (A : Type (u + 1)) [CommRing A]
    [IsNoetherianRing A] [Algebra (ULift.{u + 1} (ZMod ℓ)) A] :
    DerivedCategory.boundedConstructible (ModuleCat.{u + 1} A) X =
      (primeFieldTensorGenerators X ℓ A).triangEnvelope := by
  sorry

end AlgebraicGeometry.Etale
