module
public import Sheaf.Paper.ConstantCompletionBasic
/-! Kernel component of the completion projection formula.
Source: Stacks Project, Tag 093M (blueprint: new-e2-constant-completion-projection-kernel).
The sectionwise quotient argument identifies the kernel of each completion projection
with the ideal generated by the coefficient sections. -/
@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits Opposite
universe u
namespace CategoryTheory.ConstantCompletion
variable {C : Type u} [SmallCategory C]
/--
Source: Stacks Project, Tag 093M (blueprint: new-e2-constant-completion-projection-kernel).
Proof: apply the sectionwise finite tensor comparison to the projection. Its zero
class is exactly the image of `I^(n+1)` in the completed section ring; finite
Noetherian generation identifies that image with the span of the displayed
`algebraSection` values.
-/
theorem flat_and_quotients_projection_kernel (J : GrothendieckTopology C) (A : Type u)
    [CommRing A] [IsNoetherianRing A] (I : Ideal A) :
    ∀ (n : ℕ) (U : C),
      RingHom.ker ((projection J A I n).hom.app (op U)).hom =
        Ideal.span (Set.range (fun a : ↥(I ^ (n + 1)) ↦
          (algebraSection (coefficientMap J A I) a).val (op U))) := by
  sorry
end CategoryTheory.ConstantCompletion
