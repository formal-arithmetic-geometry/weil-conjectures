module

public import Sheaf.Paper.IntegralUniformCoefficient
public import Sheaf.Paper.IntegralScalarExtensionWellDefined
public import Sheaf.Paper.PbcActualScalarPullback

/-!
# Actual finite coefficient maps and their normalized restriction comparison

Source: blueprint main-20261015, prop-weil-pbc-scalar-extension, coefficient maps;
Bhatt--Scholze, Proposition 6.8.14; Stacks Tags 03EL and 0D6D
(blueprint: def-weil-pbc-actual-finite-coefficient-transport).

The integer inclusion is the existing restriction of the field embedding. Quotient
maps use the actual valuation rings and the recorded adic ideals. Finite projections
fix the completed map uniquely. Its restriction comparison specializes the existing
ordinary-adjunction and flat-term K-flat normalization, without new choices.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxSize 4096

universe u
-- Avoid underdetermined max-universe instances from the auxiliary operations framework.
-- The fixed-size PBC instances still provide the same canonical structures.
attribute [-instance] WeilConjectures.integralOperationsAbSheafify
attribute [-instance] WeilConjectures.integralOperationsAbLocallyBijective
attribute [-instance] WeilConjectures.integralOperationsSiteSmall
attribute [-instance] WeilConjectures.integralOperationsCommHasDerivedCategory
open CategoryTheory CategoryTheory.Limits Opposite
open scoped ChangeOfRings
namespace AlgebraicGeometry.Scheme

variable (l : ℕ) [Fact l.Prime]
  (E F : Type (u + 1)) [Field E] [Field F]
  [Algebra (Padic l) E] [Algebra (Padic l) F]
  [FiniteDimensional (Padic l) E] [FiniteDimensional (Padic l) F]
  (i : E →ₐ[Padic l] F)

/-- Integer inclusion kills the source ideal power in the same-index target quotient.
Source: Bhatt--Scholze 6.8.14; blueprint scalar-extension coefficient construction
(blueprint: def-weil-pbc-actual-finite-coefficient-transport).
Proof: valuation preservation sends the source maximal ideal into the target maximal
ideal. Both ideals are generated by the recorded uniformizers. Take their (n+1)-st
powers and apply the quotient map, as in integralScalar_quotient_kernel. -/
theorem finiteFreeCoefficientQuotientKernel (n : ℕ)
    (x : Padic.coefficientExtensionIntegers l E)
    (hx : x ∈ (pbcPadicCoefficientDatum l E).ideal ^ (n + 1)) :
    Ideal.Quotient.mk ((pbcPadicCoefficientDatum l F).ideal ^ (n + 1))
      (WeilConjectures.integralScalarIntegerInclusion l E F i x) = 0 := by
  sorry

/-- Quotient inclusion on the actual, unlifted integer rings.
Source: blueprint scalar-extension coefficient construction
(blueprint: def-weil-pbc-actual-finite-coefficient-transport). -/
def finiteFreeCoefficientQuotientMap (n : ℕ) :
    (Padic.coefficientExtensionIntegers l E ⧸
      (pbcPadicCoefficientDatum l E).ideal ^ (n + 1)) →+*
      (Padic.coefficientExtensionIntegers l F ⧸
      (pbcPadicCoefficientDatum l F).ideal ^ (n + 1)) :=
  Ideal.Quotient.lift ((pbcPadicCoefficientDatum l E).ideal ^ (n + 1))
    ((Ideal.Quotient.mk ((pbcPadicCoefficientDatum l F).ideal ^ (n + 1))).comp
      (WeilConjectures.integralScalarIntegerInclusion l E F i))
    (finiteFreeCoefficientQuotientKernel l E F i n)

/-- The coefficient map is uniquely determined by its finite quotient projections.
Source: blueprint scalar-extension coefficient construction; Bhatt--Scholze 6.6.11
(blueprint: def-weil-pbc-actual-finite-coefficient-transport).
Proof: postcomposition of continuous component functions with the quotient inclusions
commutes with reduction. Sheafify to obtain a morphism of the two inverse systems.
The limit universal property supplies its unique map with these projections. -/
theorem finiteFreeCompletedCoefficientMap_existsUnique (T : Scheme.{u}) :
    ∃! c : pbcAdicCompletion T (pbcPadicCoefficientDatum l E) ⟶
        pbcAdicCompletion T (pbcPadicCoefficientDatum l F),
      ∀ n : ℕ, c ≫ pbcAdicProjection T (pbcPadicCoefficientDatum l F) n =
        pbcAdicProjection T (pbcPadicCoefficientDatum l E) n ≫
          AdicCoefficients.coefficientMap T (finiteFreeCoefficientQuotientMap l E F i n) := by
  sorry

/-- The unique residue-normalized completed ring map induced by the field embedding.
Source: blueprint scalar-extension coefficient construction
(blueprint: def-weil-pbc-actual-finite-coefficient-transport). -/
def finiteFreeCompletedCoefficientMap (T : Scheme.{u}) :=
  (finiteFreeCompletedCoefficientMap_existsUnique l E F i T).exists.choose

/-- The existing universal derived change of rings along that completed coefficient map.
Source: Stacks 06YY; blueprint scalar extension
(blueprint: def-weil-pbc-actual-finite-coefficient-transport). -/
abbrev finiteFreeCompletedScalar (T : Scheme.{u}) :=
  pbcDerivedExtend (finiteFreeCompletedCoefficientMap l E F i T)

/-- Completed scalar maps commute with the canonical completed structure maps.
Source: Stacks 03EL; blueprint scalar-extension local restriction
(blueprint: def-weil-pbc-actual-finite-coefficient-transport).
Proof: compose the square with each finite target quotient. Both maps are induced
by the same integer inclusion followed by the same quotient and inverse-image unit.
Joint monicity of the limit projections proves equality. -/
theorem finiteFreeCompletedCoefficientMap_naturality {X Y : Scheme.{u}} (g : X ⟶ Y) :
    pbcActualCoefficientRingMap Y (finiteFreeCompletedCoefficientMap l E F i Y) ≫
        pbcActualStructureMap g (pbcPadicCoefficientDatum l F) =
      pbcActualStructureMap g (pbcPadicCoefficientDatum l E) ≫
        (proEtaleSheafDirectImage g RingCat.{u + 1}).map
          (pbcActualCoefficientRingMap X (finiteFreeCompletedCoefficientMap l E F i X)) := by
  sorry

/-- The published, K-flat-normalized scalar/pullback comparison for these coefficients.
Taking g to be a stratum immersion composed with a covering member keeps both fixed.
Source: Stacks 03EL and 0D6D
(blueprint: def-weil-pbc-actual-finite-coefficient-transport). -/
def finiteFreeScalarRestriction {X Y : Scheme.{u}} (g : X ⟶ Y) :=
  pbcActualScalarDerivedPullIso g (pbcPadicCoefficientDatum l E)
    (pbcPadicCoefficientDatum l F) (finiteFreeCompletedCoefficientMap l E F i Y)
    (finiteFreeCompletedCoefficientMap l E F i X)
    (finiteFreeCompletedCoefficientMap_naturality l E F i g)

end AlgebraicGeometry.Scheme
