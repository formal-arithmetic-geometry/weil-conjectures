module

public import Sheaf.Paper.FiniteSmoothGammaConstructions

/-! # A constituent of finite smooth normalization -/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.Functor

noncomputable section

namespace AlgebraicGeometry.Etale

/-- The rank-zero Rees deformation and integration preserve section coordinates.
Source: the proof of lem-pur-finite-smooth-gamma-normalization, Steps 2 and 4--7;
sk-thm-dnc, Local construction and Gluing; rank-zero vector integration convention.
(blueprint: lem-pur-finite-smooth-deformation-coordinates).

Proof: the etale separated diagonal is open and closed in X times_Y X. On its
component its ideal is zero, and on the complement the ideal is the whole ring.
Thus the actual normal cone is X, with projection inverse to its zero section.
The extended Rees algebras on the two components are O_X[t] and O_V[t,t^-1].
They glue to A1_X disjoint union (V times Gm), compatibly with parameter and section.
These maps are separated, etale and finite type over Noetherian schemes; Nagata
gives the required compactification. The section ideal is generated by the empty
regular sequence near the section. Apply existsUnique_normalized for d=0 to obtain
its normalized comparison kappa. The graph-normalized sum adjunction computes
both fibre mates as the identity in section coordinates; normalization at one
and uniqueness make kappa constant in these coordinates. Reading it at zero proves
the deformation equality. Rank-zero integration is the identity-adjunction trace.
Transport it through the actual normal projection and its inverse zero section;
the exceptional mate and the adjoint-uniqueness counit equation give the last
equality. No choice of an unnormalized comparison occurs. Empty components and
empty X are included in this computation. -/
theorem finiteSmoothDeformation_coordinates
    (ell n : ℕ) [Fact ell.Prime] (hn : 1 ≤ n)
    {X Y : Scheme.{u}} [IsNoetherian X] [IsNoetherian Y]
    (hX : ∀ x : X, IsUnit (ell : X.presheaf.stalk x))
    (hY : ∀ y : Y, IsUnit (ell : Y.presheaf.stalk y))
    (f : X ⟶ Y) [Etale f] [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f]
    [HasCompactification f]
    (N : FiniteSmoothCompactSupportComparisons (NoetherianSectionSpecialization.Coeff ell n))
    (hN : FiniteSmoothComparisonNormalized (NoetherianSectionSpecialization.Coeff ell n) N) :
    ∃ G : FiniteSmoothGammaData (NoetherianSectionSpecialization.Coeff ell n) f,
      finiteSmoothDeformationFactor _ f G ≫ (finiteSmoothNormalCoordinates _ N f G).hom =
          (finiteSmoothSectionCoordinates _ N (pullback.fst f f) (pullback.diagonal f)).hom ∧
        finiteSmoothRankZeroFactor _ f G = (finiteSmoothNormalCoordinates _ N f G).hom :=
  by sorry

end AlgebraicGeometry.Etale
