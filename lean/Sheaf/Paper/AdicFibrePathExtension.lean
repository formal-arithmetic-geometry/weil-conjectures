module

public import Sheaf.Paper.FibreFunctorBasepointTransportData
public import Sheaf.Paper.IntegralFibrePathConstruction
import Sheaf.Paper.AlgebraicFibrePathConstruction
import Sheaf.Paper.RationalFibrePathScalarSquare

/-! # Extension of finite fibre paths to adic coefficients

Source: Deligne, Weil II (1.1.1) b)-d), pp.146-147.
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.Scheme

/-- A normalized integral path family extends to rational and algebraic coefficients,
with the canonical integral and rational scalar comparisons.
Source: Deligne, Weil II (1.1.1) b)-d), pp.146-147; steps 7--9 of
`lem-wf-fibre-functor-basepoint-transport`.
(blueprint: new-e5-adic-fibre-path-extension).

Proof: keep the supplied integral maps unchanged. For an inclusion of finite coefficient
fields use the prescribed ceiling reindexing and the existing integral scalar fibre
comparison. Its germ formula sends a pure tensor to the germ of the recorded scalar
generator. The integral evaluation formula identifies its two path routes with the
finite paths on the source and target levels. The finite scalar square, transported
through the quotient-ring presentations of those levels, equates those routes on every
pure generator. The scalar adjunction determines the linear maps on these generators,
and all limit projections together determine a map to the target fibre. This gives the
integral scalar square with exactly the specified germ normalization.

Rationalize the supplied integral maps. A rational Hom space is the tensor product of
an integral Hom space with the field, and its fibre map has the prescribed pure-tensor
formula. Integral naturality followed by tensor additivity therefore proves naturality
on all rational morphisms, including changes of lattice. Tensor associativity and the
integral scalar comparison give the rational scalar comparison, its formula on nested
pure tensors and its path square. Identity and composition are preserved by tensoring.

Extend the rational map of each finite coefficient model to the fixed algebraic closure.
Every arrow in the model localization is generated by model arrows and inverses of
coefficient-extension arrows. Rational naturality handles model arrows, and the scalar
square handles coefficient arrows and their inverses. Hence the maps descend to natural
isomorphisms on the localization. Their evaluation on every displayed finite model is
the required algebraic tensor formula. The identity and composition laws hold on models
and hence on all localized objects. Evaluate these laws on t inverse followed by a loop
followed by t, and on s = t followed by (t inverse followed by s), to obtain the remaining
conjugation and change fields. Combining these maps with the canonical scalar comparisons
and the supplied integral family yields the record, whose integral field is that family.
-/
theorem adic_fibre_path_transport_of_integral {Y : Scheme.{u}}
    (l : ℕ) [Fact l.Prime] [IsNoetherian Y] [Y.IsSeparated]
    [∀ x : Y, Invertible (l : Y.residueField x)]
    (Q : Type (u + 1)) [Field Q] [Algebra ℚ_[l] Q] [IsAlgClosure ℚ_[l] Q]
    (i : IntegralFibrePathTransport l Y Q) :
    ∃ a : AdicFibrePathTransport l Y Q, a.integral = i.linear  := by
  let paths : AdicFibrePathData l Y Q := {
    integral := i.linear
    rational := fun E ↦ rationalFibrePathFamily l E.val Y (i.linear E)
    algebraic := algebraicFibrePathFamily l Y Q i }
  let scalar : AdicFibreScalarData l Y Q := {
    toAdicFibrePathData := paths
    integralScalar := fun y E L h ↦
      integralFibreScalarIso l Y y E.val L.val (IntermediateField.inclusion h)
    rationalScalar := by
      intro Ω _ _ y E L h _ ha
      exact rationalFibreScalarIso l Y y E.val L.val (IntermediateField.inclusion h) ha }
  refine ⟨{
    toAdicFibreScalarData := scalar
    integral_evaluation := ?_
    rational_evaluation := ?_
    algebraic_evaluation := ?_
    integralScalar_germ := ?_
    integralScalar_path := ?_
    rationalScalar_tensor := ?_
    rationalScalar_path := ?_ }, rfl⟩
  · unfold adicIntegralPathEvaluation
    exact @i.evaluation
  · unfold adicRationalPathEvaluation
    intro Ωy _ _ y Ωz _ _ z t E F a x
    exact rationalFibrePathFamily_evaluation l E.val Y (i.linear E) y z t F a x
  · unfold adicAlgebraicPathEvaluation
    intro Ωy _ _ y Ωz _ _ z t E F a x
    exact algebraicFibrePathFamily_evaluation l Y Q i y z t E F a x
  · unfold adicIntegralScalarGerm
    intro Ω _ _ y E L h F m U ξ b x s hs
    exact integralFibreScalarIso_germ l Y y E.val L.val (IntermediateField.inclusion h)
      F m U ξ b x s hs
  · unfold adicIntegralScalarPath
    intro Ωy _ _ y Ωz _ _ z t E L h F
    exact integralFibreScalarIso_path l Y Q i y z t E L h F
  · unfold adicRationalScalarTensor
    intro Ω _ _ y E L h _ ha F a b x
    exact rationalFibreScalarIso_tensor l Y y E.val L.val (IntermediateField.inclusion h)
      ha F a b x
  · unfold adicRationalScalarPath
    intro Ωy _ _ y Ωz _ _ z t E L h _ ha F
    exact rationalFibreScalarIso_path l Y Q i y z t E L h ha F

end AlgebraicGeometry.Scheme
