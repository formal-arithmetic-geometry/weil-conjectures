module

public import Sheaf.Paper.AdicStratifiedPerfect
public import Sheaf.AlgebraicGeometry.IntegralConstantCompletion

import Sheaf.NumberTheory.Padics.AdicLimitFiniteModules
import Mathlib.RingTheory.AdicCompletion.Topology

/-!
# Integral specialization of the adic stratified-perfect criterion

(blueprint: lem-sfb-integral-cohomological-adic-criterion-adic-bridge)
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme

/-- Canonical coefficient-sized pro-etale sheafification instance.
Source: Stacks Tag 03DA
(blueprint: lem-sfb-integral-cohomological-adic-criterion-adic-bridge). -/
instance (priority := 3000) integralCriterionWEqualsAdicBridge (X : Scheme.{u}) :
    (ProEt.topology X).WEqualsLocallyBijective AddCommGrpCat.{u + 1} :=
  GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall.{u, u + 1,
    u + 1, u + 2, u + 1} (ProEt.topology X)

/-- The chosen integral coefficient ring is complete Noetherian local, with the chosen
uniformizer ideal as its unique maximal ideal.
Source: Serre, Local Fields, Chapter II, §2; Stacks Tags 031B and 09B8.
(blueprint: lem-sfb-integral-cohomological-adic-criterion-adic-bridge).
Proof: take the DVR and its generator from the chosen coefficient datum. Completeness is
already supplied by finite-module adic completeness applied to the ring itself. Transport
these properties along the inverse of the ULift ring equivalence; ideal mapping sends the
generator to its lifted generator and preserves and reflects maximal ideals. -/
theorem integral_coefficient_hypotheses (l : ℕ) [Fact l.Prime]
    (E : Type u) [Field E] [Algebra (Padic l) E] [FiniteDimensional (Padic l) E] :
    IsNoetherianRing (ProEtale.IntegralConstantCompletion.integers l E) ∧
      ((ProEtale.IntegralConstantCompletion.ideal l E).IsMaximal ∧
        ∀ J : Ideal (ProEtale.IntegralConstantCompletion.integers l E),
          J.IsMaximal → J = ProEtale.IntegralConstantCompletion.ideal l E) ∧
      IsAdicComplete (ProEtale.IntegralConstantCompletion.ideal l E)
        (ProEtale.IntegralConstantCompletion.integers l E) := by
  let R := Padic.coefficientExtensionIntegers l E
  let J := Padic.coefficientExtensionMaximalIdeal l E
  let e : R ≃+* ProEtale.IntegralConstantCompletion.integers l E := ULift.ringEquiv.symm
  have h := (Padic.extension_integers_dvr l E
    (Padic.coefficientExtensionAbsoluteValue l E)
    (spectralNorm_extends (K := Padic l) (L := E))).choose_spec.choose_spec
  let : IsDiscreteValuationRing R := h.2.2.2.2.2.2.2.1
  have hgen : Ideal.span {Padic.coefficientExtensionUniformizer l E} = J :=
    h.2.2.2.2.2.2.2.2.2.2.2.2.2.1.choose_spec
  have hI : ProEtale.IntegralConstantCompletion.ideal l E = J.map e.toRingHom := by
    rw [← hgen, Ideal.map_span, Set.image_singleton]
    rfl
  let : IsNoetherianRing (ProEtale.IntegralConstantCompletion.integers l E) :=
    isNoetherianRing_of_ringEquiv R e
  let : IsAdicComplete J R :=
    ((Padic.finite_module_adic_complete_and_hom.{u, u, u} l E).1 R).1
  let : IsAdicComplete (ProEtale.IntegralConstantCompletion.ideal l E)
      (ProEtale.IntegralConstantCompletion.integers l E) := by
    rw [hI]
    exact (IsAdicComplete.congr_ringEquiv J e).mpr inferInstance
  have hmax : (ProEtale.IntegralConstantCompletion.ideal l E).IsMaximal := by
    rw [hI]
    exact Ideal.IsMaximal.map_bijective e.toRingHom e.bijective h.2.2.2.2.1
  have huniq : ∀ Q : Ideal (ProEtale.IntegralConstantCompletion.integers l E),
      Q.IsMaximal → Q = ProEtale.IntegralConstantCompletion.ideal l E := by
    intro Q hQ
    have hQ' : (Q.map e.symm.toRingHom).IsMaximal :=
      Ideal.IsMaximal.map_bijective e.symm.toRingHom e.symm.bijective hQ
    have heq : Q.map e.symm.toRingHom = J := h.2.2.2.2.2.1 _ hQ'
    rw [hI, ← heq]
    exact (Ideal.map_of_equiv e.symm).symm
  exact ⟨inferInstance, ⟨hmax, huniq⟩, inferInstance⟩

/-- For the integral completed coefficient ring, the general adic criterion
identifies stratified-perfect objects with adic-constructible objects. The
coefficient ring is the selected ring of integers of the finite extension and
the ideal is generated by its selected uniformizer. This is precisely the
specialization of Proposition 6.6.11 used in Proposition 6.8.11(3).
(blueprint: lem-sfb-integral-cohomological-adic-criterion-adic-bridge)
-/
theorem integral_stratified_perfect_iff_adic_constructible
    (l : ℕ) [Fact l.Prime]
    (E : Type u) [Field E] [Algebra (Padic l) E] [FiniteDimensional (Padic l) E]
    (X : Scheme.{u}) [IsNoetherian X]
    (K : DerivedCategory (proEtaleRingModules X
      (adicLisseCompletedRing X
        (ProEtale.IntegralConstantCompletion.ideal l E)))) :
    IsSfbStratifiedPerfect X
        (ProEtale.IntegralConstantCompletion.ideal l E) K ↔
      IsSfbAdicConstructible X
        (ProEtale.IntegralConstantCompletion.ideal l E) K := by
  have h := integral_coefficient_hypotheses l E
  have := h.1
  have := h.2.2
  exact ((adic_stratified_perfect X
    (ProEtale.IntegralConstantCompletion.integers l E)
    (ProEtale.IntegralConstantCompletion.ideal l E) h.2.1).1 K).symm

end AlgebraicGeometry.Scheme
