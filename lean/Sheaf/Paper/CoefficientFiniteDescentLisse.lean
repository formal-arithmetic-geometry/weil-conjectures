module

public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.Colimit.Compatibility
public import Sheaf.Paper.CoefficientHeartCommonStratification
public import Sheaf.NumberTheory.Padics.FiniteCoefficientFields
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PushforwardContinuous
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiSeparated
import Sheaf.CategoryTheory.SiteCoveringAxioms
import Sheaf.CategoryTheory.SheafTensor
import Sheaf.Algebra.Category.ModuleCat.Sheaf.CochainTensorUniverses
import Sheaf.CategoryTheory.SiteModuleSheafGluing
import Sheaf.Algebra.Category.ModuleCat.Sheaf.HomCoverGluing

/-!
# Finite coefficient descent of lisse modules and morphisms

Source: Weil blueprint, sec-six-functors-basics/sk-thm-sfb-qlbar-two-colimit,
`sk-lem-coefficient-finite-descent-lisse.md`, clauses (1)--(2)
(blueprint: det-lem-coefficient-finite-descent-lisse).

The Hom colimit is expressed by representatives modulo the equivalence generated by
scalar extension. Its canonical comparison is surjective, and equality of its values
is exactly that equivalence. All scalar comparisons below are the existing canonical
transitivity isomorphisms for ordinary extension of scalars.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale

variable (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime]

/-- The canonical direct-versus-iterated extension comparison at three finite fields.
Source: blueprint finite-descent-lisse, scalar-extension convention and proof step 2
(blueprint: det-lem-coefficient-finite-descent-lisse). -/
def lisseFiniteExtensionCompIso
    {E F H : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ)}
    (hEF : E ≤ F) (hFH : F ≤ H) :
    Mod.extendScalars (padicSubfieldRingObjMap X ℓ (hEF.trans hFH)) ≅
      Mod.extendScalars (padicSubfieldRingObjMap X ℓ hEF) ⋙
        Mod.extendScalars (padicSubfieldRingObjMap X ℓ hFH) :=
  Mod.extendScalarsIsoOfEq
    ((congrArg (fun a ↦ coefficientMap a X)
      (Profinite.padicSubfieldRingObjMap_comp ℓ hEF hFH)).trans
        (coefficientMap_comp (Profinite.padicSubfieldRingObjMap ℓ hEF)
          (Profinite.padicSubfieldRingObjMap ℓ hFH) X)) ≪≫
    Mod.extendScalarsComp (padicSubfieldRingObjMap X ℓ hEF)
      (padicSubfieldRingObjMap X ℓ hFH)

/-- The canonical direct-versus-iterated comparison for extension to the algebraic closure.
Source: blueprint finite-descent-lisse, scalar-extension convention and proof step 2
(blueprint: det-lem-coefficient-finite-descent-lisse). -/
def lisseAlgClExtensionCompIso
    {E F : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ)} (hEF : E ≤ F) :
    Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ E) ≅
      Mod.extendScalars (padicSubfieldRingObjMap X ℓ hEF) ⋙
        Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ F) :=
  Mod.extendScalarsIsoOfEq (padicSubfieldRingObjMap_comp_toPadicAlgCl X ℓ hEF).symm ≪≫
    Mod.extendScalarsComp (padicSubfieldRingObjMap X ℓ hEF)
      (padicSubfieldRingObjToPadicAlgCl X ℓ F)

/-- Scalar extension of a finite-field Hom representative to a larger finite field,
conjugated by the canonical comparisons to the direct scalar extensions of M and N.
Source: blueprint finite-descent-lisse, clause (2) and proof step 2
(blueprint: det-lem-coefficient-finite-descent-lisse). -/
def lisseFiniteHomTransition
    {E F H : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ)}
    (hEF : E ≤ F) (hFH : F ≤ H)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (padicSubfieldRingObj X ℓ E)}
    (φ : (Mod.extendScalars (padicSubfieldRingObjMap X ℓ hEF)).obj M ⟶
      (Mod.extendScalars (padicSubfieldRingObjMap X ℓ hEF)).obj N) :
    (Mod.extendScalars (padicSubfieldRingObjMap X ℓ (hEF.trans hFH))).obj M ⟶
      (Mod.extendScalars (padicSubfieldRingObjMap X ℓ (hEF.trans hFH))).obj N :=
  (lisseFiniteExtensionCompIso X ℓ hEF hFH).hom.app M ≫
    (Mod.extendScalars (padicSubfieldRingObjMap X ℓ hFH)).map φ ≫
      (lisseFiniteExtensionCompIso X ℓ hEF hFH).inv.app N

/-- The canonical map on a representative to Hom over the algebraic closure.
Source: blueprint finite-descent-lisse, clause (2) and proof step 2
(blueprint: det-lem-coefficient-finite-descent-lisse). -/
def lisseFiniteHomToAlgCl
    {E F : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ)} (hEF : E ≤ F)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (padicSubfieldRingObj X ℓ E)}
    (φ : (Mod.extendScalars (padicSubfieldRingObjMap X ℓ hEF)).obj M ⟶
      (Mod.extendScalars (padicSubfieldRingObjMap X ℓ hEF)).obj N) :
    (Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ E)).obj M ⟶
      (Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ E)).obj N :=
  (lisseAlgClExtensionCompIso X ℓ hEF).hom.app M ≫
    (Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ F)).map φ ≫
      (lisseAlgClExtensionCompIso X ℓ hEF).inv.app N

/-- Representatives (F, φ) in the set colimit, with F a finite field containing E.
Source: blueprint finite-descent-lisse, clause (2), colimit convention
(blueprint: det-lem-coefficient-finite-descent-lisse). -/
def LisseFiniteHomRepresentative (E : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ))
    (M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (padicSubfieldRingObj X ℓ E)) :=
  Σ F : {F : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ) // E ≤ F},
    ((Mod.extendScalars (padicSubfieldRingObjMap X ℓ F.property)).obj M ⟶
      (Mod.extendScalars (padicSubfieldRingObjMap X ℓ F.property)).obj N)

/-- A generating scalar-extension relation on finite-field Hom representatives.
Its equivalence closure is precisely the relation in the colimit specified by the node.
Source: blueprint finite-descent-lisse, clause (2), colimit convention
(blueprint: det-lem-coefficient-finite-descent-lisse). -/
def LisseFiniteHomRelation (E : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ))
    (M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (padicSubfieldRingObj X ℓ E))
    (a b : LisseFiniteHomRepresentative X ℓ E M N) : Prop :=
  ∃ h : a.1.val ≤ b.1.val,
    lisseFiniteHomTransition X ℓ a.1.property h a.2 = b.2

/-- Lisse objects descend to a finite coefficient field, and the canonical Hom-colimit
comparison is bijective, expressed on representatives: every target morphism is represented,
and two representatives have equal images if and only if the scalar-extension equivalence
identifies them. This includes well-definedness of the induced quotient map.
Source: blueprint sk-thm-sfb-qlbar-two-colimit/sk-lem-coefficient-finite-descent-lisse,
clauses (1)--(2) (blueprint: det-lem-coefficient-finite-descent-lisse).

Proof plan (the seven steps of the DAG node):
1. Refine the local finite-free trivializations to a finite common affine pro-etale cover.
Use site covering composition and qcqs permanence to make pair and triple overlaps
quasi-compact. For the empty scheme use the empty cover; ranks may vary and may be zero.
2. On each slice, morphisms between finite free module objects are matrices of coefficient
sections. The relative coequalizer gives the usual balanced tensor; extension sends a
matrix to its entrywise scalar extension. Its transitivity comparison is the canonical
map c tensor (b tensor m) to cb tensor m, so the Hom transitions above are the specified ones.
3. Apply det-lem-coefficient-finite-descent-sections (2) to the finitely many transition
entries and inverse entries. Directed finite subextensions give one E containing them all.
Injectivity on quasi-compact overlaps descends inverse and cocycle equations. Do not impose
an identity on the whole repeated-index overlap of a non-monomorphic covering arrow.
4. Glue the finite free E_X-modules and their transition maps by
lem-weil-pbc-site-module-sheaf-gluing, obtaining a lisse module L_E.
5. Extend scalars and use the original trivializations to glue an isomorphism to L;
lem-pur-sheaf-hom-cover-gluing glues its inverse and verifies the two inverse equations.
6. For M and N over E take a common finite trivializing cover. The matrices of a morphism
between their algebraic-closure extensions have entries in one finite F containing E.
Injectivity of coefficient sections descends the overlap equations; glue the F-linear maps.
Their scalar extension is the original map by uniqueness of morphism gluing.
7. If representatives at F and F' have the same image, pass to a finite common H.
The difference matrices have zero algebraic-closure extension, hence vanish over H by
injectivity on quasi-compact trivializing objects. Uniqueness of gluing gives equality
at H, and thus the generated equivalence. Conversely each generating scalar extension
preserves the image by tensor transitivity, and so does its equivalence closure. -/
theorem coefficient_finite_descent_lisse [CompactSpace X] [QuasiSeparatedSpace X] :
    (∀ L : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (padicAlgClRingObj X ℓ),
      IsLisseCoefficientModule (Profinite.padicAlgClRingObj ℓ) L →
      ∃ (E : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ))
        (L_E : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
          (padicSubfieldRingObj X ℓ E)),
        IsLisseCoefficientModule (Profinite.continuousMapRingObj E) L_E ∧
          Nonempty ((Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ E)).obj L_E ≅ L)) ∧
    (∀ (E : Padic.FiniteCoefficientFields ℓ (PadicAlgCl ℓ))
      (M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (padicSubfieldRingObj X ℓ E)),
      IsLisseCoefficientModule (Profinite.continuousMapRingObj E) M →
      IsLisseCoefficientModule (Profinite.continuousMapRingObj E) N →
      (Function.Surjective
        (fun a : LisseFiniteHomRepresentative X ℓ E M N ↦
          lisseFiniteHomToAlgCl X ℓ a.1.property a.2)) ∧
      (∀ a b : LisseFiniteHomRepresentative X ℓ E M N,
        lisseFiniteHomToAlgCl X ℓ a.1.property a.2 =
          lisseFiniteHomToAlgCl X ℓ b.1.property b.2 ↔
        Relation.EqvGen (LisseFiniteHomRelation X ℓ E M N) a b)) := by
  sorry

end AlgebraicGeometry.ProEtale
