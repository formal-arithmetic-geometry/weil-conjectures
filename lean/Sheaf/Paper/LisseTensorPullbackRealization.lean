module

public import Sheaf.Paper.LisseTensorPullbackRealizationData
import Sheaf.Paper.DerivedTensorRealization
import Sheaf.Paper.TensorHeartSpecialization
import Sheaf.Paper.IntegralLissePullbackNormalization
import Sheaf.CategoryTheory.ScalarLocalizationNaturalIso

/-! # Completed tensor and pullback under rational realization

Source: Bhatt--Scholze Remark 6.8.15; Stacks 07A4 and 0D6D.
(blueprint: lem-tw-lisse-tensor-pullback-realization).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxSize 4096
set_option genSizeOf false
set_option genInjectivity false
universe u
open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open AlgebraicGeometry.Scheme MonoidalCategory
open scoped TensorProduct MonoidalCategory
namespace WeilConjectures.LisseRealization
variable (D : FiniteFieldDatum.{u}) (l : ℕ) [Fact l.Prime] (hl : l ≠ D.p)
variable (E : Type u) [Field E] [Algebra ℚ_[l] E] [FiniteDimensional ℚ_[l] E]

/-- Localization carries completed tensor and pullback to their ordinary derived versions,
with the scalar-one normalizations on good representatives and on the lisse heart.

Source: Bhatt--Scholze, Remark 6.8.15; Stacks 07A4 and 0D6D
(blueprint: lem-tw-lisse-tensor-pullback-realization).

Proof:
1. Finite-type schemes over D.k are noetherian, quasi-compact, quasi-separated and
finite dimensional (lem-wf-affine-noetherian-components,
lem-weil-pbc-locally-noetherian-quasi-separated, lem-kun-dimension-finite-type).
The coefficient prime is invertible. The realization and fraction formula come from
lem-tw-lisse-localization-restriction, without a finite-type assumption on local charts.
2. Apply lem-weil-pbc-ringed-topoi-derived-tensor-pullback to localization. Compose
its ordinary scalar associator with F applied to chi inverse, where chi is the specified
map in lem-fix-constructible-tensor-completion. This gives the natural derived tensor iso.
The unit is multiplication, taking 1 tensor 1 to 1.
3. On total tensors the scalar map sends c tensor (m tensor n) to
(1 tensor m) tensor (c tensor n); its inverse multiplies the two scalars. Balancing
and the zero scalar degree show the maps commute with both differentials. The quotient
and shifted coordinates of chi are those in def-real-lisse-tensor-normalization,
so its inverse gives precisely the prescribed cocycle pairing on every good model.
4. Lisse realization gives finite locally free degree-zero sheaves. They are flat
because locally tensor is a finite sum of the identity, including the empty sum.
Use lem-fd-ringed-flat-single-tensor-cohomology and
lem-amb-derived-degree-zero-normalization to identify their derived tensor with
ordinary tensor in degree zero, normalized to the identity on H^0.
5. For pullback apply F to the inverse of eta from
lem-tw-ordinary-completed-integral-pullback, then the derived scalar square.
lem-weil-pbc-localization-inverse-image-coherence identifies the two coefficient
maps; lem-sfb-ringed-derived-monoidal-comparisons identifies their derived composites.
No equality between inverse-image coefficients and target coefficients is assumed.
6. The ordinary square flattens a' tensor (b' tensor m) to a'b' tensor m and
inserts one in the inverse direction. Thus the integral adjunction unit becomes the
rational unit with scalar one. The universal derived counits retain this normalization.
7. Raw rationalization has unchanged objects and Hom groups generated by scalar
tensors. The defining formulas in def-weil-derived-pullback-tensor-hom and
E-linearity extend the integral naturality equations to every raw rational arrow.
8. A finite locally free single is K-flat, so the normalized pullback counit computes
its ordinary module pullback. On a free chart eta has quotient coordinates equal to
the basis vector and zero shifted coordinate. Its inverse and the scalar square
therefore send a pulled-back basis to the same basis. Apply
lem-amb-derived-degree-zero-normalization: the identification induces identity on H^0.
This includes rank zero, varying ranks, the empty scheme and non-k-linear maps. -/
theorem lisse_tensor_pullback_realization
    (a : ∀ X : Base D l hl, At D l hl E X) :
    (∀ X : Base D l hl, Nonempty (RealizationTensorComparison D l hl E X (a X))) ∧
    (∀ (X Y : Base D l hl) (f : X.scheme ⟶ Y.scheme),
      Nonempty (RealizationPullComparison D l hl E f (a X) (a Y))) := by
  constructor
  · intro X
    obtain ⟨d⟩ := derived_tensor_realization D l hl E X (a X)
    obtain ⟨t, ⟨n⟩, ht⟩ := tensor_heart_specialization D l hl E X (a X) d
    exact ⟨{
      lisse := t
      normalized := n
      comparison := d.comparison
      models := d.models
      raw := d.raw
      integral := d.integral
      degree_zero := ht
      unit := d.unit
      unit_sections := d.unit_sections
      derived_unit := d.derived_unit
      derived_unit_normalized := d.derived_unit_normalized }⟩
  · intro X Y f
    obtain ⟨b, n, hn⟩ := integral_pullback_normalization D l hl E f (a X) (a Y)
    let F := pull D l hl E f ⋙ (a X).J
    let G := (a Y).J ⋙ ContinuousRational.derivedPull f (coefficientPull l E f)
    let Q := sfRationalConstructibleLocalization l E Y.scheme
    let e : Q ⋙ F ≅ Q ⋙ G := NatIso.ofComponents (fun K ↦ n.comparison K)
      (fun {K L} g ↦ hn K L g)
    obtain ⟨d, hd, _⟩ := ScalarLocalization.naturalIso_of_integral
      (Padic.coefficientExtensionIntegers l E)
      (sfIntegralConstructibleCategory l E Y.scheme)
      (Padic.coefficientExtensionUniformizer l E) F G e
    exact ⟨{ lisse := b, normalized := n, comparison := d, integral := hd }⟩

end WeilConjectures.LisseRealization
