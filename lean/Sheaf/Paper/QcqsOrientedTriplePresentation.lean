module

public import Sheaf.Paper.OrientedAffineNeighbourhoodLimit
public import Mathlib.CategoryTheory.Skeletal
import Sheaf.CategoryTheory.SiteInverseImageTensor
import WeilConjectures.SixFunctors.Etale.UpperLowerStar.Defs
import WeilConjectures.AlgebraicGeometry.EtaleSetInverseImageCompositionUnits
import Sheaf.CategoryTheory.Sites.OrientedProductLargeSites
import Sheaf.TraceFormula.QCQSEtaleFinitarySite

/-! # A finite-cover triple site for oriented products of qcqs schemes

Source: Illusie--Laszlo--Orgogozo, Exposé XI §§1.1, 1.6, 1.9 and the proof of Lemma 2.5,
printed pp. 171--175 and 179 (blueprint: lem-trf-qcqs-oriented-triple-presentation).

The full triples and their topology are the published `OrientedEtaleTriples` and
`orientedEtaleTopology`. We restrict to separated finite-presentation coordinates, take
Mathlib's skeleton, and generate the topology using finite versions of the same three types.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor Opposite
namespace AlgebraicGeometry.Scheme

/-- Triples whose three étale structural morphisms are separated and of finite presentation.
The latter means locally of finite presentation, quasi-compact and quasi-separated.
Source: ILO XI §1.1 and proof of Lemma 2.5; Stacks 01TP
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def finiteOrientedTripleProperty {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :
    ObjectProperty (OrientedEtaleTriples f g) :=
  fun Z ↦
    (IsSeparated Z.left.1.hom ∧ LocallyOfFinitePresentation Z.left.1.hom ∧
      QuasiCompact Z.left.1.hom ∧ QuasiSeparated Z.left.1.hom) ∧
    (IsSeparated Z.right.hom ∧ LocallyOfFinitePresentation Z.right.hom ∧
      QuasiCompact Z.right.hom ∧ QuasiSeparated Z.right.hom) ∧
    (IsSeparated Z.left.2.hom ∧ LocallyOfFinitePresentation Z.left.2.hom ∧
      QuasiCompact Z.left.2.hom ∧ QuasiSeparated Z.left.2.hom)

/-- The actual full subcategory before taking its small skeleton.
Source: ILO XI proof of Lemma 2.5
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
abbrev FiniteOrientedTriples {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :=
  (finiteOrientedTripleProperty f g).FullSubcategory

/-- The chosen small skeleton of the category of separated finite-presentation triples.
Objects are in `Type (u+1)` and arrows in `Type u`, within the containing universe.
Source: ILO XI proof of Lemma 2.5 and def-weil-size-convention
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
abbrev FiniteOrientedTripleSite {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :=
  Skeleton (FiniteOrientedTriples f g)

/-- The skeleton's inclusion into the full triple category.
Source: ILO XI §§1.1, 1.7 (blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def finiteOrientedTripleInclusion {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :
    FiniteOrientedTripleSite f g ⥤ OrientedEtaleTriples f g :=
  fromSkeleton _ ⋙ (finiteOrientedTripleProperty f g).ι

/-- Finite jointly-surjective generators of types (a),(b), and singleton generators of type (c).
The full-site generator definition includes their isomorphism closure; it keeps the other
coordinates invertible and requires the type-(c) right square to be cartesian.
Source: ILO XI §1.1(ii), proof of Lemma 2.5
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def finiteOrientedTripleGenerators {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :
    Precoverage (FiniteOrientedTripleSite f g) where
  coverings Z := {R | ∃ (I : Type (u + 1)) (_ : Finite I)
    (Zᵢ : I → FiniteOrientedTripleSite f g) (r : ∀ i, Zᵢ i ⟶ Z),
    R = Presieve.ofArrows Zᵢ r ∧
      Presieve.ofArrows (fun i ↦ (finiteOrientedTripleInclusion f g).obj (Zᵢ i))
        (fun i ↦ (finiteOrientedTripleInclusion f g).map (r i)) ∈
          OrientedProduct.largeGenerators X.smallEtalePretopology Y.smallEtalePretopology
            f.Etale g.Etale ((finiteOrientedTripleInclusion f g).obj Z)}

/-- The topology generated by those finite covering types; no topology is chosen from existence.
Source: ILO XI proof of Lemma 2.5
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def finiteOrientedTripleTopology {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :
    GrothendieckTopology (FiniteOrientedTripleSite f g) :=
  (finiteOrientedTripleGenerators f g).toGrothendieck

/-- Associated representables on the finite-cover site, with no subcanonicity assumption.
Source: ILO XI §§1.3, 1.6 (blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def finiteOrientedTripleAssociated {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) :
    FiniteOrientedTripleSite f g ⥤ Sheaf (finiteOrientedTripleTopology f g) (Type (u + 1)) :=
  OrientedProduct.largeAssociated (finiteOrientedTripleTopology f g)

/-- The canonical comparison between the two iterated base changes of a commuting square.
It is built from the chosen scheme pullbacks and their composition isomorphisms.
Source: ILO XI §1.9 (blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def orientedSquareBaseChangeIso {X S X' S' : Scheme.{u}}
    (f : X ⟶ S) (f' : X' ⟶ S') (a : X' ⟶ X) (b : S' ⟶ S)
    (h : a ≫ f = f' ≫ b) : f.Etale ⋙ a.Etale ≅ b.Etale ⋙ f'.Etale :=
  (MorphismProperty.Over.pullbackComp (P := @AlgebraicGeometry.Etale) (Q := ⊤) a f).symm ≪≫
    MorphismProperty.Over.pullbackComp (P := @AlgebraicGeometry.Etale) (Q := ⊤)
      f' b (a ≫ f) h

/-- Componentwise scheme base change of full triples along two commuting squares.
Its coordinates are exactly `U ×_X X'`, `V ×_S S'`, `W ×_Y Y'`, including their structural
arrows through the canonical iterated-pullback comparisons.
Source: ILO XI §1.9 (blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def orientedTripleBaseChange {X S Y X' S' Y' : Scheme.{u}}
    (f : X ⟶ S) (g : Y ⟶ S) (f' : X' ⟶ S') (g' : Y' ⟶ S')
    (a : X' ⟶ X) (b : S' ⟶ S) (d : Y' ⟶ Y)
    (ha : a ≫ f = f' ≫ b) (hd : d ≫ g = g' ≫ b) :
    OrientedEtaleTriples f g ⥤ OrientedEtaleTriples f' g' :=
  Comma.map ((a.Etale.prod d.Etale).rightUnitor.hom ≫
      (a.Etale.prod d.Etale).leftUnitor.inv)
    ((orientedSquareBaseChangeIso f f' a b ha).hom.prod'
      (orientedSquareBaseChangeIso g g' d b hd).hom)

/-- Separated finite presentation of each coordinate is stable under arbitrary base change.
No property is required of `a,b,d`.
Source: ILO XI §1.9; Stacks 01KU, 01KV, 01TS
(blueprint: lem-trf-qcqs-oriented-triple-presentation).
Proof: each coordinate of `orientedTripleBaseChange` is the usual scheme pullback. Separated,
locally finitely presented, quasi-compact and quasi-separated morphisms remain so after any
base change (the base-change clause of lem-trf-qcqs-etale-finitary-site). The two commuting
squares supply the structural maps into the pulled-back middle coordinate. -/
theorem finiteOrientedTripleBaseChange_mem {X S Y X' S' Y' : Scheme.{u}}
    (f : X ⟶ S) (g : Y ⟶ S) (f' : X' ⟶ S') (g' : Y' ⟶ S')
    (a : X' ⟶ X) (b : S' ⟶ S) (d : Y' ⟶ Y)
    (ha : a ≫ f = f' ≫ b) (hd : d ≫ g = g' ≫ b)
    (Z : FiniteOrientedTriples f g) :
    finiteOrientedTripleProperty f' g'
      ((orientedTripleBaseChange f g f' g' a b d ha hd).obj Z.obj) := by
  sorry

/-- Componentwise base change on the chosen skeletons. The only choice is Mathlib's
specified skeleton equivalence; the underlying schemes and structural arrows are fixed.
Source: ILO XI §1.9 (blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def finiteOrientedTripleBaseChange {X S Y X' S' Y' : Scheme.{u}}
    (f : X ⟶ S) (g : Y ⟶ S) (f' : X' ⟶ S') (g' : Y' ⟶ S')
    (a : X' ⟶ X) (b : S' ⟶ S) (d : Y' ⟶ Y)
    (ha : a ≫ f = f' ≫ b) (hd : d ≫ g = g' ≫ b) :
    FiniteOrientedTripleSite f g ⥤ FiniteOrientedTripleSite f' g' :=
  fromSkeleton _ ⋙
    (finiteOrientedTripleProperty f' g').lift
      ((finiteOrientedTripleProperty f g).ι ⋙
        orientedTripleBaseChange f g f' g' a b d ha hd)
      (finiteOrientedTripleBaseChange_mem f g f' g' a b d ha hd) ⋙
    toSkeletonFunctor _

/-- The canonical map `u⁻¹ H_Z → H_(B Z)` for the componentwise base-change functor `B`.
Take the identity section of the target representable, apply its sheafification unit,
transport it through the specified direct-image/restriction comparison, and transpose first
through Yoneda and sheafification and then through `u.inverse ⊣ u.direct`.
Thus this is a real construction, not a map chosen from an existence assertion.
Source: ILO XI §1.6 formula (1.a) and §1.9
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def orientedGeneratorBaseChangeMap {X S Y X' S' Y' : Scheme.{u}}
    {f : X ⟶ S} {g : Y ⟶ S} {f' : X' ⟶ S'} {g' : Y' ⟶ S'}
    (B : OrientedEtaleTriples f g ⥤ OrientedEtaleTriples f' g')
    (t : GeometricMorphism (Sheaf (orientedEtaleTopology f' g') (Type (u + 1)))
      (Sheaf (orientedEtaleTopology f g) (Type (u + 1))))
    (θ : t.direct ⋙ sheafToPresheaf (orientedEtaleTopology f g) (Type (u + 1)) ≅
      sheafToPresheaf (orientedEtaleTopology f' g') (Type (u + 1)) ⋙
        (whiskeringLeft _ _ (Type (u + 1))).obj B.op)
    (Z : OrientedEtaleTriples f g) :
    t.inverse.obj ((orientedEtaleAssociated f g).obj Z) ⟶
      (orientedEtaleAssociated f' g').obj (B.obj Z) :=
  (t.adj.homEquiv _ _).symm
    (((sheafificationAdjunction (orientedEtaleTopology f g) (Type (u + 1))).homEquiv _ _).symm
      (uliftYonedaEquiv.{u + 1}.symm
        (((θ.inv.app ((orientedEtaleAssociated f' g').obj (B.obj Z))).app (op Z))
          ((toSheafify (orientedEtaleTopology f' g')
            (uliftYoneda.{u + 1}.obj (B.obj Z))).app (op (B.obj Z)) (ULift.up (𝟙 _))))))

/-- The finite-limit, finite-refinement and restriction clauses of the presentation, for the
actual skeleton, topology and equivalence. The last isomorphism identifies associated
representables on the two sites; the preceding one identifies the equivalence with restriction
on underlying presheaves, rather than merely some equivalence of categories.
Source: ILO XI §§1.1, 1.6, 1.7 and proof of Lemma 2.5
(blueprint: lem-trf-qcqs-oriented-triple-presentation). -/
def IsFiniteOrientedTriplePresentation {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)
    (e : Sheaf (orientedEtaleTopology f g) (Type (u + 1)) ≌
      Sheaf (finiteOrientedTripleTopology f g) (Type (u + 1))) : Prop :=
  HasFiniteLimits (FiniteOrientedTripleSite f g) ∧
  (∃ Z : FiniteOrientedTripleSite f g, Nonempty (IsTerminal Z) ∧
    Nonempty (((finiteOrientedTripleInclusion f g).obj Z).left.1 ≅ Etale.mk (𝟙 X)) ∧
    Nonempty (((finiteOrientedTripleInclusion f g).obj Z).right ≅ Etale.mk (𝟙 S)) ∧
    Nonempty (((finiteOrientedTripleInclusion f g).obj Z).left.2 ≅ Etale.mk (𝟙 Y))) ∧
  (∀ (Z : FiniteOrientedTripleSite f g) (R : Presieve Z),
    Sieve.generate R ∈ finiteOrientedTripleTopology f g Z →
    ∃ (I : Type (u + 1)) (_ : Finite I) (Zᵢ : I → FiniteOrientedTripleSite f g)
      (r : ∀ i, Zᵢ i ⟶ Z),
      Sieve.ofArrows Zᵢ r ∈ finiteOrientedTripleTopology f g Z ∧
      Presieve.ofArrows Zᵢ r ≤ (Sieve.generate R : Presieve Z)) ∧
  Nonempty (e.functor ⋙ sheafToPresheaf (finiteOrientedTripleTopology f g) (Type (u + 1)) ≅
    sheafToPresheaf (orientedEtaleTopology f g) (Type (u + 1)) ⋙
      (whiskeringLeft _ _ (Type (u + 1))).obj (finiteOrientedTripleInclusion f g).op) ∧
  Nonempty (finiteOrientedTripleInclusion f g ⋙ orientedEtaleAssociated f g ⋙ e.functor ≅
    finiteOrientedTripleAssociated f g)

/-- The finite-cover triple site of qcqs schemes has finite limits and the indicated terminal
triple, every cover admits a finite refinement, restriction is an equivalence preserving the
associated representables, and arbitrary commuting diagram maps pull back these generators
by componentwise scheme base change. The direct-image formula specifies the induced geometric
morphism; the generator isomorphisms are natural in the triple on both site presentations.

Source: ILO XI §§1.1, 1.6, 1.9 and proof of Lemma 2.5, printed pp. 171--175 and 179
(blueprint: lem-trf-qcqs-oriented-triple-presentation).

Proof plan (the seven steps of the DAG node):
1. Use lem-trf-qcqs-etale-finitary-site for each input scheme. Restricted base change preserves
finite limits and covers. By lem-weil-pbc-etale-base-change-continuous, direct images are
precomposition. The left adjoints of lem-weil-pbc-left-exact-site-inverse-image-tensor are
therefore the usual inverse images. Yoneda (lem-galois-yoneda-hom-bijection) and sheafification
(def-weil-pbc-sheafification) identify their images of associated representables.
2. The identity coordinates give the displayed terminal triple. Pullbacks are componentwise
scheme fibre products and stay separated, étale and of finite presentation. Terminal objects
and pullbacks give finite limits (lem-weil-pbc-finite-limits-from-terminal-pullbacks). Transport
through the specified skeleton equivalence (def-weil-size-convention).
3. Finite composites of the finite generators form a pretopology. For type (c), pull back the
middle arrow and the right cartesian square; the lift of the left coordinate comes from the
commuting square. Pullback commutes with compositions. The finite-composite families stay
finite, so lem-weil-pbc-pretopology-sheaf-condition yields a finite refinement of every cover.
4. Apply lem-trf-oriented-product-universal to the three restricted input sites. Its topology
is exactly the finite-cover topology, and site independence identifies its topos with the full
oriented product.
5. The inverse-image pullback formula identifies each associated triple representable on the
two sites. Adjunction, Yoneda and sheafification then show that the direct equivalence is
restriction on every sheaf, naturally in both sheaves and triples.
6. Base change preserves the three finite-presentation coordinates. The two commuting scheme
squares give their structural arrows via the canonical iterated-pullback comparisons.
7. Apply the universal inverse-image formula to the induced map. The ordinary base-change
formula of step 1 and lem-weil-pbc-sets-etale-inverse-image-composition-units identify its three
factors and structural maps with the primed triple. Pasting the two squares preserves the
oriented 2-morphism, so this gives the canonical generator isomorphism. Transport through the
two restriction equivalences to obtain the same formula on the finite-cover sites. -/
theorem qcqsOrientedTriplePresentation
    (X S Y : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X]
    [CompactSpace S] [QuasiSeparatedSpace S] [CompactSpace Y] [QuasiSeparatedSpace Y]
    (f : X ⟶ S) (g : Y ⟶ S) [QuasiCompact f] [QuasiSeparated f]
    [QuasiCompact g] [QuasiSeparated g] :
    ∃ e : Sheaf (orientedEtaleTopology f g) (Type (u + 1)) ≌
        Sheaf (finiteOrientedTripleTopology f g) (Type (u + 1)),
      IsFiniteOrientedTriplePresentation f g e ∧
      ∀ (X' S' Y' : Scheme.{u}) [CompactSpace X'] [QuasiSeparatedSpace X']
        [CompactSpace S'] [QuasiSeparatedSpace S'] [CompactSpace Y'] [QuasiSeparatedSpace Y']
        (f' : X' ⟶ S') (g' : Y' ⟶ S') [QuasiCompact f'] [QuasiSeparated f']
        [QuasiCompact g'] [QuasiSeparated g']
        (a : X' ⟶ X) (b : S' ⟶ S) (d : Y' ⟶ Y)
        (ha : a ≫ f = f' ≫ b) (hd : d ≫ g = g' ≫ b),
      ∃ (e' : Sheaf (orientedEtaleTopology f' g') (Type (u + 1)) ≌
          Sheaf (finiteOrientedTripleTopology f' g') (Type (u + 1)))
        (u : GeometricMorphism (Sheaf (orientedEtaleTopology f' g') (Type (u + 1)))
          (Sheaf (orientedEtaleTopology f g) (Type (u + 1)))),
        IsFiniteOrientedTriplePresentation f' g' e' ∧
        ∃ θ : u.direct ⋙ sheafToPresheaf (orientedEtaleTopology f g) (Type (u + 1)) ≅
            sheafToPresheaf (orientedEtaleTopology f' g') (Type (u + 1)) ⋙
              (whiskeringLeft _ _ (Type (u + 1))).obj
                (orientedTripleBaseChange f g f' g' a b d ha hd).op,
          (∀ Z : FiniteOrientedTripleSite f g,
            IsIso (orientedGeneratorBaseChangeMap
              (orientedTripleBaseChange f g f' g' a b d ha hd) u θ
              ((finiteOrientedTripleInclusion f g).obj Z))) ∧
          Nonempty (finiteOrientedTripleInclusion f g ⋙ orientedEtaleAssociated f g ⋙ u.inverse ≅
            finiteOrientedTripleBaseChange f g f' g' a b d ha hd ⋙
              finiteOrientedTripleInclusion f' g' ⋙ orientedEtaleAssociated f' g') ∧
          Nonempty (finiteOrientedTripleAssociated f g ⋙ e.inverse ⋙ u.inverse ⋙ e'.functor ≅
            finiteOrientedTripleBaseChange f g f' g' a b d ha hd ⋙
              finiteOrientedTripleAssociated f' g') := by
  sorry

end AlgebraicGeometry.Scheme
