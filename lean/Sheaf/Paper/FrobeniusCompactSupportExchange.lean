/-! # Compact-support exchange for geometric Frobenius

Source: blueprint main-20261015, prop-weil-operations, proof sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange).

## Main statements

* `PodFrobeniusExchange.rational_isIso`: the canonical exchange over a finite coefficient field.
* `PodFrobeniusExchange.commonStage_isIso`: its algebraically closed common-stage counterpart.

The other declarations expose the supplied operation domains and coefficient comparisons.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
universe u v
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicGeometry.Scheme
namespace WeilConjectures


namespace PodFrobeniusExchange
open SuppliedExchangeProjection
open AlgebraicallyClosedCoefficients (Index Coefficient)
open GeneralAlgebraicallyClosedCoefficients (inclusion)

variable (D : FiniteFieldDatum.{u})
  (X₀ Y₀ : Over (Spec (.of D.k₀)))
  [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom]
  [LocallyOfFiniteType Y₀.hom] [QuasiCompact Y₀.hom]
  (f₀ : X₀ ⟶ Y₀)

/-- The actual scalar extension of the model morphism.
Source: blueprint prop-weil-operations, sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
abbrev fiberMap : (D.geometricFiber X₀).left ⟶ (D.geometricFiber Y₀).left :=
  ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ D.k)))).map f₀).left

set_option linter.defProp false in
/-- The specified Cartesian semilinear square, projected from the recorded geometry lemma.
Source: blueprint prop-weil-operations, sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def square : IsPullback (D.geometricFrobenius X₀).hom (fiberMap D X₀ Y₀ f₀)
    (fiberMap D X₀ Y₀ f₀) (D.geometricFrobenius Y₀).hom :=
  (D.frobenius_square_cartesian X₀ Y₀ f₀).2.2.2.2.2.1

variable (c : Compactification (fiberMap D X₀ Y₀ f₀))

/-- The finite map is the existing proper mate followed by canonical open exchange,
using the base change of c, with its actual two Cartesian squares.
Source: def-exchange-projection, chosen-compactification formula; blueprint
prop-weil-operations, sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def finiteExchange (l : ℕ) [Fact l.Prime]
    (E : Type u) [Field E] [Algebra (Padic l) E] [FiniteDimensional (Padic l) E]
    (n : ℕ) :=
  sfExchangeShriek l E (n + 1) (Nat.le_add_left 1 n) c
    (c.ofIsPullback (square D X₀ Y₀ f₀))
    (pullback.fst c.g (D.geometricFrobenius Y₀).hom)
    (IsPullback.of_hasPullback c.g (D.geometricFrobenius Y₀).hom)
    (c.isPullback_i_ofIsPullback (square D X₀ Y₀ f₀))

variable (l : ℕ) [Fact l.Prime]
  (E : Type u) [Field E] [Algebra (Padic l) E] [FiniteDimensional (Padic l) E]

/-- An operation on a supplied full domain realizes the recorded ambient completed-ring
operation via its natural inclusion. This fixes the operation, not merely its endpoints.
Source: def-exchange-projection, supplied operation domains
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def integralRealization {W V : Scheme.{u}}
    (P : ObjectProperty (sfIntegralConstructibleCategory l E W))
    (Q : ObjectProperty (sfIntegralConstructibleCategory l E V))
    (F : P.FullSubcategory ⥤ Q.FullSubcategory)
    (G : DerivedCategory (scalarReductionSource l E W) ⥤
      DerivedCategory (scalarReductionSource l E V)) :=
  F ⋙ Q.ι ⋙ (sfIntegralConstructible l E V).ι ≅
    P.ι ⋙ (sfIntegralConstructible l E W).ι ⋙ G

-- The autogenerated injectivity and sizeOf lemmas of this structure are unused and slow
-- to elaborate on its large field types; skipping them keeps the per-file compile in time.
set_option genInjectivity false in
set_option genSizeOfSpec false in
/-- The portion of the supplied integral exchange data used in the isomorphism assertion.
All six domains are full subcategories of the actual completed-coefficient constructible
categories. The exchange is constructed by stage.compactExchange, not supplied as a map.
The last field is the reduction comparison for that constructed arrow, including its
source, target and commutative square: precisely the consequence of the supplied
unit, counit, proper-square and open-square reduction identifications. Positive levels
are indexed n+1. It neither postulates invertibility nor chooses a lift from reductions.
Source: def-exchange-projection, other coefficient stages and domains; blueprint
prop-weil-operations, sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
structure IntegralData where
  source : ObjectProperty (sfIntegralConstructibleCategory l E (D.geometricFiber X₀).left)
  bar : ObjectProperty (sfIntegralConstructibleCategory l E c.Z)
  base : ObjectProperty (sfIntegralConstructibleCategory l E (D.geometricFiber Y₀).left)
  source' : ObjectProperty (sfIntegralConstructibleCategory l E (D.geometricFiber X₀).left)
  bar' : ObjectProperty
    (sfIntegralConstructibleCategory l E (c.ofIsPullback (square D X₀ Y₀ f₀)).Z)
  base' : ObjectProperty (sfIntegralConstructibleCategory l E (D.geometricFiber Y₀).left)
  stage : ExchangeProjectionStage
    (DX := source.FullSubcategory) (DB := bar.FullSubcategory) (DY := base.FullSubcategory)
    (DX' := source'.FullSubcategory) (DB' := bar'.FullSubcategory) (DY' := base'.FullSubcategory)
  pullRealization : integralRealization l E base source stage.pull
    (integralDerivedPullback l E (fiberMap D X₀ Y₀ f₀))
  pushRealization : integralRealization l E source base stage.push
    (PurCompactSupport.push (PurCompactSupport.completed l E)
      (fiberMap D X₀ Y₀ f₀))
  pull'Realization : integralRealization l E base' source' stage.pull'
    (integralDerivedPullback l E (fiberMap D X₀ Y₀ f₀))
  push'Realization : integralRealization l E source' base' stage.push'
    (PurCompactSupport.push (PurCompactSupport.completed l E)
      (fiberMap D X₀ Y₀ f₀))
  horizontalRealization : integralRealization l E base base' stage.horizontal
    (integralDerivedPullback l E (D.geometricFrobenius Y₀).hom)
  horizontal'Realization : integralRealization l E source source' stage.horizontal'
    (integralDerivedPullback l E (D.geometricFrobenius X₀).hom)
  compactifyingHorizontalRealization : integralRealization l E bar bar'
    stage.compactifyingHorizontal
    (integralDerivedPullback l E
      (pullback.fst c.g (D.geometricFrobenius Y₀).hom))
  openExtensionRealization : integralRealization l E source bar stage.openExtension
    (((PurCompactSupport.openExtension
      (PurCompactSupport.completed l E) c.i).mapDerivedCategory))
  openExtension'Realization : integralRealization l E source' bar' stage.openExtension'
    ((PurCompactSupport.openExtension (PurCompactSupport.completed l E)
      (c.ofIsPullback (square D X₀ Y₀ f₀)).i).mapDerivedCategory)
  properPullRealization : integralRealization l E base bar stage.properPull
    (integralDerivedPullback l E c.g)
  properPull'Realization : integralRealization l E base' bar' stage.properPull'
    (integralDerivedPullback l E (c.ofIsPullback (square D X₀ Y₀ f₀)).g)
  properPushRealization : integralRealization l E bar base stage.properPush
    (PurCompactSupport.push (PurCompactSupport.completed l E) c.g)
  properPush'Realization : integralRealization l E bar' base' stage.properPush'
    (PurCompactSupport.push (PurCompactSupport.completed l E)
      (c.ofIsPullback (square D X₀ Y₀ f₀)).g)
  compactSupportRealization : integralRealization l E source base stage.compactSupport
    (PurCompactSupport.image (PurCompactSupport.completed l E) c)
  compactSupport'Realization : integralRealization l E source' base' stage.compactSupport'
    (PurCompactSupport.image (PurCompactSupport.completed l E)
      (c.ofIsPullback (square D X₀ Y₀ f₀)))
  reduction : ∀ (n : ℕ) (K : source.FullSubcategory),
    Nonempty
      (Arrow.mk ((base'.ι ⋙ (sfIntegralConstructible l E (D.geometricFiber Y₀).left).ι ⋙
          scalarReductionDerivedExtension l E (D.geometricFiber Y₀).left n).map
            (stage.compactExchange.app K)) ≅
        Arrow.mk ((finiteExchange D X₀ Y₀ f₀ c l E n).app
          ((scalarReductionDerivedExtension l E (D.geometricFiber X₀).left n).obj K.obj.obj)))

/-- Raw scalar localization has exactly the integral objects, so a full integral
operation domain determines its rational object domain without adding retracts.
Source: def-exchange-projection, rationalization paragraph
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def rationalDomain (W : Scheme.{u})
    (P : ObjectProperty (sfIntegralConstructibleCategory l E W)) :
    ObjectProperty (sfRationalConstructibleCategory l E W) := fun K ↦ P K.obj

/-- The unchanged integral object underlying an object of the rational operation domain.
Source: def-weil-rationalization-karoubi, unchanged-object convention
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def integralRepresentative {W : Scheme.{u}}
    {P : ObjectProperty (sfIntegralConstructibleCategory l E W)}
    (K : (rationalDomain l E W P).FullSubcategory) : P.FullSubcategory :=
  ⟨K.obj.obj, K.property⟩

/-- The actual localization functor on a full operation domain, with unchanged objects
and the recorded tensor-with-one map on integral arrows.
Source: def-exchange-projection, rationalization paragraph
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def localizeDomain (W : Scheme.{u})
    (P : ObjectProperty (sfIntegralConstructibleCategory l E W)) :
    P.FullSubcategory ⥤ (rationalDomain l E W P).FullSubcategory :=
  (rationalDomain l E W P).lift
    (P.ι ⋙ sfRationalConstructibleLocalization l E W) (fun K ↦ K.property)

/-- A rational supplied operation is the scalar localization of its integral operation,
including its action on morphisms, via the supplied normalized comparison.
Source: def-exchange-projection, rational coefficient recipe
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def rationalRealization {W V : Scheme.{u}}
    (P : ObjectProperty (sfIntegralConstructibleCategory l E W))
    (Q : ObjectProperty (sfIntegralConstructibleCategory l E V))
    (F : P.FullSubcategory ⥤ Q.FullSubcategory)
    (G : (rationalDomain l E W P).FullSubcategory ⥤
      (rationalDomain l E V Q).FullSubcategory) :=
  F ⋙ localizeDomain l E V Q ≅ localizeDomain l E W P ⋙ G

variable (I : IntegralData D X₀ Y₀ f₀ c l E)

-- The autogenerated injectivity and sizeOf lemmas of this structure are unused and slow
-- to elaborate on its large field types; skipping them keeps the per-file compile in time.
set_option genInjectivity false in
set_option genSizeOfSpec false in
/-- The rational supplied-domain recipe, retaining the actual scalar-localized Hom map.
The four realization fields fix the displayed pullback/compact-support endpoints.
The arrow-category isomorphism records the two supplied endpoint operation
identifications and their commuting square with integral localization. Both stages use
compactExchange, the specified proper/open composite of def-exchange-projection.
Source: def-exchange-projection, rational coefficient paragraph
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
structure RationalData where
  stage : ExchangeProjectionStage
    (DX := (rationalDomain l E (D.geometricFiber X₀).left I.source).FullSubcategory)
    (DB := (rationalDomain l E c.Z I.bar).FullSubcategory)
    (DY := (rationalDomain l E (D.geometricFiber Y₀).left I.base).FullSubcategory)
    (DX' := (rationalDomain l E (D.geometricFiber X₀).left I.source').FullSubcategory)
    (DB' := (rationalDomain l E (c.ofIsPullback (square D X₀ Y₀ f₀)).Z
      I.bar').FullSubcategory)
    (DY' := (rationalDomain l E (D.geometricFiber Y₀).left I.base').FullSubcategory)
  horizontalRealization : rationalRealization l E I.base I.base'
    I.stage.horizontal stage.horizontal
  horizontal'Realization : rationalRealization l E I.source I.source'
    I.stage.horizontal' stage.horizontal'
  compactSupportRealization : rationalRealization l E I.source I.base
    I.stage.compactSupport stage.compactSupport
  compactSupport'Realization : rationalRealization l E I.source' I.base'
    I.stage.compactSupport' stage.compactSupport'
  coefficientComparison : ∀ K :
      (rationalDomain l E (D.geometricFiber X₀).left I.source).FullSubcategory,
    Arrow.mk ((rationalDomain l E (D.geometricFiber Y₀).left I.base').ι.map
        (stage.compactExchange.app K)) ≅
      Arrow.mk ((sfRationalConstructibleLocalization l E (D.geometricFiber Y₀).left).map
        (I.base'.ι.map (I.stage.compactExchange.app (integralRepresentative l E K))))

private theorem intrinsicPullback_isEquivalence (A : Type u) [CommRing A] [Finite A]
    {X Y : Scheme.{u}} (g : X ⟶ Y) [IsIso g] :
    (sfIntrinsicDerivedPullback A g).IsEquivalence := by
  let F := sfIntrinsicDerivedPullback A g
  let H := sfIntrinsicDerivedPullback A (inv g)
  let a : F ⋙ H ≅ 𝟭 _ :=
    (sfIntrinsicDerivedPullbackComp A (inv g) g).symm ≪≫
      eqToIso (congrArg (sfIntrinsicDerivedPullback A) (IsIso.inv_hom_id g)) ≪≫
      sfIntrinsicDerivedPullbackId A Y
  let b : H ⋙ F ≅ 𝟭 _ :=
    (sfIntrinsicDerivedPullbackComp A g (inv g)).symm ≪≫
      eqToIso (congrArg (sfIntrinsicDerivedPullback A) (IsIso.hom_inv_id g)) ≪≫
      sfIntrinsicDerivedPullbackId A X
  exact (CategoryTheory.Equivalence.mk F H a.symm b).isEquivalence_functor

private theorem finiteExchange_isIso (n : ℕ) :
    IsIso (finiteExchange D X₀ Y₀ f₀ c l E n) := by
  let A := Padic.coefficientExtensionRing l E (n + 1)
  let : Finite A := Padic.finite_coefficientExtensionRing l E (n + 1)
    (Nat.le_add_left 1 n)
  let g := (D.geometricFrobenius Y₀).hom
  let b := pullback.fst c.g g
  have : IsIso b := inferInstanceAs (IsIso (pullback.fst c.g g))
  have := intrinsicPullback_isEquivalence A g
  have := intrinsicPullback_isEquivalence A b
  have := isIso_mateEquiv_of_isEquivalence_of_fullyFaithful
    (sfIntrinsicConstantModuleAdjunction c.g A).mapDerivedCategoryRightDerivedAdjunction
    (sfIntrinsicConstantModuleAdjunction
      (c.ofIsPullback (square D X₀ Y₀ f₀)).g A).mapDerivedCategoryRightDerivedAdjunction
    (sfIntrinsicDerivedPullback A g) (sfIntrinsicDerivedPullback A b)
    (sfIntrinsicDerivedSquarePullback A b
      (c.ofIsPullback (square D X₀ Y₀ f₀)).g c.g g
      (IsPullback.of_hasPullback c.g g).w).symm
  dsimp only [finiteExchange, sfExchangeShriek, compactificationExchangeFromData]
  infer_instance

private theorem integral_isIso_of_reductions (Y : Scheme.{u})
    {M N : sfIntegralConstructibleCategory l E Y} (f : M ⟶ N)
    (h : ∀ n, IsIso ((scalarReductionDerivedExtension l E Y n).map f.hom)) :
    IsIso f := by
  let P := sfIntegralConstructible l E Y
  obtain ⟨C, g, δ, hT⟩ := Pretriangulated.distinguished_cocone_triangle f.hom
  let T := Pretriangulated.Triangle.mk f.hom g δ
  have hC : P C := P.ext_of_isTriangulatedClosed₃ T hT M.property N.property
  have hz (n : ℕ) : IsZero ((sfDerivedReductionRestricted l E Y n).obj C) := by
    let F := scalarReductionDerivedExtension l E Y n
    obtain ⟨hs, ht⟩ :=
      (scalarReductionDerivedExistence l E Y n).choose_spec.choose_spec.2.1
    let : F.CommShift ℤ := hs
    have : F.IsTriangulated := ht
    have hz := (Pretriangulated.Triangle.isZero₃_iff_isIso₁
      (F.mapTriangle.obj T) (F.map_distinguished T hT)).mpr (h n)
    let := sfRestrictionLimits l E Y n
    let := sfRestrictionColimits l E Y n
    change IsZero (((scalarReductionRestriction l E Y n).mapDerivedCategory).obj _)
    exact (scalarReductionRestriction l E Y n).mapDerivedCategory.map_isZero hz
  obtain ⟨hp, δc, hc⟩ := hC.1
  let := hp
  have hprod : IsZero (∏ᶜ fun n ↦ (sfDerivedReductionRestricted l E Y n).obj C) := by
    apply (IsZero.iff_id_eq_zero _).mpr
    apply Pi.hom_ext
    intro n
    exact (hz n).eq_of_tgt _ _
  have hzero : IsZero C :=
    Pretriangulated.Triangle.isZero₁_of_isZero₂₃ _ hc hprod hprod
  exact (ObjectProperty.isIso_hom_iff _).mp
    ((Pretriangulated.Triangle.isZero₃_iff_isIso₁ T hT).mp hzero)

private theorem integralExchange_isIso : IsIso I.stage.compactExchange := by
  rw [NatTrans.isIso_iff_isIso_app]
  intro K
  apply (ObjectProperty.isIso_hom_iff _).mp
  apply integral_isIso_of_reductions l E
  intro n
  have := finiteExchange_isIso D X₀ Y₀ f₀ c l E n
  obtain ⟨e⟩ := I.reduction n K
  exact (Arrow.isIso_iff_isIso_of_isIso e.hom).mpr (by infer_instance)

/-- The specified rational compact-support Frobenius exchange is a natural isomorphism
on every supplied closed full operation domain. No separatedness of either model is
assumed. The finite-Tor and coefficient requirements are those retained in the data.
Source: blueprint main-20261015, prop-weil-operations, proof sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange).

Proof, following the six DAG steps: (1) The Frobenius square is Cartesian and its
horizontal arrows are isomorphisms. Base change of c has horizontal projection b,
with inverse (1,g_Y inverse p). Regard the square as one over Y, so semilinearity
requires no separatedness over k. (2) At each positive finite level, both horizontal
pullbacks of the proper square are equivalences. The mate-along-equivalences lemma
makes exactly its unit--square--counit exchange invertible. (3) The canonical open
exchange is invertible by extension-by-zero base change; its proper image and the
proper mate compose to finiteExchange. Compactification comparisons only conjugate it.
(4) I.reduction identifies reduction of the actual constructed integral exchange with
this finite exchange, using the supplied unit/counit and comparison identifications.
(5) Its cone is integral constructible, hence derived complete. Exact reduction makes
all its reductions zero, so its Roos triangle is C to zero to zero. Thus C is zero
and the integral arrow is invertible. This uses completion of ring-sheaf coefficients,
not condensed coefficients or faithfulness of reductions. (6) Scalar localization
sends the integral inverse to an inverse. R.coefficientComparison identifies this with the
specified rational component; the full-domain inclusion reflects isomorphisms.
Componentwise invertibility of the already natural transformation is the assertion.

The proof inputs are lem-weil-frobenius-square-cartesian,
lem-weil-isomorphism-derived-pullback-equivalence,
lem-weil-mate-iso-along-equivalences, lem-cbc-proetale-extension-zero-base-change,
prop-compactification-coherence-detailed, lem-weil-integral-constructible-triangulated,
lem-pur-derived-change-of-rings, lem-kun-distinguished-cone-zero,
def-weil-derived-complete-integral-detailed, def-weil-derived-complete,
def-weil-rationalization-karoubi and def-weil-algebraically-closed-coefficients.
-/
theorem rational_isIso (_hl : l ≠ D.p)
    [IsSeparated f₀.left] [LocallyOfFiniteType f₀.left] [QuasiCompact f₀.left]
    (R : RationalData D X₀ Y₀ f₀ c l E I) : IsIso R.stage.compactExchange := by
  have := integralExchange_isIso D X₀ Y₀ f₀ c l E I
  rw [NatTrans.isIso_iff_isIso_app]
  intro K
  apply (ObjectProperty.isIso_hom_iff _).mp
  exact (Arrow.isIso_iff_isIso_of_isIso (R.coefficientComparison K).hom).mpr
    (by infer_instance)


section CommonStage
variable (Ω : Type v) [Field Ω] [Algebra (Padic l) Ω] [IsAlgClosure (Padic l) Ω]

/-- The common-stage object domain consists of the literal finite-stage pairs whose
integral representative belongs to the corresponding supplied integral operation domain.
Source: def-exchange-projection, common-finite-field paragraph
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def commonDomain (W : Scheme.{u})
    (P : ∀ A : Index l Ω,
      ObjectProperty (sfIntegralConstructibleCategory l (Coefficient.{u} l Ω A) W)) :
    ObjectProperty (generalAlgebraicallyClosedConstructibleCategory l Ω W) :=
  fun K ↦ P K.stage K.obj.obj

/-- Inclusion of a rational operation domain at its literal common coefficient stage.
Source: def-exchange-projection, common-field morphism classes
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def includeDomain (W : Scheme.{u})
    (P : ∀ A : Index l Ω,
      ObjectProperty (sfIntegralConstructibleCategory l (Coefficient.{u} l Ω A) W))
    (A : Index l Ω) :
    (rationalDomain l (Coefficient.{u} l Ω A) W (P A)).FullSubcategory ⥤
      (commonDomain l Ω W P).FullSubcategory :=
  (commonDomain l Ω W P).lift
    ((rationalDomain l (Coefficient.{u} l Ω A) W (P A)).ι ⋙ inclusion A)
    (fun K ↦ K.property)

/-- A common-stage operation is identified with the prescribed rational operation
at every finite coefficient field, on objects and all represented arrows.
Source: def-exchange-projection, common-field operation comparisons
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def commonRealization {W V : Scheme.{u}}
    (P : ∀ A : Index l Ω,
      ObjectProperty (sfIntegralConstructibleCategory l (Coefficient.{u} l Ω A) W))
    (Q : ∀ A : Index l Ω,
      ObjectProperty (sfIntegralConstructibleCategory l (Coefficient.{u} l Ω A) V))
    (F : ∀ A : Index l Ω,
      (rationalDomain l (Coefficient.{u} l Ω A) W (P A)).FullSubcategory ⥤
        (rationalDomain l (Coefficient.{u} l Ω A) V (Q A)).FullSubcategory)
    (G : (commonDomain l Ω W P).FullSubcategory ⥤
      (commonDomain l Ω V Q).FullSubcategory) :=
  ∀ A : Index l Ω, F A ⋙ includeDomain l Ω V Q A ≅ includeDomain l Ω W P A ⋙ G

variable
  (Is : ∀ A : Index l Ω, IntegralData D X₀ Y₀ f₀ c l (Coefficient.{u} l Ω A))
  (Rs : ∀ A : Index l Ω, RationalData D X₀ Y₀ f₀ c l (Coefficient.{u} l Ω A) (Is A))

/-- The existing supplied exchange stage, specialized to the six actual common-stage
full operation domains. Naming this type prevents repeated expansion of pair categories.
Source: def-exchange-projection, algebraically closed supplied domains
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
abbrev CommonStage :=
  ExchangeProjectionStage
    (DX := (commonDomain l Ω (D.geometricFiber X₀).left
      (fun A ↦ (Is A).source)).FullSubcategory)
    (DB := (commonDomain l Ω c.Z (fun A ↦ (Is A).bar)).FullSubcategory)
    (DY := (commonDomain l Ω (D.geometricFiber Y₀).left
      (fun A ↦ (Is A).base)).FullSubcategory)
    (DX' := (commonDomain l Ω (D.geometricFiber X₀).left
      (fun A ↦ (Is A).source')).FullSubcategory)
    (DB' := (commonDomain l Ω (c.ofIsPullback (square D X₀ Y₀ f₀)).Z
      (fun A ↦ (Is A).bar')).FullSubcategory)
    (DY' := (commonDomain l Ω (D.geometricFiber Y₀).left
      (fun A ↦ (Is A).base')).FullSubcategory)

/-- The endpoint-operation comparisons of the supplied common-stage data, separated from
its exchange component comparison. Each field uses the actual finite-stage inclusion.
The component recipe below
fixes the entire proper/open composite, so no extra interior-factor realization is needed.
Source: def-exchange-projection, coefficient comparisons
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def CommonRealizations (stage : CommonStage D X₀ Y₀ f₀ c l Ω Is) : Type _ :=
  (commonRealization l Ω
    (fun A ↦ (Is A).base) (fun A ↦ (Is A).base')
    (fun A ↦ (Rs A).stage.horizontal) stage.horizontal) ×
  (commonRealization l Ω
    (fun A ↦ (Is A).source) (fun A ↦ (Is A).source')
    (fun A ↦ (Rs A).stage.horizontal') stage.horizontal') ×
  (commonRealization l Ω
    (fun A ↦ (Is A).source) (fun A ↦ (Is A).base)
    (fun A ↦ (Rs A).stage.compactSupport) stage.compactSupport) ×
  (commonRealization l Ω
    (fun A ↦ (Is A).source') (fun A ↦ (Is A).base')
    (fun A ↦ (Rs A).stage.compactSupport') stage.compactSupport')

/-- The specified common-stage exchange component is the image of its actual
rational representative, up to the supplied endpoint identifications.
Source: def-exchange-projection, common-field component recipe
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def CommonComponentComparison (stage : CommonStage D X₀ Y₀ f₀ c l Ω Is) : Type _ :=
  ∀ K : (commonDomain l Ω (D.geometricFiber X₀).left
    (fun A ↦ (Is A).source)).FullSubcategory,
  Arrow.mk ((commonDomain l Ω (D.geometricFiber Y₀).left
      (fun A ↦ (Is A).base')).ι.map (stage.compactExchange.app K)) ≅
    Arrow.mk ((inclusion K.obj.stage).map
      ((rationalDomain l (Coefficient.{u} l Ω K.obj.stage)
        (D.geometricFiber Y₀).left (Is K.obj.stage).base').ι.map
        ((Rs K.obj.stage).stage.compactExchange.app ⟨K.obj.obj, K.property⟩)))

/-- The supplied common-stage operation data and their specified component recipe.
Every input retains its actual finite field and its object, including identity stages.
The comparison maps are the supplied scalar/operation identifications. The arrow-category
isomorphism identifies the morphism class of the rational proper/open composite at that field.
Naturality on every common-stage morphism is already part of stage.compactExchange.
Thus arbitrary further common fields, including identity and successive extensions,
remain in the domain: no Frobenius-stable lattice or separated base is introduced.
Source: def-exchange-projection, common-finite-field paragraph and scalar cocycle;
blueprint prop-weil-operations, proof sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange). -/
def CommonData : Type _ :=
  Σ stage : CommonStage D X₀ Y₀ f₀ c l Ω Is,
    CommonRealizations D X₀ Y₀ f₀ c l Ω Is Rs stage ×
      CommonComponentComparison D X₀ Y₀ f₀ c l Ω Is Rs stage

/-- The specified compact-support Frobenius exchange is a natural isomorphism also
in the actual common-stage algebraically closed coefficient category, on every
supplied full operation domain. Together with rational_isIso this covers both
coefficient cases of the node, without separatedness of either model.
Source: blueprint main-20261015, prop-weil-operations, proof sentence 1
(blueprint: lem-pod-weil-frobenius-compact-support-exchange).

Proof: Steps 1--5 are the same finite proper-mate/open-exchange and complete-cone
argument given in rational_isIso: the Frobenius square is Cartesian, its proper
horizontal projection is an isomorphism, finite exchange is invertible, the supplied
reduction square identifies the integral reductions, and the complete integral cone
is zero. Step 6 first rationalizes its inverse. For K represented at A, Q.2.2
identifies its exchange with the image of that rational component under the actual
stage-inclusion functor, conjugated by the supplied operation comparisons. The same
functor sends the inverse to an inverse, with both inverse identities computed at A.
On a morphism represented at a larger common field B, the supplied scalar comparisons
conjugate both the arrow and its inverse to those at B. Their identity/tower cocycle
makes these the same morphism classes, including B=A. The transformation is already
natural in the common-stage category; its now invertible components therefore give
a natural isomorphism. Full-subcategory inclusions reflect isomorphisms.

The proof inputs are lem-weil-frobenius-square-cartesian,
lem-weil-isomorphism-derived-pullback-equivalence,
lem-weil-mate-iso-along-equivalences, lem-cbc-proetale-extension-zero-base-change,
prop-compactification-coherence-detailed, lem-weil-integral-constructible-triangulated,
lem-pur-derived-change-of-rings, lem-kun-distinguished-cone-zero,
def-weil-derived-complete-integral-detailed, def-weil-derived-complete,
def-weil-rationalization-karoubi and def-weil-algebraically-closed-coefficients.
-/
theorem commonStage_isIso (_hl : l ≠ D.p)
    [IsSeparated f₀.left] [LocallyOfFiniteType f₀.left] [QuasiCompact f₀.left]
    (Q : CommonData D X₀ Y₀ f₀ c l Ω Is Rs) : IsIso Q.1.compactExchange := by
  rw [NatTrans.isIso_iff_isIso_app]
  intro K
  have := rational_isIso D X₀ Y₀ f₀ c l (Coefficient.{u} l Ω K.obj.stage)
    (Is K.obj.stage) _hl (Rs K.obj.stage)
  apply (ObjectProperty.isIso_hom_iff _).mp
  exact (Arrow.isIso_iff_isIso_of_isIso (Q.2.2 K).hom).mpr (by infer_instance)

end CommonStage
end PodFrobeniusExchange
end WeilConjectures
