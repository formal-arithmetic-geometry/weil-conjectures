module

public import Mathlib.AlgebraicGeometry.Sites.Etale
import WeilConjectures.AlgebraicGeometry.Morphisms.Integral.DisjointCover

/-! # Disjoint refinement of an étale cover over an integral morphism

Source: Stacks Project, Tags 04DR, 04DQ and 04DP
(blueprint: lem-sbc-integral-etale-cover-disjoint-refinement)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u w

namespace AlgebraicGeometry

set_option backward.isDefEq.respectTransparency.types false in
/-- An étale cover after an étale pointed neighbourhood of the base admits a disjoint
open refinement over an integral morphism.

Source: Stacks Project, Tag 04DR (lemma-integral-B), using Tag 04DQ (lemma-finite-B)
and the explicit refinement formulation of Tag 04DP (lemma-simplify-B).
(blueprint: lem-sbc-integral-etale-cover-disjoint-refinement)

Proof: Choose the algebraic closure of the residue field at `v`, giving a geometric
point of `Y` and a pointed neighbourhood with underlying object `V`. Exchange the
factors of the given pullback and form the sieve generated by the cover members,
viewed as étale `X`-schemes. Joint surjectivity makes this a covering sieve.
Apply `Scheme.Hom.Nbhd.exists_hom_disjoint_cover`, whose proof implements the
standard-étale finite-subalgebra descent and finite split-neighbourhood argument
of Tags 04DR and 04DQ. Extract the factorization of each resulting open inclusion
through one original cover member from membership in the generated sieve.
The marked geometric point supplies `v'`, and its compatibility supplies `a(v') = v`.
Transport the open inclusions back across pullback symmetry; its injectivity
preserves disjointness and its surjectivity preserves the covering union.
Finally check the factorization equation on the two pullback projections.
The construction allows an empty index set and does not impose a universe bound
on the original covering family. -/
theorem integral_etale_cover_disjoint_refinement
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIntegralHom f]
    (V : Y.Etale) (v : V.left)
    (I : Type w) (U : I → (CategoryTheory.Limits.pullback f V.hom : Scheme).Etale)
    (hU : ∀ x : (CategoryTheory.Limits.pullback f V.hom : Scheme),
      ∃ i : I, ∃ y : (U i).left,
      ((Scheme.Hom.toLRSHom' (U i).hom).base : TopCat.Hom _ _).hom y = x) :
    ∃ (V' : Y.Etale) (a : V' ⟶ V) (v' : V'.left),
      (Scheme.Hom.toLRSHom' a.left).base v' = v ∧
      ∃ (J : Type u) (W : J → Scheme) (w : ∀ j, W j ⟶ pullback f V'.hom)
        (_ : ∀ j, IsOpenImmersion (w j)) (α : J → I)
        (b : ∀ j, W j ⟶ (U (α j)).left),
        Set.Pairwise Set.univ (fun j k =>
          Disjoint
            (Set.range (((Scheme.Hom.toLRSHom' (w j)).base : TopCat.Hom _ _).hom))
            (Set.range (((Scheme.Hom.toLRSHom' (w k)).base : TopCat.Hom _ _).hom))) ∧
        (⋃ j, Set.range (((Scheme.Hom.toLRSHom' (w j)).base : TopCat.Hom _ _).hom)) = Set.univ ∧
        (∀ j, b j ≫ (U (α j)).hom =
          w j ≫ CategoryTheory.Limits.pullback.map f V'.hom f V.hom (𝟙 X) a.left (𝟙 Y)
            (by simp) (by simp only [Category.comp_id]; exact a.w.symm)) := by
  classical
  let Ω := AlgebraicClosure (V.left.residueField v)
  let y : Spec (.of Ω) ⟶ Y :=
    Spec.map (CommRingCat.ofHom (algebraMap (V.left.residueField v) Ω)) ≫
      V.left.fromSpecResidueField v ≫ V.hom
  let vp : Spec (.of Ω) ⟶ V.left :=
    Spec.map (CommRingCat.ofHom (algebraMap (V.left.residueField v) Ω)) ≫
      V.left.fromSpecResidueField v
  have hvp : vp ≫ V.hom = y := rfl
  let c : Scheme.Hom.Nbhd y :=
    ⟨V, CategoryTheory.Over.homMk vp hvp⟩
  let U' (i : I) : X.Etale :=
    Scheme.Etale.mk ((U i).hom ≫ pullback.fst f V.hom)
  let q (i : I) : U' i ⟶ f.Etale.obj c.1 :=
    MorphismProperty.Over.homMk
      ((U i).hom ≫ (pullbackSymmetry f V.hom).hom) (by
        change _ ≫ pullback.snd V.hom f = _
        simp [U'])
  let R : Sieve (f.Etale.obj c.1) := Sieve.ofArrows U' q
  have hR : R ∈ X.smallEtaleTopology (f.Etale.obj c.1) := by
    rw [Scheme.ofArrows_mem_smallEtaleTopology_iff, Set.eq_univ_iff_forall]
    intro x
    obtain ⟨i, z, hz⟩ := hU ((pullbackSymmetry f V.hom).inv x)
    refine Set.mem_iUnion.mpr ⟨i, z, ?_⟩
    change ((U i).hom ≫ (pullbackSymmetry f V.hom).hom) z = x
    rw [Scheme.Hom.comp_apply, hz]
    change ((pullbackSymmetry f V.hom).inv ≫ (pullbackSymmetry f V.hom).hom) x = x
    rw [(pullbackSymmetry f V.hom).inv_hom_id]
    rfl
  obtain ⟨c', g, J, P, hdisj, hsup, hP⟩ :=
    Scheme.Hom.Nbhd.exists_hom_disjoint_cover f c R hR
  let V' : Y.Etale := c'.1
  let a : V' ⟶ V := g.val
  let v' : V'.left := c'.2.left (default : Spec (.of Ω))
  have hva : (Scheme.Hom.toLRSHom' a.left).base v' = v := by
    have hg : c'.2.left ≫ a.left = vp :=
      congrArg CategoryTheory.Over.Hom.left g.property
    change a.left (c'.2.left (default : Spec (.of Ω))) = v
    calc
      a.left (c'.2.left (default : Spec (.of Ω))) = vp (default : Spec (.of Ω)) :=
        congrArg (fun z : Spec (.of Ω) ⟶ V.left => z (default : Spec (.of Ω))) hg
      _ = v := V.left.fromSpecResidueField_apply v _
  have hfac (j : J) : ∃ (i : I) (b : (P j).toScheme ⟶ (U i).left),
      b ≫ (U i).hom ≫ (pullbackSymmetry f V.hom).hom =
        (P j).ι ≫ (f.Etale.map g.val).left := by
    obtain ⟨i, h, hh⟩ := Sieve.ofArrows.exists (hP j)
    exact ⟨i, h.left, (congrArg (fun z => z.left) hh).symm⟩
  choose α b hb using hfac
  let w (j : J) : (P j).toScheme ⟶ pullback f V'.hom :=
    (P j).ι ≫ (pullbackSymmetry f V'.hom).inv
  have hrange (j : J) : Set.range (w j) =
      (pullbackSymmetry f V'.hom).inv '' (P j : Set _) := by
    change Set.range ((pullbackSymmetry f V'.hom).inv ∘ (P j).ι) = _
    rw [Set.range_comp, Scheme.Opens.range_ι]
  refine ⟨V', a, v', hva, J, (fun j => (P j).toScheme), w,
    (fun j => inferInstance), α, b, ?_, ?_, ?_⟩
  · intro j hj k hk hjk
    change Disjoint (Set.range (w j)) (Set.range (w k))
    rw [hrange, hrange]
    have hd : Disjoint (P j : Set (pullback c'.1.hom f : Scheme))
        (P k : Set (pullback c'.1.hom f : Scheme)) := by
      exact_mod_cast hdisj j k hjk
    exact hd.image (Set.injOn_of_injective (pullbackSymmetry f V'.hom).inv.injective)
      (Set.subset_univ _) (Set.subset_univ _)
  · change (⋃ j, Set.range (w j)) = Set.univ
    simp only [hrange]
    rw [← Set.image_iUnion, ← TopologicalSpace.Opens.coe_iSup, hsup,
      TopologicalSpace.Opens.coe_top]
    exact Set.image_univ_of_surjective (pullbackSymmetry f V'.hom).inv.surjective
  · intro j
    apply (cancel_mono (pullbackSymmetry f V.hom).hom).mp
    rw [Category.assoc, hb]
    have hs : (f.Etale.map g.val).left =
        (pullbackSymmetry f V'.hom).inv ≫
          pullback.map f V'.hom f V.hom (𝟙 X) a.left (𝟙 Y)
            (by simp) (by simp only [Category.comp_id]; exact a.w.symm) ≫
            (pullbackSymmetry f V.hom).hom := by
      apply pullback.hom_ext
      · change _ ≫ pullback.fst V.hom f = _
        rw [Scheme.Hom.etale_map_left_comp_fst]
        simp [Category.assoc, V', c, a]
      · change _ ≫ pullback.snd V.hom f = _
        rw [Scheme.Hom.etale_map_left_comp_snd]
        simp [Category.assoc, V', c, a]
    simpa only [w, Category.assoc] using congrArg ((P j).ι ≫ ·) hs

end AlgebraicGeometry
