module

public import Sheaf.Paper.IntegralComparisonSequenceSystems
public import Sheaf.SecSmoothPurity.CochainPullbackTensorCoherence
public import Sheaf.Algebra.Category.ModuleCat.Sheaf.FlatOnSite
public import Sheaf.Paper.IntegralOperationsWellDefined

/-! # Strict quotient expressions and their actual transition adjoints

Source: Stacks Project, sites-cohomology.tex, Tags 0G7E, 07A2, 07A4 and 07A6;
the finite-expression construction in lem-pur-quotient-expression-kflat-normalization
(blueprint: def-pur-strict-quotient-expressions).

Membership in `Generated` records the least collection of strict sequence complexes
closed under the specified operations. It does not impose any K-flatness or normalization.
The sequence site's horizontal maps are the actual semilinear transitions. Natural-number
level n denotes the positive exponent n+1, including when the input list is empty.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option genInjectivity false
set_option genSizeOfSpec false
set_option synthInstance.maxSize 4096
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [-instance] CategoryTheory.GrothendieckTopology.hasSheafify_of_essentiallySmall
attribute [-instance] WeilConjectures.sfAbSheafify WeilConjectures.sfAbBijective

universe t u
open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite AlgebraicGeometry
namespace WeilConjectures.StrictQuotient

variable (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
  [Algebra ℚ_[l] E] [FiniteDimensional ℚ_[l] E]

/-- An unbounded complex on the recorded ringed sequence site.
Source: Stacks 0941 (blueprint: def-pur-strict-quotient-expressions). -/
abbrev Complex (W : Scheme.{t}) := CochainComplex (coefficientSequenceModules l E W) ℤ

/-- Evaluation at a positive coefficient level, retaining the actual scalar action.
Source: Stacks 0941 (blueprint: def-pur-strict-quotient-expressions). -/
abbrev level {W : Scheme.{t}} (K : Complex l E W) (n : ℕ) :=
  ((coefficientSequenceEvaluation l E W n).mapHomologicalComplex (.up ℤ)).obj K

/-- The horizontal transition of the given complex, not an independently chosen map.
Source: Stacks 0941 (blueprint: def-pur-strict-quotient-expressions). -/
def transition {W : Scheme.{t}} (K : Complex l E W) {m n : ℕ} (hmn : n ≤ m) :
    level l E K m ⟶
      ((normalizedDVRModuleRes l E W hmn).mapHomologicalComplex (.up ℤ)).obj (level l E K n) :=
  (NatTrans.mapHomologicalComplex (coefficientSequenceTransition l E W hmn) (.up ℤ)).app K

/-- The finite direct-sum total tensor on strict complexes, including its horizontal maps.
Source: Stacks 07A2, 07A4 (blueprint: def-pur-strict-quotient-expressions). -/
abbrev total {W : Scheme.{t}} (P Q : Complex l E W) : Complex l E W :=
  (coefficientTotalTensor.{u, t+1, t}
    (coefficientSequenceTopology (Scheme.ProEt.topology W))
    (coefficientSequenceCommRingSheaf l E W)).obj (P, Q)

/-- Actual termwise module inverse image on the compatible ringed sequence sites.
Source: Stacks 0G7E (blueprint: def-pur-strict-quotient-expressions). -/
abbrev pull {V W : Scheme.{t}} (g : V ⟶ W) (P : Complex l E W) : Complex l E V :=
  ((integralComparisonSequencePullback l E g).mapHomologicalComplex (.up ℤ)).obj P

/-- The finite expressions generated by N at Y and the three coefficient units, using
only the arrows f, h, and h followed by f. Tensor and inverse image retain their actual
horizontal maps. No input is required when r=0.
Source: node's finite-expression paragraph, Stacks 07A4
(blueprint: def-pur-strict-quotient-expressions). -/
inductive Generated {Z X Y : Scheme.{t}} (h : Z ⟶ X) (f : X ⟶ Y) {r : ℕ}
    (N : Fin r → Complex l E Y) : (W : Scheme.{t}) → Complex l E W → Prop where
  | input (i : Fin r) : Generated h f N Y (N i)
  | unitY : Generated h f N Y (𝟙_ (Complex l E Y))
  | unitX : Generated h f N X (𝟙_ (Complex l E X))
  | unitZ : Generated h f N Z (𝟙_ (Complex l E Z))
  | tensor {W : Scheme.{t}} {P Q : Complex l E W} :
      Generated h f N W P → Generated h f N W Q → Generated h f N W (total l E P Q)
  | pullF {P : Complex l E Y} : Generated h f N Y P →
      Generated h f N X (pull l E f P)
  | pullH {P : Complex l E X} : Generated h f N X P →
      Generated h f N Z (pull l E h P)
  | pullHF {P : Complex l E Y} : Generated h f N Y P →
      Generated h f N Z (pull l E (h ≫ f) P)

/-- Flat-term K-flatness of a specified finite-level complex, using both recorded notions.
Source: Stacks 0G7E (blueprint: def-pur-strict-quotient-expressions). -/
def Good {W : Scheme.{t}} (K : Complex l E W) (n : ℕ) : Prop :=
  CochainComplex.IsKFlatIndependentCoefficients
      (R := integralCoefficientCommRingSheaf l E W n) (level l E K n) ∧
    ∀ k : ℤ, SheafOfModules.IsFlatOnSite
      (J := Scheme.ProEt.topology W) (R := integralCoefficientCommRingSheaf l E W n)
      ((level l E K n).X k)

/-- The underlying additive horizontal map, with its two endpoints specified.
Source: Stacks 0941 (blueprint: def-pur-strict-quotient-expressions). -/
def horizontal {W : Scheme.{t}} (M : coefficientSequenceModules l E W)
    {m n : ℕ} (hmn : n ≤ m) (U : W.ProEt)
    (x : M.val.obj (op (m, U))) : M.val.obj (op (n, U)) :=
  M.val.presheaf.map
    (Prod.mkHom (homOfLE hmn) (𝟙 U) : (n, U) ⟶ (m, U)).op x

/-- Tensor transitions are induced on every pure total-tensor summand.
Source: Stacks 07A4 (blueprint: def-pur-strict-quotient-expressions). -/
def TensorTransitions {W : Scheme.{t}} (P Q : Complex l E W) : Prop :=
  ∀ {m n : ℕ} (hmn : n ≤ m) (p q k : ℤ) (hpq : p + q = k) (U : W.ProEt)
    (x : (P.X p).val.obj (op (m, U))) (y : (Q.X q).val.obj (op (m, U))),
    horizontal l E ((total l E P Q).X k) hmn U
        (coefficientTensorGenerator.{u, t+1, t}
          (coefficientSequenceTopology (Scheme.ProEt.topology W))
          (coefficientSequenceCommRingSheaf l E W) P Q p q k hpq (op (m, U)) x y) =
      coefficientTensorGenerator.{u, t+1, t}
        (coefficientSequenceTopology (Scheme.ProEt.topology W))
        (coefficientSequenceCommRingSheaf l E W) P Q p q k hpq (op (n, U))
        (horizontal l E (P.X p) hmn U x)
        (horizontal l E (Q.X q) hmn U y)

/-- Pullback transitions are induced on the adjunction-unit generators. Their
semilinearity supplies the coefficient q(s) for every scalar multiple s tensor x.
Source: Stacks 03D2, 07A4 (blueprint: def-pur-strict-quotient-expressions). -/
def PullbackTransitions {V W : Scheme.{t}} (g : V ⟶ W) (P : Complex l E W) : Prop :=
  ∀ {m n : ℕ} (hmn : n ≤ m) (k : ℤ) (U : W.ProEt)
    (x : (P.X k).val.obj (op (m, U))),
    horizontal l E ((pull l E g P).X k) hmn ((Scheme.proEtaleBaseChange g).obj U)
          (integralComparisonSequenceGenerator l E g (P.X k) m U x) =
      integralComparisonSequenceGenerator l E g (P.X k) n U
        (horizontal l E (P.X k) hmn U x)

/-- The ordinary adjoint is a chain isomorphism and localizes to the derived adjoint
of this very transition. This is quantified over normalized coefficient calculi, so
it is independent of any presentation of the universal derived extension.
Source: Stacks 07A6 (blueprint: def-pur-strict-quotient-expressions). -/
def AdjointModel {W : Scheme.{t}} (K : Complex l E W)
    (S : CoefficientDerivedSystemTensors l E W)
    (D : CoefficientFiniteQuotientCalculus l E W S) {m n : ℕ} (hmn : n ≤ m)
    (hK : CochainComplex.IsKFlatIndependentCoefficients
      (R := integralCoefficientCommRingSheaf l E W m) (level l E K m)) : Prop :=
  ∃ a : ((coefficientFiniteQuotientExtension l E W hmn).mapHomologicalComplex (.up ℤ)).obj
      (level l E K m) ≅ level l E K n,
    ((D.ordinaryAdjunction hmn).mapHomologicalComplex (.up ℤ)).homEquiv _ _ a.hom =
      transition l E K hmn ∧
    ((D.adjunction hmn).homEquiv _ _).symm
        (DerivedCategory.Q.map (transition l E K hmn) ≫
          (normalizedDVRModuleRes l E W hmn).mapDerivedCategoryFactors.inv.app (level l E K n)) =
      (coefficientFiniteQuotientModel l E W hmn (level l E K m) hK).hom ≫
        DerivedCategory.Q.map a.hom ∧
    (∀ (k : ℤ) (U : W.ProEtᵒᵖ) (x : ((level l E K m).X k).val.obj U)
      (b : (integralCoefficientSheaf l E W n).obj.obj U),
      (a.hom.f k).val.app U
          (b • coefficientFiniteQuotientUnitSection l E W hmn
            ((level l E K m).X k) U x) =
        b • coefficientRestrictionSection (normalizedDVRQuotient l E W hmn)
          ((level l E K n).X k) U (((transition l E K hmn).f k).val.app U x) ∧
      (a.inv.f k).val.app U
          (b • coefficientRestrictionSection (normalizedDVRQuotient l E W hmn)
            ((level l E K n).X k) U (((transition l E K hmn).f k).val.app U x)) =
        b • coefficientFiniteQuotientUnitSection l E W hmn ((level l E K m).X k) U x)

/-- The permitted pullback arrows, with their actual domains and codomains.
Source: finite-expression paragraph (blueprint: def-pur-strict-quotient-expressions). -/
inductive AllowedArrow {Z X Y : Scheme.{t}} (h : Z ⟶ X) (f : X ⟶ Y) :
    {V W : Scheme.{t}} → (V ⟶ W) → Prop where
  | first : AllowedArrow h f f
  | second : AllowedArrow h f h
  | composite : AllowedArrow h f (h ≫ f)

/-- The finite pullback identification is pinned on the inverse-image generators.
Source: Stacks 03D2, 0G7E (blueprint: def-pur-strict-quotient-expressions). -/
def PullbackIdentification {V W : Scheme.{t}} (g : V ⟶ W) (P : Complex l E W) (n : ℕ)
    (e : level l E (pull l E g P) n ≅
      ((integralOperationsLevelPullback l E g n).mapHomologicalComplex (.up ℤ)).obj
        (level l E P n)) : Prop :=
  ∀ (k : ℤ) (U : W.ProEt) (x : (P.X k).val.obj (op (n, U))),
    (e.hom.f k).val.app (op ((Scheme.proEtaleBaseChange g).obj U))
        (integralComparisonSequenceGenerator l E g (P.X k) n U x) =
      integralOperationsPullbackGenerator l E g n ((level l E P n).X k) U x

/-- The finite pullback interpretation is fixed on the inverse-image generators.
Source: Stacks 03D2, 0G7E (blueprint: def-pur-strict-quotient-expressions). -/
def PullbackModel {V W : Scheme.{t}} (g : V ⟶ W) (P : Complex l E W) (n : ℕ) : Prop :=
  ∃ e : level l E (pull l E g P) n ≅
      ((integralOperationsLevelPullback l E g n).mapHomologicalComplex (.up ℤ)).obj
        (level l E P n), PullbackIdentification l E g P n e

/-- Localization of ordinary finite pullback computes every universal derived pair on P.
Source: Stacks 0G7E (blueprint: def-pur-strict-quotient-expressions). -/
def PullbackComputes {V W : Scheme.{t}} (g : V ⟶ W) (P : Complex l E W) (n : ℕ) : Prop :=
  ∀ (LF : normalizedDVRDerived l E W n ⥤ normalizedDVRDerived l E V n)
    (ε : DerivedCategory.Q ⋙ LF ⟶
      (integralOperationsLevelPullback l E g n).mapHomologicalComplex (.up ℤ) ⋙ DerivedCategory.Q),
    LF.IsLeftDerivedFunctor ε
      (HomologicalComplex.quasiIso (normalizedDVRModules l E W n) (.up ℤ)) →
    IsIso (ε.app (level l E P n))

/-- The derived adjunct of the actual horizontal transition, with exact-localization
transport on its restricted target.
Source: Stacks 07A6 (blueprint: def-pur-strict-quotient-expressions). -/
def alpha {W : Scheme.{t}} (K : Complex l E W)
    (S : CoefficientDerivedSystemTensors l E W)
    (D : CoefficientFiniteQuotientCalculus l E W S) {m n : ℕ} (hmn : n ≤ m) :
    (coefficientFiniteQuotientDerived l E W hmn).obj
      (DerivedCategory.Q.obj (level l E K m)) ⟶ DerivedCategory.Q.obj (level l E K n) :=
  ((D.adjunction hmn).homEquiv _ _).symm
    (DerivedCategory.Q.map (transition l E K hmn) ≫
      (normalizedDVRModuleRes l E W hmn).mapDerivedCategoryFactors.inv.app (level l E K n))

/-- The ordinary adjunct of that same transition.
Source: Stacks 07A6 (blueprint: def-pur-strict-quotient-expressions). -/
def ordinaryAlpha {W : Scheme.{t}} (K : Complex l E W)
    (S : CoefficientDerivedSystemTensors l E W)
    (D : CoefficientFiniteQuotientCalculus l E W S) {m n : ℕ} (hmn : n ≤ m) :
    ((coefficientFiniteQuotientExtension l E W hmn).mapHomologicalComplex (.up ℤ)).obj
      (level l E K m) ⟶ level l E K n :=
  (((D.ordinaryAdjunction hmn).mapHomologicalComplex (.up ℤ)).homEquiv _ _).symm
    (transition l E K hmn)

/-- The canonical derived tensor identification on the specified Good representatives:
localize the ordinary evaluation comparison, then use the finite K-flat tensor model.
Source: Stacks 07A4, 0941 (blueprint: def-pur-strict-quotient-expressions). -/
def tensorComparison {W : Scheme.{t}} (U V : Complex l E W) (n : ℕ)
    (S : CoefficientDerivedSystemTensors l E W) (hU : Good l E U n) (hV : Good l E V n) :
    DerivedCategory.Q.obj (level l E (total l E U V) n) ≅
      (S.finiteClosed n).tensor.obj
        (DerivedCategory.Q.obj (level l E U n), DerivedCategory.Q.obj (level l E V n)) :=
  DerivedCategory.Q.mapIso (coefficientEvaluationTensorIso l E W n U V) ≪≫
    (S.finiteTensorModel n).iso (Scheme.ProEt.topology W)
      (integralCoefficientCommRingSheaf l E W n) (S.finiteClosed n)
      (level l E U n) (level l E V n) hU.1 hV.1

/-- The tensor adjunct is the strong monoidal scalar-change comparison followed by
exactly the tensor of the two factor adjuncts, under the canonical tensor models.
Source: Stacks 07A4, 07A6 (blueprint: def-pur-strict-quotient-expressions). -/
def TensorAdjointEquation {W : Scheme.{t}} (U V : Complex l E W)
    (S : CoefficientDerivedSystemTensors l E W)
    (D : CoefficientFiniteQuotientCalculus l E W S) {m n : ℕ} (hmn : n ≤ m)
    (hUm : Good l E U m) (hVm : Good l E V m)
    (hUn : Good l E U n) (hVn : Good l E V n) : Prop :=
  (coefficientFiniteQuotientDerived l E W hmn).map
        (tensorComparison l E U V m S hUm hVm).hom ≫
      (D.tensor hmn).hom.app
        (DerivedCategory.Q.obj (level l E U m), DerivedCategory.Q.obj (level l E V m)) ≫
      (S.finiteClosed n).tensor.map
        (Prod.mkHom (alpha l E U S D hmn) (alpha l E V S D hmn)) =
    alpha l E (total l E U V) S D hmn ≫
      (tensorComparison l E U V n S hUn hVn).hom

/-- Ordinary finite inverse image on cochains, using the fixed constant-ring comparison.
Source: Stacks 03D2 (blueprint: def-pur-strict-quotient-expressions). -/
abbrev finitePull {V W : Scheme.{t}} (g : V ⟶ W) (n : ℕ) :=
  (integralOperationsLevelPullback l E g n).mapHomologicalComplex (.up ℤ)

/-- The scalar-change chain comparison is pinned by the insertion generators, in the
orientation from extension after inverse image to inverse image after extension.
The actual finite pullbacks include the canonical inverse-image coefficient isomorphisms.
Linearity extends the formula to all scalars; the Kan-extension generators and sheafification
fix the comparison on every section.
Source: Stacks 03EL; det-prop-scalar-six-pullback (1), ordinary comparison of
lem-sfb-kflat-scalar-comparison-normalization
(blueprint: def-pur-strict-quotient-expressions). -/
def ScalarPullbackIdentification {V W : Scheme.{t}} (g : V ⟶ W)
    (K : Complex l E W) {m n : ℕ} (hmn : n ≤ m)
    (χ : ((coefficientFiniteQuotientExtension l E V hmn).mapHomologicalComplex (.up ℤ)).obj
        ((finitePull l E g m).obj (level l E K m)) ≅
      (finitePull l E g n).obj
        (((coefficientFiniteQuotientExtension l E W hmn).mapHomologicalComplex (.up ℤ)).obj
          (level l E K m))) : Prop :=
  ∀ (k : ℤ) (U : W.ProEt) (x : ((level l E K m).X k).val.obj (op U)),
    (χ.hom.f k).val.app (op ((Scheme.proEtaleBaseChange g).obj U))
        (coefficientFiniteQuotientUnitSection l E V hmn
          (((finitePull l E g m).obj (level l E K m)).X k)
          (op ((Scheme.proEtaleBaseChange g).obj U))
          (integralOperationsPullbackGenerator l E g m ((level l E K m).X k) U x)) =
      integralOperationsPullbackGenerator l E g n
        ((((coefficientFiniteQuotientExtension l E W hmn).mapHomologicalComplex (.up ℤ)).obj
          (level l E K m)).X k) U
        (coefficientFiniteQuotientUnitSection l E W hmn ((level l E K m).X k) (op U) x)

/-- The pullback adjunct is inverse image of the factor adjunct under the canonical
scalar-change comparison. This is the pinned ordinary chain-isomorphism formulation;
AdjointModel localizes these very adjuncts through the canonical K-flat counits.
Source: Stacks 03EL, 07A6; det-prop-scalar-six-pullback (1) and
lem-sfb-kflat-scalar-comparison-normalization
(blueprint: def-pur-strict-quotient-expressions). -/
def PullbackAdjointEquation {V W : Scheme.{t}} (g : V ⟶ W) (K : Complex l E W)
    (SW : CoefficientDerivedSystemTensors l E W)
    (DW : CoefficientFiniteQuotientCalculus l E W SW)
    (SV : CoefficientDerivedSystemTensors l E V)
    (DV : CoefficientFiniteQuotientCalculus l E V SV) {m n : ℕ} (hmn : n ≤ m) : Prop :=
  ∃ (em : level l E (pull l E g K) m ≅ (finitePull l E g m).obj (level l E K m))
    (en : level l E (pull l E g K) n ≅ (finitePull l E g n).obj (level l E K n))
    (χ : ((coefficientFiniteQuotientExtension l E V hmn).mapHomologicalComplex (.up ℤ)).obj
        ((finitePull l E g m).obj (level l E K m)) ≅
      (finitePull l E g n).obj
        (((coefficientFiniteQuotientExtension l E W hmn).mapHomologicalComplex (.up ℤ)).obj
          (level l E K m))),
    PullbackIdentification l E g K m em ∧ PullbackIdentification l E g K n en ∧
    ScalarPullbackIdentification l E g K hmn χ ∧
    ((coefficientFiniteQuotientExtension l E V hmn).mapHomologicalComplex (.up ℤ)).map
          em.hom ≫ χ.hom ≫ (finitePull l E g n).map (ordinaryAlpha l E K SW DW hmn) =
      ordinaryAlpha l E (pull l E g K) SV DV hmn ≫ en.hom

end WeilConjectures.StrictQuotient
