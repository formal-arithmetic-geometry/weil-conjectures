module

public import Sheaf.Paper.PointHeartFiniteStageData

/-! # A step of the exact point-heart and finite-stage argument -/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
set_option genSizeOf false
set_option genInjectivity false
universe u
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
namespace WeilConjectures

variable (D : FiniteFieldDatum.{u}) (l : ℕ) [Fact l.Prime] (hl : l ≠ D.p)
  (Ω : Type u) [Field Ω] [Algebra (Padic l) Ω] [IsAlgClosure (Padic l) Ω]

/-- The specified point-heart scalar comparison is normalized at the identity
and compatible with successive finite coefficient extensions.
Source: the point sections/scalar comparison, the cohomology/tensor tower, and
step 4 of lem-zl-point-heart-finite-stage
(blueprint: lem-zl-point-heart-scalar-normalizations).

Proof: on integral representatives the specified rational fibre/scalar comparison
is the recorded sections comparison, conjugated by the coefficient-size descent
counits. The sections comparison satisfies the identity and composition equations.
Apply degree-zero cohomology and compose with the canonical cohomology/tensor
comparison. The latter sends cycle tensors to their cycle classes, and its tower
identity is fieldDerivedHomologyIso_tower. Naturality moves each intermediate
comparison past the next scalar functor; inverse components cancel and the ordinary
tensor associator remains. This proves the displayed unit and composition equations
on integral representatives. Rational morphisms are generated by pure coefficient
tensors, so the same equations descend through rational localization. In particular
the identity extension and repeated fields retain their prescribed normalization. -/
theorem zl_point_heart_scalar_normalizations :
    (∀ (E' : Type u) [Field E'] [Algebra (Padic l) E']
        [FiniteDimensional (Padic l) E']
        (K : sfRationalConstructibleCategory l E' (Spec (.of D.k))),
      (pointRationalFibre D l hl E' ⋙ DerivedCategory.coefficientFdCohomology E' 0).mapIso
         ((sfRationalScalarUnit l E' (Spec (.of D.k)) 0
            (Nat.Prime.ne_zero (Fact.out : l.Prime))).app K) =
        zlPointHeartScalar D l hl E' E' (AlgHom.id (Padic l) E') K ≪≫
          (ModuleCat.extendScalarsId E').app
            ((pointRationalFibre D l hl E' ⋙
              DerivedCategory.coefficientFdCohomology E' 0).obj K)) ∧
    (∀ (E' L' N' : Type u) [Field E'] [Algebra (Padic l) E']
        [FiniteDimensional (Padic l) E'] [Field L'] [Algebra (Padic l) L']
        [FiniteDimensional (Padic l) L'] [Field N'] [Algebra (Padic l) N']
        [FiniteDimensional (Padic l) N']
        (i : E' →ₐ[Padic l] L') (j : L' →ₐ[Padic l] N')
        (K : sfRationalConstructibleCategory l E' (Spec (.of D.k))),
      (pointRationalFibre D l hl N' ⋙ DerivedCategory.coefficientFdCohomology N' 0).mapIso
         ((sfRationalScalarComp l E' L' i (Spec (.of D.k)) 0
            (Nat.Prime.ne_zero (Fact.out : l.Prime)) N' j).app K) ≪≫
          zlPointHeartScalar D l hl E' N' (j.comp i) K =
        zlPointHeartScalar D l hl L' N' j ((zlPointScalar D l E' L' i).obj K) ≪≫
          (ModuleCat.extendScalars j.toRingHom).mapIso
            (zlPointHeartScalar D l hl E' L' i K) ≪≫
          ((ModuleCat.extendScalarsComp i.toRingHom j.toRingHom).app
            ((pointRationalFibre D l hl E' ⋙
              DerivedCategory.coefficientFdCohomology E' 0).obj K)).symm) := by sorry

end WeilConjectures
