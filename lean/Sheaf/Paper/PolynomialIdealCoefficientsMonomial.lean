import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.Quotient
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.LinearAlgebra.Quotient.Basic

universe u

open MvPolynomial

/-! # Coefficients of a polynomial modulo coordinate generators
Source: literature/stacks-project/algebra.tex, proof of Lemma Tag 07DW
(blueprint: lem-weil-pbc-polynomial-ideal-coefficients-monomial)
-/

namespace MvPolynomial

/-- The coefficientwise membership criterion and direct-sum decomposition for the ideal
`J = (g₁x₁, …, gᵢxᵢ)` of `R[x₁, …, x_r]`: the variable `xⱼ` for `j ≤ i` is
`X (Fin.castLE hir j)`, and `I_E` is the ideal generated by the `gⱼ` with `eⱼ > 0`.
Source: literature/stacks-project/algebra.tex, proof of Lemma Tag 07DW
(blueprint: lem-weil-pbc-polynomial-ideal-coefficients-monomial).
Proof (node): the coefficient of `x^E` in `gⱼxⱼq` is `gⱼ·coeff_{E-εⱼ}(q)` if `eⱼ > 0` and
`0` otherwise; hence every element `Σ qⱼgⱼxⱼ` of `J` has `c_E ∈ I_E`; conversely writing
`c_E = Σ a_{E,j} gⱼ` gives `c_E x^E = Σ a_{E,j} x^{E-εⱼ}·gⱼxⱼ ∈ J`. The coefficient map
`p ↦ (c_E mod I_E)_E` is `R`-linear, surjective (lift each class to a monomial) with kernel
`J` by the criterion, and induces `P/J ≅ ⨁_E R/I_E`. -/
theorem ideal_coefficients_monomial
    {R : Type u} [CommRing R] (r i : ℕ) (hr : 1 ≤ r) (hir : i ≤ r)
    (g : Fin i → R)
    (p : MvPolynomial (Fin r) R) :
    (p ∈ Ideal.span (Set.range fun j : Fin i => C (g j) * X (Fin.castLE hir j)) ↔
        ∀ E : Fin r →₀ ℕ,
          coeff E p ∈ Ideal.span (g '' {j : Fin i | E (Fin.castLE hir j) ≠ 0})) ∧
      ∃ Φ : MvPolynomial (Fin r) R →ₗ[R]
          Π₀ E : Fin r →₀ ℕ, R ⧸ Ideal.span (g '' {j : Fin i | E (Fin.castLE hir j) ≠ 0}),
        (∀ q E, Φ q E = Ideal.Quotient.mk _ (coeff E q)) ∧
        Function.Surjective Φ ∧
        LinearMap.ker Φ = Submodule.restrictScalars R
          (Ideal.span (Set.range fun j : Fin i => C (g j) * X (Fin.castLE hir j))) ∧
        ∃ e : (MvPolynomial (Fin r) R ⧸
            Ideal.span (Set.range fun j : Fin i => C (g j) * X (Fin.castLE hir j))) ≃ₗ[R]
            Π₀ E : Fin r →₀ ℕ, R ⧸ Ideal.span (g '' {j : Fin i | E (Fin.castLE hir j) ≠ 0}),
          ∀ q, e (Ideal.Quotient.mk _ q) = Φ q := by
  sorry

end MvPolynomial
