/-! # Coordinate faces of the unpunctured compatible-root tower

Source: blueprint main-20261015, direct-image stability proof, paragraph (3),
agent-extracted coordinate-face input (blueprint: lem-sfb-root-tower-coordinate-face).

The root algebra, coefficient rings, lisse modules and profinite tests are the existing
constructions. The face is the quotient by the selected root coordinates. In particular
it is not the possibly nonreduced cartesian fibre. The comparison is the mate of the
canonical pullback comparison, hence the adjunct of the pulled-back counit.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.RootCoordinateFace

variable (p : ℕ) {R : Type u} [CommRing R] {r : ℕ} (t : Fin r → R)

/-- The ideal of a coordinate face on the base.
Source: direct-image proof (3), U_J (blueprint: lem-sfb-root-tower-coordinate-face). -/
def baseIdeal (J : Finset (Fin r)) : Ideal R :=
  Ideal.span {a | ∃ j ∈ J, a = t j}

/-- The ideal generated by all roots in the selected branches, with no nilpotence bound.
Source: direct-image proof (3), e_J (blueprint: lem-sfb-root-tower-coordinate-face). -/
def rootIdeal (J : Finset (Fin r)) : Ideal (tameRootAlgebra p t) :=
  Ideal.span {a | ∃ (j : Fin r), j ∈ J ∧ ∃ n : TameRootOrder p,
    a = Ideal.Quotient.mk (Ideal.span (tameRootRelations p t)) (MvPolynomial.X (j, n))}

/-- The coordinate-face algebra. Eliminating the selected variables in the presentation
leaves precisely the root algebra on the remaining variables over R/(t_j : j in J).
Source: direct-image proof (3), T_J (blueprint: lem-sfb-root-tower-coordinate-face). -/
abbrev faceRing (J : Finset (Fin r)) := tameRootAlgebra p t ⧸ rootIdeal p t J

/-- The face inclusion sets exactly the selected root coordinates to zero.
Source: direct-image proof (3), e_J (blueprint: lem-sfb-root-tower-coordinate-face). -/
def inclusion (J : Finset (Fin r)) :
    Spec (.of (faceRing p t J)) ⟶ Spec (.of (tameRootAlgebra p t)) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (rootIdeal p t J)))

/-- Every selected parameter belongs to the selected-root ideal after scalar extension.
Source: direct-image proof (3), root equations
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: take the order-one root (1 is prime to p). Its defining equation identifies
the image of t_j with x_(j,1), a generator of the displayed root ideal. The span
universal property gives the asserted containment. This includes J empty. -/
theorem baseIdeal_le (J : Finset (Fin r)) :
    baseIdeal t J ≤ (rootIdeal p t J).comap (algebraMap R (tameRootAlgebra p t)) := by
  sorry

/-- The structural projection of the coordinate face, induced by the actual quotient map.
Source: direct-image proof (3), q_J (blueprint: lem-sfb-root-tower-coordinate-face). -/
def projection (J : Finset (Fin r)) :
    Spec (.of (faceRing p t J)) ⟶ Spec (.of (R ⧸ baseIdeal t J)) :=
  Spec.map (CommRingCat.ofHom
    (Ideal.quotientMap (rootIdeal p t J) (algebraMap R (tameRootAlgebra p t))
      (baseIdeal_le p t J)))

/-- The closed coordinate immersion on the base.
Source: direct-image proof (3), g_J (blueprint: lem-sfb-root-tower-coordinate-face). -/
def baseInclusion (J : Finset (Fin r)) : Spec (.of (R ⧸ baseIdeal t J)) ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (baseIdeal t J)))

/-- The profinite test scheme, using the recorded functor X[-].
Source: direct-image proof (3), T[P] (blueprint: lem-sfb-root-tower-coordinate-face). -/
abbrev test (X : Scheme.{u}) (P : Profinite.{u}) := (profiniteToProEtOf X).obj P

/-- Functoriality of X[P] in the scheme X, as the actual map of fibre products over Spec Z.
Source: direct-image proof (3), e_(J,P)
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def testMap {X Y : Scheme.{u}} (f : X ⟶ Y) (P : Profinite.{u}) :
    (test X P).left ⟶ (test Y P).left :=
  pullback.lift (pullback.fst _ _) ((test X P).hom ≫ f)
    (specULiftZIsTerminal.hom_ext _ _)

/-- The full test-tower structural projection.
Source: direct-image proof (3), q_P (blueprint: lem-sfb-root-tower-coordinate-face). -/
def towerProjection (P : Profinite.{u}) :
    (test (Spec (.of (tameRootAlgebra p t))) P).left ⟶ Spec (.of R) :=
  (test _ P).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R (tameRootAlgebra p t)))

/-- The face-test structural projection.
Source: direct-image proof (3), q_(J,P)
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def faceProjection (J : Finset (Fin r)) (P : Profinite.{u}) :
    (test (Spec (.of (faceRing p t J))) P).left ⟶ Spec (.of (R ⧸ baseIdeal t J)) :=
  (test _ P).hom ≫ projection p t J

/-- The quotient and structural projections form the specified commuting square.
Source: direct-image proof (3), face square
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: the quotient homomorphism sends the class of a coefficient a to its class
in the root quotient. Spec reverses this equality. The second projection of the
profinite fibre product commutes with testMap by the pullback projection equation. -/
theorem square (J : Finset (Fin r)) (P : Profinite.{u}) :
    testMap (inclusion p t J) P ≫ towerProjection p t P =
      faceProjection p t J P ≫ baseInclusion t J := by
  sorry

/-- Nested faces enlarge both displayed ideals.
Source: direct-image proof (3), successive coordinate restriction
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: every parameter generator, respectively root generator, indexed by J is also
indexed by J' when J is contained in J'. Apply monotonicity of ideal span. -/
theorem ideals_mono {J J' : Finset (Fin r)} (h : J ⊆ J') :
    baseIdeal t J ≤ baseIdeal t J' ∧ rootIdeal p t J ≤ rootIdeal p t J' := by
  sorry

/-- Successive restriction between base coordinate faces is the quotient factor map.
Source: direct-image proof (3), nested g_J
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def nestedBase {J J' : Finset (Fin r)} (h : J ⊆ J') :
    Spec (.of (R ⧸ baseIdeal t J')) ⟶ Spec (.of (R ⧸ baseIdeal t J)) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (ideals_mono p t h).1))

/-- Successive restriction between tower faces is the quotient factor map.
Source: direct-image proof (3), nested e_J
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def nestedFace {J J' : Finset (Fin r)} (h : J ⊆ J') :
    Spec (.of (faceRing p t J')) ⟶ Spec (.of (faceRing p t J)) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (ideals_mono p t h).2))

/-- The canonical nested-face square and its two composite restrictions.
Source: direct-image proof (3), J contained in J'
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: on coefficients both quotient maps send a to its residue class; on selected
roots the composite kills precisely the J' roots. Equality of quotient factor maps
gives the two composites and the structural square. Forming X[P] preserves these
equalities by the universal property of its fibre product over Spec Z. -/
theorem nested_square {J J' : Finset (Fin r)} (h : J ⊆ J') (P : Profinite.{u}) :
    testMap (nestedFace p t h) P ≫ faceProjection p t J P =
        faceProjection p t J' P ≫ nestedBase p t h ∧
      nestedBase p t h ≫ baseInclusion t J = baseInclusion t J' ∧
      testMap (nestedFace p t h) P ≫ testMap (inclusion p t J) P =
        testMap (inclusion p t J') P := by
  sorry

/-- Profinite test maps commute with the face square on the entire test schemes.
Source: direct-image proof (3), naturality in P and profinite families
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: each test map is the map induced by the given morphism of profinite sets on
the first factor of X[P]. The structural projection uses the second factor. The
pullback projection equations give both structural triangles and the commuting face
square. This argument applies also when P is a product with a profinite Q. -/
theorem profinite_square (J : Finset (Fin r)) {P' P : Profinite.{u}} (f : P' ⟶ P) :
    ((profiniteToProEtOf (Spec (.of (tameRootAlgebra p t)))).map f).left ≫
        towerProjection p t P = towerProjection p t P' ∧
      ((profiniteToProEtOf (Spec (.of (faceRing p t J)))).map f).left ≫
        faceProjection p t J P = faceProjection p t J P' ∧
      ((profiniteToProEtOf (Spec (.of (faceRing p t J)))).map f).left ≫
          testMap (inclusion p t J) P =
        testMap (inclusion p t J) P' ≫
          ((profiniteToProEtOf (Spec (.of (tameRootAlgebra p t)))).map f).left := by
  sorry

section Coefficients

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
  [MonObj Λ] [IsCommMonObj Λ]

/-- The internal-module category over the specified pulled-back coefficient ring.
Source: direct-image proof (3), Mod(C_(F,X))
(blueprint: lem-sfb-root-tower-coordinate-face). -/
abbrev Modules (X : Scheme.{u}) :=
  Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)

/-- Exact coefficient pullback on the ordinary unbounded derived category.
Source: direct-image proof (3), g_J^* (blueprint: lem-sfb-root-tower-coordinate-face). -/
abbrev upper {X Y : Scheme.{u}} (f : X ⟶ Y) :=
  (CondensedRing.upperStar Λ f).mapDerivedCategory

/-- The recorded total right derived functor of the full module direct image.
Source: direct-image proof (3), Rq_* (blueprint: lem-sfb-root-tower-coordinate-face). -/
abbrev lower {X Y : Scheme.{u}} (f : X ⟶ Y) :=
  CondensedRing.moduleObjectDerivedPushforward Λ f

/-- The actual exact-pullback/total-direct-image derived adjunction.
Source: direct-image proof (3), defining counit
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def adjunction {X Y : Scheme.{u}} (f : X ⟶ Y) : upper Λ f ⊣ lower Λ f :=
  (CondensedRing.upperStarLowerStarAdjunction Λ f).mapDerivedCategoryRightDerivedAdjunction

/-- Composition of exact pullbacks, induced from the recorded ordinary comparison.
Source: direct-image proof (3), canonical identifications
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def upperComp {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) :
    upper Λ (f ≫ g) ≅ upper Λ g ⋙ upper Λ f :=
  Functor.mapDerivedCategoryNatIso (CondensedRing.upperStarComp Λ f g) ≪≫
    Functor.mapDerivedCategoryCompIso _ _

/-- The adjunction-normalized composite direct image; no arbitrary isomorphism is chosen.
Source: direct-image proof (3), canonical composition identification
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def lowerComp {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) :
    lower Λ (f ≫ g) ≅ lower Λ f ⋙ lower Λ g :=
  conjugateIsoEquiv (adjunction Λ (f ≫ g))
    ((adjunction Λ g).comp (adjunction Λ f)) (upperComp Λ f g).symm

/-- The pullback identification for a commuting square, without a cartesianness assumption.
Source: direct-image proof (3), q_J^* g_J^* = e_J^* q^*
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def squareUpper {X' X Y' Y : Scheme.{u}}
    (e : X' ⟶ X) (q' : X' ⟶ Y') (q : X ⟶ Y) (g : Y' ⟶ Y)
    (h : e ≫ q = q' ≫ g) :
    upper Λ g ⋙ upper Λ q' ≅ upper Λ q ⋙ upper Λ e :=
  (upperComp Λ q' g).symm ≪≫
    eqToIso (congrArg (upper Λ) h.symm) ≪≫ upperComp Λ e q

/-- The mate of the actual pullback comparison. Its transpose is e^* of the q-counit.
This formula also defines ordinary cartesian exchange when the square is cartesian.
Source: direct-image proof (3), beta_(J,P)
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def exchange {X' X Y' Y : Scheme.{u}}
    (e : X' ⟶ X) (q' : X' ⟶ Y') (q : X ⟶ Y) (g : Y' ⟶ Y)
    (h : e ≫ q = q' ≫ g) :
    lower Λ q ⋙ upper Λ g ⟶ upper Λ e ⋙ lower Λ q' :=
  (mateEquiv (adjunction Λ q) (adjunction Λ q')
    (TwoSquare.mk _ _ _ _ (squareUpper Λ e q' q g h).hom)).natTrans

/-- The coordinate-face comparison, with exactly the counit normalization in the node.
Source: direct-image proof (3), beta_(J,P)
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def beta (J : Finset (Fin r)) (P : Profinite.{u}) :
    lower Λ (towerProjection p t P) ⋙ upper Λ (baseInclusion t J) ⟶
      upper Λ (testMap (inclusion p t J) P) ⋙ lower Λ (faceProjection p t J P) :=
  exchange Λ _ _ _ _ (square p t J P)

end Coefficients

section Normalizations

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
  [MonObj Λ] [IsCommMonObj Λ]

/-- The specified comparison is the adjunct of the pulled-back counit, and its adjunct
on the base is the direct image of the closed unit. These identities use the normalized
composition isomorphisms, and apply in particular to every coordinate face.
Source: direct-image proof (3), the two adjunct descriptions
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: transpose the mate under q'^* -| Rq'_*. The unit/counit triangle cancels,
leaving the square pullback identification followed by e^* of the q-counit.
Transpose instead under g^* -| Rg_*. The same triangle cancellation gives Rq_*
of the e-unit. The conjugate definition of lowerComp identifies the two composite
adjunctions, so its unit is exactly the composite unit, with the displayed orientation. -/
theorem exchange_adjuncts {X' X Y' Y : Scheme.{u}}
    (e : X' ⟶ X) (q' : X' ⟶ Y') (q : X ⟶ Y) (g : Y' ⟶ Y)
    (h : e ≫ q = q' ≫ g) (K : DerivedCategory (Modules Λ X)) :
    (adjunction Λ q').homEquiv _ _
        ((squareUpper Λ e q' q g h).hom.app ((lower Λ q).obj K) ≫
          (upper Λ e).map ((adjunction Λ q).counit.app K)) =
      (exchange Λ e q' q g h).app K ∧
    (adjunction Λ g).homEquiv _ _ ((exchange Λ e q' q g h).app K) =
      (lower Λ q).map ((adjunction Λ e).unit.app K) ≫
        (lowerComp Λ e q).inv.app ((upper Λ e).obj K) ≫
        eqToHom (congrArg
          (fun a ↦ (lower Λ a).obj ((upper Λ e).obj K)) h) ≫
        (lowerComp Λ q' g).hom.app ((upper Λ e).obj K) := by
  sorry

/-- Pasting coordinate restrictions or scheme/test-parameter restrictions preserves the
actual comparisons. Equality of two composite geometric maps therefore gives equality
of the two comparison paths, including for automorphisms preserving a face.
Source: direct-image proof (3), nested-face and family compatibilities
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: transpose each path under q''^* -| Rq''_*. The pasting of pullback comparisons
is the comparison of the composite square, since it descends the ordinary pullback
composition. Naturality moves the first counit through the next square comparison;
the triangle identity leaves the counit pulled back along e' followed by e. Both
transposes are thus identical. This is equality of maps of derived objects. Applying
it on P times Q gives equality on the Q-parametrized objects themselves, rather than
only after evaluating at individual points of Q. -/
theorem exchange_vertical_pasting {X'' X' X Y'' Y' Y : Scheme.{u}}
    (e : X' ⟶ X) (q' : X' ⟶ Y') (q : X ⟶ Y) (g : Y' ⟶ Y)
    (e' : X'' ⟶ X') (q'' : X'' ⟶ Y'') (g' : Y'' ⟶ Y')
    (h : e ≫ q = q' ≫ g) (h' : e' ≫ q' = q'' ≫ g')
    (hc : (e' ≫ e) ≫ q = q'' ≫ (g' ≫ g))
    (K : DerivedCategory (Modules Λ X)) :
    (exchange Λ (e' ≫ e) q'' q (g' ≫ g) hc).app K =
      (upperComp Λ g' g).hom.app ((lower Λ q).obj K) ≫
        (upper Λ g').map ((exchange Λ e q' q g h).app K) ≫
        (exchange Λ e' q'' q' g' h').app ((upper Λ e).obj K) ≫
        (lower Λ q'').map ((upperComp Λ e' e).inv.app K) := by
  sorry

/-- Pasting with a structural map gives cartesian exchange followed by closed restriction.
Together with vertical pasting this is the full commuting-cube compatibility. In
particular it handles maps of P, pro-etale base changes, opens and face-preserving tower
automorphisms. The maps on a supplied module are handled by naturality of exchange.
Source: direct-image proof (3), cartesian factorization and naturality
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: transpose under the composite adjunction. The first mate supplies its pulled-back
counit; the second supplies the next counit. The normalized composite counit is their
composite. Thus the result is the mate of the composite square. For the factorization
take the first square to be the closed inclusion over an identity on the face base,
and the second square the cartesian square. Its first mate is the closed unit by
exchange_adjuncts. The same computation applies to either path around a cube. -/
theorem exchange_horizontal_pasting {X' X Y' Y Z' Z : Scheme.{u}}
    (e : X' ⟶ X) (q' : X' ⟶ Y') (q : X ⟶ Y) (g : Y' ⟶ Y)
    (f' : Y' ⟶ Z') (f : Y ⟶ Z) (b : Z' ⟶ Z)
    (h : e ≫ q = q' ≫ g) (h' : g ≫ f = f' ≫ b)
    (hc : e ≫ (q ≫ f) = (q' ≫ f') ≫ b)
    (K : DerivedCategory (Modules Λ X)) :
    (exchange Λ e (q' ≫ f') (q ≫ f) b hc).app K =
      (upper Λ b).map ((lowerComp Λ q f).hom.app K) ≫
        (exchange Λ g f' f b h').app ((lower Λ q).obj K) ≫
        (lower Λ f').map ((exchange Λ e q' q g h).app K) ≫
        (lowerComp Λ q' f').inv.app ((upper Λ e).obj K) := by
  sorry

/-- Naturality on the whole commuting cube. This formula is used for maps of profinite
tests, face-preserving automorphisms and pro-etale base change. No pointwise detection
is used: K and every map here are objects and maps on the entire parametrized scheme.
Source: direct-image proof (3), naturality and the profinite-family clause
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: paste the face square with the base-change square in either order. The two
resulting outer squares have the same geometric maps by hz and hb. Vertical pasting
identifies both mates with the mate of that outer square. The pullback composition
isomorphisms give exactly the transports displayed below. -/
theorem exchange_cube {Z' Z X' X W' W Y' Y : Scheme.{u}}
    (e : Z ⟶ X) (s : Z ⟶ W) (q : X ⟶ Y) (g : W ⟶ Y)
    (e' : Z' ⟶ X') (s' : Z' ⟶ W') (q' : X' ⟶ Y') (g' : W' ⟶ Y')
    (a : X' ⟶ X) (b : Y' ⟶ Y) (az : Z' ⟶ Z) (bw : W' ⟶ W)
    (h : e ≫ q = s ≫ g) (h' : e' ≫ q' = s' ≫ g')
    (hq : a ≫ q = q' ≫ b) (hs : az ≫ s = s' ≫ bw)
    (hz : az ≫ e = e' ≫ a) (hb : bw ≫ g = g' ≫ b)
    (K : DerivedCategory (Modules Λ X)) :
    (upper Λ bw).map ((exchange Λ e s q g h).app K) ≫
        (exchange Λ az s' s bw hs).app ((upper Λ e).obj K) ≫
        (lower Λ s').map ((squareUpper Λ az e' e a hz).inv.app K) =
      (upperComp Λ bw g).inv.app ((lower Λ q).obj K) ≫
        eqToHom (congrArg (fun f ↦ (upper Λ f).obj ((lower Λ q).obj K)) hb) ≫
        (upperComp Λ g' b).hom.app ((lower Λ q).obj K) ≫
        (upper Λ g').map ((exchange Λ a q' q b hq).app K) ≫
        (exchange Λ e' s' q' g' h').app ((upper Λ a).obj K) := by
  sorry

/-- Maps of the supplied modules commute with the actual comparison. This also applies
to a module action supplied on a profinite-parametrized scheme, without evaluating it
at the points of that profinite set.
Source: direct-image proof (3), module naturality and actions
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: the counit is natural in the module. Applying pullback and the natural square
comparison preserves that equality. Its adjoint is precisely the displayed equality. -/
theorem exchange_naturality {X' X Y' Y : Scheme.{u}}
    (e : X' ⟶ X) (q' : X' ⟶ Y') (q : X ⟶ Y) (g : Y' ⟶ Y)
    (h : e ≫ q = q' ≫ g) {K L : DerivedCategory (Modules Λ X)} (f : K ⟶ L) :
    (upper Λ g).map ((lower Λ q).map f) ≫ (exchange Λ e q' q g h).app L =
      (exchange Λ e q' q g h).app K ≫ (lower Λ q').map ((upper Λ e).map f) := by
  sorry

/-- The comparison on a cartesian pro-etale base change is the localization isomorphism.
It is the same mate used in beta, so exchange_cube gives compatibility with beta on
the base-changed tower, not merely an isomorphism between its source and target.
Source: direct-image proof (3), pro-etale localization
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: on a test V over the new base, localization identifies both derived direct
images with derived sections on X times_Y V. A K-injective resolution computes these
sections; the slice localization preserves the resolutions and their adjunctions.
The evaluated mate is the identity section restriction. Thus it is an isomorphism. -/
theorem exchange_proetale {X Y' Y : Scheme.{u}} (q : X ⟶ Y) (g : Y' ⟶ Y)
    [WeaklyEtale g] (K : DerivedCategory (Modules Λ X)) :
    IsIso ((exchange Λ (pullback.fst q g) (pullback.snd q g) q g
      (pullback.condition (f := q) (g := g))).app K) := by
  sorry

end Normalizations

/-- The face map into the cartesian fibre. Its source is the root quotient, not a
substitute cartesian fibre carrying nonzero nilpotent roots.
Source: direct-image proof (3), exchange factorization
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def fibreInclusion (J : Finset (Fin r)) (P : Profinite.{u}) :
    (test (Spec (.of (faceRing p t J))) P).left ⟶
      pullback (towerProjection p t P) (baseInclusion t J) :=
  pullback.lift (testMap (inclusion p t J) P) (faceProjection p t J P) (square p t J P)

/-- The root quotient is a surjective closed subscheme of the cartesian fibre, and both
coordinate inclusions are closed. No uniform nilpotence exponent is asserted.
Source: direct-image proof (3), nil-root quotient
(blueprint: lem-sfb-root-tower-coordinate-face).
Proof: in the cartesian fibre x_(j,n)^n = 0 for j in J. Killing all these roots
gives exactly faceRing. Every element of their ideal involves finitely many nilpotent
roots and is nilpotent, so the quotient is surjective on spectra. Finite disjoint
unions give the same calculation at finite quotients of P, and their filtered colimit
gives it on P. The base and tower inclusions are quotient maps on affine rings. -/
theorem fibreInclusion_properties (J : Finset (Fin r)) (P : Profinite.{u}) :
    IsClosedImmersion (baseInclusion t J) ∧
      IsClosedImmersion (testMap (inclusion p t J) P) ∧
      IsClosedImmersion (fibreInclusion p t J P) ∧
      Surjective (fibreInclusion p t J P) := by
  sorry

/-- Pullback of a module to the actual profinite test scheme, placed in degree zero.
Source: direct-image proof (3), N_P[0]
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def testModuleComplex
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] {X : Scheme.{u}}
    (N : Modules Λ X) (P : Profinite.{u}) : DerivedCategory (Modules Λ (test X P).left) :=
  (DerivedCategory.singleFunctor _ 0).obj
    ((CondensedRing.upperStar Λ (test X P).hom).obj N)

/-- The finite-rank-lisse coordinate-face assertion for a fixed coefficient field.
All continuous functions, rather than only locally constant or finite-image functions,
are used in continuousCoefficientRingObj.
Source: direct-image proof (3), displayed isomorphism
(blueprint: lem-sfb-root-tower-coordinate-face). -/
def Assertion (F : Type u) [NormedField F] : Prop :=
  ∀ (N : Modules (Profinite.continuousCoefficientRingObj F)
      (Spec (.of (tameRootAlgebra p t)))),
    IsLisseCoefficientModule (Profinite.continuousCoefficientRingObj F) N →
    ∀ (J : Finset (Fin r)) (P : Profinite.{u}),
      IsIso ((beta p t (Profinite.continuousCoefficientRingObj F) J P).app
        (testModuleComplex (Profinite.continuousCoefficientRingObj F) N P))

/-- Coordinate-face base change on the full unpunctured tower for both coefficient fields.
The comparison is beta, so the preceding adjunct and pasting identities specify the
arrow and all its compatibilities, as equalities on the parametrized terms.
Source: blueprint main-20261015, direct-image proof (3), extracted one-term input
(blueprint: lem-sfb-root-tower-coordinate-face).

Proof: (1) The quotient presentation identifies the face with the quotient of the
cartesian fibre by its nil roots; fibreInclusion_properties gives the surjective closed
immersion, including every profinite test P.
(2) Cover every object of the face site by w-contractible affine ind-etale tests W.
The closed-site lift A_W is henselian along the face and w-contractible by the
henselian closed-fibre criterion. Evaluation at W and A_W is exact and detects
quasi-isomorphisms of sheaves, since these tests cover every site object.
(3) The two tower algebras over these tests are filtered colimits of finite finitely
presented algebras: monic root equations give a finite monomial spanning set, and
finite quotients of P give finite products. The ind-finite algebra lemma makes their
spectra w-strictly local, and their closed points lie over closed points of A_W.
(4) These closed points kill all selected parameters and hence all their roots. The
face contains every closed point, so it induces a homeomorphism on component spaces.
(5) Pullback preserves finite-free local trivializations. The w-strict lisse component
cohomology lemma therefore identifies the actual restriction of derived sections.
It works for every commutative condensed ring, including the incomplete normed Omega.
(6) Use K-injectives and derived localization to identify evaluation of beta with this
restriction. The transpose is e^* of the q-counit, as exchange_adjuncts specifies.
Exactness and detection on the covering tests prove invertibility in D(Mod).
(7) Exchange followed by the closed restriction has the same transpose. The nil-root
immersion is surjective closed, so its pullback is an equivalence. The other adjunct
is Rq_* of the closed unit, with lowerComp as its normalized identification.
(8) Successive coordinate substitutions compose. The two pasting identities therefore
give equality for nested faces and for restrictions to opens. Derived localization on
pro-etale base changes identifies the relevant section complexes and their counits.
(9) Naturality of the mate gives module-map compatibility. Apply pasting to maps of
profinite tests and face-preserving tower automorphisms, including the supplied action
maps. Apply it on P times Q to obtain equality on the Q-parametrized terms themselves.
For J empty the identity quotient and the triangle identity give the identity. For J
all coordinates there are no remaining root variables. Empty schemes, empty P, rank
zero and r = 0 are included; no puncture or partition occurs. -/
theorem coordinateFace
    (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hpℓ : p ≠ ℓ)
    (k : Type u) [Field k] [CharP k p]
    (E : Type u) [NormedField E] [NormedAlgebra ℚ_[ℓ] E] [FiniteDimensional ℚ_[ℓ] E]
    (Ω : Type u) [NormedField Ω] [NormedAlgebra E Ω] [IsAlgClosure E Ω]
    (Y : Scheme.{u}) (y : Y ⟶ Spec (.of k)) [LocallyOfFiniteType y] [QuasiCompact y]
    [IsSeparated y] (hY : IsRegularScheme Y)
    (A : Type u) [CommRing A] (b : Spec (.of A) ⟶ Y) [Etale b]
    (r : ℕ) (s : Fin r → A) (H : (Spec (.of A)).IdealSheafData)
    (hH : IsStrictNormalCrossingsBoundary H)
    (hproduct : H = Scheme.IdealSheafData.ofIdealTop
      (Ideal.span {(Scheme.ΓSpecIso (CommRingCat.of A)).inv (∏ i, s i)}))
    (hbranches : Set.range (fun i : Fin r ↦ PrimeSpectrum.zeroLocus ({s i} : Set A)) =
      Set.image (Set.image Subtype.val) (irreducibleComponents (H.support : Set (Spec (.of A)))))
    (R : Type u) [CommRing R]
    (a : A →+* R) [WeaklyEtale (Spec.map (CommRingCat.ofHom a))] :
    Assertion p (fun i ↦ a (s i)) E ∧ Assertion p (fun i ↦ a (s i)) Ω := by
  sorry

end AlgebraicGeometry.ProEtale.RootCoordinateFace
