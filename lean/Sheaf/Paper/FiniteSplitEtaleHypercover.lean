import Mathlib.AlgebraicGeometry.Sites.Etale
import Mathlib.AlgebraicTopology.SimplicialObject.Split
import Mathlib.AlgebraicTopology.SimplicialObject.Homotopy
import Mathlib.AlgebraicTopology.AlternatingFaceMapComplex
import Mathlib.Algebra.Category.Grp.Abelian
import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex

/-!
# Finite split étale hypercovers

Source: blueprint `def-weil-pbc-finite-split-hypercover`, order 946;
Stacks Project, Hypercoverings, example `example-hypercovering-in-C`, and
Simplicial Methods, definitions `definition-split` and `definition-homotopy`.
(blueprint: def-weil-pbc-finite-split-hypercover)

The matching universal property is tested on all schemes over the base, not just étale
ones. Mathlib's splitting uses the canonical degeneracy maps in its coproduct cofan.
-/

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- A split étale hypercover, finite in each degree, over a qcqs scheme.
Source: blueprint definition of finite split étale hypercovers, order 946;
Stacks Hypercoverings `example-hypercovering-in-C`, Simplicial Methods `definition-split`.
The matching projections run over all lower simplices. The universal property is exactly
that of the finite matching diagram (including degenerate lower simplices does not change
its limit). In degree zero it is the terminal object over `X`; in degree one it is the
product of the two vertices over `X`. All structure maps are over `X`, including the
augmentation and simplicial identities. No choices of matching maps are unconstrained.
(blueprint: def-weil-pbc-finite-split-hypercover) -/
structure FiniteSplitEtaleHypercover (X : Scheme.{u})
    [CompactSpace X] [QuasiSeparatedSpace X] where
  simplicial : SimplicialObject X.Etale
  splitting : simplicial.Splitting
  matching : ℕ → X.Etale
  projection : ∀ (n : ℕ) (Δ : SimplexCategory), Δ.len < n →
    (Δ ⟶ SimplexCategory.mk n) → (matching n ⟶ simplicial.obj (op Δ))
  projection_naturality : ∀ (n : ℕ) (Δ Δ' : SimplexCategory)
    (h : Δ.len < n) (h' : Δ'.len < n) (α : Δ' ⟶ Δ)
    (θ : Δ ⟶ SimplexCategory.mk n),
    projection n Δ h θ ≫ simplicial.map α.op = projection n Δ' h' (α ≫ θ)
  matching_universal : ∀ (n : ℕ) (T : Over X)
    (p : ∀ (Δ : SimplexCategory), Δ.len < n → (Δ ⟶ SimplexCategory.mk n) →
      (T ⟶ (Scheme.Etale.forget X).obj (simplicial.obj (op Δ)))),
    (∀ (Δ Δ' : SimplexCategory) (h : Δ.len < n) (h' : Δ'.len < n)
      (α : Δ' ⟶ Δ) (θ : Δ ⟶ SimplexCategory.mk n),
      p Δ h θ ≫ (Scheme.Etale.forget X).map (simplicial.map α.op) =
        p Δ' h' (α ≫ θ)) →
    ∃! f : T ⟶ (Scheme.Etale.forget X).obj (matching n),
      ∀ (Δ : SimplexCategory) (h : Δ.len < n) (θ : Δ ⟶ SimplexCategory.mk n),
        f ≫ (Scheme.Etale.forget X).map (projection n Δ h θ) = p Δ h θ
  matchingMap : ∀ n, simplicial.obj (op (SimplexCategory.mk n)) ⟶ matching n
  matchingMap_projection : ∀ (n : ℕ) (Δ : SimplexCategory) (h : Δ.len < n)
    (θ : Δ ⟶ SimplexCategory.mk n),
    matchingMap n ≫ projection n Δ h θ = simplicial.map θ.op
  matching_cover : ∀ n, Surjective (matchingMap n).left
  finite_each_degree : ∀ n, ∃ (k : ℕ) (V : Fin k → X.Etale)
    (ι : ∀ i, V i ⟶ splitting.N n),
    Nonempty (IsColimit (Cofan.mk (splitting.N n) ι)) ∧
      ∀ i, CompactSpace (V i).left ∧ QuasiSeparatedSpace (V i).left ∧
        LocallyOfFinitePresentation (V i).hom ∧ QuasiCompact (V i).hom ∧
          QuasiSeparated (V i).hom

namespace FiniteSplitEtaleHypercover

variable {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]

/-- Refinements are morphisms of augmented simplicial schemes over the base; no
compatibility with a chosen splitting is imposed.
Source: blueprint order 946 (blueprint: def-weil-pbc-finite-split-hypercover). -/
abbrev Refinement (U V : FiniteSplitEtaleHypercover X) := U.simplicial ⟶ V.simplicial

/-- Identification of refinements by simplicial homotopy. The equivalence relation
is generated by elementary homotopies, which themselves need not be symmetric/transitive.
Source: Stacks Simplicial Methods `definition-homotopy`; blueprint order 946.
(blueprint: def-weil-pbc-finite-split-hypercover) -/
def isRefinementHomotopic {U V : FiniteSplitEtaleHypercover X}
    (f g : U.Refinement V) : Prop :=
  Relation.EqvGen (fun a b : U.Refinement V ↦ Nonempty (SimplicialObject.Homotopy a b)) f g

/-- Refinements modulo simplicial homotopy.
Source: blueprint order 946; Stacks Simplicial Methods `definition-homotopy`.
(blueprint: def-weil-pbc-finite-split-hypercover) -/
def RefinementClasses (U V : FiniteSplitEtaleHypercover X) :=
  Quot (fun a b : U.Refinement V ↦ Nonempty (SimplicialObject.Homotopy a b))

/-- All the data of a hypercover through degree `r`, as restrictions of the given data.
The functor retains all faces, degeneracies and augmentations between retained degrees.
The remaining components retain nondegenerate summands, their canonical coproduct cofans
and colimit witnesses, finite-presentation witnesses, matching objects, matching arrows,
projections, and their universal properties and compatibility identities.
Source: blueprint order 946 (blueprint: def-weil-pbc-finite-split-hypercover). -/
def truncation (U : FiniteSplitEtaleHypercover X) (r : ℕ) :=
  ((SimplicialObject.truncation r).obj U.simplicial,
    fun n : Fin (r + 1) ↦
      (U.splitting.N n.val, U.splitting.cofan (op (SimplexCategory.mk n.val)),
        U.splitting.isColimit' (op (SimplexCategory.mk n.val)),
        PLift.up (U.finite_each_degree n.val),
        U.matching n.val, U.matchingMap n.val, U.projection n.val,
        PLift.up (U.projection_naturality n.val), PLift.up (U.matching_universal n.val),
        PLift.up (U.matchingMap_projection n.val), PLift.up (U.matching_cover n.val)))

/-- The cosimplicial abelian group of sections: its degree `n` is exactly `F(U_n)`.
Source: blueprint order 946, displayed formula for `C^n(U,F)`.
(blueprint: def-weil-pbc-finite-split-hypercover) -/
def sectionCosimplicial (U : FiniteSplitEtaleHypercover X)
    (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{v}) : CosimplicialObject AddCommGrpCat.{v} :=
  U.simplicial.rightOp ⋙ F.obj

/-- The cochain complex with differential `∑ i, (-1)^i d_i^*`.
Mathlib's alternating coface complex supplies the differential and its square-zero law.
Source: blueprint order 946, final displayed formula; Stacks Cohomology on Sites 03AL.
(blueprint: def-weil-pbc-finite-split-hypercover) -/
noncomputable def complex (U : FiniteSplitEtaleHypercover X)
    (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{v}) : CochainComplex AddCommGrpCat.{v} ℕ :=
  (AlgebraicTopology.alternatingCofaceMapComplex AddCommGrpCat.{v}).obj
    (U.sectionCosimplicial F)

/-- Cohomology of the alternating-face complex. The short complex at `q` uses the
incoming differential (if `q > 0`) and the outgoing one to degree `q+1`, so degrees
through `q+1` are retained when computing it, including for `q = 0`.
Source: blueprint order 946, last sentence (blueprint: def-weil-pbc-finite-split-hypercover). -/
noncomputable def cohomology (U : FiniteSplitEtaleHypercover X)
    (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{v}) (q : ℕ) : AddCommGrpCat.{v} :=
  (U.complex F).homology q

end FiniteSplitEtaleHypercover
end AlgebraicGeometry
