module

public import Mathlib.Algebra.Module.Presentation.Basic
public import Mathlib.GroupTheory.Congruence.Hom
public import Mathlib.Algebra.Group.Prod
import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup

/-! # Integral monoid pushouts with a group

Source: ILO, Exposé VIII 3.1.2, printed p.98, for integral-monoid localization
conventions; the mixed pushout statement and its proof are the agent-formulated
refinement (blueprint: lem-sfb-integral-monoid-unit-pushout).

The group completion is the integer-module presentation recorded by
`def-trf-abelian-group-presentation`, with relations `[1] = 0` and
`[pq] - [p] - [q] = 0`. The quotient monoid uses precisely the generated
congruence in the node, without assuming the equality criterion in its definition.
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace Algebra

/-- The relations specifying the group completion of a commutative monoid.
`none` indexes `[1] = 0`; `some (p,q)` indexes `[pq] - [p] - [q] = 0`.
This specializes `Module.Relations` from `def-trf-abelian-group-presentation`.
Source: ILO VIII 3.1.2 conventions and the node's explicit presentation
(blueprint: lem-sfb-integral-monoid-unit-pushout). -/
noncomputable def monoidCompletionRelations (P : Type u) [CommMonoid P] :
    Module.Relations ℤ where
  G := P
  R := Option (P × P)
  relation r := by
    classical
    exact match r with
      | none => Finsupp.single 1 1
      | some (p, q) => Finsupp.single (p * q) 1 - Finsupp.single p 1 - Finsupp.single q 1

/-- The canonical generator map into the specified group-completion presentation,
written multiplicatively. Its value at `p` is the coset of the basis vector `e_p`.
Source: the presentation in the node, using `Module.Relations.toQuotient`
(blueprint: lem-sfb-integral-monoid-unit-pushout). -/
noncomputable def monoidCompletionGenerator (P : Type u) [CommMonoid P] (p : P) :
    Multiplicative (monoidCompletionRelations P).Quotient := by
  classical
  exact Multiplicative.ofAdd
    ((monoidCompletionRelations P).toQuotient (Finsupp.single p 1))

/-- The monoid congruence generated by `(pe,g) ~ (p,f(e)g)`.
Source: the agent-formulated mixed pushout construction following ILO VIII 3.1.2
(blueprint: lem-sfb-integral-monoid-unit-pushout). -/
def unitAmalgamationCon {P : Type u} [CommMonoid P] {G : Type v} [CommGroup G]
    (E : Submonoid P) (f : E →* G) : Con (P × G) :=
  conGen (fun x y => ∃ (p : P) (e : E) (g : G),
    x = (p * e.1, g) ∧ y = (p, f e * g))

/-- The mixed pushout `P ⊕_E G` as the actual congruence quotient of `P × G`.
Source: the agent-formulated construction following ILO VIII 3.1.2
(blueprint: lem-sfb-integral-monoid-unit-pushout). -/
abbrev UnitAmalgamation {P : Type u} [CommMonoid P] {G : Type v} [CommGroup G]
    (E : Submonoid P) (f : E →* G) := (unitAmalgamationCon E f).Quotient

/-- The canonical homomorphism `G → P ⊕_E G`, sending `g` to `[1,g]`.
Multiplication by this image is the action `h · [p,g] = [p,hg]`.
Source: the agent-formulated mixed pushout following ILO VIII 3.1.2
(blueprint: lem-sfb-integral-monoid-unit-pushout). -/
def unitAmalgamationGroupMap {P : Type u} [CommMonoid P] {G : Type v} [CommGroup G]
    (E : Submonoid P) (f : E →* G) : G →* UnitAmalgamation E f :=
  (unitAmalgamationCon E f).mk'.comp
    { toFun := fun g => (1, g)
      map_one' := rfl
      map_mul' := fun _ _ => Prod.ext (one_mul 1).symm rfl }

private theorem completionGenerator_mul {P : Type u} [CommMonoid P] (p q : P) :
    monoidCompletionGenerator P (p * q) =
      monoidCompletionGenerator P p * monoidCompletionGenerator P q := by
  classical
  have h := (monoidCompletionRelations P).toQuotient_relation (some (p, q))
  change (monoidCompletionRelations P).toQuotient (Finsupp.single (p * q) 1) =
    (monoidCompletionRelations P).toQuotient (Finsupp.single p 1) +
      (monoidCompletionRelations P).toQuotient (Finsupp.single q 1)
  change (monoidCompletionRelations P).toQuotient
    (Finsupp.single (p * q) 1 - Finsupp.single p 1 - Finsupp.single q 1) = 0 at h
  simpa only [map_sub, map_add, sub_sub, sub_eq_zero] using h

private theorem completionGenerator_separates {P : Type u} [CommMonoid P]
    {K : Type v} [CommGroup K] (a : P →* K) {p q : P}
    (h : monoidCompletionGenerator P p = monoidCompletionGenerator P q) : a p = a q := by
  classical
  let sol : (monoidCompletionRelations P).Solution (Additive K) :=
    { var := fun p ↦ Additive.ofMul (a p)
      linearCombination_var_relation := by
        rintro (_ | ⟨x, y⟩)
        · simp [monoidCompletionRelations]
        · simp [monoidCompletionRelations, map_mul, ofMul_mul, sub_sub] }
  have h' := congrArg sol.fromQuotient (congrArg Multiplicative.toAdd h)
  change sol.fromQuotient
      ((monoidCompletionRelations P).toQuotient (Finsupp.single p 1)) =
    sol.fromQuotient ((monoidCompletionRelations P).toQuotient (Finsupp.single q 1)) at h'
  simpa only [Module.Relations.Solution.fromQuotient_toQuotient,
    Module.Relations.Solution.π_single, sol, toMul_ofMul] using congrArg Additive.toMul h'

private theorem completionGenerator_injective {P : Type u} [CommMonoid P] [IsCancelMul P] :
    Function.Injective (monoidCompletionGenerator P) := by
  intro p q h
  apply GrothendieckGroup.of_injective
  exact completionGenerator_separates GrothendieckGroup.of h

private theorem cancel_of_completion {P : Type u} [CommMonoid P]
    (hP : Function.Injective (monoidCompletionGenerator P)) : IsCancelMul P := by
  have hl : ∀ a b c : P, a * b = a * c → b = c := by
    intro a b c h
    apply hP
    apply mul_left_cancel (a := monoidCompletionGenerator P a)
    simpa only [← completionGenerator_mul] using congrArg (monoidCompletionGenerator P) h
  exact
    { mul_left_cancel := hl
      mul_right_cancel := fun a b c h ↦ hl a b c (by simpa only [mul_comm] using h) }

-- The fraction criterion itself is a congruence, even before assuming cancellation.
private def fractionCon {P : Type u} [CommMonoid P] {G : Type v} [CommGroup G]
    (E : Submonoid P) (f : E →* G) : Con (P × G) where
  r x y := ∃ e e' : E, x.1 * e'.1 = y.1 * e.1 ∧ x.2 * f e = y.2 * f e'
  iseqv :=
    { refl := fun x ↦ ⟨1, 1, by simp, by simp⟩
      symm := by
        rintro x y ⟨e, e', hp, hg⟩
        exact ⟨e', e, hp.symm, hg.symm⟩
      trans := by
        rintro x y z ⟨e, e', hp, hg⟩ ⟨d, d', hq, hh⟩
        refine ⟨e * d, e' * d', ?_, ?_⟩
        · change x.1 * (e'.1 * d'.1) = z.1 * (e.1 * d.1)
          calc
            x.1 * (e'.1 * d'.1) = (x.1 * e'.1) * d'.1 := by ac_rfl
            _ = (y.1 * e.1) * d'.1 := by rw [hp]
            _ = (y.1 * d'.1) * e.1 := by ac_rfl
            _ = (z.1 * d.1) * e.1 := by rw [hq]
            _ = z.1 * (e.1 * d.1) := by ac_rfl
        · simp only [map_mul]
          calc
            x.2 * (f e * f d) = (x.2 * f e) * f d := by ac_rfl
            _ = (y.2 * f e') * f d := by rw [hg]
            _ = (y.2 * f d) * f e' := by ac_rfl
            _ = (z.2 * f d') * f e' := by rw [hh]
            _ = z.2 * (f e' * f d') := by ac_rfl }
  mul' := by
    rintro x y z w ⟨e, e', hp, hg⟩ ⟨d, d', hq, hh⟩
    refine ⟨e * d, e' * d', ?_, ?_⟩
    · change (x.1 * z.1) * (e'.1 * d'.1) = (y.1 * w.1) * (e.1 * d.1)
      calc
        (x.1 * z.1) * (e'.1 * d'.1) = (x.1 * e'.1) * (z.1 * d'.1) := by ac_rfl
        _ = (y.1 * e.1) * (w.1 * d.1) := by rw [hp, hq]
        _ = (y.1 * w.1) * (e.1 * d.1) := by ac_rfl
    · change (x.2 * z.2) * f (e * d) = (y.2 * w.2) * f (e' * d')
      simp only [map_mul]
      calc
        (x.2 * z.2) * (f e * f d) = (x.2 * f e) * (z.2 * f d) := by ac_rfl
        _ = (y.2 * f e') * (w.2 * f d') := by rw [hg, hh]
        _ = (y.2 * w.2) * (f e' * f d') := by ac_rfl

private theorem amalgamation_slide {P : Type u} [CommMonoid P]
    {G : Type v} [CommGroup G] (E : Submonoid P) (f : E →* G)
    (p : P) (e : E) (g : G) :
    (unitAmalgamationCon E f).mk' (p * e.1, g) =
      (unitAmalgamationCon E f).mk' (p, f e * g) := by
  apply (unitAmalgamationCon E f).eq.mpr
  exact ConGen.Rel.of _ _ ⟨p, e, g, rfl, rfl⟩

private theorem amalgamation_eq_iff {P : Type u} [CommMonoid P]
    {G : Type v} [CommGroup G] (E : Submonoid P) (f : E →* G)
    (p p' : P) (g g' : G) :
    (unitAmalgamationCon E f).mk' (p, g) =
      (unitAmalgamationCon E f).mk' (p', g') ↔
    ∃ e e' : E, p * e'.1 = p' * e.1 ∧ g * f e = g' * f e' := by
  constructor
  · intro h
    have hle : unitAmalgamationCon E f ≤ fractionCon E f := by
      apply Con.conGen_le.mpr
      rintro x y ⟨q, e, k, rfl, rfl⟩
      exact ⟨e, 1, by simp, by simp [mul_comm]⟩
    exact hle ((unitAmalgamationCon E f).eq.mp h)
  · rintro ⟨e, e', hp, hg⟩
    have hg' : (f e')⁻¹ * g = (f e)⁻¹ * g' := by
      apply mul_right_cancel (b := f e' * f e)
      calc
        (f e')⁻¹ * g * (f e' * f e) = g * f e := by simp [mul_assoc, mul_left_comm, mul_comm]
        _ = g' * f e' := hg
        _ = (f e)⁻¹ * g' * (f e' * f e) := by simp [mul_assoc, mul_left_comm, mul_comm]
    calc
      (unitAmalgamationCon E f).mk' (p, g) =
          (unitAmalgamationCon E f).mk' (p * e'.1, (f e')⁻¹ * g) := by
        simpa only [mul_inv_cancel_left] using
          (amalgamation_slide E f p e' ((f e')⁻¹ * g)).symm
      _ = (unitAmalgamationCon E f).mk' (p' * e.1, (f e)⁻¹ * g') := by rw [hp, hg']
      _ = (unitAmalgamationCon E f).mk' (p', g') := by
        simpa only [mul_inv_cancel_left] using
          amalgamation_slide E f p' e ((f e)⁻¹ * g')

private theorem amalgamation_cancel {P : Type u} [CommMonoid P] [IsCancelMul P]
    {G : Type v} [CommGroup G] (E : Submonoid P) (f : E →* G) :
    IsCancelMul (UnitAmalgamation E f) := by
  have hl : ∀ a b c : UnitAmalgamation E f, a * b = a * c → b = c := by
    intro a b c
    obtain ⟨⟨r, k⟩, rfl⟩ := (unitAmalgamationCon E f).mk'_surjective a
    obtain ⟨⟨p, g⟩, rfl⟩ := (unitAmalgamationCon E f).mk'_surjective b
    obtain ⟨⟨q, h⟩, rfl⟩ := (unitAmalgamationCon E f).mk'_surjective c
    intro heq
    change (unitAmalgamationCon E f).mk' (r * p, k * g) =
      (unitAmalgamationCon E f).mk' (r * q, k * h) at heq
    obtain ⟨e, e', hp, hg⟩ := (amalgamation_eq_iff E f _ _ _ _).mp heq
    apply (amalgamation_eq_iff E f _ _ _ _).mpr
    refine ⟨e, e', ?_, ?_⟩
    · exact mul_left_cancel (a := r) (by simpa only [mul_assoc] using hp)
    · exact mul_left_cancel (a := k) (by simpa only [mul_assoc] using hg)
  exact
    { mul_left_cancel := hl
      mul_right_cancel := fun a b c h ↦ hl a b c (by simpa only [mul_comm] using h) }

/-- The mixed pushout of an integral commutative monoid with an abelian group
is integral and cancellative, its group map is injective, its group action is
free, and equality is given by the displayed two-denominator criterion.
Source: agent-formulated lemma, with localization conventions from ILO,
Exposé VIII 3.1.2, printed p.98
(blueprint: lem-sfb-integral-monoid-unit-pushout).

Proof plan (the seven elementary steps of the node):
1. The presentation `def-trf-abelian-group-presentation` specialized above has
   the group-completion universal property: a monoid map to an abelian group
   sends each relation to the identity, and the generators ensure uniqueness.
2. Inside `P^gp`, fractions `[e][e']⁻¹` form a subgroup `L`. Equality of two
   fractions gives `ed' = de'` by integrality. Thus `f(e)f(e')⁻¹` is well
   defined on `L`, multiplicative, and extends `f` uniquely. This identifies
   `L` with `E^gp`. Form the abelian group
   `H = (P^gp × G)/{(z,f^gp(z)⁻¹) : z ∈ E^gp}`.
3. The map `(p,g) ↦ [([p],g)]` kills the defining congruence, so it descends
   to a homomorphism `j : P ⊕_E G → H`.
4. Equality of images under `j` says their ratio is `(z,f^gp(z)⁻¹)`. Write
   `z = [e][e']⁻¹`; integrality in the first coordinate gives `pe' = p'e`,
   and the second coordinate gives `g f(e) = g' f(e')`.
5. Conversely these two equations give the identical representatives
   `[pe',f(e')⁻¹g]` and `[p'e,f(e)⁻¹g']` by the generating relations.
   Hence the criterion holds and `j` is injective.
6. At `p = p' = 1` the criterion gives `e = e'` and then `g = g'`.
   If multiplication by `[1,h]` fixes `[p,g]`, the criterion gives
   `pe' = pe`; integrality cancels `p`, then cancellation in `G` gives `h = 1`.
7. By step 1, `j` factors through the group completion of the pushout.
   Since `j` is injective, its canonical completion map is injective too.
   Cancellation follows by applying `j` and cancelling in the group `H`.
-/
theorem integralMonoidUnitPushout (P : Type u) [CommMonoid P]
    (hP : Function.Injective (monoidCompletionGenerator P))
    (E : Submonoid P) (G : Type v) [CommGroup G] (f : E →* G) :
    Function.Injective (monoidCompletionGenerator (UnitAmalgamation E f)) ∧
    IsCancelMul (UnitAmalgamation E f) ∧
    Function.Injective (unitAmalgamationGroupMap E f) ∧
    (∀ (h : G) (m : UnitAmalgamation E f),
      unitAmalgamationGroupMap E f h * m = m → h = 1) ∧
    (∀ (p p' : P) (g g' : G),
      (unitAmalgamationCon E f).mk' (p, g) =
        (unitAmalgamationCon E f).mk' (p', g') ↔
      ∃ e e' : E, p * e'.1 = p' * e.1 ∧ g * f e = g' * f e') := by
  let : IsCancelMul P := cancel_of_completion hP
  let : IsCancelMul (UnitAmalgamation E f) := amalgamation_cancel E f
  refine ⟨completionGenerator_injective, inferInstance, ?_, ?_, amalgamation_eq_iff E f⟩
  · intro g g' h
    change (unitAmalgamationCon E f).mk' (1, g) =
      (unitAmalgamationCon E f).mk' (1, g') at h
    obtain ⟨e, e', hp, hg⟩ := (amalgamation_eq_iff E f _ _ _ _).mp h
    have he : e' = e := Subtype.ext (by simpa only [one_mul] using hp)
    rw [he] at hg
    exact mul_right_cancel hg
  · intro h m hfix
    obtain ⟨⟨p, g⟩, rfl⟩ := (unitAmalgamationCon E f).mk'_surjective m
    change (unitAmalgamationCon E f).mk' (1 * p, h * g) =
      (unitAmalgamationCon E f).mk' (p, g) at hfix
    rw [one_mul] at hfix
    obtain ⟨e, e', hp, hg⟩ := (amalgamation_eq_iff E f _ _ _ _).mp hfix
    have he : e' = e := Subtype.ext (mul_left_cancel hp)
    rw [he] at hg
    apply mul_right_cancel (b := g * f e)
    simpa only [mul_assoc, one_mul] using hg

end Algebra
