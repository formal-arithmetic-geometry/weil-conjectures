module

public import Mathlib.GroupTheory.Coxeter.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Order.ConditionallyCompleteLattice.Basic
public import Mathlib.Data.Finite.Defs

/-!
# Alternating normal forms and shortest words for two involutions

Source: the elementary cancellation proof in the DAG node; comparison with Cashen,
Notes on Coxeter groups, Chapter 2 §1, printed pages 27–29.
(blueprint: lem-sfb-two-involution-alternating-metric)
-/

set_option autoImplicit false

@[expose] public section

universe u

namespace Subgroup

/-- The alternating word of length `k` beginning with `s`. Mathlib's alternating word
ends with its second argument, so reversing it fixes the initial letter instead.
Source: Cashen, Chapter 2 §1, rank-two examples; the node's notation `B_s(k)`.
(blueprint: lem-sfb-two-involution-alternating-metric) -/
def twoInvolutionWord {G : Type u} (s t : G) (k : ℕ) : List G :=
  (CoxeterSystem.alternatingWord t s k).reverse

/-- The least length of a word over `{s,t}` with product `g`. This definition is used
on the subgroup generated by `s,t`, where the set of lengths is nonempty. It uses
Mathlib's infimum on natural numbers, with no choice of a representing word.
Source: the binary word metric `d` in the node's statement.
(blueprint: lem-sfb-two-involution-alternating-metric) -/
noncomputable def twoInvolutionWordLength {G : Type u} [Group G] (s t g : G) : ℕ :=
  sInf {n : ℕ | ∃ w : List G, (∀ a ∈ w, a ∈ ({s, t} : Set G)) ∧
    w.prod = g ∧ w.length = n}

/-- All shortest words over `{s,t}` with product `g`, retaining the actual letters.
Source: shortest-word classification in the node's statement.
(blueprint: lem-sfb-two-involution-alternating-metric) -/
def twoInvolutionShortestWords {G : Type u} [Group G] (s t g : G) : Set (List G) :=
  {w | (∀ a ∈ w, a ∈ ({s, t} : Set G)) ∧ w.prod = g ∧
    w.length = twoInvolutionWordLength s t g}

/-- The displayed list `1, b_s(k), b_t(k) (1 ≤ k < m), b_s(m)` in increasing `k`.
Source: the exhaustive list in the node's statement.
(blueprint: lem-sfb-two-involution-alternating-metric) -/
def twoInvolutionNormalForms {G : Type u} [Group G] (s t : G) (m : ℕ) : List G :=
  [1] ++ ((List.range (m - 1)).flatMap fun j ↦
    [(twoInvolutionWord s t (j + 1)).prod, (twoInvolutionWord t s (j + 1)).prod]) ++
    [(twoInvolutionWord s t m).prod]

/-- Two distinct nonidentity involutions with finite product order have exactly the
listed normal forms, metric values and shortest words, without a presentation assumption.

Source: the node's seven-step elementary cancellation proof; comparison with Cashen,
Notes on Coxeter groups, Chapter 2 §1, printed pages 27–29.

Proof: (1) Put `r = st`. Minimality of its positive order gives `m ≥ 2` and
`r^a = r^b` exactly when `m` divides `a-b`, for integer exponents.
(2) The involution identities give `r⁻¹ = ts` and `srs = r⁻¹`. If `s` were a power
of `r`, commutativity would force `r² = 1`, hence `m = 2`; reducing that power modulo
2 would give `s = 1` or `t = 1`. Thus the rotation and reflection cosets are disjoint.
(3) Pairing letters gives products `r^a`, `r^(-a)`, `r^a s`, `r^(-(a+1)) s` for
lengths `2a, 2a, 2a+1, 2a+1` and starts `s,t,s,t`. For either parity of `m`,
the two length-`m` products agree.
(4) Opposite parities have different products by (2). For equal parities and the
same start, the exponent difference has absolute value `|k-l|/2 < m`; opposite
starts give `(k+l)/2`, positive and at most `m` unless both words are empty.
Thus among lengths at most `m` the only collisions are the identical words, the
two empty conventions, and the two length-`m` words.
(5) Delete equal adjacent letters. An alternating word longer than `m` can have its
first length-`m` block replaced by the opposite block, producing an equal boundary
pair which can be deleted. Each operation preserves product and shortens by two.
(6) Termination gives every element of the generated subgroup an alternating form
of length at most `m`; (4) proves that the displayed list has no repetitions.
(7) A representing word of least length exists by well-ordering. By (5) it alternates
and has length at most `m`. By (4) it is uniquely determined below length `m`,
while the longest element has exactly the two length-`m` words. The identity has
only the empty shortest word. These give every asserted length and word set.
(blueprint: lem-sfb-two-involution-alternating-metric) -/
theorem two_involution_alternating_metric
    {G : Type u} [Group G] (s t : G) (hs : s ≠ 1) (ht : t ≠ 1) (hst : s ≠ t)
    (hs2 : s ^ 2 = 1) (ht2 : t ^ 2 = 1)
    (m : ℕ) (hm : 0 < m) (horder : orderOf (s * t) = m) :
    2 ≤ m ∧
    (twoInvolutionWord s t m).prod = (twoInvolutionWord t s m).prod ∧
    (twoInvolutionNormalForms s t m).Nodup ∧
    (∀ g : G, g ∈ closure ({s, t} : Set G) ↔ g ∈ twoInvolutionNormalForms s t m) ∧
    twoInvolutionWordLength s t 1 = 0 ∧
    twoInvolutionShortestWords s t 1 = {[]} ∧
    (∀ k : ℕ, 1 ≤ k → k < m →
      twoInvolutionWordLength s t (twoInvolutionWord s t k).prod = k ∧
      twoInvolutionWordLength s t (twoInvolutionWord t s k).prod = k ∧
      twoInvolutionShortestWords s t (twoInvolutionWord s t k).prod =
        {twoInvolutionWord s t k} ∧
      twoInvolutionShortestWords s t (twoInvolutionWord t s k).prod =
        {twoInvolutionWord t s k}) ∧
    twoInvolutionWordLength s t (twoInvolutionWord s t m).prod = m ∧
    twoInvolutionShortestWords s t (twoInvolutionWord s t m).prod =
      {twoInvolutionWord s t m, twoInvolutionWord t s m} := by
  sorry

end Subgroup
