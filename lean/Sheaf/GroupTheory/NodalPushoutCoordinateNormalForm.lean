module

public import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
public import Mathlib.GroupTheory.Congruence.Hom

/-!
# Coordinates of the nodal commutative monoid pushout

Source: ILO, Exposé VI, Proposition 1.9, printed p. 71, the cocartesian monoid square.
The explicit algebraic calculation is supplied in the DAG proof.
(blueprint: lem-trf-nodal-pushout-coordinate-normal-form).

The quotient is defined by its generating relation, independently of the coordinate theorem.
Group completions are Mathlib's `Algebra.GrothendieckAddGroup`, the additive version of the
completion used by `AlgebraicGeometry.IsFineSaturatedMonoid` in the dependency module.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Algebra

/-- The congruence generated by `u + v = (1,a)`. Source: ILO VI Proposition 1.9,
printed p. 71 (blueprint: lem-trf-nodal-pushout-coordinate-normal-form). -/
def nodalPushoutCongruence {P : Type u} [AddCommMonoid P] (a : P) :
    AddCon ((ℕ × ℕ) × (ℤ × P)) :=
  addConGen (fun z w ↦ z = ((1, 1), (0, 0)) ∧ w = ((0, 0), (1, a)))

/-- The actual quotient monoid in the nodal cocartesian square. Source: ILO VI
Proposition 1.9, printed p. 71 (blueprint: lem-trf-nodal-pushout-coordinate-normal-form). -/
abbrev NodalPushout {P : Type u} [AddCommMonoid P] (a : P) :=
  (nodalPushoutCongruence a).Quotient

/-- The canonical map from `ℤ × P` to the quotient, with no injectivity assumption.
Source: ILO VI Proposition 1.9, printed p. 71
(blueprint: lem-trf-nodal-pushout-coordinate-normal-form). -/
def nodalPushoutBaseMap {P : Type u} [AddCommMonoid P] (a : P) :
    ℤ × P →+ NodalPushout a :=
  (nodalPushoutCongruence a).mk'.comp (AddMonoidHom.inr (ℕ × ℕ) (ℤ × P))

/-- Reduced representatives, image, and group-completion coordinates of the nodal pushout.
Source: ILO VI Proposition 1.9, printed p. 71, expanded by the explicit DAG calculation
(blueprint: lem-trf-nodal-pushout-coordinate-normal-form).

Proof plan (the seven steps of the node):
1. On the product monoid, the additive formula `(x-y,n+y,[p]+y[a])` respects the
   generating relation; its kernel congruence contains the generated congruence, so it
   descends to `h`.
2. Applying the relation once decreases both positive natural coordinates by one and
   adds `(1,a)` to the base coordinates. Induction on `min x y` gives the displayed
   reduction and a representative with minimum zero.
3. For a reduced representative, `x-y=m` forces `x=m₊` and `y=m₋`. Equality of images
   then forces equality of `n` and of `[p]`; the hypothesis on group completion forces
   equality of `p`. This proves uniqueness and injectivity.
4. Solving the three coordinate equations gives `n=t-m₋` and `[p]=b-m₋[a]`.
   Conversely these equations produce a reduced representative of every allowed triple.
5. By the group-completion universal property from def-trf-fs-log-blowup, the map
   `[(n,p)] ↦ (n,[p])` extends to an isomorphism `r`; its inverse sends `(n,b)` to
   `n[(1,0)]` plus the extension of `p ↦ [(0,p)]` at `b`.
6. Extend `h` using that same universal property. The proposed inverse sends `(m,t,b)`
   to `m u + t e + gᵍᵖ(0,b)`. Evaluating its forward composite gives `(m,t,b)`.
7. The reverse composite fixes `u`, `e`, and every `g(0,p)`, and fixes `v` by
   `u+v=e+g(0,a)`. These generate the group completion, so the composite is the identity.
No finite generation, saturation, sharpness, or torsion-freeness is used. -/
theorem nodalPushout_coordinate_normal_form {P : Type u} [AddCommMonoid P]
    (a : P) (hP : Function.Injective (GrothendieckAddGroup.of (M := P))) :
    ∃ h : NodalPushout a →+ ℤ × ℤ × GrothendieckAddGroup P,
      (∀ (x y : ℕ) (n : ℤ) (p : P),
        h ((nodalPushoutCongruence a).mk' ((x, y), (n, p))) =
          ((x : ℤ) - (y : ℤ), n + (y : ℤ),
            GrothendieckAddGroup.of p + y • GrothendieckAddGroup.of a)) ∧
      Function.Injective h ∧
      (∀ q : NodalPushout a, ∃! z : (ℕ × ℕ) × (ℤ × P),
        min z.1.1 z.1.2 = 0 ∧ (nodalPushoutCongruence a).mk' z = q) ∧
      (∀ (x y : ℕ) (n : ℤ) (p : P),
        (nodalPushoutCongruence a).mk' ((x, y), (n, p)) =
          (nodalPushoutCongruence a).mk'
            ((x - min x y, y - min x y), (n + (min x y : ℕ), p + min x y • a))) ∧
      (∀ (m t : ℤ) (b : GrothendieckAddGroup P),
        (m, t, b) ∈ Set.range h ↔
          b - max (-m) 0 • GrothendieckAddGroup.of a ∈
            Set.range (GrothendieckAddGroup.of (M := P))) ∧
      (∀ (m t : ℤ) (b : GrothendieckAddGroup P) (p : P),
        GrothendieckAddGroup.of p = b - max (-m) 0 • GrothendieckAddGroup.of a →
          min (Int.toNat (max m 0)) (Int.toNat (max (-m) 0)) = 0 ∧
          h ((nodalPushoutCongruence a).mk'
            ((Int.toNat (max m 0), Int.toNat (max (-m) 0)), (t - max (-m) 0, p))) =
              (m, t, b)) ∧
      ∃ (r : GrothendieckAddGroup (ℤ × P) ≃+ ℤ × GrothendieckAddGroup P)
        (E : GrothendieckAddGroup (NodalPushout a) ≃+ ℤ × ℤ × GrothendieckAddGroup P),
        (∀ (n : ℤ) (p : P), r (GrothendieckAddGroup.of (n, p)) =
          (n, GrothendieckAddGroup.of p)) ∧
        E.toAddMonoidHom = GrothendieckAddGroup.lift h ∧
        (∀ (m t : ℤ) (b : GrothendieckAddGroup P), E.symm (m, t, b) =
          m • GrothendieckAddGroup.of
            ((nodalPushoutCongruence a).mk' ((1, 0), (0, 0))) +
          t • GrothendieckAddGroup.of (nodalPushoutBaseMap a (1, 0)) +
          GrothendieckAddGroup.lift
            (GrothendieckAddGroup.of.comp (nodalPushoutBaseMap a)) (r.symm (0, b))) ∧
        E (GrothendieckAddGroup.of
          ((nodalPushoutCongruence a).mk' ((1, 0), (0, 0)))) = (1, 0, 0) ∧
        E (GrothendieckAddGroup.of
          ((nodalPushoutCongruence a).mk' ((0, 1), (0, 0)))) =
            (-1, 1, GrothendieckAddGroup.of a) ∧
        (∀ (n : ℤ) (b : GrothendieckAddGroup P),
          E (GrothendieckAddGroup.lift
            (GrothendieckAddGroup.of.comp (nodalPushoutBaseMap a)) (r.symm (n, b))) =
              (0, n, b)) := by
  sorry

end Algebra
