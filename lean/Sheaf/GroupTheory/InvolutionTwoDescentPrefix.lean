module

public import Mathlib.GroupTheory.Coxeter.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Order.Bounds.Basic
public import Mathlib.Data.Finite.Defs

/-!
# Two left descents give a reduced alternating prefix

Source: Bourbaki, *Lie Groups and Lie Algebras*, Chapters 4--6, IV §1.5, Theorem 1,
rank-two auxiliary to deletion-to-presentation; the agent-written deletion/minimal-coset
argument in the DAG. Compare Cashen, *Notes on Coxeter groups* (2023), Chapter 4 §4,
Lemma 4.0.14(2), printed pages 120--121.
(blueprint: lem-sfb-involution-two-descent-prefix)
-/

set_option autoImplicit false

@[expose] public section

universe u v

namespace Group

/-- Under two-letter deletion, two distinct left descents have the common longest
rank-two alternating prefix. Word products are `(A.map t).prod`. The condition `hlength`
specifies the minimum word length, including existence of a representing word for each
`g`; it does not assume a presentation. Reducedness is equality with this minimum.
Mathlib's `alternatingWord a b m` ends in `b`, so its reversal begins in `b`.
Positions in `hdeletion` are zero-based; removing the larger position first removes exactly
those two positions in the original word.

Source: Bourbaki IV §1.5, Theorem 1, rank-two auxiliary; agent-written supporting argument
in the DAG, compared with Cashen Chapter 4, Lemma 4.0.14(2), pages 120--121.
(blueprint: lem-sfb-involution-two-descent-prefix)

Proof:
1. Set `J = {i,j}` and let `H` be the subgroup generated by these two generators.
   Choose an element `h` of minimum ambient length in `H * g`; write `g = u * h` with
   `u ∈ H`. Apply `lem-sfb-deletion-parabolic-coset-length`: the restricted word length
   equals ambient length on `H`, and `length (x * h) = length_J x + length h` for all
   `x ∈ H`. Its deletion and generator hypotheses are exactly the present hypotheses.
2. Apply this equality to `u`, `t i * u`, and `t j * u`. Subtract in the integers and
   cancel `length h`. The two assumed descents give two descents of `u` for `length_J`.
3. Apply `lem-sfb-two-involution-alternating-metric` to `t i` and `t j`, which are
   distinct nonidentity involutions whose product has order `m`. Its binary metric is
   `length_J`. Its exhaustive classification consists of the identity, alternating
   products of length `k` with `1 ≤ k < m`, and the common longest product of length `m`.
   The identity has no descent. For an alternating product of length `k < m`, prepending
   the opposite initial letter gives a shortest alternating word of length `k+1 ≤ m`,
   contradicting one of the two descents. Thus `u` is the common longest product.
4. Substitute this in `g = u * h` and in length additivity. For every reduced word `C`
   for `h`, both concatenations have product `g` and length `m + length h = length g`.
   Hence both are reduced words for `g`. -/
theorem exists_alternating_prefix_of_two_left_descents_of_deletion
    {G : Type u} [Group G] {I : Type v} [Finite I]
    (t : I → G) (ht : Function.Injective t)
    (hne : ∀ i : I, t i ≠ 1) (hinvol : ∀ i : I, t i ^ 2 = 1)
    (hgen : Subgroup.closure (Set.range t) = ⊤)
    (ℓ : G → ℕ)
    (hlength : ∀ g : G, IsLeast
      {n : ℕ | ∃ A : List I, (A.map t).prod = g ∧ A.length = n} (ℓ g))
    (hdeletion : ∀ A : List I, A.length ≠ ℓ (A.map t).prod →
      ∃ a b : ℕ, a < b ∧ b < A.length ∧
        (((A.eraseIdx b).eraseIdx a).map t).prod = (A.map t).prod)
    (i j : I) (hij : i ≠ j) (m : ℕ) (hm : 0 < m)
    (horder : orderOf (t i * t j) = m)
    (g : G)
    (hi : (ℓ (t i * g) : ℤ) = (ℓ g : ℤ) - 1)
    (hj : (ℓ (t j * g) : ℤ) = (ℓ g : ℤ) - 1) :
    ∃ h : G,
      g = (((CoxeterSystem.alternatingWord j i m).reverse).map t).prod * h ∧
      g = (((CoxeterSystem.alternatingWord i j m).reverse).map t).prod * h ∧
      ℓ g = m + ℓ h ∧
      ∀ C : List I, (C.map t).prod = h → C.length = ℓ h →
        ((((CoxeterSystem.alternatingWord j i m).reverse) ++ C).map t).prod = g ∧
        (((CoxeterSystem.alternatingWord j i m).reverse) ++ C).length = ℓ g ∧
        ((((CoxeterSystem.alternatingWord i j m).reverse) ++ C).map t).prod = g ∧
        (((CoxeterSystem.alternatingWord i j m).reverse) ++ C).length = ℓ g := by
  sorry

end Group
