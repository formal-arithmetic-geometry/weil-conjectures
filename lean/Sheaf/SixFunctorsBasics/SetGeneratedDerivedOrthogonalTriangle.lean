module

public import WeilConjectures.CategoryTheory.GrothendieckAbelian.HasDerivedCategory
public import Mathlib.CategoryTheory.Triangulated.Pretriangulated
public import Mathlib.CategoryTheory.Triangulated.Triangulated
public import Mathlib.CategoryTheory.Triangulated.Subcategory
public import Sheaf.CategoryTheory.GrothendieckDerivedCoproductsColimit
public import Sheaf.CategoryTheory.CountableCoproductsIdempotentComplete
public import Sheaf.CategoryTheory.SetGeneratedDerivedSolutionSet
public import Sheaf.CategoryTheory.CohomologicalSolutionSetRepresentability

/-! # Orthogonal localization triangle for a small family in a Grothendieck derived category

Source: Hall--Neeman--Rydh, Appendix A, Lemma A.1 and Remark A.2
(arXiv:1405.1888) (blueprint: lem-sfb-set-generated-derived-orthogonal-triangle).
-/

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

namespace CategoryTheory

/-- A small family in a Grothendieck derived category has an orthogonal localization triangle.

Source: Hall--Neeman--Rydh, Appendix A, Lemma A.1 and Remark A.2
(arXiv:1405.1888) (blueprint: lem-sfb-set-generated-derived-orthogonal-triangle).

Proof: Let `P` be the replete property generated by the family and let `Q` satisfy the
containment, repleteness, triangulation, coproduct closure, and minimality clauses in the
statement. The K-injective existence, local-smallness, derived-coproduct, and
countable-coproduct/idempotent-completeness inputs give the corresponding size and
triangulated hypotheses on `Q`. For a fixed `Y`, restrict `Hom(-, Y)` to `Q`.
Hom exactness for distinguished triangles and the coproduct universal property make this
a cohomological functor preserving coproducts as products. The set-generated solution-set
theorem supplies a small weakly universal family, and the cohomological solution-set
representability theorem gives `X ∈ Q` and a map `ε : X ⟶ Y` inducing bijections on
all `Hom(W, -)` for `W ∈ Q`. Complete `ε` to a distinguished triangle by TR1. Applying
Hom exactness to this triangle and using the shifted bijection shows every map
`W ⟶ Z` is zero, for each `W ∈ Q`, which is the required orthogonality.
-/
theorem setGeneratedDerived_existsOrthogonalTriangle
    (A : Type u) [Category.{v} A] [Abelian A]
    [IsGrothendieckAbelian.{v} A] [HasDerivedCategory.{v} A]
    (I : Type v) (P : I → DerivedCategory A)
    (Q : ObjectProperty (DerivedCategory A))
    [Q.IsClosedUnderIsomorphisms] [Q.IsTriangulated]
    [∀ J : Type v, Q.IsClosedUnderColimitsOfShape (Discrete J)]
    (hP : ∀ i : I, Q (P i))
    (hminimal : ∀ R : ObjectProperty (DerivedCategory A),
      (∀ i : I, R (P i)) →
      R.IsClosedUnderIsomorphisms → R.IsTriangulated →
      (∀ J : Type v, R.IsClosedUnderColimitsOfShape (Discrete J)) → Q ≤ R)
    (Y : DerivedCategory A) :
    ∃ (X Z : DerivedCategory A) (f : X ⟶ Y) (g : Y ⟶ Z)
      (h : Z ⟶ X⟦(1 : ℤ)⟧),
      Triangle.mk f g h ∈ distTriang (DerivedCategory A) ∧
        Q X ∧ ∀ (W : DerivedCategory A), Q W → ∀ a : W ⟶ Z, a = 0 := by
  sorry

end CategoryTheory
