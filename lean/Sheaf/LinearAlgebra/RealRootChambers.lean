module

public import Mathlib.Topology.Instances.Real.Lemmas
public import Mathlib.LinearAlgebra.Reflection
public import Mathlib.LinearAlgebra.BilinearForm.Properties
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import Mathlib.Topology.Algebra.Module.ModuleTopology
public import Mathlib.Topology.Connected.Basic
public import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# Bases and chambers for a real reflection set

Source: Milne, *Algebraic Groups*, Appendix C.8--C.10, pp.609--610,
and C.19--C.22, pp.611--612 (blueprint: def-sfb-real-root-chambers).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace RootPairing

variable {V : Type u} [AddCommGroup V] [Module ℝ V]

/-- The formula `x - 2 * B x a / B a a • a`, using Mathlib's pre-reflection.
It is used only at nonzero roots of a positive definite form in the chamber theorem.
Source: Milne C.8, p.609 (blueprint: def-sfb-real-root-chambers). -/
noncomputable def realRootPreReflection (B : LinearMap.BilinForm ℝ V) (a : V) :
    V →ₗ[ℝ] V :=
  Module.preReflection a ((2 * (B a a)⁻¹) • B.flip a)

/-- The subgroup of real linear automorphisms generated by the prescribed reflections.
The generators are specified by their actual maps, rather than by a choice of lifts.
Source: Milne C.8, C.10 and C.15 (blueprint: def-sfb-real-root-chambers). -/
def realRootReflectionGroup (B : LinearMap.BilinForm ℝ V) (R : Set V) :
    Subgroup (V ≃ₗ[ℝ] V) :=
  Subgroup.closure {s | ∃ a ∈ R, ∀ x, s x = realRootPreReflection B a x}

/-- A base is a subset of the roots that is a real basis, with every root an integral
combination of one sign. Additive-monoid closure is exactly the nonnegative integer span.
Source: Milne C.9 and C.21, pp.609,612 (blueprint: def-sfb-real-root-chambers). -/
def IsRealRootBase (R D : Set V) : Prop :=
  D ⊆ R ∧ LinearIndepOn ℝ (fun x : V ↦ x) D ∧ Submodule.span ℝ D = ⊤ ∧
    ∀ a ∈ R, a ∈ AddSubmonoid.closure D ∨ -a ∈ AddSubmonoid.closure D

/-- The positive roots for a base, as roots in its nonnegative integer span.
Source: Milne C.9 and C.21, pp.609,612 (blueprint: def-sfb-real-root-chambers). -/
def realPositiveRoots (R D : Set V) : Set V :=
  R ∩ (AddSubmonoid.closure D : Set V)

/-- The open cone cut out by strict positivity against the simple roots.
Source: Milne C.9 and C.20--C.22 (blueprint: def-sfb-real-root-chambers). -/
def realRootCone (B : LinearMap.BilinForm ℝ V) (D : Set V) : Set V :=
  {x | ∀ a ∈ D, 0 < B x a}

/-- A chamber is a connected component of the complement of all root hyperplanes.
The topology is the canonical real module topology, which in finite dimension is the
usual Euclidean topology. The witness belongs to the complement, excluding empty components.
Source: Milne C.9 and C.20--C.22 (blueprint: def-sfb-real-root-chambers). -/
def IsRealRootChamber (B : LinearMap.BilinForm ℝ V) (R C : Set V) : Prop :=
  ∃ x : V, (∀ a ∈ R, B x a ≠ 0) ∧
    @connectedComponentIn V (moduleTopology ℝ V) {y | ∀ a ∈ R, B y a ≠ 0} x = C

end RootPairing
