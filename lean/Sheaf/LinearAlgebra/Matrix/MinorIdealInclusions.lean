module

public import Sheaf.LinearAlgebra.Matrix.MinorIdeal
import Mathlib.LinearAlgebra.Matrix.Adjugate
import WeilConjectures.LinearAlgebra.Matrix.CauchyBinet

/-!
# General inclusions for ideals generated by matrix minors

Source: Stacks Project, More on Algebra, Lemma 07Z7
(blueprint: lem-trf-fitting-ideal-minor-inclusions).
-/

@[expose] public section

universe u

namespace Matrix

/-- The ideals generated by minors are nested, stable under adjoining columns,
and stable under right multiplication by a square matrix.
Source: Stacks Project, More on Algebra, Lemma 07Z7, parts (1)--(3)
(blueprint: lem-trf-fitting-ideal-minor-inclusions).

Proof: reduce ideal inclusions to their determinant generators.  For (1), take
the diagonal entry of `adj(Q) * Q = det Q • 1` and use the cofactor formula to
expand an `(r+1)`-minor along a column into `r`-minors.  For (2), induct on the
number of appended columns; a minor omitting the last column is handled by the
induction hypothesis and the nesting in (1), while a minor containing it is
expanded along that column.  For (3), identify each selected submatrix of
`A * C` with the product of the selected rows of `A` and selected columns of
`C`, then apply the Cauchy--Binet formula; every summand contains an `r`-minor
of `A`.  Empty indexing types, oversized minors, `r = 0`, and `d = 0` are
included by the definition of `minorIdeal`.
-/
theorem minorIdeal_inclusions {R : Type u} [CommRing R]
    (p n r d : ℕ) (A : Matrix (Fin p) (Fin n) R) :
    minorIdeal p n (r + 1) A ≤ minorIdeal p n r A ∧
      (∀ (B : Matrix (Fin p) (Fin (n + d)) R),
        (∀ (i : Fin p) (j : Fin n), B i (Fin.castAdd d j) = A i j) →
          minorIdeal p (n + d) (r + d) B ≤ minorIdeal p n r A) ∧
      (∀ (C : Matrix (Fin n) (Fin n) R),
        minorIdeal p n r (A * C) ≤ minorIdeal p n r A) := by
  sorry

end Matrix
