module

public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Data.Finset.Sort

/-!
# Ideals generated by matrix minors

Source: Stacks Project, More on Algebra, Lemma 07Z7
(blueprint: def-trf-minor-ideal).
-/

@[expose] public section

universe u

open Matrix

namespace Matrix

/-- The ideal generated by all `r` by `r` minors of a finite rectangular matrix.
Source: Stacks Project, More on Algebra, Lemma 07Z7
(blueprint: def-trf-minor-ideal).

For each pair of `r`-element row and column subsets, the increasing order
embeddings index the corresponding square submatrix.  In particular, when
`r = 0` the unique empty minor contributes `1`, and when `r` exceeds one of
the dimensions the indexing type is empty and the span is `⊥`.
-/
noncomputable def minorIdeal {R : Type u} [CommRing R] (p n r : ℕ)
    (A : Matrix (Fin p) (Fin n) R) : Ideal R :=
  Ideal.span (Set.range (fun ST :
      {S : Finset (Fin p) // S.card = r} ×
        {T : Finset (Fin n) // T.card = r} ↦
    (A.submatrix
      (ST.1.val.orderEmbOfFin ST.1.property)
      (ST.2.val.orderEmbOfFin ST.2.property)).det))

end Matrix
