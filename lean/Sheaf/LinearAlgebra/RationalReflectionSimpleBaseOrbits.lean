module

public import Mathlib.LinearAlgebra.FiniteDimensional.Basic
public import Mathlib.Data.List.OfFn
import Mathlib.LinearAlgebra.RootSystem.BaseExists

/-!
# Simple bases and simple-reflection orbits from rational reflection data

Source: Milne, *Algebraic Groups*, Appendix C.12--C.22, printed pp.610--612
(blueprint: lem-sfb-rational-reflection-simple-base-orbits).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace RootPairing

/-- A finite rational reflection set has a sign-coherent basis and is generated by its
simple reflections. Source: Milne, *Algebraic Groups*, Appendix C.12--C.22,
printed pp.610--612 (blueprint: lem-sfb-rational-reflection-simple-base-orbits).

Proof: (1) Each prescribed reflection is an involution. The generated rational linear
transformations act faithfully on the finite spanning set, so the resulting group is finite.
(2) Averaging a positive form over this finite group gives an invariant positive form and the
formula `c_r x = 2 B x r / B r r`. (3) This formula proves injectivity of the coroots,
without assuming equal root lengths. (4) Use `lem-sfb-spanning-reflections-root-pairing`
(`RootPairing.mk''` and `RootPairing.isRootSystem_mk''`), obtaining
a finite crystallographic root pairing and its root-system spanning property. Reducedness
follows from the root-line hypothesis. (5) Apply `lem-sfb-reduced-rational-root-pairing-base`
(`RootPairing.nonempty_base`); the base
coordinates are integral and have one sign. (6) Apply `lem-sfb-root-base-reflection-induction`
(`RootPairing.Base.induction_reflect`)
to the predicate that a root is a word in the simple reflections and a base root; the base,
reflection, and negation cases give every orbit assertion. The zero-dimensional case has
empty root set and empty base.
-/
theorem exists_simple_base_reflection_orbits
    (V : Type u) [AddCommGroup V] [Module ℚ V] [FiniteDimensional ℚ V]
    (S : Finset V) (hS0 : ∀ r ∈ S, r ≠ 0)
    (hSspan : Submodule.span ℚ (S : Set V) = ⊤)
    (c : S → V →ₗ[ℚ] ℚ)
    (hc2 : ∀ r : S, c r r = 2)
    (hcint : ∀ r x : S, ∃ z : ℤ, c r x = z)
    (hcreflect : ∀ r : S,
      Set.BijOn (fun x : V ↦ x - c r x • (r : V)) (S : Set V) (S : Set V))
    (hSline : ∀ r : S,
      (S : Set V) ∩ {x : V | ∃ q : ℚ, q • (r : V) = x} = {(r : V), -(r : V)}) :
    ∃ (D : Finset V) (b : Module.Basis (↥(D : Set V)) ℚ V),
      D ⊆ S ∧
      (∀ i : ↥(D : Set V), b i = i.1) ∧
      (∀ r ∈ S,
        ∃ z : (↥(D : Set V)) → ℤ,
          (∀ i, (z i : ℚ) = (b.coord i) r) ∧
          ((∀ i, 0 ≤ z i) ∨ (∀ i, z i ≤ 0))) ∧
      (∀ r ∈ S,
        ∃ (k : ℕ) (ds : Fin k → S) (d : V),
          d ∈ D ∧ (∀ j, (ds j : V) ∈ D) ∧
          r = (List.ofFn ds).foldr
            (fun a x ↦ x - c a x • (a : V)) d) ∧
      ((∀ x : V, x = 0) → S = ∅ ∧ D = ∅) := by
  sorry

end RootPairing
