module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Finset.Sort
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import WeilConjectures.Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace
import Mathlib.LinearAlgebra.Matrix.Adjugate
import WeilConjectures.AlgebraicGeometry.RelativeProj.Functoriality

/-! # Homogeneous determinant locus and its normalized charts

Source: Stacks, constructions.tex, Tags 089T, 01N0, 01M4, and the explicit homogeneous
presentation completing the normalized quotient charts of 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts).

The positive rank is written `r + 1`. All constructions are explicit; the grading and
coordinate identities are postponed theorems. Ordered coordinates use a finite sum of
permutation-matrix determinants, which is exactly the sorting-sign convention, including
zero for repeated indices.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.PluckerDeterminantLocus

/-- Increasing subsets of cardinality `r + 1` of the `N` column indices.
Source: normalized chart indices, Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
abbrev Index (N r : ℕ) := {I : Finset (Fin N) // I.card = r + 1}

/-- The polynomial ring on the homogeneous minor coordinates.
Source: homogeneous determinant presentation completing Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
abbrev PolynomialRing (N r : ℕ) := MvPolynomial (Index N r) ℤ

/-- The increasing enumeration of a minor's columns.
Source: ordered pivot convention in Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
def columns {N r : ℕ} (I : Index N r) : Fin (r + 1) ↪o Fin N :=
  I.val.orderEmbOfFin I.property

/-- The sorting-sign coordinate of an ordered tuple. The coefficient of `p_I` is the
 determinant of its incidence matrix: zero unless the tuple enumerates `I`, and then
 the sign of that enumeration. Thus repeated indices give zero.
Source: ordered-coordinate convention of the homogeneous completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def orderedCoordinate {N r : ℕ} (t : Fin (r + 1) → Fin N) :
    PolynomialRing N r :=
  ∑ I : Index N r,
    MvPolynomial.C (Matrix.det (fun a b : Fin (r + 1) ↦
      if columns I a = t b then (1 : ℤ) else 0)) * MvPolynomial.X I

/-- The matrix `C_{I,K}` of single-column replacement coordinates.
Source: homogeneous determinant completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def replacementMatrix {N r : ℕ} (I K : Index N r) :
    Matrix (Fin (r + 1)) (Fin (r + 1)) (PolynomialRing N r) :=
  fun a b ↦ orderedCoordinate (Function.update (columns I) a (columns K b))

/-- The relation `p_I^r p_K - det C_{I,K}`, for rank `r + 1`.
Source: homogeneous determinant completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def relation {N r : ℕ} (I K : Index N r) : PolynomialRing N r :=
  MvPolynomial.X I ^ r * MvPolynomial.X K - (replacementMatrix I K).det

/-- The ideal generated by all the determinant relations, with no saturation or radical.
Source: homogeneous determinant completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def relationsIdeal (N r : ℕ) : Ideal (PolynomialRing N r) :=
  Ideal.span (Set.range (fun p : Index N r × Index N r ↦ relation p.1 p.2))

/-- The actual quotient ring by the displayed determinant ideal.
Source: homogeneous determinant completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
abbrev CoordinateRing (N r : ℕ) := PolynomialRing N r ⧸ relationsIdeal N r

/-- Its degree-`d` component is exactly the image of the degree-`d` polynomial submodule.
Source: quotient-grading construction, proof step 1 of the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def quotientGrade (N r d : ℕ) : Submodule ℤ (CoordinateRing N r) :=
  (MvPolynomial.homogeneousSubmodule (Index N r) ℤ d).map
    (Ideal.Quotient.mkₐ ℤ (relationsIdeal N r)).toLinearMap

/-- The polynomial grading is Mathlib's total-degree grading.
Source: the degree-one coordinate convention in the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable instance polynomialGradedRing (N r : ℕ) :
    GradedRing (MvPolynomial.homogeneousSubmodule (Index N r) ℤ) :=
  MvPolynomial.gradedAlgebra

/-- The prescribed images of homogeneous components form a grading on the quotient.
Source: homogeneous determinant completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts).
Proof (step 1): every relation has degree `r+1`. Its generated ideal is homogeneous:
project a sum of multiples of relations to degree `d` by projecting each coefficient to
degree `d-(r+1)`, with negative degrees zero. Consequently the displayed image components
form a direct sum, and multiplication respects degrees. This determines the grading on
these fixed submodules; it does not choose an unspecified quotient ring or components. -/
theorem quotientGrade_exists (N r : ℕ) : Nonempty (GradedRing (quotientGrade N r)) := sorry

/-- The quotient grading on the fixed image submodules.
Source: quotient grading of the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable instance quotientGradedRing (N r : ℕ) : GradedRing (quotientGrade N r) :=
  Classical.choice (quotientGrade_exists N r)

/-- The degree-preserving quotient homomorphism, with its actual quotient-map data.
Source: quotient grading of the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def quotientMap (N r : ℕ) :
    MvPolynomial.homogeneousSubmodule (Index N r) ℤ →+*ᵍ quotientGrade N r where
  toRingHom := Ideal.Quotient.mk (relationsIdeal N r)
  map_mem hx := ⟨_, hx, rfl⟩

/-- All displayed coordinates in the quotient have degree one.
Source: quotient grading of the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts).
Proof (step 1): `X I` is homogeneous of degree one; take its image in the defining
image submodule of the quotient. -/
theorem coordinate_mem {N r : ℕ} (I : Index N r) :
    Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I) ∈ quotientGrade N r 1 := sorry

/-- Ordered coordinates, including the zero coordinate, have degree one in the quotient.
Source: ordered coordinates and quotient grading of the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts).
Proof (step 1): each summand is an integer multiple of a degree-one coordinate, so its
image and their finite sum belong to the degree-one submodule. -/
theorem orderedCoordinate_mem {N r : ℕ} (t : Fin (r + 1) → Fin N) :
    Ideal.Quotient.mk (relationsIdeal N r) (orderedCoordinate t) ∈
      quotientGrade N r (1 • (1 : ℕ)) := sorry

/-- The irrelevant-ideal condition for the canonical Proj map of the quotient.
Source: Stacks 01N0 and step 3 of the completion of 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts).
Proof (steps 1,3): lift each positive-degree homogeneous quotient element to a polynomial
of that degree. Every positive-degree monomial has a variable factor, so the quotient
irrelevant ideal is generated by the images of the variables, hence is contained in the
image of the polynomial irrelevant ideal. -/
theorem irrelevant_le_map (N r : ℕ) :
    HomogeneousIdeal.irrelevant (quotientGrade N r) ≤
      (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Index N r) ℤ)).map (quotientMap N r) := sorry

/-- The canonical morphism to the polynomial Proj induced by the graded quotient.
Source: Stacks 01N0
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def immersion (N r : ℕ) :
    Proj (quotientGrade N r) ⟶
      Proj (MvPolynomial.homogeneousSubmodule (Index N r) ℤ) :=
  Proj.map (quotientMap N r) (irrelevant_le_map N r)

/-- The fraction associated to an ordered tuple on the pivot chart, with denominator `p_I`.
Source: normalized coordinates of Stacks 089T, fraction convention of 01M4
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def fraction {N r : ℕ} (I : Index N r) (t : Fin (r + 1) → Fin N) :
    HomogeneousLocalization.Away (quotientGrade N r)
      (Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I)) :=
  HomogeneousLocalization.Away.mk (quotientGrade N r) (coordinate_mem I) 1
    (Ideal.Quotient.mk (relationsIdeal N r) (orderedCoordinate t)) (orderedCoordinate_mem t)

/-- The `r+1` by `N` matrix whose entries are the single-replacement fractions.
Source: normalized matrix of the completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def normalizedMatrix {N r : ℕ} (I : Index N r) :
    Matrix (Fin (r + 1)) (Fin N)
      (HomogeneousLocalization.Away (quotientGrade N r)
        (Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I))) :=
  fun (a : Fin (r + 1)) (j : Fin N) ↦
    fraction I (Function.update (columns I) a j)

/-- The off-pivot polynomial variables, one per row and nonpivot column.
Source: polynomial chart coordinates in Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
abbrev ChartIndex {N r : ℕ} (I : Index N r) := Fin (r + 1) × {j : Fin N // j ∉ I.val}

/-- The universal matrix with identity pivot columns and independent off-pivot entries.
Source: inverse chart-map construction completing Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def universalMatrix {N r : ℕ} (I : Index N r) :
    Matrix (Fin (r + 1)) (Fin N) (MvPolynomial (ChartIndex I) ℤ) :=
  fun a j ↦ if h : j ∈ I.val then
    if columns I a = j then 1 else 0
  else MvPolynomial.X (a, ⟨j, h⟩)

/-- The polynomial-to-chart map with the exact specified coordinate functions.
Source: forward chart-map construction completing Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts). -/
noncomputable def chartMap {N r : ℕ} (I : Index N r) :
    MvPolynomial (ChartIndex I) ℤ →+*
      HomogeneousLocalization.Away (quotientGrade N r)
        (Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I)) :=
  MvPolynomial.eval₂Hom (Int.castRingHom _)
    (fun aj ↦ normalizedMatrix I aj.1 aj.2.val)

/-- All determinant relations are homogeneous and vanish under evaluation by maximal minors.
Source: homogeneous determinant completion of Stacks 089T
(blueprint: lem-sfb-plucker-determinant-locus-charts).
Proof (steps 1,2): the Leibniz products in the replacement determinant each have degree
`r+1`, as does `p_I^r p_K`. Under minor evaluation its entries are column-replacement
determinants. By lem-sfb-matrix-cramer-determinant-identities the evaluated matrix is
`adj(M_I) M_K`, whose determinant is `det(M_I)^r det(M_K)`. This involves no division or
cancellation and holds over every commutative ring, including rings with zero divisors. -/
theorem relations_homogeneous_and_evaluate_zero (N r : ℕ) (h : r + 1 < N)
    (R : Type u) [CommRing R] (M : Matrix (Fin (r + 1)) (Fin N) R) :
    (∀ I K : Index N r, (relation I K).IsHomogeneous (r + 1)) ∧
      ∀ I K : Index N r,
        MvPolynomial.eval₂Hom (Int.castRingHom R)
          (fun J : Index N r ↦ (M.submatrix id (columns J)).det) (relation I K) = 0 := sorry

/-- The quotient Proj has the canonical closed embedding and the stated normalized charts.
Source: Stacks 089T, 01N0, 01M4, and the explicit determinant-chart completion
(blueprint: lem-sfb-plucker-determinant-locus-charts).
Proof (steps 3--7): the surjective graded quotient gives the closed immersion (01N0).
The images of the variables generate the irrelevant ideal, so their basic opens cover
and are the spectra of the displayed homogeneous localizations (01M4). In each chart,
lift a homogeneous numerator to a homogeneous polynomial; expansion shows the fractions
`p_J/p_I` generate the degree-zero ring. The relation `F_{I,J}=0` gives the identity
`det M_J=p_J/p_I` by expanding determinants of fractions. Evaluate the coordinates at
minors of the universal identity-pivot matrix. Step 2 kills the relations, so evaluation
descends to the quotient and then to its localization, since `p_I` evaluates to one.
It restricts to the inverse of chartMap: the single-replacement minors are exactly the
variables, and every coordinate ratio maps back to itself by the minor identity.
Polynomial uniqueness and generation give the two inverse laws, with the displayed
inverse on every ratio. The standard-open isomorphism then identifies the chart with
Spec of the off-pivot polynomial ring, that is affine `(r+1)(N-r-1)`-space with precisely
these coordinates; counting the off-pivot variables gives the displayed dimension.
The ambient polynomial Proj is the integral projective space with
homogeneous coordinates indexed by Index. -/
theorem closedImmersion_and_charts (N r : ℕ) (h : r + 1 < N) :
    IsClosedImmersion (immersion N r) ∧
    (⨆ I : Index N r, Proj.basicOpen (quotientGrade N r)
      (Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I))) = ⊤ ∧
    Nonempty (Proj (MvPolynomial.homogeneousSubmodule (Index N r) ℤ) ≅
      ProjectiveSpace (Index N r) (Spec (.of ℤ))) ∧
    ∀ I : Index N r,
      (∀ a b : Fin (r + 1), normalizedMatrix I a (columns I b) = if a = b then 1 else 0) ∧
      Fintype.card (ChartIndex I) = (r + 1) * (N - (r + 1)) ∧
      ∃ e : MvPolynomial (ChartIndex I) ℤ ≃+*
        HomogeneousLocalization.Away (quotientGrade N r)
          (Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I)),
        e.toRingHom = chartMap I ∧
        (∀ J : Index N r,
          e.symm (fraction I (columns J)) =
            ((universalMatrix I).submatrix id (columns J)).det) ∧
        (∀ J : Index N r,
          (Matrix.submatrix (normalizedMatrix I) id (columns J)).det = fraction I (columns J)) ∧
        Nonempty ((Proj.basicOpen (quotientGrade N r)
          (Ideal.Quotient.mk (relationsIdeal N r) (MvPolynomial.X I))).toScheme ≅
            Spec (.of (MvPolynomial (ChartIndex I) ℤ))) := sorry

end AlgebraicGeometry.PluckerDeterminantLocus
