module

public import Sheaf.AlgebraicGeometry.AlgebraicSpaceMorphismProperties
public import Sheaf.TraceFormula.SpaceQCSeparatedEtaleLocal
public import Sheaf.AlgebraicGeometry.AlgebraicSpaceFibreProductsEtaleCovers
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import Sheaf.AlgebraicGeometry.AlgebraicSpaceFlatProperFpLocality
import Mathlib.AlgebraicGeometry.Noetherian

/-! # Finite-presentation closed envelopes of locally finite-type algebraic spaces

Source: Stacks Project, Limits of Spaces, Tag 0872,
lemma-finite-type-closed-in-finite-presentation
(blueprint: lem-sfb-space-finite-type-fp-envelope).

The base is the spectrum of the integers, lifted to the scheme universe. Both source and
target are qcqs. Quasi-compactness uses scheme atlases after affine scheme tests.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.AlgebraicSpace

/-- A locally finite-type map between qcqs algebraic spaces factors as a closed immersion
followed by a finitely presented morphism.
Source: Stacks Project, Limits of Spaces, Tag 0872
(blueprint: lem-sfb-space-finite-type-fp-envelope).

Proof, following the node's three steps:
1. Apply lem-sfb-space-absolute-noetherian-approximation to X, obtaining X = lim X_i
   with affine transitions and quasi-separated finite-type stages over the integers.
   The integers are Noetherian: a nonzero ideal is generated by its least positive element.
   Apply pqf-lem-lft-fp-locnoeth on etale scheme charts to see that X_i is locally of
   finite presentation over the integers. Its quasi-compactness and quasi-separatedness
   give finite presentation. Put Z_i = X_i times Y. Base-change stability from
   lem-sfb-space-flat-proper-fp-locality makes Z_i to Y finitely presented, and
   lem-sfb-space-qcqs-source-products makes Z_i qcqs.
2. The categorical fibre products of lem-trf-space-fibre-products-etale-covers identify
   lim Z_i over Y with X times Y: a cone is its fixed map to Y and a cone to X_i.
   Transitions are affine by base change. The graph (1_X,f) is monic because its first
   projection is the identity. By lem-sfb-space-eventual-monomorphism, with base Y and
   source X, the map u = (pi_i,f) : X to Z_i is monic for some i.
3. Since p_i u = f is locally of finite type, lem-sfb-space-lft-cancellation makes u
   locally of finite type. By lem-sfb-space-qcqs-lft-mono-quasiaffine it is quasi-affine.
   Apply lem-sfb-space-quasiaffine-fp-envelope to obtain j : X to W closed and
   v : W to Z_i finitely presented with j followed by v equal to u. Set h = v followed
   by p_i. The finite-presentation clause of lem-sfb-space-separated-fp-composition
   makes h finitely presented, and associativity gives j followed by h equal to f.
-/
theorem exists_finitePresentation_closed_envelope
    {X Y : AlgebraicSpace (Spec (.of (ULift.{u} ℤ)))} (f : X ⟶ Y)
    (hXqc : ∃ (U : Over (Spec (.of (ULift.{u} ℤ))))
      (a : yoneda.obj U ⟶ X.obj.obj),
      CompactSpace U.left ∧ IsEtale a ∧ IsSurjective a)
    (hXqs : IsQuasiCompactPresheafMap (prod.lift (𝟙 X.obj.obj) (𝟙 X.obj.obj)))
    (hYqc : ∃ (U : Over (Spec (.of (ULift.{u} ℤ))))
      (a : yoneda.obj U ⟶ Y.obj.obj),
      CompactSpace U.left ∧ IsEtale a ∧ IsSurjective a)
    (hYqs : IsQuasiCompactPresheafMap (prod.lift (𝟙 Y.obj.obj) (𝟙 Y.obj.obj)))
    (hlft : MapIsLocally (@LocallyOfFiniteType) f) :
    ∃ (W : AlgebraicSpace (Spec (.of (ULift.{u} ℤ)))) (j : X ⟶ W) (h : W ⟶ Y),
      IsRepresentableWith (fun _ _ p ↦ IsClosedImmersion p.left) j.hom.hom ∧
      IsQuasiCompactPresheafMap h.hom.hom ∧
      IsQuasiCompactPresheafMap (pullback.diagonal h.hom.hom) ∧
      MapIsLocallyOfFinitePresentation h ∧ j ≫ h = f := by
  sorry

end AlgebraicGeometry.AlgebraicSpace
