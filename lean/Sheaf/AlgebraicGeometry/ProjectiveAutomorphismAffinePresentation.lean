/-!
# Affine presentation of automorphisms of a finite projective module

Source: Stacks Project, Tag 022W, `example-general-linear-group`, and the explicit
split-summand extension in the DAG proof
(blueprint: lem-sfb-projective-automorphism-affine-presentation).

The helper definitions spell out the two generic matrices, the six families of
relations, their quotient, its identity ideal, and scalar-extended split maps.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite MonoidalCategory
open scoped TensorProduct

namespace AlgebraicGeometry
namespace ProjectiveAutomorphism

noncomputable section

variable {A : Type u} [CommRing A] {n : ℕ}

/-- The polynomial matrix U (false) or V (true), Stacks Tag 022W and its split-summand
extension (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def genericMatrix (A : Type u) [CommRing A] (n : ℕ) (b : Bool) :
    Matrix (Fin n) (Fin n) (MvPolynomial (Bool × Fin n × Fin n) A) :=
  fun i j ↦ MvPolynomial.X (b, i, j)

/-- The six relation matrices defining the split-summand presentation; Stacks Tag 022W,
DAG proof step 2 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def relations (e : Matrix (Fin n) (Fin n) A) :
    Fin 6 → Matrix (Fin n) (Fin n) (MvPolynomial (Bool × Fin n × Fin n) A)
  | 0 => e.map MvPolynomial.C * genericMatrix A n false - genericMatrix A n false
  | 1 => genericMatrix A n false * e.map MvPolynomial.C - genericMatrix A n false
  | 2 => e.map MvPolynomial.C * genericMatrix A n true - genericMatrix A n true
  | 3 => genericMatrix A n true * e.map MvPolynomial.C - genericMatrix A n true
  | 4 => genericMatrix A n false * genericMatrix A n true - e.map MvPolynomial.C
  | 5 => genericMatrix A n true * genericMatrix A n false - e.map MvPolynomial.C

/-- The ideal generated by every entry of the six relation matrices; Stacks Tag 022W,
DAG proof step 2 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def relationIdeal (e : Matrix (Fin n) (Fin n) A) :
    Ideal (MvPolynomial (Bool × Fin n × Fin n) A) :=
  Ideal.span (Set.range fun k : Fin 6 × Fin n × Fin n => relations e k.1 k.2.1 k.2.2)

/-- The actual quotient algebra D_e; Stacks Tag 022W, DAG proof step 2
(blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
abbrev coordinateAlgebra (e : Matrix (Fin n) (Fin n) A) :=
  MvPolynomial (Bool × Fin n × Fin n) A ⧸ relationIdeal e

/-- The residue class of a matrix coordinate; Stacks Tag 022W, DAG proof step 2
(blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def coordinate (e : Matrix (Fin n) (Fin n) A) (k : Bool × Fin n × Fin n) :
    coordinateAlgebra e :=
  Ideal.Quotient.mk (relationIdeal e) (MvPolynomial.X k)

/-- The proposed identity ideal, generated by U-e and V-e; Stacks Tag 022W,
DAG proof step 7 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def identityIdeal (e : Matrix (Fin n) (Fin n) A) : Ideal (coordinateAlgebra e) :=
  Ideal.span (Set.range fun k : Bool × Fin n × Fin n ↦
    coordinate e k - algebraMap A (coordinateAlgebra e) (e k.2.1 k.2.2))

/-- The affine scheme Spec D_e over Spec A; Stacks Tag 022W, DAG proof step 4
(blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def scheme (e : Matrix (Fin n) (Fin n) A) : Over (Spec (.of A)) :=
  (algSpec (.of A)).obj (op (CommAlgCat.of A (coordinateAlgebra e)))

/-- The projector ip of a supplied splitting; Stacks Tag 022W, split-summand extension,
DAG proof step 1 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def projector {P : Type u} [AddCommGroup P] [Module A P]
    (i : P →ₗ[A] (Fin n → A)) (p : (Fin n → A) →ₗ[A] P) :
    Matrix (Fin n) (Fin n) A :=
  fun j k ↦ i (p (Pi.single k 1)) j

/-- The scalar-extended inclusion, using B tensor A^n = B^n; Stacks Tag 022W,
DAG proof step 1 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def inclusion {P : Type u} [AddCommGroup P] [Module A P]
    (i : P →ₗ[A] (Fin n → A)) (B : Type u) [CommRing B] [Algebra A B] :
    B ⊗[A] P →ₗ[B] (Fin n → B) :=
  (TensorProduct.piScalarRight A B B (Fin n)).toLinearMap ∘ₗ i.baseChange B

/-- The scalar-extended projection B^n to B tensor P; Stacks Tag 022W,
DAG proof step 1 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def projection {P : Type u} [AddCommGroup P] [Module A P]
    (p : (Fin n → A) →ₗ[A] P) (B : Type u) [CommRing B] [Algebra A B] :
    (Fin n → B) →ₗ[B] B ⊗[A] P :=
  p.baseChange B ∘ₗ (TensorProduct.piScalarRight A B B (Fin n)).symm.toLinearMap

/-- The matrix of i_B a p_B, for either a or its inverse; Stacks Tag 022W,
DAG proof step 3 (blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def automorphismMatrix {P : Type u} [AddCommGroup P] [Module A P]
    (i : P →ₗ[A] (Fin n → A)) (p : (Fin n → A) →ₗ[A] P)
    {B : Type u} [CommRing B] [Algebra A B] (a : B ⊗[A] P ≃ₗ[B] B ⊗[A] P) :
    Matrix (Fin n) (Fin n) B :=
  fun j k ↦ inclusion i B (a (projection p B (Pi.single k 1))) j

/-- Affine finite presentation of the automorphism functor, with its prescribed
matrix coordinates and identity ideal. Source: Stacks Tag 022W and the split-summand
extension, DAG proof steps 1--7
(blueprint: lem-sfb-projective-automorphism-affine-presentation).

Proof: extend the splitting to every algebra, identifying B tensor A^n with B^n.
Evaluation on the polynomial ring factors through D_e exactly for the six matrix
relations. A pair U,V gives inverse maps p_B U i_B and p_B V i_B; conversely an
inverse pair of automorphisms gives U=i_B a p_B, V=i_B a^-1 p_B. These are inverse
constructions, natural in B. Spec and the affine tensor-product pullback formula
turn U -> U_1 U_2, V -> V_2 V_1 into multiplication, swapping the matrices into
inverse, and evaluation at e into the identity. The relations verify every group
law on the generators. There are 2n^2 variables and 6n^2 relations, hence finite
presentation. The affine morphism is quasi-compact and separated. Finally the
quotient by U-e,V-e is A, so that this finitely generated ideal is precisely the
kernel of identity evaluation and Spec of evaluation is a closed immersion. -/
theorem affine_presentation (A : Type u) [CommRing A]
    (P : Type u) [AddCommGroup P] [Module A P] (n : ℕ)
    (i : P →ₗ[A] (Fin n → A)) (p : (Fin n → A) →ₗ[A] P)
    (hpi : p.comp i = LinearMap.id) :
    ∃ (ε : coordinateAlgebra (projector i p) →ₐ[A] A)
      (g : GrpObj (scheme (projector i p)))
      (φ : ∀ (B : Type u) [CommRing B] [Algebra A B],
        ((algSpec (.of A)).obj (op (CommAlgCat.of A B)) ⟶ scheme (projector i p)) ≃
          (B ⊗[A] P ≃ₗ[B] B ⊗[A] P)),
      LocallyOfFinitePresentation (scheme (projector i p)).hom ∧
      QuasiCompact (scheme (projector i p)).hom ∧
      QuasiSeparated (scheme (projector i p)).hom ∧
      IsAffineHom (scheme (projector i p)).hom ∧
      IsClosedImmersion (Spec.map (CommRingCat.ofHom ε.toRingHom)) ∧
      (RingHom.ker ε.toRingHom).FG ∧
      RingHom.ker ε.toRingHom = identityIdeal (projector i p) ∧
      (∀ k, ε (coordinate (projector i p) k) = projector i p k.2.1 k.2.2) ∧
      g.one.left = Spec.map (CommRingCat.ofHom ε.toRingHom) ∧
      (∀ (B : Type u) [CommRing B] [Algebra A B]
        (f : coordinateAlgebra (projector i p) →ₐ[A] B) (b : Bool) (j k : Fin n),
        f (coordinate (projector i p) (b, j, k)) =
          automorphismMatrix i p
            (if b then (φ B ((algSpec (.of A)).map (CommAlgCat.ofHom f).op)).symm
            else φ B ((algSpec (.of A)).map (CommAlgCat.ofHom f).op)) j k) ∧
      (∀ (B : Type u) [CommRing B] [Algebra A B]
        (x y : (algSpec (.of A)).obj (op (CommAlgCat.of A B)) ⟶ scheme (projector i p)),
        φ B (CartesianMonoidalCategory.lift x y ≫ g.mul) = φ B x * φ B y) ∧
      (∀ (B C : Type u) [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]
        (f : B →ₐ[A] C)
        (x : (algSpec (.of A)).obj (op (CommAlgCat.of A B)) ⟶ scheme (projector i p))
        (z : B ⊗[A] P),
        (φ C ((algSpec (.of A)).map (CommAlgCat.ofHom f).op ≫ x))
            (TensorProduct.map f.toLinearMap LinearMap.id z) =
          TensorProduct.map f.toLinearMap LinearMap.id (φ B x z)) := by
  sorry

/-- A coefficient map fixes the named matrix variables and maps the coefficients by f.
This is the generator characterization in Stacks Tag 022W, DAG proof steps 8--9
(blueprint: lem-sfb-projective-automorphism-affine-presentation). -/
def IsCoefficientMap {B : Type u} [CommRing B] (f : A →+* B)
    (e : Matrix (Fin n) (Fin n) A) (e' : Matrix (Fin n) (Fin n) B)
    (γ : coordinateAlgebra e →+* coordinateAlgebra e') : Prop :=
  e' = e.map f ∧
  (∀ a : A, γ (algebraMap A (coordinateAlgebra e) a) =
    algebraMap B (coordinateAlgebra e') (f a)) ∧
  ∀ k : Bool × Fin n × Fin n, γ (coordinate e k) = coordinate e' k

/-- Canonical arbitrary base change of the displayed presentation, including the
identity sections and represented automorphisms. Source: Stacks Tag 022W,
DAG proof step 8 (blueprint: lem-sfb-projective-automorphism-affine-presentation).

Proof: extend i,p and compute the projector entrywise. The coefficient map fixes
U,V and factors through the six relations. The tensor map sends t tensor b to
b times its image, and its inverse sends U,V to U tensor 1,V tensor 1. Both
composites fix the coefficients and every variable. The affine fibre-product
formula gives the indicated scheme isomorphism. Identity evaluation sends U,V
to the respective projectors, so commutes with the coefficient map. On points,
the canonical tensor cancellation sends c tensor (b tensor x) to cb tensor x.
The equality of matrix coordinates implies equality of the automorphisms after
this cancellation, by the inverse formula p_B U i_B from step 3. -/
theorem base_change (A : Type u) [CommRing A]
    (P : Type u) [AddCommGroup P] [Module A P] (n : ℕ)
    (i : P →ₗ[A] (Fin n → A)) (p : (Fin n → A) →ₗ[A] P)
    (hpi : p.comp i = LinearMap.id)
    (B : Type u) [CommRing B] [Algebra A B] :
    ∃ (γ : coordinateAlgebra (projector i p) →+*
        coordinateAlgebra (projector (inclusion i B) (projection p B)))
      (δ : coordinateAlgebra (projector i p) ⊗[A] B ≃+*
        coordinateAlgebra (projector (inclusion i B) (projection p B)))
      (s : pullback (scheme (projector i p)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap A B))) ≅
        (scheme (projector (inclusion i B) (projection p B))).left),
      IsCoefficientMap (algebraMap A B) (projector i p)
        (projector (inclusion i B) (projection p B)) γ ∧
      (∀ (t : coordinateAlgebra (projector i p)) (b : B),
        δ (t ⊗ₜ[A] b) =
          γ t * algebraMap B
            (coordinateAlgebra (projector (inclusion i B) (projection p B))) b) ∧
      s.hom = (pullbackSpecIso A (coordinateAlgebra (projector i p)) B).hom ≫
        Spec.map (CommRingCat.ofHom δ.symm.toRingHom) ∧
      s.inv ≫ pullback.snd (scheme (projector i p)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap A B))) =
        (scheme (projector (inclusion i B) (projection p B))).hom ∧
      (∀ (ε : coordinateAlgebra (projector i p) →ₐ[A] A)
        (ε' : coordinateAlgebra (projector (inclusion i B) (projection p B)) →ₐ[B] B),
        (∀ k, ε (coordinate (projector i p) k) = projector i p k.2.1 k.2.2) →
        (∀ k, ε' (coordinate (projector (inclusion i B) (projection p B)) k) =
          projector (inclusion i B) (projection p B) k.2.1 k.2.2) →
        ε'.toRingHom.comp γ = (algebraMap A B).comp ε.toRingHom) ∧
      (∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra B C] [IsScalarTower A B C]
        (a : C ⊗[A] P ≃ₗ[C] C ⊗[A] P)
        (a' : C ⊗[B] (B ⊗[A] P) ≃ₗ[C] C ⊗[B] (B ⊗[A] P)),
        automorphismMatrix i p a =
          automorphismMatrix (inclusion i B) (projection p B) a' →
        ∀ z : C ⊗[B] (B ⊗[A] P),
          TensorProduct.AlgebraTensorModule.cancelBaseChange A B C C P (a' z) =
            a (TensorProduct.AlgebraTensorModule.cancelBaseChange A B C C P z)) := by
  sorry

/-- Coefficient identifications commute with successive base changes, including
an identity base change. Source: Stacks Tag 022W, DAG proof step 9
(blueprint: lem-sfb-projective-automorphism-affine-presentation).

Proof: maps out of the polynomial quotient are determined by the coefficients
and the named variables. A composite sends coefficients along g composed with f
and fixes U,V, exactly as the direct map; for an identity base change this is
the identity. This proves coherence for the coordinate maps and hence,
contravariantly under Spec, for the displayed scheme isomorphisms. -/
theorem coefficient_coherence (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
    (n : ℕ) (e : Matrix (Fin n) (Fin n) A)
    (e' : Matrix (Fin n) (Fin n) B) (e'' : Matrix (Fin n) (Fin n) C)
    (f : A →+* B) (g : B →+* C)
    (α : coordinateAlgebra e →+* coordinateAlgebra e')
    (β : coordinateAlgebra e' →+* coordinateAlgebra e'')
    (γ : coordinateAlgebra e →+* coordinateAlgebra e'')
    (hα : IsCoefficientMap f e e' α) (hβ : IsCoefficientMap g e' e'' β)
    (hγ : IsCoefficientMap (g.comp f) e e'' γ) :
    β.comp α = γ ∧
      (∀ η : coordinateAlgebra e →+* coordinateAlgebra e,
        IsCoefficientMap (RingHom.id A) e e η → η = RingHom.id _) := by
  sorry

/-- The tensor identifications of represented automorphisms commute with successive
base changes. Source: Stacks Tag 022W, DAG proof step 9
(blueprint: lem-sfb-projective-automorphism-affine-presentation).

Proof: both composites send d tensor (c tensor (b tensor x)) to dcb tensor x;
pure tensors generate the iterated tensor product, so the linear maps agree.
No freeness, positive rank or nonzero-ring hypothesis is needed. -/
theorem tensor_coherence (A B C D : Type u)
    [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    [Algebra A B] [Algebra A C] [Algebra A D] [Algebra B C] [Algebra B D] [Algebra C D]
    [IsScalarTower A B C] [IsScalarTower A B D] [IsScalarTower A C D]
    [IsScalarTower B C D] (P : Type u) [AddCommGroup P] [Module A P]
    (z : D ⊗[C] (C ⊗[B] (B ⊗[A] P))) :
    TensorProduct.AlgebraTensorModule.cancelBaseChange A B D D P
        (TensorProduct.AlgebraTensorModule.cancelBaseChange B C D D (B ⊗[A] P) z) =
      TensorProduct.AlgebraTensorModule.cancelBaseChange A C D D P
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange A B C C P).toLinearMap.baseChange D
          z) := by
  sorry

end
end ProjectiveAutomorphism
end AlgebraicGeometry
