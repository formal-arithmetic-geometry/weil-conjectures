/-! # Effective generic actions and equivariant orbit norms

Source: de Jong, Families of curves and alterations (1997), §3.4, p.606;
quotient-free norm replacement, Stacks Tags 01RV, 01CA, 01CD, 01NE.
(blueprint: lem-sfb-effective-action-norm-pencil)

The orbit bundle and norm are the existing ordered constructions. The permutation
comparison is characterized on every open and every local pure tensor, including its
unit tail. This uniquely determines the isomorphism used for the linearization.

## Main definitions

- `pencilLinearization`: the normalized right-translation permutation of factors.
- `pencilOrbitBaseChangeIso`: the existing factorwise ordered base-change comparison.
- `pencilPowerLinearization`: the induced comparison on every tensor power.
- `pencilSectionPower`: section powers with their prescribed concatenation comparison.

## Main statements

- `effective_action_norm_pencil`: generic faithfulness and every orbit-norm compatibility.
- `existsUnique_pencilPermutationIso`: the unique local pure-tensor characterization used
  to construct the canonical permutation; only its universal-property proof is postponed.
-/

@[expose] public section
set_option autoImplicit false
set_option relaxedAutoImplicit false

attribute [local irreducible] AlgebraicGeometry.Scheme.Modules.tensorPullback

universe u v
open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite
open scoped AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.Modules

/-- Local pure tensors in the already defined ordered translated tensor, with unit tail.
Source: Stacks, Tag 01CA (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilLocalTensor {Y : Scheme.{u}} {G : Type v}
    (ρ : G → Aut Y) (L : Y.Modules) (U : Y.Opens)
    (s : ∀ g : G, Γ((tensorPullback (ρ g).hom).obj L, U)) :
    ∀ l : List G, Γ(pencilTranslateTensor ρ L l, U)
  | [] => unitSectionsEquiv U 1
  | g :: l => tmulSection (s g) (pencilLocalTensor ρ L U s l)

/-- The unique ordered factor permutation, specified on all local pure tensors.
Source: Stacks, Tag 01CA (blueprint: lem-sfb-effective-action-norm-pencil).
Proof: decompose the finite permutation into adjacent transpositions. The symmetry,
associators and unitors give an isomorphism sending the indicated tensor to its reordering.
The tensor sheaf is locally generated by pure tensors, so this formula on every open
uniquely determines its hom, hence its inverse and the isomorphism. The empty tensor is
fixed by its section 1, and repetitions of identical module objects remain labelled.
This is the factor-permutation construction in steps 3--4 of the node. -/
theorem existsUnique_pencilPermutationIso {Y : Scheme.{u}} {G : Type v} [Finite G]
    (ρ : G → Aut Y) (L : Y.Modules) (π : Equiv.Perm G) :
    ∃! e : pencilOrbitBundle (fun g ↦ ρ (π g)) L ≅ pencilOrbitBundle ρ L,
      ∀ (U : Y.Opens) (s : ∀ g : G, Γ((tensorPullback (ρ g).hom).obj L, U)),
        e.hom.app U
            (pencilLocalTensor (fun g ↦ ρ (π g)) L U (fun g ↦ s (π g))
              (pencilGroupElements G)) =
          pencilLocalTensor ρ L U s (pencilGroupElements G) := by
  sorry

/-- The uniquely normalized permutation of translated factors, without an arbitrary choice.
Source: Stacks, Tag 01CA (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilPermutationIso {Y : Scheme.{u}} {G : Type v} [Finite G]
    (ρ : G → Aut Y) (L : Y.Modules) (π : Equiv.Perm G) :
    pencilOrbitBundle (fun g ↦ ρ (π g)) L ≅ pencilOrbitBundle ρ L :=
  Classical.choose (existsUnique_pencilPermutationIso ρ L π)

/-- Pull back an ordered translated tensor and compose each translated pullback.
The convention is `(gh)(y) = g(h(y))`, so right multiplication reindexes its factors.
Source: Stacks, Tag 01CD (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilActionPullbackIso {Y : Scheme.{u}} {G : Type v} [Group G]
    (ρ : G →* Aut Y) (L : Y.Modules) (h : G) :
    ∀ l : List G, (tensorPullback (ρ h).hom).obj (pencilTranslateTensor (fun g ↦ ρ g) L l) ≅
      pencilTranslateTensor (fun g ↦ ρ (g * h)) L l
  | [] => (boundaryPullbackComparison (ρ h).hom).app _ ≪≫ pullbackObjUnitIso (ρ h).hom
  | g :: l =>
    boundaryPullbackTensorIso (ρ h).hom ((tensorPullback (ρ g).hom).obj L)
        (pencilTranslateTensor (fun k ↦ ρ k) L l) ≪≫
      ((((tensorPullbackSectionComp (ρ h).hom (ρ g).hom).app L).symm ≪≫
        eqToIso (congrArg (fun f : Y ⟶ Y ↦ (tensorPullback f).obj L)
          (congrArg Iso.hom (ρ.map_mul g h)).symm)) ⊗ᵢ pencilActionPullbackIso ρ L h l)

/-- The canonical right-translation linearization of the orbit bundle.
Source: Stacks, Tags 01CA, 01CD; de Jong §3.4, norm replacement
(blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilLinearization {Y : Scheme.{u}} {G : Type v} [Group G] [Finite G]
    (ρ : G →* Aut Y) (L : Y.Modules) (h : G) :
    (tensorPullback (ρ h).hom).obj (pencilOrbitBundle (fun g ↦ ρ g) L) ≅
      pencilOrbitBundle (fun g ↦ ρ g) L :=
  pencilActionPullbackIso ρ L h (pencilGroupElements G) ≪≫
    pencilPermutationIso (fun g ↦ ρ g) L (Equiv.mulRight h)

/-- Pull back a global section by the normalized tensor adjunction and restrict to top.
Source: Stacks, Tag 0096 (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilPullbackSection {X Y : Scheme.{u}} (f : X ⟶ Y)
    (M : Y.Modules) (a : M.sections) : ((tensorPullback f).obj M).sections :=
  SheafOfModules.unitHomEquiv _ (homOfGlobalSection _
    (((tensorPullback f).obj M).presheaf.map
      (homOfLE (Scheme.Hom.preimage_top f).ge).op
      (((tensorPullbackSectionAdjunction f).unit.app M).app ⊤ (a.val (op ⊤)))))

/-- Pullback of a section in a tensor power, using the recorded power comparison.
Source: Stacks, Tag 01CD (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilPullbackPowerSection {X Y : Scheme.{u}} (f : X ⟶ Y)
    (L : Y.Modules) (n : ℕ) (a : (L.tensorPow n).sections) :
    (((tensorPullback f).obj L).tensorPow n).sections :=
  SheafOfModules.sectionsMap (boundaryPullbackPowIso f L n).hom
    (pencilPullbackSection f (L.tensorPow n) a)

/-- Concatenate the m copies of a section of L^n into a section of L^(nm).
Source: Stacks, Tag 01CA (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilSectionPower {Y : Scheme.{u}} (L : Y.Modules) (n m : ℕ)
    (a : (L.tensorPow n).sections) : (L.tensorPow (n * m)).sections :=
  SheafOfModules.unitHomEquiv _
    (tensorPowSection (SheafOfModules.unitHomEquiv _ |>.symm a) m ≫
      (L.tensorPowMulIso n m).inv)

/-- The action of the image subgroup G of the given action over S, on Y itself.
Source: de Jong §3.4, effective-action reduction
(blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilEffectiveAction {Y S : Scheme.{u}} {J : Type v} [Group J]
    {p : Y ⟶ S} (ρ : J →* Aut (Over.mk p)) : ρ.range →* Aut Y :=
  ((Over.forget S).mapAut (Over.mk p)).comp ρ.range.subtype

/-- The same image group acting after base change, without taking its image again.
Source: de Jong §3.4; Stacks, Tag 01JX
(blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilBaseChangeAction {Y S T : Scheme.{u}} {J : Type v} [Group J]
    {p : Y ⟶ S} (ρ : J →* Aut (Over.mk p)) (t : T ⟶ S) :
    ρ.range →* Aut (Limits.pullback p t) :=
  (((Over.pullback t) ⋙ Over.forget T).mapAut (Over.mk p)).comp ρ.range.subtype

/-- The image group is finite as the surjective image of the original finite group.
Source: effective-action reduction, de Jong §3.4
(blueprint: lem-sfb-effective-action-norm-pencil). -/
instance pencilEffectiveGroupFinite {Y S : Scheme.{u}} {J : Type v}
    [Group J] [Finite J] {p : Y ⟶ S} (ρ : J →* Aut (Over.mk p)) : Finite ρ.range :=
  Finite.of_surjective ρ.rangeRestrict (MonoidHom.rangeRestrict_surjective ρ)

/-- Canonical comparison of the orbit bundle under base change, factor by factor,
using the existing ordered comparison in SeparatingPairOpen, in the same enumeration.
Source: Stacks, Tag 01CD (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilOrbitBaseChangeIso {Y S T : Scheme.{u}} {J : Type v}
    [Group J] [Finite J] {p : Y ⟶ S} (ρ : J →* Aut (Over.mk p)) (t : T ⟶ S)
    (L : Y.Modules) :
    (tensorPullback (Limits.pullback.fst p t)).obj
        (pencilOrbitBundle (fun g ↦ pencilEffectiveAction ρ g) L) ≅
      pencilOrbitBundle (fun g ↦ pencilBaseChangeAction ρ t g)
        ((tensorPullback (Limits.pullback.fst p t)).obj L) :=
  normPencilTranslateBaseChangeIso (Limits.pullback.fst p t)
    (fun g ↦ pencilEffectiveAction ρ g) (fun g ↦ pencilBaseChangeAction ρ t g)
    (fun g ↦ (baseChange_morphism_projections g.val.hom (Over.mk t)).1)
    L (pencilGroupElements ρ.range)

/-- Identity pullback along a group action, including the action identity comparison.
Source: Stacks, Tag 0097 (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilActionIdentityIso {Y : Scheme.{u}} {G : Type v} [Group G]
    (ρ : G →* Aut Y) (M : Y.Modules) : (tensorPullback (ρ 1).hom).obj M ≅ M :=
  eqToIso (congrArg (fun f : Y ⟶ Y ↦ (tensorPullback f).obj M)
    (congrArg Iso.hom ρ.map_one)) ≪≫ (tensorPullbackSectionId Y).app M

/-- Multiplication comparison for the contravariant pullbacks of a group action.
Source: Stacks, Tag 0097 (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilActionMulIso {Y : Scheme.{u}} {G : Type v} [Group G]
    (ρ : G →* Aut Y) (M : Y.Modules) (h k : G) :
    (tensorPullback (ρ (h * k)).hom).obj M ≅
      (tensorPullback (ρ k).hom).obj ((tensorPullback (ρ h).hom).obj M) :=
  eqToIso (congrArg (fun f : Y ⟶ Y ↦ (tensorPullback f).obj M)
    (congrArg Iso.hom (ρ.map_mul h k))) ≪≫
      (tensorPullbackSectionComp (ρ k).hom (ρ h).hom).app M

/-- The induced linearization on the nth tensor power of the orbit bundle, including n=0.
Source: Stacks, Tags 01CA, 01CD (blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilPowerLinearization {Y : Scheme.{u}} {G : Type v}
    [Group G] [Finite G] (ρ : G →* Aut Y) (L : Y.Modules) (n : ℕ) (h : G) :
    (tensorPullback (ρ h).hom).obj ((pencilOrbitBundle ρ L).tensorPow n) ≅
      (pencilOrbitBundle ρ L).tensorPow n :=
  boundaryPullbackPowIso (ρ h).hom (pencilOrbitBundle ρ L) n ≪≫
    boundaryTensorPowIso (pencilLinearization ρ L h) n

/-- Exchange the two routes around a commuting action square using the normalized
pullback composition maps. Source: Stacks, Tag 0097
(blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilCommutingPullbackIso {X Y : Scheme.{u}} (f : X ⟶ Y)
    (a : Aut Y) (b : Aut X) (w : b.hom ≫ f = f ≫ a.hom) (M : Y.Modules) :
    (tensorPullback b.hom).obj ((tensorPullback f).obj M) ≅
      (tensorPullback f).obj ((tensorPullback a.hom).obj M) :=
  ((tensorPullbackSectionComp b.hom f).app M).symm ≪≫
    eqToIso (congrArg (fun q : X ⟶ Y ↦ (tensorPullback q).obj M) w) ≪≫
      (tensorPullbackSectionComp f a.hom).app M

/-- Norm sections formed after base change, retaining the original effective index group.
Source: Stacks, Tag 01CD; de Jong §3.4
(blueprint: lem-sfb-effective-action-norm-pencil). -/
noncomputable def pencilBaseChangeNorm {Y S T : Scheme.{u}} {J : Type v}
    [Group J] [Finite J] {p : Y ⟶ S} (ρ : J →* Aut (Over.mk p)) (t : T ⟶ S)
    (L : Y.Modules) (n : ℕ) (a : (L.tensorPow n).sections) :
    ((pencilOrbitBundle (pencilBaseChangeAction ρ t)
      ((tensorPullback (Limits.pullback.fst p t)).obj L)).tensorPow n).sections :=
  pencilNormSection (pencilBaseChangeAction ρ t)
    ((tensorPullback (Limits.pullback.fst p t)).obj L) n
    (pencilPullbackPowerSection (Limits.pullback.fst p t) L n a)

/-- Effective actions are faithful on the generic fibre, and the canonical orbit
linearization fixes norm sections, gives invariant pencils, commutes with arbitrary
base change (hence open restriction), and respects positive powers.

Source: de Jong §3.4, p.606, quotient-free norm replacement; Stacks Tags 01RV,
01CA, 01CD, 01NE (blueprint: lem-sfb-effective-action-norm-pencil).

Proof, following the nine steps of the node:
1. Dominance sends the generic point of integral Y to the generic point of S. The
local-ring map embeds the function field of S in that of Y and factors the generic
point probe of Y through C. The affine fraction-field lemma
[lem-sc-integral-function-field-affine-fraction] makes this probe schematically dominant.
2. Two S-automorphisms agreeing on C agree after that probe. Apply
[lemma-nagata-ext-scheme-theoretically-dominant-separated] to the separated target Y/S.
This proves injectivity of the restriction on the actual image subgroup G.
3. Invertibility is preserved by pullback and finite tensors, by
[lem-weil-pbc-invertible-pullback-tensor]. The ordered pullback comparison followed by
right translation g ↦ gh gives the displayed canonical linearization, using
[lem-weil-pbc-module-tensor-symmetric-monoidal].
4. On every local pure tensor both sides of the cocycle move label g to ghk. The
identity comparison fixes each factor. Local generation by pure tensors proves the laws.
5. The power comparison of [def-sc-tensor-pullback-power-comparison] transposes the
array (g,r). Right translation commutes with that transposition, so the power
linearization fixes every norm. In degree zero the norm is the product of all translated
global functions, not necessarily 1; permutation proves invariance in that case too.
6. Use [lem-weil-pbc-invertible-generating-sections-fibre] and
[lem-weil-pbc-projective-space-functor-of-points]. The fixed pair gives equal projective
maps after precomposition by h, and its S-component is fixed. Pullback uniqueness in
[def-weil-pbc-morphism-to-projective-space-by-sections] gives invariance under every j.
7. The factorwise commuting-square comparison sends every tensor entry to its pullback
and its label g to gh along either route. It therefore intertwines linearizations and
norms. Keep the SAME G even if the induced action has a kernel. This works for all T,
including open subschemes, without flatness or integrality of T.
8. Pullback of locally generating sections still generates, since the pullback module
is locally generated by 1 tensor e [def-pc-module-pullback]. The projective-space
functor of points and its two projections identify the pulled-back norm pencil with
the base change of the original coordinate morphism.
9. Concatenating m copies of a and then taking the norm gives the same array (g,j,r)
as taking the norm first and its mth power. The canonical symmetric permutations identify
them. For n=0 this is the commutative-ring product identity; m=1 is the identity comparison.
-/
theorem effective_action_norm_pencil
    {Y S : Scheme.{u}} [IsIntegral S] [IsIntegral Y]
    (p : Y ⟶ S) [IsDominant p] [IsSeparated p]
    (J : Type v) [Group J] [Finite J] (ρ : J →* Aut (Over.mk p))
    (L : Y.Modules) [L.IsInvertible] :
    Function.Injective
        (((Over.pullback S.fromSpecFunctionField).mapAut (Over.mk p)).comp ρ.range.subtype) ∧
    ∃ _hB : (pencilOrbitBundle (pencilEffectiveAction ρ) L).IsInvertible,
    ∃ hBn : ∀ n : ℕ, ((pencilOrbitBundle (pencilEffectiveAction ρ) L).tensorPow n).IsInvertible,
      ((pencilLinearization (pencilEffectiveAction ρ) L 1).hom =
        (pencilActionIdentityIso (pencilEffectiveAction ρ)
          (pencilOrbitBundle (pencilEffectiveAction ρ) L)).hom) ∧
      (∀ h k : ρ.range,
        (pencilLinearization (pencilEffectiveAction ρ) L (h * k)).hom =
          (pencilActionMulIso (pencilEffectiveAction ρ)
            (pencilOrbitBundle (pencilEffectiveAction ρ) L) h k).hom ≫
          (tensorPullback (pencilEffectiveAction ρ k).hom).map
            (pencilLinearization (pencilEffectiveAction ρ) L h).hom ≫
          (pencilLinearization (pencilEffectiveAction ρ) L k).hom) ∧
      (∀ (n : ℕ) (a : (L.tensorPow n).sections) (h : ρ.range),
        SheafOfModules.sectionsMap (pencilPowerLinearization (pencilEffectiveAction ρ) L n h).hom
          (pencilPullbackSection (pencilEffectiveAction ρ h).hom
            ((pencilOrbitBundle (pencilEffectiveAction ρ) L).tensorPow n)
            (pencilNormSection (pencilEffectiveAction ρ) L n a)) =
          pencilNormSection (pencilEffectiveAction ρ) L n a) ∧
      (∀ (n : ℕ) (a b : (L.tensorPow n).sections)
        (hN : Epi (((pencilOrbitBundle (pencilEffectiveAction ρ) L).tensorPow n).freeHomEquiv.symm
          (pencilSectionPair _ (pencilNormSection (pencilEffectiveAction ρ) L n a)
            (pencilNormSection (pencilEffectiveAction ρ) L n b)))) (j : J),
        (ρ j).hom.left ≫ pencilCoordinateMorphism p _ (hBn n)
          (pencilNormSection (pencilEffectiveAction ρ) L n a)
          (pencilNormSection (pencilEffectiveAction ρ) L n b) hN =
        pencilCoordinateMorphism p _ (hBn n)
          (pencilNormSection (pencilEffectiveAction ρ) L n a)
          (pencilNormSection (pencilEffectiveAction ρ) L n b) hN) ∧
      (∀ (T : Scheme.{u}) (t : T ⟶ S),
        ∃ hBTn : ∀ n : ℕ, ((pencilOrbitBundle (pencilBaseChangeAction ρ t)
          ((tensorPullback (Limits.pullback.fst p t)).obj L)).tensorPow n).IsInvertible,
          (∀ h : ρ.range,
            (tensorPullback (pencilBaseChangeAction ρ t h).hom).map
                (pencilOrbitBaseChangeIso ρ t L).hom ≫
              (pencilLinearization (pencilBaseChangeAction ρ t)
                ((tensorPullback (Limits.pullback.fst p t)).obj L) h).hom =
            (pencilCommutingPullbackIso (Limits.pullback.fst p t)
              (pencilEffectiveAction ρ h) (pencilBaseChangeAction ρ t h)
              (baseChange_morphism_projections h.val.hom (Over.mk t)).1
              (pencilOrbitBundle (pencilEffectiveAction ρ) L)).hom ≫
              (tensorPullback (Limits.pullback.fst p t)).map
                (pencilLinearization (pencilEffectiveAction ρ) L h).hom ≫
              (pencilOrbitBaseChangeIso ρ t L).hom) ∧
          (∀ (n : ℕ) (a : (L.tensorPow n).sections),
            SheafOfModules.sectionsMap
              (boundaryTensorPowIso (pencilOrbitBaseChangeIso ρ t L) n).hom
              (pencilPullbackPowerSection (Limits.pullback.fst p t)
                (pencilOrbitBundle (pencilEffectiveAction ρ) L) n
                (pencilNormSection (pencilEffectiveAction ρ) L n a)) =
              pencilBaseChangeNorm ρ t L n a) ∧
          (∀ (n : ℕ) (a b : (L.tensorPow n).sections)
            (hN : Epi
              (((pencilOrbitBundle (pencilEffectiveAction ρ) L).tensorPow n).freeHomEquiv.symm
                (pencilSectionPair _ (pencilNormSection (pencilEffectiveAction ρ) L n a)
                  (pencilNormSection (pencilEffectiveAction ρ) L n b)))),
            ∃ hNT : Epi
              (((pencilOrbitBundle (pencilBaseChangeAction ρ t)
                ((tensorPullback (Limits.pullback.fst p t)).obj L)).tensorPow n).freeHomEquiv.symm
                (pencilSectionPair _ (pencilBaseChangeNorm ρ t L n a)
                  (pencilBaseChangeNorm ρ t L n b))),
              pencilCoordinateMorphism (Limits.pullback.snd p t) _ (hBTn n)
                  (pencilBaseChangeNorm ρ t L n a) (pencilBaseChangeNorm ρ t L n b) hNT ≫
                ProjectiveSpace.map (ULift.{u} (Fin 2)) t =
              Limits.pullback.fst p t ≫ pencilCoordinateMorphism p _ (hBn n)
                (pencilNormSection (pencilEffectiveAction ρ) L n a)
                (pencilNormSection (pencilEffectiveAction ρ) L n b) hN)) ∧
      (∀ (n m : ℕ) (_hm : 1 ≤ m) (a : (L.tensorPow n).sections),
        pencilNormSection (pencilEffectiveAction ρ) L (n * m) (pencilSectionPower L n m a) =
          pencilSectionPower (pencilOrbitBundle (pencilEffectiveAction ρ) L) n m
            (pencilNormSection (pencilEffectiveAction ρ) L n a)) := by
  sorry

end AlgebraicGeometry.Scheme.Modules
