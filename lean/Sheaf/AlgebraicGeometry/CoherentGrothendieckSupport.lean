module

public import Sheaf.AlgebraicGeometry.CoherentFiniteType
public import Sheaf.CategoryTheory.RingedSiteModules
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.Algebra.Homology.ExactSequence
public import Mathlib.Topology.KrullDimension
public import Mathlib.LinearAlgebra.TensorProduct.Tower
public import Mathlib.LinearAlgebra.Quotient.Basic

/-! # The coherent Grothendieck group and its support filtration

Source: Stacks Project, Chow Homology, paragraph preceding Tags 02S8 and 02S9;
Homology, Tag 02MX (blueprint: def-sfb-coherent-grothendieck-support).

The group is a concrete quotient by short exact sequence relations. Coefficient
extension is written with the coefficient ring first, canonically identified with
`G₀(X) ⊗[ℤ] B` by the tensor symmetry. Filtrations after extension use images,
without requiring the coefficient ring to be flat over the integers.
-/

@[expose] public section
set_option autoImplicit false

universe u v

open CategoryTheory
open scoped TensorProduct

namespace AlgebraicGeometry.Scheme.Modules

/-- Coherent modules in the sense of Stacks 01BV.
Source: Stacks, Chow Homology, before 02S8
(blueprint: def-sfb-coherent-grothendieck-support). -/
abbrev CoherentObject (X : Scheme.{u}) :=
  {M : X.Modules // RingedSpace.IsCoherent X.toRingedSpace M}

/-- Short exact sequence relations on the free abelian group of coherent modules.
Source: Stacks, Homology, 02MX
(blueprint: def-sfb-coherent-grothendieck-support). -/
def coherentG0Relations (X : Scheme.{u}) : AddSubgroup (FreeAbelianGroup (CoherentObject X)) :=
  AddSubgroup.closure {r | ∃ (M₁ M₂ M₃ : CoherentObject X)
    (f : M₁.val ⟶ M₂.val) (g : M₂.val ⟶ M₃.val) (h : f ≫ g = 0),
    (ShortComplex.mk f g h).ShortExact ∧
      r = FreeAbelianGroup.of M₂ - FreeAbelianGroup.of M₁ - FreeAbelianGroup.of M₃}

/-- The abelian group generated by coherent modules modulo exact sequence relations.
Source: Stacks, Chow Homology, 02S9; Homology, 02MX
(blueprint: def-sfb-coherent-grothendieck-support). -/
abbrev CoherentG0 (X : Scheme.{u}) :=
  FreeAbelianGroup (CoherentObject X) ⧸ coherentG0Relations X

/-- The class of a coherent module in its Grothendieck group.
Source: Stacks, Chow Homology, 02S9
(blueprint: def-sfb-coherent-grothendieck-support). -/
def coherentG0Class {X : Scheme.{u}} (M : CoherentObject X) : CoherentG0 X :=
  QuotientAddGroup.mk (FreeAbelianGroup.of M)

/-- The subgroup generated by classes supported in dimension at most `k`; negative
indices are zero. Support means the nonzero-stalk locus with its subspace topology.
Source: Stacks, Chow Homology, paragraph preceding 02S8
(blueprint: def-sfb-coherent-grothendieck-support). -/
noncomputable def coherentG0Filtration (X : Scheme.{u}) (k : ℤ) :
    Submodule ℤ (CoherentG0 X) :=
  if k < 0 then ⊥ else
    Submodule.span ℤ {z | ∃ M : CoherentObject X,
      topologicalKrullDim {x : X // ¬ Subsingleton (M.val.presheaf.stalk x)} ≤
        (k.toNat : WithBot ℕ∞) ∧ coherentG0Class M = z}

/-- Coefficient extension of the coherent Grothendieck group. Tensor symmetry gives
exactly `G₀(X) ⊗[ℤ] B`, with the usual `B`-module structure.
Source: the scalar-extension construction following Stacks 02S9
(blueprint: def-sfb-coherent-grothendieck-support). -/
abbrev CoherentG0Scalars (X : Scheme.{u}) (B : Type v) [CommRing B] :=
  TensorProduct ℤ B (CoherentG0 X)

/-- The canonical symmetry from the tensor order in the rank-action statement.
Source: integer-module tensor symmetry, used after Stacks 02S9
(blueprint: def-sfb-coherent-grothendieck-support). -/
noncomputable def coherentG0ScalarSymmetry (X : Scheme.{u}) (B : Type v) [CommRing B] :
    TensorProduct ℤ (CoherentG0 X) B ≃ₗ[ℤ] CoherentG0Scalars X B :=
  TensorProduct.comm ℤ (CoherentG0 X) B

/-- The image filtration after coefficient extension, generated by pure tensors
with the integral factor in the original subgroup.
Source: the scalar-extension construction following Stacks 02S9
(blueprint: def-sfb-coherent-grothendieck-support). -/
noncomputable def coherentG0ScalarFiltration (X : Scheme.{u}) (B : Type v) [CommRing B]
    (k : ℤ) : Submodule B (CoherentG0Scalars X B) :=
  Submodule.span B {z | ∃ (b : B) (x : CoherentG0 X),
    x ∈ coherentG0Filtration X k ∧ z = b ⊗ₜ[ℤ] x}

end AlgebraicGeometry.Scheme.Modules
