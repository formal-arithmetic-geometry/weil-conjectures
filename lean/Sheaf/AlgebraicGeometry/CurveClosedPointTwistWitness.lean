/-! # The closed-point witness on a proper integral curve

Source: Stacks Project, Varieties, Tag 0AYV, proof of condition (2), and Tag 0AYT
(blueprint: lem-trf-curve-closed-point-twist-witness).
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory MonoidalCategory

namespace AlgebraicGeometry.Scheme.Modules

/-- The direct image of the structure sheaf of the canonical residue-field point.
Its sections on U are O(Spec κ(z))(i⁻¹ U), with the O_C(U)-action through i.
Source: Stacks Project, Varieties, Tag 0AYV, proof of condition (2)
(blueprint: lem-trf-curve-closed-point-twist-witness). -/
noncomputable def closedPointStructurePushforward (C : Scheme.{u}) (z : C) : C.Modules :=
  (pushforward (C.fromSpecResidueField z)).obj
    (SheafOfModules.unit (Spec (C.residueField z)).ringCatSheaf)

/-- The closed-point coherent witness, its residue-linear stalk, and invariance of its
Euler characteristic under either order of tensoring with an invertible module.
The residue-field module structure in the dimension clause is transported along the
stalk isomorphism e; its restriction to O_{C,z} is the given stalk action.
Source: Stacks Project, Varieties, Tag 0AYV, proof of condition (2), using Tag 0AYT
(blueprint: lem-trf-curve-closed-point-twist-witness).

Proof:
1. Properness gives finite type. A field is Noetherian, so Spec k and Spec κ(z) are
   locally Noetherian (pqf-def-locnoeth). By pqf-lem-locnoeth-lft, C is locally
   Noetherian. The structure sheaf on Spec κ(z) is quasi-coherent and generated by 1;
   pqf-lem-coherent-ft-locnoeth makes it coherent.
2. The closed immersion is finite (lem-weil-pbc-closed-immersion-finite), so
   lem-weil-pbc-finite-pushforward-coherent makes its structure-sheaf direct image coherent.
3. The unique point of Spec κ(z) maps to z and has structure-sheaf stalk κ(z).
   By lem-weil-pbc-closed-pushforward-stalks, the direct-image stalk at z is κ(z),
   linearly for the canonical stalk map, which is the residue quotient. Every other
   stalk is zero.
4. Elements of the maximal ideal have zero residue, hence annihilate the stalk at z.
   The element corresponding to 1 is a κ(z)-basis, so the dimension is 1. This stalk
   is nonzero and all others vanish, including the generic stalk since z ≠ ξ.
   The support is the singleton {z}, whose sole nonempty irreducible closed subset
   gives topological Krull dimension zero.
5. Apply lem-pc-chi-zero-dim-support to this coherent witness and the invertible
   module L: its third conclusion gives coherence and the Euler equality for G ⊗ L.
6. The swap of balanced tensor generators sheafifies to G ⊗ L ≅ L ⊗ G. It transfers
   coherence and induces inverse k-linear maps on cohomology. The dimensions in the
   Euler sum agree term by term, giving the equality also for L ⊗ G. -/
theorem curve_closed_point_twist_witness (k : Type u) [Field k] (C : Scheme.{u})
    [C.Over (Spec (.of k))] [IsProper (C ↘ Spec (.of k))] [IsIntegral C]
    (hdim : topologicalKrullDim C = 1) (ξ : C) (hξ : closure ({ξ} : Set C) = Set.univ)
    (L : C.Modules) [L.IsInvertible] (z : C) (hzξ : z ≠ ξ)
    (hz : IsClosed ({z} : Set C)) :
    RingedSpace.IsCoherent C.toRingedSpace (closedPointStructurePushforward C z) ∧
    {x : C | ¬ Subsingleton ((closedPointStructurePushforward C z).presheaf.stalk x)} =
      {z} ∧
    topologicalKrullDim
      {x : C | ¬ Subsingleton ((closedPointStructurePushforward C z).presheaf.stalk x)} =
      0 ∧
    (∃ e : ((RingedSpace.moduleStalkFunctor C.toRingedSpace z).obj
        (closedPointStructurePushforward C z)) ≃ₗ[C.presheaf.stalk z]
        ((ModuleCat.restrictScalars (C.residue z).hom).obj
          (ModuleCat.of (C.residueField z) (C.residueField z))),
      @Module.finrank (C.residueField z)
        ((RingedSpace.moduleStalkFunctor C.toRingedSpace z).obj
          (closedPointStructurePushforward C z)) _ _
        (e.toAddEquiv.module (C.residueField z)) = 1) ∧
    (∀ (a : C.presheaf.stalk z), a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk z) →
      ∀ m : (RingedSpace.moduleStalkFunctor C.toRingedSpace z).obj
        (closedPointStructurePushforward C z), a • m = 0) ∧
    Subsingleton ((closedPointStructurePushforward C z).presheaf.stalk ξ) ∧
    RingedSpace.IsCoherent C.toRingedSpace (closedPointStructurePushforward C z ⊗ L) ∧
    RingedSpace.IsCoherent C.toRingedSpace (L ⊗ closedPointStructurePushforward C z) ∧
    (L ⊗ closedPointStructurePushforward C z).eulerChar k =
      (closedPointStructurePushforward C z ⊗ L).eulerChar k ∧
    (closedPointStructurePushforward C z ⊗ L).eulerChar k =
      (closedPointStructurePushforward C z).eulerChar k := by
  sorry

end AlgebraicGeometry.Scheme.Modules
