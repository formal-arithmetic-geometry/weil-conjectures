module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.AlgebraicGeometry.OpenImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
public import Mathlib.AlgebraicGeometry.Limits
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.FiniteType

import Mathlib.AlgebraicGeometry.Gluing

/-! # Finite subrings preserving a prescribed quasi-affine open

Source: Stacks Project, Limits, Tag 01Z7, proof of
`lemma-quasi-affine-finite-type-over-Z`
(blueprint: lem-sfb-quasi-affine-open-finite-subalgebras).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- A finite-type integer scheme embedded as a finite union of principal opens in
`Spec R` descends to a finitely generated subring containing prescribed elements,
with the same principal localization rings and the specified composite embedding.

Source: Stacks Project, Limits, Tag 01Z7, proof of
`lemma-quasi-affine-finite-type-over-Z`
(blueprint: lem-sfb-quasi-affine-open-finite-subalgebras).

Proof:
1. For each chosen `h l`, identify its principal open with `Spec (R[1 / h l])`
   by lem-weil-pbc-principal-localization-open-immersion. Apply
   lem-weil-pbc-lft-affine-pairs to the finite-type structure morphism over the
   integers: each localization is a finitely generated integer algebra.
2. Choose finite algebra generators in these localizations. Write them as
   fractions with powers of `h l` in the denominator, using
   def-weil-ring-localization-away. Generate the unital subring `A` by their
   numerators, all `h l`, and the given finite subset `E`. Its localization
   maps are surjective since their images contain the chosen generators.
3. These maps are injective even for zero-divisor denominators: if a fraction
   maps to zero, a power of its denominator kills its numerator in `R`, hence
   also in the subring `A`. The same fraction was already zero in `A[1 / h l]`.
4. The composite with `Spec R → Spec A` restricts to these isomorphisms on the
   principal opens, and the preimage of each `D_A(h l)` is `D_R(h l)`.
   Their inverse maps agree on overlaps, since both are inverse to the same
   restricted composite. Glue by lem-weil-pbc-scheme-morphism-gluing. The
   resulting inverse identifies `Q` with precisely the union of `D_A(h l)`;
   def-weil-open-immersion gives the claimed open immersion.
5. For the empty family `Q` is empty and the subring generated by `E` works.
   The zero ring and nilpotent denominators give empty principal opens and
   zero localization rings, so the same construction applies. -/
theorem exists_finiteType_subring_preserving_principal_open
    {R : Type u} [CommRing R] (Q : Scheme.{u})
    (j : Q ⟶ Spec (CommRingCat.of R)) [IsOpenImmersion j]
    [LocallyOfFiniteType (specULiftZIsTerminal.from Q)]
    [QuasiCompact (specULiftZIsTerminal.from Q)]
    (m : ℕ) (h : Fin m → R)
    (himage : Set.range j = ⋃ l, (PrimeSpectrum.basicOpen (h l) : Set (PrimeSpectrum R)))
    (E : Finset R) :
    ∃ (A : Subring R) (hh : ∀ l, h l ∈ A),
      Algebra.FiniteType ℤ A ∧ (∀ e ∈ E, e ∈ A) ∧
      (∀ l, Function.Bijective (Localization.awayMap A.subtype (⟨h l, hh l⟩ : A))) ∧
      IsOpenImmersion (j ≫ Spec.map (CommRingCat.ofHom A.subtype)) ∧
      Set.range (j ≫ Spec.map (CommRingCat.ofHom A.subtype)) =
        ⋃ l, (PrimeSpectrum.basicOpen (⟨h l, hh l⟩ : A) : Set (PrimeSpectrum A)) := by
  sorry

end AlgebraicGeometry
