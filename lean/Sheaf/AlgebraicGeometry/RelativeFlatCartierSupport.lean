/-!
# Relatively flat modules have no sections supported over a Cartier divisor

Source: Stacks Project, Divisors, Tag 080F, proof of lemma-strict-transform-flat (2),
with the same power-torsion argument for an arbitrary effective Cartier divisor;
Properties, Tag 07ZP; Algebra, Tag 00HD
(blueprint: lem-trf-relative-flat-cartier-support).

The divisor is represented by its quasi-coherent ideal `D`: its closed subscheme is
`D.subscheme`, its closed immersion is `D.subschemeι`, and its underlying closed set is
`D.support`. The predicate `D.IsInvertible` means locally generated by a non-zero-divisor.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.Modules

/-- A quasi-coherent module flat over the base has injective restriction away from the
inverse image of an effective Cartier divisor. On every affine pair with a regular Cartier
equation, all powers of the pulled-back equation act injectively, and vanishing on its
principal open implies vanishing.

Source: Stacks Project, Divisors, Tag 080F, proof of lemma-strict-transform-flat (2);
Properties, Tag 07ZP; Algebra, Tag 00HD
(blueprint: lem-trf-relative-flat-cartier-support).

Proof:
1. On affine opens `V` of the base and `W` in its inverse image, `M.IsFlatOver g` gives
   flatness of `Γ(M, W)` over `Γ(T, V)` (def-pc-scheme-module-flat-over, Stacks 01U4).
   A regular generator `a` of `D.ideal V` acts injectively on the base ring. The complement
   of the inverse-image divisor in `W` is the principal open of `g.appLE V W e a`.
2. Apply Module.Flat.lTensor_preserves_injective_linearMap
   (lem-trf-flat-tensor-preserves-injection) to multiplication by `a`. Under the canonical
   identification of a module tensored with the base ring with itself, this is scalar
   multiplication by the image of `a`. Induction gives injectivity for every power,
   starting with the identity for power zero.
3. The affine quasi-coherent localization lemma
   Scheme.Modules.exists_pow_smul_eq_zero_of_isAffineOpen
   (lem-weil-pbc-affine-module-basic-open-localization, clause (2)) says a section vanishing
   on the principal open is killed by a power of the equation. Injectivity makes it zero.
4. For an arbitrary open `H`, choose affine Cartier charts on the base and affine opens
   covering their inverse images intersected with `H`. A section vanishing off the divisor
   is zero on every such affine open by step 3, hence is zero by sheaf uniqueness.
   Apply this to the difference of two sections to obtain restriction injectivity. -/
theorem relative_flat_cartier_support {Y T : Scheme.{u}} (g : Y ⟶ T)
    (D : T.IdealSheafData) (hD : D.IsInvertible) (M : Y.Modules)
    [SheafOfModules.IsQuasicoherent (R := Y.ringCatSheaf) M] (hflat : M.IsFlatOver g) :
    (∀ H : Y.Opens,
      Function.Injective (M.presheaf.map
        (homOfLE (inf_le_left : H ⊓ g ⁻¹ᵁ D.support.compl ≤ H)).op)) ∧
    (∀ (V : T.affineOpens) (W : Y.affineOpens) (e : W.1 ≤ g ⁻¹ᵁ V.1)
      (a : Γ(T, V.1)), a ∈ nonZeroDivisors Γ(T, V.1) →
      D.ideal V = Ideal.span {a} →
      (∀ n : ℕ, Function.Injective
        (fun s : Γ(M, W.1) ↦ (g.appLE V.1 W.1 e a) ^ n • s)) ∧
      (∀ s : Γ(M, W.1),
        M.presheaf.map (homOfLE (Y.basicOpen_le (g.appLE V.1 W.1 e a))).op s = 0 →
          s = 0)) := by
  have hpow (V : T.affineOpens) (W : Y.affineOpens) (e : W.1 ≤ g ⁻¹ᵁ V.1)
      (a : Γ(T, V.1)) (ha : a ∈ nonZeroDivisors Γ(T, V.1)) (n : ℕ) :
      Function.Injective (fun s : Γ(M, W.1) ↦ (g.appLE V.1 W.1 e a) ^ n • s) := by
    let : Module Γ(T, V.1) Γ(M, W.1) := Module.compHom _ (g.appLE V.1 W.1 e).hom
    let : Module.Flat Γ(T, V.1) Γ(M, W.1) := hflat V W e
    have hi : Function.Injective (fun s : Γ(M, W.1) ↦ (a ^ n) • s) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Γ(M, W.1)) (pow_mem ha n)
    change Function.Injective
      (fun s : Γ(M, W.1) ↦ (g.appLE V.1 W.1 e).hom (a ^ n) • s) at hi
    simpa only [map_pow] using hi
  have hzero (V : T.affineOpens) (W : Y.affineOpens) (e : W.1 ≤ g ⁻¹ᵁ V.1)
      (a : Γ(T, V.1)) (ha : a ∈ nonZeroDivisors Γ(T, V.1)) (s : Γ(M, W.1))
      (hs : M.presheaf.map (homOfLE (Y.basicOpen_le (g.appLE V.1 W.1 e a))).op s = 0) :
      s = 0 := by
    obtain ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_isAffineOpen M W.2 _ s hs
    apply hpow V W e a ha n
    simpa only [smul_zero] using hn
  refine ⟨?_, fun V W e a ha _ ↦ ⟨hpow V W e a ha, hzero V W e a ha⟩⟩
  intro H s t hst
  apply sub_eq_zero.mp
  have hr : M.presheaf.map
      (homOfLE (inf_le_left : H ⊓ g ⁻¹ᵁ D.support.compl ≤ H)).op (s - t) = 0 := by
    simpa only [map_sub] using sub_eq_zero.mpr hst
  have hloc (x : H) : ∃ (W : Y.affineOpens) (i : W.1 ≤ H), x.1 ∈ W.1 ∧
      M.presheaf.map (homOfLE i).op (s - t) = 0 := by
    obtain ⟨V, hxV, a, ha, hgen⟩ := hD (g x.1)
    obtain ⟨W, hW, hxW, hWHV⟩ := exists_isAffineOpen_mem_and_subset
      (U := H ⊓ g ⁻¹ᵁ V.1) (x := x.1) ⟨x.2, hxV⟩
    have hWH : W ≤ H := hWHV.trans inf_le_left
    have e : W ≤ g ⁻¹ᵁ V.1 := hWHV.trans inf_le_right
    refine ⟨⟨W, hW⟩, hWH, hxW, hzero V ⟨W, hW⟩ e a ha _ ?_⟩
    have hb : Y.basicOpen (g.appLE V.1 W e a) ≤ H ⊓ g ⁻¹ᵁ D.support.compl := by
      rw [Scheme.basicOpen_appLE]
      intro y hy
      refine ⟨hWH hy.1, ?_⟩
      change g y ∉ D.support
      intro hyD
      have hyZ := (D.mem_support_iff_of_mem (e hy.1)).mp hyD
      rw [hgen, T.zeroLocus_span, T.zeroLocus_singleton] at hyZ
      exact hyZ hy.2
    have heq := congrArg (M.presheaf.map (homOfLE hb).op) hr
    simpa only [map_zero, ← Functor.map_comp_apply, ← op_comp, homOfLE_comp] using heq
  classical
  choose W i hx hz using hloc
  refine TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩
    (fun x : H ↦ (W x).1) H (fun x ↦ homOfLE (i x)) ?_ (s - t) 0 ?_
  · intro x hxH
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hxH⟩, hx ⟨x, hxH⟩⟩
  · intro x
    simpa only [map_zero] using hz x

end AlgebraicGeometry.Scheme.Modules
