module

public import WeilConjectures.Mathlib.RingTheory.ReesAlgebra
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Mathlib.Topology.Sheaves.Functors
public import Mathlib.Topology.Sheaves.Stalks
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Category.Ring.Colimits

/-! # Higher graded algebras of an ideal on a scheme

Source: ILO, Travaux de Gabber, Expose III, section 4 and Definition 4.2, pp.39--40
(blueprint: def-per-higher-graded-sheaf).

The construction sheafifies the extended Rees algebra modulo t^a. The Laurent
exponent is the negative of the grading in the source. In particular negative
degrees are retained. Sheafification, rather than quotienting arbitrary sections
of a sheaf, imposes the local quotient relations.
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.HigherGraded

/-- The higher graded ring, with degree q represented by b t^(-q).
Source: ILO III section 4, p.39 (blueprint: def-per-higher-graded-sheaf). -/
def Ring {R : Type u} [CommRing R] (I : Ideal R) (a : ℕ) :=
  I.extendedReesAlgebra ⧸ Ideal.span {I.extendedReesAlgebraT ^ a}

/-- The quotient has its ordinary commutative ring structure.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
instance instCommRing {R : Type u} [CommRing R] (I : Ideal R) (a : ℕ) : CommRing (Ring I a) :=
  inferInstanceAs (CommRing (I.extendedReesAlgebra ⧸
    Ideal.span {I.extendedReesAlgebraT ^ a}))

/-- The Rees quotient relations are preserved by an ideal-preserving map.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf).
Proof: the Rees map sends t to t, hence t^a to t^a; ideal closure gives the assertion. -/
theorem map_relation {R S : Type u} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J) (a : ℕ) :
    Ideal.span {I.extendedReesAlgebraT ^ a} ≤
      (Ideal.span {J.extendedReesAlgebraT ^ a}).comap (I.extendedReesAlgebraMap f J h) := by
  sorry

/-- Functoriality of the actual Rees quotient.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def map {R S : Type u} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J) (a : ℕ) :
    Ring I a →+* Ring J a :=
  Ideal.quotientMap _ (I.extendedReesAlgebraMap f J h) (map_relation I J f h a)

variable {R : Type u} [CommRing R] (I : Ideal R) (X : Scheme.{u})
    (ρ : R →+* Γ(X, ⊤))

/-- The structural map on an open subset.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def sectionsMap (U : X.Opens) : R →+* Γ(X, U) :=
  (X.presheaf.map (homOfLE le_top : U ⟶ ⊤).op).hom.comp ρ

/-- The sectionwise ideal generated by the base ideal.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def sectionsIdeal (U : X.Opens) : Ideal Γ(X, U) := I.map (sectionsMap X ρ U)

/-- Restriction preserves the sectionwise base ideals.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf).
Proof: each generator restricts to the same base element, by functoriality of
restriction from the top open. The claim follows by closure under ideal operations. -/
theorem restriction_ideal {U V : X.Opens} (f : U ⟶ V) :
    (sectionsIdeal I X ρ V).map (X.presheaf.map f.op).hom ≤ sectionsIdeal I X ρ U := by
  sorry

/-- Restrictions of higher graded quotient rings.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def restriction (a : ℕ) {U V : X.Opens} (f : U ⟶ V) :
    Ring (sectionsIdeal I X ρ V) a →+* Ring (sectionsIdeal I X ρ U) a :=
  map _ _ (X.presheaf.map f.op).hom (restriction_ideal I X ρ f) a

/-- Identity law for quotient restriction.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf).
Proof: each Laurent coefficient is unchanged; passage to the quotient preserves this. -/
theorem restriction_id (a : ℕ) (U : X.Opens) :
    restriction I X ρ a (𝟙 U) = RingHom.id _ := by
  sorry

/-- Composition law for quotient restriction.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf).
Proof: on a Rees representative the two maps apply the same composite to every
coefficient. The quotient maps are surjective, giving equality. -/
theorem restriction_comp (a : ℕ) {U V W : X.Opens} (f : U ⟶ V) (g : V ⟶ W) :
    restriction I X ρ a (f ≫ g) =
      (restriction I X ρ a f).comp (restriction I X ρ a g) := by
  sorry

/-- The explicit quotient presheaf defining the higher graded algebra.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def presheaf (a : ℕ) : X.Opensᵒᵖ ⥤ CommRingCat.{u} where
  obj U := .of (Ring (sectionsIdeal I X ρ U.unop) a)
  map f := CommRingCat.ofHom (restriction I X ρ a f.unop)
  map_id U := congrArg CommRingCat.ofHom (restriction_id I X ρ a U.unop)
  map_comp f g := congrArg CommRingCat.ofHom (restriction_comp I X ρ a g.unop f.unop)

/-- The ring sheaf with degree q equal to I^q/I^(q+a) before support restriction.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def ambientSheaf (a : ℕ) : TopCat.Sheaf CommRingCat.{u} X :=
  (presheafToSheaf (Opens.grothendieckTopology X) CommRingCat).obj (presheaf I X ρ a)

/-- The higher graded ring sheaf on X^[a], restricted by inverse image.
Source: ILO III Definition 4.2 (blueprint: def-per-higher-graded-sheaf). -/
def sheaf (a : ℕ) :
    TopCat.Sheaf CommRingCat.{u}
      ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme) :=
  (TopCat.Sheaf.pullback CommRingCat
    ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι).base).obj
    (ambientSheaf I X ρ a)

/-- The canonical class of a Rees representative on the inverse image of an ambient open.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def classMap (a : ℕ) (U : X.Opens) :
    (sectionsIdeal I X ρ U).extendedReesAlgebra →+*
      (sheaf I X ρ a).obj.obj
        (op ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι ⁻¹ᵁ U)) :=
  (((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat
      ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι).base).unit.app
    (ambientSheaf I X ρ a)).hom.app (op U)).hom.comp
      (((toSheafify (Opens.grothendieckTopology X) (presheaf I X ρ a)).app (op U)).hom.comp
        (Ideal.Quotient.mk _))

/-- The homogeneous part in a stalk, specified by local homogeneous Rees representatives.
Source: ILO III section 4 (blueprint: def-per-higher-graded-sheaf). -/
def homogeneous (a : ℕ)
    (x : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme) (q : ℤ) :
    Set (TopCat.Presheaf.stalk (C := CommRingCat.{u}) (sheaf I X ρ a).obj x) :=
  {s | ∃ (U : X.Opens)
    (hx : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι x ∈ U)
    (z : (sectionsIdeal I X ρ U).extendedReesAlgebra) (b : Γ(X, U)),
    (z : LaurentPolynomial Γ(X, U)) = LaurentPolynomial.C b * LaurentPolynomial.T (-q) ∧
      (TopCat.Presheaf.germ (sheaf I X ρ a).obj
        ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι ⁻¹ᵁ U) x hx)
        (classMap I X ρ a U z) = s}

/-- The base higher graded algebra acts through its canonical structural germs.
Source: ILO III Definition 4.2 (blueprint: def-per-higher-graded-sheaf). -/
def baseGerm (a : ℕ)
    (x : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme)
    (z : I.extendedReesAlgebra) :
    TopCat.Presheaf.stalk (C := CommRingCat.{u}) (sheaf I X ρ a).obj x :=
  (TopCat.Presheaf.germ (sheaf I X ρ a).obj
    ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι ⁻¹ᵁ (⊤ : X.Opens))
    x (by trivial))
      (classMap I X ρ a ⊤
        (I.extendedReesAlgebraMap (sectionsMap X ρ ⊤) _ le_rfl z))

/-- Unique factorization of the degree-zero structural map through O_X/I^a.
Source: ILO III section 4 and Definition 4.2 (blueprint: def-per-higher-graded-sheaf).
Proof: constants in the Rees quotient kill I^a. Locally the closed-subscheme
structure sheaf is exactly the quotient by this ideal. The quotient universal
property gives the factorization on affine opens; the formulas agree on overlaps
and therefore glue. Local surjectivity of the structural quotient proves uniqueness.
For a=0 both sheaves are zero and the same argument applies. -/
theorem exists_unique_zeroMap (a : ℕ) :
    ∃! j : ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme).sheaf
      ⟶ sheaf I X ρ a,
      ∀ (U : X.Opens) (r : Γ(X, U)),
        (j.hom.app
          (op ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι ⁻¹ᵁ U)))
            (((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subschemeι).app U r) =
          classMap I X ρ a U (algebraMap Γ(X, U) _ r) := by
  sorry

/-- The canonical degree-zero inclusion, uniquely characterized by ambient constants.
Source: ILO III Definition 4.2 (blueprint: def-per-higher-graded-sheaf). -/
def zeroMap (a : ℕ) :
    ((Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme).sheaf
      ⟶ sheaf I X ρ a :=
  (exists_unique_zeroMap I X ρ a).exists.choose

/-- The induced stalk map of a sheaf isomorphism over an isomorphism of thickenings.
Source: ILO III Definition 4.2 (blueprint: def-per-higher-graded-sheaf). -/
def isoStalkMap {Y : Scheme.{u}} (σ : R →+* Γ(Y, ⊤)) (a : ℕ)
    (φ : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme ≅
      (Scheme.IdealSheafData.ofIdealTop (I.map σ) ^ a).subscheme)
    (e : sheaf I Y σ a ≅
      (TopCat.Sheaf.pushforward CommRingCat φ.hom.base).obj (sheaf I X ρ a))
    (x : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme) :
    TopCat.Presheaf.stalk (C := CommRingCat.{u}) (sheaf I Y σ a).obj (φ.hom x) ⟶
      TopCat.Presheaf.stalk (C := CommRingCat.{u}) (sheaf I X ρ a).obj x :=
  (TopCat.Presheaf.stalkFunctor CommRingCat (φ.hom x)).map e.hom.hom ≫
    TopCat.Presheaf.stalkPushforward CommRingCat φ.hom.base (sheaf I X ρ a).obj x

/-- The extension condition: grading, structural base action, and the prescribed
map on the entire degree-zero structure sheaf.
Source: ILO III Definition 4.2 (blueprint: def-per-higher-graded-sheaf). -/
def IsExtension {Y : Scheme.{u}} (σ : R →+* Γ(Y, ⊤)) (a : ℕ)
    (φ : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme ≅
      (Scheme.IdealSheafData.ofIdealTop (I.map σ) ^ a).subscheme)
    (e : sheaf I Y σ a ≅
      (TopCat.Sheaf.pushforward CommRingCat φ.hom.base).obj (sheaf I X ρ a)) : Prop :=
  (∀ (x : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme)
      (q : ℤ),
    isoStalkMap I X ρ σ a φ e x '' homogeneous I Y σ a (φ.hom x) q =
      homogeneous I X ρ a x q) ∧
  (∀ (x : (Scheme.IdealSheafData.ofIdealTop (I.map ρ) ^ a).subscheme) (z : I.extendedReesAlgebra),
    isoStalkMap I X ρ σ a φ e x (baseGerm I Y σ a (φ.hom x) z) =
      baseGerm I X ρ a x z) ∧
  ∀ (U : ((Scheme.IdealSheafData.ofIdealTop (I.map σ) ^ a).subscheme).Opens)
    (r : Γ((Scheme.IdealSheafData.ofIdealTop (I.map σ) ^ a).subscheme, U)),
    e.hom.hom.app (op U) ((zeroMap I Y σ a).hom.app (op U) r) =
      (zeroMap I X ρ a).hom.app (op (φ.hom ⁻¹ᵁ U)) (φ.hom.app U r)

end AlgebraicGeometry.HigherGraded
