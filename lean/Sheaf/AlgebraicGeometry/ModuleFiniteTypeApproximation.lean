module

public import Mathlib.AlgebraicGeometry.Morphisms.QuasiSeparated
public import Sheaf.AlgebraicGeometry.Coherent
import Sheaf.AlgebraicGeometry.ModuleFiniteTypeAffineEnlargement

/-! # Finite-type approximation of a global quasi-coherent module

Source: Stacks Project, Properties, Lemma 01PF, proof, lines 2865--2894.
(blueprint: lem-weil-pbc-module-finite-type-global-approximation).
-/

@[expose] public section

universe u

open CategoryTheory AlgebraicGeometry SheafOfModules

namespace AlgebraicGeometry.Scheme.Modules

set_option autoImplicit false

private theorem compact_sup_affines (X : Scheme.{u}) {U : X.Opens}
    (hU : IsCompact (U : Set X)) (t : Finset X.affineOpens) :
    IsCompact ((U ⊔ t.sup fun V ↦ V.1 : X.Opens) : Set X) := by
  classical
  induction t using Finset.induction_on with
  | empty => simpa using hU
  | insert V t hV ih =>
    have he : U ⊔ (insert V t).sup (fun V ↦ V.1) =
        (U ⊔ t.sup fun V ↦ V.1) ⊔ V.1 := by
      rw [Finset.sup_insert, sup_comm V.1 (t.sup fun V ↦ V.1), ← sup_assoc]
    rw [he, TopologicalSpace.Opens.coe_sup]
    exact ih.union V.2.isCompact

private theorem isIso_over_of_le (X : Scheme.{u}) {E H : X.Modules} (j : E ⟶ H)
    {U W : X.Opens} (h : U ≤ W) [IsIso (j.over W)] : IsIso (j.over U) := by
  apply (NatIso.isIso_map_iff
    (SheafOfModules.overFunctorMap X.ringCatSheaf (homOfLE h)) j).mp
  change IsIso ((SheafOfModules.overMap X.ringCatSheaf (homOfLE h)).map (j.over W))
  infer_instance

set_option backward.isDefEq.respectTransparency false in
private theorem finiteType_of_top (X : Scheme.{u}) (M : X.Modules)
    [(M.over (⊤ : X.Opens)).IsFiniteType] : M.IsFiniteType := by
  obtain ⟨D, hD⟩ := IsFiniteType.exists_localGeneratorsData (M.over (⊤ : X.Opens))
  let q : M.LocalGeneratorsData :=
    { I := (_ : Unit) × D.I
      X i := (D.X i.2).left
      coversTop :=
        ((Opens.coversTop_iff _ (fun _ : Unit ↦ (⊤ : X.Opens))).mpr
          (by change (⨆ _ : Unit, (⊤ : X.Opens)) = ⊤; exact iSup_const)).over
            (fun _ ↦ D.coversTop)
      generators i := by
        let e := pushforwardPushforwardEquivalence (Over.iteratedSliceEquiv (D.X i.2))
          (S := (X.ringCatSheaf.over _).over _) (R := X.ringCatSheaf.over _) (𝟙 _) (𝟙 _)
          (by ext : 2; exact X.ringCatSheaf.1.map_id _)
          (by ext : 2; exact X.ringCatSheaf.1.map_id _)
        exact ((D.generators i.2).map e.inverse (.refl _)).ofEpi
          (e.fullyFaithfulFunctor.preimageIso
            (by exact e.counitIso.app ((M.over (⊤ : X.Opens)).over (D.X i.2)))).hom }
  have : q.IsFiniteType :=
    { isFiniteType := fun i ↦ by
        have := hD.isFiniteType i.2
        dsimp [q]
        infer_instance }
  exact { exists_localGeneratorsData := ⟨q, inferInstance⟩ }

/-- A global quasi-coherent module which is finite type on a quasi-compact open
contains a finite-type quasi-coherent submodule equal to it on that open.

Source: Stacks Project, Properties, Lemma 01PF, proof, lines 2865--2894.
(blueprint: lem-weil-pbc-module-finite-type-global-approximation).

Proof: Cover X by finitely many affine opens V, and enlarge the initial open U
one affine at a time. The intersection of the current quasi-compact open W with V
is quasi-compact because X is quasi-separated. On V, quasi-coherence identifies
H with the module of its sections. Cover W intersect V by finitely many principal
opens on which the prescribed submodule is finitely generated. Lift the finitely
many generators to numerators in H(V), and take the submodule generated by all
these numerators. Its associated sheaf is a finite-type quasi-coherent submodule
of H on V, with the prescribed restriction on the overlap: localization contains
all the chosen generators and is contained in the prescribed submodule. Glue this
submodule with the prescribed one on W by imposing both local membership
conditions on sections of H. The resulting subsheaf is quasi-coherent and finite
type because both properties are local. Induct over the finite affine cover,
starting with H restricted to U. The inclusions glue and restrict to isomorphisms
on U. This also covers the empty open and the empty scheme. -/
theorem exists_finiteType_global_approximation
    (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X]
    (U : X.Opens) (hU : IsCompact (U : Set X))
    (H : SheafOfModules.{u} (moduleRings X.toRingedSpace)) [H.IsQuasicoherent]
    [(H.over U).IsFiniteType] :
    ∃ (E : SheafOfModules.{u} (moduleRings X.toRingedSpace)),
      E.IsQuasicoherent ∧ E.IsFiniteType ∧ ∃ (j : E ⟶ H),
        Mono j ∧ IsIso ((SheafOfModules.overFunctor
          (moduleRings X.toRingedSpace) U).map j) := by
  classical
  have key : ∀ t : Finset X.affineOpens,
      ∃ (E : X.Modules), E.IsQuasicoherent ∧
        (E.over (U ⊔ t.sup fun V ↦ V.1)).IsFiniteType ∧
        ∃ (j : E ⟶ H), Mono j ∧ IsIso (j.over U) := by
    intro t
    induction t using Finset.induction_on with
    | empty =>
      refine ⟨H, inferInstance, ?_, 𝟙 H, inferInstance, ?_⟩
      · rw [Finset.sup_empty, sup_bot_eq]
        infer_instance
      · change IsIso ((SheafOfModules.overFunctor _ U).map (𝟙 H))
        rw [CategoryTheory.Functor.map_id]
        infer_instance
    | insert V t hV ih =>
      obtain ⟨E, hE, hEft, j, hj, hjU⟩ := ih
      have : E.IsQuasicoherent := hE
      have : (E.over (U ⊔ t.sup fun V ↦ V.1)).IsFiniteType := hEft
      obtain ⟨E', hE', hE'ft, j', hj', hj'W⟩ :=
        exists_finiteType_affine_enlargement X _ (compact_sup_affines X hU t) V E
      have he : U ⊔ (insert V t).sup (fun V ↦ V.1) =
          (U ⊔ t.sup fun V ↦ V.1) ⊔ V.1 := by
        rw [Finset.sup_insert, sup_comm V.1 (t.sup fun V ↦ V.1), ← sup_assoc]
      have : Mono j := hj
      have : Mono j' := hj'
      have : IsIso (j.over U) := hjU
      have : IsIso (j'.over (U ⊔ t.sup fun V ↦ V.1)) := hj'W
      have : IsIso (j'.over U) := isIso_over_of_le X j'
        (W := U ⊔ t.sup fun V ↦ V.1) le_sup_left
      refine ⟨E', hE', by rwa [he], j' ≫ j, inferInstance, ?_⟩
      change IsIso ((SheafOfModules.overFunctor _ U).map (j' ≫ j))
      rw [Functor.map_comp]
      infer_instance
  have hcov : (Set.univ : Set X) ⊆ ⋃ V : X.affineOpens, (V.1 : Set X) := by
    intro x _
    have hx : x ∈ (⊤ : X.Opens) := trivial
    rw [← iSup_affineOpens_eq_top X] at hx
    obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact Set.mem_iUnion.mpr ⟨V, hV⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun V : X.affineOpens ↦ (V.1 : Set X)) (fun V ↦ V.1.isOpen) hcov
  have he : U ⊔ t.sup (fun V ↦ V.1) = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨V, hVt, hxV⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    exact (le_sup_right : t.sup (fun V ↦ V.1) ≤ U ⊔ t.sup (fun V ↦ V.1))
      ((Finset.le_sup (f := fun V ↦ V.1) hVt) hxV)
  obtain ⟨E, hE, hEft, j, hj, hjU⟩ := key t
  have : (E.over (⊤ : X.Opens)).IsFiniteType := by rwa [he] at hEft
  exact ⟨E, hE, finiteType_of_top X E, j, hj, hjU⟩

end AlgebraicGeometry.Scheme.Modules
