/-!
# Affine pushforward and ideal-module products

Source: Stacks Project, Cohomology of Schemes, Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product).
-/

@[expose] public section

universe v

open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite
open scoped TensorProduct

namespace AlgebraicGeometry.Scheme

noncomputable section

/-- Transfer the affine image-section formula from the abelian image to the chosen image.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product). -/
private theorem image_range_affine {X : Scheme.{v}} {M N : X.Modules}
    (φ : M ⟶ N) [M.IsQuasicoherent] [N.IsQuasicoherent] (U : X.affineOpens) :
    Set.range ((image.ι φ).app U.1) = Set.range (φ.app U.1) := by
  let e := Abelian.imageIsoImage φ
  have he : Function.Surjective (e.hom.app U.1) :=
    (Modules.appLinearEquivOfIso e U.1).surjective
  have hf : e.hom ≫ image.ι φ = Abelian.image.ι φ :=
    Abelian.imageIsoImage_hom_comp_image_ι φ
  have hr : Set.range ((image.ι φ).app U.1) =
      Set.range ((Abelian.image.ι φ).app U.1) := by
    rw [← hf, Modules.Hom.comp_app]
    ext s
    constructor
    · rintro ⟨t, rfl⟩
      obtain ⟨a, rfl⟩ := he t
      exact ⟨a, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨e.hom.app U.1 a, rfl⟩
  exact hr.trans ((Modules.quasiCoherent_cokernel_image φ).2.2.2.2.2.2.2.2 U).1

/-- On an affine open, a product has the additive subgroup generated by pure products.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product). -/
private theorem product_range_affine {X : Scheme.{v}} {J : X.Modules}
    (ι : J ⟶ SheafOfModules.unit X.ringCatSheaf) (M : X.Modules)
    [J.IsQuasicoherent] [M.IsQuasicoherent] (U : X.affineOpens) :
    Set.range ((idealModuleProductι ι M).app U.1) =
      (AddSubgroup.closure {s | ∃ (a : Γ(J, U.1)) (t : Γ(M, U.1)),
        s = (Modules.unitSectionsEquiv U.1).symm (ι.app U.1 a) • t} : Set Γ(M, U.1)) := by
  let ψ : J ⊗ M ⟶ M := ι ▷ M ≫ (λ_ M).hom
  have : (J ⊗ M).IsQuasicoherent :=
    (Modules.quasiCoherent_tensor_product_affine_sections J M).1
  change Set.range ((image.ι ψ).app U.1) = _
  rw [image_range_affine ψ U]
  let H := AddSubgroup.closure {s | ∃ (a : Γ(J, U.1)) (t : Γ(M, U.1)),
    s = (Modules.unitSectionsEquiv U.1).symm (ι.app U.1 a) • t}
  have ht (a : Γ(J, U.1)) (t : Γ(M, U.1)) :
      ψ.app U.1 (Modules.tmulSection a t) =
        (Modules.unitSectionsEquiv U.1).symm (ι.app U.1 a) • t := by
    rw [Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      Modules.whiskerRight_app_tmulSection]
    exact Modules.leftUnitor_hom_app_tmulSection' _ _
  apply Set.Subset.antisymm
  · rintro _ ⟨s, rfl⟩
    obtain ⟨z, rfl⟩ :=
      (Modules.quasiCoherent_tensor_product_affine_sections J M).2 U.1 U.2 |>.2 s
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]; exact H.zero_mem
    | tmul a t =>
      rw [Modules.tensorSectionsMap_tmul, ht]
      exact AddSubgroup.subset_closure ⟨a, t, rfl⟩
    | add z z' hz hz' =>
      simp only [map_add]
      exact H.add_mem hz hz'
  · change H ≤ (ψ.val.app (op U.1)).hom.range.toAddSubgroup
    apply (AddSubgroup.closure_le _).mpr
    rintro s ⟨a, t, rfl⟩
    exact ⟨Modules.tmulSection a t, ht a t⟩

/-- Over an affine preimage, absorb the extra base-change scalar into the module section.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product). -/
private theorem extended_product_range_affine {X Y : Scheme.{v}} (f : Y ⟶ X)
    [IsAffineHom f] (F : Y.Modules) [F.IsQuasicoherent] {I : X.Modules}
    [I.IsQuasicoherent] [((Modules.tensorPullback f).obj I).IsQuasicoherent]
    (ι : I ⟶ SheafOfModules.unit X.ringCatSheaf) (V : X.affineOpens) :
    Set.range ((idealModuleProductι
      ((Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f) F).app
        (f ⁻¹ᵁ V.1)) =
      (AddSubgroup.closure {s | ∃ (a : Γ(I, V.1)) (t : Γ(F, f ⁻¹ᵁ V.1)),
        s = f.app V.1 ((Modules.unitSectionsEquiv V.1).symm (ι.app V.1 a)) • t} :
          Set Γ(F, f ⁻¹ᵁ V.1)) := by
  let U : Y.affineOpens := ⟨f ⁻¹ᵁ V.1, V.2.preimage f⟩
  let j := (Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f
  let adj := Classical.choose (Modules.exists_tensorPullbackAdjunction f)
  let : Algebra Γ(X, V.1) Γ(Y, U.1) := (f.appLE V.1 U.1 le_rfl).hom.toAlgebra
  let : ∀ G : X.Modules, Module Γ(X, V.1) Γ((Modules.tensorPullback f).obj G, U.1) :=
    fun G ↦ Module.compHom _ (f.appLE V.1 U.1 le_rfl).hom
  obtain ⟨c, hc, -, hp, -⟩ := Modules.exists_tensorPullback_affine_sections f V U le_rfl
  have hunit (a : Γ(I, V.1)) :
      j.app U.1 ((adj.unit.app I).app V.1 a) =
        (Modules.unitSectionsEquiv U.1)
          (f.app V.1 ((Modules.unitSectionsEquiv V.1).symm (ι.app V.1 a))) := by
    have hnat := congrArg (fun q ↦ q.app V.1 a) (adj.unit.naturality ι)
    have hε := congrArg (fun q ↦ q.app V.1 (ι.app V.1 a))
      (Modules.tensorPullbackObjUnitToUnit_isIso f).2
    simp only [Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      Functor.id_map, Functor.comp_map, Modules.pushforward_map_app] at hnat hε
    change (Modules.tensorPullbackObjUnitToUnit f).app (f ⁻¹ᵁ V.1)
      (((Modules.tensorPullback f).map ι).app (f ⁻¹ᵁ V.1)
        ((adj.unit.app I).app V.1 a)) = _
    exact (congrArg ((Modules.tensorPullbackObjUnitToUnit f).app (f ⁻¹ᵁ V.1))
      hnat.symm).trans hε
  have hcalc (a : Γ(I, V.1)) (b : Γ(Y, U.1)) :
      j.app U.1 (c I inferInstance (a ⊗ₜ[Γ(X, V.1)] b)) =
        b • (Modules.unitSectionsEquiv U.1)
          (f.app V.1 ((Modules.unitSectionsEquiv V.1).symm (ι.app V.1 a))) := by
    rw [hp, Modules.Hom.app_smul]
    have hm := ((Modules.tensorPullback f).obj I).presheaf.map_id (op U.1)
    have ha := congrArg (fun q ↦ q ((adj.unit.app I).app V.1 a)) hm
    change (((Modules.tensorPullback f).obj I).presheaf.map (𝟙 (op U.1)))
      ((adj.unit.app I).app V.1 a) = (adj.unit.app I).app V.1 a at ha
    exact (congrArg (fun x ↦ b • j.app U.1 x) ha).trans
      (congrArg (b • ·) (hunit a))
  rw [product_range_affine j F U]
  let H := AddSubgroup.closure {s | ∃ (a : Γ(I, V.1)) (t : Γ(F, U.1)),
    s = f.app V.1 ((Modules.unitSectionsEquiv V.1).symm (ι.app V.1 a)) • t}
  apply congrArg (fun K : AddSubgroup Γ(F, U.1) ↦ (K : Set Γ(F, U.1)))
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro s ⟨x, t, rfl⟩
    obtain ⟨z, rfl⟩ := (hc I inferInstance).2 x
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero, zero_smul]; exact H.zero_mem
    | tmul a b =>
      rw [hcalc, LinearEquiv.map_smul]
      change (b * f.app V.1 _) • t ∈ H
      rw [mul_comm, mul_smul]
      exact AddSubgroup.subset_closure ⟨a, b • t, rfl⟩
    | add z z' hz hz' =>
      simp only [map_add, add_smul]
      exact H.add_mem hz hz'
  · apply (AddSubgroup.closure_le _).mpr
    rintro s ⟨a, t, rfl⟩
    apply AddSubgroup.subset_closure
    refine ⟨c I inferInstance (a ⊗ₜ[Γ(X, V.1)] 1), t, ?_⟩
    rw [hcalc, one_smul, LinearEquiv.symm_apply_apply]

/-- Sheaf separatedness detects a zero morphism on the affine basis.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product). -/
private theorem hom_zero_of_affine {X : Scheme.{v}} {M N : X.Modules}
    (φ : M ⟶ N) (h : ∀ V : X.affineOpens, ∀ s : Γ(M, V.1), φ.app V.1 s = 0) :
    φ = 0 := by
  apply Modules.hom_ext
  intro W
  ext s
  change φ.app W s = 0
  refine TopCat.Sheaf.eq_of_locally_eq' ⟨N.presheaf, N.isSheaf⟩
    (fun i : {V : X.affineOpens // V.1 ≤ W} ↦ i.1.1) W
    (fun i ↦ homOfLE i.2) ?_ _ _ ?_
  · intro x hx
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx W.2
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨V, hV⟩, hVW⟩, hxV⟩
  · intro i
    rw [← Modules.Hom.app_presheaf_map, map_zero]
    exact h i.1 _

/-- Factor an inclusion through a monomorphism by vanishing of its cokernel projection.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product). -/
private theorem subobject_le_of_affine_range {X : Scheme.{v}} {M N P : X.Modules}
    (i : M ⟶ P) (j : N ⟶ P) [Mono i] [Mono j]
    (h : ∀ V : X.affineOpens, Set.range (i.app V.1) ⊆ Set.range (j.app V.1)) :
    Subobject.mk i ≤ Subobject.mk j := by
  have hz : i ≫ cokernel.π j = 0 := by
    apply hom_zero_of_affine
    intro V s
    obtain ⟨t, ht⟩ := h V ⟨s, rfl⟩
    change (cokernel.π j).app V.1 (i.app V.1 s) = 0
    rw [← ht]
    exact congrArg (fun q ↦ q.app V.1 t) (cokernel.condition j)
  let k : M ⟶ Abelian.image j := kernel.lift (cokernel.π j) i hz
  let l : M ⟶ N := k ≫ inv (Abelian.factorThruImage j)
  apply Subobject.mk_le_mk_of_comm l
  change k ≫ inv (Abelian.factorThruImage j) ≫ j = i
  calc
    k ≫ inv (Abelian.factorThruImage j) ≫ j =
        k ≫ inv (Abelian.factorThruImage j) ≫
          Abelian.factorThruImage j ≫ Abelian.image.ι j :=
      congrArg (fun q ↦ k ≫ inv (Abelian.factorThruImage j) ≫ q)
        (Abelian.image.fac j).symm
    _ = k ≫ Abelian.image.ι j := by rw [IsIso.inv_hom_id_assoc]
    _ = i := kernel.lift_ι _ _ hz

/-- For an affine morphism, the extended ideal times a quasi-coherent module is
quasi-coherent, and its pushforward equals the ideal times the pushforward, as subobjects.
The upstairs multiplication uses pullback of the inclusion followed by the adjoint
structure-sheaf map; `idealModuleProduct` takes the image after tensoring with `F`.
Source: Stacks Project, Cohomology of Schemes, Lemma 01YP
(blueprint: lem-weil-pbc-affine-pushforward-ideal-product).

Proof:
1. Pullback and tensor product preserve quasi-coherence
   [lem-weil-pbc-module-pullback-quasi-coherent,
   lem-weil-pbc-quasi-coherent-tensor-product-affine-sections]. The image of the
   multiplication map between quasi-coherent modules is quasi-coherent
   [lem-weil-pbc-quasi-coherent-module-cokernel-image].
2. Over an affine `V ⊆ X`, its preimage `U` is affine. Put `A = O_X(V)`, `B = O_Y(U)`.
   The pullback-section comparison and the tensor-section comparison identify the map
   on pure tensors with `a ⊗ b ⊗ s ↦ b f♯(a) s`, by naturality of the adjunction unit
   and the characterization of the adjoint structure-sheaf map
   [lem-weil-pbc-module-pullback-affine-sections,
   lem-weil-pbc-module-pullback-structure-sheaf].
3. Pure tensors generate, so its image on `U` is `I(V) F(U)`: the factor `b` is
   absorbed into `s`, and every generator is obtained with `b = 1`.
4. An affine morphism is quasi-compact and quasi-separated, so its pushforward is
   quasi-coherent [lem-weil-pbc-affine-morphism-permanence, pqf-lem-pushforward-qcoh].
   Pushforward evaluates on the preimage; its upstairs product has sections `I(V) F(U)`.
5. For either product, the affine tensor-section comparison and image-section formula
   identify its section range with the additive subgroup generated by products. This
   computation works for any map to the structure sheaf, including the extended map;
   it uses only the tensor-product and cokernel-image nodes from Step 1.
6. Affine opens form a basis [lem-weil-pbc-affine-opens-basis]. Equality of section ranges
   implies that each inclusion composed with the other inclusion's cokernel projection
   vanishes on affines. Sheaf separatedness makes it vanish everywhere. Lift through
   the kernel, which is the abelian image, and invert the image factor of the monomorphism
   to obtain both subobject inequalities. Pushforward preserves monomorphisms, so the
   images used in the statement are the corresponding subobjects. -/
theorem affine_pushforward_ideal_product {X Y : Scheme.{v}} (f : Y ⟶ X) [IsAffineHom f]
    (F : Y.Modules) [F.IsQuasicoherent] {I : X.Modules} [I.IsQuasicoherent]
    (ι : I ⟶ SheafOfModules.unit X.ringCatSheaf) [Mono ι] :
    (idealModuleProduct
      ((Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f)
      F).IsQuasicoherent ∧
    Subobject.mk (image.ι (idealModuleProductι ι ((Modules.pushforward f).obj F))) =
      Subobject.mk (image.ι ((Modules.pushforward f).map (idealModuleProductι
        ((Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f) F))) := by
  let e : Modules.tensorPullback f ≅ Modules.pullback f :=
    Adjunction.leftAdjointUniq (Modules.nonempty_tensorPullbackAdjunction f).some
      (Modules.pullbackPushforwardAdjunction f)
  have hI : ((Modules.tensorPullback f).obj I).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent Y.ringCatSheaf).prop_of_iso (e.app I).symm
      (Modules.isQuasicoherent_pullback f I)
  have hT : ((Modules.tensorPullback f).obj I ⊗ F).IsQuasicoherent :=
    (Modules.quasiCoherent_tensor_product_affine_sections
      ((Modules.tensorPullback f).obj I) F).1
  let ψ := (((Modules.tensorPullback f).map ι ≫
    Modules.tensorPullbackObjUnitToUnit f) ▷ F ≫ (λ_ F).hom)
  have him : (Abelian.image ψ).IsQuasicoherent :=
    (Modules.quasiCoherent_cokernel_image ψ).2.2.2.2.2.2.2.1
  have hmap : (idealModuleProduct
      ((Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f)
      F).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent Y.ringCatSheaf).prop_of_iso
      (Abelian.imageIsoImage ψ) him
  have hF : ((Modules.pushforward f).obj F).IsQuasicoherent :=
    Modules.isQuasicoherent_pushforward_of_quasiCompact_quasiSeparated f F
  let i := idealModuleProductι ι ((Modules.pushforward f).obj F)
  let j := (Modules.pushforward f).map (idealModuleProductι
    ((Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f) F)
  have hi : Mono i := by dsimp [i, idealModuleProductι]; infer_instance
  have hj : Mono j := by
    have : Mono (idealModuleProductι
        ((Modules.tensorPullback f).map ι ≫ Modules.tensorPullbackObjUnitToUnit f) F) := by
      dsimp [idealModuleProductι]; infer_instance
    dsimp [j]
    exact Functor.map_mono _ _
  have hr (V : X.affineOpens) : Set.range (i.app V.1) = Set.range (j.app V.1) := by
    dsimp only [i, j]
    rw [Modules.pushforward_map_app]
    exact (product_range_affine ι ((Modules.pushforward f).obj F) V).trans
      (extended_product_range_affine f F ι V).symm
  refine ⟨hmap, ?_⟩
  change imageSubobject i = imageSubobject j
  rw [imageSubobject_mono, imageSubobject_mono]
  exact le_antisymm
    (subobject_le_of_affine_range i j (fun V ↦ (hr V).subset))
    (subobject_le_of_affine_range j i (fun V ↦ (hr V).symm.subset))

end
end AlgebraicGeometry.Scheme
