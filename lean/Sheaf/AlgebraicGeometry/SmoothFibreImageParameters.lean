/-!
# Regular parameters from the image of a smooth fibre

Source: Stacks Project, stacks-morphisms.tex, Tag 06MF, local-ring and dimension
paragraphs; algebra.tex, Tags 06LC and 02JN
(blueprint: lem-sfb-smooth-fibre-image-parameters).
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.AlgebraicSpace

/-- Functions from the base cut a smooth algebraic space to dimension zero at the
specified rational point, and their germs on an étale chart form a regular sequence.
The list `fs` has length `d`; in particular it can be empty. `J` is constrained to be
exactly the ideal sheaf generated by this list, with its full scheme structure.
The isomorphism `e` encodes the induced residue-field isomorphism κ(u) → k over S.

Source: Stacks Project, stacks-morphisms.tex, Tag 06MF, local-ring and dimension
paragraphs (blueprint: lem-sfb-smooth-fibre-image-parameters).

Proof:
1. Choose an affine neighbourhood of u and a surjective étale scheme atlas of its
   inverse image in E (def-trf-algebraic-space). Pull the atlas back to z and choose
   a point v. Its residue field is finite separable over k by
   lem-weil-pbc-etale-algebra-residue-field-separable. Smoothness makes the chart
   locally of finite type over k; on a finite type affine neighbourhood of v,
   lem-kun-closed-point-field makes v closed. Retain the full atlas.
2. Put A = O(U,u) and B = O(V,v), with the induced local map φ. By
   lem-weil-pbc-smooth-scheme-over-field-regular, B is regular local, and
   lem-trf-regular-local-regular-sequence-depth applied to the empty list gives
   depth B = dim B. By lem-weil-pbc-noetherian-local-finite-krull-dimension its
   dimension is a finite nonnegative integer d. No finiteness condition on A is used.
3. The local ring of the closed fibre chart is B/φ(m_A)B: use
   lem-weil-pbc-fibre-product-affine-spectra and def-weil-pbc-localization-at-prime.
   Chains in this local ring lie in every open neighbourhood of the fibre point.
   The dimension-zero hypothesis bounds their lengths by zero. Consequently this
   nonzero local quotient has only its maximal prime, so radical(φ(m_A)B) = m_B.
4. Apply lem-sfb-local-map-image-regular-sequence to choose d elements of m_A whose
   images are B-regular. By lem-trf-cm-regular-sequence-generator-count their quotient
   has dimension zero; locality places all the images in m_B.
5. Represent the finitely many germs by sections and shrink to an affine neighbourhood
   O of u on which they all exist (def-weil-pbc-module-stalk). Their residues vanish.
   Restrict the atlas to this open. Its local ring at v and the regular germs are
   unchanged. The sections vanish after Limits.pullback to z, because κ(u) → k is an
   isomorphism, so z lifts to the pullback of their closed zero subscheme
   (def-weil-closed-immersion). For d = 0 that subscheme is the whole open.
6. The base-changed atlas of the zero subscheme is étale. Near v it is a finite type
   affine k-scheme with local ring B/(φ(a_i)). The point remains closed there.
   By lem-weil-pbc-closed-point-dimension-local-ring its dimension at v is zero.
   Dimension on an étale chart is the dimension at the image, giving the conclusion.
-/
theorem exists_regular_parameters_of_zero_dimensional_fibre
    {S : Scheme.{u}} (k : Type u) [Field k]
    (sk : Spec (CommRingCat.of k) ⟶ S) (U : Over S) (u₀ : U.left)
    (hu₀ : IsClosed ({u₀} : Set U.left)) (E : AlgebraicSpace S)
    (q : E.obj.obj ⟶ yoneda.obj (Over.mk sk))
    (hq : ∀ (T : Over S) (a : yoneda.obj T ⟶ E.obj.obj), IsEtale a →
      Smooth (yoneda.preimage (a ≫ q)).left)
    (p : E.obj.obj ⟶ yoneda.obj U)
    (z : yoneda.obj (Over.mk sk) ⟶ E.obj.obj) (hz : z ≫ q = 𝟙 _)
    (e : Over.mk sk ≅ Over.mk (U.left.fromSpecResidueField u₀ ≫ U.hom))
    (he : z ≫ p = yoneda.map e.hom ≫ yoneda.map (Over.homMk
        (U := Over.mk (U.left.fromSpecResidueField u₀ ≫ U.hom))
        (V := U) (U.left.fromSpecResidueField u₀) rfl))
    (hdim : etaleLocalDimension
      (Limits.pullback p (yoneda.map (Over.homMk
        (U := Over.mk (U.left.fromSpecResidueField u₀ ≫ U.hom))
        (V := U) (U.left.fromSpecResidueField u₀) rfl)))
      (schemePointMap (Limits.pullback.lift (f := p) z (yoneda.map e.hom) he)
        (IsLocalRing.closedPoint k)) = 0) :
    ∃ (O : U.left.Opens) (_ : IsAffineOpen O) (hu : u₀ ∈ O)
      (fs : List Γ(O.toScheme, ⊤)) (V : Over S)
      (a : yoneda.obj V ⟶ Limits.pullback p (yoneda.map (Over.homMk
        (U := Over.mk (O.ι ≫ U.hom)) (V := U) O.ι rfl))),
      IsEtale a ∧ IsSurjective a ∧
      (∃ v : V.left,
        schemePointMap (a ≫ Limits.pullback.fst _ _) v =
          schemePointMap z (IsLocalRing.closedPoint k) ∧
        RingTheory.Sequence.IsRegular (V.left.presheaf.stalk v)
          (fs.map (fun f ↦ V.left.presheaf.germ ⊤ v trivial
            ((yoneda.preimage (a ≫ Limits.pullback.snd _ _)).left.appTop f)))) ∧
      (∀ f ∈ fs, O.toScheme.Γevaluation ⟨u₀, hu⟩ f = 0) ∧
      ∃ J : O.toScheme.IdealSheafData,
        J = Scheme.IdealSheafData.ofIdealTop (Ideal.ofList fs) ∧
        ∃ zJ : yoneda.obj (Over.mk sk) ⟶
          Limits.pullback p (yoneda.map (Over.homMk
            (U := Over.mk ((J.subschemeι ≫ O.ι) ≫ U.hom)) (V := U)
            (J.subschemeι ≫ O.ι) rfl)),
          zJ ≫ Limits.pullback.fst _ _ = z ∧
          etaleLocalDimension
            (Limits.pullback p (yoneda.map (Over.homMk
            (U := Over.mk ((J.subschemeι ≫ O.ι) ≫ U.hom)) (V := U)
            (J.subschemeι ≫ O.ι) rfl)))
            (schemePointMap zJ (IsLocalRing.closedPoint k)) = 0 := by
  sorry

end AlgebraicGeometry.AlgebraicSpace
