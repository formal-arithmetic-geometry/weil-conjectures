/-! # Geometry and global germs on a geometric strict-local base
Source: Stacks Project, Tag 0EZV, corrected all-lifts proof, steps 1--3; Tag 03PN.
-/

@[expose] public section
universe u
set_option autoImplicit false
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Etale

/-- The strict henselization base-changed to a separably closed field is affine with
closed separably closed points, and every geometric stalk is generated by global germs.
Source: Stacks Project, Tag 0EZV, finite-product presentation; Tags 09AY and 03PN.
(blueprint: lem-weil-pbc-strict-local-base-geometry).

Proof: choose an affine chart of S containing the image of s. The strict henselization
is local, so its structural map factors through that chart. Restrict pointed affine
etale neighbourhoods to the chart, a cofinal subcategory. Base change their coordinate
ring colimit to K. Every etale K-algebra is a finite product of finite separable field
extensions, hence copies of K. Thus E is affine, its coordinate ring is a filtered
colimit of finite products of K, all its primes are maximal, and all its local rings
are canonically K: at a prime, the idempotent of the selected factor kills the difference
between each represented element and its selected scalar; nonzero selected scalars
invert every denominator outside the prime. This also proves that its space is profinite.

At any geometric point of E, affine etale pointed neighbourhoods admit sections over a
smaller clopen neighbourhood. Indeed the selected fibre point is K-rational. Write the
images of finitely many algebra generators in the local ring as fractions; invert their
denominators and finitely many elements annihilating the relations. This extends the
pointed map to a principal neighbourhood, inside which one chooses a clopen. Two such
maps are equalized on a smaller clopen by the same finite-generator argument. Hence
clopen pointed neighbourhoods compute every geometric stalk. Extend a clopen section
by zero over its disjoint complement. Every stalk element is consequently the germ of
a global section, so zero global sections imply a zero sheaf by stalk conservativity.

Lean uses the ind-etale presentation and global-germ theorem for the construction.
The flat multiplication criterion then makes the ring absolutely flat, so every prime
is maximal. Ind-etale residue fields are separable over K and therefore equal to K.
Affine spectrum and residue-field isomorphisms transport these properties to E.

The empty scheme has no points and the assertion on germs is vacuous. No torsion or
finiteness hypothesis on a sheaf is used. -/
theorem strictLocalBase_geometry
    {S : Scheme.{u}} {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (s : Spec (.of Ω) ⟶ S) (K : Type u) [Field K] [IsSepClosed K]
    (u : Spec (.of K) ⟶ Scheme.strictHenselizationScheme s) :
    let E := pullback (Scheme.strictHenselizationStructuralMap s)
      (u ≫ Scheme.strictHenselizationStructuralMap s)
    IsAffine E ∧ (∀ e : E, IsClosed ({e} : Set E)) ∧
      (∀ e : E, IsSepClosed (E.residueField e)) ∧
      ∀ (F : Sheaf E.smallEtaleTopology AddCommGrpCat.{u + 1}) (e : E),
        Function.Surjective
          ((Scheme.pointSmallEtale (E.algClosurePoint e)).toPresheafFiber
            (Scheme.Etale.mk (𝟙 E))
            (Over.homMk (E.algClosurePoint e) (Category.comp_id _)) F.obj) := by
  have haffine := strictLocalBase_isAffine s K u
  have hind := strictLocalBase_indEtale s K u
  have hgerms := strictLocalBase_globalGerms s K u
  let E := pullback (Scheme.strictHenselizationStructuralMap s)
    (u ≫ Scheme.strictHenselizationStructuralMap s)
  let a := pullback.snd (Scheme.strictHenselizationStructuralMap s)
    (u ≫ Scheme.strictHenselizationStructuralMap s)
  let α : K →+* Γ(E, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop).hom
  let : IsAffine E := haffine
  let : Algebra K Γ(E, ⊤) := α.toAlgebra
  have : Algebra.IndEtale K Γ(E, ⊤) :=
    (RingHom.IndEtale.algebraMap_iff K Γ(E, ⊤)).mp hind
  have : Algebra.WeaklyEtale K Γ(E, ⊤) := inferInstance
  have : Ring.AbsolutelyFlat Γ(E, ⊤) :=
    Ring.AbsolutelyFlat.of_flat_lmul' K Γ(E, ⊤)
      (Algebra.WeaklyEtale.flat_lmul' K Γ(E, ⊤))
  have hflat := ((Ring.AbsolutelyFlat.tfae Γ(E, ⊤)).out 0 1).mp
    (inferInstance : Ring.AbsolutelyFlat Γ(E, ⊤))
  let e := E.isoSpec
  refine ⟨haffine, ?_, ?_, hgerms⟩
  · intro z
    have hc : IsClosed ({e.hom z} : Set (Spec Γ(E, ⊤))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
        (hflat.2 (e.hom z).asIdeal (e.hom z).isPrime)
    have he := (TopCat.homeoOfIso (Scheme.forgetToTop.mapIso e)).isClosed_preimage.mpr hc
    have heq : (TopCat.homeoOfIso (Scheme.forgetToTop.mapIso e)) ⁻¹'
        {e.hom z} = {z} := by
      ext y
      change e.hom y = e.hom z ↔ y = z
      exact (TopCat.homeoOfIso (Scheme.forgetToTop.mapIso e)).injective.eq_iff
    exact heq ▸ he
  · intro z
    have : Algebra.IsSeparable K (e.hom z).asIdeal.ResidueField :=
      Algebra.IndEtale.isSeparable_residueField_of_field (e.hom z).asIdeal
    have : IsSepClosed (e.hom z).asIdeal.ResidueField :=
      IsSepClosed.of_ringEquiv
        (RingEquiv.ofBijective (algebraMap K (e.hom z).asIdeal.ResidueField)
          (IsSepClosed.algebraMap_bijective K (e.hom z).asIdeal.ResidueField))
    have : IsSepClosed ((Spec Γ(E, ⊤)).residueField (e.hom z)) :=
      IsSepClosed.of_ringEquiv
        (Scheme.Spec.residueFieldIso Γ(E, ⊤) (e.hom z)).symm.commRingCatIsoToRingEquiv
    exact IsSepClosed.of_ringEquiv (asIso (e.hom.residueFieldMap z)).commRingCatIsoToRingEquiv

end AlgebraicGeometry.Etale
