/-!
# Compatible equivariant charts for log smooth morphisms

Source: ILO, Expose X Proposition 1.2, first and last assertions, printed pp.136--139
(blueprint: lem-per-equivariant-log-smooth-chart).

Characters are curried pairings into the subgroup generated by the chosen root of unity.
This is the universal-property presentation of a map from the tensor product with the
abelianization. Comparison targets are specified by their cartesian square and their
monomial chart; thus their log structures and actions are the prescribed ones.
-/

noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.LogSmoothPreparation

/-- Triviality on the characteristic stalk, expressed on representatives on every
pointed relative etale diagram. This is the action induced by the given log morphism,
not a separately chosen action on the stalk. Source: ILO X 1.2
(blueprint: lem-per-equivariant-log-smooth-chart). -/
def FixesCharacteristic {G : Type v} [Group G] {X : FineSaturatedLogScheme.{u}}
    (a : FSLogGroupAction G X) {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (x : Spec (.of Ω) ⟶ X.scheme) : Prop :=
  ∀ (g : G) (U V : X.scheme.Etale)
    (s : (Scheme.pointSmallEtale x).fiber.obj U)
    (t : (Scheme.pointSmallEtale x).fiber.obj V)
    (k : V.left ⟶ U.left) (hk : k ≫ U.hom = V.hom ≫ (a.logMap g).base),
    t.left ≫ k = s.left → ∀ m : X.logStructure.monoidSheaf.obj.obj (op U),
      Associates.mk (X.logStructure.toEtalePrelogStructure.germ x V t
        ((a.logMap g).sectionMap U V k hk m)) =
      Associates.mk (X.logStructure.toEtalePrelogStructure.germ x U s m)

/-- Multiplication by a coefficient unit in a log sheaf. The unit is identified by
its actual structural image; the log axiom uniquely determines it. This avoids assuming
an unrelated scalar action on the monoid sheaf. Source: ILO VI 1.1, X 1.2
(blueprint: lem-per-equivariant-log-smooth-chart). -/
def UnitMultiple {X : Scheme.{u}} (M : EtaleLogStructure X) (W : X.Etale)
    {Λ : Type u} [CommRing Λ] (c : Λ →+* Γ(W.left, ⊤)) (z : Λˣ)
    (s t : M.monoidSheaf.obj.obj (op W)) : Prop :=
  ∃ e : (M.monoidSheaf.obj.obj (op W))ˣ,
    M.alpha.app (op W) (e : M.monoidSheaf.obj.obj (op W)) = c (z : Λ) ∧
      t = (e : M.monoidSheaf.obj.obj (op W)) * s

/-- The action on global log sections, using the existing relative-test map of the
log automorphism. Source: ILO X 1.2
(blueprint: lem-per-equivariant-log-smooth-chart). -/
def globalLogAction {G : Type v} [Group G] {X : FineSaturatedLogScheme.{u}}
    (a : FSLogGroupAction G X) (g : G) :
    X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))) →*
      X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))) :=
  (a.logMap g).sectionMap (Scheme.Etale.mk (𝟙 X.scheme))
    (Scheme.Etale.mk (𝟙 X.scheme)) (a.logMap g).base (by
      change (a.logMap g).base ≫ 𝟙 X.scheme = 𝟙 X.scheme ≫ (a.logMap g).base
      exact (Category.comp_id _).trans (Category.id_comp _).symm)

/-- Global log pullback, the terminal-test component of the recorded log morphism.
Source: ILO VI 1.1, X 1.2 (blueprint: lem-per-equivariant-log-smooth-chart). -/
def globalLogPullback {X B : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X B) :
    B.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 B.scheme))) →*
      X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))) :=
  f.sectionMap (Scheme.Etale.mk (𝟙 B.scheme)) (Scheme.Etale.mk (𝟙 X.scheme))
    f.base (by
      change f.base ≫ 𝟙 B.scheme = 𝟙 X.scheme ≫ f.base
      exact (Category.comp_id _).trans (Category.id_comp _).symm)

/-- The conclusion data of ILO's compatible equivariant chart. The target is the
cartesian base change of the coefficient-valued monoid spectrum. Its chart, comparison
map and action are normalized on monomials, retaining the canonical construction.
Source: ILO X 1.2, pp.136--139
(blueprint: lem-per-equivariant-log-smooth-chart). -/
structure Chart {G : Type v} [Group G] {X B : FineSaturatedLogScheme.{u}}
    (f : EtaleLogHom X B) (aX : FSLogGroupAction G X) (aB : FSLogGroupAction G B)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme)
    (Λ : Type u) [CommRing Λ] (ζ : Λˣ) (cB : Λ →+* Γ(B.scheme, ⊤))
    (Q : Type u) [CommMonoid Q]
    (a : Q →* B.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 B.scheme))))
    (χQ : G →* (Algebra.GrothendieckGroup Q →* Subgroup.zpowers ζ)) where
  W : FineSaturatedLogScheme.{u}
  inclusion : EtaleLogHom W X
  etale : Etale inclusion.base
  restriction : inclusion.IsStrict
  point : Spec (.of Ω) ⟶ W.scheme
  point_over : point ≫ inclusion.base = x
  action : FSLogGroupAction G W
  equivariant_inclusion : action.IsEquivariant aX inclusion
  point_fixed : ∀ g : G, point ≫ (action.baseAction g).hom = point
  toBase : EtaleLogHom W B
  over : inclusion.CompEq f toBase
  equivariant_base : action.IsEquivariant aB toBase
  P : Type u
  instP : CommMonoid P
  fs : @IsFineSaturatedMonoid P instP
  units_torsionFree : @IsMulTorsionFree Pˣ _
  gamma : Q →* P
  b : P →* W.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 W.scheme)))
  isChart : W.logStructure.IsChart (Scheme.Etale.mk (𝟙 W.scheme)) b
  compatible : b.comp gamma = (globalLogPullback toBase).comp a
  character : G →* (Algebra.GrothendieckGroup P →* Subgroup.zpowers ζ)
  extends_character : ∀ (g : G) (q : Q),
    character g (Algebra.GrothendieckGroup.of (gamma q)) =
      χQ g (Algebra.GrothendieckGroup.of q)
  eigenvectors : ∀ (g : G) (p : P),
    UnitMultiple W.logStructure (Scheme.Etale.mk (𝟙 W.scheme))
      (toBase.base.appTop.hom.comp cB)
      (character g (Algebra.GrothendieckGroup.of p)).val (b p)
      (globalLogAction action g (b p))
  injective : Function.Injective
    (Algebra.GrothendieckGroup.lift ((Algebra.GrothendieckGroup.of (M := P)).comp gamma))
  finite_torsion : Finite (CommGroup.torsion
    (Algebra.GrothendieckGroup P ⧸
      (Algebra.GrothendieckGroup.lift
        ((Algebra.GrothendieckGroup.of (M := P)).comp gamma)).range))
  invertible_torsion : ∀ w : W.scheme,
    IsUnit (Nat.card (CommGroup.torsion
      (Algebra.GrothendieckGroup P ⧸
        (Algebra.GrothendieckGroup.lift
          ((Algebra.GrothendieckGroup.of (M := P)).comp gamma)).range)) :
      W.scheme.presheaf.stalk w)
  target : FineSaturatedLogScheme.{u}
  targetToBase : EtaleLogHom target B
  targetToMonoid : target.scheme ⟶ Spec (.of (MonoidAlgebra Λ P))
  cartesian : IsPullback targetToBase.base targetToMonoid
    ((ΓSpec.adjunction.homEquiv B.scheme (op (.of (MonoidAlgebra Λ Q))))
      (CommRingCat.ofHom (MonoidAlgebra.liftNCRingHom cB
        ((B.logStructure.alpha.app (op (Scheme.Etale.mk (𝟙 B.scheme)))).hom.comp a)
        (fun _ _ ↦ Commute.all _ _))).op)
    (Spec.map (CommRingCat.ofHom (MonoidAlgebra.mapDomainRingHom Λ gamma)))
  targetChart : P →*
    target.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 target.scheme)))
  target_isChart : target.logStructure.IsChart (Scheme.Etale.mk (𝟙 target.scheme)) targetChart
  target_monomials : ∀ p : P,
    target.logStructure.alpha.app (op (Scheme.Etale.mk (𝟙 target.scheme))) (targetChart p) =
      targetToMonoid.appTop ((Scheme.ΓSpecIso (.of (MonoidAlgebra Λ P))).inv
        (MonoidAlgebra.single p 1))
  target_compatible : targetChart.comp gamma = (globalLogPullback targetToBase).comp a
  comparison : EtaleLogHom W target
  comparison_over : comparison.CompEq targetToBase toBase
  comparison_chart : (globalLogPullback comparison).comp targetChart = b
  comparison_monomials : comparison.base ≫ targetToMonoid =
    (ΓSpec.adjunction.homEquiv W.scheme (op (.of (MonoidAlgebra Λ P))))
      (CommRingCat.ofHom (MonoidAlgebra.liftNCRingHom
        (toBase.base.appTop.hom.comp cB)
        ((W.logStructure.alpha.app (op (Scheme.Etale.mk (𝟙 W.scheme)))).hom.comp b)
        (fun _ _ ↦ Commute.all _ _))).op
  strict : comparison.IsStrict
  smooth : Smooth comparison.base
  targetAction : FSLogGroupAction G target
  equivariant : action.IsEquivariant targetAction comparison
  target_base_equivariant : targetAction.IsEquivariant aB targetToBase
  monoidAction : G →* Aut (Spec (.of (MonoidAlgebra Λ P)))
  target_monoid_equivariant : ∀ g : G,
    (targetAction.baseAction g).hom ≫ targetToMonoid =
      targetToMonoid ≫ (monoidAction g).hom
  model_monomials : ∀ (g : G) (p : P) (r : Λ),
    (monoidAction g).hom.appTop
      ((Scheme.ΓSpecIso (.of (MonoidAlgebra Λ P))).inv (MonoidAlgebra.single p r)) =
    (Scheme.ΓSpecIso (.of (MonoidAlgebra Λ P))).inv
      (MonoidAlgebra.single p ((character g (Algebra.GrothendieckGroup.of p)).val.val * r))

attribute [instance] Chart.instP

/-- Compatible equivariant fs charts with torsion-free units and smooth strict comparison.
Source: ILO, Expose X Proposition 1.2, first and last assertions, pp.136--139
(blueprint: lem-per-equivariant-log-smooth-chart).

Proof:
1. Put S = Mbar_x, C = S^gp and D = C / im Q^gp. The sharp-chart theorem
   lem-per-very-tame-equivariant-sharp-chart and lem-trf-sharp-cone-lattice-intersection
   make C and Q^gp finite free. Choose classes giving a basis of k tensor D using
   lem-per-log-cotangent-characteristic-quotient.
2. Lift these classes using the equivariant sharp chart. Their eigencharacters take
   values in the chosen roots by lem-sbc-strict-local-roots-of-unity.
3. Extend the resulting map Z^r + Q^gp to a finite free lattice F surjecting onto C
   with finite invertible-order cokernel, by lem-per-divisible-unit-lattice-extension.
4. For any lattice element the ratio g(v(a))/v(a) is a unit whose mN-th power is one.
   Injectivity of reduction on these roots makes it inertia fixed; the cocycle identity
   makes it a character with values in mu_N, extending the prescribed base character.
5. Set P = inverse image of S in F. A splitting F = K + C identifies P with K + S.
   The subgroup-freeness lemma lem-weil-subgroup-finite-free-abelian-group-free shows
   that P is fs and its units K are torsion free.
6. The pushout of P with ring units is the log stalk: surjectivity follows from P -> S,
   and equality is exactly the unit pushout congruence. Q^gp injects in F; its cokernel
   torsion embeds in F/(Z^r + Q^gp), so its finite order is invertible.
7. Spread the specified stalk chart using lem-trf-fine-log-stalk-chart-spreading.
   Products of all translates make the pointed etale neighbourhood equivariant.
   The cofiltered stalk description from def-weil-pbc-etale-site and
   def-weil-pbc-geometric-stalks spreads the finite compatibility equations.
8. Form the canonical coefficient-monoid cartesian square, with its monomial log
   structure. The comparison is strict by lem-trf-associated-log-universal-stalks.
   Restrict to the invariant open where the torsion annihilator is invertible; the
   target is log smooth by def-per-fs-log-smooth-etale.
9. Compute its relative log differentials as O tensor (F/Q^gp). At the point its
   differential map sends the chosen basis to the dlog classes, whose projection is
   the basis of k tensor D. Thus this map is injective.
10. Apply lem-per-strict-log-jacobian-criterion and intersect the translates of its
    smoothness open. The restricted chart has every stated property. -/
theorem exists_equivariant_logSmooth_chart
    {X B : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X B) (hf : f.IsLogSmooth)
    (G : Type v) [Group G] [Finite G]
    (aX : FSLogGroupAction G X) (aB : FSLogGroupAction G B)
    (hequivariant : aX.IsEquivariant aB f)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme)
    (hfixed : ∀ g : G, x ≫ (aX.baseAction g).hom = x)
    (horder : IsUnit (Nat.card G : B.scheme.presheaf.stalk ((x ≫ f.base) default)))
    (hX : FixesCharacteristic aX x) (hB : FixesCharacteristic aB (x ≫ f.base))
    (N : ℕ) (hN : 0 < N) (hexponent : ∀ g : G, g ^ N = 1)
    (Λ : Type u) [CommRing Λ] [Algebra (CyclotomicRing N ℤ ℚ) Λ]
    (S : Submonoid (CyclotomicRing N ℤ ℚ)) [IsLocalization S Λ]
    (hinvertN : (N : CyclotomicRing N ℤ ℚ) ∈ S)
    (ζ : Λˣ) (hζ : IsPrimitiveRoot (ζ : Λ) N)
    (cB : Λ →+* Γ(B.scheme, ⊤))
    (hcoefficients : ∀ (g : G) (r : Λ), (aB.logMap g).base.appTop (cB r) = cB r)
    (Q : Type u) [CommMonoid Q] (hQ : IsFineSaturatedMonoid Q)
    (hsharp : ∀ q : Q, IsUnit q → q = 1)
    (a : Q →* B.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 B.scheme))))
    (ha : B.logStructure.IsChart (Scheme.Etale.mk (𝟙 B.scheme)) a)
    (χQ : G →* (Algebra.GrothendieckGroup Q →* Subgroup.zpowers ζ))
    (heigen : ∀ (g : G) (q : Q),
      UnitMultiple B.logStructure (Scheme.Etale.mk (𝟙 B.scheme)) cB
        (χQ g (Algebra.GrothendieckGroup.of q)).val (a q) (globalLogAction aB g (a q))) :
    Nonempty (Chart f aX aB x Λ ζ cB Q a χQ) := by
  sorry

end AlgebraicGeometry.LogSmoothPreparation
