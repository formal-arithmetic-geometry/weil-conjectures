module

public import Sheaf.AlgebraicGeometry.AdicPrincipalChartData
public import Mathlib.Geometry.RingedSpace.PresheafedSpace.Gluing

/-! # Topological formal spaces and open descent data

Source: Stacks Project, Tags 0AHY and 01JA, locally topologically ringed spaces,
formal spectra and open gluing (blueprint: def-per-topological-formal-open-data).

The underlying ringed spaces and formal spectra are the recorded constructions.
Section topologies, continuous local maps and ideal subsheaves retain the extra data
needed for formal open descent. Coherent ideals are locally generated by finitely many
sections, equivalently completed-localization ideals on Noetherian formal affine charts.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry.FormalOpen

/-- Section topologies on the existing structure sheaf. Source: Stacks Tag 0AHY
(blueprint: def-per-topological-formal-open-data). -/
def SectionTopology (X : RingedSpace.{u}) :=
  ∀ U : Opens X, TopologicalSpace (X.presheaf.obj (op U))

/-- The topological sheaf axiom includes the topology induced by all cover restrictions.
Source: Stacks Tag 0AHY (blueprint: def-per-topological-formal-open-data). -/
def IsTopologicalSheaf (X : RingedSpace.{u}) (τ : SectionTopology X) : Prop :=
  (∀ U : Opens X, @IsTopologicalRing _ (τ U) _) ∧
    (∀ (U V : Opens X) (h : V ≤ U),
      @Continuous _ _ (τ U) (τ V) (X.presheaf.map (homOfLE h).op)) ∧
    ∀ (ι : Type u) (W : Opens X) (U : ι → Opens X) (h : ∀ i, U i ≤ W),
      (⨆ i, U i) = W → τ W = ⨅ i, TopologicalSpace.induced
        (X.presheaf.map (homOfLE (h i)).op) (τ (U i))

/-- Continuous local morphisms, with no chosen ideal of definition required to be preserved.
Source: Stacks Tag 0AHY (blueprint: def-per-topological-formal-open-data). -/
def IsMorphism {X Y : RingedSpace.{u}} (τX : SectionTopology X)
    (τY : SectionTopology Y) (f : X ⟶ Y) : Prop :=
  (∀ x : X, IsLocalHom (f.hom.stalkMap x).hom) ∧
    ∀ U : Opens Y, @Continuous _ _ (τY U) (τX ((Opens.map f.hom.base).obj U))
      (f.hom.c.app (op U))

/-- A formal open immersion identifies section rings homeomorphically on opens in its image.
Source: Stacks Tags 0AHY, 01JA (blueprint: def-per-topological-formal-open-data). -/
def IsOpenMorphism {X Y : RingedSpace.{u}} (τX : SectionTopology X)
    (τY : SectionTopology Y) (f : X ⟶ Y) : Prop :=
  SheafedSpace.IsOpenImmersion f ∧ IsMorphism τX τY f ∧
    ∀ U : Opens Y, (U : Set Y) ⊆ Set.range f.hom.base →
      @IsHomeomorph _ _ (τY U) (τX ((Opens.map f.hom.base).obj U))
        (f.hom.c.app (op U))

/-- Adic formal spaces are locally formal spectra with their inverse-limit section topologies.
No finiteness or Noetherian condition is imposed on a target of formal morphisms.
Source: Stacks Tag 0AHY (blueprint: def-per-topological-formal-open-data). -/
def IsAdic (X : RingedSpace.{u}) (τ : SectionTopology X) : Prop :=
  IsTopologicalSheaf X τ ∧ (∀ x : X, IsLocalRing (X.presheaf.stalk x)) ∧
    ∀ x : X, ∃ (R : CommRingCat.{u}) (K : Ideal R), IsAdicComplete K R ∧
      ∃ (c : adicFormalSpec R K ⟶ X) (y : adicFormalSpec R K),
        IsOpenMorphism (adicFormalSectionTopology R K) τ c ∧ c.hom.base y = x

/-- The finite-cover Noetherian convention of the item, using the recorded predicate.
Source: Stacks Tag 0AHY and the item's finite-cover convention
(blueprint: def-per-topological-formal-open-data). -/
def IsNoetherian (X : RingedSpace.{u}) (τ : SectionTopology X) : Prop :=
  IsAdic X τ ∧ IsNoetherianAdicFormalScheme X ∧
    ∀ x : X, ∃ (R : CommRingCat.{u}) (K : Ideal R),
      IsNoetherianRing R ∧ K.FG ∧ IsAdicComplete K R ∧
        ∃ (c : adicFormalSpec R K ⟶ X) (y : adicFormalSpec R K),
          IsOpenMorphism (adicFormalSectionTopology R K) τ c ∧ c.hom.base y = x

/-- Actual ideal subsheaves: membership is stable under restriction and local on opens.
Source: Stacks Tag 00AL (blueprint: def-per-topological-formal-open-data). -/
structure IdealSheaf (X : RingedSpace.{u}) where
  ideal : ∀ U : Opens X, Ideal (X.presheaf.obj (op U))
  restriction : ∀ (U V : Opens X) (h : V ≤ U) (s : X.presheaf.obj (op U)),
    s ∈ ideal U → X.presheaf.map (homOfLE h).op s ∈ ideal V
  locality : ∀ (ι : Type u) (W : Opens X) (U : ι → Opens X) (h : ∀ i, U i ≤ W),
    (⨆ i, U i) = W → ∀ s : X.presheaf.obj (op W),
      (∀ i, X.presheaf.map (homOfLE (h i)).op s ∈ ideal (U i)) → s ∈ ideal W

/-- The stalk ideal, computed from all neighborhood section ideals.
Source: Stacks Tag 00AL (blueprint: def-per-topological-formal-open-data). -/
def IdealSheaf.stalk {X : RingedSpace.{u}} (I : IdealSheaf X) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  ⨆ (U : Opens X) (hx : x ∈ U), (I.ideal U).map (X.presheaf.germ U x hx).hom

/-- Coherence in the Noetherian formal setting: locally a finite set of sections generates
all stalk ideals. This is the completed-localization convention, not finite generation
of sections on every nonaffine open. Source: Stacks Tag 0AHY
(blueprint: def-per-topological-formal-open-data). -/
def IdealSheaf.IsCoherent {X : RingedSpace.{u}} (I : IdealSheaf X) : Prop :=
  ∀ x : X, ∃ (U : Opens X) (_ : x ∈ U) (n : ℕ)
    (s : Fin n → X.presheaf.obj (op U)),
    ∀ (y : X) (hy : y ∈ U),
      I.stalk y = Ideal.span (Set.range (fun i ↦ X.presheaf.germ U y hy (s i)))

/-- Openness is local on formal affine charts; no exponent on an arbitrary open is demanded.
Source: Stacks Tag 0AHY (blueprint: def-per-topological-formal-open-data). -/
def IdealSheaf.IsOpen {X : RingedSpace.{u}} (τ : SectionTopology X)
    (I : IdealSheaf X) : Prop :=
  ∀ x : X, ∃ (U : Opens X), x ∈ U ∧ IsAdicFormalAffineOpen X U ∧
    @_root_.IsOpen _ (τ U) (I.ideal U : Set (X.presheaf.obj (op U)))

/-- An ideal of definition is locally an open ideal whose powers define the section topology.
Source: Stacks Tag 0AHY (blueprint: def-per-topological-formal-open-data). -/
def IdealSheaf.IsDefinition {X : RingedSpace.{u}} (τ : SectionTopology X)
    (I : IdealSheaf X) : Prop :=
  I.IsCoherent ∧ ∀ x : X, ∃ U : Opens X, x ∈ U ∧ IsAdicFormalAffineOpen X U ∧
    @_root_.IsOpen _ (τ U) (I.ideal U : Set (X.presheaf.obj (op U))) ∧
      τ U = (I.ideal U).adicTopology

/-- Extension of ideals along a morphism, stated as equality of actual stalk ideals.
Source: Stacks Tags 00AL, 0AHY (blueprint: def-per-topological-formal-open-data). -/
def PullsBack {X Y : RingedSpace.{u}} (I : IdealSheaf Y) (J : IdealSheaf X)
    (f : X ⟶ Y) : Prop :=
  ∀ x : X, (I.stalk (f.hom.base x)).map (f.hom.stalkMap x).hom = J.stalk x

/-- Agreement of two ideals on a common source, independent of a choice of overlap coordinates.
Source: Stacks Tag 00AL (blueprint: def-per-topological-formal-open-data). -/
def SamePullback {X Y Z : RingedSpace.{u}} (I : IdealSheaf X) (J : IdealSheaf Y)
    (a : Z ⟶ X) (b : Z ⟶ Y) : Prop :=
  ∀ z : Z, (I.stalk (a.hom.base z)).map (a.hom.stalkMap z).hom =
    (J.stalk (b.hom.base z)).map (b.hom.stalkMap z).hom

/-- Open covers by formal morphisms, allowing arbitrary overlaps and the empty index type.
Source: Stacks Tag 01JA (blueprint: def-per-topological-formal-open-data). -/
def IsCover {ι : Type u} {X : RingedSpace.{u}} (τ : SectionTopology X)
    (Y : ι → RingedSpace.{u}) (σ : ∀ i, SectionTopology (Y i))
    (v : ∀ i, Y i ⟶ X) : Prop :=
  (∀ i, IsOpenMorphism (σ i) τ (v i)) ∧
    ∀ x : X, ∃ (i : ι) (y : Y i), (v i).hom.base y = x

/-- Morphism compatibility on overlaps, expressed by all common maps so that no pullback
choice enters the interface. Source: Stacks Tag 01JA
(blueprint: def-per-topological-formal-open-data). -/
def CompatibleMaps {ι : Type u} {X Z : RingedSpace.{u}} (Y : ι → RingedSpace.{u})
    (v : ∀ i, Y i ⟶ X) (f : ∀ i, Y i ⟶ Z) : Prop :=
  ∀ (i j : ι) (W : RingedSpace.{u}) (a : W ⟶ Y i) (b : W ⟶ Y j),
    a ≫ v i = b ≫ v j → a ≫ f i = b ≫ f j

/-- Ideal compatibility on overlaps. Source: Stacks Tag 00AL
(blueprint: def-per-topological-formal-open-data). -/
def CompatibleIdeals {ι : Type u} {X : RingedSpace.{u}} (Y : ι → RingedSpace.{u})
    (v : ∀ i, Y i ⟶ X) (I : ∀ i, IdealSheaf (Y i)) : Prop :=
  ∀ (i j : ι) (W : RingedSpace.{u}) (a : W ⟶ Y i) (b : W ⟶ Y j),
    a ≫ v i = b ≫ v j → SamePullback (I i) (I j) a b

/-- Morphism and ideal descent for a particular open cover, including local equality.
Source: Stacks Tags 01JA, 00AL, 0AHY
(blueprint: def-per-topological-formal-open-data). -/
def CoverDescent {ι : Type u} {X : RingedSpace.{u}} (τ : SectionTopology X)
    (Y : ι → RingedSpace.{u}) (σ : ∀ i, SectionTopology (Y i))
    (v : ∀ i, Y i ⟶ X) : Prop :=
  (∀ (Z : RingedSpace.{u}) (ρ : SectionTopology Z), IsAdic Z ρ →
    ∀ f : ∀ i, Y i ⟶ Z, (∀ i, IsMorphism (σ i) ρ (f i)) →
      CompatibleMaps Y v f → ∃! g : X ⟶ Z,
        IsMorphism τ ρ g ∧ ∀ i, v i ≫ g = f i) ∧
  (∀ (Z : RingedSpace.{u}) (ρ : SectionTopology Z) (f g : X ⟶ Z),
    IsAdic Z ρ → IsMorphism τ ρ f → IsMorphism τ ρ g →
      (∀ i, v i ≫ f = v i ≫ g) → f = g) ∧
  ∀ I : ∀ i, IdealSheaf (Y i), (∀ i, (I i).IsCoherent) → CompatibleIdeals Y v I →
    ∃! J : IdealSheaf X, J.IsCoherent ∧ (∀ i, PullsBack J (I i) (v i)) ∧
      ((∀ i, (I i).IsDefinition (σ i)) → J.IsDefinition τ) ∧
      ((∀ i, (I i).IsOpen (σ i)) → J.IsOpen τ)

/-- Descent on every restricted open and every cover of it. Thus further refinement uses the
same objects, maps and ideals, determined uniquely by their restrictions.
Source: Stacks Tags 01JA, 00AL (blueprint: def-per-topological-formal-open-data). -/
def StableDescent (X : RingedSpace.{u}) (τ : SectionTopology X) : Prop :=
  ∀ (W : RingedSpace.{u}) (ρ : SectionTopology W) (w : W ⟶ X),
    IsOpenMorphism ρ τ w →
      IsNoetherian W ρ ∧ ∀ (ι : Type u) (Y : ι → RingedSpace.{u})
        (σ : ∀ i, SectionTopology (Y i)) (v : ∀ i, Y i ⟶ W),
        IsCover ρ Y σ v → CoverDescent ρ Y σ v

/-- Topological enhancements of the standard ringed-space gluing datum. The categorical
cocycle includes the diagonal, inverse and triple-overlap identities; the open maps permit
nonaffine overlaps. Source: Stacks Tags 01JA, 0AHY
(blueprint: def-per-topological-formal-open-data). -/
structure GlueData where
  data : SheafedSpace.GlueData.{u, u + 1} CommRingCat.{u}
  pieceTopology : ∀ i : data.J, SectionTopology (data.U i)
  overlapTopology : ∀ i j : data.J, SectionTopology (data.V (i, j))
  finite : Finite data.J
  noetherian : ∀ i, IsNoetherian (data.U i) (pieceTopology i)
  openMap : ∀ i j, IsOpenMorphism (overlapTopology i j) (pieceTopology i) (data.f i j)
  transition : ∀ i j, IsMorphism (overlapTopology i j) (overlapTopology j i) (data.t i j)

/-- A realization has precisely the prescribed overlaps and transition maps.
Source: Stacks Tag 01JA (blueprint: def-per-topological-formal-open-data). -/
def Realizes (D : GlueData.{u}) (X : RingedSpace.{u}) (τ : SectionTopology X)
    (v : ∀ i : D.data.J, D.data.U i ⟶ X) : Prop :=
  IsNoetherian X τ ∧ IsCover τ D.data.U D.pieceTopology v ∧
    (∀ i j, D.data.f i j ≫ v i = D.data.t i j ≫ D.data.f j i ≫ v j) ∧
      ∀ i j, IsPullback (D.data.f i j) (D.data.t i j ≫ D.data.f j i) (v i) (v j)

end AlgebraicGeometry.FormalOpen
