/-! # Graded sheaf data for powers of an extended ideal

Source: Stacks Project, Cohomology of Schemes, Lemma 02O8 and its preceding paragraph
(blueprint: lem-weil-pbc-ideal-powers-rees-graded-data).
-/

@[expose] public section

set_option autoImplicit false
universe v
open CategoryTheory Opposite
namespace AlgebraicGeometry

/-- The powers of an extended ideal times a coherent module form a quasi-coherent graded
sheaf, locally generated in degree zero over the Rees algebra.

Source: Stacks Project, coherent.tex, Lemma 02O8 (lemma-cohomology-powers-ideal-times-F),
proof and preceding paragraph (lines 5330--5400).
(blueprint: lem-weil-pbc-ideal-powers-rees-graded-data).

Proof: A proper scheme over a Noetherian affine base is Noetherian, so coherence implies
quasi-coherence and finite type. On every affine open U, pullback of the base ideal has
sections generated by the images of I. The ideal-product and power calculations identify
G_m(U) with I^m F(U), including G_0 = F. A homogeneous Rees polynomial b of degree k is
its coefficient a times t^k, with a in I^k. Multiplication by the image of a takes
I^m F(U) into I^(m+k) F(U): expand a section as a sum of a_j u_j and use a a_j in I^(m+k).
These maps agree on overlaps and glue; membership in the subsheaf is checked on an affine
cover. The inclusions are monomorphisms, so additivity, composition, and the degree-zero
scalar identity follow from the corresponding identities in F. Quasi-coherence of all
G_m follows from the affine product calculation. Choose a finite local generating family
s_i of F, all in degree zero. Near any point a section of G_m is a sum a_j u_j; shrink
to express the finitely many u_j as sums c_ij s_i. The original section becomes a sum
c_ij mu_(a_j t^m)(s_i). This is exactly the displayed local span condition. The empty
scheme imposes no local condition and the zero module needs no generators. For the zero
ideal all positive degrees vanish, while degree zero still uses generators of F and
I^0 = A. For the unit ideal all powers equal O_X, with the same generators in degree zero.
-/
theorem idealPowersReesGradedData {A : Type v} [CommRing A] [IsNoetherianRing A]
    {X : Scheme.{v}} (f : X ⟶ Spec (CommRingCat.of A)) [IsProper f]
    (I : Ideal A) (J : X.IdealSheafData)
    (hJ : J = (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f)
    (F : X.Modules) (hF : RingedSpace.IsCoherent X.toRingedSpace F) :
    let G := fun m ↦ Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F
    let graded := reesGrading I
    ∃ mu : ∀ (m k : ℕ), graded k → (G m ⟶ G (m + k)),
      (∀ (m k : ℕ) (b : graded k) (U : X.Opens) (s : (G m).val.obj (op U)),
        ((Scheme.idealModuleProductι (Scheme.idealSheafPower J.toModulesι (m + k)).2 F).app
          U).hom ((mu m k b).app U s) =
        (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f.appLE ⊤ U le_top).hom
          (b.val.val.coeff k)) •
        ((Scheme.idealModuleProductι (Scheme.idealSheafPower J.toModulesι m).2 F).app
          U).hom s) ∧
      (∀ m : ℕ, (G m).IsQuasicoherent) ∧
      (∀ (m k : ℕ) (b b' : graded k), mu m k (b + b') = mu m k b + mu m k b') ∧
      (∀ (m k l : ℕ) (b : graded k) (b' : graded l),
        HEq (mu m l b' ≫ mu (m + l) k b)
          (mu m (k + l) ⟨b.val * b'.val,
            SetLike.mul_mem_graded b.property b'.property⟩)) ∧
      (∀ (m : ℕ) (a : A) (U : X.Opens) (t : (G m).val.obj (op U)),
        HEq ((mu m 0 ⟨algebraMap A (reesAlgebra I) a,
          algebraMap_mem_reesGrading_zero I a⟩).val.app (op U) t)
          ((X.presheaf.map (homOfLE (le_top (a := U))).op).hom
            (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a) • t)) ∧
      (∀ x : X, ∃ (U : X.Opens), x ∈ U ∧
      ∃ (r : ℕ) (d : Fin r → ℕ) (s : ∀ i : Fin r, (G (d i)).val.obj (op U)),
        ∀ (m : ℕ) (V : X.Opens) (hVU : V ≤ U) (t : (G m).val.obj (op V))
          (y : X), y ∈ V → ∃ (W : X.Opens) (hWV : W ≤ V), y ∈ W ∧
            (G m).val.map (homOfLE hWV).op t ∈
              Submodule.span ((moduleRings X.toRingedSpace).obj.obj (op W))
                {z | ∃ (i : Fin r), d i ≤ m ∧
                  ∃ b : graded (m - d i),
                    HEq z ((mu (d i) (m - d i) b).val.app (op W)
                      ((G (d i)).val.map (homOfLE (hWV.trans hVU)).op (s i)))}) := by
  sorry

end AlgebraicGeometry
