module

public import WeilConjectures.AlgebraicGeometry.Morphisms.EtaleTorsor
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.Algebra.Regular.SMul
public import Mathlib.AlgebraicGeometry.Normalization
public import Mathlib.AlgebraicGeometry.Noetherian

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.Localization.FractionRing

import Sheaf.AlgebraicGeometry.Morphisms.NormalizationStalkBaseChange

/-! # Localization of the root normalization to a DVR model -/

@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

/-- The stalk of a root normalization is identified with the corresponding DVR model.

Source: Stacks Project, Tag 0307; Mathlib relative normalization affine description.
(blueprint: lem-sbc-root-normalization-dvr-comparison)

Proof: Set B=H_(g), the actual localization at the prime (g); the domain quotient
makes (g) prime. Its maximal ideal is generated by g and g is a nonzerodivisor.
Noetherianity and the principal maximal ideal criterion make B a DVR, with pi
the image of g as uniformizer. The map H to B preserves invertibility of n.
The compatible chart beta identifies the pullback of U along Spec Frac(B) with
Spec Frac(B): f is invertible there. Pull W back along this map to obtain T, with
its inherited G-action and torsor isomorphism. Localize the monic root algebra
along H minus (g); this is B[t]/(t^n-pi). The root prime has contraction (g),
and every inverted element is a unit at that prime. Localizing normalization
commutes with this change by 0307 (or normalizationPullback_stalk). The source
over this localization is precisely the pullback of T along the displayed q:
inverting pi is the generic point of Spec B. Finiteness of normalization is
preserved under localization. The corresponding normalization point x0 maps
to the root prime, and its local ring is isomorphic to the original stalk.
Both the localization map and the normalization comparison are algebra maps;
they send the explicit root to the explicit root. Their stalk equivalence e
therefore satisfies the asserted equality. No ramification conclusion is used. -/
theorem root_normalization_dvr_comparison
    {L U : Scheme.{u}} (i : U ⟶ L)
    (G : Type (u + 1)) [Group G] [Finite G] (W : GaloisCover G U)
    (R : CommRingCat.{u}) (φ : Spec R ⟶ L) (f : R)
    (β : pullback i φ ≅ Scheme.Opens.toScheme (X := Spec R)
      (PrimeSpectrum.basicOpen f))
    (hβ : β.hom ≫ Scheme.Opens.ι (X := Spec R)
      (PrimeSpectrum.basicOpen f) = pullback.snd i φ)
    (H : CommRingCat.{u}) [IsNoetherianRing H] (b : R ⟶ H)
    (hG : IsUnit (Nat.card G : H)) (hg : IsSMulRegular H (b.hom f))
    [IsDomain (H ⧸ Ideal.span {b.hom f})] :
    let g := b.hom f
    let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ Nat.card G - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let q := Spec.map (CommRingCat.ofHom (algebraMap H A))
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
    ∀ (hN : IsLocallyNoetherian N),
    let := hN
    let p := pullback.snd (W.π ≫ i) (V.ι ≫ q ≫ Spec.map b ≫ φ)
    ∀ (hp : IsFinite p),
    let := hp
    let a := p ≫ V.ι
    Etale p → IsFinite a.fromNormalization →
    ∀ (x : a.normalization),
      (a.fromNormalization x).asIdeal = Ideal.span
        {AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ Nat.card G - Polynomial.C g)} →
      let C := a.normalization.presheaf.stalk x
      let t := AlgebraicGeometry.StructureSheaf.toStalk A (a.fromNormalization x)
        (AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ Nat.card G - Polynomial.C g))
      ∃ (B : CommRingCat.{u}) (hB : IsDomain B),
        letI := hB
        ∃ (hDvr : IsDiscreteValuationRing B),
          letI := hDvr
          ∃ (pi : B), Irreducible pi ∧ IsUnit (Nat.card G : B) ∧
          ∃ (T : GaloisCover G (Spec (CommRingCat.of (FractionRing B)))),
            let A0 := AdjoinRoot
              ((Polynomial.X : Polynomial B) ^ Nat.card G - Polynomial.C pi)
            let N0 := Spec (CommRingCat.of A0)
            let q0 := Spec.map (CommRingCat.ofHom (algebraMap B A0))
            let j0 := Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B)))
            let a0 := pullback.snd (T.π ≫ j0) q0
            ∃ (hqc : QuasiCompact a0) (hqs : QuasiSeparated a0),
              letI := hqc
              letI := hqs
              IsFinite a0.fromNormalization ∧
              ∃ (x0 : a0.normalization),
                (a0.fromNormalization x0).asIdeal = Ideal.span
                  {AdjoinRoot.root
                    ((Polynomial.X : Polynomial B) ^ Nat.card G - Polynomial.C pi)} ∧
                ∃ (e : a0.normalization.presheaf.stalk x0 ≃+* C),
                  e ((a0.fromNormalization.stalkMap x0).hom
                    (AlgebraicGeometry.StructureSheaf.toStalk A0 (a0.fromNormalization x0)
                      (AdjoinRoot.root
                        ((Polynomial.X : Polynomial B) ^ Nat.card G - Polynomial.C pi)))) =
                    (a.fromNormalization.stalkMap x).hom t := by sorry

end AlgebraicGeometry.Scheme
