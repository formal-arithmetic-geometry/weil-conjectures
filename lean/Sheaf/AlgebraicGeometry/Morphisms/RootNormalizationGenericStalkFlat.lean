module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.Algebra.Regular.SMul
public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Normalization
public import Mathlib.AlgebraicGeometry.Noetherian
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.EffectiveCartier

/-! # Flat stalks of a root-cover normalization at the divisor generic point

Source: Stacks Project, Tag 0EYG, the height-one local calculation.
-/

@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

/-- The finite relative normalization of a punctured finite etale cover has flat stalks
above the generic point of the root divisor. No ramification bound is needed for flatness.

Source: Stacks Project, Tag 0EYG, the DVR at the prime generated by the root;
Tags 0307 (localization), 0539 and 0AUW (torsion-free DVR modules are flat/free).
(blueprint: lem-sbc-root-normalization-generic-stalk-flat)

Proof: Put t=root(X^n-g). Monicity gives a free H-basis of A, so multiplication
by g remains injective. The relation t^n=g then makes t a nonzerodivisor.
Evaluation at t=0 identifies A/(t) with the domain H/(g). Thus (t) is prime;
the principal ideal theorem and regularity of t show that its height is one.
The complement of D(g) is V(t). The closed immersion j has this support, and
its integral source has generic point eta, so j(eta) is the prime (t).
The regularity hypothesis makes A_(t) a regular local ring of dimension one,
hence a DVR. Localization of the relative integral closure commutes with this
localization of A. On the punctured spectrum of this DVR the given cover is a
finite etale algebra over the fraction field. Its integral closure is a submodule
of that algebra, hence torsion-free over the DVR. Finiteness of the normalization
makes this a finite module, so it is free by the torsion-free DVR criterion (0AUW).
Its source-prime localizations are therefore flat (also directly by 0539). The canonical
localization identifications give flatness of the scheme stalk maps above j(eta).
The empty cover has no points above eta. The case n=1 is the same DVR argument;
no Galois or prime-to-characteristic assumption enters this flatness assertion. -/
theorem root_normalization_generic_stalk_flat
    (H : CommRingCat.{u}) [IsNoetherianRing H] (g : H)
    (hg : IsSMulRegular H g) [IsDomain (H ⧸ Ideal.span {g})]
    (n : ℕ) (hn : 0 < n) :
    let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
    (∀ (Q : Ideal A) (hQ : Q.IsPrime),
      letI := hQ
      AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g) ∈ Q →
        IsRegularLocalRing (Localization.AtPrime Q)) →
    ∀ (hN : IsLocallyNoetherian N),
    letI := hN
    ∀ (P : Scheme.{u}) (p : P ⟶ V.toScheme) (hp : IsFinite p),
    letI := hp
    let a := p ≫ V.ι
    Etale p → IsFinite a.fromNormalization →
    ∀ (D : Scheme.{u}) (j : D ⟶ N),
      IsIntegral D → IsEffectiveCartierCenter j →
      (∀ z : N, z ∈ V ↔ z ∉ Set.range j) →
      ∀ (η : D), IsGenericPoint η Set.univ →
      ∀ (x : a.normalization), a.fromNormalization x = j η →
        (a.fromNormalization.stalkMap x).hom.Flat := by sorry

end AlgebraicGeometry.Scheme
