module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.RingTheory.Discriminant
public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic

/-!
# Gluing local trace discriminants

Source: Stacks Project, Tag 0BVH, construction preceding Lemma 49.3.1.
(blueprint: lem-sbc-finite-flat-trace-discriminant-gluing)
-/

@[expose] public section

universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

/-- Local trace determinants glue to a quasi-coherent ideal.

Source: Stacks Project, Tag 0BVH, construction preceding Lemma 49.3.1.
(blueprint: lem-sbc-finite-flat-trace-discriminant-gluing)

Proof: On an affine target chart the finite source is affine. Its section algebra is a
finite flat module over the Noetherian section ring, hence finitely presented and locally
free. Refine the target chart to principal affine opens where this module has a finite
basis. On each such chart take the principal ideal generated by the determinant of the
trace matrix in that basis. Trace of endomorphisms of finite free modules commutes with
localization. If the basis is changed by an invertible matrix P, the trace matrix changes
by congruence, so its determinant is multiplied by det(P)^2, a unit. Thus these principal
ideals agree on overlaps, after a common affine refinement, and glue to a quasi-coherent
ideal sheaf J. Each point is contained in one of the chosen charts; its basis and the
formula for J are the witnesses below. The rank can vary from chart to chart. For rank
zero the determinant of the empty matrix is one, giving the unit ideal. No regularity or
nonvanishing of the determinant is needed. -/
theorem exists_ideal_locally_eq_trace_discriminant_of_finite_flat
    {X Y : Scheme.{u}} [IsLocallyNoetherian Y]
    (f : X ⟶ Y) [IsFinite f] [Flat f] :
    ∃ J : Y.IdealSheafData, ∀ y : Y, ∃ U : Y.affineOpens, y ∈ U.1 ∧
      (letI := (f.app U.1).hom.toAlgebra
       ∃ (n : ℕ) (b : Module.Basis (Fin n) Γ(Y, U.1) Γ(X, f ⁻¹ᵁ U.1)),
         J.ideal U = Ideal.span {Algebra.discr Γ(Y, U.1) b}) := by sorry

end AlgebraicGeometry.Scheme
