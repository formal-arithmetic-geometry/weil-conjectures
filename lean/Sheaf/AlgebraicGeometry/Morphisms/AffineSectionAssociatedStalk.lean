module

public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.Algebra.Category.ModuleCat.Stalk
public import Mathlib.RingTheory.Ideal.AssociatedPrime.Basic

/-! # Detecting an affine section at an associated stalk

Source: Stacks Project, Tags 0B3M and 05AR.
(blueprint: lem-sbc-affine-section-associated-stalk)
-/

@[expose] public section

universe u
open CategoryTheory Opposite TopCat.Presheaf
namespace AlgebraicGeometry.Scheme

/-- Unequal sections on an affine open differ at an associated stalk.

Source: Stacks Project, Tag 0B3M, the cyclic image argument, and Tag 05AR.
(blueprint: lem-sbc-affine-section-associated-stalk)

Proof: On the Noetherian affine open V, quasi-coherence identifies N with the
associated sheaf of the finite module N(V). Let d = s - t, which is nonzero.
The cyclic submodule generated by d is nonzero and Noetherian. It has an
associated prime p: choose an annihilator maximal among annihilators of nonzero
multiples of d; the usual multiplication argument shows this annihilator is
prime. Its inclusion in N(V) makes p associated to N(V). The generator of this
annihilator remains nonzero at p, since an element outside p cannot annihilate
it. Hence d also remains nonzero there. Under the affine stalk localization
identification, p gives a point y in V, and localizing the annihilator witness
makes the maximal ideal associated to N_y. Therefore the germs of s and t differ.
Alternatively this is the image subsheaf argument of 0B3M, with 05AR identifying
weak association and association on a locally Noetherian scheme. Empty affine
opens and the zero module have no unequal pair, so their cases are vacuous. -/
theorem exists_associated_stalk_germ_ne_of_isAffineOpen
    {L : Scheme.{u}} [IsLocallyNoetherian L] (N : L.Modules)
    (hqc : N.IsQuasicoherent) (V : L.Opens) (hV : IsAffineOpen V)
    (hfinite : Module.Finite (L.presheaf.obj (op V)) (N.val.obj (op V)))
    (s t : N.val.obj (op V)) (hne : s ≠ t) :
    ∃ (y : L) (hy : y ∈ V),
      IsAssociatedPrime (IsLocalRing.maximalIdeal (L.presheaf.stalk y))
        (TopCat.Presheaf.stalk (C := Ab.{u}) (X := L) N.val.presheaf y) ∧
      N.presheaf.germ V y hy s ≠ N.presheaf.germ V y hy t := by sorry

end AlgebraicGeometry.Scheme
