module

public import Sheaf.AlgebraicGeometry.StrictHenselizationStructuralMap
public import Sheaf.RingTheory.IsStrictHenselization
public import Mathlib.RingTheory.Localization.AtPrime.Basic
import Sheaf.AlgebraicGeometry.StrictHenselizationLocalPresentation
import Sheaf.RingTheory.StrictHenselizationLocalizedDivisorQuotient

/-! # Algebraic presentation of a strict henselization divisor quotient

Source: Stacks Project, Tags 04HX and 05WS.
(blueprint: lem-sbc-strict-hensel-divisor-quotient-presentation)
-/

@[expose] public section

universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

/-- The geometric strict henselization modulo a nonunit divisor is an algebraic strict
henselization of a prime localization of the divisor ring. No regularity hypothesis is used.
Source: Stacks Project, Tag 04HX (Lemma on stalks of the structure sheaf) and
Tag 05WS (Lemma on strict henselization of a quotient).
(blueprint: lem-sbc-strict-hensel-divisor-quotient-presentation)

Proof: Let y be the image of the geometric point and identify the pointed-neighbourhood
coordinate-ring colimit with the strict henselization of R localized at y, as in 04HX.
The identification respects R-maps; full faithfulness of Spec and hb identify its R-map
with b. The local structural map extends y to the maximal ideal. Since b(f) is a nonunit,
f belongs to y, so y induces a prime p of R/(f). Localization commutes with quotient,
identifying R_y/(f) with (R/(f))_p and identifying their residue fields. Choose the relative
separable closure of that residue field inside the geometric field. Tag 05WS applied to
the ideal generated by f in R_y identifies the quotient of its strict henselization with
the strict henselization of (R/(f))_p for this separable closure. Transport the local-base
algebra structure across the quotient/localization identification. The pointed etale
colimit description is precisely Algebra.IsStrictHenselization, giving the last clause.
This argument also covers f=0 and dimension-zero local rings; a unit is excluded exactly
because no prime of R/(f) would lie under the chosen point.
-/
theorem strictHenselizationRing_divisor_quotient_presentation
    (R : CommRingCat.{u}) (f : R)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (barY : Spec (.of Ω) ⟶ Spec R)
    (b : R ⟶ strictHenselizationRing barY)
    (hb : Spec.map b = strictHenselizationStructuralMap barY)
    (hg : ¬ IsUnit (b.hom f)) :
    ∃ (p : Ideal (R ⧸ Ideal.span {f})) (_ : p.IsPrime)
      (K : Type u) (_ : Field K)
      (_ : Algebra (IsLocalRing.ResidueField (Localization.AtPrime p)) K)
      (_ : IsSepClosure (IsLocalRing.ResidueField (Localization.AtPrime p)) K)
      (_ : Algebra (Localization.AtPrime p) K)
      (_ : IsScalarTower (Localization.AtPrime p)
        (IsLocalRing.ResidueField (Localization.AtPrime p)) K)
      (_ : Algebra (Localization.AtPrime p)
        (strictHenselizationRing barY ⧸ Ideal.span {b.hom f})),
      Algebra.IsStrictHenselization (Localization.AtPrime p) K
        (strictHenselizationRing barY ⧸ Ideal.span {b.hom f}) := by
  obtain ⟨q, hq, K, hK, ares, hsep, aK, htower, aH, hbase, hH⟩ :=
    strictHenselizationRing_local_presentation R barY b hb
  let := hq
  let := hK
  let := ares
  let := hsep
  let := aK
  let := htower
  let := aH
  have hf : f ∈ q := by
    by_contra hf
    have hu : IsUnit (algebraMap R (Localization.AtPrime q) f) :=
      IsLocalization.map_units (M := q.primeCompl) (Localization.AtPrime q) ⟨f, hf⟩
    have hu' := hu.map (algebraMap (Localization.AtPrime q) (strictHenselizationRing barY))
    rw [hbase f] at hu'
    exact hg hu'
  exact hH.localized_divisor_quotient R (strictHenselizationRing barY) q K b.hom hbase f hf

end AlgebraicGeometry.Scheme
