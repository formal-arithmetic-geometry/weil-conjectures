import Mathlib.RingTheory.KrullDimension.Regular

/-!
# The boundary after adjoining the generic point of a regular integral divisor

Source: Stacks Project, Tags 00NU, 0EYE and 0EYJ.
(blueprint: lem-sbc-regular-integral-divisor-boundary)
-/

@[expose] public section

universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

open IsLocalRing in
/-- Lift regularity across a nonzerodivisor (Stacks Project, Tag 00NU).
The generator-lifting proof is reused from `RootAlgebraRegularAtRoot`. -/
private theorem lift_regular
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (x : R) (hx : x ∈ maximalIdeal R) (hreg : IsSMulRegular R x)
    [IsRegularLocalRing (R ⧸ Ideal.span {x})] : IsRegularLocalRing R := by
  classical
  let I := Ideal.span ({x} : Set R)
  let Q := R ⧸ I
  let φ := Ideal.Quotient.mk I
  let m := maximalIdeal R
  let mq := maximalIdeal Q
  obtain ⟨s, hcard, hs⟩ := (IsNoetherian.noetherian mq).exists_span_finset_card_eq_spanFinrank
  let a : Q → R := Function.surjInv Ideal.Quotient.mk_surjective
  have ha (y : Q) : φ (a y) = y := Function.surjInv_eq _ y
  let t : Set R := insert x (a '' (s : Set Q))
  have hfin : t.Finite := (s.finite_toSet.image a).insert x
  have ht : Ideal.span t = m := by
    have hmap : (Ideal.span t).map φ = mq := by
      rw [Ideal.map_span, Set.image_insert_eq]
      have hx0 : φ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
      rw [hx0, Set.image_image]
      simp only [ha, Set.image_id']
      rw [Ideal.span_insert_zero]
      exact hs
    have hI : I ≤ Ideal.span t := Ideal.span_mono (by
      intro y hy
      have hyx : y = x := Set.mem_singleton_iff.mp hy
      subst y
      exact Set.mem_insert _ _)
    have hc : (Ideal.span t).comap (RingHom.id R) = m := by
      rw [Ideal.comap_id]
      have hh := congrArg (Ideal.comap φ) hmap
      rw [Ideal.comap_map_of_surjective φ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hI] at hh
      have hm : mq.comap φ = m := by
        rw [show mq = m.map φ from (map_maximalIdeal_of_surjective φ
          Ideal.Quotient.mk_surjective).symm]
        rw [Ideal.comap_map_of_surjective φ Ideal.Quotient.mk_surjective,
          ← RingHom.ker_eq_comap_bot, Ideal.mk_ker,
          sup_eq_left.mpr (Ideal.span_le.mpr (by rintro y rfl; exact hx))]
      exact hh.trans hm
    simpa using hc
  have hbound : m.spanFinrank ≤ mq.spanFinrank + 1 := by
    rw [← ht]
    calc
      _ ≤ t.ncard := Submodule.spanFinrank_span_le_ncard_of_finite hfin
      _ ≤ (a '' (s : Set Q)).ncard + 1 := Set.ncard_insert_le _ _
      _ ≤ (s : Set Q).ncard + 1 := Nat.add_le_add_right (Set.ncard_image_le s.finite_toSet) 1
      _ = mq.spanFinrank + 1 := by rw [Set.ncard_coe_finset, hcard]
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have hdim := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_jacobson
    hreg (by simpa [ringJacobson_eq_maximalIdeal] using hx)
  rw [← hdim, ← IsRegularLocalRing.spanFinrank_maximalIdeal (R := Q)]
  exact_mod_cast hbound

set_option backward.isDefEq.respectTransparency.types false in
/-- At a point on an effective Cartier centre, the stalk map has kernel generated
by a nonzerodivisor in the ambient maximal ideal.

Source: Stacks Project, Tag 01WS (local principal nonzerodivisor description).

Proof: An effective Cartier centre is a closed immersion and its kernel ideal
sheaf is invertible. Choose an affine neighbourhood of i(d) where this ideal
is generated by a nonzerodivisor a. Localize its section ring at the prime
corresponding to i(d). The ambient stalk is this localization. Flatness of
localization preserves injectivity of multiplication by a. The localized
kernel is the kernel of the stalk map, because localization is exact and a
closed immersion on this affine neighbourhood is the spectrum of the
quotient by its defining ideal. Set f equal to the germ of a. The target
stalk is nontrivial, so the kernel is proper; since f belongs to this kernel,
f is not a unit and therefore belongs to the maximal ideal. The proof needs
neither Noetherianity nor regularity nor integrality of either scheme. -/
private theorem exists_stalk_equation
    {L D : Scheme.{u}} {i : D ⟶ L} (hi : IsEffectiveCartierCenter i) (d : D) :
    ∃ f : L.presheaf.stalk (i d), f ∈ IsLocalRing.maximalIdeal _ ∧
      IsSMulRegular (L.presheaf.stalk (i d)) f ∧
      RingHom.ker (i.stalkMap d).hom = Ideal.span {f} := by
  have : IsClosedImmersion i := hi.isClosedImmersion
  have hinv : i.ker.IsInvertible := isEffectiveCartierCenter_iff_isInvertible_ker.mp hi
  obtain ⟨U, hx, a, ha, hgen⟩ := hinv (i d)
  let V := i ⁻¹ᵁ U.1
  have hV : IsAffineOpen V := U.2.preimage i
  have hd : d ∈ V := hx
  let R := L.presheaf.stalk (i d)
  let S := D.presheaf.stalk d
  let : Algebra Γ(L, U.1) R := L.presheaf.algebra_section_stalk ⟨i d, hx⟩
  let : Algebra Γ(D, V) S := D.presheaf.algebra_section_stalk ⟨d, hd⟩
  let p := (U.2.primeIdealOf ⟨i d, hx⟩).asIdeal
  let q := (hV.primeIdealOf ⟨d, hd⟩).asIdeal
  have : IsLocalization.AtPrime R p := U.2.isLocalization_stalk ⟨i d, hx⟩
  have : IsLocalization.AtPrime S q := hV.isLocalization_stalk ⟨d, hd⟩
  have : Module.Flat Γ(L, U.1) R := IsLocalization.flat R p.primeCompl
  let g := (i.app U.1).hom
  have hg : Function.Surjective g := i.app_surjective U.1 U.2
  have hpq : q.comap g = p := by
    have h := IsAffineOpen.comap_primeIdealOf_appLE U.1 U.2 V hV le_rfl hd
    have happ : i.appLE U.1 V le_rfl = i.app U.1 := by
      dsimp [Scheme.Hom.appLE]
      rw [D.presheaf.map_id (Opposite.op V), Category.comp_id]
    rw [happ] at h
    exact congr($(h).1)
  have hcompl : p.primeCompl.map g = q.primeCompl := by
    simpa only [hpq] using Ideal.map_primeCompl_comap_of_surjective g hg q
  have heq : IsLocalization.map S g (hcompl.symm ▸ p.primeCompl.le_comap_map) =
      (i.stalkMap d).hom := by
    apply IsLocalization.ringHom_ext p.primeCompl
    ext b
    simp only [RingHom.comp_apply, IsLocalization.map_eq]
    exact (i.germ_stalkMap_apply U.1 d hx b).symm
  have hker : RingHom.ker (i.stalkMap d).hom =
      (RingHom.ker g).map (algebraMap Γ(L, U.1) R) := by
    rw [← heq]
    exact IsLocalization.ker_map S g hcompl
  have hgen' : RingHom.ker g = Ideal.span {a} := by
    rw [← i.ker_apply U]
    exact hgen
  let f : R := algebraMap Γ(L, U.1) R a
  have hfker : RingHom.ker (i.stalkMap d).hom = Ideal.span {f} := by
    rw [hker, hgen', Ideal.map_span, Set.image_singleton]
  refine ⟨f, ?_, ?_, hfker⟩
  · apply (IsLocalRing.mem_maximalIdeal f).mpr
    intro hf
    have hfzero : (i.stalkMap d).hom f = 0 :=
      RingHom.mem_ker.mp (hfker ▸ Ideal.mem_span_singleton_self f)
    exact not_isUnit_zero (M₀ := S) (hfzero ▸ hf.map (i.stalkMap d).hom)
  · have hregA : IsSMulRegular Γ(L, U.1) a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors ha
    exact hregA.of_flat

/-- Removing an open neighbourhood of the generic point leaves a regular boundary
of local dimension at least two.

Source: Stacks Project, Tag 0EYE, proof; Tag 00NU; Tag 0EYJ, trait paragraph.
(blueprint: lem-sbc-regular-integral-divisor-boundary)

Proof: An effective Cartier centre is a closed immersion. At a point i(d) its
local defining ideal is generated by a nonzerodivisor f in the maximal ideal,
and the quotient local ring is the stalk of D at d. This quotient is regular.
The ambient stalk is Noetherian, so Tag 00NU makes it regular. Its dimension
is one plus the dimension of the quotient, by the dimension formula for a
nonzerodivisor in a Noetherian local ring. If d is not the generic point of
the integral D, the chain from the zero prime to its nonzero prime shows that
the quotient stalk has dimension at least one. Hence the ambient stalk has
dimension at least two. A point outside U lies in the image of i; a point
also outside W cannot be the image of the generic point because that image
belongs to W. Apply the preceding calculation to its preimage d. The
statement is vacuous if U union W is all of L. No finiteness of a cover is used. -/
theorem regular_dim_ge_two_outside_divisor_generic_neighbourhood
    {L D : Scheme.{u}} [IsLocallyNoetherian L] [IsRegular D] [IsIntegral D]
    (i : D ⟶ L) (hi : IsEffectiveCartierCenter i)
    (U : L.Opens) (hU : ∀ z : L, z ∈ U ↔ z ∉ Set.range i)
    (W : L.Opens) (hgeneric : i (genericPoint D) ∈ W) :
    ∀ z : L, z ∉ U ⊔ W → IsRegularLocalRing (L.presheaf.stalk z) ∧
      (2 : WithBot ℕ∞) ≤ ringKrullDim (L.presheaf.stalk z) := by
  classical
  intro z hz
  have hzU : z ∉ U := fun h ↦ hz (TopologicalSpace.Opens.mem_sup.mpr (Or.inl h))
  have hzW : z ∉ W := fun h ↦ hz (TopologicalSpace.Opens.mem_sup.mpr (Or.inr h))
  have hzi : z ∈ Set.range i := by
    by_contra h
    exact hzU ((hU z).mpr h)
  obtain ⟨d, rfl⟩ := hzi
  have hd : d ≠ genericPoint D := by
    intro h
    exact hzW (h ▸ hgeneric)
  have hdimD : (1 : WithBot ℕ∞) ≤ ringKrullDim (D.presheaf.stalk d) := by
    rw [ringKrullDim_stalk_eq_coheight]
    have hlt : d < (⊤ : D) := by
      refine lt_iff_le_not_ge.mpr ⟨le_top, ?_⟩
      intro h
      exact hd ((Specializes.antisymm (genericPoint_specializes d) h).eq.symm)
    have h := Order.coheight_add_one_le hlt
    simpa using h
  have : IsClosedImmersion i := hi.isClosedImmersion
  obtain ⟨f, hf, hreg, hker⟩ := exists_stalk_equation hi d
  let e := (Ideal.quotEquivOfEq hker.symm).trans
    ((i.stalkMap d).hom.quotientKerEquivOfSurjective (i.stalkMap_surjective d))
  have : IsRegularLocalRing (L.presheaf.stalk (i d) ⧸ Ideal.span {f}) :=
    IsRegularLocalRing.of_ringEquiv e.symm
  refine ⟨lift_regular _ f hf hreg, ?_⟩
  have hdim := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim hreg hf
  rw [← hdim, ringKrullDim_eq_of_ringEquiv e]
  exact (show (2 : WithBot ℕ∞) = 1 + 1 from rfl).le.trans
    (by simpa only [add_comm] using add_le_add_right hdimD 1)

end AlgebraicGeometry.Scheme
