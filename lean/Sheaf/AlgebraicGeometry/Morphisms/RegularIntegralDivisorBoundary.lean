module

public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.EffectiveCartier
public import WeilConjectures.AlgebraicGeometry.Regular

/-!
# The boundary after adjoining the generic point of a regular integral divisor

Source: Stacks Project, Tags 00NU, 0EYE and 0EYJ.
(blueprint: lem-sbc-regular-integral-divisor-boundary)
-/

@[expose] public section

universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

/-- Removing an open neighbourhood of the generic point leaves a regular boundary
of local dimension at least two.

Source: Stacks Project, Tag 0EYE, proof; Tag 00NU; Tag 0EYJ, trait paragraph.
(blueprint: lem-sbc-regular-integral-divisor-boundary)

Proof: An effective Cartier centre is a closed immersion. At a point i(d) its
local defining ideal is generated by a nonzerodivisor f in the maximal ideal,
and the quotient local ring is the stalk of D at d. This quotient is regular.
The ambient stalk is Noetherian, so Tag 00NU makes it regular. Its dimension
is one plus the dimension of the quotient, by the dimension formula for a
nonzerodivisor in a Noetherian local ring. If d is not the generic point of
the integral D, the chain from the zero prime to its nonzero prime shows that
the quotient stalk has dimension at least one. Hence the ambient stalk has
dimension at least two. A point outside U lies in the image of i; a point
also outside W cannot be the image of the generic point because that image
belongs to W. Apply the preceding calculation to its preimage d. The
statement is vacuous if U union W is all of L. No finiteness of a cover is used. -/
theorem regular_dim_ge_two_outside_divisor_generic_neighbourhood
    {L D : Scheme.{u}} [IsLocallyNoetherian L] [IsRegular D] [IsIntegral D]
    (i : D ⟶ L) (hi : IsEffectiveCartierCenter i)
    (U : L.Opens) (hU : ∀ z : L, z ∈ U ↔ z ∉ Set.range i)
    (W : L.Opens) (hgeneric : i (genericPoint D) ∈ W) :
    ∀ z : L, z ∉ U ⊔ W → IsRegularLocalRing (L.presheaf.stalk z) ∧
      (2 : WithBot ℕ∞) ≤ ringKrullDim (L.presheaf.stalk z) := by sorry

end AlgebraicGeometry.Scheme
