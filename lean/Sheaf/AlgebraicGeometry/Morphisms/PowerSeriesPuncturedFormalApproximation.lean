module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Sheaf.RingTheory.Depth
import Sheaf.AlgebraicGeometry.Morphisms.DepthTwoHartogsRestriction

/-!
# Formal approximation of sections along the punctured zero section

Source: Stacks Project, Tag 0EY9, the first displayed inverse-limit calculation.
(blueprint: lem-sbc-power-series-punctured-formal-approximation)
-/

@[expose] public section

universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

/-- Every section has a unique power series with the same restrictions to all
infinitesimal neighbourhoods of the punctured zero section.

Source: Stacks Project, Tag 0EY9, first displayed calculation and the following
comparison of rings. (blueprint: lem-sbc-power-series-punctured-formal-approximation)

Proof: Let I be the ideal generated by the variables and U the punctured
spectrum of A. Depth-two Hartogs identifies Gamma(U,O) with A. For every n,
B/I^n is finite free over A with basis the monomials of degree less than n.
The n-th thickening of U in V is the restriction to U of this finite free
algebra. Consequently its sections are B/I^n, with the usual quotient maps
as transition maps. The reductions of the given section provide a compatible
family in these quotients. For each monomial choose its coefficient from any
truncation of sufficiently high degree; compatibility makes this independent
of the truncation. These coefficients construct b in B, and show uniqueness.
The kernel of the stalk map of the zero-section closed immersion is I times
the local ring. The stalk of O_V/I^n O_V is its quotient by that kernel's n-th
power, so equality on the thickening is precisely the displayed membership.
Conversely the memberships at every point of U imply equality of sections
of each thickening by stalkwise equality, proving the stated uniqueness.
This is a formal approximation statement, not equality of sections on V. -/
theorem existsUnique_powerSeries_punctured_formal_approximation
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hdepth : (2 : ℕ∞) ≤ IsLocalRing.depth (R := A) A)
    (d : ℕ) (hd : 0 < d)
    (V : (Spec (.of (MvPowerSeries (Fin d) A))).Opens)
    (hV : ∀ x : Spec (.of A),
      (Spec.map (CommRingCat.ofHom (MvPowerSeries.constantCoeff (σ := Fin d)))) x ∈ V ↔
        x ≠ IsLocalRing.closedPoint A) :
    let z := Spec.map
      (CommRingCat.ofHom (MvPowerSeries.constantCoeff (σ := Fin d) (R := A)))
    let r := ((ΓSpecIso (.of (MvPowerSeries (Fin d) A))).inv ≫ V.ι.appTop).hom
    ∀ s : Γ(V.toScheme, ⊤), ∃! b : MvPowerSeries (Fin d) A,
      ∀ (x : (z ⁻¹ᵁ V).toScheme) (n : ℕ),
        (V.toScheme.presheaf.Γgerm ((z ∣_ V) x)).hom (s - r b) ∈
          (RingHom.ker ((z ∣_ V).stalkMap x).hom) ^ n := by sorry

end AlgebraicGeometry.Scheme
