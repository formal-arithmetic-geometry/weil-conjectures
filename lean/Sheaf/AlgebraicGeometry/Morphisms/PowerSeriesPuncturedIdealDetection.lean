module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Sheaf.RingTheory.Depth
import Sheaf.AlgebraicGeometry.Morphisms.DepthTwoHartogsRestriction

/-! # Detection of variable-ideal powers on the punctured zero section

Source: Stacks Project, Tag 0EY9, first displayed calculation at a fixed index.
(blueprint: lem-sbc-power-series-punctured-ideal-detection)
-/

@[expose] public section

universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

/-- Membership in a fixed power of the variables ideal is detected by germs
of the corresponding global section along the punctured zero section.

Source: Stacks Project, Tag 0EY9 (lemma-fully-faithful-power-series-over-depth2),
the first displayed calculation at a fixed index, and the subsequent ring comparison.
(blueprint: lem-sbc-power-series-punctured-ideal-detection)

Proof: Let I be the ideal generated by the variables. Under the canonical
localization identifications, the zero-section stalk map is B_q to A_p and
its kernel is I B_q. Open restriction induces stalk isomorphisms, so the same
kernel description holds on V. The memberships say that the section represented by b on the
intersection of V with Spec(B/I^n) is zero at every stalk, and hence is zero.
The projection of this intersection to the punctured spectrum U of A is
finite affine and its direct-image module is the restriction of B/I^n.
For n positive this is finite free on monomials of degree less than n.
Depth-two Hartogs gives Gamma(U,O_U) = A and therefore identifies its sections
with B/I^n, using the canonical restriction map. Consequently the class of b
in B/I^n is zero, which says b belongs to I^n. At n = 0 the conclusion holds
for every b because I^0 is the unit ideal.
This is a single finite-order test on a global power series, not a claim
about existence or uniqueness of a simultaneous formal approximation. -/
theorem powerSeries_mem_variables_pow_of_punctured_germs
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hdepth : (2 : ℕ∞) ≤ IsLocalRing.depth (R := A) A)
    (d : ℕ) (hd : 0 < d)
    (V : (Spec (.of (MvPowerSeries (Fin d) A))).Opens)
    (hV : ∀ x : Spec (.of A),
      (Spec.map (CommRingCat.ofHom (MvPowerSeries.constantCoeff (σ := Fin d)))) x ∈ V ↔
        x ≠ IsLocalRing.closedPoint A) :
    let z := Spec.map
      (CommRingCat.ofHom (MvPowerSeries.constantCoeff (σ := Fin d) (R := A)))
    let r := ((ΓSpecIso (.of (MvPowerSeries (Fin d) A))).inv ≫ V.ι.appTop).hom
    ∀ (b : MvPowerSeries (Fin d) A) (n : ℕ),
      (∀ x : (z ⁻¹ᵁ V).toScheme,
        (V.toScheme.presheaf.Γgerm ((z ∣_ V) x)).hom (r b) ∈
          (RingHom.ker ((z ∣_ V).stalkMap x).hom) ^ n) →
      b ∈ (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin d) (R := A)))) ^ n := by sorry

end AlgebraicGeometry.Scheme
