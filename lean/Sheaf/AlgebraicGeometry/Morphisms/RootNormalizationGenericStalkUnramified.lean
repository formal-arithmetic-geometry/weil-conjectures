/-! # Tame unramifiedness after the group-order root extension

Source: Stacks Project, Tags 09EB, 0BRM and 0EYG. -/

@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

/-- The group-order root extension kills ramification on normalization stalks.

Source: Stacks Project, Tags 09EB, 0BRM and 0EYG, the root-extension calculation.
(blueprint: lem-sbc-root-normalization-generic-stalk-unramified)

Proof: Write n=|G| and g=b(f). In A=H[t]/(t^n-g), t is regular and
A/(t)=H/(g) is a domain. The generic point j(eta) of the Cartier support V(g)
is therefore the height-one prime (t). Its assumed regular localization is a
DVR with uniformizer t. H localized at the prime (g) is also a DVR: its maximal
ideal is generated by the nonzerodivisor g. The induced DVR extension has
ramification index n by t^n=g. The cartesian comparison beta identifies the
original G-torsor over D(f). After base change to the fraction field of H_(g),
its field factors are Galois for stabilizer subgroups of G. Their degrees divide
n. By 09EB the ramification indices and residue degrees divide these degrees;
since n is invertible, the residue extensions are separable and ramification
is tame. Apply 0BRM to each factor and the DVR root extension of index n.
The normalized base-change factors have ramification index one and separable
residue extensions. Localization of the concrete relative integral closure
identifies their local rings with the stalks in the statement. Finiteness of the
normalization makes these maps essentially of finite type. The index-one
condition means the target maximal ideal generates the source maximal ideal;
together with residue separability this is the local unramified criterion.
Hence their relative differentials vanish and the stalk map is formally
unramified. This is only the unramified part of the argument: it asserts neither
flatness nor an etale neighbourhood. Empty fibres are vacuous, n=1 is the
unramified case, and ramified covers without the root extension are excluded. -/
theorem root_normalization_generic_stalk_unramified
    {L U : Scheme.{u}} (i : U ⟶ L)
    (G : Type (u + 1)) [Group G] [Finite G] (W : GaloisCover G U)
    (R : CommRingCat.{u}) (φ : Spec R ⟶ L) (f : R)
    (β : pullback i φ ≅ Scheme.Opens.toScheme (X := Spec R)
      (PrimeSpectrum.basicOpen f))
    (hβ : β.hom ≫ Scheme.Opens.ι (X := Spec R)
      (PrimeSpectrum.basicOpen f) = pullback.snd i φ)
    (H : CommRingCat.{u}) [IsNoetherianRing H] (b : R ⟶ H)
    (hG : IsUnit (Nat.card G : H)) (hg : IsSMulRegular H (b.hom f))
    [IsDomain (H ⧸ Ideal.span {b.hom f})] :
    let g := b.hom f
    let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ Nat.card G - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let q := Spec.map (CommRingCat.ofHom (algebraMap H A))
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
    (∀ (Q : Ideal A) (hQ : Q.IsPrime),
      letI := hQ
      AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ Nat.card G - Polynomial.C g) ∈ Q →
        IsRegularLocalRing (Localization.AtPrime Q)) →
    ∀ (hN : IsLocallyNoetherian N),
    letI := hN
    let p := pullback.snd (W.π ≫ i) (V.ι ≫ q ≫ Spec.map b ≫ φ)
    ∀ (hp : IsFinite p),
    letI := hp
    let a := p ≫ V.ι
    Etale p → IsFinite a.fromNormalization →
    ∀ (D : Scheme.{u}) (j : D ⟶ N),
      IsRegular D → IsIntegral D → IsEffectiveCartierCenter j →
      (∀ z : N, z ∈ V ↔ z ∉ Set.range j) →
      ∀ (η : D), IsGenericPoint η Set.univ →
      ∀ (x : a.normalization), a.fromNormalization x = j η →
        (a.fromNormalization.stalkMap x).hom.FormallyUnramified := by sorry

end AlgebraicGeometry.Scheme
