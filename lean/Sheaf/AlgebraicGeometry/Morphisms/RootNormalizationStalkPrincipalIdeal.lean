module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.Algebra.Regular.SMul
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Normalization
public import Mathlib.AlgebraicGeometry.Noetherian

/-! # Principalness of the normalized root stalk maximal ideal -/

@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

/-- The normalized stalk maximal ideal is principal, without a tame-ramification bound.

Source: Stacks Project, Tags 0307, 035L and 00PD.
(blueprint: lem-sbc-root-normalization-stalk-principal-ideal)

Proof: The polynomial is monic because n is positive, so its root algebra is free
of rank n over H. The equation t^n = g and regularity of g make t a nonzerodivisor.
The root-prime stalk has maximal ideal generated by the nonzero germ of t: the
stalk is localization at the displayed prime (t). The assumed regularity makes
this local ring a domain, so the principal maximal ideal criterion 00PD makes it
a DVR. In this localization D(g) is precisely the generic point, since g = t^n.
The finite etale cover thus becomes a finite product of finite separable extensions
of the DVR fraction field. Relative normalization commutes with this localization
by 0307. Its local rings above the closed point are the localizations of the
integral closures in those field factors, and are normal domains by 035L. The
finite-normalization assumption makes the integral closures finite over the base
DVR, hence Noetherian of dimension one at these points by integrality. A
one-dimensional Noetherian normal local domain is a DVR (00PD), whose maximal
ideal is principal. This establishes principalness without identifying a generator
and without asserting any ramification index. Empty factors contribute no x;
n = 1 is allowed, as are wildly ramified punctured covers. -/
theorem root_normalization_stalk_maximalIdeal_isPrincipal
    (H : CommRingCat.{u}) [IsNoetherianRing H] (g : H)
    (hg : IsSMulRegular H g) [IsDomain (H ⧸ Ideal.span {g})]
    (n : ℕ) (hn : 0 < n) :
    let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
    ∀ (hN : IsLocallyNoetherian N),
    letI := hN
    ∀ (P : Scheme.{u}) (p : P ⟶ V.toScheme) (hp : IsFinite p),
    letI := hp
    let a := p ≫ V.ι
    Etale p → IsFinite a.fromNormalization →
    ∀ (x : a.normalization),
      (a.fromNormalization x).asIdeal = Ideal.span
        {AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)} →
      IsRegularLocalRing (N.presheaf.stalk (a.fromNormalization x)) →
      (IsLocalRing.maximalIdeal (a.normalization.presheaf.stalk x)).IsPrincipal := by
  sorry

end AlgebraicGeometry.Scheme
