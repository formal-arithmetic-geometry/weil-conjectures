module

public import Sheaf.AlgebraicGeometry.AlgebraicSpaceIdealClosedSubspaceCorrespondence
public import Sheaf.AlgebraicGeometry.AlgebraicSpaceAbsoluteQuasiSeparated
public import Sheaf.AlgebraicGeometry.AlgebraicSpaceMorphismProperties
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.AlgebraicGeometry.OpenImmersion
import Sheaf.AlgebraicGeometry.AlgebraicSpaceModuleFpDirectedApproximation
import Mathlib.AlgebraicGeometry.Morphisms.Etale
import Mathlib.Algebra.Category.ModuleCat.FilteredColimits
import Mathlib.CategoryTheory.Limits.ConcreteCategory.Basic

/-! # Finite-type ideals defining quasi-compact open boundaries

Source: Stacks Project, Limits of Algebraic Spaces, Tag 0855,
lemma-quasi-coherent-finite-type-ideals, implication (2) to (3)
(blueprint: lem-sfb-space-qc-open-boundary-ideal).

The closed subspace is identified with the ideal by its kernel, using the existing
ideal/closed-subspace correspondence. The canonical ideal map on the open subspace
is an isomorphism, expressing equality with the unit ideal as an embedded ideal.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.AlgebraicSpace

/-- A quasi-compact open subspace of a qcqs algebraic space has boundary defined by
a finite-type quasi-coherent ideal, which restricts to the unit ideal on the open.
No reducedness or Noetherian hypothesis is imposed.
Source: Stacks Project, Limits of Algebraic Spaces, Tag 0855,
lemma-quasi-coherent-finite-type-ideals, implication (2) to (3)
(blueprint: lem-sfb-space-qc-open-boundary-ideal).

Proof:
1. The point image of the open immersion is open by lem-a1-space-point-open-calculus.
   Its complement C is closed. By lem-sfb-space-reduced-closed-support give C its
   reduced closed-subspace structure. By lem-sfb-space-ideal-closed-subspace-correspondence
   its kernel ideal J is quasi-coherent. Over U this closed subspace is empty, so
   the quotient description gives J restricted to U equal to O_U.
2. The quasi-compact atlas of T gives a continuous surjection on points by
   lem-a1-space-point-open-calculus, so its point space is quasi-compact. Apply
   lem-sfb-space-module-fp-directed-approximation to J using absolute
   quasi-separatedness. Obtain a small filtered diagram of finitely presented
   modules F_a with colimit J in all module sheaves.
3. By lem-sfb-qc-space-affine-etale-atlas take an affine surjective etale atlas W
   of U. Its composite with the open immersion into T is representable etale on
   scheme tests by lem-weil-pbc-etale-composition-cancellation.
4. By lem-sfb-space-qcoh-affine-chart-calculus, evaluation on W computes this
   filtered colimit. Since J(W) is the ring of W, the unit lifts to one F_a(W)
   by lem-weil-pbc-filtered-colimit-modules-elementwise.
5. Take K to be the image of F_a to J to O_T. By
   lem-sfb-space-qcoh-affine-chart-calculus this image is quasi-coherent and
   finite type: on every affine etale chart it is generated by the images of a
   finite generating set of F_a. The lifted unit makes K the unit ideal on W.
   The quotient O_U/K restricted to U is zero on this covering, hence zero.
   Thus the canonical ideal map on U is an isomorphism.
6. Since K is contained in J, the inclusion-reversing correspondence
   lem-sfb-space-ideal-closed-subspace-correspondence gives C contained in V(K).
   Over U the ideal K is the unit ideal, so V(K) is empty there. A field-valued
   point mapping into U factors through U by lem-a1-space-point-open-calculus.
   Consequently V(K) has precisely the complement of the point image of U.
   The same correspondence identifies its kernel ideal with K. -/
theorem exists_finiteType_ideal_boundary
    {S : Scheme.{u}} (T U : AlgebraicSpace S) (j : U ⟶ T)
    (hTqc : ∃ (W : Over S) (a : yoneda.obj W ⟶ T.obj.obj),
      CompactSpace W.left ∧ IsEtale a ∧ IsSurjective a)
    (hTqs : IsAbsolutelyQuasiSeparated T)
    (hj : IsRepresentableWith (fun _ _ p ↦ IsOpenImmersion p.left) j.hom.hom)
    (hUqc : ∃ (W : Over S) (a : yoneda.obj W ⟶ U.obj.obj),
      CompactSpace W.left ∧ IsEtale a ∧ IsSurjective a) :
    ∃ (K : QuasiCoherentIdeal T) (Z : ClosedSubspace T),
      SheafOfModules.IsFiniteType (K.val : T.Modules) ∧
      K.val = kernelSubobject (moduleStructureMap Z.val.arrow) ∧
      pointImage Z.val.arrow.hom.hom = (pointImage j.hom.hom)ᶜ ∧
      IsIso (idealTensorMap j K) := by
  sorry

end AlgebraicGeometry.AlgebraicSpace
