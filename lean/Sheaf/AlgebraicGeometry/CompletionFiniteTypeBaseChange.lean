/-! # Completion of finite-type schemes and adic base change

Source: Stacks Project, Tags 0AHY, 0AHZ, 031C, 0316 and 01I4
(blueprint: lem-per-completion-finite-type-base-change).
-/

@[expose] public section
set_option autoImplicit false

universe u

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped TensorProduct

namespace AlgebraicGeometry

/-- The ideal generated by a coefficient ideal on its affine spectrum.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
def completionCoefficientIdeal (A : CommRingCat.{u}) (K : Ideal A) :
    (Spec A).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (K.map (Scheme.ΓSpecIso A).inv.hom)

/-- The inverse-limit topology on sections of a completion of an arbitrary scheme.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
@[instance_reducible]
def completionSectionTopology {X : Scheme.{u}} (I : X.IdealSheafData) :
    FormalSectionTopologies (adicFormalCompletion I) :=
  fun U ↦ ⨅ n : ℕ, TopologicalSpace.induced
    ((colimit.ι (adicThickeningDiagram I ⋙ Scheme.forgetToLocallyRingedSpace ⋙
      LocallyRingedSpace.forgetToSheafedSpace) n).hom.c.app (op U))
    (schemePseudoDiscreteSectionTopology ((adicThickeningDiagram I).obj n)
      ((Opens.map (colimit.ι (adicThickeningDiagram I ⋙
        Scheme.forgetToLocallyRingedSpace ⋙ LocallyRingedSpace.forgetToSheafedSpace)
        n).hom.base).obj U))

/-- The map from a completed scheme to its ambient scheme, induced by all thickenings.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
def completionToScheme {X : Scheme.{u}} (I : X.IdealSheafData) :
    adicFormalCompletion I ⟶ X.toRingedSpace :=
  colimit.desc _ ((Scheme.forgetToLocallyRingedSpace ⋙
    LocallyRingedSpace.forgetToSheafedSpace).mapCocone
      { pt := X
        ι :=
          { app := fun n ↦ (I ^ n).subschemeι
            naturality := by intros; simp [adicThickeningDiagram] } })

/-- The actual completed affine chart on an ambient affine open.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
def completionAffineChart {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens) :
    RingedSpace.{u} :=
  (adicFormalCompletion I).restrict
    (((Opens.map (completionToScheme I).hom.base).obj U.1).isOpenEmbedding)

/-- The completed object over a fixed coefficient ideal.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
def coefficientCompletion {A : CommRingCat.{u}} (K : Ideal A) (X : Over (Spec A)) :=
  adicFormalCompletion ((completionCoefficientIdeal A K).comap X.hom)

/-- The inverse-limit topology of the completed object over a coefficient ring.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
@[instance_reducible]
def coefficientCompletionTopology {A : CommRingCat.{u}} (K : Ideal A)
    (X : Over (Spec A)) : FormalSectionTopologies (coefficientCompletion K X) :=
  completionSectionTopology ((completionCoefficientIdeal A K).comap X.hom)

/-- Canonical completion maps for morphisms over a fixed coefficient ring.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
def coefficientCompletionMap {A : CommRingCat.{u}} (K : Ideal A)
    {X Y : Over (Spec A)} (f : X ⟶ Y) :
    coefficientCompletion K X ⟶ coefficientCompletion K Y :=
  adicFormalCompletionMap f.left
    ((completionCoefficientIdeal A K).comap Y.hom)
    ((completionCoefficientIdeal A K).comap X.hom)
    (by rw [← Scheme.IdealSheafData.comap_comp, Over.w f])

/-- A completed affine chart comparison respects all original coefficient sections.
Source: Stacks Tag 0AHY (blueprint: lem-per-completion-finite-type-base-change). -/
def IsCompletionAffineComparison {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens)
    (e : completionAffineChart I U ≅ adicFormalSpec
      (.of (AdicCompletion (I.ideal U) (X.presheaf.obj (op U.1))))
      ((I.ideal U).map (algebraMap _ _))) : Prop :=
  e.hom ≫ adicFormalSpecToSpec
      (.of (AdicCompletion (I.ideal U) (X.presheaf.obj (op U.1))))
      ((I.ideal U).map (algebraMap _ _)) ≫
      (Scheme.forgetToLocallyRingedSpace ⋙ LocallyRingedSpace.forgetToSheafedSpace).map
        (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.obj (op U.1))
          (AdicCompletion (I.ideal U) (X.presheaf.obj (op U.1)))))) ≫
      (Scheme.forgetToLocallyRingedSpace ⋙ LocallyRingedSpace.forgetToSheafedSpace).map
        U.2.fromSpec =
    (adicFormalCompletion I).ofRestrict
      (((Opens.map (completionToScheme I).hom.base).obj U.1).isOpenEmbedding) ≫
        completionToScheme I

/-- Completion of a finite-type scheme is adic formal; its canonical base-change cone is a
formal fibre product. The quotient-tensor comparison is uniquely determined by its maps on
coefficient elements and continuity. In particular it is natural in both algebras, respects
extended ideals and commutes with completed principal localizations and iterated base change.
Source: Stacks Tags 0AHY, 0AHZ, 031C, 0316, 05GG and 01I4
(blueprint: lem-per-completion-finite-type-base-change).

Proof:
1. Choose a finite affine cover. Its rings are Noetherian by
   `lem-weil-pbc-finite-type-algebra-noetherian`; use
   `lem-weil-pbc-adic-completion-noetherian`, `lem-weil-pbc-adic-completion-mod-ideal`
   and `lem-weil-pbc-adic-completion-mod-power` to identify completed power quotients.
2. On every affine chart the completion sheaf is the limit of the quotient sheaves,
   computed sectionwise (`lem-weil-pbc-site-sheaf-sets-limits-sectionwise`). Localization
   commutes with quotient (`lem-weil-pbc-localization-quotient-commute`), so the affine
   identifications agree on a principal basis and glue. No affine-intersection assumption
   is used. This gives the Noetherian formal cover.
3. A continuous ring map induces maps of sufficiently deep quotients and then of completed
   localizations. These maps are local on stalks: invertibility is detected on the closed
   fibre, and an inverse lifts by the convergent geometric series. Conversely a continuous
   local formal morphism gives a continuous map on global sections and its point map is
   inverse image of primes. Density of the original localized ring and separatedness show
   uniqueness. These constructions are inverse (Stacks 0AHZ).
4. On each quotient the tensor pushout maps send c tensor b to [c tensor b], in both
   directions (`lem-weil-pbc-algebra-tensor-pushout-universal-property`). They commute with
   reduction. Taking compatible sequences gives the displayed completed tensor equivalence.
5. For a pair of continuous coefficient maps into a complete formal affine test ring T,
   continuity supplies a quotient map into T/J^m for each m. Assemble these maps to T.
   Density proves uniqueness; hence this is the formal fibre product, without exchanging
   tensor products and inverse limits. Apply `lem-per-adic-formal-open-gluing` to test
   objects covered by formal affines.
6. Coefficient formulas agree after either principal localization, by localization modulo
   ideals and tensor uniqueness. Refine all overlaps by
   `lem-per-formal-affine-principal-refinement` and glue the comparisons and their inverses.
7. Every naturality square and every successive base-change comparison has the same
   coefficient maps on every quotient. Uniqueness in the formal fibre-product property
   and the normalized tensor equivalence gives equality. The same formulas take each
   extended ideal to the ideal generated by its original elements; restriction glues this
   equality. This includes K = 0, nilpotent K, empty schemes and zero rings. -/
theorem completion_finiteType_baseChange :
    (∀ (A : CommRingCat.{u}) (K : Ideal A) [IsNoetherianRing A] [IsAdicComplete K A],
      (∀ (Z : Over (Spec A)) [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom],
        IsNoetherianAdicFormalScheme (coefficientCompletion K Z) ∧
        IsAdicFormalSectionTopology (coefficientCompletion K Z)
          (coefficientCompletionTopology K Z) ∧
        ∀ U : Z.left.affineOpens,
          ∃ e : completionAffineChart ((completionCoefficientIdeal A K).comap Z.hom) U ≅
              adicFormalSpec
                (.of (AdicCompletion (((completionCoefficientIdeal A K).comap Z.hom).ideal U)
                  (Z.left.presheaf.obj (op U.1))))
                ((((completionCoefficientIdeal A K).comap Z.hom).ideal U).map
                  (algebraMap _ _)),
            IsCompletionAffineComparison ((completionCoefficientIdeal A K).comap Z.hom) U e) ∧
      (∀ (X Y : Over (Spec A)) [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
        [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (f : X ⟶ Y),
        IsContinuousFormalMorphism (coefficientCompletionTopology K X)
          (coefficientCompletionTopology K Y) (coefficientCompletionMap K f) ∧
        (IsOpenImmersion f.left →
          SheafedSpace.IsOpenImmersion (coefficientCompletionMap K f))) ∧
      (∀ X : Over (Spec A), coefficientCompletionMap K (𝟙 X) = 𝟙 _) ∧
      (∀ (X Y Z : Over (Spec A)) (f : X ⟶ Y) (g : Y ⟶ Z),
        coefficientCompletionMap K (f ≫ g) =
          coefficientCompletionMap K f ≫ coefficientCompletionMap K g) ∧
      (∀ (B : CommRingCat.{u}) (g : A ⟶ B) [IsNoetherianRing B]
        [IsAdicComplete (K.map g.hom) B],
        ∃ (eA : coefficientCompletion K (Over.mk (𝟙 (Spec A))) ≅ adicFormalSpec A K)
          (eB : coefficientCompletion K (Over.mk (Spec.map g)) ≅
            adicFormalSpec B (K.map g.hom)),
          eA.hom ≫ adicFormalSpecToSpec A K =
            completionToScheme ((completionCoefficientIdeal A K).comap (𝟙 (Spec A))) ∧
          eB.hom ≫ adicFormalSpecToSpec B (K.map g.hom) =
            completionToScheme ((completionCoefficientIdeal A K).comap (Spec.map g)) ∧
          ∀ (Z : Over (Spec A)) [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom],
            IsContinuousFormalPullback
              (coefficientCompletionTopology K
                (Over.mk (pullback.fst Z.hom (Spec.map g) ≫ Z.hom)))
              (coefficientCompletionTopology K Z)
              (adicFormalSectionTopology B (K.map g.hom)) (adicFormalSectionTopology A K)
              (coefficientCompletionMap K
                (Over.homMk (V := Z) (pullback.fst Z.hom (Spec.map g)) rfl))
              (coefficientCompletionMap K
                (Over.homMk (V := Over.mk (Spec.map g))
                  (pullback.snd Z.hom (Spec.map g)) pullback.condition.symm) ≫
                  eB.hom)
              (coefficientCompletionMap K
                (Over.homMk (U := Z) (V := Over.mk (𝟙 (Spec A)))
                  Z.hom (Category.comp_id _)) ≫ eA.hom)
              (eB.inv ≫ coefficientCompletionMap K
                (Over.homMk (U := Over.mk (Spec.map g)) (V := Over.mk (𝟙 (Spec A)))
                  (Spec.map g) (Category.comp_id _)) ≫ eA.hom))) ∧
    (∀ (A C B : CommRingCat.{u}) [Algebra A C] [Algebra A B]
      (K : Ideal A) [IsNoetherianRing A] [IsAdicComplete K A]
      [Algebra.FiniteType A C] [IsNoetherianRing B]
      [IsAdicComplete (K.map (algebraMap A B)) B],
      ∃! e : AdicCompletion (K.map (algebraMap A (C ⊗[A] B))) (C ⊗[A] B) ≃+*
          adicCompletedAlgebraTensor K
            (CommRingCat.ofHom (algebraMap A (AdicCompletion (K.map (algebraMap A C)) C)))
            (CommRingCat.ofHom (algebraMap A B)),
        @IsHomeomorph _ _
          (K.map (algebraMap A
            (AdicCompletion (K.map (algebraMap A (C ⊗[A] B))) (C ⊗[A] B)))).adicTopology
          (⨅ n : ℕ, TopologicalSpace.induced
            (limit.π (adicQuotientTensorTower K
              (CommRingCat.ofHom (algebraMap A (AdicCompletion (K.map (algebraMap A C)) C)))
              (CommRingCat.ofHom (algebraMap A B))) (op n)).hom ⊥) e ∧
        ∀ (n : ℕ) (c : C) (b : B),
          (limit.π (adicQuotientTensorTower K
            (CommRingCat.ofHom (algebraMap A (AdicCompletion (K.map (algebraMap A C)) C)))
            (CommRingCat.ofHom (algebraMap A B))) (op n)).hom
              (e (algebraMap (C ⊗[A] B) _ (c ⊗ₜ[A] b))) =
            (pushout.inl
              (adicPowerQuotientMap K
                (CommRingCat.ofHom (algebraMap A
                  (AdicCompletion (K.map (algebraMap A C)) C))) (n + 1))
              (adicPowerQuotientMap K (CommRingCat.ofHom (algebraMap A B)) (n + 1))).hom
                (Ideal.Quotient.mk _ (algebraMap C _ c)) *
            (pushout.inr
              (adicPowerQuotientMap K
                (CommRingCat.ofHom (algebraMap A
                  (AdicCompletion (K.map (algebraMap A C)) C))) (n + 1))
              (adicPowerQuotientMap K (CommRingCat.ofHom (algebraMap A B)) (n + 1))).hom
                (Ideal.Quotient.mk _ b)) ∧
    (∀ (R S : CommRingCat.{u}) (K : Ideal R) (L : Ideal S)
      [IsNoetherianRing R] [IsNoetherianRing S] [IsAdicComplete K R] [IsAdicComplete L S],
      (∀ (φ : R →+* S), @Continuous _ _ K.adicTopology L.adicTopology φ →
        ∃! F : adicFormalSpec S L ⟶ adicFormalSpec R K,
          IsContinuousFormalMorphism (adicFormalSectionTopology S L)
            (adicFormalSectionTopology R K) F ∧ IsAdicFormalSpectrumMap K L φ F) ∧
      (∀ F : adicFormalSpec S L ⟶ adicFormalSpec R K,
        IsContinuousFormalMorphism (adicFormalSectionTopology S L)
          (adicFormalSectionTopology R K) F →
        ∃! φ : R →+* S, @Continuous _ _ K.adicTopology L.adicTopology φ ∧
          IsAdicFormalSpectrumMap K L φ F)) := by
  sorry

end AlgebraicGeometry
