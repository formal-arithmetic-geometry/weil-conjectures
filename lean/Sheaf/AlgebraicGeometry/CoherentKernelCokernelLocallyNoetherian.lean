module

public import Sheaf.AlgebraicGeometry.Coherent
public import Mathlib.AlgebraicGeometry.Noetherian

/-! # Coherent kernels, cokernels, sums and quasi-coherent submodules

Source: Stacks Project, Cohomology of Schemes, Tags 01Y0 and 01Y1
(blueprint: lem-weil-pbc-coherent-kernel-cokernel-locnoeth).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Scheme.Modules

/-- On a locally Noetherian scheme, kernels and cokernels of maps between coherent modules,
binary direct sums of coherent modules, and quasi-coherent submodules of coherent modules
and their quotients are coherent. A submodule inclusion is represented by a monomorphism.
Source: Stacks Project, Cohomology of Schemes, Tags 01Y0 and 01Y1
(blueprint: lem-weil-pbc-coherent-kernel-cokernel-locnoeth).

Proof:
1. Restrict to affine opens `U = Spec A`. By `pqf-lem-coherent-ft-locnoeth`, coherence is
   quasi-coherence plus finite type. By `lem-weil-pbc-quasi-coherent-finite-type-affine`,
   coherent modules have finite section modules on `U`. Kernels and cokernels of maps
   between quasi-coherent modules are computed by the corresponding module operations
   on `U` (`lem-weil-pbc-quasi-coherent-module-kernel` and
   `lem-weil-pbc-quasi-coherent-module-cokernel-image`).
2. Since `A` is Noetherian, a submodule of a finite module is finite
   (`lem-weil-pbc-noetherian-finite-module-acc`). Quotients are generated by the images of
   finite generators, and direct sums by the union of finite generating sets.
   The kernel, cokernel and direct sum are therefore quasi-coherent of finite type,
   hence coherent by `pqf-lem-coherent-ft-locnoeth`. This proves the first clause locally
   and hence globally (01Y0).
3. For a quasi-coherent submodule `F'` of coherent `F`, its affine sections are submodules
   of finite modules, so are finite by `lem-weil-pbc-noetherian-finite-module-acc`.
   The quotient is quasi-coherent by `lem-weil-pbc-quasi-coherent-module-cokernel-image`
   and has finite affine sections. Both are coherent by `pqf-lem-coherent-ft-locnoeth`,
   using `lem-weil-pbc-quasi-coherent-finite-type-affine` (01Y1).
-/
theorem isCoherent_kernel_cokernel_biprod_and_submodule
    (X : Scheme.{u}) [IsLocallyNoetherian X] :
    (∀ (F G : X.Modules),
      RingedSpace.IsCoherent X.toRingedSpace F →
      RingedSpace.IsCoherent X.toRingedSpace G →
      (∀ (φ : F ⟶ G),
        RingedSpace.IsCoherent X.toRingedSpace (kernel φ) ∧
        RingedSpace.IsCoherent X.toRingedSpace (cokernel φ)) ∧
      RingedSpace.IsCoherent X.toRingedSpace (F ⊞ G)) ∧
    (∀ (F F' : X.Modules) (i : F' ⟶ F),
      RingedSpace.IsCoherent X.toRingedSpace F →
      Mono i → SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) F' →
      RingedSpace.IsCoherent X.toRingedSpace F' ∧
      RingedSpace.IsCoherent X.toRingedSpace (cokernel i)) := by
  sorry

end AlgebraicGeometry.Scheme.Modules
