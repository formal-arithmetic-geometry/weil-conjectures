module

public import WeilConjectures.AlgebraicGeometry.GroupScheme.Defs

import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.LinearAlgebra.TensorProduct.Defs
import Mathlib.AlgebraicGeometry.Pullbacks
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.RingTheory.Nakayama
import WeilConjectures.AlgebraicGeometry.GroupScheme.Finite

/-!
# The order annihilates a finite commutative group scheme

Source: Milne, Algebraic Groups (2017), Proposition 11.32, printed p.221.
(blueprint: lem-sfb-finite-group-scheme-order-annihilator)

The order is the dimension of the coordinate algebra, not the cardinality of rational points.
The group law on morphisms is written multiplicatively, as in the existing group-scheme API:
`x ^ n = 1` means `n x = 0`, and `𝟙 G ^ n = 1` is the zero multiplication-by-`n` morphism.
-/

@[expose] public section

universe u

open CategoryTheory
open scoped MonObj

namespace AlgebraicGeometry

/-- The positive order of a finite commutative group scheme annihilates it, both as a scheme
morphism and on points over every commutative algebra over the base field. No reducedness,
etaleness, or invertibility assumption is imposed.

Source: Milne, Algebraic Groups (2017), Proposition 11.32, printed p.221.
(blueprint: lem-sfb-finite-group-scheme-order-annihilator)

Proof plan:
1. Put `A = Γ(G, O_G)`. Finiteness makes `A` finite-dimensional, and the counit `A → k`
   makes it nonzero, so its dimension `n` is positive. Extend scalars to an algebraic closure
   using `def-weil-algebraic-closure`, `def-weil-pbc-module-tensor-product`, and
   `lem-weil-pbc-fibre-product-affine-spectra`. A basis stays a basis, preserving `n`, and
   `A → A ⊗ K` is injective, so equality of coordinate maps descends to `k`.
2. Over the algebraic closure use `lem-sfb-finite-commutative-group-local-constant-product`
   to write `G = C × H_K`, where `C` is connected of order `d`, its coordinate ring `B`
   is local with augmentation maximal ideal `I`, and `H` has cardinality `q`, with `n = d*q`.
   By `lem-sfb-finite-additive-group-card-annihilator`, `[q]` kills the constant factor.
3. In characteristic zero, `lem-sc-fg-order-prime-etale` makes `C` etale. By
   `lem-sc-finite-etale-algebra-criterion`, `B` is a product of finite separable extensions.
   Algebraic closedness and locality force one copy of the base field, so `C` is trivial.
4. In characteristic `p > 0`, flatness holds because every vector space is free.
   Apply `lem-sc-connected-finite-order` to obtain `d = p^r` for some natural number `r`.
5. Each `I^j` is a finite `B`-module. If `I^(j+1) = I^j`, Nakayama,
   `lem-weil-pbc-nakayama-jacobson`, gives `I^j = 0`. Thus powers strictly decrease in
   dimension until zero, starting from dimension `d`, so `I^d = 0`.
6. By `lem-sfb-finite-group-faithful-regular-matrices`, the faithful regular matrix `U`
   has coordinate generators and augmentation the identity. Hence `I` is generated by
   entries of `U - 1`; the inverse determinant generator lies in this same ideal.
   For `f = [p]^*`, commutativity makes `[p]` a group-scheme endomorphism, and
   `f(U - 1) = U^p - 1 = (U - 1)^p`. This is a MATRIX power: every entry is in `I^p`.
   Thus `f(I) ⊆ I^p`, and induction gives `f^s(I) ⊆ I^(p^s)`. At `s = r` it vanishes.
   The map `[d]^*` fixes the base field and kills `I`, so equals the counit followed by
   the unit; consequently `[d] = 0` on `C`.
7. Since `n = d*q`, `[n]` kills both factors. Descend the equality to `k` by Step 1.
   Evaluation gives every asserted pointwise identity. Conversely, evaluate at the
   coordinate algebra `A` and its universal point to recover equality of the morphisms.
-/
theorem finite_commutative_group_scheme_order_annihilator
    {k : Type u} [Field k] (G : Over (Spec (.of k))) [GrpObj G] [IsCommMonObj G]
    [IsFinite G.hom] :
    1 ≤ G.hom.finrankΓ ∧
      (𝟙 G : G ⟶ G) ^ G.hom.finrankΓ = 1 ∧
      ∀ (R : Type u) [CommRing R] [Algebra k R]
        (x : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k R))) ⟶ G),
        x ^ G.hom.finrankΓ = 1 := by
  sorry

end AlgebraicGeometry
