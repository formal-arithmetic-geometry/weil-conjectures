module

public import Sheaf.AlgebraicGeometry.AbelianHigherDirectImageMap
public import WeilConjectures.SixFunctors.Etale.UpperLowerStar.Coherence
import Sheaf.AlgebraicGeometry.HigherDirectImageAffineComputationVanishing
import Mathlib.AlgebraicGeometry.Sites.AffineEtale

/-! # Local eventual vanishing for higher direct image sections

Source: Stacks Project, Tag 09Z1, proof of lemma-relative-colimit,
and Tag 03Q8 (blueprint: lem-sbc-higher-direct-image-local-section-vanishing).
-/

@[expose] public section

universe v
open CategoryTheory CategoryTheory.Limits Opposite
open scoped CategoryTheory.Functor AlgebraicGeometry.Etale

namespace AlgebraicGeometry.Etale

/-- A higher direct image section killed at the limit is locally killed at later stages.
Source: Stacks Project, Tag 09Z1, proof of lemma-relative-colimit;
Tag 03Q8, lemma-higher-direct-images; Tag 0EZM, lemma-colimit-variant-complexes.
(blueprint: lem-sbc-higher-direct-image-local-section-vanishing).

Proof:
1. Use the natural higher direct image cohomology-presheaf comparison of Tag 03Q8
   at the given stage and at the limit. Locally lift z to a cohomology class.
   Naturality for the derived adjunction unit and coefficient morphisms identifies
   the map on representatives with the map whose sheafification is eta, using hK
   and hη. As eta(z) is zero, local injectivity of sheafification refines the cover
   so that the limit cohomology representatives are zero. Refine further by affines.
2. On each resulting affine W, base change D and c along W -> S. The stage and
   limit schemes are qcqs since their maps to affine W are qcqs. Affine transitions
   and the limiting cone are preserved by base change. Restrict F and its maps to
   this system. Exact inverse image preserves colimits and degree-zero complexes,
   so these sheaves as complexes satisfy complex cohomology continuity with lower
   bound zero. The comparison on cohomology is the pulled-back derived adjunction
   comparison from step 1. Injectivity of that colimit comparison and the filtered
   colimit equality criterion kill each representative at a later stage. Its image
   in the higher direct image sheaf is therefore zero, and eK transports this to K.
3. Let R be the sieve generated by these covering arrows. For an arrow factoring
   through one of them, use the same stage and restrict its zero section. Naturality
   of K.map gives the asserted eventual zero on every arrow of R. No finite subcover
   or common later stage is asserted here. For p = 0 use ordinary sections; on an
   empty object all sections are zero, so the identity stage suffices.
-/
theorem exists_higherDirectImage_local_section_eq_zero {S : Scheme.{v}}
    {I : Type v} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (D : Iᵒᵖ ⥤ Over S)
    [∀ {i j : Iᵒᵖ} (f : i ⟶ j), IsAffineHom (D.map f).left]
    [∀ i : Iᵒᵖ, QuasiCompact (D.obj i).hom]
    [∀ i : Iᵒᵖ, QuasiSeparated (D.obj i).hom]
    (c : Cone D) (hc : IsLimit ((Over.forget S).mapCone c))
    [QuasiCompact c.pt.hom] [QuasiSeparated c.pt.hom]
    (F : ∀ i : I, Sheaf (D.obj (op i)).left.smallEtaleTopology AddCommGrpCat.{v + 1})
    (φ : ∀ {i j : I} (f : i ⟶ j),
      (((D.map f.op).left)^*[AddCommGrpCat.{v + 1}]).obj (F i) ⟶ F j)
    (hφid : ∀ i : I, HEq (φ (𝟙 i))
      ((upperStarId AddCommGrpCat.{v + 1} (D.obj (op i)).left).hom.app (F i)))
    (hφcomp : ∀ {i j k : I} (f : i ⟶ j) (g : j ⟶ k), HEq (φ (f ≫ g))
      ((upperStarComp AddCommGrpCat.{v + 1} (D.map g.op).left
          (D.map f.op).left).hom.app (F i) ≫
        (((D.map g.op).left)^*[AddCommGrpCat.{v + 1}]).map (φ f) ≫ φ g))
    (H : I ⥤ Sheaf c.pt.left.smallEtaleTopology AddCommGrpCat.{v + 1})
    (eH : ∀ i : I, H.obj i ≅
      (((c.π.app (op i)).left)^*[AddCommGrpCat.{v + 1}]).obj (F i))
    (hH : ∀ {i j : I} (f : i ⟶ j), H.map f =
      (eH i).hom ≫
        (upperStarComp AddCommGrpCat.{v + 1} (c.π.app (op j)).left (D.map f.op).left
          (c.π.app (op i)).left
          (congrArg (fun t => t.left) (c.w f.op)).symm).hom.app (F i) ≫
        (((c.π.app (op j)).left)^*[AddCommGrpCat.{v + 1}]).map (φ f) ≫ (eH j).inv)
    [HasColimit H] (p : ℕ)
    (K : I ⥤ Sheaf S.smallEtaleTopology AddCommGrpCat.{v + 1})
    (eK : ∀ i : I, K.obj i ≅
      (DerivedCategory.Plus.homologyFunctor _ (p : ℤ)).obj
        (R+(((D.obj (op i)).hom)_*[AddCommGrpCat.{v + 1}]).obj
          ((DerivedCategory.Plus.singleFunctor _ 0).obj (F i))))
    (hK : ∀ {i j : I} (f : i ⟶ j), K.map f =
      (eK i).hom ≫ abelianHigherDirectImageMap (D.map f.op).left
        (D.obj (op i)).hom (D.obj (op j)).hom (Over.w (D.map f.op)) p
        (F i) (F j) (φ f) ≫ (eK j).inv)
    (η : K ⟶ (Functor.const I).obj
      ((DerivedCategory.Plus.homologyFunctor _ (p : ℤ)).obj
        (R+((c.pt.hom)_*[AddCommGrpCat.{v + 1}]).obj
          ((DerivedCategory.Plus.singleFunctor _ 0).obj (colimit H)))))
    (hη : ∀ i : I, η.app i = (eK i).hom ≫
      abelianHigherDirectImageMap (c.π.app (op i)).left (D.obj (op i)).hom c.pt.hom
        (Over.w (c.π.app (op i))) p (F i) (colimit H)
        ((eH i).inv ≫ colimit.ι H i)) (V : S.Etale) :
    ∀ (i : I) (z : (K.obj i).obj.obj (op V)),
      (η.app i).hom.app (op V) z = 0 →
      ∃ R : Sieve V, R ∈ S.smallEtaleTopology V ∧
        ∀ (W : S.Etale) (q : W ⟶ V), R q →
          ∃ (j : I) (f : i ⟶ j),
            (K.map f).hom.app (op W) ((K.obj i).obj.map q.op z) = 0 := by
  classical
  intro i z hz
  let 𝒰 := V.left.affineCover
  let W (a : 𝒰.I₀) : S.Etale := Scheme.Etale.mk (𝒰.f a ≫ V.hom)
  let q (a : 𝒰.I₀) : W a ⟶ V := MorphismProperty.Over.homMk (𝒰.f a)
  refine ⟨Sieve.ofArrows W q, ?_, ?_⟩
  · rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
    exact 𝒰.iUnion_range
  · intro T t ht
    obtain ⟨a, b, rfl⟩ := (Sieve.mem_ofArrows_iff W q t).mp ht
    have : IsAffine (W a).left := by
      change IsAffine (Spec _)
      infer_instance
    have hzero : (η.app i).hom.app (op (W a)) ((K.obj i).obj.map (q a).op z) = 0 := by
      rw [NatTrans.naturality_apply, hz, map_zero]
    let y := (eK i).hom.hom.app (op (W a)) ((K.obj i).obj.map (q a).op z)
    have hy : (abelianHigherDirectImageMap (c.π.app (op i)).left
        (D.obj (op i)).hom c.pt.hom (Over.w (c.π.app (op i))) p
        (F i) (colimit H) ((eH i).inv ≫ colimit.ι H i)).hom.app (op (W a)) y = 0 := by
      rw [hη] at hzero
      exact hzero
    obtain ⟨j, f, hf⟩ := exists_higherDirectImage_affine_computation_eq_zero
      D c hc F φ hφid hφcomp H eH hH p (W a) i y hy
    have hstage : (K.map f).hom.app (op (W a))
        ((K.obj i).obj.map (q a).op z) = 0 := by
      rw [hK]
      change (eK j).inv.hom.app (op (W a))
        ((abelianHigherDirectImageMap (D.map f.op).left (D.obj (op i)).hom
          (D.obj (op j)).hom (Over.w (D.map f.op)) p (F i) (F j) (φ f)).hom.app
            (op (W a)) y) = 0
      rw [hf, map_zero]
    refine ⟨j, f, ?_⟩
    rw [op_comp, (K.obj i).obj.map_comp]
    change (K.map f).hom.app (op T)
      ((K.obj i).obj.map b.op ((K.obj i).obj.map (q a).op z)) = 0
    rw [NatTrans.naturality_apply, hstage, map_zero]

end AlgebraicGeometry.Etale
