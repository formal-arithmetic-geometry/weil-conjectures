module

public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Finiteness.Defs
public import WeilConjectures.RingTheory.DualContent

/-!
# Affine coefficient ideal for containment

Source: Stacks Project, Picard Schemes of Curves, Lemma 44.2.7, Tag 0B97
(blueprint: lem-pc-affine-containment-ideal).
-/

@[expose] public section

universe u v w

namespace AlgebraicGeometry

/-- (blueprint: lem-pc-affine-containment-ideal) Stacks Project, Picard Schemes of
Curves, Lemma 44.2.7, Tag 0B97, affine coefficient construction. The coefficient ideal
`K`, generated by all `φ j` with `j ∈ J` and `φ : B →ₗ[R] R`, is the source's
`Submodule.dualContent` of `J` viewed as an `R`-submodule.

Proof. First choose a finite dual system `(b_a, φ_a)` for the finite projective module
`B`, obtained by splitting it off a finite free module, so `b = ∑ φ_a(b) b_a`. For a
base change `R → S`, if the image of `J` in `B ⊗[R] S` is zero, the induced
`S`-linear map `B ⊗[R] S → S` of each functional `φ` sends `j ⊗ 1` to the image of
`φ j`, so every generator of `K` maps to zero in `S`; hence the image of `K` is zero.
Conversely, if `K` maps to zero, tensor the dual-system identity with `S` to get
`j ⊗ 1 = ∑ (φ_a(j) ⊗ 1)(b_a ⊗ 1)`; every coefficient vanishes, so every `j ∈ J` maps
to zero. -/
theorem affine_containment_ideal {R : Type u} {B : Type v} [CommRing R] [CommRing B]
    [Algebra R B] [Module.Finite R B] [Module.Projective R B] (J : Ideal B) :
    ∀ (S : Type w) [CommRing S] [Algebra R S],
      J.map (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := B) (B := S)) = ⊥ ↔
        (J.restrictScalars R).dualContent.map (algebraMap R S) = ⊥ := by sorry

end AlgebraicGeometry
