/-! # The conormal Euler operator at a split-torus fixed scheme

Source: the agent-formulated integral concentration prerequisite for Milne,
Algebraic Groups (iAG2017), Section 22d, Theorem 22.50, printed p.480.
(blueprint: lem-sfb-torus-fixed-euler-unit)

The fixed-scheme coherent group uses the recorded character-twist presentation.
The comparison below pins its conormal action to the invariant ideal's actual
linearization, including its forward-action sign. Localization uses only the
specified character factors, with integral coefficients.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open CategoryTheory.CartesianMonoidalCategory
open scoped TensorProduct CategoryTheory.MonObj

namespace AlgebraicGeometry.TrivialTorusCoherent

variable {F : Type u} [Field F]

/-- The multiplicative system generated by the nontrivial character Euler factors.
Source: the integral concentration prerequisite for Milne, Section 22d, p.480
(blueprint: lem-sfb-torus-fixed-euler-unit). -/
def eulerDenominators (T : Grp (Over (Spec (.of F)))) : Submonoid (CharacterRing T) :=
  Submonoid.closure {a | ∃ χ : Character T, χ ≠ 0 ∧ a = 1 - AddMonoidAlgebra.single χ 1}

/-- The specified integral character localization, with no rationalization.
Source: the integral concentration prerequisite for Milne, Section 22d, p.480
(blueprint: lem-sfb-torus-fixed-euler-unit). -/
abbrev EulerCoefficients (T : Grp (Over (Spec (.of F)))) :=
  Localization (eulerDenominators T)

/-- Pullback along an equal composite, followed by the recorded canonical
composition comparison. Source: Stacks 0097, applied to the conormal action in
Milne's fixed-point prerequisite, Section 22d, p.480
(blueprint: lem-sfb-torus-fixed-euler-unit). -/
def fixedPointPullbackComparison {P A Y : Over (Spec (.of F))}
    (a : P ⟶ A) (z : P ⟶ Y) (f : A.left ⟶ Y.left)
    (h : a.left ≫ f = z.left) (M : Y.left.Modules) :
    testModule M z ≅ (Scheme.Modules.tensorPullback a.left).obj
      ((Scheme.Modules.tensorPullback f).obj M) :=
  eqToIso (congrArg (fun g : P.left ⟶ Y.left ↦
    (Scheme.Modules.tensorPullback g).obj M) h.symm) ≪≫
      (Scheme.Modules.tensorPullbackSectionComp a.left f).app M

/-- Identification of the pullback of a conormal representative with the pullback
of the ideal at a test-scheme point. Source: Stacks 0097 and 0473, in Milne's
fixed-point prerequisite, Section 22d, p.480
(blueprint: lem-sfb-torus-fixed-euler-unit). -/
def conormalAtComparison {Y W P : Over (Spec (.of F))}
    (i : W ⟶ Y) (K : Y.left.Modules) (N : W.left.Modules)
    (e : N ≅ testModule K i) (z : P ⟶ W) :
    testModule N z ≅ testModule K (z ≫ i) :=
  (Scheme.Modules.tensorPullback z.left).mapIso e ≪≫ (atComp K z i).symm

/-- The conormal is i*I = I/I², with the action induced from the invariant ideal.
The inverse descent isomorphism gives the forward fibre action. The comparison
is imposed on every test scheme, so no arbitrary linearization is allowed.
Source: Stacks 03LF and 0473, applied to Milne's integral fixed-point prerequisite,
Section 22d, p.480 (blueprint: lem-sfb-torus-fixed-euler-unit). -/
def IsInducedConormal {T : Grp (Over (Spec (.of F)))}
    {Y W : Over (Spec (.of F))} [ModObj T.X Y]
    (D : EquivariantCoherent.ActionGroupoidModel T.X Y) (i : W ⟶ Y)
    (K : EquivariantCoherent.Coherent D) (N : Linearized T W) : Prop :=
  EquivariantCoherent.IsIdeal (D := D) i.left K ∧
    ∃ e : N.moduleObj ≅ testModule (EquivariantCoherent.underlying K) i,
      ∀ (P : Over (Spec (.of F))) (z : P ⟶ W) (t : P ⟶ T.X),
        ∃ (ha : (lift t (z ≫ i)).left ≫ EquivariantCoherent.target T.X Y = (z ≫ i).left)
          (hp : (lift t (z ≫ i)).left ≫ EquivariantCoherent.source T.X Y = (z ≫ i).left),
          (conormalAtComparison i (EquivariantCoherent.underlying K) N.moduleObj e z).hom ≫
              (fixedPointPullbackComparison (lift t (z ≫ i)) (z ≫ i)
                (EquivariantCoherent.source T.X Y) hp (EquivariantCoherent.underlying K)).hom ≫
              (Scheme.Modules.tensorPullback (lift t (z ≫ i)).left).map
                (EquivariantCoherent.linearization K).inv ≫
              (fixedPointPullbackComparison (lift t (z ≫ i)) (z ≫ i)
                (EquivariantCoherent.target T.X Y) ha (EquivariantCoherent.underlying K)).inv =
            (N.linearization.action P z t).hom ≫
              (conormalAtComparison i (EquivariantCoherent.underlying K) N.moduleObj e z).hom

/-- The finite alternating exterior tensor operator of the conormal bundle.
Source: the operator in equivariant regular self-intersection and Milne's integral
fixed-point prerequisite, Section 22d, p.480
(blueprint: lem-sfb-torus-fixed-euler-unit). -/
def exteriorEulerOperator {T : Grp (Over (Spec (.of F)))}
    {W : Over (Spec (.of F))} (c : ℕ)
    (H : ℕ → Module.End (CharacterRing T) (EquivariantGroup T W)) :
    Module.End (CharacterRing T) (EquivariantGroup T W) :=
  ∑ q ∈ Finset.range (c + 1), (-1 : ℤ) ^ q • H q

/-- A smooth projective split-torus fixed immersion is regular, its conormal has
only nonzero weights, and its integral localized exterior Euler operator is an
automorphism. No nonemptiness, positive codimension, or characteristic assumption
is imposed. Vanishing of the zero-weight sheaf gives vanishing of its pullback
at every geometric fibre, since the decomposition is on all test schemes.

Source: agent-formulated supporting statement for Milne, Algebraic Groups,
Section 22d, Theorem 22.50, printed p.480. Milne cites a general fixed-point
formula rather than proving this prerequisite.
(blueprint: lem-sfb-torus-fixed-euler-unit).

Proof:
1. Use lem-sfb-smooth-projective-torus-invariant-affine-cover. On each chart the
fixed-functor condition restricts to the closed fixed scheme. Apply
lem-sfb-torus-fixed-scheme-smooth and lem-weil-pbc-smooth-local-on-source.
2. By lem-pc-projective-proper and lem-weil-pbc-closed-immersion-proper both
schemes are proper. Apply lem-trf-proper-field-invertible-coherent to O to get
Noetherianity and quasi-compactness, and lem-kun-dimension-finite-type for finite
dimension. Lemma lem-pur-smooth-pair-regular-immersion gives regular charts;
lem-weil-pbc-regular-sequence-conormal-free and lem-sc-affine-conormal-frame
make the conormal finite locally free. A finite subcover bounds all lengths.
The invariant ideal inclusion fixes its linearization; pulling back gives the
specified induced conormal action, with I/I² = i*I.
3. At closed points, lem-wf-affine-nullstellensatz-vanishing identifies the
residue field with F. Maps from dual numbers identify the fixed tangent space
with the tangent space of W. Dualize the exact conormal fibre sequence of
lem-pur-conormal-sequence-smooth-immersion and take zero weights, an exact
operation by lem-sfb-split-torus-representation-weight-decomposition. The first
tangent map is an isomorphism on zero weights, so the conormal has none.
Lemma lem-sfb-trivial-torus-coherent-weight-decomposition gives its finite
weight decomposition, kills the zero-weight bundle using closed fibres, and
commutes with every field extension. It also constructs exterior powers and
exact tensor operators, bounded by the same regular-chart length c.
4. Partition W into finitely many clopen constant-rank pieces for the weight
bundles using that weight-decomposition lemma. On one piece, expand the
exterior operator as a finite sum of character scalars times tensor operators.
Replacing each tensor operator by its rank gives
b = product over nonzero weights χ of (1-e^χ)^(rank E_χ), a unit in R_Σ.
Each tensor operator minus its rank lowers the support filtration, by
lem-sfb-coherent-support-filtration-rank-action. Thus D = L-b id satisfies
D^(d+1)=0 when the piece has dimension at most d.
5. With A=b⁻¹D, the inverse is b⁻¹ sum from k=0 to d of (-A)^k; multiplication
on either side telescopes. Assemble over the clopen pieces. The empty W has
zero coherent group. If N=0 only exterior degree zero survives and L=1;
rank-zero T forces this case. No integer is inverted. -/
theorem torus_fixed_euler_unit
    (F : Type u) [Field F] [IsAlgClosed F]
    (T : Grp (Over (Spec (.of F)))) (r : ℕ)
    (_hT : Nonempty (T ≅ MultiplicativeType.splitTorus F r))
    (Y : Over (Spec (.of F))) [Smooth Y.hom] [IsProjective Y.hom] [ModObj T.X Y]
    (W : Over (Spec (.of F))) (i : W ⟶ Y) [IsClosedImmersion i.left]
    (_hfixed : ∀ (A : CommAlgCat.{u} F)
      (y : (algSpec (.of F)).obj (op A) ⟶ Y),
      (∃ z : (algSpec (.of F)).obj (op A) ⟶ W, z ≫ i = y) ↔
        ∀ (B : CommAlgCat.{u} F) (f : A ⟶ B)
          (t : (algSpec (.of F)).obj (op B) ⟶ T.X),
          t • ((algSpec (.of F)).map f.op ≫ y) = (algSpec (.of F)).map f.op ≫ y) :
    Smooth W.hom ∧ ∃ c : ℕ,
      (∀ w : W.left, ∃ U : Y.left.affineOpens,
        i.left w ∈ U.1 ∧ ∃ f : List Γ(Y.left, U.1),
          f.length ≤ c ∧ RingTheory.Sequence.IsRegular Γ(Y.left, U.1) f ∧
            Ideal.span {x : Γ(Y.left, U.1) | x ∈ f} = i.left.ker.ideal U) ∧
      ∃ (D : EquivariantCoherent.ActionGroupoidModel T.X Y)
        (K : EquivariantCoherent.Coherent D) (N : Linearized T W),
        IsInducedConormal D i K N ∧ N.moduleObj.IsFiniteLocallyFree ∧
        (∃ P : Character T → Subobject N.moduleObj,
          IsWeightDecomposition N P ∧ IsZero (P 0 : W.left.Modules)) ∧
        ∃ (E : ℕ → Linearized T W)
          (H : ℕ → Module.End (CharacterRing T) (EquivariantGroup T W)),
          (∀ q : ℕ, IsExterior N q (E q) ∧ (E q).moduleObj.IsFiniteLocallyFree ∧
            (∀ A : Linearized T W, ∃ B : Linearized T W, IsTensor (E q) A B) ∧
            IsEquivariantTensorOperator (E q) (H q)) ∧
          (∀ q : ℕ, c < q → IsZero (E q).moduleObj ∧ H q = 0) ∧
          (IsZero N.moduleObj → exteriorEulerOperator c H = 1) ∧
          (IsEmpty W.left → exteriorEulerOperator c H = 1) ∧
          ∃ L : EulerCoefficients T ⊗[CharacterRing T] EquivariantGroup T W
              ≃ₗ[EulerCoefficients T]
                EulerCoefficients T ⊗[CharacterRing T] EquivariantGroup T W,
            L.toLinearMap = (exteriorEulerOperator c H).baseChange (EulerCoefficients T) := by
  sorry

end AlgebraicGeometry.TrivialTorusCoherent
