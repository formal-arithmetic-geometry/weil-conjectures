module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import Mathlib.AlgebraicGeometry.Sites.Etale
public import Mathlib.CategoryTheory.Comma.StructuredArrow.Basic
public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PushforwardContinuous
public import Sheaf.CategoryTheory.SiteCoveringAxioms
public import Sheaf.CategoryTheory.RingedSiteModules

/-!
# The total small étale site of a simplicial scheme

Source: Stacks Project, Tag 09WC, Case A, and Tag 0D72
(blueprint: def-trf-total-simplicial-etale-site).

The comma-category encoding uses commuting squares instead of maps to fibre products.
Its two arrow components are precisely the simplicial operator and the map of schemes;
`totalEtaleHomToPullback` gives the canonical fibre-product presentation. Identities and
composition are inherited from Mathlib's comma category and full-subcategory construction.
The topology is the infimum of all topologies containing the degreewise étale coverings.

## Main definitions

- `TotalEtaleSite` and `totalEtaleTopology`: the total category and covering topology.
- `TotalEtaleTopos`: set-valued sheaves on the total site.
- `totalEtaleCommRing`, `totalEtaleRing`, `TotalEtaleModules`: constant coefficients and modules.
- `totalEtaleRestriction`, `totalEtaleModuleRestriction`: component evaluation.
- `TotalEtaleAugmentation`: compatible maps to a scheme.

The site has object universe `u + 1` and morphism universe `u`; coefficients and sets of
sections live in the common containing universe `u + 1` of def-weil-size-convention.
-/

@[expose] public section

universe u v w

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- The objects `(n, W → U_n)` with étale structural morphism, as a full subcategory of
`Comma (𝟭 Scheme) U`. A morphism has components `f.left : W → Z` and
`f.right : [n] → [m]` in `Δᵒᵖ`, with `f.left ≫ Z.hom = W.hom ≫ U.map f.right`.
Source: Stacks Project, Tag 09WC, Case A
(blueprint: def-trf-total-simplicial-etale-site). -/
abbrev TotalEtaleSite (U : SimplicialObject Scheme.{u}) : Type (u + 1) :=
  ObjectProperty.FullSubcategory (fun T : Comma (𝟭 Scheme.{u}) U ↦ Etale T.hom)

/-- Inclusion of the entire small étale category of degree `n` into the total category;
its arrow component in `Δᵒᵖ` is the identity. No choice of pullbacks is involved.
Source: Stacks Project, Tags 09WC and 09WG
(blueprint: def-trf-total-simplicial-etale-site). -/
def totalEtaleComponent (U : SimplicialObject Scheme.{u}) (n : ℕ) :
    (U.obj (op (SimplexCategory.mk n))).Etale ⥤ TotalEtaleSite U :=
  ObjectProperty.lift _
    (Scheme.Etale.forget _ ⋙
      Comma.costructuredArrowSndInclusion (𝟭 Scheme.{u}) U (op (SimplexCategory.mk n)) ⋙
      CostructuredArrow.proj (Comma.snd (𝟭 Scheme.{u}) U) (op (SimplexCategory.mk n)))
    (fun W ↦ W.prop)

/-- The map `W → U_n ×_{U_m} Z` belonging to a total-site arrow. Its first projection is
`W → U_n`, by `pullback.lift_fst`, so it is a `U_n`-map, as in the node's description.
Source: Stacks Project, Tag 09WC, Case A
(blueprint: def-trf-total-simplicial-etale-site). -/
noncomputable def totalEtaleHomToPullback {U : SimplicialObject Scheme.{u}}
    {W Z : TotalEtaleSite U} (f : W ⟶ Z) :
    W.obj.left ⟶ pullback (U.map f.hom.right) Z.obj.hom :=
  pullback.lift W.obj.hom f.hom.left f.hom.w.symm

/-- The topology generated by all étale covering families in a single degree, embedded
with identity order map. The covering criterion is the recorded component topology,
which by `Scheme.ofArrows_mem_smallEtaleTopology_iff` means joint surjectivity.
The empty family is included exactly when it covers the empty étale scheme.
Source: Stacks Project, Tag 09WC, Case A
(blueprint: def-trf-total-simplicial-etale-site). -/
def totalEtaleTopology (U : SimplicialObject Scheme.{u}) :
    GrothendieckTopology (TotalEtaleSite U) :=
  sInf {J | ∀ (n : ℕ) (I : Type (u + 1))
    (W : (U.obj (op (SimplexCategory.mk n))).Etale)
    (V : I → (U.obj (op (SimplexCategory.mk n))).Etale) (f : ∀ i, V i ⟶ W),
    Sieve.ofArrows V f ∈ (U.obj (op (SimplexCategory.mk n))).smallEtaleTopology W →
      Sieve.ofArrows (fun i ↦ (totalEtaleComponent U n).obj (V i))
        (fun i ↦ (totalEtaleComponent U n).map (f i)) ∈
          J ((totalEtaleComponent U n).obj W)}

/-- The total étale topos is the category of set-valued sheaves for the generated topology.
Source: Stacks Project, Tag 09WC
(blueprint: def-trf-total-simplicial-etale-site). -/
abbrev TotalEtaleTopos (U : SimplicialObject Scheme.{u}) :=
  Sheaf (totalEtaleTopology U) (Type (u + 1))

/-- The sheaf of commutative coefficient rings `Λ_tot`, obtained by sheafifying the
constant commutative-ring presheaf, with identity restriction maps before sheafification.
Source: Stacks Project, Tags 0H7J and 0D72
(blueprint: def-trf-total-simplicial-etale-site). -/
noncomputable def totalEtaleCommRing (U : SimplicialObject Scheme.{u})
    (Λ : Type (u + 1)) [CommRing Λ] : Sheaf (totalEtaleTopology U) CommRingCat.{u + 1} :=
  (constantSheaf (totalEtaleTopology U) CommRingCat.{u + 1}).obj (CommRingCat.of Λ)

/-- The underlying ring sheaf of `Λ_tot`, for Mathlib's ringed-site module API.
Source: Stacks Project, Tag 0D72
(blueprint: def-trf-total-simplicial-etale-site). -/
noncomputable def totalEtaleRing (U : SimplicialObject Scheme.{u})
    (Λ : Type (u + 1)) [CommRing Λ] : Sheaf (totalEtaleTopology U) RingCat.{u + 1} :=
  (sheafCompose (totalEtaleTopology U)
    (forget₂ CommRingCat.{u + 1} RingCat.{u + 1})).obj
    (totalEtaleCommRing U Λ)

/-- `Mod(U_•, Λ)` is the existing category of module sheaves over `Λ_tot`, with
sectionwise linear morphisms and semilinear restriction maps.
Source: Stacks Project, Tag 0D72
(blueprint: def-trf-total-simplicial-etale-site). -/
noncomputable abbrev TotalEtaleModules (U : SimplicialObject Scheme.{u})
    (Λ : Type (u + 1)) [CommRing Λ] :=
  ringedSiteModules.{u + 1} (totalEtaleRing U Λ)

/-- The proof obligation for component evaluation to land in sheaves.
Source: Stacks Project, Tag 09WG, using the total site of Tag 09WC, Case A
(blueprint: def-trf-total-simplicial-etale-site).

Proof: two arrows with identity order map have their fibre product in degree `n`,
computed in `(U_n).Etale`. To verify its universal property in the total category,
write a cone from degree `m` as two commuting squares with the same order map;
the scheme pullback universal property gives the unique square to their fibre product.
Thus the inclusion preserves the fibre products used in the sheaf condition.
Every jointly surjective étale covering in degree `n` is a generating covering for
`totalEtaleTopology U`, by its defining infimum. A sheaf on the total site therefore
satisfies the component covering equalizer diagrams after precomposition. These diagrams
are exactly those defining sheaves for the small étale pretopology; hence also for its
associated small étale topology. This gives continuity, including the empty cover. -/
theorem totalEtaleComponent_continuous (U : SimplicialObject Scheme.{u}) (n : ℕ) :
    (totalEtaleComponent U n).IsContinuous
      (U.obj (op (SimplexCategory.mk n))).smallEtaleTopology (totalEtaleTopology U) := by
  sorry

/-- The continuity instance needed for the actual evaluation functors.
Source: Stacks Project, Tag 09WG
(blueprint: def-trf-total-simplicial-etale-site). -/
instance totalEtaleComponent_isContinuous (U : SimplicialObject Scheme.{u}) (n : ℕ) :
    (totalEtaleComponent U n).IsContinuous
      (U.obj (op (SimplexCategory.mk n))).smallEtaleTopology (totalEtaleTopology U) :=
  totalEtaleComponent_continuous U n

/-- Restriction `e_n` for sheaves in any category of values is evaluation on all `(n,W)`;
its underlying presheaf is literally precomposition with the component inclusion.
Source: Stacks Project, Tag 09WG
(blueprint: def-trf-total-simplicial-etale-site). -/
def totalEtaleRestriction (U : SimplicialObject Scheme.{u}) (n : ℕ)
    (A : Type v) [Category.{w} A] :
    Sheaf (totalEtaleTopology U) A ⥤
      Sheaf (U.obj (op (SimplexCategory.mk n))).smallEtaleTopology A :=
  (totalEtaleComponent U n).sheafPushforwardContinuous A _ _

/-- Restriction of coefficient rings to degree `n`, by evaluation on all `(n,W)`.
Source: Stacks Project, Tag 0D72
(blueprint: def-trf-total-simplicial-etale-site). -/
noncomputable def totalEtaleComponentRing (U : SimplicialObject Scheme.{u})
    (Λ : Type (u + 1)) [CommRing Λ] (n : ℕ) :
    Sheaf (U.obj (op (SimplexCategory.mk n))).smallEtaleTopology RingCat.{u + 1} :=
  (totalEtaleRestriction U n RingCat.{u + 1}).obj (totalEtaleRing U Λ)

/-- Restriction `e_n` of module sheaves: evaluation on all degree-`n` objects, over the
restricted coefficient ring. The ring map is the identity, so it is the canonical
restriction, without an arbitrary comparison or a choice of scalar action.
Source: Stacks Project, Tag 0D72
(blueprint: def-trf-total-simplicial-etale-site). -/
noncomputable def totalEtaleModuleRestriction (U : SimplicialObject Scheme.{u})
    (Λ : Type (u + 1)) [CommRing Λ] (n : ℕ) :
    TotalEtaleModules U Λ ⥤ ringedSiteModules.{u + 1} (totalEtaleComponentRing U Λ n) :=
  SheafOfModules.pushforward (F := totalEtaleComponent U n)
    (𝟙 (totalEtaleComponentRing U Λ n))

/-- An augmentation is a natural transformation to the constant simplicial scheme `X`.
Its components are `a_n : U_n → X`; naturality says `U.map α.op ≫ a_m = a_n`,
i.e. the equation `a_m u_α = a_n` in the node.
Source: Stacks Project, Tag 09WC, Case A, with an augmented simplicial scheme
(blueprint: def-trf-total-simplicial-etale-site). -/
abbrev TotalEtaleAugmentation (U : SimplicialObject Scheme.{u}) (X : Scheme.{u}) :=
  U ⟶ (Functor.const SimplexCategoryᵒᵖ).obj X

end AlgebraicGeometry
