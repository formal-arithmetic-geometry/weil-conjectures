/-! # Arithmetic nodal charts and singular-point blowups

Source: de Jong, Families of curves and alterations, Lemma 3.13 proof, printed p.609;
Stacks Project, Tags 0CBY, 0804, 0805, 033C, 033G, 07NF and 07NG.
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

The declarations separate the nodal and smooth local properties, the three saturated
chart algebras, the exceptional fibre, and their pointed etale interpretations.
The nodal ring is the existing strict semistable construction. Elementary quotient
coordinates and the generated origin ideal are defined here, independently of the
symmetric-blowup theorem. The blowup is the existing ideal-sheaf construction.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits MonoidalCategory

namespace AlgebraicGeometry.DvrNodal

/-- The constant coefficient in the existing nodal quotient ring.
Source: de Jong, Lemma 3.13 proof, p.609, equation `xy = pi^n`
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def constant (R : CommRingCat.{u}) (a c : R) : strictNodalRing R a :=
  Ideal.Quotient.mk _ (MvPolynomial.C c)

/-- One of the two coordinates of the existing nodal quotient ring.
Source: de Jong, Lemma 3.13 proof, p.609, equation `xy = pi^n`
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def coordinate (R : CommRingCat.{u}) (a : R) (i : Fin 2) : strictNodalRing R a :=
  Ideal.Quotient.mk _ (MvPolynomial.X i)

/-- The ideal generated by the two coordinates and the given uniformizer.
Source: de Jong, Lemma 3.13 proof, p.609, singular closed point of `xy = pi^n`
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def originIdeal (R : CommRingCat.{u}) (a π : R) : Ideal (strictNodalRing R a) :=
  Ideal.span {coordinate R a 0, coordinate R a 1} ⊔ Ideal.span {constant R a π}

/-- The arithmetic specialization `M_n = Spec R[x,y]/(xy-pi^n)`, including `M_0`
for the middle chart of the exponent-two blowup.
Source: de Jong, Lemma 3.13 proof, p.609
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def model (R : CommRingCat.{u}) (π : R) (n : ℕ) : Scheme.{u} :=
  (StrictSemistableModel.nodal (A := R) (π ^ n)).scheme

/-- The coefficient structure map of the arithmetic nodal chart.
Source: de Jong, Lemma 3.13 proof, p.609
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def projection (R : CommRingCat.{u}) (π : R) (n : ℕ) : model R π n ⟶ Spec R :=
  (StrictSemistableModel.nodal (A := R) (π ^ n)).baseMap

/-- The actual ideal sheaf `(pi,x,y)` of the arithmetic origin, using its generated
ideal and the canonical global-sections identification.
Source: de Jong, Lemma 3.13 proof, p.609; Stacks 0804
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def centre (R : CommRingCat.{u}) (π : R) (n : ℕ) : (model R π n).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop
    ((originIdeal R (π ^ n) π).map
      (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv.hom)

/-- The closed point specified by its prime ideal `(pi,x,y)`, rather than by an
arbitrary choice from an existence statement.
Source: de Jong, Lemma 3.13 proof, p.609
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def IsOrigin (R : CommRingCat.{u}) (π : R) (n : ℕ) (o : model R π n) : Prop :=
  o.asIdeal = originIdeal R (π ^ n) π

/-- The plane conic `XY=P^2` as the zero scheme of an actual quadratic section.
No radical is taken, so its scheme structure is retained also in characteristic two.
Source: the explicit exceptional-chart calculation, Stacks 0804, de Jong Lemma 3.13
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def conicIdeal (S : Scheme.{u}) :
    (ProjectiveSpace (ULift.{u} (Fin 3)) S).IdealSheafData :=
  Scheme.Modules.Hom.zeroLocus
    (((λ_ (𝟙_ (ProjectiveSpace (ULift.{u} (Fin 3)) S).Modules)).inv ≫
      (ProjectiveSpace.coordinateSection (ULift.{u} (Fin 3)) S ⟨0⟩ ⊗ₘ
        ProjectiveSpace.coordinateSection (ULift.{u} (Fin 3)) S ⟨2⟩)) -
     ((λ_ (𝟙_ (ProjectiveSpace (ULift.{u} (Fin 3)) S).Modules)).inv ≫
      (ProjectiveSpace.coordinateSection (ULift.{u} (Fin 3)) S ⟨1⟩ ⊗ₘ
        ProjectiveSpace.coordinateSection (ULift.{u} (Fin 3)) S ⟨1⟩)))

/-- The exceptional-curve description, over its specified field: for exponent two a
smooth plane conic and a projective line; for larger exponent two closed projective
lines covering the reduced fibre and intersecting scheme-theoretically in one rational
reduced point. The cartesian square specifies the intersection, including its structure.
Source: de Jong, Lemma 3.13 proof, p.609; explicit chart quotients, Stacks 0804
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus). -/
def ExceptionalGeometry (n : ℕ) (Ω : Type u) [Field Ω]
    {E : Scheme.{u}} (p : E ⟶ Spec (.of Ω)) : Prop :=
  (n = 2 → Smooth p ∧
    (∃ e : E ≅ ProjectiveLine (Spec (.of Ω)),
      e.hom ≫ ProjectiveLine (Spec (.of Ω)) ↘ Spec (.of Ω) = p) ∧
    ∃ e : E ≅ (conicIdeal (Spec (.of Ω))).subscheme,
      e.hom ≫ (conicIdeal (Spec (.of Ω))).subschemeι ≫
        ProjectiveSpace (ULift.{u} (Fin 3)) (Spec (.of Ω)) ↘ Spec (.of Ω) = p) ∧
  (2 < n → IsReduced E ∧
    ∃ (i j : ProjectiveLine (Spec (.of Ω)) ⟶ E)
      (a b : Spec (.of Ω) ⟶ ProjectiveLine (Spec (.of Ω))),
      IsClosedImmersion i ∧ IsClosedImmersion j ∧
      i ≫ p = ProjectiveLine (Spec (.of Ω)) ↘ Spec (.of Ω) ∧
      j ≫ p = ProjectiveLine (Spec (.of Ω)) ↘ Spec (.of Ω) ∧
      a ≫ ProjectiveLine (Spec (.of Ω)) ↘ Spec (.of Ω) = 𝟙 _ ∧
      b ≫ ProjectiveLine (Spec (.of Ω)) ↘ Spec (.of Ω) = 𝟙 _ ∧
      IsPullback a b i j ∧ Set.range i ∪ Set.range j = Set.univ)

/-- Integrality, normality, flatness, nodal geometric fibres, regularity and local
 dimensions of the arithmetic model. The centre is the reduced closed origin.
Source: de Jong, Lemma 3.13 proof, p.609; Stacks 00ON, 00KU and 0CBY
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node steps 1--6): reduce mixed monomials using xy=pi^n and embed their normal
forms in Frac(R)[X,X^-1]. This proves integrality and torsion-freeness; a DVR is a
valuation ring, so torsion-free implies flat (lem-trf-valuation-torsionfree-flat).
Polynomial normality and localization normality identify the intersection of the
two Laurent rings with this ring, proving normality (lem-weil-pbc-polynomial-ring-
normal-domain, lem-weil-pbc-localization-normal-domain). Geometric fibres are the
Laurent line and the two reduced transverse axes, with completed node Omega[[x,y]]/(xy).
The flat height formula (lem-weil-pbc-flat-height-formula) gives stalk dimensions at
most two and exactly two at the origin. Laurent charts are smooth over the regular
DVR, hence regular (lem-weil-pbc-regular-ring-smooth-ascent). At the origin, n=1 gives
two generators x,y of the maximal ideal; for n>=2 the cotangent space has independent
classes pi,x,y and dimension three, so the dimension-two local ring is not regular.
The quotient by (pi,x,y) is R/(pi), proving that the centre is the reduced closed point.

Expanded DAG proof, retaining the complete argument:

Step 1. Write $K=\operatorname{Frac}R$ and $A_n=R[x,y]/(xy-\pi^n)$. Repeatedly replace a mixed
monomial $x^ay^b$ by $\pi^{n\min(a,b)}x^{a-\min(a,b)}y^{b-\min(a,b)}$. Thus every element has an
expression $c_0+\sum_{i>0}a_ix^i+\sum_{j>0}b_jy^j$, with finite sums and coefficients in $R$. The
homomorphism to $K[X,X^{-1}]$ given by $x\mapsto X$, $y\mapsto\pi^nX^{-1}$ sends this expression
to $c_0+\sum a_iX^i+\sum b_j\pi^{nj}X^{-j}$. Independence of Laurent monomials and $\pi\ne0$ show
that a zero image has all coefficients zero. This proves both uniqueness and injectivity, so $A_n$
is a domain, its fraction field is $K(X)$, and its $R$-module has the displayed basis. The zero
prime is generic and all localizations are domains, so its spectrum is integral by the
integral-scheme definition. This computation works also for $n=0$, with relation $xy=1$; that case
will be used only for the middle blowup chart.
Uses: def-sc-discrete-valuation-ring, def-weil-polynomial-ring, def-pc-integral-scheme.

Step 2. A DVR is a PID, so it is Noetherian and a normal domain by the cited PID lemma. Each $A_n$
is a finite type $R$-algebra, hence Noetherian. Its prime localizations are Noetherian as well:
every ideal of a localization is generated by the images of generators of its inverse image. The
injection of step 1 makes $A_n$ torsion-free over $R$. The valuation-ring characterization in the
DVR definition and the torsion-free-flat lemma therefore imply that $A_n$ is flat over $R$. The
displayed presentation is finite, so it is also finitely presented. No assumption on completion or
excellence enters these deductions.
Uses: lem-weil-pbc-pid-noetherian-normal, lem-weil-pbc-finite-type-algebra-noetherian,
def-sc-discrete-valuation-ring, lem-trf-valuation-torsionfree-flat.

Step 3. In the common field $K(X)$ the two rings $(A_n)_x=R[X,X^{-1}]$ and
$(A_n)_y=R[\pi^nX^{-1},\pi^{-n}X]$ are normal domains: apply polynomial normality to the normal
domain $R$, then localization normality. Their intersection is exactly $A_n$. Indeed, membership
of $\sum c_iX^i$ in the first says $c_i\in R$, and membership in the second says
$c_i\in\pi^{-ni}R$. For $i\ge0$ the intersection of these coefficient conditions is $R$; for
$i=-j<0$ it is $\pi^{nj}R$. These are precisely the coefficients in the normal form of step 1. If
$z\in K(X)$ is integral over $A_n$, its same monic equation makes it integral over each of the two
Laurent rings; normality puts it in their intersection. Hence $A_n$ is a normal domain. Applying
localization normality once more gives every prime localization of $A_n$ a normal domain, proving
the asserted scheme normality.
Uses: lem-weil-pbc-polynomial-ring-normal-domain, lem-weil-pbc-localization-normal-domain,
def-weil-pbc-normal-ring.

Step 4. For a geometric point over the generic point of $\operatorname{Spec}R$, the fibre ring is
$\Omega[x,x^{-1}]$, since $\pi$ is a unit. Over the closed point it is $\Omega[x,y]/(xy)$. The
latter ring injects into $\Omega[x]\times\Omega[y]$ by restrictions to the axes: its image
consists of pairs with the same constant coefficient. It is therefore reduced, its two affine-line
components meet at the origin, and it is connected of dimension one. The generic Laurent line is
also nonempty, connected and of dimension one. For dimension use the polynomial-line dimension
lemma and its chains of primes, restricting to the open where the coordinate is invertible for the
Laurent line. Away from the origin the special fibre is an open in one of the two lines and is
smooth. At the origin its completion is $\Omega[[x,y]]/(xy)$ directly from the completion
definition: modulo $(x,y)^d$ the basis is $1,x,\ldots,x^{d-1},y,\ldots,y^{d-1}$, with all mixed
products zero. Compatible truncations are exactly pairs of one-variable formal series with equal
constants, the same description as the displayed power-series quotient. Smoothness of the line and
Laurent line can be checked by lifting a coordinate across a square-zero ideal; a lift of an
invertible coordinate is invertible, with inverse obtained by correcting any lifted inverse by the
square-zero error. Thus these fibres satisfy every part, including connectedness, of the
nodal-geometric-fibre definition.
Uses: lem-sc-p1-polynomial-dimension-one, def-trf-nodal-geometric-fibres,
def-weil-pbc-adic-completion, def-sbc-smooth-morphisms.

Step 5. Apply the flat local dimension formula to $R\to A_n$ at any prime, using the Noetherianity
and flatness of step 2. The base-local dimension is zero on the generic fibre and one on the
special fibre, since a DVR has dimension one and its only primes are $(0)$ and $(\pi)$. Each
fibre-local dimension is at most one by step 4, so every local ring of $M_n$ has dimension at most
two. At $o$, the special-fibre local ring $\bigl(k[x,y]/(xy)\bigr)_{(x,y)}$ has dimension one:
there is the strict prime chain $(x)\subsetneq(x,y)$, while every prime contains $x$ or $y$ and
hence lies on a one-dimensional affine line. Thus $\dim\mathcal O_{M_n,o}=1+1=2$.
Uses: lem-weil-pbc-flat-height-formula, lem-sc-dvr-dimension-one,
lem-sc-p1-polynomial-dimension-one.

Step 6. The DVR $R$ is regular local: its maximal ideal has the single generator $\pi$ and its
dimension is one. It is a regular ring by regular-local localization. Both Laurent rings covering
$M_n\setminus\{o\}$ are smooth over $R$: $R[U,V]/(UV-1)$ is standard smooth, with derivative $V$ a
unit. Standard smooth implies smooth, so regularity ascends to them. The cover really misses only
$o$: a prime containing both $x$ and $y$ contains $\pi^n$ and hence $\pi$. At $o$, when $n=1$,
$\pi=xy$ and the maximal ideal is generated by $x,y$; dimension two from step 5 proves regularity.
When $n\ge2$, put $P=R[x,y]_{(\pi,x,y)}$ and $\mathfrak m=(\pi,x,y)P$. The three classes $\pi,x,y$
form a $k$-basis of $\mathfrak m/\mathfrak m^2$: reducing successively modulo $(x,y)$, $(\pi,y)$,
and $(\pi,x)$ proves their linear independence. The relation $xy-\pi^n$ lies in $\mathfrak m^2$,
so passing to $\mathcal O_{M_n,o}=P/(xy-\pi^n)$ leaves that cotangent space three-dimensional. Any
two generators of its maximal ideal would span it by two vectors, impossible. This proves
nonregularity for $n\ge2$.
Uses: def-weil-regular-scheme, lem-sc-dvr-dimension-one, lem-weil-pbc-regular-local-localization,
def-weil-pbc-standard-smooth-algebra, lem-weil-pbc-standard-smooth-is-smooth,
lem-weil-pbc-regular-ring-smooth-ascent.
-/
theorem model_properties (R : CommRingCat.{u}) [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (n : ℕ) (hn : 1 ≤ n) :
    IsIntegral (model R π n) ∧ Flat (projection R π n) ∧
    ∃ hfp : LocallyOfFinitePresentation (projection R π n),
      @HasNodalGeometricFibres _ _ (projection R π n) hfp ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (g : Spec (.of Ω) ⟶ Spec R),
        IsReduced (pullback (projection R π n) g)) ∧
      (∀ x : model R π n,
        IsDomain ((model R π n).presheaf.stalk x) ∧
        IsIntegrallyClosed ((model R π n).presheaf.stalk x) ∧
        ringKrullDim ((model R π n).presheaf.stalk x) ≤ 2) ∧
      ∃ o : model R π n, IsOrigin R π n o ∧
        IsClosed ({o} : Set (model R π n)) ∧
        ((centre R π n).support : Set (model R π n)) = {o} ∧
        (centre R π n).radical = centre R π n ∧
        ringKrullDim ((model R π n).presheaf.stalk o) = 2 ∧
        (IsRegularLocalRing ((model R π n).presheaf.stalk o) ↔ n = 1) ∧
        IsRegularScheme
          (Scheme.Opens.toScheme (X := model R π n) (centre R π n).support.compl) := by
  sorry

/-- The smooth relative-curve alternative, including closed points of the special fibre.
Source: de Jong, Lemma 3.13 proof, p.609; Stacks 07NF, 0567 and 00ON
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node step 7): a DVR is regular. Smooth regular ascent on affine charts gives
regular rings, which are normal by lem-weil-pbc-regular-ring-normal. Smooth morphisms
are flat and locally finitely presented. Apply the flat local dimension formula;
pure curve fibres have local dimension at most one, and at closed fibre points exactly
one. Add the base local dimension, which is one on the special fibre. This also treats
the empty smooth scheme, where all pointwise assertions are vacuous.

Expanded DAG proof, retaining the complete argument:

Step 7. Let $X\to\operatorname{Spec}R$ now be smooth of pure relative dimension one. On affine
neighbourhoods its ring maps are smooth, by the affine-local equivalence in the smooth-morphism
definition. Since $R$ is regular, smooth regular ascent gives regular affine rings; regular rings
are normal, so $X$ is regular and normal. Smoothness also supplies flatness and local finite
presentation. Apply the flat local dimension formula to each such affine ring. The fibres have
pure dimension one, so their local rings have dimension at most one, and at a closed point of a
fibre the dimension is one: a component containing that closed point has dimension one, and its
generic point strictly generalizes the closed point, while no chain can be longer than one. The
base has local dimensions zero or one as before. All stalks of $X$ consequently have dimension at
most two, with dimension two at every closed point of the special fibre. The empty $X$ is allowed,
all these assertions then being vacuous.
Uses: def-sbc-smooth-morphisms, lem-weil-pbc-regular-ring-smooth-ascent,
lem-weil-pbc-regular-ring-normal, lem-pc-smooth-flat, lem-weil-pbc-flat-height-formula,
def-weil-pure-dimension.
-/
theorem smooth_properties (R : CommRingCat.{u}) [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (f : X ⟶ Spec R) [Smooth f]
    (hpure : ∀ s : Spec R, (f.fiber s).IsPureDimension 1) :
    IsRegularScheme X ∧
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧
      IsIntegrallyClosed (X.presheaf.stalk x) ∧ ringKrullDim (X.presheaf.stalk x) ≤ 2) ∧
    ∀ (s : Spec R), s.asIdeal = IsLocalRing.maximalIdeal R →
      ∀ z : f.fiber s, IsClosed ({z} : Set (f.fiber s)) →
        ringKrullDim (X.presheaf.stalk (f.fiberι s z)) = 2 := by
  sorry

/-- Local properties transport through a common pointed etale neighbourhood over R,
when one side is etale over the specified nodal model, or is a smooth relative curve.
Source: Stacks 033C, 033G, 07NF, 07NG, 07QP; de Jong Lemma 3.13
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node step 14): every pointed etale stalk map is flat local, hence faithfully
flat. Normality ascends under etale maps and descends under faithful flatness
(lem-weil-pbc-etale-over-normal-ring-normal, lem-sfb-faithfully-flat-normal-ring-descent).
Regularity ascends by smooth regular ascent and descends by faithfully flat regular
descent (lem-weil-pbc-regular-ring-faithfully-flat-descent). Etale local dimension is
unchanged (lem-sc-etale-local-dimension). Apply each comparison to the two legs at the
specified common point. No equality of residue fields is required.

Expanded DAG proof, retaining the complete argument:

Step 14. Consider a pointed etale map $(U,u)\to(X,x)$. The local dimensions agree by etale local
dimension invariance. Its stalk map is flat and local, hence faithfully flat. For normality
ascent, base-change an affine etale chart to $\operatorname{Spec}\mathcal O_{X,x}$, which stays
etale by the etale base-change lemma. If the base local ring is a normal domain, its localizations
are normal by localization normality; etale normal ascent makes the base-changed algebra normal,
so its stalk at $u$ is normal. Normality descent follows from faithfully flat normal-ring descent.
For regularity ascent perform the same base change; a regular local base is a regular ring by
regular-local localization, and the etale algebra is smooth by the etale-smooth lemma, so smooth
regular ascent applies. Its stalk is regular. For descent, a regular local source is a regular
ring by regular-local localization, and faithfully flat regular descent applies to the stalk map.
Applying these implications to each leg of a common pointed etale neighbourhood transports
normality, regularity (including nonregularity), and local dimension in both directions. Only the
indicated stalks are compared; no isomorphism of residue fields is presumed.
Uses: lem-sc-etale-local-dimension, lem-weil-pbc-etale-algebra-flat,
lem-weil-pbc-flat-local-ring-maps, lem-weil-pbc-flat-local-hom-faithfully-flat,
lem-weil-pbc-etale-base-change-finite-limits, lem-weil-pbc-localization-normal-domain,
lem-weil-pbc-etale-over-normal-ring-normal, lem-sfb-faithfully-flat-normal-ring-descent,
lem-weil-pbc-regular-local-localization, lem-weil-pbc-etale-smooth-zero-dimensional-fibres,
lem-weil-pbc-regular-ring-smooth-ascent, lem-weil-pbc-regular-ring-faithfully-flat-descent.
-/
theorem pointed_etale_properties (R : CommRingCat.{u})
    [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    {X Y W : Scheme.{u}} (f : X ⟶ Spec R) (g : Y ⟶ Spec R)
    (a : W ⟶ X) (b : W ⟶ Y) [Etale a] [Etale b]
    (hover : a ≫ f = b ≫ g) (w : W)
    (hmodel : (∃ (n : ℕ) (_ : 1 ≤ n) (c : Y ⟶ model R π n),
        Etale c ∧ c ≫ projection R π n = g) ∨
      (Smooth g ∧ ∀ s : Spec R, (g.fiber s).IsPureDimension 1)) :
    (IsDomain (X.presheaf.stalk (a w)) ∧
      IsIntegrallyClosed (X.presheaf.stalk (a w))) ∧
    (IsRegularLocalRing (X.presheaf.stalk (a w)) ↔
      IsRegularLocalRing (Y.presheaf.stalk (b w))) ∧
    ((IsDomain (X.presheaf.stalk (a w)) ∧
        IsIntegrallyClosed (X.presheaf.stalk (a w))) ↔
      (IsDomain (Y.presheaf.stalk (b w)) ∧
        IsIntegrallyClosed (Y.presheaf.stalk (b w)))) ∧
    ringKrullDim (X.presheaf.stalk (a w)) = ringKrullDim (Y.presheaf.stalk (b w)) ∧
    ringKrullDim (X.presheaf.stalk (a w)) ≤ 2 := by
  sorry

/-- The three actual saturated blowup chart rings with their coefficient maps and
coordinate formulas. Exponent zero is allowed in the middle ring when n=2.
Source: Stacks 0804; de Jong Lemma 3.13 proof, p.609
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node step 8): take the subalgebras A[I/x], A[I/pi], A[I/y] in the respective
localizations. In the first put t=pi/x, giving xt=pi and y=x^(n-1)t^n. In the middle
put r=x/pi, s=y/pi, giving rs=pi^(n-2), including rs=1 for n=2. Interchange x,y for
the third. The Laurent normal-form injections from step 1 show that these surjections
have no kernel, not merely the torsionful unsaturated substitution presentations.
The finite generator chart cover is prop-nagata-affine-blowup-chart-cover, and
homogeneousAwayEquivChart identifies these subalgebras with the actual Proj charts.

Expanded DAG proof, retaining the complete argument:

Step 8. For $n\ge2$, apply the affine blowup chart-cover theorem to $I=(x,\pi,y)\subset A_n$. Its
three charts are the subalgebras $A_n[I/x]$, $A_n[I/\pi]$, and $A_n[I/y]$ inside the corresponding
localizations. For the first put $t=\pi/x$. In the common fraction field $xt=\pi$, $y=x^{n-1}t^n$,
and $y/x=x^{n-2}t^n$. Hence the chart algebra is generated by $x,t$ and is the image of
$R[x,t]/(xt-\pi)$. The normal-form injection of step 1, now with exponent one and the same
fraction field embedding, proves that this presentation has no further kernel. Interchanging $x,y$
gives $R[y,t']/(yt'-\pi)$ with $t'=\pi/y$ and $x=y^{n-1}(t')^n$. For the middle chart set
$r=x/\pi$, $s=y/\pi$. Then $rs=\pi^{n-2}$ and the chart is generated by $r,s$. The normal-form
injection, with exponent $n-2$ (including exponent zero), again proves injectivity of
$R[r,s]/(rs-\pi^{n-2})$ into the common fraction field. These are therefore exactly the three
charts and the stated structure maps, rather than the unsaturated substitutions $x^2(\cdots)=0$.
Uses: prop-nagata-affine-blowup-chart-cover, def-nagata-blowup-chart-ring, def-nagata-affine-proj,
def-nagata-homogeneous-away-to-chart.
-/
theorem chart_rings (R : CommRingCat.{u}) [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (n : ℕ) (hn : 2 ≤ n) :
    ∃ (e₀ : strictNodalRing R π ≃+*
        AffineBlowup.chartRing (originIdeal R (π ^ n) π)
          (coordinate R (π ^ n) 0))
      (e₁ : strictNodalRing R (π ^ (n - 2)) ≃+*
        AffineBlowup.chartRing (originIdeal R (π ^ n) π)
          (constant R (π ^ n) π))
      (e₂ : strictNodalRing R π ≃+*
        AffineBlowup.chartRing (originIdeal R (π ^ n) π)
          (coordinate R (π ^ n) 1)),
      (∀ c : R, e₀ (constant R π c) =
        algebraMap (strictNodalRing R (π ^ n)) _ (constant R (π ^ n) c)) ∧
      (∀ c : R, e₁ (constant R (π ^ (n - 2)) c) =
        algebraMap (strictNodalRing R (π ^ n)) _ (constant R (π ^ n) c)) ∧
      (∀ c : R, e₂ (constant R π c) =
        algebraMap (strictNodalRing R (π ^ n)) _ (constant R (π ^ n) c)) ∧
      e₀ (coordinate R π 0) =
        algebraMap (strictNodalRing R (π ^ n)) _ (coordinate R (π ^ n) 0) ∧
      algebraMap (strictNodalRing R (π ^ n)) _ (coordinate R (π ^ n) 1) =
        e₀ (coordinate R π 0 ^ (n - 1) *
          coordinate R π 1 ^ n) ∧
      algebraMap (strictNodalRing R (π ^ n)) _ (coordinate R (π ^ n) 0) =
        e₁ (constant R (π ^ (n - 2)) π *
          coordinate R (π ^ (n - 2)) 0) ∧
      algebraMap (strictNodalRing R (π ^ n)) _ (coordinate R (π ^ n) 1) =
        e₁ (constant R (π ^ (n - 2)) π *
          coordinate R (π ^ (n - 2)) 1) ∧
      e₂ (coordinate R π 0) =
        algebraMap (strictNodalRing R (π ^ n)) _ (coordinate R (π ^ n) 1) ∧
      algebraMap (strictNodalRing R (π ^ n)) _ (coordinate R (π ^ n) 0) =
        e₂ (coordinate R π 0 ^ (n - 1) *
          coordinate R π 1 ^ n) := by
  sorry

/-- Geometry of the actual blowup, with a three-open cover realizing the displayed
chart algebras, the unique possible remaining singular point, and exceptional fibres.
Source: de Jong Lemma 3.13 proof, p.609; Stacks 0804
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node steps 8--12): the saturated presentations of chart_rings give the actual
open chart embeddings into the global blowup. The two outer charts are M_1 and the
middle is M_(n-2); at n=2 it is the smooth Laurent chart. Their geometric fibres are
reduced nodal curves. The generic fibre remains the Laurent line. On the special
fibre the two outer crossings connect through the middle hyperbola (n=2) or its two
axes (n>2), proving connectedness. The outer charts are regular. Only the middle
origin can fail to be regular, exactly for n>=4, by the dimension/cotangent-space
calculation in model_properties. On the exceptional fibre, quotient by the centre:
the outer charts become k[t], k[t'], and the middle becomes k[r,s]/(rs-1) at n=2,
or k[r,s]/(rs) otherwise. Overlaps have r=1/t and s=1/t'. At n=2 the first two
lines glue into P^1 and the parametrizations [1:t:t^2], [t'^2:t':1] identify it with
the smooth conic XY=P^2, in every characteristic. Otherwise the two middle axes each
glue to an outer line to give two projective lines meeting in the reduced middle node.

Expanded DAG proof, retaining the complete argument:

Step 8. For $n\ge2$, apply the affine blowup chart-cover theorem to $I=(x,\pi,y)\subset A_n$. Its
three charts are the subalgebras $A_n[I/x]$, $A_n[I/\pi]$, and $A_n[I/y]$ inside the corresponding
localizations. For the first put $t=\pi/x$. In the common fraction field $xt=\pi$, $y=x^{n-1}t^n$,
and $y/x=x^{n-2}t^n$. Hence the chart algebra is generated by $x,t$ and is the image of
$R[x,t]/(xt-\pi)$. The normal-form injection of step 1, now with exponent one and the same
fraction field embedding, proves that this presentation has no further kernel. Interchanging $x,y$
gives $R[y,t']/(yt'-\pi)$ with $t'=\pi/y$ and $x=y^{n-1}(t')^n$. For the middle chart set
$r=x/\pi$, $s=y/\pi$. Then $rs=\pi^{n-2}$ and the chart is generated by $r,s$. The normal-form
injection, with exponent $n-2$ (including exponent zero), again proves injectivity of
$R[r,s]/(rs-\pi^{n-2})$ into the common fraction field. These are therefore exactly the three
charts and the stated structure maps, rather than the unsaturated substitutions $x^2(\cdots)=0$.
Uses: prop-nagata-affine-blowup-chart-cover, def-nagata-blowup-chart-ring, def-nagata-affine-proj,
def-nagata-homogeneous-away-to-chart.

Step 9. Both outer charts in step 8 are $M_1$, so steps 2, 4 and 6 show that they are flat,
regular and have reduced nodal geometric fibres. The middle chart is $M_{n-2}$ when $n\ge3$; when
$n=2$ it is $\operatorname{Spec}R[r,r^{-1}]$, which is smooth and flat by its explicit Laurent
presentation and the preceding smoothness calculation. Thus every chart is flat and has reduced
one-dimensional geometric fibres with only nodes. Their generic fibres glue to the original
Laurent line. On the special fibre the two outer equations are $xt=0$, $yt'=0$; the middle
equation is $rs=0$ for $n>2$, or $rs=1$ for $n=2$. Their overlaps are obtained by $r=1/t$,
$s=1/t'$ where defined. For $n=2$ the middle hyperbola connects the two outer crossing points. For
$n>2$ its two axes meet and connect them. Thus the special fibre is connected, and the fibre
conditions include the connectedness required by the definition. The regularity calculation of
step 6 shows that the outer charts have no nonregular points, and the middle one has a nonregular
point exactly if $n-2\ge2$, uniquely its origin. In particular the entire blowup is regular for
$n=2$ and $n=3$.
Uses: def-trf-nodal-geometric-fibres, def-weil-flat-morphism, def-weil-regular-scheme.

Step 10. The scheme-theoretic exceptional fibre is obtained by quotienting each chart by the
extension of $I=(\pi,x,y)$. In the $x$-chart this ideal is $(x)$, so the exceptional chart is
$\operatorname{Spec}k[t]$; in the $y$-chart it is $(y)$, giving $\operatorname{Spec}k[t']$; in the
$\pi$-chart it is $(\pi)$, giving $\operatorname{Spec}k[r,s]/(rs-1)$ for $n=2$ and
$\operatorname{Spec}k[r,s]/(rs)$ for $n>2$. These quotient calculations determine the fibre
scheme, including its reduced structure. For two generators $a,b$ of $I$, inside $D_+(at)$ the
other standard open $D_+(bt)$ is the locus where $bt/(at)=b/a$ is invertible, by the
homogeneous-prime and fraction descriptions of Proj. Thus the overlap is $D(b/a)$ in $A_n[I/a]$.
On the $x$--$\pi$ overlap $r=1/t$ and $s=x^{n-2}t^{n-1}$; on the $y$--$\pi$ overlap $s=1/t'$ and
$r=y^{n-2}(t')^{n-1}$. Restricting to the exceptional fibre gives the gluing relations used in the
next two steps.
Uses: def-nagata-blowup-chart-ring, def-nagata-affine-proj, def-nagata-homogeneous-away-to-chart.

Step 11. If $n=2$, on the exceptional middle chart $rs=1$ and the overlap relations become
$t=1/r=s$, $t'=1/s=r$. Thus the two outer affine lines glue by $t'=1/t$; the middle chart is just
their overlap. This is $\mathbf P^1_k$ by its standard-cover definition. It is also the smooth
plane conic $XY=P^2$: on the $x$-chart send $t$ to $[1:t:t^2]$, on the $y$-chart send $t'$ to
$[(t')^2:t':1]$, and on the middle chart use $[r:1:s]$. These formulas agree on both overlaps and
identify the respective affine coordinate rings of the conic with those just computed. The $X$-
and $Y$-opens cover the conic, since $X=Y=0$ would force $P=0$. Each is an affine line, proving
smoothness also in residue characteristic two. Base extension to an algebraic closure gives the
stated geometric exceptional fibre.
Uses: def-sc-p1-standard.

Step 12. If $n>2$, the exceptional middle chart is the union of its $r$- and $s$-axes. Its
$r$-axis glues to the $x$-chart by $r=1/t$ on the nonzero coordinates, yielding one $\mathbf
P^1_k$; its $s$-axis glues to the $y$-chart by $s=1/t'$, yielding a second. The two axes meet in
precisely $(r,s)=(0,0)$, with local equation $rs=0$. There is no outer-chart overlap on the
exceptional fibre, since in the $x$-chart $y/x=x^{n-2}t^n$ vanishes there and similarly for $x/y$
in the other chart. Thus there are exactly two reduced projective-line components and their sole
intersection is that one reduced node. This gluing description persists after extending $k$ to an
algebraic closure.
Uses: def-sc-p1-standard.
-/
theorem blowup_geometry (R : CommRingCat.{u}) [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (n : ℕ) (hn : 2 ≤ n) (o : model R π n) (ho : IsOrigin R π n o) :
    Flat ((centre R π n).blowupMap ≫ projection R π n) ∧
    ∃ hfp : LocallyOfFinitePresentation ((centre R π n).blowupMap ≫ projection R π n),
      @HasNodalGeometricFibres _ _ ((centre R π n).blowupMap ≫ projection R π n) hfp ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (g : Spec (.of Ω) ⟶ Spec R),
        IsReduced (pullback ((centre R π n).blowupMap ≫ projection R π n) g)) ∧
      (∃ (j₀ : model R π 1 ⟶ (centre R π n).blowup)
        (j₁ : model R π (n - 2) ⟶ (centre R π n).blowup)
        (j₂ : model R π 1 ⟶ (centre R π n).blowup),
        IsOpenImmersion j₀ ∧ IsOpenImmersion j₁ ∧ IsOpenImmersion j₂ ∧
        Set.range j₀ ∪ Set.range j₁ ∪ Set.range j₂ = Set.univ ∧
        j₀ ≫ (centre R π n).blowupMap ≫ projection R π n = projection R π 1 ∧
        j₁ ≫ (centre R π n).blowupMap ≫ projection R π n = projection R π (n - 2) ∧
        j₂ ≫ (centre R π n).blowupMap ≫ projection R π n = projection R π 1 ∧
        (j₀ ≫ (centre R π n).blowupMap).appTop
            ((Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv
              (coordinate R (π ^ n) 0)) =
          (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ 1)))).inv
            (coordinate R (π ^ 1) 0) ∧
        (j₀ ≫ (centre R π n).blowupMap).appTop
            ((Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv
              (coordinate R (π ^ n) 1)) =
          (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ 1)))).inv
            (coordinate R (π ^ 1) 0 ^ (n - 1) *
              coordinate R (π ^ 1) 1 ^ n) ∧
        (j₁ ≫ (centre R π n).blowupMap).appTop
            ((Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv
              (coordinate R (π ^ n) 0)) =
          (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ (n - 2))))).inv
            (constant R (π ^ (n - 2)) π *
              coordinate R (π ^ (n - 2)) 0) ∧
        (j₁ ≫ (centre R π n).blowupMap).appTop
            ((Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv
              (coordinate R (π ^ n) 1)) =
          (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ (n - 2))))).inv
            (constant R (π ^ (n - 2)) π *
              coordinate R (π ^ (n - 2)) 1) ∧
        (j₂ ≫ (centre R π n).blowupMap).appTop
            ((Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv
              (coordinate R (π ^ n) 1)) =
          (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ 1)))).inv
            (coordinate R (π ^ 1) 0) ∧
        (j₂ ≫ (centre R π n).blowupMap).appTop
            ((Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ n)))).inv
              (coordinate R (π ^ n) 0)) =
          (Scheme.ΓSpecIso (.of (strictNodalRing R (π ^ 1)))).inv
            (coordinate R (π ^ 1) 0 ^ (n - 1) *
              coordinate R (π ^ 1) 1 ^ n) ∧
        ∀ z : (centre R π n).blowup,
          (¬ IsRegularLocalRing ((centre R π n).blowup.presheaf.stalk z) ↔
            4 ≤ n ∧ ∃ q : model R π (n - 2), IsOrigin R π (n - 2) q ∧ j₁ q = z)) ∧
      IsIso ((centre R π n).blowupMap ∣_ (centre R π n).support.compl) ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (g : Spec (.of Ω) ⟶ model R π n),
        Set.range g = {o} →
          ExceptionalGeometry n Ω (pullback.snd (centre R π n).blowupMap g) := by
  sorry

/-- The chart and exceptional descriptions persist under etale pullback, using the
canonical flat-blowup comparison and the inverse-image centre.
Source: Stacks 0805; de Jong Lemma 3.13 proof, p.609
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node step 13): etale maps are flat. The coefficientwise Rees pullback comparison
is therefore an isomorphism (thm-nagata-blowup-flat-base-change). It is over U, so it
identifies each pulled-back open chart and its structure map. At a point over o the
exceptional fibre is the calculated exceptional curve after residue-field extension.
Extend to any algebraically closed geometric field to obtain the stated conic or pair
of projective lines. The complement statement is lemma-nagata-affine-blowup-complement.

Expanded DAG proof, retaining the complete argument:

Step 13. The affine blowup-complement lemma identifies the blowup with $M_n$ off $V(I)=\{o\}$. For
any etale $e:U\to M_n$, flatness is part of the etale definition. The flat blowup comparison of
the cited construction is therefore defined, and the flat-base-change theorem says it is an
isomorphism $\operatorname{Bl}_{IU}(U)\simeq U\times_{M_n}B_n$. Restricting this isomorphism to
the three covering opens gives precisely the pulled-back chart rings and maps. Its fibre at a
point $u\in U$ over $o$ is $B_n\times_{M_n}\operatorname{Spec}\kappa(u)$, hence the exceptional
fibre of steps 10--12 with coefficients extended from $k$ to $\kappa(u)$. Its geometric fibre is
accordingly the conic or pair of projective lines already calculated.
Uses: lemma-nagata-affine-blowup-complement, def-weil-etale-morphism,
def-nagata-blowup-flat-base-change-map, thm-nagata-blowup-flat-base-change.
-/
theorem etale_blowup (R : CommRingCat.{u}) [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (n : ℕ) (hn : 2 ≤ n) (o : model R π n) (ho : IsOrigin R π n o)
    {U : Scheme.{u}} (e : U ⟶ model R π n) [Etale e] :
    IsIso ((centre R π n).blowupFlatBaseChange e) ∧
    ∀ (u : U), e u = o →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (g : Spec (.of Ω) ⟶ U),
        Set.range g = {u} →
          ExceptionalGeometry n Ω
            (pullback.snd ((centre R π n).comap e).blowupMap g) := by
  sorry

/-- Near a chosen point in a common pointed etale model, the inverse-image centre is
exactly the reduced point, so the same blowup comparison and exceptional description
apply to blowing up that point itself.
Source: Stacks 00FR, 033G and 0805; de Jong Lemma 3.13 proof, p.609
(blueprint: lem-sfb-dvr-nodal-chart-blowup-calculus).

Proof (node step 15): the etale fibre over o is locally Noetherian, zero dimensional,
and reduced. In an affine neighbourhood it has finitely many points, since all primes
are minimal (lem-weil-pbc-noetherian-finitely-many-minimal-primes). Remove the other
fibre points. The remaining reduced one-point fibre is a field, so its ideal is the
reduced-point ideal, not a thickening. Apply etale_blowup to this open neighbourhood.
The other leg of a common pointed etale neighbourhood transports the local properties
by pointed_etale_properties; no isomorphism of the point residue fields is assumed.

Expanded DAG proof, retaining the complete argument:

Step 15. Finally take a common pointed etale neighbourhood and the reduced point in it lying over
$o$. After shrinking around that point, the inverse image of $o$ is exactly this reduced point as
a subscheme. To see this, choose an affine etale chart: its fibre over $o$ is a finite type
$k$-algebra and therefore Noetherian. Etale local dimension invariance makes all its local
dimensions zero. Thus every prime is minimal and maximal; the Noetherian minimal-prime finiteness
lemma makes its set of points finite. Remove the other fibre points. Normal ascent from the field
$k$ shows the fibre is reduced; the remaining one-point ring is a field, because a
zero-dimensional normal local domain has zero maximal ideal. Hence its ideal is exactly the ideal
of the reduced point. The blowup comparison of step 13 now applies to this centre, and the
local-property comparisons of step 14 apply to the models and the common neighbourhood. This
proves the last pointed-neighbourhood clause with the actual reduced centre, without replacing it
by a thickening or using completions of $R$.
Uses: lem-weil-pbc-etale-base-change-finite-limits, lem-weil-pbc-finite-type-algebra-noetherian,
lem-sc-etale-local-dimension, lem-weil-pbc-noetherian-finitely-many-minimal-primes,
lem-weil-pbc-etale-over-normal-ring-normal, thm-nagata-blowup-flat-base-change.
-/
theorem pointed_reduced_centre (R : CommRingCat.{u})
    [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (n : ℕ) (hn : 2 ≤ n) (o : model R π n) (ho : IsOrigin R π n o)
    {X Y W : Scheme.{u}} (f : X ⟶ Spec R) (g : Y ⟶ Spec R)
    (a : W ⟶ X) (b : W ⟶ Y) [Etale a] [Etale b]
    (hover : a ≫ f = b ≫ g) (c : Y ⟶ model R π n) [Etale c]
    (hc : c ≫ projection R π n = g) (w : W) (hw : c (b w) = o) :
    ∃ (V : W.Opens) (v : V.toScheme), V.ι v = w ∧
      IsClosed ({v} : Set V.toScheme) ∧
      (centre R π n).comap (V.ι ≫ b ≫ c) =
        Scheme.IdealSheafData.vanishingIdeal ⟨closure ({v} : Set V.toScheme),
          isClosed_closure⟩ ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (q : Spec (.of Ω) ⟶ V.toScheme),
        Set.range q = {v} →
          ExceptionalGeometry n Ω
            (pullback.snd ((centre R π n).comap (V.ι ≫ b ≫ c)).blowupMap q) := by
  sorry

end AlgebraicGeometry.DvrNodal
