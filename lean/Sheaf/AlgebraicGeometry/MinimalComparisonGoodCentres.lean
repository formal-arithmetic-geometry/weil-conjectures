/-! # Good centres in a minimum-length comparison

Source: Stacks Project, resolve.tex, Tags 0C5S and 0C5J, with the agent
minimum-length refinement recorded in the DAG
(blueprint: lem-sfb-minimal-comparison-good-centres).
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

/-- A shortest point-blowup comparison of two regular nodal models uses only smooth
special-fibre centres whose residue extensions are finite and separable. The generic
identification is fixed in both the given comparison and every competitor. The ordinary
tower includes its initial isomorphism and actual composites; its ideals here are exactly
the reduced closed point ideals. No connectedness of geometric fibres is required.

Source: Stacks Project, resolve.tex, Tags 0C5S and 0C5J, the agent refinement in
(blueprint: lem-sfb-minimal-comparison-good-centres).

Proof plan:
1. Nodal-trait-finite-singular-charts gives Noetherianity and local dimension two at
   closed special points. Flatness makes the generic open dense. Regular-point-blowup-
   geometry and point-blowup-fibre-defects propagate integral regular Noetherian surface
   geometry through the tower. Projective-implies-proper and proper-to-separated-target
   make the second map proper and birational. Closed-point-field gives finiteness of
   every centre residue field over the trait residue field.
2. Regular-trait-curve-surface-components makes the local ring of each special-fibre
   component of the second model a DVR with maximal ideal generated by the uniformizer.
   Normal-modification-codimension-one makes the comparison an isomorphism near that
   generic point. Thus every component of multiplicity greater than one is contracted.
   An exceptional component with inseparable constant field is contracted as well:
   otherwise its function field is that of a geometrically reduced component, contrary
   to birational-cartier-geometric-reduction, since inseparable constants create a
   nonzero nilpotent after extension to an algebraic closure.
3. Take the first bad centre. Before it, point-blowup-fibre-defects preserves nodality.
   A nonsmooth centre creates multiplicity two; an inseparable smooth centre creates
   an exceptional line with inseparable constants. Follow its strict transform and
   replace it by a new exceptional component whenever a later centre meets it.
   The persistence clauses keep it bad. Birth indices strictly increase, so the process
   ends with a contracted exceptional component untouched by all later blowups.
4. Delete-untouched-point-blowup gives a comparison shorter by one, over the same base
   and with the same generic identification. This contradicts minimality. Hence all
   centres are smooth and separable; step 1 gives finiteness. For length zero there
   are no centres and the assertion is vacuous.
-/
theorem minimal_comparison_good_centres
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (T₁ T₂ : Over (Spec (.of R))) [IsIntegral T₁.left] [IsIntegral T₂.left]
    (hregular₁ : IsRegularScheme T₁.left) (hregular₂ : IsRegularScheme T₂.left)
    (hdim₁ : topologicalKrullDim T₁.left = 2)
    (hdim₂ : topologicalKrullDim T₂.left = 2)
    [IsHProjective T₁.hom] [IsHProjective T₂.hom]
    [Flat T₁.hom] [Flat T₂.hom]
    [LocallyOfFinitePresentation T₁.hom] [LocallyOfFinitePresentation T₂.hom]
    (hnodal₁ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (g : Spec (.of Ω) ⟶ Spec (.of R)),
      Nonempty ↥(pullback T₁.hom g) ∧ IsReduced (pullback T₁.hom g) ∧
      (pullback T₁.hom g).IsPureDimension 1 ∧
      ∀ x : ↥(pullback T₁.hom g), IsClosed ({x} : Set ↥(pullback T₁.hom g)) →
        (¬ ∃ U : (pullback T₁.hom g).Opens,
          x ∈ U ∧ Smooth (U.ι ≫ pullback.snd T₁.hom g)) →
        IsGeometricOrdinaryDoublePoint Ω (pullback T₁.hom g) x)
    (hnodal₂ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (g : Spec (.of Ω) ⟶ Spec (.of R)),
      Nonempty ↥(pullback T₂.hom g) ∧ IsReduced (pullback T₂.hom g) ∧
      (pullback T₂.hom g).IsPureDimension 1 ∧
      ∀ x : ↥(pullback T₂.hom g), IsClosed ({x} : Set ↥(pullback T₂.hom g)) →
        (¬ ∃ U : (pullback T₂.hom g).Opens,
          x ∈ U ∧ Smooth (U.ι ≫ pullback.snd T₂.hom g)) →
        IsGeometricOrdinaryDoublePoint Ω (pullback T₂.hom g) x)
    [Smooth (pullback.snd T₁.hom (Spec.map (CommRingCat.ofHom (algebraMap R K))))]
    [Smooth (pullback.snd T₂.hom (Spec.map (CommRingCat.ofHom (algebraMap R K))))]
    (α : (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)))).obj T₁ ≅
      (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)))).obj T₂)
    (A : OrdinaryBlowupTower T₁.left)
    (p : ∀ j : Fin A.length, A.level j.castSucc)
    (hp : ∀ j : Fin A.length, IsClosed ({p j} : Set (A.level j.castSucc)))
    (hcentre : ∀ j : Fin A.length, A.center j = SurfacePointBlowup.pointIdeal (p j) (hp j))
    (hspecial : ∀ j : Fin A.length,
      (A.toBase j.castSucc ≫ T₁.hom) (p j) = IsLocalRing.closedPoint R)
    (q₂ : Over.mk (A.toBase (Fin.last A.length) ≫ T₁.hom) ⟶ T₂)
    (hgeneric : (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)))).map q₂ =
      (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)))).map
        (Over.homMk (A.toBase (Fin.last A.length)) rfl) ≫ α.hom)
    (hminimal : ∀ (B : OrdinaryBlowupTower T₁.left)
      (p' : ∀ j : Fin B.length, B.level j.castSucc)
      (hp' : ∀ j : Fin B.length, IsClosed ({p' j} : Set (B.level j.castSucc))),
      (∀ j : Fin B.length, B.center j = SurfacePointBlowup.pointIdeal (p' j) (hp' j)) →
      (∀ j : Fin B.length,
        (B.toBase j.castSucc ≫ T₁.hom) (p' j) = IsLocalRing.closedPoint R) →
      ∀ q'₂ : Over.mk (B.toBase (Fin.last B.length) ≫ T₁.hom) ⟶ T₂,
        (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)))).map q'₂ =
          (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)))).map
            (Over.homMk (B.toBase (Fin.last B.length)) rfl) ≫ α.hom →
        A.length ≤ B.length) :
    ∀ j : Fin A.length,
      (∃ U : (A.level j.castSucc).Opens,
        p j ∈ U ∧ Smooth (U.ι ≫ A.toBase j.castSucc ≫ T₁.hom)) ∧
      (SurfacePointBlowup.residueMap (A.toBase j.castSucc ≫ T₁.hom)
        (p j) (hspecial j)).hom.Finite ∧
      @Algebra.IsSeparable
        ((Spec (.of R)).residueField (IsLocalRing.closedPoint R))
        ((A.level j.castSucc).residueField (p j)) _ _
        (SurfacePointBlowup.residueMap (A.toBase j.castSucc ≫ T₁.hom)
          (p j) (hspecial j)).hom.toAlgebra := by
  sorry

end AlgebraicGeometry
