/-! # Étale pullback and ringed chart localization for algebraic spaces

Source: Stacks Project, Properties of Spaces, Tags 04K2, 04M1, 04M4, 04M5
(blueprint: lem-sfb-space-etale-pullback-chart-comparison).
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u w

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}}

/-- The scheme-object étale site is subcanonical.
Source: Stacks 03G0, 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: a matching family of maps into an étale scheme glues uniquely in its fppf
representable sheaf. Étale coverings are fppf coverings; uniqueness also checks
that the glued map is over the base space. The same argument applies to the
covering topology generated by these families. -/
@[instance] theorem etaleSite_subcanonical (X : AlgebraicSpace S) :
    X.etaleTopology.Subcanonical := by
  sorry

/-- Subcanonicality on the enlarged site, including targets that are not schemes.
Source: Stacks 03G0, 03G1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: refine a space covering by surjective étale scheme atlases of its members.
Maps on these schemes glue uniquely because the target space is an fppf sheaf.
They agree on overlaps and on every test scheme, hence descend to the covered
space. Uniqueness in the base space checks the relative condition. -/
@[instance] theorem enlargedEtaleSite_subcanonical (X : AlgebraicSpace S) :
    X.enlargedEtaleTopology.Subcanonical := by
  sorry

/-- The inverse image on scheme sites, transported from the actual base-change functor.
Source: Stacks 03G2, 04K2 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceEtaleInverse {X Y : AlgebraicSpace S} (f : X ⟶ Y) :
    Sheaf Y.etaleTopology (Type (max (u + 1) w)) ⥤
      Sheaf X.etaleTopology (Type (max (u + 1) w)) :=
  (enlargedSetEquivalence.{u, w} Y).inverse ⋙
    (enlargedBaseChange f).sheafPullback (Type (max (u + 1) w)) _ _ ⋙
      (enlargedSetEquivalence.{u, w} X).functor

/-- Its adjunction to the recorded small-site direct image.
Source: Stacks 03G2 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceEtaleAdjunction {X Y : AlgebraicSpace S} (f : X ⟶ Y) :
    spaceEtaleInverse.{u, w} f ⊣ enlargedSmallDirectImage f :=
  ((enlargedSetEquivalence.{u, w} Y).symm.toAdjunction.comp
    ((enlargedBaseChange f).sheafAdjunctionContinuous _ _ _)).comp
      (enlargedSetEquivalence.{u, w} X).toAdjunction

/-- The sheaf W ↦ Hom_X(W,T), as the restriction of the enlarged Yoneda sheaf.
Source: Stacks 04K2(3) (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceEtaleRepresentables (X : AlgebraicSpace S) :
    X.EnlargedEtaleSite ⥤ Sheaf X.etaleTopology (Type (max (u + 1) w)) :=
  X.enlargedEtaleTopology.uliftYoneda.{max (u + 1) w} ⋙ enlargedRestriction X _

/-- The canonical representable pullback comparison. Its normalization is the
adjunction/Yoneda comparison, transported by the specified restriction equivalences.
Source: Stacks 04K2(3), Sites 04D3
(blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceEtaleRepresentablePullbackIso {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (T : Y.EnlargedEtaleSite) :
    (spaceEtaleInverse.{u, w} f).obj ((spaceEtaleRepresentables Y).obj T) ≅
      (spaceEtaleRepresentables X).obj ((enlargedBaseChange f).obj T) :=
  (enlargedSetEquivalence.{u, w} X).functor.mapIso
    (((enlargedBaseChange f).sheafPullback _ _ _).mapIso
        ((enlargedSetEquivalence.{u, w} Y).unitIso.symm.app
          (Y.enlargedEtaleTopology.uliftYoneda.{max (u + 1) w}.obj T)) ≪≫
      (Adjunction.uliftYonedaCompIso.{max (u + 1) w}
        ((enlargedBaseChange f).sheafAdjunctionContinuous _ _ _)).app T)

/-- The fibre on a localized scheme object: a section with image the specified chart map.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartFibre {X : AlgebraicSpace S} (U : X.EtaleSite)
    (H : Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)) :
    Subfunctor (H.left.over U).obj where
  obj W := {t | H.hom.hom.app (op W.unop.left) t = ULift.up W.unop.hom}
  map {W Z} b t ht := by
    change H.hom.hom.app _ (H.left.obj.map b.unop.left.op t) = _
    rw [NatTrans.naturality_apply, ht]
    change ULift.up (b.unop.left ≫ W.unop.hom) = ULift.up Z.unop.hom
    rw [Over.w]

/-- A chart fibre is a sheaf on the localized site.
Source: Stacks 04M1, Sites 0791
(blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: matching fibre sections glue in H. Their images equal the specified map
locally, hence globally by separatedness of the representable sheaf. Uniqueness
is inherited from H. Coverings in the localized site are exactly the base coverings. -/
theorem spaceChartFibre_isSheaf {X : AlgebraicSpace S} (U : X.EtaleSite)
    (H : Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)) :
    Presheaf.IsSheaf (X.etaleTopology.over U) (spaceChartFibre U H).toFunctor := by
  sorry

/-- The normalized chart functor, on objects and maps, given by taking fibres.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartFibreFunctor {X : AlgebraicSpace S} (U : X.EtaleSite) :
    Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U) ⥤
      Sheaf (X.etaleTopology.over U) (Type (max (u + 1) w)) where
  obj H := ⟨(spaceChartFibre U H).toFunctor, spaceChartFibre_isSheaf U H⟩
  map {H K} a := ⟨{
    app W := TypeCat.ofHom fun t ↦ ⟨a.left.hom.app _ t.val, by
      have ha := congrArg (fun k ↦ k.hom.app (op W.unop.left) t.val) a.w
      exact ha.trans t.property⟩
    naturality W Z b := by
      ext t
      apply Subtype.ext
      exact NatTrans.naturality_apply a.left.hom b.unop.left.op t.val }⟩

/-- The map identifying a scheme representable with its enlarged-site restriction.
Source: Stacks 03G1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeRepresentableMap {X : AlgebraicSpace S} (U : X.EtaleSite) :
    X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U ⟶
      (spaceEtaleRepresentables X).obj ((enlargedSchemeInclusion X).obj U) :=
  ⟨{ app W := TypeCat.ofHom fun a ↦ ULift.up ((enlargedSchemeInclusion X).map a.down)
     naturality W Z b := by
       ext a
       exact congrArg ULift.up ((enlargedSchemeInclusion X).map_comp b.unop a.down) }⟩

/-- Full faithfulness of scheme inclusion identifies these representables.
Source: Stacks 03G1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: Yoneda identifies maps between the two scheme sheaves with scheme maps;
the over-X equations are identical. Thus each displayed map on sections is a
bijection, naturally in the test scheme. -/
@[instance] theorem spaceSchemeRepresentableMap_isIso {X : AlgebraicSpace S}
    (U : X.EtaleSite) : IsIso (spaceSchemeRepresentableMap.{u, w} U) := by
  sorry

/-- The map s of a commuting scheme-chart square, fixed by its two projections.
Source: Stacks 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartSquareMap {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom) :
    X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U ⟶
      (spaceEtaleInverse.{u, w} f).obj
      (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V) :=
  spaceSchemeRepresentableMap U ≫
    (spaceEtaleRepresentables X).map (enlargedChartLift f U V a ha) ≫
    (spaceEtaleRepresentablePullbackIso f ((enlargedSchemeInclusion Y).obj V)).inv ≫
    (spaceEtaleInverse.{u, w} f).map (asIso (spaceSchemeRepresentableMap V)).inv

/-- The germ formula fixing the canonical geometric stalk comparison.
Source: Stacks 04K2(4) (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def SpaceEtaleStalkFormula {X Y : AlgebraicSpace S} (f : X ⟶ Y) {G : Over S}
    (x : yoneda.obj G ⟶ X.obj.obj)
    (e : etaleSetStalk.{u, w} (x ≫ f.hom.hom) ≅
      spaceEtaleInverse f ⋙ etaleSetStalk x) : Prop :=
  ∀ (F : Sheaf Y.etaleTopology (Type (max (u + 1) w)))
    (U : X.PointedEtale x)
    (V : Y.PointedEtale (x ≫ f.hom.hom))
    (a : U.right.obj.left ⟶ V.right.obj.left)
    (ha : yoneda.map a ≫ V.right.obj.hom = U.right.obj.hom ≫ f.hom.hom)
    (_hl : U.hom.left ≫ a = V.hom.left) (t : F.obj.obj (op V.right)),
    e.hom.app F (etaleSetGerm.{u, w} (x ≫ f.hom.hom) F V t) =
      etaleSetGerm.{u, w} x ((spaceEtaleInverse.{u, w} f).obj F) U
        (X.etaleTopology.uliftYonedaEquiv
          (spaceChartSquareMap f U.right V.right a ha ≫
            (spaceEtaleInverse.{u, w} f).map (Y.etaleTopology.uliftYonedaEquiv.symm t)))

/-- Stalk pullback is the unique natural isomorphism with the germ formula.
Source: Stacks 04K2(4) (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: the skyscraper right adjoint sends A to U ↦ Map(lifts_x(U),A).
Its direct image along f is the analogous sheaf for f x: lifts into X ×_Y V
over x are exactly lifts into V over f x. Chain this identification with the
stalk/skyscraper adjunctions and the inverse/direct-image adjunction. Yoneda gives
the natural stalk isomorphism. On [V,v,t] the adjunction formulas send it to the
germ of the pulled-back section on any compatible pointed chart U. Such charts
exist by taking a scheme atlas of X ×_Y V and lifting the geometric point.
Common refinements prove independence; these germs generate the stalk, proving
uniqueness. Ring operations are computed on the same representatives. -/
theorem spaceEtaleStalkIso_existsUnique {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ S)
    (x : yoneda.obj (Over.mk s) ⟶ X.obj.obj) :
    ∃! e : etaleSetStalk.{u, w} (x ≫ f.hom.hom) ≅
      spaceEtaleInverse f ⋙ etaleSetStalk x, SpaceEtaleStalkFormula f x e := by
  sorry

/-- Every arrow in the scheme-object site over a chart is an étale scheme morphism.
Source: Stacks 03FR, 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: both schemes are representable étale over the same space. Pull back to a
scheme atlas of that space; scheme étale cancellation applies there. Étaleness
descends along this étale covering, giving the assertion on the original schemes. -/
theorem spaceChartArrow_etale {X : AlgebraicSpace S} (U : X.EtaleSite) (W : Over U) :
    Etale W.hom.hom.left.left := by
  sorry

/-- The localized scheme-object site, viewed as the ordinary scheme étale site.
It retains the underlying schemes and maps, rather than selecting new charts.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartSite {X : AlgebraicSpace S} (U : X.EtaleSite) :
    Over U ⥤ U.obj.left.left.Etale where
  obj W := MorphismProperty.Over.mk ⊤ W.hom.hom.left.left (spaceChartArrow_etale U W)
  map b := MorphismProperty.Over.homMk b.left.hom.left.left
    (congrArg (fun k ↦ k.hom.left.left) (Over.w b))

/-- The chart site functor is an equivalence preserving exactly the covering sieves.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: postcompose any étale W → U with U → X to obtain its inverse. Yoneda
identifies the triangles and all arrows. Both covering conditions are exactly
jointly surjective étale scheme families. Hence the topologies agree. -/
theorem spaceChartSite_properties {X : AlgebraicSpace S} (U : X.EtaleSite) :
    (spaceChartSite U).IsEquivalence ∧
      (spaceChartSite U).inducedTopology U.obj.left.left.smallEtaleTopology =
        X.etaleTopology.over U := by
  sorry

/-- Restricting along the chart site functor preserves sheaves.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: the preceding site equivalence preserves precisely the covering families,
so the sheaf equalizers on both sites are the same equalizers. -/
@[instance] theorem spaceChartSite_continuous {X : AlgebraicSpace S} (U : X.EtaleSite) :
    (spaceChartSite U).IsContinuous (X.etaleTopology.over U)
      U.obj.left.left.smallEtaleTopology := by
  sorry

/-- Literal restriction from the scheme étale site to its localized space site.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartRestriction {X : AlgebraicSpace S} (U : X.EtaleSite) :
    Sheaf U.obj.left.left.smallEtaleTopology (Type (max (u + 1) w)) ⥤
      Sheaf (X.etaleTopology.over U) (Type (max (u + 1) w)) :=
  (spaceChartSite U).sheafPushforwardContinuous _ _ _

/-- The two canonical chart functors are equivalences.
Source: Stacks 04M1, Sites 0791
(blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: the fibre functor has inverse the sheaf of pairs (chart map, fibre section);
projection to the first coordinate gives its map to h_U. The sheaf condition
and the inverse identities follow on each fibre. The scheme restriction functor
is an equivalence by spaceChartSite_properties, with the same coverings. -/
theorem spaceChartEquivalences {X : AlgebraicSpace S} (U : X.EtaleSite) :
    (spaceChartFibreFunctor.{u, w} U).IsEquivalence ∧
      (spaceChartRestriction.{u, w} U).IsEquivalence := by
  sorry

/-- The canonical equivalence E_X/h_U ≌ Sh(U_et), normalized by the fibre formula.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartEquivalence {X : AlgebraicSpace S} (U : X.EtaleSite) :
    Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U) ≌
      Sheaf U.obj.left.left.smallEtaleTopology (Type (max (u + 1) w)) :=
  (@Functor.asEquivalence _ _ _ _ (spaceChartFibreFunctor U)
    (spaceChartEquivalences U).1).trans
      (@Functor.asEquivalence _ _ _ _ (spaceChartRestriction U)
        (spaceChartEquivalences U).2).symm

/-- Projection on the second coordinate uniquely specifies the restriction comparison.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: each fibre over W → U consists of pairs whose first coordinate is this map.
Projection to the second coordinate commutes with restrictions and sheaf maps,
so defines a natural transformation. The section formula forces uniqueness. -/
theorem spaceChartProjection_existsUnique {X : AlgebraicSpace S} (U : X.EtaleSite) :
    ∃! p : Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U) ⋙
        spaceChartFibreFunctor U ⟶
      X.etaleTopology.overPullback (Type (max (u + 1) w)) U,
      ∀ (F : Sheaf X.etaleTopology (Type (max (u + 1) w))) (W : Over U)
        (t : ((spaceChartFibreFunctor U).obj
          ((Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)).obj F)).obj.obj (op W)),
        (p.app F).hom.app (op W) t =
          (prod.snd : X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U ⨯ F ⟶ F).hom.app
            _ t.val := by
  sorry

/-- Restricting a product over h_U forgets its fixed chart coordinate.
On the structure ring this respects all operations, computed on the second coordinate.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartProjection {X : AlgebraicSpace S} (U : X.EtaleSite) :
    Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U) ⋙
        spaceChartFibreFunctor U ⟶
      X.etaleTopology.overPullback (Type (max (u + 1) w)) U :=
  (spaceChartProjection_existsUnique U).choose

/-- The restriction comparison is invertible, with the chart coordinate as its inverse.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: over a fixed W → U the first coordinate is forced to equal that map.
Projection to the second coordinate and insertion of this fixed first coordinate
are inverse, naturally in W and F. In particular on the ring sheaf this is an
isomorphism of rings, since all operations use the second coordinate. -/
@[instance] theorem spaceChartProjection_isIso {X : AlgebraicSpace S} (U : X.EtaleSite) :
    IsIso (spaceChartProjection.{u, w} U) := by
  sorry

/-- The extended structural ring, faithfully lifted to the sheaf universe and then forgotten.
Source: Stacks 03G8, 03DA (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceEnlargedRingSets (X : AlgebraicSpace S) :
    Sheaf X.enlargedEtaleTopology (Type (max (u + 1) w)) :=
  (sheafCompose X.enlargedEtaleTopology (forget RingCat)).obj
    (chartNormalizedLiftedRing.{u, w} X X.enlargedCotangentStructure)

/-- The small-site structural ring as a set sheaf, with the canonical extension model.
Source: Stacks 03G7, 03H7 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceRingSets (X : AlgebraicSpace S) :
    Sheaf X.etaleTopology (Type (max (u + 1) w)) :=
  (enlargedSetEquivalence.{u, w} X).functor.obj (spaceEnlargedRingSets X)

/-- The structural map, the adjoint transpose of the unique chart-normalized ring map.
The equivalence units here retain the prescribed extension and restriction models.
Source: Stacks 03G8 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceEtaleStructuralMap {X Y : AlgebraicSpace S} (f : X ⟶ Y) :
    (spaceEtaleInverse.{u, w} f).obj (spaceRingSets Y) ⟶ spaceRingSets X :=
  ((spaceEtaleAdjunction f).homEquiv _ _).symm
    ((enlargedSetEquivalence.{u, w} Y).functor.map
      (chartNormalizedUnderlyingMap f (cotangentStructuralMap_existsUnique f).choose ≫
        (enlargedDirectImage f _).map
          ((enlargedSetEquivalence.{u, w} X).unitIso.hom.app (spaceEnlargedRingSets X))))

/-- Regular functions on the ordinary small étale scheme site satisfy descent.
Source: Stacks 03G7, 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: an étale covering of an étale U-scheme is its usual jointly surjective étale
scheme covering. Regular functions satisfy the sheaf equalizer on such coverings.
The generating-pretopology criterion gives the sheaf condition for all covering sieves. -/
theorem spaceSchemeFunctions_isSheaf (U : Scheme.{u}) :
    Presheaf.IsSheaf U.smallEtaleTopology
      ((Scheme.Etale.forget U ⋙ Over.forget U).op ⋙ Scheme.Γ) := by
  sorry

/-- The ordinary étale structural ring of a scheme, retaining regular functions.
Source: Stacks 03G7, 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeFunctions (U : Scheme.{u}) : Sheaf U.smallEtaleTopology CommRingCat.{u} :=
  ⟨(Scheme.Etale.forget U ⋙ Over.forget U).op ⋙ Scheme.Γ, spaceSchemeFunctions_isSheaf U⟩

/-- The underlying set sheaf of the scheme structural ring in the common sheaf universe.
Source: Stacks 03G7, 03DA (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeRingSets (U : Scheme.{u}) :
    Sheaf U.smallEtaleTopology (Type (max (u + 1) w)) :=
  (sheafCompose U.smallEtaleTopology (forget CommRingCat)).obj
    (SheafOfModules.CochainUniverseTransport.ring.{u + 1, u, u, u + 1, w}
      (spaceSchemeFunctions U))

/-- The ordinary scheme étale inverse image, from the canonical base-change functor.
Source: Stacks 03G2, 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeEtaleInverse {U V : Scheme.{u}} (a : U ⟶ V) :
    Sheaf V.smallEtaleTopology (Type (max (u + 1) w)) ⥤
      Sheaf U.smallEtaleTopology (Type (max (u + 1) w)) :=
  letI : (MorphismProperty.Over.pullback @Etale ⊤ a).IsContinuous
      V.smallEtaleTopology U.smallEtaleTopology :=
    Scheme.isContinuous_overPullback @Etale @Etale le_rfl a
  (MorphismProperty.Over.pullback @Etale ⊤ a).sheafPullback _ _ _

/-- Direct image along the ordinary scheme base-change functor.
Source: Stacks 03G2 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeEtaleDirect {U V : Scheme.{u}} (a : U ⟶ V) :
    Sheaf U.smallEtaleTopology (Type (max (u + 1) w)) ⥤
      Sheaf V.smallEtaleTopology (Type (max (u + 1) w)) :=
  letI : (MorphismProperty.Over.pullback @Etale ⊤ a).IsContinuous
      V.smallEtaleTopology U.smallEtaleTopology :=
    Scheme.isContinuous_overPullback @Etale @Etale le_rfl a
  (MorphismProperty.Over.pullback @Etale ⊤ a).sheafPushforwardContinuous _ _ _

/-- The canonical scheme inverse/direct-image adjunction.
Source: Stacks 03G2 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeEtaleAdjunction {U V : Scheme.{u}} (a : U ⟶ V) :
    spaceSchemeEtaleInverse.{u, w} a ⊣ spaceSchemeEtaleDirect a :=
  letI : (MorphismProperty.Over.pullback @Etale ⊤ a).IsContinuous
      V.smallEtaleTopology U.smallEtaleTopology :=
    Scheme.isContinuous_overPullback @Etale @Etale le_rfl a
  (MorphismProperty.Over.pullback @Etale ⊤ a).sheafAdjunctionContinuous _ _ _

/-- Pullback of regular functions uniquely specifies the scheme structural map.
Source: Stacks 03G8, 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: on W → V pull functions back along U ×_V W → W. These maps commute
with restriction by the projection equations of the fibre products. They are
ring homomorphisms, and the displayed values determine every section map. -/
theorem spaceSchemeDirectRingMap_existsUnique {U V : Scheme.{u}} (a : U ⟶ V) :
    ∃! r : spaceSchemeRingSets.{u, w} V ⟶
      (spaceSchemeEtaleDirect a).obj (spaceSchemeRingSets U),
      ∀ (W : V.Etale) (t : Scheme.Γ.obj (op W.left)),
        r.hom.app (op W) (ULift.up t) =
          ULift.up (Scheme.Γ.map (pullback.fst W.hom a).op t) := by
  sorry

/-- The direct structural map is pullback of functions on the scheme fibre products.
Source: Stacks 03G8, 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeDirectRingMap {U V : Scheme.{u}} (a : U ⟶ V) :
    spaceSchemeRingSets.{u, w} V ⟶
      (spaceSchemeEtaleDirect a).obj (spaceSchemeRingSets U) :=
  (spaceSchemeDirectRingMap_existsUnique a).choose

/-- The usual scheme structural map, adjoint to pullback of functions on fibre products.
Source: Stacks 03G8, 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSchemeStructuralMap {U V : Scheme.{u}} (a : U ⟶ V) :
    (spaceSchemeEtaleInverse.{u, w} a).obj (spaceSchemeRingSets V) ⟶
      spaceSchemeRingSets U :=
  ((spaceSchemeEtaleAdjunction a).homEquiv _ _).symm (spaceSchemeDirectRingMap a)

/-- The chart ring identification on the localized site, fixed on every regular function.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: project a fibre section to its ring coordinate, then apply the canonical
extension/restriction counit, which is the identity on regular functions. Its
inverse inserts the fixed chart coordinate and the inverse counit. These commute
with restrictions, addition, multiplication, zero and one, and are inverse.
The component formula forces uniqueness. -/
theorem spaceChartLocalizedRingIso_existsUnique {X : AlgebraicSpace S} (U : X.EtaleSite) :
    ∃! e : (spaceChartFibreFunctor.{u, w} U).obj
        ((Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)).obj (spaceRingSets X)) ≅
      (spaceChartRestriction U).obj (spaceSchemeRingSets U.obj.left.left),
      ∀ (W : Over U)
        (t : ((spaceChartFibreFunctor U).obj
          ((Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)).obj
            (spaceRingSets.{u, w} X))).obj.obj (op W)),
        e.hom.hom.app (op W) t = ULift.up
          (X.enlargedCotangentRestriction.hom.hom.app (op W.left)
            (((prod.snd : X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U ⨯ spaceRingSets X ⟶
              spaceRingSets X).hom.app (op W.left) t.val).down)) := by
  sorry

/-- The canonical identification of the transported slice ring with O_U.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartRingIso {X : AlgebraicSpace S} (U : X.EtaleSite) :
    (spaceChartEquivalence.{u, w} U).functor.obj
        ((Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)).obj (spaceRingSets X)) ≅
      spaceSchemeRingSets U.obj.left.left :=
  (@Functor.asEquivalence _ _ _ _ (spaceChartRestriction U)
    (spaceChartEquivalences U).2).inverse.mapIso
      (spaceChartLocalizedRingIso_existsUnique U).choose ≪≫
    (@Functor.asEquivalence _ _ _ _ (spaceChartRestriction U)
      (spaceChartEquivalences U).2).unitIso.symm.app _

/-- The relocalization inverse image is the actual pullback of arrows in the sheaf slice.
Source: Stacks 04M5, Sites 04IV
(blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartRelocalization {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom) :
    Over (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V) ⥤
      Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U) :=
  Over.post (spaceEtaleInverse.{u, w} f) ⋙ Over.pullback (spaceChartSquareMap.{u, w} f U V a ha)

/-- First projection from the actual relocalization pullback, on any slice object.
Source: Stacks 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartRelocalizationFirst {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom)
    (H : Over (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V)) :
    ((spaceChartRelocalization.{u, w} f U V a ha).obj H).left ⟶
      (spaceEtaleInverse.{u, w} f).obj H.left :=
  pullback.fst ((spaceEtaleInverse.{u, w} f).map H.hom)
    (spaceChartSquareMap.{u, w} f U V a ha)

/-- Projection to the ring coordinate uniquely fixes the relocalized structural map.
Source: Stacks 04M5, Sites 04J8
(blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: the pullback first projection followed by inverse image of the product
second projection and f-sharp is the ring coordinate. Pair it with the pullback
second projection to h_U. The product universal property gives the unique map
over h_U. It preserves ring operations because f-sharp does, and products and
pullbacks compute those operations coordinatewise. -/
theorem spaceChartSliceRingMap_existsUnique {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom) :
    ∃! r : (spaceChartRelocalization.{u, w} f U V a ha).obj
        ((Over.star (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V)).obj (spaceRingSets Y)) ⟶
      (Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)).obj (spaceRingSets X),
      r.left ≫ prod.snd =
        spaceChartRelocalizationFirst f U V a ha
          ((Over.star (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V)).obj (spaceRingSets Y)) ≫
        (spaceEtaleInverse.{u, w} f).map prod.snd ≫ spaceEtaleStructuralMap.{u, w} f := by
  sorry

/-- The relocalized structural map is the first projection followed by f-sharp.
Source: Stacks 04M5, Sites 04J8
(blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartSliceRingMap {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom) :
    (spaceChartRelocalization.{u, w} f U V a ha).obj
        ((Over.star (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V)).obj (spaceRingSets Y)) ⟶
      (Over.star (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)).obj (spaceRingSets X) :=
  (spaceChartSliceRingMap_existsUnique f U V a ha).choose

/-- Evaluation of the chart equivalence is the original fibre, via the restriction counit.
Source: Stacks 04M1 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceChartEvaluationIso {X : AlgebraicSpace S} (U : X.EtaleSite)
    (H : Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)) :
    (spaceChartRestriction U).obj ((spaceChartEquivalence U).functor.obj H) ≅
      (spaceChartFibreFunctor U).obj H :=
  (@Functor.asEquivalence _ _ _ _ (spaceChartRestriction U)
    (spaceChartEquivalences U).2).counitIso.app _

/-- The sectionwise normalization of chart relocalization. A section from any target
chart is sent, after inverse image, to that same section pulled back along the chart square.
The adjunction unit generates the ordinary scheme inverse image; the right side is
specified by the first projection of the actual slice pullback.
Source: Stacks 04M4, 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def SpaceChartComparisonFormula {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom)
    (e : (spaceChartEquivalence.{u, w} V).functor ⋙ spaceSchemeEtaleInverse a.left ≅
      spaceChartRelocalization f U V a ha ⋙ (spaceChartEquivalence U).functor) : Prop :=
  ∀ (H : Over (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V))
    (W : Over U) (Z : Over V) (b : W.left.obj.left ⟶ Z.left.obj.left)
    (hb : yoneda.map b ≫ Z.left.obj.hom = W.left.obj.hom ≫ f.hom.hom)
    (hc : b ≫ Z.hom.hom.left = W.hom.hom.left ≫ a)
    (t : ((spaceChartEquivalence.{u, w} V).functor.obj H).obj.obj
      (op ((spaceChartSite V).obj Z))),
    (spaceChartRelocalizationFirst f U V a ha H).hom.app (op W.left)
      ((((spaceChartEvaluationIso U
        ((spaceChartRelocalization.{u, w} f U V a ha).obj H)).hom.hom.app (op W))
      ((e.hom.app H).hom.app (op ((spaceChartSite U).obj W))
        (((spaceSchemeEtaleInverse.{u, w} a.left).obj
          ((spaceChartEquivalence.{u, w} V).functor.obj H)).obj.map
            (MorphismProperty.Over.homMk
              (pullback.lift b.left W.hom.hom.left.left
                (congrArg (fun k ↦ k.left) hc))
                (pullback.lift_snd _ _ _)).op
            (((spaceSchemeEtaleAdjunction.{u, w} a.left).unit.app
              ((spaceChartEquivalence.{u, w} V).functor.obj H)).hom.app
                (op ((spaceChartSite V).obj Z)) t)))).val) =
        X.etaleTopology.uliftYonedaEquiv
          (spaceChartSquareMap f W.left Z.left b hb ≫
            (spaceEtaleInverse.{u, w} f).map
              (Y.etaleTopology.uliftYonedaEquiv.symm
                (((spaceChartEvaluationIso V H).hom.hom.app (op Z) t).val)))

/-- Chart relocalization agrees with the ordinary scheme inverse image, including
its structural map. The isomorphism is normalized on maps into scheme representables.
Source: Stacks 04M4, 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).

Proof: put P = X ×_Y V and c = (U → X,a): U → P. The enlarged-site representable
comparison identifies slicing along h_V with the base-change morphism P → V.
On every scheme chart of P ×_V W both structural maps pull back the same function
on W. Faithful scheme restriction and chart normalization make the ring maps equal.
The map c is étale, so its inverse image is localization. Their composite is a;
the ringed composition/localization comparison identifies the structural maps as
well. The fibre equivalences above transport this composite to the displayed
pullback-of-arrows functor. Yoneda and the adjunction units normalize the resulting
comparison on every representable. Naturality extends this to every sheaf.
For further chart restrictions the maps into P have the same two projections;
the normalized representable comparisons therefore commute. Slice functoriality
then gives the restriction and composition comparisons, with the same ring maps. -/
theorem spaceEtale_pullback_chart_comparison {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U : X.EtaleSite) (V : Y.EtaleSite) (a : U.obj.left ⟶ V.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom) :
    ∃! e : (spaceChartEquivalence.{u, w} V).functor ⋙ spaceSchemeEtaleInverse a.left ≅
        spaceChartRelocalization f U V a ha ⋙ (spaceChartEquivalence.{u, w} U).functor,
      SpaceChartComparisonFormula f U V a ha e ∧
      (spaceSchemeEtaleInverse.{u, w} a.left).map (spaceChartRingIso V).hom ≫
          spaceSchemeStructuralMap a.left =
        e.hom.app ((Over.star (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V)).obj
          (spaceRingSets Y)) ≫
          (spaceChartEquivalence.{u, w} U).functor.map (spaceChartSliceRingMap f U V a ha) ≫
          (spaceChartRingIso U).hom := by
  sorry

/-- Representable pullback is natural in every enlarged étale target, including
further scheme chart restrictions.
Source: Stacks 04K2(3), 04M5
(blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: the adjunction/Yoneda comparison is natural on enlarged representables.
Whisker its naturality square by restriction, and use the naturality of the two
comparison-equivalence units. This gives exactly the displayed square. -/
theorem spaceEtaleRepresentablePullback_naturality {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    {T T' : Y.EnlargedEtaleSite} (b : T' ⟶ T) :
    (spaceEtaleInverse.{u, w} f).map ((spaceEtaleRepresentables Y).map b) ≫
        (spaceEtaleRepresentablePullbackIso f T).hom =
      (spaceEtaleRepresentablePullbackIso f T').hom ≫
        (spaceEtaleRepresentables X).map ((enlargedBaseChange f).map b) := by
  sorry

/-- The sheaf maps of compatible chart squares commute with further chart restriction.
Source: Stacks 04M5 (blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: the two maps into X ×_Y V have the same X and V projections. They agree
by the fibre-product universal property. Apply naturality of the represented
pullback comparison and the scheme-representable identifications. -/
theorem spaceChartSquareMap_restriction {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U U' : X.EtaleSite) (V V' : Y.EtaleSite)
    (a : U.obj.left ⟶ V.obj.left) (a' : U'.obj.left ⟶ V'.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom)
    (ha' : yoneda.map a' ≫ V'.obj.hom = U'.obj.hom ≫ f.hom.hom)
    (r : U' ⟶ U) (t : V' ⟶ V) (h : r.hom.left ≫ a = a' ≫ t.hom.left) :
    X.etaleTopology.uliftYoneda.{max (u + 1) w}.map r ≫ spaceChartSquareMap.{u, w} f U V a ha =
      spaceChartSquareMap f U' V' a' ha' ≫
        (spaceEtaleInverse f).map (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.map t) := by
  sorry

/-- The first projection of a restriction in a sheaf slice, with its chosen pullback.
Source: Stacks 04IV (blueprint: lem-sfb-space-etale-pullback-chart-comparison). -/
def spaceSliceRestrictionFirst {X : AlgebraicSpace S} {U U' : X.EtaleSite} (r : U' ⟶ U)
    (H : Over (X.etaleTopology.uliftYoneda.{max (u + 1) w}.obj U)) :
    ((Over.pullback (X.etaleTopology.uliftYoneda.{max (u + 1) w}.map r)).obj H).left ⟶ H.left :=
  pullback.fst H.hom (X.etaleTopology.uliftYoneda.{max (u + 1) w}.map r)

/-- Canonical restriction comparison on the actual slices. Its first-coordinate
formula fixes it uniquely; its second coordinate is fixed because it lies over h_U'.
It therefore preserves the restricted structural map as well.
Source: Stacks 04M5, Sites 04IV, 04J8
(blueprint: lem-sfb-space-etale-pullback-chart-comparison).
Proof: both iterated pullbacks consist of the same pairs (inverse-image section,
source-chart section) satisfying the same equation, by the preceding restriction
square. The map preserving these coordinates is invertible and natural. The
structure map in each case is first projection followed by f-sharp, so the same
coordinate equation proves ring compatibility. For identities it is the canonical
pullback identity; under two restrictions both composites preserve the same two
coordinates, giving the successive-restriction law. The section normalization in
SpaceChartComparisonFormula identifies this with restriction of the scheme-chart
comparison, since its unit-generated sections have the same first coordinates. -/
theorem spaceChartRelocalization_restriction {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    (U U' : X.EtaleSite) (V V' : Y.EtaleSite)
    (a : U.obj.left ⟶ V.obj.left) (a' : U'.obj.left ⟶ V'.obj.left)
    (ha : yoneda.map a ≫ V.obj.hom = U.obj.hom ≫ f.hom.hom)
    (ha' : yoneda.map a' ≫ V'.obj.hom = U'.obj.hom ≫ f.hom.hom)
    (r : U' ⟶ U) (t : V' ⟶ V) (h : r.hom.left ≫ a = a' ≫ t.hom.left) :
    ∃! d : spaceChartRelocalization.{u, w} f U V a ha ⋙
          Over.pullback (X.etaleTopology.uliftYoneda.{max (u + 1) w}.map r) ≅
        Over.pullback (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.map t) ⋙
          spaceChartRelocalization.{u, w} f U' V' a' ha',
      ∀ H : Over (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.obj V),
        (d.hom.app H).left ≫
            spaceChartRelocalizationFirst f U' V' a' ha'
              ((Over.pullback (Y.etaleTopology.uliftYoneda.{max (u + 1) w}.map t)).obj H) ≫
            (spaceEtaleInverse.{u, w} f).map
              (spaceSliceRestrictionFirst t H) =
          spaceSliceRestrictionFirst r
              ((spaceChartRelocalization.{u, w} f U V a ha).obj H) ≫
            spaceChartRelocalizationFirst f U V a ha H := by
  sorry

end AlgebraicGeometry.AlgebraicSpace
