module

public import Sheaf.AlgebraicGeometry.FiniteTypeQuasiCoherentSubalgebras
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiSeparated

/-! # Quasi-coherent algebras as directed colimits of finite type subalgebras

Source: Stacks Project, Properties, Lemma 05JT
(blueprint: lem-weil-pbc-algebra-directed-colimit-finite-type).
-/

@[expose] public section

universe uC

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Scheme

/-- A quasi-coherent algebra on a quasi-compact quasi-separated scheme is the directed
colimit, in all commutative algebra sheaves, of its finite type quasi-coherent subalgebras.
Every affine section belongs to one of these subalgebras.
Source: Stacks Project, Properties, Lemma 05JT
(blueprint: lem-weil-pbc-algebra-directed-colimit-finite-type).

Proof:
1. The image of the multiplication map from the tensor product of two members is a
   quasi-coherent subalgebra containing both. On affine opens it is generated by the union
   of their finite generating sets; closure under products and the inclusions extend to
   all opens by the affine basis. Use the quasi-coherent tensor-product and module-image
   lemmas and sheafification for the tensor-product map:
   [lem-weil-pbc-quasi-coherent-tensor-product-affine-sections],
   [lem-weil-pbc-quasi-coherent-module-cokernel-image], [def-pur-sheaf-tensor-product],
   [def-weil-pbc-sheafification], [def-pc-scheme].
2. Express the underlying module as a directed colimit of finitely presented modules
   (01PK). Their symmetric algebras map to A; their images are quasi-coherent finite type
   subalgebras, by the symmetric-algebra and algebra-image lemmas. The affine-section
   colimit lemma implies that every affine section belongs to such an image:
   [lem-weil-pbc-module-directed-colimit-finite-presentation],
   [lem-weil-pbc-quasi-coherent-finite-type-affine],
   [lem-weil-pbc-quasi-coherent-symmetric-algebra],
   [lem-weil-pbc-quasi-coherent-algebra-kernel-image-ideal],
   [lem-weil-pbc-symmetric-algebra-finite-presentation],
   [lem-weil-pbc-quasi-coherent-module-colimit-affine-sections].
3. Those images give nonemptiness; step 1 gives upper bounds for pairs.
4. Take the algebra-sheaf colimit of this system. Its affine sections are the ring colimits.
   The canonical map to A is surjective by step 2 and injective since equality of two
   sections holds in a common upper bound. The sheaf-morphism-on-a-basis lemma makes it
   an isomorphism. Thus A with its inclusion maps is a colimit cocone. Use
   [lem-weil-pbc-quasi-coherent-algebra-colimit], [def-weil-pbc-category-colimit],
   [lem-weil-pbc-filtered-colimit-algebras-elementwise], [def-pc-scheme],
   [lem-weil-pbc-sheaf-morphism-on-basis]. -/
theorem CommAlgebraSheaf.directed_colimit_finiteType
    (X : Scheme.{uC}) [CompactSpace X] [QuasiSeparatedSpace X]
    (A : X.CommAlgebraSheaf) (hA : A.toModule.IsQuasicoherent) :
    (Nonempty A.finiteTypeQuasiCoherentSubalgebras ∧
      Directed (· ≤ ·) (fun B : A.finiteTypeQuasiCoherentSubalgebras ↦ B)) ∧
    (∃ c : Cocone A.finiteTypeQuasiCoherentSubalgebraDiagram,
      ∃ h : c.pt = A, Nonempty (IsColimit c) ∧
        ∀ B : A.finiteTypeQuasiCoherentSubalgebras,
          c.ι.app B ≫ eqToHom h = Subobject.arrow B.val) ∧
    (∀ (U : X.Opens), IsAffineOpen U → ∀ a : A.right.obj.obj (op U),
      ∃ B : A.finiteTypeQuasiCoherentSubalgebras,
        ∃ b : (B.val : X.CommAlgebraSheaf).right.obj.obj (op U),
          (Subobject.arrow B.val).right.hom.app (op U) b = a) := by
  sorry

end AlgebraicGeometry.Scheme
