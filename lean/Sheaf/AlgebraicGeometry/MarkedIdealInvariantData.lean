/-!
# The marked-ideal numerical invariant interface

Source: Bierstone--Milman--Temkin, arXiv:0905.3580, sections 5.1--5.4;
ILO VIII 2.3.11--2.3.13 (blueprint: def-trf-marked-ideal-invariant-data).

The alphabet, all test operations and every condition are actual constructions.
In particular no well-foundedness of the numerical alphabet is assumed.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.MarkedIdeal

/-- The monomial terminal entry (-p,q,A), including the ordered boundary tie breaker.
Source: the explicit monomial construction in the numerical-engine DAG proof, steps 4--5
(blueprint: def-trf-marked-ideal-invariant-data). -/
abbrev MonomialValue := ℤ ×ₗ (ℚ ×ₗ List ℕ)

/-- One fixed tagged, totally ordered alphabet, with a largest infinity terminal.
Source: the numerical-engine DAG proof, step 1
(blueprint: def-trf-marked-ideal-invariant-data). -/
abbrev Entry := ℚ ⊕ₗ (ℕ ⊕ₗ WithTop MonomialValue)

/-- Finite words in the fixed alphabet, compared in the usual lexicographic order.
The empty end marker is the least continuation.
Source: the numerical-engine DAG proof, step 1
(blueprint: def-trf-marked-ideal-invariant-data). -/
abbrev Word := List Entry

/-- A rational normalized-order entry.
Source: BMT section 5.3 (blueprint: def-trf-marked-ideal-invariant-data). -/
def rational (q : ℚ) : Entry := toLex (Sum.inl q)

/-- A nonnegative old-boundary count.
Source: BM birth-history construction, used in BMT section 5.3
(blueprint: def-trf-marked-ideal-invariant-data). -/
def count (s : ℕ) : Entry := toLex (Sum.inr (toLex (Sum.inl s)))

/-- A monomial terminal symbol, with infinity for a zero coefficient ideal.
Source: the numerical-engine DAG proof, steps 2,4
(blueprint: def-trf-marked-ideal-invariant-data). -/
def terminal (g : WithTop MonomialValue) : Entry :=
  toLex (Sum.inr (toLex (Sum.inr g)))

/-- The interleaved positive residual-order and old-boundary-count blocks.
Source: the numerical-engine DAG proof, step 2
(blueprint: def-trf-marked-ideal-invariant-data). -/
def blocks (b : List (ℚ × ℕ)) : Word := b.flatMap (fun p ↦ [rational p.1, count p.2])

/-- Simultaneous value assignments on all finite controlled histories and their cosupport.
Source: BMT Remark 5.1 (blueprint: def-trf-marked-ideal-invariant-data). -/
abbrev ValueFamily := ∀ {n : ℕ} (H : History.{u} n), H.last.cosupport → Word

/-- The full maximum locus, without choosing a maximum value or a reduced structure.
Source: the numerical-engine DAG proof, steps 6--7
(blueprint: def-trf-marked-ideal-invariant-data). -/
def maximumLocus (ν : ValueFamily.{u}) {n : ℕ} (H : History.{u} n) : Set H.last.marked.N :=
  {x | ∃ hx : x ∈ H.last.cosupport, ∀ y : H.last.cosupport, ν H y ≤ ν H ⟨x, hx⟩}

/-- A nonempty maximum step blows up exactly the full maximum locus.
Source: the numerical-engine DAG proof, steps 6--8
(blueprint: def-trf-marked-ideal-invariant-data). -/
def IsMaximumStep (ν : ValueFamily.{u}) {n : ℕ} {H : History.{u} n}
    {K : History.{u} (n + 1)} (E : Extension H K) : Prop :=
  H.last.cosupport.Nonempty ∧ Set.range E.centerMap = maximumLocus ν H

/-- An empty step retains the history with its empty exceptional member.
Source: BMT smooth functoriality with empty centers; numerical-engine proof step 10
(blueprint: def-trf-marked-ideal-invariant-data). -/
def IsEmptyStep {n : ℕ} {H : History.{u} n} {K : History.{u} (n + 1)}
    (E : Extension H K) : Prop := Set.range E.centerMap = ∅

/-- Precisely the class generated by initial histories, full-maximum steps, empty
stages and smooth pullbacks. Including empty stages permits synchronized local charts
that do not meet the global maximum.
Source: BMT Remark 5.1 and section 6.3; numerical-engine proof steps 3,10
(blueprint: def-trf-marked-ideal-invariant-data). -/
inductive Admissible (ν : ValueFamily.{u}) : ∀ {n : ℕ}, History.{u} n → Prop
  | initial (H : History.{u} 0) : Admissible ν H
  | maximum {n : ℕ} {H : History.{u} n} {K : History.{u} (n + 1)}
      (E : Extension H K) : Admissible ν H → IsMaximumStep ν E → Admissible ν K
  | empty {n : ℕ} {H : History.{u} n} {K : History.{u} (n + 1)}
      (E : Extension H K) : Admissible ν H → IsEmptyStep E → Admissible ν K
  | pullback {n : ℕ} {H K : History.{u} n} (f : HistoryPullback H K) :
      Admissible ν K → Admissible ν H

/-- Normalized monomial candidate data at a point. Exponents are actual factors of
the ideal in the local ring, and the tuple A contains exactly the indicated members.
Source: numerical-engine proof step 4
(blueprint: def-trf-marked-ideal-invariant-data). -/
def MonomialCandidate (A : MarkedIdeal.{u}) (x : A.marked.N)
    (a : Fin A.ambient.boundary.length → ℕ) (s : Finset (Fin A.ambient.boundary.length)) : Prop :=
  (∀ i ∈ s, A.marked.j x ∈ (A.ambient.boundary.get i).support) ∧ A.marked.marking ≤ ∑ i ∈ s, a i

/-- The explicit monomial subset invariant, including minimal size, maximal normalized
sum and maximal ordered tuple, rather than an arbitrary numerical label.
Source: numerical-engine proof steps 4--5
(blueprint: def-trf-marked-ideal-invariant-data). -/
def IsMonomialValue (A : MarkedIdeal.{u}) (x : A.marked.N) (g : MonomialValue) : Prop :=
  ∃ (a : Fin A.ambient.boundary.length → ℕ) (s : Finset (Fin A.ambient.boundary.length)),
    HilbertSamuel.stalkIdeal A.marked.ideal x =
      ∏ i : Fin A.ambient.boundary.length,
        HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x ^ a i ∧
    MonomialCandidate A x a s ∧
    ofLex g = (-(s.card : ℤ), toLex ((∑ i ∈ s, (a i : ℚ)) / A.marked.marking,
      (s.sort (· ≤ ·)).map Fin.val)) ∧
    ∀ t : Finset (Fin A.ambient.boundary.length), MonomialCandidate A x a t →
      s.card ≤ t.card ∧
      (t.card = s.card →
        (∑ i ∈ t, (a i : ℚ)) / A.marked.marking ≤ (∑ i ∈ s, (a i : ℚ)) / A.marked.marking) ∧
      (t.card = s.card → (∑ i ∈ t, a i) = ∑ i ∈ s, a i →
        (t.sort (· ≤ ·)).map Fin.val ≤ (s.sort (· ≤ ·)).map Fin.val)

/-- Logarithmic derivative of an ideal. The derivations preserve each remaining
boundary ideal. Integer-linear derivations on a rational algebra are rational-linear.
Source: BMT section 5.4 (blueprint: def-trf-marked-ideal-invariant-data). -/
def logDerivative {R : Type u} [CommRing R] (E : List (Ideal R)) (J : Ideal R) : Ideal R :=
  J ⊔ Ideal.span {z | ∃ (D : Derivation ℤ R R),
    (∀ K ∈ E, ∀ f ∈ K, D f ∈ K) ∧ ∃ f ∈ J, D f = z}

/-- The coefficient ideal with factorial mark, formed from actual logarithmic
higher derivatives and restricted by the specified local-ring map.
Source: BMT section 5.4; numerical-engine proof step 2
(blueprint: def-trf-marked-ideal-invariant-data). -/
def coefficientIdeal {R S : Type u} [CommRing R] [CommRing S]
    (E : List (Ideal R)) (J : Ideal R) (d : ℕ) (f : R →+* S) : Ideal S :=
  (∑ j ∈ Finset.range d,
    ((logDerivative E)^[j] J) ^ (Nat.factorial d / (d - j))).map f

/-- The local-ring restriction determined by a point over x, with its equality
transport written explicitly.
Source: BMT section 5.4 (blueprint: def-trf-marked-ideal-invariant-data). -/
def localRestriction {X Y : Scheme.{u}} (i : Y ⟶ X) (x : X) (y : Y)
    (h : i y = x) : X.presheaf.stalk x →+* Y.presheaf.stalk y :=
  (i.stalkMap y).hom.comp
    (eqToHom (congrArg (fun z ↦ X.presheaf.stalk z) h.symm)).hom

/-- One residual/companion/coefficient descent, at a point of the retained prefix.
The boundary monomial, residual order, old-boundary augmentation, maximal-order
companion and coefficient ideal are all specified by equations. The next support is
an actual smooth hypersurface; its dimension is strictly smaller at the comparison point.
Source: BMT sections 5.3--5.4 and numerical-engine proof step 2
(blueprint: def-trf-marked-ideal-invariant-data). -/
structure CoefficientReduction (A B : MarkedIdeal.{u}) (x : A.marked.N) (y : B.marked.N)
    (q : ℚ) (s : ℕ) (birthA : Fin A.ambient.boundary.length → ℕ)
    (birthB : Fin B.ambient.boundary.length → ℕ) where
  oldCut : ℕ
  old : Finset (Fin A.ambient.boundary.length)
  ambient : B.ambient.Z ⟶ A.ambient.Z
  openAmbient : IsOpenImmersion ambient
  inclusion : B.marked.N ⟶ A.marked.N
  square : inclusion ≫ A.marked.j = B.marked.j ≫ ambient
  point : inclusion y = x
  restrictedInclusion : B.marked.N ⟶ pullback A.marked.j ambient
  restrictedClosed : IsClosedImmersion restrictedInclusion
  restrictedFactor : restrictedInclusion ≫ pullback.fst A.marked.j ambient = inclusion
  hypersurface : restrictedInclusion.ker.IsInvertible
  dimension : ringKrullDim (B.marked.N.presheaf.stalk y) <
    ringKrullDim (A.marked.N.presheaf.stalk x)
  boundary : B.ambient.boundary =
    ((List.finRange A.ambient.boundary.length).filter (fun i ↦ i ∉ old)).map
      (fun i ↦ (A.ambient.boundary.get i).comap ambient)
  residual : Ideal (A.marked.N.presheaf.stalk x)
  exponent : Fin A.ambient.boundary.length → ℕ
  factorization : HilbertSamuel.stalkIdeal A.marked.ideal x =
    (∏ i : Fin A.ambient.boundary.length,
      HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x ^
        exponent i) * residual
  residualNotDivisible : ∀ i : Fin A.ambient.boundary.length,
    A.marked.j x ∈ (A.ambient.boundary.get i).support →
      ¬ residual ≤ HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x
  residualOrder : ℕ
  positive : 0 < residualOrder
  exactOrder : residual ≤ IsLocalRing.maximalIdeal (A.marked.N.presheaf.stalk x) ^ residualOrder ∧
    ¬ residual ≤ IsLocalRing.maximalIdeal (A.marked.N.presheaf.stalk x) ^ (residualOrder + 1)
  normalized : q = (residualOrder : ℚ) / A.marked.marking
  oldByBirth : ∀ i : Fin A.ambient.boundary.length,
    i ∈ old ↔ birthA i ≤ oldCut ∧ A.marked.j x ∈ (A.ambient.boundary.get i).support
  inheritedBirth : ∀ (j : Fin B.ambient.boundary.length)
    (hj : j.val < ((List.finRange A.ambient.boundary.length).filter (fun i ↦ i ∉ old)).length),
    birthB j = birthA (((List.finRange A.ambient.boundary.length).filter (fun i ↦ i ∉ old))[j.val])
  oldCount : s = old.card
  companion : Ideal (A.marked.N.presheaf.stalk x)
  companionMark : ℕ
  companionFormula :
    (A.marked.marking ≤ residualOrder ∧ companion = residual ∧ companionMark = residualOrder) ∨
    (residualOrder < A.marked.marking ∧
      companion = residual ^ (A.marked.marking - residualOrder) ⊔
        (∏ i : Fin A.ambient.boundary.length,
          HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x ^
            exponent i) ^ residualOrder ∧
      companionMark = residualOrder * (A.marked.marking - residualOrder))
  coefficientMark : B.marked.marking = Nat.factorial companionMark
  coefficientFormula : HilbertSamuel.stalkIdeal B.marked.ideal y =
    coefficientIdeal
      (((List.finRange A.ambient.boundary.length).filter (fun i ↦ i ∉ old)).map
        (fun i ↦ HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x))
      (companion ⊔ ⨆ i ∈ old,
        HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x ^ companionMark)
      companionMark (localRestriction inclusion x y point)
  maximalContact : ∃ z : A.marked.N.presheaf.stalk x,
    z ∈ ((logDerivative
      (((List.finRange A.ambient.boundary.length).filter (fun i ↦ i ∉ old)).map
        (fun i ↦ HilbertSamuel.stalkIdeal
          ((A.ambient.boundary.get i).comap A.marked.j) x)))^[companionMark - 1]
          (companion ⊔ ⨆ i ∈ old,
            HilbertSamuel.stalkIdeal ((A.ambient.boundary.get i).comap A.marked.j) x ^
              companionMark)) ∧
      z ∉ IsLocalRing.maximalIdeal (A.marked.N.presheaf.stalk x) ^ 2 ∧
        RingHom.ker (localRestriction inclusion x y point) = Ideal.span {z}

/-- The terminal cases of the coefficient recursion. A zero ideal has the infinity
symbol; a residual monomial has the explicit ordered subset invariant.
Source: numerical-engine proof steps 2,4--5
(blueprint: def-trf-marked-ideal-invariant-data). -/
def IsTerminal (A : MarkedIdeal.{u}) (x : A.marked.N) : Word → Prop
  | [e] => HilbertSamuel.stalkIdeal A.marked.ideal x = ⊥ ∧ e = terminal ⊤
  | [e, t] => e = rational 0 ∧ ∃ g : MonomialValue,
      IsMonomialValue A x g ∧ t = terminal g
  | _ => False

/-- A finite coefficient recursion certificate for a numerical tail. Every recursive
step lowers support dimension and displays its rational order and boundary count.
The old components are drawn from the retained birth history at the first level.
Source: numerical-engine proof steps 1--3
(blueprint: def-trf-marked-ideal-invariant-data). -/
inductive TailCertificate : (A : MarkedIdeal.{u}) →
    (Fin A.ambient.boundary.length → ℕ) → A.marked.N → Word → Prop
  | terminal (A : MarkedIdeal.{u}) (birth : Fin A.ambient.boundary.length → ℕ)
      (x : A.marked.N) (w : Word) : IsTerminal A x w → TailCertificate A birth x w
  | coefficient (A B : MarkedIdeal.{u}) (birthA : Fin A.ambient.boundary.length → ℕ)
      (birthB : Fin B.ambient.boundary.length → ℕ) (x : A.marked.N) (y : B.marked.N) (q : ℚ) (s : ℕ)
      (w : Word) : Nonempty (CoefficientReduction A B x y q s birthA birthB) →
        TailCertificate B birthB y w →
          TailCertificate A birthA x (rational q :: count s :: w)

/-- A finite synchronized maximum step on a family, allowing empty-center patches.
The maximum is taken over the union, with exactly the same value space on all patches.
Source: numerical-engine proof step 10
(blueprint: def-trf-marked-ideal-invariant-data). -/
def IsSynchronizedStep (ν : ValueFamily.{u}) {r n : ℕ}
    {H : Fin r → History.{u} n} {K : Fin r → History.{u} (n + 1)}
    (E : ∀ i, Extension (H i) (K i)) : Prop :=
  ∃ m : Word,
    (∃ (i : Fin r) (x : (H i).last.cosupport), ν (H i) x = m) ∧
      (∀ (i : Fin r) (x : (H i).last.cosupport), ν (H i) x ≤ m) ∧
      ∀ i : Fin r, Set.range (E i).centerMap =
        {x | ∃ hx : x ∈ (H i).last.cosupport, ν (H i) ⟨x, hx⟩ = m}

/-- A finite family of equivalent local presentations on a common ambient open
cover. On each overlap the whole histories are restricted and then test-identified,
with equal stalk dimensions at corresponding cosupport points and the given birth data.
Source: numerical-engine proof steps 3,10
(blueprint: def-trf-marked-ideal-invariant-data). -/
structure PatchedPresentations {r n : ℕ} (H : Fin r → History.{u} n) where
  Z : Scheme.{u}
  base : Z ⟶ Spec (.of (ULift.{u} ℚ))
  chart : ∀ i, (H i).last.ambient.Z ⟶ Z
  openChart : ∀ i, IsOpenImmersion (chart i)
  overBase : ∀ i, chart i ≫ base = (H i).last.ambient.p
  cover : ∀ z : Z, ∃ (i : Fin r) (x : (H i).last.ambient.Z), chart i x = z
  overlapLeft : Fin r → Fin r → History.{u} n
  overlapRight : Fin r → Fin r → History.{u} n
  left : ∀ i j, HistoryPullback (overlapLeft i j) (H i)
  right : ∀ i j, HistoryPullback (overlapRight i j) (H j)
  leftOpen : ∀ i j, IsOpenImmersion ((left i j).ambient (Fin.last n))
  rightOpen : ∀ i j, IsOpenImmersion ((right i j).ambient (Fin.last n))
  equivalent : ∀ i j, HistoryEquivalence (overlapLeft i j) (overlapRight i j)
  dimension : ∀ (i j : Fin r)
    (x : (overlapLeft i j).last.cosupport) (y : (overlapRight i j).last.cosupport),
    ((equivalent i j).ambient (Fin.last n)).hom ((overlapLeft i j).last.marked.j x.val) =
      (overlapRight i j).last.marked.j y.val →
        ringKrullDim ((overlapLeft i j).last.marked.N.presheaf.stalk x.val) =
          ringKrullDim ((overlapRight i j).last.marked.N.presheaf.stalk y.val)
  cartesian : ∀ i j, IsPullback
    ((left i j).ambient (Fin.last n))
    (((equivalent i j).ambient (Fin.last n)).hom ≫
      (right i j).ambient (Fin.last n)) (chart i) (chart j)

/-- All conditions on the same simultaneous word assignment: geometric recursion,
finite image, semicontinuity, canonical maximum centers, invariance and termination.
Termination is asserted for this process, not for arbitrary descending words.
Source: BMT sections 5.1--5.4; numerical-engine proof steps 1--10
(blueprint: def-trf-marked-ideal-invariant-data). -/
structure NumericalResolution where
  value : ValueFamily.{u}
  finiteImage : ∀ {n : ℕ} (H : History.{u} n), Admissible value H →
    (Set.range (value H)).Finite
  semicontinuous : ∀ {n : ℕ} (H : History.{u} n), Admissible value H →
    ∀ w : Word, IsClosed {x : H.last.cosupport | w ≤ value H x}
  normalized : ∀ {n : ℕ} (H : History.{u} n), Admissible value H →
    H.last.IsMaximalOrder → ∀ x : H.last.cosupport,
      (value H x).head? = some (rational 1)
  recursion : ∀ {n : ℕ} (H : History.{u} n), Admissible value H →
    ∀ x : H.last.cosupport, ∃ h : ℚ,
      0 ≤ h ∧ (value H x).head? = some (rational h) ∧
        TailCertificate H.last (H.birth (Fin.last n)) x.val ((value H x).drop 1)
  outsideCenter : ∀ {n : ℕ} {H : History.{u} n} {K : History.{u} (n + 1)}
    (E : Extension H K), Admissible value H →
      (IsMaximumStep value E ∨ IsEmptyStep E) →
        ∀ (x : K.last.cosupport) (y : H.last.cosupport),
          E.supportMap x.val = y.val → y.val ∉ Set.range E.centerMap → value K x = value H y
  maximumExists : ∀ {n : ℕ} (H : History.{u} n), Admissible value H →
    H.last.cosupport.Nonempty →
      ∃ (K : History.{u} (n + 1)) (E : Extension H K), IsMaximumStep value E
  strictProgress : ∀ {n : ℕ} {H : History.{u} n} {K : History.{u} (n + 1)}
    (E : Extension H K), Admissible value H → IsMaximumStep value E →
      ∀ (x : K.last.cosupport) (y : H.last.cosupport),
        y.val ∈ maximumLocus value H → value K x < value H y
  smoothValues : ∀ {n : ℕ} {H K : History.{u} n} (f : HistoryPullback H K),
    Admissible value K → ∀ (x : H.last.cosupport) (y : K.last.cosupport),
      (f.support (Fin.last n)) x.val = y.val → value H x = value K y
  equivalentTails : ∀ {n : ℕ} {H K : History.{u} n} (e : HistoryEquivalence H K),
    Admissible value H → Admissible value K →
      ∀ (x : H.last.cosupport) (y : K.last.cosupport),
        (e.ambient (Fin.last n)).hom (H.last.marked.j x.val) = K.last.marked.j y.val →
          ringKrullDim (H.last.marked.N.presheaf.stalk x.val) =
            ringKrullDim (K.last.marked.N.presheaf.stalk y.val) →
              (value H x).drop 1 = (value K y).drop 1
  termination : ¬ ∃ (H : ∀ n : ℕ, History.{u} n)
    (E : ∀ n : ℕ, Extension (H n) (H (n + 1))),
      ∀ n : ℕ, IsMaximumStep value (E n)
  synchronizedExists : ∀ {r n : ℕ} (H : Fin r → History.{u} n),
    Nonempty (PatchedPresentations H) → (∀ i, Admissible value (H i)) →
      (∃ i, (H i).last.cosupport.Nonempty) →
      ∃ (K : Fin r → History.{u} (n + 1)) (E : ∀ i, Extension (H i) (K i)),
        IsSynchronizedStep value E
  patchedCenters : ∀ {r n : ℕ} {H : Fin r → History.{u} n}
    {K : Fin r → History.{u} (n + 1)} (P : PatchedPresentations H)
    (E : ∀ i, Extension (H i) (K i)),
    (∀ i, Admissible value (H i)) → IsSynchronizedStep value E →
      ∃ J : P.Z.IdealSheafData,
        (∀ i, J.comap (P.chart i) =
          ((K i).step (Fin.last n)).step.center.comap
            (eqToHom (congrArg (fun A : MarkedIdeal.{u} ↦ A.ambient.Z)
              ((E i).states (Fin.last n))))) ∧
        Smooth (J.subschemeι ≫ P.base)
  synchronizedProgress : ∀ {r n : ℕ} {H : Fin r → History.{u} n}
    {K : Fin r → History.{u} (n + 1)} (E : ∀ i, Extension (H i) (K i)),
    Nonempty (PatchedPresentations H) →
    (∀ i, Admissible value (H i)) → IsSynchronizedStep value E →
      ∀ m : Word,
        (∃ (i : Fin r) (x : (H i).last.cosupport), value (H i) x = m) →
        (∀ (i : Fin r) (x : (H i).last.cosupport), value (H i) x ≤ m) →
        ∀ (i : Fin r) (x : (K i).last.cosupport), value (K i) x < m
  synchronizedTermination : ∀ r : ℕ, ¬ ∃ (H : ∀ n : ℕ, Fin r → History.{u} n)
    (E : ∀ (n : ℕ) (i : Fin r), Extension (H n i) (H (n + 1) i)),
      (∀ n : ℕ, Nonempty (PatchedPresentations (H n))) ∧
        ∀ n : ℕ, IsSynchronizedStep value (E n)
  noFixedPrefixTail : ∀ p : Word, ¬ ∃ (H : ∀ n : ℕ, History.{u} n)
    (E : ∀ n : ℕ, Extension (H n) (H (n + 1))),
      (∀ n : ℕ, IsMaximumStep value (E n)) ∧
        ∀ n : ℕ, ∃ x : (H n).last.cosupport, p.IsPrefix (value (H n) x)

end AlgebraicGeometry.MarkedIdeal
