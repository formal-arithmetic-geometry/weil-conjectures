module
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
public import WeilConjectures.AlgebraicGeometry.PicardFunctor
/-!
# Finite type descent of compact opens
Source: Stacks Project, Varieties, Lemma Tag 0388 (`lemma-descend-open`).
(blueprint: lem-weil-pbc-descended-qc-neighborhood).
-/
@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry
/-- A point in an arbitrary open after base change has a descended compact neighborhood.
Source: Stacks Project, Varieties, proof of Tag 0388 (`lemma-descend-open`),
the single-principal-open instance of the finite-coefficient construction.
(blueprint: lem-weil-pbc-descended-qc-neighborhood).

Proof: Choose an affine open `U = Spec R` of `X` containing the image of `x`.
Its base change is the open inverse image of `U`, identified with `Spec (R ⊗[k] A)`.
Choose a principal open `D(t)` containing `x` inside `V` in this chart. Express `t`
as a finite sum of pure tensors and let `B` be generated by their second factors.
The same sum over `B` gives `t' : R ⊗[k] B` mapping to `t`. The image of `D(t')`
in `X_B` is open, and compact since the principal open is affine and its inclusion
is continuous. The inverse image of this open under the canonical projection is
`D(t)`: the projection preserves the chart and the tensor map sends `t'` to `t`.
This contains `x` and lies inside `V`. No compactness of `V` or its intersection
with the chart is used. -/
theorem exists_descended_qc_neighborhood (k : Type u) [Field k] (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) (A : Type u) [CommRing A] [Algebra k A]
    (V : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k A)))).Opens)
    (x : ↥(pullback f (Spec.map (CommRingCat.ofHom (algebraMap k A)))))
    (hx : x ∈ V) :
    ∃ (B : Subalgebra k A), B.FG ∧
      ∃ (W : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k B)))).Opens),
        IsCompact W.1 ∧
        let π := baseChangeMap f
          (Over.homMk (Spec.map (CommRingCat.ofHom (Subalgebra.val B)))
            (by
              change Spec.map (CommRingCat.ofHom (Subalgebra.val B)) ≫
                  Spec.map (CommRingCat.ofHom (algebraMap k B)) =
                Spec.map (CommRingCat.ofHom (algebraMap k A))
              rw [← Spec.map_comp]
              congr 1) :
            Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k A))) ⟶
              Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k B))))
        x ∈ π ⁻¹ᵁ W ∧ π ⁻¹ᵁ W ≤ V := by sorry

end AlgebraicGeometry
