module

public import WeilConjectures.CategoryTheory.GrothendieckAbelian.ConcreteCoefficients
public import WeilConjectures.CategoryTheory.GrothendieckAbelian.HasColimitsOfShape
public import Mathlib.Algebra.Category.ModuleCat.Adjunctions
public import WeilConjectures.Mathlib.AlgebraicGeometry.Sites.EtalePoint

/-!
# Finite affine sections generating one geometric stalk

Source: Stacks Project, Tag 095N, finite generation at a fixed geometric point.
(blueprint: lem-weil-pbc-affine-free-finite-stalk-generation).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Scheme

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

private theorem represents_affine_stalk_element
    (X : Scheme.{u}) (Λ : Type (u + 1)) [CommRing Λ]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) (x : X)
    (y : ((pointSmallEtale (X.algClosurePoint x)).sheafFiber
      (A := ModuleCat.{u + 1} Λ)).obj F) :
    let P : X.Etale → Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ) := fun W =>
      (presheafToSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
        (uliftYoneda.{u + 1}.obj W ⋙ ModuleCat.free Λ)
    ∃ (W : X.Etale) (_ : IsAffine W.left) (f : P W ⟶ F),
      y ∈ LinearMap.range
        (((pointSmallEtale (X.algClosurePoint x)).sheafFiber
          (A := ModuleCat.{u + 1} Λ)).map f).hom := by
  classical
  have : PreservesFilteredColimitsOfSize.{u, u}
      (CategoryTheory.forget (ModuleCat.{u + 1} Λ)) :=
    preservesFilteredColimitsOfSize_shrink.{u, u + 1, u, u + 1} _
  let Φ := pointSmallEtale (X.algClosurePoint x)
  obtain ⟨V, v, z, hz⟩ := Φ.toPresheafFiber_jointly_surjective (P := F.obj) y
  change Over.mk (X.algClosurePoint x) ⟶ Over.mk V.hom at v
  obtain ⟨R, j, hj, hmem, _⟩ := exists_affine_mem_range_and_range_subset
    (x := v.left.base (default : Spec (.of (AlgebraicClosure (X.residueField x)))))
    (U := ⊤) (by simp)
  have : Subsingleton (Over.mk (X.algClosurePoint x)).left := by
    change Subsingleton (Spec (.of (AlgebraicClosure (X.residueField x))))
    infer_instance
  have hrange : Set.range v.left.base ⊆ Set.range j.base := by
    rintro _ ⟨a, rfl⟩
    rwa [Subsingleton.elim a
      (default : Spec (.of (AlgebraicClosure (X.residueField x))))]
  let l : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶ Spec R :=
    IsOpenImmersion.lift j v.left hrange
  have hl : l ≫ j = v.left := IsOpenImmersion.lift_fac j v.left hrange
  let W : X.Etale := Scheme.Etale.mk (j ≫ V.hom)
  let k : W ⟶ V := MorphismProperty.Over.homMk j rfl
  let w : Φ.fiber.obj W := Over.homMk l (by
    change l ≫ (j ≫ V.hom) = X.algClosurePoint x
    rw [← Category.assoc, hl]
    exact Over.w v)
  have hw : Φ.fiber.map k w = v := by
    apply Over.OverMorphism.ext
    exact hl
  let z' := F.obj.map k.op z
  have hz' : Φ.toPresheafFiber W w F.obj z' = y := by
    rw [← hz, ← hw]
    exact congrArg (fun f => f z)
      (Φ.toPresheafFiber_w k w F.obj)
  let B := uliftYoneda.{u + 1}.obj W ⋙ ModuleCat.free Λ
  let η : B ⟶ F.obj :=
    { app := fun V => ModuleCat.freeDesc
        (↾fun h => F.obj.map h.down.op z')
      naturality := by
        intro V V' q
        apply ModuleCat.free_hom_ext
        intro h
        simp [B] }
  let f : (presheafToSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj B ⟶ F :=
    ⟨sheafifyLift X.smallEtaleTopology η F.property⟩
  let a := ((toSheafify X.smallEtaleTopology B).app (op W))
    (ModuleCat.freeMk (ULift.up (𝟙 W)))
  have ha : f.hom.app (op W) a = z' := by
    have hh := congrArg (fun q => q.app (op W))
      (toSheafify_sheafifyLift X.smallEtaleTopology η F.property)
    have hh' := congrArg (fun q => q (ModuleCat.freeMk (ULift.up (𝟙 W)))) hh
    change f.hom.app (op W) a = η.app (op W) (ModuleCat.freeMk (ULift.up (𝟙 W))) at hh'
    rw [hh']
    exact (ModuleCat.freeDesc_apply
      (↾fun h : ULift.{u + 1} (W ⟶ W) => F.obj.map h.down.op z')
        (ULift.up (𝟙 W))).trans (by simp)
  refine ⟨W, (by change IsAffine (Spec R); infer_instance), f,
    (Φ.toPresheafFiber W w (sheafify X.smallEtaleTopology B)).hom a, ?_⟩
  have hh := Φ.toPresheafFiber_naturality f.hom W w
  have hh' := congrArg (fun q => q a) hh
  change (Φ.presheafFiber.map f.hom).hom
    ((Φ.toPresheafFiber W w (sheafify X.smallEtaleTopology B)).hom a) = y
  exact hh'.trans (by rw [ModuleCat.comp_apply, ha, hz'])

/-- A finitely generated geometric stalk is generated by finitely many maps from
sheafified affine free representables. No constructibility or compactness is needed.

Source: Stacks Project, Tag 095N, the sentence using finite type of geometric stalks,
and Tag 03DI (the free representable adjunction).
(blueprint: lem-weil-pbc-affine-free-finite-stalk-generation).

Proof: Choose finitely many module generators of the stalk. Each is represented by a
section on a pointed etale neighbourhood, by the filtered-colimit description of the
stalk. Shrink that neighbourhood to an affine open containing the marked point. The
free-module and sheafification adjunctions turn this section into a map from P_W to F.
On the geometric stalk, the free generator at the chosen lift maps to the chosen germ.
The resulting finite coproduct map is therefore surjective. Remove repeated pairs (W,map)
to obtain a finite set without changing the span of their germs. A zero stalk permits
the empty set, so neither nonemptiness of X nor nonzeroness of Λ is needed. -/
theorem exists_finset_affine_free_stalk_surjective
    (X : Scheme.{u}) (Λ : Type (u + 1)) [CommRing Λ]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) (x : X)
    (hx : Module.Finite Λ
      (((pointSmallEtale (X.algClosurePoint x)).sheafFiber
        (A := ModuleCat.{u + 1} Λ)).obj F)) :
    let P : X.Etale → Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ) := fun W =>
      (presheafToSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
        (uliftYoneda.{u + 1}.obj W ⋙ ModuleCat.free Λ)
    let I := Σ W : {W : X.Etale // IsAffine W.left}, P W.val ⟶ F
    ∃ S : Finset I, Function.Surjective
      (((pointSmallEtale (X.algClosurePoint x)).sheafFiber
        (A := ModuleCat.{u + 1} Λ)).map
          (Sigma.desc (fun i : S => i.val.2)))  := by
  classical
  let P : X.Etale → Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ) := fun W =>
    (presheafToSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
      (uliftYoneda.{u + 1}.obj W ⋙ ModuleCat.free Λ)
  let Q := (pointSmallEtale (X.algClosurePoint x)).sheafFiber
    (A := ModuleCat.{u + 1} Λ)
  let I := Σ W : {W : X.Etale // IsAffine W.left}, P W.val ⟶ F
  obtain ⟨T, hT⟩ := hx.fg_top
  choose W hW f hf using fun i : T => represents_affine_stalk_element X Λ F x i.val
  let pair (i : T) : I := ⟨⟨W i, hW i⟩, f i⟩
  let S : Finset I := Finset.univ.image pair
  let g : (∐ fun i : S => P i.val.1.val) ⟶ F := Sigma.desc (fun i : S => i.val.2)
  refine ⟨S, ?_⟩
  have hrange : (T : Set (Q.obj F)) ⊆ LinearMap.range (Q.map g).hom := by
    intro y hy
    let i : T := ⟨y, hy⟩
    obtain ⟨z, hz⟩ := hf i
    have hi : pair i ∈ S := Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
    refine ⟨(Q.map (Sigma.ι (fun j : S => P j.val.1.val) ⟨pair i, hi⟩)).hom z, ?_⟩
    have hc := congrArg (fun k => (Q.map k).hom z)
      (Sigma.ι_desc (fun j : S => j.val.2) ⟨pair i, hi⟩)
    simpa only [Functor.map_comp, ModuleCat.comp_apply] using hc.trans hz
  have ht : (⊤ : Submodule Λ (Q.obj F)) ≤ LinearMap.range (Q.map g).hom := by
    rw [← hT]
    exact Submodule.span_le.mpr hrange
  exact LinearMap.range_eq_top.mp (top_unique ht)

end AlgebraicGeometry.Scheme
