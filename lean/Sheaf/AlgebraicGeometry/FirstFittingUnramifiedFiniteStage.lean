module

public import Sheaf.AlgebraicGeometry.FirstFittingSingularSubscheme
public import Sheaf.AlgebraicGeometry.UnramifiedMorphism
public import WeilConjectures.AlgebraicGeometry.LimitAffineTransition
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
import Sheaf.TraceFormula.UnramifiedLimitDescent
import Mathlib.AlgebraicGeometry.Noetherian

/-!
# First-Fitting subschemes and finite-stage unramifiedness

Source: Stacks Project, Divisors Tag 0C3I, Limits Tag 0C4W, and Curves Tag 0C5F,
final proof paragraph (blueprint: lem-trf-first-fitting-unramified-finite-stage).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- The first-Fitting singular subscheme commutes with arbitrary base change; its
finite-stage models are finite type over the integers and qcqs, and unramifiedness
over the inverse limit descends to a stage. The isomorphism in `Over` identifies
closed subschemes of the ambient base change, not only their abstract carriers.

Source: Stacks Project, Divisors Tag 0C3I, Limits Tag 0C4W, and Curves Tag 0C5F,
final proof paragraph (blueprint: lem-trf-first-fitting-unramified-finite-stage).

Proof:
1. Finite presentation gives local finite type. Together with quasi-compactness,
   this is finite type, preserved by base change
   (`lem-sfb-finite-type-composition-base-change`). The affine bases are qcqs
   (`lem-weil-pbc-affine-scheme-qcqs`).
2. For any base change, relative differentials are the pullback of the original
   finite-type quasi-coherent differential sheaf
   (`lem-trf-relative-differential-sheaf-base-change`).
3. Apply `lem-trf-fitting-ideal-sheaf-pullback` at index one. Its image ideal is
   the base-changed first Fitting ideal. The corresponding closed subscheme is
   the pullback of the original one. Associativity of fibre products identifies
   it with the pullback over the base, preserving the ambient closed immersion.
   Specialize to each stage and to the limiting cone vertex.
4. Each singular closed immersion is finite type: locally it is Spec(A/J) to
   Spec(A), an affine morphism generated by the empty family as an A-algebra.
5. Compose with the finite-type family and base structure maps. This makes every
   stage singular scheme finite type over the integers, hence Noetherian and qcqs
   (`lem-weil-pbc-finite-type-over-noetherian` and
   `lem-weil-pbc-locally-noetherian-quasi-separated`). In particular the original
   singular scheme is locally finite type over the original base.
6. Apply `lem-trf-unramified-limit-descent` to that singular scheme over the
   original base. The base-change identifications from step 3 identify its
   limit and stage morphisms with the required singular morphisms. The tail
   above the initial stage is directed and cofinal: any index has a common upper
   bound with the initial one. Thus the tail has the same limit, and descent
   gives a later unramified stage. No step requires flatness or nodality. -/
theorem firstFitting_unramified_finite_stage
    {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (D : Iᵒᵖ ⥤ Scheme.{u}) [∀ i : Iᵒᵖ, IsAffine (D.obj i)]
    [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (D.map a)]
    (z : ∀ i : Iᵒᵖ, D.obj i ⟶ Spec (.of (ULift.{u} ℤ)))
    [∀ i : Iᵒᵖ, LocallyOfFiniteType (z i)] [∀ i : Iᵒᵖ, QuasiCompact (z i)]
    (L : Cone D) (hL : IsLimit L) (c : I)
    {Xc : Scheme.{u}} (gc : Xc ⟶ D.obj (op c))
    [LocallyOfFinitePresentation gc] [QuasiCompact gc] [QuasiSeparated gc] :
    (∀ (T : Scheme.{u}) (t : T ⟶ D.obj (op c)),
      Nonempty
        (Over.mk
            (pullback.map (Scheme.firstFittingSingularSubscheme gc ≫ gc) t gc t
              (Scheme.firstFittingSingularSubscheme gc) (𝟙 T) (𝟙 (D.obj (op c)))
              (Category.comp_id (Scheme.firstFittingSingularSubscheme gc ≫ gc))
              ((Category.comp_id t).trans (Category.id_comp t).symm)) ≅
          Over.mk (Scheme.firstFittingSingularSubscheme (pullback.snd gc t)))) ∧
    (∀ (i : I) (hci : c ≤ i),
      LocallyOfFiniteType
          (Scheme.firstFittingSingularSubscheme (pullback.snd gc (D.map (homOfLE hci).op)) ≫
            pullback.snd gc (D.map (homOfLE hci).op) ≫ z (op i)) ∧
      QuasiCompact
          (Scheme.firstFittingSingularSubscheme (pullback.snd gc (D.map (homOfLE hci).op)) ≫
            pullback.snd gc (D.map (homOfLE hci).op) ≫ z (op i)) ∧
      CompactSpace
        (Scheme.firstFittingIdealSheaf (pullback.snd gc (D.map (homOfLE hci).op))).subscheme ∧
      QuasiSeparatedSpace
        (Scheme.firstFittingIdealSheaf (pullback.snd gc (D.map (homOfLE hci).op))).subscheme) ∧
    LocallyOfFiniteType (Scheme.firstFittingSingularSubscheme gc ≫ gc) ∧
    (IsUnramified
        (Scheme.firstFittingSingularSubscheme (pullback.snd gc (L.π.app (op c))) ≫
          pullback.snd gc (L.π.app (op c))) →
      ∃ (d : I) (hcd : c ≤ d),
        IsUnramified
          (Scheme.firstFittingSingularSubscheme (pullback.snd gc (D.map (homOfLE hcd).op)) ≫
            pullback.snd gc (D.map (homOfLE hcd).op))) := by
  sorry

end AlgebraicGeometry
