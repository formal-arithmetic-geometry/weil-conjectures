module

public import Sheaf.AlgebraicGeometry.StandardGroupSchemes
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.CategoryTheory.Monoidal.Cartesian.GrpLimits
import Sheaf.AlgebraicGeometry.AffineGroupFrobeniusVerschiebung
import WeilConjectures.Mathlib.AlgebraicGeometry.Geometrically.Reduced
import Mathlib.AlgebraicGeometry.Geometrically.Integral
import Sheaf.AlgebraicGeometry.AffineFiniteTypeAlgebra
import Mathlib.RingTheory.FiniteType
import Mathlib.AlgebraicGeometry.Group.Affine
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-! # Smooth commutative p-torsion groups embed in additive powers

Source: Milne, Algebraic Groups (2017), Proposition 14.49, printed p.296, and
Definition 14.45, printed p.295
(blueprint: lem-sfb-smooth-p-torsion-additive-embedding).

The finite product is taken in the category of group schemes. Its group law is
coordinatewise addition, and the empty product is the trivial group over Spec k.
The group-object API writes the additive law on points multiplicatively.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open scoped CategoryTheory.MonObj

namespace AlgebraicGeometry

/-- A smooth commutative affine group of finite type killed by the positive
characteristic embeds as a closed subgroup in a finite additive power.
Source: Milne, Algebraic Groups (2017), Proposition 14.49 and Definition 14.45,
printed pp.295-296 (blueprint: lem-sfb-smooth-p-torsion-additive-embedding).

Proof:
1. Put C = Gamma(H, O_H). Use `lem-sfb-affine-group-frobenius-verschiebung`
to obtain the Frobenius coordinate map f from the Frobenius twist of C to C
and the Verschiebung coordinate map v in the opposite direction.
Smoothness gives geometric reducedness (`sbc-lem-smooth-geometrically-reduced`).
Thus the twist is reduced (`def-pc-geometrically-irreducible`,
`def-pc-reduced-scheme`). For z in the twist, f(z) tensor 1 = z^p, so f is injective.
2. The hypothesis on every algebra-valued point implies that [p] is the constant
identity map, by evaluation on the universal affine point. The identity V F = [p]
from `lem-sfb-affine-group-frobenius-verschiebung` gives f(v(a)) = epsilon(a).
Cancel the injective f to get v(a) = epsilon(a), so Verschiebung is zero.
3. By `lem-sfb-zero-verschiebung-primitive-generation`, C is generated by primitives.
By `lem-pc-affine-finite-type-algebra` it is finitely generated as a k-algebra
in the sense of `def-weil-pbc-finite-type-algebra`; choose finite algebra generators.
4. Each generator is a polynomial in finitely many primitive elements. Enumerate
their finite union as x_1,...,x_n. They generate C, hence define a surjection
k[t_1,...,t_n] -> C. The union may be empty, giving n = 0 and C = k.
5. In the coordinate Hopf algebra (`lem-sfb-affine-group-coordinate-hopf`),
the primitive identities imply epsilon(x_i) = 0 and S(x_i) = -x_i. Therefore
the surjection respects all three Hopf maps of the coordinatewise additive group
(`def-sc-gm-ga`). By `lem-sfb-hopf-spectrum-functor` its spectrum is a group
homomorphism. Surjectivity makes it a closed immersion by
`lem-weil-pbc-closed-immersion-affine-cover-criterion`, clause (2). Its maps
on all algebra-valued points are injective homomorphisms, so it is a closed
subgroup scheme (`def-sc-group-scheme-subgroup`). For n = 0 it is the identity
embedding of the trivial group. No connectedness or perfection is used. -/
theorem smooth_p_torsion_additive_embedding {k : Type u} [Field k]
    (p : ℕ) [CharP k p] (hp : 0 < p)
    (H : Grp (Over (Spec (.of k)))) [IsAffine H.X.left]
    [Smooth H.X.hom] [IsCommMonObj H.X]
    [LocallyOfFiniteType H.X.hom] [QuasiCompact H.X.hom]
    (hkilled : ∀ (R : Type u) [CommRing R] [Algebra k R]
      (x : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k R))) ⟶ H.X),
      x ^ p = 1) :
    ∃ (n : ℕ)
      (i : H ⟶ ∏ᶜ fun _ : Fin n ↦ Grp.mk (StandardGroupSchemes.additive k)),
      IsClosedSubgroupScheme i.hom.hom := by
  sorry

end AlgebraicGeometry
