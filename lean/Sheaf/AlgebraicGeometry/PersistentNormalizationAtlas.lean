module

public import Sheaf.TraceFormula.StrictSemistableCurve
public import Sheaf.AlgebraicGeometry.ReducedNormalization
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-! # Common persistent-node normalization atlases

Source: Stacks Project, models.tex, Tag 0CDD, with the supplied normalization charts
(blueprint: def-sfb-persistent-normalization-atlas).
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry
namespace PersistentNormalization

/-- Evaluation on the two branches, before passing to the nodal quotient.
Source: Stacks Project, Tag 0CDD, split model
(blueprint: def-sfb-persistent-normalization-atlas). -/
noncomputable def branchEvaluation (A : CommRingCat.{u}) :
    MvPolynomial (Fin 2) A →+* Polynomial A × Polynomial A :=
  MvPolynomial.eval₂Hom (Polynomial.C.prod Polynomial.C)
    (fun i ↦ if i = 0 then (Polynomial.X, 0) else (0, Polynomial.X))

/-- The canonical split normalization map sends `u` to `(u,0)` and `v` to `(0,v)`.
Source: Stacks Project, Tag 0CDD, split model
(blueprint: def-sfb-persistent-normalization-atlas). -/
noncomputable def branchMap (A : CommRingCat.{u}) :
    strictNodalRing A 0 →+* Polynomial A × Polynomial A :=
  Ideal.Quotient.lift _ (branchEvaluation A)
    (by
      intro a ha
      apply (Ideal.span_le.mpr ?_ : _ ≤ RingHom.ker (branchEvaluation A)) ha
      intro x hx
      obtain rfl := Set.mem_singleton_iff.mp hx
      simp [branchEvaluation])

/-- The two origins mapping to the coefficient scheme through the diagonal on rings.
Source: Stacks Project, Tag 0CDD, persistent model
(blueprint: def-sfb-persistent-normalization-atlas). -/
noncomputable def diagonalMap (A : CommRingCat.{u}) :
    Spec (.of (A × A)) ⟶ Spec A :=
  Spec.map (CommRingCat.ofHom ((RingHom.id A).prod (RingHom.id A)))

/-- The origin map in the split model, specified by the vanishing of both coordinates.
Source: Stacks Project, Tag 0CDD, persistent model
(blueprint: def-sfb-persistent-normalization-atlas). -/
noncomputable def originMap (A : CommRingCat.{u}) :
    Spec A ⟶ (StrictSemistableModel.nodal (0 : A)).scheme :=
  Spec.map (CommRingCat.ofHom
    (Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom (RingHom.id A) (fun _ ↦ 0))
      (by
        intro a ha
        apply (Ideal.span_le.mpr ?_ : _ ≤ RingHom.ker
          (MvPolynomial.eval₂Hom (RingHom.id A) (fun _ : Fin 2 ↦ 0))) ha
        intro x hx
        obtain rfl := Set.mem_singleton_iff.mp hx
        simp)))

/-- The ideal sheaf generated by the two coordinates of the split-node origin.
The generators are transported from the quotient ring by the canonical spectrum
sections isomorphism, so this is the ideal `(u,v)` without a branch-ordering theorem.
Source: Stacks Project, Tag 0CDD, persistent model
(blueprint: def-sfb-persistent-normalization-atlas). -/
noncomputable def originIdeal (A : CommRingCat.{u}) :
    (StrictSemistableModel.nodal (0 : A)).scheme.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop
    (Ideal.span
      {(Scheme.ΓSpecIso (.of (strictNodalRing A 0))).inv
          (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
        (Scheme.ΓSpecIso (.of (strictNodalRing A 0))).inv
          (Ideal.Quotient.mk _ (MvPolynomial.X 1))})

/-- A coefficient base is an étale DVR extension, or a finite separable generic extension.
The latter is expressed by its equivalent finite étale spectrum map between fields.
Source: Stacks Project, Tag 0CDD and the supplied generic charts
(blueprint: def-sfb-persistent-normalization-atlas). -/
def AllowedModel (R K A : CommRingCat.{u}) (η : Spec K ⟶ Spec R)
    (b : Spec A ⟶ Spec R) (M : StrictSemistableModel A) : Prop :=
  (∃ (_ : IsDomain A) (_ : IsDiscreteValuationRing A) (ϖ : A),
    Irreducible ϖ ∧ Etale b ∧
      (M = .nodal 0 ∨ ∃ n : ℕ, M = .nodal (ϖ ^ n))) ∨
  (IsField A ∧ ∃ g : Spec A ⟶ Spec K,
    IsFinite g ∧ Etale g ∧ g ≫ η = b ∧ (M = .nodal 0 ∨ M = .polynomial))

/-- A common affine étale chart with its normalization comparison. The comparison is
required over the chart, so its branch map is the canonical one above. For smoothing
and smooth charts the normalization is the identity after pullback.
Source: Stacks Project, Tag 0CDD and the supplied normalization atlas
(blueprint: def-sfb-persistent-normalization-atlas). -/
structure Chart (R K : CommRingCat.{u}) (η : Spec K ⟶ Spec R)
    {X : Scheme.{u}} (f : X ⟶ Spec R) where
  A : CommRingCat.{u}
  base : Spec A ⟶ Spec R
  model : StrictSemistableModel A
  allowed : AllowedModel R K A η base model
  P : CommRingCat.{u}
  toX : Spec P ⟶ X
  toModel : Spec P ⟶ model.scheme
  etale_X : Etale toX
  etale_model : Etale toModel
  over : toModel ≫ model.baseMap ≫ base = toX ≫ f
  normalization : ∀ h : model = .nodal 0,
    ∃ e : pullback X.fromReducedNormalization toX ≅
        pullback (Spec.map (CommRingCat.ofHom (branchMap A)))
          (toModel ≫ eqToHom (congrArg StrictSemistableModel.scheme h)),
      e.hom ≫ pullback.snd _ _ = pullback.snd _ _
  identity : model ≠ .nodal 0 → IsIso (pullback.snd X.fromReducedNormalization toX)

/-- An atlas of the specified common charts covers all points, including generic-only
charts. Its index universe is unrestricted and it includes the empty atlas on the empty scheme.
Source: Stacks Project, Tag 0CDD and the supplied normalization atlas
(blueprint: def-sfb-persistent-normalization-atlas). -/
structure Atlas (R K : CommRingCat.{u}) (η : Spec K ⟶ Spec R)
    {X : Scheme.{u}} (f : X ⟶ Spec R) where
  chart : ∀ _x : X, Chart R K η f
  covers : ∀ x : X, x ∈ Set.range (chart x).toX

end PersistentNormalization
end AlgebraicGeometry
