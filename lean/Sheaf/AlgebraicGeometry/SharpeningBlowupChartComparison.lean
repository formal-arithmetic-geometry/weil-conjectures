/-!
# Sharpening, saturated fraction charts, and ordered blowup towers

Source: ILO, Exposé VIII, 3.1.17--3.1.25(i)--(iii), printed pp.101--102
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

We reuse the already published sharpening maps, ideal operations, and tower identifications.
Only these interfaces are used from `SharpeningFanBijection`, never its rule-bijection theorem
or its `SharpeningGeometry` assertion. Multiplication denotes the additive operation in the
source; thus `Associates P` is B, `Pˣ` is U, products are direct sums, and `b / a` is b-a.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry.Monoscheme

/-- Extend a specified splitting P ≃ B × U to the group completion. This is the actual
universal extension, normalized by the given splitting, not an arbitrary homomorphism.
Source: ILO VIII 3.1.11, 3.1.25(ii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison). -/
noncomputable def splitCompletion {P : Type u} [CommMonoid P]
    (e : P ≃* (Associates P × Pˣ)) :
    Algebra.GrothendieckGroup P →* (Algebra.GrothendieckGroup (Associates P) × Pˣ) :=
  Algebra.GrothendieckGroup.lift
    (((Algebra.GrothendieckGroup.of).comp
      ((MonoidHom.fst (Associates P) Pˣ).comp e.toMonoidHom)).prod
        ((MonoidHom.snd (Associates P) Pˣ).comp e.toMonoidHom))

/-- The ideal bijection includes zero generators, preserves nonempty and whole centers,
and commutes with the generated image under every morphism of the specified category.
Source: ILO VIII 3.1.18, 3.1.25(i)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (steps 1--2): integral-sharpening exactness identifies the kernel with the units.
An ideal is invariant under multiplication and division by units, so image followed by
inverse image, and inverse image followed by image, are identities. This holds on all
localizations. The affine-fan localization-section lemma identifies these calculations
with the sharp sheaf, and they glue by stalkwise membership. Images of finite generators
and local lifts of finite generators prove coherence in both directions, including the
empty list. Positive lists and the whole ideal are preserved. For a morphism P → Q,
both orders of sharpening and taking the generated image are generated by the same
images of generators. This stalkwise equality gives the pullback equation. -/
theorem sharpening_blowup_ideal_comparison (M : Fine.{u})
    (hM : M.IsTorsionFree) (hF : M.toFan.IsTorsionFree) :
    (∀ I : IdealFamily M, IsCoherentIdeal I →
      FineFan.IsCoherentIdeal (sharpIdeal I) ∧ unsharpIdeal (sharpIdeal I) = I ∧
      (FineFan.IsNonemptyCoherentIdeal (sharpIdeal I) ↔ IsNonemptyCoherentIdeal I) ∧
      (sharpIdeal I = FineFan.wholeIdeal M.toFan ↔ I = wholeIdeal M)) ∧
    (∀ J : FineFan.IdealFamily M.toFan, FineFan.IsCoherentIdeal J →
      IsCoherentIdeal (unsharpIdeal J) ∧ sharpIdeal (unsharpIdeal J) = J) ∧
    (∀ (I : IdealFamily M), IsCoherentIdeal I →
      ∀ x : M.space, (idealStalk I x).Nonempty ↔
        (FineFan.idealStalk (sharpIdeal I) x).Nonempty) ∧
    (∀ U : Opens M.space, sharpIdeal (emptyIdeal M) U =
      {s | ∀ x : M.toFan.space, x ∈ U → False}) ∧
    (∀ (N : Fine.{u}) (hN : N.IsTorsionFree) (hG : N.toFan.IsTorsionFree)
      (f : Hom N M) (I : IdealFamily M), IsCoherentIdeal I →
      sharpIdeal (pullbackIdeal f I) = FineFan.pullbackIdeal f.toFan (sharpIdeal I)) := by
  sorry

private theorem chart_fraction_mem {P : Type u} [CommMonoid P]
    (E : Finset P) (a b : P) (hb : b ∈ SemigroupIdeal.closure (E : Set P)) :
    Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a ∈
      FineFan.blowupChart P E a := by
  obtain ⟨c, d, hd, rfl⟩ := SemigroupIdeal.mem_closure''.mp hb
  rw [map_mul, mul_div_assoc]
  exact Submonoid.mul_mem _
    (Submonoid.subset_closure (Or.inl ⟨c, rfl⟩))
    (Submonoid.subset_closure (Or.inr ⟨d, hd, rfl⟩))

private theorem mem_root_saturation {G : Type u} [CommGroup G]
    (Q : Submonoid G) (x : G) :
    x ∈ FineFan.saturation Q ↔ ∃ n : ℕ, 0 < n ∧ x ^ n ∈ Q := by
  let R : Submonoid G :=
    { carrier := {x | ∃ n : ℕ, 0 < n ∧ x ^ n ∈ Q}
      one_mem' := ⟨1, by decide, by simp⟩
      mul_mem' := by
        rintro x y ⟨m, hm, hx⟩ ⟨n, hn, hy⟩
        refine ⟨m * n, Nat.mul_pos hm hn, ?_⟩
        rw [mul_pow]
        apply Q.mul_mem
        · rw [pow_mul]
          exact Q.pow_mem hx n
        · rw [Nat.mul_comm, pow_mul]
          exact Q.pow_mem hy m }
  exact ⟨fun hx ↦ (Submonoid.closure_le.mpr (fun _ h ↦ h) :
    FineFan.saturation Q ≤ R) hx, fun hx ↦
      Submonoid.subset_closure (s := {g | ∃ n : ℕ, 0 < n ∧ g ^ n ∈ Q}) hx⟩

private theorem le_root_saturation {G : Type u} [CommGroup G] (Q : Submonoid G) :
    Q ≤ FineFan.saturation Q := by
  intro x hx
  exact (mem_root_saturation Q x).mpr ⟨1, by decide, by simpa using hx⟩

private theorem localized_root_closed {G : Type u} [CommGroup G]
    (Q : Submonoid G) (d : G) (hd : d⁻¹ ∈ Q) (x : G)
    (n : ℕ) (hn : 0 < n)
    (hx : x ^ n ∈ Submonoid.closure ((Q : Set G) ∪ {d})) :
    x ∈ Submonoid.closure ((FineFan.saturation Q : Set G) ∪ {d}) := by
  have normal : ∀ y ∈ Submonoid.closure ((Q : Set G) ∪ {d}),
      ∃ k : ℕ, y * (d⁻¹) ^ k ∈ Q := by
    intro y hy
    induction hy using Submonoid.closure_induction with
    | mem z hz =>
      rcases hz with hz | hz
      · exact ⟨0, by simpa using hz⟩
      · rcases Set.mem_singleton_iff.mp hz with rfl
        exact ⟨1, by simp⟩
    | one => exact ⟨0, by simp⟩
    | mul y z _ _ hy hz =>
      obtain ⟨i, hi⟩ := hy
      obtain ⟨j, hj⟩ := hz
      refine ⟨i + j, ?_⟩
      simpa only [pow_add, mul_assoc, mul_left_comm, mul_comm] using Q.mul_mem hi hj
  obtain ⟨k, hk⟩ := normal _ hx
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  have hroot : x * (d⁻¹) ^ k ∈ FineFan.saturation Q := by
    apply (mem_root_saturation Q _).mpr
    refine ⟨m + 1, Nat.succ_pos _, ?_⟩
    have hm := Q.mul_mem hk (Q.pow_mem (Q.pow_mem hd k) m)
    simpa only [mul_pow, pow_succ, mul_assoc, mul_left_comm, mul_comm] using hm
  have h₁ := Submonoid.subset_closure (s :=
    (FineFan.saturation Q : Set G) ∪ {d}) (Or.inl hroot)
  have h₂ := (Submonoid.closure ((FineFan.saturation Q : Set G) ∪ {d})).pow_mem
    (Submonoid.subset_closure (Or.inr (Set.mem_singleton d))) k
  simpa only [mul_assoc, ← mul_pow, inv_mul_cancel, one_pow, mul_one] using
    Submonoid.mul_mem _ h₁ h₂

private theorem chart_overlap_le {B : Type u} [CommMonoid B]
    (E : Finset B) (a b : B) :
    FineFan.blowupChart B E a ≤
      Submonoid.closure ((FineFan.blowupChart B E b :
        Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a}) := by
  apply Submonoid.closure_le.mpr
  rintro x (⟨z, rfl⟩ | ⟨z, hz, rfl⟩)
  · exact Submonoid.subset_closure
      (Or.inl (Submonoid.subset_closure (Or.inl ⟨z, rfl⟩)))
  · have h₁ := Submonoid.subset_closure (s :=
        (FineFan.blowupChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a})
        (Or.inl (Submonoid.subset_closure (Or.inr ⟨z, hz, rfl⟩)))
    have h₂ := Submonoid.subset_closure (s :=
        (FineFan.blowupChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a})
        (Or.inr (Set.mem_singleton _))
    simpa only [SetLike.mem_coe, div_mul_div_cancel] using Submonoid.mul_mem _ h₁ h₂

private theorem saturated_chart_overlap_le {B : Type u} [CommMonoid B]
    (E : Finset B) (a b : B) (ha : a ∈ SemigroupIdeal.closure (E : Set B)) :
    FineFan.saturatedChart B E a ≤
      Submonoid.closure ((FineFan.saturatedChart B E b :
        Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a}) := by
  intro x hx
  obtain ⟨n, hn, hx⟩ := (mem_root_saturation (FineFan.blowupChart B E a) x).mp hx
  apply localized_root_closed (FineFan.blowupChart B E b)
    (Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a) _ x n hn
    (chart_overlap_le E a b hx)
  simpa only [inv_div] using chart_fraction_mem E b a ha

private theorem completion_lift_of {P G : Type u} [CommMonoid P] [CommGroup G]
    (f : P →* G) (p : P) :
    Algebra.GrothendieckGroup.lift f (Algebra.GrothendieckGroup.of p) = f p :=
  congrArg (fun k : P →* G ↦ k p)
    (Algebra.GrothendieckGroup.lift.symm_apply_apply f)

private theorem splitCompletion_of {P : Type u} [CommMonoid P]
    (e : P ≃* (Associates P × Pˣ)) (p : P) :
    splitCompletion e (Algebra.GrothendieckGroup.of p) =
      (Algebra.GrothendieckGroup.of (e p).1, (e p).2) :=
  completion_lift_of _ p

private theorem splitCompletion_injective {P : Type u} [CommMonoid P]
    (e : P ≃* (Associates P × Pˣ)) : Function.Injective (splitCompletion e) := by
  let f : Associates P →* Algebra.GrothendieckGroup P :=
    Algebra.GrothendieckGroup.of.comp
      (e.symm.toMonoidHom.comp (MonoidHom.inl (Associates P) Pˣ))
  let g : Pˣ →* Algebra.GrothendieckGroup P :=
    Algebra.GrothendieckGroup.of.comp
      (e.symm.toMonoidHom.comp (MonoidHom.inr (Associates P) Pˣ))
  let ψ := (Algebra.GrothendieckGroup.lift f).coprod g
  have hψ : ψ.comp (splitCompletion e) = MonoidHom.id _ := by
    apply Algebra.GrothendieckGroup.lift.symm.injective
    ext p
    change ψ (splitCompletion e (Algebra.GrothendieckGroup.of p)) =
      Algebra.GrothendieckGroup.of p
    rw [splitCompletion_of]
    change Algebra.GrothendieckGroup.lift f (Algebra.GrothendieckGroup.of (e p).1) *
      g (e p).2 = _
    rw [completion_lift_of]
    change Algebra.GrothendieckGroup.of (e.symm ((e p).1, 1)) *
      Algebra.GrothendieckGroup.of (e.symm (1, (e p).2)) = _
    rw [← map_mul, ← map_mul]
    simp
  exact Function.LeftInverse.injective (f := splitCompletion e) (g := ψ)
    (fun x ↦ congrArg (fun f : Algebra.GrothendieckGroup P →*
      Algebra.GrothendieckGroup P ↦ f x) hψ)

private theorem splitCompletion_surjective {P : Type u} [CommMonoid P]
    (e : P ≃* (Associates P × Pˣ)) : Function.Surjective (splitCompletion e) := by
  rintro ⟨x, u⟩
  induction x using Localization.ind with
  | H bc =>
    rcases bc with ⟨b, c⟩
    refine ⟨Algebra.GrothendieckGroup.of (e.symm (b, u)) /
      Algebra.GrothendieckGroup.of (e.symm (c.val, 1)), ?_⟩
    rw [map_div, splitCompletion_of, splitCompletion_of]
    simp only [e.apply_symm_apply, Prod.div_def, div_one]
    congr 1
    change (Localization.monoidOf ⊤) b *
      ((Localization.monoidOf ⊤) c.val)⁻¹ = Localization.mk b c
    rw [← Localization.mk_one_eq_monoidOf_mk, ← Localization.mk_one_eq_monoidOf_mk,
      Algebra.GrothendieckGroup.inv_mk, Localization.mk_mul]
    simp

private theorem split_chart_product {P : Type u} [CommMonoid P]
    (e : P ≃* (Associates P × Pˣ))
    (he : ∀ p : P, (e p).1 = Associates.mk p)
    (E : Finset (Associates P)) (E' : Finset P)
    (hE' : Associates.mk '' (E' : Set P) = (E : Set (Associates P)))
    (a : Associates P) (p : P) (hp : Associates.mk p = a) :
    (FineFan.blowupChart P E' p).map (splitCompletion e) =
      (FineFan.blowupChart (Associates P) E a).prod ⊤ := by
  let R := (FineFan.blowupChart P E' p).map (splitCompletion e)
  have hbase (b : Associates P) (u : Pˣ) :
      (Algebra.GrothendieckGroup.of b, u) ∈ R := by
    refine ⟨Algebra.GrothendieckGroup.of (e.symm (b, u)),
      Submonoid.subset_closure (Or.inl ⟨_, rfl⟩), ?_⟩
    rw [splitCompletion_of, e.apply_symm_apply]
  have hunits (u : Pˣ) : (1, u) ∈ R := by
    simpa only [map_one] using hbase 1 u
  apply le_antisymm
  · apply Submonoid.map_le_iff_le_comap.mpr
    apply Submonoid.closure_le.mpr
    rintro x (⟨z, rfl⟩ | ⟨z, hz, rfl⟩)
    · change (splitCompletion e (Algebra.GrothendieckGroup.of z)).1 ∈
        FineFan.blowupChart (Associates P) E a ∧ _
      rw [splitCompletion_of, he]
      exact ⟨Submonoid.subset_closure (Or.inl ⟨_, rfl⟩), Submonoid.mem_top _⟩
    · change (splitCompletion e
        (Algebra.GrothendieckGroup.of z / Algebra.GrothendieckGroup.of p)).1 ∈
        FineFan.blowupChart (Associates P) E a ∧ _
      rw [map_div, splitCompletion_of, splitCompletion_of]
      simp only [Prod.fst_div, he, hp]
      exact ⟨Submonoid.subset_closure
        (Or.inr ⟨Associates.mk z, hE' ▸ ⟨z, hz, rfl⟩, rfl⟩), Submonoid.mem_top _⟩
  · have hfirst : FineFan.blowupChart (Associates P) E a ≤
        R.comap (MonoidHom.inl _ _) := by
      apply Submonoid.closure_le.mpr
      rintro x (⟨b, rfl⟩ | ⟨b, hb, rfl⟩)
      · exact hbase b 1
      · obtain ⟨z, hz, rfl⟩ := hE'.symm ▸ hb
        have hfrac : splitCompletion e
            (Algebra.GrothendieckGroup.of z / Algebra.GrothendieckGroup.of p) ∈ R :=
          ⟨_, Submonoid.subset_closure (Or.inr ⟨z, hz, rfl⟩), rfl⟩
        rw [map_div, splitCompletion_of, splitCompletion_of] at hfrac
        have hmul := R.mul_mem hfrac (hunits (((e z).2 / (e p).2)⁻¹))
        simpa only [Prod.div_def, Prod.mul_def, he, hp, mul_inv_cancel, mul_one,
          SetLike.mem_coe, Submonoid.mem_comap, MonoidHom.inl_apply] using hmul
    rintro ⟨x, u⟩ ⟨hx, _⟩
    have hmul := R.mul_mem (hfirst hx) (hunits u)
    simpa only [Submonoid.mem_comap, MonoidHom.inl_apply, Prod.mul_def, mul_one,
      one_mul] using hmul

private theorem chart_all_ideal {P : Type u} [CommMonoid P]
    (J : SemigroupIdeal P) (E : Finset P)
    (hE : J = SemigroupIdeal.closure (E : Set P)) (a : P) :
    FineFan.blowupChart P E a =
      Submonoid.closure (Set.range (Algebra.GrothendieckGroup.of (M := P)) ∪
        (fun b : P ↦ Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a) ''
          (J : Set P)) := by
  apply le_antisymm
  · exact Submonoid.closure_mono (Set.union_subset_union_right _
      (Set.image_mono (hE ▸ SemigroupIdeal.subset_closure)))
  · apply Submonoid.closure_le.mpr
    rintro x (⟨b, rfl⟩ | ⟨b, hb, rfl⟩)
    · exact Submonoid.subset_closure (Or.inl ⟨b, rfl⟩)
    · exact chart_fraction_mem E a b (hE ▸ hb)

private theorem saturation_map_bijective {G H : Type u} [CommGroup G] [CommGroup H]
    (f : G →* H) (hf : Function.Bijective f) (Q : Submonoid G) :
    (FineFan.saturation Q).map f = FineFan.saturation (Q.map f) := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    obtain ⟨n, hn, hx⟩ := (mem_root_saturation Q x).mp hx
    exact (mem_root_saturation _ _).mpr ⟨n, hn, by
      rw [← map_pow]
      exact ⟨x ^ n, hx, rfl⟩⟩
  · intro y hy
    obtain ⟨x, rfl⟩ := hf.2 y
    obtain ⟨n, hn, z, hz, heq⟩ := (mem_root_saturation (Q.map f) (f x)).mp hy
    refine ⟨x, (mem_root_saturation Q x).mpr ⟨n, hn, ?_⟩, rfl⟩
    rw [← map_pow] at heq
    exact hf.1 heq ▸ hz

private theorem saturation_prod_group {G H : Type u} [CommGroup G] [CommGroup H]
    (Q : Submonoid G) :
    FineFan.saturation (Q.prod (⊤ : Submonoid H)) =
      (FineFan.saturation Q).prod ⊤ := by
  ext x
  rw [mem_root_saturation, Submonoid.mem_prod, mem_root_saturation]
  simp only [Submonoid.mem_top, and_true, Prod.pow_fst, Submonoid.mem_prod]

private theorem product_sharp_equiv {S T U : Type u}
    [CommMonoid S] [CommMonoid T] [CommGroup U] (e : S ≃* (T × U)) :
    ∃ ε : Associates S ≃* Associates T,
      ∀ x : S, ε (Associates.mk x) = Associates.mk (e x).1 := by
  let f : S →* T := (MonoidHom.fst T U).comp e.toMonoidHom
  let j : T →* S := e.symm.toMonoidHom.comp (MonoidHom.inl T U)
  let F := FineFan.sharpenMap f
  let J := FineFan.sharpenMap j
  have hleft : Function.LeftInverse J F := by
    intro x
    induction x using Quotient.inductionOn with
    | h x =>
      change Associates.mk (j (f x)) = Associates.mk x
      apply Associates.mk_eq_mk_iff_associated.mpr
      let v : (T × U)ˣ :=
        { val := (1, (e x).2)
          inv := (1, ((e x).2)⁻¹)
          val_inv := by ext <;> simp
          inv_val := by ext <;> simp }
      refine ⟨Units.map e.symm.toMonoidHom v, ?_⟩
      apply e.injective
      simp [j, f, map_mul, v]
  have hright : Function.RightInverse J F := by
    intro x
    induction x using Quotient.inductionOn with
    | h x =>
      change Associates.mk (f (j x)) = Associates.mk x
      simp [f, j]
  exact ⟨MulEquiv.ofBijective F ⟨hleft.injective, hright.surjective⟩, fun _ ↦ rfl⟩

private theorem sharp_of_product_map {G H U : Type u}
    [CommGroup G] [CommGroup H] [CommGroup U]
    (f : G →* H × U) (hf : Function.Bijective f)
    (S : Submonoid G) (T : Submonoid H) (hST : S.map f = T.prod ⊤) :
    ∃ ε : Associates S ≃* Associates T,
      ∀ x : S, ∃ y : T, y.val = (f x.val).1 ∧
        ε (Associates.mk x) = Associates.mk y := by
  let F : S →* T × U :=
    { toFun := fun x ↦ (⟨(f x.val).1, by
        have hm : f x.val ∈ T.prod ⊤ := hST ▸ ⟨x.val, x.property, rfl⟩
        exact hm.1⟩, (f x.val).2)
      map_one' := by ext <;> simp
      map_mul' := by intros; ext <;> simp }
  have hinj : Function.Injective F := by
    intro x y h
    apply Subtype.ext
    apply hf.1
    exact Prod.ext (congrArg (fun z : T × U ↦ z.1.val) h)
      (congrArg (fun z : T × U ↦ z.2) h)
  have hsurj : Function.Surjective F := by
    rintro ⟨t, u⟩
    have hm : (t.val, u) ∈ S.map f := hST.symm ▸ ⟨t.property, Submonoid.mem_top _⟩
    obtain ⟨x, hx, heq⟩ := hm
    refine ⟨⟨x, hx⟩, ?_⟩
    apply Prod.ext
    · exact Subtype.ext (congrArg Prod.fst heq)
    · exact congrArg (fun z : H × U ↦ z.2) heq
  obtain ⟨ε, hε⟩ := product_sharp_equiv (MulEquiv.ofBijective F ⟨hinj, hsurj⟩)
  exact ⟨ε, fun x ↦ ⟨(F x).1, rfl, hε x⟩⟩

set_option linter.unusedVariables false in
/-- Every splitting over B gives exactly the product charts; their sharp comparison is
intrinsic, independent of that splitting and of all finite generator representatives.
The final equality expresses B[J-a] using all b ∈ J, so a need not be a listed generator.
Source: ILO VIII 3.1.17--3.1.19, 3.1.24--3.1.25(ii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (steps 3--6): the ordinary and sharp closed-point stalks are P and B. Their
completion groups are torsion free, so fine-monoid unit splitting applies. An ideal above
J is J times U. Fractions (b,u_b)/(a,u_a) have coordinates (b/a,u_b/u_a); all of U is
already present. Thus the chart is C_a times U. A positive power of (c,u) belongs to
C_a times U exactly when the same positive power of c belongs to C_a, giving the saturated
product formula. Units of R times U are Rˣ times U, and projection gives the sharp
isomorphism. Its formula is the extension of q:P→B on ambient groups. Changing a splitting
adds only a unit in each fraction; changing representatives does the same. Neither affects
the sharp formula. A finite generating set suffices because b=e*c implies b/a=(e/a)*c.
Finite saturation and affine localization identify the saturated sharp charts as fans. -/
theorem sharpening_blowup_chart_comparison
    (P : Type u) [CommMonoid P] (hP : FineFan.IsFine P)
    [IsMulTorsionFree (Algebra.GrothendieckGroup P)]
    [IsMulTorsionFree (Algebra.GrothendieckGroup (Associates P))]
    (e : P ≃* (Associates P × Pˣ))
    (he : ∀ p : P, (e p).1 = Associates.mk p)
    (J : SemigroupIdeal (Associates P)) (hJ : J.FG) (hne : (J : Set (Associates P)).Nonempty)
    (E : Finset (Associates P)) (hE : J = SemigroupIdeal.closure (E : Set (Associates P)))
    (E' : Finset P) (hE' : Associates.mk '' (E' : Set P) = (E : Set (Associates P)))
    (a : Associates P) (ha : a ∈ J) (p : P) (hp : Associates.mk p = a) :
    e '' (Associates.mk ⁻¹' (J : Set (Associates P))) =
      Set.prod (J : Set (Associates P)) Set.univ ∧
    (FineFan.blowupChart P E' p).map (splitCompletion e) =
      (FineFan.blowupChart (Associates P) E a).prod ⊤ ∧
    (FineFan.saturatedChart P E' p).map (splitCompletion e) =
      (FineFan.saturatedChart (Associates P) E a).prod ⊤ ∧
    (∃! ε : Associates (FineFan.saturatedChart P E' p) ≃*
        Associates (FineFan.saturatedChart (Associates P) E a),
      ∀ x : FineFan.saturatedChart P E' p,
        ∃ y : FineFan.saturatedChart (Associates P) E a,
          y.val = Algebra.GrothendieckGroup.lift
            (Algebra.GrothendieckGroup.of.comp Associates.mkMonoidHom) x.val ∧
          ε (Associates.mk x) = Associates.mk y) ∧
    FineFan.blowupChart (Associates P) E a =
      Submonoid.closure (Set.range (Algebra.GrothendieckGroup.of (M := Associates P)) ∪
        (fun b : Associates P ↦
          Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a) ''
            (J : Set (Associates P))) := by
  have hchart := split_chart_product e he E E' hE' a p hp
  have hsat : (FineFan.saturatedChart P E' p).map (splitCompletion e) =
      (FineFan.saturatedChart (Associates P) E a).prod ⊤ := by
    rw [FineFan.saturatedChart, saturation_map_bijective _
      ⟨splitCompletion_injective e, splitCompletion_surjective e⟩, hchart,
      saturation_prod_group]
    rfl
  have hfst : (MonoidHom.fst _ _).comp (splitCompletion e) =
      Algebra.GrothendieckGroup.lift
        (Algebra.GrothendieckGroup.of.comp Associates.mkMonoidHom) := by
    apply Algebra.GrothendieckGroup.lift.symm.injective
    ext x
    change (splitCompletion e (Algebra.GrothendieckGroup.of x)).1 =
      Algebra.GrothendieckGroup.lift
        (Algebra.GrothendieckGroup.of.comp Associates.mkMonoidHom)
          (Algebra.GrothendieckGroup.of x)
    rw [splitCompletion_of, completion_lift_of, he]
    rfl
  obtain ⟨ε, hε⟩ := sharp_of_product_map (splitCompletion e)
    ⟨splitCompletion_injective e, splitCompletion_surjective e⟩
    (FineFan.saturatedChart P E' p) (FineFan.saturatedChart (Associates P) E a) hsat
  refine ⟨?_, hchart, hsat, ⟨ε, ?_, ?_⟩, chart_all_ideal J E hE a⟩
  · ext x
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact ⟨(he z).symm ▸ hz, Set.mem_univ _⟩
    · rintro ⟨hx, _⟩
      refine ⟨e.symm x, ?_, e.apply_symm_apply x⟩
      change Associates.mk (e.symm x) ∈ J
      rw [← he, e.apply_symm_apply]
      exact hx
  · intro x
    obtain ⟨y, hy, hεx⟩ := hε x
    refine ⟨y, ?_, hεx⟩
    exact hy.trans (congrArg (fun f ↦ f x.val) hfst)
  · intro ε' hε'
    apply MulEquiv.toMonoidHom_injective
    ext z
    induction z using Quotient.inductionOn with
    | h x =>
      obtain ⟨y, hy, hεx⟩ := hε x
      obtain ⟨y', hy', hε'x⟩ := hε' x
      have heqy : y' = y := Subtype.ext (hy'.trans
        (hy.trans (congrArg (fun f ↦ f x.val) hfst)).symm)
      exact hε'x.trans (heqy ▸ hεx.symm)

set_option linter.unusedVariables false in
/-- The overlap monoids are literally the same submonoid of B^gp. The triple-overlap
formula uses the same common ambient group, so all transitions are identity maps on
fractions and their threefold cocycle is the identity. The formulas include saturation.
Source: ILO VIII 3.1.17, 3.1.19, 3.1.25(ii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (step 7): on the a,b overlap both b/a and a/b are present. The identities
c/a=(c/b)*(b/a) and c/b=(c/a)*(a/b) prove the two inclusions of the ordinary localized
charts. Saturation commutes with localization by finite-monoid finite saturation.
On triple intersections invert both indicated fractions; the same identities give the
displayed common monoid. The maps preserve its actual ambient group elements, so their
composite does too. The product with the unit group and sharp quotient preserve these
identities. Restriction is localization at further elements, hence preserves the maps. -/
theorem sharpening_blowup_overlap_comparison
    (B : Type u) [CommMonoid B] (hB : FineFan.IsFine B) (hs : FineFan.IsSharp B)
    [IsMulTorsionFree (Algebra.GrothendieckGroup B)]
    (J : SemigroupIdeal B) (E : Finset B) (hE : J = SemigroupIdeal.closure (E : Set B))
    (a b c : B) (ha : a ∈ J) (hb : b ∈ J) (hc : c ∈ J) :
    Submonoid.closure ((FineFan.blowupChart B E a : Set (Algebra.GrothendieckGroup B)) ∪
      {Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of b}) =
      Submonoid.closure ((FineFan.blowupChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a}) ∧
    Submonoid.closure ((FineFan.saturatedChart B E a : Set (Algebra.GrothendieckGroup B)) ∪
      {Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of b}) =
      Submonoid.closure ((FineFan.saturatedChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a}) ∧
    Submonoid.closure ((FineFan.saturatedChart B E a : Set (Algebra.GrothendieckGroup B)) ∪
      {Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of b,
        Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of c}) =
      Submonoid.closure ((FineFan.saturatedChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a,
          Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of c}) := by
  have ha' : a ∈ SemigroupIdeal.closure (E : Set B) := hE ▸ ha
  have hb' : b ∈ SemigroupIdeal.closure (E : Set B) := hE ▸ hb
  have pair : ∀ a b : B,
      a ∈ SemigroupIdeal.closure (E : Set B) →
      b ∈ SemigroupIdeal.closure (E : Set B) →
      Submonoid.closure ((FineFan.saturatedChart B E a :
        Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of b}) ≤
      Submonoid.closure ((FineFan.saturatedChart B E b :
        Set (Algebra.GrothendieckGroup B)) ∪
        {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a}) := by
    intro a b ha hb
    apply Submonoid.closure_le.mpr
    rintro x (hx | hx)
    · exact saturated_chart_overlap_le E a b ha hx
    · rcases Set.mem_singleton_iff.mp hx with rfl
      exact Submonoid.subset_closure
        (Or.inl (le_root_saturation _ (chart_fraction_mem E b a ha)))
  refine ⟨?_, le_antisymm (pair a b ha' hb') (pair b a hb' ha'), ?_⟩
  · apply le_antisymm <;> apply Submonoid.closure_le.mpr
    · rintro x (hx | hx)
      · exact chart_overlap_le E a b hx
      · rcases Set.mem_singleton_iff.mp hx with rfl
        exact Submonoid.subset_closure (Or.inl (chart_fraction_mem E b a ha'))
    · rintro x (hx | hx)
      · exact chart_overlap_le E b a hx
      · rcases Set.mem_singleton_iff.mp hx with rfl
        exact Submonoid.subset_closure (Or.inl (chart_fraction_mem E a b hb'))
  · have triple : ∀ a b c : B,
        a ∈ SemigroupIdeal.closure (E : Set B) →
        Submonoid.closure ((FineFan.saturatedChart B E a :
          Set (Algebra.GrothendieckGroup B)) ∪
          {Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of b,
            Algebra.GrothendieckGroup.of a / Algebra.GrothendieckGroup.of c}) ≤
        Submonoid.closure ((FineFan.saturatedChart B E b :
          Set (Algebra.GrothendieckGroup B)) ∪
          {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a,
            Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of c}) := by
      intro a b c ha
      have incl : Submonoid.closure ((FineFan.saturatedChart B E b :
          Set (Algebra.GrothendieckGroup B)) ∪
          {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a}) ≤
          Submonoid.closure ((FineFan.saturatedChart B E b :
          Set (Algebra.GrothendieckGroup B)) ∪
          {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a,
            Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of c}) :=
        Submonoid.closure_mono (Set.union_subset_union_right _ (by simp))
      apply Submonoid.closure_le.mpr
      rintro x (hx | hx)
      · exact incl (saturated_chart_overlap_le E a b ha hx)
      · rcases Set.mem_insert_iff.mp hx with rfl | hx
        · exact Submonoid.subset_closure
            (Or.inl (le_root_saturation _ (chart_fraction_mem E b a ha)))
        · rcases Set.mem_singleton_iff.mp hx with rfl
          have h₁ := Submonoid.subset_closure (s :=
            (FineFan.saturatedChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
            {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a,
              Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of c})
            (Or.inl (le_root_saturation _ (chart_fraction_mem E b a ha)))
          have h₂ := Submonoid.subset_closure (s :=
            (FineFan.saturatedChart B E b : Set (Algebra.GrothendieckGroup B)) ∪
            {Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a,
              Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of c})
            (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
          simpa only [SetLike.mem_coe, div_mul_div_cancel] using Submonoid.mul_mem _ h₁ h₂
    exact le_antisymm (triple a b c ha') (triple b a c hb')

set_option linter.unusedVariables false in
/-- Substitution on saturated charts is the unique homomorphism given by the ambient
completion map. This states its values on all fractions, including arbitrary roots in
the saturation. It applies in particular to the local charts of a smooth pullback.
Source: ILO VIII 3.1.22--3.1.25
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (step 10): the completion map induced by h sends p to h(p), and b/a to h(b)/h(a).
Thus it sends the generated source chart into the chart of the generated image ideal.
If x^n belongs to that chart, then h^gp(x)^n belongs to the target chart, so h^gp(x)
belongs to its saturation. Restrict the actual completion map; inclusion in the ambient
group is injective and proves uniqueness. Localizing at an overlap fraction sends its
inverse to the inverse of its image. This is the same substitution after sharp quotient,
by the defining square for sharpSpaceMap. -/
theorem sharpening_blowup_chart_substitution
    (P Q : Type u) [CommMonoid P] [CommMonoid Q]
    (hP : FineFan.IsFine P) (hQ : FineFan.IsFine Q) (h : P →* Q)
    (E : Finset P) (E' : Finset Q) (hE : h '' (E : Set P) = (E' : Set Q)) (a : P) :
    ∃! k : FineFan.saturatedChart P E a →* FineFan.saturatedChart Q E' (h a),
      ∀ x : FineFan.saturatedChart P E a,
        (k x).val = Algebra.GrothendieckGroup.lift
          (Algebra.GrothendieckGroup.of.comp h) x.val := by
  let φ := Algebra.GrothendieckGroup.lift (Algebra.GrothendieckGroup.of.comp h)
  have hφ (p : P) : φ (Algebra.GrothendieckGroup.of p) =
      Algebra.GrothendieckGroup.of (h p) := by
    change ((Algebra.GrothendieckGroup.lift
      (Algebra.GrothendieckGroup.of.comp h)).comp Algebra.GrothendieckGroup.of) p = _
    exact congrArg (fun f : P →* Algebra.GrothendieckGroup Q ↦ f p)
      (Algebra.GrothendieckGroup.lift.symm_apply_apply
        (Algebra.GrothendieckGroup.of.comp h))
  have hchart : FineFan.blowupChart P E a ≤
      (FineFan.blowupChart Q E' (h a)).comap φ := by
    apply Submonoid.closure_le.mpr
    rintro x (⟨p, rfl⟩ | ⟨p, hp, rfl⟩)
    · change φ (Algebra.GrothendieckGroup.of p) ∈ FineFan.blowupChart Q E' (h a)
      rw [hφ]
      exact Submonoid.subset_closure (Or.inl ⟨h p, rfl⟩)
    · change φ (Algebra.GrothendieckGroup.of p / Algebra.GrothendieckGroup.of a) ∈
        FineFan.blowupChart Q E' (h a)
      rw [map_div, hφ, hφ]
      exact Submonoid.subset_closure (Or.inr ⟨h p, hE ▸ ⟨p, hp, rfl⟩, rfl⟩)
  have hsat : FineFan.saturatedChart P E a ≤
      (FineFan.saturatedChart Q E' (h a)).comap φ := by
    apply Submonoid.closure_le.mpr
    rintro x ⟨n, hn, hx⟩
    apply Submonoid.subset_closure
    exact ⟨n, hn, by simpa only [Submonoid.mem_comap, map_pow] using hchart hx⟩
  let k : FineFan.saturatedChart P E a →* FineFan.saturatedChart Q E' (h a) :=
    { toFun := fun x ↦ ⟨φ x.val, hsat x.property⟩
      map_one' := Subtype.ext (map_one φ)
      map_mul' := fun x y ↦ Subtype.ext (map_mul φ x.val y.val) }
  refine ⟨k, fun _ ↦ rfl, ?_⟩
  intro l hl
  ext x
  exact (hl x).trans (show (k x).val = φ x.val from rfl).symm

/-- The saturated blowup in the comparison exists with its prescribed coherent center.
Its affine charts are the actual saturated fraction monoids in the dependency definition.
Source: ILO VIII 3.1.19--3.1.25(ii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (steps 4--8): choose finite local nonempty generators for the ideal on a finite
base atlas. Take the saturated fraction charts and identify the principal overlaps by
identity of their ambient fractions. The triple-overlap identity is the cocycle condition.
Glue the spaces as the quotient of the disjoint union, and the monoid sheaves as agreeing
tuples. This gives exactly IsSaturatedBlowup, with the original center. Finite saturation
makes the charts fine; their original torsion-free completion and fs face sharpening
prove the two torsion-free stalk conditions. The sharp product-chart maps glue to the
saturated fan blowup with the sharp center. No isomorphism class is chosen as data. -/
theorem sharpening_saturated_blowup_exists
    (M : Fine.{u}) (hM : M.IsTorsionFree) (hF : M.toFan.IsTorsionFree)
    (I : IdealFamily M) (hI : IsNonemptyCoherentIdeal I) :
    ∃ (B : Fine.{u}) (b : Hom B M), IsSaturatedBlowup b I ∧
      B.IsTorsionFree ∧ B.toFan.IsTorsionFree ∧
      FineFan.IsSaturatedBlowup b.toFan (sharpIdeal I) := by
  sorry

/-- The glued saturated blowup comparison is canonical over the sharp base, remains
in the specified category, and is natural for the actual induced blowup maps. Taking f
to be an open restriction gives compatibility with restrictions.
Source: ILO VIII 3.1.17--3.1.25(ii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (steps 7--8 and 10): the product calculation identifies the sharp saturated charts,
independently of splitting and representatives. The overlap identities make the local
maps and their inverses agree, so glue their agreeing tuples of sections. They lie over
the base, and their canonical fraction formula proves uniqueness. The finite affine
cover and finite nonempty generators give a finite saturated cover. Each completion is
the original torsion-free completion. At a face, fs face sharpening gives a finite free
sharp completion, so both stalk conditions hold. For a map, the substitutions of step 10
commute with projection modulo units and the overlap identifications. They therefore
glue to the commuting naturality square. The same calculation works on every restriction. -/
theorem sharpening_saturated_blowup_comparison
    (M : Fine.{u}) (hM : M.IsTorsionFree) (hF : M.toFan.IsTorsionFree)
    (I : IdealFamily M) (B : Fine.{u}) (b : Hom B M) (hb : IsSaturatedBlowup b I) :
    B.IsTorsionFree ∧ B.toFan.IsTorsionFree ∧
    FineFan.IsSaturatedBlowup b.toFan (sharpIdeal I) ∧
    (∀ (G : FineFan.Fan.{u}) (g : FineFan.Hom G M.toFan),
      FineFan.IsSaturatedBlowup g (sharpIdeal I) →
      ∃! ε : B.toFan.space ≅ G.space, ε.hom ≫ g.map = b.toFan.map) ∧
    (∀ (N B' : Fine.{u}) (hN : N.IsTorsionFree) (hG : N.toFan.IsTorsionFree)
      (f : Hom N M) (b' : Hom B' N), IsSaturatedBlowup b' (pullbackIdeal f I) →
      ∀ (l : Hom B' B), l.map ≫ b.map = b'.map ≫ f.map →
      ∀ (G : FineFan.Fan.{u}) (g : FineFan.Hom G M.toFan)
        (G' : FineFan.Fan.{u}) (g' : FineFan.Hom G' N.toFan),
      FineFan.IsSaturatedBlowup g (sharpIdeal I) →
      FineFan.IsSaturatedBlowup g' (sharpIdeal (pullbackIdeal f I)) →
      ∀ (ε : B.toFan.space ≅ G.space) (ε' : B'.toFan.space ≅ G'.space)
        (k : FineFan.Hom G' G),
      ε.hom ≫ g.map = b.toFan.map → ε'.hom ≫ g'.map = b'.toFan.map →
      k.map ≫ g.map = g'.map ≫ f.toFan.map →
        l.toFan.map ≫ ε.hom = ε'.hom ≫ k.map) := by
  sorry

/-- Every ordered fan tower lifts uniquely over the original monoscheme base. All levels
remain in the category with both torsion-free stalk conditions. The same `Fin n` centers
and `Fin (n+1)` levels occur throughout: no whole-ideal index is contracted.
Source: ILO VIII 3.1.22, 3.1.25(iii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (step 9): induct on length, starting with M and its specified sharpening. Pull back
the next fan center along the comparison and take its unique inverse ideal. Its saturated
blowup has the next sharp comparison by steps 7--8. Thus the induction continues in the
same category. Any second lift has the same ideal by the inverse-ideal equality and the
same uniquely identified saturated charts, so the level identifications glue uniquely
over M. Starting with a monoscheme tower recovers its centers and arrows by those same
inverse operations. Every stage is retained, even a whole-ideal saturation stage. For
length zero the construction and identification are those of the base alone. -/
theorem sharpening_saturated_tower_comparison
    (M : ResolutionInput.{u}) (n : ℕ) (S : FineFan.Tower.{u} n)
    (hS : S.level 0 = M.toFan.fan) :
    (∃ T : Tower.{u} n, ∃ hT : T.level 0 = M.monoscheme,
      IsSharpTowerLift M S hS T hT) ∧
    (∀ (T T' : Tower.{u} n) (hT : T.level 0 = M.monoscheme)
      (hT' : T'.level 0 = M.monoscheme),
      IsSharpTowerLift M S hS T hT → IsSharpTowerLift M S hS T' hT' →
      ∃! c : TowerIdentification T T',
        (∀ i : Fin (n + 1), c.index i = i) ∧
        (c.iso 0).hom = eqToHom (congrArg Fine.space (hT.trans hT'.symm)) ≫
          eqToHom (congrArg (fun j ↦ (T'.level j).space) c.first.symm)) ∧
    (∀ (T : Tower.{u} n) (hT : T.level 0 = M.monoscheme),
      (∀ i : Fin (n + 1), (T.level i).IsTorsionFree ∧ (T.level i).toFan.IsTorsionFree) ∧
      IsSharpTowerLift M T.toFan (congrArg Fine.toFan hT) T hT) := by
  sorry

set_option linter.unusedVariables false in
/-- Sharpening commutes with recursive smooth pullback, retaining the very same level
maps after applying the quotient functor. The last clauses record identity and composite
substitutions on all sheafed-space maps, hence on the induced tower maps as well.
Source: ILO VIII 3.1.22, 3.1.25(iii)
(blueprint: lem-trf-sharpening-blowup-chart-comparison).

Proof (steps 10--11): the image-ideal formula identifies the pulled-back centers at each
stage. The unique chart homomorphisms substitute h(b)/h(a) for b/a, including on saturation
and on localized overlaps. They agree with the sharp maps, so give the recursive pullback
comparison at the next stage. Induction retains every original index and center. Identity
substitution fixes every fraction, and two successive substitutions give the substitution
for the composite, proving the identity and composition equations. Empty spaces have no
stalks or charts to check; length zero has no centers, and both cases obey the same laws. -/
theorem sharpening_saturated_tower_pullback
    (M N : ResolutionInput.{u}) (n : ℕ) (T S : Tower.{u} n)
    (hT : T.level 0 = M.monoscheme) (hS : S.level 0 = N.monoscheme)
    (p : PullbackTower T S) (hp : (p.lift 0).IsSmooth) :
    (∃! q : FineFan.PullbackTower T.toFan S.toFan,
      ∀ i : Fin (n + 1), q.lift i = (p.lift i).toFan) ∧
    (∀ L : Fine.{u}, sharpSpaceMap (𝟙 L.space) = 𝟙 L.toFan.space) ∧
    (∀ (L K H : Fine.{u}) (f : L.space ⟶ K.space) (g : K.space ⟶ H.space),
      sharpSpaceMap (f ≫ g) = sharpSpaceMap f ≫ sharpSpaceMap g) := by
  have hlevelsT := (sharpening_saturated_tower_comparison M n T.toFan
    (congrArg Fine.toFan hT)).2.2 T hT
  have hlevelsS := (sharpening_saturated_tower_comparison N n S.toFan
    (congrArg Fine.toFan hS)).2.2 S hS
  let q : FineFan.PullbackTower T.toFan S.toFan :=
    { lift := fun i ↦ (p.lift i).toFan
      centers := by
        intro i
        change sharpIdeal (S.center i) =
          FineFan.pullbackIdeal (p.lift i.castSucc).toFan (sharpIdeal (T.center i))
        rw [p.centers i]
        apply (sharpening_blowup_ideal_comparison (T.level i.castSucc)
          (hlevelsT.1 i.castSucc).1 (hlevelsT.1 i.castSucc).2).2.2.2.2
          (S.level i.castSucc) (hlevelsS.1 i.castSucc).1
          (hlevelsS.1 i.castSucc).2 (p.lift i.castSucc) (T.center i)
        refine ⟨(T.blowup i).1.1, ?_⟩
        intro x
        obtain ⟨U, hx, n, hn, s, hs, hgen⟩ := (T.blowup i).1.2 x
        exact ⟨U, hx, n, s, hs, hgen⟩
      commutes := by
        intro i
        change sharpSpaceMap (S.arrow i).map ≫ sharpSpaceMap (p.lift i.castSucc).map =
          sharpSpaceMap (p.lift i.succ).map ≫ sharpSpaceMap (T.arrow i).map
        rw [← sharpSpaceMap_properties.2.2.1, ← sharpSpaceMap_properties.2.2.1,
          p.commutes i] }
  refine ⟨⟨q, fun _ ↦ rfl, ?_⟩, sharpSpaceMap_properties.2.1,
    sharpSpaceMap_properties.2.2.1⟩
  intro q' hq'
  have heq : q'.lift = q.lift := funext hq'
  cases q' with
  | mk lift centers commutes =>
    change lift = (fun i ↦ (p.lift i).toFan) at heq
    subst lift
    rfl

end AlgebraicGeometry.Monoscheme
