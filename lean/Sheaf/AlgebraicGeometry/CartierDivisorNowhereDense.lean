import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible
import Mathlib.AlgebraicGeometry.Morphisms.SchemeTheoreticallyDominant

/-!
# The complement of an effective Cartier divisor is dense

Source: Stacks Project, Divisors, Tag 07ZU, Lemma
`complement-effective-Cartier-divisor` (blueprint: lem-pc-cartier-divisor-nowhere-dense).
-/

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- Let `C` be an effective Cartier ideal on `Y`. Its closed subscheme has underlying
space `C.support`, and its open complement is `C.support.compl`. The inclusion is
quasi-compact and scheme-theoretically dense; the complement is topologically dense,
so the divisor contains no nonempty open (Stacks, Tag 07ZU;
(blueprint: lem-pc-cartier-divisor-nowhere-dense)).

Locally the ideal is generated by a nonzerodivisor `a` on an affine chart, by
`IsInvertible`. Principal-open restriction preserves that property by
`lem-pc-localization-preserves-nonzerodivisor`. There the complement is `D(a)`;
`lem-pc-affine-nonzerodivisor-complement-dense` gives injectivity of the restriction
map and topological density. These local checks make the inclusion quasi-compact
by `lem-pc-quasi-compact-local-on-target` and the structure sheaf map injective
globally. The latter is `IsSchemeTheoreticallyDominant`, the predicate of
`def-nagata-scheme-theoretically-dense-open`; density rules out an open subset
inside the support. -/
theorem IsInvertible.compl_support_dense {Y : Scheme.{u}} {C : Y.IdealSheafData}
    (hC : C.IsInvertible) :
    QuasiCompact (Scheme.Opens.ι C.support.compl) ∧
      IsSchemeTheoreticallyDominant (Scheme.Opens.ι C.support.compl) ∧
      Dense (C.support.compl : Set Y) ∧
      ∀ V : Y.Opens, (V : Set Y) ⊆ C.support → V = ⊥ := by
  sorry

end AlgebraicGeometry.Scheme.IdealSheafData
