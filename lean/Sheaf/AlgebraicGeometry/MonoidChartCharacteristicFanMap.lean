module

public import Sheaf.AlgebraicGeometry.MonoidChartCharacteristicStalks

/-!
# Constructing the characteristic fan morphism from stalk charts

Source: ILO VIII Lemma 3.1.8(ii), 3.3.12, and Steps 4--5 of
lem-trf-monoid-chart-characteristic-fan.
(blueprint: lem-trf-chart-characteristic-fan-map).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory Opposite TopologicalSpace

namespace AlgebraicGeometry

/-- The basis construction of the fan morphism, after the characteristic-stalk
calculation has been supplied. This concerns only the Zariski chart and its
normalized ordinary stalk equivalences; no geometric comparison is assumed.
Source: ILO VIII Lemma 3.1.8(ii), 3.3.12; original node Steps 4--5.

Proof. Send x to the complement of the unit face. A product of ring germs is a
unit if and only if both factors are units, so this is a proper prime, including
the empty prime. The inverse image of D(q) is the open unit locus of the chart
function beta(q): an inverse germ lifts to an inverse on a neighborhood.
On that locus the characteristic section of q is one. Thus the chart induces
a homomorphism from Q[q^(-1)] modulo units to characteristic sections there.
Indeed a characteristic sheaf has sharp sections: a unit section has unit germs,
which are one, so sheaf uniqueness makes the section one. Apply
`affineFan_localization_sections` to regard this as a map from the sections on
D(q). On intersections both maps have the same values on Q; localization and
quotient universality make them equal on all fractions. Glue over the basic
opens to obtain f. Its stalk map sends every numerator to the displayed chart
germ. Under a and the canonical affine-fan localization isomorphism it is the
identity of Associates(Q_E), since fractions are generated by numerators and
inverses of elements of E. This proves its bijectivity. The construction works
for Q with units and the empty prime, and is vacuous over an empty scheme.
(blueprint: lem-trf-chart-characteristic-fan-map). -/
theorem chart_characteristic_fan_map
    (X : FineSaturatedLogScheme.{u}) (Q : Type u) [CommMonoid Q]
    (hQ : IsFineSaturatedMonoid Q)
    (c : Q →* X.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (⊤ : X.scheme.Opens).ι)))
    (Z : ZariskiLogStructure X.scheme)
    (e : Z.toZariskiPrelogStructure.EtaleMap X.logStructure)
    (z : Q →* Z.monoidSheaf.obj.obj (op ⊤))
    (hz : Z.IsChart ⊤ z) (he : (e.sectionMap ⊤).comp z = c)
    (a : ∀ x : X.scheme,
      FineFan.stalk Z.characteristicMonoidalSpace.presheaf x ≃*
        Associates (Algebra.faceLocalization Q (X.logStructure.globalChartUnitFace c x)))
    (ha : ∀ (x : X.scheme) (q : Q),
      ∃ r : Algebra.faceLocalization Q (X.logStructure.globalChartUnitFace c x),
        r.val = Algebra.GrothendieckGroup.of q ∧
        a x (FineFan.germ Z.characteristicMonoidalSpace.presheaf ⊤ x (by trivial)
          (Z.characteristicSection ⊤ (z q))) = Associates.mk r) :
    ∃ f : Z.characteristicMonoidalSpace ⟶ FineFan.affine Q,
      (∀ (x : X.scheme) (q : Q),
        q ∈ (f.hom.base x).carrier ↔ q ∉ X.logStructure.globalChartUnitFace c x) ∧
      (∀ x : X.scheme, Function.Bijective (FineFan.stalkMap f x)) ∧
      (∀ (x : X.scheme) (q : Q),
        FineFan.stalkMap f x (FineFan.affineGerm (f.hom.base x) q) =
          FineFan.germ Z.characteristicMonoidalSpace.presheaf ⊤ x (by trivial)
            (Z.characteristicSection ⊤ (z q))) := by
  sorry

end AlgebraicGeometry
