/-! # A component cut out by two independent first jets

Source: Stacks Tags 00NQ, 00NP, 00E3, 00ES and 02IZ.
(blueprint: lem-zl-local-cotangent-pair-component).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory MonoidalCategory
open scoped AlgebraicGeometry

namespace AlgebraicGeometry

private theorem dimension_exists_nat {d : WithBot ℕ∞} (h₀ : 0 ≤ d)
    {e : ℕ} (h : d ≤ e) : ∃ n : ℕ, d = n := by
  induction d using WithBot.recBotCoe with
  | bot => simp at h₀
  | coe a =>
    induction a using ENat.recTopCoe with
    | top =>
      have : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((e : ℕ∞) : WithBot ℕ∞) := h
      exact absurd (top_le_iff.1 (WithBot.coe_le_coe.1 this)) (ENat.natCast_ne_top e)
    | coe a => exact ⟨a, rfl⟩

open IsLocalRing in
private theorem regular_quotient_of_independent
    {R : Type u} [CommRing R] [IsRegularLocalRing R]
    (s : Set (maximalIdeal R)) (hsfin : s.Finite)
    (hs : LinearIndepOn (ResidueField R) (maximalIdeal R).toCotangent s) :
    IsRegularLocalRing (R ⧸ Ideal.span (Subtype.val '' s)) := by
  classical
  let m := maximalIdeal R
  obtain ⟨b, -, hsb, hb_span, hb⟩ := exists_linearIndepOn_extension hs (Set.subset_univ s)
  have hspan_b : Submodule.span (ResidueField R) (m.toCotangent '' b) = ⊤ := by
    rw [eq_top_iff]
    rintro v -
    obtain ⟨x, rfl⟩ := m.toCotangent_surjective v
    exact hb_span ⟨x, trivial, rfl⟩
  have : Finite b := LinearIndependent.finite_of_isNoetherian hb
  have hbfin : b.Finite := Set.toFinite b
  have hn : m.spanFinrank = b.ncard := spanFinrank_maximalIdeal_eq_ncard hbfin hb hspan_b
  have hdimR : ringKrullDim R = b.ncard := by
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, hn]
  have hcard : (b \ s).ncard + s.ncard = b.ncard := Set.ncard_sdiff_add_ncard_of_subset hsb hbfin
  have hm : m = Ideal.span (Subtype.val '' b) := by
    have : Submodule.span R b = ⊤ := CotangentSpace.span_image_eq_top_iff.1 hspan_b
    change m = Submodule.span R (m.subtype '' b)
    rw [Submodule.span_image, this, Submodule.map_top, Submodule.range_subtype]
  set J := Ideal.span (Subtype.val '' s)
  have hJne : J ≠ ⊤ := ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top
    (Ideal.span_le.mpr (by rintro _ ⟨x, _, rfl⟩; exact x.2))
  have : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.2 hJne
  have : IsLocalRing (R ⧸ J) := .of_surjective' _ Ideal.Quotient.mk_surjective
  -- the maximal ideal of `R ⧸ J` is generated by the images of `b \ s`
  have hmapJ : maximalIdeal (R ⧸ J) =
      Ideal.span ((fun x : m ↦ Ideal.Quotient.mk J x) '' (b \ s)) := by
    rw [← map_maximalIdeal_of_surjective _ (Ideal.Quotient.mk_surjective (I := J))]
    conv_lhs => rw [show maximalIdeal R = Ideal.span (Subtype.val '' b) from hm]
    rw [Ideal.map_span, Set.image_image]
    refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_mono (Set.image_mono Set.sdiff_subset))
    rintro _ ⟨x, hx, rfl⟩
    by_cases hxs : x ∈ s
    · change Ideal.Quotient.mk J x ∈ _
      rw [Ideal.Quotient.eq_zero_iff_mem.2
        (Ideal.subset_span (Set.mem_image_of_mem Subtype.val hxs))]
      exact zero_mem _
    · exact Ideal.subset_span ⟨x, ⟨hx, hxs⟩, rfl⟩
  have hembJ : (maximalIdeal (R ⧸ J)).spanFinrank ≤ (b \ s).ncard := by
    rw [hmapJ]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (hbfin.sdiff.image _)).trans
      (Set.ncard_image_le hbfin.sdiff)
  have hkrull : ringKrullDim R ≤ ringKrullDim (R ⧸ J) + s.ncard := by
    have := ringKrullDim_le_ringKrullDim_quotient_add_card (hsfin.toFinset.image Subtype.val)
      (by
        intro x hx
        simp only [Finset.coe_image, Set.Finite.coe_toFinset, Set.mem_image] at hx
        obtain ⟨y, -, rfl⟩ := hx
        rw [ringJacobson_eq_maximalIdeal]
        exact y.2)
    rwa [Finset.coe_image, Set.Finite.coe_toFinset,
      Finset.card_image_of_injective _ Subtype.val_injective,
      ← Set.ncard_eq_toFinset_card s hsfin] at this
  have hdim : ringKrullDim (R ⧸ J) ≤ ((b \ s).ncard : ℕ) :=
    (ringKrullDim_le_spanFinrank_maximalIdeal (R ⧸ J)).trans (by exact_mod_cast hembJ)
  obtain ⟨d, hd⟩ := dimension_exists_nat ringKrullDim_nonneg_of_nontrivial hdim
  have hd₁ : d ≤ (b \ s).ncard := by
    rw [hd] at hdim
    exact_mod_cast hdim
  have hd₂ : b.ncard ≤ d + s.ncard := by
    rw [hdimR, hd] at hkrull
    exact_mod_cast hkrull
  exact .of_spanFinrank_maximalIdeal_le _ (by
    rw [hd]
    exact_mod_cast hembJ.trans (by omega))


open IsLocalRing in
private theorem cotangent_pair_prime_height
    {R : Type u} [CommRing R] [IsRegularLocalRing R]
    (a : Fin 2 → maximalIdeal R)
    (ha : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (a i))) :
    (Ideal.span (Set.range fun i ↦ (a i : R))).IsPrime ∧
      (Ideal.span (Set.range fun i ↦ (a i : R))).height = 2 := by
  classical
  let m := maximalIdeal R
  let P := Ideal.span (Set.range fun i ↦ (a i : R))
  let Q : Ideal R := Ideal.span {(a 0 : R)}
  have hinj : Function.Injective a := fun i j h ↦ ha.injective (congrArg m.toCotangent h)
  have hs : LinearIndepOn (ResidueField R) m.toCotangent (Set.range a) :=
    (linearIndepOn_range_iff hinj _).mpr ha
  have hregP : IsRegularLocalRing (R ⧸ P) := by
    have h := regular_quotient_of_independent (Set.range a) (Set.finite_range a) hs
    have heq : Subtype.val '' Set.range a = Set.range (fun i ↦ (a i : R)) :=
      (Set.range_comp' (fun x : m ↦ (x : R)) a).symm
    rw [heq] at h
    exact h
  have hprimeP : P.IsPrime := (Ideal.Quotient.isDomain_iff_prime P).mp (by infer_instance)
  have hx : (a 0 : R) ∉ m ^ 2 := by
    intro hx
    exact ha.ne_zero 0 ((Ideal.toCotangent_eq_zero m (a 0)).mpr hx)
  obtain ⟨hlocal, hregQ, -⟩ := IsRegularLocalRing.quotient_span_singleton (a 0).2 hx
  let := hlocal
  let := hregQ
  have hprimeQ : Q.IsPrime := (Ideal.Quotient.isDomain_iff_prime Q).mp (by infer_instance)
  let := hprimeP
  let := hprimeQ
  have hne0 : (a 0 : R) ≠ 0 := by
    intro hzero
    apply hx
    rw [hzero]
    exact zero_mem _
  have hQheight : Q.height = 1 :=
    Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_iff_ne_zero.mpr hne0) ((mem_maximalIdeal _).mp (a 0).2)
  have hnot : (a 1 : R) ∉ Q := by
    intro h
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h
    have heq : (1 : ResidueField R) • m.toCotangent (a 1) =
        (residue R c) • m.toCotangent (a 0) := by
      rw [one_smul]
      change m.toCotangent (a 1) = algebraMap R (ResidueField R) c • _
      rw [IsScalarTower.algebraMap_smul, ← map_smul]
      congr 1
      exact Subtype.ext hc.symm
    have h01 := ha.eq_of_smul_apply_eq_smul_apply 1 (residue R c) 1 0 one_ne_zero heq
    exact (by decide : (1 : Fin 2) ≠ 0) h01
  have hQP : Q < P := lt_of_le_of_ne
    (Ideal.span_le.mpr (by
      rintro x (rfl : x = (a 0 : R))
      exact Ideal.subset_span (Set.mem_range_self 0))) (by
      intro heq
      apply hnot
      rw [heq]
      exact Ideal.subset_span (Set.mem_range_self 1))
  have hlo : (2 : ℕ∞) ≤ P.height := by
    have h := Ideal.height_add_one_le_of_lt_of_isPrime hQP
    simpa only [hQheight, one_add_one_eq_two] using h
  have hup : P.height ≤ 2 := by
    have h := Ideal.height_le_height_add_encard_of_subset
      (Set.range fun i ↦ (a i : R)) (p := P) Ideal.subset_span
    rw [Ideal.map_quotient_self, Ideal.height_bot, zero_add] at h
    exact h.trans (by
      simpa only [Set.image_univ, Set.encard_univ, ENat.card_eq_coe_fintype_card,
        Fintype.card_fin, Nat.cast_ofNat] using
        (Set.encard_image_le (fun i ↦ (a i : R)) Set.univ))
  exact ⟨hprimeP, le_antisymm hup hlo⟩

/-- Two sections with independent cotangent classes at a regular point cut out
an irreducible component of codimension two containing that point.

Source: the finite-cover Bertini proof, paragraph 3, expanded by Stacks Tags
00NQ, 00NP, 00E3, 00ES and 02IZ.
(blueprint: lem-zl-local-cotangent-pair-component).

Proof: extend the two independent classes to a basis of the cotangent space of the
regular local ring at t. Lift the remaining classes and apply Nakayama: these lifts,
starting with the two displayed germs, form a regular system of parameters. The
quotients by the first one and the first two parameters are regular local domains.
Thus the ideals (0), (f₀), (f₀,f₁) form a strict chain of prime ideals. The last ideal
has height at least two and at most two by the height theorem. Contract it to the
affine coordinate ring of U. Localization identifies all primes below it, so its
contraction has height two and is minimal over the two coefficient ideal. Its zero
set is an affine irreducible component containing t. Take its closure in X. The
open-subspace correspondence makes this a maximal irreducible closed subset of the
global intersection of the two zero supports. The generic point lies in U and
localization preserves its height, so its coheight in X is two. -/
theorem local_cotangent_pair_component
    (X : Scheme.{u}) (M : X.Modules) [M.IsInvertible]
    (s₂ s₃ : Γ(M, ⊤)) (t : X) [IsRegularLocalRing (X.presheaf.stalk t)]
    (U : X.affineOpens) (htU : t ∈ U.1) (e : Γ(M, U.1))
    (he : Scheme.Modules.IsFreeGenerator e) (f : Fin 2 → Γ(X, U.1))
    (hs₂ : M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s₂ = f 0 • e)
    (hs₃ : M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s₃ = f 1 • e)
    (hf : ∀ i, X.presheaf.germ U.1 t htU (f i) ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk t))
    (hind : LinearIndependent (IsLocalRing.ResidueField (X.presheaf.stalk t))
      (fun i ↦ (IsLocalRing.maximalIdeal (X.presheaf.stalk t)).toCotangent
        ⟨X.presheaf.germ U.1 t htU (f i), hf i⟩)) :
    ∃ W : TopologicalSpace.IrreducibleCloseds X,
      Maximal (fun Z : TopologicalSpace.IrreducibleCloseds X ↦
        (Z : Set X) ⊆ (Scheme.Modules.homOfGlobalSection M s₂).zeroLocus.support ∩
          (Scheme.Modules.homOfGlobalSection M s₃).zeroLocus.support) W ∧
      t ∈ (W : Set X) ∧ Order.coheight W = 2 := by
  classical
  have : SheafOfModules.IsInvertible.{u, u, u} (Scheme.Modules.unit X) :=
    Scheme.Modules.IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  have : SheafOfModules.IsInvertible.{u, u, u} M :=
    Scheme.Modules.IsInvertible.sheafOfModules_isInvertible M
  let R := X.presheaf.stalk t
  let A := Γ(X, U.1)
  let : Algebra A R := X.presheaf.algebra_section_stalk ⟨t, htU⟩
  let m : Ideal A := (U.2.primeIdealOf ⟨t, htU⟩).asIdeal
  let : m.IsPrime := (U.2.primeIdealOf ⟨t, htU⟩).isPrime
  let : IsLocalization.AtPrime R m := U.2.isLocalization_stalk ⟨t, htU⟩
  let a : Fin 2 → IsLocalRing.maximalIdeal R :=
    fun i ↦ ⟨X.presheaf.germ U.1 t htU (f i), hf i⟩
  let P : Ideal R := Ideal.span (Set.range fun i ↦ (a i : R))
  obtain ⟨hP, hPheight⟩ := cotangent_pair_prime_height a hind
  let := hP
  let q : Ideal A := P.comap (algebraMap A R)
  let : q.IsPrime := inferInstance
  let q₀ : Spec A := ⟨q, inferInstance⟩
  have hqle : q ≤ m :=
    (IsLocalization.AtPrime.orderIsoOfPrime R m ⟨P, hP⟩).2.2
  have hqheight : q.height = 2 :=
    (IsLocalization.height_under m.primeCompl P).trans hPheight
  let J : Ideal A := Ideal.span (Set.range f)
  have hmapJ : J.map (algebraMap A R) = P := by
    rw [Ideal.map_span, ← Set.range_comp']
    rfl
  have hJq : J ≤ q := Ideal.map_le_iff_le_comap.mp (by rw [hmapJ])
  have hminimal (p : Ideal A) [p.IsPrime] (hJp : J ≤ p) (hpq : p ≤ q) : q ≤ p := by
    have hPm : P ≤ p.map (algebraMap A R) := by
      rw [← hmapJ]
      exact Ideal.map_mono hJp
    have hdis : Disjoint (m.primeCompl : Set A) (p : Set A) := by
      exact Set.disjoint_left.mpr (fun x hx hp ↦ hx ((hpq.trans hqle) hp))
    have hc : q ≤ (p.map (algebraMap A R)).comap (algebraMap A R) :=
      Ideal.comap_mono hPm
    change q ≤ (p.map (algebraMap A R)).under A at hc
    rwa [IsLocalization.under_map_of_isPrime_disjoint m.primeCompl R
      (show p.IsPrime from inferInstance) hdis] at hc
  let I₂ := (Scheme.Modules.homOfGlobalSection M s₂).zeroLocus
  let I₃ := (Scheme.Modules.homOfGlobalSection M s₃).zeroLocus
  have hI₂ : I₂.ideal U = Ideal.span {f 0} :=
    Scheme.Modules.Hom.ideal_zeroLocus _ U (Scheme.Modules.isFreeGenerator_one U.1) he
      ((Scheme.Modules.homOfGlobalSection_app_one M s₂ U.1).trans hs₂)
  have hI₃ : I₃.ideal U = Ideal.span {f 1} :=
    Scheme.Modules.Hom.ideal_zeroLocus _ U (Scheme.Modules.isFreeGenerator_one U.1) he
      ((Scheme.Modules.homOfGlobalSection_app_one M s₃ U.1).trans hs₃)
  have hmem (I : X.IdealSheafData) (p : PrimeSpectrum A) :
      U.2.fromSpec p ∈ I.support ↔ I.ideal U ≤ p.asIdeal := by
    have hpU : U.2.fromSpec p ∈ U.1 := by
      rw [← SetLike.mem_coe, ← U.2.range_fromSpec]
      exact Set.mem_range_self p
    rw [I.mem_support_iff_of_mem hpU]
    exact Set.ext_iff.mp (U.2.fromSpec_preimage_zeroLocus (I.ideal U : Set A)) p
  have hpair (p : PrimeSpectrum A) :
      U.2.fromSpec p ∈ (I₂.support : Set X) ∩ (I₃.support : Set X) ↔ J ≤ p.asIdeal := by
    refine (and_congr (hmem I₂ p) (hmem I₃ p)).trans ?_
    rw [hI₂, hI₃]
    dsimp only [J]
    simp only [Ideal.span_le, Set.singleton_subset_iff, Set.range_subset_iff]
    exact ⟨fun h i ↦ by fin_cases i <;> tauto, fun h ↦ ⟨h 0, h 1⟩⟩
  let y : X := U.2.fromSpec q₀
  let W : TopologicalSpace.IrreducibleCloseds X := irreducibleSetEquivPoints.symm y
  have hygen : IsGenericPoint y (W : Set X) := isGenericPoint_closure
  have htW : t ∈ (W : Set X) := by
    apply hygen.specializes_iff_mem.mp
    have hspec : q₀ ⤳ U.2.primeIdealOf ⟨t, htU⟩ :=
      (PrimeSpectrum.le_iff_specializes _ _).mp hqle
    simpa only [U.2.fromSpec_primeIdealOf] using hspec.map U.2.fromSpec.continuous
  have hW : (W : Set X) ⊆ (I₂.support : Set X) ∩ (I₃.support : Set X) := by
    apply ((I₂.support.isClosed.inter I₃.support.isClosed).closure_subset_iff).mpr
    exact Set.singleton_subset_iff.mpr ((hpair q₀).mpr hJq)
  refine ⟨W, ⟨hW, ?_⟩, htW, ?_⟩
  · intro Z hZ hWZ
    let z : X := irreducibleSetEquivPoints Z
    have hzgen : IsGenericPoint z (Z : Set X) :=
      Z.2.isGenericPoint_genericPoint Z.3
    have hzU : z ∈ U.1 := (hzgen.specializes (hWZ htW)).mem_open U.1.isOpen htU
    let p : PrimeSpectrum A := U.2.primeIdealOf ⟨z, hzU⟩
    have hpz : U.2.fromSpec p = z := U.2.fromSpec_primeIdealOf ⟨z, hzU⟩
    have hpq : p.asIdeal ≤ q := by
      apply (PrimeSpectrum.le_iff_specializes p q₀).mpr
      apply U.2.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp
      rw [hpz]
      exact hzgen.specializes (hWZ hygen.mem)
    have hJp : J ≤ p.asIdeal := by
      apply (hpair p).mp
      rw [hpz]
      exact hZ hzgen.mem
    have hp : p.asIdeal = q := le_antisymm hpq (hminimal p.asIdeal hJp hpq)
    have hzy : z = y := hpz.symm.trans (congrArg U.2.fromSpec (PrimeSpectrum.ext hp))
    have hZW : Z = W := irreducibleSetEquivPoints.injective
      (hzy.trans (irreducibleSetEquivPoints.apply_symm_apply y).symm)
    exact hZW.le
  · calc
      Order.coheight W = Order.coheight y :=
        (Order.coheight_orderIso irreducibleSetEquivPoints W).symm.trans
          (congrArg Order.coheight (irreducibleSetEquivPoints.apply_symm_apply y))
      _ = Order.coheight q₀ := coheight_eq_of_isOpenImmersion U.2.fromSpec
      _ = q.height := (idealHeight_eq_coheight _ q₀).symm
      _ = 2 := hqheight

end AlgebraicGeometry
