/-!
# The affine model defined by field generators

Source: Stacks Project, Varieties, Tag 0BXN, essential surjectivity in the proof;
Algebra, Tag 00P0, dimension of finite type domains over fields;
Schemes, Tag 01HV, and Morphisms, Tags 01RW and 01QO
(blueprint: lem-trf-field-generators-affine-model).
-/

@[expose] public section

universe u

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry

/-- The polynomial subalgebra generated by a finite family of field generators gives an
integral affine model, with the prescribed function field, dimension and closed embedding.
The evaluation homomorphism is characterized by its values on every variable. The function
field equivalence commutes with the canonical map from the generated subalgebra, so it is
induced by the inclusion in `E` and, in particular, fixes the coefficient field `k`.

Source: Stacks Project, Varieties, Tag 0BXN, essential-surjectivity paragraph; Algebra,
Tag 00P0; Schemes, Tag 01HV; Morphisms, Tags 01RW and 01QO
(blueprint: lem-trf-field-generators-affine-model).

Proof: Evaluation maps the polynomial ring onto `A = k[e_i]`, giving finite type
(`def-weil-pbc-mv-polynomial-ring`, `def-weil-pbc-finite-type-algebra`). Since `A` is a
subring of the field `E`, it is a domain. The fractions `a/b` with `a,b` in `A` and `b`
nonzero form a subfield of `E`: use common denominators for addition, multiply fractions,
negate numerators, and invert a nonzero fraction by interchanging numerator and denominator.
This subfield contains `k` and every generator, so field generation makes it all of `E`.
The affine domain stalk theorem `lem-weil-pbc-spec-domain-stalks-function-field` now gives
integrality, the zero generic prime and the induced function-field equivalence over `A`.
The structure map is of finite type because its source has the single affine chart `A`,
which is finite type over `k`; it is quasi-compact since the source is affine.
Apply `lem-weil-pbc-finite-type-domain-dimension-trdeg`, identify the fraction field with
`E`, and apply `lem-weil-pbc-spec-topological-krull-dimension-ring` to obtain the finite
common dimension. Finally the surjective evaluation map gives a closed immersion by
`lem-weil-pbc-closed-immersion-affine-cover-criterion`; identify the polynomial spectrum
with affine space using `def-nagata-relative-affine-space`. Evaluation fixes constants,
so contravariant functoriality of `Spec` proves that this immersion is over `k`. -/
theorem fieldGeneratorsAffineModel
    (k E : Type u) [Field k] [Field E] [Algebra k E]
    (r : ℕ) (e : Fin r → E)
    (he : IntermediateField.adjoin k (Set.range e) = ⊤) :
    IsDomain (Algebra.adjoin k (Set.range e)) ∧
    RingHom.FiniteType (algebraMap k (Algebra.adjoin k (Set.range e))) ∧
    IsFractionRing (Algebra.adjoin k (Set.range e)) E ∧
    IsIntegral (Spec (.of (Algebra.adjoin k (Set.range e)))) ∧
    LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (Set.range e))))) ∧
    QuasiCompact
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (Set.range e))))) ∧
    genericPoint (Spec (.of (Algebra.adjoin k (Set.range e)))) =
      (⊥ : PrimeSpectrum (Algebra.adjoin k (Set.range e))) ∧
    (∃ θ : (Spec (.of (Algebra.adjoin k (Set.range e)))).functionField ≃+* E,
      ∀ a : Algebra.adjoin k (Set.range e),
        θ (StructureSheaf.toStalk (Algebra.adjoin k (Set.range e))
          (genericPoint (Spec (.of (Algebra.adjoin k (Set.range e))))) a) = (a : E)) ∧
    (∃ d : ℕ,
      topologicalKrullDim (Spec (.of (Algebra.adjoin k (Set.range e)))) =
        (d : WithBot ℕ∞) ∧ Algebra.trdeg k E = (d : Cardinal)) ∧
    ∃ ε : MvPolynomial (ULift.{u} (Fin r)) k →ₐ[k] Algebra.adjoin k (Set.range e),
      (∀ i : ULift.{u} (Fin r), (ε (MvPolynomial.X i) : E) = e i.down) ∧
      Function.Surjective ε ∧
      IsClosedImmersion
        (Spec.map (CommRingCat.ofHom ε.toRingHom) ≫
          (AffineSpace.SpecIso (ULift.{u} (Fin r)) (.of k)).inv) ∧
      (Spec.map (CommRingCat.ofHom ε.toRingHom) ≫
          (AffineSpace.SpecIso (ULift.{u} (Fin r)) (.of k)).inv) ≫
          (AffineSpace (ULift.{u} (Fin r)) (Spec (.of k)) ↘ Spec (.of k)) =
        Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (Set.range e)))) := by
  sorry

end AlgebraicGeometry
