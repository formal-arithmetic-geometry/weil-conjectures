import Mathlib.RingTheory.Valuation.Discrete.IsDiscreteValuationRing
import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.FieldTheory.IsAlgClosed.Basic

/-!
# Preservation of normalized order under residue-field extension

Source: literature/stacks-project/algebra.tex, Lemma 00PD
(blueprint: lem-sc-dvr-field-extension-order).
-/

universe u v w x

open scoped TensorProduct

namespace WeilConjectures

open IsDiscreteValuationRing

/-- Source: Stacks Algebra Lemma 00PD, after residue-field extension
(blueprint: lem-sc-dvr-field-extension-order).
`K` is `FractionRing R`, `R'` is `Localization.AtPrime` of the extended maximal ideal
`𝔪 (R ⊗[k] k')` (its primality is a hypothesis so that the localization can be formed;
step 1 below proves it), and `K'` is a fraction field of `K ⊗[k] k'` with an
`R'`-algebra structure compatible with `R ⊗[k] k' → K ⊗[k] k'`. The normalized exponent is
`-WithZero.log` of the maximal-ideal adic valuation, as in
`IsDiscreteValuationRing.exists_negative_valuation_of_tensor_surjective`.

Proof: (1) Choose a uniformizer `t` of `R`. Tensoring `0 → 𝔪 → R → k → 0` over the field
`k` with `k'` identifies `(R ⊗ k') / t(R ⊗ k')` with `k'`, a field; so `𝔪(R ⊗ k')` is
maximal and `R'` is local with maximal ideal generated by `t` and residue field `k'`.
(2) Write `z ≠ 0` in `R ⊗ k'` as `∑ rᵢ ⊗ aᵢ` with the `aᵢ` independent over `k`; with `n`
the least `t`-exponent of the nonzero `rᵢ` (lem-weil-pbc-dvr-unit-times-uniformizer-power),
`z = tⁿ w` with `w` of nonzero image in `k'`. Products of such elements are nonzero, so
`R ⊗ k'` and `R'` are domains; every nonzero element of `R'` is `u tⁿ` with `u` a unit and
`n` unique; every nonzero ideal is `t^{n₀} R'`; so `R'` is a DVR with uniformizer `t`, and
any other uniformizer of `R`, a unit multiple of `t`, stays one since units of `R` stay units.
(3) For `f ∈ K×` write `f = u tⁿ` with `u ∈ Rˣ`, `n ∈ ℤ`; `u` stays a unit of `R'`, so the
exponent of `f` in `R'` is `n`, its exponent in `R`. -/
theorem dvr_field_extension_order
    (k : Type u) (k' : Type v) (R : Type w)
    [Field k] [IsAlgClosed k] [Field k'] [Algebra k k']
    [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
    (residue : (R ⧸ IsLocalRing.maximalIdeal R) ≃ₐ[k] k)
    [(Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R)).IsPrime]
    (K' : Type x) [Field K']
    [Algebra (FractionRing R ⊗[k] k') K'] [IsFractionRing (FractionRing R ⊗[k] k') K']
    [Algebra (Localization.AtPrime
      (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))) K']
    [IsFractionRing (Localization.AtPrime
      (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))) K']
    (hK' : ∀ z : R ⊗[k] k',
      algebraMap (Localization.AtPrime
        (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))) K'
        (algebraMap (R ⊗[k] k') _ z) =
      algebraMap (FractionRing R ⊗[k] k') K'
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k R (FractionRing R))
          (AlgHom.id k k') z)) :
    ∃ _ : IsDomain (Localization.AtPrime
        (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))),
      IsDiscreteValuationRing (Localization.AtPrime
        (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))) ∧
      (∀ t : R, IsLocalRing.maximalIdeal R = Ideal.span {t} →
        IsLocalRing.maximalIdeal (Localization.AtPrime
          (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))) =
          Ideal.span {algebraMap R (Localization.AtPrime
            (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R))) t}) ∧
      ∀ [IsDiscreteValuationRing (Localization.AtPrime
          (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R)))]
        (f : FractionRing R), f ≠ 0 →
        -WithZero.log ((maximalIdeal R).valuation (FractionRing R) f) =
        -WithZero.log ((maximalIdeal (Localization.AtPrime
          (Ideal.map (algebraMap R (R ⊗[k] k')) (IsLocalRing.maximalIdeal R)))).valuation K'
            (algebraMap (FractionRing R ⊗[k] k') K' (f ⊗ₜ 1))) := by
  sorry

end WeilConjectures
