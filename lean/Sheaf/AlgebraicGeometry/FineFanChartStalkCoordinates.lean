module

public import Sheaf.AlgebraicGeometry.AffineFanHomUniversal

/-!
# Stalk coordinates in a fine affine fan chart

Source: ILO VIII 3.1.1--3.1.4, pp.98--99
(blueprint: lem-trf-fine-fan-chart-stalk-coordinates).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory TopologicalSpace Opposite

namespace AlgebraicGeometry.FineFan

/-- The actual stalk in a fine chart is fine and is the sharpened face localization,
with each canonical chart section sent to its numerator class.

Source: ILO VIII 3.1.1--3.1.4, pp.98--99
(blueprint: lem-trf-fine-fan-chart-stalk-coordinates).

Proof: Transport the stalk through the open restriction and the chart isomorphism.
Apply `affineFan_localization_sections` at the chart prime. Naturality of germs
under both transports, followed by the numerator and germ formulas of that lemma,
gives the displayed formula. The complement of the prime is generated by the
members of a finite generating tuple which avoid it, by
`monoidPrime_minimal_neighborhood`. Its localization is thus generated by that
original tuple and the inverse of their selected product. It is a submonoid of
the group completion, hence integral. Its sharpening is integral by
`integral_sharpening_group_exactness`; the images of the finite generating list
generate its sharpening. Transport these two properties along the displayed
monoid equivalence to obtain fineness of the actual stalk. Empty tuples cause
no exception: the selected product and its inverse are both the identity. -/
theorem fineFan_chart_stalk_coordinates (X : SheafedSpace CommMonCat.{u})
    (c : Chart X) (z : X) (hc : z ∈ c.openSet) :
    IsFine (stalk X.presheaf z) ∧
    ∃ e : stalk X.presheaf z ≃*
        Associates (Algebra.faceLocalization c.monoid
          (Submonoid.closure {b | b ∉ (c.iso.hom.hom.base ⟨z, hc⟩).carrier})),
      ∀ b : c.monoid,
        ∃ q : Algebra.faceLocalization c.monoid
            (Submonoid.closure {b | b ∉ (c.iso.hom.hom.base ⟨z, hc⟩).carrier}),
          q.val = Algebra.GrothendieckGroup.of b ∧
          e (germ X.presheaf c.openSet z hc
            ((X.presheaf.map (eqToHom (Opens.isOpenEmbedding_obj_top c.openSet).symm).op)
              (affinePullback c.iso.hom b))) = Associates.mk q := by sorry

end AlgebraicGeometry.FineFan
