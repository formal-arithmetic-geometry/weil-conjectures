module

public import Sheaf.AlgebraicGeometry.AlgebraicSpaceModuleOperations
public import Sheaf.AlgebraicGeometry.AlgebraicSpaceSmallRingedModel
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Submodule
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Limits
public import Mathlib.RingTheory.Ideal.Maps

/-! # The defining ideal and its filtration on an algebraic-space module

Source: Stacks Project, Morphisms of Spaces, Tag 03MB; Spaces Cohomology, Tag 07UK
(blueprint: def-sfb-space-closed-ideal-filtration).

The ideal consists of functions whose pullbacks to every chart of the closed subspace
are zero. The product is the intersection of all sheaf submodules containing the local
products, so it is the sheaf generated by those products, not just their sectionwise span.
Quotients are transported cokernels through the existing small-site equivalence.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.AlgebraicSpace

/-- Sections of the kernel of O_X → i_* O_Z, using the specified chart projections.
Source: Stacks, Tag 03MB (blueprint: def-sfb-space-closed-ideal-filtration). -/
def closedIdealSections {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (V : X.EtaleSite) : Ideal (X.structureSheaf.obj.obj (op V)) :=
  ⨅ q : ModuleChart i V, RingHom.ker (moduleChartScalar i V q).hom

/-- The subsheaf generated by products of ideal sections with sections in `N`, expressed
as an intersection of all containing sheaf submodules. This constructs its section data.
Source: Stacks, Tag 07UK (blueprint: def-sfb-space-closed-ideal-filtration). -/
def closedIdealProductFamily {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (F : X.Modules) (N : F.val.Submodule) : F.val.Submodule :=
  sInf {K | Presheaf.IsSheaf X.etaleTopology K.toPresheafOfModules.presheaf ∧
    ∀ (V : X.EtaleSite) (a : X.structureSheaf.obj.obj (op V)),
      a ∈ closedIdealSections i V → ∀ m : F.val.obj (op V),
        m ∈ N.obj (op V) → a • m ∈ K.obj (op V)}

/-- Iterated ideal products as actual subpresheaves of the fixed ambient module.
Source: Stacks, Tag 07UK (blueprint: def-sfb-space-closed-ideal-filtration). -/
def closedIdealPowerFamily {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (F : X.Modules) : ℕ → F.val.Submodule
  | 0 => ⊤
  | n + 1 => closedIdealProductFamily i F (closedIdealPowerFamily i F n)

/-- These intersections are sheaves; in degree zero the full ambient sheaf is used.
Source: Stacks, Tags 03MB and 07UK
(blueprint: def-sfb-space-closed-ideal-filtration).

Proof: an intersection of subsheaves of a sheaf is a subsheaf. A compatible family
in the intersection glues uniquely in F. In each containing subsheaf its members also
glue, and uniqueness in F shows that this same glued section lies in every subsheaf.
Thus it lies in their intersection. The family of containing subsheaves includes F.
For n = 0 use the canonical identification of the full submodule with F; for a successor
apply the intersection argument to the defining family. All restriction maps are the
restrictions of F, and every fibre is the indicated intersection of submodules. -/
theorem closedIdealPowerFamily_isSheaf {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (F : X.Modules) (n : ℕ) :
    Presheaf.IsSheaf X.etaleTopology
      (closedIdealPowerFamily i F n).toPresheafOfModules.presheaf := by
  sorry

/-- The actual sheaf I^n F, with I^0 F canonically identified with F.
Source: Stacks, Tag 07UK (blueprint: def-sfb-space-closed-ideal-filtration). -/
def closedIdealPowerModule {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (F : X.Modules) (n : ℕ) : X.Modules :=
  ⟨(closedIdealPowerFamily i F n).toPresheafOfModules,
    closedIdealPowerFamily_isSheaf i F n⟩

/-- The inclusion of the constructed ideal product in F.
Source: Stacks, Tag 07UK (blueprint: def-sfb-space-closed-ideal-filtration). -/
def closedIdealPowerInclusion {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (F : X.Modules) (n : ℕ) : closedIdealPowerModule i F n ⟶ F :=
  ⟨(closedIdealPowerFamily i F n).ι⟩

/-- The canonical quotient F / I^n F. The small-model equivalence retains the given
module universe, and its inverse carries the cokernel back to the original module site.
Source: Stacks, Tags 07UK and 039Z
(blueprint: def-sfb-space-closed-ideal-filtration). -/
def closedIdealPowerQuotient {S : Scheme.{u}} {Z X : AlgebraicSpace S}
    (i : Z ⟶ X) (F : X.Modules) (n : ℕ) : X.Modules :=
  X.smallModuleEquivalence.inverse.obj
    (cokernel (X.smallModuleRestriction.map (closedIdealPowerInclusion i F n)))

end AlgebraicGeometry.AlgebraicSpace
