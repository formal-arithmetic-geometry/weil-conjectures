/-!
# Monomial Rees algebras and fine log blowup charts

Source: ILO, Exposé VIII, proof of 3.4.6(i), printed p. 111, using the monomial
Tor calculation in the proof of 3.4.3, printed p. 110
(blueprint: lem-trf-monomial-rees-chart-comparison).

We use multiplicative notation for the additive monoid in the source: `p / h ^ n`
in the group completion denotes `p - n h`. The set `Set.univ * (E : Set P) ^ n`
is `nH`, including `0H = P`. The comparison package records the maps by their
values, their grading, their localization squares, and the fine universal property
on the ordinary blowup. No saturation or normalization is made here.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
open CategoryTheory CategoryTheory.Limits Opposite TensorProduct
open scoped Pointwise

namespace AlgebraicGeometry

/-- The log ideal generated by a finite family of sections of a global chart, with
membership checked sheaf-locally. Source: ILO VIII 3.3.7 and 3.4.2
(blueprint: lem-trf-monomial-rees-chart-comparison). -/
def monomialChartLogIdeal (X : FineSaturatedLogScheme.{u})
    {P : Type u} [CommMonoid P]
    (c : P →* X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))))
    (E : Finset P) : X.logStructure.IdealFamily :=
  fun W ↦ {s | ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ X.scheme) (w : (Scheme.pointSmallEtale t).fiber.obj W),
    ∃ e ∈ E, ∃ m : X.logStructure.toEtalePrelogStructure.stalk t,
      X.logStructure.toEtalePrelogStructure.germ t (Scheme.Etale.mk (𝟙 X.scheme))
        ((Scheme.pointSmallEtale t).fiber.map
          (MorphismProperty.Over.homMk W.hom (Category.comp_id W.hom)) w) (c e) * m =
      X.logStructure.toEtalePrelogStructure.germ t W w s}

/-- The overlap element `1 tensor z^(k-h)` in the h-chart. This is a real monomial
in the existing tensor chart construction. Source: ILO VIII 3.1.19, 3.4.6(i)
(blueprint: lem-trf-monomial-rees-chart-comparison). -/
noncomputable def monomialChartRatio {A P : Type u} [CommRing A] [CommMonoid P]
    (α : P →* A) (E : Finset P) (h k : {h : P // h ∈ E}) :
    logIdealTensorRing A α (logIdealChartInclusion E h.val) :=
  logIdealTensorMonomial A α (logIdealChartInclusion E h.val)
    ⟨Algebra.GrothendieckGroup.of k.val / Algebra.GrothendieckGroup.of h.val,
      Submonoid.subset_closure (Or.inr ⟨k.val, k.property, rfl⟩)⟩

set_option genInjectivity false in
set_option genSizeOfSpec false in
/-- The geometric part of the same monomial comparison, factored to keep the dependent
constructor and its type checking small. Its fine log charts are the displayed ring
comparisons followed by the existing ordinary blowup charts.
Source: ILO VIII 3.3.8 and proof of 3.4.6(i), printed p. 111
(blueprint: lem-trf-monomial-rees-chart-comparison). -/
structure MonomialFineBlowupComparison
    (X : FineSaturatedLogScheme.{u}) (A P : Type u) [CommRing A] [CommMonoid P]
    (eA : X.scheme ≅ Spec (.of A)) (α : P →* A)
    (c : P →* X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))))
    (E : Finset P) (J : Ideal A)
    (chartEquiv : ∀ h : {h : P // h ∈ E},
      logIdealTensorRing A α (logIdealChartInclusion E h.val) ≃+*
        AffineBlowup.chartRing J (α h.val)) where
  generatorImageMem : ∀ h : {h : P // h ∈ E}, α h.val ∈ J
  /-- The ordinary global blowup carries the fine (unsaturated) log blowup structure. -/
  fineLogStructure : EtaleLogStructure
    (Scheme.IdealSheafData.ofIdealTop
      (J.map (Scheme.ΓSpecIso (.of A)).inv.hom)).blowup
  fineMap : EtaleLogMap fineLogStructure X.logStructure
  fineBase : fineMap.base =
    (Scheme.IdealSheafData.ofIdealTop
      (J.map (Scheme.ΓSpecIso (.of A)).inv.hom)).blowupMap ≫ eA.inv
  /-- The affine Proj model and the recorded global glued model of the ordinary blowup. -/
  affineGlobalEquiv : AffineBlowup J ≅
    (Scheme.IdealSheafData.ofIdealTop
      (J.map (Scheme.ΓSpecIso (.of A)).inv.hom)).blowup
  affineGlobalBase : affineGlobalEquiv.hom ≫
    (Scheme.IdealSheafData.ofIdealTop
      (J.map (Scheme.ΓSpecIso (.of A)).inv.hom)).blowupMap = AffineBlowup.toSpec J
  /-- The global fine structure has exactly the tensor charts identified above:
  their scheme embeddings are induced by the displayed chart ring comparisons. -/
  fineCharts : ∀ h : {h : P // h ∈ E},
    ∃ (j : Spec (.of (logIdealTensorRing A α (logIdealChartInclusion E h.val))) ⟶
        (Scheme.IdealSheafData.ofIdealTop
          (J.map (Scheme.ΓSpecIso (.of A)).inv.hom)).blowup)
      (hjBase : j ≫ fineMap.base =
        Spec.map (CommRingCat.ofHom
          (logIdealTensorBase A α (logIdealChartInclusion E h.val))) ≫ eA.inv)
      (hjEtale : Etale j)
      (β : logIdealChartMonoid E h.val →* fineLogStructure.monoidSheaf.obj.obj
        (op (@Scheme.Etale.mk _ _ j hjEtale))),
      j = Spec.map (CommRingCat.ofHom ((chartEquiv h).symm.toRingHom.comp
          (AffineBlowup.homogeneousAwayEquivChart J (generatorImageMem h)).toRingHom)) ≫
        AffineBlowup.chart J (reesX J (α h.val) (generatorImageMem h))
          (reesX_mem J (α h.val) (generatorImageMem h)) ≫ affineGlobalEquiv.hom ∧
      fineLogStructure.IsChart (@Scheme.Etale.mk _ _ j hjEtale) β ∧
      (∀ q, fineLogStructure.alpha.app (op (@Scheme.Etale.mk _ _ j hjEtale)) (β q) =
        (Scheme.ΓSpecIso (.of
          (logIdealTensorRing A α (logIdealChartInclusion E h.val)))).inv
          (logIdealTensorMonomial A α (logIdealChartInclusion E h.val) q)) ∧
      (fineMap.sectionMap (Scheme.Etale.mk (𝟙 X.scheme))
        (@Scheme.Etale.mk _ _ j hjEtale)
        (Spec.map (CommRingCat.ofHom
          (logIdealTensorBase A α (logIdealChartInclusion E h.val))) ≫ eA.inv)
        (by
          change (Spec.map (CommRingCat.ofHom
            (logIdealTensorBase A α (logIdealChartInclusion E h.val))) ≫ eA.inv) ≫
              𝟙 X.scheme = j ≫ fineMap.base
          exact (Category.comp_id _).trans hjBase.symm)).comp c =
          β.comp (logIdealChartInclusion E h.val)
  fineUniversal : fineMap.IsFinePrincipalization (monomialChartLogIdeal X c E)

set_option genInjectivity false in
set_option genSizeOfSpec false in
/-- The full monomial Rees and fine-chart comparison, with canonical formulas rather
than an unspecified isomorphism. `L` and `J` name the two generated ideals.
Source: ILO VIII 3.4.3 and proof of 3.4.6(i), printed pp. 110--111
(blueprint: lem-trf-monomial-rees-chart-comparison). -/
structure MonomialReesChartComparison
    (X : FineSaturatedLogScheme.{u}) (A P : Type u) [CommRing A] [CommMonoid P]
    (eA : X.scheme ≅ Spec (.of A)) (α : P →* A)
    (c : P →* X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))))
    [Algebra (MonoidAlgebra ℤ P) A] (E : Finset P)
    (L : Ideal (MonoidAlgebra ℤ P)) (J : Ideal A) where
  /-- The monomial description of every power, including degree zero. -/
  powerIdeal : ∀ n : ℕ, L ^ n = Ideal.span
    {z | ∃ p ∈ (Set.univ * (E : Set P) ^ n : Set P), z = MonoidAlgebra.single p 1}
  /-- Degreewise scalar extension is the canonical multiplication isomorphism. -/
  degreeEquiv : ∀ n : ℕ, (A ⊗[MonoidAlgebra ℤ P] ↥(L ^ n)) ≃ₗ[A] ↥(J ^ n)
  degreeFormula : ∀ (n : ℕ) (a : A) (x : ↥(L ^ n)),
    (degreeEquiv n (a ⊗ₜ[MonoidAlgebra ℤ P] x) : A) =
      a * algebraMap (MonoidAlgebra ℤ P) A x.val
  /-- The assembled graded A-algebra isomorphism. -/
  reesEquiv : (A ⊗[MonoidAlgebra ℤ P] reesAlgebra L) ≃ₐ[A] reesAlgebra J
  reesFormula : ∀ (a : A) (F : reesAlgebra L),
    (reesEquiv (a ⊗ₜ[MonoidAlgebra ℤ P] F) : Polynomial A) =
      Polynomial.C a * Polynomial.map (algebraMap (MonoidAlgebra ℤ P) A) F.val
  graded : ∀ n : ℕ,
    Submodule.map reesEquiv.toLinearMap ((reesGrading L n).baseChange A) = reesGrading J n
  /-- Membership witnesses used only to form the standard homogeneous elements. -/
  generatorMem : ∀ h : {h : P // h ∈ E}, MonoidAlgebra.single h.val 1 ∈ L
  /-- The tensor monoid chart is the actual ordinary chart algebra. -/
  chartEquiv : ∀ h : {h : P // h ∈ E},
    logIdealTensorRing A α (logIdealChartInclusion E h.val) ≃+*
      AffineBlowup.chartRing J (α h.val)
  chartBase : ∀ (h : {h : P // h ∈ E}) (a : A),
    chartEquiv h (logIdealTensorBase A α (logIdealChartInclusion E h.val) a) =
      algebraMap A (AffineBlowup.chartRing J (α h.val)) a
  chartFormula : ∀ (h : {h : P // h ∈ E}) (n : ℕ) (p : P)
    (_hp : p ∈ (Set.univ * (E : Set P) ^ n : Set P))
    (q : logIdealChartMonoid E h.val)
    (_hq : q.val = Algebra.GrothendieckGroup.of p /
      Algebra.GrothendieckGroup.of h.val ^ n) (a : A),
    (chartEquiv h
      (logIdealTensorBase A α (logIdealChartInclusion E h.val) a *
        logIdealTensorMonomial A α (logIdealChartInclusion E h.val) q) :
        Localization.Away (α h.val)) = AffineBlowup.chartFraction (α h.val) n (a * α p)
  /-- The degree-zero homogeneous localization of the scalar-extended Rees algebra. -/
  localizationEquiv : ∀ h : {h : P // h ∈ E},
    HomogeneousLocalization.Away (fun n ↦ (reesGrading L n).baseChange A)
      (1 ⊗ₜ[MonoidAlgebra ℤ P] reesX L (MonoidAlgebra.single h.val 1) (generatorMem h)) ≃+*
        logIdealTensorRing A α (logIdealChartInclusion E h.val)
  localizationFormula : ∀ (h : {h : P // h ∈ E}) (n : ℕ) (a : A)
    (F : reesAlgebra L) (hF : F ∈ reesGrading L (n • (1 : ℕ))),
    (chartEquiv h (localizationEquiv h
      (HomogeneousLocalization.Away.mk (fun i ↦ (reesGrading L i).baseChange A)
        (Submodule.tmul_mem_baseChange_of_mem 1
          (reesX_mem L (MonoidAlgebra.single h.val 1) (generatorMem h))) n
        (a ⊗ₜ[MonoidAlgebra ℤ P] F) (Submodule.tmul_mem_baseChange_of_mem a hF))) :
        Localization.Away (α h.val)) =
      AffineBlowup.chartFraction (α h.val) n
        (a * algebraMap (MonoidAlgebra ℤ P) A (F.val.coeff n))
  /-- Each chart comparison extends to every further principal localization. -/
  localizeEquiv : ∀ (h : {h : P // h ∈ E})
    (d : logIdealTensorRing A α (logIdealChartInclusion E h.val)),
    Localization.Away d ≃+* Localization.Away (chartEquiv h d)
  localizeSquare : ∀ (h : {h : P // h ∈ E})
    (d : logIdealTensorRing A α (logIdealChartInclusion E h.val)),
    (localizeEquiv h d).toRingHom.comp (algebraMap _ _) =
      (algebraMap _ _).comp (chartEquiv h).toRingHom
  /-- The h,k overlaps have the canonical common-exponent identification, and the
  localized ordinary-chart comparisons commute with it. The ordinary overlap map `σ` is
  the canonical one: two fractions correspond when they agree in `A[1/(α(h)α(k))]`. -/
  overlap : ∀ h k : {h : P // h ∈ E},
    ∃ τ : Localization.Away (monomialChartRatio α E h k) ≃+*
        Localization.Away (monomialChartRatio α E k h),
      (∀ (a : A) (q : logIdealChartMonoid E h.val)
        (q' : logIdealChartMonoid E k.val) (r s : ℕ),
        q.val / (Algebra.GrothendieckGroup.of k.val /
          Algebra.GrothendieckGroup.of h.val) ^ r =
          q'.val / (Algebra.GrothendieckGroup.of h.val /
            Algebra.GrothendieckGroup.of k.val) ^ s →
        τ (Localization.mk
          (logIdealTensorBase A α (logIdealChartInclusion E h.val) a *
            logIdealTensorMonomial A α (logIdealChartInclusion E h.val) q)
          (⟨monomialChartRatio α E h k ^ r, r, rfl⟩ :
            Submonoid.powers (monomialChartRatio α E h k))) =
        Localization.mk
          (logIdealTensorBase A α (logIdealChartInclusion E k.val) a *
            logIdealTensorMonomial A α (logIdealChartInclusion E k.val) q')
          (⟨monomialChartRatio α E k h ^ s, s, rfl⟩ :
            Submonoid.powers (monomialChartRatio α E k h))) ∧
      ∃ σ : Localization.Away (chartEquiv h (monomialChartRatio α E h k)) ≃+*
          Localization.Away (chartEquiv k (monomialChartRatio α E k h)),
        σ.toRingHom.comp (localizeEquiv h (monomialChartRatio α E h k)).toRingHom =
          (localizeEquiv k (monomialChartRatio α E k h)).toRingHom.comp τ.toRingHom ∧
        ∀ (x : AffineBlowup.chartRing J (α h.val)) (y : AffineBlowup.chartRing J (α k.val))
          (r s : ℕ),
          IsLocalization.Away.awayToAwayRight (S := Localization.Away (α h.val))
              (P := Localization.Away (α h.val * α k.val)) (α h.val) (α k.val)
              (x : Localization.Away (α h.val)) *
              algebraMap A (Localization.Away (α h.val * α k.val)) (α h.val ^ (r + s)) =
            IsLocalization.Away.awayToAwayLeft (S := Localization.Away (α k.val))
              (P := Localization.Away (α h.val * α k.val)) (α k.val) (α h.val)
              (y : Localization.Away (α k.val)) *
              algebraMap A (Localization.Away (α h.val * α k.val)) (α k.val ^ (r + s)) →
          σ (Localization.mk x
            (⟨chartEquiv h (monomialChartRatio α E h k) ^ r, r, rfl⟩ :
              Submonoid.powers (chartEquiv h (monomialChartRatio α E h k)))) =
          Localization.mk y
            (⟨chartEquiv k (monomialChartRatio α E k h) ^ s, s, rfl⟩ :
              Submonoid.powers (chartEquiv k (monomialChartRatio α E k h)))
  /-- The fine universal property and the same canonical charts on the global blowup. -/
  fineBlowup : MonomialFineBlowupComparison X A P eA α c E J chartEquiv

/-- Monomial Rees comparison for an affine log regular fs chart.

Source: ILO VIII, proof of 3.4.6(i), p. 111, using the proof of 3.4.3, p. 110
(blueprint: lem-trf-monomial-rees-chart-comparison).

Proof:
1. Products of monomials identify L^n with Z[nH], with 0H=P. The monomial
Tor theorem `lem-trf-log-regular-monomial-tor` makes multiplication into A
injective; its image is J^n, giving the degreewise isomorphisms.
2. Tensor bilinearity assembles these maps on finite sums into an A-algebra
isomorphism. The formula on homogeneous tensors proves grading compatibility.
3. The monoid Q_h is the union of nH-nh. Sending z^p t^n/(z^h t)^n to
z^(p-nh) identifies the monomial homogeneous localization with Z[Q_h].
Integrality of P makes multiplication by z^h t injective, even with torsion
in its group completion; equality is coefficientwise after a common denominator.
4. `lem-nagata-homogeneous-localization-scalar-extension` tensors this
identification to A. The recorded homogeneous-away-to-chart map and its
injectivity and surjectivity identify the resulting localization with A[J/alpha(h)],
with the displayed fraction formula. No flatness over Z[P] is used.
5. On the h,k overlap invert z^(k-h), which maps to alpha(k)/alpha(h).
The universal property of localization extends the comparison uniquely, on a
fraction u/d^r by phi(u)/phi(d)^r. These comparisons respect the common
localizations and the Proj chart cocycle, including triple overlaps.
6. `lem-trf-coherent-log-ideal-chart-construction` supplies the fine log
charts and their descent. The ordinary affine blowup chart cover, together with
scheme morphism gluing, glues the local comparisons and their inverses over Spec A.
The fine principalization universal property transports to the global blowup.
-/
theorem monomial_rees_chart_comparison
    (X : FineSaturatedLogScheme.{u}) (A P : Type u) [CommRing A] [CommMonoid P]
    (eA : X.scheme ≅ Spec (.of A)) (hlog : X.IsLogRegular)
    (hP : IsFineSaturatedMonoid P) (α : P →* A)
    (c : P →* X.logStructure.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X.scheme))))
    (hc : X.logStructure.IsChart (Scheme.Etale.mk (𝟙 X.scheme)) c)
    (hα : ∀ p : P, X.logStructure.alpha.app (op (Scheme.Etale.mk (𝟙 X.scheme))) (c p) =
      eA.hom.appTop ((Scheme.ΓSpecIso (.of A)).inv (α p)))
    [Algebra (MonoidAlgebra ℤ P) A]
    (hAlg : algebraMap (MonoidAlgebra ℤ P) A = (MonoidAlgebra.lift ℤ A P α).toRingHom)
    (E : Finset P) (hE : E.Nonempty) (L : Ideal (MonoidAlgebra ℤ P)) (J : Ideal A)
    (hL : L = Ideal.span {z | ∃ e ∈ E, z = MonoidAlgebra.single e 1})
    (hJ : J = Ideal.span (α '' (E : Set P))) :
    Nonempty (MonomialReesChartComparison X A P eA α c E L J) := by
  sorry

end AlgebraicGeometry
