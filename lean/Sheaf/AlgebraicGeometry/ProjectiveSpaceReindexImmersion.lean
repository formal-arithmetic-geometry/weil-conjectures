module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace
public import Mathlib.AlgebraicGeometry.Morphisms.Immersion
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
import Mathlib.Data.Fintype.EquivFin

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

private noncomputable def renameGraded {σ τ : Type u} (E : σ ≃ τ) :
    MvPolynomial.homogeneousSubmodule σ (ULift.{u} ℤ) →+*ᵍ
      MvPolynomial.homogeneousSubmodule τ (ULift.{u} ℤ) where
  __ := (MvPolynomial.renameEquiv (ULift.{u} ℤ) E).toRingHom
  map_mem := fun h ↦ MvPolynomial.IsHomogeneous.rename_isHomogeneous h

private theorem rename_irrelevant {σ τ : Type u} (E : σ ≃ τ) :
    HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule τ (ULift.{u} ℤ)) ≤
      (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule σ (ULift.{u} ℤ))).map (renameGraded E) := by
  change (HomogeneousIdeal.irrelevant _).toIdeal ≤
    ((HomogeneousIdeal.irrelevant _).map (renameGraded E)).toIdeal
  rw [HomogeneousIdeal.toIdeal_map,
    MvPolynomial.toIdeal_irrelevant_homogeneousSubmodule,
    MvPolynomial.toIdeal_irrelevant_homogeneousSubmodule, Ideal.map_span]
  apply Ideal.span_mono
  rintro _ ⟨i, rfl⟩
  exact ⟨MvPolynomial.X (E.symm i), ⟨E.symm i, rfl⟩, by simp [renameGraded]⟩

private theorem renameGraded_comp {σ τ : Type u} (E : σ ≃ τ) :
    (renameGraded E.symm).comp (renameGraded E) =
      GradedRingHom.id (MvPolynomial.homogeneousSubmodule σ (ULift.{u} ℤ)) := by
  apply GradedRingHom.ext
  intro p
  exact (MvPolynomial.renameEquiv (ULift.{u} ℤ) E).symm_apply_apply p

private noncomputable def renameProjIso {σ τ : Type u} (E : σ ≃ τ) :
    Proj.projectiveSpaceOverAffine σ (ULift.{u} ℤ) ≅
      Proj.projectiveSpaceOverAffine τ (ULift.{u} ℤ) where
  hom := Proj.map (renameGraded E.symm) (rename_irrelevant E.symm)
  inv := Proj.map (renameGraded E) (rename_irrelevant E)
  hom_inv_id := by
    rw [← Proj.map_comp]
    simp only [renameGraded_comp, Proj.map_id]
    rfl
  inv_hom_id := by
    rw [← Proj.map_comp]
    have hc := renameGraded_comp E.symm
    simp only [Equiv.symm_symm] at hc
    simp only [hc, Proj.map_id]
    rfl

private noncomputable def renameProjectiveSpace {σ τ : Type u} (E : σ ≃ τ)
    (S : Scheme.{u}) : ProjectiveSpace σ S ⟶ ProjectiveSpace τ S :=
  pullback.map _ _ _ _ (𝟙 S) (renameProjIso E).hom (𝟙 _)
    (by simp) (terminal.hom_ext _ _)

private instance renameProjectiveSpace_isIso {σ τ : Type u} (E : σ ≃ τ)
    (S : Scheme.{u}) : IsIso (renameProjectiveSpace E S) := by
  unfold renameProjectiveSpace
  infer_instance

/-- Reindexing a finite nonempty family of homogeneous coordinates by a finite ordinal
preserves an immersion and its structure morphism identity.
(blueprint: new-projective-reindex-immersion)

Source: the projective-space construction and Mathlib's `MvPolynomial.renameEquiv`,
`MvPolynomial.IsHomogeneous.rename_isHomogeneous`, `Proj.map_comp` and `Proj.map_id`.

Proof: enumerate the finite nonempty coordinate type by `Fin (n + 1)` and lift its universe.
Variable renaming and its inverse preserve homogeneous degree and the irrelevant ideal,
which is generated by the variables. Applying the contravariant `Proj.map` gives mutually
inverse maps of the integral models, by `Proj.map_comp` and `Proj.map_id`. Base change by
`S` gives an isomorphism of relative projective spaces whose first pullback projection
is preserved. Compose the immersion with this isomorphism; it remains an immersion and
its structure morphism is unchanged. -/
theorem exists_reindexed_projective_immersion
    {Y S : Scheme.{u}} (ι : Type u) [Finite ι] [Nonempty ι]
    (e : Y ⟶ ProjectiveSpace ι S) [IsImmersion e]
    (g : Y ⟶ S) (h : e ≫ (ProjectiveSpace ι S ↘ S) = g) :
    ∃ (n : ℕ) (e' : Y ⟶ ProjectiveSpace (ULift.{u} (Fin (n + 1))) S),
      IsImmersion e' ∧ e' ≫ (ProjectiveSpace (ULift.{u} (Fin (n + 1))) S ↘ S) = g := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (Fintype.card_ne_zero (α := ι))
  let E : ι ≃ ULift.{u} (Fin (n + 1)) :=
    (Fintype.equivFinOfCardEq hn).trans Equiv.ulift.symm
  refine ⟨n, e ≫ renameProjectiveSpace E S, inferInstance, ?_⟩
  rw [Category.assoc]
  change e ≫ (renameProjectiveSpace E S ≫ pullback.fst _ _) = g
  rw [renameProjectiveSpace, pullback.lift_fst, Category.comp_id]
  exact h

end AlgebraicGeometry
