module

public import Sheaf.AlgebraicGeometry.WeightedMonomialBasisWeight
import WeilConjectures.AlgebraicGeometry.Cohomology.Serre
import Sheaf.AlgebraicGeometry.ProjectiveSpace.MRegularConsequences
import Mathlib.RingTheory.MvPolynomial.Groebner

/-! # Uniform bounded Hilbert weights

Source: Morrison, arXiv:0810.2340, Section 2.2, Proposition 1 and Lemma 2(1),
printed pp.6--8, with the bounded-integral-weight expansion recorded in the DAG.
(blueprint: lem-sfb-bounded-hilbert-weight-polynomials)

The minimum is defined from actual monomial bases. Its attainment, the canonical
restriction maps, and the uniform estimates are assertions of the theorem below.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry.BoundedHilbertWeight

/-- The Hilbert point of this embedded scheme is geometrically semistable for the
recorded determinant linearization. The pulled-back universal ideal is exactly i.ker;
thus the point represents this closed subscheme, including its nilpotent structure.
Source: Morrison §2.1--2.2 (blueprint: lem-sfb-bounded-hilbert-weight-polynomials). -/
def IsHilbertSemistable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}}
    (i : X ⟶ ℙ(HilbertPlucker.Coordinates.{u} n; Spec (.of k)))
    (P : Polynomial ℚ) (m : ℕ) : Prop :=
  ∃ (Q : NumericalHilbertPolynomial) (_ : Q.1 = P)
    (D : HilbertPlucker.Hilbert k n Q) (E : HilbertPlucker.Presentation D m)
    (x : PGLLinearization.fieldTest k k ⟶ D.H),
    D.ideal.comap (ProjectiveSpace.map (HilbertPlucker.Coordinates n) x.left) = i.ker ∧
      E.sl_line.IsSemistable k x

/-- A single pair of positive bounds works over every algebraically closed field and
all closed subschemes of the given linear coordinate polynomial. The parameter n
writes r = n + 2, so includes exactly r ≥ 2. The coefficient function is constant
on presentations of the same weighted flag.

Source: Morrison, arXiv:0810.2340, §2.2 Proposition 1 and Lemma 2(1), printed pp.6--8.
(blueprint: lem-sfb-bounded-hilbert-weight-polynomials)

Proof (the eight DAG steps):
1. The positive linear polynomial excludes the empty scheme. Apply
   lem-sfb-projective-hilbert-polynomial-dimension to obtain dimension one.
   lem-sfb-uniform-projective-fibre-vanishing supplies a uniform M-regular ideal,
   surjective polynomial restriction and dimension P(m). The twist cohomology formula
   lem-pc-projective-space-twist-cohomology identifies polynomials with sections.
   Multiplication in lem-sfb-m-regular-coherent-sheaf-consequences gives
   I_m = S_(m-M) I_M. The ideal J generated by I_M therefore agrees in degrees ≥ M.
2. Order exponents by degree, weight, then lexicographically. This is an additive
   well-order. lem-sfb-bounded-homogeneous-groebner-degree gives a uniform G and an
   initial ideal generated in degrees ≤ G, independently of field and basis.
3. Apply lem-sfb-monomial-order-polynomial-division. Standard monomials span the
   quotient and are independent since their leading exponents avoid the initial ideal.
   Division never increases weight within a degree, so the same assertion holds in
   every weight-bounded filtered subspace.
4. Ordering weights shows the jth weight in any monomial basis is at least the jth
   standard weight. Thus their sum attains the minimum. Filtered subspaces are
   generated by products of the flag subspaces, so depend only on the flag.
5. Partition exponent space into cells by fixing coordinates below G and allowing the
   other coordinates to vary above G. Standardness is constant on each cell. Linear
   Hilbert growth excludes cells with three free coordinates. A one-variable cell has
   weight z+w_i(m-e); a two-variable cell has
   z(m-e+1)+(w_i+w_j)(m-e)(m-e+1)/2. Zero-variable cells disappear for m>rG.
6. There are at most C=(G+1)^r cells, with e≤rG and z≤BrG. Summing gives an eventual
   quadratic with half-integral leading coefficient a_F. Its linear and constant
   coefficients have absolute values at most CB(1+3rG) and 2CB(rG+1)^2. Choosing
   A≥10BC(rG+1)^2 gives the stated error. Uniqueness of an eventual quadratic leading
   coefficient and step 4 give flag independence.
7. Increase m₀ to the embedding bound of lem-sfb-hilbert-plucker-pgl-linearization.
   Center weights by v_i=rw_i-s, s=Σw_i. The minimum nonzero Plücker-coordinate weight
   is r w_F(m)-msP(m), because nonzero maximal minors are exactly monomial bases.
8. If that minimum were positive, normalize the inverse diagonal one-parameter orbit
   by its smallest weight. It extends nontrivially over zero into the closed Hilbert
   embedding. An invariant section of a positive determinant power nonzero at the
   semistable point would pull back to a regular function with a pole at zero. This
   contradiction proves the numerical inequality in every characteristic. -/
theorem exists_uniform_bounded_hilbert_weights (n d : ℕ) (hd : 0 < d) (c : ℤ)
    (B : ℕ) (hB : 1 ≤ B) :
    ∃ m₀ A : ℕ, 1 ≤ m₀ ∧ 1 ≤ A ∧
      ∀ (k : Type u) [Field k] [IsAlgClosed k] (X : Scheme.{u})
        (i : X ⟶ ℙ(HilbertPlucker.Coordinates.{u} n; Spec (.of k))),
        IsClosedImmersion i → ProjectiveHilbertPolynomial.IsCoordinatePolynomial k (n + 1) i
          (Polynomial.C (d : ℚ) * Polynomial.X + Polynomial.C (c : ℚ)) →
        topologicalKrullDim X = 1 ∧
        ∃ ρ : ∀ m : ℕ, ModuleCat.of k
            (MvPolynomial.homogeneousSubmodule (HilbertPlucker.Coordinates.{u} n) k m) ⟶
            sections k n i m,
          (∀ (m : ℕ)
            (p : MvPolynomial.homogeneousSubmodule (HilbertPlucker.Coordinates.{u} n) k m)
            (j : HilbertPlucker.Coordinates.{u} n),
            ((Scheme.Modules.tensorPullback i).obj
              (ProjectiveSpace.twist (HilbertPlucker.Coordinates n)
                (Spec (.of k)) (m : ℤ))).presheaf.map (homOfLE le_top).op
              ((UniformProjectiveFibreVanishing.zeroSections _).hom (ρ m p)) =
            Scheme.Modules.tensorPullbackSection i
              (ProjectiveSpace.twist (HilbertPlucker.Coordinates n) (Spec (.of k)) (m : ℤ))
              (ProjectiveSpace.standardOpen _ (Spec (.of k)) j)
              (ProjectiveSpace.chartRingEquiv _ k j (MvPolynomial.dehomogenizeX k j p.val) •
                ProjectiveSpace.twistGenerator _ (Spec (.of k)) (m : ℤ) j)) ∧
          (∀ m : ℕ, m₀ ≤ m → Function.Surjective (ρ m) ∧
            Module.Finite k (sections k n i m) ∧
            (Module.finrank k (sections k n i m) : ℚ) = (d : ℚ) * m + c) ∧
          ∃ a : Module.Basis (HilbertPlucker.Coordinates.{u} n) k (LinearForms k n) →
              (HilbertPlucker.Coordinates.{u} n → ℕ) → ℚ,
            (∀ (b : Module.Basis (HilbertPlucker.Coordinates.{u} n) k (LinearForms k n))
              (w : HilbertPlucker.Coordinates.{u} n → ℕ), (∀ j, w j ≤ B) →
              (∃ z : ℤ, a b w = (z : ℚ) / 2) ∧
              ∀ m : ℕ, m₀ ≤ m →
                (∃ S, IsMonomialBasis (ρ m) b S ∧ totalWeight w S = weight (ρ m) b w) ∧
                |(weight (ρ m) b w : ℚ) - a b w * (m : ℚ)^2| ≤ (A : ℚ) * m ∧
                (IsHilbertSemistable i
                  (Polynomial.C (d : ℚ) * Polynomial.X + Polynomial.C (c : ℚ)) m →
                  (weight (ρ m) b w : ℚ) ≤
                    ((∑ j, (w j : ℚ)) / (n + 2 : ℕ)) * m * ((d : ℚ) * m + c))) ∧
            (∀ (b b' : Module.Basis (HilbertPlucker.Coordinates.{u} n) k (LinearForms k n))
              (w w' : HilbertPlucker.Coordinates.{u} n → ℕ),
              (∀ j, w j ≤ B) → (∀ j, w' j ≤ B) →
              (∀ s : ℕ, flag b w s = flag b' w' s) → a b w = a b' w') := by
  sorry

end AlgebraicGeometry.BoundedHilbertWeight
