import Mathlib.AlgebraicGeometry.Sites.Etale
import Mathlib.CategoryTheory.Limits.FormalCoproducts.Basic
import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Terminal
import Sheaf.CategoryTheory.MatchingObjectCoskeleton

/-!
# Semi-representable étale objects and hypercovers

Source: Stacks Project, Tags 01G0, 01G3, 01G5, 0183, 0186
(blueprint: def-weil-pbc-semi-representable-object).

The category is Mathlib's `FormalCoproduct X.Etale`, without a second category definition.
Matching objects are the canonical limits of the recorded boundary diagrams;
the coskeleton comparison is the recorded `matching_object_coskeleton` theorem.
-/

universe w u

open CategoryTheory CategoryTheory.Limits
open scoped Simplicial

namespace AlgebraicGeometry.Scheme

/-- Finite limits of formal families of étale objects, obtained from terminal objects and
pullbacks. Source: Stacks, Tag 01G0 (blueprint: def-weil-pbc-semi-representable-object). -/
noncomputable instance semiRepresentableHasFiniteLimits (X : Scheme.{u}) :
    HasFiniteLimits (FormalCoproduct.{w} X.Etale) :=
  hasFiniteLimits_of_hasTerminal_and_pullbacks

/-- `T`-points are maps from the one-member family; `FormalCoproduct.inclHomEquiv` identifies
these with pairs `(j, t : T ⟶ L.obj j)`. Source: Stacks, Tag 01G0
(blueprint: def-weil-pbc-semi-representable-object). -/
abbrev semiRepresentablePoints {X : Scheme.{u}} (T : X.Etale)
    (L : FormalCoproduct.{w} X.Etale) :=
  (FormalCoproduct.incl X.Etale).obj T ⟶ L

/-- A morphism acts on `T`-points by composition. Source: Stacks, Tag 01G0
(blueprint: def-weil-pbc-semi-representable-object). -/
def semiRepresentablePointsMap {X : Scheme.{u}} (T : X.Etale)
    {L L' : FormalCoproduct.{w} X.Etale} (f : L ⟶ L') :
    semiRepresentablePoints T L → semiRepresentablePoints T L' :=
  fun t => t ≫ f

/-- A covering has a covering family over each target index. The sieve generated by that
family belongs to the small étale topology (equivalently, the family is jointly surjective).
Source: Stacks, Tag 01G3 (blueprint: def-weil-pbc-semi-representable-object). -/
def IsSemiRepresentableCovering {X : Scheme.{u}}
    {U V : FormalCoproduct.{w} X.Etale} (f : U ⟶ V) : Prop :=
  ∀ j : V.I,
    Sieve.ofArrows (fun i : {i : U.I // f.f i = j} => U.obj i.val)
      (fun i => f.φ i.val ≫ eqToHom (congrArg V.obj i.property)) ∈
        X.smallEtaleTopology (V.obj j)

/-- The boundary diagram in degree `n + 2` is finite, so it has a limit in the finitely
complete category of formal étale families. Source: Stacks, Tag 0186
(blueprint: def-weil-pbc-semi-representable-object). -/
instance semiRepresentableHasMultiequalizer {X : Scheme.{u}}
    (K : SimplicialObject (FormalCoproduct.{w} X.Etale)) (n : ℕ) :
    HasMultiequalizer (SimplicialObject.matchingBoundaryIndex K n) := by
  have : Fintype (SimplicialObject.matchingBoundaryShape n).L :=
    inferInstanceAs (Fintype (Fin (n + 3)))
  have : Fintype (SimplicialObject.matchingBoundaryShape n).R :=
    inferInstanceAs (Fintype {p : Fin (n + 3) × Fin (n + 3) // p.1 < p.2})
  have : DecidableEq (SimplicialObject.matchingBoundaryShape n).L :=
    inferInstanceAs (DecidableEq (Fin (n + 3)))
  have : DecidableEq (SimplicialObject.matchingBoundaryShape n).R :=
    inferInstanceAs (DecidableEq {p : Fin (n + 3) × Fin (n + 3) // p.1 < p.2})
  infer_instance

/-- The matching object in each degree. Degree zero is the family `{id_X}`, degree one is
the product of two copies of `K₀`, and degree `n + 2` is the limit (multiequalizer) of the
recorded boundary diagram `matchingBoundaryIndex K n`. The recorded coskeleton comparison
identifies the positive-degree objects with coskeleton terms. Source: Stacks, Tags 01G5,
0183, 0186 (blueprint: def-weil-pbc-semi-representable-object). -/
noncomputable def semiRepresentableMatchingObject {X : Scheme.{u}}
    (K : SimplicialObject (FormalCoproduct.{w} X.Etale)) :
    ℕ → FormalCoproduct.{w} X.Etale
  | 0 => (FormalCoproduct.incl X.Etale).obj (Etale.mk (𝟙 X))
  | 1 => ∏ᶜ fun _ : Fin 2 => K _⦋0⦌
  | n + 2 => multiequalizer (SimplicialObject.matchingBoundaryIndex K n)

/-- The matching morphism: the unique map to `{id_X}` in degree zero, and the map whose
projections are the face maps `d_0, …, d_n` in positive degrees (well defined in degree
`n + 2` by the simplicial identities `d_(j-1) d_i = d_i d_j`, i < j). Source: Stacks,
Tags 01G5, 0186 (blueprint: def-weil-pbc-semi-representable-object). -/
noncomputable def semiRepresentableMatchingMap {X : Scheme.{u}}
    (K : SimplicialObject (FormalCoproduct.{w} X.Etale)) :
    (n : ℕ) → K _⦋n⦌ ⟶ semiRepresentableMatchingObject K n
  | 0 => (FormalCoproduct.isTerminalIncl (Etale.mk (𝟙 X))
      ((Over.mkIdTerminal (X := X)).isTerminalOfObj (Etale.forget X) (Etale.mk (𝟙 X)))).from _
  | 1 => Pi.lift fun i : Fin 2 => K.δ i
  | n + 2 =>
      Multiequalizer.lift (SimplicialObject.matchingBoundaryIndex K n) _
        (fun i : Fin (n + 3) => K.δ i)
        (by
          rintro ⟨⟨a, b⟩, h⟩
          dsimp [SimplicialObject.matchingBoundaryIndex]
          have hb : b = (b.pred (Fin.ne_zero_of_lt h)).succ := (Fin.succ_pred _ _).symm
          have H : a.castLT (Nat.lt_of_lt_of_le h (Nat.le_of_lt_succ b.isLt)) ≤
              b.pred (Fin.ne_zero_of_lt h) := by
            rw [Fin.le_iff_val_le_val]
            have h' : a.val < b.val := h
            simp only [Fin.val_castLT, Fin.val_pred]
            omega
          have := (SimplicialObject.δ_comp_δ K H).symm
          rw [← hb] at this
          exact this)

/-- A hypercover of `X` is a simplicial object of formal étale families for which every
matching map, including degree zero, is a covering. Source: Stacks, Tag 01G5
(blueprint: def-weil-pbc-semi-representable-object). -/
def IsSemiRepresentableHypercover {X : Scheme.{u}}
    (K : SimplicialObject (FormalCoproduct.{w} X.Etale)) : Prop :=
  ∀ n : ℕ, IsSemiRepresentableCovering (semiRepresentableMatchingMap K n)

end AlgebraicGeometry.Scheme
