/-! # Coordinate-subspace blowup charts over an arbitrary ring

Source: Stacks Project, Tag 0H1H, remark-relative-blowup; Tag 0804,
lemma-blowing-up-affine (blueprint: lem-trf-coordinate-subspace-blowup-charts).

The auxiliary declarations specialize the existing polynomial, ideal-sheaf and blowup
constructions. The chart algebra is the existing subalgebra of the localization, and
its embedding is the existing canonical blowup chart map.
-/

@[expose] public section

noncomputable section

universe u

set_option autoImplicit false

open CategoryTheory

namespace AlgebraicGeometry.CoordinateSubspaceBlowup

/-- The polynomial ring in the unchanged and center coordinates. Source: Stacks, Tag 0H1H
(blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
abbrev PolynomialRing (R : Type u) [CommRing R] (a b : ℕ) :=
  MvPolynomial (Fin a ⊕ Fin b) R

/-- The center ideal generated by the `y` coordinates. Source: Stacks, Tag 0H1H
(blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
def centerIdeal (R : Type u) [CommRing R] (a b : ℕ) : Ideal (PolynomialRing R a b) :=
  Ideal.span (Set.range fun j : Fin b ↦ MvPolynomial.X (Sum.inr j))

/-- A center coordinate together with its membership in the center ideal.
Source: Stacks, Tag 0H1H (blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
def centerGenerator (R : Type u) [CommRing R] (a b : ℕ) (i : Fin b) : centerIdeal R a b :=
  ⟨MvPolynomial.X (Sum.inr i), Ideal.subset_span ⟨i, rfl⟩⟩

/-- The quasi-coherent ideal sheaf corresponding to the coordinate ideal on its spectrum.
Source: Stacks, Tag 0804 (blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
def center (R : Type u) [CommRing R] (a b : ℕ) :
    (Spec (.of (PolynomialRing R a b))).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop
    ((centerIdeal R a b).map (Scheme.ΓSpecIso (.of (PolynomialRing R a b))).inv.hom)

/-- The standard chart algebra at the coordinate `y_i`, with its existing ring structure.
Source: Stacks, Tags 0H1H and 0804
(blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
abbrev ChartRing (R : Type u) [CommRing R] (a b : ℕ) (i : Fin b) :=
  AffineBlowup.chartRing (centerIdeal R a b) (centerGenerator R a b i).val

/-- The variables `x_r`, `z` and `t_j` with `j ≠ i` in the polynomial chart presentation.
Source: Stacks, Tag 0H1H (blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
abbrev ChartVariables (a b : ℕ) (i : Fin b) :=
  Fin a ⊕ (Unit ⊕ {j : Fin b // j ≠ i})

/-- The canonical chart embedding into the affine blowup, through the existing
homogeneous-localization comparison. Source: Stacks, Tag 0804
(blueprint: lem-trf-coordinate-subspace-blowup-charts). -/
abbrev chartι (R : Type u) [CommRing R] (a b : ℕ) (i : Fin b) :
    Spec (.of (ChartRing R a b i)) ⟶ AffineBlowup (centerIdeal R a b) :=
  AffineBlowup.chartRingι (centerIdeal R a b) (centerGenerator R a b i).property

/-- Polynomial charts, the empty zero-coordinate blowup, and smoothness of every etale
source over the arbitrary base ring. Source: Stacks, Tag 0H1H,
remark-relative-blowup; Tag 0804, lemma-blowing-up-affine
(blueprint: lem-trf-coordinate-subspace-blowup-charts).

Proof:
1. For `b > 0`, apply prop-nagata-affine-blowup-chart-cover to the generators `y_i`.
   The affine restriction of the global blowup identifies the affine model with the
   glued blowup over `Spec A`; prop-nagata-affine-blowup-chart identifies its chart maps.
2. The polynomial universal property (def-weil-pbc-mv-polynomial-ring) defines the map
   by `x_r ↦ x_r`, `z ↦ y_i`, and `t_j ↦ y_j/y_i`. Its image contains all of `A`, since
   `y_j = y_i (y_j/y_i)`, and every generator `h/y_i` of def-nagata-blowup-chart-ring,
   since `h = ∑ a_j y_j`. Hence it is surjective.
3. Expand a polynomial in monomials `x^α z^m t^β`. Choose `N ≥ ∑ β_j` for all terms.
   Multiplication of its image by `y_i^N` gives a polynomial with monomials
   `x^α y_i^(N+m-∑β_j) ∏ y_j^β_j`. If its image vanishes, localization-away equality
   (def-weil-ring-localization-away) makes some further power of `y_i` annihilate this
   polynomial. Distinct triples `(α,m,β)` give distinct monomials, so coefficient
   uniqueness forces all coefficients to vanish. No cancellation in `R` is used.
4. Contravariant affine spectra (def-weil-affine-spectrum) turn this algebra isomorphism
   into an isomorphism over `Spec R`; its `a+1+(b-1)=a+b` variables give the affine
   space of def-sbc-affine-space.
5. If `b=0`, the ideal is zero. The generator-zero chart cover from
   prop-nagata-affine-blowup-chart-cover has chart algebra inside `A[1/0]`, the zero
   ring. Its spectrum is empty, so the blowup is empty.
6. Apply sbc-lem-affine-space-smooth on the charts and
   lem-weil-pbc-smooth-restrict-open-subschemes for isomorphism invariance, then
   lem-weil-pbc-smooth-local-on-source. For `b=0` use the empty cover. An etale source
   is smooth by lem-weil-pbc-etale-smooth-zero-dimensional-fibres, and
   lem-trf-smooth-composition finishes the assertion for its composite to `Spec R`.
-/
theorem coordinate_subspace_blowup_charts (R : Type u) [CommRing R] (a b : ℕ) :
    (0 < b →
      ∃ E : AffineBlowup (centerIdeal R a b) ≅ (center R a b).blowup,
        E.hom ≫ (center R a b).blowupMap = AffineBlowup.toSpec (centerIdeal R a b) ∧
        (⨆ i : Fin b, (chartι R a b i ≫ E.hom).opensRange) = ⊤ ∧
        (∀ i : Fin b,
          ∃ φ : MvPolynomial (ChartVariables a b i) R ≃ₐ[R] ChartRing R a b i,
            (∀ r : Fin a,
              (φ (MvPolynomial.X (Sum.inl r)) :
                  Localization.Away (centerGenerator R a b i).val) =
                algebraMap (PolynomialRing R a b) _ (MvPolynomial.X (Sum.inl r))) ∧
            (φ (MvPolynomial.X (Sum.inr (Sum.inl ()))) :
                Localization.Away (centerGenerator R a b i).val) =
              algebraMap (PolynomialRing R a b) _ (centerGenerator R a b i).val ∧
            (∀ j : {j : Fin b // j ≠ i},
              (φ (MvPolynomial.X (Sum.inr (Sum.inr j))) :
                  Localization.Away (centerGenerator R a b i).val) =
                AffineBlowup.chartFraction (centerGenerator R a b i).val 1
                  (MvPolynomial.X (Sum.inr j.val))) ∧
            (∃ c : Spec (.of (ChartRing R a b i)) ≅
                AffineSpace (ULift.{u} (Fin (a + b))) (Spec (.of R)),
              c.hom ≫ (AffineSpace.over (ULift.{u} (Fin (a + b))) (Spec (.of R))).hom =
                Spec.map (CommRingCat.ofHom (algebraMap R (ChartRing R a b i)))))) ∧
    (b = 0 → centerIdeal R a b = ⊥ ∧ IsEmpty (center R a b).blowup) ∧
    (∀ (W : Scheme.{u}) (e : W ⟶ (center R a b).blowup), Etale e →
      Smooth (e ≫ (center R a b).blowupMap ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (PolynomialRing R a b))))) := by
  sorry

end AlgebraicGeometry.CoordinateSubspaceBlowup
