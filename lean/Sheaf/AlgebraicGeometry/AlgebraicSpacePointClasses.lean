module

public import Sheaf.AlgebraicGeometry.AlgebraicSpace
public import Mathlib.AlgebraicGeometry.ResidueField

/-!
# Field-valued point classes

Source: Stacks Project, Properties of Spaces, Tag 03BU and its preceding equivalence
relation (blueprint: def-a1-algebraic-space-point-classes).
-/

@[expose] public section

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.AlgebraicSpace

/-- A field-valued representative of a presheaf point, including its map to the base.
Source: Stacks, Tag 03BU (blueprint: def-a1-algebraic-space-point-classes). -/
structure PointRepresentative {S : Scheme.{u}} (F : (Over S)ᵒᵖ ⥤ Type u) where
  K : Type u
  [field : Field K]
  base : Spec (CommRingCat.of K) ⟶ S
  value : F.obj (op (Over.mk base))

attribute [instance] PointRepresentative.field

/-- Representatives agree if their restrictions to some common field extension agree.
Maps between field spectra over the base encode the two field embeddings and compatibility
with the base; their rings are fields, so these ring maps are automatically injective.
Source: Stacks, relation preceding Tag 03BU
(blueprint: def-a1-algebraic-space-point-classes). -/
def PointRepresentative.Rel {S : Scheme.{u}} {F : (Over S)ᵒᵖ ⥤ Type u}
    (p q : PointRepresentative F) : Prop :=
  ∃ (L : Type u) (_ : Field L) (s : Spec (CommRingCat.of L) ⟶ S)
    (a : Over.mk s ⟶ Over.mk p.base) (b : Over.mk s ⟶ Over.mk q.base),
    F.map a.op p.value = F.map b.op q.value

/-- The set of field-valued point classes. `Quot` forms the quotient generated by the
common-extension relation, which is already an equivalence relation (amalgamate fields).
No atlas or arbitrary representative is chosen.
Source: Stacks, Tag 03BU (blueprint: def-a1-algebraic-space-point-classes). -/
def Point {S : Scheme.{u}} (F : (Over S)ᵒᵖ ⥤ Type u) : Type (u + 1) :=
  Quot (PointRepresentative.Rel (F := F))

/-- The map on points from a scheme sends `x` to the class of its residue-field morphism.
Source: Stacks, Tag 03BU and lemma-scheme-points immediately following it
(blueprint: def-a1-algebraic-space-point-classes). -/
noncomputable def schemePointMap {S : Scheme.{u}} {F : (Over S)ᵒᵖ ⥤ Type u}
    {T : Over S} (t : yoneda.obj T ⟶ F) (x : T.left) : Point F :=
  Quot.mk _ ⟨T.left.residueField x, T.left.fromSpecResidueField x ≫ T.hom,
    t.app _ (Over.homMk (T.left.fromSpecResidueField x) rfl)⟩

end AlgebraicGeometry.AlgebraicSpace
