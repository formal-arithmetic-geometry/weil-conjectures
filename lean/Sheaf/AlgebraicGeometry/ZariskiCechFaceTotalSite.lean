module

public import Sheaf.CategoryTheory.SemisimplicialRingedTotalCategory
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.AlgebraicGeometry.OpenImmersion
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import WeilConjectures.CategoryTheory.DerivedCategory.RightDerivedFunctor.Adjunction

/-! # The small Zariski face total site of an open family

Source: Stacks Project, spaces-simplicial.tex, Tags 09WC, 09WF, 0D70 and 0D7F,
with only injective order maps (blueprint: def-sfb-zariski-cech-face-total-site).

## Main definitions

* `ZariskiCechFaceTotal.Object`: tuple-indexed opens in finite intersections.
* `ZariskiCechFaceTotal.topology`: topology generated by vertical open covers.
* `ZariskiCechFaceTotal.restriction`: actual restriction of module sheaves.
* `ZariskiCechFaceTotal.Augmentation`: proof-only preparation of the canonical augmentation.

The tuple-labelled basis in each disjoint union is used instead of constructing
that disjoint union as a scheme. Different tuples remain different objects even
when their intersections happen to be the same open. No degeneracies are included.
-/

@[expose] public noncomputable section
set_option autoImplicit false

universe u
open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.SemisimplicialRingedTotal

namespace AlgebraicGeometry.ZariskiCechFaceTotal

variable {X : Scheme.{u}} {I : Type u} (W : I → X.Opens)

/-- Tuple-labelled open basis of the disjoint-union levels. Source: Stacks 09WC, 0D7F
(blueprint: def-sfb-zariski-cech-face-total-site). -/
structure Object where
  degree : SemiSimplexCategory
  tuple : Fin (degree.len + 1) → I
  openSet : X.Opens
  contained : ∀ k : Fin (degree.len + 1), openSet ≤ W (tuple k)

/-- A face arrow drops indices by an injective order map and includes the underlying open.
Source: Stacks 09WC, 09WF (blueprint: def-sfb-zariski-cech-face-total-site). -/
@[ext]
structure Hom (A B : Object W) where
  drop : ULift.{u} (B.degree ⟶ A.degree)
  tuple_eq : ∀ k : Fin (B.degree.len + 1),
    A.tuple (SemiSimplexCategory.homEquiv drop.down k) = B.tuple k
  inclusion : A.openSet ≤ B.openSet

/-- Composition uses composition of the injective order maps and inclusions.
Source: Stacks 09WC (blueprint: def-sfb-zariski-cech-face-total-site). -/
instance category : SmallCategory (Object W) where
  Hom := Hom W
  id A := ⟨⟨𝟙 A.degree⟩, fun _ ↦ rfl, le_rfl⟩
  comp f g := ⟨⟨g.drop.down ≫ f.drop.down⟩, fun k ↦ by
    rw [SemiSimplexCategory.homEquiv_comp]
    exact (f.tuple_eq (SemiSimplexCategory.homEquiv g.drop.down k)).trans (g.tuple_eq k),
    f.inclusion.trans g.inclusion⟩
  id_comp f := by apply Hom.ext; apply ULift.ext; simp
  comp_id f := by apply Hom.ext; apply ULift.ext; simp
  assoc f g h := by apply Hom.ext; apply ULift.ext; simp [Category.assoc]

/-- Forget the tuple and degree, retaining the underlying open in the base scheme.
Source: Stacks 0D70 (blueprint: def-sfb-zariski-cech-face-total-site). -/
def toOpens : Object W ⥤ X.Opens where
  obj A := A.openSet
  map f := homOfLE f.inclusion

/-- Covering presieves consist of arrows in one tuple-labelled fibre, whose opens cover.
The equality of degrees and the identity face condition prohibit horizontal covering arrows.
Source: Stacks 09WC (blueprint: def-sfb-zariski-cech-face-total-site). -/
def verticalCoverage : Precoverage (Object W) where
  coverings A := {S |
    (∀ (B : Object W) (f : B ⟶ A), S f →
      ∃ e : B.degree = A.degree, f.drop.down = eqToHom e.symm) ∧
    ∀ x : X, x ∈ A.openSet → ∃ (B : Object W) (f : B ⟶ A), S f ∧ x ∈ B.openSet}

/-- The small Zariski total topology, generated by precisely the vertical open coverings.
Source: Stacks 09WC (blueprint: def-sfb-zariski-cech-face-total-site). -/
def topology : GrothendieckTopology (Object W) := (verticalCoverage W).toGrothendieck

/-- The actual ring sheaf is the restriction of the structure sheaf, with values O_X(V).
Continuity is proof data, not a choice of a ring object.
Source: Stacks 09WF, 0D70 (blueprint: def-sfb-zariski-cech-face-total-site). -/
def site (hc : (toOpens W).IsContinuous (topology W)
    (Opens.grothendieckTopology X)) : Site.{u} :=
  haveI := hc
  { C := Object W
    J := topology W
    ring := ((toOpens W).sheafPushforwardContinuous CommRingCat _ _).obj X.sheaf }

/-- Restriction along the augmentation: its value at (n,i,V) is exactly G(V),
with the same module action and restrictions. The identity ring map introduces no twist.
Source: Stacks 0D70, 0D7F (blueprint: def-sfb-zariski-cech-face-total-site). -/
def restriction (hc : (toOpens W).IsContinuous (topology W)
    (Opens.grothendieckTopology X)) :
    X.Modules ⥤ (site W hc).modules :=
  haveI := hc
  SheafOfModules.pushforward (F := toOpens W)
    (J := topology W) (K := Opens.grothendieckTopology X) (R := X.ringCatSheaf) (𝟙 _)

/-- Proof-only preparation of the explicit restriction augmentation. Its right adjoint
is determined by the adjunction universal property; it is not an arbitrary map or functor.
These facts hold for every open family, including a family not covering X. The descent
statement supplies their existence, so no unproved preparation is assumed as a hypothesis.
Source: Stacks 0D70, 079Q, 0D7F (blueprint: def-sfb-zariski-cech-face-total-site). -/
class Augmentation : Prop where
  continuous : (toOpens W).IsContinuous (topology W)
    (Opens.grothendieckTopology X)
  leftAdjoint : (restriction W continuous).IsLeftAdjoint
  additive : (restriction W continuous).Additive
  limits : PreservesFiniteLimits (restriction W continuous)
  colimits : PreservesFiniteColimits (restriction W continuous)
  injectives : Abelian.HasKInjectiveResolutions (site W continuous).modules

attribute [instance] Augmentation.continuous Augmentation.leftAdjoint Augmentation.additive
  Augmentation.limits Augmentation.colimits Augmentation.injectives

/-- The canonical augmentation pushforward, chosen from its defining universal property.
Source: Stacks 0D70 (blueprint: def-sfb-zariski-cech-face-total-site). -/
def Augmentation.pushforward [A : Augmentation W] := (restriction W A.continuous).rightAdjoint

/-- The ordinary adjunction of the specified restriction, fixing its unit and counit.
Source: Stacks 0D70 (blueprint: def-sfb-zariski-cech-face-total-site). -/
def Augmentation.adjunction [A : Augmentation W] :
    restriction W A.continuous ⊣ pushforward W :=
  Adjunction.ofIsLeftAdjoint _

/-- The base small Zariski ringed site, with its actual structure sheaf.
Source: Stacks 01EQ (blueprint: def-sfb-zariski-cech-face-total-site). -/
def baseSite (X : Scheme.{u}) : Site.{u} where
  C := X.Opens
  J := Opens.grothendieckTopology X
  ring := X.sheaf

/-- The standard ordinary unbounded derived category for base module sheaves.
It is scoped to this namespace, so that it does not compete in importers with the
ambient `HasDerivedCategory.ofIsGrothendieckAbelian` localization of `X.Modules`.
Source: Stacks 05RU (blueprint: def-sfb-zariski-cech-face-total-site). -/
scoped instance baseHasDerived (X : Scheme.{u}) : HasDerivedCategory.{u + 1} X.Modules :=
  (baseSite X).hasDerived

/-- Additivity of the canonical right adjoint of restriction.
Source: Stacks 0D70 (blueprint: def-sfb-zariski-cech-face-total-site). -/
instance Augmentation.pushforwardAdditive [Augmentation W] :
    (Augmentation.pushforward W).Additive :=
  (Augmentation.adjunction W).right_adjoint_additive

/-- The canonical unbounded derived adjunction. Source: Stacks 0D7F
(blueprint: def-sfb-zariski-cech-face-total-site). -/
def Augmentation.derivedAdjunction [A : Augmentation W] :
    (restriction W A.continuous).mapDerivedCategory ⊣ (pushforward W).rightDerivedFunctor :=
  adjunction W |>.mapDerivedCategoryRightDerivedAdjunction

/-- Invertibility of the actual canonical derived unit on a module in degree zero.
Source: Stacks 0D7F, 01EP, 01EQ
(blueprint: def-sfb-zariski-cech-face-total-site). -/
def Augmentation.IsUnitIso (A : Augmentation W) (G : X.Modules) : Prop :=
  letI := A
  IsIso ((Augmentation.derivedAdjunction W).unit.app
    ((DerivedCategory.singleFunctor X.Modules 0).obj G))

end AlgebraicGeometry.ZariskiCechFaceTotal
