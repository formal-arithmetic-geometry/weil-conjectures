module

public import Sheaf.AlgebraicGeometry.GabberModificationData
public import WeilConjectures.RingTheory.IsRegularSystemOfParameters
public import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-! # Data of inert eigenparameter rigidifications

Source: ILO, Travaux de Gabber, VIII 5.3.3--5.3.7, pp.123--125
(blueprint: def-per-inert-eigenparameter-rigidification-data).

These predicates retain the actual divisorial sheaf, parameter equations, induced
open decomposition and strict inert pullback squares. All data are explicit.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry
namespace GabberModification

/-- Identify an fs log structure with the actual divisorial sheaf, compatibly with
its structural inclusion into regular functions. Source: ILO VI 1.1 and VIII 5.3.3
(blueprint: def-per-inert-eigenparameter-rigidification-data). -/
def DivisorialBoundary (X : FineSaturatedLogScheme.{u}) (B : X.scheme.IdealSheafData) : Prop :=
  ∃ e : X.logStructure.monoidSheaf.obj ≅
      divisorialLogPresheaf (Scheme.Opens.ι (X := X.scheme) B.support.compl),
    e.hom ≫ divisorialStructuralMap (Scheme.Opens.ι (X := X.scheme) B.support.compl) =
      X.logStructure.alpha

/-- At each geometric point, pass to an affine inertia-equivariant étale neighbourhood
with fixed primitive roots of unity. Both boundary equations are products of distinct
members of one regular parameter system; each member is an actual eigenfunction.
The character values lie in the cyclic group generated by the specified root.
Source: ILO VIII 5.3.5--5.3.7 (blueprint: def-per-inert-eigenparameter-rigidification-data). -/
def HasLocalEigenparameters {G : Type v} [Group G] {X : FineSaturatedLogScheme.{u}}
    (a : FSLogGroupAction G X) (B D : X.scheme.IdealSheafData) : Prop :=
  ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme),
    ∃ H : Subgroup G, (∀ g : G, g ∈ H ↔ t ≫ (a.baseAction g).hom = t) ∧
      ∃ (W : Scheme.{u}) (haff : IsAffine W) (b : H →* Aut W) (p : W ⟶ X.scheme)
        (w : Spec (.of Ω) ⟶ W),
        Etale p ∧ w ≫ p = t ∧
        (∀ h : H, (b h).hom ≫ p = p ≫ (a.baseAction h.val).hom) ∧
        (∀ h : H, w ≫ (b h).hom = w) ∧
        ∃ ζ : Γ(W, ⊤)ˣ, IsPrimitiveRoot ζ (Nat.card H) ∧
          IsUnit (Nat.card H : Γ(W, ⊤)) ∧
          (∀ k : ℕ, 0 < k → k < Nat.card H → IsUnit (ζ.val ^ k - 1)) ∧
          (∀ h : H, (b h).hom.appTop ζ.val = ζ.val) ∧
          ∃ (d r s : ℕ) (f : Fin d → Γ(W, ⊤))
            (i : Fin r ↪ Fin d) (j : Fin s ↪ Fin d)
            (χ : Fin d → H →* Γ(W, ⊤)ˣ)
            (hn : IsNoetherianRing (W.presheaf.stalk (w default))),
            @IsLocalRing.IsRegularSystemOfParameters (W.presheaf.stalk (w default))
              inferInstance inferInstance hn
              (List.ofFn (fun k ↦ (W.presheaf.germ ⊤ (w default) (by trivial)).hom (f k))) ∧
            (B.comap p).ideal ⟨⊤, @isAffineOpen_top W haff⟩ =
              Ideal.span {∏ k : Fin r, f (i k)} ∧
            (D.comap p).ideal ⟨⊤, @isAffineOpen_top W haff⟩ =
              Ideal.span {∏ k : Fin s, f (j k)} ∧
            ∀ (k : Fin d) (h : H),
              χ k h ∈ Subgroup.zpowers ζ ∧
                (b h).hom.appTop (f k) = (χ k h).val * f k

/-- A finite disjoint union of schemes induced from inertia subgroups. The translates
of each affine open are indexed by left cosets: two such translates are disjoint
unless their indices differ by an element of the subgroup. The open immersions and
cover equation give the actual coproduct presentation, with its specified action.
Each subgroup is the inertia of a geometric point in its neighbourhood.
Source: ILO VIII 5.3.7 (blueprint: def-per-inert-eigenparameter-rigidification-data). -/
def HasFiniteInertiaInduction {G : Type v} [Group G] {X : FineSaturatedLogScheme.{u}}
    (a : FSLogGroupAction G X) : Prop :=
  ∃ (n : ℕ) (H : Fin n → Subgroup G) (V : Fin n → Scheme.{u})
    (b : ∀ i, H i →* Aut (V i)) (j : ∀ i, V i ⟶ X.scheme),
    (∀ i, IsAffine (V i) ∧ IsOpenImmersion (j i)) ∧
    (∀ (i : Fin n) (h : H i),
      (b i h).hom ≫ j i = j i ≫ (a.baseAction h.val).hom) ∧
    (∀ x : X.scheme, ∃ (i : Fin n) (g : G) (z : V i),
      (a.baseAction g).hom (j i z) = x) ∧
    (∀ (i k : Fin n) (g h : G),
      (i ≠ k ∨ g⁻¹ * h ∉ H i) →
        Disjoint (Set.range (j i ≫ (a.baseAction g).hom))
          (Set.range (j k ≫ (a.baseAction h).hom))) ∧
    ∀ i : Fin n, ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
      (t : Spec (.of Ω) ⟶ V i),
      ∀ g : G, g ∈ H i ↔ (t ≫ j i) ≫ (a.baseAction g).hom = t ≫ j i

/-- A rigidification with its genuine divisorial log structure and local eigenparameters
for the old and enlarged boundaries. The old ideal is transported along the scheme
isomorphism retained by `Rigidification.forget`. Source: ILO VIII 5.3.3--5.3.7
(blueprint: def-per-inert-eigenparameter-rigidification-data). -/
def Rigidification.HasEigenparameters {G : Type v} [Group G]
    {X : FineSaturatedLogScheme.{u}} {a : FSLogGroupAction G X}
    (R : Rigidification a) (B : X.scheme.IdealSheafData) : Prop :=
  DivisorialBoundary R.enlarged R.boundary ∧
    (∀ g : G, R.boundary.comap (R.action.baseAction g).hom = R.boundary) ∧
    (B.comap R.forget.base).support ≤ R.boundary.support ∧
    HasLocalEigenparameters R.action (B.comap R.forget.base) R.boundary

/-- The local conclusion on a pulled-back cover, without a global affineness demand.
The old log square and the enlarged log square commute. Both are actual scheme
pullbacks, and all arrows retain strictness, étaleness and inertia preservation.
The enlarged boundary is precisely the pullback of the specified enlarged boundary.
Source: ILO VIII 5.3.6--5.3.7 (blueprint: def-per-inert-eigenparameter-rigidification-data). -/
def Rigidification.PullsBack {G : Type v} [Group G]
    {X U : FineSaturatedLogScheme.{u}} {a : FSLogGroupAction G X}
    {b : FSLogGroupAction G U} (f : EtaleLogHom U X) (R : Rigidification b)
    (B : U.scheme.IdealSheafData) : Prop :=
  ∀ (Y : FineSaturatedLogScheme.{u}) (c : FSLogGroupAction G Y)
    (q : EtaleLogHom Y X),
    q.IsStrict → Etale q.base → Inert c a (MonoidHom.id G) q →
    ∃ (V : FineSaturatedLogScheme.{u}) (d : FSLogGroupAction G V)
      (p : EtaleLogHom V Y) (k : EtaleLogHom V U),
      IsPullback p.base k.base q.base f.base ∧ p.comp q = k.comp f ∧
      Etale p.base ∧ Surjective p.base ∧ p.IsStrict ∧
      Inert d c (MonoidHom.id G) p ∧
      Etale k.base ∧ k.IsStrict ∧ Inert d b (MonoidHom.id G) k ∧
      ∃ (E : FineSaturatedLogScheme.{u}) (dE : FSLogGroupAction G E)
        (forget : EtaleLogHom E V) (l : EtaleLogHom E R.enlarged),
        IsIso forget.base ∧ dE.IsEquivariant d forget ∧
        IsPullback forget.base l.base k.base R.forget.base ∧
        forget.comp k = l.comp R.forget ∧
        Etale l.base ∧ l.IsStrict ∧ Inert dE R.action (MonoidHom.id G) l ∧
        E.IsLogRegular ∧ dE.IsVeryTame ∧
        DivisorialBoundary E (R.boundary.comap l.base) ∧
        (∀ x : E.scheme, ∃ W : E.scheme.Opens, x ∈ W ∧ IsAffineOpen W ∧
          IsStrictNormalCrossingsBoundary ((R.boundary.comap l.base).comap W.ι)) ∧
        HasLocalEigenparameters dE (B.comap (forget.base ≫ k.base))
          (R.boundary.comap l.base)

end GabberModification
end AlgebraicGeometry
