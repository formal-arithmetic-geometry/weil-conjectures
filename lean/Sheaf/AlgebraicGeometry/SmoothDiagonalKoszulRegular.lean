import Mathlib.AlgebraicGeometry.Morphisms.Smooth
import Mathlib.AlgebraicGeometry.Morphisms.Proper
import Mathlib.AlgebraicGeometry.Noetherian
import Mathlib.AlgebraicGeometry.Pullbacks
import Sheaf.RingTheory.KoszulRegularSequence
import Sheaf.AlgebraicGeometry.PerfectComplex

/-!
# The smooth diagonal is Koszul regular, perfect and proper

Source: Stacks Project, Tag 067U, and More on Morphisms, Tag 068C
(blueprint: lem-sc-smooth-proper-diagonal-koszul-regular).
-/

set_option autoImplicit false

universe u w

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

/-- The closed diagonal of a finite type smooth morphism of pure relative dimension `d`
over a Noetherian scheme is a Koszul-regular immersion of codimension `d`, its
pushed-forward structure sheaf in degree zero is perfect, and the diagonal is proper.
The Koszul-regular clause is the affine quotient-presentation hypothesis of
`lem-sc-koszul-regular-closed-immersion-perfect` (`koszulRegular_closedImmersion_perfect`):
every point of `X ×_S X` has an affine open neighbourhood `U` whose ideal `I` of the
diagonal is spanned by a Koszul-regular sequence, with `Δ⁻¹(U) ≅ Spec(Γ(U)/I)` over `U`;
codimension `d` means the sequence has length `d` unless `U` misses the diagonal
(`I = ⊤`).
Source: Stacks Project, Tag 067U, and More on Morphisms, Tag 068C
(blueprint: lem-sc-smooth-proper-diagonal-koszul-regular).

Proof: apply `lem-sc-smooth-diagonal-regular-immersion` to obtain affine neighbourhoods
with regular generators of length `d` near the diagonal, and the unit ideal off it
(generated by the Koszul-regular singleton `1`). The closed immersion identifies
`Δ⁻¹(U)` with `Spec(Γ(U)/I)` for its ideal `I` on the affine open `U`.
By `lem-weil-pbc-regular-sequence-koszul-regular`, the regular generators are Koszul regular.
The fibre product is Noetherian because it is of finite type over the Noetherian base.
Apply `lem-sc-koszul-regular-closed-immersion-perfect`: the local Koszul complexes are
bounded finite free resolutions of the quotient structure module, so its degree-zero
complex is perfect. Finally a closed immersion is separated, of finite type and
universally closed, hence proper. -/
theorem smooth_diagonal_koszul_regular_perfect_proper {X S : Scheme.{u}}
    (d : ℕ) (f : X ⟶ S) [IsNoetherian S] [SmoothOfRelativeDimension d f]
    [LocallyOfFiniteType f] [QuasiCompact f] [IsClosedImmersion (pullback.diagonal f)]
    [HasDerivedCategory.{w}
      (SheafOfModules.{u} (moduleRings (pullback f f).toRingedSpace))]
    [∀ U : (pullback f f).Opens, HasDerivedCategory.{w}
      (SheafOfModules.{u} ((moduleRings (pullback f f).toRingedSpace).over U))] :
    (∀ y : (pullback f f : Scheme.{u}), ∃ U : (pullback f f).Opens, y ∈ U ∧ IsAffineOpen U ∧
      ∃ (I : Ideal (Γ(pullback f f, U))) (r : ℕ) (g : Fin r → Γ(pullback f f, U)),
        I = Ideal.span (Set.range g) ∧ RingTheory.Sequence.IsKoszulRegular g ∧
        (∃ e : Scheme.Opens.toScheme ((pullback.diagonal f) ⁻¹ᵁ U) ≅
            Spec (CommRingCat.of (Γ(pullback f f, U) ⧸ I)),
          (pullback.diagonal f) ∣_ U ≫ U.toSpecΓ =
            e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧
        (I = ⊤ ∨ r = d)) ∧
    Scheme.IsPerfect (pullback f f)
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u} (moduleRings (pullback f f).toRingedSpace)) 0).obj
          ((Scheme.Modules.pushforward (pullback.diagonal f)).obj
            (SheafOfModules.unit X.ringCatSheaf))) ∧
    IsProper (pullback.diagonal f) := by
  sorry

end AlgebraicGeometry
