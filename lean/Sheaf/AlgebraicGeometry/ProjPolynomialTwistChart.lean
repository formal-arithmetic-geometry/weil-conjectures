import WeilConjectures.AlgebraicGeometry.ProjectiveSpectrum.Twist
import WeilConjectures.Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Standard charts and twisting module on a polynomial Proj

Source: Constructions, Lemmas 01NG, 01M4, 01MB, 01ME and 01MS
(blueprint: lem-weil-pbc-proj-polynomial-twist-chart).

`P = Proj (A[x₀,…,xₘ])` is Mathlib's `Proj` of `MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A`
(total-degree grading), `U_k = Proj.basicOpen _ (X k)`, and `𝒪_P(1)` is the source's twisting
sheaf `Proj.twist _ 1` on this Proj (the integral model of which `ProjectiveSpace.twist`, the
record of def-pc-projective-space-twist, is the pullback), with local basis
`e_k = Proj.twistPowSection 1 (isHomogeneous_X A k)` (the fraction `x_k / 1`).
The ratio `x_l / x_k ∈ S_(x_k)` is the source's `MvPolynomial.awayXRatio A k l`.
-/

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Standard polynomial Proj charts and the bases of `𝒪(1)`.
Source: Constructions 01NG, 01M4, 01MB, 01ME, 01MS
(blueprint: lem-weil-pbc-proj-polynomial-twist-chart).

Proof: (1) The positive-degree ideal is generated by the variables: each positive-degree
monomial is divisible by a variable (def-pc-proj and def-nagata-affine-proj).
(2) Apply prop-nagata-proj-standard-open to get the covering and canonical affine charts,
using def-nagata-homogeneous-localization-degree-zero.
(3) Apply lem-weil-pbc-dehomogenization-polynomial-ring to identify each localization with
polynomials in the ratios of the other variables to the chart variable.
(4) Apply lem-weil-pbc-proj-basic-open-intersection to identify the intersection with the
principal open of the ratio; its inverse on the intersection is the opposite ratio.
(5) The local basis and transition rule are those of def-pc-projective-space-twist at d=1.
(6) Use def-weil-affine-spectrum to form the local maps from the constant-ring maps.
(7) They agree on intersections, since both ring maps send a constant to the same fraction;
lem-weil-pbc-morphism-into-affine-scheme identifies the corresponding scheme maps.
(8) Use lem-weil-pbc-scheme-morphism-gluing to glue them uniquely. -/
theorem proj_polynomial_twist_chart (A : Type u) [CommRing A] (m : ℕ) :
    (⨆ k : Fin (m + 1), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
      (MvPolynomial.X k)) = ⊤ ∧
    (∀ k : Fin (m + 1),
      IsIso (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
        (MvPolynomial.X k))) ∧
    (∀ k : Fin (m + 1),
      ∃ e : MvPolynomial {l : Fin (m + 1) // l ≠ k} A ≃ₐ[A]
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
          (MvPolynomial.X k),
        ∀ l : {l : Fin (m + 1) // l ≠ k},
          e (MvPolynomial.X l) = MvPolynomial.awayXRatio A k l.1) ∧
    (∀ k : Fin (m + 1),
      Scheme.Modules.IsFreeGenerator
        (M := Proj.twist (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) 1)
        (Proj.twistPowSection 1 (MvPolynomial.isHomogeneous_X A k))) ∧
    (∀ k l : Fin (m + 1),
      (Proj.twist (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) 1).presheaf.map
        (homOfLE inf_le_right :
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) (MvPolynomial.X k) ⊓
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
              (MvPolynomial.X l) ⟶
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
            (MvPolynomial.X l)).op
        (Proj.twistPowSection 1 (MvPolynomial.isHomogeneous_X A l)) =
      (Proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)).presheaf.map
        (homOfLE inf_le_left :
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) (MvPolynomial.X k) ⊓
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
              (MvPolynomial.X l) ⟶
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
            (MvPolynomial.X k)).op
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
          (MvPolynomial.X k) (MvPolynomial.awayXRatio A k l)) •
      (Proj.twist (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) 1).presheaf.map
        (homOfLE inf_le_left :
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) (MvPolynomial.X k) ⊓
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
              (MvPolynomial.X l) ⟶
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
            (MvPolynomial.X k)).op
        (Proj.twistPowSection 1 (MvPolynomial.isHomogeneous_X A k))) ∧
    (∀ k l : Fin (m + 1),
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) (MvPolynomial.X k)
          (MvPolynomial.isHomogeneous_X A k) Nat.one_pos ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) (MvPolynomial.X l) =
        PrimeSpectrum.basicOpen (MvPolynomial.awayXRatio A k l)) ∧
    ∃! q : Proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) ⟶ Spec (.of A),
      ∀ k : Fin (m + 1),
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A) (MvPolynomial.X k)
            (MvPolynomial.isHomogeneous_X A k) Nat.one_pos ≫ q =
          Spec.map (CommRingCat.ofHom (algebraMap A
            (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) A)
              (MvPolynomial.X k)))) := by
  sorry

end AlgebraicGeometry
