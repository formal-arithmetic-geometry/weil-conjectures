/-! # Local coefficient expressions for ideal powers

Source: Stacks Project, Tag 02O8, the finite-type assertion in its proof.
-/

@[expose] public section

set_option autoImplicit false
universe v
open CategoryTheory Opposite
namespace AlgebraicGeometry

/-- Ideal-power sections are locally spanned by base-ideal coefficients times an affine
spanning family. Source: Stacks Project, Tag 02O8, proof of
`lemma-cohomology-powers-ideal-times-F`, expanding the finite-type assertion.
(blueprint: lem-weil-pbc-ideal-powers-local-coefficient-span).

Proof: Restrict to an affine neighbourhood W of y inside V. Quasi-coherence identifies
F(W) with extension of scalars of F(U), so the restricted u_i span F(W). The extended
ideal formula identifies J(W) with the ideal generated by images of I. Inductively the
recursive idealSheafPower inclusion has range J(W)^m: at zero its inclusion is the
identity; at one it is J; at each successor the affine tensor/image comparison gives
the product of the preceding range with J(W). Applied to F, the same comparison gives
range J(W)^m F(W). Ideal.map_pow identifies J(W)^m with the ideal generated by images
of I^m. Expand a section of that product as a finite sum, then express each module
factor in the restricted u_i. Collect the scalar factors to obtain membership in the
span stated here. For m=0 the ideal is the unit ideal. For I=0 positive powers vanish;
for an empty spanning family F(U)=0 and hence F(W)=0. No finite generation of I or
Noetherian hypothesis is needed. -/
theorem idealPowersLocalCoefficientSpan {A : Type v} [CommRing A]
    {X : Scheme.{v}} (f : X ⟶ Spec (CommRingCat.of A))
    (I : Ideal A) (J : X.IdealSheafData)
    (hJ : J = (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f)
    (F : X.Modules) [F.IsQuasicoherent]
    (U : X.Opens) (hU : IsAffineOpen U) (r : ℕ) (u : Fin r → Γ(F, U))
    (hu : Submodule.span Γ(X, U) (Set.range u) = ⊤)
    (m : ℕ) (V : X.Opens) (hVU : V ≤ U)
    (t : (Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F).val.obj
      (op V)) (y : X) (hyV : y ∈ V) :
    ∃ (W : X.Opens) (hWV : W ≤ V), y ∈ W ∧
      ((Scheme.idealModuleProductι (Scheme.idealSheafPower J.toModulesι m).2 F).app
        W).hom
        ((Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F).val.map
          (homOfLE hWV).op t) ∈
      Submodule.span Γ(X, W)
        {z | ∃ (i : Fin r) (a : A), a ∈ I ^ m ∧
          z = (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
            f.appLE ⊤ W le_top).hom a) •
              F.val.map (homOfLE (hWV.trans hVU)).op (u i)} := by sorry

end AlgebraicGeometry
