module

public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Module
public import Sheaf.AlgebraicGeometry.IdealModuleProductStalk
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Sheaf.AlgebraicGeometry.Coherent
import Sheaf.AlgebraicGeometry.Modules.IdealTimesQuasiCoherentAffineSections
import Sheaf.AlgebraicGeometry.QuasiCoherentAffineSectionBaseChange
import Sheaf.AlgebraicGeometry.QuasiCoherentTensorProductAffineSections
import Sheaf.AlgebraicGeometry.Modules.QuasiCoherentCokernelImage
import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Affine
import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent

/-! # Local coefficient expressions for ideal powers

Source: Stacks Project, Tag 02O8, the finite-type assertion in its proof.
-/

@[expose] public section

set_option autoImplicit false
universe v
open CategoryTheory Opposite
namespace AlgebraicGeometry

/-- Affine core of the local coefficient span argument.  On an affine open `W`,
the ideal-power product section is in the coefficient span of the given affine
generators.  This is the algebraic expansion step in Stacks Tag 02O8.
(blueprint: lem-weil-pbc-ideal-powers-local-coefficient-span-affine-core)
The proof expands the ideal-module product using the extended-ideal formula,
inducts on the recursive ideal power, and rewrites each module factor using
the spanning hypothesis. -/
theorem idealPowersLocalCoefficientSpan_affine {A : Type v} [CommRing A]
    {X : Scheme.{v}} (f : X ⟶ Spec (CommRingCat.of A))
    (I : Ideal A) (J : X.IdealSheafData)
    (hJ : J = (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f)
    (F : X.Modules) [F.IsQuasicoherent]
    (U : X.Opens) (hU : IsAffineOpen U) (r : ℕ) (u : Fin r → Γ(F, U))
    (hu : Submodule.span Γ(X, U) (Set.range u) = ⊤)
    (m : ℕ) (W : X.Opens) (hW : IsAffineOpen W) (hWU : W ≤ U)
    (t : (Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F).val.obj
      (op W)) :
    ((Scheme.idealModuleProductι (Scheme.idealSheafPower J.toModulesι m).2 F).app
        W).hom t ∈
      Submodule.span Γ(X, W)
        {z | ∃ (i : Fin r) (a : A), a ∈ I ^ m ∧
          z = (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
            f.appLE ⊤ W le_top).hom a) •
              F.val.map (homOfLE hWU).op (u i)} :=
  open CategoryTheory.Limits AlgebraicGeometry.Scheme.Modules in
  open scoped TensorProduct Pointwise in
  by
    set_option backward.isDefEq.respectTransparency false in
      classical
      let R := Γ(X, W)
      let ρ := (X.presheaf.map (homOfLE hWU).op).hom
      let uW : Fin r → Γ(F, W) := fun i ↦ F.val.map (homOfLE hWU).op (u i)
      -- Affine base change transports the spanning family to W.
      have hspan : Submodule.span R (Set.range uW) = ⊤ := by
        let : Algebra Γ(X, U) Γ(X, W) := ρ.toAlgebra
        let : Module Γ(X, U) Γ(F, W) := Module.compHom _ ρ
        obtain ⟨c, hc, _, ht⟩ :=
          quasiCoherent_affine_section_baseChange X F ⟨W, hW⟩ ⟨U, hU⟩ hWU
        apply top_unique
        intro s hs
        clear hs
        obtain ⟨q, rfl⟩ := hc.2 s
        induction q using TensorProduct.induction_on with
        | zero => exact c.map_zero ▸ Submodule.zero_mem _
        | tmul x b =>
          rw [ht]
          apply Submodule.smul_mem
          have hx : x ∈ Submodule.span Γ(X, U) (Set.range u) := hu ▸ Submodule.mem_top
          induction hx using Submodule.span_induction with
          | mem x hx =>
            obtain ⟨i, rfl⟩ := hx
            exact Submodule.subset_span (Set.mem_range_self i)
          | zero =>
            rw [map_zero]
            exact Submodule.zero_mem _
          | add x y _ _ hx hy =>
            rw [map_add]
            exact Submodule.add_mem _ hx hy
          | smul a x _ hx =>
            change F.val.map (homOfLE hWU).op (a • x) ∈ _
            rw [F.val.map_smul]
            exact Submodule.smul_mem _ _ hx
        | add x y hx hy =>
          rw [map_add]
          exact Submodule.add_mem _ hx hy
      let α : A →+* Γ(X, W) :=
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f.appLE ⊤ W le_top).hom
      have hJideal : J.ideal ⟨W, hW⟩ = I.map α := by
        rw [hJ, Scheme.IdealSheafData.ideal_comap_appLE _ f
          ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩ le_top,
          Scheme.IdealSheafData.ideal_top_ofIdealTop, Ideal.map_map]
        rfl
      -- The image of multiplication on an affine open is generated by pure tensors.
      have hproduct {K : X.Modules} [K.IsQuasicoherent]
          (i : K ⟶ SheafOfModules.unit X.ringCatSheaf)
          (t : Γ(Scheme.idealModuleProduct i F, W)) :
          (Scheme.idealModuleProductι i F).app W t ∈
            (LinearMap.range (i.val.app (op W)).hom : Ideal R) •
              (⊤ : Submodule R Γ(F, W)) := by
        let : MonoidalCategory X.Modules := SheafOfModules.monoidalCategory X.sheaf
        let a := MonoidalCategory.whiskerRight i F ≫ (MonoidalCategory.leftUnitor F).hom
        have := (quasiCoherent_tensor_product_affine_sections K F).1
        have hb := (quasiCoherent_cokernel_image a).2.2.2.2.2.2.2.2 ⟨W, hW⟩
        let e := Abelian.imageIsoImage a
        have hi : e.inv ≫ Abelian.image.ι a = image.ι a := by
          calc
            _ = e.inv ≫ e.hom ≫ image.ι a :=
              congrArg (fun f ↦ e.inv ≫ f)
                (Abelian.imageIsoImage_hom_comp_image_ι a).symm
            _ = _ := by simp
        have hm : (Scheme.idealModuleProductι i F).app W t ∈
            Set.range ((Abelian.image.ι a).app W) := by
          refine ⟨e.inv.app W t, ?_⟩
          exact congrArg (fun f ↦ f.app W t) hi
        rw [hb.1] at hm
        obtain ⟨z, hz⟩ := hm
        obtain ⟨q, rfl⟩ := (quasiCoherent_tensor_product_affine_sections K F).2 W hW |>.2 z
        rw [← hz]
        clear hz
        have hp (s : Γ(K, W)) (v : Γ(F, W)) :
            a.app W (tensorSectionsMap K F W (s ⊗ₜ v)) =
              (show Γ(X, W) from i.app W s) • v := by
          rw [tensorSectionsMap_tmul]
          change (MonoidalCategory.leftUnitor F).hom.app W
            ((MonoidalCategory.whiskerRight i F).app W (tmulSection s v)) = _
          rw [whiskerRight_app_tmulSection, leftUnitor_hom_app_tmulSection']
          rfl
        induction q using TensorProduct.induction_on with
        | zero => simp only [map_zero]; exact Submodule.zero_mem _
        | tmul s v =>
          rw [hp]
          exact Submodule.smul_mem_smul ⟨s, rfl⟩ (Submodule.mem_top)
        | add x y hx hy =>
          simp only [map_add]
          exact Submodule.add_mem _ hx hy
      have hpowqc : (Scheme.idealSheafPower J.toModulesι m).1.IsQuasicoherent := by
        cases m with
        | zero => exact SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
        | succ n =>
          exact (ideal_times_quasiCoherent_affine_sections J F).2.2.1 (n + 1)
            (Nat.succ_pos n)
      have hrange : (LinearMap.range
          ((Scheme.idealSheafPower J.toModulesι m).2.val.app (op W)).hom : Ideal R) =
            I.map α ^ m := by
        cases m with
        | zero =>
          change LinearMap.range (LinearMap.id : Γ(X, W) →ₗ[Γ(X, W)] Γ(X, W)) = _
          simp
        | succ n =>
          have hp := ((ideal_times_quasiCoherent_affine_sections J F).2.2.2.1
            ⟨W, hW⟩).2.2.2 (n + 1) (Nat.succ_pos n)
          have he : (LinearMap.range
              ((Scheme.idealSheafPower J.toModulesι (n + 1)).2.val.app (op W)).hom :
                Ideal R) = J.ideal ⟨W, hW⟩ ^ (n + 1) := SetLike.coe_injective hp
          exact he.trans (congrArg (fun Q ↦ Q ^ (n + 1)) hJideal)
      have hmem := hproduct (Scheme.idealSheafPower J.toModulesι m).2 t
      rw [hrange, ← Ideal.map_pow, ← hspan, Ideal.map, Submodule.span_smul_span] at hmem
      apply Submodule.span_mono _ hmem
      rintro z ⟨b, ⟨a, ha, rfl⟩, v, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, a, ha, rfl⟩

theorem idealPowersLocalCoefficientSpan {A : Type v} [CommRing A]
    {X : Scheme.{v}} (f : X ⟶ Spec (CommRingCat.of A))
    (I : Ideal A) (J : X.IdealSheafData)
    (hJ : J = (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f)
    (F : X.Modules) [F.IsQuasicoherent]
    (U : X.Opens) (hU : IsAffineOpen U) (r : ℕ) (u : Fin r → Γ(F, U))
    (hu : Submodule.span Γ(X, U) (Set.range u) = ⊤)
    (m : ℕ) (V : X.Opens) (hVU : V ≤ U)
    (t : (Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F).val.obj
      (op V)) (y : X) (hyV : y ∈ V) :
    ∃ (W : X.Opens) (hWV : W ≤ V), y ∈ W ∧
      ((Scheme.idealModuleProductι (Scheme.idealSheafPower J.toModulesι m).2 F).app
        W).hom
        ((Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F).val.map
          (homOfLE hWV).op t) ∈
      Submodule.span Γ(X, W)
        {z | ∃ (i : Fin r) (a : A), a ∈ I ^ m ∧
          z = (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
            f.appLE ⊤ W le_top).hom a) •
              F.val.map (homOfLE (hWV.trans hVU)).op (u i)} := by
  classical
  obtain ⟨_, ⟨W, hW, rfl⟩, hyW, hWV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (a := y) hyV V.2
  let tW := (Scheme.idealModuleProduct (Scheme.idealSheafPower J.toModulesι m).2 F).val.map
    (homOfLE hWV).op t
  have hcore := idealPowersLocalCoefficientSpan_affine f I J hJ F U hU r u hu m W hW
    (hWV.trans hVU) tW
  refine ⟨W, hWV, hyW, ?_⟩
  dsimp [tW] at hcore
  convert hcore using 1
  · congr 2
  · rfl


end AlgebraicGeometry
