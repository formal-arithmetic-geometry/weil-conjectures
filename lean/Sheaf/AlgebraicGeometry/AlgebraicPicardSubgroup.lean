module

public import Sheaf.AlgebraicGeometry.LineAlgebraicEquivalence
public import WeilConjectures.AlgebraicGeometry.Picard.Group
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-! # The subgroup of algebraically trivial line classes

Source: the family-generated subgroup in the auxiliary Picard argument for Guo,
Proposition 5.2, Claim 5.2.1, printed pp. 12-13; Milne, Abelian Varieties, I §8.
(blueprint: def-sfb-algebraic-picard-subgroup)

The Picard group and its family relation are the existing constructions. The group is
written multiplicatively: a difference of classes is their quotient.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme

/-- The subgroup generated by differences of fibres in smooth connected separated
finite-type families. `LineAlgebraicEquivalenceStep` allows isomorphic representatives
and uses the actual tensor pullback for both fibres. Its extra isomorphic pairs only
contribute the identity, so they do not change the generated subgroup. Taking the chosen
representatives of Picard classes loses no families, since the step includes endpoint
isomorphisms.
Source: the family-generated subgroup specified in the auxiliary Picard argument for
Guo, Proposition 5.2, Claim 5.2.1, pp. 12-13; Milne, Abelian Varieties, I §8.
(blueprint: def-sfb-algebraic-picard-subgroup) -/
def algebraicPicardSubgroup {k : Type u} [Field k]
    (X : Over (Spec (.of k))) : Subgroup X.left.Pic :=
  Subgroup.closure {c | ∃ a b : X.left.Pic,
    Modules.LineAlgebraicEquivalenceStep X
      ((fromSkeleton X.left.Modules).obj a.val)
      ((fromSkeleton X.left.Modules).obj b.val) ∧ c = b / a}

end AlgebraicGeometry.Scheme
