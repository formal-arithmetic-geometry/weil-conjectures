module

public import Sheaf.AlgebraicGeometry.SchemeTangentSpace
public import Mathlib.AlgebraicGeometry.Stalk
public import Mathlib.RingTheory.Ideal.Cotangent

/-!
# Compatibility of tangent coefficients with vector operations

Source: Stacks Project, Tag 0B2B
(blueprint: lem-sc-rational-tangent-coefficient-operation-compatibility).
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory

namespace AlgebraicGeometry

private theorem sharp_precomp
    {X : Scheme.{u}} {A B : Type u} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B]
    (φ : CommRingCat.of A ⟶ CommRingCat.of B) (f : Spec (.of A) ⟶ X)
    (g : Spec (.of B) ⟶ X) (h : Spec.map φ ≫ f = g)
    (x : X) (hx : f (IsLocalRing.closedPoint A) = x)
    (hy : g (IsLocalRing.closedPoint B) = x) :
    eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hy.symm) ≫
        Scheme.stalkClosedPointTo g =
      (eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
        Scheme.stalkClosedPointTo f) ≫ φ := by
  apply Spec.map_inj.mp
  apply (cancel_mono (X.fromSpecStalk x)).mp
  have hf : Spec.map (eqToHom
      (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
      Scheme.stalkClosedPointTo f) ≫ X.fromSpecStalk x = f := by
    have H (y : X) (hy : f (IsLocalRing.closedPoint A) = y) :
        Spec.map (eqToHom (congrArg (fun z : X ↦ X.presheaf.stalk z) hy.symm) ≫
          Scheme.stalkClosedPointTo f) ≫ X.fromSpecStalk y = f := by
      subst y
      simpa using Scheme.Spec_stalkClosedPointTo_fromSpecStalk f
    exact H x hx
  have hg : Spec.map (eqToHom
      (congrArg (fun y : X ↦ X.presheaf.stalk y) hy.symm) ≫
      Scheme.stalkClosedPointTo g) ≫ X.fromSpecStalk x = g := by
    have H (y : X) (hy : g (IsLocalRing.closedPoint B) = y) :
        Spec.map (eqToHom (congrArg (fun z : X ↦ X.presheaf.stalk z) hy.symm) ≫
          Scheme.stalkClosedPointTo g) ≫ X.fromSpecStalk y = g := by
      subst y
      simpa using Scheme.Spec_stalkClosedPointTo_fromSpecStalk g
    exact H x hy
  rw [hg, Spec.map_comp, Category.assoc, hf]
  exact h.symm

/-- A cotangent-functional assignment specified by stalk coefficients respects tangent
addition and scaling. There is no assertion that such an assignment exists, is injective,
or realizes all functionals.
Source: Stacks Project, Tag 0B2B, the pushout addition and epsilon scaling of tangent vectors
(blueprint: lem-sc-rational-tangent-coefficient-operation-compatibility).

Proof:
1. Given two tangent vectors, glue them to the square-zero spectrum with two coordinates
   using the pushout in `exists_tangentVectors_vectorSpace`. The selected additive structure
   takes the sum by precomposition with the map sending both coordinates to epsilon.
2. Morphisms from a local spectrum are recovered from their stalk homomorphisms. Hence
   precomposition with a spectrum map composes the corresponding local ring homomorphisms.
   The two projections extract the two second coordinates of the glued stalk map, and their
   sum extracts the sum of these coordinates. Thus the coefficient functional of the sum is
   the sum of the coefficient functionals, on every maximal-ideal representative.
3. The selected scalar operation is precomposition with epsilon scaling. Applying the same
   composition identity shows that this multiplies each second coordinate by the scalar.
   A `k`-scalar acts through `r` on both tangent and cotangent spaces.
4. Injectivity of `r` gives the functional equalities over `k`. The cotangent quotient is
   generated by its maximal-ideal representatives, so these equalities hold everywhere. -/
theorem rationalTangent_coefficient_operation_compatibility
    (k : Type u) [Field k] (X : Scheme.{u}) (p : X ⟶ Spec (.of k)) (x : X) :
    let R := X.presheaf.stalk x
    let K := X.residueField x
    let r : k →+* K :=
      (StructureSheaf.toStalk k (p x) ≫ p.stalkMap x ≫ X.residue x).hom
    Function.Bijective r →
    letI : Module k (schemeTangentSpace k X p x) :=
      Module.compHom (schemeTangentSpace k X p x) r
    letI : Module K (IsLocalRing.CotangentSpace R) :=
      inferInstanceAs (Module (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R))
    letI : Module k (IsLocalRing.CotangentSpace R) :=
      Module.compHom (IsLocalRing.CotangentSpace R) r
    ∀ C : schemeTangentSpace k X p x → (IsLocalRing.CotangentSpace R →ₗ[k] k),
      (∀ θ : schemeTangentSpace k X p x,
        ∃ hx : θ.val (IsLocalRing.closedPoint (DualNumber K)) = x,
          ∀ a : IsLocalRing.maximalIdeal R,
            r (C θ ((IsLocalRing.maximalIdeal R).toCotangent a)) =
              ((eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
                Scheme.stalkClosedPointTo θ.val).hom a).snd) →
      (∀ θ η, C (θ + η) = C θ + C η) ∧
        (∀ (a : k) θ, C (a • θ) = a • C θ) := by
  dsimp only
  intro hr
  let R := X.presheaf.stalk x
  let K := X.residueField x
  let r : k →+* K :=
    (StructureSheaf.toStalk k (p x) ≫ p.stalkMap x ≫ X.residue x).hom
  let : Module k (schemeTangentSpace k X p x) :=
    Module.compHom (schemeTangentSpace k X p x) r
  let : Module K (IsLocalRing.CotangentSpace R) :=
    inferInstanceAs (Module (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R))
  let : Module k (IsLocalRing.CotangentSpace R) :=
    Module.compHom (IsLocalRing.CotangentSpace R) r
  intro C hC
  let E := TrivSqZeroExt K (Fin 2 → K)
  let j : Fin 2 → (Spec (.of (DualNumber K)) ⟶ Spec (.of E)) := fun i ↦
    Spec.map (CommRingCat.ofHom
      (TrivSqZeroExt.map (LinearMap.proj i : (Fin 2 → K) →ₗ[K] K)).toRingHom)
  let sum : Spec (.of (DualNumber K)) ⟶ Spec (.of E) :=
    Spec.map (CommRingCat.ofHom (TrivSqZeroExt.map
      ((LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K) + LinearMap.proj 1)).toRingHom)
  let scale (t : K) : Spec (.of (DualNumber K)) ⟶ Spec (.of (DualNumber K)) :=
    Spec.map (CommRingCat.ofHom
      (TrivSqZeroExt.map (t • (LinearMap.id : K →ₗ[K] K))).toRingHom)
  have hops := Classical.choose_spec
    (Classical.choose_spec (exists_tangentVectors_vectorSpace k X p x).2.2.2)
  have haddSpec (θ η : schemeTangentSpace k X p x) (Θ : Spec (.of E) ⟶ X)
      (h0 : j 0 ≫ Θ = θ.val) (h1 : j 1 ≫ Θ = η.val) :
      (θ + η).val = sum ≫ Θ := hops.2.1 θ η Θ h0 h1
  have hsmulSpec (t : K) (θ : schemeTangentSpace k X p x) :
      (t • θ).val = scale t ≫ θ.val := hops.2.2 t θ
  have hC' (θ : schemeTangentSpace k X p x)
      (hx : θ.val (IsLocalRing.closedPoint (DualNumber K)) = x)
      (a : IsLocalRing.maximalIdeal R) :
      r (C θ ((IsLocalRing.maximalIdeal R).toCotangent a)) =
        ((eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
          Scheme.stalkClosedPointTo θ.val).hom a).snd := by
    obtain ⟨hy, hh⟩ := hC θ
    exact hh a
  constructor
  · intro θ η
    obtain ⟨Θ, ⟨h0, h1⟩, _⟩ := (exists_tangentVectors_vectorSpace k X p x).2.1 θ η
    change j 0 ≫ Θ = θ.val at h0
    change j 1 ≫ Θ = η.val at h1
    have : ∀ i : Fin 2, IsLocalHom
        (TrivSqZeroExt.map (LinearMap.proj i : (Fin 2 → K) →ₗ[K] K)).toRingHom :=
      fun i ↦ ⟨fun a ha ↦ TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr
        (by
          have hh := TrivSqZeroExt.isUnit_iff_isUnit_fst.mp ha
          change IsUnit (TrivSqZeroExt.map (LinearMap.proj i) a).fst at hh
          rwa [TrivSqZeroExt.fst_map] at hh)⟩
    obtain ⟨hx, _⟩ := hC θ
    obtain ⟨hy, _⟩ := hC η
    obtain ⟨hz, _⟩ := hC (θ + η)
    have hΘ : Θ (IsLocalRing.closedPoint E) = x := by
      have hh := congrArg (fun f : Spec (.of (DualNumber K)) ⟶ X ↦
        f (IsLocalRing.closedPoint (DualNumber K))) h0
      rw [Scheme.Hom.comp_apply] at hh
      change Θ ((Spec.map (CommRingCat.ofHom
        (TrivSqZeroExt.map (LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K)).toRingHom)) _) =
          θ.val _ at hh
      rw [Spec_closedPoint] at hh
      exact hh.trans hx
    let S : R ⟶ CommRingCat.of E :=
      eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hΘ.symm) ≫
        Scheme.stalkClosedPointTo Θ
    have hproj0 :
        eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
          Scheme.stalkClosedPointTo θ.val =
          S ≫ CommRingCat.ofHom
            (TrivSqZeroExt.map (LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K)).toRingHom :=
      sharp_precomp (A := E) (B := DualNumber K) (CommRingCat.ofHom
        (TrivSqZeroExt.map (LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K)).toRingHom)
        Θ θ.val h0 x hΘ hx
    have hproj1 :
        eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hy.symm) ≫
          Scheme.stalkClosedPointTo η.val =
          S ≫ CommRingCat.ofHom
            (TrivSqZeroExt.map (LinearMap.proj 1 : (Fin 2 → K) →ₗ[K] K)).toRingHom :=
      sharp_precomp (A := E) (B := DualNumber K) (CommRingCat.ofHom
        (TrivSqZeroExt.map (LinearMap.proj 1 : (Fin 2 → K) →ₗ[K] K)).toRingHom)
        Θ η.val h1 x hΘ hy
    have hsum :
        eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hz.symm) ≫
          Scheme.stalkClosedPointTo (θ + η).val =
          S ≫ CommRingCat.ofHom (TrivSqZeroExt.map
            ((LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K) + LinearMap.proj 1)).toRingHom :=
      sharp_precomp (A := E) (B := DualNumber K) (CommRingCat.ofHom (TrivSqZeroExt.map
        ((LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K) + LinearMap.proj 1)).toRingHom)
        Θ (θ + η).val (haddSpec θ η Θ h0 h1).symm x hΘ hz
    ext v
    obtain ⟨a, rfl⟩ := (IsLocalRing.maximalIdeal R).toCotangent_surjective v
    apply hr.1
    rw [LinearMap.add_apply, map_add, hC' (θ + η) hz, hC' θ hx, hC' η hy]
    rw [hsum, hproj0, hproj1]
    change (TrivSqZeroExt.map
      ((LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K) + LinearMap.proj 1) (S.hom a)).snd =
      (TrivSqZeroExt.map (LinearMap.proj 0 : (Fin 2 → K) →ₗ[K] K) (S.hom a)).snd +
        (TrivSqZeroExt.map (LinearMap.proj 1 : (Fin 2 → K) →ₗ[K] K) (S.hom a)).snd
    rw [TrivSqZeroExt.snd_map, TrivSqZeroExt.snd_map, TrivSqZeroExt.snd_map,
      LinearMap.add_apply]
  · intro a θ
    obtain ⟨hx, _⟩ := hC θ
    obtain ⟨hy, _⟩ := hC (a • θ)
    have hscaled : (a • θ).val = scale (r a) ≫ θ.val := hsmulSpec (r a) θ
    have hsharp :
        eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hy.symm) ≫
          Scheme.stalkClosedPointTo (a • θ).val =
          (eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
            Scheme.stalkClosedPointTo θ.val) ≫ CommRingCat.ofHom
              (TrivSqZeroExt.map (r a • (LinearMap.id : K →ₗ[K] K))).toRingHom :=
      sharp_precomp (A := DualNumber K) (B := DualNumber K) (CommRingCat.ofHom
        (TrivSqZeroExt.map (r a • (LinearMap.id : K →ₗ[K] K))).toRingHom)
        θ.val (a • θ).val hscaled.symm x hx hy
    ext v
    obtain ⟨b, rfl⟩ := (IsLocalRing.maximalIdeal R).toCotangent_surjective v
    apply hr.1
    rw [LinearMap.smul_apply, smul_eq_mul, map_mul, hC' (a • θ) hy, hC' θ hx]
    rw [hsharp]
    let w := ((eqToHom (congrArg (fun y : X ↦ X.presheaf.stalk y) hx.symm) ≫
      Scheme.stalkClosedPointTo θ.val).hom b)
    change (TrivSqZeroExt.map (r a • (LinearMap.id : K →ₗ[K] K)) w).snd = r a * w.snd
    rw [TrivSqZeroExt.snd_map, LinearMap.smul_apply, LinearMap.id_apply]
    rfl

end AlgebraicGeometry
