module

public import WeilConjectures.AlgebraicGeometry.GroupScheme.GeneralLinear.Lie
import WeilConjectures.AlgebraicGeometry.GroupScheme.LieIdentityTangentEquiv
public import Sheaf.AlgebraicGeometry.LinearGroupSchemes
public import Mathlib.Algebra.Lie.BaseChange
import Sheaf.RingTheory.BialgebraDistributionTangentCalculus
import Sheaf.AlgebraicGeometry.AffineFiniteTypeAlgebra
import Mathlib.RingTheory.Flat.Basic
import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-! # Tangent Lie functor for affine algebraic groups

Source: Milne, Algebraic Groups, 10.6--10.7, 10.11, 10.19--10.23 and 10.28--10.29,
printed pp.188--196 (blueprint: lem-sfb-affine-group-lie-tangent-calculus).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct MonObj CategoryTheory.Obj

namespace AlgebraicGeometry.GrpObj

/-- The tangent Lie functor, its matrix formula, and its canonical scalar extension.

`Lie G` is the identity tangent space through `lieIdentityTangentEquiv G`, using the
structural residue-field identification. The bracket and differential are the existing
canonical constructions. The family `Φ` is characterized on `1 ⊗ X` by extension of the
associated dual-number point. This fixes its values on all pure tensors by K-linearity.
The final coordinate equation states entrywise matrix extension without choosing a second
model for the pullback of GL: its coordinate functions are pulled back along `pullback.fst`.

Source: Milne, Algebraic Groups, 10.6--10.7, 10.11, 10.19--10.23 and 10.28--10.29,
printed pp.188--196 (blueprint: lem-sfb-affine-group-lie-tangent-calculus).

Proof:
1. The coordinate-Hopf theorem `lem-sfb-affine-group-coordinate-hopf` supplies the
   coproduct and counit of C = k[G]. The algebra is finitely generated by
   `lem-pc-affine-finite-type-algebra`. Pulling back the group diagrams shows that
   u = f* preserves coproduct and counit (`def-weil-affine-spectrum`).
2. Write a dual-number point uniquely as ε(c) + ε v(c). Multiplicativity is exactly
   the counit Leibniz rule. Addition and scaling add and scale v, by
   `def-sc-scheme-tangent-space`. Restriction identifies these v with (I/I²)* by
   `lem-sfb-bialgebra-distribution-tangent-calculus`, and reduction gives the kernel.
3. If c_i generate C, the classes of c_i - ε(c_i) span I/I². A basis, supplied by
   `lem-weil-pbc-vector-space-free`, is therefore finite; its coordinate functionals
   give a finite basis of the dual. This includes zero generators and zero dimension.
4. `lem-sfb-bialgebra-distribution-tangent-calculus` gives [v,w] = v*w - w*v,
   equivalently the commutator of the invariant derivations (1 ⊗ v)Δ. Transfer along
   step 2 gives the canonical tangent bracket, including in positive characteristic.
5. The differential is v ↦ v ∘ u. The Hopf-map equation gives
   (v ∘ u)*(w ∘ u) = (v*w) ∘ u, proving bracket preservation. Associativity of
   precomposition gives the composition law. This is the tangent map of
   `def-sc-scheme-tangent-space`, through `lieIdentityTangentEquiv`.
6. For GL, every kernel point is uniquely I + εA, with inverse I - εA. On x_ij,
   the coproduct formula gives [A,B]_ij = Σ_r(A_ir B_rj - B_ir A_rj).
   Leibniz determines the coefficient on det⁻¹ as well, so the bracket is AB - BA.
   Apply step 5 to r to obtain r(t_X) = I + ε dr(X).
7. `lem-weil-pbc-fibre-product-affine-spectra` gives C_K = K ⊗ C. Flatness
   (`lem-weil-pbc-module-over-field-flat`, `lem-weil-pbc-flat-tensor-exact`) identifies
   I_K with K ⊗ I. Products identify I_K² with the image of K ⊗ I². Tensor right
   exactness (`lem-weil-pbc-tensor-right-exact`) gives (I_K/I_K²) = K ⊗ (I/I²).
8. For a finite basis b_j (`def-weil-pbc-free-module`), the map
   a ⊗ λ ↦ (b ⊗ x ↦ ab λ(x)) sends the extended dual basis to the dual of the
   extended basis. It is therefore an isomorphism, including dimension zero. Under
   step 2 it extends tangent points as stated. The extended coproduct gives
   [Φ(a ⊗ v), Φ(b ⊗ w)] = Φ(ab ⊗ [v,w]); bilinearity extends this to all tensors.
   Precomposition with f* commutes with this formula, giving naturality. On x_ij
   it is entrywise aA_ij. No smoothness, reducedness or perfectness is used.
-/
theorem affine_group_lie_tangent_calculus
    (k K : Type u) [Field k] [Field K] [Algebra k K] :
    (∀ (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
      [LocallyOfFiniteType G.hom] [QuasiCompact G.hom], FiniteDimensional k (Lie G)) ∧
    (∀ (G H J : Over (Spec (.of k))) [GrpObj G] [GrpObj H] [GrpObj J]
      [IsAffine G.left] [IsAffine H.left] [IsAffine J.left]
      [LocallyOfFiniteType G.hom] [QuasiCompact G.hom]
      [LocallyOfFiniteType H.hom] [QuasiCompact H.hom]
      [LocallyOfFiniteType J.hom] [QuasiCompact J.hom]
      (f : G ⟶ H) (g : H ⟶ J) [IsMonHom f] [IsMonHom g],
      differential (f ≫ g) = (differential g).comp (differential f) ∧
      ∀ x y : Lie G, differential f ⁅x, y⁆ = ⁅differential f x, differential f y⁆) ∧
    (∀ (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
      [LocallyOfFiniteType G.hom] [QuasiCompact G.hom],
      Set.BijOn (tangentPoint (G := G)) Set.univ (tangentGroup G : Set _)) ∧
    (∀ (n : Type u) [Fintype n] [DecidableEq n] (A B : Matrix n n k),
      ((GeneralLinearGroup.homMulEquiv n k (DualNumber k)
        (tangentPoint ((@LieEquiv.toLinearEquiv k _ (Matrix n n k) _ _
          LieRing.ofAssociativeRing _ _ (GeneralLinearGroup.lieAlgebraEquivMatrix n k)).symm A))) :
          Matrix n n (DualNumber k)) = 1 + A.map TrivSqZeroExt.inr ∧
      GeneralLinearGroup.toMatrix n k
        ⁅(@LieEquiv.toLinearEquiv k _ (Matrix n n k) _ _
          LieRing.ofAssociativeRing _ _ (GeneralLinearGroup.lieAlgebraEquivMatrix n k)).symm A,
          (@LieEquiv.toLinearEquiv k _ (Matrix n n k) _ _
          LieRing.ofAssociativeRing _ _ (GeneralLinearGroup.lieAlgebraEquivMatrix n k)).symm B⁆ =
          A * B - B * A) ∧
    (∀ (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
      [LocallyOfFiniteType G.hom] [QuasiCompact G.hom]
      (n : Type u) [Fintype n] [DecidableEq n]
      (r : GeneralLinearGroup.RationalHom G n) [IsMonHom r] (x : Lie G),
      ((r.points (DualNumber k) (tangentPoint x)) : Matrix n n (DualNumber k)) =
        1 + (GeneralLinearGroup.toMatrix n k (differential r x)).map TrivSqZeroExt.inr) ∧
    (∃ Φ : ∀ (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
        [LocallyOfFiniteType G.hom] [QuasiCompact G.hom],
        K ⊗[k] Lie G ≃ₗ⁅K⁆ Lie ((Over.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj G),
      (∀ (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
        [LocallyOfFiniteType G.hom] [QuasiCompact G.hom] (x : Lie G),
        (tangentPoint (Φ G (1 ⊗ₜ[k] x))).left ≫
            pullback.fst G.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
          Spec.map (CommRingCat.ofHom (DualNumber.mapRingHom (algebraMap k K))) ≫
            (tangentPoint x).left) ∧
      (∀ (G H : Over (Spec (.of k))) [GrpObj G] [GrpObj H]
        [IsAffine G.left] [IsAffine H.left]
        [LocallyOfFiniteType G.hom] [QuasiCompact G.hom]
        [LocallyOfFiniteType H.hom] [QuasiCompact H.hom]
        (f : G ⟶ H) [IsMonHom f] (a : K) (x : Lie G),
        Φ H (a ⊗ₜ[k] differential f x) =
          differential ((Over.pullback
            (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map f) (Φ G (a ⊗ₜ[k] x))) ∧
      (∀ (n : Type u) [Fintype n] [DecidableEq n] (a : K) (A : Matrix n n k) (i j : n),
        (Spec.preimage
          ((tangentPoint (Φ (GeneralLinearGroup n k)
            (a ⊗ₜ[k] (@LieEquiv.toLinearEquiv k _ (Matrix n n k) _ _
          LieRing.ofAssociativeRing _ _
              (GeneralLinearGroup.lieAlgebraEquivMatrix n k)).symm A))).left ≫
            pullback.fst (GeneralLinearGroup n k).hom
              (Spec.map (CommRingCat.ofHom (algebraMap k K))))).hom
            (Matrix.GeneralLinearGroup.coord n k i j) =
          (1 : Matrix n n (DualNumber K)) i j +
            TrivSqZeroExt.inr (a * algebraMap k K (A i j)))) := by
  sorry

end AlgebraicGeometry.GrpObj
