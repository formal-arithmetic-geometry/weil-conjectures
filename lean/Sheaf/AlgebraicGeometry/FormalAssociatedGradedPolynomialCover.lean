module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Sheaf.AlgebraicGeometry.FormalKernelGradedPieces
public import Sheaf.AlgebraicGeometry.GradedSheafStructures
import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Affine
import Sheaf.AlgebraicGeometry.Modules.IdealTimesQuasiCoherentAffineSections

/-! # A local polynomial cover of the associated graded ideal algebra

Source: Stacks Project, proof of Lemma 0884, polynomial cover refinement.
(blueprint: lem-weil-pbc-formal-associated-graded-polynomial-cover).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry

/-- Homogeneous polynomials in finite generators locally span the graded ideal algebra.
Source: Stacks Project, proof of Lemma 0884, first paragraph, polynomial cover refinement;
Lemma 087Z for the associated graded algebra
(blueprint: lem-weil-pbc-formal-associated-graded-polynomial-cover).

Proof: write x_i for the given generators of I. On an affine open V of X, the affine
ideal formula Scheme.IdealSheafData.ideal_comap_appLE identifies J(V) with the ideal
generated by
the images of the x_i. Evaluate a degree-k polynomial there using f-sharp for coefficients.
Its value lies in J(V)^k. The affine power-range formula in
ideal_times_quasiCoherent_affine_sections uniquely lifts this value through the inclusion
of the kth ideal power into the structure sheaf: that inclusion is monic, by induction
on the recursive power construction. For k=0 the inclusion is the identity. Naturality
of the inclusion and its injectivity show that these lifts agree on smaller affine opens.
On overlaps they agree on an affine cover, so the sheaf condition glues them on arbitrary
opens. Project the resulting sections of J^k through formalAssociatedGradedπ to define e.
Injectivity of the power inclusion proves additivity of the lifts. Apply hmul to the two
lifts to obtain the product formula: the section c there is the lift of the product
polynomial, again by injectivity. In degree zero the lift of C(a) is f-sharp(a), and hunit
identifies its projection with the displayed scalar unit.

For the spanning assertion, choose an affine neighbourhood W of y inside U. The power
modules are quasi-coherent, and the affine quotient-surjectivity clause of
ideal_times_quasiCoherent_affine_sections lifts all the finitely many restricted sections
a_i to J^k(W). The identity Ideal.span_pow_eq_map_homogeneousSubmodule expresses their
images in J(W)^k as evaluations of degree-k polynomials with coefficients in Γ(X,W).
Expand such a polynomial into its finitely many monomials. Each monomial is the evaluation
of a degree-k polynomial over A with coefficient one; hence the lift is a Γ(X,W)-linear
combination of the lifts used to define e. Projecting gives membership in the stated span.
For k=0 this is just the unit generating the quotient. If I=0 all positive pieces vanish,
independently of the chosen generating family. If I=A every graded quotient is zero.
The construction works
also for the zero ring and empty scheme; for an empty finite family choose any affine
neighbourhood of the given point. -/
theorem formalAssociatedGraded_polynomial_cover
    {A : Type u} [CommRing A] (I : Ideal A)
    {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of A))
    {r : ℕ} (generators : Fin r → A) (hgenerators : Ideal.span (Set.range generators) = I)
    (G : GradedSheafAlgebra (formalAssociatedGradedPiece
      ((Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f)))
    (hunit : G.unit = formalAssociatedGradedπ _ 0)
    (hmul : ∀ (m n : ℕ) (U : X.Opens)
      (a : (Scheme.idealSheafPower
        ((Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f).toModulesι m).1.val.obj
          (op U))
      (b : (Scheme.idealSheafPower
        ((Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f).toModulesι n).1.val.obj
          (op U)),
      ∃ c : (Scheme.idealSheafPower
        ((Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f).toModulesι
          (m + n)).1.val.obj (op U),
        (Scheme.idealSheafPower _ (m + n)).2.val.app (op U) c =
          (@id Γ(X, U) ((Scheme.idealSheafPower _ m).2.val.app (op U) a)) *
            (@id Γ(X, U) ((Scheme.idealSheafPower _ n).2.val.app (op U) b)) ∧
        G.mul m n U ((formalAssociatedGradedπ _ m).val.app (op U) a)
          ((formalAssociatedGradedπ _ n).val.app (op U) b) =
            (formalAssociatedGradedπ _ (m + n)).val.app (op U) c) :
    ∃ e : ∀ (k : ℕ) (U : X.Opens),
      MvPolynomial.homogeneousSubmodule (Fin r) A k →
        (formalAssociatedGradedPiece
          ((Scheme.IdealSheafData.ofIdealTop
            (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f) k).val.obj (op U),
      (∀ k U V (h : V ≤ U) b,
        (formalAssociatedGradedPiece _ k).val.map (homOfLE h).op (e k U b) = e k V b) ∧
      (∀ k U b b', e k U (b + b') = e k U b + e k U b') ∧
      (∀ k l U b b', G.mul k l U (e k U b) (e l U b') =
        e (k + l) U ⟨b.val * b'.val, b.property.mul b'.property⟩) ∧
      (∀ U a, e 0 U ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C (Fin r) a⟩ =
        G.unit.val.app (op U)
          ((X.presheaf.map (homOfLE (le_top (a := U))).op).hom
            (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a))) ∧
      (∀ (k : ℕ) (U : X.Opens) (s : ℕ)
        (a : Fin s → (formalAssociatedGradedPiece _ k).val.obj (op U))
        (y : X), y ∈ U → ∃ (W : X.Opens) (hWU : W ≤ U), y ∈ W ∧
          ∀ i, (formalAssociatedGradedPiece _ k).val.map (homOfLE hWU).op (a i) ∈
            Submodule.span Γ(X, W) (Set.range (e k W))) := by sorry

end AlgebraicGeometry
