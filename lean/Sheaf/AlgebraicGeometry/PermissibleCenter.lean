module

public import Sheaf.AlgebraicGeometry.IsRegularScheme
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import WeilConjectures.RingTheory.IsRegularSystemOfParameters

/-!
# Permissible centers

Source: ILO, Travaux de Gabber, Expose VIII, 4.1.2, Remark 4.2.2(i), and Lemma 4.2.9,
printed pp. 117--121 (blueprint: def-trf-permissible-center).
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry
/-- The center is regular and, in the boundary coordinates, is generated by a nonempty
subset of the full parameter system. The generators of the center need not be among
the boundary factors. Source: ILO, Exposé VIII, Lemma 4.2.9
(blueprint: def-trf-permissible-center). -/
def IsPermissibleCenter {X : Scheme.{u}} (B M : X.IdealSheafData) : Prop :=
  IsRegularScheme M.subscheme ∧
    (M.support : Set X) ⊆ (B.support : Set X) ∧
    ∀ x : X, x ∈ M.support →
      ∃ (W : Scheme.{u}) (v : W ⟶ X) (_hev : Etale v) (w : W) (_hw : v w = x)
        (U : W.affineOpens) (hU : w ∈ U.1) (r d : ℕ)
        (_hnoeth : IsNoetherianRing (W.presheaf.stalk w))
        (t : Fin d → W.presheaf.stalk w) (f : Fin r → Γ(W, U.1))
        (s : Fin r → Fin d) (m : ℕ) (g : Fin m → Γ(W, U.1))
        (q : Fin m → Fin d),
        Function.Injective s ∧
          Function.Injective q ∧
          (0 < m) ∧
          @IsLocalRing.IsRegularSystemOfParameters (W.presheaf.stalk w)
            inferInstance inferInstance _hnoeth (List.ofFn t) ∧
          (B.comap v).ideal U = Ideal.span {∏ i, f i} ∧
          (M.comap v).ideal U = Ideal.span {x | ∃ j, x = g j} ∧
          (∀ i, (W.presheaf.germ U.1 w hU).hom (f i) = t (s i)) ∧
          ∀ j, (W.presheaf.germ U.1 w hU).hom (g j) = t (q j)

end AlgebraicGeometry
