module

public import Sheaf.AlgebraicGeometry.AffineTraceTower
public import Mathlib.RingTheory.Regular.RegularSequence

/-! # Regular generators in ordered affine-diagonal difference coordinates

Source: current blueprint, projection-purity-agreement, Agreement on the model,
normal-coordinate calculation; Stacks 0636.
(blueprint: lem-pur-affine-diagonal-regular-differences).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

namespace AlgebraicGeometry

/-- Every point of the affine diagonal has an ambient affine neighborhood on which
its actual ordered coordinate differences form a regular sequence generating the
kernel ideal. This assertion concerns the original diagonal, without any normal cone.

Source: current blueprint, lem-pur-projection-purity-agreement.proof.md,
Agreement on the model, the translation identifying the diagonal with the zero section;
expanded step 1 of lem-pur-affine-diagonal-graded-coordinates.
(blueprint: lem-pur-affine-diagonal-regular-differences).

Proof: choose an affine open Spec R of Y containing the image of z. Over it the
ordered tower is Spec R[x_1,...,x_d] and its self-product is Spec R[x,y]. These are
open subschemes of the respective global schemes, so the latter is an ambient
affine neighborhood U of the diagonal point. Substitute u_i=y_i-x_i; the inverse
substitution is y_i=x_i+u_i. This identifies the diagonal map with evaluation at
u=0 on R[x,u], whose kernel is generated by the ordered u_i. Successively
quotienting by u_1,...,u_j leaves a polynomial ring in the remaining variables;
multiplication by the next variable is injective, by comparing coefficients.
The final quotient R[x] is nonzero, since its spectrum contains z. Thus the
sequence is regular, with precisely the restricted y_i-x_i as generators.
For d=0 the kernel is zero and the sequence empty, regular because U contains
z. If Y is empty there is no z to consider, so no nonemptiness assumption is
added. The zero ring cannot occur in a chart containing the specified point. -/
theorem affineDiagonal_regular_differences (Y : Scheme.{u}) (d : ℕ)
    (z : affineTraceTower Y d) :
    ∃ U : (pullback (affineTraceProjection Y d) (affineTraceProjection Y d)).affineOpens,
      (pullback.diagonal (affineTraceProjection Y d)) z ∈ U.1 ∧
      let f : Fin d → Γ(pullback (affineTraceProjection Y d) (affineTraceProjection Y d),
          U.1) := fun j ↦
        (pullback (affineTraceProjection Y d) (affineTraceProjection Y d)).presheaf.map
          (homOfLE (show U.1 ≤ ⊤ from le_top)).op
          ((pullback.snd (affineTraceProjection Y d) (affineTraceProjection Y d)).appTop
              (affineTraceCoordinate Y d j) -
            (pullback.fst (affineTraceProjection Y d) (affineTraceProjection Y d)).appTop
              (affineTraceCoordinate Y d j))
      RingTheory.Sequence.IsRegular Γ(pullback (affineTraceProjection Y d)
          (affineTraceProjection Y d), U.1) (List.ofFn f) ∧
        Ideal.span (Set.range f) =
          (pullback.diagonal (affineTraceProjection Y d)).ker.ideal U := by sorry

end AlgebraicGeometry
