/-! # Fpqc reflection of the effective Cartier condition for a specified ideal

Source: Stacks Project, Descent, Tags 05B2 and 023T; Divisors, Tag 01WS.
(blueprint: lem-trf-fpqc-cartier-ideal-reflection).
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u w

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

/-- Effective Cartier ideals on an fpqc covering descend to the specified kernel ideal.
The identification after pullback commutes with its given inclusion into the structure sheaf.
Source: Stacks Project, Descent, Tags 05B2 and 023T; Divisors, Tag 01WS.
(blueprint: lem-trf-fpqc-cartier-ideal-reflection).

Proof:
1. Each covering map is flat. By `lem-pc-closed-subscheme-base-change-ideal-image`,
   the base-changed closed immersion has kernel ideal equal to the image of the pulled-back
   inclusion. By `lem-pur-ideal-tensor-pullback-comparison`, flatness makes the canonical
   factorization an isomorphism. Its composite with the ideal inclusion is exactly the
   pulled-back inclusion followed by the canonical structure-sheaf comparison.
2. On affine neighbourhoods an effective Cartier ideal is generated by a nonzerodivisor t.
   Multiplication by t identifies the ring with the principal ideal: generation gives
   surjectivity and regularity gives injectivity. Quasi-coherence identifies the restricted
   ideal sheaf with this associated module. Thus each pulled-back ideal is locally free of
   rank one, including for t = 1.
3. The original kernel ideal is quasi-coherent. Apply fixed-rank finite locally free descent,
   clause (2) of `lem-pc-fpqc-descent`, to this module with rank 1. This descends a property of
   the specified module and does not choose a different ideal or require compatible bases.
4. Compose a local trivialization of the ideal with its specified inclusion and apply it to
   1. The resulting section generates the ideal; multiplication by it is injective since
   both the trivialization and the ideal inclusion are injective. It is a nonzerodivisor,
   proving invertibility and the effective Cartier condition. The unit ideal is included.
   An empty covering forces the base empty, where all local conditions are vacuous. -/
theorem fpqc_cartier_ideal_reflection {X T : Scheme.{u}}
    (i : T ⟶ X) [IsClosedImmersion i] {A : Type w} (Y : A → Scheme.{u})
    (g : ∀ a : A, Y a ⟶ X)
    (hg : Presieve.ofArrows Y g ∈ Scheme.fpqcPrecoverage X)
    (hJ : ∀ a : A, (pullback.snd i (g a)).ker.IsInvertible) :
    (∀ a : A, ∃ e : (Scheme.Modules.tensorPullback (g a)).obj i.ker.toModules ≅
        (pullback.snd i (g a)).ker.toModules,
      e.hom ≫ (pullback.snd i (g a)).ker.toModulesι =
        (Scheme.Modules.tensorPullback (g a)).map i.ker.toModulesι ≫
          Scheme.Modules.tensorPullbackObjUnitToUnit (g a)) ∧
    i.ker.toModules.IsFiniteLocallyFreeOfRank 1 ∧ i.ker.IsInvertible := by
  classical
  have hflat : ∀ a, Flat (g a) :=
    ((Scheme.ofArrows_mem_precoverage_iff @Flat).mp hg.2).2
  have hker (a : A) : (pullback.snd i (g a)).ker = i.ker.comap (g a) := by
    calc
      _ = (pullback.fst (g a) i).ker := by
        rw [← Scheme.Hom.ker_comp_of_isIso (pullbackSymmetry i (g a)).hom
          (pullback.fst (g a) i), pullbackSymmetry_hom_comp_fst]
      _ = _ := Scheme.IdealSheafData.ker_fst_of_isClosedImmersion i (g a)
  have he (a : A) : ∃ e : (Scheme.Modules.tensorPullback (g a)).obj i.ker.toModules ≅
      (pullback.snd i (g a)).ker.toModules,
      e.hom ≫ (pullback.snd i (g a)).ker.toModulesι =
        (Scheme.Modules.tensorPullback (g a)).map i.ker.toModulesι ≫
          Scheme.Modules.tensorPullbackObjUnitToUnit (g a) := by
    rw [hker a]
    obtain ⟨d, hd, -⟩ := existsUnique_idealTensorPullbackComparison (g a) i.ker
    have : IsIso d := hd.2.2 (hflat a)
    exact ⟨asIso d, hd.1⟩
  have hlocal (a : A) :
      ((Scheme.Modules.pullback (g a)).obj i.ker.toModules).IsFiniteLocallyFreeOfRank 1 := by
    obtain ⟨e, -⟩ := he a
    have := (hJ a).isInvertible_toModules
    have := Scheme.Modules.IsInvertible.sheafOfModules_isInvertible
      (pullback.snd i (g a)).ker.toModules
    have := (SheafOfModules.isInvertible_iff_isFiniteLocallyFreeOfRank_one
      (pullback.snd i (g a)).ker.toModules).mp this
    let c : Scheme.Modules.tensorPullback (g a) ≅ Scheme.Modules.pullback (g a) :=
      (Classical.choose (Scheme.Modules.exists_tensorPullbackAdjunction (g a))).leftAdjointUniq
        (Scheme.Modules.pullbackPushforwardAdjunction (g a))
    exact SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso
      (e.symm ≪≫ c.app i.ker.toModules)
  have hrank : i.ker.toModules.IsFiniteLocallyFreeOfRank 1 := by
    apply isFiniteLocallyFreeOfRank_of_toDescentData_iso g
      (Precoverage.generate_mem_toGrothendieck hg)
      ((modulesPseudofunctor.toDescentData g).obj i.ker.toModules)
      i.ker.toModules ⟨Iso.refl _⟩ 1
    intro a
    exact hlocal a
  refine ⟨he, hrank, ?_⟩
  have := (SheafOfModules.isInvertible_iff_isFiniteLocallyFreeOfRank_one
    i.ker.toModules).mpr hrank
  intro x
  obtain ⟨U, hx, -, s, hs⟩ := Scheme.Modules.exists_isFreeGenerator i.ker.toModules
    (TopologicalSpace.Opens.mem_top x)
  let t : Γ(X, U.1) := i.ker.toModulesι.app U.1 s
  refine ⟨U, hx, t, ?_, ?_⟩
  · rw [mem_nonZeroDivisors_iff_right]
    intro a ha
    apply hs.smul_left_injective
    apply i.ker.injective_toModulesι_app U.1
    simpa only [Scheme.Modules.Hom.app_smul, smul_eq_mul, zero_smul, map_zero] using ha
  · apply le_antisymm
    · intro a ha
      have ha' : a ∈ Set.range (i.ker.toModulesι.app U.1) := by
        rw [i.ker.range_toModulesι_app U]
        exact ha
      obtain ⟨m, rfl⟩ := ha' 
      obtain ⟨r, rfl⟩ := hs.exists_smul_eq m
      exact Ideal.mem_span_singleton'.mpr ⟨r, by simp [t, Scheme.Modules.Hom.app_smul]⟩
    · apply Ideal.span_le.mpr
      intro a ha
      obtain rfl := Set.mem_singleton_iff.mp ha
      exact (i.ker.range_toModulesι_app U).subset ⟨s, rfl⟩

end AlgebraicGeometry
