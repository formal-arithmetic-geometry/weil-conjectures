module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.ResidueField
public import Mathlib.RingTheory.AdicCompletion.LocalRing
import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.RingTheory.Localization.Submodule
import Mathlib.RingTheory.Unramified.LocalRing
import WeilConjectures.RingTheory.FlatLocalCompletionIso

/-!
# Completion comparison and congruence through an elementary etale chart

Source: Stacks Project, Tag 0CAV, proof of lemma-isomorphism-approximation;
Tag 0AGX for the completion comparison.
(blueprint: lem-trf-etale-completion-congruence)
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

@[expose] public section

universe v

open CategoryTheory

namespace AlgebraicGeometry

/-- Completion comparison and extension of congruence for the actual completed stalk maps.
Source: Stacks Project, Tag 0CAV, proof of lemma-isomorphism-approximation.
(blueprint: lem-trf-etale-completion-congruence)

The named points x and y are written as p u and f u. The structure map of U is p ≫ sX,
and hbase says that f is over S. The coordinate formulas characterize phat and g uniquely;
they are the maps induced by the actual stalk maps, not arbitrary completion maps.

Proof:
1. Apply pqf-lem-locnoeth-lft to X and Y over S. Since p is etale, it is locally
   finitely presented and hence locally of finite type (def-weil-etale-morphism,
   def-sbc-locally-finite-presentation, def-weil-finite-type-morphism); apply the same
   lemma to U over X. Noetherian affine charts (pqf-def-locnoeth), stalk localization
   (lem-weil-pbc-spec-map-stalk-localization), and lem-weil-pbc-localization-noetherian
   make all three stalks Noetherian. Their maximal ideals are finitely generated by
   def-weil-pbc-noetherian-ring.
2. The stalk map of p is local and flat (def-weil-locally-ringed-space-morphism,
   def-weil-flat-morphism). In affine etale charts,
   lem-weil-pbc-etale-prime-generates-maximal identifies the extended source maximal
   ideal with the target maximal ideal. Its residue map is the assumed isomorphism.
3. Apply lem-weil-pbc-flat-local-completion-iso to this actual stalk map. Its coordinate
   description identifies its map with phat, so phat and its composite with phi are
   bijective. By lem-weil-pbc-local-completion-local-ring, D is local with maximal
   ideal n = m_C D, and the source completion is local with maximal ideal a = m_A Ahat.
   The isomorphism alpha = phat composed with phi preserves nonunits and hence sends
   a and a^N onto n and n^N.
4. By lem-weil-pbc-adic-completion-mod-power, choose a representative a in A of the
   Nth coordinate of any z in Ahat. The kernel formula gives z - iota_A(a) in a^N.
5. Locality of the stalk map of f and the coordinate formula for g imply
   g(iota_A(m_A)) is contained in n; expanding ideal generators gives g(a^N) in n^N.
   Write e = z - iota_A(a). Then
   g(z) - alpha(z) = (g(iota_A(a)) - alpha(iota_A(a))) + g(e) - alpha(e).
   The first summand is in m_C^N D = n^N by the hypothesis; both remaining summands
   lie in n^N by steps 3 and 5. This proves the congruence for every z.
-/
theorem etale_completion_congruence
    {S X Y U : Scheme.{v}} [IsLocallyNoetherian S]
    (sX : X ⟶ S) (sY : Y ⟶ S) [LocallyOfFiniteType sX] [LocallyOfFiniteType sY]
    (p : U ⟶ X) [Etale p] (f : U ⟶ Y) (hbase : p ≫ sX = f ≫ sY)
    (u : U) (hres : IsIso (p.residueFieldMap u))
    (phat :
      AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (p u)))
        (X.presheaf.stalk (p u)) →+*
      AdicCompletion (IsLocalRing.maximalIdeal (U.presheaf.stalk u)) (U.presheaf.stalk u))
    (g :
      AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f u)))
        (Y.presheaf.stalk (f u)) →+*
      AdicCompletion (IsLocalRing.maximalIdeal (U.presheaf.stalk u)) (U.presheaf.stalk u))
    (hphat : ∀ (n : ℕ)
      (z : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (p u)))
        (X.presheaf.stalk (p u))) (b : X.presheaf.stalk (p u)),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (X.presheaf.stalk (p u))) n z =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal (X.presheaf.stalk (p u)) ^ n) b →
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (U.presheaf.stalk u)) n (phat z) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal (U.presheaf.stalk u) ^ n)
            ((p.stalkMap u).hom b))
    (hg : ∀ (n : ℕ)
      (z : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f u)))
        (Y.presheaf.stalk (f u))) (a : Y.presheaf.stalk (f u)),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f u))) n z =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f u)) ^ n) a →
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (U.presheaf.stalk u)) n (g z) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal (U.presheaf.stalk u) ^ n)
            ((f.stalkMap u).hom a))
    (phi :
      AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f u)))
        (Y.presheaf.stalk (f u)) ≃+*
      AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (p u)))
        (X.presheaf.stalk (p u)))
    (N : ℕ) (hN : 1 ≤ N)
    (hcongr : ∀ a : Y.presheaf.stalk (f u),
      g (algebraMap _ _ a) - phat (phi (algebraMap _ _ a)) ∈
        Ideal.map (algebraMap (U.presheaf.stalk u)
          (AdicCompletion (IsLocalRing.maximalIdeal (U.presheaf.stalk u))
            (U.presheaf.stalk u))) (IsLocalRing.maximalIdeal (U.presheaf.stalk u) ^ N)) :
    IsLocallyNoetherian Y ∧
    IsNoetherianRing (Y.presheaf.stalk (f u)) ∧
    IsNoetherianRing (X.presheaf.stalk (p u)) ∧
    IsNoetherianRing (U.presheaf.stalk u) ∧
    ∃ hlocal : IsLocalRing
      (AdicCompletion (IsLocalRing.maximalIdeal (U.presheaf.stalk u)) (U.presheaf.stalk u)),
      @IsLocalRing.maximalIdeal
        (AdicCompletion (IsLocalRing.maximalIdeal (U.presheaf.stalk u))
          (U.presheaf.stalk u)) _ hlocal =
        Ideal.map (algebraMap (U.presheaf.stalk u) _)
          (IsLocalRing.maximalIdeal (U.presheaf.stalk u)) ∧
      Function.Bijective phat ∧
      Function.Bijective (phat.comp phi.toRingHom) ∧
      ∀ z : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f u)))
          (Y.presheaf.stalk (f u)),
        g z - phat (phi z) ∈
          (@IsLocalRing.maximalIdeal
            (AdicCompletion (IsLocalRing.maximalIdeal (U.presheaf.stalk u))
              (U.presheaf.stalk u)) _ hlocal) ^ N := by
  sorry

end AlgebraicGeometry
