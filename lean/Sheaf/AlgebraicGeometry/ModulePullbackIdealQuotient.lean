import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import Sheaf.AlgebraicGeometry.TensorPullback
import Sheaf.AlgebraicGeometry.CoherentFormalModule

/-! # Pullback and quotients by extended ideals

Source: Stacks Project, Cohomology of Schemes, proof of Lemma 0887 (blueprint:
lem-weil-pbc-module-pullback-ideal-quotient). The extended ideal `𝒥𝒪_X` is the recorded
`Scheme.IdealSheafData.comap` (def-nagata-extended-ideal); products and quotients are the
shared `Scheme.idealModuleProduct` and `formalModuleQuotient`.
-/

universe v

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

noncomputable section

set_option autoImplicit false

/-- Pullback of a quasi-coherent module modulo an ideal is the quotient by the extended ideal.
Let `f : X ⟶ Y`, `𝒥` a quasi-coherent ideal of `𝒪_Y` and `ℐ = 𝒥𝒪_X = J.comap f`. Then
(1) on affine opens `U ⊆ f⁻¹V`, `ℐ(U)` is the ideal generated by `f^♯(𝒥(V))`;
(2) `(𝒥ⁿ)𝒪_X = ℐⁿ` for `n ≥ 1`; (3) for quasi-coherent `𝒢`, `f^*q_𝒢` is an epimorphism
with kernel `ℐ · f^*𝒢`, and the induced isomorphisms `σ_𝒢 : f^*𝒢/ℐf^*𝒢 ≅ f^*(𝒢/𝒥𝒢)`,
characterised by `p_𝒢 ≫ σ_𝒢 = f^*q_𝒢`, are natural in `𝒢`.
Source: Stacks Project, proof of Lemma 0887
(blueprint: lem-weil-pbc-module-pullback-ideal-quotient).

Proof: on affine opens `f^*` of a quasi-coherent module is the tensor product of sections
(Modules, Lemma 01BG), and the tensor product is right exact (Algebra, Lemma 00DF); this gives
the ideal formula (1), its powers (2), and, applying right exactness of `f^*` (Modules,
Lemma 01AJ) to `𝒥𝒢 → 𝒢 → 𝒢/𝒥𝒢 → 0`, the epimorphism and the kernel `ℐ f^*𝒢` (equality on
the affine basis gives the sheaf statements). The cokernel universal property then gives
`σ_𝒢`, and naturality follows by precomposing with the epimorphism `p_𝒢`. -/
theorem modulePullbackIdealQuotient {X Y : Scheme.{v}} (f : X ⟶ Y)
    (J : Y.IdealSheafData) :
    (∀ (V : Y.affineOpens) (U : X.affineOpens) (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
      (J.comap f).ideal U = Ideal.map (f.appLE V.1 U.1 hUV).hom (J.ideal V)) ∧
    (∀ n : ℕ, 1 ≤ n → (J ^ n).comap f = (J.comap f) ^ n) ∧
    (∀ (G : Y.Modules), G.IsQuasicoherent →
      Epi ((Scheme.Modules.tensorPullback f).map (formalModuleQuotientπ J 1 G)) ∧
      ∃ w : Scheme.idealModuleProductι (J.comap f).toModulesι
            ((Scheme.Modules.tensorPullback f).obj G) ≫
          (Scheme.Modules.tensorPullback f).map (formalModuleQuotientπ J 1 G) = 0,
        Nonempty (IsLimit (KernelFork.ofι _ w))) ∧
    ∃ σ : ∀ (G : Y.Modules), G.IsQuasicoherent →
        (formalModuleQuotient (J.comap f) 1 ((Scheme.Modules.tensorPullback f).obj G) ≅
          (Scheme.Modules.tensorPullback f).obj (formalModuleQuotient J 1 G)),
      (∀ (G : Y.Modules) (hG : G.IsQuasicoherent),
        formalModuleQuotientπ (J.comap f) 1 ((Scheme.Modules.tensorPullback f).obj G) ≫
            (σ G hG).hom =
          (Scheme.Modules.tensorPullback f).map (formalModuleQuotientπ J 1 G)) ∧
      ∀ (G G' : Y.Modules) (hG : G.IsQuasicoherent) (hG' : G'.IsQuasicoherent) (u : G ⟶ G'),
        (σ G hG).hom ≫ (Scheme.Modules.tensorPullback f).map
            (formalModuleQuotientMap J u (Nat.le_refl 1)) =
          formalModuleQuotientMap (J.comap f)
              ((Scheme.Modules.tensorPullback f).map u) (Nat.le_refl 1) ≫ (σ G' hG').hom := by
  sorry

end
end AlgebraicGeometry
