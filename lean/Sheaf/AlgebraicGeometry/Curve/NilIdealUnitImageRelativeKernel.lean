import WeilConjectures.CategoryTheory.Sites.Torsor
import WeilConjectures.SixFunctors.Etale.UpperLowerStar.Defs

/-! # The image of nil-ideal units is the pushforward of the relative unit kernel.

Source: blueprint `lem-sc-brauer-zero-all-curves`, Proof, Step 1 and its Claim;
the affine argument in `lem-sc-nil-ideal-units-additive-image-comparison`.
(blueprint: lem-sc-nil-ideal-unit-image-relative-kernel)
-/

@[expose] public section

universe u
open CategoryTheory Limits
namespace AlgebraicGeometry.Scheme

/-- The image of nil-ideal units is the pushforward of the relative unit kernel.
Source: blueprint `lem-sc-brauer-zero-all-curves`, Proof, Step 1 and its Claim;
the affine argument in `lem-sc-nil-ideal-units-additive-image-comparison`.
(blueprint: lem-sc-nil-ideal-unit-image-relative-kernel)

Proof: Cover each etale X-scheme by affine opens mapping into affine opens of X.
On such an object write B for its ring and I_B,J_B for the extended ideals.
The relative kernel has sections u in (B/J_B)^units whose image in B/I_B is one.
Choose a representative b of u. The kernel condition says b-1 belongs to I_B.
The ideal I_B is nil: it is generated by images of nilpotent elements of I on
an affine open, and sums and multiples of nilpotents are nilpotent in a
commutative ring. Hence b=1+(b-1) is a unit of B. It is congruent to one modulo
I_B and restricts to u. Conversely any such unit restricts to this kernel.
Restriction maps commute with the inclusion of the relative kernel into the
units on the J subscheme. The pushforward preserves kernels, so this gives a
monomorphism into the target sheaf of the displayed composite. The affine
lifting proves its image is exactly the categorical image: images of sheaves
are obtained by sheafifying the sectionwise images. The uniqueness of image
factorizations gives the isomorphism. No square-zero assumption is needed.
When I=J the relative kernel and the image are zero; when I=0 this also holds.
The empty affine object gives a zero ring, for which the lifting still works. -/
theorem nonempty_nilIdealUnitImageRelativeKernelIso (X : Scheme.{u})
    (I J : X.IdealSheafData) (hJI : J ≤ I) (hIN : I ≤ X.nilradical) :
    Nonempty (image (kernel.ι (gmSheafToLowerStarGmSheaf I.subschemeι) ≫
        gmSheafToLowerStarGmSheaf J.subschemeι) ≅
      (Etale.lowerStar AddCommGrpCat.{u + 1} J.subschemeι).obj
        (kernel (gmSheafToLowerStarGmSheaf (IdealSheafData.inclusion hJI)))) := by sorry

end AlgebraicGeometry.Scheme
