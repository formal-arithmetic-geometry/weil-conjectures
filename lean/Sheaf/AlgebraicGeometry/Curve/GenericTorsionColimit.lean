/-! # Finite-stalk approximation for a generic torsion sheaf

Source: blueprint `lem-sc-affine-generic-second`, final proof paragraph.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

/-- A generic torsion sheaf on a qcqs integral scheme is a filtered colimit of finite-stalk
sheaves, and applying generic direct image and cohomology preserves this presentation.
Source: blueprint `lem-sc-affine-generic-second`, final proof paragraph.
(blueprint: lem-sc-generic-torsion-finite-stalk-colimit)

Proof: use the equivalence between abelian etale sheaves on the function field and discrete
continuous Galois modules. Index by finite stable subgroups of the torsion stalk. Every
orbit is finite because the action is continuous and the Galois group is compact. The
subgroup generated by finitely many orbits is finite because its generators are torsion.
Thus these subgroups cover the stalk, are closed under finite sums, and form a filtered
poset. Transport their inclusions and union cocone through the equivalence. Each resulting
sheaf has finite stalk and is torsion; the union cocone is colimit, since the equivalence
preserves colimits. Its indexing type may lie in universe u+1, the universe of the stalk.
The generic-point morphism is affine, hence qcqs. On the qcqs etale basis, its generic
fibres are finite disjoint unions of spectra of finite separable field extensions.
Sections of the direct image are finite products of Galois invariants. Invariants commute
with this filtered union: an element belongs to one of the stable finite subgroups, and
being fixed has the same meaning there as in the union. Consequently generic direct
image preserves the union cocone. Apply the coefficient-sized directed-colimit theorem
`Scheme.etaleCohomology_isColimit_of_isDirected` to this finite-subgroup poset in every
degree q. Transport the resulting derived-cohomology cocone through the natural
`Scheme.nonempty_sheafH_extDerivedIso` comparison. Naturality identifies every coprojection
with its `Sheaf.functorH` image, giving exactly the mapped cocone below. -/
theorem exists_generic_torsion_finite_stalk_cohomology_colimit
    (X : Scheme.{u}) [IsIntegral X] [CompactSpace X] [QuasiSeparatedSpace X]
    (M : Sheaf (Spec X.functionField).smallEtaleTopology AddCommGrpCat.{u + 1})
    (hM : M.IsTorsion) :
    ∃ (I : Type (u + 1)) (_ : SmallCategory I) (_ : IsFiltered I)
      (F : I ⥤ Sheaf (Spec X.functionField).smallEtaleTopology AddCommGrpCat.{u + 1})
      (ι : F ⟶ (Functor.const I).obj M),
      (∀ i, (F.obj i).IsTorsion) ∧
      (∀ i, Finite (((pointSmallEtale
        (Spec.map (CommRingCat.ofHom
          (algebraMap X.functionField (AlgebraicClosure X.functionField))))).sheafFiber
            (A := AddCommGrpCat.{u + 1})).obj (F.obj i))) ∧
      Nonempty (IsColimit (Cocone.mk M ι)) ∧
      ∀ q : ℕ, Nonempty (IsColimit
        (((Etale.lowerStar AddCommGrpCat.{u + 1} X.fromSpecFunctionField) ⋙
          Sheaf.functorH X.smallEtaleTopology q).mapCocone (Cocone.mk M ι))) := by
  obtain ⟨I, hI, hfiltered, F, ι, htor, hfin, hcolim⟩ :=
    exists_generic_torsion_finite_stalk_colimit X M hM
  let _ := hI
  let _ := hfiltered
  refine ⟨I, hI, hfiltered, F, ι, htor, hfin, hcolim, ?_⟩
  exact generic_torsion_cohomology_colimit X M hcolim


end AlgebraicGeometry.Scheme
