module

public import WeilConjectures.AlgebraicGeometry.Curve.Compactification
public import WeilConjectures.AlgebraicGeometry.Curve.Picard
public import Mathlib.GroupTheory.QuotientGroup.Basic
import Sheaf.AlgebraicGeometry.Curve.PicRestrictionExact

/-!
# Restriction of Picard groups across a finite boundary

Source: blueprint, sec-curve-estimates/sk-prop-cd-affine/lem-sc-pic-affine,
restriction and boundary divisors, followed by degree splitting
(blueprint: lem-sc-pic-restriction-boundary).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- Source: blueprint, sec-curve-estimates/sk-prop-cd-affine/lem-sc-pic-affine,
restriction and boundary divisors, followed by degree splitting
(blueprint: lem-sc-pic-restriction-boundary).

Restriction is surjective, with kernel generated by the boundary point classes. For each
boundary point `P₀`, the degree-zero group modulo the differences `[P]/[P₀]` is isomorphic
to the affine Picard group, and the isomorphism is induced by restriction. Picard groups
are written multiplicatively. The ambient smooth connected curve has relative dimension one.

Proof, step 1 (lem-sc-pic-restriction-exact): the divisor-class restriction argument gives
surjectivity and the boundary-generated kernel. This geometric step is isolated in its own
module; it identifies divisor restriction with the specified Picard pullback.
Step 2 (def-sc-pic0): use the degree homomorphism `d`, whose kernel is Pic⁰, and the
existing `picDegreeHom_ofClosedPoint` to see that every boundary generator has degree one.
For `p = [P₀]` put `σ(n) = p^n` and `q(x) = x / σ(d(x))`. Then `d(q(x)) = 1`, `q` is the
identity on the degree-zero subgroup, and restriction sends `q(x)` to the restriction of
`x` because `p` is in its kernel. Thus restriction from Pic⁰ is still surjective.
Step 3: take `G = ker d` and `Λ` to be the kernel of restriction from `G`. Its image in Pic
is `q` of the boundary kernel. `MonoidHom.map_closure` and degree one of the boundary classes
identify this image with the closure of the differences `[P]/[P₀]`.
Step 4: the first isomorphism theorem for the surjection from `G` yields `G/Λ ≃* Pic(C)`.
Its formula on quotient representatives is definitionally the original restriction. -/
theorem Scheme.Hom.pic_restriction_boundary
    {k : Type u} [Field k] [IsAlgClosed k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsConnectedCurve f] [Smooth f] [IsAffine C]
    (c : Compactification f) [IsConnectedCurve c.g]
    [hsm : SmoothOfRelativeDimension 1 c.g] :
    Function.Surjective (Scheme.Pic.mapHom c.i) ∧
      (Scheme.Pic.mapHom c.i).ker = Subgroup.closure
        {L | ∃ P : closedPoints c.Z, P.val ∉ Set.range c.i.base ∧
          L = @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P} ∧
      ∀ (P₀ : closedPoints c.Z), P₀.val ∉ Set.range c.i.base →
        ∃ (G : Subgroup c.Z.Pic) (_ : (G : Set c.Z.Pic) = c.g.picZero)
          (Λ : Subgroup G),
          Subgroup.map G.subtype Λ = Subgroup.closure
            {L | ∃ P : closedPoints c.Z, P.val ∉ Set.range c.i.base ∧
              L = @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P /
                @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P₀} ∧
          ∃ e : (G ⧸ Λ) ≃* C.Pic,
            ∀ L : G, e (QuotientGroup.mk L) = Scheme.Pic.mapHom c.i L.val := by
  classical
  obtain ⟨hr, hker⟩ := f.pic_restriction_exact c
  refine ⟨hr, hker, ?_⟩
  intro P₀ hP₀
  let : c.Z.Over (Spec (.of k)) := ⟨c.g⟩
  have : SmoothOfRelativeDimension 1 (c.Z ↘ Spec (.of k)) := hsm
  have : IsProper (c.Z ↘ Spec (.of k)) := inferInstanceAs (IsProper c.g)
  let r := Scheme.Pic.mapHom c.i
  let d := Scheme.picDegreeHom k c.Z
  let p := @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P₀
  let S : Set c.Z.Pic := {L | ∃ P : closedPoints c.Z,
    P.val ∉ Set.range c.i.base ∧
      L = @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P}
  have hpS : p ∈ S := ⟨P₀, hP₀, rfl⟩
  have hpker : p ∈ r.ker := hker ▸ Subgroup.subset_closure hpS
  have hp : d p = Multiplicative.ofAdd 1 := Scheme.picDegreeHom_ofClosedPoint (k := k) P₀
  have hS (x : c.Z.Pic) (hx : x ∈ S) : d x = Multiplicative.ofAdd 1 := by
    obtain ⟨P, _, rfl⟩ := hx
    exact Scheme.picDegreeHom_ofClosedPoint (k := k) P
  let σ : Multiplicative ℤ →* c.Z.Pic := zpowersHom c.Z.Pic p
  have hσ (n : Multiplicative ℤ) : d (σ n) = n := by
    rw [zpowersHom_apply, map_zpow, hp, ← ofAdd_zsmul,
      smul_eq_mul, mul_one, ofAdd_toAdd]
  let q : c.Z.Pic →* c.Z.Pic := {
    toFun x := x / σ (d x)
    map_one' := by simp
    map_mul' x y := by
      simp only [map_mul, div_eq_mul_inv, mul_inv]
      ac_rfl }
  have hqd (x : c.Z.Pic) : d (q x) = 1 := by
    change d (x / σ (d x)) = 1
    rw [map_div, hσ, div_self']
  have hqr (x : c.Z.Pic) : r (q x) = r x := by
    change r (x / σ (d x)) = r x
    have hrp : r p = 1 := hpker
    simp [σ, hrp]
  have hqid (x : d.ker) : q x.val = x.val := by
    change x.val / σ (d x.val) = x.val
    rw [show d x.val = 1 from x.property, map_one, div_one]
  let t : d.ker →* C.Pic := r.comp d.ker.subtype
  have ht : Function.Surjective t := by
    intro y
    obtain ⟨x, hx⟩ := hr y
    exact ⟨⟨q x, hqd x⟩, (hqr x).trans hx⟩
  have hmap : Subgroup.map d.ker.subtype t.ker = Subgroup.map q r.ker := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y.val, hy, hqid y⟩
    · rintro ⟨y, hy, rfl⟩
      refine ⟨⟨q y, hqd y⟩, ?_, rfl⟩
      change r (q y) = 1
      exact (hqr y).trans hy
  have himage : q '' S = {L | ∃ P : closedPoints c.Z,
      P.val ∉ Set.range c.i.base ∧
        L = @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P / p} := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      obtain ⟨P, hP, hPy⟩ := hy
      refine ⟨P, hP, ?_⟩
      change y / σ (d y) = _
      rw [hS y ⟨P, hP, hPy⟩]
      simp [σ, hPy]
    · rintro ⟨P, hP, rfl⟩
      let y := @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P
      refine ⟨y, ⟨P, hP, rfl⟩, ?_⟩
      change y / σ (d y) = y / p
      rw [hS y ⟨P, hP, rfl⟩]
      simp [σ]
  refine ⟨d.ker, Scheme.coe_ker_picDegreeHom (k := k) (C := c.Z), t.ker, ?_,
    QuotientGroup.quotientKerEquivOfSurjective t ht, ?_⟩
  · rw [hmap, hker, MonoidHom.map_closure, himage]
  · intro L
    rfl

end AlgebraicGeometry
