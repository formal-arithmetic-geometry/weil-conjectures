module

public import WeilConjectures.AlgebraicGeometry.Curve.Compactification
public import WeilConjectures.AlgebraicGeometry.Curve.Picard
import Sheaf.AlgebraicGeometry.DivisorClassCurve

/-!
# Exactness of Picard restriction at the boundary

Source: blueprint, sec-curve-estimates/sk-prop-cd-affine/lem-sc-pic-affine,
first paragraph, restriction and boundary divisors
(blueprint: lem-sc-pic-restriction-exact).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- Source: blueprint, sec-curve-estimates/sk-prop-cd-affine/lem-sc-pic-affine,
first paragraph, restriction and boundary divisors
(blueprint: lem-sc-pic-restriction-exact).

Proof:
1. Apply the divisor-class comparison `lem-sc-divisor-class-curve` to the smooth
   connected curves C and c.Z. Restriction of divisors forgets boundary coefficients.
   Every divisor on C extends by zero, so this restriction is surjective.
2. The dense open immersion identifies the function fields. The valuation at a point
   of C is unchanged, so principal divisors restrict to principal divisors.
3. If a divisor restricts to div(f), subtract div(f) on c.Z. The resulting divisor
   is supported on the boundary. Conversely each boundary divisor restricts to zero.
   Therefore the kernel on divisor classes is generated by the boundary point classes.
4. The divisor-class comparison sends D to O(D). Pullback of O(D) to C equals
   O(D restricted to C): both modules inside the common rational function field have
   the same valuation bounds at every point of C. Consequently the divisor-class map
   is Scheme.Pic.mapHom c.i, and the class of a boundary point is Pic.ofClosedPoint.
   This proves both assertions. No choice of boundary point or degree splitting is used.

Edge cases: the argument also works for empty boundary (restriction is an isomorphism);
no nonemptiness of the boundary is required. -/
theorem Scheme.Hom.pic_restriction_exact
    {k : Type u} [Field k] [IsAlgClosed k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsConnectedCurve f] [Smooth f] [IsAffine C]
    (c : Compactification f) [IsConnectedCurve c.g]
    [hsm : SmoothOfRelativeDimension 1 c.g] :
    Function.Surjective (Scheme.Pic.mapHom c.i) ∧
      (Scheme.Pic.mapHom c.i).ker = Subgroup.closure
        {L | ∃ P : closedPoints c.Z, P.val ∉ Set.range c.i.base ∧
          L = @Scheme.Pic.ofClosedPoint k _ c.Z ⟨c.g⟩ hsm P} := by sorry

end AlgebraicGeometry
