/-! # Constructibility reflected by finite direct image on curves

Source: Stacks Project, Tags 095K, 0959, 04DZ, and 095G;
finite direct-factor refinement of the argument for Tag 0A5D.
(blueprint: p2-finite-pushforward-module-constructible-reflection)
-/

@[expose] public section
universe u
open CategoryTheory
namespace AlgebraicGeometry
variable (Λ : Type (u + 1)) [CommRing Λ]

/-- Finite generation descends through the finite direct-image counit. -/
private theorem finite_module_stalks {X Y : Scheme.{u}} (f : X ⟶ Y) [IsFinite f]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))
    (h : Scheme.IsFiniteSheaf ((Etale.lowerStar (ModuleCat.{u + 1} Λ) f).obj F)) :
    Scheme.IsFiniteSheaf F := by
  let G := (Etale.lowerStar (ModuleCat.{u + 1} Λ) f).obj F
  let beta := (Etale.upperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) f).counit.app F
  have : Epi beta := finite_counit_epi f Λ F
  have : Scheme.IsFiniteSheaf G := h
  have hmid := Scheme.IsFiniteSheaf.upperStar f G
  refine ⟨fun Ω _ _ s ↦ ?_⟩
  have : CategoryTheory.Limits.HasLimitsOfSize.{u, u} (ModuleCat.{u + 1} Λ) :=
    CategoryTheory.Limits.hasLimitsOfSizeShrink.{u, u, u + 1, u + 1} _
  have : ((Scheme.pointSmallEtale s).sheafFiber
      (A := ModuleCat.{u + 1} Λ)).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_adjunction
      ((Scheme.pointSmallEtale s).skyscraperSheafAdjunction)
  have hsurj := (ModuleCat.epi_iff_surjective
    ((Scheme.pointSmallEtale s).sheafFiber.map beta)).mp inferInstance
  have hfg : Module.Finite Λ
      (((Scheme.pointSmallEtale s).sheafFiber
        (A := ModuleCat.{u + 1} Λ)).obj
        ((Etale.upperStar (ModuleCat.{u + 1} Λ) f).obj G)) :=
    (ModuleCat.isFinitelyGenerated_iff _).mp (hmid.isFinitelyGenerated_sheafFiber Ω s)
  exact (ModuleCat.isFinitelyGenerated_iff _).mpr
    (Module.Finite.of_surjective (hM := hfg)
      ((Scheme.pointSmallEtale s).sheafFiber.map beta).hom hsurj)

/-- Finite direct image reflects module constructibility on Noetherian curves.
Source: Stacks Project, Tags 095K (finite morphism stratification), 0959 (finite
base change), 095G (pullback), and 0A5D (the assertion-transfer argument).
(blueprint: p2-finite-pushforward-module-constructible-reflection)

Proof: Reduce Y using topological invariance and choose disjoint affine dense
opens of its one-dimensional irreducible components; the complement is a finite
set of closed points. Shrink these opens so f_*F is finite locally constant,
using its constructible stratification. On each such Spec A the source is
Spec B for a finite A-algebra B. Apply the generic finite-algebra splitting
lemma (lem-weil-pbc-generic-finite-algebra-splitting): after a further principal
shrinking and a surjective finite etale base change U, the reduced source is
a finite disjoint union of schemes universally homeomorphic to U. Finite base
change identifies the direct image on U with the pullback of f_*F, hence it is
finite locally constant. Under topological invariance each source component
sheaf corresponds to a direct summand of this direct-image module sheaf on U.
A direct summand of a finite locally constant module sheaf is finite locally
constant over any ring: trivialize the ambient sheaf with value a finitely
generated module M; its summand projector is locally a constant idempotent,
since its values on finitely many generators are locally constant. The image
of that constant idempotent is finitely generated, generated by the images of
the generators, and gives a constant sheaf. Local constancy descends along the
etale trivializing covers. Topological invariance transports this to each
source component, and the etale cover induced by U descends local constancy
to the source over the dense open. Source stalks are finitely generated by
the finite-stalk direct-factor formula. Above the finitely many omitted closed points, X is
a finite union of artinian local schemes with residue field k. Their etale sites
are those of algebraically closed points, and the finite stalk formula makes
F's stalks direct summands of the finitely generated direct-image stalks.
These restrictions are therefore finite constant. Together these finitely many
constructible locally closed source strata prove constructibility of F.
The zero sheaf, empty source, empty fibres, and degree-one finite maps are
included. Neither torsion nor Noetherianity of the coefficient ring is used. -/
theorem Scheme.isConstructibleSheaf_of_finite_lowerStar_module
    {k : Type u} [Field k] [IsAlgClosed k] {X Y : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Spec (.of k)) [IsCurve g] [IsFinite f]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))
    (h : Scheme.IsConstructibleSheaf
      ((Etale.lowerStar (ModuleCat.{u + 1} Λ) f).obj F)) :
    Scheme.IsConstructibleSheaf F := by
  have hfinite : Scheme.IsFiniteSheaf F := finite_module_stalks Λ f F h.isFiniteSheaf
  obtain ⟨S, hS⟩ :=
    Scheme.exists_locallyConstant_stratification_of_finite_lowerStar_module Λ f g F h
  refine ⟨S, fun i ↦ ?_⟩
  exact
    { toIsLocallyConstantSheaf := hS i
      toIsFiniteSheaf := Scheme.IsFiniteSheaf.upperStar (S.immersion i) F }
end AlgebraicGeometry
