/-!
# Compatible fs charts for a logarithmic cospan

Source: Illusie--Laszlo--Orgogozo, VI 1.1 and 3.7(a), printed pp. 69 and 75;
X, proof of Theorem 3.5, Step 6, printed p. 164
(blueprint: lem-per-cospan-compatible-fs-charts).

The arbitrary-morphism refinement is the node's agent-supplied finite-unit argument.
The two legs use the existing `FSLogChart` interface. Equalities identify their
common target chart; they do not identify unrelated charts by an arbitrary isomorphism.
Monoids are written multiplicatively, so the pushout generators use `1` in place of `0`.
No smoothness or Kummer condition is imposed.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- Two compatible chart squares with exactly the same target chart, and affine
etale neighbourhoods over the two base changes. Source: ILO VI 1.1, X 3.5 Step 6;
the arbitrary-morphism refinement is agent supplied
(blueprint: lem-per-cospan-compatible-fs-charts). -/
structure FSLogCospanChart {X Y Z : FineSaturatedLogScheme.{u}}
    (f : EtaleLogHom X Z) (g : EtaleLogHom Y Z) where
  left : FSLogChart f
  right : FSLogChart g
  commonBase : right.W = left.W
  commonP : left.P = right.P
  commonMonoid : HEq left.instP right.instP
  commonChart : HEq left.chartY right.chartY
  affineBase : IsAffine left.W.left
  affineLeft : IsAffine left.V.left
  affineRight : IsAffine right.V.left
  etaleLeft : Etale (pullback.lift left.V.hom left.map left.map_over.symm)
  etaleRight : Etale (pullback.lift right.V.hom right.map right.map_over.symm)

/-- The second chart's map to the common target neighbourhood. Only equality
transport is used. Source: ILO X 3.5 Step 6
(blueprint: lem-per-cospan-compatible-fs-charts). -/
def FSLogCospanChart.rightMap {X Y Z : FineSaturatedLogScheme.{u}}
    {f : EtaleLogHom X Z} {g : EtaleLogHom Y Z} (c : FSLogCospanChart f g) :
    c.right.V.left ⟶ c.left.W.left :=
  c.right.map ≫ eqToHom (congrArg (fun T : Z.scheme.Etale ↦ T.left) c.commonBase)

/-- The monoid pushout congruence: the least monoid congruence generated by
`(h(p),1) ~ (1,k(p))`. Source: ILO X 3.5 Step 6
(blueprint: lem-per-cospan-compatible-fs-charts). -/
def FSLogCospanChart.pushoutCongruence {X Y Z : FineSaturatedLogScheme.{u}}
    {f : EtaleLogHom X Z} {g : EtaleLogHom Y Z} (c : FSLogCospanChart f g) :
    Con (c.left.Q × c.right.Q) :=
  conGen (fun a b ↦ ∃ p : c.left.P,
    a = (c.left.g p, 1) ∧ b = (1, c.right.g (cast c.commonP p)))

/-- The actual quotient monoid pushout, with no integrality or saturation imposed.
Source: ILO X 3.5 Step 6
(blueprint: lem-per-cospan-compatible-fs-charts). -/
abbrev FSLogCospanChart.monoidPushout {X Y Z : FineSaturatedLogScheme.{u}}
    {f : EtaleLogHom X Z} {g : EtaleLogHom Y Z} (c : FSLogCospanChart f g) :=
  c.pushoutCongruence.Quotient

/-- One affine Noetherian open of a common chart product. The map to the ordinary
fibre product is fixed by both projections, hence is its canonical structural map.
Affineness identifies `H` canonically with the spectrum of its section ring.
Source: ILO VI 1.1, X 3.5 Step 6 and Stacks 01OV
(blueprint: lem-per-cospan-compatible-fs-charts). -/
structure FSLogCospanNeighbourhood {X Y Z : FineSaturatedLogScheme.{u}}
    (f : EtaleLogHom X Z) (g : EtaleLogHom Y Z) extends FSLogCospanChart f g where
  H : Scheme.{u}
  affine : IsAffine H
  noetherian : IsNoetherianRing Γ(H, ⊤)
  inclusion : H ⟶ pullback left.map toFSLogCospanChart.rightMap
  openImmersion : IsOpenImmersion inclusion
  toBase : H ⟶ pullback f.base g.base
  fst_eq : toBase ≫ pullback.fst f.base g.base =
    inclusion ≫ pullback.fst left.map toFSLogCospanChart.rightMap ≫ left.V.hom
  snd_eq : toBase ≫ pullback.snd f.base g.base =
    inclusion ≫ pullback.snd left.map toFSLogCospanChart.rightMap ≫ right.V.hom
  etale : Etale toBase

/-- Compatible fs charts exist for an arbitrary cospan, cover the ordinary product
by affine Noetherian etale neighbourhoods, admit finite subcovers over affine opens,
and give a singleton fpqc cover after taking the scheme coproduct. The quotient map
is normalized on every pair of chart elements. Strict legs use the identical target
monoid, identity chart map, and (by `FSLogChart.chart_compatibility`) the pulled-back
chart. Source: ILO VI 1.1 and 3.7(a), pp. 69 and 75; X 3.5 Step 6, p. 164;
the arbitrary-morphism refinement and finite-unit-coordinate argument are agent supplied
(blueprint: lem-per-cospan-compatible-fs-charts).

Proof:
1. At each geometric point of the ordinary product, choose a pointed affine etale
fs target chart `P`. Pull back its neighbourhood to each source. Etale base change,
local finite presentation and Noetherian ascent preserve local Noetherianity.
2. Choose an fs source chart `S`. Localize at the face mapping to units. Chart-face
localization and fs face sharpening give an fs monoid `T` with units `G`, sharp fs
quotient `C`, and free finite-rank group completion `C^gp`.
3. Lift a basis of `C^gp` into `S^gp`. The resulting section lands in `T` because its
difference from any lift of `c` lies in `G`. Thus `T = C × G`, and the stalk log
structure has coordinates `C × Aˣ` by chart-face localization.
4. Express the actual images of `P` as `b(v(p))u(p)`. Let `V` be the subgroup of
units generated by the finitely many `u(p_i)` for generators of `P`. Then `Q = C × V`
is fs; its logification is `C × Aˣ`, and `h(p) = (v(p),u(p))` represents the actual
log morphism, including all unit factors, without extracting roots of units.
5. Spread the specified stalk chart using the fine-log stalk-chart spreading lemma.
Spread the equality of the two `P` section maps using finite-monoid stalk-data
spreading. The associated-log universal property gives equality of the actual log
maps on chart sections and units.
6. Repeat for the other source while retaining the identical target chart. On each
strict leg use the pulled-back `P` chart and its identity homomorphism instead.
Etale composition and affine shrinking preserve all chart data.
7. Form the affine product of the two source neighbourhoods over the common target
neighbourhood. Its map to the ordinary product is etale by base change and composition.
The chosen geometric points lift to this product. Choose an affine Noetherian open
about their common lift, using local Noetherianity of the ordinary product. These
neighbourhoods cover all geometric points and hence all underlying points.
8. The structural images of `h(p)` and `k(p)` agree. Multiplication of the two chart
structural images therefore descends through precisely the generated congruence,
giving the normalized homomorphism from the actual quotient monoid pushout.
9. Include affine Noetherian refinements over every affine open of the ordinary
product. Etale images are open and affine opens are quasi-compact, so finitely many
such neighbourhoods, with images contained in that affine open, cover it.
10. Take the scheme coproduct. Its components are disjoint opens, so its map is flat
at every point. The same finite affine opens verify the singleton fpqc covering
condition. For the empty ordinary product take the empty family and empty coproduct.
The strict choices on the two legs can be made simultaneously.
-/
theorem EtaleLogHom.exists_cospan_compatible_fs_charts
    {X Y Z : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Z) (g : EtaleLogHom Y Z)
    [IsLocallyNoetherian (pullback f.base g.base)] :
    ∃ (I : Type u) (C : I → FSLogCospanNeighbourhood f g),
      (∀ w : ↥(pullback f.base g.base), ∃ (a : I) (x : (C a).H), (C a).toBase x = w) ∧
      (∀ U : (pullback f.base g.base).Opens, IsAffineOpen U →
        ∃ (n : ℕ) (a : Fin n → I),
          (⋃ j : Fin n, Set.range (C (a j)).toBase) = (U : Set ↥(pullback f.base g.base))) ∧
      (Presieve.singleton (Sigma.desc (fun a : I ↦ (C a).toBase)) ∈
        Scheme.fpqcPrecoverage (pullback f.base g.base)) ∧
      (∀ a : I,
        ∃ φ : (C a).toFSLogCospanChart.monoidPushout →* Γ((C a).H, ⊤),
          ∀ (q : (C a).left.Q) (r : (C a).right.Q),
            φ ((C a).toFSLogCospanChart.pushoutCongruence.mk' (q, r)) =
              ((C a).inclusion ≫ pullback.fst (C a).left.map
                (C a).toFSLogCospanChart.rightMap).appTop
                  (X.logStructure.alpha.app (op (C a).left.V) ((C a).left.chartX q)) *
              ((C a).inclusion ≫ pullback.snd (C a).left.map
                (C a).toFSLogCospanChart.rightMap).appTop
                  (Y.logStructure.alpha.app (op (C a).right.V) ((C a).right.chartX r))) ∧
      (∀ a : I,
        (f.IsStrict → (C a).left.Q = (C a).left.P ∧
          HEq (C a).left.instQ (C a).left.instP ∧
          HEq (C a).left.g (MonoidHom.id (C a).left.P)) ∧
        (g.IsStrict → (C a).right.Q = (C a).right.P ∧
          HEq (C a).right.instQ (C a).right.instP ∧
          HEq (C a).right.g (MonoidHom.id (C a).right.P))) := by
  sorry

end AlgebraicGeometry
