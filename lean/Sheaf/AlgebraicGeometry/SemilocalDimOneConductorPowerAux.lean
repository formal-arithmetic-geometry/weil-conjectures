module
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Spectrum.Maximal.Defs
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import Mathlib.RingTheory.Jacobson.Ideal
public import Mathlib.RingTheory.KrullDimension.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
import Sheaf.AlgebraicGeometry.IntegralOverringJacobsonPower
import Sheaf.AlgebraicGeometry.AdjoinFiniteFractionSpec

/-! Auxiliary finite adjoin construction for the conductor-power argument.

Source: literature/stacks-project/varieties.tex, Varieties Lemma 09N2.
(blueprint: semilocal-dim-one-conductor-power-aux)
-/

@[expose] public section
universe u v

set_option linter.unusedVariables false in
/-- The finite intermediate subalgebra generated by two integral-closure elements has
fraction field `K`, contains both generators, and a positive power of `x` lies in the
extension of the base Jacobson radical. This is exactly the adjoin and lying-over part
of the proof of Varieties Lemma 09N2; its proof constructs the adjoin subalgebra, proves
module finiteness by `Algebra.finite_adjoin_of_finite_of_isIntegral`, proves its fraction
field is `K` because it contains `B`, and applies the integral-overring Jacobson theorem
to the inclusions into `integralClosure B K`.

(blueprint: semilocal-dim-one-conductor-power-aux)

Proof: construct the subalgebra generated by `x` and `y`; integrality gives module
finiteness and the fraction-field instance. Apply the integral-overring Jacobson-power
result to obtain the positive power and its membership in the mapped Jacobson ideal.
-/
theorem exists_finite_adjoin_with_jacobson_power
    (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B]
    [Finite (MaximalSpectrum B)] (hdim : ringKrullDim B = 1)
    (K : Type v) [Field K] [Algebra B K] [IsFractionRing B K]
    [Finite (MaximalSpectrum (integralClosure B K))]
    (x y : integralClosure B K)
    (hx : x ∈ Ideal.jacobson (⊥ : Ideal (integralClosure B K))) :
    ∃ A : Subalgebra B K, Module.Finite B A ∧ IsFractionRing A K ∧
      (x : K) ∈ A ∧ (y : K) ∈ A ∧
      ∃ m : ℕ, 0 < m ∧ ∃ a : A,
        (a : K) = (x : K) ^ m ∧
        a ∈ Ideal.map (algebraMap B A) (Ideal.jacobson (⊥ : Ideal B)) := by
  obtain ⟨A, hfin, hfrac, hxm, hym, g, hg_inj, hg_val, hg_compat, hspec⟩ :=
    exists_adjoin_finite_fraction_spec B K x y
  let algebraA : Algebra A (integralClosure B K) := g.toAlgebra
  let tower : IsScalarTower B A (integralClosure B K) :=
    IsScalarTower.of_algebraMap_eq fun b => (hg_compat b).symm
  let faithful : FaithfulSMul A (integralClosure B K) :=
    ⟨fun {_ _} h => hg_inj (by
      have hh := h 1
      rw [Algebra.smul_def, Algebra.smul_def, mul_one, mul_one] at hh
      exact hh)⟩
  let integral : Algebra.IsIntegral B (integralClosure B K) :=
    ⟨integralClosure.isIntegral⟩
  obtain ⟨_, hrad, hp⟩ := integral_overring_jacobson_power B A
    (integralClosure B K) hspec
  have hgx : g (⟨x, hxm⟩ : A) = x := Subtype.ext (hg_val _)
  obtain ⟨m, hm, ha⟩ := hp (⟨x, hxm⟩ : A) (by
    change g (⟨x, hxm⟩ : A) ∈ Ideal.jacobson (⊥ : Ideal (integralClosure B K))
    rw [hgx]
    exact hx)
  refine ⟨A, hfin, hfrac, hxm, hym, m, hm, ?_⟩
  refine ⟨(⟨x, hxm⟩ : A) ^ m, ?_, ?_⟩
  · rfl
  · exact ha
