module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import Sheaf.CategoryTheory.SemisimplicialRingedTotalCategory
public import Sheaf.AlgebraicGeometry.SpaceCotangentRingMap
public import Sheaf.AlgebraicGeometry.AlgebraicSpaceCommAlgebraSheaf
public import Sheaf.AlgebraicGeometry.SpaceFlatDirectImageBaseChange
public import WeilConjectures.CategoryTheory.DerivedCategory.RightDerivedFunctor.Defs

/-! # Scheme-chart presentation of the face ringed total category

Source: Stacks Project, spaces-simplicial.tex, Tags 09WC, 09WF, 0D70 and 0D72,
with the injective-order-map adaptation
(blueprint: def-sfb-space-face-ringed-total-site).

Scheme objects are a basis of the recorded enlarged etale sites. This presentation
retains the original coefficient and module universe independently of the site size.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option synthInstance.maxSize 4096
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.AlgebraicSpace.SpaceFace

variable {S : Scheme.{u}} {Z : AlgebraicSpace S}

/-- The actual presheaf diagram restricted to injective order maps.
Source: Stacks 09WC (blueprint: def-sfb-space-face-ringed-total-site). -/
def diagram (U : SimplicialObject (Over Z)) :
    SemiSimplexCategoryᵒᵖ ⥤ (Over S)ᵒᵖ ⥤ Type u where
  obj n := (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.obj.obj
  map a := (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left.hom.hom

/-- Total objects are etale scheme charts in a degree; morphisms are commuting
squares over an injective order map. Source: Stacks 09WC, 09WF
(blueprint: def-sfb-space-face-ringed-total-site). -/
abbrev Charts (U : SimplicialObject (Over Z)) :=
  ObjectProperty.FullSubcategory
    (fun A : Comma (yoneda (C := Over S)) (diagram U) ↦ IsEtale A.hom)

/-- Inclusion of the scheme charts in one degree.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site). -/
def fibre (U : SimplicialObject (Over Z)) (n : SemiSimplexCategoryᵒᵖ) :
    (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.EtaleSite ⥤ Charts U where
  obj V := ⟨⟨V.obj.left, n, V.obj.hom⟩, V.property⟩
  map a := ObjectProperty.homMk
    { left := a.hom.left
      right := 𝟙 n
      w := by simp }

/-- The topology generated by all vertical covering sieves of the etale fibres.
Source: Stacks 09WC (blueprint: def-sfb-space-face-ringed-total-site). -/
def topology (U : SimplicialObject (Over Z)) : GrothendieckTopology (Charts U) :=
  sInf {J | ∀ (n : SemiSimplexCategoryᵒᵖ)
    (V : (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.EtaleSite)
    (R : Sieve V),
    R ∈ (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.etaleTopology V →
      R.functorPushforward (fibre U n) ∈ J ((fibre U n).obj V)}

/-- The underlying chart scheme. Source: Stacks 09WC
(blueprint: def-sfb-space-face-ringed-total-site). -/
def scheme (U : SimplicialObject (Over Z)) : Charts U ⥤ Scheme.{u} :=
  ObjectProperty.ι _ ⋙ Comma.fst _ _ ⋙ Over.forget S

/-- The regular-functions ring presheaf, with no coefficient lift.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site). -/
def ringPresheaf (U : SimplicialObject (Over Z)) : (Charts U)ᵒᵖ ⥤ RingCat.{u} :=
  (scheme U).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat RingCat

/-- Regular functions glue on vertical covers, including empty covers.
Source: Stacks 09WF, 0D72 (blueprint: def-sfb-space-face-ringed-total-site).
Proof: in each degree this is the sheaf condition of the existing structure sheaf.
The topology is generated by these covers. Pullback along a general total arrow is
computed by fibre product on the enlarged etale site, where etale covers are stable
under base change. The generating-cover criterion therefore proves the assertion. -/
theorem ringPresheaf_isSheaf (U : SimplicialObject (Over Z)) :
    Presheaf.IsSheaf (topology U) (ringPresheaf U) := by
  sorry

/-- The total ring sheaf of actual regular functions.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site). -/
def rings (U : SimplicialObject (Over Z)) : Sheaf (topology U) RingCat.{u} :=
  ⟨ringPresheaf U, ringPresheaf_isSheaf U⟩

/-- Total modules with the original section universe.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site). -/
abbrev Modules (U : SimplicialObject (Over Z)) := SheafOfModules.{u} (rings U)

/-- Fibre restriction is continuous.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site).
Proof: restriction of a total sheaf satisfies every vertical sheaf condition by the
very definition of the generated topology. Apply the continuous-functor criterion. -/
@[instance] theorem fibre_continuous (U : SimplicialObject (Over Z))
    (n : SemiSimplexCategoryᵒᵖ) :
    (fibre U n).IsContinuous
      (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.etaleTopology
      (topology U) := by
  sorry

/-- Literal component restriction, with the identity regular-functions map.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site). -/
def evaluation (U : SimplicialObject (Over Z)) (n : SemiSimplexCategoryᵒᵖ) :
    Modules U ⥤ (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.Modules :=
  SheafOfModules.pushforward (F := fibre U n) ⟨𝟙 _⟩

/-- The cartesian lift of a chart through a face, written as its commuting square.
Source: Stacks 09WF (blueprint: def-sfb-space-face-ringed-total-site). -/
def chartArrow (U : SimplicialObject (Over Z))
    {n m : SemiSimplexCategoryᵒᵖ} (a : n ⟶ m)
    (V : (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).left.EtaleSite)
    (q : ModuleChart (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left V) :
    (fibre U n).obj q.left ⟶ (fibre U m).obj V :=
  ObjectProperty.homMk
    { left := q.hom.left
      right := a
      w := q.hom.w }

/-- A component transition is characterized on all tensor generators by the actual
restriction along its total chart square. Source: Stacks 09WF, 0D72
(blueprint: def-sfb-space-face-ringed-total-site). -/
def TransitionNormalized (U : SimplicialObject (Over Z)) (M : Modules U)
    {n m : SemiSimplexCategoryᵒᵖ} (a : n ⟶ m)
    (t : (moduleTensorPullback
      (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left).obj
        ((evaluation U m).obj M) ⟶ (evaluation U n).obj M) : Prop :=
  ∀ (V : (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).left.EtaleSite)
    (q : ModuleChart (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left V)
    (b : (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).left.structureSheaf.obj.obj
      (op q.left)) (s : ((evaluation U m).obj M).val.obj (op V)),
    t.val.app (op q.left)
        (moduleTensorSection (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left
          ((evaluation U m).obj M) V q b s) =
      b • M.val.map (chartArrow U a V q).op s

/-- Total restriction determines a unique linear tensor transition.
Source: Stacks 03D7, 09WF, 0D72
(blueprint: def-sfb-space-face-ringed-total-site).
Proof: total restriction is semilinear for pullback of regular functions. The tensor
universal property therefore gives the displayed linear map, with the scalar formula.
These maps glue on charts by functoriality of restrictions. Every local section of
tensor pullback is locally a sum of pure tensors, proving uniqueness. -/
theorem transition_existsUnique (U : SimplicialObject (Over Z)) (M : Modules U)
    {n m : SemiSimplexCategoryᵒᵖ} (a : n ⟶ m) :
    ∃! t : (moduleTensorPullback
      (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left).obj
        ((evaluation U m).obj M) ⟶ (evaluation U n).obj M,
      TransitionNormalized U M a t := by
  sorry

/-- The actual tensor transition, fixed uniquely by total restrictions.
Source: Stacks 0D72 (blueprint: def-sfb-space-face-ringed-total-site). -/
def transition (U : SimplicialObject (Over Z)) (M : Modules U)
    {n m : SemiSimplexCategoryᵒᵖ} (a : n ⟶ m) :=
  (transition_existsUnique U M a).choose

/-- The canonical augmentation comparison, with tensor-normalized composition.
Source: Stacks 03D7, 0D70
(blueprint: def-sfb-space-face-ringed-total-site). -/
def augmentationComparison (U : SimplicialObject (Over Z))
    {n m : SemiSimplexCategoryᵒᵖ} (a : n ⟶ m) :
    moduleTensorPullback (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).hom ⋙
        moduleTensorPullback (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left ≅
      moduleTensorPullback (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).hom :=
  moduleTensorComposition (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left
      (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).hom ≪≫
    eqToIso (congrArg moduleTensorPullback
      (Over.w (U.map (SemiSimplexCategory.toSimplexCategory.op.map a))))

/-- A presentation of the actual total augmentation. The component coordinates and
restriction formula determine inverse image on every object and every total arrow.
Its right adjoint and unit are consequently specified up to their unique adjunction
comparison. In particular no arbitrary map or unnormalized pullback is allowed.
Source: Stacks 09WF, 0D70, 0D72
(blueprint: def-sfb-space-face-ringed-total-site). -/
structure Augmentation (U : SimplicialObject (Over Z)) where
  inverse : Z.Modules ⥤ Modules U
  direct : Modules U ⥤ Z.Modules
  [inverse_additive : inverse.Additive]
  [direct_additive : direct.Additive]
  adjunction : inverse ⊣ direct
  component : ∀ n : SemiSimplexCategoryᵒᵖ,
    inverse ⋙ evaluation U n ≅
      moduleTensorPullback (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj n)).hom
  restriction : ∀ (G : Z.Modules) {n m : SemiSimplexCategoryᵒᵖ} (a : n ⟶ m)
    (V : (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).left.EtaleSite)
    (q : ModuleChart (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left V)
    (s : ((moduleTensorPullback
      (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).hom).obj G).val.obj (op V)),
    ((component n).hom.app G).val.app (op q.left)
        ((inverse.obj G).val.map (chartArrow U a V q).op
          (((component m).inv.app G).val.app (op V) s)) =
      ((augmentationComparison U a).hom.app G).val.app (op q.left)
        (moduleTensorSection (U.map (SemiSimplexCategory.toSimplexCategory.op.map a)).left
          ((moduleTensorPullback
            (U.obj (SemiSimplexCategory.toSimplexCategory.op.obj m)).hom).obj G) V q 1 s)

attribute [instance] Augmentation.inverse_additive Augmentation.direct_additive

/-- The scheme-chart presentation has the canonical ringed total augmentation.
Source: Stacks 09WF, 0D70, 0D72
(blueprint: def-sfb-space-face-ringed-total-site).
Proof: on components take the existing tensor pullbacks. The transition along a
chart square is insertion of one followed by tensor reassociation. The normalization
of moduleTensorComposition gives identity and composition on generators, hence on
all local sections. The fibre sheaf conditions glue to the total sheaf condition.
For a total module, take the all-arrow equalizer of products of component direct
images. The ordinary tensor adjunction identifies maps into this equalizer with
compatible component maps, proving the adjunction. These are the same constructions
as semisimplicial_ringed_total_category after restriction to the scheme basis of each
enlarged etale site. No coefficient universe is changed. -/
theorem augmentation_exists (U : SimplicialObject (Over Z)) :
    Nonempty (Augmentation U) := by
  sorry

/-- Additive sheafification on the concrete face site in the original universe.
Source: Stacks 09WF, 0D72
(blueprint: def-sfb-space-face-ringed-total-site).
Proof: each scheme-chart fibre has a small affine basis in universe u. Their countable
union is a small basis for the face total site. Two plus constructions on this basis
give additive sheafification. Transfer along the basis comparison; kernels are
sectionwise, so sheafification preserves finite limits. -/
@[instance] theorem modules_sheafify (U : SimplicialObject (Over Z)) :
    HasSheafify (topology U) AddCommGrpCat.{u} := by
  sorry

/-- Sheafification inverts exactly the locally bijective maps on the concrete total site.
Source: Stacks 09WF, 0D72
(blueprint: def-sfb-space-face-ringed-total-site).
Proof: work on the small affine basis of modules_sheafify. The sheafification unit is
locally bijective; locally bijective maps induce bijections of the glued sections.
The converse follows by local representatives and local equality in the plus
construction. The comparison with the full scheme-chart site preserves this property. -/
@[instance] theorem modules_localBijective (U : SimplicialObject (Over Z)) :
    (topology U).WEqualsLocallyBijective AddCommGrpCat.{u} := by
  sorry

/-- K-injective resolutions on the concrete face total site.
Source: Stacks 079P, 0D72
(blueprint: def-sfb-space-face-ringed-total-site).
Proof: the small basis in the proof of modules_sheafify gives a set of free module
sheaf generators; filtered colimits are exact. Thus the module category is
Grothendieck abelian and the unbounded K-injective resolution theorem applies. -/
@[instance] theorem modules_kInjectives (U : SimplicialObject (Over Z)) :
    CategoryTheory.Abelian.HasKInjectiveResolutions (Modules U) := by
  sorry

end AlgebraicGeometry.AlgebraicSpace.SpaceFace
