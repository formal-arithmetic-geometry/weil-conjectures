module

public import Sheaf.AlgebraicGeometry.LogDifferentialStalk
public import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# The canonical logarithmic cotangent comparison at a geometric point

Source: ILO, Exposé X, proof of Proposition 1.2, printed p.138; Kato (1988), §3.12
(blueprint: def-per-log-cotangent-comparison).

The comparison is given by its graph, generated by the prescribed pairs of ordinary
and logarithmic symbols. This avoids choosing a map on stalk presentations. Its source
is the balanced scalar extension of the existing logarithmic differential module.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry
namespace EtaleLogHom

/-- The residue ring of the geometric local ring: quotient by its nonunits, which
form its maximal ideal. No choice of a field or of an embedding into the geometric
point's field is made. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable abbrev logCotangentResidue {X : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X) :=
  strictLocalRing X t ⧸ Ideal.span {a : strictLocalRing X t | ¬ IsUnit a}

/-- The canonical quotient to the residue ring. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable def logCotangentResidueMap {X : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X) :
    strictLocalRing X t →+* logCotangentResidue t :=
  Ideal.Quotient.mk _

variable {X Y S : FineSaturatedLogScheme.{u}}

/-- Balancing over the target geometric local ring, using every pointed relative
étale diagram to prescribe its action on the residue field of the source. The
relations say `(h* a) ⊗ z = 1 ⊗ a z`. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable def logCotangentBaseRelations (g : EtaleLogHom Y S) (h : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme) :
    Submodule (logCotangentResidue t)
      (TensorProduct ℤ (logCotangentResidue t) (g.LogDifferential (t ≫ h.base))) :=
  Submodule.span (logCotangentResidue t) {z |
    ∃ (W : Y.scheme.Etale) (V : X.scheme.Etale)
      (w : (Scheme.pointSmallEtale (t ≫ h.base)).fiber.obj W)
      (v : (Scheme.pointSmallEtale t).fiber.obj V) (k : V.left ⟶ W.left)
      (_hk : k ≫ W.hom = V.hom ≫ h.base),
      v.left ≫ k = w.left ∧ ∃ (a : Γ(W.left, ⊤)) (q : g.LogDifferential (t ≫ h.base)),
        z = TensorProduct.tmul ℤ
            (logCotangentResidueMap t (strictLocalGerm X.scheme t V v (k.appTop a))) q -
          TensorProduct.tmul ℤ 1 (strictLocalGerm Y.scheme (t ≫ h.base) W w a • q)}

/-- The balanced tensor product `k ⊗[O_Y,y] ω_Y/S,y`, constructed by its explicit
relations on the ordinary tensor product over the integers. Every ring germ is
represented on a pointed neighbourhood, so this imposes all and only the required
balancing relations. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable abbrev LogCotangentSource (g : EtaleLogHom Y S) (h : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme) :=
  (TensorProduct ℤ (logCotangentResidue t) (g.LogDifferential (t ≫ h.base))) ⧸
    logCotangentBaseRelations g h t

/-- The canonical symbol `1 ⊗ q` in the scalar extension. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable def logCotangentSourceSymbol (g : EtaleLogHom Y S) (h : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme)
    (q : g.LogDifferential (t ≫ h.base)) : LogCotangentSource g h t :=
  (logCotangentBaseRelations g h t).mkQ (TensorProduct.tmul ℤ 1 q)

/-- The source-point cotangent space `k ⊗[O_X,x] ω_X/S,x`. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable abbrev LogCotangentTarget (f : EtaleLogHom X S)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme) :=
  TensorProduct (strictLocalRing X.scheme t) (logCotangentResidue t) (f.LogDifferential t)

/-- The graph of the canonical logarithmic cotangent comparison for `f = g ∘ h`.
It is the residue-field span of the pairs `(1 ⊗ da, 1 ⊗ d(h* a))` and
`(1 ⊗ dlog m, 1 ⊗ dlog(h♭ m))` on every pointed relative étale diagram.
The logarithmic differential relations and the balancing relations make this the
graph of a linear map; these symbols span its source. Source: ILO X 1.2, p.138
(blueprint: def-per-log-cotangent-comparison). -/
noncomputable def logCotangentGraph (f : EtaleLogHom X S) (g : EtaleLogHom Y S)
    (h : EtaleLogHom X Y) {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ X.scheme) :
    Submodule (logCotangentResidue t) (LogCotangentSource g h t × LogCotangentTarget f t) :=
  Submodule.span (logCotangentResidue t) {z |
    ∃ (W : Y.scheme.Etale) (V : X.scheme.Etale)
      (w : (Scheme.pointSmallEtale (t ≫ h.base)).fiber.obj W)
      (v : (Scheme.pointSmallEtale t).fiber.obj V) (k : V.left ⟶ W.left)
      (hk : k ≫ W.hom = V.hom ≫ h.base),
      v.left ≫ k = w.left ∧
        ((∃ a : Γ(W.left, ⊤), z =
          (logCotangentSourceSymbol g h t
            (g.logD (t ≫ h.base) (strictLocalGerm Y.scheme (t ≫ h.base) W w a)),
          TensorProduct.tmul (strictLocalRing X.scheme t) 1
            (f.logD t (strictLocalGerm X.scheme t V v (k.appTop a))))) ∨
        (∃ m : Y.logStructure.monoidSheaf.obj.obj (op W), z =
          (logCotangentSourceSymbol g h t
            (g.logDLog (t ≫ h.base) (Y.logStructure.germ (t ≫ h.base) W w m)),
          TensorProduct.tmul (strictLocalRing X.scheme t) 1
            (f.logDLog t (X.logStructure.germ t V v (h.sectionMap W V k hk m))))))}

/-- Injectivity of the canonical logarithmic cotangent comparison, expressed as
triviality of the kernel of its prescribed graph. This is exactly injectivity of
`k ⊗ ω_Y/S → k ⊗ ω_X/S`; no map is an input to the predicate.
Source: ILO X 1.2, p.138 (blueprint: def-per-log-cotangent-comparison). -/
noncomputable def IsLogCotangentInjective (f : EtaleLogHom X S) (g : EtaleLogHom Y S)
    (h : EtaleLogHom X Y) {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ X.scheme) : Prop :=
  ∀ q : LogCotangentSource g h t, (q, 0) ∈ logCotangentGraph f g h t → q = 0

end EtaleLogHom
end AlgebraicGeometry
