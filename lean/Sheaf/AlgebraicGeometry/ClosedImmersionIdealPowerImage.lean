/-! # Image of an ideal power after closed pushforward

Source: Stacks Project, proof of Lemma 088A, lines 6961--6968.
(blueprint: lem-weil-pbc-closed-immersion-ideal-power-image).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Scheme

/-- Transfer the affine image-section formula from the abelian image to the chosen image.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-closed-immersion-ideal-power-image). -/
private theorem image_range_affine {X : Scheme.{u}} {M N : X.Modules}
    (φ : M ⟶ N) [M.IsQuasicoherent] [N.IsQuasicoherent] (U : X.affineOpens) :
    Set.range ((image.ι φ).app U.1) = Set.range (φ.app U.1) := by
  let e := Abelian.imageIsoImage φ
  have he : Function.Surjective (e.hom.app U.1) :=
    (Modules.appLinearEquivOfIso e U.1).surjective
  have hf : e.hom ≫ image.ι φ = Abelian.image.ι φ :=
    Abelian.imageIsoImage_hom_comp_image_ι φ
  have hr : Set.range ((image.ι φ).app U.1) =
      Set.range ((Abelian.image.ι φ).app U.1) := by
    rw [← hf, Modules.Hom.comp_app]
    ext s
    constructor
    · rintro ⟨t, rfl⟩
      obtain ⟨a, rfl⟩ := he t
      exact ⟨a, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨e.hom.app U.1 a, rfl⟩
  exact hr.trans ((Modules.quasiCoherent_cokernel_image φ).2.2.2.2.2.2.2.2 U).1

open MonoidalCategory Opposite in
open scoped TensorProduct in
/-- On an affine open, a product has the additive subgroup generated by pure products.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-closed-immersion-ideal-power-image). -/
private theorem product_range_affine {X : Scheme.{u}} {J : X.Modules}
    (ι : J ⟶ SheafOfModules.unit X.ringCatSheaf) (M : X.Modules)
    [J.IsQuasicoherent] [M.IsQuasicoherent] (U : X.affineOpens) :
    Set.range ((idealModuleProductι ι M).app U.1) =
      (AddSubgroup.closure {s | ∃ (a : Γ(J, U.1)) (t : Γ(M, U.1)),
        s = (Modules.unitSectionsEquiv U.1).symm (ι.app U.1 a) • t} : Set Γ(M, U.1)) := by
  let ψ : J ⊗ M ⟶ M := ι ▷ M ≫ (λ_ M).hom
  have : (J ⊗ M).IsQuasicoherent :=
    (Modules.quasiCoherent_tensor_product_affine_sections J M).1
  change Set.range ((image.ι ψ).app U.1) = _
  rw [image_range_affine ψ U]
  let H := AddSubgroup.closure {s | ∃ (a : Γ(J, U.1)) (t : Γ(M, U.1)),
    s = (Modules.unitSectionsEquiv U.1).symm (ι.app U.1 a) • t}
  have ht (a : Γ(J, U.1)) (t : Γ(M, U.1)) :
      ψ.app U.1 (Modules.tmulSection a t) =
        (Modules.unitSectionsEquiv U.1).symm (ι.app U.1 a) • t := by
    rw [Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      Modules.whiskerRight_app_tmulSection]
    exact Modules.leftUnitor_hom_app_tmulSection' _ _
  apply Set.Subset.antisymm
  · rintro _ ⟨s, rfl⟩
    obtain ⟨z, rfl⟩ :=
      (Modules.quasiCoherent_tensor_product_affine_sections J M).2 U.1 U.2 |>.2 s
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]; exact H.zero_mem
    | tmul a t =>
      rw [Modules.tensorSectionsMap_tmul, ht]
      exact AddSubgroup.subset_closure ⟨a, t, rfl⟩
    | add z z' hz hz' =>
      simp only [map_add]
      exact H.add_mem hz hz'
  · change H ≤ (ψ.val.app (op U.1)).hom.range.toAddSubgroup
    apply (AddSubgroup.closure_le _).mpr
    rintro s ⟨a, t, rfl⟩
    exact ⟨Modules.tmulSection a t, ht a t⟩

/-- Sheaf separatedness detects a zero morphism on the affine basis.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-closed-immersion-ideal-power-image). -/
private theorem hom_zero_of_affine {X : Scheme.{u}} {M N : X.Modules}
    (φ : M ⟶ N) (h : ∀ V : X.affineOpens, ∀ s : Γ(M, V.1), φ.app V.1 s = 0) :
    φ = 0 := by
  apply Modules.hom_ext
  intro W
  ext s
  change φ.app W s = 0
  refine TopCat.Sheaf.eq_of_locally_eq' ⟨N.presheaf, N.isSheaf⟩
    (fun i : {V : X.affineOpens // V.1 ≤ W} ↦ i.1.1) W
    (fun i ↦ homOfLE i.2) ?_ _ _ ?_
  · intro x hx
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx W.2
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨V, hV⟩, hVW⟩, hxV⟩
  · intro i
    rw [← Modules.Hom.app_presheaf_map, map_zero]
    exact h i.1 _

/-- Factor an inclusion through a monomorphism by vanishing of its cokernel projection.
Source: Stacks Project, proof of Lemma 01YP
(blueprint: lem-weil-pbc-closed-immersion-ideal-power-image). -/
private theorem subobject_le_of_affine_range {X : Scheme.{u}} {M N P : X.Modules}
    (i : M ⟶ P) (j : N ⟶ P) [Mono i] [Mono j]
    (h : ∀ V : X.affineOpens, Set.range (i.app V.1) ⊆ Set.range (j.app V.1)) :
    Subobject.mk i ≤ Subobject.mk j := by
  have hz : i ≫ cokernel.π j = 0 := by
    apply hom_zero_of_affine
    intro V s
    obtain ⟨t, ht⟩ := h V ⟨s, rfl⟩
    change (cokernel.π j).app V.1 (i.app V.1 s) = 0
    rw [← ht]
    exact congrArg (fun q ↦ q.app V.1 t) (cokernel.condition j)
  let k : M ⟶ Abelian.image j := kernel.lift (cokernel.π j) i hz
  let l : M ⟶ N := k ≫ inv (Abelian.factorThruImage j)
  apply Subobject.mk_le_mk_of_comm l
  change k ≫ inv (Abelian.factorThruImage j) ≫ j = i
  calc
    k ≫ inv (Abelian.factorThruImage j) ≫ j =
        k ≫ inv (Abelian.factorThruImage j) ≫
          Abelian.factorThruImage j ≫ Abelian.image.ι j :=
      congrArg (fun q ↦ k ≫ inv (Abelian.factorThruImage j) ≫ q)
        (Abelian.image.fac j).symm
    _ = k ≫ Abelian.image.ι j := by rw [IsIso.inv_hom_id_assoc]
    _ = i := kernel.lift_ι _ _ hz

set_option backward.isDefEq.respectTransparency false in
/-- Compare just the image subobjects, before constructing any quotient comparison.
Source: Stacks Project, proof of Lemma 088A, lines 6961--6968; Morphisms, Lemma 01QO;
Schemes, Lemmas 01I8 and 01IC.
(blueprint: lem-weil-pbc-closed-immersion-ideal-power-image).

Proof: For an affine open U = Spec R, its inverse image is affine, Spec S, and the
structure map pi : R → S is surjective. The extended ideal has sections Ideal.map pi
(I(U)). Products and positive powers are quasi-coherent and are computed on affine
sections. Thus the upstairs product has sections (Ideal.map pi (I(U)))^n times G(U'),
and the downstairs product has sections I(U)^n times the same group, with scalars
restricted through pi. Mapping ideals commutes with powers. Surjectivity of pi makes
the mapped ideal the actual image; its action is precisely the restricted R-action.
The two ranges therefore coincide on every affine open of X. Both image inclusions
are subsheaves of the pushforward of G. For an arbitrary open, restrict a section of
either subsheaf to an affine cover. The equal ranges give local lifts into the other
subsheaf; injectivity of its inclusion makes these lifts agree on overlaps, and the
sheaf condition glues them. This proves both inclusions and hence subobject equality.
The empty affine open and the zero ideal or module give zero products on both sides;
no nonemptiness, finite generation or Noetherian hypothesis is used. -/
theorem closedImmersion_idealPower_image
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (I : X.IdealSheafData) (G : Z.Modules) [G.IsQuasicoherent]
    (n : ℕ) (hn : 1 ≤ n) :
    Subobject.mk (image.ι ((Modules.pushforward i).map (idealModuleProductι
      (idealSheafPower (I.comap i).toModulesι n).2 G))) =
      Subobject.mk (image.ι (idealModuleProductι
        (idealSheafPower I.toModulesι n).2 ((Modules.pushforward i).obj G))) := by
  have hpos : 0 < n := hn
  have : ((Modules.pushforward i).obj G).IsQuasicoherent :=
    Modules.isQuasicoherent_pushforward_of_isClosedImmersion i G
  have hX := Modules.ideal_times_quasiCoherent_affine_sections
    I ((Modules.pushforward i).obj G)
  have hZ := Modules.ideal_times_quasiCoherent_affine_sections (I.comap i) G
  have : (idealSheafPower I.toModulesι n).1.IsQuasicoherent := hX.2.2.1 n hpos
  have : (idealSheafPower (I.comap i).toModulesι n).1.IsQuasicoherent := hZ.2.2.1 n hpos
  let a := (Modules.pushforward i).map
    (idealModuleProductι (idealSheafPower (I.comap i).toModulesι n).2 G)
  let b := idealModuleProductι
    (idealSheafPower I.toModulesι n).2 ((Modules.pushforward i).obj G)
  have ha : Mono a := by
    have : Mono (idealModuleProductι (idealSheafPower (I.comap i).toModulesι n).2 G) := by
      dsimp [idealModuleProductι]
      infer_instance
    dsimp [a]
    exact Functor.map_mono _ _
  have hb : Mono b := by dsimp [b, idealModuleProductι]; infer_instance
  have hr (V : X.affineOpens) : Set.range (a.app V.1) = Set.range (b.app V.1) := by
    let U : Z.affineOpens := ⟨i ⁻¹ᵁ V.1, V.2.preimage i⟩
    have hpX := (hX.2.2.2.1 V).2.2.2 n hpos
    have hpZ := (hZ.2.2.2.1 U).2.2.2 n hpos
    have he : (I.comap i).ideal U ^ n = Ideal.map (i.app V.1).hom (I.ideal V ^ n) := by
      rw [IdealSheafData.ideal_comap_appLE I i V U le_rfl]
      simp only [U, Hom.appLE_eq_app, Ideal.map_pow]
    dsimp only [a, b]
    rw [Modules.pushforward_map_app]
    refine (product_range_affine (idealSheafPower (I.comap i).toModulesι n).2 G U).trans
      (Eq.trans ?_ (product_range_affine (idealSheafPower I.toModulesι n).2
        ((Modules.pushforward i).obj G) V).symm)
    apply congrArg (fun H : AddSubgroup Γ(G, U.1) ↦ (H : Set Γ(G, U.1)))
    apply congrArg AddSubgroup.closure
    ext s
    constructor
    · rintro ⟨z, t, rfl⟩
      have hz : (idealSheafPower (I.comap i).toModulesι n).2.app U.1 z ∈
          (I.comap i).ideal U ^ n := by
        exact (Set.ext_iff.mp hpZ _).mp ⟨z, rfl⟩
      rw [he] at hz
      obtain ⟨r, hr, hri⟩ :=
        (Ideal.mem_map_iff_of_surjective (i.app V.1).hom (i.app_surjective V.1 V.2)).mp hz
      have hr' : r ∈ Set.range ((idealSheafPower I.toModulesι n).2.app V.1) := by
        exact (Set.ext_iff.mp hpX _).mpr hr
      obtain ⟨x, hx⟩ := hr'
      refine ⟨x, t, ?_⟩
      change (show Γ(Z, U.1) from
        (idealSheafPower (I.comap i).toModulesι n).2.app U.1 z) • t =
        i.app V.1 ((idealSheafPower I.toModulesι n).2.app V.1 x) • t
      exact congrArg (fun r : Γ(Z, U.1) ↦ r • t)
        (hri.symm.trans (congrArg (i.app V.1) hx.symm))
    · rintro ⟨x, t, rfl⟩
      have hx : (idealSheafPower I.toModulesι n).2.app V.1 x ∈ I.ideal V ^ n := by
        exact (Set.ext_iff.mp hpX _).mp ⟨x, rfl⟩
      have hz : i.app V.1 ((idealSheafPower I.toModulesι n).2.app V.1 x) ∈
          (I.comap i).ideal U ^ n := by
        rw [he]
        exact Ideal.mem_map_of_mem _ hx
      have hz' : i.app V.1 ((idealSheafPower I.toModulesι n).2.app V.1 x) ∈
          Set.range ((idealSheafPower (I.comap i).toModulesι n).2.app U.1) := by
        exact (Set.ext_iff.mp hpZ _).mpr hz
      obtain ⟨z, hz⟩ := hz'
      refine ⟨z, t, ?_⟩
      change i.app V.1 ((idealSheafPower I.toModulesι n).2.app V.1 x) •
          (show Γ(G, U.1) from t) =
        (show Γ(Z, U.1) from
          (idealSheafPower (I.comap i).toModulesι n).2.app U.1 z) •
          (show Γ(G, U.1) from t)
      exact congrArg (fun r : Γ(Z, U.1) ↦ r • (show Γ(G, U.1) from t)) hz.symm
  change imageSubobject a = imageSubobject b
  rw [imageSubobject_mono, imageSubobject_mono]
  exact le_antisymm
    (subobject_le_of_affine_range a b (fun V ↦ (hr V).subset))
    (subobject_le_of_affine_range b a (fun V ↦ (hr V).symm.subset))

end AlgebraicGeometry.Scheme
