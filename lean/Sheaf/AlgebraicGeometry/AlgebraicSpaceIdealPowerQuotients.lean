module

public import Sheaf.AlgebraicGeometry.AlgebraicSpace
public import Mathlib.RingTheory.Ideal.Operations

/-! # Ideal-power quotient towers on algebraic spaces

Source: Stacks Project, Spaces Cohomology, Situation 08AV and Lemma 08AY
(blueprint: def-sfb-space-ideal-power-quotients).

The quotient is specified by its full cokernel universal property, including the
quotient arrow. Thus its choice is unique up to the unique projection-preserving
isomorphism. Transition arrows are normalized by the quotient arrows.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.AlgebraicSpace

variable {A : Type u} [CommRing A]

/-- Pullback of a base-ring element to the regular functions on an étale chart.
Source: Stacks, Situation 08AV (blueprint: def-sfb-space-ideal-power-quotients). -/
def idealPowerChartScalar (X : AlgebraicSpace (Spec (CommRingCat.of A)))
    (T : X.EtaleSite) : A →+* Γ(T.obj.left.left, ⊤) :=
  T.obj.left.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom

/-- A module map kills the ideal-power submodule precisely when it kills all its
local generators. This includes arbitrary local module sections and all elements
of the actual ideal power in the base ring; the exponent zero is included.
Source: Stacks, Situation 08AV (blueprint: def-sfb-space-ideal-power-quotients). -/
def KillsBaseIdealPower (X : AlgebraicSpace (Spec (CommRingCat.of A)))
    (I : Ideal A) {N M : X.Modules} (n : ℕ) (f : N ⟶ M) : Prop :=
  ∀ (T : X.EtaleSite) (a : A), a ∈ I ^ n → ∀ s : N.val.obj (op T),
    f.val.app (op T) (idealPowerChartScalar X T a • s) = 0

/-- The sheaf quotients N/(I O_X)^n N, with their quotient maps and the canonical
transition maps. The universal property quantifies over every target module and
EVERY map annihilating the local generators: it fixes the actual sheaf cokernel,
not the quotient of global sections. `transition_projection` fixes each transition.
Source: Stacks, Situation 08AV and Lemma 08AY
(blueprint: def-sfb-space-ideal-power-quotients). -/
structure BaseIdealQuotientTower (X : AlgebraicSpace (Spec (CommRingCat.of A)))
    (I : Ideal A) (N : X.Modules) where
  obj (n : ℕ) : X.Modules
  projection (n : ℕ) : N ⟶ obj n
  kills (n : ℕ) : KillsBaseIdealPower X I n (projection n)
  universal (n : ℕ) (M : X.Modules) (f : N ⟶ M) :
    KillsBaseIdealPower X I n f → ∃! d : obj n ⟶ M, projection n ≫ d = f
  transition (r n : ℕ) (h : n ≤ r) : obj r ⟶ obj n
  transition_projection (r n : ℕ) (h : n ≤ r) :
    projection r ≫ transition r n h = projection n

/-- The canonical sheaf quotient tower exists and is determined by its universal
property up to the unique family of projection-preserving isomorphisms.
Source: Stacks, Situation 08AV, Modules on Sites, cokernels of module sheaves
(blueprint: def-sfb-space-ideal-power-quotients).

Proof: on each étale chart take the submodule spanned by a s with a in I^n.
Restriction preserves these submodules because the chart ring maps are the
pullbacks of the same base-ring elements. Sheafify this subpresheaf inside N;
its image is exactly (I O_X)^n N, since ideal powers are generated by products.
Sheafify the sectionwise quotient to obtain the sheaf cokernel and its projection.
A map killing the displayed generators kills their spans and their sheafification,
and therefore factors uniquely through this cokernel. For n <= r, I^r <= I^n,
so the projection to the n-th quotient factors uniquely through the r-th one;
use this factorization for the transition arrow. For two such towers, apply the
universal properties in both directions to their quotient projections. Uniqueness
makes the composites identities and fixes each isomorphism; it also implies
compatibility with every transition arrow. For n=0 the ideal power is the unit
ideal and the quotient is the zero sheaf. All constructions include the empty space. -/
theorem baseIdealQuotientTower_exists
    (X : AlgebraicSpace (Spec (CommRingCat.of A))) (I : Ideal A) (N : X.Modules) :
    ∃ P : BaseIdealQuotientTower X I N,
      ∀ Q : BaseIdealQuotientTower X I N,
        ∃! e : ∀ n : ℕ, P.obj n ≅ Q.obj n,
          ∀ n : ℕ, P.projection n ≫ (e n).hom = Q.projection n := by
  sorry

/-- The canonical quotient tower, selected by a full cokernel universal property
and its projection-preserving uniqueness theorem, rather than by mere existence.
Source: Stacks, Situation 08AV and Lemma 08AY
(blueprint: def-sfb-space-ideal-power-quotients). -/
def baseIdealQuotientTower (X : AlgebraicSpace (Spec (CommRingCat.of A)))
    (I : Ideal A) (N : X.Modules) : BaseIdealQuotientTower X I N :=
  (baseIdealQuotientTower_exists X I N).choose

end AlgebraicGeometry.AlgebraicSpace
