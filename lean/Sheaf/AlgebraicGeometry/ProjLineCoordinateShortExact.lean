/-! # The coordinate short exact sequence on the polynomial projective line

Source: Stacks Project, Tag 01MN; the locally split coordinate sequence used in
lem-sc-p1-section-coordinate-surjective, proof steps 1 and 3.
(blueprint: lem-sc-p1-proj-coordinate-short-exact).
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory AlgebraicGeometry

namespace AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Tensoring the coordinate sequence with any module remains short exact.
No coherence or flatness assumption on G is needed.

Source: Stacks Project, Tag 01MN, and the coordinate sequence in the proof of
lem-sc-p1-section-coordinate-surjective, step 1.
(blueprint: lem-sc-p1-proj-coordinate-short-exact).

Proof: On the polynomial projective line form the sequence
0 -> O(-1) -> O direct-sum O -> O(1) -> 0, with maps
 t |-> (-x1*t,x0*t) and (a,b) |-> x0*a+x1*b.
Their composite is zero by commutativity. On D+(x0), trivialize using powers of
x0; the quotient map becomes (a,b) |-> a+(x1/x0)*b. A right inverse sends c to
(c,0), and its kernel is generated by (-(x1/x0),1). On D+(x1), the quotient map
becomes (a,b) |-> (x0/x1)*a+b, with right inverse c |-> (0,c) and kernel
(-(1),x0/x1). These generators are the restrictions of the displayed kernel map,
so they glue with the transition of O(-1). Tensor this locally split sequence
with G tensor O(z); split exactness survives tensoring with an arbitrary G.
Use associativity, the twist tensor-addition isomorphisms, and O(0)=O to identify
its three terms with G(z-1), G(z) direct-sum G(z), and G(z+1).
On homogeneous fractions the quotient maps multiply by x0 and x1, hence are
exactly the two whiskered twistMul maps displayed below. Short exactness is
local on the two charts, which cover Proj, so it holds globally. The zero module
and all integers z, including negative z, obey the same local split calculation.
-/
theorem exists_proj_coordinate_shortExact
    (k : Type u) [Field k]
    (G : (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) k)).Modules) (z : ℤ) :
    ∃ (f : G ⊗ Proj.twist (MvPolynomial.homogeneousSubmodule (Fin 2) k) (z - 1) ⟶
        (G ⊗ Proj.twist (MvPolynomial.homogeneousSubmodule (Fin 2) k) z) ⊞
        (G ⊗ Proj.twist (MvPolynomial.homogeneousSubmodule (Fin 2) k) z))
      (h : f ≫ biprod.desc
        (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (0 : Fin 2)))
        (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (1 : Fin 2))) = 0),
      (ShortComplex.mk f (biprod.desc
        (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (0 : Fin 2)))
        (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (1 : Fin 2))))
        h).ShortExact := by
  obtain ⟨f, h, hf⟩ := exists_proj_coordinate_kernel_fork k G z
  let hf' : IsLimit (KernelFork.ofι f h) := Classical.choice hf
  let g := biprod.desc
    (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (0 : Fin 2)))
    (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (1 : Fin 2)))
  have hg : Epi g := by
    dsimp [g]
    exact proj_coordinate_quotient_epi k G z
  let S := ShortComplex.mk f g h
  have he : S.Exact := ShortComplex.exact_of_f_is_kernel S hf'
  let : Mono S.f := mono_of_isLimit_fork hf'
  have hs : S.ShortExact := ShortComplex.ShortExact.mk' he inferInstance hg
  exact ⟨f, h, hs⟩

end AlgebraicGeometry
