module

public import Sheaf.AlgebraicGeometry.StrictNormalCrossingsBoundary
public import Sheaf.AlgebraicGeometry.LogRegularPair
public import WeilConjectures.Compactification.StrictTransform
public import WeilConjectures.RingTheory.IsRegularSystemOfParameters
public import Mathlib.Data.Fintype.Card

/-!
# Weak boundary families and their canonical minimal-center iteration

Source: ILO, Travaux de Gabber, VIII 4.2.4--4.2.11, printed pp. 119--122
(blueprint: def-per-weak-boundary-family).

The infinite sequence is only an auxiliary recursion. Its finite tower is the prefix
ending at the first level with no nonempty intersection. No blowup after that level
belongs to the tower. All ideals, centers, strict transforms and maps are actual data.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
universe u v w
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry

/-- A regular closed subscheme with normal crossings with a boundary: on a pointed
étale affine neighbourhood its ideal is generated by distinct parameters, and the
boundary equation is a product of distinct parameters from the same system. There
is no requirement that the subscheme lie in the boundary; empty subschemes and
empty parameter subsets are allowed. Source: ILO VIII 4.2.4--4.2.5(ii), 4.2.9
(blueprint: def-per-weak-boundary-family). -/
def IsRegularWithBoundary {X : Scheme.{u}} (B L : X.IdealSheafData) : Prop :=
  IsRegularScheme L.subscheme ∧
    ∀ x : X, x ∈ L.support →
      ∃ (W : Scheme.{u}) (e : W ⟶ X) (_he : Etale e) (w : W) (_hw : e w = x)
        (U : W.affineOpens) (hwU : w ∈ U.1) (d r m : ℕ)
        (hN : IsNoetherianRing (W.presheaf.stalk w))
        (t : Fin d → W.presheaf.stalk w)
        (b : Fin r → Γ(W, U.1)) (l : Fin m → Γ(W, U.1))
        (ib : Fin r ↪ Fin d) (il : Fin m ↪ Fin d),
        @IsLocalRing.IsRegularSystemOfParameters (W.presheaf.stalk w) _ _ hN
          (List.ofFn t) ∧
        (B.comap e).ideal U = Ideal.span {∏ i, b i} ∧
        (L.comap e).ideal U = Ideal.span (Set.range l) ∧
        (∀ i, (W.presheaf.germ U.1 w hwU).hom (b i) = t (ib i)) ∧
        ∀ i, (W.presheaf.germ U.1 w hwU).hom (l i) = t (il i)

/-- The ambient scheme, boundary and indexed ideals, without imposing any property.
Source: ILO VIII 4.2.4, 4.2.10 (blueprint: def-per-weak-boundary-family). -/
structure BoundaryFamily (I : Type v) where
  scheme : Scheme.{u}
  boundary : scheme.IdealSheafData
  family : I → scheme.IdealSheafData

namespace BoundaryFamily

/-- The ideal of a scheme-theoretic intersection is the sum of its ideals.
Source: ILO VIII 4.2.4 (blueprint: def-per-weak-boundary-family). -/
def intersection {I : Type v} (S : BoundaryFamily.{u} I) (J : Finset I) :
    S.scheme.IdealSheafData :=
  ⨆ i ∈ J, S.family i

/-- Membership in the deduplicated collection of nonempty-index intersections.
The intersection scheme itself is allowed to be empty.
Source: ILO VIII 4.2.7 (blueprint: def-per-weak-boundary-family). -/
def IsMember {I : Type v} (S : BoundaryFamily.{u} I) (L : S.scheme.IdealSheafData) : Prop :=
  ∃ J : Finset I, J.Nonempty ∧ S.intersection J = L

/-- A Noetherian regular ambient scheme, an SNC boundary, nowhere dense members,
and regular boundary-compatible intersections for every nonempty index subset.
Source: ILO VIII 4.2.4--4.2.8 (blueprint: def-per-weak-boundary-family). -/
def IsWeak {I : Type v} (S : BoundaryFamily.{u} I) : Prop :=
  IsNoetherian S.scheme ∧ IsRegularScheme S.scheme ∧
    IsStrictNormalCrossingsBoundary S.boundary ∧
    (∀ i, IsNowhereDense ((S.family i).support : Set S.scheme)) ∧
    ∀ J : Finset I, J.Nonempty → IsRegularWithBoundary S.boundary (S.intersection J)

/-- Nonempty minimal closed subschemes correspond to maximal proper intersection ideals.
Equality is equality of ideal sheaves, not merely of supports.
Source: ILO VIII 4.2.7 (blueprint: def-per-weak-boundary-family). -/
def IsMinimal {I : Type v} (S : BoundaryFamily.{u} I) (L : S.scheme.IdealSheafData) : Prop :=
  S.IsMember L ∧ L ≠ ⊤ ∧
    ∀ M : S.scheme.IdealSheafData, S.IsMember M → M ≠ ⊤ → L ≤ M → M = L

/-- The scheme-theoretic union of the distinct nonempty minimal intersections.
The empty union has unit ideal.
Source: ILO VIII 4.2.7--4.2.8 (blueprint: def-per-weak-boundary-family). -/
def center {I : Type v} (S : BoundaryFamily.{u} I) : S.scheme.IdealSheafData :=
  ⨅ L : {L : S.scheme.IdealSheafData // S.IsMinimal L}, L.val

/-- Strict-transform ideal in the prescribed blowup, using the scheme-theoretic closure.
Source: ILO VIII 4.2.8(iii), 4.2.9 (blueprint: def-per-weak-boundary-family). -/
def transform {I : Type v} (S : BoundaryFamily.{u} I) (L : S.scheme.IdealSheafData) :
    S.center.blowup.IdealSheafData :=
  (strictTransformMap L.subschemeι S.center.blowupMap S.center.support.compl).ker

/-- The union of the exceptional components over minimal strata contained in `L`.
A stratum is selected scheme-theoretically by the reversed ideal inclusion `L ≤ V`.
Source: ILO VIII 4.2.8(iv) (blueprint: def-per-weak-boundary-family). -/
def exceptionalPart {I : Type v} (S : BoundaryFamily.{u} I)
    (L : S.scheme.IdealSheafData) : S.center.blowup.IdealSheafData :=
  (⨅ V : {V : S.scheme.IdealSheafData // S.IsMinimal V ∧ L ≤ V}, V.val).comap
    S.center.blowupMap

/-- The next raw level: the canonical blowup, reduced total boundary, and strict transforms.
Only levels before the first empty family are retained in the finite tower.
Source: ILO VIII 4.2.8, 4.2.10 (blueprint: def-per-weak-boundary-family). -/
def step {I : Type v} (S : BoundaryFamily.{u} I) : BoundaryFamily.{u} I where
  scheme := S.center.blowup
  boundary := ((S.boundary ⊓ S.center).comap S.center.blowupMap).radical
  family i := S.transform (S.family i)

/-- No nonempty intersection scheme remains. With an empty index type this is vacuous.
Source: ILO VIII 4.2.10--4.2.11 (blueprint: def-per-weak-boundary-family). -/
def Done {I : Type v} (S : BoundaryFamily.{u} I) : Prop :=
  ∀ J : Finset I, J.Nonempty → S.intersection J = ⊤

/-- Auxiliary recursion; the finite tower stops at its first `Done` level.
Source: ILO VIII 4.2.10 (blueprint: def-per-weak-boundary-family). -/
def level {I : Type v} (S : BoundaryFamily.{u} I) : ℕ → BoundaryFamily.{u} I
  | 0 => S
  | n + 1 => (S.level n).step

/-- Composite of the actual blowup projections to the input, with identity at level zero.
Source: ILO VIII 4.2.10--4.2.11 (blueprint: def-per-weak-boundary-family). -/
def toBase {I : Type v} (S : BoundaryFamily.{u} I) :
    (n : ℕ) → (S.level n).scheme ⟶ S.scheme
  | 0 => 𝟙 S.scheme
  | n + 1 => (S.level n).center.blowupMap ≫ S.toBase n

/-- Iterated strict transform of any original ideal, one actual closure at every stage.
Source: ILO VIII 4.2.10--4.2.11 (blueprint: def-per-weak-boundary-family). -/
def iteratedTransform {I : Type v} (S : BoundaryFamily.{u} I)
    (L : S.scheme.IdealSheafData) : (n : ℕ) → (S.level n).scheme.IdealSheafData
  | 0 => L
  | n + 1 => (S.level n).transform (S.iteratedTransform L n)

/-- Height of the finite poset of distinct nonempty intersections, counting members.
The supremum is zero when there are no such intersections. Reversing ideal order
reverses a chain without changing its length.
Source: ILO VIII 4.2.11, upper-bound formulation
(blueprint: def-per-weak-boundary-family). -/
def height {I : Type v} (S : BoundaryFamily.{u} I) : ℕ :=
  sSup {n : ℕ | ∃ f : Fin n → S.scheme.IdealSheafData,
    (∀ i, S.IsMember (f i) ∧ f i ≠ ⊤) ∧ ∀ i j, i < j → f i < f j}

/-- An isomorphism preserving the indexed family, allowing reindexing. The boundary
is irrelevant to the centers and underlying blowup tower.
Source: ILO VIII 4.2.13 (blueprint: def-per-weak-boundary-family). -/
def PreservesFamily {I : Type v} {K : Type w} (S : BoundaryFamily.{u} I)
    (T : BoundaryFamily.{u} K) (σ : K ≃ I) (e : T.scheme ≅ S.scheme) : Prop :=
  ∀ i : K, (S.family (σ i)).comap e.hom = T.family i

/-- Preservation of both the family and the boundary; this additionally identifies
the reduced total boundaries at each level.
Source: ILO VIII 4.2.8, 4.2.13 (blueprint: def-per-weak-boundary-family). -/
def Preserves {I : Type v} {K : Type w} (S : BoundaryFamily.{u} I)
    (T : BoundaryFamily.{u} K) (σ : K ≃ I) (e : T.scheme ≅ S.scheme) : Prop :=
  S.boundary.comap e.hom = T.boundary ∧ S.PreservesFamily T σ e

/-- The exact divisorial fs log regularity predicate on the boundary complement.
Its dense open, local Noetherianity and log structure are the existing prescribed ones.
Source: ILO VI 1.7 (blueprint: def-per-weak-boundary-family). -/
def HasLogRegularBoundary {I : Type v} (S : BoundaryFamily.{u} I) : Prop :=
  ∃ (hN : IsLocallyNoetherian S.scheme)
    (hD : DenseRange (Scheme.Opens.ι S.boundary.support.compl)),
    @IsDivisorialFineSaturatedLogRegularPair S.scheme
      (Scheme.Opens.toScheme (X := S.scheme) S.boundary.support.compl)
      (Scheme.Opens.ι S.boundary.support.compl) inferInstance hN hD

end BoundaryFamily
end AlgebraicGeometry
