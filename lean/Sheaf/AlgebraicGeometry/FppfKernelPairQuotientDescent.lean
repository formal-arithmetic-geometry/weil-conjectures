/-! # Descent and the fppf quotient of a kernel pair

Source: Stacks Project, Groupoids, Tag 03C5 (lemma-criterion-quotient-representable),
as applied in Tag 03BM (proposition-finite-flat-equivalence); Descent, Tag 023Q
(lemma-fpqc-universal-effective-epimorphisms)
(blueprint: lem-a1-fppf-kernel-pair-quotient-descent).

The presheaf coequalizer is the sectionwise quotient by the relation generated by
R-points. The theorem asserts that this relation is already an equivalence relation.
The equation with `coequalizer.π` pins the natural map to the descended representable;
its universal property is the one of `sheafificationAdjunction`.
`uliftYoneda` places section sets in any chosen universe containing the big site.
-/

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- A finite locally free surjection with the prescribed kernel pair descends the
base structure uniquely and represents the fppf sheafification of the pointwise quotient.

Source: Stacks Project, Groupoids, Tag 03C5 (lemma-criterion-quotient-representable),
as applied in Tag 03BM (proposition-finite-flat-equivalence); Descent, Tag 023Q
(lemma-fpqc-universal-effective-epimorphisms)
(blueprint: lem-a1-fppf-kernel-pair-quotient-descent).

Proof (the node's seven steps):
1. Finite locally free and surjective makes q an fppf cover. The inclusion of
   fppf coverings in fpqc coverings gives both covering assertions.
2. The inverse of the kernel-pair isomorphism lifts every pair x,y with xq=yq
   to R, so xa=ya. Effective epimorphic descent gives m with qm=a;
   cancellation of q gives uniqueness.
3. Mathlib's fpqc and fppf subcanonicity give the absolute sheaf assertion.
   Subcanonicity of the slice gives the relative, universe-lifted assertion.
4. The same inverse identifies the R-point relation with equality of Q-images
   for Q:U → M over S. Define η by the coequalizer universal property.
   The quotient projection is sectionwise surjective. For two representatives
   with equal η-image, their common R-point proves equality of quotient classes.
5. Forgetting the pullback of f:H → M with Q gives a pullback of schemes.
   Stability of flatness, surjectivity and local finite presentation makes its
   first projection an fppf cover. The second projection gives the stated lift.
6. For α:P → G, Yoneda associates to πα a section z of G(U). Equality on R
   and the kernel-pair inverse make z compatible for the singleton cover Q.
   The sheaf condition gives y in G(M); its Yoneda transformation γ satisfies
   (uliftYoneda.map Q)γ=πα, hence ηγ=α by cancellation of the quotient projection.
7. Two such γ have equal restrictions along Q. Separatedness of G makes their
   Yoneda sections equal, hence the transformations equal. This gives the required
   bijection, the universal property of sheafification in the chosen universe.
-/
theorem fppf_kernelPair_quotient_descent
    {S U R M : Scheme.{u}} (a : U ⟶ S) (b : R ⟶ S)
    (s t : Over.mk b ⟶ Over.mk a) (q : U ⟶ M)
    [q.IsFiniteLocallyFree] [Surjective q]
    (hqs : s.left ≫ q = t.left ≫ q)
    [IsIso (pullback.lift s.left t.left hqs)] :
    Presieve.singleton q ∈ Scheme.fppfPrecoverage M ∧
    Presieve.singleton q ∈ Scheme.fpqcPrecoverage M ∧
    Scheme.fppfPrecoverage ≤ Scheme.fpqcPrecoverage ∧
    (∀ X : Scheme.{u}, Presheaf.IsSheaf Scheme.fppfTopology (yoneda.obj X)) ∧
    ∃ m : M ⟶ S, ∃ hq : q ≫ m = a,
      (∀ m' : M ⟶ S, q ≫ m' = a → m' = m) ∧
      (∀ H : Over S, Equivalence (fun x y : H ⟶ Over.mk a ↦
        ∃ r : H ⟶ Over.mk b, r ≫ s = x ∧ r ≫ t = y)) ∧
      Presheaf.IsSheaf (Scheme.fppfTopology.over S)
        (uliftYoneda.{max (u + 1) v}.obj (Over.mk m)) ∧
      ∃ η : coequalizer (uliftYoneda.{max (u + 1) v}.map s)
          (uliftYoneda.{max (u + 1) v}.map t) ⟶
            uliftYoneda.{max (u + 1) v}.obj (Over.mk m),
        coequalizer.π (uliftYoneda.{max (u + 1) v}.map s)
            (uliftYoneda.{max (u + 1) v}.map t) ≫ η =
          uliftYoneda.{max (u + 1) v}.map (Over.homMk q hq : Over.mk a ⟶ Over.mk m) ∧
        (∀ H : (Over S)ᵒᵖ, Function.Injective (η.app H)) ∧
        (∀ (H : Over S) (f : H ⟶ Over.mk m),
          Presieve.singleton (pullback.fst f (Over.homMk q hq : Over.mk a ⟶ Over.mk m)).left ∈
            Scheme.fppfPrecoverage H.left ∧
          η.app (op (pullback f (Over.homMk q hq : Over.mk a ⟶ Over.mk m)))
            ((coequalizer.π (uliftYoneda.{max (u + 1) v}.map s)
              (uliftYoneda.{max (u + 1) v}.map t)).app
                (op (pullback f (Over.homMk q hq : Over.mk a ⟶ Over.mk m)))
                  (ULift.up (pullback.snd f (Over.homMk q hq : Over.mk a ⟶ Over.mk m)))) =
            ULift.up (pullback.fst f (Over.homMk q hq : Over.mk a ⟶ Over.mk m) ≫ f)) ∧
        ∀ G : Sheaf (Scheme.fppfTopology.over S) (Type (max (u + 1) v)),
          Function.Bijective
            (fun k : uliftYoneda.{max (u + 1) v}.obj (Over.mk m) ⟶ G.obj ↦ η ≫ k) := by
  classical
  let k := pullback.lift s.left t.left hqs
  have hs : inv k ≫ s.left = pullback.fst q q := by
    rw [IsIso.inv_comp_eq]
    simp [k]
  have ht : inv k ≫ t.left = pullback.snd q q := by
    rw [IsIso.inv_comp_eq]
    simp [k]
  have lift_pair {Z : Scheme.{u}} (x y : Z ⟶ U) (h : x ≫ q = y ≫ q) :
      ∃ r : Z ⟶ R, r ≫ s.left = x ∧ r ≫ t.left = y := by
    refine ⟨pullback.lift x y h ≫ inv k, ?_, ?_⟩
    · simp only [Category.assoc, hs, pullback.lift_fst]
    · simp only [Category.assoc, ht, pullback.lift_snd]
  have hsa : s.left ≫ a = b := s.w
  have hta : t.left ≫ a = b := t.w
  have ha {Z : Scheme.{u}} (x y : Z ⟶ U) (h : x ≫ q = y ≫ q) :
      x ≫ a = y ≫ a := by
    obtain ⟨r, hr, hr'⟩ := lift_pair x y h
    rw [← hr, ← hr', Category.assoc, Category.assoc, hsa, hta]
  let m : M ⟶ S := EffectiveEpi.desc q a ha
  have hq : q ≫ m = a := EffectiveEpi.fac q a ha
  let Q : Over.mk a ⟶ Over.mk m := Over.homMk q hq
  have hQ : s ≫ Q = t ≫ Q := by
    ext
    exact hqs
  have rel (H : Over S) (x y : H ⟶ Over.mk a) :
      (∃ r : H ⟶ Over.mk b, r ≫ s = x ∧ r ≫ t = y) ↔ x ≫ Q = y ≫ Q := by
    constructor
    · rintro ⟨r, rfl, rfl⟩
      simp only [Category.assoc, hQ]
    · intro h
      obtain ⟨r, hr, hr'⟩ := lift_pair x.left y.left (congrArg (fun z ↦ z.left) h)
      have rb : r ≫ b = H.hom := by
        rw [← hsa, ← Category.assoc, hr]
        exact x.w
      exact ⟨Over.homMk r rb, Over.OverMorphism.ext hr, Over.OverMorphism.ext hr'⟩
  let us := uliftYoneda.{max (u + 1) v}.map s
  let ut := uliftYoneda.{max (u + 1) v}.map t
  let π := coequalizer.π us ut
  let η := coequalizer.desc (f := us) (g := ut) (uliftYoneda.{max (u + 1) v}.map Q)
    (by rw [← Functor.map_comp, ← Functor.map_comp, hQ])
  have hη : π ≫ η = uliftYoneda.{max (u + 1) v}.map Q := coequalizer.π_desc _ _
  have hπ (H : (Over S)ᵒᵖ) : Function.Surjective (π.app H) :=
    (epi_iff_surjective _).mp inferInstance
  have hinj (H : (Over S)ᵒᵖ) : Function.Injective (η.app H) := by
    intro x y h
    obtain ⟨⟨x⟩, rfl⟩ := hπ H x
    obtain ⟨⟨y⟩, rfl⟩ := hπ H y
    have e : x ≫ Q = y ≫ Q := by
      have hx := congrArg (fun f ↦ f.app H (ULift.up x)) hη
      have hy := congrArg (fun f ↦ f.app H (ULift.up y)) hη
      exact ULift.up_injective (hx.symm.trans (h.trans hy))
    obtain ⟨r, hr, hr'⟩ := (rel H.unop x y).mpr e
    have hc := congrArg (fun f ↦ f.app H (ULift.up r)) (coequalizer.condition us ut)
    change π.app H (ULift.up (r ≫ s)) = π.app H (ULift.up (r ≫ t)) at hc
    simpa only [hr, hr'] using hc
  have cov := Scheme.Hom.singleton_mem_fppfPrecoverage q
  have coverQ : Presieve.singleton Q ∈
      (Scheme.fppfPrecoverage.comap (Over.forget S)) (Over.mk m) := by
    rw [Precoverage.mem_comap_iff, Presieve.map_singleton]
    exact cov
  refine ⟨cov, Scheme.fppfPrecoverage_le_fpqcPrecoverage _ cov,
    Scheme.fppfPrecoverage_le_fpqcPrecoverage, ?_, m, hq, ?_, ?_, ?_, η, hη, hinj, ?_, ?_⟩
  · intro X
    exact (isSheaf_iff_isSheaf_of_type _ _).mpr
      (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)
  · intro m' hm'
    exact (cancel_epi q).mp (hm'.trans hq.symm)
  · intro H
    refine ⟨?_, ?_, ?_⟩
    · intro x
      exact (rel H x x).mpr rfl
    · intro x y h
      exact (rel H y x).mpr ((rel H x y).mp h).symm
    · intro x y z h h'
      exact (rel H x z).mpr (((rel H x y).mp h).trans ((rel H y z).mp h'))
  · exact ((Scheme.fppfTopology.over S).uliftYoneda.obj (Over.mk m)).property
  · intro H f
    refine ⟨?_, ?_⟩
    · have hp : IsPullback (pullback.fst f Q).left (pullback.snd f Q).left f.left q :=
        (IsPullback.of_hasPullback f Q).map (Over.forget S)
      have hflat : Flat (pullback.fst f Q).left :=
        MorphismProperty.of_isPullback (P := @Flat) hp.flip inferInstance
      have hsurj : Surjective (pullback.fst f Q).left :=
        MorphismProperty.of_isPullback (P := @Surjective) hp.flip inferInstance
      have hfp : LocallyOfFinitePresentation (pullback.fst f Q).left :=
        MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation) hp.flip inferInstance
      exact Scheme.Hom.singleton_mem_fppfPrecoverage _
    · have hh := congrArg
        (fun z ↦ z.app (op (pullback f Q)) (ULift.up (pullback.snd f Q))) hη
      exact hh.trans (congrArg ULift.up (pullback.condition (f := f) (g := Q)).symm)
  · intro G
    have hG : Presieve.IsSheafFor G.obj (Presieve.singleton Q) := by
      let F := G.obj
      have hg : Presieve.IsSheaf (Scheme.fppfTopology.over S) F :=
        (isSheaf_iff_isSheaf_of_type _ _).mp G.property
      rw [over_toGrothendieck_eq_toGrothendieck_comap_forget] at hg
      exact hg.isSheafFor_of_mem_precoverage coverQ
    constructor
    · intro k₁ k₂ h
      apply uliftYonedaEquiv.{max (u + 1) v}.injective
      apply (Presieve.isSeparatedFor_singleton.mp hG.isSeparatedFor)
      rw [uliftYonedaEquiv_naturality, uliftYonedaEquiv_naturality]
      simp only [Quiver.Hom.unop_op]
      apply congrArg uliftYonedaEquiv
      rw [← hη, Category.assoc, Category.assoc]
      exact congrArg (fun f ↦ π ≫ f) h
    · intro α
      let β := π ≫ α
      let z := uliftYonedaEquiv.{max (u + 1) v} β
      have hb : us ≫ β = ut ≫ β := by
        dsimp only [β]
        rw [← Category.assoc, ← Category.assoc]
        exact congrArg (fun f ↦ f ≫ α) (coequalizer.condition us ut)
      have hz : ∀ {Z : Over S} (p₁ p₂ : Z ⟶ Over.mk a),
          p₁ ≫ Q = p₂ ≫ Q → G.obj.map p₁.op z = G.obj.map p₂.op z := by
        intro Z p₁ p₂ h
        obtain ⟨r, hr, hr'⟩ := (rel Z p₁ p₂).mpr h
        dsimp only [z]
        rw [uliftYonedaEquiv_naturality, uliftYonedaEquiv_naturality]
        simp only [Quiver.Hom.unop_op]
        apply congrArg uliftYonedaEquiv
        rw [← hr, ← hr', Functor.map_comp, Functor.map_comp,
          Category.assoc, Category.assoc]
        exact congrArg (fun f ↦ uliftYoneda.map r ≫ f) hb
      obtain ⟨y, hy, _⟩ := (Presieve.isSheafFor_singleton.mp hG) z hz
      let γ := uliftYonedaEquiv.{max (u + 1) v}.symm y
      have hγ : uliftYoneda.map Q ≫ γ = β := by
        apply uliftYonedaEquiv.{max (u + 1) v}.injective
        change G.obj.map Q.op y = z
        exact hy
      refine ⟨γ, ?_⟩
      apply (cancel_epi π).mp
      rw [← Category.assoc, hη]
      exact hγ

end AlgebraicGeometry
