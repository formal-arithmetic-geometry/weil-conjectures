module

public import Sheaf.AlgebraicGeometry.Ample
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators

/-! # Global generation gives a cover by nonvanishing loci

Source: literature/stacks-project/modules.tex, Modules, Definition 01AM,
Lemma 01CY, and Sheaves Lemma 0H7H(2)
(blueprint: lem-sc-global-generation-nonvanishing-cover).
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry
open AlgebraicGeometry.Scheme
open AlgebraicGeometry.Scheme.Modules

universe u

namespace AlgebraicGeometry.Scheme.Modules

/-- If an invertible module is generated by global sections, their nonvanishing loci
cover the scheme.  Source: Stacks Project, Modules, Definition 01AM, Lemma 01CY,
and Sheaves Lemma 0H7H(2) (blueprint: lem-sc-global-generation-nonvanishing-cover).
Proof: Fix a point `x`. Invertibility (`def-sc-invertible-module`) gives a
neighbourhood `U` and a section `e` whose germ is a basis of the rank-one stalk.
The generating-sections condition (`def-weil-pbc-generating-sections`) lets us
shrink to a neighbourhood `V` where `e` is a finite linear combination of the
restrictions of generating global sections. Pass to the stalk and reduce modulo
its maximal ideal. The class of the basis is nonzero, so at least one generating
section has nonzero class. Its germ is outside the maximal ideal times the stalk,
so `x` belongs to its nonvanishing locus. Since `x` was arbitrary, these loci cover
`X`, i.e. `⋃ s, nonvanishingLocus L s = Set.univ`.
-/
theorem globalGeneration_nonvanishing_cover (X : Scheme.{u}) (L : X.Modules)
    [L.IsInvertible] (hL : Nonempty (SheafOfModules.GeneratingSections L)) :
    ⋃ (s : L.val.presheaf.obj (Opposite.op ⊤)), nonvanishingLocus L s = Set.univ := by
  sorry

end AlgebraicGeometry.Scheme.Modules
