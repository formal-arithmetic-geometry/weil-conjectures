module

public import Sheaf.AlgebraicGeometry.RegularNormalizedResolutionRule
public import Sheaf.TraceFormula.SharpeningFanBijection
public import Sheaf.AlgebraicGeometry.StrictEtaleLogBlowupProcedure

/-!
# The centered log resolution induced by a rational resolution rule

Source: ILO, Travaux de Gabber, VIII 3.2.19--3.2.21, 3.3.13--3.3.15,
3.4.9 and 3.4.15 (blueprint: def-per-induced-normalized-log-resolution).

Every descent is characterized by the original ordered ideals. In particular the
fan rule is tied to the rational scheme rule, and the log rule is tied to that
fan rule on every global chart. No choice from an existence theorem is made.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

/-- Identification of a monoscheme resolution's toric realization with a specified
scheme resolution. Both order equivalences are bijective: no stage is discarded.
The scheme arrows have the canonical monomial formulas, and the ring centers are
exactly the ideals generated by the monoscheme centers.
Source: ILO VIII 3.2.19 (blueprint: def-per-induced-normalized-log-resolution). -/
structure ToricResolutionIdentification (M : Monoscheme.ResolutionInput.{u})
    (R : Monoscheme.Resolution M) (X : QERationalResolutionInput.{u})
    (e : X.scheme ≅ Monoscheme.realization (ULift.{u} ℚ) M.monoscheme)
    (A : NormalizedResolutionOver X.scheme) where
  index : Fin (R.length + 1) ≃o Fin (A.length + 1)
  stage : Fin R.length ≃o Fin A.length
  first : index 0 = 0
  before : ∀ i, index i.castSucc = (stage i).castSucc
  after : ∀ i, index i.succ = (stage i).succ
  iso : ∀ i, Monoscheme.realization (ULift.{u} ℚ) (R.tower.level i) ≅
    A.tower.level (index i)
  base : (iso 0).hom ≫ eqToHom (congrArg A.tower.level first) ≫ A.initial.hom =
    eqToHom (congrArg (Monoscheme.realization (ULift.{u} ℚ)) R.base) ≫ e.inv
  arrow : ∀ i : Fin R.length,
    Monoscheme.realization (ULift.{u} ℚ) (R.tower.level i.succ) ⟶
      Monoscheme.realization (ULift.{u} ℚ) (R.tower.level i.castSucc)
  canonicalArrow : ∀ i, Monoscheme.IsRealizationMap (ULift.{u} ℚ) (R.tower.arrow i) (arrow i)
  commutes : ∀ i : Fin R.length,
    arrow i ≫ (iso i.castSucc).hom ≫ eqToHom (congrArg A.tower.level (before i)) =
      (iso i.succ).hom ≫ eqToHom (congrArg A.tower.level (after i)) ≫ A.tower.arrow (stage i)
  centers : ∀ i : Fin R.length,
    Monoscheme.ringIdeal (ULift.{u} ℚ) (R.tower.center i) =
      (A.tower.center (stage i)).comap
        ((iso i.castSucc).hom ≫ eqToHom (congrArg A.tower.level (before i)))

/-- Noetherian fs log regular inputs, with no separation or excellence condition.
Unlike `IsLogRegularResolutionInput` in `StrictLogBlowupProcedure`, this domain
includes schemes that are not separated; the induced procedure is defined on all of them.
Source: ILO VIII 3.3.15, 3.4.9 (blueprint: def-per-induced-normalized-log-resolution). -/
def IsNoetherianLogRegularInput (X : FineSaturatedLogScheme.{u}) : Prop :=
  IsNoetherian X.scheme ∧ X.IsLogRegular

/-- A charted fan tower as an actual saturated log tower; all centers and arrows
are those of the given lift. Source: ILO VIII 3.3.13
(blueprint: def-per-induced-normalized-log-resolution). -/
def LogFanTower.toLogBlowupTower {n : ℕ} {T : FineFan.Tower.{u} n}
    (L : LogFanTower T) : SaturatedLogBlowupTower.{u} where
  length := n
  level := L.level
  arrow := L.arrow
  center i := (L.chart i.castSucc).pullbackIdeal (T.center i)
  isBlowup := L.blowup

/-- Attach the specified base to a lifted fan tower, without choosing another
blowup. Source: ILO VIII 3.3.13
(blueprint: def-per-induced-normalized-log-resolution). -/
def LogFanTower.toLogBlowupTowerOver {n : ℕ} {T : FineFan.Tower.{u} n}
    (L : LogFanTower T) (X : FineSaturatedLogScheme.{u}) (h : L.level 0 = X) :
    LogBlowupTowerOver X where
  tower := L.toLogBlowupTower
  initial := h

/-- The ring center is generated by the structural images of the log center.
Equality is tested in every geometric stalk, using the canonical strict-local
ring maps. This determines the quasi-coherent ideal itself, including its
scheme structure, rather than only its radical or its support.
Source: ILO VIII 3.3.13, 3.4.3--3.4.9
(blueprint: def-per-induced-normalized-log-resolution). -/
def IsRingIdealOfLogCenter (X : FineSaturatedLogScheme.{u})
    (I : X.logStructure.IdealFamily) (J : X.scheme.IdealSheafData) : Prop :=
  ∀ (V : X.scheme.affineOpens) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ X.scheme)
    (w : (Scheme.pointSmallEtale t).fiber.obj (Scheme.Etale.mk V.1.ι)),
    (J.ideal V).map
      ((strictLocalGerm X.scheme t (Scheme.Etale.mk V.1.ι) w).hom.comp
        V.1.topIso.inv.hom) =
      Ideal.span (X.logStructure.toEtalePrelogStructure.stalkAlpha t ''
        X.logStructure.idealStalk I t)

/-- The underlying normalized tower retains precisely the log tower's stages.
The ring centers have their prescribed generators, nonempty zero loci and
nowhere dense support. Source: ILO VIII 3.4.3--3.4.9, 2.3.2
(blueprint: def-per-induced-normalized-log-resolution). -/
structure UnderlyingNormalizedLogResolution {X : FineSaturatedLogScheme.{u}}
    (A : LogBlowupTowerOver X) where
  center : ∀ i : Fin A.tower.length, (A.tower.level i.castSucc).scheme.IdealSheafData
  generated : ∀ i,
    IsRingIdealOfLogCenter (A.tower.level i.castSucc) (A.tower.center i) (center i)
  reduced : ∀ i, IsReduced (A.tower.level i).scheme
  blowup : ∀ i, Monoscheme.IsNormalizedBlowup (A.tower.arrow i).base (center i)
  nonempty : ∀ i, Set.Nonempty ((center i).support : Set (A.tower.level i.castSucc).scheme)
  nowhereDense : ∀ i,
    IsNowhereDense ((center i).support : Set (A.tower.level i.castSucc).scheme)
  regularLast : IsRegularScheme (A.tower.level (Fin.last A.tower.length)).scheme

/-- Forget the log structure, keeping its actual scheme levels, maps and generated
ring ideals. Source: ILO VIII 3.4.9
(blueprint: def-per-induced-normalized-log-resolution). -/
def UnderlyingNormalizedLogResolution.toResolution {X : FineSaturatedLogScheme.{u}}
    {A : LogBlowupTowerOver X} (C : UnderlyingNormalizedLogResolution A) :
    NormalizedResolutionOver X.scheme where
  length := A.tower.length
  tower := {
    level i := (A.tower.level i).scheme
    reduced := C.reduced
    center := C.center
    arrow i := (A.tower.arrow i).base
    blowup := C.blowup }
  initial := eqToIso (congrArg FineSaturatedLogScheme.scheme A.initial)
  centers i := ⟨C.nonempty i, C.nowhereDense i⟩
  regularLast := C.regularLast

/-- The precise descent datum induced by a fixed scheme resolution algorithm.
Its monoscheme towers realize that algorithm, its fan rule sharpens those
monoscheme towers, and its global log rule is their contracted chart pullback.
The existing procedure supplies center-preserving strict etale comparisons and
identity/composition laws, including on finite disjoint unions. All log inputs
are fs and thus have torsion-free characteristic groups; this is recorded as a
property of the construction, never assumed of the input a second time.
Source: ILO VIII 3.2.19--3.2.21, 3.3.15, 3.4.9
(blueprint: def-per-induced-normalized-log-resolution). -/
structure InducedNormalizedLogResolution (F : RegularFunctorialNormalizedResolution.{u}) where
  monoschemeRule : Monoscheme.SmoothFunctorialDesingularization.{u}
  fanRule : FineFan.SmoothFunctorialDesingularization.{u}
  realizes : ∀ (M : Monoscheme.ResolutionInput.{u}) (X : QERationalResolutionInput.{u})
    (e : X.scheme ≅ Monoscheme.realization (ULift.{u} ℚ) M.monoscheme),
    e.hom ≫ Monoscheme.realizationToBase (ULift.{u} ℚ) M.monoscheme = X.structureMap →
      Nonempty (ToricResolutionIdentification M (monoschemeRule.resolution M) X e (F.resolution X))
  sharpens : Monoscheme.RuleSharpens monoschemeRule fanRule
  properFanCenters : ∀ (M : FineFan.ResolutionInput.{u})
    (i : Fin (fanRule.resolution M).length),
    (fanRule.resolution M).tower.center i ≠
      FineFan.wholeIdeal ((fanRule.resolution M).tower.level i.castSucc)
  logRule : StrictEtaleLogBlowupProcedure IsNoetherianLogRegularInput.{u}
  torsionFree : ∀ (X : FineSaturatedLogScheme.{u}),
    IsNoetherianLogRegularInput X → IsLogBlowupInput X
  onCharts : ∀ (X : FineSaturatedLogScheme.{u}) (hX : IsNoetherianLogRegularInput X)
    (M : FineFan.ResolutionInput.{u}) (c : LogFanChart X M.fan),
    ∃ L : LogFanTower (fanRule.resolution M).tower, ∃ h : L.level 0 = X,
      HEq (L.chart 0) c ∧
        ∃ f : EtaleLogHom X X, f.IsIdentity ∧
          Nonempty (LogBlowupComparison f
            (L.toLogBlowupTowerOver X h) (logRule.tower X hX))
  properLogCenters : ∀ (X : FineSaturatedLogScheme.{u}) (hX : IsNoetherianLogRegularInput X)
    (i : Fin (logRule.tower X hX).tower.length),
    (logRule.tower X hX).tower.center i ≠ fun _ ↦ Set.univ
  underlying : ∀ (X : FineSaturatedLogScheme.{u}) (hX : IsNoetherianLogRegularInput X),
    UnderlyingNormalizedLogResolution (logRule.tower X hX)

/-- Equality of centered normalized towers over an isomorphism of their bases.
The length equality and the existing synchronized `CenterIso` retain every
stage in its original order, without componentwise or other contraction.
`HEq` transports only along the displayed length equality.
Source: ILO VIII Theorem 3.4.15
(blueprint: def-per-induced-normalized-log-resolution). -/
def NormalizedResolutionOver.IsIsoOver {Y X : Scheme.{u}}
    (A : NormalizedResolutionOver X) (B : NormalizedResolutionOver Y) (φ : Y ≅ X) : Prop :=
  ∃ h : B.length = A.length,
    ∃ e : Monoscheme.NormalizedTower.CenterIso (h ▸ B.tower) A.tower,
      HEq ((e.iso 0).hom ≫ A.initial.hom) (B.initial.hom ≫ φ.hom)

end AlgebraicGeometry
