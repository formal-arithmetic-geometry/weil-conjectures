module

public import WeilConjectures.AlgebraicGeometry.Modules.PullbackFreeGenerator
public import WeilConjectures.AlgebraicGeometry.Modules.ZeroLocus
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible
public import Mathlib.AlgebraicGeometry.Properties
import WeilConjectures.AlgebraicGeometry.EffectiveCartier

/-!
# Nonzero sections on integral schemes

Source: `literature/stacks-project/divisors.tex`, Lemma 02OR (blueprint:
`lem-pc-nonzero-section-integral-cartier`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry

namespace Scheme

namespace Modules

variable {X : Scheme.{u}}

/-- A nonzero section of an invertible module on an integral scheme has an effective
Cartier zero scheme, with the expected local equation on each affine trivialization.

Source: Stacks Project, Divisors, Lemma 02OR
(blueprint: lem-pc-nonzero-section-integral-cartier).

Proof: the section morphism is nonzero because its value on `1` over `X` is `s`.
Its zero-locus ideal is locally principal and nonzero by the zero-locus properties.
On an integral scheme, the source library proves that such an ideal is invertible.
On any affine trivialization, the zero-locus ideal is generated by the coefficient of
`s`; every affine generator of an invertible ideal is a nonzerodivisor. Since the
open is nonempty, its ring of sections is a domain, so this coefficient is nonzero.
-/
theorem nonzero_section_integral_cartier [IsIntegral X] (M : X.Modules)
    [M.IsInvertible] (s : Γ(M, ⊤)) (hs : s ≠ 0) :
    (∀ (U : X.affineOpens) (_ : Nonempty U.1) (e : Γ(M, U.1))
      (he : IsFreeGenerator e),
        IsFreeGenerator.coeff (M := M) (U := U.1) (e := e) he
            (M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s) ≠ 0 ∧
          (homOfGlobalSection M s).zeroLocus.ideal U =
            Ideal.span {IsFreeGenerator.coeff (M := M) (U := U.1) (e := e) he
              (M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s)} ∧
          IsFreeGenerator.coeff (M := M) (U := U.1) (e := e) he
              (M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s) ∈
            nonZeroDivisors Γ(X, U.1)) ∧
      (homOfGlobalSection M s).zeroLocus.IsInvertible := by
  have : SheafOfModules.IsInvertible.{u, u, u} M :=
    IsInvertible.sheafOfModules_isInvertible M
  have : SheafOfModules.IsInvertible.{u, u, u} (Modules.unit X) :=
    IsInvertible.sheafOfModules_isInvertible
      (CategoryTheory.MonoidalCategory.tensorUnit X.Modules)
  have hφ : homOfGlobalSection M s ≠ 0 := by
    intro h
    have htop := homOfGlobalSection_app_one M s ⊤
    rw [h] at htop
    apply hs
    simpa using htop.symm
  have hJ : (homOfGlobalSection M s).zeroLocus.IsInvertible :=
    (homOfGlobalSection M s).isLocallyPrincipal_zeroLocus.isInvertible
      (fun h ↦ hφ ((homOfGlobalSection M s).zeroLocus_eq_bot_iff.mp h))
  refine ⟨?_, hJ⟩
  intro U hU e he
  let : Nonempty U.1 := hU
  have hlocal := (homOfGlobalSection M s).ideal_zeroLocus U
    (isFreeGenerator_one U.1) he
    (b := he.coeff (M.presheaf.map (homOfLE le_top).op s)) (by
      rw [homOfGlobalSection_app_one]
      exact (he.coeff_smul _).symm)
  have hregular := hJ.mem_nonZeroDivisors hlocal
  exact ⟨nonZeroDivisors.ne_zero hregular, hlocal, hregular⟩

end Modules
end Scheme
end AlgebraicGeometry
