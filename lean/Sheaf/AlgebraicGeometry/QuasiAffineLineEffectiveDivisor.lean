module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.AlgebraicGeometry.OpenImmersion
public import WeilConjectures.AlgebraicGeometry.Modules.Invertible
public import WeilConjectures.AlgebraicGeometry.EffectiveCartier
import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible
import WeilConjectures.AlgebraicGeometry.Modules.ZeroLocus

/-!
# Effective Cartier presentation of a line bundle on a Noetherian quasi-affine scheme

Source: Stacks Project, Divisors, Tag 0AYM,
`lemma-quasi-projective-Noetherian-pic-effective-Cartier`, quasi-affine clause.
(blueprint: lem-sfb-quasiaffine-line-effective-divisor).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.Modules

/-- An invertible module on a quasi-compact locally Noetherian scheme admitting an open
immersion into an affine scheme is the line bundle of an effective Cartier divisor.
The divisor is represented by its ideal sheaf `J`; its associated module is `dual J.toModules`.
The unit ideal represents the empty divisor, and the empty scheme is allowed.

Source: Stacks Project, Divisors, Tag 0AYM,
`lemma-quasi-projective-Noetherian-pic-effective-Cartier`, quasi-affine paragraph.
(blueprint: lem-sfb-quasiaffine-line-effective-divisor).

Proof:
1. By lem-sfb-noetherian-associated-points-finite, the associated points of `V` form a
   finite set, using local Noetherianity and quasi-compactness. Include embedded points.
2. Apply lem-sfb-quasiaffine-invertible-finite-set-section to `M` and this finite set.
   The given open immersion into an affine scheme and compactness are its hypotheses.
   Obtain a global section whose image in every associated-point fibre is nonzero.
3. By lem-sfb-invertible-section-associated-criterion, on every affine trivializing open
   the coefficient of this section is a nonzerodivisor.
4. Form its zero scheme by def-pc-zero-scheme. Locally its ideal is generated by that
   coefficient, so it is an effective Cartier ideal (def-nagata-effective-cartier-ideal).
   Its associated line bundle is the dual ideal (def-pc-divisor-line-bundle).
   The final assertion of lem-pc-zero-scheme-divisor-iso identifies `M` with this dual.
   On the empty scheme the construction has empty zero scheme; a nowhere-vanishing
   section gives the unit ideal and thus the empty divisor.
-/
theorem exists_invertibleIdeal_iso_dual_of_openImmersion_affine
    (V A : Scheme.{u}) [IsLocallyNoetherian V] [CompactSpace V] [IsAffine A]
    (j : V ⟶ A) [IsOpenImmersion j] (M : V.Modules) [M.IsInvertible] :
    ∃ J : V.IdealSheafData, J.IsInvertible ∧ Nonempty (M ≅ dual J.toModules) := by
  sorry

end AlgebraicGeometry.Scheme.Modules
