module

public import Sheaf.AlgebraicGeometry.SchemeActionFixedIdeal
public import Sheaf.AlgebraicGeometry.GeometricLocalTangent
public import Sheaf.AlgebraicGeometry.StrictNormalCrossingsBoundary
public import Sheaf.AlgebraicGeometry.AdaptedNormalCrossingsCenter
import Sheaf.AlgebraicGeometry.SNCBoundaryParameterCriterion
import Sheaf.TraceFormula.EtaleComponentCoordinateIdentification
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.RingTheory.RegularLocalRing.Defs
import WeilConjectures.RingTheory.RegularLocalQuotientKernelParameters

/-! # Tame fixed families and strict boundaries

Source: ILO VI 4.1--4.2, printed pp.76--77; VIII 4.2.3, printed p.119
(blueprint: lem-per-tame-fixed-family-transversality).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u v
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry

/-- Fixed subschemes of nontrivial subgroups form a weakly boundary-normal-crossings family.
The finite family C lists exactly the reduced irreducible components of B. The existing
adapted-center predicate uses one regular parameter system for the center and all boundary
components through each point; it permits shared parameters and the empty center.

Source: ILO VI 4.1--4.2 and VIII 4.2.3
(blueprint: lem-per-tame-fixed-family-transversality).

Proof:
1. Each equalizer is the pullback of the closed diagonal. Summing its ideals represents
   simultaneous fixedness on all scheme-valued tests, including nonreduced ones. Being
   fixed by H and K is equivalent to being fixed by their generated subgroup. Conjugating
   the equations gives the asserted equality of ideals under inverse pullback.
2. At a fixed point the stalk ideal is generated by h(r)-r. The residue action is trivial
   and the subgroup order is a unit, by geometric tameness. Apply
   lem-per-tame-fixed-local-regularity: the quotient is regular, and its cotangent space is
   T/D with D spanned by (h-1)T. The dual inclusion has precisely the invariant functionals
   as image. Finite linear equations commute with extension to the geometric residue field.
3. Use lem-sfb-snc-boundary-parameter-criterion and
   lem-trf-etale-component-coordinate-identification to obtain boundary parameters.
   G-strictness makes every component through the fixed point subgroup-stable, hence its
   cotangent line has a character. Reynolds averaging splits T into invariants and D.
   A boundary parameter with nontrivial character lies in the fixed ideal: h(t)-t=(u-1)t
   and u-1 is a unit for some h.
4. Extend these boundary classes separately to bases of D and the invariant complement.
   Lift the D-basis inside the fixed ideal. By lem-weil-pbc-regular-local-cotangent-dimension
   and lem-weil-pbc-nakayama-local-generators the lifts form a full parameter system.
   Apply lem-weil-pbc-regular-local-quotient-kernel-parameters: the map I/mI to T is injective
   with image D, so Nakayama shows that the chosen D-parameters generate I. Spread the
   equations to an affine neighbourhood. This is HasAdaptedNormalCrossingsCenter.
5. The fixed supports miss the given dense free open, so they are nowhere dense.
   Their finite union is closed and invariant. Its complement is free, since every
   nontrivial geometric stabilizer contributes a subgroup fixed point, and contains every
   free open. Finite nonempty intersections are the fixed loci of generated nontrivial
   subgroups, so all the same regularity and adapted-coordinate assertions apply. -/
theorem tame_fixed_family_transversality
    {X : Scheme.{u}} [IsNoetherian X] [X.IsSeparated] (hX : IsRegularScheme X)
    (B : X.IdealSheafData) (hB : IsStrictNormalCrossingsBoundary B)
    {G : Type v} [Group G] [Finite G] (a : G →* Aut X)
    (hpres : ∀ g : G, B.comap (a g).hom = B)
    (htame : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X),
      IsUnit (Nat.card {g : G // t ≫ (a g).hom = t} : Ω))
    (hgen : ∃ U : X.Opens, Dense (U : Set X) ∧
      (∀ (g : G) (x : X), (a g).hom x ∈ U ↔ x ∈ U) ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X)
        (g : G), t (IsLocalRing.closedPoint Ω) ∈ U → t ≫ (a g).hom = t → g = 1)
    (hstrict : ∀ C ∈ irreducibleComponents B.subscheme, ∀ g : G,
      (a g).hom '' (B.subschemeι '' C) = B.subschemeι '' C ∨
        Disjoint ((a g).hom '' (B.subschemeι '' C)) (B.subschemeι '' C)) :
    (∀ (H : Subgroup G) (T : Scheme.{u}) (f : T ⟶ X),
      (schemeActionFixedIdeal a H).comap f = ⊥ ↔ ∀ h : H, f ≫ (a h).hom = f) ∧
    (∀ H K : Subgroup G,
      schemeActionFixedIdeal a H ⊔ schemeActionFixedIdeal a K =
        schemeActionFixedIdeal a (H ⊔ K)) ∧
    (∀ (g : G) (H : Subgroup G),
      (schemeActionFixedIdeal a H).comap (a g⁻¹).hom =
        schemeActionFixedIdeal a (H.map (MulAut.conj g).toMonoidHom)) ∧
    (∃ (n : ℕ) (C : Fin n → X.IdealSheafData),
      (∀ i, IsIntegral (C i).subscheme ∧ IsRegularScheme (C i).subscheme) ∧
      (∀ i : Fin n, ∃ Z : Set B.subscheme,
        Z ∈ irreducibleComponents B.subscheme ∧
          ((C i).support : Set X) = B.subschemeι '' Z) ∧
      (∀ Z ∈ irreducibleComponents B.subscheme,
        ∃! i : Fin n, ((C i).support : Set X) = B.subschemeι '' Z) ∧
      (∀ H : Subgroup G, H ≠ ⊥ →
        IsRegularScheme (schemeActionFixedIdeal a H).subscheme ∧
        interior ((schemeActionFixedIdeal a H).support : Set X) = ∅ ∧
        HasAdaptedNormalCrossingsCenter (schemeActionFixedIdeal a H) C) ∧
      ∀ s : Finset (Subgroup G), s.Nonempty → (∀ H ∈ s, H ≠ ⊥) →
        IsRegularScheme (⨆ H ∈ s, schemeActionFixedIdeal a H).subscheme ∧
        interior ((⨆ H ∈ s, schemeActionFixedIdeal a H).support : Set X) = ∅ ∧
        HasAdaptedNormalCrossingsCenter (⨆ H ∈ s, schemeActionFixedIdeal a H) C) ∧
    (∀ (H : Subgroup G) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (t : Spec (.of Ω) ⟶ (schemeActionFixedIdeal a H).subscheme),
      Function.Injective (fun φ : geometricLocalTangent t ↦
        φ.val.comp (localCotangentMap (schemeActionFixedIdeal a H).subschemeι
          (t (IsLocalRing.closedPoint Ω)))) ∧
      Set.range (fun φ : geometricLocalTangent t ↦
        φ.val.comp (localCotangentMap (schemeActionFixedIdeal a H).subschemeι
          (t (IsLocalRing.closedPoint Ω)))) =
        {φ | φ ∈ geometricLocalTangent (t ≫ (schemeActionFixedIdeal a H).subschemeι) ∧
          ∀ h : H, HEq
            (φ.comp (localCotangentMap (a h).hom
              ((t ≫ (schemeActionFixedIdeal a H).subschemeι)
                (IsLocalRing.closedPoint Ω)))) φ}) ∧
    ∃ U : X.Opens,
      (⋃ H : {H : Subgroup G // H ≠ ⊥},
        ((schemeActionFixedIdeal a H.val).support : Set X)) = (U : Set X)ᶜ ∧
      (∀ (g : G) (x : X), (a g).hom x ∈ U ↔ x ∈ U) ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X)
        (g : G), t (IsLocalRing.closedPoint Ω) ∈ U → t ≫ (a g).hom = t → g = 1) ∧
      ∀ V : X.Opens,
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X)
          (g : G), t (IsLocalRing.closedPoint Ω) ∈ V → t ≫ (a g).hom = t → g = 1) → V ≤ U := by
  sorry

end AlgebraicGeometry
