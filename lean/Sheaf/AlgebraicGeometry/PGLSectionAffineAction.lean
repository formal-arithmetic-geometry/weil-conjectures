module

public import Sheaf.AlgebraicGeometry.AffinePGLAction
public import WeilConjectures.AlgebraicGeometry.Morphisms.Projective
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType

/-! # The affine action induced by a linearization on the section algebra

Source: Mumford--Fogarty--Kirwan, GIT, Chapter 1, Section 1 and Appendix 1.C.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.PGLLinearization

variable {k : Type u} [Field k]

/-- A projective linearization induces an algebraic action on the spectrum of
its section ring. Its fixed subring is the ring generated by the homogeneous
invariant sections, with the specified structural constants.

Source: MFK, GIT, Chapter 1, Section 1 and Appendix 1.C
(blueprint: lem-sfb-pgl-section-affine-action).

Proof: Take the universal matrix over the affine group GL_r. Pull sections back
by its action on GL_r times X and use the tensor-power linearization to compare
with the pullback along the projection. Flat base change for global sections
identifies sections on GL_r times X with k[GL_r] tensor H^0(X,L^n).
The unit and multiplication identities for the line linearization imply the
coaction identities on each degree. Compatibility of tensor multiplication and
monoidal pullback makes their direct sum a coaction on the section ring.
Its counit and comultiplication induce the natural scheme action on Spec S;
trivial scalar action on the line makes this a PGL action. Constants are fixed
because the original scheme and line maps are over k. A homogeneous element
is fixed precisely when its pulled-back section satisfies IsInvariant: apply
the universal matrix for one direction and pull back to every test scheme for
the other. The coaction preserves degrees. Thus each homogeneous component of
a fixed element is fixed, and summing the finitely many components identifies
the fixed ring with invariantRing. Flat base change and direct-sum identities
also apply to the zero ring and to nonreduced schemes. -/
theorem section_affine_action
    (r : ℕ) (X : Over (Spec (.of k)))
    (hprojective : IsHProjective X.hom)
    (hfiniteType : LocallyOfFiniteType X.hom ∧ QuasiCompact X.hom)
    (L : X.left.Modules) [L.IsInvertible] (E : Action k r X L)
    (ρ : k →+* Scheme.Modules.InvertibleSectionRing L)
    (hρ : ∀ c : k, ρ c = constantSection (Z := X) (L := L) c) :
    letI := ρ.toAlgebra
    ∃ D : AffinePGL.Action k (Scheme.Modules.InvertibleSectionRing L) r,
      D.invariants = E.invariantRing := by
  sorry

end AlgebraicGeometry.PGLLinearization
