import Sheaf.GroupTheory.FineMonoidFiniteSaturation
import Sheaf.TraceFormula.FsFaceSharpening
import Sheaf.CategoryTheory.SiteCoveringAxioms
import Mathlib.CategoryTheory.Sites.LeftExact
import Mathlib.Topology.Sheaves.Stalks
import Mathlib.Geometry.RingedSpace.SheafedSpace
import Mathlib.Algebra.Category.MonCat.FilteredColimits
import Mathlib.Algebra.Category.MonCat.Limits
import Mathlib.Algebra.Group.Ideal
import Mathlib.Algebra.Group.Units.Hom
import Mathlib.GroupTheory.Subgroup.Saturated

/-!
# Fine fans and saturated blowup towers

Source: ILO, Exposé VIII, 3.1.2--3.1.26 (blueprint: def-trf-fine-fan-blowup).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor TopologicalSpace Opposite
namespace AlgebraicGeometry
namespace FineFan
/-- Filtered colimits use Mathlib's explicit monoid quotient construction.
Source: ILO VIII 3.1.6, germs (blueprint: def-trf-fine-fan-blowup). -/
noncomputable instance monoidFilteredColimits (J : Type u) [SmallCategory J] [IsFiltered J] :
    HasColimitsOfShape J CommMonCat.{u} :=
  ⟨fun D ↦ ⟨⟨_, CommMonCat.FilteredColimits.colimitCoconeIsColimit D⟩⟩⟩

/-- Fine monoids: finite generation and injectivity into the canonical completion.
Source: ILO VIII 3.1.2--3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
def IsFine (P : Type u) [CommMonoid P] : Prop :=
  Monoid.FG P ∧ Function.Injective (Algebra.GrothendieckGroup.of (M := P))

/-- Sharp means that every unit is the identity. Multiplicative notation here is the
`Multiplicative` presentation of the additive notation in the node.
Source: ILO VIII 3.1.1 (blueprint: def-trf-fine-fan-blowup). -/
def IsSharp (P : Type u) [CommMonoid P] : Prop := ∀ p : P, IsUnit p → p = 1

/-- The saturation of a submonoid in its specified ambient group. The root subset is
already closed under multiplication; closure is an equivalent proof-free construction.
Source: ILO VIII 3.1.17 (blueprint: def-trf-fine-fan-blowup). -/
def saturation {G : Type u} [CommGroup G] (Q : Submonoid G) : Submonoid G :=
  Submonoid.closure {g | ∃ n : ℕ, 0 < n ∧ g ^ n ∈ Q}

/-- Prime ideals, including the empty prime, are proper with multiplicative complement.
Source: ILO VIII 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
structure MonoidPrime (P : Type u) [CommMonoid P] extends SemigroupIdeal P where
  proper : carrier ≠ Set.univ
  complement_mul : ∀ a b : P, a ∉ carrier → b ∉ carrier → a * b ∉ carrier

/-- The monoid spectrum has the topology generated by `D(a)`.
Source: ILO VIII 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
instance spectrumTopology (P : Type u) [CommMonoid P] : TopologicalSpace (MonoidPrime P) :=
  TopologicalSpace.generateFrom (Set.range (fun a : P ↦ {p | a ∉ p.carrier}))

/-- The principal open `D(a)`, with its generated-topology openness witness.
Source: ILO VIII 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
def basicOpen {P : Type u} [CommMonoid P] (a : P) : Opens (MonoidPrime P) :=
  ⟨{p | a ∉ p.carrier}, TopologicalSpace.isOpen_generateFrom_of_mem ⟨a, rfl⟩⟩

/-- Sections are compatible point-local fractions. On a fine spectrum every nonempty
open contains the generic point, so compatibility is equality in the ambient completion.
The empty open has exactly one such empty family. On `D(a)` these are precisely `P[a⁻¹]`.
Source: ILO VIII 3.1.3--3.1.4 (blueprint: def-trf-fine-fan-blowup). -/
def spectrumSections {P : Type u} [CommMonoid P] (U : Opens (MonoidPrime P)) :
    Submonoid (U → Algebra.GrothendieckGroup P) where
  carrier := {s | (∀ x : U, s x ∈ Algebra.faceLocalization P
      (Submonoid.closure {a | a ∉ x.1.carrier})) ∧ ∀ x y : U, s x = s y}
  one_mem' := ⟨fun _ ↦ Submonoid.one_mem _, fun _ _ ↦ rfl⟩
  mul_mem' := fun hs ht ↦
    ⟨fun x ↦ Submonoid.mul_mem _ (hs.1 x) (ht.1 x),
      fun x y ↦ congrArg₂ (· * ·) (hs.2 x y) (ht.2 x y)⟩

/-- Restriction is restriction of the point-local fraction family.
Source: ILO VIII 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
def spectrumRestriction {P : Type u} [CommMonoid P]
    {U V : Opens (MonoidPrime P)} (h : V ≤ U) : spectrumSections U →* spectrumSections V where
  toFun s := ⟨fun x ↦ s.1 ⟨x.1, h x.2⟩,
    ⟨fun x ↦ s.2.1 ⟨x.1, h x.2⟩, fun _x _y ↦ s.2.2 _ _⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The presheaf of compatible local fractions; its sheafification is the monoid sheaf.
Source: ILO VIII 3.1.3--3.1.4 (blueprint: def-trf-fine-fan-blowup). -/
def spectrumPresheaf (P : Type u) [CommMonoid P] :
    (Opens (MonoidPrime P))ᵒᵖ ⥤ CommMonCat.{u} where
  obj U := CommMonCat.of (spectrumSections U.unop)
  map f := CommMonCat.ofHom (spectrumRestriction f.unop.le)
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The canonical associated monoid sheaf of local fractions.
Source: ILO VIII 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def spectrumSheaf (P : Type u) [CommMonoid P] :
    TopCat.Sheaf CommMonCat.{u} (TopCat.of (MonoidPrime P)) :=
  (presheafToSheaf (Opens.grothendieckTopology (MonoidPrime P)) CommMonCat).obj
    (spectrumPresheaf P)

/-- The map on quotients by units, induced by a monoid homomorphism.
Source: ILO VIII 3.1.1 (blueprint: def-trf-fine-fan-blowup). -/
def sharpenMap {P Q : Type u} [CommMonoid P] [CommMonoid Q] (f : P →* Q) :
    Associates P →* Associates Q where
  toFun := Quotient.map f (fun _ _ h ↦ h.map f)
  map_one' := congrArg Associates.mk f.map_one
  map_mul' x y := Quotient.inductionOn₂ x y (fun a b ↦ congrArg Associates.mk (f.map_mul a b))

/-- The sectionwise quotient by units, before sheafification.
Source: ILO VIII 3.1.1 and 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
def sharpPresheaf {X : TopCat.{u}} (M : TopCat.Presheaf CommMonCat.{u} X) :
    TopCat.Presheaf CommMonCat.{u} X where
  obj U := CommMonCat.of (Associates (M.obj U))
  map f := CommMonCat.ofHom (sharpenMap (M.map f).hom)
  map_id U := by
    ext x
    refine Quotient.inductionOn x ?_
    intro a
    change Associates.mk (M.map (𝟙 U) a) = Associates.mk a
    rw [M.map_id]
    rfl
  map_comp f g := by
    ext x
    refine Quotient.inductionOn x ?_
    intro a
    change Associates.mk (M.map (f ≫ g) a) = Associates.mk (M.map g (M.map f a))
    rw [M.map_comp]
    rfl

/-- Sharpening is sheafification of the sectionwise unit quotient, with induced operations.
Source: ILO VIII 3.1.1 and 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def sharpSheaf {X : TopCat.{u}} (M : TopCat.Presheaf CommMonCat.{u} X) :
    TopCat.Sheaf CommMonCat.{u} X :=
  (presheafToSheaf (Opens.grothendieckTopology X) CommMonCat).obj (sharpPresheaf M)

/-- The affine sharp monoidal space of a monoid.
Source: ILO VIII 3.1.3 and 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def affine (P : Type u) [CommMonoid P] : SheafedSpace CommMonCat.{u} where
  carrier := TopCat.of (MonoidPrime P)
  presheaf := (sharpSheaf (spectrumSheaf P).obj).obj
  IsSheaf := (sharpSheaf (spectrumSheaf P).obj).property

/-- Neighbourhood diagram defining actual germs of monoid sections.
Source: ILO VIII 3.1.6 (blueprint: def-trf-fine-fan-blowup). -/
def stalkDiagram {X : TopCat.{u}} (M : TopCat.Presheaf CommMonCat.{u} X) (x : X) :
    (OpenNhds x)ᵒᵖ ⥤ CommMonCat.{u} := (OpenNhds.inclusion x).op ⋙ M

/-- The monoid stalk is the filtered colimit, hence germs modulo local equality.
Source: ILO VIII 3.1.6 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def stalk {X : TopCat.{u}} (M : TopCat.Presheaf CommMonCat.{u} X) (x : X) :
    CommMonCat.{u} := colimit (stalkDiagram M x)

/-- The canonical germ of a section.
Source: ILO VIII 3.1.6 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def germ {X : TopCat.{u}} (M : TopCat.Presheaf CommMonCat.{u} X)
    (U : Opens X) (x : X) (hx : x ∈ U) : M.obj (op U) ⟶ stalk M x :=
  colimit.ι (stalkDiagram M x) (op ⟨U, hx⟩)

/-- The stalk map induced by section maps and inverse images of neighbourhoods.
Source: ILO VIII 3.1.5--3.1.6 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def stalkMap {X Y : SheafedSpace CommMonCat.{u}} (f : X ⟶ Y) (x : X) :
    stalk Y.presheaf (f.hom.base x) ⟶ stalk X.presheaf x :=
  colim.map (whiskerLeft (OpenNhds.inclusion (f.hom.base x)).op f.hom.c) ≫
    colim.map (whiskerRight
      (NatTrans.op (OpenNhds.inclusionMapIso f.hom.base x).inv) X.presheaf) ≫
      colimit.pre (stalkDiagram X.presheaf x) (OpenNhds.map f.hom.base x).op

/-- A fan morphism is a sheafed-space morphism local at every stalk.
Source: ILO VIII 3.1.6 and 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
def IsLocalMorphism {X Y : SheafedSpace CommMonCat.{u}} (f : X ⟶ Y) : Prop :=
  ∀ x : X, IsLocalHom (stalkMap f x).hom

/-- Affine fan charts are actual isomorphisms of sharp monoidal spaces onto opens.
Source: ILO VIII 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
structure Chart (X : SheafedSpace CommMonCat.{u}) where
  openSet : Opens X
  monoid : CommMonCat.{u}
  fine : IsFine monoid
  iso : X.restrict openSet.isOpenEmbedding ≅ affine monoid

/-- A fine fan is a sharp monoidal space locally modeled by fine monoid spectra.
Source: ILO VIII 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
structure Fan where
  space : SheafedSpace CommMonCat.{u}
  sharp : ∀ x : space, IsSharp (stalk space.presheaf x)
  locallyAffine : ∀ x : space, ∃ c : Chart space, x ∈ c.openSet

/-- Torsion-freeness is tested on all characteristic group completions.
Source: ILO VIII 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
def Fan.IsTorsionFree (F : Fan.{u}) : Prop :=
  ∀ (x : F.space) (g : Algebra.GrothendieckGroup (stalk F.space.presheaf x))
    (n : ℕ), 0 < n → g ^ n = 1 → g = 1

/-- A fan is saturated if every characteristic stalk is saturated.
Source: ILO VIII 3.1.17 (blueprint: def-trf-fine-fan-blowup). -/
def Fan.IsSaturated (F : Fan.{u}) : Prop :=
  ∀ x : F.space,
    (MonoidHom.mrange
      (Algebra.GrothendieckGroup.of (M := stalk F.space.presheaf x))).PowSaturated

/-- A smooth fan has stalks freely generated by a finite set, including rank zero.
Source: ILO VIII 3.1.15 (blueprint: def-trf-fine-fan-blowup). -/
def Fan.IsSmooth (F : Fan.{u}) : Prop :=
  ∀ x : F.space, ∃ r : ℕ, Nonempty ((stalk F.space.presheaf x) ≃*
    Multiplicative (Fin r → ℕ))

/-- Morphisms retain the continuous map, all section maps, and their locality.
Source: ILO VIII 3.1.6 and 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
structure Hom (G F : Fan.{u}) where
  map : G.space ⟶ F.space
  isLocal : IsLocalMorphism map

/-- Smooth stalk maps are the canonical first-factor inclusions up to isomorphism.
Source: ILO VIII 3.1.13--3.1.15 (blueprint: def-trf-fine-fan-blowup). -/
def Hom.IsSmooth {G F : Fan.{u}} (f : Hom G F) : Prop :=
  ∀ x : G.space, ∃ r : ℕ,
    ∃ e : ((stalk F.space.presheaf (f.map.hom.base x)) × Multiplicative (Fin r → ℕ)) ≃*
      (stalk G.space.presheaf x),
      ∀ p, e (p, 1) = stalkMap f.map x p

/-- Finite affine covers include the empty cover of the empty fan.
Source: ILO VIII 3.1.3 and 3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
def Fan.HasFiniteAffineCover (F : Fan.{u}) : Prop :=
  ∃ n : ℕ, ∃ c : Fin n → Chart F.space, ∀ x : F.space, ∃ i : Fin n, x ∈ (c i).openSet

/-- Constant numerators, regarded as global compatible local fractions.
Source: ILO VIII 3.1.3 (blueprint: def-trf-fine-fan-blowup). -/
def numerator (P : Type u) [CommMonoid P] : P →* spectrumSections (⊤ : Opens (MonoidPrime P)) where
  toFun a := ⟨fun _ ↦ Algebra.GrothendieckGroup.of a,
    ⟨fun _ ↦ ⟨a, ⟨1, Submonoid.one_mem _⟩, by simp⟩, fun _ _ ↦ rfl⟩⟩
  map_one' := by ext; exact map_one _
  map_mul' a b := by ext; exact map_mul _ a b

/-- Canonical global sections of the affine sharp monoidal model. Both sheafification
units and the actual unit quotient occur in this map; no arbitrary chart map is chosen.
Source: ILO VIII 3.1.3 and 3.1.8 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def affineSection (P : Type u) [CommMonoid P] :
    P →* (affine P).presheaf.obj (op ⊤) :=
  (((toSheafify (Opens.grothendieckTopology (MonoidPrime P))
    (sharpPresheaf (spectrumSheaf P).obj)).app (op ⊤)).hom).comp
    (Associates.mkMonoidHom.comp
      ((((toSheafify (Opens.grothendieckTopology (MonoidPrime P))
        (spectrumPresheaf P)).app (op ⊤)).hom).comp (numerator P)))

/-- The canonical germ of an element of an affine chart monoid.
Source: ILO VIII 3.1.3 and 3.1.6 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def affineGerm {P : Type u} [CommMonoid P] (x : MonoidPrime P) :
    P →* stalk (affine P).presheaf x :=
  (germ (affine P).presheaf ⊤ x (by trivial)).hom.comp (affineSection P)

/-- The map of affine models induced by a specified monoid map: inverse image of prime
ideals, and the canonical map on germs of every numerator. These equations determine the
map, including its maps on all localized sections.
Source: ILO VIII 3.1.3 and 3.1.8 (blueprint: def-trf-fine-fan-blowup). -/
def IsAffineMap {P Q : Type u} [CommMonoid P] [CommMonoid Q]
    (φ : P →* Q) (f : affine Q ⟶ affine P) : Prop :=
  (∀ (x : MonoidPrime Q) (a : P),
    a ∈ (f.hom.base x).carrier ↔ φ a ∈ x.carrier) ∧
  (∀ (x : MonoidPrime Q) (a : P),
    stalkMap f x (affineGerm (f.hom.base x) a) = affineGerm x (φ a))

/-- An affine open with a fixed coordinate monoid, rather than a chosen existential model.
Source: ILO VIII 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
structure AffineOpen (X : SheafedSpace CommMonCat.{u}) (P : Type u) [CommMonoid P] where
  openSet : Opens X
  iso : X.restrict openSet.isOpenEmbedding ≅ affine P

/-- The actual open inclusion, composed with the affine chart isomorphism.
Source: ILO VIII 3.1.9 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def AffineOpen.inclusion {X : SheafedSpace CommMonCat.{u}}
    {P : Type u} [CommMonoid P] (c : AffineOpen X P) : affine P ⟶ X :=
  c.iso.inv ≫ X.ofRestrict c.openSet.isOpenEmbedding

/-- Section sets of an ideal. The predicate `IsIdealSheaf` below imposes the subsheaf axioms.
Source: ILO VIII 3.1.18 (blueprint: def-trf-fine-fan-blowup). -/
def IdealFamily (F : Fan.{u}) := ∀ U : Opens F.space, Set (F.space.presheaf.obj (op U))

/-- Germs belonging to an ideal are germs of actual local ideal sections.
Source: ILO VIII 3.1.18 (blueprint: def-trf-fine-fan-blowup). -/
def idealStalk {F : Fan.{u}} (I : IdealFamily F) (x : F.space) :
    Set (stalk F.space.presheaf x) :=
  {t | ∃ (U : Opens F.space) (hx : x ∈ U) (s : F.space.presheaf.obj (op U)),
    s ∈ I U ∧ germ F.space.presheaf U x hx s = t}

/-- A subsheaf of ideals: multiplicative absorption, restriction, and local membership.
The local-membership clause, with the ambient sheaf, gives the subsheaf gluing axiom.
Source: ILO VIII 3.1.18 (blueprint: def-trf-fine-fan-blowup). -/
def IsIdealSheaf {F : Fan.{u}} (I : IdealFamily F) : Prop :=
  (∀ (U : Opens F.space) (s t : F.space.presheaf.obj (op U)), s ∈ I U → s * t ∈ I U) ∧
  (∀ (U V : Opens F.space) (h : V ≤ U) (s : F.space.presheaf.obj (op U)),
    s ∈ I U → F.space.presheaf.map (homOfLE h).op s ∈ I V) ∧
  (∀ (U : Opens F.space) (s : F.space.presheaf.obj (op U)),
    (∀ (x : F.space) (hx : x ∈ U), germ F.space.presheaf U x hx s ∈ idealStalk I x) → s ∈ I U)

/-- Nonempty coherence is local generation by a finite nonempty list of sections.
Generation is tested on germs, so it means sheaf generation and not just global generation.
Source: ILO VIII 3.1.18 (blueprint: def-trf-fine-fan-blowup). -/
def IsNonemptyCoherentIdeal {F : Fan.{u}} (I : IdealFamily F) : Prop :=
  IsIdealSheaf I ∧ ∀ x : F.space,
    ∃ (U : Opens F.space) (_hx : x ∈ U) (n : ℕ) (_hn : 0 < n)
      (s : Fin n → F.space.presheaf.obj (op U)),
      (∀ i, s i ∈ I U) ∧
      ∀ (y : F.space) (hy : y ∈ U) (t : stalk F.space.presheaf y),
        t ∈ idealStalk I y ↔
          ∃ (i : Fin n) (q : stalk F.space.presheaf y),
            t = germ F.space.presheaf U y hy (s i) * q

/-- The ideal generated by the image under the fan morphism, computed locally on germs.
Source: ILO VIII 3.1.18 and 3.1.22 (blueprint: def-trf-fine-fan-blowup). -/
def pullbackAlong {G F : Fan.{u}} (f : G.space ⟶ F.space) (I : IdealFamily F) : IdealFamily G :=
  fun U ↦ {s | ∀ (x : G.space) (hx : x ∈ U),
    ∃ (t : stalk F.space.presheaf (f.hom.base x)) (_ht : t ∈ idealStalk I _)
      (q : stalk G.space.presheaf x),
      germ G.space.presheaf U x hx s = stalkMap f x t * q}

/-- Pullback along a local fan morphism, using the canonical ideal generated by its image.
Source: ILO VIII 3.1.18 (blueprint: def-trf-fine-fan-blowup). -/
def pullbackIdeal {G F : Fan.{u}} (f : Hom G F) (I : IdealFamily F) : IdealFamily G :=
  pullbackAlong f.map I

/-- The unit ideal is the entire monoid sheaf, including its unique empty-open section.
Source: ILO VIII 3.1.22 and 3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
def wholeIdeal (F : Fan.{u}) : IdealFamily F := fun _ ↦ Set.univ

/-- The unsaturated blowup chart is generated by `P` and the fractions `b/a` for `b ∈ E`.
Source: ILO VIII 3.1.19 (blueprint: def-trf-fine-fan-blowup). -/
def blowupChart (P : Type u) [CommMonoid P] (E : Finset P) (a : P) :
    Submonoid (Algebra.GrothendieckGroup P) :=
  Submonoid.closure (Set.range (Algebra.GrothendieckGroup.of (M := P)) ∪
    (fun b : P ↦ Algebra.GrothendieckGroup.of b / Algebra.GrothendieckGroup.of a) '' (E : Set P))

/-- The saturated blowup chart, inside the original canonical group completion.
Source: ILO VIII 3.1.17 and 3.1.21 (blueprint: def-trf-fine-fan-blowup). -/
def saturatedChart (P : Type u) [CommMonoid P] (E : Finset P) (a : P) :
    Submonoid (Algebra.GrothendieckGroup P) := saturation (blowupChart P E a)

/-- Canonical inclusion into root saturation; its data is the identity in the ambient group.
Source: ILO VIII 3.1.17 (blueprint: def-trf-fine-fan-blowup). -/
def intoSaturation {G : Type u} [CommGroup G] (Q : Submonoid G) : Q →* saturation Q where
  toFun q := ⟨q.1, Submonoid.subset_closure ⟨1, by decide, by simp only [pow_one]; exact q.2⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The canonical map from `P` to its saturated blowup chart.
Source: ILO VIII 3.1.19--3.1.21 (blueprint: def-trf-fine-fan-blowup). -/
def chartInclusion (P : Type u) [CommMonoid P] (E : Finset P) (a : P) :
    P →* saturatedChart P E a :=
  (intoSaturation (blowupChart P E a)).comp
    { toFun := fun p ↦ ⟨Algebra.GrothendieckGroup.of p,
        Submonoid.subset_closure (Or.inl ⟨p, rfl⟩)⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' := fun p q ↦ Subtype.ext (map_mul _ p q) }

/-- The distinguished overlap element `b/a` in the `a`-chart.
Source: ILO VIII 3.1.19--3.1.21 (blueprint: def-trf-fine-fan-blowup). -/
def overlapElement {P : Type u} [CommMonoid P] (E : Finset P) (a : P) (b : E) :
    saturatedChart P E a :=
  intoSaturation (blowupChart P E a)
    ⟨Algebra.GrothendieckGroup.of b.1 / Algebra.GrothendieckGroup.of a,
      Submonoid.subset_closure (Or.inr ⟨b.1, b.2, rfl⟩)⟩

/-- A finite ideal is rendered on an affine open by its given finite generators.
Source: ILO VIII 3.1.18--3.1.19 (blueprint: def-trf-fine-fan-blowup). -/
def GeneratedOnChart {F : Fan.{u}} (I : IdealFamily F)
    {P : Type u} [CommMonoid P] (c : AffineOpen F.space P) (E : Finset P) : Prop :=
  ∀ (x : MonoidPrime P) (t : stalk F.space.presheaf (c.inclusion.hom.base x)),
    t ∈ idealStalk I _ ↔ ∃ (a : E) (q : stalk (affine P).presheaf x),
      stalkMap c.inclusion x t = affineGerm x a.1 * q

/-- The prescribed saturated blowup over one affine base chart. The source is covered by
`Spec(C_a)`; the overlaps are exactly `D(b/a)`. Every chart map is normalized on `P`.
Consequently the transitions are the identity of the common localized monoids inside `P^gp`:
the images of `P` generate that group, so no other transition over `P` is possible. An open
cover with these identifications is precisely the quotient gluing, and its sheaf is the
sheaf of agreeing tuples, since the ambient object is a sheafed space.
Source: ILO VIII 3.1.19--3.1.24 (blueprint: def-trf-fine-fan-blowup). -/
structure BlowupPatch {B F : Fan.{u}} (b : Hom B F) (I : IdealFamily F) where
  monoid : CommMonCat.{u}
  fine : IsFine monoid
  sharp : IsSharp monoid
  baseChart : AffineOpen F.space monoid
  generators : Finset monoid
  nonempty : generators.Nonempty
  generates : GeneratedOnChart I baseChart generators
  charts : ∀ a : generators, AffineOpen B.space (saturatedChart monoid generators a.1)
  chartMap : ∀ a : generators,
    affine (saturatedChart monoid generators a.1) ⟶ affine monoid
  canonical : ∀ a : generators, IsAffineMap (chartInclusion monoid generators a.1) (chartMap a)
  overBase : ∀ a : generators,
    (charts a).inclusion ≫ b.map = chartMap a ≫ baseChart.inclusion
  cover : ∀ x : B.space,
    b.map.hom.base x ∈ baseChart.openSet ↔ ∃ a : generators, x ∈ (charts a).openSet
  overlap : ∀ (a d : generators) (x : MonoidPrime (saturatedChart monoid generators a.1)),
    (charts a).inclusion.hom.base x ∈ (charts d).openSet ↔
      overlapElement generators a.1 d ∉ x.carrier

/-- Being the saturated blowup along the indicated ideal, specified by the exact affine
chart construction and its open gluing. This is a property of a supplied morphism, and
never chooses an object from an undetermined existence theorem.
Source: ILO VIII 3.1.19--3.1.24 (blueprint: def-trf-fine-fan-blowup). -/
def IsSaturatedBlowup {B F : Fan.{u}} (b : Hom B F) (I : IdealFamily F) : Prop :=
  IsNonemptyCoherentIdeal I ∧
    ∀ x : F.space, ∃ p : BlowupPatch b I, x ∈ p.baseChart.openSet

/-- A finite saturated blowup tower with every center and its order retained.
The type `Fin n` is empty for length zero, so identity towers are included.
Source: ILO VIII 3.1.22--3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
structure Tower (n : ℕ) where
  level : Fin (n + 1) → Fan.{u}
  center : ∀ i : Fin n, IdealFamily (level i.castSucc)
  arrow : ∀ i : Fin n, Hom (level i.succ) (level i.castSucc)
  blowup : ∀ i : Fin n, IsSaturatedBlowup (arrow i) (center i)

/-- A tower over a second base is the recursive pullback tower exactly when its
successive centers are the pulled-back original centers, and its level maps commute.
Each successive space is already the saturated blowup by `Tower.blowup`.
Source: ILO VIII 3.1.22--3.1.23 (blueprint: def-trf-fine-fan-blowup). -/
structure PullbackTower {n : ℕ} (T S : Tower.{u} n) where
  lift : ∀ i : Fin (n + 1), Hom (S.level i) (T.level i)
  centers : ∀ i : Fin n, S.center i = pullbackIdeal (lift i.castSucc) (T.center i)
  commutes : ∀ i : Fin n,
    (S.arrow i).map ≫ (lift i.castSucc).map = (lift i.succ).map ≫ (T.arrow i).map

/-- Contracting a tower collapses exactly the unit-center isomorphisms. The monotone
surjection records the order, and the isomorphisms identify every old level with its
contracted level. Kept arrows and centers are transported through these isomorphisms.
A unit-center saturation which is not an isomorphism must therefore remain.
Source: ILO VIII 3.1.22 and 3.1.26, saturated variant
(blueprint: def-trf-fine-fan-blowup). -/
structure Contraction {n m : ℕ} (T : Tower.{u} n) (S : Tower.{u} m) where
  index : Fin (n + 1) →o Fin (m + 1)
  surjective : Function.Surjective index
  first : index 0 = 0
  last : index (Fin.last n) = Fin.last m
  iso : ∀ i : Fin (n + 1), (T.level i).space ≅ (S.level (index i)).space
  adjacent : ∀ i : Fin n, index i.succ = index i.castSucc ∨
    ∃ k : Fin m, index i.castSucc = k.castSucc ∧ index i.succ = k.succ
  deleted : ∀ i : Fin n, index i.succ = index i.castSucc ↔
    T.center i = wholeIdeal (T.level i.castSucc) ∧ IsIso (T.arrow i).map
  deletedMap : ∀ (i : Fin n) (h : index i.succ = index i.castSucc),
    (T.arrow i).map ≫ (iso i.castSucc).hom =
      (iso i.succ).hom ≫ eqToHom (congrArg (fun j ↦ (S.level j).space) h)
  keptMap : ∀ (i : Fin n) (k : Fin m)
    (h₀ : index i.castSucc = k.castSucc) (h₁ : index i.succ = k.succ),
    (T.arrow i).map ≫ (iso i.castSucc).hom =
      (iso i.succ).hom ≫ eqToHom (congrArg (fun j ↦ (S.level j).space) h₁) ≫
        (S.arrow k).map ≫ eqToHom (congrArg (fun j ↦ (S.level j).space) h₀.symm)
  keptCenter : ∀ (i : Fin n) (k : Fin m)
    (h₀ : index i.castSucc = k.castSucc) (_h₁ : index i.succ = k.succ),
    T.center i = pullbackAlong
      ((iso i.castSucc).hom ≫ eqToHom (congrArg (fun j ↦ (S.level j).space) h₀))
        (S.center k)

/-- The domain of a desingularization procedure: fine torsion-free fans admitting a
finite affine cover. This includes the empty fan and disconnected fans.
Source: ILO VIII 3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
structure ResolutionInput where
  fan : Fan.{u}
  torsionFree : fan.IsTorsionFree
  finiteCover : fan.HasFiniteAffineCover

/-- A chosen finite saturated tower over the input, ending in a smooth fan.
Source: ILO VIII 3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
structure Resolution (F : ResolutionInput.{u}) where
  length : ℕ
  tower : Tower.{u} length
  base : tower.level 0 = F.fan
  smooth : (tower.level (Fin.last length)).IsSmooth

/-- Canonical identification with a contracted recursive pullback, including the base map.
Its intermediate pullback is determined by the stated chart constructions, up to the
unique isomorphisms over the base. It does not replace a blowup by an arbitrary map.
Source: ILO VIII 3.1.22--3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
structure ResolutionComparison {F G : ResolutionInput.{u}}
    (R : Resolution F) (S : Resolution G) (g : Hom G.fan F.fan) where
  pulled : Tower.{u} R.length
  base : pulled.level 0 = G.fan
  pullback : PullbackTower R.tower pulled
  baseMap : (pullback.lift 0).map =
    eqToHom (congrArg Fan.space base) ≫ g.map ≫ eqToHom (congrArg Fan.space R.base.symm)
  contraction : Contraction pulled S.tower
  baseIso : (contraction.iso 0).hom =
    eqToHom (congrArg Fan.space (base.trans S.base.symm)) ≫
      eqToHom (congrArg (fun j ↦ (S.tower.level j).space) contraction.first.symm)

/-- The comparison on each level after undoing the contraction identification.
Source: ILO VIII 3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
noncomputable def ResolutionComparison.levelMap {F G : ResolutionInput.{u}}
    {R : Resolution F} {S : Resolution G} {g : Hom G.fan F.fan}
    (c : ResolutionComparison R S g) (i : Fin (R.length + 1)) :
    (S.tower.level (c.contraction.index i)).space ⟶ (R.tower.level i).space :=
  (c.contraction.iso i).inv ≫ (c.pullback.lift i).map

/-- Smooth-functorial saturated desingularization, with ordered centers, contracted
pullback comparisons, and their identity and composition coherence. The identity and
composition clauses quantify over the supplied local morphisms with the actual underlying
identity/composite, so no artificial choice of a localness proof affects the condition.
`HEq` only transports the source index along the explicitly required index equality.
Source: ILO VIII 3.1.26 (blueprint: def-trf-fine-fan-blowup). -/
structure SmoothFunctorialDesingularization where
  resolution : ∀ F : ResolutionInput.{u}, Resolution F
  comparison : ∀ {F G : ResolutionInput.{u}} (g : Hom G.fan F.fan),
    g.IsSmooth → ResolutionComparison (resolution F) (resolution G) g
  identityIndex : ∀ (F : ResolutionInput.{u}) (g : Hom F.fan F.fan)
    (hg : g.IsSmooth) (_h : g.map = 𝟙 F.fan.space)
    (i : Fin ((resolution F).length + 1)),
    (comparison g hg).contraction.index i = i
  identityMap : ∀ (F : ResolutionInput.{u}) (g : Hom F.fan F.fan)
    (hg : g.IsSmooth) (_h : g.map = 𝟙 F.fan.space)
    (i : Fin ((resolution F).length + 1)),
    HEq ((comparison g hg).levelMap i) (𝟙 ((resolution F).tower.level i).space)
  compositionIndex : ∀ {F G H : ResolutionInput.{u}}
    (g : Hom G.fan F.fan) (h : Hom H.fan G.fan) (k : Hom H.fan F.fan)
    (hg : g.IsSmooth) (hh : h.IsSmooth) (hk : k.IsSmooth)
    (_hc : k.map = h.map ≫ g.map) (i : Fin ((resolution F).length + 1)),
    (comparison k hk).contraction.index i =
      (comparison h hh).contraction.index ((comparison g hg).contraction.index i)
  compositionMap : ∀ {F G H : ResolutionInput.{u}}
    (g : Hom G.fan F.fan) (h : Hom H.fan G.fan) (k : Hom H.fan F.fan)
    (hg : g.IsSmooth) (hh : h.IsSmooth) (hk : k.IsSmooth)
    (_hc : k.map = h.map ≫ g.map) (i : Fin ((resolution F).length + 1)),
    HEq ((comparison k hk).levelMap i)
      ((comparison h hh).levelMap ((comparison g hg).contraction.index i) ≫
        (comparison g hg).levelMap i)

end FineFan
end AlgebraicGeometry
