module

public import Sheaf.AlgebraicGeometry.ProjectiveClosedSubschemeHomogeneousIdeal
public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.Twist
public import WeilConjectures.AlgebraicGeometry.TensorPullbackAdjunction
public import WeilConjectures.AlgebraicGeometry.SymmetricAlgebraSheafBundle
public import WeilConjectures.AlgebraicGeometry.Morphisms.FiberDegree
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
public import Mathlib.LinearAlgebra.Dual.Basis
import Sheaf.AlgebraicGeometry.ProjectiveSpaceStandardCharts
import Sheaf.AlgebraicGeometry.FiniteFreeAlgebraSpectrum
import WeilConjectures.AlgebraicGeometry.IsFiniteLocallyFreeOfDegreeOfEtaleCover
import Mathlib.GroupTheory.MonoidLocalization.Away
import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic

/-! # The punctured cone and a finite homogeneous slice

Source: Stacks Project, Constructions, Tags 03GL, 01M4, 01NF, 01NG and 01MS;
Morphisms, Tag 02KB; Descent, Tag 02VO.
(blueprint: lem-sfb-homogeneous-slice-finite-cover).

We use coordinates in a basis of the nonzero finite-dimensional vector space.
The polynomial ring is Sym(V dual) in that basis. The vanishing ideal uses
restrictions of sections, without taking radicals. The total space of L inverse
is the existing relative spectrum Sym(L), with its augmentation zero section.
The evaluation equations below fix its map to the actual affine cone.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u v

open CategoryTheory CategoryTheory.Limits Opposite MvPolynomial

namespace AlgebraicGeometry.HomogeneousSlice

/-- The coordinate identification Sym(V dual) = k[x_0,...,x_n].
Source: Stacks Tag 01NF, basis coordinates
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def coordinates (k : Type u) (V : Type v) [Field k] [AddCommGroup V] [Module k V]
    (n : ℕ) (b : Module.Basis (Fin (n + 1)) k V) :
    SymmetricAlgebra k (Module.Dual k V) ≃ₐ[k] MvPolynomial (Fin (n + 1)) k :=
  SymmetricAlgebra.equivMvPolynomial b.dualBasis

variable (k : Type u) [Field k] (n : ℕ) (Y : Scheme.{u})
    (j : Y ⟶ Proj (homogeneousSubmodule (Fin (n + 1)) k))

/-- The ideal generated by homogeneous polynomials whose sections vanish on Y.
Source: Stacks Tag 03GL; vanishing is scheme-theoretic on every standard chart
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def ideal : Ideal (MvPolynomial (Fin (n + 1)) k) :=
  Ideal.span { F | ∃ d : ℕ, ∃ hF : F ∈ homogeneousSubmodule (Fin (n + 1)) k d,
    ∀ a : Fin (n + 1),
      j.app (Proj.basicOpen (homogeneousSubmodule (Fin (n + 1)) k) (X a))
        (projectiveClosedSubschemeChartFraction k n d ⟨F, hF⟩ a) = 0 }

/-- The affine cone Spec(P/I), retaining its nilpotents.
Source: Stacks Tags 03GL and 01M4
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def cone : Scheme.{u} := Spec (.of (MvPolynomial (Fin (n + 1)) k ⧸ ideal k n Y j))

/-- A polynomial as a regular function on the affine cone.
Source: Stacks Tag 03GL, the actual quotient map
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def coneFunction (F : MvPolynomial (Fin (n + 1)) k) : Γ(cone k n Y j, ⊤) :=
  (Scheme.ΓSpecIso _).inv (Ideal.Quotient.mk (ideal k n Y j) F)

/-- The complement of the vertex, expressed as the union of the coordinate opens.
This also defines the empty puncture when Y is empty.
Source: Stacks Tags 01M4 and 01NG
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def puncture : (cone k n Y j).Opens :=
  ⨆ a : Fin (n + 1), (cone k n Y j).basicOpen (coneFunction k n Y j (X a))

/-- The ideal (I,f-c) defining the homogeneous level.
Source: Stacks Tag 01M4, cyclic-level chart calculation
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def sliceIdeal (f : MvPolynomial (Fin (n + 1)) k) (c : kˣ) :
    Ideal (MvPolynomial (Fin (n + 1)) k) :=
  ideal k n Y j ⊔ Ideal.span {f - C (c : k)}

/-- The actual affine level scheme Spec(P/(I,f-c)).
Source: Stacks Tag 01M4, cyclic-level chart calculation
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def slice (f : MvPolynomial (Fin (n + 1)) k) (c : kˣ) : Scheme.{u} :=
  Spec (.of (MvPolynomial (Fin (n + 1)) k ⧸ sliceIdeal k n Y j f c))

/-- The quotient-induced closed immersion of the slice into the cone.
Source: Stacks Tag 01M4
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def sliceInclusion (f : MvPolynomial (Fin (n + 1)) k) (c : kˣ) :
    slice k n Y j f c ⟶ cone k n Y j :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor
    (show ideal k n Y j ≤ sliceIdeal k n Y j f c from le_sup_left)))

/-- A polynomial as a regular function on the slice, via the quotient map.
Source: Stacks Tag 01M4
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def sliceFunction (f : MvPolynomial (Fin (n + 1)) k) (c : kˣ)
    (F : MvPolynomial (Fin (n + 1)) k) : Γ(slice k n Y j f c, ⊤) :=
  (Scheme.ΓSpecIso _).inv (Ideal.Quotient.mk (sliceIdeal k n Y j f c) F)

/-- The projective nonvanishing open Y_f, with its scheme structure.
Source: Stacks Tags 01M4 and 01MV
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def nonvanishing (f : MvPolynomial (Fin (n + 1)) k) : Y.Opens :=
  j ⁻¹ᵁ Proj.basicOpen (homogeneousSubmodule (Fin (n + 1)) k) f

/-- L = j* O(1), the dual tautological line in the polynomial Proj model.
Source: Stacks Tags 01NF and 01MS; ProjectiveSpace.twist uses this same Proj twist
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def line : Y.Modules :=
  (Scheme.Modules.tensorPullback j).obj (Proj.twist (homogeneousSubmodule (Fin (n + 1)) k) 1)

/-- The pulled-back degree-one coordinate section of L.
Source: Stacks Tags 01NG and 01MS
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def lineCoordinate (a : Fin (n + 1)) : Γ(line k n Y j, ⊤) :=
  (((Classical.choose (Scheme.Modules.exists_tensorPullbackAdjunction j)).unit.app
    (Proj.twist (homogeneousSubmodule (Fin (n + 1)) k) 1)).val.app (op ⊤))
      ((Proj.unitToTwist (𝒜 := homogeneousSubmodule (Fin (n + 1)) k)
        (isHomogeneous_X k a)).app ⊤
          (1 : Γ(Proj (homogeneousSubmodule (Fin (n + 1)) k), ⊤)))

/-- The complement of the augmentation zero section in Spec_Y Sym(L), hence L inverse.
Source: Stacks Tags 01M2, 01NF and 01MS
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def bundlePuncture [hL : (line k n Y j).IsQuasicoherent] :
    (line k n Y j).symSpec.Opens :=
  ⟨(Set.range (line k n Y j).symSpecZeroSection)ᶜ,
    (line k n Y j).symSpecZeroSection.isClosedEmbedding.isClosed_range.isOpen_compl⟩

/-- The coordinate prescription for the canonical evaluation into the cone.
It prescribes scalars as well as degree-one coordinates, on an affine basis.
Source: Stacks Tags 01NF and 01MS
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def IsEvaluation [hL : (line k n Y j).IsQuasicoherent]
    (a : (line k n Y j).symSpec ⟶ cone k n Y j) : Prop :=
  (a ≫ Spec.map (CommRingCat.ofHom
    ((Ideal.Quotient.mk (ideal k n Y j)).comp MvPolynomial.C)) =
      (line k n Y j).symSpecProj ≫ j ≫
        Proj.toSpecZero (homogeneousSubmodule (Fin (n + 1)) k) ≫
          Spec.map (CommRingCat.ofHom
            (MvPolynomial.homogeneousSubmoduleZeroEquiv (Fin (n + 1)) k).toRingHom)) ∧
  ∀ (U : Y.AffineZariskiSite) (i : Fin (n + 1)),
    a.appLE ⊤ ((line k n Y j).symSpecProj ⁻¹ᵁ U.1) (by simp)
      (coneFunction k n Y j (X i)) =
    (line k n Y j).symCoord U
      ((line k n Y j).presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op
        (lineCoordinate k n Y j i))

/-- Naturality for graded k-linear changes of coordinates preserving Y and f.
The substitution is exactly a graded polynomial automorphism fixing constants;
these are precisely linear automorphisms of V in the chosen basis. All maps
are normalized on their actual polynomial coordinate functions.
Source: Stacks Tags 01NF and 01NG, linear substitution in the chart formulas
(blueprint: lem-sfb-homogeneous-slice-finite-cover). -/
def IsNatural [hL : (line k n Y j).IsQuasicoherent]
    (a : (line k n Y j).symSpec ⟶ cone k n Y j)
    (e : (puncture k n Y j).toScheme ≅ (bundlePuncture k n Y j).toScheme)
    (f : MvPolynomial (Fin (n + 1)) k) (c : kˣ)
    (p : slice k n Y j f c ⟶ (nonvanishing k n Y j f).toScheme) : Prop :=
  ∀ (σ : homogeneousSubmodule (Fin (n + 1)) k →+*ᵍ
        homogeneousSubmodule (Fin (n + 1)) k)
    (τ : homogeneousSubmodule (Fin (n + 1)) k →+*ᵍ
        homogeneousSubmodule (Fin (n + 1)) k),
    (∀ F, τ (σ F) = F) → (∀ F, σ (τ F) = F) →
    (∀ r : k, σ (C r) = C r) → σ f = f →
    ∀ (hσ : HomogeneousIdeal.irrelevant (homogeneousSubmodule (Fin (n + 1)) k) ≤
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule (Fin (n + 1)) k)).map σ)
      (gY : Y ≅ Y), gY.hom ≫ j = j ≫ Proj.map σ hσ →
    ∃ (gC : cone k n Y j ≅ cone k n Y j)
      (gE : (line k n Y j).symSpec ≅ (line k n Y j).symSpec)
      (gT : slice k n Y j f c ≅ slice k n Y j f c)
      (gU : (nonvanishing k n Y j f).toScheme ≅ (nonvanishing k n Y j f).toScheme)
      (gP : (puncture k n Y j).toScheme ≅ (puncture k n Y j).toScheme),
      (∀ F, gC.hom.appTop (coneFunction k n Y j F) = coneFunction k n Y j (σ F)) ∧
      gE.hom ≫ (line k n Y j).symSpecProj = (line k n Y j).symSpecProj ≫ gY.hom ∧
      gE.hom ≫ a = a ≫ gC.hom ∧
      (∀ F, gT.hom.appTop (sliceFunction k n Y j f c F) =
        sliceFunction k n Y j f c (σ F)) ∧
      gU.hom ≫ (nonvanishing k n Y j f).ι =
        (nonvanishing k n Y j f).ι ≫ gY.hom ∧
      gT.hom ≫ p = p ≫ gU.hom ∧
      gP.hom ≫ (puncture k n Y j).ι = (puncture k n Y j).ι ≫ gC.hom ∧
      gP.hom ≫ e.hom ≫ (bundlePuncture k n Y j).ι =
        e.hom ≫ (bundlePuncture k n Y j).ι ≫ gE.hom

/-- The punctured cone is canonically the nonzero tautological line, and every
nonzero homogeneous level is a finite locally free surjection of its degree.
Source: Stacks Tags 03GL, 01M4, 01NF, 01NG, 01MS, 01MV, 02KB and 02VO.
(blueprint: lem-sfb-homogeneous-slice-finite-cover).

Proof: (1) The homogeneous vanishing ideal recovers Y by
lem-sfb-projective-closed-subscheme-homogeneous-ideal, including its nilpotents.
On U_i its chart ring is A_i=(P/I)[1/x_i]_0; the quotient chart kernel identifies
this with the dehomogenized equations.
(2) The inverse maps A_i[t_i,t_i^{-1}] and (P/I)[1/x_i] send t_i to x_i,
x_j/x_i to its fraction, and x_j to (x_j/x_i)t_i. Homogeneous relations map to
powers of t_i times their dehomogenizations, so both maps descend, also over zero rings.
(3) On overlaps t_j=(x_j/x_i)t_i. These are precisely the dual-frame transitions
for L inverse, since the frames of L satisfy e_j=(x_j/x_i)e_i. Glue the maps and
their inverses by lem-weil-pbc-scheme-morphism-gluing. This gives the displayed
isomorphism with Spec Sym(L) minus its augmentation, normalized by IsEvaluation.
(4) Replacing a coordinate by any linear form gives t_l=l(v). Thus the formulas
are independent of the basis and commute with every linear substitution preserving
Y, and, upon restriction, every substitution preserving f. This proves IsNatural.
(5) For homogeneous f of degree d>0 and c a unit, the slice avoids the origin.
On U_i write a_i=f/x_i^d and B_i=A_i[1/a_i]. Its ring is
B_i[t_i]/(t_i^d-c/a_i): in the Laurent presentation a_i is a unit, and in the
monic presentation t_i has inverse (a_i/c)t_i^(d-1). Thus the slice maps to Y_f.
(6) Monic division gives the basis 1,t_i,...,t_i^(d-1). The finite-free algebra
spectrum lemma gives finite local freeness, and the fibre-ring computation gives
dimension d. (7) Tensor with this algebra is d copies of the original module;
since d>0 it is faithfully flat. The faithfully-flat spectrum lemma gives
surjectivity. (8) Descend finite local freeness and degree on the open cover by
lem-weil-pbc-finite-locally-free-degree-etale-descent. An empty Y_f has empty
slice. No reduction or division by d occurs, so nonreduced Y and char(k) dividing
d are permitted. The evaluation equations determine the comparison uniquely. -/
theorem homogeneous_slice_finite_cover [IsClosedImmersion j]
    (V : Type v) [AddCommGroup V] [Module k V]
    (b : Module.Basis (Fin (n + 1)) k V) :
    (line k n Y j).IsInvertible ∧
    ∃ (_ : (line k n Y j).IsQuasicoherent)
      (a : (line k n Y j).symSpec ⟶ cone k n Y j)
      (e : (puncture k n Y j).toScheme ≅ (bundlePuncture k n Y j).toScheme),
      IsEvaluation k n Y j a ∧
      e.hom ≫ (bundlePuncture k n Y j).ι ≫ a = (puncture k n Y j).ι ∧
      (∀ a' : (line k n Y j).symSpec ⟶ cone k n Y j,
        IsEvaluation k n Y j a' → a' = a) ∧
      ∀ (d : ℕ) (hd : 0 < d) (F : SymmetricAlgebra k (Module.Dual k V))
        (hF : coordinates k V n b F ∈ homogeneousSubmodule (Fin (n + 1)) k d) (c : kˣ),
        ∃ (t : slice k n Y j (coordinates k V n b F) c ⟶ (puncture k n Y j).toScheme)
          (p : slice k n Y j (coordinates k V n b F) c ⟶
            (nonvanishing k n Y j (coordinates k V n b F)).toScheme),
          t ≫ (puncture k n Y j).ι = sliceInclusion k n Y j (coordinates k V n b F) c ∧
          t ≫ e.hom ≫ (bundlePuncture k n Y j).ι ≫ (line k n Y j).symSpecProj =
            p ≫ (nonvanishing k n Y j (coordinates k V n b F)).ι ∧
          p.IsFiniteLocallyFreeOfDegree d ∧ Surjective p ∧
          IsNatural k n Y j a e (coordinates k V n b F) c p := by
  sorry

end AlgebraicGeometry.HomogeneousSlice
