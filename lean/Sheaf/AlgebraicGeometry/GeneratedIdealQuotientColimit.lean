module

public import WeilConjectures.AlgebraicGeometry.QuasiCoherentAlgebra
public import Mathlib.CategoryTheory.Limits.Shapes.Preorder.Basic
public import Mathlib.RingTheory.Ideal.Maps
import Sheaf.AlgebraicGeometry.QuasiCoherentAlgebraKernelImageIdeal
import WeilConjectures.AlgebraicGeometry.QuasiCoherentAlgebraColimit
import WeilConjectures.CategoryTheory.CommAlgebraSheafModule

/-! # Colimits of quotients by approximating generated ideals

Source: Stacks Project, Properties, Tags 086N and 0817, the quotient-colimit step
(blueprint: lem-weil-pbc-generated-ideal-quotient-colimit).

Ideal subsheaves are encoded by their module inclusions and sectionwise ideal ranges,
as in `generated_ideal_quotient_quasiCoherent`. Quotient algebra sheaves are identified
by their affine section maps: these are surjective with the specified kernels.
This determines the quotient and its projection up to unique isomorphism, without a
second definition of quotient sheaves. The maps in the returned diagram, algebra cocone
and affine ring cocones are the same maps throughout.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry.Scheme.CommAlgebraSheaf

private theorem quotientData {X : Scheme.{u}}
    (B : X.CommAlgebraSheaf) (hB : B.toModule.IsQuasicoherent)
    (E : X.Modules) (hE : E.IsQuasicoherent) (e : E ⟶ B.toModule) :
    ∃ (Q : X.CommAlgebraSheaf) (q : B ⟶ Q),
      Q.toModule.IsQuasicoherent ∧
      (∀ (U : X.Opens) (s : E.val.obj (op U)),
        q.right.hom.app (op U) (e.app U s) = 0) ∧
      (∀ (U : X.Opens), IsAffineOpen U →
        Function.Surjective (q.right.hom.app (op U)) ∧
        RingHom.ker (q.right.hom.app (op U)).hom =
          Ideal.span (Set.range (e.app U) : Set (B.right.obj.obj (op U)))) ∧
      (∀ (C : X.CommAlgebraSheaf) (χ : B ⟶ C),
        (∀ (U : X.Opens) (s : E.val.obj (op U)),
          χ.right.hom.app (op U) (e.app U s) = 0) →
        ∃! χbar : Q ⟶ C, q ≫ χbar = χ) := by
  obtain ⟨J, i, I, _, _, hcontains, _, haff, _, Q, q, P, p, a,
    hp, hq, hQ, _, hqa, hUP⟩ :=
    generated_ideal_quotient_quasiCoherent B hB E hE e
  refine ⟨Q, q, hQ, ?_, ?_, hUP⟩
  · intro U s
    have hz : p.app (op U) (e.app U s) = 0 := by
      apply RingHom.mem_ker.mp
      rw [(hp U).2]
      exact hcontains U ⟨s, rfl⟩
    rw [hq]
    change a.hom.hom.app (op U)
      (((sheafificationAdjunction (Opens.grothendieckTopology X) CommRingCat).unit.app
        P).app (op U) (p.app (op U) (e.app U s))) = 0
    rw [hz, map_zero, map_zero]
  · intro U hU
    exact ⟨(hqa U hU).1, (hqa U hU).2.trans (haff U hU)⟩

/-- Quotients by ideals generated by a directed module approximation of an ideal have
that ideal's quotient as their colimit, both in all algebra sheaves and in quasi-coherent
algebras. On each affine open the same cocone is a ring colimit, and its vertex is the
quotient ring by the given ideal. Surjectivity and kernel equalities specify the quotient
projections; naturality and the displayed factorization specify their canonical maps.
Source: Stacks Project, Properties, Tags 086N and 0817, quotient-colimit step
(blueprint: lem-weil-pbc-generated-ideal-quotient-colimit).

Proof:
1. Apply `lem-weil-pbc-quasi-coherent-algebra-kernel-image-ideal` (b) to each composite
   E_k → J → S. The generated ideals and quotients are quasi-coherent, with the stated
   affine section kernels. Apply it also to J → S: its generated ideal is J itself,
   because J contains its own sections and every ideal containing those sections
   contains J. Compatibility gives I_k ⊆ I_l ⊆ J. The quotient universal properties
   give the transition maps and maps to S/J. Their identities, composition laws and
   cocone laws follow by uniqueness after precomposing with the quotient projections.
2. For an arbitrary algebra-sheaf cocone α_k : Q_k → C, put h_k = α_k q_k. Naturality
   gives h_k = h_l for k ≤ l. Choose k₀ using nonemptiness; directedness supplies a
   common upper bound for k and k₀, proving h_k = h_k₀ for every k. Antisymmetry is
   not needed.
3. The algebra map h = h_k₀ is O_X-linear, by `def-weil-pbc-comm-algebra-sheaf`.
   Each composite h j ε_k is zero. The assumed module colimit and
   `def-weil-pbc-category-colimit` imply h j = 0. The quotient universal property in
   `lem-weil-pbc-quasi-coherent-algebra-kernel-image-ideal` (b) gives a unique map
   hbar : S/J → C with hbar q = h.
4. Precomposing with q_k shows hbar r_k = α_k, by quotient uniqueness. Any other map
   with these equations has composite with q equal to α_k₀ q_k₀ = h, hence equals
   hbar. This is the colimit in all algebra sheaves. Fullness gives the same colimit
   in `def-weil-pbc-quasi-coherent-algebra`'s full quasi-coherent subcategory.
5. Apply `lem-weil-pbc-quasi-coherent-algebra-colimit` to the quotient diagram. Its
   algebra colimit A has the ring colimit of sections on every affine open. The two
   colimit universal properties give inverse algebra maps A ⇄ S/J, since their
   composites fix every cocone leg. Evaluation preserves this isomorphism, and the
   resulting affine comparison carries each leg to r_k. Finally the quotient theorem
   identifies (S/J)(U) with S(U)/J(U) through the surjective map with kernel J(U). -/
theorem generatedIdealQuotient_colimit
    {X : Scheme.{u}} (S : X.CommAlgebraSheaf) (hS : X.IsQuasiCoherentAlgebra S)
    (J : X.Modules) (hJ : J.IsQuasicoherent) (j : J ⟶ S.toModule)
    (L : ∀ U : X.Opens, Ideal (S.right.obj.obj (op U)))
    (hj : ∀ U : X.Opens, Function.Injective (j.app U) ∧
      Set.range (j.app U) = (L U : Set (S.right.obj.obj (op U))))
    (K : Type u) [Preorder K] [IsDirected K (· ≤ ·)] [Nonempty K]
    (E : K ⥤ X.Modules) (hE : ∀ k : K, (E.obj k).IsQuasicoherent)
    (ε : E ⟶ (Functor.const K).obj J)
    (hε : IsColimit (Cocone.mk J ε)) :
    ∃ (F : K ⥤ QuasiCoherentAlgebra X) (c : Cocone F)
      (q : (Functor.const K).obj S ⟶ F ⋙ (X.IsQuasiCoherentAlgebra).ι)
      (p : S ⟶ c.pt.obj),
      (∀ (k : K) (U : X.Opens), IsAffineOpen U →
        Function.Surjective ((q.app k).right.hom.app (op U)) ∧
        RingHom.ker ((q.app k).right.hom.app (op U)).hom =
          Ideal.span (Set.range ((ε.app k ≫ j).app U) :
            Set (S.right.obj.obj (op U)))) ∧
      (∀ k : K, q.app k ≫ (c.ι.app k).hom = p) ∧
      Nonempty (IsColimit c) ∧
      Nonempty (IsColimit ((X.IsQuasiCoherentAlgebra).ι.mapCocone c)) ∧
      (∀ (U : X.Opens), IsAffineOpen U →
        Function.Surjective (p.right.hom.app (op U)) ∧
        RingHom.ker (p.right.hom.app (op U)).hom = L U ∧
        Nonempty (IsColimit
          (((evaluation X.Opensᵒᵖ CommRingCat).obj (op U)).mapCocone
            ((sheafToPresheaf (Opens.grothendieckTopology X) CommRingCat).mapCocone
              ((Under.forget X.sheaf).mapCocone
                ((X.IsQuasiCoherentAlgebra).ι.mapCocone c)))))) := by
  classical
  obtain ⟨T, p, hT, hpzero, hpa, hpUP⟩ := quotientData S hS J hJ j
  have hdata (k : K) := quotientData S hS (E.obj k) (hE k) (ε.app k ≫ j)
  choose Q q hQ hzero hqa hUP using hdata
  have cancel (k : K) {C : X.CommAlgebraSheaf} (a b : Q k ⟶ C)
      (hab : q k ≫ a = q k ≫ b) : a = b := by
    have hz (U : X.Opens) (s : (E.obj k).val.obj (op U)) :
        (q k ≫ a).right.hom.app (op U) ((ε.app k ≫ j).app U s) = 0 := by
      change a.right.hom.app (op U)
        ((q k).right.hom.app (op U) ((ε.app k ≫ j).app U s)) = 0
      rw [hzero k, map_zero]
    obtain ⟨d, _, hd⟩ := hUP k C (q k ≫ a) hz
    exact (hd a rfl).trans (hd b hab.symm).symm
  have kill (k l : K) (f : k ⟶ l) (U : X.Opens)
      (s : (E.obj k).val.obj (op U)) :
      (q l).right.hom.app (op U) ((ε.app k ≫ j).app U s) = 0 := by
    have he : E.map f ≫ ε.app l = ε.app k := by
      exact (ε.naturality f).trans (Category.comp_id _)
    rw [← he, Category.assoc]
    exact hzero l U ((E.map f).app U s)
  let t {k l : K} (f : k ⟶ l) : Q k ⟶ Q l :=
    (hUP k (Q l) (q l) (kill k l f)).choose
  have ht {k l : K} (f : k ⟶ l) : q k ≫ t f = q l :=
    (hUP k (Q l) (q l) (kill k l f)).choose_spec.1
  let F : K ⥤ QuasiCoherentAlgebra X :=
    { obj := fun k ↦ ⟨Q k, hQ k⟩
      map := fun f ↦ ⟨t f⟩
      map_id := fun k ↦ by
        apply ObjectProperty.hom_ext
        apply cancel k
        simpa using ht (𝟙 k)
      map_comp := fun f g ↦ by
        apply ObjectProperty.hom_ext
        apply cancel _
        change q _ ≫ t (f ≫ g) = q _ ≫ (t f ≫ t g)
        rw [ht (f ≫ g), ← Category.assoc, ht f, ht g] }
  have hpk (k : K) (U : X.Opens) (s : (E.obj k).val.obj (op U)) :
      p.right.hom.app (op U) ((ε.app k ≫ j).app U s) = 0 :=
    hpzero U ((ε.app k).app U s)
  let r (k : K) : Q k ⟶ T := (hUP k T p (hpk k)).choose
  have hr (k : K) : q k ≫ r k = p := (hUP k T p (hpk k)).choose_spec.1
  let c : Cocone F :=
    { pt := ⟨T, hT⟩
      ι :=
        { app := fun k ↦ ⟨r k⟩
          naturality := fun k l f ↦ by
            apply ObjectProperty.hom_ext
            change t f ≫ r l = r k
            apply cancel k
            rw [← Category.assoc, ht f, hr, hr] } }
  let qnat : (Functor.const K).obj S ⟶ F ⋙ (X.IsQuasiCoherentAlgebra).ι :=
    { app := q
      naturality := fun k l f ↦ by simpa using (ht f).symm }
  have hc : IsColimit ((X.IsQuasiCoherentAlgebra).ι.mapCocone c) := by
    let k₀ : K := Classical.arbitrary K
    have same (s : Cocone (F ⋙ (X.IsQuasiCoherentAlgebra).ι)) (k : K) :
        q k ≫ s.ι.app k = q k₀ ≫ s.ι.app k₀ := by
      obtain ⟨l, hkl, h₀l⟩ := exists_ge_ge k k₀
      have eqleg {a b : K} (f : a ⟶ b) :
          q a ≫ s.ι.app a = q b ≫ s.ι.app b := by
        rw [← s.w f]
        change q a ≫ (t f ≫ s.ι.app b) = _
        rw [← Category.assoc, ht f]
      exact (eqleg (homOfLE hkl)).trans (eqleg (homOfLE h₀l)).symm
    have kills (s : Cocone (F ⋙ (X.IsQuasiCoherentAlgebra).ι)) :
        ∀ (U : X.Opens) (x : J.val.obj (op U)),
          (q k₀ ≫ s.ι.app k₀).right.hom.app (op U) (j.app U x) = 0 := by
      let H := q k₀ ≫ s.ι.app k₀
      let M := commAlgebraSheafModuleFunctor X.sheaf
      have hjH : j ≫ M.map H = 0 := by
        apply hε.hom_ext
        intro k
        change ε.app k ≫ (j ≫ M.map H) = ε.app k ≫ 0
        ext U x
        change H.right.hom.app (op U) ((ε.app k ≫ j).app U x) = 0
        change (q k₀ ≫ s.ι.app k₀).right.hom.app (op U)
          ((ε.app k ≫ j).app U x) = 0
        rw [← same s k]
        change (s.ι.app k).right.hom.app (op U)
          ((q k).right.hom.app (op U) ((ε.app k ≫ j).app U x)) = 0
        rw [hzero k, map_zero]
      intro U x
      exact congrArg (fun f ↦ f.app U x) hjH
    let d (s : Cocone (F ⋙ (X.IsQuasiCoherentAlgebra).ι)) : T ⟶ s.pt :=
      (hpUP s.pt (q k₀ ≫ s.ι.app k₀) (kills s)).choose
    have hd (s : Cocone (F ⋙ (X.IsQuasiCoherentAlgebra).ι)) :
        p ≫ d s = q k₀ ≫ s.ι.app k₀ :=
      (hpUP s.pt (q k₀ ≫ s.ι.app k₀) (kills s)).choose_spec.1
    refine { desc := d, fac := ?_, uniq := ?_ }
    · intro s k
      change r k ≫ d s = s.ι.app k
      apply cancel k
      rw [← Category.assoc, hr, hd, same s k]
    · intro s m hm
      have hpm : p ≫ m = q k₀ ≫ s.ι.app k₀ := by
        rw [← hr k₀, Category.assoc]
        exact congrArg (fun a ↦ q k₀ ≫ a) (hm k₀)
      exact (hpUP s.pt (q k₀ ≫ s.ι.app k₀) (kills s)).choose_spec.2 m hpm
  refine ⟨F, c, qnat, p, hqa, hr, ⟨isColimitOfReflects _ hc⟩, ⟨hc⟩, ?_⟩
  intro U hU
  refine ⟨(hpa U hU).1, ?_, ?_⟩
  · rw [(hpa U hU).2, (hj U).2, Ideal.span_eq]
  · obtain ⟨d, ⟨hd⟩, _, _, haff, _⟩ :=
      quasiCoherentAlgebra_colimit X K (F ⋙ (X.IsQuasiCoherentAlgebra).ι)
        (fun k ↦ hQ k)
    let e := hd.coconePointUniqueUpToIso hc
    let R := Under.forget X.sheaf ⋙
      sheafToPresheaf (Opens.grothendieckTopology X) CommRingCat ⋙
        (evaluation X.Opensᵒᵖ CommRingCat).obj (op U)
    have hi : R.mapCocone d ≅
        R.mapCocone ((X.IsQuasiCoherentAlgebra).ι.mapCocone c) :=
      Cocone.ext (R.mapIso e) (fun k ↦ by
        change R.map (d.ι.app k) ≫ R.map e.hom = _
        rw [← R.map_comp]
        exact congrArg R.map (hd.comp_coconePointUniqueUpToIso_hom hc k))
    exact ⟨IsColimit.ofIsoColimit (haff U hU).some hi⟩

end AlgebraicGeometry.Scheme.CommAlgebraSheaf
