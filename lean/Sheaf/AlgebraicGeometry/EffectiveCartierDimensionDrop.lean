module

public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.Topology.KrullDimension
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

/-!
# Dimension of an effective Cartier divisor

Source: Stacks Project, Varieties, Tag 0BEV, the dimension assertion in the proof
(blueprint: lem-sc-effective-cartier-dimension-drop).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- A nonempty effective Cartier divisor on an integral finite-type scheme of dimension
`d ≥ 1` over a field has dimension `d - 1`. The divisor is represented by its quasi-coherent
ideal `J` and the associated closed subscheme `J.subscheme`.
Source: Stacks Project, Varieties, Tag 0BEV, proof after constructing the vanishing scheme.
(blueprint: lem-sc-effective-cartier-dimension-drop)

Proof: Every nonempty affine open of `X` has a domain as its coordinate ring, finitely
 generated over `k`. By `lem-sc-integral-locally-algebraic-affine-opens-dimension`, all these
opens have the same dimension, and the open-cover description of topological Krull dimension
(Stacks Tag 0055) identifies it with `d`. On an affine chart meeting the divisor, the ideal
is generated by a nonzerodivisor `f`. Integrality makes `f` nonzero, and meeting the divisor
makes `f` a nonunit. The quotient chart has dimension `d - 1` by
`lem-sc-effective-cartier-affine-dimension-drop`. These nonempty quotient charts cover the
divisor. Taking the supremum of their dimensions gives dimension `d - 1` for the divisor. -/
theorem topologicalKrullDim_subscheme_of_isInvertible
    (k : Type u) [Field k] (X : Scheme.{u}) [IsIntegral X]
    (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f] [QuasiCompact f]
    (d : ℕ) (hd : 1 ≤ d) (hX : topologicalKrullDim X = (d : WithBot ℕ∞))
    (J : X.IdealSheafData) (hJ : J.IsInvertible) [Nonempty J.subscheme] :
    topologicalKrullDim J.subscheme = ((d - 1 : ℕ) : WithBot ℕ∞) := by
  sorry

end AlgebraicGeometry
