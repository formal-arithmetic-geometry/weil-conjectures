module

public import Sheaf.AlgebraicGeometry.AffineRegularImmersion
import Mathlib.AlgebraicGeometry.Morphisms.Proper
import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
import Mathlib.AlgebraicGeometry.ResidueField
import Mathlib.RingTheory.Regular.Flat

/-!
# Composition of regular immersions over arbitrary schemes

Source: Stacks Project, Divisors, Tag 067Q, assertion (1)
(blueprint: lem-sfb-regular-immersion-composition).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- Regular immersions of arbitrary schemes are stable under composition.

Source: Stacks Project, Divisors, Tag 067Q (1), with the affine description of
Tags 063G and 063J (blueprint: lem-sfb-regular-immersion-composition).

Proof plan:
1. Compose the underlying immersions using the immersion clause of
   [lem-weil-pbc-proper-fp-permanence].
2. At `z`, choose regular quotient charts for `j` at `i z` and for `i` at `z`.
   Write their rings as `A → A/I` and `B → B/K`, with regular generators `f` and `g`.
3. Use [lem-sc-affine-inter-principal-both] to find a common neighbourhood of `i z`
   principal in both affine opens of `Y`. Lift its defining section from `A/I` to
   `a : A`; [lem-weil-pbc-affine-open-section-vanishing-prime] identifies this
   neighbourhood with the inverse image of `D(a)` in `Spec A`.
4. On these principal opens the rings identify as `B_b ≅ (A/I)_e ≅ A_a / I A_a`.
   By [lem-exc-weakly-regular-sequence-localization], the localized sequences remain
   weakly regular. Restrict the closed chart of `i`; by
   [lem-weil-pbc-closed-immersion-affine-cover-criterion] its source is affine,
   with coordinate ring `C = B_b / (g')`.
5. Lift `g'` to elements `t` in `A_a`. The composite kernel is generated by `f' ++ t`:
   subtract a lifted linear combination of `t` to reduce any kernel element to `(f')`.
   Each prefix quotient after the first block identifies with the corresponding
   prefix quotient of `B_b` by `g'`. The injectivity conditions of
   [def-weil-pbc-regular-sequence] therefore hold for the concatenation. Its final
   quotient `C` is nonzero because its spectrum contains `z`. This gives the required
   regular quotient chart for the composite. Either sequence may be empty. If `Z` is
   empty there are no chart conditions. No Noetherian assumption is used. -/
theorem IsAffineRegularImmersion.comp {Z Y X : Scheme.{u}} (i : Z ⟶ Y) (j : Y ⟶ X)
    (hi : IsAffineRegularImmersion i) (hj : IsAffineRegularImmersion j) :
    IsAffineRegularImmersion (i ≫ j) := by
  sorry

end AlgebraicGeometry
