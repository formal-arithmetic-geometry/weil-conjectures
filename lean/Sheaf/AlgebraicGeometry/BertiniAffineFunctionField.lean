/-!
# The algebraic function-field computation in geometric Bertini

Source: Stacks Project, More on Morphisms, Tag 0G4F, final proof paragraph.
-/

@[expose] public section

universe u

open CategoryTheory AlgebraicGeometry

namespace FieldTheory

/-- The codimension-two affine intersection makes the generic incidence function field
geometrically irreducible over the subfield generated by its parameter coordinates.

Source: Stacks Project, More on Morphisms, Tag 0G4F, final proof paragraph, using
Tags 0G4D and 0G4E. (blueprint: lem-zl-bertini-affine-function-field).

Proof: Apply the independent-functions lemma and reindex its sum-indexed family as
Fin (n+2). The fraction field of a finite type domain is finitely generated as a field.
The algebraic Bertini lemma applied to this family gives the result. -/
theorem geometricallyIrreducible_bertiniAffineFunctionField
    (k A : Type u) [Field k] [CommRing A] [Algebra k A]
    [Algebra.FiniteType k A] [IsDomain A]
    (n : ℕ) (hn : 2 ≤ n) (g : Fin n → A)
    (hcomp : ∃ W : Set (PrimeSpectrum.zeroLocus
        ({g ⟨0, Nat.zero_lt_of_lt hn⟩, g ⟨1, hn⟩} : Set A)),
      W ∈ irreducibleComponents (PrimeSpectrum.zeroLocus
        ({g ⟨0, Nat.zero_lt_of_lt hn⟩, g ⟨1, hn⟩} : Set A)) ∧
      topologicalKrullDim W + 2 = ringKrullDim A)
    (hgeom : GeometricallyIrreducible
      (Spec.map (CommRingCat.ofHom (algebraMap k (FractionRing A))))) :
    GeometricallyIrreducible
      (Spec.map (CommRingCat.ofHom
        (algebraMap
          (bertiniBaseField k (FractionRing A) n (fun i ↦ algebraMap A (FractionRing A) (g i)))
          (bertiniOmega (FractionRing A) n)))) := by
  classical
  have : Algebra.EssFiniteType k (FractionRing A) := .comp k A _
  apply bertini_field_extension k (FractionRing A) (IntermediateField.fg_top _ _)
    hgeom n (by omega) (fun i ↦ algebraMap A (FractionRing A) (g i))
  obtain ⟨c, hc⟩ := Algebra.bertini_independent_functions k A n hn g hcomp
  refine ⟨c, ?_⟩
  have he : bertiniFamily k (FractionRing A) n
      (fun i ↦ algebraMap A (FractionRing A) (g i)) c =
      (fun j : Fin n ⊕ Fin 2 ↦
        algebraMap (MvPolynomial (Fin n) (FractionRing A))
          (FractionRing (MvPolynomial (Fin n) (FractionRing A)))
          (match j with
          | Sum.inl i => MvPolynomial.X i
          | Sum.inr i => Fin.cases
              (∑ i : Fin n, MvPolynomial.C (algebraMap A (FractionRing A) (g i)) *
                MvPolynomial.X i)
              (fun _ ↦ MvPolynomial.C (∑ i : Fin n,
                algebraMap k (FractionRing A) (c i) *
                  algebraMap A (FractionRing A) (g i))) i)) ∘ finSumFinEquiv.symm := by
    funext j
    obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective j
    simp only [Function.comp_apply, Equiv.symm_apply_apply]
    rcases j with i | i
    · change bertiniFamily k (FractionRing A) n
        (fun i ↦ algebraMap A (FractionRing A) (g i)) c i.castSucc.castSucc = _
      simp [bertiniFamily, bertiniCoordinate]
    · refine Fin.cases ?_ (fun j ↦ ?_) i
      · change bertiniFamily k (FractionRing A) n
          (fun i ↦ algebraMap A (FractionRing A) (g i)) c (Fin.last n).castSucc = _
        simp only [bertiniFamily, Fin.lastCases_castSucc, Fin.lastCases_last,
          Fin.cases_zero, bertiniXi, bertiniCoordinate, map_sum, map_mul]
        apply Finset.sum_congr rfl
        intro j _
        congr 1
      · have hj : j = 0 := Subsingleton.elim _ _
        subst j
        change bertiniFamily k (FractionRing A) n
          (fun i ↦ algebraMap A (FractionRing A) (g i)) c (Fin.last (n + 1)) = _
        simp only [bertiniFamily, Fin.lastCases_last, bertiniDelta,
          Fin.cases_succ, map_sum, map_mul]
        apply Finset.sum_congr rfl
        intro j _
        rfl
  rw [he]
  exact hc.comp finSumFinEquiv.symm finSumFinEquiv.symm.injective

end FieldTheory
