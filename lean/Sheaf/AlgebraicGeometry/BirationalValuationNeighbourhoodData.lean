module

public import Sheaf.AlgebraicGeometry.RiemannZariskiFiniteRefinement
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.CategoryTheory.Limits.IsLimit
public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction

/-!
# Valuation topology and affine neighbourhood diagrams

Source: Temkin, Stable modification of relative curves, §3.2, pp. 15--17
(blueprint: def-trf-birational-valuation-neighbourhood-data).

The model, quasi-model, and valuation-point types are the existing Riemann--Zariski
constructions. All maps below are induced by the actual scheme morphisms.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace AlgebraicGeometry.RiemannZariski

variable {T : Scheme.{u}} {L : Type u} [Field L] {η : Spec (.of L) ⟶ T}

/-- The open cylinder of a model chart, defined without choosing valuative lifts.
Source: Temkin §3.2, Proposition 3.2.1 and Corollary 3.2.5
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def valuationCylinder (M : Model T L η) (W : M.X.Opens) : Set (ValuationPoint T L η) :=
  {v | ∃ l : Spec (.of v.V) ⟶ M.X,
    l ≫ M.map = v.centre ∧ Spec.map (CommRingCat.ofHom v.V.subtype) ≫ l = M.generic ∧
      l (IsLocalRing.closedPoint v.V) ∈ W}

/-- The topology generated by all proper-model open cylinders. Once the unique
valuative lifts are supplied, these are precisely inverse images under centre projections.
Source: Temkin §3.2, Proposition 3.2.1 and Corollary 3.2.5
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
@[instance_reducible] def valuationTopology (T : Scheme.{u}) (L : Type u) [Field L]
    (η : Spec (.of L) ⟶ T) : TopologicalSpace (ValuationPoint T L η) :=
  TopologicalSpace.generateFrom {s | ∃ (M : Model T L η) (W : M.X.Opens),
    s = valuationCylinder M W}

/-- An affine open neighbourhood of the valuation centre on a proper model.
The lift to the open encodes that the centre belongs to it. Source: Temkin §3.2,
Lemma 3.2.2 and Corollaries 3.2.4--3.2.5
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
structure AffineValuationNeighbourhood (v : ValuationPoint T L η) where
  model : Model T L η
  U : model.X.Opens
  affine : IsAffineOpen U
  lift : Spec (.of v.V) ⟶ U.toScheme
  generic : Spec (.of L) ⟶ U.toScheme
  generic_model : generic ≫ U.ι = model.generic
  lift_generic : Spec.map (CommRingCat.ofHom v.V.subtype) ≫ lift = generic
  over : (lift ≫ U.ι) ≫ model.map = v.centre

variable {v : ValuationPoint T L η}

/-- The actual coordinate ring of the affine open, in its global-sections presentation.
Source: Temkin §3.2, Lemma 3.2.2
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def AffineValuationNeighbourhood.ring (N : AffineValuationNeighbourhood v) : CommRingCat.{u} :=
  Γ(N.U.toScheme, ⊤)

/-- The coordinate-ring map induced by the prescribed valuation lift, followed by
`Γ(Spec V) ≅ V`. Source: Temkin §3.2, Lemma 3.2.2
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def AffineValuationNeighbourhood.intoV (N : AffineValuationNeighbourhood v) :
    N.ring →+* v.V :=
  (N.lift.appTop ≫ (Scheme.ΓSpecIso (.of v.V)).hom).hom

/-- The same canonical coordinate-ring map into the fixed field.
Source: Temkin §3.2, Lemma 3.2.2
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def AffineValuationNeighbourhood.intoField (N : AffineValuationNeighbourhood v) :
    N.ring →+* L :=
  v.V.subtype.comp N.intoV

/-- A refinement of affine neighbourhoods is the restriction of a morphism of
proper models and respects the valuation and generic maps. Source: Temkin §3.2,
Lemma 3.2.2 (blueprint: def-trf-birational-valuation-neighbourhood-data). -/
structure AffineValuationRefinement (N N' : AffineValuationNeighbourhood v) where
  modelHom : ModelHom N'.model N.model
  hom : N'.U.toScheme ⟶ N.U.toScheme
  restriction : hom ≫ N.U.ι = N'.U.ι ≫ modelHom.hom
  valuation : N'.lift ≫ hom = N.lift
  generic : N'.generic ≫ hom = N.generic

/-- A small directed family of affine model neighbourhoods, cofinal among those
satisfying `P`. Its opposite is the requested small cofiltered indexing category.
Transition maps on coordinate rings are the actual pullbacks of refinements.
Source: Temkin §3.2, Lemma 3.2.2 and Corollaries 3.2.4--3.2.5
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
structure AffineValuationSystem (v : ValuationPoint T L η)
    (P : AffineValuationNeighbourhood v → Prop) where
  I : Type u
  [order : Preorder I]
  [nonempty : Nonempty I]
  [directed : IsDirected I (· ≤ ·)]
  N : I → AffineValuationNeighbourhood v
  admissible : ∀ i, P (N i)
  cofinal : ∀ Q, P Q → ∃ i, Nonempty (AffineValuationRefinement Q (N i))
  refinement : ∀ (i j : I), i ≤ j → AffineValuationRefinement (N i) (N j)
  ring_id : ∀ i, (refinement i i le_rfl).hom.appTop = 𝟙 (N i).ring
  ring_comp : ∀ (i j k : I) (hij : i ≤ j) (hjk : j ≤ k),
    (refinement i k (le_trans hij hjk)).hom.appTop =
      (refinement i j hij).hom.appTop ≫ (refinement j k hjk).hom.appTop
  intoV_compat : ∀ (i j : I) (h : i ≤ j),
    (N j).intoV.comp (refinement i j h).hom.appTop.hom = (N i).intoV

attribute [instance] AffineValuationSystem.order AffineValuationSystem.nonempty
  AffineValuationSystem.directed

/-- The filtered diagram of actual affine coordinate rings.
Source: Temkin §3.2, Lemma 3.2.2
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def AffineValuationSystem.ringDiagram {P : AffineValuationNeighbourhood v → Prop}
    (d : AffineValuationSystem v P) : d.I ⥤ CommRingCat.{u} where
  obj i := (d.N i).ring
  map f := (d.refinement _ _ (leOfHom f)).hom.appTop
  map_id i := d.ring_id i
  map_comp f g := d.ring_comp _ _ _ (leOfHom f) (leOfHom g)

/-- The canonical cocone into the given valuation subring, never an arbitrary map.
Source: Temkin §3.2, Lemma 3.2.2
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def AffineValuationSystem.ringCocone {P : AffineValuationNeighbourhood v → Prop}
    (d : AffineValuationSystem v P) : Cocone d.ringDiagram where
  pt := .of v.V
  ι :=
    { app := fun i ↦ CommRingCat.ofHom (d.N i).intoV
      naturality := fun i j f ↦ congrArg CommRingCat.ofHom (d.intoV_compat i j (leOfHom f)) }

/-- The coordinate rings embed into the valuation ring and the fixed fraction field,
and their canonical cocone is colimiting. Source: Temkin §3.2, Lemma 3.2.2 and
Corollaries 3.2.4--3.2.5
(blueprint: def-trf-birational-valuation-neighbourhood-data). -/
structure AffineValuationColimit (v : ValuationPoint T L η)
    (P : AffineValuationNeighbourhood v → Prop) extends AffineValuationSystem v P where
  intoV_injective : ∀ i, Function.Injective (N i).intoV
  transition_injective : ∀ (i j : I) (h : i ≤ j),
    Function.Injective (refinement i j h).hom.appTop
  fractionField : ∀ i,
    @IsFractionRing (N i).ring _ L _ (N i).intoField.toAlgebra
  ring_colimit : IsColimit toAffineValuationSystem.ringCocone
  union_eq : ∀ a : v.V, ∃ (i : I) (b : (N i).ring), (N i).intoV b = a

/-- Restriction to models dominating a fixed model and to charts whose image lies
in a prescribed open neighbourhood of its centre. Source: Temkin §3.2, Corollaries
3.2.4--3.2.5 (blueprint: def-trf-birational-valuation-neighbourhood-data). -/
def AffineValuationNeighbourhood.AboveWithin (N : AffineValuationNeighbourhood v)
    (M : Model T L η) (W : M.X.Opens) : Prop :=
  ∃ r : ModelHom N.model M, ∀ x : N.U.toScheme, (N.U.ι ≫ r.hom) x ∈ W

end AlgebraicGeometry.RiemannZariski
