import WeilConjectures.AlgebraicGeometry.RelativeEffectiveCartier

/-!
# Local fibre criterion for relative effective Cartier divisors

Source: Stacks Project, Divisors, Lemma 31.19.9 (Tag 062Y), part (3)
(blueprint: lem-pc-recd-fibre-cartier-local).
-/

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- If a closed subscheme is locally principal near `x` and its fibre over `π x` is an
effective Cartier divisor near `x`, then the subscheme is a relative effective Cartier
divisor on a neighbourhood of `x` (Stacks, Tag 062Y(3))
(blueprint: lem-pc-recd-fibre-cartier-local).

The assertion is local on `X`. Choose affine opens `Spec A` around `π x` and
`Spec B` around `x`, with `Spec B` mapping into `Spec A`. Let `p` and `q` be the
corresponding primes, and `I` the ideal of the restricted closed subscheme. Flatness
and local finite presentation give a flat finitely presented map `A → B`
(`def-weil-scheme-morphism-properties`). Shrink around `x` so that `I` is principal
and its extension to `B ⊗[A] κ(p)` is locally generated by a nonzerodivisor
(`def-sc-effective-cartier-divisor`); outside its vanishing locus the ideal is the
unit ideal, which is generated by `1`.

Apply `lem-pc-algebra-fibre-cartier-local`, implemented by
`Algebra.exists_notMem_isRegularPrincipal_and_flat_of_fiber`, with `K = κ(p)` and
`q` contracting to `p`. It gives `g ∉ q` such that `I B_g` is regular principal
and `B_g / I B_g` is flat over `A`. Set `U = Spec B_g`. This is an open
neighbourhood of `x`, and `Z ∩ U` is an effective Cartier divisor there. Its
map to `S` factors through the open `Spec A`, so it is flat over `S`. These two
properties give the conclusion by `def-pc-relative-effective-cartier`. -/
theorem fibre_cartier_local {X S : Scheme.{u}} (π : X ⟶ S) [Flat π]
    [LocallyOfFinitePresentation π] (J : X.IdealSheafData) (x : X) (hx : x ∈ J.support)
    (hprincipal : ∃ V : X.Opens, x ∈ V ∧ (J.comap V.ι).IsLocallyPrincipal)
    (hfibre : ∃ V : X.Opens, x ∈ V ∧
      ((J.comap (π.fiberι (π x))).comap ((π.fiberι (π x) ⁻¹ᵁ V).ι)).IsInvertible) :
    ∃ U : X.Opens, x ∈ U ∧
      (J.comap U.ι).IsRelativeEffectiveCartier (U.ι ≫ π) := by
  sorry

end AlgebraicGeometry.Scheme.IdealSheafData
