/-! # Finite presentation of a closed immersion and finite type of its ideal

Source: Stacks Project, Tag 01TV, `lemma-closed-immersion-finite-presentation`
(blueprint: lem-trf-closed-immersion-finite-presentation-ideal).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry

open Opposite

private theorem ideal_sections_finite_iff {X : Scheme.{u}} (J : X.IdealSheafData)
    (U : X.affineOpens) :
    Module.Finite Γ(X, U.1) Γ(J.toModules, U.1) ↔ (J.ideal U).FG := by
  let q := (J.toModulesι.val.app (op U.1)).hom
  have hR : q.range = J.ideal U := SetLike.coe_injective (J.range_toModulesι_app U)
  have hq : Function.Bijective q.rangeRestrict :=
    ⟨fun a b h ↦ J.injective_toModulesι_app U.1 (congrArg Subtype.val h),
      fun ⟨a, b, hb⟩ ↦ ⟨b, Subtype.ext hb⟩⟩
  have h := q.rangeRestrict.finite_iff_of_bijective hq
  rw [hR] at h
  exact h.trans Module.Finite.iff_fg

private theorem finitePresentation_iff_fg_ker {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (hsurj : Function.Surjective f) :
    f.FinitePresentation ↔ (RingHom.ker f).FG := by
  constructor
  · intro h
    let : Algebra R S := f.toAlgebra
    have : Algebra.FinitePresentation R S := h
    exact Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId R S) hsurj
  · exact RingHom.FinitePresentation.of_surjective f hsurj


/-- A closed immersion is of finite presentation exactly when its kernel ideal sheaf
is locally generated by finitely many sections as a module over the structure sheaf.
Source: Stacks Project, Tag 01TV, `lemma-closed-immersion-finite-presentation`
(blueprint: lem-trf-closed-immersion-finite-presentation-ideal).

Proof:
1. A closed immersion is affine, hence quasi-compact, since affine schemes are
   quasi-compact (`lem-weil-pbc-affine-scheme-qcqs`). It is separated by
   `lem-weil-pbc-closed-immersion-integral-separated-uc`, so its diagonal is a closed
   immersion, hence quasi-compact by the same argument. It is thus quasi-separated;
   finite presentation reduces to local finite presentation.
2. On each affine open U = Spec R of X, the inverse image is Spec(R/J) for an ideal J.
   The canonical kernel ideal sheaf restricts to the quasi-coherent module tilde J,
   with sections J (`def-sbc-closed-immersion-ideal-sheaf`).
3. The quotient R/J is finitely presented over R exactly when J is finitely generated:
   one direction is `lem-weil-pbc-finite-presentation-surjection-kernel-fg` applied to
   the quotient map, using zero polynomial variables; the other uses the finite
   generators as relations in a presentation with zero variables. Finite generation
   as an ideal is the same as finite generation as an R-module.
4. If the immersion is locally of finite presentation, its maps on affine opens are
   finitely presented (`lem-weil-pbc-lfp-affine-opens-finite-presentation`). Step 3
   gives finite sections of the kernel on an affine cover. The affine criterion
   `lem-weil-pbc-quasi-coherent-finite-type-affine` makes the ideal sheaf of finite type.
5. Conversely, finite type and the same affine criterion give finite generation of J
   on every affine open. Step 3 gives finite presentation of R/J over R. These affine
   neighbourhoods witness local finite presentation, and step 1 supplies the other
   two conditions. No finiteness or separatedness assumption on X is required. -/
theorem IsClosedImmersion.finitePresentation_iff_isFiniteType_ker
    {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] :
    (LocallyOfFinitePresentation i ∧ QuasiCompact i ∧ QuasiSeparated i) ↔
      i.ker.toModules.IsFiniteType := by
  have hqc : i.ker.toModules.IsQuasicoherent := by
    have := SheafOfModules.isQuasicoherent_unit (R := i.ker.subscheme.ringCatSheaf)
    have := SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
    have : SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf)
        ((SheafOfModules.pushforward i.ker.subschemeι.toRingCatSheafHom).obj
          (SheafOfModules.unit i.ker.subscheme.ringCatSheaf)) :=
      Scheme.Modules.isQuasicoherent_pushforward_of_quasiCompact_quasiSeparated
        i.ker.subschemeι _
    exact Scheme.Modules.isQuasicoherent_kernel i.ker.toPushforwardSubscheme
  have hring (U : X.affineOpens) :
      (i.app U.1).hom.FinitePresentation ↔ (i.ker.ideal U).FG := by
    rw [Scheme.Hom.ker_apply]
    exact finitePresentation_iff_fg_ker _ (i.app_surjective U.1 U.2)
  constructor
  · rintro ⟨hfp, _, _⟩
    have hfinite (U : X.affineOpens) :
        Module.Finite Γ(X, U.1) Γ(i.ker.toModules, U.1) := by
      apply (ideal_sections_finite_iff i.ker U).mpr
      apply (hring U).mp
      simpa only [Scheme.Hom.appLE_eq_app] using
        i.finitePresentation_appLE U.2 (U.2.preimage i) le_rfl
    exact (((Scheme.Modules.quasicoherent_finite_type_affine.{u, u} X).2
      i.ker.toModules hqc).2.1 X.affineOpens (fun U ↦ U.1)
      (iSup_affineOpens_eq_top X) (fun U ↦ U.2) hfinite).1
  · intro hfinite
    refine ⟨?_, inferInstance, inferInstance⟩
    apply (HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation)
      (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
        RingHom.finitePresentation_holdsForLocalizationAway).1).mpr
    intro z
    obtain ⟨U, hU, hz, _⟩ := exists_isAffineOpen_mem_and_subset
      (show i z ∈ (⊤ : X.Opens) from trivial)
    refine ⟨⟨U, hU⟩, ⟨i ⁻¹ᵁ U, hU.preimage i⟩, hz, le_rfl, ?_⟩
    have hfg : (i.ker.ideal ⟨U, hU⟩).FG :=
      (ideal_sections_finite_iff i.ker ⟨U, hU⟩).mp
        (Scheme.Modules.finite_sections_of_finiteType i.ker.toModules hU)
    simpa only [Scheme.Hom.appLE_eq_app] using (hring ⟨U, hU⟩).mpr hfg

end AlgebraicGeometry
