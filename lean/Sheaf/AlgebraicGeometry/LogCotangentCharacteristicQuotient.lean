module

public import Sheaf.AlgebraicGeometry.LogSmoothDifferentialGenerators
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Sheaf.AlgebraicGeometry.StrictHenselizationCompatibility
import Mathlib.GroupTheory.FiniteAbelian.Basic
import WeilConjectures.RingTheory.HenselianLocalRootLifting
import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
import Sheaf.AlgebraicGeometry.PointedEtaleStalk
import Sheaf.AlgebraicGeometry.StrictHenselization
import WeilConjectures.AlgebraicGeometry.Sites.StrictHenselization
import WeilConjectures.Mathlib.RingTheory.Henselian

/-!
# The residue logarithmic cotangent quotient

Source: ILO, Exposé X, proof of Proposition 1.2, pp.136--137, map (1) and the
paragraph preceding diagram (3) (blueprint: lem-per-log-cotangent-characteristic-quotient).

Group completions and characteristic quotients use the existing log structures.
`Additive` changes the notation on the multiplicatively written characteristic group
for tensor products over `ℤ`. Locality of the geometric ring stalk is supplied in the
conclusion, so no extra local-ring hypothesis or chosen residue field is required.
The map is characterized on monoid differential symbols, which generate the differential
module; this also characterizes its values on logarithmic differentials of group elements.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry
namespace EtaleLogHom

variable {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
variable {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme)
variable {Q : Type u} [CommMonoid Q]
variable (β : Q →* Y.logStructure.monoidSheaf.obj.obj
  (op (Scheme.Etale.mk (𝟙 Y.scheme))))

/-- The relative characteristic group `C / im(Q^gp)`, with additive notation.
The existing generator-image definition with an empty family is exactly the subgroup
image of the base chart's group completion. Source: ILO X 1.2, map (1), pp.136--137
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable abbrev RelativeCharacteristicGroup :=
  Additive (Algebra.GrothendieckGroup (X.logStructure.characteristic t) ⧸
    f.differentialGeneratorImage t β (r := 0) Fin.elim0)

/-- The canonical class of an element of `M_x^gp` in the relative characteristic group.
This is the universal group extension of the existing characteristic-class map, followed
by the actual subgroup quotient. Source: ILO X 1.2, map (1), pp.136--137
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable def relativeCharacteristicClass :
    Additive (Algebra.GrothendieckGroup (X.logStructure.stalk t)) →+
      f.RelativeCharacteristicGroup t β :=
  ((QuotientGroup.mk' (f.differentialGeneratorImage t β (r := 0) Fin.elim0)).comp
    (Algebra.GrothendieckGroup.lift (X.logStructure.characteristicClass t))).toAdditive

/-- The subgroup generated by the characteristic classes of arbitrary group-completion
basis lifts and by the base chart. The lifts need not belong to the original monoid.
Source: ILO X 1.2, the map `u` before diagram (3), p.137
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable def characteristicGroupBasisImage {r : ℕ}
    (ts : Fin r → Algebra.GrothendieckGroup (X.logStructure.stalk t)) :
    Subgroup (Algebra.GrothendieckGroup (X.logStructure.characteristic t)) :=
  Subgroup.closure
    (Set.range (fun i ↦
      Algebra.GrothendieckGroup.lift (X.logStructure.characteristicClass t) (ts i)) ∪
      Set.range ((X.logStructure.characteristicClass t).comp (f.baseChartGerm t β)))

/-- The residue log cotangent quotient, existence of characteristic basis lifts, the
finite prime-to-characteristic cokernel for every such basis, and all invertible-exponent
unit roots. Source: ILO X, proof of Proposition 1.2, pp.136--137
(blueprint: lem-per-log-cotangent-characteristic-quotient).

Proof:
1. Geometric stalks are pointed étale colimits. Restriction to affine neighbourhoods
   by `lemma-weil-pbc-affine-neighbourhood-cofinal` identifies the ring with the colimit
   of `def-weil-pbc-strict-henselization-limit`. Apply
   `lem-weil-pbc-strict-henselization-local-structure`: it is a henselian local ring
   with separably closed residue field (`def-weil-pbc-henselian-terminology`).
2. An fs chart for the source generates its characteristic monoid modulo units.
   A finite monoid generating family therefore generates `C` and its quotient `D`.
3. Send ordinary differential symbols to zero and logarithmic symbols to their
   characteristic classes. Additivity, Leibniz, and the logarithmic product relation
   are respected. In the structural relation, a nonunit has zero residue, while a
   log element whose structural image is a unit has zero characteristic class, by
   `lem-weil-pbc-local-ring-unit-criterion` and the log unit condition. Base symbols
   vanish because their classes lie in the chart image. This defines the residue
   linear map. Pure tensors of log classes generate its target, so it is surjective.
4. Choose a basis from the finite spanning family of images of log sections, and
   lift it to `M_x^gp`. For zero target the empty family is a basis.
5. For any such basis, its characteristic cokernel `E` is finitely generated. Tensor
   right exactness and the spanning property imply `k ⊗[ℤ] E = 0`.
6. Apply `lem-sbc-finitely-generated-abelian-group-structure`. A free summand or a
   primary summand of residue characteristic would give a nonzero tensor with `k`.
   Thus `E` is finite with an annihilator `n > 0` prime to the residue characteristic.
   The local-ring unit criterion makes `n` invertible in the geometric ring stalk.
7. For each positive invertible `a` and each unit `v`, separable closedness
   (`def-pc-separably-closed`) gives a nonzero simple root of `T^a-v` in the residue
   field. `lem-weil-pbc-henselian-local-root-lifting` lifts it to a root in the ring.
   Its nonzero residue makes the lift a unit. This proves divisibility for every
   such `a`, independently of the basis and its annihilator `n`.
-/
theorem logCotangent_characteristic_quotient
    (hf : f.IsLogSmooth) (hQ : IsFineSaturatedMonoid Q)
    (hsharp : ∀ q : Q, IsUnit q → q = 1)
    (hβ : Y.logStructure.IsChart (Scheme.Etale.mk (𝟙 Y.scheme)) β) :
    ∃ (_ : IsLocalRing (strictLocalRing X.scheme t)),
      (∃ π : TensorProduct (strictLocalRing X.scheme t)
          (IsLocalRing.ResidueField (strictLocalRing X.scheme t)) (f.LogDifferential t) →ₗ[
            IsLocalRing.ResidueField (strictLocalRing X.scheme t)]
          TensorProduct ℤ (IsLocalRing.ResidueField (strictLocalRing X.scheme t))
            (f.RelativeCharacteristicGroup t β),
        Function.Surjective π ∧
        (∀ m : X.logStructure.stalk t,
          π (1 ⊗ₜ[strictLocalRing X.scheme t] f.logDLog t m) =
            1 ⊗ₜ[ℤ] f.relativeCharacteristicClass t β
              (Additive.ofMul (Algebra.GrothendieckGroup.of m))) ∧
        ∀ a : strictLocalRing X.scheme t,
          π (1 ⊗ₜ[strictLocalRing X.scheme t] f.logD t a) = 0) ∧
      (∃ (r : ℕ) (ts : Fin r → Algebra.GrothendieckGroup (X.logStructure.stalk t))
          (b : Module.Basis (Fin r) (IsLocalRing.ResidueField (strictLocalRing X.scheme t))
            (TensorProduct ℤ (IsLocalRing.ResidueField (strictLocalRing X.scheme t))
              (f.RelativeCharacteristicGroup t β))),
        ∀ i, b i = 1 ⊗ₜ[ℤ] f.relativeCharacteristicClass t β (Additive.ofMul (ts i))) ∧
      (∀ (r : ℕ) (ts : Fin r → Algebra.GrothendieckGroup (X.logStructure.stalk t)),
        (∃ b : Module.Basis (Fin r) (IsLocalRing.ResidueField (strictLocalRing X.scheme t))
            (TensorProduct ℤ (IsLocalRing.ResidueField (strictLocalRing X.scheme t))
              (f.RelativeCharacteristicGroup t β)),
          ∀ i, b i = 1 ⊗ₜ[ℤ] f.relativeCharacteristicClass t β (Additive.ofMul (ts i))) →
        Finite (Algebra.GrothendieckGroup (X.logStructure.characteristic t) ⧸
          f.characteristicGroupBasisImage t β ts) ∧
        ∃ n : ℕ, 0 < n ∧ IsUnit (n : strictLocalRing X.scheme t) ∧
          ∀ c : Algebra.GrothendieckGroup (X.logStructure.characteristic t) ⧸
            f.characteristicGroupBasisImage t β ts, c ^ n = 1) ∧
      ∀ a : ℕ, 0 < a → IsUnit (a : strictLocalRing X.scheme t) →
        ∀ v : (strictLocalRing X.scheme t)ˣ, ∃ w : (strictLocalRing X.scheme t)ˣ,
          w ^ a = v := by
  sorry

end EtaleLogHom
end AlgebraicGeometry
