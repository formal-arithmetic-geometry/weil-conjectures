/-!
# Residue logarithmic cotangent quotient

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, Exposé X, proof of
Proposition 1.2, printed pp.136--137, map (1) and the paragraph before (3)
(blueprint: lem-per-log-cotangent-characteristic-quotient).

Group completions and their quotients use multiplicative notation; `Additive`
translates them into integer modules for tensor products. The residue ring and
cotangent fibre are the existing canonical constructions. A group-completion
logarithmic symbol represented by `m / n` is `logDLog m - logDLog n`.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.EtaleLogHom

/-- Extension of the canonical characteristic class to the log-stalk group completion.
Source: ILO X 1.2, p.136, the definition below (1)
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable def characteristicGroupClass
    {X : Scheme.{u}} (M : EtaleLogStructure X)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X) :
    Algebra.GrothendieckGroup (M.stalk x) →*
      Algebra.GrothendieckGroup (M.characteristic x) :=
  Algebra.GrothendieckGroup.lift (M.characteristicClass x)

/-- The relative characteristic group `D = C / im(Q^gp)`. The empty generator
family in the existing generator-image subgroup gives precisely the base image.
Source: ILO X 1.2, p.136, the definition below (1)
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable abbrev RelativeCharacteristicGroup
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme)
    {Q : Type u} [CommMonoid Q]
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme)))) :=
  Algebra.GrothendieckGroup (X.logStructure.characteristic x) ⧸
    f.differentialGeneratorImage x β (Fin.elim0 : Fin 0 → X.logStructure.stalk x)

/-- The canonical class of a log group element in the relative characteristic group.
Source: ILO X 1.2, pp.136--137, map (1) and the choice of the `t_i`
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable def relativeCharacteristicClass
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme)
    {Q : Type u} [CommMonoid Q]
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme)))) :
    Algebra.GrothendieckGroup (X.logStructure.stalk x) →*
      f.RelativeCharacteristicGroup x β :=
  (QuotientGroup.mk' _).comp (characteristicGroupClass X.logStructure x)

/-- The characteristic fibre `k ⊗[ℤ] D`, using the actual residue-ring construction.
Source: ILO X 1.2, p.136, map (1)
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable abbrev RelativeCharacteristicFibre
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme)
    {Q : Type u} [CommMonoid Q]
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme)))) :=
  TensorProduct ℤ (logCotangentResidue x) (Additive (f.RelativeCharacteristicGroup x β))

/-- The characteristic cokernel after adjoining a finite family in the log group
completion. Its subgroup is the sum of the subgroup generated by the family and
exactly the existing base-image subgroup.
Source: ILO X 1.2, p.137, the cokernel of the map `u` before diagram (3)
(blueprint: lem-per-log-cotangent-characteristic-quotient). -/
noncomputable abbrev CharacteristicGeneratorCokernel
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme)
    {Q : Type u} [CommMonoid Q]
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme))))
    {r : ℕ} (ts : Fin r → Algebra.GrothendieckGroup (X.logStructure.stalk x)) :=
  Algebra.GrothendieckGroup (X.logStructure.characteristic x) ⧸
    (Subgroup.closure (Set.range (fun i ↦ characteristicGroupClass X.logStructure x (ts i))) ⊔
      f.differentialGeneratorImage x β (Fin.elim0 : Fin 0 → X.logStructure.stalk x))

/-- The residue logarithmic cotangent surjection, existence of a finite basis of
characteristic classes, the prime-to-residue-characteristic cokernel for every such
basis, and divisibility of strict local units by every invertible positive integer.
Source: ILO X, proof of Proposition 1.2, printed pp.136--137, map (1), the choice
of the `t_i`, and the paragraph before diagram (3)
(blueprint: lem-per-log-cotangent-characteristic-quotient).

Proof, following the node's seven steps:
1. Identify the geometric ring stalk with the affine pointed-neighbourhood colimit
   [def-weil-pbc-strict-henselization-limit], by affine cofinality
   [lemma-weil-pbc-affine-neighbourhood-cofinal] and [def-weil-pbc-geometric-stalks].
   Local structure [lem-weil-pbc-strict-henselization-local-structure] and
   [def-weil-pbc-henselian-terminology] give a strictly henselian local ring with
   separably closed residue field. This field need not equal the field of the point.
2. An fs chart [def-trf-fs-log-blowup] gives finitely many generators for the
   characteristic group and its relative quotient: chart elements times units
   generate the log stalk.
3. On the differential presentation [def-per-log-differential-stalk], send ordinary
   symbols to zero and logarithmic symbols to their relative characteristic classes.
   Additivity, Leibniz and multiplicativity respect this prescription. In the relation
   `dα(m) = α(m)dlog m`, a nonunit coefficient has zero residue by
   [lem-weil-pbc-local-ring-unit-criterion]; a unit coefficient makes the characteristic
   class zero by the log unit axiom. Base log elements are chart elements times units,
   so all base relations vanish. Descend and extend scalars to obtain the displayed
   map. Every relative class lifts to the log group completion, proving surjectivity.
4. Extract a basis from the finite spanning family of pure characteristic tensors,
   and lift its elements to the log group completion. The zero space gives `r = 0`.
5. For any such basis, its characteristic cokernel `E` is finitely generated, and
   `k ⊗ E = 0`: the tensor quotient map is onto and kills the spanning basis.
6. Apply [lem-sbc-finitely-generated-abelian-group-structure]. A free summand or a
   primary summand of residue characteristic would give a nonzero map `k ⊗ E → k`.
   Thus `E` is finite with order prime to the residue characteristic. Its positive
   order annihilates it and is a unit by [lem-weil-pbc-local-ring-unit-criterion].
   For the trivial group take the annihilator `1`.
7. For every positive invertible `a` and unit `u`, `T^a-u` is separable over the
   residue field. It has a nonzero simple root by [def-pc-separably-closed]. Lift
   that root by [lem-weil-pbc-henselian-local-root-lifting]; its nonzero residue
   makes the lift a unit by [lem-weil-pbc-local-ring-unit-criterion].
-/
theorem exists_logCotangent_characteristicQuotient
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    (hf : f.IsLogSmooth) {Q : Type u} [CommMonoid Q]
    (hQ : IsFineSaturatedMonoid Q) (hsharp : ∀ q : Q, IsUnit q → q = 1)
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme))))
    (hβ : Y.logStructure.IsChart (Scheme.Etale.mk (𝟙 Y.scheme)) β)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (x : Spec (.of Ω) ⟶ X.scheme) :
    (∃ π : f.LogCotangentTarget x →ₗ[logCotangentResidue x]
        f.RelativeCharacteristicFibre x β,
      Function.Surjective π ∧
        (∀ m n : X.logStructure.stalk x,
          π (TensorProduct.tmul (strictLocalRing X.scheme x) 1
            (f.logDLog x m - f.logDLog x n)) =
          TensorProduct.tmul ℤ 1 (Additive.ofMul (f.relativeCharacteristicClass x β
            (Algebra.GrothendieckGroup.of m / Algebra.GrothendieckGroup.of n)))) ∧
        ∀ a : strictLocalRing X.scheme x,
          π (TensorProduct.tmul (strictLocalRing X.scheme x) 1 (f.logD x a)) = 0) ∧
      (∃ (r : ℕ) (ts : Fin r → Algebra.GrothendieckGroup (X.logStructure.stalk x))
        (b : Module.Basis (Fin r) (logCotangentResidue x)
          (f.RelativeCharacteristicFibre x β)),
        ∀ i, b i = TensorProduct.tmul ℤ 1
          (Additive.ofMul (f.relativeCharacteristicClass x β (ts i)))) ∧
      (∀ (r : ℕ) (ts : Fin r → Algebra.GrothendieckGroup (X.logStructure.stalk x))
        (b : Module.Basis (Fin r) (logCotangentResidue x)
          (f.RelativeCharacteristicFibre x β)),
        (∀ i, b i = TensorProduct.tmul ℤ 1
          (Additive.ofMul (f.relativeCharacteristicClass x β (ts i)))) →
        Finite (f.CharacteristicGeneratorCokernel x β ts) ∧
          ∃ n : ℕ, 0 < n ∧ IsUnit (n : strictLocalRing X.scheme x) ∧
            ∀ c : f.CharacteristicGeneratorCokernel x β ts, c ^ n = 1) ∧
      ∀ a : ℕ, 0 < a → IsUnit (a : strictLocalRing X.scheme x) →
        ∀ v : (strictLocalRing X.scheme x)ˣ,
          ∃ w : (strictLocalRing X.scheme x)ˣ, w ^ a = v := by
  sorry

end AlgebraicGeometry.EtaleLogHom
