module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Sheaf.AlgebraicGeometry.EtaleSetInverseImageCompositionUnits
import Sheaf.AlgebraicGeometry.EtaleInverseImageSectionDescription
import Sheaf.AlgebraicGeometry.EtaleOpenFpqcDescent
import Sheaf.AlgebraicGeometry.EtaleSectionsEqualOpen
import Sheaf.AlgebraicGeometry.EtaleSetInverseImageRestriction

/-! # Compatible local representatives for fpqc descent of étale sections

Source: Stacks Project, Tag 09XN, the agreement-open construction before final gluing.
(blueprint: lem-weil-pbc-etale-fpqc-matching-family). -/

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- Source: Stacks Project, Tag 09XN, proof, paragraphs beginning "Let V" and
"By construction", and the agreement-open argument of Tag 09XM.
(blueprint: lem-weil-pbc-etale-fpqc-matching-family).

This produces local sections and their compatibility, before applying the sheaf axiom.
The matching equation is on the whole base change of each object in the covering sieve.

Proof:
1. For an étale object V and t in F(V), form on each T_i times_S V the largest open
   on which the restriction of s_i equals the unit image of t. The universal property
   of the agreement open and the composition-unit equations identify its two pullbacks
   over T_i times_S T_j times_S V, since the prescribed sections agree there.
2. Descend these compatible opens to an open W in V by fpqc open descent. On each
   T_i times_S W the two sections agree. Naturality of the unit identifies the image
   of t restricted to W with the restriction of s_i along its structure map to T_i.
3. Locally on every T_i, the inverse-image section description represents s_i by a
   section t of some étale V over S. Apply steps 1 and 2 to every such representative.
   Its test scheme factors through W by the universal property of the agreement opens
   and joint surjectivity after fpqc base change. The images of these W cover S:
   the representative test schemes cover the T_i, and the T_i jointly cover S.
   Thus the sieve generated by W to S is covering in the small étale topology.
   Choosing one such W over each point of S gives a small covering subfamily.
4. On a common étale test object Z, two representatives restricted from these W have
   equal pullbacks under every T_i times_S Z, by step 2 and unit naturality. Their
   largest agreement open in Z therefore contains the images of this fpqc cover and
   is all of Z. Testing on the identity of Z, inverse image along an étale morphism
   is restriction, so the two original sections are equal. This proves compatibility
   on the generating family.
5. Extend to its generated sieve by restriction: for a factorization through a W,
   restrict its section. Step 4 makes this independent of the factorization and gives
   compatibility for all pairs of arrows. Naturality gives the matching equation for
   every arrow in the sieve. If S is empty, the empty étale covering and empty family
   give the assertion; no nonempty indexing assumption is required. -/
theorem etaleFpqcSections_exists_matching_family
    {S : Scheme.{u}} {I : Type v} (T : I → Scheme.{u}) (g : ∀ i, T i ⟶ S)
    (hcover : Presieve.ofArrows T g ∈ Scheme.fpqcPrecoverage S)
    (F : Sheaf S.smallEtaleTopology (Type (u + 1)))
    (s : ∀ i, ((Scheme.etaleSetPullback (g i)).obj F).obj.obj
      (op (Scheme.Etale.mk (𝟙 (T i)))))
    (hcompat : ∀ i j,
      ((Classical.choose etaleSetInverseImageCompositionUnits.2.2
          S (T i) (pullback (g i) (g j)) (g i) (pullback.fst (g i) (g j))).hom.app F).hom.app
        (op (Scheme.Etale.mk (𝟙 (pullback (g i) (g j)))))
        (((Scheme.etaleSetPullback (pullback.fst (g i) (g j))).obj
            ((Scheme.etaleSetPullback (g i)).obj F)).obj.map
          (MorphismProperty.Over.homMk
            (pullback.lift (pullback.fst (g i) (g j)) (𝟙 (pullback (g i) (g j)))
              ((Category.comp_id _).trans (Category.id_comp _).symm))
            (by simp) :
            Scheme.Etale.mk (𝟙 (pullback (g i) (g j))) ⟶
              (MorphismProperty.Over.pullback @Etale ⊤ (pullback.fst (g i) (g j))).obj
                (Scheme.Etale.mk (𝟙 (T i)))).op
          (((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
            (MorphismProperty.Over.pullback @Etale ⊤ (pullback.fst (g i) (g j))) _
            ((T i).smallGrothendieckTopology @Etale)
            ((pullback (g i) (g j)).smallGrothendieckTopology @Etale)).unit.app
              ((Scheme.etaleSetPullback (g i)).obj F)).hom.app
            (op (Scheme.Etale.mk (𝟙 (T i)))) (s i))) =
        Eq.mp (congrArg (fun k : pullback (g i) (g j) ⟶ S ↦
          ((Scheme.etaleSetPullback k).obj F).obj.obj
            (op (Scheme.Etale.mk (𝟙 (pullback (g i) (g j))))))
          (pullback.condition (f := g i) (g := g j)).symm)
        (((Classical.choose etaleSetInverseImageCompositionUnits.2.2
            S (T j) (pullback (g i) (g j)) (g j) (pullback.snd (g i) (g j))).hom.app F).hom.app
          (op (Scheme.Etale.mk (𝟙 (pullback (g i) (g j)))))
          (((Scheme.etaleSetPullback (pullback.snd (g i) (g j))).obj
              ((Scheme.etaleSetPullback (g j)).obj F)).obj.map
            (MorphismProperty.Over.homMk
              (pullback.lift (pullback.snd (g i) (g j)) (𝟙 (pullback (g i) (g j)))
                ((Category.comp_id _).trans (Category.id_comp _).symm))
              (by simp) :
              Scheme.Etale.mk (𝟙 (pullback (g i) (g j))) ⟶
                (MorphismProperty.Over.pullback @Etale ⊤ (pullback.snd (g i) (g j))).obj
                  (Scheme.Etale.mk (𝟙 (T j)))).op
            (((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
              (MorphismProperty.Over.pullback @Etale ⊤ (pullback.snd (g i) (g j))) _
              ((T j).smallGrothendieckTopology @Etale)
              ((pullback (g i) (g j)).smallGrothendieckTopology @Etale)).unit.app
                ((Scheme.etaleSetPullback (g j)).obj F)).hom.app
              (op (Scheme.Etale.mk (𝟙 (T j)))) (s j))))) :
    ∃ (R : Sieve (Scheme.Etale.mk (𝟙 S)))
      (x : R.arrows.FamilyOfElements F.obj),
      R ∈ S.smallEtaleTopology (Scheme.Etale.mk (𝟙 S)) ∧ x.Compatible ∧
      ∀ i,
        let β := MorphismProperty.Over.pullback @Etale ⊤ (g i)
        let H := (Scheme.etaleSetPullback (g i)).obj F
        let η := (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
          β (Type (u + 1)) (S.smallGrothendieckTopology @Etale)
          ((T i).smallGrothendieckTopology @Etale)).unit.app F
        ∀ (V : S.Etale) (f : V ⟶ Scheme.Etale.mk (𝟙 S)) (hf : R f),
          η.hom.app (op V) (x f hf) =
            H.obj.map (MorphismProperty.Over.homMk (β.obj V).hom
              (Category.comp_id _) : β.obj V ⟶ Scheme.Etale.mk (𝟙 (T i))).op (s i) := by
  sorry

end AlgebraicGeometry
