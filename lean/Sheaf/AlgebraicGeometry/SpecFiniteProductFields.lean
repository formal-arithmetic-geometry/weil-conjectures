import Mathlib.AlgebraicGeometry.Limits
import Mathlib.RingTheory.Spectrum.Prime.RingHom
import Mathlib.RingTheory.Spectrum.Prime.Topology

open CategoryTheory AlgebraicGeometry

universe u

set_option autoImplicit false

/-! # Spectrum of a finite product of fields
Source: literature/stacks-project/algebra.tex, Lemma 00ED
(blueprint: lem-weil-pbc-spec-finite-product-fields)
-/

namespace AlgebraicGeometry

/-- The spectrum of a finite product of fields is a finite discrete scheme, with
one open component for each factor.
Source: literature/stacks-project/algebra.tex, Lemma 00ED
(blueprint: lem-weil-pbc-spec-finite-product-fields).
Proof:
1. Let e_i have coordinate 1 at i and 0 elsewhere. These are orthogonal idempotents
   summing to 1. Each projection is surjective onto a field, so its kernel is maximal
   and prime. The e_i distinguish the kernels, and the kernel at i is generated by
   the e_j with j ≠ i.
2. Any prime omits some e_i since their sum is 1. It contains every other e_j by
   primeness, hence contains the maximal projection kernel at i and equals it.
   This gives exactly n points (none when n = 0), using `def-weil-affine-spectrum`.
3. D(e_i) is exactly the point with that kernel. Thus each singleton is open and
   every subset is open, again using `def-weil-affine-spectrum`.
4. The projection is localization at e_i: it makes e_i a unit, is surjective, and
   kills c exactly when e_i * c = 0. These are the localization criteria of
   `def-weil-ring-localization-away`.
5. Factor the projection through that localization and its isomorphism to L_i.
   By `lem-weil-pbc-principal-localization-open-immersion` its spectrum is an open
   immersion onto D(e_i), unchanged by the isomorphism of rings. Using
   `def-weil-open-immersion`, this identifies Spec L_i with the singleton open
   subscheme, and the inclusion composed with this isomorphism is Spec of the
   projection.
-/
theorem spec_finite_product_fields
    (n : ℕ) (L : Fin n → Type u) [∀ i, Field (L i)] :
    (∀ (p : Ideal (∀ i, L i)), p.IsPrime ↔
      ∃ i : Fin n, p = Ideal.comap (Pi.evalRingHom L i) ⊥) ∧
    (∀ i j : Fin n, i ≠ j →
      Ideal.comap (Pi.evalRingHom L i) ⊥ ≠ Ideal.comap (Pi.evalRingHom L j) ⊥) ∧
    Nat.card (PrimeSpectrum (∀ i, L i)) = n ∧
    DiscreteTopology (PrimeSpectrum (∀ i, L i)) ∧
    (∀ i : Fin n,
      IsOpenImmersion (Spec.map (CommRingCat.ofHom (Pi.evalRingHom L i))) ∧
      Set.range (fun x : PrimeSpectrum (L i) ↦
        (Spec.map (CommRingCat.ofHom (Pi.evalRingHom L i))).base x) =
        {p | p.asIdeal = Ideal.comap (Pi.evalRingHom L i) ⊥} ∧
      ∃ U : (Spec (.of (∀ i, L i))).Opens,
        (U : Set (Spec (.of (∀ i, L i)))) =
          {p | p.asIdeal = Ideal.comap (Pi.evalRingHom L i) ⊥} ∧
        ∃ e : Spec (.of (L i)) ≅ U.toScheme,
          e.hom ≫ U.ι = Spec.map (CommRingCat.ofHom (Pi.evalRingHom L i))) := by
  sorry

end AlgebraicGeometry
