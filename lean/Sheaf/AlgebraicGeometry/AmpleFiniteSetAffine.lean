module

public import Sheaf.AlgebraicGeometry.Ample
import Sheaf.AlgebraicGeometry.AmpleProjOpen
import Sheaf.AlgebraicGeometry.ProjStandardOpenProperties
import Sheaf.RingTheory.GradedPrimeAvoidance
import Mathlib.AlgebraicGeometry.Morphisms.Immersion

/-! # Affine neighbourhoods of finite sets on schemes with an ample invertible module

Source: Stacks Project, Properties, Lemma 01ZY, case (3)
(blueprint: lem-sc-ample-finite-set-affine).
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.Scheme

private theorem exists_basicOpen_between_finite_and_open
    {S : Type u} [CommRing S] (𝒮 : ℕ → AddSubgroup S) [GradedRing 𝒮]
    (E : Set (Proj 𝒮)) (hE : E.Finite) (W : (Proj 𝒮).Opens)
    (hEW : E ⊆ (W : Set (Proj 𝒮))) :
    ∃ (f : S) (d : ℕ), 0 < d ∧ f ∈ 𝒮 d ∧
      E ⊆ (Proj.basicOpen 𝒮 f : Set (Proj 𝒮)) ∧ Proj.basicOpen 𝒮 f ≤ W := by
  classical
  -- Use all charts in W; only the family of point primes needs to be finite.
  let s : Set S := {f | ∃ d : ℕ, 0 < d ∧ f ∈ 𝒮 d ∧ Proj.basicOpen 𝒮 f ≤ W}
  let I : HomogeneousIdeal 𝒮 :=
    ⟨Ideal.span s, Ideal.homogeneous_span 𝒮 s (by
      rintro f ⟨d, _, hd, _⟩
      exact ⟨d, hd⟩)⟩
  have hI : I ≤ HomogeneousIdeal.irrelevant 𝒮 := by
    apply Ideal.span_le.mpr
    rintro f ⟨d, hd, hf, _⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒮 hd hf
  let := hE.fintype
  let e := Fintype.equivFin E
  let p : Fin (Fintype.card E) → HomogeneousIdeal 𝒮 :=
    fun i ↦ (e.symm i).val.asHomogeneousIdeal
  have hIp : ∀ i, ¬ I ≤ p i := by
    intro i hle
    obtain ⟨V, ⟨f, d, hd, hf, rfl⟩, hx, hVW⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Proj.standardOpenProperties.{u, u, u} 𝒮).1
        (hEW (e.symm i).property)
    exact hx (hle (Ideal.subset_span ⟨d, hd, hf, hVW⟩))
  obtain ⟨d, hd, f, hf, hfI, hfp⟩ :=
    HomogeneousIdeal.exists_homogeneous_mem_notMem_of_isPrime 𝒮 _ p
      (fun i ↦ (e.symm i).val.isPrime) I hI hIp
  refine ⟨f, d, hd, hf, ?_, ?_⟩
  · intro x hx
    simpa [p] using hfp (e ⟨x, hx⟩)
  · intro x hx
    by_contra hxW
    -- Outside W, every generator vanishes, hence so does every element of I.
    have hIx : I ≤ x.asHomogeneousIdeal := by
      apply Ideal.span_le.mpr
      rintro g ⟨n, hn, hg, hgW⟩
      by_contra hxg
      exact hxW (hgW hxg)
    exact hx (hIx hfI)

/-- Every finite subset of a scheme carrying an ample invertible module lies in an affine open.
Source: Stacks Project, Properties, Lemma 01ZY, case (3)
(blueprint: lem-sc-ample-finite-set-affine).

Proof:
1. By `lem-sc-ample-proj-open`, embed `X` as an open subscheme of `Proj S`
   (`def-pc-proj`). Let `W` be the complement of the boundary of its image.
2. The basis clause of `lem-weil-pbc-proj-standard-open-inclusion` shows that the ideal
   generated by all positive-degree homogeneous elements with standard open inside `W`
   is contained in none of the point primes of the image of `E`.
3. Apply `lem-sc-graded-prime-avoidance` to this ideal and those finitely many primes.
   Its homogeneous positive-degree element `f` has standard open containing the image
   of `E` and contained in `W`: outside `W`, every generator belongs to the point prime.
4. Mathlib makes this standard open affine. The immersion factors through a closed
   immersion into `W` (`def-weil-closed-immersion`), and closed immersions are affine
   (`pqf-def-affine-morphism`). Pulling back the standard open gives the required `U`.
-/
theorem exists_affineOpen_of_isAmple (X : Scheme.{u}) (L : X.Modules) [L.IsInvertible]
    (hL : Modules.IsAmple X L) (E : Set X) (hE : E.Finite) :
    ∃ U : X.Opens, IsAffineOpen U ∧ E ⊆ (U : Set X) := by
  classical
  obtain ⟨S, _, 𝒮, _, j, hj⟩ := exists_isOpenImmersion_proj_of_isAmple X L hL
  let := hj
  obtain ⟨f, d, hd, hf, hEf, hfle⟩ :=
    exists_basicOpen_between_finite_and_open 𝒮 (j '' E) (hE.image j) j.coborderRange
      (by rintro _ ⟨x, _, rfl⟩; exact subset_coborder ⟨x, rfl⟩)
  have hV := Proj.isAffineOpen_basicOpen 𝒮 f hf hd
  -- The image of j is closed in its coborder, and closed immersions are affine.
  have hU := (hV.preimage_of_isOpenImmersion j.coborderRange.ι
    (by rwa [Scheme.Opens.opensRange_ι])).preimage j.liftCoborder
  rw [← Scheme.Hom.comp_preimage, Scheme.Hom.liftCoborder_ι] at hU
  exact ⟨j ⁻¹ᵁ Proj.basicOpen 𝒮 f, hU, fun x hx ↦ hEf ⟨x, hx, rfl⟩⟩

end AlgebraicGeometry.Scheme
