module

public import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
import Sheaf.AlgebraicGeometry.FunctorialFanDesingularization
import Sheaf.AlgebraicGeometry.FunctorialLogBlowupEtaleDescent
import Sheaf.AlgebraicGeometry.LogFanChartBlowup
import Sheaf.AlgebraicGeometry.StrictFanChartLocalComparison

/-!
# Monoidal resolution tower for fine saturated log schemes

Source: Illusie–Laszlo–Orgogozo, Exposé VIII, Theorem 3.3.15, pp. 109–110
(blueprint: lem-trf-monoidal-resolution-tower).
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory AlgebraicGeometry

namespace AlgebraicGeometry

/-- A finite saturated log blowup tower makes all characteristic monoids finite free.
Source: ILO, Exposé VIII, 3.3.14--Theorem 3.3.15, pp. 109--110
(blueprint: lem-trf-monoidal-resolution-tower).

Proof:
1. Choose the smooth-functorial saturated fan resolution of
   `lem-trf-functorial-fan-desingularization`. By `lem-trf-log-fan-chart-blowup` (i),
   finitely many quasi-compact strict étale neighborhoods of `X` admit affine fan charts.
   Only the auxiliary fan resolution uses characteristic-zero toric varieties.
2. For a global chart, pull its finite fan resolution back using
   `lem-trf-log-fan-chart-blowup` (ii). At each stage use the inverse image in the log
   structure of the ideal generated by the fan center in the characteristic monoid.
   The centers are nonempty coherent ideals. Delete whole-monoid centers: their
   blowups are identities by the universal property of `IsSaturatedLogBlowup`.
3. By `lem-trf-strict-fan-chart-local-comparison`, two charts agree locally through
   isomorphic localized fans. Fan functoriality identifies their ordered centers and
   pulled-back towers. Uniqueness of universal log blowups makes these comparisons
   canonical and supplies their cocycle identities.
4. The same comparison applied to strict étale maps identifies the source tower with
   the contracted pullback of the target tower. Comparisons preserve centers and
   composition, including component inclusions into finite disjoint unions.
5. Apply `lem-trf-functorial-log-blowup-etale-descent`: the local ordered towers and
   centers descend to a finite tower on `X` of the required saturated log blowups.
6. On every chart, the terminal characteristic stalk agrees with the terminal fan
   stalk, which is a finite free monoid by the fan resolution theorem. Strict étale
   pullback identifies characteristic stalks, giving the assertion at every geometric
   point. Identity-stage contraction changes no terminal stalk. The empty scheme and
   a zero-length tower are allowed. No log regularity or regularity of strata is used. -/
theorem exists_monoidal_resolution_tower {X : FineSaturatedLogScheme.{u}}
    [CompactSpace X.scheme]
    (hTorsionFree : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (t : Spec (.of Ω) ⟶ X.scheme),
      ∀ g : Algebra.GrothendieckGroup (X.logStructure.characteristic t),
        ∀ n : ℕ, n ≠ 0 → g ^ n = 1 → g = 1) :
    ∃ n : ℕ, ∃ T : SaturatedLogBlowupTower.{u},
      T.length = n ∧
        T.level ⟨0, by omega⟩ = X ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
            (t : Spec (.of Ω) ⟶ (T.level ⟨T.length, by omega⟩).scheme),
            ∃ r : ℕ,
              Nonempty
                (((T.level ⟨T.length, by omega⟩).logStructure.characteristic t).carrier ≃*
                  ULift.{u} (Multiplicative (Fin r →₀ ℕ))) := by
  sorry

end AlgebraicGeometry
