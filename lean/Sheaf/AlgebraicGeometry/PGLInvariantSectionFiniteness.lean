module

public import Sheaf.AlgebraicGeometry.PGLLinearizedPolarization
public import WeilConjectures.AlgebraicGeometry.Modules.VeryAmple
public import WeilConjectures.AlgebraicGeometry.Morphisms.Projective
public import Mathlib.RingTheory.FiniteType
import Sheaf.AlgebraicGeometry.ProjectivePolarizationSectionAlgebra
import Sheaf.RepresentationTheory.PGLGeometricReductivity
import Sheaf.AlgebraicGeometry.PGLSectionAffineAction
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Sheaf.AlgebraicGeometry.TensorPullbackQuasiCoherent

/-! # Finiteness of the invariant section algebra of a projective polarization

Source: MFK, GIT, Appendix 1.C; Alper, arXiv:1005.2398v3,
Theorems 9.7.5--9.7.6 and 6.3.3; Stacks, Tag 0B5T.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.PGLLinearization

variable {k : Type u} [Field k]

/-- The invariant section ring is a finite-type k-algebra with its specified
constant map, and its degree-zero algebra is finite-dimensional over k.

Source: MFK, Appendix 1.C; Alper, arXiv:1005.2398v3,
Theorems 9.7.5--9.7.6 and 6.3.3; Stacks, Tag 0B5T
(blueprint: lem-sfb-pgl-invariant-section-finiteness).

Proof: Use the positive tensor power in IsAmple as a projective polarization.
The projective section-algebra theorem gives a finitely generated section ring
S and finite-dimensional homogeneous pieces, including S_0. The linearization
induces a degree-preserving rational PGL action on S: pull back sections by the
universal action and use the powerLift isomorphism to compare the two line
modules. Flat base change of global sections over the field identifies its
values with the tensor-product coaction. The cocycle and naturality identities
of the linearization give the coaction identities; multiplication of sections
is equivariant by monoidal pullback coherence. A homogeneous section is fixed
by this coaction exactly when it satisfies Action.IsInvariant on all schemes.
Comparing homogeneous components therefore identifies the fixed ring with
Action.invariantRing, the ring generated by homogeneous invariant sections.
Apply PGL invariants_finiteType to S and transport the resulting finite-type
structure across this equality. Constants are invariant in degree zero; their
restriction defines φ, whose composite with coefficientVal is constantSection.
The degree-zero invariant ring embeds k-linearly in S_0, so finite-dimensionality
follows by injectivity. This does not assume S_0=k, reducedness, connectedness,
or nonempty Proj. For the zero ring, the unique coefficient map and zero module
satisfy the same assertions. -/
theorem invariant_section_finiteness
    (r : ℕ) (hr : 1 ≤ r) (X : Over (Spec (.of k)))
    (hprojective : IsHProjective X.hom)
    (hfiniteType : LocallyOfFiniteType X.hom ∧ QuasiCompact X.hom)
    (L : X.left.Modules) [L.IsInvertible] (hample : IsAmple X.hom L)
    (E : Action k r X L) :
    ∃ φ : k →+* E.CoefficientRing,
      (∀ c : k, E.coefficientVal (φ c) = constantSection (Z := X) (L := L) c) ∧
      ((algebraMap (E.invariantGrade 0) E.invariantRing).comp φ).FiniteType ∧
      @Module.Finite k E.CoefficientRing _ _ φ.toAlgebra.toModule := by
  classical
  have : IsHProjective X.hom := hprojective
  have : LocallyOfFiniteType X.hom := hfiniteType.1
  have : QuasiCompact X.hom := hfiniteType.2
  obtain ⟨_, m, hm, ι, j, hι, hj, hjf, he⟩ := hample
  have hpol : ∃ (ι : Type u) (_ : Finite ι)
      (j : X.left ⟶ ProjectiveSpace ι (Spec (CommRingCat.of k))),
      IsClosedImmersion j ∧
      j ≫ (ProjectiveSpace ι (Spec (CommRingCat.of k))) ↘ Spec (CommRingCat.of k) = X.hom ∧
      ∃ m : ℕ, 0 < m ∧ Nonempty
        ((Scheme.Modules.tensorPullback j).obj
          (ProjectiveSpace.twist ι (Spec (CommRingCat.of k)) 1) ≅ L.tensorPow m) :=
    ⟨ι, hι, j, hj, hjf, m, hm,
      ⟨(Scheme.Modules.tensorOrdinaryPullbackIso j).app _ ≪≫ he.some⟩⟩
  obtain ⟨⟨ρ, hρ, hρfinite⟩, hpieces, _, _⟩ :=
    Scheme.Modules.projectivePolarizationSectionAlgebra k X.left X.hom L hpol
  change ∀ c, ρ c = constantSection (Z := X) (L := L) c at hρ
  let : Algebra k (Scheme.Modules.InvertibleSectionRing L) := ρ.toAlgebra
  have : Algebra.FiniteType k (Scheme.Modules.InvertibleSectionRing L) := hρfinite
  obtain ⟨D, hD⟩ := section_affine_action r X hprojective hfiniteType L E ρ hρ
  let e := RingEquiv.subringCongr hD
  let c : k →+* E.invariantRing := e.toRingHom.comp D.constants
  have hc (a : k) : (c a).val = ρ a := rfl
  have hc0 (a : k) : c a ∈ E.invariantGrade 0 := by
    change ρ a ∈ Scheme.Modules.sectionRingGrade L 0
    rw [hρ]
    exact ⟨_, rfl⟩
  let φ : k →+* E.CoefficientRing :=
    (GradedRing.projZeroRingHom' E.invariantGrade).comp c
  have hφ (a : k) : E.coefficientVal (φ a) = ρ a := by
    change ((GradedRing.projZeroRingHom' E.invariantGrade (c a)).val).val = _
    have h := GradedRing.projZeroRingHom'_apply_coe E.invariantGrade ⟨c a, hc0 a⟩
    exact congrArg (fun x : E.invariantGrade 0 ↦ x.val.val) h
  refine ⟨φ, fun a ↦ (hφ a).trans (hρ a), ?_, ?_⟩
  · have hfin : D.constants.FiniteType := AffinePGL.invariants_finiteType hr D
    have ht : c.FiniteType := hfin.comp_surjective e.surjective
    have heq : (algebraMap (E.invariantGrade 0) E.invariantRing).comp φ = c := by
      apply RingHom.ext
      intro a
      apply Subtype.ext
      exact (hφ a).trans (hc a).symm
    rw [heq]
    exact ht
  · let : Algebra k E.CoefficientRing := φ.toAlgebra
    let V := Scheme.Modules.SectionRingComponent L 0
    let : Module k V := Module.compHom V
      (X.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom)
    have : Module.Finite k V := hpieces 0
    let f : E.CoefficientRing →ₗ[k] V :=
      { toFun := fun a ↦ a.val.val 0
        map_add' := fun _ _ ↦ rfl
        map_smul' := by
          intro a b
          change (E.coefficientVal (φ a) * b.val.val) 0 = _
          rw [hφ, hρ]
          obtain ⟨v, hv⟩ := b.property
          change DirectSum.of _ 0 v = b.val.val at hv
          rw [← hv]
          simp only [constantSection, DirectSum.of_mul_of,
            DirectSum.of_eq_same]
          change (L.tensorPowAddIso 0 0).inv.app ⊤
            (Scheme.Modules.tmulSection (Scheme.Modules.unitSectionsEquiv ⊤ _) v) = _
          change _ =
            X.hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of k)).inv a) • v
          simpa [Scheme.Modules.tensorPowAddIso] using
            Scheme.Modules.leftUnitor_hom_app_tmulSection
              (X.hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of k)).inv a)) v }
    apply Module.Finite.of_injective f
    intro a b h
    apply Subtype.ext
    apply Subtype.ext
    obtain ⟨v, hv⟩ := a.property
    obtain ⟨w, hw⟩ := b.property
    change DirectSum.of _ 0 v = a.val.val at hv
    change DirectSum.of _ 0 w = b.val.val at hw
    rw [← hv, ← hw]
    change a.val.val 0 = b.val.val 0 at h
    rw [← hv, ← hw, DirectSum.of_eq_same, DirectSum.of_eq_same] at h
    exact congrArg (DirectSum.of _ 0) h

end AlgebraicGeometry.PGLLinearization
