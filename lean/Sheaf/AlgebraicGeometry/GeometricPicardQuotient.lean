module

public import Sheaf.AlgebraicGeometry.LineAlgebraicEquivalence
public import Sheaf.Algebra.Category.ModuleCat.Sheaf.CochainTensorUniverses
public import WeilConjectures.AlgebraicGeometry.Picard.Group
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-! # The Picard quotient by geometric algebraic equivalence

Source: Milne, Abelian Varieties, I §8 and Remark 10.19; the geometric convention in
lem-sfb-semiabelian-generic-picard-class-lifting.
(blueprint: def-sfb-geometric-picard-quotient)

The geometric zero subgroup is constructed as the subgroup generated by classes
algebraically equivalent to the unit after base change to an algebraic closure.
Such classes already form a subgroup: tensor and dual preserve families and their
fibre identifications. Subgroup closure makes the construction independent of any
postponed proof of that fact. Multiplication denotes tensor product.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory Limits MonoidalCategory

namespace AlgebraicGeometry.Scheme.Pic

/-- The subgroup of geometrically algebraically trivial Picard classes.
Its generators are exactly the classes whose pulled-back representatives are
algebraically equivalent to the trivial module over the fixed algebraic closure.
Tensoring families and dualizing them show that the generating set is a subgroup.
Source: Milne AV I §8 and Remark 10.19; geometric convention of the lifting lemma.
(blueprint: def-sfb-geometric-picard-quotient) -/
def geometricAlgebraicZero {k : Type u} [Field k]
    (X : Over (Spec (.of k))) : Subgroup X.left.Pic :=
  Subgroup.closure {L | Modules.AreAlgebraicallyEquivalent
    (Over.mk (pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))))
    ((Modules.tensorPullback (pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))).obj
        ((fromSkeleton X.left.Modules).obj L.val))
    (𝟙_ (pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).Modules)}

/-- The geometric Picard quotient, with multiplication induced by tensor product.
Source: Milne AV I §8 and Remark 10.19; geometric convention of the lifting lemma.
(blueprint: def-sfb-geometric-picard-quotient) -/
abbrev GeometricQuotient {k : Type u} [Field k]
    (X : Over (Spec (.of k))) :=
  X.left.Pic ⧸ geometricAlgebraicZero X

/-- The class of an invertible module in the geometric Picard quotient.
Source: Milne AV I §8 and Remark 10.19; geometric convention of the lifting lemma.
(blueprint: def-sfb-geometric-picard-quotient) -/
def geometricClass {k : Type u} [Field k]
    (X : Over (Spec (.of k))) (L : X.left.Pic) : GeometricQuotient X :=
  QuotientGroup.mk L

end AlgebraicGeometry.Scheme.Pic
