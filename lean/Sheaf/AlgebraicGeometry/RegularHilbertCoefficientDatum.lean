/-!
# Étale regular coefficient data for Hilbert--Samuel presentations

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6,
and Remark 9.9; ILO VIII 2.3.11--2.3.13
(blueprint: def-trf-regular-hilbert-coefficient-datum).

The Taylor homomorphisms are characterized by their coordinate and residue values.
At a nonclosed point they use the residue-field-valued diagonal point, so they retain
all relative coordinates and give the extended Hilbert--Samuel function.
All structures below are data specifications, with no chosen existence witnesses.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.HilbertCoefficient

/-- Adjoin zero components in the coefficient variables to a transverse exponent.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def fullVertex (m : ℕ) {n : ℕ} (α : Fin n →₀ ℕ) :
    (Fin m ⊕ Fin n) →₀ ℕ :=
  Finsupp.mapDomain Sum.inr α

/-- The diagram generated by the degree-prefix vertices, as a union of orthants.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def inDiagram {σ : Type v} {s : ℕ} (α : Fin s → σ →₀ ℕ)
    (q : ℕ) (d : σ →₀ ℕ) : Prop :=
  ∃ i : Fin s, (α i).degree ≤ q ∧ α i ≤ d

/-- The quotient supports obtained by assigning an exponent to its first vertex.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def inDelta {σ : Type v} {s : ℕ} (α : Fin s → σ →₀ ℕ)
    (i : Fin s) (d : σ →₀ ℕ) : Prop :=
  ∀ j : Fin s, j < i → ¬ α j ≤ α i + d

/-- The variables occurring in the degree-prefix blocks.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def essential {n s : ℕ} (α : Fin s → Fin n →₀ ℕ) (q : ℕ) (j : Fin n) : Prop :=
  ∃ i : Fin s, (α i).degree ≤ q ∧ 0 < α i j

/-- Minimal vertices in ascending degree-lexicographic order, with exactly the essential variables.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def orderedVertices {n s : ℕ} (α : Fin s → Fin n →₀ ℕ) : Prop :=
  (∀ i j : Fin s, i < j → Finsupp.DegLex (· < ·) (· < ·) (α i) (α j)) ∧
  (∀ i j : Fin s, α i ≤ α j → i = j) ∧
  (∀ j : Fin n, ∃ i : Fin s, 0 < α i j)

/-- Support containment for formal series, including the zero series.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def supported {σ : Type v} {R : Type u} [CommRing R]
    (f : MvPowerSeries σ R) (S : (σ →₀ ℕ) → Prop) : Prop :=
  ∀ d : σ →₀ ℕ, MvPowerSeries.coeff d f ≠ 0 → S d

/-- The ideal generated by the essential variables in the indicated prefix.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def transverseIdeal {m n s : ℕ} {R : Type u} [CommRing R]
    (α : Fin s → Fin n →₀ ℕ) (q : ℕ) :
    Ideal (MvPowerSeries (Fin m ⊕ Fin n) R) :=
  Ideal.span {f | ∃ j : Fin n, essential α q j ∧ f = MvPowerSeries.X (Sum.inr j)}

/-- An iterated formal partial derivative with the unnormalized factorial convention.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def iteratedPartial {σ : Type v} {R : Type u} [CommRing R] [Fintype σ]
    (β : σ →₀ ℕ) (f : MvPowerSeries σ R) : MvPowerSeries σ R :=
  (Finset.univ.toList.flatMap fun j : σ => List.replicate (β j) j).foldl
    (fun g j => MvPowerSeries.pderiv R j g) f

/-- Unique supported homogeneous division in every degree, for every degree prefix.
A homogeneous series in finitely many variables is a polynomial.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def homogeneousDivision {m n s : ℕ} {R : Type u} [Field R]
    (α : Fin s → Fin n →₀ ℕ)
    (f : Fin s → MvPowerSeries (Fin m ⊕ Fin n) R) : Prop :=
  ∀ q t : ℕ, ∀ h : MvPowerSeries (Fin m ⊕ Fin n) R, h.IsHomogeneous t →
    ∃! qr : (Fin s → MvPowerSeries (Fin m ⊕ Fin n) R) ×
        MvPowerSeries (Fin m ⊕ Fin n) R,
      h = (∑ i : Fin s, qr.1 i * MvPowerSeries.homogeneousComponent (α i).degree (f i)) +
        qr.2 ∧
      qr.2.IsHomogeneous t ∧
      supported qr.2 (fun d => ¬ inDiagram (fun i => fullVertex m (α i)) q d) ∧
      ∀ i : Fin s,
        (if (α i).degree ≤ q ∧ (α i).degree ≤ t then
          (qr.1 i).IsHomogeneous (t - (α i).degree) ∧
            supported (qr.1 i) (inDelta (fun j => fullVertex m (α j)) i)
        else qr.1 i = 0)

/-- The five formal conditions of (7.2), with degree blocks represented by their degrees.
The last clause uses the prefix diagram restricted to its essential variables.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def formalConditions {m n s : ℕ} {R : Type u} [Field R]
    (α : Fin s → Fin n →₀ ℕ) (pick : Fin n → Fin s)
    (β : Fin n → Fin n →₀ ℕ) (Q : ℕ)
    (I : Ideal (MvPowerSeries (Fin m ⊕ Fin n) R))
    (f : Fin s → MvPowerSeries (Fin m ⊕ Fin n) R) : Prop := by
  classical
  exact
    (∀ i : Fin s, f i ∈ I ∧ (f i).order = ((α i).degree : ℕ∞)) ∧
    homogeneousDivision α f ∧
    (∀ h ∈ I, ∃ q : Fin s → MvPowerSeries (Fin m ⊕ Fin n) R,
      h = ∑ i : Fin s, q i * f i ∧
        ∀ i : Fin s, supported (q i) (inDelta (fun j => fullVertex m (α j)) i)) ∧
    (∀ q : ℕ, (∃ i : Fin s, (α i).degree = q) →
      (∀ j : Fin n, essential α q j →
        iteratedPartial (fullVertex m (β j)) (f (pick j)) ∈ transverseIdeal α q) ∧
      IsUnit (Matrix.det (fun j l : {j : Fin n // essential α q j} =>
        MvPowerSeries.constantCoeff
          (MvPowerSeries.pderiv R (Sum.inr l.1)
            (iteratedPartial (fullVertex m (β j.1)) (f (pick j.1))))))) ∧
    (∀ q : ℕ, (∃ i : Fin s, (α i).degree = q) →
      ∀ i : Fin s, q < (α i).degree → ∀ δ : Fin n →₀ ℕ,
        δ.degree ≤ Q → (∀ j : Fin n, δ j ≠ 0 → essential α q j) →
        inDiagram α q δ →
        iteratedPartial (fullVertex m δ) (f i) ∈ transverseIdeal α q)

/-- The Taylor homomorphism in specified étale coordinates,
characterized on residues and coordinates.

Source: Bierstone--Milman, Invent. Math. 128 (1997), Remark 3.7, Theorem 9.6, Remark 9.9
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def isTaylorMap {σ : Type} [Fintype σ] {k A K : Type u}
    [Field k] [CommRing A] [Field K] (c : MvPolynomial σ k →+* A)
    (ev : A →+* K) (T : A →+* MvPowerSeries σ K) : Prop :=
  (∀ r : A, MvPowerSeries.constantCoeff (T r) = ev r) ∧
  (∀ r : k, T (c (MvPolynomial.C r)) = MvPowerSeries.C (ev (c (MvPolynomial.C r)))) ∧
  (∀ j : σ, T (c (MvPolynomial.X j)) =
    MvPowerSeries.C (ev (c (MvPolynomial.X j))) + MvPowerSeries.X j)

/-- The extended Taylor ideal: extend the equations to the residue-field-valued formal chart.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def taylorIdeal {σ : Type} {A K : Type u} [CommRing A] [Field K]
    (I : Ideal A) (T : A →+* MvPowerSeries σ K) : Ideal (MvPowerSeries σ K) :=
  Ideal.map T I

/-- The cumulative Hilbert function of a Taylor ideal.
All relative coordinates are retained, giving the extended convention at nonclosed points.

Source: Bierstone--Milman, Invent. Math. 128 (1997), Corollary 3.20, (7.1), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
def extendedHilbert {σ : Type} {K : Type u} [Field K]
    (I : Ideal (MvPowerSeries σ K)) (q : ℕ) : ℕ∞ :=
  Module.length (MvPowerSeries σ K)
    (MvPowerSeries σ K ⧸ (I ⊔ (Ideal.span (Set.range MvPowerSeries.X)) ^ (q + 1)))

/-- A common étale chart, its smooth coefficient scheme and regular coefficients,
together with the five division and Jacobian conditions on the coefficient order locus.
The formal graph is straightened as in Remark 9.9, rather than replacing the
transverse variables by the defining equations of N.

Source: Bierstone--Milman, Invent. Math. 128 (1997), (7.1)--(7.2), Theorem 9.6
(blueprint: def-trf-regular-hilbert-coefficient-datum). -/
structure RegularHilbertCoefficientDatum {k : Type u} [Field k]
    {X M : Scheme.{u}} (p : M ⟶ Spec (CommRingCat.of k)) (i : X ⟶ M)
    (a : X) (m n s : ℕ) (α : Fin s → Fin n →₀ ℕ) (Q : ℕ) where
  /-- The one common affine étale neighbourhood. -/
  U : Scheme.{u}
  affineU : IsAffine U
  e : U ⟶ M
  etale_e : Etale e
  center : U
  center_eq : e center = i a
  /-- Original regular coordinates, before straightening the implicit graph of N. -/
  coord : MvPolynomial (Fin m ⊕ Fin n) k →+* Γ(U, ⊤)
  etale_coord : coord.Etale
  over_k : U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
    (coord.comp MvPolynomial.C)) = e ≫ p
  /-- The smooth closed coefficient scheme, with a lift of the center. -/
  N : Scheme.{u}
  affineN : IsAffine N
  j : N ⟶ U
  closed_j : IsClosedImmersion j
  smoothN : Smooth (j ≫ e ≫ p)
  b0 : N
  b0_eq : j b0 = center
  /-- N is given by regular equations, and w restricts to étale coordinates on N. -/
  equations : Fin n → Γ(U, ⊤)
  equations_ideal : RingHom.ker j.appTop.hom = Ideal.span (Set.range equations)
  etale_w : (j.appTop.hom.comp (coord.comp (MvPolynomial.rename Sum.inl).toRingHom)).Etale
  /-- Ordinary diagonal Taylor expansions on U and N. -/
  taylorU : ∀ y : U, Γ(U, ⊤) →+* MvPowerSeries (Fin m ⊕ Fin n) (U.residueField y)
  taylorU_spec : ∀ y : U, isTaylorMap coord (U.Γevaluation y).hom (taylorU y)
  taylorN : ∀ b : N, Γ(N, ⊤) →+* MvPowerSeries (Fin m) (N.residueField b)
  taylorN_spec : ∀ b : N,
    isTaylorMap (j.appTop.hom.comp (coord.comp (MvPolynomial.rename Sum.inl).toRingHom))
      (N.Γevaluation b).hom (taylorN b)
  /-- Straightened formal transverse variables z minus their implicit values on N. -/
  straight : ∀ b : N, Γ(U, ⊤) →+*
    MvPowerSeries (Fin m ⊕ Fin n) (N.residueField b)
  straight_residue : ∀ (b : N) (r : Γ(U, ⊤)),
    MvPowerSeries.constantCoeff (straight b r) = N.Γevaluation b (j.appTop r)
  straight_k : ∀ (b : N) (r : k),
    straight b (coord (MvPolynomial.C r)) =
      MvPowerSeries.C (N.Γevaluation b (j.appTop (coord (MvPolynomial.C r))))
  straight_w : ∀ (b : N) (l : Fin m),
    straight b (coord (MvPolynomial.X (Sum.inl l))) =
      MvPowerSeries.C
        (N.Γevaluation b (j.appTop (coord (MvPolynomial.X (Sum.inl l))))) +
      MvPowerSeries.X (Sum.inl l)
  straight_z : ∀ (b : N) (l : Fin n),
    straight b (coord (MvPolynomial.X (Sum.inr l))) =
      MvPowerSeries.rename Sum.inl
        (taylorN b (j.appTop (coord (MvPolynomial.X (Sum.inr l))))) +
      MvPowerSeries.X (Sum.inr l)
  equations_jacobian : ∀ b : N, IsUnit (Matrix.det (fun l r : Fin n =>
    MvPowerSeries.constantCoeff
      (MvPowerSeries.pderiv (N.residueField b) (Sum.inr r) (straight b (equations l)))))
  /-- Infinitely many regular coefficients, all on the same N. -/
  coeff : Fin s → (Fin n →₀ ℕ) → Γ(N, ⊤)
  /-- The actual formal generators at every coefficient point, with their coefficient identity. -/
  f : ∀ b : N, Fin s → MvPowerSeries (Fin m ⊕ Fin n) (N.residueField b)
  expansion : ∀ (b : N) (l : Fin s) (d : (Fin m ⊕ Fin n) →₀ ℕ),
    MvPowerSeries.coeff d (f b l) =
      MvPowerSeries.coeff
        (Finsupp.comapDomain.addMonoidHom Sum.inl_injective d)
        (taylorN b (coeff l (Finsupp.comapDomain.addMonoidHom Sum.inr_injective d)))
  /-- The first exponent of each generator at the distinguished point, for the
  total-degree lexicographic order on `(W, Z)` with the variables `W` before `Z`. -/
  first_coeff : ∀ l : Fin s, MvPowerSeries.coeff (fullVertex m (α l)) (f b0 l) ≠ 0
  first_minimal : ∀ (l : Fin s) (d : (Fin m ⊕ Fin n) →₀ ℕ),
    Finsupp.DegLex (fun x y : Fin m ⊕ Fin n => Sum.Lex (· < ·) (· < ·) x y) (· < ·)
      d (fullVertex m (α l)) →
      MvPowerSeries.coeff d (f b0 l) = 0
  /-- A compatible vertex derivative for every essential variable, chosen in its first block. -/
  pick : Fin n → Fin s
  beta : Fin n → Fin n →₀ ℕ
  pick_vertex : ∀ l : Fin n, α (pick l) = beta l + Finsupp.single l 1
  pick_prefix : ∀ (q : ℕ) (l : Fin n), essential α q l → (α (pick l)).degree ≤ q
  /-- The center belongs to the order locus; order is maximal-ideal-power containment. -/
  center_order : ∀ (l : Fin s) (γ : Fin n →₀ ℕ), γ.degree < (α l).degree →
    (N.presheaf.germ ⊤ b0 (by trivial)) (coeff l γ) ∈
      IsLocalRing.maximalIdeal (N.presheaf.stalk b0) ^ ((α l).degree - γ.degree)
  /-- All five conditions hold at every point of the coefficient order locus. -/
  conditions : ∀ b : N,
    (∀ (l : Fin s) (γ : Fin n →₀ ℕ), γ.degree < (α l).degree →
      (N.presheaf.germ ⊤ b (by trivial)) (coeff l γ) ∈
        IsLocalRing.maximalIdeal (N.presheaf.stalk b) ^ ((α l).degree - γ.degree)) →
    formalConditions α pick beta Q
      (taylorIdeal (RingHom.ker (pullback.snd i e).appTop.hom) (straight b)) (f b)
  /-- The extended Hilbert--Samuel function is bounded throughout the same neighbourhood. -/
  hilbert_bound : ∀ (y : U) (q : ℕ),
    extendedHilbert
      (taylorIdeal (RingHom.ker (pullback.snd i e).appTop.hom) (taylorU y)) q ≤
    extendedHilbert
      (taylorIdeal (RingHom.ker (pullback.snd i e).appTop.hom) (taylorU center)) q

end AlgebraicGeometry.HilbertCoefficient
