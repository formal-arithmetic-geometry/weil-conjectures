import Sheaf.AlgebraicGeometry.LogFanChartBlowup

/-!
# Ideals in the Zariski characteristic sheaf of a log structure

Source: ILO VIII 3.3.7, 3.3.12--3.3.13
(blueprint: def-trf-log-characteristic-ideal).

The ambient sharp sheaf need not be a fan. All constructions use its actual sections,
ordinary Zariski germs, and the geometric germs of the recorded log structure.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
namespace AlgebraicGeometry

/-- Families of subsets of the Zariski characteristic sheaf. Source: ILO VIII 3.3.12--3.3.13
(blueprint: def-trf-log-characteristic-ideal). -/
def EtaleLogStructure.SharpIdealFamily {X : Scheme.{u}} (M : EtaleLogStructure X) :=
  ∀ U : X.Opens, Set (M.sharpSpace.presheaf.obj (op U))

/-- Stalk membership means having a representative in a local ideal section.
Source: ILO VIII 3.3.12--3.3.13 (blueprint: def-trf-log-characteristic-ideal). -/
def EtaleLogStructure.sharpIdealStalk {X : Scheme.{u}} (M : EtaleLogStructure X)
    (K : M.SharpIdealFamily) (x : X) : Set (FineFan.stalk M.sharpSpace.presheaf x) :=
  {a | ∃ (U : X.Opens) (hx : x ∈ U) (s : M.sharpSpace.presheaf.obj (op U)),
    s ∈ K U ∧ FineFan.germ M.sharpSpace.presheaf U x hx s = a}

/-- Absorption, restriction and stalk-local membership specify a subsheaf of ideals.
Source: ILO VIII 3.3.7, 3.3.12--3.3.13
(blueprint: def-trf-log-characteristic-ideal). -/
def EtaleLogStructure.IsSharpIdeal {X : Scheme.{u}} (M : EtaleLogStructure X)
    (K : M.SharpIdealFamily) : Prop :=
  (∀ (U : X.Opens) (a b : M.sharpSpace.presheaf.obj (op U)),
    a ∈ K U → a * b ∈ K U) ∧
  (∀ (U V : X.Opens) (h : V ≤ U) (s : M.sharpSpace.presheaf.obj (op U)),
    s ∈ K U → M.sharpSpace.presheaf.map (homOfLE h).op s ∈ K V) ∧
  ∀ (U : X.Opens) (s : M.sharpSpace.presheaf.obj (op U)),
    (∀ (x : X) (hx : x ∈ U),
      FineFan.germ M.sharpSpace.presheaf U x hx s ∈ M.sharpIdealStalk K x) → s ∈ K U

/-- Locally finitely many, at least one, characteristic sections generate the ideal.
The number of generators is positive only on a neighbourhood of an actual point.
Source: ILO VIII 3.3.7, 3.3.12--3.3.13
(blueprint: def-trf-log-characteristic-ideal). -/
def EtaleLogStructure.IsNonemptyCoherentSharpIdeal {X : Scheme.{u}}
    (M : EtaleLogStructure X) (K : M.SharpIdealFamily) : Prop :=
  M.IsSharpIdeal K ∧ ∀ x : X,
    ∃ (U : X.Opens) (_hx : x ∈ U) (n : ℕ) (_hn : 0 < n)
      (s : Fin n → M.sharpSpace.presheaf.obj (op U)),
      (∀ i, s i ∈ K U) ∧
      ∀ (y : X) (hy : y ∈ U) (a : FineFan.stalk M.sharpSpace.presheaf y),
        a ∈ M.sharpIdealStalk K y ↔
          ∃ (i : Fin n) (q : FineFan.stalk M.sharpSpace.presheaf y),
            a = FineFan.germ M.sharpSpace.presheaf U y hy (s i) * q

/-- The ideal generated by the inverse image under a specified characteristic-sheaf map.
Source: ILO VIII 3.3.10, 3.3.13(i)
(blueprint: def-trf-log-characteristic-ideal). -/
def EtaleLogStructure.pullbackSharpIdeal {Y X : Scheme.{u}}
    {L : EtaleLogStructure Y} {M : EtaleLogStructure X}
    (c : L.sharpSpace ⟶ M.sharpSpace) (K : M.SharpIdealFamily) : L.SharpIdealFamily :=
  fun U ↦ {s | ∀ (y : Y) (hy : y ∈ U),
    ∃ (a : FineFan.stalk M.sharpSpace.presheaf (c.hom.base y))
      (_ha : a ∈ M.sharpIdealStalk K (c.hom.base y))
      (q : FineFan.stalk L.sharpSpace.presheaf y),
      FineFan.germ L.sharpSpace.presheaf U y hy s = FineFan.stalkMap c y a * q}

/-- The inverse-image log ideal of a characteristic ideal. A geometric log germ belongs
exactly when its class can be represented on a Zariski neighbourhood by a log section
whose sharp germ lies in the characteristic ideal. Equality of `Associates` classes
allows precisely multiplication by a log unit. This definition is used on Zariski log
structures; it does not assume that every log structure is Zariski.
Source: ILO VIII 3.3.12--3.3.13(i)
(blueprint: def-trf-log-characteristic-ideal). -/
def EtaleLogStructure.inverseSharpIdeal {X : Scheme.{u}} (M : EtaleLogStructure X)
    (K : M.SharpIdealFamily) : M.IdealFamily :=
  fun W ↦ {s | ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ X) (w : (Scheme.pointSmallEtale t).fiber.obj W),
    ∃ (U : X.Opens) (v : (Scheme.pointSmallEtale t).fiber.obj ((logOpenEtale X).obj U))
      (hx : t default ∈ U)
      (m : M.monoidSheaf.obj.obj (op ((logOpenEtale X).obj U))),
      Associates.mk (M.toEtalePrelogStructure.germ t W w s) =
        Associates.mk (M.toEtalePrelogStructure.germ t ((logOpenEtale X).obj U) v m) ∧
      FineFan.germ M.sharpSpace.presheaf U (t default) hx (M.sharpSection U m) ∈
        M.sharpIdealStalk K (t default)}

end AlgebraicGeometry
