/-!
# The stalk map above a rational closed point under field extension

Source: blueprint thm-sc-constant-invariance, affine-case unit quotient paragraph;
Stacks Algebra, Tag 00E6, and Lemma 00PD.
(blueprint: lem-sc-rational-point-base-change-stalk).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace AlgebraicGeometry

/-- At the point over a rational closed point, the scalar-extension stalk map preserves
uniformizers. Source: blueprint thm-sc-constant-invariance, affine-case unit quotient
paragraph; Stacks Algebra Tag 00E6 and Lemma 00PD
(blueprint: lem-sc-rational-point-base-change-stalk).

Proof: choose an affine neighbourhood Spec A of P with maximal ideal m. The residue field
A/m is k by the Nullstellensatz. The fibre-prime correspondence identifies the points above
P with Spec ((A/m) tensor_k k') = Spec k', so the given P' is the point defined by
m(A tensor_k k'). Its stalk is the localization of A tensor_k k' at that ideal, equivalently
the localization of O_{X,P} tensor_k k' at the extended maximal ideal. Smoothness,
connectedness and dimension one give an integral regular curve, so the source closed stalk
is a DVR. The same holds for the target by baseChange_curve; P' is closed since its residue
field is k'. For an irreducible t in the source DVR, its maximal ideal is generated by t.
The tensor-localization calculation in dvr_field_extension_order shows the target maximal
ideal is generated by the image of t. In a DVR such a generator is irreducible. Transport
this assertion across the canonical stalk-localization identifications. -/
theorem Scheme.rational_point_base_change_stalk
    (k k' : Type u) [Field k] [IsAlgClosed k] [Field k'] [IsAlgClosed k']
    [Algebra k k'] (X : Scheme.{u}) (s : X ⟶ Spec (.of k))
    [IsConnectedCurve s] [Smooth s] [IsProper s] (P : X)
    (hP : P ∈ closedPoints X)
    (P' : (pullback s (Spec.map (CommRingCat.ofHom (algebraMap k k'))) : Scheme.{u}))
    (hP' : pullback.fst s (Spec.map (CommRingCat.ofHom (algebraMap k k'))) P' = P) :
    ∀ t : X.presheaf.stalk
          (pullback.fst s (Spec.map (CommRingCat.ofHom (algebraMap k k'))) P'),
        Irreducible t → Irreducible
          ((pullback.fst s (Spec.map (CommRingCat.ofHom (algebraMap k k')))).stalkMap P' t) := by
  sorry

end AlgebraicGeometry
