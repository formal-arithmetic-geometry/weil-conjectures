/-!
# Compactly supported sections on an étale scheme

Source: Stacks Project, Étale Cohomology, Tag 09Z9 and more-etale.tex Tag 0F4Y
(blueprint: def-sfb-compactly-supported-sections).
-/

@[expose] public section

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- The module generated by sections with proper geometric support. The support condition is
`Etale.SectionHasProperSupport`, using `Scheme.IsClosedSubsetProperOver` for properness
of the reduced induced nonzero-germ support over the chosen base morphism.
Source: Stacks Project, Étale Cohomology,
Tag 09Z9 and more-etale.tex Tag 0F4Y
(blueprint: def-sfb-compactly-supported-sections). -/
def compactlySupportedSections
    (A : Type (u + 1)) [CommRing A] {X S : Scheme.{u}} (f : X ⟶ S)
    [LocallyOfFiniteType f]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} A)) : ModuleCat.{u + 1} A :=
  ModuleCat.of A
    (Submodule.span A {s : ((Etale.sectionsFunctor (ModuleCat.{u + 1} A) X).obj F) |
      Etale.SectionHasProperSupport A F (Scheme.Etale.mk (𝟙 X)) f s})

/-- The inclusion of compactly supported sections into all sections. Source: Stacks Project,
Étale Cohomology, Tag 09Z9 (blueprint: def-sfb-compactly-supported-sections). -/
noncomputable def compactlySupportedSections.ι
    (A : Type (u + 1)) [CommRing A] {X S : Scheme.{u}} (f : X ⟶ S)
    [LocallyOfFiniteType f]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} A)) :
    compactlySupportedSections A f F ⟶ ModuleCat.of A
      ((Etale.sectionsFunctor (ModuleCat.{u + 1} A) X).obj F) :=
  ModuleCat.ofHom (Submodule.subtype _)

/-- Pullback of a section over an étale object `p` along a map `a` over `V`. This applies
 the unit for `r` at `Etale.mk p` and then restricts along `(a, id_C)` to the terminal
 étale object of `C`. Source: Stacks Project, Tag 03Q1, section pullback, and Tag 0F4Y,
 graph-extension restriction (blueprint: def-sfb-compactly-supported-sections). -/
noncomputable def etaleSectionPullbackToGlobal
    (A : Type (u + 1)) [CommRing A] {V P C : Scheme.{u}}
    (r : C ⟶ V) (p : P ⟶ V) [Etale p] (a : C ⟶ P) (ha : a ≫ p = r)
    (F : Sheaf V.smallEtaleTopology (ModuleCat.{u + 1} A)) :
    F.obj.obj (op (Scheme.Etale.mk p)) ⟶
      (Etale.sectionsFunctor (ModuleCat.{u + 1} A) C).obj
        ((Etale.upperStar (ModuleCat.{u + 1} A) r).obj F) :=
  ((Etale.upperStarLowerStarAdjunction (ModuleCat.{u + 1} A) r).unit.app F).hom.app
      (op (Scheme.Etale.mk p)) ≫
    ((Etale.upperStar (ModuleCat.{u + 1} A) r).obj F).obj.map
      (MorphismProperty.Over.homMk
        (A := Scheme.Etale.mk (𝟙 C))
        (B := (MorphismProperty.Over.pullback @Etale ⊤ r).obj (Scheme.Etale.mk p))
        (Limits.pullback.lift a (𝟙 C) (by
          change a ≫ p = (𝟙 C) ≫ r
          simpa using ha))
        (by exact Limits.pullback.lift_snd _ _ _)).op

/-- A canonical map from a module to a finite coproduct, specified by its component maps.
The map is zero in the infinite-index branch so it is total without a finiteness hypothesis;
all uses in the geometric-fibre statement are under `Finite I`. Source: the finite direct-sum
construction in Stacks Project, Étale Cohomology, Tag 09Z9 (blueprint:
lem-sfb-etale-geometric-fibre-compact-sections). -/
noncomputable def canonicalFiniteCoproductMap
    (R : Type u) [Ring R] {I : Type v}
    (X : ModuleCat.{max u v} R) (Y : I → ModuleCat.{max u v} R)
    (f : ∀ i, X ⟶ Y i) : X ⟶ ∐ Y := by
  classical
  by_cases hI : Finite I
  · letI : Finite I := hI
    letI : Fintype I := Fintype.ofFinite I
    exact ModuleCat.ofHom
      ((ModuleCat.coprodIsoDirectSum Y).inv.hom.comp
        ((∑ i : I, (DirectSum.lof R I (fun i ↦ Y i) i).comp (f i).hom)))
  · exact 0

/-- The component germ map from sections on a geometric fibre to the corresponding geometric
stalk. Source: Stacks Project, Étale Cohomology, Tags 03Q1 and 0F4Y (blueprint:
lem-sfb-etale-geometric-fibre-compact-sections). -/
noncomputable def geometricFibreComponentMap
    (A : Type (u + 1)) [CommRing A]
    {V C : Scheme.{u}} (r : C ⟶ V) {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (x : Spec (.of Ω) ⟶ C)
    (F : Sheaf V.smallEtaleTopology (ModuleCat.{u + 1} A)) :
    ModuleCat.of A
        ((Etale.sectionsFunctor (ModuleCat.{u + 1} A) C).obj
          ((Etale.upperStar (ModuleCat.{u + 1} A) r).obj F)) ⟶
      (Scheme.pointSmallEtale (x ≫ r)).sheafFiber.obj F :=
  (Scheme.pointSmallEtale x).toPresheafFiber
      (Scheme.Etale.mk (𝟙 C)) (CategoryTheory.Over.homMk x)
      ((Etale.upperStar (ModuleCat.{u + 1} A) r).obj F).obj ≫
    (Etale.upperStarCompSheafFiberIso (ModuleCat.{u + 1} A) r x).hom.app F

/-- The canonical restriction-and-germ map on a geometric fibre. Source: Stacks Project,
Étale Cohomology, Tags 03Q1 and 0F4Y (blueprint: lem-sfb-etale-geometric-fibre-compact-sections). -/
noncomputable def etaleGeometricFibreRestrictionMap
    (A : Type (u + 1)) [CommRing A]
    {V T : Scheme.{u}} (h : V ⟶ T)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ T)
    (F : Sheaf V.smallEtaleTopology (ModuleCat.{u + 1} A)) :
    ModuleCat.of A
        ((Etale.sectionsFunctor (ModuleCat.{u + 1} A) (Limits.pullback h t)).obj
          ((Etale.upperStar (ModuleCat.{u + 1} A) (Limits.pullback.fst h t)).obj F)) ⟶
      ∐ fun v : Scheme.Hom.GeometricFiber h t =>
        (Scheme.pointSmallEtale v.1).sheafFiber.obj F :=
  canonicalFiniteCoproductMap A _ _ (fun v ↦
    geometricFibreComponentMap A (Limits.pullback.fst h t)
      (Limits.pullback.lift v.1 (𝟙 (Spec (.of Ω))) (by simpa using v.2)) F ≫
      eqToHom (by simp))

end AlgebraicGeometry
