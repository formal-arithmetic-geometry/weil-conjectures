module

public import Sheaf.AlgebraicGeometry.ToriMultiplicativeType
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.RingTheory.RingHom.FaithfullyFlat
public import WeilConjectures.AlgebraicGeometry.GroupScheme.Defs
import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
import Mathlib.AlgebraicGeometry.Group.Affine
import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.LinearAlgebra.FreeModule.PID
import Sheaf.AlgebraicGeometry.AffineFiniteTypeAlgebra

/-! # The faithfully flat image of a torus is a torus

Source: Milne, Algebraic Groups (2017), Theorem 12.9(b),(c), pp.233--234;
Definition 12.14 and the following paragraph, p.236; Theorem 5.39 and Remark 5.42, p.108
(blueprint: lem-sfb-torus-homomorphism-image).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- A closed faithfully flat image factor of a homomorphism from a split torus is a
split torus. No smoothness or connectedness hypothesis on the ambient group, or
smoothness or finiteness hypothesis on the kernel, is required.

Source: Milne, Algebraic Groups (2017), Theorem 12.9(b),(c), pp.233--234;
Definition 12.14 and the following paragraph, p.236; Theorem 5.39 and Remark 5.42, p.108
(blueprint: lem-sfb-torus-homomorphism-image).

Proof plan:
1. Choose T ≅ G_m^r and identify its coordinate Hopf algebra with F[Z^r],
   with group-like basis e_m, using lem-sfb-diagonalizable-group-geometric-criteria.
2. Faithful flatness makes u* injective by
   lem-weil-pbc-faithfully-flat-ideal-contraction at the zero ideal. The coordinate
   Hopf structure from lem-sfb-affine-group-coordinate-hopf identifies F[I] with a
   Hopf subalgebra A of F[Z^r]: u* preserves multiplication, comultiplication,
   counit and antipode because u is a group homomorphism.
3. For a = sum a_n e_n in A, apply coefficient extraction in the second tensor
   factor to its comultiplication, using def-weil-pbc-module-tensor-product.
   This gives a_m e_m in A, so a_m ≠ 0 implies e_m in A by division in F.
4. The exponents L = {m | e_m ∈ A} form a subgroup of Z^r by the unit,
   multiplication and antipode formulas. Step 3 gives A = direct sum over L of F e_m,
   hence the basis map F[L] → A is a Hopf algebra isomorphism.
5. By lem-pc-affine-finite-type-algebra, A has finitely many algebra generators.
   Their finite supports generate L: every polynomial in them is supported in the
   subgroup generated by those supports, and every e_m in A is such a polynomial.
   This includes the case of no generators, where A = F and L = 0.
6. L is torsion-free inside Z^r. Apply lem-trf-fg-torsionfree-group-free to obtain
   a finite integral basis of L, of some rank d, allowing d = 0.
7. That basis gives inverse Hopf algebra maps F[Z^d] and F[L]. Composing with
   F[I] ≅ A ≅ F[L] and applying lem-sfb-hopf-spectrum-functor produces inverse
   group-scheme maps. Finally lem-sfb-diagonalizable-group-geometric-criteria
   identifies I with G_m^d. No property of H or ker h beyond the factorization is used. -/
theorem torus_homomorphism_image {F : Type u} [Field F] [IsAlgClosed F]
    (T H I : Grp (Over (Spec (.of F))))
    [IsAffine T.X.left] [LocallyOfFiniteType T.X.hom] [QuasiCompact T.X.hom]
    [IsAffine H.X.left] [LocallyOfFiniteType H.X.hom] [QuasiCompact H.X.hom]
    [IsAffine I.X.left] [LocallyOfFiniteType I.X.hom] [QuasiCompact I.X.hom]
    (hT : ∃ r : ℕ, Nonempty (T ≅ MultiplicativeType.splitTorus F r))
    (h : T ⟶ H) (j : I ⟶ H) (u : T ⟶ I)
    (hj : IsClosedSubgroupScheme j.hom.hom) (hfactor : u ≫ j = h)
    (hu : u.hom.hom.left.appTop.hom.FaithfullyFlat) :
    ∃ d : ℕ, Nonempty (I ≅ MultiplicativeType.splitTorus F d) := by
  sorry

end AlgebraicGeometry
