module

public import Sheaf.AlgebraicGeometry.AffineGroupCentreBaseChange
public import Sheaf.AlgebraicGeometry.LinearGroupSchemes
public import WeilConjectures.AlgebraicGeometry.GroupScheme.GeneralLinear.Lie
public import WeilConjectures.AlgebraicGeometry.SchemeTangentSpace
import Sheaf.RingTheory.BialgebraDistributionTangentCalculus
import Sheaf.AlgebraicGeometry.AffineFiniteTypeAlgebra
import WeilConjectures.AlgebraicGeometry.GroupScheme.Cartier
import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
import Mathlib.AlgebraicGeometry.Pullbacks
import WeilConjectures.Mathlib.AlgebraicGeometry.Geometrically.Connected
import WeilConjectures.Mathlib.AlgebraicGeometry.Geometrically.Reduced
import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-! # The adjoint differential and its scheme-theoretic kernel in characteristic zero

Source: Milne, Algebraic Groups (2017), Theorem 10.23, Remark 10.24, Proposition 10.15,
and Proposition 1.92 (blueprint: lem-sfb-charzero-adjoint-differential-central-kernel).

A finite basis expresses GL(Lie G) as GL_n. The representation is specified by its
conjugation action on dual-number tangent points over every commutative test algebra.
Equality of kernel and centre is equality of their subfunctors, retaining nilpotents.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory
open scoped MonObj

namespace AlgebraicGeometry

/-- The tangent point with coordinates v in the scalar extension of the basis b.
It is the product of the scaled basis tangent points: multiplication of tangent points
is tangent addition. List.prod fixes an order without imposing commutativity on G(A[ε]).
For an empty basis the product is the identity.
Source: Milne, 10.18--10.20, pp.191--192
(blueprint: lem-sfb-charzero-adjoint-differential-central-kernel). -/
noncomputable def adjointBasisTangentPoint {k : Type u} [Field k]
    (G : Over (Spec (.of k))) [GrpObj G] {n : ℕ}
    (b : Module.Basis (ULift.{u} (Fin n)) k (GrpObj.Lie G))
    (A : Type u) [CommRing A] [Algebra k A] (v : ULift.{u} (Fin n) → A) :
    points G (DualNumber A) :=
  (List.ofFn fun j : Fin n ↦
    points.map G ((DualNumber.scale (v (ULift.up j))).restrictScalars k)
      (points.map G (DualNumber.mapAlgebraMap A)
        (GrpObj.tangentPoint (b (ULift.up j))))).prod

/-- Differentiated conjugation is the adjoint Lie action, and its scheme kernel is the
centre. The basis witnesses finite dimensionality; the conjugation equation specifies
Ad on all algebras. The kernel equality is tested on all algebras, not only fields.

Source: Milne, Theorem 10.23 and Remark 10.24, pp.193--194; Proposition 10.15,
pp.190--191; Cartier Theorem 3.23, p.71; Proposition 1.92, pp.33--34
(blueprint: lem-sfb-charzero-adjoint-differential-central-kernel).

Proof plan:
1. Use lem-sfb-affine-group-coordinate-hopf and lem-pc-affine-finite-type-algebra:
   finitely many algebra generators span I/I². The dual is Lie(G), by
   lem-sfb-bialgebra-distribution-tangent-calculus and
   lem-sfb-affine-group-lie-tangent-calculus. Dual-number points are counit derivations;
   their product is addition and their mixed commutator is the convolution bracket.
2. Conjugation acts on these derivations by a * X * a⁻¹. Evaluate at the universal
   point in a finite basis: both this matrix and its inverse have regular entries.
   lem-weil-pbc-morphism-into-affine-scheme gives the representation r. At ε+tX,
   conjugation sends Y to Y+t[X,Y], so its differential is ad(X).
3. By lem-sc-kernel-subgroup, ker r is closed; its ideal is generated by entries of
   r-1 and hence is of finite type. A universally central point fixes every tangent
   point, so the centre of lem-sfb-affine-group-centre-base-change lies in ker r.
4. Over every extension field K, G_K is connected by
   lem-sbc-connected-rational-point-geometrically-connected, and smooth by
   lem-sfb-char-zero-affine-group-smooth. If n lies in the kernel, its centralizer
   has full tangent space. Apply lem-sfb-charzero-lie-detects-factorization to the
   identity of G_K and this closed subgroup: the centralizer is G_K.
5. N times G is a finite-type group scheme, hence smooth by Cartier and reduced by
   sbc-lem-smooth-geometrically-reduced. The commutator map is the identity on every
   residue-field point, by step 4. Apply
   lem-weil-pbc-reduced-source-factors-through-closed-subscheme to the identity
   section. It is therefore the identity as a morphism, on all test algebras and
   their extensions. This gives N contained in Z and the claimed equality.
   Empty matrices have determinant one; no positive dimension or reduced A is used. -/
theorem exists_charZero_adjoint_differential_central_kernel
    {k : Type u} [Field k] [CharZero k]
    (G : Grp (Over (Spec (.of k)))) (hG : SolvableGroupStructure.IsAlgebraic G)
    (hsm : Smooth G.X.hom) (hc : ConnectedSpace G.X.left) :
    ∃ (n : ℕ) (b : Module.Basis (ULift.{u} (Fin n)) k (GrpObj.Lie G.X))
      (r : G ⟶ Grp.mk (GeneralLinearGroup (ULift.{u} (Fin n)) k)),
      (∀ (A : Type u) [CommRing A] [Algebra k A]
        (g : points G.X A) (v : ULift.{u} (Fin n) → A),
        adjointBasisTangentPoint G.X b A
            ((GeneralLinearGroup.RationalHom.points r.hom.hom A g).val.mulVec v) =
          points.map G.X (TrivSqZeroExt.inlAlgHom k A A) g *
            adjointBasisTangentPoint G.X b A v *
              (points.map G.X (TrivSqZeroExt.inlAlgHom k A A) g)⁻¹) ∧
      (∀ X Y : GrpObj.Lie G.X,
        (GeneralLinearGroup.RationalHom.differential r.hom.hom X).mulVec
          (b.equivFun Y) = b.equivFun ⁅X, Y⁆) ∧
      (∀ (A : Type u) [CommRing A] [Algebra k A],
        Set.range (fun x : StandardGroupSchemes.affine k A ⟶ GrpObj.ker r.hom.hom ↦
          x ≫ GrpObj.kerι r.hom.hom) =
            ReductiveTorusCentralizer.centralizerPoints (𝟙 G) A) ∧
      ∀ (A : Type u) [CommRing A] [Algebra k A]
        (x : StandardGroupSchemes.affine k A ⟶ GrpObj.ker r.hom.hom)
        (g : StandardGroupSchemes.affine k A ⟶ G.X),
        Commute (x ≫ GrpObj.kerι r.hom.hom) g := by
  sorry

end AlgebraicGeometry
