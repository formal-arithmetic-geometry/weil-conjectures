import Sheaf.RingTheory.PresentationFittingIdeal

/-!
# Formal Hilbert--Samuel strata and Taylor minors

Source: ILO VIII 2.3.11--2.3.13; Bierstone--Milman, Invent. Math. 128 (1997),
Definitions 7.9, 7.12--7.13, Theorem 7.14, Remarks 9.1 and 9.5
(blueprint: lem-trf-formal-hilbert-stratum-minors).

The finite Taylor matrices are imported from `FormalTaylorJetMatrices`
(blueprint: def-trf-formal-taylor-jet-matrices). They use all monomial
multiples of the generators.
Their rank is always specialized at the distinguished point before taking minors.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u v

open CategoryTheory

namespace AlgebraicGeometry.HilbertCoefficient

open Classical in
/-- The cumulative ideal of rank minors from degree zero through degree `q`.

Source: Bierstone--Milman, Invent. Math. 128 (1997), Definitions 7.9, 7.12--7.13,
Theorem 7.14 and Remarks 9.1, 9.5 (blueprint: lem-trf-formal-hilbert-stratum-minors). -/
def formalStratumIdeal {σ : Type v} [Fintype σ] {L : Type u} [Field L]
    {s : ℕ} (f : Fin s → MvPowerSeries σ L) (q : ℕ) : Ideal (MvPowerSeries σ L) :=
  ⨆ t ∈ Finset.range (q + 1), formalJetMinorIdeal f t

open Classical in
/-- The ideal generated by every derivative of a generator below its assigned order.

Source: Bierstone--Milman, Invent. Math. 128 (1997), Definitions 7.9, 7.12--7.13,
Theorem 7.14 and Remarks 9.1, 9.5 (blueprint: lem-trf-formal-hilbert-stratum-minors). -/
def lowDerivativeIdeal {m n s : ℕ} {L : Type u} [Field L]
    (α : Fin s → Fin n →₀ ℕ) (f : Fin s → MvPowerSeries (Fin m ⊕ Fin n) L) :
    Ideal (MvPowerSeries (Fin m ⊕ Fin n) L) :=
  Ideal.span {h | ∃ (i : Fin s) (δ : (Fin m ⊕ Fin n) →₀ ℕ),
    δ.degree < (α i).degree ∧ h = iteratedPartial δ (f i)}

open Classical in
/-- The formal derivative ideal is the cumulative determinantal ideal.

Proof plan (DAG steps 1--10):
1. Taylor substitution is multiplicative, coefficientwise by the binomial formula;
   its coefficient at ν is the ν-th derivative divided by ν!.
2. The translated columns present the Taylor quotient. When its fibre dimension H is
   positive, its rank-minor ideal is Fitt_(H-1); use
   `lem-trf-fitting-ideal-independence-base-change`. For H=0 the minors are oversized.
3. The supports Δ_i are downward closed. Supported division therefore replaces the
   columns by the supported translates without changing their span. The identity
   Y_j h(X+Y)=(X_j h)(X+Y)-X_j h(X+Y) proves stability under all Y-multiples.
4. Homogeneous division gives a triangular basis at the origin and a square pivot
   C_t on diagram rows with unit determinant, of size r_t.
5. Every minor of size r_t+1 uses a column of low derivatives, proving J_t ⊆ E.
6. Adjoin an outside-diagram row and a generator column to C_t. Cofactor expansion
   expresses its derivative modulo J_t in terms of derivatives indexed by the diagram.
7. Write g=UZ for each accumulated block. Its constant Jacobian is invertible,
   so U is invertible by the formal geometric-series inverse and adjugate; (g)=(Z).
8. Induct on degree blocks. Earlier diagram derivatives of later generators lie in
   the earlier variable ideal by the restricted-derivative hypothesis; complementary
   differentiations preserve that ideal. Only orders at most max d_i-1 are used.
9. The cofactor relation treats the remaining derivatives. The selected g's put the
   current variable ideal in the cumulative minors, completing the block induction.
   Together with step 5 and monotonicity this proves equality for every permitted q.
10. For an empty list K=0. For a degree-zero vertex K is the unit ideal; the Taylor
    matrix is surjective and all relevant minors are oversized. Both sides are zero.


Source: Bierstone--Milman, Invent. Math. 128 (1997), Definitions 7.9, 7.12--7.13,
Theorem 7.14 and Remarks 9.1, 9.5 (blueprint: lem-trf-formal-hilbert-stratum-minors). -/
theorem formalStratumIdeal_eq_lowDerivativeIdeal
    {L : Type u} [Field L] [CharZero L] {m n s : ℕ}
    (α : Fin s → Fin n →₀ ℕ) (K : Ideal (MvPowerSeries (Fin m ⊕ Fin n) L))
    (f : Fin s → MvPowerSeries (Fin m ⊕ Fin n) L) (Q : ℕ)
    (hdegree : ∀ i j : Fin s, i < j → (α i).degree ≤ (α j).degree)
    (hminimal : ∀ i j : Fin s, α i ≤ α j → i = j)
    (hessential : ∀ j : Fin n, ∃ i : Fin s, 0 < α i j)
    (horder : ∀ i : Fin s, f i ∈ K ∧ (f i).order = ((α i).degree : ℕ∞))
    (hdivision : homogeneousDivision α f)
    (hgeneration : ∀ h ∈ K, ∃ a : Fin s → MvPowerSeries (Fin m ⊕ Fin n) L,
      h = ∑ i : Fin s, a i * f i ∧
        ∀ i : Fin s, supported (a i) (inDelta (fun j ↦ fullVertex m (α j)) i))
    (hblocks : ∀ b : ℕ, (∃ i : Fin s, (α i).degree = b) →
      ∃ (pick : {j : Fin n // essential α b j} → Fin s)
        (β : {j : Fin n // essential α b j} → Fin n →₀ ℕ),
        (∀ j, α (pick j) = β j + Finsupp.single j.val 1 ∧
          (α (pick j)).degree ≤ b ∧
          iteratedPartial (fullVertex m (β j)) (f (pick j)) ∈ transverseIdeal α b) ∧
        IsUnit (Matrix.det (fun j l : {j : Fin n // essential α b j} ↦
          MvPowerSeries.constantCoeff (MvPowerSeries.pderiv L (Sum.inr l.val)
            (iteratedPartial (fullVertex m (β j)) (f (pick j)))))))
    (hlater : ∀ b : ℕ, (∃ i : Fin s, (α i).degree = b) →
      ∀ i : Fin s, b < (α i).degree → ∀ δ : Fin n →₀ ℕ,
        δ.degree ≤ Q → (∀ j : Fin n, δ j ≠ 0 → essential α b j) →
        inDiagram α b δ →
        iteratedPartial (fullVertex m δ) (f i) ∈ transverseIdeal α b)
    (hQ : ∀ i : Fin s, ((α i).degree : ℤ) - 1 ≤ (Q : ℤ))
    (q : ℕ) (hq : ∀ i : Fin s, ((α i).degree : ℤ) - 1 ≤ (q : ℤ)) :
    formalStratumIdeal f q = lowDerivativeIdeal α f := by
  sorry

open Classical in
/-- The individual minors ideals do not depend on the finite generators of `K`.

Proof: DAG steps 1--2. Taylor substitution is a ring homomorphism, so either
family generates the same truncated Taylor submodule. Its fibre dimension and rank
are intrinsic. Identify the minors with Fitt_(H-1) and apply
`lem-trf-fitting-ideal-independence-base-change`; when H=0 both ideals are zero.


Source: Bierstone--Milman, Invent. Math. 128 (1997), Definitions 7.9, 7.12--7.13,
Theorem 7.14 and Remarks 9.1, 9.5 (blueprint: lem-trf-formal-hilbert-stratum-minors). -/
theorem formalJetMinorIdeal_generator_independent
    {σ : Type v} [Fintype σ] {L : Type u} [Field L] [CharZero L]
    {s s' : ℕ} (f : Fin s → MvPowerSeries σ L)
    (g : Fin s' → MvPowerSeries σ L)
    (hgen : Ideal.span (Set.range f) = Ideal.span (Set.range g)) (t : ℕ) :
    formalJetMinorIdeal f t = formalJetMinorIdeal g t := by
  sorry

open Classical in
/-- Formation of the regular rank-minor ideal commutes with Taylor expansion at the center.

Proof: DAG step 11. Coordinate differentiation commutes with the canonical
Taylor maps by `lem-trf-implicit-taylor-coordinate-calculus`. Thus the regular
Taylor matrix maps entrywise to the formal one, and its rank at the center is
unchanged. Determinants commute with the Taylor homomorphism; equivalently apply
`lem-trf-fitting-ideal-independence-base-change`. Oversized minors cover H=0.


Source: Bierstone--Milman, Invent. Math. 128 (1997), Definitions 7.9, 7.12--7.13,
Theorem 7.14 and Remarks 9.1, 9.5 (blueprint: lem-trf-formal-hilbert-stratum-minors). -/
theorem regularJetMinorIdeal_map_taylor
    {k : Type u} [Field k] [CharZero k] (U : Scheme.{u}) [IsAffine U]
    (p : U ⟶ Spec (CommRingCat.of k)) [Smooth p] [LocallyOfFiniteType p] [QuasiCompact p]
    {d s : ℕ} (c : MvPolynomial (Fin d) k →+* Γ(U, ⊤)) (hc : c.Etale)
    (hover : U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (c.comp MvPolynomial.C)) = p)
    (D : Fin d → Derivation ℤ Γ(U, ⊤) Γ(U, ⊤))
    (hDk : ∀ (j : Fin d) (r : k), D j (c (MvPolynomial.C r)) = 0)
    (hDx : ∀ j l : Fin d, D j (c (MvPolynomial.X l)) = if j = l then 1 else 0)
    (T : ∀ b : U, Γ(U, ⊤) →+* MvPowerSeries (Fin d) (U.residueField b))
    (hT : ∀ b : U, isTaylorMap c (U.Γevaluation b).hom (T b))
    (h : Fin s → Γ(U, ⊤)) (a : U) (t : ℕ) :
    Ideal.map (T a) (regularJetMinorIdeal c D h (U.Γevaluation a).hom t) =
      formalJetMinorIdeal (fun i ↦ T a (h i)) t := by
  sorry

open Classical in
/-- For sufficiently many Taylor degrees, the zero locus is the equality germ of the
extended Hilbert--Samuel function, including nonclosed points.

Proof: DAG steps 12--13. By `lem-trf-jet-diagram-hilbert-control`, Taylor quotient
fibre dimensions are the extended Hilbert--Samuel values. Finitely many local
sequence values permit a finite cutoff separating the value at a from every other
value. For every larger cutoff, shrink to the common nonvanishing locus of chosen
rank-sized minors at a. All fibre ranks are at least their values at a there.
Vanishing of the next-sized minors is equivalent by Gaussian elimination to the
reverse rank inequalities. Hence it is equivalent to equality of dimensions through
the cutoff, which is equivalent to equality of the full functions. Empty pivots
are 1 and oversized minors vanish, covering zero and unit ideals.


Source: Bierstone--Milman, Invent. Math. 128 (1997), Definitions 7.9, 7.12--7.13,
Theorem 7.14 and Remarks 9.1, 9.5 (blueprint: lem-trf-formal-hilbert-stratum-minors). -/
theorem regularStratum_zeroLocus_germ
    {k : Type u} [Field k] [CharZero k] (U : Scheme.{u}) [IsAffine U]
    (p : U ⟶ Spec (CommRingCat.of k)) [Smooth p] [LocallyOfFiniteType p] [QuasiCompact p]
    {d s : ℕ} (c : MvPolynomial (Fin d) k →+* Γ(U, ⊤)) (hc : c.Etale)
    (hover : U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (c.comp MvPolynomial.C)) = p)
    (D : Fin d → Derivation ℤ Γ(U, ⊤) Γ(U, ⊤))
    (hDk : ∀ (j : Fin d) (r : k), D j (c (MvPolynomial.C r)) = 0)
    (hDx : ∀ j l : Fin d, D j (c (MvPolynomial.X l)) = if j = l then 1 else 0)
    (T : ∀ b : U, Γ(U, ⊤) →+* MvPowerSeries (Fin d) (U.residueField b))
    (hT : ∀ b : U, isTaylorMap c (U.Γevaluation b).hom (T b))
    (h : Fin s → Γ(U, ⊤)) (a : U)
    (hfinite : ∃ V : U.Opens, a ∈ V ∧
      (Set.range (fun b : V ↦ extendedHilbert
        (taylorIdeal (Ideal.span (Set.range h)) (T b.val)))).Finite) :
    ∃ q₀ : ℕ, ∀ q : ℕ, q₀ ≤ q → ∃ V : U.Opens, a ∈ V ∧
      ∀ b : U, b ∈ V →
        ((⨆ t ∈ Finset.range (q + 1),
          regularJetMinorIdeal c D h (U.Γevaluation a).hom t) ≤
            RingHom.ker (U.Γevaluation b).hom ↔
          extendedHilbert (taylorIdeal (Ideal.span (Set.range h)) (T b)) =
            extendedHilbert (taylorIdeal (Ideal.span (Set.range h)) (T a))) := by
  sorry

end AlgebraicGeometry.HilbertCoefficient
