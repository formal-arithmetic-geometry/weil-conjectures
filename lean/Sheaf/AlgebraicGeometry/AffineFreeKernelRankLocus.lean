module

public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.LocallyFree
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation

/-! # Closed maximal-rank kernel locus of a finite-free sheaf map

Source: Stacks Project, Tag 0BDL, local matrix calculation, and Tag 0EWY.
(blueprint: lem-sc-affine-free-kernel-rank-locus).
-/

@[expose] public section

set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

/-- A single map between finite-free sheaves on an affine scheme has a closed,
finitely presented locus representing rank-r locally free pulled-back kernels
when its domain has rank at most r. No complex or derived category is involved.
Source: Stacks Project, Tag 0BDL, local matrix calculation, and Tag 0EWY.
(blueprint: lem-sc-affine-free-kernel-rank-locus).

Proof: Choose the supplied finite free frames for M and N. If s=r, let I be the
ideal generated by the finitely many entries of d in Gamma(X,O_X), and let Z be
Spec(Gamma(X,O_X)/I), embedded in X using its affine identification. The quotient
is finitely presented since I is finitely generated. Factoring through Z is
locally on the source equivalent to all entries of the pulled-back map vanishing.
A zero map has free kernel of rank r. Conversely, locally trivialize a rank-r
kernel on affine opens of the source. Its inclusion in the rank-r domain is a
square injective matrix. Tag 0EWY says its cokernel has zero dual. Each coordinate
of the outgoing map factors through this cokernel and hence is zero. Therefore
the pulled-back matrix vanishes. The local factorizations glue uniquely since a
closed immersion is a monomorphism.
If s<r, take Z empty, the quotient by the unit ideal. On a nonempty affine source
chart a free rank-r kernel would inject into the rank-s domain. Pad the latter
with r-s zero coordinates, giving a square injection. Its transpose is injective
by Tag 0EWY but kills a padded basis vector, a contradiction over any nonzero
ring. Thus the source is empty, exactly the factorization condition. Over an
empty source every sheaf is locally free of every rank. Rank zero and empty X
are included: when s=r=0, d is zero and its entries cut out all of X. -/
theorem exists_affineFreeKernelRankLocus
    (X : Scheme.{u}) [IsAffine X]
    (M N : SheafOfModules.{u} (X.ringCatSheaf)) (d : M ⟶ N)
    (s n r : ℕ) (hsr : s ≤ r)
    (hM : Nonempty (M ≅ SheafOfModules.free
      (R := X.ringCatSheaf) (ULift.{u} (Fin s))))
    (hN : Nonempty (N ≅ SheafOfModules.free
      (R := X.ringCatSheaf) (ULift.{u} (Fin n)))) :
    ∃ (Z : Scheme.{u}) (i : Z ⟶ X),
      IsClosedImmersion i ∧ LocallyOfFinitePresentation i ∧
      (∀ (T : Scheme.{u}) (h : T ⟶ X),
        (∃ g : T ⟶ Z, g ≫ i = h) ↔
          SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
            (kernel ((Modules.pullback h).map d)) r) := by sorry

end AlgebraicGeometry.Scheme
