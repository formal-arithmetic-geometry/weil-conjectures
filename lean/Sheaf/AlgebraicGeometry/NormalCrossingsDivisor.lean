module

public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Sheaf.RingTheory.IsRegularSystemOfParameters

/-!
# Normal crossings effective Cartier divisors

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, Expose VIII, 4.1.1--4.1.2
(blueprint: def-trf-normal-crossings-divisor).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- An effective Cartier divisor has normal crossings if, at every point, an etale
neighbourhood has stalk ideal generated by a product of a sublist of a regular system of
parameters. The affine chart represents the stalk ideal by extension along the germ map.
The sublist can be empty, giving the unit ideal away from the divisor. No global branch
labelling or smoothness of global components is imposed, so self-intersections are allowed.
Source: ILO VIII 4.1.1--4.1.2 (blueprint: def-trf-normal-crossings-divisor). -/
def IsNormalCrossingsDivisor {X : Scheme.{u}} (D : X.IdealSheafData) : Prop :=
  D.IsInvertible ∧ ∀ x : X,
    ∃ (W : Scheme.{u}) (e : W ⟶ X), Etale e ∧
      ∃ (w : W), e w = x ∧
        ∃ (U : W.affineOpens) (hw : w ∈ U.1)
          (hR : IsNoetherianRing (W.presheaf.stalk w))
          (t s : List (W.presheaf.stalk w)),
          @IsLocalRing.IsRegularSystemOfParameters (W.presheaf.stalk w) _ _ hR t ∧
            s.Sublist t ∧
            ((D.comap e).ideal U).map (W.presheaf.germ U.1 w hw).hom =
              Ideal.span {s.prod}

end AlgebraicGeometry.Scheme.IdealSheafData
