/-! # The integral Chevalley closure and its Weyl atlas

Source: Milne, Algebraic Groups (2017), Section 23h, equations (152)--(153),
pp.510--511; integral atlas argument in the DAG.
(blueprint: lem-sfb-integral-chevalley-weyl-atlas)
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false
universe u v w

open CategoryTheory CategoryTheory.Limits WithConv
open scoped TensorProduct

namespace AlgebraicGeometry.IntegralChevalleyAtlas

/-- Integers in the scheme universe. Source: Milne, p.511
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
abbrev Z := ULift.{u} ℤ

/-- Rationals in the scheme universe. Source: Milne, p.510
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
abbrev Q := ULift.{u} ℚ

/-- The canonical rational algebra over the lifted integers. Source: Milne, p.510
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
instance rationalAlgebra : Algebra Z.{u} Q.{u} := ULift.algebra' ℤ Q

/-- The integral affine line. Source: Milne, (153)
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
abbrev line : Over (Spec (.of Z.{u})) :=
  (Spec (.of (Polynomial Z.{u}))).asOver (Spec (.of Z.{u}))

/-- A point of the affine line with its specified coordinate. Source: Milne, (153)
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def linePoint (A : Type u) [CommRing A] [Algebra Z.{u} A] (a : A) :
    (Spec (.of A)).asOver (Spec (.of Z.{u})) ⟶ line.{u} :=
  (Spec.map (CommRingCat.ofHom (Polynomial.aeval a).toRingHom)).asOver _

/-- The character torus Spec Z[P], with the actual group-algebra coordinate ring.
Source: Milne, (152)--(153) (blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
abbrev torus (P : Type u) [AddCommGroup P] : Over (Spec (.of Z.{u})) :=
  (Spec (.of (AddMonoidAlgebra Z.{u} P))).asOver (Spec (.of Z.{u}))

/-- The standard group-algebra Hopf operations on the torus. Source: Milne, p.510
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
instance torusGroup (P : Type u) [AddCommGroup P] : GrpObj (torus P) :=
  inferInstanceAs (GrpObj ((Spec (.of (AddMonoidAlgebra Z.{u} P))).asOver _))

/-- Evaluation of a torus point on the character algebra. Source: Milne, (152)
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def torusPoint {P : Type u} [AddCommGroup P]
    (A : Type u) [CommRing A] [Algebra Z.{u} A]
    (t : AddMonoidAlgebra Z.{u} P →ₐ[Z.{u}] A) :
    (Spec (.of A)).asOver (Spec (.of Z.{u})) ⟶ torus P :=
  (Spec.map (CommRingCat.ofHom t.toRingHom)).asOver _

/-- The polynomial Laurent-polynomial coordinate ring of the cell.
Source: Milne, pp.510--511 (blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
abbrev CellRing (P : Type u) [AddCommGroup P] (N : ℕ) :=
  MvPolynomial (Fin N ⊕ Fin N) (AddMonoidAlgebra Z.{u} P)

/-- The cell is A^N times Spec Z[P] times A^N over the integers.
Source: Milne, pp.510--511 (blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
abbrev cell (P : Type u) [AddCommGroup P] (N : ℕ) : Over (Spec (.of Z.{u})) :=
  (Spec (.of (CellRing P N))).asOver (Spec (.of Z.{u}))

variable {n : Type u} [Fintype n] [DecidableEq n] {I : Type v}

/-- The rational subgroup generated by all rational root and torus points.
Its vanishing ideal is the smallest closed rational subgroup containing those maps:
the rational points of affine space and of a split torus are schematically dense.
Source: Milne, Section 23h, p.510 (blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def rationalGenerators {P : Type u} [AddCommGroup P]
    (t : torus P ⟶ GeneralLinearGroup n Z.{u})
    (y : I → (line.{u} ⟶ GeneralLinearGroup n Z.{u})) : Subgroup (GL n Q.{u}) :=
  Subgroup.closure
    (Set.range (fun x : (Spec (.of Q.{u})).asOver (Spec (.of Z.{u})) ⟶ torus P ↦
      GeneralLinearGroup.homMulEquiv n Z Q (x ≫ t)) ∪
      Set.range (fun x : I × Q.{u} ↦
        GeneralLinearGroup.homMulEquiv n Z Q (linePoint Q x.2 ≫ y x.1)))

/-- The contraction of the rational generated-subgroup ideal, equivalently the kernel
Z[GL] → Q[H_Q]. Source: Milne, p.511, and the explicit closure in the DAG
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def closureIdeal {P : Type u} [AddCommGroup P]
    (t : torus P ⟶ GeneralLinearGroup n Z.{u})
    (y : I → (line.{u} ⟶ GeneralLinearGroup n Z.{u})) :
    Ideal (Matrix.GeneralLinearGroup.CoordinateRing n Z.{u}) :=
  Ideal.comap
    (Matrix.GeneralLinearGroup.evalAlgHom (k := Z.{u})
      (Matrix.GeneralLinearGroup.genericUnit n Q.{u})).toRingHom
    (Matrix.GeneralLinearGroup.vanishingIdeal (rationalGenerators t y : Set (GL n Q.{u})))

/-- The actual spectrum of the quotient by the closure ideal. Source: Milne, p.511
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def closure {P : Type u} [AddCommGroup P]
    (t : torus P ⟶ GeneralLinearGroup n Z.{u})
    (y : I → (line.{u} ⟶ GeneralLinearGroup n Z.{u})) : Over (Spec (.of Z.{u})) :=
  (Spec (.of (Matrix.GeneralLinearGroup.CoordinateRing n Z.{u} ⧸ closureIdeal t y))).asOver _

/-- The canonical closed inclusion of the matrix closure. Source: Milne, p.511
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def closureInclusion {P : Type u} [AddCommGroup P]
    (t : torus P ⟶ GeneralLinearGroup n Z.{u})
    (y : I → (line.{u} ⟶ GeneralLinearGroup n Z.{u})) : closure t y ⟶
      GeneralLinearGroup n Z.{u} :=
  (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mkₐ Z.{u} (closureIdeal t y)).toRingHom)).asOver _


/-- Restriction of the actual rational divided power to the admissible lattice.
Source: Milne, admissibility before (152), p.510
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def integralDividedPower {W : Type w} [AddCommGroup W] [Module ℚ W]
    (Λ : Submodule ℤ W) (f : Module.End ℚ W)
    (h : ∀ (m : ℕ) (x : W), x ∈ Λ → ((Nat.factorial m : ℚ)⁻¹ • f ^ m) x ∈ Λ)
    (m : ℕ) : Module.End ℤ Λ :=
  (((Nat.factorial m : ℚ)⁻¹ • f ^ m).restrictScalars ℤ).restrict (h m)

/-- The finite exponential matrix, with integral coefficients and no division in A.
Source: Milne, (153), p.510 (blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def exponentialMatrix {W : Type w} [AddCommGroup W] [Module ℚ W]
    (Λ : Submodule ℤ W) (b : Module.Basis n ℤ Λ) (f : Module.End ℚ W)
    (h : ∀ (m : ℕ) (x : W), x ∈ Λ → ((Nat.factorial m : ℚ)⁻¹ • f ^ m) x ∈ Λ)
    (d : ℕ) (A : Type u) [CommRing A] (a : A) : Matrix n n A :=
  ∑ m ∈ Finset.range d,
    a ^ m • (LinearMap.toMatrix b b (integralDividedPower Λ f h m)).map (Int.castRingHom A)

/-- The chosen Chevalley word at integral parameters 1,-1,1.
Source: Milne, Section 23h, p.510; the Weyl words in the DAG
(blueprint: lem-sfb-integral-chevalley-weyl-atlas). -/
def weylMatrix {J : Type w} (a : J → I) (neg : I → I)
    (y : I → (line.{u} ⟶ GeneralLinearGroup n Z.{u})) (l : List J) : GL n Z.{u} :=
  (l.map (fun j ↦
    GeneralLinearGroup.homMulEquiv n Z Z (linePoint Z 1 ≫ y (a j)) *
    GeneralLinearGroup.homMulEquiv n Z Z (linePoint Z (-1) ≫ y (neg (a j))) *
    GeneralLinearGroup.homMulEquiv n Z Z (linePoint Z 1 ≫ y (a j)))).prod

open Classical in
/-- A faithful full-weight admissible rational representation has the prescribed integral
matrix closure, induced group law and Weyl-indexed open atlas.

Source: Milne, Algebraic Groups (2017), Section 23h, (152)--(153), pp.510--511;
integral atlas proof supplied by the DAG
(blueprint: lem-sfb-integral-chevalley-weyl-atlas).

Proof plan:
1. The closure coordinate ring embeds in Q[H_Q], hence is torsion-free and flat over Z
   (lem-weil-pbc-pid-torsion-free-module-flat). Twice apply
   lem-trf-flat-tensor-preserves-injection to descend matrix comultiplication;
   identity and inverse descend similarly. The torus and root maps factor through it.
2. Use lem-weil-subgroup-finite-free-abelian-group-free on each lattice weight block.
   Root-datum-lattice-embedding makes P finite free. A positive integral cocharacter
   separating the weights orders the blocks. Root operators shift weights; divided-power
   identities give additive root maps and torus conjugation over every test ring.
3. By lem-sfb-chevalley-unipotent-polynomial-coordinates the ordered root products are
   closed over algebraically closed fields. The positive cocharacter grading has finite
   free pieces. Their finitely generated cokernels vanish rationally and modulo every
   prime, hence vanish integrally. Thus both integral root products are closed.
4. Weights generate P, so torus coordinate characters and their inverses generate Z[P].
   The torus is closed in the diagonal blocks. Lem-sfb-relative-block-gauss-chart makes
   the product a closed immersion into the matrix Gauss open, hence a qc immersion.
5. Lem-sfb-chevalley-root-exponential-group identifies the generic group after extending
   to the algebraic closure. Lem-sfb-chevalley-exponential-big-cell gives its open cell;
   lem-sfb-reductive-borel-pair-structure and lem-sfb-bruhat-longest-cell-charts give
   geometric integrality. The cell kernel is the generic subgroup ideal. Smoothness
   descends by lem-trf-smooth-fpqc-base-descent.
6. Contract that kernel to Z. Lemma-nagata-immersion-open-in-scheme-image makes the
   identity chart open in the closure; translation by each integral Weyl word gives θ_w.
7. In each geometric fibre the field-generated group contains the identity chart.
   Jacobson density (lem-sc-lft-over-field-jacobson-space) and rationality of closed
   points (lem-weil-pbc-closed-point-residue-field-base) show it is open and closed.
   Lem-ag-group-identity-local-dimension computes its dimension as 2N + rank P,
   the same as the generic dimension.
8. Apply lem-sfb-quasi-reductive-special-connectedness over every Z_(p). It makes each
   geometric special fibre connected, so equal to that open-and-closed subgroup.
   Scalar extension gives the same assertion over all algebraically closed fields.
9. Lem-sfb-regular-cocharacter-borel-description selects the positive Borel. Uniqueness
   in lem-sfb-reductive-root-subgroup-parametrizations identifies the exponential root
   subgroups. Lem-sfb-borel-root-product-coordinates identifies the cell with U_- B.
10. Lem-sfb-chevalley-integral-rank-one gives the stipulated simple Weyl representatives.
    Lem-sfb-weyl-reflection-realization and lem-sfb-root-base-reflection-induction identify
    all chosen words with the Weyl group. Lem-sfb-flag-torus-fixed-geometry identifies
    its fixed flags with n_w B.
11. The cell descends to a torus-stable open in the projective flag scheme, by the torsor
    sections of lem-sfb-bruhat-longest-cell-charts. A nonempty torus-stable closed
    complement of its Weyl translates would have a torus fixed point: take the limit
    at zero along a cocharacter separating the projective weights. This contradicts
    inclusion of every fixed flag in its translate. Hence the charts cover each fibre.
12. Lift every point to an algebraic closure of its residue field to obtain coverage
    over Z. Empty roots force V=P=0; all products are empty and the chart is the identity
    of Spec Z, also for the zero representation space. -/
theorem integral_chevalley_weyl_atlas
    (V : Type u) [AddCommGroup V] [Module ℚ V] [FiniteDimensional ℚ V]
    (R : Set V) (c : R → Module.Dual ℚ V)
    (hfinite : R.Finite) (hne : ∀ a : R, (a : V) ≠ 0)
    (hspan : Submodule.span ℚ R = ⊤) (htwo : ∀ a : R, c a a = 2)
    (hint : ∀ a b : R, ∃ z : ℤ, c a b = (z : ℚ))
    (hreflect : ∀ a : R, Set.BijOn (fun x : V ↦ x - c a x • (a : V)) R R)
    (hreduced : ∀ a : R,
      R ∩ (Submodule.span ℚ ({(a : V)} : Set V) : Set V) = {(a : V), -(a : V)})
    (P : Submodule ℤ V)
    (hP : ∀ x : V, x ∈ P ↔ ∀ a : R, ∃ z : ℤ, c a x = (z : ℚ))
    (r : ℕ) (b : Module.Basis (Fin r) ℚ V) (hb : ∀ i, b i ∈ R)
    (hbase : ∀ a : R, (∀ i, ∃ z : ℤ, b.repr a i = (z : ℚ)) ∧
      ((∀ i, 0 ≤ b.repr a i) ∨ (∀ i, b.repr a i ≤ 0)))
    (neg : R → R) (hneg : ∀ a : R, (neg a : V) = -(a : V))
    (N : ℕ) (β : Fin N ≃ {a : R // ∀ i, 0 ≤ b.repr a i})
    (horder : ∀ i j : Fin N, i ≤ j →
      (∑ k, b.repr (β i).val k) ≤ ∑ k, b.repr (β j).val k)
    (word : Subgroup.closure (Set.range
      (fun i : Fin r ↦ Module.reflection (htwo ⟨b i, hb i⟩))) → List (Fin r))
    (hword : ∀ w, ((word w).map
      (fun i ↦ Module.reflection (htwo ⟨b i, hb i⟩))).prod = w.val)
    (hredword : ∀ w (l : List (Fin r)),
      (l.map (fun i ↦ Module.reflection (htwo ⟨b i, hb i⟩))).prod = w.val →
      (word w).length ≤ l.length)
    (g : Type v) [LieRing g] [LieAlgebra ℚ g] [FiniteDimensional ℚ g]
    [LieAlgebra.HasTrivialRadical ℚ g]
    (H : LieSubalgebra ℚ g) [IsLieAbelian H]
    (hcartan : ∀ K : LieSubalgebra ℚ g, H ≤ K → IsLieAbelian K → K = H)
    (θ : H ≃ₗ[ℚ] Module.Dual ℚ V) (e : R → g)
    (heigen : ∀ a : R, e a ≠ 0 ∧ ∀ h : H, ⁅(h : g), e a⁆ = θ h a • e a)
    (hsplit : DirectSum.IsInternal (Sum.elim (fun _ : Unit ↦ H.toSubmodule)
      (fun a : R ↦ Submodule.span ℚ ({e a} : Set g))))
    (B : Module.Basis (Fin r ⊕ R) ℚ g)
    (hB : (∀ i, B (Sum.inl i) = (θ.symm (c ⟨b i, hb i⟩) : g)) ∧
      (∀ a : R, B (Sum.inr a) = e a))
    (hopposite : ∀ a : R, ⁅e a, e (neg a)⁆ = (θ.symm (c a) : g))
    (hbracket : ∀ a b k : R, (a : V) + (b : V) = (k : V) →
      ∃ p : ℕ, (b : V) - p • (a : V) ∈ R ∧
        (∀ m : ℕ, (b : V) - m • (a : V) ∈ R → m ≤ p) ∧
        ∃ ε : ℤ, (ε = 1 ∨ ε = -1) ∧
          ⁅e a, e b⁆ = ((ε : ℚ) * (p + 1 : ℚ)) • e k)
    (hzero : ∀ a b : R, (a : V) + (b : V) ≠ 0 →
      (a : V) + (b : V) ∉ R → ⁅e a, e b⁆ = 0)
    (W : Type w) [AddCommGroup W] [Module ℚ W]
    [LieRingModule g W] [LieModule ℚ g W]
    [FiniteDimensional ℚ W] [LieModule.IsFaithful ℚ g W]
    (Λ : Submodule ℤ W) [Submodule.IsLattice ℚ Λ] [Module.Free ℤ Λ]
    (Ω : Finset V)
    (hweights : ∀ μ ∈ Ω, μ ∈ P ∧
      LieModule.weightSpace W (fun h : H ↦ θ h μ) ≠ ⊥)
    (hdecomp : DirectSum.IsInternal (fun μ : Ω ↦
      (LieModule.weightSpace W (fun h : H ↦ θ h μ)).toSubmodule))
    (hgenerate : Submodule.span ℤ (Ω : Set V) = P)
    (hlattice : DirectSum.IsInternal (fun μ : Ω ↦
      ((LieModule.weightSpace W (fun h : H ↦ θ h μ)).toSubmodule.restrictScalars
        ℤ).comap Λ.subtype))
    (d : R → ℕ) (hnil : ∀ a : R, (LieModule.toEnd ℚ g W (e a)) ^ d a = 0)
    (hdiv : ∀ (a : R) (m : ℕ) (x : W), x ∈ Λ →
      ((Nat.factorial m : ℚ)⁻¹ • (LieModule.toEnd ℚ g W (e a)) ^ m) x ∈ Λ) :
    ∃ (n : Type u) (_ : Fintype n) (_ : DecidableEq n) (bΛ : Module.Basis n ℤ Λ)
      (μ : n → P),
      (∀ j : n, (μ j : V) ∈ Ω ∧
        (bΛ j : W) ∈ LieModule.weightSpace W (fun h : H ↦ θ h (μ j))) ∧
      ∃ (t : torus P ⟶ GeneralLinearGroup n Z.{u})
        (y : R → (line.{u} ⟶ GeneralLinearGroup n Z.{u})),
        (∀ (A : Type u) [CommRing A] [Algebra Z.{u} A]
          (χ : AddMonoidAlgebra Z.{u} P →ₐ[Z.{u}] A),
          (GeneralLinearGroup.homMulEquiv n Z A (torusPoint A χ ≫ t) : Matrix n n A) =
            Matrix.diagonal (fun j ↦ χ (AddMonoidAlgebra.single (μ j) 1))) ∧
        (∀ (A : Type u) [CommRing A] [Algebra Z.{u} A] (a : R) (x : A),
          (GeneralLinearGroup.homMulEquiv n Z A (linePoint A x ≫ y a) : Matrix n n A) =
            exponentialMatrix Λ bΛ (LieModule.toEnd ℚ g W (e a)) (hdiv a) (d a) A x) ∧
        ∃ (_ : GrpObj (closure t y)), IsMonHom (closureInclusion t y) ∧
          ∃ f : Subgroup.closure (Set.range
            (fun i : Fin r ↦ Module.reflection (htwo ⟨b i, hb i⟩))) →
              (cell P N ⟶ closure t y),
            (∀ w, IsOpenImmersion (f w).left) ∧
            (∀ x : (closure t y).left, ∃ w, x ∈ Set.range (f w).left) ∧
            (∀ (A : Type u) [CommRing A] [Algebra Z.{u} A]
              (φ : CellRing P N →ₐ[Z.{u}] A) w,
              GeneralLinearGroup.homMulEquiv n Z A
                ((Spec.map (CommRingCat.ofHom φ.toRingHom)).asOver _ ≫
                  f w ≫ closureInclusion t y) =
              Matrix.GeneralLinearGroup.map (algebraMap Z A)
                  (weylMatrix (fun i : Fin r ↦ (⟨b i, hb i⟩ : R)) neg y (word w)) *
                ((List.finRange N).map (fun i ↦
                  GeneralLinearGroup.homMulEquiv n Z A
                    (linePoint A (φ (MvPolynomial.X (Sum.inl i))) ≫ y (neg (β i).val)))).prod *
                GeneralLinearGroup.homMulEquiv n Z A
                  (torusPoint A (φ.comp (IsScalarTower.toAlgHom Z
                    (AddMonoidAlgebra Z P) (CellRing P N))) ≫ t) *
                ((List.finRange N).map (fun i ↦
                  GeneralLinearGroup.homMulEquiv n Z A
                    (linePoint A (φ (MvPolynomial.X (Sum.inr i))) ≫ y (β i).val))).prod) ∧
            (R = ∅ → Subsingleton V ∧ Subsingleton P ∧ N = 0 ∧
              ∃ (ec : cell P N ≅ Over.mk (𝟙 (Spec (.of Z.{u}))))
                (eg : closure t y ≅ Over.mk (𝟙 (Spec (.of Z.{u})))),
                f 1 ≫ eg.hom = ec.hom) := by
  sorry

end AlgebraicGeometry.IntegralChevalleyAtlas
