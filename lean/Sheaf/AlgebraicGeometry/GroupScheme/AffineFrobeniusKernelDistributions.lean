module

public import Sheaf.AlgebraicGeometry.GroupScheme.AffineGroupDistributionCalculus
public import Sheaf.AlgebraicGeometry.GroupScheme.RationalHighestWeightData

/-! # Affine Frobenius kernels and distribution pushforward

Source: Milne, Algebraic Groups (2017), Sections 2.24--2.28 (relative Frobenius), 3a and 4a
(coordinate Hopf algebras and coactions); the affine formula c ⊗ a ↦ ac^q.
(blueprint: def-sfb-affine-frobenius-kernel-distributions)

A kernel is specified by its closed inclusion and its exact coordinate ideal.
This determines the subgroup scheme, including its nonreduced structure, uniquely
up to the unique isomorphism over the ambient group. No existence choice is made.
For q = p^r the ideal is generated by qth powers of augmentation elements, exactly
the ideal obtained by pulling back the identity along relative Frobenius.
-/

@[expose] public noncomputable section

set_option autoImplicit false
universe u

open CategoryTheory
open scoped TensorProduct

namespace AlgebraicGeometry.BorelDistributions

variable {F : Type u} [Field F]
variable {G H : Grp (Over (Spec (.of F)))}

/-- The coordinate ideal of the qth relative Frobenius kernel. Over characteristic p
with q = p^r, pulling back the augmentation along c ⊗ a ↦ ac^q gives these generators.
Source: Milne, Sections 2.24--2.28.
(blueprint: def-sfb-affine-frobenius-kernel-distributions) -/
def frobeniusKernelIdeal (G : Grp (Over (Spec (.of F)))) [IsAffine G.X.left]
    (q : ℕ) : Ideal (RationalHighestWeight.coordinateAlgebra G) :=
  Ideal.span {f | ∃ c : RationalHighestWeight.coordinateAlgebra G,
    Coalgebra.counit (R := F) c = 0 ∧ f = c ^ q}

/-- An affine closed inclusion is the relative Frobenius kernel when its coordinate
restriction has exactly the Frobenius kernel ideal. This is a presentation of the
actual kernel, not merely a condition on rational points. Closed immersions of affine
schemes are determined by their coordinate ideals.
Source: Milne, Sections 2.24--2.28 and 3a (affine kernels).
(blueprint: def-sfb-affine-frobenius-kernel-distributions) -/
def IsFrobeniusKernel [IsAffine G.X.left] [IsAffine H.X.left]
    (i : H ⟶ G) (q : ℕ) : Prop :=
  IsClosedSubgroupScheme i.hom.hom ∧
    RingHom.ker (RationalHighestWeight.coordinateMap i).toRingHom = frobeniusKernelIdeal G q

/-- Push a distribution forward along the given homomorphism by precomposing with
its actual coordinate restriction. On closed subgroup kernels this is the canonical
injection of distribution algebras. The convolution law is the existing fullDual law.
Source: Milne, Sections 3a and 4a (affine coordinate duality).
(blueprint: def-sfb-affine-frobenius-kernel-distributions) -/
def push [IsAffine G.X.left] [IsAffine H.X.left] (i : H ⟶ G)
    (a : fullDual (.of F) H.X.left) : fullDual (.of F) G.X.left :=
  WithConv.toConv (a.ofConv.comp (RationalHighestWeight.coordinateMap i).toLinearMap)

end AlgebraicGeometry.BorelDistributions
