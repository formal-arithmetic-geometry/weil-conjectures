module

public import WeilConjectures.AlgebraicGeometry.GroupScheme.Defs
public import WeilConjectures.AlgebraicGeometry.DensePoints
public import WeilConjectures.AlgebraicGeometry.BaseChangeConventions
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.CategoryTheory.Monoidal.Cartesian.Over
import Sheaf.AlgebraicGeometry.GroupScheme.AffinePointedMapGeneratedSubgroup
import WeilConjectures.Mathlib.LinearAlgebra.TensorProduct.Basis
import Mathlib.AlgebraicGeometry.Pullbacks

/-! # Field extension of a subgroup generated by a pointed morphism

Source: Milne, Algebraic Groups (2017), Proposition 2.47, printed p.55,
in the affine pointed-map setting of Proposition 2.46, printed pp.54--55.
(blueprint: lem-sfb-pointed-generated-subgroup-field-extension)
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory MonoidalCategory
open scoped CategoryTheory.Obj CategoryTheory.MonObj

namespace AlgebraicGeometry

/-- A smallest closed subgroup containing an inverse-stable pointed affine map remains
smallest after any field extension. All scalar extensions below are the chosen
`Over.pullback`; their group structures are its canonical `Functor.grpObjObj` structures.
A rational point is a morphism from the tensor unit, namely `Spec k` over itself.

Source: Milne, Algebraic Groups (2017), Proposition 2.47, printed p.55,
using Proposition 2.46, printed pp.54--55.
(blueprint: lem-sfb-pointed-generated-subgroup-field-extension)

Proof:
1. By lem-sfb-affine-pointed-map-generated-subgroup, the smallest subgroup is
   Spec C, where A = k[G], I is the intersection of the positive word-map kernels,
   and C = A/I. Minimality identifies the given L with this closed subscheme.
   The descended maps f_n : C → k[X^(n+1)] jointly detect zero by the definition of I.
2. By lem-weil-pbc-fibre-product-affine-spectra and def-pc-fibre-product,
   base change identifies the coordinate rings with their tensor products with K,
   and identifies the base-changed words with the words of the base-changed map.
   The quotient q_K : A ⊗ K → C ⊗ K is surjective by lifting finite tensor sums.
   By lem-weil-pbc-closed-immersion-base-change, L_K → G_K is closed. Its points
   over each K-algebra are those of L over that algebra, so form a subgroup by
   def-sc-group-scheme-subgroup. Functoriality of def-pc-base-change preserves
   the given factorization of the pointed map.
3. Apply lem-sfb-vector-space-tensor-family-zero-detection to the family f_n
   and the k-vector space K. The maps f_n ⊗ id_K jointly detect zero, without
   any stabilization or finite-dimensionality assumption.
4. If H ⊆ G_K contains the base-changed map, every word factors through H.
   Write H = Spec((A ⊗ K)/J) by def-weil-closed-immersion. Every a ∈ J has
   q_K(a) killed by all f_n ⊗ id_K, hence q_K(a) = 0 by step 3. Thus q_K
   descends to a surjection (A ⊗ K)/J → C ⊗ K. Contravariance of
   def-weil-affine-spectrum gives L_K ⊆ H over G_K, proving minimality. -/
theorem pointedGeneratedSubgroup_fieldExtension {k : Type u} [Field k]
    (K : Type u) [Field K] [Algebra k K]
    (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
    [LocallyOfFiniteType G.hom] [QuasiCompact G.hom]
    (X : Over (Spec (.of k))) [IsAffine X.left]
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    (o : 𝟙_ (Over (Spec (.of k))) ⟶ X) (φ : X ⟶ G) (hφ : o ≫ φ = 1)
    (hinv : ∀ (R : Type u) [CommRing R] [Algebra k R]
      (x : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k R))) ⟶ X),
      ∃ y : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k R))) ⟶ X,
        y ≫ φ = (x ≫ φ)⁻¹)
    (L : Over (Spec (.of k))) [GrpObj L] (i : L ⟶ G) [IsClosedSubgroupScheme i]
    (hfactor : ∃ ψ : X ⟶ L, ψ ≫ i = φ)
    (hmin : ∀ (H : Over (Spec (.of k))) [GrpObj H] (j : H ⟶ G),
      IsClosedSubgroupScheme j → (∃ ψ : X ⟶ H, ψ ≫ j = φ) →
      ∃ a : L ⟶ H, a ≫ j = i) :
    IsClosedSubgroupScheme
      ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map i) ∧
    (∃ ψ : (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj X ⟶
        (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj L,
      ψ ≫ (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map i =
        (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map φ) ∧
    (∀ (H : Over (Spec (.of K))) [GrpObj H]
        (j : H ⟶ (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj G),
      IsClosedSubgroupScheme j →
      (∃ ψ : (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj X ⟶ H,
        ψ ≫ j = (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map φ) →
      ∃ a : (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj L ⟶ H,
        a ≫ j = (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).map i) := by
  sorry

end AlgebraicGeometry
