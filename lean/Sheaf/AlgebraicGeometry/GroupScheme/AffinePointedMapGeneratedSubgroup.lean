import Mathlib.RingTheory.Spectrum.Prime.Topology

/-! # The affine subgroup generated by an inverse-stable pointed map

Source: Milne, Algebraic Groups (2017), Propositions 2.46 and 2.48, pp.54--55.
(blueprint: lem-sfb-affine-pointed-map-generated-subgroup)

The word maps and their kernel intersection give an explicit quotient spectrum,
with its canonical map to the ambient affine group scheme.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory Limits MonoidalCategory
open scoped MonObj

namespace AlgebraicGeometry

/-- The ordered word of length `n + 1`, on the product over the base field.
Source: Milne, Proposition 2.46, pp.54--55.
(blueprint: lem-sfb-affine-pointed-map-generated-subgroup) -/
noncomputable def affinePointedWordMap {k : Type u} [Field k]
    {X G : Over (Spec (.of k))} [GrpObj G] (φ : X ⟶ G) (n : ℕ) :
    (∏ᶜ fun _ : Fin (n + 1) ↦ X) ⟶ G :=
  (List.ofFn fun i : Fin (n + 1) ↦ Pi.π (fun _ : Fin (n + 1) ↦ X) i ≫ φ).prod

/-- The intersection of the kernels of all positive-length word pullbacks on coordinates.
Source: Milne, Proposition 2.46, pp.54--55.
(blueprint: lem-sfb-affine-pointed-map-generated-subgroup) -/
noncomputable def affinePointedWordIdeal {k : Type u} [Field k]
    {X G : Over (Spec (.of k))} [GrpObj G] (φ : X ⟶ G) : Ideal Γ(G.left, ⊤) :=
  ⨅ n : ℕ, RingHom.ker (affinePointedWordMap φ n).left.appTop.hom

/-- The specified quotient spectrum, with its structure map induced from the ambient group.
Source: Milne, Proposition 2.46, pp.54--55.
(blueprint: lem-sfb-affine-pointed-map-generated-subgroup) -/
noncomputable def affinePointedGeneratedScheme {k : Type u} [Field k]
    {X G : Over (Spec (.of k))} [GrpObj G] [IsAffine G.left] (φ : X ⟶ G) :
    Over (Spec (.of k)) :=
  Over.mk (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (affinePointedWordIdeal φ))) ≫
    G.left.isoSpec.inv ≫ G.hom)

/-- The canonical map from the quotient spectrum to the ambient affine group.
Source: Milne, Proposition 2.46, pp.54--55.
(blueprint: lem-sfb-affine-pointed-map-generated-subgroup) -/
noncomputable def affinePointedGeneratedInclusion {k : Type u} [Field k]
    {X G : Over (Spec (.of k))} [GrpObj G] [IsAffine G.left] (φ : X ⟶ G) :
    affinePointedGeneratedScheme φ ⟶ G :=
  Over.homMk (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (affinePointedWordIdeal φ))) ≫
    G.left.isoSpec.inv) (Category.assoc _ _ _)

/-- An inverse-stable pointed map generates the closed subgroup given by its word kernels.
Source: Milne, Propositions 2.46 and 2.48, pp.54--55.
(blueprint: lem-sfb-affine-pointed-map-generated-subgroup)

Proof:
1. Appending the chosen point gives I_(n+1) ≤ I_n. Each word pullback descends to
   C = k[G]/I, and the descended maps jointly detect zero. The quotient map gives a
   closed immersion and the first word gives the factorization of φ.
2. The identity multiplying two words, and two applications of
   lem-sfb-vector-space-tensor-family-zero-detection, show that (q ⊗ q)Δ kills I.
   Use lem-weil-pbc-fibre-product-affine-spectra to descend multiplication to Spec C.
3. Evaluation at the chosen point descends the counit. Inversion stability, applied to
   the universal tuple over k[X^n], shows that inversion preserves I: choose inverse
   preimages and reverse their order. Thus inversion descends too. The group laws
   follow after the injective map on R-points into G(R), as in def-sc-group-scheme-subgroup.
4. Every closed subgroup containing φ contains all words, so its defining ideal lies
   in I. Quotienting gives the required inclusion into it. By lem-weil-pbc-lft-affine-pairs,
   k[G] is finitely generated, and so is C; thus Spec C is affine of finite type.
5. After any field extension K/k the descended word pullbacks still jointly detect zero,
   by lem-sfb-vector-space-tensor-family-zero-detection. All words carry the tuple of
   chosen points to the same identity point of the quotient scheme.
6. If X is geometrically reduced, all its powers over K are reduced. Induct using
   lem-sfb-flat-geometrically-reduced-pullback and lem-pc-flat-field; finite generation
   and lem-wf-affine-noetherian-components provide the locally Noetherian hypothesis
   pqf-def-locnoeth. Joint zero detection kills every nilpotent of C ⊗ K. By
   def-pc-reduced-scheme, the quotient is geometrically reduced.
7. If X is geometrically connected, its powers over K are connected, by
   lem-weil-pbc-geometrically-connected-product-components, and are nonempty by the point.
   By lem-weil-pbc-spec-clopen-idempotent their coordinate rings have only 0,1 as
   idempotents. Any idempotent of C ⊗ K has the same scalar image in every word ring,
   by evaluation at the chosen tuple. Joint zero detection makes it that scalar.
   The same idempotent criterion and the identity point imply connectedness over K.
-/
theorem affinePointedMap_generated_subgroup {k : Type u} [Field k]
    (G : Over (Spec (.of k))) [GrpObj G] [IsAffine G.left]
    [LocallyOfFiniteType G.hom] [QuasiCompact G.hom]
    (X : Over (Spec (.of k))) [IsAffine X.left]
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    (o : 𝟙_ (Over (Spec (.of k))) ⟶ X) (φ : X ⟶ G) (hφ : o ≫ φ = 1)
    (hinv : ∀ (R : Type u) [CommRing R] [Algebra k R]
      (x : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k R))) ⟶ X),
      ∃ y : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k R))) ⟶ X,
        y ≫ φ = (x ≫ φ)⁻¹) :
    ∃ hL : GrpObj (affinePointedGeneratedScheme φ),
      @IsClosedSubgroupScheme k _ (affinePointedGeneratedScheme φ) G hL _
        (affinePointedGeneratedInclusion φ) ∧
      (∃ ψ : X ⟶ affinePointedGeneratedScheme φ,
        ψ ≫ affinePointedGeneratedInclusion φ = φ) ∧
      (∀ (K : Over (Spec (.of k))) [GrpObj K] (i : K ⟶ G),
        IsClosedSubgroupScheme i → (∃ ψ : X ⟶ K, ψ ≫ i = φ) →
        ∃ j : affinePointedGeneratedScheme φ ⟶ K,
          j ≫ i = affinePointedGeneratedInclusion φ) ∧
      IsAffine (affinePointedGeneratedScheme φ).left ∧
      LocallyOfFiniteType (affinePointedGeneratedScheme φ).hom ∧
      QuasiCompact (affinePointedGeneratedScheme φ).hom ∧
      (GeometricallyReduced X.hom →
        GeometricallyReduced (affinePointedGeneratedScheme φ).hom) ∧
      (GeometricallyConnected X.hom →
        GeometricallyConnected (affinePointedGeneratedScheme φ).hom) := by
  sorry

end AlgebraicGeometry
