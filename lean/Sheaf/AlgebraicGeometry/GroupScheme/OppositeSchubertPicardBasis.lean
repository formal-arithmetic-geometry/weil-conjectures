/-! # Opposite Schubert divisors and the Picard basis

Source: Brion--Kumar, Frobenius Splitting Methods in Geometry and Representation Theory,
Section 2.1, equations (2), (6), pp.62--63, and Exercise 2.2.E(2), pp.70--71.
(blueprint: lem-sfb-opposite-schubert-picard-basis)

The orbit maps and reduced closures below are concrete constructions of the objects
introduced in the node. The simple-root index is the finite set `b.support`.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory
open scoped MonObj AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry

/-- The orbit map b ↦ bnB, over F. Source: Brion--Kumar, Section 2.1, p.62.
(blueprint: lem-sfb-opposite-schubert-picard-basis) -/
def schubertBorelOrbit {F : Type u} [Field F]
    {G B : Grp (Over (Spec (.of F)))} (iB : B ⟶ G)
    {Q : Over (Spec (.of F))} (π : G.X ⟶ Q)
    (n : 𝟙_ (Over (Spec (.of F))) ⟶ G.X) : B.X ⟶ Q :=
  (iB.hom.hom * (toUnit B.X ≫ n)) ≫ π

/-- The opposite orbit map b ↦ (n₀bn₀⁻¹)nB. Its source is B, with the actual
conjugation map onto B⁻. Source: Brion--Kumar, Section 2.1, p.63.
(blueprint: lem-sfb-opposite-schubert-picard-basis) -/
def schubertOppositeOrbit {F : Type u} [Field F]
    {G B : Grp (Over (Spec (.of F)))} (iB : B ⟶ G)
    {Q : Over (Spec (.of F))} (π : G.X ⟶ Q)
    (n₀ n : 𝟙_ (Over (Spec (.of F))) ⟶ G.X) : B.X ⟶ Q :=
  ((toUnit B.X ≫ n₀) * iB.hom.hom * (toUnit B.X ≫ n₀)⁻¹ *
    (toUnit B.X ≫ n)) ≫ π

/-- The reduced closure of an orbit, constructed by the vanishing ideal of its
closed support. Source: Brion--Kumar, Section 2.1, pp.62--63.
(blueprint: lem-sfb-opposite-schubert-picard-basis) -/
def schubertReducedClosure {F : Type u} [Field F]
    {Y Q : Over (Spec (.of F))} (f : Y ⟶ Q) : Q.left.IdealSheafData :=
  Scheme.IdealSheafData.vanishingIdeal ⟨closure (Set.range f.left), isClosed_closure⟩

/-- Degree of the restriction to the closed subscheme cut out by I, using precisely
χ(L|V(I)) − χ(O_V(I)). The over-structure is the composite of its inclusion with
Q → Spec F. Source: Brion--Kumar, Exercise 2.2.E(2), p.71; Stacks 0AYR.
(blueprint: lem-sfb-opposite-schubert-picard-basis) -/
def schubertRestrictionDegree {F : Type u} [Field F]
    (Q : Over (Spec (.of F))) (I : Q.left.IdealSheafData) (L : Q.left.Modules) : ℤ :=
  @Scheme.Modules.degree F _ I.subscheme ⟨I.subschemeι ≫ Q.hom⟩
    ((Scheme.Modules.pullback I.subschemeι).obj L)

open Classical in
/-- Opposite Schubert divisors are the degree-dual Picard basis. The quotient,
root datum, Weyl action, representatives and simple reflections are specified by
exactly their dependency interfaces; R and E are their reduced orbit closures.

Source: Brion--Kumar, Section 2.1, equations (2), (6), pp.62--63; Exercise 2.2.E(2),
pp.70--71 (all characteristics). (blueprint: lem-sfb-opposite-schubert-picard-basis)

Proof plan, following the seven steps of the node:
1. The Borel-pair theorem, flag geometry and Bruhat charts make Q smooth projective,
   integral and Noetherian. Smoothness gives regularity; the regular divisor--line
   dictionary applies. The rank-one homogeneous-line theorem identifies R_j with P¹.
2. Schubert closure/cell geometry makes E_i integral of codimension one, and shows
   their distinct supports exhaust the opposite boundary. Height-one primes in the
   regular local rings are principal by the regular-local UFD boundary theorem, so
   each reduced ideal is generated by a nonzerodivisor.
3. Left multiplication by n₀ descends along the B-torsor to τ. Since w₀²=1,
   n₀² lies in T, and τ interchanges the two big cells. Its translates D_i therefore
   have exactly the distinct irreducible-component supports of Q minus C.
4. The closure formulas exclude e₁ from E_i and place e_sj in E_i exactly if i=j.
   The coroot torus on R_j=P¹ has just these two fixed endpoints and one remaining
   geometric orbit, even in characteristic two. Thus E_i meets R_j only at e_sj
   when i=j and is disjoint from it otherwise.
5. The tangent-space transversality in the closure/cell theorem makes a local
   equation of E_j a uniformizer on R_j at e_sj. The restricted divisor is that
   reduced point with multiplicity one. The degree-agrees theorem gives δ_ij.
6. The opposite big cell is affine space, where every invertible module is trivial
   by the affine-space-invertible-trivial theorem. A trivializing rational section
   has divisor supported on the E_i. The regular divisor--line dictionary therefore
   expresses its class as the integral sum of the O(E_i) classes.
7. Riemann--Roch identifies Euler-characteristic degree with the degree homomorphism
   on each R_j. Step 5 sends the generators to the standard vectors and step 6
   shows generation, so degrees give a group isomorphism. If the simple-root support
   is empty, the product group is trivial and this also proves Pic(Q)=0. -/
theorem opposite_schubert_picard_basis
    {F : Type u} [Field F] [IsAlgClosed F]
    (G : Grp (Over (Spec (.of F)))) (hG : IsSemisimpleGroupScheme G.X)
    (hsc : ∀ (G' : Over (Spec (.of F))) [GrpObj G'],
      IsSemisimpleGroupScheme G' → ∀ (f : G' ⟶ G.X) [IsMonHom f],
      Surjective f.left → IsFinite (GrpObj.ker f).hom →
      (∀ (A : Type u) [CommRing A] [Algebra F A]
        (x : StandardGroupSchemes.affine F A ⟶ GrpObj.ker f)
        (g : StandardGroupSchemes.affine F A ⟶ G'),
        (x ≫ GrpObj.kerι f) * g = g * (x ≫ GrpObj.kerι f)) → IsIso f)
    (T B : Grp (Over (Spec (.of F)))) (iT : T ⟶ G) (iB : B ⟶ G) (j : T ⟶ B)
    (hT : ReductiveTorusCentralizer.IsMaximalTorus iT)
    (hsplit : ∃ r : ℕ, Nonempty (T ≅ MultiplicativeType.splitTorus F r))
    (hB : IsBorelGroupScheme iB.hom.hom) (hj : j ≫ iB = iT)
    [IsCommMonObj T.X] [IsCommMonObj (StandardGroupSchemes.multiplicative F)]
    (aG : ModObj T.X G.X) (aB : ModObj T.X B.X)
    (haG : aG.smul = (iT.hom.hom ⊗ₘ 𝟙 G.X) ≫ CategoryTheory.GrpObj.conj G.X)
    (haB : aB.smul = (j.hom.hom ⊗ₘ 𝟙 B.X) ≫ CategoryTheory.GrpObj.conj B.X)
    (Φ : Finset (Additive (T ⟶ Grp.mk (StandardGroupSchemes.multiplicative F))))
    (P : RootDatum Φ
      (Additive (T ⟶ Grp.mk (StandardGroupSchemes.multiplicative F)))
      (Additive (Grp.mk (StandardGroupSchemes.multiplicative F) ⟶ T)))
    (b : P.Base)
    (hroot : ∀ α : Φ, P.root α = α.val)
    (hpair : ∀ (χ : Additive (T ⟶ Grp.mk (StandardGroupSchemes.multiplicative F)))
      (ν : Additive (Grp.mk (StandardGroupSchemes.multiplicative F) ⟶ T)),
      ν.toMul.hom.hom ≫ χ.toMul.hom.hom =
        (𝟙 (StandardGroupSchemes.multiplicative F)) ^ (P.toLinearMap χ ν))
    (hweights : ∀ χ : Additive (T ⟶ Grp.mk (StandardGroupSchemes.multiplicative F)),
      χ ∈ Φ ↔ χ ≠ 0 ∧ @TorusCharacterTangent.weightSpace F _ T G aG χ.toMul ≠ ⊥)
    (hpositive : ∀ α : Φ,
      b.IsPos α ↔ @TorusCharacterTangent.weightSpace F _ T B aB α.val.toMul ≠ ⊥)
    (Q : Over (Spec (.of F))) (π : G.X ⟶ Q)
    (hπflat : Flat π.left) (hπsurj : Surjective π.left)
    (hπinv : (fst G.X B.X * (snd G.X B.X ≫ iB.hom.hom)) ≫ π = fst G.X B.X ≫ π)
    (hπtorsor : IsPullback (fst G.X B.X)
      (fst G.X B.X * (snd G.X B.X ≫ iB.hom.hom)) π π)
    (act : RankOneRoots.Weyl iT →* Aut T)
    (hact : ∀ (n : RankOneRoots.normalizer iT) (A : Over (Spec (.of F))) (t : A ⟶ T.X),
      t ≫ (act (QuotientGroup.mk n)).hom.hom.hom ≫ iT.hom.hom =
        (toUnit A ≫ n.val) * (t ≫ iT.hom.hom) * (toUnit A ≫ n.val)⁻¹)
    (s : b.support → RankOneRoots.Weyl iT)
    (hs : ∀ (i : b.support)
      (x : Additive (T ⟶ Grp.mk (StandardGroupSchemes.multiplicative F))),
      (act (s i)).inv.hom.hom ≫ x.toMul.hom.hom =
        x.toMul.hom.hom / (P.root i).toMul.hom.hom ^ P.toLinearMap x (P.coroot i))
    (w₀ : RankOneRoots.Weyl iT)
    (hw₀ : Set.image (fun α : Φ ↦ (act w₀).inv.hom.hom ≫ α.val.toMul.hom.hom)
        {α : Φ | b.IsPos α} =
      Set.image (fun α : Φ ↦ α.val.toMul.hom.hom⁻¹) {α : Φ | b.IsPos α})
    (n : RankOneRoots.Weyl iT → RankOneRoots.normalizer iT)
    (hn : ∀ w, QuotientGroup.mk (n w) = w)
    (R E : b.support → Q.left.IdealSheafData)
    (hR : ∀ i, R i = schubertReducedClosure (schubertBorelOrbit iB π (n (s i)).val))
    (hE : ∀ i, E i = schubertReducedClosure
      (schubertOppositeOrbit iB π (n w₀).val (n (s i)).val)) :
    (∀ i : b.support,
      Nonempty ((Over.mk ((R i).subschemeι ≫ Q.hom)) ≅
        ((ProjectiveLine (Spec (.of F))).asOver (Spec (.of F))))) ∧
    (∀ i : b.support, IsIntegral (E i).subscheme ∧ (E i).IsInvertible) ∧
    (∃ (τ : Q ≅ Q) (D : b.support → Q.left.IdealSheafData),
      ((toUnit G.X ≫ (n w₀).val) * 𝟙 G.X) ≫ π = π ≫ τ.hom ∧
      (∀ i, D i = ((E i).subschemeι ≫ τ.hom.left).ker) ∧
      Function.Injective (fun i ↦ (D i).support) ∧
      (Set.range (fun i ↦ ((D i).support : Set Q.left)) =
        Set.image (fun Z : Set ↥((Set.range (schubertBorelOrbit iB π (n w₀).val).left)ᶜ) ↦
          Subtype.val '' Z)
          (irreducibleComponents ↥((Set.range (schubertBorelOrbit iB π (n w₀).val).left)ᶜ))) ∧
      (Set.range (schubertBorelOrbit iB π (n w₀).val).left)ᶜ =
        ⋃ i : b.support, ((D i).support : Set Q.left)) ∧
    (∃ d : Additive Q.left.Pic ≃+ (b.support → ℤ),
      ∀ (L : Q.left.Modules) [L.IsInvertible] (j : b.support),
        d (Additive.ofMul (Scheme.Pic.ofIsInvertible L)) j =
          schubertRestrictionDegree Q (R j) L) ∧
    (∀ i j : b.support,
      schubertRestrictionDegree Q (R j) (E i).toModulesᵛ = if i = j then 1 else 0) := by
  sorry

end AlgebraicGeometry
