module

public import Sheaf.AlgebraicGeometry.GroupScheme.ReductiveBorelPairStructure
public import Sheaf.AlgebraicGeometry.GroupScheme.ReductiveRootSubgroupParametrizations
public import Sheaf.AlgebraicGeometry.GroupScheme.ReductiveRankOneReflections
import Sheaf.AlgebraicGeometry.GroupScheme.AffinePointedMapGeneratedSubgroup
import WeilConjectures.Mathlib.AlgebraicGeometry.Geometrically.Reduced
import Sheaf.AlgebraicGeometry.LocallyAlgebraicGroupIdentityComponent
import Sheaf.AlgebraicGeometry.GroupScheme.HomomorphismFactorization
import Sheaf.AlgebraicGeometry.MultiplicativeCharacterAntiduality
import Sheaf.AlgebraicGeometry.GroupScheme.BruhatLongestCellCharts
import Sheaf.AlgebraicGeometry.ReductiveTorusSelfCentralizer

/-! # Geometry of compatible rank-one graphs

Source: Milne, Algebraic Groups (2017), 23.17--23.24, pp.490--492 and Section 2h.
(blueprint: lem-sfb-compatible-rank-one-graph-geometry)

Indices 1 and 0 denote the two given groups. The graph torus is represented by its
source T₁, with its graph inclusion into the product; this is the coordinate system
specified by the first projection a in the informal statement. The two Boolean signs
mean positive (true) and negative (false). All containments are scheme-theoretic
factorizations, including the minimality among reduced closed algebraic subgroups.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory MonoidalCategory CartesianMonoidalCategory
open scoped MonObj

namespace AlgebraicGeometry

/-- The reduced closed subgroup generated by compatible rank-one graphs is reductive,
with graph maximal torus and the first group's full based root datum.
Source: Milne, 23.17--23.24 and the final paragraph completing 23.18, pp.490--492.
(blueprint: lem-sfb-compatible-rank-one-graph-geometry)

Proof plan:
1. If the simple base is empty, simple-root-generation-mixed-commutation gives Gᵢ=Tᵢ.
   The graph is closed (the coordinate pullback sends a tensor 1 to a), smooth and
   connected, and is already the required smallest group; its root datum is empty.
2. Otherwise apply affine-pointed-map-generated-subgroup to the finite disjoint union
   of the graph torus and rank-one graphs. Their images are inversion stable and their
   sources geometrically reduced by smooth-geometrically-reduced. Word kernels give
   the smallest closed group. Each connected generator lies in its reduced identity
   component; locally-algebraic-group-identity-component and minimality give smooth
   connectedness of the generated group.
3. Character antiduality and homomorphism factorization make h surjective. Both
   projections of L then contain the torus and every signed simple-root subgroup.
   Simple-root generation makes them surjective, and subdirect-product-reductivity
   makes L reductive.
4. Generate U,V by the positive and negative root graphs. They lie in the respective
   products of unipotent radicals and are normalized by the graph torus. Distinct
   positive/negative simple generators commute. The rank-one centralizer has exactly
   the two roots on its rational root line, by rank-one-reflections, so its torus and
   two root groups generate it. Root-subgroup-parametrizations give their characters.
5. Bruhat-longest-cell-charts gives a locally closed product cell VSU and a dense
   open rank-one cell P⁻SP⁺ in each rank-one graph. Only density is used here:
   Milne's displayed equality with the whole rank-one group is not required.
6. Induct on the length of a negative word to put P⁺ times that word in the closure
   of VSU. Commute unequal simple roots; for equal roots use the dense rank-one cell
   and take its closure with other factors fixed. Word-kernel density gives P⁺V in
   this closure. Stability under all generators makes the closure L, so VSU is open.
7. The smooth connected torus centralizer meets this cell in exactly S: the ambient
   self-centralizers are the two tori and cell coordinates are unique. Hence S is
   open and closed in that centralizer and equals it. Thus S is split maximal.
8. Apply torus-simple-root-isomorphism-criterion to the first projection. Its torus
   restriction and all signed simple-root graph projections are isomorphisms. This
   controls infinitesimal kernels and makes the entire first projection an isomorphism.
9. Apply isogeny-root-power-laws in both directions: exponents multiply to one, hence
   equal one. Roots, coroots and pairing therefore transport unchanged. The given base
   transports with unchanged integer expansions, and its root groups are the graphs.
-/
theorem compatible_rankOne_graph_geometry
    {F : Type u} [Field F] [IsAlgClosed F]
    (G T : Fin 2 → Grp (Over (Spec (.of F))))
    (iT : ∀ i : Fin 2, T i ⟶ G i)
    (hG : ∀ i, ReductiveTorusCentralizer.IsReductive (G i))
    (hT : ∀ i, ReductiveTorusCentralizer.IsMaximalTorus (iT i))
    (hsplit : ∀ i, ∃ r : ℕ, Nonempty (T i ≅ MultiplicativeType.splitTorus F r))
    [∀ i, IsCommMonObj (T i).X]
    [IsCommMonObj (StandardGroupSchemes.multiplicative F)]
    (aG : ∀ i, ModObj (T i).X (G i).X)
    (hconj : ∀ i, (aG i).smul = ((iT i).hom.hom ⊗ₘ 𝟙 (G i).X) ≫ GrpObj.conj (G i).X)
    (Φ : ∀ i, Finset (Additive (RankOneRoots.Character (T i))))
    (D : ∀ i, RootDatum (Φ i)
      (Additive (RankOneRoots.Character (T i))) (Additive (RankOneRoots.Cocharacter (T i))))
    (base : ∀ i, (D i).Base)
    (hred : ∀ i, (D i).IsReduced)
    (hroot : ∀ i (α : Φ i), (D i).root α = α.val)
    (hpair : ∀ i (χ : Additive (RankOneRoots.Character (T i)))
      (ν : Additive (RankOneRoots.Cocharacter (T i))),
      ν.toMul.hom.hom ≫ χ.toMul.hom.hom =
        (𝟙 (StandardGroupSchemes.multiplicative F)) ^ ((D i).toLinearMap χ ν))
    (hweights : ∀ i (χ : Additive (RankOneRoots.Character (T i))),
      χ ∈ Φ i ↔ χ ≠ 0 ∧
        @TorusCharacterTangent.weightSpace F _ (T i) (G i) (aG i) χ.toMul ≠ ⊥)
    (H : ∀ i, (base i).support → Grp (Over (Spec (.of F))))
    (kH : ∀ i α, H i α ⟶ G i) (tH : ∀ i α, T i ⟶ H i α)
    (hH : ∀ i α,
      IsClosedSubgroupScheme (kH i α).hom.hom ∧ tH i α ≫ kH i α = iT i ∧
      ∃ (S : Grp (Over (Spec (.of F))))
        (s : S ⟶ Grp.mk (GrpObj.ker α.val.val.toMul.hom.hom)),
        MultiplicativeType.IsLargestSubtorus s ∧
        ∀ A : CommAlgCat.{u} F,
          ReductiveTorusCentralizer.centralizerPoints
            (Grp.homMk (s.hom.hom ≫ GrpObj.kerι α.val.val.toMul.hom.hom) ≫ iT i) A =
              (RankOneRoots.pointImage (kH i α) (StandardGroupSchemes.affine F A) : Set _))
    (U : ∀ i, (base i).support → Bool → Grp (Over (Spec (.of F))))
    (uG : ∀ i α ε, U i α ε ⟶ G i)
    (uH : ∀ i α ε, U i α ε ⟶ H i α)
    (huH : ∀ i α ε, uH i α ε ≫ kH i α = uG i α ε)
    (hU : ∀ i α ε,
      IsClosedSubgroupScheme (uG i α ε).hom.hom ∧ Smooth (U i α ε).X.hom ∧
      ConnectedSpace (U i α ε).X.left ∧
      @TorusCharacterTangent.IsStable F _ (T i) (G i) (aG i) _ (uG i α ε) ∧
      (GrpObj.differential (uG i α ε).hom.hom).toLinearMap.range =
        @TorusCharacterTangent.weightSpace F _ (T i) (G i) (aG i)
          (if ε then α.val.val.toMul else (-α.val.val).toMul))
    (h : T 1 ⟶ T 0)
    (hstar : Additive (RankOneRoots.Character (T 0)) →+
      Additive (RankOneRoots.Character (T 1)))
    (hhstar : ∀ χ, hstar χ = Additive.ofMul (h ≫ χ.toMul))
    (hinj : Function.Injective hstar) (hfinite : Finite (_ ⧸ hstar.range))
    (b : (base 1).support ≃ (base 0).support)
    (f : ∀ α, H 1 α ⟶ H 0 (b α))
    (hfT : ∀ α, tH 1 α ≫ f α = h ≫ tH 0 (b α))
    (fU : ∀ α ε, U 1 α ε ⟶ U 0 (b α) ε)
    (hfU : ∀ α ε, uH 1 α ε ≫ f α = fU α ε ≫ uH 0 (b α) ε)
    (honto : ∀ α ε, Surjective (fU α ε).hom.hom.left) :
    ∃ (L : Grp (Over (Spec (.of F)))) (k : L ⟶ G 1 ⊗ G 0) (s : T 1 ⟶ L)
      (lH : ∀ α, H 1 α ⟶ L),
      @IsClosedSubgroupScheme F _ L.X (G 1 ⊗ G 0).X L.grp (G 1 ⊗ G 0).grp
        k.hom.hom ∧ IsReduced L.X.left ∧
      SolvableGroupStructure.IsAlgebraic L ∧
      s ≫ k = lift (iT 1) (h ≫ iT 0) ∧
      (∀ α, lH α ≫ k = lift (kH 1 α) (f α ≫ kH 0 (b α))) ∧
      (∀ (K : Grp (Over (Spec (.of F)))) (j : K ⟶ G 1 ⊗ G 0),
        @IsClosedSubgroupScheme F _ K.X (G 1 ⊗ G 0).X K.grp (G 1 ⊗ G 0).grp
          j.hom.hom → IsReduced K.X.left →
        SolvableGroupStructure.IsAlgebraic K →
        (∃ q : T 1 ⟶ K, q ≫ j = lift (iT 1) (h ≫ iT 0)) →
        (∀ α, ∃ q : H 1 α ⟶ K, q ≫ j = lift (kH 1 α) (f α ≫ kH 0 (b α))) →
        ∃ q : L ⟶ K, q ≫ j = k) ∧
      Smooth L.X.hom ∧ ConnectedSpace L.X.left ∧
      ReductiveTorusCentralizer.IsReductive L ∧
      ReductiveTorusCentralizer.IsMaximalTorus s ∧
      (∃ r : ℕ, Nonempty (T 1 ≅ MultiplicativeType.splitTorus F r)) ∧
      (∃ (aL : ModObj (T 1).X L.X)
        (DL : RootDatum (Φ 1)
          (Additive (RankOneRoots.Character (T 1)))
          (Additive (RankOneRoots.Cocharacter (T 1)))) (baseL : DL.Base),
        aL.smul = (s.hom.hom ⊗ₘ 𝟙 L.X) ≫ GrpObj.conj L.X ∧
        DL.toLinearMap = (D 1).toLinearMap ∧
        (∀ α, DL.root α = (D 1).root α ∧ DL.coroot α = (D 1).coroot α) ∧
        baseL.support = (base 1).support ∧
        (∀ χ : Additive (RankOneRoots.Character (T 1)),
          χ ∈ Φ 1 ↔ χ ≠ 0 ∧
            @TorusCharacterTangent.weightSpace F _ (T 1) L aL χ.toMul ≠ ⊥) ∧
        ∀ α ε,
          IsClosedSubgroupScheme (uH 1 α ε ≫ lH α).hom.hom ∧
          Smooth (U 1 α ε).X.hom ∧ ConnectedSpace (U 1 α ε).X.left ∧
          @TorusCharacterTangent.IsStable F _ (T 1) L aL _ (uH 1 α ε ≫ lH α) ∧
          (GrpObj.differential (uH 1 α ε ≫ lH α).hom.hom).toLinearMap.range =
            @TorusCharacterTangent.weightSpace F _ (T 1) L aL
              (if ε then α.val.val.toMul else (-α.val.val).toMul)) ∧
      ((base 1).support = ∅ → IsIso s) := by
  sorry

end AlgebraicGeometry
