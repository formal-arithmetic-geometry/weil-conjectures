/-! # Splitting over universal residual parameter-root algebras

Source: Stacks 09ZS, 09XK, 0BTV, and the explicit monic-root quotient argument
(blueprint: lem-sfb-universal-residual-root-finite-etale-splitting).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory Limits Algebra

namespace AlgebraicGeometry.UniversalResidualRoot

/-- The extended parameter ideal J H_n in the existing simultaneous root quotient.
Source: Stacks 09XK, applied to the root presentation
(blueprint: lem-sfb-universal-residual-root-finite-etale-splitting). -/
def extendedIdeal {H : Type u} [CommRing H] {r : ℕ} (t : Fin r → H) (n : ℕ) :
    Ideal (pthRootAlgebra n r H t) :=
  (Ideal.span (Set.range t)).map (algebraMap H (pthRootAlgebra n r H t))

/-- The actual residual quotient C_n = H_n / J H_n.
Source: the root quotient in Stacks 09ZS and 09XK
(blueprint: lem-sfb-universal-residual-root-finite-etale-splitting). -/
abbrev residual {H : Type u} [CommRing H] {r : ℕ} (t : Fin r → H) (n : ℕ) :=
  pthRootAlgebra n r H t ⧸ extendedIdeal t n

/-- The ideal K_n generated by the images of the polynomial variables in C_n.
Source: the explicit nilpotent root quotient accompanying Stacks 09ZS
(blueprint: lem-sfb-universal-residual-root-finite-etale-splitting). -/
def rootIdeal {H : Type u} [CommRing H] {r : ℕ} (t : Fin r → H) (n : ℕ) :
    Ideal (residual t n) :=
  Ideal.span (Set.range (fun i ↦
    Ideal.Quotient.mk (extendedIdeal t n) ((Ideal.Quotient.mk _ (MvPolynomial.X i)))))

/-- The finite disjoint union of copies of a scheme, with its structure morphism.
The index is allowed to be empty.
Source: Stacks 09ZS and the finite affine coproduct description
(blueprint: lem-sfb-universal-residual-root-finite-etale-splitting). -/
def copies (X : Scheme.{u}) (A : Type u) [Finite A] : Over X :=
  Over.mk (Sigma.desc (fun _ : A ↦ 𝟙 X))

private def copies_pullback {X Y : Scheme.{u}} (f : X ⟶ Y)
    (A : Type u) [Finite A] : (Over.pullback f).obj (copies Y A) ≅ copies X A := by
  let Y₀ := fun _ : A ↦ Y
  let P := pullback (copies Y A).hom f
  let l (a : A) : X ⟶ P :=
    pullback.lift (f ≫ Sigma.ι Y₀ a) (𝟙 X) (by simp [copies, Y₀])
  have hl (a : A) : IsPullback (l a) f (pullback.fst (copies Y A).hom f)
      (Sigma.ι Y₀ a) := by
    refine IsPullback.of_right ?_ (by simp [l])
      (IsPullback.of_hasPullback (copies Y A).hom f).flip
    simpa [l, copies, Y₀] using IsPullback.id_horiz f
  have hau := FinitaryPreExtensive.isUniversal_finiteCoproducts (coproductIsCoproduct Y₀)
  have hc : Nonempty (IsColimit (Cofan.mk P l)) := by
    apply hau (Cofan.mk P l) (Discrete.natTrans fun _ ↦ f) (pullback.fst _ _)
    · ext i
      simp [l]
    · exact NatTrans.Equifibered.of_discrete _
    · intro i
      exact hl i.as
  have : IsIso (Sigma.desc l) := (Cofan.nonempty_isColimit_iff_isIso_sigmaDesc _).mp hc
  exact (Over.isoMk (asIso (Sigma.desc l)) (by
    change Sigma.desc l ≫ pullback.snd _ _ = Sigma.desc (fun _ : A ↦ 𝟙 X)
    apply Sigma.hom_ext
    intro a
    simp [l])).symm

set_option backward.isDefEq.respectTransparency false in
private theorem splitting_of_sections
    {T : Scheme.{u}} [ConnectedSpace T]
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ T)
    (P : T.FiniteEtale)
    (h : ∀ a : (Scheme.FiniteEtale.fiber z).obj P,
      ∃ σ : T ⟶ P.obj.left, σ ≫ P.obj.hom = 𝟙 T ∧ z ≫ σ = a.left) :
    ∃ m : ℕ, Nonempty (Over.mk P.obj.hom ≅ copies T (ULift.{u} (Fin m))) := by
  classical
  let F := Scheme.FiniteEtale.fiber z
  let := Scheme.FiniteEtale.fiberFunctor z
  let : Fintype (F.obj P) := FintypeCat.fintype
  choose σ hσ hz using h
  let A := F.obj P
  let a : (∐ fun _ : A ↦ T) ⟶ T := Sigma.desc fun _ ↦ 𝟙 T
  have : Etale a := IsZariskiLocalAtSource.sigmaDesc fun _ ↦ inferInstance
  let Q : T.FiniteEtale := ⟨Scheme.Etale.mk a, inferInstanceAs (IsFinite a)⟩
  let φ : Q ⟶ P := ObjectProperty.homMk (MorphismProperty.Over.homMk
    (Sigma.desc σ) (by
      change Sigma.desc σ ≫ P.obj.hom = a
      apply Sigma.hom_ext
      intro i
      change (Sigma.ι (fun _ : A ↦ T) i ≫ Sigma.desc σ) ≫ P.obj.hom =
        Sigma.ι (fun _ : A ↦ T) i ≫ Sigma.desc (fun _ ↦ 𝟙 T)
      rw [Sigma.ι_desc, Sigma.ι_desc, hσ]))
  have : IsIso (F.map φ) := by
    apply (ConcreteCategory.isIso_iff_bijective _).mpr
    have : Subsingleton (Spec (.of Ω)) := inferInstanceAs (Subsingleton (PrimeSpectrum Ω))
    have : Nonempty (Spec (.of Ω)) := inferInstanceAs (Nonempty (PrimeSpectrum Ω))
    have hp (x : F.obj Q) : ∃ i : A, x.left = z ≫ Sigma.ι (fun _ : A ↦ T) i := by
      obtain ⟨i, x', hx'⟩ := exists_comp_sigmaι_eq_of_subsingleton
        (g := fun _ : A ↦ T) (X := Spec (.of Ω)) x.left
      have hx : x' = z := by
        have hw := Scheme.FiniteEtale.fiber_left_comp z x
        rw [← hx', Category.assoc] at hw
        simpa [Q, a] using hw
      exact ⟨i, by rw [← hx', hx]⟩
    constructor
    · intro x y hxy
      obtain ⟨i, hi⟩ := hp x
      obtain ⟨j, hj⟩ := hp y
      have hij : i = j := by
        apply Scheme.FiniteEtale.fiber_ext z
        have he := congrArg (fun w ↦ w.left) hxy
        change x.left ≫ Sigma.desc σ = y.left ≫ Sigma.desc σ at he
        simpa only [hi, hj, Category.assoc, Sigma.ι_desc, hz] using he
      apply Scheme.FiniteEtale.fiber_ext z
      rw [hi, hj, hij]
    · intro x
      refine ⟨Scheme.FiniteEtale.fiberMk z Q
        (z ≫ Sigma.ι (fun _ : A ↦ T) x) (by simp [Q, a]), ?_⟩
      apply Scheme.FiniteEtale.fiber_ext z
      change (z ≫ Sigma.ι (fun _ : A ↦ T) x) ≫ Sigma.desc σ = x.left
      simpa using hz x
  have : IsIso φ := Scheme.FiniteEtale.isIso_of_isIso_fiber_map z φ
  let e : Over.mk P.obj.hom ≅ copies T A :=
    (Over.isoMk (asIso φ.hom.left) (MorphismProperty.Over.w φ.hom)).symm
  let ε : ULift.{u} (Fin (Fintype.card A)) ≃ A :=
    Equiv.ulift.trans (Fintype.equivFin A).symm
  refine ⟨Fintype.card A, ⟨e ≪≫ ?_⟩⟩
  exact Over.isoMk (Sigma.reindex ε (fun _ : A ↦ T)).symm (by
    apply (cancel_epi (Sigma.reindex ε (fun _ : A ↦ T)).hom).mp
    dsimp only [Iso.symm_hom]
    rw [← Category.assoc, Iso.hom_inv_id, Category.id_comp]
    apply Sigma.hom_ext
    intro i
    change Sigma.ι (fun _ : ULift.{u} (Fin (Fintype.card A)) ↦ T) i ≫
      Sigma.desc (fun _ ↦ 𝟙 T) = Sigma.ι ((fun _ : A ↦ T) ∘ ε) i ≫
      (Sigma.reindex ε (fun _ : A ↦ T)).hom ≫ Sigma.desc (fun _ : A ↦ 𝟙 T)
    rw [Sigma.ι_reindex_hom_assoc, Sigma.ι_desc, Sigma.ι_desc])

set_option backward.isDefEq.respectTransparency false in
private theorem universal_stage
    (S : Scheme.{u}) [IsAffine S] [ConnectedSpace S]
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ S)
    {X : Scheme.{u}} (g : X ⟶ Scheme.UniversalCover.cover s) [IsFinite g] [Etale g] :
    ∃ (j : Scheme.UniversalCover.Index s) (W : Scheme.{u})
      (p : W ⟶ (Scheme.UniversalCover.diagram s).obj j)
      (_ : IsFinite p) (_ : Etale p) (h : X ⟶ W),
      IsPullback h g p (limit.π (Scheme.UniversalCover.diagram s) j) := by
  classical
  let F := Scheme.FiniteEtale.fiber s
  let := Scheme.FiniteEtale.fiberFunctor s
  let : Quiver.IsThin (PreGaloisCategory.PointedGaloisObject F) := by
    intro A B
    refine ⟨fun f g ↦ PreGaloisCategory.PointedGaloisObject.hom_ext ?_⟩
    exact PreGaloisCategory.evaluation_injective_of_isConnected F A.obj B.obj A.pt
      (f.comp.trans g.comp.symm)
  let : Quiver.IsThin (Scheme.UniversalCover.Index s) := by
    intro A B
    refine ⟨fun f g ↦ (Scheme.UniversalCover.indexEquiv s).inverse.map_injective ?_⟩
    exact Subsingleton.elim _ _
  let J := ThinSkeleton (Scheme.UniversalCover.Index s)
  let : IsCofiltered J := IsCofiltered.of_equivalence
    (ThinSkeleton.equivalence (Scheme.UniversalCover.Index s)).symm
  let I := OrderDual J
  let : IsFiltered I := IsFiltered.of_equivalence (orderDualEquivalence J).symm
  let : IsDirectedOrder I := IsFiltered.isDirectedOrder I
  let : Nonempty I := IsFiltered.nonempty
  let e : Iᵒᵖ ≌ Scheme.UniversalCover.Index s :=
    ((orderDualEquivalence J).op.trans (opOpEquivalence J)).trans
      (ThinSkeleton.equivalence (Scheme.UniversalCover.Index s))
  let D := e.functor ⋙ Scheme.UniversalCover.diagram s
  let c := (limit.cone (Scheme.UniversalCover.diagram s)).whisker e.functor
  let hc : IsLimit c :=
    (Functor.Initial.isLimitWhiskerEquiv e.functor _).symm
      (limit.isLimit (Scheme.UniversalCover.diagram s))
  have : ∀ {i j : Iᵒᵖ} (f : i ⟶ j), IsAffineHom (D.map f) := by
    intro i j f
    exact inferInstanceAs (IsAffineHom
      ((Scheme.UniversalCover.diagram s).map (e.functor.map f)))
  have : ∀ i : Iᵒᵖ, CompactSpace (D.obj i) := fun i ↦
    QuasiCompact.compactSpace_of_compactSpace
      (Scheme.UniversalCover.p s (e.functor.obj i))
  have : ∀ i : Iᵒᵖ, QuasiSeparatedSpace (D.obj i) := fun i ↦
    quasiSeparatedSpace_of_quasiSeparated
      (Scheme.UniversalCover.p s (e.functor.obj i))
  obtain ⟨i, U, hU, ⟨α⟩⟩ := (etale_finite_data_descent.{u, u} D c hc).1
    (Over.mk g) ⟨inferInstanceAs (Etale g), inferInstanceAs (LocallyOfFinitePresentation g),
      inferInstanceAs (QuasiCompact g), inferInstanceAs (QuasiSeparated g)⟩
  have := hU.1
  have := hU.2.1
  have := hU.2.2.1
  have := hU.2.2.2
  have : CompactSpace U.left := QuasiCompact.compactSpace_of_compactSpace U.hom
  have : QuasiSeparatedSpace U.left := quasiSeparatedSpace_of_quasiSeparated U.hom
  let φ : U ⟶ Over.mk (𝟙 (D.obj i)) := Over.homMk U.hom (by simp)
  have : LocallyOfFiniteType φ.left := inferInstanceAs (LocallyOfFiniteType U.hom)
  have hf : IsFinite (pullback.snd U.hom (c.π.app i)) := by
    change IsFinite (((Over.pullback (c.π.app i)).obj U).hom)
    rw [← Over.w α.hom]
    change IsFinite (α.hom.left ≫ g)
    infer_instance
  have hφ : IsFinite (((Over.pullback (c.π.app i)).map φ).left) := by
    have he : (((Over.pullback (c.π.app i)).map φ).left) ≫
        pullback.snd (𝟙 (D.obj i)) (c.π.app i) = pullback.snd U.hom (c.π.app i) := by
      simp
    exact (MorphismProperty.cancel_right_of_respectsIso @IsFinite _ _).mp (he ▸ hf)
  have : CompactSpace (Over.mk (𝟙 (D.obj i))).left :=
    inferInstanceAs (CompactSpace (D.obj i))
  have : QuasiSeparatedSpace (Over.mk (𝟙 (D.obj i))).left :=
    inferInstanceAs (QuasiSeparatedSpace (D.obj i))
  obtain ⟨j, hj, hfin⟩ := exists_isFinite_baseChange_stage D c hc i.unop U
    (Over.mk (𝟙 _)) φ hφ
  let q := D.map (homOfLE hj).op
  have : IsFinite (pullback.snd U.hom q) := by
    have he : (((Over.pullback q).map φ).left) ≫ pullback.snd (𝟙 _) q =
        pullback.snd U.hom q := by simp
    rw [← he]
    have := hfin
    infer_instance
  let β := (((Over.pullbackComp (c.π.app (.op j)) q).symm ≪≫
    eqToIso (congrArg (fun f ↦ Over.pullback f) (c.w (homOfLE hj).op))).app U) ≪≫ α
  refine ⟨e.functor.obj (.op j), pullback U.hom q, pullback.snd _ _,
    inferInstance, inferInstance, β.inv.left ≫ pullback.fst _ _, ?_⟩
  have sq := IsPullback.of_hasPullback (pullback.snd U.hom q) (c.π.app (.op j))
  apply IsPullback.of_iso_pullback
    ⟨by
      rw [Category.assoc, pullback.condition, ← Category.assoc]
      exact congrArg (· ≫ c.π.app (.op j)) (Over.w β.inv)⟩
    (asIso β.inv.left) rfl (Over.w β.inv)

set_option backward.isDefEq.respectTransparency false in
private theorem universal_splitting
    (S : Scheme.{u}) [IsAffine S] [ConnectedSpace S]
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ S)
    (R : Type u) [CommRing R] (eT : Spec (.of R) ≅ Scheme.UniversalCover.cover s)
    (E : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤ (Spec (.of R))) :
    ∃ m : ℕ, Nonempty (Over.mk E.hom ≅ copies (Spec (.of R)) (ULift.{u} (Fin m))) := by
  classical
  have : ConnectedSpace (Spec (.of R)) :=
    eT.hom.homeomorph.connectedSpace_iff.mpr (Scheme.UniversalCover.connectedSpace_cover s)
  have : IsFinite E.hom := E.prop.1
  have : Etale E.hom := E.prop.2
  let z := Scheme.UniversalCover.pt s ≫ eT.inv
  let P : (Spec (.of R)).FiniteEtale := ⟨Scheme.Etale.mk E.hom, E.prop.1⟩
  apply splitting_of_sections z P
  obtain ⟨j, W, p, hp, hep, h, sq⟩ := universal_stage S Ω s (E.hom ≫ eT.hom)
  have := hp
  have := hep
  let q := Scheme.UniversalCover.p s j
  let Q : S.FiniteEtale := ⟨Scheme.Etale.mk (p ≫ q), inferInstanceAs (IsFinite (p ≫ q))⟩
  intro x
  have hx : x.left ≫ E.hom = z := Scheme.FiniteEtale.fiber_left_comp z x
  have hxT : x.left ≫ (E.hom ≫ eT.hom) = Scheme.UniversalCover.pt s := by
    rw [← Category.assoc, hx]
    simp [z]
  let a : (Scheme.FiniteEtale.fiber s).obj Q := Scheme.FiniteEtale.fiberMk s Q
    (x.left ≫ h) (by
      change (x.left ≫ h) ≫ p ≫ q = s
      calc
        (x.left ≫ h) ≫ p ≫ q = (x.left ≫ (E.hom ≫ eT.hom)) ≫
            limit.π (Scheme.UniversalCover.diagram s) j ≫ q := by
          exact (Category.assoc x.left h (p ≫ q)).trans
            ((congrArg (x.left ≫ ·) (sq.w_assoc q)).trans (by simp only [Category.assoc]))
        _ = Scheme.UniversalCover.pt s ≫
            limit.π (Scheme.UniversalCover.diagram s) j ≫ q := by rw [hxT]
        _ = s := by rw [Scheme.UniversalCover.π_p, Scheme.UniversalCover.pt_proj])
  let τ := Scheme.UniversalCover.toObj s Q a
  have hτ : τ ≫ p = limit.π (Scheme.UniversalCover.diagram s) j := by
    apply Scheme.UniversalCover.eq_of_pt_comp_eq s ((Scheme.UniversalCover.obj s).obj j)
    · change (τ ≫ p) ≫ q = Scheme.UniversalCover.proj s
      simpa [τ, Q, Category.assoc] using Scheme.UniversalCover.toObj_hom s Q a
    · exact Scheme.UniversalCover.π_p s j
    · rw [← Category.assoc, Scheme.UniversalCover.pt_toObj]
      change (x.left ≫ h) ≫ p = _
      rw [Category.assoc, sq.w, ← Category.assoc, hxT]
  let σ := sq.lift τ (𝟙 _) (by rw [hτ]; simp)
  have hσ : σ ≫ E.hom = eT.inv := by
    apply (cancel_mono eT.hom).mp
    simpa only [Category.assoc, Iso.inv_hom_id] using sq.lift_snd τ (𝟙 _)
      (by rw [hτ]; simp)
  refine ⟨eT.hom ≫ σ, ?_, ?_⟩
  · change (eT.hom ≫ σ) ≫ E.hom = _
    rw [Category.assoc, hσ, eT.hom_inv_id]
  · apply sq.hom_ext
    · change (z ≫ eT.hom ≫ σ) ≫ h = x.left ≫ h
      simp only [z, Category.assoc, Iso.inv_hom_id_assoc]
      rw [sq.lift_fst, Scheme.UniversalCover.pt_toObj]
      rfl
    · change (z ≫ eT.hom ≫ σ) ≫ (E.hom ≫ eT.hom) = x.left ≫ (E.hom ≫ eT.hom)
      change (z ≫ eT.hom) ≫ (σ ≫ (E.hom ≫ eT.hom)) = _
      rw [sq.lift_snd]
      simpa [z] using hxT.symm

open scoped TensorProduct in
private theorem monomial_basis
    (H : Type u) [CommRing H] (r : ℕ) (t : Fin r → H) (n : ℕ) (hn : 0 < n) :
    ∃ b : Module.Basis (Fin r → Fin n) H (pthRootAlgebra n r H t),
      ∀ a, b a = ∏ i, (Ideal.Quotient.mk _ (MvPolynomial.X i)) ^ (a i).val := by
  classical
  nontriviality H
  let Q := pthRootAlgebra n r H t
  let I : Ideal (MvPolynomial (Fin r) H) := Ideal.span (Set.range (fun i : Fin r ↦
    (MvPolynomial.X i : MvPolynomial (Fin r) H) ^ n - MvPolynomial.C (t i)))
  let x : Fin r → Q := fun i ↦ Ideal.Quotient.mk I (MvPolynomial.X i)
  have hx (i : Fin r) : x i ^ n = algebraMap H Q (t i) := by
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span ⟨i, rfl⟩ : MvPolynomial.X i ^ n - MvPolynomial.C (t i) ∈ I)
    change Ideal.Quotient.mk I (MvPolynomial.X i ^ n - MvPolynomial.C (t i)) = 0 at h
    change x i ^ n - algebraMap H Q (t i) = 0 at h
    exact sub_eq_zero.mp h
  let f : Fin r → Polynomial H := fun i ↦ Polynomial.X ^ n - Polynomial.C (t i)
  let B : Fin r → Type u := fun i ↦ AdjoinRoot (f i)
  let T := ⨂[H] i, B i
  let l : ∀ i, B i →ₐ[H] Q := fun i ↦
    AdjoinRoot.liftAlgHom (f i) (Algebra.ofId H Q) (x i) (by simp [f, hx])
  have hl (i : Fin r) : l i (AdjoinRoot.root (f i)) = x i := by
    exact AdjoinRoot.lift_root (by simp [f, hx])
  let ml : MultilinearMap H B Q :=
    (MultilinearMap.mkPiAlgebra H (Fin r) Q).compLinearMap (fun i ↦ (l i).toLinearMap)
  let L : T →ₐ[H] Q := PiTensorProduct.liftAlgHom ml
    (by simp [ml]) (by intro a b; simp [ml, Finset.prod_mul_distrib])
  have hL (z : ∀ i, B i) : L (PiTensorProduct.tprod H z) = ∏ i, l i (z i) := by
    change PiTensorProduct.lift ml (PiTensorProduct.tprod H z) = _
    rw [PiTensorProduct.lift.tprod]
    rfl
  have hsingle (i : Fin r) (z : B i) : L (PiTensorProduct.singleAlgHom i z) = l i z := by
    rw [PiTensorProduct.singleAlgHom_apply, hL]
    rw [Finset.prod_eq_single i]
    · simp
    · intro j _ hji
      simp [Pi.mulSingle_eq_of_ne hji]
    · simp
  let y : Fin r → T := fun i ↦ PiTensorProduct.singleAlgHom i (AdjoinRoot.root (f i))
  have hy (i : Fin r) : y i ^ n = algebraMap H T (t i) := by
    have h : (AdjoinRoot.root (f i)) ^ n = algebraMap H (B i) (t i) := by
      have h := AdjoinRoot.eval₂_root (f i)
      change AdjoinRoot.root (f i) ^ n = AdjoinRoot.of (f i) (t i)
      apply sub_eq_zero.mp
      simpa [f, Polynomial.eval₂_sub, Polynomial.eval₂_pow] using h
    change (PiTensorProduct.singleAlgHom (R := H) (A := B) i)
      (AdjoinRoot.root (f i)) ^ n = _
    rw [← map_pow, h, AlgHom.commutes]
  let q : Q →ₐ[H] T := Ideal.Quotient.liftₐ I (MvPolynomial.aeval y) (by
    change I ≤ RingHom.ker (MvPolynomial.aeval y).toRingHom
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change (MvPolynomial.aeval y) (MvPolynomial.X i ^ n - MvPolynomial.C (t i)) = 0
    simp [hy])
  have hq (i : Fin r) : q (x i) = y i := by
    change MvPolynomial.aeval y (MvPolynomial.X i) = y i
    exact MvPolynomial.aeval_X y i
  have hLq : L.comp q = AlgHom.id H Q := by
    apply Ideal.Quotient.algHom_ext H
    apply MvPolynomial.algHom_ext
    intro i
    change L (q (x i)) = x i
    rw [hq, hsingle]
    exact hl i
  have hqL : q.comp L = AlgHom.id H T := by
    apply PiTensorProduct.algHom_ext
    intro i
    apply AdjoinRoot.algHom_ext
    change q (L (PiTensorProduct.singleAlgHom i (AdjoinRoot.root (f i)))) = y i
    rw [hsingle]
    rw [hl]
    exact hq i
  let e : T ≃ₐ[H] Q := AlgEquiv.ofAlgHom L q hLq hqL
  have hf (i : Fin r) : (f i).Monic := Polynomial.monic_X_pow_sub_C _ (ne_of_gt hn)
  have hd (i : Fin r) : (f i).natDegree = n := by simp [f]
  let b : ∀ i, Module.Basis (Fin n) H (B i) := fun i ↦
    ((AdjoinRoot.powerBasis' (hf i)).basis).reindex (finCongr (hd i))
  refine ⟨(Basis.piTensorProduct b).map e.toLinearEquiv, ?_⟩
  intro a
  simp only [Module.Basis.map_apply, Basis.piTensorProduct_apply]
  change L (PiTensorProduct.tprod H (fun i ↦ b i (a i))) = _
  rw [hL]
  apply Finset.prod_congr rfl
  intro i _
  change l i (((AdjoinRoot.powerBasis' (hf i)).basis.reindex (finCongr (hd i)))
    (a i)) = x i ^ (a i).val
  rw [Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, map_pow]
  change l i (AdjoinRoot.root (f i)) ^ (a i).val = _
  rw [hl]

private theorem root_relation {H : Type u} [CommRing H] {r : ℕ}
    (t : Fin r → H) (n : ℕ) (i : Fin r) :
    (Ideal.Quotient.mk _ (MvPolynomial.X i) : pthRootAlgebra n r H t) ^ n =
      algebraMap H _ (t i) := by
  apply sub_eq_zero.mp
  change Ideal.Quotient.mk _ (MvPolynomial.X i) ^ n -
    Ideal.Quotient.mk _ (MvPolynomial.C (t i)) = 0
  rw [← map_pow, ← map_sub]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)

private def rootLift {H B : Type u} [CommRing H] [CommRing B] {r : ℕ}
    (t : Fin r → H) (n : ℕ) (f : H →+* B) (x : Fin r → B)
    (hx : ∀ i, x i ^ n = f (t i)) : pthRootAlgebra n r H t →+* B :=
  Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom f x) (by
    change Ideal.span _ ≤ RingHom.ker (MvPolynomial.eval₂Hom f x)
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change (MvPolynomial.eval₂Hom f x) (MvPolynomial.X i ^ n - MvPolynomial.C (t i)) = 0
    simp [hx])

private theorem rootLift_coeff {H B : Type u} [CommRing H] [CommRing B] {r : ℕ}
    (t : Fin r → H) (n : ℕ) (f : H →+* B) (x : Fin r → B)
    (hx : ∀ i, x i ^ n = f (t i)) (h : H) :
    rootLift t n f x hx (algebraMap H _ h) = f h := by
  change (MvPolynomial.eval₂Hom f x) (MvPolynomial.C h) = f h
  simp

private theorem rootLift_root {H B : Type u} [CommRing H] [CommRing B] {r : ℕ}
    (t : Fin r → H) (n : ℕ) (f : H →+* B) (x : Fin r → B)
    (hx : ∀ i, x i ^ n = f (t i)) (i : Fin r) :
    rootLift t n f x hx (Ideal.Quotient.mk _ (MvPolynomial.X i)) = x i := by
  change (MvPolynomial.eval₂Hom f x) (MvPolynomial.X i) = x i
  simp

private theorem root_hom_ext {H B : Type u} [CommRing H] [CommRing B] {r : ℕ}
    (t : Fin r → H) (n : ℕ) (f g : pthRootAlgebra n r H t →+* B)
    (hc : ∀ h, f (algebraMap H _ h) = g (algebraMap H _ h))
    (hx : ∀ i, f (Ideal.Quotient.mk _ (MvPolynomial.X i)) =
      g (Ideal.Quotient.mk _ (MvPolynomial.X i))) : f = g := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro h
    exact hc h
  · exact hx

private theorem residual_presentation {H R : Type u} [CommRing H] [CommRing R]
    {r : ℕ} (t : Fin r → H) (n : ℕ)
    (eR : (H ⧸ Ideal.span (Set.range t)) ≃+* R) :
    ∃ eC : residual t n ≃+* pthRootAlgebra n r R (fun _ ↦ 0),
      (∀ h : H, eC (Ideal.Quotient.mk (extendedIdeal t n) (algebraMap H _ h)) =
        algebraMap R _ (eR (Ideal.Quotient.mk _ h))) ∧
      ∀ i, eC (Ideal.Quotient.mk (extendedIdeal t n)
        (Ideal.Quotient.mk _ (MvPolynomial.X i))) = Ideal.Quotient.mk _ (MvPolynomial.X i) := by
  let J := Ideal.span (Set.range t)
  let Q := pthRootAlgebra n r H t
  let P := pthRootAlgebra n r R (fun _ ↦ 0)
  let q : Q →+* residual t n := Ideal.Quotient.mk (extendedIdeal t n)
  let f : H →+* P := (algebraMap R P).comp (eR.toRingHom.comp (Ideal.Quotient.mk J))
  have ft (i : Fin r) : f (t i) = 0 := by
    change algebraMap R P (eR (Ideal.Quotient.mk J (t i))) = 0
    have ht : Ideal.Quotient.mk J (t i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    rw [ht, map_zero, map_zero]
  let x : Fin r → P := fun i ↦ Ideal.Quotient.mk _ (MvPolynomial.X i)
  have hx (i : Fin r) : x i ^ n = f (t i) := by
    rw [ft]
    exact (root_relation (fun _ : Fin r ↦ (0 : R)) n i).trans (map_zero _)
  let L : Q →+* P := rootLift t n f x hx
  have hL : extendedIdeal t n ≤ RingHom.ker L := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro h hh
    change L (algebraMap H Q h) = 0
    rw [rootLift_coeff]
    change algebraMap R P (eR (Ideal.Quotient.mk J h)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hh, map_zero, map_zero]
  let F : residual t n →+* P := Ideal.Quotient.lift _ L (fun _ h ↦ hL h)
  let c : H →+* residual t n := q.comp (algebraMap H Q)
  have hc : ∀ h ∈ J, c h = 0 := by
    intro h hh
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hh)
  let cR : R →+* residual t n :=
    (Ideal.Quotient.lift J c hc).comp eR.symm.toRingHom
  let y : Fin r → residual t n := fun i ↦ q (Ideal.Quotient.mk _ (MvPolynomial.X i))
  have hy (i : Fin r) : y i ^ n = cR 0 := by
    rw [map_zero]
    change q (Ideal.Quotient.mk _ (MvPolynomial.X i)) ^ n = 0
    rw [← map_pow, root_relation]
    exact hc _ (Ideal.subset_span ⟨i, rfl⟩)
  let G : P →+* residual t n := rootLift (fun _ : Fin r ↦ (0 : R)) n cR y hy
  have Fc (h : H) : F (c h) = f h := rootLift_coeff t n f x hx h
  have Froot (i : Fin r) : F (y i) = x i := rootLift_root t n f x hx i
  have cR_coeff (h : H) : cR (eR (Ideal.Quotient.mk J h)) = c h := by
    change Ideal.Quotient.lift J c hc (eR.symm (eR (Ideal.Quotient.mk J h))) = c h
    rw [eR.symm_apply_apply, Ideal.Quotient.lift_mk]
  have FG : F.comp G = RingHom.id P := by
    apply root_hom_ext (fun _ : Fin r ↦ (0 : R)) n
    · intro a
      obtain ⟨h, hh⟩ := Ideal.Quotient.mk_surjective (eR.symm a)
      have ha : a = eR (Ideal.Quotient.mk J h) := by rw [hh, eR.apply_symm_apply]
      rw [ha]
      rw [RingHom.comp_apply, rootLift_coeff]
      change F (cR (eR (Ideal.Quotient.mk J h))) = _
      rw [cR_coeff, Fc]
      rfl
    · intro i
      change F (G (Ideal.Quotient.mk _ (MvPolynomial.X i))) = x i
      rw [rootLift_root, Froot]
  have GF : G.comp F = RingHom.id (residual t n) := by
    apply Ideal.Quotient.ringHom_ext
    apply root_hom_ext t n
    · intro h
      change G (F (c h)) = c h
      rw [Fc]
      change G (algebraMap R P (eR (Ideal.Quotient.mk J h))) = c h
      rw [rootLift_coeff, cR_coeff]
    · intro i
      change G (F (y i)) = y i
      rw [Froot, rootLift_root]
  refine ⟨RingEquiv.ofRingHom F G FG GF, ?_, ?_⟩
  · exact Fc
  · exact Froot

private theorem residue_presentation {H R : Type u} [CommRing H] [CommRing R]
    {r : ℕ} (t : Fin r → H) (n : ℕ) (hn : 0 < n)
    (eR : (H ⧸ Ideal.span (Set.range t)) ≃+* R) :
    ∃ eD : (residual t n ⧸ rootIdeal t n) ≃+* R,
      ∀ h : H, eD (Ideal.Quotient.mk (rootIdeal t n)
        (Ideal.Quotient.mk (extendedIdeal t n) (algebraMap H _ h))) =
          eR (Ideal.Quotient.mk _ h) := by
  let J := Ideal.span (Set.range t)
  let Q := pthRootAlgebra n r H t
  let D := residual t n ⧸ rootIdeal t n
  let q : Q →+* D := (Ideal.Quotient.mk (rootIdeal t n)).comp
    (Ideal.Quotient.mk (extendedIdeal t n))
  let f : H →+* R := eR.toRingHom.comp (Ideal.Quotient.mk J)
  have ft (i : Fin r) : f (t i) = 0 := by
    change eR (Ideal.Quotient.mk J (t i)) = 0
    have ht : Ideal.Quotient.mk J (t i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    rw [ht, map_zero]
  let l : Q →+* R := rootLift t n f (fun _ ↦ 0) (by simp [hn.ne', ft])
  have hl : extendedIdeal t n ≤ RingHom.ker l := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro h hh
    change l (algebraMap H Q h) = 0
    rw [rootLift_coeff]
    change eR (Ideal.Quotient.mk J h) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hh, map_zero]
  let c : residual t n →+* R := Ideal.Quotient.lift _ l (fun _ h ↦ hl h)
  have hc : rootIdeal t n ≤ RingHom.ker c := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change l (Ideal.Quotient.mk _ (MvPolynomial.X i)) = 0
    exact rootLift_root t n f (fun _ ↦ 0) (by simp [hn.ne', ft]) i
  let F : D →+* R := Ideal.Quotient.lift _ c (fun _ h ↦ hc h)
  let g : H →+* D := q.comp (algebraMap H Q)
  have hg : ∀ h ∈ J, g h = 0 := by
    intro h hh
    change Ideal.Quotient.mk (rootIdeal t n)
      (Ideal.Quotient.mk (extendedIdeal t n) (algebraMap H Q h)) = 0
    have hz : Ideal.Quotient.mk (extendedIdeal t n) (algebraMap H Q h) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hh)
    rw [hz, map_zero]
  let G : R →+* D := (Ideal.Quotient.lift J g hg).comp eR.symm.toRingHom
  have Gf (h : H) : G (f h) = g h := by
    change Ideal.Quotient.lift J g hg (eR.symm (eR (Ideal.Quotient.mk J h))) = g h
    rw [eR.symm_apply_apply, Ideal.Quotient.lift_mk]
  have Fg (h : H) : F (g h) = f h := rootLift_coeff t n f (fun _ ↦ 0) (by simp [hn.ne', ft]) h
  have FG : F.comp G = RingHom.id R := by
    ext a
    obtain ⟨h, hh⟩ := Ideal.Quotient.mk_surjective (eR.symm a)
    have ha : a = eR (Ideal.Quotient.mk J h) := by rw [hh, eR.apply_symm_apply]
    rw [ha]
    change F (G (f h)) = f h
    rw [Gf, Fg]
  have GF : G.comp F = RingHom.id D := by
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply root_hom_ext t n
    · intro h
      change G (F (g h)) = g h
      rw [Fg, Gf]
    · intro i
      change G (l (Ideal.Quotient.mk _ (MvPolynomial.X i))) =
        Ideal.Quotient.mk (rootIdeal t n)
          (Ideal.Quotient.mk (extendedIdeal t n) (Ideal.Quotient.mk _ (MvPolynomial.X i)))
      rw [rootLift_root, map_zero]
      symm
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  exact ⟨RingEquiv.ofRingHom F G FG GF, Fg⟩

private theorem span_nilpotence {B ι : Type*} [CommRing B] [Fintype ι]
    (x : ι → B) (n : ℕ) (hn : 0 < n) (hx : ∀ i, x i ^ n = 0) :
    Ideal.span (Set.range x) ^ (Fintype.card ι * (n - 1) + 1) = ⊥ := by
  classical
  have hsup (I J : Ideal B) (a b : ℕ) :
      (I ⊔ J) ^ (a + b + 1) ≤ I ^ (a + 1) ⊔ J ^ (b + 1) := by
    rw [← Ideal.add_eq_sup, ← Ideal.add_eq_sup, add_pow, Ideal.sum_eq_sup]
    apply Finset.sup_le
    intro k hk
    by_cases hak : a + 1 ≤ k
    · exact Ideal.mul_le_left.trans (Ideal.mul_le_left.trans
        ((Ideal.pow_le_pow_right hak).trans le_sup_left))
    · refine Ideal.mul_le_left.trans (Ideal.mul_le_right.trans
        ((Ideal.pow_le_pow_right ?_).trans le_sup_right))
      omega
  have hfin (s : Finset ι) :
      Ideal.span (x '' (s : Set ι)) ^ (s.card * (n - 1) + 1) = ⊥ := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert i s hi ih =>
      rw [Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert,
        Finset.card_insert_of_notMem hi]
      apply bot_unique
      have h := hsup (Ideal.span {x i}) (Ideal.span (x '' (s : Set ι)))
        (n - 1) (s.card * (n - 1))
      have hnum : (s.card + 1) * (n - 1) + 1 =
          (n - 1) + s.card * (n - 1) + 1 := by ring
      rw [hnum]
      refine h.trans ?_
      rw [ih, sup_bot_eq, Nat.sub_add_cancel hn, Ideal.span_singleton_pow, hx]
      simp
  simpa using hfin Finset.univ

private theorem residual_nilpotence {H : Type u} [CommRing H] {r : ℕ}
    (t : Fin r → H) (n : ℕ) (hn : 0 < n) :
    rootIdeal t n ^ (r * (n - 1) + 1) = ⊥ := by
  let x : Fin r → residual t n := fun i ↦ Ideal.Quotient.mk (extendedIdeal t n)
    (Ideal.Quotient.mk _ (MvPolynomial.X i))
  have hx (i : Fin r) : x i ^ n = 0 := by
    change Ideal.Quotient.mk (extendedIdeal t n)
      (Ideal.Quotient.mk _ (MvPolynomial.X i)) ^ n = 0
    rw [← map_pow, root_relation]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
  simpa only [Fintype.card_fin, rootIdeal, x] using span_nilpotence x n hn hx

private theorem henselian_of_nilpotent {B : Type*} [CommRing B]
    (I : Ideal B) (hI : IsNilpotent I) : HenselianRing B I := by
  obtain ⟨N, hN⟩ := hI
  have : IsAdicComplete I B := by
    refine { haus' := fun x hx ↦ ?_, prec' := fun f hf ↦ ⟨f N, fun m ↦ ?_⟩ }
    · simpa [hN, Submodule.bot_smul, SModEq.bot] using hx N
    · by_cases hm : m ≤ N
      · exact hf hm
      · have hNm : N ≤ m := by omega
        have heq : f N = f m := by
          simpa [hN, Submodule.bot_smul, SModEq.bot] using hf hNm
        rw [heq]
  infer_instance

private theorem unique_iso_lift {B : Type u} [CommRing B] (I : Ideal B)
    [HenselianRing B I] (R : Type u) [CommRing R] (e : (B ⧸ I) ≃+* R)
    (E P : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤ (Spec (.of B)))
    (α : (Over.pullback (Spec.map (CommRingCat.ofHom
      (e.toRingHom.comp (Ideal.Quotient.mk I))))).obj (Over.mk E.hom) ≅
      (Over.pullback (Spec.map (CommRingCat.ofHom
        (e.toRingHom.comp (Ideal.Quotient.mk I))))).obj (Over.mk P.hom)) :
    ∃! β : Over.mk E.hom ≅ Over.mk P.hom,
      (Over.pullback (Spec.map (CommRingCat.ofHom
        (e.toRingHom.comp (Ideal.Quotient.mk I))))).mapIso β = α := by
  let Z := Spec (CommRingCat.of B)
  let Z₀ := Spec (CommRingCat.of R)
  let i : Z₀ ⟶ Z := Spec.map (CommRingCat.ofHom
    (e.toRingHom.comp (Ideal.Quotient.mk I)))
  let i₀ : Z₀ ⟶ Spec (.of (B ⧸ I)) := Spec.map (CommRingCat.ofHom e.toRingHom)
  have : IsIso i₀ := by
    change IsIso (Spec.map (CommRingCat.ofHom e.toRingHom))
    have : IsIso (CommRingCat.ofHom e.toRingHom) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr e.bijective
    infer_instance
  have hi : IsPullback i i₀ (𝟙 Z)
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
    apply IsPullback.of_vert_isIso
    constructor
    dsimp [i, i₀, Z]
    rw [Category.comp_id, ← Spec.map_comp]
  obtain ⟨ff⟩ := Scheme.fullyFaithful_pullback_finiteEtale_of_henselianRing
    (inferInstance : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).IsStableUnderBaseChange)
    I (𝟙 Z) i i₀ hi
  let F := MorphismProperty.Over.pullback (@IsFinite ⊓ @Etale) ⊤ i
  let U := MorphismProperty.Over.forget (@IsFinite ⊓ @Etale) ⊤ Z₀
  let V := MorphismProperty.Over.forget (@IsFinite ⊓ @Etale) ⊤ Z
  let uff := Functor.FullyFaithful.ofFullyFaithful U
  let vff := Functor.FullyFaithful.ofFullyFaithful V
  let α' : F.obj E ≅ F.obj P := uff.preimageIso α
  let β' : E ≅ P := ff.preimageIso α'
  have hβ : U.mapIso (F.mapIso β') = α := by
    change uff.isoEquiv (ff.isoEquiv (ff.isoEquiv.symm α')) = α
    rw [ff.isoEquiv.apply_symm_apply]
    exact (uff.isoEquiv (X := F.obj E) (Y := F.obj P)).apply_symm_apply α
  refine ⟨V.mapIso β', hβ, ?_⟩
  intro γ hγ
  let γ' : E ≅ P := vff.preimageIso γ
  have hγ' : U.mapIso (F.mapIso γ') = α := by
    change (Over.pullback i).mapIso (V.mapIso γ') = α
    rw [show V.mapIso γ' = γ from (vff.isoEquiv (X := E) (Y := P)).apply_symm_apply γ]
    exact hγ
  have heq : γ' = β' := ff.isoEquiv.injective (uff.isoEquiv.injective (hγ'.trans hβ.symm))
  calc
    γ = V.mapIso γ' := ((vff.isoEquiv (X := E) (Y := P)).apply_symm_apply γ).symm
    _ = V.mapIso β' := congrArg V.mapIso heq

private def finiteEtale_copies (X : Scheme.{u}) (A : Type u) [Finite A] :
    (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤ X :=
  MorphismProperty.Over.mk ⊤ (copies X A).hom
    ⟨inferInstanceAs (IsFinite (Sigma.desc (fun _ : A ↦ 𝟙 X))),
      IsZariskiLocalAtSource.sigmaDesc (fun _ : A ↦ inferInstance)⟩

private theorem henselian_splitting {B : Type u} [CommRing B] (I : Ideal B)
    [HenselianRing B I] (R : Type u) [CommRing R] (e : (B ⧸ I) ≃+* R)
    (hs : ∀ E : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤ (Spec (.of R)),
      ∃ m : ℕ, Nonempty (Over.mk E.hom ≅ copies (Spec (.of R)) (ULift.{u} (Fin m))))
    (E : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤ (Spec (.of B))) :
    ∃ m : ℕ, Nonempty (Over.mk E.hom ≅ copies (Spec (.of B)) (ULift.{u} (Fin m))) := by
  let i := Spec.map (CommRingCat.ofHom (e.toRingHom.comp (Ideal.Quotient.mk I)))
  let F := MorphismProperty.Over.pullback (@IsFinite ⊓ @Etale) ⊤ i
  obtain ⟨m, ⟨α⟩⟩ := hs (F.obj E)
  let P := finiteEtale_copies (Spec (.of B)) (ULift.{u} (Fin m))
  let α' : (Over.pullback i).obj (Over.mk E.hom) ≅
      (Over.pullback i).obj (Over.mk P.hom) :=
    α ≪≫ (copies_pullback i (ULift.{u} (Fin m))).symm
  obtain ⟨β, -, -⟩ := unique_iso_lift I R e E P α'
  exact ⟨m, ⟨β⟩⟩

/-- Every finite étale cover of a universal residual root algebra splits, and every
specified residual splitting has unique successive lifts, as isomorphisms.
Source: Stacks 0BTV, 09ZS, 09XK, 0544, 00J9, and 0GS2
(blueprint: lem-sfb-universal-residual-root-finite-etale-splitting).

Proof: (1) Pointed maps between connected Galois objects are unique, by injectivity
of evaluation at the marked point. The thin skeleton of the existing small index
category is equivalent to it; the opposite order is directed. Whiskering the limit
cone along this equivalence preserves its limit property. Descend an arbitrary
finite étale cover to an étale finitely presented stage, then descend finiteness.
(2) Compose the descended cover with the finite étale stage map to S. For each
geometric fibre point of the original cover, the universal-cover construction
provides a map to this composite. Marked uniqueness makes that map compatible
with the stage projection, so the cartesian square gives a section of the original
cover. These sections induce a bijection on geometric fibres. Conservativity of
the geometric fibre functor over the connected limit makes their coproduct an
isomorphism. This treats covers not initially descended from S.
(3) Identify the simultaneous root quotient with the finite tensor product of the
individual monic AdjoinRoot algebras, using explicit inverse maps on coefficients
and roots. Transport the tensor-product power basis to obtain the displayed basis.
Explicit quotient maps in both directions give the residual presentation and,
after killing the roots, the specified isomorphism to R. Each root has nth power
zero in the residual ring. The inequality
(I ⊔ J)^(a+b+1) ≤ I^(a+1) ⊔ J^(b+1), iterated over the finite set of roots,
gives the asserted nilpotence bound.
(4) The basis makes H_n finite over H, hence integral. Integral extension of the
given henselian pair gives (H_n,JH_n). A ring is complete and separated for a
nilpotent ideal: every Cauchy sequence is constant after the vanishing power.
The adic-completeness henselian instance gives (C_n,K_n).
(5) Finite coproducts of identities are finite étale, and universality of finite
coproducts identifies their pullbacks with the corresponding trivial covers.
Apply henselian full faithfulness to the identity proper morphism, first for
(C_n,K_n) and then for (H_n,JH_n). A fully faithful functor lifts an isomorphism
uniquely, including its inverse. Applying this to an arbitrary specified residual
isomorphism gives both unique lifts, and applying it to a residual splitting gives
a splitting over H_n. Empty coproducts and r=0 are included throughout. -/
theorem finiteEtale_splitting
    (S : Scheme.{u}) [IsAffine S] [ConnectedSpace S]
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ S)
    (R H : Type u) [CommRing R] [CommRing H]
    (eT : Spec (.of R) ≅ Scheme.UniversalCover.cover s)
    (r : ℕ) (t : Fin r → H) [HenselianRing H (Ideal.span (Set.range t))]
    (eR : (H ⧸ Ideal.span (Set.range t)) ≃+* R) (n : ℕ) (hn : 0 < n) :
    (∀ E : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤ (Spec (.of R)),
      ∃ m : ℕ, Nonempty (Over.mk E.hom ≅ copies (Spec (.of R)) (ULift.{u} (Fin m)))) ∧
    (∃ b : Module.Basis (Fin r → Fin n) H (pthRootAlgebra n r H t),
      ∀ a, b a = ∏ i, (Ideal.Quotient.mk _ (MvPolynomial.X i)) ^ (a i).val) ∧
    HenselianRing (pthRootAlgebra n r H t) (extendedIdeal t n) ∧
    HenselianRing (residual t n) (rootIdeal t n) ∧
    rootIdeal t n ^ (r * (n - 1) + 1) = ⊥ ∧
    (∃ eC : residual t n ≃+* pthRootAlgebra n r R (fun _ ↦ 0),
      (∀ h : H, eC (Ideal.Quotient.mk (extendedIdeal t n) (algebraMap H _ h)) =
        algebraMap R _ (eR (Ideal.Quotient.mk _ h))) ∧
      ∀ i, eC (Ideal.Quotient.mk (extendedIdeal t n) ((Ideal.Quotient.mk _ (MvPolynomial.X i)))) =
        Ideal.Quotient.mk _ (MvPolynomial.X i)) ∧
    ∃ eD : (residual t n ⧸ rootIdeal t n) ≃+* R,
      (∀ h : H, eD (Ideal.Quotient.mk (rootIdeal t n)
        (Ideal.Quotient.mk (extendedIdeal t n) (algebraMap H _ h))) =
          eR (Ideal.Quotient.mk _ h)) ∧
      (∀ E : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤
          (Spec (.of (pthRootAlgebra n r H t))),
        ∃ m : ℕ, Nonempty (Over.mk E.hom ≅
          copies (Spec (.of (pthRootAlgebra n r H t))) (ULift.{u} (Fin m)))) ∧
      ∀ (E : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤
          (Spec (.of (pthRootAlgebra n r H t)))) (A : Type u) [Finite A],
        ∀ αR :
          (Over.pullback (Spec.map (CommRingCat.ofHom
            (eD.toRingHom.comp (Ideal.Quotient.mk (rootIdeal t n)))))).obj
            ((Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).obj (Over.mk E.hom)) ≅
          (Over.pullback (Spec.map (CommRingCat.ofHom
            (eD.toRingHom.comp (Ideal.Quotient.mk (rootIdeal t n)))))).obj
            ((Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).obj
              (copies (Spec (.of (pthRootAlgebra n r H t))) A)),
        (∃! αC :
            (Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).obj (Over.mk E.hom) ≅
            (Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).obj
              (copies (Spec (.of (pthRootAlgebra n r H t))) A),
          (Over.pullback (Spec.map (CommRingCat.ofHom
            (eD.toRingHom.comp (Ideal.Quotient.mk (rootIdeal t n)))))).mapIso αC = αR) ∧
        (∀ αC :
            (Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).obj (Over.mk E.hom) ≅
            (Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).obj
              (copies (Spec (.of (pthRootAlgebra n r H t))) A),
          (Over.pullback (Spec.map (CommRingCat.ofHom
            (eD.toRingHom.comp (Ideal.Quotient.mk (rootIdeal t n)))))).mapIso αC = αR →
          ∃! αH : Over.mk E.hom ≅ copies (Spec (.of (pthRootAlgebra n r H t))) A,
            (Over.pullback (Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (extendedIdeal t n))))).mapIso αH = αC) := by
  classical
  have hs := universal_splitting S Ω s R eT
  obtain ⟨b, hb⟩ := monomial_basis H r t n hn
  have : Module.Finite H (pthRootAlgebra n r H t) := Module.Finite.of_basis b
  have : HenselianRing (pthRootAlgebra n r H t) (extendedIdeal t n) :=
    henselianRing_of_isIntegral H (Ideal.span (Set.range t)) (pthRootAlgebra n r H t)
  have hnil := residual_nilpotence t n hn
  have : HenselianRing (residual t n) (rootIdeal t n) :=
    henselian_of_nilpotent _ ⟨r * (n - 1) + 1, hnil⟩
  obtain ⟨eD, heD⟩ := residue_presentation t n hn eR
  have hsC := henselian_splitting (rootIdeal t n) R eD hs
  have hsH := henselian_splitting (extendedIdeal t n) (residual t n) (RingEquiv.refl _) hsC
  refine ⟨hs, ⟨b, hb⟩, inferInstance, inferInstance, hnil,
    residual_presentation t n eR, eD, heD, hsH, ?_⟩
  intro E A _ αR
  let P := finiteEtale_copies (Spec (.of (pthRootAlgebra n r H t))) A
  let i := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (extendedIdeal t n)))
  let F := MorphismProperty.Over.pullback (@IsFinite ⊓ @Etale) ⊤ i
  refine ⟨unique_iso_lift (rootIdeal t n) R eD (F.obj E) (F.obj P) αR, ?_⟩
  intro αC _
  exact unique_iso_lift (extendedIdeal t n) (residual t n) (RingEquiv.refl _) E P αC

end AlgebraicGeometry.UniversalResidualRoot
