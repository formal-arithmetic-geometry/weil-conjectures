module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Sheaf.AlgebraicGeometry.AlgebraicSpace
public import Sheaf.AlgebraicGeometry.RelativeFiniteHilbertGroupoids
import Mathlib.AlgebraicGeometry.AffineSpace
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import Mathlib.AlgebraicGeometry.Morphisms.Smooth
import WeilConjectures.RingTheory.KoszulRegularSequence
import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.Smooth
import Sheaf.AlgebraicGeometry.SpaceEtalePresentationPropertyCriterion
import Sheaf.AlgebraicGeometry.EtaleSmoothZeroDimensionalFibres

/-! # Composition of lci space morphisms and the étale case

Source: Stacks Project, More on Morphisms of Spaces, Tags 06C4, 06C8 and 06C9;
Morphisms of Spaces, Tags 04XX and 06CP; More on Morphisms, Tag 069J
(blueprint: lem-sfb-space-lci-composition).

Both statements use the existing two-surjective-chart predicate and its existing
scheme lci condition. No flatness, separation or Noetherian assumption is imposed.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.AlgebraicSpace

/-- Composition preserves the chartwise Koszul local complete intersection condition.
Source: Stacks, Tag 06C8, reducing to More on Morphisms, Tag 069J
(blueprint: lem-sfb-space-lci-composition).

Proof:
1. The scheme condition is étale local on source and target by
   lem-sfb-scheme-lci-etale-locality. By
   lem-sfb-space-etale-presentation-property-criterion it holds on every compatible
   presentation if it holds on one. Two-surjective-chart witnesses give such a
   presentation. Conversely, pulling back a source atlas along a target atlas gives
   the two-surjective-chart witnesses (def-trf-algebraic-space).
2. Choose an atlas T of W. Twice apply the atlas-existence clause of
   lem-sfb-unramified-etale-compatible-charts to obtain compatible U → V → T presenting
   f and g. The scheme maps a : U → V and b : V → T are lci.
3. At u in U choose V₀ → Q → T factoring b near a(u), with the first map a
   Koszul-regular closed immersion and the second smooth. By
   lem-sfb-lci-polynomial-local-factorization, after shrinking around u the map a
   factors through a Koszul-regular closed immersion U₀ → Aⁿ over V₀.
4. Embed Aⁿ over V₀ into Aⁿ over Q. On an affine chart its ideal is the polynomial
   extension of the ideal of V₀ in Q. Its Koszul complex acts coefficientwise in the
   monomial basis: each positive-degree cycle has finitely many coefficients, each a
   boundary. Assemble preimages of these coefficients to show polynomial Koszul
   exactness (def-sbc-affine-space, def-weil-closed-immersion,
   def-weil-pbc-koszul-regular-sequence).
5. By lem-sfb-koszul-immersion-composition the composite immersion is Koszul-regular.
   The ambient projection to Q is smooth by sbc-lem-affine-space-smooth; its composite
   to T is smooth by lem-trf-smooth-composition. Restricting the ambient scheme to the
   open where the immersion is closed retains smoothness by
   lem-pc-open-immersion-smooth-composition. Thus ba is lci at u.
6. This holds at every u, including vacuously for an empty source. The presentation
   criterion from step 1 gives the lci condition for g ∘ f. No flatness was used. -/
theorem lci_comp {S : Scheme.{u}} {X Y W : AlgebraicSpace S}
    (f : X ⟶ Y) (g : Y ⟶ W)
    (hf : RelativeFiniteHilbert.SpaceProperty
      (fun _ _ h ↦ RelativeFiniteHilbert.SchemeLci h) f.hom.hom)
    (hg : RelativeFiniteHilbert.SpaceProperty
      (fun _ _ h ↦ RelativeFiniteHilbert.SchemeLci h) g.hom.hom) :
    RelativeFiniteHilbert.SpaceProperty
      (fun _ _ h ↦ RelativeFiniteHilbert.SchemeLci h) (f ≫ g).hom.hom := by
  sorry

/-- Every étale space morphism is lci, with étaleness tested on compatible étale
scheme charts as in the node. Source: Stacks, Tags 06C4, 06C9, 04XX and 06CP
(blueprint: lem-sfb-space-lci-composition).

Proof: choose compatible surjective étale scheme charts for e, whose scheme map h
is étale (lem-sfb-unramified-etale-compatible-charts). Then h is smooth by
lem-weil-pbc-etale-smooth-zero-dimensional-fibres. Factor h as the identity closed
immersion followed by h. The identity ideal is zero, generated by the empty finite
sequence, whose Koszul complex is concentrated in degree zero
(def-weil-closed-immersion, def-weil-pbc-koszul-regular-sequence). This proves scheme
lci for h. The same charts witness the space condition; equivalently apply
lem-sfb-space-etale-presentation-property-criterion and
lem-sfb-scheme-lci-etale-locality. -/
theorem lci_of_etale {S : Scheme.{u}} {X Y : AlgebraicSpace S} (e : X ⟶ Y)
    (he : RelativeFiniteHilbert.SpaceProperty (fun _ _ h ↦ Etale h) e.hom.hom) :
    RelativeFiniteHilbert.SpaceProperty
      (fun _ _ h ↦ RelativeFiniteHilbert.SchemeLci h) e.hom.hom := by
  sorry

end AlgebraicGeometry.AlgebraicSpace
