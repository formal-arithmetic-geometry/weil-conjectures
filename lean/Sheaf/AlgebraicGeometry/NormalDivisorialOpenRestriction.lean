/-! # Divisorial modules on a normal scheme

Source: Stacks Project, Divisors, Tags 0EBM, 0EBL, 0BE6 and 0BE8
(blueprint: lem-sfb-normal-divisorial-open-restriction).

The construction takes the subpresheaf generated by the prescribed rational sections
inside the generic-point skyscraper, then sheafifies. No existence theorem chooses
its data. The section characterization below identifies it with the valuation subsheaf.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory MonoidalCategory Opposite TopologicalSpace

namespace AlgebraicGeometry.Scheme

/-- The local inequality defining O(D), written using a nonzero fraction a/b.
On a normal Noetherian scheme the orders are the normalized DVR orders.
Source: Stacks, Tag 0EBM (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.Allows {Y : Scheme.{u}} [IsIntegral Y] (D : Y.WeilDivisor)
    (p : Y.WeilPrime) (f : Y.functionField) : Prop :=
  f = 0 ∨ ∃ a b : Y.presheaf.stalk p.val,
    a ≠ 0 ∧ b ≠ 0 ∧ f * algebraMap _ Y.functionField b = algebraMap _ Y.functionField a ∧
      0 ≤ (Ring.ord (Y.presheaf.stalk p.val) a).toNat -
        ((Ring.ord (Y.presheaf.stalk p.val) b).toNat : ℤ) + D p

/-- The prescribed rational sections on an open. The empty open has its unique zero
section, since it does not contain the generic point.
Source: Stacks, Tag 0EBM (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.AllowsSection {Y : Scheme.{u}} [IsIntegral Y] (D : Y.WeilDivisor)
    (W : Y.Opens) (s : (Modules.skyscraper (genericPoint Y) Y.functionField).val.obj (op W)) :
    Prop :=
  ∀ (h : PLift (genericPoint Y ∈ W)) (p : Y.WeilPrime), p.val ∈ W → D.Allows p (s h)

/-- The subpresheaf generated by the allowed sections, inside the constant rational
module. Taking an infimum constructs its actual modules and restriction maps.
Source: Stacks, Tag 0EBM (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.divisorialSubpresheaf {Y : Scheme.{u}} [IsIntegral Y]
    (D : Y.WeilDivisor) :
    (Modules.skyscraper (genericPoint Y) Y.functionField).val.Submodule :=
  sInf {N | ∀ (W : Y.Opens) (s), D.AllowsSection W s → s ∈ N.obj (op W)}

/-- The actual divisorial module O(D), with the O(D), rather than O(-D), sign.
Source: Stacks, Tag 0EBM (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.divisorialModule {Y : Scheme.{u}} [IsIntegral Y]
    (D : Y.WeilDivisor) : Y.Modules :=
  (PresheafOfModules.sheafification (𝟙 Y.ringCatSheaf.obj)).obj
    D.divisorialSubpresheaf.toPresheafOfModules

set_option backward.isDefEq.respectTransparency false in
/-- The canonical map from O(D) into the constant rational module, obtained by
sheafifying the inclusion and applying the sheafification counit.
Source: Stacks, Tag 0EBM (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.divisorialInclusion {Y : Scheme.{u}} [IsIntegral Y]
    (D : Y.WeilDivisor) :
    D.divisorialModule ⟶ Modules.skyscraper (genericPoint Y) Y.functionField :=
  (PresheafOfModules.sheafification (𝟙 Y.ringCatSheaf.obj)).map D.divisorialSubpresheaf.ι ≫
    (PresheafOfModules.sheafificationAdjunction (𝟙 Y.ringCatSheaf.obj)).counit.app
      (Modules.skyscraper (genericPoint Y) Y.functionField)

/-- Coefficient at a point, zero away from codimension one.
Source: Stacks, Tag 0BE2 (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.coefficientAt {Y : Scheme.{u}} (D : Y.WeilDivisor) (y : Y) : ℤ :=
  if h : ringKrullDim (Y.presheaf.stalk y) = 1 then D ⟨y, h⟩ else 0

/-- Restriction retains exactly the coefficients at the points of the open.
Source: Stacks, Tag 0EBM (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def WeilDivisor.IsOpenRestriction {Y : Scheme.{u}} (D : Y.WeilDivisor)
    (U : Y.Opens) (E : U.toScheme.WeilDivisor) : Prop :=
  ∀ q : U.toScheme.WeilPrime, E q = D.coefficientAt q.val.val

/-- The canonical function-field map for a nonempty open: the inverse generic-stalk
map followed by the equality identifying its image point with the generic point.
Source: Stacks, Tag 01RW (blueprint: lem-sfb-normal-divisorial-open-restriction). -/
def openFunctionFieldMap (Y : Scheme.{u}) [IsIntegral Y] (U : Y.Opens)
    [IsIntegral U.toScheme] : U.toScheme.functionField ⟶ Y.functionField :=
  (asIso (U.ι.stalkMap (genericPoint U.toScheme))).inv ≫
    Y.presheaf.stalkSpecializes (specializes_of_eq
      (genericPoint_eq_of_isOpenImmersion U.ι).symm)

/-- The complete divisorial dictionary, extension theorem, boundary kernel and
reflexive tensor law, with canonical open restriction.
Source: Stacks, Tags 0EBM, 0EBL, 0BE6 and 0BE8
(blueprint: lem-sfb-normal-divisorial-open-restriction).

Proof:
1. On a nonempty affine Spec A, integrality and local Noetherianity give a
Noetherian domain. Stalk localization and the fraction-field comparison identify
its fraction field with k(Y); local normality makes A integrally closed.
The principal-divisor kernel lemma supplies the height-one DVRs and finite support.
2. Apply divisorial-fractional-module-lattices with exponents -D. Its localization
formula glues the prescribed lattices to O(D). Affine reflexive comparison and
locality of coherence give coherence, reflexivity and rank one; the intersection
formula for D=0 identifies O(0) with the structure sheaf. This also identifies the
subpresheaf generation and sheafification above with the original inequalities.
3. Height-one points, local rings, valuations and generic fractions are unchanged
on an open neighborhood. The section conditions are identical on every subopen.
Sheaf Hom restricts by restricting its local maps, and tensor restricts by the
canonical comparison on pure tensors. These give the stated dual comparisons.
4. Trivialize the generic fibre of a coherent reflexive rank-one F. Affine
reflexive-height-one intersection embeds it in k(Y). Its stalk at each height-one
point is a free rank-one DVR lattice, with exponent e. A nonzero section and a
common denominator for finite generators bound these exponents, proving finite
support on each affine and globally on a finite affine cover.
5. Put D=-sum e[Z]. Its stalk lattices equal those of F. The height-one intersection
criterion on affines identifies the modules and glues their generic embeddings.
6. Apply this classification to an invertible module on U, then close its finitely
many prime divisors in Y. The resulting O(D) extends that module.
7. If F is trivial on U, use that trivialization for the generic embedding.
All exponents in U vanish. The remaining height-one primes are exactly
codimension-one components of the closed boundary; there are finitely many by
finiteness of minimal primes on a finite affine cover. Insert zero coefficients
for components absent from the divisor.
8. Tensor two affine fractional lattices. Coherence of tensor and Hom, the
coherent reflexive hull lemma, and finite-presentation stalk-Hom comparison
show that its double dual is coherent reflexive of generic rank one.
At a height-one DVR the exponents add under generic multiplication.
9. Reconstruct by the height-one intersection criterion to obtain O(D+E).
For a field the empty intersection is the full field.
10. Write F as O(D) to obtain the final tensor assertion. When E restricts to
zero, its restriction is O_U. Canonical tensor and bidual restriction, followed
by bidual evaluation for the invertible F|U, give the final identification. -/
theorem normalDivisorialOpenRestriction (Y : Scheme.{u}) [IsIntegral Y]
    [IsNoetherian Y]
    (hnormal : ∀ y : Y, IsDomain (Y.presheaf.stalk y) ∧
      IsIntegrallyClosed (Y.presheaf.stalk y))
    (U : Y.Opens) [Nonempty U] :
    (∀ D : Y.WeilDivisor, Modules.IsCoherentReflexiveRankOne D.divisorialModule ∧
      ∀ W : Y.Opens,
        Function.Injective (D.divisorialInclusion.app W) ∧
        Set.range (D.divisorialInclusion.app W) = {s | D.AllowsSection W s}) ∧
    (∃ e : (0 : Y.WeilDivisor).divisorialModule ≅ 𝟙_ Y.Modules,
      ∀ (W : Y.Opens) (a : Γ(Y, W)) (h : PLift (genericPoint Y ∈ W)),
        ((0 : Y.WeilDivisor).divisorialInclusion.app W (e.inv.app W a)) h =
          Y.presheaf.germ W (genericPoint Y) h.down a) ∧
    (∀ F : Y.Modules, Modules.IsCoherentReflexiveRankOne F →
      ∃ D : Y.WeilDivisor, Nonempty (F ≅ D.divisorialModule)) ∧
    (∀ D : Y.WeilDivisor, ∃ E : U.toScheme.WeilDivisor,
      D.IsOpenRestriction U E ∧
      ∃ e : D.divisorialModule.restrict U.ι ≅ E.divisorialModule,
        ∀ (W : U.toScheme.Opens) (s : Γ(D.divisorialModule.restrict U.ι, W))
          (h : PLift (genericPoint U.toScheme ∈ W))
          (hY : PLift (genericPoint Y ∈ U.ι ''ᵁ W)),
          openFunctionFieldMap Y U ((E.divisorialInclusion.app W (e.hom.app W s)) h) =
            (D.divisorialInclusion.app (U.ι ''ᵁ W)
              ((D.divisorialModule.restrictAppIso U.ι W).hom s)) hY) ∧
    (∀ L : U.toScheme.Modules, L.IsInvertible →
      ∃ F : Y.Modules, Modules.IsCoherentReflexiveRankOne F ∧
        Nonempty (F.restrict U.ι ≅ L)) ∧
    (∀ F : Y.Modules, Modules.IsCoherentReflexiveRankOne F →
      Nonempty (F.restrict U.ι ≅ 𝟙_ U.toScheme.Modules) →
      ∃ (s : ℕ) (Z : Fin s → Y.WeilPrime) (m : Fin s → ℤ),
        Function.Injective Z ∧
        Set.range Z = {p | closure ({p.val} : Set Y) ⊆ (U : Set Y)ᶜ} ∧
        Nonempty (F ≅ WeilDivisor.divisorialModule (∑ i, Finsupp.single (Z i) (m i)))) ∧
    (∀ D E : Y.WeilDivisor,
      Nonempty (Modules.dual (Modules.dual (D.divisorialModule ⊗ E.divisorialModule)) ≅
        (D + E).divisorialModule)) ∧
    (∀ (F : Y.Modules) (E : Y.WeilDivisor), Modules.IsCoherentReflexiveRankOne F →
      Modules.IsCoherentReflexiveRankOne
        (Modules.dual (Modules.dual (F ⊗ E.divisorialModule))) ∧
      ((F.restrict U.ι).IsInvertible → E.IsOpenRestriction U 0 →
        Nonempty ((Modules.dual (Modules.dual (F ⊗ E.divisorialModule))).restrict U.ι ≅
          F.restrict U.ι))) ∧
    (∀ F : Y.Modules,
      ∃ (e : (Modules.dual F).restrict U.ι ≅ Modules.dual (F.restrict U.ι))
        (e₂ : (Modules.dual (Modules.dual F)).restrict U.ι ≅
          Modules.dual (Modules.dual (F.restrict U.ι))),
        (∀ (W : U.toScheme.Opens) (φ : Γ((Modules.dual F).restrict U.ι, W))
          (s : Γ(F.restrict U.ι, W)),
          (U.ι.appIso W).hom
            (PresheafOfModules.homObjEvalId F.val
              (SheafOfModules.unit Y.ringCatSheaf).val (U.ι ''ᵁ W)
              (((Modules.dual F).restrictAppIso U.ι W).hom φ)
              ((F.restrictAppIso U.ι W).hom s)) =
          PresheafOfModules.homObjEvalId (F.restrict U.ι).val
            (SheafOfModules.unit U.toScheme.ringCatSheaf).val W (e.hom.app W φ) s) ∧
        (∀ (W : U.toScheme.Opens)
          (t : Γ((Modules.dual (Modules.dual F)).restrict U.ι, W))
          (φ : Γ((Modules.dual F).restrict U.ι, W)),
          (U.ι.appIso W).hom
            (PresheafOfModules.homObjEvalId (Modules.dual F).val
              (SheafOfModules.unit Y.ringCatSheaf).val (U.ι ''ᵁ W)
              (((Modules.dual (Modules.dual F)).restrictAppIso U.ι W).hom t)
              (((Modules.dual F).restrictAppIso U.ι W).hom φ)) =
          PresheafOfModules.homObjEvalId (Modules.dual (F.restrict U.ι)).val
            (SheafOfModules.unit U.toScheme.ringCatSheaf).val W
            (e₂.hom.app W t) (e.hom.app W φ)) ∧
        (Modules.restrictFunctor U.ι).map (SheafOfModules.bidual (R := Y.sheaf) F) ≫
            e₂.hom = SheafOfModules.bidual (R := U.toScheme.sheaf) (F.restrict U.ι)) ∧
    (∀ F G : Y.Modules,
      ∃ e : (F ⊗ G).restrict U.ι ≅ F.restrict U.ι ⊗ G.restrict U.ι,
        ∀ (W : U.toScheme.Opens) (s : Γ(F.restrict U.ι, W))
          (t : Γ(G.restrict U.ι, W)),
          ((F ⊗ G).restrictAppIso U.ι W).hom
            (e.inv.app W (Modules.tmulSection s t)) =
          Modules.tmulSection ((F.restrictAppIso U.ι W).hom s)
            ((G.restrictAppIso U.ι W).hom t)) := by
  sorry

end AlgebraicGeometry.Scheme
