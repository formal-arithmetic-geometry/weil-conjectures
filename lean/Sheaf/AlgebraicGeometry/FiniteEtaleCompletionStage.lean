/-!
# A finite presentation stage for a cover of the closed fibre

Source: Stacks Project, Fundamental Groups, proof of Lemma 0GS2, Noetherian G-ring
paragraph, completion and descent steps
(blueprint: lem-weil-pbc-finite-etale-completion-stage).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Scheme

/-- A closed-fibre cover has a finite étale model over a finitely presented algebra mapping
into the completion. No G-ring or henselian assumption is needed for this descent step.
Source: Stacks Project, proof of Lemma 0GS2, lines 1815–1829
(blueprint: lem-weil-pbc-finite-etale-completion-stage).

Proof: put B = the I-adic completion and J = IB. Noetherianity of A makes I finitely
generated, so B is J-adically complete, Noetherian, and B/J is canonically A/I.
Base change Y to B and transport V through the resulting closed-fibre isomorphism.
The complete-case lifting theorem gives a finite étale cover of this base change.
Write B as the filtered union of the A-subalgebras generated by finite subsets.
Each is finitely presented since A is Noetherian. Spec turns this union into an inverse
limit with affine transitions; base change of Y preserves this limit. Properness makes
its stages quasi-compact and quasi-separated. A finite étale morphism is of finite
presentation. Spreading out descends the cover to a stage. The finite and étale descent
lemmas, followed by a common enlargement, make that stage cover finite étale. Call its
algebra R, its map to B c, and its cover W. The map k from Y₀ to Y_R is induced by
B → A/I composed with c. Its projections are the two displayed equalities. Pasting
pullbacks identifies W ×_{Y_R} Y₀ with the closed fibre of the completed cover, hence V.
The isomorphism is over Y₀. -/
theorem exists_finiteEtale_completion_stage
    {A : Type u} [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    {Y : Scheme.{u}} (f : Y ⟶ Spec (.of A)) [IsProper f]
    (V : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤
      (pullback f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))) :
    ∃ (R : Type u) (_ : CommRing R) (_ : Algebra A R),
      Algebra.FinitePresentation A R ∧
      ∃ (c : R →ₐ[A] AdicCompletion I A)
        (W : (@IsFinite ⊓ @Etale : MorphismProperty Scheme.{u}).Over ⊤
          (pullback f (Spec.map (CommRingCat.ofHom (algebraMap A R)))))
        (k : pullback f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ⟶
          pullback f (Spec.map (CommRingCat.ofHom (algebraMap A R)))),
        k ≫ pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A R))) =
          pullback.fst f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧
        k ≫ pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap A R))) =
          pullback.snd f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ≫
            Spec.map (CommRingCat.ofHom
              ((AdicCompletion.evalOneₐ I).toRingHom.comp c.toRingHom)) ∧
        Nonempty (Over.mk (pullback.snd W.hom k) ≅ Over.mk V.hom) := by
  obtain ⟨U, j, hjfst, hjsnd, ⟨eU⟩⟩ := exists_finiteEtale_completion_lift I f V
  obtain ⟨R, hR, hAR, hfp, c, W, l, hlfst, hlsnd, ⟨eW⟩⟩ :=
    exists_finiteEtale_algebra_stage f U
  refine ⟨R, hR, hAR, hfp, c, W, j ≫ l, ?_, ?_, ?_⟩
  · rw [Category.assoc, hlfst, hjfst]
  · rw [Category.assoc, hlsnd, ← Category.assoc, hjsnd, Category.assoc,
      ← Spec.map_comp]
    rfl
  · exact ⟨(Over.pullbackComp j l).app (Over.mk W.hom) ≪≫
      (Over.pullback j).mapIso eW ≪≫ eU⟩

end AlgebraicGeometry.Scheme
