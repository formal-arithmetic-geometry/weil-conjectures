/-!
# Face-localized charts and logification of a split sharpening

Source: ILO, Exposé VI 1.1, 1.6, 3.7(a), printed pp. 69, 70, 75, and
Exposé VIII 3.1.1--3.1.2, printed p. 98
(blueprint: lem-trf-chart-face-localization-logification).

We use multiplicative notation for the commutative monoids: products denote the
node's sums, `1` denotes zero, and products of two monoids denote their direct sums.
The localization is the existing submonoid of the group completion. The sharpening
is its quotient by translations by the subgroup generated by the face, rather than
an unspecified isomorphic sharp monoid. Both pushout maps are pinned on representatives.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry

/-- The congruence on `R = Q_F` identifying elements differing by `U = F^gp`.
It is the kernel of the map from `R` to `Q^gp / U`, so its quotient is exactly `R/U`.
Source: ILO VIII 3.1.1--3.1.2, printed p. 98
(blueprint: lem-trf-chart-face-localization-logification). -/
def chartFaceQuotientCon {Q : Type u} [CommMonoid Q] (F : Submonoid Q) :
    Con (Algebra.faceLocalization Q F) :=
  Con.ker ((QuotientGroup.mk'
    (Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q)))).comp
      (Algebra.faceLocalization Q F).subtype)

/-- The pushout `R ⊕_U Aˣ`: for each `v ∈ U`, identify its representative `r ∈ R`
with the unit `a` whose value is `βR r`. In the theorem the extension of the chart
structural map supplies `βR`, and every element of `U` has such a unit image.
Source: ILO VI 1.1 and VIII 3.1.1--3.1.2, printed pp. 69, 98
(blueprint: lem-trf-chart-face-localization-logification). -/
def chartFacePushoutCon {Q A : Type u} [CommMonoid Q] [CommRing A]
    (F : Submonoid Q) (βR : Algebra.faceLocalization Q F →* A) :
    Con (Algebra.faceLocalization Q F × Aˣ) :=
  conGen (fun x y ↦ ∃ (r : Algebra.faceLocalization Q F) (a : Aˣ),
    r.val ∈ Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q)) ∧
      βR r = a.val ∧ x = (r, 1) ∧ y = (1, a))

private def faceChartIn {Q : Type u} [CommMonoid Q] (F : Submonoid Q) :
    Q →* Algebra.faceLocalization Q F where
  toFun q := ⟨Algebra.GrothendieckGroup.of q, q, 1, by simp⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' q r := Subtype.ext (map_mul _ q r)

private def faceChartLocalization {Q : Type u} [CommMonoid Q]
    (hi : Function.Injective (Algebra.GrothendieckGroup.of (M := Q)))
    (F : Submonoid Q) : F.LocalizationMap (Algebra.faceLocalization Q F) where
  toFun := faceChartIn F
  map_mul' := (faceChartIn F).map_mul
  isLocalizationMap :=
    { map_units := fun f ↦ by
        refine ⟨⟨faceChartIn F f.val,
          ⟨(Algebra.GrothendieckGroup.of f.val)⁻¹, 1, f, by simp⟩, ?_, ?_⟩, rfl⟩
        all_goals apply Subtype.ext; simp [faceChartIn]
      surj := fun r ↦ by
        obtain ⟨q, f, hf⟩ := r.property
        refine ⟨(q, f), Subtype.ext ?_⟩
        change r.val * Algebra.GrothendieckGroup.of f.val = Algebra.GrothendieckGroup.of q
        rw [hf]
        simp
      exists_of_eq := fun h ↦ by
        refine ⟨1, ?_⟩
        simpa using hi (congrArg Subtype.val h) }

private theorem quotientEquivOfKernel {M N : Type u} [CommMonoid M] [CommMonoid N]
    (C : Con M) (f : M →* N) (hs : Function.Surjective f) (hk : Con.ker f = C) :
    ∃ e : C.Quotient ≃* N, ∀ m, e (C.mk' m) = f m := by
  subst C
  exact ⟨Con.quotientKerEquivOfSurjective f hs, fun _ ↦ rfl⟩

private theorem faceUnitFraction {Q : Type u} [CommMonoid Q] (F : Submonoid Q)
    {x : Algebra.GrothendieckGroup Q}
    (hx : x ∈ Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q))) :
    ∃ f g : F, x = Algebra.GrothendieckGroup.of f.val *
      (Algebra.GrothendieckGroup.of g.val)⁻¹ := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨f, hf, rfl⟩ := hx
      exact ⟨⟨f, hf⟩, 1, by simp⟩
  | one => exact ⟨1, 1, by simp⟩
  | mul x y hx hy ihx ihy =>
      obtain ⟨f, g, rfl⟩ := ihx
      obtain ⟨f', g', rfl⟩ := ihy
      exact ⟨f * f', g * g', by simp [mul_assoc, mul_left_comm, mul_comm]⟩
  | inv x hx ih =>
      obtain ⟨f, g, rfl⟩ := ih
      exact ⟨g, f, by simp⟩

private def faceUnitIn {Q : Type u} [CommMonoid Q] (F : Submonoid Q) :
    Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q)) →*
      Algebra.faceLocalization Q F where
  toFun v := ⟨v.val, by
    obtain ⟨f, g, h⟩ := faceUnitFraction F v.property
    exact ⟨f.val, g, h⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

private theorem logUnits_unique {S : Scheme.{u}} (M : EtaleLogStructure S)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ S)
    (m : M.toEtalePrelogStructure.stalk t) (a : (strictLocalRing S t)ˣ)
    (ha : M.toEtalePrelogStructure.stalkAlpha t m = a.val) : m = M.unitsIn t a := by
  have hm : IsUnit m := M.reflectsUnits Ω t m (ha.symm ▸ a.isUnit)
  let e := MulEquiv.ofBijective (Units.map (M.toEtalePrelogStructure.stalkAlpha t))
    (M.unitsBijective Ω t)
  have hu : e hm.unit = a := Units.ext (by simpa [e, hm.unit_spec] using ha)
  have he : e.symm a = hm.unit := e.symm_apply_eq.mpr hu.symm
  change m = (e.symm a).val
  rw [he, hm.unit_spec]

private theorem faceChartPresentation {Q A L : Type u}
    [CommMonoid Q] [CommRing A] [CommMonoid L]
    (hi : Function.Injective (Algebra.GrothendieckGroup.of (M := Q)))
    (α : L →* A) (j : Aˣ →* L)
    (hj : ∀ m a, α m = a.val → m = j a)
    (g : Q →* L) (F : Submonoid Q) (hF : ∀ q, q ∈ F ↔ IsUnit (α (g q)))
    (hs : Function.Surjective (g.coprod j))
    (hk : Con.ker (g.coprod j) = divisorialChartCongruence (α.comp g).mrangeRestrict) :
    ∃ ell : Algebra.faceLocalization Q F →* L,
      ell.comp (faceChartIn F) = g ∧
      Function.Surjective (ell.coprod j) ∧
      Con.ker (ell.coprod j) = chartFacePushoutCon F (α.comp ell) := by
  classical
  let f := faceChartLocalization hi F
  have hg (v : F) : IsUnit (g v.val) := by
    obtain ⟨a, ha⟩ := (hF v.val).mp v.property
    rw [hj _ a ha.symm]
    exact (Group.isUnit a).map j
  let ell := f.lift hg
  have he : ell.comp (faceChartIn F) = g := f.lift_comp hg
  have heq (q : Q) : ell (faceChartIn F q) = g q := DFunLike.congr_fun he q
  let C := chartFacePushoutCon F (α.comp ell)
  let D := divisorialChartCongruence (α.comp g).mrangeRestrict
  have hC : C ≤ Con.ker (ell.coprod j) := by
    apply Con.conGen_le.mpr
    rintro x y ⟨r, a, hr, ha, rfl, rfl⟩
    change ell r * j 1 = ell 1 * j a
    simpa only [map_one, mul_one, one_mul] using hj (ell r) a ha
  obtain ⟨eB, heB⟩ := quotientEquivOfKernel D (g.coprod j) hs hk
  let iT : Q →* C.Quotient :=
    C.mk'.comp ((MonoidHom.inl _ _).comp (faceChartIn F))
  let jT : Aˣ →* C.Quotient := C.mk'.comp (MonoidHom.inr _ _)
  have hD : D ≤ Con.ker (iT.coprod jT) := by
    apply Con.conGen_le.mpr
    rintro x y ⟨q, a, ha, rfl, rfl⟩
    change iT q * jT 1 = iT 1 * jT a
    simp only [map_one, mul_one, one_mul]
    change C.mk' (faceChartIn F q, 1) = C.mk' (1, a)
    apply (Con.eq C).mpr
    apply Con.le_conGen
    refine ⟨faceChartIn F q, a, ?_, ?_, rfl, rfl⟩
    · apply Subgroup.subset_closure
      exact ⟨q, (hF q).mpr ((show α (g q) = a.val from ha).symm ▸ a.isUnit), rfl⟩
    · change α (ell (faceChartIn F q)) = a.val
      rw [heq]
      exact ha
  let k : D.Quotient →* C.Quotient := D.lift (iT.coprod jT) hD
  let d : L →* C.Quotient := k.comp eB.symm.toMonoidHom
  have hdg (q : Q) : d (g q) = C.mk' (faceChartIn F q, 1) := by
    have hh := heB (q, 1)
    simp only [MonoidHom.coprod_apply, map_one, mul_one] at hh
    change k (eB.symm (g q)) = _
    rw [← hh, eB.symm_apply_apply]
    change iT q * jT 1 = _
    simp only [map_one, mul_one]
    rfl
  have hdj (a : Aˣ) : d (j a) = C.mk' (1, a) := by
    have hh := heB (1, a)
    simp only [MonoidHom.coprod_apply, map_one, one_mul] at hh
    change k (eB.symm (j a)) = _
    rw [← hh, eB.symm_apply_apply]
    change iT 1 * jT a = _
    simp only [map_one, one_mul]
    rfl
  have hdell : d.comp ell = C.mk'.comp (MonoidHom.inl _ _) := by
    apply f.epic_of_localizationMap
    ext q
    exact (congrArg d (heq q)).trans (hdg q)
  have hd (r : Algebra.faceLocalization Q F) (a : Aˣ) :
      d (ell r * j a) = C.mk' (r, a) := by
    have hdr : d (ell r) = C.mk' (r, 1) := DFunLike.congr_fun hdell r
    rw [map_mul, hdr, hdj]
    change C.mk' (r, 1) * C.mk' (1, a) = _
    rw [← map_mul]
    simp
  refine ⟨ell, he, ?_, le_antisymm ?_ hC⟩
  · intro m
    obtain ⟨⟨q, a⟩, ha⟩ := hs m
    refine ⟨(faceChartIn F q, a), ?_⟩
    change ell (faceChartIn F q) * j a = m
    rw [heq]
    exact ha
  · rintro ⟨r, a⟩ ⟨r', a'⟩ h
    apply (Con.eq C).mp
    exact (hd r a).symm.trans ((congrArg d h).trans (hd r' a'))

private theorem faceChartCharacteristic {Q A L : Type u}
    [CommMonoid Q] [CommRing A] [CommMonoid L]
    (hi : Function.Injective (Algebra.GrothendieckGroup.of (M := Q)))
    (α : L →* A) (j : Aˣ →* L)
    (hj : ∀ m a, α m = a.val → m = j a)
    (g : Q →* L) (F : Submonoid Q) (hF : ∀ q, q ∈ F ↔ IsUnit (α (g q)))
    (hs : Function.Surjective (g.coprod j))
    (hk : Con.ker (g.coprod j) = divisorialChartCongruence (α.comp g).mrangeRestrict)
    (ell : Algebra.faceLocalization Q F →* L) (he : ell.comp (faceChartIn F) = g) :
    ∃ ι : (chartFaceQuotientCon F).Quotient ≃* Associates L,
      ∀ r, ι ((chartFaceQuotientCon F).mk' r) = Associates.mk (ell r) := by
  classical
  let P := (chartFaceQuotientCon F).Quotient
  let π := (chartFaceQuotientCon F).mk'
  let D := divisorialChartCongruence (α.comp g).mrangeRestrict
  obtain ⟨eB, heB⟩ := quotientEquivOfKernel D (g.coprod j) hs hk
  let iP : Q →* P := π.comp (faceChartIn F)
  have hiP (q : Q) (hq : q ∈ F) : iP q = 1 := by
    rw [← map_one π]
    apply (Con.eq _).mpr
    change QuotientGroup.mk' _ (Algebra.GrothendieckGroup.of q) =
      QuotientGroup.mk' _ 1
    rw [map_one]
    exact (QuotientGroup.eq_one_iff (Algebra.GrothendieckGroup.of q)).mpr
      (Subgroup.subset_closure ⟨q, hq, rfl⟩)
  have hD : D ≤ Con.ker (iP.coprod (1 : Aˣ →* P)) := by
    apply Con.conGen_le.mpr
    rintro x y ⟨q, a, ha, rfl, rfl⟩
    change iP q * 1 = iP 1 * 1
    rw [mul_one, map_one, one_mul]
    exact hiP q ((hF q).mpr ((show α (g q) = a.val from ha).symm ▸ a.isUnit))
  let k := D.lift (iP.coprod (1 : Aˣ →* P)) hD
  let d : L →* P := k.comp eB.symm.toMonoidHom
  have hdg (q : Q) : d (g q) = iP q := by
    have hh := heB (q, 1)
    simp only [MonoidHom.coprod_apply, map_one, mul_one] at hh
    change k (eB.symm (g q)) = _
    rw [← hh, eB.symm_apply_apply]
    change iP q * 1 = _
    rw [mul_one]
  have hdj (a : Aˣ) : d (j a) = 1 := by
    have hh := heB (1, a)
    simp only [MonoidHom.coprod_apply, map_one, one_mul] at hh
    change k (eB.symm (j a)) = _
    rw [← hh, eB.symm_apply_apply]
    change iP 1 * 1 = _
    rw [map_one, one_mul]
  have hdell : d.comp ell = π := by
    apply (faceChartLocalization hi F).epic_of_localizationMap
    ext q
    exact (congrArg d (DFunLike.congr_fun he q)).trans (hdg q)
  have hdu (v : Lˣ) : d v.val = 1 := by
    rw [hj v.val (Units.map α v) rfl]
    exact hdj _
  let b : Algebra.faceLocalization Q F →* Associates L := Associates.mkMonoidHom.comp ell
  have hb : Con.ker b = chartFaceQuotientCon F := by
    ext r r'
    constructor
    · intro h
      obtain ⟨v, hv⟩ := Associates.mk_eq_mk_iff_associated.mp h
      have hdv := congrArg d hv
      rw [map_mul, hdu, mul_one] at hdv
      have hπ : π r = π r' := (DFunLike.congr_fun hdell r).symm.trans
        (hdv.trans (DFunLike.congr_fun hdell r'))
      exact (Con.eq _).mp hπ
    · intro h
      obtain ⟨v, hv, hh⟩ := (QuotientGroup.mk'_eq_mk' _).mp h
      let vR := faceUnitIn F (⟨v, hv⟩ : Subgroup.closure
        (Algebra.GrothendieckGroup.of '' (F : Set Q)))
      have hr : r * vR = r' := Subtype.ext hh
      have hu : IsUnit (ell vR) :=
        (Group.isUnit (⟨v, hv⟩ : Subgroup.closure
          (Algebra.GrothendieckGroup.of '' (F : Set Q)))).map
            (ell.comp (faceUnitIn F))
      apply Associates.mk_eq_mk_iff_associated.mpr
      refine ⟨hu.unit, ?_⟩
      rw [hu.unit_spec, ← map_mul, hr]
  have hbs : Function.Surjective b := by
    intro z
    obtain ⟨m, rfl⟩ := Associates.mk_surjective z
    obtain ⟨⟨q, a⟩, hm⟩ := hs m
    refine ⟨faceChartIn F q, ?_⟩
    change Associates.mk (ell (faceChartIn F q)) = Associates.mk m
    rw [show ell (faceChartIn F q) = g q from DFunLike.congr_fun he q, ← hm]
    apply Associates.mk_eq_mk_iff_associated.mpr
    exact ⟨((Group.isUnit a).map j).unit, by rw [IsUnit.unit_spec]; rfl⟩
  exact quotientEquivOfKernel _ b hbs hb

private theorem faceChartSplit {Q A L : Type u}
    [CommMonoid Q] [CommRing A] [CommMonoid L]
    (F : Submonoid Q) (α : L →* A) (j : Aˣ →* L)
    (ell : Algebra.faceLocalization Q F →* L)
    (eT : (chartFacePushoutCon F (α.comp ell)).Quotient ≃* L)
    (heT : ∀ r a, eT ((chartFacePushoutCon F (α.comp ell)).mk' (r, a)) = ell r * j a)
    (s : (chartFaceQuotientCon F).Quotient →* Algebra.faceLocalization Q F)
    (eSplit : ((chartFaceQuotientCon F).Quotient ×
      Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q))) ≃*
        Algebra.faceLocalization Q F)
    (heSplit : ∀ p v, (eSplit (p, v)).val = (s p).val * v.val) :
    ∃ e : ((chartFaceQuotientCon F).Quotient × Aˣ) ≃* L,
      ∀ p a, e (p, a) = ell (s p) * j a := by
  let C := chartFacePushoutCon F (α.comp ell)
  let P := (chartFaceQuotientCon F).Quotient
  let U := Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q))
  let bU : U →* Aˣ := (α.comp (ell.comp (faceUnitIn F))).toHomUnits
  have hsplit (p : P) (v : U) : eSplit (p, v) = s p * faceUnitIn F v :=
    Subtype.ext (heSplit p v)
  have hs (p : P) : eSplit.symm (s p) = (p, 1) := by
    apply eSplit.injective
    rw [eSplit.apply_symm_apply, hsplit]
    simp
  have hv (v : U) : eSplit.symm (faceUnitIn F v) = (1, v) := by
    apply eSplit.injective
    rw [eSplit.apply_symm_apply, hsplit]
    simp
  let H : (Algebra.faceLocalization Q F × Aˣ) →* (P × Aˣ) :=
    { toFun := fun z ↦ ((eSplit.symm z.1).1, bU (eSplit.symm z.1).2 * z.2)
      map_one' := by
        change ((eSplit.symm 1).1, bU (eSplit.symm 1).2 * 1) = (1, 1)
        rw [map_one]
        simp
      map_mul' := fun x y ↦ by
        apply Prod.ext
        · change (eSplit.symm (x.1 * y.1)).1 =
            (eSplit.symm x.1).1 * (eSplit.symm y.1).1
          exact congrArg (fun z : P × U ↦ z.1) (map_mul eSplit.symm x.1 y.1)
        · change bU (eSplit.symm (x.1 * y.1)).2 * (x.2 * y.2) =
            (bU (eSplit.symm x.1).2 * x.2) * (bU (eSplit.symm y.1).2 * y.2)
          rw [map_mul eSplit.symm]
          change bU ((eSplit.symm x.1).2 * (eSplit.symm y.1).2) * (x.2 * y.2) = _
          rw [map_mul bU]
          ac_rfl }
  have hH : C ≤ Con.ker H := by
    apply Con.conGen_le.mpr
    rintro x y ⟨r, a, hr, ha, rfl, rfl⟩
    let v : U := ⟨r.val, hr⟩
    have hrv : faceUnitIn F v = r := rfl
    have hb : bU v = a := Units.ext ha
    change ((eSplit.symm r).1, bU (eSplit.symm r).2 * 1) =
      ((eSplit.symm 1).1, bU (eSplit.symm 1).2 * a)
    rw [← hrv, hv, hb, map_one]
    simp
  let J : C.Quotient →* (P × Aˣ) := C.lift H hH
  let I : (P × Aˣ) →* C.Quotient := C.mk'.comp (s.prodMap (MonoidHom.id Aˣ))
  have hJI : Function.LeftInverse J I := by
    rintro ⟨p, a⟩
    change H (s p, a) = (p, a)
    change ((eSplit.symm (s p)).1, bU (eSplit.symm (s p)).2 * a) = _
    rw [hs]
    simp
  have hIJ : Function.RightInverse J I := by
    intro z
    induction z using Con.induction_on with
    | H z =>
      rcases z with ⟨r, a⟩
      let p : P := (eSplit.symm r).1
      let v : U := (eSplit.symm r).2
      have hr : s p * faceUnitIn F v = r := by
        rw [← hsplit]
        exact eSplit.apply_symm_apply r
      have hc : C.mk' (faceUnitIn F v, 1) = C.mk' (1, bU v) := by
        apply (Con.eq C).mpr
        apply Con.le_conGen
        exact ⟨faceUnitIn F v, bU v, v.property, rfl, rfl, rfl⟩
      have hh := congrArg (fun z ↦ C.mk' (s p, a) * z) hc
      simp only [← map_mul, Prod.mk_mul_mk, mul_one] at hh
      rw [hr] at hh
      change C.mk' (s p, bU v * a) = C.mk' (r, a)
      simpa only [mul_comm] using hh.symm
  let eI : (P × Aˣ) ≃* C.Quotient :=
    MulEquiv.ofBijective I ⟨hJI.injective, hIJ.surjective⟩
  exact ⟨eI.trans eT, fun p a ↦ heT (s p) a⟩

/-- A chart localizes at its unit face, identifies its localized pushout and
characteristic, and any specified split sharpening gives the prescribed sharp
logification. The equalities naming `β` and `F` are the node's definitions of these
objects; they impose no additional condition on the given chart.
Source: ILO VI 1.1, 1.6, 3.7(a), printed pp. 69, 70, 75, and
VIII 3.1.1--3.1.2, printed p. 98
(blueprint: lem-trf-chart-face-localization-logification).

Proof (the agent calculation of the node).
1. Products mapping to ring units have both factors mapping to units, so `F` is a
face. The log axiom identifies each log element mapping to a specified ring unit
with its canonical image under `unitsIn`. The stalk-chart hypothesis itself gives
surjectivity and the precise kernel of `Q × Aˣ → L`.
2. The inclusion `Q → R` is an `F.LocalizationMap`: face elements become units,
every element is a fraction, and injectivity into the group completion controls
equality. Its universal property extends the chart germ uniquely to `ell`.
3. Let `B` be the original chart pushout and `T` the localized one. The map
`[q,a] ↦ [q,a]` descends from `B` to `T`. Composing with the inverse chart
isomorphism defines `d:L → T`. The localization epimorphism property forces
`d(ell(r))=[r,1]`, while `d(j(a))=[1,a]`. Thus `d` inverts the prescribed map
`[r,a] ↦ ell(r)j(a)`, proving the localized pushout isomorphism.
4. The map `Q → R/U` kills the unit face and descends through `B` to `L → R/U`.
It kills every log unit and its composite with `ell` is the quotient map, again
by localization uniqueness. Conversely elements of `U` are units of `R`, so
`r,r'` have the same class in `R/U` exactly when `ell(r),ell(r')` are associated.
Surjectivity follows from the chart. The first isomorphism theorem gives `ι`.
5. The formula for `ι` and the section identity give `[ell(s(p))]=ι(p)`. Unit
reflection and injectivity of `ι` show that its structural image is a unit iff `p=1`.
6. Write `r=s(p)v` using the given splitting. The maps `[r,a] ↦ (p,βR(v)a)`
and `(p,a) ↦ [s(p),a]` respect the pushout relation and are inverse. Composing
with step 3 gives the prescribed product isomorphism.
7. By step 5 each generator of the associated-log congruence for `α ell s` has
`p=1`, and its structural equation then forces the unit to be `1`. The product
isomorphism therefore descends to the pinned associated-log isomorphism. Its
characteristic map is the formula already proved in step 5.
-/
theorem chart_face_localization_logification
    (X : FineSaturatedLogScheme.{u})
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme)
    (W : X.scheme.Etale) (w : (Scheme.pointSmallEtale t).fiber.obj W)
    (Q : Type u) [CommMonoid Q] (hQ : IsFineSaturatedMonoid Q)
    (c : Q →* X.logStructure.monoidSheaf.obj.obj (op W))
    (hc : X.logStructure.IsChart W c)
    (β : Q →* strictLocalRing X.scheme t)
    (hβ : β = (X.logStructure.toEtalePrelogStructure.stalkAlpha t).comp
      ((X.logStructure.toEtalePrelogStructure.germ t W w).hom.comp c))
    (F : Submonoid Q) (hF : F = (IsUnit.submonoid (strictLocalRing X.scheme t)).comap β) :
    (∀ a b : Q, a * b ∈ F → a ∈ F ∧ b ∈ F) ∧
    ∃ ell : Algebra.faceLocalization Q F →* X.logStructure.toEtalePrelogStructure.stalk t,
      (∀ (q : Q) (r : Algebra.faceLocalization Q F),
        r.val = Algebra.GrothendieckGroup.of q →
          ell r = X.logStructure.toEtalePrelogStructure.germ t W w (c q)) ∧
      (∀ μ : Algebra.faceLocalization Q F →* X.logStructure.toEtalePrelogStructure.stalk t,
        (∀ (q : Q) (r : Algebra.faceLocalization Q F),
          r.val = Algebra.GrothendieckGroup.of q →
            μ r = X.logStructure.toEtalePrelogStructure.germ t W w (c q)) → μ = ell) ∧
      (∃ e : (chartFacePushoutCon F
          ((X.logStructure.toEtalePrelogStructure.stalkAlpha t).comp ell)).Quotient ≃*
          X.logStructure.toEtalePrelogStructure.stalk t,
        ∀ (r : Algebra.faceLocalization Q F) (a : (strictLocalRing X.scheme t)ˣ),
          e ((chartFacePushoutCon F
            ((X.logStructure.toEtalePrelogStructure.stalkAlpha t).comp ell)).mk' (r, a)) =
              ell r * X.logStructure.unitsIn t a) ∧
      ∃ ι : (chartFaceQuotientCon F).Quotient ≃* X.logStructure.characteristic t,
        (∀ r : Algebra.faceLocalization Q F,
          ι ((chartFaceQuotientCon F).mk' r) = Associates.mk (ell r)) ∧
        ∀ (s : (chartFaceQuotientCon F).Quotient →* Algebra.faceLocalization Q F),
          (∀ p, (chartFaceQuotientCon F).mk' (s p) = p) →
          ∀ eSplit : ((chartFaceQuotientCon F).Quotient ×
            Subgroup.closure (Algebra.GrothendieckGroup.of '' (F : Set Q))) ≃*
              Algebra.faceLocalization Q F,
            (∀ p v, (eSplit (p, v)).val = (s p).val * v.val) →
            (∀ p, IsUnit (X.logStructure.toEtalePrelogStructure.stalkAlpha t (ell (s p))) ↔
              p = 1) ∧
            (∃ e : ((chartFaceQuotientCon F).Quotient ×
                (strictLocalRing X.scheme t)ˣ) ≃*
                  X.logStructure.toEtalePrelogStructure.stalk t,
              ∀ p a, e (p, a) = ell (s p) * X.logStructure.unitsIn t a) ∧
            (∃ e : divisorialChartPushout
                ((X.logStructure.toEtalePrelogStructure.stalkAlpha t).comp
                  (ell.comp s)).mrangeRestrict ≅ X.logStructure.toEtalePrelogStructure.stalk t,
              ∀ p a, e.hom ((divisorialChartCongruence
                ((X.logStructure.toEtalePrelogStructure.stalkAlpha t).comp
                  (ell.comp s)).mrangeRestrict).mk' (p, a)) =
                    ell (s p) * X.logStructure.unitsIn t a) ∧
            ∀ p, Associates.mk (ell (s p)) = ι p := by
  let M := X.logStructure
  let α := M.toEtalePrelogStructure.stalkAlpha t
  let j := M.unitsIn t
  let g := (M.toEtalePrelogStructure.germ t W w).hom.comp c
  have hFg (q : Q) : q ∈ F ↔ IsUnit (α (g q)) := by
    rw [hF, hβ]
    rfl
  have hj (m : M.toEtalePrelogStructure.stalk t) (a : (strictLocalRing X.scheme t)ˣ)
      (ha : α m = a.val) : m = j a := logUnits_unique M t m a ha
  obtain ⟨hs, hk⟩ := hc Ω t w
  have hface : ∀ a b : Q, a * b ∈ F → a ∈ F ∧ b ∈ F := by
    intro a b hab
    have hu := (hFg (a * b)).mp hab
    rw [map_mul, map_mul, IsUnit.mul_iff] at hu
    exact ⟨(hFg a).mpr hu.1, (hFg b).mpr hu.2⟩
  obtain ⟨ell, he, hsurj, hker⟩ :=
    faceChartPresentation hQ.2.1 α j hj g F hFg hs hk
  have hext (q : Q) (r : Algebra.faceLocalization Q F)
      (hr : r.val = Algebra.GrothendieckGroup.of q) :
      ell r = M.toEtalePrelogStructure.germ t W w (c q) := by
    have hri : r = faceChartIn F q := Subtype.ext hr
    rw [hri]
    exact DFunLike.congr_fun he q
  have huniq (μ : Algebra.faceLocalization Q F →* M.toEtalePrelogStructure.stalk t)
      (hμ : ∀ (q : Q) (r : Algebra.faceLocalization Q F),
        r.val = Algebra.GrothendieckGroup.of q →
          μ r = M.toEtalePrelogStructure.germ t W w (c q)) : μ = ell := by
    apply (faceChartLocalization hQ.2.1 F).epic_of_localizationMap
    ext q
    exact (hμ q (faceChartIn F q) rfl).trans (DFunLike.congr_fun he q).symm
  obtain ⟨eT, heT⟩ := quotientEquivOfKernel _ (ell.coprod j) hsurj hker
  obtain ⟨ι, hι⟩ := faceChartCharacteristic hQ.2.1 α j hj g F hFg hs hk ell he
  refine ⟨hface, ell, hext, huniq, ⟨eT, fun r a ↦ heT (r, a)⟩, ι, hι, ?_⟩
  intro s hsec eSplit heSplit
  have hchar (p : (chartFaceQuotientCon F).Quotient) :
      Associates.mk (ell (s p)) = ι p := by
    rw [← hι, hsec]
  have hunit (p : (chartFaceQuotientCon F).Quotient) :
      IsUnit (α (ell (s p))) ↔ p = 1 := by
    constructor
    · intro hp
      have hm := M.reflectsUnits Ω t (ell (s p)) hp
      apply ι.injective
      rw [← hchar, map_one]
      exact Associates.mk_eq_one.mpr hm
    · rintro rfl
      simp
  obtain ⟨e, heprod⟩ := faceChartSplit F α j ell eT (fun r a ↦ heT (r, a))
    s eSplit heSplit
  refine ⟨hunit, ⟨e, heprod⟩, ?_, hchar⟩
  let h := ell.comp s
  let D := divisorialChartCongruence (α.comp h).mrangeRestrict
  have hemap : h.coprod j = e.toMonoidHom := by
    ext z
    exact (heprod z.1 z.2).symm
  have hdk : Con.ker (h.coprod j) = D := by
    apply le_antisymm
    · intro x y hxy
      have heq : (h.coprod j) x = (h.coprod j) y := hxy
      rw [hemap] at heq
      have hxy' : x = y := e.injective heq
      subst y
      exact D.refl x
    · apply Con.conGen_le.mpr
      rintro x y ⟨p, a, ha, rfl, rfl⟩
      change α (ell (s p)) = a.val at ha
      have hp : p = 1 := (hunit p).mp (ha.symm ▸ a.isUnit)
      subst p
      have ha' : a = 1 := Units.ext (by simpa using ha.symm)
      subst a
      exact (Con.ker (h.coprod j)).refl _
  have hds : Function.Surjective (h.coprod j) := by
    rw [hemap]
    exact e.surjective
  obtain ⟨eD, heD⟩ := quotientEquivOfKernel D (h.coprod j) hds hdk
  exact ⟨eD.toCommMonCatIso, fun p a ↦ heD (p, a)⟩

end AlgebraicGeometry
