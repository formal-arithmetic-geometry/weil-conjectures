module

public import Sheaf.AlgebraicGeometry.IsRegularScheme
public import Sheaf.AlgebraicGeometry.StrictNormalCrossingsBoundary
public import Mathlib.AlgebraicGeometry.Properties
public import Mathlib.RingTheory.Ideal.Quotient.Defs
import Mathlib.Algebra.Regular.Pow

/-!
# Nonzerodivisor equations for strict normal crossings branches

Source: Stacks Project, etale.tex, Tags 0BI9 and 0BIA; divisors.tex,
lemma-characterize-effective-Cartier-divisor; ILO VIII, Remark 4.2.2(i), printed p. 118
(blueprint: lem-sfb-snc-branch-equation-nonzerodivisor).

The reduced closed subschemes defined by the equations are specified by reducedness of
`A / (t i)` and equality of their supports with the irreducible components of the boundary.
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace AlgebraicGeometry

private theorem mul_injective_of_zeroLocus_subset_support
    (X : Scheme.{u}) (H : X.IdealSheafData) (hH : H.IsInvertible)
    (s : Γ(X, ⊤)) (hs : X.zeroLocus {s} ⊆ H.support) :
    Function.Injective (fun a : Γ(X, ⊤) ↦ s * a) := by
  intro a b hab
  apply X.IsSheaf.section_ext
  intro x hx
  obtain ⟨U, hxU, g, hg, hgen⟩ := hH x
  let ρ := (X.presheaf.map (CategoryTheory.homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom
  have hzero : PrimeSpectrum.zeroLocus ({ρ s} : Set Γ(X, U.1)) ⊆
      PrimeSpectrum.zeroLocus {g} := by
    intro p hp
    have hyU : U.2.fromSpec p ∈ U.1 := by
      rw [← SetLike.mem_coe, ← U.2.range_fromSpec]
      exact Set.mem_range_self p
    have hy : U.2.fromSpec p ∈ X.zeroLocus {ρ s} := by
      rwa [← U.2.fromSpec_preimage_zeroLocus {ρ s}] at hp
    have hys : U.2.fromSpec p ∈ X.zeroLocus {s} := by
      have he := X.zeroLocus_map (show U.1 ≤ ⊤ from le_top) {s}
      simp only [Set.image_singleton] at he
      rw [he] at hy
      exact hy.resolve_right (by simpa using hyU)
    have hyH := (H.mem_support_iff_of_mem hyU).mp (hs hys)
    have hyg : U.2.fromSpec p ∈ X.zeroLocus {g} := by
      rw [hgen, X.zeroLocus_span] at hyH
      exact hyH
    rwa [← U.2.fromSpec_preimage_zeroLocus {g}]
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp
    ((PrimeSpectrum.zeroLocus_subset_zeroLocus_singleton_iff (ρ s) g).mp hzero)
  have hgn : g ^ n ∈ nonZeroDivisors Γ(X, U.1) := pow_mem hg n
  have hsreg : ρ s ∈ nonZeroDivisors Γ(X, U.1) := by
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hn
    rw [← hc] at hgn
    exact (mul_mem_nonZeroDivisors.mp hgn).2
  have habU : ρ a = ρ b := by
    apply (isRegular_iff_mem_nonZeroDivisors.mpr hsreg).left
    simpa only [map_mul] using congrArg ρ hab
  exact ⟨U.1, le_top, hxU, habU⟩

/-- Each equation of a reduced irreducible branch of a strict normal crossings boundary
on a regular affine scheme acts injectively on the coordinate ring, as does their product.
The equations list all branches without repetitions. The quotient-reducedness condition
specifies the reduced closed subscheme structure, rather than only its underlying support.
The zero ring and the empty family of equations are allowed.

Source: Stacks Project, Tags 0BI9 and 0BIA; divisors.tex,
lemma-characterize-effective-Cartier-divisor; ILO VIII, Remark 4.2.2(i)
(blueprint: lem-sfb-snc-branch-equation-nonzerodivisor).

Proof (using only the effective Cartier clause of the SNC hypothesis):
1. Each branch support V(t_i) lies in the support of H. Near every point choose an
   affine Cartier chart on which the ideal of H is generated by a nonzerodivisor g.
2. For the restricted branch equation s, the support inclusion says V(s) ⊆ V(g).
   Thus g belongs to the radical of (s), so g^n = c*s. Since g^n is a nonzerodivisor,
   its factor s is a nonzerodivisor as well.
3. Cancel on these charts. Equality of all germs gives equality of global sections;
   transport through A ≃ Γ(Spec A, O) gives injectivity on A.
4. Products of nonzerodivisors are nonzerodivisors, including the empty product 1.
   Every step allows the zero ring. -/
theorem sncBranchEquation_mul_injective
    (A : Type u) [CommRing A] (hA : IsRegularScheme (Spec (.of A)))
    (r : ℕ) (t : Fin r → A) (H : (Spec (.of A)).IdealSheafData)
    (hH : IsStrictNormalCrossingsBoundary H)
    (hreduced : ∀ i : Fin r, _root_.IsReduced (A ⧸ Ideal.span ({t i} : Set A)))
    (hdistinct : Function.Injective
      (fun i : Fin r ↦ PrimeSpectrum.zeroLocus ({t i} : Set A)))
    (hbranches : Set.range (fun i : Fin r ↦ PrimeSpectrum.zeroLocus ({t i} : Set A)) =
      Set.image (Set.image Subtype.val) (irreducibleComponents (H.support : Set (Spec (.of A))))) :
    (∀ i : Fin r, Function.Injective (fun a : A ↦ t i * a)) ∧
      Function.Injective (fun a : A ↦ (∏ i : Fin r, t i) * a) := by
  classical
  have _regularity := hA
  have _reducedBranches := hreduced
  have _distinctBranches := hdistinct
  let e := (Scheme.ΓSpecIso (.of A)).inv.hom
  have heinj : Function.Injective e :=
    (CategoryTheory.ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of A)).inv).1
  have hsingle (i : Fin r) : Function.Injective (fun a : A ↦ t i * a) := by
    have hsupport : PrimeSpectrum.zeroLocus ({t i} : Set A) ⊆ (H.support : Set (Spec (.of A))) := by
      have hi : PrimeSpectrum.zeroLocus ({t i} : Set A) ∈
          Set.image (Set.image Subtype.val)
            (irreducibleComponents (H.support : Set (Spec (.of A)))) := by
        rw [← hbranches]
        exact Set.mem_range_self i
      obtain ⟨C, hC, hCi⟩ := hi
      rw [← hCi]
      exact Set.image_subset_iff.mpr fun y _ ↦ y.property
    have he : Function.Injective (fun a : Γ(Spec (.of A), ⊤) ↦ e (t i) * a) :=
      mul_injective_of_zeroLocus_subset_support _ H hH.1 (e (t i)) (by
        change (Spec (.of A)).zeroLocus {(Scheme.ΓSpecIso (.of A)).inv (t i)} ⊆ _
        rw [← Set.image_singleton, Spec_zeroLocus_eq_zeroLocus]
        exact hsupport)
    intro a b hab
    apply heinj
    apply he
    simpa only [map_mul] using congrArg e hab
  refine ⟨hsingle, ?_⟩
  exact IsLeftRegular.prod (s := Finset.univ) (f := t) fun i _ ↦ hsingle i

end AlgebraicGeometry
