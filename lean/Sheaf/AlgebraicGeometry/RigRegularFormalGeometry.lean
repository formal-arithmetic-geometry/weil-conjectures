/-! # Noetherian adic formal geometry

Source: Temkin, Non-embedded Desingularization, §§2.4 and 3.1.1–3.1.4
(blueprint: def-per-rig-regular-formal-pair-geometry).

Formal spectra and completion use the existing ringed-space colimit constructions.
Ideals are given by their stalk ideals; the local finite-generation condition makes these
families coherent ideal sheaves. No algebraization of a global formal scheme is assumed.
-/

@[expose] public section
set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

/-- Stalkwise ideals, with sheaf coherence imposed by `IsCoherent` below.
Source: Temkin §2.4.2 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def FormalIdeal (X : RingedSpace.{u, u}) := ∀ x : X, Ideal (X.presheaf.stalk x)

/-- Extension of stalk ideals along a morphism of ringed spaces.
Source: Temkin §§2.4.2, 2.4.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
noncomputable def FormalIdeal.comap {X Y : RingedSpace.{u, u}}
    (I : FormalIdeal Y) (f : X ⟶ Y) : FormalIdeal X :=
  fun x ↦ Ideal.map (f.hom.stalkMap x).hom (I (f.hom.base x))

/-- A stalk-ideal family is coherent if locally it is generated by finitely many sections.
On a Noetherian formal scheme this is precisely a coherent ideal sheaf.
Source: Temkin §2.4.2 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def FormalIdeal.IsCoherent {X : RingedSpace.{u, u}} (I : FormalIdeal X) : Prop :=
  ∀ x : X, ∃ (U : Opens X) (_hx : x ∈ U) (n : ℕ)
    (s : Fin n → X.presheaf.obj (op U)),
    ∀ (y : X) (hy : y ∈ U),
      I y = Ideal.span (Set.range (fun i ↦ X.presheaf.germ U y hy (s i)))

/-- An invertible ideal is locally generated by a non-zero-divisor.
Source: Temkin §3.1.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def FormalIdeal.IsInvertible {X : RingedSpace.{u, u}} (I : FormalIdeal X) : Prop :=
  ∀ x : X, ∃ (U : Opens X) (_hx : x ∈ U) (s : X.presheaf.obj (op U)),
    ∀ (y : X) (hy : y ∈ U),
      I y = Ideal.span {X.presheaf.germ U y hy s} ∧
      X.presheaf.germ U y hy s ∈ nonZeroDivisors (X.presheaf.stalk y)

/-- Stalk ideals of the existing quasi-coherent ideal of a scheme.
Source: Temkin §2.4.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
noncomputable def Scheme.IdealSheafData.formalStalks {X : Scheme.{u}}
    (I : X.IdealSheafData) : FormalIdeal X.toRingedSpace :=
  fun x ↦ Ideal.span {r | ∃ (U : X.affineOpens) (hx : x ∈ U.1)
    (s : Γ(X, U.1)), s ∈ I.ideal U ∧ X.presheaf.germ U.1 x hx s = r}

/-- Extension of the ideal to the completion.
Source: Temkin §2.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
noncomputable def completedFormalIdeal (X : Scheme.{u}) (I J : X.IdealSheafData) :
    FormalIdeal ((AdicFormalCompletion.mk X I).space) :=
  J.formalStalks.comap ((AdicFormalCompletion.mk X I).toScheme)

/-- The scheme ideal on `Spec B` corresponding to an ideal in `B`.
Source: Temkin §2.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
noncomputable def affineFormalIdeal (B : CommRingCat.{u}) (I : Ideal B) :
    (Spec B).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso B).inv.hom)

/-- The canonical map from a formal spectrum to the ordinary spectrum.
Source: Temkin §2.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
noncomputable def formalSpectrumMap (B : CommRingCat.{u}) (I : Ideal B) :
    AdicFormalCompletion.formalSpectrum B I ⟶ (Spec B).toRingedSpace :=
  (AdicFormalCompletion.mk (Spec B) (affineFormalIdeal B I)).toScheme

/-- A complete Noetherian formal affine chart, including its ideal of definition.
The chart is an open immersion, so no chosen atlas limits later refinements.
Source: Temkin §2.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
structure FormalAffineChart (X : RingedSpace.{u, u}) (I : FormalIdeal X) where
  ring : CommRingCat.{u}
  ideal : Ideal ring
  noetherian : IsNoetherianRing ring
  complete : IsAdicComplete ideal ring
  map : AdicFormalCompletion.formalSpectrum ring ideal ⟶ X
  openImmersion : SheafedSpace.IsOpenImmersion map
  ideal_eq : I.comap map = completedFormalIdeal (Spec ring)
    (affineFormalIdeal ring ideal) (affineFormalIdeal ring ideal)

/-- A Noetherian adic formal scheme with its distinguished ideal of definition.
The finite atlas includes the empty atlas for the empty space.
Source: Temkin §§2.4, 3.1.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
structure NoetherianAdicFormalScheme where
  space : RingedSpace.{u, u}
  ideal : FormalIdeal space
  coherent : ideal.IsCoherent
  noetherian : IsNoetherianAdicFormalScheme space
  idealDefinition : ∀ x : space, ∃ (c : FormalAffineChart space ideal)
    (y : AdicFormalCompletion.formalSpectrum c.ring c.ideal), c.map.hom.base y = x

/-- Regularity is regularity of every complete formal affine chart ring.
Source: Temkin §§2.4.9–2.4.10 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def NoetherianAdicFormalScheme.IsRegular (X : NoetherianAdicFormalScheme.{u}) : Prop :=
  ∀ c : FormalAffineChart X.space X.ideal, IsRegularRing c.ring

/-- The singular locus on formal points, using ordinary local rings of affine charts.
Source: Temkin §2.4.9 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def NoetherianAdicFormalScheme.singularLocus (X : NoetherianAdicFormalScheme.{u}) :
    Set X.space :=
  {x | ∃ (c : FormalAffineChart X.space X.ideal)
    (y : AdicFormalCompletion.formalSpectrum c.ring c.ideal),
    c.map.hom.base y = x ∧ ¬ IsRegularLocalRing
      ((Spec c.ring).presheaf.stalk ((formalSpectrumMap c.ring c.ideal).hom.base y))}

/-- A component has a reduced closed fibre of finite type over a characteristic-zero
field. The quotient is specified by its surjective stalk maps and radical kernel;
it is not an arbitrarily supplied scheme unrelated to the formal object.
Source: Temkin §3.1.1 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def HasFormalVarietyClosedFibre (X : RingedSpace.{u, u}) (I : FormalIdeal X) : Prop :=
  ∃ (Z : Scheme.{u}) (i : Z.toRingedSpace ⟶ X) (K : CommRingCat.{u})
    (s : Z ⟶ Spec K), IsField K ∧ CharZero K ∧ IsReduced Z ∧
    LocallyOfFiniteType s ∧ QuasiCompact s ∧ IsHomeomorph i.hom.base ∧
    ∀ z : Z, Function.Surjective (i.hom.stalkMap z).hom ∧
      RingHom.ker (i.hom.stalkMap z).hom = (I (i.hom.base z)).radical

/-- A finite disjoint union of formal varieties; the finite clopen components may use
unrelated characteristic-zero fields. Their structure maps are not part of morphisms.
Source: Temkin §§3.1.1, 3.1.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def NoetherianAdicFormalScheme.IsFiniteUnionFormalVarieties
    (X : NoetherianAdicFormalScheme.{u}) : Prop :=
  ∃ (n : ℕ) (V : Fin n → RingedSpace.{u, u}) (i : ∀ a, V a ⟶ X.space),
    (∀ a, SheafedSpace.IsOpenImmersion (i a) ∧
      HasFormalVarietyClosedFibre (V a) (X.ideal.comap (i a))) ∧
    (∀ x : X.space, ∃ (a : Fin n) (y : V a), (i a).hom.base y = x) ∧
    (∀ a b, a ≠ b → Disjoint (Set.range (i a).hom.base) (Set.range (i b).hom.base))

/-- The exact input pairs of the rig-regular formal resolution theorem.
Source: Temkin §§2.4.11, 3.1.4–3.1.5 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
structure RigRegularFormalInput where
  formalScheme : NoetherianAdicFormalScheme.{u}
  rational : Nonempty (formalScheme.space ⟶ (Spec (.of (ULift.{u} ℚ))).toRingedSpace)
  reduced : IsReducedAdicFormalScheme formalScheme.space
  quasiExcellent : IsQuasiExcellentAdicFormalScheme formalScheme.space
  invertible : formalScheme.ideal.IsInvertible
  varieties : formalScheme.IsFiniteUnionFormalVarieties
  rigRegular : ∀ c : FormalAffineChart formalScheme.space formalScheme.ideal,
    ∃ n : ℕ, 0 < n ∧ c.ideal ^ n ≤ absoluteSingularIdeal c.ring

/-- A morphism preserves the distinguished ideals and is regular on formal affine
charts, using the existing section maps on every formal affine open; no algebraization
of the formal morphism or compatibility between coefficient fields is assumed.
Source: Temkin §2.4.12 and §3.1.4 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def IsRegularFormalMap {X Y : NoetherianAdicFormalScheme.{u}}
    (f : Y.space ⟶ X.space) : Prop :=
  X.ideal.comap f = Y.ideal ∧
    (∀ y : Y.space, IsLocalHom (f.hom.stalkMap y).hom) ∧
    IsRegularOnAdicFormalAffines f

/-- An ideal is open when it contains a positive power of the distinguished ideal.
Source: Temkin §2.4.2 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def FormalIdeal.IsOpen {X : NoetherianAdicFormalScheme.{u}}
    (J : FormalIdeal X.space) : Prop :=
  ∃ n : ℕ, 0 < n ∧ ∀ x : X.space, X.ideal x ^ n ≤ J x

/-- A formal blowup is locally the completion of the existing ordinary scheme blowup.
The cartesian square restricts the source to the chosen target chart, the stalk ideal
identity retains the actual center, and the last equality identifies the canonical map
before completion. The source distinguished ideal is the extended original ideal.
Source: Temkin §§2.4.4–2.4.6 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def IsFormalBlowup {X Y : NoetherianAdicFormalScheme.{u}}
    (f : Y.space ⟶ X.space) (J : FormalIdeal X.space) : Prop :=
  X.ideal.comap f = Y.ideal ∧ J.IsCoherent ∧ J.IsOpen ∧
  ∀ x : X.space, ∃ (c : FormalAffineChart X.space X.ideal)
    (z : AdicFormalCompletion.formalSpectrum c.ring c.ideal) (K : (Spec c.ring).IdealSheafData)
    (q : (AdicFormalCompletion.mk K.blowup ((affineFormalIdeal c.ring c.ideal).comap
      K.blowupMap)).space ⟶ AdicFormalCompletion.formalSpectrum c.ring c.ideal)
    (v : (AdicFormalCompletion.mk K.blowup ((affineFormalIdeal c.ring c.ideal).comap
      K.blowupMap)).space ⟶ Y.space),
    c.map.hom.base z = x ∧ K.ofFiniteType ∧
    J.comap c.map = completedFormalIdeal (Spec c.ring)
      (affineFormalIdeal c.ring c.ideal) K ∧
    IsPullback v q f c.map ∧
    q ≫ formalSpectrumMap c.ring c.ideal =
      (AdicFormalCompletion.mk K.blowup
        ((affineFormalIdeal c.ring c.ideal).comap K.blowupMap)).toScheme ≫
          AdicFormalCompletion.ringedSpaceFunctor.map K.blowupMap

/-- A coherent open center is regular exactly when its quotient on each formal affine
chart is a regular scheme. Openness makes that quotient an ordinary scheme.
Source: Temkin §§2.4.4, 2.4.10 (blueprint: def-per-rig-regular-formal-pair-geometry). -/
def FormalIdeal.IsRegularCenter {X : NoetherianAdicFormalScheme.{u}}
    (J : FormalIdeal X.space) : Prop :=
  ∀ x : X.space, ∃ (c : FormalAffineChart X.space X.ideal)
    (z : AdicFormalCompletion.formalSpectrum c.ring c.ideal) (K : (Spec c.ring).IdealSheafData),
    c.map.hom.base z = x ∧
    J.comap c.map = completedFormalIdeal (Spec c.ring)
      (affineFormalIdeal c.ring c.ideal) K ∧
    (∃ n : ℕ, 0 < n ∧ affineFormalIdeal c.ring (c.ideal ^ n) ≤ K) ∧
    IsRegularScheme K.subscheme

end AlgebraicGeometry
