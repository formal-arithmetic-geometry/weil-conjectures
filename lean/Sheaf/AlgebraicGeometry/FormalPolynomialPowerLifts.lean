/-! # Lifting homogeneous evaluations into ideal powers

Source: Stacks Project, proof of Lemma 0884, affine power refinement.
(blueprint: lem-weil-pbc-formal-polynomial-power-lifts).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry

/-- Every recursively constructed power of a monic map into the structure module
has a monic inclusion. This applies to arbitrary structure-module subobjects. -/
theorem formalPolynomial_power_mono {X : Scheme.{u}} {M : X.Modules}
    (ι : M ⟶ SheafOfModules.unit X.ringCatSheaf) [Mono ι] (k : ℕ) :
    Mono (Scheme.idealSheafPower ι k).2 := by
  induction k using Nat.twoStepInduction with
  | zero => change Mono (𝟙 _); infer_instance
  | one => change Mono ι; infer_instance
  | more k _ ih =>
    change Mono (Scheme.idealModuleProductι ι
      (Scheme.idealSheafPower ι (k + 1)).1 ≫
      (Scheme.idealSheafPower ι (k + 1)).2)
    have : Mono (Scheme.idealModuleProductι ι
        (Scheme.idealSheafPower ι (k + 1)).1) := by
      dsimp [Scheme.idealModuleProductι]
      infer_instance
    infer_instance

/-- Power inclusions of any monic structure-module map are injective on sections. -/
theorem formalPolynomial_power_injective {X : Scheme.{u}} {M : X.Modules}
    (ι : M ⟶ SheafOfModules.unit X.ringCatSheaf) [Mono ι] (k : ℕ) (U : X.Opens) :
    Function.Injective ((Scheme.idealSheafPower ι k).2.val.app (op U)) := by
  have := formalPolynomial_power_mono ι k
  have : Mono (Scheme.idealSheafPower ι k).2.val :=
    (SheafOfModules.forget _).map_mono _
  exact PresheafOfModules.injective_of_mono _ _

set_option backward.isDefEq.respectTransparency false in
/-- On an affine open, the extended ideal is generated by the restricted generators. -/
theorem formalPolynomial_extendedIdeal_affine
    {A : Type u} [CommRing A] (I : Ideal A)
    {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of A))
    {r : ℕ} (generators : Fin r → A)
    (hgenerators : Ideal.span (Set.range generators) = I) (V : X.affineOpens) :
    ((Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f).ideal V =
      Ideal.span (Set.range (fun i =>
        (X.presheaf.map (homOfLE (le_top (a := V.1))).op).hom
          (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom (generators i)))) := by
  rw [Scheme.IdealSheafData.ideal_comap_appLE _ f
    ⟨⊤, isAffineOpen_top _⟩ V (by simp),
    Scheme.IdealSheafData.ideal_top_ofIdealTop, Ideal.map_map,
    ← hgenerators, Ideal.map_span, ← Set.range_comp]
  congr 1

set_option backward.isDefEq.respectTransparency false in
/-- Homogeneous evaluations lift to the actual ideal-power sheaves on every open.
Source: Stacks Project, proof of Lemma 0884, associated graded algebra refinement;
Schemes, Tags 01I8 and 01IC, for the affine power calculation.
(blueprint: lem-weil-pbc-formal-polynomial-power-lifts).

Proof: on an affine open V, ideal_comap_appLE and ideal_top_ofIdealTop identify
J(V) with the ideal spanned by the images of the generators. A degree-k polynomial
has evaluation in J(V)^k: expand into monomials, each a product of k generators.
For positive k, the affine power-range clause of
ideal_times_quasiCoherent_affine_sections gives a preimage in J^k(V). For k=0,
the power inclusion is the identity. All inclusions are monic: the degree-one
inclusion is the ideal inclusion, and every higher inclusion is a composite of
an image inclusion and the preceding inclusion. Thus the local preimage is unique.
On nested affine opens, naturality identifies its restriction with the unique
preimage there. On overlaps compare after restriction to affine subopens, and use
sheaf separation. The sheaf gluing axiom now gives a preimage on any open U,
uniquely, with the prescribed structure-sheaf image. Choose these unique preimages
for all k, U, b. No arbitrary data are chosen: the image determines each lift.
Empty generators, degree zero, the zero ring and the empty open follow from the
same construction. -/
theorem formalPolynomial_power_lifts
    {A : Type u} [CommRing A] (I : Ideal A)
    {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of A))
    {r : ℕ} (generators : Fin r → A)
    (hgenerators : Ideal.span (Set.range generators) = I)
 :
    ∃ l : ∀ (k : ℕ) (U : X.Opens),
      MvPolynomial.homogeneousSubmodule (Fin r) A k →
        (Scheme.idealSheafPower ((Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f).toModulesι k).1.val.obj
          (op U),
      (∀ k U b, (Scheme.idealSheafPower _ k).2.val.app (op U) (l k U b) =
        MvPolynomial.eval₂Hom
          (((X.presheaf.map (homOfLE (le_top (a := U))).op).hom).comp
            (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom))
          (fun i => (X.presheaf.map (homOfLE (le_top (a := U))).op).hom
            (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom (generators i))) b.val) := by
  classical
  let J := (Scheme.IdealSheafData.ofIdealTop
    (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f
  let ρ (U : X.Opens) : A →+* Γ(X, U) :=
    ((X.presheaf.map (homOfLE (le_top (a := U))).op).hom).comp
      (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom)
  let ev (U : X.Opens) : MvPolynomial (Fin r) A →+* Γ(X, U) :=
    MvPolynomial.eval₂Hom (ρ U) (fun i => ρ U (generators i))
  have hev (U V : X.Opens) (h : V ≤ U) (b : MvPolynomial (Fin r) A) :
      (X.presheaf.map (homOfLE h).op).hom (ev U b) = ev V b := by
    have hρ : ((X.presheaf.map (homOfLE h).op).hom).comp (ρ U) = ρ V := by
      ext a
      change (X.presheaf.map (homOfLE h).op).hom
        ((X.presheaf.map (homOfLE le_top).op).hom _) = _
      change ((X.presheaf.map (homOfLE le_top).op ≫
        X.presheaf.map (homOfLE h).op).hom) _ = _
      rw [← X.presheaf.map_comp]
      rfl
    change (X.presheaf.map (homOfLE h).op).hom
      (MvPolynomial.eval₂Hom (ρ U) (fun i => ρ U (generators i)) b) = _
    rw [MvPolynomial.map_eval₂Hom, hρ]
    have hg : (fun i => (X.presheaf.map (homOfLE h).op).hom
        (ρ U (generators i))) = (fun i => ρ V (generators i)) := by
      funext i
      exact congrArg (fun q : A →+* Γ(X, V) => q (generators i)) hρ
    rw [hg]
  have hlocal (k : ℕ) (V : X.affineOpens)
      (b : MvPolynomial.homogeneousSubmodule (Fin r) A k) :
      ∃ c, (Scheme.idealSheafPower J.toModulesι k).2.val.app (op V.1) c = ev V.1 b.val := by
    by_cases hk : k = 0
    · subst k
      exact ⟨ev V.1 b.val, rfl⟩
    · have hqc := SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
      have hr := (Scheme.Modules.ideal_times_quasiCoherent_affine_sections
        J (SheafOfModules.unit X.ringCatSheaf)).2.2.2.1 V
      have hm : ev V.1 b.val ∈ J.ideal V ^ k := by
        rw [formalPolynomial_extendedIdeal_affine I f generators hgenerators]
        apply (Ideal.mem_span_pow_iff_exists_isHomogeneous _ _).mpr
        refine ⟨MvPolynomial.map (ρ V.1) b.val, b.property.map _, ?_⟩
        change MvPolynomial.eval₂Hom (RingHom.id _) (fun i => ρ V.1 (generators i))
          (MvPolynomial.map (ρ V.1) b.val) = _
        rw [MvPolynomial.eval₂Hom_map_hom]
        rfl
      have hmem : ev V.1 b.val ∈ Set.range
          ((Scheme.idealSheafPower J.toModulesι k).2.app V.1) := by
        rw [hr.2.2.2 k (Nat.pos_of_ne_zero hk)]
        exact hm
      exact hmem
  have hall (k : ℕ) (U : X.Opens)
      (b : MvPolynomial.homogeneousSubmodule (Fin r) A k) :
      ∃ c, (Scheme.idealSheafPower J.toModulesι k).2.val.app (op U) c = ev U b.val := by
    let T := {V : X.affineOpens // V.1 ≤ U}
    let M := (Scheme.idealSheafPower J.toModulesι k).1
    let c (i : T) : M.val.obj (op i.1.1) := (hlocal k i.1 b).choose
    have hc (i : T) :
        (Scheme.idealSheafPower J.toModulesι k).2.val.app (op i.1.1) (c i) =
          ev i.1.1 b.val := (hlocal k i.1 b).choose_spec
    have hcover : U ≤ ⨆ i : T, i.1.1 := by
      intro x hx
      obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
        X.isBasis_affineOpens.exists_subset_of_mem_open hx U.2
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨V, hV⟩, hVU⟩, hxV⟩
    have hcompat : TopCat.Presheaf.IsCompatible M.presheaf
        (fun i : T => i.1.1) c := by
      intro i j
      apply formalPolynomial_power_injective J.toModulesι k (i.1.1 ⊓ j.1.1)
      change (Scheme.idealSheafPower J.toModulesι k).2.val.app (op (i.1.1 ⊓ j.1.1))
        (M.val.map (homOfLE (inf_le_left : i.1.1 ⊓ j.1.1 ≤ i.1.1)).op (c i)) =
        (Scheme.idealSheafPower J.toModulesι k).2.val.app (op (i.1.1 ⊓ j.1.1))
          (M.val.map (homOfLE (inf_le_right : i.1.1 ⊓ j.1.1 ≤ j.1.1)).op (c j))
      rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply]
      change (X.presheaf.map (homOfLE inf_le_left).op).hom
        ((Scheme.idealSheafPower J.toModulesι k).2.val.app _ (c i)) =
        (X.presheaf.map (homOfLE inf_le_right).op).hom
          ((Scheme.idealSheafPower J.toModulesι k).2.val.app _ (c j))
      rw [hc, hc, hev, hev]
    obtain ⟨t, ht, _⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf AddCommGrpCat X)
      (fun i : T => i.1.1) U (fun i => homOfLE i.2) hcover c hcompat
    refine ⟨t, ?_⟩
    apply TopCat.Sheaf.eq_of_locally_eq' X.sheaf
      (fun i : T => i.1.1) U (fun i => homOfLE i.2) hcover
    intro i
    change (X.presheaf.map (homOfLE i.2).op).hom
      ((Scheme.idealSheafPower J.toModulesι k).2.val.app (op U) t) =
      (X.presheaf.map (homOfLE i.2).op).hom (ev U b.val)
    rw [hev]
    change (SheafOfModules.unit X.ringCatSheaf).val.map (homOfLE i.2).op
      ((Scheme.idealSheafPower J.toModulesι k).2.val.app (op U) t) = _
    rw [← PresheafOfModules.naturality_apply]
    change (Scheme.idealSheafPower J.toModulesι k).2.val.app (op i.1.1)
      (M.presheaf.map (homOfLE i.2).op t) = _
    rw [ht]
    exact hc i
  choose l hl using hall
  exact ⟨l, hl⟩

end AlgebraicGeometry
