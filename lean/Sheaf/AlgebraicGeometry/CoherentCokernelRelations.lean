module

public import Sheaf.AlgebraicGeometry.Coherent
import Sheaf.AlgebraicGeometry.FiniteTypeEpiImage
import Sheaf.AlgebraicGeometry.CoherentCokernelRelationsLocal

/-! # Coherent CokernelRelations

Source: Stacks Project, Modules, Lemma 01BY
(blueprint: lem-weil-pbc-coherent-cokernel-relations).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace AlgebraicGeometry.RingedSpace

/-- Relations in the cokernel of a map from a finite type module to a coherent module
are of finite type.
Source: Stacks Project, Modules, Lemma 01BY (lemma-coherent-abelian), proof of (3),
the cokernel paragraph (blueprint: lem-weil-pbc-coherent-cokernel-relations).

Proof: Given a finite tuple of cokernel sections over U, around each point shrink U so
that every section lifts to G and the image of f is generated by a finite tuple. The
image is finite type because it is an epimorphic image of F. Combine its generators
and the chosen lifts into a map from a finite free module to G. Its kernel is finite
type by coherence of G. In the commutative diagram from the split sequence of the two
finite free modules to the image-G-cokernel sequence, the first vertical map is epi.
The snake lemma therefore makes the combined relation kernel surject onto the
relations of the original cokernel tuple. These relations are finite type as an
image of a finite type sheaf. Finite type is local, so the relation kernel on U is
finite type. This argument uses only finite type of F, not coherence of F. -/
theorem coherent_cokernel_relations (X : RingedSpace.{u})
    (F G : SheafOfModules.{u} (moduleRings X)) (f : F ⟶ G)
    (hF : F.IsFiniteType) (hG : IsCoherent X G)
    (U : Opens X) (n : ℕ)
    (g : SheafOfModules.free (R := (moduleRings X).over U) (ULift.{u} (Fin n)) ⟶
      (cokernel f).over U) :
    (kernel g).IsFiniteType := by
  obtain ⟨m, ψ, e, he⟩ := coherent_cokernel_relations_local X F G f hF hG U n g
  set_option linter.style.haveILetI false in
    haveI : Epi e := he
  exact sheaf_finiteType_of_epi (R := (moduleRings X).over U)
    (A := kernel ψ) (B := kernel g) e (hG.2 U m ψ)

end AlgebraicGeometry.RingedSpace
