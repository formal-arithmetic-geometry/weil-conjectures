/-!
# Logarithmic differential generators and their characteristic cokernel

Source: ILO, Exposé XVI Proposition 3.6.3 and Lemma 3.6.4, pp.252--253;
Exposé X Proposition 1.2, pp.136--138
(blueprint: lem-per-log-smooth-differential-generators).

We use multiplicative notation for group completions and their cokernels.
The characteristic group is the completion of the recorded quotient by units,
canonically `M^gp / Aˣ`. The image of `ℤ^r ⊕ Q^gp` is the subgroup generated by
the `tᵢ` and the chart, so its cokernel is represented by that subgroup quotient.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

/-- The canonical class of a log-stalk section modulo units, followed by group
completion. Source: ILO XVI 3.6.3--3.6.4
(blueprint: lem-per-log-smooth-differential-generators). -/
noncomputable def EtaleLogStructure.characteristicClass {X : Scheme.{u}}
    (M : EtaleLogStructure X) {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (t : Spec (.of Ω) ⟶ X) : M.stalk t →*
      Algebra.GrothendieckGroup (M.characteristic t) :=
  Algebra.GrothendieckGroup.of.comp Associates.mkMonoidHom

/-- The image of `ℤ^r ⊕ Q^gp` in the characteristic group, specified by its canonical
monoid generators. Source: ILO XVI 3.6.3--3.6.4
(blueprint: lem-per-log-smooth-differential-generators). -/
noncomputable def EtaleLogHom.differentialGeneratorImage
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme)
    {Q : Type u} [CommMonoid Q]
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme))))
    {r : ℕ} (ts : Fin r → X.logStructure.stalk t) :
    Subgroup (Algebra.GrothendieckGroup (X.logStructure.characteristic t)) :=
  Subgroup.closure
    (Set.range (fun i ↦ X.logStructure.characteristicClass t (ts i)) ∪
      Set.range ((X.logStructure.characteristicClass t).comp (f.baseChartGerm t β)))

/-- A log-smooth morphism admits a basis of logarithmic differentials from actual
log-monoid elements, with finite characteristic cokernel killed by an invertible
positive integer and divisible units.
Source: ILO XVI Proposition 3.6.3 proof and Lemma 3.6.4, pp.252--253;
X Proposition 1.2, pp.136--138
(blueprint: lem-per-log-smooth-differential-generators).

Proof:
1. The geometric ring stalk is the strict-henselization colimit, using affine
   pointed-neighbourhood cofinality and strict-henselization local structure; hence
   it is strictly henselian with separably closed residue field.
2. An fs stalk chart `P` identifies the characteristic group with `P^gp/F^gp`
   for its unit face `F`. Face sharpening makes it finite free over `ℤ`.
3. The logarithmic symbols span: if `a` is a nonunit, `a+1` is a unit, and
   `da = (a+1)dlog(a+1)`; if `a` is a unit use `da = a dlog a`.
   Log-smooth differential local freeness and the selected-basis lemma at the
   maximal ideal select finitely many such symbols as a basis, including rank zero.
4. Modulo the maximal ideal, send ordinary differentials to zero and logarithmic
   symbols to their classes in the residue field tensor the relative characteristic
   group. The defining relations vanish and the map is onto. Quotienting by the
   selected basis gives a characteristic cokernel whose residue tensor is zero.
5. The finitely generated abelian-group structure theorem eliminates the free part
   and all primary factors of residue characteristic. The cokernel is finite;
   its positive order `n` annihilates it and is a unit in the local ring.
6. For a unit `u`, the polynomial `T^n-u` has a simple root in the separably closed
   residue field. Henselian simple-root lifting lifts it to a unit, proving
   `n`-divisibility. For zero cokernel take `n=1`.
-/
theorem EtaleLogHom.exists_logDifferential_generators
    {X Y : FineSaturatedLogScheme.{u}} (f : EtaleLogHom X Y)
    (hf : f.IsLogSmooth) {Q : Type u} [CommMonoid Q]
    (hQ : IsFineSaturatedMonoid Q) [IsMulTorsionFree (Algebra.GrothendieckGroup Q)]
    (β : Q →* Y.logStructure.monoidSheaf.obj.obj
      (op (Scheme.Etale.mk (𝟙 Y.scheme))))
    (hβ : Y.logStructure.IsChart (Scheme.Etale.mk (𝟙 Y.scheme)) β)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme) :
    Group.FG (Algebra.GrothendieckGroup (X.logStructure.characteristic t)) ∧
      IsMulTorsionFree (Algebra.GrothendieckGroup (X.logStructure.characteristic t)) ∧
      ∃ (r : ℕ) (ts : Fin r → X.logStructure.stalk t) (n : ℕ),
        1 ≤ n ∧ IsUnit (n : strictLocalRing X.scheme t) ∧
        (∃ b : Module.Basis (Fin r) (strictLocalRing X.scheme t) (f.LogDifferential t),
          ∀ i, b i = f.logDLog t (ts i)) ∧
        Finite (Algebra.GrothendieckGroup (X.logStructure.characteristic t) ⧸
          f.differentialGeneratorImage t β ts) ∧
        (∀ c : Algebra.GrothendieckGroup (X.logStructure.characteristic t) ⧸
          f.differentialGeneratorImage t β ts, c ^ n = 1) ∧
        ∀ a : (strictLocalRing X.scheme t)ˣ, ∃ b : (strictLocalRing X.scheme t)ˣ,
          b ^ n = a := by
  sorry

end AlgebraicGeometry
