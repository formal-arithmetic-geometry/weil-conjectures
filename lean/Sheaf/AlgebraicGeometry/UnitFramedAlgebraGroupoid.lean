/-!
# The smooth groupoid of unit-framed algebra laws

Source: Stacks Project, criteria.tex, Tag 05YP, `lemma-represent-FAd`, equations
`objects` and `FAd` and the surrounding coordinate construction
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid).

The positive rank is written `n + 1`, so `n = 0` includes rank one. All models are
actual polynomial quotients, localizations and scheme fibre products. The conclusion
is bundled in `Presentation`: its equivalences are fixed by their coefficient formulas.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u v

open CategoryTheory CategoryTheory.Limits Opposite
open scoped BigOperators

namespace AlgebraicGeometry.UnitFramedAlgebra

/-- The standard vector `e_i` in the finite free module.
Source: Stacks, Tag 05YP, the definition preceding equation `objects`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def basisVector (n : ℕ) (R : Type v) [CommRing R] (i : Fin (n + 1)) :
    Fin (n + 1) → R := Pi.single i 1

/-- Commutative associative bilinear laws with first standard vector as unit.
Source: Stacks, Tag 05YP, preceding equation `objects`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
structure Law (n : ℕ) (R : Type v) [CommRing R] where
  mul : (Fin (n + 1) → R) →ₗ[R] (Fin (n + 1) → R) →ₗ[R] (Fin (n + 1) → R)
  assoc : ∀ x y z, mul (mul x y) z = mul x (mul y z)
  comm : ∀ x y, mul x y = mul y x
  unit_left : ∀ x, mul (basisVector n R 0) x = x
  unit_right : ∀ x, mul x (basisVector n R 0) = x

/-- Structure constants of a law, with output index last.
Source: Stacks, Tag 05YP, the displayed equations before `objects`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def Law.coeff {n : ℕ} {R : Type v} [CommRing R] (m : Law n R)
    (i j k : Fin (n + 1)) : R :=
  m.mul (basisVector n R i) (basisVector n R j) k

/-- Invertible linear maps fixing the unit vector. An arrow labelled `g : m → m'`
is the algebra isomorphism in the reverse direction, as characterized in `Presentation`.
Source: Stacks, Tag 05YP, equation `FAd` and the definition of `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def Frame (n : ℕ) (R : Type v) [CommRing R] :=
  {g : (Fin (n + 1) → R) ≃ₗ[R] (Fin (n + 1) → R) //
    g (basisVector n R 0) = basisVector n R 0}

/-- Polynomial variables for the multiplication table.
Source: Stacks, Tag 05YP, the definition of `R_univ`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev LawPolynomial (n : ℕ) :=
  MvPolynomial (Fin (n + 1) × Fin (n + 1) × Fin (n + 1)) (ULift.{u} ℤ)

/-- The coordinate `a_ij^k`.
Source: Stacks, Tag 05YP, the definition of `R_univ`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def lawVariable (n : ℕ) (i j k : Fin (n + 1)) : LawPolynomial.{u} n :=
  MvPolynomial.X (i, j, k)

/-- The ideal generated by associativity, symmetry and the specified unit equations.
Source: Stacks, Tag 05YP, the displayed equations defining `J`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def lawIdeal (n : ℕ) : Ideal (LawPolynomial.{u} n) :=
  Ideal.span
    ({p | ∃ i j k q : Fin (n + 1), p =
      (∑ l, lawVariable n i j l * lawVariable n l k q) -
      ∑ l, lawVariable n i l q * lawVariable n j k l} ∪
    {p | ∃ i j k : Fin (n + 1), p = lawVariable n i j k - lawVariable n j i k} ∪
    {p | ∃ i j : Fin (n + 1), p = lawVariable n i 0 j - if i = j then 1 else 0})

/-- The integral coordinate ring `B_(n+1)`, with equality modulo the generated ideal.
Source: Stacks, Tag 05YP, `R_univ = Z[a]/J`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev LawRing (n : ℕ) := LawPolynomial.{u} n ⧸ lawIdeal n

/-- Residue classes of the structure coordinates.
Source: Stacks, Tag 05YP, universal multiplication coefficients
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def lawCoordinate (n : ℕ) (i j k : Fin (n + 1)) : LawRing.{u} n :=
  Ideal.Quotient.mk (lawIdeal n) (lawVariable n i j k)

/-- Polynomial coordinates for all columns except the first.
Source: Stacks, Tag 05YP, the construction of `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev FramePolynomial (n : ℕ) :=
  MvPolynomial (Fin (n + 1) × Fin n) (ULift.{u} ℤ)

/-- A matrix whose first column is `e_1`, with the remaining entries given by `b`.
Source: Stacks, Tag 05YP, equations defining the subgroup `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def frameMatrix (n : ℕ) {R : Type v} [CommRing R]
    (b : Fin (n + 1) × Fin n → R) : Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  fun i j => Fin.cases (basisVector n R 0 i) (fun k => b (i, k)) j

/-- The universal matrix with first column `e_1`.
Source: Stacks, Tag 05YP, the determinant-open description of `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def universalFrame (n : ℕ) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) (FramePolynomial.{u} n) :=
  frameMatrix n MvPolynomial.X

/-- The determinant localization defining the integral model of `G`.
Source: Stacks, Tag 05YP, construction of the smooth matrix subgroup
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev FrameRing (n : ℕ) := Localization.Away (universalFrame.{u} n).det

/-- The matrix entries in the localized coordinate ring.
Source: Stacks, Tag 05YP, construction of `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def frameCoordinate (n : ℕ) (i j : Fin (n + 1)) : FrameRing.{u} n :=
  algebraMap (FramePolynomial n) (FrameRing n) (universalFrame n i j)

/-- Base change of an integral affine model to `S`.
Source: Stacks, Tag 05YP, arbitrary-base construction by base change
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def model (S : Scheme.{u}) (A : Type u) [CommRing A] : Over S :=
  Over.mk (pullback.fst (specULiftZIsTerminal.from S)
    (specULiftZIsTerminal.from (Spec (CommRingCat.of A))))

/-- The projection from the base-changed model to its integral affine model.
Source: Stacks, Tag 05YP, arbitrary-base construction
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def modelToSpec (S : Scheme.{u}) (A : Type u) [CommRing A] :
    (model S A).left ⟶ Spec (CommRingCat.of A) :=
  pullback.snd (specULiftZIsTerminal.from S)
    (specULiftZIsTerminal.from (Spec (CommRingCat.of A)))

/-- The scheme of laws over `S`.
Source: Stacks, Tag 05YP, equation `objects` and base change
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev objects (S : Scheme.{u}) (n : ℕ) : Over S := model S (LawRing.{u} n)

/-- The determinant-open matrix scheme over `S`.
Source: Stacks, Tag 05YP, definition of `G` and base change
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev frames (S : Scheme.{u}) (n : ℕ) : Over S := model S (FrameRing.{u} n)

/-- Evaluation of a coordinate on a point of a base-changed affine model.
Source: Stacks, Tag 05YP, equations `objects` and `FAd`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def coordinateValue {S : Scheme.{u}} {A : Type u} [CommRing A]
    {T : Over S} (f : T ⟶ model S A) (a : A) : Γ(T.left, ⊤) :=
  (f.left ≫ modelToSpec S A).appTop ((Scheme.ΓSpecIso (CommRingCat.of A)).inv a)

/-- The ambient affine space of matrices with fixed first column, of dimension `(n+1)n`.
Source: Stacks, Tag 05YP, determinant-open description of `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
abbrev ambient (S : Scheme.{u}) (n : ℕ) : Over S :=
  (AffineSpace (ULift.{u} (Fin (n + 1) × Fin n)) S).asOver S

/-- The determinant function on that ambient affine space.
Source: Stacks, Tag 05YP, determinant-open description of `G`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
def ambientDet (S : Scheme.{u}) (n : ℕ) : Γ((ambient S n).left, ⊤) :=
  (frameMatrix n (fun ij => AffineSpace.coord S (ULift.up ij))).det

/-- The explicit presentation asserted by Tag 05YP, including the direction of arrows.
All morphisms are morphisms over `S`; their underlying maps are scheme morphisms.
The two coefficient bijections and the formulas for every operation encode the
isomorphism with `FA_(n+1)`, with naturality on every base morphism.
Source: Stacks, Tag 05YP, equations `objects`, `FAd`, and `lemma-represent-FAd`
(blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid). -/
structure Presentation (S : Scheme.{u}) (n : ℕ) where
  objectEquiv : ∀ T : Over S, (T ⟶ objects S n) ≃ Law n Γ(T.left, ⊤)
  frameEquiv : ∀ T : Over S, (T ⟶ frames S n) ≃ Frame n Γ(T.left, ⊤)
  object_coeff : ∀ (T : Over S) (m : T ⟶ objects S n) (i j k : Fin (n + 1)),
    (objectEquiv T m).coeff i j k = coordinateValue m (lawCoordinate n i j k)
  frame_coeff : ∀ (T : Over S) (g : T ⟶ frames S n) (i j : Fin (n + 1)),
    (frameEquiv T g).val (basisVector n Γ(T.left, ⊤) j) i =
      coordinateValue g (frameCoordinate n i j)
  object_natural : ∀ (T T' : Over S) (f : T' ⟶ T) (m : T ⟶ objects S n)
    (i j k : Fin (n + 1)),
    (objectEquiv T' (f ≫ m)).coeff i j k = f.left.appTop ((objectEquiv T m).coeff i j k)
  frame_natural : ∀ (T T' : Over S) (f : T' ⟶ T) (g : T ⟶ frames S n)
    (i j : Fin (n + 1)),
    (frameEquiv T' (f ≫ g)).val (basisVector n Γ(T'.left, ⊤) j) i =
      f.left.appTop ((frameEquiv T g).val (basisVector n Γ(T.left, ⊤) j) i)
  ambientMap : frames S n ⟶ ambient S n
  ambient_coeff : ∀ (T : Over S) (g : T ⟶ frames S n) (i : Fin (n + 1)) (j : Fin n),
    (g.left ≫ ambientMap.left).appTop (AffineSpace.coord S (ULift.up (i, j))) =
      coordinateValue g (frameCoordinate n i j.succ)
  ambient_open : IsOpenImmersion ambientMap.left
  ambient_range : Set.range ambientMap.left =
    ((ambient S n).left.basicOpen (ambientDet S n) : Set (ambient S n).left)
  groupMul : prod (frames S n) (frames S n) ⟶ frames S n
  groupOne : Over.mk (𝟙 S) ⟶ frames S n
  groupInv : frames S n ⟶ frames S n
  group_mul_formula : ∀ (T : Over S) (p : T ⟶ prod (frames S n) (frames S n)) x,
    (frameEquiv T (p ≫ groupMul)).val x =
      (frameEquiv T (p ≫ prod.fst)).val ((frameEquiv T (p ≫ prod.snd)).val x)
  group_one_formula : ∀ (T : Over S) x,
    (frameEquiv T (Over.homMk T.hom ≫ groupOne)).val x = x
  group_inv_formula : ∀ (T : Over S) (g : T ⟶ frames S n) x,
    (frameEquiv T (g ≫ groupInv)).val x = (frameEquiv T g).val.symm x
  group_assoc : ∀ (T : Over S) (g h k : T ⟶ frames S n),
    prod.lift (prod.lift g h ≫ groupMul) k ≫ groupMul =
      prod.lift g (prod.lift h k ≫ groupMul) ≫ groupMul
  group_left_id : ∀ (T : Over S) (g : T ⟶ frames S n),
    prod.lift (Over.homMk T.hom ≫ groupOne) g ≫ groupMul = g
  group_right_id : ∀ (T : Over S) (g : T ⟶ frames S n),
    prod.lift g (Over.homMk T.hom ≫ groupOne) ≫ groupMul = g
  group_left_inv : ∀ (T : Over S) (g : T ⟶ frames S n),
    prod.lift (g ≫ groupInv) g ≫ groupMul = Over.homMk T.hom ≫ groupOne
  group_right_inv : ∀ (T : Over S) (g : T ⟶ frames S n),
    prod.lift g (g ≫ groupInv) ≫ groupMul = Over.homMk T.hom ≫ groupOne
  target : prod (frames S n) (objects S n) ⟶ objects S n
  action_formula : ∀ (T : Over S) (p : T ⟶ prod (frames S n) (objects S n)) x y,
    (objectEquiv T (p ≫ target)).mul x y =
      (frameEquiv T (p ≫ prod.fst)).val.symm
        ((objectEquiv T (p ≫ prod.snd)).mul
          ((frameEquiv T (p ≫ prod.fst)).val x) ((frameEquiv T (p ≫ prod.fst)).val y))
  identity : objects S n ⟶ prod (frames S n) (objects S n)
  inverse : prod (frames S n) (objects S n) ⟶ prod (frames S n) (objects S n)
  composition : pullback (prod.snd : prod (frames S n) (objects S n) ⟶ objects S n)
    target ⟶ prod (frames S n) (objects S n)
  groupoid : AlgebraicSpace.IsPresheafGroupoid
    (yoneda.map (prod.snd : prod (frames S n) (objects S n) ⟶ objects S n))
    (yoneda.map target) (yoneda.map identity) (yoneda.map inverse)
    ((PreservesPullback.iso yoneda prod.snd target).inv ≫ yoneda.map composition)
  identity_frame : ∀ (T : Over S) (m : T ⟶ objects S n) x,
    (frameEquiv T (m ≫ identity ≫ prod.fst)).val x = x
  inverse_frame : ∀ (T : Over S) (p : T ⟶ prod (frames S n) (objects S n)) x,
    (frameEquiv T (p ≫ inverse ≫ prod.fst)).val x =
      (frameEquiv T (p ≫ prod.fst)).val.symm x
  composition_frame : ∀ (T : Over S)
    (p : T ⟶ pullback
      (prod.snd : prod (frames S n) (objects S n) ⟶ objects S n) target) x,
    (frameEquiv T (p ≫ composition ≫ prod.fst)).val x =
      (frameEquiv T (p ≫ pullback.snd prod.snd target ≫ prod.fst)).val
        ((frameEquiv T (p ≫ pullback.fst prod.snd target ≫ prod.fst)).val x)
  source_smooth : Smooth (prod.snd : prod (frames S n) (objects S n) ⟶ objects S n).left
  target_smooth : Smooth target.left
  rank_one_det : n = 0 → (universalFrame.{u} n).det = 1
  rank_one_frames : n = 0 → IsIso (frames S n).hom

/-- The coordinate models form the smooth groupoid of unit-framed algebra laws.
Source: Stacks Project, criteria.tex, Tag 05YP, `lemma-represent-FAd` and the
surrounding construction (blueprint: lem-sfb-unit-framed-algebra-smooth-groupoid).

Proof plan:
1. Expand a bilinear law in the standard basis. Associativity gives exactly the
   first family of generators of `lawIdeal`, symmetry the second, and the unit
   the third. Polynomial evaluation factors uniquely through the quotient.
2. The affine-target/global-sections adjunction and the fibre-product property
   identify all `T/S` points, including nonaffine `T`, with these laws. Every
   coefficient is pulled back by `f.appTop`, giving `object_natural`.
3. The localization universal property identifies frame points with matrices
   fixing the first vector and having unit determinant. The adjugate identities
   and determinant multiplicativity identify these with invertible linear maps.
   This construction and its inverse commute with coefficient maps.
4. In ambient affine space the determinant is a global section. Maps factor
   through its basic open exactly when their pulled-back determinant is a unit.
   The affine and localization bijections and Yoneda identify this open with `G`.
5. Matrix multiplication, inverse and identity are natural on test schemes;
   Yoneda gives the displayed scheme morphisms. Matrix identities give a group.
6. Conjugation gives a bilinear, associative, symmetric law with the same unit.
   Its coefficients are sums of products of the coefficients of the law, the
   matrix and its adjugate divided by the determinant. These commute with base
   morphisms, so Yoneda supplies `target` with `action_formula`.
7. The identity `a(h,a(g,m)) = a(gh,m)` gives composition in the stated order.
   Identity and inverse formulas and matrix associativity give precisely the
   recorded presheaf-groupoid laws, transported through the Yoneda pullback iso.
8. Affine space is smooth, and `G` is its determinant open. The source is the
   base change of `G → S`, hence smooth. Inversion is an involutive isomorphism
   interchanging source and target, proving target smoothness.
9. The coefficient bijections on objects and frames, and the formulas for
   source, target, identity, inverse and composition give the natural isomorphism
   with `FA_(n+1)`. For `n=0` the equations force `B_1=Z`, the frame matrix is `(1)`
   with no coordinates, and the resulting groupoid has one object and one arrow.
The non-elementary inputs are the proof dependencies recorded on this DAG node. -/
theorem smooth_groupoid (S : Scheme.{u}) (n : ℕ) : Nonempty (Presentation S n) :=
  sorry

end AlgebraicGeometry.UnitFramedAlgebra
