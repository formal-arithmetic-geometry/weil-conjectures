/-!
# Smooth closed pairs with local dimension drop one are Cartier

Source: Stacks Project, `more-morphisms.tex`, Tag 0FUE, lemma-etale-local-structure,
and `algebra.tex`, Tag 00KW, lemma-one-equation
(blueprint: lem-pur-smooth-codimension-one-cartier).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- A smooth closed pair with local dimension drop one has a single regular local equation
and is an effective Cartier divisor, with no regularity or reducedness assumption on the base.
The three structure morphisms record the finite-type k-schemes in the statement. No additional
compatibility with these structure morphisms is needed or assumed.

Source: Stacks Project, Tag 0FUE and Tag 00KW
(blueprint: lem-pur-smooth-codimension-one-cartier).

Proof:
1. At y, apply lem-pur-smooth-pair-local-coordinates over B to v and i followed by v.
   Its last b coordinates generate the closed ideal and are successively nonzerodivisors.
2. Finite type over k makes T Noetherian (lem-weil-pbc-finite-type-over-noetherian).
   Shrink to a principal affine neighbourhood W inside the coordinate neighbourhood and a
   Noetherian affine chart. Its coordinate ring and the stalk R at i(y) are Noetherian;
   lem-weil-pbc-affine-open-stalk-localization identifies R with the prime localization.
3. The ideal is i.ker (def-sbc-closed-immersion-ideal-sheaf). The affine-stalk localization
   lemma on D and lem-weil-pbc-localization-at-prime-of-quotient identify its stalk quotient
   with the stalk of D at y. The coordinate germs remain regular under localization:
   clearing a denominator reduces injectivity to that before localization. Each lies in the
   maximal ideal, so all successive quotients are nonzero Noetherian local rings.
4. Their dimensions are finite (lem-weil-pbc-noetherian-local-finite-krull-dimension).
   Apply lem-weil-pbc-dimension-quotient-nonzerodivisor at each successive quotient.
   Induction gives dim R = dim O_D,y + b. The hypothesis and finite cancellation give b = 1.
5. The remaining coordinate gives the required nonzerodivisor generator on W. Off i(D),
   the ideal is generated by 1. These neighbourhoods cover T and make i.ker invertible;
   def-pc-divisor-line-bundle identifies i as an effective Cartier divisor. If D is empty,
   the complement is all of T, so the same unit-ideal argument applies. -/
theorem Scheme.Hom.exists_regular_equation_and_isEffectiveCartierCenter_of_smooth
    (k : Type u) [Field k] {B T D : Scheme.{u}}
    (b : B ⟶ Spec (.of k)) (t : T ⟶ Spec (.of k)) (d : D ⟶ Spec (.of k))
    [LocallyOfFiniteType b] [QuasiCompact b]
    [LocallyOfFiniteType t] [QuasiCompact t]
    [LocallyOfFiniteType d] [QuasiCompact d]
    (v : T ⟶ B) (i : D ⟶ T) [IsClosedImmersion i] [Smooth v] [Smooth (i ≫ v)]
    (hcodim : ∀ y : D, ringKrullDim (T.presheaf.stalk (i y)) =
      ringKrullDim (D.presheaf.stalk y) + (1 : WithBot ℕ∞)) :
    (∀ y : D, ∃ U : T.affineOpens, i y ∈ U.1 ∧
      ∃ f : Γ(T, U.1), f ∈ nonZeroDivisors Γ(T, U.1) ∧
        i.ker.ideal U = Ideal.span {f}) ∧ IsEffectiveCartierCenter i := by
  classical
  -- The regular-equation part of simultaneous coordinates suffices; no étale map is needed.
  have := LocallyOfFiniteType.isLocallyNoetherian t
  have := LocallyOfFiniteType.isLocallyNoetherian d
  have hlocal : ∀ y : D, ∃ U : T.affineOpens, i y ∈ U.1 ∧
      ∃ f : Γ(T, U.1), f ∈ nonZeroDivisors Γ(T, U.1) ∧
        i.ker.ideal U = Ideal.span {f} := by
    intro y
    obtain ⟨W, hW, hsW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := v (i y)) (U := ⊤) trivial
    obtain ⟨U, hU, hxU, hUW⟩ :=
      exists_isAffineOpen_mem_and_subset (x := i y) (U := v ⁻¹ᵁ W) hsW
    let V := i ⁻¹ᵁ U
    have hV : IsAffineOpen V := hU.preimage i
    let R := Γ(B, W)
    let A := Γ(T, U)
    let C := Γ(D, V)
    let := (v.appLE W U hUW).hom.toAlgebra
    let hVW : V ≤ (i ≫ v) ⁻¹ᵁ W := fun z hz ↦ hUW hz
    let := ((i ≫ v).appLE W V hVW).hom.toAlgebra
    let φ : A →ₐ[R] C :=
      { (i.app U).hom with
        commutes' := fun r ↦ by
          change ((v.appLE W U hUW) ≫ i.app U) r = ((i ≫ v).appLE W V hVW) r
          rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE] }
    have : Algebra.Smooth R A :=
      HasRingHomProperty.appLE (P := @Smooth) v inferInstance ⟨W, hW⟩ ⟨U, hU⟩ hUW
    have : Algebra.Smooth R C :=
      HasRingHomProperty.appLE (P := @Smooth) (i ≫ v) inferInstance ⟨W, hW⟩ ⟨V, hV⟩ hVW
    let Q := hU.primeIdealOf ⟨i y, hxU⟩
    have hker : RingHom.ker φ.toRingHom ≤ Q.asIdeal := by
      have hQ := IsAffineOpen.comap_primeIdealOf_appLE U hU V hV le_rfl hxU
      change _ ≤ (hU.primeIdealOf ⟨i y, hxU⟩).asIdeal
      rw [← hQ]
      change RingHom.ker (i.app U).hom ≤ _
      rw [Scheme.Hom.app_eq_appLE]
      exact Ideal.ker_le_comap _
    obtain ⟨g, hg, hseq⟩ := Algebra.exists_regularSequence_smooth_surjection
      R A C φ (i.app_surjective U hU) Q hker
    let E := T.affineBasicOpen (U := ⟨U, hU⟩) g
    have hEU : E.1 ≤ U := T.basicOpen_le g
    let := (T.presheaf.map (homOfLE hEU).op).hom.toAlgebra
    have : IsLocalization.Away g Γ(T, E) :=
      hU.isLocalization_of_eq_basicOpen g (homOfLE hEU) rfl
    obtain ⟨f, hf, hgen⟩ := hseq Γ(T, E)
    have hxE : i y ∈ E.1 := by
      have hm : Q ∈ hU.fromSpec ⁻¹ᵁ T.basicOpen g := by
        rw [hU.fromSpec_preimage_basicOpen]
        exact hg
      change hU.fromSpec (hU.primeIdealOf ⟨i y, hxU⟩) ∈ T.basicOpen g at hm
      rwa [hU.fromSpec_primeIdealOf ⟨i y, hxU⟩] at hm
    have hI : i.ker.ideal E = Ideal.ofList f := by
      rw [← i.ker.map_ideal (show E ≤ ⟨U, hU⟩ from hEU), Scheme.Hom.ker_apply]
      exact hgen
    let := T.presheaf.algebra_section_stalk ⟨i y, hxE⟩
    have := E.2.isLocalization_stalk ⟨i y, hxE⟩
    have : Module.Flat Γ(T, E.1) (T.presheaf.stalk (i y)) :=
      IsLocalization.flat _ (E.2.primeIdealOf ⟨i y, hxE⟩).asIdeal.primeCompl
    have hsupp : i y ∈ T.zeroLocus (U := E.1) (i.ker.ideal E) :=
      (Scheme.IdealSheafData.mem_support_iff_of_mem hxE).mp
        (i.range_subset_ker_support ⟨y, rfl⟩)
    have hf' : RingTheory.Sequence.IsRegular (T.presheaf.stalk (i y))
        (f.map (algebraMap Γ(T, E.1) (T.presheaf.stalk (i y)))) := by
      refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).mpr
        hf.toIsWeaklyRegular.of_flat
      intro _ hs'
      obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hs'
      have : s ∈ i.ker.ideal E := hI ▸ Ideal.subset_span hs
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact (T.mem_basicOpen _ _ hxE).not.mp ((T.mem_zeroLocus_iff _ _).mp hsupp s this)
    -- Localizing the regular equations measures their number by the dimension drop.
    have key := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hf'
    rw [← Ideal.map_ofList, ← hI,
      show algebraMap Γ(T, E.1) _ = (T.presheaf.germ E.1 (i y) hxE).hom from rfl,
      ← i.ker_stalkMap E y hxE,
      ringKrullDim_eq_of_ringEquiv
        (RingHom.quotientKerEquivOfSurjective (i.stalkMap_surjective y)),
      List.length_map, hcodim y] at key
    have hlen : f.length = 1 := by
      have hdim := ringKrullDim_ne_top (R := D.presheaf.stalk y)
      have hbot := ringKrullDim_ne_bot (R := D.presheaf.stalk y)
      obtain ⟨a, ha⟩ := WithBot.ne_bot_iff_exists.mp hbot
      obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (show a ≠ ⊤ by simpa [← ha] using hdim)
      have hn : ringKrullDim (D.presheaf.stalk y) = (n : WithBot ℕ∞) := by
        simpa only [← hn, ENat.WithBot.coe_eq_natCast] using ha.symm
      rw [hn] at key
      have he := ENat.WithBot.natCast_add_cancel.mp key
      exact_mod_cast he
    obtain ⟨s, rfl⟩ := List.length_eq_one_iff.mp hlen
    refine ⟨E, hxE, s, ?_, ?_⟩
    · have hs := (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).mp
        hf.toIsWeaklyRegular
      exact mem_nonZeroDivisors_iff_right.mpr fun a ha ↦ hs (by simpa [mul_comm] using ha)
    · simpa using hI
  refine ⟨hlocal, isEffectiveCartierCenter_iff_isInvertible_ker.mpr ?_⟩
  intro x
  by_cases hx : x ∈ Set.range i
  · obtain ⟨y, rfl⟩ := hx
    obtain ⟨U, hyU, f, hf, hI⟩ := hlocal y
    exact ⟨U, hyU, f, hf, hI⟩
  · have hsupp : x ∉ i.ker.support := by
      change x ∉ (i.ker.support : Set T)
      rw [Scheme.Hom.support_ker]
      simpa only [i.isClosedEmbedding.isClosed_range.closure_eq] using hx
    obtain ⟨U, hU, hxU, hsub⟩ := exists_isAffineOpen_mem_and_subset
      (x := x) (U := ⟨_, i.ker.support.isClosed.isOpen_compl⟩) hsupp
    refine ⟨⟨U, hU⟩, hxU, 1, one_mem _, ?_⟩
    rw [i.ker.ideal_eq_top_of_disjoint_support ?_, Ideal.span_singleton_one]
    exact Set.disjoint_left.mpr fun z hz hs ↦ hsub hz hs

end AlgebraicGeometry
