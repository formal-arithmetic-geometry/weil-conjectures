/-!
# Purity of coordinate divisors in the standard semistable trait model

Source: Illusie--Laszlo--Orgogozo, Exposé XVI, Proposition 3.5.12, printed p.251
(blueprint: lem-per-semistable-coordinate-divisor-purity).

## Main statements

* `semistable_coordinate_divisor_purity` states the Cartier Kummer purity
  isomorphism for every coordinate divisor in the all-one semistable chart.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option synthInstance.maxSize 2048

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry

namespace AlgebraicGeometry.Etale

/-- The coordinate ring of the all-one semistable trait chart.
Source: Illusie--Laszlo--Orgogozo, Exposé XVI, Proposition 3.5.12, p.251
(blueprint: lem-per-semistable-coordinate-divisor-purity). -/
abbrev semistableCoordinateRing (R : Type u) [CommRing R] (π : R) (n : ℕ) :=
  monomialTraitAlgebra R π n (fun _ : Fin n => 1)

/-- The ideal generated by the `i`-th coordinate in the semistable chart.
Source: Illusie--Laszlo--Orgogozo, Exposé XVI, Proposition 3.5.12, p.251
(blueprint: lem-per-semistable-coordinate-divisor-purity). -/
abbrev semistableCoordinateIdeal (R : Type u) [CommRing R] (π : R) (n : ℕ)
    (i : Fin n) : Ideal (semistableCoordinateRing R π n) :=
  Ideal.span {Ideal.Quotient.mk _ (MvPolynomial.X i)}

/-- The closed immersion of the `i`-th coordinate divisor.
Source: Illusie--Laszlo--Orgogozo, Exposé XVI, Proposition 3.5.12, p.251
(blueprint: lem-per-semistable-coordinate-divisor-purity). -/
abbrev semistableCoordinateDivisor (R : Type u) [CommRing R] (π : R) (n : ℕ)
    (i : Fin n) : Scheme.Hom
      (Spec (.of (semistableCoordinateRing R π n ⧸ semistableCoordinateIdeal R π n i)))
      (Spec (.of (semistableCoordinateRing R π n))) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _))

/-- The canonical coordinate quotient is a closed immersion.
Source: Mathlib, AlgebraicGeometry.Morphisms.ClosedImmersion;
Illusie--Laszlo--Orgogozo, Exposé XVI, Proposition 3.5.12, p.251
(blueprint: lem-per-semistable-coordinate-divisor-purity). -/
instance semistableCoordinateDivisor_isClosedImmersion
    (R : Type u) [CommRing R] (π : R) (n : ℕ) (i : Fin n) :
    IsClosedImmersion (semistableCoordinateDivisor R π n i) :=
  AlgebraicGeometry.IsClosedImmersion.spec_of_quotient_mk
    (R := CommRingCat.of (semistableCoordinateRing R π n))
    (semistableCoordinateIdeal R π n i)

/--
For a prime `ell`, the all-one standard semistable chart over a Noetherian local
one-dimensional domain has the normalized Cartier Kummer purity isomorphism on
every coordinate divisor. Proof plan, following the six steps of the node:
1. Primitive monomial geometry with every exponent one gives a regular Noetherian
   domain B. The coefficient map R -> B is injective, so the product of the
   coordinates is nonzero. Each coordinate is a nonzerodivisor and its quotient
   is the polynomial ring over R/(pi) on the other coordinates.
2. At a geometric point of the divisor, strict-localize X to Y = Spec C, with
   D = V(t_i) and V = Y - D. Regularity and Noetherianity survive; D is the strict
   localization of the divisor. Ind-etale closed-support base change transports
   the canonical class to D. Exact sections on the strictly henselian D identify
   the stalk calculation with supported cohomology on Y.
3. The Kummer covers V_r adjoining an ell^r-th root of t_i have constant H^0 and
   vanishing colimit of higher cohomology. Compatible roots of unity in C identify
   their deck groups with Z/ell^r and their limit with the procyclic ell-adic group.
4. Procyclic descent gives H^0(V,A) = H^1(V,A) = A and zero higher groups. Its
   normalized degree-one edge identifies the Kummer class of t_i as a generator.
   Roots of unity identify A(1) with the constant line on Y and V.
5. The closed-support localization cone of RΓ(Y,A(1)) -> RΓ(V,A(1)) has supported
   cohomology only in degree two. Its boundary from H^1(V,A(1)) is an isomorphism.
6. In the frame t_i-dual of O(D), the divisor section is t_i times the frame.
   The supported frame-torsor extension is e_(t_i inverse). Supported Yoneda
   localization identifies its Kummer product with minus the boundary of the
   Kummer class of t_i. This is a generator by steps 4 and 5. Scalar comparison
   and the normalized regular-class calculus give the stated canonical map.
   It is an isomorphism on every geometric stalk, hence globally by conservativity.

Source: Illusie--Laszlo--Orgogozo, Exposé XVI, Proposition 3.5.12, printed p.251;
Illusie (2004), Theorem 1.4; Rapoport--Zink (1982), Satz 2.21
(blueprint: lem-per-semistable-coordinate-divisor-purity).
-/
theorem semistable_coordinate_divisor_purity
    (ell : ℕ) (hell : ell.Prime)
    (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [IsNoetherianRing R]
    (hdim : ringKrullDim R = 1)
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (hinv : IsUnit (ell : R))
    (n : ℕ) (hn : 1 ≤ n) :
    ∀ i : Fin n,
      ∃ (hreg : IsStalkRegularClosedImmersion (semistableCoordinateDivisor R π n i) 1),
        ∃ (hunit : IsUnit
            ((ell ^ 1 : ℕ) : Γ(Spec (.of (semistableCoordinateRing R π n)), ⊤))),
          IsIso (punctualPurityClassMap ell hell (semistableCoordinateDivisor R π n i)
            1 hreg hunit) := by
  sorry

end AlgebraicGeometry.Etale
