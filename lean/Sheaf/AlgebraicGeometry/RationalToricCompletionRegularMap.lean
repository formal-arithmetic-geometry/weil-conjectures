/-!
# Regular rational toric models of completed log charts

Source: ILO, Exposé VI 1.6(i), printed p.70, and Exposé VIII, proof of Theorem
3.4.15, third paragraph, printed p.114
(blueprint: lem-per-rational-toric-completion-regular-map).
-/

@[expose] public section

set_option autoImplicit false

universe u v

open CategoryTheory Opposite

namespace AlgebraicGeometry

/-- The finite-sum ring `k[P][t₁,…,tₙ]`. Source: ILO VIII, proof of 3.4.15, p.114
(blueprint: lem-per-rational-toric-completion-regular-map). -/
abbrev toricPolynomialRing (k : Type u) (P : Type v) [CommRing k] [AddCommMonoid P] (n : ℕ) :=
  MvPolynomial (Fin n) (AddMonoidAlgebra k P)

/-- The chart sending `p` to the constant polynomial `zᵖ`. Source: ILO VI 1.6(i)
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def toricPolynomialChart (k : Type u) (P : Type v) [CommRing k] [AddCommMonoid P]
    (n : ℕ) : Multiplicative P →* toricPolynomialRing k P n :=
  MvPolynomial.C.toMonoidHom.comp (AddMonoidAlgebra.of k P)

/-- The ideal generated by the nonzero monomials and all polynomial variables.
Source: ILO VI 1.6(i), p.70
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def toricCompletionIdeal (k : Type u) (P : Type v) [CommRing k] [AddCommMonoid P]
    (n : ℕ) : Ideal (toricPolynomialRing k P n) :=
  Ideal.span ({a | ∃ p : P, p ≠ 0 ∧ a = toricPolynomialChart k P n (.ofAdd p)} ∪
    Set.range (MvPolynomial.X : Fin n → toricPolynomialRing k P n))

/-- The actual inverse-limit completion at the monomial and variable ideal.
Source: ILO VI 1.6(i), p.70
(blueprint: lem-per-rational-toric-completion-regular-map). -/
abbrev toricCompletedRing (k : Type u) (P : Type v) [CommRing k] [AddCommMonoid P] (n : ℕ) :=
  AdicCompletion (toricCompletionIdeal k P n) (toricPolynomialRing k P n)

/-- The canonical monomial map, with coefficient map `ℚ → k`, followed by completion.
Source: ILO VIII, proof of 3.4.15, p.114
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def rationalToricCompletionMap (k : Type u) (P : Type v) [Field k] [CharZero k]
    [AddCommMonoid P] (n : ℕ) : toricPolynomialRing ℚ P n →+* toricCompletedRing k P n :=
  (algebraMap (toricPolynomialRing k P n) (toricCompletedRing k P n)).comp
    (MvPolynomial.map (AddMonoidAlgebra.mapRingHom P (algebraMap ℚ k)))

/-- The canonical completed chart. Source: ILO VI 1.6(i), p.70
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def toricCompletedChart (k : Type u) (P : Type v) [CommRing k] [AddCommMonoid P]
    (n : ℕ) : Multiplicative P →* toricCompletedRing k P n :=
  (algebraMap (toricPolynomialRing k P n) (toricCompletedRing k P n)).toMonoidHom.comp
    (toricPolynomialChart k P n)

/-- Interpret the rational chart as global sections of its affine scheme.
Source: ILO VIII, proof of 3.4.15, p.114
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def rationalToricGlobalChart (P : Type u) [AddCommMonoid P] (n : ℕ) :
    Multiplicative P →* Γ(Spec (.of (toricPolynomialRing ℚ P n)), ⊤) :=
  (Scheme.ΓSpecIso (.of (toricPolynomialRing ℚ P n))).inv.hom.toMonoidHom.comp
    (toricPolynomialChart ℚ P n)

/-- Interpret the completed chart as global sections of its affine scheme.
Source: ILO VI 1.6(i), p.70
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def completedToricGlobalChart (k : Type u) (P : Type v) [CommRing k] [AddCommMonoid P]
    (n : ℕ) : Multiplicative P →* Γ(Spec (.of (toricCompletedRing k P n)), ⊤) :=
  (Scheme.ΓSpecIso (.of (toricCompletedRing k P n))).inv.hom.toMonoidHom.comp
    (toricCompletedChart k P n)

/-- The product ring map corresponding contravariantly to the finite disjoint union
of completed toric chart morphisms. Its coordinates are the prescribed monomial maps.
Source: ILO VIII, proof of 3.4.15, p.114
(blueprint: lem-per-rational-toric-completion-regular-map). -/
noncomputable def rationalToricCompletionUnionMap {I : Type u}
    (k P : I → Type u) [∀ i, Field (k i)] [∀ i, CharZero (k i)]
    [∀ i, AddCommMonoid (P i)] (n : I → ℕ) :
    (∀ i, toricPolynomialRing ℚ (P i) (n i)) →+*
      (∀ i, toricCompletedRing (k i) (P i) (n i)) :=
  RingHom.pi (fun i ↦ (rationalToricCompletionMap (k i) (P i) (n i)).comp
    (Pi.evalRingHom (fun j ↦ toricPolynomialRing ℚ (P j) (n j)) i))

/-- The completed rational toric model is reduced, Noetherian, excellent and local;
the prescribed rational monomial map is regular. The two associated chart log
structures are fs log regular and their chart-compatible map is strict. Finite
unions have reduced Noetherian excellent rational coordinate rings and a regular
map, the input and morphism conditions for ordinary regular-functorial resolution.

Source: ILO VI 1.6(i), p.70; VIII proof of Theorem 3.4.15, p.114
(blueprint: lem-per-rational-toric-completion-regular-map).

Proof:
1. The monomial and variable ideal has residue field k. Finite generation of P
makes both polynomial monoid rings finite type over their fields, hence excellent
by lem-exc-fields-excellent and lem-exc-finite-type-localization-excellent.
Localizing at the displayed maximal ideal does not change any power quotient:
for s = c + u, c nonzero in k and u in the ideal, the finite geometric series
c⁻¹ sum_{a<j} (-u/c)^a inverts s modulo its jth power. Thus the completions agree.
2. Apply lem-trf-formal-monoid-ring-dimension to P ⊕ ℕⁿ over the complete regular
local ring k (lem-weil-pbc-field-regular-ring). This yields a Noetherian local domain,
hence reduced. The completion is complete by lem-weil-pbc-adic-completion-mod-ideal,
and lem-per-complete-local-excellence yields excellence.
3. The map ℚ → k is flat (lem-weil-pbc-module-over-field-flat). Characteristic zero
makes finite purely inseparable extensions trivial, so it is geometrically regular
(def-weil-pbc-finite-purely-inseparable-extension and def-weil-pbc-g-ring).
The monomial basis identifies its finite-type base change with ℚ[P][t] → k[P][t];
apply lem-weil-pbc-regular-base-change. No finite-generation condition on k/ℚ is used.
4. Localization is regular: lem-weil-pbc-localization-flat gives flatness, and its
fibres are fields or zero rings. The excellent local ring is a G-ring, so its
completion map is regular. Compose these maps by lem-weil-pbc-regular-composition;
all fibre rings are Noetherian quotients of localizations of Noetherian targets,
using lem-weil-pbc-localization-noetherian and lem-weil-pbc-finite-type-algebra-noetherian.
5. Logify the actual P charts using lem-per-integral-chart-logification-thickening.
The compatible map is canonical by its chart images and unit compatibility.
Its pullback log structure is the associated log structure of the same composite
chart, so the universal property proves strictness, with its induced graph.
6. The sharp fs monoid has finite free group completion by lem-trf-fs-face-sharpening.
The toric polynomial scheme is log smooth over the trivially logged rational field:
the comparison is a polynomial projection (lem-weil-pbc-polynomial-ring-smooth,
def-sbc-smooth-morphisms). Apply lem-per-log-smooth-invertible-torsion-log-regular.
7. At a geometric point, lem-per-regular-strict-local-model gives a regular map
of strict local rings C → B, and of stratum quotients C/I → B/IB. The latter is
regular by lem-weil-pbc-regular-map-ascent. The two flat local maps have the same
closed fibre E. The dimension formula lem-weil-pbc-flat-height-formula gives
 dim B = dim C + dim E = dim(C/I) + rank + dim E = dim(B/IB) + rank.
This is log regularity; no finite-presentation hypothesis is used for completion.
8. Normality of the rational toric scheme follows from
lem-trf-log-regular-divisorial-structure; both schemes are reduced and excellent
(lem-trf-excellent-scheme-affine-cover), hence satisfy the input conditions of
lem-per-qe-ordinary-regular-resolution. Finite disjoint unions preserve these
properties and regularity componentwise. The empty union is Spec of the zero ring.
9. For P = 0 and n = 0 the rings are ℚ and k, the ideal is zero and both logs
are trivial. The map is precisely ℚ → k. The same argument permits either P = 0
or n = 0 separately and arbitrary algebraic or transcendental k/ℚ.
-/
theorem rationalToricCompletion_regular (P k : Type u) [AddCommMonoid P] [Field k]
    [CharZero k] (hfs : IsFineSaturatedMonoid (Multiplicative P))
    (hsharp : ∀ p : P, IsUnit (Multiplicative.ofAdd p) → p = 0) (n : ℕ) :
    _root_.IsReduced (toricCompletedRing k P n) ∧
    IsNoetherianRing (toricCompletedRing k P n) ∧
    IsExcellent (toricCompletedRing k P n) ∧
    IsLocalRing (toricCompletedRing k P n) ∧
    (rationalToricCompletionMap k P n).IsRegular ∧
    (∃ (hX : IsLocallyNoetherian (Spec (.of (toricCompletedRing k P n))))
      (hY : IsLocallyNoetherian (Spec (.of (toricPolynomialRing ℚ P n))))
      (LX : EtaleLogStructure (Spec (.of (toricCompletedRing k P n))))
      (LY : EtaleLogStructure (Spec (.of (toricPolynomialRing ℚ P n))))
      (fsX : LX.IsFineSaturated) (fsY : LY.IsFineSaturated)
      (ηX : associatedLogPresheaf (completedToricGlobalChart k P n) ⟶ LX.monoidSheaf.obj)
      (ηY : associatedLogPresheaf (rationalToricGlobalChart P n) ⟶ LY.monoidSheaf.obj)
      (f : EtaleLogHom ⟨_, hX, LX, fsX⟩ ⟨_, hY, LY, fsY⟩),
      IsAssociatedLogPresentation (completedToricGlobalChart k P n) LX ηX ∧
      IsAssociatedLogPresentation (rationalToricGlobalChart P n) LY ηY ∧
      f.base = Spec.map (CommRingCat.ofHom (rationalToricCompletionMap k P n)) ∧
      (∀ p : ULift.{u} (Multiplicative P),
        f.sectionMap (Scheme.Etale.mk (𝟙 _)) (Scheme.Etale.mk (𝟙 _)) f.base
          ((Category.comp_id f.base).trans (Category.id_comp f.base).symm)
          (associatedLogIota (rationalToricGlobalChart P n) LY ηY p) =
            associatedLogIota (completedToricGlobalChart k P n) LX ηX p) ∧
      f.IsStrict ∧
      (FineSaturatedLogScheme.mk _ hX LX fsX).IsLogRegular ∧
      (FineSaturatedLogScheme.mk _ hY LY fsY).IsLogRegular) ∧
    (∀ (I : Type u) [Finite I] (K Q : I → Type u)
      [∀ i, Field (K i)] [∀ i, CharZero (K i)] [∀ i, AddCommMonoid (Q i)]
      (m : I → ℕ),
      (∀ i, IsFineSaturatedMonoid (Multiplicative (Q i))) →
      (∀ i, ∀ p : Q i, IsUnit (Multiplicative.ofAdd p) → p = 0) →
      _root_.IsReduced (∀ i, toricCompletedRing (K i) (Q i) (m i)) ∧
      IsNoetherianRing (∀ i, toricCompletedRing (K i) (Q i) (m i)) ∧
      IsExcellent (∀ i, toricCompletedRing (K i) (Q i) (m i)) ∧
      _root_.IsReduced (∀ i, toricPolynomialRing ℚ (Q i) (m i)) ∧
      IsNoetherianRing (∀ i, toricPolynomialRing ℚ (Q i) (m i)) ∧
      IsExcellent (∀ i, toricPolynomialRing ℚ (Q i) (m i)) ∧
      (rationalToricCompletionUnionMap K Q m).IsRegular) := by
  sorry

end AlgebraicGeometry
