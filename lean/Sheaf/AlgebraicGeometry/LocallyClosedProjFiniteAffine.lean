module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.Immersion
import WeilConjectures.AlgebraicGeometry.ProjStandardOpenProperties
import WeilConjectures.RingTheory.GradedPrimeAvoidance

/-! # Affine neighbourhoods of finite sets in locally closed Proj subschemes

Source: Stacks Project, Properties, Tag 01ZY, proof of case (4), with standard opens
chosen inside the prescribed ambient open (blueprint: lem-sfb-locally-closed-proj-finite-affine).

## Main statements

* `AlgebraicGeometry.Proj.exists_basicOpen_subset_isAffineOpen_preimage`: a finite set in a
  closed subscheme of an open of Proj has an ambient standard affine neighbourhood.
* `AlgebraicGeometry.Proj.exists_isAffineOpen_of_isImmersion`: every finite set in a scheme
  admitting an immersion into Proj lies in an affine open.
-/

@[expose] public section

universe u v

open CategoryTheory

namespace AlgebraicGeometry.Proj

/-- A finite set in a closed subscheme of an open of Proj is contained in a positive-degree
standard open inside that ambient open, whose inverse image is affine.

Source: Stacks Project, Properties, Tag 01ZY, proof of case (4), with the standard opens
chosen inside the given open (blueprint: lem-sfb-locally-closed-proj-finite-affine).

Proof:
1. For the empty set, take zero in degree one. Its standard open and its inverse image
   are empty, and the latter is affine.
2. Otherwise, use clause (0) of `lem-weil-pbc-proj-standard-open-inclusion`
   (`standardOpenProperties`) to choose one positive-degree homogeneous standard open
   about each image point, contained in the given ambient open.
3. The ideal generated by these finitely many elements is homogeneous: the degree-n
   component of a sum of multiples of the generators is the sum of the corresponding
   homogeneous components of those multiples. It lies in the irrelevant ideal and is
   not contained in any of the homogeneous primes representing the image points.
4. Apply `lem-sc-graded-prime-avoidance` to obtain a positive-degree homogeneous element
   of this ideal outside all those primes. Its standard open contains the image set.
5. A prime containing all the generators contains the ideal and the chosen element.
   Hence the chosen standard open is contained in the union of the original standard
   opens, and therefore in the prescribed ambient open.
6. By `def-pc-proj` the chosen standard open is affine. By the affine characterization
   of `def-weil-closed-immersion`, its inverse image is the spectrum of a quotient of
   its coordinate ring, and is therefore an affine open of the source.
-/
theorem exists_basicOpen_subset_isAffineOpen_preimage
    {S : Type u} [CommRing S] {σ : Type v} [SetLike σ S] [AddSubgroupClass σ S]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (O : (Proj 𝒜).Opens)
    {X : Scheme.{u}} (j : X ⟶ O.toScheme) [IsClosedImmersion j]
    (E : Set X) (_hE : E.Finite) :
    ∃ (d : ℕ) (f : S), 0 < d ∧ f ∈ 𝒜 d ∧
      (j ≫ O.ι) '' E ⊆ (basicOpen 𝒜 f : Set (Proj 𝒜)) ∧
      basicOpen 𝒜 f ≤ O ∧ IsAffineOpen ((j ≫ O.ι) ⁻¹ᵁ basicOpen 𝒜 f) := by
  sorry

/-- Every finite subset of a scheme admitting a locally closed immersion into Proj
is contained in an affine open.

Source: Stacks Project, Properties, Tag 01ZY, case (4)
(blueprint: lem-sfb-locally-closed-proj-finite-affine).

Proof: factor the immersion into a closed immersion into an open of Proj followed
by its open inclusion, as in `def-weil-closed-immersion`. Apply the preceding
standard-open neighbourhood assertion to this factorization. The inverse image
of that standard open is an affine open containing the given finite subset.
The empty set is allowed, with zero in degree one as in step 1 above.
-/
theorem exists_isAffineOpen_of_isImmersion
    {S : Type u} [CommRing S] {σ : Type v} [SetLike σ S] [AddSubgroupClass σ S]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] {X : Scheme.{u}}
    (i : X ⟶ Proj 𝒜) [IsImmersion i] (E : Set X) (_hE : E.Finite) :
    ∃ U : X.Opens, E ⊆ (U : Set X) ∧ IsAffineOpen U := by
  sorry

end AlgebraicGeometry.Proj
