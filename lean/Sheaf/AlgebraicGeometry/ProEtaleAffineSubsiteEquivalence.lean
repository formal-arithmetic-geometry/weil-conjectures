module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import Mathlib.CategoryTheory.Sites.Finite
public import Mathlib.CategoryTheory.Sites.Sheaf
public import Sheaf.CategoryTheory.SiteCoveringAxioms

import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.AlgebraicGeometry.Pullbacks
import Mathlib.AlgebraicGeometry.Morphisms.Affine
import Mathlib.AlgebraicGeometry.Morphisms.Etale
import Mathlib.AlgebraicGeometry.Sites.Fpqc
import WeilConjectures.CategoryTheory.SpecialCocontinuousCoverings
import Sheaf.CategoryTheory.SpecialCocontinuousSheafEquivalence
import Sheaf.AlgebraicGeometry.EtaleComparison
import Sheaf.AlgebraicGeometry.WeaklyEtaleStability

/-!
# The full affine weakly étale subsite

Source: Stacks Project, Pro-étale Cohomology, Tags 098E and 098W
(blueprint: lem-sfb-proetale-affine-subsite-equivalence).

The objects are all affine objects of `Scheme.ProEt`, without an ind-étale presentation
condition. The topology is generated by finite pro-étale covering presieves.

## Main definitions

* `affineSource` and `AffineWeaklyEtale`: the full subcategory of affine sources.
* `affineWeaklyEtaleInclusion`: its full inclusion into the small pro-étale site.
* `affineWeaklyEtalePrecoverage` and `affineWeaklyEtaleTopology`: finite standard covers
  and the topology they generate.

## Main statement

* `affineWeaklyEtale_sheafEquivalence`: restriction induces an equivalence of sheaf topoi.
-/

@[expose] public section

set_option autoImplicit false

universe u v

open CategoryTheory

namespace AlgebraicGeometry.Scheme.ProEt

/-- The property of having affine source in the small weakly étale site.
Source: Stacks Project, Tag 098W (blueprint: lem-sfb-proetale-affine-subsite-equivalence).
This property imposes no affine or quasi-compact condition on the base scheme. -/
def affineSource (X : Scheme.{u}) : ObjectProperty X.ProEt :=
  fun U ↦ IsAffine U.left

/-- The full subcategory of all affine weakly étale objects over `X`.
Source: Stacks Project, Tag 098W (blueprint: lem-sfb-proetale-affine-subsite-equivalence).
Its objects have universe `u + 1` and its morphisms have universe `u`, as for `X.ProEt`. -/
abbrev AffineWeaklyEtale (X : Scheme.{u}) : Type (u + 1) :=
  (affineSource X).FullSubcategory

/-- The full inclusion of affine weakly étale objects into the small pro-étale site.
Source: Stacks Project, Tag 098W (blueprint: lem-sfb-proetale-affine-subsite-equivalence).
It sends an object to its underlying weakly étale map and a morphism to the same `X`-map. -/
def affineWeaklyEtaleInclusion (X : Scheme.{u}) : AffineWeaklyEtale X ⥤ X.ProEt :=
  (affineSource X).ι

/-- Standard coverings of the full affine weakly étale subcategory.
Source: Stacks Project, Tag 098E (blueprint: lem-sfb-proetale-affine-subsite-equivalence).
A covering is a finite presieve whose image is a pro-étale covering presieve. Equivalently,
it is a finite jointly surjective family of weakly étale maps of affine schemes. Repeated
arrows in an indexed presentation do not change the presieve or the generated topology.
In particular the empty family covers the empty affine scheme. -/
def affineWeaklyEtalePrecoverage (X : Scheme.{u}) : Precoverage (AffineWeaklyEtale X) :=
  Precoverage.finite _ ⊓ (precoverage X).comap (affineWeaklyEtaleInclusion X)

/-- The Grothendieck topology generated by standard finite affine pro-étale coverings.
Source: Stacks Project, Tags 098E and 098W
(blueprint: lem-sfb-proetale-affine-subsite-equivalence). -/
def affineWeaklyEtaleTopology (X : Scheme.{u}) :
    GrothendieckTopology (AffineWeaklyEtale X) :=
  (affineWeaklyEtalePrecoverage X).toGrothendieck

/-- Restriction to all affine weakly étale objects is an equivalence of sheaf topoi.
Source: Stacks Project, Tag 098W (blueprint: lem-sfb-proetale-affine-subsite-equivalence).
The natural isomorphism identifies the forward functor with precomposition by the full
inclusion, on both sections and morphisms. An equivalence of these sheaf categories is an
equivalence of topoi: its quasi-inverse is adjoint and it preserves finite limits.
The set universe is any `max (u + 1) v`, without identifying site object and hom universes.

Proof (the six steps of the reviewed DAG):
1. For any weakly étale `U → X`, its affine opens are again weakly étale over `X`:
   open immersions are étale (lem-weil-pbc-open-immersion-etale), hence weakly étale
   (det-pe-morphisms-etale-comparison), and weakly étale maps compose
   (sk-lem-pe-weakly-etale-stability). They cover by lem-weil-pbc-affine-opens-basis.
   For each affine open `W` of `U`, the member `W` itself witnesses the finite affine
   refinement in def-weil-pbc-proetale-site. Thus image objects cover every object.
2. A finite weakly étale family between affine schemes is a pro-étale covering exactly
   when jointly surjective. Necessity uses the affine open equal to the target.
   For sufficiency pull the family back over any affine open of the target: the
   inverse images are affine by lem-weil-pbc-morphism-affine-schemes-affine, and
   their images cover that open. These are exactly the standard coverings of 098E.
3. Pullbacks over an affine target are affine by lem-weil-pbc-fibre-product-affine-spectra.
   Weak étaleness is stable under base change and composition by
   sk-lem-pe-weakly-etale-stability. The fpqc covering axioms
   (lem-weil-pbc-fpqc-covering-axioms) then give the site axioms; composites and
   pullbacks of finite standard coverings remain finite. The inclusion preserves
   these coverings and their pullbacks, so is continuous in the convention of
   def-weil-pbc-sites-and-cohomology.
4. A pro-étale covering of an affine object has a finite affine refinement by the
   defining covering condition of def-weil-pbc-proetale-site. Its affine opens
   remain weakly étale by step 1 and stability. Step 2 makes the refinement standard;
   its arrows factor through members of the original covering. This is cocontinuity
   as in def-weil-pbc-special-cocontinuous-functor.
5. The inclusion is full and faithful. Singleton identity coverings therefore witness
   local fullness and local faithfulness. Steps 1, 3 and 4 give the other conditions
   of def-weil-pbc-special-cocontinuous-functor.
6. Use compatible universes and skeletons and apply
   lem-weil-pbc-special-cocontinuous-sheaf-equivalence (Sites Tag 03A0). The inverse
   image is precomposition with the inclusion. Thus the equivalence's forward
   functor is restriction, as the displayed natural isomorphism states. The full
   site has object universe `u + 1` and hom universe `u`; use the comparison after
   compatible enlargement of hom universes, or its equivalent dense-subsite form.
   No quasi-compactness or separatedness of `X` is used in any of the six steps. -/
theorem affineWeaklyEtale_sheafEquivalence (X : Scheme.{u}) :
    ∃ e : Sheaf (topology X) (Type (max (u + 1) v)) ≌
        Sheaf (affineWeaklyEtaleTopology X) (Type (max (u + 1) v)),
      Nonempty
        (e.functor ⋙
            sheafToPresheaf (affineWeaklyEtaleTopology X) (Type (max (u + 1) v)) ≅
          sheafToPresheaf (topology X) (Type (max (u + 1) v)) ⋙
            (Functor.whiskeringLeft _ _ (Type (max (u + 1) v))).obj
              (affineWeaklyEtaleInclusion X).op) := by
  sorry

end AlgebraicGeometry.Scheme.ProEt
