module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.AlgebraicGeometry.Morphisms.Proper
public import Mathlib.AlgebraicGeometry.OpenImmersion
public import Mathlib.CategoryTheory.Comma.Over.Basic
public import Mathlib.CategoryTheory.Category.ULift
public import Mathlib.CategoryTheory.Sites.InducedTopology
public import Sheaf.CategoryTheory.SiteCoveringAxioms
public import Sheaf.CategoryTheory.Sites.GrothendieckTopos

/-!
# The big ph site of a scheme

Source: Stacks Project, Topologies, Section 0DBC, Definition 0DBL and Lemma 0DBQ
(blueprint: def-trf-ph-scheme-site).

The ph topology is generated by Zariski covering families and singleton proper surjections.
The category `Over S` includes all schemes of universe `u` and all morphisms over `S`.
Its `AsSmall` presentation has both objects and morphisms in the larger universe
`max w (u + 1)`, which is also the universe of the sets used as sheaf values.
-/

@[expose] public section

set_option autoImplicit false

universe u w

open CategoryTheory

namespace AlgebraicGeometry.Scheme

/-- The smallest Grothendieck topology on schemes over `S` containing the sieves generated
by every jointly surjective family of open immersions and by each proper surjection.
The infimum ranges over all topologies satisfying exactly these two generator conditions.
Source: Stacks, Section 0DBC and Lemma 0DBQ (blueprint: def-trf-ph-scheme-site). -/
def phTopology (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  sInf {J : GrothendieckTopology (Over S) |
    (∀ (T : Over S) (I : Type (u + 1)) (U : I → Over S) (f : ∀ i, U i ⟶ T),
      (∀ i, IsOpenImmersion (f i).left) →
      (∀ x : T.left, ∃ (i : I) (y : (U i).left), (f i).left y = x) →
      Sieve.generate (Presieve.ofArrows U f) ∈ J T) ∧
    (∀ (T V : Over S) (f : V ⟶ T), IsProper f.left → Function.Surjective f.left →
      Sieve.generate (Presieve.singleton f) ∈ J T)}

/-- A small presentation of the category of all schemes over `S` in the chosen universe.
The canonical equivalence `AsSmall.equiv` retains every scheme and every `S`-morphism.
Source: Stacks, Definition 0DBL, with the size convention of the blueprint
(blueprint: def-trf-ph-scheme-site). -/
abbrev phSiteModel (S : Scheme.{u}) := AsSmall.{max w (u + 1)} (Over S)

/-- The ph topology transported to the small presentation along its canonical equivalence.
Source: Stacks, Definition 0DBL and Lemma 0DBQ
(blueprint: def-trf-ph-scheme-site). -/
noncomputable abbrev phModelTopology (S : Scheme.{u}) :
    GrothendieckTopology (phSiteModel.{u, w} S) :=
  (AsSmall.down : phSiteModel.{u, w} S ⥤ Over S).inducedTopology (phTopology S)

/-- The sheaf topos of the big ph site, with sets in the presentation's larger universe.
Its morphisms are the natural transformations between ph sheaves, as in Mathlib's `Sheaf`.
Source: Stacks, Definition 0DBL and Lemma 0DBQ
(blueprint: def-trf-ph-scheme-site). -/
abbrev PhSheaf (S : Scheme.{u}) := Sheaf (phModelTopology.{u, w} S) (Type (max w (u + 1)))

end AlgebraicGeometry.Scheme
