module

public import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
public import Sheaf.AlgebraicGeometry.NormalCrossingsDivisor
public import WeilConjectures.AlgebraicGeometry.ReducedInducedClosedSubscheme

/-!
# A reduced boundary on one free logarithmic chart

Source: ILO VI 1.4, 1.6--1.7, pp. 69--70, VIII 3.4.4, p. 110.
(blueprint: lem-trf-free-characteristic-boundary-chart).
-/

@[expose] public section

set_option autoImplicit false

universe u
open CategoryTheory

namespace AlgebraicGeometry.FineSaturatedLogScheme

/-- Freeness at one geometric point gives one etale neighbourhood with a dense open
triviality locus and reduced normal crossings complement. No assertion about the global
boundary, global openness, or the other points of X is assumed or concluded.

Source: ILO VI 1.4, 1.6--1.7, pp. 69--70, VIII 3.4.4, p. 110.
(blueprint: lem-trf-free-characteristic-boundary-chart).

Proof:
Choose an affine locally Noetherian pointed sharp chart at t. Transport its monoid along
the given isomorphism with N^r. Restrict the log structure to the etale chart and transport
sections through the canonical slice-site equivalence, giving the specified free chart on
its identity neighbourhood. Apply `freeLogChart_ordinary_parameters`. It makes the chart
regular and identifies the inverse image of the triviality locus with the basic open of
the product f of its structural coordinates. At each ordinary point the nonunit
coordinates, in their original order, extend to a regular system of parameters.
Reindex the finite coordinates by Fin r and apply `parameter_product_reduced_cartier`.
The principal subscheme V(f) is reduced effective Cartier, and D(f) is dense. Its support
is exactly the closed complement of D(f). Uniqueness of the reduced induced structure
identifies its principal ideal sheaf with the vanishing ideal of this complement.
At each chart point choose an affine neighbourhood. The stalk ideal of this principal
sheaf is generated by the germ of f. Removing unit coordinate factors does not change
its principal ideal, and the remaining ordered factors form a sublist of the regular
parameters just obtained. This is the normal crossings criterion, witnessed by the identity
etale neighbourhood. The original pointed lift supplies the ordinary point w above t.
For r = 0 the product is 1, its basic open is the whole chart and its boundary is empty;
the parameter sublist is empty. These same arguments allow an empty boundary in any rank. -/
theorem exists_free_characteristic_boundary_chart
    (X : FineSaturatedLogScheme.{u}) (hlog : X.IsLogRegular)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X.scheme)
    (hfree : ∃ r : ℕ, Nonempty
      (X.logStructure.characteristic t ≃* Multiplicative (Fin r → ℕ))) :
    ∃ (W : X.scheme.Etale) (w : W.left),
      W.hom w = (Scheme.SpecToEquivOfField Ω X.scheme t).1 ∧
      ∃ V : W.left.Opens,
        (V : Set W.left) = W.hom ⁻¹' X.logStructure.trivialityLocus ∧
        Dense (V : Set W.left) ∧
        (Scheme.IdealSheafData.vanishingIdeal
          ⟨(V : Set W.left)ᶜ, V.isOpen.isClosed_compl⟩).IsNormalCrossingsDivisor := by sorry

end AlgebraicGeometry.FineSaturatedLogScheme
