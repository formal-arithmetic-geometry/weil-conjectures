/-!
# Regular coordinate intersections and their étale transport

Source: Illusie--Laszlo--Orgogozo, Travaux de Gabber, Exposé VIII, 4.1.8 and 4.2.4,
printed pp. 118--119; Stacks Tags 00NQ, 00NP, 00U4, 07QP, 01T6 and 01JU
(blueprint: lem-trf-etale-coordinate-intersection-geometry).

The two helper definitions abbreviate the canonical ideals in the displayed statement,
using Mathlib's existing ideal sheaf construction and ordinary ideal span.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

/-- The ideal sheaf generated by the indicated global coordinate functions.
Source: ILO VIII 4.2.4, p. 119; Stacks Tag 01QO
(blueprint: lem-trf-etale-coordinate-intersection-geometry). -/
def coordinateIntersectionIdeal {U : Scheme.{u}} {s : ℕ}
    (t : Fin s → Γ(U, ⊤)) (J : Finset (Fin s)) : U.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (Ideal.span (t '' (J : Set (Fin s))))

/-- The ideal generated by the same coordinates in the ambient local ring.
Source: ILO VIII 4.2.4, p. 119; Stacks Tags 01HV and 00CT
(blueprint: lem-trf-etale-coordinate-intersection-geometry). -/
def coordinateIntersectionStalkIdeal {U : Scheme.{u}} {s : ℕ}
    (t : Fin s → Γ(U, ⊤)) (J : Finset (Fin s)) (x : U) :
    Ideal (U.presheaf.stalk x) :=
  Ideal.span ((fun j ↦ U.presheaf.germ ⊤ x trivial (t j)) '' (J : Set (Fin s)))

private theorem regular_quotient_positions {R : Type u} [CommRing R]
    [IsRegularLocalRing R] (p : List R) (hp : IsLocalRing.IsRegularSystemOfParameters p)
    (S : Finset (Fin p.length)) :
    IsRegularLocalRing (R ⧸ Ideal.span (p.get '' (S : Set (Fin p.length)))) := by
  classical
  let a := S.toList
  let b := (Finset.univ \ S).toList
  have hn : (a ++ b).Nodup := by
    simp only [a, b, List.nodup_append, Finset.nodup_toList, true_and]
    intro x hx y hy hxy
    subst y
    exact (Finset.mem_sdiff.mp (Finset.mem_toList.mp hy)).2 (Finset.mem_toList.mp hx)
  have hi : (a ++ b).Perm (List.finRange p.length) := by
    apply (List.perm_ext_iff_of_nodup hn (List.nodup_finRange _)).mpr
    intro x
    simp only [List.mem_append, a, b, Finset.mem_toList, Finset.mem_sdiff,
      Finset.mem_univ, true_and, List.mem_finRange, iff_true]
    exact em _
  let q := (a ++ b).map p.get
  have hperm : p.Perm q := by
    have hh := (hi.map p.get).symm
    rw [List.map_get_finRange] at hh
    exact hh
  have hqp := (IsRegularLocalRing.isRegular_and_quotients_of_generators R p.length
    hp.2.symm p hp).2.2 q hperm
  have hc : a.length ≤ p.length := by
    have hh := hi.length_eq
    simp only [List.length_append, List.length_finRange] at hh
    omega
  have hq := (IsRegularLocalRing.isRegular_and_quotients_of_generators R p.length
    hp.2.symm q hqp.1).2.1 a.length hc
  have he : Ideal.ofList (q.take a.length) =
      Ideal.span (p.get '' (S : Set (Fin p.length))) := by
    simp only [q, List.map_append, Ideal.ofList]
    congr 1
    ext x
    simp [a]
  rw [he] at hq
  exact hq.1

private theorem coordinate_quotient {U : Scheme.{u}} {s : ℕ}
    (t : Fin s → Γ(U, ⊤)) (J : Finset (Fin s))
    (z : (coordinateIntersectionIdeal t J).subscheme) :
    ∃ q : (U.presheaf.stalk ((coordinateIntersectionIdeal t J).subschemeι z) ⧸
        coordinateIntersectionStalkIdeal t J
          ((coordinateIntersectionIdeal t J).subschemeι z)) ≃+*
        (coordinateIntersectionIdeal t J).subscheme.presheaf.stalk z,
      ∀ a, q (Ideal.Quotient.mk _ a) =
        ((coordinateIntersectionIdeal t J).subschemeι.stalkMap z) a := by
  let I := coordinateIntersectionIdeal t J
  obtain ⟨V, hV, hx, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    U.isBasis_affineOpens (TopologicalSpace.Opens.mem_top (I.subschemeι z))
  have hk : RingHom.ker (I.subschemeι.stalkMap z).hom =
      coordinateIntersectionStalkIdeal t J (I.subschemeι z) := by
    rw [I.subschemeι.ker_stalkMap ⟨V, hV⟩ z hx, I.ker_subschemeι]
    simp only [I, coordinateIntersectionIdeal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_span, Set.image_image]
    congr 2
    funext j
    exact U.presheaf.germ_res_apply _ _ _ _
  refine ⟨(Ideal.quotEquivOfEq hk.symm).trans
    ((I.subschemeι.stalkMap z).hom.quotientKerEquivOfSurjective
      (I.subschemeι.stalkMap_surjective z)), ?_⟩
  intro a
  rfl

private theorem coordinate_baseChange {U W : Scheme.{u}} {s : ℕ}
    (t : Fin s → Γ(U, ⊤)) (e : W ⟶ U) (J : Finset (Fin s)) :
    ∃ i : pullback (coordinateIntersectionIdeal t J).subschemeι e ≅
        (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subscheme,
      i.hom ≫ (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subschemeι =
        pullback.snd (coordinateIntersectionIdeal t J).subschemeι e := by
  let I := coordinateIntersectionIdeal t J
  have h : I.comap e = coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J := by
    simp only [I, coordinateIntersectionIdeal, Scheme.IdealSheafData.comap_ofIdealTop,
      Ideal.map_span, Set.image_image]
  refine ⟨pullbackSymmetry _ _ ≪≫ (I.comapIso e).symm ≪≫
    eqToIso (congrArg Scheme.IdealSheafData.subscheme h), ?_⟩
  have hh : (eqToIso (congrArg Scheme.IdealSheafData.subscheme h)).hom ≫
      (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subschemeι =
      (I.comap e).subschemeι := by
    generalize I.comap e = A at h ⊢
    generalize coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J = B at h ⊢
    cases h
    simp
  simp only [Iso.trans_hom, Category.assoc]
  rw [hh]
  simp only [Iso.symm_hom, Scheme.IdealSheafData.comapIso_inv_subschemeι]
  exact pullbackSymmetry_hom_comp_fst I.subschemeι e

private theorem etale_stalk_dimension {U W : Scheme.{u}} (e : W ⟶ U) [Etale e]
    (w : W) : ringKrullDim (U.presheaf.stalk (e w)) =
      ringKrullDim (W.presheaf.stalk w) := by
  obtain ⟨V, hV, hx, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    U.isBasis_affineOpens (TopologicalSpace.Opens.mem_top (e w))
  obtain ⟨T, hT, hw, hTV⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    W.isBasis_affineOpens (show w ∈ e ⁻¹ᵁ V from hx)
  let a := IsAffineOpen.arrowStalkMapIso e V hV T hT hTV hw
  have hd := RingHom.Etale.ringKrullDim_localization_eq
    (e.appLE V T hTV).hom (e.etale_appLE hV hT hTV)
    (hT.primeIdealOf ⟨w, hw⟩).asIdeal
  have hp := IsAffineOpen.comap_primeIdealOf_appLE V hV T hT hTV hw
  have hd' : ringKrullDim
      (Localization.AtPrime (hV.primeIdealOf ⟨e w, hTV hw⟩).asIdeal) =
      ringKrullDim (Localization.AtPrime (hT.primeIdealOf ⟨w, hw⟩).asIdeal) := by
    have hh := congrArg (fun p : PrimeSpectrum Γ(U, V) ↦
      ringKrullDim (Localization.AtPrime p.asIdeal)) hp
    exact hh.symm.trans hd
  exact (ringKrullDim_eq_of_ringEquiv
    (Arrow.leftFunc.mapIso a).commRingCatIsoToRingEquiv).trans
    (hd'.trans (ringKrullDim_eq_of_ringEquiv
      (Arrow.rightFunc.mapIso a).commRingCatIsoToRingEquiv).symm)

private theorem etale_parameters {U W : Scheme.{u}} (hU : IsRegularScheme U)
    (e : W ⟶ U) [Etale e] (w : W) :
    ∃ hNW : IsNoetherianRing (W.presheaf.stalk w),
      ∀ (hNU : IsNoetherianRing (U.presheaf.stalk (e w)))
        (p : List (U.presheaf.stalk (e w))),
        @IsLocalRing.IsRegularSystemOfParameters _ _ _ hNU p →
          @IsLocalRing.IsRegularSystemOfParameters _ _ _ hNW
            (p.map (fun a ↦ e.stalkMap w a)) := by
  have := hU.1
  have : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian e
  refine ⟨inferInstance, ?_⟩
  intro hN p hp
  constructor
  · rw [← FormallyUnramified.map_maximalIdeal_stalkMap e w, ← hp.1, Ideal.map_span]
    congr 1
    ext a
    simp
  · rw [List.length_map, hp.2, etale_stalk_dimension e w]

private theorem coordinate_regular {U : Scheme.{u}} (hU : IsRegularScheme U)
    {s : ℕ} (t : Fin s → Γ(U, ⊤))
    (hcoord : ∀ x : U,
      ∃ (hN : IsNoetherianRing (U.presheaf.stalk x)) (p : List (U.presheaf.stalk x)),
        @IsLocalRing.IsRegularSystemOfParameters _ _ _ hN p ∧
        ∃ pos : {j : Fin s // U.Γevaluation x (t j) = 0} ↪ Fin p.length,
          ∀ j, p.get (pos j) = U.presheaf.germ ⊤ x trivial (t j.1))
    (J : Finset (Fin s)) :
    IsRegularScheme (coordinateIntersectionIdeal t J).subscheme ∧
      IsReduced (coordinateIntersectionIdeal t J).subscheme := by
  classical
  have := hU.1
  have := hU.2
  let I := coordinateIntersectionIdeal t J
  have : IsLocallyNoetherian I.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian I.subschemeι
  have hr (z : I.subscheme) : IsRegularLocalRing (I.subscheme.presheaf.stalk z) := by
    let x := I.subschemeι z
    obtain ⟨q, hq⟩ := coordinate_quotient t J z
    have hvan (j : Fin s) (hj : j ∈ J) : U.Γevaluation x (t j) = 0 := by
      have hz : I.subschemeι.stalkMap z (U.presheaf.germ ⊤ x trivial (t j)) = 0 := by
        rw [← hq]
        have hm : U.presheaf.germ ⊤ x trivial (t j) ∈
            coordinateIntersectionStalkIdeal t J x :=
          Ideal.subset_span ⟨j, hj, rfl⟩
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hm, map_zero]
      change IsLocalRing.residue (U.presheaf.stalk x)
        (U.presheaf.germ ⊤ x trivial (t j)) = 0
      rw [IsLocalRing.residue_eq_zero_iff]
      rw [← IsLocalRing.maximalIdeal_comap (I.subschemeι.stalkMap z).hom]
      exact show I.subschemeι.stalkMap z (U.presheaf.germ ⊤ x trivial (t j)) ∈
        IsLocalRing.maximalIdeal (I.subscheme.presheaf.stalk z) from hz ▸ Ideal.zero_mem _
    obtain ⟨hN, p, hp, pos, hpos⟩ := hcoord x
    let f : {j : Fin s // j ∈ J} → Fin p.length := fun j ↦ pos ⟨j.1, hvan j.1 j.2⟩
    let S : Finset (Fin p.length) := Finset.univ.image f
    have he : Ideal.span (p.get '' (S : Set (Fin p.length))) =
        coordinateIntersectionStalkIdeal t J x := by
      congr 1
      ext a
      constructor
      · rintro ⟨k, hk, rfl⟩
        obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hk
        exact ⟨j.1, j.2, (hpos ⟨j.1, hvan j.1 j.2⟩).symm⟩
      · rintro ⟨j, hj, rfl⟩
        exact ⟨f ⟨j, hj⟩, Finset.mem_image.mpr ⟨⟨j, hj⟩, Finset.mem_univ _, rfl⟩,
          hpos ⟨j, hvan j hj⟩⟩
    have hreg := regular_quotient_positions p hp S
    rw [he] at hreg
    have := hreg
    exact IsRegularLocalRing.of_ringEquiv q
  have : IsRegular I.subscheme := ⟨hr⟩
  have (z : I.subscheme) : IsDomain (I.subscheme.presheaf.stalk z) := by
    have := hr z
    exact inferInstance
  exact ⟨⟨inferInstance, inferInstance⟩, isReduced_of_isReduced_stalk I.subscheme⟩

/-- All coordinate intersections are regular and reduced, their local rings are the
canonical coordinate quotients, and these assertions persist under every étale morphism.
The injection into `Fin p.length` records distinct positions, rather than just membership
in the set of parameter values. No intersection or étale source is required to be nonempty.
Source: ILO VIII 4.1.8 and 4.2.4, pp. 118--119; Stacks Tags 00NQ, 00NP, 00U4,
07QP, 01T6 and 01JU (blueprint: lem-trf-etale-coordinate-intersection-geometry).

Proof:
1. The closed-immersion stalk-kernel formula `Scheme.Hom.ker_stalkMap`, the affine
formula for `ofIdealTop`, and compatibility of restriction with germs identify the
kernel with the span of the coordinate germs. Surjectivity and the first isomorphism
theorem give the normalized quotient equivalence. The closed subscheme is locally
Noetherian by the locally finite type instance and `pqf-lem-locnoeth-lft`.
2. At a point of the intersection all selected coordinates vanish. Their distinct marked
positions in a full parameter list can be permuted to its first positions. Apply
`lem-weil-pbc-regular-local-generators-regular-sequence` to obtain regularity of the
quotient, and `lem-sc-regular-local-domain` to obtain an integral domain. Domains are
reduced, so the stalk criteria give regularity and reducedness of the intersection.
This includes the empty subset and, vacuously, empty intersections.
3. The existing étale-to-locally-finite-type instances and `pqf-lem-locnoeth-lft`
give local Noetherianity of the source.
4. Identify the stalk map with the localized affine ring map using
`IsAffineOpen.arrowStalkMapIso`. The maximal-ideal equality
`FormallyUnramified.map_maximalIdeal_stalkMap` and the dimension equality of
`lem-sc-etale-local-dimension` carry every parameter list to a parameter list.
The proved étale stalk-regularity theorem gives source regularity. These arguments
include dimension zero, where the parameter list is empty.
5. The induced residue-field map is injective, since a field homomorphism has zero kernel.
Compatibility with evaluation therefore preserves and reflects vanishing of every
coordinate. Transport the full parameter list from step 4 with the same marked positions.
6. `Scheme.IdealSheafData.comap_ofIdealTop` and `Ideal.map_span` identify the pulled-back
ideal with the ideal generated by the pulled-back coordinates. Compose `comapIso`
with pullback symmetry and the isomorphism from this equality to obtain the required
isomorphism over W. Repeat steps 1--2 for W and its pulled-back functions to obtain
regularity, local Noetherianity and reducedness, including every empty case.
-/
theorem etale_coordinate_intersection_geometry
    {U : Scheme.{u}} (hU : IsRegularScheme U)
    {s : ℕ} (hs : 1 ≤ s) (t : Fin s → Γ(U, ⊤))
    (hcoord : ∀ x : U,
      ∃ (hN : IsNoetherianRing (U.presheaf.stalk x)) (p : List (U.presheaf.stalk x)),
        @IsLocalRing.IsRegularSystemOfParameters _ _ _ hN p ∧
        ∃ pos : {j : Fin s // U.Γevaluation x (t j) = 0} ↪ Fin p.length,
          ∀ j, p.get (pos j) = U.presheaf.germ ⊤ x trivial (t j.1)) :
    IsIso (coordinateIntersectionIdeal t ∅).subschemeι ∧
    (∀ J : Finset (Fin s),
      IsRegularScheme (coordinateIntersectionIdeal t J).subscheme ∧
      IsReduced (coordinateIntersectionIdeal t J).subscheme ∧
      ∀ z : (coordinateIntersectionIdeal t J).subscheme,
        IsRegularLocalRing ((coordinateIntersectionIdeal t J).subscheme.presheaf.stalk z) ∧
        IsDomain ((coordinateIntersectionIdeal t J).subscheme.presheaf.stalk z) ∧
        ∃ q : (U.presheaf.stalk ((coordinateIntersectionIdeal t J).subschemeι z) ⧸
            coordinateIntersectionStalkIdeal t J
              ((coordinateIntersectionIdeal t J).subschemeι z)) ≃+*
            (coordinateIntersectionIdeal t J).subscheme.presheaf.stalk z,
          ∀ a, q (Ideal.Quotient.mk _ a) =
            ((coordinateIntersectionIdeal t J).subschemeι.stalkMap z) a) ∧
    (∀ {W : Scheme.{u}} (e : W ⟶ U) [Etale e],
      IsRegularScheme W ∧
      (∀ w : W,
        ∃ hNW : IsNoetherianRing (W.presheaf.stalk w),
          ∀ (hNU : IsNoetherianRing (U.presheaf.stalk (e w)))
            (p : List (U.presheaf.stalk (e w))),
            @IsLocalRing.IsRegularSystemOfParameters _ _ _ hNU p →
              @IsLocalRing.IsRegularSystemOfParameters _ _ _ hNW
                (p.map (fun a ↦ e.stalkMap w a))) ∧
      (∀ (w : W) (j : Fin s),
        W.Γevaluation w (e.appTop (t j)) = 0 ↔ U.Γevaluation (e w) (t j) = 0) ∧
      (∀ w : W,
        ∃ (hN : IsNoetherianRing (W.presheaf.stalk w))
          (p : List (W.presheaf.stalk w)),
          @IsLocalRing.IsRegularSystemOfParameters _ _ _ hN p ∧
          ∃ pos : {j : Fin s // W.Γevaluation w (e.appTop (t j)) = 0} ↪ Fin p.length,
            ∀ j, p.get (pos j) = W.presheaf.germ ⊤ w trivial (e.appTop (t j.1))) ∧
      ∀ J : Finset (Fin s),
        (∃ i : pullback (coordinateIntersectionIdeal t J).subschemeι e ≅
            (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subscheme,
          i.hom ≫ (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subschemeι =
            pullback.snd (coordinateIntersectionIdeal t J).subschemeι e) ∧
        IsRegularScheme
          (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subscheme ∧
        IsReduced (coordinateIntersectionIdeal (fun j ↦ e.appTop (t j)) J).subscheme) := by
  classical
  have _ := hs
  have hparts := coordinate_regular hU t hcoord
  refine ⟨?_, ?_, ?_⟩
  · apply (Scheme.isIso_subschemeι_iff_eq_bot _).mpr
    apply Scheme.IdealSheafData.ext
    funext V
    simp [coordinateIntersectionIdeal]
  · intro J
    obtain ⟨hr, hd⟩ := hparts J
    have := hr.2
    refine ⟨hr, hd, fun z ↦ ⟨inferInstance, inferInstance,
      coordinate_quotient t J z⟩⟩
  · intro W e he
    have := hU.1
    have : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian e
    have hW : IsRegularScheme W := ⟨inferInstance,
      ⟨isRegularLocalRing_stalk_of_etale e (fun x ↦ hU.2.isRegularLocalRing_stalk x)⟩⟩
    have hv (w : W) (j : Fin s) :
        W.Γevaluation w (e.appTop (t j)) = 0 ↔ U.Γevaluation (e w) (t j) = 0 := by
      rw [← Scheme.Γevaluation_naturality_apply e]
      exact map_eq_zero_iff (e.residueFieldMap w).hom (e.residueFieldMap w).hom.injective
    have hc (w : W) :
        ∃ (hN : IsNoetherianRing (W.presheaf.stalk w))
          (p : List (W.presheaf.stalk w)),
          @IsLocalRing.IsRegularSystemOfParameters _ _ _ hN p ∧
          ∃ pos : {j : Fin s // W.Γevaluation w (e.appTop (t j)) = 0} ↪ Fin p.length,
            ∀ j, p.get (pos j) = W.presheaf.germ ⊤ w trivial (e.appTop (t j.1)) := by
      obtain ⟨hN, p, hp, pos, hpos⟩ := hcoord (e w)
      obtain ⟨hNW, hpW⟩ := etale_parameters hU e w
      let q := p.map (fun a ↦ e.stalkMap w a)
      have hpq := hpW hN p hp
      let g : {j : Fin s // W.Γevaluation w (e.appTop (t j)) = 0} ↪
          {j : Fin s // U.Γevaluation (e w) (t j) = 0} :=
        ⟨fun j ↦ ⟨j.1, (hv w j.1).mp j.2⟩, by
          intro a b h
          have hv := congrArg Subtype.val h
          exact Subtype.ext hv⟩
      let k : Fin p.length ↪ Fin q.length :=
        ⟨fun i ↦ ⟨i.1, by simp [q]⟩, by
          intro a b h
          have hv := congrArg Fin.val h
          exact Fin.ext hv⟩
      refine ⟨hNW, q, hpq, g.trans (pos.trans k), ?_⟩
      intro j
      change (p.map (fun a ↦ e.stalkMap w a)).get (k (pos (g j))) = _
      simp only [List.get_eq_getElem, List.getElem_map]
      change e.stalkMap w (p.get (pos (g j))) = _
      rw [hpos]
      change e.stalkMap w (U.presheaf.germ ⊤ (e w) trivial (t j.1)) = _
      simp [Scheme.Hom.appTop]
    refine ⟨hW, etale_parameters hU e, hv, hc, ?_⟩
    intro J
    exact ⟨coordinate_baseChange t e J, coordinate_regular hW _ hc J⟩

end AlgebraicGeometry
