module

public import Mathlib.LinearAlgebra.ExteriorPower.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Map
import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# Relations in a tensor of exterior powers of a quotient

Source: blueprint, Riemann--Roch, proof of (*), determinant paragraph.
(blueprint: lem-sc-exterior-tensor-quotient-kernel-algebra).
-/

@[expose] public section

universe u v₁ v₂ v₃ v₄
namespace exteriorPower
open Function

section
variable {R : Type u} [CommRing R]
variable {K : Type v₂} {B : Type v₃} {C : Type v₄}
variable [AddCommGroup K] [AddCommGroup B] [AddCommGroup C]
variable [Module R K] [Module R B] [Module R C]

private theorem quotient_kernel (f : K →ₗ[R] B) (g : B →ₗ[R] C)
    (hfg : LinearMap.range f = LinearMap.ker g) (hg : Function.Surjective g) (n : ℕ) :
    LinearMap.ker (exteriorPower.map n g) ≤ Submodule.span R
      {z | ∃ (b : Fin n → B) (j : Fin n) (d : K), b j = f d ∧ z = ιMulti R n b} := by
  classical
  let J := Submodule.span R
    {z | ∃ (b : Fin n → B) (j : Fin n) (d : K), b j = f d ∧ z = ιMulti R n b}
  let π := J.mkQ
  let W := π.compAlternatingMap (ιMulti R n)
  have hz (b : Fin n → B) (j : Fin n) (d : K) : W (update b j (f d)) = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact Submodule.subset_span ⟨update b j (f d), j, d, update_self _ _ _, rfl⟩
  have hup (b : Fin n → B) (j : Fin n) (p q : B) (h : g p = g q) :
      W (update b j p) = W (update b j q) := by
    have hpq : p - q ∈ LinearMap.range f := by
      rw [hfg]
      exact show g (p - q) = 0 by rw [map_sub, h, sub_self]
    obtain ⟨d, hd⟩ := hpq
    have he := hz b j d
    rw [hd, W.map_update_sub] at he
    exact sub_eq_zero.mp he
  have heq (a b : Fin n → B) (h : ∀ i, g (a i) = g (b i)) : W a = W b := by
    have hfin (S : Finset (Fin n)) : W (S.piecewise a b) = W b := by
      induction S using Finset.induction_on with
      | empty => simp
      | @insert i S hi ih =>
        rw [Finset.piecewise_insert]
        have hu := hup (S.piecewise a b) i (a i) (b i) (h i)
        rw [hu]
        have hi' : b i = S.piecewise a b i := by simp [hi]
        rw [hi', update_eq_self]
        exact ih
    simpa using hfin Finset.univ
  let liftC : C → B := Function.surjInv hg
  have hlift (c : C) : g (liftC c) = c := Function.surjInv_eq hg c
  let V : C [⋀^Fin n]→ₗ[R] ((⋀[R]^n B) ⧸ J) :=
    { toFun := fun c ↦ W (liftC ∘ c)
      map_update_add' := by
        intro _ c i p q
        have h : W (liftC ∘ update c i (p + q)) =
            W (update (liftC ∘ c) i (liftC p + liftC q)) := by
          apply heq
          intro j
          by_cases hj : j = i
          · subst j
            simp only [comp_apply, update_self, map_add, hlift]
          · simp only [comp_apply, update_of_ne hj]
        rw [h, W.map_update_add]
        congr 1 <;> apply heq <;> intro j <;>
          by_cases hj : j = i <;> simp [comp_apply, hj, hlift]
      map_update_smul' := by
        intro _ c i r p
        have h : W (liftC ∘ update c i (r • p)) =
            W (update (liftC ∘ c) i (r • liftC p)) := by
          apply heq
          intro j
          by_cases hj : j = i
          · subst j
            simp only [comp_apply, update_self, map_smul, hlift]
          · simp only [comp_apply, update_of_ne hj]
        rw [h, W.map_update_smul]
        congr 1
        apply heq
        intro j
        by_cases hj : j = i <;> simp [comp_apply, hj, hlift]
      map_eq_zero_of_eq' := by
        intro c i j hij hne
        exact W.map_eq_zero_of_eq _ (congrArg liftC hij) hne }
  let L := alternatingMapLinearEquiv V
  have hL : L.comp (exteriorPower.map n g) = π := by
    apply exteriorPower.linearMap_ext
    apply AlternatingMap.ext
    intro b
    change L (exteriorPower.map n g (ιMulti R n b)) = W b
    rw [map_apply_ιMulti, alternatingMapLinearEquiv_apply_ιMulti]
    exact heq _ _ (fun i ↦ hlift (g (b i)))
  intro b hb
  apply (Submodule.Quotient.mk_eq_zero _).mp
  change π b = 0
  rw [← hL]
  change L (exteriorPower.map n g b) = 0
  rw [hb, map_zero]

end

/-- The algebraic kernel is generated by tensors of wedges with one image entry.

Source: blueprint, Riemann--Roch, proof of (*), determinant paragraph; steps 1--2
of `lem-sc-exterior-tensor-stalk-kernel-span`.
(blueprint: lem-sc-exterior-tensor-quotient-kernel-algebra).

Proof: Let J be the span in the s-th exterior power of B of wedges having an
entry f(d). Such wedges map to zero under the exterior power of g. Modulo J,
changing a lift of an entry of C changes the wedge by a wedge with an entry
in ker(g)=range(f), hence by zero. Replacing entries successively proves lift
independence. The resulting alternating multilinear map from tuples in C
induces a map from its exterior power to the quotient by J. The two maps are
inverse on pure wedges; pure wedges span, so they are inverse everywhere.
Consequently ker(exteriorPower.map s g)=J. Surjectivity of g implies
surjectivity of its exterior map. Tensor right exactness identifies the kernel
of tensoring that map with the image of the tensor of J. Expanding the first
factor into pure wedges, and the second factor into the defining generators
of J, shows that this image is contained in the displayed span. This proves
the asserted inclusion. The empty wedge generates when r=0. For s=0 the map
is an isomorphism and the kernel is zero; zero modules and zero rings also
satisfy the assertion. No injectivity of f or flatness of A is required. -/
theorem tensor_quotient_kernel_le_span
    {R : Type u} [CommRing R]
    {A : Type v₁} {K : Type v₂} {B : Type v₃} {C : Type v₄}
    [AddCommGroup A] [AddCommGroup K] [AddCommGroup B] [AddCommGroup C]
    [Module R A] [Module R K] [Module R B] [Module R C]
    (f : K →ₗ[R] B) (g : B →ₗ[R] C)
    (hfg : LinearMap.range f = LinearMap.ker g) (hg : Function.Surjective g)
    (r s : ℕ) :
    LinearMap.ker (TensorProduct.map (LinearMap.id : (⋀[R]^r A) →ₗ[R] ⋀[R]^r A)
      (exteriorPower.map s g)) ≤
      Submodule.span R {z | ∃ (a : Fin r → A) (c : Fin s → B) (j : Fin s) (d : K),
        c j = f d ∧ z = exteriorPower.ιMulti R r a ⊗ₜ[R] exteriorPower.ιMulti R s c} :=
  by
  classical
  let G := exteriorPower.map s g
  let J := LinearMap.ker G
  let Q := Submodule.span R
    {z | ∃ (a : Fin r → A) (c : Fin s → B) (j : Fin s) (d : K),
      c j = f d ∧ z = exteriorPower.ιMulti R r a ⊗ₜ[R] exteriorPower.ιMulti R s c}
  have hG : Function.Surjective G := exteriorPower.map_surjective (n := s) hg
  have hExact := lTensor_exact (⋀[R]^r A) G.exact_subtype_ker_map hG
  intro z hz
  have hz' : z ∈ LinearMap.range (LinearMap.lTensor (⋀[R]^r A) J.subtype) := by
    rw [← hExact.linearMap_ker_eq]
    exact hz
  obtain ⟨t, rfl⟩ := hz'
  clear hz
  induction t using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact Q.zero_mem
  | add t u ht hu => rw [map_add]; exact Q.add_mem ht hu
  | tmul a b =>
    change a ⊗ₜ[R] b.val ∈ Q
    have ha : a ∈ Submodule.span R (Set.range (exteriorPower.ιMulti R r)) := by
      rw [exteriorPower.ιMulti_span]
      exact Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨a, rfl⟩ := ha
      have hb := quotient_kernel f g hfg hg s b.property
      generalize hbval : b.val = bval at hb ⊢
      clear hbval
      induction hb using Submodule.span_induction with
      | mem c hc =>
        obtain ⟨c, j, d, hj, rfl⟩ := hc
        exact Submodule.subset_span ⟨a, c, j, d, hj, rfl⟩
      | zero => rw [TensorProduct.tmul_zero]; exact Q.zero_mem
      | add c d _ _ hc hd => rw [TensorProduct.tmul_add]; exact Q.add_mem hc hd
      | smul c d _ hd => rw [TensorProduct.tmul_smul]; exact Q.smul_mem c hd
    | zero => rw [TensorProduct.zero_tmul]; exact Q.zero_mem
    | add a c _ _ ha hc => rw [TensorProduct.add_tmul]; exact Q.add_mem ha hc
    | smul c a _ ha => rw [← TensorProduct.smul_tmul']; exact Q.smul_mem c ha

end exteriorPower
