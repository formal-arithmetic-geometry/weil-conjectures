module

public import Sheaf.AlgebraicGeometry.Modules.ExteriorSheaf
public import WeilConjectures.AlgebraicGeometry.Modules.TensorSection

public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.LocallyFree
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact

/-!
# Factorization of the pre-quotient wedge map

Source: blueprint, Riemann--Roch, proof of (*), determinant paragraph,
lift independence (blueprint: lem-sc-determinant-wedge-quotient-factor).
-/

@[expose] public section

universe v
open CategoryTheory Opposite MonoidalCategory
namespace AlgebraicGeometry.Scheme.Modules

set_option backward.isDefEq.respectTransparency false in
/-- The wedge map before choosing quotient lifts factors through the quotient exterior power.
The pure-wedge formula for `q` identifies it with the tensor of the identity and the exterior
map induced by `S.g`, since pure wedges and their tensor products generate locally. On stalks
this map is surjective: `S.g` is surjective on stalks, every finite tuple lifts, and pure wedges
span. Thus `q` is an epimorphism. To prove that `ψ` kills its kernel, work on a trivializing
cover for `S.X₁`. The kernel of the exterior map of a quotient is generated by wedges having
one factor in the kernel of `S.g`: this follows by presenting the exterior power as tensors
modulo multilinearity and alternation and then imposing the quotient relations. Exactness
identifies this factor locally with `S.f(d)`. The formula for `ψ` then has `r₁ + 1` factors
from `S.X₁`. Expand in its basis of size `r₁`; every term repeats a basis vector, so alternation
makes it zero. Tensoring preserves this quotient presentation. Consequently `ψ` annihilates
the kernel of `q`. The cokernel universal property in the abelian category of module sheaves
gives `φ` with `q ≫ φ = ψ`. This statement asserts only factorization of two given maps, not
the construction or the prescribed value of the final quotient wedge map. If `r₁ = 0`, the
kernel sheaf is zero; if `r₃ = 0`, the quotient exterior map is the identity in degree zero.
The empty scheme gives zero section modules, so the same reasoning applies.
Source: blueprint, Riemann--Roch, proof of (*), determinant paragraph, lift independence
(blueprint: lem-sc-determinant-wedge-quotient-factor). -/
theorem determinant_wedge_quotient_factor {X : Scheme.{v}}
    (S : ShortComplex X.Modules) (hS : S.ShortExact) (r₁ r₂ r₃ : ℕ)
    (hr : r₂ = r₁ + r₃) [S.X₁.IsFiniteLocallyFreeOfRank r₁]
    (q : exteriorSheaf S.X₁ r₁ ⊗ exteriorSheaf S.X₂ r₃ ⟶
      exteriorSheaf S.X₁ r₁ ⊗ exteriorSheaf S.X₃ r₃)
    (ψ : exteriorSheaf S.X₁ r₁ ⊗ exteriorSheaf S.X₂ r₃ ⟶ exteriorSheaf S.X₂ r₂)
    (hq : ∀ (U : X.Opens) (a : Fin r₁ → S.X₁.val.obj (op U))
      (c : Fin r₃ → S.X₂.val.obj (op U)),
      q.val.app (op U)
        (tmulSection (exteriorSheafSection S.X₁ r₁ U a)
          (exteriorSheafSection S.X₂ r₃ U c)) =
        tmulSection (M := exteriorSheaf S.X₁ r₁)
          (N := exteriorSheaf S.X₃ r₃) (U := U)
          (exteriorSheafSection S.X₁ r₁ U a)
          (exteriorSheafSection S.X₃ r₃ U (fun i ↦ S.g.val.app (op U) (c i))))
    (hψ : ∀ (U : X.Opens) (a : Fin r₁ → S.X₁.val.obj (op U))
      (c : Fin r₃ → S.X₂.val.obj (op U)),
      ψ.val.app (op U)
        (tmulSection (exteriorSheafSection S.X₁ r₁ U a)
          (exteriorSheafSection S.X₂ r₃ U c)) =
        exteriorSheafSection S.X₂ r₂ U
          (fun i ↦ Fin.append (fun j ↦ S.f.val.app (op U) (a j)) c (Fin.cast hr i))) :
    ∃ φ : exteriorSheaf S.X₁ r₁ ⊗ exteriorSheaf S.X₃ r₃ ⟶ exteriorSheaf S.X₂ r₂,
      q ≫ φ = ψ := by
  sorry

end AlgebraicGeometry.Scheme.Modules
