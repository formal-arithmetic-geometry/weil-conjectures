module

public import Sheaf.AlgebraicGeometry.BertiniUniversalFamily
public import WeilConjectures.AlgebraicGeometry.Modules.PullbackFreeGenerator
import WeilConjectures.AlgebraicGeometry.Modules.HomSection

/-!
# The equation of a trivialized Bertini zero scheme

Source: Stacks Project, More on Morphisms, Tag 0G4F, affine incidence charts.
-/

@[expose] public section

universe u

open CategoryTheory Opposite MonoidalCategory

namespace AlgebraicGeometry

open Scheme.Modules

private noncomputable def tensorComparison {X Y : Scheme.{u}} (f : X ⟶ Y) :
    tensorPullback f ≅ Scheme.Modules.pullback f :=
  (Classical.choose (exists_tensorPullbackAdjunction f)).leftAdjointUniq
    (pullbackPushforwardAdjunction f)

attribute [local irreducible] tensorPullback tensorPullbackObj

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
private theorem tensorUnit_eq {X Y : Scheme.{u}} (f : X ⟶ Y) (M : Y.Modules) :
    tensorSectionsUnit f M =
      (show Γ(M, ⊤) ⟶ Γ((tensorPullback f).obj M, ⊤) from
        ((Classical.choose (exists_tensorPullbackAdjunction f)).unit.app M).app ⊤) := by
  unfold tensorSectionsUnit
  have hi : (homOfLE f.preimage_top.ge).op = 𝟙 (op (⊤ : X.Opens)) := rfl
  erw [hi, ((tensorPullback f).obj M).presheaf.map_id, Category.comp_id]

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
private theorem tensorUnit_comparison {X Y : Scheme.{u}} (f : X ⟶ Y) (M : Y.Modules)
    (s : Γ(M, ⊤)) :
    ((tensorComparison f).hom.app M).app ⊤
      (tensorSectionsUnit f M s) = pullbackSection f s := by
  rw [tensorUnit_eq]
  exact congrArg (fun t ↦ t.app ⊤ s)
    ((Classical.choose (exists_tensorPullbackAdjunction f)).unit_leftAdjointUniq_hom_app
      (pullbackPushforwardAdjunction f) M)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- On an affine pullback of a trivialized line bundle, the zero ideal of a linear
combination of pulled-back sections is generated by the corresponding coefficient equation.

Source: Stacks Project, More on Morphisms, Tag 0G4F, the affine incidence equation.
(blueprint: lem-zl-bertini-trivialized-zero-ideal).

Proof: The tensor-pullback comparison carries the tensor unit of the chosen generator to
its ordinary pullback, which is a free generator. The tensor unit is semilinear, so the
coefficient of the sum is sum r_i f^*(coeff(s_i)). The local zero-ideal formula for a map of
invertible modules identifies the zero ideal with the principal ideal of that coefficient.
No reducedness or nonemptiness assumption is needed. -/
theorem ideal_zeroLocus_tensorSectionsUnit_sum
    {X Y : Scheme.{u}} [IsAffine X] (f : X ⟶ Y)
    (L : Y.Modules) [L.IsInvertible] {e : Γ(L, ⊤)} (he : IsFreeGenerator e)
    {I : Type u} [Fintype I] (s : I → Γ(L, ⊤)) (r : I → Γ(X, ⊤)) :
    (homOfGlobalSection _ (∑ i, r i • tensorSectionsUnit f L (s i))).zeroLocus.ideal
        ⟨⊤, isAffineOpen_top X⟩ =
      Ideal.span {∑ i, r i * f.appTop (he.coeff (s i))} := by
  classical
  let E := (tensorComparison f).app L
  have hfree : IsFreeGenerator (tensorSectionsUnit f L e) := by
    have hp := (he.pullback_unit_app_top f).app_hom E.symm
    change IsFreeGenerator (E.inv.app ⊤ (pullbackSection f e)) at hp
    rw [← tensorUnit_comparison f L e] at hp
    change IsFreeGenerator (E.inv.app ⊤ (E.hom.app ⊤ (tensorSectionsUnit f L e))) at hp
    rw [← ConcreteCategory.comp_apply, ← Hom.comp_app, Iso.hom_inv_id, Hom.id_app] at hp
    exact hp
  have : ((tensorPullback f).obj L).IsInvertible := IsInvertible.of_iso E.symm
  have := IsInvertible.sheafOfModules_isInvertible ((tensorPullback f).obj L)
  have : SheafOfModules.IsInvertible.{u, u, u} (unit X) :=
    IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  apply Hom.ideal_zeroLocus _ ⟨⊤, isAffineOpen_top X⟩ (isFreeGenerator_one _) hfree
  rw [homOfGlobalSection_app_one, presheaf_map_id_apply, Finset.sum_smul]
  apply Finset.sum_congr rfl
  intro i _
  rw [mul_smul]
  congr 1
  have hsmul : tensorSectionsUnit f L (he.coeff (s i) • e) =
      f.appTop (he.coeff (s i)) • tensorSectionsUnit f L e := by
    rw [tensorUnit_eq]
    exact Hom.app_smul _ _ _
  rwa [he.coeff_smul] at hsmul

end AlgebraicGeometry
