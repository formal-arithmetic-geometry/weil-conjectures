/-! # A fraction presentation of pullback sections on a Proj chart

Source: Stacks Project, constructions.tex, Tags 01MY, 01N2 and 01M7.
(blueprint: lem-sfb-proj-twist-pullback-fraction-presentation).
-/

@[expose] public section
set_option autoImplicit false
set_option relaxedAutoImplicit false
universe u
open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry.Proj

/-- Pullback chart sections are generated by coefficient tensors of homogeneous fractions.
The assertion is a surjective presentation, with no assertion about its kernel and no
morphism from the pullback to the target twist.

Source: Stacks Project, constructions.tex, Tags 01MY and 01N2, the standard-open
calculation, and Tag 01M7 for the associated graded-module sheaf.
(blueprint: lem-sfb-proj-twist-pullback-fraction-presentation).

Proof: Extend the grading of A by zero to negative degrees and shift it by j. The
single-twist fraction theorem identifies its degree-zero localization at f with the
actual locally-fraction twist on D_+(f), compatibly with scalar multiplication and
restriction. The associated graded-module sheaf theorem makes this identification
quasi-coherent: identify its basis restrictions with the same fractions and use
uniqueness of extension from the standard-open basis. Thus the affine pullback
section comparison applies to this twist. It identifies sections of the pullback
on D_+(psi(f)) with the tensor product of the source chart module and the target
chart ring over the source chart ring. The homogeneous-localization scalar-extension
comparison identifies the target chart ring with S tensor the source chart ring.
Tensor associativity, followed by contraction of the source chart-ring factor,
gives a surjection from S tensor the homogeneous degree-j fraction piece. The
comparison on a pure tensor is coefficient multiplication times the actual
pullback section 1 tensor t, by normalization of the affine comparison and its
adjunction unit. A homogeneous fraction gives t by fraction realization. Its
value at each prime is the displayed localization map. Common denominators extend
this formula to every element of the fraction piece; additivity and the balancing
relation give the additive presentation c. If f is nilpotent the chart and all
fraction modules are zero, so the same construction applies. No flatness or
faithfulness of S over R is used. -/
theorem exists_twistPullback_fraction_presentation
    {R S A B : Type u} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra S B]
    (𝒜 : ℕ → Submodule R A) (ℬ : ℕ → Submodule S B)
    [GradedRing 𝒜] [GradedRing ℬ]
    (β : TensorProduct R S A ≃ₐ[S] B) (ψ : 𝒜 →+*ᵍ ℬ)
    (hβψ : ∀ a : A, β (TensorProduct.tmul R (1 : S) a) = ψ a)
    (hgraded : ∀ n : ℕ, ℬ n = Submodule.span S (ψ '' (𝒜 n : Set A)))
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map ψ
      (HomogeneousIdeal.irrelevant 𝒜))
    (j : ℤ) (n : ℕ) (f : A) (hf : f ∈ 𝒜 n) (hn : 0 < n) :
    let U := basicOpen 𝒜 f
    let V := basicOpen ℬ (ψ f)
    let hVU : V ≤ map ψ hψ ⁻¹ᵁ U :=
      le_of_eq (map_preimage_basicOpen ψ hψ f).symm
    ∃ c : TensorProduct R S (twistChartFractionSubmodule 𝒜 n f j) →+
        Γ((tensorPullback (map ψ hψ)).obj (twist 𝒜 j), V),
      Function.Surjective c ∧
      ∀ z : twistChartFractionSubmodule 𝒜 n f j,
        ∃ t : Γ(twist 𝒜 j, U),
          (∀ y : U,
            IsLocalization.map (M := Submonoid.powers f)
              (T := y.1.asHomogeneousIdeal.toIdeal.primeCompl)
              (Localization.AtPrime y.1.asHomogeneousIdeal.toIdeal) (RingHom.id A)
              (Submonoid.powers_le.mpr y.2) (z : Localization.Away f) = (t.1 y).val) ∧
          ∀ s : S,
            c (TensorProduct.tmul R s z) =
              awayToSection ℬ (ψ f)
                  (algebraMap S (HomogeneousLocalization.Away ℬ (ψ f)) s) •
                ((tensorPullback (map ψ hψ)).obj (twist 𝒜 j)).presheaf.map
                  (homOfLE hVU).op
                  (tensorPullbackSection (map ψ hψ) (twist 𝒜 j) U t) := by
  sorry

end AlgebraicGeometry.Proj
