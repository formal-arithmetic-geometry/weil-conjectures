module

public import Sheaf.AlgebraicGeometry.FineLogCoherentIdeal
public import Sheaf.AlgebraicGeometry.LogRegularPair
public import Sheaf.AlgebraicGeometry.LogIdealChartPresentation
public import Sheaf.AlgebraicGeometry.CoherentFiniteType
public import Sheaf.AlgebraicGeometry.TensorPullbackSectionAdjunction
public import WeilConjectures.AlgebraicGeometry.EtaleTensorSectionsSheaf
public import WeilConjectures.AlgebraicGeometry.TensorPullbackStructureSheaf
public import Mathlib.AlgebraicGeometry.Modules.Tilde

/-!
# Data for logarithmic image-ideal algebraization

Source: ILO, Exposé VIII 3.3.7 and 3.4.2; Stacks, Tags 01IB, 01IC, 03DX and 05VG
(blueprint: def-trf-log-ideal-algebraization-data).

Image ideals are described by local membership at geometric stalks, rather than
by the generally incorrect sectionwise span. The map into the structure sheaf is
the actual tensor pullback of the ideal inclusion followed by the canonical
structure-sheaf comparison. All comparisons below are normalized by this map.
-/

@[expose] public section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u v
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry

/-- Sections of the sheaf ideal generated by the structural image of a log ideal.
Geometric-stalk membership performs sheaf-local generation, including on nonaffine
objects. Source: ILO VIII 3.3.7, 3.4.2
(blueprint: lem-trf-log-ideal-algebraization-descent). -/
def EtaleLogStructure.imageIdealSections {X : Scheme.{u}} (M : EtaleLogStructure X)
    (I : M.IdealFamily) (W : X.Etale) : Set Γ(W.left, ⊤) :=
  {s | ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X)
    (w : (Scheme.pointSmallEtale t).fiber.obj W),
    strictLocalGerm X t W w s ∈
      Ideal.span (M.toEtalePrelogStructure.stalkAlpha t '' M.idealStalk I t)}

/-- The canonical inclusion map after tensor pullback, with its actual target
identified with the source structure sheaf. Source: Stacks, Tag 0096; ILO VIII 3.4.2
(blueprint: lem-trf-log-ideal-algebraization-descent). -/
noncomputable def logIdealTensorInclusion {X Y : Scheme.{u}} (K : X.IdealSheafData)
    (f : Y ⟶ X) : (Scheme.Modules.tensorPullback f).obj K.toModules ⟶
      SheafOfModules.unit Y.ringCatSheaf :=
  (Scheme.Modules.tensorPullback f).map K.toModulesι ≫
    Scheme.Modules.tensorPullbackObjUnitToUnit f

/-- Equality, including the inclusion, of the associated ideal with the small-étale
image ideal. Its sections are precisely those of the recorded étale association
`etaleTensorSectionsSheaf`; monicity keeps the inclusion into regular functions.
Source: ILO VIII 3.4.2; Stacks, Tag 03DU
(blueprint: lem-trf-log-ideal-algebraization-descent). -/
def EtaleLogStructure.IsImageIdealAlgebraization {X : Scheme.{u}}
    (M : EtaleLogStructure X) (I : M.IdealFamily) (K : X.IdealSheafData) : Prop :=
  ∀ W : X.Etale, Mono (logIdealTensorInclusion K W.hom) ∧
    Set.range ((logIdealTensorInclusion K W.hom).app ⊤) = M.imageIdealSections I W

/-- The ring ideal generated by the finite elements of a chart on `Spec A`, transported
by the canonical global-section isomorphism. Source: ILO VIII 3.3.7, 3.4.2
(blueprint: lem-trf-log-ideal-algebraization-descent). -/
def logImageChartIdeal {X : Scheme.{u}} (M : EtaleLogStructure X)
    {A : Type u} [CommRing A] (f : Spec (.of A) ⟶ X) [Etale f]
    {P : Type u} [CommMonoid P]
    (β : P →* M.monoidSheaf.obj.obj (op (Scheme.Etale.mk f))) (E : Finset P) : Ideal A :=
  Ideal.span (((Scheme.ΓSpecIso (.of A)).hom.hom.toMonoidHom.comp
    ((M.alpha.app (op (Scheme.Etale.mk f))).hom.comp β)) '' (E : Set P))

/-- The tilde of an affine ring ideal with its specified inclusion in the structure
sheaf, not an arbitrary isomorphic module. Source: ILO VIII 3.4.2; Stacks, Tag 01IB
(blueprint: lem-trf-log-ideal-algebraization-descent). -/
noncomputable def logImageTildeInclusion {A : Type u} [CommRing A] (J : Ideal A) :
    tilde (ModuleCat.of A J) ⟶ SheafOfModules.unit (Spec (.of A)).ringCatSheaf :=
  tilde.map (ModuleCat.ofHom J.subtype) ≫ (tildeSelf (R := .of A)).hom

/-- Canonical effective étale descent of an ideal with its inclusion. A family of local
ideals already identified as the restrictions of `K` has unique transition isomorphisms
on every double-overlap test object; these preserve inclusions, are the identity on the
diagonal and satisfy the triple cocycle. The displayed equalities with `K` give its
realization, including over nonaffine overlaps. Source: Stacks, Tags 03DX and 0GN7
(blueprint: lem-trf-log-ideal-algebraization-descent). -/
def HasCanonicalEtaleIdealDescent {X : Scheme.{u}} (K : X.IdealSheafData) : Prop :=
  ∀ (ι : Type v) (U : ι → X.Etale) (L : ∀ a : ι, (U a).left.IdealSheafData),
    (∀ a : ι, L a = K.comap (U a).hom) →
    ∃ e : ∀ (a b : ι) (V : X.Etale) (f : V ⟶ U a) (g : V ⟶ U b),
        ((L a).comap f.left).toModules ≅ ((L b).comap g.left).toModules,
      (∀ (a b : ι) (V : X.Etale) (f : V ⟶ U a) (g : V ⟶ U b),
        (e a b V f g).hom ≫ ((L b).comap g.left).toModulesι =
          ((L a).comap f.left).toModulesι) ∧
      (∀ (a : ι) (V : X.Etale) (f : V ⟶ U a), e a a V f f = Iso.refl _) ∧
      (∀ (a b c : ι) (V : X.Etale) (f : V ⟶ U a) (g : V ⟶ U b) (h : V ⟶ U c),
        (e a b V f g).hom ≫ (e b c V g h).hom = (e a c V f h).hom) ∧
      (∀ (a : ι) (V : X.Etale) (f : V ⟶ U a),
        (L a).comap f.left = K.comap V.hom) ∧
      ∀ (a b : ι) (V : X.Etale) (f : V ⟶ U a) (g : V ⟶ U b)
        (q : ((L a).comap f.left).toModules ≅ ((L b).comap g.left).toModules),
        q.hom ≫ ((L b).comap g.left).toModulesι = ((L a).comap f.left).toModulesι →
          q = e a b V f g

/-- The complete affine chart formula, with its inclusion into the structure sheaf.
Source: ILO VIII 3.3.7, 3.4.2 (blueprint: lem-trf-log-ideal-algebraization-descent). -/
def EtaleLogStructure.HasImageIdealChartFormula {X : Scheme.{u}}
    (M : EtaleLogStructure X) (I : M.IdealFamily) (K : X.IdealSheafData) : Prop :=
  ∀ (A : Type u) [CommRing A] (f : Spec (.of A) ⟶ X) [Etale f]
    (P : Type u) [CommMonoid P]
    (β : P →* M.monoidSheaf.obj.obj (op (Scheme.Etale.mk f))) (E : Finset P),
    Monoid.FG P → Function.Injective (Algebra.GrothendieckGroup.of (M := P)) →
    M.IsChart (Scheme.Etale.mk f) β → E.Nonempty →
    M.ChartGeneratesIdeal I (Scheme.Etale.mk f) β E →
      ∃! e : (Scheme.Modules.tensorPullback f).obj K.toModules ≅
          tilde (ModuleCat.of A (logImageChartIdeal M f β E)),
        e.hom ≫ logImageTildeInclusion (logImageChartIdeal M f β E) =
          logIdealTensorInclusion K f

end AlgebraicGeometry
