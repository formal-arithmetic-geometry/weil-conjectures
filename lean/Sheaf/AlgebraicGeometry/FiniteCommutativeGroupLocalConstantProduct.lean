/-!
# Local and constant factors of a finite commutative group scheme

Source: Milne, Algebraic Groups (2017), Propositions 11.1–11.3, pp. 209–210,
and Proposition 2.37, pp. 51–52
(blueprint: lem-sfb-finite-commutative-group-local-constant-product).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
  CategoryTheory.CartesianMonoidalCategory
open scoped MonObj

namespace AlgebraicGeometry

/-- The constant scheme with value the additive group of rational points, viewed over the base.
Source: Milne, Algebraic Groups (2017), Proposition 11.3, p. 210
(blueprint: lem-sfb-finite-commutative-group-local-constant-product). -/
noncomputable def finiteGroupConstantPoints {K : Type u} [Field K]
    (G : Over (Spec (.of K))) [GrpObj G] [IsCommMonObj G] : Over (Spec (.of K)) :=
  Over.mk (constantGroupSchemeProjection (Spec (.of K))
    (Additive (𝟙_ (Over (Spec (.of K))) ⟶ G)))

/-- The canonical section of the constant scheme indexed by a rational point.
Source: Milne, Algebraic Groups (2017), Proposition 11.3, p. 210
(blueprint: lem-sfb-finite-commutative-group-local-constant-product). -/
noncomputable def finiteGroupConstantPointsIncl {K : Type u} [Field K]
    (G : Over (Spec (.of K))) [GrpObj G] [IsCommMonObj G]
    (h : Additive (𝟙_ (Over (Spec (.of K))) ⟶ G)) :
    𝟙_ (Over (Spec (.of K))) ⟶ finiteGroupConstantPoints G :=
  Over.homMk (constantGroupSchemeIncl (Spec (.of K)) _ h)
    (Sigma.ι_desc (fun _ : Additive (𝟙_ (Over (Spec (.of K))) ⟶ G) ↦
      𝟙 (Spec (.of K))) h)

/-- Evaluation of a global function on the identity component at the identity section.
Source: Milne, Algebraic Groups (2017), Propositions 11.1–11.3, pp. 209–210
(blueprint: lem-sfb-finite-commutative-group-local-constant-product). -/
noncomputable def finiteGroupIdentityEvaluation {K : Type u} [Field K]
    (G : Over (Spec (.of K))) [GrpObj G] [LocallyOfFiniteType G.hom] [QuasiCompact G.hom] :
    Γ((GrpObj.identityComponent G).left, ⊤) →+* K :=
  ((GrpObj.identityComponentOne G).left.appTop ≫ (Scheme.ΓSpecIso (.of K)).hom).hom

/-- Local–constant product decomposition, including the augmented local coordinate algebra.
Source: Milne, Algebraic Groups (2017), Propositions 11.1–11.3, pp. 209–210,
and Proposition 2.37, pp. 51–52
(blueprint: lem-sfb-finite-commutative-group-local-constant-product).

Proof:
1. By lem-weil-pbc-finite-over-field-affine-finite-dim, G is affine with finite-dimensional
coordinate algebra. By lem-weil-pbc-finite-over-zero-dim-local-discrete-spectrum its space
is finite discrete. The one-point open components are affine by
lem-weil-pbc-finite-discrete-scheme-affine. Sheaf gluing gives the product of their nonzero
local coordinate algebras, finite-dimensional and Artinian by
lem-weil-pbc-finite-dim-algebra-artinian.
2. Apply lem-sc-finite-nonempty-point to each component. Evaluation is surjective with
kernel its unique maximal ideal. That ideal is nilpotent by
lem-weil-pbc-artinian-local-noetherian-nilpotent, so every map to K kills it and there is
exactly one K-point per component. This identifies H with the finite set of components
and identifies the residue algebra of C with K by evaluation at the identity.
3. Write B = K + I. In B tensor B the ideal J generated by I tensor 1 and 1 tensor I
is contained in every prime, and the quotient is K; hence it is the unique prime.
By lem-weil-pbc-fibre-product-affine-spectra, C times C has one point. Multiplication,
inversion and identity therefore restrict through the open C, with the group identities
inherited through its monomorphic inclusion (def-weil-open-immersion, def-sc-group-scheme).
4. Translation by h identifies C with the component of h. Use
lem-weil-pbc-scheme-coproduct-family, def-pc-fibre-product and
lem-weil-pbc-scheme-morphism-gluing to glue these translations to the displayed product
map. Glue inverse translations to construct its inverse.
5. On each pair of components the homomorphism equation is
(c c') (h h') = (c h) (c' h'), by associativity and commutativity. Gluing checks equality
on the component cover, giving the group-scheme isomorphism with the prescribed constant law.
6. The identity makes H nonempty and B nonzero, so q and d are positive. The coordinate
algebra of G is the product of q copies of B. A basis placed in each factor gives
its dimension as d times q. -/
theorem finiteCommutativeGroup_localConstantProduct
    (K : Type u) [Field K] [IsAlgClosed K]
    (G : Over (Spec (.of K))) [GrpObj G] [IsCommMonObj G] [IsFinite G.hom] :
    IsClopen (connectedComponent (GrpObj.onePoint G)) ∧
    IsFinite (GrpObj.identityComponent G).hom ∧
    ConnectedSpace (GrpObj.identityComponent G).left ∧
    IsCommMonObj (GrpObj.identityComponent G) ∧
    IsSubgroupScheme (GrpObj.identityComponentι G) ∧
    Finite (𝟙_ (Over (Spec (.of K))) ⟶ G) ∧
    (∃ gH : GrpObj (finiteGroupConstantPoints G),
      IsCommMonObj (finiteGroupConstantPoints G) ∧
      (μ[finiteGroupConstantPoints G]).left =
        constantGroupSchemeMultiplication (Spec (.of K))
          (Additive (𝟙_ (Over (Spec (.of K))) ⟶ G)) ∧
      ∃ φ : GrpObj.identityComponent G ⊗ finiteGroupConstantPoints G ≅ G,
        IsMonHom φ.hom ∧
        ∀ h : Additive (𝟙_ (Over (Spec (.of K))) ⟶ G),
          lift (𝟙 (GrpObj.identityComponent G))
            (toUnit (GrpObj.identityComponent G) ≫ finiteGroupConstantPointsIncl G h) ≫ φ.hom =
            GrpObj.identityComponentι G ≫ GrpObj.mulLeft G h.toMul) ∧
    Nontrivial Γ((GrpObj.identityComponent G).left, ⊤) ∧
    @FiniteDimensional K Γ((GrpObj.identityComponent G).left, ⊤) _ _
      (@Algebra.toModule _ _ _ _ (GrpObj.identityComponent G).hom.ΓAlgebra) ∧
    IsLocalRing Γ((GrpObj.identityComponent G).left, ⊤) ∧
    (∀ I : Ideal Γ((GrpObj.identityComponent G).left, ⊤),
      I.IsMaximal ↔ I = RingHom.ker (finiteGroupIdentityEvaluation G)) ∧
    (∃ e : Γ((GrpObj.identityComponent G).left, ⊤) ⧸
        RingHom.ker (finiteGroupIdentityEvaluation G) ≃+* K,
      ∀ b, e (Ideal.Quotient.mk _ b) = finiteGroupIdentityEvaluation G b) ∧
    1 ≤ (GrpObj.identityComponent G).hom.finrankΓ ∧
    1 ≤ Nat.card (𝟙_ (Over (Spec (.of K))) ⟶ G) ∧
    G.hom.finrankΓ = (GrpObj.identityComponent G).hom.finrankΓ *
      Nat.card (𝟙_ (Over (Spec (.of K))) ⟶ G) := by
  sorry

end AlgebraicGeometry
