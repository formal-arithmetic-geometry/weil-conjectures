module

public import Sheaf.AlgebraicGeometry.LogIdealChartPresentation
import Mathlib.AlgebraicGeometry.Gluing
import Mathlib.AlgebraicGeometry.Sites.EtalePoint
import Mathlib.CategoryTheory.Limits.Types.Filtered

/-!
# The distinguished-generator criterion for logarithmic chart lifts

Source: ILO VIII 3.1.19, 3.1.21, 3.3.6(ii), 3.3.8--3.3.9, pp. 101, 107--108
(blueprint: lem-trf-log-ideal-chart-lifting-criterion).

Multiplication of monoids denotes the source's addition. The Boolean index is false for
ordinary charts and true for saturated charts. Chart presentations include their actual tensor
spectra, structural monomials and maps to the original chart. No Noetherian hypothesis is used.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry

/-- Select the already defined ordinary or saturated fraction monoid.
Source: ILO VIII 3.1.19, 3.1.21
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def logIdealLiftingMonoid {P : Type u} [CommMonoid P] (E : Finset P) (e : P) :
    Bool → Submonoid (Algebra.GrothendieckGroup P)
  | false => logIdealChartMonoid E e
  | true => logIdealSaturatedChartMonoid E e

/-- Select the canonical inclusion of P into the selected fraction monoid.
Source: ILO VIII 3.1.19, 3.1.21
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def logIdealLiftingInclusion {P : Type u} [CommMonoid P] (E : Finset P) (e : P)
    (s : Bool) : P →* logIdealLiftingMonoid E e s :=
  match s with
  | false => logIdealChartInclusion E e
  | true => logIdealSaturatedChartInclusion E e

/-- The fraction f/e in either selected chart monoid, with its actual group value.
Source: ILO VIII 3.1.19, 3.1.21
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def logIdealLiftingDifference {P : Type u} [CommMonoid P] (E : Finset P)
    (e f : {p : P // p ∈ E}) (s : Bool) : logIdealLiftingMonoid E e.val s :=
  match s with
  | false => ⟨Algebra.GrothendieckGroup.of f.val / Algebra.GrothendieckGroup.of e.val,
      Submonoid.subset_closure (Or.inr ⟨f.val, f.property, rfl⟩)⟩
  | true => ⟨Algebra.GrothendieckGroup.of f.val / Algebra.GrothendieckGroup.of e.val,
      Submonoid.subset_closure (Or.inl
        (Submonoid.subset_closure (Or.inr ⟨f.val, f.property, rfl⟩)))⟩

/-- Evaluate an arbitrary log morphism on a global monoid chart.
Source: ILO VIII 3.3.6(ii)
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def logIdealMapChart {X Y : Scheme.{u}} {M : EtaleLogStructure X}
    {N : EtaleLogStructure Y} (g : EtaleLogMap M N) {P : Type u} [CommMonoid P]
    (c : P →* N.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 Y)))) :
    P →* M.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X))) :=
  (g.sectionMap (Scheme.Etale.mk (𝟙 Y)) (Scheme.Etale.mk (𝟙 X)) g.base
    ((Category.comp_id g.base).trans (Category.id_comp g.base).symm)).comp c

/-- A global chart followed by the actual geometric germ map.
Source: ILO VIII 3.3.6(ii), 3.3.8
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
noncomputable def logIdealChartGerm {X : Scheme.{u}} (M : EtaleLogStructure X)
    {P : Type u} [CommMonoid P]
    (c : P →* M.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X))))
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X) :
    P →* M.toEtalePrelogStructure.stalk t :=
  (M.toEtalePrelogStructure.germ t (Scheme.Etale.mk (𝟙 X)) (Over.homMk t)).hom.comp c

/-- The sheaf-local ideal generated by the specified finite global chart sections.
Source: ILO VIII 3.3.7--3.3.8
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def logIdealFiniteIdeal {X : Scheme.{u}} (M : EtaleLogStructure X) {P : Type u}
    [CommMonoid P] (c : P →* M.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X))))
    (E : Finset P) : M.IdealFamily :=
  fun W ↦ {a | ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X)
    (w : (Scheme.pointSmallEtale t).fiber.obj W),
    ∃ h ∈ E, ∃ b : M.toEtalePrelogStructure.stalk t,
      logIdealChartGerm M c t h * b = M.toEtalePrelogStructure.germ t W w a}

/-- Divisibility by the distinguished generator at every geometric log stalk.
Since e belongs to E, this says exactly that e generates the pulled-back ideal.
Source: ILO VIII 3.3.8 (blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def logIdealChartDivisibility {X : Scheme.{u}} (M : EtaleLogStructure X) {P : Type u}
    [CommMonoid P] (m : P →* M.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 X))))
    (E : Finset P) (e : P) : Prop :=
  ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ X) (h : P), h ∈ E →
    ∃ b : M.toEtalePrelogStructure.stalk t,
      logIdealChartGerm M m t e * b = logIdealChartGerm M m t h

/-- A presentation of the associated log structure on the actual tensor spectrum.
The chart and structural equation identify the associated log structure uniquely;
the base and chart equations specify its natural map to the original log scheme.
Source: ILO VIII 3.3.5--3.3.6(ii)
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
structure LogIdealLiftingChart {P : Type u} [CommMonoid P] (A : Type u) [CommRing A]
    (α : P →* A) (E : Finset P) (e : P) (s : Bool)
    (N : EtaleLogStructure (Spec (.of A)))
    (c : P →* N.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 (Spec (.of A)))))) where
  log : EtaleLogStructure
    (Spec (.of (logIdealTensorRing A α (logIdealLiftingInclusion E e s))))
  chart : logIdealLiftingMonoid E e s →* log.monoidSheaf.obj.obj
    (op (Scheme.Etale.mk (𝟙 (Spec (.of
      (logIdealTensorRing A α (logIdealLiftingInclusion E e s)))))))
  isChart : log.IsChart (Scheme.Etale.mk (𝟙 _)) chart
  chartAlpha : (log.alpha.app (op (Scheme.Etale.mk (𝟙 _)))).hom.comp chart =
    (Scheme.ΓSpecIso (.of (logIdealTensorRing A α
      (logIdealLiftingInclusion E e s)))).inv.hom.toMonoidHom.comp
        (logIdealTensorMonomial A α (logIdealLiftingInclusion E e s))
  toBase : EtaleLogMap log N
  base_eq : toBase.base = Spec.map
    (CommRingCat.ofHom (logIdealTensorBase A α (logIdealLiftingInclusion E e s)))
  chart_eq : logIdealMapChart toBase c = chart.comp (logIdealLiftingInclusion E e s)

/-- The lift is the restriction of the fixed group-completion map. Its value on
f/e is the unique section b with m(e)b=m(f), including the case of zero ring images.
Source: ILO VIII 3.1.19, 3.3.6(ii)
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
def LogIdealLiftingChart.LiftFormula {P : Type u} [CommMonoid P] {A : Type u}
    [CommRing A] {α : P →* A} {E : Finset P} {e : P} {s : Bool}
    {N : EtaleLogStructure (Spec (.of A))}
    {c : P →* N.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 (Spec (.of A)))))}
    (C : LogIdealLiftingChart A α E e s N c) {T : Scheme.{u}} {M : EtaleLogStructure T}
    (g : EtaleLogMap M N) (l : EtaleLogMap M C.log) : Prop :=
  (∀ q : logIdealLiftingMonoid E e s,
    Algebra.GrothendieckGroup.of (logIdealMapChart l C.chart q) =
      Algebra.GrothendieckGroup.lift
        (Algebra.GrothendieckGroup.of.comp (logIdealMapChart g c)) q.val) ∧
    ∀ (he : e ∈ E) (f : {p : P // p ∈ E}),
      logIdealMapChart g c e *
        logIdealMapChart l C.chart (logIdealLiftingDifference E ⟨e, he⟩ f s) =
          logIdealMapChart g c f.val ∧
      ∀ b : M.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 T))),
        logIdealMapChart g c e * b = logIdealMapChart g c f.val →
          b = logIdealMapChart l C.chart (logIdealLiftingDifference E ⟨e, he⟩ f s)

/-- The principal open where the fraction f/e is a unit.
Source: ILO VIII 3.1.19, 3.3.8--3.3.9
(blueprint: lem-trf-log-ideal-chart-lifting-criterion). -/
noncomputable def logIdealLiftingOpen {P : Type u} [CommMonoid P] (A : Type u)
    [CommRing A] (α : P →* A) (E : Finset P) (e f : {p : P // p ∈ E}) (s : Bool) :=
  (Spec (.of (logIdealTensorRing A α (logIdealLiftingInclusion E e.val s)))).basicOpen
    ((Scheme.ΓSpecIso (.of (logIdealTensorRing A α
      (logIdealLiftingInclusion E e.val s)))).inv
        (logIdealTensorMonomial A α (logIdealLiftingInclusion E e.val s)
          (logIdealLiftingDifference E e f s)))

/-- The distinguished-generator chart criterion, its unique group-map formula,
strict étale local existence, common-localization agreement, and the converse.
Source: ILO VIII 3.1.19, 3.1.21, 3.3.6(ii), 3.3.8--3.3.9, pp.101,107--108
(blueprint: lem-trf-log-ideal-chart-lifting-criterion).

Proof (the eight DAG steps):
1. The chart-stalk unit pushout is integral by lem-sfb-integral-monoid-unit-pushout.
   Stalk divisibilities spread to pointed étale neighbourhoods by cofilteredness and
   the filtered-colimit elementwise criterion. Finitely many equations share one
   neighbourhood. Cancellation makes their solutions unique, so the sheaf axiom glues
   the differences to global sections, and also proves cancellation for sections.
2. Extend the given P map to its group completion. Its restriction to Q_e takes
   h/e to the unique difference, hence lies in the section monoid. Cancellation
   determines its values on every generator and therefore forces uniqueness.
3. On affine opens send a tensor a tensor z^q to g-sharp(a) alpha(v(q)). This is
   balanced over Z[P] and multiplicative. Tensor universality and affine spectrum
   give the scheme maps; lem-weil-pbc-scheme-morphism-gluing glues them. The mapping
   bijection of lem-sfb-fine-chart-logification-thickening supplies their unique log
   maps. Conversely the chart relation h=e(h/e) gives the stalk criterion.
4. For an fs stalk S plus_F K, its completion is (S^gp plus K)/(z,-f(z)). If
   nx=[p,k] and x=[a,u], equality gives na-p=e1-e2. Then
   n(a+e2)=p+e1+(n-1)e2 lies in S, so saturation puts a+e2 in S. Consequently
   x=[a+e2,u-f(e2)] belongs to the stalk. This includes noninjective unit maps.
5. If nq lies in Q_e, Step 4 puts the group image of q in every fs stalk. Write
   q=p/p' and spread and glue its unique differences as in Step 1. This restricts
   the same group map to Q_e^s. The atlas lemma supplies its fine chart, and Step 3
   constructs its unique saturated lift.
6. If the pulled ideal has local generator m, locally m=m_e b and m_e=m a.
   Cancellation gives ab=1, so m_e itself generates. Finitely many equations give
   a common neighbourhood. Restricted log structures form the strict étale cover;
   Steps 1--5 give the stated lifts there.
7. When e and f both generate, m_f=m_e b and m_e=m_f c imply bc=1. The log axiom
   makes alpha(b) a unit. The basic-open pullback formula factors both lifts
   through D(z^(f/e)) and D(z^(e/f)). The affine-atlas common-localization identity
   identifies these opens over U. Both maps are restrictions of the same group
   map, so the tensor formula and logification bijection make them agree.
8. Pulling back h=e(h/e) on either chart makes every generator divisible by e.
   Since e is in E, the pulled ideal is exactly the principal ideal generated by e.
   This converse uses only h/e in Q_e, so it holds for every fine T and both charts.
-/
theorem logIdealChartLiftingCriterion (P A : Type u) [CommMonoid P] [CommRing A]
    (hfg : Monoid.FG P)
    (hint : Function.Injective (Algebra.GrothendieckGroup.of (M := P)))
    (α : P →* A) (E : Finset P) (hne : E.Nonempty)
    (N : EtaleLogStructure (Spec (.of A)))
    (c : P →* N.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 (Spec (.of A))))))
    (hc : N.IsChart (Scheme.Etale.mk (𝟙 _)) c)
    (hα : (N.alpha.app (op (Scheme.Etale.mk (𝟙 _)))).hom.comp c =
      (Scheme.ΓSpecIso (.of A)).inv.hom.toMonoidHom.comp α)
    (C : ∀ (s : Bool) (e : {p : P // p ∈ E}),
      LogIdealLiftingChart A α E e.val s N c)
    (T : Scheme.{u}) (M : EtaleLogStructure T) (hfine : M.IsFine)
    (g : EtaleLogMap M N) :
    (∀ (s : Bool), (s = true → M.IsFineSaturated) → ∀ e : {p : P // p ∈ E},
      ((∃ l : EtaleLogMap M (C s e).log, l.CompEq (C s e).toBase g) ↔
        logIdealChartDivisibility M (logIdealMapChart g c) E e.val) ∧
      ∀ l : EtaleLogMap M (C s e).log, l.CompEq (C s e).toBase g →
        (∀ l' : EtaleLogMap M (C s e).log, l'.CompEq (C s e).toBase g → l' = l) ∧
        (C s e).LiftFormula g l) ∧
    (∀ (s : Bool) (e : {p : P // p ∈ E}) (l : EtaleLogMap M (C s e).log),
      l.CompEq (C s e).toBase g →
        g.pullbackIdeal (logIdealFiniteIdeal N c E) =
          logIdealFiniteIdeal M (logIdealMapChart g c) {e.val}) ∧
    (∀ (s : Bool), (s = true → M.IsFineSaturated) →
      M.IsInvertibleIdeal (g.pullbackIdeal (logIdealFiniteIdeal N c E)) →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ T),
        ∃ (W : T.Etale) (_w : (Scheme.pointSmallEtale t).fiber.obj W)
          (L : EtaleLogStructure W.left) (i : EtaleLogMap L M)
          (gW : EtaleLogMap L N) (e : {p : P // p ∈ E}),
          i.base = W.hom ∧ i.IsStrictEtale ∧ i.CompEq g gW ∧
          gW.pullbackIdeal (logIdealFiniteIdeal N c E) =
            logIdealFiniteIdeal L (logIdealMapChart gW c) {e.val} ∧
          ∃ l : EtaleLogMap L (C s e).log, l.CompEq (C s e).toBase gW) ∧
    (∀ (s : Bool), (s = true → M.IsFineSaturated) →
      ∀ (e f : {p : P // p ∈ E}),
        logIdealChartDivisibility M (logIdealMapChart g c) E e.val →
        logIdealChartDivisibility M (logIdealMapChart g c) E f.val →
        ∀ (le : EtaleLogMap M (C s e).log) (lf : EtaleLogMap M (C s f).log),
          le.CompEq (C s e).toBase g → lf.CompEq (C s f).toBase g →
          (∃! b : (M.monoidSheaf.obj.obj (op (Scheme.Etale.mk (𝟙 T))))ˣ,
            logIdealMapChart g c e.val * b.val = logIdealMapChart g c f.val) ∧
          ∃ (L : EtaleLogStructure (logIdealLiftingOpen A α E e f s).toScheme)
            (je : EtaleLogMap L (C s e).log) (jf : EtaleLogMap L (C s f).log)
            (d : EtaleLogMap L N) (k : EtaleLogMap M L),
            je.base = (logIdealLiftingOpen A α E e f s).ι ∧
            jf.IsStrictEtale ∧ je.IsStrictEtale ∧ IsOpenImmersion jf.base ∧
            Set.range jf.base = (logIdealLiftingOpen A α E f e s : Set _) ∧
            je.CompEq (C s e).toBase d ∧ jf.CompEq (C s f).toBase d ∧
            k.CompEq je le ∧ k.CompEq jf lf) := by
  sorry

end AlgebraicGeometry
