module

public import Sheaf.AlgebraicGeometry.TrivialTorusCoherentData
public import Sheaf.AlgebraicGeometry.EquivariantCoherentProperPushforward
public import Mathlib.Algebra.Module.Submodule.EqLocus
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.BigOperators.Finprod
public import Mathlib.RingTheory.Localization.Basic
public import Mathlib.Algebra.GroupWithZero.Units.Basic

/-! # Integral torus Euler characters and their geometric realizations

Source: Milne, Algebraic Groups (2017), Example 22.36, pp.473--474, and
Section 22d, proof of Theorem 22.50, p.480; Stacks 03LF and 02O6.
(blueprint: def-sfb-torus-euler-character-data)

The cotangent representation is the equivariant fibre of the ideal of the point,
namely m/m². Its linearization is the dual derivative action, not the tangent action.
All characters have integer coefficients. No object is selected by an existence proof.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped TensorProduct CategoryTheory.MonObj

namespace AlgebraicGeometry.TorusEulerCharacter

open EquivariantCoherent EquivariantCoherent.ProperPushforwardData
open TrivialTorusCoherent (Character CharacterRing characterValue)

variable {F : Type u} [Field F]

/-- The actual character coefficient in the coordinate Hopf algebra.
Source: Milne, Example 22.36 (blueprint: def-sfb-torus-euler-character-data). -/
def characterCoefficient (T : Grp (Over (Spec (.of F)))) (χ : Character T) :
    Γ(T.X.left, ⊤) :=
  characterValue T χ T.X (𝟙 T.X)

/-- The weight subspace is the equalizer c(v) = v tensor χ.
Source: Milne, Example 22.36 (blueprint: def-sfb-torus-euler-character-data). -/
def weightSpace (T : Grp (Over (Spec (.of F)))) [IsAffine T.X.left]
    (V : Representation F T.X) (χ : Character T) : Submodule F V.space :=
  LinearMap.eqLocus V.coaction
    ((TensorProduct.mk F V.space Γ(T.X.left, ⊤)).flip (characterCoefficient T χ))

/-- The formal character uses integer dimensions of actual weight spaces.
Finite support is an assertion of the weight-decomposition theorem, not an input.
Source: Milne, Example 22.36 (blueprint: def-sfb-torus-euler-character-data). -/
def formalCharacter (T : Grp (Over (Spec (.of F)))) [IsAffine T.X.left]
    (V : Representation F T.X) : CharacterRing T :=
  ∑ᶠ χ : Character T, AddMonoidAlgebra.single χ (Module.finrank F (weightSpace T V χ) : ℤ)

/-- The multiplicative system generated by all nontrivial character Euler factors.
Source: the integral fixed-point input to Milne 22.50
(blueprint: def-sfb-torus-euler-character-data). -/
def eulerSystem (T : Grp (Over (Spec (.of F)))) : Submonoid (CharacterRing T) :=
  Submonoid.closure {x | ∃ χ : Character T, χ ≠ 0 ∧ x = 1 - AddMonoidAlgebra.single χ 1}

/-- The actual localization of the integral character ring at the specified factors.
Source: the integral fixed-point input to Milne 22.50
(blueprint: def-sfb-torus-euler-character-data). -/
abbrev LocalizedRing (T : Grp (Over (Spec (.of F)))) := Localization (eulerSystem T)

/-- The cotangent Euler factor, with every weight repeated its integer multiplicity.
Source: Milne 22.50, fixed-point input
(blueprint: def-sfb-torus-euler-character-data). -/
def eulerFactor (T : Grp (Over (Spec (.of F)))) [IsAffine T.X.left]
    (V : Representation F T.X) : CharacterRing T :=
  ∏ᶠ χ : Character T,
    (1 - AddMonoidAlgebra.single χ 1) ^ Module.finrank F (weightSpace T V χ)

/-- Restriction along the actual subgroup morphism, on every finite tensor presentation.
Source: Milne, Section 4 (blueprint: def-sfb-torus-euler-character-data). -/
def IsRestrictedRepresentation {H : ProperPushforwardData.Group F} (T : ClosedSubgroup F H)
    (V : Representation F H.scheme) (W : Representation F T.group.scheme) : Prop :=
  ∃ e : V.space ≃ₗ[F] W.space,
    ∀ (v : V.space) (n : ℕ) (vi : Fin n → V.space) (ci : Fin n → Γ(H.scheme.left, ⊤)),
      V.coaction v = ∑ j, vi j ⊗ₜ[F] ci j →
        W.coaction (e v) = ∑ j, e (vi j) ⊗ₜ[F] T.map.left.appTop (ci j)

/-- The rational cohomology representation is associated to the canonical higher image.
The higher-image action is pinned in every degree by the normalized base-change exchanges.
Source: Stacks 02O6, 03LF; Milne 22d
(blueprint: def-sfb-torus-euler-character-data). -/
def IsCohomologyRepresentation (H : ProperPushforwardData.Group F) (Z : Space F H)
    {D : ActionGroupoidModel H.scheme Z.scheme} (E : Coherent D)
    (q : ℕ) (V : Representation F H.scheme) : Prop :=
  ∃ (f : ProperMap F Z (point F H))
    (DP : ActionGroupoidModel H.scheme (point F H).scheme) (M : Coherent DP)
    (e : underlying M ≅ (higher F (G := H) (X := Z) (Y := point F H) f.map q).obj
      (underlying E)),
    IsHigherPushforward F f q E M e ∧ IsAssociated F V M ∧
      Nonempty (V.space ≅ cohomologyVector F (G := H) (X := Z) E q)

/-- The fibre and cotangent modules at a fixed rational point, with their induced actions.
Pulling back the equivariant ideal gives I tensor k = m/m². Thus the second
representation has the dual derivative action stipulated in the fixed-point formula.
Source: Stacks 03LF, regular self-intersection; Milne 22d
(blueprint: def-sfb-torus-euler-character-data). -/
def IsFixedFibrePair (T : ProperPushforwardData.Group F) (Z : Space F T)
    {D : ActionGroupoidModel T.scheme Z.scheme} (E : Coherent D)
    (p : (point F T).scheme ⟶ Z.scheme)
    (V N : Representation F T.scheme) : Prop :=
  ∃ hp : IsModHom T.scheme p,
    ∃ (DP : ActionGroupoidModel T.scheme (point F T).scheme)
      (Ep Cp : Coherent DP) (K : Coherent D),
      (by
        letI := hp
        exact IsPullback p E Ep ∧ IsAssociated F V Ep ∧
          IsIdeal p.left K ∧ IsPullback p K Cp ∧ IsAssociated F N Cp)

end AlgebraicGeometry.TorusEulerCharacter
