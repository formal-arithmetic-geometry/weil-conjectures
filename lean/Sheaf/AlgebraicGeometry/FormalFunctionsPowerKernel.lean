module

public import Sheaf.Topology.RingedSpaceModuleCohomology
public import Sheaf.AlgebraicGeometry.CoherentFormalModule
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings

/-! # Ideal powers in the kernel of cohomology reduction

Source: Stacks Project, Theorem 02OC, construction of the comparison maps.
(blueprint: lem-weil-pbc-formal-functions-power-kernel).
-/

@[expose] public section

universe v

open CategoryTheory Opposite

namespace AlgebraicGeometry

/-- Reduction modulo the extended ideal power kills that power on cohomology.
No properness, coherence or Noetherian hypothesis is needed for this assertion.
Source: Stacks Project, Theorem 02OC, construction of the comparison maps.
(blueprint: lem-weil-pbc-formal-functions-power-kernel).

Proof: For a in I^n, its image in global functions belongs to the nth power of
J, since J is the ideal generated by the images of I. Multiplication by this
function on F factors through the image defining J^n F. Its composite with the
cokernel projection F -> F/J^n F is therefore zero. Cohomology is additive and
linear over global functions: applying it identifies multiplication by a with
scalar multiplication on the restricted A-module of cohomology. Consequently
the cohomology reduction sends a times every class to zero. The submodule
I^n times top is generated by these elements, giving the asserted inclusion.
The argument includes n=0: the zeroth ideal power is the unit ideal and its
product with F is F, so the quotient and its cohomology are zero. -/
theorem formalFunctions_power_le_ker {A : Type v} [CommRing A]
    (I : Ideal A) {X : Scheme.{v}} (f : X ⟶ Spec (CommRingCat.of A))
    (J : X.IdealSheafData)
    (hJ : J = (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)).comap f)
    (F : X.Modules) (p n : ℕ) :
    I ^ n • (⊤ : Submodule A
      ((RingedSpace.moduleCohomology X.toRingedSpace p ⋙ ModuleCat.restrictScalars
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f.appTop).hom).obj F)) ≤
    LinearMap.ker ((RingedSpace.moduleCohomology X.toRingedSpace p ⋙
      ModuleCat.restrictScalars
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ f.appTop).hom).map
      (formalModuleQuotientπ J n F)).hom := by sorry

end AlgebraicGeometry
