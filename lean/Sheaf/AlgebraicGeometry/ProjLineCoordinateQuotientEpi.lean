module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpectrum.Twist
public import WeilConjectures.Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.CategoryTheory.Preadditive.Biproducts
import WeilConjectures.AlgebraicGeometry.Modules.PullbackMonoidal

@[expose] public section
universe u
open CategoryTheory Limits MonoidalCategory AlgebraicGeometry
namespace AlgebraicGeometry
attribute [local instance] MvPolynomial.gradedAlgebra

private theorem isIso_map_coordinate_whisker
    {C D : Type*} [Category C] [Category D] [MonoidalCategory C] [MonoidalCategory D]
    (F : C ⥤ D) [F.Monoidal] (A : C) {B B' : C} (f : B ⟶ B') [IsIso (F.map f)] :
    IsIso (F.map (A ◁ f)) := by
  rw [Functor.Monoidal.map_whiskerLeft]
  infer_instance

/-- Multiplication by the two homogeneous coordinates gives an epimorphism.

Source: the two-chart calculation in
`dag/nodes/sec-picard-framework/lem-sc-p1-proj-coordinate-short-exact.json`,
proof step 1; compare the stalk argument in
WeilConjectures.AlgebraicGeometry.ProjectiveSpace.Twist, epi_sigmaUnitToTwist.
(blueprint: lem-sc-p1-proj-coordinate-quotient-epi).

Proof: The irrelevant ideal is generated by x_0 and x_1, so D+(x_0) and
D+(x_1) cover Proj. On D+(x_i), twistMul by x_i is invertible, including
for negative twists. Restriction agrees with pullback, and pullback is
monoidal; hence G whiskered with this map is also invertible locally.
At any point choose a chart containing it. The corresponding coordinate
map is surjective on its stalk and factors through the quotient map by
the corresponding biproduct inclusion. The quotient map is therefore
surjective on this stalk. Surjectivity at every stalk implies epimorphy.
This applies to the zero module and arbitrary torsion modules without flatness.
-/
theorem proj_coordinate_quotient_epi
    (k : Type u) [Field k]
    (G : (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) k)).Modules) (z : ℤ) :
    Epi (biprod.desc
      (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (0 : Fin 2)))
      (G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k (1 : Fin 2)))) := by
  let μ (i : Fin 2) :=
    G ◁ Proj.twistMul z (MvPolynomial.X_mem_homogeneousSubmodule_one k i)
  let g := biprod.desc (μ 0) (μ 1)
  change Epi g
  refine Scheme.Modules.epi_of_surjective_stalk g fun x ↦ ?_
  have hcover : (⨆ i : Fin 2, Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top
    rw [MvPolynomial.toIdeal_irrelevant_homogeneousSubmodule]
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcover.ge (Set.mem_univ x))
  let U := Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X i)
  let F := Scheme.Modules.pullback U.ι
  have hμ : IsIso ((Scheme.Modules.restrictFunctor U.ι).map (μ i)) := by
    rw [NatIso.isIso_map_iff (Scheme.Modules.restrictFunctorIsoPullback U.ι)]
    have ht : IsIso (F.map (Proj.twistMul z
        (MvPolynomial.X_mem_homogeneousSubmodule_one k i))) := by
      rw [← NatIso.isIso_map_iff (Scheme.Modules.restrictFunctorIsoPullback U.ι)]
      infer_instance
    change IsIso (F.map (μ i))
    exact isIso_map_coordinate_whisker F G _
  let T := Scheme.Modules.toPresheaf _ ⋙ TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
  have hs : Function.Surjective (T.map (μ i)) :=
    (Scheme.Modules.bijective_stalk_of_isIso_restrict (μ i) x hi).2
  have hfac : ∃ j, j ≫ g = μ i := by
    fin_cases i
    · exact ⟨biprod.inl, biprod.inl_desc _ _⟩
    · exact ⟨biprod.inr, biprod.inr_desc _ _⟩
  obtain ⟨j, hj⟩ := hfac
  have he : T.map j ≫ T.map g = T.map (μ i) := by rw [← T.map_comp, hj]
  rw [← he] at hs
  exact Function.Surjective.of_comp hs

end AlgebraicGeometry
