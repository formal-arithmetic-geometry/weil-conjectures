module

public import Sheaf.AlgebraicGeometry.EquivariantCoherentGZero
public import Sheaf.AlgebraicGeometry.TrivialTorusCoherentData
public import Mathlib.RingTheory.Localization.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Tower

/-! # Character twists and localized closed pushforward

Source: the integral concentration prerequisite for Milne, Algebraic Groups,
Section 22d, proof of Theorem 22.50, p.480; Stacks 03LF for linearizations.
(blueprint: def-sfb-torus-coherent-localization-data)

The character group and its integral group ring are the recorded definitions.
Twists multiply the forward action by the character. Localized pushforward is
extension of scalars of the map normalized on actual closed pushforward modules.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj TensorProduct

namespace AlgebraicGeometry.EquivariantCoherent.TorusLocalization

variable {F : Type u} [Field F] (T : Grp (Over (Spec (.of F))))

/-- The multiplicative subset generated by all nontrivial character Euler factors.
Source: the integral concentration prerequisite for Milne 22.50, p.480
(blueprint: def-sfb-torus-coherent-localization-data). -/
def eulerFactors : Submonoid (TrivialTorusCoherent.CharacterRing T) :=
  Submonoid.closure {a | ∃ χ : TrivialTorusCoherent.Character T,
    χ ≠ 0 ∧ a = 1 - AddMonoidAlgebra.single χ (1 : ℤ)}

variable {T} {Y : Over (Spec (.of F))} [ModObj T.X Y]

/-- A character twist, identified on its underlying sheaf, with the forward sign.
The displayed inverse descent isomorphism is the action from y to ty.
Source: Stacks 03LF and the concentration prerequisite for Milne 22.50, p.480
(blueprint: def-sfb-torus-coherent-localization-data). -/
def IsCharacterTwist {D : ActionGroupoidModel T.X Y}
    (χ : TrivialTorusCoherent.Character T) (M N : Coherent D) : Prop :=
  ∃ e : underlying N ≅ underlying M,
    (Scheme.Modules.tensorPullback (source T.X Y)).map e.hom ≫
        (linearization M).inv ≫
        ((Scheme.Modules.tensorPullback (target T.X Y)).obj (underlying M)).smulHom
          (TrivialTorusCoherent.characterValue T χ (T.X ⊗ Y) (fst T.X Y)) =
      (linearization N).inv ≫
        (Scheme.Modules.tensorPullback (target T.X Y)).map e.hom

/-- An actual module structure on the existing integral G-zero quotient, normalized
by character twists. Existence of representatives makes the normalization nonvacuous.
Source: the integral concentration prerequisite for Milne 22.50, p.480
(blueprint: def-sfb-torus-coherent-localization-data). -/
structure CharacterAction (D : ActionGroupoidModel T.X Y) where
  module : Module (TrivialTorusCoherent.CharacterRing T) (GZero D)
  twist_exists : ∀ (χ : TrivialTorusCoherent.Character T) (M : Coherent D),
    ∃ N : Coherent D, IsCharacterTwist χ M N
  twist_class : ∀ (χ : TrivialTorusCoherent.Character T) (M N : Coherent D),
    IsCharacterTwist χ M N →
      module.smul (AddMonoidAlgebra.single χ (1 : ℤ)) (classOf M) = classOf N

/-- Ordinary equivariant closed pushforward, extended to the character localization,
is bijective. The map on integral groups is pinned on every sheaf generator to
ordinary pushforward, using the existing equivariant adjunction predicate.
The scalar extension is an R_Sigma-linear map, so bijectivity is exactly a localized
module isomorphism. Its tensor order R_Sigma tensor_R G-zero is the canonical
commuted form of G-zero tensor_R R_Sigma in the node.
Source: the integral concentration prerequisite for Milne 22.50, p.480
(blueprint: def-sfb-torus-coherent-localization-data). -/
def IsLocalizedClosedPushforwardIso {W : Over (Spec (.of F))} [ModObj T.X W]
    (DY : ActionGroupoidModel T.X Y) (DW : ActionGroupoidModel T.X W)
    (i : W ⟶ Y) [IsModHom T.X i]
    (mY : CharacterAction DY) (mW : CharacterAction DW) : Prop := by
  letI := mY.module
  letI := mW.module
  exact ∃ push : GZero DW →ₗ[TrivialTorusCoherent.CharacterRing T] GZero DY,
    (∀ N : Coherent DW, ∃ M : Coherent DY, IsPushforward i N M) ∧
    (∀ (N : Coherent DW) (M : Coherent DY), IsPushforward i N M →
      push (classOf N) = classOf M) ∧
    Function.Bijective (push.baseChange (Localization (eulerFactors T)))

end AlgebraicGeometry.EquivariantCoherent.TorusLocalization
