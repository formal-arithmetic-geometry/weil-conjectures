module

public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.AlgebraicGeometry.Morphisms.Separated
public import Mathlib.CategoryTheory.Monoidal.Cartesian.Over
public import Mathlib.Logic.Relation
public import Sheaf.AlgebraicGeometry.TensorPullbackSectionAdjunction
public import WeilConjectures.AlgebraicGeometry.Modules.Invertible

/-! # Algebraic equivalence of invertible modules

Source: Milne, Abelian Varieties, Chapter I §8 and Remark 10.19; conventions, p. v.
(blueprint: def-sfb-line-algebraic-equivalence)

The relation is constructed from families, including isomorphisms of representatives,
and then closed under reflexivity, symmetry and transitivity. No Picard scheme is chosen.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory MonoidalCategory CartesianMonoidalCategory

namespace AlgebraicGeometry.Scheme.Modules

/-- A generating pair consists of isomorphic modules, or two fibres of one invertible
module on `X ×ₖ T`, for a smooth connected separated finite-type parameter variety `T`.
The terminal object of `Over (Spec k)` is `Spec k`, so `t₀` and `t₁` are rational points.
Source: Milne, Abelian Varieties, I §8; conventions, p. v.
(blueprint: def-sfb-line-algebraic-equivalence) -/
def LineAlgebraicEquivalenceStep {k : Type u} [Field k]
    (X : Over (Spec (.of k))) (M N : X.left.Modules) : Prop :=
  Nonempty (M ≅ N) ∨
    ∃ T : Over (Spec (.of k)),
      Smooth T.hom ∧ QuasiCompact T.hom ∧ IsSeparated T.hom ∧ ConnectedSpace T.left ∧
      ∃ P : (X ⊗ T).left.Modules, P.IsInvertible ∧
        ∃ t₀ t₁ : 𝟙_ (Over (Spec (.of k))) ⟶ T,
          Nonempty
            ((tensorPullback (lift (𝟙 X) (toUnit X ≫ t₀)).left).obj P ≅ M) ∧
          Nonempty
            ((tensorPullback (lift (𝟙 X) (toUnit X ≫ t₁)).left).obj P ≅ N)

/-- Algebraic equivalence on invertible-module isomorphism classes, expressed on
representatives: the equivalence relation generated by isomorphisms and pairs of fibres
in smooth connected families. The endpoint conditions restrict it to invertible modules.
Smoothness implies locally finite type, so quasi-compactness gives finite type; smoothness
also gives geometric reducedness, as required by Milne's convention for a variety.
Source: Milne, Abelian Varieties, I §8 and Remark 10.19; conventions, p. v.
(blueprint: def-sfb-line-algebraic-equivalence) -/
def AreAlgebraicallyEquivalent {k : Type u} [Field k]
    (X : Over (Spec (.of k))) (M N : X.left.Modules) : Prop :=
  M.IsInvertible ∧ N.IsInvertible ∧ Relation.EqvGen (LineAlgebraicEquivalenceStep X) M N

end AlgebraicGeometry.Scheme.Modules
