module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.Smooth.StandardSmooth
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Regular generators for a standard smooth affine diagonal

Source: Stacks Project, Tag 067R; the affine diagonal calculation in
WeilConjectures/AlgebraicGeometry/Morphisms/RegularImmersion.lean:336-375
(blueprint: lem-sc-standard-smooth-affine-diagonal-generators).
-/

@[expose] public section

universe u v

open scoped TensorProduct

namespace AlgebraicGeometry

/-- At every point in the diagonal image of a standard smooth affine chart of positive
relative dimension `d`, its defining ideal on some affine neighbourhood is generated by a
regular sequence of length `d`.
Source: Stacks Project, Tag 067R; RegularImmersion.lean:336-375
(blueprint: lem-sc-standard-smooth-affine-diagonal-generators).

Proof: choose an etale polynomial chart in `d` variables
(lem-sc-standard-smooth-etale-polynomial-chart). It is flat
(lem-weil-pbc-etale-algebra-flat). The coordinate differences in `A ⊗[R] A` are weakly
regular (lem-sc-flat-polynomial-diagonal-differences-weakly-regular), lie in the kernel
of multiplication, and multiplication is surjective since it sends `a ⊗ 1` to `a`.
Etale kernel clearance supplies an element mapping to one that multiplies the kernel
into the coordinate-difference ideal (lem-sc-etale-polynomial-diagonal-kernel-clearance).
The affine kernel criterion gives local weakly regular generators of length `d`
(lem-sc-affine-regular-immersion-kernel-criterion). At an image point the inverse image
of the neighbourhood is nonempty, so the kernel ideal is proper. Its quotient is nonzero,
upgrading weak regularity to regularity (def-weil-pbc-regular-sequence).
The diagonal is Spec of multiplication (def-weil-affine-spectrum). -/
theorem exists_isRegular_diagonal_generators_of_isStandardSmooth
    {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
    {d : ℕ} (hd : 0 < d) [Algebra.IsStandardSmoothOfRelativeDimension d R A] :
    let W := Spec (CommRingCat.of (A ⊗[R] A))
    let Δ := Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom)
    ∀ w : W, w ∈ Set.range Δ →
      ∃ U : W.affineOpens, w ∈ U.1 ∧
        ∃ r : List Γ(W, U.1), r.length = d ∧
          RingTheory.Sequence.IsRegular Γ(W, U.1) r ∧
          Ideal.ofList r = RingHom.ker (Δ.app U.1).hom := by
  sorry

end AlgebraicGeometry
