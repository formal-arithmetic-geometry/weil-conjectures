module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import WeilConjectures.AlgebraicGeometry.FiberDegreeBound

/-!
# Finite degree under compatible field and scheme isomorphisms

Source: Stacks Project, Morphisms, Tag 03J5, proof of (1) implies (2), and the
paragraph before Tag 03J4; the auxiliary isomorphism argument is expanded in the DAG.
(blueprint: lem-weil-pbc-finite-field-degree-isomorphism-transport)
-/

@[expose] public section

set_option autoImplicit false

universe u w

open CategoryTheory

private theorem transport_basis {R S M N : Type*} [Field R] [Field S]
    [AddCommGroup M] [AddCommGroup N] [Module R M] [Module S N]
    (φ : R ≃+* S)
    (f : haveI := RingHomInvPair.of_ringEquiv φ
      have := RingHomInvPair.of_ringEquiv φ.symm
      M ≃ₛₗ[(φ : R →+* S)] N) {I : Type*} (b : Module.Basis I R M) :
    ∃ b' : Module.Basis I S N, ∀ i, b' i = f (b i) := by
  have := RingHomInvPair.of_ringEquiv φ
  have := RingHomInvPair.of_ringEquiv φ.symm
  refine ⟨.ofRepr ((f.symm.trans b.repr).trans
    (Finsupp.mapRange.linearEquiv φ.toSemilinearEquiv)), ?_⟩
  intro i
  simp [Module.Basis.coe_ofRepr, Finsupp.mapRange.linearEquiv]

namespace AlgebraicGeometry.Scheme.Hom

/-- A compatible isomorphism over isomorphic fields induces the canonical semilinear
ring isomorphism on global sections, transports every indexed basis, and preserves
finiteness and finite degree. The module structures in the basis clause are exactly
`h.ΓAlgebra` and `q.ΓAlgebra`, and `finrankΓ` uses these same structures.

Source: Stacks Project, Morphisms, Tag 03J5, proof of (1) implies (2), and the
paragraph before Tag 03J4, expanded as follows.

1. Evaluate the structure-sheaf maps of `u` and its inverse on the whole space.
   Functoriality makes their composites identities, giving the ring isomorphism `e`
   with forward map `u.hom.appTop.hom` (def-weil-locally-ringed-space-morphism).
2. Evaluate the commuting square on global sections. The canonical Spec section
   identifications and `ΓSpecIso_inv_naturality` (lem-weil-pbc-spec-map-global-sections)
   give `e ∘ α = β ∘ φ`; multiplicativity gives the displayed semilinearity identity.
   The inverse identity uses `φ.symm` and `e.symm`.
3. Expand vectors in a basis by finite sums. Apply `e` and transport coefficients
   through `φ` to prove spanning. Apply `e.symm` and `φ.symm` to a finite relation
   to prove independence. Reverse these arguments for the converse. They apply to
   every index set, including the empty one.
4. Scheme isomorphisms are finite: inverse images of affine opens are affine and
   their section-ring maps are isomorphisms, generated by one as modules. Factor
   `q` as `u.hom ≫ h ≫ (Spec φ).inv` and `h` in the reverse direction. Apply
   lem-weil-pbc-finite-composition twice in each direction.
5. Under finiteness, lem-weil-pbc-finite-over-field-affine-finite-dim makes both
   section algebras finite-dimensional with precisely the induced scalar maps.
   Remove dependent vectors from a finite spanning list of the first algebra.
   Step 3 transports the resulting finite basis with the same index set. Its
   cardinality computes both dimensions (def-weil-vector-space-dimension), hence
   both degrees (def-weil-pbc-fibre-degree-bound). This also covers the zero ring.
(blueprint: lem-weil-pbc-finite-field-degree-isomorphism-transport) -/
theorem finite_field_degree_isomorphism_transport
    {K L : Type u} [Field K] [Field L] (φ : K ≃+* L)
    {Z T : Scheme.{u}} (h : Z ⟶ Spec (CommRingCat.of K))
    (q : T ⟶ Spec (CommRingCat.of L)) (u : T ≅ Z)
    (comm : u.hom ≫ h = q ≫ Spec.map (CommRingCat.ofHom φ.toRingHom)) :
    ∃ e : Γ(Z, ⊤) ≃+* Γ(T, ⊤),
      e.toRingHom = u.hom.appTop.hom ∧
      e.toRingHom.comp (((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ h.appTop).hom) =
        (((Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ q.appTop).hom).comp φ.toRingHom ∧
      (∀ (a : K) (v : Γ(Z, ⊤)),
        e ((((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ h.appTop).hom a) * v) =
          (((Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ q.appTop).hom (φ a)) * e v) ∧
      (∀ (I : Type w) (v : I → Γ(Z, ⊤)),
        (∃ b : @Module.Basis I K Γ(Z, ⊤) _ _
            (@Algebra.toModule K Γ(Z, ⊤) _ _ h.ΓAlgebra), ∀ i : I, b i = v i) ↔
        (∃ b : @Module.Basis I L Γ(T, ⊤) _ _
            (@Algebra.toModule L Γ(T, ⊤) _ _ q.ΓAlgebra), ∀ i : I, b i = e (v i))) ∧
      (IsFinite h ↔ IsFinite q) ∧
      (IsFinite h → h.finrankΓ = q.finrankΓ) := by
  let e := (asIso u.hom.appTop).commRingCatIsoToRingEquiv
  have he : e.toRingHom = u.hom.appTop.hom := rfl
  have hc : e.toRingHom.comp
      (((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ h.appTop).hom) =
      (((Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ q.appTop).hom).comp φ.toRingHom := by
    change (u.hom.appTop.hom).comp
      (((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ h.appTop).hom) =
      (((Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ q.appTop).hom).comp
        (CommRingCat.ofHom φ.toRingHom).hom
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Category.assoc,
      ← Scheme.Hom.comp_appTop, comm, Scheme.Hom.comp_appTop,
      ← Scheme.ΓSpecIso_inv_naturality_assoc]
  refine ⟨e, he, hc, ?_, ?_, ?_, ?_⟩
  · intro a v
    rw [map_mul]
    exact congrArg (fun x ↦ x * e v) (RingHom.congr_fun hc a)
  · let := h.ΓAlgebra
    let := q.ΓAlgebra
    have := RingHomInvPair.of_ringEquiv φ
    have := RingHomInvPair.of_ringEquiv φ.symm
    let f : Γ(Z, ⊤) ≃ₛₗ[(φ : K →+* L)] Γ(T, ⊤) :=
      { e.toAddEquiv with
        map_smul' := fun a v ↦ by
          change e (_ * v) = _ * e v
          rw [map_mul]
          exact congrArg (fun x ↦ x * e v) (RingHom.congr_fun hc a) }
    intro I v
    constructor
    · rintro ⟨b, hb⟩
      obtain ⟨b', hb'⟩ := transport_basis φ f b
      exact ⟨b', fun i ↦ (hb' i).trans (congrArg e (hb i))⟩
    · rintro ⟨b, hb⟩
      obtain ⟨b', hb'⟩ := transport_basis φ.symm f.symm b
      refine ⟨b', fun i ↦ ?_⟩
      rw [hb', hb]
      exact e.symm_apply_apply (v i)
  · have : IsIso (CommRingCat.ofHom φ.toRingHom) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr φ.bijective
    have : IsIso (Spec.map (CommRingCat.ofHom φ.toRingHom)) := inferInstance
    rw [← MorphismProperty.cancel_left_of_respectsIso (P := @IsFinite) u.hom, comm,
      MorphismProperty.cancel_right_of_respectsIso (P := @IsFinite)]
  · intro _
    let := h.ΓAlgebra
    let := q.ΓAlgebra
    exact Algebra.finrank_eq_of_equiv_equiv φ e hc.symm

end AlgebraicGeometry.Scheme.Hom
