/-! # Minimal envelopes and comparison of Hilbert--Samuel coefficients

Source: ILO VIII 2.3.11--2.3.13, pp. 93--94 (background); BM 1997, Remarks 6.3
and Definition 6.4; BMT 6.2--6.3; the seven-step agent assembly in the DAG
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).
The statements distinguish essential transverse rank from the zero-ideal regular case,
construct the displayed coefficient and suspension ideals, and compare finite tests and
chronologically labelled intrinsic history ideals. No equality of coefficient ideals is claimed.
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u w
open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.HilbertSamuel

/-- Common pointed étale comparison after two possibly different étale localizations of
identified intrinsic schemes. The earlier-center list consists of actual ambient ideal
sheaves. It is kept separate from the test boundary in `W`.
Source: BM 1997, Remarks 6.3 and Definition 6.4; BMT 6.2--6.3
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
structure CommonEtaleGermComparison {k : Type u} [Field k]
    (S T : Embedded k) {X Y : Scheme.{u}} (intrinsic : X ≅ Y) (x : X)
    (zS : S.Z) (zT : T.Z)
    (rS : S.X ⟶ X) (rT : T.X ⟶ Y)
    (earlierS : List S.Z.IdealSheafData) (earlierT : List T.Z.IdealSheafData) where
  W : Embedded k
  f : W.Z ⟶ S.Z
  g : W.Z ⟶ T.Z
  f_etale : Etale f
  g_etale : Etale g
  f_pullback : Pullback f 0
  g_pullback : Pullback g 0
  qS : W.X ⟶ S.X
  qT : W.X ⟶ T.X
  squareS : IsPullback qS W.i S.i f
  squareT : IsPullback qT W.i T.i g
  intrinsic_eq : qS ≫ rS ≫ intrinsic.hom = qT ≫ rT
  w : W.X
  point : rS (qS w) = x
  pointS : f (W.i w) = zS
  pointT : g (W.i w) = zT
  earlier : earlierS.map (fun I ↦ I.comap f) = earlierT.map (fun I ↦ I.comap g)

end AlgebraicGeometry.HilbertSamuel

namespace AlgebraicGeometry.HilbertCoefficient

private theorem ideal_coherent {Z : Scheme.{u}} [IsLocallyNoetherian Z]
    (I : Z.IdealSheafData) : Scheme.Modules.IsQuasiCoherentFiniteType I.toModules := by
  have := SheafOfModules.isQuasicoherent_unit (R := Z.ringCatSheaf)
  have := SheafOfModules.isQuasicoherent_unit (R := I.subscheme.ringCatSheaf)
  have : SheafOfModules.IsQuasicoherent (R := Z.ringCatSheaf)
      ((SheafOfModules.pushforward I.subschemeι.toRingCatSheafHom).obj
        (SheafOfModules.unit I.subscheme.ringCatSheaf)) :=
    Scheme.Modules.isQuasicoherent_pushforward_of_quasiCompact_quasiSeparated I.subschemeι _
  exact ⟨Scheme.Modules.isQuasicoherent_kernel I.toPushforwardSubscheme,
    I.isFiniteType_toModules_sheaf I.ofFiniteType_of_isLocallyNoetherian⟩

/-- Positive common multiple of the positive coefficient weights, with the prescribed empty
list convention. Source: the formula for I in the node; BM 1997, Definition 6.4
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def IsCommonCoefficientMarking {n s : ℕ} (α : Fin s → Fin n →₀ ℕ) (b : ℕ) : Prop :=
  0 < b ∧ (s = 0 → b = 1) ∧
    ∀ (l : Fin s) (γ : Fin n →₀ ℕ), γ.degree < (α l).degree →
      (α l).degree - γ.degree ∣ b

/-- The displayed ideal generated by the actual regular coefficient powers. There are no
powers for nonpositive weights. Empty vertex lists give the zero ideal.
Source: the formula for I in the node; BM 1997, Definition 6.4
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def RegularHilbertCoefficientDatum.markedCoefficientIdeal
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} {i : X ⟶ M} {a : X} {m n s Q : ℕ}
    {α : Fin s → Fin n →₀ ℕ} (D : RegularHilbertCoefficientDatum p i a m n s α Q)
    (b : ℕ) : D.N.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (Ideal.span {f | ∃ (l : Fin s) (γ : Fin n →₀ ℕ),
    γ.degree < (α l).degree ∧ f = D.coeff l γ ^ (b / ((α l).degree - γ.degree))})

/-- The coefficient ideal is coherent on the smooth coefficient scheme.
Source: the explicit finite weighted coefficient list in the node; BM 1997, Definition 6.4
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: for each of the finitely many vertices there are finitely many multi-indices below
its total degree. The displayed powers therefore give finitely many generators on the affine
N. Quasi-coherence is built into IdealSheafData; its finite generators give finite type.
Smoothness over a field makes N locally Noetherian, so this is coherence (pqf-def-coherent).
This is the coherence observation at the start of DAG step 3. -/
theorem RegularHilbertCoefficientDatum.markedCoefficientIdeal_coherent
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} {i : X ⟶ M} {a : X} {m n s Q : ℕ}
    {α : Fin s → Fin n →₀ ℕ} (D : RegularHilbertCoefficientDatum p i a m n s α Q)
    (b : ℕ) :
    Scheme.Modules.IsQuasiCoherentFiniteType (D.markedCoefficientIdeal b).toModules := by
  have : Smooth (D.j ≫ D.e ≫ p) := D.smoothN
  have : IsLocallyNoetherian D.N := LocallyOfFiniteType.isLocallyNoetherian (D.j ≫ D.e ≫ p)
  exact ideal_coherent _

/-- The actual embedded pullback to the one common coefficient chart, with the intrinsic
level at a and empty newly started boundary. Source: BM 1997, Definition 6.4; DAG step 1
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def RegularHilbertCoefficientDatum.coefficientAmbient
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} [Smooth p] {i : X ⟶ M} [IsClosedImmersion i]
    {a : X} {m n s Q : ℕ} {α : Fin s → Fin n →₀ ℕ}
    (D : RegularHilbertCoefficientDatum p i a m n s α Q) : HilbertSamuel.Embedded k := by
  have : Etale D.e := D.etale_e
  exact {
    Z := D.U
    p := D.e ≫ p
    smooth := inferInstance
    X := pullback i D.e
    i := pullback.snd i D.e
    closed := inferInstance
    level := HilbertSamuel.function (i ≫ p) a
    boundary := [] }

/-- The marked datum uses exactly the supplied N, its closed embedding and the displayed
coefficient ideal. Source: BM 1997, Definition 6.4; DAG steps 1 and 3
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def RegularHilbertCoefficientDatum.coefficientMarked
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} [Smooth p] {i : X ⟶ M} [IsClosedImmersion i]
    {a : X} {m n s Q : ℕ} {α : Fin s → Fin n →₀ ℕ}
    (D : RegularHilbertCoefficientDatum p i a m n s α Q) (b : ℕ) (hb : 0 < b) :
    HilbertSamuel.Marked D.coefficientAmbient where
  N := D.N
  j := D.j
  closed := D.closed_j
  smooth := by simpa only [coefficientAmbient, Category.assoc] using D.smoothN
  ideal := D.markedCoefficientIdeal b
  coherent := D.markedCoefficientIdeal_coherent b
  marking := b
  positive := hb

/-- Allow the original coefficient datum or its displayed full-envelope suspension, using
its essential transverse rank. Source: DAG steps 3 and 5
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def RegularHilbertCoefficientDatum.IsCoefficientRepresentative
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} [Smooth p] {i : X ⟶ M} [IsClosedImmersion i]
    {a : X} {m n s Q : ℕ} {α : Fin s → Fin n →₀ ℕ}
    (D : RegularHilbertCoefficientDatum p i a m n s α Q) (b : ℕ) (hb : 0 < b)
    (P : HilbertSamuel.Marked D.coefficientAmbient) : Prop :=
  P = D.coefficientMarked b hb ∨
    MarkedIdeal.IsLocallySuspended (D.coefficientMarked b hb) P n

/-- Reduced finite-type rational schemes admit minimal envelopes locally.
Source: ILO VIII 2.3.11--2.3.13; BM 1997, Remark 6.3; DAG step 1
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: apply lem-trf-smooth-embedding-etale-comparison over the lifted rational field.
Its canonical differential-fibre criterion is the cotangent-space minimality in the node.
The supplied neighborhood is open, hence also an allowed étale localization. -/
theorem coefficient_minimal_envelope_exists
    (X : Scheme.{u}) [IsReduced X] (p : X ⟶ Spec (.of (ULift.{u} ℚ)))
    [LocallyOfFiniteType p] [QuasiCompact p] (a : X) :
    ∃ (U : X.Opens) (ha : a ∈ U) (M : Scheme.{u})
      (q : M ⟶ Spec (.of (ULift.{u} ℚ))) (i : U.toScheme ⟶ M),
      i ≫ q = U.ι ≫ p ∧ q.IsMinimalSmoothEnvelope i ⟨a, ha⟩ := by
  have : CharZero (ULift.{u} ℚ) :=
    ⟨fun m n h ↦ Nat.cast_injective (congrArg ULift.down h : (m : ℚ) = n)⟩
  exact Scheme.exists_minimal_smooth_envelope (ULift.{u} ℚ) X p a

/-- Singular intrinsic germs have positive essential transverse rank.
Source: BM 1997, Remark 6.3; DAG step 2
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: if n=0 a vertex has degree zero. Condition (1) would make its series a unit in the
proper Taylor ideal at b0, impossible. Thus the list is empty; condition (3) makes the Taylor
ideal zero. Contract by lem-trf-diagonal-taylor-faithful-flatness and
lem-weil-pbc-faithfully-flat-ideal-contraction to get the zero defining stalk ideal on U.
Descend it through the étale local stalk map: lem-trf-etale-local-ring-flatness and
lem-weil-pbc-flat-local-hom-faithfully-flat make this map faithfully flat, so a second
contraction gives zero defining ideal at a. The local ring of X then equals the smooth
ambient local ring, regular by lem-weil-pbc-smooth-scheme-over-field-regular, a contradiction.
The residue-field-valued diagonal Taylor map also covers nonclosed a. -/
theorem coefficient_transverse_rank_pos
    {X M : Scheme.{u}} [IsReduced X] (p : M ⟶ Spec (.of (ULift.{u} ℚ)))
    [Smooth p] (i : X ⟶ M) [IsClosedImmersion i]
    [LocallyOfFiniteType (i ≫ p)] [QuasiCompact (i ≫ p)]
    (a : X) (hminimal : p.IsMinimalSmoothEnvelope i a)
    {m n s Q : ℕ} (α : Fin s → Fin n →₀ ℕ) (hα : orderedVertices α)
    (D : RegularHilbertCoefficientDatum p i a m n s α Q)
    (hsingular : ¬ IsRegularLocalRing (X.presheaf.stalk a)) : 0 < n := by
  sorry

/-- The supplied regular equations yield pointed étale transverse retraction coordinates of
exactly the essential rank, after localization. Source: DAG step 1; BM 1997, Remark 6.3
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: apply the smooth-closed-pair retraction assertion of
lem-trf-smooth-embedding-etale-comparison to N in U at b0. The n supplied regular equations
and their invertible transverse Jacobian identify the conormal rank with n. The resulting
pointed Cartesian zero-section chart is therefore a SuspensionChart of rank n. Its boundary
is empty, as required for the newly started finite tests. -/
theorem coefficient_retraction_exists
    {X M : Scheme.{u}} (p : M ⟶ Spec (.of (ULift.{u} ℚ))) [Smooth p]
    (i : X ⟶ M) [IsClosedImmersion i] (a : X) {m n s Q : ℕ}
    {α : Fin s → Fin n →₀ ℕ} (D : RegularHilbertCoefficientDatum p i a m n s α Q) :
    ∃ (W : Scheme.{u}) (v : W ⟶ D.U) (_hv : Etale v) (w : W),
      v w = D.center ∧ Nonempty (MarkedIdeal.SuspensionChart (pullback.snd D.j v) [] n) := by
  sorry

/-- The explicit suspension ideal is coherent; its data are given by the displayed formula.
Source: DAG step 3; BM 1997, Definition 6.4
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: the coefficient ideal has a finite list of generators; pull it back under the
retraction and adjoin the finitely many normal-coordinate powers. These generate the
suspension on the smooth locally Noetherian ambient, so it is coherent (pqf-def-coherent). -/
theorem RegularHilbertCoefficientDatum.suspendedCoefficientIdeal_coherent
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} [Smooth p] {i : X ⟶ M} [IsClosedImmersion i]
    {a : X} {m n s Q : ℕ} {α : Fin s → Fin n →₀ ℕ}
    (D : RegularHilbertCoefficientDatum p i a m n s α Q) (b : ℕ)
    (c : MarkedIdeal.SuspensionChart D.j [] n) :
    Scheme.Modules.IsQuasiCoherentFiniteType
      (MarkedIdeal.suspension c.retraction c.parameters
        (D.markedCoefficientIdeal b) b).toModules := by
  have : Etale D.e := D.etale_e
  have : IsLocallyNoetherian D.U := LocallyOfFiniteType.isLocallyNoetherian (D.e ≫ p)
  exact ideal_coherent _

/-- The full-envelope marked datum with the actual displayed suspension ideal.
Source: DAG step 3; BM 1997, Definition 6.4
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def RegularHilbertCoefficientDatum.suspendedCoefficientMarked
    {k : Type u} [Field k] {X M : Scheme.{u}}
    {p : M ⟶ Spec (.of k)} [Smooth p] {i : X ⟶ M} [IsClosedImmersion i]
    {a : X} {m n s Q : ℕ} {α : Fin s → Fin n →₀ ℕ}
    (D : RegularHilbertCoefficientDatum p i a m n s α Q) (b : ℕ) (hb : 0 < b)
    (c : MarkedIdeal.SuspensionChart D.j [] n) : HilbertSamuel.Marked D.coefficientAmbient where
  N := D.U
  j := 𝟙 D.U
  closed := inferInstance
  smooth := by simpa using D.coefficientAmbient.smooth
  ideal := MarkedIdeal.suspension c.retraction c.parameters (D.markedCoefficientIdeal b) b
  coherent := D.suspendedCoefficientIdeal_coherent b c
  marking := b
  positive := hb

/-- In the specified étale retraction coordinates the explicit coherent suspension ideal
has exactly the same finite tests; at a singular germ its order is exactly b on cosupport.
Source: BM 1997, Remarks 6.3 and Definition 6.4; DAG steps 1--3
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: step 1 supplies retraction coordinates by lem-trf-smooth-embedding-etale-comparison.
The formula below is MarkedIdeal.suspension of the actual coefficient powers. Step 2 gives
positive rank at a singular point, as in coefficient_transverse_rank_pos. Apply
lem-trf-marked-ideal-transverse-suspension with empty test boundary: it gives cosupport and
finite-test equivalence, hence presentation, and exact order b in positive rank. The same
argument works on every further étale chart and allows I=0. -/
theorem coefficient_suspension
    {X M : Scheme.{u}} [IsReduced X] (p : M ⟶ Spec (.of (ULift.{u} ℚ)))
    [Smooth p] (i : X ⟶ M) [IsClosedImmersion i]
    [LocallyOfFiniteType (i ≫ p)] [QuasiCompact (i ≫ p)]
    (a : X) (hminimal : p.IsMinimalSmoothEnvelope i a)
    {m n s Q : ℕ} (α : Fin s → Fin n →₀ ℕ) (hα : orderedVertices α)
    (D : RegularHilbertCoefficientDatum p i a m n s α Q)
    (b : ℕ) (hb : IsCommonCoefficientMarking α b)
    (hpresent : HilbertSamuel.Presents (D.coefficientMarked b hb.1))
    (c : MarkedIdeal.SuspensionChart D.j [] n) :
    HilbertSamuel.Presents (D.suspendedCoefficientMarked b hb.1 c) ∧
    HilbertSamuel.Equivalent (D.coefficientMarked b hb.1)
      (D.suspendedCoefficientMarked b hb.1 c) ∧
    (¬ IsRegularLocalRing (X.presheaf.stalk a) →
      HilbertSamuel.FullMaximalOrder (D.suspendedCoefficientMarked b hb.1 c)) := by
  sorry

/-- On a regular codimension-zero germ the zero marked ideal presents the level locally,
while retaining infinite order. Source: BM 1997, Definition 6.4; DAG step 4
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: shrink the smooth identity embedding to a chart of constant relative dimension.
Use the empty vertex list and zero transverse variables; its Taylor ideal is zero, division
has the identity remainder, and all empty Jacobian determinants are one. The jet identity
of lem-trf-jet-diagram-hilbert-control makes the intrinsic level constant on this chart.
lem-trf-coefficient-test-sequence-propagation for the empty datum gives presentation after
all finite tests, including summation for each line product. The definition of order gives
infinity for the zero ideal, and no finite maximal-order assertion follows. -/
theorem regular_codimension_zero_coefficient_presentation
    (M : Scheme.{u}) (p : M ⟶ Spec (.of (ULift.{u} ℚ))) [Smooth p] (a : M) :
    ∃ (S : HilbertSamuel.Embedded (ULift.{u} ℚ)) (f : S.Z ⟶ M) (x : S.X)
      (P : HilbertSamuel.Marked S),
      IsOpenImmersion f ∧ IsIso S.i ∧ f (S.i x) = a ∧
      S.p = f ≫ p ∧ S.level = HilbertSamuel.function p a ∧
      IsIso P.j ∧ P.ideal = ⊥ ∧ P.marking = 1 ∧ HilbertSamuel.Presents P ∧
      ∀ y : P.N, HilbertSamuel.order P.ideal y = ⊤ := by
  sorry

/-- Finite-test comparison on a common étale germ, also on every further open restriction.
The pullbacks are the actual Cartesian marked pullbacks with their actual ideal equalities.
Source: BM 1997, Remarks 6.3 and Definition 6.4; DAG steps 5--7
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def HasComparedCoefficientTests
    {k : Type u} [Field k] {S T : HilbertSamuel.Embedded k} {X Y : Scheme.{u}}
    {e : X ≅ Y} {a : X} {zS : S.Z} {zT : T.Z}
    {rS : S.X ⟶ X} {rT : T.X ⟶ Y}
    {earlierS : List S.Z.IdealSheafData} {earlierT : List T.Z.IdealSheafData}
    (C : HilbertSamuel.CommonEtaleGermComparison S T e a zS zT rS rT earlierS earlierT)
    (P : HilbertSamuel.Marked S) (Q : HilbertSamuel.Marked T) : Prop :=
  ∃ (P' Q' : HilbertSamuel.Marked C.W),
    HilbertSamuel.MarkedPullback C.f P P' ∧ HilbertSamuel.MarkedPullback C.g Q Q' ∧
    HilbertSamuel.Presents P' ∧ HilbertSamuel.Presents Q' ∧
    HilbertSamuel.Equivalent P' Q' ∧
    ∀ (R : HilbertSamuel.Embedded k) (v : R.Z ⟶ C.W.Z),
      IsOpenImmersion v → HilbertSamuel.Pullback v 0 →
      ∀ (P'' Q'' : HilbertSamuel.Marked R),
        HilbertSamuel.MarkedPullback v P' P'' → HilbertSamuel.MarkedPullback v Q' Q'' →
        HilbertSamuel.Presents P'' ∧ HilbertSamuel.Presents Q'' ∧
        HilbertSamuel.Equivalent P'' Q''

/-- The full two-construction comparison assertion, including arbitrary finite ordered
intrinsic earlier-center ideals. The ambient ideals are their actual closed-image ideals,
pulled back to the coefficient charts. All coefficient supports, ideals and markings are
fixed by the regular data; only the optional suspension representative is variable.
Source: BM 1997, Remarks 6.3 and Definition 6.4; BMT 6.2--6.3; DAG steps 5--7
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def HasMinimalEnvelopeCoefficientComparison
    {X Y : Scheme.{u}} (pX : X ⟶ Spec (.of (ULift.{u} ℚ)))
    (pY : Y ⟶ Spec (.of (ULift.{u} ℚ))) (e : X ≅ Y) (a : X) : Prop :=
  ∀ (M₁ M₂ : Scheme.{u}) (p₁ : M₁ ⟶ Spec (.of (ULift.{u} ℚ)))
    (p₂ : M₂ ⟶ Spec (.of (ULift.{u} ℚ))) (_h₁ : Smooth p₁) (_h₂ : Smooth p₂)
    (i₁ : X ⟶ M₁) (i₂ : Y ⟶ M₂) (_hc₁ : IsClosedImmersion i₁)
    (_hc₂ : IsClosedImmersion i₂),
    i₁ ≫ p₁ = pX → i₂ ≫ p₂ = pY →
    p₁.IsMinimalSmoothEnvelope i₁ a → p₂.IsMinimalSmoothEnvelope i₂ (e.hom a) →
    ∀ (m₁ n₁ s₁ Q₁ m₂ n₂ s₂ Q₂ : ℕ)
      (α₁ : Fin s₁ → Fin n₁ →₀ ℕ) (α₂ : Fin s₂ → Fin n₂ →₀ ℕ),
      orderedVertices α₁ → orderedVertices α₂ →
      ∀ (D₁ : RegularHilbertCoefficientDatum p₁ i₁ a m₁ n₁ s₁ α₁ Q₁)
        (D₂ : RegularHilbertCoefficientDatum p₂ i₂ (e.hom a) m₂ n₂ s₂ α₂ Q₂)
        (b₁ b₂ : ℕ) (hb₁ : IsCommonCoefficientMarking α₁ b₁)
        (hb₂ : IsCommonCoefficientMarking α₂ b₂),
        HilbertSamuel.Presents (D₁.coefficientMarked b₁ hb₁.1) →
        HilbertSamuel.Presents (D₂.coefficientMarked b₂ hb₂.1) →
        ∀ (P : HilbertSamuel.Marked D₁.coefficientAmbient)
          (Q : HilbertSamuel.Marked D₂.coefficientAmbient),
          D₁.IsCoefficientRepresentative b₁ hb₁.1 P →
          D₂.IsCoefficientRepresentative b₂ hb₂.1 Q →
          ∀ earlier : List X.IdealSheafData,
            ∃ C : HilbertSamuel.CommonEtaleGermComparison
              D₁.coefficientAmbient D₂.coefficientAmbient e a D₁.center D₂.center
              (pullback.fst i₁ D₁.e) (pullback.fst i₂ D₂.e)
              (earlier.map (fun J ↦ (J.map i₁).comap D₁.e))
              (earlier.map (fun J ↦ ((J.comap e.inv).map i₂).comap D₂.e)),
              HasComparedCoefficientTests C P Q

/-- Coefficient constructions in minimal envelopes of the same intrinsic pointed germ,
including suspensions, have the same finite tests on a common pointed étale comparison.
The comparison preserves the specified ordered earlier-center ideals and open restrictions.
Source: BM 1997, Remarks 6.3 and Definition 6.4; BMT 6.2--6.3; DAG steps 5--7
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: step 5 applies lem-trf-smooth-embedding-etale-comparison to the two minimal
embeddings and their coefficient neighborhoods, preserving the closed intrinsic scheme
and the actual closed-image earlier ideals. Both pulled-back coefficient constructions
remain presentations; the relative dimension is zero in
lem-trf-coefficient-test-sequence-propagation. Use
lem-trf-marked-ideal-transverse-suspension to allow the displayed suspensions.
Step 6 inducts on finite test depth. At depth zero both cosupports are the same intrinsic
retained-level locus. At a common prefix the same smooth centers satisfy the same
normal-crossings conditions. The ambient blowup and schematic strict transform depend only
on that center; each presentation provides its controlled transform with that same locus.
Line products sum the same level and append the same zero section. Boundary-intersection
blowups use the same two labels and ordinary pullback. Thus all transforms exist and the
induction applies to every pair of them. This proves equivalence for every finite depth.
Step 7 restricts the common neighborhood and its ideal equalities; the same induction gives
the asserted open compatibility. Earlier history ideals never enter the fresh test boundary. -/
theorem minimal_envelope_coefficient_comparison
    {X Y : Scheme.{u}} [IsReduced X] [IsReduced Y]
    (pX : X ⟶ Spec (.of (ULift.{u} ℚ))) (pY : Y ⟶ Spec (.of (ULift.{u} ℚ)))
    [LocallyOfFiniteType pX] [QuasiCompact pX]
    [LocallyOfFiniteType pY] [QuasiCompact pY]
    (e : X ≅ Y) (he : e.hom ≫ pY = pX) (a : X) :
    HasMinimalEnvelopeCoefficientComparison pX pY e a := by
  sorry

end AlgebraicGeometry.HilbertCoefficient

namespace AlgebraicGeometry.EmbeddedResolutionHistory

/-- The ordered boundary induced intrinsically by the chronological center ideals and
schematic strict transforms. Identity intrinsic blowups still append their birth ideal.
Source: BMT 6.2--6.3; DAG step 7
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def coefficientHistoryBoundary {A : EmbeddedResolutionPair.{u}} {n : ℕ}
    (H : EmbeddedResolutionHistory A n) :
    ∀ j : Fin (n + 1), List (H.intrinsic.obj (op j)).IdealSheafData :=
  Fin.induction [] (fun j E ↦
    E.map (fun D ↦ (AlgebraicGeometry.strictTransformMap D.subschemeι
      (H.intrinsic.map (homOfLE j.castSucc_le_succ).op)
      (H.centerToIntrinsic j).ker.support.compl).ker) ++
    [(H.centerToIntrinsic j).ker.comap (H.intrinsic.map (homOfLE j.castSucc_le_succ).op)])

/-- The structural rational map of the current intrinsic transform, using the actual
history diagram. Source: BMT 6.2--6.3; DAG step 7
(blueprint: lem-trf-minimal-envelope-coefficient-comparison). -/
def coefficientIntrinsicBase {A : EmbeddedResolutionPair.{u}} {n : ℕ}
    (H : EmbeddedResolutionHistory A n) : H.X ⟶ Spec (.of (ULift.{u} ℚ)) :=
  H.inclusion.app (op (Fin.last n)) ≫ H.base

/-- After identified admissible histories, the ordered induced intrinsic boundary ideals
and all subsequent coefficient presentation classes are identified. Every identity stage
is retained. Fresh presentation tests continue to start with empty boundary.
Source: BM 1997, Remarks 6.3 and Definition 6.4; BMT 6.2--6.3; DAG step 7
(blueprint: lem-trf-minimal-envelope-coefficient-comparison).

Proof: the natural isomorphism and center-ideal equalities in IntrinsicComparison give
the same chronological centers. Induct on stages. A strict boundary transform is the
scheme-theoretic closure off that center (def-nagata-strict-transform); it is preserved by
the identified diagram. The new exceptional ideal is the actual extension of that stage's
center ideal, equal to (e) on a distinguished blowup chart by
lemma-nagata-chart-extended-ideal-principal. Thus the ordered strict transforms and the
appended birth ideal agree, even when the intrinsic blowup is an identity. The coordinate
formulas of lem-trf-permissible-coordinate-chart are used only on adapted regular charts,
not to define these general strict transforms. Apply steps 5--6 of the node at the compared
current pointed germ and retained level, now with these specified earlier ideals. The
comparison preserves them by actual pullback. All new presentation tests use empty boundary;
HasMinimalEnvelopeCoefficientComparison includes the common étale comparison, all finite
tests and open restriction compatibility, without adding history ideals to that boundary. -/
theorem coefficient_comparison_after_admissible_histories
    {V : Type w} [LinearOrder V] [OrderBot V] (ν : ValueFamily.{u} V)
    {A B : EmbeddedResolutionPair.{u}} {n : ℕ}
    (H : EmbeddedResolutionHistory A n) (K : EmbeddedResolutionHistory B n)
    (hH : Admissible ν H) (hK : Admissible ν K)
    (e : A.X ≅ B.X) (c : IntrinsicComparison e H K)
    (hbase : (c.iso.app (op (Fin.last n))).hom ≫ K.coefficientIntrinsicBase =
      H.coefficientIntrinsicBase)
    (a : H.X) (hlevel : HilbertSamuel.function H.coefficientIntrinsicBase a =
      HilbertSamuel.function K.coefficientIntrinsicBase ((c.iso.app (op (Fin.last n))).hom a)) :
    (∀ j : Fin (n + 1), H.coefficientHistoryBoundary j =
      (K.coefficientHistoryBoundary j).map (fun J ↦ J.comap (c.iso.app (op j)).hom)) ∧
    HilbertCoefficient.HasMinimalEnvelopeCoefficientComparison
      H.coefficientIntrinsicBase K.coefficientIntrinsicBase (c.iso.app (op (Fin.last n))) a := by
  sorry

end AlgebraicGeometry.EmbeddedResolutionHistory
