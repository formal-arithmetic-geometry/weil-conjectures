module

public import Mathlib.LinearAlgebra.Trace
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.SetTheory.Cardinal.Finite
import Mathlib.LinearAlgebra.Dimension.RankNullity
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import WeilConjectures.RingTheory.TateResidue.FinitePotent

/-! # Euler dimension and equivariant trace for finite multigraphs

Source: Deligne–Mumford, The irreducibility of the space of curves of given genus,
graph argument after Lemma 1.17, printed p. 87, final paragraph
(blueprint: lem-sfb-finite-graph-euler-trace).

The source and target maps specify a chosen orientation, and edge indices retain
parallel edges. The helpers spell out the boundary, signed action, and its canonical
restriction to cycles that occur in the statement. Components are the quotient by
the equivalence relation generated by the endpoint pairs, implemented by `Quot`.
-/

@[expose] public section

set_option autoImplicit false

universe u v

namespace FiniteGraph

/-- Boundary on rational edge chains, sending an edge to target minus source.
Source: Deligne–Mumford, graph argument after Lemma 1.17, printed p. 87
(blueprint: lem-sfb-finite-graph-euler-trace). -/
noncomputable def boundary {V : Type u} {E : Type v} (s t : E → V) :
    (E →₀ ℚ) →ₗ[ℚ] (V →₀ ℚ) :=
  Finsupp.linearCombination ℚ fun e ↦ Finsupp.single (t e) 1 - Finsupp.single (s e) 1

open Classical in
/-- The signed permutation of rational edge chains: a reversed orientation contributes -1.
Source: Deligne–Mumford, graph argument after Lemma 1.17, printed p. 87
(blueprint: lem-sfb-finite-graph-euler-trace). -/
noncomputable def signedEdgeMap {V : Type u} {E : Type v} (s t : E → V)
    (σV : Equiv.Perm V) (σE : Equiv.Perm E) : Module.End ℚ (E →₀ ℚ) :=
  Finsupp.linearCombination ℚ fun e ↦
    if σV (s e) = s (σE e) ∧ σV (t e) = t (σE e)
      then Finsupp.single (σE e) 1 else -Finsupp.single (σE e) 1

/-- An endpoint-preserving permutation carries rational cycles to rational cycles.
Source: Deligne–Mumford, graph argument after Lemma 1.17, printed p. 87
(blueprint: lem-sfb-finite-graph-euler-trace), proof step 3.

Proof: On each basis edge, applying the boundary after the signed action gives
`σV (t e) - σV (s e)`, in either orientation case. This is the vertex permutation
applied to the boundary. Extend by linearity. A cycle has zero boundary, whose
vertex permutation is zero, so its signed image again lies in the kernel. -/
theorem signedEdgeMap_mem_ker {V : Type u} {E : Type v} (s t : E → V)
    (σV : Equiv.Perm V) (σE : Equiv.Perm E)
    (hσ : ∀ e : E,
      (σV (s e) = s (σE e) ∧ σV (t e) = t (σE e)) ∨
      (σV (s e) = t (σE e) ∧ σV (t e) = s (σE e))) :
    ∀ x ∈ LinearMap.ker (boundary s t),
      signedEdgeMap s t σV σE x ∈ LinearMap.ker (boundary s t) := by
  sorry

/-- The canonical restriction of the signed edge permutation to the rational cycle space.
Source: Deligne–Mumford, graph argument after Lemma 1.17, printed p. 87
(blueprint: lem-sfb-finite-graph-euler-trace). -/
noncomputable def cycleMap {V : Type u} {E : Type v} (s t : E → V)
    (σV : Equiv.Perm V) (σE : Equiv.Perm E)
    (hσ : ∀ e : E,
      (σV (s e) = s (σE e) ∧ σV (t e) = t (σE e)) ∨
      (σV (s e) = t (σE e) ∧ σV (t e) = s (σE e))) :
    Module.End ℚ (LinearMap.ker (boundary s t)) :=
  (signedEdgeMap s t σV σE).restrict (signedEdgeMap_mem_ker s t σV σE hσ)

/-- Euler dimension and equivariant trace identities, including disconnected and empty graphs.
Source: Deligne–Mumford, graph argument after Lemma 1.17, printed p. 87, final paragraph
(blueprint: lem-sfb-finite-graph-euler-trace).

Proof: (1) Map vertex chains to the free rational space on components by sending a
vertex to its component. This is onto, and kills every edge boundary. Choose a root
in each component. A path from the root to a vertex gives a signed edge chain with
boundary vertex minus root. A vertex chain with component sums zero is a linear
combination of these differences. Thus the image B of the boundary is the kernel
of the component map, including for the empty graph.
(2) The finite bases and [def-weil-finite-dimensional-subspace] make the chain and
component spaces finite-dimensional. [lem-trf-vector-space-quotient-dimension] gives
finite-dimensionality of their subspaces. The kernel and image definitions, and (1),
give the exact sequences 0 → Z₁ → C₁ → B → 0 and 0 → B → C₀ → H → 0.
(3) The signed edge action commutes with boundary and the vertex permutation;
`signedEdgeMap_mem_ker` records the kernel stability. Endpoint preservation and its
inverse preserve edge paths, hence permute components. The component map intertwines
the vertex and component permutations. All restriction squares commute.
(4) Apply [lem-pc-finite-dimensional-trace-exact] to both sequences and their
compatible endomorphisms. Subtraction cancels the trace on B, giving
tr T₀ - tr T₁ = tr T_H - tr T_Z.
(5) By [def-weil-endomorphism-trace], diagonal entries count fixed vertices and
components. For edges, only fixed indices contribute: +1 for individually fixed
endpoints, -1 for exchanged endpoints. Distinctness exhausts these two cases.
This gives the second equality with all counts cast to ℚ.
(6) Apply that identity to the identity permutation. The identity trace is the
basis cardinality [def-weil-vector-space-dimension]. Rearrange, then use injectivity
of ℤ → ℚ to obtain the first equality in ℤ. If V is empty, looplessness forces E
empty; all spaces and counts vanish. -/
theorem euler_trace (V : Type u) (E : Type v) [Finite V] [Finite E]
    (s t : E → V) (_hne : ∀ e : E, s e ≠ t e)
    (σV : Equiv.Perm V) (σE : Equiv.Perm E)
    (hσ : ∀ e : E,
      (σV (s e) = s (σE e) ∧ σV (t e) = t (σE e)) ∨
      (σV (s e) = t (σE e) ∧ σV (t e) = s (σE e))) :
    (Module.finrank ℚ (LinearMap.ker (boundary s t)) : ℤ) =
      (Nat.card E : ℤ) - (Nat.card V : ℤ) +
        (Nat.card (Quot (fun x y : V ↦ ∃ e : E, s e = x ∧ t e = y)) : ℤ) ∧
    (Nat.card {x : V // σV x = x} : ℚ) -
        (Nat.card {e : E // σE e = e ∧ σV (s e) = s e ∧ σV (t e) = t e} : ℚ) +
        (Nat.card {e : E // σE e = e ∧ σV (s e) = t e ∧ σV (t e) = s e} : ℚ) =
      (Nat.card {C : Quot (fun x y : V ↦ ∃ e : E, s e = x ∧ t e = y) //
        ∀ x : V, Quot.mk _ x = C → Quot.mk _ (σV x) = C} : ℚ) -
          LinearMap.trace ℚ (LinearMap.ker (boundary s t)) (cycleMap s t σV σE hσ) := by
  sorry

end FiniteGraph
