module

public import Mathlib.Algebra.Category.Grp.Abelian
public import Mathlib.Algebra.Homology.DerivedCategory.Basic
public import Mathlib.Algebra.Homology.Embedding.Extend
public import Mathlib.AlgebraicTopology.AlternatingFaceMapComplex
public import Mathlib.AlgebraicTopology.SimplicialSet.Homotopy
public import Mathlib.Logic.Relation

/-!
# Underlying simplicial-set homotopy equivalences of simplicial abelian groups

Source: Stacks Project, Tag 08P2, `simplicial.tex`, Lemma `lemma-homotopy-equivalence`
(blueprint: lem-trf-simplicial-abelian-set-homotopy-quasi-iso).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicTopology

/-- A homotopy equivalence on underlying simplicial sets induces a quasi-isomorphism of the
alternating face complexes, reindexed as cochain complexes supported in nonpositive degrees.
Homotopy means the equivalence relation generated by cylinder homotopies of simplicial sets;
the inverse and the homotopies need not preserve addition.

Source: Stacks Project, Tag 08P2, Lemma `lemma-homotopy-equivalence`
(blueprint: lem-trf-simplicial-abelian-set-homotopy-quasi-iso).

Proof: Apply the degreewise free abelian group functor to the underlying set map of `f`.
A cylinder homotopy gives a combinatorial simplicial homotopy, which remains a homotopy after
applying the free functor. Its alternating face map is a chain homotopy. Finite zigzags of
these homotopies therefore give equal homology maps. The supplied inverse thus makes the map
between the free complexes an isomorphism on homology. The evaluation maps from the free
simplicial abelian groups to `X` and `Y` commute with `f`.

Compute homology with the normalized complex, which is homotopy equivalent to the alternating
face complex. A normalized cycle `y` in `Y` has every face zero, so `[y] - [0]` is a normalized
cycle of the free simplicial abelian group and evaluates to `y`. Lift its homology class across
the free homology isomorphism and then evaluate to obtain surjectivity on homology of `f`.
For injectivity, represent a class in the kernel by a normalized cycle `x`. If its image is
the boundary of a normalized simplex `y`, then `[y] - [0]` has boundary `[f(x)] - [0]`.
Consequently the class of `[x] - [0]` maps to zero in free homology, hence is already zero;
evaluation shows that the original class of `x` is zero. This includes degree zero.
Finally extend along `n ↦ -n`; this preserves the differentials and inserts zero objects in
positive degrees, so it gives the claimed isomorphisms on every integer cohomology group. -/
theorem quasiIso_alternatingFaceMap_of_underlying_homotopy_equivalence
    {X Y : SimplicialObject AddCommGrpCat.{u}} (f : X ⟶ Y)
    (h : ∃ g : Y ⋙ forget AddCommGrpCat.{u} ⟶ X ⋙ forget AddCommGrpCat.{u},
      Relation.EqvGen (fun a b ↦ Nonempty (SSet.Homotopy a b))
        (Functor.whiskerRight f (forget AddCommGrpCat.{u}) ≫ g)
        (𝟙 (X ⋙ forget AddCommGrpCat.{u})) ∧
      Relation.EqvGen (fun a b ↦ Nonempty (SSet.Homotopy a b))
        (g ≫ Functor.whiskerRight f (forget AddCommGrpCat.{u}))
        (𝟙 (Y ⋙ forget AddCommGrpCat.{u}))) :
    QuasiIso (HomologicalComplex.extendMap
      ((alternatingFaceMapComplex AddCommGrpCat.{u}).map f) ComplexShape.embeddingDownNat) := by
  sorry

end AlgebraicTopology
