module

public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplex

/-!
# Gluing compatible families on faces of a standard simplex

Source: Stacks, Tag 017J: maps from a union of simplicial subsets are exactly maps
from the subsets agreeing on their intersections.
(blueprint: lem-weil-pbc-simplex-face-family-gluing)
-/

@[expose] public section

universe u v w

open CategoryTheory Opposite Simplicial

namespace CategoryTheory.SimplicialObject

/-- The union of the subcomplexes generated by the given simplices. -/
def faceUnion {ι : Type*} {N : ℕ} (d : ι → ℕ) (e : ∀ i, ⦋d i⦌ ⟶ ⦋N⦌) :
    (Δ[N] : SSet.{w}).Subcomplex :=
  ⨆ i, SSet.Subcomplex.ofSimplex (SSet.stdSimplex.objEquiv.symm (e i))

lemma mem_faceUnion_iff {ι : Type*} {N m : ℕ} (d : ι → ℕ)
    (e : ∀ i, ⦋d i⦌ ⟶ ⦋N⦌) (s : (Δ[N] : SSet.{w}).obj (op ⦋m⦌)) :
    s ∈ (faceUnion d e).obj (op ⦋m⦌) ↔
      ∃ i, ∃ q : ⦋m⦌ ⟶ ⦋d i⦌, q ≫ e i = SSet.stdSimplex.objEquiv s := by
  simp only [faceUnion, Subfunctor.iSup_obj, Set.mem_iUnion,
    SSet.Subcomplex.mem_ofSimplex_obj_iff]
  constructor
  · rintro ⟨i, q, hq⟩
    exact ⟨i, q, congrArg SSet.stdSimplex.objEquiv hq⟩
  · rintro ⟨i, q, hq⟩
    exact ⟨i, q, SSet.stdSimplex.objEquiv.injective hq⟩

lemma faceUnion_generator_mem {ι : Type*} {N : ℕ} (d : ι → ℕ)
    (e : ∀ i, ⦋d i⦌ ⟶ ⦋N⦌) (i : ι) :
    SSet.stdSimplex.objEquiv.symm (e i) ∈ (faceUnion d e).obj (op ⦋d i⦌) := by
  rw [mem_faceUnion_iff]
  exact ⟨i, 𝟙 _, Category.id_comp _⟩

/-- Pairwise compatible simplex data glue on the generated subcomplex.
Source: Stacks, Tag 017J. Choose a generator factorization for each simplex of the
union. The pairwise compatibility hypothesis makes its assigned value independent of
that choice. Precomposing a chosen factorization proves naturality, and taking the
identity factorization proves the asserted values on all generators.
(blueprint: lem-weil-pbc-simplex-face-family-gluing) -/
theorem glue_face_family {C : Type u} [Category.{v} C]
    (V : SimplicialObject C) (T : C) {ι : Type*} {N : ℕ} (d : ι → ℕ)
    (e : ∀ i, ⦋d i⦌ ⟶ ⦋N⦌) (t : ∀ i, T ⟶ V.obj (op ⦋d i⦌))
    (ht : ∀ (i j : ι) (m : ℕ) (q : ⦋m⦌ ⟶ ⦋d i⦌) (r : ⦋m⦌ ⟶ ⦋d j⦌),
      q ≫ e i = r ≫ e j → t i ≫ V.map q.op = t j ≫ V.map r.op) :
    ∃ f : ∀ m : ℕ, (faceUnion.{w} d e).toSSet.obj (op ⦋m⦌) →
        (T ⟶ V.obj (op ⦋m⦌)),
      (∀ (m k : ℕ) (φ : ⦋m⦌ ⟶ ⦋k⦌)
        (s : (faceUnion.{w} d e).toSSet.obj (op ⦋k⦌)),
        f k s ≫ V.map φ.op = f m ((faceUnion d e).toSSet.map φ.op s)) ∧
      ∀ i, f (d i) ⟨SSet.stdSimplex.objEquiv.symm (e i),
        faceUnion_generator_mem d e i⟩ = t i := by
  classical
  have hex (m : ℕ) (s : (faceUnion.{w} d e).toSSet.obj (op ⦋m⦌)) :
      ∃ i, ∃ q : ⦋m⦌ ⟶ ⦋d i⦌, q ≫ e i = SSet.stdSimplex.objEquiv s.val :=
    (mem_faceUnion_iff d e s.val).mp s.property
  choose i q hq using hex
  let f (m : ℕ) (s : (faceUnion.{w} d e).toSSet.obj (op ⦋m⦌)) :=
    t (i m s) ≫ V.map (q m s).op
  have hf (m : ℕ) (s : (faceUnion.{w} d e).toSSet.obj (op ⦋m⦌))
      (j : ι) (r : ⦋m⦌ ⟶ ⦋d j⦌) (hr : r ≫ e j = SSet.stdSimplex.objEquiv s.val) :
      f m s = t j ≫ V.map r.op := ht _ _ _ _ _ ((hq m s).trans hr.symm)
  refine ⟨f, ?_, ?_⟩
  · intro m k φ s
    rw [show f k s = t (i k s) ≫ V.map (q k s).op from rfl,
      Category.assoc, ← V.map_comp, ← op_comp]
    symm
    apply hf _ _ (i k s) (φ ≫ q k s)
    rw [Category.assoc, hq]
    rfl
  · intro j
    rw [hf _ _ j (𝟙 _) (by simp), op_id, V.map_id, Category.comp_id]

end CategoryTheory.SimplicialObject
