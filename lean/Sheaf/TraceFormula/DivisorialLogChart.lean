/-!
# Divisorial charts for smooth strict normal crossings divisors

Source: Illusie--Laszlo--Orgogozo, Exposé VI, §§1.4--1.5(i), pp. 69--70;
Stacks Project, Tag 0BIA (blueprint: lem-trf-snc-divisorial-log-chart).
-/

@[expose] public section
set_option autoImplicit false
universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

/-- A smooth finite-type strict normal crossings divisor has the standard divisorial
logarithmic charts. Source: ILO VI, §§1.4--1.5(i), pp. 69--70; Stacks 0BIA
(blueprint: lem-trf-snc-divisorial-log-chart).

Proof: finite type over the algebraically closed field gives Noetherian regular local
rings. The smooth transverse component intersections give simultaneous local parameters;
their strict-local images remain a parameter prefix. The divisorial stalk is the monoid of
functions becoming units after inverting the boundary equations, hence is generated by the
parameter monomials and units. This gives the free saturated chart, the characteristic
monoid, the regular quotient and the dimension formula, and therefore the divisorial
fine-saturated log-regular pair. The empty divisor is the case `r = 0`.
-/
theorem sncDivisorialLogChart
    (F : Type u) [Field F] [IsAlgClosed F]
    (V : Scheme.{u}) (f : V ⟶ Spec (.of F)) [Smooth f]
    [LocallyOfFiniteType f] [QuasiCompact f]
    (Z : V.IdealSheafData)
    (hZ : Z.IsSmoothStrictNormalCrossingsDivisor f) :
    ∃ (hN : IsLocallyNoetherian V)
      (hU : DenseRange
        (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι),
      @IsDivisorialFineSaturatedLogRegularPair V
        (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).toScheme
        (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι
        inferInstance hN hU ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (t : Spec (.of Ω) ⟶ V),
        ∃ (r : ℕ) (W : V.Etale)
          (w : (Scheme.pointSmallEtale t).fiber.obj W)
          (β : ULift.{u} (Multiplicative (Fin r → ℕ)) →*
            divisorialSections
              (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι W),
          IsFineSaturatedMonoid (ULift.{u} (Multiplicative (Fin r → ℕ))) ∧
          ∃ (h : IsUnit.submonoid (strictLocalRing V t) ≤
            divisorialStalk
              (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι t),
          @IsDivisorialStalkChart _
              (ULift.{u} (Multiplicative (Fin r → ℕ))) _ _
              (divisorialStalk
                (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι t) h
              ((divisorialGerm
                (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι t W w).comp β) ∧
          ∃ (χ : Associates
              (divisorialStalk
                (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι t) ≃*
              Multiplicative (Fin r → ℕ)),
            (∀ x : ULift.{u} (Multiplicative (Fin r → ℕ)),
              χ (Associates.mk
                (((divisorialGerm
                  (Scheme.openComplementOfIsClosedImmersion Z.subschemeι).ι t W w).comp β) x)) =
                x.down) ∧
          ∃ (hA : IsRegularLocalRing (strictLocalRing V t)),
            (∃ s : List (strictLocalRing V t),
              @IsLocalRing.IsRegularSystemOfParameters
                (strictLocalRing V t) _ hA.toIsLocalRing hA.toIsNoetherian
                ((List.ofFn (fun i : Fin r ↦
                  (strictLocalGerm V t W w).hom
                    ((β (ULift.up
                      (Multiplicative.ofAdd
                        ((fun q : Fin r ↦ if q = i then 1 else 0) : Fin r → ℕ)))).1))) ++
                  s)) ∧
            IsRegularRing
              (strictLocalRing V t ⧸
                Ideal.span {x | ∃ i : Fin r,
                  x = (strictLocalGerm V t W w).hom
                    ((β (ULift.up
                      (Multiplicative.ofAdd
                        ((fun q : Fin r => if q = i then 1 else 0) : Fin r → ℕ)))).1)}) ∧
            ringKrullDim (strictLocalRing V t) =
              ringKrullDim
                (strictLocalRing V t ⧸
                  Ideal.span {x | ∃ i : Fin r,
                    x = (strictLocalGerm V t W w).hom
                      ((β (ULift.up
                        (Multiplicative.ofAdd
                          ((fun q : Fin r => if q = i then 1 else 0) : Fin r → ℕ)))).1)}) +
                (r : WithBot ℕ∞) := by
  sorry

end AlgebraicGeometry
