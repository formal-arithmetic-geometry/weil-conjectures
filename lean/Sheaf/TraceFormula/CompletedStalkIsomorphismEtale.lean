/-!
# Étaleness from an isomorphism on completed stalks

Source: Stacks Project, Tag 0CAV, `lemma-isomorphism-approximation` (blueprint:
lem-trf-completed-stalk-isomorphism-etale).
-/

@[expose] public section
set_option autoImplicit false

universe u

open CategoryTheory AlgebraicGeometry

namespace AlgebraicGeometry

/-- The map on maximal-ideal completions induced by a local stalk map.

This is the canonical inverse-limit map: at level `n` it is the quotient map induced by
the actual local stalk homomorphism, and `AdicCompletion.liftRingHom` assembles these
compatible coordinates. Thus its value is not chosen from an existential completion-map
theorem. (blueprint: lem-trf-completed-stalk-isomorphism-etale) -/
noncomputable def completedStalkMap {Z T : Scheme.{u}} (f : Z ⟶ T) (z : Z) :
    AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk (f z)))
        (T.presheaf.stalk (f z)) →+*
      AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
        (Z.presheaf.stalk z) :=
  let A := T.presheaf.stalk (f z)
  let B := Z.presheaf.stalk z
  let mA : Ideal A := IsLocalRing.maximalIdeal A
  let mB : Ideal B := IsLocalRing.maximalIdeal B
  let φ : A →+* B := (f.stalkMap z).hom
  have hmap : mA.map φ ≤ mB := by
    exact Ideal.map_le_iff_le_comap.mpr (fun x hx => map_nonunit φ x hx)
  have hpow (n : ℕ) : (mA ^ n).map φ ≤ mB ^ n := by
    rw [Ideal.map_pow]
    exact pow_le_pow_left' hmap n
  let qmap (n : ℕ) : A ⧸ mA ^ n →+* B ⧸ mB ^ n :=
    Ideal.Quotient.lift (mA ^ n) ((Ideal.Quotient.mk (mB ^ n)).comp φ) (by
      intro x hx
      change Ideal.Quotient.mk (mB ^ n) (φ x) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact hpow n (Ideal.mem_map_of_mem φ hx))
  let level (n : ℕ) :
      AdicCompletion mA A →+* B ⧸ mB ^ n :=
    (qmap n).comp (AdicCompletion.evalₐ mA n).toRingHom
  have hlevel {m n : ℕ} (hmn : m ≤ n) :
      (Ideal.Quotient.factorPow mB hmn).comp (level n) = level m := by
    ext x
    induction x using AdicCompletion.induction_on with
    | _ x =>
      simpa [level, qmap] using congrArg (qmap m) (AdicCompletion.Ideal.mk_eq_mk mA hmn x)
  AdicCompletion.liftRingHom mB level hlevel

/-- A locally finite type morphism with an isomorphism on completed stalks is étale near
that point, and induces an isomorphism on residue fields.

Source: Stacks Project, Tag 0CAV, `lemma-isomorphism-approximation`, proof first paragraph:
the completed-stalk criterion gives smoothness and unramifiedness, hence étaleness by
Tags 02HX, 02GF, and 02GK. The stated hypotheses are the assumptions of Tag 0CAV.
(blueprint: lem-trf-completed-stalk-isomorphism-etale)

Proof:
1. Set the source and target local rings and use finite type plus local Noetherianity to
   obtain Noetherian stalks, with their maximal-ideal completions and the induced map.
2. The isomorphism on completions identifies the residue fields and first-order quotients.
3. The first-order identification and Nakayama give equality of the target maximal ideal with
the ideal generated by the source maximal ideal, yielding unramifiedness.
4. For every small Artinian extension, factor the compatible local maps through finite
quotients of the completions and use the inverse completed map to construct a lift; the
Artinian lifting criterion gives smoothness on a neighbourhood.
5. Shrink to an unramified neighbourhood and combine smoothness with flatness and local finite
presentation to obtain an étale neighbourhood. The residue-field map is the isomorphism from
step 2.
-/
theorem completedStalk_isomorphism_etale
    {Z T : Scheme.{u}} (f : Z ⟶ T) [LocallyOfFiniteType f]
    [IsLocallyNoetherian T] (z : Z)
    (h : IsIso (CommRingCat.ofHom (completedStalkMap f z))) :
    ∃ W : Z.Opens, z ∈ W ∧ Etale (W.ι ≫ f) ∧
      IsIso (f.residueFieldMap z) := by
  sorry

end AlgebraicGeometry
