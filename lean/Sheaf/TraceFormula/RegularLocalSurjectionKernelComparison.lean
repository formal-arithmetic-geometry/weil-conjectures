module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
import Sheaf.AlgebraicGeometry.IsRegularScheme
import WeilConjectures.RingTheory.Depth
import WeilConjectures.RingTheory.DepthLeSupportDimension
import Sheaf.RingTheory.IsRegularIffDimensionDrop
import WeilConjectures.RingTheory.RegularLocalGeneratorsRegularSequence
import Sheaf.RingTheory.RegularLocalQuotientKernelParameters
import Sheaf.RingTheory.RegularSequenceConormal

/-!
# Regular-sequence kernels along a surjection of regular local rings

Source: literature/stacks-project/algebra.tex, Tag 00SE, lemma-ci-well-defined
(lines 36038–36053), equivalence of conditions (1) and (3)
(blueprint: lem-trf-regular-local-surjection-kernel-comparison).
-/

@[expose] public section

universe u v w

/-- For surjective local maps `U → V → W` with `U` and `V` regular local,
`ker (U → W)` is generated by a finite regular sequence in the maximal ideal
exactly when `ker (V → W)` is. Empty generating sequences are allowed, and no
completeness assumption is made.

Source: literature/stacks-project/algebra.tex, Tag 00SE, lemma-ci-well-defined,
equivalence of conditions (1) and (3)
(blueprint: lem-trf-regular-local-surjection-kernel-comparison).

Proof: Put `I = ker (v.comp u)` and `J = ker u`; then `J ≤ I` and `I/J` identifies
with `ker v`. The regular-local parameter theorem gives a parameter prefix generating
`J`, and the regular local rings are Cohen–Macaulay, so a list in the maximal ideal
is regular exactly when its quotient has the expected dimension drop. Lift generators
of `ker v` and append the parameters for `J` for one implication. For the converse,
use the conormal basis of a regular-sequence ideal and Nakayama to replace one
parameter generator of `J` into a minimal generating list of `I`; quotient by that
parameter and induct on `dim U - dim V`. Empty lists are included at each step.
-/
theorem regularLocalSurjectionKernelComparison
    (U : Type u) (V : Type v) (W : Type w)
    [CommRing U] [CommRing V] [CommRing W]
    [IsLocalRing W]
    [IsRegularLocalRing U] [IsRegularLocalRing V]
    (u : U →+* V) (v : V →+* W)
    [IsLocalHom u] [IsLocalHom v]
    (hu : Function.Surjective u) (hv : Function.Surjective v) :
    ((∃ xs : List U,
        RingTheory.Sequence.IsRegular U xs ∧
          Ideal.ofList xs = RingHom.ker (v.comp u) ∧
          ∀ x ∈ xs, x ∈ IsLocalRing.maximalIdeal U) ↔
      (∃ ys : List V,
        RingTheory.Sequence.IsRegular V ys ∧
          Ideal.ofList ys = RingHom.ker v ∧
          ∀ y ∈ ys, y ∈ IsLocalRing.maximalIdeal V)) := by
  sorry

end
