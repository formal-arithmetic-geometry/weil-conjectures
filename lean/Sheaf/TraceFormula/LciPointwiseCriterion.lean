module

public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
public import WeilConjectures.RingTheory.CompleteIntersectionOverField
public import Mathlib.RingTheory.RegularLocalRing.Polynomial
import WeilConjectures.RingTheory.GlobalCompleteIntersectionLocalRegularSequence
import WeilConjectures.RingTheory.LCIRegularSequenceGlobalCompleteIntersection
import Sheaf.TraceFormula.EssentiallyFiniteTypeCIKernelInvariance

/-!
# Pointwise local-ring criteria for local complete intersections

Source: literature/stacks-project/morphisms.tex, Tag 01UG, together with Algebra
Tags 00SH, 00SD, 00SF and 00QM (blueprint: lem-trf-lci-pointwise-criterion).

## Main statement

* `lci_pointwise_criterion` records the equivalence between affine local-complete-intersection
  covers, principal global-complete-intersection neighbourhoods, and complete-intersection
  local rings, together with the affine algebra criterion.
-/

@[expose] public section

set_option autoImplicit false
set_option warn.sorry false

universe u v

open CategoryTheory
open AlgebraicGeometry

namespace AlgebraicGeometry

/-- Stacks Project, Morphisms, Tag 01UG, and Algebra, Tags 00SH, 00SD, 00SF and 00QM
(blueprint: lem-trf-lci-pointwise-criterion). The three scheme conditions are stated as
(1) ↔ (3) and (2) ↔ (3); the last conjunct is the algebra criterion for every finitely
generated `k`-algebra `S` (in any universe). A complete-intersection local ring over `k` is
rendered as in Tag 00SD: a `k`-algebra isomorphism from `R ⧸ (rs)` with `R` a regular local
`k`-algebra essentially of finite type and `rs` a regular sequence (its entries lie in the
maximal ideal since the ideal is proper). Stalks carry the `k`-algebra structure induced by
`s`. Empty schemes and zero rings are included by the conventions in
`Algebra.IsGlobalCompleteIntersection`.

Proof.
1. A nonzero global complete intersection `T ≅ k[y₁, ..., yₘ]/(f₁, ..., f_c)` has, at each
   prime, local ring `Q_𝔟/(f₁, ..., f_c)` with `Q_𝔟` regular local
   (`lem-weil-pbc-polynomial-ring-field-regular-ring`) and `f₁, ..., f_c` regular in `Q_𝔟`
   (`lem-weil-pbc-global-complete-intersection-local-regular-sequence`); so it is a
   complete-intersection local ring. The zero ring has no primes.
2. For a local complete intersection `S` and a prime `𝔮`, a covering element `h ∉ 𝔮` with
   `S_h` global complete intersection gives `S_𝔮 ≅ (S_h)_{𝔮_h}`; step 1 applies.
3. Conversely, choose a polynomial presentation `π : P = k[x₁, ..., xₙ] → S` with kernel `I`
   and `𝔭 = π⁻¹(𝔮)`; then `P_𝔭 → S_𝔮` is a surjective local map with kernel `I P_𝔭`.
4. `P_𝔭` is regular local; comparing with the given presentation `R → S_𝔮` by
   `lem-trf-essentially-finite-type-ci-kernel-invariance` shows that `I P_𝔭` is generated by
   a finite regular sequence.
5. `lem-weil-pbc-lci-regular-sequence-global-complete-intersection` gives `g ∉ 𝔮` with `S_g`
   a global complete intersection.
6. Doing this at every prime gives a principal cover `D(g_𝔮)`: `S` is a local complete
   intersection. With step 2 this is the algebra equivalence.
7. (1) ⇒ (3): a chart `Spec S ∋ x` of the cover and step 2, transported along the
   `k`-algebra identification `S_𝔮 ≅ 𝒪_{X,x}` (`lem-weil-pbc-affine-open-stalk-localization`).
8. (3) ⇒ (2): a finite-type affine chart `Spec S ∋ x` (`def-weil-finite-type-morphism`), the
   same stalk identification, steps 3-5, and the affine open `D(g)` with coordinate ring `S_g`
   (`lem-weil-pbc-affine-open-section-vanishing-prime`).
9. (2) ⇒ (1): a global complete intersection is a local complete intersection via the
   single element `1`; the neighbourhoods of (2) form the cover of (1). For `X = ∅` all
   conditions hold vacuously.
-/
theorem lci_pointwise_criterion (k : Type u) [Field k]
    (X : Scheme.{u}) (s : X ⟶ Spec (.of k)) [LocallyOfFiniteType s] :
    (
      (∃ (I : Type u) (C : I → CommRingCat.{u})
          (aC : ∀ i, Algebra k (C i))
          (ftC : ∀ i, Algebra.FiniteType k (C i))
          (φ : ∀ i, Spec (C i) ⟶ X),
        (∀ i, IsOpenImmersion (φ i)) ∧
          (∀ i, φ i ≫ s =
            Spec.map (CommRingCat.ofHom (algebraMap k (C i)))) ∧
          (∀ z : X, ∃ i, ∃ x : Spec (C i), φ i x = z) ∧
          (∀ i, @Algebra.IsLocalCompleteIntersection k (C i) _ _
            (aC i) (ftC i)))
      ↔
      (∀ (x : X),
        ∃ (R : Type u) (_ : CommRing R) (_ : Algebra k R)
          (_ : IsLocalRing R) (_ : IsNoetherianRing R),
          IsRegularLocalRing R ∧
            Algebra.EssFiniteType k R ∧
            ∃ (rs : List R),
              RingTheory.Sequence.IsRegular R rs ∧
              Nonempty
                (@AlgEquiv k
                  (R ⧸ Ideal.span (Set.range (fun i : Fin rs.length => rs.get i)))
                  (X.presheaf.stalk x) _ _ _ _
                  (((Scheme.ΓSpecIso (.of k)).inv ≫
                    s.appLE ⊤ ⊤ le_top ≫
                    X.presheaf.germ ⊤ x trivial).hom.toAlgebra)))
    ) ∧
    (
      (∀ (x : X),
        ∃ (R : CommRingCat.{u}) (aR : Algebra k R)
          (φ : Spec R ⟶ X),
          IsOpenImmersion φ ∧
            (∃ y : Spec R, φ y = x) ∧
            φ ≫ s =
              Spec.map (CommRingCat.ofHom (algebraMap k R)) ∧
            @Algebra.IsGlobalCompleteIntersection k R _ _ aR)
      ↔
      (∀ (x : X),
        ∃ (R : Type u) (_ : CommRing R) (_ : Algebra k R)
          (_ : IsLocalRing R) (_ : IsNoetherianRing R),
          IsRegularLocalRing R ∧
            Algebra.EssFiniteType k R ∧
            ∃ (rs : List R),
              RingTheory.Sequence.IsRegular R rs ∧
              Nonempty
                (@AlgEquiv k
                  (R ⧸ Ideal.span (Set.range (fun i : Fin rs.length => rs.get i)))
                  (X.presheaf.stalk x) _ _ _ _
                  (((Scheme.ΓSpecIso (.of k)).inv ≫
                    s.appLE ⊤ ⊤ le_top ≫
                    X.presheaf.germ ⊤ x trivial).hom.toAlgebra)))) ∧
    (∀ (S : Type v) (_ : CommRing S) (_ : Algebra k S)
      (_ : Algebra.FiniteType k S),
      (@Algebra.IsLocalCompleteIntersection k S _ _ ‹_› ‹_› ↔
        ∀ (p : Ideal S) (_ : p.IsPrime),
          ∃ (R : Type u) (_ : CommRing R) (_ : Algebra k R)
            (_ : IsLocalRing R) (_ : IsNoetherianRing R),
            IsRegularLocalRing R ∧
              Algebra.EssFiniteType k R ∧
              ∃ (rs : List R),
                RingTheory.Sequence.IsRegular R rs ∧
                Nonempty
                  ((R ⧸ Ideal.span (Set.range
                    (fun i : Fin rs.length => rs.get i))) ≃ₐ[k]
                    (Localization.AtPrime p)))) := by
  sorry

end AlgebraicGeometry
