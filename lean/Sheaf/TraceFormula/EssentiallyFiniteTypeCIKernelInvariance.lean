module

public import Mathlib.RingTheory.EssentialFiniteness
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.FiniteType
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Defs
import Mathlib.RingTheory.RegularLocalRing.Polynomial

/-!
# Independence of essentially finite type complete-intersection presentations

Source: Stacks Project, Algebra, Tag 00SF (lemma-lci-local), equivalence of
conditions (1) and (2), with the regular-sequence condition from Tag 00SD
(blueprint: lem-trf-essentially-finite-type-ci-kernel-invariance).
-/

@[expose] public section

set_option autoImplicit false

universe u v w z

namespace TraceFormula

/--
For a local algebra essentially of finite type over a field, the property that
its kernel is generated by a finite regular sequence in the maximal ideal is
independent of the chosen surjective local map from a regular local algebra of
essentially finite type. Empty sequences are allowed and no completeness
hypothesis is imposed.

Source: Stacks Project, Algebra, Tags 00SF and 00SD
(blueprint: lem-trf-essentially-finite-type-ci-kernel-invariance).

Proof:
1. Write `P` and `Q` as localizations of finite type `k`-algebras `B` and `C`.
   Choose finite algebra generators `b_i` and `c_j`. Every element of `P` is a
   fraction `b/s`, where both `b` and `s` are polynomials in the `b_i`, and
   similarly for `Q`. The localizations themselves need not be finite type.
2. Lift the images of the `c_j` from `A` to `P` and the images of the `b_i`
   to `Q`, using the two surjections. The resulting evaluation maps from
   `D = k[x_i, y_j]` to `P` and `Q` have the same composite `h : D → A`.
   Let `n` be the inverse image of the maximal ideal of `A`; it is prime.
3. Locality implies that the inverse images of the source maximal ideals
   are also `n`: units stay units, and nonunits map to nonunits. Thus the
   two maps extend uniquely to local maps `α : D_n → P` and `β : D_n → Q`.
   Their composites to `A` agree by the localization universal property.
4. These extensions are surjective. To lift `b/s` in `P`, represent `b`
   and `s` by polynomials in the `x_i`. Since `s/1` is a unit in `P`, its
   image in `A` is a unit, so the representing denominator is outside `n`.
   The corresponding fraction in `D_n` lifts `b/s`. The `y_j` give the same
   argument for `Q`, and the common composite to `A` is surjective too.
5. A finite polynomial ring over a field is regular, so `D_n` is regular
   local. Apply the regular-local-surjection kernel comparison (Tag 00SE)
   to `D_n → P → A`: its composite kernel is generated by a finite regular
   sequence in the maximal ideal exactly when `ker u` is.
6. Apply the same comparison to `D_n → Q → A`. The identical composite
   kernel is regular-sequence generated exactly when `ker v` is. Chain
   the two equivalences. Empty generator lists remain allowed throughout;
   no completion is used.
-/
theorem essentiallyFiniteTypeCIKernelInvariance
    (k : Type u) [Field k]
    (A : Type v) [CommRing A] [Algebra k A] [IsLocalRing A]
    [Algebra.EssFiniteType k A]
    (P : Type w) [CommRing P] [Algebra k P] [IsRegularLocalRing P]
    [Algebra.EssFiniteType k P]
    (Q : Type z) [CommRing Q] [Algebra k Q] [IsRegularLocalRing Q]
    [Algebra.EssFiniteType k Q]
    (u : P →ₐ[k] A) (v : Q →ₐ[k] A)
    [IsLocalHom u.toRingHom] [IsLocalHom v.toRingHom]
    (hu : Function.Surjective u) (hv : Function.Surjective v) :
    ((∃ xs : List P,
        RingTheory.Sequence.IsRegular P xs ∧
          Ideal.ofList xs = RingHom.ker u.toRingHom ∧
          ∀ x ∈ xs, x ∈ IsLocalRing.maximalIdeal P) ↔
      (∃ ys : List Q,
        RingTheory.Sequence.IsRegular Q ys ∧
          Ideal.ofList ys = RingHom.ker v.toRingHom ∧
          ∀ y ∈ ys, y ∈ IsLocalRing.maximalIdeal Q)) := by
  sorry

end TraceFormula
