module

public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.EssentialFiniteness
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
public import WeilConjectures.RingTheory.CompleteIntersectionOverField
import Sheaf.TraceFormula.EssentiallyFiniteTypeCIKernelInvariance
import WeilConjectures.RingTheory.LCIRegularSequenceGlobalCompleteIntersection
import Mathlib.RingTheory.RegularLocalRing.Polynomial

/-!
# A principal complete-intersection neighbourhood of a complete-intersection local ring

Source: Stacks Project, Algebra, Tag 00SG (lemma-lci-at-prime), implication (1) => (3),
with the local-ring definition of Tag 00SD (definition-lci-local-ring)
(blueprint: lem-trf-ci-local-ring-principal-neighbourhood).
-/

@[expose] public section

set_option autoImplicit false

universe u v w

namespace TraceFormula

/-- A complete-intersection presentation of the localization at a prime of a finite type
algebra spreads to a principal global-complete-intersection neighbourhood. The witnesses
`A`, `a`, and `e` unpack the existential local-ring hypothesis; the list may be empty.

Source: Stacks Project, Algebra, Tags 00SG and 00SD
(blueprint: lem-trf-ci-local-ring-principal-neighbourhood).

Proof:
1. Choose a surjective finite polynomial presentation `P = k[x₁, ..., xₙ] → F`, using
   finite type, and put `I` equal to its kernel and `q'` equal to the inverse image of `Q`.
   Localization of a quotient identifies `F_Q` with `P_q' / I P_q'`, and the induced map
   `P_q' → F_Q` is a surjective local `k`-algebra map
   (lem-weil-pbc-localization-at-prime-of-quotient).
2. Polynomial-ring regularity makes `P_q'` regular local
   (lem-weil-pbc-polynomial-ring-field-regular-ring). It is essentially of finite type,
   since it is a localization of the finite type algebra `P`.
3. The given equivalence identifies the quotient map from `A` with a surjective local
   map to `F_Q`, with kernel generated by the regular sequence `a` in the maximal ideal.
   Apply lem-trf-essentially-finite-type-ci-kernel-invariance to this map and the map
   from `P_q'`: the ideal `I P_q'` is generated by a regular sequence in its maximal ideal.
4. Apply lem-weil-pbc-lci-regular-sequence-global-complete-intersection to the polynomial
   presentation and this regular sequence. Transport its conclusion through `P/I ≃ₐ[k] F`
   to obtain `h ∉ Q` with `F[1/h]` a global complete intersection over `k`.
-/
theorem ciLocalRingPrincipalNeighbourhood
    (k : Type u) [Field k] (F : Type v) [CommRing F] [Algebra k F]
    (hfinite : RingHom.FiniteType (algebraMap k F))
    (Q : Ideal F) [Q.IsPrime]
    (A : Type w) [CommRing A] [Algebra k A] [IsRegularLocalRing A]
    [Algebra.EssFiniteType k A]
    (a : List A) (hregular : RingTheory.Sequence.IsRegular A a)
    (hmaximal : ∀ x ∈ a, x ∈ IsLocalRing.maximalIdeal A)
    (e : Localization.AtPrime Q ≃ₐ[k] (A ⧸ Ideal.ofList a)) :
    ∃ h : F, h ∉ Q ∧ Algebra.IsGlobalCompleteIntersection k (Localization.Away h) := by
  sorry

end TraceFormula
