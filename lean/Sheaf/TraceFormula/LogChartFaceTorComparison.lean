module

public import Sheaf.TraceFormula.FsFaceSharpening
public import Sheaf.AlgebraicGeometry.LogRegularSharpChart
public import WeilConjectures.Mathlib.RingTheory.Henselian
public import Sheaf.RingTheory.TorKernelBoundaryConstruction
public import Mathlib.Algebra.MonoidAlgebra.Basic
import Sheaf.RingTheory.TorIdealKernelNaturality
import WeilConjectures.Algebra.Category.ModuleCat.TorSymmetry
import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup

/-!
# First Tor under face localization and a change of sharp chart

Source: ILO, Exposé VI, 3.7(a), printed p. 75, and Exposé VIII, proof of
Lemma 3.4.3, printed p. 110 (blueprint: lem-trf-log-chart-face-tor-comparison).

The comparison is characterized on ideal tensors and commutes with the constructed
Tor boundary. This specifies the induced comparison, including its unit twist.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory
open scoped TensorProduct

namespace AlgebraicGeometry
namespace LogChartFaceTor

/-- The inverse image of ring units. Source: ILO VI 3.7(a)
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
def face {P A : Type u} [CommMonoid P] [CommRing A] (a : P →* A) : Submonoid P :=
  (IsUnit.submonoid A).comap a

/-- Inclusion in the already defined face localization. Source: ILO VI 3.7(a)
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
def inclusion {P A : Type u} [CommMonoid P] [CommRing A] (a : P →* A) :
    P →* Algebra.faceLocalization P (face a) :=
  Algebra.GrothendieckGroup.of.codRestrict _
    (fun p ↦ ⟨p, ⟨1, (face a).one_mem⟩, by simp⟩)

/-- The sharp quotient map. Source: ILO VI 3.7(a)
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
def sharpMap {P A : Type u} [CommMonoid P] [CommRing A] (a : P →* A) :
    P →* Associates (Algebra.faceLocalization P (face a)) :=
  Associates.mkMonoidHom.comp (inclusion a)

/-- The ideal generated by the specified monomials, including the empty ideal.
Source: ILO VIII, proof of 3.4.3
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
noncomputable def ideal {P : Type u} [CommMonoid P] (H : Set P) : Ideal (MonoidAlgebra ℤ P) :=
  Ideal.span {x | ∃ p ∈ H, x = MonoidAlgebra.single p 1}

/-- Coefficients with exactly the specified monoid-algebra action. Source: ILO VIII 3.4.3
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
noncomputable def coefficients {P A : Type u} [CommMonoid P] [CommRing A] (a : P →* A) :
    ModuleCat.{u} (MonoidAlgebra ℤ P) :=
  (ModuleCat.restrictScalars (MonoidAlgebra.lift ℤ A P a).toRingHom).obj
    (ModuleCat.of A A)

/-- First Tor with the quotient in the first variable. Source: ILO VIII 3.4.3
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
noncomputable def tor {P A : Type u} [CommMonoid P] [CommRing A]
    (a : P →* A) (H : Set P) : ModuleCat.{u} (MonoidAlgebra ℤ P) :=
  ((Tor' (ModuleCat.{u} (MonoidAlgebra ℤ P)) 1).obj
    (ModuleCat.of (MonoidAlgebra ℤ P) (MonoidAlgebra ℤ P ⧸ ideal H))).obj (coefficients a)

/-- The ideal tensor used to characterize the comparison. Source: ILO VIII 3.4.3
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
noncomputable abbrev idealTensor {P A : Type u} [CommMonoid P] [CommRing A]
    (a : P →* A) (H : Set P) :=
  (ideal H) ⊗[MonoidAlgebra ℤ P] (coefficients a)

/-- The constructed boundary into the ideal tensor. Only the equality
`ker (R → R/I) = I` is transported. Source: Stacks 00M6; ILO VIII 3.4.3
(blueprint: lem-trf-log-chart-face-tor-comparison). -/
noncomputable def boundary {P A : Type u} [CommMonoid P] [CommRing A]
    (a : P →* A) (H : Set P) : tor a H →ₗ[MonoidAlgebra ℤ P] idealTensor a H :=
  ((LinearEquiv.ofEq _ _ (Submodule.ker_mkQ (ideal H))).rTensor
    (coefficients a)).toLinearMap.comp
      (torKernelBoundary (coefficients a) (ModuleCat.of (MonoidAlgebra ℤ P) _)
        (ModuleCat.of (MonoidAlgebra ℤ P) (MonoidAlgebra ℤ P ⧸ ideal H))
        (ideal H).mkQ (Submodule.mkQ_surjective _))

end LogChartFaceTor

/-- Face localization and a specified sharp chart give the natural first-Tor comparison.
The ring equivalence `e` identifies the actual geometric local ring with the named strictly
henselian ring `A`. The two charts are charts of the same actual log stalk. The asserted extension
`aF` is fixed by its values on `P`; it is the localization extension, not an arbitrary map.
The representative formula for `θ` specifies localization, splitting, and unit twist
simultaneously. Together with the boundary square it uniquely specifies the Tor map,
so it also specifies its naturality under compatible coefficient maps.

Source: ILO VI 3.7(a), p. 75, and VIII, proof of 3.4.3, p. 110
(blueprint: lem-trf-log-chart-face-tor-comparison).

Proof:
1. The inverse image of units is a face. Extend the chart by inverting its face.
Use lem-trf-fs-face-sharpening to identify the localization units with the face group.
The given section splits the localization into the sharp quotient and this unit group.
2. The chart pushout identifies the log stalk with the product of the sharp quotient
and ring units. Comparing the two given charts in these coordinates gives the unique
unit homomorphism u and the displayed structural equality.
3. By lem-weil-pbc-tor-symmetry and lem-weil-pbc-tor-ideal-kernel-naturality, first Tor
is the kernel of multiplication from the ideal tensor, with its canonical boundary.
4. The localized ideal is the inverse image of the image ideal in the sharp quotient.
This follows from surjectivity of P to the sharp quotient and invariance under units.
5. Localization on ideal tensors sends z^h tensor a to itself. Its inverse sends
z^(h-f) tensor a to z^h tensor alpha(f)^(-1)a; common denominators verify balancing.
6. The splitting sends z^(s(q)+g) tensor a to z^q tensor alpha(g)a. Its inverse uses s.
Tensor balancing verifies both inverses and compatibility with multiplication to A.
7. The unit twist sends z^q tensor a to z^q tensor u(q)a. The homomorphism identity
for u verifies balancing, and u^(-1) supplies the inverse. Extending coefficients to A
realizes this as z^q mapsto u(q)z^q without any flatness assumption on A over Z.
8. Compose the three ideal-tensor maps, restrict to multiplication kernels, and use
the natural ideal-kernel identification. This yields E and the boundary square.
The generator formulas commute with compatible coefficient maps, proving naturality;
the section and the sharp chart remain fixed, with no choice-independence assertion.
-/
theorem logChart_face_tor_comparison
    {P A : Type u} [CommMonoid P] [CommRing A] [IsStrictlyHenselianLocalRing A]
    (hP : IsFineSaturatedMonoid P)
    (M : EtaleLogStructure (Spec (.of A))) (hM : M.IsFineSaturated)
    {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of A))
    (ht : (Scheme.SpecToEquivOfField Ω (Spec (.of A)) t).1.asIdeal =
      IsLocalRing.maximalIdeal A)
    (e : strictLocalRing (Spec (.of A)) t ≃+* A)
    (aM : P →* M.toEtalePrelogStructure.stalk t) (haM : M.IsStalkChart t aM)
    (a : P →* A) (ha : ∀ p : P, a p = e (M.toEtalePrelogStructure.stalkAlpha t (aM p)))
    (s : Associates (Algebra.faceLocalization P (LogChartFaceTor.face a)) →*
      Algebra.faceLocalization P (LogChartFaceTor.face a))
    (hs : ∀ q, Associates.mk (s q) = q)
    (bM : Associates (Algebra.faceLocalization P (LogChartFaceTor.face a)) →*
      M.toEtalePrelogStructure.stalk t)
    (hbM : M.IsStalkChart t bM)
    (hchar : ∀ p : P, Associates.mk (aM p) =
      Associates.mk (bM (LogChartFaceTor.sharpMap a p)))
    (b : Associates (Algebra.faceLocalization P (LogChartFaceTor.face a)) →* A)
    (hb : ∀ q, b q = e (M.toEtalePrelogStructure.stalkAlpha t (bM q))) :
    ∃ (aF : Algebra.faceLocalization P (LogChartFaceTor.face a) →* A)
      (u : Associates (Algebra.faceLocalization P (LogChartFaceTor.face a)) →* Aˣ),
      aF.comp (LogChartFaceTor.inclusion a) = a ∧
      (∀ q, aF (s q) = (u q : A) * b q) ∧
      ∀ (H : Set P), (∀ p ∈ H, ∀ r : P, p * r ∈ H) →
        ∃ (θ : LogChartFaceTor.idealTensor a H ≃+
            LogChartFaceTor.idealTensor b ((LogChartFaceTor.sharpMap a) '' H))
          (E : LogChartFaceTor.tor a H ≃+
            LogChartFaceTor.tor b ((LogChartFaceTor.sharpMap a) '' H)),
          (∀ (p : P) (_hp : p ∈ H)
            (g : (Algebra.faceLocalization P (LogChartFaceTor.face a))ˣ),
            LogChartFaceTor.inclusion a p = s (LogChartFaceTor.sharpMap a p) * g →
            ∀ (z : LogChartFaceTor.ideal H)
              (w : LogChartFaceTor.ideal ((LogChartFaceTor.sharpMap a) '' H)) (x : A),
              (z : MonoidAlgebra ℤ P) = MonoidAlgebra.single p 1 →
              (w : MonoidAlgebra ℤ _) =
                MonoidAlgebra.single (LogChartFaceTor.sharpMap a p) 1 →
              θ (z ⊗ₜ[MonoidAlgebra ℤ P]
                (@id (LogChartFaceTor.coefficients a) x)) =
                w ⊗ₜ[MonoidAlgebra ℤ _]
                  (@id (LogChartFaceTor.coefficients b)
                    (aF g * (u (LogChartFaceTor.sharpMap a p) : A) * x))) ∧
          (∀ z, LogChartFaceTor.boundary b ((LogChartFaceTor.sharpMap a) '' H) (E z) =
            θ (LogChartFaceTor.boundary a H z)) := by
  sorry

end AlgebraicGeometry
