module

public import Sheaf.AlgebraicGeometry.FineSaturatedLogBlowup
public import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup

import Mathlib.GroupTheory.Finiteness

/-!
# Fine saturated face localizations of commutative monoids

Source: Illusie--Laszlo--Orgogozo, Exposé VIII, 3.1.1--3.1.2,
printed pp. 98--99 (blueprint: lem-trf-face-localization-fs).
-/

@[expose] public section

universe u

open AlgebraicGeometry

namespace Algebra

/-- The localization of a commutative monoid at a submonoid, realized inside its
Grothendieck group by fractions `q * f⁻¹`. Source: ILO VIII, 3.1.1--3.1.2
(blueprint: lem-trf-face-localization-fs). -/
def faceLocalization (Q : Type u) [CommMonoid Q] (F : Submonoid Q) :
    Submonoid (Algebra.GrothendieckGroup Q) where
  carrier := {x | ∃ (q : Q) (f : F), x = Algebra.GrothendieckGroup.of q *
    (Algebra.GrothendieckGroup.of f.1)⁻¹}
  one_mem' := by
    refine ⟨1, ⟨1, F.one_mem⟩, ?_⟩
    simp
  mul_mem' := by
    rintro x y ⟨q₁, f₁, rfl⟩ ⟨q₂, f₂, rfl⟩
    refine ⟨q₁ * q₂, ⟨f₁.1 * f₂.1, F.mul_mem f₁.2 f₂.2⟩, ?_⟩
    simp [mul_assoc, mul_left_comm, mul_comm]

/-- The canonical homomorphism from the group completion of a face localization
into the group completion of the ambient monoid. Source: ILO VIII, 3.1.2
(blueprint: lem-trf-face-localization-fs). -/
noncomputable def faceLocalizationGroupMap {Q : Type u} [CommMonoid Q]
    (F : Submonoid Q) :
    Algebra.GrothendieckGroup (faceLocalization Q F) →* Algebra.GrothendieckGroup Q :=
  Algebra.GrothendieckGroup.lift
    { toFun := fun x => x.1
      map_one' := rfl
      map_mul' := by intro x y; rfl }

end Algebra

namespace AlgebraicGeometry

private theorem groupCompletion_fraction {M : Type u} [CommMonoid M]
    (x : Algebra.GrothendieckGroup M) :
    ∃ a b : M, x = Algebra.GrothendieckGroup.of a *
      (Algebra.GrothendieckGroup.of b)⁻¹ := by
  obtain ⟨⟨a, b⟩, h⟩ := (Localization.monoidOf (⊤ : Submonoid M)).surj x
  exact ⟨a, b, (eq_mul_inv_iff_mul_eq).2 h⟩

private theorem faceLocalizationGroupMap_of {Q : Type u} [CommMonoid Q]
    (F : Submonoid Q) (x : Algebra.faceLocalization Q F) :
    Algebra.faceLocalizationGroupMap F (Algebra.GrothendieckGroup.of x) = x.1 := by
  simp [Algebra.faceLocalizationGroupMap, Algebra.GrothendieckGroup.lift]

/-- If `Q` is a fine saturated commutative monoid and `F` is a face, then the
localization `Q_F = {q f⁻¹}` inside `Q^gp` is fine saturated, and its canonical
map on group completions is an isomorphism. Source: Illusie--Laszlo--Orgogozo,
Exposé VIII, 3.1.1--3.1.2, printed pp. 98--99 (blueprint: lem-trf-face-localization-fs).

Proof: Regard the fine saturated monoid as an integral submonoid of its
Grothendieck group. A finite generating set for `Q`, together with inverses of
face generators, generates `Q_F`, so it is finitely generated; its inclusion in
`Q^gp` gives integrality. Every element of `Q^gp` is a difference of elements of
`Q`, hence the induced map on group completions is surjective and injectivity
follows from the inclusion. Finally, if `n g` lies in `Q_F` for `n > 0`, write
`n g = q f⁻¹`; then `n(g f) = q f^(n-1)` lies in `Q`, so saturation of `Q` gives
`g f ∈ Q`, and therefore `g = (g f) f⁻¹ ∈ Q_F`.
-/
theorem faceLocalization_fineSaturated {Q : Type u} [CommMonoid Q]
    (hQ : IsFineSaturatedMonoid Q) (F : Submonoid Q)
    (hF : ∀ a b : Q, a * b ∈ F → a ∈ F ∧ b ∈ F) :
    IsFineSaturatedMonoid (Algebra.faceLocalization Q F) ∧
      Function.Bijective (Algebra.faceLocalizationGroupMap F) := by
  classical
  let L := Algebra.faceLocalization Q F
  let i : Q →* Algebra.GrothendieckGroup Q := Algebra.GrothendieckGroup.of
  let j : F →* Algebra.GrothendieckGroup Q :=
    { toFun := fun f ↦ (i f.1)⁻¹
      map_one' := by simp
      map_mul' := by intros; simp [mul_comm] }
  obtain ⟨S, hS⟩ := hQ.1
  -- A face is generated by the ambient generators that belong to it.
  have hfgF : F.FG := by
    refine ⟨S.filter (· ∈ F), le_antisymm ?_ ?_⟩
    · apply Submonoid.closure_le.2
      intro x hx
      exact (Finset.mem_filter.mp hx).2
    · intro x hx
      have hxS : x ∈ Submonoid.closure (S : Set Q) := by rw [hS]; trivial
      induction hxS using Submonoid.closure_induction with
      | mem x hxS =>
          exact Submonoid.subset_closure (Finset.mem_filter.mpr ⟨hxS, hx⟩)
      | one => exact Submonoid.one_mem _
      | mul a b ha hb ia ib =>
          obtain ⟨haF, hbF⟩ := hF a b hx
          exact Submonoid.mul_mem _ (ia haF) (ib hbF)
  have hfgL : L.FG := by
    have hL : L = (⊤ : Submonoid Q).map i ⊔ (⊤ : Submonoid F).map j := by
      apply le_antisymm
      · rintro x ⟨q, f, rfl⟩
        exact Submonoid.mul_mem _
          ((show (⊤ : Submonoid Q).map i ≤ _ from le_sup_left)
            (Submonoid.mem_map.mpr ⟨q, trivial, rfl⟩))
          ((show (⊤ : Submonoid F).map j ≤ _ from le_sup_right)
            (Submonoid.mem_map.mpr ⟨f, trivial, rfl⟩))
      · apply sup_le
        · rintro x ⟨q, _, rfl⟩
          exact ⟨q, 1, by simp [i]⟩
        · rintro x ⟨f, _, rfl⟩
          exact ⟨1, f, by simp [j, i]⟩
    rw [hL]
    have hfgQ : (⊤ : Submonoid Q).FG := ⟨S, hS⟩
    have : Monoid.FG F := (Monoid.fg_iff_submonoid_fg F).2 hfgF
    exact (hfgQ.map i).sup (Monoid.FG.fg_top.map j)
  -- The inclusion induces an injection on completions, and Q already generates Q^gp.
  have hmap : Function.Bijective (Algebra.faceLocalizationGroupMap F) := by
    constructor
    · change Function.Injective ((Localization.monoidOf (⊤ : Submonoid L)).lift _)
      apply (Submonoid.LocalizationMap.lift_injective_iff _ _).2
      intro x y
      exact ⟨fun h ↦ congrArg Subtype.val (Algebra.GrothendieckGroup.of_injective h),
        fun h ↦ congrArg Algebra.GrothendieckGroup.of (Subtype.ext h)⟩
    · intro x
      obtain ⟨a, b, rfl⟩ := groupCompletion_fraction x
      have hmem (q : Q) : i q ∈ L := ⟨q, 1, by simp [i]⟩
      refine ⟨Algebra.GrothendieckGroup.of (⟨i a, hmem a⟩ : L) *
        (Algebra.GrothendieckGroup.of (⟨i b, hmem b⟩ : L))⁻¹, ?_⟩
      change Algebra.faceLocalizationGroupMap F
          (Algebra.GrothendieckGroup.of (⟨i a, hmem a⟩ : Algebra.faceLocalization Q F) *
            (Algebra.GrothendieckGroup.of
              (⟨i b, hmem b⟩ : Algebra.faceLocalization Q F))⁻¹) = _
      simp only [map_mul, map_inv, faceLocalizationGroupMap_of]
      rfl
  refine ⟨⟨?_, Algebra.GrothendieckGroup.of_injective, ?_⟩, hmap⟩
  · exact ((Monoid.fg_iff_submonoid_fg L).2 hfgL).fg_top
  · intro g n hn ⟨p, hp⟩
    let x := Algebra.faceLocalizationGroupMap F g
    have hpow : x ^ n ∈ L := by
      rw [← map_pow, ← hp, faceLocalizationGroupMap_of]
      exact p.2
    obtain ⟨q, f, hf⟩ := hpow
    -- Clear the denominator before applying saturation of Q.
    have hclear : i (q * f.1 ^ (n - 1)) = (x * i f.1) ^ n := by
      rw [map_mul, map_pow, mul_pow, hf]
      change i q * i f.1 ^ (n - 1) = (i q * (i f.1)⁻¹) * i f.1 ^ n
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
      simp [pow_succ, mul_assoc, mul_left_comm, mul_comm]
    obtain ⟨r, hr⟩ := hQ.2.2 (x * i f.1) n hn ⟨q * f.1 ^ (n - 1), hclear⟩
    have hxm : x ∈ L := ⟨r, f, by change x = i r * (i f.1)⁻¹; rw [hr]; simp⟩
    refine ⟨⟨x, hxm⟩, hmap.1 ?_⟩
    exact faceLocalizationGroupMap_of F ⟨x, hxm⟩

end AlgebraicGeometry
