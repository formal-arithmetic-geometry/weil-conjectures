/-!
# Residual units in a face-localized chart

Source: ILO, Travaux de Gabber, VI 1.6 and VIII 3.1.1--3.1.5, printed pp. 70, 98--99;
the explicit tensor and character calculation is the DAG's agent-supplied refinement
(blueprint: lem-trf-chart-face-residual-unit-decomposition).

Multiplicative notation is used throughout: `1` denotes the additive zero, products
represent sums, and the Cartesian product represents the displayed direct sum.
-/

@[expose] public section

set_option autoImplicit false

universe u v w

namespace Algebra
namespace ChartResidual

/-- The subgroup generated by a face, using the existing group completion.
Source: ILO VIII 3.1.1--3.1.2 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
def faceGroup {Q : Type v} [CommMonoid Q] (F : Submonoid Q) :
    Subgroup (GrothendieckGroup Q) :=
  Subgroup.closure (GrothendieckGroup.of '' (F : Set Q))

/-- The canonical group map induced by a chart morphism.
Source: ILO VIII 3.1.2 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def groupMap {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (h : R →* Q) : GrothendieckGroup R →* GrothendieckGroup Q :=
  GrothendieckGroup.lift (GrothendieckGroup.of.comp h)

/-- The canonical map from an arbitrary monoid localization into the ambient group.
Source: ILO VIII 3.1.2 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def localizationGroup {Q : Type v} [CommMonoid Q] (F : Submonoid Q) :
    Localization F →* GrothendieckGroup Q :=
  (Localization.monoidOf F).lift (g := GrothendieckGroup.of) (fun _ ↦ Group.isUnit _)

/-- The original monoid's canonical map to its localized sharpening.
Source: ILO VIII 3.1.1--3.1.2 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
def sharpMap {Q : Type v} [CommMonoid Q] (F : Submonoid Q) :
    Q →* Associates (Localization F) :=
  Associates.mkMonoidHom.comp (Localization.monoidOf F).toMonoidHom

/-- The subgroup `N = h(G^gp)` by which residual chart units are divided.
Source: the refinement of ILO VIII 3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def relations {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (G : Submonoid R) (h : R →* Q) : Subgroup (GrothendieckGroup Q) :=
  (faceGroup G).map (groupMap h)

/-- The residual monoid `P`, as the image of `Q_F` in `M = Q^gp/N`.
Source: the refinement of ILO VIII 3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def residualMonoid {Q : Type w} [CommMonoid Q]
    (F : Submonoid Q) (N : Subgroup (GrothendieckGroup Q)) :
    Submonoid (GrothendieckGroup Q ⧸ N) :=
  (faceLocalization Q F).map (QuotientGroup.mk' N)

/-- The residual subgroup `K`, the image of `F^gp` in `Q^gp/N`.
Source: the refinement of ILO VIII 3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def residualUnits {Q : Type w} [CommMonoid Q]
    (F : Submonoid Q) (N : Subgroup (GrothendieckGroup Q)) :
    Subgroup (GrothendieckGroup Q ⧸ N) :=
  (faceGroup F).map (QuotientGroup.mk' N)

/-- The class of a monoid fraction in the actual residual monoid.
Source: the explicit fraction calculation refining ILO VIII 3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def fractionClass {Q : Type w} [CommMonoid Q]
    (F : Submonoid Q) (N : Subgroup (GrothendieckGroup Q)) (q : Q) (f : F) :
    residualMonoid F N :=
  ⟨QuotientGroup.mk' N (GrothendieckGroup.of q * (GrothendieckGroup.of f.1)⁻¹),
    ⟨_, ⟨q, f, rfl⟩, rfl⟩⟩

/-- The monomials inverted in `C_F`, the image of the face under the existing tensor chart.
Source: ILO VIII 3.1.2 and Stacks 00CO
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def denominators {A : Type u} [CommRing A]
    {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (α : R →* A) (h : R →* Q) (F : Submonoid Q) : Submonoid (monoidChartTensor α h) :=
  F.map (monoidChartTensorMonomial α h)

/-- The actual fraction `[q]/[f]` in `C_F`.
Source: Stacks 00CO and the refinement of ILO VIII 3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def tensorFraction {A : Type u} [CommRing A]
    {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (α : R →* A) (h : R →* Q) (F : Submonoid Q) (q : Q) (f : F) :
    Localization (denominators α h F) :=
  Localization.mk (monoidChartTensorMonomial α h q)
    ⟨monoidChartTensorMonomial α h f.1, ⟨f.1, f.2, rfl⟩⟩

/-- The unit character transported by the inverse group-completion isomorphism.
Source: the explicit character refinement of ILO VI 1.6, VIII 3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable def character {A : Type u} [CommRing A]
    {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (h : R →* Q) (hh : Function.Bijective (groupMap h))
    (ε : GrothendieckGroup R →* Aˣ) : GrothendieckGroup Q →* Aˣ :=
  ε.comp (MulEquiv.ofBijective (groupMap h) hh).symm.toMonoidHom

/-- The source face is the inverse image of coefficient units.
Source: ILO VIII 3.1.5 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
abbrev sourceFace {A : Type u} [CommRing A] {R : Type v} [CommMonoid R]
    (α : R →* A) : Submonoid R := (IsUnit.submonoid A).comap α

/-- Multiplicative spelling of the already published sharp chart monoid.
Source: ILO VIII 3.1.1--3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
abbrev sourceSharp {A : Type u} [CommRing A] {R : Type v} [CommMonoid R]
    (α : R →* A) := Multiplicative (chartSharpMonoid α)

/-- The target face is the inverse image of units in the prescribed local tensor ring.
Source: ILO VIII 3.1.5 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable abbrev targetFace {A : Type u} [CommRing A]
    {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (α : R →* A) (h : R →* Q) (q : Ideal (monoidChartTensor α h)) [q.IsPrime] :=
  (IsUnit.submonoid (Localization.AtPrime q)).comap (localizedTensorMonomial α h q)

/-- The sharpening of the target localization, using the existing Associates quotient.
Source: ILO VIII 3.1.1--3.1.2
(blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable abbrev targetSharp {A : Type u} [CommRing A]
    {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (α : R →* A) (h : R →* Q) (q : Ideal (monoidChartTensor α h)) [q.IsPrime] :=
  Associates (Localization (targetFace α h q))

/-- The subgroup N belonging to the source chart.
Source: ILO VIII 3.1.2 (blueprint: lem-trf-chart-face-residual-unit-decomposition). -/
noncomputable abbrev chartRelations {A : Type u} [CommRing A]
    {R : Type v} [CommMonoid R] {Q : Type w} [CommMonoid Q]
    (α : R →* A) (h : R →* Q) := relations (sourceFace α) h

end ChartResidual

open ChartResidual

/-- Face localization separates residual units and retains the explicit character twist.
Source: ILO VI 1.6, VIII 3.1.1--3.1.5, printed pp. 70, 98--99; the tensor statement is
an agent-supplied refinement (blueprint: lem-trf-chart-face-residual-unit-decomposition).

Proof (the eleven steps of the DAG):
1. A product is a unit precisely when both factors are units. The contraction of the prime
   makes `A → B` reflect units (lem-weil-pbc-local-ring-unit-criterion), so `h⁻¹(F)=G`.
   Cross multiplication constructs the localized extension of the chart.
2. Apply lem-trf-fs-face-sharpening twice. This identifies localized units and gives sharp
   fs quotients with finite free completions. The given group isomorphism identifies M
   with S^gp, including torsion in the original groups.
3. The residual monoid embeds in M and is the inverse image of T. The kernel of M→T^gp
   is K=F^gp/N, since a difference of representatives is in the face group precisely
   when their sharp classes agree.
4. Apply lem-weil-subgroup-finite-free-abelian-group-free to K⊆M. Then apply
   lem-trf-group-section-monoid-product to obtain σ and P≃K×T, with the displayed formulas.
5. The induced map S→P has nontrivial T-coordinate off 1, because Q∩F^gp=F and h⁻¹F=G.
6. Form D=A⊗[Z[S]]Z[P], using lem-trf-integer-monoid-algebra-universal-property and
   lem-weil-pbc-algebra-tensor-pushout-universal-property, and put χ=ε∘(h^gp)⁻¹.
7. Send [q] to χ(q)[q-bar]. The balancing equation is ε(r)[f(r-bar)]=α(r), and
   F-monomials become units, giving the forward fraction map C_F→D.
8. For w=q/f, put z(w)=[q]/[f]. The map χ(w)⁻¹z(w) is invariant under N because
   α_G(t)=ε(t) for t∈G^gp, so it descends to P.
9. Its value on f(s) is a(s), giving the inverse D→C_F by the same universal properties.
10. Both composites fix coefficients and monomials, hence all tensors and fractions.
    Reindex by P≃K×T to obtain the stated isomorphism and both monomial formulas.
11. All face denominators avoid the prime. The induced inverse fraction maps identify
    the chosen local rings. They identify maximal-ideal powers; apply them to compatible
    quotient sequences (def-weil-pbc-adic-completion) to identify completions.
No assertion of injectivity of S^gp→T^gp is used or made. -/
theorem chart_face_residual_unit_decomposition
    (A : Type u) [CommRing A] [IsLocalRing A]
    (R : Type v) [CommMonoid R] (Q : Type w) [CommMonoid Q]
    (hR : AlgebraicGeometry.IsFineSaturatedMonoid R)
    (hQ : AlgebraicGeometry.IsFineSaturatedMonoid Q)
    (h : R →* Q) (hh : Function.Bijective (groupMap h)) (α : R →* A)
    (a : sourceSharp α →* A)
    (ε : GrothendieckGroup R →* Aˣ)
    (hα : ∀ x : Localization ((IsUnit.submonoid A).comap α),
      localizedUnitChart α x = (ε (unitChartGroupMap α x) : A) * a (Associates.mk x))
    (q : Ideal (monoidChartTensor α h)) [q.IsPrime]
    (hq : Ideal.comap (monoidChartTensorBase α h) q = IsLocalRing.maximalIdeal A) :
      (∀ x y : R, x * y ∈ (sourceFace α) → x ∈ (sourceFace α) ∧ y ∈ (sourceFace α)) ∧
      (∀ x y : Q, x * y ∈ (targetFace α h q) → x ∈ (targetFace α h q) ∧ y ∈ (targetFace α h q)) ∧
      (targetFace α h q).comap h = (sourceFace α) ∧
      (∀ x : Localization (sourceFace α), IsUnit x ↔ localizationGroup (sourceFace α) x ∈
          faceGroup (sourceFace α)) ∧
      (∀ x : Localization (targetFace α h q), IsUnit x ↔ localizationGroup (targetFace α h q) x ∈
          faceGroup (targetFace α h q)) ∧
      AlgebraicGeometry.IsFineSaturatedMonoid (sourceSharp α) ∧
      AlgebraicGeometry.IsFineSaturatedMonoid (targetSharp α h q) ∧
      (∀ s : (sourceSharp α), IsUnit s → s = 1) ∧ (∀ t : (targetSharp α h q), IsUnit t → t = 1) ∧
      (∃ n : ℕ, Nonempty (Module.Basis (Fin n) ℤ (Additive (GrothendieckGroup (sourceSharp α))))) ∧
      (∃ n : ℕ, Nonempty (Module.Basis (Fin n) ℤ (Additive (GrothendieckGroup
        (targetSharp α h q))))) ∧
      (chartRelations α h) ≤ faceGroup (targetFace α h q) ∧
      ∃ (eM : GrothendieckGroup (sourceSharp α) ≃* (GrothendieckGroup Q ⧸ (chartRelations α h)))
        (π : (GrothendieckGroup Q ⧸ (chartRelations α h)) →* GrothendieckGroup (targetSharp α h q))
        (σ : GrothendieckGroup (targetSharp α h q) →*
          (GrothendieckGroup Q ⧸ chartRelations α h))
        (eP : residualMonoid (targetFace α h q) (chartRelations α h) ≃* (residualUnits
          (targetFace α h q) (chartRelations α h) × targetSharp α h q))
        (f : (sourceSharp α) →* (residualUnits (targetFace α h q) (chartRelations α h) ×
          (targetSharp α h q))),
        (∃ eK : (faceGroup (targetFace α h q) ⧸
            (chartRelations α h).comap (faceGroup (targetFace α h q)).subtype) ≃*
              residualUnits (targetFace α h q) (chartRelations α h),
          ∀ z : faceGroup (targetFace α h q),
            (eK (QuotientGroup.mk' _ z) : GrothendieckGroup Q ⧸ chartRelations α h) =
              QuotientGroup.mk' (chartRelations α h) z.1) ∧
        (∀ r : R, eM (GrothendieckGroup.of (sharpMap (sourceFace α) r)) =
          QuotientGroup.mk' (chartRelations α h) (GrothendieckGroup.of (h r))) ∧
        (∀ z : Q, π (QuotientGroup.mk' (chartRelations α h) (GrothendieckGroup.of z)) =
          GrothendieckGroup.of (sharpMap (targetFace α h q) z)) ∧
        (∀ m : GrothendieckGroup Q ⧸ (chartRelations α h), m ∈ residualMonoid (targetFace α h q)
          (chartRelations α h) ↔
          ∃ t : (targetSharp α h q), π m = GrothendieckGroup.of t) ∧
        (∀ t : GrothendieckGroup (targetSharp α h q), π (σ t) = t) ∧
        (∀ t : (targetSharp α h q), σ (GrothendieckGroup.of t) ∈ residualMonoid (targetFace α h q)
          (chartRelations α h)) ∧
        (∀ (k : residualUnits (targetFace α h q) (chartRelations α h)) (t : (targetSharp α h q)),
          (eP.symm (k, t) : GrothendieckGroup Q ⧸ (chartRelations α h)) =
            k.1 * σ (GrothendieckGroup.of t)) ∧
        (∃ n : ℕ, Nonempty (Module.Basis (Fin n) ℤ (Additive (residualUnits (targetFace α h q)
          (chartRelations α h))))) ∧
        (∀ r : R, f (sharpMap (sourceFace α) r) = eP (fractionClass (targetFace α h q)
          (chartRelations α h) (h r) 1)) ∧
        (∀ s : (sourceSharp α), s ≠ 1 → (f s).2 ≠ 1) ∧
        (∀ z : Q, z ∉ targetFace α h q ↔
          (eP (fractionClass (targetFace α h q) (chartRelations α h) z 1)).2 ≠ 1) ∧
        ∃ Φ : Localization (denominators α h (targetFace α h q)) ≃+* monoidChartTensor a f,
          (∀ b : A, Φ (algebraMap (monoidChartTensor α h) _
            (monoidChartTensorBase α h b)) = monoidChartTensorBase a f b) ∧
          (∀ z : Q, Φ (algebraMap (monoidChartTensor α h) _
            (monoidChartTensorMonomial α h z)) =
              monoidChartTensorBase a f (character h hh ε (GrothendieckGroup.of z)) *
                monoidChartTensorMonomial a f (eP (fractionClass (targetFace α h q)
                  (chartRelations α h) z 1))) ∧
          (∀ (z : Q) (d : (targetFace α h q)), Φ (tensorFraction α h (targetFace α h q) z d) =
            monoidChartTensorBase a f
              (character h hh ε (GrothendieckGroup.of z * (GrothendieckGroup.of d.1)⁻¹)) *
                monoidChartTensorMonomial a f (eP (fractionClass (targetFace α h q)
                  (chartRelations α h) z d))) ∧
          ∃ (qD : Ideal (monoidChartTensor a f)) (_ : qD.IsPrime),
            Ideal.comap (Φ.toRingHom.comp
              (algebraMap (monoidChartTensor α h)
                (Localization (denominators α h (targetFace α h q)))))
                qD = q ∧
            ∃ (eB : Localization.AtPrime q ≃+* Localization.AtPrime qD)
              (eHat : AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime q))
                  (Localization.AtPrime q) ≃+*
                AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime qD))
                  (Localization.AtPrime qD)),
              (∀ c : monoidChartTensor α h,
                eB (algebraMap (monoidChartTensor α h) _ c) =
                  algebraMap (monoidChartTensor a f) _
                    (Φ (algebraMap (monoidChartTensor α h) _ c))) ∧
              (∀ b : Localization.AtPrime q,
                eHat (algebraMap (Localization.AtPrime q) _ b) =
                  algebraMap (Localization.AtPrime qD) _ (eB b)) ∧
              (∀ n : ℕ,
                ∃ eN : (Localization.AtPrime q ⧸
                    (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ n) ≃+*
                  (Localization.AtPrime qD ⧸
                    (IsLocalRing.maximalIdeal (Localization.AtPrime qD)) ^ n),
                  (∀ b : Localization.AtPrime q,
                    eN (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ (eB b)) ∧
                  (∀ x : AdicCompletion
                      (IsLocalRing.maximalIdeal (Localization.AtPrime q))
                      (Localization.AtPrime q),
                    AdicCompletion.evalₐ
                        (IsLocalRing.maximalIdeal (Localization.AtPrime qD)) n (eHat x) =
                      eN (AdicCompletion.evalₐ
                        (IsLocalRing.maximalIdeal (Localization.AtPrime q)) n x))) := by
  sorry

end Algebra
