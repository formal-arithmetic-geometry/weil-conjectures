/-!
# A depth-one quotient of a regular local surface has principal kernel

Source: Stacks Project, Curves, Tag 0C48 (lemma-reduced-quotient-regular-ring-dim-2),
part (2) (blueprint: lem-trf-regular-surface-depth-one-principal).
-/

@[expose] public section

universe u

namespace RingTheory

/-- Let `(A, 𝔫)` be a regular local ring of Krull dimension two and let `I ≤ 𝔫`.
If the quotient `A ⧸ I`, with its quotient maximal ideal, has depth one, then
`I` is generated by a nonzero element of `𝔫`.

Source: Stacks Project, Curves, Tag 0C48, part (2).
The proof follows the source: the regular parameters exclude `I = 0`; unique
factorization extracts a common factor from generators of `I`; the coprime
residual generators give either the unit ideal or an ideal with radical `𝔫`;
in the latter case the maximal associated-prime obstruction from depth one
forces the common factor into `I`, yielding `I = (f)`.
(blueprint: lem-trf-regular-surface-depth-one-principal)
-/
theorem regularSurfaceDepthOnePrincipal
    (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = (2 : WithBot ℕ∞))
    (I : Ideal A) (hI : I ≤ IsLocalRing.maximalIdeal A)
    (hdepth :
      letI : Nontrivial (A ⧸ I) :=
        Ideal.Quotient.nontrivial_iff.mpr
          (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal A).ne_top hI)
      letI : IsLocalRing (A ⧸ I) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      IsLocalRing.depth (R := A ⧸ I) (A ⧸ I) = (1 : ℕ∞)) :
    ∃ f : A, f ≠ 0 ∧ f ∈ IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f} := by
  sorry

end RingTheory
