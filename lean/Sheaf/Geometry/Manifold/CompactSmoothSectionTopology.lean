module

public import Mathlib.Geometry.Manifold.VectorBundle.LocalFrame
public import Mathlib.Analysis.InnerProductSpace.PiL2
public import Mathlib.Topology.Order

/-! # The compact smooth bundle section topology

Source: the agent-stated chart/frame convention of def-sfb-compact-smooth-section-topology,
with inherited attribution to Demailly, Part I §3.A–3.B (the cited PDF is unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology)

## Main definitions

* `CompactSmoothSectionTest`: a chart, smooth frame, compact set and derivative order.
* `CompactSmoothSectionTest.seminormValue`: the coordinate derivative seminorm values.
* `compactSmoothSectionTopology`: the topology generated by translated finite intersections.
* `CompactlySupportedSmoothSection`: the compactly supported subspace.
* `compactlySupportedSmoothSectionTopology`: its subspace topology.

The construction uses all smooth coordinate charts and all smooth local frames, not only the
chosen atlases. Nonnegative suprema implement the empty-compact-set convention.
-/

@[expose] public section

set_option autoImplicit false

open Bundle
open scoped ContDiff NNReal

universe u v

namespace ContMDiffSection

/-- Repeated coordinate differentiation, in the order of the supplied coordinate list.
The empty list gives the original function. Source: the agent-stated coordinate convention,
Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
noncomputable def sectionCoordinateDerivative {m q : ℕ}
    (indices : List (Fin m))
    (f : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin q)) :
    EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin q) :=
  match indices with
  | [] => f
  | i :: rest => fun z =>
      fderiv ℝ (sectionCoordinateDerivative rest f) z (EuclideanSpace.basisFun (Fin m) ℝ i)

variable {m q : ℕ} {N : Type u} [TopologicalSpace N]
  [ChartedSpace (EuclideanSpace ℝ (Fin m)) N]
  (B : N → Type v) [∀ x, AddCommGroup (B x)] [∀ x, Module ℝ (B x)]
  [∀ x, TopologicalSpace (B x)]
  [TopologicalSpace (TotalSpace (EuclideanSpace ℝ (Fin q)) B)]
  [FiberBundle (EuclideanSpace ℝ (Fin q)) B]
  [VectorBundle ℝ (EuclideanSpace ℝ (Fin q)) B]

/-- One chart/frame/compact-set/derivative-order index for the section topology.
Smoothness in both directions admits every smooth chart compatible with the manifold.
Frames are Mathlib's smooth fibrewise bases; their values off the chart domain are irrelevant.
Source: the agent-stated chart/frame convention, Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
structure CompactSmoothSectionTest where
  /-- The chart, including its open source and target. -/
  chart : OpenPartialHomeomorph N (EuclideanSpace ℝ (Fin m))
  /-- The chart is smooth on its source. -/
  smooth_chart : ContMDiffOn (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
    (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m))) ∞ chart chart.source
  /-- The inverse chart is smooth on its target. -/
  smooth_inverse : ContMDiffOn (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
    (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m))) ∞ chart.symm chart.target
  /-- The frame sections, with arbitrary values outside the source. -/
  frame : Fin q → (x : N) → B x
  /-- The frame is smooth and a basis in every fibre over the source. -/
  isFrame : IsLocalFrameOn (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
    (EuclideanSpace ℝ (Fin q)) ∞ frame chart.source
  /-- The compact subset in chart coordinates. -/
  compactSet : Set (EuclideanSpace ℝ (Fin m))
  /-- Compactness of the coordinate subset. -/
  isCompact : IsCompact compactSet
  /-- The compact subset is inside the chart target. -/
  subset_target : compactSet ⊆ chart.target
  /-- The nonnegative derivative order. -/
  order : ℕ

/-- The coefficient vector in a chart and smooth frame, using Mathlib's frame coefficients.
On the chart target, `IsLocalFrameOn.coeff_sum_eq` is exactly the specified frame expansion.
Source: the agent-stated coefficient convention, Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
noncomputable def CompactSmoothSectionTest.coefficients
    (a : CompactSmoothSectionTest (m := m) (q := q) B)
    (s : ContMDiffSection (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
      (EuclideanSpace ℝ (Fin q)) ∞ B) (z : EuclideanSpace ℝ (Fin m)) :
    EuclideanSpace ℝ (Fin q) :=
  WithLp.toLp 2 (fun j => a.isFrame.coeff j (a.chart.symm z) (s (a.chart.symm z)))

/-- The chart/frame seminorm value: the maximum over multi-indices of order at most `a.order`
of the compact suprema of Euclidean derivative norms. Taking a single nonnegative supremum
of all these values gives the same number, and gives zero for an empty compact set.
Coordinates are differentiated in increasing coordinate order with the specified multiplicities.
Source: the agent-stated seminorm convention, Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
noncomputable def CompactSmoothSectionTest.seminormValue
    (a : CompactSmoothSectionTest (m := m) (q := q) B)
    (s : ContMDiffSection (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
      (EuclideanSpace ℝ (Fin q)) ∞ B) : ℝ :=
  (sSup {r : ℝ≥0 | ∃ α : Fin m → ℕ, (∑ j, α j) ≤ a.order ∧
    ∃ z ∈ a.compactSet,
      r = ‖sectionCoordinateDerivative
        ((List.finRange m).flatMap (fun j => List.replicate (α j) j))
        (a.coefficients B s) z‖₊} : ℝ≥0)

/-- The smallest topology containing all translates of finite intersections of positive-radius
chart/frame seminorm balls. The empty finite intersection is included by allowing `n = 0`.
Source: the agent-stated compact section topology, Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
@[instance_reducible]
noncomputable def compactSmoothSectionTopology
    [IsManifold (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m))) ∞ N]
    [ContMDiffVectorBundle ∞ (EuclideanSpace ℝ (Fin q)) B
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))]
    [CompactSpace N] [T2Space N] [SecondCountableTopology N] :
    TopologicalSpace (ContMDiffSection
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
      (EuclideanSpace ℝ (Fin q)) ∞ B) :=
  TopologicalSpace.generateFrom {U | ∃ s₀, ∃ n : ℕ,
    ∃ a : Fin n → CompactSmoothSectionTest (m := m) (q := q) B,
    ∃ ε : Fin n → ℝ, (∀ i, 0 < ε i) ∧
      U = (fun t => s₀ + t) '' {t | ∀ i, (a i).seminormValue B t < ε i}}

/-- Smooth compactly supported sections: the support is the closure of the nonzero locus.
Source: the agent-stated compact-support convention, Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
def CompactlySupportedSmoothSection :=
  {s : ContMDiffSection (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))
    (EuclideanSpace ℝ (Fin q)) ∞ B // IsCompact (closure {x : N | s x ≠ 0})}

/-- The subspace topology on compactly supported smooth sections.
Source: the agent-stated compact section topology, Demailly Part I §3.A–3.B (unavailable locally).
(blueprint: def-sfb-compact-smooth-section-topology) -/
@[instance_reducible]
noncomputable def compactlySupportedSmoothSectionTopology
    [IsManifold (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m))) ∞ N]
    [ContMDiffVectorBundle ∞ (EuclideanSpace ℝ (Fin q)) B
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m)))]
    [CompactSpace N] [T2Space N] [SecondCountableTopology N] :
    TopologicalSpace (CompactlySupportedSmoothSection (m := m) (q := q) B) :=
  TopologicalSpace.induced Subtype.val (compactSmoothSectionTopology B)

end ContMDiffSection
