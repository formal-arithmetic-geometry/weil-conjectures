module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.TensorProduct.Finite

/-! # Split representation groups and scalar extension

Source: ILO, Exposé X, Proposition 1.2, p.138, representation lifting before (5).
This is the explicit generators-and-relations construction used by the auxiliary criterion.
(blueprint: def-per-finite-module-split-grothendieck)
-/

@[expose] public section

universe u v w t

namespace RepresentationTheory

/-- A finite-dimensional left algebra module, encoded by its linear action.
Source: ILO X 1.2, p.138, representation classes.
(blueprint: def-per-finite-module-split-grothendieck) -/
structure FiniteAlgebraModule (K : Type u) [Field K] (A : Type t) [Ring A] [Algebra K A] where
  space : ModuleCat.{w} K
  finite : Module.Finite K space
  action : A →ₐ[K] Module.End K space

attribute [instance] FiniteAlgebraModule.finite

variable {K : Type u} [Field K] {A : Type t} [Ring A] [Algebra K A]

/-- Isomorphism of finite-dimensional left modules, expressed by an intertwiner.
Source: ILO X 1.2, p.138. (blueprint: def-per-finite-module-split-grothendieck) -/
def FiniteAlgebraModule.Isomorphic (V W : FiniteAlgebraModule.{u, w, t} K A) : Prop :=
  ∃ e : V.space ≃ₗ[K] W.space, ∀ (a : A) (x : V.space),
    e (V.action a x) = W.action a (e x)

/-- A direct sum relation, allowing any representative of the direct sum's isomorphism class.
Source: ILO X 1.2, p.138. (blueprint: def-per-finite-module-split-grothendieck) -/
def FiniteAlgebraModule.IsDirectSum (U V W : FiniteAlgebraModule.{u, w, t} K A) : Prop :=
  ∃ e : W.space ≃ₗ[K] U.space × V.space, ∀ (a : A) (x : W.space),
    e (W.action a x) = (U.action a (e x).1, V.action a (e x).2)

/-- The subgroup generated by isomorphism and binary direct sum relations.
Source: ILO X 1.2, p.138. (blueprint: def-per-finite-module-split-grothendieck) -/
def finiteModuleSplitRelations (K : Type u) [Field K] (A : Type t) [Ring A] [Algebra K A] :
    AddSubgroup (FreeAbelianGroup (FiniteAlgebraModule.{u, w, t} K A)) :=
  AddSubgroup.closure {z | (∃ V W, V.Isomorphic W ∧
    z = FreeAbelianGroup.of V - FreeAbelianGroup.of W) ∨
    (∃ U V W, FiniteAlgebraModule.IsDirectSum U V W ∧
      z = FreeAbelianGroup.of W - FreeAbelianGroup.of U - FreeAbelianGroup.of V)}

/-- The integral split Grothendieck group of finite-dimensional left modules.
Source: ILO X 1.2, p.138. (blueprint: def-per-finite-module-split-grothendieck) -/
abbrev FiniteModuleSplitGrothendieck (K : Type u) [Field K] (A : Type t) [Ring A]
    [Algebra K A] :=
  FreeAbelianGroup (FiniteAlgebraModule.{u, w, t} K A) ⧸ finiteModuleSplitRelations K A

variable (L : Type v) [Field L] [Algebra K L]

/-- Scalar extension of the action on `L ⊗[K] V` by the tensor algebra's universal property.
In particular `(l ⊗ a) (m ⊗ x) = (l*m) ⊗ (a*x)`.
Source: ILO X 1.2, p.138. (blueprint: def-per-finite-module-split-grothendieck) -/
noncomputable def FiniteAlgebraModule.extendScalars
    (V : FiniteAlgebraModule.{u, w, t} K A) : FiniteAlgebraModule L (TensorProduct K L A) where
  space := ModuleCat.of L (TensorProduct K L V.space)
  finite := inferInstance
  action := AlgHom.liftEquiv K L A _ ((Module.End.baseChangeHom K L V.space).comp V.action)

/-- Scalar extension sends every split relation to a split relation.
Source: ILO X 1.2, p.138, explicit construction of the representation-class map.
Proof: tensor an intertwining isomorphism with L to preserve isomorphism relations.
For a sum relation, tensor its displayed intertwiner and compose with the canonical
`TensorProduct.prodRight` isomorphism. This intertwines the tensor actions on pure tensors,
hence everywhere by bilinearity. Both generators therefore map into the target subgroup;
closure gives the assertion for all relations.
(blueprint: def-per-finite-module-split-grothendieck) -/
theorem finiteModuleSplitRelations_extendScalars :
    finiteModuleSplitRelations K A ≤
      (finiteModuleSplitRelations L (TensorProduct K L A)).comap
        (FreeAbelianGroup.map (FiniteAlgebraModule.extendScalars (K := K) (A := A) L)) := by
  sorry

/-- The canonical integral scalar-extension homomorphism on representation classes.
Source: ILO X 1.2, p.138. Its value on `[V]` is `[L ⊗[K] V]` by construction.
(blueprint: def-per-finite-module-split-grothendieck) -/
noncomputable def finiteModuleSplitScalarExtension :
    FiniteModuleSplitGrothendieck.{u, w, t} K A →+
      FiniteModuleSplitGrothendieck L (TensorProduct K L A) :=
  QuotientAddGroup.map _ _
    (FreeAbelianGroup.map (FiniteAlgebraModule.extendScalars (K := K) (A := A) L))
    (finiteModuleSplitRelations_extendScalars L)

end RepresentationTheory
