module

public import WeilConjectures.CategoryTheory.SimplexPresentationFaithful

/-!
# Contravariant evaluation of simplex words

Source: Stacks Project, Tag 016B, `lemma-characterize-simplicial-object` (2), through
Tag 0168, `lemma-face-degeneracy-category` (b),(c)
(blueprint: lem-trf-simplex-word-evaluation-descent).

## Main definitions

* `CategoryTheory.simplexOperatorsQuiver`: cofaces and codegeneracies evaluated in the opposite.
* `CategoryTheory.simplexWordEvaluation`: evaluation of actual words before taking the quotient.

## Main statements

* `CategoryTheory.simplexWordEvaluation_descent`: evaluation respects the generated congruence
  and defines a functor on the opposite presentation with all the specified values.
-/

@[expose] public section

set_option autoImplicit false

universe v u

open CategoryTheory Opposite

namespace CategoryTheory

/-- The quiver assignment sending a coface to the prescribed face and a codegeneracy to the
prescribed degeneracy, viewed covariantly in the opposite target category.
Source: Stacks Project, Tag 016B (2), via Tag 0168
(blueprint: lem-trf-simplex-word-evaluation-descent). -/
def simplexOperatorsQuiver {D : Type u} [Category.{v} D] (U : ℕ → D)
    (d : ∀ n : ℕ, Fin (n + 2) → (U (n + 1) ⟶ U n))
    (s : ∀ n : ℕ, Fin (n + 1) → (U n ⟶ U (n + 1))) :
    FreeSimplexQuiver ⥤q Dᵒᵖ where
  obj a := op (U a.len)
  map f := match f with
    | .δ i => (d _ i).op
    | .σ i => (s _ i).op

/-- Evaluate a word contravariantly by the free path functor: the empty word evaluates to the
identity, and appending a generator composes its value on the left in the target.
Source: Stacks Project, Tag 016B (2), via Tag 0168
(blueprint: lem-trf-simplex-word-evaluation-descent). -/
def simplexWordEvaluation {D : Type u} [Category.{v} D] (U : ℕ → D)
    (d : ∀ n : ℕ, Fin (n + 2) → (U (n + 1) ⟶ U n))
    (s : ∀ n : ℕ, Fin (n + 1) → (U n ⟶ U (n + 1)))
    {a b : Paths FreeSimplexQuiver} (w : a ⟶ b) : U b.len ⟶ U a.len :=
  ((Paths.lift (simplexOperatorsQuiver U d s)).map w).unop

/-- Word evaluation is constant on each class of the category congruence generated by the
six simplex relations, and descends to the opposite presentation category with the prescribed
object, generator, word, composition and empty-word values. The equalities `h` transport the
functor's values to the given objects, without any strict equality assumption on those objects.

Source: Stacks Project, Tag 016B (2), via Tag 0168 (b),(c)
(blueprint: lem-trf-simplex-word-evaluation-descent).

Proof: (1) Assign cofaces to `d` and codegeneracies to `s` in the opposite target. The free
path functor evaluates an empty path as an identity and a path with a generator appended by
composition; unop reverses that composition. Thus its recursion is exactly word evaluation.
(2) Induct on the length of the second word to obtain the concatenation formula. The empty
case is the identity law; the appended-generator case follows by the recursion, the induction
hypothesis and associativity.
(3) Evaluate both sides of each of the six generating relations. They are exactly the six
hypotheses below: face-face, face-degeneracy with lower index, the two adjacent mixed
identities, face-degeneracy with upper index, and degeneracy-degeneracy. Hence they agree.
(4) Equality of evaluations is an equivalence relation on parallel words. The concatenation
formula makes it stable under precomposition and postcomposition, so it contains the
composition closure of the six relations and then its equivalence closure. This proves
constancy on every congruence class.
(5) Descend the path functor by `CategoryTheory.Quotient.lift` and take its `leftOp`.
Objects are `U n`; maps are the evaluation of any representative by (4). The one-letter
recursion gives the face and degeneracy values, (2) gives reversed composition, and the
empty-word recursion gives identities. This uses the presentation from
`lem-sc-module-cup-godement-simplex-presentation-faithful`, but not its faithfulness theorem. -/
theorem simplexWordEvaluation_descent {D : Type u} [Category.{v} D]
    (U : ℕ → D)
    (d : ∀ n : ℕ, Fin (n + 2) → (U (n + 1) ⟶ U n))
    (s : ∀ n : ℕ, Fin (n + 1) → (U n ⟶ U (n + 1)))
    (hdd : ∀ (n : ℕ) (i j : Fin (n + 2)), i ≤ j →
      d (n + 1) j.succ ≫ d n i = d (n + 1) i.castSucc ≫ d n j)
    (hds_lt : ∀ (n : ℕ) (i : Fin (n + 2)) (j : Fin (n + 1)), i ≤ j.castSucc →
      s (n + 1) j.succ ≫ d (n + 1) i.castSucc = d n i ≫ s n j)
    (hds_self : ∀ (n : ℕ) (j : Fin (n + 1)), s n j ≫ d n j.castSucc = 𝟙 (U n))
    (hds_succ : ∀ (n : ℕ) (j : Fin (n + 1)), s n j ≫ d n j.succ = 𝟙 (U n))
    (hds_gt : ∀ (n : ℕ) (i : Fin (n + 2)) (j : Fin (n + 1)), j.castSucc < i →
      s (n + 1) j.castSucc ≫ d (n + 1) i.succ = d n i ≫ s n j)
    (hss : ∀ (n : ℕ) (i j : Fin (n + 1)), i ≤ j →
      s n j ≫ s (n + 1) i.castSucc = s n i ≫ s (n + 1) j.succ) :
    (∀ (a b : Paths FreeSimplexQuiver) (p q : a ⟶ b),
      Relation.EqvGen
        (@HomRel.CompClosure (Paths FreeSimplexQuiver) _ FreeSimplexQuiver.homRel a b)
        p q → simplexWordEvaluation U d s p = simplexWordEvaluation U d s q) ∧
    ∃ E : SimplexCategoryGenRelᵒᵖ ⥤ D,
      ∃ h : ∀ a : SimplexCategoryGenRel, E.obj (op a) = U a.len,
        (∀ (n : ℕ) (i : Fin (n + 2)),
          eqToHom (h (SimplexCategoryGenRel.mk (n + 1))).symm ≫
            E.map (SimplexCategoryGenRel.δ i).op ≫
            eqToHom (h (SimplexCategoryGenRel.mk n)) = d n i) ∧
        (∀ (n : ℕ) (i : Fin (n + 1)),
          eqToHom (h (SimplexCategoryGenRel.mk n)).symm ≫
            E.map (SimplexCategoryGenRel.σ i).op ≫
            eqToHom (h (SimplexCategoryGenRel.mk (n + 1))) = s n i) ∧
        (∀ (a b : Paths FreeSimplexQuiver) (w : a ⟶ b),
          eqToHom (h ((Quotient.functor FreeSimplexQuiver.homRel).obj b)).symm ≫
            E.map ((Quotient.functor FreeSimplexQuiver.homRel).map w).op ≫
            eqToHom (h ((Quotient.functor FreeSimplexQuiver.homRel).obj a)) =
              simplexWordEvaluation U d s w) ∧
        (∀ (a b c : SimplexCategoryGenRel) (p : a ⟶ b) (q : b ⟶ c),
          E.map (p ≫ q).op = E.map q.op ≫ E.map p.op) ∧
        (∀ a : Paths FreeSimplexQuiver,
          simplexWordEvaluation U d s (𝟙 a) = 𝟙 (U a.len)) := by
  sorry

end CategoryTheory
