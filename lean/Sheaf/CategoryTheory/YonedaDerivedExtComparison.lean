module

public import Mathlib.CategoryTheory.Abelian.Basic
public import Mathlib.Algebra.Homology.ExactSequence
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.Basic
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExtClass
public import Mathlib.CategoryTheory.Preadditive.Injective.Basic
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic
import Mathlib.Algebra.Homology.DerivedCategory.Basic
import Mathlib.Algebra.Homology.DerivedCategory.Fractions
import Mathlib.CategoryTheory.Localization.CalculusOfFractions
import WeilConjectures.CategoryTheory.PushoutShortExactSequence
import WeilConjectures.CategoryTheory.PushoutShortExactSequence

/-! # Yoneda extensions and derived Ext

Source: Stacks Project, Derived Categories, Tags 06XU and 06XV, and Homology,
Section 010I (blueprint: lem-coef-yoneda-derived-ext-comparison).

The carrier is the quotient of actual finite exact sequences by endpoint-fixed
zigzags. `YonedaDerivedExtComparison` specifies the comparison, its normalization
on short exact sequences and splices, naturality, and the Baer group operation.
The splice normalization characterizes the canonical map in every positive degree;
it uses Mathlib's short-exact-sequence class with the signs of the positive-projection
roof, and composition in derived Ext.

## Main definitions

* `YonedaExtension` and `YonedaExtension.Classes`: exact sequences and their quotient.
* `YonedaExtension.BaerSum`: the specified direct-sum/pullback/pushout construction.
* `YonedaDerivedExtComparison`: the canonically normalized natural comparison.

## Main statements

* `nonempty_yonedaDerivedExtComparison`: the comparison and its stated properties exist.
-/

@[expose] public section

universe u v w

namespace CategoryTheory

open Limits Abelian

/-- A degree `i` extension `0 → V → E₁ → ⋯ → Eᵢ → U → 0`.
The endpoint isomorphisms allow the use of the same sequence with named endpoints.

Source: Stacks Project, Derived Categories, definition preceding Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
structure YonedaExtension (A : Type u) [Category.{v} A] [HasZeroMorphisms A]
    (V U : A) (i : ℕ) where
  /-- The nonzero part of the sequence. -/
  sequence : ComposableArrows A (i + 1)
  /-- Identification of its left endpoint. -/
  leftIso : sequence.left ≅ V
  /-- Identification of its right endpoint. -/
  rightIso : sequence.right ≅ U
  /-- Exactness at all middle terms. -/
  exact : sequence.Exact
  /-- Exactness at the left endpoint. -/
  first_mono : Mono (sequence.map' 0 1)
  /-- Exactness at the right endpoint. -/
  last_epi : Epi (sequence.map' i (i + 1))

namespace YonedaExtension

variable {A : Type u} [Category.{v} A] [HasZeroMorphisms A]

/-- The map induced on the left endpoint by a map of extension sequences.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def leftMap {V U V' U' : A} {i : ℕ} (E : YonedaExtension A V U i)
    (F : YonedaExtension A V' U' i) (φ : E.sequence ⟶ F.sequence) : V ⟶ V' :=
  E.leftIso.inv ≫ φ.app 0 ≫ F.leftIso.hom

/-- The map induced on the right endpoint by a map of extension sequences.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def rightMap {V U V' U' : A} {i : ℕ} (E : YonedaExtension A V U i)
    (F : YonedaExtension A V' U' i) (φ : E.sequence ⟶ F.sequence) : U ⟶ U' :=
  E.rightIso.inv ≫ φ.app (Fin.last (i + 1)) ≫ F.rightIso.hom

/-- A generating endpoint-fixed arrow for Yoneda equivalence.

Source: Stacks Project, Derived Categories, definition preceding Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def Related {V U : A} {i : ℕ} (E F : YonedaExtension A V U i) : Prop :=
  ∃ φ : E.sequence ⟶ F.sequence, E.leftMap F φ = 𝟙 V ∧ E.rightMap F φ = 𝟙 U

/-- The equivalence relation generated by endpoint-fixed arrows, including both
orientations and finite compositions.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def Equivalent {V U : A} {i : ℕ} (E F : YonedaExtension A V U i) : Prop :=
  Relation.EqvGen Related E F

/-- Actual Yoneda extension classes, without any identification with derived Ext.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def Classes (V U : A) (i : ℕ) : Type (max u v) :=
  Quot (Equivalent (A := A) (V := V) (U := U) (i := i))

/-- The class of an actual sequence in the Yoneda quotient.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def classOf {V U : A} {i : ℕ} (E : YonedaExtension A V U i) : Classes V U i :=
  Quot.mk _ E

end YonedaExtension

namespace YonedaExtension

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- A short extension is split when its short complex has a Mathlib splitting.

Source: Stacks Project, Derived Categories, Tag 06XV, and Homology, Section 010I
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def IsSplit {V U : A} (E : YonedaExtension A V U 1) : Prop :=
  Nonempty (E.sequence.sc E.exact.toIsComplex 0).Splitting

/-- Data identifying an extension with the splice of a short exact sequence and
an extension of one smaller positive degree. The kernel object is not retained
among the middle terms of the spliced sequence.

Source: Stacks Project, Derived Categories, Tag 06XU and the Yoneda composition
following Tag 06XV (blueprint: lem-coef-yoneda-derived-ext-comparison). -/
structure Splice {U : A} {n : ℕ} (S : ShortComplex A)
    (F : YonedaExtension A S.X₃ U (n + 1))
    (E : YonedaExtension A S.X₁ U (n + 2)) where
  /-- Identification of the new first middle term. -/
  firstIso : S.X₂ ≅ E.sequence.obj' 1
  /-- Identification of all subsequent terms and their differentials. -/
  tailIso : F.sequence.δ₀ ≅ E.sequence.δ₀.δ₀
  /-- The first arrow agrees with that of the short exact sequence. -/
  first_comm : S.f ≫ firstIso.hom = E.leftIso.inv ≫ E.sequence.map' 0 1
  /-- At the splice the two arrows through the kernel object are composed. -/
  splice_comm : S.g ≫ F.leftIso.inv ≫ F.sequence.map' 0 1 ≫ tailIso.hom.app 0 =
    firstIso.hom ≫ E.sequence.map' 1 2
  /-- The identification fixes the right endpoint. -/
  right_comm : tailIso.hom.app (Fin.last (n + 1)) ≫ E.rightIso.hom = F.rightIso.hom

/-- The Baer-sum construction on actual extensions. First take a termwise direct
sum `T`, then pull back its last arrow along the diagonal to obtain `P`, and push
out its first arrow along addition to obtain `G`. All the other middle terms are
preserved by isomorphisms. In an abelian category a binary product is also a binary
direct sum; its projections specify the termwise direct sum here.

Source: Stacks Project, Homology, Section 010I, Baer sum construction, and Derived
Categories, Tag 06XV (blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def BaerSum {V U : A} {i : ℕ} (E F G : YonedaExtension A V U i) : Prop :=
  ∃ (T : YonedaExtension A (Limits.prod V V) (Limits.prod U U) i)
    (P : YonedaExtension A (Limits.prod V V) U i)
    (p₁ : T.sequence ⟶ E.sequence) (p₂ : T.sequence ⟶ F.sequence)
    (b : P.sequence ⟶ T.sequence) (c : P.sequence ⟶ G.sequence),
    T.leftMap E p₁ = Limits.prod.fst ∧ T.leftMap F p₂ = Limits.prod.snd ∧
    T.rightMap E p₁ = Limits.prod.fst ∧ T.rightMap F p₂ = Limits.prod.snd ∧
    (∀ k : Fin (i + 2), Nonempty (IsLimit (BinaryFan.mk (p₁.app k) (p₂.app k)))) ∧
    P.leftMap T b = 𝟙 _ ∧ P.rightMap T b = Limits.prod.lift (𝟙 U) (𝟙 U) ∧
    IsPullback (b.app ⟨i, by omega⟩) (P.sequence.map' i (i + 1) ≫ P.rightIso.hom)
      (T.sequence.map' i (i + 1) ≫ T.rightIso.hom) (Limits.prod.lift (𝟙 U) (𝟙 U)) ∧
    (∀ k : Fin (i + 2), k.val < i → IsIso (b.app k)) ∧
    P.leftMap G c = Limits.prod.fst + Limits.prod.snd ∧ P.rightMap G c = 𝟙 U ∧
    IsPushout (P.leftIso.inv ≫ P.sequence.map' 0 1) (Limits.prod.fst + Limits.prod.snd)
      (c.app ⟨1, by omega⟩) (G.leftIso.inv ≫ G.sequence.map' 0 1) ∧
    (∀ k : Fin (i + 2), 1 < k.val → IsIso (c.app k))

end YonedaExtension

/-- The canonical natural comparison in all positive degrees, including its Baer
addition and degree-one zero criterion. Normalization on short exact sequences
and on splices fixes the comparison uniquely: every exact sequence can be cut at
the image of its first differential, and this lowers its degree by one.

Source: Stacks Project, Derived Categories, Tags 06XU and 06XV, and Homology,
Section 010I (blueprint: lem-coef-yoneda-derived-ext-comparison). -/
structure YonedaDerivedExtComparison (A : Type u) [Category.{v} A] [Abelian A]
    [HasExt.{w} A] where
  /-- The group is carried by the quotient of actual exact sequences. -/
  classGroup (V U : A) (n : ℕ) : AddCommGroup (YonedaExtension.Classes V U (n + 1))
  /-- The additive isomorphism with the recorded derived Ext. -/
  comparison (V U : A) (n : ℕ) :
    @AddEquiv (YonedaExtension.Classes V U (n + 1)) (Ext U V (n + 1))
      (classGroup V U n).toAdd inferInstance
  /-- In degree one the positive-projection roof is the negative of Mathlib's
  connecting class: its cone triangle uses the negative projection. -/
  shortExact_class (V U : A) (E : YonedaExtension A V U 1)
      (h : (E.sequence.sc E.exact.toIsComplex 0).ShortExact) :
    comparison V U 0 E.classOf =
      -(((Ext.mk₀ E.rightIso.inv).comp h.extClass (zero_add 1)).comp
        (Ext.mk₀ E.leftIso.hom) (add_zero 1))
  /-- A splice is normalized by the positive-projection roof. Shifting the short
  complex by `n + 1` contributes `(-1)^(n + 1)`, and replacing its positive
  projection by Mathlib's negative connecting class contributes one more minus. -/
  splice_class (U : A) (n : ℕ) (S : ShortComplex A) (hS : S.ShortExact)
      (F : YonedaExtension A S.X₃ U (n + 1))
      (E : YonedaExtension A S.X₁ U (n + 2)) (s : YonedaExtension.Splice S F E) :
    comparison S.X₁ U (n + 1) E.classOf =
      (-1 : ℤ) ^ n • ((comparison S.X₃ U n F.classOf).comp hS.extClass (by omega))
  /-- Naturality for any commutative map of sequences, with the induced maps on
  the two endpoints. It includes both pullback in `U` and pushout in `V`. -/
  naturality (V U V' U' : A) (n : ℕ) (E : YonedaExtension A V U (n + 1))
      (F : YonedaExtension A V' U' (n + 1)) (φ : E.sequence ⟶ F.sequence) :
    (comparison V U n E.classOf).comp (Ext.mk₀ (E.leftMap F φ)) (add_zero _) =
      (Ext.mk₀ (E.rightMap F φ)).comp (comparison V' U' n F.classOf) (zero_add _)
  /-- The geometric Baer construction is the addition on quotient classes. -/
  baer_sum (V U : A) (n : ℕ) (E F G : YonedaExtension A V U (n + 1))
      (h : YonedaExtension.BaerSum E F G) :
    G.classOf = (classGroup V U n).add E.classOf F.classOf
  /-- The Baer construction exists for every pair of extensions. -/
  baer_exists (V U : A) (n : ℕ) (E F : YonedaExtension A V U (n + 1)) :
    ∃ G : YonedaExtension A V U (n + 1), YonedaExtension.BaerSum E F G
  /-- Exactly the split short extensions have zero class. -/
  split_iff (V U : A) (E : YonedaExtension A V U 1) :
    comparison V U 0 E.classOf = 0 ↔ E.IsSplit
  /-- Injective second arguments give zero groups in every positive degree. -/
  injective_vanishing (V U : A) [Injective V] (n : ℕ) : Subsingleton (Ext U V (n + 1))

/-- Yoneda extension classes are naturally isomorphic as abelian groups to
positive derived Ext, with the Baer addition, split-zero criterion and injective
vanishing specified in `YonedaDerivedExtComparison`.

Source: Stacks Project, Derived Categories, Tags 06XU and 06XV, and Homology,
Section 010I (blueprint: lem-coef-yoneda-derived-ext-comparison).

Proof:
1. For an exact extension E form the complex C_E in degrees -i through 0. Its
augmentation s_E to U[0] is a quasi-isomorphism by exactness, and projection to V[i]
gives f_E. The roof Q(f_E) Q(s_E)⁻¹ is unchanged by endpoint-fixed sequence maps,
hence by their zigzags (def-pc-ext, def-weil-abstract-derived-category).
2. Represent any derived morphism by a right fraction (lem-pc-right-fraction-
representation and lem-pc-quasi-isomorphisms-multiplicative-system). Upper-truncate
the denominator complex at degree 0; its negative cohomology vanishes.
3. Factor its degree -i differential through its image K. The numerator factors
through K because it kills the preceding image. Push out K → L^(-i+1) along K → V
(lem-weil-pbc-pushout-short-exact-sequence). Splice the resulting short exact
sequence with the retained terms. For i=1 no extra copy of L⁰ is retained.
4. The natural map of complexes from L to the constructed extension complex
commutes with both numerators and denominators and is a quasi-isomorphism. Thus
every derived class is represented by an extension.
5. Equal classes admit a common right-fraction refinement (lem-pc-right-fraction-
common-refinement). Upper-truncate it; augmentation homotopies vanish. Correct
one comparison map by the differential of the remaining homotopy into V[i], so
both endpoint equations hold strictly.
6. Apply the pushout construction to this common refinement. The maps from its
first middle term to the two given first middle terms descend through the
pushout by the chain-map equations. Later maps come from the refinement, and
endpoint maps are identities. This gives a zigzag and proves injectivity.
7. Pull back the last epimorphism for a map into U and push out the first
monomorphism for a map out of V. Exactness follows from the short-exact pushout
lemma and its opposite-category form. Finite direct sums remain exact.
8. The induced maps of roofs prove naturality. The same roof computation on a
short exact sequence is the negative of Mathlib's extClass: mappingCone.triangle
uses the negative projection, whereas f_E is the positive projection. For a
splice with a tail of degree r = n+1, the shifted short complex has differential
(-1)^r times its original differential. The comparison from the spliced complex
to this shifted short complex is the identity on the first middle term and
(-1)^r on V. Thus delta(F).comp delta(S) = (-1)^r delta(E). Replacing delta(S)
by -extClass(S) gives delta(E) = (-1)^n (delta(F).comp extClass(S)). These are
exactly the two normalization fields; induction on the degree determines the roof.
9. The direct-sum, diagonal-pullback, addition-pushout construction maps to
addition of derived morphisms. Negation is pushout along -1, and the usual
split extension (or the extension with only V and U as nonzero middle terms)
represents zero. Transport the group laws across the established bijection.
10. In degree one a retraction of the first arrow null-homotopes the numerator.
Conversely every endpoint-fixed morphism of short exact sequences is an
isomorphism (kernel and cokernel vanish), so equivalence with the split extension
carries a splitting across the zigzag (def-sp-abelian).
11. If V is injective (def-sp-injective-resolutions), extend its identity along
the first monomorphism to obtain a retraction. This null-homotopes the numerator
in every positive degree, and surjectivity proves vanishing. No enough-injectives
or enough-projectives hypothesis is used.
-/
theorem nonempty_yonedaDerivedExtComparison (A : Type u) [Category.{v} A]
    [Abelian A] [HasExt.{w} A] : Nonempty (YonedaDerivedExtComparison A) := by
  sorry

end CategoryTheory
