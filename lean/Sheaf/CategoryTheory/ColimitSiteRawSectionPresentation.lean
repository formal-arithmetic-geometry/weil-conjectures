module

public import Sheaf.CategoryTheory.ArrowsFunctor
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Pullback
public import Mathlib.CategoryTheory.Comma.Over.Basic
public import Mathlib.CategoryTheory.Limits.FunctorCategory.Basic
import Sheaf.CategoryTheory.ColimitSiteRawSectionCompatibility

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.Functor.sheafPullbackConstruction

namespace CategoryTheory

/-- Source: Stacks Project, Sites, Tag 0A35 (lemma-compute-pullback-to-limit),
section construction and adjunction paragraphs; the raw Kan presentation of that construction.
(blueprint: lem-weil-pbc-colimit-site-raw-section-presentation).

Proof: Put Y = V_i(U). The cocone equality supplies, for each t, an equality
V_t(F(t.hom)(U)) = Y. Compose E_t, the Kan unit beta_t, and the coprojection
B_t -> colimit B at this represented object, then transport along that equality.
These maps form a cocone on D: the equations hbeta_map and hm, together with
naturality of the coprojections, identify its two composites along each arrow.
Proof irrelevance makes the choice of object equality immaterial. Let mu be the
induced map from the chosen set colimit of D to (colimit B)(Y).

To construct its inverse, compute each B_t(Y) by the pointwise Kan colimit.
A generator consists of W in F(t.right), a section x of A_t(W), and an arrow
Y -> V_t(W). Lift the two endpoints and this arrow to a common stage k. This
is possible because hobjects and harrows are colimits of filtered set diagrams:
represent the arrow, refine to equate its endpoints with the given endpoints,
and equalize the resulting arrows out of i so that k is an object t' of Under i
receiving t. The lift is an arrow F(t'.hom)(U) -> F(b.right)(W). Apply theta_b
at W to x, restrict along this lifted arrow, apply E_t' inverse, and take the
coprojection into colimit D. This defines the inverse on generators.

It is independent of all choices: two endpoint or arrow lifts with the same
image agree after a further refinement by the filtered-set equality criterion.
There theta is natural, and hm identifies the two resulting section classes.
A Kan relation is induced by a stage morphism W -> W'; lift it and its defining
triangle to one stage, where the two restricted sections agree by naturality.
A relation from a transition B(b) is respected by hbeta_map and hm. Any equality
in either colimit is generated by finitely many such relations; filteredness
allows their simultaneous refinement. Thus the construction descends through
the pointwise Kan colimits and the outer colimit B to a well-defined map psi.
On a D generator the lift may be the identity arrow at its own stage, so
psi(mu(x)) = x. On a Kan generator, naturality of beta and hbeta_map identify
mu(psi(x)) with the original generator after the chosen refinement. Hence mu
and psi are inverse. Take R to be the chosen colimit cocone of D and q the
isomorphism with hom mu. Its defining coprojection equation is precisely the
asserted formula. No presheaf T or map out of colimit B enters this argument.
-/
theorem raw_section_presentation
    (J : Type u) [SmallCategory J] [IsFiltered J] (F : J ⥤ Cat.{u, u})
    (P : ∀ j : J, Precoverage (F.obj j))
    [∀ (j k : J) (a : j ⟶ k),
      (F.map a).toFunctor.IsContinuous (P j).toGrothendieck (P k).toGrothendieck]
    (V : Cocone F)
    (hobjects : IsColimit (Cat.objects.mapCocone V))
    (harrows : IsColimit (Cat.arrows.mapCocone V))
    (Q : Precoverage V.pt)
    [∀ j : J, (V.ι.app j).toFunctor.IsContinuous
      (P j).toGrothendieck Q.toGrothendieck]
    (i : J) (G : Sheaf (P i).toGrothendieck (Type u))
    (θ : ∀ (t t' : Under i) (b : t ⟶ t'),
                        (sheafPullback (F.map t.hom).toFunctor (Type u)
                          (P i).toGrothendieck (P t.right).toGrothendieck).obj G ⟶
                        ((F.map b.right).toFunctor.sheafPushforwardContinuous (Type u)
                          (P t.right).toGrothendieck (P t'.right).toGrothendieck).obj
                          ((sheafPullback (F.map t'.hom).toFunctor (Type u)
                            (P i).toGrothendieck (P t'.right).toGrothendieck).obj G))
    (hθ : ∀ (t t' : Under i) (b : t ⟶ t'),
      (∀ X : F.obj i,
                          Arrow.mk
                            (((sheafAdjunctionContinuous (F.map t.hom).toFunctor (Type u)
                              (P i).toGrothendieck (P t.right).toGrothendieck).unit.app
                                G).hom.app (op X) ≫
                              (θ t t' b).hom.app (op ((F.map t.hom).toFunctor.obj X))) =
                          Arrow.mk
                            (((sheafAdjunctionContinuous (F.map t'.hom).toFunctor (Type u)
                              (P i).toGrothendieck (P t'.right).toGrothendieck).unit.app
                                G).hom.app (op X))))
    (B : Under i ⥤ (V.ptᵒᵖ ⥤ Type u))
    (β : ∀ t : Under i,
      ((sheafPullback (F.map t.hom).toFunctor (Type u)
        (P i).toGrothendieck (P t.right).toGrothendieck).obj G).obj ⟶
        (V.ι.app t.right).toFunctor.op ⋙ B.obj t)
    (hβ : ∀ t : Under i, (B.obj t).IsLeftKanExtension (β t))
    (hβmap : ∀ (t t' : Under i) (b : t ⟶ t') (X : F.obj t.right),
      Arrow.mk ((β t).app (op X) ≫
        (B.map b).app (op ((V.ι.app t.right).toFunctor.obj X))) =
      Arrow.mk ((θ t t' b).hom.app (op X) ≫
        (β t').app (op ((F.map b.right).toFunctor.obj X))))
    (U : F.obj i)
    (D : Under i ⥤ Type u)
    (E : ∀ t : Under i, D.obj t ≅ ((sheafPullback (F.map t.hom).toFunctor (Type u)
        (P i).toGrothendieck (P t.right).toGrothendieck).obj G).obj.obj
          (op ((F.map t.hom).toFunctor.obj U)))
    (hm : ∀ (t t' : Under i) (b : t ⟶ t'),
      Arrow.mk ((E t).hom ≫
        (θ t t' b).hom.app (op ((F.map t.hom).toFunctor.obj U))) =
      Arrow.mk (D.map b ≫ (E t').hom)) :
    ∃ (R : Cocone D)
      (q : R.pt ≅ (colimit B).obj (op ((V.ι.app i).toFunctor.obj U))),
      Nonempty (IsColimit R) ∧
      ∀ t : Under i,
        ∃ e : (V.ι.app t.right).toFunctor.obj ((F.map t.hom).toFunctor.obj U) =
            (V.ι.app i).toFunctor.obj U,
          R.ι.app t ≫ q.hom =
            (E t).hom ≫ (β t).app (op ((F.map t.hom).toFunctor.obj U)) ≫
              (colimit.ι B t).app
                (op ((V.ι.app t.right).toFunctor.obj ((F.map t.hom).toFunctor.obj U))) ≫
              eqToHom (congrArg (fun X => (colimit B).obj (op X)) e) := by
  let R : Cocone D := colimit.cocone D
  have hR : IsColimit R := colimit.isColimit D
  obtain ⟨q, hq⟩ := raw_section_presentation_compatibility
    J F P V hobjects harrows Q i G θ hθ B β hβ hβmap U D E hm R hR
  exact ⟨R, q, ⟨hR⟩, hq⟩

end CategoryTheory
