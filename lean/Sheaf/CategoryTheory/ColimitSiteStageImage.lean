module

public import Mathlib.CategoryTheory.Category.Cat
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Pullback
public import Mathlib.CategoryTheory.Comma.Over.Basic

public import Mathlib.CategoryTheory.Subfunctor.Basic

/-! # The subpresheaf generated by stage inverse-image sections.

Source: Stacks Project, Sites, Tag 0A35.
(blueprint: def-weil-pbc-colimit-site-stage-image).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.Functor.sheafPullbackConstruction

namespace CategoryTheory

/-- Source: Stacks Project, Sites, Tag 0A35, section construction.
(blueprint: def-weil-pbc-colimit-site-stage-image).
A section belongs when it is a restriction of the image of a stage section.
The restriction map composes the presenting arrow, so this is a real subpresheaf. -/
def colimitSiteStageImage
    {J : Type u} [SmallCategory J] (F : J ⥤ Cat.{u, u})
    (P : ∀ j : J, Precoverage (F.obj j)) (V : Cocone F) (Q : Precoverage V.pt)
    [∀ (j k : J) (a : j ⟶ k),
      (F.map a).toFunctor.IsContinuous (P j).toGrothendieck (P k).toGrothendieck]
    [∀ j : J, (V.ι.app j).toFunctor.IsContinuous
      (P j).toGrothendieck Q.toGrothendieck]
    (i : J) (G : Sheaf (P i).toGrothendieck (Type u))
    (α : ∀ t : Under i,
                (sheafPullback (F.map t.hom).toFunctor (Type u)
                  (P i).toGrothendieck (P t.right).toGrothendieck).obj G ⟶
                ((V.ι.app t.right).toFunctor.sheafPushforwardContinuous (Type u)
                  (P t.right).toGrothendieck Q.toGrothendieck).obj
                  ((sheafPullback (V.ι.app i).toFunctor (Type u)
                    (P i).toGrothendieck Q.toGrothendieck).obj G))
    : Subfunctor ((sheafPullback (V.ι.app i).toFunctor (Type u)
      (P i).toGrothendieck Q.toGrothendieck).obj G).obj where
  obj Y := {x | ∃ (t : Under i) (W : F.obj t.right)
    (f : unop Y ⟶ (V.ι.app t.right).toFunctor.obj W)
    (z : ((sheafPullback (F.map t.hom).toFunctor (Type u)
      (P i).toGrothendieck (P t.right).toGrothendieck).obj G).obj.obj (op W)),
    ((sheafPullback (V.ι.app i).toFunctor (Type u)
      (P i).toGrothendieck Q.toGrothendieck).obj G).obj.map f.op ((α t).hom.app (op W) z) = x}
  map {Y Z} g := by
    rintro x ⟨t, W, f, z, rfl⟩
    refine ⟨t, W, g.unop ≫ f, z, ?_⟩
    simp only [op_comp, Functor.map_comp, types_comp_apply, Quiver.Hom.op_unop]

end CategoryTheory
