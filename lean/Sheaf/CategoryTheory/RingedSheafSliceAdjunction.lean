/-!
# Slice-site localization for ringed sheaves

Source: Stacks Project, sites.tex, Tags 0791 and 04J4, and sites-modules.tex,
Tag 04IE (blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits DirectSum Opposite

namespace CategoryTheory

/-- Projection from the opposite element category to the original site.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
def elementProjection {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type u)) : A.obj.Elementsᵒᵖ ⥤ C :=
  (CategoryOfElements.π A.obj).op ⋙ (opOpEquivalence C).functor

/-- The element-site topology: the finest topology making the projection to the original site
continuous (Mathlib `Functor.inducedTopology`). The structure below states that it is the
topology generated by the families whose underlying families cover in the original site.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
def elementTopology {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type u)) : GrothendieckTopology A.obj.Elementsᵒᵖ :=
  (elementProjection A).inducedTopology J

/-- The element projection is continuous for the element-site topology.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
instance elementProjection_isContinuous {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (A : Sheaf J (Type u)) :
    Functor.IsContinuous (elementProjection A) (elementTopology A) J :=
  Functor.instIsContinuousInducedTopology

/-- The restricted ring sheaf `R_A`, obtained by precomposition with the element projection.

Source: Stacks Project, sites-modules.tex, Tag 04IE
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
noncomputable def elementRing {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u)) :
    Sheaf (elementTopology A) RingCat.{u} :=
  ⟨(elementProjection A).op ⋙ R.obj,
    (elementProjection A).op_comp_isSheaf_of_isSheaf _ _ _ R.property⟩

/-- The sectionwise fibre presheaf attached to an object `F ⟶ A` of the sheaf slice.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
def elementFibrePresheaf {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    {A : Sheaf J (Type u)}
    (X : CostructuredArrow (𝟭 (Sheaf J (Type u))) A) :
    A.obj.Elementsᵒᵖ → Type u :=
  fun e ↦ {x : X.left.obj.obj (unop e).1 //
    X.hom.hom.app (unop e).1 x = (unop e).2}

/-- The fibre presheaf functor on the sheaf slice: `(F ⟶ A)` goes to
`(U,s) ↦ {x ∈ F(U) | p_U x = s}`, with the restrictions of `F`.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
def elementFibrePresheafFunctor {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type u)) :
    CostructuredArrow (𝟭 (Sheaf J (Type u))) A ⥤ (A.obj.Elementsᵒᵖᵒᵖ ⥤ Type u) where
  obj X :=
    { obj := fun e ↦ elementFibrePresheaf X e.unop
      map := fun {e e'} g ↦ TypeCat.ofHom fun x ↦ ⟨X.left.obj.map g.unop.unop.1 x.1, by
        exact ((NatTrans.naturality_apply X.hom.hom g.unop.unop.1 x.1).trans
          (congrArg _ x.2)).trans g.unop.unop.2⟩ }
  map {X Y} f :=
    { app := fun e ↦ TypeCat.ofHom fun x ↦ ⟨f.left.hom.app _ x.1, by
        have h := congrArg (fun φ ↦ φ.hom.app (unop (unop e)).1 x.1) f.w
        simp only [Functor.id_map] at h
        exact h.trans x.2⟩ }

/-- The object `(U,s)` of the element site, as an object of the opposite of the site.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
abbrev elementObj {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type u)) (U : Cᵒᵖ) (s : A.obj.obj U) : A.obj.Elementsᵒᵖᵒᵖ :=
  op (op ⟨U, s⟩)

/-- The arrow `(V, A(v)(s)) ⟶ (U,s)` of the element site over `v : V ⟶ U`.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
def elementObjMap {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type u)) {U V : Cᵒᵖ} (f : U ⟶ V) (s : A.obj.obj U) :
    elementObj A U s ⟶ elementObj A V (A.obj.map f s) :=
  (CategoryOfElements.homMk (A.obj.elementsMk U s) (A.obj.elementsMk V (A.obj.map f s)) f
    rfl).op.op

open Classical in
/-- Restriction of the direct-sum presheaf: the summand indexed by `s` goes to the summand
indexed by `A(v)(s)` through the restriction of `L`.

Source: Stacks Project, sites-modules.tex, Tags 04IE and 03CY
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
noncomputable def elementDirectSumMap {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u))
    (L : ringedSiteModules (elementRing R A)) {U V : Cᵒᵖ} (f : U ⟶ V) :
    ModuleCat.of (R.obj.obj U) (⨁ s : A.obj.obj U, (L.val.obj (elementObj A U s) : Type u)) ⟶
      (ModuleCat.restrictScalars (R.obj.map f).hom).obj
        (ModuleCat.of (R.obj.obj V)
          (⨁ t : A.obj.obj V, (L.val.obj (elementObj A V t) : Type u))) :=
  ModuleCat.ofHom (Y := ((ModuleCat.restrictScalars (R.obj.map f).hom).obj
      (ModuleCat.of (R.obj.obj V)
        (⨁ t : A.obj.obj V, (L.val.obj (elementObj A V t) : Type u)))))
    (DirectSum.toModule (R.obj.obj U) (A.obj.obj U)
    ((ModuleCat.restrictScalars (R.obj.map f).hom).obj
      (ModuleCat.of (R.obj.obj V)
        (⨁ t : A.obj.obj V, (L.val.obj (elementObj A V t) : Type u)))) fun s ↦
    ((L.val.map (elementObjMap A f s) ≫
      (ModuleCat.restrictScalars (R.obj.map f).hom).map
        (ModuleCat.ofHom (DirectSum.lof (R.obj.obj V) (A.obj.obj V)
          (fun t ↦ (L.val.obj (elementObj A V t) : Type u)) (A.obj.map f s)))) :
      ModuleCat.of (R.obj.obj U) (L.val.obj (elementObj A U s) : Type u) ⟶ _).hom)

open Classical in
private theorem elementDirectSumMap_lof {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u))
    (L : ringedSiteModules (elementRing R A)) {U V : Cᵒᵖ} (f : U ⟶ V)
    (s : A.obj.obj U) (x : L.val.obj (elementObj A U s)) :
    elementDirectSumMap R A L f
      (DirectSum.lof (R.obj.obj U) (A.obj.obj U)
        (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x) =
    DirectSum.lof (R.obj.obj V) (A.obj.obj V)
      (fun t ↦ (L.val.obj (elementObj A V t) : Type u)) (A.obj.map f s)
      (L.val.map (elementObjMap A f s) x) := by
  classical
  change (DirectSum.toModule (R.obj.obj U) (A.obj.obj U) _ _)
    (DirectSum.lof (R.obj.obj U) (A.obj.obj U)
      (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x) = _
  rw [DirectSum.toModule_lof]
  rfl

/-- The direct-sum restriction preserves identities.

Source: Stacks Project, sites-modules.tex, Tag 04IE
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction).
Proof: check on each summand indexed by s. The element-map for the identity fixes
(U,s), the restriction of L is the identity after the restriction-of-scalars identity
comparison, and the target summand is again s because A preserves identities.
Thus the two maps agree on every direct-sum inclusion; the direct-sum universal
property gives equality. -/
theorem elementDirectSumMap_id {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u))
    (L : ringedSiteModules (elementRing R A)) (U : Cᵒᵖ) :
    elementDirectSumMap R A L (𝟙 U) =
      (ModuleCat.restrictScalarsId' (R.obj.map (𝟙 U)).hom
        (congrArg RingCat.Hom.hom (R.obj.map_id U))).inv.app _ := by
  classical
  ext s x
  simp only [LinearMap.comp_apply]
  change (DirectSum.toModule (R.obj.obj U) (A.obj.obj U) _ _)
    (DirectSum.lof (R.obj.obj U) (A.obj.obj U)
      (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x) = _
  rw [DirectSum.toModule_lof]
  change DirectSum.lof (R.obj.obj U) (A.obj.obj U)
    (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) (A.obj.map (𝟙 U) s)
    (L.val.map (elementObjMap A (𝟙 U) s) x) = DirectSum.lof (R.obj.obj U) (A.obj.obj U)
      (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x
  have aux (t : A.obj.obj U) (ht : A.obj.map (𝟙 U) s = t) :
      DirectSum.lof (R.obj.obj U) (A.obj.obj U)
        (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) t
        (L.val.map (CategoryOfElements.homMk (A.obj.elementsMk U s)
          (A.obj.elementsMk U t) (𝟙 U) ht).op.op x) =
      DirectSum.lof (R.obj.obj U) (A.obj.obj U)
        (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x := by
    have h : s = t := by simpa only [Functor.map_id_apply] using ht
    cases h
    change DirectSum.lof (R.obj.obj U) (A.obj.obj U)
      (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s (L.val.map (𝟙 _) x) = _
    simp
  exact aux _ rfl


/-- The direct-sum restriction is compatible with composition.

Source: Stacks Project, sites-modules.tex, Tag 04IE
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction).
Proof: check on the summand indexed by s. The two successive restrictions send it to
A(g)(A(f)(s)), which equals A(f followed by g)(s) by functoriality of A. The element
arrows compose accordingly; functoriality of L identifies their linear maps after
restrictScalarsComp. Both direct-sum maps therefore have the same composite with
every summand inclusion. The direct-sum universal property gives the equality. -/
theorem elementDirectSumMap_comp {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u))
    (L : ringedSiteModules (elementRing R A)) {U V W : Cᵒᵖ} (f : U ⟶ V) (g : V ⟶ W) :
    elementDirectSumMap R A L (f ≫ g) =
      elementDirectSumMap R A L f ≫
        (ModuleCat.restrictScalars _).map (elementDirectSumMap R A L g) ≫
          (ModuleCat.restrictScalarsComp' (R.obj.map f).hom (R.obj.map g).hom
            (R.obj.map (f ≫ g)).hom
            (congrArg RingCat.Hom.hom <| R.obj.map_comp f g)).inv.app _ := by
  classical
  ext s x
  simp only [LinearMap.comp_apply]
  change elementDirectSumMap R A L (f ≫ g)
    (DirectSum.lof (R.obj.obj U) (A.obj.obj U)
      (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x) =
    elementDirectSumMap R A L g
      (elementDirectSumMap R A L f
        (DirectSum.lof (R.obj.obj U) (A.obj.obj U)
          (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x))
  have aux (t : A.obj.obj W) (ht : A.obj.map (f ≫ g) s = t) :
      elementDirectSumMap R A L (f ≫ g)
        (DirectSum.lof (R.obj.obj U) (A.obj.obj U)
          (fun t ↦ (L.val.obj (elementObj A U t) : Type u)) s x) =
      DirectSum.lof (R.obj.obj W) (A.obj.obj W)
        (fun t ↦ (L.val.obj (elementObj A W t) : Type u)) t
        (L.val.map (CategoryOfElements.homMk (A.obj.elementsMk U s)
          (A.obj.elementsMk W t) (f ≫ g) ht).op.op x) := by
    cases ht
    exact elementDirectSumMap_lof R A L (f ≫ g) s x
  rw [aux _ (A.obj.map_comp_apply f g s), elementDirectSumMap_lof,
    elementDirectSumMap_lof]
  apply congrArg (DirectSum.lof (R.obj.obj W) (A.obj.obj W)
    (fun t ↦ (L.val.obj (elementObj A W t) : Type u)) (A.obj.map g (A.obj.map f s)))
  have h : (CategoryOfElements.homMk (A.obj.elementsMk U s)
      (A.obj.elementsMk W (A.obj.map g (A.obj.map f s))) (f ≫ g)
        (A.obj.map_comp_apply f g s)).op.op =
      elementObjMap A f s ≫ elementObjMap A g (A.obj.map f s) := by
    apply Quiver.Hom.unop_inj
    apply Quiver.Hom.unop_inj
    apply Subtype.ext
    rfl
  rw [h]
  exact L.val.map_comp_apply _ _ x

/-- The presheaf of `R`-modules `U ↦ ⨁_{s ∈ A(U)} L(U,s)` whose module sheafification is the
extension by zero of `L`.

Source: Stacks Project, sites-modules.tex, Tags 04IE and 03CY; sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
noncomputable def elementDirectSumPresheaf {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u))
    (L : ringedSiteModules (elementRing R A)) : PresheafOfModules.{u} R.obj where
  obj U := ModuleCat.of (R.obj.obj U)
    (⨁ s : A.obj.obj U, (L.val.obj (elementObj A U s) : Type u))
  map f := elementDirectSumMap R A L f
  map_id U := elementDirectSumMap_id R A L U
  map_comp f g := elementDirectSumMap_comp R A L f g

/-- The module restriction functor induced by the element projection.

Source: Stacks Project, sites-modules.tex, Tag 04IE
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
noncomputable def elementModulePullback {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u)) :
    ringedSiteModules R ⥤ ringedSiteModules (elementRing R A) :=
  SheafOfModules.pushforward (F := elementProjection A) (𝟙 (elementRing R A))

/-- The pullback of sheaves of sets along the element projection.

Source: Stacks Project, sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
noncomputable def elementSheafPullback {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (A : Sheaf J (Type u)) :
    Sheaf J (Type u) ⥤ Sheaf (elementTopology A) (Type u) where
  obj F := ⟨(elementProjection A).op ⋙ F.obj,
    (elementProjection A).op_comp_isSheaf_of_isSheaf _ _ _ F.property⟩
  map f := ObjectProperty.homMk (Functor.whiskerLeft (elementProjection A).op f.hom)

/-- Map of element sites `(U,b) ↦ (U, b_U(b))` induced by a map of sheaves `B ⟶ A`.

Source: Stacks Project, sites-modules.tex, Tag 04J4; sites.tex, Tag 0791
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
def elementMap {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    {B A : Sheaf J (Type u)} (b : B ⟶ A) :
    B.obj.Elementsᵒᵖ ⥤ A.obj.Elementsᵒᵖ :=
  (CategoryOfElements.map b.hom).op

/-- Module restriction along the induced map of element sites (relocalization at `B ⟶ A`).

Source: Stacks Project, sites-modules.tex, Tag 04J4
(blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
noncomputable def elementModulePullbackOver {C : Type u} [SmallCategory C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u})
    {B A : Sheaf J (Type u)} (b : B ⟶ A)
    (h : Functor.IsContinuous (elementMap b) (elementTopology B) (elementTopology A)) :
    ringedSiteModules (elementRing R A) ⥤ ringedSiteModules (elementRing R B) :=
  SheafOfModules.pushforward (F := elementMap b) (𝟙 (elementRing R B))

/-- Data of the ringed slice presentation and its exact module adjunction.

Source: Stacks Project, sites.tex, Tags 0791 and 04J4, and sites-modules.tex,
Tag 04IE (blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction). -/
structure RingedSheafSliceAdjunctionData
    {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u)) where
  /-- The element-site topology is generated by the families whose underlying families cover. -/
  elementTopology_eq : elementTopology A = (elementProjection A).restrictedTopology J
  /-- The geometric equivalence between the induced element site and the sheaf slice. -/
  fibreEquivalence :
    Sheaf (elementTopology A) (Type u) ≌
      CostructuredArrow (𝟭 (Sheaf J (Type u))) A
  /-- The inverse equivalence is the fibre functor `(F ⟶ A) ↦ ((U,s) ↦ {x | p_U x = s})`,
  with its restrictions, naturally in the object of the slice. -/
  fibre_iso :
    fibreEquivalence.inverse ⋙ sheafToPresheaf (elementTopology A) (Type u) ≅
      elementFibrePresheafFunctor A
  /-- The restricted ring sheaf is the canonical pullback along the element projection. -/
  sliceRing_formula : (elementRing R A).obj = (elementProjection A).op ⋙ R.obj
  /-- The localization morphism has the direction from the slice to the original topos. -/
  localization : RingedToposMorphism (elementRing R A) R
  localization_inverse : localization.inverse = elementSheafPullback A
  /-- The structural map is the identity after the canonical inverse-image identification. -/
  localization_ringMap_identity :
    ∀ (U : A.obj.Elements)
      (x :
        (localization.inverse.obj ((sheafCompose J (forget RingCat)).obj R)).obj.obj
          (Opposite.op (Opposite.op U))),
      HEq
        ((localization.ringMap.hom.app (Opposite.op (Opposite.op U))) x) x
  /-- Its module inverse image is the canonical sectionwise restriction. -/
  pullback : ringedSiteModules R ⥤
    ringedSiteModules (elementRing R A) := elementModulePullback R A
  /-- Inverse image is left adjoint to the induced module direct image. -/
  localization_modules : pullback ⊣ localization.modules
  pullback_formula :
    ∀ (M : ringedSiteModules R) (U : Cᵒᵖ) (s : A.obj.obj U),
      ((pullback.obj M).val.obj (⟨U, s⟩) : Type u) = (M.val.obj U : Type u)
  extensionByZero :
    ringedSiteModules (elementRing R A) ⥤ ringedSiteModules R
  /-- Extension by zero is the module sheafification of the direct-sum presheaf. -/
  extensionByZero_sheafification :
    ∀ (L : ringedSiteModules (elementRing R A)),
      Nonempty (extensionByZero.obj L ≅
        (PresheafOfModules.sheafification (𝟙 R.obj)).obj (elementDirectSumPresheaf R A L))
  moduleAdjunction : extensionByZero ⊣ pullback
  pullback_exact : PreservesFiniteLimits pullback ∧ PreservesFiniteColimits pullback
  extensionByZero_exact :
    PreservesFiniteLimits extensionByZero ∧ PreservesFiniteColimits extensionByZero
  extensionByZero_additive : extensionByZero.Additive
  /-- Relocalization at a map `B ⟶ A` uses the element site of `B` and its canonical restriction. -/
  relocalization :
    ∀ (B : Sheaf J (Type u)) (b : B ⟶ A),
      ∃ (h : Functor.IsContinuous (elementMap b) (elementTopology B) (elementTopology A))
        (localize : ringedSiteModules (elementRing R A) ⥤
          ringedSiteModules (elementRing R B)),
        localize = elementModulePullbackOver R b h ∧
        Nonempty (Sheaf (elementTopology B) (Type u) ≌
          CostructuredArrow (𝟭 (Sheaf J (Type u))) B) ∧
        Nonempty (pullback ⋙ localize ≅ elementModulePullback R B)

/-- The category-of-elements site of a sheaf, its ringed localization, and the
exact extension-by-zero/module-restriction adjunction, including relocalization.

Source: Stacks Project, sites.tex, Tags 0791 and 04J4, and sites-modules.tex,
Tag 04IE (blueprint: lem-weil-pbc-ringed-sheaf-slice-adjunction).

Proof.
1. The element category is small; covering families are those whose underlying families cover,
   and the site axioms are inherited from the original site (sites.tex 0791, 00VH).
2. The fibre presheaf `(U,s) ↦ {x ∈ F(U) | p_U x = s}` of `F ⟶ A` is a sheaf; conversely a sheaf
   `L` on the element site gives the sheafified presheaf of pairs `(s, x)`, `x ∈ L(U,s)`, over `A`.
   The maps `x ↦ (p x, x)` and evaluation at the fibre are mutually inverse and natural.
3. The projection `(U,s) ↦ U` is continuous and cocontinuous, so restriction is the inverse image
   of a morphism of topoi, which under step 2 is `G ↦ (G × A → A)`; this is `j_A`. The ring
   `R × A → A` has fibre `R(U)`, so `R_A = j_A⁻¹ R` and the structural map is the identity; the
   module pullback `R_A ⊗_{j_A⁻¹R} j_A⁻¹M = j_A⁻¹M` has sections `M(U)` at `(U,s)`
   and is left adjoint to the induced module direct image `j_A*`.
4. The presheaf `u_p L` at `U` is a colimit over triples `(V,t,φ : U → V)`, whose discrete part
   `(U,s,id)` is final; so it is `⨁_{s ∈ A(U)} L(U,s)` with the stated restrictions. Its module
   sheafification is `j_{A!}L`, and the sheafification universal property gives `j_{A!} ⊣ j_A^*`.
5. Kernels are sectionwise, so `j_A^*` preserves kernels and, as a left adjoint, cokernels.
   `j_{A!}` is right exact as a left adjoint; it preserves injections since a direct sum of
   injections is injective, abelian sheafification is exact, and the forgetful functor from module
   sheaves is faithful and preserves kernels (sites-modules.tex 03DJ).
6. For `B ⟶ A`, objects of the iterated element site are `(U,s,b)` with `b ↦ s`, that is `(U,b)`;
   arrows and coverings agree, `R × A` restricts to `R × B`, and the composite restriction evaluates
   at `(U,b)` as `M(U)`, so it is canonically `j_B^*` (sites-modules.tex 04J4). -/
theorem ringed_sheaf_slice_adjunction
    {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{u}) (A : Sheaf J (Type u)) :
    Nonempty (RingedSheafSliceAdjunctionData R A) := by
  sorry

end CategoryTheory
end
