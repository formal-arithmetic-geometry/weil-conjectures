module

public import Mathlib.CategoryTheory.Sites.LocallyBijective

/-!
# Local bijections and set sheafification in a larger universe

Source: Stacks Project, Sites, Tags 00WK and 00WM
(blueprint: lem-weil-pbc-large-set-sheafification).
-/

@[expose] public section

universe u v w

open CategoryTheory CategoryTheory.Limits Opposite

namespace CategoryTheory

set_option backward.isDefEq.respectTransparency false

private theorem largeSetUnit_locallyInjective
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    (P : Cᵒᵖ ⥤ Type (max u v w)) :
    Presheaf.IsLocallyInjective J (toSheafify J P) := by
  have hplus (Q : Cᵒᵖ ⥤ Type (max u v w)) :
      Presheaf.IsLocallyInjective J (J.toPlus Q) := by
    constructor
    intro X x y h
    rw [GrothendieckTopology.Plus.toPlus_eq_mk,
      GrothendieckTopology.Plus.toPlus_eq_mk,
      GrothendieckTopology.Plus.eq_mk_iff_exists] at h
    obtain ⟨W, h₁, h₂, eq⟩ := h
    exact J.superset_covering
      (fun Y f hf ↦ congr_fun (congr_arg Subtype.val eq) ⟨Y, f, hf⟩) W.2
  let := hplus P
  let := hplus (J.plusObj P)
  have : Presheaf.IsLocallyInjective J (J.toSheafify P) := by
    dsimp [GrothendieckTopology.toSheafify]
    rw [GrothendieckTopology.plusMap_toPlus]
    infer_instance
  rw [← toSheafify_plusPlusIsoSheafify_hom]
  infer_instance

private theorem largeSetUnit_locallySurjective
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    (P : Cᵒᵖ ⥤ Type (max u v w)) :
    Presheaf.IsLocallySurjective J (toSheafify J P) := by
  let G := sheafify J P
  let η := toSheafify J P
  have hG : Presheaf.IsSheaf J G := (presheafToSheaf J (Type (max u v w))).obj P |>.property
  have hG' := (isSheaf_iff_isSheaf_of_type J G).mp hG
  let R := (Subfunctor.range η).sheafify J
  have hR : Presheaf.IsSheaf J R.toFunctor :=
    (isSheaf_iff_isSheaf_of_type J R.toFunctor).mpr
      ((Subfunctor.range η).sheafify_isSheaf hG')
  let l := sheafifyLift J (Subfunctor.toRangeSheafify J η) hR
  have hl : l ≫ R.ι = 𝟙 G := by
    apply sheafify_hom_ext J _ _ hG
    dsimp [l]
    rw [← Category.assoc, toSheafify_sheafifyLift]
    simp [Subfunctor.toRangeSheafify, R, η, G]
  rw [Presheaf.isLocallySurjective_iff_range_sheafify_eq_top']
  apply le_antisymm le_top
  intro U s _
  have e : (l.app U s).val = s := by
    have := congrArg (fun t ↦ t.app U s) hl
    simpa [G] using this
  exact e ▸ (l.app U s).property

/-- Set sheafification detects local bijections when the value universe is larger than the site.
Source: Stacks Project, Sites, Tags 00WK and 00WM
(blueprint: lem-weil-pbc-large-set-sheafification).
Proof: equality in one plus construction is witnessed on a common covering refinement.
Thus its unit is locally injective; applying plus twice and comparing the resulting
adjunction with the chosen sheafification gives local injectivity of that unit.
For local surjectivity, form the subsheaf locally generated by the unit's image.
The universal property of sheafification factors its identity through that subsheaf,
so the subsheaf is the whole target. The unit is therefore locally surjective.
Use the unit factorization of sheafified morphisms and the local-bijection criterion
for morphisms of set sheaves to obtain the assertion. -/
theorem largeSetSheafification_locallyBijective
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) :
    J.WEqualsLocallyBijective (Type (max u v w)) := by
  let (P : Cᵒᵖ ⥤ Type (max u v w)) :
      Presheaf.IsLocallyInjective J (toSheafify J P) := largeSetUnit_locallyInjective J P
  let (P : Cᵒᵖ ⥤ Type (max u v w)) :
      Presheaf.IsLocallySurjective J (toSheafify J P) := largeSetUnit_locallySurjective J P
  exact GrothendieckTopology.WEqualsLocallyBijective.mk' J (Type (max u v w))

end CategoryTheory
