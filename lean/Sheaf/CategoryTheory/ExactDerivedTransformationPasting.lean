module

public import WeilConjectures.Mathlib.Algebra.Homology.DerivedCategory.ExactFunctor
public import Mathlib.CategoryTheory.Limits.ExactFunctor
public import Sheaf.CategoryTheory.ExactDerivedComposition
import Mathlib.CategoryTheory.Localization.Predicate

/-! # Pasting arbitrary cells of exact derived functors

Source: Stacks Project, Tags 015F and 04VG, and the natural-transformation enhancement of
localization in `Mathlib.CategoryTheory.Localization.Predicate`.
(blueprint: lem-sp-exact-derived-transformation-pasting)

Words are finite parenthesized composites, including empty words. Expressions record
finite pasting, with no invertibility restriction on their generating cells. A specified
ordinary compositor is included as a cell, in either direction.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe t u v w

open CategoryTheory Limits

namespace CategoryTheory.ExactDerivedPasting

variable {I : Type t} (C : I → Type u) [∀ i, Category.{v} (C i)]
  [∀ i, Abelian (C i)] [∀ i, HasDerivedCategory.{w} (C i)]

/-- Finite words of exact edges, with an empty word at each vertex.
Source: the word construction in the proof, Tags 015F and 04VG.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
inductive Word : I → I → Type (max t u v)
  | nil (i : I) : Word i i
  | edge {i j : I} (F : C i ⥤ₑ C j) : Word i j
  | comp {i j k : I} (P : Word i j) (R : Word j k) : Word i k

/-- The ordinary composite of a word, retaining its exactness.
Source: Tags 015F and 04VG, proof step 2.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
def Word.ordinary {i j : I} : Word C i j → (C i ⥤ₑ C j)
  | .nil i => ExactFunctor.of (𝟭 (C i))
  | .edge F => F
  | .comp P R => ⟨P.ordinary.obj ⋙ R.ordinary.obj,
      comp_preservesFiniteLimits P.ordinary.obj R.ordinary.obj,
      comp_preservesFiniteColimits P.ordinary.obj R.ordinary.obj⟩

/-- Exact word functors are additive by the existing exact-to-additive inclusion.
Source: Tag 015F; Mathlib `exactFunctor_le_additiveFunctor`.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
instance Word.ordinary_additive {i j : I} (P : Word C i j) : P.ordinary.obj.Additive :=
  exactFunctor_le_additiveFunctor (C i) (C j) _ P.ordinary.property

/-- A word interpreted as the composite of its exact derived edges.
Source: Tag 015F, proof step 2.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
def Word.derived {i j : I} : Word C i j → (DerivedCategory (C i) ⥤ DerivedCategory (C j))
  | .nil i => 𝟭 (DerivedCategory (C i))
  | .edge F => (Word.edge F).ordinary.obj.mapDerivedCategory
  | .comp P R => P.derived ⋙ R.derived

/-- The normalized comparison from the single derived composite to the derived word.
Composition uses precisely `mapDerivedCategoryCompIso`, in the direction fixed by
`existsUnique_mapDerivedCategoryCompIso`; the empty word uses the canonical unit comparison.
Source: Tags 015F and 04VG, proof steps 2 and 7.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
def Word.comparison {i j : I} (P : Word C i j) :
    P.ordinary.obj.mapDerivedCategory ≅ P.derived :=
  match P with
  | .nil i => Functor.mapDerivedCategoryIdIso (C i)
  | .edge _ => Iso.refl _
  | .comp P R =>
      Functor.mapDerivedCategoryCompIso P.ordinary.obj R.ordinary.obj ≪≫
        Functor.isoWhiskerRight P.comparison R.ordinary.obj.mapDerivedCategory ≪≫
        Functor.isoWhiskerLeft P.derived R.comparison

/-- Localize the degreewise transformation, then conjugate by the normalized word comparisons.
For two-edge words this is inverse source compositor, localized cell, forward target compositor.
Source: Tag 04VG with `Localization.liftNatTrans`, proof step 3.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
def Word.cell {i j : I} {P R : Word C i j} (α : P.ordinary.obj ⟶ R.ordinary.obj) :
    P.derived ⟶ R.derived :=
  P.comparison.inv ≫
    Localization.liftNatTrans DerivedCategory.Q
      (HomologicalComplex.quasiIso (C i) (ComplexShape.up ℤ))
      (P.ordinary.obj.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
      (R.ordinary.obj.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
      P.ordinary.obj.mapDerivedCategory R.ordinary.obj.mapDerivedCategory
      (Functor.whiskerRight (NatTrans.mapHomologicalComplex α (ComplexShape.up ℤ))
        DerivedCategory.Q) ≫ R.comparison.hom

/-- Finite pasting expressions generated by ordinary cells, identities, vertical composition,
input and output whiskering, and the structural associators and unitors in either direction.
Specified ordinary compositor isomorphisms are also allowed as generating cells.
Source: Tags 015F and 04VG, proof step 8.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
inductive Expression : {i j : I} → Word C i j → Word C i j → Type (max t u v)
  | cell {i j : I} {P R : Word C i j} (α : P.ordinary.obj ⟶ R.ordinary.obj) : Expression P R
  | id {i j : I} (P : Word C i j) : Expression P P
  | vcomp {i j : I} {P R S : Word C i j}
      (e : Expression P R) (f : Expression R S) : Expression P S
  | input {i j k : I} (U : Word C i j) {P R : Word C j k}
      (e : Expression P R) : Expression (.comp U P) (.comp U R)
  | output {i j k : I} {P R : Word C i j} (e : Expression P R)
      (V : Word C j k) : Expression (.comp P V) (.comp R V)
  | assoc {i j k l : I} (P : Word C i j) (R : Word C j k) (S : Word C k l) :
      Expression (.comp (.comp P R) S) (.comp P (.comp R S))
  | assocInv {i j k l : I} (P : Word C i j) (R : Word C j k) (S : Word C k l) :
      Expression (.comp P (.comp R S)) (.comp (.comp P R) S)
  | leftUnit {i j : I} (P : Word C i j) : Expression (.comp (.nil i) P) P
  | leftUnitInv {i j : I} (P : Word C i j) : Expression P (.comp (.nil i) P)
  | rightUnit {i j : I} (P : Word C i j) : Expression (.comp P (.nil j)) P
  | rightUnitInv {i j : I} (P : Word C i j) : Expression P (.comp P (.nil j))

/-- Evaluate an expression in the ordinary categories.
Source: Tag 04VG, proof steps 1 and 8.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
def Expression.ordinary {i j : I} {P R : Word C i j} :
    Expression C P R → (P.ordinary.obj ⟶ R.ordinary.obj)
  | .cell α => α
  | .id _ => 𝟙 _
  | .vcomp e f => e.ordinary ≫ f.ordinary
  | .input U e => Functor.whiskerLeft U.ordinary.obj e.ordinary
  | .output e V => Functor.whiskerRight e.ordinary V.ordinary.obj
  | .assoc P R S => (Functor.associator P.ordinary.obj R.ordinary.obj S.ordinary.obj).hom
  | .assocInv P R S => (Functor.associator P.ordinary.obj R.ordinary.obj S.ordinary.obj).inv
  | .leftUnit P => (Functor.leftUnitor P.ordinary.obj).hom
  | .leftUnitInv P => (Functor.leftUnitor P.ordinary.obj).inv
  | .rightUnit P => (Functor.rightUnitor P.ordinary.obj).hom
  | .rightUnitInv P => (Functor.rightUnitor P.ordinary.obj).inv

/-- Evaluate a pasting expression using the prescribed derived cells and derived whiskerings.
Source: Tags 015F and 04VG, proof steps 3--8.
(blueprint: lem-sp-exact-derived-transformation-pasting) -/
def Expression.derived {i j : I} {P R : Word C i j} :
    Expression C P R → (P.derived ⟶ R.derived)
  | .cell α => Word.cell C α
  | .id _ => 𝟙 _
  | .vcomp e f => e.derived ≫ f.derived
  | .input U e => Functor.whiskerLeft U.derived e.derived
  | .output e V => Functor.whiskerRight e.derived V.derived
  | .assoc P R S => (Functor.associator P.derived R.derived S.derived).hom
  | .assocInv P R S => (Functor.associator P.derived R.derived S.derived).inv
  | .leftUnit P => (Functor.leftUnitor P.derived).hom
  | .leftUnitInv P => (Functor.leftUnitor P.derived).inv
  | .rightUnit P => (Functor.rightUnitor P.derived).hom
  | .rightUnitInv P => (Functor.rightUnitor P.derived).inv

/-- Exact derived localization preserves every finite pasting equation, including square
pasting in both orientations, naturality and unit equations. Invertible ordinary cells
give invertible derived cells. No boundedness or resolution is used.

Source: Stacks Tags 015F and 04VG and the natural-transformation localization enhancement.
(blueprint: lem-sp-exact-derived-transformation-pasting)

Proof: (1) Apply cells degreewise; naturality at differentials makes complex morphisms, and
degreewise evaluation preserves identities, vertical composition and both whiskerings.
(2) Exactness inverts quasi-isomorphisms. Compose the exact factorization isomorphisms along
each word; the empty word has the identity factorization. The unique normalized compositor
of lem-sfb-exact-derived-composition identifies these with the comparisons above.
(3) Use lem-weil-pbc-localization-universal-property to lift each degreewise cell uniquely.
Its component at Q(K), followed by the target factorization, is Q(C(α)_K) preceded by the
source factorization. Conjugation by the source and target comparisons gives exactly this.
(4) This normalization preserves identities and vertical composition by cancellation of
the intermediate factorization isomorphism, followed by Localization.natTrans_ext.
(5) For output whiskering use naturality of the output word's factorization at C(α)_K.
(6) For input whiskering use naturality of the lifted cell at the input word's factorization,
an actual derived morphism; no lifting of that morphism to a complex morphism is assumed.
(7) Iterated comparisons have the same normalization by induction on words; uniqueness
identifies localized structural associators and unitors with those of the derived word
functors and proves both unit comparison equations, including the empty word.
(8) Induction on expressions now identifies their derived evaluation with the normalized
lift of their ordinary evaluation. Equal ordinary evaluations give equal derived evaluations.
Horizontal square pasting is the two whiskerings followed by vertical composition.
(9) Lift an inverse ordinary cell too. Step (4) turns its two inverse equations into the
derived inverse equations. This proves invertibility without cancelling any noninvertible cell.
-/
theorem exact_derived_transformation_pasting [Finite I] :
    (∀ {i j : I} {P R : Word C i j} (e : Expression C P R),
      e.derived = Word.cell C e.ordinary) ∧
    (∀ {i j : I} {P R : Word C i j} (e f : Expression C P R),
      e.ordinary = f.ordinary → e.derived = f.derived) ∧
    (∀ {i j : I} {P R : Word C i j} (α : P.ordinary.obj ⟶ R.ordinary.obj),
      IsIso α → IsIso (Word.cell C α)) := by
  sorry

end CategoryTheory.ExactDerivedPasting
