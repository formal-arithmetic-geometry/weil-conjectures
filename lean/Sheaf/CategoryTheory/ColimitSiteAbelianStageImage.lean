module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Pullback
public import Mathlib.CategoryTheory.Comma.Over.Basic
public import Mathlib.Algebra.Category.Grp.Limits
public import Mathlib.Algebra.Category.Grp.Colimits
public import Mathlib.Algebra.Category.Grp.FilteredColimits

/-! # The subpresheaf generated by stage images

Source: Stacks Project, Sites, Tag 0A35, and Modules on Sites, Tag 03CO.
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.Functor.sheafPullbackConstruction
namespace CategoryTheory

noncomputable section

namespace ColimitSiteStageImage

variable {J : Type u} [SmallCategory J] (F : J ⥤ Cat.{u, u})
    (P : ∀ j : J, Precoverage (F.obj j))
    [∀ (j k : J) (a : j ⟶ k),
      (F.map a).toFunctor.IsContinuous (P j).toGrothendieck (P k).toGrothendieck]
    (V : Cocone F) (Q : Precoverage V.pt)
    [∀ j : J, (V.ι.app j).toFunctor.IsContinuous
      (P j).toGrothendieck Q.toGrothendieck]
    (i : J) (G : Sheaf (P i).toGrothendieck AddCommGrpCat.{u})
    (α : ∀ t : Under i,
      (sheafPullback (F.map t.hom).toFunctor AddCommGrpCat.{u}
        (P i).toGrothendieck (P t.right).toGrothendieck).obj G ⟶
      ((V.ι.app t.right).toFunctor.sheafPushforwardContinuous AddCommGrpCat.{u}
        (P t.right).toGrothendieck Q.toGrothendieck).obj
        ((sheafPullback (V.ι.app i).toFunctor AddCommGrpCat.{u}
          (P i).toGrothendieck Q.toGrothendieck).obj G))

/-- The canonical inverse image whose stage images are being compared. -/
abbrev target :=
  (sheafPullback (V.ι.app i).toFunctor AddCommGrpCat.{u}
    (P i).toGrothendieck Q.toGrothendieck).obj G

/-- Restrictions of individual stage images; the restricting arrow is part of the data. -/
def generators (Y : V.ptᵒᵖ) : Set ((target F P V Q i G).obj.obj Y) :=
  {x | ∃ (t : Under i) (W : F.obj t.right)
    (r : Y.unop ⟶ (V.ι.app t.right).toFunctor.obj W)
    (y : ((sheafPullback (F.map t.hom).toFunctor AddCommGrpCat.{u}
      (P i).toGrothendieck (P t.right).toGrothendieck).obj G).obj.obj (op W)),
    (target F P V Q i G).obj.map r.op ((α t).hom.app (op W) y) = x}

/-- Finite additive combinations of restrictions of stage images. -/
def subgroup (Y : V.ptᵒᵖ) : AddSubgroup ((target F P V Q i G).obj.obj Y) :=
  AddSubgroup.closure (generators F P V Q i G α Y)

omit [∀ (j k : J) (a : j ⟶ k),
  (F.map a).toFunctor.IsContinuous (P j).toGrothendieck (P k).toGrothendieck] in
/-- Restriction preserves the generated subgroup, by precomposing its generators. -/
theorem map_mem {Y Z : V.ptᵒᵖ} (f : Y ⟶ Z)
    {x : (target F P V Q i G).obj.obj Y}
    (hx : x ∈ subgroup F P V Q i G α Y) :
    (target F P V Q i G).obj.map f x ∈ subgroup F P V Q i G α Z := by
  have hle : subgroup F P V Q i G α Y ≤
      (subgroup F P V Q i G α Z).comap
        ((target F P V Q i G).obj.map f).hom := by
    apply (AddSubgroup.closure_le _).2
    rintro x ⟨t, W, r, y, rfl⟩
    apply AddSubgroup.subset_closure
    refine ⟨t, W, f.unop ≫ r, y, ?_⟩
    simp only [op_comp, Functor.map_comp, AddCommGrpCat.comp_apply, Quiver.Hom.op_unop]
  exact hle hx

/-- The explicitly constructed abelian subpresheaf generated by stage images. -/
def presheaf : V.ptᵒᵖ ⥤ AddCommGrpCat.{u} where
  obj Y := AddCommGrpCat.of (subgroup F P V Q i G α Y)
  map f := AddCommGrpCat.ofHom
    { toFun := fun x ↦ ⟨(target F P V Q i G).obj.map f x.val,
        map_mem F P V Q i G α f x.property⟩
      map_zero' := by apply Subtype.ext; exact map_zero _
      map_add' := by intro x y; apply Subtype.ext; exact map_add _ _ _ }
  map_id := by
    intro Y
    ext x
    change (target F P V Q i G).obj.map (𝟙 Y) x.val = x.val
    rw [Functor.map_id]
    rfl
  map_comp := by
    intro Y Z W f g
    ext x
    change (target F P V Q i G).obj.map (f ≫ g) x.val =
      (target F P V Q i G).obj.map g ((target F P V Q i G).obj.map f x.val)
    rw [Functor.map_comp]
    rfl

/-- Inclusion of the generated subpresheaf into the inverse image. -/
def inclusion : presheaf F P V Q i G α ⟶ (target F P V Q i G).obj where
  app Y := AddCommGrpCat.ofHom (subgroup F P V Q i G α Y).subtype
  naturality := by intros; rfl

end ColimitSiteStageImage

end

end CategoryTheory
