module

public import Mathlib.Algebra.Category.Ring.Limits
public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Sheaf quotient by an ideal of a ring acting through global sections

Source: Alper, Adequate moduli spaces, Lemma 5.2.1, printed p.507;
Stacks Project, Modules on Sites, quotient sheaves
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).

The sectionwise image-generated quotient is sheafified. In particular, sections of the
quotient sheaf are not defined to be the quotient of sections of the original sheaf.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe c v r p

open CategoryTheory CategoryTheory.Limits Opposite

namespace CategoryTheory

/-- Compatible section families of commutative rings have pointwise commutative multiplication.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
instance globalBaseIdealSectionRingCommRing {C : Type c} [Category.{v} C]
    {J : GrothendieckTopology C} (A : Sheaf J CommRingCat.{r}) :
    CommRing (RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat)) :=
  @Subring.toCommRing (∀ x : Cᵒᵖ, A.obj.obj x) _
    (RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat))

/-- Ring sheafification exists in an ambient universe containing objects and arrows.
Source: Stacks Project, Modules on Sites, quotient sheaves
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: take the two plus constructions. Compatible families and their equivalence
classes stay in the stated ambient universe. Filtered colimits of rings commute with
the finite limits used by the sheaf condition, so this gives the sheafification adjunction. -/
theorem globalBaseIdealHasSheafify {C : Type c} [Category.{v} C]
    (J : GrothendieckTopology C) : HasWeakSheafify J CommRingCat.{max c v r} := by
  sorry

variable {C : Type c} [Category.{v} C] {J : GrothendieckTopology C}
    (A : Sheaf J CommRingCat.{max c v r}) {P : Type p} [CommRing P]
    (ρ : P →+* RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat))
    (I : Ideal P)

/-- Evaluation of the specified action on global sections at one site object.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealEvaluation (x : Cᵒᵖ) : P →+* A.obj.obj x :=
  ((Pi.evalRingHom (fun y : Cᵒᵖ ↦ A.obj.obj y) x).comp
    (RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat)).subtype).comp ρ

/-- The sectionwise ideal generated by the structural image of I.
Its local saturation is imposed by sheafification of its quotient.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealSections (x : Cᵒᵖ) : Ideal (A.obj.obj x) :=
  I.map (globalBaseIdealEvaluation.{c, v, r, p} A ρ x)

/-- Restriction preserves the sectionwise generated ideals.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: a structural generator restricts to the same structural generator because ρ(a)
is a compatible global family. Ideal closure extends this to every element. -/
theorem globalBaseIdealSections_restriction {x y : Cᵒᵖ} (f : x ⟶ y) :
    globalBaseIdealSections.{c, v, r, p} A ρ I x ≤
      (globalBaseIdealSections.{c, v, r, p} A ρ I y).comap (A.obj.map f).hom := by
  sorry

/-- Restriction on sectionwise quotient rings.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealQuotientRestriction {x y : Cᵒᵖ} (f : x ⟶ y) :
    (A.obj.obj x ⧸ globalBaseIdealSections.{c, v, r, p} A ρ I x) →+*
      (A.obj.obj y ⧸ globalBaseIdealSections.{c, v, r, p} A ρ I y) :=
  Ideal.quotientMap (globalBaseIdealSections.{c, v, r, p} A ρ I y) (A.obj.map f).hom
    (globalBaseIdealSections_restriction.{c, v, r, p} A ρ I f)

/-- Quotient restrictions preserve identity maps.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: on every quotient representative this is the identity law of A. -/
theorem globalBaseIdealQuotientRestriction_id (x : Cᵒᵖ) :
    globalBaseIdealQuotientRestriction.{c, v, r, p} A ρ I (𝟙 x) = RingHom.id _ := by
  sorry

/-- Quotient restrictions preserve composites.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: on quotient representatives both sides are the restriction along f followed by g;
the composition law of A identifies them. -/
theorem globalBaseIdealQuotientRestriction_comp {x y z : Cᵒᵖ}
    (f : x ⟶ y) (g : y ⟶ z) :
    globalBaseIdealQuotientRestriction.{c, v, r, p} A ρ I (f ≫ g) =
      (globalBaseIdealQuotientRestriction.{c, v, r, p} A ρ I g).comp
        (globalBaseIdealQuotientRestriction.{c, v, r, p} A ρ I f) := by
  sorry

/-- The actual sectionwise quotient presheaf, before sheafification.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealQuotientPresheaf : Cᵒᵖ ⥤ CommRingCat.{max c v r} where
  obj x := .of (A.obj.obj x ⧸ globalBaseIdealSections.{c, v, r, p} A ρ I x)
  map f := CommRingCat.ofHom (globalBaseIdealQuotientRestriction.{c, v, r, p} A ρ I f)
  map_id x := congrArg CommRingCat.ofHom
    (globalBaseIdealQuotientRestriction_id.{c, v, r, p} A ρ I x)
  map_comp f g := congrArg CommRingCat.ofHom
    (globalBaseIdealQuotientRestriction_comp.{c, v, r, p} A ρ I f g)

/-- Quotient projections commute with restriction.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: both composites send a section to the class of its restriction. -/
theorem globalBaseIdealQuotientProjection_naturality {x y : Cᵒᵖ} (f : x ⟶ y) :
    A.obj.map f ≫ CommRingCat.ofHom
      (Ideal.Quotient.mk (globalBaseIdealSections.{c, v, r, p} A ρ I y)) =
      CommRingCat.ofHom (Ideal.Quotient.mk (globalBaseIdealSections.{c, v, r, p} A ρ I x)) ≫
        (globalBaseIdealQuotientPresheaf.{c, v, r, p} A ρ I).map f := by
  sorry

/-- The presheaf quotient projection.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealQuotientPresheafProjection :
    A.obj ⟶ globalBaseIdealQuotientPresheaf.{c, v, r, p} A ρ I where
  app x := CommRingCat.ofHom (Ideal.Quotient.mk (globalBaseIdealSections.{c, v, r, p} A ρ I x))
  naturality _ _ f := globalBaseIdealQuotientProjection_naturality.{c, v, r, p} A ρ I f

/-- The quotient sheaf A/IA, obtained by ring sheafification of the generated relations.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealSheafQuotient : Sheaf J CommRingCat.{max c v r} :=
  letI := globalBaseIdealHasSheafify.{c, v, r} J
  (presheafToSheaf J CommRingCat.{max c v r}).obj
    (globalBaseIdealQuotientPresheaf.{c, v, r, p} A ρ I)

/-- The canonical ring-sheaf quotient projection.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealSheafProjection : A ⟶ globalBaseIdealSheafQuotient.{c, v, r, p} A ρ I :=
  letI := globalBaseIdealHasSheafify.{c, v, r} J
  ⟨globalBaseIdealQuotientPresheafProjection.{c, v, r, p} A ρ I ≫
    toSheafify J (globalBaseIdealQuotientPresheaf.{c, v, r, p} A ρ I)⟩

/-- The quotient projection sends a compatible family to a compatible family.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: naturality of the quotient projection and compatibility of s show that its
componentwise images commute with every restriction. -/
theorem globalBaseIdealSheafProjection_compatible
    (s : RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat)) :
    (fun x ↦ (globalBaseIdealSheafProjection.{c, v, r, p} A ρ I).hom.app x (s.val x)) ∈
      RingCat.sectionsSubring
        ((globalBaseIdealSheafQuotient.{c, v, r, p} A ρ I).obj ⋙ forget₂ CommRingCat RingCat) := by
  sorry

/-- The induced ring homomorphism on global sections, with componentwise quotient values.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealSheafSectionsMap :
    RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat) →+*
      RingCat.sectionsSubring
        ((globalBaseIdealSheafQuotient.{c, v, r, p} A ρ I).obj ⋙ forget₂ CommRingCat RingCat) where
  toFun s := ⟨_, globalBaseIdealSheafProjection_compatible.{c, v, r, p} A ρ I s⟩
  map_one' := Subtype.ext (funext (fun x ↦ map_one
    ((globalBaseIdealSheafProjection.{c, v, r, p} A ρ I).hom.app x).hom))
  map_mul' s t := Subtype.ext (funext (fun x ↦ map_mul
    ((globalBaseIdealSheafProjection.{c, v, r, p} A ρ I).hom.app x).hom (s.val x) (t.val x)))
  map_zero' := Subtype.ext (funext (fun x ↦ map_zero
    ((globalBaseIdealSheafProjection.{c, v, r, p} A ρ I).hom.app x).hom))
  map_add' s t := Subtype.ext (funext (fun x ↦ map_add
    ((globalBaseIdealSheafProjection.{c, v, r, p} A ρ I).hom.app x).hom (s.val x) (t.val x)))

/-- The global quotient projection kills the image-generated ideal IG.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient).
Proof: each structural generator from I has zero quotient class at every site object.
The sheafification unit preserves zero. The induced homomorphism therefore kills the
ideal generated by those global generators. -/
theorem globalBaseIdealSheafSectionsMap_kills
    (s : RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat))
    (hs : s ∈ I.map ρ) : globalBaseIdealSheafSectionsMap.{c, v, r, p} A ρ I s = 0 := by
  sorry

/-- The canonical comparison Γ(A)/IΓ(A) → Γ(A/IA), induced by the specified projection.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
def globalBaseIdealSheafComparison :
    (RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat) ⧸ I.map ρ) →+*
      RingCat.sectionsSubring
        ((globalBaseIdealSheafQuotient.{c, v, r, p} A ρ I).obj ⋙ forget₂ CommRingCat RingCat) :=
  Ideal.Quotient.lift (I.map ρ) (globalBaseIdealSheafSectionsMap.{c, v, r, p} A ρ I)
    (globalBaseIdealSheafSectionsMap_kills.{c, v, r, p} A ρ I)

/-- The target of the canonical comparison carries its specified source-algebra structure.
Source: Alper, Lemma 5.2.1
(blueprint: def-sfb-global-base-ideal-sheaf-quotient). -/
instance globalBaseIdealSheafComparisonAlgebra :
    Algebra (RingCat.sectionsSubring (A.obj ⋙ forget₂ CommRingCat RingCat) ⧸ I.map ρ)
      (RingCat.sectionsSubring
        ((globalBaseIdealSheafQuotient.{c, v, r, p} A ρ I).obj ⋙ forget₂ CommRingCat RingCat)) :=
  (globalBaseIdealSheafComparison.{c, v, r, p} A ρ I).toAlgebra

end CategoryTheory
