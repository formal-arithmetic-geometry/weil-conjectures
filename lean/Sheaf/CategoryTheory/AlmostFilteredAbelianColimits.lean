module

public import Mathlib.Algebra.Category.Grp.AB
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.CategoryTheory.Limits.HasLimits
import Mathlib.CategoryTheory.Limits.FilteredColimitCommutesFiniteLimit

/-!
# Exact abelian colimits over almost filtered categories

Source: Stacks Project, Algebra, Tag 04B0 (lemma-almost-directed-colimit-exact),
with the hypotheses of Categories Tag 002X (lemma-split-into-directed) expanded
(blueprint: lem-sfb-almost-filtered-abelian-colimits).
-/

@[expose] public section

set_option autoImplicit false

universe u w

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory

/-- Colimits of abelian groups over an almost filtered category are additive and exact,
including for empty and disconnected index categories.

Source: Stacks Project, Algebra, Tag 04B0, with Categories Tag 002X expanded;
additivity follows from the colimit universal property
(blueprint: lem-sfb-almost-filtered-abelian-colimits).

Proof:
1. For each diagram form the direct sum of its object groups and quotient by the
   subgroup generated by the differences between an element and its image under
   each diagram arrow. A compatible family of maps kills these generators and
   factors uniquely through the quotient. This gives the colimit universal
   property [def-weil-pbc-category-colimit]. For empty I the direct sum is zero.
2. Testing on every coprojection shows that the maps induced by the sum of two
   natural transformations equal the sum of the induced maps. The same test
   proves preservation of zero morphisms, so the colimit functor is additive.
3. Apply [lem-sfb-almost-filtered-components] to the two arrow conditions. This
   partitions I into small nonempty filtered full subcategories with no arrows
   between different parts. For empty I the family of parts is empty.
4. A cocone on I is precisely a family of cocones on these parts. The universal
   properties therefore identify the colimit with the direct sum of the part
   colimits. Testing on coprojections makes this identification natural in the
   diagram and compatible with all sequence maps.
5. On each part, [lem-weil-pbc-filtered-colimits-commute-finite-limits] gives
   preservation of zero, binary products and equalizers. These limits of
   diagrams are computed pointwise, and restriction to each part preserves them.
6. Direct sums preserve zero. Pairing coordinates commutes with binary products
   because the union of two finite supports is finite. Equalizer membership is
   coordinatewise, so direct sums also commute with equalizers. Every finite
   limit is an equalizer of two maps between finite products. Thus the whole
   colimit functor preserves finite limits, including the empty limiting diagram.
7. Apply [lem-weil-pbc-filtered-colimit-abelian-groups-exact] to the three positions
   of each restricted short exact sequence, inserting zero groups at the ends.
   Direct sums preserve injectivity coordinatewise; middle exactness and
   surjectivity follow by choosing preimages on the finite support of a tuple.
   The natural identification in step 4 gives exactly the asserted colimit maps.
   For empty I every resulting group is zero. -/
theorem almostFiltered_abelian_colimits_exact
    (I : Type u) [SmallCategory I]
    (hspan : ∀ {v x y : I} (a : v ⟶ x) (b : v ⟶ y),
      ∃ (z : I) (c : x ⟶ z) (d : y ⟶ z), a ≫ c = b ≫ d)
    (hparallel : ∀ {x y : I} (a b : x ⟶ y),
      ∃ (z : I) (c : y ⟶ z), a ≫ c = b ≫ c) :
    HasColimitsOfShape I AddCommGrpCat.{max u w} ∧
      (colim (J := I) (C := AddCommGrpCat.{max u w})).Additive ∧
      PreservesFiniteLimits (colim (J := I) (C := AddCommGrpCat.{max u w})) ∧
      (∀ S : ShortComplex (I ⥤ AddCommGrpCat.{max u w}),
        (∀ i : I, (S.map ((evaluation I AddCommGrpCat.{max u w}).obj i)).ShortExact) →
        (S.map (colim (J := I) (C := AddCommGrpCat.{max u w}))).ShortExact) ∧
      (IsEmpty I → ∀ F : I ⥤ AddCommGrpCat.{max u w}, IsZero (colimit F)) := by
  sorry

end CategoryTheory
