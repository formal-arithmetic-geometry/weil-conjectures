/-!
# Covering refinements of epimorphic sheafified arrow families

Source: Stacks Project, `sites.tex`, Tag 0D06, `lemma-quasi-compact`, reverse proof
(blueprint: lem-trf-site-sheafified-arrows-cover-refinement).
-/

@[expose] public section

set_option autoImplicit false

universe u v w

open Opposite CategoryTheory.Limits

namespace CategoryTheory

/-- An actual cover inside a generated covering sieve.
Source: Stacks, Sites, Definition 00VH. Induct on the generated topology,
using covering pullbacks and bind composition. -/
private theorem covering_refinement {C : Type u} [Category.{v} C]
    (J : Precoverage C) (hJ : J.IsSiteForCoverings) {U : C} {S : Sieve U}
    (hS : S ∈ J.toGrothendieck U) : ∃ T ∈ J U, T ≤ S.arrows := by
  classical
  have : J.HasIsos := hJ.1
  induction hS with
  | of X R hR => exact ⟨R, hR, Sieve.le_generate R⟩
  | top X =>
    exact ⟨Presieve.singleton (𝟙 X), J.mem_coverings_of_isIso (𝟙 X), by simp⟩
  | pullback X S hS Y f ih =>
    obtain ⟨R, hR, hle⟩ := ih
    let I := Σ Z : C, {a : Z ⟶ X // R a}
    let V : I → C := fun i ↦ i.1
    let a : ∀ i : I, V i ⟶ X := fun i ↦ i.2.1
    have heq : Presieve.ofArrows V a = R := by
      funext Z b
      apply propext
      constructor
      · rintro ⟨i⟩
        exact i.2.2
      · intro hb
        exact Presieve.ofArrows.mk (Y := V) (f := a) ⟨Z, b, hb⟩
    obtain ⟨P, p, q, hpq, hp⟩ := hJ.2.2 I X V a (heq ▸ hR) Y f
    refine ⟨Presieve.ofArrows P p, hp, ?_⟩
    rintro Z b ⟨i⟩
    change S (p i ≫ f)
    rw [(hpq i).w]
    exact S.downward_closed (hle _ _ i.2.2) (q i)
  | transitive X S T hS hT ihS ihT =>
    obtain ⟨R, hR, hle⟩ := ihS
    have hh : ∀ (Y : C) (f : Y ⟶ X) (_ : R f),
        ∃ Q ∈ J Y, Q ≤ (T.pullback f).arrows := by
      intro Y f hf
      exact ihT (hle _ _ hf)
    choose Q hQ hQT using hh
    refine ⟨R.bind (fun {Y f} hf ↦ Q Y f hf),
      hJ.2.1 X R (fun {Y} f hf ↦ Q Y f hf) hR hQ, ?_⟩
    intro Z f hf
    obtain ⟨Y, g, a, ha, hg, rfl⟩ := hf
    exact hQT Y a ha _ _ hg



/-- An epimorphic family of sheafified site arrows has an actual covering refinement.
Source: Stacks Project, `sites.tex`, Tag 0D06, `lemma-quasi-compact`, reverse proof;
Tags 00WK and 00WB supply local representation and local equality
(blueprint: lem-trf-site-sheafified-arrows-cover-refinement).

The presheaf `uliftYoneda.obj T` is Hom(-,T), lifted into the common universe
`max u v w`. Applying `presheafToSheaf` gives H_T and applying its map to
`uliftYoneda.map (a i)` gives H(a_i). `Sigma.desc` is the induced map out of the
coproduct in sheaves. `Epi` is categorical right cancellation against every
sheaf in that same universe. The conclusion is an equality in C itself.
No subcanonicity, nonemptiness, or finiteness hypothesis is imposed.

Proof:
1. Let f be the coproduct map of the presheaf representables. The coproduct
   comparison equation factors the assumed epimorphism through sheafification(f),
   so sheafification(f) is epi. Mathlib's epi/local-surjectivity criterion for
   sheaves and reflection of local surjectivity by sheafification show that f is
   locally surjective. Transport to a small model handles the common universe.
2. Mathlib's criterion for a coproduct of representables says precisely that
   the sieve generated by the arrows a_i is covering for J.toGrothendieck.
3. Induct on the generated topology to extract an actual J-covering presieve
   R inside that sieve. The generating and maximal cases use a given cover and
   the identity cover; pullback uses covering pullbacks, and transitivity uses
   bind composition. No stronger precoverage composition instance is needed.
4. Index the arrows of R by their domains and their membership proofs, lifted
   into the common universe. Membership in the generated sieve supplies a label
   i and an actual factorization through a_i for each arrow. The resulting family
   presents exactly R, so is covering, and its triangles commute in C.
   This construction also applies to empty covers and empty indexing types.
-/
theorem sheafified_arrows_cover_refinement
    {C : Type u} [Category.{v} C]
    (J : Precoverage C) (_hJ : J.IsSiteForCoverings)
    (U : C) {I : Type w} (U_i : I → C) (a : ∀ i : I, U_i i ⟶ U)
    (hepi : Epi (Sigma.desc (fun i : I ↦
      (presheafToSheaf J.toGrothendieck (Type (max u v w))).map
        (uliftYoneda.{max u w}.map (a i))))) :
    ∃ (B : Type (max u v w)) (V : B → C) (b : ∀ k : B, V k ⟶ U)
      (α : B → I) (g : ∀ k : B, V k ⟶ U_i (α k)),
      Presieve.ofArrows V b ∈ J U ∧ ∀ k : B, g k ≫ a (α k) = b k := by
  classical
  have : EssentiallySmall.{max u v w} C := essentiallySmallSelf.{w} C
  have : ∀ X : Cᵒᵖ,
      HasLimitsOfShape (StructuredArrow X (equivSmallModel.{max u v w} C).inverse.op)
        (Type (max u v w)) := fun _ ↦ hasLimitsOfShape_of_essentiallySmall _ _
  have : J.toGrothendieck.WEqualsLocallyBijective (Type (max u v w)) :=
    GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall
      J.toGrothendieck (A := Type (max u v w))
  let H := presheafToSheaf J.toGrothendieck (Type (max u v w))
  let f := Sigma.desc (fun i : I ↦ uliftYoneda.{max u w}.map (a i))
  have : Epi (H.map f) :=
    epi_of_epi_fac (sigmaComparison_map_desc H
      (fun i : I ↦ uliftYoneda.{max u w}.obj (U_i i)) _
      (fun i : I ↦ uliftYoneda.{max u w}.map (a i)))
  have hlocal : Presheaf.IsLocallySurjective J.toGrothendieck f :=
    (Presheaf.isLocallySurjective_presheafToSheaf_map_iff J.toGrothendieck f).mp
      ((Sheaf.isLocallySurjective_iff_epi (H.map f)).mpr inferInstance)
  have hS : Sieve.ofArrows U_i a ∈ J.toGrothendieck U :=
    (GrothendieckTopology.ofArrows_mem_iff_isLocallySurjective_sigmaDesc_uliftYoneda_map
      J.toGrothendieck a).mpr hlocal
  obtain ⟨R, hR, hle⟩ := covering_refinement J _hJ hS
  let B := ULift.{w} (Σ V : C, {b : V ⟶ U // R b})
  let V : B → C := fun k ↦ k.down.1
  let b : ∀ k : B, V k ⟶ U := fun k ↦ k.down.2.1
  have hfac : ∀ k : B, ∃ i : I, ∃ g : V k ⟶ U_i i, g ≫ a i = b k := by
    intro k
    obtain ⟨W, g, c, ⟨i⟩, h⟩ := hle _ _ k.down.2.2
    exact ⟨i, g, h⟩
  choose α g hg using hfac
  refine ⟨B, V, b, α, g, ?_, hg⟩
  have heq : Presieve.ofArrows V b = R := by
    funext W c
    apply propext
    constructor
    · rintro ⟨k⟩
      exact k.down.2.2
    · intro hc
      exact Presieve.ofArrows.mk (Y := V) (f := b) (ULift.up ⟨W, c, hc⟩)
  rwa [heq]

end CategoryTheory
