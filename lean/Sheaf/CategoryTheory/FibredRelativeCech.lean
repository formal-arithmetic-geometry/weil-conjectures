module

public import Sheaf.AlgebraicGeometry.StablePointedModuliGroupoids
public import Sheaf.CategoryTheory.SiteCoveringAxioms
public import Mathlib.Algebra.Category.Grp.Limits
public import Mathlib.CategoryTheory.Pi.Basic
public import Mathlib.CategoryTheory.Functor.KanExtension.Adjunction
public import Mathlib.CategoryTheory.Preadditive.FunctorCategory
public import Mathlib.CategoryTheory.Sites.Limits
public import Mathlib.Algebra.Homology.Embedding.Extend

/-! # Relative Cech terms for fibred groupoids

Source: Stacks Project, Tags 06X3 and 06X7
(blueprint: def-sfb-fibred-relative-cech-complex).

Degree zero is the original source category. Higher degrees use common-target
iso-comma tuples. Right Kan extension is the compatible-family direct image.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u v w

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor Opposite

namespace CategoryTheory

/-- Big etale topology, generated by families whose base images are etale covers.
Source: Stacks, stacks-sheaves, 06X7
(blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredBigEtaleTopology {S : AlgebraicGeometry.Scheme.{u}}
    (X : BasedCategory.{v, max v w} (Over S)) : GrothendieckTopology X.obj :=
  (AlgebraicGeometry.Scheme.etalePrecoverage.comap
    (X.p ⋙ Over.forget S)).toGrothendieck

/-- Common-target tuples of length `n`, with all comparison arrows vertical and invertible.
Source: Stacks, Tag 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
abbrev FibredCechTuple {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) (n : ℕ) :=
  ObjectProperty.FullSubcategory
    (fun z : Comma (Functor.pi (fun _ : Fin n ↦ f.toFunctor))
      (Functor.pi' (fun _ : Fin n ↦ 𝟭 X.obj)) ↦
        ∀ i : Fin n, IsIso (z.hom i) ∧
          X.p.IsHomLift (𝟙 (U.p.obj (z.left i))) (z.hom i))

/-- Projection of tuples to their common target.
Source: Stacks, Tag 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechTupleProjection {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) (n : ℕ) :
    FibredCechTuple f n ⥤ X.obj :=
  ObjectProperty.ι _ ⋙ Comma.snd _ _

/-- Reindexing tuples, including omission of an entry.
Source: Stacks, Tag 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechTupleReindex {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    {m n : ℕ} (a : Fin m → Fin n) : FibredCechTuple f n ⥤ FibredCechTuple f m where
  obj z := ⟨⟨(fun i ↦ z.obj.left (a i)), z.obj.right, (fun i ↦ z.obj.hom (a i))⟩,
    fun i ↦ z.property (a i)⟩
  map b := ObjectProperty.homMk
    { left := fun i ↦ b.hom.left (a i)
      right := b.hom.right
      w := funext (fun i ↦ congrFun b.hom.w (a i)) }

/-- An entry of a tuple, without passing to isomorphism classes.
Source: Stacks, Tag 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechTupleEntry {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (n : ℕ) (i : Fin n) : FibredCechTuple f n ⥤ U.obj :=
  ObjectProperty.ι _ ⋙ Comma.fst _ _ ⋙ Pi.eval _ i

/-- The specified vertical comparison from an entry's image to the common target.
Source: Stacks, Tag 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechTupleEntryIso {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (n : ℕ) (i : Fin n) :
    fibredCechTupleEntry f n i ⋙ f.toFunctor ≅ fibredCechTupleProjection f n :=
  NatIso.ofComponents (fun z ↦ @asIso _ _ _ _ (z.obj.hom i) (z.property i).1)
    (fun b ↦ congrFun b.hom.w i)

/-- Compatible-family direct image after inverse image, functorial in coefficients.
At `x` this is the limit over arrows `v(c) → x`; the fibred-groupoid property
identifies this indexing category with the test 2-fibre over the scheme of `x`.
Source: Stacks, 06X7 and equation-pushforward
(blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechTerm {C : Type (max v w)} [Category.{v} C]
    {D : Type (max v w)} [Category.{v} D] (a : C ⥤ D) :
    (Dᵒᵖ ⥤ AddCommGrpCat.{max v w}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{max v w}) :=
  (Functor.whiskeringLeft _ _ _).obj a.op ⋙ a.op.ran

/-- Pullback on compatible families along a functor with its specified projection isomorphism.
The two coefficient transports conjugate evaluation by the same isomorphism.
Source: Stacks, 06X7, remark-cech-complex-presheaves
(blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechPullbackApp {C D X : Type (max v w)}
    [Category.{v} C] [Category.{v} D] [Category.{v} X]
    (a : C ⥤ X) (b : D ⥤ X) (d : D ⥤ C) (e : d ⋙ a ≅ b)
    (F : Xᵒᵖ ⥤ AddCommGrpCat.{max v w}) :
    (fibredCechTerm a).obj F ⟶ (fibredCechTerm b).obj F :=
  ((b.op.ranAdjunction AddCommGrpCat.{max v w}).homEquiv _ _)
    ((isoWhiskerRight (NatIso.op e) ((fibredCechTerm a).obj F)).hom ≫
      whiskerLeft d.op (a.op.ranCounit.app (a.op ⋙ F)) ≫
        (isoWhiskerRight (NatIso.op e) F).inv)

/-- Pullback on compatible families commutes with coefficient morphisms.
Source: Stacks 06X7, remark-cech-complex-presheaves
(blueprint: def-sfb-fibred-relative-cech-complex).
Proof: under the right Kan extension adjunction both composites are obtained by
restricting a family along `d` and applying the same coefficient morphism.
Naturality of that morphism commutes with the two transports by `e`.
The adjunction hom equivalence is injective, giving the equation. -/
theorem fibredCechPullback_naturality {C D X : Type (max v w)}
    [Category.{v} C] [Category.{v} D] [Category.{v} X]
    (a : C ⥤ X) (b : D ⥤ X) (d : D ⥤ C) (e : d ⋙ a ≅ b)
    {F G : Xᵒᵖ ⥤ AddCommGrpCat.{max v w}} (k : F ⟶ G) :
    (fibredCechTerm a).map k ≫ fibredCechPullbackApp a b d e G =
      fibredCechPullbackApp a b d e F ≫ (fibredCechTerm b).map k := by
  sorry

/-- The coefficient-natural compatible-family pullback.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechPullback {C D X : Type (max v w)}
    [Category.{v} C] [Category.{v} D] [Category.{v} X]
    (a : C ⥤ X) (b : D ⥤ X) (d : D ⥤ C) (e : d ⋙ a ≅ b) :
    fibredCechTerm a ⟶ fibredCechTerm b where
  app := fibredCechPullbackApp a b d e
  naturality _ _ k := fibredCechPullback_naturality a b d e k

/-- The source category in degree zero and the tuple presentation in positive degrees.
Source: Stacks 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def FibredCechLevel {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) : ℕ → Type (max v w)
  | 0 => U.obj
  | n + 1 => FibredCechTuple f (n + 2)

/-- Category structure inherited from the chosen total-category presentation.
Source: Stacks 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
instance {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) (n : ℕ) :
    Category.{v} (FibredCechLevel f n) := by
  cases n <;> unfold FibredCechLevel <;> infer_instance

/-- Projection of each chosen nerve presentation to the target.
Source: Stacks 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechProjection {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) :
    (n : ℕ) → FibredCechLevel f n ⥤ X.obj
  | 0 => f.toFunctor
  | n + 1 => fibredCechTupleProjection f (n + 2)

/-- The face deleting entry `j`. In degree one the other entry remains in `U`.
Source: Stacks 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechFace {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) :
    (n : ℕ) → Fin (n + 2) → FibredCechLevel f (n + 1) ⥤ FibredCechLevel f n
  | 0, j => fibredCechTupleEntry f 2 (j.rev)
  | _n + 1, j => fibredCechTupleReindex f j.succAbove

/-- The face-projection comparison is the given tuple isomorphism in degree one,
and the identity in higher degrees.
Source: Stacks 06X3 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredCechFaceIso {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) :
    (n : ℕ) → (j : Fin (n + 2)) →
      fibredCechFace f n j ⋙ fibredCechProjection f n ≅
        fibredCechProjection f (n + 1)
  | 0, j => fibredCechTupleEntryIso f 2 j.rev
  | _ + 1, _ => Iso.refl _

/-- Augmented relative terms indexed by `n = p + 1`: zero is degree -1.
Terms in lower integer degrees are zero. Positive indices are direct image after
inverse image, evaluated by compatible families.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredAugmentedCechTerm {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) :
    ℕ → (X.objᵒᵖ ⥤ AddCommGrpCat.{max v w}) ⥤ (X.objᵒᵖ ⥤ AddCommGrpCat.{max v w})
  | 0 => 𝟭 _
  | n + 1 => fibredCechTerm (fibredCechProjection f n)

/-- Augmentation restriction and the alternating sum of omission pullbacks.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredAugmentedCechDifferential {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X) :
    (n : ℕ) → fibredAugmentedCechTerm f n ⟶ fibredAugmentedCechTerm f (n + 1)
  | 0 => (f.toFunctor.op.ranAdjunction AddCommGrpCat.{max v w}).unit
  | n + 1 => ∑ j : Fin (n + 2), (-1 : ℤ) ^ (j : ℕ) •
      fibredCechPullback (fibredCechProjection f n) (fibredCechProjection f (n + 1))
        (fibredCechFace f n j) (fibredCechFaceIso f n j)

/-- Each relative term of a sheaf is a sheaf, and consecutive differentials vanish.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex).
Proof: inverse image is precomposition for a morphism of fibred groupoids, hence
preserves the etale equalizer condition. Compatible families satisfy the same
condition by gluing each component and using uniqueness for compatibility.
Thus the right Kan extension, which is the compatible-family direct image, is a
sheaf. In the alternating differential the two ways to delete a pair of entries
cancel with opposite signs. For the augmentation both faces restrict the same
family; the specified coefficient isomorphisms identify these restrictions.
This also proves the degree-zero differential equation. -/
theorem fibredAugmentedCech_properties {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (hU : IsFibredInGroupoids U) (hX : IsFibredInGroupoids X) :
    (∀ (F : Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w}) (n : ℕ),
      Presheaf.IsSheaf (fibredBigEtaleTopology X)
        ((fibredAugmentedCechTerm f n).obj F.obj)) ∧
    (∀ (n : ℕ), fibredAugmentedCechDifferential f n ≫
      fibredAugmentedCechDifferential f (n + 1) = 0) := by
  sorry

/-- Relative augmented Cech terms as functors on abelian sheaves. The index is
one more than the cohomological degree.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredRelativeCechTerm {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (hU : IsFibredInGroupoids U) (hX : IsFibredInGroupoids X) (n : ℕ) :
    Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w} ⥤
      Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w} where
  obj F := ⟨(fibredAugmentedCechTerm f n).obj F.obj,
    (fibredAugmentedCech_properties f hU hX).1 F n⟩
  map k := ⟨(fibredAugmentedCechTerm f n).map k.hom⟩

/-- The augmented relative differential as a coefficient-natural sheaf morphism.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredRelativeCechDifferential {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (hU : IsFibredInGroupoids U) (hX : IsFibredInGroupoids X) (n : ℕ) :
    fibredRelativeCechTerm f hU hX n ⟶ fibredRelativeCechTerm f hU hX (n + 1) where
  app F := ⟨(fibredAugmentedCechDifferential f n).app F.obj⟩
  naturality _F _G k := ObjectProperty.hom_ext _
    ((fibredAugmentedCechDifferential f n).naturality k.hom)

/-- Consecutive sheaf differentials vanish.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex).
Proof: apply faithfulness of the inclusion of sheaves into presheaves to the
consecutive differential equation in `fibredAugmentedCech_properties`, evaluated
at `F`. Evaluation preserves zero and composition, so it is precisely this equation. -/
theorem fibredRelativeCech_d_comp {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (hU : IsFibredInGroupoids U) (hX : IsFibredInGroupoids X)
    (F : Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w}) (n : ℕ) :
    (fibredRelativeCechDifferential f hU hX n).app F ≫
      (fibredRelativeCechDifferential f hU hX (n + 1)).app F = 0 := by
  sorry

/-- The actual augmented relative cochain complex, reindexed by `n ↦ -1 + n`
and extended by zero below -1. The zero-object instance uses the terminal sheaf
of abelian groups, which is a zero object since there are zero morphisms.
Source: Stacks 06X7 (blueprint: def-sfb-fibred-relative-cech-complex). -/
def fibredRelativeCechComplex {S : AlgebraicGeometry.Scheme.{u}}
    {U X : BasedCategory.{v, max v w} (Over S)} (f : BasedFunctor U X)
    (hU : IsFibredInGroupoids U) (hX : IsFibredInGroupoids X)
    (F : Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w}) :
    CochainComplex (Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w}) ℤ :=
  letI : HasZeroObject (Sheaf (fibredBigEtaleTopology X) AddCommGrpCat.{max v w}) :=
    hasZeroObject_of_hasTerminal_object
  (CochainComplex.of (fun n ↦ (fibredRelativeCechTerm f hU hX n).obj F)
    (fun n ↦ (fibredRelativeCechDifferential f hU hX n).app F)
    (fibredRelativeCech_d_comp f hU hX F)).extend (ComplexShape.embeddingUpIntGE (-1))

end CategoryTheory
