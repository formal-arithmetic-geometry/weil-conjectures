module

public import Sheaf.CategoryTheory.SheafDgSubmodule
public import Mathlib.Topology.Sheaves.Sheaf
public import Mathlib.SetTheory.Cardinal.Arithmetic

/-! # The dg subsheaf generated by local sections and its size

Source: Stacks Project, sdga.tex, Tag 0FST, generated-submodule paragraph,
with the exponentiation-closed bound on the topological open site
(blueprint: lem-sfb-generated-sheaf-dg-submodule-size).
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory TopologicalSpace Opposite

namespace CategoryTheory.SheafDg

variable {X : Type u} [TopologicalSpace X]
  {S : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}

/-- All sections of a graded sheaf, labelled by their open and integer degree.
Source: Stacks, sdga.tex, Tag 0FST, definition of size
(blueprint: lem-sfb-generated-sheaf-dg-submodule-size). -/
def gradedSectionSet (E : ℤ → ringedSiteModules.{u} (rings S)) : Type u :=
  Σ U : Opens X, Σ q : ℤ, (E q).val.obj (op U)

/-- The summand `a x + b dx` restricted from U to V and transported to degree q.
The second coefficient degree q-(r+1) is the integer q-r-1 in the source.
Source: Stacks, sdga.tex, Tag 0FST, displayed local expression
(blueprint: lem-sfb-generated-sheaf-dg-submodule-size). -/
def generatedSectionTerm (A : Algebra S) (M : LeftModule A) (q r : ℤ)
    (U V : Opens X) (h : V ≤ U) (x : (M.X.X r).val.obj (op U))
    (a : (A.X.X (q - r)).val.obj (op V))
    (b : (A.X.X (q - (r + 1))).val.obj (op V)) : (M.X.X q).val.obj (op V) :=
  (M.X.XIsoOfEq (sub_add_cancel q r)).hom.val.app (op V)
    (actionSection A M (q - r) r (op V) a
      ((M.X.X r).val.map (homOfLE h).op x)) +
  (M.X.XIsoOfEq (sub_add_cancel q (r + 1))).hom.val.app (op V)
    (actionSection A M (q - (r + 1)) (r + 1) (op V) b
      ((M.X.X (r + 1)).val.map (homOfLE h).op
        ((M.X.d r (r + 1)).val.app (op U) x)))

/-- Finite expressions on one open, allowing zero terms and repeated generators.
Every finite set of terms can be enumerated by Fin n and conversely.
Source: Stacks, sdga.tex, Tag 0FST, displayed local expression
(blueprint: lem-sfb-generated-sheaf-dg-submodule-size). -/
def IsGeneratedSectionExpression (A : Algebra S) (M : LeftModule A)
    (F : Subsheaf A M) {K : Type u} (U : K → Opens X) (r : K → ℤ)
    (x : ∀ k : K, (M.X.X (r k)).val.obj (op (U k))) (q : ℤ) (V : Opens X)
    (z : (M.X.X q).val.obj (op V)) : Prop :=
  ∃ y : {y : (M.X.X q).val.obj (op V) // y ∈ (F.piece q).val (op V)},
    ∃ (n : ℕ) (k : Fin n → K) (h : ∀ t : Fin n, V ≤ U (k t))
      (a : ∀ t : Fin n, (A.X.X (q - r (k t))).val.obj (op V))
      (b : ∀ t : Fin n, (A.X.X (q - (r (k t) + 1))).val.obj (op V)),
      z = y.val + ∑ t : Fin n,
        generatedSectionTerm A M q (r (k t)) (U (k t)) V (h t) (x (k t)) (a t) (b t)

/-- Locality of the displayed finite-expression rule, using an arbitrary small open cover.
The empty cover of the empty open is allowed.
Source: Stacks, sdga.tex, Tag 0FST, generated-submodule paragraph
(blueprint: lem-sfb-generated-sheaf-dg-submodule-size). -/
def IsLocallyGeneratedSection (A : Algebra S) (M : LeftModule A)
    (F : Subsheaf A M) {K : Type u} (U : K → Opens X) (r : K → ℤ)
    (x : ∀ k : K, (M.X.X (r k)).val.obj (op (U k))) (q : ℤ) (V : Opens X)
    (z : (M.X.X q).val.obj (op V)) : Prop :=
  ∃ (I : Type u) (W : I → Opens X) (h : ∀ i : I, W i ≤ V),
    iSup W = V ∧ ∀ i : I,
      IsGeneratedSectionExpression A M F U r x q (W i)
        ((M.X.X q).val.map (homOfLE (h i)).op z)

/-- A smallest dg subsheaf containing F and the specified local sections exists;
its sections are exactly locally finite expressions in F, x_k and dx_k.
The total set of its sections has cardinal at most mu under the stated size bounds.

Source: Stacks, sdga.tex, Tag 0FST, generated-submodule paragraph, with the
exponentiation-closed bound on the topological open site
(blueprint: lem-sfb-generated-sheaf-dg-submodule-size).

Proof: (1) Form the presheaf P of finite expressions. Empty sums contain F;
the unit contains each generator. Restriction, concatenation, negation and
homogeneous multiplication preserve these expressions.
(2) The Leibniz rule gives d(ax+b dx)=(da)x+((-1)^(q-r)a+db)dx,
since d^2x=0; thus P is stable under d.
(3) Locally belonging to P is stable under restriction, locality, sums, negation,
action and d, by refining covers with intersections.
(4) Glue in M and use locality to obtain a dg subsheaf. Every dg subsheaf
containing F and the generators contains P, then its local saturation by gluing.
This proves minimality and the local description, including empty covers.
(5) Encode expressions by finite words in opens, degrees, generators and sections
of F and A. The alphabet has size at most mu by lem-sfb-infinite-cardinal-square
(Cardinal.mul_eq_self); lem-weil-pbc-finite-list-cardinality
(Cardinal.mk_list_le_max) bounds its finite words by mu.
(6) For each section choose a cover and one expression per distinct open.
Encode it by a function from opens to expressions plus a dummy symbol.
Sheaf separation makes these codes injective. Their cardinal is at most
mu^lambda=mu; there are at most mu open-degree pairs, so the square lemma
bounds the total section set by mu. The sheaf operations and separation used
throughout are those of def-sfb-sheaf-dg-module-localization. -/
theorem exists_generated_subsheaf_size (A : Algebra S) (M : LeftModule A)
    (F : Subsheaf A M) {K : Type u} (U : K → Opens X) (r : K → ℤ)
    (x : ∀ k : K, (M.X.X (r k)).val.obj (op (U k))) :
    ∃ G : Subsheaf A M,
      F.IsContained G ∧
      (∀ k : K, x k ∈ (G.piece (r k)).val (op (U k))) ∧
      (∀ N : Subsheaf A M, F.IsContained N →
        (∀ k : K, x k ∈ (N.piece (r k)).val (op (U k))) → G.IsContained N) ∧
      (∀ (q : ℤ) (V : Opens X) (z : (M.X.X q).val.obj (op V)),
        z ∈ (G.piece q).val (op V) ↔ IsLocallyGeneratedSection A M F U r x q V z) ∧
      (∀ κ μ : Cardinal.{u},
        Cardinal.aleph0 ≤ κ → Cardinal.mk (Opens X) ≤ κ →
        Cardinal.mk (gradedSectionSet A.X.X) ≤ κ → κ ≤ μ → μ ^ κ = μ →
        Cardinal.mk F.sectionSet ≤ μ → Cardinal.mk K ≤ μ →
        Cardinal.mk G.sectionSet ≤ μ) := by
  sorry

end CategoryTheory.SheafDg
