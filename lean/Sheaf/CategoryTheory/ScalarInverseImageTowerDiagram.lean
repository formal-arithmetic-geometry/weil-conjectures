/-! # Inverse image and balanced scalar towers

Source: blueprint main-20261015, det-prop-scalar-six-pullback.proof.md (3);
Stacks Project, Modules on Sites, Tags 03EK and 03EL
(blueprint: lem-sfb-scalar-inverse-image-tower-diagram).

The normalization predicates specify the actual balanced quotient maps, including
first-factor coefficient actions. They impose equations on every generalized section,
without assuming that tensor products are generated by global sections.
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits
open scoped ChangeOfRings
namespace SheafOfModules.RingedTensor
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

/-- The sheafification image of the balanced scalar tensor, with the first-factor action.
Source: Stacks 03EK, and blueprint det-prop-scalar-six-pullback.proof.md (3)
(blueprint: lem-sfb-scalar-inverse-image-tower-diagram). -/
noncomputable def scalarPure
    {S : Type u} [SmallCategory S] {J : GrothendieckTopology S}
    {A B : Sheaf J CommRingCat.{u}} (a : A ⟶ B)
    (M : SheafOfModules.{u} (ringSheaf A)) (W : Sᵒᵖ)
    (b : B.obj.obj W) (m : M.val.obj W) : ((tensorFunctor a).obj M).val.obj W :=
  ((PresheafOfModules.sheafificationAdjunction.{u} (𝟙 (ringSheaf B).obj)).unit.app
    (changeOfRingsPresheaf.{u, u, u} a M)).app W (b ⊗ₜ[A.obj.obj W, (a.hom.app W).hom] m)

/-- Both formulas specifying scalar reassociation and its inverse on balanced quotients.
Source: Stacks 03EK, blueprint det-prop-scalar-six-pullback.proof.md (3)
(blueprint: lem-sfb-scalar-inverse-image-tower-diagram). -/
def IsScalarReassociation
    {S : Type u} [SmallCategory S] {J : GrothendieckTopology S}
    {A B C : Sheaf J CommRingCat.{u}} (a : A ⟶ B) (b : B ⟶ C)
    (t : tensorFunctor a ⋙ tensorFunctor b ≅ tensorFunctor (a ≫ b)) : Prop :=
  (∀ (M : SheafOfModules.{u} (ringSheaf A)) (W : Sᵒᵖ)
    (c : C.obj.obj W) (s : B.obj.obj W) (m : M.val.obj W),
    (t.hom.app M).val.app W
      (scalarPure b ((tensorFunctor a).obj M) W c (scalarPure a M W s m)) =
        scalarPure (a ≫ b) M W (c * b.hom.app W s) m) ∧
  ∀ (M : SheafOfModules.{u} (ringSheaf A)) (W : Sᵒᵖ)
    (c : C.obj.obj W) (m : M.val.obj W),
    (t.inv.app M).val.app W (scalarPure (a ≫ b) M W c m) =
      scalarPure b ((tensorFunctor a).obj M) W c (scalarPure a M W 1 m)

/-- The balanced inverse-image comparison, normalized on every generalized pure tensor.
Source: Stacks 03EL and blueprint det-prop-scalar-six-pullback.proof.md (3)
(blueprint: lem-sfb-scalar-inverse-image-tower-diagram). -/
def IsScalarInverseImageComparison
    {SY SX : Type u} [SmallCategory SY] [SmallCategory SX]
    {JY : GrothendieckTopology SY} {JX : GrothendieckTopology SX}
    {AY BY : Sheaf JY CommRingCat.{u}} {AX BX : Sheaf JX CommRingCat.{u}}
    (F : Sheaf JY (Type u) ⥤ Sheaf JX (Type u))
    (IA : AlgebraicInverseImage F AY AX) (IB : AlgebraicInverseImage F BY BX)
    (aY : AY ⟶ BY) (aX : AX ⟶ BX)
    (e : tensorFunctor aY ⋙ IB.modules ≅ IA.modules ⋙ tensorFunctor aX) : Prop :=
  ∀ (M : SheafOfModules.{u} (ringSheaf AY)) (T : Sheaf JY (Type u))
    (s : T ⟶ (sheafCompose JY (CategoryTheory.forget CommRingCat)).obj BY)
    (m : T ⟶ (underlying AY).obj M)
    (z : T ⟶ (underlying BY).obj ((tensorFunctor aY).obj M)),
    (∀ W q, z.hom.app W q = scalarPure aY M W (s.hom.app W q) (m.hom.app W q)) →
    ∀ W q, (e.hom.app M).val.app W
      ((F.map z ≫ IB.moduleUnderlying.inv.app ((tensorFunctor aY).obj M)).hom.app W q) =
      scalarPure aX (IA.modules.obj M) W
        ((F.map s ≫ IB.ringUnderlying.hom).hom.app W q)
        ((F.map m ≫ IA.moduleUnderlying.inv.app M).hom.app W q)

