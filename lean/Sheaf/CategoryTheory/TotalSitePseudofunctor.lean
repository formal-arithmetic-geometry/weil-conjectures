module

public import Mathlib.CategoryTheory.FiberedCategory.Grothendieck
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Sheaf.CategoryTheory.SiteCoveringAxioms

/-!
# Total site of a coherent pseudofunctor of sites

Source: Stacks Project, `spaces-simplicial.tex`, Tag 09WC, lemma-simplicial-site-site,
Case A (blueprint: lem-trf-slice-site-total-pseudofunctor).
-/

@[expose] public section
set_option autoImplicit false

universe u v w

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.Bicategory

namespace CategoryTheory

/-- The data of a coherent contravariant pseudofunctor of sites.  The pseudofunctor
supplies the unit and compositor isomorphisms and their coherence laws.  The last
field records preservation of the fibre products used to pull back covering families.
Source: Stacks Project, Sites, Tag 09WC, Case A
(blueprint: lem-trf-slice-site-total-pseudofunctor). -/
structure CoherentSitePseudofunctor (I : Type u) [Category.{v} I]
    (F : LocallyDiscrete Iᵒᵖ ⥤ᵖ Cat.{w, w}) where
  coverage : ∀ i : I, Precoverage (F.obj ⟨op i⟩)
  site : ∀ i : I, (coverage i).IsSiteForCoverings
  continuous : ∀ {i j : I} (α : i ⟶ j),
    Functor.IsContinuous (F.map α.op.toLoc).toFunctor
      (coverage j).toGrothendieck (coverage i).toGrothendieck
  preservesCoverPullbacks : ∀ {i j : I} (α : i ⟶ j)
    (K : Type (max w w)) (X : F.obj ⟨op j⟩) (V : K → F.obj ⟨op j⟩)
    (a : ∀ k, V k ⟶ X),
    Presieve.ofArrows V a ∈ coverage j X →
    ∀ (T : F.obj ⟨op i⟩) (f : T ⟶ (F.map α.op.toLoc).toFunctor.obj X),
      ∃ (P : K → F.obj ⟨op i⟩) (p : ∀ k, P k ⟶ T)
        (q : ∀ k, P k ⟶ (F.map α.op.toLoc).toFunctor.obj (V k)),
        (∀ k, IsPullback (p k) (q k) f
          ((F.map α.op.toLoc).toFunctor.map (a k))) ∧
          Presieve.ofArrows P p ∈ coverage i T

/-- The vertical arrows associated to a family in one fibre of a total category.
Source: Stacks Project, Tag 09WC, Case A
(blueprint: lem-trf-slice-site-total-pseudofunctor). -/
def CoherentSitePseudofunctor.verticalArrows
    {I : Type u} [Category.{v} I]
    {F : LocallyDiscrete Iᵒᵖ ⥤ᵖ Cat.{w, w}}
    (i : I) {K : Type (max w w)} (V : K → F.obj ⟨op i⟩)
    {X : F.obj ⟨op i⟩} (a : ∀ k, V k ⟶ X) :
    ∀ k, (Pseudofunctor.CoGrothendieck.ι F i).obj (V k) ⟶
      (Pseudofunctor.CoGrothendieck.ι F i).obj X :=
  fun k => (Pseudofunctor.CoGrothendieck.ι F i).map (a k)

/-- The Grothendieck topology generated by the vertical covering families.
Source: Stacks Project, Tag 09WC, Case A
(blueprint: lem-trf-slice-site-total-pseudofunctor). -/
def CoherentSitePseudofunctor.totalTopology
    {I : Type u} [Category.{v} I]
    {F : LocallyDiscrete Iᵒᵖ ⥤ᵖ Cat.{w, w}}
    (D : CoherentSitePseudofunctor I F) :
    GrothendieckTopology (Pseudofunctor.CoGrothendieck F) :=
  sInf {K | ∀ (i : I) (L : Type (max w w)) (X : F.obj ⟨op i⟩)
    (V : L → F.obj ⟨op i⟩) (a : ∀ k, V k ⟶ X),
    Presieve.ofArrows V a ∈ D.coverage i X →
      Sieve.ofArrows (fun k => (Pseudofunctor.CoGrothendieck.ι F i).obj (V k))
        (CoherentSitePseudofunctor.verticalArrows i V a) ∈
          K ((Pseudofunctor.CoGrothendieck.ι F i).obj X)}

/-- A coherent contravariant pseudofunctor of sites has a total site.  Its objects are
pairs `(i,U)` and its arrows are pairs `(α,f)` with `f : U ⟶ u_α(V)`; composition is
that of Mathlib's `CoGrothendieck` construction and therefore uses the compositor
isomorphisms and is associative.  The topology is generated by vertical covering
families.  Pulling a generating cover back along any arrow is a covering family and
is represented by pullback squares in the source fibre, hence the generated topology
is a site and every isomorphism sieve is covering.
Source: Stacks Project, `spaces-simplicial.tex`, Tag 09WC, lemma-simplicial-site-site,
Case A (blueprint: lem-trf-slice-site-total-pseudofunctor).

Proof: use the `CoGrothendieck` category construction for the object, arrow,
composition, identity, and coherence clauses.  The vertical families generate the
infimum topology.  For an arrow `(α,f)`, apply the preservation-of-cover-pullbacks
field to the image under `u_α` of a fibre covering; the resulting pullback squares
and the site axiom give a covering family in the total category.  Closure under the
Grothendieck topology axioms yields the asserted site and isomorphism-sieve clauses.
-/
theorem totalSite_of_coherent_pseudofunctor
    {I : Type u} [Category.{v} I]
    {F : LocallyDiscrete Iᵒᵖ ⥤ᵖ Cat.{w, w}}
    (D : CoherentSitePseudofunctor I F) :
    ∃ (J : GrothendieckTopology (Pseudofunctor.CoGrothendieck F)),
      J = D.totalTopology ∧
      (∀ (X : Pseudofunctor.CoGrothendieck F) (j : I)
        (U : F.obj ⟨op j⟩) (f : X ⟶
          (Pseudofunctor.CoGrothendieck.ι F j).obj U)
        (K : Type (max w w)) (V : K → F.obj ⟨op j⟩)
        (a : ∀ k, V k ⟶ U),
        Presieve.ofArrows V a ∈ D.coverage j U →
        ∃ (P : K → Pseudofunctor.CoGrothendieck F)
          (p : ∀ k, P k ⟶ X) (q : ∀ k, P k ⟶
            (Pseudofunctor.CoGrothendieck.ι F j).obj (V k)),
          (∀ k, IsPullback (p k) (q k) f
            ((Pseudofunctor.CoGrothendieck.ι F j).map (a k))) ∧
            Sieve.ofArrows P p ∈ J X)
      := by
  sorry

end CategoryTheory
