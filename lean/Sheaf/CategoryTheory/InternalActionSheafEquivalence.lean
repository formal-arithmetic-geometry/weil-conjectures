/-!
# Set sheaves on the internal action site

Source: the internal-action infrastructure below paragraph (3) of
sk-thm-sf-ctf-stability-direct-images; Stacks 00Z8, 00ZC, 00ZD
(blueprint: lem-sfb-internal-action-sheaf-equivalence).

The existing `SetActions` uses Mathlib's internal module objects. Presheaves are
encoded as sheaves for the bottom topology, which imposes no sheaf condition.
No group action, labeled site, or matching-family notion is defined a second time.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite MonoidalCategory

namespace CategoryTheory.InternalActionSite

variable {C : Type u} [SmallCategory C]

/-- A group presheaf is a sheaf for the topology generated by the empty precoverage.
Proof: transport `Presheaf.isSheaf_bot` along `Precoverage.toGrothendieck_bot`.
Source: Stacks 00Z8; the presheaf part of the action-site construction
(blueprint: lem-sfb-internal-action-sheaf-equivalence). -/
theorem groupSheafForEmptyCoverage (K : Cᵒᵖ ⥤ GrpCat.{u}) :
    Presheaf.IsSheaf (⊥ : Precoverage C).toGrothendieck (K ⋙ forget GrpCat.{u}) := by
  rw [Precoverage.toGrothendieck_bot]
  exact Presheaf.isSheaf_bot _

/-- An action-site equivalence together with its prescribed section formulas.
Both source and target may have the bottom topology, so this also describes the
presheaf constructions. Section bijections express the unchanged section sets
without requiring equality of the bundled objects used to encode those sets.
Source: internal-action infrastructure below paragraph (3) of
sk-thm-sf-ctf-stability-direct-images
(blueprint: lem-sfb-internal-action-sheaf-equivalence). -/
structure SetActionEquivalenceData (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (L : GrothendieckTopology (Object K)) where
  /-- The equivalence of the stated categories. -/
  equivalence : SetActions J K hK ≌ Sheaf L (Type u)
  /-- Forward objects have exactly the original section sets. -/
  sections (M : SetActions J K hK) (U : C) :
    (equivalence.functor.obj M).obj.obj (op (Object.mk (K := K) U)) ≃ M.X.obj.obj (op U)
  /-- Restriction along (f,a) is a acting after base restriction. -/
  restriction (M : SetActions J K hK) {V U : C} (f : V ⟶ U)
      (a : K.obj (op V))
      (x : (equivalence.functor.obj M).obj.obj (op (Object.mk (K := K) U))) :
    sections M V ((equivalence.functor.obj M).obj.map (opArrow K f a) x) =
      setAction J K hK M (op V) a (M.X.obj.map f.op (sections M U x))
  /-- Forward maps have unchanged components. -/
  morphisms {M N : SetActions J K hK} (g : M ⟶ N) (U : C)
      (x : (equivalence.functor.obj M).obj.obj (op (Object.mk (K := K) U))) :
    sections N U ((equivalence.functor.map g).hom.app _ x) =
      g.hom.hom.app (op U) (sections M U x)
  /-- The inverse too keeps the section sets. -/
  inverseSections (N : Sheaf L (Type u)) (U : C) :
    (equivalence.inverse.obj N).X.obj.obj (op U) ≃
      N.obj.obj (op (Object.mk (K := K) U))
  /-- Its base restriction is restriction along (f,1). -/
  inverse_restriction (N : Sheaf L (Type u)) {V U : C} (f : V ⟶ U)
      (x : (equivalence.inverse.obj N).X.obj.obj (op U)) :
    inverseSections N V ((equivalence.inverse.obj N).X.obj.map f.op x) =
      N.obj.map (opArrow K f 1) (inverseSections N U x)
  /-- Its action is restriction along (1,a). -/
  inverse_action (N : Sheaf L (Type u)) (U : C) (a : K.obj (op U))
      (x : (equivalence.inverse.obj N).X.obj.obj (op U)) :
    inverseSections N U (setAction J K hK (equivalence.inverse.obj N) (op U) a x) =
      N.obj.map (opArrow K (𝟙 U) a) (inverseSections N U x)
  /-- Inverse maps also have unchanged components. -/
  inverse_morphisms {M N : Sheaf L (Type u)} (g : M ⟶ N) (U : C)
      (x : (equivalence.inverse.obj M).X.obj.obj (op U)) :
    inverseSections N U ((equivalence.inverse.map g).hom.hom.app (op U) x) =
      g.hom.app _ (inverseSections M U x)
  /-- The first round trip is the identity under the section identifications. -/
  unit_sections (M : SetActions J K hK) (U : C) (x : M.X.obj.obj (op U)) :
    inverseSections (equivalence.functor.obj M) U
        ((equivalence.unitIso.hom.app M).hom.hom.app (op U) x) =
      (sections M U).symm x
  /-- The other round trip is likewise the identity. -/
  counit_sections (N : Sheaf L (Type u)) (U : C)
      (x : (equivalence.functor.obj (equivalence.inverse.obj N)).obj.obj
        (op (Object.mk (K := K) U))) :
    (equivalence.counitIso.hom.app N).hom.app _ x =
      inverseSections N U (sections (equivalence.inverse.obj N) U x)

private theorem action_one (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK) (X : Cᵒᵖ) (x : M.X.obj.obj X) :
    setAction J K hK M X 1 x = x := by
  exact congrArg (fun f ↦ f.hom.app X (PUnit.unit, x))
    (ModObj.one_smul_self (groupSheaf J K hK) M.X)

private theorem action_mul (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK) (X : Cᵒᵖ) (a b : K.obj X) (x : M.X.obj.obj X) :
    setAction J K hK M X (a * b) x =
      setAction J K hK M X a (setAction J K hK M X b x) := by
  exact congrArg (fun f ↦ f.hom.app X ((a, b), x))
    (ModObj.mul_smul_self (groupSheaf J K hK) M.X)

private theorem action_natural (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK) {X Y : Cᵒᵖ} (f : X ⟶ Y)
    (a : K.obj X) (x : M.X.obj.obj X) :
    M.X.obj.map f (setAction J K hK M X a x) =
      setAction J K hK M Y (K.map f a) (M.X.obj.map f x) := by
  have h := (ModObj.smul (M := groupSheaf J K hK) (X := M.X)).hom.naturality f
  exact (congrArg (fun t : K.obj X × M.X.obj.obj X ⟶ M.X.obj.obj Y ↦ t (a, x)) h).symm

private theorem action_map (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    {M N : SetActions J K hK} (f : M ⟶ N) (X : Cᵒᵖ)
    (a : K.obj X) (x : M.X.obj.obj X) :
    f.hom.hom.app X (setAction J K hK M X a x) =
      setAction J K hK N X a (f.hom.hom.app X x) := by
  exact congrArg (fun g : groupSheaf J K hK ⊗ M.X ⟶ N.X ↦ g.hom.app X (a, x))
    (IsModHom.smul_hom (A := groupSheaf J K hK) (f := f.hom))

private def extendSet (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK) : (Object K)ᵒᵖ ⥤ Type u where
  obj X := M.X.obj.obj (op X.unop.base)
  map {X Y} f := ↾fun x ↦ setAction J K hK M (op Y.unop.base) f.unop.label
    (M.X.obj.map f.unop.base.op x)
  map_id X := by
    ext x
    change setAction J K hK M _ 1 (M.X.obj.map (𝟙 _) x) = x
    simp only [Functor.map_id, types_id_apply, action_one]
  map_comp {X Y Z} f g := by
    ext x
    change setAction J K hK M _ (g.unop.label * K.map g.unop.base.op f.unop.label)
      (M.X.obj.map (g.unop.base ≫ f.unop.base).op x) =
      setAction J K hK M _ g.unop.label
        (M.X.obj.map g.unop.base.op
          (setAction J K hK M _ f.unop.label (M.X.obj.map f.unop.base.op x)))
    rw [action_natural, action_mul, op_comp, Functor.map_comp]
    rfl

private def extendSetMap (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    {M N : SetActions J K hK} (f : M ⟶ N) :
    extendSet J K hK M ⟶ extendSet J K hK N where
  app X := f.hom.hom.app (op X.unop.base)
  naturality X Y g := by
    ext x
    change f.hom.hom.app _ (setAction J K hK M _ g.unop.label
      (M.X.obj.map g.unop.base.op x)) =
      setAction J K hK N _ g.unop.label
        (N.X.obj.map g.unop.base.op (f.hom.hom.app _ x))
    rw [action_map, NatTrans.naturality_apply]

private theorem sieve_label (K : Cᵒᵖ ⥤ GrpCat.{u}) {U V : Object K}
    (S : Sieve U) (f : V ⟶ U) : S f ↔ labelOneSieve K S f.base := by
  constructor
  · intro hf
    have h := S.downward_closed hf (Arrow.mk (𝟙 V.base) f.label⁻¹ : V ⟶ V)
    have he : (Arrow.mk (𝟙 V.base) f.label⁻¹ : V ⟶ V) ≫ f =
        Arrow.mk f.base 1 := by
      apply arrow_ext K (Category.id_comp _)
      change f.label⁻¹ * K.map (𝟙 V.base).op f.label = 1
      simp
    rwa [he] at h
  · intro hf
    have h := S.downward_closed hf (Arrow.mk (𝟙 V.base) f.label : V ⟶ V)
    have he : (Arrow.mk (𝟙 V.base) f.label : V ⟶ V) ≫ Arrow.mk f.base 1 = f := by
      apply arrow_ext K (Category.id_comp _)
      change f.label * K.map (𝟙 V.base).op 1 = f.label
      simp
    rwa [he] at h

private theorem family_congr {D : Type u} [SmallCategory D]
    {P : Dᵒᵖ ⥤ Type u} {U : D} {S : Presieve U}
    (z : Presieve.FamilyOfElements P S) {V : D} (f g : V ⟶ U)
    (hf : S f) (hg : S g) (he : f = g) : z f hf = z g hg := by
  cases he
  rfl

section Matching

variable (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK) (U : Object K) (S : Sieve U)

private def normalizeFamily
    (z : {z : Presieve.FamilyOfElements (extendSet J K hK M) S.arrows // z.Compatible}) :
    {y : Presieve.FamilyOfElements M.X.obj (labelOneSieve K S).arrows // y.Compatible} :=
  ⟨fun _ f hf ↦ z.val (Arrow.mk f 1) hf, by
    apply (Presieve.compatible_iff_sieveCompatible _).2
    intro V W f g hf
    have ht := z.property.to_sieveCompatible
      (Arrow.mk f 1 : Object.mk (K := K) V ⟶ U)
      (Arrow.mk g 1 : Object.mk (K := K) W ⟶ Object.mk (K := K) V) hf
    change z.val (Arrow.mk (g ≫ f) (1 * K.map g.op 1)) _ =
      setAction J K hK M _ 1 (M.X.obj.map g.op (z.val (Arrow.mk f 1) hf)) at ht
    have he : (Arrow.mk (g ≫ f) (1 * K.map g.op 1) :
        Object.mk (K := K) W ⟶ U) = Arrow.mk (g ≫ f) 1 := by
      apply arrow_ext K
      · rfl
      · change 1 * K.map g.op (1 : K.obj (op V)) = 1
        simp
    have hn := family_congr z.val _ _
      (S.downward_closed hf (Arrow.mk g 1)) (labelOne_downward K S f g hf) he
    exact hn.symm.trans (ht.trans (action_one J K hK M _ _))⟩

private theorem family_label
    (z : {z : Presieve.FamilyOfElements (extendSet J K hK M) S.arrows // z.Compatible})
    (V : Object K) (f : V ⟶ U) (hf : S f) :
    z.val f hf = setAction J K hK M (op V.base) f.label
      ((normalizeFamily J K hK M U S z).val f.base ((sieve_label K S f).mp hf)) := by
  have ht := z.property.to_sieveCompatible
    (Arrow.mk f.base 1 : V ⟶ U) (Arrow.mk (𝟙 V.base) f.label : V ⟶ V)
    ((sieve_label K S f).mp hf)
  change z.val (Arrow.mk (𝟙 V.base ≫ f.base)
      (f.label * K.map (𝟙 V.base).op 1)) _ =
    setAction J K hK M _ f.label (M.X.obj.map (𝟙 _) (z.val (Arrow.mk f.base 1) _)) at ht
  have he : (Arrow.mk (𝟙 V.base ≫ f.base)
      (f.label * K.map (𝟙 V.base).op 1) : V ⟶ U) = f := by
    apply arrow_ext K (Category.id_comp _)
    simp
  have hn := family_congr z.val _ _
    (S.downward_closed ((sieve_label K S f).mp hf) (Arrow.mk (𝟙 V.base) f.label)) hf he
  exact hn.symm.trans (ht.trans (by simp only [Functor.map_id, types_id_apply]; rfl))

private def extendFamily
    (y : {y : Presieve.FamilyOfElements M.X.obj (labelOneSieve K S).arrows //
      y.Compatible}) :
    {z : Presieve.FamilyOfElements (extendSet J K hK M) S.arrows // z.Compatible} :=
  ⟨fun V f hf ↦ setAction J K hK M (op V.base) f.label
    (y.val f.base ((sieve_label K S f).mp hf)), by
    apply (Presieve.compatible_iff_sieveCompatible _).2
    intro V W f g hf
    change setAction J K hK M _ (g.label * K.map g.base.op f.label)
        (y.val (g.base ≫ f.base) _) =
      setAction J K hK M _ g.label
        (M.X.obj.map g.base.op (setAction J K hK M _ f.label (y.val f.base _)))
    rw [action_natural, action_mul]
    congr 2
    exact y.property.to_sieveCompatible f.base g.base _⟩

private def matchingEquiv :
    {z : Presieve.FamilyOfElements (extendSet J K hK M) S.arrows // z.Compatible} ≃
      {y : Presieve.FamilyOfElements M.X.obj (labelOneSieve K S).arrows // y.Compatible}
    where
  toFun := normalizeFamily J K hK M U S
  invFun := extendFamily J K hK M U S
  left_inv z := by
    apply Subtype.ext
    funext V f hf
    exact (family_label J K hK M U S z V f hf).symm
  right_inv y := by
    apply Subtype.ext
    funext V f hf
    exact action_one J K hK M (op V) (y.val f hf)

private theorem matching_amalgamation
    (z : {z : Presieve.FamilyOfElements (extendSet J K hK M) S.arrows // z.Compatible})
    (x : (extendSet J K hK M).obj (op U)) :
    z.val.IsAmalgamation x ↔
      (matchingEquiv J K hK M U S z).val.IsAmalgamation x := by
  constructor
  · intro h V f hf
    have ht := h (Arrow.mk f 1 : Object.mk (K := K) V ⟶ U) hf
    change setAction J K hK M _ 1 (M.X.obj.map f.op x) = z.val (Arrow.mk f 1) hf at ht
    change M.X.obj.map f.op x = z.val (Arrow.mk f 1) hf
    simpa only [action_one] using ht
  · intro h V f hf
    change setAction J K hK M _ f.label (M.X.obj.map f.base.op x) = z.val f hf
    rw [family_label J K hK M U S z V f hf]
    exact congrArg (setAction J K hK M _ f.label) (h f.base _)

private theorem matching_unique
    (z : {z : Presieve.FamilyOfElements (extendSet J K hK M) S.arrows // z.Compatible}) :
    (∃! x, z.val.IsAmalgamation x) ↔
      ∃! y, (matchingEquiv J K hK M U S z).val.IsAmalgamation y := by
  simp only [matching_amalgamation J K hK M U S z]
  rfl

private theorem matching_sheaf :
    Presieve.IsSheafFor (extendSet J K hK M) S.arrows ↔
      Presieve.IsSheafFor M.X.obj (labelOneSieve K S).arrows := by
  constructor
  · intro h y hy
    let z := (matchingEquiv J K hK M U S).symm ⟨y, hy⟩
    have ht := (matching_unique J K hK M U S z).mp (h z.val z.property)
    simpa only [z, Equiv.apply_symm_apply] using ht
  · intro h z hz
    exact (matching_unique J K hK M U S ⟨z, hz⟩).mpr
      (h _ (matchingEquiv J K hK M U S ⟨z, hz⟩).property)

end Matching

private def allLabels (K : Cᵒᵖ ⥤ GrpCat.{u}) (U : Object K)
    (T : Sieve U.base) : Sieve U where
  arrows _ f := T f.base
  downward_closed hf g := T.downward_closed hf g.base

private theorem extendSet_sheaf_iff [HasFiniteLimits C] (J A : Precoverage C)
    (hA : A.IsSiteForCoverings) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK) :
    Presheaf.IsSheaf (topology K A) (extendSet J K hK M) ↔
      Presheaf.IsSheaf A.toGrothendieck M.X.obj := by
  rw [isSheaf_iff_isSheaf_of_type, isSheaf_iff_isSheaf_of_type]
  constructor
  · intro h U T hT
    exact (matching_sheaf J K hK M (Object.mk U) (allLabels K (Object.mk U) T)).mp
      (h _ ((topology_mem_iff K A hA _ _).mpr hT))
  · intro h U S hS
    exact (matching_sheaf J K hK M U S).mpr
      (h _ ((topology_mem_iff K A hA U S).mp hS))

private theorem one_comp (K : Cᵒᵖ ⥤ GrpCat.{u}) {X Y Z : C}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    opArrow K (f ≫ g) 1 = opArrow K g 1 ≫ opArrow K f 1 := by
  apply Quiver.Hom.unop_inj
  change Arrow.mk (f ≫ g) 1 = Arrow.mk (f ≫ g) (1 * K.map f.op 1)
  simp

private theorem vertical_mul (K : Cᵒᵖ ⥤ GrpCat.{u}) (X : C)
    (a b : K.obj (op X)) :
    opArrow K (𝟙 X) (a * b) = opArrow K (𝟙 X) b ≫ opArrow K (𝟙 X) a := by
  apply Quiver.Hom.unop_inj
  apply arrow_ext K (Category.id_comp _).symm
  change a * b = a * K.map (𝟙 X).op b
  simp

private theorem vertical_natural (K : Cᵒᵖ ⥤ GrpCat.{u}) {X Y : C}
    (f : X ⟶ Y) (a : K.obj (op Y)) :
    opArrow K (𝟙 Y) a ≫ opArrow K f 1 =
      opArrow K f 1 ≫ opArrow K (𝟙 X) (K.map f.op a) := by
  apply Quiver.Hom.unop_inj
  apply arrow_ext K
  · exact (Category.comp_id f).trans (Category.id_comp f).symm
  · change 1 * K.map f.op a = K.map f.op a * K.map (𝟙 X).op 1
    simp

private theorem arrow_factor (K : Cᵒᵖ ⥤ GrpCat.{u}) {X Y : C}
    (f : X ⟶ Y) (a : K.obj (op X)) :
    opArrow K f a = opArrow K f 1 ≫ opArrow K (𝟙 X) a := by
  apply Quiver.Hom.unop_inj
  apply arrow_ext K (Category.id_comp _).symm
  change a = a * K.map (𝟙 X).op 1
  simp

private def restrictSet (K : Cᵒᵖ ⥤ GrpCat.{u}) (N : (Object K)ᵒᵖ ⥤ Type u) :
    Cᵒᵖ ⥤ Type u where
  obj X := N.obj (op (Object.mk (K := K) X.unop))
  map f := N.map (opArrow K f.unop 1)
  map_id X := N.map_id _
  map_comp f g := by
    rw [unop_comp, one_comp, N.map_comp]

private def recoverSet (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (N : (Object K)ᵒᵖ ⥤ Type u)
    (hN : Presheaf.IsSheaf J.toGrothendieck (restrictSet K N)) : SetActions J K hK where
  X := ⟨restrictSet K N, hN⟩
  mod :=
    { smul :=
        ⟨{ app := fun X ↦ ↾fun p ↦ N.map (opArrow K (𝟙 X.unop) p.1) p.2
           naturality := by
             intro X Y f
             ext p
             change N.map (opArrow K (𝟙 Y.unop) (K.map f p.1))
                 (N.map (opArrow K f.unop 1) p.2) =
               N.map (opArrow K f.unop 1) (N.map (opArrow K (𝟙 X.unop) p.1) p.2)
             rw [← types_comp_apply, ← types_comp_apply, ← N.map_comp, ← N.map_comp]
             rw [vertical_natural]
             rfl }⟩
      one_smul := by
        ext X p
        change N.map (𝟙 _) p.2 = p.2
        simp
      mul_smul := by
        ext X p
        let a : K.obj X := p.1.1
        let b : K.obj X := p.1.2
        change N.map (opArrow K (𝟙 X.unop) (a * b)) p.2 =
          N.map (opArrow K (𝟙 X.unop) a) (N.map (opArrow K (𝟙 X.unop) b) p.2)
        rw [vertical_mul, N.map_comp]
        rfl }

private def recoverSetMap (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    {N P : (Object K)ᵒᵖ ⥤ Type u}
    (hN : Presheaf.IsSheaf J.toGrothendieck (restrictSet K N))
    (hP : Presheaf.IsSheaf J.toGrothendieck (restrictSet K P)) (f : N ⟶ P) :
    recoverSet J K hK N hN ⟶ recoverSet J K hK P hP :=
  Mod.Hom.mk'
    ⟨{ app := fun X ↦ f.app (op (Object.mk (K := K) X.unop))
       naturality := fun _ _ g ↦ f.naturality (opArrow K g.unop 1) }⟩ (by
    ext X p
    exact f.naturality_apply (opArrow K (𝟙 X.unop) p.1) p.2)

private def recover_counit (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (N : (Object K)ᵒᵖ ⥤ Type u)
    (hN : Presheaf.IsSheaf J.toGrothendieck (restrictSet K N)) :
    extendSet J K hK (recoverSet J K hK N hN) ≅ N :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) (by
    intro X Y f
    ext x
    change N.map (opArrow K (𝟙 Y.unop.base) f.unop.label)
      (N.map (opArrow K f.unop.base 1) x) = N.map f x
    rw [← types_comp_apply, ← N.map_comp, ← arrow_factor]
    rfl)

private theorem restrictSet_isSheaf [HasFiniteLimits C]
    (J : Precoverage C) (hJ : J.IsSiteForCoverings) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (N : Sheaf (topology K J) (Type u)) :
    Presheaf.IsSheaf J.toGrothendieck (restrictSet K N.obj) := by
  let hN : Presheaf.IsSheaf (⊥ : Precoverage C).toGrothendieck (restrictSet K N.obj) := by
    rw [Precoverage.toGrothendieck_bot]
    exact Presheaf.isSheaf_bot _
  exact (extendSet_sheaf_iff ⊥ J hJ K (groupSheafForEmptyCoverage K)
    (recoverSet ⊥ K (groupSheafForEmptyCoverage K) N.obj hN)).mp
    ((Presheaf.isSheaf_of_iso_iff (recover_counit ⊥ K (groupSheafForEmptyCoverage K)
      N.obj hN)).mpr N.property)

private def recover_unit (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (M : SetActions J K hK)
    (hN : Presheaf.IsSheaf J.toGrothendieck (restrictSet K (extendSet J K hK M))) :
    M ≅ recoverSet J K hK (extendSet J K hK M) hN where
  hom := Mod.Hom.mk'
    ⟨{ app := fun X ↦ 𝟙 (M.X.obj.obj X)
       naturality := by
         intro X Y f
         ext x
         change M.X.obj.map f x = setAction J K hK M Y 1 (M.X.obj.map f x)
         exact (action_one J K hK M Y _).symm }⟩ (by
    ext X p
    change setAction J K hK M X p.1 p.2 =
      setAction J K hK M X p.1 (M.X.obj.map (𝟙 X) p.2)
    simp)
  inv := Mod.Hom.mk'
    ⟨{ app := fun X ↦ 𝟙 (M.X.obj.obj X)
       naturality := by
         intro X Y f
         ext x
         change setAction J K hK M Y 1 (M.X.obj.map f x) = M.X.obj.map f x
         exact action_one J K hK M Y _ }⟩ (by
    ext X p
    change setAction J K hK M X p.1 (M.X.obj.map (𝟙 X) p.2) =
      setAction J K hK M X p.1 p.2
    simp)
  hom_inv_id := by ext X x; rfl
  inv_hom_id := by ext X x; rfl

private def forwardSetFunctor (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (L : GrothendieckTopology (Object K))
    (hF : ∀ M : SetActions J K hK, Presheaf.IsSheaf L (extendSet J K hK M)) :
    SetActions J K hK ⥤ Sheaf L (Type u) where
  obj M := ⟨extendSet J K hK M, hF M⟩
  map f := ⟨extendSetMap J K hK f⟩

private def inverseSetFunctor (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (L : GrothendieckTopology (Object K))
    (hR : ∀ N : Sheaf L (Type u),
      Presheaf.IsSheaf J.toGrothendieck (restrictSet K N.obj)) :
    Sheaf L (Type u) ⥤ SetActions J K hK where
  obj N := recoverSet J K hK N.obj (hR N)
  map f := recoverSetMap J K hK (hR _) (hR _) f.hom

private def makeSetEquivalence (J : Precoverage C) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u}))
    (L : GrothendieckTopology (Object K))
    (hF : ∀ M : SetActions J K hK, Presheaf.IsSheaf L (extendSet J K hK M))
    (hR : ∀ N : Sheaf L (Type u),
      Presheaf.IsSheaf J.toGrothendieck (restrictSet K N.obj)) :
    SetActionEquivalenceData J K hK L where
  equivalence :=
    { functor := forwardSetFunctor J K hK L hF
      inverse := inverseSetFunctor J K hK L hR
      unitIso := NatIso.ofComponents
        (fun M ↦ recover_unit J K hK M (hR ((forwardSetFunctor J K hK L hF).obj M)))
        (by intro M N f; ext X x; rfl)
      counitIso := NatIso.ofComponents
        (fun N ↦ ObjectProperty.isoMk _ (recover_counit J K hK N.obj (hR N)))
        (by intro M N f; ext X x; rfl)
      functor_unitIso_comp M := by ext X x; rfl }
  sections M U := Equiv.refl _
  restriction := by intros; rfl
  morphisms := by intros; rfl
  inverseSections N U := Equiv.refl _
  inverse_restriction := by intros; rfl
  inverse_action := by intros; rfl
  inverse_morphisms := by intros; rfl
  unit_sections := by intros; rfl
  counit_sections := by intros; rfl

private theorem base_sheaf_criterion (J : Precoverage C) (hJ : J.IsSiteForCoverings)
    (M : Cᵒᵖ ⥤ Type u) :
    Presheaf.IsSheaf J.toGrothendieck M ↔
      ∀ (U : C) (R : Presieve U), R ∈ J U → Presieve.IsSheafFor M R := by
  rw [isSheaf_iff_isSheaf_of_type]
  constructor
  · intro h U R hR
    exact h.isSheafFor_of_mem_precoverage hR
  · intro h
    rw [J.isSheaf_toGrothendieck_iff]
    intro X Y f R hR
    obtain ⟨I, U, a, rfl⟩ := R.exists_eq_ofArrows
    obtain ⟨P, p, q, hpb, hp⟩ := hJ.2.2 I X U a hR Y f
    rw [← Sieve.ofArrows, ← Sieve.ofArrows_eq_pullback_of_isPullback a hpb,
      Sieve.ofArrows, ← Presieve.isSheafFor_iff_generate]
    exact h Y _ hp

/-- The complete set-valued equivalence, including arbitrary presheaves, every
sieve's matching families, unique amalgamations, and the base sheaf criterion.

Source: internal-action infrastructure below paragraph (3) of
sk-thm-sf-ctf-stability-direct-images; Stacks 00Z8, 00ZC, 00ZD
(blueprint: lem-sfb-internal-action-sheaf-equivalence).

Proof: (1) Use lem-sfb-twisted-site-sieve-geometry for the labeled category and
its covering-sieve correspondence. (2) For a presheaf with natural left action,
put E(X)(f,a)(x)=a f*x. Naturality and associativity give restriction composite
b g*(a f*x)=(b g*a)(fg)*x; equivariant maps give unchanged natural components.
(3) Recover restriction from (f,1) and action from (1,a). Contravariance and the
composition formula give a(bx)=(ab)x, with no commutativity assumption, and
naturality of the recovered action. (4) The factorization of (f,a) through
(f,1) and (1,a) proves both round trips and both morphism constructions are
identities. (5) A matching family z restricts to y_f=z_(f,1); conversely extend
by z_(f,a)=a y_f. The composition calculation proves compatibility, and these
maps are inverse for every sieve. (6) A section amalgamates y exactly when it
amalgamates z, by the same formula and by testing label 1. This preserves both
existence and uniqueness. (7) Apply lem-weil-pbc-pretopology-sheaf-condition on
the base site, whose finite limits give the needed pullbacks, to identify the
covering-family and covering-sieve conditions. No bind-composition axiom for
the labeled precoverage is used. (8) The inverse presheaf constructions thus
restrict to sheaves. Products of sheaves glue coordinatewise, so the recovered
natural action is a sheaf map K times X to X. The small labeled site gives the
claimed small-site presentation, as in def-weil-pbc-topos. -/
theorem setSheafEquivalence [HasFiniteLimits C] (J : Precoverage C)
    (hJ : J.IsSiteForCoverings) (K : Cᵒᵖ ⥤ GrpCat.{u})
    (hK : Presheaf.IsSheaf J.toGrothendieck (K ⋙ forget GrpCat.{u})) :
    ∃ (P : SetActionEquivalenceData (⊥ : Precoverage C) K
        (groupSheafForEmptyCoverage K) ⊥)
      (_E : SetActionEquivalenceData J K hK (topology K J)),
      (∃ matching : ∀ (M : SetActions (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K))
          (U : Object K) (S : Sieve U),
          {z : Presieve.FamilyOfElements (P.equivalence.functor.obj M).obj S.arrows //
            z.Compatible} ≃
          {y : Presieve.FamilyOfElements M.X.obj (labelOneSieve K S).arrows //
            y.Compatible},
        (∀ (M : SetActions (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K))
          (U : Object K) (S : Sieve U)
          (z : {z : Presieve.FamilyOfElements (P.equivalence.functor.obj M).obj S.arrows //
            z.Compatible}) (V : C) (f : V ⟶ U.base) (hf : labelOneSieve K S f),
          (matching M U S z).val f hf =
            P.sections M V (z.val (Arrow.mk f 1) hf)) ∧
        (∀ (M : SetActions (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K))
          (U : Object K) (S : Sieve U)
          (z : {z : Presieve.FamilyOfElements (P.equivalence.functor.obj M).obj S.arrows //
            z.Compatible}) (V : C) (f : V ⟶ U.base) (a : K.obj (op V))
          (ha : S (Arrow.mk f a)) (hf : labelOneSieve K S f),
          P.sections M V (z.val (Arrow.mk f a) ha) =
            setAction (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K) M (op V) a
              ((matching M U S z).val f hf)) ∧
        (∀ (M : SetActions (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K))
          (U : Object K) (S : Sieve U)
          (z : {z : Presieve.FamilyOfElements (P.equivalence.functor.obj M).obj S.arrows //
            z.Compatible})
          (x : (P.equivalence.functor.obj M).obj.obj (op U)),
          z.val.IsAmalgamation x ↔
            (matching M U S z).val.IsAmalgamation (P.sections M U.base x)) ∧
        (∀ (M : SetActions (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K))
          (U : Object K) (S : Sieve U)
          (z : {z : Presieve.FamilyOfElements (P.equivalence.functor.obj M).obj S.arrows //
            z.Compatible}),
          (∃! x, z.val.IsAmalgamation x) ↔
            ∃! y, (matching M U S z).val.IsAmalgamation y)) ∧
      (∀ M : SetActions (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K),
        Presheaf.IsSheaf (topology K J) (P.equivalence.functor.obj M).obj ↔
          Presheaf.IsSheaf J.toGrothendieck M.X.obj) ∧
      (∀ M : Cᵒᵖ ⥤ Type u,
        Presheaf.IsSheaf J.toGrothendieck M ↔
          ∀ (U : C) (R : Presieve U), R ∈ J U → Presieve.IsSheafFor M R) ∧
      IsGrothendieckTopos.{u} (SetActions J K hK) := by
  let P := makeSetEquivalence (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K) ⊥
    (fun M ↦ Presheaf.isSheaf_bot _) (fun N ↦ by
      rw [Precoverage.toGrothendieck_bot]
      exact Presheaf.isSheaf_bot _)
  let E := makeSetEquivalence J K hK (topology K J)
    (fun M ↦ (extendSet_sheaf_iff J J hJ K hK M).mpr M.X.property)
    (restrictSet_isSheaf J hJ K)
  refine ⟨P, E, ?_, ?_, base_sheaf_criterion J hJ, ?_⟩
  · refine ⟨matchingEquiv (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K),
      ?_, ?_, ?_, ?_⟩
    · intro M U S z V f hf
      rfl
    · intro M U S z V f a ha hf
      exact family_label (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K)
        M U S z (Object.mk V) (Arrow.mk f a) ha
    · intro M U S z x
      exact matching_amalgamation (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K)
        M U S z x
    · intro M U S z
      exact matching_unique (⊥ : Precoverage C) K (groupSheafForEmptyCoverage K) M U S z
  · exact extendSet_sheaf_iff (⊥ : Precoverage C) J hJ K (groupSheafForEmptyCoverage K)
  · exact ⟨Object K, inferInstance, topology K J, ⟨E.equivalence⟩⟩

end CategoryTheory.InternalActionSite
