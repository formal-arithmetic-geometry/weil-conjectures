module

public import Sheaf.CategoryTheory.ColimitSiteAbelianStageImage
public import Sheaf.CategoryTheory.ArrowsFunctor
public import Sheaf.CategoryTheory.FinitePrecoverage
import Sheaf.CategoryTheory.ColimitSiteAbelianStageMatchingLift

/-! # Stage-image descent on a filtered colimit of sites

Source: Stacks Project, Sites, Tag 0A35; Modules on Sites, Tag 03CO.
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.Functor.sheafPullbackConstruction
namespace CategoryTheory

/-- The additive subpresheaf generated by restrictions of stage images is a sheaf.
Source: Stacks Project, Sites, Tag 0A35, general-object presentation and finite-cover
paragraphs; abelian extension by Modules on Sites, Tag 03CO.
(blueprint: lem-weil-pbc-colimit-site-abelian-stage-image-sheaf).

Proof: Present an arbitrary limit object by a stage above i. Object and arrow
colimit representatives lift finitely many objects and restriction arrows to a
common stage; eventual equality aligns their endpoints and equalizes alternative
lifts. The stage pullbacks of G have canonical refinement maps, obtained by
transposing the original adjunction units. Uniqueness of adjuncts gives their
identity and composition laws and their compatibility with alpha from h-alpha.
The filtered colimit on presentations therefore defines a presheaf B.
Every Q-cover comes from a finite stage cover. Lift its finite matching diagram
and covering pullbacks to one stage. The stage sheaf equalizers, including the
empty equalizer, commute with the filtered colimit of abelian groups. Hence B is
a sheaf. Transposing a compatible family of maps from its presentation groups
to a sheaf H gives precisely a map G to restriction of H along V i. Conversely,
transpose that map on every presentation; uniqueness of adjuncts verifies the
two inverse identities. Thus B is the inverse image, compatibly with units.
Under this identification its presentation maps are alpha. Every restriction
of a stage image is one such presentation image, and conversely presentation
images are generators (use the identity restriction). Filteredness puts finite
sums and negatives into one presentation group. Consequently the explicitly
defined generated subpresheaf is the image of B in the canonical inverse image.
The unit-compatible comparison just proved is an isomorphism, so this image is
a sheaf. This asserts the sheaf condition only, without choosing a stage for any
section at a prescribed forward image. No data are chosen from mere existence.
-/
theorem colimit_site_abelian_stage_image_isSheaf
    (J : Type u) [SmallCategory J] [IsFiltered J] (F : J ⥤ Cat.{u, u})
    (P : ∀ j : J, Precoverage (F.obj j))
    [∀ j, (P j).HasIsos] [∀ j, (P j).IsStableUnderFiniteComposition]
    [∀ j, (P j).IsStableUnderFiniteBaseChange] [∀ j, (P j).HasPullbacks]
    (hfinite : ∀ (j : J) (X : F.obj j) (R : Presieve X), R ∈ P j X →
      Finite R.uncurry)
    (hcover : ∀ (j k : J) (a : j ⟶ k) (X : F.obj j) (R : Presieve X),
      R ∈ P j X → R.map (F.map a).toFunctor ∈ P k ((F.map a).toFunctor.obj X))
    (hpullback : ∀ (j k : J) (a : j ⟶ k) (X Y Z : F.obj j) (R : Presieve X),
      R ∈ P j X → ∀ (f : Y ⟶ X) (g : Z ⟶ X), R f →
        PreservesLimit (cospan f g) (F.map a).toFunctor)
    [∀ (j k : J) (a : j ⟶ k),
      (F.map a).toFunctor.IsContinuous (P j).toGrothendieck (P k).toGrothendieck]
    (V : Cocone F)
    (hobjects : IsColimit (Cat.objects.mapCocone V))
    (harrows : IsColimit (Cat.arrows.mapCocone V))
    (Q : Precoverage V.pt)
    [Q.HasIsos] [Q.IsStableUnderFiniteComposition]
    [Q.IsStableUnderFiniteBaseChange] [Q.HasPullbacks]
    (hQ : (∀ (Y : V.pt) (R : Presieve Y), R ∈ Q Y ↔
          ∃ (j : J) (X : F.obj j) (S : Presieve X) (h : (V.ι.app j).toFunctor.obj X = Y),
            S ∈ P j X ∧ h ▸ S.map (V.ι.app j).toFunctor = R))
    (hVpullback : (∀ (j : J) (X Y Z : F.obj j) (R : Presieve X), R ∈ P j X →
            ∀ (f : Y ⟶ X) (g : Z ⟶ X), R f →
              PreservesLimit (cospan f g) (V.ι.app j).toFunctor))
    [∀ j : J, (V.ι.app j).toFunctor.IsContinuous
      (P j).toGrothendieck Q.toGrothendieck]
    (i : J) (G : Sheaf (P i).toGrothendieck AddCommGrpCat.{u})
    (α : ∀ t : Under i,
      (sheafPullback (F.map t.hom).toFunctor AddCommGrpCat.{u} (P i).toGrothendieck (P
        t.right).toGrothendieck).obj G ⟶
      ((V.ι.app t.right).toFunctor.sheafPushforwardContinuous AddCommGrpCat.{u} (P
        t.right).toGrothendieck Q.toGrothendieck).obj
        ((sheafPullback (V.ι.app i).toFunctor AddCommGrpCat.{u} (P i).toGrothendieck
          Q.toGrothendieck).obj G))
    (hα : ∀ (t : Under i) (X : F.obj i),
      Arrow.mk (((sheafAdjunctionContinuous (F.map t.hom).toFunctor AddCommGrpCat.{u} (P
        i).toGrothendieck (P t.right).toGrothendieck).unit.app G).hom.app (op X) ≫ (α t).hom.app
        (op ((F.map t.hom).toFunctor.obj X))) =
      Arrow.mk (((sheafAdjunctionContinuous (V.ι.app i).toFunctor AddCommGrpCat.{u} (P
        i).toGrothendieck Q.toGrothendieck).unit.app G).hom.app (op X)))
 :
    Presheaf.IsSheaf Q.toGrothendieck
      (ColimitSiteStageImage.presheaf F P V Q i G α)  := by
  classical
  let H := ColimitSiteStageImage.target F P V Q i G
  let m := Functor.whiskerRight (ColimitSiteStageImage.inclusion F P V Q i G α)
    (forget AddCommGrpCat.{u})
  have hH : Presieve.IsSheaf Q.toGrothendieck (H.obj ⋙ forget AddCommGrpCat.{u}) := by
    rw [← isSheaf_iff_isSheaf_of_type, ← Presheaf.isSheaf_iff_isSheaf_forget]
    exact H.property
  rw [Presheaf.isSheaf_iff_isSheaf_forget (s := forget AddCommGrpCat.{u}),
    isSheaf_iff_isSheaf_of_type]
  intro Y S hS x hx
  obtain ⟨s, hs, huniq⟩ := hH S hS (x.map m) (hx.map m)
  obtain ⟨t, W, T, hT, hY, hTS, y, hy, hxy⟩ :=
    colimit_site_abelian_stage_matching_lift J F P hfinite hcover hpullback
      V hobjects harrows Q hQ hVpullback i G α hα Y S hS x hx
  let A := (sheafPullback (F.map t.hom).toFunctor AddCommGrpCat.{u}
    (P i).toGrothendieck (P t.right).toGrothendieck).obj G
  have hA : Presieve.IsSheaf (P t.right).toGrothendieck
      (A.obj ⋙ forget AddCommGrpCat.{u}) := by
    rw [← isSheaf_iff_isSheaf_of_type, ← Presheaf.isSheaf_iff_isSheaf_forget]
    exact A.property
  obtain ⟨z, hz, _⟩ := hA.isSheafFor_of_mem_precoverage hT y hy
  let Ht := ((V.ι.app t.right).toFunctor.sheafPushforwardContinuous
    AddCommGrpCat.{u} (P t.right).toGrothendieck Q.toGrothendieck).obj H
  have hHt : Presieve.IsSheaf (P t.right).toGrothendieck
      (Ht.obj ⋙ forget AddCommGrpCat.{u}) := by
    rw [← isSheaf_iff_isSheaf_of_type, ← Presheaf.isSheaf_iff_isSheaf_forget]
    exact Ht.property
  have he : (α t).hom.app (op W) z = H.obj.map (eqToHom hY).op s := by
    apply (hHt.isSheafFor_of_mem_precoverage hT).isSeparatedFor.ext
    intro Z g hg
    change H.obj.map ((V.ι.app t.right).toFunctor.map g).op
      ((α t).hom.app (op W) z) =
        H.obj.map ((V.ι.app t.right).toFunctor.map g).op
          (H.obj.map (eqToHom hY).op s)
    have hn := NatTrans.naturality_apply (α t).hom g.op z
    change (α t).hom.app (op Z) (A.obj.map g.op z) =
      H.obj.map ((V.ι.app t.right).toFunctor.map g).op
        ((α t).hom.app (op W) z) at hn
    calc
      _ = (α t).hom.app (op Z) (A.obj.map g.op z) := hn.symm
      _ = (α t).hom.app (op Z) (y g hg) := congrArg _ (hz g hg)
      _ = (x ((V.ι.app t.right).toFunctor.map g ≫ eqToHom hY) (hTS g hg)).val :=
        hxy g hg
      _ = _ := by
        have hh := hs ((V.ι.app t.right).toFunctor.map g ≫ eqToHom hY) (hTS g hg)
        change H.obj.map ((V.ι.app t.right).toFunctor.map g ≫ eqToHom hY).op s =
          (x ((V.ι.app t.right).toFunctor.map g ≫ eqToHom hY) (hTS g hg)).val at hh
        simpa only [op_comp, Functor.map_comp, AddCommGrpCat.comp_apply] using hh.symm
  have hmem : s ∈ ColimitSiteStageImage.subgroup F P V Q i G α (op Y) := by
    apply AddSubgroup.subset_closure
    refine ⟨t, W, eqToHom hY.symm, z, ?_⟩
    change H.obj.map (eqToHom hY.symm).op ((α t).hom.app (op W) z) = s
    rw [he, ← AddCommGrpCat.comp_apply, ← Functor.map_comp]
    simp
  refine ⟨⟨s, hmem⟩, ?_, ?_⟩
  · intro Z f hf
    apply Subtype.ext
    exact hs f hf
  · intro b hb
    apply Subtype.ext
    apply huniq b.val
    intro Z f hf
    exact congrArg Subtype.val (hb f hf)

end CategoryTheory
