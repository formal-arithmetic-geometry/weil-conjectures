module

public import Sheaf.CategoryTheory.Sites.GeometricMorphism
public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Abelian
public import Mathlib.Algebra.Category.Grp.AB
public import Mathlib.CategoryTheory.Adjunction.Additive

/-! # The total site of slices over a simplicial object

Source: Stacks Project, spaces-simplicial.tex, Tags 09WL and 0D70,
section-hypercovering (blueprint: lem-trf-slice-site-simplicial-augmentation).

The comma category gives precisely the arrows in the total slice site. Its
vertical covering families generate the topology. For an augmented object the
projection to the slice over the augmentation target gives inverse image by
precomposition, with no auxiliary choice of a geometric morphism.
-/

@[expose] public noncomputable section
set_option autoImplicit false

universe u v

open CategoryTheory Limits Opposite

namespace CategoryTheory.SimplicialSliceSite

variable {C : Type u} [Category.{v} C]

/-- Objects are pairs consisting of a degree and an object over that degree of `U`;
arrows are the commutative squares over a simplicial operator. Source: Stacks,
section-hypercovering (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
abbrev Total (U : SimplicialObject C) := Comma (𝟭 C) U

/-- The domain of a vertical arrow, with its induced map to `U`. Source: Stacks,
section-hypercovering (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def verticalObj {U : SimplicialObject C} (A : Total U) {V : C} (f : V ⟶ A.left) :
    Total U := ⟨V, A.right, f ≫ A.hom⟩

/-- A vertical arrow stays in the same simplicial degree. Source: Stacks,
section-hypercovering (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def verticalHom {U : SimplicialObject C} (A : Total U) {V : C} (f : V ⟶ A.left) :
    verticalObj A f ⟶ A where
  left := f
  right := 𝟙 A.right
  w := by simp [verticalObj]

/-- Covering families in the total site are the covering families of `C` in one
fixed degree. Source: Stacks, section-hypercovering
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def verticalPrecoverage (J : GrothendieckTopology C) (U : SimplicialObject C) :
    Precoverage (Total U) where
  coverings A := {R | ∃ (ι : Type (max u v)) (V : ι → C) (f : ∀ i : ι, V i ⟶ A.left),
    Sieve.ofArrows V f ∈ J A.left ∧
      R = Presieve.ofArrows (fun i => verticalObj A (f i)) (fun i => verticalHom A (f i))}

/-- The topology generated by the vertical covering families. Source: Stacks,
section-hypercovering (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def topology (J : GrothendieckTopology C) (U : SimplicialObject C) :
    GrothendieckTopology (Total U) := (verticalPrecoverage J U).toGrothendieck

/-- Inclusion of one slice into the total site. Source: Stacks, Tag 09WL
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def component (U : SimplicialObject C) (n : SimplexCategoryᵒᵖ) :
    Over (U.obj n) ⥤ Total U where
  obj V := ⟨V.left, n, V.hom⟩
  map f := { left := f.left, right := 𝟙 n, w := by simp }

/-- A square over a simplicial operator is equivalently a map into the
base-changed slice object. This is the canonical pullback hom-equivalence.
Source: Stacks, Tag 09WL
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
abbrev transitionHomEquiv [HasPullbacks C] (U : SimplicialObject C)
    {p q : SimplexCategoryᵒᵖ} (α : q ⟶ p)
    (V : Over (U.obj q)) (W : Over (U.obj p)) :
    ((Over.map (U.map α)).obj V ⟶ W) ≃
      (V ⟶ (Over.pullback (U.map α)).obj W) :=
  (Over.mapPullbackAdj (U.map α)).homEquiv V W

/-- Base change along every simplicial operator is continuous; restriction to
a degree of the total site also preserves sheaves. Together with the explicit
comma site and `transitionHomEquiv`, this is the slice-site construction.
The identity and cocycle identifications are Mathlib's `Over.pullbackId`,
`Over.pullbackComp` and `GrothendieckTopology.overMapPullbackId`,
`overMapPullbackComp`, with coherence `overMapPullback_comp_id`,
`overMapPullback_id_comp`, `overMapPullback_assoc`.
Proof: localized covering families are precisely underlying covering families.
Base change preserves these by the site base-change axiom. Gluing on the total
site is therefore exactly gluing on every slice; transitions are the functor's
restriction maps. The pullback universal property identifies arrows with the
base-change formulation, and uniqueness of the universal arrows gives all
identity and cocycle laws. Source: Stacks, Tag 09WL and section-hypercovering
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
theorem sliceSiteSimplicialAugmentation [HasPullbacks C]
    (J : GrothendieckTopology C) (U : SimplicialObject C) :
    (∀ (p q : SimplexCategoryᵒᵖ) (α : q ⟶ p),
      (Over.pullback (U.map α)).IsContinuous (J.over (U.obj p)) (J.over (U.obj q))) ∧
    (∀ n : SimplexCategoryᵒᵖ,
      (component U n).IsContinuous (J.over (U.obj n)) (topology J U)) := by
  sorry

/-- Restriction to a degree of the total site preserves sheaves. Source: Stacks,
Tag 09WL (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance component_isContinuous [HasPullbacks C] (J : GrothendieckTopology C)
    (U : SimplicialObject C) (n : SimplexCategoryᵒᵖ) :
    (component U n).IsContinuous (J.over (U.obj n)) (topology J U) :=
  (sliceSiteSimplicialAugmentation J U).2 n

/-- Component restriction on sheaves of values in `A`. Source: Stacks, Tag 09WL
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
abbrev componentRestriction [HasPullbacks C] (J : GrothendieckTopology C)
    (U : SimplicialObject C) (n : SimplexCategoryᵒᵖ)
    (A : Type (max u v + 1)) [Category.{max u v} A] :
    Sheaf (topology J U) A ⥤ Sheaf (J.over (U.obj n)) A :=
  (component U n).sheafPushforwardContinuous A _ _

/-- The underlying simplicial object of an object augmented to `X`. Source: Stacks,
Tag 0D70 (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
abbrev underlying {X : C} (U : SimplicialObject (Over X)) : SimplicialObject C :=
  U ⋙ Over.forget X

/-- The augmentation projection sends `(n,V → U_n)` to `V → U_n → X`.
Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def projection {X : C} (U : SimplicialObject (Over X)) :
    Total (underlying U) ⥤ Over X where
  obj A := Over.mk (A.hom ≫ (U.obj A.right).hom)
  map {A B} f := Over.homMk f.left (by
    have h : f.left ≫ B.hom = A.hom ≫ (U.map f.right).left := f.w
    change f.left ≫ (B.hom ≫ (U.obj B.right).hom) = _
    rw [← Category.assoc, h, Category.assoc, Over.w]
    rfl)
  map_id A := by ext; rfl
  map_comp f g := by ext; rfl

/-- The projection preserves sheaves by precomposition. Proof: a covering family
in one degree maps to the same covering family in `C/X`; compatible sections
therefore glue uniquely. The same verification after base change identifies the
slice topology. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
theorem projection_isContinuous [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (projection U).IsContinuous (topology J (underlying U)) (J.over X) := by
  sorry

attribute [instance] projection_isContinuous

/-- Restriction along the augmentation projection. Its sections at `(n,V → U_n)`
are exactly the sections at `V → X`; the transitions are composition in `C/X`.
Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
abbrev inverse [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) (A : Type (max u v + 1)) [Category.{max u v} A] :
    Sheaf (J.over X) A ⥤ Sheaf (topology J (underlying U)) A :=
  (projection U).sheafPushforwardContinuous A _ _

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The component of augmentation inverse image is the localization inverse
image, canonically, including all restriction maps. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def inverseComponentIso [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) (n : SimplexCategoryᵒᵖ)
    (A : Type (max u v + 1)) [Category.{max u v} A] :
    inverse J U A ⋙ componentRestriction J (underlying U) n A ≅
      J.overMapPullback A (U.obj n).hom :=
  NatIso.ofComponents (fun E => ObjectProperty.isoMk _
    (NatIso.ofComponents (fun V => Iso.refl _) (by
      intro V W f
      dsimp
      simp only [Category.comp_id, Category.id_comp]
      rfl))) (by
        intro E F f
        ext V
        dsimp
        erw [Category.comp_id, Category.id_comp]
        rfl)

/-- Localization direct image is precomposition with base change. In particular,
its sections at `W/X` are `F(W ×_X U_n/U_n)`.
Proof: the base-change functor is continuous and is right adjoint on slice
categories to composition with the augmentation map. Transposing the slice
hom-equivalence gives the sheaf adjunction, since both precompositions preserve
sheaves. This identifies localization and the base-change morphism of sites.
Source: Stacks, Sites Tag 09W9, as used in Tag 09WL
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
theorem component_localization_adjunction [HasPullbacks C]
    (J : GrothendieckTopology C) {X : C} (U : SimplicialObject (Over X))
    (n : SimplexCategoryᵒᵖ) (A : Type (max u v + 1)) [Category.{max u v} A] :
    Nonempty (J.overMapPullback A (U.obj n).hom ⊣
      (Over.pullback (U.obj n).hom).sheafPushforwardContinuous A
        (J.over X) (J.over (U.obj n).left)) := by
  sorry

/-- The inverse image on sets has a right adjoint and preserves finite limits.
Proof: use the cocontinuous projection of Tag 0D70 and its induced geometric
morphism; precomposition is its inverse image, hence left exact. Source: Stacks,
Tag 0D70 (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
theorem inverse_sets_properties [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (inverse J U (Type (max u v))).IsLeftAdjoint ∧
      PreservesFiniteLimits (inverse J U (Type (max u v))) := by
  sorry

/-- The exact inverse image on abelian sheaves has a right adjoint.
Proof: the geometric morphism of Tag 0D70 induces an adjunction on abelian group
objects. Its inverse image is the same precomposition; it preserves finite limits
and, being a left adjoint, colimits, and is additive. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
theorem inverse_abelian_properties [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (inverse J U AddCommGrpCat.{max u v}).IsLeftAdjoint ∧
      PreservesFiniteLimits (inverse J U AddCommGrpCat.{max u v}) ∧
      PreservesFiniteColimits (inverse J U AddCommGrpCat.{max u v}) ∧
      (inverse J U AddCommGrpCat.{max u v}).Additive := by
  sorry

/-- The left adjoint structure on the specified inverse image, not a choice of
an arbitrary map. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance inverse_sets_isLeftAdjoint [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (inverse J U (Type (max u v))).IsLeftAdjoint := (inverse_sets_properties J U).1

/-- Left exactness of the inverse image on sets. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance inverse_sets_preservesFiniteLimits [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    PreservesFiniteLimits (inverse J U (Type (max u v))) := (inverse_sets_properties J U).2

/-- The augmentation's geometric morphism, whose right adjoint is determined by
its explicit inverse image. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def geometricMorphism [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    GeometricMorphism (Sheaf (topology J (underlying U)) (Type (max u v)))
      (Sheaf (J.over X) (Type (max u v))) where
  inverse := inverse J U (Type (max u v))
  direct := (inverse J U (Type (max u v))).rightAdjoint
  adj := Adjunction.ofIsLeftAdjoint _
  leftExact := inferInstance

/-- The inverse image on abelian sheaves is a left adjoint. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance inverse_abelian_isLeftAdjoint [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (inverse J U AddCommGrpCat.{max u v}).IsLeftAdjoint := (inverse_abelian_properties J U).1

/-- Exactness on abelian sheaves: finite limits. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance inverse_abelian_preservesFiniteLimits [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    PreservesFiniteLimits (inverse J U AddCommGrpCat.{max u v}) :=
  (inverse_abelian_properties J U).2.1

/-- Exactness on abelian sheaves: finite colimits. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance inverse_abelian_preservesFiniteColimits [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    PreservesFiniteColimits (inverse J U AddCommGrpCat.{max u v}) :=
  (inverse_abelian_properties J U).2.2.1

/-- Additivity of restriction on abelian sheaves. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance inverse_abelian_additive [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (inverse J U AddCommGrpCat.{max u v}).Additive :=
  (inverse_abelian_properties J U).2.2.2

/-- The ordinary augmentation adjunction on abelian sheaves. Its inverse image is
specified sectionwise and its right adjoint is unique up to adjunction-compatible
isomorphism. Source: Stacks, Tag 0D70
(blueprint: lem-trf-slice-site-simplicial-augmentation). -/
def abelianAdjunction [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    inverse J U AddCommGrpCat.{max u v} ⊣ (inverse J U AddCommGrpCat.{max u v}).rightAdjoint :=
  Adjunction.ofIsLeftAdjoint _

/-- The direct image on abelian sheaves is additive by adjunction. Source: Stacks,
Tag 0D70 (blueprint: lem-trf-slice-site-simplicial-augmentation). -/
instance direct_abelian_additive [HasPullbacks C] (J : GrothendieckTopology C)
    {X : C} (U : SimplicialObject (Over X)) :
    (inverse J U AddCommGrpCat.{max u v}).rightAdjoint.Additive :=
  (abelianAdjunction J U).right_adjoint_additive

end CategoryTheory.SimplicialSliceSite
