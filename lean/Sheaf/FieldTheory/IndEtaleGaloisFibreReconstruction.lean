module

public import WeilConjectures.Mathlib.FieldTheory.IsSepClosed
public import Sheaf.RingTheory.IndEtaleUniverseTransport
public import Sheaf.Topology.InvariantDiscreteQuotient
public import Mathlib.FieldTheory.KrullTopology
import WeilConjectures.AlgebraicGeometry.GroupScheme.Defs
import WeilConjectures.FieldTheory.EtaleFieldGaloisClassification
import Mathlib.Topology.Category.Profinite.CofilteredLimit
import Sheaf.Topology.ProfiniteActionFiniteQuotients

/-! # Reconstruction of ind-étale algebras from profinite Galois fibres

Source: Bhatt–Scholze, The pro-étale topology for schemes, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction)

The topology is generated by restriction to all finite étale subalgebras. The
quotient index uses the existing invariant discrete quotients, ordered with finer
partitions smaller. Algebra transition maps therefore run in the opposite direction.
Equivariance on quotient sets is expressed on representatives, so that no choice
of a quotient action is required. Universes for algebras and spaces are explicit.
-/

@[expose] public section

set_option autoImplicit false

universe u v w z

open CategoryTheory CategoryTheory.Limits

namespace FieldTheory

/-- The inverse-limit topology on the set of geometric algebra points: each restriction
into the finite discrete fibre of a finite étale subalgebra is continuous.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction) -/
@[instance_reducible]
def indEtaleGaloisFibreTopology (k : Type u) (Ω : Type v) (B : Type w)
    [Field k] [Field Ω] [Algebra k Ω] [CommRing B] [Algebra k B] :
    TopologicalSpace (B →ₐ[k] Ω) :=
  ⨅ S : {S : Subalgebra k B // Module.Finite k S ∧ Algebra.Etale k S},
    TopologicalSpace.induced (fun f : B →ₐ[k] Ω ↦ f.comp S.val.val) ⊥

/-- Continuous equivariant maps of geometric fibres, with the specified inverse-limit
rather than an unspecified topology. The action is postcomposition by an automorphism.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction) -/
def IndEtaleGaloisFibreMap (k : Type u) (Ω : Type v) (B : Type w) (C : Type z)
    [Field k] [Field Ω] [Algebra k Ω] [CommRing B] [Algebra k B]
    [CommRing C] [Algebra k C] :=
  {f : (B →ₐ[k] Ω) → (C →ₐ[k] Ω) //
    @Continuous _ _ (indEtaleGaloisFibreTopology k Ω B)
      (indEtaleGaloisFibreTopology k Ω C) f ∧
    ∀ (g : Gal(Ω/k)) (x : B →ₐ[k] Ω), f (g.toAlgHom.comp x) = g.toAlgHom.comp (f x)}

/-- Coherent transition maps on a fixed family of finite-quotient algebras. The order
on partitions is refinement, so a refinement `i ≤ j` gives the algebra map `A j → A i`.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction) -/
structure GaloisQuotientAlgebraSystem {k : Type u} [Field k]
    {I : Type w} [Preorder I] (A : I → CommAlgCat.{z} k) where
  /-- Maps contravariant in partition refinement. -/
  map (i j : I) (h : i ≤ j) : A j →ₐ[k] A i
  /-- Identity quotient maps induce identity algebra maps. -/
  map_id (i : I) : map i i le_rfl = AlgHom.id k (A i)
  /-- Successive refinements induce the composite algebra map. -/
  map_comp (i j l : I) (h : i ≤ j) (h' : j ≤ l) :
    map i l (h.trans h') = (map i j h).comp (map j l h')

/-- The filtered algebra diagram specified by coherent transition maps, with its actual
algebra maps. Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction) -/
def GaloisQuotientAlgebraSystem.diagram {k : Type u} [Field k]
    {I : Type w} [Preorder I] {A : I → CommAlgCat.{z} k}
    (t : GaloisQuotientAlgebraSystem A) : Iᵒᵖ ⥤ CommAlgCat.{z} k where
  obj i := A i.unop
  map f := CommAlgCat.ofHom (t.map _ _ f.unop.le)
  map_id i := congrArg CommAlgCat.ofHom (t.map_id i.unop)
  map_comp f g := congrArg CommAlgCat.ofHom (t.map_comp _ _ _ g.unop.le f.unop.le)

/-- Precomposition by every algebra map is continuous on geometric fibres.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction)

Proof: put the image of each finite étale subalgebra of C into a finite étale
subalgebra of B, using the finite-subalgebra presentation of
lem-sfb-field-geometric-fibre-construction. Restriction then factors through a
finite discrete fibre, proving continuity. Postcomposition commutes with restriction.
This also applies to the zero algebras, whose fibres are empty. -/
theorem indEtaleGaloisFibre_precomp_continuous
    (k : Type u) (Ω : Type v) [Field k] [Field Ω] [Algebra k Ω] [IsSepClosure k Ω]
    (B : Type w) (C : Type z) [CommRing B] [Algebra k B] [CommRing C] [Algebra k C]
    (hB : (algebraMap k B).IndEtaleAcrossUniverses)
    (hC : (algebraMap k C).IndEtaleAcrossUniverses) (α : C →ₐ[k] B) :
    @Continuous _ _ (indEtaleGaloisFibreTopology k Ω B)
      (indEtaleGaloisFibreTopology k Ω C) (fun f : B →ₐ[k] Ω ↦ f.comp α) := by
  sorry

/-- The canonical map on geometric fibres induced by an algebra homomorphism.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction) -/
def indEtaleGaloisFibrePrecomp
    (k : Type u) (Ω : Type v) [Field k] [Field Ω] [Algebra k Ω] [IsSepClosure k Ω]
    (B : Type w) (C : Type z) [CommRing B] [Algebra k B] [CommRing C] [Algebra k C]
    (hB : (algebraMap k B).IndEtaleAcrossUniverses)
    (hC : (algebraMap k C).IndEtaleAcrossUniverses) (α : C →ₐ[k] B) :
    IndEtaleGaloisFibreMap k Ω B C :=
  ⟨fun f ↦ f.comp α, indEtaleGaloisFibre_precomp_continuous k Ω B C hB hC α,
    fun _ _ ↦ rfl⟩

/-- Full faithfulness of the geometric fibre construction, including zero algebras.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction)

Proof: finite étale algebras are products of finite separable fields
(lem-sc-finite-etale-algebra-criterion); idempotents describe their geometric points
as disjoint unions. Apply lem-exc-etale-field-galois-classification on each orbit
for the finite-stage Hom bijection. The directed finite-subalgebra presentation
and surjective fibre projections of lem-sfb-field-geometric-fibre-construction
show that geometric points separate elements. By
lem-weil-pbc-profinite-limit-function-factorization, a continuous map to any finite
fibre factors through a finite stage. Surjectivity of the fibre projection makes
this factorization equivariant. The finite Hom bijection supplies compatible maps
on the finite subalgebras of C. Assemble these to an algebra map C → B. Separation
of elements proves uniqueness. For B=0 both Hom sets are singleton; for B nonzero
and C=0 both are empty. This includes B=C=0. -/
theorem indEtaleGaloisFibrePrecomp_bijective
    (k : Type u) (Ω : Type v) [Field k] [Field Ω] [Algebra k Ω] [IsSepClosure k Ω]
    (B : Type w) (C : Type z) [CommRing B] [Algebra k B] [CommRing C] [Algebra k C]
    (hB : (algebraMap k B).IndEtaleAcrossUniverses)
    (hC : (algebraMap k C).IndEtaleAcrossUniverses) :
    Function.Bijective (indEtaleGaloisFibrePrecomp k Ω B C hB hC) := by
  sorry

/-- Finite quotient algebras exist, and every choice reconstructs the prescribed
profinite Galois space by a unique coherent algebra diagram and its filtered colimit.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction)

Proof:
1. Decompose each finite quotient into orbits and use the converse of
   lem-exc-etale-field-galois-classification. Take the product of the corresponding
   fields; the empty quotient gives the empty product, the zero algebra. These are
   finite étale by lem-sc-finite-etale-algebra-criterion.
2. The finite Hom bijection gives a unique algebra transition map for every
   quotient projection. Faithfulness gives identity and composition laws, and
   uniqueness among all systems inducing the quotient maps.
3. Each transition is injective because the corresponding fibre map is surjective
   and finite-stage geometric points separate elements.
4. Form the filtered algebra colimit. Its stages are finite étale, so it is
   ind-étale by def-weil-pbc-ind-etale-algebra. Injectivity identifies the stages
   with subalgebras; a finite basis puts any finite subalgebra in one stage.
5. A compatible family of geometric points gives a colimit homomorphism by
   [(i,a)] ↦ f_i(a). This is an inverse to restriction. The subbasis of finite-stage
   restrictions identifies the two topologies, since the stages are cofinal.
6. Compose the resulting equivariant homeomorphism with the inverse of the
   partition-limit homeomorphism of lem-sfb-profinite-action-finite-quotients.
   Its projections are exactly the specified finite-stage identifications.
7. If P is empty its unique partition has empty quotient; its algebra and the
   colimit are zero, and every compatibility is the unique empty map. -/
theorem indEtaleGaloisFibre_reconstruction
    (k : Type u) (Ω : Type v) [Field k] [Field Ω] [Algebra k Ω] [IsSepClosure k Ω]
    (P : Type w) [TopologicalSpace P] [CompactSpace P] [T2Space P]
    [TotallyDisconnectedSpace P] [MulAction (Gal(Ω/k)) P] [ContinuousSMul (Gal(Ω/k)) P] :
    (∃ (A : InvariantDiscreteQuotient (Gal(Ω/k)) P → CommAlgCat.{max u w} k)
        (θ : ∀ i, (A i →ₐ[k] Ω) ≃ i.val),
      (∀ i, Module.Finite k (A i) ∧ Algebra.Etale k (A i)) ∧
      ∀ i (g : Gal(Ω/k)) (f : A i →ₐ[k] Ω) (p : P),
        θ i f = i.val.proj p → θ i (g.toAlgHom.comp f) = i.val.proj (g • p)) ∧
    (∀ (A : InvariantDiscreteQuotient (Gal(Ω/k)) P → CommAlgCat.{max u w} k)
        (θ : ∀ i, (A i →ₐ[k] Ω) ≃ i.val),
      (∀ i, Module.Finite k (A i) ∧ Algebra.Etale k (A i)) →
      (∀ i (g : Gal(Ω/k)) (f : A i →ₐ[k] Ω) (p : P),
        θ i f = i.val.proj p → θ i (g.toAlgHom.comp f) = i.val.proj (g • p)) →
      ∃ t : GaloisQuotientAlgebraSystem A,
        (∀ t' : GaloisQuotientAlgebraSystem A,
          (∀ i j (h : i ≤ j) (f : A i →ₐ[k] Ω),
            θ j (f.comp (t'.map i j h)) = DiscreteQuotient.ofLE h (θ i f)) ↔ t' = t) ∧
        (∃ c : Cocone t.diagram, Nonempty (IsColimit c)) ∧
        ∀ c : Cocone t.diagram, IsColimit c →
          (algebraMap k c.pt).IndEtaleAcrossUniverses ∧
          ∃ e : @Homeomorph (c.pt →ₐ[k] Ω) P (indEtaleGaloisFibreTopology k Ω c.pt)
              inferInstance,
            (∀ (g : Gal(Ω/k)) (f : c.pt →ₐ[k] Ω),
              e (g.toAlgHom.comp f) = g • e f) ∧
            ∀ (i : InvariantDiscreteQuotient (Gal(Ω/k)) P) (f : c.pt →ₐ[k] Ω),
              i.val.proj (e f) = θ i (f.comp (c.ι.app (Opposite.op i)).hom)) := by
  sorry

/-- The empty-space case is realized by any zero algebra, with its specified fibre topology.
Source: Bhatt–Scholze, Example 4.1.10, p. 28.
(blueprint: lem-sfb-ind-etale-galois-fibre-reconstruction)

Proof: a unital homomorphism from a zero ring to the field Ω would imply 0=1.
Thus its fibre is empty. For empty P the unique empty function is an equivariant
homeomorphism, and the zero algebra is finite étale, hence ind-étale. -/
theorem indEtaleGaloisFibre_zero
    (k : Type u) (Ω : Type v) [Field k] [Field Ω] [Algebra k Ω] [IsSepClosure k Ω]
    (B : Type z) [CommRing B] [Algebra k B] [Subsingleton B] :
    IsEmpty (B →ₐ[k] Ω) ∧ (algebraMap k B).IndEtaleAcrossUniverses ∧
    ∀ (P : Type w) [TopologicalSpace P] [IsEmpty P] [MulAction (Gal(Ω/k)) P],
      ∃ e : @Homeomorph (B →ₐ[k] Ω) P (indEtaleGaloisFibreTopology k Ω B) inferInstance,
        ∀ (g : Gal(Ω/k)) (f : B →ₐ[k] Ω), e (g.toAlgHom.comp f) = g • e f := by
  sorry

end FieldTheory
