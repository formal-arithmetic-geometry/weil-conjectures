import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.Algebra.Module.LocalizedModule.Basic

/-!
# Complete-intersection models of finitely generated fields

Source: Stacks Project, Algebra, proof of Tag 07BV, and More on Algebra, proof of Tag 07E1
(blueprint: lem-weil-pbc-finitely-generated-field-complete-intersection-model).
-/

universe u v

namespace FieldTheory

/-- A finitely generated extension with a transcendence basis of size `d` is the fraction
field of a quotient of a polynomial ring in `n` variables by a regular sequence of length
`c`, with `n - c = d`. Source: Stacks Project, proof of Tag 07BV, as used in Tag 07E1
(blueprint: lem-weil-pbc-finitely-generated-field-complete-intersection-model).

Proof plan (the ten steps of the node):
1. Using `def-weil-pbc-transcendence-basis`, identify the polynomial ring on `x` with
   `k[x]`, whose fraction field is `F = k(x)`. Form the tower `L_i = F(b_1,...,b_i)`;
   its last field is `K`, and each generator is algebraic over the preceding field.
2. The minimal-polynomial quotient isomorphisms
   (`lem-weil-pbc-minimal-polynomial-quotient-field-iso`), monic quotient bases
   (`lem-weil-pbc-monic-quotient-free`), and `lem-weil-pbc-tower-product-basis` give
   an `F`-basis of bounded monomials in the generators.
3. Lift coefficients of the minimal polynomials to polynomials in preceding generators
   to obtain triangular polynomials `P_i`, monic in `Y_i`, vanishing in `K`.
4. Clear their finitely many denominators by a nonzero `h` in `k[x]`, obtaining
   coefficients in `D = k[x,1/h]` while preserving monicity.
5. By `lem-weil-pbc-localization-away-polynomial-quotient`, present `D[Y]` using
   `h T - 1` and lift the `P_i` to monic polynomials in `k[X,T,Y]`. Take
   `n = d + 1 + r`, `c = r + 1`.
6. Successive monic quotients and the tower product basis show that
   `B_i = D[Y_1,...,Y_i]/(P_1,...,P_i)` is free on the bounded monomials.
7. Their images are the linearly independent monomials from step 2, proving that
   `B_r → K` is injective. Clear denominators of any linear combination in `K` to
   write it as a fraction of elements of `B_r`.
8. The surjective presentation in step 5 has kernel generated by the lifted equations,
   so its quotient `A` is isomorphic to `B_r`; transfer the map and its properties.
9. The polynomial ring is a domain (`lem-weil-pbc-polynomial-ring-domain`), so
   `h T - 1` is a nonzerodivisor. Each subsequent equation is monic in a new variable,
   hence a nonzerodivisor by `lem-weil-pbc-monic-polynomial-nonzerodivisor`.
   The final quotient embeds in `K` and is nonzero: this is a regular sequence.
10. The embedding makes `A` a domain. The localization map on fractions is well defined
    and injective since nonzero denominators have nonzero images, and surjective by
    step 7. It is the asserted `k`-algebra isomorphism. -/
theorem exists_completeIntersection_fractionField_model
    (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K]
    (hfg : ∃ (m : ℕ) (b : Fin m → K), IntermediateField.adjoin k (Set.range b) = ⊤)
    (d : ℕ) (x : Fin d → K) (hx : IsTranscendenceBasis k x) :
    ∃ (n c : ℕ) (f : List (MvPolynomial (Fin n) k)),
      c ≤ n ∧ n - c = d ∧ f.length = c ∧
      RingTheory.Sequence.IsRegular (MvPolynomial (Fin n) k) f ∧
      let A := MvPolynomial (Fin n) k ⧸ Ideal.ofList f
      ∃ (ι : A →ₐ[k] K),
        Function.Injective ι ∧
        (∀ z : K, ∃ a s : A, s ≠ 0 ∧ z = ι a * (ι s)⁻¹) ∧
        IsDomain A ∧
        ∃ e : FractionRing A ≃ₐ[k] K,
          ∀ (a : A) (s : nonZeroDivisors A),
            e (LocalizedModule.mk a s) = ι a * (ι s)⁻¹ := by
  sorry

end FieldTheory
