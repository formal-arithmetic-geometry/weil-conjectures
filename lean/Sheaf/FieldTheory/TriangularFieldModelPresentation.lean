module

public import Sheaf.FieldTheory.TriangularFieldModelEquations
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.Algebra.Polynomial.Monic
import Sheaf.FieldTheory.TriangularFieldModelEvaluationKernel

/-!
# Triangular presentations inside finitely generated fields

Source: Stacks Project, proof of Tag 07BV (the first assertion), using the presentation
from Tag 08JZ (blueprint: lem-weil-pbc-triangular-field-model-presentation).
-/

@[expose] public section

universe u v

namespace FieldTheory

/-- The tower of minimal polynomials gives a triangular presentation embedded in `K`,
whose elements give all fractions in `K`. This asserts no regularity of the equations.
Source: Stacks Project, Algebra, proof of Tag 07BV, with the presentation of Tag 08JZ
(blueprint: lem-weil-pbc-triangular-field-model-presentation).

Proof:
1. Take a generating family `b` from `hfg`. The evaluation-kernel lemma constructs
   the triangular monic equations and variable values `y`, with the displayed
   ideal exactly equal to the kernel of evaluation. It does not assert fraction
   representations of arbitrary elements of `K`.
2. Descend evaluation using `Ideal.Quotient.liftₐ`. The kernel equality gives
   injectivity by `RingHom.lift_injective_of_ker_le_ideal`. Every `b i` belongs to
   the evaluation range, as the image of its corresponding polynomial variable.
   Hence the algebra generated by `b` is contained in that range.
3. Since the field generated by `b` is `K`, `IntermediateField.mem_adjoin_iff_div`
   writes every `z` as `a / s` with `a,s` in the algebra generated by `b`.
   If `s = 0`, then `z = 0`; use numerator zero and denominator one. One is
   nonzero in the quotient because the unital evaluation map takes it to one
   in the field `K`. Otherwise choose polynomial preimages of `a,s` in the
   evaluation range and take their quotient classes. If the denominator class
   were zero its evaluation would give `s = 0`, a contradiction. Evaluation
   of the quotient classes gives the required fraction identity.
This fraction argument needs neither a monomial expansion of arbitrary `z`
nor a further common-denominator lemma. Empty families and inseparable
extensions are included. -/
theorem exists_triangularFieldModel_presentation
    (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K]
    (hfg : ∃ (m : ℕ) (b : Fin m → K), IntermediateField.adjoin k (Set.range b) = ⊤)
    (d : ℕ) (x : Fin d → K) (hx : IsTranscendenceBasis k x) :
    ∃ (r : ℕ) (h : MvPolynomial (Fin d) k)
      (p : (i : Fin r) → Polynomial (MvPolynomial (Fin (d + 1 + i.val)) k)),
      h ≠ 0 ∧ (∀ i, (p i).Monic) ∧
      let A := MvPolynomial (Fin (d + 1 + r)) k ⧸
        Ideal.ofList (triangularFieldModelEquations k d r h p)
      ∃ (ι : A →ₐ[k] K), Function.Injective ι ∧
        ∀ z : K, ∃ a s : A, s ≠ 0 ∧ z = ι a * (ι s)⁻¹ := by
  classical
  obtain ⟨m, b, hb⟩ := hfg
  obtain ⟨h, p, y, hh, hp, _, _, hy, hker⟩ :=
    exists_triangularFieldModel_evaluation_kernel k K d x hx m b
  refine ⟨m, h, p, hh, hp, ?_⟩
  let I := Ideal.ofList (triangularFieldModelEquations k d m h p)
  let ev : MvPolynomial (Fin (d + 1 + m)) k →ₐ[k] K := MvPolynomial.aeval y
  have hI : ∀ q, q ∈ I → ev q = 0 := by
    intro q hq
    exact RingHom.mem_ker.mp (hker.symm ▸ hq)
  let ι : MvPolynomial (Fin (d + 1 + m)) k ⧸ I →ₐ[k] K :=
    Ideal.Quotient.liftₐ I ev hI
  have hι : Function.Injective ι :=
    RingHom.lift_injective_of_ker_le_ideal I hI (le_of_eq hker)
  have hbmem : Set.range b ⊆ ev.range := by
    rintro _ ⟨i, rfl⟩
    exact ⟨MvPolynomial.X ⟨d + 1 + i.val, by omega⟩, by simpa [ev] using hy i⟩
  have hadjoin : Algebra.adjoin k (Set.range b) ≤ ev.range :=
    Algebra.adjoin_le hbmem
  refine ⟨ι, hι, ?_⟩
  intro z
  have hz : z ∈ IntermediateField.adjoin k (Set.range b) := by
    rw [hb]
    trivial
  obtain ⟨a, ha, s, hs, hzs⟩ := IntermediateField.mem_adjoin_iff_div.mp hz
  by_cases hsz : s = 0
  · have hz0 : z = 0 := by simpa [hsz] using hzs
    refine ⟨0, 1, ?_, ?_⟩
    · intro h01
      have : (1 : K) = 0 := by
        calc
          (1 : K) = ι 1 := (map_one ι).symm
          _ = ι 0 := congrArg ι h01
          _ = 0 := map_zero ι
      exact one_ne_zero this
    · simp [hz0]
  · obtain ⟨a', ha'⟩ := hadjoin ha
    obtain ⟨s', hs'⟩ := hadjoin hs
    refine ⟨Ideal.Quotient.mk I a', Ideal.Quotient.mk I s', ?_, ?_⟩
    · intro hs0
      apply hsz
      calc
        s = ev s' := hs'.symm
        _ = ι (Ideal.Quotient.mk I s') := rfl
        _ = ι 0 := congrArg ι hs0
        _ = 0 := map_zero ι
    · change ev a' = a at ha'
      change ev s' = s at hs'
      change z = ev a' * (ev s')⁻¹
      rw [ha', hs']
      exact hzs.trans (div_eq_mul_inv a s)

end FieldTheory
