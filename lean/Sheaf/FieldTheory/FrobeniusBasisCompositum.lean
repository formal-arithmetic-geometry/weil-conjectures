module

public import Mathlib.Algebra.Field.Subfield.Basic
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.Algebra.CharP.Basic

import Mathlib.Algebra.CharP.Lemmas
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-! # Frobenius basis span of a compositum

Source: Stacks Project, More on Algebra, Tag 07P4, proof of (2), the displayed
coefficient presentations, generalized from power bases to any finite basis.
(blueprint: lem-weil-pbc-frobenius-basis-compositum)
-/

@[expose] public section
set_option autoImplicit false
universe u v

namespace FieldTheory

/-- The Frobenius image of a finite basis spans the compositum over any subfield
containing the base Frobenius image. This span need not be direct.

Source: Stacks Project, More on Algebra, Tag 07P4 (`lemma-intersection-subfields`),
proof of (2), the displayed coefficient presentations. This is their span assertion
with an arbitrary finite basis instead of a power basis; no family or intersection
hypothesis is involved.
(blueprint: lem-weil-pbc-frobenius-basis-compositum)

Proof:
Put b_i = e_i^p. Expanding any y in the finite K-basis e and applying Frobenius
shows that L^p is the K^p-span of b. In particular 1 and every product b_i b_j
have expansions in b with coefficients in K^p. Let W be the S-span of b in L.
These expansions show that W contains 1 and is closed under multiplication:
expand each product of two linear combinations using the expansions of b_i b_j.
It contains the image of S and L^p. It is generated by finitely many b_i as an
S-vector space. Multiplication by a nonzero w in W is an injective S-linear
endomorphism of W. Map an S-basis of W by this injection: its image is an independent
family of dim W elements, hence a basis, so the endomorphism is surjective. Its
preimage of 1 gives w's inverse. Thus W is a subfield containing the generators
of the compositum. Conversely every subfield containing those generators contains
each b_i and every S-linear combination of the b_i. The two containments identify
W with the subfield closure, proving the asserted coefficient description.
No independence over S is used, including when S contains a p-th power basis vector. -/
theorem frobenius_basis_compositum
    (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p]
    (L : Type v) [Field L] [CharP L p] [Algebra K L]
    {n : ℕ} (e : Module.Basis (Fin n) K L)
    (S : Subfield K) (hS : Set.range (fun y : K ↦ y ^ p) ⊆ (S : Set K))
    (x : L) :
    x ∈ Subfield.closure (Set.range (fun y : L ↦ y ^ p) ∪
      algebraMap K L '' (S : Set K)) ↔
      ∃ c : Fin n → K, (∀ i, c i ∈ S) ∧
        x = ∑ i, algebraMap K L (c i) * (e i) ^ p := by
  classical
  have hscalar (a : S) (y : L) : a • y = algebraMap K L (a : K) * y := by
    rw [Algebra.smul_def, IsScalarTower.algebraMap_apply S K L]
    rfl
  let W : Submodule S L := Submodule.span S (Set.range (fun i : Fin n ↦ (e i) ^ p))
  have hpows (y : L) : y ^ p ∈ W := by
    have hexp : y ^ p = ∑ i, algebraMap K L ((e.repr y i) ^ p) * (e i) ^ p := by
      conv_lhs => rw [← e.sum_repr y]
      rw [sum_pow_char]
      simp only [Algebra.smul_def, mul_pow, map_pow]
    rw [hexp]
    apply W.sum_mem
    intro i _
    let a : S := ⟨(e.repr y i) ^ p, hS ⟨e.repr y i, rfl⟩⟩
    simpa only [hscalar] using
      W.smul_mem a (Submodule.subset_span ⟨i, rfl⟩)
  have hone : (1 : L) ∈ W := by simpa using hpows 1
  have hmul (a b : L) (ha : a ∈ W) (hb : b ∈ W) : a * b ∈ W := by
    induction ha, hb using Submodule.span_induction₂ with
    | mem_mem a b ha hb =>
      obtain ⟨i, rfl⟩ := ha
      obtain ⟨j, rfl⟩ := hb
      simpa only [mul_pow] using hpows (e i * e j)
    | zero_left b hb => simp
    | zero_right a ha => simp
    | add_left a b c ha hb hc hac hbc =>
      simpa only [add_mul] using W.add_mem hac hbc
    | add_right a b c ha hb hc hab hac =>
      simpa only [mul_add] using W.add_mem hab hac
    | smul_left r a b ha hb hab =>
      simpa only [smul_mul_assoc] using W.smul_mem r hab
    | smul_right r a b ha hb hab =>
      simpa only [mul_smul_comm] using W.smul_mem r hab
  let A : Subalgebra S L := W.toSubalgebra hone hmul
  have : FiniteDimensional S W := FiniteDimensional.span_of_finite S (Set.finite_range _)
  have : FiniteDimensional S A := inferInstanceAs (FiniteDimensional S W)
  have hinv (a : L) (ha : a ∈ W) : a⁻¹ ∈ W := by
    by_cases hzero : a = 0
    · simp [hzero]
    have hne : (⟨a, ha⟩ : A) ≠ 0 := by
      intro h
      exact hzero (congrArg Subtype.val h)
    obtain ⟨b, hb⟩ := FiniteDimensional.exists_mul_eq_one S hne
    have heq : a * (b : L) = 1 := congrArg Subtype.val hb
    have hbi : (b : L) = a⁻¹ := by
      apply (mul_left_cancel₀ hzero)
      rw [heq, mul_inv_cancel₀ hzero]
    rw [← hbi]
    exact b.property
  let F : Subfield L :=
    { carrier := W
      zero_mem' := W.zero_mem
      one_mem' := hone
      add_mem' := W.add_mem
      neg_mem' := W.neg_mem
      mul_mem' := fun ha hb ↦ hmul _ _ ha hb
      inv_mem' := hinv }
  have hclosure :
      Subfield.closure (Set.range (fun y : L ↦ y ^ p) ∪
        algebraMap K L '' (S : Set K)) ≤ F := by
    apply Subfield.closure_le.mpr
    rintro a (⟨y, rfl⟩ | ⟨s, hs, rfl⟩)
    · exact hpows y
    · change algebraMap K L s ∈ W
      simpa only [hscalar, mul_one] using W.smul_mem (⟨s, hs⟩ : S) hone
  have hcoeff (a : L) : a ∈ W ↔
      ∃ c : Fin n → K, (∀ i, c i ∈ S) ∧
        a = ∑ i, algebraMap K L (c i) * (e i) ^ p := by
    rw [Submodule.mem_span_range_iff_exists_fun]
    constructor
    · rintro ⟨c, hc⟩
      refine ⟨fun i ↦ (c i : K), fun i ↦ (c i).property, ?_⟩
      simpa only [hscalar] using hc.symm
    · rintro ⟨c, hc, h⟩
      refine ⟨fun i ↦ (⟨c i, hc i⟩ : S), ?_⟩
      simpa only [hscalar] using h.symm
  constructor
  · intro hx
    exact (hcoeff x).mp (hclosure hx)
  · rintro ⟨c, hc, rfl⟩
    apply Subfield.sum_mem
    intro i _
    apply Subfield.mul_mem
    · exact Subfield.subset_closure (Or.inr ⟨c i, hc i, rfl⟩)
    · exact Subfield.subset_closure (Or.inl ⟨e i, rfl⟩)

end FieldTheory
