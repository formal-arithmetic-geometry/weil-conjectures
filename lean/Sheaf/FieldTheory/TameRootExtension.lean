/-!
# Prime-to-residue-characteristic uniformizer root extensions

Source: Stacks Project, pione.tex, Tag 0BUB, final proof paragraph; algebra.tex, Tag 04GG;
more-algebra.tex, Tags 09EV and 09E4 (blueprint: lem-exc-tame-root-extension).

## Main statements

* `IsDiscreteValuationRing.tame_root_extension`: roots of unity lie in the henselian DVR,
  and a prime-to-residue-characteristic root of a uniformizer generates a cyclic splitting
  field whose degree and ramification index equal the exponent.
-/

@[expose] public section

universe u v w

set_option autoImplicit false

open Polynomial

namespace IsDiscreteValuationRing

/-- The integral closure of the DVR root algebra has one maximal ideal and tame index.

Source: Stacks Project, more-algebra.tex, Tags 09EV and 09E4.
(blueprint: lem-exc-tame-root-extension)

The proof identifies the Eisenstein root algebra with the integral closure in the
simple field generated by the chosen root, then computes the ramification index
from `(π) = (α)^m`. -/
private theorem tame_root_extension_integral_closure
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (F : Type v) [Field F] [Algebra R F] [IsFractionRing R F]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (Fsep : Type w) [Field Fsep] [Algebra F Fsep] [Algebra R Fsep]
    [IsScalarTower R F Fsep]
    (m : ℕ) (hm : 0 < m) (α : Fsep) (hα : α ^ m = algebraMap R Fsep π)
    (L : IntermediateField F Fsep) (hL : L = IntermediateField.adjoin F {α}) :
    ∃ q : Ideal (integralClosure R L), q.IsMaximal ∧
      (∀ q' : Ideal (integralClosure R L), q'.IsMaximal → q' = q) ∧
      q.ramificationIdx R = m := by
  classical
  subst L
  let L := IntermediateField.adjoin F {α}
  let a : L := ⟨α, IntermediateField.mem_adjoin_simple_self F α⟩
  have ha : a ^ m = algebraMap R L π := by
    apply Subtype.ext
    exact hα
  have hπirr : Irreducible π := (irreducible_iff_uniformizer π).mpr hπ
  let f : R[X] := X ^ m - C π
  let A := AdjoinRoot f
  let t : A := AdjoinRoot.root f
  obtain ⟨hdom, hdvr, hmax⟩ :=
    AlgebraicGeometry.Scheme.dvr_uniformizer_root_algebra R π hπirr m hm
  let : IsDomain A := hdom
  let : IsDiscreteValuationRing A := hdvr
  have ht : Irreducible t := (irreducible_iff_uniformizer t).mpr hmax
  have hf : f.Monic := monic_X_pow_sub_C π hm.ne'
  let : Module.Finite R A := hf.finite_adjoinRoot
  let j : A →ₐ[R] L := AdjoinRoot.liftAlgHom f (Algebra.ofId R L) a (by simp [f, ha])
  have hjt : j t = a := AdjoinRoot.lift_root (by simp [f, ha])
  have ha0 : a ≠ 0 := by
    intro hz
    have hzero : algebraMap R L π = 0 := by rw [← ha, hz, zero_pow hm.ne']
    have hinj : Function.Injective (algebraMap R L) :=
      (IsScalarTower.algebraMap_eq R F L) ▸
        (algebraMap F L).injective.comp (IsFractionRing.injective R F)
    exact hπirr.ne_zero (hinj (hzero.trans (map_zero _).symm))
  have hj : Function.Injective j := by
    apply (injective_iff_map_eq_zero j).mpr
    intro x hx
    by_contra hx0
    obtain ⟨n, u, hu⟩ := eq_unit_mul_pow_irreducible hx0 ht
    have hne : j x ≠ 0 := by
      rw [hu, map_mul, map_pow, hjt]
      exact mul_ne_zero (u.isUnit.map j).ne_zero (pow_ne_zero n ha0)
    exact hne hx
  let : Algebra A L := j.toRingHom.toAlgebra
  let : IsScalarTower R A L := IsScalarTower.of_algHom j
  let g : FractionRing A →ₐ[A] L :=
    IsFractionRing.liftAlgHom (g := Algebra.ofId A L) hj
  have hgt (x : A) : g (algebraMap A (FractionRing A) x) = j x := by
    exact IsFractionRing.lift_algebraMap hj x
  have hF (x : F) : algebraMap F L x ∈ g.toRingHom.fieldRange := by
    obtain ⟨r, s, hs, rfl⟩ := IsFractionRing.div_surjective R x
    refine ⟨algebraMap A (FractionRing A) (algebraMap R A r) /
      algebraMap A (FractionRing A) (algebraMap R A s), ?_⟩
    change g (_ / _) = algebraMap F L (_ / _)
    rw [map_div₀, map_div₀, hgt, hgt, j.commutes, j.commutes,
      ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  let K : IntermediateField F L :=
    { g.toRingHom.fieldRange with algebraMap_mem' := hF }
  have hgen : IntermediateField.adjoin F {a} = ⊤ := by
    apply IntermediateField.map_injective L.val
    change IntermediateField.lift _ = IntermediateField.lift _
    simp [L, a]
  have hK : K = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply IntermediateField.adjoin_le_iff.mpr
    exact Set.singleton_subset_iff.mpr ⟨algebraMap A (FractionRing A) t, hjt ▸ hgt t⟩
  have hgs : Function.Surjective g := by
    intro x
    have hx : x ∈ K := hK ▸ IntermediateField.mem_top
    exact hx
  let : IsFractionRing A L := IsFractionRing.of_algEquiv
    (AlgEquiv.ofBijective g ⟨g.injective, hgs⟩)
  let B := integralClosure R L
  let e : A ≃ₐ[R] B := IsIntegralClosure.equiv R A L B
  let : IsDiscreteValuationRing B := RingEquivClass.isDiscreteValuationRing e
  let q := IsLocalRing.maximalIdeal B
  refine ⟨q, inferInstance, fun q' hq' ↦ IsLocalRing.eq_maximalIdeal hq', ?_⟩
  have hb : Irreducible (e t) := ht.map e
  have hqspan : q = Ideal.span {e t} := (irreducible_iff_uniformizer (e t)).mp hb
  have htpow : t ^ m = algebraMap R A π := by
    simpa only [f, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero, ← AdjoinRoot.algebraMap_eq] using
      (AdjoinRoot.eval₂_root f)
  have hbpow : (e t) ^ m = algebraMap R B π := by
    rw [← map_pow, htpow, e.commutes]
  have hq0 : q ≠ ⊥ := by
    intro hz
    have hmem : e t ∈ q := hqspan ▸ Ideal.mem_span_singleton_self (e t)
    rw [hz, Ideal.mem_bot] at hmem
    exact hb.ne_zero hmem
  have hmap : (IsLocalRing.maximalIdeal R).map (algebraMap R B) = q ^ m := by
    rw [hπ, Ideal.map_span, Set.image_singleton, hqspan, Ideal.span_singleton_pow, hbpow]
  let : q.LiesOver (IsLocalRing.maximalIdeal R) := ⟨(IsLocalRing.eq_maximalIdeal
    (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal q)).symm⟩
  rw [← Ideal.ramificationIdx'_eq_ramificationIdx' (IsLocalRing.maximalIdeal R) q
    (hmap ▸ pow_ne_zero m hq0)]
  apply Ideal.ramificationIdx'_spec
  · rw [hmap]
  · rw [hmap]
    exact not_le_of_gt (q.pow_right_strictAnti hq0
      (IsLocalRing.maximalIdeal.isMaximal B).ne_top (Nat.lt_succ_self m))

set_option linter.unusedVariables false in
/-- Prime-to-residue-characteristic uniformizer root extensions of a henselian DVR with
algebraically closed residue field.

Source: Stacks Project, Tag 0BUB (final proof paragraph), Tag 04GG (simple-root lifting),
and Tags 09EV and 09E4 (uniformizer root algebras and ramification index).
(blueprint: lem-exc-tame-root-extension)

Proof:
1. The positive integer `m` is nonzero in the residue field, hence a unit of `R`. The residue
   field is separably closed, so `R` is strictly henselian. Apply
   `lem-sbc-strict-local-roots-of-unity` to obtain a cyclic group of `m` roots in `R`.
   Injectivity of `R → F → Fsep` preserves these distinct roots and a primitive generator.
   A polynomial of degree `m` over a field has at most `m` roots, so these are all the
   roots of `X^m - 1` in `Fsep`.
2. A uniformizer is irreducible: factoring it into two nonunits and cancelling it would
   make it a unit. By `lem-sbc-dvr-uniformizer-root-algebra`, the ring
   `A = R[T]/(T^m - π)` is a DVR with uniformizer `t`, the class of `T`. By
   `lem-weil-pbc-monic-quotient-free` it has basis `1,t,...,t^(m-1)`. Evaluation at `α`
   embeds `A` into `Fsep`: a nonzero element is `u*t^r` with `u` a unit, and its image
   is nonzero because `α^m = π ≠ 0`. Thus identify `A` with `R[α]`.
3. A polynomial over `F` of degree less than `m` vanishing at `α` is zero: clear its
   denominators using a product of nonzero denominators in `R`, then use the embedding
   and the basis of `A` to show every coefficient is zero. A factorization of `X^m - π`
   into positive-degree factors would give such a nonzero polynomial, since `Fsep` is
   a field. Hence the binomial is irreducible over `F`.
4. Take its splitting field inside `Fsep`. It contains `α`. Apply
   `lem-exc-kummer-binomial-splitting-field` with the primitive root from Step 1 and
   irreducibility from Step 3: the field is `F(α)`, cyclic Galois, and of degree `m`.
5. The fraction field of `R[α]` is `F(α)`. By `lem-weil-pbc-pid-noetherian-normal`, the
   DVR `A` is integrally closed. The integral closure `B` of `R` contains `R[α]`, since
   `α` is integral over `R`; conversely an element of `B` is integral over `A` and hence
   belongs to `A`. Therefore `B = A`, with unique maximal ideal generated by `α`.
6. As `π = α^m`, the extended maximal ideal of `R` is the `m`-th power of the maximal
   ideal of `B`, giving ramification index `m`. For `m = 1`, the root algebra is `R`,
   the splitting field is `F`, and both degree and ramification index are one.
-/
theorem tame_root_extension
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R]
    (F : Type v) [Field F] [Algebra R F] [IsFractionRing R F]
    (p : ℕ) (hp : 0 < p)
    [IsAlgClosed (IsLocalRing.ResidueField R)] [CharP (IsLocalRing.ResidueField R) p]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (Fsep : Type w) [Field Fsep] [Algebra F Fsep] [Algebra R Fsep]
    [IsScalarTower R F Fsep] [IsSepClosure F Fsep]
    (m : ℕ) (hm : 0 < m) (hmp : ¬p ∣ m) :
    (∀ ζ : Fsep, ζ ^ m = 1 → ∃ r : R, algebraMap R Fsep r = ζ) ∧
      ∀ α : Fsep, α ^ m = algebraMap R Fsep π →
        ∃ L : IntermediateField F Fsep,
          IsSplittingField F L (X ^ m - C (algebraMap R F π)) ∧
            L = IntermediateField.adjoin F {α} ∧
            IsGalois F L ∧ IsCyclic (Gal(L / F)) ∧
            Module.finrank F L = m ∧
            ∃ q : Ideal (integralClosure R L), q.IsMaximal ∧
              (∀ q' : Ideal (integralClosure R L), q'.IsMaximal → q' = q) ∧
              q.ramificationIdx R = m := by
  classical
  have : NeZero m := ⟨hm.ne'⟩
  have hunit : IsUnit (m : R) := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    simpa only [map_natCast] using (CharP.cast_eq_zero_iff
      (IsLocalRing.ResidueField R) p m).not.mpr hmp
  have : IsStrictlyHenselianLocalRing R := ⟨inferInstance⟩
  have hcard := (AlgebraicGeometry.Scheme.strict_local_roots_of_unity R m ⟨hm, hunit⟩).1
  have : HasEnoughRootsOfUnity R m := HasEnoughRootsOfUnity.of_card_le (le_of_eq hcard.symm)
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot R m
  have hinj : Function.Injective (algebraMap R Fsep) :=
    (IsScalarTower.algebraMap_eq R F Fsep) ▸
      (algebraMap F Fsep).injective.comp (IsFractionRing.injective R F)
  have hζF := hζ.map_of_injective (IsFractionRing.injective R F)
  have hζsep := hζ.map_of_injective hinj
  constructor
  · intro ξ hξ
    obtain ⟨i, hi, rfl⟩ := hζsep.eq_pow_of_pow_eq_one hξ
    exact ⟨ζ ^ i, map_pow _ _ _⟩
  · intro α hα
    have hπirr : Irreducible π := (irreducible_iff_uniformizer π).mpr hπ
    let f : R[X] := X ^ m - C π
    have hf : f.Monic := monic_X_pow_sub_C π hm.ne'
    have hdeg : f.natDegree = m := natDegree_X_pow_sub_C
    have hei : f.IsEisensteinAt (Ideal.span {π}) := by
      apply hf.isEisensteinAt_of_mem_of_notMem
      · rw [← hπ]
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
      · intro i hi
        rw [hdeg] at hi
        by_cases hi0 : i = 0
        · subst i
          simp [f, Ne.symm hm.ne', coeff_X_pow]
        · simp [f, coeff_X_pow, ne_of_lt hi, coeff_C, hi0]
      · simp only [f, coeff_sub, coeff_X_pow, Ne.symm hm.ne', if_false,
          coeff_C_zero, zero_sub, Ideal.neg_mem_iff, Ideal.span_singleton_pow,
          Ideal.mem_span_singleton]
        rintro ⟨b, hb⟩
        have hb' : 1 = π * b := mul_left_cancel₀ hπirr.ne_zero (by
          calc π * 1 = π := mul_one π
               _ = π ^ 2 * b := hb
               _ = π * (π * b) := by ring)
        exact hπirr.not_isUnit (isUnit_of_dvd_one ⟨b, hb'⟩)
    have hirrR : Irreducible f := hei.irreducible
      (by rw [← hπ]; infer_instance) hf.isPrimitive (hdeg ▸ hm)
    have hirr : Irreducible (X ^ m - C (algebraMap R F π)) := by
      simpa only [f, Polynomial.map_sub, Polynomial.map_pow, map_X, map_C] using
        (hf.irreducible_iff_irreducible_map_fraction_map (K := F)).mp hirrR
    have hprim : (primitiveRoots m F).Nonempty :=
      ⟨_, (mem_primitiveRoots hm).mpr hζF⟩
    let L : IntermediateField F Fsep := IntermediateField.adjoin F {α}
    let a : L := ⟨α, IntermediateField.subset_adjoin F {α} (Set.mem_singleton α)⟩
    have ha : a ^ m = algebraMap F L (algebraMap R F π) := by
      apply Subtype.ext
      change α ^ m = algebraMap F Fsep (algebraMap R F π)
      rw [← IsScalarTower.algebraMap_apply]
      exact hα
    have hs : IsSplittingField F L (X ^ m - C (algebraMap R F π)) := by
      constructor
      · simpa only [Polynomial.map_sub, Polynomial.map_pow, map_X, map_C] using
          X_pow_sub_C_splits_of_isPrimitiveRoot
            (hζF.map_of_injective (algebraMap F L).injective) ha
      · apply eq_top_iff.mpr
        have hi : IsIntegral F a := ⟨X ^ m - C (algebraMap R F π),
          monic_X_pow_sub_C _ hm.ne', by simp [ha]⟩
        have hgen : IntermediateField.adjoin F {a} = ⊤ := by
          apply IntermediateField.map_injective L.val
          change IntermediateField.lift _ = IntermediateField.lift _
          simp [L, a]
        rw [← Algebra.adjoin_eq_top_of_primitive_element hi.isAlgebraic hgen]
        apply Algebra.adjoin_mono
        apply Set.singleton_subset_iff.mpr
        rw [mem_rootSet_of_ne (X_pow_sub_C_ne_zero hm _)]
        simp [ha]
    have := hs
    refine ⟨L, hs, rfl,
      isGalois_of_isSplittingField_X_pow_sub_C hprim hirr L,
      isCyclic_of_isSplittingField_X_pow_sub_C hprim hirr L,
      finrank_of_isSplittingField_X_pow_sub_C hprim hirr L, ?_⟩
    exact tame_root_extension_integral_closure R F π hπ Fsep m hm α hα L rfl

end IsDiscreteValuationRing
