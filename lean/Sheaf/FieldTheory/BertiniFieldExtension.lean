module

public import Mathlib.AlgebraicGeometry.Geometrically.Irreducible
public import Mathlib.RingTheory.AlgebraicIndependent.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Algebraic Bertini lemma for a generic linear combination

Source: Stacks Project, More on Morphisms, Tag 0G4D, lemma-amazing-bertini-lemma,
lines 8907--8922 (blueprint: lem-zl-bertini-field-extension).
-/

@[expose] public section

universe u

open CategoryTheory
open AlgebraicGeometry

namespace FieldTheory

/-- The fraction field of the polynomial ring in `n` indeterminates over `K`.
Source: Stacks Project, Tag 0G4D (blueprint: lem-zl-bertini-field-extension). -/
abbrev bertiniOmega (K : Type u) [Field K] (n : ℕ) : Type u :=
  FractionRing (MvPolynomial (Fin n) K)

/-- The canonical polynomial indeterminates in `bertiniOmega`.
Source: Stacks Project, Tag 0G4D (blueprint: lem-zl-bertini-field-extension). -/
noncomputable def bertiniCoordinate (K : Type u) [Field K] (n : ℕ) (i : Fin n) :
    bertiniOmega K n :=
  algebraMap (MvPolynomial (Fin n) K) (bertiniOmega K n) (MvPolynomial.X i)

/-- The linear form `∑ g_i x_i` in the fraction field.
Source: Stacks Project, Tag 0G4D (blueprint: lem-zl-bertini-field-extension). -/
noncomputable def bertiniXi (k K : Type u) [Field k] [Field K] [Algebra k K]
    (n : ℕ) (g : Fin n → K) : bertiniOmega K n :=
  ∑ i, algebraMap K (bertiniOmega K n) (g i) * bertiniCoordinate K n i

/-- The linear form `∑ c_i g_i` in the fraction field.
Source: Stacks Project, Tag 0G4D (blueprint: lem-zl-bertini-field-extension). -/
noncomputable def bertiniDelta (k K : Type u) [Field k] [Field K] [Algebra k K]
    (n : ℕ) (g : Fin n → K) (c : Fin n → k) : bertiniOmega K n :=
  ∑ i, algebraMap k (bertiniOmega K n) (c i) *
    algebraMap K (bertiniOmega K n) (g i)

/-- The ordered family `(x₁, …, xₙ, ξ, δ)` in `bertiniOmega`.
Source: Stacks Project, Tag 0G4D (blueprint: lem-zl-bertini-field-extension). -/
noncomputable def bertiniFamily (k K : Type u) [Field k] [Field K] [Algebra k K]
    (n : ℕ) (g : Fin n → K) (c : Fin n → k) :
    Fin (n + 2) → bertiniOmega K n :=
  Fin.lastCases (bertiniDelta k K n g c)
    (Fin.lastCases (bertiniXi k K n g) (fun i ↦ bertiniCoordinate K n i))

/-- The subfield generated by `x₁, …, xₙ, ξ` over `k`.
Source: Stacks Project, Tag 0G4D (blueprint: lem-zl-bertini-field-extension). -/
noncomputable def bertiniBaseField (k K : Type u) [Field k] [Field K] [Algebra k K]
    (n : ℕ) (g : Fin n → K) : IntermediateField k (bertiniOmega K n) :=
  IntermediateField.adjoin k <| Set.range <|
    Fin.lastCases (bertiniXi k K n g) (fun i ↦ bertiniCoordinate K n i)

/-- If `K/k` is finitely generated and geometrically irreducible, a generic linear
combination yields a geometrically irreducible extension.
Source: Stacks Project, More on Morphisms, Tag 0G4D, lemma-amazing-bertini-lemma
(blueprint: lem-zl-bertini-field-extension).

Proof (the nine steps of the DAG):
1. Choose `c` as in the hypothesis. For each `a ∈ k`, translate the variables by `a c`.
   The resulting automorphism `σ_a` sends `ξ` to `ξ + a δ` and fixes `δ`. Put
   `K₀ = k(x₁,…,xₙ)`, `K₁ = K₀(ξ)`, and `K₂ = K₀(ξ,δ)`. The automorphisms preserve
   `K₀` and `K₂`, and algebraic independence makes `K₂/K₀` purely transcendental of degree two.
2. By `lem-zl-geometric-irreducibility-separable`, it suffices to show that every element
   `θ` of `Ω` separably algebraic over `K₁` belongs to `K₁`. Fix such an element.
3. The separable algebraic closure `K₂'` of `K₂` in `Ω` is finite by
   `lem-zl-finite-separable-closure`, since `Ω/K₂` is finitely generated. It is separable,
   so `lem-zl-finite-intermediate-fields` gives only finitely many intermediate fields.
4. If `k` is infinite, two distinct `a₁,a₂` give the same field `K₂(σ_a(θ))`. Put
   `θ_i = σ_{a_i}(θ)` and `ξ_i = ξ + a_i δ`. Solving the two linear equations gives
   `K₂ = K₀(ξ₁,ξ₂)`. The two `ξ_i` are algebraically independent over `K₀`, and since
   `θ₁` is algebraic over `K₀(ξ₁)`, `ξ₂` is transcendental over `K₀(ξ₁,θ₁)`.
5. By `lem-zl-geometric-irreducibility-transcendental`, `Ω/K₀` is geometrically
   irreducible. By `lem-zl-geometric-irreducibility-subextension`, so is
   `K₀(ξ₁,θ₁)/K₀`. Apply `lem-zl-geometric-irreducibility-add-transcendental` to `ξ₂`
   to obtain geometric irreducibility of `K₀(ξ₁,ξ₂,θ₁)/K₀(ξ₂)`.
6. The common field from step 4 is also `K₀(ξ₁,ξ₂,θ₂)`. Since `θ₂` is separably
   algebraic over `K₀(ξ₂)`, `lem-zl-geometric-irreducibility-separable` implies
   `θ₂ ∈ K₀(ξ₂)`. Applying the inverse of `σ_{a₂}` gives `θ ∈ K₁`.
7. If `k` is finite, adjoin an independent variable `t`. The extension `K(t)/k(t)` is
   geometrically irreducible by `lem-zl-geometric-irreducibility-transcendental`.
   The displayed family stays algebraically independent over `k(t)`: clear denominators
   in a polynomial relation and compare coefficients of the independent variable `t`.
8. Apply the infinite-field argument in steps 2--6 over the infinite field `k(t)`.
   Finite generation and the independence hypothesis persist, so it gives geometric
   irreducibility of `K(t,x₁,…,xₙ)/k(t,x₁,…,xₙ,ξ)`.
9. Descend along adjoining `t` using the converse direction of
   `lem-zl-geometric-irreducibility-transcendental`, obtaining the required conclusion.
-/
theorem bertini_field_extension
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (hfg : (⊤ : IntermediateField k K).FG)
    (hgeom : GeometricallyIrreducible
      (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    (n : ℕ) (hn : 1 ≤ n) (g : Fin n → K)
    (hc : ∃ c : Fin n → k, AlgebraicIndependent k (bertiniFamily k K n g c)) :
    GeometricallyIrreducible
      (Spec.map (CommRingCat.ofHom
        (algebraMap (bertiniBaseField k K n g) (bertiniOmega K n)))) := by
  sorry

end FieldTheory
