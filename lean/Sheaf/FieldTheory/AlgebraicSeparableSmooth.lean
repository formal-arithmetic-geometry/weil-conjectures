module

public import Mathlib.CategoryTheory.ObjectProperty.Ind
public import Mathlib.Algebra.Category.CommAlgCat.Basic
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.FieldTheory.Separable
import WeilConjectures.Mathlib.RingTheory.Etale.Field
import Mathlib.Algebra.Algebra.Subalgebra.Directed
import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Algebraic separable extensions as filtered colimits of finite smooth algebras

Source: literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/
lem-kun-algebraic-separable-smooth.md, node lem-kun-algebraic-separable-smooth, order 1756
(blueprint: lem-kun-algebraic-separable-smooth).
-/

@[expose] public section

universe u v

open CategoryTheory

namespace FieldTheory

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]

private abbrev finiteStage (s : Finset L) : Subalgebra K L := Algebra.adjoin K (s : Set L)

private theorem finiteStage_mono : Monotone (finiteStage (K := K) (L := L)) :=
  fun _ _ h ↦ Algebra.adjoin_mono (Finset.coe_subset.mpr h)

private theorem finiteStage_iSup : ⨆ s, finiteStage (K := K) (L := L) s = ⊤ := by
  apply le_antisymm le_top
  intro x _
  exact le_iSup (finiteStage (K := K) (L := L)) {x} (Algebra.subset_adjoin (by simp))

private abbrev finiteStageDiagram : Finset L ⥤ CommAlgCat.{v} K where
  obj s := .of K (finiteStage s)
  map h := CommAlgCat.ofHom (Subalgebra.inclusion (finiteStage_mono (leOfHom h)))
  map_id := by intros; rfl
  map_comp := by intros; rfl

private abbrev finiteStageCocone : Limits.Cocone (finiteStageDiagram (K := K) (L := L)) where
  pt := .of K L
  ι := { app := fun s ↦ CommAlgCat.ofHom (finiteStage s).val }

private noncomputable def finiteStageDesc
    (s : Limits.Cocone (finiteStageDiagram (K := K) (L := L))) : L →ₐ[K] s.pt := by
  classical
  exact (Subalgebra.iSupLift (finiteStage (K := K)) finiteStage_mono.directed_le
    (fun i ↦ (s.ι.app i).hom)
    (fun i j h ↦ by
      apply AlgHom.ext
      intro x
      have hi := ConcreteCategory.congr_hom
        (s.w (homOfLE (Finset.subset_union_left : i ⊆ i ∪ j))) x
      have hj := ConcreteCategory.congr_hom
        (s.w (homOfLE (Finset.subset_union_right : j ⊆ i ∪ j)))
        (Subalgebra.inclusion h x)
      exact hi.symm.trans hj)
    ⊤ finiteStage_iSup.ge).comp Subalgebra.topEquiv.symm.toAlgHom

private theorem finiteStageDesc_apply
    (s : Limits.Cocone (finiteStageDiagram (K := K) (L := L)))
    (i : Finset L) (x : finiteStage (K := K) i) :
    finiteStageDesc s x = (s.ι.app i).hom x := by
  have hx : Subalgebra.topEquiv.symm.toAlgHom (x : L) =
      Subalgebra.inclusion (le_top : finiteStage (K := K) i ≤ ⊤) x := Subtype.ext rfl
  simp only [finiteStageDesc, AlgHom.comp_apply, hx, Subalgebra.iSupLift_inclusion]
  rfl

private noncomputable def finiteStageIsColimit :
    Limits.IsColimit (finiteStageCocone (K := K) (L := L)) := by
  classical
  exact {
    desc := fun s ↦ CommAlgCat.ofHom (finiteStageDesc s)
    fac := fun s i ↦ by
      ext x
      exact finiteStageDesc_apply s i x
    uniq := fun s m hm ↦ by
      ext x
      let x' : finiteStage (K := K) {x} := ⟨x, Algebra.subset_adjoin (by simp)⟩
      exact (ConcreteCategory.congr_hom (hm {x}) x').trans
        (finiteStageDesc_apply s {x} x').symm }

/-- An algebraic separable field extension is a filtered colimit of finite separable,
and hence smooth, `K`-algebras.

Source: literature/blueprint/master/blueprint/sec-smooth-purity/sk-prop-sf-kunneth-ordinary/
lem-kun-algebraic-separable-smooth.md, node lem-kun-algebraic-separable-smooth, order 1756
(the algebraic case of Stacks Project, Algebra, Lemma 10.158.11, Tag 07BV)
(blueprint: lem-kun-algebraic-separable-smooth).

Proof:
1. Index the diagram by `Finset L`, with the subalgebra generated by each finite subset
   as its object and the inclusions as transition maps. Unions give upper bounds, so this
   poset is filtered. Every element belongs to the subalgebra generated by its singleton.
2. For any cocone, use `Subalgebra.iSupLift` and the equality of the supremum with `⊤`
   to construct its unique induced algebra homomorphism from `L`. Compatibility follows
   by comparing any two stages in the stage generated by their union. The lift agrees
   with each cocone leg, and the singleton stages prove uniqueness.
3. Each stage is a field by `Subalgebra.isField_of_algebraic`. Its finite generating set
   consists of integral elements, so `Algebra.finite_adjoin_of_finite_of_isIntegral`
   makes it finite over `K`. Separability descends along its inclusion into `L`.
4. Apply `Algebra.Etale.of_finite_of_isSeparable` to each stage and use Mathlib's
   `Algebra.Etale` to `Algebra.Smooth` instance. The diagram, its colimit proof, and
   these stage properties give the required `ObjectProperty.ind` witness.
-/
theorem algebraic_separable_extension_is_filtered_colimit_smooth
    {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
    [Algebra.IsAlgebraic K L] [Algebra.IsSeparable K L] :
    CategoryTheory.ObjectProperty.ind.{v}
      (fun B : CommAlgCat.{v} K ↦
        IsField B ∧ Module.Finite K B ∧ Algebra.IsSeparable K B ∧ Algebra.Smooth K B)
      (CommAlgCat.of K L) := by
  classical
  refine ⟨Finset L, inferInstance, inferInstance,
    ⟨finiteStageDiagram, finiteStageCocone.ι, finiteStageIsColimit⟩, ?_⟩
  intro i
  change IsField (finiteStage (K := K) i) ∧ Module.Finite K (finiteStage (K := K) i) ∧
    Algebra.IsSeparable K (finiteStage (K := K) i) ∧ Algebra.Smooth K (finiteStage (K := K) i)
  have hfield : IsField (finiteStage (K := K) i) := (finiteStage (K := K) i).isField_of_algebraic
  let : Field (finiteStage (K := K) i) := hfield.toField
  have : Module.Finite K (finiteStage (K := K) i) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral i.finite_toSet
      (fun x _ ↦ Algebra.IsIntegral.isIntegral x)
  have : Algebra.IsSeparable K (finiteStage (K := K) i) :=
    Algebra.IsSeparable.of_algHom K L (finiteStage (K := K) i).val
  have : Algebra.Etale K (finiteStage (K := K) i) := Algebra.Etale.of_finite_of_isSeparable
  exact ⟨hfield, inferInstance, inferInstance, inferInstance⟩

end FieldTheory
