module

public import Mathlib.FieldTheory.PurelyInseparable.Basic
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.PurelyInseparable.PerfectClosure
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-!
# A finite rooted constant and variable extension

Source: Stacks Project, Algebra, Tag 04KM, coefficient-root construction.
(blueprint: lem-weil-pbc-finite-rooted-extension)
-/

@[expose] public section
set_option autoImplicit false
universe w
namespace FieldExtension

/-- Finitely many constants and an independent tuple can be rooted in compatible finite
purely inseparable extensions, with the rooted tuple still independent.
Source: Stacks Project, Algebra, Tag 04KM, construction of the fields k' and L.
(blueprint: lem-weil-pbc-finite-rooted-extension)

Proof. In an algebraic closure Ω of K, take the unique p-th root of each element of C and s.
Let l be the subfield generated over k by the constant roots. Let L be the subfield generated
over K by the constant roots and the variable roots. Embed l in L by inclusion and let t be
the finite set of variable roots in L. These are actual subfields of Ω, in the universe of K.
Each generator has p-th power in the base, so the adjoin criterion for pure inseparability
applies. Each generating root satisfies the monic polynomial X^p-c, and the finite
algebraic-generators theorem gives finiteness of both extensions. Independence of s maps
from K to Ω and extends from k to the algebraic constant extension l. If a polynomial
relation over l holds on the rooted tuple, apply Frobenius in Ω; its coefficientwise
Frobenius transform is a relation on s. Injectivity of Frobenius on l shows the original
polynomial is zero. Hence the rooted tuple, and its range t, are independent over l.
The equations s_i=t_i^p put k(s) inside l(t): induction under addition, multiplication
and inversion proves the inclusion and defines the indicated algebra and scalar tower.
Finally, induction on the generators of L shows every element lies in the subfield
generated by K and l(t), since both kinds of roots belong to l(t). The stated constant
and variable root equations hold by construction. -/
theorem exists_finiteRooted_extension
    (k K : Type w) [Field k] [Field K] [Algebra k K]
    (s : Finset K) (hs : AlgebraicIndependent k ((↑) : s → K))
    (p : ℕ) [Fact p.Prime] [CharP k p] (C : Finset k) :
    ∃ (l : Type w) (_hl : Field l) (_akl : Algebra k l)
      (L : Type w) (_hL : Field L) (_aKL : Algebra K L) (_alL : Algebra l L)
      (_akL : Algebra k L) (_htl : IsScalarTower k l L) (_htK : IsScalarTower k K L),
      Module.Finite k l ∧ IsPurelyInseparable k l ∧
      Module.Finite K L ∧ IsPurelyInseparable K L ∧
      ∃ t : Finset L, AlgebraicIndependent l ((↑) : t → L) ∧
        ∃ (_a : Algebra (IntermediateField.adjoin k (s : Set K))
            (IntermediateField.adjoin l (t : Set L))),
          IsScalarTower (IntermediateField.adjoin k (s : Set K))
            (IntermediateField.adjoin l (t : Set L)) L ∧
          (∀ c ∈ C, ∃ b : l, algebraMap k l c = b ^ p) ∧
          (∀ x (hx : x ∈ s), ∃ b : IntermediateField.adjoin l (t : Set L),
            algebraMap (IntermediateField.adjoin k (s : Set K))
              (IntermediateField.adjoin l (t : Set L))
              ⟨x, IntermediateField.subset_adjoin k (s : Set K) hx⟩ = b ^ p) ∧
          IntermediateField.adjoin (IntermediateField.adjoin l (t : Set L))
            (Set.range (algebraMap K L)) = ⊤ := by
  classical
  let Ω := AlgebraicClosure K
  have : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  have : CharP Ω p := charP_of_injective_algebraMap (algebraMap K Ω).injective p
  choose rt hrt using fun c : Ω ↦
    IsAlgClosed.exists_pow_nat_eq c (Fact.out : p.Prime).pos
  let rc (c : k) := rt (algebraMap k Ω c)
  let rs (x : K) := rt (algebraMap K Ω x)
  let U : Finset Ω := C.image rc
  let V : Finset Ω := s.image rs
  let l := IntermediateField.adjoin k (U : Set Ω)
  let L := IntermediateField.adjoin K ((U ∪ V : Finset Ω) : Set Ω)
  have hrc (c : k) : rc c ^ p = algebraMap k Ω c := hrt _
  have hrs (x : K) : rs x ^ p = algebraMap K Ω x := hrt _
  have hlfin : Module.Finite k l := IntermediateField.finiteDimensional_adjoin <| by
    intro x hx
    obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hx
    refine ⟨Polynomial.X ^ p - Polynomial.C c,
      Polynomial.monic_X_pow_sub_C _ (Fact.out : p.Prime).ne_zero, ?_⟩
    simp [hrc]
  have hlpi : IsPurelyInseparable k l :=
    (IntermediateField.isPurelyInseparable_adjoin_iff_pow_mem k Ω p).mpr <| by
      intro x hx
      obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hx
      exact ⟨1, c, by simpa using (hrc c).symm⟩
  have hLfin : Module.Finite K L := IntermediateField.finiteDimensional_adjoin <| by
    intro x hx
    rcases Finset.mem_union.mp hx with hx | hx
    · obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hx
      refine ⟨Polynomial.X ^ p - Polynomial.C (algebraMap k K c),
        Polynomial.monic_X_pow_sub_C _ (Fact.out : p.Prime).ne_zero, ?_⟩
      simp [hrc, ← IsScalarTower.algebraMap_apply k K Ω]
    · obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hx
      refine ⟨Polynomial.X ^ p - Polynomial.C x,
        Polynomial.monic_X_pow_sub_C _ (Fact.out : p.Prime).ne_zero, ?_⟩
      simp [hrs]
  have hLpi : IsPurelyInseparable K L :=
    (IntermediateField.isPurelyInseparable_adjoin_iff_pow_mem K Ω p).mpr <| by
      intro x hx
      rcases Finset.mem_union.mp hx with hx | hx
      · obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hx
        exact ⟨1, algebraMap k K c, by
          simpa [← IsScalarTower.algebraMap_apply k K Ω] using (hrc c).symm⟩
      · obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hx
        exact ⟨1, x, by simpa using (hrs x).symm⟩
  have hlL : l ≤ L.restrictScalars k := IntermediateField.adjoin_le_iff.mpr <| by
    intro x hx
    exact IntermediateField.subset_adjoin K _ (Finset.mem_union_left V hx)
  let i : l →+* L :=
    { toFun := fun x ↦ ⟨x, hlL x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  let : Algebra l L := i.toAlgebra
  have : IsScalarTower k l L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hvars (x : K) (hx : x ∈ s) : rs x ∈ L :=
    IntermediateField.subset_adjoin K _
      (Finset.mem_union_right U (Finset.mem_image_of_mem rs hx))
  let r (x : s) : L := ⟨rs x, hvars x x.property⟩
  let t : Finset L := Finset.univ.image r
  have hr (x : s) : r x ^ p = algebraMap K L x := Subtype.ext (hrs x)
  have : Module.Finite k l := hlfin
  have : CharP l p := charP_of_injective_algebraMap (algebraMap k l).injective p
  have : IsScalarTower l L Ω := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hsΩ : AlgebraicIndependent k (fun x : s ↦ algebraMap K Ω x) :=
    hs.map' (f := IsScalarTower.toAlgHom k K Ω) (algebraMap K Ω).injective
  have hsΩl : AlgebraicIndependent l (fun x : s ↦ algebraMap K Ω x) :=
    hsΩ.extendScalars l
  have hAI : AlgebraicIndependent l r := by
    apply AlgebraicIndependent.of_comp (IsScalarTower.toAlgHom l L Ω)
    have hpow : AlgebraicIndependent l
        (frobenius Ω p ∘ (fun x : s ↦ (r x : Ω))) := by
      convert hsΩl using 1
      funext x
      exact hrs x
    exact hpow.of_ringHom_of_comp_eq (frobenius l p) (frobenius Ω p)
      (frobenius l p).injective (by ext x; rfl)
  have ht : AlgebraicIndependent l ((↑) : t → L) := by
    have htset : Set.range r = (t : Set L) := by ext x; simp [t]
    exact hAI.to_subtype_range' htset
  let E := IntermediateField.adjoin k (s : Set K)
  let E₁ := IntermediateField.adjoin l (t : Set L)
  have hrmem (x : s) : r x ∈ E₁ := IntermediateField.subset_adjoin l _ <| by
    simp [t]
  have hsE₁ (x : K) (hx : x ∈ s) : algebraMap K L x ∈ E₁ := by
    rw [← hr ⟨x, hx⟩]
    exact pow_mem (hrmem ⟨x, hx⟩) p
  have hE (x : E) : algebraMap K L x ∈ E₁ := by
    rcases x with ⟨x, hx⟩
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy => exact hsE₁ y hy
    | algebraMap c =>
        rw [← IsScalarTower.algebraMap_apply k K L,
          IsScalarTower.algebraMap_apply k l L]
        exact E₁.algebraMap_mem _
    | add y z _ _ hy hz => simpa only [map_add] using E₁.add_mem hy hz
    | inv y _ hy => simpa only [map_inv₀] using E₁.inv_mem hy
    | mul y z _ _ hy hz => simpa only [map_mul] using E₁.mul_mem hy hz
  let j : E →+* E₁ :=
    { toFun := fun x ↦ ⟨algebraMap K L x, hE x⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' := fun x y ↦ Subtype.ext (map_mul (algebraMap K L) (x : K) (y : K))
      map_zero' := Subtype.ext (map_zero _)
      map_add' := fun x y ↦ Subtype.ext (map_add (algebraMap K L) (x : K) (y : K)) }
  let : Algebra E E₁ := j.toAlgebra
  have hTower : IsScalarTower E E₁ L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  refine ⟨l, inferInstance, inferInstance, L, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, hlfin, hlpi, hLfin, hLpi, t, ht,
    inferInstance, hTower, ?_, ?_, ?_⟩
  · intro c hc
    refine ⟨⟨rc c, IntermediateField.subset_adjoin k _
      (Finset.mem_image_of_mem rc hc)⟩, Subtype.ext (hrc c).symm⟩
  · intro x hx
    refine ⟨⟨r ⟨x, hx⟩, hrmem ⟨x, hx⟩⟩, ?_⟩
    exact Subtype.ext (hr ⟨x, hx⟩).symm
  · let B := IntermediateField.adjoin E₁ (Set.range (algebraMap K L))
    apply top_unique
    intro x hxTop
    clear hxTop
    change x ∈ B
    rcases x with ⟨x, hx⟩
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy =>
        rcases Finset.mem_union.mp hy with hy | hy
        · obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hy
          let z : l := ⟨rc c, IntermediateField.subset_adjoin k _
            (Finset.mem_image_of_mem rc hc)⟩
          exact B.algebraMap_mem ⟨algebraMap l L z, E₁.algebraMap_mem z⟩
        · obtain ⟨z, hz, heq⟩ := Finset.mem_image.mp hy
          subst y
          exact B.algebraMap_mem ⟨r ⟨z, hz⟩, hrmem ⟨z, hz⟩⟩
    | algebraMap y => exact IntermediateField.subset_adjoin E₁ _ ⟨y, rfl⟩
    | add y z hy hz ihy ihz => exact B.add_mem ihy ihz
    | inv y hy ih => exact B.inv_mem ih
    | mul y z hy hz ihy ihz => exact B.mul_mem ihy ihz

end FieldExtension
