module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import Mathlib.Algebra.MvPolynomial.PDeriv

import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Partial derivatives preserve the evaluation kernel of a p-independent family

Source: Stacks Project, More on Algebra, Tag 07P2, the presentation in the proof
of (a) implies (b).
(blueprint: lem-weil-pbc-p-independent-evaluation-kernel).
-/

@[expose] public section

universe u v w

namespace MvPolynomial

/-- Source: Stacks Project, More on Algebra, Tag 07P2, presentation argument in
(a) implies (b).
(blueprint: lem-weil-pbc-p-independent-evaluation-kernel)

Put B = kK^p. If the bounded monomials in t are B-linearly independent, the
kernel of evaluation B[X_i] → K is stable under every formal partial derivative.

Proof: let J be the ideal generated by X_j^p - C(t_j^p), whose coefficients
belong to B. Each generator evaluates to zero. Reduce the exponents in each
monomial modulo p, replacing X_j^p by C(t_j^p). This gives a congruent finite
B-linear combination of monomials with all exponents less than p. If the
original polynomial evaluates to zero, linear independence forces every
coefficient of the reduced polynomial to vanish. Thus the evaluation kernel
is J; spanning of K is not needed. Each partial derivative of each generator
is zero, since p = 0 in B. For any finite sum of multiples of generators,
Leibniz shows its derivative is again in J. Its evaluation is therefore zero.
Only finitely many variables occur in any polynomial, so the argument also
works for infinite I. For empty I evaluation on constants is injective and
there are no partial derivatives to check. -/
theorem aeval_pderiv_eq_zero_of_pIndependent
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    (p : ℕ) [Fact p.Prime] [CharP k p] [CharP K p]
    {I : Type w} (t : I → K)
    (hli : LinearIndependent
      (IntermediateField.adjoin k (Set.range (fun x : K => x ^ p)))
      (fun E : {E : I →₀ ℕ // ∀ i : I, E i < p} =>
        E.val.prod (fun i e => t i ^ e)))
    (i : I) (f : MvPolynomial I
      (IntermediateField.adjoin k (Set.range (fun x : K => x ^ p))))
    (hf : aeval t f = 0) : aeval t (pderiv i f) = 0 := by
  classical
  let B := IntermediateField.adjoin k (Set.range (fun x : K => x ^ p))
  let c (j : I) : B := ⟨t j ^ p, IntermediateField.subset_adjoin k _ ⟨t j, rfl⟩⟩
  let g (j : I) : MvPolynomial I B := X j ^ p - C (c j)
  let J : Ideal (MvPolynomial I B) := Ideal.span (Set.range g)
  let e : MvPolynomial I B →ₐ[B] K := aeval t
  have hJ : ∀ f, f ∈ J → e f = 0 := by
    intro f hf
    have hle : J ≤ RingHom.ker e.toRingHom := by
      apply Ideal.span_le.mpr
      rintro _ ⟨j, rfl⟩
      simp [g, e, c]
    exact hle hf
  let Q := MvPolynomial I B ⧸ J
  let q : MvPolynomial I B →ₐ[B] Q := Ideal.Quotient.mkₐ B J
  let z (j : I) : Q := q (X j)
  have hrel (j : I) : z j ^ p = algebraMap B Q (c j) := by
    apply sub_eq_zero.mp
    change q (X j) ^ p - q (C (c j)) = 0
    rw [← map_pow, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
  let v (E : {E : I →₀ ℕ // ∀ j, E j < p}) : Q :=
    E.val.prod (fun j n => z j ^ n)
  let S := Submodule.span B (Set.range v)
  have hmon (E : I →₀ ℕ) (r : B) : q (monomial E r) ∈ S := by
    let E' : {E : I →₀ ℕ // ∀ j, E j < p} :=
      ⟨E.mapRange (fun n => n % p) (Nat.zero_mod p),
        fun j => Nat.mod_lt _ (Fact.out : p.Prime).pos⟩
    have hz (j : I) (n : ℕ) :
        z j ^ n = algebraMap B Q (c j ^ (n / p)) * z j ^ (n % p) := by
      conv_lhs => rw [← Nat.div_add_mod n p]
      rw [pow_add, pow_mul, hrel, map_pow]
    have hm : q (monomial E r) =
        (r * E.prod (fun j n => c j ^ (n / p))) • v E' := by
      rw [monomial_eq, map_mul]
      simp only [AlgHom.commutes, ← algebraMap_eq, map_finsuppProd, map_pow]
      rw [show E.prod (fun j n => z j ^ n) =
          E.prod (fun j n => algebraMap B Q (c j ^ (n / p)) * z j ^ (n % p)) from
        Finsupp.prod_congr (fun j hj => hz j (E j))]
      rw [Finsupp.prod_mul, ← map_finsuppProd]
      simp only [Algebra.smul_def, map_mul, mul_assoc]
      congr 2
      exact (Finsupp.prod_mapRange_index (hf := Nat.zero_mod p) (fun j => pow_zero (z j))).symm
    rw [hm]
    exact S.smul_mem _ (Submodule.subset_span ⟨E', rfl⟩)
  have hspan : S = ⊤ := by
    apply top_unique
    intro x hx
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mkₐ_surjective B J x
    change q f ∈ S
    clear hx
    induction f using MvPolynomial.induction_on' with
    | monomial E r => exact hmon E r
    | add f₁ f₂ h₁ h₂ => rw [map_add]; exact S.add_mem h₁ h₂
  let π : Q →ₐ[B] K := Ideal.Quotient.liftₐ J e hJ
  have hπq (a : MvPolynomial I B) : π (q a) = e a := rfl
  have hπ (E : {E : I →₀ ℕ // ∀ j, E j < p}) :
      π (v E) = E.val.prod (fun j n => t j ^ n) := by
    simp only [v, map_finsuppProd, map_pow, z, hπq, e, aeval_X]
  have hinj : Function.Injective π := by
    change Function.Injective π.toLinearMap
    apply (LinearMap.ker_eq_bot).mp
    apply bot_unique
    intro x hx
    have hxspan : x ∈ Submodule.span B (Set.range v) := by
      change x ∈ S
      rw [hspan]
      trivial
    rw [← Finsupp.range_linearCombination, LinearMap.mem_range] at hxspan
    obtain ⟨l, rfl⟩ := hxspan
    change π (Finsupp.linearCombination B v l) = 0 at hx
    have hl : Finsupp.linearCombination B
        (fun E : {E : I →₀ ℕ // ∀ j, E j < p} =>
          E.val.prod (fun j n => t j ^ n)) l = 0 := by
      simpa only [Finsupp.linearCombination_apply, map_finsuppSum,
        map_smul, hπ] using hx
    have hl0 : l = 0 := (linearIndependent_iff.mp hli) l hl
    simp [hl0]
  have hfJ : f ∈ J := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply hinj
    change π (q f) = π 0
    rw [hπq, map_zero]
    exact hf
  apply hJ
  clear hf
  change f ∈ Submodule.span (MvPolynomial I B) (Set.range g) at hfJ
  induction hfJ using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨j, rfl⟩ := hf
    have hpB : (p : B) = 0 := by
      apply Subtype.ext
      exact CharP.cast_eq_zero K p
    have hp : (p : MvPolynomial I B) = 0 := by
      rw [← map_natCast (C : B →+* MvPolynomial I B), hpB, map_zero]
    change pderiv i (X j ^ p - C (c j)) ∈ J
    rw [map_sub, Derivation.leibniz_pow,
      show pderiv i (C (c j)) = 0 from (pderiv i).map_algebraMap (c j), sub_zero]
    rw [← Nat.cast_smul_eq_nsmul (MvPolynomial I B), hp, zero_smul]
    exact J.zero_mem
  | zero => simp
  | add f₁ f₂ hf₁ hf₂ h₁ h₂ => rw [map_add]; exact J.add_mem h₁ h₂
  | smul a f hf ih =>
    change pderiv i (a * f) ∈ J
    rw [Derivation.leibniz]
    simp only [smul_eq_mul]
    exact J.add_mem (J.mul_mem_left _ ih) (J.mul_mem_right _ hf)


end MvPolynomial
