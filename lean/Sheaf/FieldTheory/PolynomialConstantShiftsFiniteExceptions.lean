module

public import Mathlib.FieldTheory.Separable

/-!
# Finitely many inseparable constant shifts

Source: agent-supplied finite-exception argument using Stacks Project, `fields.tex`,
Tags 09H0 and 09H1 (coprimality with the formal derivative).
(blueprint: lem-trf-polynomial-constant-shifts-finite-exceptions)
-/

@[expose] public section

universe u

namespace Polynomial

/-- A polynomial with nonzero formal derivative has only finitely many inseparable
constant shifts over its coefficient field.

Source: agent-supplied finite-exception argument using Stacks Project, `fields.tex`,
Tag 09H0 (the polynomial ideal argument, lines 1145–1150) and Tag 09H1 (separability
convention, lines 1164–1178).
(blueprint: lem-trf-polynomial-constant-shifts-finite-exceptions)

Proof plan (the node's proof):
1. Put `p = derivative h ≠ 0` and let `D` be the set of monic divisors of `p`. By
   lem-trf-finite-monic-polynomial-divisors, `D` is finite; so is its subset `D₀` of
   nonunits.
2. Fix an exceptional `b` and put `f_b = h + C b`. Then `derivative f_b = p`, since the
   derivative of a constant is zero. As `f_b` is not separable, no `U V` satisfy
   `U * f_b + V * p = 1`.
3. By lem-pur-polynomial-field-pid, the ideal `(f_b, p)` is generated by some `g`. Then
   `g` divides `f_b` and `p`; `g ≠ 0` as `p ≠ 0`; and `g` is not a unit, since otherwise
   `1 = U * f_b + V * p` for some `U V`, contrary to step 2.
4. Let `a ≠ 0` be the leading coefficient of `g` and `d = C a⁻¹ * g`. Then `d` is monic,
   divides `f_b` and `p`, and is a nonunit. Hence `d ∈ D₀` and `d ∣ h + C b`.
5. For `d ∈ D₀` put `E_d = {b | d ∣ h + C b}`. If `b, c ∈ E_d` with `b ≠ c`, then
   `d ∣ C (b - c)`, a unit, so `d` would be a unit; hence `E_d` has at most one element.
   By step 4 the exceptional set lies in the finite union of the `E_d`, `d ∈ D₀`, so it
   is finite. -/
theorem finite_setOf_not_separable_add_C {F : Type u} [Field F]
    (h : F[X]) (hh : derivative h ≠ 0) :
    Set.Finite {b : F | ¬ (h + C b).Separable} := by
  sorry

end Polynomial
