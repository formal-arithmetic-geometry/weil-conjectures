module

public import Mathlib.FieldTheory.RatFunc.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.Valuation.ValuationSubring
public import Mathlib.RingTheory.AlgebraicIndependent.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.UniqueFactorizationDomain.Defs

/-!
# Residue generation by normalized irreducible factors

Source: Temkin, *Stable modification of relative curves*, Proposition 4.3.1,
proof, printed p. 28, paragraph beginning “Note that `L̃` is generated over `K̃`”
(blueprint: lem-trf-normalized-polynomial-residue-generation).
-/

@[expose] public section

universe u

open scoped Polynomial

namespace ValuationSubring

/-- The pullback to `K` of a valuation subring of `RatFunc K` along the constant map.
Source: Temkin, Proposition 4.3.1, proof, p. 28 (blueprint:
`lem-trf-normalized-polynomial-residue-generation`). -/
noncomputable def normalizedPolynomialResidueBaseSubring (K : Type u) [Field K]
    (O : ValuationSubring (RatFunc K)) : ValuationSubring K :=
  O.comap (algebraMap K (RatFunc K))

/-- The canonical local map from the constant pullback valuation subring to `O`.
Source: Temkin, Proposition 4.3.1, proof, p. 28 (blueprint:
`lem-trf-normalized-polynomial-residue-generation`). -/
noncomputable def normalizedPolynomialResidueBaseMap (K : Type u) [Field K]
    (O : ValuationSubring (RatFunc K)) :
    normalizedPolynomialResidueBaseSubring K O →+* O :=
  ((algebraMap K (RatFunc K)).comp
      (normalizedPolynomialResidueBaseSubring K O).subtype).codRestrict O.toSubring
    (fun x => (ValuationSubring.mem_comap).mp x.property)

/-- The canonical constant pullback is local.
Proof: a constant is a unit in the pullback exactly when its inverse is also in
that pullback. If its image is a unit of `O`, the inverse of that image lies in
`O`; it is the image of the inverse constant, so both constants lie in the
pullback. Thus the map reflects units.
Source: Temkin, Proposition 4.3.1, proof, p. 28 (blueprint:
`lem-trf-normalized-polynomial-residue-generation`). -/
@[instance]
theorem normalizedPolynomialResidueBaseMap_isLocal (K : Type u) [Field K]
    (O : ValuationSubring (RatFunc K)) :
    IsLocalHom (normalizedPolynomialResidueBaseMap K O) := by
  sorry

/-- The residue-field algebra induced by the canonical constant pullback.
Source: Temkin, Proposition 4.3.1, proof, p. 28 (blueprint:
`lem-trf-normalized-polynomial-residue-generation`). -/
noncomputable instance normalizedPolynomialResidueAlgebra (K : Type u) [Field K]
    (O : ValuationSubring (RatFunc K)) :
    Algebra (IsLocalRing.ResidueField (normalizedPolynomialResidueBaseSubring K O))
      (IsLocalRing.ResidueField O) :=
  RingHom.toAlgebra
    (IsLocalRing.ResidueField.map (normalizedPolynomialResidueBaseMap K O))

/-- If the value group does not enlarge on passing from `K` to `K(t)`, the residue
field is generated by normalized irreducible polynomial residues; transcendence degree
one forces one of these residues to be transcendental.
Source: Temkin, *Stable modification of relative curves*, Proposition 4.3.1,
proof, printed p. 28, paragraph beginning “Note that `L̃` is generated over `K̃`”
(blueprint: lem-trf-normalized-polynomial-residue-generation).

Proof:
1. The valuation alternative restricts to the constant field. A constant is a unit in
   the pullback ring exactly when it is a unit in `O`, so reduction induces the
   canonical embedding of base residue fields used by the algebra instance.
2. By `lem-sc-p1-polynomial-noetherian`, `lem-pur-polynomial-field-pid` and
   `lem-trf-factorization-exists`, each nonzero numerator and denominator is a
   nonzero constant times a finite product of monic irreducibles. Divide each
   irreducible by its nonzero leading coefficient and absorb those coefficients
   into the constant. Unit polynomials give empty products.
3. By `def-weil-rational-function-field`, write a unit as `P(t)/Q(t)` with nonzero
   `P,Q`. Normalize the factors using `hscale`. Their product identity expresses
   the unit as a constant times normalized factors and their inverses. Solving
   for that constant shows it is a unit of `O` and of the constant pullback ring.
   Its residue is therefore in the base residue field, and reduction of the
   product identity puts the original residue in the generated intermediate field.
4. Every nonzero residue lifts to a unit; zero belongs to every intermediate field.
   Thus the generated intermediate field is the whole residue field. Different
   unit normalizations differ by a constant unit and hence by a base residue scalar.
5. If every generator were algebraic, the subfield of algebraic elements
   (`def-weil-relative-algebraic-closure`) would contain all generators and therefore
   the whole residue field. No nonempty subset would be algebraically independent,
   so `def-kun-transcendence-degree` gives transcendence degree zero, a contradiction.
-/
theorem normalizedPolynomialResidueGeneration (K : Type u) [Field K]
    (O : ValuationSubring (RatFunc K))
    (hscale : ∀ x : RatFunc K, x ≠ 0 →
      ∃ c : Kˣ, ∃ u : Oˣ,
        ((u : O) : RatFunc K) = algebraMap K (RatFunc K) c * x) :
    IntermediateField.adjoin
        (IsLocalRing.ResidueField (normalizedPolynomialResidueBaseSubring K O))
        {x : IsLocalRing.ResidueField O |
          ∃ (f : Polynomial K) (π : Kˣ) (u : Oˣ),
            Polynomial.Monic f ∧ Irreducible f ∧
            ((u : O) : RatFunc K) =
              algebraMap (Polynomial K) (RatFunc K) f /
                algebraMap K (RatFunc K) π ∧
            x = IsLocalRing.residue O (u : O)} = ⊤ ∧
    (Algebra.trdeg
        (IsLocalRing.ResidueField (normalizedPolynomialResidueBaseSubring K O))
        (IsLocalRing.ResidueField O) = (1 : Cardinal) →
      ∃ (f : Polynomial K) (π : Kˣ) (u : Oˣ),
        Polynomial.Monic f ∧ Irreducible f ∧
        ((u : O) : RatFunc K) =
          algebraMap (Polynomial K) (RatFunc K) f /
            algebraMap K (RatFunc K) π ∧
        Transcendental
          (IsLocalRing.ResidueField (normalizedPolynomialResidueBaseSubring K O))
          (IsLocalRing.residue O (u : O))) := by
  sorry

end ValuationSubring
