module

public import Mathlib.Algebra.Order.AddGroupWithTop
public import Mathlib.FieldTheory.Galois.Basic
public import Mathlib.RingTheory.Valuation.Integers
public import Mathlib.RingTheory.Valuation.ValuationRing
public import Mathlib.Topology.Order
public import WeilConjectures.Mathlib.RingTheory.Henselian

import Mathlib.GroupTheory.OrderOfElement
import Sheaf.FieldTheory.HenselianFiniteExtensionTopology

/-!
# Krasner neighbourhoods over henselian valued fields

Source: Illusie–Laszlo–Orgogozo, Travaux de Gabber, XX §4.4, printed p.374,
referring to Bourbaki, Algèbre commutative VI §8, exercises 12 and 14(a).
(blueprint: lem-per-henselian-krasner-neighbourhood)

Mathlib's `AddValuation` uses additive values and sends zero to infinity.
Its `toValuation` reverses the value order and writes the group multiplicatively;
thus `toValuation.integer` is exactly the subring of nonnegative additive values,
and the topology below is generated by exactly the balls specified in the node.
Using all ambient group bounds also covers value groups larger than the value image.
-/

@[expose] public section

universe u v w

namespace FieldTheory

/-- Krasner's inequality implies field containment and gives an open neighbourhood, for any
valuation rank. When the element belongs to the base field the neighbourhood can be the whole
extension field.

Source: ILO, Travaux de Gabber, XX §4.4, printed p.374 (reference to Bourbaki VI §8,
exercises 12 and 14(a)). (blueprint: lem-per-henselian-krasner-neighbourhood)

Proof plan (agent reconstruction of the referenced Krasner argument):
1. By `lem-per-henselian-finite-extension-topology`, the henselian base valuation has a unique
   prolongation valuation subring. Every base-field automorphism of the extension therefore
   preserves this subring and its units.
2. By `lem-weil-pbc-finite-galois-fixed-field`, the automorphism group is finite. Strict comparison
   of two nonzero values is determined by whether their quotient belongs to the valuation
   subring but is not a unit. Thus each automorphism preserves strict comparisons. Its finite
   order rules out a strict increase or decrease of any value, so it preserves values exactly.
3. An automorphism fixing the field generated by beta fixes beta. The ultrametric inequality
   applied to alpha minus its conjugate bounds its value below by the value of alpha minus beta.
   The strict Krasner hypothesis forces that automorphism to fix alpha, including alpha = beta.
4. By `lem-exc-etale-galois-fixed-field-subgroup`, the fixed field of the subgroup fixing the
   field generated by beta is that very field. Consequently it contains alpha.
5. If alpha belongs to the base, take the whole field. Otherwise finite Galois fixed-field
   theory supplies a moving conjugate. The finite nonempty set of distances in additive
   valuation from alpha to its moving conjugates has a finite maximum gamma. The ball of
   radius gamma about alpha is open, contains alpha, and satisfies all the Krasner inequalities.
   This uses no completeness or rank hypothesis. -/
theorem henselian_krasner_neighbourhood
    {F : Type u} [Field F] {N : Type v} [Field N] [Algebra F N]
    [FiniteDimensional F N] [IsGalois F N]
    {Γ : Type w} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
    (vF : AddValuation F (WithTop Γ))
    [vF.toValuation.IsNontrivial] [HenselianLocalRing vF.toValuation.integer]
    (wN : AddValuation N (WithTop Γ))
    (hw : wN.comap (algebraMap F N) = vF) (α : N) :
    (∀ β : N, (∀ σ : N ≃ₐ[F] N, σ α ≠ α →
      wN (α - σ α) < wN (α - β)) → α ∈ IntermediateField.adjoin F {β}) ∧
    ∃ U : Set N,
      @IsOpen N (TopologicalSpace.generateFrom
        {B : Set N | ∃ a : N, ∃ γ : Γ, B = {x : N | (γ : WithTop Γ) < wN (x - a)}}) U ∧
      α ∈ U ∧
      (∀ β ∈ U, α ∈ IntermediateField.adjoin F {β}) ∧
      (α ∈ Set.range (algebraMap F N) → U = Set.univ) := by
  classical
  have hbase : wN.toValuation.valuationSubring.comap (algebraMap F N) =
      vF.toValuation.valuationSubring := by
    ext x
    change (0 : WithTop Γ) ≤ wN (algebraMap F N x) ↔ 0 ≤ vF x
    have hx : wN (algebraMap F N x) = vF x := congrArg (fun v ↦ v x) hw
    rw [hx]
  let : HenselianLocalRing vF.toValuation.valuationSubring :=
    inferInstanceAs (HenselianLocalRing vF.toValuation.integer)
  obtain ⟨W, _, _, huniq, _⟩ :=
    Valuation.henselian_finite_extension_topology (E := N) vF.toValuation
  have hequiv (σ : N ≃ₐ[F] N) :
      (wN.toValuation.comap σ.toRingHom).IsEquiv wN.toValuation := by
    apply (Valuation.isEquiv_iff_valuationSubring _ _).2
    apply (huniq _ ?_).trans (huniq _ hbase).symm
    ext x
    change (0 : WithTop Γ) ≤ wN (σ (algebraMap F N x)) ↔ 0 ≤ vF x
    rw [σ.commutes]
    exact congrArg (fun v ↦ v x) hw ▸ Iff.rfl
  have hle (σ : N ≃ₐ[F] N) (x : N) : wN (σ x) ≤ wN x := by
    by_contra h
    have hx : wN x < wN (σ x) := lt_of_not_ge h
    have hstep (n : ℕ) : wN ((σ ^ n) x) < wN ((σ ^ (n + 1)) x) := by
      rw [pow_succ, AlgEquiv.mul_apply]
      exact ((hequiv (σ ^ n)).lt_iff_lt (x := σ x) (y := x)).2 hx
    have hstrict := strictMono_nat_of_lt_succ hstep
    have hcycle := hstrict (orderOf_pos σ)
    simp only [pow_zero, pow_orderOf_eq_one, AlgEquiv.one_apply, lt_self_iff_false] at hcycle
  have hinv (σ : N ≃ₐ[F] N) (x : N) : wN (σ x) = wN x := by
    apply le_antisymm (hle σ x)
    simpa only [AlgEquiv.symm_apply_apply] using hle σ.symm (σ x)
  have hkrasner (β : N)
      (hβ : ∀ σ : N ≃ₐ[F] N, σ α ≠ α → wN (α - σ α) < wN (α - β)) :
      α ∈ IntermediateField.adjoin F {β} := by
    rw [← IsGalois.fixedField_fixingSubgroup (IntermediateField.adjoin F {β})]
    apply (IntermediateField.mem_fixedField_iff _ _).2
    intro σ hσ
    have hfix : σ β = β :=
      (IntermediateField.mem_fixingSubgroup_iff _ _).1 hσ β
        (IntermediateField.subset_adjoin F {β} (Set.mem_singleton β))
    by_contra hmove
    have hval : wN (α - β) ≤ wN (α - σ α) := by
      calc
        wN (α - β) = min (wN (α - β)) (wN (σ (α - β))) := by rw [hinv, min_self]
        _ ≤ wN ((α - β) - σ (α - β)) := wN.map_sub _ _
        _ = wN (α - σ α) := by rw [map_sub σ, hfix, sub_sub_sub_cancel_right]
    exact (not_lt_of_ge hval) (hβ σ hmove)
  refine ⟨hkrasner, ?_⟩
  let : TopologicalSpace N := TopologicalSpace.generateFrom
    {B : Set N | ∃ a : N, ∃ γ : Γ, B = {x : N | (γ : WithTop Γ) < wN (x - a)}}
  let S := {σ : N ≃ₐ[F] N // σ α ≠ α}
  let B : S → Set N := fun σ ↦ {β | wN (α - σ.val α) < wN (β - α)}
  refine ⟨⋂ σ : S, B σ, ?_, ?_, ?_, ?_⟩
  · apply isOpen_iInter_of_finite
    intro σ
    obtain ⟨γ, hγ⟩ := WithTop.ne_top_iff_exists.1
      ((wN.ne_top_iff).2 (sub_ne_zero.mpr (Ne.symm σ.prop)))
    apply TopologicalSpace.isOpen_generateFrom_of_mem
    exact ⟨α, γ, by simp only [B, hγ]⟩
  · apply Set.mem_iInter.2
    intro σ
    change wN (α - σ.val α) < wN (α - α)
    rw [sub_self, wN.map_zero]
    exact lt_top_iff_ne_top.2 ((wN.ne_top_iff).2 (sub_ne_zero.mpr (Ne.symm σ.prop)))
  · intro β hβ
    apply hkrasner β
    intro σ hσ
    have h := Set.mem_iInter.1 hβ (⟨σ, hσ⟩ : S)
    change wN (α - σ α) < wN (β - α) at h
    rwa [wN.map_sub_swap β α] at h
  · intro hα
    apply Set.eq_univ_of_forall
    intro β
    apply Set.mem_iInter.2
    intro σ
    exact False.elim (σ.prop ((IsGalois.mem_range_algebraMap_iff_fixed α).1 hα σ))

end FieldTheory
