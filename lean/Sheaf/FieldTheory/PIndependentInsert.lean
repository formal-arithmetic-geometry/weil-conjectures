/-!
# Augmenting p-independent subsets

Source: Stacks Project, More on Algebra, Lemma Tag 07P2, third proof paragraph
(blueprint: lem-weil-pbc-p-independent-insert-outside-span).
-/

@[expose] public section

universe u v

namespace FieldTheory

/-- The bounded monomial span equals the field generated by its generators.
Source: Stacks Project, More on Algebra, Lemma Tag 07P2, third proof paragraph.

Proof: Reduce any exponent n as n mod p + p * (n / p). The removed p-th
powers lie in the coefficient field, so every unrestricted monomial is a scalar
multiple of a bounded monomial. Products of bounded monomials are unrestricted
monomials, hence the span is closed under multiplication by distribution. It contains
one and each generator, since p > 1. For nonzero a in the span, a^p belongs to the
coefficient field, and a inverse equals (a^p) inverse times a^(p-1). Thus the span
is a field containing the coefficient field and the generators. Conversely all
bounded monomials lie in the generated field, so equality follows.
-/
private theorem pMonomial_span_eq_adjoin
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    (p : ℕ) [Fact p.Prime] [CharP k p] [CharP K p] (T : Set K) :
    (IntermediateField.adjoin
      (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p))) T).toSubalgebra.toSubmodule =
    Submodule.span (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p)))
      (Set.range (fun E : {E : T →₀ ℕ // ∀ t : T, E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e))) := by
  classical
  let F := IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p))
  let M := Submodule.span F
    (Set.range (fun E : {E : T →₀ ℕ // ∀ t : T, E t < p} ↦
      E.val.prod (fun t e ↦ (t : K) ^ e)))
  have hp : 0 < p := (Fact.out : p.Prime).pos
  have hpth (a : K) : a ^ p ∈ F :=
    IntermediateField.subset_adjoin k _ (Set.mem_range_self a)
  have hmono (E : T →₀ ℕ) : E.prod (fun t e ↦ (t : K) ^ e) ∈ M := by
    let D := E.mapRange (fun n ↦ n % p) (Nat.zero_mod p)
    have hD : ∀ t : T, D t < p := fun t ↦ Nat.mod_lt _ hp
    let c : F := ⟨E.prod (fun t n ↦ ((t : K) ^ p) ^ (n / p)), by
      apply F.prod_mem
      intro t ht
      exact F.toSubalgebra.pow_mem (hpth t) _⟩
    have hprod : E.prod (fun t n ↦ (t : K) ^ n) =
        c • D.prod (fun t n ↦ (t : K) ^ n) := by
      change E.prod _ = (c : K) * D.prod _
      dsimp [c, D]
      rw [Finsupp.prod_mapRange_index (by simp)]
      rw [← Finsupp.prod_mul]
      apply Finsupp.prod_congr
      intro t ht
      rw [← pow_mul, ← pow_add]
      congr 1
      exact (Nat.div_add_mod (E t) p).symm
    rw [hprod]
    exact M.smul_mem c (Submodule.subset_span ⟨⟨D, hD⟩, rfl⟩)
  have hone : (1 : K) ∈ M := by
    simpa using hmono (0 : T →₀ ℕ)
  have hgen (t : T) : (t : K) ∈ M := by
    simpa using hmono (Finsupp.single t 1)
  have hmul {a b : K} (ha : a ∈ M) (hb : b ∈ M) : a * b ∈ M := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨E, rfl⟩ := ha
      induction hb using Submodule.span_induction with
      | mem b hb =>
        obtain ⟨D, rfl⟩ := hb
        rw [← Finsupp.prod_add_index' (by simp) (by intros; exact pow_add _ _ _)]
        exact hmono (E.val + D.val)
      | zero => simp
      | add b c hb hc ihb ihc => simpa [mul_add] using M.add_mem ihb ihc
      | smul c b hb ih => simpa [Algebra.smul_def, mul_left_comm] using M.smul_mem c ih
    | zero => simp
    | add a c ha hc iha ihc => simpa [add_mul] using M.add_mem iha ihc
    | smul c a ha ih => simpa [Algebra.smul_def, mul_assoc] using M.smul_mem c ih
  let A : Subalgebra F K :=
    { M with
      one_mem' := hone
      mul_mem' := fun ha hb ↦ hmul ha hb
      algebraMap_mem' := fun c ↦ by simpa [Algebra.smul_def] using M.smul_mem c hone }
  have hinv {a : K} (ha : a ∈ M) : a⁻¹ ∈ M := by
    by_cases hz : a = 0
    · simp [hz]
    let c : F := ⟨a ^ p, hpth a⟩
    have heq : a⁻¹ = c⁻¹ • a ^ (p - 1) := by
      change a⁻¹ = (a ^ p)⁻¹ * a ^ (p - 1)
      rw [← div_eq_inv_mul, eq_div_iff (pow_ne_zero p hz)]
      rw [inv_mul_eq_iff_eq_mul₀ hz]
      rw [← pow_succ', Nat.sub_add_cancel hp]
    rw [heq]
    exact M.smul_mem c⁻¹ (A.pow_mem ha _)
  let L : IntermediateField F K :=
    { A with inv_mem' := fun a ha ↦ hinv ha }
  apply le_antisymm
  · have hle : IntermediateField.adjoin F T ≤ L :=
      IntermediateField.adjoin_le_iff.mpr (fun t ht ↦ hgen ⟨t, ht⟩)
    exact hle
  · apply Submodule.span_le.mpr
    rintro a ⟨E, rfl⟩
    apply (IntermediateField.adjoin F T).prod_mem
    intro t ht
    exact (IntermediateField.adjoin F T).toSubalgebra.pow_mem
      (IntermediateField.subset_adjoin F T t.property) _

/-- An element outside the bounded monomial span has independent first p powers.
Source: Stacks Project, More on Algebra, Lemma Tag 07P2, third proof paragraph.

The span equality makes x lie outside L = F(T). Its p-th power c lies in L,
but has no p-th root there: injectivity of Frobenius would identify such a root
with x. Thus X^p - C(c) is irreducible by the Mathlib lemma tagged Stacks 09HF.
It is monic and annihilates x, so it is the minimal polynomial. Its degree p
then gives independence of the first p powers by `linearIndependent_pow`.
-/
private theorem pIndependent_powers_of_not_mem_span
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    (p : ℕ) [Fact p.Prime] [CharP k p] [CharP K p]
    (T : Set K)
    (x : K)
    (hx : x ∉ Submodule.span
      (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p)))
      (Set.range (fun E : {E : T →₀ ℕ // ∀ t : T, E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e)))) :
    LinearIndependent
      (IntermediateField.adjoin
        (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p))) T)
      (fun i : Fin p ↦ x ^ (i : ℕ)) := by
  classical
  let F := IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p))
  let L := IntermediateField.adjoin F T
  have hxL : x ∉ L := by
    intro h
    apply hx
    change x ∈ (IntermediateField.adjoin F T).toSubalgebra.toSubmodule at h
    rw [pMonomial_span_eq_adjoin p T] at h
    exact h
  have hxp : x ^ p ∈ F :=
    IntermediateField.subset_adjoin k _ (Set.mem_range_self x)
  let c : L := ⟨x ^ p, L.algebraMap_mem ⟨x ^ p, hxp⟩⟩
  have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C c) := by
    apply X_pow_sub_C_irreducible_of_prime (Fact.out : p.Prime)
    intro b hb
    have heq : (b : K) ^ p = x ^ p := congrArg (fun a : L ↦ (a : K)) hb
    have hbx : (b : K) = x := frobenius_inj K p heq
    exact hxL (hbx ▸ b.property)
  have heval : Polynomial.aeval x (Polynomial.X ^ p - Polynomial.C c) = 0 := by
    simp [c]
  have hpoly := minpoly.eq_of_irreducible_of_monic hirr heval
    (Polynomial.monic_X_pow_sub_C c (Fact.out : p.Prime).ne_zero)
  have hd : (minpoly L x).natDegree = p := by
    rw [← hpoly, Polynomial.natDegree_X_pow_sub_C]
  have h := linearIndependent_pow (K := L) x
  rw [hd] at h
  exact h

/-- Independent bounded monomials and independent powers over their generated field
combine to give independent bounded monomials after insertion.
Source: Stacks Project, More on Algebra, Lemma Tag 07P2, third proof paragraph.

Proof: Since x is outside T, identify insert x T with T plus a singleton. Restrict
an exponent function to T and read its exponent at x. These two pieces determine
it uniquely, and its monomial is the old monomial times the corresponding power
of x. Regard the old monomials as elements of L = F(T); they remain F-independent
since inclusion into K is injective. The scalar-tower independence theorem gives
independence of all products of an old monomial and a power of x. Restrict this
independent product family along the injective splitting map of exponent functions.
-/
private theorem pIndependent_insert_core
    {F : Type u} {K : Type v} [Field F] [Field K] [Algebra F K]
    (p : ℕ) (T : Set K)
    (hT : LinearIndependent F
      (fun E : {E : T →₀ ℕ // ∀ t : T, E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e)))
    (x : K) (hxT : x ∉ T)
    (hpow : LinearIndependent (IntermediateField.adjoin F T)
      (fun i : Fin p ↦ x ^ (i : ℕ))) :
    LinearIndependent F
      (fun E : {E : ↥(insert x T) →₀ ℕ // ∀ t : ↥(insert x T), E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e)) := by
  classical
  let L := IntermediateField.adjoin F T
  let B := {E : T →₀ ℕ // ∀ t : T, E t < p}
  let C := {E : ↥(insert x T) →₀ ℕ // ∀ t : ↥(insert x T), E t < p}
  let b : B → L := fun E ↦ ⟨E.val.prod (fun t n ↦ (t : K) ^ n), by
    apply L.prod_mem
    intro t ht
    exact L.toSubalgebra.pow_mem (IntermediateField.subset_adjoin F T t.property) (E.val t)⟩
  have hb : LinearIndependent F b := by
    apply LinearIndependent.of_comp L.val.toLinearMap
    exact hT
  have hprod := linearIndependent_smul hb hpow
  let e := Equiv.Set.insert hxT
  let f : C → (T ⊕ PUnit →₀ ℕ) := fun E ↦ Finsupp.equivCongrLeft e E.val
  let q : C → B × Fin p := fun E ↦
    (⟨(f E).comapDomain Sum.inl Sum.inl_injective.injOn, fun t ↦ by
      change (f E) (Sum.inl t) < p
      exact E.property (e.symm (Sum.inl t))⟩,
      ⟨(f E) (Sum.inr PUnit.unit), E.property (e.symm (Sum.inr PUnit.unit))⟩)
  have hq : Function.Injective q := by
    intro E D h
    apply Subtype.ext
    apply (Finsupp.equivCongrLeft e).injective
    ext z
    cases z with
    | inl t =>
      exact congrArg (fun a : B ↦ a.val t) (congrArg Prod.fst h)
    | inr t =>
      cases t
      exact congrArg (fun a : Fin p ↦ (a : ℕ)) (congrArg Prod.snd h)
  have hfactor (E : C) :
      E.val.prod (fun t n ↦ (t : K) ^ n) =
        (b (q E).1 : K) * x ^ ((q E).2 : ℕ) := by
    have he : (f E).prod (fun t n ↦ ((e.symm t : ↥(insert x T)) : K) ^ n) =
        E.val.prod (fun t n ↦ (t : K) ^ n) := by
      simp [f, Finsupp.prod_equivMapDomain]
    rw [← he]
    have hs : f E = ((f E).comapDomain Sum.inl Sum.inl_injective.injOn).sumElim
        (Finsupp.single PUnit.unit ((f E) (Sum.inr PUnit.unit))) := by
      ext z
      cases z with
      | inl t => simp
      | inr t => cases t; simp
    rw [hs, Finsupp.prod_sumElim]
    simp [b, q, Function.comp_def, e]
  convert hprod.comp q hq using 1
  funext E
  exact hfactor E

/-- Adjoining an element outside the bounded monomial span preserves p-independence.
Source: Stacks Project, More on Algebra, Definition Tag 07P1 and Lemma Tag 07P2,
third proof paragraph (blueprint: lem-weil-pbc-p-independent-insert-outside-span).

Proof:
1. Put F = kK^p and let L be the F-span of the bounded monomials of T. It contains
   1, F, and T. Multiply monomials by adding exponents and reducing them modulo p;
   the removed p-th powers belong to F. Distribute over finite sums to show that L
   is closed under multiplication. If a is nonzero in L, then a^p is nonzero in F,
   so a inverse equals (a^p) inverse times a^(p-1), which belongs to L. Thus L is
   a subfield, equal to the subfield generated by F and T.
2. If x is outside L, it is integral over L as a root of X^p - x^p. Its minimal
   polynomial has degree d with 1 ≤ d ≤ p and divides (X-x)^p over K. Hence it is
   (X-x)^d: after translating X by x, the least nonzero degrees in a factorization
   of X^p add to p, just as the degrees do, so each monic factor is a monomial.
   If d < p, the coefficient -d*x and invertibility of d in characteristic p put x
   in L, a contradiction. Thus d = p, and the first p powers of x are independent
   over L by the simple-extension power basis theorem.
3. A generator t in T is itself a bounded monomial (exponent 1 at t), so x is
   outside T. Identify insert x T with T disjoint union a singleton. Its bounded
   exponent functions split into an exponent function on T and an integer j < p.
   Group a finite relation in these monomials by j. The coefficients of the powers
   of x lie in L. Independence of those powers kills each grouped coefficient;
   independence of T then kills each original coefficient. Hence insert x T is
   p-independent. This uses X^p - x^p, correcting the source's misprint X^p - x.
-/
theorem pIndependent_insert_of_not_mem_span
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    (p : ℕ) [Fact p.Prime] [CharP k p] [CharP K p]
    (T : Set K)
    (hT : LinearIndependent
      (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p)))
      (fun E : {E : T →₀ ℕ // ∀ t : T, E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e)))
    (x : K)
    (hx : x ∉ Submodule.span
      (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p)))
      (Set.range (fun E : {E : T →₀ ℕ // ∀ t : T, E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e)))) :
    LinearIndependent (IntermediateField.adjoin k (Set.range (fun a : K ↦ a ^ p)))
      (fun E : {E : ↥(insert x T) →₀ ℕ // ∀ t : ↥(insert x T), E t < p} ↦
        E.val.prod (fun t e ↦ (t : K) ^ e)) := by
  have hxT : x ∉ T := by
    intro h
    apply hx
    let E : {E : T →₀ ℕ // ∀ t : T, E t < p} :=
      ⟨Finsupp.single ⟨x, h⟩ 1, fun t ↦ by
        classical
        by_cases ht : (⟨x, h⟩ : T) = t
        · subst t
          simpa using (Fact.out : p.Prime).one_lt
        · simp [ht, (Fact.out : p.Prime).pos]⟩
    have he : E.val.prod (fun t e ↦ (t : K) ^ e) = x := by
      classical
      simp [E]
    exact he ▸ Submodule.subset_span (Set.mem_range_self E)
  apply pIndependent_insert_core p T hT x hxT
  exact pIndependent_powers_of_not_mem_span p T x hx

end FieldTheory
