module

public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import Mathlib.Algebra.Polynomial.Monic

import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.RingTheory.AlgebraTower
import Mathlib.LinearAlgebra.LinearIndependent.Basic

/-!
# Triangular relations over the base field of an algebraic tower

Source: Stacks Project, proof of Tag 07BV, the inductive choice of monic polynomials.
-/

@[expose] public section

universe u v

namespace FieldTheory

/-- A finite algebraic family has monic triangular relations over its base field,
with linearly independent products bounded by their degrees.
Source: Stacks Project, proof of Tag 07BV, inductive minimal-polynomial construction;
Tag 09G1, the simple algebraic extension, and Tag 09G9, products of tower bases
(blueprint: lem-weil-pbc-algebraic-tower-triangular-relations).

Proof: Induct on the length of the family. The empty product is one, hence
independent. At the next stage let L be the field generated by the preceding b_j.
Since those generators are integral, L equals the subalgebra they generate, so
evaluation of multivariate polynomials in the preceding generators surjects onto L.
The last generator is integral over L. Lift its monic minimal polynomial along this
surjection, keeping it monic and of unchanged degree. This gives the last triangular
relation and its vanishing. The powers below the minimal polynomial's degree are
L-independent by linearIndependent_pow. Regard the preceding bounded products as
elements of L; their F-independence follows from that of their images in K. Then
linearIndependent_smul gives F-independence of products with the new powers.
Split an exponent tuple into its initial tuple and last exponent; the splitting is
injective. Restrict the independent product family along this splitting and use
Fin.prod_univ_castSucc. Repeated or base-field generators have degree one;
separability and a spanning assertion are not needed. -/
theorem exists_algebraicTower_triangularRelations
    (F : Type u) (K : Type v) [Field F] [Field K] [Algebra F K]
    (m : ℕ) (b : Fin m → K) (hb : ∀ i, IsIntegral F (b i)) :
    ∃ q : (i : Fin m) → Polynomial (MvPolynomial (Fin i.val) F),
      (∀ i, (q i).Monic) ∧
      (∀ i, Polynomial.eval₂
        (MvPolynomial.aeval (fun j : Fin i.val ↦ b ⟨j.val, by omega⟩)).toRingHom
        (b i) (q i) = 0) ∧
      LinearIndependent F
        (fun a : ((i : Fin m) → Fin ((q i).natDegree)) ↦ ∏ i, b i ^ (a i).val) := by
  classical
  induction m with
  | zero =>
    refine ⟨(fun i ↦ Fin.elim0 i), (fun i ↦ Fin.elim0 i), (fun i ↦ Fin.elim0 i), ?_⟩
    rw [linearIndependent_unique_iff]
    simp
  | succ n ih =>
    let b₀ : Fin n → K := fun i ↦ b i.castSucc
    obtain ⟨q₀, hq₀, hz₀, hi₀⟩ := ih b₀ (fun i ↦ hb i.castSucc)
    let L := IntermediateField.adjoin F (Set.range b₀)
    let bL : Fin n → L := fun i ↦ ⟨b₀ i, IntermediateField.subset_adjoin F _ ⟨i, rfl⟩⟩
    let ev : MvPolynomial (Fin n) F →ₐ[F] L := MvPolynomial.aeval bL
    have hev : L.val.comp ev = MvPolynomial.aeval b₀ := by
      ext; simp [ev, bL]
    have hsurj : Function.Surjective ev := by
      intro c
      have hc : (c : K) ∈ Algebra.adjoin F (Set.range b₀) := by
        rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
          (fun t ht ↦ by obtain ⟨i, rfl⟩ := ht; exact (hb i.castSucc).isAlgebraic)]
        exact c.property
      rw [Algebra.adjoin_range_eq_range_aeval] at hc
      obtain ⟨r, hr⟩ := hc
      refine ⟨r, Subtype.ext ?_⟩
      change L.val (ev r) = (c : K)
      rw [← AlgHom.comp_apply, hev]
      exact hr
    have hblast : IsIntegral L (b (Fin.last n)) := (hb (Fin.last n)).tower_top
    obtain ⟨r, hr, hdegree, hmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      (Polynomial.mem_lifts_of_surjective hsurj (minpoly L (b (Fin.last n))))
      (minpoly.monic hblast)
    let q : (i : Fin (n + 1)) → Polynomial (MvPolynomial (Fin i.val) F) :=
      Fin.lastCases r q₀
    have hlast : Polynomial.eval₂
        (MvPolynomial.aeval b₀).toRingHom (b (Fin.last n)) r = 0 := by
      rw [← hev]
      change Polynomial.eval₂ (L.val.toRingHom.comp ev.toRingHom) _ r = 0
      rw [← Polynomial.eval₂_map, hr]
      exact minpoly.aeval L (b (Fin.last n))
    refine ⟨q, ?_, ?_, ?_⟩
    · intro i
      refine Fin.lastCases ?_ (fun j ↦ ?_) i
      · simpa [q] using hmonic
      · simpa [q] using hq₀ j
    · intro i
      refine Fin.lastCases ?_ (fun j ↦ ?_) i
      · have hbinit : (fun j : Fin n ↦ b ⟨j.val, by omega⟩) = b₀ := by
          funext j
          rfl
        simpa only [q, Fin.lastCases_last, Fin.val_last, hbinit] using hlast
      · simpa [q, b₀] using hz₀ j
    · let v : ((i : Fin n) → Fin ((q₀ i).natDegree)) → L := fun a ↦
        ∏ i, bL i ^ (a i).val
      have hv : LinearIndependent F v := by
        apply LinearIndependent.of_comp L.val.toLinearMap
        simpa [v, bL, b₀, Function.comp_def] using hi₀
      have htower := linearIndependent_smul hv
        (linearIndependent_pow (K := L) (b (Fin.last n)))
      let f : ((i : Fin (n + 1)) → Fin ((q i).natDegree)) →
          (((i : Fin n) → Fin ((q₀ i).natDegree)) ×
            Fin (minpoly L (b (Fin.last n))).natDegree) := fun a ↦
        ((fun j ↦ ⟨(a j.castSucc).val, by simpa [q] using (a j.castSucc).isLt⟩),
          ⟨(a (Fin.last n)).val, by simpa [q, hdegree] using (a (Fin.last n)).isLt⟩)
      have hf : Function.Injective f := by
        intro a a' h
        funext i
        apply Fin.ext
        refine Fin.lastCases ?_ (fun j ↦ ?_) i
        · exact congrArg (fun t ↦ t.2.val) h
        · exact congrArg (fun t ↦ (t.1 j).val) h
      convert htower.comp f hf using 1
      funext a
      simp [f, v, bL, Algebra.smul_def, Fin.prod_univ_castSucc, b₀]

end FieldTheory
