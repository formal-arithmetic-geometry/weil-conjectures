module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.Algebra.Algebra.ZMod
import Mathlib.Algebra.CharP.Algebra
import Sheaf.FieldTheory.PthRootNotMemPreviousAdjoin

/-!
# Degree of adjoining roots of elements with independent differentials

Source: Stacks Project, Algebra, Lemma 10.158.3 (Tag 07DZ)
(blueprint: lem-weil-pbc-pth-roots-extension-degree).
-/

@[expose] public section

universe u v

namespace IntermediateField

attribute [local instance] ZMod.algebra

/-- In characteristic `p`, adjoining the `p`-th roots of `n` elements whose differentials
over the prime field are linearly independent over `k` gives degree `p ^ n`.
Source: Stacks Project, Algebra, Tag 07DZ
(blueprint: lem-weil-pbc-pth-roots-extension-degree).

Proof:
1. Induct on n. The empty family generates the base field, of degree one.
2. Restrict independence to the preceding family and apply the induction hypothesis.
   The nonmembership lemma pth_root_not_mem_previous_adjoin supplies the differential
   obstruction: the final root is outside the field L generated by the preceding roots.
3. Frobenius injectivity shows that a_last has no p-th root in L. Mathlib's
   X_pow_sub_C_irreducible_of_prime proves X^p-a_last irreducible. This monic polynomial
   annihilates the final root, so it is its minimal polynomial. The simple-extension
   power basis therefore gives finiteness and degree p over L.
4. Multiply degrees and identify the iterated adjunction with adjunction of the full
   family using adjoin_adjoin_left. -/
theorem finiteDimensional_finrank_adjoin_pth_roots
    (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p]
    (Ω : Type v) [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (n : ℕ) (a : Fin n → k)
    (hind : LinearIndependent k (fun i : Fin n ↦ KaehlerDifferential.D (ZMod p) k (a i)))
    (α : Fin n → Ω) (hα : ∀ i : Fin n, α i ^ p = algebraMap k Ω (a i)) :
    FiniteDimensional k (adjoin k (Set.range α)) ∧
      Module.finrank k (adjoin k (Set.range α)) = p ^ n := by
  classical
  have : CharP Ω p := (Algebra.charP_iff k Ω p).mp inferInstance
  induction n with
  | zero =>
    have hempty : Set.range α = ∅ := by
      ext x
      simp
    rw [hempty, adjoin_empty, pow_zero]
    exact ⟨inferInstance, IntermediateField.finrank_bot⟩
  | succ n ih =>
    let L := adjoin k (Set.range (fun i : Fin n ↦ α i.castSucc))
    obtain ⟨hfinite, hdegree⟩ := ih (fun i ↦ a i.castSucc)
      (hind.comp Fin.castSucc (Fin.castSucc_injective n)) (fun i ↦ α i.castSucc)
      (fun i ↦ hα i.castSucc)
    have : FiniteDimensional k L := hfinite
    let b : L := algebraMap k L (a (Fin.last n))
    have hroot : α (Fin.last n) ^ p = algebraMap L Ω b := by
      simpa [b, IsScalarTower.algebraMap_apply] using hα (Fin.last n)
    have hnot := pth_root_not_mem_previous_adjoin p k Ω n a hind α hα
    have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C b) := by
      apply X_pow_sub_C_irreducible_of_prime (Fact.out : p.Prime)
      intro c hc
      have he : (algebraMap L Ω c) ^ p = α (Fin.last n) ^ p := by
        rw [← map_pow, hc, hroot]
      have heq : algebraMap L Ω c = α (Fin.last n) := frobenius_inj Ω p he
      exact hnot (heq ▸ c.property)
    have hmin : minpoly L (α (Fin.last n)) = Polynomial.X ^ p - Polynomial.C b := by
      symm
      apply minpoly.eq_of_irreducible_of_monic hirr
      · simp [hroot]
      · exact Polynomial.monic_X_pow_sub_C b (Fact.out : p.Prime).ne_zero
    have hint : IsIntegral L (α (Fin.last n)) := by
      refine ⟨Polynomial.X ^ p - Polynomial.C b,
        Polynomial.monic_X_pow_sub_C b (Fact.out : p.Prime).ne_zero, ?_⟩
      simp [hroot]
    have : FiniteDimensional L (adjoin L {α (Fin.last n)}) :=
      adjoin.finiteDimensional hint
    have : FiniteDimensional k (adjoin L {α (Fin.last n)}) :=
      Module.Finite.trans L (adjoin L {α (Fin.last n)})
    have hstep : Module.finrank L (adjoin L {α (Fin.last n)}) = p := by
      rw [adjoin.finrank hint, hmin, Polynomial.natDegree_X_pow_sub_C]
    have hrange : Set.range α =
        Set.range (fun i : Fin n ↦ α i.castSucc) ∪ {α (Fin.last n)} := by
      ext x
      simp only [Set.mem_range, Set.mem_union, Set.mem_singleton_iff]
      constructor
      · rintro ⟨i, rfl⟩
        refine Fin.lastCases ?_ (fun j ↦ ?_) i
        · exact Or.inr rfl
        · exact Or.inl ⟨j, rfl⟩
      · rintro (⟨i, rfl⟩ | rfl)
        · exact ⟨i.castSucc, rfl⟩
        · exact ⟨Fin.last n, rfl⟩
    have hfield : (adjoin L {α (Fin.last n)}).restrictScalars k =
        adjoin k (Set.range α) := by
      rw [hrange]
      exact adjoin_adjoin_left k _ _
    rw [← hfield]
    change FiniteDimensional k (adjoin L {α (Fin.last n)}) ∧
      Module.finrank k (adjoin L {α (Fin.last n)}) = p ^ (n + 1)
    refine ⟨inferInstance, ?_⟩
    rw [← Module.finrank_mul_finrank k L (adjoin L {α (Fin.last n)}),
      hdegree, hstep, pow_succ]

end IntermediateField
