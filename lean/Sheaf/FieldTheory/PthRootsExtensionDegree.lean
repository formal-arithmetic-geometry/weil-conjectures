module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.Algebra.Algebra.ZMod

/-!
# Degree of adjoining roots of elements with independent differentials

Source: Stacks Project, Algebra, Lemma 10.158.3 (Tag 07DZ)
(blueprint: lem-weil-pbc-pth-roots-extension-degree).
-/

@[expose] public section

universe u v

namespace IntermediateField

attribute [local instance] ZMod.algebra

/-- In characteristic `p`, adjoining the `p`-th roots of `n` elements whose differentials
over the prime field are linearly independent over `k` gives degree `p ^ n`.
Source: Stacks Project, Algebra, Tag 07DZ
(blueprint: lem-weil-pbc-pth-roots-extension-degree).

Proof:
1. In the algebraic closure each polynomial `X ^ p - a i` has exactly one root: existence
   follows from algebraic closedness (def-weil-algebraic-closure), and uniqueness from
   injectivity of Frobenius. Induct on the number `m` of roots adjoined. The empty family
   generates the base field, of degree one (def-pc-field-extension).
2. The monomials in the first `m` roots with each exponent less than `p` span a subring:
   reduce exponents using the root equations. This subring is a finite-dimensional domain,
   hence a field by lem-weil-pbc-finite-dimensional-domain-is-field. It therefore equals
   the field generated by those roots.
3. If the next element were a `p`-th power in the preceding field, express its root in
   the spanning monomials. Frobenius gives an expression in the preceding `a i` with
   coefficients that are `p`-th powers in the base field. Applying the universal derivation
   (def-weil-pbc-kahler-differentials) kills those coefficients and expresses the next
   differential in the span of the preceding ones, contradicting independence.
4. By lem-weil-pbc-simple-algebraic-extension-power-basis the next simple extension has
   a power basis of size `e`, with minimal polynomial dividing `X ^ p - a i`. In the
   closure this polynomial is `(X - root) ^ p`, so the minimal polynomial is
   `(X - root) ^ e`, with `1 ≤ e ≤ p`. If `e < p`, its coefficient `-e * root` puts the
   root in the preceding field, contradicting step 3. Thus `e = p`.
5. Multiply degrees using lem-weil-pbc-field-degree-multiplicativity to obtain `p ^ m`
   at each induction stage, and finally `p ^ n`. -/
theorem finiteDimensional_finrank_adjoin_pth_roots
    (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p]
    (Ω : Type v) [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (n : ℕ) (a : Fin n → k)
    (hind : LinearIndependent k (fun i : Fin n ↦ KaehlerDifferential.D (ZMod p) k (a i)))
    (α : Fin n → Ω) (hα : ∀ i : Fin n, α i ^ p = algebraMap k Ω (a i)) :
    FiniteDimensional k (adjoin k (Set.range α)) ∧
      Module.finrank k (adjoin k (Set.range α)) = p ^ n := by
  sorry

end IntermediateField
