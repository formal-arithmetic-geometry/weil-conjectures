module

public import Mathlib.RingTheory.Localization.Away.Basic
public import WeilConjectures.Blowup.Affine.Defs

/-!

# The affine blow-up chart algebra `A[I/a]`

For an ideal `I` of a commutative ring `A` and `a ∈ I`, the chart algebra `A[I/a]` is the
`A`-subalgebra of the localization `A_a` generated by the fractions `x / a`, `x ∈ I`. We show
that its elements are exactly the fractions `x / a ^ n` with `x ∈ I ^ n`, and that it is
isomorphic to the chart ring `Away (reesGrading I) (a·X)` of the affine blow-up used in
`WeilConjectures.Blowup.Affine.Defs`, via `x·Xⁿ / (a·X)ⁿ ↦ x / aⁿ`.

## Main definitions

- `AlgebraicGeometry.AffineBlowup.chartRing` — the chart algebra `A[I/a] ⊆ A_a`.
- `AlgebraicGeometry.AffineBlowup.homogeneousAwayToLocalization` — the ring map
  `Away (reesGrading I) (a·X) →+* A_a`, `x·Xⁿ / (a·X)ⁿ ↦ x / aⁿ`.
- `AlgebraicGeometry.AffineBlowup.homogeneousAwayToChart` — the map `θ_a` into `A[I/a]`.
- `AlgebraicGeometry.AffineBlowup.homogeneousAwayEquivChart` — `θ_a` as a ring isomorphism.

## Main results

- `AlgebraicGeometry.AffineBlowup.mem_chartRing_iff` — normal form of elements of `A[I/a]`.
- `AlgebraicGeometry.AffineBlowup.chartFraction_eq_iff` — equality of chart fractions.
- `AlgebraicGeometry.AffineBlowup.homogeneousAwayToChart_injective` and
  `AlgebraicGeometry.AffineBlowup.homogeneousAwayToChart_surjective`.

-/

@[expose] public section

universe u

open HomogeneousLocalization

namespace AlgebraicGeometry.AffineBlowup

variable {A : Type u} [CommRing A] (I : Ideal A) (a : A)

/-- The fraction `x / a ^ n` in `A_a`. -/
noncomputable abbrev chartFraction (n : ℕ) (x : A) : Localization.Away a :=
  Localization.mk x ⟨a ^ n, n, rfl⟩

/-- The affine blow-up chart algebra `A[I/a]`: the `A`-subalgebra of `A_a` generated by the
fractions `x / a` with `x ∈ I`.
(blueprint: `def-nagata-blowup-chart-ring`) -/
noncomputable def chartRing : Subalgebra A (Localization.Away a) :=
  Algebra.adjoin A (Set.range fun x : I ↦ chartFraction a 1 (x : A))

variable {a}

lemma chartFraction_zero (x : A) : chartFraction a 0 x = algebraMap A _ x := by
  have h : (⟨a ^ 0, 0, rfl⟩ : Submonoid.powers a) = 1 := Subtype.ext (pow_zero a)
  rw [chartFraction, h, Localization.mk_one_eq_algebraMap]

lemma chartFraction_add (n : ℕ) (x y : A) :
    chartFraction a n (x + y) = chartFraction a n x + chartFraction a n y :=
  (Localization.add_mk_self _ _ _).symm

lemma chartFraction_mul (m n : ℕ) (x y : A) :
    chartFraction a (m + n) (x * y) = chartFraction a m x * chartFraction a n y := by
  have h : (⟨a ^ (m + n), m + n, rfl⟩ : Submonoid.powers a) =
      ⟨a ^ m, m, rfl⟩ * ⟨a ^ n, n, rfl⟩ := Subtype.ext (pow_add a m n)
  rw [chartFraction, h, ← Localization.mk_mul]

/-- **Equality of chart fractions**: `x / a ^ m = y / a ^ n` in `A_a` if and only if some
power of `a` annihilates `a ^ n x - a ^ m y`. No cancellation of `a` is used, since `a` may be
a zero divisor.
(blueprint: `lemma-nagata-chart-ring-fraction-equality`) -/
lemma chartFraction_eq_iff {m n : ℕ} {x y : A} :
    chartFraction a m x = chartFraction a n y ↔
      ∃ k : ℕ, a ^ k * (a ^ n * x) = a ^ k * (a ^ m * y) := by
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  constructor
  · rintro ⟨⟨_, k, rfl⟩, h⟩
    exact ⟨k, h⟩
  · rintro ⟨k, h⟩
    exact ⟨⟨a ^ k, k, rfl⟩, h⟩

lemma chartFraction_mem_chartRing {n : ℕ} {x : A} (hx : x ∈ I ^ n) :
    chartFraction a n x ∈ chartRing I a := by
  induction n generalizing x with
  | zero =>
    rw [chartFraction_zero]
    exact Subalgebra.algebraMap_mem _ x
  | succ n ih =>
    rw [pow_succ'] at hx
    induction hx using Submodule.mul_induction_on' with
    | mem_mul_mem m hm y hy =>
      rw [add_comm n 1, chartFraction_mul]
      exact Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨⟨m, hm⟩, rfl⟩) (ih hy)
    | add x hx y hy ihx ihy =>
      rw [chartFraction_add]
      exact Subalgebra.add_mem _ ihx ihy

section Theta

variable (ha : a ∈ I)

/-- Evaluation of the Rees algebra at `X = 1 / a`, `x·Xⁿ ↦ x / aⁿ`. -/
noncomputable def reesEval (a : A) : reesAlgebra I →+* Localization.Away a :=
  (Polynomial.eval₂RingHom (algebraMap A _) (IsLocalization.Away.invSelf a)).comp
    (reesAlgebra I).val.toRingHom

lemma reesEval_reesMonomial {n : ℕ} (x : A) (hx : x ∈ I ^ n) :
    reesEval I a (reesMonomial I x hx) = chartFraction a n x := by
  simp only [reesEval, RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, Subalgebra.coe_val, coe_reesMonomial, Polynomial.coe_eval₂RingHom,
    Polynomial.eval₂_monomial]
  rw [chartFraction, Localization.mk_eq_mk', IsLocalization.eq_mk'_iff_mul_eq]
  change _ * _ * algebraMap A _ (a ^ n) = _
  rw [map_pow, mul_assoc, ← mul_pow, mul_comm (IsLocalization.Away.invSelf a),
    IsLocalization.Away.mul_invSelf, one_pow, mul_one]

lemma reesEval_reesX : reesEval I a (reesX I a ha) = 1 := by
  rw [reesX, reesEval_reesMonomial, ← map_one (algebraMap A (Localization.Away a)),
    ← chartFraction_zero, chartFraction_eq_iff]
  exact ⟨0, by ring⟩

/-- The ring map `Away (reesGrading I) (a·X) →+* A_a`, `x·Xⁿ / (a·X)ⁿ ↦ x / aⁿ`. -/
noncomputable def homogeneousAwayToLocalization :
    HomogeneousLocalization.Away (reesGrading I) (reesX I a ha) →+* Localization.Away a :=
  (Localization.awayLift (reesEval I a) (reesX I a ha)
    (isUnit_iff_exists_inv.mpr ⟨1, by rw [reesEval_reesX, one_mul]⟩)).comp
    (algebraMap _ (Localization.Away (reesX I a ha)))

lemma homogeneousAwayToLocalization_mk {n : ℕ} (x : A) (hx : x ∈ I ^ n)
    (h : reesMonomial I x hx ∈ reesGrading I (n • 1)) :
    homogeneousAwayToLocalization I ha
      (Away.mk (reesGrading I) (reesX_mem I a ha) n (reesMonomial I x hx) h) =
        chartFraction a n x := by
  simp only [homogeneousAwayToLocalization, RingHom.coe_comp, Function.comp_apply,
    HomogeneousLocalization.algebraMap_apply, Away.val_mk]
  rw [Localization.awayLift_mk (reesEval I a) _ _ 1 (by rw [reesEval_reesX, one_mul]),
    one_pow, mul_one, reesEval_reesMonomial]

lemma exists_eq_mk (z : HomogeneousLocalization.Away (reesGrading I) (reesX I a ha)) :
    ∃ (n : ℕ) (x : A) (hx : x ∈ I ^ n) (h : reesMonomial I x hx ∈ reesGrading I (n • 1)),
      z = Away.mk (reesGrading I) (reesX_mem I a ha) n (reesMonomial I x hx) h := by
  obtain ⟨n, F, hF, rfl⟩ := Away.mk_surjective (reesGrading I) (reesX_mem I a ha) z
  have hF' : F ∈ reesGrading I n := by simpa using hF
  obtain ⟨x, hx, rfl⟩ := (mem_reesGrading_iff_exists I).mp hF'
  exact ⟨n, x, hx, hF, rfl⟩

lemma homogeneousAwayToLocalization_mem_chartRing
    (z : HomogeneousLocalization.Away (reesGrading I) (reesX I a ha)) :
    homogeneousAwayToLocalization I ha z ∈ chartRing I a := by
  obtain ⟨n, x, hx, h, rfl⟩ := exists_eq_mk I ha z
  rw [homogeneousAwayToLocalization_mk]
  exact chartFraction_mem_chartRing I hx

include ha in
/-- **Normal form in the chart algebra**: the elements of `A[I/a]` are exactly the fractions
`x / a ^ n` with `x ∈ I ^ n`.
(blueprint: `lemma-nagata-chart-ring-normal-form`) -/
theorem mem_chartRing_iff {z : Localization.Away a} :
    z ∈ chartRing I a ↔ ∃ (n : ℕ) (x : A), x ∈ I ^ n ∧ z = chartFraction a n x := by
  constructor
  · intro hz
    suffices z ∈ Set.range (homogeneousAwayToLocalization I ha) by
      obtain ⟨w, rfl⟩ := this
      obtain ⟨n, x, hx, h, rfl⟩ := exists_eq_mk I ha w
      exact ⟨n, x, hx, homogeneousAwayToLocalization_mk I ha x hx h⟩
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨⟨x, hx⟩, rfl⟩ := hz
      have hx1 : x ∈ I ^ 1 := by rwa [pow_one]
      exact ⟨_, homogeneousAwayToLocalization_mk I ha (n := 1) x hx1
        (by simpa using reesMonomial_mem I x hx1)⟩
    | algebraMap r =>
      have hr : r ∈ I ^ 0 := by rw [pow_zero, Ideal.one_eq_top]; trivial
      refine ⟨_, (homogeneousAwayToLocalization_mk I ha (n := 0) r hr
        (by simpa using reesMonomial_mem I r hr)).trans (chartFraction_zero r)⟩
    | add x y _ _ hx hy =>
      obtain ⟨x, rfl⟩ := hx
      obtain ⟨y, rfl⟩ := hy
      exact ⟨x + y, map_add _ _ _⟩
    | mul x y _ _ hx hy =>
      obtain ⟨x, rfl⟩ := hx
      obtain ⟨y, rfl⟩ := hy
      exact ⟨x * y, map_mul _ _ _⟩
  · rintro ⟨n, x, hx, rfl⟩
    exact chartFraction_mem_chartRing I hx

/-- The homogeneous-localization chart map
`θ_a : Away (reesGrading I) (a·X) →+* A[I/a]`, `x·Xⁿ / (a·X)ⁿ ↦ x / aⁿ`. It is a well-defined
ring homomorphism by construction.
(blueprint: `def-nagata-homogeneous-away-to-chart`, `lemma-nagata-homogeneous-away-to-chart`) -/
noncomputable def homogeneousAwayToChart :
    HomogeneousLocalization.Away (reesGrading I) (reesX I a ha) →+* chartRing I a :=
  (homogeneousAwayToLocalization I ha).codRestrict (chartRing I a)
    (homogeneousAwayToLocalization_mem_chartRing I ha)

/-- The defining formula of `θ_a` on homogeneous fractions: `θ_a(x·Xⁿ / (a·X)ⁿ) = x / aⁿ`.
(blueprint: `def-nagata-homogeneous-away-to-chart`, `lemma-nagata-homogeneous-away-to-chart`) -/
@[simp]
lemma coe_homogeneousAwayToChart_mk {n : ℕ} (x : A) (hx : x ∈ I ^ n)
    (h : reesMonomial I x hx ∈ reesGrading I (n • 1)) :
    (homogeneousAwayToChart I ha
      (Away.mk (reesGrading I) (reesX_mem I a ha) n (reesMonomial I x hx) h) :
        Localization.Away a) = chartFraction a n x :=
  homogeneousAwayToLocalization_mk I ha x hx h

/-- `θ_a` is compatible with the structure maps from `A`. -/
lemma homogeneousAwayToChart_awayAlgebraMap (r : A) :
    homogeneousAwayToChart I ha (awayAlgebraMap I (reesX I a ha) r) = algebraMap A _ r := by
  have hr : r ∈ I ^ 0 := by rw [pow_zero, Ideal.one_eq_top]; trivial
  have e : awayAlgebraMap I (reesX I a ha) r =
      Away.mk (reesGrading I) (reesX_mem I a ha) 0 (reesMonomial I r hr)
        (by simpa using reesMonomial_mem I r hr) := by
    apply val_injective
    rw [Away.val_mk]
    rfl
  apply Subtype.ext
  rw [e, coe_homogeneousAwayToChart_mk, chartFraction_zero]
  rfl

/-- `θ_a` is injective.
(blueprint: `lemma-nagata-homogeneous-away-to-chart-injective`) -/
theorem homogeneousAwayToChart_injective :
    Function.Injective (homogeneousAwayToChart I ha) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨n, x, hx, h, rfl⟩ := exists_eq_mk I ha z
  have hz' := congrArg Subtype.val hz
  rw [coe_homogeneousAwayToChart_mk, ZeroMemClass.coe_zero, ← Localization.mk_zero
    (⟨a ^ 0, 0, rfl⟩ : Submonoid.powers a), chartFraction_eq_iff] at hz'
  obtain ⟨k, hk⟩ := hz'
  have hk' : a ^ k * x = 0 := by simpa using hk
  apply val_injective
  rw [Away.val_mk, val_zero, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
  refine ⟨⟨reesX I a ha ^ k, k, rfl⟩, Subtype.ext ?_⟩
  simp [reesX, hk']

/-- `θ_a` is surjective.
(blueprint: `lemma-nagata-homogeneous-away-to-chart-surjective`) -/
theorem homogeneousAwayToChart_surjective :
    Function.Surjective (homogeneousAwayToChart I ha) := by
  rintro ⟨z, hz⟩
  obtain ⟨n, x, hx, rfl⟩ := (mem_chartRing_iff I ha).mp hz
  exact ⟨_, Subtype.ext (coe_homogeneousAwayToChart_mk I ha (n := n) x hx
    (by simpa using reesMonomial_mem I x hx))⟩

/-- `θ_a` as a ring isomorphism `Away (reesGrading I) (a·X) ≃+* A[I/a]`.
(blueprint: `lemma-nagata-homogeneous-away-to-chart-injective`,
`lemma-nagata-homogeneous-away-to-chart-surjective`) -/
noncomputable def homogeneousAwayEquivChart :
    HomogeneousLocalization.Away (reesGrading I) (reesX I a ha) ≃+* chartRing I a :=
  RingEquiv.ofBijective (homogeneousAwayToChart I ha)
    ⟨homogeneousAwayToChart_injective I ha, homogeneousAwayToChart_surjective I ha⟩

@[simp]
lemma homogeneousAwayEquivChart_apply
    (z : HomogeneousLocalization.Away (reesGrading I) (reesX I a ha)) :
    homogeneousAwayEquivChart I ha z = homogeneousAwayToChart I ha z :=
  rfl

end Theta

end AlgebraicGeometry.AffineBlowup
