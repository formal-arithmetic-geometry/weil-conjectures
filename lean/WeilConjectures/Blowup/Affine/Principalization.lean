module

public import WeilConjectures.Blowup.Affine.Defs

/-!

# Principalization of the centre on the charts of the affine blow-up

Let `I : Ideal A` and let `a ∈ I`. The standard chart of the affine blow-up
`AffineBlowup I = Proj (reesGrading I)` at the degree-one element `a·X` is the spectrum of
the chart ring `HomogeneousLocalization.Away (reesGrading I) (reesX I a ha)`, which is the
ring denoted `A[I/a]` in the blueprint. This file shows that on such a chart the extended
ideal `I · A[I/a]` is generated by the image of `a`, that this image is a non-zerodivisor,
and that on the overlap of the charts at `a·X` and `b·X` the two exceptional generators
differ by a unit.

The three statements are proved for a chart at an element of the form `(a·X)·w` with `w`
homogeneous. The overlap of the charts at `a·X` and `b·X` is the chart at `(a·X)·(b·X)`, so
this single generality covers both the individual charts (`w = 1`) and their pairwise
overlaps; the specializations are `map_awayAlgebraMap_reesX_eq_span_singleton` and
`isRegular_awayAlgebraMap_reesX`.

## Main results

- `AlgebraicGeometry.AffineBlowup.map_awayAlgebraMap_eq_span_singleton` — the extended ideal
  `I · A[I/a]` is generated by the image of `a`.
- `AlgebraicGeometry.AffineBlowup.isRegular_awayAlgebraMap` — the image of `a` in `A[I/a]` is
  a non-zerodivisor.
- `AlgebraicGeometry.AffineBlowup.exists_units_awayAlgebraMap_eq_mul` — on the overlap of the
  charts at `a·X` and `b·X` the images of `a` and `b` differ by a unit.
- `AlgebraicGeometry.AffineBlowup.exists_isRegular_map_awayAlgebraMap_eq_span_singleton` —
  the packaged form: on every standard chart the extended ideal is generated by a single
  non-zerodivisor.

## Blueprint

This file implements `lemma:nagata-chart-extended-ideal-principal`,
`lemma:nagata-chart-generator-regular` and `lemma:nagata-chart-generators-associated` of the
Nagata compactification blueprint. The global statement
`thm:nagata-blowup-principalizes-center` is not covered here.

-/

@[expose] public section

universe u

open HomogeneousLocalization

namespace AlgebraicGeometry.AffineBlowup

variable {A : Type u} [CommRing A] {I : Ideal A}

@[simp]
lemma val_awayAlgebraMap (x : reesAlgebra I) (c : A) :
    (awayAlgebraMap I x c).val = Localization.mk ((reesGradingZero I c : reesAlgebra I)) 1 :=
  rfl

section Chart

variable {a : A} (ha : a ∈ I) {e : ℕ} {w : reesAlgebra I} (hw : w ∈ reesGrading I e)
  {x : reesAlgebra I} (hx : x = reesX I a ha * w)

include ha hw hx

/-- The element defining a chart of the form `(a·X)·w` is homogeneous of degree `1 + e`. -/
lemma mem_reesGrading_of_eq_reesX_mul : x ∈ reesGrading I (1 + e) := by
  rw [hx]
  exact SetLike.mul_mem_graded (reesX_mem I a ha) hw

/-- On the chart at `(a·X)·w`, every element `y` of `I` is the image of `a` times the
degree-zero fraction `(y·X)·w / (a·X)·w`, which is the blueprint's `y/a ∈ A[I/a]`.
(blueprint: part of `lemma:nagata-chart-extended-ideal-principal`) -/
lemma exists_mul_eq_awayAlgebraMap {y : A} (hy : y ∈ I) :
    ∃ z : Away (reesGrading I) x, awayAlgebraMap I x a * z = awayAlgebraMap I x y := by
  refine ⟨Away.mk (reesGrading I) (mem_reesGrading_of_eq_reesX_mul ha hw hx) 1
    (reesX I y hy * w)
    (by rw [one_smul]; exact SetLike.mul_mem_graded (reesX_mem I y hy) hw), ?_⟩
  rw [HomogeneousLocalization.ext_iff_val, val_mul, val_awayAlgebraMap, val_awayAlgebraMap,
    Away.val_mk, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  apply Subtype.ext
  simp [hx, Polynomial.C_mul_monomial, mul_comm, mul_assoc, mul_left_comm]

/-- The extended ideal of the centre on the chart at `(a·X)·w` is generated by the image of
`a`. (blueprint: `lemma:nagata-chart-extended-ideal-principal`) -/
theorem map_awayAlgebraMap_eq_span_singleton :
    I.map (awayAlgebraMap I x) = Ideal.span {awayAlgebraMap I x a} := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun y hy ↦ ?_)
    (Ideal.span_le.mpr ?_)
  · obtain ⟨z, hz⟩ := exists_mul_eq_awayAlgebraMap ha hw hx hy
    exact Ideal.mem_span_singleton'.mpr ⟨z, by rw [mul_comm]; exact hz⟩
  · rintro - rfl
    exact Ideal.mem_map_of_mem _ ha

/-- On the chart at `(a·X)·w`, the image of `a` is a non-zerodivisor.
(blueprint: `lemma:nagata-chart-generator-regular`) -/
theorem isRegular_awayAlgebraMap : IsRegular (awayAlgebraMap I x a) := by
  have key : ∀ z : Away (reesGrading I) x, awayAlgebraMap I x a * z = 0 → z = 0 := by
    intro z hz
    obtain ⟨n, F, hF, rfl⟩ :=
      Away.mk_surjective (reesGrading I) (mem_reesGrading_of_eq_reesX_mul ha hw hx) z
    rw [HomogeneousLocalization.ext_iff_val, val_mul, val_zero, val_awayAlgebraMap,
      Away.val_mk, Localization.mk_mul, one_mul, Localization.mk_eq_mk',
      IsLocalization.mk'_eq_zero_iff] at hz
    obtain ⟨⟨-, k, rfl⟩, hk⟩ := hz
    rw [HomogeneousLocalization.ext_iff_val, val_zero, Away.val_mk, Localization.mk_eq_mk',
      IsLocalization.mk'_eq_zero_iff]
    refine ⟨⟨x ^ (k + 1), k + 1, rfl⟩, ?_⟩
    -- `X · w` is in general not an element of the Rees algebra, so the cancellation of `a`
    -- has to be carried out in the ambient polynomial ring.
    have hk' : (x : Polynomial A) ^ k * (Polynomial.C a * (F : Polynomial A)) = 0 := by
      simpa using congrArg (fun p : reesAlgebra I ↦ (p : Polynomial A)) hk
    have hxval : (x : Polynomial A) = Polynomial.C a * Polynomial.X * (w : Polynomial A) := by
      simp [hx, ← Polynomial.C_mul_X_eq_monomial]
    have hgoal : (x ^ (k + 1) : reesAlgebra I) * F = 0 := by
      apply Subtype.ext
      push_cast
      calc (x : Polynomial A) ^ (k + 1) * (F : Polynomial A)
          = Polynomial.X * (w : Polynomial A) *
              ((x : Polynomial A) ^ k * (Polynomial.C a * (F : Polynomial A))) := by
            rw [hxval]; ring
        _ = 0 := by rw [hk', mul_zero]
    exact hgoal
  refine (Commute.isRegular_iff fun b ↦ Commute.all _ b).mpr fun z₁ z₂ h ↦ ?_
  replace h : awayAlgebraMap I x a * z₁ = awayAlgebraMap I x a * z₂ := h
  exact sub_eq_zero.mp (key _ (by rw [mul_sub, h, sub_self]))

end Chart

section Specializations

variable (I)

/-- The extended ideal of the centre on the standard chart at `a·X` is generated by the image
of `a`: in the blueprint's notation, `I·A[I/a] = (a)`.
(blueprint: `lemma:nagata-chart-extended-ideal-principal`) -/
theorem map_awayAlgebraMap_reesX_eq_span_singleton (a : A) (ha : a ∈ I) :
    I.map (awayAlgebraMap I (reesX I a ha)) =
      Ideal.span {awayAlgebraMap I (reesX I a ha) a} :=
  map_awayAlgebraMap_eq_span_singleton ha (w := 1) (SetLike.one_mem_graded _)
    (mul_one _).symm

/-- On the standard chart at `a·X`, the image of `a` is a non-zerodivisor: multiplication by
`a` on the blueprint's `A[I/a]` is injective.
(blueprint: `lemma:nagata-chart-generator-regular`) -/
theorem isRegular_awayAlgebraMap_reesX (a : A) (ha : a ∈ I) :
    IsRegular (awayAlgebraMap I (reesX I a ha) a) :=
  isRegular_awayAlgebraMap ha (w := 1) (SetLike.one_mem_graded _) (mul_one _).symm

/-- On every standard chart of the affine blow-up, the extended ideal of the centre is
generated by a single non-zerodivisor. This is the affine-local input to the statement that
the centre becomes an effective Cartier divisor on the blow-up.
(blueprint: chart-level form of `thm:nagata-blowup-principalizes-center`) -/
theorem exists_isRegular_map_awayAlgebraMap_eq_span_singleton (a : A) (ha : a ∈ I) :
    ∃ t : Away (reesGrading I) (reesX I a ha), IsRegular t ∧
      I.map (awayAlgebraMap I (reesX I a ha)) = Ideal.span {t} :=
  ⟨_, isRegular_awayAlgebraMap_reesX I a ha, map_awayAlgebraMap_reesX_eq_span_singleton I a ha⟩

/-- On the overlap of the standard charts at `a·X` and `b·X` — that is, on the chart at
`(a·X)·(b·X)` — the images of `a` and `b` differ by a unit.
(blueprint: `lemma:nagata-chart-generators-associated`) -/
theorem exists_units_awayAlgebraMap_eq_mul (a b : A) (ha : a ∈ I) (hb : b ∈ I) :
    ∃ u : (Away (reesGrading I) (reesX I a ha * reesX I b hb))ˣ,
      awayAlgebraMap I (reesX I a ha * reesX I b hb) b =
        awayAlgebraMap I (reesX I a ha * reesX I b hb) a * u := by
  obtain ⟨z, hz⟩ := exists_mul_eq_awayAlgebraMap ha (reesX_mem I b hb) rfl hb
  obtain ⟨z', hz'⟩ := exists_mul_eq_awayAlgebraMap hb (reesX_mem I a ha) (mul_comm _ _) ha
  have hreg := isRegular_awayAlgebraMap ha (reesX_mem I b hb) (x := reesX I a ha * reesX I b hb) rfl
  have hzz' : z * z' = 1 := by
    refine hreg.left (?_ : awayAlgebraMap I (reesX I a ha * reesX I b hb) a * (z * z') =
      awayAlgebraMap I (reesX I a ha * reesX I b hb) a * 1)
    rw [mul_one, ← mul_assoc, hz, hz']
  exact ⟨⟨z, z', hzz', (mul_comm z' z).trans hzz'⟩, hz.symm⟩

end Specializations

end AlgebraicGeometry.AffineBlowup
