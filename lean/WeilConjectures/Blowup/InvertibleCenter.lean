module

public import WeilConjectures.Blowup.Gluing
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

/-!

# Blowing up an already-invertible centre changes nothing

Let `X` be a scheme and `I : X.IdealSheafData` a quasi-coherent ideal which is already
invertible, that is, locally generated by a single non-zerodivisor
(`Scheme.IdealSheafData.IsInvertible`). We show that the blow-up map
`I.blowupMap : I.blowup ⟶ X` is then an isomorphism.

The proof is the same two-step shape as the principalization theorem of
`WeilConjectures.Blowup.Principalization`, run in the opposite direction. Being an
isomorphism is Zariski-local on the target, and `IsInvertible` is stated pointwise, so
`IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict` applies verbatim: for a point `x`
of `X` we take an affine open `U` witnessing invertibility at `x`, and over `U` the blow-up
map is identified by `isPullback_blowupι` with the affine blow-up structure morphism
`AffineBlowup.toSpec (I.ideal U)`, which is an isomorphism by
`AffineBlowup.isIso_toSpec_of_isRegularPrincipal`.

The pointwise phrasing of `IsInvertible` is not an obstacle here but it does dictate the
route: one may *not* apply it at an arbitrary affine open, because an invertible ideal need
not be regular principal on every affine open — a non-principal invertible ideal of a
Dedekind domain is a counterexample on an affine scheme. The cover has to be refined to the
affine opens that `IsInvertible` actually hands out, which is exactly what
`of_forall_exists_morphismRestrict` asks for.

## Main results

- `AlgebraicGeometry.Scheme.IdealSheafData.isIso_blowupMap_restrict_of_isRegularPrincipal` —
  the blow-up map is an isomorphism over an affine open on which the ideal is generated by a
  single non-zerodivisor.
- `AlgebraicGeometry.Scheme.IdealSheafData.isIso_blowupMap_of_isInvertible` — blowing up an
  invertible ideal is an isomorphism (blueprint: `cor:nagata-blowup-cartier-iso`).

## Blueprint

This file implements `cor:nagata-blowup-cartier-iso`. The blueprint deduces it from the
universal property of the blow-up (`thm:nagata-blowup-universal-property`, Stacks Tag 0806),
which is *not* formalized: it is phrased through relative `Proj`, which Mathlib does not
have, and this repo's blow-up is glued from affine blow-ups rather than built as a relative
`Proj`. The proof here bypasses it entirely by reducing to the affine charts.

-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- The blow-up map is an isomorphism over an affine open on which the ideal is generated by
a single non-zerodivisor. This is the affine-local input to
`isIso_blowupMap_of_isInvertible`, and the exact analogue of
`isIso_blowupMap_restrict_of_ideal_eq_top`. -/
lemma isIso_blowupMap_restrict_of_isRegularPrincipal {U : X.affineOpens}
    (h : (I.ideal U).IsRegularPrincipal) : IsIso (I.blowupMap ∣_ U.1) := by
  have hiso : IsIso (I.blowupNatTrans.app U) := by
    rw [I.blowupNatTrans_app U]
    have := AffineBlowup.isIso_toSpec_of_isRegularPrincipal h
    infer_instance
  have e : Arrow.mk (I.blowupMap ∣_ U.1.ι.opensRange) ≅ Arrow.mk (I.blowupNatTrans.app U) :=
    morphismRestrictArrowIso I.blowupMap (I.blowupNatTrans.app U) (I.blowupι_blowupMap U)
      (by rw [Scheme.Opens.opensRange_ι]; exact I.blowupMap_preimage U)
  have H : IsIso (I.blowupMap ∣_ U.1.ι.opensRange) := by
    rw [← MorphismProperty.isomorphisms.iff,
      (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff e,
      MorphismProperty.isomorphisms.iff]
    exact hiso
  rwa [Scheme.Opens.opensRange_ι] at H

/-- **Blowing up an already-invertible centre is an isomorphism.** If the quasi-coherent
ideal `I` is locally generated by a single non-zerodivisor, then the blow-up map
`Bl_I(X) ⟶ X` is an isomorphism. (blueprint: `cor:nagata-blowup-cartier-iso`) -/
theorem isIso_blowupMap_of_isInvertible (hI : I.IsInvertible) : IsIso I.blowupMap := by
  rw [← MorphismProperty.isomorphisms.iff]
  refine IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict fun x ↦ ?_
  obtain ⟨U, hxU, hU⟩ := hI x
  exact ⟨U.1, hxU, by
    rw [MorphismProperty.isomorphisms.iff]
    exact I.isIso_blowupMap_restrict_of_isRegularPrincipal hU⟩

end AlgebraicGeometry.Scheme.IdealSheafData
