module

public import WeilConjectures.SixFunctors.ProEtale.Adic.PadicIntSheafLinear
public import WeilConjectures.SixFunctors.ProEtale.Adic.ZModConstantRingSheaf

/-!
# Pro-étale abelian sheaves killed by `ℓⁿ` are `ℤ_ℓ,X`-modules

Let `X` be a scheme and `ℓ` a prime. An abelian sheaf `M` on `X_proét` killed by `ℓⁿ` is
canonically a module over the ring object `ℤ_ℓ,X = C(-, ℤ_ℓ)`
(`AlgebraicGeometry.ProEtale.padicIntModOfTorsion`), with underlying abelian sheaf `M` itself:

1. on presheaves, every abelian group killed by `N` is a `ℤ/N`-module, which makes `M` a module
   over the constant presheaf of rings `ℤ/N` (`CategoryTheory.Functor.zmodModObj`);
2. sheafifying, `M` is a module over the sheafification of the constant presheaf `ℤ/N`, which is
   the ring object `(ℤ/N)_X = C(-, ℤ/N)` (`AlgebraicGeometry.ProEtale.zmodConstSheafRingIso`);
3. restricting scalars along the reduction `ℤ_ℓ,X ⟶ (ℤ/ℓⁿ)_X` gives a `ℤ_ℓ,X`-module.

Every morphism of abelian sheaves between `ℤ_ℓ,X`-modules whose target is killed by `ℓⁿ` is
`ℤ_ℓ,X`-linear (`AlgebraicGeometry.ProEtale.padicInt_act_comp_eq_of_zsmul_eq_zero`), as `ℤ_ℓ,X`
is generated by the integers modulo `ℓⁿ`. Hence the structure does not depend on the chosen `n`
and is functorial: a tower `(Gₙ)` of abelian sheaves with `ℓⁿ Gₙ = 0` lifts to a tower of
`ℤ_ℓ,X`-modules with the same underlying tower
(`AlgebraicGeometry.ProEtale.padicIntModTowerOfTorsion`).
-/

@[expose] public section

universe w v u

open CategoryTheory MonoidalCategory MonObj Limits Opposite

namespace AddCommGrpCat

variable (N : ℕ) {A : Ab.{w}} (h : ∀ a : A, (N : ℤ) • a = 0)

/-- The action of `ℤ/N` on an abelian group `A` killed by `N`, as an additive map
`ℤ/N →+ End(A)`. -/
noncomputable def zmodSMulAddHom : ULift.{w} (ZMod N) →+ (A →+ A) :=
  (ZMod.lift N ⟨zmultiplesHom (A →+ A) (AddMonoidHom.id A), by
    ext a
    simpa using h a⟩).comp AddEquiv.ulift.toAddMonoidHom

/-- The integer `k` acts by `k • -`. -/
lemma zmodSMulAddHom_intCast (k : ℤ) (a : A) :
    zmodSMulAddHom N h (ULift.up (k : ZMod N)) a = k • a := by
  rw [zmodSMulAddHom, AddMonoidHom.comp_apply]
  exact DFunLike.congr_fun (ZMod.lift_coe N _ k) a

/-- The action of `ℤ/N` is multiplicative. -/
lemma zmodSMulAddHom_mul (z z' : ULift.{w} (ZMod N)) (a : A) :
    zmodSMulAddHom N h (z * z') a = zmodSMulAddHom N h z (zmodSMulAddHom N h z' a) := by
  obtain ⟨z⟩ := z
  obtain ⟨z'⟩ := z'
  obtain ⟨k, rfl⟩ := ZMod.intCast_surjective z
  obtain ⟨k', rfl⟩ := ZMod.intCast_surjective z'
  have e : (ULift.up (k : ZMod N) * ULift.up (k' : ZMod N) : ULift.{w} (ZMod N)) =
      ULift.up ((k * k' : ℤ) : ZMod N) := by
    rw [Int.cast_mul]
    rfl
  rw [e, zmodSMulAddHom_intCast, zmodSMulAddHom_intCast, zmodSMulAddHom_intCast, mul_smul]

/-- The action `ℤ/N ⊗ A ⟶ A` of `ℤ/N` on an abelian group `A` killed by `N`. -/
noncomputable def zmodSMul : of (ULift.{w} (ZMod N)) ⊗ A ⟶ A :=
  ofHom (TensorProduct.liftAddHom (zmodSMulAddHom N h) fun r m n ↦ by
    rw [map_zsmul, AddMonoidHom.smul_apply, map_zsmul])

/-- `AddCommGrpCat.zmodSMul` on pure tensors. -/
lemma zmodSMul_tmul (z : ULift.{w} (ZMod N)) (a : A) :
    (zmodSMul N h).hom (z ⊗ₜ[ℤ] a) = zmodSMulAddHom N h z a :=
  rfl

/-- The unit of `ℤ/N` acts trivially. -/
lemma one_whiskerRight_zmodSMul :
    η[of (ULift.{w} (ZMod N))] ▷ A ≫ zmodSMul N h = (λ_ A).hom :=
  hom_ext_toIntLinearMap (TensorProduct.ext' fun (n : ULift.{w} ℤ) (a : A) ↦
    zmodSMulAddHom_intCast N h n.down a)

/-- The action of `ℤ/N` is associative. -/
lemma mul_whiskerRight_zmodSMul :
    μ[of (ULift.{w} (ZMod N))] ▷ A ≫ zmodSMul N h =
      (α_ _ _ A).hom ≫ of (ULift.{w} (ZMod N)) ◁ zmodSMul N h ≫ zmodSMul N h :=
  hom_ext_toIntLinearMap (TensorProduct.ext_threefold fun z z' a ↦
    zmodSMulAddHom_mul N h z z' a)

/-- Additive maps between groups killed by `N` commute with the action of `ℤ/N`. -/
lemma zmodSMul_naturality {B : Ab.{w}} (h' : ∀ b : B, (N : ℤ) • b = 0) (f : A ⟶ B) :
    zmodSMul N h ≫ f = of (ULift.{w} (ZMod N)) ◁ f ≫ zmodSMul N h' :=
  hom_ext_toIntLinearMap (TensorProduct.ext' fun (z : ULift.{w} (ZMod N)) (a : A) ↦ by
    obtain ⟨z⟩ := z
    obtain ⟨k, rfl⟩ := ZMod.intCast_surjective z
    exact (congr_arg f.hom (zmodSMulAddHom_intCast N h k a)).trans
      ((map_zsmul f.hom k a).trans (zmodSMulAddHom_intCast N h' k (f.hom a)).symm))

end AddCommGrpCat

namespace CategoryTheory.Functor

variable {C : Type u} [Category.{v} C] (N : ℕ)

/-- The constant functor with value the ring `ℤ/N`, lifted to `Type w`. -/
noncomputable abbrev zmodConst : C ⥤ RingCat.{w} :=
  (Functor.const C).obj (RingCat.of (ULift.{w} (ZMod N)))

variable {N}

/-- **A presheaf of abelian groups killed by `N` is a module over the constant presheaf of
rings `ℤ/N`**, with the action `z ⊗ a ↦ z • a`. -/
@[implicit_reducible]
noncomputable def zmodModObj (M : C ⥤ Ab.{w}) (h : ∀ (U : C) (a : M.obj U), (N : ℤ) • a = 0) :
    ModObj (zmodConst (C := C) N ⋙ forget₂ RingCat.{w} Ab.{w}) M :=
  .mk' _
    { app U := AddCommGrpCat.zmodSMul N (h U)
      naturality U V f := AddCommGrpCat.hom_ext_toIntLinearMap (TensorProduct.ext' fun z a ↦ by
        obtain ⟨z⟩ := z
        obtain ⟨k, rfl⟩ := ZMod.intCast_surjective z
        exact (AddCommGrpCat.zmodSMulAddHom_intCast N (h V) k _).trans
          ((_root_.map_zsmul (M.map f).hom k a).symm.trans
            (congr_arg (M.map f).hom (AddCommGrpCat.zmodSMulAddHom_intCast N (h U) k a).symm))) }
    (NatTrans.ext (funext fun U ↦ AddCommGrpCat.one_whiskerRight_zmodSMul N (h U)))
    (NatTrans.ext (funext fun U ↦ AddCommGrpCat.mul_whiskerRight_zmodSMul N (h U)))

/-- A presheaf of abelian groups killed by `N`, as a module over the constant presheaf of rings
`ℤ/N`. -/
noncomputable def zmodMod (M : C ⥤ Ab.{w}) (h : ∀ (U : C) (a : M.obj U), (N : ℤ) • a = 0) :
    Mod (C ⥤ Ab.{w}) (zmodConst (C := C) N ⋙ forget₂ RingCat.{w} Ab.{w}) :=
  letI := zmodModObj M h
  ⟨M⟩

end CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale

open Scheme

attribute [local instance] Sheaf.monoidalCategory Sheaf.braidedCategory Abelian.hasFiniteBiproducts

variable {X : Scheme.{u}}

/-- An abelian sheaf killed by an integer `k` has all its sections killed by `k`. -/
lemma zsmul_eq_zero_of_zsmul_id_eq_zero {M : Sheaf (ProEt.topology X) Ab.{u + 1}} {k : ℤ}
    (hM : k • 𝟙 M = 0) (U : X.ProEtᵒᵖ) (a : M.obj.obj U) : k • a = 0 :=
  congr_arg (fun f : M ⟶ M ↦ (f.hom.app U).hom a) hM

variable (X) (N : ℕ)

/-- **An abelian sheaf killed by `N` is a module over `(ℤ/N)_X`**: the sheafification of the
module over the constant presheaf `ℤ/N` of
`CategoryTheory.Functor.zmodMod`, transported along `sheafify M ≅ M`. -/
noncomputable def zmodSheafModOfTorsion (M : Sheaf (ProEt.topology X) Ab.{u + 1})
    (hM : (N : ℤ) • 𝟙 M = 0) :
    Mod (Sheaf (ProEt.topology X) Ab.{u + 1})
      ((sheafCompose (ProEt.topology X) (forget₂ RingCat.{u + 1} Ab.{u + 1})).obj
        (continuousMapRingSheaf X (ZMod N))) :=
  letI : ModObj ((sheafCompose (ProEt.topology X) (forget₂ RingCat.{u + 1} Ab.{u + 1})).obj
      (continuousMapRingSheaf X (ZMod N))) M :=
    ModObj.ofIso (zmodConstSheafRingIso X N)
      (X := (((presheafToSheaf (ProEt.topology X) Ab.{u + 1}).mapMod _).obj
        (Functor.zmodMod M.obj (zsmul_eq_zero_of_zsmul_id_eq_zero hM))).X)
      (asIso ((sheafificationAdjunction (ProEt.topology X) Ab.{u + 1}).counit.app M) :
        (presheafToSheaf (ProEt.topology X) Ab.{u + 1}).obj M.obj ≅ M)
  ⟨M⟩

variable (l : ℕ) [Fact l.Prime]

/-- The reduction `ℤ_ℓ,X ⟶ (ℤ/ℓⁿ)_X`, a morphism of ring objects. -/
noncomputable abbrev padicIntAbSheafToZModPowRing (n : ℕ) :
    padicIntAbSheaf X l ⟶ (sheafCompose (ProEt.topology X) (forget₂ RingCat.{u + 1} Ab.{u + 1})).obj
      (continuousMapRingSheaf X (ZMod (l ^ n))) :=
  (sheafCompose (ProEt.topology X) (forget₂ RingCat.{u + 1} Ab.{u + 1})).map
    ((padicIntSheafCone X l).π.app (op n))

/-- **An abelian sheaf killed by `ℓⁿ` is a `ℤ_ℓ,X`-module**, through the reduction
`ℤ_ℓ,X ⟶ (ℤ/ℓⁿ)_X`. Its underlying abelian sheaf is `M`. -/
noncomputable def padicIntModOfTorsion (n : ℕ) (M : Sheaf (ProEt.topology X) Ab.{u + 1})
    (hM : ((l ^ n : ℕ) : ℤ) • 𝟙 M = 0) :
    Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (padicIntAbSheaf X l) :=
  (Mod.comap (padicIntAbSheafToZModPowRing X l n)).obj (zmodSheafModOfTorsion X (l ^ n) M hM)

@[simp]
lemma padicIntModOfTorsion_X (n : ℕ) (M : Sheaf (ProEt.topology X) Ab.{u + 1})
    (hM : ((l ^ n : ℕ) : ℤ) • 𝟙 M = 0) : (padicIntModOfTorsion X l n M hM).X = M :=
  rfl

variable {X l} in
/-- **Additive maps to `ℤ_ℓ,X`-modules killed by `ℓⁿ` are `ℤ_ℓ,X`-linear**: `ℤ_ℓ,X` is generated
by the integers modulo `ℓⁿ`. -/
lemma padicInt_act_comp_eq_of_zsmul_eq_zero {M T : Mod (Sheaf (ProEt.topology X) Ab.{u + 1})
    (padicIntAbSheaf X l)} (φ : M.X ⟶ T.X) {n : ℕ} (hT : ((l ^ n : ℕ) : ℤ) • 𝟙 T.X = 0) :
    Mod.act M.X ≫ φ = padicIntAbSheaf X l ◁ φ ≫ Mod.act T.X :=
  Mod.act_comp_eq_of_epi φ (fun _ : Unit ↦ ((l ^ n : ℕ) : ℤ))
    (fun _ ↦ Functor.map_epi (tensorRight M.X) _) (fun _ ↦ 𝟙 T.X) (fun _ ↦ hT)
    (fun f hf ↦ by simpa using hf ())

variable {X l} in
/-- A morphism of abelian sheaves between `ℤ_ℓ,X`-modules whose target is killed by `ℓⁿ`, as a
morphism of `ℤ_ℓ,X`-modules. -/
noncomputable def padicIntModHomOfTorsion {M T : Mod (Sheaf (ProEt.topology X) Ab.{u + 1})
    (padicIntAbSheaf X l)} (φ : M.X ⟶ T.X) {n : ℕ} (hT : ((l ^ n : ℕ) : ℤ) • 𝟙 T.X = 0) :
    M ⟶ T :=
  Mod.homMk φ (padicInt_act_comp_eq_of_zsmul_eq_zero φ hT)

/-- **Towers of abelian sheaves with `ℓⁿ Gₙ = 0` are towers of `ℤ_ℓ,X`-modules**: the `n`-th
term is `Gₙ` with its `ℤ_ℓ,X`-module structure `ProEtale.padicIntModOfTorsion`, and the
transition maps are automatically `ℤ_ℓ,X`-linear. -/
noncomputable def padicIntModTowerOfTorsion (G : ℕᵒᵖ ⥤ Sheaf (ProEt.topology X) Ab.{u + 1})
    (hG : ∀ n : ℕ, ((l ^ n : ℕ) : ℤ) • 𝟙 (G.obj (op n)) = 0) :
    ℕᵒᵖ ⥤ Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (padicIntAbSheaf X l) where
  obj n := padicIntModOfTorsion X l n.unop (G.obj n) (hG n.unop)
  map {_ n} f := padicIntModHomOfTorsion (G.map f) (hG n.unop)
  map_id _ := Mod.hom_ext _ _ (G.map_id _)
  map_comp _ _ := Mod.hom_ext _ _ (G.map_comp _ _)

/-- The tower of `ℤ_ℓ,X`-modules `ProEtale.padicIntModTowerOfTorsion G hG` has underlying tower of
abelian sheaves `G`. -/
lemma padicIntModTowerOfTorsion_comp_forget (G : ℕᵒᵖ ⥤ Sheaf (ProEt.topology X) Ab.{u + 1})
    (hG : ∀ n : ℕ, ((l ^ n : ℕ) : ℤ) • 𝟙 (G.obj (op n)) = 0) :
    padicIntModTowerOfTorsion X l G hG ⋙ Mod.forget _ = G :=
  rfl

end AlgebraicGeometry.ProEtale
