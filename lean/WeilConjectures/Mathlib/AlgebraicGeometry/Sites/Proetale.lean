/-!

# Complements on the small pro-étale site

The small pro-étale site `X.ProEt` of a scheme is the category of schemes weakly étale over
`X`, topologized by the pro-étale topology `AlgebraicGeometry.Scheme.ProEt.topology`, which
is generated by the precoverage of quasi-compact jointly surjective families of weakly étale
morphisms. In contrast to the small étale site, a covering is *not* merely a jointly
surjective family: quasi-compactness is part of the condition, so the covering criterion
`AlgebraicGeometry.Scheme.ofArrows_mem_smallEtaleTopology_iff` has no analogue here and the
inputs below are phrased in terms of membership in `proetalePrecoverage` instead.

This file provides the site-theoretic inputs for the pro-étale six functors of the
`WeilConjectures.SixFunctors.ProEtale` folder, in the same roles as
`WeilConjectures.Mathlib.AlgebraicGeometry.Sites.Small` and
`WeilConjectures.Mathlib.AlgebraicGeometry.Sites.Etale` play for the étale ones.

## Main results

- `AlgebraicGeometry.Scheme.ProEt.mem_topology_iff`: a sieve is covering for the pro-étale
  topology exactly when it contains a presieve of the pro-étale precoverage. This is
  `CategoryTheory.Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition` for the
  small pro-étale site, and it is what makes the covering conditions below checkable.
- `AlgebraicGeometry.Scheme.ProEt.isContinuous_overPullback`: base change along an
  *arbitrary* morphism `g : W ⟶ U` is continuous for the pro-étale topologies. It preserves
  covers because the base change square of `MorphismProperty.Over.isPullback_map_left` is
  cartesian and `proetalePrecoverage` is stable under base change, and it preserves
  compatible families because it is representably flat, the small pro-étale site being
  finitely complete.
- `AlgebraicGeometry.Scheme.ProEt.isContinuous_overMap` and
  `AlgebraicGeometry.Scheme.ProEt.isCocontinuous_overMap`: the localization functor
  `MorphismProperty.Over.map ⊤ h` along a weakly étale `f : V ⟶ U` is continuous and
  cocontinuous. Both directions are essentially a reindexing: the localization functor is
  the identity on underlying schemes and morphisms.
- `AlgebraicGeometry.Scheme.ProEt.ofArrows_baseChange_mem_topology`: the base changes
  `V ×_X W i` of a pro-étale covering family `g i : W i ⟶ X` cover every `V : X.ProEt`.
- `AlgebraicGeometry.Scheme.ProEt.isTerminalSectionsOfIsEmpty`: a sheaf on the small
  pro-étale site has terminal sections over an object whose underlying scheme is empty.
- `AlgebraicGeometry.Scheme.zariskiPrecoverage_le_proetalePrecoverage`: a Zariski open cover
  is a pro-étale covering family. This is what makes the two-open cover of
  `WeilConjectures.SixFunctors.ProEtale.LowerShriek.Proper` available.
- `AlgebraicGeometry.Scheme.ProEt.mem_topology_of_openImmersion`: a sieve on `U : X.ProEt`
  containing a jointly surjective family of open immersions `Y i ⟶ U`
  (`AlgebraicGeometry.Scheme.ProEt.ofOpenImmersionHom`) is covering.
- `AlgebraicGeometry.toProEt`: the inclusion `ν : X.Etale ⥤ X.ProEt` of the small
  étale site into the small pro-étale site, which is fully faithful, representably flat and
  continuous (`AlgebraicGeometry.Scheme.isContinuous_toProEt`).

-/

@[expose] public section

set_option linter.style.show false

universe w u' u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry.Scheme

/-- A Zariski open cover is a pro-étale covering family: it is quasi-compact since open
immersions are open maps, and open immersions are weakly étale. -/
lemma zariskiPrecoverage_le_proetalePrecoverage :
    zariskiPrecoverage ≤ proetalePrecoverage.{u} :=
  zariskiPrecoverage_le_propQCPrecoverage

section Quotient

/-- A subset of the target of a pro-étale covering family whose preimages are all open is open:
the members are flat and the family is quasi-compact. -/
lemma isOpen_of_isOpen_preimage_of_mem_proetalePrecoverage {Y : Scheme.{u}} {ι : Type*}
    {X : ι → Scheme.{u}} (f : ∀ i, X i ⟶ Y)
    (hf : Presieve.ofArrows X f ∈ proetalePrecoverage Y) (S : Set Y)
    (hS : ∀ i, IsOpen ((f i).base ⁻¹' S)) : IsOpen S := by
  rw [isOpen_iff_forall_mem_open]
  intro y hy
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ y) isOpen_univ
  refine ⟨S ∩ U, Set.inter_subset_left, ?_, hy, hyU⟩
  let E : PreZeroHypercover Y := ⟨ι, X, f⟩
  have : QuasiCompactCover E := by
    have := hf.1
    rwa [show Presieve.ofArrows X f = E.presieve₀ from rfl, presieve₀_mem_qcPrecoverage_iff] at this
  obtain ⟨n, a, V, hV, hU'⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact E
    (U := U) hU.isCompact
  have hflat (i : ι) : Flat (f i) := by
    have := proetalePrecoverage_le_precoverage_weaklyEtale _ hf ⟨i⟩
    infer_instance
  have (i : Fin n) : IsAffine (V i).toScheme := hV i
  let Z := ∐ fun i : Fin n ↦ (V i).toScheme
  have : IsAffine Z := inferInstance
  let h : Z ⟶ Y := Sigma.desc fun i ↦ (V i).ι ≫ f (a i)
  have hjs (z : Z) : ∃ i x, Sigma.ι (fun i : Fin n ↦ (V i).toScheme) i x = z := by
    exact (sigmaOpenCover fun i : Fin n ↦ (V i).toScheme).exists_eq z
  have hrange : Set.range h = U := by
    rw [← hU']
    ext y
    simp only [Set.mem_range, Set.mem_iUnion, Set.mem_image]
    constructor
    · rintro ⟨z, rfl⟩
      obtain ⟨i, x, rfl⟩ := hjs z
      refine ⟨i, (V i).ι x, by simp, ?_⟩
      change _ = (Sigma.ι (fun i : Fin n ↦ (V i).toScheme) i ≫ h) x
      rw [Sigma.ι_desc]
      rfl
    · rintro ⟨i, x, hx, rfl⟩
      obtain ⟨x, rfl⟩ : x ∈ Set.range (V i).ι := by rwa [Scheme.Opens.range_ι]
      exact ⟨Sigma.ι (fun i : Fin n ↦ (V i).toScheme) i x, by
        rw [← Scheme.Hom.comp_apply, Sigma.ι_desc, Scheme.Hom.comp_apply]⟩
  have : Flat h := IsZariskiLocalAtSource.sigmaDesc fun i ↦ inferInstance
  let p := pullback.snd h (Scheme.Opens.ι U)
  have hfst : IsIso (pullback.fst h (Scheme.Opens.ι U)) := by
    rw [isIso_iff_isOpenImmersion_and_surjective]
    refine ⟨inferInstance, ⟨fun z ↦ ?_⟩⟩
    have hz : h z ∈ (U : Set Y) := hrange ▸ Set.mem_range_self z
    obtain ⟨u, hu⟩ : h z ∈ Set.range (Scheme.Opens.ι U) := by rwa [Scheme.Opens.range_ι]
    obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback z u hu.symm
    exact ⟨w, hw⟩
  have : CompactSpace ↥(pullback h (Scheme.Opens.ι U)) :=
    (Scheme.Hom.homeomorph (pullback.fst h (Scheme.Opens.ι U))).symm.compactSpace
  have : IsAffine (U : Y.Opens) := hU
  have : QuasiCompact p := (HasAffineProperty.iff_of_isAffine (P := @QuasiCompact)).2 ‹_›
  have : Surjective p := ⟨fun u ↦ by
    obtain ⟨z, hz⟩ : (Scheme.Opens.ι U) u ∈ Set.range h := by simp [hrange]
    obtain ⟨w, -, hw⟩ := Scheme.Pullback.exists_preimage_pullback z u hz
    exact ⟨w, hw⟩⟩
  have hhS : IsOpen (h.base ⁻¹' S) := by
    have : h.base ⁻¹' S = ⋃ i, Sigma.ι (fun i : Fin n ↦ (V i).toScheme) i ''
        ((V i).ι.base ⁻¹' ((f (a i)).base ⁻¹' S)) := by
      ext z
      obtain ⟨i, x, rfl⟩ := hjs z
      simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
      rw [← Scheme.Hom.comp_apply, Sigma.ι_desc, Scheme.Hom.comp_apply]
      constructor
      · exact fun hx ↦ ⟨i, x, hx, rfl⟩
      · rintro ⟨j, y, hy, hyx⟩
        have := (sigmaι_eq_iff (fun i : Fin n ↦ (V i).toScheme) j i y x).1 hyx
        rw [Sigma.mk.injEq] at this
        obtain ⟨rfl, e⟩ := this
        obtain rfl := eq_of_heq e
        exact hy
    rw [this]
    exact isOpen_iUnion fun i ↦
      (Sigma.ι (fun i : Fin n ↦ (V i).toScheme) i).isOpenEmbedding.isOpenMap _
        ((hS _).preimage (V i).ι.continuous)
  have hT : IsOpen ((Scheme.Opens.ι U).base ⁻¹' S) := by
    rw [← (Flat.isQuotientMap_of_surjective p).isOpen_preimage, ← Set.preimage_comp,
      ← TopCat.coe_comp, ← Scheme.Hom.comp_base, ← pullback.condition, Scheme.Hom.comp_base,
      TopCat.coe_comp, Set.preimage_comp]
    exact hhS.preimage (pullback.fst h (Scheme.Opens.ι U)).continuous
  have := (Scheme.Opens.ι U).isOpenEmbedding.isOpenMap _ hT
  rwa [Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι] at this

end Quotient

namespace ProEt

variable (X : Scheme.{u})

/-! ### The pro-étale precoverage -/

instance : (precoverage X).HasIsos := by
  dsimp [precoverage]; infer_instance

instance : (precoverage X).IsStableUnderComposition := by
  dsimp [precoverage]; infer_instance

instance : (precoverage X).IsStableUnderBaseChange := by
  dsimp [precoverage]; infer_instance

/-- `X.ProEt` is locally `u + 1`-small. Stated directly so that instance search does not go
through the slow `HasCardinalFilteredGenerator` route before the low-priority
`locallySmall_of_univLE`. -/
instance locallySmall : LocallySmall.{u + 1} X.ProEt :=
  ⟨fun _ _ ↦ ⟨ULift.{u + 1} _, ⟨Equiv.ulift.symm⟩⟩⟩

variable {X}

/-- A presieve on `V : X.ProEt` is a pro-étale covering exactly when the family of
underlying morphisms of schemes is a pro-étale covering of `V.left`. -/
lemma mem_precoverage_iff {V : X.ProEt} {R : Presieve V} :
    R ∈ precoverage X V ↔
      R.map (ProEt.forget X ⋙ CategoryTheory.Over.forget X) ∈ proetalePrecoverage V.left :=
  Iff.rfl

/-- A sieve on `V : X.ProEt` is covering for the pro-étale topology exactly when it contains
a pro-étale covering presieve: the pro-étale precoverage has isomorphisms, pullbacks and is
stable under base change and composition, so no further saturation is needed. -/
lemma mem_topology_iff {V : X.ProEt} {S : Sieve V} :
    S ∈ topology X V ↔ ∃ R ∈ precoverage X V, R ≤ S.arrows :=
  Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition

variable (X) in
/-- The pro-étale topology on the small pro-étale site of `X` is the topology restricted from
the pro-étale topology on the category of schemes over `X` along the forgetful functor. -/
lemma topology_eq_restrictedTopology :
    topology X = (ProEt.forget X).restrictedTopology (proetaleTopology.over X) :=
  MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology _
    proetalePrecoverage_le_precoverage_weaklyEtale

/-! ### Base change -/

/-- Base change along an *arbitrary* morphism `g : W ⟶ U` preserves the covering sieves of
the pro-étale topologies: a covering presieve of `V` is carried to the family of base
changes, and each of the squares

```
  Z i ×_U W ──(Over.pullback @WeaklyEtale ⊤ g).map (f i)──→ V ×_U W
      │                                                        │
      │ pullback.fst (Z i).hom g                               │ pullback.fst V.hom g
      ↓                                                        ↓
    Z i ────────────────── (f i).left ────────────────────────→ V
```

is cartesian by `MorphismProperty.Over.isPullback_map_left`, so the conclusion is the
stability of `proetalePrecoverage` under base change. -/
lemma coverPreserving_overPullback {W U : Scheme.{u}} (g : W ⟶ U) :
    CoverPreserving (ProEt.topology U) (ProEt.topology W)
      (MorphismProperty.Over.pullback @WeaklyEtale ⊤ g) where
  cover_preserve {V S} hS := by
    rw [mem_topology_iff] at hS ⊢
    obtain ⟨R, hR, hle⟩ := hS
    obtain ⟨ι, Z, f, rfl⟩ := R.exists_eq_ofArrows
    refine ⟨Presieve.ofArrows
      (fun i ↦ (MorphismProperty.Over.pullback @WeaklyEtale ⊤ g).obj (Z i))
      (fun i ↦ (MorphismProperty.Over.pullback @WeaklyEtale ⊤ g).map (f i)), ?_, ?_⟩
    · rw [mem_precoverage_iff] at hR ⊢
      rw [Presieve.map_ofArrows] at hR ⊢
      exact Precoverage.mem_coverings_of_isPullback (fun i ↦ (f i).left) hR
        (pullback.fst V.hom g) _ (fun i ↦ pullback.fst (Z i).hom g)
        fun i ↦ (MorphismProperty.Over.isPullback_map_left g (f i)).flip
    · rintro T - ⟨i⟩
      exact ⟨Z i, f i, 𝟙 _, hle _ _ ⟨i⟩, (Category.id_comp _).symm⟩

/-- Base change along an *arbitrary* morphism `g : W ⟶ U` is continuous for the pro-étale
topologies: it preserves covers by `ProEt.coverPreserving_overPullback` and compatible
families since it is representably flat, the small pro-étale site being finitely complete. -/
instance isContinuous_overPullback {W U : Scheme.{u}} (g : W ⟶ U) :
    (MorphismProperty.Over.pullback @WeaklyEtale ⊤ g).IsContinuous
      (ProEt.topology U) (ProEt.topology W) :=
  Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat _ _) (coverPreserving_overPullback g)

/-! ### The localization functor -/

section OverMap

variable {V U : Scheme.{u}} {f : V ⟶ U} (h : WeaklyEtale f)

/-- A morphism of the small pro-étale site of `U` whose target lies in the image of the
localization functor of `h : WeaklyEtale f` is weakly étale over `V` as well: cancel `f` off
the structure morphism using `MorphismProperty.HasOfPostcompProperty @WeaklyEtale
@WeaklyEtale`. -/
lemma weaklyEtale_left_comp {W : V.ProEt} {Z : U.ProEt}
    (φ : Z ⟶ (MorphismProperty.Over.map ⊤ h).obj W) : WeaklyEtale (φ.left ≫ W.hom) := by
  refine MorphismProperty.of_postcomp (W := @WeaklyEtale) (W' := @WeaklyEtale)
    (φ.left ≫ W.hom) f h ?_
  rw [Category.assoc]
  exact (MorphismProperty.Over.w φ) ▸ Z.prop

set_option backward.isDefEq.respectTransparency.types false in
/-- The localization functor is cocontinuous for the pro-étale topologies: a covering of
`(Over.map ⊤ h).obj W` is, on underlying schemes, a covering of `W`, and the corresponding
morphisms of the small pro-étale site of `V` are carried back into the given sieve. -/
instance isCocontinuous_overMap :
    (MorphismProperty.Over.map ⊤ h).IsCocontinuous (ProEt.topology V) (ProEt.topology U) where
  cover_lift {W S} hS := by
    obtain ⟨R, hR, hle⟩ := mem_topology_iff.mp hS
    refine mem_topology_iff.mpr ?_
    obtain ⟨ι, Z, φ, rfl⟩ := R.exists_eq_ofArrows
    let Z' (i : ι) : V.ProEt :=
      MorphismProperty.Over.mk ⊤ ((φ i).left ≫ W.hom) (weaklyEtale_left_comp h (φ i))
    let φ' (i : ι) : Z' i ⟶ W := MorphismProperty.Over.homMk (φ i).left rfl
    refine ⟨Presieve.ofArrows Z' φ', ?_, ?_⟩
    · rw [mem_precoverage_iff] at hR ⊢
      rw [Presieve.map_ofArrows] at hR ⊢
      exact hR
    · rintro T - ⟨i⟩
      -- Compare the image of `φ' i` under the localization functor with `φ i` via the
      -- identity on `(Z i).left`.
      have hY : 𝟙 (Z i).left ≫ (Z i).hom = ((φ i).left ≫ W.hom) ≫ f := by
        simp only [Category.id_comp, Category.assoc]
        exact (MorphismProperty.Over.w (φ i)).symm
      let e : (MorphismProperty.Over.map ⊤ h).obj (Z' i) ⟶ Z i :=
        MorphismProperty.Over.homMk (𝟙 (Z i).left) hY
      have hge : (MorphismProperty.Over.map ⊤ h).map (φ' i) = e ≫ φ i := by
        apply MorphismProperty.Over.Hom.ext
        show (φ i).left = 𝟙 (Z i).left ≫ (φ i).left
        exact (Category.id_comp _).symm
      show S.arrows ((MorphismProperty.Over.map ⊤ h).map (φ' i))
      rw [hge]
      exact S.downward_closed (hle _ _ ⟨i⟩) e

set_option backward.isDefEq.respectTransparency.types false in
/-- The localization functor preserves covering sieves of the pro-étale topologies: it is
the identity on underlying schemes and morphisms, so a covering presieve is carried to a
presieve with the same image in `proetalePrecoverage`. -/
lemma coverPreserving_overMap :
    CoverPreserving (ProEt.topology V) (ProEt.topology U)
      (MorphismProperty.Over.map ⊤ h) where
  cover_preserve {W S} hS := by
    rw [mem_topology_iff] at hS ⊢
    obtain ⟨R, hR, hle⟩ := hS
    obtain ⟨ι, Z, φ, rfl⟩ := R.exists_eq_ofArrows
    refine ⟨Presieve.ofArrows (fun i ↦ (MorphismProperty.Over.map ⊤ h).obj (Z i))
      (fun i ↦ (MorphismProperty.Over.map ⊤ h).map (φ i)), ?_, ?_⟩
    · rw [mem_precoverage_iff] at hR ⊢
      rw [Presieve.map_ofArrows] at hR ⊢
      exact hR
    · rintro T - ⟨i⟩
      exact ⟨Z i, φ i, 𝟙 _, hle _ _ ⟨i⟩, (Category.id_comp _).symm⟩

set_option backward.isDefEq.respectTransparency.types false in
/-- The localization functor is continuous for the pro-étale topologies. Compatible
families are preserved by `MorphismProperty.Over.compatiblePreserving_map`, which holds for
an arbitrary topology on `@WeaklyEtale.Over ⊤ U`. -/
instance isContinuous_overMap :
    (MorphismProperty.Over.map ⊤ h).IsContinuous (ProEt.topology V) (ProEt.topology U) :=
  Functor.isContinuous_of_coverPreserving
    (MorphismProperty.Over.compatiblePreserving_map h _) (coverPreserving_overMap h)

end OverMap

/-! ### Covering by base changes -/

section BaseChange

variable {X W : Scheme.{u}} (g : W ⟶ X) [WeaklyEtale g] (V : X.ProEt)

/-- The base change `V ×_X W` of a weakly étale `X`-scheme `V` along a weakly étale
morphism `g : W ⟶ X`, viewed again as a weakly étale `X`-scheme.

```
   V ×_X W ────→ W
      │          │ g
      ↓          ↓
      V ──V.hom─→ X
```
-/
noncomputable def baseChange : X.ProEt :=
  ProEt.mk (pullback.fst V.hom g ≫ V.hom)

/-- The projection `V ×_X W ⟶ V`, a morphism of weakly étale `X`-schemes. -/
noncomputable def baseChangeHom : baseChange g V ⟶ V :=
  MorphismProperty.Over.homMk (pullback.fst V.hom g) rfl

end BaseChange

section Cover

variable {X : Scheme.{u}} (V : X.ProEt) {ι : Type*} {W : ι → Scheme.{u}} (g : ∀ i, W i ⟶ X)
  [∀ i, WeaklyEtale (g i)]

/-- For a pro-étale covering family `g i : W i ⟶ X`, the base changes `V ×_X W i` cover `V`
in the pro-étale topology, for every weakly étale `X`-scheme `V`: the family of projections
is the base change of `g` along `V.hom`, and `proetalePrecoverage` is stable under base
change. -/
lemma ofArrows_baseChange_mem_topology
    (hg : Presieve.ofArrows W g ∈ proetalePrecoverage X) :
    Sieve.ofArrows (fun i ↦ baseChange (g i) V) (fun i ↦ baseChangeHom (g i) V) ∈
      topology X V := by
  rw [mem_topology_iff]
  refine ⟨Presieve.ofArrows (fun i ↦ baseChange (g i) V) (fun i ↦ baseChangeHom (g i) V), ?_,
    Sieve.le_generate _⟩
  rw [mem_precoverage_iff, Presieve.map_ofArrows]
  exact Precoverage.mem_coverings_of_isPullback g hg V.hom _
    (fun i ↦ pullback.snd V.hom (g i)) fun i ↦ IsPullback.of_hasPullback V.hom (g i)

end Cover

/-! ### Sections over an empty object -/

section EmptyObject

variable {A : Type u'} [Category.{w} A] {X : Scheme.{u}}

/-- A sheaf on the small pro-étale site has terminal sections over an object whose
underlying scheme is empty. This is the sheaf condition for the empty covering, which is a
pro-étale covering by `AlgebraicGeometry.Scheme.ProEt.bot_mem_topology`. -/
noncomputable def isTerminalSectionsOfIsEmpty (G : Sheaf (ProEt.topology X) A) (T : X.ProEt)
    [IsEmpty T.left] : IsTerminal (G.obj.obj (op T)) :=
  G.isTerminalOfBotCover T (ProEt.bot_mem_topology T)

end EmptyObject

end ProEt

/-! ### The inclusion of the small étale site into the small pro-étale site -/

section ToProEt

variable (X : Scheme.{u})

/-- The inclusion `ν : X.Etale ⥤ X.ProEt` of the small étale site into the small pro-étale
site. -/
@[simps! obj_toComma map_hom]
def toProEt : X.Etale ⥤ X.ProEt :=
  MorphismProperty.Over.changeProp _ etale_le_weaklyEtale le_rfl

/-- The inclusion of the small étale site into the small pro-étale site is full. -/
instance full_toProEt : (toProEt X).Full :=
  (MorphismProperty.Comma.fullyFaithfulChangeProp _ _ etale_le_weaklyEtale).full

/-- The inclusion of the small étale site into the small pro-étale site is faithful. -/
instance faithful_toProEt : (toProEt X).Faithful :=
  (MorphismProperty.Comma.fullyFaithfulChangeProp _ _ etale_le_weaklyEtale).faithful

/-- The inclusion of the small étale site into the small pro-étale site preserves finite
limits. -/
instance preservesFiniteLimits_toProEt : PreservesFiniteLimits (toProEt X) :=
  MorphismProperty.Over.preservesFiniteLimits_changeProp X etale_le_weaklyEtale

/-- The inclusion of the small étale site into the small pro-étale site is representably
flat. -/
instance representablyFlat_toProEt : RepresentablyFlat (toProEt X) :=
  MorphismProperty.Over.representablyFlat_changeProp X etale_le_weaklyEtale

/-- The inclusion of the small étale site into the small pro-étale site is continuous for
the étale and pro-étale topologies. -/
instance isContinuous_toProEt :
    (toProEt X).IsContinuous (smallEtaleTopology X) (ProEt.topology X) := by
  -- it preserves compatible families since it is representably flat, and covers since every
  -- étale covering is a pro-étale covering
  refine Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) ?_
  rw [ProEt.topology_eq_restrictedTopology]
  exact MorphismProperty.Over.coverPreserving_changeProp X etale_le_weaklyEtale
    etaleTopology_le_proetaleTopology

/-- **The small étale site is subcanonical**: the representable presheaves `U ↦ Hom_X(U, V)` are
sheaves, as the small étale site embeds fully faithfully and continuously into the small
pro-étale site, which is subcanonical. -/
instance subcanonical_smallEtaleTopology : (smallEtaleTopology X).Subcanonical :=
  GrothendieckTopology.subcanonical_of_full_of_faithful (toProEt X) _ (ProEt.topology X)

end ToProEt

/-! ### Open immersions into objects of the pro-étale site -/

section OpenImmersion

namespace ProEt

variable {X : Scheme.{u}}

/-- An open immersion `j : Y ⟶ U.left` into an object `U` of the small pro-étale site of `X`,
as an object of the small pro-étale site. -/
noncomputable def ofOpenImmersion (U : X.ProEt) {Y : Scheme.{u}} (j : Y ⟶ U.left)
    [IsOpenImmersion j] : X.ProEt :=
  have := U.prop
  Scheme.ProEt.mk (j ≫ U.hom)

/-- An open immersion `j : Y ⟶ U.left`, as a morphism of the small pro-étale site. -/
noncomputable def ofOpenImmersionHom (U : X.ProEt) {Y : Scheme.{u}} (j : Y ⟶ U.left)
    [IsOpenImmersion j] : ofOpenImmersion U j ⟶ U :=
  MorphismProperty.Over.homMk j

/-- A sieve on `U : X.ProEt` containing a jointly surjective family of open immersions is
covering: the open immersions form a Zariski cover. -/
lemma mem_topology_of_openImmersion {U : X.ProEt} (S : Sieve U) {ι : Type u}
    {Y : ι → Scheme.{u}} (j : ∀ i, Y i ⟶ U.left) [∀ i, IsOpenImmersion (j i)]
    (hj : ∀ x, ∃ i, x ∈ Set.range (j i)) (hS : ∀ i, S (ofOpenImmersionHom U (j i))) :
    S ∈ topology X U := by
  rw [mem_topology_iff]
  refine ⟨.ofArrows _ fun i ↦ ofOpenImmersionHom U (j i), ?_, fun _ _ h ↦ ?_⟩
  · rw [mem_precoverage_iff, Presieve.map_ofArrows]
    exact zariskiPrecoverage_le_proetalePrecoverage _
      ((Scheme.ofArrows_mem_precoverage_iff _).mpr
        ⟨hj, fun i ↦ inferInstanceAs (IsOpenImmersion (j i))⟩)
  · obtain ⟨i⟩ := h
    exact hS i

end ProEt

end OpenImmersion

end AlgebraicGeometry.Scheme
