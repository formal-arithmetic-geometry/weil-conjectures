module

public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The kernel of evaluating multivariate polynomials at a point

- `MvPolynomial.ker_eval` — the kernel of the evaluation `R[Xᵢ] →+* R` at a point
  `c : σ → R` is the ideal generated by the linear polynomials `Xᵢ - C (c i)`.
-/

@[expose] public section

namespace MvPolynomial

variable {R : Type*} [CommRing R] {σ : Type*} (c : σ → R)

/-- Every multivariate polynomial is congruent to its value at `c` modulo the ideal
generated by the `Xᵢ - C (c i)`. -/
lemma sub_C_eval_mem_span (p : MvPolynomial σ R) :
    p - C (eval c p) ∈ Ideal.span (Set.range fun i ↦ X i - C (c i)) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp only [eval_C, sub_self]; exact zero_mem _
  | add p q hp hq =>
      have h : p + q - C (eval c (p + q)) = (p - C (eval c p)) + (q - C (eval c q)) := by
        rw [map_add, map_add]; ring
      rw [h]
      exact add_mem hp hq
  | mul_X p i hp =>
      have h : p * X i - C (eval c (p * X i)) =
          p * (X i - C (c i)) + (p - C (eval c p)) * C (c i) := by
        rw [map_mul, eval_X, map_mul]; ring
      rw [h]
      exact add_mem (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
        (Ideal.mul_mem_right _ _ hp)

/-- The kernel of the evaluation of multivariate polynomials at a point `c` is the ideal
generated by the linear polynomials `Xᵢ - C (c i)`. -/
lemma ker_eval : RingHom.ker (eval c) = Ideal.span (Set.range fun i ↦ X i - C (c i)) := by
  refine le_antisymm (fun p hp ↦ ?_) (Ideal.span_le.mpr ?_)
  · have h := sub_C_eval_mem_span c p
    rwa [RingHom.mem_ker.mp hp, map_zero, sub_zero] at h
  · rintro - ⟨i, rfl⟩
    simp [RingHom.mem_ker]

end MvPolynomial
