module

public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
public import WeilConjectures.Mathlib.RingTheory.GradedAlgebra.RingHom

/-!
# Homogeneous localization of a graded algebra, `HomogeneousLocalization.Away.map`, the
arithmetic of `HomogeneousLocalization.Away.mk`, and the degree-`m` parts of a localization

If `A` is an `R`-algebra graded by `R`-submodules `𝒜`, the degree-zero part
`HomogeneousLocalization 𝒜 x` of a localization of `A` is an `R`-algebra, via
`R → 𝒜 0 → HomogeneousLocalization 𝒜 x`.

We also show that `HomogeneousLocalization.Away.map` is compatible with the canonical ring
homomorphisms from the degree-zero subrings, and that it is surjective as soon as the
graded ring homomorphism it is built from is.

Finally, we develop the arithmetic of the fractions `HomogeneousLocalization.Away.mk 𝒜 hf n a ha`,
that is, of `a / f ^ n` in `Away 𝒜 f`: units, products, powers and cancellation, together with the
transition cocycle relating the two charts `Away 𝒜 f` and `Away 𝒜 g` inside `Away 𝒜 (f * g)`.

For an `ℕ`-graded ring we also build, for `m : ℤ`, the degree-`m` part of `Localization x` as a
module over the degree-`0` part `HomogeneousLocalization 𝒜 x`.

## Main definitions

- `HomogeneousLocalization.algebra` — the `R`-algebra structure on
  `HomogeneousLocalization 𝒜 x` for a graded `R`-algebra `𝒜`.
- `HomogeneousLocalization.degreePart 𝒜 x m` — the degree-`m` part of `Localization x`, the
  fractions `a / b` with `deg a = deg b + m`, as a `HomogeneousLocalization 𝒜 x`-submodule.
- `HomogeneousLocalization.degreePart.mk` — the fraction `a / b` as an element of it.
- `HomogeneousLocalization.degreePart.mulUnitEquiv` — multiplication by a unit of degree `m`
  whose inverse has degree `-m`, as an isomorphism from degree `n` onto degree `n + m`.
- `HomogeneousLocalization.degreePart.powDivPowEquiv` — for `f ∈ x ∩ 𝒜 d` and
  `d * (k - l) = m`, the isomorphism `HomogeneousLocalization 𝒜 x ≃ degreePart 𝒜 x m`,
  `p ↦ p • f ^ k / f ^ l`.

## Main results

- `HomogeneousLocalization.Away.map_surjective` — `Away.map` of a surjective graded ring
  homomorphism is surjective.
- `HomogeneousLocalization.Away.mk_one`, `HomogeneousLocalization.Away.mk_self` and
  `HomogeneousLocalization.Away.mk_pow_self` — the fractions `1 / f ^ 0`, `f / f` and
  `f ^ n / f ^ n` are the unit of `Away 𝒜 f`.
- `HomogeneousLocalization.Away.mk_mul` and `HomogeneousLocalization.Away.mk_pow` — products and
  powers of fractions.
- `HomogeneousLocalization.Away.mk_mul_pow_cancel` and
  `HomogeneousLocalization.Away.mk_eq_mk_of_mul_pow_eq` — cancelling a power of `f`, and the
  criterion for two fractions to be equal.
- `HomogeneousLocalization.awayMap_mk_one_eq_mul` — the transition cocycle: inside `Away 𝒜 (f * g)`
  the image of `x / g` is the image of `x / f` times the image of `f / g`.
- `HomogeneousLocalization.degreePart_zero` — the degree-`0` part is the image of
  `HomogeneousLocalization 𝒜 x`.
- `HomogeneousLocalization.mul_mem_degreePart` — degrees add under multiplication, so the degree
  parts form a `SetLike.GradedMonoid`.
- `HomogeneousLocalization.degreePart.toSpanSingleton_powDivPow_bijective` — if `x` contains
  `f ∈ 𝒜 d`, the degree-`m` part is free of rank one, generated by `f ^ k / f ^ l` for
  `d * (k - l) = m`.
-/

@[expose] public section

namespace HomogeneousLocalization

variable {ι R A : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommMonoid ι]
  [DecidableEq ι] {𝒜 : ι → Submodule R A} [GradedAlgebra 𝒜] (x : Submonoid A)

@[simp]
lemma val_fromZeroRingHom (a : 𝒜 0) :
    (fromZeroRingHom 𝒜 x a).val = Localization.mk (a : A) 1 :=
  rfl

/-- If `A` is a graded `R`-algebra, the degree-zero part of a localization of `A` is an
`R`-algebra, via `R → 𝒜 0 → HomogeneousLocalization 𝒜 x`. -/
instance algebra : Algebra R (HomogeneousLocalization 𝒜 x) :=
  { instSMul x with
    algebraMap := (fromZeroRingHom 𝒜 x).comp (algebraMap R (𝒜 0))
    commutes' := fun _ _ ↦ mul_comm _ _
    smul_def' := fun r z ↦ by
      obtain ⟨z, rfl⟩ := mk_surjective z
      ext
      simp only [← mk_smul, val_mk, RingHom.coe_comp, Function.comp_apply, val_mul,
        val_fromZeroRingHom, NumDenSameDeg.num_smul, NumDenSameDeg.den_smul,
        Localization.mk_mul, one_mul, Algebra.smul_def, SetLike.GradeZero.coe_algebraMap] }

instance : IsScalarTower R (𝒜 0) (HomogeneousLocalization 𝒜 x) :=
  .of_algebraMap_eq' rfl

@[simp]
lemma val_algebraMap (r : R) :
    (algebraMap R (HomogeneousLocalization 𝒜 x) r).val = Localization.mk (algebraMap R A r) 1 :=
  rfl

lemma val_sum {α : Type*} (t : Finset α) (f : α → HomogeneousLocalization 𝒜 x) :
    (∑ i ∈ t, f i).val = ∑ i ∈ t, (f i).val :=
  map_sum (algebraMap (HomogeneousLocalization 𝒜 x) (Localization x)) f t

end HomogeneousLocalization

namespace HomogeneousLocalization.Away

variable {ι A B σ τ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] [DecidableEq ι] [AddCommMonoid ι]
  {𝒜 : ι → σ} {ℬ : ι → τ} [GradedRing 𝒜] [GradedRing ℬ]

/-- `HomogeneousLocalization.Away.map` is compatible with the canonical ring homomorphisms
from the degree-zero subrings. -/
lemma map_comp_fromZeroRingHom (g : 𝒜 →+*ᵍ ℬ) (s : A) :
    (HomogeneousLocalization.Away.map g s).comp
        (fromZeroRingHom 𝒜 (Submonoid.powers s)) =
      (fromZeroRingHom ℬ (Submonoid.powers (g s))).comp g.gradeZeroRingHom := by
  ext a
  simp [fromZeroRingHom, HomogeneousLocalization.Away.map, HomogeneousLocalization.map_mk,
    HomogeneousLocalization.val_mk]

/-- If `g : 𝒜 →+*ᵍ ℬ` is surjective, so is the induced map `(A_s)₀ → (B_{g s})₀` on the
degree-zero parts of the localizations away from a homogeneous element `s`.

Every element of `(B_{g s})₀` is a fraction `b / (g s) ^ n` with `b` homogeneous of degree
`n • d`, and `b` lifts to a homogeneous element of `𝒜 (n • d)` by
`GradedRingHom.exists_mem_of_surjective`. -/
theorem map_surjective (g : 𝒜 →+*ᵍ ℬ) (hg : Function.Surjective g) {d : ι} {s : A}
    (hs : s ∈ 𝒜 d) : Function.Surjective (HomogeneousLocalization.Away.map g s) := by
  intro z
  obtain ⟨n, b, hb, rfl⟩ := Away.mk_surjective ℬ (g.map_mem hs) z
  obtain ⟨a, ha, rfl⟩ := GradedRingHom.exists_mem_of_surjective hg hb
  exact ⟨Away.mk 𝒜 hs n a ha, by rw [Away.map_mk]⟩

end HomogeneousLocalization.Away

namespace HomogeneousLocalization

section Away

variable {ι σ A : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [AddCommMonoid ι] [DecidableEq ι] (𝒜 : ι → σ) [GradedRing 𝒜] {d : ι} {f : A}

/-- Two fractions `a / f ^ n` and `b / f ^ m` in `Away 𝒜 f` agree as soon as
`a * f ^ m = b * f ^ n`. -/
lemma Away.mk_eq_mk_of_mul_pow_eq (hf : f ∈ 𝒜 d) {n m : ℕ} {a b : A} (ha : a ∈ 𝒜 (n • d))
    (hb : b ∈ 𝒜 (m • d)) (h : a * f ^ m = b * f ^ n) :
    Away.mk 𝒜 hf n a ha = Away.mk 𝒜 hf m b hb := by
  apply val_injective
  rw [Away.val_mk, Away.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simpa [mul_comm] using h⟩

/-- The fraction `f ^ n / f ^ n` is `1` in `Away 𝒜 f`. -/
@[simp]
lemma Away.mk_pow_self (hf : f ∈ 𝒜 d) (n : ℕ) (h : f ^ n ∈ 𝒜 (n • d)) :
    Away.mk 𝒜 hf n (f ^ n) h = 1 := by
  apply val_injective
  rw [Away.val_mk, val_one]
  exact Localization.mk_self (⟨f ^ n, n, rfl⟩ : Submonoid.powers f)

/-- The fraction `f / f` is `1` in `Away 𝒜 f`. -/
@[simp]
lemma Away.mk_self (hf : f ∈ 𝒜 d) (h : f ∈ 𝒜 (1 • d)) :
    Away.mk 𝒜 hf 1 f h = 1 := by
  simpa using Away.mk_pow_self 𝒜 hf 1 (by simpa using h)

/-- The fraction `1 / f ^ 0` is `1` in `Away 𝒜 f`. -/
@[simp]
lemma Away.mk_one (hf : f ∈ 𝒜 d) (h : (1 : A) ∈ 𝒜 (0 • d)) :
    Away.mk 𝒜 hf 0 1 h = 1 := by
  apply val_injective
  rw [Away.val_mk, val_one]
  simp

/-- Multiplying fractions in `Away 𝒜 f`: `(a / f ^ n) * (b / f ^ m) = (a * b) / f ^ (n + m)`. -/
lemma Away.mk_mul (hf : f ∈ 𝒜 d) (n m : ℕ) (a b : A) (ha : a ∈ 𝒜 (n • d)) (hb : b ∈ 𝒜 (m • d)) :
    Away.mk 𝒜 hf n a ha * Away.mk 𝒜 hf m b hb =
      Away.mk 𝒜 hf (n + m) (a * b) (add_smul n m d ▸ SetLike.mul_mem_graded ha hb) := by
  apply val_injective
  rw [val_mul, Away.val_mk, Away.val_mk, Away.val_mk, Localization.mk_mul]
  congr 1
  exact Subtype.ext (pow_add f n m).symm

/-- Powers of a fraction in `Away 𝒜 f`: `(a / f ^ n) ^ k = a ^ k / f ^ (k * n)`. -/
lemma Away.mk_pow (hf : f ∈ 𝒜 d) (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • d)) (k : ℕ) :
    (Away.mk 𝒜 hf n a ha) ^ k =
      Away.mk 𝒜 hf (k * n) (a ^ k) (mul_smul k n d ▸ SetLike.pow_mem_graded k ha) := by
  apply val_injective
  rw [val_pow, Away.val_mk, Away.val_mk, Localization.mk_pow]
  congr 1
  exact Subtype.ext (by rw [SubmonoidClass.coe_pow, ← pow_mul, mul_comm])

/-- A common factor `f ^ k` cancels in `Away 𝒜 f`:
`(a * f ^ k) / f ^ (n + k) = a / f ^ n`. -/
lemma Away.mk_mul_pow_cancel (hf : f ∈ 𝒜 d) (n k : ℕ) (a : A) (ha : a ∈ 𝒜 (n • d))
    (h : a * f ^ k ∈ 𝒜 ((n + k) • d)) :
    Away.mk 𝒜 hf (n + k) (a * f ^ k) h = Away.mk 𝒜 hf n a ha :=
  Away.mk_eq_mk_of_mul_pow_eq 𝒜 hf h ha (by ring)

end Away

section Cocycle

variable {ι σ A : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [AddCommMonoid ι] [DecidableEq ι] (𝒜 : ι → σ) [GradedRing 𝒜] {d : ι} {f g x : A}

/-- The transition cocycle relating the two away-charts `Away 𝒜 f` and `Away 𝒜 g` inside
`Away 𝒜 (f * g)`: the image of `x / g` is the image of `x / f` times the image of `f / g`.

Here `awayMap 𝒜 hg rfl : Away 𝒜 f →+* Away 𝒜 (f * g)` and
`awayMap 𝒜 hf (mul_comm f g) : Away 𝒜 g →+* Away 𝒜 (f * g)` are the two canonical maps into the
overlap. The statement is symmetric in `f` and `g`, so it applies to either chart.

Note that `f`, `g` and `x` are necessarily all of the same degree `d`: the fractions `x / f`,
`x / g` and `f / g` are homogeneous of degree zero only then. -/
lemma awayMap_mk_one_eq_mul (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 d) (hx : x ∈ 𝒜 (1 • d)) :
    awayMap 𝒜 hf (mul_comm f g) (Away.mk 𝒜 hg 1 x hx) =
      awayMap 𝒜 hg (rfl : f * g = f * g) (Away.mk 𝒜 hf 1 x hx) *
        awayMap 𝒜 hf (mul_comm f g) (Away.mk 𝒜 hg 1 f (by simpa using hf)) := by
  rw [awayMap_mk, awayMap_mk, awayMap_mk, Away.mk_mul]
  refine Away.mk_eq_mk_of_mul_pow_eq 𝒜 _ _ _ ?_
  ring

end Cocycle

end HomogeneousLocalization

namespace HomogeneousLocalization

section DegreePart

variable {σ A : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] (x : Submonoid A)

/-- `y` is a homogeneous fraction of degree `m` in `Localization x`: it is `a / b` with `a` of
degree `i`, `b ∈ x` of degree `j`, and `i = j + m`. -/
def IsFractionOfDegree (m : ℤ) (y : Localization x) : Prop :=
  ∃ (i j : ℕ) (a b : A) (hb : b ∈ x), a ∈ 𝒜 i ∧ b ∈ 𝒜 j ∧ (i : ℤ) = j + m ∧
    y = Localization.mk a ⟨b, hb⟩

variable {𝒜 x} in
lemma IsFractionOfDegree.mul {m n : ℤ} {y z : Localization x}
    (hy : IsFractionOfDegree 𝒜 x m y) (hz : IsFractionOfDegree 𝒜 x n z) :
    IsFractionOfDegree 𝒜 x (m + n) (y * z) := by
  obtain ⟨i, j, a, b, hb, ha, hb', hij, rfl⟩ := hy
  obtain ⟨i', j', a', b', hb₂, ha', hb₂', hij', rfl⟩ := hz
  exact ⟨i + i', j + j', a * a', b * b', mul_mem hb hb₂, SetLike.mul_mem_graded ha ha',
    SetLike.mul_mem_graded hb' hb₂', by omega, Localization.mk_mul _ _ _ _⟩

variable {𝒜 x} in
lemma IsFractionOfDegree.add {m : ℤ} {y z : Localization x}
    (hy : IsFractionOfDegree 𝒜 x m y) (hz : IsFractionOfDegree 𝒜 x m z) :
    IsFractionOfDegree 𝒜 x m (y + z) := by
  obtain ⟨i, j, a, b, hb, ha, hb', hij, rfl⟩ := hy
  obtain ⟨i', j', a', b', hb₂, ha', hb₂', hij', rfl⟩ := hz
  have h : j + i' = j' + i := by omega
  exact ⟨j + i', j + j', b * a' + b' * a, b * b', mul_mem hb hb₂,
    add_mem (SetLike.mul_mem_graded hb' ha') (h ▸ SetLike.mul_mem_graded hb₂' ha),
    SetLike.mul_mem_graded hb' hb₂', by omega, Localization.add_mk _ _ _ _⟩

omit [AddSubgroupClass σ A] [GradedRing 𝒜] in
variable {𝒜 x} in
/-- The value of an element of the homogeneous localization is a fraction of degree `0`. -/
lemma isFractionOfDegree_val (p : HomogeneousLocalization 𝒜 x) :
    IsFractionOfDegree 𝒜 x 0 p.val :=
  ⟨p.deg, p.deg, p.num, p.den, p.den_mem, p.num_mem_deg, p.den_mem_deg, by simp,
    p.eq_num_div_den⟩

/-- The degree-`m` part of the localization `Localization x` of a graded ring, for `m : ℤ`: the
fractions `a / b` with `a ∈ 𝒜 i`, `b ∈ x ∩ 𝒜 j` and `i = j + m` (together with `0`, which need
not be such a fraction when `m < 0` and `x` has no elements of degree `-m`).

It is a module over the degree-`0` part `HomogeneousLocalization 𝒜 x`, acting on
`Localization x` through `homogeneousLocalizationAlgebra`. For `m = 0` it is the image of
`HomogeneousLocalization.val` (`HomogeneousLocalization.degreePart_zero`), and the
twisting sheaves `𝒪(m)` on `Proj 𝒜` are built from `degreePart 𝒜 x m` at the points `x`.

We restrict to `ℕ`-graded rings, the case needed for `Proj`; the definition works verbatim for a
grading by an additive group `ι`, with `m : ι`. -/
def degreePart (m : ℤ) : Submodule (HomogeneousLocalization 𝒜 x) (Localization x) where
  carrier := {y | y = 0 ∨ IsFractionOfDegree 𝒜 x m y}
  zero_mem' := .inl rfl
  add_mem' := by
    rintro y z (rfl | hy) (rfl | hz)
    · exact .inl (add_zero 0)
    · exact .inr (by rwa [zero_add])
    · exact .inr (by rwa [add_zero])
    · exact .inr (hy.add hz)
  smul_mem' := by
    rintro p y (rfl | hy)
    · exact .inl (smul_zero p)
    · exact .inr (zero_add m ▸ (isFractionOfDegree_val p).mul hy)

variable {𝒜 x}

lemma mem_degreePart {m : ℤ} {y : Localization x} :
    y ∈ degreePart 𝒜 x m ↔ y = 0 ∨ IsFractionOfDegree 𝒜 x m y :=
  Iff.rfl

/-- Multiplication maps the degree-`m` part times the degree-`n` part into the
degree-`(m + n)` part. -/
lemma mul_mem_degreePart {m n : ℤ} {y z : Localization x} (hy : y ∈ degreePart 𝒜 x m)
    (hz : z ∈ degreePart 𝒜 x n) : y * z ∈ degreePart 𝒜 x (m + n) := by
  obtain rfl | hy := hy
  · exact .inl (zero_mul z)
  obtain rfl | hz := hz
  · exact .inl (mul_zero y)
  exact .inr (hy.mul hz)

lemma val_mem_degreePart_zero (p : HomogeneousLocalization 𝒜 x) : p.val ∈ degreePart 𝒜 x 0 :=
  .inr (isFractionOfDegree_val p)

lemma one_mem_degreePart : (1 : Localization x) ∈ degreePart 𝒜 x 0 := by
  simpa using val_mem_degreePart_zero (1 : HomogeneousLocalization 𝒜 x)

/-- The degree parts of `Localization x` form a `ℤ`-graded monoid. -/
instance : SetLike.GradedMonoid (degreePart 𝒜 x) where
  one_mem := one_mem_degreePart
  mul_mem _ _ _ _ := mul_mem_degreePart

/-- The fraction `a / b` as an element of the degree-`m` part, for `a ∈ 𝒜 i`, `b ∈ x ∩ 𝒜 j`
and `i = j + m`. -/
def degreePart.mk {m : ℤ} {i j : ℕ} (a : 𝒜 i) (b : 𝒜 j) (hb : (b : A) ∈ x)
    (h : (i : ℤ) = j + m) : degreePart 𝒜 x m :=
  ⟨Localization.mk a ⟨b, hb⟩, .inr ⟨i, j, a, b, hb, a.2, b.2, h, rfl⟩⟩

@[simp]
lemma degreePart.coe_mk {m : ℤ} {i j : ℕ} (a : 𝒜 i) (b : 𝒜 j) (hb : (b : A) ∈ x)
    (h : (i : ℤ) = j + m) :
    (degreePart.mk a b hb h : Localization x) = Localization.mk (a : A) ⟨b, hb⟩ :=
  rfl

/-- The degree-`0` part of `Localization x` is the image of `HomogeneousLocalization 𝒜 x`. -/
lemma degreePart_zero : degreePart 𝒜 x 0 = 1 := by
  ext y
  rw [Submodule.mem_one]
  refine ⟨?_, ?_⟩
  · rintro (rfl | ⟨i, j, a, b, hb, ha, hb', h, rfl⟩)
    · exact ⟨0, map_zero _⟩
    · obtain rfl : i = j := by omega
      exact ⟨mk ⟨i, ⟨a, ha⟩, ⟨b, hb'⟩, hb⟩, val_mk _⟩
  · rintro ⟨p, rfl⟩
    exact val_mem_degreePart_zero p

/-- The degree-`0` part of `Localization x` is `HomogeneousLocalization 𝒜 x` itself, as a module
over it. -/
noncomputable def degreePart.zeroEquiv :
    HomogeneousLocalization 𝒜 x ≃ₗ[HomogeneousLocalization 𝒜 x] degreePart 𝒜 x 0 :=
  (LinearEquiv.ofInjective (Algebra.linearMap (HomogeneousLocalization 𝒜 x) (Localization x))
    (val_injective x)).trans
    (LinearEquiv.ofEq _ _ (Submodule.one_eq_range.symm.trans degreePart_zero.symm))

@[simp]
lemma degreePart.coe_zeroEquiv_apply (p : HomogeneousLocalization 𝒜 x) :
    (degreePart.zeroEquiv p : Localization x) = p.val :=
  rfl

/-- Multiplication by a unit `u` of degree `m`, whose inverse `v` has degree `-m`, is an
isomorphism from the degree-`n` part onto the degree-`(n + m)` part. -/
def degreePart.mulUnitEquiv {m : ℤ} (u : degreePart 𝒜 x m) (v : degreePart 𝒜 x (-m))
    (huv : (u : Localization x) * v = 1) (n : ℤ) :
    degreePart 𝒜 x n ≃ₗ[HomogeneousLocalization 𝒜 x] degreePart 𝒜 x (n + m) where
  toFun y := ⟨y * u, mul_mem_degreePart y.2 u.2⟩
  invFun z := ⟨z * v, by simpa using mul_mem_degreePart z.2 v.2⟩
  map_add' y z := Subtype.ext (add_mul _ _ _)
  map_smul' p y := Subtype.ext (smul_mul_assoc _ _ _)
  left_inv y := Subtype.ext (by simp [mul_assoc, huv])
  right_inv z := Subtype.ext (by simp [mul_assoc, mul_comm (v : Localization x), huv])

@[simp]
lemma degreePart.coe_mulUnitEquiv_apply {m : ℤ} (u : degreePart 𝒜 x m)
    (v : degreePart 𝒜 x (-m)) (huv : (u : Localization x) * v = 1) {n : ℤ}
    (y : degreePart 𝒜 x n) :
    (degreePart.mulUnitEquiv u v huv n y : Localization x) = y * u :=
  rfl

section PowDivPow

variable {d : ℕ} {f : A} (hf : f ∈ 𝒜 d) (hfx : f ∈ x)

include hf in
/-- `f ^ n` has degree `n * d`. -/
lemma pow_mem_graded_mul (n : ℕ) : f ^ n ∈ 𝒜 (n * d) := by
  simpa using SetLike.pow_mem_graded n hf

include hf hfx

/-- The fraction `f ^ k / f ^ l`, of degree `d * (k - l)`, as an element of the degree-`m` part
of `Localization x`, for `f ∈ x ∩ 𝒜 d`. -/
def degreePart.powDivPow {m : ℤ} (k l : ℕ) (h : (d : ℤ) * (k - l) = m) : degreePart 𝒜 x m :=
  degreePart.mk (i := k * d) (j := l * d) ⟨f ^ k, pow_mem_graded_mul hf k⟩
    ⟨f ^ l, pow_mem_graded_mul hf l⟩ (pow_mem hfx l) (by
      push_cast
      linarith)

lemma degreePart.coe_powDivPow_mul_coe_powDivPow {m : ℤ} (k l : ℕ) (h : (d : ℤ) * (k - l) = m) :
    (degreePart.powDivPow hf hfx k l h : Localization x) *
      degreePart.powDivPow (m := -m) hf hfx l k (by linarith) = 1 := by
  simp only [degreePart.powDivPow, degreePart.coe_mk, Localization.mk_mul]
  rw [mul_comm (f ^ k)]
  exact Localization.mk_self (⟨f ^ l, pow_mem hfx l⟩ * ⟨f ^ k, pow_mem hfx k⟩)

/-- If `f ∈ x ∩ 𝒜 d`, then the degree-`m` part of `Localization x` is free of rank one over the
degree-`0` part `HomogeneousLocalization 𝒜 x`, generated by `f ^ k / f ^ l` for any `k l` with
`d * (k - l) = m`. -/
noncomputable def degreePart.powDivPowEquiv {m : ℤ} (k l : ℕ) (h : (d : ℤ) * (k - l) = m) :
    HomogeneousLocalization 𝒜 x ≃ₗ[HomogeneousLocalization 𝒜 x] degreePart 𝒜 x m :=
  degreePart.zeroEquiv.trans <|
    (degreePart.mulUnitEquiv (degreePart.powDivPow hf hfx k l h)
      (degreePart.powDivPow hf hfx l k (by linarith))
      (degreePart.coe_powDivPow_mul_coe_powDivPow hf hfx k l h) 0).trans
    (LinearEquiv.ofEq _ _ (by rw [zero_add]))

@[simp]
lemma degreePart.powDivPowEquiv_apply {m : ℤ} (k l : ℕ) (h : (d : ℤ) * (k - l) = m)
    (p : HomogeneousLocalization 𝒜 x) :
    degreePart.powDivPowEquiv hf hfx k l h p = p • degreePart.powDivPow hf hfx k l h := by
  ext
  simp [degreePart.powDivPowEquiv, Algebra.smul_def]

theorem degreePart.toSpanSingleton_powDivPow_bijective {m : ℤ} (k l : ℕ)
    (h : (d : ℤ) * (k - l) = m) :
    Function.Bijective (LinearMap.toSpanSingleton (HomogeneousLocalization 𝒜 x)
      (degreePart 𝒜 x m) (degreePart.powDivPow hf hfx k l h)) := by
  convert (degreePart.powDivPowEquiv hf hfx k l h).bijective using 1
  ext p : 1
  simp

end PowDivPow

end DegreePart

end HomogeneousLocalization

namespace HomogeneousLocalization

section ChartCocycle


variable {ι σ A : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [AddCommMonoid ι] [DecidableEq ι] (𝒜 : ι → σ) [GradedRing 𝒜]

/-- The canonical isomorphism `Away 𝒜 x ≃+* Away 𝒜 y` for `x = y`. -/
def Away.congr {x y : A} (h : x = y) : Away 𝒜 x ≃+* Away 𝒜 y := by
  subst h
  exact RingEquiv.refl _

@[simp]
lemma Away.congr_rfl {x : A} : Away.congr 𝒜 (rfl : x = x) = RingEquiv.refl _ :=
  rfl

@[simp]
lemma Away.congr_symm {x y : A} (h : x = y) :
    (Away.congr 𝒜 h).symm = Away.congr 𝒜 h.symm := by
  subst h
  rfl

@[simp]
lemma Away.congr_trans {x y z : A} (h : x = y) (h' : y = z) :
    (Away.congr 𝒜 h).trans (Away.congr 𝒜 h') = Away.congr 𝒜 (h.trans h') := by
  subst h h'
  rfl

lemma Away.congr_mk {d : ι} {x y : A} (h : x = y) (hx : x ∈ 𝒜 d) (n : ℕ) (a : A)
    (ha : a ∈ 𝒜 (n • d)) :
    Away.congr 𝒜 h (Away.mk 𝒜 hx n a ha) = Away.mk 𝒜 (h ▸ hx) n a ha := by
  subst h
  rfl

/-- `Away.congr` is compatible with the restriction maps `awayMap`. -/
lemma Away.congr_awayMap {e : ι} {f g x y : A} (hg : g ∈ 𝒜 e) (hx : x = f * g) (h : x = y)
    (a : Away 𝒜 f) :
    Away.congr 𝒜 h (awayMap 𝒜 hg hx a) = awayMap 𝒜 hg (h.symm.trans hx) a := by
  subst h
  rfl

/-- `Away.congr` is compatible with the restriction maps `awayMap` out of the overlap ring. -/
lemma Away.awayMap_congr {e : ι} {g x y z : A} (hg : g ∈ 𝒜 e) (h : x = y) (hz : z = y * g)
    (a : Away 𝒜 x) :
    awayMap 𝒜 hg hz (Away.congr 𝒜 h a) = awayMap 𝒜 hg (hz.trans (h ▸ rfl)) a := by
  subst h
  rfl

/-- **Restriction maps between chart rings compose**: restricting a section of the chart
`D₊(f)` first to `D₊(fg)` and then to `D₊(fgh)` is the same as restricting it directly to
`D₊(f(gh))`. Both sides are the same map into the localization at `fgh`. -/
lemma awayMap_awayMap {d e e' : ι} {f g h x y : A} (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 e)
    (hh : h ∈ 𝒜 e') (hx : x = f * g) (hy : y = x * h) (a : Away 𝒜 f) :
    awayMap 𝒜 hh hy (awayMap 𝒜 hg hx a) =
      awayMap 𝒜 (SetLike.mul_mem_graded hg hh) (by rw [hy, hx, mul_assoc]) a := by
  obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hf a
  simp only [awayMap_mk]
  apply val_injective
  simp only [Away.val_mk]
  congr 1
  rw [mul_pow, mul_assoc]

/-- The canonical identification of the overlap rings of the charts `D₊(f)` and `D₊(g)`
computed from either side: `Away 𝒜 (f * g) ≃+* Away 𝒜 (g * f)`.
(blueprint: `lemma-nagata-proj-chart-ring-cocycle`) -/
def Away.overlapEquiv (f g : A) : Away 𝒜 (f * g) ≃+* Away 𝒜 (g * f) :=
  Away.congr 𝒜 (mul_comm f g)

/-- The overlap equivalence identifies the two restrictions of the chart ring at `f`.
(blueprint: `lemma-nagata-proj-chart-ring-cocycle`) -/
lemma Away.overlapEquiv_awayMap_left {e : ι} {f g : A} (hg : g ∈ 𝒜 e) (a : Away 𝒜 f) :
    Away.overlapEquiv 𝒜 f g (awayMap 𝒜 hg rfl a) = awayMap 𝒜 hg (mul_comm g f) a :=
  Away.congr_awayMap 𝒜 hg rfl _ a

/-- The overlap equivalence identifies the two restrictions of the chart ring at `g`.
(blueprint: `lemma-nagata-proj-chart-ring-cocycle`) -/
lemma Away.overlapEquiv_awayMap_right {d : ι} {f g : A} (hf : f ∈ 𝒜 d) (a : Away 𝒜 g) :
    Away.overlapEquiv 𝒜 f g (awayMap 𝒜 hf (mul_comm f g) a) = awayMap 𝒜 hf rfl a :=
  Away.congr_awayMap 𝒜 hf _ _ a

/-- The overlap equivalence of a chart with itself is the identity.
(blueprint: `lemma-nagata-proj-chart-ring-cocycle`) -/
@[simp]
lemma Away.overlapEquiv_self (f : A) : Away.overlapEquiv 𝒜 f f = RingEquiv.refl _ :=
  Away.congr_rfl 𝒜

/-- The overlap equivalences are inverse under exchanging `f` and `g`.
(blueprint: `lemma-nagata-proj-chart-ring-cocycle`) -/
@[simp]
lemma Away.overlapEquiv_symm (f g : A) :
    (Away.overlapEquiv 𝒜 f g).symm = Away.overlapEquiv 𝒜 g f :=
  Away.congr_symm 𝒜 _

/-- Restricting along the overlap equivalence does not change the restriction map into a
further overlap ring. -/
lemma Away.awayMap_overlapEquiv {e : ι} {f g h z : A} (hh : h ∈ 𝒜 e) (hz : z = f * g * h)
    (hz' : z = g * f * h) (a : Away 𝒜 (f * g)) :
    awayMap 𝒜 hh hz' (Away.overlapEquiv 𝒜 f g a) = awayMap 𝒜 hh hz a :=
  Away.awayMap_congr 𝒜 hh (mul_comm f g) hz' a

/-- **Cocycle condition for the chart rings of `Proj`**: on the triple overlap
`D₊(fgh)`, i.e. after composing with the restriction maps into `Away 𝒜 z` for `z = fgh`,
each of the overlap equivalences `φ_{fg}`, `φ_{gh}`, `φ_{fh}` becomes the identity. Hence
`φ_{gh} ∘ φ_{fg} = φ_{fh}` on the triple overlap.
(blueprint: `lemma-nagata-proj-chart-ring-cocycle`) -/
theorem Away.overlapEquiv_cocycle {d e e' : ι} {f g h z : A} (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 e)
    (hh : h ∈ 𝒜 e') (hz : z = f * g * h) :
    (awayMap 𝒜 hh (hz.trans (by ring) : z = g * f * h)).comp
        (Away.overlapEquiv 𝒜 f g).toRingHom = awayMap 𝒜 hh hz ∧
      (awayMap 𝒜 hf (hz.trans (by ring) : z = h * g * f)).comp
        (Away.overlapEquiv 𝒜 g h).toRingHom =
          awayMap 𝒜 hf (hz.trans (by ring) : z = g * h * f) ∧
      (awayMap 𝒜 hg (hz.trans (by ring) : z = h * f * g)).comp
        (Away.overlapEquiv 𝒜 f h).toRingHom =
          awayMap 𝒜 hg (hz.trans (by ring) : z = f * h * g) := by
  refine ⟨RingHom.ext fun a ↦ ?_, RingHom.ext fun a ↦ ?_, RingHom.ext fun a ↦ ?_⟩ <;>
  exact Away.awayMap_overlapEquiv 𝒜 _ (hz.trans (by ring)) (hz.trans (by ring)) a

end ChartCocycle

end HomogeneousLocalization
