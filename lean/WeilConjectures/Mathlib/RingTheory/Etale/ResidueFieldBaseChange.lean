module

public import Mathlib.RingTheory.LocalRing.ResidueField.Fiber
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Residue fields in a base change with trivial residue field extension

Let `R → R'` be a ring map and `p' ⊆ R'` a prime lying over `p ⊆ R` such that the induced map
`κ(p) → κ(p')` is an isomorphism. Then for every `R`-algebra `S` and every prime `q'` of
`R' ⊗[R] S` lying over `p'` and over `q ⊆ S`, the induced map `κ(q) → κ(q')` is an isomorphism.

Indeed, `κ(q')` is the fraction field of the image of `R' ⊗[R] S`, which is generated by the
images of `R'` and `S`; the image of `R'` is contained in the image of `κ(p') = κ(p)`, which is
contained in the image of `κ(q)`.
-/

@[expose] public section

open TensorProduct

namespace Ideal.ResidueField

variable {R R' S : Type*} [CommRing R] [CommRing R'] [CommRing S] [Algebra R R'] [Algebra R S]

/-- The residue field map `κ(q) → κ(q')` is bijective if `q'` is a prime of `R' ⊗[R] S` lying
over `q ⊆ S` and over a prime `p' ⊆ R'` whose residue field agrees with the one of the prime
`p ⊆ R` below it. -/
theorem bijective_map_includeRight
    (p : Ideal R) (p' : Ideal R') [p.IsPrime] [p'.IsPrime] (hp : p = p'.comap (algebraMap R R'))
    (H : Function.Bijective (Ideal.ResidueField.map p p' (algebraMap R R') hp))
    (q : Ideal S) [q.IsPrime] (q' : Ideal (R' ⊗[R] S)) [q'.IsPrime]
    (hq : q = q'.comap Algebra.TensorProduct.includeRight.toRingHom)
    (hq' : p' = q'.comap Algebra.TensorProduct.includeLeftRingHom) :
    Function.Bijective
      (Ideal.ResidueField.map q q' Algebra.TensorProduct.includeRight.toRingHom hq) := by
  set φ := Ideal.ResidueField.map q q' Algebra.TensorProduct.includeRight.toRingHom hq
  refine ⟨φ.injective, fun x ↦ ?_⟩
  have hpq : p = q.comap (algebraMap R S) := by
    rw [hq, hp, hq', Ideal.comap_comap, Ideal.comap_comap]
    congr 1
    ext r
    simp [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.algebraMap_apply]
  -- The two composites `κ(p) → κ(q')` agree.
  have hcomp : (Ideal.ResidueField.map p' q' Algebra.TensorProduct.includeLeftRingHom hq').comp
      (Ideal.ResidueField.map p p' (algebraMap R R') hp) =
      φ.comp (Ideal.ResidueField.map p q (algebraMap R S) hpq) := by
    ext r
    simp only [RingHom.comp_apply, Ideal.ResidueField.map_algebraMap, φ]
    congr 1
    simp [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.algebraMap_apply]
  -- The image of `R' ⊗[R] S` lies in the range of `φ`.
  have hmem : ∀ z : R' ⊗[R] S, algebraMap (R' ⊗[R] S) q'.ResidueField z ∈ φ.fieldRange := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simpa [map_add] using add_mem hx hy
    | tmul r' s =>
      have : r' ⊗ₜ[R] s = Algebra.TensorProduct.includeLeftRingHom r' *
          Algebra.TensorProduct.includeRight.toRingHom s := by simp
      rw [this, map_mul]
      refine mul_mem ?_ ?_
      · obtain ⟨y, hy⟩ := H.2 (algebraMap R' p'.ResidueField r')
        have : algebraMap (R' ⊗[R] S) q'.ResidueField (Algebra.TensorProduct.includeLeftRingHom r')
            = φ (Ideal.ResidueField.map p q (algebraMap R S) hpq y) := by
          rw [← RingHom.comp_apply φ, ← hcomp, RingHom.comp_apply, hy,
            Ideal.ResidueField.map_algebraMap]
        rw [this]
        exact ⟨_, rfl⟩
      · rw [← Ideal.ResidueField.map_algebraMap q q' _ hq]
        exact ⟨_, rfl⟩
  -- Every element of `κ(q')` is a fraction of elements in the image of `R' ⊗[R] S`.
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors ((R' ⊗[R] S) ⧸ q')) x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨s', hs'⟩ := Ideal.Quotient.mk_surjective s.1
  have key : ∀ b : R' ⊗[R] S,
      algebraMap ((R' ⊗[R] S) ⧸ q') q'.ResidueField (Ideal.Quotient.mk q' b) ∈ φ.fieldRange := by
    intro b
    rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
    exact hmem b
  change IsLocalization.mk' q'.ResidueField (Ideal.Quotient.mk q' a) s ∈ φ.fieldRange
  rw [IsFractionRing.mk'_eq_div]
  refine div_mem (key a) ?_
  rw [← hs']
  exact key s'

end Ideal.ResidueField
