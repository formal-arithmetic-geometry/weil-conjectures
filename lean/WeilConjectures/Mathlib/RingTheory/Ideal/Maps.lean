module

public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Finitely generated extensions of ideals

Since `Ideal.map φ N` is the span of `φ '' N`, finite generation of `Ideal.map φ N` is
witnessed by finitely many elements of `N` itself. Applied to a finite family of ring
homomorphisms simultaneously, this is the algebraic core of the finite-type extension
theorem for quasi-coherent ideal sheaves (Stacks Project Tag 01PF).

## Main results

- `Ideal.exists_finset_subset_span_image_eq`: a finitely generated `Ideal.map φ N` is
  generated by the image of a finite subset of `N`;
- `Ideal.eq_span_sup_ker_of_map_eq_span`: if `f` is surjective and `ker f ≤ I`, then `I` is
  spanned by `ker f` and any set whose image spans `I.map f`.
- `Ideal.exists_fg_le_map_eq`: if `N.map (φ i)` is finitely generated for each member of a
  finite family of ring homomorphisms, a single finitely generated subideal `N' ≤ N`
  realizes all of these extensions simultaneously.
-/

@[expose] public section

namespace Ideal

variable {R : Type*} [CommSemiring R]

/-- The generators of a finitely generated extension `N.map φ` can be taken to be images of
elements of `N`: the extension is the span of the image of a finite subset of `N`. -/
theorem exists_finset_subset_span_image_eq {S : Type*} [CommSemiring S] (N : Ideal R)
    (φ : R →+* S) (H : (N.map φ).FG) :
    ∃ T : Finset R, (T : Set R) ⊆ (N : Set R) ∧ Ideal.span (φ '' T) = N.map φ := by
  classical
  obtain ⟨G, hG⟩ := H
  have hspan : Ideal.span (φ '' (N : Set R)) = N.map φ := by
    rw [← Ideal.map_span, Ideal.span_eq]
  -- Each of the finitely many generators of `N.map φ` lies in the span of finitely many
  -- elements of `φ '' N`; picking preimages of those gives the finite subset of `N`.
  have hmem : ∀ y ∈ G, y ∈ Ideal.span (φ '' (N : Set R)) := by
    intro y hy
    rw [hspan, ← hG]
    exact Ideal.subset_span hy
  choose T hTsub hTmem using fun y : G ↦ Submodule.mem_span_finite_of_mem_span (hmem y y.2)
  choose pre hpreN hpre using
    fun (y : G) (z : {z // z ∈ T y}) ↦ hTsub y (Finset.mem_coe.mpr z.2)
  refine ⟨G.attach.biUnion fun y ↦ (T y).attach.image (pre y), fun x hx ↦ ?_,
    le_antisymm ?_ ?_⟩
  · obtain ⟨y, -, hy⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.mp hy
    exact hpreN y z
  · rw [Ideal.span_le]
    rintro w ⟨x, hx, rfl⟩
    obtain ⟨y, -, hy⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.mp hy
    exact Ideal.mem_map_of_mem _ (hpreN y z)
  · rw [← hG, Ideal.span_le]
    intro y hy
    have hsub : (T ⟨y, hy⟩ : Set S) ⊆
        φ '' (G.attach.biUnion fun y ↦ (T y).attach.image (pre y)) := by
      intro z hz
      refine ⟨pre ⟨y, hy⟩ ⟨z, Finset.mem_coe.mp hz⟩, ?_, hpre _ _⟩
      rw [Finset.mem_coe, Finset.mem_biUnion]
      exact ⟨⟨y, hy⟩, Finset.mem_attach _ _,
        Finset.mem_image.mpr ⟨_, Finset.mem_attach _ _, rfl⟩⟩
    exact Ideal.span_mono hsub (hTmem ⟨y, hy⟩)

/-- Clearing denominators: if the extensions of an ideal `N` along a finite family of
ring homomorphisms are all finitely generated, then a single finitely generated subideal
`N' ≤ N` realizes all of them (Stacks Project Tag 01PF, affine core). -/
theorem exists_fg_le_map_eq {ι : Type*} (N : Ideal R) (s : Finset ι) (S : ι → Type*)
    [∀ i, CommSemiring (S i)] (φ : ∀ i, R →+* S i) (H : ∀ i ∈ s, (N.map (φ i)).FG) :
    ∃ N' : Ideal R, N' ≤ N ∧ N'.FG ∧ ∀ i ∈ s, N'.map (φ i) = N.map (φ i) := by
  classical
  choose T hTsub hTspan using
    fun i : s ↦ N.exists_finset_subset_span_image_eq (φ i) (H i i.2)
  have hle : ((s.attach.biUnion T : Finset R) : Set R) ⊆ (N : Set R) := by
    intro x hx
    obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    exact hTsub i (Finset.mem_coe.mpr hi)
  refine ⟨Ideal.span (s.attach.biUnion T : Finset R), Ideal.span_le.mpr hle, ⟨_, rfl⟩,
    fun i hi ↦ le_antisymm (Ideal.map_mono (Ideal.span_le.mpr hle)) ?_⟩
  rw [← hTspan ⟨i, hi⟩]
  refine Ideal.span_le.mpr ?_
  rintro z ⟨x, hx, rfl⟩
  refine Ideal.mem_map_of_mem _ (Ideal.subset_span ?_)
  rw [Finset.mem_coe, Finset.mem_biUnion]
  exact ⟨⟨i, hi⟩, Finset.mem_attach _ _, Finset.mem_coe.mp hx⟩

/-- Let `f : R →+* S` be surjective and `I` an ideal of `R` containing `ker f`. If `I.map f` is
spanned by the image of `s`, then `I` is spanned by `s` together with `ker f`. -/
theorem eq_span_sup_ker_of_map_eq_span {R S : Type*} [Ring R] [Ring S] {f : R →+* S}
    (hf : Function.Surjective f) {I : Ideal R} (hI : RingHom.ker f ≤ I) {s : Set R}
    (h : I.map f = span (f '' s)) : I = span s ⊔ RingHom.ker f := by
  rw [← comap_map_of_surjective' f hf (span s), map_span, ← h, comap_map_of_surjective' f hf,
    sup_eq_left.2 hI]

end Ideal
