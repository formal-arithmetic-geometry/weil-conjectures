/-!
# Ideals generated by a single non-zerodivisor

An ideal is *regular principal* if it is generated by a single non-zerodivisor. This is the
affine-local shape of an invertible ideal sheaf, and unlike plain principality it is stable
under the ring isomorphisms produced by changing an affine chart.

## Main definitions

- `Ideal.IsRegularPrincipal`

## Main results

- `Ideal.IsRegularPrincipal.map_of_bijective`
- `Ideal.IsRegularPrincipal.of_comap_of_bijective`
- `Ideal.IsRegularPrincipal.map_of_flat`
- `Ideal.exists_away_regularPrincipal_of_isDiscreteValuationRing`,
  `Ideal.isRegularPrincipal_map_away`: a prime whose localization is a discrete valuation ring
  becomes regular principal after inverting a single element outside it.
- `Ideal.exists_notMem_isRegularPrincipal_map_away`: over a noetherian ring, an ideal which is
  generated by a nonzero element in a local ring that is a domain is regular principal after
  inverting a single element.
-/

@[expose] public section

namespace Ideal

variable {R S : Type*} [CommRing R] [CommRing S]

/-- An ideal is *regular principal* if it is generated by a single non-zerodivisor. -/
def IsRegularPrincipal (J : Ideal R) : Prop :=
  ∃ s ∈ nonZeroDivisors R, J = Ideal.span {s}

lemma isRegularPrincipal_span_singleton {s : R} (hs : s ∈ nonZeroDivisors R) :
    (Ideal.span {s} : Ideal R).IsRegularPrincipal :=
  ⟨s, hs, rfl⟩

lemma isRegularPrincipal_span_singleton_of_isRegular {s : R} (hs : IsRegular s) :
    (Ideal.span {s} : Ideal R).IsRegularPrincipal :=
  isRegularPrincipal_span_singleton (isRegular_iff_mem_nonZeroDivisors.mp hs)

/-- Regular principality is preserved by a ring isomorphism. -/
lemma IsRegularPrincipal.map_of_bijective {J : Ideal R} (hJ : J.IsRegularPrincipal)
    {f : R →+* S} (hf : Function.Bijective f) : (J.map f).IsRegularPrincipal := by
  obtain ⟨s, hs, rfl⟩ := hJ
  refine ⟨f s, ?_, by rw [Ideal.map_span, Set.image_singleton]⟩
  have key : ∀ x : S, x * f s = 0 → x = 0 := by
    intro x hx
    obtain ⟨y, rfl⟩ := hf.2 x
    have hy : y * s = 0 := hf.1 (by rw [map_mul, hx, map_zero])
    rw [(mem_nonZeroDivisors_iff.mp hs).2 y hy, map_zero]
  exact mem_nonZeroDivisors_iff.mpr ⟨fun x hx ↦ key x (by rwa [mul_comm]), key⟩

/-- Regular principality descends along a ring isomorphism. -/
lemma IsRegularPrincipal.of_comap_of_bijective {J : Ideal S} {f : R →+* S}
    (hf : Function.Bijective f) (hJ : (J.comap f).IsRegularPrincipal) :
    J.IsRegularPrincipal := by
  rw [← Ideal.map_comap_of_surjective f hf.2 J]
  exact hJ.map_of_bijective hf

/-- Regular principality is preserved by pulling back along a ring isomorphism. -/
lemma IsRegularPrincipal.comap_of_bijective {J : Ideal S} (hJ : J.IsRegularPrincipal)
    {f : R →+* S} (hf : Function.Bijective f) : (J.comap f).IsRegularPrincipal := by
  refine of_comap_of_bijective (f := ((RingEquiv.ofBijective f hf).symm : S →+* R))
    (RingEquiv.bijective _) ?_
  rwa [Ideal.comap_comap,
    show f.comp ((RingEquiv.ofBijective f hf).symm : S →+* R) = RingHom.id S from
      RingHom.ext fun x ↦ (RingEquiv.ofBijective f hf).apply_symm_apply x,
    Ideal.comap_id]

/-- The image of a non-zerodivisor under a flat ring homomorphism is a non-zerodivisor:
multiplication by it is scalar multiplication on a flat module. -/
lemma _root_.RingHom.Flat.map_mem_nonZeroDivisors {f : R →+* S} (hf : f.Flat) {s : R}
    (hs : s ∈ nonZeroDivisors R) : f s ∈ nonZeroDivisors S := by
  let := f.toAlgebra
  have : Module.Flat R S := hf
  have hreg : IsSMulRegular S s := Module.Flat.isSMulRegular_of_nonZeroDivisors hs
  have key : ∀ x : S, f s * x = 0 → x = 0 := fun x hx ↦
    hreg (by simpa [Algebra.smul_def, RingHom.algebraMap_toAlgebra] using hx)
  exact mem_nonZeroDivisors_iff.mpr ⟨key, fun x hx ↦ key x (by rwa [mul_comm])⟩

/-- **Regular principality is stable under flat base change.** Extending an ideal generated by
a non-zerodivisor along a flat ring homomorphism again gives such an ideal: the generator
stays a non-zerodivisor because a flat module is torsion-free. -/
lemma IsRegularPrincipal.map_of_flat {J : Ideal R} (hJ : J.IsRegularPrincipal) {f : R →+* S}
    (hf : f.Flat) : (J.map f).IsRegularPrincipal := by
  obtain ⟨s, hs, rfl⟩ := hJ
  exact ⟨f s, hf.map_mem_nonZeroDivisors hs, by rw [Ideal.map_span, Set.image_singleton]⟩

/-- If the localization of a noetherian ring `A` at a prime `q` is a discrete valuation ring,
then after inverting some `g ∉ q` the prime `q` is generated by a non-zerodivisor `π`. -/
lemma exists_away_regularPrincipal_of_isDiscreteValuationRing {A : Type*} [CommRing A]
    [IsNoetherianRing A] (q : Ideal A) [q.IsPrime] (Aq : Type*) [CommRing Aq] [Algebra A Aq]
    [IsLocalization.AtPrime Aq q] [IsDomain Aq] [IsDiscreteValuationRing Aq] :
    ∃ g ∉ q, ∃ π ∈ q, (∀ a ∈ q, g * a ∈ Ideal.span {π}) ∧ (∀ b, π * b = 0 → g * b = 0) := by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible Aq
  obtain ⟨π, s, hπs⟩ := IsLocalization.exists_mk'_eq q.primeCompl ϖ
  have hmax : IsLocalRing.maximalIdeal Aq = Ideal.span {algebraMap A Aq π} := by
    rw [hϖ.maximalIdeal_eq, ← hπs, IsLocalization.mk'_eq_mul_mk'_one,
      Ideal.span_singleton_mul_right_unit (IsUnit.of_mul_eq_one (algebraMap A Aq s)
        (by rw [IsLocalization.mk'_spec, map_one]))]
  have hπq : π ∈ q := by
    rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff Aq q, hmax]
    exact Ideal.subset_span rfl
  have hπ0 : algebraMap A Aq π ≠ 0 := by
    intro h
    rw [h, Ideal.span_singleton_eq_bot.mpr rfl] at hmax
    exact IsDiscreteValuationRing.not_a_field Aq hmax
  obtain ⟨S, hS⟩ := (IsNoetherian.noetherian q : q.FG)
  have h1 : ∀ a ∈ S, ∃ u ∉ q, u * a ∈ Ideal.span {π} := fun a ha => by
    have : algebraMap A Aq a ∈ (Ideal.span {π}).map (algebraMap A Aq) := by
      rw [Ideal.map_span, Set.image_singleton, ← hmax,
        IsLocalization.AtPrime.to_map_mem_maximal_iff Aq q]
      exact hS ▸ Ideal.subset_span ha
    obtain ⟨u, hu, h⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff q.primeCompl Aq _ _).1 this
    exact ⟨u, hu, h⟩
  choose! u hu hu' using h1
  obtain ⟨T, hT⟩ :=
    (IsNoetherian.noetherian (RingHom.ker (algebraMap A Aq)) : (RingHom.ker _).FG)
  have h2 : ∀ t ∈ T, ∃ v ∉ q, v * t = 0 := fun t ht => by
    have : algebraMap A Aq t = 0 := (hT ▸ Ideal.subset_span ht : t ∈ RingHom.ker _)
    obtain ⟨⟨v, hv⟩, h⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl Aq t).1 this
    exact ⟨v, hv, h⟩
  choose! v hv hv' using h2
  refine ⟨(∏ a ∈ S, u a) * ∏ t ∈ T, v t, ?_, π, hπq, ?_, ?_⟩
  · exact q.primeCompl.mul_mem (q.primeCompl.prod_mem fun a ha => hu a ha)
      (q.primeCompl.prod_mem fun t ht => hv t ht)
  · intro a ha
    rw [← hS] at ha
    refine Ideal.mul_mem_of_mem_span_of_forall _ _ _ (fun a ha => ?_) ha
    obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem u ha
    rw [hc]
    convert Ideal.mul_mem_right (c * ∏ t ∈ T, v t) _ (hu' a ha) using 1
    ring
  · intro b hb
    have hb' : algebraMap A Aq b = 0 := by
      have := congrArg (algebraMap A Aq) hb
      rw [map_mul, map_zero] at this
      exact (mul_eq_zero.1 this).resolve_left hπ0
    have hbk : b ∈ Ideal.span (T : Set A) := by
      change b ∈ Submodule.span A (T : Set A); rw [hT]; exact hb'
    have := Ideal.mul_mem_of_mem_span_of_forall (T : Set A) ⊥ ((∏ a ∈ S, u a) * ∏ t ∈ T, v t)
      (fun t ht => by
        obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem v ht
        rw [hc, Ideal.mem_bot]
        calc _ = (∏ a ∈ S, u a) * c * (v t * t) := by ring
          _ = 0 := by rw [hv' t ht, mul_zero]) hbk
    exact Ideal.mem_bot.1 this

/-- The extension of `q` to the localization away from `g` is generated by the regular element
`π`, in the situation of `Ideal.exists_away_regularPrincipal_of_isDiscreteValuationRing`. -/
lemma isRegularPrincipal_map_away {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (g : A) [IsLocalization.Away g B] (q : Ideal A) (π : A) (hπ : π ∈ q)
    (h1 : ∀ a ∈ q, g * a ∈ Ideal.span {π}) (h2 : ∀ b, π * b = 0 → g * b = 0) :
    (q.map (algebraMap A B)).IsRegularPrincipal := by
  refine ⟨algebraMap A B π, ?_, ?_⟩
  · have key : ∀ x : B, x * algebraMap A B π = 0 → x = 0 := by
      intro x hx
      obtain ⟨⟨b, ⟨_, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers g) x
      rw [← IsLocalization.mk'_one (M := Submonoid.powers g) B π, ← IsLocalization.mk'_mul,
        mul_one, IsLocalization.mk'_eq_zero_iff] at hx
      obtain ⟨⟨_, m, rfl⟩, hm⟩ := hx
      rw [IsLocalization.mk'_eq_zero_iff]
      refine ⟨⟨g ^ (m + 1), m + 1, rfl⟩, ?_⟩
      have := h2 (g ^ m * b) (by rw [← hm]; ring)
      simp only
      rw [pow_succ, ← this]; ring
    exact mem_nonZeroDivisors_iff.mpr ⟨fun x hx ↦ key x (by rwa [mul_comm]), key⟩
  · apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 (h1 a ha)
      rw [Ideal.mem_comap, Ideal.mem_span_singleton']
      refine ⟨algebraMap A B c * IsLocalization.Away.invSelf g, ?_⟩
      calc _ = algebraMap A B (c * π) * IsLocalization.Away.invSelf g := by rw [map_mul]; ring
        _ = algebraMap A B a * (algebraMap A B g * IsLocalization.Away.invSelf g) := by
          rw [hc, map_mul]; ring
        _ = _ := by rw [IsLocalization.Away.mul_invSelf, mul_one]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ hπ

end Ideal

/-- A generator of a principal ideal which is also generated by a non-zerodivisor is a
non-zerodivisor: the two generators differ by a unit. -/
lemma mem_nonZeroDivisors_of_span_singleton_eq {R : Type*} [CommRing R] {c d : R}
    (hd : d ∈ nonZeroDivisors R) (h : Ideal.span {c} = Ideal.span {d}) :
    c ∈ nonZeroDivisors R := by
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.1 (h ▸ Ideal.mem_span_singleton_self c)
  obtain ⟨a', ha'⟩ := Ideal.mem_span_singleton.1 (h ▸ Ideal.mem_span_singleton_self d)
  have : a * a' = 1 := by
    have h1 : (a * a' - 1) * d = 0 := by linear_combination (-1 : R) * ha'
    exact sub_eq_zero.1 ((mem_nonZeroDivisors_iff_right.1 hd) _ h1)
  exact mul_mem_nonZeroDivisors.2 ⟨hd, (IsUnit.of_mul_eq_one a' this).mem_nonZeroDivisors⟩

/-- **Spreading out a principal ideal from a local ring.** Let `A` be a noetherian ring, `P` a
prime whose localization `A_P` is a domain, and `I` an ideal of `A` such that `I A_P` is
generated by a nonzero element. Then there is `g ∉ P` such that `I A_g` is generated by a
non-zerodivisor. -/
lemma Ideal.exists_notMem_isRegularPrincipal_map_away {A : Type*} [CommRing A]
    [IsNoetherianRing A] (P : Ideal A) [P.IsPrime] (Ap : Type*) [CommRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap P] [IsDomain Ap] (I : Ideal A) {t : Ap}
    (ht : I.map (algebraMap A Ap) = Ideal.span {t}) (ht0 : t ≠ 0) :
    ∃ g ∉ P, ∀ (Ag : Type*) [CommRing Ag] [Algebra A Ag] [IsLocalization.Away g Ag],
      (I.map (algebraMap A Ag)).IsRegularPrincipal := by
  classical
  obtain ⟨⟨⟨π, hπI⟩, s⟩, hπs⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl Ap).mp
    (ht ▸ Ideal.mem_span_singleton_self t)
  have hsu : IsUnit (algebraMap A Ap s) := IsLocalization.map_units Ap s
  have hspan : I.map (algebraMap A Ap) = Ideal.span {algebraMap A Ap π} := by
    rw [ht, ← hπs, Ideal.span_singleton_mul_right_unit hsu]
  have hπ0 : algebraMap A Ap π ≠ 0 := by
    rw [← hπs]
    exact mul_ne_zero ht0 hsu.ne_zero
  obtain ⟨S, hS⟩ := (IsNoetherian.noetherian I : I.FG)
  have h1 (a : A) (ha : a ∈ S) : ∃ u ∉ P, u * a ∈ Ideal.span {π} := by
    have : algebraMap A Ap a ∈ (Ideal.span {π}).map (algebraMap A Ap) := by
      rw [Ideal.map_span, Set.image_singleton, ← hspan]
      exact Ideal.mem_map_of_mem _ (hS ▸ Ideal.subset_span ha)
    obtain ⟨u, hu, h⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff P.primeCompl Ap _ _).1 this
    exact ⟨u, hu, h⟩
  choose! u hu hu' using h1
  obtain ⟨T, hT⟩ :=
    (IsNoetherian.noetherian (RingHom.ker (algebraMap A Ap)) : (RingHom.ker _).FG)
  have h2 (b : A) (hb : b ∈ T) : ∃ v ∉ P, v * b = 0 := by
    have : algebraMap A Ap b = 0 := (hT ▸ Ideal.subset_span hb : b ∈ RingHom.ker _)
    obtain ⟨⟨v, hv⟩, h⟩ := (IsLocalization.map_eq_zero_iff P.primeCompl Ap b).1 this
    exact ⟨v, hv, h⟩
  choose! v hv hv' using h2
  have hg : (∏ a ∈ S, u a) * ∏ b ∈ T, v b ∉ P :=
    P.primeCompl.mul_mem (P.primeCompl.prod_mem fun a ha => hu a ha)
      (P.primeCompl.prod_mem fun b hb => hv b hb)
  refine ⟨_, hg, fun Ag _ _ _ ↦
    Ideal.isRegularPrincipal_map_away ((∏ a ∈ S, u a) * ∏ b ∈ T, v b) I π hπI ?_ ?_⟩
  · intro a ha
    rw [← hS] at ha
    refine Ideal.mul_mem_of_mem_span_of_forall _ _ _ (fun a ha => ?_) ha
    obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem u ha
    rw [hc]
    convert Ideal.mul_mem_right (c * ∏ b ∈ T, v b) _ (hu' a ha) using 1
    ring
  · intro b hb
    have hb' : algebraMap A Ap b = 0 := by
      have := congrArg (algebraMap A Ap) hb
      rw [map_mul, map_zero] at this
      exact (mul_eq_zero.1 this).resolve_left hπ0
    have hbk : b ∈ Ideal.span (T : Set A) := by
      rw [Ideal.span, hT]
      exact hb'
    have := Ideal.mul_mem_of_mem_span_of_forall (T : Set A) ⊥ ((∏ a ∈ S, u a) * ∏ b ∈ T, v b)
      (fun t ht => by
        obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem v ht
        rw [hc, Ideal.mem_bot]
        calc _ = (∏ a ∈ S, u a) * c * (v t * t) := by ring
          _ = 0 := by rw [hv' t ht, mul_zero]) hbk
    exact Ideal.mem_bot.1 this
