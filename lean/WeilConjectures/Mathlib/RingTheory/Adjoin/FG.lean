module

public import Mathlib.RingTheory.Adjoin.FG

/-!
# The poset of finitely generated subalgebras

The finitely generated `R`-subalgebras of an `R`-algebra `A` form a nonempty directed
poset `{S : Subalgebra R A // S.FG}` whose supremum is all of `A`
(`Subalgebra.iSup_val_fg_eq_top`).

This is the algebra analogue of `Module.fgSystem` in
`Mathlib/Algebra/Colimit/Finiteness.lean`, and it is the index poset of the filtered
system exhibiting `A` as the colimit of its finitely generated subalgebras.
-/

@[expose] public section

namespace Subalgebra

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]

instance : Nonempty {S : Subalgebra R A // S.FG} := ⟨⟨⊥, fg_bot⟩⟩

instance : IsDirectedOrder {S : Subalgebra R A // S.FG} where
  directed S T :=
    ⟨⟨_, S.2.sup T.2⟩, Subtype.coe_le_coe.mp le_sup_left, Subtype.coe_le_coe.mp le_sup_right⟩

/-- The `R`-subalgebra of `A` generated by a single element, as a finitely generated
`R`-subalgebra. -/
def fgAdjoinSingleton (x : A) : {S : Subalgebra R A // S.FG} :=
  ⟨Algebra.adjoin R {x}, ⟨{x}, by simp⟩⟩

@[simp]
lemma self_mem_fgAdjoinSingleton (x : A) : x ∈ (fgAdjoinSingleton R A x).1 :=
  Algebra.self_mem_adjoin_singleton R x

lemma iSup_val_fg_eq_top : ⨆ S : {S : Subalgebra R A // S.FG}, S.1 = ⊤ :=
  le_antisymm le_top fun x _ ↦
    le_iSup (fun S : {S : Subalgebra R A // S.FG} ↦ S.1) (fgAdjoinSingleton R A x)
      (self_mem_fgAdjoinSingleton R A x)

end Subalgebra
