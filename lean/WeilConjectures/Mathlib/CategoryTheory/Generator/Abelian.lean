module

public import Mathlib.CategoryTheory.Generator.Abelian

/-!
# Objects are generated by the images of the maps from a separator

If `G` is a separator of an abelian category `C` whose subobject lattices are complete,
then every object `X` of `C` is the supremum of the images of the morphisms `G ⟶ X`.

## Main results

- `CategoryTheory.iSup_imageSubobject_eq_top_of_isSeparator`
-/

@[expose] public section

universe w v u

namespace CategoryTheory

open Limits

variable {C : Type u} [Category.{v} C] [Abelian C] [LocallySmall.{w} C] [WellPowered.{w} C]
  [HasCoproducts.{w} C] [HasWidePullbacks.{w} C] (G : C)

/-- For a separator `G`, every object is the join of the images of the maps out of `G`. -/
lemma iSup_imageSubobject_eq_top_of_isSeparator (hG : IsSeparator G) (X : C) :
    ⨆ (f : G ⟶ X), Limits.imageSubobject f = ⊤ := by
  have hepi : Epi (⨆ (f : G ⟶ X), imageSubobject f).arrow := by
    constructor
    intro Z u v huv
    refine hG.def _ _ fun f ↦ ?_
    have hle : imageSubobject f ≤ ⨆ (f : G ⟶ X), imageSubobject f :=
      le_iSup (fun (f : G ⟶ X) ↦ imageSubobject f) f
    have hf : factorThruImageSubobject f ≫ Subobject.ofLE _ _ hle ≫
        (⨆ (f : G ⟶ X), imageSubobject f).arrow = f := by
      rw [Subobject.ofLE_arrow, imageSubobject_arrow_comp]
    rw [← hf]
    simp only [Category.assoc, huv]
  have : IsIso (⨆ (f : G ⟶ X), imageSubobject f).arrow := isIso_of_mono_of_epi _
  exact Subobject.eq_top_of_isIso_arrow _

end CategoryTheory
