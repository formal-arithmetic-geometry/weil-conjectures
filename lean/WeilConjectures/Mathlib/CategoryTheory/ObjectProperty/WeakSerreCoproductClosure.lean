module

public import Mathlib.CategoryTheory.ObjectProperty.ColimitsOfShape
public import Mathlib.CategoryTheory.ObjectProperty.ContainsZero
public import Mathlib.CategoryTheory.ObjectProperty.Extensions
public import Mathlib.CategoryTheory.ObjectProperty.Kernels

/-!
# The weak Serre class generated by a property, closed under coproducts

For a property of objects `P` of a category `C` with zero morphisms, `P.weakSerreCoproductClosure`
is the smallest property containing `P` which is closed under isomorphisms, kernels, cokernels,
extensions and coproducts indexed by types in a fixed universe `Type w`. The complexes with
cohomology in such a class form a localizing subcategory of the derived category
(`DerivedCategory.homologyProperty`).
-/

@[expose] public section

universe w v u

open CategoryTheory Limits ZeroObject

namespace CategoryTheory.ObjectProperty

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [HasZeroObject C]
  (P : ObjectProperty C)

/-- The smallest property of objects containing `P` which is closed under isomorphisms, kernels,
cokernels, extensions and coproducts indexed by types in `Type w`: an object satisfies it if it
satisfies every such property containing `P`. -/
def weakSerreCoproductClosure : ObjectProperty C := fun X ↦
  ∀ Q : ObjectProperty C, P ≤ Q → Q.IsClosedUnderIsomorphisms → Q.IsClosedUnderKernels →
    Q.IsClosedUnderCokernels → Q.IsClosedUnderExtensions →
    (∀ J : Type w, Q.IsClosedUnderColimitsOfShape (Discrete J)) → Q X

omit [HasZeroObject C] in
/-- `P` is contained in the weak Serre class closed under coproducts that it generates. -/
lemma le_weakSerreCoproductClosure : P ≤ P.weakSerreCoproductClosure.{w} :=
  fun _ hX _ hPQ _ _ _ _ _ ↦ hPQ _ hX

instance : (weakSerreCoproductClosure.{w} P).IsClosedUnderIsomorphisms where
  of_iso e hX Q hPQ h₁ h₂ h₃ h₄ h₅ := Q.prop_of_iso e (hX Q hPQ h₁ h₂ h₃ h₄ h₅)

instance : (weakSerreCoproductClosure.{w} P).IsClosedUnderKernels where
  kernels_le := by
    rintro _ ⟨_, k, hk, hf⟩ Q hPQ h₁ h₂ h₃ h₄ h₅
    exact Q.prop_of_isLimit_kernelFork hk (hf.1 Q hPQ h₁ h₂ h₃ h₄ h₅)
      (hf.2 Q hPQ h₁ h₂ h₃ h₄ h₅)

instance : (weakSerreCoproductClosure.{w} P).IsClosedUnderCokernels where
  cokernels_le := by
    rintro _ ⟨_, k, hk, hf⟩ Q hPQ h₁ h₂ h₃ h₄ h₅
    exact Q.prop_of_isColimit_cokernelCofork hk (hf.1 Q hPQ h₁ h₂ h₃ h₄ h₅)
      (hf.2 Q hPQ h₁ h₂ h₃ h₄ h₅)

instance : (weakSerreCoproductClosure.{w} P).IsClosedUnderExtensions where
  prop_X₂_of_shortExact hS hX₁ hX₃ Q hPQ h₁ h₂ h₃ h₄ h₅ :=
    Q.prop_X₂_of_shortExact hS (hX₁ Q hPQ h₁ h₂ h₃ h₄ h₅) (hX₃ Q hPQ h₁ h₂ h₃ h₄ h₅)

instance (J : Type w) :
    (weakSerreCoproductClosure.{w} P).IsClosedUnderColimitsOfShape (Discrete J) where
  colimitsOfShape_le := by
    rintro X ⟨h⟩ Q hPQ h₁ h₂ h₃ h₄ h₅
    exact Q.prop_of_isColimit h.isColimit fun j ↦ h.prop_diag_obj j Q hPQ h₁ h₂ h₃ h₄ h₅

/-- The weak Serre class closed under coproducts generated by `P` contains the zero object, the
coproduct of the empty family. -/
instance : (weakSerreCoproductClosure.{w} P).ContainsZero where
  exists_zero := ⟨0, isZero_zero C, fun Q _ _ _ _ _ h₅ ↦
    have := h₅ PEmpty
    Q.prop_of_isColimit (F := Discrete.functor (PEmpty.elim : PEmpty.{w + 1} → C))
      (c := { pt := 0, ι := { app := fun j ↦ j.as.elim, naturality := fun j _ _ ↦ j.as.elim } })
      { desc := fun _ ↦ 0
        fac := fun _ j ↦ j.as.elim
        uniq := fun _ _ _ ↦ (isZero_zero C).eq_of_src _ _ }
      fun j ↦ j.as.elim⟩

end CategoryTheory.ObjectProperty
