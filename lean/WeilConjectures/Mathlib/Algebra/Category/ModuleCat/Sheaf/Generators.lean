module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators

/-!
# Generating sections from epimorphisms out of free sheaves of modules

A family of global sections `s : I → M.sections` generates a sheaf of modules `M` exactly when
the corresponding morphism `free I ⟶ M` is an epimorphism. This file records the converse
construction, generating sections from any epimorphism `free I ⟶ M`, and uses it to produce
generating sections of a coproduct from generating sections of its summands.

## Main definitions

- `SheafOfModules.GeneratingSections.ofEpiFree`: the generating sections given by an
  epimorphism `free I ⟶ M`.
- `SheafOfModules.GeneratingSections.sigma`: generating sections of a coproduct `∐ M`, from
  generating sections of each `M a`.
-/

@[expose] public section

universe u v' u'

open CategoryTheory Limits

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

namespace SheafOfModules.GeneratingSections

/-- An epimorphism `p : free I ⟶ M` gives generating sections of `M`: the images under `p` of
the canonical sections of `free I`. -/
@[simps]
noncomputable def ofEpiFree {M : SheafOfModules.{u} R} {I : Type u} (p : free I ⟶ M) [Epi p] :
    M.GeneratingSections where
  I := I
  s := M.freeHomEquiv p
  epi := by rw [Equiv.symm_apply_apply]; infer_instance

@[simp]
lemma ofEpiFree_π {M : SheafOfModules.{u} R} {I : Type u} (p : free I ⟶ M) [Epi p] :
    (ofEpiFree p).π = p :=
  Equiv.symm_apply_apply _ _

/-- **Generating sections of a coproduct.** If each `M a` is generated by the sections
`σ a`, then `∐ M` is generated by their images, indexed by `Σ a, (σ a).I`: the morphism
`free (Σ a, (σ a).I) ≅ ∐ free (σ a).I ⟶ ∐ M` is the coproduct of the epimorphisms
`(σ a).π`. -/
noncomputable def sigma {ι : Type u} (M : ι → SheafOfModules.{u} R)
    (σ : ∀ a, (M a).GeneratingSections) : (∐ M).GeneratingSections :=
  ofEpiFree (((freeFunctor (R := R)).mapIso (Types.coproductIso fun a ↦ (σ a).I).symm ≪≫
    PreservesCoproduct.iso (freeFunctor (R := R)) fun a ↦ (σ a).I).hom ≫
      Limits.Sigma.map fun a ↦ (σ a).π)

instance {ι : Type u} [Finite ι] (M : ι → SheafOfModules.{u} R)
    (σ : ∀ a, (M a).GeneratingSections) [∀ a, (σ a).IsFiniteType] : (sigma M σ).IsFiniteType where
  finite := inferInstanceAs (Finite (Σ a, (σ a).I))

end SheafOfModules.GeneratingSections
