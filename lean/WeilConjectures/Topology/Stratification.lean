module

public import Mathlib.Order.ConditionallyCompleteLattice.Basic
public import Mathlib.Topology.Defs.Basic
public import WeilConjectures.Mathlib.Topology.Constructible

/-!
# Stratifications of topological spaces

Following [Stacks 09XZ], a *stratification* of a topological space `X` is a partition of
`X` into pairwise disjoint locally closed subsets covering `X`. `Topology.Stratification`
additionally requires the partition to be finite and the strata to be constructible subsets
(`Topology.IsConstructible`), the case relevant for constructible sheaves [Stacks 03RW].

On a Noetherian space every locally closed subset is constructible
(`IsLocallyClosed.isConstructible_of_noetherianSpace`), and
`Topology.Stratification.ofNoetherianSpace` builds a stratification from locally closed strata
alone.
-/

@[expose] public section

namespace Topology

/-- A *stratification* of a topological space `X`: a finite partition of `X` into pairwise
disjoint locally closed *constructible* subsets — the *strata* — covering `X`.

This is the notion of [Stacks 09XZ] (a partition into locally closed subsets) with two
additional requirements, neither of which is part of loc. cit.: the partition is finite, and
the strata are constructible (`Topology.IsConstructible`: in the Boolean algebra generated by
the retrocompact open subsets). Both are the requirements made of the strata in the definition
of a constructible sheaf [Stacks 03RW], which asks for finite decompositions into
*constructible* locally closed subschemes. Neither condition on the strata implies the other: a
constructible subset need not be locally closed, and on a non-Noetherian space a locally closed
subset need not be constructible (a closed non-open point of the spectrum of an infinite
product of fields).

Constructibility is required in the global sense `Topology.IsConstructible` rather than in the
local sense `Topology.IsLocallyConstructible`. The two agree on quasi-compact quasi-separated
spectral spaces (`Topology.IsLocallyConstructible.isConstructible`), hence on the underlying
spaces of the quasi-compact quasi-separated schemes for which [Stacks 03RW] is affine-local; and
the global notion is the one with the stability properties used for stratifications of
schemes: preimages along arbitrary morphisms of schemes
(`AlgebraicGeometry.Scheme.Hom.isConstructible_preimage`), images along open embeddings with
retrocompact range and along closed embeddings with retrocompact complement
(`Topology.IsConstructible.image_of_isOpenEmbedding`,
`Topology.IsConstructible.image_of_isClosedEmbedding`), and finite intersections. On a
Noetherian space every locally closed subset is constructible, see
`Topology.Stratification.ofNoetherianSpace`. -/
@[stacks 09XZ]
structure Stratification (X : Type*) [TopologicalSpace X] where
  /-- The number of strata. -/
  n : ℕ
  /-- The strata. -/
  stratum : Fin n → Set X
  isLocallyClosed_stratum : ∀ i, IsLocallyClosed (stratum i)
  /-- The strata are constructible subsets of `X`. -/
  isConstructible_stratum : ∀ i, IsConstructible (stratum i)
  iUnion_stratum_eq_univ : ⋃ i, stratum i = Set.univ
  pairwise_disjoint_stratum : Pairwise (Function.onFun Disjoint stratum)

namespace Stratification

variable {X : Type*} [TopologicalSpace X]

/-- **Stratifications of a Noetherian space from locally closed strata.** On a Noetherian space
every locally closed subset is constructible, so a finite partition of the space into locally
closed subsets is a stratification. -/
@[simps]
def ofNoetherianSpace [TopologicalSpace.NoetherianSpace X] (n : ℕ) (stratum : Fin n → Set X)
    (isLocallyClosed_stratum : ∀ i, IsLocallyClosed (stratum i))
    (iUnion_stratum_eq_univ : ⋃ i, stratum i = Set.univ)
    (pairwise_disjoint_stratum : Pairwise (Function.onFun Disjoint stratum)) :
    Stratification X where
  n := n
  stratum := stratum
  isLocallyClosed_stratum := isLocallyClosed_stratum
  isConstructible_stratum i := (isLocallyClosed_stratum i).isConstructible_of_noetherianSpace
  iUnion_stratum_eq_univ := iUnion_stratum_eq_univ
  pairwise_disjoint_stratum := pairwise_disjoint_stratum

end Stratification

end Topology
