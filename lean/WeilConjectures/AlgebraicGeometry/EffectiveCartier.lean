/-!
# The line bundle of an effective Cartier divisor

An effective Cartier divisor `D ⊆ X` is given by an invertible ideal sheaf `J = 𝒪_X(-D)`
(`AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible`), and `D` is the closed subscheme
`J.subschemeι : V(J) ⟶ X`. Its *line bundle* is `𝒪_X(D) = 𝒪_X(-D)ᵛ`, the dual of the ideal
sheaf `J.toModules`.

When `X` is a scheme over a field `k` and `D` is finite over `k`, the *degree* of `D` is
`deg D = dim_k Γ(D, 𝒪_D)`, which is `(J.subschemeι ≫ X ↘ Spec k).finrankΓ`
(`AlgebraicGeometry.Scheme.Hom.finrankΓ`). For `D = ∑_x n_x x` on a curve,
`Γ(D, 𝒪_D) = ∏_x 𝒪_{X,x}/𝔪_x^{n_x}` has dimension `∑_x n_x [κ(x) : k]`, the classical degree
of a divisor.

## Main statements

- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.isInvertible_dual_toModules`: the line
  bundle `𝒪_X(D)` of an effective Cartier divisor is invertible
  (blueprint `lem-pc-divisor-line-bundle-properties`, part 1).
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.isInvertible_toModules`: so is its ideal
  sheaf `𝒪_X(-D)`.
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.nonempty_pullback_dual_toModules_iso`:
  the line bundle of a divisor commutes with pullback, when the pulled back divisor is still
  effective Cartier (blueprint `lem-pc-recd-pullback`).
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.nonempty_dual_toModules_comap_iso`: the
  line bundle commutes with flat pullback
  (blueprint `lem-pc-divisor-line-bundle-properties`, part 2).
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Opposite

open scoped AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry.Scheme

variable {X : Scheme.{u}}

/-- The restriction maps of the structure sheaf are the `appLE` of the identity. -/
lemma Hom.id_appLE (U V : X.Opens) (h : V ≤ U) :
    Scheme.Hom.appLE (𝟙 X) U V h = X.presheaf.map (homOfLE h).op := by
  simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
  exact Category.id_comp _

/-- Two sections of the structure sheaf over `W` agree if every point of `W` has an open
neighbourhood in `W` on which they agree. -/
lemma presheaf_ext_of_forall_exists {W : X.Opens} {a b : Γ(X, W)}
    (h : ∀ x ∈ W, ∃ (V : X.Opens) (hV : V ≤ W), x ∈ V ∧
      X.presheaf.map (homOfLE hV).op a = X.presheaf.map (homOfLE hV).op b) : a = b := by
  choose V hV hxV hab using h
  exact TopCat.Sheaf.eq_of_locally_eq' X.sheaf (fun x : W ↦ V x.1 x.2) W
    (fun x ↦ homOfLE (hV x.1 x.2))
    (fun x hx ↦ TopologicalSpace.Opens.mem_iSup.2 ⟨⟨x, hx⟩, hxV x hx⟩) a b
    (fun x ↦ hab x.1 x.2)

/-- If `J` is invertible and `J.ideal V = (c)` on an affine open `V`, then `c` is a
non-zerodivisor: near every point `J` is generated by a non-zerodivisor `d`, and on a common
basic open `c` and `d` generate the same ideal. -/
lemma IdealSheafData.IsInvertible.mem_nonZeroDivisors {J : X.IdealSheafData}
    (hJ : J.IsInvertible) {V : X.affineOpens} {c : Γ(X, V.1)} (hc : J.ideal V = Ideal.span {c}) :
    c ∈ nonZeroDivisors Γ(X, V.1) := by
  have key (x : X) (hx : x ∈ V.1) : ∃ f : Γ(X, V.1), x ∈ X.basicOpen f ∧
      X.presheaf.map (homOfLE (X.basicOpen_le f)).op c ∈ nonZeroDivisors _ := by
    obtain ⟨V', hxV', d, hd, hV'⟩ := hJ x
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter V.2 V'.2 x ⟨hx, hxV'⟩
    have hDV' : X.affineBasicOpen f ≤ V' := (hfg ▸ X.basicOpen_le g : X.basicOpen f ≤ V'.1)
    have hDV : X.affineBasicOpen f ≤ V := X.basicOpen_le f
    refine ⟨f, hxf, mem_nonZeroDivisors_of_span_singleton_eq
      (d := X.presheaf.map (homOfLE hDV').op d) ?_ ?_⟩
    · have hfl := Flat.flat_appLE (𝟙 X) V'.2 (X.affineBasicOpen f).2 hDV'
      rw [Hom.id_appLE] at hfl
      exact hfl.map_mem_nonZeroDivisors hd
    · have e1 : Ideal.span {X.presheaf.map (homOfLE hDV).op c} =
          J.ideal (X.affineBasicOpen f) := by
        rw [← J.map_ideal hDV, hc, Ideal.map_span, Set.image_singleton]
        rfl
      have e2 : Ideal.span {X.presheaf.map (homOfLE hDV').op d} =
          J.ideal (X.affineBasicOpen f) := by
        rw [← J.map_ideal hDV', hV', Ideal.map_span, Set.image_singleton]
        rfl
      exact e1.trans e2.symm
  refine mem_nonZeroDivisors_iff_right.2 fun r hr ↦ presheaf_ext_of_forall_exists fun x hx ↦ ?_
  obtain ⟨f, hxf, hf⟩ := key x hx
  refine ⟨X.basicOpen f, X.basicOpen_le f, hxf, ?_⟩
  rw [map_zero]
  refine mem_nonZeroDivisors_iff_right.1 hf _ ?_
  rw [← map_mul, hr, map_zero]

/-- A section `e` of `M` over `U` is a free generator as soon as `r ↦ r • e|_W` is injective
for every open `W ⊆ U` and surjective for every affine open `W ⊆ U`: the coefficients on affine
opens glue by injectivity. -/
lemma Modules.isFreeGenerator_of_affineOpens {M : X.Modules} {U : X.Opens} (e : Γ(M, U))
    (hinj : ∀ (W : X.Opens) (h : W ≤ U),
      Function.Injective fun r : Γ(X, W) ↦ r • M.presheaf.map (homOfLE h).op e)
    (hsurj : ∀ (V : X.affineOpens) (h : V.1 ≤ U),
      Function.Surjective fun r : Γ(X, V.1) ↦ r • M.presheaf.map (homOfLE h).op e) :
    Modules.IsFreeGenerator e := by
  intro W hW
  refine ⟨hinj W hW, fun m ↦ ?_⟩
  let ι := {V : X.affineOpens // V.1 ≤ W}
  have hcov : W ≤ ⨆ i : ι, i.1.1 := fun x hx ↦ by
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx W.2
    exact TopologicalSpace.Opens.mem_iSup.2 ⟨⟨⟨V, hV⟩, hVW⟩, hxV⟩
  choose r hr using fun i : ι ↦ hsurj i.1 (i.2.trans hW) (M.presheaf.map (homOfLE i.2).op m)
  have key (i : ι) (V : X.Opens) (k : V ⟶ i.1.1) :
      X.presheaf.map k.op (r i) • M.presheaf.map (homOfLE (k.le.trans (i.2.trans hW))).op e =
        M.presheaf.map (k ≫ homOfLE i.2).op m := by
    rw [← Modules.presheaf_map_map_apply, ← hr i, Modules.map_smul,
      Modules.presheaf_map_map_apply]
    rfl
  obtain ⟨t, ht, -⟩ : ∃! t : Γ(X, W), ∀ i : ι, X.presheaf.map (homOfLE i.2).op t = r i :=
    TopCat.Sheaf.existsUnique_gluing' X.sheaf (fun i : ι ↦ i.1.1) W
      (fun i ↦ homOfLE i.2) hcov r fun i j ↦ hinj _ (inf_le_left.trans (i.2.trans hW))
        ((key i _ _).trans (key j _ _).symm)
  refine ⟨t, TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩ (fun i : ι ↦ i.1.1) W
    (fun i ↦ homOfLE i.2) hcov _ _ fun i ↦ ?_⟩
  refine (Modules.map_smul _ _ _ _).trans ?_
  rw [Modules.presheaf_map_map_apply, ht i]
  exact hr i

/-- Over an affine open, every element of the ideal is the image of a section of the ideal
sheaf. -/
lemma IdealSheafData.exists_toModulesι_app_eq (J : X.IdealSheafData) {U : X.affineOpens}
    {b : Γ(X, U.1)} (hb : b ∈ J.ideal U) : ∃ s, J.toModulesι.app U.1 s = b :=
  (J.range_toModulesι_app U).ge hb

/-- If `J` is invertible and the image `c` in `𝒪_X` of a section `s` of `J.toModules` over `U`
generates `J` on every affine open `V ⊆ U`, then `s` is a free generator of `J.toModules` on
`U`: multiplication by `c` identifies `𝒪_U` with `J|_U`. -/
lemma IdealSheafData.IsInvertible.isFreeGenerator {J : X.IdealSheafData} (hJ : J.IsInvertible)
    {U : X.Opens} (s : Γ(J.toModules, U))
    (hs : ∀ (V : X.affineOpens) (h : V.1 ≤ U),
      J.ideal V = Ideal.span {X.presheaf.map (homOfLE h).op (J.toModulesι.app U s)}) :
    Modules.IsFreeGenerator s := by
  have hι (W : X.Opens) (h : W ≤ U) (r : Γ(X, W)) :
      J.toModulesι.app W (r • J.toModules.presheaf.map (homOfLE h).op s) =
        r * X.presheaf.map (homOfLE h).op (J.toModulesι.app U s) := by
    exact (Modules.Hom.app_smul J.toModulesι r _).trans
      (congrArg (fun y : Γ(X, W) ↦ r * y)
        (Modules.Hom.app_presheaf_map J.toModulesι (homOfLE h) s))
  refine Modules.isFreeGenerator_of_affineOpens s (fun W h r r' hr ↦ ?_) (fun V h m ↦ ?_)
  · have h0 : r * X.presheaf.map (homOfLE h).op (J.toModulesι.app U s) =
        r' * X.presheaf.map (homOfLE h).op (J.toModulesι.app U s) := by
      rw [← hι, ← hι]
      exact congrArg (J.toModulesι.app W) hr
    rw [← sub_eq_zero]
    refine presheaf_ext_of_forall_exists fun x hx ↦ ?_
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx W.2
    replace hVW : V ≤ W := hVW
    refine ⟨V, hVW, hxV, ?_⟩
    rw [map_zero]
    refine mem_nonZeroDivisors_iff_right.1
      (hJ.mem_nonZeroDivisors (hs ⟨V, hV⟩ (hVW.trans h))) _ ?_
    have hc : X.presheaf.map (homOfLE (hVW.trans h)).op (J.toModulesι.app U s) =
        X.presheaf.map (homOfLE hVW).op
          (X.presheaf.map (homOfLE h).op (J.toModulesι.app U s)) :=
      (presheaf_map_map_apply _ _ _).symm
    rw [hc, ← map_mul, sub_mul, h0, sub_self, map_zero]
  · obtain ⟨a, ha⟩ : ∃ a : Γ(X, V.1),
        a * X.presheaf.map (homOfLE h).op (J.toModulesι.app U s) = J.toModulesι.app V.1 m :=
      Ideal.mem_span_singleton'.1 (by
        rw [← hs V h]
        exact (J.range_toModulesι_app V).subset ⟨m, rfl⟩)
    exact ⟨a, J.injective_toModulesι_app V.1 ((hι V.1 h a).trans ha)⟩

/-- The ideal sheaf `𝒪_X(-D)` of an effective Cartier divisor `D` is invertible: on an affine
open where the invertible ideal `J` is generated by a non-zerodivisor `b`, multiplication by `b`
identifies `𝒪_X` with `J`.

(blueprint: `def-sc-effective-cartier-divisor`) -/
theorem IdealSheafData.IsInvertible.isInvertible_toModules {J : X.IdealSheafData}
    (hJ : J.IsInvertible) : J.toModules.IsInvertible := by
  refine ⟨fun x ↦ ?_⟩
  obtain ⟨U, hxU, b, hb, hU⟩ := hJ x
  obtain ⟨s, hs⟩ := J.exists_toModulesι_app_eq (hU ▸ Ideal.mem_span_singleton_self b)
  have he := hJ.isFreeGenerator s fun V h ↦ by
    rw [hs, ← J.map_ideal h, hU, Ideal.map_span, Set.image_singleton]
    rfl
  exact ⟨U.1, hxU, ⟨Modules.pullbackIotaUnitIsoOfOverIso he.overIso⟩⟩

/-- The line bundle `𝒪_X(D) = 𝒪_X(-D)ᵛ = Hom(𝒪_X(-D), 𝒪_X)` of an effective Cartier divisor
`D` (blueprint `def-pc-divisor-line-bundle`) is invertible, where `𝒪_X(-D)` is the ideal sheaf
of the invertible ideal `J`.

(blueprint: `sk-thm-picard-rr`, `lem-pc-divisor-line-bundle-properties`, part 1) -/
theorem IdealSheafData.IsInvertible.isInvertible_dual_toModules {J : X.IdealSheafData}
    (hJ : J.IsInvertible) : J.toModulesᵛ.IsInvertible := by
  have := hJ.isInvertible_toModules
  infer_instance

section Pullback

variable {Y : Scheme.{u}}

/-- **Uniqueness of tensor inverses.** If `M` is invertible and `M ⊗ N ≅ 𝒪_X`, then `N ≅ Mᵛ`. -/
lemma Modules.nonempty_iso_dual_of_tensorObj_iso_unit (M N : X.Modules) [M.IsInvertible]
    (e : M ⊗ N ≅ 𝟙_ X.Modules) : Nonempty (N ≅ Mᵛ) := by
  obtain ⟨d⟩ := Modules.nonempty_tensorObj_dual_iso_unit M
  exact ⟨(λ_ N).symm ≪≫ whiskerRightIso (d.symm ≪≫ β_ _ _) N ≪≫ α_ _ _ _ ≪≫
    whiskerLeftIso _ e ≪≫ ρ_ _⟩

/-- **The pullback of the dual of an invertible module is the dual of the pullback**: both are
tensor inverses of the pullback. -/
lemma Modules.nonempty_pullback_dual_iso (g : Y ⟶ X) (M : X.Modules) [M.IsInvertible] :
    Nonempty ((Modules.pullback g).obj Mᵛ ≅ ((Modules.pullback g).obj M)ᵛ) := by
  obtain ⟨d⟩ := Modules.nonempty_tensorObj_dual_iso_unit M
  obtain ⟨t⟩ := Modules.nonempty_pullback_tensorObj_iso g M Mᵛ
  exact Modules.nonempty_iso_dual_of_tensorObj_iso_unit _ _
    (t.symm ≪≫ (Modules.pullback g).mapIso d ≪≫ Modules.pullbackObjUnitIso g)

/-- A morphism of `𝒪_X`-modules which, near every point, maps some free generator of the source
to a free generator of the target is an isomorphism. -/
lemma Modules.isIso_of_isFreeGenerator {M N : X.Modules} (φ : M ⟶ N)
    (h : ∀ x : X, ∃ (U : X.Opens) (e : Γ(M, U)), x ∈ U ∧ Modules.IsFreeGenerator e ∧
      Modules.IsFreeGenerator (φ.app U e)) : IsIso φ := by
  choose U e hxU he hφe using h
  have hbij (x : X) (W : X.Opens) (hW : W ≤ U x) : Function.Bijective (φ.app W) := by
    refine (Function.Bijective.of_comp_iff _ (he x W hW)).1 ?_
    convert hφe x W hW using 1
    ext r
    simp only [Function.comp_apply, Modules.Hom.app_smul, Modules.Hom.app_presheaf_map]
  have : IsIso ((Modules.toPresheaf X).map φ) := by
    refine Presheaf.isIso_of_isIso_app_of_mem (Opens.grothendieckTopology X) M.isSheaf N.isSheaf
      _ fun W ↦ ⟨⟨fun V _ ↦ ∃ x, V ≤ U x, fun ⟨x, hx⟩ f ↦ ⟨x, f.le.trans hx⟩⟩,
        fun x hx ↦ ⟨W ⊓ U x, homOfLE inf_le_left, ⟨x, inf_le_right⟩, hx, hxU x⟩,
        fun V _ ⟨x, hx⟩ ↦ ?_⟩
    rw [ConcreteCategory.isIso_iff_bijective]
    exact hbij x V hx
  exact isIso_of_reflects_iso φ (Modules.toPresheaf X)

set_option backward.isDefEq.respectTransparency false in
/-- A section of `𝒪_X` vanishing on the closed subscheme `V(J)` pulls back to a section of `𝒪_Y`
vanishing on `V(J.comap g)`, since `V(J.comap g) ⟶ Y ⟶ X` factors through `V(J)`. -/
lemma IdealSheafData.subschemeι_app_comap_app_eq_zero (g : Y ⟶ X) (J : X.IdealSheafData)
    {W : X.Opens} {a : Γ(X, W)} (ha : J.subschemeι.app W a = 0) :
    (J.comap g).subschemeι.app (g ⁻¹ᵁ W) (g.app W a) = 0 := by
  have e := Scheme.Hom.congr_app
    ((J.comap g).subschemeMap_subschemeι J g (J.le_map_comap g)).symm W
  have := ConcreteCategory.congr_hom e a
  rw [Scheme.Hom.comp_app, Scheme.Hom.comp_app] at this
  rw [← CommRingCat.comp_apply]
  refine this.trans ?_
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply, ha, map_zero, map_zero]

/-- The composite `g^* J ⟶ g^* 𝒪_X ≅ 𝒪_Y` of the pullback of the inclusion of an ideal sheaf
with the identification of the pullback of the structure sheaf. Its image is `J.comap g`. -/
noncomputable def IdealSheafData.pullbackToModulesι (g : Y ⟶ X) (J : X.IdealSheafData) :
    (Modules.pullback g).obj J.toModules ⟶ Modules.unit Y :=
  (Modules.pullback g).map J.toModulesι ≫ (Modules.pullbackObjUnitIso g).hom

set_option backward.isDefEq.respectTransparency false in
/-- The adjoint `J ⟶ g_* 𝒪_Y` of `g^* J ⟶ 𝒪_Y` is the inclusion followed by `g^♯`. -/
lemma IdealSheafData.homEquiv_pullbackToModulesι (g : Y ⟶ X) (J : X.IdealSheafData) :
    (Modules.pullbackPushforwardAdjunction g).homEquiv _ _ (J.pullbackToModulesι g) =
      J.toModulesι ≫ SheafOfModules.unitToPushforwardObjUnit g.toRingCatSheafHom := by
  have h2 : (Modules.pullbackPushforwardAdjunction g).homEquiv _ _
      (Modules.pullbackObjUnitIso g).hom =
      SheafOfModules.unitToPushforwardObjUnit g.toRingCatSheafHom :=
    @SheafOfModules.pullbackPushforwardAdjunction_homEquiv_pullbackObjUnitToUnit _ _ _ _ _ _ _ _ _
      _ _ (inferInstanceAs (Modules.pushforward g).IsRightAdjoint)
  rw [pullbackToModulesι, Adjunction.homEquiv_naturality_left, h2]

/-- The section of `g^* J` induced by a section `s` of `J` maps to `g^♯ s` in `𝒪_Y`. -/
lemma IdealSheafData.pullbackToModulesι_app_unit (g : Y ⟶ X) (J : X.IdealSheafData)
    (U : X.Opens) (s : Γ(J.toModules, U)) :
    (J.pullbackToModulesι g).app (g ⁻¹ᵁ U)
      (((Modules.pullbackPushforwardAdjunction g).unit.app J.toModules).app U s) =
      g.app U (J.toModulesι.app U s) := by
  have := congrArg (fun φ ↦ φ.app U s) (J.homEquiv_pullbackToModulesι g)
  simp only [Adjunction.homEquiv_unit] at this
  exact this

set_option backward.isDefEq.respectTransparency false in
/-- The map `g^* J ⟶ 𝒪_Y` lands in the ideal sheaf of `J.comap g`. -/
lemma IdealSheafData.pullbackToModulesι_comp_toPushforwardSubscheme (g : Y ⟶ X)
    (J : X.IdealSheafData) :
    J.pullbackToModulesι g ≫ (J.comap g).toPushforwardSubscheme = 0 := by
  refine ((Modules.pullbackPushforwardAdjunction g).homEquiv _ _).injective
    (((Modules.pullbackPushforwardAdjunction g).homEquiv_naturality_right _ _).trans ?_)
  simp only [Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]
  rw [← Adjunction.homEquiv_unit, IdealSheafData.homEquiv_pullbackToModulesι]
  refine Modules.hom_ext _ _ fun W ↦ ?_
  ext m
  exact J.subschemeι_app_comap_app_eq_zero g ((J.range_toModulesι_app_eq W).subset ⟨m, rfl⟩)

set_option backward.isDefEq.respectTransparency false in
/-- **The pullback of an invertible ideal sheaf.** If `J` and `J.comap g` are invertible, then
`g^* J ≅ J.comap g`: the map `g^* J ⟶ 𝒪_Y` factors through `J.comap g`, and near every point it
sends a free generator of `g^* J` to a unit multiple of `g^♯ b`, where `J = (b)` locally; this
is a free generator of `J.comap g` since `g^♯ b` is a non-zerodivisor. -/
lemma IdealSheafData.IsInvertible.nonempty_pullback_toModules_iso (g : Y ⟶ X)
    {J : X.IdealSheafData} (hJ : J.IsInvertible) (hJ' : (J.comap g).IsInvertible) :
    Nonempty ((Modules.pullback g).obj J.toModules ≅ (J.comap g).toModules) := by
  have := hJ.isInvertible_toModules
  have := Modules.IsInvertible.sheafOfModules_isInvertible ((Modules.pullback g).obj J.toModules)
  let φ : (Modules.pullback g).obj J.toModules ⟶ (J.comap g).toModules :=
    kernel.lift _ (J.pullbackToModulesι g) (J.pullbackToModulesι_comp_toPushforwardSubscheme g)
  have hφ : φ ≫ (J.comap g).toModulesι = J.pullbackToModulesι g := kernel.lift_ι _ _ _
  refine ⟨@asIso _ _ _ _ φ (Modules.isIso_of_isFreeGenerator φ fun y ↦ ?_)⟩
  obtain ⟨U, hyU, b, -, hU⟩ := hJ (g y)
  obtain ⟨s, hs⟩ := J.exists_toModulesι_app_eq (hU ▸ Ideal.mem_span_singleton_self b)
  obtain ⟨V, hyV, hVU, e, he⟩ :=
    Modules.exists_isFreeGenerator ((Modules.pullback g).obj J.toModules) (W := g ⁻¹ᵁ U.1) hyU
  obtain ⟨a, ha⟩ := he.exists_smul_eq (((Modules.pullback g).obj J.toModules).presheaf.map
    (homOfLE hVU).op (((Modules.pullbackPushforwardAdjunction g).unit.app J.toModules).app U.1 s))
  have hV : (J.comap g).ideal V =
      Ideal.span {Y.presheaf.map (homOfLE hVU).op (g.app U.1 b)} := by
    rw [J.ideal_comap_appLE g U V hVU, hU, Ideal.map_span, Set.image_singleton]
    rfl
  obtain ⟨a', ha'⟩ : ∃ a' : Γ(Y, V.1), a' * Y.presheaf.map (homOfLE hVU).op (g.app U.1 b) =
      (J.comap g).toModulesι.app V.1 (φ.app V.1 e) :=
    Ideal.mem_span_singleton'.1 (by
      rw [← hV]
      exact ((J.comap g).range_toModulesι_app V).subset ⟨_, rfl⟩)
  have h1 := congrArg ((J.pullbackToModulesι g).app V.1) ha
  rw [Modules.Hom.app_smul, Modules.Hom.app_presheaf_map, pullbackToModulesι_app_unit, hs,
    ← hφ, Modules.Hom.comp_app] at h1
  rw [ConcreteCategory.comp_apply, ← ha'] at h1
  have haa' : a * a' = 1 := by
    have h2 : (a * a' - 1) * Y.presheaf.map (homOfLE hVU).op (g.app U.1 b) = 0 := by
      rw [sub_mul, one_mul, mul_assoc]
      exact sub_eq_zero.2 h1
    exact sub_eq_zero.1 (mem_nonZeroDivisors_iff_right.1 (hJ'.mem_nonZeroDivisors hV) _ h2)
  refine ⟨V.1, e, hyV, he, hJ'.isFreeGenerator _ fun V' h ↦ ?_⟩
  rw [← ha', map_mul, Ideal.span_singleton_mul_left_unit
    ((IsUnit.of_mul_eq_one a (mul_comm a a' ▸ haa')).map _), ← (J.comap g).map_ideal h, hV,
    Ideal.map_span, Set.image_singleton]
  rfl

end Pullback

/-- **The line bundle of a divisor commutes with pullback.** Let `g : Y ⟶ X` and let `D ⊆ X` be
an effective Cartier divisor, with ideal `J`, whose pullback `D ×_X Y`, with ideal
`J.comap g = J · 𝒪_Y`, is again an effective Cartier divisor. Then
`𝒪_Y(D ×_X Y) ≅ g^* 𝒪_X(D)`.

Locally `J = (b)` with `b` a non-zerodivisor and `J.comap g = (g^♯ b)`, and `g^♯ b` is again a
non-zerodivisor since `J.comap g` is invertible; so `g^* J ⟶ 𝒪_Y` is injective with image
`J.comap g`, and dualizing the locally free `g^* J ≅ J.comap g` gives the claim.

The hypothesis on `J.comap g` holds for the pullback of a relative effective Cartier divisor
along a base change, which is how the blueprint states it.

(blueprint: `lem-pc-recd-pullback`) -/
theorem IdealSheafData.IsInvertible.nonempty_pullback_dual_toModules_iso {Y : Scheme.{u}}
    (g : Y ⟶ X) {J : X.IdealSheafData} (hJ : J.IsInvertible) (hJ' : (J.comap g).IsInvertible) :
    Nonempty ((Modules.pullback g).obj J.toModulesᵛ ≅ (J.comap g).toModulesᵛ) := by
  have := hJ.isInvertible_toModules
  obtain ⟨e₁⟩ := Modules.nonempty_pullback_dual_iso g J.toModules
  obtain ⟨e₂⟩ := hJ.nonempty_pullback_toModules_iso g hJ'
  exact ⟨e₁ ≪≫ ((Modules.dualFunctor Y).mapIso e₂.op).symm⟩

/-- **The line bundle of an effective Cartier divisor commutes with flat pullback.** Let `D ⊆ Y`
be an effective Cartier divisor with invertible ideal `J` and let `g : X ⟶ Y` be flat. The
ideal of `D ×[Y] X` is the pullback `J.comap g` of `J`, which is again invertible, and
`𝒪_X(D ×[Y] X) ≅ g^* 𝒪_Y(D)`.

(blueprint: `lem-pc-divisor-line-bundle-properties`, part 2) -/
theorem IdealSheafData.IsInvertible.nonempty_dual_toModules_comap_iso {Y : Scheme.{u}}
    {J : Y.IdealSheafData} (hJ : J.IsInvertible) (g : X ⟶ Y) [Flat g] :
    Nonempty ((J.comap g).toModulesᵛ ≅ (Modules.pullback g).obj J.toModulesᵛ) :=
  (hJ.nonempty_pullback_dual_toModules_iso g (hJ.comap_of_flat g)).map CategoryTheory.Iso.symm

end AlgebraicGeometry.Scheme
