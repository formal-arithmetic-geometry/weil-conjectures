module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace
public import WeilConjectures.Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic

/-!
# Projective space on one homogeneous coordinate

For a one-element index type `n`, projective space adds nothing to the base: the structure
morphism of `ℙ(n; S)` is an isomorphism, and likewise over an affine base.

Indeed, if `n` has a single element `default`, the total-degree grading of `A[X]` has degree
`d` part the `A`-span of `Xᵈ`, so the irrelevant ideal is generated by `X` and
`D₊(X) = Proj A[X]`. The degree-zero part of `A[X]` localized away from `X` is `A` again,
because the only fraction of the shape `Xᵃ / Xᵃ` is `1`, whence
`Proj A[X] = D₊(X) ≅ Spec A`.

## Main definitions

- `AlgebraicGeometry.Proj.projectiveSpaceOverAffineIsoSpec` — for a one-element index type,
  the isomorphism `ℙ^n_A ≅ Spec A` given by the structure morphism.

## Main results

- `AlgebraicGeometry.Proj.instIsIsoProjectiveSpaceOverAffineToSpec` — for a one-element index
  type, the structure morphism `ℙ^n_A ⟶ Spec A` is an isomorphism.
- `AlgebraicGeometry.ProjectiveSpace.instIsIso` — for a one-element index type, the structure
  morphism `ℙ(n; S) ↘ S` is an isomorphism.

## Implementation notes

`MvPolynomial.bijective_fromZeroRingHom_X` is a statement about the homogeneous localization
of a polynomial ring in one variable, so it belongs to neither of the two Mathlib files it
mixes; it is kept here, next to its only use.
-/

@[expose] public section

universe u

open CategoryTheory Limits HomogeneousLocalization

noncomputable section

namespace MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable (n : Type u) (A : Type u) [CommRing A] [Unique n]

/-- **The degree-zero part of `A[X][X⁻¹]` is `A`** for a single variable `X`: the canonical
map from the degree-zero part of `A[X]` to the degree-zero part of the localization of `A[X]`
away from `X` is bijective. -/
lemma bijective_fromZeroRingHom_X :
    Function.Bijective (fromZeroRingHom (homogeneousSubmodule n A)
      (Submonoid.powers (X (default : n)))) := by
  have hX : ∀ i : n, (X i : MvPolynomial n A) ∈ homogeneousSubmodule n A 1 :=
    fun i ↦ isHomogeneous_X A i
  constructor
  · have hle : Submonoid.powers (X (default : n)) ≤ nonZeroDivisors (MvPolynomial n A) :=
      Submonoid.powers_le.mpr (isRegular_iff_mem_nonZeroDivisors.mp isRegular_X)
    have hinj : Function.Injective (algebraMap (MvPolynomial n A)
        (Localization (Submonoid.powers (X default : MvPolynomial n A)))) :=
      IsLocalization.injective
        (S := Localization (Submonoid.powers (X default : MvPolynomial n A))) hle
    intro a b hab
    refine Subtype.ext (hinj ?_)
    rw [← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap]
    exact congrArg HomogeneousLocalization.val hab
  · intro y
    have hgen := Away.adjoin_mk_prod_pow_eq_top (𝒜 := homogeneousSubmodule n A) (hX default)
      n (X : n → MvPolynomial n A) (adjoin_range_X_eq_top n A) (fun _ ↦ 1) hX
    have hbot : (⊤ : Subalgebra (homogeneousSubmodule n A 0)
        (Away (homogeneousSubmodule n A) (X (default : n)))) ≤ ⊥ := by
      rw [← hgen]
      refine Algebra.adjoin_le ?_
      rintro _ ⟨a, ai, hai, -, rfl⟩
      have hprod : (∏ i, (X i : MvPolynomial n A) ^ ai i) = X (default : n) ^ a := by
        rw [Fintype.prod_unique]
        congr 1
        simpa using hai
      refine Algebra.mem_bot.mpr ⟨1, ?_⟩
      rw [map_one]
      refine HomogeneousLocalization.val_injective _ ?_
      rw [HomogeneousLocalization.val_one, Away.val_mk, hprod]
      exact (Localization.mk_self_mk _ _).symm
    exact Algebra.mem_bot.mp (hbot Algebra.mem_top)

end MvPolynomial

namespace AlgebraicGeometry

section Affine

attribute [local instance] MvPolynomial.gradedAlgebra

variable (n : Type u) (A : Type u) [CommRing A] [Unique n]

/-- For a single homogeneous coordinate `X`, the standard open `D₊(X)` is all of
`Proj A[X]`, since the irrelevant ideal is generated by `X`. -/
lemma Proj.basicOpen_X_eq_top :
    Proj.basicOpen (MvPolynomial.homogeneousSubmodule n A) (MvPolynomial.X default) = ⊤ := by
  have := Proj.iSup_basicOpen_eq_top' (MvPolynomial.homogeneousSubmodule n A)
    (MvPolynomial.X : n → MvPolynomial n A)
    (fun i ↦ ⟨1, MvPolynomial.isHomogeneous_X A i⟩)
    (MvPolynomial.adjoin_range_X_eq_top n A)
  rwa [iSup_unique] at this

/-- **Projective space on one homogeneous coordinate is its base**: for a one-element index
type `n`, the structure morphism `ℙ^n_A ⟶ Spec A` is an isomorphism. -/
instance Proj.instIsIsoProjectiveSpaceOverAffineToSpec :
    IsIso (Proj.projectiveSpaceOverAffineToSpec n A) := by
  have : IsIso (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule n A)) :=
    Proj.isIso_toSpecZero _ (MvPolynomial.isHomogeneous_X A (default : n)) one_pos
      (Proj.basicOpen_X_eq_top n A) (MvPolynomial.bijective_fromZeroRingHom_X n A)
  have : IsIso (CommRingCat.ofHom
      (MvPolynomial.homogeneousSubmoduleZeroEquiv n A).toRingHom) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr
      (MvPolynomial.homogeneousSubmoduleZeroEquiv n A).bijective
  rw [Proj.projectiveSpaceOverAffineToSpec]
  infer_instance

/-- **Projective space on one homogeneous coordinate is its base**: for a one-element index
type `n`, the structure morphism exhibits `ℙ^n_A` as `Spec A`. -/
def Proj.projectiveSpaceOverAffineIsoSpec :
    Proj.projectiveSpaceOverAffine n A ≅ Spec (.of A) :=
  asIso (Proj.projectiveSpaceOverAffineToSpec n A)

@[simp]
lemma Proj.projectiveSpaceOverAffineIsoSpec_hom :
    (Proj.projectiveSpaceOverAffineIsoSpec n A).hom =
      Proj.projectiveSpaceOverAffineToSpec n A :=
  rfl

end Affine

namespace ProjectiveSpace

variable (n : Type u) [Unique n] (S : Scheme.{u})

/-- **`ℙ(n; S)` is `S` on one homogeneous coordinate**: for a one-element index type `n`, the
structure morphism `ℙ(n; S) ↘ S` is an isomorphism, being the base change of the isomorphism
`ℙ^n_ℤ ⟶ Spec ℤ` along the structure morphism of `S`. -/
instance instIsIso : IsIso (ℙ(n; S) ↘ S) := by
  have hP : terminal.from (Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ)) =
      Proj.projectiveSpaceOverAffineToSpec n (ULift.{u} ℤ) ≫ terminal.from _ := terminal.hom_ext _ _
  have hZ : terminal.from (Spec (.of (ULift.{u} ℤ))) =
      (specULiftZIsTerminal.uniqueUpToIso terminalIsTerminal).hom := terminal.hom_ext _ _
  have : IsIso (terminal.from (Spec (.of (ULift.{u} ℤ)))) := hZ ▸ inferInstance
  have : IsIso (terminal.from (Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ))) :=
    hP ▸ inferInstance
  exact inferInstanceAs (IsIso (pullback.fst _ _))

end ProjectiveSpace

end AlgebraicGeometry
