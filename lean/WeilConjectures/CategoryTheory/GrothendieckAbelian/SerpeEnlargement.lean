module

public import WeilConjectures.CategoryTheory.GrothendieckAbelian.AcyclicSwallowing
public import WeilConjectures.CategoryTheory.GrothendieckAbelian.GeneratingMonoQuasiIsos
public import WeilConjectures.FromJoel.Algebra.Homology.DerivedCategory.DerivabilityStructureKInjectives
public import WeilConjectures.Mathlib.CategoryTheory.Abelian.Subobject

/-!
# The Serpé enlargement step

Let `C` be a Grothendieck abelian category, `G : C` a separator and `κ` a regular cardinal
dominating `ℵ₀` and the cardinalities of the subobject lattices of the finite copowers of `G`.
Let `B` be a cochain complex in `C` and let `D` be a subobject of `B` whose inclusion is a
quasi-isomorphism. We show that if `D ≠ ⊤`, then `D` can be strictly enlarged to a subobject
`D'` which is again quasi-isomorphic to `B`, in such a way that the inclusion `D ⟶ D'` is a
pushout of a morphism of the generating family `CochainComplex.generatingMonoQuasiIsos G κ`.

This is the inductive step of Serpé's construction of the generating set of the injective model
structure on cochain complexes, and it is the analogue for quasi-isomorphisms of
`CategoryTheory.IsGrothendieckAbelian.IsDetecting.exists_larger_subobject`.

The argument runs as follows. The quotient `Q := B / D` is acyclic, and since `D ≠ ⊤` it is
nonzero, so some morphism `v : G ⟶ B.X n` has a nonzero image in `Q`. The subcomplex `T₀` of `B`
generated by the image of `v` is degreewise `κ`-generated and is not contained in `D`, hence so
is its image `S` in `Q`; the swallowing lemma
`CochainComplex.exists_acyclic_degreewiseCardinalGenerated_le` engulfs `S` in a degreewise
`κ`-generated *acyclic* subobject `V` of `Q`, and the cover lemma
`CategoryTheory.exists_isCardinalGenerated_subobject_of_epi` lifts `V` degreewise to a degreewise
`κ`-generated subobject `T` of `B` with image exactly `V`. Then `D' := D ⊔ T` works: the
inclusion `D ⊓ T ⟶ T` has cokernel `V`, hence is a quasi-isomorphism with degreewise
`κ`-generated target, and the square `(D ⊓ T, D, T, D ⊔ T)` is a pushout.

## Main results

- `CochainComplex.exists_larger_subobject_quasiIso`: the enlargement step.
-/

@[expose] public section

universe w v u

namespace CochainComplex

open CategoryTheory Limits HomologicalComplex

variable {C : Type u} [Category.{v} C] [Abelian C] [IsGrothendieckAbelian.{w} C]
  (G : C) (κ : Cardinal.{w})

section Generated

/-- The generator is `κ`-generated. -/
private lemma isCardinalGenerated_self (hκ : Cardinal.aleph0 < κ) :
    isCardinalGenerated G κ G := by
  have : IsSplitEpi (Sigma.desc (fun (_ : PUnit.{w + 1}) ↦ 𝟙 G)) :=
    ⟨⟨Sigma.ι (fun (_ : PUnit.{w + 1}) ↦ G) ⟨⟩, by simp⟩⟩
  exact ⟨PUnit.{w + 1}, hasCardinalLT_of_finite _ _ hκ.le,
    Sigma.desc (fun (_ : PUnit.{w + 1}) ↦ 𝟙 G), inferInstance⟩

/-- The subcomplex of `B` generated by the image of a morphism `v : G ⟶ B.X n` is degreewise
`κ`-generated, and its part in degree `n` contains the image of `v`. -/
private lemma exists_degreewiseCardinalGenerated_subobject [Fact κ.IsRegular]
    (hκ : Cardinal.aleph0 < κ) {B : CochainComplex C ℤ} {n : ℤ} (v : G ⟶ B.X n) :
    ∃ T : Subobject B, degreewiseCardinalGenerated G κ (T : CochainComplex C ℤ) ∧
      imageSubobject v ≤ subobjectEval B n T := by
  classical
  refine ⟨subcomplexClosure B (fun m ↦ imageSubobject
      (if h : m = n then v ≫ eqToHom (congrArg B.X h.symm) else 0)),
    degreewiseCardinalGenerated_subcomplexClosure G κ _ (fun m ↦ ?_), ?_⟩
  · exact isCardinalGenerated_of_epi G κ (factorThruImageSubobject _)
      (isCardinalGenerated_self G κ hκ)
  · refine le_trans (le_of_eq ?_) (le_subcomplexClosure B _ n)
    simp

end Generated

/-- **The Serpé enlargement step.** Let `D` be a subobject of a cochain complex `B` whose
inclusion is a quasi-isomorphism. If `D ≠ ⊤`, there is a strictly larger subobject `D'` whose
inclusion is again a quasi-isomorphism and such that `D ⟶ D'` is a pushout of a morphism of
the generating family `CochainComplex.generatingMonoQuasiIsos G κ`. -/
lemma exists_larger_subobject_quasiIso [Fact κ.IsRegular] (hκ : Cardinal.aleph0 < κ)
    (hG : IsSeparator G)
    (hsub : ∀ n : ℕ, HasCardinalLT (Subobject (∐ (fun (_ : Fin n) ↦ G))) κ)
    {B : CochainComplex C ℤ} (D : Subobject B) [QuasiIso D.arrow] (hD : D ≠ ⊤) :
    ∃ (D' : Subobject B) (h : D < D'), QuasiIso D'.arrow ∧
      (generatingMonoQuasiIsos G κ).pushouts (Subobject.ofLE D D' h.le) := by
  classical
  -- Step 1: the quotient `B / D` is acyclic.
  have hQ : (cokernel D.arrow).Acyclic :=
    (Abelian.quasiIso_f_iff_of_shortExact
      (S := ShortComplex.mk D.arrow (cokernel.π D.arrow) (cokernel.condition _))
      { exact := ShortComplex.exact_cokernel _ }).1 inferInstance
  -- Step 2: since `D ≠ ⊤`, some morphism `G ⟶ B.X n` has a nonzero image in `B / D`.
  have hπ : cokernel.π D.arrow ≠ 0 := fun h ↦ hD (by
    have := Abelian.epi_of_cokernel_π_eq_zero D.arrow h
    have : IsIso D.arrow := isIso_of_mono_of_epi _
    exact Subobject.eq_top_of_isIso_arrow D)
  obtain ⟨n, hn⟩ : ∃ n : ℤ, (cokernel.π D.arrow).f n ≠ 0 := by
    by_contra hc
    simp only [not_exists, ne_eq, not_not] at hc
    exact hπ (by ext m; simp [hc m])
  obtain ⟨v, hv⟩ : ∃ v : G ⟶ B.X n, v ≫ (cokernel.π D.arrow).f n ≠ 0 := by
    by_contra hc
    simp only [not_exists, ne_eq, not_not] at hc
    exact hn (hG.def _ _ (fun t ↦ by simp [hc t]))
  obtain ⟨T₀, hT₀gen, hT₀le⟩ := exists_degreewiseCardinalGenerated_subobject G κ hκ v
  have hT₀D : ¬ (T₀ ≤ D) := fun hle ↦ hv (by
    obtain ⟨a, ha⟩ : ∃ a, a ≫ (subobjectEval B n D).arrow = v :=
      ⟨_, Subobject.factorThru_arrow _ _ ((Subobject.imageSubobject_le_iff v _).1
        (hT₀le.trans (monotone_subobjectEval B n hle)))⟩
    rw [← ha, Category.assoc, ← subobjectEvalUnderlyingIso_hom_comp_arrow D, Category.assoc,
      ← HomologicalComplex.comp_f, cokernel.condition]
    simp)
  -- Step 3: the image of `T₀` in `B / D` is degreewise `κ`-generated.
  have hSgen : degreewiseCardinalGenerated G κ
      ((((Subobject.«exists» (cokernel.π D.arrow)).obj T₀ :
        Subobject (cokernel D.arrow)) : CochainComplex C ℤ)) := by
    obtain ⟨e, he, -⟩ := Subobject.exists_fac (cokernel.π D.arrow) T₀
    have := he
    exact degreewiseCardinalGenerated_of_epi G κ e hT₀gen
  -- Step 4: it is swallowed by an acyclic degreewise `κ`-generated subobject `V` of `B / D`.
  obtain ⟨V, hSV, hVgen, hVac⟩ :=
    exists_acyclic_degreewiseCardinalGenerated_le G κ hκ hG hsub hQ _ hSgen
  -- Step 5: cover `V` degreewise inside `B`, and close under the differential.
  have hVgen' : ∀ m : ℤ,
      isCardinalGenerated G κ ((subobjectEval (cokernel D.arrow) m V : C)) := fun m ↦
    (isCardinalGenerated G κ).prop_of_iso (subobjectEvalUnderlyingIso (n := m) V).symm (hVgen m)
  choose W hWgen hWe using fun m : ℤ ↦ exists_isCardinalGenerated_subobject_of_epi G κ hκ hG
    hsub ((cokernel.π D.arrow).f m) (subobjectEval (cokernel D.arrow) m V) (hVgen' m)
  obtain ⟨T, hTgen, hTV⟩ : ∃ T : Subobject B,
      degreewiseCardinalGenerated G κ (T : CochainComplex C ℤ) ∧
        (Subobject.«exists» (cokernel.π D.arrow)).obj T = V := by
    refine ⟨subcomplexClosure B W, degreewiseCardinalGenerated_subcomplexClosure G κ W hWgen,
      subobjectEval_injective (funext fun m ↦ ?_)⟩
    have key : (Subobject.«exists» ((cokernel.π D.arrow).f m)).obj
        ((Subobject.«exists» (B.d (m - 1) m)).obj (W (m - 1))) ≤
          subobjectEval (cokernel D.arrow) m V := by
      rw [Subobject.exists_obj_comp, ← (cokernel.π D.arrow).comm (m - 1) m,
        ← Subobject.exists_obj_comp, hWe]
      exact exists_subobjectEval_le V (m - 1) m
    change subobjectEval _ m _ = subobjectEval _ m V
    rw [subobjectEval_exists, subobjectEval_subcomplexClosure, Subobject.exists_obj_sup, hWe m]
    exact sup_eq_left.2 key
  -- Step 6: `D ⊔ T` is strictly larger than `D`.
  have hstrict : D ≠ D ⊔ T := by
    intro heq
    refine hT₀D ?_
    rw [heq]
    exact Subobject.le_sup_of_exists_obj_le D T₀ T (by rw [hTV]; exact hSV)
  -- Step 7: `D ⊓ T ⟶ T` is a mono quasi-isomorphism with degreewise `κ`-generated target.
  have hac : (cokernel (Subobject.ofLE (D ⊓ T) T inf_le_right)).Acyclic :=
    hVac.of_iso (Subobject.cokernelOfLEIsoExistsObj D T ≪≫ Subobject.isoOfEq _ _ hTV).symm
  have hqi₀ : QuasiIso (Subobject.ofLE (D ⊓ T) T inf_le_right) :=
    (Abelian.quasiIso_f_iff_of_shortExact
      (S := ShortComplex.mk (Subobject.ofLE (D ⊓ T) T inf_le_right)
        (cokernel.π _) (cokernel.condition _))
      { exact := ShortComplex.exact_cokernel _ }).2 hac
  obtain ⟨Y₁, Y₂, i₀, hi₀, ⟨e⟩⟩ := generatingMonoQuasiIsos_isoClosure
    (Subobject.ofLE (D ⊓ T) T inf_le_right) hTgen
  -- Step 8: the inf/sup square exhibits `D ⟶ D ⊔ T` as a pushout of `i₀`.
  have hpush : (generatingMonoQuasiIsos G κ).pushouts
      (Subobject.ofLE D (D ⊔ T) le_sup_left) := by
    have h₁ : IsIso e.hom.left := inferInstanceAs (IsIso (Arrow.leftFunc.mapIso e).hom)
    have h₂ : IsIso e.hom.right := inferInstanceAs (IsIso (Arrow.rightFunc.mapIso e).hom)
    refine ⟨Y₁, Y₂, i₀, e.hom.left ≫ Subobject.ofLE (D ⊓ T) D inf_le_left,
      e.hom.right ≫ Subobject.ofLE T (D ⊔ T) le_sup_right, hi₀, ?_⟩
    exact (Subobject.isPushout_inf_sup D T).of_iso' (asIso e.hom.left) (Iso.refl _)
      (asIso e.hom.right) (Iso.refl _) (by simp) (by simp) (by simp) (by simp)
  -- Step 9: the inclusion of `D ⊔ T` is again a quasi-isomorphism.
  have hqi₁ : QuasiIso (Subobject.ofLE D (D ⊔ T) le_sup_left) :=
    (Abelian.quasiIso_f_iff_of_shortExact
      (S := ShortComplex.mk (Subobject.ofLE D (D ⊔ T) le_sup_left)
        (cokernel.π _) (cokernel.condition _))
      { exact := ShortComplex.exact_cokernel _ }).2 (hac.of_iso (Subobject.noetherIso D T))
  have hqi₂ : QuasiIso (Subobject.ofLE D (D ⊔ T) le_sup_left ≫ (D ⊔ T).arrow) := by
    rw [Subobject.ofLE_arrow]
    infer_instance
  exact ⟨D ⊔ T, lt_of_le_of_ne le_sup_left hstrict,
    quasiIso_of_comp_left (Subobject.ofLE D (D ⊔ T) le_sup_left) _, hpush⟩

end CochainComplex
