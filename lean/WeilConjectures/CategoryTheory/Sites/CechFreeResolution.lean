/-!
# The free resolution attached to a family of morphisms

Let `X` be an object of a category `C` and `U : ι → Over X` a family of objects over `X` (with
`ι : Type w`). For `n : ℕ` let `ℤ_𝔘[n]` be the presheaf of abelian groups on `C` freely
generated by the pairs `(y, g)` of a tuple `y : Fin (n + 1) → ι` and a morphism
`g : T ⟶ U (y 0) ×_X ⋯ ×_X U (y n)`. With the alternating sums of the face maps these form a
complex `⋯ ⟶ ℤ_𝔘[1] ⟶ ℤ_𝔘[0] ⟶ ℤ[yoneda X]` of presheaves of abelian groups in the universe
`max v w` (the presheaf of sets `yoneda X` is lifted to `Type (max v w)`), which is exact in
degrees `≥ 0`: over every object `T` it is contracted by inserting, in front of a tuple
`(y, g)`, a lift of `T ⟶ X` to one of the `U a`, chosen depending only on `T ⟶ X`.

Morphisms from `ℤ_𝔘[n]` to a presheaf `P` are the Čech cochains of degree `n` of `P`, so this
complex is used to prove that Čech complexes of injective presheaves are exact.

## Main definitions

- `CategoryTheory.Presheaf.cechFree U n`: the presheaf `ℤ_𝔘[n]`.
- `CategoryTheory.Presheaf.cechFreeD U n : ℤ_𝔘[n + 1] ⟶ ℤ_𝔘[n]`: the differential.
- `CategoryTheory.Presheaf.cechFreeAug U : ℤ_𝔘[0] ⟶ ℤ[yoneda X]`: the augmentation.

## Main statements

- `CategoryTheory.Presheaf.exact_cechFreeD`: exactness in positive degrees.
- `CategoryTheory.Presheaf.exact_cechFreeAug`: exactness in degree `0`.
-/

@[expose] public section

universe w v u

open CategoryTheory Limits Opposite

namespace CategoryTheory.Presheaf

variable {C : Type u} [Category.{v} C] {X : C} [HasFiniteProducts (Over X)] {ι : Type w}
  (U : ι → Over X)

/-- The presheaf of sets `T ↦ {(y, g) | y : Fin (n + 1) → ι, g : T ⟶ U (y 0) ×_X ⋯ ×_X U (y n)}`.
-/
@[simps]
noncomputable def cechNerveSigma (n : ℕ) : Cᵒᵖ ⥤ Type (max v w) where
  obj T := Σ y : Fin (n + 1) → ι, T.unop ⟶ (cechNerveObj U y).left
  map f := ↾fun s ↦ ⟨s.1, f.unop ≫ s.2⟩
  map_id _ := TypeCat.homEquiv.injective (funext fun s ↦
    Sigma.ext rfl (heq_of_eq (Category.id_comp s.2)))
  map_comp _ _ := TypeCat.homEquiv.injective (funext fun s ↦
    Sigma.ext rfl (heq_of_eq (Category.assoc _ _ s.2)))

/-- The map `(y, g) ↦ (y ∘ θ, g ≫ (U_y ⟶ U_{y ∘ θ}))` of `cechNerveSigma` induced by
`θ : Fin (m + 1) → Fin (n + 1)`. -/
@[simps]
noncomputable def cechNerveSigmaMap {m n : ℕ} (θ : Fin (m + 1) → Fin (n + 1)) :
    cechNerveSigma U n ⟶ cechNerveSigma U m where
  app _ := ↾fun s ↦ ⟨s.1 ∘ θ, s.2 ≫ (cechNerveMap U s.1 θ).left⟩
  naturality _ _ _ := TypeCat.homEquiv.injective (funext fun _ ↦
    Sigma.ext rfl (heq_of_eq (Category.assoc _ _ _)))

lemma cechNerveSigmaMap_app_apply {m n : ℕ} (θ : Fin (m + 1) → Fin (n + 1)) (T : Cᵒᵖ)
    (s : (cechNerveSigma U n).obj T) :
    (cechNerveSigmaMap U θ).app T s = ⟨s.1 ∘ θ, s.2 ≫ (cechNerveMap U s.1 θ).left⟩ :=
  rfl

lemma cechNerveSigmaMap_id (n : ℕ) : cechNerveSigmaMap U (n := n) id = 𝟙 _ := by
  ext T : 2
  refine TypeCat.homEquiv.injective (funext fun s ↦ Sigma.ext rfl (heq_of_eq ?_))
  change s.2 ≫ (cechNerveMap U s.1 id).left = s.2
  rw [cechNerveMap_id, Over.id_left, Category.comp_id]

lemma cechNerveSigmaMap_comp {m n p : ℕ} (θ : Fin (m + 1) → Fin (n + 1))
    (θ' : Fin (n + 1) → Fin (p + 1)) :
    cechNerveSigmaMap U (θ' ∘ θ) = cechNerveSigmaMap U θ' ≫ cechNerveSigmaMap U θ := by
  ext T : 2
  refine TypeCat.homEquiv.injective (funext fun s ↦ Sigma.ext rfl (heq_of_eq ?_))
  change s.2 ≫ (cechNerveMap U s.1 (θ' ∘ θ)).left =
    (s.2 ≫ (cechNerveMap U s.1 θ').left) ≫ (cechNerveMap U (s.1 ∘ θ') θ).left
  rw [← cechNerveMap_comp, Over.comp_left, Category.assoc]

/-- The `i`-th face map of `cechNerveSigma`, forgetting the `i`-th member of the tuple. -/
noncomputable abbrev cechNerveSigmaFace (n : ℕ) (i : Fin (n + 2)) :
    cechNerveSigma U (n + 1) ⟶ cechNerveSigma U n :=
  cechNerveSigmaMap U i.succAbove

/-- The augmentation `(y, g) ↦ g ≫ (U (y 0) ⟶ X)`. -/
@[simps]
noncomputable def cechNerveSigmaAug : cechNerveSigma U 0 ⟶ yoneda.obj X ⋙ uliftFunctor.{w} where
  app T := ↾fun s ↦ ULift.up (s.2 ≫ (cechNerveObj U s.1).hom)
  naturality T T' f := by
    ext s
    simp

/-- The free abelian presheaf `ℤ_𝔘[n]` on `cechNerveSigma U n`. -/
noncomputable abbrev cechFree (n : ℕ) : Cᵒᵖ ⥤ AddCommGrpCat.{max v w} :=
  cechNerveSigma U n ⋙ AddCommGrpCat.free

/-- The simplicial presheaf `[n] ↦ ℤ_𝔘[n]`. -/
@[simps]
noncomputable def cechFreeSimplicial : SimplicialObject (Cᵒᵖ ⥤ AddCommGrpCat.{max v w}) where
  obj n := cechFree U n.unop.len
  map θ := Functor.whiskerRight (cechNerveSigmaMap U θ.unop.toOrderHom) AddCommGrpCat.free
  map_id n := by
    rw [← Functor.whiskerRight_id']
    exact congrArg (fun φ ↦ Functor.whiskerRight φ AddCommGrpCat.free) (cechNerveSigmaMap_id U _)
  map_comp θ θ' := by
    rw [← Functor.whiskerRight_comp]
    exact congrArg (fun φ ↦ Functor.whiskerRight φ AddCommGrpCat.free)
      (cechNerveSigmaMap_comp U θ'.unop.toOrderHom θ.unop.toOrderHom)

/-- The differential `ℤ_𝔘[n + 1] ⟶ ℤ_𝔘[n]`, the alternating sum of the face maps. -/
noncomputable def cechFreeD (n : ℕ) : cechFree U (n + 1) ⟶ cechFree U n :=
  AlgebraicTopology.AlternatingFaceMapComplex.objD (cechFreeSimplicial U) n

lemma cechFreeD_eq (n : ℕ) : cechFreeD U n =
  ∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) •
    Functor.whiskerRight (cechNerveSigmaFace U n i) AddCommGrpCat.free :=
  rfl

@[reassoc (attr := simp)]
lemma cechFreeD_comp_cechFreeD (n : ℕ) : cechFreeD U (n + 1) ≫ cechFreeD U n = 0 :=
  AlgebraicTopology.AlternatingFaceMapComplex.d_squared _ n

/-- The augmentation `ℤ_𝔘[0] ⟶ ℤ[yoneda X]`. -/
noncomputable def cechFreeAug :
    cechFree U 0 ⟶ yoneda.obj X ⋙ uliftFunctor.{w} ⋙ AddCommGrpCat.free :=
  Functor.whiskerRight (cechNerveSigmaAug U) AddCommGrpCat.free

lemma cechFreeD_app_of (n : ℕ) (T : Cᵒᵖ) (s : (cechNerveSigma U (n + 1)).obj T) :
    (cechFreeD U n).app T (FreeAbelianGroup.of s) =
      ∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) •
        FreeAbelianGroup.of ((cechNerveSigmaFace U n i).app T s) := by
  rw [cechFreeD_eq, NatTrans.app_sum, AddCommGrpCat.sum_apply]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [NatTrans.app_zsmul]
  change ((-1 : ℤ) ^ (i : ℕ) • AddCommGrpCat.ofHom (FreeAbelianGroup.map _)).hom _ = _
  rw [AddCommGrpCat.hom_zsmul, AddMonoidHom.smul_apply]
  erw [FreeAbelianGroup.map_of_apply]

lemma cechFreeAug_app_of (T : Cᵒᵖ) (s : (cechNerveSigma U 0).obj T) :
    (cechFreeAug U).app T (FreeAbelianGroup.of s) =
      FreeAbelianGroup.of (ULift.up (s.2 ≫ (cechNerveObj U s.1).hom)) := by
  erw [FreeAbelianGroup.map_of_apply]
  rfl

/-- Two elements of `cechNerveSigma` attached to equal tuples are equal when their morphisms agree
after transport along the equality. This is the form of the face identities used below. -/
lemma cechNerveSigma_face_eq {Z : C} {f : Z ⟶ X} {m k : ℕ} {y : Fin (m + 1) → ι}
    (G : Over.mk f ⟶ cechNerveObj U y) (θ : Fin (k + 1) → Fin (m + 1)) {y' : Fin (k + 1) → ι}
    (h : y ∘ θ = y') (G' : Over.mk f ⟶ cechNerveObj U y')
    (hG : ∀ l, G ≫ Pi.π _ (θ l) ≫ eqToHom (congrArg U (congrFun h l)) = G' ≫ Pi.π _ l) :
    (⟨y ∘ θ, G.left ≫ (cechNerveMap U y θ).left⟩ :
      (cechNerveSigma U k).obj (op Z)) = ⟨y', G'.left⟩ := by
  subst h
  congr 1
  rw [← Over.comp_left]
  congr 1
  refine Pi.hom_ext _ _ fun l ↦ ?_
  rw [Category.assoc, ← hG]
  erw [Pi.lift_π]
  simp

variable {U}

/-- The contracting homotopy `ℤ_𝔘[n](T) ⟶ ℤ_𝔘[n + 1](T)`: a generator `(y, g)` is sent to
`(a :: y, (λ, g))` where `λ : T ⟶ U a` is a chosen lift of `g ≫ (U_y ⟶ X)`. -/
noncomputable def cechFreeHomotopy (n : ℕ) (T : Cᵒᵖ) :
    (cechFree U n).obj T →+ (cechFree U (n + 1)).obj T := by
  classical exact
  FreeAbelianGroup.lift fun s ↦
    if h : ∃ a, Nonempty (Over.mk (s.2 ≫ (cechNerveObj U s.1).hom) ⟶ U a) then
      FreeAbelianGroup.of ⟨Fin.cons h.choose s.1,
        (cechNerveCons U h.choose_spec.some (Over.homMk s.2)).left⟩
    else 0

lemma cechFreeHomotopy_of {n : ℕ} {T : Cᵒᵖ} (y : Fin (n + 1) → ι)
    (g : T.unop ⟶ (cechNerveObj U y).left) (f : T.unop ⟶ X)
    (hf : g ≫ (cechNerveObj U y).hom = f) (h : ∃ a, Nonempty (Over.mk f ⟶ U a)) :
    cechFreeHomotopy n T (FreeAbelianGroup.of ⟨y, g⟩) =
      FreeAbelianGroup.of ⟨Fin.cons h.choose y,
        (cechNerveCons U h.choose_spec.some (Over.homMk g hf)).left⟩ := by
  subst hf
  rw [cechFreeHomotopy]
  erw [FreeAbelianGroup.lift_apply_of]
  rw [dif_pos h]

/-- The contracting homotopy `ℤ[yoneda X](T) ⟶ ℤ_𝔘[0](T)` in degree `-1`. -/
noncomputable def cechFreeAugHomotopy (T : Cᵒᵖ) :
    (yoneda.obj X ⋙ uliftFunctor.{w} ⋙ AddCommGrpCat.free).obj T →+ (cechFree U 0).obj T := by
  classical exact
  FreeAbelianGroup.lift fun f ↦
    if h : ∃ a, Nonempty (Over.mk f.down ⟶ U a) then
      FreeAbelianGroup.of ⟨fun _ ↦ h.choose,
        (Pi.lift (fun _ ↦ h.choose_spec.some) :
          Over.mk f.down ⟶ cechNerveObj U (fun _ : Fin 1 ↦ h.choose)).left⟩
    else 0

lemma exists_lift_of_cechNerveSigma {n : ℕ} {T : Cᵒᵖ} (y : Fin (n + 1) → ι)
    (g : T.unop ⟶ (cechNerveObj U y).left) :
    ∃ a, Nonempty (Over.mk (g ≫ (cechNerveObj U y).hom) ⟶ U a) :=
  ⟨y 0, ⟨Over.homMk g ≫ Pi.π _ 0⟩⟩

/-- The homotopy identity `d h + h d = 1` in degree `n + 1`. -/
lemma cechFreeD_homotopy (n : ℕ) (T : Cᵒᵖ) (x : (cechFree U (n + 1)).obj T) :
    (cechFreeD U (n + 1)).app T (cechFreeHomotopy (n + 1) T x) +
      cechFreeHomotopy n T ((cechFreeD U n).app T x) = x := by
  induction x using FreeAbelianGroup.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, map_zero, add_zero]
  | add x x' hx hx' =>
    rw [map_add, map_add, map_add, map_add, add_add_add_comm, hx, hx']
  | neg x hx =>
    rw [map_neg, map_neg, map_neg, map_neg, ← neg_add, hx]
  | of s =>
    obtain ⟨y, g⟩ := s
    set f := g ≫ (cechNerveObj U y).hom with hf
    have hex := exists_lift_of_cechNerveSigma y g
    set J := hex.choose
    set Λ : Over.mk f ⟶ U J := hex.choose_spec.some
    let G : Over.mk f ⟶ cechNerveObj U (Fin.cons J y : Fin (n + 3) → ι) :=
      cechNerveCons U Λ (Over.homMk g)
    rw [cechFreeHomotopy_of y g f hf.symm hex, cechFreeD_app_of, cechFreeD_app_of, map_sum,
      Fin.sum_univ_succ]
    -- the first face is `(y, g)`
    have e₀ : (cechNerveSigmaFace U (n + 1) 0).app T ⟨Fin.cons J y, G.left⟩ = ⟨y, g⟩ :=
      cechNerveSigma_face_eq U G _ (by funext l; simp) (Over.homMk g) fun l ↦
        cechNerveCons_π_of_eq_succ U Λ _ _ l (by simp) _
    -- the other faces are the homotopy applied to the faces of `(y, g)`
    have e (i : Fin (n + 2)) : FreeAbelianGroup.of
        ((cechNerveSigmaFace U (n + 1) i.succ).app T ⟨Fin.cons J y, G.left⟩) =
        cechFreeHomotopy n T (FreeAbelianGroup.of
          ⟨y ∘ i.succAbove, g ≫ (cechNerveMap U y i.succAbove).left⟩) := by
      rw [cechFreeHomotopy_of (y ∘ i.succAbove) _ f (by simp [hf]) hex]
      congr 1
      refine cechNerveSigma_face_eq U G _
        (by funext l; cases l using Fin.cases with | zero => rfl | succ l => simp) _ fun l ↦ ?_
      cases l using Fin.cases with
      | zero =>
        exact (cechNerveCons_π_of_eq_zero U Λ _ _ (by simp) _).trans
          (cechNerveCons_π_zero U _ _).symm
      | succ l =>
        refine (cechNerveCons_π_of_eq_succ U Λ _ _ (i.succAbove l) (by simp) _).trans ?_
        rw [cechNerveCons_π_succ]
        ext1
        simp only [Over.comp_left, Over.homMk_left, Category.assoc]
        rw [← Over.comp_left]
        erw [Pi.lift_π]
    rw [e₀]
    simp only [cechNerveSigmaMap_app_apply] at e ⊢
    rw [Fin.val_zero, pow_zero, one_smul, add_assoc, add_eq_left, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun x _ ↦ ?_
    rw [map_zsmul, ← e x, Fin.val_succ, pow_succ, mul_neg_one, neg_smul]
    exact neg_add_cancel _

lemma cechFreeAugHomotopy_of {T : Cᵒᵖ} (f : T.unop ⟶ X) (h : ∃ a, Nonempty (Over.mk f ⟶ U a)) :
    cechFreeAugHomotopy T (FreeAbelianGroup.of (ULift.up f)) =
      FreeAbelianGroup.of ⟨fun _ ↦ h.choose, (Pi.lift (fun _ ↦ h.choose_spec.some) :
        Over.mk f ⟶ cechNerveObj U (fun _ : Fin 1 ↦ h.choose)).left⟩ := by
  rw [cechFreeAugHomotopy]
  erw [FreeAbelianGroup.lift_apply_of]
  rw [dif_pos h]

/-- The homotopy identity `d h + h ε = 1` in degree `0`. -/
lemma cechFreeD_homotopy_zero (T : Cᵒᵖ) (x : (cechFree U 0).obj T) :
    (cechFreeD U 0).app T (cechFreeHomotopy 0 T x) +
      cechFreeAugHomotopy T ((cechFreeAug U).app T x) = x := by
  induction x using FreeAbelianGroup.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, map_zero, add_zero]
  | add x x' hx hx' =>
    rw [map_add, map_add, map_add, map_add, add_add_add_comm, hx, hx']
  | neg x hx =>
    rw [map_neg, map_neg, map_neg, map_neg, ← neg_add, hx]
  | of s =>
    obtain ⟨y, g⟩ := s
    set f := g ≫ (cechNerveObj U y).hom with hf
    have hex := exists_lift_of_cechNerveSigma y g
    set J := hex.choose
    set Λ : Over.mk f ⟶ U J := hex.choose_spec.some
    let G : Over.mk f ⟶ cechNerveObj U (Fin.cons J y : Fin 2 → ι) :=
      cechNerveCons U Λ (Over.homMk g)
    rw [cechFreeHomotopy_of y g f hf.symm hex, cechFreeD_app_of, Fin.sum_univ_two,
      cechFreeAug_app_of, cechFreeAugHomotopy_of _ hex]
    have e₀ : (cechNerveSigmaFace U 0 0).app T ⟨Fin.cons J y, G.left⟩ = ⟨y, g⟩ :=
      cechNerveSigma_face_eq U G _ (by funext l; simp) (Over.homMk g) fun l ↦
        cechNerveCons_π_of_eq_succ U Λ _ _ l (by simp) _
    have e₁ : (cechNerveSigmaFace U 0 1).app T ⟨Fin.cons J y, G.left⟩ =
        ⟨fun _ ↦ J, (Pi.lift (fun _ ↦ Λ) :
          Over.mk f ⟶ cechNerveObj U (fun _ : Fin 1 ↦ J)).left⟩ :=
      cechNerveSigma_face_eq U G _
        (by funext l; obtain rfl : l = 0 := Fin.fin_one_eq_zero l; rfl) _ fun l ↦ by
        obtain rfl : l = 0 := Fin.fin_one_eq_zero l
        exact (cechNerveCons_π_of_eq_zero U Λ _ _ (by rfl) _).trans
          (Pi.lift_π (fun _ : Fin 1 ↦ Λ) 0).symm
    rw [e₀, e₁]
    simp only [Fin.val_zero, pow_zero, one_smul, Fin.val_one, pow_one, neg_smul]
    rw [add_assoc]
    exact add_eq_left.2 (neg_add_cancel _)

/-- The augmentation vanishes on the image of the differential. -/
@[reassoc (attr := simp)]
lemma cechFreeD_comp_cechFreeAug : cechFreeD U 0 ≫ cechFreeAug U = 0 := by
  ext T : 2
  refine AddCommGrpCat.hom_ext (FreeAbelianGroup.lift_ext _ _ fun s ↦ ?_)
  obtain ⟨y, g⟩ := s
  change (cechFreeAug U).app T ((cechFreeD U 0).app T (FreeAbelianGroup.of ⟨y, g⟩)) = 0
  rw [cechFreeD_app_of, Fin.sum_univ_two, map_add, map_zsmul, map_zsmul, cechFreeAug_app_of,
    cechFreeAug_app_of]
  simp only [cechNerveSigmaMap_app_apply, Category.assoc, Over.w, Fin.val_zero, pow_zero,
    one_smul, Fin.val_one, pow_one, neg_smul, add_neg_cancel]

variable (U) in
/-- **Exactness of the free resolution in positive degrees.** -/
theorem exact_cechFreeD (n : ℕ) :
    (ShortComplex.mk (cechFreeD U (n + 1)) (cechFreeD U n)
      (cechFreeD_comp_cechFreeD U n)).Exact := by
  rw [ShortComplex.exact_iff_evaluation]
  intro T
  rw [ShortComplex.ab_exact_iff]
  intro x hx
  refine ⟨cechFreeHomotopy (n + 1) T x, ?_⟩
  have := cechFreeD_homotopy n T x
  change (cechFreeD U n).app T x = 0 at hx
  rw [hx, map_zero, add_zero] at this
  exact this

variable (U) in
/-- **Exactness of the free resolution in degree `0`.** -/
theorem exact_cechFreeAug :
    (ShortComplex.mk (cechFreeD U 0) (cechFreeAug U)
      (cechFreeD_comp_cechFreeAug (U := U))).Exact := by
  rw [ShortComplex.exact_iff_evaluation]
  intro T
  rw [ShortComplex.ab_exact_iff]
  intro x hx
  refine ⟨cechFreeHomotopy 0 T x, ?_⟩
  have := cechFreeD_homotopy_zero T x
  change (cechFreeAug U).app T x = 0 at hx
  rw [hx, map_zero, add_zero] at this
  exact this

end CategoryTheory.Presheaf
