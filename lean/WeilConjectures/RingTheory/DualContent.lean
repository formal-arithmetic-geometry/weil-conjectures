public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.IsTensorProduct
public import Mathlib.Tactic.Algebraize

/-!
# The dual content of a submodule

For a submodule `N` of an `R`-module `M`, its *dual content* is the ideal of `R` generated by
the values `φ m` of all linear forms `φ : M →ₗ[R] R` on elements `m ∈ N`. When `M` is
projective, it controls when `N` vanishes after base change: for an `R`-algebra `S`, the image
of `N` in `S ⊗[R] M` is zero if and only if the dual content of `N` vanishes in `S`. This is
the algebra behind the closedness of the locus where a finite locally free closed subscheme
lies in a given closed subscheme.

## Main definitions

- `Submodule.dualContent`: the dual content of a submodule.

## Main statements

- `IsBaseChange.forall_apply_eq_zero_iff`: a submodule of a projective module vanishes after
  base change if and only if its dual content does.
- `CommRingCat.map_eq_bot_iff_of_isPushout`: the version for ideals and pushout squares of
  commutative rings.
-/

@[expose] public section

universe u

open CategoryTheory

/-- The *dual content* of a submodule `N` of an `R`-module `M`: the ideal of `R` generated by
the values `φ m` of all linear forms `φ : Module.Dual R M` on all elements `m ∈ N`. -/
def Submodule.dualContent {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) : Ideal R :=
  Ideal.span {a | ∃ φ : Module.Dual R M, ∃ m ∈ N, φ m = a}

/-- For a base change `f : M → N` along `R → S` of a projective `R`-module `M`, an element
`m : M` maps to zero in `N` if and only if all its values under linear forms vanish in `S`. -/
theorem IsBaseChange.apply_eq_zero_iff_of_projective {R S M N : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
    [IsScalarTower R S N] {f : M →ₗ[R] N} (hf : IsBaseChange S f) [Module.Projective R M]
    (m : M) : f m = 0 ↔ ∀ φ : Module.Dual R M, algebraMap R S (φ m) = 0 := by
  refine ⟨fun h φ ↦ ?_, fun h ↦ ?_⟩
  · have := hf.lift_eq ((Algebra.linearMap R S).comp φ) m
    rw [h, map_zero] at this
    simpa using this.symm
  · obtain ⟨s, hs⟩ := Module.projective_def'.mp ‹Module.Projective R M›
    have hm : Finsupp.linearCombination R id (s m) = m := LinearMap.congr_fun hs m
    rw [← hm, Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
    refine Finset.sum_eq_zero fun x _ ↦ ?_
    rw [map_smul, ← algebraMap_smul S, ← Finsupp.lapply_apply (R := R) x (s m),
      ← LinearMap.comp_apply, h, zero_smul]

/-- For a base change `f : M → N` along `R → S` of a projective `R`-module `M`, a submodule
`P ⊆ M` maps to zero in `N` if and only if its dual content maps to zero in `S`. -/
theorem IsBaseChange.forall_apply_eq_zero_iff {R S M N : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
    [IsScalarTower R S N] {f : M →ₗ[R] N} (hf : IsBaseChange S f) [Module.Projective R M]
    (P : Submodule R M) :
    (∀ m ∈ P, f m = 0) ↔ P.dualContent.map (algebraMap R S) = ⊥ := by
  rw [Submodule.dualContent, Ideal.map_span, Ideal.span_eq_bot]
  simp only [Set.mem_image, Set.mem_ofPred_eq, forall_exists_index, and_imp]
  refine ⟨fun h _ a φ m hm hφ hb ↦ ?_, fun h m hm ↦ ?_⟩
  · rw [← hb, ← hφ]
    exact (hf.apply_eq_zero_iff_of_projective m).mp (h m hm) φ
  · exact (hf.apply_eq_zero_iff_of_projective m).mpr fun φ ↦ h _ _ φ m hm rfl rfl

set_option backward.isDefEq.respectTransparency false in
/-- **Vanishing of an ideal after base change.** For a pushout square of commutative rings
`A → B`, `A → C`, `B → D`, `C → D` with `B` projective over `A`, an ideal `k` of `B` extends
to zero in `D` if and only if its dual content extends to zero in `C`. -/
theorem CommRingCat.map_eq_bot_iff_of_isPushout {A B C D : CommRingCat.{u}} {f : A ⟶ B}
    {g : A ⟶ C} {inl : B ⟶ D} {inr : C ⟶ D} (h : IsPushout f g inl inr)
    (hf : letI := f.hom.toAlgebra; Module.Projective A B) (k : Ideal B) :
    k.map inl.hom = ⊥ ↔
      (letI := f.hom.toAlgebra; (k.restrictScalars A).dualContent).map g.hom = ⊥ := by
  algebraize [f.hom, g.hom, inl.hom, inr.hom, inl.hom.comp f.hom]
  have : IsScalarTower A C D := .of_algebraMap_eq' <| congr($(h.1.1).hom)
  have : Algebra.IsPushout A C B D := CommRingCat.isPushout_iff_isPushout.mp h.flip
  refine (Ideal.map_eq_bot_iff_le_ker _).trans (Iff.trans ?_
    ((Algebra.IsPushout.out (R := A) (S := C) (R' := B) (S' := D)).forall_apply_eq_zero_iff
      (k.restrictScalars A)))
  simp only [SetLike.le_def, RingHom.mem_ker]
  rfl
