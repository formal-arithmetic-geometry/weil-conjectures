module

public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Localization.AtPrime.Basic

import Mathlib.RingTheory.Localization.AsSubring

/-!
# Normality of a finite supremum from a normal-fiber cover

Source: Stacks Project, Algebra, Tag 0333, final paragraph of the reverse implication.
(blueprint: lem-weil-pbc-finite-normal-cover-sup-normal)
-/

@[expose] public section

universe u v

/-- Normality of a supremum from a family covering the base by normal fibers.
Source: Stacks Project, Algebra, Tag 0333, final localization argument for the subring
generated by the finite collection. (blueprint: lem-weil-pbc-finite-normal-cover-sup-normal)

Proof: Put B = sup s. The supremum lies in integralClosure A K, so B is integral
over A. Contract a prime q of B to p of A, and choose C in s using hcover. The
inclusion C -> B contracts q to a prime r of C over p, and C_r is integrally closed.
Both C_r and B_q have fraction field K. If z in K is integral over A, then it is
integral over C_r and belongs to C_r. Write it as c/t with c in C and t outside r;
thus t*z belongs to C. Now let x in K be integral over B_q. Clear the denominators
of its monic equation to obtain d outside q with d*x integral over B, hence over A
by transitivity. Applying the preceding argument to d*x gives t outside r with
t*d*x in C, hence in B. The image of t avoids q by the definition of r. Therefore
t*d avoids q, and the fraction (t*d*x)/(t*d) represents x in B_q. The fraction-field
criterion for integral closedness proves the result. -/
theorem finite_normal_cover_sup_normal (A : Type u) (K : Type v)
    [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K]
    (s : Finset (Subalgebra A K))
    (hs : ∀ C ∈ s, C ≤ integralClosure A K)
    (hcover : ∀ (p : Ideal A) [p.IsPrime], ∃ C ∈ s,
      ∀ (q : Ideal C) [q.IsPrime], Ideal.comap (algebraMap A C) q = p →
        IsIntegrallyClosed (Localization.AtPrime q)) :
    ∀ (q : Ideal (s.sup (fun C : Subalgebra A K => C) : Subalgebra A K)) [q.IsPrime],
      IsIntegrallyClosed (Localization.AtPrime q) := by
  classical
  let B : Subalgebra A K := s.sup (fun C : Subalgebra A K => C)
  have hB : B ≤ integralClosure A K := Finset.sup_le hs
  have : Algebra.IsIntegral A B := le_integralClosure_iff_isIntegral.mp hB
  intro q _
  let p := Ideal.comap (algebraMap A B) q
  have : p.IsPrime := Ideal.comap_isPrime _ _
  obtain ⟨C, hCs, hC⟩ := hcover p
  have hCB : C ≤ B := Finset.le_sup (f := fun C : Subalgebra A K => C) hCs
  let i : C →ₐ[A] B := Subalgebra.inclusion hCB
  let r := Ideal.comap i.toRingHom q
  have : r.IsPrime := Ideal.comap_isPrime _ _
  have hrp : Ideal.comap (algebraMap A C) r = p := by
    rw [Ideal.comap_comap]
    rfl
  have : IsIntegrallyClosed (Localization.AtPrime r) := hC r hrp
  let g := Localization.mapToFractionRing K r.primeCompl (Localization.AtPrime r)
    r.primeCompl_le_nonZeroDivisors
  let : Algebra (Localization.AtPrime r) K := g.toRingHom.toAlgebra
  have : IsScalarTower C (Localization.AtPrime r) K :=
    IsScalarTower.of_algebraMap_eq fun c ↦ (g.commutes c).symm
  have : IsFractionRing (Localization.AtPrime r) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization r.primeCompl
      (Localization.AtPrime r) K
  -- Integral elements have a denominator outside r with numerator in C.
  have hden (z : K) (hz : IsIntegral A z) : ∃ t : r.primeCompl, t • z ∈ C := by
    have hzC : IsIntegral C z := hz.tower_top
    have hzR : IsIntegral (Localization.AtPrime r) z := hzC.tower_top
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzR
    obtain ⟨c, t, ht⟩ := IsLocalization.exists_mk'_eq r.primeCompl y
    have hzt : z * algebraMap C K t = algebraMap C K c := by
      have he := congrArg (algebraMap (Localization.AtPrime r) K)
        (IsLocalization.mk'_spec (Localization.AtPrime r) c t)
      simpa only [map_mul, ← IsScalarTower.algebraMap_apply, ht, hy] using he
    refine ⟨t, ?_⟩
    rw [Submonoid.smul_def, Algebra.smul_def, mul_comm, hzt]
    exact c.property
  let f := Localization.mapToFractionRing K q.primeCompl (Localization.AtPrime q)
    q.primeCompl_le_nonZeroDivisors
  let : Algebra (Localization.AtPrime q) K := f.toRingHom.toAlgebra
  have : IsScalarTower B (Localization.AtPrime q) K :=
    IsScalarTower.of_algebraMap_eq fun b ↦ (f.commutes b).symm
  have : IsFractionRing (Localization.AtPrime q) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization q.primeCompl
      (Localization.AtPrime q) K
  -- Clear a q-denominator, then an r-denominator; their product still avoids q.
  apply (isIntegrallyClosed_iff K).mpr
  intro x hx
  obtain ⟨d, hd⟩ :=
    IsIntegral.exists_multiple_integral_of_isLocalization q.primeCompl x hx
  have hxA : IsIntegral A (d • x) := isIntegral_trans (d • x) hd
  obtain ⟨t, ht⟩ := hden (d • x) hxA
  have htQ : i t ∈ q.primeCompl := t.property
  let e : q.primeCompl := ⟨i t, htQ⟩ * d
  refine ⟨IsLocalization.mk' (Localization.AtPrime q) ⟨_, hCB ht⟩ e, ?_⟩
  apply (IsLocalization.lift_mk'_spec _ _ _ _).mpr
  change t • (d • x) = algebraMap B K (e : B) * x
  simp only [e, Submonoid.smul_def, Algebra.smul_def, Submonoid.coe_mul, map_mul]
  rw [mul_assoc]
  rfl
