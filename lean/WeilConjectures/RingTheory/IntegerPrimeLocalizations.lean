/-!
# Prime localizations of the integers

Source: Stacks Project, Algebra, Tags 034W, 034X, 0AUQ and 00PD
(blueprint: lem-weil-pbc-z-localizations-dvr).
-/

@[expose] public section

namespace Int

/-- The integers are a dimension-one Dedekind domain with fraction field `ℚ`; their primes
are zero and the ideals generated by rational primes. The zero-prime localization is `ℚ`,
and each nonzero prime localization is a Noetherian local DVR with the indicated maximal
ideal. Source: Stacks Project, Algebra, Tags 034W, 034X, 0AUQ and 00PD
(blueprint: lem-weil-pbc-z-localizations-dvr).

Proof:
1. Euclidean division makes every integer ideal principal, hence `ℤ` is Noetherian. For a
   reduced fraction integral over `ℤ`, clearing a monic equation forces its denominator
   to divide a power of its coprime numerator, hence to be one. Thus `ℤ` is integrally closed.
2. Nonzero prime ideals in this PID are generated by prime elements, hence by positive
   rational primes. Each is maximal, and zero is strictly below it, giving dimension one
   and the Dedekind conclusion. The fraction field is the usual rational field.
3. At zero all nonzero integers are inverted, giving the canonical `ℤ`-algebra identification
   with `ℚ`. At a nonzero prime, `lem-weil-pbc-localization-prime-residue-field-iso` gives
   exactly the zero and maximal primes; `def-weil-pbc-localization-at-prime` identifies the
   maximal ideal with the extension of the original prime. These primes form a strict
   inclusion, since the localization is a domain and the image of `p` is nonzero.
   Step 1 gives the normal domain of `def-weil-pbc-normal-ring`; normality and the unchanged
   fraction field follow from `lem-weil-pbc-localization-normal-domain`, and Noetherianity
   from `lem-weil-pbc-localization-noetherian`.
4. The nonzero localization has dimension one and principal maximal ideal. Apply the
   normal-local criterion `lem-sc-normal-dim1-dvr` (Stacks 00PD) to obtain the DVR assertion. -/
theorem prime_localizations_dvr :
    IsDedekindDomain ℤ ∧ ringKrullDim ℤ = 1 ∧ IsFractionRing ℤ ℚ ∧
      (∀ P : Ideal ℤ,
        P.IsPrime ↔ P = ⊥ ∨ ∃ p : ℕ, p.Prime ∧ P = Ideal.span {(p : ℤ)}) ∧
      Nonempty (Localization.AtPrime (⊥ : Ideal ℤ) ≃ₐ[ℤ] ℚ) ∧
      (∀ (P : Ideal ℤ) [P.IsPrime], P ≠ ⊥ →
        IsNoetherianRing (Localization.AtPrime P) ∧
          IsLocalRing (Localization.AtPrime P) ∧
          IsDiscreteValuationRing (Localization.AtPrime P) ∧
          ∃ p : ℕ, p.Prime ∧ P = Ideal.span {(p : ℤ)} ∧
            IsLocalRing.maximalIdeal (Localization.AtPrime P) =
              Ideal.span {algebraMap ℤ (Localization.AtPrime P) (p : ℤ)}) := by
  refine ⟨inferInstance, IsPrincipalIdealRing.ringKrullDim_eq_one ℤ Int.not_isField,
    inferInstance, fun _ ↦ Ideal.isPrime_int_iff, ?_, ?_⟩
  · have : IsLocalization (⊥ : Ideal ℤ).primeCompl ℚ := by
      rw [Ideal.primeCompl_bot]
      infer_instance
    exact ⟨Localization.algEquiv (⊥ : Ideal ℤ).primeCompl ℚ⟩
  · intro P _ hP
    obtain ⟨p, hp, hspan⟩ := (Ideal.isPrime_int_iff.mp ‹P.IsPrime›).resolve_left hP
    have : IsNoetherianRing (Localization.AtPrime P) :=
      IsLocalization.isNoetherianRing P.primeCompl _ inferInstance
    refine ⟨inferInstance, inferInstance,
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ℤ hP _,
      p, hp, hspan, ?_⟩
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P]
    rw [congrArg (Ideal.map (algebraMap ℤ (Localization.AtPrime P))) hspan,
      Ideal.map_span]
    simp

end Int
