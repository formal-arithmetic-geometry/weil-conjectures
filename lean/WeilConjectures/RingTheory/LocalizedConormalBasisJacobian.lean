/-!
# Localized consequences of a conormal basis

Source: Stacks Project, Tag 07EZ, proof of part (e), spanning and split differential
(blueprint: lem-weil-pbc-localized-conormal-basis-jacobian).
-/

@[expose] public section

universe u v
open scoped TensorProduct

namespace Algebra.Presentation

/-- A conormal basis gives localized ideal membership for the remaining relations and a
left inverse of the localized Jacobian. No exponent bound or strictly standard element
is asserted here.

Source: Stacks Project, Tag 07EZ, proof of part (e), the sentences beginning
"Then ... holds ... by construction" and "Moreover, since ... is a split injection"
(blueprint: lem-weil-pbc-localized-conormal-basis-jacobian).

Proof: every relation class is a linear combination of the given basis classes after
localizing. Express the coefficients as fractions of elements of `A` and lift numerators
to the polynomial ring. Equality in the localized conormal quotient says precisely that
the relation belongs to the localization of the ideal generated by the first relations
plus the square of the kernel. This ideal membership uses the lift `P.σ a`; changing the
lift has no effect on the conormal module because the kernel annihilates it. For the
Jacobian, identify the polynomial differential module with the free module on its
variables. The differential of a relation has coordinates its evaluated partial
derivatives. Smoothness splits the localized conormal injection. Compose its left
inverse with the coordinate map of the conormal basis, and write the composite as a
matrix. Applied to each coordinate basis vector this gives the asserted matrix identity.
The reasoning also applies to empty bases and to the zero localization. For the split sequence,
use the principal-localization cotangent comparison for the presentation obtained by adjoining
the inverse of `P.σ a`, then identify its cokernel with the localized differentials. -/
theorem localized_conormal_basis_jacobian
    {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
    {n m c : ℕ} (P : Presentation R A (Fin n) (Fin m))
    (hc : c ≤ min n m) (a : A) [Smooth R (Localization.Away a)]
    (b : Module.Basis (Fin c) (Localization.Away a)
      (Localization.Away a ⊗[A] P.toExtension.Cotangent))
    (hb : ∀ j : Fin c, b j = 1 ⊗ₜ[A]
      (Extension.Cotangent.mk (P := P.toExtension)
        ⟨P.relation (Fin.castLE (le_trans hc (min_le_right n m)) j),
          P.relation_mem_ker _⟩)) :
    (∀ j : Fin m, c ≤ j.val →
      algebraMap (MvPolynomial (Fin n) R) (Localization.Away (P.σ a)) (P.relation j) ∈
        Ideal.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away (P.σ a)))
          (Ideal.span {f | ∃ k : Fin m, k.val < c ∧ f = P.relation k} +
            (Ideal.span (Set.range P.relation)) ^ 2)) ∧
    let D : Matrix (Fin n) (Fin c) (Localization.Away a) :=
      fun i j ↦ algebraMap A (Localization.Away a)
        (MvPolynomial.aeval P.val (MvPolynomial.pderiv i
          (P.relation (Fin.castLE (le_trans hc (min_le_right n m)) j))))
    ∃ L : Matrix (Fin c) (Fin n) (Localization.Away a), L * D = 1 := by
  classical
  constructor
  · -- Lift the span of the initial conormal classes back into their polynomial ideal.
    let S := Localization.Away a
    let E := P.toExtension
    let f : Fin c → E.ker := fun k ↦
      ⟨P.relation (Fin.castLE (le_trans hc (min_le_right n m)) k), P.relation_mem_ker _⟩
    let t : Fin c → E.Cotangent := fun k ↦ Extension.Cotangent.mk (f k)
    let N : Submodule A E.Cotangent := Submodule.span A (Set.range t)
    let K : Ideal E.Ring :=
      Ideal.span {g | ∃ k : Fin m, k.val < c ∧ g = P.relation k}
    have hfK (k : Fin c) : (f k : E.Ring) ∈ K := by
      apply Ideal.subset_span
      exact ⟨Fin.castLE (le_trans hc (min_le_right n m)) k, k.isLt, rfl⟩
    have hrep (z : E.Cotangent) (hz : z ∈ N) :
        ∃ g : E.ker, (g : E.Ring) ∈ K ∧ Extension.Cotangent.mk g = z := by
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨k, rfl⟩ := hx
        exact ⟨f k, hfK k, rfl⟩
      | zero => exact ⟨0, K.zero_mem, map_zero _⟩
      | add x y hx hy ihx ihy =>
        obtain ⟨g, hg, rfl⟩ := ihx
        obtain ⟨h, hh, rfl⟩ := ihy
        exact ⟨g + h, K.add_mem hg hh, map_add _ _ _⟩
      | smul r x hx ih =>
        obtain ⟨g, hg, rfl⟩ := ih
        refine ⟨E.σ r • g, K.mul_mem_left _ hg, ?_⟩
        apply Extension.Cotangent.ext
        rw [map_smul, Extension.Cotangent.val_smul',
          Extension.Cotangent.val_smul]
    -- The basis makes this span the whole module after localization.
    let F : E.Cotangent →ₗ[A] (S ⊗[A] E.Cotangent) := TensorProduct.mk A S _ 1
    let N' := N.localized' S (Submonoid.powers a) F
    have hN' : N' = ⊤ := by
      apply top_unique
      rw [← b.span_eq]
      apply Submodule.span_le.mpr
      rintro _ ⟨k, rfl⟩
      rw [hb k]
      exact ⟨t k, Submodule.subset_span ⟨k, rfl⟩, 1,
        IsLocalizedModule.mk'_one (Submonoid.powers a) F (t k)⟩
    intro j hj
    let x : E.ker := ⟨P.relation j, P.relation_mem_ker j⟩
    have hx : F (Extension.Cotangent.mk x) ∈ N' := by rw [hN']; trivial
    obtain ⟨z, hz, s, hs⟩ := hx
    have heq : F ((s : A) • Extension.Cotangent.mk x) = F z := by
      rw [map_smul]
      rw [← hs]
      exact IsLocalizedModule.mk'_cancel' F z s
    -- Clear a denominator for membership and a second one for equality of classes.
    obtain ⟨s', hs'⟩ :=
      (IsLocalizedModule.eq_iff_exists (Submonoid.powers a) F).mp heq
    have hmem : (s' : A) • (s : A) • Extension.Cotangent.mk x ∈ N :=
      hs' ▸ N.smul_mem (s' : A) hz
    obtain ⟨g, hg, hgz⟩ := hrep _ hmem
    obtain ⟨k, hk⟩ := s.property
    obtain ⟨k', hk'⟩ := s'.property
    change a ^ k = (s : A) at hk
    change a ^ k' = (s' : A) at hk'
    have hpow : Extension.Cotangent.mk ((E.σ a) ^ (k' + k) • x) =
        (s' : A) • (s : A) • Extension.Cotangent.mk x := by
      rw [map_smul, ← algebraMap_smul A, map_pow,
        E.algebraMap_σ, pow_add, mul_smul]
      rw [hk, hk']
    have hdiff : ((E.σ a) ^ (k' + k) * (x : E.Ring) - (g : E.Ring)) ∈ E.ker ^ 2 := by
      exact (Extension.Cotangent.mk_eq_mk_iff_sub_mem _ _).mp (hpow.trans hgz.symm)
    have htotal : (E.σ a) ^ (k' + k) * (x : E.Ring) ∈ K + E.ker ^ 2 := by
      have := (K + E.ker ^ 2).add_mem
        (show (g : E.Ring) ∈ K + E.ker ^ 2 from (show K ≤ K + E.ker ^ 2 from le_sup_left) hg)
        (show (E.σ a) ^ (k' + k) * (x : E.Ring) - (g : E.Ring) ∈ K + E.ker ^ 2
          from (show E.ker ^ 2 ≤ K + E.ker ^ 2 from le_sup_right) hdiff)
      simpa only [add_sub_cancel_left, add_sub_cancel_right, add_sub_cancel] using this
    have hmap := Ideal.mem_map_of_mem
      (algebraMap E.Ring (Localization.Away (E.σ a))) htotal
    rw [map_mul, map_pow] at hmap
    have hresult := (Ideal.unit_mul_mem_iff_mem _
      ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (E.σ a))
        (E.σ a)).pow (k' + k))).mp hmap
    rw [P.span_range_relation_eq_ker]
    exact hresult
  · -- Compute the split conormal differential using the enlarged presentation of A_a.
    let S := Localization.Away a
    let G := P.toGenerators
    let Q := (Generators.localizationAway S a).comp G
    have hf : algebraMap G.Ring A (G.σ a) = a := G.toExtension.algebraMap_σ a
    obtain ⟨_, _, r, _, e1, e2, e0, _, _, _, _, hi, ⟨ec⟩⟩ :=
      G.principal_localization_naive_cotangent a (G.σ a) hf (Bg := S)
    have : FormallySmooth R Q.toExtension.Ring := by
      change FormallySmooth R (MvPolynomial _ R)
      infer_instance
    have hQ : Function.Injective Q.toExtension.cotangentComplex :=
      Q.toExtension.cotangentComplex_injective_iff.mpr inferInstance
    let d := G.toExtension.cotangentComplex.baseChange S
    have hd : Function.Injective d := hi.mpr hQ
    let W := S ⊗[A] G.toExtension.CotangentSpace
    let C := W ⧸ LinearMap.range d
    let eqΩ : (Q.toExtension.CotangentSpace ⧸
        LinearMap.range Q.toExtension.cotangentComplex) ≃ₗ[S] KaehlerDifferential R S :=
      (Submodule.quotEquivOfEq _ _
        Q.toExtension.exact_cotangentComplex_toKaehler.linearMap_ker_eq.symm).trans
        (Q.toExtension.toKaehler.quotKerEquivOfSurjective Q.toExtension.toKaehler_surjective)
    let eC : C ≃ₗ[S] KaehlerDifferential R S := ec.trans eqΩ
    have : Module.Projective S C := Module.Projective.of_equiv eC.symm
    obtain ⟨s, hs⟩ := (LinearMap.range d).mkQ.exists_rightInverse_of_surjective
      (LinearMap.range_eq_top.mpr (Submodule.mkQ_surjective _))
    have hex : ∃ l : W →ₗ[S] (S ⊗[A] G.toExtension.Cotangent),
        l.comp d = LinearMap.id :=
      (((LinearMap.exact_map_mkQ_range d).split_tfae hd
        (Submodule.mkQ_surjective _)).out 0 1).mp (Exists.intro s hs)
    obtain ⟨l, hl⟩ := hex
    -- Its matrix in the two prescribed bases is exactly the evaluated Jacobian.
    let w := G.cotangentSpaceBasis.baseChange S
    have hD : LinearMap.toMatrix b w d =
        fun i j ↦ algebraMap A S
          (MvPolynomial.aeval P.val (MvPolynomial.pderiv i
            (P.relation (Fin.castLE (le_trans hc (min_le_right n m)) j)))) := by
      ext i j
      rw [LinearMap.toMatrix_apply, hb]
      change (G.cotangentSpaceBasis.baseChange S).repr
        (G.toExtension.cotangentComplex.baseChange S
          (1 ⊗ₜ[A] Extension.Cotangent.mk
            ⟨P.relation (Fin.castLE (le_trans hc (min_le_right n m)) j),
              P.relation_mem_ker _⟩)) i = _
      rw [LinearMap.baseChange_tmul, Module.Basis.baseChange_repr_tmul,
        Extension.cotangentComplex_mk]
      erw [Generators.cotangentSpaceBasis_repr_tmul]
      simp [G, Algebra.smul_def]
    refine ⟨LinearMap.toMatrix w b l, ?_⟩
    rw [← hD, ← LinearMap.toMatrix_comp b w b, hl, LinearMap.toMatrix_id]

end Algebra.Presentation
