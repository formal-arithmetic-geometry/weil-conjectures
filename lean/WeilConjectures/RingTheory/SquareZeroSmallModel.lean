module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Finiteness.Small
import Mathlib.Algebra.Algebra.Shrink

@[expose] public section

universe u v z

namespace Algebra

/-- Every algebra map into a square-zero quotient factors through the quotient of
an algebra in the universe of the base and source.
Source: the polynomial-presentation size reduction in the proof of
`lem-weil-pbc-fs-adic-universe-lift`, derived from the lifting definition of
Stacks Project, More on Algebra, Tag 07EB (not a separate assertion in Stacks).
(blueprint: lem-weil-pbc-square-zero-small-model)

Proof: Choose a representative b(s) in D of each g(s), using surjectivity of the
quotient map. Let A be the R-subalgebra generated by these representatives and
K the inverse image of J under A → D. Since this inclusion is injective,
products of two elements of K vanish, so K² = 0. The induced algebra map
q : A/K → D/J is injective: an element represented by a in A maps to zero
exactly when a belongs to K. Every g(s) is in its image because b(s) belongs
to A. Inverting q on its image therefore gives an algebra map g₀ : S → A/K;
its preservation of all operations follows from injectivity of q. Thus
q ∘ g₀ = g, and the quotient square with A → D commutes.

Evaluation R[X_s | s ∈ S] → A is surjective by the definition of generated
subalgebra. Hence A is small in universe max u v; Mathlib's `Algebra.small_adjoin`
encodes this polynomial-presentation argument. Take D₀ = Shrink A and its
canonical R-algebra equivalence t : D₀ ≃ A. In the Lean construction, first
compose t with A → D, then take K as the inverse image of J in D₀ and construct
q on its quotient. The preceding kernel and image arguments apply unchanged.
This construction uses no lifting hypothesis and produces no lift S → D. -/
theorem exists_squareZero_small_model
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    (D : Type z) [CommRing D] [Algebra R D] (J : Ideal D) (hJ : J ^ 2 = ⊥)
    (g : S →ₐ[R] D ⧸ J) :
    ∃ (D₀ : Type (max u v)) (_ : CommRing D₀) (_ : Algebra R D₀)
      (e : D₀ →ₐ[R] D) (K : Ideal D₀) (q : D₀ ⧸ K →ₐ[R] D ⧸ J)
      (g₀ : S →ₐ[R] D₀ ⧸ K),
      K ^ 2 = ⊥ ∧ Function.Injective q ∧
        q.comp (Ideal.Quotient.mkₐ R K) = (Ideal.Quotient.mkₐ R J).comp e ∧
        q.comp g₀ = g := by
  classical
  choose b hb using fun s : S ↦ Ideal.Quotient.mkₐ_surjective R J (g s)
  let A : Subalgebra R D := Algebra.adjoin R (Set.range b)
  let D₀ := Shrink.{max u v} A
  let t : D₀ ≃ₐ[R] A := Shrink.algEquiv R A
  let e : D₀ →ₐ[R] D := A.val.comp t.toAlgHom
  have he : Function.Injective e := Subtype.val_injective.comp t.injective
  let K : Ideal D₀ := J.comap e.toRingHom
  have hK : K ^ 2 = ⊥ := by
    apply le_bot_iff.mp
    calc
      K ^ 2 ≤ (J ^ 2).comap e.toRingHom := Ideal.le_comap_pow e.toRingHom 2
      _ = ⊥ := by rw [hJ, Ideal.comap_bot_of_injective e.toRingHom he]
  let q : D₀ ⧸ K →ₐ[R] D ⧸ J :=
    Ideal.Quotient.liftₐ K ((Ideal.Quotient.mkₐ R J).comp e)
      (fun x hx ↦ Ideal.Quotient.eq_zero_iff_mem.mpr hx)
  have hqe : q.comp (Ideal.Quotient.mkₐ R K) = (Ideal.Quotient.mkₐ R J).comp e :=
    Ideal.Quotient.liftₐ_comp _ _ _
  have hq : Function.Injective q := by
    apply (injective_iff_map_eq_zero q).mpr
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective R K x
    intro hx
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    change e a ∈ J
    change Ideal.Quotient.mk J (e a) = 0 at hx
    exact Ideal.Quotient.eq_zero_iff_mem.mp hx
  have hgr : ∀ s, g s ∈ q.range := by
    intro s
    let a : A := ⟨b s, Algebra.subset_adjoin ⟨s, rfl⟩⟩
    refine ⟨Ideal.Quotient.mkₐ R K (t.symm a), ?_⟩
    change Ideal.Quotient.mkₐ R J (e (t.symm a)) = g s
    simpa only [e, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
      AlgEquiv.apply_symm_apply, Subalgebra.val_apply, a] using hb s
  let c : (D₀ ⧸ K) ≃ₐ[R] q.range := AlgEquiv.ofInjective q hq
  let g₀ : S →ₐ[R] D₀ ⧸ K := c.symm.toAlgHom.comp (g.codRestrict q.range hgr)
  refine ⟨D₀, inferInstance, inferInstance, e, K, q, g₀, hK, hq, hqe, ?_⟩
  ext s
  change q (c.symm (g.codRestrict q.range hgr s)) = g s
  have hc := congrArg Subtype.val (c.apply_symm_apply (g.codRestrict q.range hgr s))
  exact hc

end Algebra
