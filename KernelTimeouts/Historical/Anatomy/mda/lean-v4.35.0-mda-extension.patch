+        std::map<std::pair<std::string, std::string>, std::string> result;
+        char const * path = std::getenv("LEAN_DEFEQ_MDA_FIELDS");
+        if (!path || !*path) return result;
+        std::ifstream input(path);
+        std::string s, i, field;
+        while (input >> s >> i >> field) result[{s, i}] = field;
+        return result;
+    }();
