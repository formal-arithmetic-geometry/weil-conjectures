+        if (parent) parent->child += inclusive;
+        auto & entry = data.prop_families[key];
+        ++entry.first;
+        entry.second += inclusive > child ? inclusive - child : 0;
+        auto & position = data.proof_positions[proof_key];
+        ++position.first;
+        position.second += inclusive > child ? inclusive - child : 0;
+    }
+};
+thread_local prop_frame * prop_frame::current_prop = nullptr;
