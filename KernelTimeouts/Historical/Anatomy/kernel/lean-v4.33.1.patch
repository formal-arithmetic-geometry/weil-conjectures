+        if (!owner) return;
+        enabled = true;
+        outer = reduction_depth++ == 0;
+        if (outer) {
+            ++data.whnf_calls;
+            reduction_owner = owner;
+            reduction_child_ns = &child_comparisons;
+            start = clock::now();
+        }
+    }
+    ~reduction() {
+        if (!enabled) return;
+        --reduction_depth;
+        if (outer) {
+            uint64_t elapsed = std::chrono::duration_cast<ns>(clock::now() - start).count();
+            reduction_owner = nullptr;
+            reduction_child_ns = nullptr;
+            elapsed = elapsed > child_comparisons ? elapsed - child_comparisons : 0;
+            data.whnf_ns += elapsed;
+            owner->reduce_ns += elapsed;
+        }
+    }
+};
+struct prop_frame {
