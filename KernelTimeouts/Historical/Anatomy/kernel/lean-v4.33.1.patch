+struct comparison {
+    comparison * parent;
+    expr const & left;
+    expr const & right;
+    clock::time_point start;
+    uint64_t id = 0, child_ns = 0, reduce_ns = 0;
+    unsigned depth = 0, children = 0;
+    bool result = false, completed = false, enabled = false, repeated = false;
+    branch outcome = Exception;
+    comparison(expr const & t, expr const & s): parent(current), left(t), right(s) {
+        if (!mode()) return;
+        enabled = true;
+        if (!parent) { data = totals{}; ++root_serial; }
+        id = ++data.calls;
+        depth = parent ? parent->depth + 1 : 0;
+        if (parent) ++parent->children;
+        data.max_depth = std::max<uint64_t>(data.max_depth, depth);
+        ++data.depth_hist[bucket(depth)];
+        ++data.kinds[{static_cast<unsigned>(t.kind()), static_cast<unsigned>(s.kind())}];
+        if (mode() == 2 && data.pair_captured < 5000000) {
+            ++data.pair_captured;
+            auto pair = pair_key{t, s};
+            repeated = data.exact[pair]++ != 0;
+            ++data.structural[{hash(t), hash(s)}];
+        }
+        start = clock::now();
+        current = this;
+    }
+    void finish(bool r, branch b) { completed = true; result = r; outcome = b; }
+    ~comparison() {
+        if (!enabled) return;
+        uint64_t inclusive = std::chrono::duration_cast<ns>(clock::now() - start).count();
+        uint64_t exclusive = inclusive > child_ns + reduce_ns ? inclusive - child_ns - reduce_ns : 0;
+        if (reduction_child_ns && parent == reduction_owner) *reduction_child_ns += inclusive;
+        current = parent;
+        if (parent) parent->child_ns += inclusive;
+        if (completed && result) ++data.successes; else ++data.failures;
+        ++data.branches[outcome];
+        ++data.fanout_hist[bucket(children)];
+        data.comparison_exclusive += exclusive;
+        data.reduction_exclusive += reduce_ns;
+        if (mode() == 2) {
+            if (repeated) { ++data.pair_repeats; data.pair_time += exclusive; }
+            if (data.top.size() < 20 || exclusive > data.top.back().exclusive) {
+                top_call c;
+                c.id = id; c.parent = parent ? parent->id : 0; c.depth = depth; c.children = children;
+                c.exclusive = exclusive; c.inclusive = inclusive; c.reduction = reduce_ns;
+                c.left = head(left); c.right = head(right);
+                data.top.push_back(std::move(c));
+                std::sort(data.top.begin(), data.top.end(), [](top_call const & a, top_call const & b) {
+                    return a.exclusive > b.exclusive;
+                });
+                if (data.top.size() > 20) data.top.pop_back();
+            }
+        }
