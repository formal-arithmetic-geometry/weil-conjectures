@@ -24,6 +32,381 @@ Author: Leonardo de Moura
 #include "kernel/inductive.h"
 
 namespace lean {
+namespace anatomy {
+using clock = std::chrono::steady_clock;
+using ns = std::chrono::nanoseconds;
+enum branch : unsigned {
+    Quick, Reflection, QuickReduced, Proof, Delta, SameConstant, SameFVar, Projection,
+    Reduced, Application, Eta, EtaStructure, StringExpansion, UnitLike, Failure, Exception, Count
+};
+static char const * branch_names[] = {
+    "quick", "reflection", "quick_reduced", "proof_irrelevance", "lazy_delta",
+    "same_constant", "same_fvar", "projection", "second_whnf", "application",
+    "eta", "eta_structure", "string_expansion", "unit_like", "failure", "exception"
+};
+static int mode() {
+    static int value = [] {
+        char const * s = std::getenv("LEAN_DEFEQ_ANATOMY");
+        return s && std::strcmp(s, "trace") == 0 ? 2 : s && std::strcmp(s, "counters") == 0 ? 1 : 0;
+    }();
+    return value;
+}
+static double ms(uint64_t n) { return static_cast<double>(n) / 1000000.0; }
+static std::string head(expr const & e) {
+    expr const & f = get_app_fn(e);
+    if (is_constant(f)) return const_name(f).to_string();
+    if (is_proj(f)) return proj_sname(f).to_string() + ".proj";
+    return std::to_string(static_cast<unsigned>(e.kind()));
+}
+static std::string proposition_head(expr e) {
+    while (is_pi(e)) e = binding_body(e);
+    return head(e);
+}
+struct pair_key {
+    expr left;
+    expr right;
+    bool operator==(pair_key const & p) const { return is_eqp(left, p.left) && is_eqp(right, p.right); }
+};
+struct pair_hash {
+    size_t operator()(pair_key const & p) const {
+        return (static_cast<size_t>(reinterpret_cast<uintptr_t>(p.left.raw())) >> 4) ^
+            (static_cast<size_t>(reinterpret_cast<uintptr_t>(p.right.raw())) << 1);
+    }
+};
+struct top_call {
+    uint64_t id = 0, parent = 0, exclusive = 0, inclusive = 0, reduction = 0;
+    unsigned depth = 0, children = 0;
+    std::string left, right;
+    std::string path;
+};
+struct totals {
+    uint64_t calls = 0, successes = 0, failures = 0, max_depth = 0;
+    uint64_t whnf_calls = 0, whnf_ns = 0, delta_calls = 0, delta_ns = 0;
+    uint64_t beta = 0, iota = 0, zeta = 0, proj = 0;
+    uint64_t proof_attempts = 0, proof_prop = 0, proof_prop_ns = 0;
+    uint64_t app_attempts = 0, pi_domains = 0, cache_success = 0, cache_failure = 0;
+    uint64_t cache_success_miss = 0, cache_failure_miss = 0;
+    uint64_t comparison_exclusive = 0, reduction_exclusive = 0;
+    uint64_t dependent_comparison_exclusive = 0, dependent_reduction_exclusive = 0;
+    uint64_t proposition_comparison_exclusive = 0, proposition_reduction_exclusive = 0;
+    uint64_t instantiations = 0, instantiation_ns = 0;
+    uint64_t cpp_expr_created = 0, cpp_expr_bytes = 0;
+    size_t start_rss = 0, peak_rss = 0, start_commit = 0, peak_commit = 0;
+    uint64_t pair_captured = 0, pair_repeats = 0, pair_time = 0;
+    uint64_t prop_pair_captured = 0, prop_pair_repeats = 0;
+    uint64_t branches[Count] = {};
+    uint64_t branch_comparison_ns[Count] = {}, branch_reduction_ns[Count] = {};
+    std::map<unsigned, uint64_t> depth_hist, fanout_hist;
+    std::map<std::pair<unsigned, unsigned>, uint64_t> kinds;
+    std::map<std::pair<unsigned, unsigned>, uint64_t> structural;
+    std::map<std::pair<unsigned, unsigned>, uint64_t> prop_structural;
+    std::map<std::string, std::pair<uint64_t, uint64_t>> delta_heads;
+    std::map<std::string, std::pair<uint64_t, uint64_t>> prop_families;
+    std::map<std::string, std::pair<uint64_t, uint64_t>> proof_positions;
+    std::unordered_map<pair_key, uint64_t, pair_hash> exact;
+    std::unordered_map<pair_key, uint64_t, pair_hash> prop_pairs;
+    std::vector<top_call> top;
+    std::map<std::string, std::pair<uint64_t, uint64_t>> path_cost;
+    std::map<std::string, std::pair<std::string, std::string>> path_heads;
+};
+struct comparison;
+static thread_local comparison * current = nullptr;
+static thread_local comparison * next_owner = nullptr;
+static thread_local std::string next_path;
+static thread_local unsigned next_category = 0;
+struct path_scope {
+    std::string old_path;
+    unsigned old_category;
+    comparison * old_owner;
+    path_scope(char const * label, unsigned index, unsigned category):
+        old_path(std::move(next_path)), old_category(next_category), old_owner(next_owner) {
+        if (mode()) {
+            if (mode() == 2) next_path = std::string(label) + "[" + std::to_string(index) + "]";
+            next_category = category; next_owner = current;
+        }
+    }
+    path_scope(char const * label, unsigned category = 0):
+        old_path(std::move(next_path)), old_category(next_category), old_owner(next_owner) {
+        if (mode()) {
+            if (mode() == 2) next_path = label;
+            next_category = category; next_owner = current;
+        }
+    }
+    ~path_scope() {
+        if (mode()) { next_path = std::move(old_path); next_category = old_category; next_owner = old_owner; }
+    }
+};
+static void memory_snapshot(size_t & rss, size_t & commit) {
+    size_t elapsed, user, system, peak_rss, peak_commit, faults;
+    mi_process_info(&elapsed, &user, &system, &rss, &peak_rss, &commit, &peak_commit, &faults);
+}
+static thread_local comparison * reduction_owner = nullptr;
+static thread_local uint64_t * reduction_child_ns = nullptr;
+static thread_local totals data;
+static thread_local unsigned reduction_depth = 0;
+static thread_local uint64_t root_serial = 0;
+static unsigned bucket(unsigned n) { return n < 64 ? n : 64 + (n / 64); }
+static void report(uint64_t wall) {
+    char const * min = std::getenv("LEAN_DEFEQ_MIN_MS");
+    if (min && ms(wall) < std::atof(min)) return;
+    std::fprintf(stderr,
+        "ANATOMY root=%llu mode=%s wall_ms=%.3f calls=%llu success=%llu failure=%llu max_depth=%llu "
+        "comparison_exclusive_ms=%.3f reduction_exclusive_ms=%.3f whnf_calls=%llu whnf_ms=%.3f "
+        "delta_calls=%llu delta_ms=%.3f beta=%llu iota=%llu zeta=%llu projection=%llu "
+        "proof_attempts=%llu proposition_compares=%llu proposition_ms=%.3f app_attempts=%llu "
+        "pi_domains=%llu cache_success=%llu cache_failure=%llu cache_success_miss=%llu cache_failure_miss=%llu distinct_exact=%zu exact_repeats=%llu "
+        "pair_capture=%llu pair_repeat_exclusive_ms=%.3f distinct_structural=%zu "
+        "prop_pair_capture=%llu prop_pair_distinct=%zu prop_pair_repeats=%llu "
+        "prop_structural_distinct=%zu proof_position_groups=%zu "
+        "dependent_comparison_ms=%.3f dependent_reduction_ms=%.3f "
+        "proposition_comparison_ms=%.3f proposition_reduction_ms=%.3f "
+        "instantiations=%llu instantiation_ms=%.3f cpp_expr_created=%llu cpp_expr_bytes=%llu "
+        "rss_delta_bytes=%lld commit_delta_bytes=%lld\n",
+        static_cast<unsigned long long>(root_serial), mode() == 2 ? "trace" : "counters", ms(wall),
+        static_cast<unsigned long long>(data.calls), static_cast<unsigned long long>(data.successes),
+        static_cast<unsigned long long>(data.failures), static_cast<unsigned long long>(data.max_depth),
+        ms(data.comparison_exclusive), ms(data.reduction_exclusive),
+        static_cast<unsigned long long>(data.whnf_calls), ms(data.whnf_ns),
+        static_cast<unsigned long long>(data.delta_calls), ms(data.delta_ns),
+        static_cast<unsigned long long>(data.beta), static_cast<unsigned long long>(data.iota),
+        static_cast<unsigned long long>(data.zeta), static_cast<unsigned long long>(data.proj),
+        static_cast<unsigned long long>(data.proof_attempts), static_cast<unsigned long long>(data.proof_prop),
+        ms(data.proof_prop_ns), static_cast<unsigned long long>(data.app_attempts),
+        static_cast<unsigned long long>(data.pi_domains), static_cast<unsigned long long>(data.cache_success),
+        static_cast<unsigned long long>(data.cache_failure),
+        static_cast<unsigned long long>(data.cache_success_miss),
+        static_cast<unsigned long long>(data.cache_failure_miss), data.exact.size(),
+        static_cast<unsigned long long>(data.pair_repeats), static_cast<unsigned long long>(data.pair_captured),
+        ms(data.pair_time), data.structural.size(),
+        static_cast<unsigned long long>(data.prop_pair_captured), data.prop_pairs.size(),
+        static_cast<unsigned long long>(data.prop_pair_repeats),
+        data.prop_structural.size(), data.proof_positions.size(),
+        ms(data.dependent_comparison_exclusive), ms(data.dependent_reduction_exclusive),
+        ms(data.proposition_comparison_exclusive), ms(data.proposition_reduction_exclusive),
+        static_cast<unsigned long long>(data.instantiations), ms(data.instantiation_ns),
+        static_cast<unsigned long long>(data.cpp_expr_created),
+        static_cast<unsigned long long>(data.cpp_expr_bytes),
+        static_cast<long long>(data.peak_rss) - static_cast<long long>(data.start_rss),
+        static_cast<long long>(data.peak_commit) - static_cast<long long>(data.start_commit));
+    for (unsigned i = 0; i < Count; ++i)
+        if (data.branches[i])
+            std::fprintf(stderr, "ANATOMY branch=%s calls=%llu comparison_exclusive_ms=%.3f reduction_exclusive_ms=%.3f\n",
+                         branch_names[i], static_cast<unsigned long long>(data.branches[i]),
+                         ms(data.branch_comparison_ns[i]), ms(data.branch_reduction_ns[i]));
+    std::vector<std::pair<std::string, std::pair<uint64_t, uint64_t>>> families(
+        data.prop_families.begin(), data.prop_families.end());
+    std::sort(families.begin(), families.end(), [] (auto const & a, auto const & b) {
+        return a.second.second > b.second.second;
+    });
+    for (size_t i = 0; i < std::min<size_t>(20, families.size()); ++i)
+        std::fprintf(stderr, "ANATOMY proposition=%s calls=%llu exclusive_ms=%.3f\n",
+                     families[i].first.c_str(),
+                     static_cast<unsigned long long>(families[i].second.first),
+                     ms(families[i].second.second));
+    std::vector<std::pair<std::string, std::pair<uint64_t, uint64_t>>> positions(
+        data.proof_positions.begin(), data.proof_positions.end());
+    std::sort(positions.begin(), positions.end(), [] (auto const & a, auto const & b) {
+        return a.second.second > b.second.second;
+    });
+    for (size_t i = 0; i < (mode() == 2 ? positions.size() : std::min<size_t>(20, positions.size())); ++i)
+        std::fprintf(stderr, "ANATOMY proof_position=%s calls=%llu exclusive_ms=%.3f\n",
+                     positions[i].first.c_str(),
+                     static_cast<unsigned long long>(positions[i].second.first),
+                     ms(positions[i].second.second));
+    if (mode() != 2) return;
+    for (auto const & p : data.depth_hist)
+        std::fprintf(stderr, "ANATOMY depth=%u calls=%llu\n", p.first, static_cast<unsigned long long>(p.second));
+    for (auto const & p : data.fanout_hist)
+        std::fprintf(stderr, "ANATOMY fanout=%u calls=%llu\n", p.first, static_cast<unsigned long long>(p.second));
+    for (auto const & p : data.kinds)
+        std::fprintf(stderr, "ANATOMY kinds=%u,%u calls=%llu\n", p.first.first, p.first.second,
+                     static_cast<unsigned long long>(p.second));
+    for (auto const & p : data.delta_heads)
+        std::fprintf(stderr, "ANATOMY delta=%s calls=%llu ms=%.3f\n", p.first.c_str(),
+                     static_cast<unsigned long long>(p.second.first), ms(p.second.second));
+    std::sort(data.top.begin(), data.top.end(), [] (top_call const & a, top_call const & b) {
+        return a.exclusive > b.exclusive;
+    });
+    for (auto const & p : data.top)
+        std::fprintf(stderr, "ANATOMY child=%llu parent=%llu depth=%u children=%u left=%s right=%s "
+                     "path=%s exclusive_ms=%.3f inclusive_ms=%.3f reduction_ms=%.3f\n",
+                     static_cast<unsigned long long>(p.id), static_cast<unsigned long long>(p.parent),
+                     p.depth, p.children, p.left.c_str(), p.right.c_str(), p.path.c_str(), ms(p.exclusive), ms(p.inclusive),
+                     ms(p.reduction));
+    auto prefix_cost = data.path_cost;
+    for (auto const & p : data.path_cost) {
+        auto pos = p.first.rfind('/');
+        while (pos != std::string::npos) {
+            prefix_cost[p.first.substr(0, pos)].second += p.second.second;
+            pos = p.first.rfind('/', pos - 1);
+        }
+    }
+    std::vector<std::pair<std::string, std::pair<uint64_t, uint64_t>>> paths(prefix_cost.begin(), prefix_cost.end());
+    std::sort(paths.begin(), paths.end(), [](auto const & a, auto const & b) { return a.second.second > b.second.second; });
+    for (size_t i = 0; i < std::min<size_t>(40, paths.size()); ++i)
+        std::fprintf(stderr, "ANATOMY path=%s left=%s right=%s direct_calls=%llu direct_exclusive_ms=%.3f subtree_exclusive_ms=%.3f\n",
+                     paths[i].first.c_str(), data.path_heads[paths[i].first].first.c_str(),
+                     data.path_heads[paths[i].first].second.c_str(),
+                     static_cast<unsigned long long>(data.path_cost[paths[i].first].first),
+                     ms(data.path_cost[paths[i].first].second), ms(paths[i].second.second));
+}
+struct comparison {
+    comparison * parent;
+    expr const & left;
+    expr const & right;
+    clock::time_point start;
+    uint64_t id = 0, child_ns = 0, reduce_ns = 0;
+    unsigned depth = 0, children = 0;
+    unsigned category = 0;
+    std::string path;
+    bool result = false, completed = false, enabled = false, repeated = false;
+    branch outcome = Exception;
+    comparison(expr const & t, expr const & s): parent(current), left(t), right(s) {
+        if (!mode()) return;
+        enabled = true;
+        if (!parent) {
+            data = totals{}; ++root_serial;
+            memory_snapshot(data.start_rss, data.start_commit);
+        }
+        id = ++data.calls;
+        depth = parent ? parent->depth + 1 : 0;
+        category = parent == next_owner && next_category ? next_category : parent ? parent->category : 0;
+        if (mode() == 2) {
+            path = parent ? parent->path : "root";
+            if (parent == next_owner && !next_path.empty() && path.size() < 160) path += "/" + next_path;
+            if (data.path_heads.find(path) == data.path_heads.end())
+                data.path_heads.emplace(path, std::make_pair(head(t), head(s)));
+        }
+        if (parent) ++parent->children;
+        data.max_depth = std::max<uint64_t>(data.max_depth, depth);
+        ++data.depth_hist[bucket(depth)];
+        ++data.kinds[{static_cast<unsigned>(t.kind()), static_cast<unsigned>(s.kind())}];
+        if (mode() == 2 && data.pair_captured < 5000000) {
+            ++data.pair_captured;
+            auto pair = pair_key{t, s};
+            repeated = data.exact[pair]++ != 0;
+            ++data.structural[{hash(t), hash(s)}];
+        }
+        start = clock::now();
+        current = this;
+    }
+    void finish(bool r, branch b) { completed = true; result = r; outcome = b; }
+    ~comparison() {
+        if (!enabled) return;
+        uint64_t inclusive = std::chrono::duration_cast<ns>(clock::now() - start).count();
+        uint64_t exclusive = inclusive > child_ns + reduce_ns ? inclusive - child_ns - reduce_ns : 0;
+        if (reduction_child_ns && parent == reduction_owner) *reduction_child_ns += inclusive;
+        current = parent;
+        if (parent) parent->child_ns += inclusive;
+        if (completed && result) ++data.successes; else ++data.failures;
+        ++data.branches[outcome];
+        data.branch_comparison_ns[outcome] += exclusive;
+        data.branch_reduction_ns[outcome] += reduce_ns;
+        ++data.fanout_hist[bucket(children)];
+        data.comparison_exclusive += exclusive;
+        data.reduction_exclusive += reduce_ns;
+        if (category == 1) {
+            data.dependent_comparison_exclusive += exclusive;
+            data.dependent_reduction_exclusive += reduce_ns;
+        } else if (category == 2) {
+            data.proposition_comparison_exclusive += exclusive;
+            data.proposition_reduction_exclusive += reduce_ns;
+        }
+        if (mode() == 2) {
+            auto & cost = data.path_cost[path];
+            ++cost.first;
+            cost.second += exclusive + reduce_ns;
+            if (repeated) { ++data.pair_repeats; data.pair_time += exclusive; }
+            if (data.top.size() < 20 || exclusive > data.top.back().exclusive) {
+                top_call c;
+                c.id = id; c.parent = parent ? parent->id : 0; c.depth = depth; c.children = children;
+                c.exclusive = exclusive; c.inclusive = inclusive; c.reduction = reduce_ns;
+                c.left = head(left); c.right = head(right); c.path = path;
+                data.top.push_back(std::move(c));
+                std::sort(data.top.begin(), data.top.end(), [](top_call const & a, top_call const & b) {
+                    return a.exclusive > b.exclusive;
+                });
+                if (data.top.size() > 20) data.top.pop_back();
+            }
+        }
+        if (!parent) {
+            memory_snapshot(data.peak_rss, data.peak_commit);
+            report(inclusive);
+        }
+    }
+};
+struct reduction {
+    comparison * owner = current;
+    clock::time_point start;
+    uint64_t child_comparisons = 0;
+    bool enabled = false, outer = false;
+    reduction() {
+        if (!owner) return;
+        enabled = true;
+        outer = reduction_depth++ == 0;
