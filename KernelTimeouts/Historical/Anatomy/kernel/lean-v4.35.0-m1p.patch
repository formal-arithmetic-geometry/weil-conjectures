+                        expr const & l, expr const & r, unsigned category, char const * provenance,
+                        char const * divergence, uint64_t exclusive = 0, uint64_t reduction = 0,
+                        bool result = false, char const * phase = "", uint64_t left_hash = 0,
+                        uint64_t right_hash = 0, uint64_t div_left_hash = 0, uint64_t div_right_hash = 0,
+                        uint64_t parent_div_left_hash = 0, uint64_t parent_div_right_hash = 0,
+                        char const * div_path = "", bool sampled = false,
+                        char const * child_kind = "fallback", unsigned child_index = 0,
+                        bool child_index_valid = false, bool reduction_since_parent = false,
+                        char const * reduced_side = "", char const * exposed = "",
+                        bool failure_followup = false) {
+    std::FILE * f = mprwe_stream();
+    if (!f || (mprwe_root_filter() && root != mprwe_root_filter()) || mprwe_global_events >= mprwe_limit()) return;
