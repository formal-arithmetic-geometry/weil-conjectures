+        kind, static_cast<unsigned long long>(root), static_cast<unsigned long long>(id),
+        static_cast<unsigned long long>(parent), depth, head(l).c_str(), head(r).c_str(),
+        static_cast<unsigned long long>(left_hash), static_cast<unsigned long long>(right_hash), category,
+        mprwe_tag(l, category).c_str(), mprwe_tag(r, category).c_str(),
+        static_cast<unsigned long long>(mprwe_fingerprint(l, r, category)), provenance, divergence,
+        div_path,
+        static_cast<unsigned long long>(div_left_hash), static_cast<unsigned long long>(div_right_hash),
+        static_cast<unsigned long long>(parent_div_left_hash), static_cast<unsigned long long>(parent_div_right_hash),
+        static_cast<unsigned long long>(exclusive), static_cast<unsigned long long>(reduction),
+        result ? "true" : "false", phase, sampled ? "true" : "false", child_kind, child_index,
+        child_index_valid ? "true" : "false", reduction_since_parent ? "true" : "false",
+        reduced_side, exposed, failure_followup ? "true" : "false");
+}
+static void mprwe_aggregate() {
