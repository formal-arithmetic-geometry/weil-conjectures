+        std::fprintf(f, "{\"event\":\"aggregate\",\"root\":%llu,\"provenance\":\"%s\",\"path\":\"%s\",\"calls\":%llu,\"exclusive_ns\":%llu,\"reduction_ns\":%llu,\"traced_calls\":%llu,\"traced_exclusive_ns\":%llu,\"total_calls\":%llu,\"root_exclusive_ns\":%llu}\n",
+            static_cast<unsigned long long>(root_id()), item.first.first.c_str(), item.first.second.c_str(),
+            static_cast<unsigned long long>(cost.calls), static_cast<unsigned long long>(cost.exclusive),
+            static_cast<unsigned long long>(cost.reduction), static_cast<unsigned long long>(cost.traced_calls),
+            static_cast<unsigned long long>(cost.traced_exclusive), static_cast<unsigned long long>(data.calls),
+            static_cast<unsigned long long>(data.comparison_exclusive));
+    }
+    for (auto const & item : data.transitions) {
+        auto const & cost = item.second;
+        std::fprintf(f, "{\"event\":\"transition\",\"root\":%llu,\"parent_branch\":\"%s\",\"child_kind\":\"%s\",\"calls\":%llu,\"exclusive_ns\":%llu,\"reduction_ns\":%llu,\"failure_followup\":%llu,\"reduction_before_child\":%llu}\n",
+            static_cast<unsigned long long>(root_id()), branch_names[item.first.first], item.first.second.c_str(),
+            static_cast<unsigned long long>(cost.calls), static_cast<unsigned long long>(cost.exclusive),
+            static_cast<unsigned long long>(cost.reduction), static_cast<unsigned long long>(cost.followup),
+            static_cast<unsigned long long>(cost.reduced));
+    }
+    for (auto const & item : data.label_depth)
+        std::fprintf(f, "{\"event\":\"distribution\",\"root\":%llu,\"label\":\"%s\",\"metric\":\"depth\",\"bucket\":%u,\"calls\":%llu}\n",
+            static_cast<unsigned long long>(root_id()), item.first.first.c_str(), item.first.second,
+            static_cast<unsigned long long>(item.second));
+    for (auto const & item : data.label_fanout)
+        std::fprintf(f, "{\"event\":\"distribution\",\"root\":%llu,\"label\":\"%s\",\"metric\":\"fanout\",\"bucket\":%u,\"calls\":%llu}\n",
+            static_cast<unsigned long long>(root_id()), item.first.first.c_str(), item.first.second,
+            static_cast<unsigned long long>(item.second));
+    std::fprintf(f, "{\"event\":\"coverage\",\"root\":%llu,\"traced_calls\":%llu,\"total_calls\":%llu,\"traced_exclusive_ns\":%llu,\"root_exclusive_ns\":%llu,\"raw_events\":%llu}\n",
+        static_cast<unsigned long long>(root_id()), static_cast<unsigned long long>(data.mprwe_trace_calls),
+        static_cast<unsigned long long>(data.calls), static_cast<unsigned long long>(data.mprwe_trace_exclusive),
+        static_cast<unsigned long long>(data.comparison_exclusive), static_cast<unsigned long long>(data.mprwe_raw_events));
+}
