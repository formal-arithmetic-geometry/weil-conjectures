+static std::string mprwe_tag(expr const & e, unsigned category) {
+    unsigned tags = 0;
+    if (category == 1) tags |= 1;
+    if (category == 2) tags |= 2;
+    if (is_proj(get_app_fn(e))) tags |= 4;
+    std::string h = head(e);
+    if (h.find("inferInstance") != std::string::npos || h.find("inst") != std::string::npos) tags |= 8;
+    if (category == 2) tags |= 16;
+    return std::to_string(tags);
+}
+static uint64_t mprwe_fingerprint(expr const & l, expr const & r, unsigned category) {
+    return (static_cast<uint64_t>(hash(l)) << 32) ^ static_cast<uint64_t>(hash(r)) ^ category;
+}
+struct divergence_info {
+    std::string path;
+    uint64_t left = 0, right = 0;
+    bool present = false;
+};
+static uint64_t mprwe_hash(expr const & e) { return static_cast<uint64_t>(hash(e)); }
+static void mprwe_first_divergence(expr const & l, expr const & r, std::string const & path,
+                                   divergence_info & out) {
+    if (out.present || mprwe_hash(l) == mprwe_hash(r)) return;
+    if (l.kind() != r.kind()) {
+        out = {path, mprwe_hash(l), mprwe_hash(r), true};
+        return;
+    }
+    if (is_app(l)) {
+        mprwe_first_divergence(app_fn(l), app_fn(r), path + "/fn", out);
+        mprwe_first_divergence(app_arg(l), app_arg(r), path + "/arg", out);
+    } else if (is_binding(l)) {
+        mprwe_first_divergence(binding_domain(l), binding_domain(r), path + "/domain", out);
+        mprwe_first_divergence(binding_body(l), binding_body(r), path + "/body", out);
+    } else if (is_let(l)) {
+        mprwe_first_divergence(let_type(l), let_type(r), path + "/type", out);
+        mprwe_first_divergence(let_value(l), let_value(r), path + "/value", out);
+        mprwe_first_divergence(let_body(l), let_body(r), path + "/body", out);
+    } else if (is_mdata(l)) {
+        mprwe_first_divergence(mdata_expr(l), mdata_expr(r), path + "/data", out);
+    } else if (is_proj(l)) {
+        mprwe_first_divergence(proj_expr(l), proj_expr(r), path + "/expr", out);
+    } else {
+        out = {path, mprwe_hash(l), mprwe_hash(r), true};
+    }
+    if (!out.present) out = {path, mprwe_hash(l), mprwe_hash(r), true};
+}
+static std::string mprwe_path_bucket(std::string const & path) {
+    size_t slash = 0, pos = 0;
+    while (slash < 6) {
+        pos = path.find('/', pos);
+        if (pos == std::string::npos) return path;
+        ++pos;
+        ++slash;
+    }
+    return path.substr(0, pos) + "*";
+}
