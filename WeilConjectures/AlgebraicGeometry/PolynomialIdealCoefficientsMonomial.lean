module

public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Algebra.Quotient
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic
import WeilConjectures.AlgebraicGeometry.PolynomialIdealCoefficientsMonomialMembership
import WeilConjectures.AlgebraicGeometry.PolynomialIdealCoefficientsMonomialMap

@[expose] public section

universe u

open MvPolynomial

/-! # Coefficients of a polynomial modulo coordinate generators

## References

* Stacks Project, Tag 07DW.
-/

namespace MvPolynomial

/-- The coefficientwise membership criterion and direct-sum decomposition for the ideal
`J = (g₁x₁, …, gᵢxᵢ)` of `R[x₁, …, x_r]`: the variable `xⱼ` for `j ≤ i` is
`X (Fin.castLE hir j)`, and `I_E` is the ideal generated by the `gⱼ` with `eⱼ > 0`
(Stacks, Tag 07DW). -/
theorem ideal_coefficients_monomial
    {R : Type u} [CommRing R] (r i : ℕ) (hr : 1 ≤ r) (hir : i ≤ r)
    (g : Fin i → R)
    (p : MvPolynomial (Fin r) R) :
    (p ∈ Ideal.span (Set.range fun j : Fin i => C (g j) * X (Fin.castLE hir j)) ↔
        ∀ E : Fin r →₀ ℕ,
          AddMonoidAlgebra.coeff p E ∈ Ideal.span (g '' {j : Fin i | E (Fin.castLE hir j) ≠ 0})) ∧
      ∃ Φ : MvPolynomial (Fin r) R →ₗ[R]
          Π₀ E : Fin r →₀ ℕ, R ⧸ Ideal.span (g '' {j : Fin i | E (Fin.castLE hir j) ≠ 0}),
        (∀ q E, Φ q E = Ideal.Quotient.mk _ (AddMonoidAlgebra.coeff q E)) ∧
        Function.Surjective Φ ∧
        LinearMap.ker Φ = Submodule.restrictScalars R
          (Ideal.span (Set.range fun j : Fin i => C (g j) * X (Fin.castLE hir j))) ∧
        ∃ e : (MvPolynomial (Fin r) R ⧸
            Ideal.span (Set.range fun j : Fin i => C (g j) * X (Fin.castLE hir j))) ≃ₗ[R]
            Π₀ E : Fin r →₀ ℕ, R ⧸ Ideal.span (g '' {j : Fin i | E (Fin.castLE hir j) ≠ 0}),
          ∀ q, e (Ideal.Quotient.mk _ q) = Φ q := by
  refine ⟨ideal_coefficients_monomial_membership r i hr hir g p, ?_⟩
  exact ideal_coefficients_monomial_map r i hr hir g

end MvPolynomial
