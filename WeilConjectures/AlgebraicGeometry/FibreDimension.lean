module

public import WeilConjectures.AlgebraicGeometry.BaseChangeDimension

/-!
# Uniformly bounded fibre dimension

A morphism of finite type `f : X ⟶ Y` with quasi-compact target has fibres of uniformly bounded
dimension: there is `n` such that `dim (X ×_Y Spec L) ≤ n` for every field `L` and every
morphism `Spec L ⟶ Y`. Finitely many affine opens `U` of `X`, each mapping into an affine open
`V` of `Y`, cover `X`; if `Γ(U)` is generated by `n` elements over `Γ(V)`, the base change of `U`
to a field `L` over `V` is the spectrum of an `L`-algebra generated by `n` elements.

## Main statements

- `AlgebraicGeometry.exists_topologicalKrullDim_le_of_isPullback_of_isAffine_of_isAffine`: the
  case of affine `X` and `Y`.
- `AlgebraicGeometry.exists_topologicalKrullDim_le_of_isPullback_of_compactSpace`: the uniform
  bound for a quasi-compact target.
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped TensorProduct

namespace AlgebraicGeometry

/-- The base changes to fields of a morphism of finite type between affine schemes have
bounded dimension: if `Γ(U)` is generated by `n` elements over `Γ(V)`, then every fibre product
`U ×_V Spec L` with `L` a field is the spectrum of an `L`-algebra generated by `n` elements. -/
lemma exists_topologicalKrullDim_le_of_isPullback_of_isAffine_of_isAffine {U V : Scheme.{u}}
    [IsAffine U] [IsAffine V] (g : U ⟶ V) [LocallyOfFiniteType g] :
    ∃ n : ℕ, ∀ (L : Type u) [Field L] (s : Spec (.of L) ⟶ V) {P : Scheme.{u}}
      (p₁ : P ⟶ U) (p₂ : P ⟶ Spec (.of L)), IsPullback p₁ p₂ g s →
      topologicalKrullDim P ≤ n := by
  have hft : RingHom.FiniteType g.appTop.hom :=
    HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType).mp inferInstance
  let := g.appTop.hom.toAlgebra
  have : Algebra.FiniteType Γ(V, ⊤) Γ(U, ⊤) := hft
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.1 this
  refine ⟨n, fun L _ s P p₁ p₂ h ↦ ?_⟩
  let ψ := Spec.preimage (s ≫ V.isoSpec.hom)
  let := ψ.hom.toAlgebra
  have h' : IsPullback (p₁ ≫ U.isoSpec.hom) p₂
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(V, ⊤) Γ(U, ⊤))))
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(V, ⊤) L))) := by
    have := IsPullback.paste_horiz h (IsPullback.of_horiz_isIso (fst := U.isoSpec.hom)
      (g := V.isoSpec.hom) (snd := g) (f := Spec.map g.appTop)
      ⟨Scheme.isoSpec_hom_naturality g⟩)
    have e : s ≫ V.isoSpec.hom = Spec.map ψ := (Spec.map_preimage _).symm
    rw [e] at this
    exact this
  let e := h'.isoPullback ≪≫ pullbackSpecIso Γ(V, ⊤) Γ(U, ⊤) L
  rw [IsHomeomorph.topologicalKrullDim_eq _ e.hom.homeomorph.isHomeomorph]
  change topologicalKrullDim (PrimeSpectrum (Γ(U, ⊤) ⊗[Γ(V, ⊤)] L)) ≤ n
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    ringKrullDim_eq_of_ringEquiv (Algebra.TensorProduct.comm Γ(V, ⊤) Γ(U, ⊤) L).toRingEquiv]
  exact ringKrullDim_tensorProduct_le_of_surjective f hf

/-- If `g ≫ m` and `s ≫ m` have pullback `P` with `m` a monomorphism, then `P` is also a
pullback of `g` and `s`. -/
lemma _root_.CategoryTheory.IsPullback.of_comp_mono {C : Type*} [Category* C] {P U V Y L : C} {p₁ : P ⟶ U}
    {p₂ : P ⟶ L} {g : U ⟶ V} {s : L ⟶ V} {m : V ⟶ Y} [Mono m]
    (h : IsPullback p₁ p₂ (g ≫ m) (s ≫ m)) : IsPullback p₁ p₂ g s := by
  have hb : IsPullback s (𝟙 L) m (s ≫ m) := by
    simpa using (IsPullback.of_vert_isIso (fst := s) (snd := 𝟙 L) (f := 𝟙 V) (g := s)
      ⟨by simp⟩).paste_horiz (IsKernelPair.id_of_mono m)
  refine IsPullback.of_bot (h₁₁ := p₁) (v₁₁ := p₂) (v₂₁ := 𝟙 L) ?_ ?_ hb
  · simpa using h
  · exact (cancel_mono m).1 (by simpa using h.w)

/-- **Uniformly bounded fibre dimension.** For a morphism `f : X ⟶ Y` of finite type with
quasi-compact target, there is `n` such that every base change `X ×_Y Spec L` of `f` to a field
`L` has dimension at most `n`. Finitely many affine opens `U` of `X`, each mapping into an affine
open `V` of `Y`, cover `X`
(`AlgebraicGeometry.exists_topologicalKrullDim_le_of_isPullback_of_isAffine_of_isAffine`). -/
lemma exists_topologicalKrullDim_le_of_isPullback_of_compactSpace {X Y : Scheme.{u}}
    (f : X ⟶ Y) [LocallyOfFiniteType f] [QuasiCompact f] [CompactSpace Y] :
    ∃ n : ℕ, ∀ (L : Type u) [Field L] (s : Spec (.of L) ⟶ Y) {P : Scheme.{u}}
      (p₁ : P ⟶ X) (p₂ : P ⟶ Spec (.of L)), IsPullback p₁ p₂ f s →
      topologicalKrullDim P ≤ n := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  -- the pairs of affine opens `U ⊆ f⁻¹ V`
  let ι := {UV : X.affineOpens × Y.affineOpens // UV.1.1 ≤ f ⁻¹ᵁ UV.2.1}
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun UV : ι ↦ (UV.1.1.1 : Set X))
    (fun UV ↦ UV.1.1.1.isOpen) fun x _ ↦ by
      obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
        Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f x)) isOpen_univ
      obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
        X.isBasis_affineOpens.exists_subset_of_mem_open (a := x) hxV (f ⁻¹ᵁ V).isOpen
      exact Set.mem_iUnion.mpr ⟨⟨(⟨U, hU⟩, ⟨V, hV⟩), hUV⟩, hxU⟩
  choose n hn using fun UV : ι ↦
    have : IsAffine UV.1.1.1 := UV.1.1.2
    have : IsAffine UV.1.2.1 := UV.1.2.2
    exists_topologicalKrullDim_le_of_isPullback_of_isAffine_of_isAffine
      (f.resLE UV.1.2.1 UV.1.1.1 UV.2)
  refine ⟨t.sup n, fun L _ s P p₁ p₂ h ↦ ?_⟩
  refine topologicalKrullDim_le_of_iSup_eq_top (fun UV : t ↦ p₁ ⁻¹ᵁ UV.1.1.1.1) ?_ _
    fun UV ↦ ?_
  · refine eq_top_iff.mpr fun x _ ↦ ?_
    obtain ⟨UV, hUV, hxU⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ (p₁ x)))
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨UV, hUV⟩, hxU⟩
  obtain ⟨⟨⟨⟨U, hU⟩, ⟨V, hV⟩⟩, hUV⟩, hUVt⟩ := UV
  by_cases hP : Nonempty (p₁ ⁻¹ᵁ U : Set P)
  · obtain ⟨⟨z, hz⟩⟩ := hP
    -- the point of `Spec L` lies over `V`, so `s` factors through `V`
    have hs : Set.range s ⊆ Set.range V.ι := by
      rintro _ ⟨w, rfl⟩
      rw [Scheme.Opens.range_ι]
      have hw : w = p₂ z := Subsingleton.elim _ _
      rw [hw, ← Scheme.Hom.comp_apply, ← h.w, Scheme.Hom.comp_apply]
      exact hUV hz
    let s' := IsOpenImmersion.lift V.ι s hs
    have : IsAffine U := hU
    have : IsAffine V := hV
    have h' := (isPullback_morphismRestrict p₁ U).paste_vert h
    rw [← Scheme.Hom.resLE_comp_ι (e := hUV), ← IsOpenImmersion.lift_fac V.ι s hs] at h'
    have := hn ⟨(⟨U, hU⟩, ⟨V, hV⟩), hUV⟩ L s' _ _ (IsPullback.of_comp_mono h')
    exact this.trans (by exact_mod_cast Finset.le_sup (f := n) hUVt)
  · have : IsEmpty (TopologicalSpace.IrreducibleCloseds (p₁ ⁻¹ᵁ U : Set P)) :=
      ⟨fun Z ↦ hP (let ⟨z, _⟩ := Z.isIrreducible.nonempty; ⟨z⟩)⟩
    exact (Order.krullDim_eq_bot (α := TopologicalSpace.IrreducibleCloseds _)).trans_le bot_le

end AlgebraicGeometry
