module
public import Mathlib.CategoryTheory.Adjunction.Additive
public import Mathlib.RingTheory.Finiteness.Basic
public import WeilConjectures.AlgebraicGeometry.RingComplexCechData
public import WeilConjectures.CategoryTheory.HomotopyCategory.Adjunction
public import WeilConjectures.CategoryTheory.RingedExtendedCech

/-!
# Sheafifying a functorial ring complex on a generating slice

Source: Stacks Project, algebraization.tex, Tag 099E, the construction of K_{U,I}.

The ring complex family and its transition maps are parameters. No family or transition
map is chosen from an existence theorem in these definitions.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry

namespace CategoryTheory

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable (O : Sheaf J CommRingCat.{u})
variable (K : RingComplexFamily.{u}) (ε : RingComplexAugmentations K)
variable (m : RingComplexMaps K) (hm : RingComplexFunctorial K ε m)
variable (r : ℕ) (f : Fin r → (O.obj ⋙ forget CommRingCat).sections)

/-- The ideal generated by the values of the specified finite list.
Source: Stacks Project, Tag 099E, K_{U,I}. -/
def ringFamilySectionIdeal (X : Cᵒᵖ) : {I : Ideal (O.obj.obj X) // I.FG} :=
  ⟨Ideal.span (Set.range (fun i ↦ (f i).val X)),
    Submodule.fg_span (Set.finite_range _)⟩

/-- Restricting the generating sections extends their generated ideal.
Source: Stacks Project, Tag 099E, K_{U,I}.
Proof: ideal map commutes with span, and each section satisfies its restriction equation. -/
theorem ringFamilySectionIdeal_map {X Y : Cᵒᵖ} (a : X ⟶ Y) :
    (ringFamilySectionIdeal O r f X).val.map (O.obj.map a).hom =
      (ringFamilySectionIdeal O r f Y).val := by
  dsimp only [ringFamilySectionIdeal]
  rw [Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  exact (f i).property a

/-- Degree n of the presheaf V ↦ K(O(V), (f_1..,f_r)O(V)).
Source: Stacks Project, Tag 099E, K_{U,I}. -/
def ringFamilyPresheafTerm (n : ℤ) :
    PresheafOfModules.{u} ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj where
  obj X := ((K (O.obj.obj X) (ringFamilySectionIdeal O r f X)).X n).val.obj
    (op ⟨PUnit.unit⟩)
  map {X Y} a :=
    (ModuleCat.semilinearMapAddEquiv (O.obj.map a).hom _ _)
      (m (O.obj.obj X) (O.obj.obj Y) (O.obj.map a).hom
        (ringFamilySectionIdeal O r f X) (ringFamilySectionIdeal O r f Y)
        (ringFamilySectionIdeal_map O r f a) n)
  map_id X := by
    ext x
    change m (O.obj.obj X) (O.obj.obj X) (O.obj.map (𝟙 X)).hom
      (ringFamilySectionIdeal O r f X) (ringFamilySectionIdeal O r f X)
      (ringFamilySectionIdeal_map O r f (𝟙 X)) n x = x
    have hφ : (O.obj.map (𝟙 X)).hom = RingHom.id (O.obj.obj X) := by
      rw [O.obj.map_id]
      rfl
    generalize ringFamilySectionIdeal_map O r f (𝟙 X) = h
    revert h
    rw [hφ]
    intro h
    exact hm.2.2.1 _ _ h n x
  map_comp {X Y Z} a b := by
    ext x
    change m (O.obj.obj X) (O.obj.obj Z) (O.obj.map (a ≫ b)).hom
      (ringFamilySectionIdeal O r f X) (ringFamilySectionIdeal O r f Z)
      (ringFamilySectionIdeal_map O r f (a ≫ b)) n x =
        m (O.obj.obj Y) (O.obj.obj Z) (O.obj.map b).hom
          (ringFamilySectionIdeal O r f Y) (ringFamilySectionIdeal O r f Z)
          (ringFamilySectionIdeal_map O r f b) n
            (m (O.obj.obj X) (O.obj.obj Y) (O.obj.map a).hom
              (ringFamilySectionIdeal O r f X) (ringFamilySectionIdeal O r f Y)
              (ringFamilySectionIdeal_map O r f a) n x)
    have hφ : (O.obj.map (a ≫ b)).hom = (O.obj.map b).hom.comp (O.obj.map a).hom := by
      rw [O.obj.map_comp]
      rfl
    generalize ringFamilySectionIdeal_map O r f (a ≫ b) = h
    revert h
    rw [hφ]
    intro h
    exact (hm.2.2.2 _ _ _ _ _ _ _ _ _ _ h n x).symm

/-- The ring-family differential, section by section.
Source: Stacks Project, Tag 099E, K_{U,I}. -/
def ringFamilyPresheafDifferential (n k : ℤ) :
    ringFamilyPresheafTerm O K ε m hm r f n ⟶ ringFamilyPresheafTerm O K ε m hm r f k where
  app X := ((K (O.obj.obj X) (ringFamilySectionIdeal O r f X)).d n k).val.app
    (op ⟨PUnit.unit⟩)
  naturality {X Y} a := by
    ext x
    exact (hm.1 _ _ _ _ _ (ringFamilySectionIdeal_map O r f a) n k x).symm

/-- The actual presheaf complex attached to the generating list.
Source: Stacks Project, Tag 099E, K_{U,I}. -/
def ringFamilyPresheafComplex :
    CochainComplex (PresheafOfModules.{u}
      ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj) ℤ where
  X := ringFamilyPresheafTerm O K ε m hm r f
  d := ringFamilyPresheafDifferential O K ε m hm r f
  shape n k h := by
    ext X x
    change ((K (O.obj.obj X) (ringFamilySectionIdeal O r f X)).d n k).val.app _ x = 0
    rw [HomologicalComplex.shape _ n k h]
    rfl
  d_comp_d' n k l _ _ := by
    ext X x
    have h := congrArg (fun z ↦ z.val.app (op ⟨PUnit.unit⟩))
      ((K (O.obj.obj X) (ringFamilySectionIdeal O r f X)).d_comp_d n k l)
    exact ConcreteCategory.congr_hom h x

/-- The degree-zero augmentation of the presheaf complex.
Source: Stacks Project, Tag 099E, K_{U,I}. -/
def ringFamilyPresheafAugmentationZero :
    ringFamilyPresheafTerm O K ε m hm r f 0 ⟶
      (SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars
        (𝟙 ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj)).obj
          (SheafOfModules.unit ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O)) where
  app X := ((ε (O.obj.obj X) (ringFamilySectionIdeal O r f X)).f 0).val.app
      (op ⟨PUnit.unit⟩) ≫
        ((HomologicalComplex.singleObjXSelf (.up ℤ) 0
          (ringComplexUnit (O.obj.obj X))).hom).val.app (op ⟨PUnit.unit⟩)
  naturality {X Y} a := by
    ext x
    exact hm.2.1 _ _ _ _ _ (ringFamilySectionIdeal_map O r f a) x

/-- The augmentation annihilates boundaries, because the ring-family augmentations
are chain maps.
Source: Stacks Project, Tag 099E, K_{U,I}.
Proof: evaluate the chain equation at each section object; the differential in the
single-degree target is zero. -/
theorem ringFamilyPresheafAugmentationZero_closed (i : ℤ)
    (_hi : (ComplexShape.up ℤ).Rel i 0) :
    (ringFamilyPresheafComplex O K ε m hm r f).d i 0 ≫
      ringFamilyPresheafAugmentationZero O K ε m hm r f = 0 := by
  ext X x
  have h := (ε (O.obj.obj X) (ringFamilySectionIdeal O r f X)).comm i 0
  rw [HomologicalComplex.single_obj_d, comp_zero] at h
  have hx := ConcreteCategory.congr_hom
    (congrArg (fun z ↦ z.val.app (op ⟨PUnit.unit⟩)) h) x
  change (0 : ((ringComplexSingle (O.obj.obj X)).X 0).val.obj (op ⟨PUnit.unit⟩)) =
    ((ε (O.obj.obj X) (ringFamilySectionIdeal O r f X)).f 0).val.app (op ⟨PUnit.unit⟩)
      (((K (O.obj.obj X) (ringFamilySectionIdeal O r f X)).d i 0).val.app
        (op ⟨PUnit.unit⟩) x) at hx
  let t := ((HomologicalComplex.singleObjXSelf (.up ℤ) 0
    (ringComplexUnit (O.obj.obj X))).hom.val.app (op ⟨PUnit.unit⟩)).hom
  exact (congrArg t hx.symm).trans (map_zero t)

/-- The augmented presheaf complex, with target the underlying ring complex.
Source: Stacks Project, Tag 099E, K_{U,I}. -/
def ringFamilyPresheafAugmentation :
    ringFamilyPresheafComplex O K ε m hm r f ⟶
      ((SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars
        (𝟙 ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj)).mapHomologicalComplex
          (.up ℤ)).obj (ringedSiteRingComplex O) :=
  HomologicalComplex.mkHomToSingle (ringFamilyPresheafAugmentationZero O K ε m hm r f)
    (ringFamilyPresheafAugmentationZero_closed O K ε m hm r f) ≫
      ((HomologicalComplex.singleMapHomologicalComplex
        (SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars
          (𝟙 ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj)) (.up ℤ) 0).app
            (SheafOfModules.unit
              ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O))).inv

/-- The actual degreewise sheafification of the augmented functorial ring complex.
The augmentation is the adjoint transpose of the presheaf augmentation.
Source: Stacks Project, Tag 099E, the sheafification of K_{U,I}. -/
def ringFamilySheafModel : Σ L : ringedSiteComplex O, L ⟶ ringedSiteRingComplex O :=
  let adj := PresheafOfModules.sheafificationAdjunction
    (𝟙 ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj)
  let S := PresheafOfModules.sheafification
    (𝟙 ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O).obj)
  letI : S.Additive := adj.left_adjoint_additive
  ⟨(S.mapHomologicalComplex (.up ℤ)).obj
      (ringFamilyPresheafComplex O K ε m hm r f),
    ((adj.mapHomologicalComplex (.up ℤ)).homEquiv _ _).symm
      (ringFamilyPresheafAugmentation O K ε m hm r f)⟩

end CategoryTheory
