/-!
# The derived Čech comparison for a sheafified Godement ring model

Source: Stacks Project, algebraization.tex, Tags 099D(c),(d) and 099E, final paragraph.
-/

@[expose] public section
set_option autoImplicit false

universe u w

open CategoryTheory AlgebraicGeometry

namespace CategoryTheory

/-- On a ringed site with a finite list of global ring sections, sheafifying the Godement
ring model of the ideal generated by that list gives the augmented extended Čech complex.
Source: Stacks Project, Tags 099D(c),(d) and 099E.

Proof: let A be the ring of global sections of O, and I the ideal generated by the given
finite global list. Give the one-object module categories their standard derived categories.
The Godement ring complex has an augmented ordered localization model by
ringComplex_godement_cech. Choose a K-flat replacement P of K(A,I). For every section ring
O(V), the specified semilinear maps, composed with P → K(A,I), extend to scalar-extension
chain maps. Functoriality makes these natural in V and their augmentation square holds on
pure tensors. The theorem ringComplex_cech_baseChange_quasiIso makes them quasi-isomorphisms.
Exact degreewise module sheafification preserves these quasi-isomorphisms.

For the other comparison, the ordered ring Čech model is a bounded complex of flat
A-modules. Its derived scalar extension to O is therefore the ordinary scalar extension.
Identify a tensor of one-element two-term complexes by the subset of positions in which
the degree-one term was chosen. In total degree q, these are exactly the increasing
q-element subsets. Tensoring the localization factors gives localization at the product:
the fraction map sends (a/s) ⊗ b to φ(a)b/φ(s), with inverse b/φ(s) ↦ (1/s) ⊗ b.
These maps commute with all localization arrows. The tensor differential inserting an
index j has sign (-1) to the number of previously chosen indices less than j, exactly the
ordered alternating Čech sign. In degree zero the comparison is the identity of O, so it
also respects the augmentation. Thus the scalar-extended ordered model is the specified
ringedExtendedCech. Compose the two derived comparisons. Empty lists give O[0], repeated
and zero generators obey the same subset and fraction formulas, and localization in the
zero ring causes no exception. -/
theorem ringFamilySheafModel_cech
    {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    (O : Sheaf J CommRingCat.{u})
    [HasDerivedCategory.{w} (ringedSiteModules.{u}
      ((sheafCompose J (forget₂ CommRingCat RingCat)).obj O))]
    (m : RingComplexMaps (fun A I ↦ ringComplexGodement A I.val))
    (hm : RingComplexFunctorial (fun A I ↦ ringComplexGodement A I.val)
      (fun A I ↦ ringComplexGodementAugmentation A I.val) m)
    (r : ℕ) (f : Fin r → (O.obj ⋙ forget CommRingCat).sections) :
    ∃ e : DerivedCategory.Q.obj (ringedExtendedCech O r f).1 ≅
        DerivedCategory.Q.obj
          (ringFamilySheafModel O (fun A I ↦ ringComplexGodement A I.val)
            (fun A I ↦ ringComplexGodementAugmentation A I.val) m hm r f).1,
      e.hom ≫ DerivedCategory.Q.map
          (ringFamilySheafModel O (fun A I ↦ ringComplexGodement A I.val)
            (fun A I ↦ ringComplexGodementAugmentation A I.val) m hm r f).2 =
        DerivedCategory.Q.map (ringedExtendedCech O r f).2 := by
  let A := ringFamilyGlobalRing O
  let I := ringFamilyGlobalIdeal O r f
  let K : RingComplexFamily.{u} := fun A I ↦ ringComplexGodement A I.val
  let ε : RingComplexAugmentations K := fun A I ↦ ringComplexGodementAugmentation A I.val
  let inst (B : CommRingCat.{u}) : HasDerivedCategory (RingSiteModules B) :=
    HasDerivedCategory.standard _
  have hK (B : CommRingCat.{u}) (L : {I : Ideal B // I.FG}) :
      RingComplexHasCechModel B L.val (K B L) (ε B L) :=
    ringComplex_godement_cech B L
  obtain ⟨P, p, hflat, _, hp, _⟩ :=
    CochainComplex.exists_isKFlatResolutionIndependentCoefficients (K A I)
  have hP : RingComplexHasCechModel A I.val P (p ≫ ε A I) :=
    ringComplexHasCechModel_of_quasiIso (ε A I) p hp (hK A I)
  let q := ringFamilyGlobalComparison O K ε m hm r f P p
  obtain ⟨hq, haug⟩ :=
    ringFamilyGlobalExtension_to_family O K ε m hm hK r f P p hp hflat
  obtain ⟨e, he⟩ := ringFamilyGlobalExtension_cech O r f P (p ≫ ε A I) hflat hP
  let : QuasiIso q := hq
  refine ⟨e ≪≫ asIso (DerivedCategory.Q.map q), ?_⟩
  calc
    (e ≪≫ asIso (DerivedCategory.Q.map q)).hom ≫
        DerivedCategory.Q.map (ringFamilySheafModel O K ε m hm r f).2 =
        e.hom ≫ DerivedCategory.Q.map
          (q ≫ (ringFamilySheafModel O K ε m hm r f).2) := by
      simp only [Iso.trans_hom, asIso_hom, Functor.map_comp, Category.assoc]
    _ = e.hom ≫ DerivedCategory.Q.map
        (ringFamilyGlobalExtensionAugmentation O (p ≫ ε A I)) := by rw [haug]
    _ = DerivedCategory.Q.map (ringedExtendedCech O r f).2 := he

end CategoryTheory
