module

public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
public import Mathlib.AlgebraicGeometry.Properties
public import Mathlib.AlgebraicGeometry.Pullbacks
public import WeilConjectures.Mathlib.RingTheory.FiniteStability
public import WeilConjectures.Mathlib.Topology.KrullDimension

/-!
# Dimension of base changes of schemes of finite type over a field

A quasi-compact scheme `X` locally of finite type over a field `K` stays of bounded dimension
under every field extension: there is `n` with `dim (X ×_K L) ≤ n` for every field `L` over `K`.
Each of finitely many affine opens of `X` is the spectrum of a `K`-algebra generated by
finitely many elements, and its base change is generated by as many over `L`.

## Main statements

- `AlgebraicGeometry.exists_topologicalKrullDim_le_of_isPullback`
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped TensorProduct

namespace AlgebraicGeometry

/-- The base changes of an affine scheme of finite type over a field `K` to fields `L` have
bounded dimension. -/
lemma exists_topologicalKrullDim_le_of_isPullback_of_isAffine {K : Type u} [Field K]
    {U : Scheme.{u}} [IsAffine U] (g : U ⟶ Spec (.of K)) [LocallyOfFiniteType g] :
    ∃ n : ℕ, ∀ (L : Type u) [Field L] (s : Spec (.of L) ⟶ Spec (.of K)) {P : Scheme.{u}}
      (p₁ : P ⟶ U) (p₂ : P ⟶ Spec (.of L)), IsPullback p₁ p₂ g s →
      topologicalKrullDim P ≤ n := by
  let g' : Spec Γ(U, ⊤) ⟶ Spec (.of K) := U.isoSpec.inv ≫ g
  let φ := Spec.preimage g'
  have hg : LocallyOfFiniteType (Spec.map φ) := by
    rw [Spec.map_preimage]; infer_instance
  have hφ : φ.hom.FiniteType := by
    rwa [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)] at hg
  let := φ.hom.toAlgebra
  have : Algebra.FiniteType K Γ(U, ⊤) := hφ
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.1 this
  refine ⟨n, fun L _ s P p₁ p₂ h ↦ ?_⟩
  let ψ := Spec.preimage s
  let := ψ.hom.toAlgebra
  have h' : IsPullback (p₁ ≫ U.isoSpec.hom) p₂
      (Spec.map (CommRingCat.ofHom (algebraMap K Γ(U, ⊤))))
      (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
    have := IsPullback.paste_horiz h (IsPullback.of_horiz_isIso (fst := U.isoSpec.hom)
      (g := 𝟙 _) (snd := g) (f := g') ⟨by simp [g']⟩)
    rw [Category.comp_id] at this
    convert this using 2 <;> exact Spec.map_preimage _
  let e := h'.isoPullback ≪≫ pullbackSpecIso K Γ(U, ⊤) L
  rw [IsHomeomorph.topologicalKrullDim_eq _ e.hom.homeomorph.isHomeomorph]
  change topologicalKrullDim (PrimeSpectrum (Γ(U, ⊤) ⊗[K] L)) ≤ n
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    ringKrullDim_eq_of_ringEquiv (Algebra.TensorProduct.comm K Γ(U, ⊤) L).toRingEquiv]
  exact ringKrullDim_tensorProduct_le_of_surjective f hf

/-- **Bounded dimension of base changes.** For a quasi-compact scheme `X` locally of finite type
over a field `K` there is `n` such that every base change `X ×_K L` of `X` to a field `L` has
dimension at most `n`: finitely many affine opens cover `X`, and the base change of each is
the spectrum of an `L`-algebra generated by as many elements as the affine open over `K`. -/
lemma exists_topologicalKrullDim_le_of_isPullback {K : Type u} [Field K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ n : ℕ, ∀ (L : Type u) [Field L] (s : Spec (.of L) ⟶ Spec (.of K)) {P : Scheme.{u}}
      (p₁ : P ⟶ X) (p₂ : P ⟶ Spec (.of L)), IsPullback p₁ p₂ f s →
      topologicalKrullDim P ≤ n := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun U : X.affineOpens ↦ (U : Set X))
    (fun U ↦ U.1.isOpen) fun x _ ↦ by
      obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
        X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
      exact Set.mem_iUnion.mpr ⟨⟨U, hU⟩, hxU⟩
  choose n hn using fun U : X.affineOpens ↦
    have : IsAffine U.1 := U.2
    exists_topologicalKrullDim_le_of_isPullback_of_isAffine (U.1.ι ≫ f)
  refine ⟨t.sup n, fun L _ s P p₁ p₂ h ↦ ?_⟩
  refine topologicalKrullDim_le_of_iSup_eq_top (fun U : t ↦ p₁ ⁻¹ᵁ U.1.1) ?_ _ fun U ↦ ?_
  · refine eq_top_iff.mpr fun x _ ↦ ?_
    obtain ⟨U, hU, hxU⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ (p₁ x)))
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hxU⟩
  · have := hn U.1 L s _ _ ((isPullback_morphismRestrict p₁ U.1.1).paste_vert h)
    exact this.trans (by exact_mod_cast Finset.le_sup (f := n) U.2)

end AlgebraicGeometry
