import all WeilConjectures.Algebra.Category.ModuleCat.Sheaf.TensorProduct

/-! # Level-`n` scalar extension is generated by basis multiples of the unit

At level `n` the ordinary scalar extension of a module system is the change of rings of the
evaluated module along the finite free constant ring map. Its sections are locally sums of
pure tensors, and constant coefficients decompose in a basis, so the basis multiples of the
ordinary scalar unit generate it as an abelian sheaf.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.ProEtale.SpTowerClasses
attribute [local implicit_reducible] spCoefficientCommRings SpTowerShriek.tau lineModule

variable (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
  [Algebra (Padic l) E] [FiniteDimensional (Padic l) E]

/-- The level-`n` scalar extension is the change of rings of the evaluated module. -/
theorem levelExtension_comparison {T : Scheme.{u}} (c : Chern l E T)
    (M : Systems T (Rrings l T)) (n : ℕ) :
    ∃ e : SheafOfModules.changeOfRings.{u, u + 1, u + 1} (coefficientMap l E T n)
        ((WeilConjectures.SemilinearSections.evaluation.{u + 1, u, u + 1}
          (Scheme.ProEt.topology T) (fun n ↦ (Rrings l T).obj (op n))
          (fun n ↦ (Rrings l T).map (homOfLE (Nat.le_succ n)).op) n).obj M) ≅
        (SpTowerShriek.ev l E T n).obj (c.scalar.model.E.obj M),
      ∀ (U : T.ProEtᵒᵖ) (x : M.val.obj (op (n, U.unop))),
        e.hom.val.app U (WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
          (coefficientMap l E T n) _ U x) =
        WeilConjectures.SemilinearSections.scalarExtensionSection.{u + 1, u, u + 1}
          (coefficientSystemMap l E T) c.scalar M (op (n, U.unop)) x :=
  WeilConjectures.SemilinearSections.scalarExtension_evaluation_comparison.{u + 1, u, u + 1}
    (Scheme.ProEt.topology T) (fun n ↦ (Rrings l T).obj (op n)) (SpTowerShriek.B l E T)
    (fun n ↦ (Rrings l T).map (homOfLE (Nat.le_succ n)).op) (SpTowerShriek.tau l E T)
    (coefficientMap l E T) (coefficientSystemMap l E T)
    (WeilConjectures.SemilinearSections.systemMap_existsUnique.{u + 1, u, u + 1} _ _ _
      (SpTowerShriek.B l E T) (SpTowerShriek.tau l E T)
      (coefficientMap l E T) (coefficientMap_transition l E T)).exists.choose_spec
    c.scalar M n

theorem eqToHom_val_symm_apply {C : Type*} [Category C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{u + 1}} {A B : SheafOfModules.{u + 1} R} (h : A = B) (U : Cᵒᵖ)
    (z : A.val.obj U) : (eqToHom h.symm).val.app U ((eqToHom h).val.app U z) = z := by
  subst h
  rfl

/-- The ordinary scalar unit is the scalar-extension generator section. -/
theorem _root_.WeilConjectures.SemilinearSections.ScalarData.unit_section'
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    [EssentiallySmall.{u + 1} C] {R R' : Sheaf J CommRingCat.{u + 1}} {φ : R ⟶ R'}
    (S : WeilConjectures.SemilinearSections.ScalarData.{u + 1, u, u + 1} φ)
    (M : WeilConjectures.SemilinearSections.Mod.{u + 1, u, u + 1} J R) (U : Cᵒᵖ)
    (x : M.val.obj U) :
    (S.ordinaryAdjunction.unit.app M).val.app U x =
      WeilConjectures.SemilinearSections.scalarExtensionSection.{u + 1, u, u + 1} φ S M U x := by
  unfold WeilConjectures.SemilinearSections.scalarExtensionSection
  rw [← S.unit_section M U x, eqToHom_val_symm_apply]

set_option maxHeartbeats 1000000 in
-- The evaluated system and its coefficient presentations need extra unification time.
/-- The basis component of the level map sends a section to the basis multiple of its
extension generator. -/
theorem levelBasis_component_section {T : Scheme.{u}} (c : Chern l E T)
    (M : Systems T (Rrings l T)) (n : ℕ)
    (e0 : SheafOfModules.changeOfRings.{u, u + 1, u + 1} (coefficientMap l E T n)
        ((WeilConjectures.SemilinearSections.evaluation.{u + 1, u, u + 1}
          (Scheme.ProEt.topology T) (fun n ↦ (Rrings l T).obj (op n))
          (fun n ↦ (Rrings l T).map (homOfLE (Nat.le_succ n)).op) n).obj M) ≅
        (SpTowerShriek.ev l E T n).obj (c.scalar.model.E.obj M))
    (he0 : ∀ (U : T.ProEtᵒᵖ) (x : M.val.obj (op (n, U.unop))),
        e0.hom.val.app U (WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
          (coefficientMap l E T n) _ U x) =
        WeilConjectures.SemilinearSections.scalarExtensionSection.{u + 1, u, u + 1}
          (coefficientSystemMap l E T) c.scalar M (op (n, U.unop)) x)
    (b : SpTowerShriek.R l E n) (V : T.ProEtᵒᵖ) (x : M.val.obj (op (n, V.unop)))
    (x' : ((c.reduction.forget.F.obj M).obj (op n)).obj.obj V) (hx : HEq x' x) :
    (((abEvaluation T n).map (c.reduction.forget.F.map
        (c.scalar.ordinaryAdjunction.unit.app M)) ≫
      (finiteScalarForgetIso l E c n).hom.app (c.scalar.model.E.obj M) ≫
      levelSmul l E T n b (c.scalar.model.E.obj M) ≫
      (finiteForget l E T n).map e0.inv).hom.app V x') =
      constSection l E T n b V • WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
          (coefficientMap l E T n) _ V x := by
  have h1 := finiteBoundary_forgetMapSection T (Rrings l T) c.reduction.forget
    (c.scalar.ordinaryAdjunction.unit.app M) n V x x' hx
  have h2 := finiteScalarForgetIso_section l E c n (c.scalar.model.E.obj M) V _ _ h1
  rw [WeilConjectures.SemilinearSections.ScalarData.unit_section'] at h2
  have h3 := congrArg (e0.inv.val.app V) (he0 V x)
  have h4 : e0.inv.val.app V (e0.hom.val.app V
      (WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
        (coefficientMap l E T n) _ V x)) =
      WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
        (coefficientMap l E T n) _ V x :=
    congrArg (fun k ↦ k.val.app V (WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u,
      u + 1} (coefficientMap l E T n) _ V x)) e0.hom_inv_id
  dsimp [levelSmul, sectionSmul]
  erw [h2]
  exact ((e0.inv.val.app V).hom.map_smul _ _).trans (congrArg _ (h3.symm.trans h4))

section ImageSieve

variable {C : Type*} [Category C] {J : GrothendieckTopology C}
  {F G : Cᵒᵖ ⥤ AddCommGrpCat.{u + 1}} (f : F ⟶ G)

theorem imageSieve_zero_mem {U : C} : Presheaf.imageSieve f (0 : G.obj (op U)) ∈ J U :=
  J.superset_covering (fun V g _ ↦ ⟨0, by simp⟩) (J.top_mem U)

theorem imageSieve_add_mem {U : C} {s t : G.obj (op U)}
    (hs : Presheaf.imageSieve f s ∈ J U) (ht : Presheaf.imageSieve f t ∈ J U) :
    Presheaf.imageSieve f (s + t) ∈ J U := by
  refine J.superset_covering ?_ (J.intersection_covering hs ht)
  rintro V g ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
  exact ⟨a + b, by simp [ha, hb]⟩

theorem imageSieve_sum_mem {U : C} {ι : Type*} (I : Finset ι) (s : ι → G.obj (op U))
    (hs : ∀ i, Presheaf.imageSieve f (s i) ∈ J U) :
    Presheaf.imageSieve f (∑ i ∈ I, s i) ∈ J U := by
  classical
  induction I using Finset.induction_on with
  | empty => simpa using imageSieve_zero_mem f
  | insert i I hi ih =>
    rw [Finset.sum_insert hi]
    exact imageSieve_add_mem f (hs i) ih

theorem imageSieve_mem_of_cover {U : C} (s : G.obj (op U)) (S : Sieve U) (hS : S ∈ J U)
    (h : ∀ ⦃V : C⦄ (g : V ⟶ U), S g → Presheaf.imageSieve f (G.map g.op s) ∈ J V) :
    Presheaf.imageSieve f s ∈ J U :=
  J.transitive hS _ (fun V g hg ↦ by rw [Presheaf.pullback_imageSieve]; exact h g hg)

end ImageSieve

/-- A constant section of the finite coefficient ring is the combination of the constant
basis sections with constant residue coefficients. -/
theorem toSheafify_basis_expansion {T : Scheme.{u}} (n d : ℕ)
    (e : letI := coefficientZModAlgebra l E n
      Module.Basis (Fin d) (ZMod (l ^ (n + 1))) (SpTowerShriek.R l E n))
    (W : T.ProEtᵒᵖ) (a : ULift.{u + 1} (SpTowerShriek.R l E n)) :
    (toSheafify (Scheme.ProEt.topology T) ((Functor.const T.ProEtᵒᵖ).obj
      (CommRingCat.of (ULift.{u + 1} (SpTowerShriek.R l E n))))).app W a =
      ∑ i, (show (SpTowerShriek.B l E T n).obj.obj W from (coefficientMap l E T n).hom.app W
        ((toSheafify (Scheme.ProEt.topology T) ((Functor.const T.ProEtᵒᵖ).obj
          (CommRingCat.of (ULift.{u + 1} (ZMod (l ^ (n + 1))))))).app W
            (ULift.up (letI := coefficientZModAlgebra l E n; e.repr a.down i)))) *
        (show (SpTowerShriek.B l E T n).obj.obj W from constSection l E T n (e i) W) := by
  let := coefficientZModAlgebra l E n
  have ha : a = ∑ i, ULift.up (algebraMap (ZMod (l ^ (n + 1))) (SpTowerShriek.R l E n)
      (e.repr a.down i)) * ULift.up (e i) := by
    apply ULift.ringEquiv.injective
    rw [map_sum]
    simp only [map_mul]
    change a.down = ∑ i, algebraMap (ZMod (l ^ (n + 1))) (SpTowerShriek.R l E n)
      (e.repr a.down i) * e i
    simp_rw [← Algebra.smul_def]
    exact (e.sum_repr a.down).symm
  conv_lhs => rw [ha]
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [map_mul]
  congr 1
  exact (ConcreteCategory.congr_hom (congr_app (toSheafify_naturality
    (Scheme.ProEt.topology T) ((Functor.const T.ProEtᵒᵖ).map (CommRingCat.ofHom
      (ULift.ringEquiv.{u, u + 1}.symm.toRingHom.comp
        ((ZMod.castHom (ringChar.dvd (coefficient_annihilates l E n))
          (SpTowerShriek.R l E n)).comp ULift.ringEquiv.{0, u + 1}.toRingHom))))) W)
    (ULift.up (e.repr a.down i)))

/-- The level change of rings is locally generated by the basis multiples of the
extension generators. -/
theorem extension_basis_imageSieve {T : Scheme.{u}} (n d : ℕ)
    (e : letI := coefficientZModAlgebra l E n
      Module.Basis (Fin d) (ZMod (l ^ (n + 1))) (SpTowerShriek.R l E n))
    (Q : WeilConjectures.SemilinearSections.Mod.{u + 1, u, u + 1} (Scheme.ProEt.topology T)
      (Rlevel l T n))
    {X : Sheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u + 1}}
    (f : X ⟶ (SheafOfModules.toSheaf _).obj
      (SheafOfModules.changeOfRings.{u, u + 1, u + 1} (coefficientMap l E T n) Q))
    (hgen : ∀ (V : T.ProEtᵒᵖ) (i : Fin d) (x : Q.val.obj V),
      Presheaf.imageSieve f.hom (constSection l E T n (e i) V •
        WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
          (coefficientMap l E T n) Q V x) ∈ Scheme.ProEt.topology T V.unop)
    (U : T.ProEtᵒᵖ)
    (s : (SheafOfModules.changeOfRings.{u, u + 1, u + 1} (coefficientMap l E T n) Q).val.obj U) :
    Presheaf.imageSieve f.hom s ∈ Scheme.ProEt.topology T U.unop := by
  let J := Scheme.ProEt.topology T
  let P0 := SheafOfModules.changeOfRingsPresheaf.{u, u + 1, u + 1} (coefficientMap l E T n) Q
  have hP (V : T.ProEtᵒᵖ) (p : P0.obj V) : Presheaf.imageSieve f.hom
      ((toSheafify J P0.presheaf).app V p) ∈ J V.unop := by
    induction p using TensorProduct.induction_on with
    | zero =>
      rw [map_zero]
      exact imageSieve_zero_mem _
    | add p q hp hq =>
      rw [map_add]
      exact imageSieve_add_mem _ hp hq
    | tmul a x =>
      have : J.WEqualsLocallyBijective CommRingCat.{u + 1} :=
        GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall (A := CommRingCat.{u + 1}) J
      refine imageSieve_mem_of_cover _ _ _ (Presheaf.imageSieve_mem J (toSheafify J
        ((Functor.const T.ProEtᵒᵖ).obj (CommRingCat.of (ULift.{u + 1} (SpTowerShriek.R l E n)))))
          (U := V) a) ?_
      rintro W g ⟨α0, hα0⟩
      have hn := NatTrans.naturality_apply (toSheafify J P0.presheaf) g.op (a ⊗ₜ x)
      have key : Presheaf.imageSieve f.hom ((toSheafify J P0.presheaf).app (op W)
          (P0.presheaf.map g.op (a ⊗ₜ x))) ∈ J W := by
        have ht := SheafOfModules.changeOfRingsMap_tmul (coefficientMap l E T n) Q g.op a x
        let := coefficientZModAlgebra l E n
        erw [ht, ← hα0, toSheafify_basis_expansion l E n d e (op W) α0,
          TensorProduct.sum_tmul (R := (Rlevel l T n).obj.obj (op W))
            (M := (ModuleCat.restrictScalars ((coefficientMap l E T n).hom.app (op W)).hom).obj
              (ModuleCat.of _ (((Arings l E T).obj (op n)).obj.obj (op W)))), map_sum]
        refine imageSieve_sum_mem _ _ _ fun i ↦ ?_
        dsimp only
        let ρ : (Rlevel l T n).obj.obj (op W) := (toSheafify (Scheme.ProEt.topology T)
          ((Functor.const T.ProEtᵒᵖ).obj (CommRingCat.of (ULift.{u + 1} (ZMod (l ^ (n + 1))))))).app
            (op W) (ULift.up (e.repr α0.down i))
        convert hgen (op W) i (ρ • Q.val.map g.op x) using 2
        unfold WeilConjectures.SemilinearSections.extensionUnit
        rw [mul_comm (G := ((Arings l E T).obj (op n)).obj.obj (op W)),
          ← ModuleCat.ExtendScalars.smul_tmul ((coefficientMap l E T n).hom.app (op W)).hom]
        refine (((PresheafOfModules.sheafificationAdjunction (𝟙 _)).unit.app P0).app
          (op W)).hom.map_smul _ _ |>.trans (congrArg _ (congrArg _ ?_))
        rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
        exact congrArg (· ⊗ₜ _) (mul_one (M := ((Arings l E T).obj (op n)).obj.obj (op W))
          ((coefficientMap l E T n).hom.app (op W) ρ)).symm
      rw [hn] at key
      exact key
  refine imageSieve_mem_of_cover _ s _ (Presheaf.imageSieve_mem J (toSheafify J P0.presheaf) s) ?_
  rintro V g ⟨p, hp⟩
  rw [← hp]
  exact hP _ p

/-- At every level, the ordinary scalar extension of a module system is generated by the
products of the basis vectors with the images of the ordinary scalar unit.

Proof: the level comparison identifies level `n` with the change of rings of the evaluated
module; there every section is locally a sum of pure tensors, and every constant coefficient
is a residue combination of the constant basis sections. -/
theorem levelExtension_basis_epi {T : Scheme.{u}} (c : Chern l E T)
    [∀ n, Finite (SpTowerShriek.R l E n)] (M : Systems T (Rrings l T)) (n d : ℕ)
    (e : letI := coefficientZModAlgebra l E n
      Module.Basis (Fin d) (ZMod (l ^ (n + 1))) (SpTowerShriek.R l E n)) :
    Epi (biproduct.desc (f := fun _ : Fin d ↦ (abEvaluation T n).obj (c.reduction.forget.F.obj M))
      fun i ↦ (abEvaluation T n).map (c.reduction.forget.F.map
          (c.scalar.ordinaryAdjunction.unit.app M)) ≫
        (finiteScalarForgetIso l E c n).hom.app (c.scalar.model.E.obj M) ≫
        levelSmul l E T n (e i) (c.scalar.model.E.obj M)) := by
  obtain ⟨e0, he0⟩ := levelExtension_comparison l E c M n
  let β := biproduct.desc (f := fun _ : Fin d ↦
      (abEvaluation T n).obj (c.reduction.forget.F.obj M))
    fun i ↦ (abEvaluation T n).map (c.reduction.forget.F.map
        (c.scalar.ordinaryAdjunction.unit.app M)) ≫
      (finiteScalarForgetIso l E c n).hom.app (c.scalar.model.E.obj M) ≫
      levelSmul l E T n (e i) (c.scalar.model.E.obj M)
  have hgen (V : T.ProEtᵒᵖ) (i : Fin d) (x : M.val.obj (op (n, V.unop))) :
      Presheaf.imageSieve (β ≫ (finiteForget l E T n).map e0.inv).hom
        (constSection l E T n (e i) V •
          WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
            (coefficientMap l E T n) _ V x) ∈ Scheme.ProEt.topology T V.unop := by
    let x' : ((c.reduction.forget.F.obj M).obj (op n)).obj.obj V :=
      cast (congrArg _ (c.reduction.forget.sections M n V)).symm x
    have hx : HEq x' x := cast_heq _ _
    have h1 : Presheaf.imageSieve (β ≫ (finiteForget l E T n).map e0.inv).hom
        (constSection l E T n (e i) V •
          WeilConjectures.SemilinearSections.extensionUnit.{u + 1, u, u + 1}
            (coefficientMap l E T n) _ V x) (𝟙 V.unop) := by
      refine ⟨(biproduct.ι (fun _ : Fin d ↦
        (abEvaluation T n).obj (c.reduction.forget.F.obj M)) i).hom.app V x', ?_⟩
      have h2 := congrArg (fun φ ↦ φ.hom.app V x') (biproduct.ι_desc_assoc (f := fun _ : Fin d ↦
        (abEvaluation T n).obj (c.reduction.forget.F.obj M)) (fun j ↦
          (abEvaluation T n).map (c.reduction.forget.F.map
            (c.scalar.ordinaryAdjunction.unit.app M)) ≫
          (finiteScalarForgetIso l E c n).hom.app (c.scalar.model.E.obj M) ≫
          levelSmul l E T n (e j) (c.scalar.model.E.obj M)) i ((finiteForget l E T n).map e0.inv))
      have h3 := levelBasis_component_section l E c M n e0 he0 (e i) V x x' hx
      simp only [Category.assoc] at h2
      refine (h2.trans h3).trans ?_
      simp
    refine (Scheme.ProEt.topology T).superset_covering ?_ ((Scheme.ProEt.topology T).top_mem _)
    intro W g _
    simpa using (Presheaf.imageSieve _ _).downward_closed h1 g
  have : Presheaf.IsLocallySurjective (Scheme.ProEt.topology T)
      (β ≫ (finiteForget l E T n).map e0.inv).hom :=
    ⟨fun {U} s ↦ extension_basis_imageSieve l E n d e _ _ hgen (op U) s⟩
  have : Epi (β ≫ (finiteForget l E T n).map e0.inv) := inferInstance
  have hβ : β = (β ≫ (finiteForget l E T n).map e0.inv) ≫ (finiteForget l E T n).map e0.hom := by
    rw [Category.assoc, ← Functor.map_comp, e0.inv_hom_id, CategoryTheory.Functor.map_id,
      Category.comp_id]
  have hβe : Epi β := by
    rw [hβ]
    infer_instance
  exact hβe

end AlgebraicGeometry.ProEtale.SpTowerClasses
