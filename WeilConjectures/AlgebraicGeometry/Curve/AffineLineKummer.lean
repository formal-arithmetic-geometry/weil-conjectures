/-!
# Étale cohomology of the affine line and of `𝔾_m` with finite coefficients

Let `k` be an algebraically closed field, `𝔸¹_k = 𝔸(ULift (Fin 1); Spec k)` and `G = 𝔾_{m,k}`
the complement of the zero section. For `n` invertible in `k` and a finite abelian group `A`
killed by `n`:

* `Hᵠ(𝔸¹_k, μₙ) = Hᵠ(𝔸¹_k, A) = 0` for `q > 0`;
* `Hᵠ(𝔾_{m,k}, A) = 0` for `q ≥ 2`;
* `H¹(𝔾_{m,k}, μₙ) ≅ ℤ/n`, generated by the Kummer class `δ(t)` of the coordinate;
* `H¹(𝔾_{m,k}, A) ≅ Hom(ℤ/n, A)`, `φ ↦ φ_* θ`, `θ` the class of `t` in `H¹(𝔾_m, ℤ/n)`.

The computations come from the Kummer sequence, `Pic = 0` and `Br = 0` for the two curves, and
the bound `cd ≤ 1` for affine curves; general `A` is reduced to cyclic groups by the structure
theorem for finite abelian groups.
-/

@[expose] public section

universe u v w

open CategoryTheory Limits

namespace CategoryTheory.NatTrans

variable {C : Type*} [Category* C] [Preadditive C] {F G : C ⥤ AddCommGrpCat.{w}}
  [F.Additive] [G.Additive] (η : F ⟶ G)

/-- A natural transformation between additive functors to abelian groups is bijective on a finite
biproduct as soon as it is bijective on each summand. -/
theorem bijective_app_biproduct {ι : Type} [Finite ι] (B : ι → C) [HasBiproduct B]
    (h : ∀ i, Function.Bijective (η.app (B i))) : Function.Bijective (η.app (⨁ B)) := by
  have := Fintype.ofFinite ι
  have hi (i) : IsIso (η.app (B i)) := (ConcreteCategory.isIso_iff_bijective _).2 (h i)
  rw [← ConcreteCategory.isIso_iff_bijective]
  refine ⟨∑ i, G.map (biproduct.π B i) ≫ inv (η.app (B i)) ≫ F.map (biproduct.ι B i), ?_, ?_⟩
  · rw [Preadditive.comp_sum]
    simp_rw [← NatTrans.naturality_assoc, IsIso.hom_inv_id_assoc, ← F.map_comp]
    rw [← F.map_sum, biproduct.total, F.map_id]
  · rw [Preadditive.sum_comp]
    simp only [Category.assoc, NatTrans.naturality, IsIso.inv_hom_id_assoc, ← G.map_comp]
    rw [← G.map_sum, biproduct.total, G.map_id]

end CategoryTheory.NatTrans

namespace AddCommGrpCat

/-- A finite abelian group killed by `n` is a finite direct sum of cyclic groups `ℤ/m` with
`m ∣ n`. -/
theorem exists_iso_biproduct_zmod (A : AddCommGrpCat.{v}) [Finite A] (n : ℕ)
    (hA : ∀ a : A, n • a = 0) :
    ∃ (ι : Type) (_ : Fintype ι) (m : ι → ℕ), (∀ i, m i ∣ n) ∧
      Nonempty (A ≅ ⨁ fun i ↦ AddCommGrpCat.of (ULift.{v} (ZMod (m i)))) := by
  classical
  obtain ⟨ι, _, p, -, e, ⟨φ⟩⟩ := AddCommGroup.equiv_directSum_zmod_of_finite A
  refine ⟨ι, inferInstance, fun i ↦ p i ^ e i, fun i ↦ ?_, ⟨?_⟩⟩
  · have h := congrArg (fun x ↦ φ x i) (hA (φ.symm (DirectSum.of _ i 1)))
    simp only [map_nsmul, AddEquiv.apply_symm_apply, map_zero, DirectSum.zero_apply] at h
    rw [DirectSum.smul_apply, DirectSum.of_eq_same, nsmul_eq_mul, mul_one] at h
    exact (ZMod.natCast_eq_zero_iff _ _).1 h
  · refine (φ.trans ((DirectSum.linearEquivFunOnFintype ℤ ι _).toAddEquiv.trans
      (AddEquiv.piCongrRight fun i ↦ AddEquiv.ulift.symm))).toAddCommGrpIso ≪≫
      (biproductIsoPi _).symm

end AddCommGrpCat

namespace AlgebraicGeometry.AffineSpace

open Scheme

variable {k : Type u} [Field k]

instance isCurve_line : IsCurve (𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) where
  krullDim_le_one := by
    have := AffineSpace.smoothOfRelativeDimension_over (ULift.{u} (Fin 1)) (Spec (.of k))
    rw [Nat.card_unique] at this
    exact_mod_cast topologicalKrullDim_le_of_smoothOfRelativeDimension
      (𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) 1

variable {G : Scheme.{u}} (j : G ⟶ 𝔸(ULift.{u} (Fin 1); Spec (.of k))) [IsOpenImmersion j]
  (hj : Set.range j.base = (Set.range (zeroSection (ULift.{u} (Fin 1)) (Spec (.of k))).base)ᶜ)

include hj in
lemma isCurve_of_range_eq_compl_zeroSection :
    IsCurve (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) :=
  have := isAffine_of_range_eq_compl_zeroSection j hj
  { krullDim_le_one := by
      have := AffineSpace.smoothOfRelativeDimension_over (ULift.{u} (Fin 1)) (Spec (.of k))
      rw [Nat.card_unique] at this
      have : SmoothOfRelativeDimension (0 + 1)
          (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) := inferInstance
      exact_mod_cast topologicalKrullDim_le_of_smoothOfRelativeDimension
        (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) 1 }

lemma subsingleton_cohomologicalPicardGroup_line :
    Subsingleton (𝔸(ULift.{u} (Fin 1); Spec (.of k))).CohomologicalPicardGroup :=
  have := subsingleton_pic_line k
  (Pic.toCohomologicalPicardGroup _).symm.subsingleton

include hj in
lemma subsingleton_cohomologicalPicardGroup_of_range_eq_compl_zeroSection :
    Subsingleton G.CohomologicalPicardGroup :=
  have := subsingleton_pic_of_range_eq_compl_zeroSection j hj
  (Pic.toCohomologicalPicardGroup _).symm.subsingleton

lemma isUnit_natCast_of_ne_zero {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) {n : ℕ}
    (hn : (n : k) ≠ 0) : IsUnit (n : Γ(X, ⊤)) := by
  simpa using hn.isUnit.map (f.structureRingHom k)

lemma pos_of_natCast_ne_zero {n : ℕ} (hn : (n : k) ≠ 0) : 0 < n :=
  Nat.pos_of_ne_zero fun h ↦ hn (by simp [h])

variable [IsAlgClosed k]

lemma exists_pow_eq_units_of_isAlgClosed {n : ℕ} (hn : 0 < n) (c : kˣ) : ∃ d : kˣ, d ^ n = c := by
  obtain ⟨d, hd⟩ := IsAlgClosed.exists_pow_nat_eq (c : k) hn
  have hd0 : d ≠ 0 := by
    rintro rfl
    exact c.ne_zero (by rw [← hd, zero_pow hn.ne'])
  exact ⟨Units.mk0 d hd0, Units.ext (by simpa using hd)⟩

/-- **Kummer computation on the affine line.** For `n` invertible in the algebraically closed
field `k`, `Hᵠ(𝔸¹_k, μₙ) = 0` for `q > 0`. -/
theorem subsingleton_sheafH_rootsOfUnitySheaf_line {n : ℕ} (hn : (n : k) ≠ 0) (q : ℕ)
    (hq : 0 < q) : Subsingleton (Sheaf.H ((𝔸(ULift.{u} (Fin 1); Spec (.of k))).rootsOfUnitySheaf n)
      q) := by
  have hn0 := pos_of_natCast_ne_zero hn
  obtain rfl | hq := Nat.eq_or_lt_of_le hq
  · obtain ⟨e⟩ := Scheme.nonempty_addEquiv_sheafH_rootsOfUnitySheaf_one _ n
      (isUnit_natCast_of_ne_zero (𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hn)
      (exists_pow_eq_units_line n (exists_pow_eq_units_of_isAlgClosed hn0))
    have := subsingleton_cohomologicalPicardGroup_line (k := k)
    exact e.toEquiv.subsingleton
  · exact IsCurve.subsingleton_sheafH_of_two_le_of_isAffine
      (𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) _
      (Scheme.isTorsion_of_nsmul_id_eq_zero hn0 (by
        refine (cancel_mono (Limits.kernel.ι (n • 𝟙 _))).1 ?_
        rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp,
          ← Category.comp_id (Limits.kernel.ι (n • 𝟙 _)), ← Preadditive.comp_nsmul,
          Limits.kernel.condition])) q hq

lemma rootsOfUnitySheaf_isTorsion (X : Scheme.{u}) {n : ℕ} (hn : 0 < n) :
    (X.rootsOfUnitySheaf n).IsTorsion :=
  Scheme.isTorsion_of_nsmul_id_eq_zero hn (by
    refine (cancel_mono (Limits.kernel.ι (n • 𝟙 _))).1 ?_
    rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp,
      ← Category.comp_id (Limits.kernel.ι (n • 𝟙 _)), ← Preadditive.comp_nsmul,
      Limits.kernel.condition])

/-- **Kummer computation on `𝔾_{m,k}`, degrees `≥ 2`.** `Hᵠ(𝔾_{m,k}, μₙ) = 0` for `q ≥ 2`. -/
theorem subsingleton_sheafH_rootsOfUnitySheaf_multiplicativeGroup {n : ℕ} (hn : (n : k) ≠ 0)
    (q : ℕ) (hq : 2 ≤ q) : Subsingleton (Sheaf.H (G.rootsOfUnitySheaf n) q) :=
  have := isAffine_of_range_eq_compl_zeroSection j hj
  have := isCurve_of_range_eq_compl_zeroSection j hj
  IsCurve.subsingleton_sheafH_of_two_le_of_isAffine
    (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) _
    (rootsOfUnitySheaf_isTorsion G (pos_of_natCast_ne_zero hn)) q hq


include hj in
/-- **Kummer computation on `𝔾_{m,k}`, degree one.** `H¹(𝔾_{m,k}, μₙ) ≅ ℤ/n`, the Kummer class
`δ(t)` of the coordinate going to `1`: the Kummer boundary `Γ(𝔾_m, 𝒪)ˣ/n ⟶ H¹(𝔾_m, μₙ)` is an
isomorphism since `Pic(𝔾_m) = 0`, and `Γ(𝔾_m, 𝒪)ˣ/n = ℤ/n` generated by `t`. -/
theorem exists_sheafH_rootsOfUnitySheaf_one_addEquiv {n : ℕ} (hn : (n : k) ≠ 0) :
    ∃ e : Sheaf.H (G.rootsOfUnitySheaf n) 1 ≃+ ZMod n,
      e (G.kummerδ₀ n (isUnit_natCast_of_ne_zero
        (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hn)
          (Additive.ofMul (unitLineCoord j hj))) = 1 := by
  have hn' := isUnit_natCast_of_ne_zero (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hn
  obtain ⟨hker, hex, -⟩ := G.exact_sheafH_rootsOfUnitySheaf_one n hn'
  have := subsingleton_cohomologicalPicardGroup_of_range_eq_compl_zeroSection j hj
  have hsurj : Function.Surjective (G.kummerδ₀ n hn') := fun y ↦
    (hex y).1 (Subsingleton.elim _ _)
  obtain ⟨e, he⟩ := exists_unitsCokernelAddEquiv_zmod j hj n
    (exists_pow_eq_units_of_isAlgClosed (pos_of_natCast_ne_zero hn))
  let e₁ := (QuotientAddGroup.quotientKerEquivOfSurjective _ hsurj).symm
  refine ⟨(e₁.trans (QuotientAddGroup.quotientAddEquivOfEq (by rw [hker]))).trans e, ?_⟩
  rw [AddEquiv.trans_apply, AddEquiv.trans_apply, ← he]
  congr 1
  have h1 : e₁ (G.kummerδ₀ n hn' (Additive.ofMul (unitLineCoord j hj))) =
      QuotientAddGroup.mk (Additive.ofMul (unitLineCoord j hj)) :=
    (QuotientAddGroup.quotientKerEquivOfSurjective _ hsurj).symm_apply_eq.2 rfl
  rw [h1]
  rfl

end AlgebraicGeometry.AffineSpace

namespace AlgebraicGeometry

variable (X : Scheme.{u})

/-- An additive functor to abelian groups which vanishes on the summands of a finite biproduct
vanishes on the biproduct. -/
lemma _root_.CategoryTheory.Functor.subsingleton_obj_biproduct {C : Type*} [Category* C]
    [Preadditive C] (F : C ⥤ AddCommGrpCat.{u}) [F.Additive] {ι : Type} [Finite ι] (B : ι → C)
    [HasBiproduct B] (h : ∀ i, Subsingleton (F.obj (B i))) : Subsingleton (F.obj (⨁ B)) :=
  have : ∀ i, Subsingleton ((F.obj ∘ B) i) := h
  have : Subsingleton (∀ i, (F.obj ∘ B) i) := inferInstance
  ((F.mapBiproduct B ≪≫
    AddCommGrpCat.biproductIsoPi _).addCommGroupIsoToAddEquiv).toEquiv.subsingleton

/-- A natural transformation between additive functors on abelian groups is bijective on every
finite abelian group killed by `n` as soon as it is bijective on the cyclic groups `ℤ/m`,
`m ∣ n`. -/
theorem _root_.CategoryTheory.NatTrans.bijective_app_of_zmod
    {F G : AddCommGrpCat.{u + 1} ⥤ AddCommGrpCat.{u + 1}} [F.Additive] [G.Additive] (η : F ⟶ G)
    (n : ℕ) (h : ∀ m, m ∣ n → Function.Bijective (η.app (.of (ULift.{u + 1} (ZMod m)))))
    (A : AddCommGrpCat.{u + 1}) [Finite A] (hA : ∀ a : A, n • a = 0) :
    Function.Bijective (η.app A) := by
  obtain ⟨ι, _, m, hm, ⟨e⟩⟩ := AddCommGrpCat.exists_iso_biproduct_zmod A n hA
  have hb := NatTrans.bijective_app_biproduct η _ fun i ↦ h (m i) (hm i)
  have : η.app A = F.map e.hom ≫ η.app _ ≫ G.map e.inv := by
    rw [NatTrans.naturality_assoc, ← G.map_comp, e.hom_inv_id, G.map_id, Category.comp_id]
  rw [← ConcreteCategory.isIso_iff_bijective] at hb ⊢
  rw [this]
  infer_instance

/-- An additive functor on abelian groups vanishes on every finite abelian group killed by `n` as
soon as it vanishes on the cyclic groups `ℤ/m`, `m ∣ n`. -/
theorem _root_.CategoryTheory.Functor.subsingleton_obj_of_zmod
    (F : AddCommGrpCat.{u + 1} ⥤ AddCommGrpCat.{u + 1}) [F.Additive]
    (n : ℕ) (h : ∀ m, m ∣ n → Subsingleton (F.obj (.of (ULift.{u + 1} (ZMod m)))))
    (A : AddCommGrpCat.{u + 1}) [Finite A] (hA : ∀ a : A, n • a = 0) :
    Subsingleton (F.obj A) := by
  obtain ⟨ι, _, m, hm, ⟨e⟩⟩ := AddCommGrpCat.exists_iso_biproduct_zmod A n hA
  have := F.subsingleton_obj_biproduct _ fun i ↦ h (m i) (hm i)
  exact (F.mapIso e).addCommGroupIsoToAddEquiv.toEquiv.subsingleton

/-- A constant sheaf with value a group killed by `n > 0` is a torsion sheaf. -/
lemma isTorsion_constantSheaf (A : AddCommGrpCat.{u + 1}) {n : ℕ} (hn : 0 < n)
    (hA : ∀ a : A, n • a = 0) :
    ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}).obj A).IsTorsion :=
  Scheme.isTorsion_of_nsmul_id_eq_zero hn (by
    have : n • 𝟙 A = 0 := by
      ext a
      simpa using hA a
    rw [← (constantSheaf _ _).map_id, ← Functor.map_nsmul, this, Functor.map_zero])


/-- A constant sheaf with value a group `A` with `n • 𝟙 = 0`, `n > 0`, is a torsion sheaf. -/
lemma isTorsion_constantSheaf' (A : AddCommGrpCat.{u + 1}) {n : ℕ} (hn : 0 < n)
    (hA : n • 𝟙 A = 0) :
    ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}).obj A).IsTorsion :=
  Scheme.isTorsion_of_nsmul_id_eq_zero hn (by
    rw [← (constantSheaf _ _).map_id, ← Functor.map_nsmul, hA, Functor.map_zero])

/-- The map `Hom(ℤ/n, A) → Hᵠ(X, A)`, `φ ↦ φ_* θ`, for a class `θ ∈ Hᵠ(X, ℤ/n)`, natural in the
abelian group `A`. -/
@[simps]
noncomputable def sheafHConstantSheafNatTrans (n q : ℕ) (θ : Sheaf.H (X.constantZMod n) q) :
    preadditiveCoyoneda.obj (Opposite.op (AddCommGrpCat.of (ULift.{u + 1} (ZMod n)))) ⟶
      constantSheaf X.smallEtaleTopology AddCommGrpCat.{u + 1} ⋙
        Sheaf.functorH X.smallEtaleTopology q where
  app A := AddCommGrpCat.ofHom
    { toFun φ := Sheaf.H.map ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}).map φ) q θ
      map_zero' := by simp [Sheaf.H.map_apply]
      map_add' φ ψ := by
        dsimp only
        rw [Functor.map_add, Sheaf.H.map_add_apply] }
  naturality A B f := by
    ext φ
    change Sheaf.H.map ((constantSheaf _ _).map (φ ≫ f)) q θ =
      Sheaf.H.map ((constantSheaf _ _).map f) q (Sheaf.H.map ((constantSheaf _ _).map φ) q θ)
    rw [Functor.map_comp, Sheaf.H.map_comp_apply]

namespace AffineSpace

open Scheme

variable {k : Type u} [Field k] [IsAlgClosed k]

lemma nonempty_constantZModIsoRootsOfUnitySheaf {Y : Scheme.{u}} (f : Y ⟶ Spec (.of k)) {m : ℕ}
    (hm : (m : k) ≠ 0) : Nonempty (Y.constantZMod m ≅ Y.rootsOfUnitySheaf m) := by
  have : NeZero (m : k) := ⟨hm⟩
  have : NeZero m := ⟨fun h ↦ hm (by simp [h])⟩
  obtain ⟨-, -, ζ, hζ, -⟩ := IsSepClosed.exists_isPrimitiveRoot.{u, u} k m
  exact ⟨Y.constantZModIsoRootsOfUnitySheaf m f hζ⟩

omit [IsAlgClosed k] in
lemma natCast_ne_zero_of_dvd {m n : ℕ} (hm : m ∣ n) (hn : (n : k) ≠ 0) : (m : k) ≠ 0 := by
  obtain ⟨c, rfl⟩ := hm
  intro h
  exact hn (by simp [h])

/-- **The affine line is acyclic.** For a finite abelian group `A` killed by an integer `n`
invertible in the algebraically closed field `k`, `Hᵠ(𝔸¹_k, A) = 0` for `q > 0`. -/
theorem subsingleton_sheafH_constantSheaf_line (A : AddCommGrpCat.{u + 1}) [Finite A] {n : ℕ}
    (hn : (n : k) ≠ 0) (hA : ∀ a : A, n • a = 0) (q : ℕ) (hq : 0 < q) :
    Subsingleton (Sheaf.H ((constantSheaf (𝔸(ULift.{u} (Fin 1); Spec (.of k))).smallEtaleTopology
      AddCommGrpCat.{u + 1}).obj A) q) :=
  (constantSheaf _ AddCommGrpCat.{u + 1} ⋙ Sheaf.functorH _ q).subsingleton_obj_of_zmod n
    (fun m hm ↦ by
      have hm' := natCast_ne_zero_of_dvd hm hn
      obtain ⟨e⟩ := nonempty_constantZModIsoRootsOfUnitySheaf
        (𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hm'
      have := subsingleton_sheafH_rootsOfUnitySheaf_line hm' q hq
      exact @Equiv.subsingleton _ _
        ((Sheaf.functorH _ q).mapIso e).addCommGroupIsoToAddEquiv.toEquiv this) A hA

variable {G : Scheme.{u}} (j : G ⟶ 𝔸(ULift.{u} (Fin 1); Spec (.of k))) [IsOpenImmersion j]
  (hj : Set.range j.base = (Set.range (zeroSection (ULift.{u} (Fin 1)) (Spec (.of k))).base)ᶜ)

include hj

/-- **Cohomological dimension of `𝔾_{m,k}`.** For a finite abelian group `A` killed by an
integer `n > 0`, `Hᵠ(𝔾_{m,k}, A) = 0` for `q ≥ 2`. -/
theorem subsingleton_sheafH_constantSheaf_multiplicativeGroup (A : AddCommGrpCat.{u + 1})
    {n : ℕ} (hn : 0 < n) (hA : n • 𝟙 A = 0) (q : ℕ) (hq : 2 ≤ q) :
    Subsingleton (Sheaf.H ((constantSheaf G.smallEtaleTopology AddCommGrpCat.{u + 1}).obj A) q) :=
  have := isAffine_of_range_eq_compl_zeroSection j hj
  have := isCurve_of_range_eq_compl_zeroSection j hj
  IsCurve.subsingleton_sheafH_of_two_le_of_isAffine
    (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) _
    (isTorsion_constantSheaf' G A hn hA) q hq

/-- On `𝔾_{m,k}`, `H¹(-, A)` is right exact: an epimorphism `A ⟶ B` of finite abelian groups
killed by `n > 0` induces a surjection `H¹(𝔾_{m,k}, A) ⟶ H¹(𝔾_{m,k}, B)`, since `H²` of the
kernel vanishes. -/
theorem surjective_sheafH_map_constantSheaf_multiplicativeGroup {A B : AddCommGrpCat.{u + 1}}
    (r : A ⟶ B) [Epi r] {n : ℕ} (hn : 0 < n) (hA : n • 𝟙 A = 0) :
    Function.Surjective
      (Sheaf.H.map ((constantSheaf G.smallEtaleTopology AddCommGrpCat.{u + 1}).map r) 1) := by
  let S := ShortComplex.mk (kernel.ι r) r (kernel.condition r)
  have hS : S.ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel r) }
  have hS' := hS.map_of_exact (constantSheaf G.smallEtaleTopology AddCommGrpCat.{u + 1})
  have hK : n • 𝟙 (kernel r) = 0 := by
    rw [← cancel_mono (kernel.ι r), Preadditive.nsmul_comp, Category.id_comp, zero_comp,
      ← Category.comp_id (kernel.ι r), ← Preadditive.comp_nsmul, hA, comp_zero]
  have := subsingleton_sheafH_constantSheaf_multiplicativeGroup j hj (kernel r) hn hK 2 le_rfl
  intro y
  exact (Sheaf.H.exact_map_δSucc hS' 1 y).1 (@Subsingleton.elim _ this _ _)

end AffineSpace

namespace AffineSpace

open Scheme

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Scheme.{u}} (j : G ⟶ 𝔸(ULift.{u} (Fin 1); Spec (.of k))) [IsOpenImmersion j]
  (hj : Set.range j.base = (Set.range (zeroSection (ULift.{u} (Fin 1)) (Spec (.of k))).base)ᶜ)

/-- The class `θ ∈ H¹(𝔾_{m,k}, ℤ/n)` of the coordinate `t`: its Kummer class `δ(t) ∈ H¹(𝔾_m, μₙ)`
transported along an identification `ℤ/n ≅ μₙ` given by a primitive `n`-th root of unity. -/
noncomputable def kummerClassZMod {n : ℕ} (hn : (n : k) ≠ 0) : Sheaf.H (G.constantZMod n) 1 :=
  Sheaf.H.map (nonempty_constantZModIsoRootsOfUnitySheaf
      (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hn).some.inv 1
    (G.kummerδ₀ n (isUnit_natCast_of_ne_zero
      (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hn)
        (Additive.ofMul (unitLineCoord j hj)))

include hj in
/-- `H¹(𝔾_{m,k}, ℤ/n) ≅ ℤ/n`, the class of the coordinate going to `1`. -/
theorem exists_addEquiv_kummerClassZMod {n : ℕ} (hn : (n : k) ≠ 0) :
    ∃ e : Sheaf.H (G.constantZMod n) 1 ≃+ ZMod n, e (kummerClassZMod j hj hn) = 1 := by
  obtain ⟨e, he⟩ := exists_sheafH_rootsOfUnitySheaf_one_addEquiv j hj hn
  let i := (nonempty_constantZModIsoRootsOfUnitySheaf
      (j ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)) hn).some
  refine ⟨((Sheaf.functorH _ 1).mapIso i).addCommGroupIsoToAddEquiv.trans e, ?_⟩
  rw [AddEquiv.trans_apply, ← he]
  congr 1
  change Sheaf.H.map i.hom 1 (Sheaf.H.map i.inv 1 _) = _
  rw [← Sheaf.H.map_comp_apply, i.inv_hom_id, Sheaf.H.map_id_apply]

include hj in
lemma exists_nsmul_eq_kummerClassZMod {n : ℕ} (hn : (n : k) ≠ 0)
    (y : Sheaf.H (G.constantZMod n) 1) : ∃ c : ℕ, y = c • kummerClassZMod j hj hn := by
  have : NeZero n := ⟨fun h ↦ hn (by simp [h])⟩
  obtain ⟨e, he⟩ := exists_addEquiv_kummerClassZMod j hj hn
  refine ⟨(e y).val, e.injective ?_⟩
  rw [map_nsmul, he, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

/-- The reduction `ℤ/n ⟶ ℤ/m` for `m ∣ n`. -/
noncomputable def zmodReduction {n m : ℕ} (hm : m ∣ n) :
    AddCommGrpCat.of (ULift.{u + 1} (ZMod n)) ⟶ AddCommGrpCat.of (ULift.{u + 1} (ZMod m)) :=
  AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp
    (ZMod.castHom hm (ZMod m)).toAddMonoidHom).comp AddEquiv.ulift.toAddMonoidHom)

lemma zmodReduction_apply {n m : ℕ} (hm : m ∣ n) (a : ZMod n) :
    (zmodReduction.{u} hm).hom (ULift.up a) = ULift.up (ZMod.castHom hm (ZMod m) a) :=
  rfl

lemma eq_nsmul_zmodReduction {n m : ℕ} [NeZero n] (hm : m ∣ n)
    (φ : AddCommGrpCat.of (ULift.{u + 1} (ZMod n)) ⟶ AddCommGrpCat.of (ULift.{u + 1} (ZMod m))) :
    φ = (φ.hom (ULift.up 1)).down.val • zmodReduction hm := by
  have : NeZero m := ⟨by rintro rfl; exact NeZero.ne n (zero_dvd_iff.1 hm)⟩
  ext ⟨a⟩
  have ha : (ULift.up a : ULift.{u + 1} (ZMod n)) = a.val • ULift.up 1 := by
    apply ULift.ext
    change a = a.val • (1 : ZMod n)
    rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  rw [ha, map_nsmul, map_nsmul]
  refine congrArg (a.val • ·) ?_
  change (φ.hom (ULift.up 1)).down =
    (φ.hom (ULift.up 1)).down.val • ((zmodReduction.{u} hm).hom (ULift.up 1)).down
  rw [zmodReduction_apply, map_one]
  change _ = (φ.hom (ULift.up 1)).down.val • (1 : ZMod m)
  rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

end AffineSpace

end AlgebraicGeometry

namespace AlgebraicGeometry.AffineSpace

open Scheme

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Scheme.{u}} (j : G ⟶ 𝔸(ULift.{u} (Fin 1); Spec (.of k))) [IsOpenImmersion j]
  (hj : Set.range j.base = (Set.range (zeroSection (ULift.{u} (Fin 1)) (Spec (.of k))).base)ᶜ)

omit [IsAlgClosed k] in
lemma nsmul_id_zmod (n : ℕ) : n • 𝟙 (AddCommGrpCat.of (ULift.{u + 1} (ZMod n))) = 0 := by
  ext ⟨a⟩
  change n • a = 0
  rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]

include hj

/-- On `𝔾_{m,k}`, the map `Hom(ℤ/n, ℤ/m) → H¹(𝔾_{m,k}, ℤ/m)`, `φ ↦ φ_* θ`, is bijective for
`m ∣ n`. -/
theorem bijective_sheafHConstantSheafNatTrans_zmod {n : ℕ} (hn : (n : k) ≠ 0) {m : ℕ}
    (hm : m ∣ n) :
    Function.Bijective ((sheafHConstantSheafNatTrans G n 1 (kummerClassZMod j hj hn)).app
      (.of (ULift.{u + 1} (ZMod m)))) := by
  have : NeZero n := ⟨fun h ↦ hn (by simp [h])⟩
  have hm' := natCast_ne_zero_of_dvd hm hn
  have : NeZero m := ⟨fun h ↦ hm' (by simp [h])⟩
  set η := sheafHConstantSheafNatTrans G n 1 (kummerClassZMod j hj hn)
  let r := zmodReduction.{u} hm
  have hr : Epi r := by
    rw [AddCommGrpCat.epi_iff_surjective]
    rintro ⟨b⟩
    obtain ⟨a, rfl⟩ := ZMod.ringHom_surjective (ZMod.castHom hm (ZMod m)) b
    exact ⟨ULift.up a, rfl⟩
  have hg : ∀ y : Sheaf.H (G.constantZMod m) 1, ∃ c : ℕ, y = c • (η.app _).hom r := by
    intro y
    obtain ⟨x, rfl⟩ := surjective_sheafH_map_constantSheaf_multiplicativeGroup j hj r
      (pos_of_natCast_ne_zero hn) (nsmul_id_zmod n) y
    obtain ⟨c, rfl⟩ := exists_nsmul_eq_kummerClassZMod j hj hn x
    exact ⟨c, by rw [map_nsmul]; rfl⟩
  obtain ⟨e, -⟩ := exists_addEquiv_kummerClassZMod j hj hm'
  obtain ⟨c₀, hc₀⟩ := hg (e.symm 1)
  have h2 : e (c₀ • (η.app _).hom r) = 1 := by rw [← hc₀, AddEquiv.apply_symm_apply]
  constructor
  · rw [injective_iff_map_eq_zero]
    intro φ hφ0
    rw [eq_nsmul_zmodReduction hm φ] at hφ0 ⊢
    set c := (φ.hom (ULift.up 1)).down.val
    rw [map_nsmul] at hφ0
    have h1 : (c : ZMod m) = 0 := by
      calc (c : ZMod m) = c • e (c₀ • (η.app _).hom r) := by rw [h2, nsmul_eq_mul, mul_one]
        _ = e (c₀ • (c • (η.app _).hom r)) := by rw [← map_nsmul, smul_comm]
        _ = 0 := by rw [hφ0, smul_zero, map_zero]
    refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun ⟨a⟩ ↦ ULift.ext ?_)
    change c • (ZMod.castHom hm (ZMod m) a) = (0 : ZMod m)
    rw [nsmul_eq_mul, h1, zero_mul]
  · intro y
    obtain ⟨c, rfl⟩ := hg y
    exact ⟨c • r, by rw [map_nsmul]⟩

/-- **`H¹(𝔾_{m,k}, A) = Hom(ℤ/n, A)`.** For a finite abelian group `A` killed by `n`, invertible
in `k`, the map `Hom(ℤ/n, A) → H¹(𝔾_{m,k}, A)`, `φ ↦ φ_* θ`, is bijective, where
`θ ∈ H¹(𝔾_{m,k}, ℤ/n)` is the Kummer class of the coordinate. -/
theorem bijective_sheafHConstantSheafNatTrans {n : ℕ} (hn : (n : k) ≠ 0)
    (A : AddCommGrpCat.{u + 1}) [Finite A] (hA : ∀ a : A, n • a = 0) :
    Function.Bijective ((sheafHConstantSheafNatTrans G n 1 (kummerClassZMod j hj hn)).app A) :=
  NatTrans.bijective_app_of_zmod _ n
    (fun _ hm ↦ bijective_sheafHConstantSheafNatTrans_zmod j hj hn hm) A hA

end AlgebraicGeometry.AffineSpace
