module

public import WeilConjectures.SixFunctors.Etale.SmoothBaseChange.Defs

/-!
# The constant sheaf with prime coefficients

For a prime `r` and `R = ULift (ZMod r)`, the constant sheaf `Etale.constantModSheaf R U r` with
value `R/(r)` is isomorphic to the constant sheaf with value `R`, since `r = 0` in `R`.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

namespace IsCurve

/-- In `ULift (ZMod r)` the ideal generated by `r` is zero. -/
lemma span_natCast_uLift_zmod_eq_bot (r : ℕ) :
    (Ideal.span {(r : ULift.{u + 1} (ZMod r))} : Ideal (ULift.{u + 1} (ZMod r))) = ⊥ := by
  rw [Ideal.span_singleton_eq_bot]
  ext
  simp

/-- The isomorphism between the constant sheaf with value `R/(r)` and the constant sheaf with
value `R`, for `R = ULift (ZMod r)`. -/
noncomputable def constantModSheafIsoConstantSheaf (U : Scheme.{u}) (r : ℕ) :
    Etale.constantModSheaf (ULift.{u + 1} (ZMod r)) U r ≅
      (constantSheaf U.smallEtaleTopology (ModuleCat.{u + 1} (ULift.{u + 1} (ZMod r)))).obj
        (ModuleCat.of _ (ULift.{u + 1} (ZMod r))) :=
  (constantSheaf U.smallEtaleTopology _).mapIso
    (Submodule.quotEquivOfEqBot _ (span_natCast_uLift_zmod_eq_bot r)).toModuleIso

/-- **Prime coefficient constant sheaf identification.** For a scheme `U`, a prime `r` and
`R = ULift (ZMod r)`, the constant sheaf `Etale.constantModSheaf R U r` with value `R/(r)` is
isomorphic to the constant sheaf with value `R`.
(blueprint: `k1-constant-mod-sheaf-prime-coefficient-identification`) -/
theorem constantModSheaf_iso_constantSheaf (U : Scheme.{u}) (r : ℕ) [Fact r.Prime] :
    Nonempty (Etale.constantModSheaf (ULift.{u + 1} (ZMod r)) U r ≅
      (constantSheaf U.smallEtaleTopology (ModuleCat.{u + 1} (ULift.{u + 1} (ZMod r)))).obj
        (ModuleCat.of _ (ULift.{u + 1} (ZMod r)))) :=
  ⟨constantModSheafIsoConstantSheaf U r⟩

end IsCurve

end AlgebraicGeometry
