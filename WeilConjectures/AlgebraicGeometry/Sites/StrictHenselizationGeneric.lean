module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Unramified.LocalRing
public import WeilConjectures.AlgebraicGeometry.Sites.StrictHenselizationLocal

/-!
# The strict localization of an integral affine scheme at its generic point

Let `R` be a domain and `s : Spec Ω ⟶ Spec R` a geometric point lying over the generic point of
`Spec R`. Then the strict henselization `𝒪^{sh}_{Spec R, s}` is a field, so the strict
localization `(Spec R)_(s)` is the spectrum of a separably closed field.

The key point is that for an étale `R`-algebra `S` and a prime `q` of `S` over the zero ideal,
the local ring `S_q` is a field, `S` being unramified at `q`: so every element of `q` is killed
by an element outside `q`, which becomes a unit in the strict henselization.
-/

@[expose] public section

universe u

open CategoryTheory IsLocalRing

/-- For an étale algebra `S` over a domain `R` and a prime `q` of `S` lying over the zero ideal,
every element of `q` is killed by an element outside `q`: the local ring `S_q` is unramified
over the field `R_{(0)}`, so its maximal ideal is generated by the zero ideal. -/
lemma Algebra.Etale.exists_notMem_mul_eq_zero_of_comap_eq_bot {R S : Type*} [CommRing R]
    [IsDomain R] [CommRing S] [Algebra R S] [Algebra.Etale R S] (q : Ideal S) [q.IsPrime]
    (hq : q.comap (algebraMap R S) = ⊥) {c : S} (hc : c ∈ q) : ∃ t ∉ q, t * c = 0 := by
  have : q.LiesOver (⊥ : Ideal R) := ⟨hq.symm⟩
  let := Localization.AtPrime.algebraOfLiesOver (⊥ : Ideal R) q
  have : Algebra.IsUnramifiedAt R q :=
    Algebra.FormallyUnramified.comp R S (Localization.AtPrime q)
  have h := ((Algebra.isUnramifiedAt_iff_map_eq R (⊥ : Ideal R) q).1 this).2
  rw [Ideal.map_bot] at h
  have hc' : algebraMap S (Localization.AtPrime q) c ∈ maximalIdeal (Localization.AtPrime q) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q c).2 hc
  rw [← h, Ideal.mem_bot, IsLocalization.map_eq_zero_iff q.primeCompl] at hc'
  obtain ⟨⟨t, ht⟩, htc⟩ := hc'
  exact ⟨t, ht, htc⟩

namespace AlgebraicGeometry.Scheme

variable {R : CommRingCat.{u}} [IsDomain R] {Ω : Type u} [Field Ω] [IsSepClosed Ω]
  {s : Spec (.of Ω) ⟶ Spec R}

/-- At a geometric point of an integral affine scheme lying over the generic point, an element
of the strict henselization vanishing at the geometric point is zero. -/
lemma eq_zero_of_strictHenselizationEval_eq_zero
    (hs : (s.base (IsLocalRing.closedPoint Ω)).asIdeal = ⊥) {a : ↑(strictHenselization s)}
    (ha : strictHenselizationEval s a = 0) : a = 0 := by
  obtain ⟨N, hN⟩ := exists_specPointedEtaleNeighborhood_forall_mem_range 1 (fun _ ↦ a)
  obtain ⟨c, rfl⟩ := hN 0
  rw [SpecPointedEtaleNeighborhood.strictHenselizationEval_ι] at ha
  obtain ⟨φ, hφ⟩ := Spec.map_surjective N.hom
  have hét : φ.hom.Etale := by
    have : Etale (Spec.map φ) := hφ ▸ N.etale
    exact HasRingHomProperty.Spec_iff.mp this
  algebraize [φ.hom]
  let q := RingHom.ker N.pt.hom
  have : q.IsPrime := RingHom.ker_isPrime _
  have hq : q.comap (algebraMap R N.R) = ⊥ := by
    have hw : Spec.map (φ ≫ N.pt) = s := by rw [Spec.map_comp, hφ, N.w]
    have h1 : ((Spec.map (φ ≫ N.pt)).base (IsLocalRing.closedPoint Ω)).asIdeal = ⊥ := by
      rw [hw]
      exact hs
    rw [← h1]
    ext x
    simp only [q, Spec.map_base, RingHom.algebraMap_toAlgebra, IsLocalRing.closedPoint,
      Ideal.mem_comap, RingHom.mem_ker]
    change _ ↔ N.pt.hom (φ.hom x) ∈ maximalIdeal Ω
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_ne_zero, not_not]
  obtain ⟨t, ht, htc⟩ := Algebra.Etale.exists_notMem_mul_eq_zero_of_comap_eq_bot q hq ha
  have hu : IsUnit (N.ι t) := isUnit_of_strictHenselizationEval_ne_zero (by
    rw [SpecPointedEtaleNeighborhood.strictHenselizationEval_ι]
    exact ht)
  have h0 : N.ι t * N.ι c = 0 := by rw [← map_mul, htc, map_zero]
  exact (hu.mul_right_eq_zero).1 h0

/-- At a geometric point of an integral affine scheme lying over the generic point, the strict
henselization is a field. -/
lemma maximalIdeal_strictHenselization_eq_bot
    (hs : (s.base (IsLocalRing.closedPoint Ω)).asIdeal = ⊥) :
    maximalIdeal ↑(strictHenselization s) = ⊥ :=
  eq_bot_iff.2 fun a ha ↦ eq_zero_of_strictHenselizationEval_eq_zero hs
    ((mem_maximalIdeal_strictHenselization_iff a).1 ha)

/-- **The strict localization at the generic point.** At a geometric point of an integral
affine scheme lying over the generic point, the strict localization is the spectrum of a
separably closed field. -/
theorem exists_isSepClosed_strictLocalization_iso
    (hs : (s.base (IsLocalRing.closedPoint Ω)).asIdeal = ⊥) :
    ∃ (K : Type u) (_ : Field K) (_ : IsSepClosed K),
      Nonempty (strictLocalization s ≅ Spec (.of K)) := by
  let e : ↑(strictHenselization s) ≃+* ResidueField ↑(strictHenselization s) :=
    RingEquiv.ofBijective (IsLocalRing.residue _)
      ⟨(injective_iff_map_eq_zero _).2 fun a ha ↦ by
      rwa [IsLocalRing.residue_eq_zero_iff, maximalIdeal_strictHenselization_eq_bot hs,
        Ideal.mem_bot] at ha, IsLocalRing.residue_surjective⟩
  exact ⟨ResidueField ↑(strictHenselization s), inferInstance, inferInstance,
    ⟨Scheme.Spec.mapIso e.symm.toCommRingCatIso.op⟩⟩

end AlgebraicGeometry.Scheme
