module

public import WeilConjectures.AlgebraicGeometry.RegularDivisor
public import WeilConjectures.AlgebraicGeometry.Morphisms.RegularImmersion
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

/-!
# Regular divisors are regular immersions of codimension one

An effective Cartier centre `i : D ⟶ Z` is cut out, locally on `Z`, by a single
non-zero-divisor, so it is a regular immersion of codimension one. Two closed subschemes meeting
transversely at a point have a regular scheme-theoretic intersection, being the spectrum of a
field.

## Main statements

- `AlgebraicGeometry.IsEffectiveCartierCenter.isRegularImmersion`: an effective Cartier centre
  is a regular immersion of codimension one.
- `AlgebraicGeometry.MeetTransverselyAt.isRegular_pullback`: the intersection of two closed
  subschemes meeting transversely at a point is regular.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

/-- An effective Cartier centre is a regular immersion of codimension one: locally its ideal is
generated by a single non-zero-divisor. -/
theorem IsEffectiveCartierCenter.isRegularImmersion {D Z : Scheme.{u}} {i : D ⟶ Z}
    (h : IsEffectiveCartierCenter i) : IsRegularImmersion 1 i := by
  have := h.isClosedImmersion
  obtain ⟨J, hJ, α, rfl⟩ := h
  refine ⟨fun x ↦ ?_⟩
  obtain ⟨U, hxU, s, hs, hJs⟩ := hJ x
  refine ⟨U, hxU, [s], rfl, ?_, ?_⟩
  · rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff]
    exact fun a b hab ↦ sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hs) (a - b) (by
      simpa [sub_mul, sub_eq_zero, mul_comm s] using hab))
  · rw [Scheme.Hom.ker_comp_of_isIso, J.ker_subschemeι, hJs, Ideal.ofList_singleton]

/-- A regular divisor is a regular immersion of codimension one. -/
theorem IsRegularDivisor.isRegularImmersion {D Z : Scheme.{u}} {i : D ⟶ Z}
    (h : IsRegularDivisor i) : IsRegularImmersion 1 i :=
  h.1.isRegularImmersion

/-- If two closed subschemes meet transversely at a point, their scheme-theoretic intersection is
regular: it is the spectrum of a field. -/
theorem MeetTransverselyAt.isRegular_pullback {X Y Z : Scheme.{u}} {iX : X ⟶ Z} {iY : Y ⟶ Z}
    {z : Z} (h : MeetTransverselyAt iX iY z) : IsRegular (pullback iX iY) := by
  obtain ⟨K, _, pX, pY, hp, -⟩ := h
  exact ⟨isRegularLocalRing_stalk_of_etale hp.isoPullback.inv
    IsRegular.isRegularLocalRing_stalk⟩

end AlgebraicGeometry
