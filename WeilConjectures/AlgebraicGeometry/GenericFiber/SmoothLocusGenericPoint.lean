/-!
# Generic points, residue fields of fibre products and the smooth locus

This file collects auxiliary results used for the generic radicial smoothing lemma
(`lem-fin-generic-radicial-smoothing`).

## Main statements

- `genericPoints_subset_of_isOpen_of_dense`: in a noetherian quasi-sober `T₀` space, a dense open
  subset contains the generic points of all irreducible components.
- `AlgebraicGeometry.Scheme.Pullback.closure_range_residueFieldMap`: the residue field of a point
  of a fibre product is generated by the images of the residue fields of its two projections.
- `AlgebraicGeometry.Scheme.Hom.mem_smoothLocus_of_formallySmooth_residueFieldMap`: a morphism
  between reduced schemes is smooth at a generic point of an irreducible component lying over a
  generic point of an irreducible component as soon as the residue field extension is formally
  smooth.
-/

@[expose] public section

universe u

open CategoryTheory Limits Topology

section Topology

variable {α : Type*} [TopologicalSpace α]

/-- A homeomorphism maps generic points of irreducible components to generic points of irreducible
components. -/
lemma IsHomeomorph.mem_genericPoints_iff {β : Type*} [TopologicalSpace β] [T0Space α]
    [QuasiSober α] [T0Space β] [QuasiSober β] {f : α → β} (hf : IsHomeomorph f) {x : α} :
    f x ∈ genericPoints β ↔ x ∈ genericPoints α := by
  simp only [mem_genericPoints_iff_forall_specializes]
  refine ⟨fun H y hyx ↦ hf.injective (H _ (hyx.map hf.continuous)), fun H y' hy' ↦ ?_⟩
  obtain ⟨y, rfl⟩ := hf.surjective y'
  rw [H y (hf.isInducing.specializes_iff.1 hy')]

/-- An open embedding maps generic points of irreducible components to generic points of
irreducible components, and conversely. -/
lemma Topology.IsOpenEmbedding.mem_genericPoints_iff {β : Type*} [TopologicalSpace β]
    [T0Space α] [QuasiSober α] [T0Space β] [QuasiSober β] {f : α → β} (hf : IsOpenEmbedding f)
    {x : α} : f x ∈ genericPoints β ↔ x ∈ genericPoints α := by
  simp only [mem_genericPoints_iff_forall_specializes]
  refine ⟨fun H y hyx ↦ hf.injective (H _ (hyx.map hf.continuous)), fun H y' hy' ↦ ?_⟩
  obtain ⟨y, rfl⟩ : y' ∈ Set.range f := hy'.mem_open hf.isOpen_range ⟨x, rfl⟩
  rw [H y (hf.isInducing.specializes_iff.1 hy')]

/-- In a noetherian quasi-sober `T₀` space, a dense open subset contains the generic points of all
irreducible components. -/
lemma genericPoints_subset_of_isOpen_of_dense [T0Space α] [QuasiSober α]
    [TopologicalSpace.NoetherianSpace α] {O : Set α} (hO : IsOpen O) (hO' : Dense O) :
    genericPoints α ⊆ O := by
  intro x hx
  set W : Set α := (⋃₀ (irreducibleComponents α \ {closure {x}}))ᶜ
  have hW : IsOpen W := by
    simp only [W]
    rw [Set.sUnion_eq_biUnion, isOpen_compl_iff]
    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.sdiff.isClosed_biUnion
      fun Z hZ ↦ isClosed_of_mem_irreducibleComponents Z hZ.1
  have hxW : x ∈ W := by
    rintro ⟨Z, ⟨hZ, hZx⟩, hxZ⟩
    have hsub : closure {x} ⊆ Z := (isClosed_of_mem_irreducibleComponents Z hZ).closure_subset_iff.2
      (Set.singleton_subset_iff.2 hxZ)
    exact hZx (Set.Subset.antisymm (hx.2 hZ.1 hsub) hsub)
  obtain ⟨z, hzW, hzO⟩ := hO'.inter_open_nonempty W hW ⟨x, hxW⟩
  obtain ⟨Z, hZ, hzZ⟩ := Set.mem_sUnion.1
    (sUnion_irreducibleComponents (X := α) ▸ Set.mem_univ z)
  have hZx : Z = closure {x} := by
    by_contra h
    exact hzW ⟨Z, ⟨hZ, h⟩, hzZ⟩
  have hxz : x ⤳ z := by
    rw [specializes_iff_mem_closure, ← hZx]
    exact hzZ
  exact hxz.mem_open hO hzO

end Topology

namespace AlgebraicGeometry

namespace Scheme.Pullback

set_option backward.isDefEq.respectTransparency.types false in
/-- The residue field of a point `t` of a fibre product `X ×_S Y` is generated by the images of
the residue fields of the two projections of `t`. -/
theorem closure_range_residueFieldMap {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)
    (t : ↑(pullback f g)) :
    Subfield.closure (Set.range ((pullback.fst f g).residueFieldMap t).hom ∪
      Set.range ((pullback.snd f g).residueFieldMap t).hom) = ⊤ := by
  set F := Subfield.closure (Set.range ((pullback.fst f g).residueFieldMap t).hom ∪
      Set.range ((pullback.snd f g).residueFieldMap t).hom)
  let ι : CommRingCat.of F ⟶ (pullback f g).residueField t := CommRingCat.ofHom F.subtype
  let a : X.residueField (pullback.fst f g t) ⟶ CommRingCat.of F := CommRingCat.ofHom
    (((pullback.fst f g).residueFieldMap t).hom.codRestrict F
      fun z ↦ Subfield.subset_closure (Or.inl ⟨z, rfl⟩))
  let b : Y.residueField (pullback.snd f g t) ⟶ CommRingCat.of F := CommRingCat.ofHom
    (((pullback.snd f g).residueFieldMap t).hom.codRestrict F
      fun z ↦ Subfield.subset_closure (Or.inr ⟨z, rfl⟩))
  have ha : a ≫ ι = (pullback.fst f g).residueFieldMap t := rfl
  have hb : b ≫ ι = (pullback.snd f g).residueFieldMap t := rfl
  have hι : Function.Injective ι.hom := Subtype.val_injective
  set T := Triplet.ofPoint t
  have hab : ((S.residueFieldCongr T.hx).inv ≫ f.residueFieldMap T.x) ≫ a =
      ((S.residueFieldCongr T.hy).inv ≫ g.residueFieldMap T.y) ≫ b := by
    ext z
    have h := residueFieldCongr_inv_residueFieldMap_ofPoint (f := f) (g := g) t
    rw [← ha, ← hb] at h
    exact congr(($h).hom z)
  let φ : Spec (.of F) ⟶ pullback f g := Spec.map (pushout.desc a b hab) ≫ T.SpecTensorTo
  have hφ : Spec.map ι ≫ φ = (pullback f g).fromSpecResidueField t := by
    rw [← ofPointTensor_SpecTensorTo, ← Spec.map_comp_assoc]
    congr 2
    apply pushout.hom_ext
    · rw [pushout.inl_desc_assoc, ha]
      exact (pushout.inl_desc _ _ _).symm
    · rw [pushout.inr_desc_assoc, hb]
      exact (pushout.inr_desc _ _ _).symm
  have hpt : φ (IsLocalRing.closedPoint F) = t := by
    have h := congr(($hφ) (IsLocalRing.closedPoint ((pullback f g).residueField t)))
    rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h
    rwa [Subsingleton.elim (Spec.map ι (IsLocalRing.closedPoint _))
      (IsLocalRing.closedPoint F)] at h
  set χ := Scheme.descResidueField (Scheme.stalkClosedPointTo φ)
  have hχ : Spec.map χ ≫ (pullback f g).fromSpecResidueField (φ (IsLocalRing.closedPoint F)) =
      φ := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField F _ φ
  set c := ((pullback f g).residueFieldCongr hpt.symm).hom
  have key : Spec.map (c ≫ χ ≫ ι) ≫ (pullback f g).fromSpecResidueField t =
      𝟙 _ ≫ (pullback f g).fromSpecResidueField t := by
    rw [Category.id_comp, Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
      Scheme.residueFieldCongr_fromSpecResidueField, hχ, hφ]
  have key' : c ≫ χ ≫ ι = 𝟙 _ :=
    Spec.map_injective ((cancel_mono _).1 key |>.trans (Spec.map_id _).symm)
  refine eq_top_iff.2 fun z _ ↦ ?_
  have : ι.hom (χ.hom (c.hom z)) = z := congr(($key').hom z)
  rw [← this]
  exact (χ.hom (c.hom z)).2

end Scheme.Pullback

set_option backward.isDefEq.respectTransparency.types false in
/-- On a reduced scheme, the residue map of the stalk at the generic point of an irreducible
component is bijective: the stalk is a field. -/
lemma Scheme.bijective_residue_of_mem_genericPoints {X : Scheme.{u}} [IsReduced X] {x : X}
    (hx : x ∈ genericPoints X) : Function.Bijective (X.residue x).hom := by
  have hfield := isField_stalk_of_closure_mem_irreducibleComponents X x hx
  let := hfield.toField
  refine ⟨fun a b hab ↦ ?_, X.residue_surjective x⟩
  rw [← sub_eq_zero, ← map_sub] at hab
  have hmem := (IsLocalRing.residue_eq_zero_iff _).1 hab
  rwa [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, sub_eq_zero] at hmem

lemma Scheme.isIso_residue_of_mem_genericPoints {X : Scheme.{u}} [IsReduced X] {x : X}
    (hx : x ∈ genericPoints X) : IsIso (X.residue x) :=
  (RingEquiv.ofBijective _ (bijective_residue_of_mem_genericPoints hx)).toCommRingCatIso.isIso_hom

/-- A morphism surjective on stalks induces isomorphisms of residue fields. -/
lemma Scheme.Hom.isIso_residueFieldMap_of_surjectiveOnStalks {X Y : Scheme.{u}} (f : X ⟶ Y)
    [SurjectiveOnStalks f] (x : X) : IsIso (f.residueFieldMap x) := by
  have hsurj : Function.Surjective (f.residueFieldMap x).hom := by
    have h : Function.Surjective (f.stalkMap x ≫ X.residue x).hom :=
      (X.residue_surjective x).comp (f.stalkMap_surjective x)
    rw [← residue_residueFieldMap, CommRingCat.hom_comp, RingHom.coe_comp] at h
    exact Function.Surjective.of_comp h
  exact (RingEquiv.ofBijective _ ⟨(f.residueFieldMap x).hom.injective, hsurj⟩)
    |>.toCommRingCatIso.isIso_hom

/-- The residue field extensions of a morphism locally of finite type are essentially of finite
type. -/
lemma Scheme.Hom.essFiniteType_residueFieldMap {X Y : Scheme.{u}} (f : X ⟶ Y)
    [LocallyOfFiniteType f] (x : X) : (f.residueFieldMap x).hom.EssFiniteType := by
  refine RingHom.EssFiniteType.of_comp (Y.residue (f x)).hom ?_
  rw [← CommRingCat.hom_comp, residue_residueFieldMap, CommRingCat.hom_comp]
  exact RingHom.EssFiniteType.comp (LocallyOfFiniteType.stalkMap f x)
    (RingHom.FiniteType.essFiniteType
      (RingHom.FiniteType.of_surjective _ (X.residue_surjective x)))

/-- Let `f : X ⟶ Y` be locally of finite presentation between reduced schemes, and let `x` be the
generic point of an irreducible component of `X` such that `f x` is the generic point of an
irreducible component of `Y`. If the residue field extension `κ(f x) ⟶ κ(x)` is formally smooth,
then `f` is smooth at `x`. -/
theorem Scheme.Hom.mem_smoothLocus_of_formallySmooth_residueFieldMap {X Y : Scheme.{u}}
    (f : X ⟶ Y) [LocallyOfFinitePresentation f] [IsReduced X] [IsReduced Y] {x : X}
    (hx : x ∈ genericPoints X) (hfx : f x ∈ genericPoints Y)
    (h : (f.residueFieldMap x).hom.FormallySmooth) : x ∈ f.smoothLocus := by
  have := isIso_residue_of_mem_genericPoints hx
  have := isIso_residue_of_mem_genericPoints hfx
  rw [Scheme.Hom.mem_smoothLocus, ← RingHom.FormallySmooth.respectsIso.cancel_right_isIso _
    (X.residue x), ← CommRingCat.hom_comp, ← residue_residueFieldMap, CommRingCat.hom_comp,
    RingHom.FormallySmooth.respectsIso.cancel_left_isIso]
  exact h

end AlgebraicGeometry
