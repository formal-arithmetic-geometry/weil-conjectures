/-!
# A smooth dense open after a finite radicial base change

Let `S` be integral of finite type over a field and `f : X ⟶ S` of finite type. After shrinking
`S` to a nonempty open `U` and making a finite, surjective, radicial base change `S' ⟶ U`, the
reduction of `X_{S'}` has a dense open `V` which is smooth over `S'`, and on which a given
constructible sheaf on `X` becomes finite locally constant. In characteristic zero no base
change is needed (generic smoothness); in characteristic `p` one passes to a finite purely
inseparable extension of the function field of `S`. This is the third step of Deligne's
generic constructibility theorem (`thm-fin-deligne-generic-open`).

## Main statements

- `AlgebraicGeometry.exists_isAffineOpen_forall_genericPoints`: an affine open of the base avoiding
  the images of the vertical irreducible components.
- `AlgebraicGeometry.genericPoints_subset_smoothLocus_of_formallySmooth`: after a radicial base
  change making the residue field extensions at the generic points formally smooth, the reduction
  is smooth at the generic points of its irreducible components.
- `AlgebraicGeometry.exists_isFinite_universallyInjective_smooth_dense`
  (`lem-fin-generic-radicial-smoothing`).
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry
/-- Let `f : X ⟶ S` with `S` integral and `X` noetherian. There is an affine open `S₀` of `S`
containing the generic point such that every generic point of an irreducible component of `X`
mapping into `S₀` maps to the generic point of `S`. -/
lemma exists_isAffineOpen_forall_genericPoints {X S : Scheme.{u}} [IsIntegral S] (f : X ⟶ S)
    [TopologicalSpace.NoetherianSpace X] :
    ∃ S₀ : S.Opens, IsAffineOpen S₀ ∧ genericPoint S ∈ S₀ ∧
      ∀ x ∈ genericPoints X, f x ∈ S₀ → f x = genericPoint S := by
  classical
  have hG : (genericPoints X).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  set Z : Set S := ⋃ x ∈ {x ∈ genericPoints X | f x ≠ genericPoint S}, closure {f x}
  have hZ : IsClosed Z := (hG.subset fun _ h ↦ h.1).isClosed_biUnion fun _ _ ↦ isClosed_closure
  have hηZ : genericPoint S ∉ Z := by
    simp only [Z, Set.mem_iUnion, not_exists]
    intro x ⟨_, hx⟩ hη
    exact hx (((genericPoint_spec S).specializes (Set.mem_univ _)).antisymm
      (specializes_iff_mem_closure.2 hη)).eq.symm
  obtain ⟨S₀, hS₀, hηS₀, hS₀Z⟩ := exists_isAffineOpen_mem_and_subset
    (U := ⟨Zᶜ, hZ.isOpen_compl⟩) hηZ
  refine ⟨S₀, hS₀, hηS₀, fun x hx hxS₀ ↦ by_contra fun hne ↦ hS₀Z hxS₀ ?_⟩
  exact Set.mem_biUnion (x := x) ⟨hx, hne⟩ (subset_closure rfl)

set_option backward.isDefEq.respectTransparency.types false in
/-- **Smoothness at the generic points after a radicial base change.** Let `T` be an integral
affine scheme, `g : Y ⟶ T` locally of finite type with all generic points of irreducible
components of `Y` over the generic point of `T`, and let `φ : Γ(T, ⊤) ⟶ R'` be a ring map to a
noetherian domain such that `Spec R' ⟶ Spec Γ(T, ⊤)` is a universal homeomorphism. Let `K'` be
the fraction field of `R'`, and `ψ : κ(η_T) ⟶ K'` compatible with `φ`. Suppose that every field
generated by compatible images of `K'` and of the residue field of `Y` at a generic point of an
irreducible component is formally smooth over `K'`. Then the reduction of
`Y' = Y ×_T Spec R'` is smooth over `Spec R'` at all generic points of its irreducible
components. -/
theorem genericPoints_subset_smoothLocus_of_formallySmooth {T Y : Scheme.{u}} [IsIntegral T]
    [IsAffine T] (g : Y ⟶ T) [LocallyOfFiniteType g]
    (hY : ∀ y ∈ genericPoints Y, g y = genericPoint T) {R' : Type u} [CommRing R'] [IsDomain R']
    [IsNoetherianRing R'] {K' : Type u} [Field K'] [Algebra R' K'] [IsFractionRing R' K']
    (φ : Γ(T, ⊤) →+* R') [IsUniversalHomeomorphism (Spec.map (CommRingCat.ofHom φ))]
    (ψ : T.residueField (genericPoint T) →+* K')
    (hφψ : (algebraMap R' K').comp φ = ψ.comp (T.Γevaluation (genericPoint T)).hom)
    (hF : ∀ (y : Y) (hy : y ∈ genericPoints Y) (M : Type u) [Field M]
      (α : Y.residueField y →+* M) (β : K' →+* M),
      α.comp ((T.residueFieldCongr (hY y hy).symm).hom ≫ g.residueFieldMap y).hom = β.comp ψ →
      Subfield.closure (Set.range α ∪ Set.range β) = ⊤ →
      letI := β.toAlgebra; Algebra.FormallySmooth K' M) :
    genericPoints (pullback g (Spec.map (CommRingCat.ofHom φ) ≫ T.isoSpec.inv)).nilradical.subscheme
      ⊆ ((pullback g (Spec.map (CommRingCat.ofHom φ) ≫ T.isoSpec.inv)).nilradical.subschemeι ≫
        pullback.snd g (Spec.map (CommRingCat.ofHom φ) ≫ T.isoSpec.inv)).smoothLocus := by
  set π := Spec.map (CommRingCat.ofHom φ) ≫ T.isoSpec.inv
  set X' := pullback g π
  set r := X'.nilradical.subschemeι
  set q := pullback.fst g π
  set f' := pullback.snd g π
  have : Surjective r := ⟨Set.range_eq_univ.1 (by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.support_nilradical]
    rfl)⟩
  have hqh : IsHomeomorph q := q.isHomeomorph
  have hπh : IsHomeomorph π := π.isHomeomorph
  have hrh : IsHomeomorph r := r.isHomeomorph
  have hgS' : genericPoints (Spec (.of R')) = {genericPoint (Spec (.of R'))} :=
    genericPoints_eq_singleton
  have hgT : genericPoints T = {genericPoint T} := genericPoints_eq_singleton
  have hπη : π (genericPoint (Spec (.of R'))) = genericPoint T := by
    have h₁ : genericPoint (Spec (.of R')) ∈ genericPoints (Spec (.of R')) := by
      rw [hgS']
      rfl
    have h₂ := hπh.mem_genericPoints_iff.2 h₁
    rwa [hgT] at h₂
  obtain ⟨e, he⟩ := exists_ringEquiv_residueField_genericPoint_Spec φ ψ hφψ hπη
  intro z hz
  have hx' : r z ∈ genericPoints X' := hrh.mem_genericPoints_iff.2 hz
  have hy : q (r z) ∈ genericPoints Y := hqh.mem_genericPoints_iff.2 hx'
  have hfx' : f' (r z) = genericPoint (Spec (.of R')) := by
    have h₁ : π (f' (r z)) = genericPoint T := by
      have hc : q ≫ g = f' ≫ π := pullback.condition
      rw [← Scheme.Hom.comp_apply, ← hc, Scheme.Hom.comp_apply]
      exact hY _ hy
    have h₂ : π (f' (r z)) ∈ genericPoints T := by
      rw [h₁, hgT]
      rfl
    have h₃ := hπh.mem_genericPoints_iff.1 h₂
    rwa [hgS'] at h₃
  have : LocallyOfFinitePresentation (r ≫ f') :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.2 inferInstance
  refine Scheme.Hom.mem_smoothLocus_of_formallySmooth_residueFieldMap (r ≫ f') hz ?_ ?_
  · change f' (r z) ∈ _
    rw [hfx', hgS']
    rfl
  rw [Scheme.residueFieldMap_comp]
  have := r.isIso_residueFieldMap_of_surjectiveOnStalks z
  rw [CommRingCat.hom_comp, RingHom.FormallySmooth.respectsIso.cancel_right_isIso]
  let eC : CommRingCat.of K' ⟶ (Spec (.of R')).residueField (genericPoint (Spec (.of R'))) :=
    CommRingCat.ofHom e.toRingHom
  have : IsIso eC := ⟨⟨CommRingCat.ofHom e.symm.toRingHom, by ext; simp [eC], by ext; simp [eC]⟩⟩
  have hiso : IsIso (eC ≫ ((Spec (.of R')).residueFieldCongr hfx'.symm).hom) := inferInstance
  set β : K' →+* X'.residueField (r z) :=
    (eC ≫ ((Spec (.of R')).residueFieldCongr hfx'.symm).hom ≫
      f'.residueFieldMap (r z)).hom
  have hgen : Subfield.closure (Set.range (q.residueFieldMap (r z)).hom ∪ Set.range β) = ⊤ := by
    have hβ : Set.range β = Set.range (f'.residueFieldMap (r z)).hom := by
      have hs := (ConcreteCategory.bijective_of_isIso
        (eC ≫ ((Spec (.of R')).residueFieldCongr hfx'.symm).hom)).2
      change Set.range ((f'.residueFieldMap (r z)).hom ∘
        (eC ≫ ((Spec (.of R')).residueFieldCongr hfx'.symm).hom).hom) = _
      rw [Set.range_comp, hs.range_eq, Set.image_univ]
    rw [hβ]
    exact Scheme.Pullback.closure_range_residueFieldMap g π (r z)
  have key : (T.residueFieldCongr (hY _ hy).symm).hom ≫ g.residueFieldMap (q (r z)) ≫
      q.residueFieldMap (r z) = (T.residueFieldCongr hπη.symm).hom ≫
        π.residueFieldMap (genericPoint (Spec (.of R'))) ≫
          ((Spec (.of R')).residueFieldCongr hfx'.symm).hom ≫
          f'.residueFieldMap (r z) := by
    rw [Scheme.Hom.residueFieldMap_congr'_assoc, ← Scheme.residueFieldMap_comp,
      ← Scheme.residueFieldMap_comp, Scheme.Hom.residueFieldMap_congr pullback.condition]
    simp only [Scheme.residueFieldCongr_trans_hom_assoc]
    rfl
  have hcompat : (q.residueFieldMap (r z)).hom.comp ((T.residueFieldCongr (hY _ hy).symm).hom ≫
      g.residueFieldMap (q (r z))).hom = β.comp ψ := by
    ext w
    have h₁ : e (ψ w) = ((T.residueFieldCongr hπη.symm).hom ≫
        π.residueFieldMap (genericPoint (Spec (.of R')))).hom w := congr($he w)
    have h₂ := congr(($key).hom w)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h₁ h₂ ⊢
    rw [h₂]
    exact congrArg _ (congrArg _ h₁.symm)
  have hFS := hF _ hy (X'.residueField (r z)) (q.residueFieldMap (r z)).hom β hcompat hgen
  rw [← RingHom.FormallySmooth.respectsIso.cancel_left_isIso
    (eC ≫ ((Spec (.of R')).residueFieldCongr hfx'.symm).hom)]
  exact hFS



open Scheme

/-- Blueprint `lem-fin-generic-radicial-smoothing`: A smooth dense open after a finite radicial
base change.

Let `S` be integral of finite type over a field `k` and let `f : X ⟶ S` be of finite type with
`X` nonempty. Then there are a nonempty open `U ⊆ S` and a finite, surjective, radicial
(universally injective) `π : S' ⟶ U`, with base change `f' : X' ⟶ S'` of `f` over `U`, and an
immersion `v : V ⟶ X'` from a reduced scheme, with open dense image (so that `V` is a dense open
of `(X')_red`), such that `V` is smooth over `S'`; `S'` is integral, being the spectrum of a
domain in the blueprint construction. For a given constructible sheaf `F` on `X`,
one may require the pullback of `F` to `V` to be finite locally constant.

Moreover, every point `x` of the generic fibre of `f'` outside `V` is a proper specialization of
a point of `V` in the generic fibre: in the generic fibre, the closure of `x` is a proper closed
subset of the irreducible closed subset of `X'` containing it, so that (the generic fibre being
of finite type over a field) every component of the complement of `V` in the generic fibre has
dimension strictly smaller than the component of `X'` containing it. -/
theorem exists_isFinite_universallyInjective_smooth_dense {k : Type u} [Field k]
    {S X : Scheme.{u}} [IsIntegral S] (aS : S ⟶ Spec (.of k)) [LocallyOfFiniteType aS]
    [QuasiCompact aS] (f : X ⟶ S) [LocallyOfFiniteType f] [QuasiCompact f] [Nonempty X]
    (Λ : Type (u + 1)) [CommRing Λ] (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))
    [IsConstructibleSheaf F] :
    ∃ (U : S.Opens) (S' : Scheme.{u}) (π : S' ⟶ U) (X' : Scheme.{u}) (q : X' ⟶ f ⁻¹ᵁ U)
      (f' : X' ⟶ S') (V : Scheme.{u}) (v : V ⟶ X'),
      (U : Set S).Nonempty ∧ IsIntegral S' ∧ IsFinite π ∧ Surjective π ∧ UniversallyInjective π ∧
      IsPullback q f' (f ∣_ U) π ∧ IsImmersion v ∧ IsReduced V ∧ IsOpen (Set.range v) ∧
      Dense (Set.range v) ∧ Smooth (v ≫ f') ∧
      IsFiniteLocallyConstantSheaf
        ((Etale.upperStar (ModuleCat.{u + 1} Λ) (v ≫ q ≫ (f ⁻¹ᵁ U).ι)).obj F) ∧
      ∀ x : X', IsGenericPoint (f' x) Set.univ → x ∉ Set.range v →
        ∃ y ∈ Set.range v, IsGenericPoint (f' y) Set.univ ∧ y ⤳ x ∧ y ≠ x := by
  classical
  -- noetherianity
  have : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian aS
  have : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace aS
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian X := {}
  -- an affine open of `S` avoiding the images of the vertical components of `X`
  obtain ⟨S₀, hS₀, hηS₀, hvert⟩ := exists_isAffineOpen_forall_genericPoints f
  have : IsAffine S₀ := hS₀
  have : Nonempty S₀ := ⟨⟨_, hηS₀⟩⟩
  have hY (y : (f ⁻¹ᵁ S₀).toScheme) (hy : y ∈ genericPoints (f ⁻¹ᵁ S₀).toScheme) :
      (f ∣_ S₀) y = genericPoint S₀.toScheme := by
    have h₁ : (f ⁻¹ᵁ S₀).ι y ∈ genericPoints X :=
      (f ⁻¹ᵁ S₀).ι.isOpenEmbedding.mem_genericPoints_iff.2 hy
    have h₂ := hvert _ h₁ y.2
    apply S₀.ι.isOpenEmbedding.injective
    rw [genericPoint_eq_of_isOpenImmersion S₀.ι, ← h₂, ← Scheme.Hom.comp_apply,
      morphismRestrict_ι, Scheme.Hom.comp_apply]
  -- the finite purely inseparable extension of the function field
  have : CompactSpace (f ⁻¹ᵁ S₀) := QuasiCompact.compactSpace_of_compactSpace (f ∣_ S₀)
  have : IsNoetherian (f ⁻¹ᵁ S₀) := {}
  set K₀ := S₀.toScheme.residueField (genericPoint S₀.toScheme)
  have hfin : (genericPoints (f ⁻¹ᵁ S₀).toScheme).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have : Finite (genericPoints (f ⁻¹ᵁ S₀).toScheme) := hfin.to_subtype
  let L : genericPoints (f ⁻¹ᵁ S₀).toScheme → Type u := fun y ↦ (f ⁻¹ᵁ S₀).toScheme.residueField y.1
  let (y : genericPoints (f ⁻¹ᵁ S₀).toScheme) : Algebra K₀ (L y) :=
    ((S₀.toScheme.residueFieldCongr (hY y.1 y.2).symm).hom ≫
      (f ∣_ S₀).residueFieldMap y.1).hom.toAlgebra
  have (y : genericPoints (f ⁻¹ᵁ S₀).toScheme) : Algebra.EssFiniteType K₀ (L y) :=
    RingHom.EssFiniteType.comp
      (RingHom.FiniteType.essFiniteType (RingHom.FiniteType.of_surjective _
        (S₀.toScheme.residueFieldCongr
          (hY y.1 y.2).symm).commRingCatIsoToRingEquiv.surjective))
      ((f ∣_ S₀).essFiniteType_residueFieldMap y.1)
  obtain ⟨K', _, _, _, _, hF⟩ := exists_finiteDimensional_isPurelyInseparable_formallySmooth K₀ L
  -- the finite radicial cover `S' = Spec R'`
  let : Algebra Γ(S₀.toScheme, ⊤) K₀ :=
    (S₀.toScheme.Γevaluation (genericPoint S₀.toScheme)).hom.toAlgebra
  have : IsFractionRing Γ(S₀.toScheme, ⊤) K₀ :=
    S₀.toScheme.isFractionRing_residueField_genericPoint
  let : Algebra Γ(S₀.toScheme, ⊤) K' :=
    ((algebraMap K₀ K').comp (algebraMap Γ(S₀.toScheme, ⊤) K₀)).toAlgebra
  have : IsScalarTower Γ(S₀.toScheme, ⊤) K₀ K' := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  obtain ⟨R', _, _, _⟩ :=
    exists_subalgebra_finite_isFractionRing_isUniversalHomeomorphism (R := Γ(S₀.toScheme, ⊤))
      (K := K₀) (K' := K')
  have : IsNoetherianRing Γ(S₀.toScheme, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top _⟩
  have : IsNoetherianRing R' := IsNoetherianRing.of_finite Γ(S₀.toScheme, ⊤) R'
  set φ : Γ(S₀.toScheme, ⊤) →+* R' := algebraMap Γ(S₀.toScheme, ⊤) R'
  have : IsUniversalHomeomorphism (Spec.map (CommRingCat.ofHom φ)) :=
    Algebra.IsUniversalHomeomorphism.isUniversalHomeomorphism
  have hB := genericPoints_subset_smoothLocus_of_formallySmooth (f ∣_ S₀) hY φ
    (algebraMap K₀ K') rfl (fun y hy M _ α β ↦ hF ⟨y, hy⟩ M α β)
  set π := Spec.map (CommRingCat.ofHom φ) ≫ S₀.toScheme.isoSpec.inv
  set X' := pullback (f ∣_ S₀) π
  set q := pullback.fst (f ∣_ S₀) π
  set f' := pullback.snd (f ∣_ S₀) π
  set r := X'.nilradical.subschemeι
  have : Surjective r := ⟨Set.range_eq_univ.1 (by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.support_nilradical]
    rfl)⟩
  have hrh : IsHomeomorph r := r.isHomeomorph
  have hqh : IsHomeomorph q := q.isHomeomorph
  have : LocallyOfFinitePresentation (r ≫ f') :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.2 inferInstance
  -- the dense open where `F` is finite locally constant
  obtain ⟨UF, hUFd, hUF⟩ := Scheme.IsConstructibleSheaf.exists_dense_open F
  set h := r ≫ q ≫ (f ⁻¹ᵁ S₀).ι
  set V : X'.nilradical.subscheme.Opens := (r ≫ f').smoothLocus ⊓ h ⁻¹ᵁ UF
  have hVd : Dense (V : Set X'.nilradical.subscheme) := by
    have h₁ : Dense ((r ≫ f').smoothLocus : Set X'.nilradical.subscheme) :=
      (dense_iff_closure_eq.2 genericPoints.closure).mono hB
    have h₂ : Dense ((h ⁻¹ᵁ UF : X'.nilradical.subscheme.Opens) :
        Set X'.nilradical.subscheme) := by
      change Dense (r ⁻¹' (q ⁻¹' ((f ⁻¹ᵁ S₀).ι ⁻¹' UF)))
      exact
      ((hUFd.preimage (f ⁻¹ᵁ S₀).ι.isOpenEmbedding.isOpenMap).preimage
        hqh.isOpenMap).preimage hrh.isOpenMap
    exact h₁.inter_of_isOpen_left h₂ (r ≫ f').smoothLocus.isOpen
  -- noetherianity of the reduction of `X'`
  have : IsLocallyNoetherian X' := LocallyOfFiniteType.isLocallyNoetherian f'
  have : CompactSpace X' := QuasiCompact.compactSpace_of_compactSpace q
  have : IsNoetherian X' := {}
  have : TopologicalSpace.NoetherianSpace X'.nilradical.subscheme :=
    r.isClosedEmbedding.isInducing.noetherianSpace
  refine ⟨S₀, Spec (.of R'), π, X', q, f', V, V.ι ≫ r, ⟨_, hηS₀⟩, inferInstance, ?_, inferInstance,
    inferInstance, IsPullback.of_hasPullback _ _, inferInstance, inferInstance, ?_, ?_, ?_, ?_, ?_⟩
  · have : IsFinite (Spec.map (CommRingCat.ofHom φ)) := by
      rw [IsFinite.SpecMap_iff]
      exact RingHom.finite_algebraMap.2 ‹_›
    infer_instance
  · rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, Scheme.Opens.range_ι]
    exact hrh.isOpenMap _ V.isOpen
  · rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, Scheme.Opens.range_ι]
    exact hrh.surjective.denseRange.dense_image hrh.continuous hVd
  · rw [Category.assoc, ← Scheme.Hom.smoothLocus_eq_top_iff,
      ← Scheme.Hom.preimage_smoothLocus_eq]
    exact eq_top_iff.2 fun x _ ↦ (inf_le_left : V ≤ _) x.2
  · have hl : Set.range (V.ι ≫ h) ⊆ Set.range UF.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      exact (inf_le_right : V ≤ h ⁻¹ᵁ UF) w.2
    set l := IsOpenImmersion.lift UF.ι (V.ι ≫ h) hl
    have : IsFiniteLocallyConstantSheaf ((Etale.upperStar (ModuleCat.{u + 1} Λ) UF.ι ⋙
        Etale.upperStar (ModuleCat.{u + 1} Λ) l).obj F) :=
      IsFiniteLocallyConstantSheaf.upperStar l _
    exact IsFiniteLocallyConstantSheaf.of_iso ((Etale.upperStarComp _ l UF.ι
      ((V.ι ≫ r) ≫ q ≫ (f ⁻¹ᵁ S₀).ι) (by
        rw [IsOpenImmersion.lift_fac]
        simp only [h, Category.assoc])).app F).symm
  · intro x hx hxv
    obtain ⟨y', hy', hy'x⟩ : ∃ y' ∈ genericPoints X', y' ⤳ x :=
      ⟨_, (genericPoints.ofComponent ⟨_, irreducibleComponent_mem_irreducibleComponents x⟩).2,
        (genericPoints.isGenericPoint_ofComponent _).specializes mem_irreducibleComponent⟩
    obtain ⟨z, rfl⟩ := hrh.surjective y'
    have hz : z ∈ genericPoints X'.nilradical.subscheme := hrh.mem_genericPoints_iff.1 hy'
    have hzV : z ∈ V := genericPoints_subset_of_isOpen_of_dense V.isOpen hVd hz
    have hmem : r z ∈ Set.range (V.ι ≫ r) := ⟨⟨z, hzV⟩, rfl⟩
    refine ⟨r z, hmem, ?_, hy'x, fun e ↦ hxv (e ▸ hmem)⟩
    rw [isGenericPoint_iff_specializes]
    exact fun b ↦ ⟨fun _ ↦ trivial,
      fun _ ↦ (hy'x.map f'.continuous).trans (hx.specializes trivial)⟩

end AlgebraicGeometry
