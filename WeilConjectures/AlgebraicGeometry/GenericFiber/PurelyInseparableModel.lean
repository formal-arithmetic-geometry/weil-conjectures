module

public import Mathlib.Algebra.CharP.Reduced
public import Mathlib.FieldTheory.PurelyInseparable.Exponent
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.Integer
public import Mathlib.RingTheory.Localization.LocalizationLocalization
public import WeilConjectures.AlgebraicGeometry.Morphisms.UniversalHomeomorphism.Algebra

/-!
# Finite radicial models of purely inseparable extensions

Let `R` be a domain with fraction field `K` and `L / K` a finite purely inseparable extension.
After inverting a nonzero element `c` of `R`, there is a domain `B` with fraction field `L`,
finite over `R[1/c]`, such that `Spec B ⟶ Spec R[1/c]` is a universal homeomorphism: take for
`B` the `R[1/c]`-subalgebra of `L` generated by generators `aᵢ` of `L / K` with
`aᵢ ^ q ∈ R[1/c]` (`q` a power of the exponential characteristic). Every element `b` of `B`
then satisfies `b ^ q' ∈ R[1/c]` for a fixed power `q'`, so two points of `Spec B` with values
in a field which agree on `R[1/c]` agree (injectivity of Frobenius).

This is the radicial base change used for
`AlgebraicGeometry.exists_isFinite_universallyInjective_smooth_dense`.

## Main statements

- `Algebra.IsUniversalHomeomorphism.of_pow_mem`: an integral extension `A ⊆ B` in which some
  `q`-power of every element lies in `A` (`q` the exponential characteristic) is a universal
  homeomorphism.
- `AlgebraicGeometry.exists_finite_isUniversalHomeomorphism_isFractionRing`
-/

@[expose] public section

universe u

namespace AlgebraicGeometry

/-- An integral extension `A ⊆ B` such that for every `b : B` some power `b ^ q ^ n` lies in `A`,
where `q` is the exponential characteristic of `B`, is a universal homeomorphism: it is
surjective on spectra by lying over, and two field points of `Spec B` which agree on `A` agree
by injectivity of Frobenius. -/
theorem _root_.Algebra.IsUniversalHomeomorphism.of_pow_mem {A B : Type u} [CommRing A]
    [CommRing B] [Algebra A B] [Algebra.IsIntegral A B] [FaithfulSMul A B] (q : ℕ)
    [ExpChar B q] (h : ∀ b : B, ∃ n, b ^ q ^ n ∈ (algebraMap A B).range) :
    Algebra.IsUniversalHomeomorphism A B where
  isUniversalHomeomorphism := by
    let f := Spec.map (CommRingCat.ofHom (algebraMap A B))
    have h1 : IsIntegralHom f := IsIntegralHom.SpecMap_iff.mpr
      ((algebraMap_isIntegral_iff (R := A) (A := B)).mpr inferInstance)
    have h2 : Surjective f := ⟨Algebra.IsIntegral.comap_surjective A B⟩
    have h3 : UniversallyInjective f := by
      refine ((tfae_universallyInjective f).out 2 1).mp ?_
      intro Ω _ g₁ g₂ hg
      rw [← Spec.map_preimage g₁, ← Spec.map_preimage g₂] at hg ⊢
      simp only [f, ← Spec.map_comp] at hg
      have hφ := congrArg CommRingCat.Hom.hom (Spec.map_injective hg)
      congr 1
      ext b
      obtain ⟨n, a, ha⟩ := h b
      have hb : (Spec.preimage g₁).hom b ^ q ^ n = (Spec.preimage g₂).hom b ^ q ^ n := by
        rw [← map_pow, ← map_pow, ← ha]
        simpa using congr($hφ a)
      rcases ‹ExpChar B q› with _ | ⟨hp⟩
      · simpa using hb
      · have : CharP Ω q := (CharP.charP_iff_prime_eq_zero hp).mpr (by
          rw [← map_natCast (Spec.preimage g₁).hom, CharP.cast_eq_zero, map_zero])
        have : ExpChar Ω q := .prime hp
        exact iterateFrobenius_inj Ω q n (by rwa [iterateFrobenius_def, iterateFrobenius_def])
    exact { }

/-- **A finite radicial model of a purely inseparable extension.** Let `R` be a domain with
fraction field `K` and `L / K` finite and purely inseparable. There are a nonzero `c ∈ R` and a
domain `B` with fraction field `L` which is a finite `R[1/c]`-algebra such that
`Spec B ⟶ Spec R[1/c]` is a universal homeomorphism, compatibly with `R ⟶ K ⟶ L`. -/
theorem exists_finite_isUniversalHomeomorphism_isFractionRing (R K L : Type u) [CommRing R]
    [IsDomain R] [Field K] [Field L] [Algebra R K] [IsFractionRing R K] [Algebra K L]
    [FiniteDimensional K L] [IsPurelyInseparable K L] :
    ∃ (c : R) (_ : c ≠ 0) (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (_ : Algebra (Localization.Away c) B) (_ : Algebra B L) (_ : IsFractionRing B L),
      Module.Finite (Localization.Away c) B ∧
      Algebra.IsUniversalHomeomorphism (Localization.Away c) B ∧
      ∀ r : R, algebraMap B L (algebraMap (Localization.Away c) B (algebraMap R _ r)) =
        algebraMap K L (algebraMap R K r) := by
  classical
  set q := ringExpChar K
  have : ExpChar L q := expChar_of_injective_algebraMap (algebraMap K L).injective q
  set e := IsPurelyInseparable.exponent K L
  let bas := Module.finBasis K L
  choose k hk using fun i ↦ IsPurelyInseparable.exponent_def' K q (bas i)
  obtain ⟨⟨c, hc0⟩, hc⟩ :=
    IsLocalization.exist_integer_multiples (nonZeroDivisors R) Finset.univ k
  choose r hr using fun i ↦ hc i (Finset.mem_univ i)
  have hc : c ≠ 0 := nonZeroDivisors.ne_zero hc0
  have hcu : IsUnit (algebraMap R K c) :=
    IsUnit.mk0 _ (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hc0)
  let A := Localization.Away c
  let : Algebra A K := (IsLocalization.Away.lift c hcu).toAlgebra
  have : IsScalarTower R A K :=
    .of_algebraMap_eq fun x ↦ (IsLocalization.Away.lift_eq c hcu x).symm
  have : IsFractionRing A K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers c) A K
  let : Algebra A L := ((algebraMap K L).comp (algebraMap A K)).toAlgebra
  have : IsScalarTower A K L := .of_algebraMap_eq fun _ ↦ rfl
  have hAL : Function.Injective (algebraMap A L) :=
    (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hRL (x : R) : algebraMap A L (algebraMap R A x) = algebraMap K L (algebraMap R K x) := by
    rw [IsScalarTower.algebraMap_apply A K L, ← IsScalarTower.algebraMap_apply R A K]
  have hinv : algebraMap K L (algebraMap R K c) *
      algebraMap A L (IsLocalization.Away.invSelf c) = 1 := by
    rw [← hRL, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
  have hgen (i : Fin (Module.finrank K L)) : bas i ^ q ^ e =
      algebraMap A L (algebraMap R A (r i) * IsLocalization.Away.invSelf c) := by
    rw [map_mul, hRL, hr i, Algebra.smul_def, map_mul, hk i, mul_comm, ← mul_assoc,
      mul_comm _ (algebraMap K L _), hinv, one_mul]
  let B : Subalgebra A L := Algebra.adjoin A (Set.range bas)
  have hBL : Function.Injective (algebraMap B L) := Subtype.val_injective
  have hpow (x : L) (hx : x ∈ B) : x ^ q ^ e ∈ (algebraMap A L).range := by
    induction hx using Algebra.adjoin_induction with
    | mem x hx => obtain ⟨i, rfl⟩ := hx; exact ⟨_, (hgen i).symm⟩
    | algebraMap a => exact ⟨a ^ q ^ e, by simp⟩
    | add x y _ _ hx hy => rw [add_pow_expChar_pow]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [mul_pow]; exact mul_mem hx hy
  have hint (i : Fin (Module.finrank K L)) : _root_.IsIntegral A (bas i) :=
    IsIntegral.of_pow (pow_pos (expChar_pos L q) e) (by rw [hgen i]; exact isIntegral_algebraMap)
  have hfin : Module.Finite A B := Algebra.finite_adjoin_of_finite_of_isIntegral
    (Set.finite_range bas) (by rintro _ ⟨i, rfl⟩; exact hint i)
  have : FaithfulSMul A B := (faithfulSMul_iff_algebraMap_injective A B).mpr
    fun x y h ↦ hAL (congrArg Subtype.val h)
  have : ExpChar B q := (algebraMap B L).expChar hBL q
  have hfrac : IsFractionRing B L := by
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · rintro ⟨y, hy⟩
      exact IsUnit.mk0 _ fun h ↦ nonZeroDivisors.ne_zero hy (hBL (by rw [h, map_zero]))
    · intro z
      obtain ⟨⟨s, hs⟩, hs'⟩ :=
        IsLocalization.exist_integer_multiples (nonZeroDivisors R) Finset.univ (bas.repr z)
      choose t ht using fun i ↦ hs' i (Finset.mem_univ i)
      have hmem : z * algebraMap A L (algebraMap R A s) ∈ B := by
        have : z * algebraMap A L (algebraMap R A s) =
            ∑ i, algebraMap A L (algebraMap R A (t i)) * bas i := by
          conv_lhs => rw [← bas.sum_repr z]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ ↦ ?_
          rw [hRL, hRL, ht, Algebra.smul_def, Algebra.smul_def, map_mul]
          ring
        rw [this]
        exact Subalgebra.sum_mem _ fun i _ ↦ Subalgebra.mul_mem _
          (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin ⟨i, rfl⟩)
      have hsB : algebraMap A B (algebraMap R A s) ∈ nonZeroDivisors B := by
        refine mem_nonZeroDivisors_of_ne_zero fun h ↦ nonZeroDivisors.ne_zero hs ?_
        have h' := congrArg (algebraMap B L) h
        rw [map_zero, ← IsScalarTower.algebraMap_apply, hRL] at h'
        exact IsFractionRing.injective R K
          ((algebraMap K L).injective (by rw [h', map_zero, map_zero]))
      exact ⟨(⟨_, hmem⟩, ⟨_, hsB⟩), rfl⟩
    · intro x y h
      exact ⟨1, by simpa using hBL h⟩
  refine ⟨c, hc, B, inferInstance, inferInstance, inferInstance, inferInstance, hfrac, hfin,
    ?_, fun x ↦ ?_⟩
  · refine Algebra.IsUniversalHomeomorphism.of_pow_mem q fun x ↦ ⟨e, ?_⟩
    obtain ⟨a, ha⟩ := hpow x x.2
    exact ⟨a, hBL (by rw [← IsScalarTower.algebraMap_apply]; exact ha.trans (by simp))⟩
  · rw [← IsScalarTower.algebraMap_apply, hRL]

end AlgebraicGeometry
