public import Mathlib.RingTheory.Smooth.Field
public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.FieldTheory.PurelyInseparable.PerfectClosure
public import WeilConjectures.AlgebraicGeometry.Morphisms.UniversalHomeomorphism.Algebra

/-!
# Separable compositum after a finite purely inseparable extension

Let `L i` be finitely many extensions of a field `K`, each essentially of finite type. After a
finite purely inseparable extension `K'/K`, every field generated by compatible images of some
`L i` and of `K'` is formally smooth (i.e. separably generated) over `K'`. In characteristic `p`
one passes to the perfect closure of `K`, over which finitely generated extensions are separably
generated; the finitely many coefficients involved lie in a finite purely inseparable extension.

We also show that a finite purely inseparable extension `K'` of the fraction field of a domain
`R` contains a finite `R`-subalgebra `R'` with fraction field `K'` such that `Spec R' ⟶ Spec R`
is a universal homeomorphism.

## Main statements

- `exists_finiteDimensional_isPurelyInseparable_formallySmooth`
- `exists_subalgebra_finite_isFractionRing_isUniversalHomeomorphism`
-/

@[expose] public section

universe u

open AlgebraicGeometry IntermediateField

open scoped Polynomial

/-- If `R` is a domain of exponential characteristic `q` and `f : R →+* Ω` is a map to a field,
then `x ↦ x ^ q ^ n` is injective on `Ω`. -/
lemma eq_of_pow_expChar_pow_eq_of_ringHom {R Ω : Type*} [CommRing R] [IsDomain R] [Field Ω]
    (f : R →+* Ω) (q : ℕ) [hq : ExpChar R q] (n : ℕ) {x y : Ω} (h : x ^ q ^ n = y ^ q ^ n) :
    x = y := by
  cases hq with
  | zero => simpa using h
  | prime hprime =>
    have : CharP Ω q := CharP.of_ringHom_of_ne_zero f q hprime.ne_zero
    have : ExpChar Ω q := .prime hprime
    exact iterateFrobenius_inj Ω q n (by simpa [iterateFrobenius_def] using h)

/-- A finite purely inseparable extension `K'` of the fraction field `K` of a domain `R` contains a
finite `R`-subalgebra `R'` with fraction field `K'` such that `Spec R' ⟶ Spec R` is a universal
homeomorphism. -/
theorem exists_subalgebra_finite_isFractionRing_isUniversalHomeomorphism {R K K' : Type u}
    [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K] [Field K']
    [Algebra K K'] [FiniteDimensional K K'] [IsPurelyInseparable K K'] [Algebra R K']
    [IsScalarTower R K K'] :
    ∃ R' : Subalgebra R K', Module.Finite R R' ∧ IsFractionRing R' K' ∧
      Algebra.IsUniversalHomeomorphism R R' := by
  classical
  obtain ⟨q, hq⟩ : ∃ q, ExpChar R q := ⟨_, ringExpChar.expChar R⟩
  have : ExpChar K q := expChar_of_injective_algebraMap (IsFractionRing.injective R K) q
  have hinj : Function.Injective (algebraMap R K') := by
    rw [IsScalarTower.algebraMap_eq R K K']
    exact (algebraMap K K').injective.comp (IsFractionRing.injective R K)
  -- For every `c : K'` there is `0 ≠ b ∈ R` with `(b * c) ^ q ^ n ∈ R`.
  have key (c : K') : ∃ b : R, b ≠ 0 ∧ ∃ n : ℕ, ∃ r : R,
      (algebraMap R K' b * c) ^ q ^ n = algebraMap R K' r := by
    obtain ⟨n, k, hk⟩ := (isPurelyInseparable_iff_pow_mem K q).1 inferInstance c
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := R) k
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    obtain ⟨m, hm⟩ : ∃ m, q ^ n = m + 1 :=
      Nat.exists_eq_add_one.2 (pow_pos (expChar_pos K q) n)
    refine ⟨b, hb0, n, b ^ m * a, ?_⟩
    have hB : algebraMap R K' b ≠ 0 := (map_ne_zero_iff _ hinj).2 hb0
    rw [mul_pow, ← hk, map_div₀, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, hm, map_mul, map_pow]
    field_simp
    ring
  choose b hb n r hr using key
  obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := K) (M := K')
  set D : Finset K' := S.image fun c ↦ algebraMap R K' (b c) * c with hD
  set R' : Subalgebra R K' := Algebra.adjoin R (D : Set K') with hR'
  have hint (x : K') (hx : x ∈ D) : IsIntegral R x := by
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.1 hx
    refine IsIntegral.of_pow (pow_pos (expChar_pos R q) (n c)) ?_
    rw [hr c]
    exact isIntegral_algebraMap
  have hfin : Module.Finite R R' := Module.Finite.iff_fg.2 (fg_adjoin_of_finite D.finite_toSet hint)
  refine ⟨R', hfin, ?_, ?_⟩
  · have : FaithfulSMul R' K' :=
      (faithfulSMul_iff_algebraMap_injective R' K').2 Subtype.val_injective
    refine IsFractionRing.of_field (R := R') (K := K') fun z ↦ ?_
    have hz : ∀ z ∈ Submodule.span K (S : Set K'), ∃ x ∈ R', ∃ e : R, e ≠ 0 ∧
        algebraMap R K' e * z = x := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem c hc =>
        exact ⟨_, Algebra.subset_adjoin (Finset.mem_image_of_mem _ hc), b c, hb c, rfl⟩
      | zero => exact ⟨0, zero_mem _, 1, one_ne_zero, by simp⟩
      | add z₁ z₂ _ _ h₁ h₂ =>
        obtain ⟨x₁, hx₁, e₁, he₁, rfl⟩ := h₁
        obtain ⟨x₂, hx₂, e₂, he₂, rfl⟩ := h₂
        refine ⟨_, add_mem (mul_mem (R'.algebraMap_mem e₂) hx₁)
          (mul_mem (R'.algebraMap_mem e₁) hx₂), e₁ * e₂, mul_ne_zero he₁ he₂, ?_⟩
        rw [map_mul]
        ring
      | smul k z _ h =>
        obtain ⟨x, hx, e, he, rfl⟩ := h
        obtain ⟨a, e', he', rfl⟩ := IsFractionRing.div_surjective (A := R) k
        have he'0 : e' ≠ 0 := nonZeroDivisors.ne_zero he'
        refine ⟨_, mul_mem (R'.algebraMap_mem a) hx, e' * e, mul_ne_zero he'0 he, ?_⟩
        have hE : algebraMap R K' e' ≠ 0 := (map_ne_zero_iff _ hinj).2 he'0
        rw [Algebra.smul_def, map_div₀, ← IsScalarTower.algebraMap_apply,
          ← IsScalarTower.algebraMap_apply, map_mul]
        field_simp
    obtain ⟨x, hx, e, he, hxe⟩ := hz z (hS ▸ Submodule.mem_top)
    refine ⟨⟨x, hx⟩, algebraMap R R' e, ?_⟩
    have hE : algebraMap R K' e ≠ 0 := (map_ne_zero_iff _ hinj).2 he
    change z = x / algebraMap R K' e
    rw [eq_div_iff hE, ← hxe, mul_comm]
  · have hext (Ω : Type u) [Field Ω] (φ₁ φ₂ : R' →+* Ω)
        (h : φ₁.comp (algebraMap R R') = φ₂.comp (algebraMap R R')) : φ₁ = φ₂ := by
      ext ⟨x, hx⟩
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨c, -, rfl⟩ := Finset.mem_image.1 hx
        have hd : (⟨_, Algebra.subset_adjoin hx⟩ : R') ^ q ^ n c = algebraMap R R' (r c) :=
          Subtype.ext (by simpa using hr c)
        refine eq_of_pow_expChar_pow_eq_of_ringHom (φ₁.comp (algebraMap R R')) q (n c) ?_
        rw [← map_pow, ← map_pow, hd, ← RingHom.comp_apply, h, RingHom.comp_apply]
      | algebraMap s => exact congr($h s)
      | add x y hx hy hx' hy' =>
        change φ₁ (⟨x, hx⟩ + ⟨y, hy⟩) = φ₂ (⟨x, hx⟩ + ⟨y, hy⟩)
        rw [map_add, map_add, hx', hy']
      | mul x y hx hy hx' hy' =>
        change φ₁ (⟨x, hx⟩ * ⟨y, hy⟩) = φ₂ (⟨x, hx⟩ * ⟨y, hy⟩)
        rw [map_mul, map_mul, hx', hy']
    have : Algebra.IsIntegral R R' := Algebra.IsIntegral.of_finite R R'
    have : FaithfulSMul R R' := (faithfulSMul_iff_algebraMap_injective R R').2
      fun x y h ↦ hinj (congrArg Subtype.val h)
    refine ⟨?_⟩
    let f := Spec.map (CommRingCat.ofHom (algebraMap R R'))
    have h1 : IsIntegralHom f := IsIntegralHom.SpecMap_iff.mpr
      ((algebraMap_isIntegral_iff (R := R) (A := R')).mpr inferInstance)
    have h2 : Surjective f := ⟨Algebra.IsIntegral.comap_surjective R R'⟩
    have h3 : UniversallyInjective f := by
      refine ((tfae_universallyInjective f).out 1 0).mp ?_
      intro Ω _ g₁ g₂ hg
      rw [← Spec.map_preimage g₁, ← Spec.map_preimage g₂] at hg ⊢
      simp only [f, ← Spec.map_comp] at hg
      have h := Spec.map_injective hg
      congr 1
      ext x
      exact congr($(hext Ω (Spec.preimage g₁).hom (Spec.preimage g₂).hom
        (congrArg CommRingCat.Hom.hom h)) x)
    exact { }

/-- Let `θ : M →+* Ω` be a map of fields and `M` an extension of `K'`, generated by `T` over `K'`.
Let `v` be algebraically independent over `K'` such that every `θ t` (`t ∈ T`) is a root of a
separable polynomial whose coefficients lie in the image of `K'(v)`. Then `M` is formally smooth
over `K'`. -/
theorem Algebra.FormallySmooth.of_algebraicIndependent_of_separable_map {K' M Ω ι : Type*}
    [Field K'] [Field M] [Field Ω] [Algebra K' M] (θ : M →+* Ω) {v : ι → M}
    (hv : AlgebraicIndependent K' v) (T : Set M) (hT : IntermediateField.adjoin K' T = ⊤)
    (hsep : ∀ t ∈ T, ∃ f : Polynomial Ω, f.Separable ∧ f.eval (θ t) = 0 ∧
      ∀ n, f.coeff n ∈ (IntermediateField.adjoin K' (Set.range v)).toSubfield.map θ) :
    Algebra.FormallySmooth K' M := by
  set A := IntermediateField.adjoin K' (Set.range v)
  have hsepA (t : M) (ht : t ∈ T) : IsSeparable A t := by
    obtain ⟨f, hf, hft, hcoeff⟩ := hsep t ht
    let θA : A →+* Ω := θ.comp (algebraMap A M)
    have hlift : f ∈ Polynomial.lifts θA := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      obtain ⟨y, hy, hyn⟩ := Subfield.mem_map.1 (hcoeff n)
      exact ⟨⟨y, hy⟩, hyn⟩
    obtain ⟨g, hg⟩ := (Polynomial.mem_lifts f).1 hlift
    have hgsep : g.Separable := (Polynomial.separable_map θA).1 (hg ▸ hf)
    have hgt : Polynomial.aeval t g = 0 := by
      apply θ.injective
      rw [map_zero, ← hft, ← hg, Polynomial.eval_map, Polynomial.aeval_def, Polynomial.hom_eval₂]
    exact hgsep.of_dvd (minpoly.dvd A t hgt)
  have : Algebra.IsSeparable A M := by
    rw [← separableClosure.eq_top_iff, ← (restrictScalars_injective K').eq_iff,
      IntermediateField.restrictScalars_top, _root_.eq_top_iff, ← hT,
      IntermediateField.adjoin_le_iff]
    exact hsepA
  exact .of_algebraicIndependent_of_isSeparable hv

/-- If finitely many elements lie in the field generated by `P ∪ X`, they lie in the field
generated by `C ∪ X` for a finite `C ⊆ P`. -/
lemma IntermediateField.exists_finset_subset_and_subset_adjoin_union {K Ω : Type*} [Field K]
    [Field Ω] [Algebra K Ω] (P X : Set Ω) (Y : Finset Ω)
    (hY : (Y : Set Ω) ⊆ adjoin K (P ∪ X)) :
    ∃ C : Finset Ω, ↑C ⊆ P ∧ (Y : Set Ω) ⊆ adjoin K (↑C ∪ X) := by
  classical
  induction Y using Finset.induction_on with
  | empty => exact ⟨∅, by simp, by simp⟩
  | insert a Y _ ih =>
    rw [Finset.coe_insert, Set.insert_subset_iff] at hY
    obtain ⟨C₁, hC₁P, hC₁⟩ := ih hY.2
    obtain ⟨T, hTPX, haT⟩ := exists_finset_of_mem_adjoin hY.1
    refine ⟨C₁ ∪ T.filter (· ∈ P), ?_, ?_⟩
    · rw [Finset.coe_union, Finset.coe_filter]
      exact Set.union_subset hC₁P fun x hx ↦ hx.2
    · have hle : adjoin K (↑C₁ ∪ X) ≤ adjoin K (↑(C₁ ∪ T.filter (· ∈ P)) ∪ X) :=
        adjoin.mono _ _ _ (Set.union_subset_union_left _ (by simp))
      rw [Finset.coe_insert, Set.insert_subset_iff]
      refine ⟨adjoin.mono _ _ _ ?_ haT, hC₁.trans hle⟩
      intro x hx
      rcases hTPX hx with h | h
      · exact Or.inl (by simp [Finset.mem_coe.1 hx, h])
      · exact Or.inr h

/-- The range of an `K`-algebra map out of a field generated by `t` is the field generated by
the image of `t`. -/
lemma AlgHom.range_eq_adjoin_image {K L Ω : Type*} [Field K] [Field L] [Field Ω] [Algebra K L]
    [Algebra K Ω] (φ : L →ₐ[K] Ω) {t : Set L} (ht : adjoin K t = ⊤) :
    Set.range φ = adjoin K (φ '' t) := by
  rw [← AlgHom.coe_fieldRange, AlgHom.fieldRange_eq_map, ← ht, adjoin_map]

open Polynomial in
/-- Core of `exists_finiteDimensional_isPurelyInseparable_formallySmooth`, for a single
extension `L` of `K`, essentially of finite type, placed in `Ω = AlgebraicClosure L`. Let `P` be
the perfect closure of `K` in `Ω`. There are a finite `C ⊆ P` and a family `s` in `Ω`,
algebraically independent over `P` and lying in `K(C, L)`, such that every element `g` of a
given finite set `G ⊆ L` is a root of a separable polynomial with coefficients in `K(C, s)`. -/
theorem exists_finset_perfectClosure_separable (K L : Type u) [Field K] [Field L] [Algebra K L]
    [Algebra.EssFiniteType K L] (G : Finset L) :
    ∃ (C : Finset (AlgebraicClosure L)) (ι : Type u) (s : ι → AlgebraicClosure L),
      (C : Set (AlgebraicClosure L)) ⊆ perfectClosure K (AlgebraicClosure L) ∧
      AlgebraicIndependent (perfectClosure K (AlgebraicClosure L)) s ∧
      (∀ j, s j ∈ adjoin K
        ((C : Set (AlgebraicClosure L)) ∪ Set.range (algebraMap L (AlgebraicClosure L)))) ∧
      ∀ g ∈ G, ∃ f : Polynomial (AlgebraicClosure L), f.Separable ∧
        f.eval (algebraMap L (AlgebraicClosure L) g) = 0 ∧
        ∀ n, f.coeff n ∈ adjoin K ((C : Set (AlgebraicClosure L)) ∪ Set.range s) := by
  classical
  set Ω := AlgebraicClosure L
  set P := perfectClosure K Ω
  let φ : L →ₐ[K] Ω := IsScalarTower.toAlgHom K L Ω
  obtain ⟨t, ht⟩ := IntermediateField.fg_top K L
  have hφ : Set.range (algebraMap L Ω) = adjoin K (φ '' t) := φ.range_eq_adjoin_image ht
  let E : IntermediateField P Ω := adjoin P (Set.range (algebraMap L Ω))
  have hE : E = adjoin P (φ '' t) := by
    refine le_antisymm (adjoin_le_iff.2 fun x hx ↦ ?_) (adjoin.mono _ _ _ ?_)
    · rw [hφ] at hx
      have hle : adjoin K (φ '' t) ≤ (adjoin P (φ '' t)).restrictScalars K :=
        adjoin_le_iff.2 (subset_adjoin P _)
      exact hle hx
    · rintro _ ⟨x, -, rfl⟩
      exact ⟨x, rfl⟩
  have : Algebra.EssFiniteType P E := by
    rw [essFiniteType_iff, hE]
    exact fg_adjoin_of_finite ((t.finite_toSet).image _)
  obtain ⟨s, hs, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField P E
  let sΩ : s → Ω := fun j ↦ ((j : E) : Ω)
  have hsΩ : Set.range sΩ = E.val '' (s : Set E) := by
    ext x
    simp [sΩ]
  -- the minimal polynomials of the elements of `G`, mapped to `Ω`
  let A := adjoin P (s : Set E)
  let gE (g : L) : E := ⟨algebraMap L Ω g, subset_adjoin _ _ ⟨g, rfl⟩⟩
  let ρ : A →+* Ω := (algebraMap E Ω).comp (algebraMap A E)
  let f (g : L) : Polynomial Ω := (minpoly A (gE g)).map ρ
  have hfcoeff (g : L) (n : ℕ) : (f g).coeff n ∈ adjoin K ((P : Set Ω) ∪ Set.range sΩ) := by
    rw [← restrictScalars_adjoin, mem_restrictScalars, hsΩ, ← adjoin_map]
    exact ⟨_, ((minpoly A (gE g)).coeff n).2, by simp [f, ρ]⟩
  obtain ⟨C₁, hC₁P, hC₁⟩ := exists_finset_subset_and_subset_adjoin_union (K := K) (P : Set Ω)
    (Set.range (algebraMap L Ω)) (Finset.univ.image sΩ) (by
      rintro _ hx
      obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 hx
      rw [← restrictScalars_adjoin]
      exact (j : E).2)
  obtain ⟨C₂, hC₂P, hC₂⟩ := exists_finset_subset_and_subset_adjoin_union (K := K) (P : Set Ω)
    (Set.range sΩ) (G.biUnion fun g ↦ (f g).coeffs) (by
      intro x hx
      obtain ⟨g, -, hx⟩ := Finset.mem_biUnion.1 hx
      obtain ⟨n, -, rfl⟩ := Polynomial.mem_coeffs_iff.1 hx
      exact hfcoeff g n)
  refine ⟨C₁ ∪ C₂, s, sΩ, ?_, ?_, fun j ↦ ?_, fun g hg ↦ ⟨f g, ?_, ?_, fun n ↦ ?_⟩⟩
  · rw [Finset.coe_union]
    exact Set.union_subset hC₁P hC₂P
  · exact hs.1.map' (f := E.val) E.val.injective
  · refine adjoin.mono _ _ _ (Set.union_subset_union_left _ (by simp)) (hC₁ ?_)
    exact Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_univ j))
  · exact Polynomial.Separable.map (Algebra.IsSeparable.isSeparable A (gE g))
  · change Polynomial.eval (algebraMap E Ω (gE g)) ((minpoly A (gE g)).map ρ) = 0
    rw [Polynomial.eval_map, ← Polynomial.hom_eval₂]
    change algebraMap E Ω (Polynomial.aeval (gE g) (minpoly A (gE g))) = 0
    rw [minpoly.aeval, map_zero]
  · by_cases h0 : (f g).coeff n = 0
    · rw [h0]
      exact zero_mem _
    refine adjoin.mono _ _ _ (Set.union_subset_union_left _ (by simp)) (hC₂ ?_)
    exact Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨g, hg, Polynomial.coeff_mem_coeffs h0⟩)

/-- Let `L i` be finitely many field extensions of `K`, each essentially of finite type. There is a
finite purely inseparable extension `K'/K` such that every field generated by compatible images of
some `L i` and of `K'` is formally smooth over `K'`. -/
theorem exists_finiteDimensional_isPurelyInseparable_formallySmooth (K : Type u) [Field K]
    {ι : Type*} [Finite ι] (L : ι → Type u) [∀ i, Field (L i)] [∀ i, Algebra K (L i)]
    [∀ i, Algebra.EssFiniteType K (L i)] :
    ∃ (K' : Type u) (_ : Field K') (_ : Algebra K K'), FiniteDimensional K K' ∧
      IsPurelyInseparable K K' ∧
      ∀ (i : ι) (M : Type u) [Field M] (α : L i →+* M) (β : K' →+* M),
        α.comp (algebraMap K (L i)) = β.comp (algebraMap K K') →
        Subfield.closure (Set.range α ∪ Set.range β) = ⊤ →
        letI := β.toAlgebra; Algebra.FormallySmooth K' M := by
  classical
  have hG (i : ι) := IntermediateField.fg_top K (L i)
  choose G hG using hG
  have hcore (i : ι) := exists_finset_perfectClosure_separable K (L i) (G i)
  choose C ι' s hCP hs hsC hsep using hcore
  let q := ringExpChar K
  let Ω₀ := AlgebraicClosure K
  let φ (i : ι) : perfectClosure K (AlgebraicClosure (L i)) →ₐ[K] Ω₀ := IsAlgClosed.lift
  let S : Set Ω₀ := ⋃ i, φ i '' (Subtype.val ⁻¹' (C i : Set (AlgebraicClosure (L i))))
  have hSfin : S.Finite := Set.finite_iUnion fun i ↦
    (((C i).finite_toSet.preimage Subtype.val_injective.injOn).image _)
  -- elements of the perfect closure are `q ^ n`-th roots of elements of `K`
  have hpow (i : ι) (c : perfectClosure K (AlgebraicClosure (L i))) :
      ∃ n : ℕ, ∃ k : K, algebraMap K _ k = c ^ q ^ n :=
    (isPurelyInseparable_iff_pow_mem K q).1 inferInstance c
  have hSP : S ⊆ perfectClosure K Ω₀ := by
    intro x hx
    obtain ⟨i, c, -, rfl⟩ := Set.mem_iUnion.1 hx
    obtain ⟨n, k, hk⟩ := hpow i c
    exact ⟨n, k, by rw [← map_pow, ← hk, AlgHom.commutes]⟩
  set K' := adjoin K S
  have hfd : FiniteDimensional K K' := by
    have : Finite S := hSfin.to_subtype
    exact finiteDimensional_adjoin fun x _ ↦ Algebra.IsIntegral.isIntegral x
  have hpi : IsPurelyInseparable K K' := by
    rw [← le_perfectClosure_iff]
    exact adjoin_le_iff.2 hSP
  refine ⟨K', inferInstance, inferInstance, hfd, hpi, ?_⟩
  intro i M _ α β hαβ hgen
  let : Algebra K' M := β.toAlgebra
  set Ω := AlgebraicClosure (L i)
  set P := perfectClosure K Ω
  -- `M` is algebraic over `L i`, so it embeds into `Ω` over `L i`
  let : Algebra (L i) M := α.toAlgebra
  have hβint (x : K') : IsIntegral (L i) (β x) := by
    let : Algebra K M := (α.comp (algebraMap K (L i))).toAlgebra
    have : IsScalarTower K (L i) M := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
    let βK : K' →ₐ[K] M := { β with commutes' := fun k ↦ (congr($hαβ k)).symm }
    have : Algebra.IsIntegral K K' := Algebra.IsIntegral.of_finite K K'
    exact ((Algebra.IsIntegral.isIntegral (R := K) x).map βK).tower_top
  have : Algebra.IsAlgebraic (L i) M := by
    have hle : Subfield.closure (Set.range α ∪ Set.range β) ≤
        (algebraicClosure (L i) M).toSubfield := by
      rw [Subfield.closure_le]
      rintro _ (⟨x, rfl⟩ | ⟨x, rfl⟩)
      · exact mem_algebraicClosure_iff.2 (isAlgebraic_algebraMap x)
      · exact mem_algebraicClosure_iff.2 (hβint x).isAlgebraic
    rw [hgen] at hle
    exact ⟨fun x ↦ mem_algebraicClosure_iff.1 (hle (Subfield.mem_top x))⟩
  let θ : M →ₐ[L i] Ω := IsAlgClosed.lift
  have hθα (x : L i) : θ (α x) = algebraMap (L i) Ω x := θ.commutes x
  let ψ : K' →+* Ω := (θ : M →+* Ω).comp β
  have hψK (k : K) : ψ (algebraMap K K' k) = algebraMap K Ω k := by
    change θ (β (algebraMap K K' k)) = _
    rw [← RingHom.comp_apply β, ← hαβ, RingHom.comp_apply, hθα,
      ← IsScalarTower.algebraMap_apply]
  -- `ψ` is the identity on `C i`, by uniqueness of `q ^ n`-th roots
  have hψC (c : Ω) (hc : c ∈ C i) : ∃ x : K', ψ x = c := by
    have hcP : c ∈ P := hCP i hc
    let x : K' := ⟨φ i ⟨c, hcP⟩, subset_adjoin _ _ (Set.mem_iUnion.2 ⟨i, ⟨c, hcP⟩, hc, rfl⟩)⟩
    refine ⟨x, ?_⟩
    obtain ⟨n, k, hk⟩ := hpow i ⟨c, hcP⟩
    have hx : x ^ q ^ n = algebraMap K K' k :=
      Subtype.ext (by simp [x, ← map_pow, ← hk])
    refine eq_of_pow_expChar_pow_eq_of_ringHom (algebraMap K Ω) q n ?_
    rw [← map_pow, hx, hψK]
    exact congr(Subtype.val $hk)
  have hψP (x : K') : ψ x ∈ P := by
    obtain ⟨n, k, hk⟩ := (isPurelyInseparable_iff_pow_mem K q).1 hpi x
    exact ⟨n, k, by rw [← map_pow, ← hk, hψK]⟩
  -- the field `K(C i, L i)` lies in the image of `θ`
  have hrange : (adjoin K ((C i : Set Ω) ∪ Set.range (algebraMap (L i) Ω))).toSubfield ≤
      (θ : M →+* Ω).fieldRange := by
    rw [adjoin_toSubfield, Subfield.closure_le]
    rintro _ (⟨k, rfl⟩ | hc | ⟨x, rfl⟩)
    · exact ⟨β (algebraMap K K' k), hψK k⟩
    · obtain ⟨x, hx⟩ := hψC _ hc
      exact ⟨β x, hx⟩
    · exact ⟨α x, hθα x⟩
  choose v hv using fun j ↦ RingHom.mem_fieldRange.1 (hrange (hsC i j))
  -- `v` is algebraically independent over `K'`
  have hvind : AlgebraicIndependent K' v := by
    let : Algebra K' Ω := ψ.toAlgebra
    let ψP : K' →+* P := ψ.codRestrict P hψP
    let : Algebra K' P := ψP.toAlgebra
    have : IsScalarTower K' P Ω := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
    have h1 : AlgebraicIndependent K' (s i) := (hs i).restrictScalars ψP.injective
    let θK' : M →ₐ[K'] Ω := { (θ : M →+* Ω) with commutes' := fun _ ↦ rfl }
    have h2 : AlgebraicIndependent K' (θK' ∘ v) := by
      convert h1 using 1
      exact funext hv
    exact h2.of_comp θK'
  -- `M` is generated over `K'` by the image of `G i`
  have hT : adjoin K' (α '' (G i : Set (L i))) = ⊤ := by
    have hα : (⊤ : IntermediateField K (L i)).toSubfield ≤
        (adjoin K' (α '' (G i : Set (L i)))).toSubfield.comap α := by
      rw [← hG i, adjoin_toSubfield, Subfield.closure_le]
      rintro _ (⟨k, rfl⟩ | hg)
      · change α (algebraMap K (L i) k) ∈ adjoin K' _
        rw [← RingHom.comp_apply, hαβ]
        exact IntermediateField.algebraMap_mem _ _
      · exact subset_adjoin _ _ ⟨_, hg, rfl⟩
    have hle : Subfield.closure (Set.range α ∪ Set.range β) ≤
        (adjoin K' (α '' (G i : Set (L i)))).toSubfield := by
      rw [Subfield.closure_le]
      rintro _ (⟨x, rfl⟩ | ⟨x, rfl⟩)
      · exact hα (Subfield.mem_top x)
      · exact IntermediateField.algebraMap_mem _ x
    rw [hgen] at hle
    exact _root_.eq_top_iff.2 fun x _ ↦ hle (Subfield.mem_top x)
  refine Algebra.FormallySmooth.of_algebraicIndependent_of_separable_map (θ : M →+* Ω) hvind
    _ hT ?_
  rintro _ ⟨g, hg, rfl⟩
  obtain ⟨f, hf, hfg, hcoeff⟩ := hsep i g hg
  refine ⟨f, hf, by rwa [RingHom.coe_coe, hθα], fun n ↦ ?_⟩
  have hle : (adjoin K ((C i : Set Ω) ∪ Set.range (s i))).toSubfield ≤
      (adjoin K' (Set.range v)).toSubfield.map (θ : M →+* Ω) := by
    rw [adjoin_toSubfield, Subfield.closure_le]
    rintro _ (⟨k, rfl⟩ | hc | ⟨j, rfl⟩)
    · exact ⟨β (algebraMap K K' k), IntermediateField.algebraMap_mem _ _, hψK k⟩
    · obtain ⟨x, hx⟩ := hψC _ hc
      exact ⟨β x, IntermediateField.algebraMap_mem _ x, hx⟩
    · exact ⟨v j, subset_adjoin _ _ ⟨j, rfl⟩, hv j⟩
  exact hle (hcoeff n)
