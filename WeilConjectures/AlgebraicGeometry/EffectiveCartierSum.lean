module

public import WeilConjectures.AlgebraicGeometry.FiniteOverField
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible
public import WeilConjectures.Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Sums of effective Cartier divisors

The unit ideal sheaf is invertible
(`AlgebraicGeometry.Scheme.IdealSheafData.isInvertible_top`), and the product of two invertible
ideal sheaves is invertible (`AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.mul`): it
cuts out the sum of the two effective Cartier divisors. Over a field, the degree
`dim_K Γ(D, 𝒪_D)` of finite effective Cartier divisors is additive
(`AlgebraicGeometry.Scheme.IdealSheafData.finrankΓ_subschemeι_mul_comp`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- If an ideal sheaf is generated by a non-zerodivisor on an affine open `U`, then also on every
affine open `V ⊆ U`: restriction between affine opens is flat. -/
lemma isRegularPrincipal_ideal_of_le (I : X.IdealSheafData) {U V : X.affineOpens} (h : V ≤ U)
    (hU : (I.ideal U).IsRegularPrincipal) : (I.ideal V).IsRegularPrincipal := by
  rw [← I.map_ideal h]
  exact hU.map_of_flat (Scheme.Hom.flat_appLE (𝟙 X) U.2 V.2 h)

/-- Two invertible ideal sheaves are simultaneously generated by non-zerodivisors on arbitrarily
small affine neighbourhoods of any point. -/
lemma exists_affineOpens_isRegularPrincipal {I J : X.IdealSheafData} (hI : I.IsInvertible)
    (hJ : J.IsInvertible) {x : X} {O : X.Opens} (hxO : x ∈ O) :
    ∃ W : X.affineOpens, x ∈ W.1 ∧ W.1 ≤ O ∧ (I.ideal W).IsRegularPrincipal ∧
      (J.ideal W).IsRegularPrincipal := by
  obtain ⟨U₁, hxU₁, h₁⟩ := hI x
  obtain ⟨U₂, hxU₂, h₂⟩ := hJ x
  obtain ⟨W, hW, hxW, hWle⟩ := exists_isAffineOpen_mem_and_subset (U := U₁.1 ⊓ U₂.1 ⊓ O)
    (x := x) ⟨⟨hxU₁, hxU₂⟩, hxO⟩
  exact ⟨⟨W, hW⟩, hxW, hWle.trans inf_le_right,
    I.isRegularPrincipal_ideal_of_le (U := U₁) (V := ⟨W, hW⟩)
      (hWle.trans (inf_le_left.trans inf_le_left)) h₁,
    J.isRegularPrincipal_ideal_of_le (U := U₂) (V := ⟨W, hW⟩)
      (hWle.trans (inf_le_left.trans inf_le_right)) h₂⟩

/-- **The empty effective Cartier divisor.** The unit ideal sheaf `⊤` is invertible: it is
generated by `1` on every affine open. -/
lemma isInvertible_top : (⊤ : X.IdealSheafData).IsInvertible := fun x ↦ by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
  refine ⟨⟨U, hU⟩, hxU, 1, one_mem _, ?_⟩
  rw [Ideal.span_singleton_one]
  rfl

/-- **Sums of effective Cartier divisors.** The product of two invertible ideal sheaves is
invertible: locally it is generated by the product of the two local generators. -/
lemma IsInvertible.mul {I J : X.IdealSheafData} (hI : I.IsInvertible) (hJ : J.IsInvertible) :
    (I * J).IsInvertible := by
  intro x
  obtain ⟨W, hxW, -, ⟨a, ha, haI⟩, ⟨b, hb, hbJ⟩⟩ :=
    exists_affineOpens_isRegularPrincipal hI hJ (O := ⊤) trivial
  refine ⟨W, hxW, a * b, mul_mem ha hb, ?_⟩
  rw [ideal_mul, Pi.mul_apply, haI, hbJ, Ideal.span_singleton_mul_span_singleton]

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry

section SectionsDecomposition

variable {K : Type u} [Field K] {Z : Scheme.{u}} (q : Z ⟶ Spec (.of K))

/-- For disjoint opens `O₁, O₂` of a scheme `Z` over a field `K`, restriction identifies the
`K`-algebra `Γ(Z, O₁ ⊔ O₂)` with `Γ(Z, O₁) × Γ(Z, O₂)`; in particular the dimensions add up. -/
lemma finite_and_finrank_sections_sup_of_inf_eq_bot (O₁ O₂ : Z.Opens) (h : O₁ ⊓ O₂ = ⊥)
    (hfin : letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ (O₁ ⊔ O₂) le_top).hom.toAlgebra;
      Module.Finite K Γ(Z, O₁ ⊔ O₂)) :
    (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ O₁ le_top).hom.toAlgebra;
      Module.Finite K Γ(Z, O₁)) ∧
    (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ O₂ le_top).hom.toAlgebra;
      Module.Finite K Γ(Z, O₂)) ∧
    (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ (O₁ ⊔ O₂) le_top).hom.toAlgebra;
      Module.finrank K Γ(Z, O₁ ⊔ O₂)) =
      (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ O₁ le_top).hom.toAlgebra;
        Module.finrank K Γ(Z, O₁)) +
      (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ O₂ le_top).hom.toAlgebra;
        Module.finrank K Γ(Z, O₂)) := by
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ (O₁ ⊔ O₂) le_top).hom.toAlgebra
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ O₁ le_top).hom.toAlgebra
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ O₂ le_top).hom.toAlgebra
  let c := Z.sheaf.isProductOfDisjoint O₁ O₂ h
  let e := c.conePointUniqueUpToIso (CommRingCat.prodFanIsLimit Γ(Z, O₁) Γ(Z, O₂))
  have hbij : Function.Bijective (RingHom.prod
      (Z.presheaf.map (homOfLE (le_sup_left : O₁ ≤ O₁ ⊔ O₂)).op).hom
      (Z.presheaf.map (homOfLE (le_sup_right : O₂ ≤ O₁ ⊔ O₂)).op).hom) :=
    ConcreteCategory.bijective_of_isIso e.hom
  let r₁ : Γ(Z, O₁ ⊔ O₂) →ₐ[K] Γ(Z, O₁) :=
    { (Z.presheaf.map (homOfLE (le_sup_left : O₁ ≤ O₁ ⊔ O₂)).op).hom with
      commutes' := fun k ↦ by
        change (Z.presheaf.map _).hom (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ _ _).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ _ _).hom k
        rw [← CommRingCat.comp_apply, Category.assoc, Scheme.Hom.appLE_map] }
  let r₂ : Γ(Z, O₁ ⊔ O₂) →ₐ[K] Γ(Z, O₂) :=
    { (Z.presheaf.map (homOfLE (le_sup_right : O₂ ≤ O₁ ⊔ O₂)).op).hom with
      commutes' := fun k ↦ by
        change (Z.presheaf.map _).hom (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ _ _).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ _ _).hom k
        rw [← CommRingCat.comp_apply, Category.assoc, Scheme.Hom.appLE_map] }
  let E : Γ(Z, O₁ ⊔ O₂) ≃ₐ[K] Γ(Z, O₁) × Γ(Z, O₂) := AlgEquiv.ofBijective (r₁.prod r₂) hbij
  have h₁ : Module.Finite K Γ(Z, O₁) :=
    Module.Finite.of_surjective (LinearMap.fst _ _ _ ∘ₗ E.toLinearEquiv.toLinearMap)
      (Prod.fst_surjective.comp E.surjective)
  have h₂ : Module.Finite K Γ(Z, O₂) :=
    Module.Finite.of_surjective (LinearMap.snd _ _ _ ∘ₗ E.toLinearEquiv.toLinearMap)
      (Prod.snd_surjective.comp E.surjective)
  exact ⟨h₁, h₂, by rw [E.toLinearEquiv.finrank_eq, Module.finrank_prod]⟩

/-- For finitely many pairwise disjoint opens `O i` of a scheme `Z` over a field `K`, the
dimension of the `K`-algebra of sections over their union is the sum of the dimensions of the
sections over the `O i`. -/
lemma finite_and_finrank_sections_iSup {ι : Type*} (O : ι → Z.Opens)
    (s : Finset ι) (hs : (s : Set ι).PairwiseDisjoint O) (U : Z.Opens) (hU : ⨆ i ∈ s, O i = U)
    (hfin : letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ U le_top).hom.toAlgebra;
      Module.Finite K Γ(Z, U)) :
    (∀ i ∈ s, letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ (O i) le_top).hom.toAlgebra;
      Module.Finite K Γ(Z, O i)) ∧
    (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ U le_top).hom.toAlgebra;
      Module.finrank K Γ(Z, U)) =
      ∑ i ∈ s, (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ (O i) le_top).hom.toAlgebra;
        Module.finrank K Γ(Z, O i)) := by
  classical
  induction s using Finset.induction_on generalizing U with
  | empty =>
    simp only [Finset.notMem_empty, iSup_false, iSup_bot] at hU
    subst hU
    let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ ⊥ le_top).hom.toAlgebra
    exact ⟨by simp, by simp [Module.finrank_zero_of_subsingleton]⟩
  | insert a s ha ih =>
    rw [Finset.iSup_insert] at hU
    subst hU
    have hdisj : O a ⊓ ⨆ i ∈ s, O i = ⊥ := by
      rw [← disjoint_iff, disjoint_iSup₂_iff]
      intro i hi
      exact hs (Finset.mem_insert_self a s) (Finset.mem_insert_of_mem hi)
        (fun h ↦ ha (h ▸ hi))
    obtain ⟨h₁, h₂, hrank⟩ := finite_and_finrank_sections_sup_of_inf_eq_bot q _ _ hdisj hfin
    obtain ⟨ih₁, ih₂⟩ := ih (hs.subset (by simp)) _ rfl h₂
    refine ⟨fun i hi ↦ ?_, ?_⟩
    · rcases Finset.mem_insert.mp hi with rfl | hi
      · exact h₁
      · exact ih₁ i hi
    · rw [hrank, ih₂, Finset.sum_insert ha]

end SectionsDecomposition

end AlgebraicGeometry

namespace AlgebraicGeometry

section SectionsDecomposition

variable {K : Type u} [Field K]

/-- For an affine open `W` of a scheme `Y` over a field `K` and an ideal sheaf `I`, the
`K`-algebra of sections of `V(I)` over the preimage of `W` is `Γ(Y, W) ⧸ I(W)`. -/
lemma Scheme.IdealSheafData.nonempty_algEquiv_sections_preimage {Y : Scheme.{u}}
    (q : Y ⟶ Spec (.of K)) (I : Y.IdealSheafData) (W : Y.affineOpens) :
    letI := ((Scheme.ΓSpecIso (.of K)).inv ≫
      (I.subschemeι ≫ q).appLE ⊤ (I.subschemeι ⁻¹ᵁ W.1) le_top).hom.toAlgebra
    letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ W.1 le_top).hom.toAlgebra
    Nonempty (Γ(I.subscheme, I.subschemeι ⁻¹ᵁ W.1) ≃ₐ[K] Γ(Y, W.1) ⧸ I.ideal W) := by
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫
    (I.subschemeι ≫ q).appLE ⊤ (I.subschemeι ⁻¹ᵁ W.1) le_top).hom.toAlgebra
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ W.1 le_top).hom.toAlgebra
  have key : (I.subschemeι ≫ q).appLE ⊤ (I.subschemeι ⁻¹ᵁ W.1) le_top =
      q.appLE ⊤ W.1 le_top ≫ CommRingCat.ofHom (Ideal.Quotient.mk (I.ideal W)) ≫
        (I.subschemeObjIso W).inv := by
    rw [← subschemeι_app, ← Scheme.Hom.appLE_eq_app, Scheme.Hom.appLE_comp_appLE]
  refine ⟨AlgEquiv.ofRingEquiv (f := (I.subschemeObjIso W).commRingCatIsoToRingEquiv) ?_⟩
  intro k
  change (I.subschemeObjIso W).hom (((Scheme.ΓSpecIso (.of K)).inv ≫
    (I.subschemeι ≫ q).appLE ⊤ (I.subschemeι ⁻¹ᵁ W.1) le_top) k) =
      Ideal.Quotient.mk _ (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ W.1 le_top) k)
  rw [key]
  simp

end SectionsDecomposition

end AlgebraicGeometry

namespace AlgebraicGeometry

section FieldCase

variable {K : Type u} [Field K]

/-- `Scheme.Hom.finrankΓ` computed with the algebra structure given by `appLE ⊤ ⊤`. -/
lemma Scheme.Hom.finrankΓ_eq_finrank_appLE {Z : Scheme.{u}} {R : CommRingCat.{u}}
    (g : Z ⟶ Spec R) : g.finrankΓ =
      letI := ((Scheme.ΓSpecIso R).inv ≫ g.appLE ⊤ ⊤ le_top).hom.toAlgebra
      Module.finrank R Γ(Z, ⊤) := by
  rw [Scheme.Hom.appLE_top_top]
  rfl

/-- **Additivity of the degree over a field.** Let `Y` be a scheme over a field `K` and let
`I, J` be invertible ideal sheaves on `Y` whose closed subschemes, and that of `I * J`, are finite
over `K`. Then `dim_K Γ(V(I * J)) = dim_K Γ(V(I)) + dim_K Γ(V(J))`.

The finitely many points of `V(I * J)` are closed and have affine neighbourhoods `W` which contain
no other such point and on which `I = (a)`, `J = (b)` are principal; over `W` the three
subschemes are `Γ(Y, W) ⧸ (a b)`, `Γ(Y, W) ⧸ (a)` and `Γ(Y, W) ⧸ (b)`, and the dimensions add up
by `Ideal.Quotient.finrank_span_singleton_mul`. -/
lemma Scheme.IdealSheafData.finrankΓ_subschemeι_mul_comp {Y : Scheme.{u}}
    (q : Y ⟶ Spec (.of K)) {I J : Y.IdealSheafData} (hI : I.IsInvertible) (hJ : J.IsInvertible)
    [IsFinite (I.subschemeι ≫ q)] [IsFinite (J.subschemeι ≫ q)]
    [IsFinite ((I * J).subschemeι ≫ q)] :
    ((I * J).subschemeι ≫ q).finrankΓ =
      (I.subschemeι ≫ q).finrankΓ + (J.subschemeι ≫ q).finrankΓ := by
  classical
  obtain ⟨hZfin, hZdisc⟩ := finite_and_discreteTopology_of_isFinite ((I * J).subschemeι ≫ q)
  have : Fintype (I * J).subscheme := Fintype.ofFinite _
  -- the finitely many points of `V(I * J)`, which are closed in `Y`
  set F : Finset Y := Finset.univ.image (I * J).subschemeι
  have hF : (F : Set Y) = ((I * J).support : Set Y) := by
    rw [← range_subschemeι]
    ext y
    simp [F]
  have hFclosed (y : Y) : IsClosed ((F : Set Y) \ {y}) := by
    have e : (F : Set Y) \ {y} = ⋃ z ∈ ((F.erase y : Finset Y) : Set Y), {z} := by
      ext z
      simp [and_comm]
    rw [e]
    refine Set.Finite.isClosed_biUnion (Finset.finite_toSet _) fun z hz ↦ ?_
    obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz)
    rw [← Set.image_singleton]
    exact (I * J).subschemeι.isClosedEmbedding.isClosedMap _ (isClosed_discrete _)
  have hW (y : Y) (hy : y ∈ F) : ∃ W : Y.affineOpens, y ∈ W.1 ∧
      W.1 ≤ ⟨((F : Set Y) \ {y})ᶜ, (hFclosed y).isOpen_compl⟩ ∧
      (I.ideal W).IsRegularPrincipal ∧ (J.ideal W).IsRegularPrincipal :=
    exists_affineOpens_isRegularPrincipal hI hJ (by simp)
  have : Nonempty Y.affineOpens := ⟨⟨⊥, isAffineOpen_bot Y⟩⟩
  choose! W hyW hWF hWI hWJ using hW
  -- for an ideal sheaf `L` supported in `V(I * J)` the preimages of the `W y` decompose `V(L)`
  have hdecomp (L : Y.IdealSheafData) (hL : (L.support : Set Y) ⊆ (F : Set Y)) :
      ((F : Set Y).PairwiseDisjoint fun y ↦ L.subschemeι ⁻¹ᵁ (W y).1) ∧
        ⨆ y ∈ F, L.subschemeι ⁻¹ᵁ (W y).1 = ⊤ := by
    have hmem (x : L.subscheme) (y : Y) (hy : y ∈ F) (hx : L.subschemeι x ∈ (W y).1) :
        L.subschemeι x = y := by
      have hxF : L.subschemeι x ∈ (F : Set Y) := hL (by rw [← range_subschemeι]; exact ⟨x, rfl⟩)
      by_contra hne
      exact hWF y hy hx ⟨hxF, hne⟩
    refine ⟨fun y hy y' hy' hne ↦ ?_, ?_⟩
    · rw [Function.onFun, disjoint_iff, eq_bot_iff]
      rintro x ⟨hx, hx'⟩
      exact hne ((hmem x y hy hx).symm.trans (hmem x y' hy' hx'))
    · rw [eq_top_iff]
      rintro x -
      have hxF : L.subschemeι x ∈ F := hL (by rw [← range_subschemeι]; exact ⟨x, rfl⟩)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨L.subschemeι x,
        TopologicalSpace.Opens.mem_iSup.mpr ⟨hxF, hyW _ hxF⟩⟩
  have hsupp (L : Y.IdealSheafData) (hL : L.support ≤ (I * J).support) :
      (L.support : Set Y) ⊆ (F : Set Y) := by
    rw [hF]
    exact hL
  obtain ⟨hfIJ, hrIJ⟩ := finite_and_finrank_sections_iSup ((I * J).subschemeι ≫ q)
    (fun y ↦ (I * J).subschemeι ⁻¹ᵁ (W y).1) F (hdecomp _ (hsupp _ le_rfl)).1 ⊤
    (hdecomp _ (hsupp _ le_rfl)).2 (finite_sections_top_of_isFinite _)
  obtain ⟨hfI, hrI⟩ := finite_and_finrank_sections_iSup (I.subschemeι ≫ q)
    (fun y ↦ I.subschemeι ⁻¹ᵁ (W y).1) F (hdecomp _ (hsupp _ (by simp))).1 ⊤
    (hdecomp _ (hsupp _ (by simp))).2 (finite_sections_top_of_isFinite _)
  obtain ⟨hfJ, hrJ⟩ := finite_and_finrank_sections_iSup (J.subschemeι ≫ q)
    (fun y ↦ J.subschemeι ⁻¹ᵁ (W y).1) F (hdecomp _ (hsupp _ (by simp))).1 ⊤
    (hdecomp _ (hsupp _ (by simp))).2 (finite_sections_top_of_isFinite _)
  simp only [Scheme.Hom.finrankΓ_eq_finrank_appLE]
  rw [hrIJ, hrI, hrJ, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun y hy ↦ ?_
  obtain ⟨a, ha, haI⟩ := hWI y hy
  obtain ⟨b, hb, hbJ⟩ := hWJ y hy
  obtain ⟨eIJ⟩ := nonempty_algEquiv_sections_preimage q (I * J) (W y)
  obtain ⟨eI⟩ := nonempty_algEquiv_sections_preimage q I (W y)
  obtain ⟨eJ⟩ := nonempty_algEquiv_sections_preimage q J (W y)
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appLE ⊤ (W y).1 le_top).hom.toAlgebra
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ ((I * J).subschemeι ≫ q).appLE ⊤
    ((I * J).subschemeι ⁻¹ᵁ (W y).1) le_top).hom.toAlgebra
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ (I.subschemeι ≫ q).appLE ⊤
    (I.subschemeι ⁻¹ᵁ (W y).1) le_top).hom.toAlgebra
  let _ := ((Scheme.ΓSpecIso (.of K)).inv ≫ (J.subschemeι ≫ q).appLE ⊤
    (J.subschemeι ⁻¹ᵁ (W y).1) le_top).hom.toAlgebra
  have := hfI y hy
  have := hfJ y hy
  have : Module.Finite K (Γ(Y, (W y).1) ⧸ Ideal.span {a}) := by
    rw [← haI]
    exact Module.Finite.equiv eI.toLinearEquiv
  have : Module.Finite K (Γ(Y, (W y).1) ⧸ Ideal.span {b}) := by
    rw [← hbJ]
    exact Module.Finite.equiv eJ.toLinearEquiv
  rw [eIJ.toLinearEquiv.finrank_eq, eI.toLinearEquiv.finrank_eq, eJ.toLinearEquiv.finrank_eq,
    ideal_mul, Pi.mul_apply, haI, hbJ, Ideal.span_singleton_mul_span_singleton]
  exact (Ideal.Quotient.finrank_span_singleton_mul a b ha).2

end FieldCase

end AlgebraicGeometry
