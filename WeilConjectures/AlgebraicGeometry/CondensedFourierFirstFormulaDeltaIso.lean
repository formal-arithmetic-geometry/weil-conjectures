module

public import WeilConjectures.AlgebraicGeometry.CondensedFourierTransform
public import WeilConjectures.CategoryTheory.RingObjects.Condensed.ContinuousMapGlobalSections
public import Mathlib.FieldTheory.IsAlgClosed.Basic

/-! # One calculation in the first Fourier formulas

Source: current blueprint, lem-fd-first-formula.proof.md.
-/

@[expose] public noncomputable section
set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale

/-- The origin-skyscraper Fourier comparisons for both coefficient models.

Source: current blueprint, first-formula proof, skyscraper paragraph
(blueprint: lem-fd-first-formula-delta-iso).

Proof in words. Over k₀, pull the origin closed direct image back along the first
projection. Compact-support base change identifies it with the closed direct image of the
unit on the zero-coordinate line in the product. The support projection formula restricts
the Fourier kernel to that line. The pairing is zero there, so pullback composition and the
normalized Artin-Schreier unit trivialization identify the restriction with the coefficient
unit. The second projection restricted to the support is the identity. Exactness of closed
direct image, compact-support composition, compactification independence, and the identity
law therefore identify the compact-support direct image of the integrand with the unit.
The Fourier normalization shifts this object by one. Pull the isomorphism from k₀ to k by
compact-support exchange for arbitrary base maps, and identify coefficients by cartesian
pullback. Extend to the finite-subextension algebraic closure with the scalar comparisons;
these identify the character summand of the torsor pushforward and commute with closed and
compact-support direct image. This supplies both displayed comparisons. -/
theorem first_formula_delta_iso
    (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hpℓ : p ≠ ℓ)
    (k₀ : Type u) [Field k₀] [Fintype k₀] [CharP k₀ p]
    (E : PadicAlgCl.FiniteIntermediateField ℓ)
    (hμ : ∀ ζ : rootsOfUnity p (PadicAlgCl ℓ), ((ζ : (PadicAlgCl ℓ)ˣ) : PadicAlgCl ℓ) ∈ E.1)
    (ψ : AddChar k₀ E) (hψ : ψ ≠ 1)
    (k : Type u) [Field k] [Algebra k₀ k] (hk : Finite k ∨ IsAlgClosed k)
    (c : Compactification (pullback.snd
      (AffineSpace PUnit (Spec (.of k)) ↘ Spec (.of k))
      (AffineSpace PUnit (Spec (.of k)) ↘ Spec (.of k)))) :
  Nonempty ((condensedFieldFourierTransform (Profinite.continuousMapRingObj E.1) k₀ k
        ((Profinite.continuousMapConstRingHom E).toMonoidHom.compAddChar ψ) c).obj
        ((CondensedRing.lowerStar (Profinite.continuousMapRingObj E.1)
      (AffineSpace.zeroSection PUnit (Spec (.of k)))).rightDerivedFunctor.obj
        ((DerivedCategory.singleFunctor _ 0).obj
          (Mod.regular (condensedRingObj (Profinite.continuousMapRingObj E.1) (Spec (.of k)))))) ≅
    (shiftFunctor _ (1 : ℤ)).obj
      ((DerivedCategory.singleFunctor _ 0).obj
      (Mod.regular (condensedRingObj (Profinite.continuousMapRingObj E.1) (AffineSpace PUnit
        (Spec (.of k))))))) ∧
  Nonempty ((condensedFieldFourierTransform (Profinite.padicAlgClRingObj ℓ) k₀ k
        ((Profinite.PadicAlgCl.constRingHom ℓ).toMonoidHom.compAddChar
        (E.1.subtype.toMonoidHom.compAddChar ψ)) c).obj ((CondensedRing.lowerStar
        (Profinite.padicAlgClRingObj ℓ)
      (AffineSpace.zeroSection PUnit (Spec (.of k)))).rightDerivedFunctor.obj
        ((DerivedCategory.singleFunctor _ 0).obj
          (Mod.regular (condensedRingObj (Profinite.padicAlgClRingObj ℓ) (Spec (.of k)))))) ≅
    (shiftFunctor _ (1 : ℤ)).obj
      ((DerivedCategory.singleFunctor _ 0).obj
      (Mod.regular (condensedRingObj (Profinite.padicAlgClRingObj ℓ) (AffineSpace PUnit (Spec
        (.of k))))))) := by
  sorry

end AlgebraicGeometry.ProEtale
