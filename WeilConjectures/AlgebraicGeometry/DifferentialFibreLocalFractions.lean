module

public import WeilConjectures.AlgebraicGeometry.ConormalSequenceSmoothImmersion
public import Mathlib.Algebra.MvPolynomial.CommRing

import all WeilConjectures.AlgebraicGeometry.ConormalSequenceSmoothImmersion

/-! # Differential fibres generated by local polynomial fractions

Source: Stacks Project, Algebra, Tags 00RM and 00RT; Constructions, Tag 01UM.
-/

@[expose] public section

set_option autoImplicit false

universe u v

open CategoryTheory
open scoped TensorProduct

namespace AlgebraicGeometry.Scheme.Hom

private theorem span_tensor_differentials_of_fractions
    {k R K I : Type*} [CommRing k] [CommRing R] [CommRing K]
    [Algebra k R] [Algebra R K] (c : I → R)
    (hfrac : ∀ t : R, ∃ p q : MvPolynomial I k,
      IsUnit (MvPolynomial.aeval c q) ∧
      t * MvPolynomial.aeval c q = MvPolynomial.aeval c p) :
    Submodule.span K (Set.range fun j ↦
      (1 : K) ⊗ₜ[R] KaehlerDifferential.D k R (c j)) = ⊤ := by
  let P := Submodule.span K (Set.range fun j ↦
    (1 : K) ⊗ₜ[R] KaehlerDifferential.D k R (c j))
  let D := KaehlerDifferential.D k R
  let δ := TensorProduct.mk R K (KaehlerDifferential k R) (1 : K)
  have hmul (a b : R) : δ (D (a * b)) = a • δ (D b) + b • δ (D a) := by
    rw [Derivation.leibniz, map_add, map_smul, map_smul]
  have hc (j : I) : δ (D (c j)) ∈ P :=
    Submodule.subset_span (Set.mem_range_self j)
  have hpoly (p : MvPolynomial I k) : δ (D (MvPolynomial.aeval c p)) ∈ P := by
    induction p using MvPolynomial.induction_on with
    | C a => simp [D, Derivation.map_algebraMap]
    | add p q hp hq => simpa only [map_add] using P.add_mem hp hq
    | mul_X p j hp =>
      rw [map_mul, MvPolynomial.aeval_X, hmul]
      exact P.add_mem ((P.restrictScalars R).smul_mem _ (hc j))
        ((P.restrictScalars R).smul_mem _ hp)
  have hD (a : R) : δ (D a) ∈ P := by
    obtain ⟨p, q, hq, hpq⟩ := hfrac a
    have he : MvPolynomial.aeval c q • δ (D a) =
        δ (D (MvPolynomial.aeval c p)) - a • δ (D (MvPolynomial.aeval c q)) := by
      have h := congrArg (fun t ↦ δ (D t)) hpq
      rw [hmul] at h
      exact eq_sub_of_add_eq (by simpa only [add_comm] using h)
    have hm : MvPolynomial.aeval c q • δ (D a) ∈ P := by
      rw [he]
      exact P.sub_mem (hpoly p) ((P.restrictScalars R).smul_mem _ (hpoly q))
    obtain ⟨v, hv⟩ := hq
    rw [← hv] at hm
    have h := (P.restrictScalars R).smul_mem (↑v⁻¹ : R) hm
    change (↑v⁻¹ : R) • ((v : R) • δ (D a)) ∈ P at h
    simpa only [smul_smul, Units.inv_mul, one_smul] using h
  have hall (m : KaehlerDifferential k R) : δ m ∈ P := by
    have hm : m ∈ Submodule.span R (Set.range D) :=
      KaehlerDifferential.span_range_derivation k R ▸ Submodule.mem_top
    induction hm using Submodule.span_induction with
    | mem m hm => obtain ⟨a, rfl⟩ := hm; exact hD a
    | zero => simpa only [map_zero] using P.zero_mem
    | add a b ha hb ha' hb' => simpa only [map_add] using P.add_mem ha' hb'
    | smul a b hb hb' =>
      rw [map_smul]
      exact (P.restrictScalars R).smul_mem a hb'
  suffices h : ∀ t : K ⊗[R] KaehlerDifferential k R, t ∈ P by
    exact top_unique (fun t _ ↦ h t)
  intro t
  induction t using TensorProduct.induction_on with
  | zero => exact P.zero_mem
  | tmul a m =>
    simpa only [δ, TensorProduct.mk_apply, TensorProduct.smul_tmul', smul_eq_mul,
      mul_one] using P.smul_mem a (hall m)
  | add a b ha hb => exact P.add_mem ha hb

/-- Local polynomial-fraction generators give generators of the actual differential fibre.
No smoothness, rationality of the point, or immersion is assumed.

Source: Stacks Project, Algebra, Tags 00RM and 00RT, generation of Kahler differentials
and their localization; Constructions, Tag 01UM, the universal differential sheaf.
(blueprint: lem-zl-differential-fibre-local-fractions).

Proof: Let R = O_(X,x) and K = kappa(x). The differential sheaf stalk is the module
of k-relative Kahler differentials of R. This identification follows by restricting
the universal derivation to an affine neighbourhood, then localizing, and it sends
the differential germ of a_j to D(c_j), where c_j is its function germ.
The images of all D(a), a in R, generate K tensor_R Omega_(R/k). Let P be the
K-span of the D(c_j) in this tensor product. The derivation of a constant is zero.
Induction on polynomials, using addition and Leibniz, shows that D(p(c)) lies in P.
For a fraction relation a*q(c)=p(c), differentiation gives
q(c) D(a) = D(p(c)) - a D(q(c)). The residue of q(c) is invertible because q(c)
is a unit of R. Multiplication by its inverse gives D(a) in P. Thus P is the
whole fibre. The argument works for an empty coordinate set (then all differentials
vanish), and makes no assertion that the residue field equals k. -/
theorem span_differentialFibreGerm_of_localFractions
    {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (x : X) (W : X.Opens) (hx : x ∈ W) {I : Type v} (a : I → Γ(X, W))
    (hfrac : let ρ : k →+* X.presheaf.stalk x :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial).hom
      let c : I → X.presheaf.stalk x := fun j ↦ X.presheaf.germ W x hx (a j)
      ∀ t : X.presheaf.stalk x, ∃ p q : MvPolynomial I k,
        IsUnit (MvPolynomial.eval₂Hom ρ c q) ∧
        t * MvPolynomial.eval₂Hom ρ c q = MvPolynomial.eval₂Hom ρ c p) :
    Submodule.span (X.residueField x) (Set.range fun j ↦
      relativeDifferentialsStalkFibreGerm f (𝟙 X) x W hx (a j)) = ⊤ := by
  let ρ := fieldStalkMap f x
  let : Algebra k (X.presheaf.stalk x) := ρ.toAlgebra
  let : Algebra (X.presheaf.stalk x) (X.residueField x) :=
    (selfStalkResidueMap X x).toAlgebra
  let E := fieldDifferentialsSelfFibreEquiv f x
  have hE (j : I) : E (relativeDifferentialsStalkFibreGerm f (𝟙 X) x W hx (a j)) =
      1 ⊗ₜ[X.presheaf.stalk x]
        KaehlerDifferential.D k (X.presheaf.stalk x) (X.presheaf.germ W x hx (a j)) :=
    fieldDifferentialsSelfFibreEquiv_germ f x W hx (a j)
  let c : I → X.presheaf.stalk x := fun j ↦ X.presheaf.germ W x hx (a j)
  have hs := span_tensor_differentials_of_fractions
    (K := X.residueField x) c hfrac
  have heq : Submodule.map E.toLinearMap
      (Submodule.span (X.residueField x) (Set.range fun j ↦
        relativeDifferentialsStalkFibreGerm f (𝟙 X) x W hx (a j))) = ⊤ := by
    rw [Submodule.map_span, ← Set.range_comp]
    have hfun : E.toLinearMap ∘ (fun j ↦
        relativeDifferentialsStalkFibreGerm f (𝟙 X) x W hx (a j)) =
        (fun j ↦ (1 : X.residueField x) ⊗ₜ[X.presheaf.stalk x]
          KaehlerDifferential.D k (X.presheaf.stalk x) (c j)) := by
      funext j
      exact hE j
    rw [hfun]
    exact hs
  exact (Submodule.map_eq_top_iff (e := E)).mp heq

end AlgebraicGeometry.Scheme.Hom
