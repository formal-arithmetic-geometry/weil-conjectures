module

public import WeilConjectures.AlgebraicGeometry.NoetherianApproximation.GluingPresentation

/-!
# The coefficient stage and the valid stage of a finite affine gluing presentation

Let `G` be a finite affine gluing presentation of a scheme `S`
(`AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation`). We define

- `G.coeffSubring a`: the finitely generated subring of `Γ(S, Uₐ)` generated by the basic-open
  elements of the chart `a`, the coefficients witnessing the unit conditions, and the numerators
  needed to express the restrictions of the basic-open elements of the other charts in the
  localizations `Aₐ[1/f a b r]` (the coefficient stage `λ_coeff`);
- `G.glueStage`: a selected valid stage whose coefficient subrings contain the
  `G.coeffSubring a` (the valid stage `λ_glue`),

and show that the gluing identities hold at `G.glueStage` and at every larger stage, and that the
valid stages are nonempty and directed.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation

variable {S : Scheme.{u}} (G : S.FiniteAffineGluingPresentation)

/-- The basic-open elements of the chart `b`: the `f b c q` and the `g c b q`. -/
def basicOpenElems (b : G.ι) : Set Γ(S, G.U b) :=
  Set.range (fun p : Σ c, G.κ b c ↦ G.f b p.1 p.2) ∪
    Set.range (fun p : Σ c, G.κ c b ↦ G.g p.1 b p.2)

lemma basicOpenElems_finite (b : G.ι) : (G.basicOpenElems b).Finite :=
  (Set.finite_range _).union (Set.finite_range _)

lemma basicOpen_f_le_right (a b : G.ι) (r : G.κ a b) :
    S.basicOpen (G.f a b r) ≤ (G.U b : S.Opens) :=
  (G.basicOpen_f_le_inf a b r).trans inf_le_right

/-- The numerators needed to express the restrictions of the basic-open elements of the charts
`b` to the overlaps `D(f a b r)` in the localizations of `Γ(S, Uₐ)` at the `f a b r`. -/
def coeffNumerators (a : G.ι) : Set Γ(S, G.U a) :=
  ⋃ (b : G.ι) (r : G.κ a b), (fun y ↦ numerator (G.U a).2 (G.f a b r)
    (S.resLE (G.basicOpen_f_le_right a b r) y)) '' G.basicOpenElems b

lemma coeffNumerators_finite (a : G.ι) : (G.coeffNumerators a).Finite :=
  Set.finite_iUnion fun b ↦ Set.finite_iUnion fun _ ↦ (G.basicOpenElems_finite b).image _

/-- The finite set of generators of the coefficient subring of the chart `a`. -/
def coeffGenerators (a : G.ι) : Set Γ(S, G.U a) :=
  G.witnesses a ∪ G.coeffNumerators a

lemma coeffGenerators_finite (a : G.ι) : (G.coeffGenerators a).Finite :=
  (G.witnesses_finite a).union (G.coeffNumerators_finite a)

/-- Coefficient stage of an affine
gluing presentation.

The finitely generated subring `λ_coeff` of `Γ(S, Uₐ)` generated by the basic-open elements of
the chart `a`, the coefficients witnessing the unit conditions (`witnesses`), and the numerators
needed to express the restrictions of the basic-open elements of every other chart `b` in the
localizations `Aₐ[1/f a b r]` (`coeffNumerators`). One such round of closure suffices: the
gluing identities are then enforced by passing to a valid stage (`glueStage`). -/
def coeffSubring (a : G.ι) : Subring Γ(S, G.U a) :=
  Subring.closure (G.coeffGenerators a)

lemma exists_finset_closure_eq_coeffSubring (a : G.ι) :
    ∃ s : Finset Γ(S, G.U a), Subring.closure (s : Set Γ(S, G.U a)) = G.coeffSubring a :=
  ⟨(G.coeffGenerators_finite a).toFinset, by rw [Set.Finite.coe_toFinset]; rfl⟩

instance (a : G.ι) : Algebra.FiniteType ℤ (G.coeffSubring a) := by
  obtain ⟨s, hs⟩ := G.exists_finset_closure_eq_coeffSubring a
  rw [← hs]
  exact Subring.finiteType_closure_finset s

lemma witnesses_subset_coeffSubring (a : G.ι) : G.witnesses a ⊆ G.coeffSubring a :=
  Set.subset_union_left.trans Subring.subset_closure

lemma f_mem_coeffSubring (a b : G.ι) (r : G.κ a b) : G.f a b r ∈ G.coeffSubring a :=
  G.witnesses_subset_coeffSubring a (G.f_mem_witnesses a b r)

lemma g_mem_coeffSubring (a b : G.ι) (r : G.κ a b) : G.g a b r ∈ G.coeffSubring b :=
  G.witnesses_subset_coeffSubring b (G.g_mem_witnesses a b r)

/-- All gluing coefficients occur
at the selected stage.

The coefficient subrings `G.coeffSubring a` are finitely generated
(`exists_finset_closure_eq_coeffSubring`) and contain the basic-open elements
(`f_mem_coeffSubring`, `g_mem_coeffSubring`); and the restriction of every basic-open element
`y` of a chart `b` to an overlap `D(f a b r)` lies in the localization
`G.coeffSubring a [1/f a b r]`, i.e. the restricted overlap maps are defined at the coefficient
stage. -/
theorem resLE_mem_localizationSubring_coeffSubring (a b : G.ι) (r : G.κ a b)
    {y : Γ(S, G.U b)} (hy : y ∈ G.basicOpenElems b) :
    S.resLE (G.basicOpen_f_le_right a b r) y ∈
      localizationSubring (G.coeffSubring a) (G.f a b r) (S.basicOpen (G.f a b r)) le_rfl :=
  mem_localizationSubring_of_numerator_mem (G.U a).2 _ _ (Subring.subset_closure
    (Set.mem_union_right _ (Set.mem_iUnion₂.mpr ⟨b, r, y, hy, rfl⟩)))

/-- Cocycle-valid stage of an affine
gluing presentation.

A selected valid stage `λ_glue` whose coefficient subrings contain the coefficient subrings
`G.coeffSubring a` of `λ_coeff`; it exists by cofinality of the valid stages
(`exists_stage_superset`, which provides a common stage at which all the finitely many gluing
identities hold). -/
noncomputable def glueStage : G.Stage :=
  (G.exists_stage_superset G.coeffGenerators G.coeffGenerators_finite).choose

lemma coeffSubring_le_glueStage (a : G.ι) : G.coeffSubring a ≤ G.glueStage.A a :=
  Subring.closure_le.mpr
    ((G.exists_stage_superset G.coeffGenerators G.coeffGenerators_finite).choose_spec a)

/-- The selected finite-stage
datum satisfies the gluing axioms.

For the valid stage `λ_glue = G.glueStage` and every larger stage `l`, the coefficient subrings of
`l` contain those of `λ_coeff`, and the gluing identities hold at `l`: the `f a a r` generate the
unit ideal of `Aₐ` (identity), `Aₐ[1/f a b r] = A_b[1/g a b r]` (the overlap maps are defined
and mutually inverse), the `f b a q` generate the unit ideal of `A_b[1/g a b r]` (the overlap
maps preserve the overlaps), and the `f b c q` generate the unit ideal of
`Aₐ[1/(f a b r * f a c s)]` (triple overlaps are preserved, giving the cocycle condition). -/
theorem gluing_identities_of_glueStage_le (l : G.Stage) (hl : G.glueStage ≤ l) :
    (∀ a, G.coeffSubring a ≤ l.A a) ∧
    (∀ a, ∃ c : G.κ a a → Γ(S, G.U a), (∀ r, c r ∈ l.A a) ∧ ∑ r, c r * G.f a a r = 1) ∧
    (∀ a b r,
      localizationSubring (l.A a) (G.f a b r) (S.basicOpen (G.f a b r)) le_rfl =
        localizationSubring (l.A b) (G.g a b r) (S.basicOpen (G.f a b r))
          (G.basicOpen_f a b r).le) ∧
    (∀ a b (r : G.κ a b), ∃ c : G.κ b a → Γ(S, S.basicOpen (G.g a b r)),
      (∀ q, c q ∈ localizationSubring (l.A b) (G.g a b r) _ le_rfl) ∧
        ∑ q, c q * S.resLE (S.basicOpen_le (G.g a b r)) (G.f b a q) = 1) ∧
    (∀ a b c (r : G.κ a b) (s : G.κ a c),
      ∃ e : G.κ b c → Γ(S, S.basicOpen (G.f a b r * G.f a c s)),
        (∀ q, e q ∈ localizationSubring (l.A a) (G.f a b r * G.f a c s) _ le_rfl) ∧
        ∑ q, e q * S.resLE ((G.basicOpen_mul_le a b c r s).trans inf_le_left) (G.f b c q) = 1) :=
  ⟨fun a ↦ (G.coeffSubring_le_glueStage a).trans (hl a), l.unit_self, l.localization_eq,
    l.unit_symm, l.unit_triple⟩

/-- Valid finite coefficient refinements
form a directed set (order-theoretic part).

The valid stages are nonempty (`G.glueStage` is one) and directed under inclusion: the
componentwise supremum `l ⊔ l'` of two valid stages is again a valid stage, above both. The
induced transition maps of the glued finite-type schemes are constructed separately. -/
theorem nonempty_and_isDirected_stage :
    Nonempty G.Stage ∧ IsDirected G.Stage (· ≤ ·) ∧
      ∀ (l l' : G.Stage) (a : G.ι), (l ⊔ l').A a = l.A a ⊔ l'.A a :=
  ⟨⟨G.glueStage⟩, inferInstance, Stage.sup_A G⟩

end AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation
