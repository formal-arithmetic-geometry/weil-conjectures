module

public import WeilConjectures.Mathlib.AlgebraicGeometry.AffineTransitionLimit

/-!
# Finite affine gluing presentations and their finite-type stages

Let `S` be a quasi-compact quasi-separated scheme. A *finite affine gluing presentation* of `S`
(`AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation`) consists of a finite affine open
cover `S = ⋃ₐ Uₐ` together with, for every pair of charts, finitely many sections
`f a b r ∈ Γ(S, Uₐ)` and `g a b r ∈ Γ(S, U_b)` with `D(f a b r) = D(g a b r)` whose basic opens
cover `Uₐ ⊓ U_b`.

A *stage* of such a presentation (`AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation.Stage`)
is a family of finitely generated subrings `Aₐ ⊆ Γ(S, Uₐ)` containing the basic-open elements
and satisfying finitely many gluing conditions; the spectra `Spec Aₐ` then glue along the basic
opens of the `f a b r` to a scheme of finite type over `ℤ`.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry.Scheme

variable (S : Scheme.{u})

/-- The restriction map `Γ(S, U) ⟶ Γ(S, W)` for `W ≤ U`. -/
noncomputable abbrev resLE {U W : S.Opens} (h : W ≤ U) : Γ(S, U) ⟶ Γ(S, W) :=
  S.presheaf.map (homOfLE h).op

variable {S}

/-- For a subring `A ⊆ Γ(S, U)`, an element `s ∈ Γ(S, U)` and an open `W ≤ D(s)`, the subring
`A[1/s]|_W ⊆ Γ(S, W)` generated by the restrictions of the elements of `A` and the inverse of
the restriction of `s`. -/
noncomputable def localizationSubring {U : S.Opens} (A : Subring Γ(S, U)) (s : Γ(S, U))
    (W : S.Opens) (hW : W ≤ S.basicOpen s) : Subring Γ(S, W) :=
  Subring.closure (insert
    (((RingedSpace.isUnit_res_basicOpen S.toRingedSpace s).map
      (S.presheaf.map (homOfLE hW).op).hom).unit⁻¹ : Γ(S, W)ˣ).val
    ((S.resLE (hW.trans (S.basicOpen_le s))).hom '' A))

variable (S) in
/-- Blueprint `def-nagata-finite-affine-gluing-presentation`: Selected finite affine gluing
presentation.

A finite affine open cover `S = ⋃ₐ Uₐ` together with, for every pair `(a, b)` of charts, finitely
many sections `f a b r ∈ Γ(S, Uₐ)` and `g a b r ∈ Γ(S, U_b)` with equal basic opens
`D(f a b r) = D(g a b r)`, whose basic opens cover `Uₐ ⊓ U_b`. Each such basic open is thus a
basic open both of `Uₐ` and of `U_b`; the overlap maps are the identifications
`Γ(S, Uₐ)_{f a b r} ≅ Γ(S, D(f a b r)) ≅ Γ(S, U_b)_{g a b r}`. -/
structure FiniteAffineGluingPresentation where
  /-- The index type of the charts. -/
  ι : Type u
  [fintype_ι : Fintype ι]
  /-- The affine charts. -/
  U : ι → S.affineOpens
  iSup_U : ⨆ a, (U a : S.Opens) = ⊤
  /-- The index type of the basic opens covering `Uₐ ⊓ U_b`. -/
  κ : ι → ι → Type u
  [fintype_κ : ∀ a b, Fintype (κ a b)]
  /-- The basic-open elements of `Uₐ` covering `Uₐ ⊓ U_b`. -/
  f : ∀ a b, κ a b → Γ(S, U a)
  /-- The corresponding basic-open elements of `U_b`. -/
  g : ∀ a b, κ a b → Γ(S, U b)
  basicOpen_f : ∀ a b r, S.basicOpen (f a b r) = S.basicOpen (g a b r)
  iSup_basicOpen_f : ∀ a b, ⨆ r, S.basicOpen (f a b r) = (U a : S.Opens) ⊓ U b

namespace FiniteAffineGluingPresentation

attribute [instance] fintype_ι fintype_κ

variable (G : S.FiniteAffineGluingPresentation)

lemma basicOpen_g_le (a b : G.ι) (r : G.κ a b) :
    S.basicOpen (G.g a b r) ≤ S.basicOpen (G.f a b r) :=
  (G.basicOpen_f a b r).ge

/-- Blueprint `def-nagata-noetherian-stage` (the index set): a *valid finite coefficient
refinement* of the presentation `G`.

A family of finitely generated subrings `Aₐ ⊆ Γ(S, Uₐ)` containing all basic-open elements, such
that the finitely many gluing equations hold at this stage:
- `unit_self`: the `f a a r` generate the unit ideal of `Aₐ` (so the overlap of a chart with
  itself is everything);
- `localization_eq`: `Aₐ[1/f a b r] = A_b[1/g a b r]` inside `Γ(S, D(f a b r))` (the overlap
  maps are defined and mutually inverse at this stage);
- `unit_symm`: the `f b a q` generate the unit ideal of `A_b[1/g a b r]`
  (the overlap maps preserve the overlap opens);
- `unit_triple`: the `f b c q` generate the unit ideal of `Aₐ[1/(f a b r * f a c s)]`
  (triple overlaps are preserved). -/
structure Stage where
  /-- The coefficient subrings. -/
  A : ∀ a, Subring Γ(S, G.U a)
  fg : ∀ a, (A a).FG
  f_mem : ∀ a b r, G.f a b r ∈ A a
  g_mem : ∀ a b r, G.g a b r ∈ A b
  unit_self : ∀ a, ∃ c : G.κ a a → Γ(S, G.U a), (∀ r, c r ∈ A a) ∧
    ∑ r, c r * G.f a a r = 1
  localization_eq : ∀ a b r,
    localizationSubring (A a) (G.f a b r) (S.basicOpen (G.f a b r)) le_rfl =
      localizationSubring (A b) (G.g a b r) (S.basicOpen (G.f a b r)) (G.basicOpen_f a b r).le
  unit_symm : ∀ a b (r : G.κ a b), ∃ c : G.κ b a → Γ(S, S.basicOpen (G.g a b r)),
    (∀ q, c q ∈ localizationSubring (A b) (G.g a b r) _ le_rfl) ∧
      ∑ q, c q * S.resLE (S.basicOpen_le (G.g a b r)) (G.f b a q) = 1
  unit_triple : ∀ a b c (r : G.κ a b) (s : G.κ a c),
    ∃ e : G.κ b c → Γ(S, S.basicOpen (G.f a b r * G.f a c s)),
      (∀ q, e q ∈ localizationSubring (A a) (G.f a b r * G.f a c s) _ le_rfl) ∧
      ∑ q, e q * S.resLE (U := G.U b) (by
        rw [Scheme.basicOpen_mul]
        exact inf_le_left.trans ((G.basicOpen_f a b r).le.trans (S.basicOpen_le _)))
          (G.f b c q) = 1

end FiniteAffineGluingPresentation

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation

variable {S : Scheme.{u}} (G : S.FiniteAffineGluingPresentation)

lemma Stage.A_injective : Function.Injective (Stage.A : G.Stage → _) := by
  rintro ⟨⟩ ⟨⟩ h
  cases h
  rfl

/-- Stages are ordered by inclusion of their coefficient subrings. -/
instance : PartialOrder G.Stage := PartialOrder.lift _ (Stage.A_injective G)

lemma Stage.le_iff {l₁ l₂ : G.Stage} : l₁ ≤ l₂ ↔ ∀ a, l₁.A a ≤ l₂.A a := Iff.rfl

/-- Part of blueprint `lemma-nagata-valid-refinements-directed`: valid stages are directed. -/
instance : IsDirected G.Stage (· ≤ ·) := sorry

/-- Part of blueprint `lemma-nagata-valid-refinements-directed`: valid stages exist. -/
instance : Nonempty G.Stage := sorry

/-- Cofinality of the valid stages: every section of every chart lies in the coefficient
subring of some valid stage. -/
theorem exists_stage_mem (a : G.ι) (x : Γ(S, G.U a)) : ∃ l : G.Stage, x ∈ l.A a := sorry

end AlgebraicGeometry.Scheme.FiniteAffineGluingPresentation
