module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# The affine pair associated to an infinite product of fields

Source: the explicit affine pair in step 5 of `definition-local-cohomology`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry.ProEtale.SupportCounterexample

variable (k I : Type u) [Field k] [DecidableEq I]

/-- The affine base for the finite-support counterexample. -/
abbrev base : Scheme.{u} := Spec (.of (I → k))

/-- The coordinate idempotent. -/
def coordinate (i : I) : I → k := Pi.single i 1

/-- The clopen coordinate piece. -/
def piece (i : I) : (base k I).Opens := PrimeSpectrum.basicOpen (coordinate k I i)

/-- The ideal generated by the coordinate idempotents. -/
def supportIdeal : Ideal (I → k) := Ideal.span (Set.range (coordinate k I))

/-- The closed complement of all coordinate pieces. -/
abbrev closed : Scheme.{u} := Spec (.of ((I → k) ⧸ supportIdeal k I))

/-- The union of the coordinate pieces. -/
def openPart : (base k I).Opens := ⨆ i, piece k I i

end AlgebraicGeometry.ProEtale.SupportCounterexample
