module
public import WeilConjectures.AlgebraicGeometry.OrdinaryFiniteP1Arrows
import WeilConjectures.AlgebraicGeometry.FiniteP1ChernAdjunctMate
import WeilConjectures.AlgebraicGeometry.FiniteP1ChernMapBaseChange

/-! # Exchange for the normalized projective-line Chern adjunct

Source: blueprint lemma-cohomology-projective-line-trace, arbitrary-base paragraph, and
lem-sp-finite-p1-kummer-naturality, steps 1--3.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Etale

attribute [local irreducible] AlgebraicGeometry.ProjectiveSpace

/-- The adjuncts of two specified Kummer classes commute with exchange.
Source: blueprint lemma-cohomology-projective-line-trace, arbitrary-base paragraph, and
lem-sp-finite-p1-kummer-naturality, steps 1--3.
(auxiliary; not a blueprint node).

Proof: take the hyperplane x_0=0. Its ideal on the x_1-chart is generated by
x_0/x_1, a polynomial variable and hence a non-zero-divisor over every ring; on
the x_0-chart the ideal is the unit ideal. These descriptions persist under
arbitrary base change. The dual ideal has exactly the O(1) transition function.
Apply the supported Cartier Kummer theorem to this divisor and its pullback.
Its normalization identifies the unsupported class with the scalar Kummer
boundary of O(1). The arbitrary-base class comparison is injective, so these
arrows equal c and c', respectively. Uniqueness of the roots comparison by its
kernel inclusion, and of the line comparison by pure-tensor generators, identifies
the supported theorem's transport with t. Its supported pullback square, composed
with the constant unit and the divisor mate-unit equation, therefore gives
f_P^*(c) followed by shifted-line transport equal to constant transport followed
by c'. Now transpose under the q'-adjunction. The projective-line mate formula
and adjunction triangle identities identify the left transpose with the pullback
of the q-adjunct followed by exchange. Constant comparisons commute around the
inverse-image square. Substitute the Chern pullback equation; naturality of the
adjunction correspondence gives the displayed right side. No splitting or
Noetherianity is used. Variable regularity holds over nonreduced rings and the
zero ring; N=1 gives the same equation in the zero-coefficient category. -/
theorem ordinaryFiniteP1_chern_adjunct_baseChange
    (A : Type (u + 1)) [CommRing A] [Finite A]
    (N : ℕ) (hN : 0 < N) (hA : (N : A) = 0)
    (t : OrdinaryFiniteTwistTransport A N hA)
    {S' S : Scheme.{u}} (f : S' ⟶ S) (hS : IsUnit (N : Γ(S, ⊤)))
    (hS' : IsUnit (N : Γ(S', ⊤)))
    (c : ordinaryFiniteUnit A (ProjectiveLine S) ⟶
      (ordinaryFiniteLine A N hA (ProjectiveLine S))⟦(2 : ℤ)⟧)
    (c' : ordinaryFiniteUnit A (ProjectiveLine S') ⟶
      (ordinaryFiniteLine A N hA (ProjectiveLine S'))⟦(2 : ℤ)⟧)
    (hc : ordinaryFiniteP1ChernSpec A N hA S
      ((map_natCast (ProjectiveLine S ↘ S).appTop.hom N) ▸
        hS.map (ProjectiveLine S ↘ S).appTop.hom) c)
    (hc' : ordinaryFiniteP1ChernSpec A N hA S'
      ((map_natCast (ProjectiveLine S' ↘ S').appTop.hom N) ▸
        hS'.map (ProjectiveLine S' ↘ S').appTop.hom) c') :
    (ordinaryFinitePullback A f).map (ordinaryFiniteP1ChernPushforward A N hA S c) ≫
        ordinaryFiniteP1Exchange A f
          ((ordinaryFiniteLine A N hA (ProjectiveLine S))⟦(2 : ℤ)⟧) ≫
        (ordinaryFinitePushforward A (ProjectiveLine S' ↘ S')).map
          (ordinaryFiniteShiftedLinePullback A N hA t
            (ProjectiveSpace.map (ULift.{u} (Fin 2)) f)
            ((map_natCast (ProjectiveLine S ↘ S).appTop.hom N) ▸
              hS.map (ProjectiveLine S ↘ S).appTop.hom)).hom =
      (ordinaryFiniteUnitPullback A f).hom ≫
        ordinaryFiniteP1ChernPushforward A N hA S' c' := by
  apply ordinaryFiniteP1_chern_adjunct_of_map_baseChange A N hN hA t f hS hS' c c'
  exact ordinaryFiniteP1_chern_map_baseChange A N hN hA t f hS hS' c c' hc hc'

end AlgebraicGeometry.Etale
