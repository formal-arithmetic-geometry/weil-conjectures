module

public import Mathlib.AlgebraicGeometry.Limits
public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.Connected
public import Mathlib.FieldTheory.IsSepClosed
public import WeilConjectures.Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic

/-!
# Base change to the separable closure as a cofiltered limit

Let `k` be a field with separable closure `kˢᵉᵖ`. The field `kˢᵉᵖ` is the filtered colimit of
its finite subextensions `L` (`AlgebraicGeometry.Scheme.isColimitSepFiniteSubfieldCocone`), so
for a `k`-scheme `t : Z ⟶ Spec k` the base change `Z ×_k kˢᵉᵖ` is the cofiltered limit of the
base changes `Z ×_k L`, as schemes over `Z`
(`AlgebraicGeometry.Scheme.isLimitSepFiniteSubfieldOverCone`). The transition morphisms are
affine.

## Main definitions

- `AlgebraicGeometry.Scheme.SepFiniteSubfield`: the finite subextensions of `kˢᵉᵖ / k`.
- `AlgebraicGeometry.Scheme.sepFiniteSubfieldOverDiagram`: the diagram `L ↦ Z ×_k L` of
  schemes over `Z`.
- `AlgebraicGeometry.Scheme.sepFiniteSubfieldOverCone`: the cone with vertex `Z ×_k kˢᵉᵖ`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

section Colimit

variable (k : Type u) [Field k]

/-- The finite subextensions `L` of `kˢᵉᵖ / k`, ordered by inclusion. -/
abbrev SepFiniteSubfield : Type u :=
  {L : IntermediateField k (SeparableClosure k) // FiniteDimensional k L}

instance SepFiniteSubfield.instNonempty : Nonempty (SepFiniteSubfield k) :=
  ⟨⟨⊥, inferInstance⟩⟩

instance SepFiniteSubfield.instIsDirected : IsDirected (SepFiniteSubfield k) (· ≤ ·) where
  directed L₁ L₂ := by
    have := L₁.2
    have := L₂.2
    exact ⟨⟨L₁.1 ⊔ L₂.1, IntermediateField.finiteDimensional_sup _ _⟩, le_sup_left (a := L₁.1),
      le_sup_right (a := L₁.1)⟩

/-- Two finite subextensions are contained in a third one. -/
lemma SepFiniteSubfield.exists_ge {k : Type u} [Field k] (L M : SepFiniteSubfield k) :
    ∃ N, L ≤ N ∧ M ≤ N :=
  @directed_of _ (· ≤ ·) (SepFiniteSubfield.instIsDirected k) L M

instance SepFiniteSubfield.instIsFiltered : IsFiltered (SepFiniteSubfield k) :=
  @isFiltered_of_directed_le_nonempty _ _ (SepFiniteSubfield.instIsDirected k) _

variable {k}

/-- The finite subextension `k(x)` of `kˢᵉᵖ / k` generated by an element `x`. -/
noncomputable def SepFiniteSubfield.adjoin (x : SeparableClosure k) : SepFiniteSubfield k :=
  ⟨IntermediateField.adjoin k {x},
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)⟩

lemma SepFiniteSubfield.mem_adjoin (x : SeparableClosure k) :
    x ∈ (SepFiniteSubfield.adjoin x).1 :=
  IntermediateField.mem_adjoin_simple_self k x

variable (k)

/-- The diagram `L ↦ L` of the finite subextensions of `kˢᵉᵖ / k` in `CommRingCat`. -/
@[simps]
noncomputable def sepFiniteSubfieldDiagram : SepFiniteSubfield k ⥤ CommRingCat.{u} where
  obj L := .of L.1
  map {L L'} f := CommRingCat.ofHom (IntermediateField.inclusion (leOfHom f)).toRingHom

/-- The separable closure `kˢᵉᵖ` as a cocone over its finite subextensions. -/
@[simps]
noncomputable def sepFiniteSubfieldCocone : Cocone (sepFiniteSubfieldDiagram k) where
  pt := .of (SeparableClosure k)
  ι := { app L := CommRingCat.ofHom L.1.val.toRingHom }

variable {k}

/-- The ring homomorphism out of `kˢᵉᵖ` induced by a cocone over the finite subextensions:
`x ↦ ι_{k(x)} x`. -/
noncomputable def sepFiniteSubfieldDescFun (s : Cocone (sepFiniteSubfieldDiagram k))
    (x : SeparableClosure k) : s.pt :=
  (s.ι.app (SepFiniteSubfield.adjoin x)).hom ⟨x, SepFiniteSubfield.mem_adjoin x⟩

lemma sepFiniteSubfieldDescFun_eq (s : Cocone (sepFiniteSubfieldDiagram k))
    (L : SepFiniteSubfield k) (x : L.1) : sepFiniteSubfieldDescFun s x = (s.ι.app L).hom x := by
  obtain ⟨M, hLM, hxM⟩ :=
    SepFiniteSubfield.exists_ge L (SepFiniteSubfield.adjoin (x : SeparableClosure k))
  have h₁ := ConcreteCategory.congr_hom (s.w (homOfLE hLM)) x
  have h₂ := ConcreteCategory.congr_hom (s.w (homOfLE hxM)) ⟨x, SepFiniteSubfield.mem_adjoin _⟩
  exact h₂.symm.trans h₁

/-- `kˢᵉᵖ` is the filtered colimit of its finite subextensions. -/
noncomputable def isColimitSepFiniteSubfieldCocone : IsColimit (sepFiniteSubfieldCocone k) where
  desc s := CommRingCat.ofHom
    { toFun := sepFiniteSubfieldDescFun s
      map_one' := by
        have h := sepFiniteSubfieldDescFun_eq s ⟨⊥, inferInstance⟩ 1
        rw [map_one] at h
        exact h
      map_mul' x y := by
        obtain ⟨M, hM₁, hM₂⟩ := SepFiniteSubfield.exists_ge (SepFiniteSubfield.adjoin x)
          (SepFiniteSubfield.adjoin y)
        have hx : x ∈ M.1 := hM₁ (SepFiniteSubfield.mem_adjoin x)
        have hy : y ∈ M.1 := hM₂ (SepFiniteSubfield.mem_adjoin y)
        rw [sepFiniteSubfieldDescFun_eq s M ⟨x, hx⟩, sepFiniteSubfieldDescFun_eq s M ⟨y, hy⟩]
        exact (sepFiniteSubfieldDescFun_eq s M ⟨x * y, mul_mem hx hy⟩).trans
          (map_mul (s.ι.app M).hom (⟨x, hx⟩ : M.1) ⟨y, hy⟩)
      map_zero' := by
        have h := sepFiniteSubfieldDescFun_eq s ⟨⊥, inferInstance⟩ 0
        rw [map_zero] at h
        exact h
      map_add' x y := by
        obtain ⟨M, hM₁, hM₂⟩ := SepFiniteSubfield.exists_ge (SepFiniteSubfield.adjoin x)
          (SepFiniteSubfield.adjoin y)
        have hx : x ∈ M.1 := hM₁ (SepFiniteSubfield.mem_adjoin x)
        have hy : y ∈ M.1 := hM₂ (SepFiniteSubfield.mem_adjoin y)
        rw [sepFiniteSubfieldDescFun_eq s M ⟨x, hx⟩, sepFiniteSubfieldDescFun_eq s M ⟨y, hy⟩]
        exact (sepFiniteSubfieldDescFun_eq s M ⟨x + y, add_mem hx hy⟩).trans
          (map_add (s.ι.app M).hom (⟨x, hx⟩ : M.1) ⟨y, hy⟩) }
  fac s L := by
    ext x
    exact sepFiniteSubfieldDescFun_eq s L x
  uniq s m hm := by
    refine CommRingCat.hom_ext (RingHom.ext fun x ↦ ?_)
    exact (ConcreteCategory.congr_hom (hm (SepFiniteSubfield.adjoin x))
      ⟨x, SepFiniteSubfield.mem_adjoin x⟩).trans (sepFiniteSubfieldDescFun_eq s _ _).symm

end Colimit

section OverLimit

variable {k : Type u} [Field k] {Z : Scheme.{u}} (t : Z ⟶ Spec (.of k))

/-- The structure morphism `Spec L ⟶ Spec k` of a finite subextension `L`. -/
noncomputable def SepFiniteSubfield.specHom (L : SepFiniteSubfield k) :
    Spec (.of L.1) ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k L.1))

/-- The structure morphism `Spec kˢᵉᵖ ⟶ Spec k`. -/
noncomputable def specSeparableClosureHom (k : Type u) [Field k] :
    Spec (.of (SeparableClosure k)) ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k)))

/-- The morphism `Spec L ⟶ Spec L'` induced by an inclusion `L' ≤ L`. -/
noncomputable def SepFiniteSubfield.specInclusion {L L' : SepFiniteSubfield k} (h : L' ≤ L) :
    Spec (.of L.1) ⟶ Spec (.of L'.1) :=
  Spec.map (CommRingCat.ofHom (IntermediateField.inclusion h).toRingHom)

@[reassoc (attr := simp)]
lemma SepFiniteSubfield.specInclusion_specHom {L L' : SepFiniteSubfield k} (h : L' ≤ L) :
    SepFiniteSubfield.specInclusion h ≫ L'.specHom = L.specHom := by
  rw [specInclusion, specHom, specHom, ← Spec.map_comp]
  rfl

/-- The morphism `Spec kˢᵉᵖ ⟶ Spec L` of a finite subextension `L`. -/
noncomputable def SepFiniteSubfield.specVal (L : SepFiniteSubfield k) :
    Spec (.of (SeparableClosure k)) ⟶ Spec (.of L.1) :=
  Spec.map (CommRingCat.ofHom L.1.val.toRingHom)

@[reassoc (attr := simp)]
lemma SepFiniteSubfield.specVal_specHom (L : SepFiniteSubfield k) :
    L.specVal ≫ L.specHom = specSeparableClosureHom k := by
  rw [specVal, specHom, specSeparableClosureHom, ← Spec.map_comp]
  rfl

instance (L : SepFiniteSubfield k) : IsAffineHom L.specHom :=
  isAffineHom_of_isAffine _

/-- The base changes `Z ×_k L` over the finite subextensions `L` of `kˢᵉᵖ / k`, as a cofiltered
diagram of schemes over `Z`. -/
@[simps]
noncomputable def sepFiniteSubfieldOverDiagram : (SepFiniteSubfield k)ᵒᵖ ⥤ Over Z where
  obj L := Over.mk (pullback.fst t L.unop.specHom)
  map {L L'} f := Over.homMk (pullback.map t L.unop.specHom t L'.unop.specHom (𝟙 Z)
    (SepFiniteSubfield.specInclusion (leOfHom f.unop)) (𝟙 _) (by simp) (by simp)) (by simp)
  map_id L := by
    ext1
    refine pullback.hom_ext (by simp) ?_
    simp only [Over.homMk_left, pullback.lift_snd, Over.id_left, Category.id_comp]
    rw [SepFiniteSubfield.specInclusion]
    erw [IntermediateField.inclusion_self]
    rw [← Category.comp_id (pullback.snd t L.unop.specHom)]
    congr 1
    exact Spec.map_id _
  map_comp {L L' L''} f g := by
    ext1
    refine pullback.hom_ext (by simp) ?_
    simp only [Over.homMk_left, pullback.lift_snd, Over.comp_left, Category.assoc,
      pullback.lift_snd_assoc]
    rw [SepFiniteSubfield.specInclusion, SepFiniteSubfield.specInclusion,
      SepFiniteSubfield.specInclusion, ← Spec.map_comp]
    rfl

/-- The base change `Z ×_k kˢᵉᵖ`, as a cone over the base changes `Z ×_k L`. -/
@[simps]
noncomputable def sepFiniteSubfieldOverCone : Cone (sepFiniteSubfieldOverDiagram t) where
  pt := Over.mk (pullback.fst t (specSeparableClosureHom k))
  π :=
    { app L := Over.homMk (pullback.map t (specSeparableClosureHom k) t L.unop.specHom (𝟙 Z)
        L.unop.specVal (𝟙 _) (by simp) (by simp))
        ((pullback.lift_fst _ _ _).trans (Category.comp_id _))
      naturality {L L'} f := by
        ext1
        refine pullback.hom_ext (by simp) ?_
        simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp,
          Over.comp_left, sepFiniteSubfieldOverDiagram_map, Over.homMk_left, Category.assoc,
          pullback.lift_snd, pullback.lift_snd_assoc]
        rw [SepFiniteSubfield.specVal, SepFiniteSubfield.specVal,
          SepFiniteSubfield.specInclusion, ← Spec.map_comp]
        rfl }

/-- The base change `Z ×_k kˢᵉᵖ` is the cofiltered limit of the base changes `Z ×_k L` over the
finite subextensions `L` of `kˢᵉᵖ / k`: base change along `t` of `Spec kˢᵉᵖ = lim Spec L`. -/
noncomputable def isLimitSepFiniteSubfieldOverCone :
    IsLimit ((Over.forget Z).mapCone (sepFiniteSubfieldOverCone t)) := by
  have := IsCofiltered.isConnected (SepFiniteSubfield k)ᵒᵖ
  let D := (sepFiniteSubfieldDiagram k).op ⋙ Scheme.Spec
  let cD : Cone D := Scheme.Spec.mapCone (sepFiniteSubfieldCocone k).op
  have hcD : IsLimit cD := isLimitOfPreserves Scheme.Spec (isColimitSepFiniteSubfieldCocone).op
  let α : sepFiniteSubfieldOverDiagram t ⋙ Over.forget Z ⟶ D :=
    { app L := pullback.snd t L.unop.specHom
      naturality {L L'} f := by
        simp only [Functor.comp_obj, Over.forget_obj, Functor.comp_map, Over.forget_map,
          sepFiniteSubfieldOverDiagram_map, Over.homMk_left, pullback.lift_snd]
        rfl }
  refine isLimitOfIsPullbackOfIsConnected α _ cD
    { hom := pullback.snd t (specSeparableClosureHom k)
      w L := by
        simp only [Cone.postcompose_obj_pt, Functor.mapCone_pt, Over.forget_obj,
          Cone.postcompose_obj_π, NatTrans.comp_app,
          Functor.const_obj_obj, Functor.comp_obj, Functor.mapCone_π_app, Over.forget_map,
          sepFiniteSubfieldOverCone_π_app, Over.homMk_left, pullback.lift_snd, α]
        rfl } (fun L ↦ ?_) hcD
  exact isPullback_pullback_map t _ _ L.unop.specVal L.unop.specVal_specHom

instance {L L' : (SepFiniteSubfield k)ᵒᵖ} (f : L ⟶ L') :
    IsAffineHom ((sepFiniteSubfieldOverDiagram t).map f).left := by
  have h := isPullback_pullback_map t L.unop.specHom L'.unop.specHom
    (SepFiniteSubfield.specInclusion (leOfHom f.unop))
    (SepFiniteSubfield.specInclusion_specHom _)
  have : IsAffineHom (SepFiniteSubfield.specInclusion (leOfHom f.unop)) :=
    isAffineHom_of_isAffine _
  exact MorphismProperty.of_isPullback h.flip inferInstance

end OverLimit

end AlgebraicGeometry.Scheme
