/-!
# Reduction of pulled-back condensed ell-adic integers

Source: blueprint main-20261015, sec-proetale-coefficients,
`sk-def-sp-tate-twist/_section.md`, integral coefficient comparison, and
`sk-prop-sfb-qlbar-colimit-x/_section.md`, final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power).

The reduction is the normalized integral-limit projection of the recorded completed
coefficient comparison. The quotient is the actual cokernel of scalar multiplication
in sheaves of modules. Its ring structure is characterized by the quotient projection
being a ring map. The comparison is simultaneously a ring and module isomorphism.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale

attribute [local irreducible] upperStarFromPoint upperStarFromPointComp
  monoidal_upperStarFromPoint monoidal_pointUpperStar oplaxMonoidal_pointUpperStar

/-- The normalized integral-limit reduction cone on the point, supplied by the completed
coefficient comparison. Its projections are uniquely determined: after restriction to
every point of a profinite set, the normalization is the usual quotient of `ℤ_[ℓ]`.
Source: completed-coefficient proposition, integral comparison and final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
@[irreducible] noncomputable def purZlPointReduction (ℓ : ℕ) [Fact ℓ.Prime] :
    (Functor.const ℕᵒᵖ).obj (Mon.mk (Profinite.continuousMapRingObj.{u} ℤ_[ℓ])) ⟶
      sfbCoefficientQuotientTower ℤ_[ℓ]
        (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ⋙ sfbPointConstantRing :=
  (pur_normalized_reduction_cone.{u} ℓ).choose

/-- The normalized identification of the integral quotient tower with the `ZMod` tower.
The comparison theorem fixes every component on every quotient class.
Source: completed-coefficient proposition, final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlResidueTowerIso (ℓ : ℕ) [Fact ℓ.Prime] :
    sfbCoefficientQuotientTower ℤ_[ℓ]
      (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ≅ sfbZModCoefficientTower.{u} ℓ :=
  (sfb_completed_coefficients.{u} ℓ).2.2.1.choose

/-- Pullback of the finite constant quotient tower to `X`. This is the ring comparison
from the integral-limit theorem, not a choice of an unstructured sheaf isomorphism.
Each finite quotient is a cyclic ring; its constant sheaf, and its inverse image, are
locally generated by the unit as rings. Consequently a ring comparison between these
constant sheaves is unique, including at exponent zero and on the empty scheme.
Source: completed-coefficient proposition, integral comparison
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlConstantPullbackIso (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) :
    (sfbCoefficientQuotientTower ℤ_[ℓ]
      (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ⋙ sfbPointConstantRing ⋙
        (upperStarFromPoint X).mapMon) ≅
      (sfbCoefficientQuotientTower ℤ_[ℓ]
        (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ⋙ sfbConstantRing X) :=
  ((sfb_completed_coefficients.{u} ℓ).2.1.choose_spec.2.1 X).2.some

/-- The canonical reduction `ρ_r`: pull back the normalized integral-limit projection,
identify the pulled-back finite constant ring, then use its normalized `ZMod` presentation.
These are precisely the projections of the integral comparison at `E = ℚ_[ℓ]`.
Source: completed-coefficient proposition, final paragraph; Tate twists, integral comparison
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlReduction (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) (r : ℕ) :
    coefficientRing X (Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ])) ⟶
      (sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r)) :=
  (upperStarFromPoint X).mapMon.map ((purZlPointReduction ℓ).app (op r)) ≫
    (purZlConstantPullbackIso ℓ X).hom.app (op r) ≫
      (sfbConstantRing X).map ((purZlResidueTowerIso ℓ).hom.app (op r))

/-- Multiplication by `ℓ^r` on the regular module of the pulled-back condensed integers.
Source: Tate twists, integral coefficient comparison, image ideal `ℓ^r R_X`
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlPowerMultiplication (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (r : ℕ) :=
  ℓ ^ r • 𝟙 (Mod.regular (condensedRingObj (Profinite.continuousMapRingObj ℤ_[ℓ]) X))

/-- The sheaf quotient by the image ideal of multiplication by `ℓ^r`, computed as the
cokernel in modules, whose underlying abelian sheaf is also the sheaf cokernel.
Source: Tate twists, integral coefficient comparison; Stacks, Tag 00WH
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlQuotient (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) (r : ℕ) :=
  Mod.cokernelObj (purZlPowerMultiplication ℓ X r)

/-- The quotient projection, with its actual induced `R_X`-module structure.
Source: Tate twists, integral coefficient comparison; Stacks, Tag 00WH
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlQuotientProjection (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (r : ℕ) :=
  Mod.cokernelπ (purZlPowerMultiplication ℓ X r)

/-- The finite residue sheaf with scalar action through the canonical reduction `ρ_r`.
Source: Tate twists, integral coefficient comparison, module assertion
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlResidueModule (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) (r : ℕ) :=
  (Mod.comap (purZlReduction ℓ X r).hom).obj
    (Mod.regular ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r))).X)

private instance purPowNeZero (ℓ : ℕ) [Fact ℓ.Prime] (r : ℕ) : NeZero (ℓ ^ r) :=
  ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩

private theorem purContinuousDivide (ℓ : ℕ) [Fact ℓ.Prime] (r : ℕ)
    (S : Profinite.{u}) (x : C(S, ℤ_[ℓ]))
    (hx : ∀ t, PadicInt.toZModPow r (x t) = 0) :
    ∃ y : C(S, ℤ_[ℓ]), ∀ t, (ℓ ^ r) • y t = x t := by
  classical
  let a : ℤ_[ℓ] := (ℓ : ℤ_[ℓ]) ^ r
  have ha : a ≠ 0 := pow_ne_zero _ (PadicInt.irreducible_p (p := ℓ)).ne_zero
  let f : ℤ_[ℓ] → ℤ_[ℓ] := fun z ↦ a * z
  have hf : Topology.IsEmbedding f :=
    (continuous_const.mul continuous_id).isClosedEmbedding
      (fun z w h ↦ mul_left_cancel₀ ha h) |>.isEmbedding
  have hr (t : S) : x t ∈ Set.range f := by
    have h : x t ∈ RingHom.ker (PadicInt.toZModPow r) := hx t
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton] at h
    obtain ⟨y, hy⟩ := h
    exact ⟨y, hy.symm⟩
  let g : C(S, Set.range f) := ⟨fun t ↦ ⟨x t, hr t⟩,
    continuous_induced_rng.mpr x.continuous⟩
  refine ⟨(⟨hf.toHomeomorph.symm, hf.toHomeomorph.symm.continuous⟩ :
    C(Set.range f, ℤ_[ℓ])).comp g, fun t ↦ ?_⟩
  have h := congrArg Subtype.val (hf.toHomeomorph.apply_symm_apply (g t))
  change a * (hf.toHomeomorph.symm (g t)) = x t at h
  simpa only [a, nsmul_eq_mul, Nat.cast_pow, ContinuousMap.comp_apply,
    ContinuousMap.coe_mk] using h

private theorem purContinuousCokernel (ℓ : ℕ) [Fact ℓ.Prime] (r : ℕ) :
    ∃ h : (ℓ ^ r • 𝟙 (Profinite.continuousMapRingObj.{u} ℤ_[ℓ])) ≫
        (sheafCompose _ (forget₂ RingCat.{u + 1} Ab.{u + 1})).map
          (Profinite.continuousMapRingSheafMap (PadicInt.toZModPow r)
            (PadicInt.continuous_toZModPow r)) = 0,
      Nonempty (IsColimit (CokernelCofork.ofπ
        ((sheafCompose _ (forget₂ RingCat.{u + 1} Ab.{u + 1})).map
          (Profinite.continuousMapRingSheafMap (PadicInt.toZModPow r)
            (PadicInt.continuous_toZModPow r))) h)) := by
  classical
  let R := Profinite.continuousMapRingObj.{u} ℤ_[ℓ]
  let Q := Profinite.continuousMapRingObj.{u} (ZMod (ℓ ^ r))
  let p : R ⟶ Q := (sheafCompose _ (forget₂ RingCat.{u + 1} Ab.{u + 1})).map
    (Profinite.continuousMapRingSheafMap (PadicInt.toZModPow r)
      (PadicInt.continuous_toZModPow r))
  have h : (ℓ ^ r • 𝟙 R) ≫ p = 0 := by
    apply Sheaf.hom_ext
    ext S x
    apply ULift.ext
    ext t
    change PadicInt.toZModPow r ((ℓ ^ r) • x.down t) = 0
    rw [map_nsmul, nsmul_eq_mul]
    simp
  refine ⟨h, ⟨?_⟩⟩
  apply isColimitOfReflects (sheafToPresheaf _ Ab.{u + 1})
  refine (CokernelCofork.isColimitMapCoconeEquiv _ _).symm ?_
  apply evaluationJointlyReflectsColimits
  intro S
  refine (CokernelCofork.isColimitMapCoconeEquiv _ _).symm ?_
  let f : R.obj.obj S ⟶ R.obj.obj S := (ℓ ^ r • 𝟙 R).hom.app S
  let g : R.obj.obj S ⟶ Q.obj.obj S := p.hom.app S
  have hg : Function.Surjective g := by
    intro x
    let q := PadicInt.toZModPow (p := ℓ) r
    let lift : ZMod (ℓ ^ r) → ℤ_[ℓ] := fun z ↦ (ZMod.ringHom_surjective q z).choose
    refine ⟨ULift.up ((⟨lift, continuous_of_discreteTopology⟩ :
      C(ZMod (ℓ ^ r), ℤ_[ℓ])).comp x.down), ?_⟩
    apply ULift.ext
    ext t
    exact (ZMod.ringHom_surjective q (x.down t)).choose_spec
  letI : Epi g := (AddCommGrpCat.epi_iff_surjective g).mpr hg
  have hw : f ≫ g = 0 := congrArg (fun k ↦ k.hom.app S) h
  let sc := ShortComplex.mk f g hw
  have he : sc.Exact := sc.ab_exact_iff.mpr (by
    intro x hx
    have hx' (t : S.unop) : PadicInt.toZModPow r (x.down t) = 0 :=
      congrArg (fun z : ULift.{u + 1} C(S.unop, ZMod (ℓ ^ r)) ↦ z.down t) hx
    obtain ⟨y, hy⟩ := purContinuousDivide ℓ r S.unop x.down hx'
    refine ⟨ULift.up y, ?_⟩
    apply ULift.ext
    exact ContinuousMap.ext hy)
  exact he.gIsCokernel

private theorem purPointMap_ext (ℓ : ℕ) [Fact ℓ.Prime] (r : ℕ)
    (g : Profinite.continuousMapRingObj.{u} ℤ_[ℓ] ⟶
      Profinite.continuousMapRingObj.{u} (ZMod (ℓ ^ r)))
    (hg : sfbConstantToContinuous ℤ_[ℓ] ≫ g =
      (constantSheaf (coherentTopology Profinite.{u}) Ab.{u + 1}).map
        (AddCommGrpCat.ofHom
          (ULift.ringEquiv.symm.toRingHom.comp
            ((PadicInt.toZModPow r).comp ULift.ringEquiv.toRingHom)).toAddMonoidHom) ≫
        sfbConstantToContinuous (ZMod (ℓ ^ r))) :
    g = (sheafCompose _ (forget₂ RingCat.{u + 1} Ab.{u + 1})).map
      (Profinite.continuousMapRingSheafMap (PadicInt.toZModPow r)
        (PadicInt.continuous_toZModPow r)) := by
  apply Sheaf.hom_ext
  ext S x
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  let P : Profinite.{u} := Profinite.of PUnit
  let c : P ⟶ S.unop := CompHausLike.ofHom _ ⟨fun _ ↦ t, continuous_const⟩
  have hn := ConcreteCategory.congr_hom (g.hom.naturality c.op) x
  have he := congrArg (fun h ↦ (h.hom.app (op P))
    ((toSheafify (coherentTopology Profinite.{u})
      ((Functor.const Profinite.{u}ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u + 1} ℤ_[ℓ])))).app (op P) (ULift.up (x.down t)))) hg
  have hc : (Profinite.continuousMapRingObj ℤ_[ℓ]).obj.map c.op x =
      ULift.up (ContinuousMap.const P (x.down t)) := by
    apply ULift.ext
    ext y
    rfl
  change g.hom.app (op P) ((Profinite.continuousMapRingObj ℤ_[ℓ]).obj.map c.op x) =
    (Profinite.continuousMapRingObj (ZMod (ℓ ^ r))).obj.map c.op (g.hom.app S x) at hn
  rw [hc] at hn
  have hconst (R : Type) [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
      (z : R) :
      (sfbConstantToContinuous R).hom.app (op P)
        ((toSheafify (coherentTopology Profinite.{u})
          ((Functor.const Profinite.{u}ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u + 1} R)))).app (op P) (ULift.up z)) =
        ULift.up (ContinuousMap.const P z) := by
    have h := ((sheafificationAdjunction (coherentTopology Profinite.{u})
      Ab.{u + 1}).homEquiv
      ((Functor.const Profinite.{u}ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u + 1} R)))
      (Profinite.continuousMapRingObj.{u} R)).apply_symm_apply
      (show (Functor.const Profinite.{u}ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u + 1} R)) ⟶
        (Profinite.continuousMapRingObj.{u} R).obj from
        { app S := AddCommGrpCat.ofHom
            { toFun := fun x ↦ ULift.up (ContinuousMap.const S.unop x.down)
              map_zero' := rfl
              map_add' := fun _ _ ↦ rfl }
          naturality := fun _ _ _ ↦ rfl })
    exact congrArg (fun k ↦ (k.app (op P)).hom (ULift.up z)) h
  change g.hom.app (op P) ((sfbConstantToContinuous ℤ_[ℓ]).hom.app (op P) _) =
    (sfbConstantToContinuous (ZMod (ℓ ^ r))).hom.app (op P)
      (((constantSheaf (coherentTopology Profinite.{u}) Ab.{u + 1}).map _).hom.app
        (op P) _) at he
  rw [hconst] at he
  let q : AddCommGrpCat.of (ULift.{u + 1} ℤ_[ℓ]) ⟶
      AddCommGrpCat.of (ULift.{u + 1} (ZMod (ℓ ^ r))) := AddCommGrpCat.ofHom
    (ULift.ringEquiv.symm.toRingHom.comp
      ((PadicInt.toZModPow (p := ℓ) r).comp ULift.ringEquiv.toRingHom)).toAddMonoidHom
  have hnat := toSheafify_naturality (coherentTopology Profinite.{u})
    ((Functor.const Profinite.{u}ᵒᵖ).map q)
  have hnat' := congrArg (fun k ↦ (k.app (op P)).hom (ULift.up (x.down t))) hnat
  change (toSheafify (coherentTopology Profinite.{u})
      ((Functor.const Profinite.{u}ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u + 1} (ZMod (ℓ ^ r)))))).app (op P)
        (ULift.up (PadicInt.toZModPow r (x.down t))) =
    (((constantSheaf (coherentTopology Profinite.{u}) Ab.{u + 1}).map _).hom.app
      (op P) _) at hnat'
  have he' : g.hom.app (op P) (ULift.up (ContinuousMap.const P (x.down t))) =
      (sfbConstantToContinuous (ZMod (ℓ ^ r))).hom.app (op P)
        ((toSheafify (coherentTopology Profinite.{u})
          ((Functor.const Profinite.{u}ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u + 1} (ZMod (ℓ ^ r)))))).app (op P)
          (ULift.up (PadicInt.toZModPow r (x.down t)))) :=
    he.trans (congrArg
      (fun z ↦ (sfbConstantToContinuous (ZMod (ℓ ^ r))).hom.app (op P) z) hnat'.symm)
  rw [hconst] at he'
  have h := congrArg (fun z : ULift.{u + 1} C(P, ZMod (ℓ ^ r)) ↦ z.down PUnit.unit)
    (hn.symm.trans he')
  exact h

private instance purFiniteConstantIsIso (R : Type) [CommRing R]
    [TopologicalSpace R] [IsTopologicalRing R] [DiscreteTopology R] [Finite R] :
    IsIso (sfbConstantToContinuous.{u} R) := by
  change IsIso (completedFinitePointIso.{u} R).hom
  infer_instance

private noncomputable def purFinitePointIso (R : Type) [CommRing R]
    [TopologicalSpace R] [IsTopologicalRing R] [DiscreteTopology R] [Finite R] :
    (sfbPointConstantRing.obj (RingCat.of (ULift.{u + 1} R))).X ≅
      Profinite.continuousMapRingObj R :=
  asIso (sfbConstantToContinuous R)

private theorem purResidueComposite (ℓ : ℕ) [Fact ℓ.Prime] (r : ℕ) :
    AddCommGrpCat.ofHom
        (ULift.ringEquiv.symm.toRingHom.comp
          ((Ideal.Quotient.mk (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ]) ^ r)).comp
            ULift.ringEquiv.toRingHom)).toAddMonoidHom ≫
      (RingCat.toMonAb.map ((purZlResidueTowerIso.{u} ℓ).hom.app (op r))).hom =
    AddCommGrpCat.ofHom
      (ULift.ringEquiv.symm.toRingHom.comp
        ((PadicInt.toZModPow (p := ℓ) r).comp
          ULift.ringEquiv.toRingHom)).toAddMonoidHom := by
  ext x
  obtain ⟨x⟩ := x
  exact (sfb_completed_coefficients.{u} ℓ).2.2.1.choose_spec r x

private theorem purFinitePointIso_hom (R : Type) [CommRing R]
    [TopologicalSpace R] [IsTopologicalRing R] [DiscreteTopology R] [Finite R] :
    (purFinitePointIso.{u} R).hom = sfbConstantToContinuous R := rfl

attribute [local irreducible] purZlResidueTowerIso
  purFinitePointIso sfbConstantToContinuous

private theorem purPointReduction_normalized (ℓ : ℕ) [Fact ℓ.Prime] (r : ℕ) :
    ((purZlPointReduction ℓ).app (op r)).hom ≫
        (sfbPointConstantRing.map ((purZlResidueTowerIso.{u} ℓ).hom.app (op r))).hom ≫
          (purFinitePointIso.{u} (ZMod (ℓ ^ r))).hom =
      (sheafCompose _ (forget₂ RingCat.{u + 1} Ab.{u + 1})).map
        (Profinite.continuousMapRingSheafMap (PadicInt.toZModPow r)
          (PadicInt.continuous_toZModPow r)) := by
  apply purPointMap_ext
  have hn := (pur_normalized_reduction_cone.{u} ℓ).choose_spec r
  rw [purZlPointReduction.eq_def]
  rw [← Category.assoc, ← Category.assoc, hn]
  let C := constantSheaf (coherentTopology Profinite.{u}) Ab.{u + 1}
  change (C.map _ ≫ C.map _) ≫ _ = C.map _ ≫ _
  rw [← C.map_comp, purResidueComposite, purFinitePointIso_hom]

private theorem purReductionCokernel (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (r : ℕ) :
    ∃ h : (purZlPowerMultiplication ℓ X r).hom ≫ (purZlReduction ℓ X r).hom = 0,
      Nonempty (IsColimit (CokernelCofork.ofπ (purZlReduction ℓ X r).hom h)) := by
  classical
  let F := upperStarFromPoint X
  let R := Profinite.continuousMapRingObj.{u} ℤ_[ℓ]
  let A := (sfbPointConstantRing.obj
    ((sfbCoefficientQuotientTower ℤ_[ℓ] (Ideal.span {(ℓ : ℤ_[ℓ])})).obj (op r))).X
  let Q := Profinite.continuousMapRingObj.{u} (ZMod (ℓ ^ r))
  let d : A ≅ Q :=
    (Mon.forget _).mapIso (sfbPointConstantRing.mapIso
      ((purZlResidueTowerIso ℓ).app (op r))) ≪≫
        purFinitePointIso (ZMod (ℓ ^ r))
  let ρ : R ⟶ A := ((purZlPointReduction ℓ).app (op r)).hom
  have hn : ρ ≫ d.hom = _ := purPointReduction_normalized ℓ r
  obtain ⟨hz, ⟨hc⟩⟩ := purContinuousCokernel.{u} ℓ r
  have hρ : (ℓ ^ r • 𝟙 R) ≫ ρ = 0 := by
    rw [← cancel_mono d.hom, Category.assoc, hn, hz, zero_comp]
  let hcρ := IsCokernel.ofIso _ hc (CokernelCofork.ofπ ρ hρ)
    (Iso.refl _) (Iso.refl _) d.symm (by simp) (by simp [← hn])
  have : F.IsLeftAdjoint := by
    unfold F upperStarFromPoint
    exact (pointUpperStarLowerStarAdjunction.comp
      (ProEtale.upperStarLowerStarAdjunction Ab.{u + 1} (toSpecZ X))).isLeftAdjoint
  have : PreservesBinaryBiproducts F :=
    preservesBinaryBiproducts_of_preservesBinaryCoproducts F
  have : F.Additive := Functor.additive_of_preservesBinaryBiproducts F
  let hcF := CokernelCofork.mapIsColimit _ hcρ F
  let e : F.obj A ≅ ((sfbConstantRing X).obj
      ((sfbZModCoefficientTower ℓ).obj (op r))).X :=
    (Mon.forget _).mapIso ((purZlConstantPullbackIso ℓ X).app (op r)) ≪≫
      (Mon.forget _).mapIso ((sfbConstantRing X).mapIso
        ((purZlResidueTowerIso ℓ).app (op r)))
  have he : F.map ρ ≫ e.hom = (purZlReduction ℓ X r).hom := rfl
  have hf : F.map (ℓ ^ r • 𝟙 R) = (purZlPowerMultiplication ℓ X r).hom := by
    change F.map (ℓ ^ r • 𝟙 R) = ℓ ^ r • 𝟙 (F.obj R)
    exact (F.map_nsmul).trans (congrArg (fun k ↦ ℓ ^ r • k) (F.map_id R))
  have hz' : (purZlPowerMultiplication ℓ X r).hom ≫ (purZlReduction ℓ X r).hom = 0 := by
    rw [← hf, ← he, ← Category.assoc, ← F.map_comp, hρ, F.map_zero, zero_comp]
  exact ⟨hz', ⟨IsCokernel.ofIso _ hcF (CokernelCofork.ofπ _ hz')
    (Iso.refl _) (Iso.refl _) e (by simpa using hf.symm) (by simpa using he.symm)⟩⟩

private theorem purZlReduction_naturality (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (a b : ℕᵒᵖ) (f : a ⟶ b) :
    purZlReduction ℓ X a.unop ≫
        (sfbZModCoefficientTower ℓ ⋙ sfbConstantRing X).map f =
      purZlReduction ℓ X b.unop := by
  let P := (upperStarFromPoint X).mapMon
  let C := sfbConstantRing X
  let e := purZlConstantPullbackIso ℓ X
  let d := purZlResidueTowerIso ℓ
  have hρ := (purZlPointReduction ℓ).naturality f
  erw [Category.id_comp] at hρ
  have he := e.hom.naturality f
  have hd := d.hom.naturality f
  change P.map ((purZlPointReduction ℓ).app a) ≫ e.hom.app a ≫
      C.map (d.hom.app a) ≫ C.map ((sfbZModCoefficientTower ℓ).map f) =
    P.map ((purZlPointReduction ℓ).app b) ≫ e.hom.app b ≫ C.map (d.hom.app b)
  rw [← C.map_comp, ← hd, C.map_comp]
  change P.map _ ≫ e.hom.app b = e.hom.app a ≫ C.map _ at he
  rw [← reassoc_of% he, ← P.map_comp_assoc]
  change (purZlPointReduction ℓ).app b = (purZlPointReduction ℓ).app a ≫
    sfbPointConstantRing.map ((sfbCoefficientQuotientTower ℤ_[ℓ]
      (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ]))).map f) at hρ
  rw [← hρ]

attribute [local irreducible] purZlConstantPullbackIso purZlReduction

private theorem purAbstractQuotientComparison
    {C : Type*} [Category C] [MonoidalCategory C] [Preadditive C]
    [MonoidalPreadditive C] (R B : Mon C)
    [PreservesFiniteColimits (tensorLeft R.X)]
    (f : Mod.regular R.X ⟶ Mod.regular R.X) [HasCokernel f.hom]
    (ρ : R ⟶ B) (hz : f.hom ≫ ρ.hom = 0)
    (hc : IsColimit (CokernelCofork.ofπ ρ.hom hz)) :
    ∃ (m : MonObj (Mod.cokernelObj f).X)
      (e : Mod.cokernelObj f ≅ (Mod.comap ρ.hom).obj (Mod.regular B.X)),
      @IsMonHom _ _ _ _ _ R.mon m (Mod.cokernelπ f).hom ∧
      @IsMonHom _ _ _ _ _ m B.mon e.hom.hom ∧
      @IsMonHom _ _ _ _ _ B.mon m e.inv.hom ∧
      (Mod.cokernelπ f).hom ≫ e.hom.hom = ρ.hom := by
  classical
  let e : (Mod.cokernelObj f).X ≅ B.X :=
    (cokernelIsCokernel f.hom).coconePointUniqueUpToIso hc
  have hp : cokernel.π f.hom ≫ e.hom = ρ.hom :=
    (cokernelIsCokernel f.hom).comp_coconePointUniqueUpToIso_hom hc
      WalkingParallelPair.one
  have hl : Mod.act (Mod.cokernelObj f).X ≫ e.hom =
      R.X ◁ e.hom ≫ Mod.act ((Mod.comap ρ.hom).obj (Mod.regular B.X)).X := by
    apply Cofork.IsColimit.hom_ext (Mod.isColimitWhiskerLeftCokernel f)
    change (R.X ◁ cokernel.π f.hom) ≫ Mod.cokernelSMul f ≫ e.hom =
      (R.X ◁ cokernel.π f.hom) ≫ R.X ◁ e.hom ≫ ρ.hom ▷ B.X ≫ MonObj.mul
    rw [Mod.π_cokernelSMul_assoc, hp]
    rw [← whiskerLeft_comp_assoc, hp]
    change MonObj.mul ≫ ρ.hom =
      R.X ◁ ρ.hom ≫ ρ.hom ▷ _ ≫ MonObj.mul
    simpa only [MonoidalCategory.tensorHom_def', Category.assoc] using
      IsMonHom.mul_hom ρ.hom
  let em : Mod.cokernelObj f ≅ (Mod.comap ρ.hom).obj (Mod.regular B.X) :=
    Mod.isoMk e hl
  let m : MonObj (Mod.cokernelObj f).X := MonObj.ofIso e.symm
  have hi : IsMonHom e.inv := isMonHom_ofIso e.symm
  have hh : IsMonHom e.hom := inferInstanceAs (IsMonHom e.symm.inv)
  refine ⟨m, em, ?_, hh, hi, hp⟩
  have hπ : (Mod.cokernelπ f).hom = ρ.hom ≫ e.inv := by
    change cokernel.π f.hom = ρ.hom ≫ e.inv
    exact (Iso.eq_comp_inv e).mpr hp
  rw [hπ]
  infer_instance

private theorem purQuotientComparison (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (r : ℕ) :
    ∃ (m : MonObj (purZlQuotient ℓ X r).X)
      (e : purZlQuotient ℓ X r ≅ purZlResidueModule ℓ X r),
      @IsMonHom _ _ _ _ _
        (coefficientRing X (Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ]))).mon
        m (purZlQuotientProjection ℓ X r).hom ∧
      @IsMonHom _ _ _ _ _ m
        ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r))).mon
        e.hom.hom ∧
      @IsMonHom _ _ _ _ _
        ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r))).mon
        m e.inv.hom ∧
      (purZlQuotientProjection ℓ X r).hom ≫ e.hom.hom = (purZlReduction ℓ X r).hom := by
  obtain ⟨hz, ⟨hc⟩⟩ := purReductionCokernel ℓ X r
  exact purAbstractQuotientComparison
    (coefficientRing X (Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ])))
    ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r)))
    (purZlPowerMultiplication ℓ X r)
    (purZlReduction ℓ X r) hz hc

private theorem purAbstractQuotientTransition
    {C : Type*} [Category C] [MonoidalCategory C] [Preadditive C]
    [MonoidalPreadditive C] (R : C) [MonObj R]
    [PreservesFiniteColimits (tensorLeft R)]
    (M : Mod C R) (f g : M ⟶ M) [HasCokernel f.hom] [HasCokernel g.hom]
    (a : ℕ) (hfg : f = a • g)
    {A B : C} (ef : (Mod.cokernelObj f).X ⟶ A)
    (eg : (Mod.cokernelObj g).X ⟶ B) (u : A ⟶ B)
    (hρ : (Mod.cokernelπ f).hom ≫ ef ≫ u = (Mod.cokernelπ g).hom ≫ eg) :
    ∃ t : Mod.cokernelObj f ⟶ Mod.cokernelObj g,
      Mod.cokernelπ f ≫ t = Mod.cokernelπ g ∧ t.hom ≫ eg = ef ≫ u := by
  have hz : f ≫ Mod.cokernelπ g = 0 := by
    rw [hfg, Preadditive.nsmul_comp]
    have hg : g ≫ Mod.cokernelπ g = 0 := (Mod.cokernelCofork g).condition
    rw [hg, nsmul_zero]
  let hc := Mod.isColimitCokernelCofork f
  let t := hc.desc (CokernelCofork.ofπ (Mod.cokernelπ g) hz)
  have ht : Mod.cokernelπ f ≫ t = Mod.cokernelπ g :=
    hc.fac (CokernelCofork.ofπ (Mod.cokernelπ g) hz) WalkingParallelPair.one
  refine ⟨t, ht, ?_⟩
  apply Cofork.IsColimit.hom_ext (cokernelIsCokernel f.hom)
  change (Mod.cokernelπ f).hom ≫ t.hom ≫ eg = _
  rw [← Category.assoc, ← Mod.comp_hom', ht]
  exact hρ.symm

/-- Reduction identifies the sheaf quotient by `ℓ^r` with the finite constant residue
sheaf, as rings and as modules over the pulled-back condensed integers, compatibly at
all positive exponents. `n + 1` ranges over exactly the positive integers.
The ring structures below are quotient-ring structures, since their projections are
ring maps; the projection is epimorphic, so this characterizes their operations.

Source: blueprint main-20261015, Tate twists, integral coefficient comparison, and
completed-coefficient proposition, final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power).

Proof:
1. Normalize the point reduction on constants using the completed-coefficient comparison.
   Naturality along maps from a singleton identifies it on all continuous functions
   with postcomposition by the usual `PadicInt.toZModPow`.
2. On every profinite set, finite residue-valued continuous functions lift by choosing
   representatives of the finite discrete target. A continuous function in the kernel
   divides continuously by `ℓ^r`: multiplication by this nonzero scalar embeds the
   compact Hausdorff ring of integers, so its inverse on its image is continuous.
   The kernel calculation is `PadicInt.ker_toZModPow`. Thus reduction is a cokernel
   objectwise in abelian groups, hence in presheaves and condensed abelian sheaves.
3. Inverse image from the point is a left adjoint and preserves this cokernel.
   Transport along the specified finite-constant comparisons gives exactly `purZlReduction`.
4. Uniqueness of cokernels gives the comparison isomorphism. Cancel the cokernel
   projection after tensoring with the scalar ring to verify linearity, using the
   module cokernel action and multiplicativity of reduction. Transport the residue
   ring structure along this isomorphism. Its projection is a ring map because
   reduction is, and both comparison directions are ring maps.
5. Naturality of the three comparison maps gives compatibility of reductions.
   The module cokernel universal property constructs successive quotient transitions;
   cancelling the quotient projection proves their compatibility with the comparisons.
-/
theorem pur_condensed_zl_reduction_mod_ell_power (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) :
    ∃ (m : ∀ n : ℕ, MonObj (purZlQuotient ℓ X (n + 1)).X)
      (e : ∀ n : ℕ, purZlQuotient ℓ X (n + 1) ≅ purZlResidueModule ℓ X (n + 1)),
      (∀ n : ℕ,
        @IsMonHom _ _ _ _ _
          (coefficientRing X (Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ]))).mon
          (m n) (purZlQuotientProjection ℓ X (n + 1)).hom ∧
        @IsMonHom _ _ _ _ _ (m n)
          ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op (n + 1)))).mon
          (e n).hom.hom ∧
        @IsMonHom _ _ _ _ _
          ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op (n + 1)))).mon
          (m n) (e n).inv.hom ∧
        (purZlQuotientProjection ℓ X (n + 1)).hom ≫ (e n).hom.hom =
          (purZlReduction ℓ X (n + 1)).hom) ∧
      (∀ n : ℕ,
        purZlReduction ℓ X (n + 2) ≫
          (sfbZModCoefficientTower ℓ ⋙ sfbConstantRing X).map
            (homOfLE (Nat.le_succ (n + 1))).op = purZlReduction ℓ X (n + 1)) ∧
      (∀ n : ℕ, ∃ t : purZlQuotient ℓ X (n + 2) ⟶ purZlQuotient ℓ X (n + 1),
        purZlQuotientProjection ℓ X (n + 2) ≫ t = purZlQuotientProjection ℓ X (n + 1) ∧
        t.hom ≫ (e n).hom.hom =
          (e (n + 1)).hom.hom ≫
            ((sfbZModCoefficientTower ℓ ⋙ sfbConstantRing X).map
              (homOfLE (Nat.le_succ (n + 1))).op).hom) := by
  classical
  choose m e he using fun n ↦ purQuotientComparison ℓ X (n + 1)
  refine ⟨m, e, he, ?_, ?_⟩
  · intro n
    exact purZlReduction_naturality ℓ X _ _ (homOfLE (Nat.le_succ (n + 1))).op
  · intro n
    have hfg : purZlPowerMultiplication ℓ X (n + 2) =
        ℓ • purZlPowerMultiplication ℓ X (n + 1) := by
      dsimp only [purZlPowerMultiplication]
      rw [← mul_nsmul, ← pow_succ]
    refine purAbstractQuotientTransition
      (condensedRingObj (Profinite.continuousMapRingObj ℤ_[ℓ]) X)
      (Mod.regular (condensedRingObj (Profinite.continuousMapRingObj ℤ_[ℓ]) X))
      (purZlPowerMultiplication ℓ X (n + 2))
      (purZlPowerMultiplication ℓ X (n + 1)) ℓ hfg
      (e (n + 1)).hom.hom (e n).hom.hom
      (((sfbZModCoefficientTower ℓ ⋙ sfbConstantRing X).map
        (homOfLE (Nat.le_succ (n + 1))).op).hom) ?_
    change (purZlQuotientProjection ℓ X (n + 2)).hom ≫ (e (n + 1)).hom.hom ≫ _ =
      (purZlQuotientProjection ℓ X (n + 1)).hom ≫ (e n).hom.hom
    rw [← Category.assoc, (he (n + 1)).2.2.2, (he n).2.2.2]
    exact congrArg Mon.Hom.hom
      (purZlReduction_naturality ℓ X _ _
        (homOfLE (Nat.le_succ (n + 1))).op)

