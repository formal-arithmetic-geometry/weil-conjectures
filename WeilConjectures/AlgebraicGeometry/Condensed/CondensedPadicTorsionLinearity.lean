/-! # Automatic linearity for bounded torsion condensed coefficient modules

Source: diagonal coefficient changes (1), integer generation of finite cyclic quotients.
(blueprint: lem-condensed-padic-torsion-linearity).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option Elab.async false
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory MonObj Opposite
open scoped CategoryTheory.Obj CategoryTheory.Functor
namespace AlgebraicGeometry.ProEtale

attribute [local instance 200000] diagonalAbSheafAbelian
attribute [local instance] Sheaf.monoidalCategory Sheaf.braidedCategory

private theorem cyclic_unit_epi (X : Scheme.{u}) (N : ℕ) :
    Epi η[((sfbConstantRing X).obj (RingCat.of (ULift.{u + 1} (ZMod N)))).X] := by
  let F := constantSheaf (Scheme.ProEt.topology X) Ab.{u + 1}
  have hu : Epi η[AddCommGrpCat.of (ULift.{u + 1} (ZMod N))] := by
    apply (AddCommGrpCat.epi_iff_surjective _).mpr
    intro x
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective x.down
    refine ⟨ULift.up z, ?_⟩
    change ULift.up (z : ZMod N) = x
    exact ULift.ext hz
  change Epi (Functor.LaxMonoidal.ε F ≫
    F.map η[AddCommGrpCat.of (ULift.{u + 1} (ZMod N))])
  infer_instance

private theorem epi_unit_and_power (l : ℕ) [Fact l.Prime] (X : Scheme.{u}) (r : ℕ) :
    Epi (biprod.desc η[condensedRingObj (Profinite.continuousMapRingObj.{u} ℤ_[l]) X]
      ((l ^ r) • 𝟙 (condensedRingObj (Profinite.continuousMapRingObj.{u} ℤ_[l]) X))) := by
  obtain ⟨hz, ⟨hc⟩⟩ := purReductionCokernel l X r
  let ρ := (purZlReduction l X r).hom
  have hu : Epi η[((sfbConstantRing X).obj
      ((sfbZModCoefficientTower l).obj (op r))).X] := cyclic_unit_epi X (l ^ r)
  apply (Preadditive.epi_iff_cancel_zero _).mpr
  intro T f hf
  have hpow : ((l ^ r) • 𝟙 _) ≫ f = 0 := by
    have h := congrArg (fun k ↦ biprod.inr ≫ k) hf
    simpa only [← Category.assoc, biprod.inr_desc, comp_zero] using h
  have hone : η[condensedRingObj (Profinite.continuousMapRingObj.{u} ℤ_[l]) X] ≫ f = 0 := by
    have h := congrArg (fun k ↦ biprod.inl ≫ k) hf
    simpa only [← Category.assoc, biprod.inl_desc, comp_zero] using h
  let g := hc.desc (CokernelCofork.ofπ f hpow)
  have hg : ρ ≫ g = f := hc.fac (CokernelCofork.ofπ f hpow) WalkingParallelPair.one
  have hg0 : g = 0 := by
    apply (cancel_epi η[((sfbConstantRing X).obj
      ((sfbZModCoefficientTower l).obj (op r))).X]).mp
    rw [comp_zero, ← IsMonHom.one_hom ρ, Category.assoc, hg, hone]
  rw [← hg, hg0, comp_zero]

/-- Any additive sheaf map into a module killed by a power of `l` is linear over
pulled-back condensed `l`-adic integers.

Source: diagonal coefficient changes (1); the integer-generation argument of
`padicInt_act_comp_eq_of_zsmul_eq_zero`, transported using the actual condensed
reduction cokernel. (blueprint: lem-condensed-padic-torsion-linearity).
Proof: reduction modulo `l^r` is the cokernel of multiplication by `l^r` and its
constant cyclic target is generated by its unit. Hence the unit and multiplication
by `l^r` jointly cover the integral coefficient ring. Tensor this epimorphism with
the source module. The defect of linearity vanishes on the unit by the module unit
law and on the other summand because the target is killed by `l^r`. -/
theorem condensedPadicTorsionLinearity (l : ℕ) [Fact l.Prime] (X : Scheme.{u})
    {M T : DiagonalCoefficients.Modules (Profinite.continuousMapRingObj.{u} ℤ_[l]) X}
    (φ : M.X ⟶ T.X) (r : ℕ) (hT : ((l ^ r : ℕ) : ℤ) • 𝟙 T.X = 0) :
    IsModHom (condensedRingObj (Profinite.continuousMapRingObj.{u} ℤ_[l]) X) φ := by
  constructor
  apply Mod.act_comp_eq_of_epi φ (fun _ : Unit ↦ ((l ^ r : ℕ) : ℤ))
    (fun _ ↦ ?_) (fun _ ↦ 𝟙 T.X) (fun _ ↦ hT)
    (fun f hf ↦ by simpa using hf ())
  have h := epi_unit_and_power l X r
  have h' := Functor.map_epi (tensorRight M.X)
    (biprod.desc η[condensedRingObj (Profinite.continuousMapRingObj.{u} ℤ_[l]) X]
      ((l ^ r) • 𝟙 _))
  dsimp only [tensorRight, Functor.flip, curriedTensor] at h'
  simpa only [natCast_zsmul] using h'

end AlgebraicGeometry.ProEtale
