module

public import WeilConjectures.AlgebraicGeometry.AffineZeroPurity.CoordinateSectionArrows

/-! # Normalized coordinate product presentations

Source: blueprint main-20261015, cor-pur-affine-space-zero-section-purity,
ordered Cartier product and its normalization
(blueprint: def-pur-coordinate-product-presentations).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency true
set_option backward.isDefEq.respectTransparency.types true
set_option synthInstance.maxSize 2048
universe u v w
open CategoryTheory CategoryTheory.Limits MonoidalCategory
open AlgebraicGeometry WeilConjectures
namespace AlgebraicGeometry.ProEtale.AffineZeroPurity
open AffineSpacePurity


private theorem support_factors_iff (B : Scheme.{u}) (c : ℕ)
    {T : Scheme.{u}} (f : T ⟶ iteratedAffineLine B c) (is : List (Fin c)) :
    (∃ g : T ⟶ support B c is, g ≫ supportMap B c is = f) ↔
      ∀ i ∈ is, ∃ g : T ⟶ divisor B c i, g ≫ inclusion B c i = f := by
  induction is with
  | nil =>
    constructor
    · intro h i hi
      cases hi
    · intro h
      exact ⟨f, Category.comp_id f⟩
  | cons i is ih =>
    change (∃ g : T ⟶ pullback (supportMap B c is) (inclusion B c i),
      g ≫ (pullback.fst _ _ ≫ supportMap B c is) = f) ↔ _
    constructor
    · rintro ⟨g, hg⟩ j hj
      rcases List.mem_cons.mp hj with rfl | hj
      · refine ⟨g ≫ pullback.snd _ _, ?_⟩
        rw [Category.assoc, ← pullback.condition, ← Category.assoc]
        exact hg
      · exact ih.mp ⟨g ≫ pullback.fst _ _, by
          simpa only [Category.assoc] using hg⟩ j hj
    · intro h
      obtain ⟨g, hg⟩ := ih.mpr (fun j hj ↦ h j (List.mem_cons_of_mem i hj))
      obtain ⟨k, hk⟩ := h i List.mem_cons_self
      refine ⟨pullback.lift g k (hg.trans hk.symm), ?_⟩
      rw [← Category.assoc, pullback.lift_fst, hg]

/-- A reordered full intersection has its unique identification with the zero
section. Source: proof Step 10 (blueprint: def-pur-coordinate-product-presentations).
Proof: each coordinate occurs exactly once under the permutation, so the quotient
ideal is still generated by all coordinates. Uniqueness follows from the zero
section being a monomorphism, also for the empty permutation. -/
theorem permutedSupportIso_existsUnique (B : Scheme.{u}) (c : ℕ) (σ : Equiv.Perm (Fin c)) :
    ∃! e : support B c ((List.finRange c).map σ) ≅ B,
      e.hom ≫ zero B c = supportMap B c ((List.finRange c).map σ) := by
  have hm : ∀ i : Fin c, i ∈ (List.finRange c).map σ := by
    intro i
    exact List.mem_map.mpr ⟨σ.symm i, List.mem_finRange _, σ.apply_symm_apply i⟩
  obtain ⟨f, hf⟩ := (support_factors_iff B c
    (supportMap B c ((List.finRange c).map σ)) (List.finRange c)).mpr
      (fun i _ ↦ (support_factors_iff B c _ _).mp ⟨𝟙 _, by simp⟩ i (hm i))
  obtain ⟨g, hg⟩ := (support_factors_iff B c
    (supportMap B c (List.finRange c)) ((List.finRange c).map σ)).mpr
      (fun i _ ↦ (support_factors_iff B c _ _).mp ⟨𝟙 _, by simp⟩ i
        (List.mem_finRange i))
  let e : support B c ((List.finRange c).map σ) ≅ support B c (List.finRange c) :=
    { hom := f
      inv := g
      hom_inv_id := by
        apply (cancel_mono (supportMap B c ((List.finRange c).map σ))).mp
        simp only [Category.assoc, hg, hf, Category.id_comp]
      inv_hom_id := by
        apply (cancel_mono (supportMap B c (List.finRange c))).mp
        simp only [Category.assoc, hf, hg, Category.id_comp] }
  obtain ⟨z, hz, _⟩ := supportIso_existsUnique B c
  refine ⟨e ≪≫ z, ?_, ?_⟩
  · change (f ≫ z.hom) ≫ zero B c = _
    rw [Category.assoc, hz, hf]
  · intro e' he'
    apply Iso.ext
    apply (cancel_mono (zero B c)).mp
    rw [he']
    change _ = (f ≫ z.hom) ≫ zero B c
    rw [Category.assoc, hz, hf]

/-- Reorder the already defined supported product and transport its actual total
intersection by the unique map over the affine space. Source: proof Step 10
(blueprint: def-pur-coordinate-product-presentations). -/
@[irreducible]
def permutedClass (P : PurityFiniteSetting.{u}) (n : ℕ) (B : Scheme.{u})
    (aB : B ⟶ Spec (.of P.field.k)) (c : ℕ) (σ : Equiv.Perm (Fin c)) :
    (cupSingle (setting P n) (iteratedAffineLine B c)).obj
      ((lowerStar (ModuleCat.{u + 1} (setting P n).Coefficient) (zero B c)).obj
        ((setting P n).constant B)) ⟶ target P n (iteratedAffineLine B c) c :=
  (cupSingle (setting P n) (iteratedAffineLine B c)).map
      ((setting P n).functorialCupSupportMap true (zero B c)
        (supportMap B c ((List.finRange c).map σ))
        (permutedSupportIso_existsUnique B c σ).exists.choose.hom
        (permutedSupportIso_existsUnique B c σ).exists.choose_spec) ≫
    eqToHom (classSource_eq P n B c ((List.finRange c).map σ)).symm ≫
    product P n B aB c ((List.finRange c).map σ) ≫
    eqToHom (congrArg (target P n (iteratedAffineLine B c))
      ((List.length_map (as := List.finRange c) (f := σ)).trans (@List.length_finRange c)))

/-- Compose two comparisons through their common specified target.
Source: exponent normalization (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateIsoThrough {C : Type v} [Category.{w} C] {M N L : C}
    (e : M ≅ L) (f : N ≅ L) : M ≅ N := e ≪≫ f.symm

/-- Follow an actual factor by its specified comparison.
Source: exponent normalization (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateArrowComparison {C : Type v} [Category.{w} C] {M N L : C}
    (f : M ⟶ N) (e : N ≅ L) : M ⟶ L := f ≫ e.hom

/-- Extract the uniquely prescribed data without converting its large predicate.
Source: endpoint normalization (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateUniqueChoice {T : Sort v} {p : T → Prop} (h : ∃! x, p x) : T :=
  h.exists.choose

/-- The normalized degree-one root comparison at sheaf level.
Source: finite Tate site descent (blueprint: def-pur-coordinate-product-presentations).
Proof: degree one of finiteEtaleTateTwist is finiteEtaleTateLine. Transport the
existing twistComparison along that defining equality; HEq fixes its map uniquely. -/
theorem coordinateRootComparison_existsUnique (l : ℕ) [Fact l.Prime] (E : Type u)
    [Field E] [Algebra (Padic l) E] [FiniteDimensional (Padic l) E] (n : ℕ)
    (X : Scheme.{u}) (hX : IsUnit (l : Γ(X, ⊤))) (r : ℕ)
    (hA : ((l ^ (r + 1) : ℕ) : Scheme.finiteTateCoefficient l E n) = 0) :
    ∃! e : (comparisonUpperStar
        (ModuleCat.{u + 1} (Scheme.finiteTateCoefficient l E n)) X).obj
        (Scheme.finiteEtaleTateLine X (l ^ (r + 1)) _ hA) ≅
        Scheme.finiteTateProSheaf l E n X 1,
      HEq e (VectorIntegrationSite.twistComparison l E n X hX r hA 1) := by
  refine ⟨VectorIntegrationSite.twistComparison l E n X hX r hA 1, HEq.rfl, ?_⟩
  intro e he
  exact eq_of_heq he

/-- The uniquely fixed root comparison, before passing to derived categories.
Source: finite Tate site descent (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateRootComparison (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
    [Algebra (Padic l) E] [FiniteDimensional (Padic l) E] (n : ℕ)
    (X : Scheme.{u}) (hX : IsUnit (l : Γ(X, ⊤))) (r : ℕ)
    (hA : ((l ^ (r + 1) : ℕ) : Scheme.finiteTateCoefficient l E n) = 0) :=
  coordinateUniqueChoice (coordinateRootComparison_existsUnique l E n X hX r hA)

/-- Exact realization of the root comparison, with its shift by two.
Source: exact site comparison (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateRootDerived (V : Type v) [Category.{u + 1} V] [Abelian V]
    [IsGrothendieckAbelian.{u + 1} V] (X : Scheme.{u})
    {L : Sheaf X.smallEtaleTopology V} {M : Sheaf (Scheme.ProEt.topology X) V}
    (e : (comparisonUpperStar V X).obj L ≅ M) :
    (comparisonUpperStar V X).mapDerivedCategory.obj
      (((DerivedCategory.singleFunctor _ 0).obj L)⟦(2 : ℤ)⟧) ≅
      ((DerivedCategory.singleFunctor _ 0).obj M)⟦(2 : ℤ)⟧ :=
  let realize {C D S T : Type (max (u + 1) v)} [Category.{u + 1} C]
      [Category.{u + 1} D] [Category.{u + 1} S] [Category.{u + 1} T]
      [HasShift C ℤ] [HasShift D ℤ] (F : C ⥤ D) [F.CommShift ℤ]
      (s : S ⥤ C) (t : T ⥤ D) (G : S ⥤ T) (ι : s ⋙ F ≅ G ⋙ t)
      {L : S} {M : T} (e : G.obj L ≅ M) :
      F.obj ((s.obj L)⟦(2 : ℤ)⟧) ≅ (t.obj M)⟦(2 : ℤ)⟧ :=
    (F.commShiftIso (2 : ℤ)).app (s.obj L) ≪≫
      (shiftFunctor _ (2 : ℤ)).mapIso (ι.app L ≪≫ t.mapIso e)
  realize (comparisonUpperStar V X).mapDerivedCategory
    (DerivedCategory.singleFunctor _ 0) (DerivedCategory.singleFunctor _ 0)
    (comparisonUpperStar V X)
    ((comparisonUpperStar V X).mapDerivedCategorySingleFunctor 0) e

/-- Transport an actual map along an equality of its endpoint presentation.
Source: endpoint normalization (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateTransport {T U : Sort v} (h : T = U) (x : T) : U := h ▸ x

/-- Realize an ordinary supported arrow and its two specified root comparisons.
Source: exponent normalization (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateRealizeRootBoundary (A : Type (u + 1)) [CommRing A] [Finite A]
    {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (M : Sheaf Z.smallEtaleTopology (ModuleCat.{u + 1} A))
    (L L' : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} A))
    {J : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} A)}
    (α : CategoryTheory.Abelian.Ext
      ((Etale.lowerStar (ModuleCat.{u + 1} A) i).obj M) L 2)
    (e : (comparisonUpperStar (ModuleCat.{u + 1} A) X).obj L ≅ J)
    (e' : (comparisonUpperStar (ModuleCat.{u + 1} A) X).obj L' ≅ J) :
    (DerivedCategory.singleFunctor _ 0).obj
      ((lowerStar (ModuleCat.{u + 1} A) i).obj
        ((comparisonUpperStar (ModuleCat.{u + 1} A) Z).obj M)) ⟶
      (VectorIntegrationSite.comparison A X).obj
        (((DerivedCategory.singleFunctor _ 0).obj L')⟦(2 : ℤ)⟧) :=
  let compare {C D S T : Type (u + 2)} [Category.{u + 1} C]
      [Category.{u + 1} D] [Category.{u + 1} S] [Category.{u + 1} T]
      [HasShift C ℤ] [HasShift D ℤ] (F : C ⥤ D) [F.CommShift ℤ]
      (s : S ⥤ C) (t : T ⥤ D) (G : S ⥤ T) (ι : s ⋙ F ≅ G ⋙ t)
      {K : D} {L L' : S} {J : T}
      (f : K ⟶ F.obj ((s.obj L)⟦(2 : ℤ)⟧))
      (e : G.obj L ≅ J) (e' : G.obj L' ≅ J) :
      K ⟶ F.obj ((s.obj L')⟦(2 : ℤ)⟧) :=
    let root {L : S} (e : G.obj L ≅ J) :
        F.obj ((s.obj L)⟦(2 : ℤ)⟧) ≅ (t.obj J)⟦(2 : ℤ)⟧ :=
      (F.commShiftIso (2 : ℤ)).app (s.obj L) ≪≫
        (shiftFunctor _ (2 : ℤ)).mapIso (ι.app L ≪≫ t.mapIso e)
    coordinateArrowComparison f (coordinateIsoThrough (root e) (root e'))
  compare (comparisonUpperStar (ModuleCat.{u + 1} A) X).mapDerivedCategory
    (DerivedCategory.singleFunctor _ 0) (DerivedCategory.singleFunctor _ 0)
    (comparisonUpperStar (ModuleCat.{u + 1} A) X)
    ((comparisonUpperStar (ModuleCat.{u + 1} A) X).mapDerivedCategorySingleFunctor 0)
    (realizeBoundary A i M L α) e e'

/-- The literal source and target of the realized ordinary coordinate boundary.
Source: Cartier realization (blueprint: def-pur-coordinate-product-presentations). -/
def CoordinateBoundaryRawType (P : PurityFiniteSetting.{u}) (n : ℕ)
    (B : Scheme.{u}) (c : ℕ) (i : Fin c) :=
  (DerivedCategory.singleFunctor _ 0).obj
    ((lowerStar
      (ModuleCat.{u + 1} (Scheme.finiteTateCoefficient P.coefficients.l P.extension n))
      (inclusion B c i)).obj
      ((comparisonUpperStar
        (ModuleCat.{u + 1} (Scheme.finiteTateCoefficient P.coefficients.l P.extension n))
        (divisor B c i)).obj
        (Etale.ordinaryFiniteConstant
          (Scheme.finiteTateCoefficient P.coefficients.l P.extension n) (divisor B c i)))) ⟶
  (VectorIntegrationSite.comparison
    (Scheme.finiteTateCoefficient P.coefficients.l P.extension n) (iteratedAffineLine B c)).obj
    ((Etale.ordinaryFiniteLine _ (P.coefficients.l ^ (n + 1 + 1))
      (annihilates (setting P n)) (iteratedAffineLine B c))⟦(2 : ℤ)⟧)

/-- Apply the exact existing Cartier family and the normalized root comparisons.
Source: exponent normalization (blueprint: def-pur-coordinate-product-presentations). -/
def coordinateBoundaryRaw (P : PurityFiniteSetting.{u}) (n : ℕ)
    (B : Scheme.{u}) (aB : B ⟶ Spec (.of P.field.k)) (c : ℕ) (i : Fin c) (r : ℕ)
    (hA : ((P.coefficients.l ^ (r + 1) : ℕ) : (setting P n).Coefficient) = 0) :
    CoordinateBoundaryRawType P n B c i :=
  coordinateRealizeRootBoundary
    (Scheme.finiteTateCoefficient P.coefficients.l P.extension n) (inclusion B c i)
    (Etale.ordinaryFiniteConstant
      (Scheme.finiteTateCoefficient P.coefficients.l P.extension n) (divisor B c i))
    (Scheme.finiteEtaleTateLine (iteratedAffineLine B c) (P.coefficients.l ^ (r + 1))
      (Scheme.finiteTateCoefficient P.coefficients.l P.extension n) hA)
    (Scheme.finiteEtaleTateLine (iteratedAffineLine B c) (P.coefficients.l ^ (n + 1 + 1))
      (Scheme.finiteTateCoefficient P.coefficients.l P.extension n)
      (annihilates (setting P n)))
    ((Etale.cartier_kummer_map P.coefficients.l P.extension).2.exists.choose.1
      n r hA (inclusion B c i) (coordinate_cartier B c i)
      (AffineLinePurity.primeUnit (setting P n) _ (towerBase aB c)))
    (coordinateRootComparison P.coefficients.l P.extension n (iteratedAffineLine B c)
      (AffineLinePurity.primeUnit (setting P n) _ (towerBase aB c)) r hA)
    (coordinateRootComparison P.coefficients.l P.extension n (iteratedAffineLine B c)
      (AffineLinePurity.primeUnit (setting P n) _ (towerBase aB c)) (n + 1)
      (annihilates (setting P n)))

/-- Cache the exact source and target of a coordinate Cartier factor.
Source: coordinate boundary endpoints (blueprint: def-pur-coordinate-product-presentations). -/
def CoordinateBoundaryType (P : PurityFiniteSetting.{u}) (n : ℕ)
    (B : Scheme.{u}) (c : ℕ) (i : Fin c) :=
    (cupSingle (setting P n) (iteratedAffineLine B c)).obj
      ((lowerStar (ModuleCat.{u + 1} (setting P n).Coefficient) (inclusion B c i)).obj
        ((setting P n).constant (divisor B c i))) ⟶ shiftedLine (setting P n)
          (iteratedAffineLine B c)

/-- The literal realized endpoints are the recorded coordinate-boundary endpoints.
Source: coordinate boundary normalization (blueprint: def-pur-coordinate-product-presentations).
Proof: unfold setting, constantEtale, constant, cupSingle and shiftedLine. The
coefficient rings, ordinary constants, compared singles and shifted Tate lines
on the two sides are then identical. No equality of maps is used. -/
theorem coordinateBoundaryType_eq (P : PurityFiniteSetting.{u}) (n : ℕ)
    (B : Scheme.{u}) (c : ℕ) (i : Fin c) :
    CoordinateBoundaryRawType P n B c i = CoordinateBoundaryType P n B c i := by
  rfl

/-- Realize the specified exponent Cartier map with its uniquely fixed endpoints.
Source: proof Step 10 (blueprint: def-pur-coordinate-product-presentations). -/
@[irreducible]
def boundaryAtExponent (P : PurityFiniteSetting.{u}) (n : ℕ) (B : Scheme.{u})
    (aB : B ⟶ Spec (.of P.field.k)) (c : ℕ) (i : Fin c) (r : ℕ)
    (hA : ((P.coefficients.l ^ (r + 1) : ℕ) : (setting P n).Coefficient) = 0) :
    CoordinateBoundaryType P n B c i :=
  coordinateTransport (coordinateBoundaryType_eq P n B c i)
    (coordinateBoundaryRaw P n B aB c i r hA)

end AlgebraicGeometry.ProEtale.AffineZeroPurity
