module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import WeilConjectures.Mathlib.RingTheory.GradedAlgebra.Homogeneous.Maps
import WeilConjectures.AlgebraicGeometry.RelativeProj.Functoriality
import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
import Mathlib.AlgebraicGeometry.Gluing
import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.GroupTheory.MonoidLocalization.Away

/-! # Homogeneous equations of a closed subscheme of projective space

Source: Stacks Project, Constructions, Tag 03GL, `lemma-closed-in-projective-space`.
(blueprint: lem-sfb-projective-closed-subscheme-homogeneous-ideal).

The chart fractions below are sections of the structure sheaf, so vanishing detects
nilpotents as well as points. The quotient grading is the image of each homogeneous
piece, and the morphism of projective spectra is induced by the quotient homomorphism.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry

-- Export the existing total-degree grading, so the signatures also elaborate in consumers.
attribute [instance] MvPolynomial.gradedAlgebra

/-- The regular function `F / zᵢ^d` on the standard chart `D₊(zᵢ)`.
Source: Stacks Project, Constructions, Tag 03GL, standard trivializations of `O(d)`.
(blueprint: lem-sfb-projective-closed-subscheme-homogeneous-ideal). -/
noncomputable def projectiveClosedSubschemeChartFraction
    (R : Type u) [CommRing R] (n d : ℕ)
    (F : homogeneousSubmodule (Fin (n + 1)) R d) (a : Fin (n + 1)) :
    Γ(Proj (homogeneousSubmodule (Fin (n + 1)) R),
      Proj.basicOpen (homogeneousSubmodule (Fin (n + 1)) R) (X a)) :=
  Proj.awayToSection (homogeneousSubmodule (Fin (n + 1)) R) (X a)
    (HomogeneousLocalization.mk
      ⟨d, F, ⟨X a ^ d, isHomogeneous_X_pow a d⟩, ⟨d, rfl⟩⟩)

/-- The degree-`d` piece of the actual quotient of the polynomial ring by `I`:
the additive subgroup which is the image of `B_d` under `B → B/I`.
Source: Stacks Project, Constructions, Tag 03GL, the grading of `R[T₀,…,Tₙ]/I`.
(blueprint: lem-sfb-projective-closed-subscheme-homogeneous-ideal). -/
noncomputable def projectiveClosedSubschemeQuotientGrade
    (R : Type u) [CommRing R] (n : ℕ)
    (I : HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R)) (d : ℕ) :
    AddSubgroup (MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal) :=
  (homogeneousSubmodule (Fin (n + 1)) R d).toAddSubgroup.map
    (Ideal.Quotient.mk I.toIdeal).toAddMonoidHom

/-- The graded quotient homomorphism, with its actual quotient map as underlying ring map.
Source: Stacks Project, Constructions, Tag 03GL, `B → B/I`.
(blueprint: lem-sfb-projective-closed-subscheme-homogeneous-ideal). -/
noncomputable def projectiveClosedSubschemeQuotientMap
    (R : Type u) [CommRing R] (n : ℕ)
    (I : HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R)) :
    homogeneousSubmodule (Fin (n + 1)) R →+*ᵍ
      projectiveClosedSubschemeQuotientGrade R n I where
  __ := Ideal.Quotient.mk I.toIdeal
  map_mem := fun {_d} {F} hF ↦ ⟨F, hF, rfl⟩

/-- The chartwise vanishing pieces form a homogeneous ideal, and its graded quotient
recovers the given closed subscheme, with the canonical quotient-induced closed immersion.
Source: Stacks Project, Constructions, Tag 03GL, `lemma-closed-in-projective-space`.
(blueprint: lem-sfb-projective-closed-subscheme-homogeneous-ideal).

Proof: (1) Restriction is additive and `R`-linear; multiplication of homogeneous chart
fractions shows `B_e I_d ⊆ I_(d+e)`, so the finite homogeneous sums form a homogeneous
ideal. Its quotient has the image grading used below. (2) The surjective graded map
induces the canonical closed immersion by `prop-nagata-relative-proj-functoriality`.
The standard opens cover both Proj schemes by `prop-nagata-proj-standard-open`.
Write the restriction of the original immersion on the `a` chart as `Spec(A_a/J_a)`.
(3) The degree-zero localization of the quotient is `A_a/J'_a`, where `J'_a` is
generated by fractions `F/z_a^d` for `F ∈ I_d`: lift homogeneous numerators, and use
`def-weil-ring-localization-away` to clear a power of `z_a` in its kernel.
(4) Vanishing gives `J'_a ⊆ J_a`. Homogenizing any `f ∈ J_a` gives `f = F/z_a^d`.
(5) On every other chart `j`, use `lem-weil-pbc-proj-basic-open-intersection` to
identify the overlap with the principal open of `z_a/z_j`. The restriction of
`F/z_j^d` there is zero. By `lem-weil-pbc-affine-ideals-closed-subscheme` and the
localization zero criterion, some power of `z_a/z_j` kills it in the actual
quotient ring. (6) Take the maximum of these finitely many exponents. Then
`z_a^N F ∈ I_(d+N)` and `f = (z_a^N F)/z_a^(d+N)`, giving `J_a ⊆ J'_a`.
(7) The affine quotient identifications agree on overlaps: both commute with the
surjective structure-sheaf maps of the closed embeddings. Glue the isomorphisms
and their inverses with `lem-weil-pbc-scheme-morphism-gluing`. This argument uses
no reducedness, nonemptiness, nonzero base ring, or positive-dimension hypothesis. -/
theorem exists_projectiveClosedSubscheme_homogeneousIdeal
    (R : Type u) [CommRing R] (n : ℕ) (Z : Scheme.{u})
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin (n + 1)) R)) [IsClosedImmersion i] :
    ∃ I : HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R),
      (∀ (d : ℕ) (F : homogeneousSubmodule (Fin (n + 1)) R d),
        (F.val ∈ I ↔ ∀ a : Fin (n + 1),
          i.app (Proj.basicOpen (homogeneousSubmodule (Fin (n + 1)) R) (X a))
            (projectiveClosedSubschemeChartFraction R n d F a) = 0)) ∧
      ∃ (_ : GradedRing (projectiveClosedSubschemeQuotientGrade R n I))
        (h : HomogeneousIdeal.irrelevant (projectiveClosedSubschemeQuotientGrade R n I) ≤
          (HomogeneousIdeal.irrelevant (homogeneousSubmodule (Fin (n + 1)) R)).map
            (projectiveClosedSubschemeQuotientMap R n I)),
        IsClosedImmersion (Proj.map (projectiveClosedSubschemeQuotientMap R n I) h) ∧
        ∃ e : Proj (projectiveClosedSubschemeQuotientGrade R n I) ≅ Z,
          e.hom ≫ i = Proj.map (projectiveClosedSubschemeQuotientMap R n I) h := by
  sorry

end AlgebraicGeometry
