/-! # The canonical comparison for the twisted inverse image

Source: comparison transport, last paragraph of the proof of sk-prop-geo-p1-adjunction
in literature/blueprint/latest/.
(blueprint: geo-p1-right-comparison).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian MonoidalCategory
namespace AlgebraicGeometry.ProEtale.GeoP1Adjunction

set_option linter.auxLemma false in
attribute [local instance 100000] Etale.DerivedCategoryModule._proof_1
  Etale.DerivedCategoryModule._proof_2

/-- The canonical twisted inverse-image comparison is invertible on every complex.
Source: the tensor and pullback comparison in the last paragraph of
sk-prop-geo-p1-adjunction.proof.md (blueprint: geo-p1-right-comparison).

Proof: comparison inverse image preserves flat objects. Its derived tensor comparison
is therefore invertible. The other factor is the image, under tensoring with the
shifted Tate line, of the inverse of the canonical pullback comparison. Functors
preserve isomorphisms, so both factors and their composite are invertible. -/
theorem rightComparisonMap_isIso (A : Type (u + 1)) [CommRing A] [Finite A]
    (N : ℕ) (hA : (N : A) = 0) (S : Scheme.{u})
    (K : Etale.DerivedCategoryModule A S) : IsIso (rightComparisonMap A N hA S K) := by
  let : (comparisonUpperStar (ModuleCat.{u + 1} A)
      (ProjectiveLine S)).PreservesFlat := preservesFlat_comparisonUpperStar
  unfold rightComparisonMap
  infer_instance

end AlgebraicGeometry.ProEtale.GeoP1Adjunction
