unique lifts of $B\to L$ to $L[T]/(T)^{n+1}$ over $k[u]$, with $u_i\mapsto u_i(x)+T_i$, by
successive square-zero thickenings. Set $C_n=(L\otimes_kB)/\mathfrak q^{n+1}$, where $\mathfrak
q$ is the evaluation kernel. The map $L[T]/(T)^{n+1}\to C_n$ sends $T_i$ to $1\otimes u_i-
u_i(x)$, and the lifted Taylor map gives a reverse map. Their composite on the polynomial
algebra fixes every $T_i$; the other composite fixes the left $L$ and is the identity on $B$ by
uniqueness of the lift of $B\to L$ over $k[u]$ into $C_n$. Thus they are inverse. Passing to
inverse limits defines $\tau_x:B\to L[[T]]$ and the completed-diagonal isomorphism. Quotienting
$C_n$ by the image of $I$ now gives $L[[T]]/(K_x+(T)^{n+1})=P^n_{(B/I)/k}\otimes_{B/I}L$, with
$K_x=(\tau_x(I))$. This uses the scalar-extended diagonal, without assuming a coefficient-field
section into $\widehat{\mathcal O}_{X,x}$.
-/
theorem taylor_dimension {k : Type u} [Field k] [CharZero k]
    {U : Scheme.{u}} {d : ℕ} (c : MvPolynomial (Fin d) k →+* Γ(U, ⊤))
    [Etale (U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom c))]
    (I : U.IdealSheafData) (hI : Scheme.Modules.IsQuasiCoherentFiniteType I.toModules)
    (a : I.subscheme)
    (T : U.presheaf.stalk (I.subschemeι a) →+*
      MvPowerSeries (Fin d) (U.residueField (I.subschemeι a)))
    (hT : HilbertCoefficient.isTaylorMap
      ((U.presheaf.germ ⊤ (I.subschemeι a) (by trivial)).hom.comp c)
      (U.residue (I.subschemeι a)).hom T) (n : ℕ) :
    Module.finrank (U.residueField (I.subschemeι a))
      (MonomialDiagram.truncation
        (HilbertCoefficient.taylorIdeal (HilbertSamuel.stalkIdeal I (I.subschemeι a)) T) n) =
      HilbertSamuel.function
        (I.subschemeι ≫ U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (c.comp MvPolynomial.C)))
        a n := by
  sorry

private theorem initial_diagram_add {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) :
    ∀ α ∈ MonomialDiagram.initialDiagram K, ∀ β : Fin d →₀ ℕ,
      α + β ∈ MonomialDiagram.initialDiagram K := by
  classical
  rintro α ⟨F, hF, hα⟩ β
  refine ⟨F * MvPowerSeries.monomial β 1, K.mul_mem_right _ hF, ?_, ?_⟩
  · simpa only [MvPowerSeries.coeff_add_mul_monomial, mul_one] using hα.1
  · intro γ hγ
    rw [MvPowerSeries.coeff_mul_monomial]
    split_ifs with hβ
    · change toDegLex γ < toDegLex (α + β) at hγ
      have hlt : Finsupp.DegLex (· < ·) (· < ·) (γ - β) α := by
        have h : toDegLex ((γ - β) + β) < toDegLex (α + β) := by
          simpa only [tsub_add_cancel_of_le hβ] using hγ
        exact (add_lt_add_iff_right (toDegLex β)).mp h
      rw [hα.2 _ hlt, zero_mul]
    · rfl

private theorem generated_eq_of_vertices {d s : ℕ} (D : Set (Fin d →₀ ℕ))
    (hD : ∀ α ∈ D, ∀ β : Fin d →₀ ℕ, α + β ∈ D)
    (α : Fin s → Fin d →₀ ℕ) (hα : MonomialDiagram.IsOrderedVertexFamily D α) :
    D = MonomialDiagram.generated α := by
  ext e
  constructor
  · intro he
    obtain ⟨v, hve, hv⟩ := exists_minimal_le_of_wellFoundedLT (· ∈ D) e he
    obtain ⟨i, rfl⟩ := (hα.1 v).mp hv
    exact ⟨i, hve⟩
  · rintro ⟨i, hi⟩
    have hv := ((hα.1 (α i)).mpr ⟨i, rfl⟩).1
    simpa only [add_tsub_cancel_of_le hi] using hD (α i) hv (e - α i)

private theorem finite_ordered_vertices {d : ℕ} (D : Set (Fin d →₀ ℕ)) :
    ∃ (s : ℕ) (α : Fin s → Fin d →₀ ℕ),
      MonomialDiagram.IsOrderedVertexFamily D α := by
  classical
  have ha : IsAntichain (· ≤ ·) {e : Fin d →₀ ℕ | Minimal (· ∈ D) e} := by
    intro a ha b hb hab hle
    exact hab (le_antisymm hle (hb.2 ha.1 hle))
  have hf := WellQuasiOrderedLE.finite_of_isAntichain ha
  let V : Finset (DegLex (Fin d →₀ ℕ)) := (hf.image toDegLex).toFinset
  let f := V.orderEmbOfFin rfl
  have hmem (e : Fin d →₀ ℕ) : Minimal (· ∈ D) e ↔ toDegLex e ∈ V := by
    simp [V]
  refine ⟨V.card, fun i ↦ ofDegLex (f i), ?_, ?_⟩
  · intro e
    rw [hmem]
    change toDegLex e ∈ (V : Set (DegLex (Fin d →₀ ℕ))) ↔ _
    rw [← Finset.range_orderEmbOfFin V rfl]
    exact ⟨fun ⟨i, hi⟩ ↦ ⟨i, congrArg ofDegLex hi⟩,
      fun ⟨i, hi⟩ ↦ ⟨i, congrArg toDegLex hi⟩⟩
  · intro i j hij
    exact f.strictMono hij

/-- Initial diagrams are upward closed and have their unique finite minimal vertex set.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
6. For a formal ideal $K$, exclude zero when taking first exponents. Multiplication by $T^\beta$
shows $D=\mathcal N(K)$ is upward closed. Its coordinatewise minimal elements form an antichain
and hence are finite by Dickson. Every $\alpha\in D$ dominates a minimal element: choose a
minimal element of the finite nonempty set $D\cap\prod_j[0,\alpha_j]$. Thus $D=V+\mathbf N^d$,
and every generating subset contains $V$, proving its uniqueness. Select $G_i\in K$ with initial
exponent the ordered vertex $\alpha_i$ and normalize its leading coefficient to $1$. Define
$E_i,\Delta_i,E_0$ as in the statement. These disjoint sets partition the exponent tuples.
-/
theorem initial_diagram_vertices {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) :
    (∀ α ∈ MonomialDiagram.initialDiagram K, ∀ β : Fin d →₀ ℕ,
      α + β ∈ MonomialDiagram.initialDiagram K) ∧
    ∃ (s : ℕ) (α : Fin s → Fin d →₀ ℕ),
      MonomialDiagram.IsOrderedVertexFamily (MonomialDiagram.initialDiagram K) α ∧
      MonomialDiagram.initialDiagram K = MonomialDiagram.generated α := by
  have hD := initial_diagram_add K
  obtain ⟨s, α, hα⟩ := finite_ordered_vertices (MonomialDiagram.initialDiagram K)
  exact ⟨hD, s, α, hα, generated_eq_of_vertices _ hD α hα⟩

/-- Unique formal division with the translated first-vertex quotient supports and complementary
remainder.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
7. Construct division by recursion through the degree-lexicographic monomials. If the current
residual coefficient at $\gamma$ is $c$ and $\gamma\in E_i$, add $cT^{\gamma-\alpha_i}$ to $Q_i$
and subtract that multiple of $G_i$; if $\gamma\in E_0$, add $cT^\gamma$ to $R$ and subtract it.
Each subtraction affects only exponents at least $\gamma$, and kills its coefficient. Each
bounded degree contains finitely many exponents, so every coefficient stabilizes and the limits
are formal series satisfying the required equality and supports. To prove uniqueness, subtract
two expressions. At the smallest surviving exponent, the leading contribution of each nonzero
$Q_iG_i$ lies in $E_i$, while that of $R$ lies in $E_0$; these sets are disjoint, so
cancellation is impossible. The procedure also shows that if the dividend has order at least
$q$, then $R$ has that order and $Q_i$ has order at least $q-|\alpha_i|$.
8. For $F\in K$, its division remainder lies in $K$, because the sum $\sum_iQ_iG_i$ is a finite
sum of elements of $K$. If nonzero, that remainder has initial exponent both outside $D$ by its
support and inside $D$ by membership in $K$, a contradiction. Thus the $G_i$ generate $K$ with
supported quotients. By the order estimate in Step 7, every class modulo $K+(T)^{n+1}$ is
represented by a linear combination of monomials outside $D$ of degree at most $n$. If such a
combination belonged to $K+(T)^{n+1}$, divide its expression as an element of $K$ plus a series
of order at least $n+1$. Its remainder would have order at least $n+1$, but division of the
combination leaves the combination itself. It is therefore zero. These monomials form a basis,
giving the asserted dimension formula.
-/
theorem unique_supported_division {d s : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) (α : Fin s → Fin d →₀ ℕ)
    (hα : MonomialDiagram.IsOrderedVertexFamily (MonomialDiagram.initialDiagram K) α)
    (G : Fin s → MvPowerSeries (Fin d) L)
    (hG : ∀ i : Fin s, G i ∈ K ∧ MonomialDiagram.IsFirstExponent (G i) (α i))
    (F : MvPowerSeries (Fin d) L) :
    ∃! qr : (Fin s → MvPowerSeries (Fin d) L) × MvPowerSeries (Fin d) L,
      F = (∑ i : Fin s, qr.1 i * G i) + qr.2 ∧
      (∀ i : Fin s, HilbertCoefficient.supported (qr.1 i)
        (fun β ↦ β ∈ MonomialDiagram.quotientSupport α i)) ∧
      HilbertCoefficient.supported qr.2 (fun β ↦ β ∉ MonomialDiagram.initialDiagram K) := by
  have hD := generated_eq_of_vertices _ (initial_diagram_add K) α hα
  obtain ⟨Q, R, hF, hQ, hR, hu, _⟩ :=
    MonomialDiagram.exists_unique_supported_formal_division G α (fun i ↦ (hG i).2) F
  have hR' : HilbertCoefficient.supported R
      (fun β ↦ β ∉ MonomialDiagram.initialDiagram K) := by
    simpa only [hD, HilbertCoefficient.supported, Set.subset_def,
      Function.mem_support, Set.mem_compl_iff, MvPowerSeries.coeff_apply] using hR
  refine ⟨(Q, R), ⟨hF, hQ, hR'⟩, ?_⟩
  rintro ⟨Q', R'⟩ ⟨hF', hQ', hR''⟩
  have hRsup : Function.support R' ⊆ (MonomialDiagram.generated α)ᶜ := by
    simpa only [hD, HilbertCoefficient.supported, Set.subset_def,
      Function.mem_support, Set.mem_compl_iff, MvPowerSeries.coeff_apply] using hR''
  obtain ⟨rfl, rfl⟩ := hu Q' R' hF' hQ' hRsup
  rfl

private theorem variables_pow_iff {d : ℕ} {L : Type u} [Field L]
    (F : MvPowerSeries (Fin d) L) (q : ℕ) :
    F ∈ (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin d) (R := L)))) ^ q ↔
      ∀ e : Fin d →₀ ℕ, e.degree < q → MvPowerSeries.coeff e F = 0 := by
  have h := power_series_mem_combined_ideal_pow_iff L ⊥ d q F
  simp only [Ideal.map_bot, bot_sup_eq] at h
  refine h.trans ?_
  constructor <;> intro h e he
  · simpa [Ideal.bot_pow (Nat.sub_pos_of_lt he).ne'] using h e he
  · simpa [Ideal.bot_pow (Nat.sub_pos_of_lt he).ne'] using h e he

private theorem exists_first_exponent {d : ℕ} {L : Type u} [Field L]
    (F : MvPowerSeries (Fin d) L) (hF : F ≠ 0) :
    ∃ α, MonomialDiagram.IsFirstExponent F α := by
  classical
  have hne : ∃ a : DegLex (Fin d →₀ ℕ), MvPowerSeries.coeff (ofDegLex a) F ≠ 0 := by
    by_contra! h
    apply hF
    ext e
    exact h (toDegLex e)
  let a := wellFounded_lt.min {a : DegLex (Fin d →₀ ℕ) |
    MvPowerSeries.coeff (ofDegLex a) F ≠ 0} hne
  refine ⟨ofDegLex a, wellFounded_lt.min_mem _ hne, ?_⟩
  intro β hβ
  by_contra hb
  have hmin : ¬ toDegLex β < a := wellFounded_lt.not_lt_min
    {b : DegLex (Fin d →₀ ℕ) | MvPowerSeries.coeff (ofDegLex b) F ≠ 0} hb
  exact hmin hβ

/-- Complementary monomials give the dimension of every finite-order quotient.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
7. Construct division by recursion through the degree-lexicographic monomials. If the current
residual coefficient at $\gamma$ is $c$ and $\gamma\in E_i$, add $cT^{\gamma-\alpha_i}$ to $Q_i$
