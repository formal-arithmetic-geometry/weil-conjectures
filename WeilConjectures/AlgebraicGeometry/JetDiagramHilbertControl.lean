cancellation is impossible. The procedure also shows that if the dividend has order at least
$q$, then $R$ has that order and $Q_i$ has order at least $q-|\alpha_i|$.
8. For $F\in K$, its division remainder lies in $K$, because the sum $\sum_iQ_iG_i$ is a finite
sum of elements of $K$. If nonzero, that remainder has initial exponent both outside $D$ by its
support and inside $D$ by membership in $K$, a contradiction. Thus the $G_i$ generate $K$ with
supported quotients. By the order estimate in Step 7, every class modulo $K+(T)^{n+1}$ is
represented by a linear combination of monomials outside $D$ of degree at most $n$. If such a
combination belonged to $K+(T)^{n+1}$, divide its expression as an element of $K$ plus a series
of order at least $n+1$. Its remainder would have order at least $n+1$, but division of the
combination leaves the combination itself. It is therefore zero. These monomials form a basis,
giving the asserted dimension formula.
-/
theorem formal_quotient_dimension {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) (n : ℕ) :
    Module.Finite L (MonomialDiagram.truncation K n) ∧
    Module.finrank L (MonomialDiagram.truncation K n) =
      MonomialDiagram.hilbertCount (MonomialDiagram.initialDiagram K) n := by
  classical
  let D := MonomialDiagram.initialDiagram K
  let E := {e : Fin d →₀ ℕ | e ∉ D ∧ e.degree ≤ n}
  have hE : E.Finite := (Finsupp.finite_of_degree_le n).subset (fun _ h ↦ h.2)
  let : Fintype E := hE.fintype
  let V : Ideal (MvPowerSeries (Fin d) L) :=
    (Ideal.span (Set.range MvPowerSeries.X)) ^ (n + 1)
  let J := K ⊔ V
  let p : (E → L) →ₗ[L] MvPowerSeries (Fin d) L :=
    { toFun := fun c e ↦ if h : e ∈ E then c ⟨e, h⟩ else 0
      map_add' := by
        intro c b
        funext e
        change (if h : e ∈ E then c ⟨e, h⟩ + b ⟨e, h⟩ else 0) =
          (if h : e ∈ E then c ⟨e, h⟩ else 0) + (if h : e ∈ E then b ⟨e, h⟩ else 0)
        split_ifs <;> simp
      map_smul' := by
        intro r c
        funext e
        change (if h : e ∈ E then r * c ⟨e, h⟩ else 0) =
          r * (if h : e ∈ E then c ⟨e, h⟩ else 0)
        split_ifs <;> simp }
  have hp (c : E → L) (e : Fin d →₀ ℕ) :
      MvPowerSeries.coeff e (p c) = if h : e ∈ E then c ⟨e, h⟩ else 0 := rfl
  have hpE (c : E → L) (e : E) : MvPowerSeries.coeff e.val (p c) = c e := by
    rw [hp, dif_pos e.property]
  let φ : (E → L) →ₗ[L] MonomialDiagram.truncation K n :=
    (Ideal.Quotient.mkₐ L J).toLinearMap.comp p
  have hinj : Function.Injective φ := by
    apply (LinearMap.ker_eq_bot).mp
    apply LinearMap.ker_eq_bot'.mpr
    intro c hc
    have hcJ : p c ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp hc
    obtain ⟨k, hk, v, hv, heq⟩ := Submodule.mem_sup.mp hcJ
    have hvlow := (variables_pow_iff v (n + 1)).mp hv
    have hzero : p c = 0 := by
      by_contra hn
      obtain ⟨a, ha⟩ := exists_first_exponent (p c) hn
      have haE : a ∈ E := by
        by_contra h
        exact ha.1 (by rw [hp, dif_neg h])
      have hcoeff (b : Fin d →₀ ℕ) (hb : b.degree ≤ n) :
          MvPowerSeries.coeff b k = MvPowerSeries.coeff b (p c) := by
        have h := congrArg (MvPowerSeries.coeff b) heq
        simpa only [map_add, hvlow b (by omega), add_zero] using h
      have hka : MonomialDiagram.IsFirstExponent k a := by
        refine ⟨?_, ?_⟩
        · rw [hcoeff a haE.2]
          exact ha.1
        · intro b hb
          have hdeg : b.degree ≤ a.degree :=
            Finsupp.DegLex.monotone_degree
              (le_of_lt (show toDegLex b < toDegLex a from hb))
          rw [hcoeff b (hdeg.trans haE.2)]
          exact ha.2 b hb
      exact haE.1 ⟨k, hk, hka⟩
    funext e
    have h := congrArg (MvPowerSeries.coeff e.val) hzero
    simpa only [hpE, map_zero, Pi.zero_apply] using h
  have hsurj : Function.Surjective φ := by
    intro x
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨s, α, hα, hD⟩ := (initial_diagram_vertices K).2
    have hG : ∀ i : Fin s, ∃ g ∈ K, MonomialDiagram.IsFirstExponent g (α i) := by
      intro i
      exact ((hα.1 (α i)).mpr ⟨i, rfl⟩).1
    choose G hGK hGα using hG
    obtain ⟨Q, R, hF, hQ, hR, _⟩ :=
      MonomialDiagram.exists_unique_supported_formal_division G α hGα F
    let c : E → L := fun e ↦ MvPowerSeries.coeff e.val R
    have htail : R - p c ∈ V := by
      apply (variables_pow_iff _ (n + 1)).mpr
      intro e he
      by_cases heD : e ∈ D
      · have hz : MvPowerSeries.coeff e R = 0 := by
          by_contra hne
          have hs : e ∈ Function.support R := by
            simpa only [Function.mem_support, MvPowerSeries.coeff_apply] using hne
          apply hR hs
          exact hD ▸ (show e ∈ MonomialDiagram.initialDiagram K from heD)
        rw [map_sub, hz, hp, dif_neg (fun h ↦ h.1 heD), sub_self]
      · rw [map_sub, hp, dif_pos ⟨heD, by omega⟩]
        exact sub_self _
    have hsum : (∑ i : Fin s, Q i * G i) ∈ K :=
      K.sum_mem (fun i _ ↦ K.mul_mem_left _ (hGK i))
    refine ⟨c, ?_⟩
    change Ideal.Quotient.mk J (p c) = Ideal.Quotient.mk J F
    symm
    apply Ideal.Quotient.eq.mpr
    have h : F - p c = (∑ i : Fin s, Q i * G i) + (R - p c) := by rw [hF]; ring
    rw [h]
    exact J.add_mem (Submodule.mem_sup_left hsum) (Submodule.mem_sup_right htail)
  let e := LinearEquiv.ofBijective φ ⟨hinj, hsurj⟩
  have hfinite : Module.Finite L (MonomialDiagram.truncation K n) := Module.Finite.equiv e
  refine ⟨hfinite, ?_⟩
  rw [← e.finrank_eq, Module.finrank_fintype_fun_eq_card]
  exact Set.fintypeCard_eq_ncard E

/-- Taylor diagrams take finitely many values on a neighbourhood in the entire ambient chart,
including outside the closed subscheme.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
9. Work on an affine chart with generators $f_1,\ldots,f_v$ of $I$. Apply the cited calculus
theorem with $r=0$, $N=U$, $w=u$. Its centered Taylor map equals Step 5's map: both send $u_i$
to $u_i(x)+T_i$, and unique lifting identifies them modulo every $(T)^q$. Coordinate derivatives
$D_i$ preserve regular functions and commute with this map. Differentiating and taking constant
terms gives $[T^\alpha]\tau_x(f)=D^\alpha f(x)/\alpha!$; characteristic zero makes the
denominator invertible. For a degree-lex exponent $a$, discard monomials greater than $a$ and
form the finite matrix of $T^\beta\tau(f_j)$ for $\beta\leq a$. Its entries are therefore
regular. Steps 7--8 apply to this monomial-prefix tail since subtraction increases exponents.
The specialized cokernel has dimension $c_{D_x}(a)=\#\{\gamma\leq a:\gamma\notin D_x\}$. Thus
$\{x:c_{D_x}(a)\leq r\}$ is open, given by nonvanishing minors of size $N-r$, where $N$ is the
number of retained monomials. Order diagrams by their increasing vertex lists padded with
$\infty$; equivalently, the diagram containing the first differing exponent is smaller. For a
fixed nonempty diagram $E$, let $a$ be its largest vertex. Comparing $D$ with $E$ uses only
$(c_D(\beta))_{\beta\leq a}$ lexicographically: a first difference decides the comparison;
agreement forces all vertices of $E$ into $D$, hence $E\subseteq D$ and $D\leq E$. A bounded
integer-vector lexicographic sublevel is a finite union of coordinatewise sublevels, so
$\{x:D_x\leq E\}$ is open by the minors argument. For empty $E$ it is the whole chart. The zero
and unit ideals are included.
10. There cannot be an infinite strictly decreasing sequence of diagrams in this order. In such
a sequence, for each successive exponent the membership bit eventually stabilizes: after earlier
bits stabilize, the current bit can change only from absence to presence. Let $D_\infty$ be the
eventual-membership diagram; it is upward closed. Step 6 applies to it, so it has finitely many
vertices. At a sufficiently late index $i$, every one of these vertices belongs to $D_i$, hence
$D_\infty\subseteq D_i$. But a strictly decreasing sequence converging on every finite prefix
has $D_i>D_\infty$ at every index: its first later change places a monomial in the limiting
diagram. Inclusion gives the opposite inequality. This contradiction also covers an empty
limiting diagram.
11. Restrict to an affine part of the chart. Its coordinate ring is a finite-type algebra over
$k$ and hence is Noetherian; its spectrum is a Noetherian space. If infinitely many diagram
values occurred, the well-order property from Step 10 would give strictly increasing values
$E_1<E_2<\cdots$ in that image (successively take the least remaining value). The closed subsets
$\{x:D_x>E_i\}$ would then be strictly decreasing: a point with value $E_{i+1}$ belongs to the
$i$th and not the $(i+1)$st set. Step 9 proves closedness, and Noetherianity prohibits this
sequence. Thus there are only finitely many values on that affine neighbourhood, as asserted
locally on $U$.
-/
theorem taylor_diagrams_locally_finite {k : Type u} [Field k] [CharZero k]
    {U : Scheme.{u}} {d : ℕ} (c : MvPolynomial (Fin d) k →+* Γ(U, ⊤))
    [Etale (U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom c))]
    (I : U.IdealSheafData) (hI : Scheme.Modules.IsQuasiCoherentFiniteType I.toModules)
    (T : ∀ x : U, U.presheaf.stalk x →+* MvPowerSeries (Fin d) (U.residueField x))
    (hT : ∀ x : U, HilbertCoefficient.isTaylorMap
      ((U.presheaf.germ ⊤ x (by trivial)).hom.comp c) (U.residue x).hom (T x)) :
    ∀ x : U, ∃ V : U.Opens, x ∈ V ∧
      ((fun y : U ↦ MonomialDiagram.initialDiagram
        (HilbertCoefficient.taylorIdeal (HilbertSamuel.stalkIdeal I y) (T y))) ''
          (V : Set U)).Finite := by
  sorry

/-- The cumulative Hilbert functions of additive diagrams have no infinite strict lexicographic
descent.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
12. Now suppose $H_{D_i}(n)=\#\{\alpha\notin D_i:|\alpha|\leq n\}$ strictly decreases
lexicographically. For each $n$, its value eventually stabilizes: once values at smaller
arguments have stabilized, a strict lexicographic decrease can only lower the $n$th natural
number or leave it unchanged. Call the limit $H(n)$. There are finitely many possible membership
patterns in each degree ball. Choose a subsequence with a fixed pattern in degree at most $0$,
then a subsequence with a fixed pattern in degree at most $1$, and so on, always retaining
infinitely many indices; selecting increasing indices from these nested subsequences gives
diagrams converging on every degree ball. Their eventual-membership set $D$ is upward closed,
and its counting function is $H$. By Dickson, $D$ just constructed has finitely many vertices;
all belong to every sufficiently late diagram of the chosen subsequence. Hence $D\subseteq D_i$
there and $H_{D_i}(n)\leq H(n)$ for every $n$. On the other hand every term of a strictly
decreasing lexicographic sequence with stabilized finite prefixes is strictly larger than its
limiting sequence: take the first argument where it differs from a later smaller term and then
stabilize that finite prefix. This contradicts the pointwise inequality. Therefore the Hilbert
functions have no infinite strict lexicographic decrease. This proof does not identify the order
of diagrams with the order of degree-counting functions, which need not agree.
-/
theorem no_infinite_hilbert_descent (d : ℕ) :
    ¬ ∃ D : ℕ → Set (Fin d →₀ ℕ),
      (∀ (i : ℕ) (α : Fin d →₀ ℕ), α ∈ D i → ∀ β : Fin d →₀ ℕ, α + β ∈ D i) ∧
      ∀ i : ℕ, HilbertSamuel.lt (MonomialDiagram.hilbertCount (D (i + 1)))
        (MonomialDiagram.hilbertCount (D i)) := by
  sorry

/-- Étale base change of principal parts, pinned on pure tensor generators, hence the canonical
comparison.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
13. For an etale map $A\to A'$, formal etaleness gives a unique extension of the right $A$-map
to a right $A'$-map on each nilpotent diagonal thickening of $A'\otimes_AP^n_{A/k}$, reducing
modulo the diagonal ideal to the identity on $A'$. The two maps given by this lift and by the
universal tensor generators are inverse, by uniqueness at every square-zero stage. Thus
$A'\otimes_AP^n_{A/k}\simeq P^n_{A'/k}$. At a point $x'$ above $x$ this identifies the fibres
after scalar extension $\kappa(x)\to\kappa(x')$. The same unique lifts define the Taylor maps in
Step 5, so their diagrams and all finite-dimensional truncations agree after that field
extension. Scalar extension preserves the rank of each finite matrix (a minor vanishes or does
not vanish in either field); Steps 8--9 give equality of the stated dimensions. Ordinary open
localizations are included.
-/
theorem etale_principal_parts {k : Type u} {A : Type v} {B : Type w} [Field k] [CharZero k]
    [CommRing A] [CommRing B] [Algebra k A] [Algebra k B] [Algebra A B]
    [IsScalarTower k A B] [Algebra.FiniteType k A] [Algebra.Etale A B] (n : ℕ) :
    ∃ e : (B ⊗[A] principalParts k A n) ≃ₐ[B] principalParts k B n,
      ∀ (b : B) (a a' : A),
        e (b ⊗ₜ[A] (Ideal.Quotient.mk ((KaehlerDifferential.ideal k A) ^ (n + 1))
          (a ⊗ₜ[k] a'))) =
        algebraMap B (principalParts k B n) b *
          Ideal.Quotient.mk ((KaehlerDifferential.ideal k B) ^ (n + 1))
            (algebraMap A B a ⊗ₜ[k] algebraMap A B a') := by
  sorry

/-- Taylor expansion and its diagrams and dimensions commute with étale localization and extension
of the residue field.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
13. For an etale map $A\to A'$, formal etaleness gives a unique extension of the right $A$-map
to a right $A'$-map on each nilpotent diagonal thickening of $A'\otimes_AP^n_{A/k}$, reducing
modulo the diagonal ideal to the identity on $A'$. The two maps given by this lift and by the
universal tensor generators are inverse, by uniqueness at every square-zero stage. Thus
$A'\otimes_AP^n_{A/k}\simeq P^n_{A'/k}$. At a point $x'$ above $x$ this identifies the fibres
after scalar extension $\kappa(x)\to\kappa(x')$. The same unique lifts define the Taylor maps in
Step 5, so their diagrams and all finite-dimensional truncations agree after that field
extension. Scalar extension preserves the rank of each finite matrix (a minor vanishes or does
not vanish in either field); Steps 8--9 give equality of the stated dimensions. Ordinary open
localizations are included.
-/
theorem etale_taylor_compatibility {k A B L L' : Type u}
    [Field k] [CharZero k] [CommRing A] [CommRing B] [Field L] [Field L']
    {d : ℕ} (c : MvPolynomial (Fin d) k →+* A) (f : A →+* B)
    (hc : c.Etale) (hf : f.Etale) (ev : A →+* L) (ev' : B →+* L')
    (ι : L →+* L') (hev : ev'.comp f = ι.comp ev)
    (T : A →+* MvPowerSeries (Fin d) L) (T' : B →+* MvPowerSeries (Fin d) L')
    (hT : HilbertCoefficient.isTaylorMap c ev T)
    (hT' : HilbertCoefficient.isTaylorMap (f.comp c) ev' T') (I : Ideal A) :
    (MvPowerSeries.map ι).comp T = T'.comp f ∧
    MonomialDiagram.initialDiagram (HilbertCoefficient.taylorIdeal I T) =
      MonomialDiagram.initialDiagram (HilbertCoefficient.taylorIdeal (I.map f) T') ∧
    ∀ n : ℕ,
      Module.finrank L (MonomialDiagram.truncation (HilbertCoefficient.taylorIdeal I T) n) =
      Module.finrank L'
        (MonomialDiagram.truncation (HilbertCoefficient.taylorIdeal (I.map f) T') n) := by
  sorry

/-- Free variables extend the diagram by free final coordinates and iterate inclusive summation.

Source: BM 1997, §3 and §9; BMT §6.1 and §6.5; ILO VIII 2.3.11--2.3.13
(blueprint: lem-trf-jet-diagram-hilbert-control).

Proof plan from the owning node:
14. Finally extend $K\subset L[[T]]$ to $L[[T,Z_1,\ldots,Z_r]]$ without adding equations.
Expanding in the $Z$ monomials shows that its initial diagram is $D\times\mathbf N^r$: a leading
coefficient in $T$ of any nonzero $Z$ coefficient lies in $D$, and monomial multiples of vertex
representatives give every element of that product. The complement is $(\mathbf N^d\setminus
D)\times\mathbf N^r$. In total degree at most $n$, grouping by the last exponent gives
$H_{D\times\mathbf N}(n)=\sum_{j=0}^nH_D(n-j)$; repeating this for each new variable gives
$\Lambda^rH_D(n)$. This includes $r=0$, $d=0$, $K=0$, and $K=(1)$.
-/
theorem free_variables {d : ℕ} {L : Type u} [Field L]
    (K : Ideal (MvPowerSeries (Fin d) L)) (r : ℕ) :
    MonomialDiagram.initialDiagram
      (K.map (MvPowerSeries.rename (Fin.castAdd r)).toRingHom) =
        MonomialDiagram.freeExtension (MonomialDiagram.initialDiagram K) r ∧
    ∀ n : ℕ,
      MonomialDiagram.hilbertCount
        (MonomialDiagram.freeExtension (MonomialDiagram.initialDiagram K) r) n =
      (HilbertSamuel.summation^[r])
        (MonomialDiagram.hilbertCount (MonomialDiagram.initialDiagram K)) n := by
  sorry

end DiagonalJets
