module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.Separated
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.KrullDimension.Basic

/-!
# Regular closed immersions with the purity chapter's codimension convention

The upstream affine-local `IsRegularImmersion` does not include the stipulated stalkwise
Krull-dimension equality. This definition records precisely the chapter's two stalkwise
conditions. The parenthetical reference to smooth-pair linearization is a forward pointer,
not an additional defining condition.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- In separated finite-type schemes over a field, pure codimension means the stated
stalkwise Krull-dimension equality. Regularity means that the kernel of the surjective
structure-stalk map is generated by a regular sequence of the specified positive length. -/
def IsRegularImmersionOfPureCodimension
    {k : Type u} [Field k] {X Z : Scheme.{u}}
    (hX : X ⟶ Spec (CommRingCat.of k)) (i : Z ⟶ X)
    [IsSeparated hX] [LocallyOfFiniteType hX] [QuasiCompact hX]
    [IsSeparated (i ≫ hX)] [LocallyOfFiniteType (i ≫ hX)] [QuasiCompact (i ≫ hX)]
    [IsClosedImmersion i] (c : ℕ) : Prop :=
  1 ≤ c ∧
    (∀ z : Z, ringKrullDim (X.presheaf.stalk (i z)) =
      ringKrullDim (Z.presheaf.stalk z) + (c : WithBot ℕ∞)) ∧
    ∀ z : Z, ∃ f : Fin c → X.presheaf.stalk (i z),
      RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z)) (List.ofFn f) ∧
        Ideal.span (Set.range f) = RingHom.ker (i.stalkMap z).hom

end AlgebraicGeometry
