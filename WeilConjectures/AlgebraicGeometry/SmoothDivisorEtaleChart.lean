/-!
# Étale charts of a smooth divisor

Let `v : T ⟶ B` be smooth of relative dimension `n` and `i : D ⟶ T` a closed immersion with
`D` smooth over `B` and of codimension one in `T` at every point. Near every point of `D` there
is an open `U` of `T` and an étale morphism `h : U ⟶ 𝔸¹_Y` to the relative affine line over a
scheme `Y` of finite type over the base field, such that `D ∩ U` is the preimage of the zero
section (`AlgebraicGeometry.exists_etale_affineLine_zeroSection_of_smooth_divisor`).

Locally on affine opens `U ⊆ T` over `W ⊆ B`, the ideal of `D` is generated by `c` functions
with `m + c = n` (`Algebra.exists_generators_ker_of_smooth`), which are the first coordinates of
an étale map to `𝔸^c_{𝔸^m_W}` (`Algebra.exists_etale_aeval_sumElim_of_ker`). The generators
then form a regular sequence, so `c` is the codimension of `D`, that is `c = 1`.
-/

@[expose] public section
set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- The ring-theoretic meaning of smoothness of relative dimension `n` of a restriction
`f.resLE W U e` between affine opens. -/
theorem locally_isStandardSmoothOfRelativeDimension_appLE_of_resLE {X Y : Scheme.{u}}
    (f : X ⟶ Y) {W : Y.Opens} {U : X.Opens} (hW : IsAffineOpen W) (hU : IsAffineOpen U)
    (e : U ≤ f ⁻¹ᵁ W) (n : ℕ) [SmoothOfRelativeDimension n (f.resLE W U e)] :
    RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (f.appLE W U e).hom := by
  have : IsAffine U.toScheme := hU
  have : IsAffine W.toScheme := hW
  have H := (HasRingHomProperty.iff_of_isAffine (P := @SmoothOfRelativeDimension n)
    (f := f.resLE W U e)).mp inferInstance
  have : (RingHom.toMorphismProperty
      (RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n))).RespectsIso :=
    RingHom.toMorphismProperty_respectsIso_iff.mp <|
      (HasRingHomProperty.isLocal_ringHomProperty (@SmoothOfRelativeDimension n)).respectsIso
  exact (MorphismProperty.arrow_mk_iso_iff (RingHom.toMorphismProperty
    (RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n)))
    (arrowResLEAppIso f W U e)).mp H

/-- If the ideal of a closed subscheme `Z ⊆ X` is generated on an affine open `U` by a weakly
regular sequence `r`, then at every point `z` of `Z ∩ U` the local ring of `X` has dimension
`dim 𝒪_{Z,z} + length r`. -/
theorem ringKrullDim_stalk_eq_add_of_isWeaklyRegular {X Z : Scheme.{u}} [IsLocallyNoetherian X]
    (i : Z ⟶ X) [IsClosedImmersion i] (U : X.affineOpens) (r : List Γ(X, U.1))
    (hreg : RingTheory.Sequence.IsWeaklyRegular Γ(X, U.1) r)
    (hI : Ideal.ofList r = i.ker.ideal U) (z : Z) (hxU : i z ∈ U.1) :
    ringKrullDim (X.presheaf.stalk (i z)) =
      ringKrullDim (Z.presheaf.stalk z) + (r.length : WithBot ℕ∞) := by
  let := X.presheaf.algebra_section_stalk ⟨i z, hxU⟩
  have := U.2.isLocalization_stalk ⟨i z, hxU⟩
  have : Module.Flat Γ(X, U.1) (X.presheaf.stalk (i z)) :=
    IsLocalization.flat _ (U.2.primeIdealOf ⟨i z, hxU⟩).asIdeal.primeCompl
  have hsupp : i z ∈ X.zeroLocus (U := U.1) (i.ker.ideal U) :=
    (Scheme.IdealSheafData.mem_support_iff_of_mem hxU).mp
      (i.range_subset_ker_support ⟨z, rfl⟩)
  have hreg' : RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z))
      (r.map (algebraMap Γ(X, U.1) (X.presheaf.stalk (i z)))) := by
    refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).mpr
      hreg.of_flat
    intro _ hs'
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hs'
    have : s ∈ i.ker.ideal U := hI ▸ Ideal.subset_span hs
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (X.mem_basicOpen _ _ hxU).not.mp ((X.mem_zeroLocus_iff _ _).mp hsupp s this)
  have key := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hreg'
  rw [← Ideal.map_ofList, hI,
    show algebraMap Γ(X, U.1) _ = (X.presheaf.germ U (i z) hxU).hom from rfl,
    ← i.ker_stalkMap U z hxU,
    ringKrullDim_eq_of_ringEquiv
      (RingHom.quotientKerEquivOfSurjective (i.stalkMap_surjective z)), List.length_map] at key
  exact key.symm

/-- **Local equations of a smooth pair.** Let `v : T ⟶ B` and `i : D ⟶ T` be such that, over an
affine open `W ⊆ B` and on an affine open `U ⊆ T`, `T` is smooth of relative dimension `n` and
`D` is smooth of relative dimension `m`. Then every point of `D ∩ U` has a basic open
neighbourhood in `U` on which the ideal of `D` is generated by `c` functions, `m + c = n`. -/
theorem exists_basicOpen_span_eq_ker_ideal {B T D : Scheme.{u}} (v : T ⟶ B) (i : D ⟶ T)
    [IsClosedImmersion i] {W : B.Opens} (hW : IsAffineOpen W) (U : T.affineOpens)
    (e : U.1 ≤ v ⁻¹ᵁ W) (e' : i ⁻¹ᵁ U.1 ≤ (i ≫ v) ⁻¹ᵁ W) (n m : ℕ)
    [SmoothOfRelativeDimension n (v.resLE W U.1 e)]
    [SmoothOfRelativeDimension m ((i ≫ v).resLE W (i ⁻¹ᵁ U.1) e')]
    [IsNoetherianRing Γ(T, U.1)] (d : D) (hd : i d ∈ U.1) :
    ∃ (c : ℕ) (a : Γ(T, U.1)) (f : Fin c → Γ(T, T.basicOpen a)), m + c = n ∧
      i d ∈ T.basicOpen a ∧ Ideal.span (Set.range f) = i.ker.ideal (T.affineBasicOpen a) := by
  -- the rings
  let R := Γ(B, W)
  let A := Γ(T, U.1)
  let Bd := Γ(D, i ⁻¹ᵁ U.1)
  let : Algebra A Bd := (i.app U.1).hom.toAlgebra
  let : Algebra R A := (v.appLE W U.1 e).hom.toAlgebra
  let : Algebra R Bd := ((algebraMap A Bd).comp (algebraMap R A)).toAlgebra
  have : IsScalarTower R A Bd := .of_algebraMap_eq fun _ ↦ rfl
  have hsurj : Function.Surjective (algebraMap A Bd) := i.app_surjective U.1 U.2
  have hker : RingHom.ker (algebraMap A Bd) = i.ker.ideal U :=
    (Scheme.Hom.ker_apply i U).symm
  obtain ⟨hsmA, hrkA⟩ := (Algebra.locally_isStandardSmoothOfRelativeDimension_iff
    (R := R) (S := A) n).mp
      (locally_isStandardSmoothOfRelativeDimension_appLE_of_resLE v hW U.2 e n)
  have hBloc : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension m)
      (algebraMap R Bd) := by
    have := locally_isStandardSmoothOfRelativeDimension_appLE_of_resLE (i ≫ v) hW
      (U.2.preimage i) e' m
    convert this using 2
    have h : v.appLE W U.1 e ≫ i.app U.1 = (i ≫ v).appLE W (i ⁻¹ᵁ U.1) e' := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    rw [← h]
    rfl
  obtain ⟨hsmB, hrkB⟩ := (Algebra.locally_isStandardSmoothOfRelativeDimension_iff
    (R := R) (S := Bd) m).mp hBloc
  -- the prime of `i d`
  let p : Ideal A :=
    Ideal.comap (T.presheaf.germ U.1 (i d) hd).hom (IsLocalRing.maximalIdeal _)
  have hmemp : ∀ s, s ∈ p ↔ i d ∉ T.basicOpen s := fun s ↦ by
    rw [T.mem_basicOpen _ _ hd, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hkp : RingHom.ker (algebraMap A Bd) ≤ p := by
    have hsupp : i d ∈ T.zeroLocus (U := U.1) (i.ker.ideal U) :=
      (Scheme.IdealSheafData.mem_support_iff_of_mem hd).mp
        (i.range_subset_ker_support ⟨d, rfl⟩)
    intro s hs
    rw [hker] at hs
    exact (hmemp s).mpr ((T.mem_zeroLocus_iff _ _).mp hsupp s hs)
  obtain ⟨c, f, a, hmc, hap, hfI, hspan⟩ :=
    Algebra.exists_generators_ker_of_smooth hsurj hrkA hrkB p hkp
  have hxa : i d ∈ T.basicOpen a := by
    by_contra h
    exact hap ((hmemp a).mpr h)
  -- the generators on the basic open
  have hle : T.affineBasicOpen a ≤ U := T.basicOpen_le a
  let ρ := (T.presheaf.map (homOfLE (X := T.Opens) hle).op).hom
  have := U.2.isLocalization_basicOpen a
  have hu : IsUnit (ρ a) := IsLocalization.Away.algebraMap_isUnit (S := Γ(T, T.basicOpen a)) a
  refine ⟨c, a, ρ ∘ f, hmc, hxa, ?_⟩
  rw [← Scheme.IdealSheafData.map_ideal _ hle, Set.range_comp, ← Ideal.map_span ρ, ← hker]
  refine le_antisymm (Ideal.map_mono (Ideal.span_le.mpr ?_)) (Ideal.map_le_iff_le_comap.mpr ?_)
  · rintro _ ⟨j, rfl⟩
    exact hfI j
  · intro x hx
    have h₁ : ρ x = ↑hu.unit⁻¹ * ρ (a * x) := by
      rw [map_mul, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
    rw [Ideal.mem_comap]
    erw [h₁]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hspan x hx))

/-- **Étale coordinates of a smooth pair.** In the situation of
`AlgebraicGeometry.exists_basicOpen_span_eq_ker_ideal`, suppose that the ideal of `D` is
generated on `U` by `c` functions `f`, with `m + c = n`. Then every point of `D ∩ U` has a basic
open neighbourhood `U'` with an étale morphism `h : U' ⟶ 𝔸^c_{𝔸^m_W}` whose `c` fibre
coordinates pull back to the restrictions `f'` of the `f`; these form a weakly regular sequence
generating the ideal of `D ∩ U'`. -/
theorem exists_etale_affineSpace_of_span_eq_ker_ideal {B T D : Scheme.{u}} (v : T ⟶ B)
    (i : D ⟶ T) [IsClosedImmersion i] {W : B.Opens} (hW : IsAffineOpen W) (U : T.affineOpens)
    (e : U.1 ≤ v ⁻¹ᵁ W) (e' : i ⁻¹ᵁ U.1 ≤ (i ≫ v) ⁻¹ᵁ W) {n m c : ℕ} (hmc : m + c = n)
    [SmoothOfRelativeDimension n (v.resLE W U.1 e)]
    [SmoothOfRelativeDimension m ((i ≫ v).resLE W (i ⁻¹ᵁ U.1) e')]
    (f : Fin c → Γ(T, U.1)) (hf : Ideal.span (Set.range f) = i.ker.ideal U)
    (d : D) (hd : i d ∈ U.1) :
    ∃ (a : Γ(T, U.1)) (f' : Fin c → Γ(T, T.basicOpen a))
      (h : (T.basicOpen a).toScheme ⟶
        𝔸(ULift.{u} (Fin c); 𝔸(ULift.{u} (Fin m); Spec Γ(B, W)))),
      i d ∈ T.basicOpen a ∧ Ideal.span (Set.range f') = i.ker.ideal (T.affineBasicOpen a) ∧
      Etale h ∧
      (∀ j, h.appTop (AffineSpace.coord _ (ULift.up j)) = (T.basicOpen a).topIso.inv (f' j)) ∧
      RingTheory.Sequence.IsWeaklyRegular Γ(T, T.basicOpen a) (List.ofFn f') := by
  classical
  -- the rings
  set R := Γ(B, W) with hR
  let A := Γ(T, U.1)
  let Bd := Γ(D, i ⁻¹ᵁ U.1)
  let : Algebra A Bd := (i.app U.1).hom.toAlgebra
  let : Algebra R A := (v.appLE W U.1 e).hom.toAlgebra
  let : Algebra R Bd := ((algebraMap A Bd).comp (algebraMap R A)).toAlgebra
  have : IsScalarTower R A Bd := .of_algebraMap_eq fun _ ↦ rfl
  have hsurj : Function.Surjective (algebraMap A Bd) := i.app_surjective U.1 U.2
  have hker : RingHom.ker (algebraMap A Bd) = i.ker.ideal U :=
    (Scheme.Hom.ker_apply i U).symm
  obtain ⟨hsmA, hrkA⟩ := (Algebra.locally_isStandardSmoothOfRelativeDimension_iff
    (R := R) (S := A) n).mp
      (locally_isStandardSmoothOfRelativeDimension_appLE_of_resLE v hW U.2 e n)
  have hBloc : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension m)
      (algebraMap R Bd) := by
    have := locally_isStandardSmoothOfRelativeDimension_appLE_of_resLE (i ≫ v) hW
      (U.2.preimage i) e' m
    convert this using 2
    have h : v.appLE W U.1 e ≫ i.app U.1 = (i ≫ v).appLE W (i ⁻¹ᵁ U.1) e' := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    rw [← h]
    rfl
  obtain ⟨hsmB, hrkB⟩ := (Algebra.locally_isStandardSmoothOfRelativeDimension_iff
    (R := R) (S := Bd) m).mp hBloc
  -- the prime of `i d`
  let p : Ideal A :=
    Ideal.comap (T.presheaf.germ U.1 (i d) hd).hom (IsLocalRing.maximalIdeal _)
  have hmemp : ∀ s, s ∈ p ↔ i d ∉ T.basicOpen s := fun s ↦ by
    rw [T.mem_basicOpen _ _ hd, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hkp : RingHom.ker (algebraMap A Bd) ≤ p := by
    have hsupp : i d ∈ T.zeroLocus (U := U.1) (i.ker.ideal U) :=
      (Scheme.IdealSheafData.mem_support_iff_of_mem hd).mp
        (i.range_subset_ker_support ⟨d, rfl⟩)
    intro s hs
    rw [hker] at hs
    exact (hmemp s).mpr ((T.mem_zeroLocus_iff _ _).mp hsupp s hs)
  obtain ⟨a, g, hap, hψ⟩ := Algebra.exists_etale_aeval_sumElim_of_ker hsurj f
    (hf.trans hker.symm) hrkA hrkB hmc p hkp
  have hxa : i d ∈ T.basicOpen a := by
    by_contra h
    exact hap ((hmemp a).mpr h)
  -- the generators on the basic open
  let U' : T.affineOpens := T.affineBasicOpen a
  have hle : U' ≤ U := T.basicOpen_le a
  let ρ := (T.presheaf.map (homOfLE (X := T.Opens) hle).op).hom
  let f' : Fin c → Γ(T, T.basicOpen a) := ρ ∘ f
  have hf' : Ideal.span (Set.range f') = i.ker.ideal U' := by
    rw [Set.range_comp, ← Ideal.map_span ρ, hf]
    exact Scheme.IdealSheafData.map_ideal _ hle
  -- the étale ring map
  have := U.2.isLocalization_basicOpen a
  let Tl := Localization.Away a
  let eT : Tl ≃ₐ[A] Γ(T, T.basicOpen a) := IsLocalization.algEquiv (Submonoid.powers a) Tl _
  let ψ := (MvPolynomial.aeval (algebraMap A Tl ∘ Sum.elim f g) :
    MvPolynomial (Fin c ⊕ Fin m) R →ₐ[R] Tl).toRingHom
  have heT (x : A) : eT (algebraMap A Tl x) = ρ x := AlgEquiv.commutes eT x
  -- the coordinates form a weakly regular sequence
  have hreg : RingTheory.Sequence.IsWeaklyRegular Γ(T, T.basicOpen a) (List.ofFn f') := by
    let σ := (MvPolynomial.sumAlgEquiv R (Fin c) (Fin m)).symm.toRingEquiv
    let Φ := (eT.toRingEquiv.toRingHom.comp ψ).comp σ.toRingHom
    have hΦ : Φ.Flat := by
      refine (RingHom.Flat.of_bijective σ.bijective).comp ?_
      refine RingHom.Flat.comp ?_ (RingHom.Flat.of_bijective eT.bijective)
      exact (RingHom.Etale.iff_flat_and_formallyUnramified.mp hψ).1
    have := (MvPolynomial.isWeaklyRegular_ofFn_X_sub_C (A := MvPolynomial (Fin m) R)
      (fun _ : Fin c ↦ 0)).map_of_flat hΦ
    have key : List.ofFn f' =
        (List.ofFn fun j : Fin c ↦ (MvPolynomial.X j - MvPolynomial.C 0 :
          MvPolynomial (Fin c) (MvPolynomial (Fin m) R))).map Φ := by
      rw [List.map_ofFn]
      congr 1
      funext j
      simp [Φ, σ, ψ, f', heT, MvPolynomial.sumAlgEquiv_symm_X]
    rw [key]
    exact this
  -- the étale morphism
  let ε : MvPolynomial (ULift.{u} (Fin c)) (MvPolynomial (ULift.{u} (Fin m)) R) ≃+*
      MvPolynomial (Fin c ⊕ Fin m) R :=
    ((MvPolynomial.renameEquiv _ Equiv.ulift).toRingEquiv.trans
      (MvPolynomial.mapEquiv (Fin c) (MvPolynomial.renameEquiv R Equiv.ulift).toRingEquiv)).trans
      (MvPolynomial.sumRingEquiv R (Fin c) (Fin m)).symm
  have hε : ∀ j, ε (MvPolynomial.X (ULift.up j)) = MvPolynomial.X (Sum.inl j) := by
    intro j
    simp [ε, MvPolynomial.sumRingEquiv_symm_X]
  let e₁ := U'.1.topIso.symm.commRingCatIsoToRingEquiv
  let φ := (e₁.toRingHom.comp eT.toRingEquiv.toRingHom).comp (ψ.comp ε.toRingHom)
  have hφ : φ.Etale := RingHom.Etale.respectsIso.1 _ e₁
    (RingHom.Etale.respectsIso.1 _ eT.toRingEquiv (RingHom.Etale.respectsIso.2 ψ ε hψ))
  have hφX : ∀ j, φ (MvPolynomial.X (ULift.up j)) = U'.1.topIso.inv (f' j) := by
    intro j
    simp only [φ, RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
      RingEquiv.coe_toRingHom]
    rw [hε]
    simp only [ψ, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, MvPolynomial.aeval_X,
      Function.comp_apply, Sum.elim_inl]
    erw [heT]
    rfl
  have : IsAffine U'.1.toScheme := U'.2
  let eA := AffineSpace.SpecIso (ULift.{u} (Fin m)) R
  have : IsIso (AffineSpace.map (ULift.{u} (Fin c)) eA.inv) :=
    ⟨⟨AffineSpace.map _ eA.hom, by rw [← AffineSpace.map_comp, eA.inv_hom_id, AffineSpace.map_id],
      by rw [← AffineSpace.map_comp, eA.hom_inv_id, AffineSpace.map_id]⟩⟩
  let E := (AffineSpace.SpecIso (ULift.{u} (Fin c))
      (.of (MvPolynomial (ULift.{u} (Fin m)) R))).inv ≫
    AffineSpace.map (ULift.{u} (Fin c)) eA.inv
  let h := U'.1.toScheme.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom φ) ≫ E
  refine ⟨a, f', h, hxa, hf', ?_, fun j ↦ ?_, hreg⟩
  · have : Etale (Spec.map (CommRingCat.ofHom φ)) := HasRingHomProperty.Spec_iff.mpr hφ
    infer_instance
  · simp only [h, E, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
      AffineSpace.map_appTop_coord]
    rw [AffineSpace.SpecIso_inv_appTop_coord]
    have key : (Spec.map (CommRingCat.ofHom φ)).appTop ((Scheme.ΓSpecIso _).inv
        (MvPolynomial.X (ULift.up j))) =
        (Scheme.ΓSpecIso Γ(U'.1.toScheme, ⊤)).inv (φ (MvPolynomial.X (ULift.up j))) := by
      rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality]
      rfl
    erw [key]
    rw [Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop, ← CommRingCat.comp_apply, Iso.inv_hom_id]
    exact hφX j

/-- **Étale coordinates of a smooth divisor.** Let `v : T ⟶ B` be smooth of relative dimension
`n` over a scheme `B` of finite type over a field `k`, and let `i : D ⟶ T` be a closed immersion
with `D` smooth over `B` and of codimension one at every point:
`dim 𝒪_{T,i(d)} = dim 𝒪_{D,d} + 1`. Then every point of `D` has an open neighbourhood `U` in `T`
with an étale morphism `h : U ⟶ 𝔸¹_Y`, `Y` separated and of finite type over `k`, such that
`D ∩ U` is set-theoretically the preimage of the zero section. -/
theorem exists_etale_affineLine_zeroSection_of_smooth_divisor
    {k : Type u} [Field k] {B T D : Scheme.{u}}
    (b : B ⟶ Spec (.of k)) [IsSeparated b] [LocallyOfFiniteType b] [QuasiCompact b]
    (v : T ⟶ B) (n : ℕ) [SmoothOfRelativeDimension n v] [LocallyOfFiniteType (v ≫ b)]
    (i : D ⟶ T) [IsClosedImmersion i] [Smooth (i ≫ v)] [LocallyOfFiniteType (i ≫ v ≫ b)]
    (hcodim : ∀ d : D, ringKrullDim (T.presheaf.stalk (i d)) =
      ringKrullDim (D.presheaf.stalk d) + (1 : WithBot ℕ∞)) (d : D) :
    ∃ (U : T.Opens) (_ : i d ∈ U) (Y : Scheme.{u}) (aY : Y ⟶ Spec (.of k))
      (_ : IsSeparated aY) (_ : LocallyOfFiniteType aY) (_ : QuasiCompact aY)
      (h : U.toScheme ⟶ AffineSpace (ULift.{u} (Fin 1)) Y) (_ : Etale h),
      U.ι ⁻¹' Set.range i = h ⁻¹' Set.range (AffineSpace.zeroSection (ULift.{u} (Fin 1)) Y) := by
  classical
  have : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian (v ≫ b)
  have : IsLocallyNoetherian D := LocallyOfFiniteType.isLocallyNoetherian (i ≫ v ≫ b)
  -- the local relative dimension of `D`
  obtain ⟨U₂, V₂, hU₂, -, hdV₂, e₂, m, hm⟩ :=
    Smooth.exists_smoothOfRelativeDimension_resLE (i ≫ v) d
  obtain ⟨W₂, hW₂, hV₂⟩ := i.isClosedEmbedding.isInducing.isOpen_iff.mp V₂.isOpen
  have hxG : i d ∈ (v ⁻¹ᵁ U₂ : Set T) ∩ W₂ :=
    ⟨e₂ hdV₂, by rw [← Set.mem_preimage, hV₂]; exact hdV₂⟩
  obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU₀, hU₀G⟩ := T.isBasis_affineOpens.exists_subset_of_mem_open hxG
    ((v ⁻¹ᵁ U₂).isOpen.inter hW₂)
  -- smoothness on the opens of `U₀`
  have hsm (U' : T.Opens) (hU' : U' ≤ U₀) :
      ∃ (e : U' ≤ v ⁻¹ᵁ U₂) (e' : i ⁻¹ᵁ U' ≤ (i ≫ v) ⁻¹ᵁ U₂),
        SmoothOfRelativeDimension n (v.resLE U₂ U' e) ∧
          SmoothOfRelativeDimension m ((i ≫ v).resLE U₂ (i ⁻¹ᵁ U') e') := by
    have e : U' ≤ v ⁻¹ᵁ U₂ := fun y hy ↦ (hU₀G (hU' hy)).1
    have hle : i ⁻¹ᵁ U' ≤ V₂ := fun y hy ↦ by
      rw [← SetLike.mem_coe, ← hV₂]
      exact (hU₀G (hU' hy)).2
    refine ⟨e, fun y hy ↦ e₂ (hle hy), IsZariskiLocalAtSource.resLE e inferInstance, ?_⟩
    have : SmoothOfRelativeDimension (0 + m) (D.homOfLE hle ≫ (i ≫ v).resLE U₂ V₂ e₂) :=
      inferInstance
    rwa [Scheme.Hom.map_resLE, zero_add] at this
  -- local equations of `D`
  obtain ⟨e₀, e₀', h₀, h₀'⟩ := hsm U₀ le_rfl
  have : IsNoetherianRing Γ(T, U₀) := IsLocallyNoetherian.component_noetherian ⟨U₀, hU₀⟩
  obtain ⟨c, a, f, hmc, hxa, hf⟩ :=
    exists_basicOpen_span_eq_ker_ideal v i hU₂ ⟨U₀, hU₀⟩ e₀ e₀' n m d hxU₀
  -- étale coordinates
  obtain ⟨e₁, e₁', h₁, h₁'⟩ := hsm (T.affineBasicOpen a).1 (T.basicOpen_le a)
  obtain ⟨a', f', h, hxa', hf', het, hcoord, hreg⟩ :=
    exists_etale_affineSpace_of_span_eq_ker_ideal v i hU₂ (T.affineBasicOpen a) e₁ e₁' hmc
      f hf d hxa
  -- the codimension is `c = 1`
  have hdim := ringKrullDim_stalk_eq_add_of_isWeaklyRegular i (T.affineBasicOpen a')
    (List.ofFn f') hreg (by
      rw [← hf', Ideal.ofList]
      congr 1
      ext y
      simp [List.mem_ofFn]) d hxa'
  obtain ⟨e, he⟩ : ∃ e : ℕ, ringKrullDim (D.presheaf.stalk d) = e := by
    have h₁ := ringKrullDim_ne_top (R := D.presheaf.stalk d)
    have h₂ := ringKrullDim_ne_bot (R := D.presheaf.stalk d)
    generalize ringKrullDim (D.presheaf.stalk d) = r at h₁ h₂ ⊢
    induction r using WithBot.recBotCoe with
    | bot => exact absurd rfl h₂
    | coe r =>
      induction r using ENat.recTopCoe with
      | top => exact absurd rfl h₁
      | coe r => exact ⟨r, rfl⟩
  rw [hcodim d, he, List.length_ofFn] at hdim
  have hc : c = 1 := by
    have : e + 1 = e + c := by exact_mod_cast hdim
    omega
  subst hc
  let φk : CommRingCat.of k ⟶ Γ(B, U₂) := (Scheme.ΓSpecIso (.of k)).inv ≫ b.appLE ⊤ U₂ le_top
  have hφk : φk.hom.FiniteType := by
    have h₁ := HasRingHomProperty.appLE @LocallyOfFiniteType b inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U₂, hU₂⟩ le_top
    refine RingHom.FiniteType.comp h₁ (RingHom.FiniteType.of_surjective _ fun x ↦
      ⟨(Scheme.ΓSpecIso (.of k)).hom x, ?_⟩)
    exact Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of k)) x
  have : LocallyOfFiniteType (Spec.map φk) := HasRingHomProperty.Spec_iff.mpr hφk
  let aY : 𝔸(ULift.{u} (Fin m); Spec Γ(B, U₂)) ⟶ Spec (.of k) :=
    (𝔸(ULift.{u} (Fin m); Spec Γ(B, U₂)) ↘ Spec Γ(B, U₂)) ≫ Spec.map φk
  refine ⟨T.basicOpen a', hxa', 𝔸(ULift.{u} (Fin m); Spec Γ(B, U₂)), aY, inferInstance,
    inferInstance, (HasAffineProperty.iff_of_isAffine (P := @QuasiCompact)).mpr inferInstance,
    h, het, ?_⟩
  -- the preimage of the zero section
  ext y
  have hrange : Set.range i = (i.ker.support : Set T) := by
    rw [Scheme.Hom.support_ker, i.isClosedEmbedding.isClosed_range.closure_eq]
  have key (j : ULift.{u} (Fin 1)) :
      h y ∈ 𝔸(ULift.{u} (Fin 1); 𝔸(ULift.{u} (Fin m); Spec Γ(B, U₂))).basicOpen
        (AffineSpace.coord _ j) ↔ (T.basicOpen a').ι y ∈ T.basicOpen (f' j.down) := by
    rw [← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen_top, hcoord j.down]
    rw [Scheme.Opens.mem_basicOpen_toScheme]
    simp only [Scheme.Opens.topIso_inv, Scheme.Opens.ι_apply]
    erw [Scheme.basicOpen_res_eq]
  simp only [Set.mem_preimage, AffineSpace.range_zeroSection, Set.mem_ofPred_eq, key]
  rw [hrange, SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem
    (U := T.affineBasicOpen a') (x := (T.basicOpen a').ι y) (by simp), ← hf',
    Scheme.zeroLocus_span, Scheme.mem_zeroLocus_iff]
  exact ⟨fun H j ↦ H _ ⟨j.down, rfl⟩, fun H _ ⟨j, hj⟩ ↦ hj ▸ H ⟨j⟩⟩

end AlgebraicGeometry
