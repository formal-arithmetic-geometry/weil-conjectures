module

public import WeilConjectures.AlgebraicGeometry.DeformationToNormalCone
public import WeilConjectures.AlgebraicGeometry.DeformationSpace.BaseChangeSection
public import WeilConjectures.AlgebraicGeometry.DeformationSpace.ReesBaseChange
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Affine

/-!
# Charts of the deformation space of a base-changed section

Let `g : V ⟶ B` be smooth of relative dimension `d` with closed section `s`, and let
`b : B' ⟶ B` be arbitrary, with base change `g' : V' = V ×_B B' ⟶ B'`, projection
`h : V' ⟶ V` and section `s'`. This file shows that around every point of `V'` there are
affine opens `U' ⊆ h⁻¹ U` on which the extended Rees algebra of `s'` is the base change of the
extended Rees algebra of `s`, i.e. "`D_{s'} V' = D_s V ×_V V'` locally".

## Main statements

- `RingHom.IsStableUnderBaseChange.of_isPushout`: stable properties of ring maps transfer
  along pushout squares in `CommRingCat`.
- `CategoryTheory.IsPullback.isPushout_appLE_inf_preimage`: the sections of a fibre product over
  the intersection of preimages of affine opens form a pushout of rings.
- `AlgebraicGeometry.Scheme.Hom.exists_isPushout_extendedReesAlgebraMap_baseChange`: the
  local base change property of the extended Rees algebras.
-/

@[expose] public section

universe u

open CategoryTheory Limits

/-! ### General lemmas -/

/-- A property of ring maps which is stable under base change and respects isomorphisms passes
along pushout squares in `CommRingCat`: if `f` has it, then so does `inr`, the base change of `f`
along `g`. -/
lemma RingHom.IsStableUnderBaseChange.of_isPushout
    {P : ∀ {R S : Type u} [CommRing R] [CommRing S], (R →+* S) → Prop}
    (hP : RingHom.IsStableUnderBaseChange @P) (hP' : RingHom.RespectsIso @P)
    {R S T Q : CommRingCat.{u}} {f : R ⟶ S} {g : R ⟶ T} {inl : S ⟶ Q} {inr : T ⟶ Q}
    (h : IsPushout f g inl inr) (hf : P f.hom) : P inr.hom := by
  rw [← h.flip.inl_isoPushout_inv, CommRingCat.hom_comp, hP'.cancel_right_isIso]
  exact hP.pushout_inl hP' g f hf

namespace CategoryTheory.IsPullback

open AlgebraicGeometry

variable {P X Y S : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ S} {g : Y ⟶ S}

/-- The restriction of a pullback square to opens `U ⊆ f⁻¹ W` and `U' ⊆ g⁻¹ W` and to
`fst⁻¹ U ∩ snd⁻¹ U'` is a pullback square of morphisms of schemes. -/
lemma isPullback_resLE_inf_preimage (H : IsPullback fst snd f g) {W : S.Opens} {U : X.Opens}
    (hUW : U ≤ f ⁻¹ᵁ W) {U' : Y.Opens} (hU'W : U' ≤ g ⁻¹ᵁ W) :
    IsPullback (fst.resLE U (fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ U') inf_le_left)
      (snd.resLE U' (fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ U') inf_le_right) (f.resLE W U hUW)
      (g.resLE W U' hU'W) :=
  Scheme.Hom.isPullback_resLE H hU'W hUW rfl

/-- In a pullback square, the intersection `fst⁻¹ U ∩ snd⁻¹ U'` of the preimages of affine opens
`U ⊆ f⁻¹ W` and `U' ⊆ g⁻¹ W` over an affine open `W` is affine. -/
lemma isAffineOpen_inf_preimage (H : IsPullback fst snd f g) {W : S.Opens}
    (hW : IsAffineOpen W) {U : X.Opens} (hU : IsAffineOpen U) (hUW : U ≤ f ⁻¹ᵁ W)
    {U' : Y.Opens} (hU' : IsAffineOpen U') (hU'W : U' ≤ g ⁻¹ᵁ W) :
    IsAffineOpen (fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ U') := by
  have : IsAffine W.toScheme := hW
  have : IsAffine U.toScheme := hU
  have : IsAffine U'.toScheme := hU'
  exact IsAffine.of_isPullback (H.isPullback_resLE_inf_preimage hUW hU'W)

/-- **Affine charts of a fibre product.** In a pullback square, the sections over the
intersection `fst⁻¹ U ∩ snd⁻¹ U'` of the preimages of affine opens `U ⊆ f⁻¹ W` and
`U' ⊆ g⁻¹ W` over an affine open `W` are `Γ(X, U) ⊗_{Γ(S, W)} Γ(Y, U')`. -/
lemma isPushout_appLE_inf_preimage (H : IsPullback fst snd f g) {W : S.Opens}
    (hW : IsAffineOpen W) {U : X.Opens} (hU : IsAffineOpen U) (hUW : U ≤ f ⁻¹ᵁ W)
    {U' : Y.Opens} (hU' : IsAffineOpen U') (hU'W : U' ≤ g ⁻¹ᵁ W) :
    IsPushout (f.appLE W U hUW) (g.appLE W U' hU'W)
      (fst.appLE U (fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ U') inf_le_left)
      (snd.appLE U' (fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ U') inf_le_right) := by
  have : IsAffine W.toScheme := hW
  have : IsAffine U.toScheme := hU
  have : IsAffine U'.toScheme := hU'
  refine (isPushout_appTop_of_isPullback (H.isPullback_resLE_inf_preimage hUW hU'W)).of_iso
    W.topIso U.topIso U'.topIso (fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ U').topIso ?_ ?_ ?_ ?_ <;>
    simp [Scheme.Hom.appTop]

end CategoryTheory.IsPullback

namespace Ideal

variable {C C' A A' : Type u} [CommRing C] [CommRing C'] [CommRing A] [CommRing A'] {σ : Type}

/-- Variant of `Ideal.isPushout_extendedReesAlgebraMap_map_mvPolynomialOrigin` for ideals which
are only propositionally equal to the ideals generated by the coordinates. -/
lemma isPushout_extendedReesAlgebraMap_of_eq_map_mvPolynomialOrigin (κ : C →+* C')
    (ψ : MvPolynomial σ C →+* A) (ψ' : MvPolynomial σ C' →+* A') (a : A →+* A') (hψ : ψ.Flat)
    (hψ' : ψ'.Flat) (h : a.comp ψ = ψ'.comp (MvPolynomial.map κ)) (I : Ideal A) (J : Ideal A')
    (hI : I = (mvPolynomialOrigin C σ).map ψ) (hJ : J = (mvPolynomialOrigin C' σ).map ψ')
    (hle : I.map a ≤ J) :
    IsPushout (CommRingCat.ofHom a) (CommRingCat.ofHom (algebraMap A I.extendedReesAlgebra))
      (CommRingCat.ofHom (algebraMap A' J.extendedReesAlgebra))
      (CommRingCat.ofHom (I.extendedReesAlgebraMap a J hle)) := by
  subst hI hJ
  exact isPushout_extendedReesAlgebraMap_map_mvPolynomialOrigin κ ψ ψ' a hψ hψ' h

/-- Variant of `Ideal.isPushout_extendedReesAlgebraMap_top` for ideals which are only
propositionally equal to the unit ideals. -/
lemma isPushout_extendedReesAlgebraMap_of_eq_top (a : A →+* A') (I : Ideal A) (J : Ideal A')
    (hI : I = ⊤) (hJ : J = ⊤) (hle : I.map a ≤ J) :
    IsPushout (CommRingCat.ofHom a) (CommRingCat.ofHom (algebraMap A I.extendedReesAlgebra))
      (CommRingCat.ofHom (algebraMap A' J.extendedReesAlgebra))
      (CommRingCat.ofHom (I.extendedReesAlgebraMap a J hle)) := by
  subst hI hJ
  exact isPushout_extendedReesAlgebraMap_top a

end Ideal

/-! ### Charts of the deformation space of the base-changed section -/

namespace AlgebraicGeometry

variable {V B B' : Scheme.{u}} (g : V ⟶ B) (s : B ⟶ V) (hs : s ≫ g = 𝟙 B) (b : B' ⟶ B)

/-- The ideal of the base-changed section `s'` over an affine open `U' ⊆ h⁻¹ U` is generated by
the ideal of `s` over `U`. -/
lemma Scheme.Hom.siteIdeal_ker_baseChangeSection [IsClosedImmersion s]
    (U' : (pullback g b).AffineZariskiSite) (U : V.AffineZariskiSite)
    (hU : U'.1 ≤ pullback.fst g b ⁻¹ᵁ U.1) :
    (baseChangeSection g s hs b).ker.siteIdeal U' =
      (s.ker.siteIdeal U).map ((pullback.fst g b).appLE U.1 U'.1 hU).hom := by
  rw [IdealSheafData.siteIdeal, ker_baseChangeSection,
    IdealSheafData.ideal_comap_appLE s.ker _ ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU]

/-- Away from the section, the chart condition of
`Scheme.Hom.exists_isPushout_extendedReesAlgebraMap_baseChange` holds with unit ideals. -/
lemma Scheme.Hom.exists_isPushout_extendedReesAlgebraMap_baseChange_of_notMem
    [IsClosedImmersion s] (x : ↥(pullback g b)) (hx : pullback.fst g b x ∉ Set.range s) :
    ∃ (U' : (pullback g b).AffineZariskiSite) (U : V.AffineZariskiSite)
      (hU : U'.1 ≤ pullback.fst g b ⁻¹ᵁ U.1), x ∈ U'.1 ∧
      ∃ hle : (s.ker.siteIdeal U).map ((pullback.fst g b).appLE U.1 U'.1 hU).hom ≤
          (baseChangeSection g s hs b).ker.siteIdeal U',
        IsPushout ((pullback.fst g b).appLE U.1 U'.1 hU)
          (CommRingCat.ofHom (algebraMap Γ(V, U.1) (s.ker.siteIdeal U).extendedReesAlgebra))
          (CommRingCat.ofHom (algebraMap Γ(pullback g b, U'.1)
            ((baseChangeSection g s hs b).ker.siteIdeal U').extendedReesAlgebra))
          (CommRingCat.ofHom ((s.ker.siteIdeal U).extendedReesAlgebraMap
            ((pullback.fst g b).appLE U.1 U'.1 hU).hom _ hle)) := by
  let O : V.Opens := ⟨(Set.range s)ᶜ, s.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  obtain ⟨U, hU, hxU, hUO⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp V.isBasis_affineOpens
    (U := O) hx
  obtain ⟨U', hU', hxU', hU'U⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (pullback g b).isBasis_affineOpens (U := pullback.fst g b ⁻¹ᵁ U) hxU
  have hI : s.ker.siteIdeal ⟨U, hU⟩ = ⊤ := by
    rw [IdealSheafData.siteIdeal, Scheme.Hom.ker_apply, Ideal.eq_top_iff_one, RingHom.mem_ker]
    have : s ⁻¹ᵁ U = ⊥ := eq_bot_iff.mpr fun b hb ↦ hUO hb ⟨b, rfl⟩
    have : Subsingleton Γ(B, s ⁻¹ᵁ U) := by
      rw [this]
      infer_instance
    exact Subsingleton.elim _ _
  have hJ := siteIdeal_ker_baseChangeSection g s hs b ⟨U', hU'⟩ ⟨U, hU⟩ hU'U
  refine ⟨⟨U', hU'⟩, ⟨U, hU⟩, hU'U, hxU', hJ.ge, ?_⟩
  refine Ideal.isPushout_extendedReesAlgebraMap_of_eq_top _ _ _ hI ?_ _
  rw [hJ, hI, Ideal.map_top]

/-- Near the section, the chart condition of
`Scheme.Hom.exists_isPushout_extendedReesAlgebraMap_baseChange` holds on étale coordinates. -/
lemma Scheme.Hom.exists_isPushout_extendedReesAlgebraMap_baseChange_of_mem (d : ℕ)
    [SmoothOfRelativeDimension d g] [IsClosedImmersion s] (x : ↥(pullback g b))
    (hx : pullback.fst g b x ∈ Set.range s) :
    ∃ (U' : (pullback g b).AffineZariskiSite) (U : V.AffineZariskiSite)
      (hU : U'.1 ≤ pullback.fst g b ⁻¹ᵁ U.1), x ∈ U'.1 ∧
      ∃ hle : (s.ker.siteIdeal U).map ((pullback.fst g b).appLE U.1 U'.1 hU).hom ≤
          (baseChangeSection g s hs b).ker.siteIdeal U',
        IsPushout ((pullback.fst g b).appLE U.1 U'.1 hU)
          (CommRingCat.ofHom (algebraMap Γ(V, U.1) (s.ker.siteIdeal U).extendedReesAlgebra))
          (CommRingCat.ofHom (algebraMap Γ(pullback g b, U'.1)
            ((baseChangeSection g s hs b).ker.siteIdeal U').extendedReesAlgebra))
          (CommRingCat.ofHom ((s.ker.siteIdeal U).extendedReesAlgebraMap
            ((pullback.fst g b).appLE U.1 U'.1 hU).hom _ hle)) := by
  obtain ⟨b₀, hb₀⟩ := hx
  obtain ⟨W, hW, U, hUW, hb₀W, hsU, ψ, hψ, hψf, hI⟩ :=
    exists_etale_coordinates_of_mem_range g s d hs b₀
  have hxU : pullback.fst g b x ∈ U.1 := by
    rw [← hb₀, ← Scheme.Hom.mem_preimage, hsU]
    exact hb₀W
  have hxW : pullback.snd g b x ∈ b ⁻¹ᵁ W := by
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, ← pullback.condition,
      Scheme.Hom.comp_apply, ← hb₀,
      ← Scheme.Hom.comp_apply, hs]
    exact hb₀W
  obtain ⟨W', hW', hxW', hW'W⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    B'.isBasis_affineOpens hxW
  have H := IsPullback.of_hasPullback g b
  have hT := H.isAffineOpen_inf_preimage hW U.2 hUW hW' hW'W
  have P₁ := H.isPushout_appLE_inf_preimage hW U.2 hUW hW' hW'W
  set T := pullback.fst g b ⁻¹ᵁ U.1 ⊓ pullback.snd g b ⁻¹ᵁ W'
  set κ := (b.appLE W W' hW'W).hom
  set a := ((pullback.fst g b).appLE U.1 T inf_le_left).hom
  set ψ' : MvPolynomial (Fin d) Γ(B', W') →+* Γ(pullback g b, T) :=
    MvPolynomial.eval₂Hom ((pullback.snd g b).appLE W' T inf_le_right).hom
      fun i ↦ a (ψ (MvPolynomial.X i))
  have hcomp : a.comp ψ = ψ'.comp (MvPolynomial.map κ) := by
    refine MvPolynomial.ringHom_ext (fun c ↦ ?_) fun i ↦ ?_
    · have := congr($(P₁.w).hom c)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C, ← RingHom.comp_apply ψ,
        hψf]
      simpa [ψ'] using this
    · simp [ψ']
  -- `C' ⊗_C C[X_i] = C'[X_i]`
  have t : IsPushout (CommRingCat.ofHom MvPolynomial.C) (CommRingCat.ofHom κ)
      (CommRingCat.ofHom (MvPolynomial.map κ)) (CommRingCat.ofHom (MvPolynomial.C (σ := Fin d)))
      := by
    let := κ.toAlgebra
    let := MvPolynomial.algebraMvPolynomial (σ := Fin d) (R := Γ(B, W)) (S := Γ(B', W'))
    exact (CommRingCat.isPushout_of_isPushout Γ(B, W) Γ(B', W') (MvPolynomial (Fin d) Γ(B, W))
      (MvPolynomial (Fin d) Γ(B', W'))).flip
  have outer : IsPushout (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ)
      (CommRingCat.ofHom κ) (CommRingCat.ofHom a)
      (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ') := by
    have e₁ : CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ = g.appLE W U.1 hUW := by
      ext1
      exact hψf
    have e₂ : CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ' =
        (pullback.snd g b).appLE W' T inf_le_right := by
      ext1
      exact MvPolynomial.eval₂Hom_comp_C _ _
    rw [e₁, e₂]
    exact P₁
  have Q := outer.of_left (CommRingCat.hom_ext hcomp) t
  have hψ' : ψ'.Flat := RingHom.Flat.isStableUnderBaseChange.of_isPushout
    RingHom.Flat.respectsIso Q (RingHom.Etale.iff_flat_and_formallyUnramified.mp hψ).1
  have hJ := siteIdeal_ker_baseChangeSection g s hs b ⟨T, hT⟩ U inf_le_left
  refine ⟨⟨T, hT⟩, U, inf_le_left, ⟨hxU, hxW'⟩, hJ.ge, ?_⟩
  refine Ideal.isPushout_extendedReesAlgebraMap_of_eq_map_mvPolynomialOrigin κ ψ ψ' a
    (RingHom.Etale.iff_flat_and_formallyUnramified.mp hψ).1 hψ' hcomp _ _ hI ?_ _
  rw [hJ, hI]
  exact Ideal.map_map_mvPolynomialOrigin κ ψ ψ' a hcomp

/-- **Charts of the deformation space of a base-changed section.** Around every point of
`V' = V ×_B B'` there are affine opens `U' ⊆ h⁻¹ U` such that the extended Rees algebra of the
base-changed section `s'` over `U'` is the base change of the extended Rees algebra of `s` over
`U`: locally, `D_{s'} V' = D_s V ×_V V'`. -/
theorem Scheme.Hom.exists_isPushout_extendedReesAlgebraMap_baseChange (d : ℕ)
    [SmoothOfRelativeDimension d g] [IsClosedImmersion s] (x : ↥(pullback g b)) :
    ∃ (U' : (pullback g b).AffineZariskiSite) (U : V.AffineZariskiSite)
      (hU : U'.1 ≤ pullback.fst g b ⁻¹ᵁ U.1), x ∈ U'.1 ∧
      ∃ hle : (s.ker.siteIdeal U).map ((pullback.fst g b).appLE U.1 U'.1 hU).hom ≤
          (baseChangeSection g s hs b).ker.siteIdeal U',
        IsPushout ((pullback.fst g b).appLE U.1 U'.1 hU)
          (CommRingCat.ofHom (algebraMap Γ(V, U.1) (s.ker.siteIdeal U).extendedReesAlgebra))
          (CommRingCat.ofHom (algebraMap Γ(pullback g b, U'.1)
            ((baseChangeSection g s hs b).ker.siteIdeal U').extendedReesAlgebra))
          (CommRingCat.ofHom ((s.ker.siteIdeal U).extendedReesAlgebraMap
            ((pullback.fst g b).appLE U.1 U'.1 hU).hom _ hle)) := by
  by_cases hx : pullback.fst g b x ∈ Set.range s
  · exact exists_isPushout_extendedReesAlgebraMap_baseChange_of_mem g s hs b d x hx
  · exact exists_isPushout_extendedReesAlgebraMap_baseChange_of_notMem g s hs b x hx

end AlgebraicGeometry
