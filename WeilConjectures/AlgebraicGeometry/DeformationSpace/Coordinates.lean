module

public import WeilConjectures.AlgebraicGeometry.DeformationToNormalCone

/-!
# Étale coordinates on the deformation to the normal cone

Let `g : V ⟶ B` be smooth of relative dimension `d` with a closed section `s`. Étale-locally on
`B` there are coordinates `x₁, …, x_d` on `V` over `B` in which `s` is the origin, and on the
chart `u_i = x_i / t` the deformation space `D_s V` is étale over `𝔸^d_{𝔸¹_B}`, with the section
`s̃` going to the zero section (blueprint `sk-lem-geometry` (2), (4), (5)). Together with the
constructions of `WeilConjectures.AlgebraicGeometry.DeformationToNormalCone`, this gives the
deformation datum of blueprint `sk-lem-geometry`.

## Main statements

- `AlgebraicGeometry.Scheme.Hom.nonempty_deformationToNormalConeData`
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {V B : Scheme.{u}}

/-- The extended Rees algebra of the ideal generated by étale coordinates
`ψ : C[X₁, …, X_d] ⟶ A` is étale over the extended Rees algebra `C[t][U₁, …, U_d]` of the
origin: it is the base change of `ψ`. -/
lemma etale_specMap_extendedReesAlgebraMap {C A : Type u} [CommRing C] [CommRing A] {d : ℕ}
    (ψ : MvPolynomial (Fin d) C →+* A) (hψ : ψ.Etale) (I : Ideal A)
    (hI : (Ideal.mvPolynomialOrigin C (Fin d)).map ψ = I) :
    Etale (Spec.map (CommRingCat.ofHom
      ((Ideal.mvPolynomialOrigin C (Fin d)).extendedReesAlgebraMap ψ I hI.le))) := by
  subst hI
  let := ψ.toAlgebra
  have : Algebra.Etale (MvPolynomial (Fin d) C) A := hψ
  have hpush := CommRingCat.isPushout_of_isPushout (MvPolynomial (Fin d) C) A
    (Ideal.mvPolynomialOrigin C (Fin d)).extendedReesAlgebra
    ((Ideal.mvPolynomialOrigin C (Fin d)).map
      (algebraMap (MvPolynomial (Fin d) C) A)).extendedReesAlgebra
  have : Etale (Spec.map (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin d) C) A))) :=
    HasRingHomProperty.Spec_iff.mpr hψ
  exact MorphismProperty.of_isPullback (isPullback_SpecMap_of_isPushout _ _ _ _ hpush) this

namespace Scheme.Hom

open AffineZariskiSite

open _root_.Polynomial in
/-- **Étale coordinates on one chart.** Around every point `b` of `B` there are an affine open
immersion `v : B' ⟶ B` and an affine open chart `W` of the base change of the deformation space
to `𝔸¹_{B'}` which is étale over `𝔸^d_{𝔸¹_{B'}}`, compatibly with the projections, and contains
the base change of the section, which it carries to the zero section. -/
lemma exists_etale_coordinates_deformationSpace_of_mem (d : ℕ) (g : V ⟶ B)
    [SmoothOfRelativeDimension d g] (s : B ⟶ V) [IsClosedImmersion s] (hs : s ≫ g = 𝟙 B)
    (b : B) :
    ∃ (B' : Scheme.{u}) (_ : IsAffine B') (v : B' ⟶ B) (W : Scheme.{u}) (_ : IsAffine W)
      (j : W ⟶ pullback (deformationSpaceProj g s) (AffineSpace.map (ULift.{u} (Fin 1)) v))
      (c : W ⟶ 𝔸(ULift.{u} (Fin d); 𝔸(ULift.{u} (Fin 1); B')))
      (σ : 𝔸(ULift.{u} (Fin 1); B') ⟶ W),
      IsOpenImmersion v ∧ b ∈ Set.range v ∧ IsOpenImmersion j ∧ Etale c ∧
      j ≫ pullback.snd _ _ =
        c ≫ 𝔸(ULift.{u} (Fin d); 𝔸(ULift.{u} (Fin 1); B')) ↘ 𝔸(ULift.{u} (Fin 1); B') ∧
      σ ≫ j ≫ pullback.fst _ _ =
        AffineSpace.map (ULift.{u} (Fin 1)) v ≫ s.deformationSpaceSection ∧
      σ ≫ c = AffineSpace.zeroSection (ULift.{u} (Fin d)) 𝔸(ULift.{u} (Fin 1); B') := by
  obtain ⟨W, hW, U, hUW, hbW, hsU, ψ, hψ, hψf, hI⟩ :=
    exists_etale_coordinates_of_mem_range g s d hs b
  -- the affine line over `Spec Γ(B, W)`
  let e₁ : Spec (.of Γ(B, W)[X]) ⟶ 𝔸(ULift.{u} (Fin 1); Spec Γ(B, W)) :=
    AffineSpace.homOfVector (Spec.map (CommRingCat.ofHom C))
      fun _ ↦ (Scheme.ΓSpecIso (.of Γ(B, W)[X])).inv X
  have : IsIso e₁ := isIso_homOfVector_specPolynomial Γ(B, W)
  have : IsIso (AffineSpace.map (ULift.{u} (Fin d)) e₁) :=
    ⟨AffineSpace.map _ (inv e₁), by
      rw [← AffineSpace.map_comp, IsIso.hom_inv_id, AffineSpace.map_id], by
      rw [← AffineSpace.map_comp, IsIso.inv_hom_id, AffineSpace.map_id]⟩
  -- the chart of the deformation space
  let ιU := colimit.ι (relativeGluingData s.ker.coequifibered_toReesPresheaf).functor U
  let p := Spec.map (CommRingCat.ofHom ((s.ker.siteIdeal U).toExtendedReesAlgebra.comp
    (mapRingHom (g.appLE W U.1 hUW).hom)))
  have hp : ιU ≫ deformationSpaceProj g s = (p ≫ e₁) ≫ AffineSpace.map _ hW.fromSpec := by
    rw [Category.assoc, AffineSpace.homOfVector_map]
    exact ι_deformationSpaceProj g s U hW hUW
  -- the étale coordinates `u_i = x_i / t`
  let e := (MvPolynomial.renameEquiv Γ(B, W)[X] Equiv.ulift.{u}).toRingEquiv.trans
    (Ideal.mvPolynomialExtendedReesAlgebraEquiv Γ(B, W) (Fin d))
  let θ := ((Ideal.mvPolynomialOrigin Γ(B, W) (Fin d)).extendedReesAlgebraMap ψ
    (s.ker.siteIdeal U) hI.ge).comp e.toRingHom
  let T := (AffineSpace.SpecIso (ULift.{u} (Fin d)) (.of Γ(B, W)[X])).inv ≫
    AffineSpace.map _ e₁
  -- the section
  let ιQ := colimit.ι
    (relativeGluingData s.ker.coequifibered_toQuotientPolynomialAlgebra).functor U
  have hrange : Set.range (AffineSpace.map (ULift.{u} (Fin 1)) hW.fromSpec ≫
      s.affineSpaceToQuotientPolynomialSpec) ⊆ Set.range ιQ := by
    rintro _ ⟨x, rfl⟩
    have h : (AffineSpace.map _ hW.fromSpec ≫ s.affineSpaceToQuotientPolynomialSpec) ≫
        (relativeGluingData s.ker.coequifibered_toQuotientPolynomialAlgebra).toBase =
        (𝔸(ULift.{u} (Fin 1); Spec Γ(B, W)) ↘ Spec Γ(B, W)) ≫ hW.fromSpec ≫ s := by
      rw [← relativeGluingMap_toBase s.ker.coequifibered_toQuotientAlgebra
        s.ker.coequifibered_toQuotientPolynomialAlgebra _ rfl, Category.assoc,
        affineSpaceToQuotientPolynomialSpec_toQuotientSpec_assoc, toQuotientSpec_toBase,
        AffineSpace.map_over_assoc]
    have hmem : (AffineSpace.map _ hW.fromSpec ≫ s.affineSpaceToQuotientPolynomialSpec) x ∈
        (relativeGluingData s.ker.coequifibered_toQuotientPolynomialAlgebra).toBase ⁻¹ᵁ U.1 := by
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply,
        Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage, hsU]
      exact hW.range_fromSpec.le ⟨_, rfl⟩
    rw [toBase_preimage] at hmem
    exact hmem
  let τ := IsOpenImmersion.lift ιQ _ hrange
  let ρ := s.ker.reesToQuotientPolynomial.app (.op U)
  have hfst : (τ ≫ Spec.map ρ) ≫ ιU =
      AffineSpace.map (ULift.{u} (Fin 1)) hW.fromSpec ≫ s.deformationSpaceSection := by
    rw [Category.assoc, ← ι_relativeGluingMap, IsOpenImmersion.lift_fac_assoc,
      deformationSpaceSection, Category.assoc]
  have hθC : θ.comp MvPolynomial.C =
      (s.ker.siteIdeal U).toExtendedReesAlgebra.comp (mapRingHom (g.appLE W U.1 hUW).hom) := by
    refine RingHom.ext fun q ↦ Subtype.ext ?_
    simp [θ, e, Ideal.mvPolynomialToLaurent_C, LaurentPolynomial.mapRingHom_toLaurent,
      Polynomial.map_map, hψf]
  have hsnd : (Spec.map (CommRingCat.ofHom θ) ≫ T) ≫
      𝔸(ULift.{u} (Fin d); 𝔸(ULift.{u} (Fin 1); Spec Γ(B, W))) ↘
        𝔸(ULift.{u} (Fin 1); Spec Γ(B, W)) = p ≫ e₁ := by
    rw [Category.assoc, Category.assoc, AffineSpace.map_over, AffineSpace.SpecIso_inv_over_assoc,
      ← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, hθC]
  refine ⟨Spec Γ(B, W), inferInstance, hW.fromSpec, Spec (.of (s.ker.siteIdeal U).extendedReesAlgebra),
    inferInstance, pullback.lift ιU (p ≫ e₁) hp, Spec.map (CommRingCat.ofHom θ) ≫ T,
    τ ≫ Spec.map ρ, inferInstance, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hW.range_fromSpec]
    exact hbW
  · have : IsOpenImmersion (pullback.lift ιU (p ≫ e₁) hp ≫ pullback.fst _ _) := by
      rw [pullback.lift_fst]
      infer_instance
    exact IsOpenImmersion.of_comp _ (pullback.fst _ _)
  · have := etale_specMap_extendedReesAlgebraMap ψ hψ _ hI.symm
    have : IsIso (CommRingCat.ofHom e.toRingHom) :=
      inferInstanceAs (IsIso e.toCommRingCatIso.hom)
    rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
    infer_instance
  · rw [pullback.lift_snd, hsnd]
  · rw [pullback.lift_fst, hfst]
  · refine AffineSpace.hom_ext ?_ fun k ↦ ?_
    · rw [Category.assoc, hsnd, AffineSpace.zeroSection_over,
        ← cancel_mono (AffineSpace.map (ULift.{u} (Fin 1)) hW.fromSpec), Category.id_comp,
        Category.assoc, Category.assoc, ← hp, reassoc_of% hfst,
        deformationSpaceSection_deformationSpaceProj hs, Category.comp_id]
    · have hT : T.appTop (AffineSpace.coord _ k) = (Scheme.ΓSpecIso _).inv (MvPolynomial.X k) := by
        rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, AffineSpace.map_appTop_coord,
          AffineSpace.SpecIso_inv_appTop_coord]
      have hmem : ψ (MvPolynomial.X k.down) ∈ s.ker.siteIdeal U :=
        hI ▸ Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨_, rfl⟩)
      have hθX : θ (MvPolynomial.X k) =
          ⟨_, Ideal.C_mul_T_neg_one_mem_extendedReesAlgebra hmem⟩ :=
        Subtype.ext (by simp [θ, e, Ideal.mvPolynomialToLaurent_X])
      have hzero : (CommRingCat.ofHom θ ≫ ρ) (MvPolynomial.X k) = 0 := by
        rw [CommRingCat.comp_apply, CommRingCat.ofHom_apply, hθX]
        exact Ideal.extendedReesAlgebraToPolynomial_C_mul_T_neg_one _ Ideal.mk_ker.ge hmem
      have hΓ : (Spec.map (CommRingCat.ofHom θ ≫ ρ)).appTop
          (T.appTop (AffineSpace.coord _ k)) = 0 := by
        rw [hT, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply,
          hzero, map_zero]
      rw [Category.assoc, ← Spec.map_comp_assoc, Scheme.Hom.comp_appTop,
        CommRingCat.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, hΓ, map_zero,
        AffineSpace.zeroSection_appTop_coord]

/-- Blueprint `sk-lem-geometry`: Geometry of the deformation of a section

**Existence of the deformation to the normal cone.** Let `g : V ⟶ B` be smooth of pure
relative dimension `d` with a closed section `s`, and let `N_s ⟶ B` be the normal cone of `s`
(`AlgebraicGeometry.Scheme.Hom.normalConeData`) with its zero section. Then the deformation
datum of `AlgebraicGeometry.Scheme.Hom.DeformationToNormalConeData` exists, with fibre `N_s`
over `t = 0`: the deformation space is the relative spectrum `D_s V = Spec_V 𝒪_V[t, I t⁻¹]` of the
extended Rees algebra of the ideal `I` of `s`. Its fibre over `t = 1` is `V` and over `t = 0` the
normal cone, over the punctured line it is `V ×_B 𝔾_{m,B}`, and `g̃` is smooth of relative
dimension `d`. As `g` is separated and quasi-compact over a quasi-compact quasi-separated base,
`g̃` is separated and compactifiable.

TODO: the étale-local coordinates (`exists_etale_coordinates`, clauses (2), (4) and (5)) are not
yet constructed; the charts of `smoothOfRelativeDimension_deformationSpaceProj` are their
Zariski-local form. -/
theorem nonempty_deformationToNormalConeData (d : ℕ) (g : V ⟶ B)
    [SmoothOfRelativeDimension d g] [IsSeparated g] [QuasiCompact g] [CompactSpace B]
    [QuasiSeparatedSpace B] (s : B ⟶ V) [IsClosedImmersion s] (hs : s ≫ g = 𝟙 B) :
    Nonempty (DeformationToNormalConeData d g s (normalConeData d hs)) :=
  have := smoothOfRelativeDimension_deformationSpaceProj d g s hs
  have hm : ((puncturedLine B).ι ≫ s.deformationSpaceSection) ≫ deformationSpaceProj g s =
      𝟙 _ ≫ (puncturedLine B).ι := by
    rw [Category.assoc, deformationSpaceSection_deformationSpaceProj hs, Category.comp_id,
      Category.id_comp]
  have P := isPullback_deformationSpaceGeneric g s
  ⟨{ scheme := s.ker.deformationSpace
     proj := deformationSpaceProj g s
     sect := s.deformationSpaceSection
     sect_comp_proj := deformationSpaceSection_deformationSpaceProj hs
     smoothOfRelativeDimension_proj := this
     isSeparated_proj := inferInstance
     hasCompactification_proj := hasCompactification_deformationSpaceProj g s d hs
     oneFibre := deformationSpaceOneFibre g s
     isPullback_oneFibre := isPullback_deformationSpaceOneFibre g s
     comp_oneFibre := comp_deformationSpaceOneFibre hs
     zeroFibre := s.ker.normalConeToDeformationSpace
     isPullback_zeroFibre := isPullback_normalConeToDeformationSpace g s
     comp_zeroFibre := normalConeZeroSection_comp_normalConeToDeformationSpace
     puncturedLine := puncturedLine B
     coe_puncturedLine := coe_puncturedLine B
     generic := deformationSpaceGeneric g s
     isPullback_generic := P
     exists_sect_generic := ⟨P.lift _ _ hm, by
       rw [← deformationSpaceGeneric_toBase g s, P.lift_fst_assoc, Category.assoc,
         deformationSpaceSection_toBase, Category.assoc], P.lift_snd _ _ _, P.lift_fst _ _ _⟩
     exists_etale_coordinates := sorry }⟩


end Scheme.Hom

end AlgebraicGeometry
