module

public import WeilConjectures.AlgebraicGeometry.DeformationSpace.BlowupCenter
public import WeilConjectures.Blowup.BlowupUniversal

/-!
# The deformation space maps to the blow-up model

Let `I` be a quasi-coherent ideal on a scheme `X`, `D_I X = Spec_X 𝒪_X[t, I t⁻¹]` the Rees model
of the deformation to the normal cone and `K = I.deformationCenterSheaf` the ideal sheaf of
`V(I) × {0}` in `Spec_X 𝒪_X[t]`. The pullback of `K` to `D_I X` is invertible (on each chart it
is generated by the non-zerodivisor `t`), so by the universal property of blowing up the
morphism `D_I X ⟶ Spec_X 𝒪_X[t]` lifts uniquely to `Bl_K (Spec_X 𝒪_X[t])`
(`AlgebraicGeometry.Scheme.IdealSheafData.deformationSpaceToBlowup`). On the chart over an
affine open `U ⊆ X` this lift is the affine comparison `AffineBlowup.deformationChart`
(`ι_deformationSpaceToBlowup`); hence it is an open immersion.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

namespace AffineBlowup

open _root_.Polynomial _root_.LaurentPolynomial

variable {R : Type u} [CommRing R] (I : Ideal R)

lemma extendedReesAlgebraT_mem_nonZeroDivisors :
    I.extendedReesAlgebraT ∈ nonZeroDivisors I.extendedReesAlgebra := by
  refine mem_nonZeroDivisors_iff_left.mpr fun x hx ↦ Subtype.ext ?_
  have h : T 1 * (x : R[T;T⁻¹]) = 0 := congrArg Subtype.val hx
  simpa using (isUnit_T (R := R) 1).mul_right_eq_zero.mp h

lemma toExtendedReesAlgebra_C_eq_mul {c : R} (hc : c ∈ I) :
    I.toExtendedReesAlgebra (Polynomial.C c) =
      ⟨LaurentPolynomial.C c * T (-1), Ideal.C_mul_T_neg_one_mem_extendedReesAlgebra hc⟩ *
        I.extendedReesAlgebraT := by
  apply Subtype.ext
  simp [LaurentPolynomial.mul_T_assoc]

/-- In the extended Rees algebra, `J = I R[t] + (t)` becomes the principal ideal `(t)`. -/
lemma map_deformationCenter_toExtendedReesAlgebra :
    (deformationCenter I).map I.toExtendedReesAlgebra = Ideal.span {I.extendedReesAlgebraT} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro p hp
    rw [Ideal.mem_comap, ← X_mul_divX_add p, map_add, map_mul, Ideal.toExtendedReesAlgebra_X,
      toExtendedReesAlgebra_C_eq_mul I (coeff_zero_mem_of_mem_deformationCenter hp)]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span rfl))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))
  · rw [Ideal.span_le, Set.singleton_subset_iff, ← Ideal.toExtendedReesAlgebra_X]
    exact Ideal.mem_map_of_mem _ X_mem_deformationCenter

lemma isRegularPrincipal_map_deformationCenter :
    ((deformationCenter I).map I.toExtendedReesAlgebra).IsRegularPrincipal := by
  rw [map_deformationCenter_toExtendedReesAlgebra]
  exact ⟨_, extendedReesAlgebraT_mem_nonZeroDivisors I, rfl⟩

end AffineBlowup

namespace Scheme.AffineZariskiSite

variable {X : Scheme.{u}} {F : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u}}
  {α : (toOpensFunctor X).op ⋙ X.presheaf ⟶ F} (H : α.Coequifibered)

lemma _root_.AlgebraicGeometry.eq_specMap_appLE_fromSpec {R : CommRingCat.{u}} {Y : Scheme.{u}}
    (f : Spec R ⟶ Y) {V : Y.Opens} (hV : IsAffineOpen V) (e : ⊤ ≤ f ⁻¹ᵁ V) :
    f = Spec.map (f.appLE V ⊤ e ≫ (Scheme.ΓSpecIso R).hom) ≫ hV.fromSpec := by
  have h := IsAffineOpen.SpecMap_appLE_fromSpec f hV (isAffineOpen_top _) e
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h
  rw [Spec.map_comp, Category.assoc, h, ← Spec.map_comp_assoc, Iso.inv_hom_id, Spec.map_id,
    Category.id_comp]

/-- The chart `Spec F(U) ⟶ Spec_X F` is `Spec` of the identification of the sections over the
preimage of `U` with `F(U)`, followed by the canonical morphism of that affine open. -/
lemma ι_eq_specMap_sectionsIso_hom_fromSpec (U : X.AffineZariskiSite) :
    colimit.ι (relativeGluingData H).functor U =
      Spec.map (sectionsIso H U).hom ≫ (U.2.preimage (relativeGluingData H).toBase).fromSpec := by
  rw [sectionsIso_hom]
  exact eq_specMap_appLE_fromSpec (R := F.obj (.op U)) _ _ _

lemma iSup_opensRange_ι : ⨆ U, (colimit.ι (relativeGluingData H).functor U).opensRange = ⊤ := by
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨U, y, rfl⟩ := (relativeGluingData H).cover.exists_eq x
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨U, y, rfl⟩

end Scheme.AffineZariskiSite

namespace Scheme.IdealSheafData

open AffineZariskiSite AffineBlowup

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- The ring map `Γ(Spec Γ(U)[t]) ≅ Γ(U)[t] ⟶ Γ(U)[t, I(U) t⁻¹]` of the chart over `U`. -/
noncomputable def chartRingHom (U : X.AffineZariskiSite) :
    Γ(X.polynomialSpec, (polynomialSpecChartOpen X U).1) →+* (I.siteIdeal U).extendedReesAlgebra :=
  (I.siteIdeal U).toExtendedReesAlgebra.comp
    (sectionsIso X.coequifibered_toPolynomialPresheaf U).hom.hom

lemma ι_deformationSpaceToPolynomialSpec (U : X.AffineZariskiSite) :
    colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U ≫
        I.deformationSpaceToPolynomialSpec =
      Spec.map (CommRingCat.ofHom (I.chartRingHom U)) ≫
        (polynomialSpecChartOpen X U).2.fromSpec := by
  rw [deformationSpaceToPolynomialSpec, ι_relativeGluingMap,
    ι_eq_specMap_sectionsIso_hom_fromSpec X.coequifibered_toPolynomialPresheaf U,
    ← Spec.map_comp_assoc]
  rfl

lemma isInvertible_comap_chart (U : X.AffineZariskiSite) :
    (I.deformationCenterSheaf.comap
      (colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U ≫
        I.deformationSpaceToPolynomialSpec)).IsInvertible := by
  rw [ι_deformationSpaceToPolynomialSpec]
  refine IsInvertible.of_specMap_ofHom_fromSpec (polynomialSpecChartOpen X U) _ ?_
  rw [ideal_deformationCenterSheaf_chart, chartRingHom, ← Ideal.map_map,
    Ideal.map_comap_of_surjective (sectionsIso X.coequifibered_toPolynomialPresheaf U).hom.hom
      (sectionsIso X.coequifibered_toPolynomialPresheaf U).commRingCatIsoToRingEquiv.surjective]
  exact isRegularPrincipal_map_deformationCenter _

/-- The pullback of the center `V(I) × {0}` to the deformation space is invertible: on each chart
it is generated by the non-zerodivisor `t`. -/
lemma isInvertible_comap_deformationSpaceToPolynomialSpec :
    (I.deformationCenterSheaf.comap I.deformationSpaceToPolynomialSpec).IsInvertible :=
  IsInvertible.of_iSup_opensRange_eq_top _
    (iSup_opensRange_ι I.coequifibered_toReesPresheaf) fun U ↦ by
      rw [← comap_comp]
      exact I.isInvertible_comap_chart U

/-- Deformation space of a closed section,
comparison morphism from the Rees model to the blow-up model. The morphism
`D_I X = Spec_X 𝒪_X[t, I t⁻¹] ⟶ Bl_{V(I) × 0} (Spec_X 𝒪_X[t])` lifting
`D_I X ⟶ Spec_X 𝒪_X[t]`, given by the universal property of blowing up. -/
noncomputable def deformationSpaceToBlowup :
    I.deformationSpace ⟶ I.deformationCenterSheaf.blowup :=
  (I.deformationCenterSheaf.exists_lift_blowup
    I.isInvertible_comap_deformationSpaceToPolynomialSpec).choose

@[reassoc (attr := simp)]
lemma deformationSpaceToBlowup_blowupMap :
    I.deformationSpaceToBlowup ≫ I.deformationCenterSheaf.blowupMap =
      I.deformationSpaceToPolynomialSpec :=
  (I.deformationCenterSheaf.exists_lift_blowup
    I.isInvertible_comap_deformationSpaceToPolynomialSpec).choose_spec

/-! ### The comparison on charts -/

lemma map_ideal_deformationCenterSheaf_chart (U : X.AffineZariskiSite) :
    (I.deformationCenterSheaf.ideal (polynomialSpecChartOpen X U)).map
      (sectionsIso X.coequifibered_toPolynomialPresheaf U).hom.hom =
      deformationCenter (I.siteIdeal U) := by
  rw [ideal_deformationCenterSheaf_chart, Ideal.map_comap_of_surjective
    (sectionsIso X.coequifibered_toPolynomialPresheaf U).hom.hom
    (sectionsIso X.coequifibered_toPolynomialPresheaf U).commRingCatIsoToRingEquiv.surjective]

lemma map_deformationCenter_sectionsIso_inv (U : X.AffineZariskiSite) :
    (deformationCenter (I.siteIdeal U)).map
      (sectionsIso X.coequifibered_toPolynomialPresheaf U).inv.hom =
      I.deformationCenterSheaf.ideal (polynomialSpecChartOpen X U) := by
  rw [ideal_deformationCenterSheaf_chart]
  exact Ideal.map_symm
    (sectionsIso X.coequifibered_toPolynomialPresheaf U).commRingCatIsoToRingEquiv

/-- The blow-up of `Spec Γ(U)[t]` along `I(U) Γ(U)[t] + (t)` is the blow-up of the chart of
`Spec_X 𝒪_X[t]` over `U` along the center. -/
noncomputable def chartBlowupHom (U : X.AffineZariskiSite) :
    AffineBlowup (deformationCenter (I.siteIdeal U)) ⟶
      AffineBlowup (I.deformationCenterSheaf.ideal (polynomialSpecChartOpen X U)) :=
  AffineBlowup.hom _ (I.map_ideal_deformationCenterSheaf_chart U)

instance (U : X.AffineZariskiSite) : IsIso (I.chartBlowupHom U) := by
  have h₁ : (sectionsIso X.coequifibered_toPolynomialPresheaf U).hom.hom.comp
      (sectionsIso X.coequifibered_toPolynomialPresheaf U).inv.hom = RingHom.id _ := by
    rw [← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id]
  have h₂ : (sectionsIso X.coequifibered_toPolynomialPresheaf U).inv.hom.comp
      (sectionsIso X.coequifibered_toPolynomialPresheaf U).hom.hom = RingHom.id _ := by
    rw [← CommRingCat.hom_comp, Iso.hom_inv_id, CommRingCat.hom_id]
  refine ⟨AffineBlowup.hom _ (I.map_deformationCenter_sectionsIso_inv U), ?_, ?_⟩
  · rw [chartBlowupHom, ← AffineBlowup.hom_comp, AffineBlowup.hom_congr h₁, AffineBlowup.hom_id]
  · rw [chartBlowupHom, ← AffineBlowup.hom_comp, AffineBlowup.hom_congr h₂, AffineBlowup.hom_id]

/-- The comparison over the chart `U`: `Spec Γ(U)[t, I(U) t⁻¹] ⟶ Bl_K (Spec_X 𝒪_X[t])` through
the affine blow-up chart `AffineBlowup.deformationChart`. -/
noncomputable def deformationChartToBlowup (U : X.AffineZariskiSite) :
    Spec (.of (I.siteIdeal U).extendedReesAlgebra) ⟶ I.deformationCenterSheaf.blowup :=
  deformationChart (I.siteIdeal U) ≫ I.chartBlowupHom U ≫
    I.deformationCenterSheaf.blowupι (polynomialSpecChartOpen X U)

instance (U : X.AffineZariskiSite) : IsOpenImmersion (I.deformationChartToBlowup U) := by
  unfold deformationChartToBlowup; infer_instance

lemma deformationChartToBlowup_blowupMap (U : X.AffineZariskiSite) :
    I.deformationChartToBlowup U ≫ I.deformationCenterSheaf.blowupMap =
      colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U ≫
        I.deformationSpaceToPolynomialSpec := by
  rw [ι_deformationSpaceToPolynomialSpec, deformationChartToBlowup, Category.assoc,
    Category.assoc, blowupι_blowupMap, blowupNatTrans_app, chartBlowupHom]
  simp only [Category.assoc]
  rw [
    AffineBlowup.hom_toSpec_assoc, deformationChart_toSpec_assoc,
    IsAffineOpen.isoSpec_inv_ι, CommRingCat.ofHom_hom, ← Spec.map_comp_assoc]
  rfl

/-- **On the chart over an affine open `U`, the comparison morphism is the affine comparison**
`Spec Γ(U)[t, I(U) t⁻¹] ≅ D₊(t·X) ⊆ Bl_{I(U) Γ(U)[t] + (t)} (Spec Γ(U)[t])`. -/
lemma ι_deformationSpaceToBlowup (U : X.AffineZariskiSite) :
    colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U ≫
      I.deformationSpaceToBlowup = I.deformationChartToBlowup U :=
  I.deformationCenterSheaf.hom_ext_of_isInvertible_comap (I.isInvertible_comap_chart U)
    (by rw [Category.assoc, deformationSpaceToBlowup_blowupMap])
    (I.deformationChartToBlowup_blowupMap U)

lemma iSup_polynomialSpecChartOpen :
    ⨆ U : X.AffineZariskiSite, (polynomialSpecChartOpen X U).1 = ⊤ := by
  have h : ∀ U : X.AffineZariskiSite, (polynomialSpecChartOpen X U).1 =
      (colimit.ι (relativeGluingData X.coequifibered_toPolynomialPresheaf).functor U).opensRange :=
    fun U ↦ toBase_preimage _ U
  simp only [h]
  exact iSup_opensRange_ι _

lemma preimage_deformationSpaceToBlowup_chart (U : X.AffineZariskiSite) :
    I.deformationSpaceToBlowup ⁻¹ᵁ
        (I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1) =
      (colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U).opensRange := by
  rw [← Scheme.Hom.comp_preimage, deformationSpaceToBlowup_blowupMap, ← toBase_preimage,
    polynomialSpecChartOpen, ← Scheme.Hom.comp_preimage, deformationSpaceToPolynomialSpec,
    relativeGluingMap_toBase _ _ _ I.toPolynomialPresheaf_comp_polynomialToRees]

/-- Deformation space of a closed section. The
comparison morphism `D_I X ⟶ Bl_{V(I) × 0} (Spec_X 𝒪_X[t])` from the Rees model to the blow-up
model is an open immersion. -/
instance isOpenImmersion_deformationSpaceToBlowup : IsOpenImmersion I.deformationSpaceToBlowup := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsOpenImmersion)
    (fun U : X.AffineZariskiSite ↦
      I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1) ?_ fun U ↦ ?_
  · rw [← Scheme.Hom.preimage_iSup, iSup_polynomialSpecChartOpen, Scheme.Hom.preimage_top]
  · have e := IsOpenImmersion.isoOfRangeEq_hom_fac
      (I.deformationSpaceToBlowup ⁻¹ᵁ
        (I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1)).ι
      (colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U) (by
        rw [Scheme.Opens.range_ι, ← Scheme.Hom.coe_opensRange,
          preimage_deformationSpaceToBlowup_chart])
    have : IsOpenImmersion ((I.deformationSpaceToBlowup ⁻¹ᵁ
        (I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1)).ι ≫
          I.deformationSpaceToBlowup) := by
      rw [← e, Category.assoc, ι_deformationSpaceToBlowup]
      infer_instance
    have : IsOpenImmersion ((I.deformationSpaceToBlowup ∣_
        (I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1)) ≫
          (I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1).ι) := by
      rw [morphismRestrict_ι]; exact this
    exact IsOpenImmersion.of_comp _
      (I.deformationCenterSheaf.blowupMap ⁻¹ᵁ (polynomialSpecChartOpen X U).1).ι

end Scheme.IdealSheafData

end AlgebraicGeometry
