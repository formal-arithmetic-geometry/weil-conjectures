module

public import WeilConjectures.AlgebraicGeometry.DeformationSpace.BaseChange
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.AlgebraicGeometry.Morphisms.Proper

/-!
# The deformation space along a morphism with `J = f⁻¹ I`

Let `f : X ⟶ Y` be a morphism of schemes, `I` an ideal sheaf on `Y` and `J = f⁻¹ I · 𝒪_X` the
ideal sheaf of the scheme-theoretic preimage `f⁻¹ V(I)` (`I.comap f` in Mathlib). Blueprint
`lemma-functoriality-deformation` (Fulton, ch. 5; Varshavsky, §1) states:

* the morphism `D_J X ⟶ X ×_Y D_I Y` is a closed immersion: on affine charts the map
  `S ⊗_R R[t, I t⁻¹] ⟶ S[t, (I S) t⁻¹]` is surjective, as its target is generated over `S` by `t`
  and the images of the `a t⁻¹`, `a ∈ I`;
* hence `D_J X ⟶ D_I Y` is proper (resp. a closed immersion, resp. finite) whenever `f` is;
* if `f` is flat, `D_J X ⟶ X ×_Y D_I Y` is an isomorphism.

The first item is deduced from a general statement on relative spectra: for base change data
`F(U) ⟶ F'(U')` along `h : X' ⟶ X` such that `F'(U')` is generated by the images of `F(U)` and
`Γ(X', U')` on charts covering `X'`, the comparison `Spec_{X'} F' ⟶ X' ×_X Spec_X F` is a closed
immersion.

## Main definitions

- `AlgebraicGeometry.Scheme.AffineZariskiSite.PullbackData.toPullback`: the comparison
  `Spec_{X'} F' ⟶ X' ×_X Spec_X F`.
- `AlgebraicGeometry.Scheme.IdealSheafData.deformationSpaceToPullback`: the morphism
  `D_J X' ⟶ X' ×_X D_I X`.

## Main statements

- `Ideal.mem_closure_extendedReesAlgebraMap`: `S[t, (I S) t⁻¹]` is generated by `S` and the image
  of `R[t, I t⁻¹]`.
- `AlgebraicGeometry.Scheme.AffineZariskiSite.PullbackData.isClosedImmersion_toPullback`
- `AlgebraicGeometry.Scheme.IdealSheafData.isClosedImmersion_deformationSpaceToPullback`:
  blueprint `lemma-functoriality-deformation` (a).
- `AlgebraicGeometry.Scheme.IdealSheafData.isProper_deformationSpaceMap`,
  `AlgebraicGeometry.Scheme.IdealSheafData.isClosedImmersion_deformationSpaceMap`,
  `AlgebraicGeometry.Scheme.IdealSheafData.isFinite_deformationSpaceMap`:
  blueprint `lemma-functoriality-deformation` (b).
- `AlgebraicGeometry.Scheme.IdealSheafData.isPullback_deformationSpaceMap_of_flat`,
  `AlgebraicGeometry.Scheme.IdealSheafData.isIso_deformationSpaceToPullback_of_flat`:
  blueprint `lemma-functoriality-deformation` (c).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite LaurentPolynomial

namespace Ideal

variable {R S : Type*} [CommRing R] [CommRing S] (I : Ideal R) (φ : R →+* S)

/-- For `J = I S`, the extended Rees algebra
`S[t, J t⁻¹]` is generated as a ring by `S` and the image of `R[t, I t⁻¹]`; i.e. the natural map
`S ⊗_R R[t, I t⁻¹] ⟶ S[t, (I S) t⁻¹]` is surjective. -/
theorem mem_closure_extendedReesAlgebraMap {J : Ideal S} (hJ : I.map φ = J)
    (y : J.extendedReesAlgebra) :
    y ∈ Subring.closure (Set.range (I.extendedReesAlgebraMap φ J hJ.le) ∪
      Set.range (algebraMap S J.extendedReesAlgebra)) := by
  subst hJ
  set M := Subring.closure (Set.range (I.extendedReesAlgebraMap φ (I.map φ) le_rfl) ∪
      Set.range (algebraMap S (I.map φ).extendedReesAlgebra))
  have hmap (z : I.extendedReesAlgebra) : I.extendedReesAlgebraMap φ _ le_rfl z ∈ M :=
    Subring.subset_closure (Or.inl ⟨z, rfl⟩)
  have halg (s : S) : algebraMap S (I.map φ).extendedReesAlgebra s ∈ M :=
    Subring.subset_closure (Or.inr ⟨s, rfl⟩)
  have hT : ∀ x ∈ Submodule.span S (φ '' (I : Set R)), ∀ hx : x ∈ I.map φ,
      (⟨C x * T (-1), C_mul_T_neg_one_mem_extendedReesAlgebra hx⟩ :
        (I.map φ).extendedReesAlgebra) ∈ M := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      intro _
      obtain ⟨a, ha, rfl⟩ := hx
      convert hmap ⟨C a * T (-1), C_mul_T_neg_one_mem_extendedReesAlgebra ha⟩ using 1
      ext1
      simp [LaurentPolynomial.mapRingHom_C, LaurentPolynomial.mapRingHom_T]
    | zero =>
      intro _
      convert M.zero_mem using 1
      ext1
      simp
    | add x y hx hy ihx ihy =>
      intro _
      convert M.add_mem (ihx hx) (ihy hy) using 1
      ext1
      simp [add_mul]
    | smul s x hx ih =>
      intro _
      convert M.mul_mem (halg s) (ih hx) using 1
      ext1
      simp [mul_assoc]
  obtain ⟨y, hy⟩ := y
  induction hy using Algebra.adjoin_induction with
  | mem z hz =>
    obtain rfl | ⟨x, hx, rfl⟩ := hz
    · convert hmap I.extendedReesAlgebraT using 1
      exact (extendedReesAlgebraMap_T φ _ le_rfl).symm
    · exact hT x hx hx
  | algebraMap s =>
    convert halg s using 1
    ext1
    simp
  | add x y _ _ ihx ihy => exact M.add_mem ihx ihy
  | mul x y _ _ ihx ihy => exact M.mul_mem ihx ihy

/-- Blueprint `lemma-functoriality-deformation` (c), affine-locally: along a flat `φ : R ⟶ S`, the
extended Rees algebra of any ideal `J = I S` is the base change of the one of `I`. -/
lemma isPushout_extendedReesAlgebraMap_of_flat_of_eq {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (hφ : φ.Flat) (I : Ideal R) (J : Ideal S) (hJ : I.map φ = J) :
    IsPushout (CommRingCat.ofHom φ) (CommRingCat.ofHom (algebraMap R I.extendedReesAlgebra))
      (CommRingCat.ofHom (algebraMap S J.extendedReesAlgebra))
      (CommRingCat.ofHom (I.extendedReesAlgebraMap φ J hJ.le)) := by
  subst hJ
  exact isPushout_extendedReesAlgebraMap_of_flat φ hφ I

end Ideal

namespace AlgebraicGeometry

/-- A property local at the target holds for `f : X ⟶ Y` if `Y` is covered by open immersions
`j i : V i ⟶ Y` along which the base changes of `f` have the property. -/
lemma IsZariskiLocalAtTarget.of_forall_isPullback {P : MorphismProperty Scheme.{u}}
    [IsZariskiLocalAtTarget P] {X Y : Scheme.{u}} (f : X ⟶ Y) {ι : Type u}
    {V W : ι → Scheme.{u}} (j : ∀ i, V i ⟶ Y) [∀ i, IsOpenImmersion (j i)]
    (hj : ∀ y, ∃ i, y ∈ Set.range (j i)) (k : ∀ i, W i ⟶ X) (g : ∀ i, W i ⟶ V i)
    (H : ∀ i, IsPullback (k i) (g i) f (j i)) (hg : ∀ i, P (g i)) : P f := by
  let 𝒰 : Y.OpenCover := Scheme.Cover.mkOfCovers ι V j fun y ↦ by
    obtain ⟨i, z, hz⟩ := hj y
    exact ⟨i, z, hz⟩
  refine IsZariskiLocalAtTarget.of_openCover 𝒰 fun i ↦ ?_
  change P (pullback.snd f (j i))
  rw [← (H i).isoPullback_inv_snd, P.cancel_left_of_respectsIso]
  exact hg i

namespace Scheme.AffineZariskiSite

variable {X X' : Scheme.{u}} {h : X' ⟶ X}
  {F : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u}}
  {α : (toOpensFunctor X).op ⋙ X.presheaf ⟶ F} (H : α.Coequifibered)
  {F' : X'.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u}}
  {α' : (toOpensFunctor X').op ⋙ X'.presheaf ⟶ F'} (H' : α'.Coequifibered)

namespace PullbackData

variable (D : PullbackData h α α')

/-- The comparison morphism `Spec_{X'} F' ⟶ X' ×_X Spec_X F` induced by base change data. -/
noncomputable def toPullback :
    (relativeGluingData H').glued ⟶ pullback (relativeGluingData H).toBase h :=
  pullback.lift (D.comparison H H') (relativeGluingData H').toBase (D.comparison_toBase H H')

@[reassoc (attr := simp)]
lemma toPullback_fst : D.toPullback H H' ≫ pullback.fst _ _ = D.comparison H H' :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
lemma toPullback_snd :
    D.toPullback H H' ≫ pullback.snd _ _ = (relativeGluingData H').toBase :=
  pullback.lift_snd _ _ _

/-- The local structure of `toPullback` over a pair `(U', U)`: with
`P = Γ(X', U') ⊗_{Γ(X, U)} F(U)` (a pushout), `Spec P` is an open subscheme of `X' ×_X Spec_X F`
lying over `U'`, and over it `toPullback` is `Spec (P ⟶ F'(U'))`. -/
lemma exists_isPullback_toPullback {U' : X'.AffineZariskiSite} {U : X.AffineZariskiSite}
    (hU : U'.1 ≤ h ⁻¹ᵁ U.1) :
    ∃ (j : Spec (pushout (h.appLE U.1 U'.1 hU) (α.app (op U))) ⟶
        pullback (relativeGluingData H).toBase h),
      IsOpenImmersion j ∧
      IsPullback (Spec.map (pushout.inl _ _) ≫ U'.2.isoSpec.inv) j U'.1.ι
        (pullback.snd (relativeGluingData H).toBase h) ∧
      IsPullback (colimit.ι (relativeGluingData H').functor U')
        (Spec.map (pushout.desc (α'.app (op U')) (D.map hU) (D.app_comp_map hU).symm))
        (D.toPullback H H') j := by
  have T : IsPullback U'.2.isoSpec.inv (Spec.map (h.appLE U.1 U'.1 hU))
      (h.resLE U.1 U'.1 hU) U.2.isoSpec.inv := by
    refine IsPullback.of_horiz_isIso ⟨?_⟩
    rw [← cancel_mono U.1.ι, Category.assoc, Category.assoc, IsAffineOpen.isoSpec_inv_ι,
      Scheme.Hom.resLE_comp_ι, IsAffineOpen.isoSpec_inv_ι_assoc,
      IsAffineOpen.SpecMap_appLE_fromSpec]
  have sqA : IsPullback (Spec.map (pushout.inl _ _) ≫ U'.2.isoSpec.inv)
      (Spec.map (pushout.inr (h.appLE U.1 U'.1 hU) (α.app (op U))))
      (h.resLE U.1 U'.1 hU) ((relativeGluingData H).natTrans.app U) :=
    (isPullback_SpecMap_of_isPushout _ _ _ _ (IsPushout.of_hasPushout _ _)).paste_horiz T
  have sqB := sqA.paste_vert ((relativeGluingData H).isPullback_natTrans_ι_toBase U)
  rw [Scheme.Hom.resLE_comp_ι] at sqB
  have w : (Spec.map (pushout.inr _ _) ≫ colimit.ι (relativeGluingData H).functor U) ≫
      (relativeGluingData H).toBase =
        ((Spec.map (pushout.inl (h.appLE U.1 U'.1 hU) (α.app (op U))) ≫
          U'.2.isoSpec.inv) ≫ U'.1.ι) ≫ h := by
    simpa only [Category.assoc] using sqB.w.symm
  have sqJ : IsPullback (Spec.map (pushout.inl _ _) ≫ U'.2.isoSpec.inv)
      (pullback.lift _ _ w) U'.1.ι (pullback.snd (relativeGluingData H).toBase h) := by
    refine IsPullback.of_bot ?_ (pullback.lift_snd _ _ _).symm
      (IsPullback.of_hasPullback _ _).flip
    rw [pullback.lift_fst]
    exact sqB
  refine ⟨_, MorphismProperty.of_isPullback sqJ inferInstance, sqJ, ?_⟩
  have hN : (relativeGluingData H').natTrans.app U' =
      Spec.map (α'.app (op U')) ≫ U'.2.isoSpec.inv := rfl
  refine IsPullback.of_bot ?_ ?_ sqJ.flip
  · rw [toPullback_snd, ← Category.assoc, ← Spec.map_comp, pushout.inl_desc, ← hN]
    exact ((relativeGluingData H').isPullback_natTrans_ι_toBase U').flip
  · refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, Category.assoc, toPullback_fst, pullback.lift_fst,
        PullbackData.ι_comparison _ _ _ hU, ← Spec.map_comp_assoc, pushout.inr_desc]
    · rw [Category.assoc, Category.assoc, toPullback_snd, pullback.lift_snd,
        Cover.RelativeGluingData.ι_toBase, hN]
      simp only [Category.assoc]
      rw [← Spec.map_comp_assoc, pushout.inl_desc]

/-- **Closed immersion into the base change.** If for a family of pairs `(U', U)` covering `X'`
the ring `F'(U')` is generated by the images of `F(U)` and `Γ(X', U')` (that is,
`Γ(X', U') ⊗_{Γ(X, U)} F(U) ⟶ F'(U')` is surjective), then `Spec_{X'} F' ⟶ X' ×_X Spec_X F` is a
closed immersion. Used for blueprint `lemma-functoriality-deformation` (a). -/
theorem isClosedImmersion_toPullback
    (hcov : ∀ x : X', ∃ (U' : X'.AffineZariskiSite) (U : X.AffineZariskiSite)
      (hU : U'.1 ≤ h ⁻¹ᵁ U.1), x ∈ U'.1 ∧ ∀ y : F'.obj (op U'),
        y ∈ Subring.closure (Set.range (D.map hU).hom ∪ Set.range (α'.app (op U')).hom)) :
    IsClosedImmersion (D.toPullback H H') := by
  choose U' U hU hx hgen using hcov
  choose j hj sqJ sqL using fun x ↦ D.exists_isPullback_toPullback H H' (hU x)
  refine IsZariskiLocalAtTarget.of_forall_isPullback (P := @IsClosedImmersion) _ j
    (fun p ↦ ?_) _ _ sqL fun x ↦ IsClosedImmersion.spec_of_surjective _ fun y ↦ ?_
  · obtain ⟨q, -, hq⟩ := exists_preimage_of_isPullback (sqJ (pullback.snd _ h p))
      (⟨pullback.snd _ h p, hx _⟩ : (U' (pullback.snd _ h p)).1) p rfl
    exact ⟨_, q, hq⟩
  · have hle : Subring.closure
        (Set.range (D.map (hU x)).hom ∪ Set.range (α'.app (op (U' x))).hom) ≤
          (pushout.desc (α'.app (op (U' x))) (D.map (hU x))
            (D.app_comp_map (hU x)).symm).hom.range := by
      refine Subring.closure_le.mpr (Set.union_subset ?_ ?_)
      · rintro _ ⟨z, rfl⟩
        refine ⟨(pushout.inr (h.appLE (U x).1 (U' x).1 (hU x)) (α.app (op (U x)))).hom z, ?_⟩
        rw [← CommRingCat.comp_apply, pushout.inr_desc]
      · rintro _ ⟨z, rfl⟩
        refine ⟨(pushout.inl (h.appLE (U x).1 (U' x).1 (hU x)) (α.app (op (U x)))).hom z, ?_⟩
        rw [← CommRingCat.comp_apply, pushout.inl_desc]
        rfl
    exact hle (hgen x y)

end PullbackData

end Scheme.AffineZariskiSite

namespace Scheme.IdealSheafData

open AffineZariskiSite

variable {X X' : Scheme.{u}} (h : X' ⟶ X) (I : X.IdealSheafData) (J : X'.IdealSheafData)
  (hJ : ∀ ⦃U' : X'.AffineZariskiSite⦄ ⦃U : X.AffineZariskiSite⦄ (hU : U'.1 ≤ h ⁻¹ᵁ U.1),
    (I.siteIdeal U).map (h.appLE U.1 U'.1 hU).hom ≤ J.siteIdeal U')

/-- The pullback `h⁻¹ I` satisfies the compatibility `h^* I ⊆ h⁻¹ I` needed for
`deformationSpaceMap`. -/
lemma map_siteIdeal_le_comap ⦃U' : X'.AffineZariskiSite⦄ ⦃U : X.AffineZariskiSite⦄
    (hU : U'.1 ≤ h ⁻¹ᵁ U.1) :
    (I.siteIdeal U).map (h.appLE U.1 U'.1 hU).hom ≤ (I.comap h).siteIdeal U' :=
  (ideal_comap_appLE I h ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU).ge

/-- The morphism `D_J X' ⟶ X' ×_X D_I X` induced by `D_J X' ⟶ D_I X` and `D_J X' ⟶ X'`. -/
noncomputable def deformationSpaceToPullback :
    J.deformationSpace ⟶ pullback I.deformationSpaceProj h :=
  (extendedReesPullbackData h I J hJ).toPullback _ _

@[reassoc (attr := simp)]
lemma deformationSpaceToPullback_fst :
    deformationSpaceToPullback h I J hJ ≫ pullback.fst _ _ = deformationSpaceMap h I J hJ :=
  PullbackData.toPullback_fst _ _ _

@[reassoc (attr := simp)]
lemma deformationSpaceToPullback_snd :
    deformationSpaceToPullback h I J hJ ≫ pullback.snd _ _ = J.deformationSpaceProj :=
  PullbackData.toPullback_snd _ _ _

/-- Blueprint `lemma-functoriality-deformation` (a): if `J = h⁻¹ I` is the ideal sheaf of the
scheme-theoretic preimage, then `D_J X' ⟶ X' ×_X D_I X` is a closed immersion. -/
theorem isClosedImmersion_deformationSpaceToPullback (hJI : J = I.comap h) :
    IsClosedImmersion (deformationSpaceToPullback h I J hJ) := by
  subst hJI
  refine PullbackData.isClosedImmersion_toPullback _ _ _ fun x ↦ ?_
  obtain ⟨⟨⟨U', U⟩, hU⟩, hx⟩ := Pairs.exists_mem h x
  exact ⟨U', U, hU, hx, Ideal.mem_closure_extendedReesAlgebraMap _ _
    (ideal_comap_appLE I h ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU).symm⟩

/-- Blueprint `lemma-functoriality-deformation` (b): if `h` is proper and `J = h⁻¹ I`, then
`D_J X' ⟶ D_I X` is proper. -/
theorem isProper_deformationSpaceMap [IsProper h] (hJI : J = I.comap h) :
    IsProper (deformationSpaceMap h I J hJ) := by
  have := isClosedImmersion_deformationSpaceToPullback h I J hJ hJI
  have : IsProper (pullback.fst I.deformationSpaceProj h) :=
    MorphismProperty.pullback_fst _ _ inferInstance
  rw [← deformationSpaceToPullback_fst]
  infer_instance

/-- Blueprint `lemma-functoriality-deformation` (b): if `h` is a closed immersion and `J = h⁻¹ I`,
then `D_J X' ⟶ D_I X` is a closed immersion. -/
theorem isClosedImmersion_deformationSpaceMap [IsClosedImmersion h] (hJI : J = I.comap h) :
    IsClosedImmersion (deformationSpaceMap h I J hJ) := by
  have := isClosedImmersion_deformationSpaceToPullback h I J hJ hJI
  have : IsClosedImmersion (pullback.fst I.deformationSpaceProj h) :=
    MorphismProperty.pullback_fst _ _ inferInstance
  rw [← deformationSpaceToPullback_fst]
  infer_instance

/-- Blueprint `lemma-functoriality-deformation` (b): if `h` is finite and `J = h⁻¹ I`, then
`D_J X' ⟶ D_I X` is finite. -/
theorem isFinite_deformationSpaceMap [IsFinite h] (hJI : J = I.comap h) :
    IsFinite (deformationSpaceMap h I J hJ) := by
  have := isClosedImmersion_deformationSpaceToPullback h I J hJ hJI
  have : IsFinite (pullback.fst I.deformationSpaceProj h) :=
    MorphismProperty.pullback_fst _ _ inferInstance
  rw [← deformationSpaceToPullback_fst]
  infer_instance

/-- Blueprint `lemma-functoriality-deformation` (c): if `h` is flat and `J = h⁻¹ I`, then
`D_J X' = X' ×_X D_I X`. -/
theorem isPullback_deformationSpaceMap_of_flat [Flat h] (hJI : J = I.comap h) :
    IsPullback (deformationSpaceMap h I J hJ) J.deformationSpaceProj I.deformationSpaceProj h := by
  subst hJI
  refine PullbackData.isPullback_comparison _ _ _ fun x ↦ ?_
  obtain ⟨⟨⟨U', U⟩, hU⟩, hx⟩ := Pairs.exists_mem h x
  exact ⟨U', U, hU, hx, Ideal.isPushout_extendedReesAlgebraMap_of_flat_of_eq _
    (HasRingHomProperty.appLE @Flat h ‹_› ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU) _ _
    (ideal_comap_appLE I h ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU).symm⟩

/-- Blueprint `lemma-functoriality-deformation` (c): if `h` is flat (e.g. an open immersion) and
`J = h⁻¹ I`, then `D_J X' ⟶ X' ×_X D_I X` is an isomorphism. -/
theorem isIso_deformationSpaceToPullback_of_flat [Flat h] (hJI : J = I.comap h) :
    IsIso (deformationSpaceToPullback h I J hJ) := by
  have hP := isPullback_deformationSpaceMap_of_flat h I J hJ hJI
  have e : deformationSpaceToPullback h I J hJ = hP.isoPullback.hom :=
    pullback.hom_ext (by simp) (by simp)
  rw [e]
  infer_instance

end Scheme.IdealSheafData

end AlgebraicGeometry
