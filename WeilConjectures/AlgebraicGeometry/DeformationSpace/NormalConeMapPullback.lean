module

public import WeilConjectures.AlgebraicGeometry.DeformationSpace.BaseChangeClosedImmersion
public import WeilConjectures.AlgebraicGeometry.DeformationSpace.NormalConeMap
public import WeilConjectures.Algebra.Category.Ring.IsPushoutOfSurjective
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth

/-!
# Functoriality of deformation spaces along `J = h⁻¹ I`

Let `h : X' ⟶ X` be a morphism of schemes, `I` an ideal sheaf on `X` and `J = h⁻¹ I · 𝒪_{X'}`.
Blueprint `lemma-functoriality-deformation`:

* if `h` is smooth, so is the morphism of deformation spaces `D_J X' ⟶ D_I X`;
* the morphism of normal cones `N_J X' ⟶ N_I X` pulls the zero section `V(I) ⟶ N_I X` back to the
  zero section `V(J) ⟶ N_J X'` scheme-theoretically ("`f̃_s⁻¹(Z) = Z'`").

The second statement is checked on charts: the augmentation `gr_I R ⟶ R / I` is surjective, and
the kernel of `gr_J R' ⟶ R' / J` (the irrelevant ideal) is generated by the image of the
irrelevant ideal of `gr_I R` as soon as `J = I R'`, so that `gr_J R' ⊗_{gr_I R} R / I = R' / J`.

## Main statements

- `AlgebraicGeometry.Scheme.IdealSheafData.smooth_deformationSpaceMap`
- `AlgebraicGeometry.Scheme.IdealSheafData.isPullback_normalConeZeroSection_normalConeMap`
- `AlgebraicGeometry.Scheme.IdealSheafData.isPullback_normalConeZeroSection_normalConeMap_comap`
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme.IdealSheafData

open AffineZariskiSite Opposite

variable {X X' : Scheme.{u}} (h : X' ⟶ X) (I : X.IdealSheafData) (J : X'.IdealSheafData)
  (hJ : ∀ ⦃U' : X'.AffineZariskiSite⦄ ⦃U : X.AffineZariskiSite⦄ (hU : U'.1 ≤ h ⁻¹ᵁ U.1),
    (I.siteIdeal U).map (h.appLE U.1 U'.1 hU).hom ≤ J.siteIdeal U')

/-- If `h` is smooth and `J = h⁻¹ I`, then the morphism of deformation spaces `D_J X' ⟶ D_I X` is
smooth, being a base change of `h`. -/
theorem smooth_deformationSpaceMap [Smooth h] (hJI : J = I.comap h) :
    Smooth (deformationSpaceMap h I J hJ) :=
  MorphismProperty.of_isPullback (isPullback_deformationSpaceMap_of_flat h I J hJ hJI).flip
    inferInstance

/-- On charts, the morphism of normal cones is compatible with the augmentations
`gr_I ⟶ 𝒪 / I` and `gr_J ⟶ 𝒪 / J`. -/
@[reassoc]
lemma normalConePullbackData_map_normalConeToQuotient {U' : X'.AffineZariskiSite}
    {U : X.AffineZariskiSite} (hU : U'.1 ≤ h ⁻¹ᵁ U.1) :
    (normalConePullbackData h I J hJ).map hU ≫ J.normalConeToQuotient.app (op U') =
      I.normalConeToQuotient.app (op U) ≫ (quotientPullbackData h I J hJ).map hU := by
  refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun x ↦ ?_))
  change J.normalConeToQuotient.app (op U') (Ideal.Quotient.mk _
      ((extendedReesPullbackData h I J hJ).map hU x)) =
    (quotientPullbackData h I J hJ).map hU (I.normalConeToQuotient.app (op U)
      (Ideal.Quotient.mk _ x))
  refine (J.normalConeToQuotient_app_mk (op U') _).trans (Eq.trans ?_
    (congrArg ((quotientPullbackData h I J hJ).map hU)
      (I.normalConeToQuotient_app_mk (op U) x)).symm)
  change Ideal.Quotient.mk _ ((LaurentPolynomial.mapRingHom _ _).coeff 0) = Ideal.Quotient.mk _ _
  rw [AddMonoidAlgebra.coeff_mapRingHom]
  rfl

/-- If `J = h^* I · 𝒪_{X'}` on a chart, the irrelevant ideal of `gr_J` is generated by the image
of the irrelevant ideal of `gr_I`. -/
lemma map_ker_normalConeToQuotient {U' : X'.AffineZariskiSite} {U : X.AffineZariskiSite}
    (hU : U'.1 ≤ h ⁻¹ᵁ U.1)
    (hJeq : (I.siteIdeal U).map (h.appLE U.1 U'.1 hU).hom = J.siteIdeal U') :
    (RingHom.ker (I.normalConeToQuotient.app (op U)).hom).map
        ((normalConePullbackData h I J hJ).map hU).hom =
      RingHom.ker (J.normalConeToQuotient.app (op U')).hom := by
  have hw := normalConePullbackData_map_normalConeToQuotient h I J hJ hU
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun a ha ↦ ?_) fun b hb ↦ ?_
  · rw [Ideal.mem_comap, RingHom.mem_ker, ← CommRingCat.comp_apply, hw, CommRingCat.comp_apply,
      RingHom.mem_ker.mp ha, map_zero]
  · obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    have hb' := Ideal.Quotient.eq_zero_iff_mem.mp
      ((J.normalConeToQuotient_app_mk (op U') b).symm.trans (RingHom.mem_ker.mp hb))
    refine Ideal.mem_of_coeff_zero_mem_of_map_eq (h.appLE U.1 U'.1 hU).hom (J.siteIdeal U')
      hJeq (((RingHom.ker (I.normalConeToQuotient.app (op U)).hom).map
        ((normalConePullbackData h I J hJ).map hU).hom).comap
          (Ideal.Quotient.mk (J.tIdeal (op U')))) ?_ (fun a ha ↦ ?_) hb'
    · have h0 : Ideal.Quotient.mk (J.tIdeal (op U')) (J.siteIdeal U').extendedReesAlgebraT = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      exact Ideal.mem_comap.mpr (by convert Ideal.zero_mem _)
    · have ha' : Ideal.Quotient.mk (I.tIdeal (op U)) a ∈
          RingHom.ker (I.normalConeToQuotient.app (op U)).hom :=
        RingHom.mem_ker.mpr ((I.normalConeToQuotient_app_mk (op U) a).trans
          (Ideal.Quotient.eq_zero_iff_mem.mpr ha))
      exact Ideal.mem_comap.mpr (Ideal.mem_map_of_mem _ ha')

/-- On charts, `gr_J R' ⊗_{gr_I R} R / I = R' / J` when `J = I R'`. -/
lemma isPushout_normalConePullbackData_map {U' : X'.AffineZariskiSite} {U : X.AffineZariskiSite}
    (hU : U'.1 ≤ h ⁻¹ᵁ U.1)
    (hJeq : (I.siteIdeal U).map (h.appLE U.1 U'.1 hU).hom = J.siteIdeal U') :
    IsPushout ((normalConePullbackData h I J hJ).map hU) (I.normalConeToQuotient.app (op U))
      (J.normalConeToQuotient.app (op U')) ((quotientPullbackData h I J hJ).map hU) :=
  CommRingCat.isPushout_of_map_ker_eq_ker _ _ _ _
    (normalConePullbackData_map_normalConeToQuotient h I J hJ hU)
    (I.surjective_normalConeToQuotient_app _) (J.surjective_normalConeToQuotient_app _)
    (map_ker_normalConeToQuotient h I J hJ hU hJeq)

/-- **Blueprint `lemma-functoriality-deformation`, `f̃_s⁻¹(Z) = Z'` schematically**. If `J = h^* I ·
𝒪_{X'}` (on all pairs of affine opens `U' ⊆ h⁻¹ U`), then the zero section `V(J) ⟶ N_J X'` is the
pullback of the zero section `V(I) ⟶ N_I X` along the morphism of normal cones `N_J X' ⟶ N_I X`. -/
theorem isPullback_normalConeZeroSection_normalConeMap
    (hJeq : ∀ ⦃U' : X'.AffineZariskiSite⦄ ⦃U : X.AffineZariskiSite⦄ (hU : U'.1 ≤ h ⁻¹ᵁ U.1),
      (I.siteIdeal U).map (h.appLE U.1 U'.1 hU).hom = J.siteIdeal U') :
    IsPullback J.normalConeZeroSection (quotientSpecMap h I J hJ) (normalConeMap h I J hJ)
      I.normalConeZeroSection := by
  refine Scheme.isPullback_of_openCover_of_isPullback _ _ _ _
    (pairsCover h J.coequifibered_toNormalConePresheaf)
    (fun q ↦ (relativeGluingData J.coequifibered_toQuotientAlgebra).functor.obj q.1.1)
    (fun q ↦ colimit.ι (relativeGluingData J.coequifibered_toQuotientAlgebra).functor q.1.1)
    (fun q ↦ Spec.map (J.normalConeToQuotient.app (op q.1.1)))
    (fun q ↦ isPullback_ι_relativeGluingMap _ _ _
      J.toNormalConePresheaf_comp_normalConeToQuotient q.1.1) fun q ↦ ?_
  obtain ⟨⟨U', U⟩, hU : U'.1 ≤ h ⁻¹ᵁ U.1⟩ := q
  have P := (isPullback_SpecMap_of_isPushout _ _ _ _
    (isPushout_normalConePullbackData_map h I J hJ hU (hJeq hU))).paste_vert
    (isPullback_ι_relativeGluingMap I.coequifibered_toNormalConePresheaf
      I.coequifibered_toQuotientAlgebra _ I.toNormalConePresheaf_comp_normalConeToQuotient U).flip
  rw [← PullbackData.ι_comparison _ _ (quotientPullbackData h I J hJ) hU,
    ← PullbackData.ι_comparison _ _ (normalConePullbackData h I J hJ) hU] at P
  exact P

/-- **Blueprint `lemma-functoriality-deformation`, `f̃_s⁻¹(Z) = Z'` schematically**, for `J = h⁻¹ I`
the ideal sheaf of the scheme-theoretic preimage. -/
theorem isPullback_normalConeZeroSection_normalConeMap_comap (hJI : J = I.comap h) :
    IsPullback J.normalConeZeroSection (quotientSpecMap h I J hJ) (normalConeMap h I J hJ)
      I.normalConeZeroSection := by
  subst hJI
  exact isPullback_normalConeZeroSection_normalConeMap h I _ hJ fun U' U hU ↦
    (ideal_comap_appLE I h ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU).symm

end AlgebraicGeometry.Scheme.IdealSheafData
