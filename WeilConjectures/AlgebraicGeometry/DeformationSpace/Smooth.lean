module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.RingTheory.RingHom.StandardSmooth
public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import WeilConjectures.Mathlib.RingTheory.ReesAlgebra
public import WeilConjectures.Mathlib.RingTheory.Smooth.StandardSmooth
public import WeilConjectures.Mathlib.RingTheory.Unramified.Basic

/-!
# Smoothness of the deformation to the normal cone, in coordinates

Let `C ⟶ A` be a ring map and `ψ : C[X₁, …, X_d] ⟶ A` an étale `C`-algebra map. Then the extended
Rees algebra of the ideal `(ψ(X₁), …, ψ(X_d))` is the base change `A ⊗_{C[X]} C[t][U₁, …, U_d]`
of the extended Rees algebra of the origin, so it is smooth of relative dimension `d` over `C[t]`.
If `A` has a `C`-algebra section `σ`, coordinates can be chosen near `V(ker σ)` so that `ker σ`
is generated by the coordinates: this is the étale-local linearisation of a section of a smooth
morphism.

## Main statements

- `AlgebraicGeometry.smoothOfRelativeDimension_extendedReesAlgebra_of_etale`
-/

@[expose] public section

universe u

open CategoryTheory Polynomial LaurentPolynomial

open scoped AlgebraMonoidAlgebra

namespace AlgebraicGeometry

variable {C A : Type u} [CommRing C] [CommRing A]

/-- The extended Rees algebra of the ideal generated by étale coordinates is smooth of relative
dimension `d` over `C[t]`: it is étale over `C[t][U₁, …, U_d]`. -/
theorem smoothOfRelativeDimension_extendedReesAlgebra_of_etale {d : ℕ} (f : C →+* A)
    (ψ : MvPolynomial (Fin d) C →+* A) (hψ : ψ.Etale) (hf : ψ.comp MvPolynomial.C = f) :
    SmoothOfRelativeDimension d (Spec.map (CommRingCat.ofHom
      (((Ideal.mvPolynomialOrigin C (Fin d)).map ψ).toExtendedReesAlgebra.comp
        (mapRingHom f)))) := by
  let := ψ.toAlgebra
  have : Algebra.Etale (MvPolynomial (Fin d) C) A := hψ
  set P := MvPolynomial (Fin d) C
  set J := Ideal.mvPolynomialOrigin C (Fin d)
  have hpush := CommRingCat.isPushout_of_isPushout P A J.extendedReesAlgebra
    (J.map (algebraMap P A)).extendedReesAlgebra
  -- the base change square
  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpush
  have h₁ : SmoothOfRelativeDimension 0 (Spec.map (CommRingCat.ofHom
      (algebraMap J.extendedReesAlgebra (J.map (algebraMap P A)).extendedReesAlgebra))) := by
    have : Etale (Spec.map (CommRingCat.ofHom (algebraMap P A))) :=
      HasRingHomProperty.Spec_iff.mpr hψ
    have : Etale (Spec.map (CommRingCat.ofHom
        (algebraMap J.extendedReesAlgebra (J.map (algebraMap P A)).extendedReesAlgebra))) :=
      MorphismProperty.of_isPullback hpb this
    infer_instance
  have h₂ : SmoothOfRelativeDimension d (Spec.map (CommRingCat.ofHom
      (J.toExtendedReesAlgebra.comp (mapRingHom (MvPolynomial.C : C →+* P))))) := by
    let e := Ideal.mvPolynomialExtendedReesAlgebraEquiv C (Fin d)
    have : IsIso (CommRingCat.ofHom e.toRingHom) := inferInstanceAs (IsIso e.toCommRingCatIso.hom)
    rw [← Ideal.mvPolynomialExtendedReesAlgebraEquiv_comp_C, CommRingCat.ofHom_comp,
      Spec.map_comp, MorphismProperty.cancel_left_of_respectsIso
        (P := @SmoothOfRelativeDimension d)]
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension d)]
    refine RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ ?_
    have := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap (R := C[X])
      (S := MvPolynomial (Fin d) C[X]) (n := Nat.card (Fin d))).2
      (MvPolynomial.isStandardSmoothOfRelativeDimension _ _)
    simpa using this
  have h₃ := smoothOfRelativeDimension_comp (n := 0) (m := d) _ _ (hf := h₁) (hg := h₂)
  have key : ((J.map ψ).toExtendedReesAlgebra.comp (mapRingHom f)) =
      (algebraMap J.extendedReesAlgebra (J.map (algebraMap P A)).extendedReesAlgebra).comp
        (J.toExtendedReesAlgebra.comp (mapRingHom (MvPolynomial.C : C →+* P))) := by
    refine RingHom.ext fun p ↦ ?_
    change _ = Ideal.extendedReesAlgebraMap _ _ _ le_rfl _
    rw [RingHom.comp_apply, RingHom.comp_apply,
      ← RingHom.comp_apply (Ideal.extendedReesAlgebraMap _ _ _ _),
      Ideal.extendedReesAlgebraMap_comp_toExtendedReesAlgebra, RingHom.comp_apply,
      coe_mapRingHom, coe_mapRingHom, coe_mapRingHom, Polynomial.map_map, ← hf]
  rw [key, CommRingCat.ofHom_comp, Spec.map_comp]
  rw [zero_add] at h₃
  exact h₃

/-- The polynomial `p - p(0)` lies in the ideal of the origin. -/
lemma sub_C_constantCoeff_mem_mvPolynomialOrigin {d : ℕ} (p : MvPolynomial (Fin d) C) :
    p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈ Ideal.mvPolynomialOrigin C (Fin d) := by
  classical
  rw [Ideal.mvPolynomialOrigin, ← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  by_contra! h
  have hm0 : m = 0 := Finsupp.ext fun i ↦ h i (Set.mem_univ i)
  subst hm0
  rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_C,
    if_pos rfl, ← MvPolynomial.constantCoeff_eq, sub_self] at hm
  exact hm rfl

/-- **Étale coordinates adapted to a section.** Let `f : C ⟶ A` have a retraction `σ`, and let
`φ : C[X₁, …, X_d] ⟶ A` be étale over `C`. Then after inverting some `a` with `σ(a) = 1`, there
are étale coordinates `ψ : C[X₁, …, X_d] ⟶ A[1/a]` over `C` generating the kernel of `σ`: this is
the étale-local linearisation of a section of a smooth morphism. -/
theorem exists_etale_coordinates_of_section {d : ℕ} (f : C →+* A)
    (σ : A →+* C) (hσf : σ.comp f = RingHom.id C) (φ : MvPolynomial (Fin d) C →+* A)
    (hφ : φ.Etale) (hφf : φ.comp MvPolynomial.C = f) :
    ∃ a : A, σ a = 1 ∧ ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away a A'],
      ∃ ψ : MvPolynomial (Fin d) C →+* A', ψ.Etale ∧
        ψ.comp MvPolynomial.C = (algebraMap A A').comp f ∧
        (RingHom.ker σ).map (algebraMap A A') = (Ideal.mvPolynomialOrigin C (Fin d)).map ψ := by
  classical
  -- translate the coordinates so that the section lies at the origin
  let c : Fin d → C := fun i ↦ σ (φ (MvPolynomial.X i))
  let τ : MvPolynomial (Fin d) C →+* MvPolynomial (Fin d) C := MvPolynomial.eval₂Hom MvPolynomial.C
    fun i ↦ MvPolynomial.X i - MvPolynomial.C (c i)
  let τ' : MvPolynomial (Fin d) C →+* MvPolynomial (Fin d) C := MvPolynomial.eval₂Hom MvPolynomial.C
    fun i ↦ MvPolynomial.X i + MvPolynomial.C (c i)
  have hτ : τ.comp τ' = RingHom.id (MvPolynomial (Fin d) C) :=
    MvPolynomial.ringHom_ext (fun x ↦ by simp [τ, τ'])
    fun i ↦ by simp [τ, τ']
  have hτ' : τ'.comp τ = RingHom.id (MvPolynomial (Fin d) C) :=
    MvPolynomial.ringHom_ext (fun x ↦ by simp [τ, τ'])
    fun i ↦ by simp [τ, τ']
  let eτ : MvPolynomial (Fin d) C ≃+* MvPolynomial (Fin d) C := RingEquiv.ofRingHom τ τ' hτ hτ'
  let ψ : MvPolynomial (Fin d) C →+* A := φ.comp τ
  have hψ : ψ.Etale := RingHom.Etale.respectsIso.right φ eτ hφ
  have hψf : ψ.comp MvPolynomial.C = f := by
    rw [← hφf]; ext x; simp [ψ, τ]
  have hσψ : σ.comp ψ = MvPolynomial.constantCoeff := MvPolynomial.ringHom_ext
    (fun x ↦ by
      change σ (ψ (MvPolynomial.C x)) = _
      rw [← RingHom.comp_apply ψ, hψf, ← RingHom.comp_apply, hσf]
      simp)
    fun i ↦ by
      simp only [ψ, τ, c, RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_X',
        map_sub, MvPolynomial.constantCoeff_X]
      rw [← RingHom.comp_apply φ MvPolynomial.C, hφf, ← RingHom.comp_apply σ f, hσf,
        RingHom.id_apply, sub_self]
  set J' := (Ideal.mvPolynomialOrigin C (Fin d)).map ψ
  have hJ'K : J' ≤ RingHom.ker σ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.mvPolynomialOrigin, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change σ (ψ _) = 0
    rw [← RingHom.comp_apply, hσψ]
    simp
  have hP : ∀ p : MvPolynomial (Fin d) C, ψ p - f (σ (ψ p)) ∈ J' := fun p ↦ by
    have := Ideal.mem_map_of_mem ψ (sub_C_constantCoeff_mem_mvPolynomialOrigin p)
    rwa [map_sub, ← RingHom.comp_apply ψ MvPolynomial.C, hψf, ← hσψ] at this
  let := ψ.toAlgebra
  have : Algebra.Etale (MvPolynomial (Fin d) C) A := hψ
  have hsq := Algebra.FormallyUnramified.ker_le_sup_ker_sq_of_section
    (P := MvPolynomial (Fin d) C) σ f hσf J' hP
  -- the kernel of `σ` is finitely generated
  have hfg : (RingHom.ker σ).FG := by
    let := f.toAlgebra
    have : Algebra.FinitePresentation C A := by
      have h₁ : (algebraMap C (MvPolynomial (Fin d) C)).FinitePresentation :=
        RingHom.finitePresentation_algebraMap.mpr inferInstance
      have h₂ : ψ.FinitePresentation := hψ.finitePresentation
      have := h₂.comp h₁
      rwa [show ψ.comp (algebraMap C (MvPolynomial (Fin d) C)) = algebraMap C A from hψf] at this
    let σ' : A →ₐ[C] C := { σ with commutes' := fun x ↦ congr($hσf x) }
    exact Algebra.FinitePresentation.ker_fG_of_surjective σ' fun x ↦ ⟨f x, congr($hσf x)⟩
  -- its image in `A / J'` is generated by an idempotent
  set K := RingHom.ker σ
  have hKfg : (K.map (Ideal.Quotient.mk J')).FG := hfg.map _
  have hKidem : IsIdempotentElem (K.map (Ideal.Quotient.mk J')) := by
    refine le_antisymm Ideal.mul_le_left ?_
    rw [← pow_two, ← Ideal.map_pow]
    calc K.map (Ideal.Quotient.mk J') ≤ (J' ⊔ K ^ 2).map (Ideal.Quotient.mk J') :=
          Ideal.map_mono hsq
      _ = (K ^ 2).map (Ideal.Quotient.mk J') := by
          rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq]
  obtain ⟨ē, hē, hKē⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hKfg).mp hKidem
  obtain ⟨e, rfl⟩ := Ideal.Quotient.mk_surjective ē
  have heK : e ∈ K := by
    have : Ideal.Quotient.mk J' e ∈ K.map (Ideal.Quotient.mk J') :=
      hKē ▸ Ideal.mem_span_singleton_self _
    obtain ⟨k, hk, hke⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp this
    have := Ideal.Quotient.eq.mp hke
    simpa using K.sub_mem hk (hJ'K this)
  refine ⟨1 - e, by rw [map_sub, map_one, RingHom.mem_ker.mp heK, sub_zero], fun A' _ _ _ ↦ ?_⟩
  have hJ : K.map (algebraMap A A') =
      (Ideal.mvPolynomialOrigin C (Fin d)).map ((algebraMap A A').comp ψ) := by
    rw [← Ideal.map_map]
    refine le_antisymm ?_ (Ideal.map_mono hJ'K)
    rw [Ideal.map_le_iff_le_comap]
    intro y hy
    have hu : IsUnit (algebraMap A A' (1 - e)) := IsLocalization.Away.algebraMap_isUnit _
    have hmy : Ideal.Quotient.mk J' y ∈ (A ⧸ J') ∙ Ideal.Quotient.mk J' e :=
      hKē ▸ Ideal.mem_map_of_mem _ hy
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hmy
    rw [smul_eq_mul] at hr
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [← map_mul, eq_comm, Ideal.Quotient.eq] at hr
    have he2 : e * (1 - e) ∈ J' := by
      have := hē.eq
      rw [← map_mul, Ideal.Quotient.eq] at this
      simpa [mul_sub, mul_comm] using J'.neg_mem this
    have heJ : algebraMap A A' e ∈ J'.map (algebraMap A A') := by
      obtain ⟨u, hu⟩ := hu
      have : algebraMap A A' e = algebraMap A A' (e * (1 - e)) * ↑u⁻¹ := by
        rw [map_mul, ← hu, mul_assoc, Units.mul_inv, mul_one]
      rw [this]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ he2)
    rw [Ideal.mem_comap]
    have : y = (y - r * e) + r * e := by ring
    rw [this, map_add, map_mul]
    exact Ideal.add_mem _ (Ideal.mem_map_of_mem _ hr) (Ideal.mul_mem_left _ _ heJ)
  refine ⟨(algebraMap A A').comp ψ, ?_, by rw [RingHom.comp_assoc, hψf], hJ⟩
  exact RingHom.Etale.stableUnderComposition _ _ hψ
    (RingHom.Etale.propertyIsLocal.HoldsForLocalizationAway RingHom.Etale.containsIdentities
      A' (1 - e))

/-- **Étale coordinates adapted to a section.** Let `f : C ⟶ A` have a retraction `σ`, and let
`φ : C[X₁, …, X_d] ⟶ A` be étale over `C`. Then after inverting some `a` with `σ(a) = 1`, the
kernel of `σ` is generated by étale coordinates, and hence the extended Rees algebra of `ker σ`
is smooth of relative dimension `d` over `C[t]`. -/
theorem exists_smoothOfRelativeDimension_extendedReesAlgebra_of_section {d : ℕ} (f : C →+* A)
    (σ : A →+* C) (hσf : σ.comp f = RingHom.id C) (φ : MvPolynomial (Fin d) C →+* A)
    (hφ : φ.Etale) (hφf : φ.comp MvPolynomial.C = f) :
    ∃ a : A, σ a = 1 ∧ ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away a A'],
      SmoothOfRelativeDimension d (Spec.map (CommRingCat.ofHom
        (((RingHom.ker σ).map (algebraMap A A')).toExtendedReesAlgebra.comp
          (mapRingHom ((algebraMap A A').comp f))))) := by
  obtain ⟨a, hσa, H⟩ := exists_etale_coordinates_of_section f σ hσf φ hφ hφf
  refine ⟨a, hσa, fun A' _ _ _ ↦ ?_⟩
  obtain ⟨ψ, hψ, hψf, hJ⟩ := H A'
  rw [hJ]
  exact smoothOfRelativeDimension_extendedReesAlgebra_of_etale _ _ hψ hψf

/-- Away from the closed subscheme the deformation space is `𝔾_m` times the base: if `f : C ⟶ A`
is smooth of relative dimension `d`, so is `C[t] ⟶ A[t, A t⁻¹] = A[t, t⁻¹]`. -/
theorem smoothOfRelativeDimension_extendedReesAlgebra_top {d : ℕ} (f : C →+* A)
    (hf : SmoothOfRelativeDimension d (Spec.map (CommRingCat.ofHom f))) :
    SmoothOfRelativeDimension d (Spec.map (CommRingCat.ofHom
      ((⊤ : Ideal A).toExtendedReesAlgebra.comp (mapRingHom f)))) := by
  let e : (⊤ : Ideal A).extendedReesAlgebra ≃+* A[T;T⁻¹] :=
    ((Subalgebra.equivOfEq _ _ Ideal.extendedReesAlgebra_top).trans
      Subalgebra.topEquiv).toRingEquiv
  have he : (e.toRingHom.comp ((⊤ : Ideal A).toExtendedReesAlgebra.comp (mapRingHom f))) =
      (LaurentPolynomial.mapRingHom f).comp toLaurent := by
    refine RingHom.ext fun p ↦ ?_
    change toLaurent (p.map f) = LaurentPolynomial.mapRingHom f (toLaurent p)
    rw [LaurentPolynomial.mapRingHom_toLaurent]
  have : IsIso (CommRingCat.ofHom e.toRingHom) := inferInstanceAs (IsIso e.toCommRingCatIso.hom)
  rw [← MorphismProperty.cancel_left_of_respectsIso (P := @SmoothOfRelativeDimension d)
    (Spec.map (CommRingCat.ofHom e.toRingHom)), ← Spec.map_comp, ← CommRingCat.ofHom_comp, he,
    CommRingCat.ofHom_comp, Spec.map_comp]
  let := f.toAlgebra
  have hpush := CommRingCat.isPushout_of_isPushout C A C[T;T⁻¹] A[T;T⁻¹]
  have h₁ : SmoothOfRelativeDimension d
      (Spec.map (CommRingCat.ofHom (LaurentPolynomial.mapRingHom f))) :=
    have := smoothOfRelativeDimension_isStableUnderBaseChange (n := d)
    MorphismProperty.of_isPullback (isPullback_SpecMap_of_isPushout _ _ _ _ hpush) hf
  have h₂ : IsOpenImmersion (Spec.map (CommRingCat.ofHom (toLaurent : C[X] →+* C[T;T⁻¹]))) :=
    IsOpenImmersion.of_isLocalization (S := C[T;T⁻¹]) (X : C[X])
  have := smoothOfRelativeDimension_comp (n := d) (m := 0)
    (Spec.map (CommRingCat.ofHom (LaurentPolynomial.mapRingHom f))) (Spec.map (CommRingCat.ofHom
    (toLaurent : C[X] →+* C[T;T⁻¹])))
  rwa [add_zero] at this

end AlgebraicGeometry
