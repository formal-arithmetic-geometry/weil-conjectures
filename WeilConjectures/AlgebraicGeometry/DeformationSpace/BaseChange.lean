module

public import WeilConjectures.AlgebraicGeometry.DeformationSpace.AffineSpace

/-!
# Base change of the deformation to the normal cone

Let `g : V ⟶ B` be a morphism with a section `s`, and `b : B' ⟶ B`. The base change
`g' : V' = V ×_B B' ⟶ B'` has the section `s' = (b ≫ s, 𝟙)`. This file proves that `s'` is the
base change of `s` along `h : V' ⟶ V`, so that the ideal of `s'` is the pullback of the ideal of
`s`. It also states blueprint `sk-lem-geometry` (5): the deformation space commutes with base
change in `B`. For the standard pair this is
`AlgebraicGeometry.Scheme.Hom.isPullback_deformationSpaceMap`.

## Main statements

- `AlgebraicGeometry.Scheme.Hom.isPullback_baseChangeSection`
- `AlgebraicGeometry.Scheme.Hom.ker_baseChangeSection`
- `AlgebraicGeometry.Scheme.IdealSheafData.comap_eq_ofIdealTop`
- `AlgebraicGeometry.Scheme.IdealSheafData.isPullback_deformationSpaceComap`: along an open
  immersion `h : X' ⟶ X`, `D_{h^* I} X' = D_I X ×_X X'`
- `AlgebraicGeometry.Scheme.Hom.exists_isPullback_deformationSpace_baseChange_of_isOpenImmersion`:
  blueprint `sk-lem-geometry` (5) for an open immersion `b : B' ⟶ B`
- `AlgebraicGeometry.Scheme.Hom.exists_isPullback_deformationSpace_baseChange` (unfinished)
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme.Hom

variable {V B B' : Scheme.{u}} (g : V ⟶ B) (s : B ⟶ V) (hs : s ≫ g = 𝟙 B) (b : B' ⟶ B)

/-- The section `s' = (b ≫ s, 𝟙) : B' ⟶ V ×_B B'` of the base change of `g` along `b`. -/
noncomputable def baseChangeSection : B' ⟶ pullback g b :=
  pullback.lift (b ≫ s) (𝟙 B') (by rw [Category.assoc, hs, Category.comp_id, Category.id_comp])

@[reassoc (attr := simp)]
lemma baseChangeSection_fst : baseChangeSection g s hs b ≫ pullback.fst g b = b ≫ s :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
lemma baseChangeSection_snd : baseChangeSection g s hs b ≫ pullback.snd g b = 𝟙 B' :=
  pullback.lift_snd _ _ _

/-- The section `s'` is the base change of `s` along `h : V ×_B B' ⟶ V`. -/
lemma isPullback_baseChangeSection :
    IsPullback (baseChangeSection g s hs b) b (pullback.fst g b) s := by
  refine IsPullback.of_right (h₁₂ := pullback.snd g b) (h₂₂ := g) (v₁₃ := b) ?_
    (baseChangeSection_fst g s hs b) (IsPullback.of_hasPullback g b).flip
  rw [baseChangeSection_snd, hs]
  exact IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩

/-- The ideal of the base-changed section `s'` is the pullback of the ideal of `s` along
`h : V ×_B B' ⟶ V`. -/
lemma ker_baseChangeSection [IsClosedImmersion s] :
    (baseChangeSection g s hs b).ker = s.ker.comap (pullback.fst g b) := by
  rw [← IdealSheafData.ker_fst_of_isClosedImmersion,
    ← (isPullback_baseChangeSection g s hs b).isoPullback_hom_fst, ker_comp_of_isIso]

/-- Over affine schemes, the pullback of an ideal sheaf is the ideal generated by the image:
`(I.comap f)(X) = I(Y) · Γ(X)`. -/
lemma _root_.AlgebraicGeometry.Scheme.IdealSheafData.comap_eq_ofIdealTop {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (I : Y.IdealSheafData) (f : X ⟶ Y) :
    I.comap f = IdealSheafData.ofIdealTop
      (Ideal.map f.appTop.hom (I.ideal ⟨⊤, isAffineOpen_top Y⟩)) := by
  have htop : ∀ (Z : Scheme.{u}) (h : (⊤ : Z.Opens) ≤ ⊤), Z.presheaf.map (homOfLE h).op = 𝟙 _ :=
    fun Z h ↦ by rw [show homOfLE h = 𝟙 _ from Subsingleton.elim _ _, op_id,
      CategoryTheory.Functor.map_id]
  apply le_antisymm
  · rw [← IdealSheafData.le_map_iff_comap_le]
    refine IdealSheafData.le_of_isAffine fun x hx ↦ ?_
    rw [IdealSheafData.ideal_map_of_isAffineHom, Ideal.mem_comap]
    change f.appTop x ∈ Ideal.map _ _
    erw [htop X, CommRingCat.hom_id, Ideal.map_id]
    exact Ideal.mem_map_of_mem _ hx
  · refine IdealSheafData.le_of_isAffine ?_
    rw [IdealSheafData.ofIdealTop_ideal, htop X, CommRingCat.hom_id, Ideal.map_id,
      Ideal.map_le_iff_le_comap]
    intro y hy
    have := IdealSheafData.le_map_comap (f := f) (J := I) ⟨⊤, isAffineOpen_top Y⟩ hy
    rw [IdealSheafData.ideal_map_of_isAffineHom] at this
    exact this

/-- Blueprint `sk-lem-geometry` (5), base change in `B`: for `g : V ⟶ B` smooth of relative
dimension `d` with a closed section `s`, and any `b : B' ⟶ B`, the deformation space of the
base-changed section `s'` of `g' : V ×_B B' ⟶ B'` is the base change of the deformation space
of `s`,

`D_{s'} V' = D_s V ×_{𝔸¹_B} 𝔸¹_{B'}`,

compatibly with the sections `s̃' = b ×s̃`. For the standard pair this is
`AlgebraicGeometry.Scheme.Hom.isPullback_deformationSpaceMap`. -/
theorem exists_isPullback_deformationSpace_baseChange (d : ℕ) [SmoothOfRelativeDimension d g]
    [IsClosedImmersion s] :
    ∃ φ : (baseChangeSection g s hs b).ker.deformationSpace ⟶ s.ker.deformationSpace,
      IsPullback φ (deformationSpaceProj (pullback.snd g b) (baseChangeSection g s hs b))
        (deformationSpaceProj g s) (AffineSpace.map _ b) ∧
      (baseChangeSection g s hs b).deformationSpaceSection ≫ φ =
        AffineSpace.map _ b ≫ s.deformationSpaceSection := by
  sorry

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.Scheme.IdealSheafData

open AffineZariskiSite

variable {X X' : Scheme.{u}} (h : X' ⟶ X) [IsOpenImmersion h] (I : X.IdealSheafData)

/-- The image `h(U)` of an affine open `U` under an open immersion. -/
def imageSite (U : X'.AffineZariskiSite) : X.AffineZariskiSite :=
  ⟨h ''ᵁ U.1, U.2.image_of_isOpenImmersion h⟩

lemma imageSite_mono {U V : X'.AffineZariskiSite} (i : U ≤ V) : imageSite h U ≤ imageSite h V := by
  obtain ⟨r, hr⟩ := i
  refine ⟨(h.appIso V.1).inv r, ?_⟩
  change _ = h ''ᵁ U.1
  rw [← Scheme.image_basicOpen]
  exact congrArg (h ''ᵁ ·) hr

lemma map_siteIdeal_imageSite (U : X'.AffineZariskiSite) :
    (I.siteIdeal (imageSite h U)).map (h.appIso U.1).hom.hom = (I.comap h).siteIdeal U := by
  rw [siteIdeal, siteIdeal, ideal_comap_of_isOpenImmersion I h ⟨U.1, U.2⟩]
  exact Ideal.map_comap_of_equiv (h.appIso U.1).commRingCatIsoToRingEquiv

/-- The isomorphism `Γ(h(U))[t, I t⁻¹] ≅ Γ(U)[t, (h^* I) t⁻¹]` of extended Rees algebras along
an open immersion `h`. -/
noncomputable def reesComapMap (U : X'.AffineZariskiSite) :
    I.reesPresheaf.obj (.op (imageSite h U)) ⟶ (I.comap h).reesPresheaf.obj (.op U) :=
  CommRingCat.ofHom <| (I.siteIdeal (imageSite h U)).extendedReesAlgebraMap
    (h.appIso U.1).hom.hom _ (map_siteIdeal_imageSite h I U).le

lemma bijective_reesComapMap (U : X'.AffineZariskiSite) :
    Function.Bijective (reesComapMap h I U) :=
  Ideal.bijective_extendedReesAlgebraMap (h.appIso U.1).commRingCatIsoToRingEquiv _
    (map_siteIdeal_imageSite h I U)

set_option backward.isDefEq.respectTransparency false in
lemma reesComapMap_naturality {U V : X'.AffineZariskiSite} (i : U ⟶ V) :
    I.reesPresheaf.map (homOfLE (imageSite_mono h i.le)).op ≫ reesComapMap h I U =
      reesComapMap h I V ≫ (I.comap h).reesPresheaf.map i.op := by
  ext x : 2
  refine Subtype.ext ?_
  change LaurentPolynomial.mapRingHom _ (LaurentPolynomial.mapRingHom _ x.1) =
    LaurentPolynomial.mapRingHom _ (LaurentPolynomial.mapRingHom _ x.1)
  rw [LaurentPolynomial.mapRingHom_mapRingHom, LaurentPolynomial.mapRingHom_mapRingHom,
    ← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
  congr 3
  exact Scheme.Hom.appIso_hom_naturality h (homOfLE (toOpens_mono i.le)).op

/-- The chart `Spec Γ(U)[t, (h^* I) t⁻¹] ≅ Spec Γ(h(U))[t, I t⁻¹] ⟶ D_I X`. -/
noncomputable def deformationSpaceComapChart (U : X'.AffineZariskiSite) :
    (relativeGluingData (I.comap h).coequifibered_toReesPresheaf).functor.obj U ⟶
      I.deformationSpace :=
  Spec.map (reesComapMap h I U) ≫
    colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor (imageSite h U)

lemma map_comp_deformationSpaceComapChart {U V : X'.AffineZariskiSite} (i : U ⟶ V) :
    (relativeGluingData (I.comap h).coequifibered_toReesPresheaf).functor.map i ≫
      deformationSpaceComapChart h I V = deformationSpaceComapChart h I U := by
  rw [deformationSpaceComapChart, deformationSpaceComapChart,
    ← colimit.w (relativeGluingData I.coequifibered_toReesPresheaf).functor
      (homOfLE (imageSite_mono h i.le))]
  change Spec.map _ ≫ Spec.map _ ≫ _ = Spec.map _ ≫ Spec.map _ ≫ _
  rw [← Spec.map_comp_assoc, ← Spec.map_comp_assoc]
  congr 2
  exact (reesComapMap_naturality h I i).symm

/-- The comparison morphism `D_{h^* I} X' ⟶ D_I X` along an open immersion `h : X' ⟶ X`. -/
noncomputable def deformationSpaceComap : (I.comap h).deformationSpace ⟶ I.deformationSpace :=
  colimit.desc _
    { pt := _
      ι := { app U := deformationSpaceComapChart h I U
             naturality _ _ i := (map_comp_deformationSpaceComapChart h I i).trans
              (Category.comp_id _).symm } }

@[reassoc (attr := simp)]
lemma ι_deformationSpaceComap (U : X'.AffineZariskiSite) :
    colimit.ι (relativeGluingData (I.comap h).coequifibered_toReesPresheaf).functor U ≫
      deformationSpaceComap h I = deformationSpaceComapChart h I U :=
  colimit.ι_desc _ _

set_option backward.isDefEq.respectTransparency false in
@[reassoc]
lemma deformationSpaceComap_toBase :
    deformationSpaceComap h I ≫ (relativeGluingData I.coequifibered_toReesPresheaf).toBase =
      (relativeGluingData (I.comap h).coequifibered_toReesPresheaf).toBase ≫ h := by
  refine colimit.hom_ext fun U ↦ ?_
  rw [ι_deformationSpaceComap_assoc, deformationSpaceComapChart, Category.assoc, ι_toBase,
    ι_toBase_assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec h (imageSite h U).2 U.2
      (Scheme.Hom.preimage_image_eq h U.1).ge,
    ← Spec.map_comp_assoc, ← Spec.map_comp_assoc]
  congr 2
  ext x : 2
  refine (Ideal.extendedReesAlgebraMap_algebraMap (h.appIso U.1).hom.hom _
    (map_siteIdeal_imageSite h I U).le x).trans ?_
  simp only [Scheme.Hom.appIso_hom']
  rfl

instance (U : X'.AffineZariskiSite) : IsIso (Spec.map (reesComapMap h I U)) := by
  have : IsIso (reesComapMap h I U) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr (bijective_reesComapMap h I U)
  infer_instance

set_option backward.isDefEq.respectTransparency false in
/-- **The deformation space commutes with restriction to opens**: along an open immersion
`h : X' ⟶ X`, `D_{h^* I} X' = D_I X ×_X X'`. -/
lemma isPullback_deformationSpaceComap :
    IsPullback (deformationSpaceComap h I)
      (relativeGluingData (I.comap h).coequifibered_toReesPresheaf).toBase
      (relativeGluingData I.coequifibered_toReesPresheaf).toBase h := by
  set G' := relativeGluingData (I.comap h).coequifibered_toReesPresheaf
  set G := relativeGluingData I.coequifibered_toReesPresheaf
  refine (Scheme.isPullback_of_openCover_of_isPullback _ _ _ _ (directedCover X')
    (fun U ↦ G'.functor.obj U) (fun U ↦ colimit.ι G'.functor U) (fun U ↦ G'.natTrans.app U)
    (fun U ↦ (G'.isPullback_natTrans_ι_toBase U).flip) fun U ↦ ?_).flip
  have Q := G.isPullback_natTrans_ι_toBase (imageSite h U)
  have top : IsPullback (G'.natTrans.app U) (Spec.map (reesComapMap h I U))
      (h.isoImage U.1).hom (G.natTrans.app (imageSite h U)) := by
    refine IsPullback.of_vert_isIso ⟨?_⟩
    rw [← cancel_mono ((directedCover X).f (imageSite h U)), Category.assoc, Category.assoc, Q.w]
    erw [Scheme.Hom.isoImage_hom_ι]
    rw [reassoc_of% (G'.isPullback_natTrans_ι_toBase U).w, ← deformationSpaceComap_toBase,
      ι_deformationSpaceComap_assoc, deformationSpaceComapChart, Category.assoc]
  have := top.paste_vert Q
  rw [ι_deformationSpaceComap, deformationSpaceComapChart]
  rw [show (directedCover X').f U ≫ h = (h.isoImage U.1).hom ≫ (directedCover X).f (imageSite h U)
    from (Scheme.Hom.isoImage_hom_ι h U.1).symm]
  exact this

variable {B B' : Scheme.{u}}

omit [IsOpenImmersion h] in
lemma deformationSpaceProj_over' (g : X ⟶ B) :
    (I.deformationSpaceToPolynomialSpec ≫ X.polynomialSpecToAffineSpace ≫
      AffineSpace.map (ULift.{u} (Fin 1)) g) ≫ 𝔸(ULift.{u} (Fin 1); B) ↘ B =
      (relativeGluingData I.coequifibered_toReesPresheaf).toBase ≫ g := by
  rw [Category.assoc, Category.assoc, AffineSpace.map_over, polynomialSpecToAffineSpace_over_assoc,
    deformationSpaceToPolynomialSpec,
    relativeGluingMap_toBase_assoc _ _ _ I.toPolynomialPresheaf_comp_polynomialToRees]

set_option backward.isDefEq.respectTransparency false in
omit [IsOpenImmersion h] in
lemma ι_deformationSpaceProj_appTop_coord (g : X ⟶ B) (U : X.AffineZariskiSite) (i) :
    (colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor U ≫
      I.deformationSpaceToPolynomialSpec ≫ X.polynomialSpecToAffineSpace ≫
        AffineSpace.map (ULift.{u} (Fin 1)) g).appTop (AffineSpace.coord _ i) =
      (ΓSpecIso _).inv ((I.siteIdeal U).toExtendedReesAlgebra Polynomial.X) := by
  rw [deformationSpaceToPolynomialSpec, ι_relativeGluingMap_assoc,
    ι_polynomialSpecToAffineSpace_assoc, polynomialSpecChart, AffineSpace.homOfVector_map,
    AffineSpace.comp_homOfVector,
    AffineSpace.homOfVector_appTop_coord, Function.comp_apply, ← CommRingCat.comp_apply,
    ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
  rfl

lemma deformationSpaceComap_proj_over (g : X ⟶ B) (g' : X' ⟶ B') (b : B' ⟶ B)
    (w : h ≫ g = g' ≫ b) :
    (deformationSpaceComap h I ≫ I.deformationSpaceToPolynomialSpec ≫
      X.polynomialSpecToAffineSpace ≫ AffineSpace.map (ULift.{u} (Fin 1)) g) ≫
        𝔸(ULift.{u} (Fin 1); B) ↘ B =
      (((I.comap h).deformationSpaceToPolynomialSpec ≫ X'.polynomialSpecToAffineSpace ≫
        AffineSpace.map (ULift.{u} (Fin 1)) g') ≫ AffineSpace.map _ b) ≫
          𝔸(ULift.{u} (Fin 1); B) ↘ B := by
  have e₁ := deformationSpaceProj_over' I g
  have e₂ := deformationSpaceProj_over' (I.comap h) g'
  simp only [Category.assoc, AffineSpace.map_over, AffineSpace.map_over_assoc] at e₁ e₂ ⊢
  rw [e₁, deformationSpaceComap_toBase_assoc, w, reassoc_of% e₂]

set_option backward.isDefEq.respectTransparency false in
lemma deformationSpaceComap_proj (g : X ⟶ B) (g' : X' ⟶ B') (b : B' ⟶ B)
    (w : h ≫ g = g' ≫ b) :
    deformationSpaceComap h I ≫ I.deformationSpaceToPolynomialSpec ≫
      X.polynomialSpecToAffineSpace ≫ AffineSpace.map (ULift.{u} (Fin 1)) g =
      ((I.comap h).deformationSpaceToPolynomialSpec ≫ X'.polynomialSpecToAffineSpace ≫
        AffineSpace.map (ULift.{u} (Fin 1)) g') ≫ AffineSpace.map _ b := by
  refine colimit.hom_ext fun U ↦ AffineSpace.hom_ext ?_ fun i ↦ ?_
  · simp only [Category.assoc] at *
    have := congrArg (colimit.ι (relativeGluingData
      (I.comap h).coequifibered_toReesPresheaf).functor U ≫ ·)
      (deformationSpaceComap_proj_over h I g g' b w)
    simpa only [Category.assoc] using this
  · have e₁ := ι_deformationSpaceProj_appTop_coord I g (imageSite h U) i
    have e₂ := ι_deformationSpaceProj_appTop_coord (I.comap h) g' U i
    have e₃ : (colimit.ι (relativeGluingData (I.comap h).coequifibered_toReesPresheaf).functor U ≫
        ((I.comap h).deformationSpaceToPolynomialSpec ≫ X'.polynomialSpecToAffineSpace ≫
          AffineSpace.map (ULift.{u} (Fin 1)) g') ≫ AffineSpace.map _ b).appTop
          (AffineSpace.coord B i) =
        (ΓSpecIso _).inv (((I.comap h).siteIdeal U).toExtendedReesAlgebra Polynomial.X) := by
      change Scheme.Hom.appTop (colimit.ι (relativeGluingData
        (I.comap h).coequifibered_toReesPresheaf).functor U ≫
          (I.comap h).deformationSpaceToPolynomialSpec ≫ X'.polynomialSpecToAffineSpace ≫
            AffineSpace.map (ULift.{u} (Fin 1)) g')
        ((AffineSpace.map _ b).appTop (AffineSpace.coord B i)) = _
      rw [AffineSpace.map_appTop_coord]
      exact e₂
    rw [e₃, ι_deformationSpaceComap_assoc, deformationSpaceComapChart, Category.assoc]
    change (Spec.map (reesComapMap h I U)).appTop (Scheme.Hom.appTop
      (colimit.ι (relativeGluingData I.coequifibered_toReesPresheaf).functor (imageSite h U) ≫
        I.deformationSpaceToPolynomialSpec ≫ X.polynomialSpecToAffineSpace ≫
          AffineSpace.map (ULift.{u} (Fin 1)) g) (AffineSpace.coord B i)) = _
    rw [e₁]
    refine (congr($(Scheme.ΓSpecIso_inv_naturality (reesComapMap h I U))
      ((I.siteIdeal (imageSite h U)).toExtendedReesAlgebra Polynomial.X))).symm.trans ?_
    refine congrArg (ΓSpecIso ((I.comap h).reesPresheaf.obj (.op U))).inv.hom ?_
    change (reesComapMap h I U).hom
      ((I.siteIdeal (imageSite h U)).toExtendedReesAlgebra Polynomial.X) = _
    rw [Ideal.toExtendedReesAlgebra_X, Ideal.toExtendedReesAlgebra_X]
    exact Ideal.extendedReesAlgebraMap_T _ _ (map_siteIdeal_imageSite h I U).le

/-- Along an open immersion `h : X' ⟶ X` lying over `b : B' ⟶ B` (with `X' = X ×_B B'`), the
deformation space is a base change over the affine line:
`D_{h^* I} X' = D_I X ×_{𝔸¹_B} 𝔸¹_{B'}`. -/
lemma isPullback_deformationSpaceComap_proj (g : X ⟶ B) (g' : X' ⟶ B') (b : B' ⟶ B)
    (sq : IsPullback h g' g b) :
    IsPullback (deformationSpaceComap h I)
      ((I.comap h).deformationSpaceToPolynomialSpec ≫ X'.polynomialSpecToAffineSpace ≫
        AffineSpace.map (ULift.{u} (Fin 1)) g')
      (I.deformationSpaceToPolynomialSpec ≫ X.polynomialSpecToAffineSpace ≫
        AffineSpace.map (ULift.{u} (Fin 1)) g)
      (AffineSpace.map _ b) := by
  refine IsPullback.of_bot ?_ (deformationSpaceComap_proj h I g g' b sq.w)
    (AffineSpace.isPullback_map (n := ULift.{u} (Fin 1)) b)
  rw [deformationSpaceProj_over', deformationSpaceProj_over']
  exact (isPullback_deformationSpaceComap h I).paste_vert sq

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry.Scheme.Hom

variable {V B B' : Scheme.{u}} (g : V ⟶ B) (s : B ⟶ V) (hs : s ≫ g = 𝟙 B) (b : B' ⟶ B)

/-- Blueprint `sk-lem-geometry` (5) for a Zariski localization of the base: if `b : B' ⟶ B` is
an open immersion, the deformation space of the base-changed section is the base change of the
deformation space, `D_{s'} V' = D_s V ×_{𝔸¹_B} 𝔸¹_{B'}`. -/
theorem exists_isPullback_deformationSpace_baseChange_of_isOpenImmersion [IsOpenImmersion b]
    [IsClosedImmersion s] :
    ∃ φ : (baseChangeSection g s hs b).ker.deformationSpace ⟶ s.ker.deformationSpace,
      IsPullback φ (deformationSpaceProj (pullback.snd g b) (baseChangeSection g s hs b))
        (deformationSpaceProj g s) (AffineSpace.map _ b) ∧
      φ ≫ s.ker.deformationSpaceProj =
        (baseChangeSection g s hs b).ker.deformationSpaceProj ≫ pullback.fst g b := by
  have key : ∀ J : (pullback g b).IdealSheafData, J = s.ker.comap (pullback.fst g b) →
      ∃ φ : J.deformationSpace ⟶ s.ker.deformationSpace,
        IsPullback φ (J.deformationSpaceToPolynomialSpec ≫
          (pullback g b).polynomialSpecToAffineSpace ≫
            AffineSpace.map (ULift.{u} (Fin 1)) (pullback.snd g b))
          (deformationSpaceProj g s) (AffineSpace.map _ b) ∧
        φ ≫ s.ker.deformationSpaceProj = J.deformationSpaceProj ≫ pullback.fst g b := by
    rintro J rfl
    exact ⟨_, IdealSheafData.isPullback_deformationSpaceComap_proj _ _ g _ b
      (IsPullback.of_hasPullback g b), IdealSheafData.deformationSpaceComap_toBase _ _⟩
  exact key _ (ker_baseChangeSection g s hs b)

/-- Towards the section compatibility in `sk-lem-geometry` (5): for a comparison `φ` as in
`exists_isPullback_deformationSpace_baseChange_of_isOpenImmersion`, the two maps
`s̃' ≫ φ` and `b ≫ s̃ : 𝔸¹_{B'} ⟶ D_s V` agree after `D_s V ⟶ V` and after `g̃`. -/
lemma deformationSpaceSection_comp_eq_of_isPullback [IsClosedImmersion s]
    (φ : (baseChangeSection g s hs b).ker.deformationSpace ⟶ s.ker.deformationSpace)
    (h₁ : IsPullback φ (deformationSpaceProj (pullback.snd g b) (baseChangeSection g s hs b))
      (deformationSpaceProj g s) (AffineSpace.map _ b))
    (h₂ : φ ≫ s.ker.deformationSpaceProj =
      (baseChangeSection g s hs b).ker.deformationSpaceProj ≫ pullback.fst g b) :
    ((baseChangeSection g s hs b).deformationSpaceSection ≫ φ) ≫ s.ker.deformationSpaceProj =
        (AffineSpace.map _ b ≫ s.deformationSpaceSection) ≫ s.ker.deformationSpaceProj ∧
