module

public import WeilConjectures.AlgebraicGeometry.DeformationSpace.AffineSpace

/-!
# Base change of the deformation to the normal cone

Let `g : V ⟶ B` be a morphism with a section `s`, and `b : B' ⟶ B`. The base change
`g' : V' = V ×_B B' ⟶ B'` has the section `s' = (b ≫ s, 𝟙)`. This file proves that `s'` is the
base change of `s` along `h : V' ⟶ V`, so that the ideal of `s'` is the pullback of the ideal of
`s`. It also states blueprint `sk-lem-geometry` (5): the deformation space commutes with base
change in `B`. For the standard pair this is
`AlgebraicGeometry.Scheme.Hom.isPullback_deformationSpaceMap`.

## Main statements

- `AlgebraicGeometry.Scheme.Hom.isPullback_baseChangeSection`
- `AlgebraicGeometry.Scheme.Hom.ker_baseChangeSection`
- `AlgebraicGeometry.Scheme.IdealSheafData.comap_eq_ofIdealTop`
- `AlgebraicGeometry.Scheme.Hom.exists_isPullback_deformationSpace_baseChange` (unfinished)
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme.Hom

variable {V B B' : Scheme.{u}} (g : V ⟶ B) (s : B ⟶ V) (hs : s ≫ g = 𝟙 B) (b : B' ⟶ B)

/-- The section `s' = (b ≫ s, 𝟙) : B' ⟶ V ×_B B'` of the base change of `g` along `b`. -/
noncomputable def baseChangeSection : B' ⟶ pullback g b :=
  pullback.lift (b ≫ s) (𝟙 B') (by rw [Category.assoc, hs, Category.comp_id, Category.id_comp])

@[reassoc (attr := simp)]
lemma baseChangeSection_fst : baseChangeSection g s hs b ≫ pullback.fst g b = b ≫ s :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
lemma baseChangeSection_snd : baseChangeSection g s hs b ≫ pullback.snd g b = 𝟙 B' :=
  pullback.lift_snd _ _ _

/-- The section `s'` is the base change of `s` along `h : V ×_B B' ⟶ V`. -/
lemma isPullback_baseChangeSection :
    IsPullback (baseChangeSection g s hs b) b (pullback.fst g b) s := by
  refine IsPullback.of_right (h₁₂ := pullback.snd g b) (h₂₂ := g) (v₁₃ := b) ?_
    (baseChangeSection_fst g s hs b) (IsPullback.of_hasPullback g b).flip
  rw [baseChangeSection_snd, hs]
  exact IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩

/-- The ideal of the base-changed section `s'` is the pullback of the ideal of `s` along
`h : V ×_B B' ⟶ V`. -/
lemma ker_baseChangeSection [IsClosedImmersion s] :
    (baseChangeSection g s hs b).ker = s.ker.comap (pullback.fst g b) := by
  rw [← IdealSheafData.ker_fst_of_isClosedImmersion,
    ← (isPullback_baseChangeSection g s hs b).isoPullback_hom_fst, ker_comp_of_isIso]

/-- Over affine schemes, the pullback of an ideal sheaf is the ideal generated by the image:
`(I.comap f)(X) = I(Y) · Γ(X)`. -/
lemma _root_.AlgebraicGeometry.Scheme.IdealSheafData.comap_eq_ofIdealTop {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (I : Y.IdealSheafData) (f : X ⟶ Y) :
    I.comap f = IdealSheafData.ofIdealTop
      (Ideal.map f.appTop.hom (I.ideal ⟨⊤, isAffineOpen_top Y⟩)) := by
  have htop : ∀ (Z : Scheme.{u}) (h : (⊤ : Z.Opens) ≤ ⊤), Z.presheaf.map (homOfLE h).op = 𝟙 _ :=
    fun Z h ↦ by rw [show homOfLE h = 𝟙 _ from Subsingleton.elim _ _, op_id,
      CategoryTheory.Functor.map_id]
  apply le_antisymm
  · rw [← IdealSheafData.le_map_iff_comap_le]
    refine IdealSheafData.le_of_isAffine fun x hx ↦ ?_
    rw [IdealSheafData.ideal_map_of_isAffineHom, Ideal.mem_comap]
    change f.appTop x ∈ Ideal.map _ _
    erw [htop X, CommRingCat.hom_id, Ideal.map_id]
    exact Ideal.mem_map_of_mem _ hx
  · refine IdealSheafData.le_of_isAffine ?_
    rw [IdealSheafData.ofIdealTop_ideal, htop X, CommRingCat.hom_id, Ideal.map_id,
      Ideal.map_le_iff_le_comap]
    intro y hy
    have := IdealSheafData.le_map_comap (f := f) (J := I) ⟨⊤, isAffineOpen_top Y⟩ hy
    rw [IdealSheafData.ideal_map_of_isAffineHom] at this
    exact this

/-- Blueprint `sk-lem-geometry` (5), base change in `B`: for `g : V ⟶ B` smooth of relative
dimension `d` with a closed section `s`, and any `b : B' ⟶ B`, the deformation space of the
base-changed section `s'` of `g' : V ×_B B' ⟶ B'` is the base change of the deformation space
of `s`,

`D_{s'} V' = D_s V ×_{𝔸¹_B} 𝔸¹_{B'}`,

compatibly with the sections `s̃' = b ×s̃`. For the standard pair this is
`AlgebraicGeometry.Scheme.Hom.isPullback_deformationSpaceMap`. -/
theorem exists_isPullback_deformationSpace_baseChange (d : ℕ) [SmoothOfRelativeDimension d g]
    [IsClosedImmersion s] :
    ∃ φ : (baseChangeSection g s hs b).ker.deformationSpace ⟶ s.ker.deformationSpace,
      IsPullback φ (deformationSpaceProj (pullback.snd g b) (baseChangeSection g s hs b))
        (deformationSpaceProj g s) (AffineSpace.map _ b) ∧
      (baseChangeSection g s hs b).deformationSpaceSection ≫ φ =
        AffineSpace.map _ b ≫ s.deformationSpaceSection := by
  sorry

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.Scheme.IdealSheafData

open AffineZariskiSite

variable {X X' : Scheme.{u}} (h : X' ⟶ X) [IsOpenImmersion h] (I : X.IdealSheafData)

/-- The image `h(U)` of an affine open `U` under an open immersion. -/
def imageSite (U : X'.AffineZariskiSite) : X.AffineZariskiSite :=
  ⟨h ''ᵁ U.1, U.2.image_of_isOpenImmersion h⟩

lemma imageSite_mono {U V : X'.AffineZariskiSite} (i : U ≤ V) : imageSite h U ≤ imageSite h V := by
  obtain ⟨r, hr⟩ := i
  refine ⟨(h.appIso V.1).inv r, ?_⟩
  change _ = h ''ᵁ U.1
  rw [← Scheme.image_basicOpen]
  exact congrArg (h ''ᵁ ·) hr

lemma map_siteIdeal_imageSite (U : X'.AffineZariskiSite) :
    (I.siteIdeal (imageSite h U)).map (h.appIso U.1).hom.hom = (I.comap h).siteIdeal U := by
  rw [siteIdeal, siteIdeal, ideal_comap_of_isOpenImmersion I h ⟨U.1, U.2⟩]
  exact Ideal.map_comap_of_equiv (h.appIso U.1).commRingCatIsoToRingEquiv

/-- The isomorphism `Γ(h(U))[t, I t⁻¹] ≅ Γ(U)[t, (h^* I) t⁻¹]` of extended Rees algebras along
an open immersion `h`. -/
noncomputable def reesComapMap (U : X'.AffineZariskiSite) :
    I.reesPresheaf.obj (.op (imageSite h U)) ⟶ (I.comap h).reesPresheaf.obj (.op U) :=
  CommRingCat.ofHom <| (I.siteIdeal (imageSite h U)).extendedReesAlgebraMap
    (h.appIso U.1).hom.hom _ (map_siteIdeal_imageSite h I U).le

lemma bijective_reesComapMap (U : X'.AffineZariskiSite) :
    Function.Bijective (reesComapMap h I U) :=
  Ideal.bijective_extendedReesAlgebraMap (h.appIso U.1).commRingCatIsoToRingEquiv _
    (map_siteIdeal_imageSite h I U)

set_option backward.isDefEq.respectTransparency false in
lemma reesComapMap_naturality {U V : X'.AffineZariskiSite} (i : U ⟶ V) :
    I.reesPresheaf.map (homOfLE (imageSite_mono h i.le)).op ≫ reesComapMap h I U =
      reesComapMap h I V ≫ (I.comap h).reesPresheaf.map i.op := by
  ext x : 2
  refine Subtype.ext ?_
  change LaurentPolynomial.mapRingHom _ (LaurentPolynomial.mapRingHom _ x.1) =
    LaurentPolynomial.mapRingHom _ (LaurentPolynomial.mapRingHom _ x.1)
  rw [LaurentPolynomial.mapRingHom_mapRingHom, LaurentPolynomial.mapRingHom_mapRingHom,
    ← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
  congr 3
  exact Scheme.Hom.appIso_hom_naturality h (homOfLE (toOpens_mono i.le)).op

end AlgebraicGeometry.Scheme.IdealSheafData
