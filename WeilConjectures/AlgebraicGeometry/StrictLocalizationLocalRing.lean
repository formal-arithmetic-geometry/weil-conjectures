module

public import WeilConjectures.AlgebraicGeometry.Sites.StrictHenselizationLocal
public import WeilConjectures.AlgebraicGeometry.Regular

/-!
# The ring of the strict localization of a locally noetherian scheme

Let `Z` be a locally noetherian scheme, `ybar : Spec Ω ⟶ Z` a geometric point (`Ω` separably
closed) over the point `y`, and `R = 𝒪^{sh}_{Z,ybar}` the strict henselization, so that the strict
localization is `Z_(ybar) = Spec R`. Through an affine open `U ∋ y` of `Z`, the ring `R` is the
strict henselization of the local ring `𝒪_{Z,y}` (Stacks 04HX): the map `ρ : Γ(Z, U) ⟶ R` is
flat, inverts the functions not vanishing at `y`, and `𝔪_R = 𝔭_y R`; the ring `R` is noetherian,
and for a closed subscheme `D ⊆ Z` through `y` with regular local ring at `y`, the quotient
`R / I_D R` is a regular local ring (it is the strict henselization of `𝒪_{D,y}`, Stacks 06LN,
05WS).

The statements are reduced to an algebraically closed `Ω` (the strict localization only depends
on the separable closure of `κ(y)` in `Ω`), where the strict henselization is identified with the
ring-theoretic strict henselization of `𝒪_{Z,y}` (`Algebra.IsStrictHenselization`, cf.
`AlgebraicGeometry.Scheme.strictHenselizationRing_local_presentation`).

## Main statements

- `AlgebraicGeometry.Scheme.isNoetherianRing_strictHenselization_of_isLocallyNoetherian`
- `AlgebraicGeometry.Scheme.flat_strictHenselizationChartMap`
- `AlgebraicGeometry.Scheme.isUnit_strictHenselizationChartMap`
- `AlgebraicGeometry.Scheme.maximalIdeal_strictHenselization_eq_map`
- `AlgebraicGeometry.Scheme.isRegularLocalRing_strictHenselization_quotient`
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

variable {Z : Scheme.{u}} {Ω : Type u} [Field Ω] [IsSepClosed Ω] (ybar : Spec (.of Ω) ⟶ Z)

/-- The strict henselization of a locally noetherian scheme at a geometric point is a noetherian
(strictly henselian) local ring. -/
theorem isNoetherianRing_strictHenselization_of_isLocallyNoetherian [IsLocallyNoetherian Z] :
    IsNoetherianRing (strictHenselization ybar) := by
  sorry

/-- The ring map `Γ(Z, U) ⟶ 𝒪^{sh}_{Z,ybar}` through an affine open `U` containing the image
of `ybar`, induced by a factorization `φ` of `S_(ybar) ⟶ Z` through `U`. -/
noncomputable def strictHenselizationChartMap (U : Z.Opens)
    (φ : strictLocalization ybar ⟶ U.toScheme) : Γ(Z, U) ⟶ strictHenselization ybar :=
  U.topIso.inv ≫ φ.appTop ≫ (ΓSpecIso (strictHenselization ybar)).hom

variable [IsLocallyNoetherian Z] (U : Z.affineOpens) (hyU : Set.range ybar ⊆ (U : Set Z))
  (φ : strictLocalization ybar ⟶ U.1.toScheme)
  (hφ : φ ≫ U.1.ι = strictLocalizationToBase ybar)

include hyU hφ

/-- Through an affine chart `U`, the strict henselization is flat over `Γ(Z, U)`. -/
theorem flat_strictHenselizationChartMap :
    (strictHenselizationChartMap ybar U.1 φ).hom.Flat := by
  sorry

/-- Through an affine chart `U`, a function on `U` not vanishing at the point `y` under `ybar`
becomes a unit in the strict henselization. -/
theorem isUnit_strictHenselizationChartMap (a : Γ(Z, U))
    (ha : a ∉ (IsAffineOpen.primeIdealOf U.2
      ⟨ybar (IsLocalRing.closedPoint Ω), hyU ⟨_, rfl⟩⟩).asIdeal) :
    IsUnit (strictHenselizationChartMap ybar U.1 φ a) := by
  sorry

/-- Through an affine chart `U`, the maximal ideal of the strict henselization is generated by
the prime ideal of the point `y` under `ybar`. -/
theorem maximalIdeal_strictHenselization_eq_map :
    IsLocalRing.maximalIdeal (strictHenselization ybar) =
      (IsAffineOpen.primeIdealOf U.2
        ⟨ybar (IsLocalRing.closedPoint Ω), hyU ⟨_, rfl⟩⟩).asIdeal.map
        (strictHenselizationChartMap ybar U.1 φ).hom := by
  sorry

/-- Let `i : D ⟶ Z` be a closed immersion whose local ring at a point `x` over `y` is regular.
Then the quotient of the strict henselization at `ybar` by the ideal of `D` (on the affine chart
`U`) is a regular local ring: it is the strict henselization of `𝒪_{D,x}`. In particular (for
`D = Z`) the strict henselization of a regular scheme is a regular local ring. -/
theorem isRegularLocalRing_strictHenselization_quotient {D : Scheme.{u}} (i : D ⟶ Z)
    [IsClosedImmersion i] (x : D) (hx : i x = ybar (IsLocalRing.closedPoint Ω))
    [IsRegularLocalRing (D.presheaf.stalk x)] :
    IsRegularLocalRing (strictHenselization ybar ⧸
      ((Scheme.Hom.ker i).ideal U).map (strictHenselizationChartMap ybar U.1 φ).hom) := by
  sorry

end AlgebraicGeometry.Scheme
