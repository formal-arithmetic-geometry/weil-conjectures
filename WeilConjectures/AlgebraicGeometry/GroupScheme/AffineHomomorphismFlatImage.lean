module

public import Mathlib.AlgebraicGeometry.Group.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic

import WeilConjectures.AlgebraicGeometry.AffineFiniteTypeAlgebra

/-!
# Faithfully flat factorization of an affine group homomorphism

Source: Milne, Algebraic Groups (2017), Theorem 3.34, printed p.75, using
Proposition 3.14 and Theorem 3.31.
(blueprint: lem-sfb-affine-homomorphism-flat-image)
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- An affine finite-type group homomorphism factors through an affine finite-type group
by a faithfully flat homomorphism followed by a closed immersion. Faithful flatness uses
the module structure on global sections induced by the first homomorphism.

Source: Milne, Algebraic Groups (2017), Theorem 3.34, printed p.75.
(blueprint: lem-sfb-affine-homomorphism-flat-image)

Proof plan:
1. Set A = Γ(H, O_H), B = Γ(G, O_G), and φ = f*. The algebras are finitely generated by
   lem-pc-affine-finite-type-algebra. Their multiplication, unit and inverse pullbacks
   give the Hopf structures of lem-sfb-affine-group-coordinate-hopf. Compatibility of f
   with multiplication gives a homomorphism on algebra-valued points, hence compatibility
   with identity and inverse too (def-sc-group-scheme). Thus φ is a Hopf homomorphism.
2. Put C = φ(A), with its surjection A → C and inclusion C → B. Images of a finite set of
   algebra generators generate C. Comultiplication, counit and antipode restrict to C.
   To verify this, split the inclusion C → B as a linear map over the field: its tensor
   powers are injective. The Hopf identities and independence of presentations follow
   after applying these injections (lem-sfb-affine-group-coordinate-hopf).
3. Set I = Spec C. The two Hopf homomorphisms give group homomorphisms G → I → H by
   lem-sfb-hopf-spectrum-functor and def-weil-affine-spectrum, using the canonical affine
   identifications of G and H with their spectra. Contravariance gives the factorization.
   The finite algebra generators give finite type (def-weil-finite-type-morphism).
   The surjection A → C gives a closed immersion by the one-chart affine-cover criterion
   lem-weil-pbc-closed-immersion-affine-cover-criterion (2), hence def-weil-closed-immersion.
4. Apply lem-sfb-hopf-subalgebra-faithfully-flat to C → B. Both Hopf algebras are finitely
   generated and the map is injective, so B is faithfully flat over C via u* in the sense
   of def-weil-pbc-faithfully-flat-ring-map. All nilpotents are retained. No smoothness,
   reducedness, connectedness, perfectness or characteristic assumption is used. -/
theorem affineGroupHom_exists_faithfullyFlat_closedImmersion
    {k : Type u} [Field k] (G H : Over (Spec (.of k))) [GrpObj G] [GrpObj H]
    [IsAffine G.left] [IsAffine H.left]
    [LocallyOfFiniteType G.hom] [QuasiCompact G.hom]
    [LocallyOfFiniteType H.hom] [QuasiCompact H.hom]
    (f : G ⟶ H) [IsMonHom f] :
    ∃ (I : Over (Spec (.of k))) (_ : GrpObj I) (u : G ⟶ I) (j : I ⟶ H),
      IsAffine I.left ∧ LocallyOfFiniteType I.hom ∧ QuasiCompact I.hom ∧
      IsMonHom u ∧ IsMonHom j ∧ u ≫ j = f ∧ IsClosedImmersion j.left ∧
      @Module.FaithfullyFlat Γ(I.left, ⊤) Γ(G.left, ⊤) _ _
        u.left.appTop.hom.toAlgebra.toModule := by
  sorry

end AlgebraicGeometry
