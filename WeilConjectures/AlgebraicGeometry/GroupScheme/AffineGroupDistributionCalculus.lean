module
public import Mathlib.RingTheory.Coalgebra.Convolution
public import Mathlib.AlgebraicGeometry.Group.Affine
public import Mathlib.LinearAlgebra.Dual.Defs
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.Algebra.Polynomial.AlgebraMap
/-! # Distributions and polynomial conjugation on an affine group

Source: Mathieu, Tilting Modules and their Applications (2000), Section 1,
printed pp.149--152, and the adjoint identity in Lemma 2.3, printed p.155.
(blueprint: def-sfb-affine-group-distribution-calculus)

Finite-order distributions are a subset of Mathlib's full convolution dual.
All coordinate maps and polynomial coefficients below are actual constructions.
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u v
open CategoryTheory MonoidalCategory CartesianMonoidalCategory Opposite
open scoped MonObj TensorProduct
namespace AlgebraicGeometry.BorelDistributions
/-- The existing affine-coordinate algebra instance, with the bundled base explicit.
Source: Mathieu, Section 1, p.149; Mathlib Group/Affine.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
@[instance_reducible]
def coordinateAlgebraInstance (R : CommRingCat.{u}) (U : Scheme.{u})
    [U.Over (Spec R)] [IsAffine U] : Algebra R Γ(U, ⊤) := inferInstance

/-- The existing affine-coordinate Hopf instance, with the bundled base explicit.
Source: Mathieu, Section 1, p.149; Mathlib Group/Affine.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
@[instance_reducible]
def coordinateHopfInstance (R : CommRingCat.{u}) (U : Scheme.{u})
    [U.Over (Spec R)] [GrpObj (U.asOver (Spec R))] [IsAffine U] :
    HopfAlgebra R Γ(U, ⊤) := inferInstance

/-- Expose the canonical coordinate algebra when the base is written as an unbundled field.
Source: Mathieu, Section 1, p.149; Mathlib's affine-group coordinate construction.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
instance fieldCoordinateAlgebra (F : Type u) [Field F] (U : Scheme.{u})
    [U.Over (Spec (.of F))] [IsAffine U] : Algebra F Γ(U, ⊤) :=
  coordinateAlgebraInstance (.of F) U

/-- Expose the canonical coordinate Hopf algebra for an unbundled base field.
Source: Mathieu, Section 1, p.149; Mathlib's affine-group coordinate construction.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
instance fieldCoordinateHopf (F : Type u) [Field F] (U : Scheme.{u})
    [U.Over (Spec (.of F))] [GrpObj (U.asOver (Spec (.of F)))] [IsAffine U] :
    HopfAlgebra F Γ(U, ⊤) :=
  coordinateHopfInstance (.of F) U

variable (R : CommRingCat.{u}) (U : Scheme.{u}) [U.Over (Spec R)]
  [GrpObj (U.asOver (Spec R))] [IsAffine U]
/-- The full linear dual with Mathlib convolution; its unit is the coordinate counit.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
abbrev fullDual := WithConv (Γ(U, ⊤) →ₗ[R] R)
/-- Pullback along an additive parameter, through the canonical affine Spec equivalence.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def rootPullback (x : (Spec (.of (Polynomial R))).asOver (Spec R) ⟶
    U.asOver (Spec R)) : Γ(U, ⊤) →ₐ[R] Polynomial R :=
  (algSpec.fullyFaithful.preimage
    (X := op (CommAlgCat.of R (Polynomial R)))
    (Y := op (CommAlgCat.of R Γ(U, ⊤)))
    (x ≫ U.isoSpec.hom.asOver (Spec R))).unop.hom
/-- Distributions supported at the identity: a functional kills a power of the augmentation ideal.
This is the embedded union of the duals of the finite jet quotients.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def finiteOrder (a : fullDual R U) : Prop :=
  ∃ n : ℕ, ∀ f ∈ RingHom.ker (Bialgebra.counitAlgHom R Γ(U, ⊤)).toRingHom ^ (n + 1),
    a f = 0
/-- The augmentation derivation condition defining the infinitesimal distributions.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def tangent (a : fullDual R U) : Prop :=
  ∀ f g : Γ(U, ⊤), a (f * g) = Coalgebra.counit f * a g + a f * Coalgebra.counit g
/-- The unital subalgebra generated by all augmentation derivations in the full convolution dual.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def infinitesimalAlgebra : Subalgebra R (fullDual R U) :=
  Algebra.adjoin R {a | tangent R U a}
/-- The nth coefficient of pullback along the specified additive parameter.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def dividedPower (x : (Spec (.of (Polynomial R))).asOver (Spec R) ⟶
    U.asOver (Spec R)) (n : ℕ) : fullDual R U :=
  WithConv.toConv ((Polynomial.lcoeff R n).comp (rootPullback R U x).toLinearMap)
/-- Apply the middle distribution to the iterated coproduct, and evaluate the two outside
factors at x(t) and x(-t). Thus the result is a(f(x(t) v x(-t))).
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def conjugationPolynomial (x : (Spec (.of (Polynomial R))).asOver (Spec R) ⟶
    U.asOver (Spec R)) (a : fullDual R U) : Γ(U, ⊤) →ₗ[R] Polynomial R :=
  (LinearMap.mul' R (Polynomial R)) ∘ₗ
    TensorProduct.map
      ((TensorProduct.rid R (Polynomial R)).toLinearMap ∘ₗ
        TensorProduct.map (rootPullback R U x).toLinearMap a.ofConv)
      ((Polynomial.aeval (-Polynomial.X)).toLinearMap ∘ₗ
        (rootPullback R U x).toLinearMap) ∘ₗ
    TensorProduct.map (Coalgebra.comul (R := R)) (LinearMap.id : Γ(U, ⊤) →ₗ[R] Γ(U, ⊤)) ∘ₗ
    Coalgebra.comul
/-- The nth coefficient of the polynomial conjugation family, as a linear functional.
Source: Mathieu, Section 1, pp.149--152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def conjugationCoefficient (x : (Spec (.of (Polynomial R))).asOver (Spec R) ⟶
    U.asOver (Spec R)) (a : fullDual R U) (n : ℕ) : fullDual R U :=
  WithConv.toConv ((Polynomial.lcoeff R n).comp (conjugationPolynomial R U x a))
/-- Evaluation of a full-dual-valued polynomial tensor at a coordinate function.
Source: Mathieu, Section 2, p.152, coordinate coactions and their natural pairing.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def evaluatePolynomialTensor (f : Γ(U, ⊤)) :
    fullDual R U ⊗[R] Polynomial R →ₗ[R] Polynomial R :=
  (TensorProduct.lid R (Polynomial R)).toLinearMap ∘ₗ
    TensorProduct.map
      ((Module.Dual.eval R Γ(U, ⊤) f).comp
        (WithConv.linearEquiv R (Γ(U, ⊤) →ₗ[R] R)).toLinearMap) LinearMap.id

/-- Counital coassociativity for a right coordinate coaction; arbitrary module dimension is allowed.
Source: Mathieu, Section 2, p.152.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def IsCoordinateCoaction {M : Type v} [AddCommGroup M] [Module R M]
    (c : M →ₗ[R] M ⊗[R] Γ(U, ⊤)) : Prop :=
  (TensorProduct.assoc R M Γ(U, ⊤) Γ(U, ⊤)).toLinearMap ∘ₗ
      TensorProduct.map c LinearMap.id ∘ₗ c =
    TensorProduct.map LinearMap.id (Coalgebra.comul (R := R)) ∘ₗ c ∧
  (TensorProduct.rid R M).toLinearMap ∘ₗ
      TensorProduct.map LinearMap.id (Coalgebra.counit (R := R)) ∘ₗ c = LinearMap.id

/-- The action of a distribution on a rational module, obtained by applying it to the coaction.
Source: Mathieu, Section 2, p.152.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def moduleAction {M : Type v} [AddCommGroup M] [Module R M]
    (c : M →ₗ[R] M ⊗[R] Γ(U, ⊤)) (a : fullDual R U) : M →ₗ[R] M :=
  (TensorProduct.rid R M).toLinearMap ∘ₗ TensorProduct.map LinearMap.id a.ofConv ∘ₗ c

/-- Counital coassociativity for a rational additive-group action, with the actual additive
coproduct t ↦ t⊗1+1⊗t and zero counit.
Source: Mathieu, Section 2, p.152; Lemma 2.3, p.155.
(blueprint: def-sfb-affine-group-distribution-calculus) -/
def IsAdditiveCoaction {M : Type v} [AddCommGroup M] [Module R M]
    (c : M →ₗ[R] M ⊗[R] Polynomial R) : Prop :=
  (TensorProduct.assoc R M (Polynomial R) (Polynomial R)).toLinearMap ∘ₗ
      TensorProduct.map c LinearMap.id ∘ₗ c =
    TensorProduct.map LinearMap.id
      (Polynomial.aeval
        (Polynomial.X ⊗ₜ[R] 1 + 1 ⊗ₜ[R] Polynomial.X)).toLinearMap ∘ₗ c ∧
  (TensorProduct.rid R M).toLinearMap ∘ₗ
      TensorProduct.map LinearMap.id (Polynomial.aeval (0 : R)).toLinearMap ∘ₗ c = LinearMap.id

end AlgebraicGeometry.BorelDistributions
