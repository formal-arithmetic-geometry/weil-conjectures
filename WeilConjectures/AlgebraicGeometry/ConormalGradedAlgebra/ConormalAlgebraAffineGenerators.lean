module

public import WeilConjectures.AlgebraicGeometry.ConormalGradedAlgebra.ConormalGradedAlgebra

/-! # Homogeneous generators on affine conormal charts

Source: Stacks Project, Divisors, Tag 0633.
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.ConormalGradedAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- On an ambient affine chart the conormal algebra is additively generated by
homogeneous ideal-power representatives.
Source: Stacks Project, Divisors, Tag 0633. -/
theorem affine_homogeneous_induction {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (A : Presentation i) (U : X.affineOpens)
    (P : A.algebra.right.obj.obj (op (i ⁻¹ᵁ U.1)) → Prop)
    (hzero : P 0)
    (hhom : ∀ (n : ℕ) (a : (power i n).val.obj (op U.1)),
      P (homogeneousClass i A.algebra A.inclusion n U.1 a))
    (hadd : ∀ a b, P a → P b → P (a + b))
    (a : A.algebra.right.obj.obj (op (i ⁻¹ᵁ U.1))) : P a := by
  classical
  obtain ⟨e, he⟩ := A.affineChart U
  let E : A.algebra.right.obj.obj (op (i ⁻¹ᵁ U.1)) ≃+*
      Ideal.associatedGraded (i.ker.ideal U) :=
    { e.hom.hom with
      invFun := e.inv
      left_inv := fun x ↦ congrArg (fun k ↦ k x) e.hom_inv_id
      right_inv := fun x ↦ congrArg (fun k ↦ k x) e.inv_hom_id }
  suffices hp : ∀ b : Ideal.associatedGraded (i.ker.ideal U), P (E.symm b) by
    simpa using hp (E a)
  intro b
  induction b using DirectSum.induction_on with
  | zero => simpa using hzero
  | add b c hb hc => simpa using hadd (E.symm b) (E.symm c) hb hc
  | of n x =>
    induction x using Submodule.Quotient.induction_on with
    | _ x =>
      obtain ⟨q, hq⟩ := A.powerIdentification n
      have hx : (x : Γ(X, U.1)) ∈ Set.range ((i.ker ^ n).toModulesι.app U.1) := by
        rw [(i.ker ^ n).range_toModulesι_app U]
        exact x.property
      obtain ⟨s, hs⟩ := hx
      let t := q.inv.app U.1 s
      have ht : (powerInclusion i n).app U.1 t = (x : Γ(X, U.1)) := by
        rw [← hq]
        change ((q.inv ≫ q.hom ≫ (i.ker ^ n).toModulesι).app U.1) s = _
        simpa using hs
      obtain ⟨hx', hclass⟩ := he n t
      have hclass' : E (homogeneousClass i A.algebra A.inclusion n U.1 t) =
          DirectSum.of (Ideal.associatedGradedPiece (i.ker.ideal U)) n
            (Submodule.Quotient.mk x) := by
        rw [show E _ = _ from hclass]
        congr 2
        exact Subtype.ext ht
      rw [← hclass', E.symm_apply_apply]
      exact hhom n t

end AlgebraicGeometry.ConormalGradedAlgebra
