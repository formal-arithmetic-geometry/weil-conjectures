module
public import WeilConjectures.AlgebraicGeometry.ConstantCompletionBasic
import WeilConjectures.AlgebraicGeometry.ConstantCompletionFiniteSystemProperties
/-! Kernel component of the completion projection formula.
The sectionwise quotient argument identifies the kernel of each completion projection
with the ideal generated by the coefficient sections.

## References

* Stacks Project, Tag 093M
-/
@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits Opposite
universe u
namespace CategoryTheory.ConstantCompletion
variable {C : Type u} [SmallCategory C]
@[instance_reducible]
private def sectionAlgebra (J : GrothendieckTopology C) (R : Type u)
    [CommRing R] (U : Cᵒᵖ) : Algebra R ((constant J R).obj.obj U) :=
  ((toSheafify J ((Functor.const Cᵒᵖ).obj (CommRingCat.of R))).app U).hom.toAlgebra

attribute [local instance] sectionAlgebra

@[instance_reducible]
private def quotientModule (J : GrothendieckTopology C) (A : Type u) [CommRing A]
    (I : Ideal A) (n : ℕ) (U : Cᵒᵖ) :
    Module (A ⧸ I ^ (n + 1)) (adicTerm J A (finiteSystemUnder J A I) n U) :=
  inferInstanceAs (Module (A ⧸ I ^ (n + 1))
    ((constant J (A ⧸ I ^ (n + 1))).obj.obj U))

attribute [local instance] quotientModule

private def projectionCone (J : GrothendieckTopology C) (A : Type u) [CommRing A]
    (I : Ideal A) : Cone (finiteSystemUnder J A I) where
  pt := Under.mk (coefficientMap J A I)
  π :=
    { app := fun n ↦ Under.homMk (projection J A I n.unop)
        (limit.lift_π (quotientCone J A I) n)
      naturality := by
        intro m n f
        apply Under.UnderMorphism.ext
        exact (limit.w (finiteSystem J A I) f).symm }

private def projectionConeIsLimit (J : GrothendieckTopology C) (A : Type u) [CommRing A]
    (I : Ideal A) : IsLimit (projectionCone J A I) :=
  isLimitOfReflects (Under.forget _) (limit.isLimit (finiteSystem J A I))

/-- The kernel of each completion projection on sections is the ideal generated by the
coefficient sections of `I^(n+1)` (Stacks, Tag 093M). -/
theorem flat_and_quotients_projection_kernel (J : GrothendieckTopology C) (A : Type u)
    [CommRing A] [IsNoetherianRing A] (I : Ideal A) :
    ∀ (n : ℕ) (U : C),
      RingHom.ker ((projection J A I n).hom.app (op U)).hom =
        Ideal.span (Set.range (fun a : ↥(I ^ (n + 1)) ↦
          (algebraSection (coefficientMap J A I) a).val (op U))) := by
  let S := finiteSystemUnder J A I
  let : HasLimit S := HasLimit.mk ⟨projectionCone J A I, projectionConeIsLimit J A I⟩
  let : ∀ (n : ℕ) (U : Cᵒᵖ), Module (A ⧸ I ^ (n + 1)) (adicTerm J A S n U) :=
    finiteSystemModule J A I
  have hprops := finiteSystem_properties J A I
  let : ∀ (n : ℕ) (U : Cᵒᵖ), IsScalarTower A (A ⧸ I ^ (n + 1))
      (adicTerm J A S n U) := hprops.1
  obtain ⟨q, hq, _, _⟩ := (sectionwise_adic_algebra_limit.{u, u} J A I S
    hprops.2.1 hprops.2.2.1 hprops.2.2.2).2.2.2.2.2
  have hk (n : ℕ) (U : Cᵒᵖ) (b : adicLimit J A S U) :
      adicProjection J A S n U b = 0 ↔
        b ∈ (I ^ (n + 1)).map (algebraMap A (adicLimit J A S U)) := by
    rw [← hq, ← (q n U).map_zero, (q n U).injective.eq_iff]
    exact Ideal.Quotient.eq_zero_iff_mem
  let e : Under.mk (coefficientMap J A I) ≅ limit S :=
    IsLimit.conePointUniqueUpToIso (projectionConeIsLimit J A I) (limit.isLimit _)
  intro n U
  let B := (adicAlgebraSections J A (op U)).obj (Under.mk (coefficientMap J A I))
  let eU : B ≃ₐ[A] adicLimit J A S (op U) :=
    ((forget₂ (CommAlgCat A) (AlgCat A)).mapIso
      ((adicAlgebraSections J A (op U)).mapIso e)).toAlgEquiv
  have hp (b : B) :
      adicProjection J A S n (op U) (eU b) = (projection J A I n).hom.app (op U) b := by
    have h := IsLimit.conePointUniqueUpToIso_hom_comp
      (projectionConeIsLimit J A I) (limit.isLimit S) (op n)
    exact congrArg (fun f ↦ f.right.hom.app (op U) b) h
  have hm : (I ^ (n + 1)).map (algebraMap A (adicLimit J A S (op U))) =
      ((I ^ (n + 1)).map (algebraMap A B)).map eU.toRingHom := by
    rw [Ideal.map_map]
    congr 1
    exact (RingHom.ext fun a ↦ eU.commutes a).symm
  have hs : (I ^ (n + 1)).map (algebraMap A B) =
      Ideal.span (Set.range (fun a : ↥(I ^ (n + 1)) ↦
        (algebraSection (coefficientMap J A I) a).val (op U))) := by
    change Ideal.span (algebraMap A B '' (↑(I ^ (n + 1)) : Set A)) = _
    congr 1
    ext x
    constructor
    · rintro ⟨a, ha, rfl⟩
      exact ⟨⟨a, ha⟩, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨a, a.property, rfl⟩
  let p : B →+* adicTerm J A S n (op U) :=
    ((projection J A I n).hom.app (op U)).hom
  have hB : RingHom.ker p = (I ^ (n + 1)).map (algebraMap A B) := by
    ext b
    change p b = 0 ↔ _
    change (projection J A I n).hom.app (op U) b = 0 ↔ _
    rw [← hp b, hk, hm]
    change b ∈ (((I ^ (n + 1)).map (algebraMap A B)).map eU.toRingHom).comap
      eU.toRingHom ↔ _
    rw [Ideal.comap_map_of_bijective eU.toRingHom
      (show Function.Bijective eU.toRingHom from eU.bijective)]
  exact hB.trans hs
end CategoryTheory.ConstantCompletion
