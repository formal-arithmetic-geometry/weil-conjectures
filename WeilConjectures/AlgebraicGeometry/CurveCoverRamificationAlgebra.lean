module

public import Mathlib.RingTheory.RamificationInertia.Basic
public import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-!
# Ramification indices as valuations of a uniformizer

Commutative algebra for the covering step of blueprint `lemma-tangent-cones-on-cover`.

* `IsDiscreteValuationRing.exists_eq_unit_mul_pow_length`: if `φ : R → S` is a local
  homomorphism from a local ring with principal maximal ideal `(u)` to a discrete valuation
  ring such that `S / 𝔪_R S` has finite nonzero length `e`, then `φ u = w ξ ^ e` with `w` a
  unit and `ξ` a uniformizer.
* `Ideal.ramificationIdx_eq_length_of_isLocalization`: the ramification index `e(q | R)` may be
  computed in any localization of `S` at `q`.
* `Ideal.exists_not_dvd_ramificationIdx`: in a finite flat extension of a domain whose rank is
  prime to `ℓ`, over every prime some prime has ramification index prime to `ℓ`.
-/

@[expose] public section

open IsLocalRing

namespace IsDiscreteValuationRing

/-- Let `φ : R → S` be a local homomorphism from a local ring `R` whose maximal ideal is
generated by `u` to a discrete valuation ring `S`, such that `S / 𝔪_R S` has finite nonzero
length. Then `φ u = w * ξ ^ e` for a unit `w` and a uniformizer `ξ` of `S`, where `e ≠ 0` is the
length of `S / 𝔪_R S` (the ramification index; blueprint `lemma-tangent-cones-on-cover`). -/
theorem exists_eq_unit_mul_pow_length {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S]
    [IsDomain S] [IsDiscreteValuationRing S] (φ : R →+* S) [IsLocalHom φ] {u : R}
    (hu : Ideal.span {u} = maximalIdeal R)
    (he : (Module.length S (S ⧸ (maximalIdeal R).map φ)).toNat ≠ 0) :
    ∃ w ξ : S, IsUnit w ∧ Ideal.span {ξ} = maximalIdeal S ∧
      φ u = w * ξ ^ (Module.length S (S ⧸ (maximalIdeal R).map φ)).toNat := by
  obtain ⟨ϖ, hϖ⟩ := exists_irreducible S
  have hu0 : φ u ≠ 0 := by
    intro h0
    refine he (ENat.toNat_eq_zero.mpr (Or.inr ?_))
    rw [← hu, Ideal.map_span, Set.image_singleton, h0, Ideal.span_singleton_eq_bot.mpr rfl,
      (Submodule.quotEquivOfEqBot _ rfl).length_eq]
    by_contra hfin
    have : IsArtinianRing S :=
      (isFiniteLength_iff_isNoetherian_isArtinian.mp (Module.length_ne_top_iff.mp hfin)).2
    exact not_isField S (IsArtinianRing.isField_of_isDomain S)
  obtain ⟨n, w, hw⟩ := eq_unit_mul_pow_irreducible hu0 hϖ
  have hmap : (maximalIdeal R).map φ = maximalIdeal S ^ n := by
    rw [← hu, Ideal.map_span, Set.image_singleton, hw, Ideal.span_singleton_mul_left_unit w.isUnit,
      hϖ.maximalIdeal_eq, Ideal.span_singleton_pow]
  refine ⟨w, ϖ, w.isUnit, hϖ.maximalIdeal_eq.symm, ?_⟩
  rw [hmap, length_quotient_pow_maximalIdeal, ENat.toNat_natCast, hw]

end IsDiscreteValuationRing

namespace Ideal

/-- The ramification index of a prime `q` of `S` over `R` is the length of `T / (q ∩ R) T` for
any localization `T` of `S` at `q`. -/
theorem ramificationIdx_eq_length_of_isLocalization {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (q : Ideal S) [q.IsPrime] (T : Type*) [CommRing T] [Algebra S T]
    [IsLocalization.AtPrime T q] [Algebra R T] [IsScalarTower R S T] :
    q.ramificationIdx R = (Module.length T (T ⧸ (q.under R).map (algebraMap R T))).toNat := by
  rw [ramificationIdx_def]
  let Sq := Localization.AtPrime q
  let e : Sq ≃ₐ[S] T := IsLocalization.algEquiv q.primeCompl Sq T
  let : Algebra Sq T := e.toRingHom.toAlgebra
  let e' : Sq ≃ₐ[Sq] T := AlgEquiv.ofRingEquiv (f := e.toRingEquiv) fun _ ↦ rfl
  have hI : (q.under R).map (algebraMap R T) = ((q.under R).map (algebraMap R Sq)).map e' := by
    have h : (e' : Sq →+* T).comp (algebraMap R Sq) = algebraMap R T := by
      ext x
      simp [e', IsScalarTower.algebraMap_apply R S Sq, IsScalarTower.algebraMap_apply R S T, e]
    rw [← h, ← Ideal.map_map]
    rfl
  rw [(Ideal.quotientEquivAlg _ _ e' hI).toLinearEquiv.length_eq,
    Module.length_eq_of_surjective e'.surjective]

/-- In a finite flat extension `S` of a domain `R` whose rank is prime to `ℓ`, over every prime
`p` of `R` lies a prime `q` of `S` with ramification index prime to `ℓ` (blueprint
`lemma-tangent-cones-on-cover`): the ramification indices times the inertia degrees sum to the
rank. -/
theorem exists_not_dvd_ramificationIdx {R S : Type*} [CommRing R] [IsDomain R] [CommRing S]
    [Algebra R S] [Module.Finite R S] [Module.Flat R S] (p : Ideal R) [p.IsPrime] {ℓ : ℕ}
    (hℓ : ¬ ℓ ∣ Module.finrank R S) :
    ∃ q ∈ p.primesOver S, ¬ ℓ ∣ q.ramificationIdx R := by
  classical
  have : Finite (p.primesOver S) := (Algebra.QuasiFinite.finite_primesOver p).to_subtype
  let := Fintype.ofFinite (p.primesOver S)
  rw [← sum_ramification_inertia_eq_finrank p S] at hℓ
  by_contra! h
  exact hℓ (Finset.dvd_sum fun q _ ↦ (h q.1 q.2).mul_right _)

end Ideal
