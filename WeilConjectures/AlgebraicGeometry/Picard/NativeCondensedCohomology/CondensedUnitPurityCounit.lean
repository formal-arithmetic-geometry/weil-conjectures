/-! # The Frobenius counit equation for the specified unit-purity comparison

Source: smooth purity at the coefficient unit and the geometric-Frobenius purity
and counit squares. (blueprint: lem-sf-condensed-unit-purity-counit).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
attribute [local instance 1100] CategoryTheory.instOverClass
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ProEtale
open AlgebraicGeometry.ProEtale.CondensedRing
namespace WeilConjectures.NativeCondensedCohomology

variable (k₀ : Type u) [Field k₀] [Finite k₀] (ell : ℕ) [Fact ell.Prime]
  [Fact (ringChar k₀ ≠ ell)]
  (X : Scheme.{u}) [X.Over (Spec (.of k₀))]
  [IsSeparated (X ↘ Spec (.of k₀))] [LocallyOfFiniteType (X ↘ Spec (.of k₀))]
  [QuasiCompact (X ↘ Spec (.of k₀))]

local instance counitStructureIsOver : (X ↘ Spec (.of k₀)).IsOver (Spec (.of k₀)) :=
  ⟨Category.comp_id _⟩

variable (c : Compactification (fiberMap k₀ (X ↘ Spec (.of k₀))).hom.left)
  (H : CompactSupportComposition.CoherentData (Profinite.padicAlgClRingObj ell)
    (AlgebraicClosure k₀))
  (E : ExceptionalUnit k₀ ell (X ↘ Spec (.of k₀)) c H)

/-- The specified unit-purity comparison satisfies the exceptional Frobenius counit square.

Source: thm-pur-weil-equivariance-of-purity-and-trace.proof.md, Steps 1--2,
specialized to the coefficient unit in sk-cor-sp-all-coefficients.proof.md.
(blueprint: lem-sf-condensed-unit-purity-counit).

Proof in words. Use the purity square for the uniquely normalized smooth family
and the supplied geometric right adjoint restricted by its Brown comparison.
Its source comparison is the structural pullback compositor, tensorator,
root-normalized Tate comparison p, and canonical shift comparison. The proper/open
exchange in the counit square is the support exchange specified by H: its open
factor is fixed by open_normalized, and its compactification factor is fixed on
every common dense refinement. Pasting the literal pullback identification with
the native exchange therefore gives H.exchange. Whisker the square with the
exact-derived pullback comparisons on both fibres. Evaluate at the coefficient
unit; monoidal unit coherence identifies the source-unit comparison with the
shifted single Tate datum. Finally use the counit equation of canonicalPurity
and cancel the sourceUnit coordinates. The resulting equality is the displayed
normalization for the fixed map condensedUnitPurityCarrierIso. This is an equality
of the specified maps, rather than a choice of a compatible Frobenius datum.
The zeroth power uses the pullback unit map, and the same equalities hold on an
empty scheme. There is no assertion about native encoding or cohomology. -/
theorem condensed_unit_purity_counit (d : ℕ)
    [SmoothOfRelativeDimension d (X ↘ Spec (.of k₀))]
    (p : PurityTransport.LinePullCoordinates ell .closure
      (X ↘ Spec (.of k₀)).geometricGaloisFrobenius.hom) :
    let e := condensedUnitPurityCarrierIso k₀ ell X c H E d
    let L := tateDerivedPair k₀ ell X p d
    (derivedAction k₀ ell (Spec (.of k₀))).map
        (E.adjunction.counit.app
          ⟨unitObject k₀ ell (Spec (.of k₀)), E.unit_mem⟩).hom ≫
          (unitTheta k₀ ell (Spec (.of k₀))).hom =
      (supportExchange k₀ ell (X ↘ Spec (.of k₀)) c H).hom.app
          (E.right.obj ⟨unitObject k₀ ell (Spec (.of k₀)), E.unit_mem⟩) ≫
        (support k₀ ell (X ↘ Spec (.of k₀)) c).map
          (((derivedAction k₀ ell X).mapIso e ≪≫ L.str ≪≫ e.symm).hom) ≫
          (E.adjunction.counit.app
            ⟨unitObject k₀ ell (Spec (.of k₀)), E.unit_mem⟩).hom := by
  sorry

end WeilConjectures.NativeCondensedCohomology
