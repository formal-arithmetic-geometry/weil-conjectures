/-!
# Normalized ordinary compact-support compositor

Source: latest blueprint,
part-duality-trace-formula/sec-lefschetz-verdier/
sec-trace-classes-and-the-lefschetz-verdier-formula/sec-additivity-of-trace-classes/
sk-i-additivity/sk-i-additivity.proof.md,
Filtered operations and The trace morphism on filtered complexes
(blueprint: lem-trf-filtered-operations-hom).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
attribute [-instance] WeilConjectures.IntegralHom.derivedCategory
attribute [local irreducible]
  AlgebraicGeometry.ProEtale.CondensedRing.derivedHom
  AlgebraicGeometry.ProEtale.CondensedRing.derivedTensor

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme

namespace WeilConjectures
variable {Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}}
  [MonObj Λ] [IsCommMonObj Λ]
open AlgebraicGeometry.ProEtale AlgebraicGeometry.ProEtale.CondensedRing

/-- The normalized ordinary compact-support compositor extracted from the published
coherence data. The data specify refinement, proper/open normalization,
units, associativity and exchange; this is not a choice of an arbitrary natural map.
Source: latest blueprint, filtered trace morphism; ordinary package clause 4
(blueprint: lem-trf-filtered-operations-hom). -/
def traceSupportComp {k : Type u} [Field k]
    (h : CompactSupportComposition.CoherentData Λ k) {X Y Z : SepFinType k}
    (f : X ⟶ Y) (g : Y ⟶ Z) (c : Compactification f.hom.left)
    (d : Compactification g.hom.left) (e : Compactification (f.hom.left ≫ g.hom.left)) :
    (localizingClosureProEtale Λ X.obj.left).ι ⋙
        (rightDerivedLowerShriekOfCompactification Λ c ⋙
          rightDerivedLowerShriekOfCompactification Λ d) ≅
      (localizingClosureProEtale Λ X.obj.left).ι ⋙
        rightDerivedLowerShriekOfCompactification Λ e :=
  h.comp f g c d e

end WeilConjectures
