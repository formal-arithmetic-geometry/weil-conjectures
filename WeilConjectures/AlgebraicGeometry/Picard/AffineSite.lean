module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.OneHypercoverDense
public import WeilConjectures.AlgebraicGeometry.Picard.AffineRestriction
public import WeilConjectures.Mathlib.AlgebraicGeometry.Sites.Fpqc

/-!
# The affine fppf site

Let `S` be a scheme. The site `Scheme.AffineOver S` of affine `S`-schemes carries the topology
`Scheme.AffineOver.topology S` induced by the big fppf site of `S`. We show that this topology is
the one generated by the families of affine `S`-schemes whose underlying morphisms of schemes form
an fppf covering, and that restriction along the inclusion is an equivalence of categories of
sheaves compatible with sheafification (Stacks Project, Topologies, Lemma 34.7.11, Tag 021V).

## Main statements

- `AlgebraicGeometry.Scheme.AffineOver.topology_eq_toGrothendieck_comap`: the induced topology on
  affine `S`-schemes is generated by the fppf coverings between affine `S`-schemes.
- `AlgebraicGeometry.Scheme.AffineOver.isEquivalence_sheafPushforwardContinuous`: restriction of
  fppf sheaves to affine `S`-schemes is an equivalence, for every complete enough category of
  coefficients, e.g. sets and abelian groups.
- `AlgebraicGeometry.Scheme.AffineOver.sheafificationRestrictionIso`: restricting the fppf
  sheafification of a presheaf to affine `S`-schemes is sheafifying its restriction.

## References

* Stacks Project, Topologies, Lemma 34.7.11 (Tag 021V)
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme.AffineOver

variable (S : Scheme.{u})

/-- The topology on affine `S`-schemes induced by the big fppf site of `S` is generated by the
families of affine `S`-schemes whose underlying morphisms of schemes form an fppf covering.

A covering in the induced topology of an affine `X` is refined by a finite fppf covering family
of affine schemes (`exists_finite_affine_of_mem_fppfTopology`), which lies in the subsite. -/
theorem topology_eq_toGrothendieck_comap :
    topology S = (fppfPrecoverage.comap (ι S ⋙ Over.forget S)).toGrothendieck := by
  have hover := over_toGrothendieck_eq_toGrothendieck_comap_forget fppfPrecoverage S
  refine le_antisymm (fun X T hT ↦ ?_) ?_
  · rw [Functor.mem_inducedTopology_iff_of_isCoverDense, GrothendieckTopology.mem_over_iff] at hT
    have : IsAffine ((ι S).obj X).left := X.property
    obtain ⟨n, V, g, hV, hg, hmem⟩ := exists_finite_affine_of_mem_fppfTopology hT
    let W (j : Fin n) : AffineOver S := ⟨Over.mk (g j ≫ X.obj.hom), hV j⟩
    let a (j : Fin n) : W j ⟶ X := ObjectProperty.homMk (Over.homMk (g j))
    refine GrothendieckTopology.superset_covering _ (S := Sieve.ofArrows W a) ?_
      (Precoverage.generate_mem_toGrothendieck ?_)
    · rw [Sieve.ofArrows, Sieve.generate_le_iff]
      rintro _ _ ⟨j⟩
      obtain ⟨Z, t, h, ht, hfac⟩ := (Sieve.overEquiv_iff _ _).1 (hg j)
      have : a j = (ι S).preimage (X := W j) h ≫ t :=
        (ι S).map_injective (by rw [Functor.map_comp, Functor.map_preimage]; exact hfac)
      rw [this]
      exact T.downward_closed ht _
    · rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      exact hmem
  · rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
    intro X R hR
    rw [Precoverage.comap_comp, Precoverage.mem_comap_iff] at hR
    rw [GrothendieckTopology.mem_toPrecoverage_iff,
      Functor.mem_inducedTopology_iff_of_isCoverDense, ← Sieve.generate_map_eq_functorPushforward,
      hover]
    exact Precoverage.generate_mem_toGrothendieck hR

/-- Every `S`-scheme has a `1`-hypercover by affine `S`-schemes: its affine open cover. -/
instance isOneHypercoverDense :
    Functor.IsOneHypercoverDense.{u} (ι S) (topology S) (fppfTopology.over S) :=
  Functor.IsOneHypercoverDense.of_hasPullbacks fun T ↦ by
    refine ⟨T.left.affineCover.I₀,
      fun i ↦ ⟨Over.mk (T.left.affineCover.f i ≫ T.hom), inferInstanceAs (IsAffine (Spec _))⟩,
      fun i ↦ Over.homMk (T.left.affineCover.f i), ?_⟩
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
    exact zariskiTopology_le_fppfTopology _ T.left.affineCover.mem_grothendieckTopology

/-- Restriction of fppf sheaves on `S`-schemes to affine `S`-schemes is an equivalence of
categories, for every category of coefficients with `u`-small limits, e.g. sets and abelian
groups. -/
instance isEquivalence_sheafPushforwardContinuous (A : Type*) [Category* A]
    [HasLimitsOfSize.{u, u} A] :
    ((ι S).sheafPushforwardContinuous A (topology S) (fppfTopology.over S)).IsEquivalence :=
  Functor.isEquivalence_of_isOneHypercoverDense.{u} _ _ _ A

/-- Restricting the fppf sheafification of a presheaf on `S`-schemes to affine `S`-schemes is
naturally isomorphic to the sheafification of its restriction on the affine fppf site. -/
noncomputable def sheafificationRestrictionIso (A : Type*) [Category* A]
    [HasLimitsOfSize.{u, u} A] [HasWeakSheafify (topology S) A]
    [HasWeakSheafify (fppfTopology.over S) A] :
    sheafification (fppfTopology.over S) A ⋙ (Functor.whiskeringLeft _ _ A).obj (ι S).op ≅
      (Functor.whiskeringLeft _ _ A).obj (ι S).op ⋙ sheafification (topology S) A :=
  (Functor.isoWhiskerRight (Functor.IsDenseSubsite.sheafEquivSheafificationCompatibility
    (topology S) (fppfTopology.over S) (ι S) A) (sheafToPresheaf (topology S) A)).symm

end AlgebraicGeometry.Scheme.AffineOver
