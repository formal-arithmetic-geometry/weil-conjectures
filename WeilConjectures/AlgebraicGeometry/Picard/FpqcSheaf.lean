module

public import WeilConjectures.AlgebraicGeometry.Curve.RiemannRoch
public import WeilConjectures.AlgebraicGeometry.Picard.NormalizedFpqc
public import WeilConjectures.AlgebraicGeometry.Picard.RationalPoint
public import WeilConjectures.CategoryTheory.Sites.SingletonSheaf
public import Mathlib.CategoryTheory.Sites.SubcanonicalOver

/-!
# The Picard functor of a curve satisfies the sheaf condition for fpqc morphisms

Let `X` be a smooth proper geometrically integral curve over a field `k`. The relative Picard
functor `Pic_{X/k}` is defined as an fppf sheaf. We show that it also satisfies the sheaf condition
for every single faithfully flat quasi-compact morphism `π : T' ⟶ T` of `k`-schemes
(`AlgebraicGeometry.isSheafFor_singleton_picardFunctor`), for instance for the base change
`T_K ⟶ T` of a field extension `K / k`.

If `X` has a `k`-rational point `σ`, then `Pic_{X/k}` is the `σ`-normalized Picard functor, which
satisfies the sheaf condition for such morphisms by fpqc descent of invertible modules
(`AlgebraicGeometry.isSheafFor_singleton_picardFunctorNormalized`). In general `X` acquires a
rational point over the residue field `K` of a closed point, which is finite over `k`, so that
`Spec K ⟶ Spec k` is an fppf covering; the sheaf condition for `π` is local in the fppf topology
(`CategoryTheory.Presieve.isSheafFor_singleton_of_isPullback`).
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

open Scheme

/-- The sieve generated by a single flat surjective morphism locally of finite presentation is a
covering sieve of the fppf topology on `Over S`. -/
lemma generate_singleton_mem_fppfTopology_over {S : Scheme.{u}} {T T' : Over S} (c : T' ⟶ T)
    [Flat c.left] [Surjective c.left] [LocallyOfFinitePresentation c.left] :
    Sieve.generate (.singleton c) ∈ fppfTopology.over S T := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate]
  refine GrothendieckTopology.superset_covering _ ?_
    (Precoverage.generate_mem_toGrothendieck c.left.singleton_mem_fppfPrecoverage)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨⟩
  apply Sieve.le_generate
  exact ⟨T', c, 𝟙 _, Presieve.singleton.mk, by simp⟩

/-- The sieve generated by a single flat surjective quasi-compact morphism is a covering sieve of
the fpqc topology on `Over S`. -/
lemma generate_singleton_mem_fpqcTopology_over {S : Scheme.{u}} {T T' : Over S} (c : T' ⟶ T)
    [Flat c.left] [Surjective c.left] [QuasiCompact c.left] :
    Sieve.generate (.singleton c) ∈ fpqcTopology.over S T := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate]
  refine GrothendieckTopology.superset_covering _ ?_
    (Precoverage.generate_mem_toGrothendieck c.left.singleton_mem_fpqcPrecoverage)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨⟩
  apply Sieve.le_generate
  exact ⟨T', c, 𝟙 _, Presieve.singleton.mk, by simp⟩

/-- The functor of points of a scheme over `S` satisfies the sheaf condition for a single flat
surjective quasi-compact morphism, the fpqc topology being subcanonical. -/
lemma isSheafFor_singleton_yoneda {S : Scheme.{u}} (J : Over S) {T T' : Over S} (c : T' ⟶ T)
    [Flat c.left] [Surjective c.left] [QuasiCompact c.left] :
    Presieve.IsSheafFor (yoneda.obj J) (.singleton c) := by
  rw [Presieve.isSheafFor_iff_generate]
  exact GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (J := fpqcTopology.over S)
    (yoneda.obj J) _ (generate_singleton_mem_fpqcTopology_over c)

/-- An fppf sheaf on `Over S` satisfies the sheaf condition for a single flat surjective
morphism locally of finite presentation. -/
lemma isSheafFor_singleton_of_fppf {S : Scheme.{u}}
    (P : Sheaf (fppfTopology.over S) (Type (u + 1))) {T T' : Over S} (c : T' ⟶ T)
    [Flat c.left] [Surjective c.left] [LocallyOfFinitePresentation c.left] :
    Presieve.IsSheafFor P.obj (.singleton c) := by
  rw [Presieve.isSheafFor_iff_generate]
  exact (isSheaf_iff_isSheaf_of_type _ _).1 P.property _
    (generate_singleton_mem_fppfTopology_over c)


variable {k : Type u} [Field k] {X : Scheme.{u}} [X.Over (Spec (.of k))]

/-- **The Picard functor of a curve with a rational point satisfies the sheaf condition for a
faithfully flat quasi-compact morphism.** It is the `σ`-normalized Picard functor, to which fpqc
descent of invertible modules applies. -/
theorem isSheafFor_singleton_picardFunctor_of_section
    [SmoothOfRelativeDimension 1 (X ↘ Spec (.of k))] [IsProper (X ↘ Spec (.of k))]
    [GeometricallyIntegral (X ↘ Spec (.of k))] (σ : Spec (.of k) ⟶ X)
    (hσ : σ ≫ X ↘ Spec (.of k) = 𝟙 (Spec (.of k))) {T T' : Over (Spec (.of k))} (π : T' ⟶ T)
    [Flat π.left] [Surjective π.left] [QuasiCompact π.left] :
    Presieve.IsSheafFor (picardFunctor (X ↘ Spec (.of k))).obj (.singleton π) := by
  obtain ⟨e⟩ := nonempty_picardFunctorNormalized_iso_picardFunctor σ hσ
  exact Presieve.isSheafFor_iso e (isSheafFor_singleton_picardFunctorNormalized _ σ hσ
    (isIso_pushforwardUnitMap_pullback_snd_of_geometricallyIntegral (k := k) (X := X)) π)


omit [X.Over (Spec (.of k))] in
/-- A nonempty quasi-compact scheme locally of finite type over a field `k` has a point with
values in a finite extension of `k`: the residue field of a closed point. -/
theorem exists_finiteDimensional_point (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    [CompactSpace X] [Nonempty X] :
    ∃ (K : Type u) (_ : Field K) (_ : Algebra k K), FiniteDimensional k K ∧
      ∃ σ : Spec (.of K) ⟶ X, σ ≫ f = Spec.map (CommRingCat.ofHom (algebraMap k K)) := by
  obtain ⟨x₀⟩ := ‹Nonempty X›
  obtain ⟨x, -, hx⟩ :=
    isClosed_univ.exists_closed_singleton (⟨x₀, trivial⟩ : (Set.univ : Set X).Nonempty)
  let φ : CommRingCat.of k ⟶ X.residueField x := Spec.preimage (X.fromSpecResidueField x ≫ f)
  let : Algebra k (X.residueField x) := φ.hom.toAlgebra
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap k (X.residueField x))) =
      X.fromSpecResidueField x ≫ f :=
    Spec.map_preimage _
  have : JacobsonSpace (Spec (.of k)) := inferInstance
  have := isClosed_singleton_iff_isClosedImmersion.mp hx
  have : IsFinite (X.fromSpecResidueField x ≫ f) :=
    (isFinite_iff_locallyOfFiniteType_of_jacobsonSpace).mpr inferInstance
  rw [← hφ, IsFinite.SpecMap_iff] at this
  exact ⟨X.residueField x, inferInstance, inferInstance, this, X.fromSpecResidueField x, hφ.symm⟩


/-- **The Picard functor of a curve satisfies the sheaf condition for a faithfully flat
quasi-compact morphism.** Let `X` be a smooth proper geometrically integral curve over a field
`k` and let `π : T' ⟶ T` be a morphism of `k`-schemes which is flat, surjective and
quasi-compact. Then `Pic_{X/k}` satisfies the sheaf condition for `π`.

Over the residue field `K` of a closed point of `X`, finite over `k`, the curve acquires a
rational point, so that the restriction of `Pic_{X/k}` to `K`-schemes satisfies the sheaf condition
for such morphisms (`AlgebraicGeometry.isSheafFor_singleton_picardFunctor_of_section`); since
`Spec K ⟶ Spec k` is an fppf covering, this descends to `k`
(`CategoryTheory.Presieve.isSheafFor_singleton_of_isPullback`). -/
theorem isSheafFor_singleton_picardFunctor
    [SmoothOfRelativeDimension 1 (X ↘ Spec (.of k))] [IsProper (X ↘ Spec (.of k))]
    [GeometricallyIntegral (X ↘ Spec (.of k))] {T T' : Over (Spec (.of k))} (π : T' ⟶ T)
    [Flat π.left] [Surjective π.left] [QuasiCompact π.left] :
    Presieve.IsSheafFor (picardFunctor (X ↘ Spec (.of k))).obj (.singleton π) := by
  set P := (picardFunctor (X ↘ Spec (.of k)))
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of k))
  have : IsIntegral X := GeometricallyIntegral.isIntegral_of_subsingleton (X ↘ Spec (.of k))
  obtain ⟨K, _, _, _, σ, hσ⟩ := exists_finiteDimensional_point (X ↘ Spec (.of k))
  let c₀ := Spec.map (CommRingCat.ofHom (algebraMap k K))
  have : Flat c₀ := Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
  have : Surjective c₀ := ⟨fun _ ↦ ⟨default, Subsingleton.elim _ _⟩⟩
  have : LocallyOfFinitePresentation c₀ := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)]
    exact RingHom.FinitePresentation.of_finiteType.mp
      (RingHom.finite_algebraMap.mpr inferInstance).finiteType
  -- the base change `X_K` has a rational point
  let X' := pullback (X ↘ Spec (.of k)) c₀
  let : X'.Over (Spec (.of K)) := ⟨pullback.snd _ _⟩
  have : SmoothOfRelativeDimension 1 (X' ↘ Spec (.of K)) := smoothOfRelativeDimension_baseChange K 1
  have : IsProper (X' ↘ Spec (.of K)) := isProper_baseChange K
  have : GeometricallyIntegral (X' ↘ Spec (.of K)) :=
    inferInstanceAs (GeometricallyIntegral (pullback.snd _ _))
  let σ' : Spec (.of K) ⟶ X' := pullback.lift σ (𝟙 _) (by rw [hσ, Category.id_comp])
  have hσ' : σ' ≫ X' ↘ Spec (.of K) = 𝟙 _ := pullback.lift_snd _ _ _
  obtain ⟨eP⟩ := nonempty_picardFunctor_iso_of_isPullback
    (IsPullback.of_hasPullback (X ↘ Spec (.of k)) c₀)
  have hK {A B : Over (Spec (.of K))} (g : A ⟶ B) [Flat g.left] [Surjective g.left]
      [QuasiCompact g.left] : Presieve.IsSheafFor P.obj (.singleton ((Over.map c₀).map g)) :=
    Presieve.isSheafFor_singleton_overMap c₀ g
      (Presieve.isSheafFor_iso eP.symm (isSheafFor_singleton_picardFunctor_of_section σ' hσ' g))
  -- the fppf covering `T_K ⟶ T` and the base changes of `π`
  let B : Over (Spec (.of K)) := Over.mk (pullback.snd T.hom c₀)
  let c : (Over.map c₀).obj B ⟶ T := Over.homMk (pullback.fst T.hom c₀) pullback.condition
  let A₁ : Over (Spec (.of K)) := Over.mk (pullback.snd π.left c.left ≫ B.hom)
  let π₁ : A₁ ⟶ B := Over.homMk (pullback.snd π.left c.left)
  let c' : (Over.map c₀).obj A₁ ⟶ T' := Over.homMk (pullback.fst π.left c.left) (by
    rw [← Over.w π, pullback.condition_assoc]
    simp [c, A₁, B, pullback.condition (f := T.hom) (g := c₀)])
  let A₂ : Over (Spec (.of K)) := Over.mk (pullback.fst c.left c.left ≫ B.hom)
  let d₁ : (Over.map c₀).obj A₂ ⟶ (Over.map c₀).obj B := Over.homMk (pullback.fst c.left c.left)
  let d₂ : (Over.map c₀).obj A₂ ⟶ (Over.map c₀).obj B :=
    Over.homMk (pullback.snd c.left c.left) (by
      have h1 : pullback.fst c.left c.left ≫ pullback.fst T.hom c₀ =
          pullback.snd c.left c.left ≫ pullback.fst T.hom c₀ := pullback.condition
      simp only [A₂, B, Over.map_obj_hom, Over.mk_hom, Category.assoc,
        ← pullback.condition (f := T.hom) (g := c₀), reassoc_of% h1])
  let A₂' : Over (Spec (.of K)) := Over.mk (pullback.snd π.left (d₁ ≫ c).left ≫ A₂.hom)
  let π₂ : A₂' ⟶ A₂ := Over.homMk (pullback.snd π.left (d₁ ≫ c).left)
  let e : (Over.map c₀).obj A₂' ⟶ T' := Over.homMk (pullback.fst π.left (d₁ ≫ c).left) (by
    rw [← Over.w π, pullback.condition_assoc]
    simp [c, d₁, A₂', A₂, B, pullback.condition (f := T.hom) (g := c₀)])
  have h₁ : IsPullback c' ((Over.map c₀).map π₁) π c :=
    IsPullback.of_map_of_faithful (Over.forget _) (IsPullback.of_hasPullback π.left c.left)
  have hd : IsPullback d₁ d₂ c c :=
    IsPullback.of_map_of_faithful (Over.forget _) (IsPullback.of_hasPullback c.left c.left)
  have h₂ : IsPullback e ((Over.map c₀).map π₂) π (d₁ ≫ c) :=
    IsPullback.of_map_of_faithful (Over.forget _)
      (IsPullback.of_hasPullback π.left (d₁ ≫ c).left)
  have : Flat c.left := inferInstanceAs (Flat (pullback.fst _ _))
  have : Surjective c.left := inferInstanceAs (Surjective (pullback.fst _ _))
  have : LocallyOfFinitePresentation c.left :=
    inferInstanceAs (LocallyOfFinitePresentation (pullback.fst _ _))
  have : Flat c'.left := inferInstanceAs (Flat (pullback.fst _ _))
  have : Surjective c'.left := inferInstanceAs (Surjective (pullback.fst _ _))
  have : LocallyOfFinitePresentation c'.left :=
    inferInstanceAs (LocallyOfFinitePresentation (pullback.fst _ _))
  have : Flat π₁.left := inferInstanceAs (Flat (pullback.snd _ _))
  have : Surjective π₁.left := inferInstanceAs (Surjective (pullback.snd _ _))
  have : QuasiCompact π₁.left := inferInstanceAs (QuasiCompact (pullback.snd _ _))
  have : Flat π₂.left := inferInstanceAs (Flat (pullback.snd _ _))
  have : Surjective π₂.left := inferInstanceAs (Surjective (pullback.snd _ _))
  have : QuasiCompact π₂.left := inferInstanceAs (QuasiCompact (pullback.snd _ _))
  exact Presieve.isSheafFor_singleton_of_isPullback π c c' _ h₁ d₁ d₂ hd e _ h₂
    (isSheafFor_singleton_of_fppf P c) (isSheafFor_singleton_of_fppf P c') (hK π₁) (hK π₂)

end AlgebraicGeometry
