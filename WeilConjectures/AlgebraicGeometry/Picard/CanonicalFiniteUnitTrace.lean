/-! # Canonical coefficient-unit smooth trace

Source: latest blueprint, sec-poincare-duality/sk-thm-frobenius/
prop-weil-operations.proof.md, sentence 4, together with the normalized smooth trace
and finite-reduction clauses (blueprint: lem-pur-canonical-finite-unit-trace).

Normalization applies to every smooth geometric datum. The additional finite-field model
is used only for the unit Weil trace square. Finite reduction compares the canonical
condensed unit traces for the same geometric datum and the actual quotient coefficient map.
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open AlgebraicGeometry AlgebraicGeometry.Scheme AlgebraicGeometry.Etale
open AlgebraicGeometry.ProEtale.CondensedRing
open AlgebraicGeometry.ProEtale.PurityTransport
open WeilConjectures.PurityWeil.Condensed
open scoped CategoryTheory.Obj

/-- The existing finite coefficient quotient at positive level n+1, presented in the
admissible coefficient index. The annihilator is the published prime-power annihilator;
this construction adds no choice of orientation or trace.
Source: finite-coefficient convention and coefficientFiniteTwist_annihilator
(blueprint: lem-pur-canonical-finite-unit-trace). -/
def unitTraceFiniteCoefficient (ell : ℕ) [Fact ell.Prime]
    (E : PadicAlgCl.FiniteIntermediateField ell) (n : ℕ) : Coefficient ell :=
  .finite (.of (Padic.coefficientExtensionRing ell E.1 (n + 1)))
    (Padic.finite_coefficientExtensionRing ell E.1 (n + 1) (Nat.succ_le_succ (Nat.zero_le n)))
    n (by simpa only [Nat.cast_pow] using
      AlgebraicGeometry.ProEtale.coefficientFiniteTwist_annihilator ell E.1 n)

/-- The actual quotient A_{E,n+1} to A_{E,m+1}, induced by the identity on O_E,
as a map of the coefficient presentations above. It includes m = n.
Source: thm-pur-finite-reduction-of-purity, coefficient quotient map
(blueprint: lem-pur-canonical-finite-unit-trace). -/
def unitTraceFiniteReductionMap (ell : ℕ) [Fact ell.Prime]
    (E : PadicAlgCl.FiniteIntermediateField ell) (n m : ℕ) (h : m ≤ n) :
    (unitTraceFiniteCoefficient ell E n).bundled.{u} ell ⟶
      (unitTraceFiniteCoefficient ell E m).bundled ell :=
  letI : TopologicalSpace (Padic.coefficientExtensionRing ell E.1 (n + 1)) := ⊥
  letI : TopologicalSpace (Padic.coefficientExtensionRing ell E.1 (m + 1)) := ⊥
  letI : DiscreteTopology (Padic.coefficientExtensionRing ell E.1 (n + 1)) :=
    discreteTopology_bot _
  letI : DiscreteTopology (Padic.coefficientExtensionRing ell E.1 (m + 1)) :=
    discreteTopology_bot _
  let q : Padic.coefficientExtensionRing ell E.1 (n + 1) →+*
      Padic.coefficientExtensionRing ell E.1 (m + 1) :=
    Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h))
  scalarSixContinuousMap q (continuous_of_discreteTopology (f := q))

/-- Reduction of the canonical condensed unit trace for this very smooth datum `s`.
Positive levels are indexed n+1 and m+1, so m <= n is precisely 1 <= m+1 <= n+1.
The line arrow is the normalized scalar/pullback/Tate comparison conjugated by the
source-unit identifications. The final arrow is smoothTraceUnitCanonical at the lower
level, not an unrelated proTrace or an independently chosen purity datum.
Source: thm-pur-finite-reduction-of-purity, unit trace clause
(blueprint: lem-pur-canonical-finite-unit-trace). -/
def FiniteUnitTraceReduction
    (ell : ℕ) [Fact ell.Prime] (D : WeilConjectures.FiniteFieldDatum.{u})
    (hEll : ell ≠ D.p) (E : PadicAlgCl.FiniteIntermediateField ell)
    (s : SmoothDatum D) : Prop :=
  ∀ (n m : ℕ) (h : m ≤ n),
  let cn := unitTraceFiniteCoefficient ell E n
  let cm := unitTraceFiniteCoefficient ell E m
  let a := unitTraceFiniteReductionMap.{u} ell E n m h
  ∃ ha : cn.integralMap ell ≫ a.hom.hom = cm.integralMap ell,
  ∃ p : ScalarLineCoordinates ell a ha s.X.left,
  let SY := scalarSixChange a s.Y.left
  let SX := scalarSixChange a s.X.left
  let FM := rightDerivedLowerShriekOfCompactification (cm.obj ell) s.compactification
  letI : SY.Monoidal := scalarSixChangeMonoidal a s.Y.left
  let unitMap := (Functor.Monoidal.εIso SY).inv
  let lineMap := SX.map (smoothTraceUnitSource ell cn D s).inv ≫
    sourceScalar ell a s.map s.dim ha p (𝟙_ _) ≫
    (cm.smoothSource ell s.map s.dim).map unitMap ≫
    (smoothTraceUnitSource ell cm D s).hom
  SY.map (smoothTraceUnitCanonical ell D hEll cn s) ≫ unitMap =
    (scalarSupportMap a s.compactification).app (cn.derivedLine ell s.X.left s.dim) ≫
      FM.map lineMap ≫ smoothTraceUnitCanonical ell D hEll cm s

end
