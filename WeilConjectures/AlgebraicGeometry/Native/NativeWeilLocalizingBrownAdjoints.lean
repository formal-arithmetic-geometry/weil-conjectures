/-- The ordinary geometric constructible hull, using the published native predicate and closure.
The algebraic closure is the native framework's `AlgebraicClosure k₀`.
Source: the native specialization of the final exceptional-adjunction sentence of
`cor-coef-verdier-weil-equivariance.proof.md`.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints) -/
abbrev nativeWeilUnderlyingHull (k₀ : Type u) [Field k₀] [Finite k₀]
    (l : ℕ) [Fact l.Prime] (T : Scheme.{u})
    [T.Over (Spec (CommRingCat.of k₀))] :=
  (ProEtale.DerivedCategory.boundedAdicConstructible l
    (T ↘ Spec (CommRingCat.of k₀)).geometricFiber).localizingClosure

/-- The Weil hull generated by free images of bounded constructible ordinary complexes.
Taking all such objects avoids choosing representatives; `nativeWeil_localizing_hulls` identifies
this with the hull for every small representative family in the statement.
Source: native specialization of `cor-coef-verdier-weil-equivariance.proof.md`, final sentence.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints) -/
abbrev nativeWeilLocalizingHull (k₀ : Type u) [Field k₀] [Finite k₀]
    (l : ℕ) [Fact l.Prime] (T : Scheme.{u})
    [T.Over (Spec (CommRingCat.of k₀))] :
    ObjectProperty (_root_.DerivedCategory (ProEtaleWeilSheaf k₀ l T)) :=
  (ObjectProperty.ofObj (fun A :
      (ProEtale.DerivedCategory.boundedAdicConstructible l
        (T ↘ Spec (CommRingCat.of k₀)).geometricFiber).FullSubcategory ↦
    (IsoAlgebra.Free.functor (WeilSheaf.frobeniusPullback k₀ l T)).mapDerivedCategory.obj
      A.obj)).localizingClosure

/-- The underlying compact-support composite for the very same native compactification.
The coefficient maps in these two functors are the published precomposition maps.
Source: native specialization of `cor-coef-verdier-weil-equivariance.proof.md`, final sentence.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints) -/
abbrev nativeWeilUnderlyingCompactSupport
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    {X Y : Scheme.{u}} [X.Over (Spec (CommRingCat.of k₀))]
    [Y.Over (Spec (CommRingCat.of k₀))]
    (f : X ⟶ Y) [f.IsOver (Spec (CommRingCat.of k₀))] (c : Compactification f) :
    _root_.DerivedCategory
        (ProEtale.AdicSheaf l (X ↘ Spec (CommRingCat.of k₀)).geometricFiber) ⥤
      _root_.DerivedCategory
        (ProEtale.AdicSheaf l (Y ↘ Spec (CommRingCat.of k₀)).geometricFiber) := by
  letI := Compactification.over (k₀ := k₀) c
  exact (ProEtale.adicOpenImmersionLowerShriek l
      (Scheme.Hom.geometricFiberMap c.i (comp_over c.i _))).mapDerivedCategory ⋙
    (ProEtale.adicLowerStar l
      (Scheme.Hom.geometricFiberMap c.g (comp_over c.g _))).rightDerivedFunctor

/-- The framework's chosen Nagata compactification, with its native existence witness.
Source: `def-sf-native-weil-derived-framework`, compact-support paragraph, as used in the
final exceptional-adjunction sentence of `cor-coef-verdier-weil-equivariance.proof.md`.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints) -/
abbrev nativeWeilChosenCompactification
    (k₀ : Type u) [Field k₀] {X Y : Scheme.{u}}
    [Y.Over (Spec (CommRingCat.of k₀))]
    [QuasiCompact (Y ↘ Spec (CommRingCat.of k₀))]
    [QuasiSeparated (Y ↘ Spec (CommRingCat.of k₀))]
    (f : X ⟶ Y) [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    Compactification f :=
  HasCompactification.compactification f (hf := hasCompactification_of_over (k₀ := k₀) f)

/-- A literal abbreviation for the Brown clauses of this node, for either of its two functors.
The functor of elements is the actual abelian-group-valued Hom functor; its action is
precomposition with `F.map`. Representation uses the same `G` as the displayed adjunction.
Source: native solution-set expansion of `cor-coef-verdier-weil-equivariance.proof.md`,
final exceptional-adjunction sentence, steps 6--9.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints) -/
def nativeWeilBrownAssertions {C : Type a} {D : Type b}
    [Category.{v} C] [Category.{v} D] [Preadditive C] [Preadditive D]
    [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] (F : C ⥤ D) : Prop :=
  ∃ G : D ⥤ C, Nonempty (F ⊣ G) ∧
    ∀ M : D,
      (F.op ⋙ preadditiveYoneda.obj M).IsHomological ∧
      (∀ I : Type v,
        PreservesLimitsOfShape (Discrete I) (F.op ⋙ preadditiveYoneda.obj M)) ∧
      (∃ (I : Type v) (B : I → C) (b : ∀ i, F.obj (B i) ⟶ M),
        ∀ (Z : C) (z : F.obj Z ⟶ M),
          ∃ (i : I) (f : Z ⟶ B i), F.map f ≫ b i = z) ∧
      Nonempty (yoneda.obj (G.obj M) ≅
        (F.op ⋙ preadditiveYoneda.obj M ⋙ forget AddCommGrpCat))

private theorem nativeWeil_frobenius_constructible
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    (T : Scheme.{u}) [T.Over (Spec (CommRingCat.of k₀))]
    (e : (T ↘ Spec (CommRingCat.of k₀)).geometricFiber ≅
      (T ↘ Spec (CommRingCat.of k₀)).geometricFiber)
    (A : _root_.DerivedCategory
      (ProEtale.AdicSheaf l (T ↘ Spec (CommRingCat.of k₀)).geometricFiber))
    (hA : ProEtale.DerivedCategory.boundedAdicConstructible l
      (T ↘ Spec (CommRingCat.of k₀)).geometricFiber A) :
    ProEtale.DerivedCategory.boundedAdicConstructible l
      (T ↘ Spec (CommRingCat.of k₀)).geometricFiber
      ((ProEtale.adicLowerStar l e.inv).mapDerivedCategory.obj A) := by
  let Q := ProEtale.DerivedCategory.boundedAdicConstructible l
    (T ↘ Spec (CommRingCat.of k₀)).geometricFiber
  have : Q.IsClosedUnderIsomorphisms := by
    dsimp [Q, ProEtale.DerivedCategory.boundedAdicConstructible]
    infer_instance
  exact Q.prop_of_iso
    ((Functor.mapDerivedCategoryNatIso
      (ProEtale.adicUpperStarIsoLowerStarInv l e)).app A)
    (ProEtale.DerivedCategory.boundedAdicConstructible_mapDerivedCategory_upperStar e.hom hA)

private theorem nativeWeil_heart
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    [Fact (ringChar k₀ ≠ l)] (T : Scheme.{u})
    [T.Over (Spec (CommRingCat.of k₀))]
    [LocallyOfFiniteType (T ↘ Spec (CommRingCat.of k₀))]
    [QuasiCompact (T ↘ Spec (CommRingCat.of k₀))] :
    NativeWeilInduction.HeartProperties k₀ l T := by
  have : IsLocallyNoetherian T :=
    LocallyOfFiniteType.isLocallyNoetherian (T ↘ Spec (CommRingCat.of k₀))
  have : QuasiSeparated (T ↘ Spec (CommRingCat.of k₀)) := by infer_instance
  exact (NativeWeilInduction.nativeWeil_derived_induction_comparison k₀ l
    (𝟙 T) (Compactification.ofIsProper (𝟙 T))).1

private theorem nativeWeil_frobenius_powers
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    (T : Scheme.{u}) [T.Over (Spec (CommRingCat.of k₀))]
    (A : _root_.DerivedCategory
      (ProEtale.AdicSheaf l (T ↘ Spec (CommRingCat.of k₀)).geometricFiber))
    (hA : ProEtale.DerivedCategory.boundedAdicConstructible l
      (T ↘ Spec (CommRingCat.of k₀)).geometricFiber A) (n : ℤ) :
    ProEtale.DerivedCategory.boundedAdicConstructible l
      (T ↘ Spec (CommRingCat.of k₀)).geometricFiber
      (IsoAlgebra.Free.obj (WeilSheaf.frobeniusPullback k₀ l T).mapDerivedCategory A n) := by
  let P := (WeilSheaf.frobeniusPullback k₀ l T).mapDerivedCategory
  let Q := ProEtale.DerivedCategory.boundedAdicConstructible l
    (T ↘ Spec (CommRingCat.of k₀)).geometricFiber
  have : Q.IsClosedUnderIsomorphisms := by
    dsimp [Q, ProEtale.DerivedCategory.boundedAdicConstructible]
    infer_instance
  let e := (T ↘ Spec (CommRingCat.of k₀)).geometricGaloisFrobenius
  have hp (B) (hB : Q B) : Q (P.obj B) :=
    nativeWeil_frobenius_constructible k₀ l T e B hB
  have hn (B) (hB : Q B) : Q (P.inv.obj B) := by
    have : (ProEtale.adicLowerStarEquivalence l e.symm).functor.Additive :=
      inferInstanceAs (ProEtale.adicLowerStar l e.inv).Additive
    have : (ProEtale.adicLowerStarEquivalence l e.symm).inverse.Additive :=
      inferInstanceAs (ProEtale.adicLowerStar l e.hom).Additive
    let E := (ProEtale.adicLowerStarEquivalence l e.symm).mapDerivedCategory
    let d : P.inv ≅ E.inverse :=
      Iso.isoInverseOfIsoFunctor (G := P.asEquivalence) (G' := E) (Iso.refl _)
    exact Q.prop_of_iso (d.symm.app B)
      (nativeWeil_frobenius_constructible k₀ l T e.symm B hB)
  cases n with
  | ofNat n =>
    change Q (IsoAlgebra.Free.posObj P A n)
    induction n with
    | zero => exact hA
    | succ n ih => exact hp _ ih
  | negSucc n =>
    change Q (IsoAlgebra.Free.negObj P A n)
    induction n with
    | zero => exact hn _ hA
    | succ n ih => exact hn _ ih

private theorem representative_hull {C : Type a} {D : Type b}
    [Category.{v} C] [Category.{v} D] [Preadditive D] [HasZeroObject D]
    [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (P : ObjectProperty C) (F : C ⥤ D) {I : Type v}
    (S : I → P.FullSubcategory) (hS : ∀ A, ∃ i, Nonempty (S i ≅ A)) :
    (ObjectProperty.ofObj (fun i ↦ F.obj (S i).obj)).localizingClosure =
      (ObjectProperty.ofObj (fun A : P.FullSubcategory ↦ F.obj A.obj)).localizingClosure := by
  apply le_antisymm
  · apply ObjectProperty.localizingClosure_monotone
    rintro _ ⟨i⟩
    exact ⟨S i⟩
  · apply ObjectProperty.localizingClosure_le
    rintro _ ⟨A⟩
    obtain ⟨i, ⟨e⟩⟩ := hS A
    exact ObjectProperty.prop_of_iso _ (F.mapIso (P.ι.mapIso e))
      (ObjectProperty.le_localizingClosure _ _ ⟨i⟩)

private theorem brown_of_set_generated
    {A : Type a} [Category.{v} A] [Abelian A]
    [IsGrothendieckAbelian.{v} A] [HasDerivedCategory.{v} A]
    (P : ObjectProperty (_root_.DerivedCategory A))
    [ObjectProperty.EssentiallySmall.{v} P]
    {D : Type b} [Category.{v} D] [Preadditive D]
    [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
    [Pretriangulated D]
    (F : P.localizingClosure.FullSubcategory ⥤ D)
    [F.CommShift ℤ] [F.IsTriangulated]
    (hF : ∀ J : Type v, PreservesColimitsOfShape (Discrete J) F) :
    nativeWeilBrownAssertions F := by
  classical
  have : HasCoproducts.{v} (_root_.DerivedCategory A) := derived_hasCoproducts
  have : IsIdempotentComplete P.localizingClosure.FullSubcategory :=
    isIdempotentComplete_of_countableCoproducts _
  have hH (M : D) : ∀ J : Type v,
      PreservesLimitsOfShape (Discrete J) (F.op ⋙ preadditiveYoneda.obj M) := by
    intro J
    have := hF J
    have : PreservesColimitsOfShape (Discrete J)ᵒᵖ F :=
      preservesColimitsOfShape_of_equiv (Discrete.opposite J).symm F
    have := preservesLimitsOfShape_op (Discrete J) F
    infer_instance
  have hsol (M : D) : ∃ (J : Type v) (B : J → P.localizingClosure.FullSubcategory)
      (b : ∀ j, F.obj (B j) ⟶ M),
      ∀ (Z : P.localizingClosure.FullSubcategory) (z : F.obj Z ⟶ M),
        ∃ (j : J) (f : Z ⟶ B j), F.map f ≫ b j = z := by
    exact setGeneratedDerived_cohomological_solutionSet P P.localizingClosure
      P.le_localizingClosure
      (fun R hR _ _ hcop ↦ by
        have : R.IsLocalizing := ⟨hcop⟩
        exact ObjectProperty.localizingClosure_le hR)
      (F.op ⋙ preadditiveYoneda.obj M) (hH M)
  have hrep (M : D) : (F.op ⋙ yoneda.obj M).IsRepresentable := by
    exact cohomological_isRepresentable_of_solutionSet
      (F.op ⋙ preadditiveYoneda.obj M) (hH M) (hsol M)
  have : F.IsLeftAdjoint := Functor.isLeftAdjoint_of_rightAdjointObjIsDefined_eq_top (by
    ext M
    exact iff_true_intro (hrep M))
  let G := F.rightAdjoint
  let adj : F ⊣ G := Adjunction.ofIsLeftAdjoint F
  refine ⟨G, ⟨adj⟩, fun M ↦ ⟨inferInstance, hH M, hsol M, ?_⟩⟩
  exact ⟨adj.compYonedaIso.app M⟩

private theorem restrict_preserves_coproducts
    {C : Type a} {D : Type b} [Category.{v} C] [Category.{v} D]
    (P : ObjectProperty C) (Q : ObjectProperty D) (F : C ⥤ D)
    (h : ∀ X, P X → Q (F.obj X))
    (hF : ∀ J : Type v, PreservesColimitsOfShape (Discrete J) (P.ι ⋙ F)) :
    ∀ J : Type v, PreservesColimitsOfShape (Discrete J) (P.liftFullSubcategory Q F h) := by
  intro J
  have := hF J
  have : PreservesColimitsOfShape (Discrete J) (P.liftFullSubcategory Q F h ⋙ Q.ι) :=
    preservesColimitsOfShape_of_natIso (P.liftFullSubcategoryCompιIso Q F h).symm
  exact preservesColimitsOfShape_of_reflects_of_preserves _ Q.ι

private theorem nativeWeil_small_constructible
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    [Fact (ringChar k₀ ≠ l)] (T : Scheme.{u})
    [T.Over (Spec (CommRingCat.of k₀))]
    [LocallyOfFiniteType (T ↘ Spec (CommRingCat.of k₀))]
    [QuasiCompact (T ↘ Spec (CommRingCat.of k₀))] :
    ObjectProperty.EssentiallySmall.{u + 1}
      (ProEtale.DerivedCategory.boundedAdicConstructible l
        (T ↘ Spec (CommRingCat.of k₀)).geometricFiber) := by
  let g := T ↘ Spec (CommRingCat.of k₀)
  let V : Over (Spec (CommRingCat.of (AlgebraicClosure k₀))) :=
    Over.mk g.geometricFiberToAlgebraicClosure
  have : LocallyOfFiniteType V.hom := by
    dsimp [V, g]
    infer_instance
  have : QuasiCompact V.hom := by
    dsimp [V, g]
    infer_instance
  obtain ⟨r⟩ :=
    WeilConjectures.LocallyFiniteAdicRealization.locally_finite_adic_constructible_realization
      k₀ (AlgebraicClosure k₀) l
      (Ne.symm (Fact.out : ringChar k₀ ≠ l)) V
  let Q := ProEtale.DerivedCategory.boundedAdicConstructible l g.geometricFiber
  have : EssentiallySmall.{u + 1} Q.FullSubcategory := r.toRealizationCore.targetSmall
  exact (ObjectProperty.exists_equivalence_iff Q).1
    ⟨SmallModel.{u + 1} Q.FullSubcategory, inferInstance,
      ⟨equivSmallModel.{u + 1} Q.FullSubcategory⟩⟩

private theorem nativeWeil_bounded_forget
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    (T : Scheme.{u}) [T.Over (Spec (CommRingCat.of k₀))]
    (K : _root_.DerivedCategory (ProEtaleWeilSheaf k₀ l T))
    (hK : WeilComplex.objectProperty k₀ l T K) :
    ProEtale.DerivedCategory.boundedAdicConstructible l
      (T ↘ Spec (CommRingCat.of k₀)).geometricFiber
      ((IsoAlgebra.forget (WeilSheaf.frobeniusPullback k₀ l T)).mapDerivedCategory.obj K) := by
  refine ⟨Functor.bounded_mapDerivedCategory_obj _ hK.1, fun n ↦ ?_⟩
  exact (ProEtale.adicConstructibleSheaf l _).prop_of_iso
    ((Functor.mapDerivedCategoryHomologyFunctorIso _ n).app K) (hK.2 n)

/-- The free-generated Weil hull is exactly the inverse image of the ordinary constructible
hull under derived forgetting. It is independent of the chosen small representatives, contains
native bounded constructible Weil complexes, and both hulls have split idempotents.

Source: `cor-coef-verdier-weil-equivariance.proof.md`, final sentence, native DAG expansion.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints)

Proof plan (DAG steps 1--3 and 5): the native induction comparison supplies Grothendieck hearts,
exact conservative coproduct-preserving forgetting and Frobenius stability. K-injective
resolutions and the derived-coproduct theorem put the Hom groups and sums in universe u+1.
The constructible realization supplies essential smallness. Exact induction preserves sums;
minimality of the hull puts I(L) in Loc(I(S)). Conversely the underlying free object is the sum
of all integer Frobenius translates. Positive and negative translates preserve the actual
constructible models: inverse Frobenius is again an automorphism, fixes locally finite functions
by precomposition, and pulls strata and finite free covering models to ones of the same kind.
Thus forgetting carries Loc(I(S)) into L. The natural cyclic triangle from
`lem-sf-free-derived-weil-resolution` puts every K with U(K) in L into Loc(I(S)). Exact forgetting
identifies cohomology, proving the bounded constructible inclusion. Both full localizing hulls
inherit countable coproducts and their triangulations; apply
`lem-countable-coproducts-idempotent-complete`. No compactness is used. -/
theorem nativeWeil_localizing_hulls
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    [Fact (ringChar k₀ ≠ l)] (T : Scheme.{u})
    [T.Over (Spec (CommRingCat.of k₀))]
    [LocallyOfFiniteType (T ↘ Spec (CommRingCat.of k₀))]
    [QuasiCompact (T ↘ Spec (CommRingCat.of k₀))] :
    (∀ (I : Type (u + 1))
      (S : I → (ProEtale.DerivedCategory.boundedAdicConstructible l
        (T ↘ Spec (CommRingCat.of k₀)).geometricFiber).FullSubcategory),
      (∀ A, ∃ i, Nonempty (S i ≅ A)) →
      (ObjectProperty.ofObj (fun i ↦
        (IsoAlgebra.Free.functor (WeilSheaf.frobeniusPullback k₀ l T)).mapDerivedCategory.obj
          (S i).obj)).localizingClosure = nativeWeilLocalizingHull k₀ l T) ∧
    nativeWeilLocalizingHull k₀ l T =
      (nativeWeilUnderlyingHull k₀ l T).inverseImage
        (IsoAlgebra.forget (WeilSheaf.frobeniusPullback k₀ l T)).mapDerivedCategory ∧
    (∀ A, nativeWeilUnderlyingHull k₀ l T A →
      nativeWeilLocalizingHull k₀ l T
        ((IsoAlgebra.Free.functor (WeilSheaf.frobeniusPullback k₀ l T)).mapDerivedCategory.obj
          A)) ∧
    (∀ K, nativeWeilLocalizingHull k₀ l T K →
      nativeWeilUnderlyingHull k₀ l T
        ((IsoAlgebra.forget (WeilSheaf.frobeniusPullback k₀ l T)).mapDerivedCategory.obj K)) ∧
    WeilComplex.objectProperty k₀ l T ≤ nativeWeilLocalizingHull k₀ l T ∧
    IsIdempotentComplete (nativeWeilUnderlyingHull k₀ l T).FullSubcategory ∧
    IsIdempotentComplete (nativeWeilLocalizingHull k₀ l T).FullSubcategory := by
  let P := ProEtale.DerivedCategory.boundedAdicConstructible l
    (T ↘ Spec (CommRingCat.of k₀)).geometricFiber
  let F := WeilSheaf.frobeniusPullback k₀ l T
  let I := (IsoAlgebra.Free.functor F).mapDerivedCategory
  let U := (IsoAlgebra.forget F).mapDerivedCategory
  let W := ObjectProperty.ofObj (fun A : P.FullSubcategory ↦ I.obj A.obj)
  have hheart := nativeWeil_heart k₀ l T
  have hderived := IsoAlgebra.freeWeil_derived_properties F
  have : I.IsLeftAdjoint := (IsoAlgebra.freeWeilDerivedAdjunction F).isLeftAdjoint
  have : ∀ J : Type (u + 1), PreservesColimitsOfShape (Discrete J) I :=
    fun _ ↦ inferInstance
  have : ∀ J : Type (u + 1), PreservesColimitsOfShape (Discrete J) U :=
    hderived.2.2.2.2
  have hI : P.localizingClosure ≤ W.localizingClosure.inverseImage I := by
    have : (W.localizingClosure.inverseImage I).IsLocalizing :=
      ⟨fun _ ↦ inferInstance⟩
    apply ObjectProperty.localizingClosure_le
    intro A hA
    exact W.le_localizingClosure _
      (ObjectProperty.ofObj_apply (fun A : P.FullSubcategory ↦ I.obj A.obj) ⟨A, hA⟩)
  have hU : W.localizingClosure ≤ P.localizingClosure.inverseImage U := by
    have : (P.localizingClosure.inverseImage U).IsLocalizing :=
      ⟨fun _ ↦ inferInstance⟩
    apply ObjectProperty.localizingClosure_le
    rintro _ ⟨A⟩
    have : P.localizingClosure.IsClosedUnderColimitsOfShape (Discrete ℤ) :=
      ObjectProperty.IsClosedUnderColimitsOfShape.of_equivalence
        (Discrete.equivalence (Equiv.ulift : ULift.{u + 1} ℤ ≃ ℤ))
    apply P.localizingClosure.prop_of_isColimit (hheart.2.2.2.2.2.2.2.2.2.2 A.obj).some
    intro n
    exact P.le_localizingClosure _ (nativeWeil_frobenius_powers k₀ l T A.obj A.property n.as)
  have heq : W.localizingClosure = P.localizingClosure.inverseImage U := by
    apply le_antisymm hU
    intro K hK
    have h := IsoAlgebra.freeWeil_mem_localizingClosure F P.localizingClosure K hK
    apply ObjectProperty.localizingClosure_le (Q := W.localizingClosure) ?_ K h
    rintro N ⟨A, hA, ⟨e⟩⟩
    exact W.localizingClosure.prop_of_iso e (hI A hA)
  refine ⟨?_, heq, hI, hU, ?_, ?_, ?_⟩
  · intro J S hS
    exact representative_hull P I S hS
  · intro K hK
    change W.localizingClosure K
    rw [heq]
    exact P.le_localizingClosure _ (nativeWeil_bounded_forget k₀ l T K hK)
  · have : HasCoproducts.{u + 1}
        (_root_.DerivedCategory (ProEtale.AdicSheaf l
          (T ↘ Spec (CommRingCat.of k₀)).geometricFiber)) := derived_hasCoproducts
    exact isIdempotentComplete_of_countableCoproducts _
  · have : HasCoproducts.{u + 1}
        (_root_.DerivedCategory (ProEtaleWeilSheaf k₀ l T)) := derived_hasCoproducts
    exact isIdempotentComplete_of_countableCoproducts _

/-- The actual native compact-support composites restrict to triangulated functors preserving
all small coproducts and admit ordinary right adjoints on precisely the displayed hulls.
Their Hom functors have all the solution-set and representation properties in the node.

Source: `cor-coef-verdier-weil-equivariance.proof.md`, final sentence, and
`sk-prop-int-brown-construction.proof.md`, open/proper bullets and final paragraph.
(blueprint: lem-sf-native-weil-localizing-brown-adjoints)

Proof plan (DAG steps 1, 4, 6--9): apply the native induction comparison for the specified
compactification, obtaining the natural comparison U_Y F_W = F U_X. Apply
`lem-sf-locally-finite-adic-compact-support-sums` to the geometric composite. The hypotheses
imply finite type for X,Y,Z and persist under extension to the algebraic closure. The hull
equality in `nativeWeil_localizing_hulls` gives preservation of the Weil hull. Apply U_Y to
the canonical coproduct comparison: naturality identifies it with the comparison for F,
including each coprojection and the empty family. Conservativity gives its invertibility.
Both restrictions inherit triangulation. For every target M, Hom(L(-),M) is cohomological by
`lem-weil-pbc-hom-out-of-triangle-exact` and its rotations, and takes sums to products by their
universal property. Apply `lem-sfb-set-generated-derived-solution-set` with S_X and I_X S_X;
smallness is supplied by the constructible realization. The preceding theorem gives split
idempotents. Apply `lem-sfb-cohomological-solution-set-representability`, then
`lem-sfb-right-adjoint-from-objectwise-representability` separately to both restrictions.
The same right-adjoint value represents each Hom functor naturally in its source variable. -/
theorem nativeWeil_localizing_brown_adjoints
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    [Fact (ringChar k₀ ≠ l)]
    {X Y : Scheme.{u}} [X.Over (Spec (CommRingCat.of k₀))]
    [Y.Over (Spec (CommRingCat.of k₀))]
    [LocallyOfFiniteType (X ↘ Spec (CommRingCat.of k₀))]
    [QuasiCompact (X ↘ Spec (CommRingCat.of k₀))]
    [LocallyOfFiniteType (Y ↘ Spec (CommRingCat.of k₀))]
    [QuasiCompact (Y ↘ Spec (CommRingCat.of k₀))]
    [QuasiSeparated (Y ↘ Spec (CommRingCat.of k₀))]
    (f : X ⟶ Y) [f.IsOver (Spec (CommRingCat.of k₀))]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ (h : ∀ K, nativeWeilUnderlyingHull k₀ l X K →
        nativeWeilUnderlyingHull k₀ l Y
          ((nativeWeilUnderlyingCompactSupport k₀ l f
            (nativeWeilChosenCompactification k₀ f)).obj K))
      (hW : ∀ K, nativeWeilLocalizingHull k₀ l X K →
        nativeWeilLocalizingHull k₀ l Y
          ((ProEtaleWeilSheaf.rightDerivedLowerShriek k₀ l f
            (nativeWeilChosenCompactification k₀ f)).obj K)),
      ((nativeWeilUnderlyingHull k₀ l X).liftFullSubcategory
        (nativeWeilUnderlyingHull k₀ l Y)
        (nativeWeilUnderlyingCompactSupport k₀ l f
          (nativeWeilChosenCompactification k₀ f)) h).IsTriangulated ∧
      ((nativeWeilLocalizingHull k₀ l X).liftFullSubcategory
        (nativeWeilLocalizingHull k₀ l Y)
        (ProEtaleWeilSheaf.rightDerivedLowerShriek k₀ l f
          (nativeWeilChosenCompactification k₀ f)) hW).IsTriangulated ∧
      (∀ I : Type (u + 1), PreservesColimitsOfShape (Discrete I)
        ((nativeWeilUnderlyingHull k₀ l X).liftFullSubcategory
          (nativeWeilUnderlyingHull k₀ l Y)
          (nativeWeilUnderlyingCompactSupport k₀ l f
            (nativeWeilChosenCompactification k₀ f)) h)) ∧
      (∀ I : Type (u + 1), PreservesColimitsOfShape (Discrete I)
        ((nativeWeilLocalizingHull k₀ l X).liftFullSubcategory
          (nativeWeilLocalizingHull k₀ l Y)
          (ProEtaleWeilSheaf.rightDerivedLowerShriek k₀ l f
            (nativeWeilChosenCompactification k₀ f)) hW)) ∧
      nativeWeilBrownAssertions
        ((nativeWeilUnderlyingHull k₀ l X).liftFullSubcategory
          (nativeWeilUnderlyingHull k₀ l Y)
          (nativeWeilUnderlyingCompactSupport k₀ l f
            (nativeWeilChosenCompactification k₀ f)) h) ∧
      nativeWeilBrownAssertions
        ((nativeWeilLocalizingHull k₀ l X).liftFullSubcategory
          (nativeWeilLocalizingHull k₀ l Y)
          (ProEtaleWeilSheaf.rightDerivedLowerShriek k₀ l f
            (nativeWeilChosenCompactification k₀ f)) hW) := by
  classical
  let c := nativeWeilChosenCompactification k₀ f
  let := Compactification.over (k₀ := k₀) c
  let Xb := (X ↘ Spec (CommRingCat.of k₀)).geometricFiber
  let Yb := (Y ↘ Spec (CommRingCat.of k₀)).geometricFiber
  let Zb := (c.Z ↘ Spec (CommRingCat.of k₀)).geometricFiber
  let fb := Scheme.Hom.geometricFiberMap f (comp_over f (Spec (CommRingCat.of k₀)))
  let ib := Scheme.Hom.geometricFiberMap c.i (comp_over c.i (Spec (CommRingCat.of k₀)))
  let pb := Scheme.Hom.geometricFiberMap c.g (comp_over c.g (Spec (CommRingCat.of k₀)))
  have : IsProper pb :=
    Scheme.Hom.geometricFiberMap_of_isStableUnderBaseChange
      (P := @IsProper) c.g (comp_over c.g _) inferInstance
  let cb : Compactification fb :=
    { Z := Zb, g := pb, i := ib
      comm := by
        dsimp [fb, ib, pb]
        rw [← Scheme.Hom.geometricFiberMap_comp]
        congr 1
        exact c.comm
      isProper := inferInstance
      isOpenImmersion := inferInstance }
  let : Xb.Over (Spec (CommRingCat.of (AlgebraicClosure k₀))) :=
    ⟨(X ↘ Spec (CommRingCat.of k₀)).geometricFiberToAlgebraicClosure⟩
  let : Yb.Over (Spec (CommRingCat.of (AlgebraicClosure k₀))) :=
    ⟨(Y ↘ Spec (CommRingCat.of k₀)).geometricFiberToAlgebraicClosure⟩
  let : fb.IsOver (Spec (CommRingCat.of (AlgebraicClosure k₀))) :=
    ⟨Scheme.Hom.geometricFiberMap_comp_geometricFiberToAlgebraicClosure f _⟩
  have : LocallyOfFiniteType (Xb ↘ Spec (CommRingCat.of (AlgebraicClosure k₀))) := by
    change LocallyOfFiniteType
      (X ↘ Spec (CommRingCat.of k₀)).geometricFiberToAlgebraicClosure
    infer_instance
  have : QuasiCompact (Xb ↘ Spec (CommRingCat.of (AlgebraicClosure k₀))) := by
    change QuasiCompact (X ↘ Spec (CommRingCat.of k₀)).geometricFiberToAlgebraicClosure
    infer_instance
  have : LocallyOfFiniteType (Yb ↘ Spec (CommRingCat.of (AlgebraicClosure k₀))) := by
    change LocallyOfFiniteType
      (Y ↘ Spec (CommRingCat.of k₀)).geometricFiberToAlgebraicClosure
    infer_instance
  have : QuasiCompact (Yb ↘ Spec (CommRingCat.of (AlgebraicClosure k₀))) := by
    change QuasiCompact (Y ↘ Spec (CommRingCat.of k₀)).geometricFiberToAlgebraicClosure
    infer_instance
  obtain ⟨h, htri, hsum⟩ :=
    ProEtale.nativeAdicCompactSupport_localizing_preservesCoproducts
      k₀ (AlgebraicClosure k₀) l (Fact.out : ringChar k₀ ≠ l) fb cb
  let PX := ProEtale.DerivedCategory.boundedAdicConstructible l Xb
  let PY := ProEtale.DerivedCategory.boundedAdicConstructible l Yb
  let LX := nativeWeilUnderlyingHull k₀ l X
  let LY := nativeWeilUnderlyingHull k₀ l Y
  let WX := nativeWeilLocalizingHull k₀ l X
  let WY := nativeWeilLocalizingHull k₀ l Y
  let UX := (IsoAlgebra.forget (WeilSheaf.frobeniusPullback k₀ l X)).mapDerivedCategory
  let UY := (IsoAlgebra.forget (WeilSheaf.frobeniusPullback k₀ l Y)).mapDerivedCategory
  let F := nativeWeilUnderlyingCompactSupport k₀ l f c
  let FW := ProEtaleWeilSheaf.rightDerivedLowerShriek k₀ l f c
  have hX := nativeWeil_localizing_hulls k₀ l X
  have hY := nativeWeil_localizing_hulls k₀ l Y
  have hW : ∀ K, WX K → WY (FW.obj K) := by
    intro K hK
    change nativeWeilLocalizingHull k₀ l Y (FW.obj K)
    rw [hY.2.1]
    exact LY.prop_of_iso ((NativeWeilInduction.comparison k₀ l f c).app K).symm
      (h _ (hX.2.2.2.1 K hK))
  let R := LX.liftFullSubcategory LY F h
  let RW := WX.liftFullSubcategory WY FW hW
  let RX := WX.liftFullSubcategory LX UX (hX.2.2.2.1)
  let RY := WY.liftFullSubcategory LY UY (hY.2.2.2.1)
  have hcomp := NativeWeilInduction.nativeWeil_derived_induction_comparison k₀ l f c
  have : FW.IsTriangulated := hcomp.2.2.2.2.1
  have : R.IsTriangulated := htri
  have : RW.IsTriangulated := inferInstance
  have : HasCoproducts.{u + 1}
      (_root_.DerivedCategory (ProEtaleWeilSheaf k₀ l X)) := derived_hasCoproducts
  have : HasCoproducts.{u + 1}
      (_root_.DerivedCategory (ProEtaleWeilSheaf k₀ l Y)) := derived_hasCoproducts
  have : HasCoproducts.{u + 1}
      (_root_.DerivedCategory (ProEtale.AdicSheaf l Xb)) := derived_hasCoproducts
  have : HasCoproducts.{u + 1}
      (_root_.DerivedCategory (ProEtale.AdicSheaf l Yb)) := derived_hasCoproducts
  have hUX := IsoAlgebra.freeWeil_derived_properties (WeilSheaf.frobeniusPullback k₀ l X)
  have hUY := IsoAlgebra.freeWeil_derived_properties (WeilSheaf.frobeniusPullback k₀ l Y)
  have : UY.ReflectsIsomorphisms := hUY.2.2.2.1
  have : RY.ReflectsIsomorphisms := by
    have : (RY ⋙ LY.ι).ReflectsIsomorphisms :=
      reflectsIsomorphisms_of_iso
        (WY.liftFullSubcategoryCompιIso LY UY _).symm
    exact reflectsIsomorphisms_of_comp RY LY.ι
  have hRX : ∀ J : Type (u + 1), PreservesColimitsOfShape (Discrete J) RX := by
    apply restrict_preserves_coproducts
    intro J
    have := hUX.2.2.2.2 J
    infer_instance
  have hRY : ∀ J : Type (u + 1), PreservesColimitsOfShape (Discrete J) RY := by
    apply restrict_preserves_coproducts
    intro J
    have := hUY.2.2.2.2 J
    infer_instance
  let β : RW ⋙ RY ≅ RX ⋙ R :=
    NatIso.ofComponents
      (fun K ↦ LY.isoMk ((NativeWeilInduction.comparison k₀ l f c).app K.obj))
      (fun g ↦ by
        apply LY.ι.map_injective
        exact (NativeWeilInduction.comparison k₀ l f c).hom.naturality g.hom)
  have hsumW : ∀ J : Type (u + 1), PreservesColimitsOfShape (Discrete J) RW := by
    intro J
    have := hRX J
    have := hRY J
    have : PreservesColimitsOfShape (Discrete J) R := hsum J
    have : PreservesColimitsOfShape (Discrete J) (RW ⋙ RY) :=
      preservesColimitsOfShape_of_natIso β.symm
    have : ReflectsColimitsOfShape (Discrete J) RY :=
      reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact preservesColimitsOfShape_of_reflects_of_preserves RW RY
  have : ObjectProperty.EssentiallySmall.{u + 1} PX :=
    nativeWeil_small_constructible k₀ l X
  have hsmallWX : ObjectProperty.EssentiallySmall.{u + 1}
      (ObjectProperty.ofObj (fun A : PX.FullSubcategory ↦
        (IsoAlgebra.Free.functor (WeilSheaf.frobeniusPullback k₀ l X)).mapDerivedCategory.obj
          A.obj)) := by
    let E := PX.ι ⋙
      (IsoAlgebra.Free.functor (WeilSheaf.frobeniusPullback k₀ l X)).mapDerivedCategory
    apply ObjectProperty.EssentiallySmall.of_le (Q := E.essImage)
    rintro _ ⟨A⟩
    exact ⟨A, ⟨Iso.refl _⟩⟩
  exact ⟨h, hW, htri, inferInstance, hsum, hsumW,
    brown_of_set_generated PX R hsum,
    brown_of_set_generated _ RW hsumW⟩

end AlgebraicGeometry
