/-!
# Finite coefficient descent of lisse modules and morphisms

Source: Weil blueprint, sec-six-functors-basics/sk-thm-sfb-qlbar-two-colimit,
`sk-lem-coefficient-finite-descent-lisse.md`, clauses (1)--(2)
(blueprint: det-lem-coefficient-finite-descent-lisse).

The Hom colimit is expressed by representatives modulo the equivalence generated by
scalar extension. Its canonical comparison is surjective, and equality of its values
is exactly that equivalence. All scalar comparisons below are the existing canonical
transitivity isomorphisms for ordinary extension of scalars.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped CategoryTheory.Obj

namespace CategoryTheory
section
variable {C D : Type*} [Category C] [Category D]
  {F F' : C ⥤ D} {G G' : D ⥤ C}

end
end CategoryTheory

namespace CategoryTheory
section Scalar
variable {C : Type*} [Category C] [MonoidalCategory C]
  [HasCoequalizers C] [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorLeft X)]
  [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorRight X)] [BraidedCategory C]
  {R S U : C} [MonObj R] [MonObj S] [MonObj U]
  [IsCommMonObj R] [IsCommMonObj S]
  (φ : R ⟶ S) [IsMonHom φ] (ψ : S ⟶ U) [IsMonHom ψ]
  (χ : R ⟶ U) [IsMonHom χ] (h : φ ≫ ψ = χ)

end Scalar
end CategoryTheory

namespace CategoryTheory
section ScalarCoherence
variable {C : Type*} [Category C] [MonoidalCategory C]
  [HasCoequalizers C] [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorLeft X)]
  [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorRight X)] [BraidedCategory C]
  {R S U V : C} [MonObj R] [MonObj S] [MonObj U] [MonObj V]
  [IsCommMonObj R] [IsCommMonObj S] [IsCommMonObj U]
  (f : R ⟶ S) [IsMonHom f] (g : S ⟶ U) [IsMonHom g] (j : U ⟶ V) [IsMonHom j]
  (fg : R ⟶ U) [IsMonHom fg] (gj : S ⟶ V) [IsMonHom gj]
  (fgj : R ⟶ V) [IsMonHom fgj]
  (hfg : f ≫ g = fg) (hgj : g ≫ j = gj) (hfgj : f ≫ gj = fgj) (hfgj' : fg ≫ j = fgj)
end ScalarCoherence
end CategoryTheory

