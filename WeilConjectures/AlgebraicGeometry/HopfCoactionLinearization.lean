module

public import WeilConjectures.RingTheory.HopfActionModuleData

import Mathlib.AlgebraicGeometry.Pullbacks

/-! # Semilinear coactions and affine action-groupoid linearizations

Source: Stacks Tag 03LF, affine translation, and Tag 022S, inverse group law.
(blueprint: lem-sfb-hopf-coaction-linearization)
-/

set_option autoImplicit false

@[expose] public section

universe u v w z

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped TensorProduct

namespace HopfAction

variable (k : Type u) [Field k] (H : Scheme.{u}) [hOver : H.Over (Spec (.of k))]
variable [hGrp : GrpObj (H.asOver (Spec (.of k)))] [hAffine : IsAffine H]
/-- The canonical coordinate Hopf structure with a bundled base ring.
Source: Mathlib Group/Affine, Tag 022S. (blueprint: lem-sfb-hopf-coaction-linearization) -/
@[instance_reducible]
noncomputable def affineCoordinateHopfAlgebra (R : CommRingCat.{u}) (G : Scheme.{u})
    [G.Over (Spec R)] [GrpObj (G.asOver (Spec R))] [IsAffine G] : HopfAlgebra R Γ(G, ⊤) :=
  inferInstance

/-- The canonical coordinate Hopf algebra, exposing the unbundled base field to inference.
Source: Mathlib Group/Affine, Tag 022S. (blueprint: lem-sfb-hopf-coaction-linearization) -/
noncomputable instance coordinateHopfAlgebra (k : Type u) [Field k] (H : Scheme.{u})
    [H.Over (Spec (.of k))] [GrpObj (H.asOver (Spec (.of k)))] [IsAffine H] :
    HopfAlgebra k Γ(H, ⊤) :=
  affineCoordinateHopfAlgebra (.of k) H

variable (E : Type v) [CommRing E] [Algebra k E]
variable (ρ : AlgebraCoaction k Γ(H, ⊤) E)
variable (M : Type w) [AddCommGroup M] [Module E M] [Module k M]
variable [IsScalarTower k E M]

/-- The bijection, its extension formula, and the explicit antipode inverse.
Source: Stacks Tags 03LF and 022S. (blueprint: lem-sfb-hopf-coaction-linearization)

Proof: use the coordinate Hopf structure (lem-sfb-affine-group-coordinate-hopf).
The module base-change universal property identifies maps out of the source extension
with semilinear maps. Identify the target extension with M tensor C by
m tensor (e tensor c) mapping to em tensor c. The identity pullback in IdentityDiagram is the
identity exactly when the generator
map is counital: apply its two extension identifications to 1 tensor m, and use
linearity to recover equality on the whole E-module. The composable-arrow ring is E tensor C
tensor C; its maps are
p_a(e tensor c)=e tensor c tensor 1, p_b(e tensor c)=rho(e) tensor c, and
p_ab(e tensor c)=e tensor Delta(c). In CocycleDiagram the middle transport identifies
p_b*t with p_a*s, the source transport identifies p_b*s with p_ab*s by the algebra
coaction law, and the target transport identifies p_a*t with p_ab*t. Each fixes
coefficient-module generators. IsPullback identifies the values of each pulled-back
map on those generators with the coefficient base change of delta(1 tensor m).
Thus evaluating the two composites gives (theta tensor 1)theta and (1 tensor Delta)theta,
respectively. The generator calculation is reversible because all the maps are
P-linear. This proves the actual pullback cocycle iff coassociativity. For the inverse, apply
theta, the antipode, and multiplication of
coefficients. Semilinearity and rho(e_0)(1 tensor S(e_1))=e tensor 1 prove balancing.
The two antipode cancellations and counitality prove both inverse composites.
These are steps 1--8 of the node; all tensor presentations are finite.
-/
theorem hopfCoactionLinearization :
    ∃ F : Linearization k Γ(H, ⊤) E M ρ ≃ ModuleCoaction k Γ(H, ⊤) E M ρ,
      (∀ (d : Linearization k Γ(H, ⊤) E M ρ) (m : M),
        (F d).map m = d.iso (extensionTensor k Γ(H, ⊤) E M ρ.map 1 m)) ∧
      (∀ (θ : ModuleCoaction k Γ(H, ⊤) E M ρ) (l : E ⊗[k] Γ(H, ⊤)) (m : M),
        (F.symm θ).iso (extensionTensor k Γ(H, ⊤) E M ρ.map l m) =
          targetAction k Γ(H, ⊤) E M l (θ.map m)) ∧
      (∀ (θ : ModuleCoaction k Γ(H, ⊤) E M ρ) (m : M) (h : Γ(H, ⊤))
        (n : ℕ) (a : Fin n → M) (b : Fin n → Γ(H, ⊤)),
        θ.map m = ∑ i, a i ⊗ₜ[k] b i →
        (F.symm θ).iso.symm (m ⊗ₜ[k] h) =
          ∑ i, extensionTensor k Γ(H, ⊤) E M ρ.map
            (1 ⊗ₜ[k] (HopfAlgebra.antipode k (b i) * h)) (a i)) := by
  sorry

/-- Module maps commute with the linearizations exactly when their coactions commute.
Source: Stacks Tag 03LF, morphisms. (blueprint: lem-sfb-hopf-coaction-linearization)

Proof: step 9 evaluates the linearization square on m tensor 1. Its two sides
are the coaction square displayed below. Scalar extension is generated by those
tensors, so equality there is equivalent to equality of the two L-linear maps.
-/
theorem hopfCoactionLinearization_morphisms
    (N : Type z) [AddCommGroup N] [Module E N] [Module k N] [IsScalarTower k E N]
    (dM : Linearization k Γ(H, ⊤) E M ρ) (dN : Linearization k Γ(H, ⊤) E N ρ)
    (f : M →ₗ[E] N) :
    (∀ x : Extension k Γ(H, ⊤) E M ρ.map,
      (f.restrictScalars k).rTensor Γ(H, ⊤) (dM.iso x) =
        dN.iso (extensionMap k Γ(H, ⊤) E M ρ.map f x)) ↔
    (∀ m : M,
      (f.restrictScalars k).rTensor Γ(H, ⊤)
          (dM.iso (extensionTensor k Γ(H, ⊤) E M ρ.map 1 m)) =
        dN.iso (extensionTensor k Γ(H, ⊤) E N ρ.map 1 (f m))) := by
  sorry

/-- The canonical unit datum has the given algebra coaction.
Source: Stacks Tag 03LF, structure module. (blueprint: lem-sfb-hopf-coaction-linearization)

Proof: step 10 identifies each extension of E with L by e tensor l mapping to r(e)l.
The canonical unit datum is the identity of L under these identifications; on
e tensor 1 its value is rho(e). The inverse identifications send l to 1 tensor l.
-/
theorem hopfCoactionLinearization_unit :
    ∃ d : Linearization k Γ(H, ⊤) E E ρ,
      ∀ e : E, d.iso (extensionTensor k Γ(H, ⊤) E E ρ.map 1 e) = ρ.map e := by
  sorry

/-- Tensoring the linearizations multiplies their Hopf coefficients.
Source: Stacks Tag 03LF, tensor datum. (blueprint: lem-sfb-hopf-coaction-linearization)

Proof: steps 11--12 identify the extension of M tensor_E N with the tensor over L
of the extensions, by (m tensor n) tensor l mapping to (m tensor 1) tensor (n tensor l).
The inverse multiplies the two L coefficients. Tensor the two isomorphisms and use
these comparisons. On generators the resulting map is exactly tensorCoefficients
applied to the two coactions. E-balancing follows from their semilinearity and
commutativity of C. Counitality follows from multiplicativity of epsilon;
coassociativity follows from multiplicativity of Delta. No finiteness is used.
-/
theorem hopfCoactionLinearization_tensor
    (N : Type z) [AddCommGroup N] [Module E N] [Module k N] [IsScalarTower k E N]
    (dM : Linearization k Γ(H, ⊤) E M ρ) (dN : Linearization k Γ(H, ⊤) E N ρ) :
    ∃ d : Linearization k Γ(H, ⊤) E (M ⊗[E] N) ρ,
      ∀ (m : M) (n : N),
        d.iso (extensionTensor k Γ(H, ⊤) E (M ⊗[E] N) ρ.map 1 (m ⊗ₜ[E] n)) =
          tensorCoefficients k Γ(H, ⊤) E M N
            (dM.iso (extensionTensor k Γ(H, ⊤) E M ρ.map 1 m) ⊗ₜ[k]
              dN.iso (extensionTensor k Γ(H, ⊤) E N ρ.map 1 n)) := by
  sorry

end HopfAction
