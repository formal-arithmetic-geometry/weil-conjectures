module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Spectrum.Prime.ConstructibleSet

/-!
# Affine schemes are limits of Noetherian affine schemes

Every commutative ring is the filtered union of its finitely generated subrings, which are
Noetherian. Hence every affine scheme is a cofiltered limit of Noetherian affine schemes with
affine transition maps. This is the affine case of absolute Noetherian approximation
[Stacks 01ZA].
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A]

/-- The subrings of `A` generated by finite subsets, as a filtered diagram of rings. -/
noncomputable def finsetSubringDiagram : Finset A ⥤ CommRingCat.{u} where
  obj s := .of (Algebra.adjoin ℤ (s : Set A))
  map {s t} h := CommRingCat.ofHom (Subalgebra.inclusion (Algebra.adjoin_mono
    (Finset.coe_subset.2 (leOfHom h)))).toRingHom
  map_id _ := by ext; rfl
  map_comp _ _ := by ext; rfl

/-- `A` as the colimit of its subrings generated by finite subsets. -/
noncomputable def finsetSubringCocone : Cocone (finsetSubringDiagram A) where
  pt := .of A
  ι :=
    { app s := CommRingCat.ofHom (Subalgebra.val _).toRingHom
      naturality _ _ _ := by ext; rfl }

/-- **A ring is the filtered union of its finitely generated subrings.** -/
noncomputable def isColimitFinsetSubringCocone : IsColimit (finsetSubringCocone A) := by
  have : ReflectsColimitsOfShape (Finset A) (CategoryTheory.forget CommRingCat.{u}) :=
    reflectsColimitsOfShape_of_reflectsIsomorphisms
  apply isColimitOfReflects (CategoryTheory.forget CommRingCat.{u})
  refine Types.FilteredColimit.isColimitOf' _ _ (fun a ↦ ?_) fun s x y h ↦ ?_
  · exact ⟨{a}, ⟨a, Algebra.subset_adjoin (by simp)⟩, rfl⟩
  · exact ⟨s, 𝟙 s, Subtype.ext h⟩

instance (s : Finset A) : IsNoetherianRing ((finsetSubringDiagram A).obj s) := by
  change IsNoetherianRing (Algebra.adjoin ℤ (s : Set A))
  have : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (s : Set A)) :=
    (Subalgebra.fg_iff_finiteType _).1 (Subalgebra.fg_adjoin_finset s)
  exact Algebra.FiniteType.isNoetherianRing ℤ _

/-- **Affine schemes are limits of Noetherian affine schemes** (the affine case of Stacks 01ZA).
`Spec A` is a cofiltered limit of spectra of finitely generated subrings of `A`, which are
Noetherian, with affine transition maps. -/
theorem exists_isLimit_isNoetherian_Spec :
    ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D : I ⥤ Scheme.{u}) (c : Cone D)
      (_ : IsLimit c), c.pt = Spec (.of A) ∧ (∀ i, IsNoetherian (D.obj i)) ∧
        ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) :=
  ⟨(Finset A)ᵒᵖ, inferInstance, inferInstance, (finsetSubringDiagram A).op ⋙ Scheme.Spec,
    Scheme.Spec.mapCone (finsetSubringCocone A).op,
    isLimitOfPreserves Scheme.Spec (isColimitFinsetSubringCocone A).op, rfl,
    fun i ↦ inferInstanceAs (IsNoetherian (Spec ((finsetSubringDiagram A).obj i.unop))),
    fun f ↦ inferInstanceAs (IsAffineHom (Spec.map ((finsetSubringDiagram A).map f.unop)))⟩

section Constructible

open _root_.PrimeSpectrum

variable {A}

/-- **Constructible subsets of `Spec A` descend to a finitely generated subring.** A constructible
subset of `Spec A` is cut out by finitely many elements of `A`, so it is the preimage of a
constructible subset of `Spec A₀` for the subring `A₀ ⊆ A` generated by a finite set. -/
theorem exists_finset_isConstructible_comap_eq {s : Set (PrimeSpectrum A)}
    (hs : Topology.IsConstructible s) :
    ∃ (F : Finset A) (t : Set (PrimeSpectrum (Algebra.adjoin ℤ (F : Set A)))),
      Topology.IsConstructible t ∧
        comap (Algebra.adjoin ℤ (F : Set A)).val.toRingHom ⁻¹' t = s := by
  classical
  obtain ⟨S, rfl⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hs
  let F : Finset A := S.biUnion fun C ↦ insert C.f (Finset.univ.image C.g)
  let B := Algebra.adjoin ℤ (F : Set A)
  have hf (C) (hC : C ∈ S) : C.f ∈ B :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨C, hC, by simp⟩))
  have hg (C) (hC : C ∈ S) (i) : C.g i ∈ B :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨C, hC, by simp⟩))
  let lift : S → BasicConstructibleSetData B := fun C ↦
    ⟨⟨C.1.f, hf _ C.2⟩, C.1.n, fun i ↦ ⟨C.1.g i, hg _ C.2 i⟩⟩
  let S' : ConstructibleSetData B := S.attach.image lift
  refine ⟨F, S'.toSet, S'.isConstructible_toSet, ?_⟩
  rw [← ConstructibleSetData.toSet_map]
  congr 1
  simp only [S', ConstructibleSetData.map, Finset.image_image]
  conv_rhs => rw [← Finset.attach_image_val (s := S)]
  refine Finset.image_congr fun C _ ↦ ?_
  rfl


/-- A basic constructible set `V(g) \ V(f)` is empty iff `f` lies in the radical of `(g)`. -/
lemma _root_.PrimeSpectrum.BasicConstructibleSetData.toSet_eq_empty_iff {R : Type*} [CommRing R]
    (C : BasicConstructibleSetData R) :
    C.toSet = ∅ ↔ C.f ∈ (Ideal.span (Set.range C.g)).radical := by
  rw [BasicConstructibleSetData.toSet, Set.sdiff_eq_empty, ← zeroLocus_span (Set.range C.g),
    ← zeroLocus_span {C.f}, zeroLocus_subset_zeroLocus_iff, Ideal.span_singleton_le_iff_mem]

/-- **Emptiness of a constructible set descends to a finite stage.** If a constructible subset of
`Spec A₀`, for `A₀ ⊆ A` generated by a finite set `F`, has empty preimage in `Spec A`, then it
already has empty preimage in `Spec A₁` for the subring generated by a larger finite set: the
emptiness of each basic piece `V(g) \ V(f)` is a relation `fⁿ = ∑ cᵢ gᵢ` with finitely many
coefficients in `A`. -/
theorem exists_finset_comap_eq_empty {F : Finset A}
    {t : Set (PrimeSpectrum (Algebra.adjoin ℤ (F : Set A)))} (ht : Topology.IsConstructible t)
    (h : comap (Algebra.adjoin ℤ (F : Set A)).val.toRingHom ⁻¹' t = ∅) :
    ∃ (F' : Finset A) (hF : F ⊆ F'),
      comap (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.2 hF))).toRingHom ⁻¹' t
        = ∅ := by
  classical
  obtain ⟨S, rfl⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr ht
  rw [← ConstructibleSetData.toSet_map] at h
  have key : ∀ C ∈ S, ∃ (n : ℕ) (c : Fin C.n → A),
      ((C.f : A)) ^ n = ∑ i, c i * (C.g i : A) := by
    intro C hC
    have hC' : (C.map (Algebra.adjoin ℤ (F : Set A)).val.toRingHom).toSet = ∅ := by
      refine Set.subset_eq_empty (fun p hp ↦ ?_) h
      simp only [ConstructibleSetData.toSet, ConstructibleSetData.map, Finset.mem_image,
        Set.mem_iUnion, exists_prop]
      exact ⟨_, ⟨C, hC, rfl⟩, hp⟩
    rw [BasicConstructibleSetData.toSet_eq_empty_iff] at hC'
    obtain ⟨n, hn⟩ := hC'
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hn
    exact ⟨n, c, by simpa [BasicConstructibleSetData.map] using hc.symm⟩
  choose! n c hnc using key
  let F' : Finset A := F ∪ S.biUnion fun C ↦ Finset.univ.image (c C)
  have hF : F ⊆ F' := Finset.subset_union_left
  refine ⟨F', hF, ?_⟩
  rw [← ConstructibleSetData.toSet_map]
  refine Set.eq_empty_of_forall_notMem fun p hp ↦ ?_
  simp only [ConstructibleSetData.toSet, ConstructibleSetData.map, Finset.mem_image,
    Set.mem_iUnion, exists_prop] at hp
  obtain ⟨_, ⟨C, hC, rfl⟩, hp⟩ := hp
  have hmem (i : Fin C.n) : c C i ∈ Algebra.adjoin ℤ (F' : Set A) :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_union_right _
      (Finset.mem_biUnion.2 ⟨C, hC, Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩)))
  have he : (C.map (Subalgebra.inclusion (Algebra.adjoin_mono
      (Finset.coe_subset.2 hF))).toRingHom).toSet = ∅ := by
    rw [BasicConstructibleSetData.toSet_eq_empty_iff]
    refine ⟨n C, (Ideal.mem_span_range_iff_exists_fun).2 ⟨fun i ↦ ⟨c C i, hmem i⟩, ?_⟩⟩
    apply Subtype.ext
    simpa [BasicConstructibleSetData.map] using (hnc C hC).symm
  rw [he] at hp
  exact hp


end Constructible

end AlgebraicGeometry
