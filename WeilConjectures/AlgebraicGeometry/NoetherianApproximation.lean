/-!
# Affine schemes are limits of Noetherian affine schemes

Every commutative ring is the filtered union of its finitely generated subrings, which are
Noetherian. Hence every affine scheme is a cofiltered limit of Noetherian affine schemes with
affine transition maps. This is the affine case of absolute Noetherian approximation
[Stacks 01ZA].
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A]

/-- The subrings of `A` generated by finite subsets, as a filtered diagram of rings. -/
noncomputable def finsetSubringDiagram : Finset A ⥤ CommRingCat.{u} where
  obj s := .of (Algebra.adjoin ℤ (s : Set A))
  map {s t} h := CommRingCat.ofHom (Subalgebra.inclusion (Algebra.adjoin_mono
    (Finset.coe_subset.2 (leOfHom h)))).toRingHom
  map_id _ := by ext; rfl
  map_comp _ _ := by ext; rfl

/-- `A` as the colimit of its subrings generated by finite subsets. -/
noncomputable def finsetSubringCocone : Cocone (finsetSubringDiagram A) where
  pt := .of A
  ι :=
    { app s := CommRingCat.ofHom (Subalgebra.val _).toRingHom
      naturality _ _ _ := by ext; rfl }

/-- **A ring is the filtered union of its finitely generated subrings.** -/
noncomputable def isColimitFinsetSubringCocone : IsColimit (finsetSubringCocone A) := by
  have : ReflectsColimitsOfShape (Finset A) (CategoryTheory.forget CommRingCat.{u}) :=
    reflectsColimitsOfShape_of_reflectsIsomorphisms
  apply isColimitOfReflects (CategoryTheory.forget CommRingCat.{u})
  refine Types.FilteredColimit.isColimitOf' _ _ (fun a ↦ ?_) fun s x y h ↦ ?_
  · exact ⟨{a}, ⟨a, Algebra.subset_adjoin (by simp)⟩, rfl⟩
  · exact ⟨s, 𝟙 s, Subtype.ext h⟩

instance (s : Finset A) : IsNoetherianRing ((finsetSubringDiagram A).obj s) := by
  change IsNoetherianRing (Algebra.adjoin ℤ (s : Set A))
  have : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (s : Set A)) :=
    (Subalgebra.fg_iff_finiteType _).1 (Subalgebra.fg_adjoin_finset s)
  exact Algebra.FiniteType.isNoetherianRing ℤ _

/-- **Affine schemes are limits of Noetherian affine schemes** (the affine case of Stacks 01ZA).
`Spec A` is a cofiltered limit of spectra of finitely generated subrings of `A`, which are
Noetherian, with affine transition maps. -/
theorem exists_isLimit_isNoetherian_Spec :
    ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D : I ⥤ Scheme.{u}) (c : Cone D)
      (_ : IsLimit c), c.pt = Spec (.of A) ∧ (∀ i, IsNoetherian (D.obj i)) ∧
        ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) :=
  ⟨(Finset A)ᵒᵖ, inferInstance, inferInstance, (finsetSubringDiagram A).op ⋙ Scheme.Spec,
    Scheme.Spec.mapCone (finsetSubringCocone A).op,
    isLimitOfPreserves Scheme.Spec (isColimitFinsetSubringCocone A).op, rfl,
    fun i ↦ inferInstanceAs (IsNoetherian (Spec ((finsetSubringDiagram A).obj i.unop))),
    fun f ↦ inferInstanceAs (IsAffineHom (Spec.map ((finsetSubringDiagram A).map f.unop)))⟩

section Constructible

open _root_.PrimeSpectrum Topology

variable {A}

/-- **Constructible subsets of `Spec A` descend to a finitely generated subring.** A constructible
subset of `Spec A` is cut out by finitely many elements of `A`, so it is the preimage of a
constructible subset of `Spec A₀` for the subring `A₀ ⊆ A` generated by a finite set. -/
theorem exists_finset_isConstructible_comap_eq {s : Set (PrimeSpectrum A)}
    (hs : Topology.IsConstructible s) :
    ∃ (F : Finset A) (t : Set (PrimeSpectrum (Algebra.adjoin ℤ (F : Set A)))),
      Topology.IsConstructible t ∧
        comap (Algebra.adjoin ℤ (F : Set A)).val.toRingHom ⁻¹' t = s := by
  classical
  obtain ⟨S, rfl⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hs
  let F : Finset A := S.biUnion fun C ↦ insert C.f (Finset.univ.image C.g)
  let B := Algebra.adjoin ℤ (F : Set A)
  have hf (C) (hC : C ∈ S) : C.f ∈ B :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨C, hC, by simp⟩))
  have hg (C) (hC : C ∈ S) (i) : C.g i ∈ B :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨C, hC, by simp⟩))
  let lift : S → BasicConstructibleSetData B := fun C ↦
    ⟨⟨C.1.f, hf _ C.2⟩, C.1.n, fun i ↦ ⟨C.1.g i, hg _ C.2 i⟩⟩
  let S' : ConstructibleSetData B := S.attach.image lift
  refine ⟨F, S'.toSet, S'.isConstructible_toSet, ?_⟩
  rw [← ConstructibleSetData.toSet_map]
  congr 1
  simp only [S', ConstructibleSetData.map, Finset.image_image]
  conv_rhs => rw [← Finset.attach_image_val (s := S)]
  refine Finset.image_congr fun C _ ↦ ?_
  rfl


/-- A basic constructible set `V(g) \ V(f)` is empty iff `f` lies in the radical of `(g)`. -/
lemma _root_.PrimeSpectrum.BasicConstructibleSetData.toSet_eq_empty_iff {R : Type*} [CommRing R]
    (C : BasicConstructibleSetData R) :
    C.toSet = ∅ ↔ C.f ∈ (Ideal.span (Set.range C.g)).radical := by
  rw [BasicConstructibleSetData.toSet, Set.sdiff_eq_empty, ← zeroLocus_span (Set.range C.g),
    ← zeroLocus_span {C.f}, zeroLocus_subset_zeroLocus_iff, Ideal.span_singleton_le_iff_mem]

/-- **Emptiness of a constructible set descends to a finite stage.** If a constructible subset of
`Spec A₀`, for `A₀ ⊆ A` generated by a finite set `F`, has empty preimage in `Spec A`, then it
already has empty preimage in `Spec A₁` for the subring generated by a larger finite set: the
emptiness of each basic piece `V(g) \ V(f)` is a relation `fⁿ = ∑ cᵢ gᵢ` with finitely many
coefficients in `A`. -/
theorem exists_finset_comap_eq_empty {F : Finset A}
    {t : Set (PrimeSpectrum (Algebra.adjoin ℤ (F : Set A)))} (ht : Topology.IsConstructible t)
    (h : comap (Algebra.adjoin ℤ (F : Set A)).val.toRingHom ⁻¹' t = ∅) :
    ∃ (F' : Finset A) (hF : F ⊆ F'),
      comap (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.2 hF))).toRingHom ⁻¹' t
        = ∅ := by
  classical
  obtain ⟨S, rfl⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr ht
  rw [← ConstructibleSetData.toSet_map] at h
  have key : ∀ C ∈ S, ∃ (n : ℕ) (c : Fin C.n → A),
      ((C.f : A)) ^ n = ∑ i, c i * (C.g i : A) := by
    intro C hC
    have hC' : (C.map (Algebra.adjoin ℤ (F : Set A)).val.toRingHom).toSet = ∅ := by
      refine Set.subset_eq_empty (fun p hp ↦ ?_) h
      simp only [ConstructibleSetData.toSet, ConstructibleSetData.map, Finset.mem_image,
        Set.mem_iUnion, exists_prop]
      exact ⟨_, ⟨C, hC, rfl⟩, hp⟩
    rw [BasicConstructibleSetData.toSet_eq_empty_iff] at hC'
    obtain ⟨n, hn⟩ := hC'
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hn
    exact ⟨n, c, by simpa [BasicConstructibleSetData.map] using hc.symm⟩
  choose! n c hnc using key
  let F' : Finset A := F ∪ S.biUnion fun C ↦ Finset.univ.image (c C)
  have hF : F ⊆ F' := Finset.subset_union_left
  refine ⟨F', hF, ?_⟩
  rw [← ConstructibleSetData.toSet_map]
  refine Set.eq_empty_of_forall_notMem fun p hp ↦ ?_
  simp only [ConstructibleSetData.toSet, ConstructibleSetData.map, Finset.mem_image,
    Set.mem_iUnion, exists_prop] at hp
  obtain ⟨_, ⟨C, hC, rfl⟩, hp⟩ := hp
  have hmem (i : Fin C.n) : c C i ∈ Algebra.adjoin ℤ (F' : Set A) :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_union_right _
      (Finset.mem_biUnion.2 ⟨C, hC, Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩)))
  have he : (C.map (Subalgebra.inclusion (Algebra.adjoin_mono
      (Finset.coe_subset.2 hF))).toRingHom).toSet = ∅ := by
    rw [BasicConstructibleSetData.toSet_eq_empty_iff]
    refine ⟨n C, (Ideal.mem_span_range_iff_exists_fun).2 ⟨fun i ↦ ⟨c C i, hmem i⟩, ?_⟩⟩
    apply Subtype.ext
    simpa [BasicConstructibleSetData.map] using (hnc C hC).symm
  rw [he] at hp
  exact hp


/-- **Compactness of the constructible topology**: a cover of a constructible subset of
`Spec R` by quasi-compact opens has a finite subcover. -/
lemma _root_.PrimeSpectrum.exists_finset_subset_iUnion_of_isConstructible {R : Type*}
    [CommRing R] {s : Set (PrimeSpectrum R)} (hs : IsConstructible s) {ι : Type*}
    (V : ι → Set (PrimeSpectrum R)) (hV : ∀ i, IsOpen (V i)) (hV' : ∀ i, IsCompact (V i))
    (hcov : s ⊆ ⋃ i, V i) : ∃ t : Finset ι, s ⊆ ⋃ i ∈ t, V i := by
  let φ : WithConstructibleTopology (PrimeSpectrum R) → PrimeSpectrum R :=
    WithTopology.ofTopology
  have hc : IsCompact (φ ⁻¹' s) := by
    apply IsClosed.isCompact
    rw [WithConstructibleTopology.isClosed_iff]
    exact @IsClopen.isClosed _ (constructibleTopology _) _ hs.isClopen_constructibleTopology
  obtain ⟨t, ht⟩ := hc.elim_finite_subcover (fun i ↦ φ ⁻¹' V i)
    (fun i ↦ by
      rw [WithConstructibleTopology.isOpen_iff]
      exact (hV' i).isOpen_constructibleTopology_of_isOpen (hV i))
    (fun y hy ↦ by simpa using hcov hy)
  exact ⟨t, fun x hx ↦ by
    simpa using ht (show WithTopology.toTopology _ x ∈ φ ⁻¹' s from hx)⟩

/-- **Constructible locally closed subsets of `Spec R` are of finite type**: such a set is the
intersection of a finite union of basic opens `D(a)` with the zero locus of finitely many
elements, by compactness of the constructible topology. -/
theorem _root_.PrimeSpectrum.exists_finset_eq_iUnion_basicOpen_inter_zeroLocus {R : Type*}
    [CommRing R] {s : Set (PrimeSpectrum R)} (hs : IsConstructible s) (hs' : IsLocallyClosed s) :
    ∃ f g : Finset R, s = (⋃ a ∈ f, (basicOpen a : Set (PrimeSpectrum R))) ∩
      zeroLocus (g : Set R) := by
  classical
  obtain ⟨U, Z, hU, hZ, rfl⟩ := hs'
  -- a finite union of basic opens between `U ∩ Z` and `U`
  obtain ⟨f, hf⟩ := PrimeSpectrum.exists_finset_subset_iUnion_of_isConstructible hs
    (fun a : {a : R // (basicOpen a : Set (PrimeSpectrum R)) ⊆ U} ↦
      (basicOpen a.1 : Set (PrimeSpectrum R)))
    (fun a ↦ (basicOpen a.1).isOpen) (fun a ↦ PrimeSpectrum.isCompact_basicOpen a.1)
    (fun x hx ↦ by
      obtain ⟨_, ⟨a, rfl⟩, hxa, haU⟩ :=
        isTopologicalBasis_basic_opens.exists_subset_of_mem_open hx.1 hU
      exact Set.mem_iUnion.2 ⟨⟨a, haU⟩, hxa⟩)
  let U' : Set (PrimeSpectrum R) := ⋃ a ∈ f.image Subtype.val, (basicOpen a : Set _)
  have hU'U : U' ⊆ U := by
    simp only [U', Set.iUnion₂_subset_iff, Finset.mem_image]
    rintro _ ⟨a, -, rfl⟩
    exact a.2
  have hsU' : U ∩ Z ⊆ U' := fun x hx ↦ by
    obtain ⟨a, ha, hxa⟩ := Set.mem_iUnion₂.1 (hf hx)
    exact Set.mem_iUnion₂.2 ⟨a.1, Finset.mem_image_of_mem _ ha, hxa⟩
  have hU'c : IsConstructible U' :=
    .biUnion (Finset.finite_toSet _) fun a _ ↦
      (PrimeSpectrum.isCompact_basicOpen a).isConstructible (basicOpen a).isOpen
  -- finitely many equations cutting out `U ∩ Z` inside `U'`
  obtain ⟨g, hg⟩ := PrimeSpectrum.exists_finset_subset_iUnion_of_isConstructible (hU'c.sdiff hs)
    (fun b : {b : R // b ∈ vanishingIdeal Z} ↦ (basicOpen b.1 : Set (PrimeSpectrum R)))
    (fun b ↦ (basicOpen b.1).isOpen) (fun b ↦ PrimeSpectrum.isCompact_basicOpen b.1)
    (fun x hx ↦ by
      have hxZ : x ∉ Z := fun h ↦ hx.2 ⟨hU'U hx.1, h⟩
      rw [← hZ.closure_eq, ← zeroLocus_vanishingIdeal_eq_closure] at hxZ
      simp only [mem_zeroLocus, Set.not_subset] at hxZ
      obtain ⟨b, hb, hbx⟩ := hxZ
      exact Set.mem_iUnion.2 ⟨⟨b, hb⟩, hbx⟩)
  refine ⟨f.image Subtype.val, g.image Subtype.val, Set.Subset.antisymm ?_ ?_⟩
  · refine fun x hx ↦ ⟨hsU' hx, ?_⟩
    simp only [mem_zeroLocus, Finset.coe_image, Set.image_subset_iff]
    rintro b -
    exact (mem_vanishingIdeal Z b.1).1 b.2 x hx.2
  · rintro x ⟨hxU', hxg⟩
    by_contra hx
    obtain ⟨b, hb, hxb⟩ := Set.mem_iUnion₂.1 (hg ⟨hxU', hx⟩)
    exact hxb (hxg (Finset.mem_coe.2 (Finset.mem_image_of_mem _ hb)))


set_option maxHeartbeats 1000000 in
-- The `let`-bound strata are unfolded repeatedly by the kernel.
/-- **Stratifications of an affine scheme descend to a finite stage.** Every stratification of
`Spec A` (constructible locally closed strata) is the preimage of a stratification of `Spec A₁`
for the subring `A₁ ⊆ A` generated by a finite set: each stratum is cut out by finitely many
elements, and the disjointness and covering conditions, whose failure is constructible, hold
after enlarging the finite set. -/
theorem exists_finset_stratification (S : Topology.Stratification (PrimeSpectrum A)) :
    ∃ (F : Finset A) (T : Topology.Stratification (PrimeSpectrum (Algebra.adjoin ℤ (F : Set A))))
      (e : Fin T.n ≃ Fin S.n), ∀ i,
        comap (Algebra.adjoin ℤ (F : Set A)).val.toRingHom ⁻¹' T.stratum i = S.stratum (e i) := by
  classical
  choose f g hfg using fun i ↦ PrimeSpectrum.exists_finset_eq_iUnion_basicOpen_inter_zeroLocus
    (S.isConstructible_stratum i) (S.isLocallyClosed_stratum i)
  let F₀ : Finset A := Finset.univ.biUnion fun i ↦ f i ∪ g i
  let B₀ := Algebra.adjoin ℤ (F₀ : Set A)
  have hmem (i) (a : A) (ha : a ∈ f i ∪ g i) : a ∈ B₀ :=
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨i, Finset.mem_univ _, ha⟩))
  let t₀ (i : Fin S.n) : Set (PrimeSpectrum B₀) :=
    (⋃ a : f i, (basicOpen (⟨a.1, hmem i a.1 (Finset.mem_union_left _ a.2)⟩ : B₀) :
      Set (PrimeSpectrum B₀))) ∩
      zeroLocus (Set.range fun b : g i ↦
        (⟨b.1, hmem i b.1 (Finset.mem_union_right _ b.2)⟩ : B₀))
  have ht₀ (i) : comap B₀.val.toRingHom ⁻¹' t₀ i = S.stratum i := by
    rw [hfg i]
    ext p
    simp only [t₀, AlgHom.toRingHom_eq_coe, Set.mem_preimage, Set.mem_inter_iff, Set.mem_iUnion,
      mem_zeroLocus, SetLike.mem_coe, exists_prop, Set.subset_def, Set.preimage_inter,
      Set.preimage_iUnion, mem_basicOpen, comap_asIdeal, Ideal.mem_comap, Set.mem_range,
      forall_exists_index, Subtype.exists]
    refine and_congr ⟨fun ⟨a, ha, h⟩ ↦ ⟨a, ha, h⟩, fun ⟨a, ha, h⟩ ↦ ⟨a, ha, h⟩⟩
      ⟨fun h x hx ↦ h _ x hx rfl, fun h x y hy hxy ↦ ?_⟩
    subst hxy
    exact h y hy
  have ht₀c (i) : IsConstructible (t₀ i) := by
    refine .inter (.iUnion fun a ↦
      (PrimeSpectrum.isCompact_basicOpen _).isConstructible (basicOpen _).isOpen) ?_
    rw [show zeroLocus (Set.range fun b : g i ↦
        (⟨b.1, hmem i b.1 (Finset.mem_union_right _ b.2)⟩ : B₀)) =
        ⋂ b : g i, ((basicOpen (⟨b.1, hmem i b.1 (Finset.mem_union_right _ b.2)⟩ : B₀) :
          Set (PrimeSpectrum B₀)))ᶜ by
      ext p
      simp [mem_zeroLocus, Set.range_subset_iff]]
    exact .iInter fun b ↦ isConstructible_compl.2
      ((PrimeSpectrum.isCompact_basicOpen _).isConstructible (basicOpen _).isOpen)
  -- the failure of the stratification conditions is constructible, with empty preimage
  let bad : Set (PrimeSpectrum B₀) :=
    (⋃ p ∈ {p : Fin S.n × Fin S.n | p.1 ≠ p.2}, t₀ p.1 ∩ t₀ p.2) ∪ (⋃ i, t₀ i)ᶜ
  have hbadc : IsConstructible bad :=
    (IsConstructible.biUnion (Set.toFinite _) fun p _ ↦ (ht₀c p.1).inter (ht₀c p.2)).union
      (isConstructible_compl.2 (.iUnion ht₀c))
  have hbad : comap B₀.val.toRingHom ⁻¹' bad = ∅ := by
    refine Set.eq_empty_of_forall_notMem fun x hx ↦ ?_
    rcases hx with hx | hx
    · obtain ⟨p, hp, hx⟩ := Set.mem_iUnion₂.1 hx
      have h1 : x ∈ S.stratum p.1 := by rw [← ht₀ p.1]; exact hx.1
      have h2 : x ∈ S.stratum p.2 := by rw [← ht₀ p.2]; exact hx.2
      exact Set.disjoint_left.1 (S.pairwise_disjoint_stratum hp) h1 h2
    · apply hx
      have : x ∈ ⋃ i, S.stratum i := S.iUnion_stratum_eq_univ ▸ Set.mem_univ x
      obtain ⟨i, hi⟩ := Set.mem_iUnion.1 this
      rw [← ht₀ i] at hi
      exact Set.mem_iUnion.2 ⟨i, hi⟩
  obtain ⟨F, hF, hF'⟩ := exists_finset_comap_eq_empty hbadc hbad
  let ι := Subalgebra.inclusion (R := ℤ) (Algebra.adjoin_mono (R := ℤ) (Finset.coe_subset.2 hF))
  let t (i : Fin S.n) : Set (PrimeSpectrum (Algebra.adjoin ℤ (F : Set A))) :=
    comap ι.toRingHom ⁻¹' t₀ i
  have hbad' (x) (hx : comap ι.toRingHom x ∈ bad) : False := by
    have : x ∈ comap ι.toRingHom ⁻¹' bad := hx
    rw [hF'] at this
    exact this
  refine ⟨F,
    { n := S.n
      stratum := t
      isLocallyClosed_stratum := fun i ↦ ?_
      isConstructible_stratum := fun i ↦ ?_
      iUnion_stratum_eq_univ := ?_
      pairwise_disjoint_stratum := fun i j hij ↦ ?_ }, Equiv.refl _, fun i ↦ ?_⟩
  · exact IsLocallyClosed.preimage
      ((isOpen_iUnion fun a ↦ (basicOpen _).isOpen).isLocallyClosed.inter
      (isClosed_zeroLocus _).isLocallyClosed) (continuous_comap ι.toRingHom)
  · obtain ⟨D, hD⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr (ht₀c i)
    change IsConstructible (comap ι.toRingHom ⁻¹' t₀ i)
    rw [← hD, ← ConstructibleSetData.toSet_map]
    exact ConstructibleSetData.isConstructible_toSet _
  · refine Set.eq_univ_of_forall fun x ↦ ?_
    by_contra h
    exact hbad' x (Or.inr fun hx ↦ h (by
      obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hx
      exact Set.mem_iUnion.2 ⟨i, hi⟩))
  · rw [Function.onFun, Set.disjoint_left]
    intro x hi hj
    exact hbad' x (Or.inl (Set.mem_iUnion₂.2 ⟨(i, j), hij, hi, hj⟩))
  · change comap _ ⁻¹' t i = S.stratum i
    rw [← ht₀ i]
    ext x
    change comap ι.toRingHom (comap _ x) ∈ t₀ i ↔ comap _ x ∈ t₀ i
    have hv : (Algebra.adjoin ℤ (F : Set A)).val.toRingHom.comp ι.toRingHom = B₀.val.toRingHom :=
      RingHom.ext fun _ ↦ rfl
    rw [← comap_comp_apply, hv]


end Constructible

end AlgebraicGeometry
