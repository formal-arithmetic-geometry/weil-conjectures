module

public import WeilConjectures.AlgebraicGeometry.AlgebraicSpacePointTopology
public import Mathlib.Topology.Spectral.ConstructibleTopology
public import Mathlib.AlgebraicGeometry.AffineScheme

/-! # The constructible topology on algebraic-space points

Source: Rydh, Submersions and effective descent of étale morphisms, Remark (1.8), p.7
(blueprint: def-sfb-space-constructible-point-topology).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.AlgebraicSpace

/-- Final topology of the constructible topologies of all representable étale affine charts.
On each affine scheme chart the topology is Mathlib's topology generated by compact opens
and their complements. The construction also applies to presheaves and their pullbacks.
Source: Rydh, Remark (1.8), p.7
(blueprint: def-sfb-space-constructible-point-topology). -/
@[instance_reducible]
noncomputable def pointConstructibleTopology {S : Scheme.{u}}
    (F : (Over S)ᵒᵖ ⥤ Type u) : TopologicalSpace (Point F) :=
  ⨆ (T : Over S) (a : yoneda.obj T ⟶ F) (_ : IsEtale a) (_ : IsAffine T.left),
    TopologicalSpace.coinduced (schemePointMap a) (constructibleTopology T.left)

end AlgebraicGeometry.AlgebraicSpace
