module

public import WeilConjectures.AlgebraicGeometry.Sites.StrictHenselizationLocal
public import WeilConjectures.AlgebraicGeometry.StrictHenselizationChartMaximalIdeal

/-!
# The fibre of a strict localization over its centre

Let `s: Spec Ω ⟶ S` be a geometric point with `Ω` algebraically closed. The only point of the
strict localization `S_(s)` lying over the image of `s` is the closed point: in an affine chart
`Spec R` through which `s` factors, the maximal ideal of the strict henselization is generated by
the prime ideal of the image of `s`
(`AlgebraicGeometry.Scheme.strictHenselization_chart_maximalIdeal`,
Stacks, Tag 04HX).

## Main results

- `AlgebraicGeometry.Scheme.eq_closedPoint_of_strictLocalizationToBase_eq`: a point of `S_(s)`
  mapping to the image of `s` is the closed point.
- `AlgebraicGeometry.Scheme.strictLocalizationToBase_ne_of_ne_closedPoint`: a point of `S_(s)`
  other than the closed point does not map to the image of `s`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

/-- The only point of the strict localization `S_(s)` lying over the image of the geometric point
`s` is the closed point. -/
lemma eq_closedPoint_of_strictLocalizationToBase_eq {S : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ S) (q : strictLocalization s)
    (hq : strictLocalizationToBase s q = s (IsLocalRing.closedPoint Ω)) :
    q = IsLocalRing.closedPoint (strictHenselization s) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hsU, -⟩ := S.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ (s (IsLocalRing.closedPoint Ω))) isOpen_univ
  let i := hU.fromSpec
  have hrange : Set.range s ⊆ Set.range i := by
    rintro _ ⟨x, rfl⟩
    rw [Subsingleton.elim x (IsLocalRing.closedPoint Ω), IsAffineOpen.range_fromSpec]
    exact hsU
  obtain ⟨xR, rfl⟩ : ∃ xR, s = xR ≫ i := ⟨IsOpenImmersion.lift i s hrange, by simp⟩
  obtain ⟨_, ρ, hρ, hmax⟩ := strictHenselization_chart_maximalIdeal _ i xR
  have hqR : Spec.map ρ q = xR (IsLocalRing.closedPoint Ω) := by
    apply i.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hρ, hq, Scheme.Hom.comp_apply]
  refine PrimeSpectrum.ext ?_
  refine le_antisymm (IsLocalRing.le_maximalIdeal q.isPrime.ne_top) ?_
  change IsLocalRing.maximalIdeal _ ≤ q.asIdeal
  rw [hmax, Ideal.map_le_iff_le_comap, ← hqR]
  rfl

/-- A point of the strict localization `S_(s)` other than the closed point does not lie over the
image of the geometric point `s`. -/
lemma strictLocalizationToBase_ne_of_ne_closedPoint {S : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ S) (q : strictLocalization s)
    (hq : q ≠ IsLocalRing.closedPoint (strictHenselization s)) :
    strictLocalizationToBase s q ≠ s (IsLocalRing.closedPoint Ω) :=
  fun h ↦ hq (eq_closedPoint_of_strictLocalizationToBase_eq s q h)

end AlgebraicGeometry.Scheme
