module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.Charts
public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.OfInvertible

/-!
# Functions on the standard charts of projective space

Over an affine base `S`, the ring of functions of the standard chart `D₊(Tᵢ)` of `ℙ(n; S)` is
generated by the functions of `S` and the ratios `Tⱼ / Tᵢ`. The ratio `Tⱼ / Tᵢ` is invertible
exactly on `D₊(Tᵢ) ∩ D₊(Tⱼ)`, and the ratios are compatible with base change.

## Main statements

- `AlgebraicGeometry.AffineSpace.closure_range_appTop_union_range_coord`: over an affine base,
  the functions of `𝔸(n; S)` are generated by those of `S` and the coordinates.
- `AlgebraicGeometry.ProjectiveSpace.closure_range_appLE_union_range_coordRatio`: over an affine
  base, the functions on `D₊(Tᵢ)` are generated by those of `S` and the ratios `Tⱼ / Tᵢ`.
- `AlgebraicGeometry.ProjectiveSpace.basicOpen_coordRatio_le`: the ratio `Tⱼ / Tᵢ` only becomes
  invertible inside `D₊(Tⱼ)`.
- `AlgebraicGeometry.ProjectiveSpace.map_appLE_coordRatio`: base change of projective space
  pulls the ratios back to the ratios.
-/

@[expose] public section

universe u

open CategoryTheory Limits MvPolynomial

noncomputable section

namespace AlgebraicGeometry

namespace AffineSpace

/-- Over an affine base, the ring of functions of the affine space `𝔸(n; S)` is generated by
the functions of `S` and the coordinates. -/
lemma closure_range_appTop_union_range_coord {n : Type u} (S : Scheme.{u}) [IsAffine S] :
    Subring.closure (Set.range (𝔸(n; S) ↘ S).appTop ∪ Set.range (coord S)) = ⊤ := by
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨y, rfl⟩ : ∃ y, (isoOfIsAffine n S).hom.appTop y = x :=
    ⟨(isoOfIsAffine n S).inv.appTop x, by
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, Iso.hom_inv_id]
      rfl⟩
  rw [isoOfIsAffine_hom_appTop, CommRingCat.comp_apply]
  generalize (Scheme.ΓSpecIso _).hom y = p
  induction p using MvPolynomial.induction_on with
  | C a => exact Subring.subset_closure (Or.inl ⟨a, by simp⟩)
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul]
    exact mul_mem hp (Subring.subset_closure (Or.inr ⟨i, by simp⟩))

end AffineSpace

namespace Proj

attribute [local instance] MvPolynomial.gradedAlgebra

/-- In the integral model `ℙⁿ_ℤ`, the ratio `Xⱼ / Xᵢ` on `D₊(Xᵢ)` is only invertible inside
`D₊(Xⱼ)`. -/
lemma basicOpen_awayToSection_awayXRatio_le {n : Type u} (i j : n) :
    (Proj (homogeneousSubmodule n (ULift.{u} ℤ))).basicOpen
        (Proj.awayToSection _ (X i) (awayXRatio (ULift.{u} ℤ) i j)) ≤
      Proj.basicOpen (homogeneousSubmodule n (ULift.{u} ℤ)) (X j) := by
  set 𝒜 := homogeneousSubmodule n (ULift.{u} ℤ)
  have hi : (X i : MvPolynomial n (ULift.{u} ℤ)) ∈ 𝒜 1 := X_mem_homogeneousSubmodule_one _ i
  have hj : (X j : MvPolynomial n (ULift.{u} ℤ)) ∈ 𝒜 1 := X_mem_homogeneousSubmodule_one _ j
  set D := Proj.basicOpen 𝒜 (X i)
  have h₁ : D.toScheme.basicOpen (D.topIso.inv (Proj.awayToSection 𝒜 (X i)
      (awayXRatio (ULift.{u} ℤ) i j))) = D.ι ⁻¹ᵁ Proj.basicOpen 𝒜 (X j) := by
    have e : D.topIso.inv (Proj.awayToSection 𝒜 (X i) (awayXRatio (ULift.{u} ℤ) i j)) =
        (Proj.basicOpenToSpec 𝒜 (X i)).appTop
          ((Scheme.ΓSpecIso _).inv (awayXRatio (ULift.{u} ℤ) i j)) := by
      rw [Scheme.Hom.appTop, Proj.basicOpenToSpec_app_top]
      simp only [CommRingCat.comp_apply, Iso.inv_hom_id_apply]
      rfl
    rw [e, ← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine,
      ← isLocalizationElem_X, ← Proj.awayι_preimage_basicOpen 𝒜 hi one_pos hj one_pos,
      ← Scheme.Hom.comp_preimage, ← Proj.basicOpenIsoSpec_hom 𝒜 (X i) hi one_pos,
      ← Proj.basicOpenIsoSpec_inv_ι 𝒜 (X i) hi one_pos, Iso.hom_inv_id_assoc]
  rw [← Scheme.Opens.ι_image_basicOpen_topIso_inv, h₁]
  rintro _ ⟨y, hy, rfl⟩
  exact hy

end Proj

namespace ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable {n : Type u}

private lemma appLE_eq_of_eq {X Y : Scheme.{u}} {f g : X ⟶ Y} (h : f = g) (U V e) :
    f.appLE U V e = g.appLE U V (h ▸ e) := by
  subst h
  rfl

private lemma appLE_apply_eq_map {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V W : X.Opens)
    (e₁ : W ≤ f ⁻¹ᵁ U) (e₂ : V ≤ f ⁻¹ᵁ U) (h : W ≤ V) (x : Γ(Y, U)) :
    f.appLE U W e₁ x = X.presheaf.map (homOfLE h).op (f.appLE U V e₂ x) := by
  rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]

/-- **Base change pulls the ratios back to the ratios**: for `f : S ⟶ T`, the morphism
`ℙ(n; S) ⟶ ℙ(n; T)` pulls the function `Tⱼ / Tᵢ` on `D₊(Tᵢ)` back to `Tⱼ / Tᵢ`. -/
lemma map_appLE_coordRatio {S T : Scheme.{u}} (f : S ⟶ T) (i j : n) (e) :
    (map n f).appLE (standardOpen n T i) (standardOpen n S i) e (coordRatio n T i j) =
      coordRatio n S i j := by
  have key (U : (Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ)).Opens)
      (x : Γ(Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ), U)) (e') :
      (map n f).appLE (toProjInt n T ⁻¹ᵁ U) (toProjInt n S ⁻¹ᵁ U) e' ((toProjInt n T).app U x) =
        (toProjInt n S).app U x := by
    rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE,
      appLE_eq_of_eq (map_toProjInt n f), Scheme.Hom.app_eq_appLE]
  exact key _ _ e

/-- **The ratio `Tⱼ / Tᵢ` is only invertible inside `D₊(Tⱼ)`.** -/
lemma basicOpen_coordRatio_le (S : Scheme.{u}) (i j : n) :
    ℙ(n; S).basicOpen (coordRatio n S i j) ≤ standardOpen n S j := by
  have key (U V : (Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ)).Opens)
      (x : Γ(Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ), U))
      (h : (Proj.projectiveSpaceOverAffine n (ULift.{u} ℤ)).basicOpen x ≤ V) :
      ℙ(n; S).basicOpen ((toProjInt n S).app U x) ≤ toProjInt n S ⁻¹ᵁ V := by
    rw [← Scheme.preimage_basicOpen]
    exact (toProjInt n S).preimage_mono h
  exact key _ _ _ (Proj.basicOpen_awayToSection_awayXRatio_le i j)

/-- **The functions on a standard chart.** Over an affine base `S`, the ring of functions on the
standard open `D₊(Tᵢ)` of `ℙ(n; S)` is generated by the functions of `S` and the ratios
`Tⱼ / Tᵢ`.

The morphism `H : 𝔸({j // j ≠ i}; S) ⟶ ℙ(n; S)` given by the coordinates and `1` in position `i`
is, through the chart isomorphism, the identity of the affine space
(`AlgebraicGeometry.ProjectiveSpace.homOfSections_resLE_standardOpenIso_hom`); so it identifies
the functions on `D₊(Tᵢ)` with those of the affine space, pulling `Tⱼ / Tᵢ` back to the
coordinates (`AlgebraicGeometry.ProjectiveSpace.homOfSections_appLE_coordRatio`). -/
theorem closure_range_appLE_union_range_coordRatio (S : Scheme.{u}) [IsAffine S] (i : n) :
    Subring.closure (Set.range ((ℙ(n; S) ↘ S).appLE ⊤ (standardOpen n S i) le_top) ∪
      Set.range (coordRatio n S i)) = ⊤ := by
  classical
  set Y := 𝔸({j : n // j ≠ i}; S)
  let w : n → Γ(Y, ⊤) := fun a ↦ if h : a = i then 1 else AffineSpace.coord S ⟨a, h⟩
  have hwi : w i = 1 := dif_pos rfl
  have hwj (j : {j : n // j ≠ i}) : w j.1 = AffineSpace.coord S j := dif_neg j.2
  have hw : Ideal.span (Set.range w) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨i, rfl⟩) (by rw [hwi]; exact isUnit_one)
  set H := homOfSections (Y ↘ S) w hw
  set B := Y.basicOpen (w i)
  have hB : B = ⊤ := by rw [show B = Y.basicOpen (w i) from rfl, hwi]; exact Y.basicOpen_one
  have hle : B ≤ H ⁻¹ᵁ standardOpen n S i := (homOfSections_preimage_standardOpen _ w hw i).ge
  have : IsIso B.ι := by
    rw [← Y.isoOfEq_hom_ι hB, ← Scheme.topIso_hom]
    infer_instance
  -- `H` restricts to an isomorphism `B ≅ D₊(Tᵢ)`
  have hres : H.resLE (standardOpen n S i) B hle = B.ι ≫ (standardOpenIso n S i).inv := by
    have h2 : H.resLE (standardOpen n S i) B hle ≫ (standardOpenIso n S i).hom = B.ι := by
      refine (homOfSections_resLE_standardOpenIso_hom (Y ↘ S) w hw i).trans ?_
      refine AffineSpace.hom_ext (by simp) fun j ↦ ?_
      rw [AffineSpace.homOfVector_appTop_coord]
      symm
      refine Y.eq_divBasicOpen ?_
      have h1 : ∀ x : Γ(Y, ⊤), x = 1 → (Y.basicOpen (w i)).ι.appTop x = 1 := by
        rintro x rfl
        exact map_one _
      rw [h1 _ hwi, mul_one, hwj]
    rw [← h2, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hiso : IsIso (H.resLE (standardOpen n S i) B hle) := by rw [hres]; infer_instance
  -- so `H.appLE` is a bijection `Γ(ℙ, D₊(Tᵢ)) ≅ Γ(Y, B)`
  have hb := ConcreteCategory.bijective_of_isIso ((H.resLE (standardOpen n S i) B hle).app ⊤)
  rw [Scheme.Hom.resLE_app_top] at hb
  set ρ := H.appLE (standardOpen n S i) B hle
  have hρ : Function.Bijective ρ := by
    have e : ⇑ρ = ⇑B.topIso.hom ∘ ⇑((standardOpen n S i).topIso.hom ≫ ρ ≫ B.topIso.inv) ∘
        ⇑(standardOpen n S i).topIso.inv := by
      ext x
      simp only [Function.comp_apply, CommRingCat.comp_apply, Iso.inv_hom_id_apply]
    rw [e]
    exact (ConcreteCategory.bijective_of_isIso _).comp
      (hb.comp (ConcreteCategory.bijective_of_isIso _))
  -- the restriction `Γ(Y, ⊤) ⟶ Γ(Y, B)` is bijective
  set r := Y.presheaf.map (homOfLE (le_top : B ≤ ⊤)).op
  have hr : Function.Surjective r := by
    have : (homOfLE (le_top : B ≤ ⊤)) = eqToHom hB := Subsingleton.elim _ _
    have : IsIso r := by
      simp only [r, this, eqToHom_op]
      infer_instance
    exact (ConcreteCategory.bijective_of_isIso r).2
  -- the images of the generators
  have hgen : (⊤ : Subring Γ(Y, B)) ≤ (Subring.closure
      (Set.range ((ℙ(n; S) ↘ S).appLE ⊤ (standardOpen n S i) le_top) ∪
        Set.range (coordRatio n S i))).map ρ.hom := by
    rw [RingHom.map_closure]
    rintro x -
    obtain ⟨x, rfl⟩ := hr x
    have hx := (AffineSpace.closure_range_appTop_union_range_coord (n := {j : n // j ≠ i}) S).ge
      (Set.mem_univ x)
    induction hx using Subring.closure_induction with
    | mem z hz =>
      refine Subring.subset_closure ?_
      rcases hz with ⟨c, rfl⟩ | ⟨j, rfl⟩
      · refine ⟨_, Or.inl ⟨c, rfl⟩, ?_⟩
        simp only [ρ, r]
        erw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
        rw [appLE_eq_of_eq (homOfSections_over (Y ↘ S) w hw), Scheme.Hom.appTop,
          Scheme.Hom.app_eq_appLE]
        exact appLE_apply_eq_map _ _ _ _ _ _ _ _
      · refine ⟨_, Or.inr ⟨j.1, rfl⟩, ?_⟩
        have h := homOfSections_appLE_coordRatio (Y ↘ S) w hw hwi j.1
          (le_of_eq hB.symm |>.trans hle)
        rw [hwj] at h
        simp only [ρ, r]
        rw [← h]
        exact appLE_apply_eq_map _ _ _ _ _ _ _ _
    | zero => simp
    | one => simp
    | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
    | neg a _ ha => rw [map_neg]; exact neg_mem ha
    | mul a b _ _ ha hb => rw [map_mul]; exact mul_mem ha hb
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨y, hy, hxy⟩ := hgen (Set.mem_univ (ρ x))
  rwa [hρ.1 hxy] at hy

end ProjectiveSpace

end AlgebraicGeometry
