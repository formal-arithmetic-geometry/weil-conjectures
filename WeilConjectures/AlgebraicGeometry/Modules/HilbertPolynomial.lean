/-!
# Hilbert polynomials of ample invertible modules

Let `X` be a proper scheme over a field `K` and `ℒ` an ample invertible `𝒪_X`-module. For every
coherent `𝒪_X`-module `ℱ` supported in a closed subset `Z` of dimension `< d`, the function
`n ↦ χ(X, ℱ ⊗ ℒ^{⊗ n})` is given by a polynomial of degree `< d`.

The proof is a dévissage on `d`. By prime avoidance there are sections `s` of `ℒ^{⊗ a}` and
`ℒ^{⊗ (a + 1)}` which do not vanish at the generic points of the irreducible components of `Z`.
The kernel and the cokernel of `s : ℱ ⟶ ℱ ⊗ ℒ^{⊗ a}` are supported on `Z ∩ V(s)`, of dimension
`< d - 1`, so by additivity of the Euler characteristic the differences
`χ(ℱ ⊗ ℒ^{⊗ (n + a)}) - χ(ℱ ⊗ ℒ^{⊗ n})` and `χ(ℱ ⊗ ℒ^{⊗ (n + a + 1)}) - χ(ℱ ⊗ ℒ^{⊗ n})` are
polynomials of degree `< d - 1` in `n`, hence so is `χ(ℱ ⊗ ℒ^{⊗ (n + 1)}) - χ(ℱ ⊗ ℒ^{⊗ n})`.

## Main statements

- `AlgebraicGeometry.Scheme.Modules.exists_generatingSections_tensorObj_tensorPow`: Serre's
  theorem A for an ample module: `ℱ ⊗ ℒ^{⊗ n}` is generated by global sections for `n ≫ 0`.
- `AlgebraicGeometry.Scheme.Modules.exists_forall_mem_compl_support_zeroLocus`: prime avoidance
  for sections of large powers of an ample module.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory TopologicalSpace

open scoped AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry.Scheme

section ClosedSubscheme

variable {X : Scheme.{u}}

/-- **`𝒪_X ⟶ (ι_J)_* 𝒪_{V(J)}` is an epimorphism**: on every affine open `V` it is the map
`Γ(X, V) ⟶ Γ(V(J), ι⁻¹ V)`, which is surjective since `ι` is a closed immersion. Hence
`0 ⟶ J ⟶ 𝒪_X ⟶ (ι_J)_* 𝒪_{V(J)} ⟶ 0` is short exact. -/
instance IdealSheafData.epi_toPushforwardSubscheme (J : X.IdealSheafData) :
    Epi J.toPushforwardSubscheme := by
  refine Modules.epi_of_forall_exists_app_eq _ fun W y x hx ↦ ?_
  obtain ⟨V, hV, hxV, hVW⟩ := exists_isAffineOpen_mem_and_subset (U := W) hx
  obtain ⟨z, hz⟩ := J.subschemeι.app_surjective V hV (J.subscheme.presheaf.map
    ((TopologicalSpace.Opens.map J.subschemeι.base).map (homOfLE hVW)).op y)
  exact ⟨V, hVW, hxV, z, hz⟩

/-- **The restriction of a module to a closed subscheme.** For a quasi-coherent ideal sheaf `J`
with closed subscheme `ι : D ⟶ X` and an invertible `𝒪_X`-module `M`, the cokernel of
`J ⊗ M ⟶ 𝒪_X ⊗ M` is `ι_* ι^* M`.

Tensoring with the invertible `M` is an equivalence, so it preserves the cokernel
`ι_* 𝒪_D` of `J ⟶ 𝒪_X`, and `ι_* 𝒪_D ⊗ M ≅ ι_* ι^* M` is the projection formula. -/
theorem IdealSheafData.nonempty_cokernel_whiskerRight_iso (J : X.IdealSheafData) (M : X.Modules)
    [M.IsInvertible] :
    Nonempty (cokernel (J.toModulesι ▷ M) ≅
      (Modules.pushforward J.subschemeι).obj ((Modules.pullback J.subschemeι).obj M)) := by
  let F := (BraidedCategory.tensorRightEquivalence M Mᵛ
    (Modules.nonempty_tensorObj_dual_iso_unit M).some).functor
  let e₁ : cokernel J.toModulesι ≅
      (Modules.pushforward J.subschemeι).obj (𝟙_ J.subscheme.Modules) :=
    (colimit.isColimit _).coconePointUniqueUpToIso
      (Abelian.epiIsCokernelOfKernel _ (kernelIsKernel J.toPushforwardSubscheme))
  let e₂ : cokernel (J.toModulesι ▷ M) ≅ F.obj (cokernel J.toModulesι) :=
    (PreservesCokernel.iso F J.toModulesι).symm
  obtain ⟨e₃⟩ := Modules.nonempty_pushforward_pullback_iso J.subschemeι M
  exact ⟨e₂ ≪≫ whiskerRightIso e₁ M ≪≫ e₃.symm⟩

variable (k : Type u) [Field k] [X.Over (Spec (.of k))]

/-- **The cohomology of the restriction of a module to a closed subscheme.** For a closed
subscheme `ι : D ⟶ X` of a `k`-scheme with ideal sheaf `J` and an invertible `M`, the cohomology
of the cokernel `M|_D` of `J ⊗ M ⟶ 𝒪_X ⊗ M` is that of `ι^* M` on `D`: `M|_D ≅ ι_* ι^* M`
(`AlgebraicGeometry.Scheme.IdealSheafData.nonempty_cokernel_whiskerRight_iso`), and pushforward
along the affine morphism `ι` does not change the cohomology of quasi-coherent modules. -/
theorem IdealSheafData.nonempty_H_cokernel_whiskerRight_linearEquiv (J : X.IdealSheafData)
    (M : X.Modules) [M.IsInvertible] (q : ℕ) :
    letI : J.subscheme.Over (Spec (.of k)) := ⟨J.subschemeι ≫ X ↘ Spec (.of k)⟩
    Nonempty ((cokernel (J.toModulesι ▷ M)).H q ≃ₗ[k]
      ((Modules.pullback J.subschemeι).obj M).H q) := by
  let : J.subscheme.Over (Spec (.of k)) := ⟨J.subschemeι ≫ X ↘ Spec (.of k)⟩
  have : J.subschemeι.IsOver (Spec (.of k)) := ⟨rfl⟩
  obtain ⟨e⟩ := J.nonempty_cokernel_whiskerRight_iso M
  obtain ⟨e'⟩ := Modules.nonempty_cohomologyFunctor_iso_pushforward_of_isAffineHom k
    J.subschemeι q
  exact ⟨((Modules.cohomologyFunctor k q).mapIso e).toLinearEquiv ≪≫ₗ
    (e'.app ⟨(Modules.pullback J.subschemeι).obj M, inferInstance⟩).toLinearEquiv.symm⟩

/-- The reduced closed subscheme on the closure of a point is integral. -/
instance IdealSheafData.isIntegral_subscheme_vanishingIdeal_closure (x : X) :
    IsIntegral (vanishingIdeal ⟨closure {x}, isClosed_closure⟩).subscheme := by
  set J := vanishingIdeal ⟨closure {x}, isClosed_closure⟩
  have hr : Set.range J.subschemeι = closure {x} := by
    rw [J.range_subschemeι]
    simp [J]
  have h := J.subschemeι.isClosedEmbedding.isEmbedding
  have hirr : IsIrreducible (Set.range J.subschemeι) := hr ▸ isIrreducible_singleton.closure
  have := Subtype.irreducibleSpace hirr
  have hu := (IrreducibleSpace.isIrreducible_univ (Set.range J.subschemeι)).image
    h.toHomeomorph.symm h.toHomeomorph.symm.continuous.continuousOn
  rw [Set.image_univ, h.toHomeomorph.symm.surjective.range_eq] at hu
  have := (irreducibleSpace_def _).mpr hu
  exact isIntegral_of_irreducibleSpace_of_isReduced _

/-- The reduced closed subscheme on the closure of a point has the dimension of that closure. -/
lemma IdealSheafData.topologicalKrullDim_subscheme_vanishingIdeal_closure (x : X) :
    topologicalKrullDim (vanishingIdeal ⟨closure {x}, isClosed_closure⟩).subscheme =
      topologicalKrullDim (closure {x} : Set X) := by
  set J := vanishingIdeal ⟨closure {x}, isClosed_closure⟩
  have hr : Set.range J.subschemeι = closure {x} := by
    rw [J.range_subschemeι]
    simp [J]
  rw [← hr]
  exact J.subschemeι.isClosedEmbedding.isEmbedding.topologicalKrullDim_eq_range

/-- **A section of a module over an integral scheme is injective if it is so generically.** If
`s : 𝒪_X ⟶ N` is an isomorphism on a nonempty open `V` of an integral scheme, then its kernel
vanishes: a function on an open `W` vanishing on the nonempty open `W ∩ V` is zero. -/
lemma Modules.isZero_kernel_of_isIntegral [IsIntegral X] {N : X.Modules} (s : 𝟙_ X.Modules ⟶ N)
    {V : X.Opens} (hV : (V : Set X).Nonempty) [IsIso ((Modules.restrictFunctor V.ι).map s)] :
    IsZero (kernel s) := by
  have hK := (Modules.isZero_restrict_iff _ V).mp (Modules.isZero_restrict_kernel_of_isIso s V)
  refine (Modules.isZero_iff_forall_subsingleton _).mpr fun W ↦
    ⟨fun a b ↦ Modules.injective_map_kernelι W s ?_⟩
  suffices h : ∀ c : Γ(kernel s, W), (kernel.ι s).app W c = 0 by
    change (kernel.ι s).app W a = (kernel.ι s).app W b
    rw [h a, h b]
  intro c
  by_cases hW : (W : Set X).Nonempty
  · obtain ⟨z, hzW, hzV⟩ := nonempty_preirreducible_inter W.isOpen V.isOpen hW hV
    have hc : (kernel s).presheaf.map (homOfLE (inf_le_left : W ⊓ V ≤ W)).op c = 0 :=
      (hK (W ⊓ V) inf_le_right).elim _ _
    have h₁ := Modules.Hom.app_presheaf_map (kernel.ι s) (homOfLE (inf_le_left : W ⊓ V ≤ W)) c
    rw [hc, map_zero] at h₁
    refine germ_injective_of_isIntegral X z hzW ?_
    rw [map_zero, ← X.presheaf.germ_res_apply (homOfLE (inf_le_left : W ⊓ V ≤ W)) z ⟨hzW, hzV⟩]
    erw [← h₁]
    exact map_zero _
  · have hW' : W = ⊥ := by
      ext y
      simpa using fun hy ↦ hW ⟨y, hy⟩
    subst hW'
    exact Subsingleton.elim (α := Γ(X, ⊥)) _ _

end ClosedSubscheme

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

section Restrict

/-- If `f` is an isomorphism on `U`, so is `f ⊗ N`, since restriction is monoidal. -/
lemma isIso_restrictFunctor_map_whiskerRight {M M' : X.Modules} (f : M ⟶ M') (N : X.Modules)
    {U : X.Opens} [IsIso ((restrictFunctor U.ι).map f)] :
    IsIso ((restrictFunctor U.ι).map (f ▷ N)) := by
  rw [NatIso.isIso_map_iff (restrictFunctorIsoPullback U.ι)] at *
  have h := Functor.LaxMonoidal.μ_natural_left (pullback U.ι) f N
  rw [(IsIso.eq_inv_comp _).mpr h.symm]
  infer_instance

/-- **Adding a section which vanishes where another does not.** If the section `s` of an
invertible module does not vanish at `x` and `t` does, then `s + t` does not vanish at `x`: near
`x`, the coefficient of `s` is a unit of the local ring and that of `t` is not. -/
lemma mem_compl_support_zeroLocus_add {N : X.Modules} [SheafOfModules.IsInvertible.{u, u, u} N]
    {s t : 𝟙_ X.Modules ⟶ N} {x : X} (hs : x ∈ (Hom.zeroLocus s).support.compl)
    (ht : x ∉ (Hom.zeroLocus t).support.compl) :
    x ∈ (Hom.zeroLocus (s + t)).support.compl := by
  obtain ⟨V, hxV, -, e, he⟩ := exists_isFreeGenerator N (x := x) (W := ⊤) trivial
  have h₁ := basicOpen_coeff_eq s V he
  have h₂ := basicOpen_coeff_eq t V he
  have h₃ := basicOpen_coeff_eq (s + t) V he
  have hs' : x ∈ X.basicOpen (he.coeff (s.app V.1 (unitSectionsEquiv _ 1))) := by
    rw [h₁]
    exact ⟨hxV, hs⟩
  have ht' : x ∉ X.basicOpen (he.coeff (t.app V.1 (unitSectionsEquiv _ 1))) := by
    rw [h₂]
    exact fun h ↦ ht h.2
  suffices x ∈ X.basicOpen (he.coeff ((s + t).app V.1 (unitSectionsEquiv _ 1))) by
    rw [h₃] at this
    exact this.2
  rw [Hom.add_app, AddCommGrpCat.hom_add_apply, he.coeff_add]
  rw [Scheme.mem_basicOpen _ _ _ hxV] at hs' ht' ⊢
  rw [map_add]
  set a := X.presheaf.germ V.1 x hxV (he.coeff (s.app V.1 (unitSectionsEquiv _ 1)))
  set b := X.presheaf.germ V.1 x hxV (he.coeff (t.app V.1 (unitSectionsEquiv _ 1)))
  have := IsLocalRing.isUnit_or_isUnit_of_isUnit_add (a := a + b) (b := -b) (by simpa using hs')
  exact this.resolve_right fun h ↦ ht' (by simpa using h)

end Restrict

/-- The ideal sheaf of a closed subset of a locally Noetherian scheme is coherent. -/
lemma isQuasicoherent_toModules (J : X.IdealSheafData) :
    SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) J.toModules := by
  have := SheafOfModules.isQuasicoherent_unit (R := J.subscheme.ringCatSheaf)
  have := SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
  have h := isQuasicoherent_pushforward_of_isClosedImmersion J.subschemeι
    (SheafOfModules.unit J.subscheme.ringCatSheaf)
  have : SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf)
      ((SheafOfModules.pushforward J.subschemeι.toRingCatSheafHom).obj
        (SheafOfModules.unit J.subscheme.ringCatSheaf)) := h
  exact isQuasicoherent_kernel J.toPushforwardSubscheme

/-- The ideal sheaf of a closed subset of a locally Noetherian scheme is of finite
presentation. -/
lemma isFinitePresentation_toModules [IsLocallyNoetherian X] (J : X.IdealSheafData) :
    SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) J.toModules := by
  have := SheafOfModules.isQuasicoherent_unit (R := J.subscheme.ringCatSheaf)
  have h := isQuasicoherent_pushforward_of_isClosedImmersion J.subschemeι
    (SheafOfModules.unit J.subscheme.ringCatSheaf)
  have : SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf)
      ((SheafOfModules.pushforward J.subschemeι.toRingCatSheafHom).obj
        (SheafOfModules.unit J.subscheme.ringCatSheaf)) := h
  have := IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  exact isFinitePresentation_kernel J.toPushforwardSubscheme


section Tensor

/-- Tensoring with an invertible module is an autoequivalence. -/
lemma isEquivalence_tensorRight (P : X.Modules) [P.IsInvertible] :
    (tensorRight P).IsEquivalence :=
  (BraidedCategory.tensorRightEquivalence P Pᵛ
    (nonempty_tensorObj_dual_iso_unit P).some).isEquivalence_functor

/-- A module vanishing on `U` stays zero on `U` after tensoring with an invertible module. -/
lemma isZero_restrict_tensorObj {M : X.Modules} (N : X.Modules) [N.IsInvertible] {U : X.Opens}
    (h : IsZero (M.restrict U.ι)) : IsZero ((M ⊗ N).restrict U.ι) := by
  have h₁ : IsZero ((pullback U.ι).obj M) :=
    h.of_iso ((restrictFunctorIsoPullback U.ι).app M).symm
  have := isEquivalence_tensorRight ((pullback U.ι).obj N)
  have h₂ : IsZero ((pullback U.ι).obj M ⊗ (pullback U.ι).obj N) :=
    (tensorRight ((pullback U.ι).obj N)).map_isZero h₁
  exact (h₂.of_iso (Functor.Monoidal.μIso (pullback U.ι) M N).symm).of_iso
    ((restrictFunctorIsoPullback U.ι).app _)

end Tensor

section EulerChar

variable (K : Type u) [Field K] [X.Over (Spec (.of K))] [IsProper (X ↘ Spec (.of K))]

include K in
/-- A proper scheme over a field is Noetherian. -/
lemma isNoetherian_of_isProper : IsNoetherian X := by
  have := LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of K))
  have := QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of K))
  exact {}

include K in
/-- On a proper scheme over a field all cohomology vanishes above some degree, by Grothendieck
vanishing. -/
lemma exists_forall_subsingleton_H :
    ∃ D : ℕ, ∀ (M : X.Modules) (q : ℕ), D < q → Subsingleton (M.H q) := by
  have := isNoetherian_of_isProper K (X := X)
  obtain ⟨d, hd⟩ := exists_topologicalKrullDim_le (X ↘ Spec (.of K))
  exact ⟨d, fun M q hq ↦ subsingleton_H_of_topologicalKrullDim_lt M
    (hd.trans_lt (by exact_mod_cast hq))⟩

omit [IsProper (X ↘ Spec (.of K))] in
/-- The Euler characteristic of the zero module is zero. -/
lemma eulerChar_eq_zero_of_isZero {M : X.Modules} (h : IsZero M) : M.eulerChar K = 0 := by
  have (q : ℕ) : M.finrankH K q = 0 := by
    have := subsingleton_H_of_isZero h q
    exact Module.finrank_zero_of_subsingleton
  simp [eulerChar, this]

/-- **The Euler characteristic of a four-term exact sequence.** For a morphism `φ : M ⟶ N` of
coherent modules on a proper scheme over a field,
`χ(N) - χ(M) = χ(coker φ) - χ(ker φ)`, by additivity of `χ` on
`0 ⟶ ker φ ⟶ M ⟶ coim φ ⟶ 0` and `0 ⟶ im φ ⟶ N ⟶ coker φ ⟶ 0`. -/
theorem eulerChar_sub_eulerChar_eq {M N : X.Modules}
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M]
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) N]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) N] (φ : M ⟶ N) :
    N.eulerChar K - M.eulerChar K = (cokernel φ).eulerChar K - (kernel φ).eulerChar K := by
  have := isNoetherian_of_isProper K (X := X)
  have : IsSeparated (terminal.from X) := by
    rw [← terminal.comp_from (X ↘ Spec (.of K))]
    infer_instance
  obtain ⟨D, hD⟩ := exists_forall_subsingleton_H_of_isQuasicoherent (X := X)
  have := isQuasicoherent_kernel φ
  have := isFinitePresentation_kernel φ
  have := isQuasicoherent_cokernel φ
  have := isFinitePresentation_cokernel φ
  have := isQuasicoherent_cokernel (kernel.ι φ)
  have := isFinitePresentation_cokernel (kernel.ι φ)
  have := isQuasicoherent_kernel (cokernel.π φ)
  have := isFinitePresentation_kernel (cokernel.π φ)
  let S₁ := ShortComplex.mk (kernel.ι φ) (cokernel.π (kernel.ι φ)) (cokernel.condition _)
  have hS₁ : S₁.ShortExact := .mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  let S₂ := ShortComplex.mk (kernel.ι (cokernel.π φ)) (cokernel.π φ) (kernel.condition _)
  have hS₂ : S₂.ShortExact := .mk' (ShortComplex.exact_kernel _) inferInstance inferInstance
  have i₁ : ∀ q, FiniteDimensional K (S₁.X₁.H q) := finiteDimensional_H_of_isProper (kernel φ)
  have i₂ : ∀ q, FiniteDimensional K (S₁.X₂.H q) := finiteDimensional_H_of_isProper M
  have i₃ : ∀ q, FiniteDimensional K (S₁.X₃.H q) :=
    finiteDimensional_H_of_isProper (cokernel (kernel.ι φ))
  have j₁ : ∀ q, FiniteDimensional K (S₂.X₁.H q) :=
    finiteDimensional_H_of_isProper (kernel (cokernel.π φ))
  have j₂ : ∀ q, FiniteDimensional K (S₂.X₂.H q) := finiteDimensional_H_of_isProper N
  have j₃ : ∀ q, FiniteDimensional K (S₂.X₃.H q) := finiteDimensional_H_of_isProper (cokernel φ)
  have h₁ := eulerChar_eq_add_of_shortExact K hS₁ D (hD (kernel φ)) (hD M)
    (hD (cokernel (kernel.ι φ)))
  have h₂ := eulerChar_eq_add_of_shortExact K hS₂ D (hD (kernel (cokernel.π φ))) (hD N)
    (hD (cokernel φ))
  have h₃ := eulerChar_congr K (Abelian.coimageIsoImage φ)
  change M.eulerChar K = (kernel φ).eulerChar K + (cokernel (kernel.ι φ)).eulerChar K at h₁
  change N.eulerChar K = (kernel (cokernel.π φ)).eulerChar K + (cokernel φ).eulerChar K at h₂
  change (cokernel (kernel.ι φ)).eulerChar K = (kernel (cokernel.π φ)).eulerChar K at h₃
  linarith

/-- The four-term identity of `AlgebraicGeometry.Scheme.Modules.eulerChar_sub_eulerChar_eq`
twisted by an invertible module `P`: `χ(N ⊗ P) - χ(M ⊗ P) = χ(coker φ ⊗ P) - χ(ker φ ⊗ P)`,
since tensoring with `P` is exact. -/
theorem eulerChar_tensorObj_sub_eulerChar_tensorObj_eq {M N : X.Modules}
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M]
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) N]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) N] (φ : M ⟶ N)
    (P : X.Modules) [P.IsInvertible] :
    (N ⊗ P).eulerChar K - (M ⊗ P).eulerChar K =
      (cokernel φ ⊗ P).eulerChar K - (kernel φ ⊗ P).eulerChar K := by
  have := isQuasicoherent_tensorObj M P
  have := isFinitePresentation_tensorObj M P
  have := isQuasicoherent_tensorObj N P
  have := isFinitePresentation_tensorObj N P
  have := isEquivalence_tensorRight P
  have e₁ : (kernel (φ ▷ P)).eulerChar K = (kernel φ ⊗ P).eulerChar K :=
    eulerChar_congr K (PreservesKernel.iso (tensorRight P) φ).symm
  have e₂ : (cokernel (φ ▷ P)).eulerChar K = (cokernel φ ⊗ P).eulerChar K :=
    eulerChar_congr K (PreservesCokernel.iso (tensorRight P) φ).symm
  rw [eulerChar_sub_eulerChar_eq K (φ ▷ P), e₁, e₂]

omit [IsProper (X ↘ Spec (.of K))] in
attribute [local instance] Abelian.hasFiniteBiproducts in
/-- **The Euler characteristic of a free module.** `χ(𝒪_X^{⊕ r} ⊗ N) = r χ(N)` for `N`
invertible: the cohomology of a finite direct sum is the direct sum of the cohomologies. -/
theorem eulerChar_free_tensorObj (r : ℕ) (N : X.Modules) [N.IsInvertible]
    [∀ q, FiniteDimensional K (N.H q)] :
    (SheafOfModules.free (R := X.ringCatSheaf) (ULift.{u} (Fin r)) ⊗ₘ N).eulerChar K =
      r * N.eulerChar K := by
  have := isEquivalence_tensorRight N
  let e : SheafOfModules.free (R := X.ringCatSheaf) (ULift.{u} (Fin r)) ⊗ₘ N ≅
      ⨁ fun _ : ULift.{u} (Fin r) ↦ N :=
    PreservesCoproduct.iso (tensorRight N) _ ≪≫
      Sigma.mapIso (fun _ ↦ λ_ N) ≪≫ (biproduct.isoCoproduct _).symm
  have h (q : ℕ) : (SheafOfModules.free (R := X.ringCatSheaf) (ULift.{u} (Fin r)) ⊗ₘ
      N).finrankH K q = r * N.finrankH K q := by
    rw [finrankH_congr K e q, finrankH_of_isBilimit K (biproduct.isBilimit _) q]
    simp
  unfold eulerChar
  rw [mul_finsum]
  congr 1
  funext q
  rw [h q]
  push_cast
  ring

end EulerChar

/-- A morphism `σ : 𝒪_X ⟶ N` sending `1` to `0` is zero. -/
lemma eq_zero_of_app_top_one {Y : Scheme.{u}} {N : Y.Modules} (σ : 𝟙_ Y.Modules ⟶ N)
    (h : σ.app ⊤ (unitSectionsEquiv ⊤ 1) = 0) : σ = 0 := by
  refine hom_ext _ _ fun U ↦ ?_
  ext r
  obtain ⟨a, rfl⟩ := ((isFreeGenerator_one (X := Y) ⊤).map (le_top : U ≤ ⊤)).exists_smul_eq r
  rw [Hom.app_smul]
  erw [Hom.app_presheaf_map σ (homOfLE (le_top : U ≤ ⊤)) (1 : Γ(Y, ⊤))]
  erw [h]
  simp

section ClearDenominators

variable {S : Scheme.{u}} (f : X ⟶ S) [IsSeparated f] [IsAffine S] [CompactSpace X]
  {L : X.Modules} [L.IsInvertible] (s : 𝟙_ X.Modules ⟶ L)

include f in
/-- **Clearing denominators for all large powers.** A section `b` of a quasi-coherent `F` over
the non-vanishing locus `X_s` of `s` satisfies: for all `m ≫ 0`, `b ⊗ s^m` extends to a global
section of `F ⊗ ℒ^{⊗ m}`, compatibly with restriction to every open `W ⊆ X_s`. -/
theorem exists_forall_ge_presheaf_map_eq (F : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) F]
    (b : Γ(F, (Hom.zeroLocus s).support.compl)) :
    ∃ m₀ : ℕ, ∀ m ≥ m₀, ∃ u : Γ(F ⊗ L.tensorPow m, ⊤), ∀ (W : X.Opens)
      (hW : W ≤ (Hom.zeroLocus s).support.compl),
      (F ⊗ L.tensorPow m).presheaf.map (homOfLE le_top).op u =
        ((ρ_ F).inv ≫ F ◁ tensorPowSection s m).app W (F.presheaf.map (homOfLE hW).op b) := by
  have := IsInvertible.sheafOfModules_isInvertible L
  obtain ⟨m₀, u₀, hu₀⟩ := exists_tensorPowSection_eq_restrict f L s F b
  refine ⟨m₀, fun m hm ↦ ?_⟩
  have hm' : m₀ + (m - m₀) = m := Nat.add_sub_cancel' hm
  let g := mulTensorPowSection s F m₀ (m - m₀) ≫ F ◁ eqToHom (congrArg L.tensorPow hm')
  refine ⟨g.app ⊤ u₀, fun W hW ↦ ?_⟩
  rw [← Hom.app_presheaf_map, ← presheaf_map_homOfLE_homOfLE (le_top : _ ≤ ⊤) hW, hu₀,
    ← Hom.app_presheaf_map, rightUnitor_inv_comp_whiskerLeft_app,
    rightUnitor_inv_comp_whiskerLeft_app, Hom.comp_app, ConcreteCategory.comp_apply,
    mulTensorPowSection_app_tmulSection]
  erw [whiskerLeft_app_tmulSection, eqToHom_app_tensorPowSectionOne s hm']

include f in
/-- **A local basis extends after twisting.** Let `ε` identify the restrictions of a free
module `𝒪_X^{(I)}`, `I` finite, and of a quasi-coherent `F` to the non-vanishing locus `X_s`.
Then for some `m` there is a morphism `φ : 𝒪_X^{(I)} ⟶ F ⊗ ℒ^{⊗ m}` which is an isomorphism on
`X_s`: it is `ε` followed by multiplication by `s^m` there, and it exists by clearing
denominators. -/
theorem exists_hom_free_isIso_restrictFunctor_map (F : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) F] {I : Type u} [Finite I]
    (ε : (restrictFunctor (Scheme.Opens.ι (Hom.zeroLocus s).support.compl)).obj
        (SheafOfModules.free (R := X.ringCatSheaf) I) ≅
      (restrictFunctor (Scheme.Opens.ι (Hom.zeroLocus s).support.compl)).obj F) :
    ∃ (m : ℕ) (φ : SheafOfModules.free (R := X.ringCatSheaf) I ⟶ F ⊗ₘ L.tensorPow m),
      IsIso ((restrictFunctor (Scheme.Opens.ι (Hom.zeroLocus s).support.compl)).map φ) := by
  classical
  have := Fintype.ofFinite I
  have := IsInvertible.sheafOfModules_isInvertible L
  set V : X.Opens := (Hom.zeroLocus s).support.compl
  have hle : V ≤ V.ι ''ᵁ ⊤ := by simp
  have hle' : V.ι ''ᵁ ⊤ ≤ V := by simp
  let β (i : I) : Γ(F, V.ι ''ᵁ ⊤) := Hom.app ((restrictUnitIso V.ι).inv ≫
    (restrictFunctor V.ι).map (SheafOfModules.ιFree i) ≫ ε.hom) ⊤ (1 : Γ(V.toScheme, ⊤))
  choose m₀ hm₀ using fun i ↦ exists_forall_ge_presheaf_map_eq f s F
    (F.presheaf.map (homOfLE hle).op (β i))
  set m := max 1 (Finset.univ.sup m₀)
  choose u hu using fun i ↦ hm₀ i m
    ((Finset.le_sup (Finset.mem_univ i)).trans (le_max_right _ _))
  let c : F ⟶ F ⊗ L.tensorPow m := (ρ_ F).inv ≫ F ◁ tensorPowSection s m
  let φ : SheafOfModules.free (R := X.ringCatSheaf) I ⟶ F ⊗ₘ L.tensorPow m :=
    Sigma.desc fun i ↦ homOfGlobalSection _ (u i)
  refine ⟨m, φ, ?_⟩
  have hc : IsIso ((restrictFunctor V.ι).map c) := by
    have : SheafOfModules.IsInvertible.{u, u, u} (L.tensorPow m) :=
      IsInvertible.sheafOfModules_isInvertible _
    have : IsIso ((restrictFunctor V.ι).map (tensorPowSection s m)) := by
      refine isIso_restrictFunctor_map_of_le _ ?_
      rw [compl_support_zeroLocus_tensorPowSection L s (by omega : 0 < m)]
    have := isIso_restrictFunctor_map_whiskerLeft (tensorPowSection s m) F (U := V)
    rw [Functor.map_comp]
    infer_instance
  suffices h : (restrictFunctor V.ι).map φ = ε.hom ≫ (restrictFunctor V.ι).map c by
    rw [h]
    infer_instance
  refine (isColimitOfPreserves (restrictFunctor V.ι)
    (SheafOfModules.isColimitFreeCofan I)).hom_ext fun ⟨i⟩ ↦ ?_
  change (restrictFunctor V.ι).map (SheafOfModules.ιFree i) ≫ _ =
    (restrictFunctor V.ι).map (SheafOfModules.ιFree i) ≫ _
  rw [← Functor.map_comp, show SheafOfModules.ιFree i ≫ φ = homOfGlobalSection _ (u i) from
    Sigma.ι_desc _ _, ← cancel_epi (restrictUnitIso V.ι).inv]
  rw [← sub_eq_zero, ← Preadditive.comp_sub]
  refine eq_zero_of_app_top_one _ ?_
  rw [Preadditive.comp_sub, Hom.sub_app]
  refine sub_eq_zero.mpr ?_
  have h₁ := hu i (V.ι ''ᵁ ⊤) hle'
  have hβ : F.presheaf.map (homOfLE hle').op (F.presheaf.map (homOfLE hle).op (β i)) = β i := by
    rw [presheaf_map_homOfLE_homOfLE]
    exact presheaf_map_id_apply _ _
  rw [hβ] at h₁
  have hA : Hom.app ((restrictUnitIso V.ι).inv ≫
      (restrictFunctor V.ι).map (homOfGlobalSection _ (u i))) ⊤ (1 : Γ(V.toScheme, ⊤)) =
      (F ⊗ L.tensorPow m).presheaf.map (homOfLE le_top).op (u i) := by
    rw [Hom.comp_app, ConcreteCategory.comp_apply]
    exact (congrArg (Hom.app (homOfGlobalSection _ (u i)) (V.ι ''ᵁ ⊤))
      (map_one (V.ι.appIso ⊤).inv.hom)).trans (homOfGlobalSection_app_one _ _ _)
  have hB : Hom.app ((restrictUnitIso V.ι).inv ≫ (restrictFunctor V.ι).map
      (SheafOfModules.ιFree i) ≫ ε.hom ≫ (restrictFunctor V.ι).map c) ⊤ (1 : Γ(V.toScheme, ⊤)) =
      c.app (V.ι ''ᵁ ⊤) (β i) := by
    rw [← Category.assoc, ← Category.assoc, Hom.comp_app, ConcreteCategory.comp_apply]
    rfl
  exact hA.trans (h₁.trans hB.symm)

end ClearDenominators

section Ample

variable {K : Type u} [Field K] (f : X ⟶ Spec (.of K)) {ℒ : X.Modules} (hℒ : IsAmple f ℒ)
include hℒ

/-- **Serre's theorem A for an ample module.** Let `ℒ` be ample and `ℱ` coherent. Then
`ℱ ⊗ ℒ^{⊗ n}` is generated by its global sections for all `n ≫ 0`.

Some power `ℒ^{⊗ m}`, `m ≥ 1`, is `i^* 𝒪(1)` for a closed immersion `i : X ⟶ ℙᴺ_K`. For each of
the finitely many `0 ≤ r < m`, Serre's theorem A for projective space
(`AlgebraicGeometry.Scheme.Modules.exists_generatingSections_tensor_twist`) applied to
`ℱ ⊗ ℒ^{⊗ r}` gives `t_r` such that `ℱ ⊗ ℒ^{⊗ (m t + r)} ≅ ℱ ⊗ ℒ^{⊗ r} ⊗ 𝒪_X(t)` is generated
by global sections for `t ≥ t_r`. -/
theorem exists_generatingSections_tensorObj_tensorPow (ℱ : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, Nonempty (SheafOfModules.GeneratingSections (ℱ ⊗ₘ ℒ.tensorPow n)) := by
  obtain ⟨hinv, m, hm, N, i, hN, hi, -, ⟨e⟩⟩ := hℒ
  have key (r : Fin m) : ∃ t₀ : ℕ, ∀ t ≥ t₀, Nonempty (SheafOfModules.GeneratingSections
      ((ℱ ⊗ ℒ.tensorPow r) ⊗ₘ ProjectiveSpace.twistRestrict i t)) := by
    have := isQuasicoherent_tensorObj ℱ (ℒ.tensorPow r)
    have := isFinitePresentation_tensorObj ℱ (ℒ.tensorPow r)
    obtain ⟨m₀, h⟩ := exists_generatingSections_tensor_twist K i (ℱ ⊗ ℒ.tensorPow r)
    exact ⟨m₀.toNat, fun t ht ↦ h t (by omega)⟩
  choose t₀ ht₀ using key
  refine ⟨m * ∑ r, t₀ r, fun n hn ↦ ?_⟩
  set r : Fin m := ⟨n % m, Nat.mod_lt n hm⟩
  set t := n / m
  have hn' : n = r + m * t := (Nat.mod_add_div n m).symm
  have ht : t₀ r ≤ t := by
    refine le_trans (Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ r)) ?_
    exact (Nat.le_div_iff_mul_le hm).2 (by rw [mul_comm]; exact hn)
  have hpow : ∀ s : ℕ, Nonempty ((ℒ.tensorPow m).tensorPow s ≅
      (ProjectiveSpace.twistRestrict i 1).tensorPow s) := by
    intro s
    induction s with
    | zero => exact ⟨Iso.refl _⟩
    | succ s ih => exact ⟨e.symm ⊗ᵢ ih.some⟩
  obtain ⟨e₁⟩ := Scheme.Modules.nonempty_pullback_tensorPow_iso i
    (ProjectiveSpace.twist N (Spec (.of K)) 1) t
  obtain ⟨e₂⟩ := ProjectiveSpace.nonempty_tensorPow_twist_one_iso N (Spec (.of K)) t
  let e₃ : ℒ.tensorPow n ≅ ℒ.tensorPow r ⊗ ProjectiveSpace.twistRestrict i t :=
    eqToIso (congrArg ℒ.tensorPow hn') ≪≫ ℒ.tensorPowAddIso r (m * t) ≪≫
      (Iso.refl _ ⊗ᵢ (ℒ.tensorPowMulIso m t ≪≫ (hpow t).some ≪≫ e₁.symm ≪≫
        (Scheme.Modules.pullback i).mapIso e₂))
  let e₄ : (ℱ ⊗ ℒ.tensorPow r) ⊗ ProjectiveSpace.twistRestrict i t ≅ ℱ ⊗ ℒ.tensorPow n :=
    (α_ _ _ _) ≪≫ (Iso.refl ℱ ⊗ᵢ e₃.symm)
  obtain ⟨σ⟩ := ht₀ r t ht
  exact ⟨(SheafOfModules.GeneratingSections.equivOfIso e₄) σ⟩

/-- **Sections vanishing on a closed subset but not at a point.** Let `ℒ` be ample on a locally
Noetherian `X`, `J` an ideal sheaf and `x` a point outside its support. For all `n ≫ 0` there is
a section `σ` of `J ⊗ ℒ^{⊗ n}` whose image in `ℒ^{⊗ n}` does not vanish at `x`: by Serre's
theorem A, `J ⊗ ℒ^{⊗ n}` is generated by global sections, and away from the support of `J` it
is `ℒ^{⊗ n}`. -/
theorem exists_mem_compl_support_zeroLocus_comp_toModulesι [IsLocallyNoetherian X]
    (J : X.IdealSheafData) {x : X} (hx : x ∉ (J.support : Set X)) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∃ σ : 𝟙_ X.Modules ⟶ J.toModules ⊗ ℒ.tensorPow n,
      x ∈ (Hom.zeroLocus (σ ≫ J.toModulesι ▷ ℒ.tensorPow n ≫ (λ_ _).hom)).support.compl := by
  have := hℒ.isInvertible
  have := isQuasicoherent_toModules J
  have := isFinitePresentation_toModules J
  obtain ⟨n₀, hn₀⟩ := exists_generatingSections_tensorObj_tensorPow f hℒ J.toModules
  refine ⟨n₀, fun n hn ↦ ?_⟩
  obtain ⟨σ⟩ := hn₀ n hn
  have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow n) :=
    IsInvertible.sheafOfModules_isInvertible _
  let U : X.Opens := J.support.compl
  let g : J.toModules ⊗ ℒ.tensorPow n ⟶ ℒ.tensorPow n :=
    J.toModulesι ▷ ℒ.tensorPow n ≫ (λ_ _).hom
  have hepi : Epi ((restrictFunctor U.ι).map (σ.π ≫ g)) := by
    have : IsIso ((restrictFunctor U.ι).map J.toModulesι) :=
      J.isIso_restrictFunctor_map_toModulesι (U := U) fun _ h ↦ h
    have := isIso_restrictFunctor_map_whiskerRight J.toModulesι (ℒ.tensorPow n) (U := U)
    have : Epi σ.π := σ.epi
    have h₁ : Epi ((restrictFunctor U.ι).map σ.π) := Functor.map_epi _ _
    rw [Functor.map_comp, Functor.map_comp]
    exact epi_comp' h₁ (epi_comp' inferInstance inferInstance)
  obtain ⟨i, hi⟩ := exists_generatesAt_of_epi (σ.π ≫ g) (x := x) hx hepi
  refine ⟨SheafOfModules.ιFree (R := X.ringCatSheaf) i ≫ σ.π, ?_⟩
  have := (generatesAt_iff_mem_compl_support _ x).mp hi
  simpa only [g, Category.assoc] using this

/-- **Prime avoidance for an ample module.** Let `S` be a finite set of points of a locally
Noetherian scheme `X`, no two of which specialize to each other, and `ℒ` ample. Then for all
`n ≫ 0` there is a global section of `ℒ^{⊗ n}` vanishing at no point of `S`.

By induction on `S`: given such sections `s` for `S` and a new point `x`, let `T` be the closure
of `S`, which does not contain `x`, and `J` its ideal sheaf. For `n ≫ 0` the module
`J ⊗ ℒ^{⊗ n}` is generated by global sections (Serre's theorem A); near `x` it is `ℒ^{⊗ n}`, so
the image `t` in `ℒ^{⊗ n}` of one of them does not vanish at `x`, while `t` vanishes on `T`.
Then `s` or `s + t` vanishes at no point of `S ∪ {x}`. -/
theorem exists_forall_mem_compl_support_zeroLocus [IsLocallyNoetherian X] (S : Finset X)
    (hS : ∀ x ∈ S, ∀ y ∈ S, x ⤳ y → x = y) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∃ s : 𝟙_ X.Modules ⟶ ℒ.tensorPow n,
      ∀ x ∈ S, x ∈ (Hom.zeroLocus s).support.compl := by
  classical
  have := hℒ.isInvertible
  induction S using Finset.induction_on with
  | empty => exact ⟨0, fun n _ ↦ ⟨0, by simp⟩⟩
  | insert x S hxS ih =>
    obtain ⟨n₁, hn₁⟩ := ih fun a ha b hb hab ↦
      hS a (Finset.mem_insert_of_mem ha) b (Finset.mem_insert_of_mem hb) hab
    let T : Closeds X := ⟨closure (S : Set X), isClosed_closure⟩
    let U : X.Opens := T.compl
    have hxT : x ∈ U := by
      change x ∉ closure (S : Set X)
      rw [← Set.biUnion_of_singleton (S : Set X), S.finite_toSet.closure_biUnion]
      simp only [Set.mem_iUnion, not_exists]
      intro y hy hxy
      rw [← specializes_iff_mem_closure] at hxy
      exact hxS ((hS y (Finset.mem_insert_of_mem hy) x (Finset.mem_insert_self x S) hxy) ▸ hy)
    let J := IdealSheafData.vanishingIdeal T
    have := isQuasicoherent_toModules J
    have := isFinitePresentation_toModules J
    obtain ⟨n₂, hn₂⟩ := exists_generatingSections_tensorObj_tensorPow f hℒ J.toModules
    refine ⟨max n₁ n₂, fun n hn ↦ ?_⟩
    obtain ⟨s, hs⟩ := hn₁ n (le_of_max_le_left hn)
    obtain ⟨σ⟩ := hn₂ n (le_of_max_le_right hn)
    have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow n) :=
      IsInvertible.sheafOfModules_isInvertible _
    let g : J.toModules ⊗ ℒ.tensorPow n ⟶ ℒ.tensorPow n :=
      J.toModulesι ▷ ℒ.tensorPow n ≫ (λ_ _).hom
    have hepi : Epi ((restrictFunctor U.ι).map (σ.π ≫ g)) := by
      have : IsIso ((restrictFunctor U.ι).map J.toModulesι) :=
        J.isIso_restrictFunctor_map_toModulesι (U := U)
          (by simp only [J, IdealSheafData.coe_support_vanishingIdeal]; exact fun _ h ↦ h)
      have := isIso_restrictFunctor_map_whiskerRight J.toModulesι (ℒ.tensorPow n)
        (U := U)
      have : Epi σ.π := σ.epi
      have h₁ : Epi ((restrictFunctor U.ι).map σ.π) := Functor.map_epi _ _
      rw [Functor.map_comp, Functor.map_comp]
      exact epi_comp' h₁ (epi_comp' inferInstance inferInstance)
    obtain ⟨i, hi⟩ := exists_generatesAt_of_epi (σ.π ≫ g) hxT hepi
    set t := SheafOfModules.ιFree (R := X.ringCatSheaf) i ≫ σ.π ≫ g
    replace hi := (generatesAt_iff_mem_compl_support t x).mp hi
    have hvan (y : X) (hy : y ∈ S) : y ∉ (Hom.zeroLocus t).support.compl := fun h ↦ by
      refine not_generatesAt_of_factors J (SheafOfModules.ιFree (R := X.ringCatSheaf) i ≫ σ.π)
        (y := y) (by simpa [J, T] using subset_closure hy) ?_
      exact (generatesAt_iff_mem_compl_support _ y).mpr
        (by simpa only [t, g, Category.assoc] using h)
    by_cases hxs : x ∈ (Hom.zeroLocus s).support.compl
    · refine ⟨s, fun y hy ↦ ?_⟩
      rcases Finset.mem_insert.mp hy with rfl | hy
      · exact hxs
      · exact hs y hy
    · refine ⟨s + t, fun y hy ↦ ?_⟩
      rcases Finset.mem_insert.mp hy with rfl | hy
      · rw [add_comm]
        exact mem_compl_support_zeroLocus_add hi hxs
      · exact mem_compl_support_zeroLocus_add (hs y hy) (hvan y hy)

end Ample

section Polynomial

variable (K : Type u) [Field K] [X.Over (Spec (.of K))] [IsProper (X ↘ Spec (.of K))]
  {ℒ : X.Modules}

/-- **The Hilbert polynomial of a coherent module.** Let `X` be proper over a field `K`, `ℒ` an
ample invertible module and `ℱ` a coherent module vanishing on an open `U` whose complement `Z` has
dimension `< d`. Then `n ↦ χ(X, ℱ ⊗ ℒ^{⊗ n})` is given by a polynomial of degree `< d`.

By induction on `d`. If `d = 0` then `Z` is empty, so `ℱ = 0`. Otherwise, prime avoidance
(`AlgebraicGeometry.Scheme.Modules.exists_forall_mem_compl_support_zeroLocus`) gives sections `s`
of `ℒ^{⊗ a}` and of `ℒ^{⊗ (a + 1)}` not vanishing at the generic points of the irreducible
components of `Z`. The kernel and cokernel of `ℱ ⟶ ℱ ⊗ ℒ^{⊗ b}` given by `s` vanish outside
`Z ∩ V(s)`, which has dimension `< d - 1`, so by induction and
`AlgebraicGeometry.Scheme.Modules.eulerChar_tensorObj_sub_eulerChar_tensorObj_eq` the differences
`χ(ℱ ⊗ ℒ^{⊗ (n + b)}) - χ(ℱ ⊗ ℒ^{⊗ n})` are polynomials of degree `< d - 1` for `b = a, a + 1`;
hence so is `χ(ℱ ⊗ ℒ^{⊗ (n + 1)}) - χ(ℱ ⊗ ℒ^{⊗ n})`. -/
theorem exists_polynomial_eulerChar_tensorObj_tensorPow (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ)
    (d : ℕ) (U : X.Opens) (hU : topologicalKrullDim ((U : Set X)ᶜ : Set X) < d)
    (ℱ : X.Modules) [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ]
    (hℱ : IsZero (ℱ.restrict U.ι)) :
    ∃ P : Polynomial ℚ, P.degree < d ∧
      ∀ n : ℕ, P.eval (n : ℚ) = (ℱ ⊗ ℒ.tensorPow n).eulerChar K := by
  have := hℒ.isInvertible
  have := isNoetherian_of_isProper K (X := X)
  induction d generalizing U ℱ with
  | zero =>
    have hUe : ((U : Set X)ᶜ : Set X) = ∅ := by
      by_contra h
      obtain ⟨z, hz⟩ := Set.nonempty_iff_ne_empty.mpr h
      have : Nonempty (IrreducibleCloseds ((U : Set X)ᶜ : Set X)) :=
        ⟨⟨closure {⟨z, hz⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      exact (not_lt.mpr (Order.krullDim_nonneg (α := IrreducibleCloseds ((U : Set X)ᶜ : Set X))))
        (by exact_mod_cast hU)
    have hUt : U = ⊤ := by
      ext x
      simpa using fun h ↦ (Set.eq_empty_iff_forall_notMem.mp hUe x h)
    subst hUt
    have hℱ' : IsZero ℱ := isZero_of_isZero_restrict_top hℱ
    refine ⟨0, by simp, fun n ↦ ?_⟩
    have := isEquivalence_tensorRight (ℒ.tensorPow n)
    have h₀ : IsZero (ℱ ⊗ ℒ.tensorPow n) := (tensorRight (ℒ.tensorPow n)).map_isZero hℱ'
    rw [eulerChar_eq_zero_of_isZero K h₀]
    simp
  | succ d ih =>
    have hUd : topologicalKrullDim ((U : Set X)ᶜ : Set X) < d + 1 := by exact_mod_cast hU
    have hZ : IsClosed ((U : Set X)ᶜ) := U.isOpen.isClosed_compl
    let S := hZ.finite_setOf_maximal_specializes.toFinset
    have hS : ∀ x ∈ S, ∀ y ∈ S, x ⤳ y → x = y := fun x hx y hy hxy ↦ by
      simp only [S, Set.Finite.mem_toFinset] at hx hy
      exact hy.2 x hx.1 hxy
    obtain ⟨n₀, hn₀⟩ := exists_forall_mem_compl_support_zeroLocus (X ↘ Spec (.of K)) hℒ S hS
    have step (b : ℕ) (hb : n₀ ≤ b) : ∃ Q : Polynomial ℚ, Q.degree < d ∧ ∀ n : ℕ,
        ((ℱ ⊗ ℒ.tensorPow (n + b)).eulerChar K : ℚ) - (ℱ ⊗ ℒ.tensorPow n).eulerChar K =
          Q.eval (n : ℚ) := by
      obtain ⟨s, hs⟩ := hn₀ b hb
      have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow b) :=
        IsInvertible.sheafOfModules_isInvertible _
      let φ : ℱ ⟶ ℱ ⊗ ℒ.tensorPow b := (ρ_ ℱ).inv ≫ ℱ ◁ s
      let V : X.Opens := (Hom.zeroLocus s).support.compl
      have hU' : topologicalKrullDim (((U ⊔ V : X.Opens) : Set X)ᶜ : Set X) < d := by
        refine topologicalKrullDim_lt_of_forall_exists_specializes hZ
          (U ⊔ V).isOpen.isClosed_compl
          (Set.compl_subset_compl.mpr (le_sup_left : U ≤ U ⊔ V)) (fun w hw ↦ ?_) hUd
        have hwU : w ∈ ((U : Set X)ᶜ : Set X) := fun h ↦ hw (Or.inl h)
        obtain ⟨η, hηZ, hη, hηw⟩ := hZ.exists_maximal_specializes hwU
        have hηS : η ∈ S := by
          simp only [S, Set.Finite.mem_toFinset]
          exact ⟨hηZ, hη⟩
        exact ⟨η, hηZ, hηw, fun h ↦ h (Or.inr (hs η hηS))⟩
      have hiso : IsIso ((restrictFunctor V.ι).map φ) := by
        have := isIso_restrictFunctor_map_of_le s (U := V) le_rfl
        have := isIso_restrictFunctor_map_whiskerLeft s ℱ (U := V)
        rw [Functor.map_comp]
        infer_instance
      have hK : IsZero ((kernel φ).restrict (U ⊔ V).ι) :=
        isZero_restrict_sup (isZero_restrict_kernel_of_isZero φ _ hℱ)
          (isZero_restrict_kernel_of_isIso φ _)
      have hC : IsZero ((cokernel φ).restrict (U ⊔ V).ι) :=
        isZero_restrict_sup (isZero_restrict_cokernel_of_isZero φ _
          (isZero_restrict_tensorObj _ hℱ)) (isZero_restrict_cokernel_of_isIso φ _)
      have := isQuasicoherent_tensorObj ℱ (ℒ.tensorPow b)
      have := isFinitePresentation_tensorObj ℱ (ℒ.tensorPow b)
      have := isQuasicoherent_kernel φ
      have := isFinitePresentation_kernel φ
      have := isQuasicoherent_cokernel φ
      have := isFinitePresentation_cokernel φ
      obtain ⟨PK, hPK, hPK'⟩ := ih (U ⊔ V) hU' (kernel φ) hK
      obtain ⟨PC, hPC, hPC'⟩ := ih (U ⊔ V) hU' (cokernel φ) hC
      refine ⟨PC - PK, (Polynomial.degree_sub_le _ _).trans_lt (max_lt hPC hPK), fun n ↦ ?_⟩
      have h := eulerChar_tensorObj_sub_eulerChar_tensorObj_eq K φ (ℒ.tensorPow n)
      have e : (ℱ ⊗ ℒ.tensorPow b) ⊗ ℒ.tensorPow n ≅ ℱ ⊗ ℒ.tensorPow (n + b) :=
        α_ _ _ _ ≪≫ (Iso.refl ℱ ⊗ᵢ ((ℒ.tensorPowAddIso b n).symm ≪≫
          eqToIso (congrArg ℒ.tensorPow (Nat.add_comm b n))))
      rw [eulerChar_congr K e] at h
      rw [Polynomial.eval_sub, hPK', hPC']
      exact_mod_cast h
    obtain ⟨A, hA, hA'⟩ := step n₀ le_rfl
    obtain ⟨B, hB, hB'⟩ := step (n₀ + 1) (Nat.le_succ _)
    obtain ⟨P, hP, hP'⟩ := Polynomial.exists_degree_lt_eval_eq_of_sub_of_sub
      (f := fun n ↦ ((ℱ ⊗ ℒ.tensorPow n).eulerChar K : ℚ)) hA hB
      (fun n ↦ (hA' n).trans rfl) (fun n ↦ (hB' n).trans rfl)
    exact ⟨P, by exact_mod_cast hP, fun n ↦ hP' n⟩

include K in
/-- A proper scheme over a field has finite dimension, at most
`((topologicalKrullDim X).unbotD 0).toNat`. -/
lemma topologicalKrullDim_le_unbotD_toNat :
    topologicalKrullDim X ≤ (((topologicalKrullDim X).unbotD 0).toNat : WithBot ℕ∞) := by
  have := QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of K))
  have h := topologicalKrullDim_ne_top_of_compactSpace (X ↘ Spec (.of K))
  generalize topologicalKrullDim X = n at h ⊢
  induction n using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe n =>
    induction n using ENat.recTopCoe with
    | top => exact absurd rfl h
    | coe n => simp

/-- **The Hilbert polynomial of a coherent module on a proper scheme.** For `ℒ` ample and `ℱ`
coherent on `X` proper over `K`, `n ↦ χ(X, ℱ ⊗ ℒ^{⊗ n})` is given by a polynomial of degree at
most `g` whenever `dim X ≤ g`. -/
theorem exists_polynomial_eulerChar_tensorObj_tensorPow_of_le
    (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ) (ℱ : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ] {g : ℕ}
    (hg : topologicalKrullDim X ≤ g) :
    ∃ P : Polynomial ℚ, P.natDegree ≤ g ∧
      ∀ n : ℕ, P.eval (n : ℚ) = (ℱ ⊗ ℒ.tensorPow n).eulerChar K := by
  have hU : topologicalKrullDim (((⊥ : X.Opens) : Set X)ᶜ : Set X) < (g + 1 : ℕ) := by
    have : topologicalKrullDim (((⊥ : X.Opens) : Set X)ᶜ : Set X) = topologicalKrullDim X := by
      rw [TopologicalSpace.Opens.coe_bot, Set.compl_empty]
      exact IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ X).isHomeomorph
    rw [this]
    exact hg.trans_lt (by exact_mod_cast Nat.lt_succ_self g)
  have : IsEmpty (⊥ : X.Opens).toScheme := ⟨fun x ↦ x.2⟩
  obtain ⟨P, hP, hP'⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow K hℒ (g + 1) ⊥ hU ℱ
    (isZero_of_isEmpty _)
  refine ⟨P, Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun n hn ↦
    Polynomial.coeff_eq_zero_of_degree_lt (hP.trans_le ?_), hP'⟩
  exact_mod_cast Nat.succ_le_of_lt hn

omit [IsProper (X ↘ Spec (.of K))] in
/-- **The Euler characteristic is eventually `h⁰`.** By Serre vanishing, for `ℱ` coherent and
`ℒ` ample, `χ(ℱ ⊗ ℒ^{⊗ n}) = h⁰(ℱ ⊗ ℒ^{⊗ n})` for `n ≫ 0`. -/
theorem exists_forall_eulerChar_eq_finrankH_zero (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ)
    (ℱ : X.Modules) [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, (ℱ ⊗ ℒ.tensorPow n).eulerChar K = (ℱ ⊗ ℒ.tensorPow n).finrankH K 0 := by
  obtain ⟨n₀, hn₀⟩ := exists_subsingleton_H_tensorObj_tensorPow K (X ↘ Spec (.of K)) ℒ hℒ ℱ
  refine ⟨n₀, fun n hn ↦ ?_⟩
  rw [eulerChar, finsum_eq_single _ 0 fun q hq ↦ ?_]
  · simp
  · have := hn₀ n hn q (Nat.pos_of_ne_zero hq)
    simp [finrankH, Module.finrank_zero_of_subsingleton]

omit [IsProper (X ↘ Spec (.of K))] in
/-- **The Euler characteristic is eventually nonnegative.** -/
theorem exists_forall_eulerChar_nonneg (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ)
    (ℱ : X.Modules) [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, 0 ≤ (ℱ ⊗ ℒ.tensorPow n).eulerChar K := by
  obtain ⟨n₀, hn₀⟩ := exists_forall_eulerChar_eq_finrankH_zero K hℒ ℱ
  exact ⟨n₀, fun n hn ↦ (hn₀ n hn).symm ▸ Int.natCast_nonneg _⟩

omit [IsProper (X ↘ Spec (.of K))] in
/-- The Euler characteristic of the restriction of an invertible module `N` to a closed
subscheme: `χ(N ⊗ 𝒪_X ⧸ J) = χ(V(J), N|_{V(J)})`. -/
theorem eulerChar_cokernel_whiskerRight_toModulesι (J : X.IdealSheafData) (N : X.Modules)
    [N.IsInvertible] :
    letI : J.subscheme.Over (Spec (.of K)) := ⟨J.subschemeι ≫ X ↘ Spec (.of K)⟩
    (cokernel (J.toModulesι ▷ N)).eulerChar K =
      ((pullback J.subschemeι).obj N).eulerChar K := by
  let : J.subscheme.Over (Spec (.of K)) := ⟨J.subschemeι ≫ X ↘ Spec (.of K)⟩
  have (q : ℕ) : (cokernel (J.toModulesι ▷ N)).finrankH K q =
      ((pullback J.subschemeι).obj N).finrankH K q :=
    (J.nonempty_H_cokernel_whiskerRight_linearEquiv K N q).some.finrank_eq
  simp only [eulerChar, this]

/-- **The Euler characteristic splits along a closed subscheme.** For an ideal sheaf `J` with
closed subscheme `V(J)` and an invertible `N`, `χ(N) = χ(J ⊗ N) + χ(V(J), N|_{V(J)})`, from the
short exact sequence `0 ⟶ J ⊗ N ⟶ N ⟶ N|_{V(J)} ⟶ 0`. -/
theorem eulerChar_tensorObj_eq_add (J : X.IdealSheafData) (N : X.Modules) [N.IsInvertible] :
    letI : J.subscheme.Over (Spec (.of K)) := ⟨J.subschemeι ≫ X ↘ Spec (.of K)⟩
    (𝟙_ X.Modules ⊗ N).eulerChar K =
      (J.toModules ⊗ N).eulerChar K + ((pullback J.subschemeι).obj N).eulerChar K := by
  have := isNoetherian_of_isProper K (X := X)
  have := isQuasicoherent_toModules J
  have := isFinitePresentation_toModules J
  have := SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
  have := IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  have h := eulerChar_tensorObj_sub_eulerChar_tensorObj_eq K J.toModulesι N
  have := isEquivalence_tensorRight N
  have e₁ : (kernel J.toModulesι ⊗ N).eulerChar K = 0 :=
    eulerChar_eq_zero_of_isZero K ((tensorRight N).map_isZero (isZero_kernel_of_mono _))
  have e₂ : (cokernel J.toModulesι ⊗ N).eulerChar K =
      (cokernel (J.toModulesι ▷ N)).eulerChar K :=
    eulerChar_congr K (PreservesCokernel.iso (tensorRight N) J.toModulesι)
  change (𝟙_ X.Modules ⊗ N).eulerChar K - (J.toModules ⊗ N).eulerChar K = _ at h
  have h' := eulerChar_cokernel_whiskerRight_toModulesι K J N
  linarith

end Polynomial

section LowerBound

variable (K : Type u) [Field K]

/-- **The Hilbert polynomial of an integral scheme has degree at least its dimension.** Let `Y`
be an integral scheme proper over `K` and `ℒ` ample. If `P` is the Hilbert polynomial of `ℒ`
and `d ≤ dim Y`, then `d ≤ deg P`.

By induction on `d`. For `d = 0`, a section of `ℒ^{⊗ n}` not vanishing at the generic point
gives `χ(ℒ^{⊗ n}) = h⁰(ℒ^{⊗ n}) > 0` for `n ≫ 0`. For `d + 1`, choose a specialization `w` of
the generic point with `dim {w}⁻ ≥ d`, let `W` be the integral closed subscheme `{w}⁻` with
ideal `J`, and choose a section `σ` of `J ⊗ ℒ^{⊗ a}` whose image `s` in `ℒ^{⊗ a}` does not
vanish at the generic point; `s` and hence `σ` are injective as `Y` is integral. Then
`χ(ℒ^{⊗ (n + a)}) - χ(ℒ^{⊗ n}) = χ(coker σ ⊗ ℒ^{⊗ n}) + χ(W, ℒ|_W^{⊗ (n + a)})`, a sum of two
eventually nonnegative polynomials, the second of degree `≥ d` by induction. -/
theorem le_degree_of_isIntegral (d : ℕ) (Y : Scheme.{u}) [Y.Over (Spec (.of K))]
    [IsProper (Y ↘ Spec (.of K))] [IsIntegral Y] (ℒ : Y.Modules)
    (hℒ : IsAmple (Y ↘ Spec (.of K)) ℒ) (hd : (d : WithBot ℕ∞) ≤ topologicalKrullDim Y)
    (P : Polynomial ℚ) (hP : ∀ n : ℕ, P.eval (n : ℚ) = (𝟙_ Y.Modules ⊗ ℒ.tensorPow n).eulerChar K) :
    (d : WithBot ℕ) ≤ P.degree := by
  induction d generalizing Y ℒ P with
  | zero =>
    have := hℒ.isInvertible
    have := isNoetherian_of_isProper K (X := Y)
    have := SheafOfModules.isQuasicoherent_unit (R := Y.ringCatSheaf)
    have := IsInvertible.sheafOfModules_isInvertible (𝟙_ Y.Modules)
    obtain ⟨n₁, hn₁⟩ := exists_forall_mem_compl_support_zeroLocus (Y ↘ Spec (.of K)) hℒ
      {genericPoint Y} (by simp)
    obtain ⟨n₂, hn₂⟩ := exists_forall_eulerChar_eq_finrankH_zero K hℒ (𝟙_ Y.Modules)
    obtain ⟨s, hs⟩ := hn₁ (max n₁ n₂) (le_max_left _ _)
    have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow (max n₁ n₂)) :=
      IsInvertible.sheafOfModules_isInvertible _
    have hs₁ : s.app ⊤ (unitSectionsEquiv ⊤ 1) ≠ 0 := fun h ↦ by
      have := hs _ (Finset.mem_singleton_self _)
      rw [eq_zero_of_app_top_one s h, (Hom.zeroLocus_eq_bot_iff 0).mpr rfl] at this
      exact this trivial
    set M := 𝟙_ Y.Modules ⊗ ℒ.tensorPow (max n₁ n₂)
    have := isQuasicoherent_tensorObj (𝟙_ Y.Modules) (ℒ.tensorPow (max n₁ n₂))
    have := isFinitePresentation_tensorObj (𝟙_ Y.Modules) (ℒ.tensorPow (max n₁ n₂))
    have hx : Hom.app (λ_ (ℒ.tensorPow (max n₁ n₂))).inv ⊤ (s.app ⊤ (unitSectionsEquiv ⊤ 1)) ≠
        (0 : Γ(M, ⊤)) := fun h ↦
      hs₁ ((bijective_app_of_iso (λ_ (ℒ.tensorPow (max n₁ n₂))).symm ⊤).1
        (h.trans (map_zero _).symm))
    have : FiniteDimensional K (M.H 0) := finiteDimensional_H_of_isProper M 0
    have hpos : 0 < M.finrankH K 0 := Module.finrank_pos_iff_exists_ne_zero.mpr
      ⟨(H.zeroLinearEquiv M).symm _, fun h ↦ hx (by simpa using congrArg (H.zeroLinearEquiv M) h)⟩
    have hP₀ : P ≠ 0 := by
      rintro rfl
      have := hP (max n₁ n₂)
      rw [hn₂ _ (le_max_right _ _), Polynomial.eval_zero] at this
      exact hpos.ne' (by exact_mod_cast this.symm)
    exact_mod_cast Polynomial.zero_le_degree_iff.mpr hP₀
  | succ d ih =>
    have := hℒ.isInvertible
    have := isNoetherian_of_isProper K (X := Y)
    have := SheafOfModules.isQuasicoherent_unit (R := Y.ringCatSheaf)
    have := IsInvertible.sheafOfModules_isInvertible (𝟙_ Y.Modules)
    set η := genericPoint Y
    have hη : closure {η} = Set.univ := (genericPoint_spec Y).def
    obtain ⟨w, hηw, hwη, hdw⟩ := exists_specializes_ne_le_topologicalKrullDim_closure hη hd
    let J := IdealSheafData.vanishingIdeal ⟨closure {w}, isClosed_closure⟩
    have hηJ : η ∉ (J.support : Set Y) := fun h ↦ by
      simp only [J, IdealSheafData.coe_support_vanishingIdeal] at h
      exact hwη (hηw.antisymm (specializes_iff_mem_closure.mpr h)).eq.symm
    obtain ⟨a, ha⟩ := exists_mem_compl_support_zeroLocus_comp_toModulesι (Y ↘ Spec (.of K)) hℒ J
      hηJ
    obtain ⟨σ, hσ⟩ := ha a le_rfl
    have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow a) :=
      IsInvertible.sheafOfModules_isInvertible _
    set s := σ ≫ J.toModulesι ▷ ℒ.tensorPow a ≫ (λ_ _).hom
    have := isIso_restrictFunctor_map_of_le s
      (U := (Hom.zeroLocus s).support.compl) le_rfl
    have hs : IsZero (kernel s) := isZero_kernel_of_isIntegral s ⟨η, hσ⟩
    have : Mono s := Preadditive.mono_of_kernel_zero (hs.eq_of_src _ _)
    have : Mono σ := mono_of_mono σ (J.toModulesι ▷ ℒ.tensorPow a ≫ (λ_ _).hom)
    -- the integral closed subscheme `W`
    let Y' := J.subscheme
    let j := J.subschemeι
    let : Y'.Over (Spec (.of K)) := ⟨j ≫ Y ↘ Spec (.of K)⟩
    have : IsProper (Y' ↘ Spec (.of K)) := inferInstanceAs (IsProper (j ≫ Y ↘ Spec (.of K)))
    have : IsIntegral Y' := IdealSheafData.isIntegral_subscheme_vanishingIdeal_closure w
    have hdY' : (d : WithBot ℕ∞) ≤ topologicalKrullDim Y' := by
      rw [IdealSheafData.topologicalKrullDim_subscheme_vanishingIdeal_closure]
      exact hdw
    have hℒ' : IsAmple (Y' ↘ Spec (.of K)) ((pullback j).obj ℒ) := hℒ.pullback j
    have := SheafOfModules.isQuasicoherent_unit (R := Y'.ringCatSheaf)
    have := IsInvertible.sheafOfModules_isInvertible (𝟙_ Y'.Modules)
    obtain ⟨P', -, hP'⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow_of_le K hℒ'
      (𝟙_ Y'.Modules) (topologicalKrullDim_le_unbotD_toNat K)
    have hdP' := ih Y' _ hℒ' hdY' P' hP'
    -- the cokernel of `σ`
    have := isQuasicoherent_toModules J
    have := isFinitePresentation_toModules J
    have := isQuasicoherent_tensorObj J.toModules (ℒ.tensorPow a)
    have := isFinitePresentation_tensorObj J.toModules (ℒ.tensorPow a)
    have := isQuasicoherent_cokernel σ
    have := isFinitePresentation_cokernel σ
    obtain ⟨Q, -, hQ⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow_of_le K hℒ
      (cokernel σ) (topologicalKrullDim_le_unbotD_toNat K)
    have key (n : ℕ) : ((𝟙_ Y.Modules ⊗ ℒ.tensorPow (n + a)).eulerChar K : ℚ) -
        (𝟙_ Y.Modules ⊗ ℒ.tensorPow n).eulerChar K =
        (cokernel σ ⊗ ℒ.tensorPow n).eulerChar K +
          (𝟙_ Y'.Modules ⊗ ((pullback j).obj ℒ).tensorPow (n + a)).eulerChar K := by
      have h₁ := eulerChar_tensorObj_sub_eulerChar_tensorObj_eq K σ (ℒ.tensorPow n)
      have := isEquivalence_tensorRight (ℒ.tensorPow n)
      have h₀ : (kernel σ ⊗ ℒ.tensorPow n).eulerChar K = 0 :=
        eulerChar_eq_zero_of_isZero K ((tensorRight _).map_isZero (isZero_kernel_of_mono σ))
      rw [h₀, sub_zero] at h₁
      have e : (J.toModules ⊗ ℒ.tensorPow a) ⊗ ℒ.tensorPow n ≅
          J.toModules ⊗ ℒ.tensorPow (n + a) :=
        α_ _ _ _ ≪≫ (Iso.refl _ ⊗ᵢ ((ℒ.tensorPowAddIso a n).symm ≪≫
          eqToIso (congrArg ℒ.tensorPow (Nat.add_comm a n))))
      rw [eulerChar_congr K e] at h₁
      have h₂ := eulerChar_tensorObj_eq_add K J (ℒ.tensorPow (n + a))
      obtain ⟨e'⟩ := nonempty_pullback_tensorPow_iso j ℒ (n + a)
      have h₃ : ((pullback j).obj (ℒ.tensorPow (n + a))).eulerChar K =
          (𝟙_ Y'.Modules ⊗ ((pullback j).obj ℒ).tensorPow (n + a)).eulerChar K :=
        eulerChar_congr K (e' ≪≫ (λ_ _).symm)
      rw [h₃] at h₂
      have hZ : (𝟙_ Y.Modules ⊗ ℒ.tensorPow (n + a)).eulerChar K -
          (𝟙_ Y.Modules ⊗ ℒ.tensorPow n).eulerChar K =
          (cokernel σ ⊗ ℒ.tensorPow n).eulerChar K +
            (𝟙_ Y'.Modules ⊗ ((pullback j).obj ℒ).tensorPow (n + a)).eulerChar K := by
        linarith
      exact_mod_cast hZ
    -- compare polynomials
    have hpoly : P.comp (Polynomial.X + Polynomial.C (a : ℚ)) - P =
        Q + P'.comp (Polynomial.X + Polynomial.C (a : ℚ)) := by
      refine Polynomial.eq_of_infinite_eval_eq _ _
        (Set.infinite_range_of_injective Nat.cast_injective |>.mono ?_)
      rintro _ ⟨n, rfl⟩
      simp only [Set.mem_ofPred_eq, Polynomial.eval_sub, Polynomial.eval_add,
        Polynomial.eval_comp, Polynomial.eval_X, Polynomial.eval_C]
      have := key n
      rw [← hP, ← hP, ← hQ, ← hP'] at this
      push_cast at this
      linarith
    obtain ⟨n₁, hn₁⟩ := exists_forall_eulerChar_nonneg K hℒ (cokernel σ)
    obtain ⟨n₂, hn₂⟩ := exists_forall_eulerChar_nonneg K hℒ' (𝟙_ Y'.Modules)
    have hQ₀ : ∃ N : ℕ, ∀ n ≥ N, 0 ≤ Q.eval (n : ℚ) :=
      ⟨n₁, fun n hn ↦ by rw [hQ]; exact_mod_cast hn₁ n hn⟩
    have hP'₀ : ∃ N : ℕ, ∀ n ≥ N, 0 ≤ (P'.comp (Polynomial.X + Polynomial.C (a : ℚ))).eval
        (n : ℚ) :=
      ⟨n₂, fun n hn ↦ by
        simp only [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X,
          Polynomial.eval_C]
        have := hP' (n + a)
        push_cast at this
        rw [this]
        exact_mod_cast hn₂ (n + a) (by omega)⟩
    have hdeg : P'.degree = (P'.comp (Polynomial.X + Polynomial.C (a : ℚ))).degree := by
      rw [← Polynomial.taylor_apply, Polynomial.degree_taylor]
    refine Polynomial.degree_add_one_le_of_le_degree_comp_sub (a := a) ?_
    rw [hpoly, add_comm]
    exact (hdP'.trans hdeg.le).trans (Polynomial.degree_le_degree_add_of_eventually_nonneg
      hP'₀ hQ₀)

/-- A nonempty proper scheme over a field has dimension exactly
`((topologicalKrullDim X).unbotD 0).toNat`. -/
lemma unbotD_toNat_le_topologicalKrullDim {X : Scheme.{u}} [X.Over (Spec (.of K))]
    [IsProper (X ↘ Spec (.of K))] [Nonempty X] :
    (((topologicalKrullDim X).unbotD 0).toNat : WithBot ℕ∞) ≤ topologicalKrullDim X := by
  have := QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of K))
  have h := topologicalKrullDim_ne_top_of_compactSpace (X ↘ Spec (.of K))
  have h' : topologicalKrullDim X ≠ ⊥ := by
    obtain ⟨x⟩ := ‹Nonempty X›
    have : Nonempty (IrreducibleCloseds X) :=
      ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    exact Order.krullDim_eq_bot_iff.not.mpr (not_isEmpty_of_nonempty _)
  generalize topologicalKrullDim X = n at h h' ⊢
  induction n using WithBot.recBotCoe with
  | bot => exact absurd rfl h'
  | coe n =>
    induction n using ENat.recTopCoe with
    | top => exact absurd rfl h
    | coe n => simp

/-- **The Hilbert polynomial has degree `dim X` and positive leading coefficient.** Let `X` be a
nonempty proper scheme over `K` of dimension `g` and `ℒ` ample. The Hilbert polynomial `P` of
`ℒ` has degree `g` and positive leading coefficient: choose a point `x` whose closure has
dimension `g`, with integral closed subscheme `Z` and ideal `J`; then
`χ(ℒ^{⊗ n}) = χ(J ⊗ ℒ^{⊗ n}) + χ(Z, ℒ|_Z^{⊗ n})`, a sum of two eventually nonnegative
polynomials, the second of degree `≥ g` by
`AlgebraicGeometry.Scheme.Modules.le_degree_of_isIntegral`, while `P` has degree `≤ g`. -/
theorem exists_polynomial_natDegree_eq_leadingCoeff_pos {X : Scheme.{u}} [X.Over (Spec (.of K))]
    [IsProper (X ↘ Spec (.of K))] [Nonempty X] {ℒ : X.Modules}
    (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ) :
    ∃ P : Polynomial ℚ, P.natDegree = ((topologicalKrullDim X).unbotD 0).toNat ∧
      0 < P.leadingCoeff ∧
      ∀ n : ℕ, P.eval (n : ℚ) = (𝟙_ X.Modules ⊗ ℒ.tensorPow n).eulerChar K := by
  have := hℒ.isInvertible
  have := isNoetherian_of_isProper K (X := X)
  have := SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
  have := IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  set g := ((topologicalKrullDim X).unbotD 0).toNat
  obtain ⟨P, hP, hP'⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow_of_le K hℒ
    (𝟙_ X.Modules) (topologicalKrullDim_le_unbotD_toNat K)
  obtain ⟨x, hx⟩ := exists_le_topologicalKrullDim_closure_singleton
    (unbotD_toNat_le_topologicalKrullDim K (X := X))
  let J := IdealSheafData.vanishingIdeal ⟨closure {x}, isClosed_closure⟩
  let Y' := J.subscheme
  let j := J.subschemeι
  let : Y'.Over (Spec (.of K)) := ⟨j ≫ X ↘ Spec (.of K)⟩
  have : IsProper (Y' ↘ Spec (.of K)) := inferInstanceAs (IsProper (j ≫ X ↘ Spec (.of K)))
  have : IsIntegral Y' := IdealSheafData.isIntegral_subscheme_vanishingIdeal_closure x
  have hdY' : (g : WithBot ℕ∞) ≤ topologicalKrullDim Y' := by
    rw [IdealSheafData.topologicalKrullDim_subscheme_vanishingIdeal_closure]
    exact hx
  have hℒ' : IsAmple (Y' ↘ Spec (.of K)) ((pullback j).obj ℒ) := hℒ.pullback j
  have := SheafOfModules.isQuasicoherent_unit (R := Y'.ringCatSheaf)
  have := IsInvertible.sheafOfModules_isInvertible (𝟙_ Y'.Modules)
  obtain ⟨P', -, hP''⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow_of_le K hℒ'
    (𝟙_ Y'.Modules) (topologicalKrullDim_le_unbotD_toNat K)
  have hdP' := le_degree_of_isIntegral K g Y' _ hℒ' hdY' P' hP''
  have := isQuasicoherent_toModules J
  have := isFinitePresentation_toModules J
  obtain ⟨Q, -, hQ⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow_of_le K hℒ
    J.toModules (topologicalKrullDim_le_unbotD_toNat K)
  have hpoly : P = Q + P' := by
    refine Polynomial.eq_of_infinite_eval_eq _ _
      (Set.infinite_range_of_injective Nat.cast_injective |>.mono ?_)
    rintro _ ⟨n, rfl⟩
    simp only [Set.mem_ofPred_eq, Polynomial.eval_add]
    have h₂ := eulerChar_tensorObj_eq_add K J (ℒ.tensorPow n)
    obtain ⟨e'⟩ := nonempty_pullback_tensorPow_iso j ℒ n
    rw [eulerChar_congr K (e' ≪≫ (λ_ _).symm)] at h₂
    rw [hP', hQ, hP'', h₂]
    push_cast
    ring
  obtain ⟨n₁, hn₁⟩ := exists_forall_eulerChar_nonneg K hℒ J.toModules
  obtain ⟨n₂, hn₂⟩ := exists_forall_eulerChar_nonneg K hℒ' (𝟙_ Y'.Modules)
  obtain ⟨n₃, hn₃⟩ := exists_forall_eulerChar_nonneg K hℒ (𝟙_ X.Modules)
  have hdeg : (g : WithBot ℕ) ≤ P.degree := by
    rw [hpoly, add_comm]
    exact hdP'.trans (Polynomial.degree_le_degree_add_of_eventually_nonneg
      ⟨n₂, fun n hn ↦ by rw [hP'']; exact_mod_cast hn₂ n hn⟩
      ⟨n₁, fun n hn ↦ by rw [hQ]; exact_mod_cast hn₁ n hn⟩)
  have hP₀ : P ≠ 0 := by
    rintro rfl
    simp at hdeg
  have hnat : P.natDegree = g :=
    le_antisymm hP (Polynomial.le_natDegree_of_coe_le_degree hdeg)
  refine ⟨P, hnat, lt_of_le_of_ne (Polynomial.leadingCoeff_nonneg_of_eventually_nonneg
    ⟨n₃, fun n hn ↦ by rw [hP']; exact_mod_cast hn₃ n hn⟩)
    (Polynomial.leadingCoeff_ne_zero.mpr hP₀).symm, hP'⟩

end LowerBound

