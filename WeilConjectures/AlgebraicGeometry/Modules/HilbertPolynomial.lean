/-!
# Hilbert polynomials of ample invertible modules

Let `X` be a proper scheme over a field `K` and `ℒ` an ample invertible `𝒪_X`-module. For every
coherent `𝒪_X`-module `ℱ` supported in a closed subset `Z` of dimension `< d`, the function
`n ↦ χ(X, ℱ ⊗ ℒ^{⊗ n})` is given by a polynomial of degree `< d`.

The proof is a dévissage on `d`. By prime avoidance there are sections `s` of `ℒ^{⊗ a}` and
`ℒ^{⊗ (a + 1)}` which do not vanish at the generic points of the irreducible components of `Z`.
The kernel and the cokernel of `s : ℱ ⟶ ℱ ⊗ ℒ^{⊗ a}` are supported on `Z ∩ V(s)`, of dimension
`< d - 1`, so by additivity of the Euler characteristic the differences
`χ(ℱ ⊗ ℒ^{⊗ (n + a)}) - χ(ℱ ⊗ ℒ^{⊗ n})` and `χ(ℱ ⊗ ℒ^{⊗ (n + a + 1)}) - χ(ℱ ⊗ ℒ^{⊗ n})` are
polynomials of degree `< d - 1` in `n`, hence so is `χ(ℱ ⊗ ℒ^{⊗ (n + 1)}) - χ(ℱ ⊗ ℒ^{⊗ n})`.

## Main statements

- `AlgebraicGeometry.Scheme.Modules.exists_generatingSections_tensorObj_tensorPow`: Serre's
  theorem A for an ample module: `ℱ ⊗ ℒ^{⊗ n}` is generated by global sections for `n ≫ 0`.
- `AlgebraicGeometry.Scheme.Modules.exists_forall_mem_compl_support_zeroLocus`: prime avoidance
  for sections of large powers of an ample module.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory TopologicalSpace

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

section Restrict

/-- If `f` is an isomorphism on `U`, so is `f ⊗ N`, since restriction is monoidal. -/
lemma isIso_restrictFunctor_map_whiskerRight {M M' : X.Modules} (f : M ⟶ M') (N : X.Modules)
    {U : X.Opens} [IsIso ((restrictFunctor U.ι).map f)] :
    IsIso ((restrictFunctor U.ι).map (f ▷ N)) := by
  rw [NatIso.isIso_map_iff (restrictFunctorIsoPullback U.ι)] at *
  have h := Functor.LaxMonoidal.μ_natural_left (pullback U.ι) f N
  rw [(IsIso.eq_inv_comp _).mpr h.symm]
  infer_instance

/-- **Adding a section which vanishes where another does not.** If the section `s` of an
invertible module does not vanish at `x` and `t` does, then `s + t` does not vanish at `x`: near
`x`, the coefficient of `s` is a unit of the local ring and that of `t` is not. -/
lemma mem_compl_support_zeroLocus_add {N : X.Modules} [SheafOfModules.IsInvertible.{u, u, u} N]
    {s t : 𝟙_ X.Modules ⟶ N} {x : X} (hs : x ∈ (Hom.zeroLocus s).support.compl)
    (ht : x ∉ (Hom.zeroLocus t).support.compl) :
    x ∈ (Hom.zeroLocus (s + t)).support.compl := by
  obtain ⟨V, hxV, -, e, he⟩ := exists_isFreeGenerator N (x := x) (W := ⊤) trivial
  have h₁ := basicOpen_coeff_eq s V he
  have h₂ := basicOpen_coeff_eq t V he
  have h₃ := basicOpen_coeff_eq (s + t) V he
  have hs' : x ∈ X.basicOpen (he.coeff (s.app V.1 (unitSectionsEquiv _ 1))) := by
    rw [h₁]
    exact ⟨hxV, hs⟩
  have ht' : x ∉ X.basicOpen (he.coeff (t.app V.1 (unitSectionsEquiv _ 1))) := by
    rw [h₂]
    exact fun h ↦ ht h.2
  suffices x ∈ X.basicOpen (he.coeff ((s + t).app V.1 (unitSectionsEquiv _ 1))) by
    rw [h₃] at this
    exact this.2
  rw [Hom.add_app, AddCommGrpCat.hom_add_apply, he.coeff_add]
  rw [Scheme.mem_basicOpen _ _ _ hxV] at hs' ht' ⊢
  rw [map_add]
  set a := X.presheaf.germ V.1 x hxV (he.coeff (s.app V.1 (unitSectionsEquiv _ 1)))
  set b := X.presheaf.germ V.1 x hxV (he.coeff (t.app V.1 (unitSectionsEquiv _ 1)))
  have := IsLocalRing.isUnit_or_isUnit_of_isUnit_add (a := a + b) (b := -b) (by simpa using hs')
  exact this.resolve_right fun h ↦ ht' (by simpa using h)

end Restrict

/-- The ideal sheaf of a closed subset of a locally Noetherian scheme is coherent. -/
lemma isQuasicoherent_toModules (J : X.IdealSheafData) :
    SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) J.toModules := by
  have := SheafOfModules.isQuasicoherent_unit (R := J.subscheme.ringCatSheaf)
  have := SheafOfModules.isQuasicoherent_unit (R := X.ringCatSheaf)
  have h := isQuasicoherent_pushforward_of_isClosedImmersion J.subschemeι
    (SheafOfModules.unit J.subscheme.ringCatSheaf)
  have : SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf)
      ((SheafOfModules.pushforward J.subschemeι.toRingCatSheafHom).obj
        (SheafOfModules.unit J.subscheme.ringCatSheaf)) := h
  exact isQuasicoherent_kernel J.toPushforwardSubscheme

/-- The ideal sheaf of a closed subset of a locally Noetherian scheme is of finite
presentation. -/
lemma isFinitePresentation_toModules [IsLocallyNoetherian X] (J : X.IdealSheafData) :
    SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) J.toModules := by
  have := SheafOfModules.isQuasicoherent_unit (R := J.subscheme.ringCatSheaf)
  have h := isQuasicoherent_pushforward_of_isClosedImmersion J.subschemeι
    (SheafOfModules.unit J.subscheme.ringCatSheaf)
  have : SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf)
      ((SheafOfModules.pushforward J.subschemeι.toRingCatSheafHom).obj
        (SheafOfModules.unit J.subscheme.ringCatSheaf)) := h
  have := IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  exact isFinitePresentation_kernel J.toPushforwardSubscheme


section Tensor

/-- Tensoring with an invertible module is an autoequivalence. -/
lemma isEquivalence_tensorRight (P : X.Modules) [P.IsInvertible] :
    (tensorRight P).IsEquivalence :=
  (BraidedCategory.tensorRightEquivalence P Pᵛ
    (nonempty_tensorObj_dual_iso_unit P).some).isEquivalence_functor

/-- A module vanishing on `U` stays zero on `U` after tensoring with an invertible module. -/
lemma isZero_restrict_tensorObj {M : X.Modules} (N : X.Modules) [N.IsInvertible] {U : X.Opens}
    (h : IsZero (M.restrict U.ι)) : IsZero ((M ⊗ N).restrict U.ι) := by
  have h₁ : IsZero ((pullback U.ι).obj M) :=
    h.of_iso ((restrictFunctorIsoPullback U.ι).app M).symm
  have := isEquivalence_tensorRight ((pullback U.ι).obj N)
  have h₂ : IsZero ((pullback U.ι).obj M ⊗ (pullback U.ι).obj N) :=
    (tensorRight ((pullback U.ι).obj N)).map_isZero h₁
  exact (h₂.of_iso (Functor.Monoidal.μIso (pullback U.ι) M N).symm).of_iso
    ((restrictFunctorIsoPullback U.ι).app _)

end Tensor

section EulerChar

variable (K : Type u) [Field K] [X.Over (Spec (.of K))] [IsProper (X ↘ Spec (.of K))]

include K in
/-- A proper scheme over a field is Noetherian. -/
lemma isNoetherian_of_isProper : IsNoetherian X := by
  have := LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of K))
  have := QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of K))
  exact {}

include K in
/-- On a proper scheme over a field all cohomology vanishes above some degree, by Grothendieck
vanishing. -/
lemma exists_forall_subsingleton_H :
    ∃ D : ℕ, ∀ (M : X.Modules) (q : ℕ), D < q → Subsingleton (M.H q) := by
  have := isNoetherian_of_isProper K (X := X)
  obtain ⟨d, hd⟩ := exists_topologicalKrullDim_le (X ↘ Spec (.of K))
  exact ⟨d, fun M q hq ↦ subsingleton_H_of_topologicalKrullDim_lt M
    (hd.trans_lt (by exact_mod_cast hq))⟩

omit [IsProper (X ↘ Spec (.of K))] in
/-- The Euler characteristic of the zero module is zero. -/
lemma eulerChar_eq_zero_of_isZero {M : X.Modules} (h : IsZero M) : M.eulerChar K = 0 := by
  have (q : ℕ) : M.finrankH K q = 0 := by
    have := subsingleton_H_of_isZero h q
    exact Module.finrank_zero_of_subsingleton
  simp [eulerChar, this]

/-- **The Euler characteristic of a four-term exact sequence.** For a morphism `φ : M ⟶ N` of
coherent modules on a proper scheme over a field,
`χ(N) - χ(M) = χ(coker φ) - χ(ker φ)`, by additivity of `χ` on
`0 ⟶ ker φ ⟶ M ⟶ coim φ ⟶ 0` and `0 ⟶ im φ ⟶ N ⟶ coker φ ⟶ 0`. -/
theorem eulerChar_sub_eulerChar_eq {M N : X.Modules}
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M]
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) N]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) N] (φ : M ⟶ N) :
    N.eulerChar K - M.eulerChar K = (cokernel φ).eulerChar K - (kernel φ).eulerChar K := by
  have := isNoetherian_of_isProper K (X := X)
  obtain ⟨D, hD⟩ := exists_forall_subsingleton_H K (X := X)
  have := isQuasicoherent_kernel φ
  have := isFinitePresentation_kernel φ
  have := isQuasicoherent_cokernel φ
  have := isFinitePresentation_cokernel φ
  have := isQuasicoherent_cokernel (kernel.ι φ)
  have := isFinitePresentation_cokernel (kernel.ι φ)
  have := isQuasicoherent_kernel (cokernel.π φ)
  have := isFinitePresentation_kernel (cokernel.π φ)
  let S₁ := ShortComplex.mk (kernel.ι φ) (cokernel.π (kernel.ι φ)) (cokernel.condition _)
  have hS₁ : S₁.ShortExact := .mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  let S₂ := ShortComplex.mk (kernel.ι (cokernel.π φ)) (cokernel.π φ) (kernel.condition _)
  have hS₂ : S₂.ShortExact := .mk' (ShortComplex.exact_kernel _) inferInstance inferInstance
  have i₁ : ∀ q, FiniteDimensional K (S₁.X₁.H q) := finiteDimensional_H_of_isProper (kernel φ)
  have i₂ : ∀ q, FiniteDimensional K (S₁.X₂.H q) := finiteDimensional_H_of_isProper M
  have i₃ : ∀ q, FiniteDimensional K (S₁.X₃.H q) :=
    finiteDimensional_H_of_isProper (cokernel (kernel.ι φ))
  have j₁ : ∀ q, FiniteDimensional K (S₂.X₁.H q) :=
    finiteDimensional_H_of_isProper (kernel (cokernel.π φ))
  have j₂ : ∀ q, FiniteDimensional K (S₂.X₂.H q) := finiteDimensional_H_of_isProper N
  have j₃ : ∀ q, FiniteDimensional K (S₂.X₃.H q) := finiteDimensional_H_of_isProper (cokernel φ)
  have h₁ := eulerChar_eq_add_of_shortExact K hS₁ D (hD _) (hD _) (hD _)
  have h₂ := eulerChar_eq_add_of_shortExact K hS₂ D (hD _) (hD _) (hD _)
  have h₃ := eulerChar_congr K (Abelian.coimageIsoImage φ)
  change M.eulerChar K = (kernel φ).eulerChar K + (cokernel (kernel.ι φ)).eulerChar K at h₁
  change N.eulerChar K = (kernel (cokernel.π φ)).eulerChar K + (cokernel φ).eulerChar K at h₂
  change (cokernel (kernel.ι φ)).eulerChar K = (kernel (cokernel.π φ)).eulerChar K at h₃
  linarith

/-- The four-term identity of `AlgebraicGeometry.Scheme.Modules.eulerChar_sub_eulerChar_eq`
twisted by an invertible module `P`: `χ(N ⊗ P) - χ(M ⊗ P) = χ(coker φ ⊗ P) - χ(ker φ ⊗ P)`,
since tensoring with `P` is exact. -/
theorem eulerChar_tensorObj_sub_eulerChar_tensorObj_eq {M N : X.Modules}
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M]
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) N]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) N] (φ : M ⟶ N)
    (P : X.Modules) [P.IsInvertible] :
    (N ⊗ P).eulerChar K - (M ⊗ P).eulerChar K =
      (cokernel φ ⊗ P).eulerChar K - (kernel φ ⊗ P).eulerChar K := by
  have := isQuasicoherent_tensorObj M P
  have := isFinitePresentation_tensorObj M P
  have := isQuasicoherent_tensorObj N P
  have := isFinitePresentation_tensorObj N P
  have := isEquivalence_tensorRight P
  have e₁ : (kernel (φ ▷ P)).eulerChar K = (kernel φ ⊗ P).eulerChar K :=
    eulerChar_congr K (PreservesKernel.iso (tensorRight P) φ).symm
  have e₂ : (cokernel (φ ▷ P)).eulerChar K = (cokernel φ ⊗ P).eulerChar K :=
    eulerChar_congr K (PreservesCokernel.iso (tensorRight P) φ).symm
  rw [eulerChar_sub_eulerChar_eq K (φ ▷ P), e₁, e₂]

end EulerChar

section Ample

variable {K : Type u} [Field K] (f : X ⟶ Spec (.of K)) {ℒ : X.Modules} (hℒ : IsAmple f ℒ)
include hℒ

/-- **Serre's theorem A for an ample module.** Let `ℒ` be ample and `ℱ` coherent. Then
`ℱ ⊗ ℒ^{⊗ n}` is generated by its global sections for all `n ≫ 0`.

Some power `ℒ^{⊗ m}`, `m ≥ 1`, is `i^* 𝒪(1)` for a closed immersion `i : X ⟶ ℙᴺ_K`. For each of
the finitely many `0 ≤ r < m`, Serre's theorem A for projective space
(`AlgebraicGeometry.Scheme.Modules.exists_generatingSections_tensor_twist`) applied to
`ℱ ⊗ ℒ^{⊗ r}` gives `t_r` such that `ℱ ⊗ ℒ^{⊗ (m t + r)} ≅ ℱ ⊗ ℒ^{⊗ r} ⊗ 𝒪_X(t)` is generated
by global sections for `t ≥ t_r`. -/
theorem exists_generatingSections_tensorObj_tensorPow (ℱ : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, Nonempty (SheafOfModules.GeneratingSections (ℱ ⊗ₘ ℒ.tensorPow n)) := by
  obtain ⟨hinv, m, hm, N, i, hN, hi, -, ⟨e⟩⟩ := hℒ
  have key (r : Fin m) : ∃ t₀ : ℕ, ∀ t ≥ t₀, Nonempty (SheafOfModules.GeneratingSections
      ((ℱ ⊗ ℒ.tensorPow r) ⊗ₘ ProjectiveSpace.twistRestrict i t)) := by
    have := isQuasicoherent_tensorObj ℱ (ℒ.tensorPow r)
    have := isFinitePresentation_tensorObj ℱ (ℒ.tensorPow r)
    obtain ⟨m₀, h⟩ := exists_generatingSections_tensor_twist K i (ℱ ⊗ ℒ.tensorPow r)
    exact ⟨m₀.toNat, fun t ht ↦ h t (by omega)⟩
  choose t₀ ht₀ using key
  refine ⟨m * ∑ r, t₀ r, fun n hn ↦ ?_⟩
  set r : Fin m := ⟨n % m, Nat.mod_lt n hm⟩
  set t := n / m
  have hn' : n = r + m * t := (Nat.mod_add_div n m).symm
  have ht : t₀ r ≤ t := by
    refine le_trans (Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ r)) ?_
    exact (Nat.le_div_iff_mul_le hm).2 (by rw [mul_comm]; exact hn)
  have hpow : ∀ s : ℕ, Nonempty ((ℒ.tensorPow m).tensorPow s ≅
      (ProjectiveSpace.twistRestrict i 1).tensorPow s) := by
    intro s
    induction s with
    | zero => exact ⟨Iso.refl _⟩
    | succ s ih => exact ⟨e.symm ⊗ᵢ ih.some⟩
  obtain ⟨e₁⟩ := Scheme.Modules.nonempty_pullback_tensorPow_iso i
    (ProjectiveSpace.twist N (Spec (.of K)) 1) t
  obtain ⟨e₂⟩ := ProjectiveSpace.nonempty_tensorPow_twist_one_iso N (Spec (.of K)) t
  let e₃ : ℒ.tensorPow n ≅ ℒ.tensorPow r ⊗ ProjectiveSpace.twistRestrict i t :=
    eqToIso (congrArg ℒ.tensorPow hn') ≪≫ ℒ.tensorPowAddIso r (m * t) ≪≫
      (Iso.refl _ ⊗ᵢ (ℒ.tensorPowMulIso m t ≪≫ (hpow t).some ≪≫ e₁.symm ≪≫
        (Scheme.Modules.pullback i).mapIso e₂))
  let e₄ : (ℱ ⊗ ℒ.tensorPow r) ⊗ ProjectiveSpace.twistRestrict i t ≅ ℱ ⊗ ℒ.tensorPow n :=
    (α_ _ _ _) ≪≫ (Iso.refl ℱ ⊗ᵢ e₃.symm)
  obtain ⟨σ⟩ := ht₀ r t ht
  exact ⟨(SheafOfModules.GeneratingSections.equivOfIso e₄) σ⟩

/-- **Prime avoidance for an ample module.** Let `S` be a finite set of points of a locally
Noetherian scheme `X`, no two of which specialize to each other, and `ℒ` ample. Then for all
`n ≫ 0` there is a global section of `ℒ^{⊗ n}` vanishing at no point of `S`.

By induction on `S`: given such sections `s` for `S` and a new point `x`, let `T` be the closure
of `S`, which does not contain `x`, and `J` its ideal sheaf. For `n ≫ 0` the module
`J ⊗ ℒ^{⊗ n}` is generated by global sections (Serre's theorem A); near `x` it is `ℒ^{⊗ n}`, so
the image `t` in `ℒ^{⊗ n}` of one of them does not vanish at `x`, while `t` vanishes on `T`.
Then `s` or `s + t` vanishes at no point of `S ∪ {x}`. -/
theorem exists_forall_mem_compl_support_zeroLocus [IsLocallyNoetherian X] (S : Finset X)
    (hS : ∀ x ∈ S, ∀ y ∈ S, x ⤳ y → x = y) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∃ s : 𝟙_ X.Modules ⟶ ℒ.tensorPow n,
      ∀ x ∈ S, x ∈ (Hom.zeroLocus s).support.compl := by
  classical
  have := hℒ.isInvertible
  induction S using Finset.induction_on with
  | empty => exact ⟨0, fun n _ ↦ ⟨0, by simp⟩⟩
  | insert x S hxS ih =>
    obtain ⟨n₁, hn₁⟩ := ih fun a ha b hb hab ↦
      hS a (Finset.mem_insert_of_mem ha) b (Finset.mem_insert_of_mem hb) hab
    let T : Closeds X := ⟨closure (S : Set X), isClosed_closure⟩
    let U : X.Opens := T.compl
    have hxT : x ∈ U := by
      change x ∉ closure (S : Set X)
      rw [← Set.biUnion_of_singleton (S : Set X), S.finite_toSet.closure_biUnion]
      simp only [Set.mem_iUnion, not_exists]
      intro y hy hxy
      rw [← specializes_iff_mem_closure] at hxy
      exact hxS ((hS y (Finset.mem_insert_of_mem hy) x (Finset.mem_insert_self x S) hxy) ▸ hy)
    let J := IdealSheafData.vanishingIdeal T
    have := isQuasicoherent_toModules J
    have := isFinitePresentation_toModules J
    obtain ⟨n₂, hn₂⟩ := exists_generatingSections_tensorObj_tensorPow f hℒ J.toModules
    refine ⟨max n₁ n₂, fun n hn ↦ ?_⟩
    obtain ⟨s, hs⟩ := hn₁ n (le_of_max_le_left hn)
    obtain ⟨σ⟩ := hn₂ n (le_of_max_le_right hn)
    have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow n) :=
      IsInvertible.sheafOfModules_isInvertible _
    let g : J.toModules ⊗ ℒ.tensorPow n ⟶ ℒ.tensorPow n :=
      J.toModulesι ▷ ℒ.tensorPow n ≫ (λ_ _).hom
    have hepi : Epi ((restrictFunctor U.ι).map (σ.π ≫ g)) := by
      have : IsIso ((restrictFunctor U.ι).map J.toModulesι) :=
        J.isIso_restrictFunctor_map_toModulesι (U := U)
          (by simp only [J, IdealSheafData.coe_support_vanishingIdeal]; exact fun _ h ↦ h)
      have := isIso_restrictFunctor_map_whiskerRight J.toModulesι (ℒ.tensorPow n)
        (U := U)
      have : Epi σ.π := σ.epi
      have h₁ : Epi ((restrictFunctor U.ι).map σ.π) := Functor.map_epi _ _
      rw [Functor.map_comp, Functor.map_comp]
      exact epi_comp' h₁ (epi_comp' inferInstance inferInstance)
    obtain ⟨i, hi⟩ := exists_generatesAt_of_epi (σ.π ≫ g) hxT hepi
    set t := SheafOfModules.ιFree (R := X.ringCatSheaf) i ≫ σ.π ≫ g
    replace hi := (generatesAt_iff_mem_compl_support t x).mp hi
    have hvan (y : X) (hy : y ∈ S) : y ∉ (Hom.zeroLocus t).support.compl := fun h ↦ by
      refine not_generatesAt_of_factors J (SheafOfModules.ιFree (R := X.ringCatSheaf) i ≫ σ.π)
        (y := y) (by simpa [J, T] using subset_closure hy) ?_
      exact (generatesAt_iff_mem_compl_support _ y).mpr
        (by simpa only [t, g, Category.assoc] using h)
    by_cases hxs : x ∈ (Hom.zeroLocus s).support.compl
    · refine ⟨s, fun y hy ↦ ?_⟩
      rcases Finset.mem_insert.mp hy with rfl | hy
      · exact hxs
      · exact hs y hy
    · refine ⟨s + t, fun y hy ↦ ?_⟩
      rcases Finset.mem_insert.mp hy with rfl | hy
      · rw [add_comm]
        exact mem_compl_support_zeroLocus_add hi hxs
      · exact mem_compl_support_zeroLocus_add (hs y hy) (hvan y hy)

end Ample

section Polynomial

variable (K : Type u) [Field K] [X.Over (Spec (.of K))] [IsProper (X ↘ Spec (.of K))]
  {ℒ : X.Modules}

/-- **The Hilbert polynomial of a coherent module.** Let `X` be proper over a field `K`, `ℒ` an
ample invertible module and `ℱ` a coherent module vanishing on an open `U` whose complement `Z` has
dimension `< d`. Then `n ↦ χ(X, ℱ ⊗ ℒ^{⊗ n})` is given by a polynomial of degree `< d`.

By induction on `d`. If `d = 0` then `Z` is empty, so `ℱ = 0`. Otherwise, prime avoidance
(`AlgebraicGeometry.Scheme.Modules.exists_forall_mem_compl_support_zeroLocus`) gives sections `s`
of `ℒ^{⊗ a}` and of `ℒ^{⊗ (a + 1)}` not vanishing at the generic points of the irreducible
components of `Z`. The kernel and cokernel of `ℱ ⟶ ℱ ⊗ ℒ^{⊗ b}` given by `s` vanish outside
`Z ∩ V(s)`, which has dimension `< d - 1`, so by induction and
`AlgebraicGeometry.Scheme.Modules.eulerChar_tensorObj_sub_eulerChar_tensorObj_eq` the differences
`χ(ℱ ⊗ ℒ^{⊗ (n + b)}) - χ(ℱ ⊗ ℒ^{⊗ n})` are polynomials of degree `< d - 1` for `b = a, a + 1`;
hence so is `χ(ℱ ⊗ ℒ^{⊗ (n + 1)}) - χ(ℱ ⊗ ℒ^{⊗ n})`. -/
theorem exists_polynomial_eulerChar_tensorObj_tensorPow (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ)
    (d : ℕ) (U : X.Opens) (hU : topologicalKrullDim ((U : Set X)ᶜ : Set X) < d)
    (ℱ : X.Modules) [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ]
    (hℱ : IsZero (ℱ.restrict U.ι)) :
    ∃ P : Polynomial ℚ, P.degree < d ∧
      ∀ n : ℕ, P.eval (n : ℚ) = (ℱ ⊗ ℒ.tensorPow n).eulerChar K := by
  have := hℒ.isInvertible
  have := isNoetherian_of_isProper K (X := X)
  induction d generalizing U ℱ with
  | zero =>
    have hUe : ((U : Set X)ᶜ : Set X) = ∅ := by
      by_contra h
      obtain ⟨z, hz⟩ := Set.nonempty_iff_ne_empty.mpr h
      have : Nonempty (IrreducibleCloseds ((U : Set X)ᶜ : Set X)) :=
        ⟨⟨closure {⟨z, hz⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      exact (not_lt.mpr (Order.krullDim_nonneg (α := IrreducibleCloseds ((U : Set X)ᶜ : Set X))))
        (by exact_mod_cast hU)
    have hUt : U = ⊤ := by
      ext x
      simpa using fun h ↦ (Set.eq_empty_iff_forall_notMem.mp hUe x h)
    subst hUt
    have hℱ' : IsZero ℱ := isZero_of_isZero_restrict_top hℱ
    refine ⟨0, by simp, fun n ↦ ?_⟩
    have := isEquivalence_tensorRight (ℒ.tensorPow n)
    have h₀ : IsZero (ℱ ⊗ ℒ.tensorPow n) := (tensorRight (ℒ.tensorPow n)).map_isZero hℱ'
    rw [eulerChar_eq_zero_of_isZero K h₀]
    simp
  | succ d ih =>
    have hUd : topologicalKrullDim ((U : Set X)ᶜ : Set X) < d + 1 := by exact_mod_cast hU
    have hZ : IsClosed ((U : Set X)ᶜ) := U.isOpen.isClosed_compl
    let S := hZ.finite_setOf_maximal_specializes.toFinset
    have hS : ∀ x ∈ S, ∀ y ∈ S, x ⤳ y → x = y := fun x hx y hy hxy ↦ by
      simp only [S, Set.Finite.mem_toFinset] at hx hy
      exact hy.2 x hx.1 hxy
    obtain ⟨n₀, hn₀⟩ := exists_forall_mem_compl_support_zeroLocus (X ↘ Spec (.of K)) hℒ S hS
    have step (b : ℕ) (hb : n₀ ≤ b) : ∃ Q : Polynomial ℚ, Q.degree < d ∧ ∀ n : ℕ,
        ((ℱ ⊗ ℒ.tensorPow (n + b)).eulerChar K : ℚ) - (ℱ ⊗ ℒ.tensorPow n).eulerChar K =
          Q.eval (n : ℚ) := by
      obtain ⟨s, hs⟩ := hn₀ b hb
      have : SheafOfModules.IsInvertible.{u, u, u} (ℒ.tensorPow b) :=
        IsInvertible.sheafOfModules_isInvertible _
      let φ : ℱ ⟶ ℱ ⊗ ℒ.tensorPow b := (ρ_ ℱ).inv ≫ ℱ ◁ s
      let V : X.Opens := (Hom.zeroLocus s).support.compl
      have hU' : topologicalKrullDim (((U ⊔ V : X.Opens) : Set X)ᶜ : Set X) < d := by
        refine topologicalKrullDim_lt_of_forall_exists_specializes hZ
          (U ⊔ V).isOpen.isClosed_compl
          (Set.compl_subset_compl.mpr (le_sup_left : U ≤ U ⊔ V)) (fun w hw ↦ ?_) hUd
        have hwU : w ∈ ((U : Set X)ᶜ : Set X) := fun h ↦ hw (Or.inl h)
        obtain ⟨η, hηZ, hη, hηw⟩ := hZ.exists_maximal_specializes hwU
        have hηS : η ∈ S := by
          simp only [S, Set.Finite.mem_toFinset]
          exact ⟨hηZ, hη⟩
        exact ⟨η, hηZ, hηw, fun h ↦ h (Or.inr (hs η hηS))⟩
      have hiso : IsIso ((restrictFunctor V.ι).map φ) := by
        have := isIso_restrictFunctor_map_of_le s (U := V) le_rfl
        have := isIso_restrictFunctor_map_whiskerLeft s ℱ (U := V)
        rw [Functor.map_comp]
        infer_instance
      have hK : IsZero ((kernel φ).restrict (U ⊔ V).ι) :=
        isZero_restrict_sup (isZero_restrict_kernel_of_isZero φ _ hℱ)
          (isZero_restrict_kernel_of_isIso φ _)
      have hC : IsZero ((cokernel φ).restrict (U ⊔ V).ι) :=
        isZero_restrict_sup (isZero_restrict_cokernel_of_isZero φ _
          (isZero_restrict_tensorObj _ hℱ)) (isZero_restrict_cokernel_of_isIso φ _)
      have := isQuasicoherent_tensorObj ℱ (ℒ.tensorPow b)
      have := isFinitePresentation_tensorObj ℱ (ℒ.tensorPow b)
      have := isQuasicoherent_kernel φ
      have := isFinitePresentation_kernel φ
      have := isQuasicoherent_cokernel φ
      have := isFinitePresentation_cokernel φ
      obtain ⟨PK, hPK, hPK'⟩ := ih (U ⊔ V) hU' (kernel φ) hK
      obtain ⟨PC, hPC, hPC'⟩ := ih (U ⊔ V) hU' (cokernel φ) hC
      refine ⟨PC - PK, (Polynomial.degree_sub_le _ _).trans_lt (max_lt hPC hPK), fun n ↦ ?_⟩
      have h := eulerChar_tensorObj_sub_eulerChar_tensorObj_eq K φ (ℒ.tensorPow n)
      have e : (ℱ ⊗ ℒ.tensorPow b) ⊗ ℒ.tensorPow n ≅ ℱ ⊗ ℒ.tensorPow (n + b) :=
        α_ _ _ _ ≪≫ (Iso.refl ℱ ⊗ᵢ ((ℒ.tensorPowAddIso b n).symm ≪≫
          eqToIso (congrArg ℒ.tensorPow (Nat.add_comm b n))))
      rw [eulerChar_congr K e] at h
      rw [Polynomial.eval_sub, hPK', hPC']
      exact_mod_cast h
    obtain ⟨A, hA, hA'⟩ := step n₀ le_rfl
    obtain ⟨B, hB, hB'⟩ := step (n₀ + 1) (Nat.le_succ _)
    obtain ⟨P, hP, hP'⟩ := Polynomial.exists_degree_lt_eval_eq_of_sub_of_sub
      (f := fun n ↦ ((ℱ ⊗ ℒ.tensorPow n).eulerChar K : ℚ)) hA hB
      (fun n ↦ (hA' n).trans rfl) (fun n ↦ (hB' n).trans rfl)
    exact ⟨P, by exact_mod_cast hP, fun n ↦ hP' n⟩

include K in
/-- A proper scheme over a field has finite dimension, at most
`((topologicalKrullDim X).unbotD 0).toNat`. -/
lemma topologicalKrullDim_le_unbotD_toNat :
    topologicalKrullDim X ≤ (((topologicalKrullDim X).unbotD 0).toNat : WithBot ℕ∞) := by
  have := QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of K))
  have h := topologicalKrullDim_ne_top_of_compactSpace (X ↘ Spec (.of K))
  generalize topologicalKrullDim X = n at h ⊢
  induction n using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe n =>
    induction n using ENat.recTopCoe with
    | top => exact absurd rfl h
    | coe n => simp

/-- **The Hilbert polynomial of a coherent module on a proper scheme.** For `ℒ` ample and `ℱ`
coherent on `X` proper over `K`, `n ↦ χ(X, ℱ ⊗ ℒ^{⊗ n})` is given by a polynomial of degree at
most `g` whenever `dim X ≤ g`. -/
theorem exists_polynomial_eulerChar_tensorObj_tensorPow_of_le
    (hℒ : IsAmple (X ↘ Spec (.of K)) ℒ) (ℱ : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) ℱ]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) ℱ] {g : ℕ}
    (hg : topologicalKrullDim X ≤ g) :
    ∃ P : Polynomial ℚ, P.natDegree ≤ g ∧
      ∀ n : ℕ, P.eval (n : ℚ) = (ℱ ⊗ ℒ.tensorPow n).eulerChar K := by
  have hU : topologicalKrullDim (((⊥ : X.Opens) : Set X)ᶜ : Set X) < (g + 1 : ℕ) := by
    have : topologicalKrullDim (((⊥ : X.Opens) : Set X)ᶜ : Set X) = topologicalKrullDim X := by
      rw [TopologicalSpace.Opens.coe_bot, Set.compl_empty]
      exact IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ X).isHomeomorph
    rw [this]
    exact hg.trans_lt (by exact_mod_cast Nat.lt_succ_self g)
  have : IsEmpty (⊥ : X.Opens).toScheme := ⟨fun x ↦ x.2⟩
  obtain ⟨P, hP, hP'⟩ := exists_polynomial_eulerChar_tensorObj_tensorPow K hℒ (g + 1) ⊥ hU ℱ
    (isZero_of_isEmpty _)
  refine ⟨P, Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun n hn ↦
    Polynomial.coeff_eq_zero_of_degree_lt (hP.trans_le ?_), hP'⟩
  exact_mod_cast Nat.succ_le_of_lt hn

end Polynomial

end AlgebraicGeometry.Scheme.Modules
