module

public import WeilConjectures.AlgebraicGeometry.Modules.ExteriorSheaf
public import WeilConjectures.AlgebraicGeometry.Modules.TensorSection
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian

/-!
# A generator criterion for annihilating an exterior quotient kernel

Source: blueprint, Riemann--Roch, proof of (*), determinant paragraph.
-/

@[expose] public section

universe v
open CategoryTheory CategoryTheory.Limits Opposite MonoidalCategory
namespace AlgebraicGeometry.Scheme.Modules

set_option backward.isDefEq.respectTransparency false in
/-- A morphism kills the exterior quotient kernel if it kills the quotient relations.

Source: blueprint, Riemann--Roch, proof of (*), determinant paragraph, quotient relations
(blueprint: new-j1-exterior-tensor-kernel-relations).

Proof: On each stalk, short exactness identifies the quotient module with the middle
module modulo the image of the first map. Present the exterior power by multilinearity
and alternation. Passing to the quotient imposes precisely the additional relations
that a pure wedge with an argument in the image of the first map is zero: changing any
representative by such an image changes its wedge by one of these relations. Tensoring
with the first exterior factor preserves this quotient presentation by right exactness
of tensor products. Thus the kernel is generated by tensors of pure wedges with such
an argument. A finite tuple of germs, including a preimage of that argument under the
first map, is represented on a common neighborhood. After shrinking, the equality of
that argument with the image of its preimage holds for sections. The hypothesis makes
its image under the given morphism zero. Linearity kills every kernel element on every
stalk, and stalkwise equality detects zero sheaf morphisms. No local freeness or rank
condition is used. If the second degree is zero, there are no extra relations and the
quotient is the identity. Empty opens and zero rings satisfy the same presentation. -/
theorem exteriorTensor_kernel_eq_zero_of_relations {X : Scheme.{v}}
    (S : ShortComplex X.Modules) (hS : S.ShortExact) (A D : X.Modules) (r s : ℕ)
    (q : exteriorSheaf A r ⊗ exteriorSheaf S.X₂ s ⟶
      exteriorSheaf A r ⊗ exteriorSheaf S.X₃ s)
    (ψ : exteriorSheaf A r ⊗ exteriorSheaf S.X₂ s ⟶ D)
    (hq : ∀ (U : X.Opens) (a : Fin r → A.val.obj (op U))
      (c : Fin s → S.X₂.val.obj (op U)),
      q.val.app (op U)
        (tmulSection (exteriorSheafSection A r U a)
          (exteriorSheafSection S.X₂ s U c)) =
        tmulSection (M := exteriorSheaf A r) (N := exteriorSheaf S.X₃ s)
          (exteriorSheafSection A r U a)
          (exteriorSheafSection S.X₃ s U (fun i ↦ S.g.val.app (op U) (c i))))
    (hzero : ∀ (U : X.Opens) (a : Fin r → A.val.obj (op U))
      (c : Fin s → S.X₂.val.obj (op U)) (j : Fin s) (d : S.X₁.val.obj (op U)),
      c j = S.f.val.app (op U) d →
      ψ.val.app (op U)
        (tmulSection (exteriorSheafSection A r U a)
          (exteriorSheafSection S.X₂ s U c)) = 0) :
    kernel.ι q ≫ ψ = 0 := by sorry

end AlgebraicGeometry.Scheme.Modules
