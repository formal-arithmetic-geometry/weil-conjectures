/-!
# The zero scheme of a morphism of invertible modules

Let `φ : ℳ ⟶ 𝒩` be a morphism of invertible `𝒪_X`-modules. On an open `U` on which `ℳ` and `𝒩`
are trivialized by sections `e_ℳ` and `e_𝒩`, the morphism is multiplication by the coefficient
`b ∈ Γ(X, U)` with `φ(e_ℳ) = b • e_𝒩`, and the *zero scheme* `Z(φ) ⊆ X` is the closed subscheme
cut out by `b` on `U`. Its ideal sheaf is `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus φ`.

The zero scheme `Z(s)` of a global section `s` of an invertible module `ℳ` in the sense of the
blueprint is the case `φ = s : 𝒪_X ⟶ ℳ`; more generally, for invertible `ℳ` and `𝒩`, the
section `s : 𝒪_X ≅ ℳ ⊗ ℳ^∨ ⟶ 𝒩 ⊗ ℳ^∨` corresponding to `φ : ℳ ⟶ 𝒩`
(`AlgebraicGeometry.Scheme.Modules.Hom.adjointSection`) has `Z(s) = Z(φ)`
(`AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus_adjointSection`, in
`WeilConjectures/AlgebraicGeometry/Modules/ZeroLocusDual.lean`), since both are cut out by the
coefficient `b` above.

## Implementation notes

A trivialization of `ℳ` on `U` is a section `e ∈ Γ(ℳ, U)` such that `r ↦ r • e|_V` is a
bijection `Γ(X, V) ≃ Γ(ℳ, V)` for every open `V ⊆ U`
(`AlgebraicGeometry.Scheme.Modules.IsFreeGenerator`). The ideal sheaf `Z(φ)` is defined as the
largest quasi-coherent ideal sheaf whose sections over every affine `W` restrict, on each
trivializing affine `V ⊆ W`, into the ideal generated by the coefficient of `φ` on `V`
(`AlgebraicGeometry.Scheme.IdealSheafData.ofIdeals`). This makes it a definition without side
conditions; for invertible `ℳ` and `𝒩` the family of ideals is already quasi-coherent, which is
the content of `AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`.

## Main definitions

- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus`: the ideal sheaf of the zero scheme `Z(φ)`
  (blueprint `def-pc-zero-scheme`).

## Main statements

The properties of the zero scheme (blueprint `lem-pc-zero-scheme-properties`):

- `AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`: on a trivializing affine open `U`,
  the ideal of `Z(φ)` is generated by the coefficient of `φ`, i.e. `Z(φ) ∩ U = Spec(A/(b))`.
- `AlgebraicGeometry.Scheme.Modules.Hom.comap_zeroLocus`: the zero scheme commutes with
  pullback.
- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus_eq_bot_iff`: `Z(φ) = X` if and only if
  `φ = 0`.

Further properties:

- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus_eq_of_arrowIso`: isomorphic morphisms have the
  same zero scheme.
- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus_comp_le`: `Z(φ) ⊆ Z(ψ ≫ φ)`.
- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus_whiskerRight`: twisting by an invertible
  module does not change the zero scheme.
- `AlgebraicGeometry.Scheme.Modules.Hom.nonempty_iso_dual_toModules_tensorObj`: if `Z(φ) = D`
  is an effective Cartier divisor, then `N ≅ 𝒪_X(D) ⊗ M`.
- `AlgebraicGeometry.Scheme.Modules.Hom.nonempty_iso_toModules_zeroLocus`: a morphism
  `ψ : L ⟶ 𝒪_X` from an invertible module whose zero scheme `D` is an effective Cartier divisor
  identifies `L` with `𝒪_X(-D)`.
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.zeroLocus_toModulesι`: an effective
  Cartier divisor is the zero scheme of the inclusion `𝒪_X(-D) ⟶ 𝒪_X`.
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.exists_zeroLocus_eq`: an effective
  Cartier divisor `D` is the zero scheme of the canonical section of `𝒪_X(D)`.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry.Scheme

namespace Modules

variable {X : Scheme.{u}} {M N : X.Modules}

/-- Every point `x` of an open `W` has an affine open neighbourhood `U ⊆ W` on which two
invertible modules both have free generators. -/
lemma exists_isFreeGenerator₂ (M N : X.Modules) [SheafOfModules.IsInvertible.{u, u, u} M]
    [SheafOfModules.IsInvertible.{u, u, u} N] {x : X} {W : X.Opens} (hx : x ∈ W) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ U.1 ≤ W ∧ (∃ eM : Γ(M, U.1), IsFreeGenerator eM) ∧
      ∃ eN : Γ(N, U.1), IsFreeGenerator eN := by
  obtain ⟨U, hxU, hUW, eM, hM⟩ := exists_isFreeGenerator M hx
  obtain ⟨U', hxU', hU'U, eN, hN⟩ := exists_isFreeGenerator N hxU
  exact ⟨U', hxU', hU'U.trans hUW, ⟨_, hM.map hU'U⟩, _, hN⟩

/-- Every point of an affine open `W` lies in a basic open of `W` on which two invertible
modules both have free generators. -/
lemma exists_basicOpen_isFreeGenerator (M N : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} M] [SheafOfModules.IsInvertible.{u, u, u} N]
    {W : X.Opens} (hW : IsAffineOpen W) {x : X} (hx : x ∈ W) : ∃ g : Γ(X, W),
      x ∈ X.basicOpen g ∧ (∃ eM : Γ(M, X.basicOpen g), IsFreeGenerator eM) ∧
        ∃ eN : Γ(N, X.basicOpen g), IsFreeGenerator eN := by
  obtain ⟨U, hxU, -, ⟨eM, hM⟩, eN, hN⟩ := exists_isFreeGenerator₂ M N hx
  obtain ⟨g, hgU, hxg⟩ := hW.exists_basicOpen_le ⟨x, hxU⟩ hx
  exact ⟨g, hxg, ⟨_, hM.map hgU⟩, _, hN.map hgU⟩

/-- If `φ(eM) = b • eN` on `U`, then the same holds for the restrictions to `V ⊆ U`. -/
lemma Hom.app_presheaf_map_of_eq (φ : M ⟶ N) {U V : X.Opens} (i : V ⟶ U) {eM : Γ(M, U)}
    {eN : Γ(N, U)} {b : Γ(X, U)} (hb : φ.app U eM = b • eN) :
    φ.app V (M.presheaf.map i.op eM) = X.presheaf.map i.op b • N.presheaf.map i.op eN := by
  rw [Hom.app_presheaf_map, hb, map_smul]

/-- The coefficient of `φ` with respect to free generators of `M` and `N` is well defined up to
a unit: coefficients with respect to different free generators divide each other. -/
lemma Hom.mem_span_of_isFreeGenerator (φ : M ⟶ N) {U : X.Opens} {eM eM' : Γ(M, U)}
    {eN eN' : Γ(N, U)} (hM : IsFreeGenerator eM) (hM' : IsFreeGenerator eM')
    (hN : IsFreeGenerator eN) (hN' : IsFreeGenerator eN') {b b' : Γ(X, U)}
    (hb : φ.app U eM = b • eN) (hb' : φ.app U eM' = b' • eN') : b ∈ Ideal.span {b'} := by
  obtain ⟨u, rfl⟩ := hM'.exists_unit_smul_eq hM
  obtain ⟨w, rfl⟩ := hN'.exists_unit_smul_eq hN
  have : b * w.1 = u.1 * b' := hN'.smul_left_injective (by
    simp only [mul_smul, ← hb, ← hb', Hom.app_smul])
  rw [Ideal.mem_span_singleton']
  refine ⟨u.1 * w⁻¹.1, ?_⟩
  rw [mul_right_comm, ← this, mul_assoc, Units.mul_inv, mul_one]

/-- Membership in an ideal of the sections over an affine open can be checked locally on
basic opens. -/
lemma _root_.AlgebraicGeometry.IsAffineOpen.mem_of_forall_exists_basicOpen {U : X.Opens}
    (hU : IsAffineOpen U) (I : Ideal Γ(X, U)) (a : Γ(X, U))
    (H : ∀ x ∈ U, ∃ g : Γ(X, U), x ∈ X.basicOpen g ∧
      X.presheaf.map (homOfLE (X.basicOpen_le g)).op a ∈
        I.map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom) : a ∈ I := by
  let s : Set Γ(X, U) := {g | X.presheaf.map (homOfLE (X.basicOpen_le g)).op a ∈
    I.map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom}
  have hs : Ideal.span s = ⊤ := by
    rw [← hU.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨g, hxg, hg⟩ := H x hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hg⟩, hxg⟩
  refine Submodule.mem_of_span_eq_top_of_smul_pow_mem I s hs a fun g ↦ ?_
  have := hU.isLocalization_basicOpen g.1
  obtain ⟨_, ⟨n, rfl⟩, hn⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
    (Submonoid.powers g.1) _ I a).mp g.2
  exact ⟨n, hn⟩

/-- The family of ideals defining the zero scheme of `φ : M ⟶ N`: a function `a` on `W` lies in
it if, on every affine `V ⊆ W` on which `M` and `N` have free generators `eM` and `eN`, the
restriction `a|_V` lies in the ideal generated by the coefficient `b` of `φ`, defined by
`φ(eM) = b • eN`.

This is meaningful only for invertible `M` and `N`, which have free generators locally. If `M`
or `N` has no free generator over any affine open contained in `W`, the infimum is empty and
the ideal is the junk value `⊤`, whatever `φ` is (even for `φ = 0`). Every statement about it
assumes `M` and `N` invertible. -/
def Hom.zeroLocusIdeal (φ : M ⟶ N) (W : X.Opens) : Ideal Γ(X, W) :=
  ⨅ (V : X.affineOpens) (h : V.1 ≤ W) (eM : Γ(M, V.1)) (_ : IsFreeGenerator eM)
    (eN : Γ(N, V.1)) (_ : IsFreeGenerator eN) (b : Γ(X, V.1)) (_ : φ.app V.1 eM = b • eN),
    (Ideal.span {b}).comap (X.presheaf.map (homOfLE h).op).hom

/-- **The zero scheme of a morphism of invertible modules.** For `φ : M ⟶ N`, the ideal sheaf
`𝓘_{Z(φ)}` which on an affine open `U = Spec A` trivializing `M` and `N`, where `φ` is
multiplication by `b ∈ A`, is the ideal `(b)`; so `Z(φ) ∩ U = Spec(A/(b))`
(`AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`).

For a global section `s` of an invertible module `ℳ`, the zero scheme `Z(s)` of the blueprint is
the zero scheme of `s : 𝒪_X ⟶ ℳ`; its ideal is the image of `s^∨ : ℳ^∨ ⟶ 𝒪_X`.

The definition makes sense only for invertible `M` and `N`, which is assumed in every statement
about it. Otherwise it may be the junk value: if `M` or `N` has no free generator over any
affine open of `X`, then `Z(φ)` is empty for every `φ`, including `φ = 0`
(see `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocusIdeal`).

(blueprint: `def-pc-zero-scheme`) -/
def Hom.zeroLocus (φ : M ⟶ N) : X.IdealSheafData :=
  IdealSheafData.ofIdeals fun W ↦ φ.zeroLocusIdeal W.1

lemma Hom.mem_zeroLocusIdeal_iff (φ : M ⟶ N) {W : X.Opens} (a : Γ(X, W)) :
    a ∈ φ.zeroLocusIdeal W ↔ ∀ (V : X.affineOpens) (h : V.1 ≤ W) (eM : Γ(M, V.1)),
      IsFreeGenerator eM → ∀ eN : Γ(N, V.1), IsFreeGenerator eN → ∀ b : Γ(X, V.1),
      φ.app V.1 eM = b • eN → X.presheaf.map (homOfLE h).op a ∈ Ideal.span {b} := by
  simp only [Hom.zeroLocusIdeal, Submodule.mem_iInf, Ideal.mem_comap]

/-- On an affine open `U` on which `M` and `N` have free generators, `φ.zeroLocusIdeal U` is
generated by the coefficient of `φ`. -/
lemma Hom.zeroLocusIdeal_eq_span (φ : M ⟶ N) (U : X.affineOpens) {eM : Γ(M, U.1)}
    {eN : Γ(N, U.1)} (hM : IsFreeGenerator eM) (hN : IsFreeGenerator eN) {b : Γ(X, U.1)}
    (hb : φ.app U.1 eM = b • eN) : φ.zeroLocusIdeal U.1 = Ideal.span {b} := by
  refine le_antisymm (fun a ha ↦ ?_) (Ideal.span_le.mpr ?_)
  · simpa only [Scheme.presheaf_map_id_apply] using
      (φ.mem_zeroLocusIdeal_iff a).mp ha U le_rfl eM hM eN hN b hb
  · rintro _ rfl
    rw [SetLike.mem_coe, Hom.mem_zeroLocusIdeal_iff]
    intro V h eM' hM' eN' hN' b' hb'
    exact φ.mem_span_of_isFreeGenerator (hM.map h) hM' (hN.map h) hN'
      (φ.app_presheaf_map_of_eq _ hb) hb'

/-- The restriction of a member of `φ.zeroLocusIdeal W` to `W' ⊆ W` is a member of
`φ.zeroLocusIdeal W'`. -/
lemma Hom.presheaf_map_mem_zeroLocusIdeal (φ : M ⟶ N) {W W' : X.Opens} (h : W' ≤ W)
    {a : Γ(X, W)} (ha : a ∈ φ.zeroLocusIdeal W) :
    X.presheaf.map (homOfLE h).op a ∈ φ.zeroLocusIdeal W' := by
  rw [Hom.mem_zeroLocusIdeal_iff] at ha ⊢
  intro V hV eM hM eN hN b hb
  rw [Scheme.presheaf_map_map_apply]
  exact ha V (hV.trans h) eM hM eN hN b hb

/-- Membership in `φ.zeroLocusIdeal W` is local on `W`. -/
lemma Hom.mem_zeroLocusIdeal_of_forall_exists (φ : M ⟶ N) {W : X.Opens} (a : Γ(X, W))
    (H : ∀ x ∈ W, ∃ (W' : X.Opens) (h : W' ≤ W), x ∈ W' ∧
      X.presheaf.map (homOfLE h).op a ∈ φ.zeroLocusIdeal W') :
    a ∈ φ.zeroLocusIdeal W := by
  rw [Hom.mem_zeroLocusIdeal_iff]
  intro V hV eM hM eN hN b hb
  refine V.2.mem_of_forall_exists_basicOpen _ _ fun x hx ↦ ?_
  obtain ⟨W', hW', hxW', ha⟩ := H x (hV hx)
  obtain ⟨g, hgW', hxg⟩ := V.2.exists_basicOpen_le ⟨x, hxW'⟩ hx
  refine ⟨g, hxg, ?_⟩
  have := (φ.mem_zeroLocusIdeal_iff _).mp ha ⟨_, V.2.basicOpen g⟩ hgW' _
    (hM.map (X.basicOpen_le g)) _ (hN.map (X.basicOpen_le g)) _ (φ.app_presheaf_map_of_eq _ hb)
  rw [Scheme.presheaf_map_map_apply] at this
  rw [Scheme.presheaf_map_map_apply, Ideal.map_span, Set.image_singleton]
  exact this

variable [SheafOfModules.IsInvertible.{u, u, u} M] [SheafOfModules.IsInvertible.{u, u, u} N] in
/-- For invertible modules the ideals `φ.zeroLocusIdeal` are quasi-coherent. -/
lemma Hom.map_zeroLocusIdeal_basicOpen (φ : M ⟶ N) (W : X.affineOpens) (f : Γ(X, W.1)) :
    (φ.zeroLocusIdeal W.1).map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom =
      φ.zeroLocusIdeal (X.basicOpen f) := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun a ha ↦
    φ.presheaf_map_mem_zeroLocusIdeal _ ha) fun c hc ↦ ?_
  have := W.2.isLocalization_basicOpen f
  obtain ⟨a, ⟨_, k, rfl⟩, rfl⟩ := IsLocalization.exists_mk'_eq (.powers f) c
  refine (IsLocalization.mk'_mem_map_algebraMap_iff (.powers f) _ _ _ _).mpr ?_
  have ha : X.presheaf.map (homOfLE (X.basicOpen_le f)).op a ∈
      φ.zeroLocusIdeal (X.basicOpen f) := by
    have := Ideal.mul_mem_right (algebraMap Γ(X, W.1) Γ(X, X.basicOpen f) (f ^ k)) _ hc
    rwa [IsLocalization.mk'_spec] at this
  let S : Set Γ(X, W.1) := {g | (∃ eM : Γ(M, X.basicOpen g), IsFreeGenerator eM) ∧
    ∃ eN : Γ(N, X.basicOpen g), IsFreeGenerator eN}
  have hS : Ideal.span S = ⊤ := by
    rw [← W.2.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨g, hxg, hg⟩ := exists_basicOpen_isFreeGenerator M N W.2 hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hg⟩, hxg⟩
  -- On each trivializing basic open `D(g)`, some power of `f` times `a` lies in the ideal.
  have key (g : Γ(X, W.1)) : ∃ n : ℕ, g ∈ S → X.presheaf.map (homOfLE (X.basicOpen_le g)).op
      (f ^ n * a) ∈ φ.zeroLocusIdeal (X.basicOpen g) := by
    by_cases hg : g ∈ S
    · obtain ⟨⟨eM, hM⟩, eN, hN⟩ := hg
      obtain ⟨b, hb⟩ := hN.exists_smul_eq (φ.app _ eM)
      have hU : IsAffineOpen (X.basicOpen g) := W.2.basicOpen g
      rw [φ.zeroLocusIdeal_eq_span ⟨_, hU⟩ hM hN hb.symm]
      let f' := X.presheaf.map (homOfLE (X.basicOpen_le g)).op f
      have := hU.isLocalization_basicOpen f'
      have hle : X.basicOpen f' ≤ X.basicOpen f := by
        rw [Scheme.basicOpen_res]
        exact inf_le_right
      have h1 := φ.presheaf_map_mem_zeroLocusIdeal hle ha
      rw [φ.zeroLocusIdeal_eq_span ⟨_, hU.basicOpen f'⟩ (hM.map (X.basicOpen_le f'))
        (hN.map (X.basicOpen_le f')) (φ.app_presheaf_map_of_eq _ hb.symm)] at h1
      have h2 : algebraMap Γ(X, X.basicOpen g) Γ(X, X.basicOpen f')
          (X.presheaf.map (homOfLE (X.basicOpen_le g)).op a) ∈
          (Ideal.span {b}).map (algebraMap Γ(X, X.basicOpen g) Γ(X, X.basicOpen f')) := by
        rw [Ideal.map_span, Set.image_singleton]
        convert h1 using 2
        · rfl
        · exact (Scheme.presheaf_map_map_apply (homOfLE (X.basicOpen_le g))
            (homOfLE (X.basicOpen_le f')) a).trans
            (Scheme.presheaf_map_map_apply (homOfLE (X.basicOpen_le f)) (homOfLE hle) a).symm
      obtain ⟨_, ⟨n, rfl⟩, hn⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (.powers f') _ _ _).mp h2
      refine ⟨n, fun _ ↦ ?_⟩
      rw [map_mul, map_pow]
      exact hn
    · exact ⟨0, fun h ↦ (hg h).elim⟩
  choose n hn using key
  obtain ⟨T, hTS, hT⟩ := (Ideal.span_eq_top_iff_finite S).mp hS
  obtain ⟨m, hm⟩ := Finset.exists_le (T.image n)
  refine ⟨f ^ m, ⟨m, rfl⟩, φ.mem_zeroLocusIdeal_of_forall_exists _ fun x hx ↦ ?_⟩
  obtain ⟨⟨g, hgT⟩, hxg⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((W.2.self_le_iSup_basicOpen_iff.mpr hT) hx)
  refine ⟨_, X.basicOpen_le g, hxg, ?_⟩
  rw [← pow_sub_mul_pow f (hm _ (Finset.mem_image_of_mem n hgT)), mul_assoc, map_mul]
  exact Ideal.mul_mem_left _ _ (hn g (hTS hgT))

/-- If `αP : 𝒪_Z ⟶ P|_Z` and `αQ : 𝒪_Z ≅ Q|_Z` are trivializations over an open immersion `j`,
then `φ : P ⟶ Q` sends the generator `αP 1` to `c • αQ 1`, where `c` is the value at `1` of
the endomorphism `αP ≫ φ|_Z ≫ αQ⁻¹` of `𝒪_Z`. -/
lemma app_app_top_one {Z : Scheme.{u}} (j : Z ⟶ X) [IsOpenImmersion j] {P Q : X.Modules}
    (αP : Modules.unit Z ⟶ P.restrict j) (αQ : Modules.unit Z ≅ Q.restrict j) (φ : P ⟶ Q) :
    φ.app (j ''ᵁ ⊤) ((P.restrictAppIso j ⊤).hom (αP.app ⊤ (1 : Γ(Z, ⊤)))) =
      (j.appIso ⊤).inv ((αP ≫ (restrictFunctor j).map φ ≫ αQ.inv).app ⊤ (1 : Γ(Z, ⊤))) •
        (Q.restrictAppIso j ⊤).hom (αQ.hom.app ⊤ (1 : Γ(Z, ⊤))) := by
  set c : Γ(Z, ⊤) := (αP ≫ (restrictFunctor j).map φ ≫ αQ.inv).app ⊤ (1 : Γ(Z, ⊤))
  have h1 : αP ≫ (restrictFunctor j).map φ =
      (αP ≫ (restrictFunctor j).map φ ≫ αQ.inv) ≫ αQ.hom := by
    simp
  have h2 := congrArg (fun (ψ : Modules.unit Z ⟶ Q.restrict j) ↦ ψ.app ⊤ (1 : Γ(Z, ⊤))) h1
  dsimp only at h2
  simp only [Hom.comp_app, ConcreteCategory.comp_apply] at h2
  have h3 : αQ.hom.app ⊤ c = c • αQ.hom.app ⊤ (1 : Γ(Z, ⊤)) := by
    rw [← Hom.app_smul]
    congr 1
    exact (mul_one c).symm
  rw [← smul_restrictAppIso_hom_apply]
  exact h2.trans h3

/-- On sections, a morphism `α : 𝒪_Z ⟶ Q|_Z` is multiplication with its value at `1`. -/
lemma restrictAppIso_hom_comp_app_comp_appIso_hom {Z : Scheme.{u}} (j : Z ⟶ X)
    [IsOpenImmersion j] {Q : X.Modules} (α : Modules.unit Z ⟶ Q.restrict j) (W : Z.Opens)
    (h : j ''ᵁ W ≤ j ''ᵁ ⊤) :
    (Q.restrictAppIso j W).hom ∘ α.app W ∘ (j.appIso W).hom = fun r : Γ(X, j ''ᵁ W) ↦
      r • Q.presheaf.map (homOfLE h).op ((Q.restrictAppIso j ⊤).hom (α.app ⊤ (1 : Γ(Z, ⊤)))) := by
  funext r
  have h1 : (j.appIso W).hom r =
      (j.appIso W).hom r • (Z.presheaf.map (homOfLE le_top).op (1 : Γ(Z, ⊤))) := by
    rw [map_one]
    exact (mul_one _).symm
  simp only [Function.comp_apply]
  rw [h1, Hom.app_smul, smul_restrictAppIso_hom_apply, Iso.hom_inv_id_apply]
  congr 1
  exact congrArg (Q.restrictAppIso j W).hom
    (Hom.app_presheaf_map α (homOfLE le_top) (1 : Γ(Z, ⊤)))

/-- The value at `1` of a morphism `α : 𝒪_Z ⟶ Q|_Z` along an open immersion `j` is a free
generator of `Q` on the image of `j` if and only if `α` is an isomorphism. -/
lemma isFreeGenerator_iff_isIso {Z : Scheme.{u}} (j : Z ⟶ X) [IsOpenImmersion j]
    {Q : X.Modules} (α : Modules.unit Z ⟶ Q.restrict j) :
    IsFreeGenerator ((Q.restrictAppIso j ⊤).hom (α.app ⊤ (1 : Γ(Z, ⊤)))) ↔ IsIso α := by
  rw [Hom.isIso_iff_isIso_app]
  refine ⟨fun hα W ↦ ?_, fun hα V hV ↦ ?_⟩
  · have hb := hα (j ''ᵁ W) (j.image_mono le_top)
    rw [← restrictAppIso_hom_comp_app_comp_appIso_hom] at hb
    rw [ConcreteCategory.isIso_iff_bijective]
    rw [(ConcreteCategory.bijective_of_isIso _).of_comp_iff'] at hb
    have hc : Function.Bijective (j.appIso W).hom := ConcreteCategory.bijective_of_isIso _
    exact (Function.Bijective.of_comp_iff _ hc).mp hb
  · obtain ⟨W, rfl⟩ : ∃ W, j ''ᵁ W = V := ⟨j ⁻¹ᵁ V, by
      rw [j.image_preimage_eq_opensRange_inf, ← j.image_top_eq_opensRange, inf_eq_right.mpr hV]⟩
    rw [← restrictAppIso_hom_comp_app_comp_appIso_hom]
    exact ((ConcreteCategory.bijective_of_isIso _).comp
      (ConcreteCategory.bijective_of_isIso _)).comp (ConcreteCategory.bijective_of_isIso _)

/-- The global section of `P|_Z`, as a compatible family, given by a section of `P` over the
image of the open immersion `j`. -/
noncomputable def restrictSectionsMk {Z : Scheme.{u}} (j : Z ⟶ X) [IsOpenImmersion j]
    (P : X.Modules) (e : Γ(P, j ''ᵁ ⊤)) : (P.restrict j).sections :=
  PresheafOfModules.sectionsMk
    (fun W ↦ (P.restrict j).val.map (homOfLE le_top : W.unop ⟶ ⊤).op
      ((P.restrictAppIso j ⊤).inv e))
    (fun W _ f ↦ (ConcreteCategory.congr_hom ((P.restrict j).presheaf.map_comp
        (homOfLE le_top : W.unop ⟶ ⊤).op f) _).symm)

/-- The morphism `𝒪_Z ⟶ P|_Z` sending `1` to a section `e` of `P` over the image of the open
immersion `j`. -/
noncomputable def unitToRestrict {Z : Scheme.{u}} (j : Z ⟶ X) [IsOpenImmersion j]
    (P : X.Modules) (e : Γ(P, j ''ᵁ ⊤)) : Modules.unit Z ⟶ P.restrict j :=
  (P.restrict j).unitHomEquiv.symm (restrictSectionsMk j P e)

lemma restrictAppIso_hom_unitToRestrict_app_top {Z : Scheme.{u}} (j : Z ⟶ X)
    [IsOpenImmersion j] (P : X.Modules) (e : Γ(P, j ''ᵁ ⊤)) :
    (P.restrictAppIso j ⊤).hom ((unitToRestrict j P e).app ⊤ (1 : Γ(Z, ⊤))) = e := by
  have := congrArg (fun s ↦ s.val (Opposite.op ⊤))
    ((P.restrict j).unitHomEquiv.apply_symm_apply (restrictSectionsMk j P e))
  rw [SheafOfModules.unitHomEquiv_apply_coe] at this
  refine (congrArg (P.restrictAppIso j ⊤).hom this).trans ?_
  have h1 : (P.restrict j).presheaf.map (homOfLE le_top : (⊤ : Z.Opens) ⟶ ⊤).op =
      𝟙 _ := by
    rw [← (P.restrict j).presheaf.map_id]
    rfl
  exact (congrArg (P.restrictAppIso j ⊤).hom
    (ConcreteCategory.congr_hom h1 ((P.restrictAppIso j ⊤).inv e))).trans
    (Iso.inv_hom_id_apply _ _)

/-- Restricting to an open `U` and then pulling back along `g ∣_ U` is pulling back along `g`
and then restricting to `g ⁻¹ᵁ U`. -/
noncomputable def restrictFunctorCompPullbackIso {Y : Scheme.{u}} (g : Y ⟶ X) (U : X.Opens) :
    restrictFunctor U.ι ⋙ pullback (g ∣_ U) ≅ pullback g ⋙ restrictFunctor (g ⁻¹ᵁ U).ι :=
  Functor.isoWhiskerRight (restrictFunctorIsoPullback U.ι) (pullback (g ∣_ U)) ≪≫
    pullbackComp (g ∣_ U) U.ι ≪≫ pullbackCongr (morphismRestrict_ι g U) ≪≫
    (pullbackComp (g ⁻¹ᵁ U).ι g).symm ≪≫
    Functor.isoWhiskerLeft (pullback g) (restrictFunctorIsoPullback (g ⁻¹ᵁ U).ι).symm

/-- **Free generators pull back to free generators.** If `M` and `N` have free generators
`eM` and `eN` on `W` and `φ(eM) = b • eN`, then `g^* M` and `g^* N` have free generators on
`g ⁻¹ᵁ W` on which `g^* φ` has coefficient `g^♯ b`. -/
lemma IsFreeGenerator.exists_pullback {Y : Scheme.{u}} (g : Y ⟶ X)
    (φ : M ⟶ N) {W : X.Opens} {eM : Γ(M, W)} {eN : Γ(N, W)} (hM : IsFreeGenerator eM)
    (hN : IsFreeGenerator eN) {b : Γ(X, W)} (hb : φ.app W eM = b • eN) :
    ∃ (eM' : Γ((pullback g).obj M, g ⁻¹ᵁ W)) (eN' : Γ((pullback g).obj N, g ⁻¹ᵁ W)),
      IsFreeGenerator eM' ∧ IsFreeGenerator eN' ∧
        ((pullback g).map φ).app (g ⁻¹ᵁ W) eM' = g.app W b • eN' := by
  have hW : W.ι ''ᵁ ⊤ ≤ W := (Opens.ι_image_top W).le
  set αM := unitToRestrict W.ι M (M.presheaf.map (homOfLE hW).op eM)
  set αN := unitToRestrict W.ι N (N.presheaf.map (homOfLE hW).op eN)
  have hαM : IsIso αM := by
    rw [← isFreeGenerator_iff_isIso, restrictAppIso_hom_unitToRestrict_app_top]
    exact hM.map hW
  have hαN : IsIso αN := by
    rw [← isFreeGenerator_iff_isIso, restrictAppIso_hom_unitToRestrict_app_top]
    exact hN.map hW
  set F := αM ≫ (restrictFunctor W.ι).map φ ≫ inv αN
  have hF : (W.ι.appIso ⊤).inv (F.app ⊤ (1 : Γ(W.toScheme, ⊤))) =
      X.presheaf.map (homOfLE hW).op b := by
    have h1 := app_app_top_one W.ι αM (asIso αN) φ
    rw [asIso_hom, restrictAppIso_hom_unitToRestrict_app_top,
      restrictAppIso_hom_unitToRestrict_app_top, Hom.app_presheaf_map, hb, map_smul] at h1
    exact ((hN.map hW).smul_left_injective h1).symm
  set κ := restrictFunctorCompPullbackIso g W
  set αM' : Modules.unit (g ⁻¹ᵁ W).toScheme ⟶ ((pullback g).obj M).restrict (g ⁻¹ᵁ W).ι :=
    (pullbackObjUnitIso (g ∣_ W)).inv ≫ (pullback (g ∣_ W)).map αM ≫ κ.hom.app M
  set αN' : Modules.unit (g ⁻¹ᵁ W).toScheme ⟶ ((pullback g).obj N).restrict (g ⁻¹ᵁ W).ι :=
    (pullbackObjUnitIso (g ∣_ W)).inv ≫ (pullback (g ∣_ W)).map αN ≫ κ.hom.app N
  have hcoef : αM' ≫ (restrictFunctor (g ⁻¹ᵁ W).ι).map ((pullback g).map φ) ≫ inv αN' =
      (pullbackObjUnitIso (g ∣_ W)).inv ≫ (pullback (g ∣_ W)).map F ≫
        (pullbackObjUnitIso (g ∣_ W)).hom := by
    have := κ.hom.naturality φ
    simp only [Functor.comp_map] at this
    simp only [αM', αN', F, IsIso.inv_comp, Functor.map_comp, Functor.map_inv, Category.assoc]
    rw [← reassoc_of% this]
    simp
  have h2 := app_app_top_one (g ⁻¹ᵁ W).ι αM' (asIso αN') ((pullback g).map φ)
  rw [asIso_hom, asIso_inv, hcoef, pullbackObjUnitIso_conj_app_top] at h2
  have hW' : g ⁻¹ᵁ W ≤ (g ⁻¹ᵁ W).ι ''ᵁ ⊤ := (Opens.ι_image_top _).ge
  refine ⟨_, _, (((isFreeGenerator_iff_isIso _ αM').mpr inferInstance).map hW'),
    (((isFreeGenerator_iff_isIso _ αN').mpr inferInstance).map hW'), ?_⟩
  rw [Hom.app_presheaf_map, h2, map_smul]
  congr 1
  have hid₁ (x : Γ(Y, (g ⁻¹ᵁ W).ι ''ᵁ ⊤)) : ((g ⁻¹ᵁ W).ι.appIso ⊤).inv x = x := by
    rw [Opens.ι_appIso]
    rfl
  have hid₂ (x : Γ(X, W.ι ''ᵁ ⊤)) : (W.ι.appIso ⊤).hom x = x := by
    rw [Opens.ι_appIso]
    rfl
  rw [← Iso.inv_hom_id_apply (W.ι.appIso ⊤) (F.app ⊤ (1 : Γ(W.toScheme, ⊤))), hF, hid₂, hid₁,
    morphismRestrict_appTop]
  have key : X.presheaf.map (homOfLE hW).op ≫ g.app (W.ι ''ᵁ ⊤) ≫
      Y.presheaf.map (eqToHom (image_morphismRestrict_preimage g W ⊤)).op ≫
        Y.presheaf.map (homOfLE hW').op = g.app W := by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.app_eq_appLE]
    rw [Scheme.Hom.map_appLE_assoc, ← Functor.map_comp, Scheme.Hom.appLE_map]
  exact ConcreteCategory.congr_hom key b

/-- The ideals cutting out the zero scheme of `φ` are contained in those of `ψ` when `φ` and `ψ`
are isomorphic arrows. -/
private lemma Hom.zeroLocusIdeal_le_of_iso {M' N' : X.Modules} {φ : M ⟶ N} {ψ : M' ⟶ N'}
    (eM : M ≅ M') (eN : N ≅ N') (w : φ ≫ eN.hom = eM.hom ≫ ψ) (W : X.Opens) :
    φ.zeroLocusIdeal W ≤ ψ.zeroLocusIdeal W := by
  intro a ha
  rw [Hom.mem_zeroLocusIdeal_iff] at ha ⊢
  intro V h x hx y hy b hb
  have w' : eM.inv ≫ φ = ψ ≫ eN.inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← w, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  refine ha V h _ (hx.app_hom eM.symm) _ (hy.app_hom eN.symm) b ?_
  change (eM.inv.app V.1 ≫ φ.app V.1) x = b • eN.inv.app V.1 y
  rw [← Hom.comp_app, w', Hom.comp_app]
  change eN.inv.app V.1 (ψ.app V.1 x) = _
  rw [hb, Hom.app_smul]

/-- **The zero scheme only depends on the isomorphism class of the morphism.** If
`φ : M ⟶ N` and `ψ : M' ⟶ N'` are isomorphic as arrows, then `Z(φ) = Z(ψ)`. -/
theorem Hom.zeroLocus_eq_of_arrowIso {M' N' : X.Modules} (φ : M ⟶ N) (ψ : M' ⟶ N')
    (e : Arrow.mk φ ≅ Arrow.mk ψ) : φ.zeroLocus = ψ.zeroLocus := by
  have w : φ ≫ (Arrow.rightFunc.mapIso e).hom = (Arrow.leftFunc.mapIso e).hom ≫ ψ :=
    e.hom.w.symm
  have w' : ψ ≫ (Arrow.rightFunc.mapIso e).inv = (Arrow.leftFunc.mapIso e).inv ≫ φ := by
    rw [Iso.eq_inv_comp, ← Category.assoc, ← w, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  have := fun W ↦ le_antisymm (Hom.zeroLocusIdeal_le_of_iso _ _ w W)
    (Hom.zeroLocusIdeal_le_of_iso (Arrow.leftFunc.mapIso e).symm
      (Arrow.rightFunc.mapIso e).symm w' W)
  simp only [Hom.zeroLocus, this]

section Properties

variable [SheafOfModules.IsInvertible.{u, u, u} M] [SheafOfModules.IsInvertible.{u, u, u} N]

/-- For invertible modules, the sections of the ideal sheaf `Z(φ)` over an affine open `U` are
`φ.zeroLocusIdeal U`. -/
lemma Hom.ideal_zeroLocus_eq (φ : M ⟶ N) (U : X.affineOpens) :
    φ.zeroLocus.ideal U = φ.zeroLocusIdeal U.1 := by
  let I : X.IdealSheafData :=
    ⟨fun U ↦ φ.zeroLocusIdeal U.1, φ.map_zeroLocusIdeal_basicOpen, _, rfl⟩
  exact congr($(IdealSheafData.ofIdeals_ideal I).ideal U)

/-- **The zero scheme is a closed subscheme with the expected local equations.** On an affine
open `U = Spec A` on which `M` and `N` have free generators `eM` and `eN`, with
`φ(eM) = b • eN`, the ideal of the zero scheme `Z(φ)` is `(b)`, i.e. `Z(φ) ∩ U = Spec(A/(b))`.

(blueprint: `lem-pc-zero-scheme-properties`, part (1)) -/
theorem Hom.ideal_zeroLocus (φ : M ⟶ N) (U : X.affineOpens) {eM : Γ(M, U.1)} {eN : Γ(N, U.1)}
    (hM : IsFreeGenerator eM) (hN : IsFreeGenerator eN) {b : Γ(X, U.1)}
    (hb : φ.app U.1 eM = b • eN) :
    φ.zeroLocus.ideal U = Ideal.span {b} := by
  rw [Hom.ideal_zeroLocus_eq, φ.zeroLocusIdeal_eq_span U hM hN hb]

/-- **The zero scheme commutes with pullback.** For a morphism `g : Y ⟶ X`, the pullback of the
ideal of `Z(φ)` is the ideal of the zero scheme of `g^* φ`: `Z(g^* φ) = Z(φ) ×_X Y`.

The blueprint states this for flat `g`, where it is the identification
`g^* 𝓘_{Z(φ)} = 𝓘_{Z(g^* φ)}` of ideal sheaves; as an equality of closed subschemes it holds
for every `g`.

(blueprint: `lem-pc-zero-scheme-properties`, part (2)) -/
theorem Hom.comap_zeroLocus {Y : Scheme.{u}} (g : Y ⟶ X) (φ : M ⟶ N) :
    φ.zeroLocus.comap g = ((Modules.pullback g).map φ).zeroLocus := by
  have : SheafOfModules.IsInvertible.{u, u, u} ((pullback g).obj M) := .pullback inferInstance
  have : SheafOfModules.IsInvertible.{u, u, u} ((pullback g).obj N) := .pullback inferInstance
  have key (y : Y) : ∃ V : Y.affineOpens, y ∈ V.1 ∧
      (φ.zeroLocus.comap g).ideal V = ((pullback g).map φ).zeroLocus.ideal V := by
    obtain ⟨U₁, hy₁, -, eM, hM⟩ := exists_isFreeGenerator M (x := g y) (W := ⊤) trivial
    obtain ⟨U, hyU, hU, eN, hN⟩ := exists_isFreeGenerator N hy₁
    obtain ⟨b, hb⟩ := hN.exists_smul_eq (φ.app U.1 (M.presheaf.map (homOfLE hU).op eM))
    obtain ⟨V, hVaff, hyV, hVU⟩ :=
      exists_isAffineOpen_mem_and_subset (U := g ⁻¹ᵁ U.1) (x := y) hyU
    obtain ⟨eM', eN', hM', hN', hb'⟩ := (hM.map hU).exists_pullback g φ hN hb.symm
    refine ⟨⟨V, hVaff⟩, hyV, ?_⟩
    rw [IdealSheafData.ideal_comap_appLE _ g U ⟨V, hVaff⟩ hVU,
      Hom.ideal_zeroLocus φ U (hM.map hU) hN hb.symm,
      Hom.ideal_zeroLocus _ ⟨V, hVaff⟩ (hM'.map hVU) (hN'.map hVU) (b := g.appLE U V hVU b),
      Ideal.map_span, Set.image_singleton]
    rw [Hom.app_presheaf_map, hb', map_smul]
    rfl
  choose V hyV hV using key
  have hcov : ⨆ y, (V y).1 = ⊤ := eq_top_iff.mpr fun y _ ↦
    TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hyV y⟩
  exact le_antisymm (IdealSheafData.le_of_iSup_eq_top V hcov fun y ↦ (hV y).le)
    (IdealSheafData.le_of_iSup_eq_top V hcov fun y ↦ (hV y).ge)

/-- **The zero scheme is everything exactly for the zero morphism**: `Z(φ) = X`, i.e. its
ideal is `⊥`, if and only if `φ = 0`.

(blueprint: `lem-pc-zero-scheme-properties`, part (3)) -/
theorem Hom.zeroLocus_eq_bot_iff (φ : M ⟶ N) : φ.zeroLocus = ⊥ ↔ φ = 0 := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · -- `φ` vanishes on every trivializing affine open, hence everywhere.
    have key (x : X) (W : X.Opens) (hx : x ∈ W) : ∃ U : X.affineOpens, x ∈ U.1 ∧ U.1 ≤ W ∧
        ∀ m : Γ(M, U.1), φ.app U.1 m = 0 := by
      obtain ⟨U, hxU, hUW, ⟨eM, hM⟩, eN, hN⟩ := exists_isFreeGenerator₂ M N hx
      obtain ⟨b, hb⟩ := hN.exists_smul_eq (φ.app U.1 eM)
      have hb0 : b = 0 := by
        have := φ.ideal_zeroLocus U hM hN hb.symm
        rw [h, IdealSheafData.ideal_bot] at this
        exact Ideal.span_singleton_eq_bot.mp this.symm
      refine ⟨U, hxU, hUW, fun m ↦ ?_⟩
      obtain ⟨r, rfl⟩ := hM.exists_smul_eq m
      rw [Hom.app_smul, ← hb, hb0, zero_smul, smul_zero]
    refine Modules.hom_ext _ _ fun W ↦ ?_
    ext m
    choose U hxU hUW hU using fun x : W ↦ key x.1 W x.2
    refine TopCat.Sheaf.eq_of_locally_eq' ⟨N.presheaf, N.isSheaf⟩ (fun x ↦ (U x).1) W
      (fun x ↦ homOfLE (hUW x))
      (fun x hx ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxU _⟩) _ _ fun x ↦ ?_
    simp [← Hom.app_presheaf_map, hU]
  · rintro rfl
    choose U hxU _ hM hN using fun x : X ↦
      exists_isFreeGenerator₂ M N (TopologicalSpace.Opens.mem_top x)
    refine le_bot_iff.mp (IdealSheafData.le_of_iSup_eq_top U
      (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU x⟩) fun x ↦ ?_)
    obtain ⟨eM, hM⟩ := hM x
    obtain ⟨eN, hN⟩ := hN x
    rw [Hom.ideal_zeroLocus (0 : M ⟶ N) (U x) hM hN (b := 0) (by simp)]
    simp

/-- The zero scheme of a morphism of invertible modules is locally principal.

(blueprint: `lem-pc-zero-scheme-properties`) -/
theorem Hom.isLocallyPrincipal_zeroLocus (φ : M ⟶ N) : φ.zeroLocus.IsLocallyPrincipal := by
  intro x
  obtain ⟨U, hxU, -, ⟨eM, hM⟩, eN, hN⟩ :=
    exists_isFreeGenerator₂ M N (TopologicalSpace.Opens.mem_top x)
  obtain ⟨b, hb⟩ := hN.exists_smul_eq (φ.app U.1 eM)
  exact ⟨U, hxU, ⟨b, φ.ideal_zeroLocus U hM hN hb.symm⟩⟩

/-- **The zero scheme of a composite contains the zero scheme of the second factor.** For
morphisms `ψ : L ⟶ M` and `φ : M ⟶ N` of invertible modules, `Z(φ) ⊆ Z(ψ ≫ φ)`, i.e. the ideal
of `Z(ψ ≫ φ)` is contained in the ideal of `Z(φ)`: locally `ψ` and `φ` are multiplication by
`b` and `c`, and `(b c) ⊆ (c)`. -/
theorem Hom.zeroLocus_comp_le {L : X.Modules} [SheafOfModules.IsInvertible.{u, u, u} L]
    (ψ : L ⟶ M) (φ : M ⟶ N) : (ψ ≫ φ).zeroLocus ≤ φ.zeroLocus := by
  have key (x : X) : ∃ V : X.affineOpens, x ∈ V.1 ∧
      (ψ ≫ φ).zeroLocus.ideal V ≤ φ.zeroLocus.ideal V := by
    obtain ⟨U, hxU, -, ⟨eM, hM⟩, eN, hN⟩ :=
      exists_isFreeGenerator₂ M N (TopologicalSpace.Opens.mem_top x)
    obtain ⟨V, hxV, hVU, eL, hL⟩ := exists_isFreeGenerator L hxU
    obtain ⟨b, hb⟩ := (hM.map hVU).exists_smul_eq (ψ.app V.1 eL)
    obtain ⟨c, hc⟩ := (hN.map hVU).exists_smul_eq
      (φ.app V.1 (M.presheaf.map (homOfLE hVU).op eM))
    refine ⟨V, hxV, ?_⟩
    rw [Hom.ideal_zeroLocus φ V (hM.map hVU) (hN.map hVU) hc.symm,
      Hom.ideal_zeroLocus (ψ ≫ φ) V hL (hN.map hVU) (b := b * c) ?_]
    · exact Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_left c b)
    · change φ.app V.1 (ψ.app V.1 eL) = _
      rw [← hb, Hom.app_smul, ← hc, mul_smul]
  choose V hxV hV using key
  exact IdealSheafData.le_of_iSup_eq_top V
    (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩) hV

/-- **Twisting by an invertible module does not change the zero scheme.** For a morphism
`φ : M ⟶ N` of invertible modules and an invertible module `P`, `Z(φ ⊗ P) = Z(φ)`: on an open
trivializing `M`, `N` and `P` both morphisms are multiplication by the same coefficient. -/
theorem Hom.zeroLocus_whiskerRight (φ : M ⟶ N) (P : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} P] : (φ ▷ P).zeroLocus = φ.zeroLocus := by
  have := IsInvertible.of_sheafOfModules M
  have := IsInvertible.of_sheafOfModules N
  have := IsInvertible.of_sheafOfModules P
  have := IsInvertible.sheafOfModules_isInvertible (M ⊗ P)
  have := IsInvertible.sheafOfModules_isInvertible (N ⊗ P)
  have key (x : X) : ∃ V : X.affineOpens, x ∈ V.1 ∧
      (φ ▷ P).zeroLocus.ideal V = φ.zeroLocus.ideal V := by
    obtain ⟨U, hxU, -, ⟨eM, hM⟩, eN, hN⟩ :=
      exists_isFreeGenerator₂ M N (TopologicalSpace.Opens.mem_top x)
    obtain ⟨V, hxV, hVU, eP, hP⟩ := exists_isFreeGenerator P hxU
    obtain ⟨b, hb⟩ := (hN.map hVU).exists_smul_eq
      (φ.app V.1 (M.presheaf.map (homOfLE hVU).op eM))
    refine ⟨V, hxV, ?_⟩
    rw [Hom.ideal_zeroLocus φ V (hM.map hVU) (hN.map hVU) hb.symm,
      Hom.ideal_zeroLocus (φ ▷ P) V ((hM.map hVU).tmulSection hP) ((hN.map hVU).tmulSection hP)
        (b := b)]
    rw [whiskerRight_app_tmulSection, ← hb, smul_tmulSection]
  choose V hxV hV using key
  exact IdealSheafData.ext_of_iSup_eq_top V
    (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩) hV

/-- The values of a morphism `ψ : L ⟶ 𝒪_X` from an invertible module over an affine open lie in
the ideal of its zero scheme. -/
lemma Hom.app_mem_ideal_zeroLocus {L : X.Modules} [SheafOfModules.IsInvertible.{u, u, u} L]
    (ψ : L ⟶ Modules.unit X) (V : X.affineOpens) (m : Γ(L, V.1)) :
    ψ.app V.1 m ∈ ψ.zeroLocus.ideal V := by
  have : SheafOfModules.IsInvertible.{u, u, u} (Modules.unit X) :=
    IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  rw [Hom.ideal_zeroLocus_eq, Hom.mem_zeroLocusIdeal_iff]
  intro V' h eL hL e e' b hb
  obtain ⟨r, hr⟩ := hL.exists_smul_eq (L.presheaf.map (homOfLE h).op m)
  let e₀ : Γ(X, V'.1) := e
  have h1 : X.presheaf.map (homOfLE h).op (ψ.app V.1 m) = r * b * e₀ :=
    ((Hom.app_presheaf_map ψ (homOfLE h) m).symm.trans (by rw [← hr, Hom.app_smul, hb])).trans
      (smul_smul r b e)
  rw [h1]
  exact Ideal.mul_mem_right e₀ _ (Ideal.mul_mem_left _ r (Ideal.mem_span_singleton_self b))

/-- **An invertible module mapping to `𝒪_X` along an effective Cartier divisor.** If
`ψ : L ⟶ 𝒪_X` is a morphism from an invertible module whose zero scheme `D = Z(ψ)` is an
effective Cartier divisor, then `ψ` identifies `L` with the ideal sheaf `𝒪_X(-D)`: locally `ψ`
sends a free generator of `L` to a non-zerodivisor generating the ideal of `D`. The isomorphism
factors `ψ` through the inclusion `𝒪_X(-D) ⟶ 𝒪_X`. -/
theorem Hom.exists_iso_toModules_zeroLocus {L : X.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} L] (ψ : L ⟶ Modules.unit X)
    (hψ : ψ.zeroLocus.IsInvertible) :
    ∃ κ : L ≅ ψ.zeroLocus.toModules, κ.hom ≫ ψ.zeroLocus.toModulesι = ψ := by
  have : SheafOfModules.IsInvertible.{u, u, u} (Modules.unit X) :=
    IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  have hzero : ψ ≫ ψ.zeroLocus.toPushforwardSubscheme = 0 := by
    refine Modules.hom_ext _ _ fun W ↦ ?_
    ext m
    have key (x : W) : ∃ V : X.affineOpens, x.1 ∈ V.1 ∧ V.1 ≤ W := by
      obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
        X.isBasis_affineOpens.exists_subset_of_mem_open x.2 W.2
      exact ⟨⟨V, hV⟩, hxV, hVW⟩
    choose V hxV hVW using key
    let T : X.Modules := (SheafOfModules.pushforward ψ.zeroLocus.subschemeι.toRingCatSheafHom).obj
      (SheafOfModules.unit ψ.zeroLocus.subscheme.ringCatSheaf)
    refine TopCat.Sheaf.eq_of_locally_eq' ⟨T.presheaf, T.isSheaf⟩ (fun x ↦ (V x).1) W
      (fun x ↦ homOfLE (hVW x))
      (fun x hx ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxV _⟩) _ _ fun x ↦ ?_
    have h1 := Hom.app_presheaf_map (ψ ≫ ψ.zeroLocus.toPushforwardSubscheme) (homOfLE (hVW x)) m
    have h2 : ψ.zeroLocus.subschemeι.app (V x).1
        (ψ.app (V x).1 (L.presheaf.map (homOfLE (hVW x)).op m)) = 0 := by
      rw [← IdealSheafData.mem_idealOfOpens_iff, IdealSheafData.idealOfOpens_eq_ideal]
      exact ψ.app_mem_ideal_zeroLocus _ _
    refine h1.symm.trans (h2.trans ?_)
    exact (map_zero _).symm
  let κ : L ⟶ ψ.zeroLocus.toModules := kernel.lift _ ψ hzero
  have hκ (U : X.Opens) (m : Γ(L, U)) : ψ.zeroLocus.toModulesι.app U (κ.app U m) = ψ.app U m :=
    congrArg (fun f : L ⟶ Modules.unit X ↦ f.app U m) (kernel.lift_ι _ ψ hzero)
  refine ⟨@asIso _ _ _ _ κ (isIso_of_isFreeGenerator κ fun x ↦ ?_), kernel.lift_ι _ ψ hzero⟩
  obtain ⟨U, hxU, -, e, he⟩ := exists_isFreeGenerator L (TopologicalSpace.Opens.mem_top x)
  refine ⟨U.1, e, hxU, he, hψ.isFreeGenerator _ fun V h ↦ ?_⟩
  rw [hκ]
  refine Hom.ideal_zeroLocus ψ V (he.map h) (isFreeGenerator_one V.1) ?_
  exact (Hom.app_presheaf_map ψ (homOfLE h) e).trans
    (mul_one (X.presheaf.map (homOfLE h).op (ψ.app U.1 e))).symm

/-- **An invertible module mapping to `𝒪_X` along an effective Cartier divisor.** If
`ψ : L ⟶ 𝒪_X` is a morphism from an invertible module whose zero scheme `D = Z(ψ)` is an
effective Cartier divisor, then `L` is isomorphic to the ideal sheaf `𝒪_X(-D)`. -/
theorem Hom.nonempty_iso_toModules_zeroLocus {L : X.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} L] (ψ : L ⟶ Modules.unit X)
    (hψ : ψ.zeroLocus.IsInvertible) : Nonempty (L ≅ ψ.zeroLocus.toModules) :=
  ⟨(ψ.exists_iso_toModules_zeroLocus hψ).choose⟩

/-- **A morphism of invertible modules vanishing exactly along a divisor.** If the zero scheme
`D = Z(φ)` of `φ : M ⟶ N` is an effective Cartier divisor, then `φ` identifies `M` with
`N(-D) = 𝒪_X(-D) ⊗ N`, so that `N ≅ 𝒪_X(D) ⊗ M`, where `𝒪_X(D) = 𝒪_X(-D)ᵛ` is the dual of the
ideal sheaf of `D`.

Locally `φ` is multiplication by a non-zerodivisor `b` generating the ideal of `D`, so `φ` is
injective with image `𝒪_X(-D) · N ≅ 𝒪_X(-D) ⊗ N`; tensoring with `𝒪_X(D)` gives the claim. -/
theorem Hom.nonempty_iso_dual_toModules_tensorObj (φ : M ⟶ N) (hφ : φ.zeroLocus.IsInvertible) :
    Nonempty (N ≅ φ.zeroLocus.toModulesᵛ ⊗ M) := by
  have := IsInvertible.of_sheafOfModules M
  have := IsInvertible.of_sheafOfModules N
  have := IsInvertible.sheafOfModules_isInvertible Nᵛ
  have := IsInvertible.sheafOfModules_isInvertible (M ⊗ Nᵛ)
  -- `ψ : M ⊗ Nᵛ ⟶ N ⊗ Nᵛ ≅ 𝒪_X` has the same zero scheme as `φ`.
  let ψ : M ⊗ Nᵛ ⟶ Modules.unit X := φ ▷ Nᵛ ≫ dualEvaluation N
  have hψ : ψ.zeroLocus = φ.zeroLocus := by
    rw [← φ.zeroLocus_whiskerRight Nᵛ]
    exact (zeroLocus_eq_of_arrowIso (φ ▷ Nᵛ) ψ
      (Arrow.isoMk (Iso.refl _) (asIso (dualEvaluation N) : N ⊗ Nᵛ ≅ Modules.unit X)
        (by simp [ψ]))).symm
  rw [← hψ] at hφ ⊢
  obtain ⟨e⟩ := ψ.nonempty_iso_toModules_zeroLocus hφ
  have := hφ.isInvertible_toModules
  obtain ⟨dN⟩ := nonempty_tensorObj_dual_iso_unit N
  obtain ⟨dJ⟩ := nonempty_tensorObj_dual_iso_unit ψ.zeroLocus.toModules
  exact ⟨(λ_ N).symm ≪≫ whiskerRightIso ((β_ _ _) ≪≫ dJ).symm N ≪≫ α_ _ _ _ ≪≫
    whiskerLeftIso _ (whiskerRightIso e.symm N ≪≫ α_ _ _ _ ≪≫
      whiskerLeftIso M ((β_ _ _) ≪≫ dN) ≪≫ ρ_ M)⟩

/-- The zero scheme of a nonzero morphism of invertible modules on an integral scheme is an
effective Cartier divisor. -/
theorem Hom.isInvertible_zeroLocus [IsIntegral X] {φ : M ⟶ N} (hφ : φ ≠ 0) :
    φ.zeroLocus.IsInvertible :=
  (Hom.isLocallyPrincipal_zeroLocus φ).isInvertible fun h ↦ hφ ((Hom.zeroLocus_eq_bot_iff φ).mp h)

/-- **Uniqueness of the zero scheme.** Let `I` be an ideal sheaf (a closed subscheme of `X`) such
that on every affine open `U = Spec A` on which `M` and `N` have free generators `eM` and `eN`,
with `φ(eM) = b • eN`, the ideal of `I` is `(b)`, i.e. `I ∩ U = Spec(A/(b))`. Then `I = Z(φ)`.

Such affine opens cover every affine open by basic opens
(`AlgebraicGeometry.Scheme.Modules.exists_basicOpen_isFreeGenerator`), and an ideal of `A` is
determined by its localizations on such a cover
(`AlgebraicGeometry.IsAffineOpen.mem_of_forall_exists_basicOpen`); `Z(φ)` has the same local
ideals (`AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`).

(blueprint: `lem-pc-zero-scheme-properties`, part (1), uniqueness) -/
theorem Hom.eq_zeroLocus_of_ideal_eq_span (φ : M ⟶ N) (I : X.IdealSheafData)
    (hI : ∀ (U : X.affineOpens) (eM : Γ(M, U.1)) (eN : Γ(N, U.1)), IsFreeGenerator eM →
      IsFreeGenerator eN → ∀ b : Γ(X, U.1), φ.app U.1 eM = b • eN → I.ideal U = Ideal.span {b}) :
    I = φ.zeroLocus := by
  have hle (J J' : X.IdealSheafData)
      (hJ : ∀ (U : X.affineOpens) (eM : Γ(M, U.1)) (eN : Γ(N, U.1)), IsFreeGenerator eM →
        IsFreeGenerator eN → ∀ b : Γ(X, U.1), φ.app U.1 eM = b • eN →
          J.ideal U = Ideal.span {b})
      (hJ' : ∀ (U : X.affineOpens) (eM : Γ(M, U.1)) (eN : Γ(N, U.1)), IsFreeGenerator eM →
        IsFreeGenerator eN → ∀ b : Γ(X, U.1), φ.app U.1 eM = b • eN →
          J'.ideal U = Ideal.span {b}) : J ≤ J' := by
    intro U a ha
    refine U.2.mem_of_forall_exists_basicOpen _ a fun x hx ↦ ?_
    obtain ⟨g, hxg, ⟨eM, hM⟩, eN, hN⟩ := exists_basicOpen_isFreeGenerator M N U.2 hx
    obtain ⟨b, hb⟩ := hN.exists_smul_eq (φ.app _ eM)
    refine ⟨g, hxg, ?_⟩
    have h := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom ha
    rw [J.map_ideal_basicOpen, hJ (X.affineBasicOpen g) eM eN hM hN b hb.symm,
      ← hJ' (X.affineBasicOpen g) eM eN hM hN b hb.symm, ← J'.map_ideal_basicOpen] at h
    exact h
  have hZ : ∀ (U : X.affineOpens) (eM : Γ(M, U.1)) (eN : Γ(N, U.1)), IsFreeGenerator eM →
      IsFreeGenerator eN → ∀ b : Γ(X, U.1), φ.app U.1 eM = b • eN →
        φ.zeroLocus.ideal U = Ideal.span {b} :=
    fun U _ _ hM hN _ hb ↦ φ.ideal_zeroLocus U hM hN hb
  exact le_antisymm (hle _ _ hI hZ) (hle _ _ hZ hI)

end Properties

end Modules

/-- **An effective Cartier divisor is the zero scheme of its ideal sheaf.** For an invertible
ideal `J`, the zero scheme of the inclusion `J.toModules ⟶ 𝒪_X` is `J`: on an affine open where
`J = (b)`, the inclusion sends the free generator `b` of `J.toModules` to `b • 1`. -/
theorem IdealSheafData.IsInvertible.zeroLocus_toModulesι {X : Scheme.{u}} {J : X.IdealSheafData}
    (hJ : J.IsInvertible) : Modules.Hom.zeroLocus J.toModulesι = J := by
  have := hJ.isInvertible_toModules
  have := Modules.IsInvertible.sheafOfModules_isInvertible J.toModules
  have : SheafOfModules.IsInvertible.{u, u, u} (Modules.unit X) :=
    Modules.IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  have key (x : X) : ∃ U : X.affineOpens, x ∈ U.1 ∧
      (Modules.Hom.zeroLocus J.toModulesι).ideal U = J.ideal U := by
    obtain ⟨U, hxU, b, -, hU⟩ := hJ x
    obtain ⟨s, hs⟩ := J.exists_toModulesι_app_eq (hU ▸ Ideal.mem_span_singleton_self b)
    have he := hJ.isFreeGenerator s fun V h ↦ by
      rw [hs, ← J.map_ideal h, hU, Ideal.map_span, Set.image_singleton]
      rfl
    refine ⟨U, hxU, ?_⟩
    rw [Modules.Hom.ideal_zeroLocus _ U he (Modules.isFreeGenerator_one U.1) (b := b), hU]
    exact hs.trans (mul_one b).symm
  choose U hxU hU using key
  exact IdealSheafData.ext_of_iSup_eq_top U
    (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU x⟩) hU

/-- **The canonical section of `𝒪_X(D)`.** For an effective Cartier divisor `D`, with invertible
ideal sheaf `J = 𝒪_X(-D)`, the dual `𝒪_X(D) = Jᵛ` has a global section `s : 𝒪_X ⟶ 𝒪_X(D)`,
the transpose of the inclusion `J ⟶ 𝒪_X`, whose zero scheme is `D`: on an affine open where
`J = (b)` with `b` a non-zerodivisor, `𝒪_X(D)` is free on the dual generator `b^∨` and
`s = b • b^∨`.

As a witness we take `𝒪_X ≅ J ⊗ Jᵛ ⟶ 𝒪_X ⊗ Jᵛ ≅ Jᵛ`, the inclusion `J ⟶ 𝒪_X` twisted by `Jᵛ`,
whose zero scheme is that of the inclusion, i.e. `D`.

(blueprint: the canonical section `1` of `𝒪(D)` in `lem-pc-universal-adjoint-section`) -/
theorem IdealSheafData.IsInvertible.exists_zeroLocus_eq {X : Scheme.{u}} {J : X.IdealSheafData}
    (hJ : J.IsInvertible) : ∃ s : 𝟙_ X.Modules ⟶ J.toModulesᵛ, Modules.Hom.zeroLocus s = J := by
  have := hJ.isInvertible_toModules
  have := Modules.IsInvertible.sheafOfModules_isInvertible J.toModules
  have : SheafOfModules.IsInvertible.{u, u, u} (Modules.unit X) :=
    Modules.IsInvertible.sheafOfModules_isInvertible (𝟙_ X.Modules)
  have := Modules.IsInvertible.sheafOfModules_isInvertible J.toModulesᵛ
  -- `s : 𝒪_X ≅ J ⊗ Jᵛ ⟶ 𝒪_X ⊗ Jᵛ ≅ Jᵛ` is the inclusion `J ⟶ 𝒪_X` twisted by `Jᵛ`.
  refine ⟨inv (Modules.dualEvaluation J.toModules) ≫ (J.toModulesι ▷ J.toModulesᵛ) ≫
    (λ_ J.toModulesᵛ).hom, ?_⟩
  rw [Modules.Hom.zeroLocus_eq_of_arrowIso _ (J.toModulesι ▷ J.toModulesᵛ)
    (Arrow.isoMk (asIso (Modules.dualEvaluation J.toModules)).symm (λ_ J.toModulesᵛ).symm
      (by simp)), Modules.Hom.zeroLocus_whiskerRight, hJ.zeroLocus_toModulesι]

end AlgebraicGeometry.Scheme
