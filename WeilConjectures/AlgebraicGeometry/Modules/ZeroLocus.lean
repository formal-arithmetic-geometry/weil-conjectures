module

public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.LocallyFree
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

/-!
# The zero scheme of a morphism of invertible modules

Let `φ : ℳ ⟶ 𝒩` be a morphism of invertible `𝒪_X`-modules. On an open `U` on which `ℳ` and `𝒩`
are trivialized by sections `e_ℳ` and `e_𝒩`, the morphism is multiplication by the coefficient
`b ∈ Γ(X, U)` with `φ(e_ℳ) = b • e_𝒩`, and the *zero scheme* `Z(φ) ⊆ X` is the closed subscheme
cut out by `b` on `U`. Its ideal sheaf is `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus φ`.

The zero scheme `Z(s)` of a global section `s` of an invertible module `ℳ` in the sense of the
blueprint is the case `φ = s : 𝒪_X ⟶ ℳ`; more generally, for invertible `ℳ` and `𝒩`, the
section `s` of `𝒩 ⊗ ℳ^{-1}` corresponding to `φ : ℳ ⟶ 𝒩` has `Z(s) = Z(φ)`, since both are cut
out by the coefficient `b` above. Working with the morphism `φ` avoids the tensor-hom
identification `Hom(ℳ, 𝒩) ≅ H⁰(X, 𝒩 ⊗ ℳ^{-1})`, which is not available.

## Implementation notes

A trivialization of `ℳ` on `U` is a section `e ∈ Γ(ℳ, U)` such that `r ↦ r • e|_V` is a
bijection `Γ(X, V) ≃ Γ(ℳ, V)` for every open `V ⊆ U`
(`AlgebraicGeometry.Scheme.Modules.IsFreeGenerator`). The ideal sheaf `Z(φ)` is defined as the
largest quasi-coherent ideal sheaf whose sections over every affine `W` restrict, on each
trivializing affine `V ⊆ W`, into the ideal generated by the coefficient of `φ` on `V`
(`AlgebraicGeometry.Scheme.IdealSheafData.ofIdeals`). This makes it a definition without side
conditions; for invertible `ℳ` and `𝒩` the family of ideals is already quasi-coherent, which is
the content of `AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`.

## Main definitions

- `AlgebraicGeometry.Scheme.Modules.IsFreeGenerator`: a section trivializing a module.
- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus`: the ideal sheaf of the zero scheme `Z(φ)`
  (blueprint `def-pc-zero-scheme`).

## Main statements

The properties of the zero scheme (blueprint `lem-pc-zero-scheme-properties`):

- `AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`: on a trivializing affine open `U`,
  the ideal of `Z(φ)` is generated by the coefficient of `φ`, i.e. `Z(φ) ∩ U = Spec(A/(b))`.
- `AlgebraicGeometry.Scheme.Modules.Hom.comap_zeroLocus`: the zero scheme commutes with
  pullback.
- `AlgebraicGeometry.Scheme.Modules.Hom.zeroLocus_eq_bot_iff`: `Z(φ) = X` if and only if
  `φ = 0`.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme

namespace Modules

variable {X : Scheme.{u}} {M N : X.Modules}

/-- A section `e` of `M` over `U` is a *free generator* of `M` on `U` if every section of `M`
over an open `V ⊆ U` is uniquely of the form `r • e|_V` with `r ∈ Γ(X, V)`; i.e. `e`
trivializes `M|_U ≅ 𝒪_U`. -/
def IsFreeGenerator {U : X.Opens} (e : Γ(M, U)) : Prop :=
  ∀ (V : X.Opens) (h : V ≤ U),
    Function.Bijective fun r : Γ(X, V) ↦ r • M.presheaf.map (homOfLE h).op e

/-- The restriction of a free generator to a smaller open is a free generator. -/
lemma IsFreeGenerator.map {U V : X.Opens} {e : Γ(M, U)} (he : IsFreeGenerator e)
    (h : V ≤ U) : IsFreeGenerator (M.presheaf.map (homOfLE h).op e) :=
  sorry

/-- Two free generators on the same open differ by a unit. -/
lemma IsFreeGenerator.exists_unit_smul_eq {U : X.Opens} {e e' : Γ(M, U)}
    (he : IsFreeGenerator e) (he' : IsFreeGenerator e') : ∃ u : Γ(X, U)ˣ, e' = u.1 • e :=
  sorry

/-- **Invertible modules are locally trivial.** Every point `x` of an open `W` has an affine
open neighbourhood `U ⊆ W` on which an invertible module has a free generator. -/
lemma exists_isFreeGenerator (M : X.Modules) [SheafOfModules.IsInvertible.{u, u, u} M] {x : X}
    {W : X.Opens} (hx : x ∈ W) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ U.1 ≤ W ∧ ∃ e : Γ(M, U.1), IsFreeGenerator e :=
  sorry

/-- The family of ideals defining the zero scheme of `φ : M ⟶ N`: a function `a` on `W` lies in
it if, on every affine `V ⊆ W` on which `M` and `N` have free generators `eM` and `eN`, the
restriction `a|_V` lies in the ideal generated by the coefficient `b` of `φ`, defined by
`φ(eM) = b • eN`. -/
def Hom.zeroLocusIdeal (φ : M ⟶ N) (W : X.Opens) : Ideal Γ(X, W) :=
  ⨅ (V : X.affineOpens) (h : V.1 ≤ W) (eM : Γ(M, V.1)) (_ : IsFreeGenerator eM)
    (eN : Γ(N, V.1)) (_ : IsFreeGenerator eN) (b : Γ(X, V.1)) (_ : φ.app V.1 eM = b • eN),
    (Ideal.span {b}).comap (X.presheaf.map (homOfLE h).op).hom

/-- **The zero scheme of a morphism of invertible modules.** For `φ : M ⟶ N`, the ideal sheaf
`𝓘_{Z(φ)}` which on an affine open `U = Spec A` trivializing `M` and `N`, where `φ` is
multiplication by `b ∈ A`, is the ideal `(b)`; so `Z(φ) ∩ U = Spec(A/(b))`
(`AlgebraicGeometry.Scheme.Modules.Hom.ideal_zeroLocus`).

For a global section `s` of an invertible module `ℳ`, the zero scheme `Z(s)` of the blueprint is
the zero scheme of `s : 𝒪_X ⟶ ℳ`; its ideal is the image of `s^∨ : ℳ^∨ ⟶ 𝒪_X`.

(blueprint: `def-pc-zero-scheme`) -/
def Hom.zeroLocus (φ : M ⟶ N) : X.IdealSheafData :=
  IdealSheafData.ofIdeals fun W ↦ φ.zeroLocusIdeal W.1

section Properties

variable [SheafOfModules.IsInvertible.{u, u, u} M] [SheafOfModules.IsInvertible.{u, u, u} N]

/-- **The zero scheme is a closed subscheme with the expected local equations.** On an affine
open `U = Spec A` on which `M` and `N` have free generators `eM` and `eN`, with
`φ(eM) = b • eN`, the ideal of the zero scheme `Z(φ)` is `(b)`, i.e. `Z(φ) ∩ U = Spec(A/(b))`.

(blueprint: `lem-pc-zero-scheme-properties`, part (1)) -/
theorem Hom.ideal_zeroLocus (φ : M ⟶ N) (U : X.affineOpens) {eM : Γ(M, U.1)} {eN : Γ(N, U.1)}
    (hM : IsFreeGenerator eM) (hN : IsFreeGenerator eN) {b : Γ(X, U.1)}
    (hb : φ.app U.1 eM = b • eN) :
    φ.zeroLocus.ideal U = Ideal.span {b} :=
  sorry

/-- **The zero scheme commutes with pullback.** For a morphism `g : Y ⟶ X`, the pullback of the
ideal of `Z(φ)` is the ideal of the zero scheme of `g^* φ`: `Z(g^* φ) = Z(φ) ×_X Y`.

The blueprint states this for flat `g`, where it is the identification
`g^* 𝓘_{Z(φ)} = 𝓘_{Z(g^* φ)}` of ideal sheaves; as an equality of closed subschemes it holds
for every `g`.

(blueprint: `lem-pc-zero-scheme-properties`, part (2)) -/
theorem Hom.comap_zeroLocus {Y : Scheme.{u}} (g : Y ⟶ X) (φ : M ⟶ N) :
    φ.zeroLocus.comap g = ((Modules.pullback g).map φ).zeroLocus :=
  sorry

/-- **The zero scheme is everything exactly for the zero morphism**: `Z(φ) = X`, i.e. its
ideal is `⊥`, if and only if `φ = 0`.

(blueprint: `lem-pc-zero-scheme-properties`, part (3)) -/
theorem Hom.zeroLocus_eq_bot_iff (φ : M ⟶ N) : φ.zeroLocus = ⊥ ↔ φ = 0 :=
  sorry

/-- The zero scheme of a morphism of invertible modules is locally principal. -/
theorem Hom.isLocallyPrincipal_zeroLocus (φ : M ⟶ N) : φ.zeroLocus.IsLocallyPrincipal :=
  sorry

end Properties

end Modules

end AlgebraicGeometry.Scheme
