module

public import WeilConjectures.AlgebraicGeometry.Modules.Fiber
public import WeilConjectures.AlgebraicGeometry.Modules.LocallyTrivial

/-!
# Fibrewise criteria for a morphism of line bundles

Let `S` be a scheme and `φ : M ⟶ N` a morphism of invertible sheaves of `𝒪_S`-modules. This file
reads `φ` on the fibres: `φ(s) : M(s) ⟶ N(s)` is `AlgebraicGeometry.Scheme.Modules.fiberMap φ s`,
a linear map between one-dimensional `κ(s)`-vector spaces, and proves the three facts about the
*degeneracy locus* `{s : φ(s) = 0}` that the seesaw theorem and the theorem of the cube use: it
is closed, if it is empty then `φ` is an isomorphism, and — on a reduced scheme — if it is
everything then `φ` is zero.

All three proofs go through the local normal form
`AlgebraicGeometry.Scheme.Modules.exists_restrict_eq_homOfSectionTop`: on an open `W`
trivialising `M` and `N`, `φ` is conjugate to multiplication by a function `a ∈ Γ(W, 𝒪_W)`. The
degeneracy locus on `W` is the complement of the basic open subset of `a`, which is closed; the
hypothesis of the second statement says that `a` vanishes nowhere on `W`, hence is a unit of
`Γ(W, 𝒪_W)` by `AlgebraicGeometry.Scheme.isUnit_iff_forall_Γevaluation_ne_zero`; and the
hypothesis of the third says that `a` vanishes everywhere on `W`, hence is zero because `W` is
reduced.

## Main results

- `AlgebraicGeometry.Scheme.Modules.exists_restrict_eq_homOfSectionTop`: **a morphism of line
  bundles is locally multiplication by a function.**
- `AlgebraicGeometry.Scheme.Modules.isClosed_setOf_fiberMap_eq_zero`: **the degeneracy locus of a
  morphism of line bundles is closed.**
- `AlgebraicGeometry.Scheme.Modules.isIso_of_forall_fiberMap_ne_zero`: **a morphism of line
  bundles which is non-zero on every fibre is an isomorphism**, with the characterisation
  `AlgebraicGeometry.Scheme.Modules.isIso_iff_forall_fiberMap_ne_zero`.
- `AlgebraicGeometry.Scheme.Modules.eq_zero_of_forall_fiberMap_eq_zero`: **a morphism of line
  bundles on a reduced scheme which vanishes on every fibre is zero**, with the characterisation
  `AlgebraicGeometry.Scheme.Modules.eq_zero_iff_forall_fiberMap_eq_zero` and the consequence
  `AlgebraicGeometry.Scheme.Modules.exists_fiberMap_homOfSectionTop_ne_zero`: a non-zero global
  section of a line bundle on a reduced scheme is non-zero on some fibre.

The structure-sheaf endomorphism API used throughout is
`AlgebraicGeometry.Scheme.Modules.endSectionRingEquiv` and
`AlgebraicGeometry.Scheme.Modules.homOfSectionTop`.

## TODO

The passage between a fibre and an open subscheme, and between the fibre of the structure sheaf
and a global function, is done here through
`AlgebraicGeometry.Scheme.Modules.fiberMap_restrictFunctor_map_eq_zero_iff` and
`AlgebraicGeometry.Scheme.Modules.fiberMap_eq_zero_iff_evaluation_endSection`. Both would be
immediate from the comparison `F(x) ≅ Fₓ / 𝔪ₓ Fₓ` between the fibre and the stalk, which is
still missing; see the TODO of `WeilConjectures.AlgebraicGeometry.Modules.Vanishing`.

`AlgebraicGeometry.Scheme.Modules.isClosed_setOf_fiberMap_eq_zero` does not need `M` invertible:
it is enough that `M` be of finite type, since the degeneracy locus on an open where `N` is
trivial and `M` is generated by finitely many sections is the complement of the union of the
basic open subsets of their images. Invertibility of `N` is genuinely needed. The same holds of
`AlgebraicGeometry.Scheme.Modules.eq_zero_of_forall_fiberMap_eq_zero`, whose `hM` is used only to
put `φ` in local normal form; without it the proof has to compare a section of `M` over an
arbitrary open with its images in the fibres, which the fibre API does not yet support.

## Blueprint

`lem:cube-trivialising-open`, `lem:cube-degeneracy-closed`, `lem:cube-invertible-fibrewise` and
`lem:cube-vanishing-fibrewise` of
`blueprint/src/version/detailed/curve_estimates/27_theorem_of_the_cube.tex`.
-/

@[expose] public section

universe u

open CategoryTheory SheafOfModules TopologicalSpace

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}} {M N : X.Modules}

/-- **A morphism of line bundles is locally multiplication by a function.** Around every point of
`X` there is an open `W` trivialising both `M` and `N` and a function `a ∈ Γ(W, 𝒪_W)` such that,
after conjugating by the two trivialisations, the restriction of `φ` to `W` is multiplication
by `a`.

```
             φ|_W
    M|_W ───────────→ N|_W
      │                 ↑
   eM │ ≅             ≅ │ eN.symm
      ↓                 │
    𝒪_W ─────────────→ 𝒪_W
             · a
```

This is `lem:cube-trivialising-open` of the blueprint. -/
theorem exists_restrict_eq_homOfSectionTop (hM : M.Invertible) (hN : N.Invertible) (φ : M ⟶ N)
    (x : X) :
    ∃ W : X.Opens, x ∈ W ∧ ∃ (a : Γ(W.toScheme, ⊤))
      (eM : M.restrict W.ι ≅ W.toScheme.structureModules)
      (eN : N.restrict W.ι ≅ W.toScheme.structureModules),
      (restrictFunctor W.ι).map φ =
        eM.hom ≫ homOfSectionTop W.toScheme.structureModules a ≫ eN.inv := by
  obtain ⟨W₁, hx₁, ⟨e₁⟩⟩ := hM.exists_restrict_iso_tensorUnit x
  obtain ⟨W₂, hx₂, ⟨e₂⟩⟩ := hN.exists_restrict_iso_tensorUnit x
  obtain ⟨eM⟩ : Nonempty (M.restrict (W₁ ⊓ W₂).ι ≅ (W₁ ⊓ W₂).toScheme.structureModules) :=
    ⟨restrictIsoTensorUnitOfLE e₁ inf_le_left ≪≫
      SheafOfModules.tensorUnitIso (W₁ ⊓ W₂).toScheme.sheaf⟩
  obtain ⟨eN⟩ : Nonempty (N.restrict (W₁ ⊓ W₂).ι ≅ (W₁ ⊓ W₂).toScheme.structureModules) :=
    ⟨restrictIsoTensorUnitOfLE e₂ inf_le_right ≪≫
      SheafOfModules.tensorUnitIso (W₁ ⊓ W₂).toScheme.sheaf⟩
  refine ⟨W₁ ⊓ W₂, ⟨hx₁, hx₂⟩,
    endSection (eM.inv ≫ (restrictFunctor (W₁ ⊓ W₂).ι).map φ ≫ eN.hom), eM, eN, ?_⟩
  rw [homOfSectionTop_endSection]
  simp

/-- **The degeneracy locus of a morphism of line bundles in local normal form.** If the
restriction of `φ` to an open `W` is conjugate to multiplication by `a ∈ Γ(W, 𝒪_W)`, then `φ`
vanishes on the fibre at a point of `W` exactly when `a` vanishes there. -/
theorem fiberMap_eq_zero_iff_evaluation_of_restrict_eq {W : X.Opens} {a : Γ(W.toScheme, ⊤)}
    {eM : M.restrict W.ι ≅ W.toScheme.structureModules}
    {eN : N.restrict W.ι ≅ W.toScheme.structureModules} (φ : M ⟶ N)
    (hfac : (restrictFunctor W.ι).map φ =
      eM.hom ≫ homOfSectionTop W.toScheme.structureModules a ≫ eN.inv) (y : W.toScheme) :
    fiberMap φ (W.ι y) = 0 ↔ W.toScheme.Γevaluation y a = 0 := by
  rw [← fiberMap_homOfSectionTop_eq_zero_iff, ← fiberMap_restrictFunctor_map_eq_zero_iff W.ι φ y,
    hfac, fiberMap_comp, fiberMap_comp, Preadditive.IsIso.comp_left_eq_zero,
    Preadditive.IsIso.comp_right_eq_zero]

/-- **The degeneracy locus of a morphism of line bundles is closed.** For a morphism
`φ : M ⟶ N` of invertible sheaves of modules on a scheme `X`, the set of points at which the
induced map `M(x) ⟶ N(x)` on fibres vanishes is closed.

This is `lem:cube-degeneracy-closed` of the blueprint. -/
theorem isClosed_setOf_fiberMap_eq_zero (hM : M.Invertible) (hN : N.Invertible) (φ : M ⟶ N) :
    IsClosed {x : X | fiberMap φ x = 0} := by
  choose W hxW a eM eN hfac using exists_restrict_eq_homOfSectionTop hM hN φ
  have hcov : IsOpenCover W := eq_top_iff.2 fun x _ ↦ Opens.mem_iSup.2 ⟨x, hxW x⟩
  rw [hcov.isClosed_iff_coe_preimage]
  intro i
  have hset : (Subtype.val ⁻¹' {z : X | fiberMap φ z = 0} : Set (W i)) =
      (((W i).toScheme.basicOpen (a i) : (W i).toScheme.Opens) : Set (W i))ᶜ := by
    ext y
    simp only [Set.mem_preimage, Set.mem_ofPred_eq, Set.mem_compl_iff, SetLike.mem_coe]
    rw [← Scheme.Opens.ι_apply, fiberMap_eq_zero_iff_evaluation_of_restrict_eq φ (hfac i) y,
      Scheme.Γevaluation_eq_zero_iff_notMem_basicOpen]
  exact hset ▸ ((W i).toScheme.basicOpen (a i)).isOpen.isClosed_compl

/-- **A morphism of line bundles which vanishes on every fibre is zero**, on a reduced scheme.

By `AlgebraicGeometry.Scheme.Modules.exists_restrict_eq_homOfSectionTop` the morphism is locally
multiplication by a function `a`, and the hypothesis says that `a` vanishes at every point, so
`a` is zero because `X` is reduced. Reducedness cannot be dropped: on a non-reduced scheme a
nilpotent multiplier gives a non-zero morphism vanishing on every fibre. -/
theorem eq_zero_of_forall_fiberMap_eq_zero [IsReduced X] (hM : M.Invertible) (hN : N.Invertible)
    (φ : M ⟶ N) (h : ∀ x : X, fiberMap φ x = 0) : φ = 0 := by
  choose W hxW a eM eN hfac using exists_restrict_eq_homOfSectionTop hM hN φ
  have hcov : IsOpenCover W := eq_top_iff.2 fun x _ ↦ Opens.mem_iSup.2 ⟨x, hxW x⟩
  refine eq_zero_of_isOpenCover_restrict hcov φ fun i ↦ ?_
  have ha : a i = 0 := by
    rw [← basicOpen_eq_bot_iff, ← le_bot_iff]
    intro y hy
    exact absurd hy ((Scheme.Γevaluation_eq_zero_iff_notMem_basicOpen _ y (a i)).1
      ((fiberMap_eq_zero_iff_evaluation_of_restrict_eq φ (hfac i) y).1 (h ((W i).ι y))))
  rw [hfac i, ha, ← endSectionRingEquiv_symm_apply, map_zero]
  simp

/-- **The fibrewise criterion for the vanishing of a morphism of line bundles** on a reduced
scheme. -/
theorem eq_zero_iff_forall_fiberMap_eq_zero [IsReduced X] (hM : M.Invertible) (hN : N.Invertible)
    (φ : M ⟶ N) : φ = 0 ↔ ∀ x : X, fiberMap φ x = 0 :=
  ⟨fun h x ↦ by rw [h, fiberMap_zero], eq_zero_of_forall_fiberMap_eq_zero hM hN φ⟩

/-- **A non-zero global section of a line bundle on a reduced scheme is non-zero on some
fibre.** -/
theorem exists_fiberMap_homOfSectionTop_ne_zero [IsReduced X] (hM : M.Invertible) {m : Γ(M, ⊤)}
    (hm : m ≠ 0) : ∃ x : X, fiberMap (homOfSectionTop M m) x ≠ 0 := by
  by_contra hcon
  push Not at hcon
  exact hm ((homOfSectionTop_eq_zero_iff M m).1
    (eq_zero_of_forall_fiberMap_eq_zero (SheafOfModules.invertible_unit X.sheaf) hM _ hcon))

/-- **A morphism of line bundles which is non-zero on every fibre is an isomorphism.** For a
morphism `φ : M ⟶ N` of invertible sheaves of modules on a scheme `X`, if the induced map
`M(x) ⟶ N(x)` on fibres is non-zero at every point `x`, then `φ` is an isomorphism.

This is `lem:cube-invertible-fibrewise` of the blueprint. -/
theorem isIso_of_forall_fiberMap_ne_zero (hM : M.Invertible) (hN : N.Invertible) (φ : M ⟶ N)
    (h : ∀ x : X, fiberMap φ x ≠ 0) : IsIso φ := by
  choose W hxW a eM eN hfac using exists_restrict_eq_homOfSectionTop hM hN φ
  have hcov : IsOpenCover W := eq_top_iff.2 fun x _ ↦ Opens.mem_iSup.2 ⟨x, hxW x⟩
  refine isIso_of_isOpenCover_restrict hcov φ fun i ↦ ?_
  have ha : IsUnit (a i) :=
    ((W i).toScheme.isUnit_iff_forall_Γevaluation_ne_zero (a i)).2 fun y hy ↦
      h ((W i).ι y) ((fiberMap_eq_zero_iff_evaluation_of_restrict_eq φ (hfac i) y).2 hy)
  have hmul : IsIso (homOfSectionTop (W i).toScheme.structureModules (a i)) :=
    (isIso_iff_isUnit_endSection _).2 (by simpa using ha)
  rw [hfac i]
  infer_instance

/-- **The fibrewise criterion for a morphism of line bundles.** A morphism of invertible sheaves
of modules on a scheme is an isomorphism exactly when it is non-zero on every fibre. -/
theorem isIso_iff_forall_fiberMap_ne_zero (hM : M.Invertible) (hN : N.Invertible) (φ : M ⟶ N) :
    IsIso φ ↔ ∀ x : X, fiberMap φ x ≠ 0 := by
  refine ⟨fun hφ x ↦ ?_, isIso_of_forall_fiberMap_ne_zero hM hN φ⟩
  have := nontrivial_fiber hM x
  exact fiberMap_ne_zero_of_isIso φ x

end AlgebraicGeometry.Scheme.Modules
