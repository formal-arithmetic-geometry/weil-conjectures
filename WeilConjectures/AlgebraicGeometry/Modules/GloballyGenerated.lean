module

public import WeilConjectures.AlgebraicGeometry.Modules.PullbackMonoidal
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Stalk
public import WeilConjectures.Mathlib.AlgebraicGeometry.Modules.Sheaf

/-!
# Global generation on stalks, and the pullback of a globally generated sheaf of modules

A sheaf of `𝒪ₓ`-modules generated by its global sections is generated by them **at every point**,
in the sense of `AlgebraicGeometry.Scheme.Modules.IsGloballyGeneratedAt`: the germs at `x` of the
global sections span the stalk over the local ring `𝒪_{X, x}`. This is
`AlgebraicGeometry.Scheme.Modules.isGloballyGeneratedAt` below; the work is done by
`SheafOfModules.exists_germ_eq_mem_span`, which says that every element of a stalk is the germ of
a section which is an `𝒪ₓ`-linear combination of global sections, and all that is left here is to
take germs of such a combination.

Let `f : X ⟶ Y` be a morphism of schemes. The pullback functor
`AlgebraicGeometry.Scheme.Modules.pullback f` sends a free `𝒪ᵧ`-module to a free `𝒪ₓ`-module: it
is monoidal, so sends the structure sheaf to the structure sheaf, and it is a left adjoint, so
commutes with the coproducts a free module is assembled from. Being a left adjoint it also
preserves epimorphisms, and being generated by global sections means being a quotient of a free
module; so the pullback of a globally generated module is globally generated.

## Main results

- `AlgebraicGeometry.Scheme.Modules.isGloballyGeneratedAt`: a sheaf of modules generated by its
  global sections is generated by its global sections at every point.
- `AlgebraicGeometry.Scheme.Modules.pullbackObjFreeIso`: the pullback of the free module on a
  set `I` is the free module on `I`.
- `AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_pullback`: the pullback of a sheaf of
  modules generated by its global sections is generated by its global sections.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

namespace AlgebraicGeometry.Scheme.Modules

variable {X Y : Scheme.{u}} (f : X ⟶ Y) (I : Type u)

set_option backward.isDefEq.respectTransparency.types false in
/-- **The pullback of a free sheaf of modules is free**: the pullback commutes with the
coproduct defining the free module, and takes the structure sheaf, which is the tensor unit, to
the structure sheaf. -/
noncomputable def pullbackObjFreeIso :
    (pullback f).obj (SheafOfModules.free I) ≅ SheafOfModules.free I :=
  (asIso (sigmaComparison (pullback f) (fun _ : I ↦ SheafOfModules.unit _))).symm ≪≫
    Sigma.mapIso fun _ ↦ (pullback f).mapIso (tensorUnitIsoUnit Y).symm ≪≫
      (Functor.Monoidal.εIso (pullback f)).symm ≪≫ tensorUnitIsoUnit X

variable {f I}

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **The pullback of a globally generated sheaf of modules is globally generated**: it is a
quotient of the pullback of a free sheaf of modules, which is again free. -/
instance isGloballyGenerated_pullback (M : Y.Modules) [M.IsGloballyGenerated] :
    ((pullback f).obj M).IsGloballyGenerated := by
  obtain ⟨I, p, hp⟩ := SheafOfModules.isGloballyGenerated_iff_exists.1 ‹M.IsGloballyGenerated›
  have : Epi p := hp
  have : Epi ((pullback f).map p) := inferInstance
  exact SheafOfModules.isGloballyGenerated_iff_exists.2
    ⟨I, (pullbackObjFreeIso f I).inv ≫ (pullback f).map p, epi_comp _ _⟩

/-- **A sheaf of modules generated by its global sections is generated by its global sections at
every point**: the germs at `x` of the global sections of `F` span the stalk `Fₓ` over the local
ring `𝒪_{X, x}`.

By `SheafOfModules.exists_germ_eq_mem_span`, every element of `Fₓ` is the germ of a section over
some open neighbourhood `V` of `x` which is a `Γ(X, V)`-linear combination of restrictions of
global sections; taking germs turns such a combination into an `𝒪_{X, x}`-linear combination of
germs of global sections. -/
theorem isGloballyGeneratedAt (F : X.Modules) [F.IsGloballyGenerated] (x : X) :
    F.IsGloballyGeneratedAt x := by
  refine Submodule.eq_top_iff'.2 fun z ↦ ?_
  obtain ⟨V, hxV, t, ht, hz⟩ := SheafOfModules.exists_germ_eq_mem_span F x z
  replace hz : F.presheaf.germ V x hxV t = z := hz
  subst hz
  induction ht using Submodule.span_induction with
  | mem _ hy =>
      obtain ⟨s, rfl⟩ := hy
      refine Submodule.subset_span ⟨PresheafOfModules.sections.eval s (Opposite.op ⊤), ?_⟩
      exact (F.presheaf.germ_res_apply (homOfLE (le_top (a := V))) x hxV _).symm.trans
        (congrArg _ (s.2 (homOfLE (le_top (a := V))).op))
  | zero => simp
  | add a b _ _ ha hb => simpa [map_add] using Submodule.add_mem _ ha hb
  | smul r a _ ha =>
      rw [germ_smul]
      exact Submodule.smul_mem _ _ ha

end AlgebraicGeometry.Scheme.Modules
