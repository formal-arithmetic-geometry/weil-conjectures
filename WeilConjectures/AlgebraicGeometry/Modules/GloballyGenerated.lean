module

public import WeilConjectures.AlgebraicGeometry.Modules.PullbackMonoidal
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators

/-!
# The pullback of a globally generated sheaf of modules

Let `f : X ⟶ Y` be a morphism of schemes. The pullback functor
`AlgebraicGeometry.Scheme.Modules.pullback f` sends a free `𝒪ᵧ`-module to a free `𝒪ₓ`-module: it
is monoidal, so sends the structure sheaf to the structure sheaf, and it is a left adjoint, so
commutes with the coproducts a free module is assembled from. Being a left adjoint it also
preserves epimorphisms, and being generated by global sections means being a quotient of a free
module; so the pullback of a globally generated module is globally generated.

## Main results

- `AlgebraicGeometry.Scheme.Modules.pullbackObjFreeIso`: the pullback of the free module on a
  set `I` is the free module on `I`.
- `AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_pullback`: the pullback of a sheaf of
  modules generated by its global sections is generated by its global sections.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

namespace AlgebraicGeometry.Scheme.Modules

variable {X Y : Scheme.{u}} (f : X ⟶ Y) (I : Type u)

set_option backward.isDefEq.respectTransparency.types false in
/-- **The pullback of a free sheaf of modules is free**: the pullback commutes with the
coproduct defining the free module, and takes the structure sheaf, which is the tensor unit, to
the structure sheaf. -/
noncomputable def pullbackObjFreeIso :
    (pullback f).obj (SheafOfModules.free I) ≅ SheafOfModules.free I :=
  (asIso (sigmaComparison (pullback f) (fun _ : I ↦ SheafOfModules.unit _))).symm ≪≫
    Sigma.mapIso fun _ ↦ (pullback f).mapIso (tensorUnitIsoUnit Y).symm ≪≫
      (Functor.Monoidal.εIso (pullback f)).symm ≪≫ tensorUnitIsoUnit X

variable {f I}

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **The pullback of a globally generated sheaf of modules is globally generated**: it is a
quotient of the pullback of a free sheaf of modules, which is again free. -/
instance isGloballyGenerated_pullback (M : Y.Modules) [M.IsGloballyGenerated] :
    ((pullback f).obj M).IsGloballyGenerated := by
  obtain ⟨I, p, hp⟩ := SheafOfModules.isGloballyGenerated_iff_exists.1 ‹M.IsGloballyGenerated›
  have : Epi p := hp
  have : Epi ((pullback f).map p) := inferInstance
  exact SheafOfModules.isGloballyGenerated_iff_exists.2
    ⟨I, (pullbackObjFreeIso f I).inv ≫ (pullback f).map p, epi_comp _ _⟩

end AlgebraicGeometry.Scheme.Modules
