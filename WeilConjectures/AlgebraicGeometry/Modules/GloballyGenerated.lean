module

public import WeilConjectures.AlgebraicGeometry.Modules.PullbackMonoidal
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import WeilConjectures.Mathlib.AlgebraicGeometry.Modules.Sheaf

/-!
# A criterion for global generation, and the pullback of a globally generated sheaf

## A criterion for global generation

`SheafOfModules.IsGloballyGenerated` is the existence of an epimorphism from a free sheaf of
modules whose components are global sections. The way such an epimorphism is produced in
practice is local: a family `m : I → Γ(M, ⊤)` of global sections generates `M` as soon as every
section of `M` over every open subset is, locally on that open subset, a `Γ(X, V)`-linear
combination of the restrictions of the `m i`. This is
`AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_of_forall_exists_mem_span`, and it is the
converse of the local surjectivity proved in
`WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Stalk`.

The proof goes through local surjectivity of the classifying morphism `free I ⟶ M`: a morphism
of sheaves of abelian groups on a topological space is an epimorphism exactly when it is locally
surjective (`TopCat.Sheaf.isLocallySurjective_iff_epi`), and the forgetful functor
`SheafOfModules.toSheaf` is faithful, hence reflects epimorphisms. The preimage over `V` of a
combination `∑ᵢ cᵢ • (m i)|_V` is the same combination of the tautological sections of `free I`,
by `SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection`.

## The pullback of a globally generated sheaf of modules

Let `f : X ⟶ Y` be a morphism of schemes. The pullback functor
`AlgebraicGeometry.Scheme.Modules.pullback f` sends a free `𝒪ᵧ`-module to a free `𝒪ₓ`-module: it
is monoidal, so sends the structure sheaf to the structure sheaf, and it is a left adjoint, so
commutes with the coproducts a free module is assembled from. Being a left adjoint it also
preserves epimorphisms, and being generated by global sections means being a quotient of a free
module; so the pullback of a globally generated module is globally generated.

## Main results

- `AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_of_forall_exists_mem_span`: a family of
  global sections which spans the sections of `M` locally over every open subset generates `M`.
- `AlgebraicGeometry.Scheme.Modules.pullbackObjFreeIso`: the pullback of the free module on a
  set `I` is the free module on `I`.
- `AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_pullback`: the pullback of a sheaf of
  modules generated by its global sections is generated by its global sections.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Opposite TopologicalSpace

namespace AlgebraicGeometry.Scheme.Modules

section Criterion

variable {X : Scheme.{u}} {M : X.Modules} {I : Type u}

/-- **A sheaf of modules whose sections are locally spanned by a family of global sections is
generated by that family.** If every section of `M` over every open subset `U` becomes, on a
neighbourhood `V ⊆ U` of any prescribed point, a `Γ(X, V)`-linear combination of the
restrictions of the global sections `m i`, then `M` is generated by its global sections.

This is the converse of `SheafOfModules.exists_mem_span_germ_eq`: the morphism `free I ⟶ M`
classified by the `m i` is locally surjective by hypothesis, hence an epimorphism of sheaves of
abelian groups, hence an epimorphism of sheaves of modules because `SheafOfModules.toSheaf` is
faithful. -/
theorem isGloballyGenerated_of_forall_exists_mem_span (m : I → Γ(M, ⊤))
    (h : ∀ (U : X.Opens) (t : Γ(M, U)) (x : X), x ∈ U →
      ∃ V : X.Opens, ∃ hVU : V ≤ U, x ∈ V ∧
        M.presheaf.map (homOfLE hVU).op t ∈ Submodule.span Γ(X, V)
          (Set.range fun i ↦ M.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (m i))) :
    M.IsGloballyGenerated := by
  set s : I → (M : SheafOfModules.{u} X.ringCatSheaf).sections :=
    fun i ↦ sectionsMkTop M (m i)
  refine SheafOfModules.isGloballyGenerated_iff_exists.2
    ⟨I, (M : SheafOfModules.{u} X.ringCatSheaf).freeHomEquiv.symm s, ?_⟩
  -- a faithful functor reflects epimorphisms, and an epimorphism of sheaves of abelian groups
  -- on a topological space is the same thing as a locally surjective morphism
  refine (SheafOfModules.toSheaf X.ringCatSheaf).epi_of_epi_map ?_
  rw [← TopCat.Sheaf.isLocallySurjective_iff_epi, TopCat.Presheaf.isLocallySurjective_iff]
  intro U t x hx
  obtain ⟨V, hVU, hxV, hmem⟩ := h U t x hx
  -- the tautological section of `free I` at `i` is sent to `m i`
  have hgen : ∀ i, PresheafOfModules.Hom.app
      ((M : SheafOfModules.{u} X.ringCatSheaf).freeHomEquiv.symm s).val (op V)
        (PresheafOfModules.sections.eval
          (SheafOfModules.freeSection (R := X.ringCatSheaf) (I := I) i) (op V)) =
      M.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (m i) := fun i ↦
    congrArg (fun σ ↦ PresheafOfModules.sections.eval σ (op V))
      (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection s i)
  have hle : Submodule.span Γ(X, V)
      (Set.range fun i ↦ M.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (m i)) ≤
      LinearMap.range (PresheafOfModules.Hom.app
        ((M : SheafOfModules.{u} X.ringCatSheaf).freeHomEquiv.symm s).val (op V)).hom := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨_, hgen i⟩
  obtain ⟨u, hu⟩ := hle hmem
  exact ⟨V, hVU, ⟨u, hu⟩, hxV⟩

end Criterion

variable {X Y : Scheme.{u}} (f : X ⟶ Y) (I : Type u)

set_option backward.isDefEq.respectTransparency.types false in
/-- **The pullback of a free sheaf of modules is free**: the pullback commutes with the
coproduct defining the free module, and takes the structure sheaf, which is the tensor unit, to
the structure sheaf. -/
noncomputable def pullbackObjFreeIso :
    (pullback f).obj (SheafOfModules.free I) ≅ SheafOfModules.free I :=
  (asIso (sigmaComparison (pullback f) (fun _ : I ↦ SheafOfModules.unit _))).symm ≪≫
    Sigma.mapIso fun _ ↦ (pullback f).mapIso (tensorUnitIsoUnit Y).symm ≪≫
      (Functor.Monoidal.εIso (pullback f)).symm ≪≫ tensorUnitIsoUnit X

variable {f I}

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **The pullback of a globally generated sheaf of modules is globally generated**: it is a
quotient of the pullback of a free sheaf of modules, which is again free. -/
instance isGloballyGenerated_pullback (M : Y.Modules) [M.IsGloballyGenerated] :
    ((pullback f).obj M).IsGloballyGenerated := by
  obtain ⟨I, p, hp⟩ := SheafOfModules.isGloballyGenerated_iff_exists.1 ‹M.IsGloballyGenerated›
  have : Epi p := hp
  have : Epi ((pullback f).map p) := inferInstance
  exact SheafOfModules.isGloballyGenerated_iff_exists.2
    ⟨I, (pullbackObjFreeIso f I).inv ≫ (pullback f).map p, epi_comp _ _⟩

end AlgebraicGeometry.Scheme.Modules
