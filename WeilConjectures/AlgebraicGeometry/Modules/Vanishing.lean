## Blueprint

This file contributes `lem:deg-generic-section`, the genericity step of
`lem:deg-general-hyperplane` of `curve_estimates/28_degree_of_the_isogeny.tex`.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}} (k : Type u) [Field k] [Infinite k]

/-- **A global section avoiding finitely many prescribed points.** Let `X` be a scheme over an
infinite field `k` and let `F` be a sheaf of `𝒪ₓ`-modules. If `Z` is a finite set of points of
`X` at each of which *some* global section of `F` does not vanish, then a *single* global
section of `F` vanishes at no point of `Z`. -/
theorem exists_forall_not_vanishesAt [X.Over (Spec (.of k))] (F : X.Modules) {Z : Set X}
    (hZ : Z.Finite) (hF : ∀ x ∈ Z, ∃ s : Γ(F, ⊤), ¬ F.VanishesAt s x) :
    ∃ s : Γ(F, ⊤), ∀ x ∈ Z, ¬ F.VanishesAt s x := by
  refine Subspace.exists_forall_notMem hZ
    (fun x ↦ Submodule.restrictScalars k (F.vanishingSubmodule x)) fun x hx htop ↦ ?_
  obtain ⟨s, hs⟩ := hF x hx
  exact hs (by simpa using Submodule.eq_top_iff'.1 htop s)

/-- **A global section vanishing at no associated point of a coherent sheaf.** On a quasi-compact
locally Noetherian scheme `X` over an infinite field, a sheaf of modules `L` generated by its
global sections at each associated point of a coherent sheaf `F`, and with non-zero finite
stalks there, has a global section vanishing at none of them.

This is the genericity half of `lem:deg-general-hyperplane`: the associated points of `F` are
finite in number by `AlgebraicGeometry.Scheme.Modules.finite_associatedPoints`, and the
blueprint's hyperplane avoiding them is such a global section of `L = 𝒪(1)|_X`. -/
theorem exists_forall_associatedPoints_not_vanishesAt [X.Over (Spec (.of k))] [CompactSpace X]
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent] (L : X.Modules)
    (hne : F.associatedPoints ⊆ L.support)
    (hfin : ∀ x ∈ F.associatedPoints, Module.Finite (X.presheaf.stalk x) (L.presheaf.stalk x))
    (hgg : ∀ x ∈ F.associatedPoints, L.IsGloballyGeneratedAt x) :
    ∃ s : Γ(L, ⊤), ∀ x ∈ F.associatedPoints, ¬ L.VanishesAt s x :=
  exists_forall_not_vanishesAt k L (finite_associatedPoints F) fun x hx ↦
    have : Nontrivial (L.presheaf.stalk x) := hne hx
    have := hfin x hx
    exists_not_vanishesAt L x (hgg x hx)

/-- **A global section of a globally generated line bundle vanishing at no associated point of a
coherent sheaf.** This is
`AlgebraicGeometry.Scheme.Modules.exists_forall_associatedPoints_not_vanishesAt` for an
invertible `L`, whose hypotheses on `L` are then automatic: the stalks of an invertible sheaf
are non-zero by `SheafOfModules.Invertible.nontrivial_stalk` and finite by
`AlgebraicGeometry.Scheme.Modules.finite_stalk`. It is the form
`lem:deg-general-hyperplane` consumes. -/
theorem exists_forall_associatedPoints_not_vanishesAt_of_invertible [X.Over (Spec (.of k))]
    [CompactSpace X] [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent] {L : X.Modules}
    (hL : L.Invertible) [L.IsGloballyGenerated] :
    ∃ s : Γ(L, ⊤), ∀ x ∈ F.associatedPoints, ¬ L.VanishesAt s x :=
  haveI := hL.isCoherent
  exists_forall_associatedPoints_not_vanishesAt k F L
    (fun x _ ↦ (mem_support_iff L x).2 (hL.nontrivial_stalk x))
    (fun x _ ↦ finite_stalk L x) fun x _ ↦ isGloballyGeneratedAt_of_isGloballyGenerated L x

/-- **A global function whose zero locus avoids the associated points of a coherent sheaf.** This
is `AlgebraicGeometry.Scheme.Modules.exists_forall_associatedPoints_not_vanishesAt` for the
structure sheaf, whose hypotheses on `L` are then automatic. -/
theorem exists_associatedPoints_subset_basicOpen [X.Over (Spec (.of k))] [CompactSpace X]
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent] :
    ∃ g : Γ(X, ⊤), F.associatedPoints ⊆ X.basicOpen g := by
  obtain ⟨g, hg⟩ := exists_forall_associatedPoints_not_vanishesAt k F X.structureModules
    (fun x _ ↦ (mem_support_iff X.structureModules x).2 inferInstance) (fun _ _ ↦ inferInstance)
    fun x _ ↦ isGloballyGeneratedAt_structureModules x
  exact ⟨g, fun x hx ↦ not_not.1 ((vanishesAt_structureModules_iff x g).not.1 (hg x hx))⟩

/-- **A coherent sheaf on a quasi-compact locally Noetherian scheme over an infinite field admits
a global function acting injectively on it.** Multiplication by the function of
`AlgebraicGeometry.Scheme.Modules.exists_associatedPoints_subset_basicOpen` is injective on the
sections over every open subset, by
`AlgebraicGeometry.Scheme.Modules.injective_smul_iff_associatedPoints_subset`. -/
theorem exists_injective_smul_associatedPoints [X.Over (Spec (.of k))] [CompactSpace X]
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent] :
    ∃ g : Γ(X, ⊤), ∀ V : X.Opens,
      Function.Injective fun s : Γ(F, V) ↦ X.presheaf.map V.leTop.op g • s := by
  obtain ⟨g, hg⟩ := exists_associatedPoints_subset_basicOpen k F
  exact ⟨g, (injective_smul_iff_associatedPoints_subset F g).2 hg⟩

end AlgebraicGeometry.Scheme.Modules
