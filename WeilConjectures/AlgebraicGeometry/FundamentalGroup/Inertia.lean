module

public import WeilConjectures.AlgebraicGeometry.FundamentalGroup.Extension
public import WeilConjectures.AlgebraicGeometry.FundamentalGroup.ExtendOverPoints
public import WeilConjectures.AlgebraicGeometry.FundamentalGroup.HomotopyExactSequence

/-!
# The kernel of `π₁(U) → π₁(C)` is generated by the local kernels at the missing points

Let `j : U ⟶ C` be an open immersion whose complement is a finite set `S` of closed points, and
for `z ∈ S` let `V_z = U ∪ {z}`. If the maps `π₁(U) → π₁(V_z)` are surjective (as for a dense
open of a normal scheme), then the kernel of `π₁(U) → π₁(C)` is the closed subgroup generated by
the kernels `I_z` of `π₁(U) → π₁(V_z)`
(`AlgebraicGeometry.Scheme.FiniteEtale.fixingSubgroup_le_topologicalClosure_iSup`): a finite étale
`U`-scheme on which every `I_z` acts trivially extends over every `V_z`, and these extensions glue
to a finite étale `C`-scheme
(`AlgebraicGeometry.Scheme.FiniteEtale.exists_pullback_iso_of_forall_mem`).
-/

@[expose] public section

universe u

open CategoryTheory Limits PreGaloisCategory

namespace AlgebraicGeometry.Scheme.FiniteEtale

variable {C U : Scheme.{u}} [DecidableEq C] (j : U ⟶ C) [IsOpenImmersion j] (S : Finset C)
  (hS : ∀ z ∈ S, IsClosed ({z} : Set C)) (hSU : (Set.range j.base)ᶜ = ↑S)

omit [IsOpenImmersion j] in
include hSU in
lemma range_le_complOpens (T : Finset C) : Set.range j.base ⊆ complOpens S hS T := fun x hx ↦ by
  rw [SetLike.mem_coe, mem_complOpens]
  left
  intro hxS
  have : x ∈ (Set.range j.base)ᶜ := by rw [hSU]; exact hxS
  exact this hx

/-- The open immersion `U ⟶ U ∪ T` into the complement of the points of `S` outside `T`. -/
noncomputable def toComplOpens (T : Finset C) : U ⟶ (complOpens S hS T).toScheme :=
  IsOpenImmersion.lift (complOpens S hS T).ι j (by
    rw [Scheme.Opens.range_ι]
    exact range_le_complOpens j S hS hSU T)

omit [IsOpenImmersion j] in
@[reassoc (attr := simp)]
lemma toComplOpens_ι (T : Finset C) : toComplOpens j S hS hSU T ≫ (complOpens S hS T).ι = j :=
  IsOpenImmersion.lift_fac _ _ _

instance (T : Finset C) : IsOpenImmersion (toComplOpens j S hS hSU T) := by
  have : IsOpenImmersion (toComplOpens j S hS hSU T ≫ (complOpens S hS T).ι) := by
    rw [toComplOpens_ι]
    infer_instance
  exact .of_comp _ (complOpens S hS T).ι

omit [IsOpenImmersion j] in
lemma toComplOpens_comp_homOfLE {T T' : Finset C} (h : T ⊆ T') :
    toComplOpens j S hS hSU T ≫ C.homOfLE (complOpens_mono S hS h) =
      toComplOpens j S hS hSU T' := by
  rw [← cancel_mono (complOpens S hS T').ι]
  simp

instance : IsIso (toComplOpens j S hS hSU ∅) := by
  rw [isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun x ↦ ?_⟩⟩
  have hx : (complOpens S hS ∅).ι x ∈ Set.range j.base := by
    by_contra h
    have h' : (complOpens S hS ∅).ι x ∈ (Set.range j.base)ᶜ := h
    rw [hSU] at h'
    have := x.2
    rw [mem_complOpens] at this
    rcases this with h₁ | h₁
    · exact h₁ h'
    · exact Finset.notMem_empty _ h₁
  obtain ⟨y, hy⟩ := hx
  refine ⟨y, (complOpens S hS ∅).ι.isOpenEmbedding.injective ?_⟩
  rw [← Scheme.Hom.comp_apply, toComplOpens_ι, hy]

/-- A finite étale `U`-scheme which extends over `U ∪ {z}` for every missing point `z` extends
over `C`. -/
theorem exists_pullback_iso_of_forall_mem' (Z : U.FiniteEtale)
    (hZ : ∀ z ∈ S, ∃ Zz : (complOpens S hS {z}).toScheme.FiniteEtale,
      Nonempty ((pullback (toComplOpens j S hS hSU {z})).obj Zz ≅ Z)) :
    ∃ P : C.FiniteEtale, Nonempty ((pullback j).obj P ≅ Z) := by
  let e := toComplOpens j S hS hSU ∅
  let Z' := (pullback (inv e)).obj Z
  have hZ' (Q : U.FiniteEtale) (eQ : Q ≅ Z) : (pullback (inv e)).obj Q ≅ Z' :=
    (pullback (inv e)).mapIso eQ
  -- `pullback (inv e) ∘ pullback e ≅ id`
  have hround (Q : U.FiniteEtale) : (pullback e).obj ((pullback (inv e)).obj Q) ≅ Q :=
    (pullbackCompIso e (inv e) Q).symm ≪≫ eqToIso (by rw [IsIso.hom_inv_id]) ≪≫ pullbackIdIso Q
  obtain ⟨P, ⟨eP⟩⟩ := exists_pullback_iso_of_forall_mem S hS Z' fun z hz ↦ by
    obtain ⟨Zz, ⟨ez⟩⟩ := hZ z hz
    refine ⟨Zz, ⟨?_⟩⟩
    have h : C.homOfLE (complOpens_mono S hS (Finset.empty_subset {z})) =
        inv e ≫ toComplOpens j S hS hSU {z} := by
      rw [IsIso.eq_inv_comp, toComplOpens_comp_homOfLE j S hS hSU (Finset.empty_subset {z})]
    exact eqToIso (by rw [h]) ≪≫ pullbackCompIso _ _ _ ≪≫ (pullback (inv e)).mapIso ez
  refine ⟨P, ⟨?_⟩⟩
  have h : j = e ≫ (complOpens S hS ∅).ι := (toComplOpens_ι j S hS hSU ∅).symm
  exact eqToIso (by rw [h]) ≪≫ pullbackCompIso _ _ _ ≪≫ (pullback e).mapIso eP ≪≫ hround Z

variable [ConnectedSpace U] {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ U)
  (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [∀ P, MulAction G ((fiber s).obj P)] [IsFundamentalGroup (fiber s) G]

open scoped FintypeCatDiscrete in
/-- **The kernel of `π₁(U) → π₁(C)` is generated by the kernels at the missing points**: if `C`
is obtained from `U` by adding finitely many closed points `z`, and `π₁(U) → π₁(U ∪ {z})` is
surjective for every `z`, then an element of `π₁(U)` acting trivially on all finite étale schemes
coming from `C` lies in the closed subgroup generated by the kernels of the maps
`π₁(U) → π₁(U ∪ {z})`. -/
theorem fixingSubgroup_le_topologicalClosure_iSup
    (hV : ∀ z ∈ S, ConnectedSpace (complOpens S hS {z}).toScheme)
    (hconn : ∀ z ∈ S, ∀ P : (complOpens S hS {z}).toScheme.FiniteEtale, IsConnected P →
      IsConnected ((pullback (toComplOpens j S hS hSU {z})).obj P)) :
    fixingSubgroup s j G ≤
      (⨆ z : S, fixingSubgroup s (toComplOpens j S hS hSU {z.1}) G).topologicalClosure := by
  classical
  intro g hg
  set N := (⨆ z : S, fixingSubgroup s (toComplOpens j S hS hSU {z.1}) G).topologicalClosure
  have hNc : IsClosed (N : Set G) := Subgroup.isClosed_topologicalClosure _
  have hNn : N.Normal := Subgroup.is_normal_topologicalClosure _
  refine mem_of_forall_smul_eq_self s G N hNc g fun U' u hu ↦ ?_
  have hcG : ∀ P, ContinuousSMul G ((fiber s).obj P) := fun P ↦
    IsFundamentalGroup.continuous_smul P
  -- the orbit of `u`, on which `N` acts trivially
  let O := MulAction.orbit G u
  have : Fintype O := Fintype.ofFinite _
  have hNO (k : G) (hk : k ∈ N) (v : O) : k • v = v := by
    obtain ⟨v, h, rfl⟩ := v
    apply Subtype.ext
    change k • h • u = h • u
    have : h⁻¹ * k * h ∈ N := by
      simpa using hNn.conj_mem k hk h⁻¹
    rw [← mul_smul, show k * h = h * (h⁻¹ * k * h) by group, mul_smul, hu _ this]
  let Oc : ContAction FintypeCat.{u} G :=
    ⟨Action.FintypeCat.ofMulAction G (FintypeCat.of O), by
      rw [Action.isContinuous_def]
      have : DiscreteTopology ((forget₂ (Action FintypeCat G) TopCat).obj
        (Action.FintypeCat.ofMulAction G (FintypeCat.of O))) := ⟨rfl⟩
      have : DiscreteTopology ((forget₂ FintypeCat TopCat).obj
        (Action.FintypeCat.ofMulAction G (FintypeCat.of O)).V) := ⟨rfl⟩
      have key (v w : O) : IsOpen ((fun k : G ↦ (k • v : O)) ⁻¹' {w}) := by
        have : (fun k : G ↦ (k • v : O)) ⁻¹' {w} =
            (fun k : G ↦ k • (v : (fiber s).obj U')) ⁻¹' {(w : (fiber s).obj U')} := by
          ext k
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact Subtype.ext_iff
        rw [this]
        exact (isOpen_discrete _).preimage (continuous_id.smul continuous_const)
      exact continuous_prod_of_discrete_right.mpr fun v ↦
        continuous_discrete_rng.mpr fun w ↦ key v w⟩
  let E := equivalenceContAction s G
  let Z := E.inverse.obj Oc
  let c := E.counitIso.app Oc
  have hc (k : G) (x : (fiber s).obj Z) : c.hom.hom.hom (k • x) = k • c.hom.hom.hom x :=
    congrArg (fun f ↦ f.hom x) (c.hom.hom.comm k)
  have hcinj : Function.Injective c.hom.hom.hom :=
    (FintypeCat.equivEquivIso.symm ((ObjectProperty.ι _ ⋙ Action.forget _ _).mapIso c)).injective
  have hNZ (k : G) (hk : k ∈ N) (x : (fiber s).obj Z) : k • x = x :=
    hcinj (by rw [hc, hNO k hk])
  -- `Z` extends over every `U ∪ {z}`
  have hZ : ∀ z ∈ S, ∃ Zz : (complOpens S hS {z}).toScheme.FiniteEtale,
      Nonempty ((pullback (toComplOpens j S hS hSU {z})).obj Zz ≅ Z) := by
    intro z hz
    have := hV z hz
    let jz := toComplOpens j S hS hSU {z}
    obtain ⟨Gz, _, _⟩ := exists_isFundamentalGroup (s ≫ jz)
    have hsurj := fundamentalGroupMap_surjective (pullbackFiberIso jz s) Gz G (hconn z hz)
    refine exists_pullback_iso_of_ker_smul (pullbackFiberIso jz s) G Gz hsurj Z fun k hk x ↦ ?_
    rw [ker_fundamentalGroupMap] at hk
    have hk' : k ∈ ⨆ z : S, fixingSubgroup s (toComplOpens j S hS hSU {z.1}) G :=
      Subgroup.mem_iSup_of_mem (S := fun z : S ↦ fixingSubgroup s (toComplOpens j S hS hSU {z.1}) G)
        ⟨z, hz⟩ hk
    exact hNZ k (Subgroup.le_topologicalClosure _ hk') x
  obtain ⟨P, ⟨eP⟩⟩ := exists_pullback_iso_of_forall_mem' j S hS hSU Z hZ
  -- `g` acts trivially on the fibre of `Z`, hence fixes `u`
  have hgZ := smul_eq_self_of_iso s G eP (hg P)
  have h₁ := hc g (c.inv.hom.hom ⟨u, MulAction.mem_orbit_self u⟩)
  have h₂ : c.hom.hom.hom (c.inv.hom.hom ⟨u, MulAction.mem_orbit_self u⟩) =
      ⟨u, MulAction.mem_orbit_self u⟩ :=
    congrArg (fun f ↦ f.hom.hom ⟨u, MulAction.mem_orbit_self u⟩) c.inv_hom_id
  rw [hgZ, h₂] at h₁
  exact congrArg Subtype.val h₁.symm

end AlgebraicGeometry.Scheme.FiniteEtale
