public import WeilConjectures.GroupTheory.WeilGroup

/-!
# The Weil group of a scheme over a finite field

Let `X₀` be a scheme over a finite field `k₀`, with structure morphism `p : X₀ ⟶ Spec k₀`, let
`s : Spec Ω ⟶ X₀` be a geometric point and let `G = π₁(X₀, s)` be a fundamental group of the fibre
functor at `s`. The *Weil group* `W(X₀, s)` is the inverse image in `G` of the infinite cyclic
subgroup of `Gal(k / k₀)` generated by the geometric Frobenius, and its *degree map* records the
exponent of the Frobenius (blueprint `def-wf-weil-group`).

The map `π₁(X₀, s) → Gal(k / k₀)` is realised here through the action of `π₁(X₀, s)` on the
geometric fibres of the *constant covers* `X₀ ×_{k₀} Spec A ⟶ X₀`, `A` a finite étale
`k₀`-algebra (`AlgebraicGeometry.Scheme.FiniteEtale.constantCover`): these covers are the pullbacks
of the finite étale `k₀`-schemes, on whose geometric fibres `Hom_{k₀}(A, Ω)` the Galois group acts
faithfully, by composition. The arithmetic Frobenius `x ↦ x ^ q` of `Ω` acts on
`Hom_{k₀}(A, Ω)` as composition with the `q`-power map of `A`, a `k₀`-algebra automorphism of `A`;
so it is the action on the fibre of the automorphism `1 ×_{k₀} Spec(x ↦ x ^ q)` of the constant
cover (`AlgebraicGeometry.Scheme.FiniteEtale.arithmeticFrobenius`). The geometric Frobenius is its
inverse.

Then `W(X₀, s)` is the fibre product `π₁(X₀, s) ×_{Gal(k / k₀)} ℤ` of `MonoidHom.weilGroup`, for the
action homomorphism `AlgebraicGeometry.Scheme.FiniteEtale.constantCoverAction` and the geometric
Frobenius `AlgebraicGeometry.Scheme.FiniteEtale.geometricFrobenius`: the pairs `(g, n)` such that
`g` acts on the geometric fibre of every constant cover as the `n`-th power of the geometric
Frobenius (`AlgebraicGeometry.Scheme.FiniteEtale.mem_weilGroup_iff`).

## Main definitions

- `AlgebraicGeometry.Scheme.FiniteEtale.constantCover`: the constant cover `X₀ ×_{k₀} Spec A`.
- `AlgebraicGeometry.Scheme.FiniteEtale.arithmeticFrobenius`: the `q`-power Frobenius of `A`, as an
  automorphism of the constant cover.
- `AlgebraicGeometry.Scheme.FiniteEtale.constantCoverAction`: the action of `π₁(X₀, s)` on the
  geometric fibres of the constant covers, the map `π₁(X₀, s) → Gal(k / k₀)`.
- `AlgebraicGeometry.Scheme.FiniteEtale.geometricFrobenius`: the geometric Frobenius.
- `AlgebraicGeometry.Scheme.FiniteEtale.weilGroup`,
  `AlgebraicGeometry.Scheme.FiniteEtale.weilGroupDeg`: the Weil group `W(X₀, s)` and its degree
  map.

## Blueprint

`AlgebraicGeometry.Scheme.FiniteEtale.weilGroup` and
`AlgebraicGeometry.Scheme.FiniteEtale.weilGroupDeg` implement `def-wf-weil-group`
(subsection `sk-d-geometry`). The exactness of `1 → ker → W(X₀, s) → ℤ → 0`
(`lem-wf-weil-group-exact-sequence`) is `MonoidHom.exact_weilGroupDeg`.
-/

@[expose] public section

universe u

open CategoryTheory Limits PreGaloisCategory

namespace AlgebraicGeometry.Scheme.FiniteEtale

variable (k₀ : Type u) [Field k₀]

/-- A finite étale `k₀`-algebra: the coordinate ring of a finite étale `k₀`-scheme. The constant
covers `X₀ ×_{k₀} Spec A` of a `k₀`-scheme `X₀` are indexed by these. -/
abbrev FiniteEtaleAlgebra : Type (u + 1) :=
  {A : CommAlgCat.{u} k₀ // Module.Finite k₀ A ∧ Algebra.Etale k₀ A}

variable {k₀}

namespace FiniteEtaleAlgebra

variable (A : FiniteEtaleAlgebra k₀)

instance : Module.Finite k₀ A.1 := A.2.1

instance : Algebra.Etale k₀ A.1 := A.2.2

/-- The structure morphism `Spec A ⟶ Spec k₀` of a finite étale `k₀`-algebra. -/
noncomputable abbrev specHom : Spec (.of A.1) ⟶ Spec (.of k₀) :=
  Spec.map (CommRingCat.ofHom (algebraMap k₀ A.1))

instance : IsFinite A.specHom :=
  (IsFinite.SpecMap_iff _).2 (RingHom.finite_algebraMap.2 inferInstance)

instance : Etale A.specHom :=
  HasRingHomProperty.Spec_iff.2 (RingHom.etale_algebraMap.2 inferInstance)

/-- A `k₀`-algebra endomorphism `φ` of `A` gives an endomorphism `Spec φ` of `Spec A` over
`Spec k₀`. -/
@[reassoc (attr := simp)]
lemma specMap_comp_specHom (φ : A.1 →ₐ[k₀] A.1) :
    Spec.map (CommRingCat.ofHom (φ : A.1 →+* A.1)) ≫ A.specHom = A.specHom := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext x
  exact φ.commutes x

section Frobenius

variable [Finite k₀]

/-- A finite étale algebra over a finite field is finite. -/
theorem finite : Finite A.1 :=
  have := Fintype.ofFinite k₀
  Module.finite_of_finite k₀

/-- The `q`-power Frobenius of a finite étale algebra `A` over the finite field `k₀` with `q`
elements is a `k₀`-algebra automorphism of `A`: it is injective since `A` is reduced, hence
bijective since `A` is finite. -/
noncomputable def frobenius : A.1 ≃ₐ[k₀] A.1 :=
  have := Fintype.ofFinite k₀
  have := A.finite
  have : _root_.IsReduced A.1 := Algebra.FormallyUnramified.isReduced_of_field k₀ A.1
  .ofBijective (FiniteField.frobeniusAlgHom k₀ A.1) <| Finite.injective_iff_bijective.1 <|
    (injective_iff_map_eq_zero _).2 fun x hx ↦
      IsReduced.eq_zero x ⟨Fintype.card k₀, hx⟩

theorem frobenius_apply (x : A.1) : A.frobenius x = x ^ Nat.card k₀ := by
  rw [@Nat.card_eq_fintype_card k₀ (Fintype.ofFinite k₀)]
  rfl

end Frobenius

end FiniteEtaleAlgebra

variable {X₀ : Scheme.{u}} (p : X₀ ⟶ Spec (.of k₀))

/-- The constant cover `X₀ ×_{k₀} Spec A ⟶ X₀` of a `k₀`-scheme `X₀` attached to a finite étale
`k₀`-algebra `A`, a finite étale `X₀`-scheme: the pullback of the finite étale `k₀`-scheme
`Spec A` along `p : X₀ ⟶ Spec k₀`. (blueprint: `def-wf-weil-group`) -/
noncomputable def constantCover (A : FiniteEtaleAlgebra k₀) : X₀.FiniteEtale :=
  ⟨MorphismProperty.Over.mk ⊤ (pullback.fst p A.specHom) inferInstance,
    inferInstanceAs (IsFinite (pullback.fst p A.specHom))⟩

@[simp]
lemma constantCover_obj_left (A : FiniteEtaleAlgebra k₀) :
    (constantCover p A).obj.left = pullback p A.specHom :=
  rfl

@[simp]
lemma constantCover_obj_hom (A : FiniteEtaleAlgebra k₀) :
    (constantCover p A).obj.hom = pullback.fst p A.specHom :=
  rfl

/-- The endomorphism `1 ×_{k₀} Spec φ` of the constant cover `X₀ ×_{k₀} Spec A` induced by a
`k₀`-algebra endomorphism `φ` of `A`. -/
noncomputable def constantCoverMap (A : FiniteEtaleAlgebra k₀) (φ : A.1 →ₐ[k₀] A.1) :
    constantCover p A ⟶ constantCover p A :=
  ObjectProperty.homMk (MorphismProperty.Over.homMk
    (pullback.map p A.specHom p A.specHom (𝟙 X₀) (Spec.map (CommRingCat.ofHom (φ : A.1 →+* A.1)))
      (𝟙 _) (by simp) (by simp))
    (by simp))

@[simp]
lemma constantCoverMap_hom_left (A : FiniteEtaleAlgebra k₀) (φ : A.1 →ₐ[k₀] A.1) :
    (constantCoverMap p A φ).hom.left =
      pullback.map p A.specHom p A.specHom (𝟙 X₀) (Spec.map (CommRingCat.ofHom (φ : A.1 →+* A.1)))
        (𝟙 _) (by simp) (by simp) :=
  rfl

lemma constantCoverMap_id (A : FiniteEtaleAlgebra k₀) :
    constantCoverMap p A (AlgHom.id k₀ A.1) = 𝟙 _ := by
  apply hom_ext
  change _ = 𝟙 _
  apply pullback.hom_ext <;> simp

lemma constantCoverMap_comp (A : FiniteEtaleAlgebra k₀) (φ ψ : A.1 →ₐ[k₀] A.1) :
    constantCoverMap p A (φ.comp ψ) = constantCoverMap p A φ ≫ constantCoverMap p A ψ := by
  apply hom_ext
  change _ = (constantCoverMap p A φ).hom.left ≫ (constantCoverMap p A ψ).hom.left
  apply pullback.hom_ext
  · simp
  · simp only [constantCoverMap_hom_left, Category.assoc, pullback.lift_snd,
      pullback.lift_snd_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

/-- The automorphism `1 ×_{k₀} Spec e` of the constant cover `X₀ ×_{k₀} Spec A` induced by a
`k₀`-algebra automorphism `e` of `A`. -/
noncomputable def constantCoverIso (A : FiniteEtaleAlgebra k₀) (e : A.1 ≃ₐ[k₀] A.1) :
    constantCover p A ≅ constantCover p A where
  hom := constantCoverMap p A e.toAlgHom
  inv := constantCoverMap p A e.symm.toAlgHom
  hom_inv_id := by
    rw [← constantCoverMap_comp, ← constantCoverMap_id]
    congr 1
    ext x
    simp
  inv_hom_id := by
    rw [← constantCoverMap_comp, ← constantCoverMap_id]
    congr 1
    ext x
    simp

/-- The arithmetic Frobenius of the constant cover `X₀ ×_{k₀} Spec A`: the automorphism
`1 ×_{k₀} Spec(x ↦ x ^ q)`, `q` the number of elements of `k₀`. On the geometric fibre
`Hom_{k₀}(A, Ω)` it acts as composition with the Frobenius `x ↦ x ^ q` of `Ω`.
(blueprint: `def-wf-weil-group`) -/
noncomputable def arithmeticFrobenius [Finite k₀] (A : FiniteEtaleAlgebra k₀) :
    constantCover p A ≅ constantCover p A :=
  constantCoverIso p A A.frobenius

variable {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ X₀)
  (G : Type*) [Group G] [∀ P : X₀.FiniteEtale, MulAction G ((fiber s).obj P)]

/-- The action of the fundamental group `G = π₁(X₀, s)` on the geometric fibres of the constant
covers. It is the map `π₁(X₀, s) → Gal(k / k₀)`, the Galois group being realised through its
faithful action on the geometric fibres `Hom_{k₀}(A, Ω)` of the finite étale `k₀`-schemes.
(blueprint: `def-wf-weil-group`) -/
noncomputable def constantCoverAction :
    G →* ((A : FiniteEtaleAlgebra k₀) → Equiv.Perm ((fiber s).obj (constantCover p A))) :=
  MonoidHom.pi fun _ ↦ MulAction.toPermHom G _

@[simp]
lemma constantCoverAction_apply (g : G) (A : FiniteEtaleAlgebra k₀)
    (x : (fiber s).obj (constantCover p A)) :
    constantCoverAction p s G g A x = g • x :=
  rfl

/-- The geometric Frobenius `Φ`, the inverse of the arithmetic Frobenius, acting on the geometric
fibres of the constant covers. (blueprint: `def-wf-weil-group`) -/
noncomputable def geometricFrobenius [Finite k₀] :
    (A : FiniteEtaleAlgebra k₀) → Equiv.Perm ((fiber s).obj (constantCover p A)) :=
  fun A ↦ (FintypeCat.equivEquivIso.symm ((fiber s).mapIso (arithmeticFrobenius p A)))⁻¹

/-- The arithmetic Frobenius undoes the geometric Frobenius on the geometric fibres. -/
lemma fiber_map_arithmeticFrobenius_geometricFrobenius [Finite k₀] (A : FiniteEtaleAlgebra k₀)
    (x : (fiber s).obj (constantCover p A)) :
    (fiber s).map (arithmeticFrobenius p A).hom (geometricFrobenius p s A x) = x :=
  (FintypeCat.equivEquivIso.symm ((fiber s).mapIso (arithmeticFrobenius p A))).apply_symm_apply x

/-- **The Weil group** `W(X₀, s)` of a geometrically connected scheme `X₀` over a finite field
`k₀`: the inverse image in the fundamental group `G = π₁(X₀, s)` of the infinite cyclic subgroup
of `Gal(k / k₀)` generated by the geometric Frobenius `Φ`, realised as the fibre product
`π₁(X₀, s) ×_{Gal(k / k₀)} ℤ` of pairs `(g, n)` such that `g` acts on the geometric fibres of the
constant covers as `Φ ^ n`.

As in the blueprint, `X₀` is assumed geometrically connected over `k₀`. The subgroup itself
makes sense without this hypothesis, but it is the Weil group only in the geometrically connected
case: only then is `π₁(X₀, s) → Gal(k / k₀)` surjective, so that the degree map
`AlgebraicGeometry.Scheme.FiniteEtale.weilGroupDeg` is surjective
(`MonoidHom.exact_weilGroupDeg`). For `X₀ = Spec 𝔽_{q²}` over `𝔽_q`, for instance, every element
of the subgroup has even degree.
(blueprint: `def-wf-weil-group`) -/
noncomputable abbrev weilGroup [Finite k₀] [GeometricallyConnected p] :
    Subgroup (G × Multiplicative ℤ) :=
  (constantCoverAction p s G).weilGroup (geometricFrobenius p s)

/-- **The degree map** `deg : W(X₀, s) → ℤ`, which records the exponent of the geometric
Frobenius. (blueprint: `def-wf-weil-group`) -/
noncomputable abbrev weilGroupDeg [Finite k₀] [GeometricallyConnected p] :
    weilGroup p s G →* Multiplicative ℤ :=
  (constantCoverAction p s G).weilGroupDeg (geometricFrobenius p s)

/-- A pair `(g, n)` lies in the Weil group if and only if `g` acts on the geometric fibre of every
constant cover as the `n`-th power of the geometric Frobenius. -/
theorem mem_weilGroup_iff [Finite k₀] [GeometricallyConnected p] {x : G × Multiplicative ℤ} :
    x ∈ weilGroup p s G ↔ ∀ (A : FiniteEtaleAlgebra k₀) (y : (fiber s).obj (constantCover p A)),
      x.1 • y = (geometricFrobenius p s A ^ x.2.toAdd) y := by
  rw [MonoidHom.mem_weilGroup, funext_iff]
  refine forall_congr' fun A ↦ ?_
  rw [Equiv.ext_iff]
  rfl

end AlgebraicGeometry.Scheme.FiniteEtale
