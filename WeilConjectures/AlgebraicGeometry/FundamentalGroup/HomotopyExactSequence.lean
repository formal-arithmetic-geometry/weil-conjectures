/-!
# The homotopy exact sequence for a scheme over a finite field

Let `p : C₀ ⟶ Spec K` be a quasi-compact quasi-separated scheme over a finite field `K` and
`C = C₀ ×_K K̄` its geometric fibre, with projection `π : C ⟶ C₀`. The geometric fibre is the
cofiltered limit of the constant covers `C₀ ×_K Spec L` over the finite subextensions `L` of
`K̄ / K` (`AlgebraicGeometry.Scheme.FiniteEtale.isLimitConstantCoverCone`), since `K̄` is the
filtered colimit of these subfields. This file proves the two halves of the homotopy exact
sequence `1 → π₁(C) → π₁(C₀) → Gal(K̄ / K)` (Stacks `0BTX`, SGA 1 IX.6.1) that go beyond
`AlgebraicGeometry.Scheme.FiniteEtale.mem_weilGroup_fundamentalGroupMap`:

* every finite étale `C`-scheme descends to a finite étale scheme over a finite stage
  `C₀ ×_K Spec L`, hence embeds into the base change of a finite étale `C₀`-scheme
  (`AlgebraicGeometry.Scheme.FiniteEtale.exists_hom_pullback_mono`), so that the map
  `π₁(C) → π₁(C₀)` is injective;
* a section over `C` of the base change of a finite étale `C₀`-scheme `U` comes from a morphism
  of `C₀`-schemes `C₀ ×_K Spec L ⟶ U` for some finite subextension `L`
  (`AlgebraicGeometry.Scheme.FiniteEtale.exists_constantCover_hom_of_section`), so that an
  element of `π₁(C₀)` acting trivially on the constant covers lies in the image of `π₁(C)`.

The descent of the finite étale scheme uses the descent of schemes of finite presentation along
cofiltered limits (Stacks `01ZM`) and then fpqc descent of finiteness and étaleness along the
faithfully flat morphism `C ⟶ C₀ ×_K Spec L`.
-/

@[expose] public section

universe u

open CategoryTheory Limits PreGaloisCategory

namespace AlgebraicGeometry.Scheme.FiniteEtale

section Limit

variable (K : Type u) [Field K]

/-- The finite subextensions `L` of `K̄ / K`, ordered by inclusion. -/
abbrev FiniteSubfield : Type u :=
  {L : IntermediateField K (AlgebraicClosure K) // FiniteDimensional K L}

instance FiniteSubfield.instNonempty : Nonempty (FiniteSubfield K) :=
  ⟨⟨⊥, inferInstance⟩⟩

instance FiniteSubfield.instIsDirected : IsDirected (FiniteSubfield K) (· ≤ ·) where
  directed L₁ L₂ := by
    have := L₁.2
    have := L₂.2
    exact ⟨⟨L₁.1 ⊔ L₂.1, IntermediateField.finiteDimensional_sup _ _⟩, le_sup_left (a := L₁.1),
      le_sup_right (a := L₁.1)⟩

/-- Two finite subextensions are contained in a third one. -/
lemma FiniteSubfield.exists_ge {K : Type u} [Field K] (L M : FiniteSubfield K) :
    ∃ N, L ≤ N ∧ M ≤ N :=
  @directed_of _ (· ≤ ·) (FiniteSubfield.instIsDirected K) L M

instance FiniteSubfield.instIsFiltered : IsFiltered (FiniteSubfield K) :=
  @isFiltered_of_directed_le_nonempty _ _ (FiniteSubfield.instIsDirected K) _

variable {K}

/-- The finite subextension `K(x)` of `K̄ / K` generated by an element `x`. -/
noncomputable def FiniteSubfield.adjoin (x : AlgebraicClosure K) : FiniteSubfield K :=
  ⟨IntermediateField.adjoin K {x},
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)⟩

lemma FiniteSubfield.mem_adjoin (x : AlgebraicClosure K) : x ∈ (FiniteSubfield.adjoin x).1 :=
  IntermediateField.mem_adjoin_simple_self K x

variable (K)

/-- The diagram `L ↦ L` of the finite subextensions of `K̄ / K` in `CommRingCat`. -/
@[simps]
noncomputable def finiteSubfieldDiagram : FiniteSubfield K ⥤ CommRingCat.{u} where
  obj L := .of L.1
  map {L L'} f := CommRingCat.ofHom (IntermediateField.inclusion (leOfHom f)).toRingHom

/-- The algebraic closure `K̄` as a cocone over its finite subextensions. -/
@[simps]
noncomputable def finiteSubfieldCocone : Cocone (finiteSubfieldDiagram K) where
  pt := .of (AlgebraicClosure K)
  ι := { app L := CommRingCat.ofHom L.1.val.toRingHom }

variable {K}

/-- The ring homomorphism out of `K̄` induced by a cocone over the finite subextensions:
`x ↦ ι_{K(x)} x`. -/
noncomputable def finiteSubfieldDescFun (s : Cocone (finiteSubfieldDiagram K))
    (x : AlgebraicClosure K) : s.pt :=
  (s.ι.app (FiniteSubfield.adjoin x)).hom ⟨x, FiniteSubfield.mem_adjoin x⟩

lemma finiteSubfieldDescFun_eq (s : Cocone (finiteSubfieldDiagram K)) (L : FiniteSubfield K)
    (x : L.1) : finiteSubfieldDescFun s x = (s.ι.app L).hom x := by
  obtain ⟨M, hLM, hxM⟩ :=
    FiniteSubfield.exists_ge L (FiniteSubfield.adjoin (x : AlgebraicClosure K))
  have h₁ := ConcreteCategory.congr_hom (s.w (homOfLE hLM)) x
  have h₂ := ConcreteCategory.congr_hom (s.w (homOfLE hxM)) ⟨x, FiniteSubfield.mem_adjoin _⟩
  exact h₂.symm.trans h₁

/-- `K̄` is the filtered colimit of its finite subextensions. -/
noncomputable def isColimitFiniteSubfieldCocone : IsColimit (finiteSubfieldCocone K) where
  desc s := CommRingCat.ofHom
    { toFun := finiteSubfieldDescFun s
      map_one' := by
        change finiteSubfieldDescFun s
          ((1 : (⊥ : IntermediateField K (AlgebraicClosure K))) : AlgebraicClosure K) = 1
        rw [finiteSubfieldDescFun_eq s ⟨⊥, inferInstance⟩ 1]
        exact map_one _
      map_mul' x y := by
        obtain ⟨M, hM₁, hM₂⟩ := FiniteSubfield.exists_ge (FiniteSubfield.adjoin x)
          (FiniteSubfield.adjoin y)
        have hx : x ∈ M.1 := hM₁ (FiniteSubfield.mem_adjoin x)
        have hy : y ∈ M.1 := hM₂ (FiniteSubfield.mem_adjoin y)
        rw [finiteSubfieldDescFun_eq s M ⟨x, hx⟩, finiteSubfieldDescFun_eq s M ⟨y, hy⟩]
        exact (finiteSubfieldDescFun_eq s M ⟨x * y, mul_mem hx hy⟩).trans
          (map_mul (s.ι.app M).hom (⟨x, hx⟩ : M.1) ⟨y, hy⟩)
      map_zero' := by
        change finiteSubfieldDescFun s
          ((0 : (⊥ : IntermediateField K (AlgebraicClosure K))) : AlgebraicClosure K) = 0
        rw [finiteSubfieldDescFun_eq s ⟨⊥, inferInstance⟩ 0]
        exact map_zero _
      map_add' x y := by
        obtain ⟨M, hM₁, hM₂⟩ := FiniteSubfield.exists_ge (FiniteSubfield.adjoin x)
          (FiniteSubfield.adjoin y)
        have hx : x ∈ M.1 := hM₁ (FiniteSubfield.mem_adjoin x)
        have hy : y ∈ M.1 := hM₂ (FiniteSubfield.mem_adjoin y)
        rw [finiteSubfieldDescFun_eq s M ⟨x, hx⟩, finiteSubfieldDescFun_eq s M ⟨y, hy⟩]
        exact (finiteSubfieldDescFun_eq s M ⟨x + y, add_mem hx hy⟩).trans
          (map_add (s.ι.app M).hom (⟨x, hx⟩ : M.1) ⟨y, hy⟩) }
  fac s L := by
    ext x
    exact finiteSubfieldDescFun_eq s L x
  uniq s m hm := by
    refine CommRingCat.hom_ext (RingHom.ext fun x ↦ ?_)
    exact (ConcreteCategory.congr_hom (hm (FiniteSubfield.adjoin x))
      ⟨x, FiniteSubfield.mem_adjoin x⟩).trans (finiteSubfieldDescFun_eq s _ _).symm

end Limit

section ConstantCoverLimit

variable {K : Type u} [Field K] [Finite K] {C : Scheme.{u}} (p : C ⟶ Spec (.of K))

/-- A finite subextension `L` of `K̄ / K`, as a finite étale `K`-algebra: it is separable since
`K` is perfect. -/
noncomputable def FiniteSubfield.toFiniteEtaleAlgebra (L : FiniteSubfield K) :
    FiniteEtaleAlgebra K :=
  have := L.2
  ⟨CommAlgCat.of K L.1, inferInstance,
    ⟨Algebra.FormallyEtale.of_isSeparable K L.1,
      Algebra.FinitePresentation.of_finiteType.1 inferInstance⟩⟩

/-- The inclusion of finite subextensions, as a map of finite étale `K`-algebras. -/
noncomputable def FiniteSubfield.inclusion {L L' : FiniteSubfield K} (h : L ≤ L') :
    L.toFiniteEtaleAlgebra.1 →ₐ[K] L'.toFiniteEtaleAlgebra.1 :=
  IntermediateField.inclusion h

omit [Finite K] in
lemma constantCoverHom_id (A : FiniteEtaleAlgebra K) :
    constantCoverHom p (AlgHom.id K A.1) = 𝟙 _ := by
  apply hom_ext
  change _ = 𝟙 (Limits.pullback p A.specHom)
  apply Limits.pullback.hom_ext <;> simp

/-- The constant covers `C₀ ×_K Spec L` over the finite subextensions `L` of `K̄ / K`, as a
cofiltered diagram of finite étale `C₀`-schemes. -/
@[simps]
noncomputable def constantCoverDiagram : (FiniteSubfield K)ᵒᵖ ⥤ C.FiniteEtale where
  obj L := constantCover p L.unop.toFiniteEtaleAlgebra
  map f := constantCoverHom p (FiniteSubfield.inclusion (leOfHom f.unop))
  map_id _ := constantCoverHom_id p _
  map_comp f g := constantCoverHom_comp p (FiniteSubfield.inclusion (leOfHom g.unop))
    (FiniteSubfield.inclusion (leOfHom f.unop))

/-- The underlying diagram of schemes `L ↦ C₀ ×_K Spec L`. -/
@[simps]
noncomputable def constantCoverSchemeDiagram : (FiniteSubfield K)ᵒᵖ ⥤ Scheme.{u} where
  obj L := ((constantCoverDiagram p).obj L).obj.left
  map f := ((constantCoverDiagram p).map f).hom.left
  map_id L := congrArg (fun φ ↦ φ.hom.left) ((constantCoverDiagram p).map_id L)
  map_comp f g := congrArg (fun φ ↦ φ.hom.left) ((constantCoverDiagram p).map_comp f g)

lemma specMap_val_comp_specHom (L : FiniteSubfield K) :
    Spec.map (CommRingCat.ofHom L.1.val.toRingHom) ≫ L.toFiniteEtaleAlgebra.specHom =
      (Scheme.specAlgebraicClosure K).hom := by
  rw [← Spec.map_comp]
  rfl

/-- The projection `C = C₀ ×_K K̄ ⟶ C₀ ×_K Spec L`. -/
noncomputable def geometricFiberToConstantCover (L : FiniteSubfield K) :
    p.geometricFiber ⟶ (constantCover p L.toFiniteEtaleAlgebra).obj.left :=
  Limits.pullback.map p (Scheme.specAlgebraicClosure K).hom p L.toFiniteEtaleAlgebra.specHom
    (𝟙 C) (Spec.map (CommRingCat.ofHom L.1.val.toRingHom)) (𝟙 _) (by simp)
    (by rw [Category.comp_id, specMap_val_comp_specHom])

@[reassoc (attr := simp)]
lemma geometricFiberToConstantCover_fst (L : FiniteSubfield K) :
    geometricFiberToConstantCover p L ≫ Limits.pullback.fst p L.toFiniteEtaleAlgebra.specHom =
      p.geometricFiberProj :=
  (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)

@[reassoc (attr := simp)]
lemma geometricFiberToConstantCover_snd (L : FiniteSubfield K) :
    geometricFiberToConstantCover p L ≫ Limits.pullback.snd p L.toFiniteEtaleAlgebra.specHom =
      p.geometricFiberToAlgebraicClosure ≫ Spec.map (CommRingCat.ofHom L.1.val.toRingHom) :=
  Limits.pullback.lift_snd _ _ _

lemma isPullback_geometricFiberToConstantCover (L : FiniteSubfield K) :
    IsPullback (geometricFiberToConstantCover p L) p.geometricFiberToAlgebraicClosure
      (Limits.pullback.snd p L.toFiniteEtaleAlgebra.specHom)
      (Spec.map (CommRingCat.ofHom L.1.val.toRingHom)) :=
  isPullback_pullback_map p _ _ _ (specMap_val_comp_specHom L)

/-- The geometric fibre `C₀ ×_K K̄` as a cone over the constant covers `C₀ ×_K Spec L`. -/
@[simps]
noncomputable def constantCoverCone : Cone (constantCoverSchemeDiagram p) where
  pt := p.geometricFiber
  π :=
    { app L := geometricFiberToConstantCover p L.unop
      naturality {L L'} f := by
        change 𝟙 _ ≫ geometricFiberToConstantCover p L'.unop =
          geometricFiberToConstantCover p L.unop ≫
            (constantCoverHom p (FiniteSubfield.inclusion (leOfHom f.unop))).hom.left
        rw [Category.id_comp]
        apply Limits.pullback.hom_ext
        · simp
        · simp only [geometricFiberToConstantCover_snd, constantCoverHom_hom_left, Category.assoc,
            Limits.pullback.lift_snd, geometricFiberToConstantCover_snd_assoc, ← Spec.map_comp]
          rfl }

/-- The geometric fibre `C₀ ×_K K̄` is the cofiltered limit of the constant covers
`C₀ ×_K Spec L` over the finite subextensions `L` of `K̄ / K`: base change along `C₀ ⟶ Spec K`
of the limit `Spec K̄ = lim Spec L`. -/
noncomputable def isLimitConstantCoverCone : IsLimit (constantCoverCone p) := by
  have := IsCofiltered.isConnected (FiniteSubfield K)ᵒᵖ
  let D := (finiteSubfieldDiagram K).op ⋙ Scheme.Spec
  let cD : Cone D := Scheme.Spec.mapCone (finiteSubfieldCocone K).op
  have hcD : IsLimit cD := isLimitOfPreserves Scheme.Spec (isColimitFiniteSubfieldCocone).op
  let α : constantCoverSchemeDiagram p ⟶ D :=
    { app L := Limits.pullback.snd p L.unop.toFiniteEtaleAlgebra.specHom
      naturality {L L'} f := by
        change (constantCoverHom p (FiniteSubfield.inclusion (leOfHom f.unop))).hom.left ≫ _ =
          _ ≫ Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (leOfHom f.unop)).toRingHom)
        simp only [constantCoverHom_hom_left, Limits.pullback.lift_snd]
        rfl }
  refine isLimitOfIsPullbackOfIsConnected α (constantCoverCone p) cD
    { hom := p.geometricFiberToAlgebraicClosure
      w L := (isPullback_geometricFiberToConstantCover p L.unop).w.symm } (fun L ↦ ?_) hcD
  exact isPullback_geometricFiberToConstantCover p L.unop

section Stages

lemma isPullback_constantCoverSchemeDiagram_map {L L' : (FiniteSubfield K)ᵒᵖ} (f : L ⟶ L') :
    IsPullback ((constantCoverSchemeDiagram p).map f)
      (Limits.pullback.snd p L.unop.toFiniteEtaleAlgebra.specHom)
      (Limits.pullback.snd p L'.unop.toFiniteEtaleAlgebra.specHom)
      (Spec.map (CommRingCat.ofHom
        (FiniteSubfield.inclusion (leOfHom f.unop) : _ →+* _))) :=
  isPullback_pullback_map p _ _ _ (FiniteEtaleAlgebra.specMap_comp_specHom' _)

instance (L L' : (FiniteSubfield K)ᵒᵖ) (f : L ⟶ L') :
    IsAffineHom ((constantCoverSchemeDiagram p).map f) :=
  MorphismProperty.of_isPullback (isPullback_constantCoverSchemeDiagram_map p f).flip
    inferInstance

variable [CompactSpace C] [QuasiSeparatedSpace C]

instance (L : (FiniteSubfield K)ᵒᵖ) : CompactSpace ((constantCoverSchemeDiagram p).obj L) :=
  QuasiCompact.compactSpace_of_compactSpace
    (Limits.pullback.fst p L.unop.toFiniteEtaleAlgebra.specHom)

instance (L : (FiniteSubfield K)ᵒᵖ) : QuasiSeparatedSpace ((constantCoverSchemeDiagram p).obj L) :=
  quasiSeparatedSpace_of_quasiSeparated
    (Limits.pullback.fst p L.unop.toFiniteEtaleAlgebra.specHom)

end Stages

/-- The projection `C₀ ×_K K̄ ⟶ C₀ ×_K Spec L` is faithfully flat and quasi-compact: it is the base
change of `Spec K̄ ⟶ Spec L`. -/
lemma surjective_flat_quasiCompact_geometricFiberToConstantCover (L : FiniteSubfield K) :
    (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme)
      (geometricFiberToConstantCover p L) := by
  let φ := Spec.map (CommRingCat.ofHom L.1.val.toRingHom)
  have hφ : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme) φ := by
    refine ⟨⟨⟨fun _ ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩, ?_⟩, inferInstance⟩
    have h : (L.1.val.toRingHom : L.1 →+* AlgebraicClosure K) = algebraMap L.1 _ := rfl
    exact HasRingHomProperty.Spec_iff.2 (h ▸ RingHom.flat_algebraMap_iff.2 inferInstance)
  exact MorphismProperty.of_isPullback (isPullback_geometricFiberToConstantCover p L).flip hφ

end ConstantCoverLimit

section Descent

variable {K : Type u} [Field K] [Finite K] {C : Scheme.{u}} (p : C ⟶ Spec (.of K))
  [CompactSpace C] [QuasiSeparatedSpace C]

/-- **Finite étale covers of the geometric fibre descend.** Every finite étale scheme `Q` over
`C = C₀ ×_K K̄` embeds into the base change of a finite étale `C₀`-scheme: it is the base change of
a scheme of finite presentation over a finite stage `C₀ ×_K Spec L` (Stacks `01ZM`), which is
finite étale by fpqc descent along the faithfully flat `C ⟶ C₀ ×_K Spec L`, hence finite étale
over `C₀`, and `Q = Y ×_{C₀ ×_K Spec L} C` embeds into `Y ×_{C₀} C`. -/
theorem exists_hom_pullback_mono (Q : p.geometricFiber.FiniteEtale) :
    ∃ (P : C.FiniteEtale) (φ : Q ⟶ (pullback p.geometricFiberProj).obj P), Mono φ.hom.left := by
  have : IsFinite Q.obj.hom := Q.property
  have : Etale Q.obj.hom := Q.obj.prop
  obtain ⟨L, Y, pY, _, _, _, h, H⟩ :=
    Scheme.exists_isPullback_of_finitePresentation (isLimitConstantCoverCone p) Q.obj.hom
  have hπ := surjective_flat_quasiCompact_geometricFiberToConstantCover p L.unop
  have := IsFinite.descendsAlong_surjective_inf_flat_inf_quasicompact
  have : IsFinite pY := MorphismProperty.of_isPullback_of_descendsAlong (P := @IsFinite) H.flip hπ
    (inferInstanceAs (IsFinite Q.obj.hom))
  have : Etale pY := MorphismProperty.of_isPullback_of_descendsAlong (P := @Etale) H.flip hπ
    (inferInstanceAs (Etale Q.obj.hom))
  have : IsFinite (Limits.pullback.fst p L.unop.toFiniteEtaleAlgebra.specHom) :=
    (constantCover p L.unop.toFiniteEtaleAlgebra).property
  have : Etale (Limits.pullback.fst p L.unop.toFiniteEtaleAlgebra.specHom) :=
    (constantCover p L.unop.toFiniteEtaleAlgebra).obj.prop
  let f : Y ⟶ C := pY ≫ Limits.pullback.fst p L.unop.toFiniteEtaleAlgebra.specHom
  have hfe : Etale f := inferInstance
  have hff : IsFinite f := inferInstance
  let P : C.FiniteEtale := ⟨MorphismProperty.Over.mk ⊤ f hfe, hff⟩
  have hw : h ≫ P.obj.hom = Q.obj.hom ≫ p.geometricFiberProj := by
    change h ≫ pY ≫ _ = _
    rw [← Category.assoc, H.w, Category.assoc]
    exact congrArg (Q.obj.hom ≫ ·) (geometricFiberToConstantCover_fst p L.unop)
  let l : Q.obj.left ⟶ Limits.pullback P.obj.hom p.geometricFiberProj :=
    Limits.pullback.lift h Q.obj.hom hw
  refine ⟨P, ObjectProperty.homMk (MorphismProperty.Over.homMk l
    (Limits.pullback.lift_snd _ _ _)), ⟨fun a b hab ↦ ?_⟩⟩
  have h₁ := congrArg (· ≫ Limits.pullback.fst P.obj.hom p.geometricFiberProj) hab
  have h₂ := congrArg (· ≫ Limits.pullback.snd P.obj.hom p.geometricFiberProj) hab
  simp only [Category.assoc] at h₁ h₂
  change a ≫ l ≫ _ = b ≫ l ≫ _ at h₁ h₂
  rw [Limits.pullback.lift_fst] at h₁
  rw [Limits.pullback.lift_snd] at h₂
  exact H.hom_ext h₁ h₂

/-- **Sections over the geometric fibre descend.** A morphism of `C₀`-schemes from the geometric
fibre `C = C₀ ×_K K̄` to a finite étale `C₀`-scheme `U`, i.e. a section of the base change of `U`
to `C`, factors through the projection to a finite stage `C₀ ×_K Spec L`, by a morphism of finite
étale `C₀`-schemes (Stacks `01ZM`). -/
theorem exists_constantCover_hom_of_section (U : C.FiniteEtale)
    (σ : p.geometricFiber ⟶ U.obj.left) (hσ : σ ≫ U.obj.hom = p.geometricFiberProj) :
    ∃ (L : FiniteSubfield K) (ψ : constantCover p L.toFiniteEtaleAlgebra ⟶ U),
      geometricFiberToConstantCover p L ≫ ψ.hom.left = σ := by
  have : IsFinite U.obj.hom := U.property
  have : Etale U.obj.hom := U.obj.prop
  let i₀ : (FiniteSubfield K)ᵒᵖ := Opposite.op ⟨⊥, inferInstance⟩
  let q₀ : (constantCoverSchemeDiagram p).obj i₀ ⟶ C :=
    Limits.pullback.fst p i₀.unop.toFiniteEtaleAlgebra.specHom
  let pW := Limits.pullback.snd U.obj.hom q₀
  let ψ : Limits.pullback (𝟙 ((constantCoverSchemeDiagram p).obj i₀))
      ((constantCoverCone p).π.app i₀) ⟶ Limits.pullback U.obj.hom q₀ :=
    Limits.pullback.lift (Limits.pullback.snd _ _ ≫ σ) (Limits.pullback.fst _ _) (by
      have hc := Limits.pullback.condition (f := 𝟙 ((constantCoverSchemeDiagram p).obj i₀))
        (g := (constantCoverCone p).π.app i₀)
      rw [Category.assoc, hσ, ← geometricFiberToConstantCover_fst p i₀.unop, ← Category.assoc]
      change (Limits.pullback.snd _ _ ≫ (constantCoverCone p).π.app i₀) ≫ q₀ = _
      rw [← hc, Category.comp_id])
  obtain ⟨j, f, ψj, h₁, h₂⟩ := Scheme.exists_pullback_hom_of_isLimit (isLimitConstantCoverCone p)
    (𝟙 ((constantCoverSchemeDiagram p).obj i₀)) pW ψ (by simp [ψ, pW])
  let Dj := (constantCoverSchemeDiagram p).obj j
  let Df := (constantCoverSchemeDiagram p).map f
  let e : Dj ⟶ Limits.pullback (𝟙 ((constantCoverSchemeDiagram p).obj i₀)) Df :=
    Limits.pullback.lift Df (𝟙 _) (by simp)
  let ψ' : Dj ⟶ U.obj.left := e ≫ ψj ≫ Limits.pullback.fst U.obj.hom q₀
  have hq : Df ≫ q₀ = Limits.pullback.fst p j.unop.toFiniteEtaleAlgebra.specHom := by
    simp [Df, q₀]
  have hψ' : ψ' ≫ U.obj.hom = Limits.pullback.fst p j.unop.toFiniteEtaleAlgebra.specHom := by
    calc ψ' ≫ U.obj.hom = e ≫ (ψj ≫ pW) ≫ q₀ := by
          simp only [ψ', pW, Category.assoc, Limits.pullback.condition]
      _ = _ := by
          rw [h₁, ← hq, Category.comp_id, ← Category.assoc]
          exact congrArg (· ≫ q₀) (Limits.pullback.lift_fst _ _ _)
  refine ⟨j.unop, ObjectProperty.homMk (MorphismProperty.Over.homMk ψ' hψ'), ?_⟩
  change (constantCoverCone p).π.app j ≫ ψ' = σ
  have hw : (constantCoverCone p).π.app j ≫ Df = (constantCoverCone p).π.app i₀ :=
    (constantCoverCone p).w f
  have hE : (constantCoverCone p).π.app j ≫ e =
      Limits.pullback.lift ((constantCoverCone p).π.app i₀) (𝟙 _)
        ((Category.comp_id _).trans (Category.id_comp _).symm) ≫
      Limits.pullback.map (𝟙 ((constantCoverSchemeDiagram p).obj i₀))
        ((constantCoverCone p).π.app i₀) (𝟙 ((constantCoverSchemeDiagram p).obj i₀)) Df (𝟙 _)
        ((constantCoverCone p).π.app j) (𝟙 _) (by simp) ((Category.comp_id _).trans hw.symm) := by
    apply Limits.pullback.hom_ext
    · simpa [e] using hw
    · simp only [e, Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
        Limits.pullback.lift_snd]
      exact (Category.comp_id _).trans (Category.id_comp _).symm
  simp only [ψ', ← Category.assoc, hE]
  rw [Category.assoc _ _ ψj, h₂, Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
    Limits.pullback.lift_snd]
  exact Category.id_comp σ

end Descent

section Injective

variable {K : Type u} [Field K] [Finite K] {C : Scheme.{u}} (p : C ⟶ Spec (.of K))
  [CompactSpace C] [QuasiSeparatedSpace C] [ConnectedSpace C] [ConnectedSpace p.geometricFiber]
  {t : Spec (.of (AlgebraicClosure K)) ⟶ p.geometricFiber} {s : Spec (.of (AlgebraicClosure K)) ⟶ C}
  (τ : pullback p.geometricFiberProj ⋙ fiber t ≅ fiber s)
  (G' : Type u) [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G'] [CompactSpace G']
  [∀ P, MulAction G' ((fiber t).obj P)] [IsFundamentalGroup (fiber t) G']
  (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [∀ P, MulAction G ((fiber s).obj P)] [IsFundamentalGroup (fiber s) G]

/-- **The map `π₁(C₀ ×_K K̄) → π₁(C₀)` is injective**: every finite étale scheme over the geometric
fibre embeds into the base change of a finite étale `C₀`-scheme. -/
theorem fundamentalGroupMap_injective_geometricFiber :
    Function.Injective (fundamentalGroupMap τ G' G) := by
  refine (injective_iff_map_eq_one _).2 fun g hg ↦
    IsFundamentalGroup.non_trivial (F := fiber t) g fun Q y ↦ ?_
  obtain ⟨P, φ, hφ⟩ := exists_hom_pullback_mono p Q
  have htriv (z : (fiber t).obj ((pullback p.geometricFiberProj).obj P)) : g • z = z := by
    have h := fundamentalGroupMap_smul τ G' G g P z
    rw [hg, one_smul] at h
    exact ((ConcreteCategory.isIso_iff_bijective _).1 inferInstance).1 h.symm
  have hinj : Function.Injective ((fiber t).map φ) := fun a b hab ↦ fiber_ext t <| by
    have := congrArg (fun z ↦ z.left) hab
    simp only [fiber_map_left] at this
    exact hφ.right_cancellation _ _ this
  apply hinj
  rw [IsNaturalSMul.naturality, htriv]

end Injective

section Criterion

variable {Y : Scheme.{u}} [ConnectedSpace Y] {Ω : Type u} [Field Ω] [IsSepClosed Ω]
  (s : Spec (.of Ω) ⟶ Y) (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [∀ P, MulAction G ((fiber s).obj P)] [IsFundamentalGroup (fiber s) G]

open scoped FintypeCatDiscrete in
/-- An element `g` of the fundamental group lies in a closed subgroup `H` as soon as it fixes
every point of a geometric fibre fixed by `H`. For an open normal subgroup `N`, the finite
continuous `G`-set `G / H N` is the geometric fibre of a finite étale scheme, whose base point is
fixed by `H`, hence by `g`, so that `g ∈ H N`; and `H` is the intersection of the `H N`. -/
theorem mem_of_forall_smul_eq_self (H : Subgroup G) (hH : IsClosed (H : Set G)) (g : G)
    (h : ∀ (U : Y.FiniteEtale) (u : (fiber s).obj U), (∀ k ∈ H, k • u = u) → g • u = u) :
    g ∈ H := by
  have : TotallyDisconnectedSpace G :=
    (toAutHomeo (fiber s) G).symm.totallyDisconnectedSpace
  -- `g ∈ H ⊔ N` for every open normal subgroup `N`
  have key (N : Subgroup G) [N.Normal] (hN : IsOpen (N : Set G)) : g ∈ H ⊔ N := by
    set S := H ⊔ N
    have hSo : IsOpen (S : Set G) := Subgroup.isOpen_mono le_sup_right hN
    have : Finite (G ⧸ S) := Subgroup.quotient_finite_of_isOpen S hSo
    have : Fintype (G ⧸ S) := Fintype.ofFinite _
    let X : ContAction FintypeCat.{u} G :=
      ⟨Action.FintypeCat.ofMulAction G (FintypeCat.of (G ⧸ S)), by
        rw [Action.isContinuous_def]
        have : DiscreteTopology ((forget₂ (Action FintypeCat G) TopCat).obj
          (Action.FintypeCat.ofMulAction G (FintypeCat.of (G ⧸ S)))) := ⟨rfl⟩
        have : DiscreteTopology ((forget₂ FintypeCat TopCat).obj
          (Action.FintypeCat.ofMulAction G (FintypeCat.of (G ⧸ S))).V) := ⟨rfl⟩
        refine continuous_prod_of_discrete_right.mpr fun v ↦
          continuous_discrete_rng.mpr fun w ↦ ?_
        obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective (v : G ⧸ S)
        obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective (w : G ⧸ S)
        have : (fun k : G ↦ (k • (QuotientGroup.mk a : G ⧸ S) : G ⧸ S)) ⁻¹'
            {(QuotientGroup.mk b : G ⧸ S)} = (fun k : G ↦ (k * a)⁻¹ * b) ⁻¹' S := by
          ext k
          simp [QuotientGroup.eq]
        change IsOpen ((fun k : G ↦ (k • (QuotientGroup.mk a : G ⧸ S) : G ⧸ S)) ⁻¹'
          {(QuotientGroup.mk b : G ⧸ S)})
        rw [this]
        exact hSo.preimage (((continuous_id.mul continuous_const).inv).mul continuous_const)⟩
    let E := equivalenceContAction s G
    let U := E.inverse.obj X
    let c := E.counitIso.app X
    let u : (fiber s).obj U := c.inv.hom.hom (QuotientGroup.mk 1 : G ⧸ S)
    have hinv (k : G) (v : G ⧸ S) : c.inv.hom.hom (k • v) = k • c.inv.hom.hom v :=
      congrArg (fun f ↦ f.hom v) (c.inv.hom.comm k)
    have hhom (k : G) (x : (fiber s).obj U) : c.hom.hom.hom (k • x) = k • c.hom.hom.hom x :=
      congrArg (fun f ↦ f.hom x) (c.hom.hom.comm k)
    have hu : ∀ k ∈ H, k • u = u := fun k hk ↦ by
      rw [← hinv]
      congr 1
      change (QuotientGroup.mk (k * 1) : G ⧸ S) = QuotientGroup.mk 1
      rw [QuotientGroup.eq]
      simpa using inv_mem (le_sup_left (a := H) hk)
    have hcu : c.hom.hom.hom u = (QuotientGroup.mk 1 : G ⧸ S) :=
      congrArg (fun f ↦ f.hom.hom (QuotientGroup.mk 1 : G ⧸ S)) c.inv_hom_id
    have h₁ := congrArg c.hom.hom.hom (h U u hu)
    rw [hhom, hcu] at h₁
    change (QuotientGroup.mk (g * 1) : G ⧸ S) = QuotientGroup.mk 1 at h₁
    rw [QuotientGroup.eq] at h₁
    simpa using inv_mem h₁
  rw [← SetLike.mem_coe, ← hH.closure_eq, mem_closure_iff]
  intro o ho hgo
  have hV : IsOpen ((fun x ↦ g * x) ⁻¹' o) := ho.preimage (continuous_const.mul continuous_id)
  obtain ⟨N₀, hN₀⟩ :=
    ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hV (by simpa using hgo)
  have hg := key N₀.toSubgroup N₀.isOpen'
  rw [← SetLike.mem_coe, Subgroup.mul_normal] at hg
  obtain ⟨x, hx, n, hn, hxn⟩ := hg
  refine ⟨x, ?_, hx⟩
  have : x = g * n⁻¹ := by
    rw [← hxn]
    group
  rw [this]
  exact hN₀ (inv_mem (show n ∈ N₀.toSubgroup from hn))

end Criterion

section Exact

variable {K : Type u} [Field K] [Finite K] {C : Scheme.{u}} (p : C ⟶ Spec (.of K))
  [CompactSpace C] [QuasiSeparatedSpace C] [ConnectedSpace C] [ConnectedSpace p.geometricFiber]
  {t : Spec (.of (AlgebraicClosure K)) ⟶ p.geometricFiber} {s : Spec (.of (AlgebraicClosure K)) ⟶ C}
  (τ : pullback p.geometricFiberProj ⋙ fiber t ≅ fiber s)
  (G' : Type u) [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G'] [CompactSpace G']
  [∀ P, MulAction G' ((fiber t).obj P)] [IsFundamentalGroup (fiber t) G']
  (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [∀ P, MulAction G ((fiber s).obj P)] [IsFundamentalGroup (fiber s) G]

/-- A point `u` of a geometric fibre fixed by the image of the geometric fundamental group comes
from a point of the geometric fibre of a constant cover: the corresponding point over the geometric
fibre is fixed by `π₁`, hence lies on a section, which descends to a constant cover. -/
theorem exists_constantCover_fiber_map_eq (U : C.FiniteEtale) (u : (fiber s).obj U)
    (hu : ∀ k ∈ (fundamentalGroupMap τ G' G).range, k • u = u) :
    ∃ (L : FiniteSubfield K) (ψ : constantCover p L.toFiniteEtaleAlgebra ⟶ U)
      (v : (fiber s).obj (constantCover p L.toFiniteEtaleAlgebra)), (fiber s).map ψ v = u := by
  -- the point of the fibre over the geometric fibre corresponding to `u` is fixed by `π₁`
  let z : (fiber t).obj ((pullback p.geometricFiberProj).obj U) := τ.inv.app U u
  have hτz : τ.hom.app U z = u := ConcreteCategory.congr_hom (τ.inv_hom_id_app U) u
  have hz (k : G') : k • z = z := by
    apply ((ConcreteCategory.isIso_iff_bijective (τ.hom.app U)).1 inferInstance).1
    rw [← fundamentalGroupMap_smul τ G' G, hτz]
    exact hu _ ⟨k, rfl⟩
  -- a fixed point lies on a section
  let E := equivalenceContAction t G'
  let T₀ : p.geometricFiber.FiniteEtale := ⟨MorphismProperty.Over.mk ⊤ (𝟙 _) inferInstance,
    inferInstanceAs (IsFinite (𝟙 _))⟩
  let x₀ : (fiber t).obj T₀ := Over.homMk t (Category.comp_id t)
  let m : E.functor.obj T₀ ⟶ E.functor.obj ((pullback p.geometricFiberProj).obj U) :=
    ObjectProperty.homMk
      { hom := FintypeCat.homMk fun _ ↦ z
        comm k := FintypeCat.hom_ext _ _ fun _ ↦ (hz k).symm }
  let S := E.fullyFaithfulFunctor.preimage m
  have hS : (fiber t).map S x₀ = z :=
    congrArg (fun f ↦ f.hom.hom x₀) (E.fullyFaithfulFunctor.map_preimage m)
  have hσb : S.hom.left ≫ Limits.pullback.snd U.obj.hom p.geometricFiberProj = 𝟙 _ :=
    hom_left_comp S
  let σ := S.hom.left ≫ Limits.pullback.fst U.obj.hom p.geometricFiberProj
  have hσ : σ ≫ U.obj.hom = p.geometricFiberProj := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσb, Category.id_comp]
  obtain ⟨L, ψ, hψ⟩ := exists_constantCover_hom_of_section p U σ hσ
  -- the corresponding point of the fibre of the constant cover
  let A := L.toFiniteEtaleAlgebra
  let zV : (fiber t).obj ((pullback p.geometricFiberProj).obj (constantCover p A)) :=
    fiberMk t _ (t ≫ Limits.pullback.lift (geometricFiberToConstantCover p L) (𝟙 _)
      (by rw [Category.id_comp]; exact geometricFiberToConstantCover_fst p L))
      (by simp)
  have hzV : (fiber t).map ((pullback p.geometricFiberProj).map ψ) zV = z := by
    apply fiber_ext
    rw [fiber_map_left, ← hS, fiber_map_left, fiberMk_left, Category.assoc]
    congr 1
    apply Limits.pullback.hom_ext
    · simp only [pullback_map_hom_left, Category.assoc, Limits.pullback.lift_fst]
      erw [Limits.pullback.lift_fst_assoc]
      exact hψ
    · simp only [pullback_map_hom_left, Category.assoc, Limits.pullback.lift_snd,
        Category.comp_id]
      erw [Limits.pullback.lift_snd]
      exact hσb.symm
  have hu' : u = (fiber s).map ψ (τ.hom.app _ zV) := by
    rw [← hτz, ← hzV]
    exact (ConcreteCategory.congr_hom (τ.hom.naturality ψ) zV)
  exact ⟨L, ψ, _, hu'.symm⟩

/-- **Exactness in the middle of the homotopy exact sequence**: an element of `π₁(C₀, s)` acting
trivially on the geometric fibres of the constant covers lies in the image of
`π₁(C₀ ×_K K̄, t)`. A point `u` of the geometric fibre of a finite étale `C₀`-scheme `U` which is
fixed by this image corresponds to a section over `C₀ ×_K K̄` of the base change of `U`; it descends
to a morphism `C₀ ×_K Spec L ⟶ U` from a constant cover, through which `u` comes from a point of
the geometric fibre of the constant cover, fixed by `g`. -/
theorem mem_range_fundamentalGroupMap_of_mem_weilGroup [GeometricallyConnected p] (g : G)
    (hg : (g, (1 : Multiplicative ℤ)) ∈ weilGroup p s G) :
    g ∈ (fundamentalGroupMap τ G' G).range := by
  have : T2Space G := (toAutHomeo (fiber s) G).isEmbedding.t2Space
  have : ∀ P, ContinuousSMul G' ((fiber t).obj P) := fun P ↦ IsFundamentalGroup.continuous_smul P
  have hcl : IsClosed ((fundamentalGroupMap τ G' G).range : Set G) := by
    rw [MonoidHom.coe_range]
    exact (isCompact_range (continuous_fundamentalGroupMap τ G' G)).isClosed
  refine mem_of_forall_smul_eq_self s G _ hcl g fun U u hu ↦ ?_
  obtain ⟨L, ψ, v, rfl⟩ := exists_constantCover_fiber_map_eq p τ G' G U u hu
  have hfix : g • v = v := by
    rw [(mem_weilGroup_iff p s G).1 hg L.toFiniteEtaleAlgebra]
    rfl
  rw [← IsNaturalSMul.naturality, hfix]

end Exact

end AlgebraicGeometry.Scheme.FiniteEtale
