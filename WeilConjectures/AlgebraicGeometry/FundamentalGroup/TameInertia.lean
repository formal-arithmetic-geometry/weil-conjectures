/-!
# The Frobenius acts on tame inertia through the cyclotomic character

Let `U ⊆ C` be a nonempty open of a smooth connected curve over an algebraically closed field `k`,
`z` a point of `C ∖ U` and `V = U ∪ {z}`. Let `E` be an automorphism of `C` preserving `U` and
fixing `z`, semilinear over an automorphism `σ₀` of `k` with `σ₀(x) ^ Q = x` (for the geometric
Frobenius `Φ_q ^ m` of a curve over `𝔽_q`, `Q = q ^ m`). If a `ℤ / N`-torsor `T` on `U`, with `N`
invertible in `k`, is isomorphic to its transport along `E`, then `Q - 1` kills its local
monodromy at `z`: `(Q - 1) f_T(g) = 0` for `g` in the kernel of `π₁(U) → π₁(V)`
(`AlgebraicGeometry.Scheme.EtaleTorsor.natCast_sub_one_mul_monodromy_eq_zero`).

This is the relation `Φ τ Φ⁻¹ = τ ^ Q` of the tame inertia group, proved on characters through
Kummer theory at the generic point:

* the kernel of `π₁(U) → π₁(V)` is the closed normal subgroup generated by the image of the
  inertia group `I` of a point over `z` in `Gal(Ω / k(C))`, `Ω` a separable closure of `k(C)`
  (`AlgebraicGeometry.Scheme.FiniteEtale.fixingSubgroup_le_topologicalClosure_normalClosure`);
* on `Gal(Ω / k(C))` the monodromy of `T` is the Kummer character of an element `x` with
  `x ^ N ∈ k(C)` (`AlgebraicGeometry.Scheme.EtaleTorsor.exists_kummer_element`);
* `x ^ N = u π ^ a` with `u` a unit at `z` and `π` a uniformizer, and `I` fixes the `N`-th roots
  of units at `z` (`Ideal.inertia_smul_eq_of_pow_eq`), so on `I` the monodromy is `a` times the
  Kummer character of `π`;
* `E` lifts to an automorphism `φ` of `Ω`
  (`AlgebraicGeometry.Scheme.exists_ringEquiv_separableClosure`) which raises roots of unity to
  the power `Q⁻¹`, preserves units at `z` and uniformizers, and under which the monodromy of `T`
  is invariant, since `T` is; this gives `Q χ = χ` on `I`
  (`IsPrimitiveRoot.natCast_mul_eq_of_kummer`).
-/

@[expose] public section

universe u

open CategoryTheory Limits PreGaloisCategory

namespace AlgebraicGeometry.Scheme.EtaleTorsor

open FiniteEtale

section Generic

variable {M : Type (u + 1)} [AddCommGroup M] [Finite M] [TopologicalSpace M] [DiscreteTopology M]
  {Y : Scheme.{u}} [ConnectedSpace Y] {K Ω : Type u} [CommRing K] [Field Ω] [Algebra K Ω]
  [IsSepClosed Ω] (y : Spec (.of K) ⟶ Y) {Ω' : Type u} [Field Ω'] [IsSepClosed Ω']
  {s : Spec (.of Ω') ⟶ Y} (τ : fiber (pointOfAlgebra Ω y) ≅ fiber s)
  (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [∀ P, MulAction G ((fiber s).obj P)] [IsFundamentalGroup (fiber s) G]

/-- The Galois group of a point acts on the points of a torsor above it through the monodromy
character of the torsor. -/
lemma specMap_comp_eq_comp_vadd_monodromy (T : EtaleTorsor M Y) (σ : Ω ≃ₐ[K] Ω)
    (t : Spec (.of Ω) ⟶ T.P) (ht : t ≫ T.π = pointOfAlgebra Ω y) :
    Spec.map (CommRingCat.ofHom (σ : Ω →+* Ω)) ≫ t =
      t ≫ T.vadd (T.monodromy s G (galoisToFundamentalGroup y τ G σ)).toAdd := by
  let x : (fiber (pointOfAlgebra Ω y)).obj T.toFiniteEtale := Over.homMk t ht
  set m := (T.monodromy s G (galoisToFundamentalGroup y τ G σ)).toAdd
  have h1 := galoisToFundamentalGroup_smul y τ G σ T.toFiniteEtale x
  have h2 := T.fiber_map_vaddHom_monodromy s G (galoisToFundamentalGroup y τ G σ)
    (τ.hom.app _ x)
  have h3 := ConcreteCategory.congr_hom (τ.hom.naturality (T.vaddHom m)) x
  simp only [ConcreteCategory.comp_apply] at h3
  have hinj : Function.Injective (τ.hom.app T.toFiniteEtale) :=
    (ConcreteCategory.bijective_of_isIso _).1
  have := hinj (h1.symm.trans (h2.symm.trans h3.symm))
  have := congrArg CommaMorphism.left this
  exact (galoisToAut_hom_app_left y σ _ x).symm.trans this

end Generic

section Conj

variable {M : Type (u + 1)} [AddCommGroup M] [Finite M] {Y : Scheme.{u}} {Ω : Type u} [Field Ω]

/-- If a torsor `T` is isomorphic to its transport along an automorphism `E` of `Y`, and `φ`
lifts `E` to the point `y`, then conjugation by `φ` preserves the action of automorphisms of `Ω`
on the points of `T` above `y`. -/
lemma specMap_conj_comp_eq (T : EtaleTorsor M Y) (E : Y ≅ Y) {y : Spec (.of Ω) ⟶ Y}
    (φ : Ω ≃+* Ω) (hy : Spec.map (CommRingCat.ofHom (φ : Ω →+* Ω)) ≫ y = y ≫ E.hom)
    (ψ : T.P ≅ T.P) (hψπ : ψ.hom ≫ T.π = T.π ≫ E.hom)
    (hψv : ∀ m, T.vadd m ≫ ψ.hom = ψ.hom ≫ T.vadd m) {σ : Ω ≃+* Ω} {m : M}
    (hσ : ∀ t : Spec (.of Ω) ⟶ T.P, t ≫ T.π = y →
      Spec.map (CommRingCat.ofHom (σ : Ω →+* Ω)) ≫ t = t ≫ T.vadd m)
    (t : Spec (.of Ω) ⟶ T.P) (ht : t ≫ T.π = y) :
    Spec.map (CommRingCat.ofHom ((φ.symm.trans (σ.trans φ) : Ω ≃+* Ω) : Ω →+* Ω)) ≫ t =
      t ≫ T.vadd m := by
  have hspec (a b : Ω ≃+* Ω) : Spec.map (CommRingCat.ofHom ((a.trans b : Ω ≃+* Ω) : Ω →+* Ω)) =
      Spec.map (CommRingCat.ofHom (b : Ω →+* Ω)) ≫ Spec.map (CommRingCat.ofHom (a : Ω →+* Ω)) := by
    rw [← Spec.map_comp]
    rfl
  have hφφ : Spec.map (CommRingCat.ofHom (φ : Ω →+* Ω)) ≫
      Spec.map (CommRingCat.ofHom (φ.symm : Ω →+* Ω)) = 𝟙 _ := by
    rw [← hspec, RingEquiv.symm_trans_self]
    exact Spec.map_id _
  have hφφ' : Spec.map (CommRingCat.ofHom (φ.symm : Ω →+* Ω)) ≫
      Spec.map (CommRingCat.ofHom (φ : Ω →+* Ω)) = 𝟙 _ := by
    rw [← hspec, RingEquiv.self_trans_symm]
    exact Spec.map_id _
  -- the point `φ⁻¹ ≫ t ≫ ψ` lies above `y`
  have ht' : (Spec.map (CommRingCat.ofHom (φ.symm : Ω →+* Ω)) ≫ t ≫ ψ.hom) ≫ T.π = y := by
    rw [Category.assoc, Category.assoc, hψπ, reassoc_of% ht, ← hy, ← Category.assoc, hφφ',
      Category.id_comp]
  have key := hσ _ ht'
  rw [Category.assoc, Category.assoc, ← hψv, ← Category.assoc t, ← Category.assoc,
    ← Category.assoc, ← Category.assoc, cancel_mono] at key
  rw [hspec, hspec]
  simp only [Category.assoc] at key ⊢
  rw [key, reassoc_of% hφφ]

end Conj

end AlgebraicGeometry.Scheme.EtaleTorsor

namespace AlgebraicGeometry.WeilGroup

open Scheme.FiniteEtale

variable {K : Type u} [Field K] {C U : Scheme.{u}} {p : C ⟶ Spec (.of K)} [IsCurve p]
  [ConnectedSpace C] [Smooth p] [ConnectedSpace U] {j : U ⟶ C} [IsOpenImmersion j] [Nonempty U]
  [IsIntegral C]

local notation "Ω" => SeparableClosure (Scheme.functionField C)

set_option synthInstance.maxHeartbeats 200000 in
-- instance search through `SeparableClosure` and its integral closures is slow
/-- **The local kernel is generated by inertia.** For a boundary point `z` of `U ⊆ C` with a
chart `c` whose prime has a perfect residue field, the kernel of `π₁(U, s) → π₁(U ∪ {z})` is
contained in the closed normal subgroup generated by the image of the inertia group of a point
`Q` over `z` in `Gal(Ω / k(C))`, for any path `τ` from the generic geometric point to `s`. -/
theorem BoundaryChart.fixingSubgroup_le_topologicalClosure_normalClosure {z : C}
    (c : BoundaryChart p j z) (hz : z ∉ Set.range j.base) [PerfectField c.ideal.ResidueField]
    (Q : Ideal (integralClosure Γ(C, c.W) Ω)) [Q.IsMaximal] [Q.LiesOver c.ideal]
    {Ω' : Type u} [Field Ω'] [IsSepClosed Ω'] (s : Spec (.of Ω') ⟶ U)
    (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    [∀ P, MulAction G ((fiber s).obj P)] [IsFundamentalGroup (fiber s) G]
    (τ : fiber (pointOfAlgebra Ω (genericPointLift j)) ≅ fiber s) :
    fixingSubgroup s (toOpen j (boundaryOpen (p := p) j z) (opensRange_le_boundaryOpen j z)) G ≤
      (Subgroup.normalClosure ((Q.inertia Gal(Ω/C.functionField)).map
        (galoisToFundamentalGroup (genericPointLift j) τ G) : Set G)).topologicalClosure := by
  have := c.isMaximal_ideal
  have := isDedekindDomain_of_isAffineOpen p c.isAffineOpen
  have := connectedSpace_boundaryOpen (p := p) j z
  intro g hg
  set N := (Subgroup.normalClosure ((Q.inertia Gal(Ω/C.functionField)).map
    (galoisToFundamentalGroup (genericPointLift j) τ G) : Set G)).topologicalClosure
  have hNc : IsClosed (N : Set G) := Subgroup.isClosed_topologicalClosure _
  have hNn : N.Normal := Subgroup.is_normal_topologicalClosure _
  refine mem_of_forall_smul_eq_self s G N hNc g fun Y u hu ↦ ?_
  obtain ⟨Z, i, y, rfl, hZ, hi⟩ := fiber_in_connected_component (fiber s) Y u
  -- `N` acts trivially on the fibre of the connected cover `Z`
  have hinj : Function.Injective ((fiber s).map i) :=
    ConcreteCategory.injective_of_mono_of_preservesPullback ((fiber s).map i)
  have hNy (k : G) (hk : k ∈ N) : k • y = y :=
    hinj (by rw [IsNaturalSMul.naturality, hu k hk])
  have hNZ (k : G) (hk : k ∈ N) (x : (fiber s).obj Z) : k • x = x := by
    obtain ⟨h, rfl⟩ := MulAction.exists_smul_eq G y x
    have : h⁻¹ * k * h ∈ N := by simpa using hNn.conj_mem k hk h⁻¹
    rw [← mul_smul, show k * h = h * (h⁻¹ * k * h) by group, mul_smul, hNy _ this]
  -- so inertia acts trivially on the generic fibre of `Z`
  have hIZ : ∀ σ ∈ Q.inertia Gal(Ω/C.functionField),
      ∀ t : (fiber (pointOfAlgebra Ω (genericPointLift j))).obj Z,
        (galoisToAut (genericPointLift j) σ).hom.app Z t = t := by
    intro σ hσ t
    apply ((ConcreteCategory.isIso_iff_bijective (τ.hom.app Z)).1 inferInstance).1
    rw [← galoisToFundamentalGroup_smul (genericPointLift j) τ G σ Z t]
    exact hNZ _ (Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ⟨σ, hσ, rfl⟩)) _
  -- `Z` is integral, being connected and smooth over `K`
  have : ConnectedSpace Z.obj.left := connectedSpace_of_isConnected Z
  have : Etale Z.obj.hom := Z.obj.prop
  let q : Z.obj.left ⟶ Spec (.of K) := Z.obj.hom ≫ j ≫ p
  have : Smooth q := inferInstance
  have := LocallyOfFiniteType.isLocallyNoetherian q
  have := IsRegular.of_smooth q
  have : IsIntegral Z.obj.left := IsRegular.isIntegral _
  have := LocallyOfFiniteType.isLocallyNoetherian p
  obtain ⟨Z', ⟨e⟩⟩ := exists_pullback_toOpen_iso_of_forall_inertia j c.isAffineOpen c.ϖ
    (c.ϖ_ne_zero hz) (c.opensRange_inf hz) c.ideal c.eq_ideal Q (boundaryOpen (p := p) j z)
    (opensRange_le_boundaryOpen j z) c.le Z c.boundaryOpen_le hIZ
  -- `g` acts trivially on the fibre of `Z`, which extends over `z`
  rw [← IsNaturalSMul.naturality, smul_eq_self_of_iso s G e (hg Z')]

end AlgebraicGeometry.WeilGroup

namespace IsDiscreteValuationRing

/-- A nonzero element of the fraction field of a discrete valuation ring is a unit times an
integral power of a uniformizer. -/
theorem exists_eq_algebraMap_mul_zpow {O F : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [Field F] [Algebra O F] [IsFractionRing O F] {π : O}
    (hπ : Irreducible π) {f : F} (hf : f ≠ 0) :
    ∃ (u : Oˣ) (a : ℤ), f = algebraMap O F u * algebraMap O F π ^ a := by
  obtain ⟨r, s, hs, rfl⟩ := IsFractionRing.div_surjective (A := O) f
  have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
  have hr0 : r ≠ 0 := by
    rintro rfl
    simp at hf
  obtain ⟨n₁, u₁, rfl⟩ := eq_unit_mul_pow_irreducible hr0 hπ
  obtain ⟨n₂, u₂, rfl⟩ := eq_unit_mul_pow_irreducible hs0 hπ
  have hπ0 : algebraMap O F π ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective O F)).2 hπ.ne_zero
  have hu₂ : algebraMap O F u₂ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective O F)).2 u₂.ne_zero
  refine ⟨u₁ * u₂⁻¹, (n₁ : ℤ) - n₂, ?_⟩
  rw [zpow_sub₀ hπ0, zpow_natCast, zpow_natCast, Units.val_mul, map_mul, map_mul, map_mul,
    map_pow, map_pow]
  have : algebraMap O F ↑u₂⁻¹ = (algebraMap O F u₂)⁻¹ := by
    exact map_units_inv (algebraMap O F) u₂
  rw [this]
  field_simp

end IsDiscreteValuationRing
