module

public import WeilConjectures.AlgebraicGeometry.RegularHilbertCoefficientDatum
public import WeilConjectures.RingTheory.SupportedHomogeneousDivision
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType

/-! # Geometric generic charts with regular vertex generators

This isolates the geometric construction, before the universal division assertions.
Source: ILO VIII 2.3.11--2.3.13 and Bierstone--Milman 1997, sections 3.5, 8,
and the first paragraph of the proof of Theorem 9.6, pp.278--279.
(blueprint: lem-trf-generic-monotone-vertex-chart)
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.HilbertCoefficient

/-- A geometric chart and normalized regular generators of its actual Taylor vertices.
No division property, universal lift assertion, or empty-vertex conclusion is included.
Source: BM 1997, proof of Theorem 9.6, first paragraph.
(blueprint: lem-trf-generic-monotone-vertex-chart). -/
structure GenericMonotoneVertexChart {k : Type u} [Field k] {X M : Scheme.{u}}
    (p : M ⟶ Spec (CommRingCat.of k)) (i : X ⟶ M) (a : X) where
  U : Scheme.{u}
  affine : IsAffine U
  e : U ⟶ M
  etale : Etale e
  center : U
  center_eq : e center = i a
  residue_iso : Function.Bijective (e.residueFieldMap center)
  n : ℕ
  coord : MvPolynomial (Fin n) k →+* Γ(U, ⊤)
  etale_coord : coord.Etale
  over_k : U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (coord.comp MvPolynomial.C)) = e ≫ p
  taylor : Γ(U, ⊤) →+* MvPowerSeries (Fin n) (U.residueField center)
  taylor_spec : isTaylorMap coord (U.Γevaluation center).hom taylor
  diagram : Set (Fin n →₀ ℕ)
  diagram_spec : ∀ d : Fin n →₀ ℕ,
    d ∈ diagram ↔ ∃ f : MvPowerSeries (Fin n) (U.residueField center),
      f ∈ taylorIdeal (RingHom.ker (pullback.snd i e).appTop.hom) taylor ∧
      MvPowerSeries.coeff d f ≠ 0 ∧
      ∀ b : Fin n →₀ ℕ, Finsupp.DegLex (· < ·) (· < ·) b d →
        MvPowerSeries.coeff b f = 0
  monotone : MonomialDiagram.IsMonotone diagram
  s : ℕ
  vertex : Fin s → Fin n →₀ ℕ
  vertices : MonomialDiagram.IsOrderedVertexFamily diagram vertex
  diagram_eq : diagram = MonomialDiagram.generated vertex
  F : Fin s → Γ(U, ⊤)
  regular_generators : RingHom.ker (pullback.snd i e).appTop.hom = Ideal.span (Set.range F)
  initial_coefficient : ∀ j : Fin s, MvPowerSeries.coeff (vertex j) (taylor (F j)) = 1
  initial_minimal : ∀ (j : Fin s) (b : Fin n →₀ ℕ),
    Finsupp.DegLex (· < ·) (· < ·) b (vertex j) →
      MvPowerSeries.coeff b (taylor (F j)) = 0

/-- Construct the geometric generic chart and regular vertex generators.

Source: ILO VIII 2.3.11--2.3.13; BM 1997, sections 3.5, 8 and the first paragraph
of the proof of Theorem 9.6, pp.278--279.
(blueprint: lem-trf-generic-monotone-vertex-chart).

Proof: choose an affine etale coordinate chart about the given point. Apply the
Taylor normal-cone comparison to identify its homogeneous initial ideal with the
extension of the stalk's normal associated-graded ideal. Generic graded Borel fixity
and the open condition that the normal subspace project isomorphically to the last
coordinates can be imposed simultaneously. Their intersection has a matrix over k:
a nonzero polynomial over the residue field cannot vanish on all matrices over the
infinite subfield k, by induction on the number of entries and the root bound.
Borel invariance under T_i -> T_i + T_j shows full-transfer monotonicity, by taking
the term with no T_i factor, whose coefficient is 1. Monomial multiplication gives
upward closure, and Dickson finiteness supplies the ordered minimal vertices.
Write the normal linear forms as V + AU. Substitution by this shear and its inverse
preserves least fixed-degree lexicographic exponents. Hence the diagram is the
product of the free U-exponents with the normal diagram and each vertex has zero
U-component. Represent its normal symbol by a germ of the ideal in the appropriate
maximal-ideal power. The Taylor normal-cone comparison gives the prescribed first
exponent. Normalize its first coefficient by a unit and represent the finitely many
germs on a common affine neighbourhood. Supported formal division shows that their
Taylor expansions generate the extended ideal: a nonzero remainder would have its
first exponent both inside and outside the diagram. Faithful flatness of the local
Taylor map contracts this equality to the stalk. Coherent ideal spreading gives
equality with the ideal generated by the regular lifts after shrinking. Restriction
preserves the chart and its Taylor data. Choose the neighbourhood about the original
point, so its residue field is unchanged. If the Taylor ideal is zero, contraction
and spreading give the zero regular ideal and the empty family. For no coordinates,
the proper ideal at a point of X is zero and the same argument applies. -/
theorem genericMonotoneVertexChart {k : Type u} [Field k] [CharZero k]
    {X M : Scheme.{u}} (p : M ⟶ Spec (CommRingCat.of k)) (i : X ⟶ M)
    [Smooth p] [LocallyOfFiniteType p] [QuasiCompact p] [IsClosedImmersion i] (a : X) :
    Nonempty (GenericMonotoneVertexChart p i a) := by
  sorry

end AlgebraicGeometry.HilbertCoefficient
