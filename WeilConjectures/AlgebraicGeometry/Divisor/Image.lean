/-!
# Images of effective Cartier divisors under finite locally free morphisms

Let `f : X ⟶ Y` be finite, flat and locally of finite presentation, where `Y` is a locally
noetherian integral scheme all of whose local rings are UFDs. Then the image of an effective
Cartier divisor on `X` is (the support of) an effective Cartier divisor on `Y`. This is an input
to Stacks 0BF7.

Locally on `Y = Spec A`, `X = Spec B` with `B` finite free over `A`, and the ideal of the divisor
is generated by a non-zero-divisor `h` (an invertible ideal of a semilocal ring is principal,
see `Ideal.exists_notMem_mul_mem_span_singleton_of_isIntegral`). The image of `V(h)` is then
the zero locus of the norm of `h` (`Algebra.norm_mem_iff_exists_isPrime`). Finally, a closed
subset which is locally the zero locus of one nonzero function on a scheme with factorial
local rings is an effective Cartier divisor: its vanishing ideal is locally the radical of a
principal ideal, which is principal in a UFD.

## Main results

- `Ideal.exists_ne_zero_mem_iff_exists_le`: the algebraic form of the main result.
- `AlgebraicGeometry.Scheme.isInvertible_vanishingIdeal_of_forall_eq_compl_basicOpen`: on a
  locally noetherian integral scheme with factorial local rings, the vanishing ideal of a
  closed subset which is locally the zero locus of one nonzero function is invertible.
- `AlgebraicGeometry.Scheme.Hom.exists_isInvertible_support_eq_image`: the image of an
  effective Cartier divisor under a finite locally free morphism to a scheme with factorial
  local rings is an effective Cartier divisor.
-/

@[expose] public section

universe u

open CategoryTheory TopologicalSpace

/-- Spreading out a principal generator from a localization: if a finitely generated ideal `I`
becomes principal in a localization `S` of `R` at `M`, then there are `m ∈ M` and `b ∈ I` such
that `b` generates `I S` and `m • I ⊆ (b)`. -/
theorem Ideal.exists_mem_mul_mem_span_singleton_of_map_eq {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (M : Submonoid R) [IsLocalization M S] {I : Ideal R}
    (hI : I.FG) {f : S} (hf : I.map (algebraMap R S) = Ideal.span {f}) :
    ∃ m ∈ M, ∃ b ∈ I, I.map (algebraMap R S) = Ideal.span {algebraMap R S b} ∧
      ∀ i ∈ I, m * i ∈ Ideal.span {b} := by
  classical
  have hfI : f ∈ I.map (algebraMap R S) := hf ▸ Ideal.mem_span_singleton_self f
  obtain ⟨⟨⟨b, hbI⟩, s⟩, hbm⟩ := (IsLocalization.mem_map_algebraMap_iff M S).mp hfI
  have hspan : I.map (algebraMap R S) = Ideal.span {algebraMap R S b} := by
    rw [hf, ← hbm, Ideal.span_singleton_mul_right_unit (IsLocalization.map_units S s)]
  have hmem (i : R) (hi : i ∈ I) : ∃ m ∈ M, m * i ∈ Ideal.span {b} := by
    have : algebraMap R S i ∈ (Ideal.span {b}).map (algebraMap R S) := by
      rw [Ideal.map_span, Set.image_singleton, ← hspan]
      exact Ideal.mem_map_of_mem _ hi
    exact (IsLocalization.algebraMap_mem_map_algebraMap_iff M S _ _).mp this
  obtain ⟨t, ht⟩ := hI
  choose! m hm hmi using hmem
  refine ⟨∏ i ∈ t, m i, M.prod_mem fun i hi ↦ hm i (ht ▸ Ideal.subset_span hi), b, hbI, hspan,
    fun i hi ↦ ?_⟩
  have key : Ideal.span (t : Set R) ≤ (Ideal.span {b}).colon {∏ i ∈ t, m i} := by
    refine Ideal.span_le.mpr fun j hj ↦ ?_
    rw [SetLike.mem_coe, Submodule.mem_colon_singleton, smul_eq_mul,
      mul_comm, ← Finset.prod_erase_mul t m hj, mul_assoc]
    exact Ideal.mul_mem_left _ _ (hmi j (ht ▸ Ideal.subset_span hj))
  rw [← ht] at hi
  rw [mul_comm, ← smul_eq_mul, ← Submodule.mem_colon_singleton]
  exact key hi

/-- Let `Q` be a finite set of pairwise incomparable primes of `R` and `I` an ideal which is
principal near each `q ∈ Q`: there are `x ∈ I` and `t ∉ q` with `t • I ⊆ (x)`. Then a single
`h ∈ I` generates `I` near every `q ∈ Q`. One takes `h = ∑ e_q x_q`, where `e_q` lies in all
members of `Q` except `q`. -/
theorem Ideal.exists_mem_forall_exists_notMem_mul_mem_span_singleton {R : Type*} [CommRing R]
    (Q : Finset (Ideal R)) (hQ : ∀ q ∈ Q, q.IsPrime)
    (hQinc : ∀ q ∈ Q, ∀ q' ∈ Q, q' ≤ q → q' = q) (I : Ideal R)
    (hI : ∀ q ∈ Q, ∃ t ∉ q, ∃ x ∈ I, ∀ i ∈ I, t * i ∈ Ideal.span {x}) :
    ∃ h ∈ I, ∀ q ∈ Q, ∃ u ∉ q, ∀ i ∈ I, u * i ∈ Ideal.span {h} := by
  classical
  have hsep (q : Ideal R) (hq : q ∈ Q) (q' : Ideal R) (hq' : q' ∈ Q) (hne : q' ≠ q) :
      ∃ c ∈ q', c ∉ q := by
    by_contra! H
    exact hne (hQinc q hq q' hq' H)
  choose! c hcq' hcq using hsep
  choose! t ht x hxI hx using hI
  set e : Ideal R → R := fun q ↦ ∏ q' ∈ Q.erase q, c q q' with he_def
  have he (q : Ideal R) (hq : q ∈ Q) : e q ∉ q := by
    have := hQ q hq
    rw [he_def, Ideal.IsPrime.prod_mem_iff]
    rintro ⟨q', hq', hmem⟩
    exact hcq q hq q' (Finset.mem_of_mem_erase hq') (Finset.ne_of_mem_erase hq') hmem
  have he' (q q' : Ideal R) (hq : q ∈ Q) (hq' : q' ∈ Q) (hne : q ≠ q') : e q' ∈ q := by
    simp only [he_def]
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_erase.mpr ⟨hne, hq⟩)]
    exact Ideal.mul_mem_right _ _ (hcq' q' hq' q hq hne)
  refine ⟨∑ q ∈ Q, e q * x q, Ideal.sum_mem _ fun q hq ↦ I.mul_mem_left _ (hxI q hq),
    fun q hq ↦ ?_⟩
  have hy (q' : Ideal R) (hq' : q' ∈ Q) : ∃ y, y * x q = t q * x q' :=
    Ideal.mem_span_singleton'.mp (hx q hq _ (hxI q' hq'))
  choose! y hy using hy
  set w := e q * t q + ∑ q' ∈ Q.erase q, e q' * y q'
  have hw : w ∉ q := by
    have := hQ q hq
    rw [Ideal.add_mem_iff_left _ (Ideal.sum_mem _ fun q' hq' ↦ Ideal.mul_mem_right _ _
      (he' q q' hq (Finset.mem_of_mem_erase hq') (Finset.ne_of_mem_erase hq').symm))]
    exact fun hmem ↦ (this.mem_or_mem hmem).elim (he q hq) (ht q hq)
  have hth : t q * ∑ q' ∈ Q, e q' * x q' = w * x q := by
    rw [← Finset.add_sum_erase Q _ hq, mul_add, Finset.mul_sum, add_mul, Finset.sum_mul]
    congr 1
    · ring
    · refine Finset.sum_congr rfl fun q' hq' ↦ ?_
      linear_combination -(e q') * hy q' (Finset.mem_of_mem_erase hq')
  refine ⟨t q * w, fun hmem ↦ ((hQ q hq).mem_or_mem hmem).elim (ht q hq) hw, fun i hi ↦ ?_⟩
  obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp (hx q hq i hi)
  refine Ideal.mem_span_singleton'.mpr ⟨z * t q, ?_⟩
  linear_combination z * hth + w * hz

/-- Let `B` be an integral and quasi-finite `A`-algebra, `p` a prime of `A`, and `I` an ideal
of `B` which is principal near every prime `q` over `p`. Then `I` is principal over a basic
open neighbourhood of `p`: there are `g ∉ p` and `h ∈ I` with `g • I ⊆ (h)`. -/
theorem Ideal.exists_notMem_mul_mem_span_singleton_of_isIntegral {A B : Type*} [CommRing A]
    [CommRing B] [Algebra A B] [Algebra.IsIntegral A B] [Algebra.QuasiFinite A B]
    (p : Ideal A) [p.IsPrime] (I : Ideal B)
    (hI : ∀ q : Ideal B, q.IsPrime → q.comap (algebraMap A B) = p →
      ∃ t ∉ q, ∃ x ∈ I, ∀ i ∈ I, t * i ∈ Ideal.span {x}) :
    ∃ g ∉ p, ∃ h ∈ I, ∀ i ∈ I, algebraMap A B g * i ∈ Ideal.span {h} := by
  classical
  have hfin := Algebra.QuasiFinite.finite_primesOver (S := B) p
  have hmem (q : Ideal B) :
      q ∈ hfin.toFinset ↔ q.IsPrime ∧ q.comap (algebraMap A B) = p := by
    rw [Set.Finite.mem_toFinset, Ideal.primesOver, Set.mem_ofPred_eq, Ideal.liesOver_iff,
      Ideal.under_def, eq_comm]
  obtain ⟨h, hhI, hh⟩ := Ideal.exists_mem_forall_exists_notMem_mul_mem_span_singleton
    hfin.toFinset (fun q hq ↦ ((hmem q).mp hq).1) (fun q hq q' hq' hle ↦ by
      obtain ⟨hqp, hq⟩ := (hmem q).mp hq
      obtain ⟨hq'p, hq'⟩ := (hmem q').mp hq'
      by_contra hne
      exact (Ideal.IsIntegral.comap_lt_comap (R := A) (lt_of_le_of_ne hle hne)).ne
        (hq'.trans hq.symm)) I
    fun q hq ↦ hI q ((hmem q).mp hq).1 ((hmem q).mp hq).2
  have hle : ¬((Ideal.span {h}).colon (I : Set B)).comap (algebraMap A B) ≤ p := by
    intro hle
    obtain ⟨Q, hQ, hQp, hQ'⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p _ hle
    obtain ⟨u, hu, hui⟩ := hh Q ((hmem Q).mpr ⟨hQp, hQ'⟩)
    exact hu (hQ (Submodule.mem_colon.mpr fun i hi ↦ hui i hi))
  obtain ⟨g, hg, hgp⟩ := SetLike.not_le_iff_exists.mp hle
  exact ⟨g, hgp, h, hhI, fun i hi ↦ Submodule.mem_colon.mp hg i hi⟩

/-- If `M` becomes free after inverting `r`, then it is free over every localization of `R` away
from a multiple `s` of `r`. -/
theorem Module.free_of_isLocalizedModule_away_of_dvd {R M : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] {r s : R} (hrs : r ∣ s)
    [Module.Free (Localization.Away r) (LocalizedModule.Away r M)]
    (Rₛ : Type*) [CommRing Rₛ] [Algebra R Rₛ] [IsLocalization.Away s Rₛ]
    {Mₛ : Type*} [AddCommGroup Mₛ] [Module R Mₛ] [Module Rₛ Mₛ] [IsScalarTower R Rₛ Mₛ]
    (f : M →ₗ[R] Mₛ) [IsLocalizedModule (.powers s) f] : Module.Free Rₛ Mₛ := by
  have hr : IsUnit (algebraMap R Rₛ r) :=
    isUnit_of_dvd_unit (map_dvd _ hrs) (IsLocalization.Away.algebraMap_isUnit s)
  let : Algebra (Localization.Away r) Rₛ := (IsLocalization.Away.lift r hr).toAlgebra
  have : IsScalarTower R (Localization.Away r) Rₛ :=
    .of_algebraMap_eq fun a ↦ (IsLocalization.Away.lift_eq r hr a).symm
  let e₁ := ((isLocalizedModule_iff_isBaseChange (.powers r) (Localization.Away r)
    (LocalizedModule.mkLinearMap (.powers r) M)).mp inferInstance).equiv
  let e₂ := ((isLocalizedModule_iff_isBaseChange (.powers s) Rₛ f).mp inferInstance).equiv
  exact .of_equiv (TensorProduct.AlgebraTensorModule.congr (.refl Rₛ Rₛ) e₁.symm ≪≫ₗ
    TensorProduct.AlgebraTensorModule.cancelBaseChange R (Localization.Away r) Rₛ Rₛ M ≪≫ₗ e₂)

/-- If `g • I ⊆ (h)` and every prime `Q` not containing `g` has some `x ∈ I` which is a
non-zero-divisor after inverting some `t ∉ Q`, then `h` kills `b` only if a power of `g`
does. -/
theorem Ideal.exists_pow_mul_eq_zero_of_mul_eq_zero {R : Type*} [CommRing R] {I : Ideal R}
    {g h : R} (hgh : ∀ i ∈ I, g * i ∈ Ideal.span {h})
    (hI : ∀ Q : Ideal R, Q.IsPrime → g ∉ Q → ∃ t ∉ Q, ∃ x ∈ I,
      ∀ b, x * b = 0 → ∃ n : ℕ, t ^ n * b = 0) {b : R} (hb : h * b = 0) :
    ∃ n : ℕ, g ^ n * b = 0 := by
  have hrad : g ∈ ((⊥ : Ideal R).colon {b}).radical := by
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    rintro Q ⟨hle, hQ⟩
    by_contra hgQ
    obtain ⟨t, ht, x, hxI, hx⟩ := hI Q hQ hgQ
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp (hgh x hxI)
    obtain ⟨n, hn⟩ := hx (g * b) (by linear_combination -b * hd + d * hb)
    have : t ^ n * g ∈ Q := hle (Submodule.mem_colon_singleton.mpr (by
      rw [smul_eq_mul, mul_assoc, hn, Submodule.mem_bot]))
    exact (hQ.mem_or_mem this).elim (fun h ↦ ht (hQ.mem_of_pow_mem n h)) hgQ
  obtain ⟨n, hn⟩ := hrad
  exact ⟨n, by simpa using Submodule.mem_colon_singleton.mp hn⟩

/-- **The image of a locally principal regular ideal under a finite locally free map is
locally cut out by one equation** (algebraic form). Let `A` be a domain, `B` a finite flat
finitely presented `A`-algebra and `I ⊆ B` an ideal which is locally generated by a
non-zero-divisor. Then every prime `p` of `A` has a basic open neighbourhood `D(s)` on which the
image of `V(I)` in `Spec A` is the zero locus of a single nonzero element `a`.

Over `D(s)`, `B` is free and `I` is generated by an element `h` (using that there are only
finitely many primes over `p`), and `a` is the norm of `h`. -/
theorem Ideal.exists_ne_zero_mem_iff_exists_le {A B : Type*} [CommRing A] [IsDomain A]
    [CommRing B] [Algebra A B] [Module.Finite A B] [Module.Flat A B]
    [Module.FinitePresentation A B] (I : Ideal B)
    (hI : ∀ q : Ideal B, q.IsPrime → ∃ t ∉ q, ∃ x ∈ I,
      (∀ i ∈ I, t * i ∈ Ideal.span {x}) ∧ ∀ b, x * b = 0 → ∃ n : ℕ, t ^ n * b = 0)
    (p : Ideal A) [p.IsPrime] :
    ∃ s ∉ p, ∃ a : A, a ≠ 0 ∧ ∀ P : Ideal A, P.IsPrime → s ∉ P →
      (a ∈ P ↔ ∃ q : Ideal B, q.IsPrime ∧ q.comap (algebraMap A B) = P ∧ I ≤ q) := by
  classical
  have : Module.Free (Localization.AtPrime p) (LocalizedModule p.primeCompl B) :=
    Module.free_of_flat_of_isLocalRing
  obtain ⟨r, hr, hfree, -⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
    p.primeCompl (LocalizedModule.mkLinearMap p.primeCompl B) (Localization.AtPrime p)
  obtain ⟨g, hg, h, hhI, hgh⟩ := Ideal.exists_notMem_mul_mem_span_singleton_of_isIntegral p I
    fun q hq _ ↦ by
      obtain ⟨t, ht, x, hx, hxI, -⟩ := hI q hq
      exact ⟨t, ht, x, hx, hxI⟩
  have hs : r * g ∉ p := fun h ↦ (‹p.IsPrime›.mem_or_mem h).elim hr hg
  let Aₛ := Localization.Away (r * g)
  let Bₛ := Localization (Algebra.algebraMapSubmonoid B (Submonoid.powers (r * g)))
  have : Module.Free Aₛ Bₛ := Module.free_of_isLocalizedModule_away_of_dvd
    (dvd_mul_right r g) Aₛ (IsScalarTower.toAlgHom A B Bₛ).toLinearMap
  have : Module.Finite Aₛ Bₛ :=
    .of_isLocalizedModule (.powers (r * g)) (IsScalarTower.toAlgHom A B Bₛ).toLinearMap
  have : IsDomain Aₛ := IsLocalization.isDomain_localization
    (powers_le_nonZeroDivisors_of_noZeroDivisors fun h ↦ hs (h ▸ p.zero_mem))
  have hreg : algebraMap B Bₛ h ∈ nonZeroDivisors Bₛ := by
    have key (b : B) (hb : h * b = 0) : algebraMap B Bₛ b = 0 := by
      obtain ⟨n, hn⟩ := Ideal.exists_pow_mul_eq_zero_of_mul_eq_zero (I := I)
        (g := algebraMap A B (r * g)) (fun i hi ↦ by
          rw [map_mul, mul_assoc]
          exact Ideal.mul_mem_left _ _ (hgh i hi))
        (fun Q hQ _ ↦ by
          obtain ⟨t, ht, x, hx, -, hx'⟩ := hI Q hQ
          exact ⟨t, ht, x, hx, hx'⟩) hb
      refine (IsLocalization.map_eq_zero_iff
        (Algebra.algebraMapSubmonoid B (Submonoid.powers (r * g))) Bₛ b).mpr
        ⟨⟨_, Submonoid.mem_map.mpr ⟨_, ⟨n, rfl⟩, map_pow _ _ _⟩⟩, hn⟩
    refine mem_nonZeroDivisors_iff_right.mpr fun y hy ↦ ?_
    obtain ⟨⟨b, m⟩, hbm⟩ :=
      IsLocalization.surj (Algebra.algebraMapSubmonoid B (Submonoid.powers (r * g))) y
    have hbh : algebraMap B Bₛ (b * h) = 0 := by
      rw [map_mul, ← hbm, mul_right_comm, hy, zero_mul]
    obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff
      (Algebra.algebraMapSubmonoid B (Submonoid.powers (r * g))) Bₛ _).mp hbh
    have hcb := key (c * b) (by linear_combination hc)
    rw [map_mul, (IsLocalization.map_units Bₛ c).mul_right_eq_zero] at hcb
    exact (IsLocalization.map_units Bₛ m).mul_left_eq_zero.mp (hbm.trans hcb)
  obtain ⟨⟨a, m⟩, ha⟩ := IsLocalization.surj (Submonoid.powers (r * g))
    (Algebra.norm Aₛ (algebraMap B Bₛ h))
  refine ⟨r * g, hs, a, ?_, fun P hP hsP ↦ ?_⟩
  · rintro rfl
    rw [map_zero, (IsLocalization.map_units Aₛ m).mul_left_eq_zero] at ha
    exact Algebra.norm_ne_zero_of_mem_nonZeroDivisors hreg ha
  have hdisj : Disjoint (Submonoid.powers (r * g) : Set A) P := by
    refine Set.disjoint_left.mpr ?_
    rintro _ ⟨n, rfl⟩ hx
    exact hsP (hP.mem_of_pow_mem n hx)
  let P' := P.map (algebraMap A Aₛ)
  have hP' : P'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint _ Aₛ P hP hdisj
  have hP'P : P'.comap (algebraMap A Aₛ) = P :=
    IsLocalization.under_map_of_isPrime_disjoint _ Aₛ hP hdisj
  calc a ∈ P ↔ Algebra.norm Aₛ (algebraMap B Bₛ h) ∈ P' := by
        rw [← Ideal.mul_unit_mem_iff_mem P' (IsLocalization.map_units Aₛ m), ha,
          ← Ideal.mem_comap, hP'P]
    _ ↔ ∃ Q : Ideal Bₛ, Q.IsPrime ∧ Q.comap (algebraMap Aₛ Bₛ) = P' ∧
        algebraMap B Bₛ h ∈ Q := Algebra.norm_mem_iff_exists_isPrime P' _
    _ ↔ ∃ q : Ideal B, q.IsPrime ∧ q.comap (algebraMap A B) = P ∧ h ∈ q := by
      constructor
      · rintro ⟨Q, hQ, hQP, hhQ⟩
        refine ⟨Q.comap (algebraMap B Bₛ), Ideal.comap_isPrime _ _, ?_, hhQ⟩
        rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq,
          IsScalarTower.algebraMap_eq A Aₛ Bₛ, ← Ideal.comap_comap, hQP, hP'P]
      · rintro ⟨q, hq, hqP, hhq⟩
        have hdisj' : Disjoint
            (Algebra.algebraMapSubmonoid B (.powers (r * g)) : Set B) q := by
          refine Set.disjoint_left.mpr ?_
          rintro _ ⟨x, hx, rfl⟩ hxq
          exact Set.disjoint_left.mp hdisj hx (hqP ▸ Ideal.mem_comap.mpr hxq)
        have hqq : (q.map (algebraMap B Bₛ)).comap (algebraMap B Bₛ) = q :=
          IsLocalization.under_map_of_isPrime_disjoint _ Bₛ hq hdisj'
        refine ⟨q.map (algebraMap B Bₛ),
          IsLocalization.isPrime_of_isPrime_disjoint _ Bₛ q hq hdisj', ?_,
          Ideal.mem_map_of_mem _ hhq⟩
        rw [← IsLocalization.map_under (.powers (r * g)) Aₛ ((q.map _).comap _),
          Ideal.under_def, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq,
          IsScalarTower.algebraMap_eq A B Bₛ, ← Ideal.comap_comap,
          hqq, hqP]
    _ ↔ _ := by
      refine exists_congr fun q ↦ and_congr_right fun hq ↦ and_congr_right fun hqP ↦
        ⟨fun hhq i hi ↦ ?_, fun hIq ↦ hIq hhI⟩
      have hgq : algebraMap A B g ∉ q := fun hgq ↦ by
        have : g ∈ P := hqP ▸ Ideal.mem_comap.mpr hgq
        exact hsP (P.mul_mem_left r this)
      exact (hq.mem_or_mem ((Ideal.span_singleton_le_iff_mem _).mpr hhq (hgh i hi))).resolve_left
        hgq

/-- In a UFD, the radical of a nonzero principal ideal is principal, generated by a nonzero
element: its minimal primes are generated by the prime factors of the generator. -/
theorem Ideal.exists_ne_zero_radical_span_singleton_eq_span_singleton {R : Type*} [CommRing R]
    [IsDomain R] [IsNoetherianRing R] [UniqueFactorizationMonoid R] {a : R} (ha : a ≠ 0) :
    ∃ f : R, f ≠ 0 ∧ (Ideal.span {a}).radical = Ideal.span {f} := by
  refine (Ideal.radical_isRadical _).exists_ne_zero_eq_span_singleton fun q hq ↦ ?_
  rw [Ideal.radical_minimalPrimes] at hq
  have hqp := hq.1.1
  have hprod : (UniqueFactorizationMonoid.factors a).prod ∈ q := by
    obtain ⟨u, hu⟩ := UniqueFactorizationMonoid.factors_prod ha
    rw [← mul_one (UniqueFactorizationMonoid.factors a).prod, ← u.mul_inv, ← mul_assoc, hu]
    exact q.mul_mem_right _ (hq.1.2 (Ideal.mem_span_singleton_self a))
  obtain ⟨π, hπ, hπq⟩ := (hqp.multiset_prod_mem_iff_exists_mem _).mp hprod
  have hπp := UniqueFactorizationMonoid.prime_of_factor π hπ
  refine ⟨π, hπp, le_antisymm (hq.2 ⟨(Ideal.span_singleton_prime hπp.ne_zero).mpr hπp, ?_⟩ ?_) ?_⟩
  · exact Ideal.span_singleton_le_span_singleton.mpr
      (UniqueFactorizationMonoid.dvd_of_mem_factors hπ)
  · exact (Ideal.span_singleton_le_iff_mem q).mpr hπq
  · exact (Ideal.span_singleton_le_iff_mem q).mpr hπq

/-- Let `A` be a noetherian domain, `a ≠ 0` and `p` a prime of `A` at which `A` is factorial.
Then on a basic open neighbourhood `D(g)` of `p`, the radical of `(a)` is generated by a single
nonzero element `b`: indeed `g • √(a) ⊆ (b)`. -/
theorem Ideal.exists_notMem_mul_mem_span_radical_span_singleton {A : Type*} [CommRing A]
    [IsDomain A] [IsNoetherianRing A] (p : Ideal A) [p.IsPrime] (S : Type*) [CommRing S]
    [Algebra A S] [IsLocalization.AtPrime S p] [UniqueFactorizationMonoid S] {a : A}
    (ha : a ≠ 0) :
    ∃ g ∉ p, ∃ b ∈ (Ideal.span {a}).radical, b ≠ 0 ∧
      ∀ i ∈ (Ideal.span {a}).radical, g * i ∈ Ideal.span {b} := by
  have : IsDomain S := IsLocalization.isDomain_of_atPrime S p
  have : IsNoetherianRing S := IsLocalization.isNoetherianRing p.primeCompl S inferInstance
  have hinj : Function.Injective (algebraMap A S) :=
    IsLocalization.injective S p.primeCompl_le_nonZeroDivisors
  obtain ⟨f, hf0, hf⟩ := Ideal.exists_ne_zero_radical_span_singleton_eq_span_singleton
    ((map_ne_zero_iff _ hinj).mpr ha)
  have hf' : (Ideal.span {a}).radical.map (algebraMap A S) = Ideal.span {f} := by
    rw [IsLocalization.map_radical p.primeCompl, Ideal.map_span, Set.image_singleton, hf]
  obtain ⟨g, hg, b, hb, hspan, hgb⟩ :=
    Ideal.exists_notMem_mul_mem_span_singleton_of_map_eq p _ f hf'
  refine ⟨g, hg, b, hb, ?_, hgb⟩
  rintro rfl
  exact hf0 (Ideal.span_singleton_eq_bot.mp (hf'.symm.trans (hspan.trans (by simp))))

namespace AlgebraicGeometry

variable {X Y : Scheme.{u}}

/-- If `J` is invertible, then on an affine open `U` with `J(U)` finitely generated, `J(U)` is
locally generated by a non-zero-divisor in the following algebraic sense: for every prime `q` of
`Γ(X, U)` there are `t ∉ q` and `x ∈ J(U)` with `t • J(U) ⊆ (x)`, such that `x` becomes a
non-zero-divisor after inverting `t`. -/
lemma Scheme.IdealSheafData.IsInvertible.exists_notMem_mul_mem_span_singleton
    {J : X.IdealSheafData} (hJ : J.IsInvertible) (U : X.affineOpens) (hU : (J.ideal U).FG)
    (q : Ideal Γ(X, U)) [q.IsPrime] :
    ∃ t ∉ q, ∃ x ∈ J.ideal U, (∀ i ∈ J.ideal U, t * i ∈ Ideal.span {x}) ∧
      ∀ b, x * b = 0 → ∃ n : ℕ, t ^ n * b = 0 := by
  have hzU : U.2.fromSpec ⟨q, inferInstance⟩ ∈ U.1 := U.2.range_fromSpec.le ⟨_, rfl⟩
  obtain ⟨W, hzW, σ, hσ, hWσ⟩ := hJ (U.2.fromSpec ⟨q, inferInstance⟩)
  obtain ⟨t, t', htt', hzt⟩ := exists_basicOpen_le_affine_inter U.2 W.2 _ ⟨hzU, hzW⟩
  have htq : t ∉ q := by
    have : (⟨q, inferInstance⟩ : PrimeSpectrum Γ(X, U)) ∈ U.2.fromSpec ⁻¹ᵁ X.basicOpen t := hzt
    rwa [U.2.fromSpec_preimage_basicOpen] at this
  have hle : X.basicOpen t ≤ W.1 := htt' ▸ X.basicOpen_le t'
  have hρσ : (X.presheaf.map (homOfLE hle).op).hom σ ∈ nonZeroDivisors Γ(X, X.basicOpen t) := by
    let := (X.presheaf.map (homOfLE hle).op).hom.toAlgebra
    have := W.2.isLocalization_of_eq_basicOpen t' (homOfLE hle) htt'
    exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers t') _
      (Submonoid.mem_map_of_mem _ hσ)
  let := (X.presheaf.map (homOfLE (X.basicOpen_le t)).op).hom.toAlgebra
  have := U.2.isLocalization_basicOpen t
  have h1 : (J.ideal U).map (algebraMap Γ(X, U) Γ(X, X.basicOpen t)) =
      Ideal.span {(X.presheaf.map (homOfLE hle).op).hom σ} := by
    rw [RingHom.algebraMap_toAlgebra, J.map_ideal_basicOpen,
      ← J.map_ideal (U := X.affineBasicOpen t) (V := W) hle, hWσ, Ideal.map_span,
      Set.image_singleton]
    rfl
  obtain ⟨_, ⟨k, rfl⟩, x, hxI, hxspan, hxm⟩ :=
    Ideal.exists_mem_mul_mem_span_singleton_of_map_eq (.powers t) hU h1
  have hx : algebraMap Γ(X, U) Γ(X, X.basicOpen t) x ∈ nonZeroDivisors _ := by
    have : (X.presheaf.map (homOfLE hle).op).hom σ ∈
        Ideal.span {algebraMap Γ(X, U) Γ(X, X.basicOpen t) x} := by
      rw [← hxspan, h1]
      exact Ideal.mem_span_singleton_self _
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp this
    refine mem_nonZeroDivisors_iff_right.mpr fun y hy ↦
      mem_nonZeroDivisors_iff_right.mp hρσ y ?_
    rw [← hd, mul_left_comm, hy, mul_zero]
  refine ⟨t ^ (k + 1), fun h ↦ htq (‹q.IsPrime›.mem_of_pow_mem _ h), x, hxI, fun i hi ↦ ?_,
    fun b hb ↦ ?_⟩
  · rw [pow_succ', mul_assoc]
    exact Ideal.mul_mem_left _ _ (hxm i hi)
  · have : algebraMap Γ(X, U) Γ(X, X.basicOpen t) b = 0 :=
      mem_nonZeroDivisors_iff_right.mp hx _ (by rw [mul_comm, ← map_mul, hb, map_zero])
    obtain ⟨⟨_, n, rfl⟩, hn⟩ := (IsLocalization.map_eq_zero_iff (.powers t) _ b).mp this
    have hn' : t ^ n * b = 0 := hn
    exact ⟨n, by rw [← pow_mul, mul_comm (k + 1) n, pow_mul, pow_succ, mul_assoc, hn', mul_zero]⟩

/-- Let `Y` be a locally noetherian integral scheme whose local rings are UFDs, and `Z ⊆ Y` a
closed subset which is locally the zero locus of a single nonzero function. Then the vanishing
ideal of `Z` is invertible: on an affine open `V` where `Z = V(a)`, it is the radical of `(a)`,
which is principal in the factorial local rings, hence near every point. -/
theorem Scheme.isInvertible_vanishingIdeal_of_forall_eq_compl_basicOpen (Y : Scheme.{u})
    [IsLocallyNoetherian Y] [IsIntegral Y]
    (hY : ∀ y : Y, UniqueFactorizationMonoid (Y.presheaf.stalk y)) {Z : Set Y}
    (hZ : IsClosed Z) (h : ∀ y : Y, ∃ V : Y.affineOpens, y ∈ V.1 ∧ ∃ a : Γ(Y, V), a ≠ 0 ∧
      Z ∩ (V.1 : Set Y) = (Y.basicOpen a : Set Y)ᶜ ∩ V.1) :
    (IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).IsInvertible := by
  intro y
  obtain ⟨⟨V, hV⟩, hyV, a, ha, hZV⟩ := h y
  have : Nonempty V := ⟨⟨y, hyV⟩⟩
  have := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  have hI : (IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal ⟨V, hV⟩ =
      (Ideal.span {a}).radical := by
    rw [IdealSheafData.vanishingIdeal_ideal, ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      PrimeSpectrum.zeroLocus_span]
    congr 1
    ext P
    have hPV : hV.fromSpec P ∈ V := hV.range_fromSpec.le ⟨P, rfl⟩
    have hmem : hV.fromSpec P ∈ Z ↔ hV.fromSpec P ∉ Y.basicOpen a := by
      simpa [hPV] using congr(hV.fromSpec P ∈ $hZV)
    have hbo : hV.fromSpec P ∈ Y.basicOpen a ↔ P ∈ PrimeSpectrum.basicOpen a := by
      rw [← hV.fromSpec_preimage_basicOpen]
      rfl
    rw [Set.mem_preimage, Closeds.coe_mk, hmem, hbo, PrimeSpectrum.mem_basicOpen, not_not,
      PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe]
  let := TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hyV⟩
  have := hV.isLocalization_stalk ⟨y, hyV⟩
  have := hY y
  obtain ⟨g, hg, b, hb, hb0, hgb⟩ := Ideal.exists_notMem_mul_mem_span_radical_span_singleton
    (hV.primeIdealOf ⟨y, hyV⟩).asIdeal (Y.presheaf.stalk y) ha
  have hx : y ∈ Y.basicOpen g :=
    (Y.mem_basicOpen g y hyV).mpr (IsLocalization.map_units (Y.presheaf.stalk y)
      (M := (hV.primeIdealOf ⟨y, hyV⟩).asIdeal.primeCompl) ⟨g, hg⟩)
  have : Nonempty (Y.basicOpen g) := ⟨⟨y, hx⟩⟩
  refine ⟨Y.affineBasicOpen (U := ⟨V, hV⟩) g, hx, ?_⟩
  let := (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom.toAlgebra
  have := hV.isLocalization_basicOpen g
  have key : (IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal (Y.affineBasicOpen (U := ⟨V, hV⟩) g) =
      Ideal.span {algebraMap Γ(Y, V) Γ(Y, Y.basicOpen g) b} := by
    rw [← IdealSheafData.map_ideal_basicOpen, hI]
    exact Ideal.map_eq_span_singleton_of_mul_mem_span_singleton g hb hgb
  rw [key]
  exact Ideal.isRegularPrincipal_span_singleton
    (mem_nonZeroDivisors_of_ne_zero (M₀ := Γ(Y, Y.basicOpen g))
      ((map_ne_zero_iff _ (map_injective_of_isIntegral Y _)).mpr hb0))

/-- Let `Y` be a locally noetherian integral scheme whose local rings are UFDs, and `Z ⊆ Y` a
closed subset which is locally the zero locus of a single nonzero function. Then `Z` is the
support of an invertible ideal sheaf, namely its vanishing ideal. -/
theorem Scheme.exists_isInvertible_support_eq_of_forall_eq_compl_basicOpen (Y : Scheme.{u})
    [IsLocallyNoetherian Y] [IsIntegral Y]
    (hY : ∀ y : Y, UniqueFactorizationMonoid (Y.presheaf.stalk y)) {Z : Set Y}
    (hZ : IsClosed Z) (h : ∀ y : Y, ∃ V : Y.affineOpens, y ∈ V.1 ∧ ∃ a : Γ(Y, V), a ≠ 0 ∧
      Z ∩ (V.1 : Set Y) = (Y.basicOpen a : Set Y)ᶜ ∩ V.1) :
    ∃ E : Y.IdealSheafData, E.IsInvertible ∧ (E.support : Set Y) = Z :=
  ⟨_, Y.isInvertible_vanishingIdeal_of_forall_eq_compl_basicOpen hY hZ h,
    IdealSheafData.coe_support_vanishingIdeal _⟩

/-- A point `P` of `Spec Γ(X, U)` lies in the basic open of `r` iff `r ∉ P`. -/
lemma IsAffineOpen.fromSpec_mem_basicOpen_iff {U : X.Opens} (hU : IsAffineOpen U)
    (P : PrimeSpectrum Γ(X, U)) (r : Γ(X, U)) :
    hU.fromSpec P ∈ X.basicOpen r ↔ r ∉ P.asIdeal := by
  rw [← PrimeSpectrum.mem_basicOpen, ← hU.fromSpec_preimage_basicOpen]
  rfl

/-- A point `P` of `Spec Γ(X, U)` lies in the support of `J` iff `J(U) ⊆ P`. -/
lemma Scheme.IdealSheafData.fromSpec_mem_support_iff (J : X.IdealSheafData)
    (U : X.affineOpens) (P : PrimeSpectrum Γ(X, U)) :
    U.2.fromSpec P ∈ J.support ↔ J.ideal U ≤ P.asIdeal := by
  rw [mem_support_iff_of_mem (U.2.range_fromSpec.le ⟨P, rfl⟩), Scheme.mem_zeroLocus_iff]
  refine forall₂_congr fun i _ ↦ ?_
  rw [U.2.fromSpec_mem_basicOpen_iff, not_not]

/-- Let `f : X ⟶ Y` be a morphism, `V ⊆ Y` an affine open with affine preimage. A point `P` of
`Spec Γ(Y, V)` lies in the image of the support of `J` iff `J(f⁻¹ V)` is contained in a prime of
`Γ(X, f⁻¹ V)` lying over `P`. -/
lemma Scheme.IdealSheafData.fromSpec_mem_image_support_iff (f : X ⟶ Y) {V : Y.Opens}
    (hV : IsAffineOpen V) (hU : IsAffineOpen (f ⁻¹ᵁ V)) (J : X.IdealSheafData)
    (P : PrimeSpectrum Γ(Y, V)) :
    hV.fromSpec P ∈ f.base '' (J.support : Set X) ↔ ∃ q : Ideal Γ(X, f ⁻¹ᵁ V), q.IsPrime ∧
      q.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom = P.asIdeal ∧ J.ideal ⟨_, hU⟩ ≤ q := by
  have key (Q : PrimeSpectrum Γ(X, f ⁻¹ᵁ V)) :
      f (hU.fromSpec Q) = hV.fromSpec (Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) Q) := by
    rw [← Scheme.Hom.comp_apply, ← IsAffineOpen.SpecMap_appLE_fromSpec f hV hU le_rfl,
      Scheme.Hom.comp_apply]
  constructor
  · rintro ⟨x, hx, hxP⟩
    have hxU : x ∈ f ⁻¹ᵁ V := by
      rw [Scheme.Hom.mem_preimage, hxP]
      exact hV.range_fromSpec.le ⟨P, rfl⟩
    obtain ⟨Q, rfl⟩ : x ∈ Set.range hU.fromSpec := hU.range_fromSpec ▸ hxU
    refine ⟨Q.asIdeal, Q.2, ?_, (J.fromSpec_mem_support_iff ⟨_, hU⟩ Q).mp hx⟩
    rw [key] at hxP
    exact congrArg PrimeSpectrum.asIdeal (hV.fromSpec.isOpenEmbedding.injective hxP)
  · rintro ⟨q, hq, hqP, hJq⟩
    refine ⟨hU.fromSpec ⟨q, hq⟩, (J.fromSpec_mem_support_iff ⟨_, hU⟩ ⟨q, hq⟩).mpr hJq, ?_⟩
    rw [key]
    congr 1
    exact PrimeSpectrum.ext hqP

/-- **The image of an effective Cartier divisor under a finite locally free morphism is an
effective Cartier divisor**, provided the target has factorial local rings. Let `f : X ⟶ Y` be
finite, flat and locally of finite presentation, with `Y` locally noetherian, integral, with
local rings UFDs, and let `J` be an invertible ideal sheaf on `X`. Then `f(V(J))` is the support
of an invertible ideal sheaf on `Y`.

Locally on `Y`, `f` is given by a finite free algebra over which `J` is principal, generated by
a non-zero-divisor `h`; the image of `V(J)` is then the zero locus of the norm of `h`. -/
theorem Scheme.Hom.exists_isInvertible_support_eq_image {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsFinite f] [Flat f] [LocallyOfFinitePresentation f] [IsLocallyNoetherian Y]
    [IsIntegral Y] (hY : ∀ y : Y, UniqueFactorizationMonoid (Y.presheaf.stalk y))
    {J : X.IdealSheafData} (hJ : J.IsInvertible) :
    ∃ E : Y.IdealSheafData, E.IsInvertible ∧
      (E.support : Set Y) = f.base '' (J.support : Set X) := by
  have hZ : IsClosed (f.base '' (J.support : Set X)) := f.isClosedMap _ J.support.isClosed
  refine Y.exists_isInvertible_support_eq_of_forall_eq_compl_basicOpen hY hZ fun y ↦ ?_
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
  have hU : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
  have := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  have : Nonempty V := ⟨⟨y, hyV⟩⟩
  let := (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.toAlgebra
  have : Module.Finite Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := by
    have := f.finite_app V hV
    rwa [← f.appLE_eq_app] at this
  have : Module.Flat Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := f.flat_appLE hV hU le_rfl
  have : Algebra.FinitePresentation Γ(Y, V) Γ(X, f ⁻¹ᵁ V) :=
    HasRingHomProperty.appLE @LocallyOfFinitePresentation f ‹_› ⟨V, hV⟩ ⟨_, hU⟩ le_rfl
  have : Module.FinitePresentation Γ(Y, V) Γ(X, f ⁻¹ᵁ V) :=
    .of_finite_of_finitePresentation _ _
  have : IsNoetherianRing Γ(X, f ⁻¹ᵁ V) := isNoetherian_of_tower Γ(Y, V) inferInstance
  obtain ⟨P, rfl⟩ : y ∈ Set.range hV.fromSpec := hV.range_fromSpec ▸ hyV
  obtain ⟨s, hs, a, ha, hiff⟩ := Ideal.exists_ne_zero_mem_iff_exists_le (J.ideal ⟨_, hU⟩)
    (fun q _ ↦ hJ.exists_notMem_mul_mem_span_singleton ⟨_, hU⟩ (IsNoetherian.noetherian _) q)
    P.asIdeal
  have hys : hV.fromSpec P ∈ Y.basicOpen s := (hV.fromSpec_mem_basicOpen_iff P s).mpr hs
  have : Nonempty (Y.basicOpen s) := ⟨⟨_, hys⟩⟩
  refine ⟨Y.affineBasicOpen (U := ⟨V, hV⟩) s, hys,
    Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op a,
    (map_ne_zero_iff _ (map_injective_of_isIntegral Y _)).mpr ha, ?_⟩
  have hres : Y.basicOpen (Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op a) =
      Y.basicOpen s ⊓ Y.basicOpen a := Y.basicOpen_res _ _
  ext y'
  rw [hres, Set.mem_inter_iff, Set.mem_inter_iff,
    Set.mem_compl_iff]
  refine and_congr_left fun hy' ↦ ?_
  obtain ⟨P', rfl⟩ : y' ∈ Set.range hV.fromSpec :=
    hV.range_fromSpec ▸ Y.basicOpen_le s hy'
  have hsP' : s ∉ P'.asIdeal := (hV.fromSpec_mem_basicOpen_iff P' s).mp hy'
  rw [IdealSheafData.fromSpec_mem_image_support_iff f hV hU, Opens.coe_inf, Set.mem_inter_iff]
  refine (hiff P'.asIdeal P'.2 hsP').symm.trans
    ⟨fun h ⟨_, hB⟩ ↦ (hV.fromSpec_mem_basicOpen_iff P' a).mp hB h, fun h ↦ ?_⟩
  by_contra ha
  exact h ⟨hy', (hV.fromSpec_mem_basicOpen_iff P' a).mpr ha⟩
end AlgebraicGeometry
