/-!
# The complement of an affine open is an effective Cartier divisor

Let `X` be a separated noetherian integral scheme all of whose local rings are unique
factorization domains (for instance a regular one), and let `U ⊆ X` be a nonempty affine open.
Then the reduced complement `X \ U` is the support of an invertible ideal sheaf, i.e. it is an
effective Cartier divisor (Stacks 0BCW).

The proof goes through the following steps.

* `AlgebraicGeometry.Scheme.eq_top_of_isAffineOpen_of_not_le_basicOpen`: an algebraic Hartogs
  lemma. On an affine integral scheme whose ring of global sections is a UFD, a nonempty affine
  open meeting the zero locus of every prime element is everything: a section over it is a
  reduced fraction `a / b` of the function field, and a prime factor of `b` would give a pole
  at a point of the open.
* `AlgebraicGeometry.exists_prime_eq_span_of_mem_minimalPrimes`: on the spectrum of a
  noetherian UFD, the minimal primes over the vanishing ideal of the complement of a nonempty
  affine open are principal (localise at such a prime and apply the Hartogs lemma).
* `AlgebraicGeometry.exists_vanishingIdeal_compl_eq_span`: consequently that vanishing ideal is
  principal, generated by a nonzero element.
* `AlgebraicGeometry.Scheme.exists_isInvertible_support_eq_compl`: globalisation, by applying
  the above to the local rings of `X` and spreading out to basic open neighbourhoods.
-/

@[expose] public section

universe u

open CategoryTheory TopologicalSpace Opposite

namespace AlgebraicGeometry

/-- **Algebraic Hartogs lemma.** Let `X` be an affine integral scheme whose ring of global
sections is a UFD, and let `W ⊆ X` be a nonempty affine open which meets the zero locus of every
prime element of `Γ(X, ⊤)`. Then `W = X`.

The restriction `Γ(X, ⊤) → Γ(X, W)` is injective since `X` is integral. It is surjective:
write the image of a section over `W` in the function field as a reduced fraction `a / b`; a
prime factor `π` of `b` vanishes at some point `y ∈ W`, and writing the germ at `y` as `c / d`
with `d` a unit at `y` gives `a d = b c`, so `π ∣ a`, a contradiction. Hence the affine open `W`
has the same ring of sections as `X`, so `W = X`. -/
theorem Scheme.eq_top_of_isAffineOpen_of_not_le_basicOpen {X : Scheme.{u}} [IsAffine X]
    [IsIntegral X] [UniqueFactorizationMonoid Γ(X, ⊤)] {W : X.Opens} (hW : IsAffineOpen W)
    [Nonempty W] (h : ∀ π : Γ(X, ⊤), Prime π → ¬W ≤ X.basicOpen π) : W = ⊤ := by
  have : Nonempty (⊤ : X.Opens) := ⟨⟨(Nonempty.some ‹Nonempty W›).1, trivial⟩⟩
  have := functionField_isFractionRing_of_isAffineOpen X ⊤ (isAffineOpen_top X)
  let ρ := X.presheaf.map (homOfLE le_top : W ⟶ ⊤).op
  have hρ : Function.Bijective ρ := by
    refine ⟨map_injective_of_isIntegral X _, fun s ↦ ?_⟩
    obtain ⟨a, b, hab, hs⟩ :=
      IsFractionRing.exists_reduced_fraction Γ(X, ⊤) (X.germToFunctionField W s)
    by_cases hb : IsUnit (b : Γ(X, ⊤))
    · refine ⟨a * ↑hb.unit⁻¹, X.germToFunctionField_injective W ?_⟩
      rw [← hs, X.presheaf.germ_res_apply, eq_comm, IsLocalization.mk'_eq_iff_eq_mul]
      calc algebraMap Γ(X, ⊤) X.functionField a
          = algebraMap Γ(X, ⊤) X.functionField (a * ↑hb.unit⁻¹ * b) := by
            rw [mul_assoc, hb.val_inv_mul, mul_one]
        _ = _ := map_mul _ _ _
    · exfalso
      obtain ⟨π, hπirr, hπb⟩ :=
        WfDvdMonoid.exists_irreducible_factor hb (nonZeroDivisors.ne_zero b.2)
      have hπ := hπirr.prime
      obtain ⟨y, hyW, hyπ⟩ := Set.not_subset.mp (h π hπ)
      let := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨y, trivial⟩ : (⊤ : X.Opens))
      have := (isAffineOpen_top X).isLocalization_stalk ⟨y, trivial⟩
      obtain ⟨⟨c, d⟩, hcd⟩ := IsLocalization.mk'_surjective
        ((isAffineOpen_top X).primeIdealOf ⟨y, trivial⟩).asIdeal.primeCompl
        (X.presheaf.germ W y hyW s)
      have e (r : Γ(X, ⊤)) :
          algebraMap Γ(X, ⊤) (X.presheaf.stalk y) r = X.presheaf.germ ⊤ y trivial r := rfl
      have e' (r : Γ(X, ⊤)) :
          X.germToFunctionField ⊤ r = algebraMap Γ(X, ⊤) X.functionField r := rfl
      have hπd : ¬π ∣ (d : Γ(X, ⊤)) := by
        refine fun hπd ↦ hyπ ((X.mem_basicOpen π y trivial).mpr (isUnit_of_dvd_unit
          (map_dvd (X.presheaf.germ ⊤ y trivial).hom hπd) ?_))
        rw [← e]
        exact IsLocalization.map_units _ d
      have h1 := congrArg (algebraMap (X.presheaf.stalk y) X.functionField)
        (IsLocalization.mk'_spec (X.presheaf.stalk y) c d)
      dsimp only at hcd
      rw [hcd, e, e, map_mul, Scheme.algebraMap_germ_eq_germToFunctionField,
        Scheme.algebraMap_germ_eq_germToFunctionField,
        Scheme.algebraMap_germ_eq_germToFunctionField, ← hs, e', e'] at h1
      have h2 : a * d = b * c := IsFractionRing.injective Γ(X, ⊤) X.functionField (by
        rw [map_mul, map_mul, ← IsLocalization.mk'_spec X.functionField a b, ← h1]
        ring)
      obtain hπa | hπd' := hπ.dvd_or_dvd (h2 ▸ hπb.mul_right c)
      · exact hπ.not_isUnit (hab hπa hπb)
      · exact hπd hπd'
  have : IsIso ρ := (ConcreteCategory.isIso_iff_bijective ρ).mpr hρ
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨z, hz⟩ : x ∈ Set.range (isAffineOpen_top X).fromSpec := by
    rw [IsAffineOpen.range_fromSpec]
    trivial
  obtain ⟨z', rfl⟩ := (ConcreteCategory.bijective_of_isIso (Spec.map ρ).base).2 z
  rw [← SetLike.mem_coe, ← hW.range_fromSpec, ← hz]
  exact ⟨z', by rw [← Scheme.Hom.comp_apply, IsAffineOpen.map_fromSpec]⟩

/-- **Algebraic Hartogs lemma** for the spectrum of a UFD, in contrapositive form: if a nonempty
affine open `W` of `Spec B` is not everything, then it is contained in the basic open of some
prime element of `B`. -/
theorem exists_prime_le_basicOpen_of_isAffineOpen (B : CommRingCat.{u}) [IsDomain B]
    [UniqueFactorizationMonoid B] {W : (Spec B).Opens} (hW : IsAffineOpen W)
    (hne : (W : Set (Spec B)).Nonempty) (hW' : W ≠ ⊤) :
    ∃ π : B, Prime π ∧ W ≤ PrimeSpectrum.basicOpen π := by
  by_contra! H
  have : Nonempty W := hne.to_subtype
  have : UniqueFactorizationMonoid Γ(Spec B, ⊤) :=
    (Scheme.ΓSpecIso B).commRingCatIsoToRingEquiv.toMulEquiv.symm.uniqueFactorizationMonoid
      inferInstance
  refine hW' (Scheme.eq_top_of_isAffineOpen_of_not_le_basicOpen hW fun π hπ hle ↦
    H ((Scheme.ΓSpecIso B).hom π) ?_ ?_)
  · exact (MulEquiv.prime_iff
      (Scheme.ΓSpecIso B).commRingCatIsoToRingEquiv.toMulEquiv).mpr hπ
  · rwa [← basicOpen_eq_of_affine, Iso.hom_inv_id_apply]

/-- On the spectrum of a UFD, the minimal primes over the vanishing ideal of the complement of
a nonempty affine open are generated by prime elements. This is the statement that the
complement of an affine open has pure codimension one: localising at such a minimal prime `q`,
the preimage of the open is the punctured spectrum, which is affine, so by the algebraic
Hartogs lemma the maximal ideal is generated by a prime element. -/
theorem exists_prime_eq_span_of_mem_minimalPrimes (B : CommRingCat.{u}) [IsDomain B]
    [UniqueFactorizationMonoid B] {W : (Spec B).Opens} (hW : IsAffineOpen W)
    (hne : (W : Set (Spec B)).Nonempty) {q : Ideal B}
    (hq : q ∈ (PrimeSpectrum.vanishingIdeal (W : Set (Spec B))ᶜ).minimalPrimes) :
    ∃ π : B, Prime π ∧ q = Ideal.span {π} := by
  set I := PrimeSpectrum.vanishingIdeal (W : Set (Spec B))ᶜ
  have hqp : q.IsPrime := hq.1.1
  have hmem (P : PrimeSpectrum B) : I ≤ P.asIdeal ↔ P ∉ (W : Set (Spec B)) := by
    have := PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure (W : Set (Spec B))ᶜ
    rw [W.isOpen.isClosed_compl.closure_eq] at this
    exact (PrimeSpectrum.mem_zeroLocus P I).symm.trans (Set.ext_iff.mp this P)
  have hbot (P : PrimeSpectrum B) (hP : P.asIdeal = ⊥) : P ∈ (W : Set (Spec B)) :=
    PrimeSpectrum.mem_of_isOpen_of_asIdeal_eq_bot W.isOpen hne hP
  have hq0 : q ≠ ⊥ := fun h ↦ (hmem ⟨q, hqp⟩).mp hq.1.2 (hbot _ h)
  obtain ⟨π, hπq, hπ⟩ := hqp.exists_mem_prime_of_ne_bot hq0
  refine ⟨π, hπ, ?_⟩
  let B' := CommRingCat.of (Localization.AtPrime q)
  let φ : B ⟶ B' := CommRingCat.ofHom (algebraMap B (Localization.AtPrime q))
  have hinj : Function.Injective (algebraMap B (Localization.AtPrime q)) :=
    IsLocalization.injective _ q.primeCompl_le_nonZeroDivisors
  have hφ (P : Spec B') : (Spec.map φ P).asIdeal = P.asIdeal.under B := rfl
  have hmax : (IsLocalRing.closedPoint B').asIdeal.under B = q :=
    Localization.AtPrime.under_maximalIdeal
  obtain ⟨π', hπ', hle⟩ := exists_prime_le_basicOpen_of_isAffineOpen B'
    (hW.preimage (Spec.map φ))
    ⟨⟨⊥, Ideal.isPrime_bot⟩, hbot _ (Ideal.comap_bot_of_injective _ hinj)⟩
    fun h ↦ (hmem (Spec.map φ (IsLocalRing.closedPoint B'))).mp
      (le_of_le_of_eq hq.1.2 hmax.symm)
      (h.symm ▸ trivial : IsLocalRing.closedPoint B' ∈ Spec.map φ ⁻¹ᵁ W)
  let P' : PrimeSpectrum B' := ⟨_, (Ideal.span_singleton_prime hπ'.ne_zero).mpr hπ'⟩
  have hP' : P' ∉ Spec.map φ ⁻¹ᵁ W := fun h ↦ hle h (Ideal.mem_span_singleton_self π')
  have hqP' : q ≤ P'.asIdeal.under B := by
    refine hq.2 ⟨(Spec.map φ P').isPrime, (hmem (Spec.map φ P')).mpr hP'⟩ ?_
    exact (Ideal.comap_mono (IsLocalRing.le_maximalIdeal P'.2.ne_top)).trans hmax.le
  have hdisj : Disjoint (q.primeCompl : Set B) (Ideal.span {π}) := by
    refine Set.disjoint_left.mpr fun x hx hx' ↦ hx ?_
    exact (Ideal.span_singleton_le_iff_mem q).mpr hπq hx'
  have hspan : (Ideal.span {π}).map (algebraMap B (Localization.AtPrime q)) =
      Ideal.span {algebraMap B _ π} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hprime : Prime (algebraMap B (Localization.AtPrime q) π) := by
    refine (Ideal.span_singleton_prime ((map_ne_zero_iff _ hinj).mpr hπ.ne_zero)).mp ?_
    rw [← hspan]
    exact IsLocalization.isPrime_of_isPrime_disjoint q.primeCompl _ _
      ((Ideal.span_singleton_prime hπ.ne_zero).mpr hπ) hdisj
  have hdvd : π' ∣ algebraMap B _ π := Ideal.mem_span_singleton.mp (hqP' hπq)
  have hP'eq : P'.asIdeal = Ideal.span {algebraMap B _ π} :=
    Ideal.span_singleton_eq_span_singleton.mpr (hπ'.associated_of_dvd hprime hdvd)
  refine le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem q).mpr hπq)
  rwa [hP'eq, ← hspan, IsLocalization.under_map_of_isPrime_disjoint q.primeCompl _
    ((Ideal.span_singleton_prime hπ.ne_zero).mpr hπ) hdisj] at hqP'

/-- On the spectrum of a noetherian UFD, the vanishing ideal of the complement of a nonempty
affine open is generated by a single nonzero element. -/
theorem exists_vanishingIdeal_compl_eq_span (B : CommRingCat.{u}) [IsDomain B]
    [IsNoetherianRing B] [UniqueFactorizationMonoid B] {W : (Spec B).Opens}
    (hW : IsAffineOpen W) (hne : (W : Set (Spec B)).Nonempty) :
    ∃ f : B, f ≠ 0 ∧ PrimeSpectrum.vanishingIdeal (W : Set (Spec B))ᶜ = Ideal.span {f} :=
  (PrimeSpectrum.isRadical_vanishingIdeal _).exists_ne_zero_eq_span_singleton
    fun _ hq ↦ exists_prime_eq_span_of_mem_minimalPrimes B hW hne hq

/-- Let `A` be a noetherian domain, `W ⊆ Spec A` a nonempty affine open and `p` a prime of `A`
at which the localization of `A` is a UFD. Then on a basic open neighbourhood `D(g)` of `p` the
vanishing ideal `I` of the complement of `W` is generated by a single nonzero element `b ∈ I`:
indeed `g • I ⊆ (b)`. -/
theorem exists_notMem_mul_mem_span_vanishingIdeal_compl (A : CommRingCat.{u}) [IsDomain A]
    [IsNoetherianRing A] {W : (Spec A).Opens} (hW : IsAffineOpen W)
    (hne : (W : Set (Spec A)).Nonempty) (p : Ideal A) [p.IsPrime] (S : Type u) [CommRing S]
    [Algebra A S] [IsLocalization.AtPrime S p] [UniqueFactorizationMonoid S] :
    ∃ g ∉ p, ∃ b ∈ PrimeSpectrum.vanishingIdeal (W : Set (Spec A))ᶜ, b ≠ 0 ∧
      ∀ i ∈ PrimeSpectrum.vanishingIdeal (W : Set (Spec A))ᶜ, g * i ∈ Ideal.span {b} := by
  have : IsDomain S := IsLocalization.isDomain_of_atPrime S p
  have : IsNoetherianRing S := IsLocalization.isNoetherianRing p.primeCompl S inferInstance
  let φ : A ⟶ CommRingCat.of S := CommRingCat.ofHom (algebraMap A S)
  have hinj : Function.Injective (algebraMap A S) :=
    IsLocalization.injective S p.primeCompl_le_nonZeroDivisors
  obtain ⟨f, hf0, hf⟩ := exists_vanishingIdeal_compl_eq_span (CommRingCat.of S)
    (hW.preimage (Spec.map φ)) ⟨⟨⊥, Ideal.isPrime_bot⟩,
      PrimeSpectrum.mem_of_isOpen_of_asIdeal_eq_bot W.isOpen hne
        (Ideal.comap_bot_of_injective _ hinj)⟩
  have hf' : (PrimeSpectrum.vanishingIdeal (W : Set (Spec A))ᶜ).map (algebraMap A S) =
      Ideal.span {f} :=
    (PrimeSpectrum.vanishingIdeal_preimage_comap_of_isLocalization p.primeCompl
      W.isOpen.isClosed_compl).symm.trans hf
  obtain ⟨g, hg, b, hb, hspan, hgb⟩ :=
    Ideal.exists_notMem_mul_mem_span_singleton_of_map_eq p _ f hf'
  refine ⟨g, hg, b, hb, ?_, hgb⟩
  rintro rfl
  exact hf0 (Ideal.span_singleton_eq_bot.mp (hf'.symm.trans (hspan.trans (by simp))))

/-- **The complement of an affine open is an effective Cartier divisor.** Let `X` be a
separated noetherian integral scheme whose local rings are UFDs (e.g. a regular one), and let
`U ⊆ X` be a nonempty affine open. Then `X \ U` is the support of an invertible ideal sheaf,
namely the vanishing ideal of `X \ U`. -/
@[stacks 0BCW]
theorem Scheme.exists_isInvertible_support_eq_compl (X : Scheme.{u}) [IsNoetherian X]
    [X.IsSeparated] [IsIntegral X]
    (hX : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x))
    {U : X.Opens} (hU : IsAffineOpen U) (hne : (U : Set X).Nonempty) :
    ∃ J : X.IdealSheafData, J.IsInvertible ∧ (J.support : Set X) = (U : Set X)ᶜ := by
  refine ⟨IdealSheafData.vanishingIdeal ⟨(U : Set X)ᶜ, U.isOpen.isClosed_compl⟩,
    fun x ↦ ?_, IdealSheafData.coe_support_vanishingIdeal _⟩
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
  have : Nonempty V := ⟨⟨x, hxV⟩⟩
  have : IsAffineHom hV.fromSpec := IsAffineHom.of_comp hV.fromSpec (Limits.terminal.from X)
  have hWne : (hV.fromSpec ⁻¹ᵁ U : Set (Spec Γ(X, V))).Nonempty := by
    obtain ⟨z, hzU, hzV⟩ := nonempty_preirreducible_inter U.isOpen V.isOpen hne ⟨x, hxV⟩
    obtain ⟨z', rfl⟩ : z ∈ Set.range hV.fromSpec := hV.range_fromSpec ▸ hzV
    exact ⟨z', hzU⟩
  have := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  have := hV.isLocalization_stalk ⟨x, hxV⟩
  have := hX x
  obtain ⟨g, hg, b, hb, hb0, hgb⟩ := exists_notMem_mul_mem_span_vanishingIdeal_compl Γ(X, V)
    (hU.preimage hV.fromSpec) hWne (hV.primeIdealOf ⟨x, hxV⟩).asIdeal (X.presheaf.stalk x)
  have hx : x ∈ X.basicOpen g :=
    (X.mem_basicOpen g x hxV).mpr (IsLocalization.map_units (X.presheaf.stalk x)
      (M := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl) ⟨g, hg⟩)
  have : Nonempty (X.basicOpen g) := ⟨⟨x, hx⟩⟩
  refine ⟨X.affineBasicOpen (U := ⟨V, hV⟩) g, hx, ?_⟩
  let := (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom.toAlgebra
  have := hV.isLocalization_basicOpen g
  have key : (IdealSheafData.vanishingIdeal ⟨(U : Set X)ᶜ, U.isOpen.isClosed_compl⟩).ideal
      (X.affineBasicOpen (U := ⟨V, hV⟩) g) =
        Ideal.span {algebraMap Γ(X, V) Γ(X, X.basicOpen g) b} := by
    rw [← IdealSheafData.map_ideal_basicOpen]
    exact Ideal.map_eq_span_singleton_of_mul_mem_span_singleton g hb hgb
  rw [key]
  exact Ideal.isRegularPrincipal_span_singleton
    (mem_nonZeroDivisors_of_ne_zero (M₀ := Γ(X, X.basicOpen g))
      ((map_ne_zero_iff _ (map_injective_of_isIntegral X _)).mpr hb0))

end AlgebraicGeometry
