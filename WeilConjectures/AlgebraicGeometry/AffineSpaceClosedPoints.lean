module

public import Mathlib.AlgebraicGeometry.AffineSpace
public import Mathlib.RingTheory.Jacobson.Ring
public import WeilConjectures.AlgebraicGeometry.GenericFiber.ProjectiveCoordinate

/-!
# Closed points of affine space are detected by the coordinates

Let `k` be a field. A point `y` of the affine space `𝔸ⁿ_k` whose coordinates are all closed points
of the line `𝔸¹_k` is a closed point
(`AlgebraicGeometry.AffineSpace.isClosed_singleton_of_forall_isClosed_singleton_reindex`).
Algebraically: a prime `p` of `k[Xᵢ]` whose contractions to the subrings `k[Xᵢ]` are maximal is
maximal (`MvPolynomial.isMaximal_of_forall_isMaximal_comap_rename`), since `k[Xᵢ]/p` is then
generated by elements integral over `k`.

This is used in the finite-support step of Gabber's Künneth formula for nearby cycles: the
coordinates of a closed immersion into affine space detect closed points.
-/

@[expose] public section

universe u

open CategoryTheory

namespace MvPolynomial

variable {k : Type*} [Field k] {n ι : Type*}

/-- If a maximal ideal `m` of a polynomial ring `k[Xᵢ]` in finitely many variables lies in the
kernel of `φ : k[Xᵢ] ⟶ A`, the images `φ(Xᵢ)` are integral over `k`: `k[Xᵢ]/m` is a field finitely
generated over `k`, hence finite over `k` (Zariski's lemma). -/
lemma isIntegral_of_forall_mem_eq_zero {A : Type*} [CommRing A] [Algebra k A] [Finite ι]
    (m : Ideal (MvPolynomial ι k)) [m.IsMaximal] (φ : MvPolynomial ι k →ₐ[k] A)
    (hm : ∀ a ∈ m, φ a = 0) (i : ι) : IsIntegral k (φ (X i)) := by
  let := Ideal.Quotient.field m
  have : Algebra.FiniteType k (MvPolynomial ι k ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m) (Ideal.Quotient.mkₐ_surjective k m)
  have : Module.Finite k (MvPolynomial ι k ⧸ m) := finite_of_finite_type_of_isJacobsonRing k _
  have hx : IsIntegral k (Ideal.Quotient.mkₐ k m (X i)) := Algebra.IsIntegral.isIntegral _
  have := hx.map (Ideal.Quotient.liftₐ m φ hm)
  rwa [← AlgHom.comp_apply, Ideal.Quotient.liftₐ_comp] at this

/-- **A prime of `k[Xᵢ]` whose contractions to the subrings `k[Xᵢ]` are maximal is maximal.**
For each `i`, the image of `Xᵢ` in `k[Xᵢ]/p` lies in a field finitely generated over `k`, hence
finite over `k` (Zariski's lemma), so it is integral over `k`; the domain `k[Xᵢ]/p`, generated by
integral elements, is integral over the field `k`, hence a field. -/
theorem isMaximal_of_forall_isMaximal_comap_rename [Finite ι] (p : Ideal (MvPolynomial n k))
    [p.IsPrime] (i₀ : ι)
    (h : ∀ i : n, (p.comap (rename (R := k) fun _ : ι ↦ i).toRingHom).IsMaximal) :
    p.IsMaximal := by
  have hint : ∀ i : n, IsIntegral k (Ideal.Quotient.mk p (X i)) := fun i ↦ by
    have := h i
    have := isIntegral_of_forall_mem_eq_zero (p.comap (rename (R := k) fun _ : ι ↦ i).toRingHom)
      ((Ideal.Quotient.mkₐ k p).comp
      (rename (R := k) fun _ : ι ↦ i)) (fun a ha ↦ Ideal.Quotient.eq_zero_iff_mem.2 ha) i₀
    simpa using this
  have : Algebra.IsIntegral k (MvPolynomial n k ⧸ p) := by
    refine ⟨fun x ↦ ?_⟩
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hle : Algebra.adjoin k (Set.range fun i ↦ Ideal.Quotient.mkₐ k p (X i)) ≤
        integralClosure k (MvPolynomial n k ⧸ p) :=
      Algebra.adjoin_le (Set.range_subset_iff.2 fun i ↦ hint i)
    refine hle ?_
    have hx : x ∈ Algebra.adjoin k (Set.range (X : n → MvPolynomial n k)) := by
      rw [adjoin_range_X]
      trivial
    have : Ideal.Quotient.mkₐ k p x ∈
        (Algebra.adjoin k (Set.range (X : n → MvPolynomial n k))).map (Ideal.Quotient.mkₐ k p) :=
      Subalgebra.mem_map.2 ⟨x, hx, rfl⟩
    rw [AlgHom.map_adjoin, ← Set.range_comp] at this
    exact this
  have hfield : IsField (MvPolynomial n k ⧸ p) :=
    (Algebra.IsIntegral.isField_iff_isField (algebraMap k _).injective).1 (Field.toIsField k)
  exact Ideal.Quotient.maximal_of_isField p hfield

end MvPolynomial

namespace AlgebraicGeometry.AffineSpace

variable {n m : Type u}

/-- **Closed points of affine space are detected by the coordinates.** A point of `𝔸ⁿ_k` whose
images under all coordinate projections `𝔸ⁿ_k ⟶ 𝔸¹_k` are closed points is a closed point. -/
theorem isClosed_singleton_of_forall_isClosed_singleton_reindex {k : Type u} [Field k]
    {ι : Type u} [Finite ι] (i₀ : ι) (y : 𝔸(n; Spec (.of k)))
    (h : ∀ i : n, IsClosed {reindex (fun _ : ι ↦ i) (Spec (.of k)) y}) : IsClosed {y} := by
  set e := SpecIso n (.of k)
  set p := e.hom y
  have hy : y = e.inv p := by simp [p]
  have hcl : ∀ i : n, IsClosed ({Spec.map (CommRingCat.ofHom
      (MvPolynomial.rename (R := k) fun _ : ι ↦ i).toRingHom) p} : Set (Spec _)) := fun i ↦ by
    have h' := h i
    rw [hy, ← Scheme.Hom.comp_apply, SpecIso_inv_reindex, Scheme.Hom.comp_apply] at h'
    have := (SpecIso ι (.of k)).hom.homeomorph.isClosedMap _ h'
    rw [Set.image_singleton, Scheme.Hom.homeomorph_apply, ← Scheme.Hom.comp_apply,
      Iso.inv_hom_id] at this
    exact this
  have hmax : p.asIdeal.IsMaximal := by
    have := PrimeSpectrum.isPrime (R := MvPolynomial n k) p
    refine MvPolynomial.isMaximal_of_forall_isMaximal_comap_rename _ i₀ fun i ↦ ?_
    have := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).1 (hcl i)
    exact this
  have : IsClosed ({p} : Set (Spec (.of (MvPolynomial n k)))) :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).2 hmax
  have := e.inv.homeomorph.isClosedMap _ this
  rw [Set.image_singleton, Scheme.Hom.homeomorph_apply, ← hy] at this
  exact this

end AlgebraicGeometry.AffineSpace
