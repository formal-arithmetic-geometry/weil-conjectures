module

public import Mathlib.RingTheory.Ideal.Cotangent
public import WeilConjectures.AlgebraicGeometry.Morphisms.RegularImmersion
public import WeilConjectures.RingTheory.QuasiRegular

/-!
# The conormal sheaf of a regular immersion is locally free

If `i : Z ⟶ X` is a regular immersion of pure codimension `c`
with ideal sheaf `𝓘`, the conormal sheaf `𝓘/𝓘²` is locally free of rank `c`. Over an affine
open `U` on which `𝓘` is generated by a regular sequence `a₁, …, a_c`, the module
`𝓘(U)/𝓘(U)²` over `Γ(U)/𝓘(U) = Γ(Z, i⁻¹U)` has the basis given by the classes of the `aₖ`
(`MvPolynomial.IsRevRegular.cotangentBasis`): they span since they generate the ideal, and they
are linearly independent by quasi-regularity in degree one
(`MvPolynomial.coeff_mem_of_eval_mem_pow_succ`).

## Main statements

- `MvPolynomial.IsRevRegular.cotangentBasis`: the basis of `I/I²` over `R/I`.
- `AlgebraicGeometry.IsRegularImmersion.exists_basis_cotangent`: the conormal sheaf of a regular
  immersion of pure codimension `c` is locally free of rank `c`.
-/

@[expose] public section

universe u

open CategoryTheory

namespace MvPolynomial

variable {R : Type*} [CommRing R] {c : ℕ} {a : Fin c → R}

/-- The classes in `I/I²` of the members of a sequence generating `I`. -/
noncomputable def cotangentFamily (a : Fin c → R) (k : Fin c) :
    (Ideal.span (Set.range a)).Cotangent :=
  (Ideal.span (Set.range a)).toCotangent ⟨a k, Ideal.subset_span ⟨k, rfl⟩⟩

/-- The classes of generators span `I/I²` over `R/I`. -/
lemma span_cotangentFamily (a : Fin c → R) :
    Submodule.span (R ⧸ Ideal.span (Set.range a)) (Set.range (cotangentFamily a)) = ⊤ := by
  set I := Ideal.span (Set.range a)
  refine eq_top_iff.2 fun y _ ↦ ?_
  refine Submodule.span_le_restrictScalars R _ _ ?_
  obtain ⟨⟨x, hx⟩, rfl⟩ := I.toCotangent_surjective y
  obtain ⟨r, hr⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 hx
  have : (⟨x, hx⟩ : I) = ∑ k, r k • (⟨a k, Ideal.subset_span ⟨k, rfl⟩⟩ : I) := by
    ext; simp [← hr]
  rw [this, map_sum]
  exact Submodule.sum_mem _ fun k _ ↦ by
    rw [map_smul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)

/-- For a sequence regular read from the end, the classes of its members in `I/I²` are linearly
independent over `R/I`: if `∑ rₖ aₖ ∈ I²` then every `rₖ ∈ I`, by quasi-regularity in degree
one. -/
lemma IsRevRegular.linearIndependent_cotangentFamily (ha : IsRevRegular a) :
    LinearIndependent (R ⧸ Ideal.span (Set.range a)) (cotangentFamily a) := by
  set I := Ideal.span (Set.range a)
  refine Fintype.linearIndependent_iff.2 fun g hg k ↦ ?_
  choose r hr using fun k ↦ Ideal.Quotient.mk_surjective (g k)
  have hsum : (∑ j, r j * a j) ∈ I ^ 2 := by
    rw [← Ideal.toCotangent_eq_zero I ⟨_, Submodule.sum_mem _ fun j _ ↦
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)⟩]
    have : (⟨∑ j, r j * a j, Submodule.sum_mem _ fun j _ ↦
        Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)⟩ : I) =
        ∑ j, r j • (⟨a j, Ideal.subset_span ⟨j, rfl⟩⟩ : I) := by
      ext; simp
    rw [this, map_sum]
    simp_rw [map_smul]
    rw [← hg]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [← hr j, ← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
    rfl
  let F : MvPolynomial (Fin c) R := ∑ j, C (r j) * X j
  have hF : F.IsHomogeneous 1 :=
    IsHomogeneous.sum _ _ _ fun j _ ↦ isHomogeneous_C_mul_X _ _
  have hev : eval a F ∈ I ^ (1 + 1) := by simpa [F] using hsum
  have hk := coeff_mem_of_eval_mem_pow_succ ha 1 hF hev (Finsupp.single k 1)
  have hc : F.coeff (Finsupp.single k 1) = r k := by
    simp only [F, coeff_sum, coeff_C_mul, coeff_X, Finsupp.single_eq_single_iff]
    simp [Finset.sum_ite_eq']
  rw [hc] at hk
  rw [← hr k]
  exact Ideal.Quotient.eq_zero_iff_mem.2 hk

/-- For a sequence `a₁, …, a_c` regular read from the end, generating `I`, the classes of the
`aₖ` form a basis of the conormal module `I/I²` over `R/I`. -/
noncomputable def IsRevRegular.cotangentBasis (ha : IsRevRegular a) :
    Module.Basis (Fin c) (R ⧸ Ideal.span (Set.range a)) (Ideal.span (Set.range a)).Cotangent :=
  Module.Basis.mk ha.linearIndependent_cotangentFamily (span_cotangentFamily a).ge

lemma IsRevRegular.cotangentBasis_apply (ha : IsRevRegular a) (k : Fin c) :
    ha.cotangentBasis k = cotangentFamily a k :=
  Module.Basis.mk_apply _ _ _

end MvPolynomial

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}}

/-- The conormal sheaf `𝓘/𝓘²` of a regular immersion `i : Z ⟶ X` of pure codimension `c` is locally
free of rank `c`: every point of `X` has an affine open neighbourhood `U` such that
`𝓘(U)/𝓘(U)²` is a free `Γ(U)/𝓘(U)`-module with a basis indexed by `Fin c`. -/
theorem IsRegularImmersion.exists_basis_cotangent (c : ℕ) (i : Z ⟶ X) [IsRegularImmersion c i]
    (x : X) : ∃ U : X.affineOpens, x ∈ U.1 ∧
      Nonempty (Module.Basis (Fin c) (Γ(X, U.1) ⧸ (Scheme.Hom.ker i).ideal U)
        ((Scheme.Hom.ker i).ideal U).Cotangent) := by
  obtain ⟨U, hxU, r, hlen, hr, hrI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators (c := c) (i := i) x
  obtain ⟨a, ha, hspan⟩ := MvPolynomial.exists_isRevRegular_of_isWeaklyRegular r hr c hlen
  refine ⟨U, hxU, ?_⟩
  rw [← hrI, ← hspan]
  exact ⟨ha.cotangentBasis⟩

end AlgebraicGeometry
