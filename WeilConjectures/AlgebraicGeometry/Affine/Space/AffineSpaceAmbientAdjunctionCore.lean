/-! A compactification-specific form of the affine-space ambient adjunction.

This is the geometric core: the compact-support functor attached to an explicitly chosen
compactification of affine space is left adjoint to the finite torsion Tate-twist pullback.
The final theorem transports this adjunction to the project-wide compactification-independent
`rightDerivedLowerShriek`.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry.Etale

/-- Compactification-specific affine-space ambient adjunction.

Proof source: the affine-line/projective-line induction in
`lemma-affine-space-etale-localization--1`, with the standard projective compactification supplied
by `Compactification.ofIsImmersionAffineSpace`. The induction composes the normalized
projective-line adjunction along the coordinate tower, identifies the resulting right functor
with the explicit finite Tate-twist pullback and even shift, and transports along the chosen
compactification comparison. This theorem is a strict sub-result of the compactification-
independent assertion below. -/
theorem affineSpaceAmbientAdjunction_of_compactification
    (N : ℕ) (hN : 0 < N)
    (A : Type (u + 1)) [CommRing A] [Finite A] (hA : (N : A) = 0)
    (S : Scheme.{u}) [IsNoetherian S] (hS : IsUnit (N : Γ(S, ⊤))) (d : ℕ)
    (c : Compactification (AffineSpace (ULift.{u} (Fin d)) S ↘ S)) :
    Nonempty
      (rightDerivedLowerShriekOfCompactification (ModuleCat.{u + 1} A) c ⊣
        ((upperStar (ModuleCat.{u + 1} A)
            (AffineSpace (ULift.{u} (Fin d)) S ↘ S)).mapDerivedCategory ⋙
          derivedTensorRight (ModuleCat.{u + 1} A) (AffineSpace (ULift.{u} (Fin d)) S)
            ((DerivedCategory.singleFunctor _ 0).obj
              (Scheme.finiteEtaleTateTwist (AffineSpace (ULift.{u} (Fin d)) S) N A hA d))) ⋙
          shiftFunctor _ (2 * (d : ℤ))) := by
  classical
  let B := ModuleCat.{u + 1} A
  let T := affineTraceTower S d
  let X := AffineSpace (ULift.{u} (Fin d)) S
  let g := affineTraceProjection S d
  let p : X ⟶ S := X ↘ S
  let e : X ≅ T := (affineTraceAffineSpaceIso S d).symm
  have he : e.inv ≫ p = g := AffineSpace.homOfVector_over _ _
  have he' : e.hom ≫ g = p := by rw [← he]; simp
  let := affineTraceNoetherian S d
  let : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
  let : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
  let : IsNoetherian X := ⟨⟩
  let : HasCompactification p := c.hasCompactification
  obtain ⟨t, D, _⟩ := exists_ordinaryFiniteP1Adjunction N hN A hA
  -- Compose the projective-line/open-chart adjunctions along the coordinate tower.
  let adj := affineTraceAdjunction A N hA t D S hS d
  obtain ⟨r⟩ := (affineTraceRight_normalForm A N hN hA S hS d).1
  let adjT := (adj.ofNatIsoLeft (affineTraceUnboundedCompactComparison A S d)).ofNatIsoRight r
  -- Move from the coordinate tower to the specified affine space over S.
  let cu := Compactification.ofIsProper e.hom
  let norm := canonicalEtaleCompactSupportNormalization A
  let adjU := (derivedEtaleLowerShriekUpperStarAdjunction B e.hom inferInstance).ofNatIsoLeft
    (norm.comparison e.hom cu).symm
  let adjX := adjU.comp adjT
  let l := Functor.isoWhiskerRight (rightDerivedLowerShriekIso A cu) _ ≪≫
    unboundedEtaleLowerShriekCompIso A e.hom g ≪≫
    unboundedEtaleLowerShriekCongr A he' ≪≫ (rightDerivedLowerShriekIso A c).symm
  -- Pull the Tate line through the scheme isomorphism and combine the pullbacks.
  let E := fun (Y : Scheme.{u}) (n : ℕ) ↦ Scheme.finiteEtaleTateSheaf A N Y hA (n : ℤ)
  let tp := Scheme.finiteEtaleTwistPullbackData A N hN hA
  let tc := fun {Y Z : Scheme.{u}} (f : Y ⟶ Z)
    (hZ : IsUnit (N : Γ(Z, ⊤))) (n : ℕ) ↦
      tp.c f hZ (affineTracePullbackInvertible N f hZ) n
  let k := tensorEPullback B N E tc e.hom (affineTraceInvertible N S hS d) d
    (2 * (d : ℤ))
  let rr := Functor.isoWhiskerLeft _
    (leftDerivedUpperStarIsoMapDerivedCategory B e.hom).symm ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (ordinaryFinitePullback A g) k ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight (leftDerivedUpperStarComp B e.hom g p he'.symm).symm _ ≪≫
    Functor.isoWhiskerRight (leftDerivedUpperStarIsoMapDerivedCategory B p) _
  exact ⟨(adjX.ofNatIsoLeft l).ofNatIsoRight rr⟩

end AlgebraicGeometry.Etale
