module

public import WeilConjectures.AlgebraicGeometry.Affine.Linear.AffineLinearTraceAction
import WeilConjectures.AlgebraicGeometry.Affine.Space.AffineSpaceIsoTraceCore

/-! # The affine-space trace under an arbitrary automorphism over its base -/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Etale

/-- An arbitrary automorphism of the coordinate affine space preserves its ordered trace.
Source: latest blueprint sec-smooth-purity/sk-prop-an,
cor-pur-vector-bundle-purity.proof.md, paragraph 2; fixed-base presentation invariance,
proof step 1 (blueprint: lem-pur-affine-space-iso-trace-invariance).

Proof: exact inverse image and compact-support base change identify the geometric stalk
of the displayed action with pullback on the top compact-support cohomology of affine
d-space over a separably closed field. After an algebraic closure this cohomology is the
rank-one A-module generated by the class of any rational point, with its canonical Tate
coefficient. In dimension one, the open-closed sequence for the projective line and the
Kummer degree-one normalization show that the ordered trace sends every such point class
to one. Iterating the coordinate compactifications gives the same normalization in
dimension d by products. Pullback by an isomorphism carries the class of a rational point
to the class of its unique inverse image, with multiplicity one; pullback of the Tate
coefficient is precisely affineLinearCoefficientPullback. Thus the two maps agree on the
generator. Both source and target are degree-zero objects, by the affine top trace.
Full faithfulness of the degree-zero embedding and conservative geometric stalks give
the derived equality. In dimension zero the action and trace are identity comparisons;
on the empty base and for A=0 the maps are unique. No linearity or preservation of zero
is required. This assertion only concerns a single affine coordinate tower, with no
bundle frames, cover gluing, or comparison of different bundle presentations.
-/
theorem affineSpaceIsoTraceInvariance (N : ℕ) (hN : 0 < N)
    (A : Type (u + 1)) [CommRing A] [Finite A] (hA : (N : A) = 0)
    (t : OrdinaryFiniteTwistTransport A N hA)
    (D : ∀ (T : Scheme.{u}) [IsNoetherian T] (hT : IsUnit (N : Γ(T, ⊤))),
      OrdinaryFiniteP1Datum A N hA t T hT)
    (S : Scheme.{u}) [IsNoetherian S] (hS : IsUnit (N : Γ(S, ⊤))) (d : ℕ)
    (e : affineTraceTower S d ≅ affineTraceTower S d)
    (sq : IsPullback e.hom (affineTraceProjection S d)
      (affineTraceProjection S d) (𝟙 S)) :
    affineLinearTraceAction N hN A hA t S hS d e.hom sq ≫
        affineTraceCounit A N hA t D S hS d =
      affineTraceCounit A N hA t D S hS d := by
  rw [affineSpaceIsoTraceAction_eq_id N hN A hA t S hS d e sq]
  simp only [Category.id_comp]

end AlgebraicGeometry.Etale
