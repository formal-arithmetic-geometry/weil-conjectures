/-! # Canonical strict-henselization completion steps

The two statements below are deliberately about the canonical reindexed
neighbourhood system.  They do not quantify over arbitrary diagrams or arbitrary
maps out of the specified separable closure.

## References

* [Stacks Project, Tag 04HX](https://stacks.math.columbia.edu/tag/04HX)
* [Stacks Project, Tag 03QL](https://stacks.math.columbia.edu/tag/03QL)
* [Stacks Project, Tag 0032](https://stacks.math.columbia.edu/tag/0032)
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry

namespace AlgebraicGeometry

noncomputable section

/-- The stalk map at the closed point of `Spec R ⟶ Spec 𝒪_{X,x} ⟶ X` is the given local
homomorphism, up to the canonical identification of stalks at equal points. -/
theorem Scheme.stalkClosedPointTo_Spec_map_fromSpecStalk {X : Scheme.{u}} {x : X}
    {R : CommRingCat.{u}} [IsLocalRing R] (f : X.presheaf.stalk x ⟶ R) [IsLocalHom f.hom]
    (h : Inseparable ((Spec.map f ≫ X.fromSpecStalk x) (IsLocalRing.closedPoint R)) x) :
    Scheme.stalkClosedPointTo (Spec.map f ≫ X.fromSpecStalk x) =
      (X.presheaf.stalkCongr h).hom ≫ f := by
  refine TopCat.Presheaf.stalk_hom_ext _ fun U hxU ↦ ?_
  rw [Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk, TopCat.Presheaf.stalkCongr_hom,
    TopCat.Presheaf.germ_stalkSpecializes_assoc]

/-- Morphisms out of the spectrum of a field are determined by their composite with the
spectrum of a field extension. -/
theorem Scheme.Spec_map_cancel_of_field {K L : Type u} [Field K] [Field L] (f : K →+* L)
    {X : Scheme.{u}} {g₁ g₂ : Spec (.of K) ⟶ X}
    (h : Spec.map (CommRingCat.ofHom f) ≫ g₁ = Spec.map (CommRingCat.ofHom f) ≫ g₂) :
    g₁ = g₂ := by
  obtain ⟨⟨x₁, d₁⟩, rfl⟩ := (Scheme.SpecToEquivOfField K X).symm.surjective g₁
  obtain ⟨⟨x₂, d₂⟩, rfl⟩ := (Scheme.SpecToEquivOfField K X).symm.surjective g₂
  have key : (Scheme.SpecToEquivOfField L X).symm ⟨x₁, d₁ ≫ CommRingCat.ofHom f⟩ =
      (Scheme.SpecToEquivOfField L X).symm ⟨x₂, d₂ ≫ CommRingCat.ofHom f⟩ := by
    simpa [Spec.map_comp_assoc] using h
  obtain ⟨hx, hd⟩ := Scheme.SpecToEquivOfField_eq_iff.1
    ((Scheme.SpecToEquivOfField L X).symm.injective key)
  dsimp only at hx hd
  subst hx
  rw [Scheme.residueFieldCongr_refl, Iso.refl_hom, Category.id_comp] at hd
  obtain rfl : d₁ = d₂ := by
    ext a
    apply f.injective
    simpa using congr($hd a)
  rfl

/-- At a geometric point over the generic point of an integral scheme, the point evaluation
of the strict henselization is injective: the maximal ideal of the strict henselization is
generated by the generic prime of an affine chart, which is zero. -/
theorem Scheme.strictHenselizationPointEvaluation_injective_of_generic
    {S : Scheme.{u}} [IsIntegral S] {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (s : Spec (.of Ω) ⟶ S) (hs : s (IsLocalRing.closedPoint Ω) = genericPoint S) :
    Function.Injective (Scheme.strictHenselizationPointEvaluation s) := by
  classical
  obtain ⟨R, i, hi, hx, -⟩ := Scheme.exists_affine_mem_range_and_range_subset
    (x := s (IsLocalRing.closedPoint Ω)) (U := ⊤) trivial
  have hrange : Set.range s ⊆ Set.range i := by
    rintro _ ⟨z, rfl⟩
    simpa only [Subsingleton.elim z (IsLocalRing.closedPoint Ω)] using hx
  obtain ⟨xR, rfl⟩ : ∃ xR : Spec (.of Ω) ⟶ Spec R, xR ≫ i = s :=
    ⟨IsOpenImmersion.lift i s hrange, IsOpenImmersion.lift_fac i s hrange⟩
  have : Nonempty (Spec R) := ⟨xR (IsLocalRing.closedPoint Ω)⟩
  have : IsIntegral (Spec R) := isIntegral_of_isOpenImmersion i
  have : IsDomain R := (affine_isIntegral_iff R).1 inferInstance
  have hgen : xR (IsLocalRing.closedPoint Ω) = genericPoint (Spec R) :=
    i.isOpenEmbedding.injective (hs.trans (genericPoint_eq_of_isOpenImmersion i).symm)
  obtain ⟨_, ρ, -, hmax⟩ := Scheme.strictHenselization_chart_maximalIdeal R i xR
  rw [hgen, genericPoint_eq_bot_of_affine] at hmax
  rw [injective_iff_map_eq_zero]
  intro a ha
  have hker : a ∈ IsLocalRing.maximalIdeal _ :=
    IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _) ha
  simpa [hmax] using hker

/-- At the geometric generic point given by an algebraic closure of the function field, the
relative separable closure of the residue field, embedded by the geometric point, is the
relative separable closure of the function field. -/
theorem Scheme.separableClosure_residueField_generic_eq
    (S : Scheme.{u}) [IsIntegral S] (Ω : Type u) [Field Ω] [Algebra S.functionField Ω] :
    let η : Spec (CommRingCat.of Ω) ⟶ S :=
      Spec.map (CommRingCat.ofHom (algebraMap S.functionField Ω)) ≫ S.fromSpecFunctionField
    letI : Algebra (S.residueField (η (IsLocalRing.closedPoint Ω))) Ω :=
      (Scheme.descResidueField (Scheme.stalkClosedPointTo η)).hom.toAlgebra
    η (IsLocalRing.closedPoint Ω) = genericPoint S ∧
      ((separableClosure (S.residueField (η (IsLocalRing.closedPoint Ω))) Ω : Set Ω) =
        separableClosure S.functionField Ω) := by
  intro η
  let : Algebra (S.residueField (η (IsLocalRing.closedPoint Ω))) Ω :=
    (Scheme.descResidueField (Scheme.stalkClosedPointTo η)).hom.toAlgebra
  have hpt : η (IsLocalRing.closedPoint Ω) = genericPoint S := by
    rw [Scheme.Hom.comp_apply, Spec_closedPoint]
    exact S.fromSpecStalk_closedPoint
  refine ⟨hpt, ?_⟩
  let c := S.presheaf.stalkCongr (Inseparable.of_eq hpt)
  let τ : S.functionField →+* S.residueField (η (IsLocalRing.closedPoint Ω)) :=
    (S.residue _).hom.comp c.inv.hom
  have hτ : Function.Bijective τ := by
    refine ⟨τ.injective, fun y ↦ ?_⟩
    obtain ⟨z, rfl⟩ := S.residue_surjective _ y
    refine ⟨c.hom z, ?_⟩
    simp [τ]
  have he : (algebraMap _ Ω).comp τ = algebraMap S.functionField Ω := by
    have hst := Scheme.stalkClosedPointTo_Spec_map_fromSpecStalk
      (CommRingCat.ofHom (algebraMap S.functionField Ω)) (Inseparable.of_eq hpt)
    ext a
    have h1 := congr($(Scheme.residue_descResidueField (Scheme.stalkClosedPointTo η)) (c.inv a))
    have h2 := congr($hst (c.inv a))
    have h3 : c.hom (c.inv a) = a := ConcreteCategory.congr_hom c.inv_hom_id a
    exact h1.trans (h2.trans (congrArg (algebraMap S.functionField Ω) h3))
  let σ := RingEquiv.ofBijective τ hτ
  ext y
  refine ⟨fun hy ↦ ?_, fun hy ↦ ?_⟩
  · have hy' : IsSeparable _ y := mem_separableClosure_iff.mp hy
    refine mem_separableClosure_iff.mpr (hy'.of_equiv_equiv σ.symm (RingEquiv.refl Ω) ?_)
    rw [← he]
    ext a
    exact congrArg (algebraMap _ Ω) (σ.apply_symm_apply a)
  · have hy' : IsSeparable S.functionField y := mem_separableClosure_iff.mp hy
    exact mem_separableClosure_iff.mpr (hy'.of_equiv_equiv σ (RingEquiv.refl Ω) he)

/-- Transport the canonical strict-henselization limit to the specified relative
separable closure: the spectrum of the separable closure of the function field is the limit of
the reindexed affine étale neighbourhoods of the geometric generic point. -/
theorem separableGeneric_affineEtale_limit
    (S : Scheme.{u}) [IsIntegral S]
    (Ω : Type u) [Field Ω] [Algebra S.functionField Ω]
    [IsAlgClosure S.functionField Ω] :
    let F := S.functionField
    let Fs := separableClosure F Ω
    let X := Spec (CommRingCat.of Fs)
    letI : IsAlgClosed Ω := IsAlgClosure.isAlgClosed F
    let η : Spec (CommRingCat.of Ω) ⟶ S :=
      Spec.map (CommRingCat.ofHom (algebraMap F Ω)) ≫ S.fromSpecFunctionField
    let J := SmallModel.{u} (Scheme.strictHenselizationNeighbourhoods η)
    letI : SmallCategory J := inferInstance
    let D₀ := (Scheme.strictHenselizationAffineDiagram η).op ⋙ Scheme.Spec
    ∀ (A : Type u) (_ : Preorder A) (_ : IsDirected A (· ≤ ·)) (_ : Nonempty A)
      (R : A ⥤ Jᵒᵖ) (_ : Functor.Initial R.op)
      (π₀ : ∀ i : Aᵒᵖ,
        Spec (Scheme.strictHenselizationRing η) ⟶ (R.op ⋙ D₀).obj i)
      (hπcan : ∀ j : Aᵒᵖ,
        π₀ j = (Scheme.strictHenselizationCone η).π.app (R.op.obj j)),
      ∃ e : Scheme.strictHenselizationRing η ≃+* Fs,
        (∀ a : Scheme.strictHenselizationRing η,
          Fs.subtype (e a) = Scheme.strictHenselizationRingPointEvaluation η a) ∧
        Nonempty (IsLimit
          ({ pt := X
             π := { app := fun i ↦
                      Spec.map (CommRingCat.ofHom e.toRingHom) ≫ π₀ i
                    naturality := by
                      intro i j f
                      change Spec.map (CommRingCat.ofHom e.toRingHom) ≫ π₀ j =
                        Spec.map (CommRingCat.ofHom e.toRingHom) ≫ π₀ i ≫
                          ((Scheme.strictHenselizationAffineDiagram η).op ⋙
                              Scheme.Spec).map (R.op.map f)
                      rw [hπcan j, hπcan i]
                      change Spec.map (CommRingCat.ofHom e.toRingHom) ≫
                          (Scheme.strictHenselizationCone η).π.app (R.op.obj j) =
                        Spec.map (CommRingCat.ofHom e.toRingHom) ≫
                          (Scheme.strictHenselizationCone η).π.app (R.op.obj i) ≫
                            ((Scheme.strictHenselizationAffineDiagram η).op ⋙
                                Scheme.Spec).map (R.op.map f)
                      simpa only [Category.assoc] using
                        (congrArg (fun q ↦
                          Spec.map (CommRingCat.ofHom e.toRingHom) ≫ q)
                          ((Scheme.strictHenselizationCone η).w (R.op.map f)).symm) } } :
            Cone (R.op ⋙ D₀))) := by
  intro F Fs X η J D₀ A _ _ _ R hR π₀ hπcan
  have : IsAlgClosed Ω := IsAlgClosure.isAlgClosed F
  obtain ⟨hpt, hset⟩ := Scheme.separableClosure_residueField_generic_eq S Ω
  let : Algebra (S.residueField (η (IsLocalRing.closedPoint Ω))) Ω :=
    (Scheme.descResidueField (Scheme.stalkClosedPointTo η)).hom.toAlgebra
  let c := Scheme.smallStrictHenselizationColimitIso η
  let ev := Scheme.strictHenselizationRingPointEvaluation η
  have hmem (a : Scheme.strictHenselizationRing η) : ev a ∈ Fs := by
    have h := Scheme.strictHenselizationPointEvaluation_mem η rfl (c.hom a)
    rw [← SetLike.mem_coe, hset] at h
    exact h
  have hinj : Function.Injective ev :=
    (Scheme.strictHenselizationPointEvaluation_injective_of_generic η hpt).comp
      (Function.LeftInverse.injective (g := c.inv.hom)
        fun a ↦ ConcreteCategory.congr_hom c.hom_inv_id a)
  have hsurj (y : Fs) : ∃ a, ev a = y := by
    have hy : (y : Ω) ∈ separableClosure (S.residueField (η (IsLocalRing.closedPoint Ω))) Ω := by
      rw [← SetLike.mem_coe, hset]
      exact y.2
    obtain ⟨b, hb⟩ := Scheme.strictHenselizationPointEvaluationToSep_surjective η rfl ⟨y, hy⟩
    refine ⟨c.inv.hom b, ?_⟩
    have hcb : c.hom.hom (c.inv.hom b) = b := ConcreteCategory.congr_hom c.inv_hom_id b
    have hb' := congrArg Subtype.val hb
    exact (congrArg (Scheme.strictHenselizationPointEvaluation η) hcb).trans hb'
  let e : Scheme.strictHenselizationRing η ≃+* Fs :=
    RingEquiv.ofBijective (ev.codRestrict Fs hmem)
      ⟨fun a b h ↦ hinj (congrArg Subtype.val h), fun y ↦ by
        obtain ⟨a, ha⟩ := hsurj y
        exact ⟨a, Subtype.ext ha⟩⟩
  obtain ⟨-, -, ⟨hlim⟩⟩ := Scheme.strictHenselization_properties η
  refine ⟨e, fun _ ↦ rfl, ⟨((Functor.Initial.isLimitWhiskerEquiv R.op _).symm hlim).ofIsoLimit
    (Cone.ext (Scheme.Spec.mapIso e.toCommRingCatIso.op).symm fun j ↦ ?_)⟩⟩
  rw [Iso.symm_hom, Iso.eq_inv_comp]
  exact congrArg (Spec.map (CommRingCat.ofHom e.toRingHom) ≫ ·) (hπcan j).symm

/-- Pointedness of the canonical reindexed strict-henselization cone: its legs are compatible
with the structure maps to `S` of the affine étale neighbourhoods. -/
theorem separableGeneric_affineEtale_pointed
    (S : Scheme.{u}) [IsIntegral S]
    (Ω : Type u) [Field Ω] [Algebra S.functionField Ω]
    [IsAlgClosure S.functionField Ω] :
    let F := S.functionField
    let Fs := separableClosure F Ω
    let _X := Spec (CommRingCat.of Fs)
    letI : IsAlgClosed Ω := IsAlgClosure.isAlgClosed F
    let η : Spec (CommRingCat.of Ω) ⟶ S :=
      Spec.map (CommRingCat.ofHom (algebraMap F Ω)) ≫ S.fromSpecFunctionField
    let J := SmallModel.{u} (Scheme.strictHenselizationNeighbourhoods η)
    letI : SmallCategory J := inferInstance
    let D₀ := (Scheme.strictHenselizationAffineDiagram η).op ⋙ Scheme.Spec
    ∀ (A : Type u) (_ : Preorder A) (_ : IsDirected A (· ≤ ·)) (_ : Nonempty A)
      (R : A ⥤ Jᵒᵖ)
      (π₀ : ∀ i : Aᵒᵖ,
        Spec (Scheme.strictHenselizationRing η) ⟶ (R.op ⋙ D₀).obj i)
      (u : ∀ i : A, (R.op ⋙ D₀).obj (op i) ⟶ S)
      (e : Scheme.strictHenselizationRing η ≃+* Fs)
      (_hEval : ∀ a : Scheme.strictHenselizationRing η,
        Fs.subtype (e a) = Scheme.strictHenselizationRingPointEvaluation η a)
      (_hπcan : ∀ j : Aᵒᵖ,
        π₀ j = (Scheme.strictHenselizationCone η).π.app (R.op.obj j))
      (_hucan : ∀ i : A,
        u i =
          Spec.map (Scheme.ΓSpecIso
            (Opposite.unop ((equivSmallModel
              (Scheme.strictHenselizationNeighbourhoods η)).inverse.obj
                (Opposite.unop (R.obj i))).1.left)).inv ≫
            ((Scheme.AffineEtale.Spec S).obj
              ((equivSmallModel
                (Scheme.strictHenselizationNeighbourhoods η)).inverse.obj
                (Opposite.unop (R.obj i))).1).hom),
      ∀ i : A,
        Spec.map (CommRingCat.ofHom e.toRingHom) ≫ π₀ (op i) ≫ u i =
          Spec.map (CommRingCat.ofHom (algebraMap F Fs)) ≫ S.fromSpecFunctionField := by
  intro F Fs _ η J D₀ A _ _ _ R π₀ u e hEval hπcan hucan i
  have : IsAlgClosed Ω := IsAlgClosure.isAlgClosed F
  apply Scheme.Spec_map_cancel_of_field (algebraMap Fs Ω)
  have hev : CommRingCat.ofHom e.toRingHom ≫ CommRingCat.ofHom (algebraMap Fs Ω) =
      CommRingCat.ofHom (Scheme.strictHenselizationRingPointEvaluation η) := by
    ext a
    exact hEval a
  have hF : CommRingCat.ofHom (algebraMap F Fs) ≫ CommRingCat.ofHom (algebraMap Fs Ω) =
      CommRingCat.ofHom (algebraMap F Ω) := by
    ext a
    rfl
  have hp : Spec.map (CommRingCat.ofHom (Scheme.strictHenselizationRingPointEvaluation η)) ≫
      (Scheme.strictHenselizationCone η).π.app (R.op.obj (op i)) ≫
      (Spec (Opposite.unop ((equivSmallModel
        (Scheme.strictHenselizationNeighbourhoods η)).inverse.obj
          (Opposite.unop (R.obj i))).1.left)).isoSpec.inv =
      ((equivSmallModel (Scheme.strictHenselizationNeighbourhoods η)).inverse.obj
        (Opposite.unop (R.obj i))).2.left :=
    Scheme.strictHenselizationRingPointEvaluation_pointed η (Opposite.unop (R.obj i))
  rw [← Spec.map_comp_assoc, hev, ← Spec.map_comp_assoc, hF, hπcan, hucan,
    ← Scheme.isoSpec_Spec_inv, reassoc_of% hp]
  exact Over.w ((equivSmallModel (Scheme.strictHenselizationNeighbourhoods η)).inverse.obj
    (Opposite.unop (R.obj i))).2

end
end AlgebraicGeometry
