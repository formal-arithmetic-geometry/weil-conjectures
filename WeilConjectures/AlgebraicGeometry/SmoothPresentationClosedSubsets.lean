module

public import WeilConjectures.AlgebraicGeometry.AlgebraicModuliStack
public import WeilConjectures.AlgebraicGeometry.DmStackMorphismProperties
public import WeilConjectures.AlgebraicGeometry.ClosedModuliSubstack
import WeilConjectures.AlgebraicGeometry.InvariantClosedSubstackDescent
import WeilConjectures.AlgebraicGeometry.SpaceSmoothReducedLocality

/-! # Point topology and closed subsets of a smooth stack presentation

Source: Stacks Project, stacks-properties.tex, Tags 04XH, 04XJ, 04XL and 0509
(blueprint: lem-sfb-smooth-presentation-closed-subsets).

The point quotient and point maps are the existing field-object constructions. Smooth
charts, rather than only étale atlases, detect the topology for general algebraic stacks.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u v w v₁ w₁ v₂ w₂ v₃ w₃

open AlgebraicGeometry

namespace CategoryTheory

/-- The topology generated by subsets open on every smooth surjective scheme atlas.
This is a construction on the actual quotient of field objects; the theorem below
identifies it with the quotient topology from any individual atlas.
Source: Stacks Project, Tag 04XL (blueprint: lem-sfb-smooth-presentation-closed-subsets). -/
@[instance_reducible]
def moduliSmoothPointTopology {S : Scheme.{u}} (F : BasedCategory.{v, w} (Over S)) :
    TopologicalSpace (ModuliPoints F) :=
  TopologicalSpace.generateFrom
    {W | ∀ (U : Over S) (a : BasedFunctor (discreteModuli (yoneda.obj U)) F),
      IsSmoothModuliAtlas F U a → IsOpen (moduliChartPreimage a W)}

/-- A scheme point represented by its canonical residue-field morphism.
Source: Stacks Project, Tag 04XG and Schemes, residue fields
(blueprint: lem-sfb-smooth-presentation-closed-subsets). -/
def moduliSchemePoint {S : Scheme.{u}} (U : Over S) (z : U.left) :
    ModuliPoints (discreteModuli (yoneda.obj U)) :=
  Quot.mk _ ⟨CostructuredArrow.mk
    (yoneda.map (Over.homMk (V := U)
      (U.left.fromSpecResidueField z) (U := Over.mk
        (U.left.fromSpecResidueField z ≫ U.hom)) rfl)),
    ⟨U.left.residueField z, inferInstance, ⟨Iso.refl _⟩⟩⟩

/-- The underlying point map of an actual scheme chart, using residue-field representatives.
Source: Stacks Project, Tags 04XG and 04XL
(blueprint: lem-sfb-smooth-presentation-closed-subsets). -/
def moduliAtlasPointMap {S : Scheme.{u}} {F : BasedCategory.{v, w} (Over S)}
    {U : Over S} (q : BasedFunctor (discreteModuli (yoneda.obj U)) F) :
    U.left → ModuliPoints F :=
  fun z ↦ moduliPointMap q (moduliSchemePoint U z)

/-- Topology, the relation of a presentation, closed supports, and pointwise base change.
Source: Stacks Project, Tags 04XH, 04XJ, 04XL and 0509
(blueprint: lem-sfb-smooth-presentation-closed-subsets).

Proof:
1. For equal image classes in a stack, choose field representatives and a common extension
where their images are isomorphic. Their triple is an object of the actual 2-fibre product
(lem-sfb-algebraic-stack-fibre-products). Projection gives both the lifting assertion and
commutation of images with base change; there is no injectivity assertion.
2. Use lem-sfb-stack-point-topology-flat-lfp-open for independence and continuity. Smoothness
implies flatness and local finite presentation by lem-sfb-stack-chartwise-smooth-etale-calculus,
so the atlas point map is open. Its field-extension lifting gives surjectivity.
3. Step 1 applied to the self-relation identifies its image with equality of atlas images.
Thus invariance of a subset is precisely saturation under atlas fibres.
4. A closed subset pulls back to a closed invariant subset. Conversely send a closed invariant
D to its atlas image. Saturation identifies its inverse image with D; the quotient criterion
makes the image closed. Surjectivity makes these operations inverse, including empty and full.
5. For closed C put D = q⁻¹C and give D its unique reduced closed scheme structure, using
lem-sfb-space-reduced-closed-support. Its two relation pullbacks are smooth over that reduced
scheme, hence reduced by lem-sfb-space-smooth-reduced-locality. Their supports agree by
invariance, so reduced-support uniqueness makes them equal scheme-theoretically.
6. Apply lem-sfb-invariant-closed-substack-descent. The descended closed substack has the
reduced scheme as smooth surjective atlas and has image C. Any other smooth chart becomes
reduced after smooth surjective pullback to that atlas, so smooth reducedness descent makes
the chart reduced. This also verifies the intrinsic reducedness condition.
7. For another reduced closed substack with support C, pull back to the original atlas.
Step 1 identifies its support with D; smooth reducedness makes that pullback reduced.
Reduced-support uniqueness identifies the two closed schemes, and injectivity of invariant
closed-substack descent identifies their strictly full substacks. -/
theorem smooth_presentation_closed_subsets (k : Type u) [Field k]
    (F : BasedCategory.{v, w} (Over (Spec (.of k))))
    (hF : IsAlgebraicModuliStack F) :
    (∀ (U : Over (Spec (.of k)))
      (q : BasedFunctor (discreteModuli (yoneda.obj U)) F),
      IsSmoothModuliAtlas F U q →
      moduliSmoothPointTopology F =
        TopologicalSpace.coinduced (moduliAtlasPointMap q) inferInstance ∧
      @IsOpenMap _ _ inferInstance (moduliSmoothPointTopology F) (moduliAtlasPointMap q) ∧
      Function.Surjective (moduliAtlasPointMap q) ∧
      (∀ x y : U.left, moduliAtlasPointMap q x = moduliAtlasPointMap q y ↔
        ∃ r : ModuliPoints (moduliTwoFiberProduct q q),
          moduliPointMap (moduliTwoFiberFst q q) r = moduliSchemePoint U x ∧
          moduliPointMap (moduliTwoFiberSnd q q) r = moduliSchemePoint U y) ∧
      (∃ e : {C : Set (ModuliPoints F) // @IsClosed _ (moduliSmoothPointTopology F) C} ≃
          {D : Set U.left // IsClosed D ∧
            moduliPointMap (moduliTwoFiberFst q q) ⁻¹' (moduliSchemePoint U '' D) =
              moduliPointMap (moduliTwoFiberSnd q q) ⁻¹' (moduliSchemePoint U '' D)},
        ∀ C, (e C).val = moduliAtlasPointMap q ⁻¹' C.val)) ∧
    (∀ (G : BasedCategory.{v₁, w₁} (Over (Spec (.of k)))),
      IsAlgebraicModuliStack G → ∀ f : BasedFunctor F G,
        @Continuous _ _ (moduliSmoothPointTopology F) (moduliSmoothPointTopology G)
          (moduliPointMap f)) ∧
    (∀ C : Set (ModuliPoints F), @IsClosed _ (moduliSmoothPointTopology F) C →
      ∃! W : ClosedModuliSubstack F,
        Set.range (moduliPointMap W.inclusion) = C ∧
        ∀ (T : Over (Spec (.of k)))
          (a : BasedFunctor (discreteModuli (yoneda.obj T)) W.category),
          IsSmoothModuliAtlas W.category T a → AlgebraicGeometry.IsReduced T.left) ∧
    (∀ (A : BasedCategory.{v₁, w₁} (Over (Spec (.of k))))
      (B : BasedCategory.{v₂, w₂} (Over (Spec (.of k))))
      (C : BasedCategory.{v₃, w₃} (Over (Spec (.of k)))),
      IsAlgebraicModuliStack A → IsAlgebraicModuliStack B → IsAlgebraicModuliStack C →
      ∀ (a : BasedFunctor A B) (c : BasedFunctor C B),
        (∀ (x : ModuliPoints A) (y : ModuliPoints C),
          moduliPointMap a x = moduliPointMap c y →
          ∃ z : ModuliPoints (moduliTwoFiberProduct a c),
            moduliPointMap (moduliTwoFiberFst a c) z = x ∧
            moduliPointMap (moduliTwoFiberSnd a c) z = y) ∧
        Set.range (moduliPointMap (moduliTwoFiberSnd a c)) =
          moduliPointMap c ⁻¹' Set.range (moduliPointMap a)) := by
  sorry

end CategoryTheory
