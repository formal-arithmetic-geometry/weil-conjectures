module

public import Mathlib.RingTheory.AdjoinRoot
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.EffectiveCartier

/-! # The prime at the generic point of a root divisor

Source: Stacks Project, Tag 0EYG, the root-divisor calculation. -/

@[expose] public section
universe u
open CategoryTheory
namespace AlgebraicGeometry.Scheme

private theorem root_span_isPrime (H : CommRingCat.{u}) (g : H) (n : ℕ) (hn : 0 < n)
    [IsDomain (H ⧸ Ideal.span {g})] :
    (Ideal.span {AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n -
      Polynomial.C g)}).IsPrime := by
  let F := (Polynomial.X : Polynomial H) ^ n - Polynomial.C g
  let A := AdjoinRoot F
  let I : Ideal H := Ideal.span {g}
  have hF : F.eval₂ (Ideal.Quotient.mk I) 0 = 0 := by
    simp [F, hn.ne', I]
  let e : A →+* H ⧸ I := AdjoinRoot.lift (Ideal.Quotient.mk I) 0 hF
  have hker : RingHom.ker e = Ideal.span {AdjoinRoot.root F} := by
    apply le_antisymm
    · intro a ha
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
      have hp : p.coeff 0 ∈ I := by
        change AdjoinRoot.lift (Ideal.Quotient.mk I) 0 hF (AdjoinRoot.mk F p) = 0 at ha
        rw [AdjoinRoot.lift_mk hF, Polynomial.eval₂_at_zero] at ha
        exact Ideal.Quotient.eq_zero_iff_mem.mp ha
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hp
      obtain ⟨q, hq⟩ := (Polynomial.X_dvd_sub_C (p := p))
      have heq : AdjoinRoot.mk F p =
          AdjoinRoot.root F * AdjoinRoot.mk F q + AdjoinRoot.of F (p.coeff 0) := by
        have hm := congrArg (AdjoinRoot.mk F) hq
        simpa [map_sub, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C] using
          (sub_eq_iff_eq_add.mp hm)
      rw [heq]
      apply Ideal.add_mem
      · exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))
      · have ht : AdjoinRoot.root F ^ n = AdjoinRoot.of F g := by
          simpa [F, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
            Polynomial.eval₂_C, sub_eq_zero] using AdjoinRoot.eval₂_root F
        rw [hc, map_mul, ← ht]
        exact Ideal.mul_mem_right _ _
          (Ideal.pow_mem_of_mem _ (Ideal.subset_span (Set.mem_singleton _)) n hn)
    · apply Ideal.span_le.mpr
      rintro a rfl
      exact AdjoinRoot.lift_root hF
  rw [← hker]
  exact RingHom.ker_isPrime e

/-- The generic point of the root divisor corresponds to the prime generated by the root.

Source: Stacks Project, Tag 0EYG, the calculation at the generic point of the divisor. -/
theorem root_divisor_generic_prime
    (H : CommRingCat.{u}) (g : H) (n : ℕ) (hn : 0 < n)
    [IsDomain (H ⧸ Ideal.span {g})] :
    let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
    ∀ (D : Scheme.{u}) (j : D ⟶ N), IsEffectiveCartierCenter j →
      (∀ z : N, z ∈ V ↔ z ∉ Set.range j) →
      ∀ (η : D), IsGenericPoint η Set.univ →
        (j η).asIdeal = Ideal.span
          {AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)} := by
  dsimp only
  intro D j hj hV η hη
  let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
  let t : A := AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
  have ht : t ^ n = algebraMap H A g := by
    have heval := AdjoinRoot.eval₂_root
      ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
    simpa only [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero, ← AdjoinRoot.algebraMap_eq] using heval
  have hprime : (Ideal.span {t}).IsPrime := root_span_isPrime H g n hn
  let z : PrimeSpectrum A := ⟨Ideal.span {t}, hprime⟩
  have hrange : Set.range j = PrimeSpectrum.zeroLocus (Ideal.span {t} : Set A) := by
    ext y
    rw [PrimeSpectrum.mem_zeroLocus]
    change y ∈ Set.range j ↔ Ideal.span {t} ≤ y.asIdeal
    rw [Ideal.span_le, Set.singleton_subset_iff]
    have hy := hV y
    change (algebraMap H A g ∉ y.asIdeal ↔ y ∉ Set.range j) at hy
    rw [← ht, y.isPrime.pow_mem_iff_mem n hn] at hy
    exact not_iff_not.mp hy.symm
  have hz : IsGenericPoint z (Set.range j) := by
    rw [hrange, isGenericPoint_def, PrimeSpectrum.closure_singleton]
  have hgeneric : IsGenericPoint (j η) (Set.range j) := by
    let := hj.isClosedImmersion
    simpa only [Set.image_univ, j.isClosedEmbedding.isClosed_range.closure_eq] using
      hη.image j.continuous
  exact congrArg PrimeSpectrum.asIdeal (hgeneric.eq hz)

end AlgebraicGeometry.Scheme
