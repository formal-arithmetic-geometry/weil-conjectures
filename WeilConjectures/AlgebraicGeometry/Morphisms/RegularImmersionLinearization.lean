/-!
# Étale linearization of a regular immersion

Let `i : Z ⟶ X` be a regular closed immersion of pure codimension `c` with `X` smooth over a
perfect field `k` and `Z` regular. Then `Z` is smooth over `k`, and the pair `(X, Z)` is étale
locally the linear pair `(𝔸^{c+m}_k, 𝔸^m_k)`: around every point of `Z` there are an open
neighbourhood `U = Spec A` of `X` and an étale map `u : U ⟶ 𝔸^{c+m}_k` over `k` such that
`V = Z ∩ U` is the inverse image of the linear subspace `𝔸^m_k = {x₁ = ⋯ = x_c = 0}`, its ideal
is generated by `u^* x₁, …, u^* x_c`, and `u|_V : V ⟶ 𝔸^m_k` is étale.

The commutative algebra is `Algebra.exists_etale_mvPolynomial_of_isWeaklyRegular`; this file
transports it to schemes.

## Main results

- `AlgebraicGeometry.IsAffineOpen.isPullback_SpecMap_app_fromSpec`: an affine open `U` of `X`
  and its preimage under an affine morphism `i : Z ⟶ X` form a pullback square of spectra.
- `AlgebraicGeometry.IsRegularImmersion.etale_linearization`: Blueprint
  `lem-pur-regular-immersion-linearization`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}}

/-- For an affine open `U` of `X` whose preimage under `i : Z ⟶ X` is affine, the square
formed by `Spec Γ(Z, i⁻¹U) ⟶ Spec Γ(X, U)`, the two inclusions `Spec Γ(-) ⟶ -` and `i` is a
pullback square. -/
theorem IsAffineOpen.isPullback_SpecMap_app_fromSpec (i : Z ⟶ X) {U : X.Opens}
    (hU : IsAffineOpen U) (hV : IsAffineOpen (i ⁻¹ᵁ U)) :
    IsPullback (Spec.map (i.app U)) hV.fromSpec hU.fromSpec i := by
  have sq : CommSq (Spec.map (i.app U)) hV.isoSpec.inv hU.isoSpec.inv (i ∣_ U) := ⟨by
    rw [← cancel_mono U.ι, Category.assoc, Category.assoc, morphismRestrict_ι]
    have h := IsAffineOpen.SpecMap_appLE_fromSpec i hU hV le_rfl
    rw [← Scheme.Hom.app_eq_appLE] at h
    exact h⟩
  exact (IsPullback.of_vert_isIso sq).paste_vert (isPullback_morphismRestrict i U)

namespace IsRegularImmersion

/-- Blueprint `lem-pur-regular-immersion-linearization`: Etale linearization of a regular
immersion

Let `i : Z ⟶ X` be a regular closed immersion of pure codimension `c`, with `X` smooth over the
perfect field `k` (structure morphism `aX`) and `Z` regular. Then:

1. `Z` is smooth over `k`;
2. the pair `(X, Z)` is étale locally the linear pair: for every `z ∈ Z` there are an open
  (in particular étale) neighbourhood `jU : U = Spec A ⟶ X` of `z`, an open neighbourhood
  `jV : V = Spec B ⟶ Z` of `z` with `V = Z ∩ U` (the square `V ⟶ U`, `V ⟶ Z`, `U ⟶ X`,
  `Z ⟶ X` is cartesian, `V ⟶ U` being `Spec ψ` for a surjection `ψ : A ⟶ B`), and an étale
  morphism of `k`-schemes `u = Spec φ : U ⟶ 𝔸^{c+m}_k` such that `V = u⁻¹(𝔸^m_k)` for the
  linear subspace `𝔸^m_k = {x₁ = ⋯ = x_c = 0}` (a cartesian square), the restriction
  `u|_V = Spec φ' : V ⟶ 𝔸^m_k` is étale, and the ideal of `V` in `U` is generated by
  `u^* x₁, …, u^* x_c`.

The neighbourhoods produced are Zariski open, which is stronger than étale. -/
theorem etale_linearization {k : Type u} [Field k] [PerfectField k] (c : ℕ) (i : Z ⟶ X)
    [IsRegularImmersion c i] (aX : X ⟶ Spec (.of k)) [Smooth aX] [LocallyOfFiniteType (i ≫ aX)]
    (hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) :
    Smooth (i ≫ aX) ∧ ∀ z : Z, ∃ (m : ℕ) (A B : CommRingCat.{u}) (jU : Spec A ⟶ X)
      (jV : Spec B ⟶ Z) (ψ : A ⟶ B) (φ : CommRingCat.of (MvPolynomial (Fin c ⊕ Fin m) k) ⟶ A)
      (φ' : CommRingCat.of (MvPolynomial (Fin m) k) ⟶ B),
      IsOpenImmersion jU ∧ IsOpenImmersion jV ∧ z ∈ Set.range jV ∧
      IsPullback (Spec.map ψ) jV jU i ∧ Function.Surjective ψ ∧
      RingHom.ker ψ.hom = Ideal.span (Set.range fun a ↦ φ (MvPolynomial.X (Sum.inl a))) ∧
      Etale (Spec.map φ) ∧ Spec.map φ ≫ Spec.map (CommRingCat.ofHom MvPolynomial.C) = jU ≫ aX ∧
      Etale (Spec.map φ') ∧
      IsPullback (Spec.map ψ) (Spec.map φ') (Spec.map φ) (Spec.map (CommRingCat.ofHom
        (MvPolynomial.aeval (R := k)
          (Sum.elim (fun _ ↦ (0 : MvPolynomial (Fin m) k)) MvPolynomial.X)).toRingHom)) := by
  have hsm : Smooth (i ≫ aX) := smooth_comp c i aX hZ
  refine ⟨hsm, fun z ↦ ?_⟩
  obtain ⟨U, hzU, r, rfl, hreg, hI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators (c := c) (i := i) (i z)
  have hV : IsAffineOpen (i ⁻¹ᵁ U.1) := U.2.preimage i
  have hsurj : Function.Surjective (i.app U.1) := i.app_surjective U.1 U.2
  have hker : RingHom.ker (i.app U.1).hom = Ideal.span (Set.range r.get) := by
    rw [← Scheme.Hom.ker_apply, ← hI, Ideal.ofList, Set.range_list_get]
  -- the `k`-algebra structures
  have heU : U.1 ≤ aX ⁻¹ᵁ ⊤ := fun _ _ ↦ trivial
  have heV : i ⁻¹ᵁ U.1 ≤ (i ≫ aX) ⁻¹ᵁ ⊤ := fun _ _ ↦ trivial
  let α : CommRingCat.of k ⟶ Γ(X, U.1) := (Scheme.ΓSpecIso (.of k)).inv ≫ aX.appLE ⊤ U.1 heU
  let : Algebra k Γ(X, U.1) := α.hom.toAlgebra
  let : Algebra Γ(X, U.1) Γ(Z, i ⁻¹ᵁ U.1) := (i.app U.1).hom.toAlgebra
  let : Algebra k Γ(Z, i ⁻¹ᵁ U.1) := ((i.app U.1).hom.comp α.hom).toAlgebra
  have : IsScalarTower k Γ(X, U.1) Γ(Z, i ⁻¹ᵁ U.1) := .of_algebraMap_eq' rfl
  have hιk := ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of k)).inv
  have : Algebra.Smooth k Γ(X, U.1) := (RingHom.Smooth.of_bijective hιk).comp
    (HasRingHomProperty.appLE (P := @Smooth) aX ‹_› ⟨⊤, isAffineOpen_top _⟩ U heU)
  have : Algebra.Smooth k Γ(Z, i ⁻¹ᵁ U.1) := by
    have h₁ := HasRingHomProperty.appLE (P := @Smooth) (i ≫ aX) hsm ⟨⊤, isAffineOpen_top _⟩
      ⟨_, hV⟩ heV
    have h₂ : (i ≫ aX).appLE ⊤ (i ⁻¹ᵁ U.1) heV = aX.appLE ⊤ U.1 heU ≫ i.app U.1 := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    rw [h₂] at h₁
    exact (RingHom.Smooth.of_bijective hιk).comp h₁
  have := LocallyOfFiniteType.isLocallyNoetherian aX
  have : IsNoetherianRing Γ(X, U.1) := IsLocallyNoetherian.component_noetherian U
  -- the prime of `A` at `i z`
  obtain ⟨q, hq⟩ : i z ∈ Set.range U.2.fromSpec := by rw [U.2.range_fromSpec]; exact hzU
  have hp : RingHom.ker (algebraMap Γ(X, U.1) Γ(Z, i ⁻¹ᵁ U.1)) ≤ q.asIdeal := by
    intro s hs
    by_contra hsq
    have h₁ : U.2.fromSpec q ∈ X.basicOpen s := by
      rw [← Scheme.Hom.mem_preimage, U.2.fromSpec_preimage_basicOpen]
      exact hsq
    rw [hq, ← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen] at h₁
    have : (i.app U.1) s = 0 := hs
    rw [this, Scheme.basicOpen_zero] at h₁
    exact h₁
  obtain ⟨m, g, h, hh, het⟩ := Algebra.exists_etale_mvPolynomial_of_isWeaklyRegular (R := k)
    (A := Γ(X, U.1)) (B := Γ(Z, i ⁻¹ᵁ U.1)) hsurj r.get hker (by rwa [List.ofFn_get])
    q.asIdeal hp
  sorry

end IsRegularImmersion

end AlgebraicGeometry
