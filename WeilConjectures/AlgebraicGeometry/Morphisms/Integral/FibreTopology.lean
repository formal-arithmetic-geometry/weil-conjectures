module

public import WeilConjectures.AlgebraicGeometry.Morphisms.Integral.PointedCover
public import WeilConjectures.Mathlib.Algebra.Category.Ring.Constructions

/-!
# The topology of the geometric fibre of an integral morphism

Let `f : X ⟶ Y` be an integral morphism, `y : Spec Ω ⟶ Y` a geometric point and `(U₀, u₀)` an
affine pointed étale neighbourhood of `y`, with `U₀ ×_Y X = Spec B`. A geometric point `t` of
`X` over `y` is determined by the ring homomorphism `B →+* Ω` of the point `(u₀, t)`. The sets
of geometric points agreeing with a given one on finitely many elements of `B` play the role of
the open subsets of the profinite geometric fibre. We show:

- the geometric fibre is quasi-compact for this topology: every cover by such sets has a finite
  subcover (`AlgebraicGeometry.Scheme.Hom.Nbhd.exists_finset_geometricFiber_cover`), since the
  points of an integral algebra over a field form a closed subset of a product of finite sets
  (`RingHom.PointsOver.exists_finset_cover`);
- on a fibre product of affine schemes, the value of a function at a geometric point only
  depends on the values of finitely many functions on the two factors
  (`AlgebraicGeometry.Scheme.Hom.exists_finset_appTopPoint_eq_of_isPullback`), the ring of
  functions being generated by those of the factors;
- a geometric point lies in the basic open of a function exactly when the function does not
  vanish at the point (`AlgebraicGeometry.Scheme.Hom.apply_default_mem_basicOpen_iff`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite Polynomial RingHom

section PointsOver

variable {A B Ω : Type*} [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B]
  [Field Ω] (φ : A →+* Ω)

/-- **Quasi-compactness of the points of an integral algebra.** The points of an integral
`A`-algebra `B` over `φ : A →+* Ω`, with the topology of pointwise convergence for the discrete
topology on `Ω`, are a compact space: every cover by sets of points agreeing with a given point
on a finite subset of `B` has a finite subcover. -/
theorem RingHom.PointsOver.exists_finset_cover (S : PointsOver φ B → Finset B) :
    ∃ T : Finset (PointsOver φ B), ∀ ψ : PointsOver φ B, ∃ ψ₀ ∈ T, ∀ b ∈ S ψ₀, ψ b = ψ₀ b := by
  classical
  let _ : TopologicalSpace Ω := ⊥
  have : DiscreteTopology Ω := ⟨rfl⟩
  let E : PointsOver φ B → (B → Ω) := fun ψ b ↦ ψ b
  -- the values at `b` lie in the finite set of roots of an integral equation of `b`
  choose p hpm hp using fun b : B ↦ Algebra.IsIntegral.isIntegral (R := A) b
  let R : B → Set Ω := fun b ↦ {ω | ω ∈ ((p b).map φ).roots}
  have hR (b : B) : (R b).Finite := ((p b).map φ).roots.toFinset.finite_toSet.subset
    (fun ω hω ↦ Multiset.mem_toFinset.2 hω)
  have hER (ψ : PointsOver φ B) (b : B) : E ψ b ∈ R b := by
    change ψ b ∈ ((p b).map φ).roots
    have h1 : eval₂ (ψ.1.comp (algebraMap A B)) (ψ.1 b) (p b) = 0 := by
      rw [← hom_eval₂, hp b, map_zero]
    rw [ψ.comp_algebraMap] at h1
    rw [mem_roots ((hpm b).map φ).ne_zero, IsRoot, eval_map]
    exact h1
  -- the set of points is closed
  let K : Set (B → Ω) := {F | F 1 = 1} ∩ ((⋂ x, ⋂ y, {F | F (x + y) = F x + F y}) ∩
    ((⋂ x, ⋂ y, {F | F (x * y) = F x * F y}) ∩ ⋂ a, {F | F (algebraMap A B a) = φ a}))
  have hcont₂ (op : Ω → Ω → Ω) (x y : B) : Continuous fun F : B → Ω ↦ op (F x) (F y) := by
    have h₁ : Continuous fun F : B → Ω ↦ (F x, F y) :=
      (continuous_apply x).prodMk (continuous_apply y)
    exact Continuous.comp (g := fun q : Ω × Ω ↦ op q.1 q.2) continuous_of_discreteTopology h₁
  have hK : IsClosed K := by
    refine (isClosed_eq (continuous_apply 1) continuous_const).inter
      ((isClosed_iInter fun x ↦ isClosed_iInter fun y ↦
        isClosed_eq (continuous_apply (x + y)) (hcont₂ (· + ·) x y)).inter
      ((isClosed_iInter fun x ↦ isClosed_iInter fun y ↦
        isClosed_eq (continuous_apply (x * y)) (hcont₂ (· * ·) x y)).inter
      (isClosed_iInter fun a ↦ isClosed_eq (continuous_apply _) continuous_const)))
  have hrange : Set.range E = K ∩ Set.pi Set.univ R := by
    ext F
    constructor
    · rintro ⟨ψ, rfl⟩
      simp only [K, Set.mem_inter_iff, Set.mem_iInter, Set.mem_ofPred_eq]
      refine ⟨⟨map_one ψ.1, fun x y ↦ map_add ψ.1 x y, fun x y ↦ map_mul ψ.1 x y,
        fun a ↦ ψ.apply_algebraMap a⟩, fun b _ ↦ hER ψ b⟩
    · simp only [K, Set.mem_inter_iff, Set.mem_iInter, Set.mem_ofPred_eq]
      rintro ⟨⟨h1, hadd, hmul, halg⟩, -⟩
      have h0 : F 0 = 0 := by
        have := hadd 0 0
        rw [add_zero] at this
        exact left_eq_add.mp this
      let ρ : B →+* Ω :=
        { toFun := F
          map_one' := h1
          map_mul' := hmul
          map_zero' := h0
          map_add' := hadd }
      exact ⟨⟨ρ, RingHom.ext halg⟩, rfl⟩
  have hcpt : IsCompact (Set.range E) := by
    rw [hrange]
    exact (isCompact_univ_pi fun b ↦ (hR b).isCompact).inter_left hK
  -- the finite subcover
  let U : PointsOver φ B → Set (B → Ω) := fun ψ₀ ↦ {F | ∀ b ∈ S ψ₀, F b = ψ₀ b}
  have hU (ψ₀ : PointsOver φ B) : IsOpen (U ψ₀) := by
    have : U ψ₀ = ⋂ b ∈ S ψ₀, (fun F : B → Ω ↦ F b) ⁻¹' {ψ₀ b} := by
      ext F
      simp [U]
    rw [this]
    exact isOpen_biInter_finset fun b _ ↦
      (continuous_apply b).isOpen_preimage _ (isOpen_discrete _)
  obtain ⟨T, hT⟩ := hcpt.elim_finite_subcover U hU fun F ⟨ψ, hψ⟩ ↦
    Set.mem_iUnion.2 ⟨ψ, hψ ▸ fun b _ ↦ rfl⟩
  refine ⟨T, fun ψ ↦ ?_⟩
  obtain ⟨ψ₀, hψ₀, h⟩ := Set.mem_iUnion₂.1 (hT ⟨ψ, rfl⟩)
  exact ⟨ψ₀, hψ₀, h⟩

end PointsOver

namespace AlgebraicGeometry

/-- A geometric point lies in the basic open of a global function exactly when the function
does not vanish at it. -/
lemma Scheme.Hom.apply_default_mem_basicOpen_iff {Ω : Type u} [Field Ω] {W : Scheme.{u}}
    (p : Spec (.of Ω) ⟶ W) (h : Γ(W, ⊤)) :
    p (default : Spec (.of Ω)) ∈ W.basicOpen h ↔ p.appTopPoint h ≠ 0 := by
  change default ∈ p ⁻¹ᵁ W.basicOpen h ↔ _
  rw [Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine', PrimeSpectrum.mem_basicOpen]
  have hp : (default : Spec (CommRingCat.of Ω)).asIdeal = ⊥ :=
    (Ideal.eq_bot_or_top _).resolve_right (default : Spec (CommRingCat.of Ω)).isPrime.ne_top
  rw [hp, Ideal.mem_bot]
  rfl

/-- **Functions on a fibre product of affine schemes at geometric points.** The value of a
function on the fibre product `P` of affine schemes at a geometric point only depends on the
values at the two projections of the point of finitely many functions on the factors: the ring
of functions of `P` is generated by those of the factors. -/
lemma Scheme.Hom.exists_finset_appTopPoint_eq_of_isPullback {P X₁ X₂ Z : Scheme.{u}}
    {fst : P ⟶ X₁} {snd : P ⟶ X₂} {g₁ : X₁ ⟶ Z} {g₂ : X₂ ⟶ Z} [IsAffine X₁] [IsAffine X₂]
    [IsAffine Z] (hP : IsPullback fst snd g₁ g₂) {Ω : Type u} [Field Ω] (h : Γ(P, ⊤)) :
    ∃ (S₁ : Finset Γ(X₁, ⊤)) (S₂ : Finset Γ(X₂, ⊤)), ∀ p p' : Spec (.of Ω) ⟶ P,
      (∀ a ∈ S₁, (p ≫ fst).appTopPoint a = (p' ≫ fst).appTopPoint a) →
      (∀ b ∈ S₂, (p ≫ snd).appTopPoint b = (p' ≫ snd).appTopPoint b) →
      p.appTopPoint h = p'.appTopPoint h := by
  classical
  have hcl := CommRingCat.IsPushout.closure_range_union_eq_top (isPushout_appTop_of_isPullback hP)
  have hh : h ∈ Subring.closure (Set.range ⇑fst.appTop.hom ∪ Set.range ⇑snd.appTop.hom) :=
    hcl ▸ Subring.mem_top h
  induction hh using Subring.closure_induction with
  | mem x hx =>
    rcases hx with ⟨a, rfl⟩ | ⟨b, rfl⟩
    · refine ⟨{a}, ∅, fun p p' h₁ _ ↦ ?_⟩
      have := h₁ a (Finset.mem_singleton_self a)
      rwa [Scheme.Hom.appTopPoint_comp, Scheme.Hom.appTopPoint_comp] at this
    · refine ⟨∅, {b}, fun p p' _ h₂ ↦ ?_⟩
      have := h₂ b (Finset.mem_singleton_self b)
      rwa [Scheme.Hom.appTopPoint_comp, Scheme.Hom.appTopPoint_comp] at this
  | zero => exact ⟨∅, ∅, fun _ _ _ _ ↦ by rw [map_zero, map_zero]⟩
  | one => exact ⟨∅, ∅, fun _ _ _ _ ↦ by rw [map_one, map_one]⟩
  | add x y _ _ hx hy =>
    obtain ⟨S₁, S₂, hS⟩ := hx
    obtain ⟨T₁, T₂, hT⟩ := hy
    refine ⟨S₁ ∪ T₁, S₂ ∪ T₂, fun p p' h₁ h₂ ↦ ?_⟩
    rw [map_add, map_add,
      hS p p' (fun a ha ↦ h₁ a (Finset.mem_union_left _ ha))
        (fun b hb ↦ h₂ b (Finset.mem_union_left _ hb)),
      hT p p' (fun a ha ↦ h₁ a (Finset.mem_union_right _ ha))
        (fun b hb ↦ h₂ b (Finset.mem_union_right _ hb))]
  | neg x _ hx =>
    obtain ⟨S₁, S₂, hS⟩ := hx
    exact ⟨S₁, S₂, fun p p' h₁ h₂ ↦ by rw [map_neg, map_neg, hS p p' h₁ h₂]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨S₁, S₂, hS⟩ := hx
    obtain ⟨T₁, T₂, hT⟩ := hy
    refine ⟨S₁ ∪ T₁, S₂ ∪ T₂, fun p p' h₁ h₂ ↦ ?_⟩
    rw [map_mul, map_mul,
      hS p p' (fun a ha ↦ h₁ a (Finset.mem_union_left _ ha))
        (fun b hb ↦ h₂ b (Finset.mem_union_left _ hb)),
      hT p p' (fun a ha ↦ h₁ a (Finset.mem_union_right _ ha))
        (fun b hb ↦ h₂ b (Finset.mem_union_right _ hb))]

namespace Scheme.Hom.Nbhd

variable {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIntegralHom f] {Ω : Type u} [Field Ω]
  [IsSepClosed Ω] {y : Spec (.of Ω) ⟶ Y}

/-- Every point of `Γ(U₀ ×_Y X)` over the point `u₀` of `Γ(U₀)` is the point `(u₀, t)` of a
geometric point `t` of `X` over `y`. -/
lemma exists_geometricFiber_appTopPoint_eq (c₀ : Nbhd y) [IsAffine c₀.1.left]
    (ψ : Γ(pullback c₀.1.hom f, ⊤) →+* Ω)
    (hψ : ψ.comp (pullback.fst c₀.1.hom f).appTop.hom = c₀.2.left.appTopPoint) :
    ∃ t : f.GeometricFiber y, (basePt f c₀ t).appTopPoint = ψ := by
  have : IsAffine ((𝟭 Scheme).obj c₀.1.left) := ‹IsAffine c₀.1.left›
  have : IsAffine (pullback c₀.1.hom f) := isAffine_of_isAffineHom (pullback.fst c₀.1.hom f)
  let p : Spec (.of Ω) ⟶ pullback c₀.1.hom f :=
    Spec.map (CommRingCat.ofHom ψ) ≫ (pullback c₀.1.hom f).isoSpec.inv
  have hp : p.appTopPoint = ψ := by
    have h₁ := Scheme.Hom.comp_toSpecΓ p
    have h₂ : p ≫ (pullback c₀.1.hom f).toSpecΓ = Spec.map (CommRingCat.ofHom ψ) := by
      rw [← Scheme.isoSpec_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    exact congrArg CommRingCat.Hom.hom (Spec.map_injective (h₁.symm.trans h₂))
  have hfst : p ≫ pullback.fst c₀.1.hom f = c₀.2.left := by
    rw [← cancel_mono c₀.1.left.toSpecΓ, Scheme.Hom.comp_toSpecΓ, Scheme.Hom.comp_toSpecΓ,
      Scheme.Hom.appTopPoint_comp, hp, hψ]
  refine ⟨⟨p ≫ pullback.snd c₀.1.hom f, ?_⟩, ?_⟩
  · rw [Category.assoc, ← pullback.condition, ← Category.assoc, hfst]
    exact CategoryTheory.Over.w c₀.2
  · rw [basePt_eq_of_comp_fst_eq f c₀ p hfst, hp]

/-- **Quasi-compactness of the geometric fibre of an integral morphism.** Let `(U₀, u₀)` be an
affine pointed étale neighbourhood of `y`, and attach to every geometric point `t` of `X` over
`y` a finite set `S t` of functions on `U₀ ×_Y X`. Then there are finitely many `t₀` such that
every `t` agrees at `(u₀, t)` with one of the `(u₀, t₀)` on the functions of `S t₀`. -/
theorem exists_finset_geometricFiber_cover (c₀ : Nbhd y) [IsAffine c₀.1.left]
    (S : f.GeometricFiber y → Finset Γ(pullback c₀.1.hom f, ⊤)) :
    ∃ T : Finset (f.GeometricFiber y), ∀ t, ∃ t₀ ∈ T, ∀ b ∈ S t₀,
      (basePt f c₀ t).appTopPoint b = (basePt f c₀ t₀).appTopPoint b := by
  classical
  have : IsAffine ((𝟭 Scheme).obj c₀.1.left) := ‹IsAffine c₀.1.left›
  let _ : Algebra Γ(((Etale.forget Y).obj c₀.1).left, ⊤) Γ(pullback c₀.1.hom f, ⊤) :=
    (pullback.fst c₀.1.hom f).appTop.hom.toAlgebra
  have : Algebra.IsIntegral Γ(((Etale.forget Y).obj c₀.1).left, ⊤) Γ(pullback c₀.1.hom f, ⊤) :=
    ⟨fun b ↦ (pullback.fst c₀.1.hom f).isIntegral_app ⊤ (isAffineOpen_top _) b⟩
  let φ₀ := c₀.2.left.appTopPoint
  let ev : f.GeometricFiber y → PointsOver φ₀ Γ(pullback c₀.1.hom f, ⊤) := fun t ↦
    ⟨(basePt f c₀ t).appTopPoint, by
      change (basePt f c₀ t).appTopPoint.comp (pullback.fst c₀.1.hom f).appTop.hom = φ₀
      rw [← Scheme.Hom.appTopPoint_comp, basePt_fst]⟩
  have hev (ψ : PointsOver φ₀ Γ(pullback c₀.1.hom f, ⊤)) : ∃ t, ev t = ψ := by
    obtain ⟨t, ht⟩ := exists_geometricFiber_appTopPoint_eq f c₀ ψ.1 ψ.2
    exact ⟨t, Subtype.ext ht⟩
  choose sec hsec using hev
  obtain ⟨T, hT⟩ := RingHom.PointsOver.exists_finset_cover φ₀ fun ψ ↦ S (sec ψ)
  refine ⟨T.image sec, fun t ↦ ?_⟩
  obtain ⟨ψ₀, hψ₀, h⟩ := hT (ev t)
  refine ⟨sec ψ₀, Finset.mem_image_of_mem _ hψ₀, fun b hb ↦ ?_⟩
  have := h b hb
  rw [← hsec ψ₀] at this
  exact this

end Scheme.Hom.Nbhd

end AlgebraicGeometry
