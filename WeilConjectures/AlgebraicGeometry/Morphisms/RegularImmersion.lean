module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.Topology.KrullDimension

/-!
# Regular closed immersions, normal cones and normal bundles

A closed immersion `i : Z ⟶ X` is *regular of pure codimension `c`* when its ideal sheaf is,
locally on `X`, generated by a regular sequence of length `c`. This file introduces the class
`AlgebraicGeometry.IsRegularImmersion` recording that, together with the two objects the
purity chapter attaches to such an immersion — the normal cone `N_{Z/X}`, which for a regular
immersion is a vector bundle of rank `c`, and the relative tangent bundle `T_{X/Y}` of a
smooth morphism — and the two elementary lemmas of the blueprint about them.

## Implementation notes

The pinned Mathlib has no relative `Spec` of a quasi-coherent graded algebra, no vector
bundles over a scheme and no sheaf of relative differentials, so `normalCone` and
`tangentBundle` are `opaque` constants: they depend genuinely on their arguments and introduce
no `sorryAx`, but they satisfy no equations. Their blueprint home is `sk-def-purity-conv`, the
conventions subsection of the smooth-purity block, so they are defined here rather than taken
as hypotheses.

## Main definitions

- `AlgebraicGeometry.IsRegularImmersion`: a closed immersion cut out, locally, by a regular
  sequence of length `c`.
- `AlgebraicGeometry.Scheme.Hom.normalCone`: the normal cone `N_{Z/X}` of a closed immersion
  (placeholder).
- `AlgebraicGeometry.Scheme.Hom.tangentBundle`: the relative tangent bundle `T_{X/Y}` of a
  morphism (placeholder).

## Main statements

- `AlgebraicGeometry.IsRegularImmersion.smooth_of_smooth`
- `AlgebraicGeometry.isRegularImmersion_diagonal`
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {X Y Z : Scheme.{u}}

/-- A closed immersion `i : Z ⟶ X` is a *regular immersion of pure codimension `c`* if, around
every point of `X`, its ideal sheaf is generated by a regular sequence of length `c`.

The condition is imposed at every point of `X`, including the points outside `Z`, where the
ideal is the unit ideal and the empty condition is met by any regular sequence generating it;
this is the usual formulation, and is what makes the property local on `X`. -/
class IsRegularImmersion (c : ℕ) (i : Z ⟶ X) : Prop extends IsClosedImmersion i where
  /-- Locally on `X` the ideal sheaf of `i` is generated by a regular sequence of length `c`. -/
  exists_isRegular_generators (x : X) : ∃ U : X.affineOpens, x ∈ U.1 ∧
    ∃ r : List Γ(X, U.1), r.length = c ∧
      Ideal.ofList r = (Scheme.Hom.ker i).ideal U

/-- The normal cone datum of a closed immersion `i : Z ⟶ X` with ideal sheaf `I`: the scheme
`N_{Z/X} = Spec_Z (⨁_{r ≥ 0} I^r/I^{r+1})` together with its projection to `Z` and its zero
section.

Mathlib has no relative `Spec` of a quasi-coherent graded `𝒪_Z`-algebra, so this is an
`opaque` placeholder; it satisfies no equations. The three components are packaged together
because the projection and the zero section have no type before the scheme is known. -/
-- TODO(unify): sk-def-purity-conv
noncomputable opaque Scheme.Hom.normalConeData (i : Z ⟶ X) :
    Σ N : Scheme.{u}, (N ⟶ Z) × (Z ⟶ N) :=
  ⟨Z, 𝟙 Z, 𝟙 Z⟩

/-- The normal cone `N_{Z/X} = Spec_Z (⨁_{r ≥ 0} I^r/I^{r+1})` of a closed immersion
`i : Z ⟶ X` with ideal sheaf `I`. For `i` regular of pure codimension `c` the conormal sheaf
`I/I²` is locally free of rank `c` and `N_{Z/X} → Z` is a vector bundle of rank `c`. -/
noncomputable def Scheme.Hom.normalCone (i : Z ⟶ X) : Scheme.{u} :=
  i.normalConeData.1

/-- The projection `N_{Z/X} → Z` of the normal cone of a closed immersion. -/
noncomputable def Scheme.Hom.normalConeProj (i : Z ⟶ X) : i.normalCone ⟶ Z :=
  i.normalConeData.2.1

/-- The zero section `Z → N_{Z/X}` of the normal cone of a closed immersion. -/
noncomputable def Scheme.Hom.normalConeZero (i : Z ⟶ X) : Z ⟶ i.normalCone :=
  i.normalConeData.2.2

/-- The relative tangent bundle `T_{X/Y} = Spec_X (Sym Ω¹_{X/Y})` of a morphism of schemes.

Mathlib has neither the sheaf of relative differentials of a morphism of schemes nor the
relative `Spec` of a symmetric algebra, so this is an `opaque` placeholder; it satisfies no
equations. -/
-- TODO(unify): sk-def-purity-conv
noncomputable opaque Scheme.Hom.tangentBundle (f : X ⟶ Y) : Scheme.{u} := X

/-- Blueprint `sk-lem-regular-smooth`: A regular immersion of smooth schemes over a perfect
field

Let `i : Z ⟶ X` be a regular closed immersion of pure codimension `c` with `X` smooth over a
perfect field `k` and `Z` regular. Then the structure morphism of `Z` is smooth too: a regular
scheme of finite type over a perfect field is smooth over it. The dimension count — a
component of `X` of dimension `n` meets `Z` in pure dimension `n - c` — is the second half of
the blueprint lemma and is the `topologicalKrullDim` clause below. -/
theorem IsRegularImmersion.smooth_of_smooth {k : Type u} [Field k] [PerfectField k] (c : ℕ)
    (i : Z ⟶ X) [IsRegularImmersion c i] (aX : X ⟶ Spec (.of k)) [Smooth aX]
    [LocallyOfFiniteType (i ≫ aX)]
    (hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) :
    Smooth (i ≫ aX) ∧ topologicalKrullDim Z + (c : WithBot ℕ∞) = topologicalKrullDim X :=
  sorry

/-- Blueprint `sk-lem-diag-reg`: The diagonal is a regular immersion

Let `f : X ⟶ Y` be smooth and separated of pure relative dimension `d`, let
`W = X ×_Y X` and let `Δ : X ⟶ W` be the diagonal. Then `Δ` is a regular closed immersion of
pure codimension `d`, and its normal bundle is canonically the relative tangent bundle
`T_{X/Y}`.

Étale-locally `f` is the projection `𝔸^d_Y → Y`, on which `Δ` is the zero section of `𝔸^d`;
regularity, the codimension and the normal bundle are étale local, whence the statement. -/
theorem isRegularImmersion_diagonal (d : ℕ) (f : X ⟶ Y) [IsSeparated f]
    [SmoothOfRelativeDimension d f] :
    IsRegularImmersion d (pullback.diagonal f) ∧
      Nonempty ((pullback.diagonal f).normalCone ≅ f.tangentBundle) :=
  sorry

end AlgebraicGeometry
