/-!
# Regular closed immersions and normal cones

A closed immersion `i : Z ⟶ X` is *regular of pure codimension `c`* when its ideal sheaf is,
locally on `X`, generated by a regular sequence of length `c`. This file introduces the class
`AlgebraicGeometry.IsRegularImmersion` recording that, the normal cone of such an immersion —
which is a vector bundle of rank `c`, hence in particular smooth of relative dimension `c`
over `Z` — and the two elementary lemmas of the blueprint about them.

## Implementation notes

The pinned Mathlib has no relative `Spec` of a quasi-coherent graded algebra and no vector
bundles over a scheme, so the normal cone cannot be *constructed* here. It is therefore
carried as *data*: `AlgebraicGeometry.Scheme.Hom.NormalConeData c i` bundles a scheme `N`, a
projection `N ⟶ Z` and a zero section `Z ⟶ N` together with the properties the purity chapter
uses, and every statement that needs a normal cone takes such a datum as a hypothesis. This
keeps all statements provable; constructing the datum for a regular immersion is a separate
theorem, recorded as a TODO below.

The relative tangent bundle `T_{X/Y}` of a smooth morphism is not introduced at all: Mathlib
has no sheaf of relative differentials of a morphism of schemes, and the only place the
blueprint block uses `T_{X/Y}` is the identification of the normal bundle of the diagonal,
which is not needed downstream.

## Main definitions

- `AlgebraicGeometry.IsRegularImmersion`: a closed immersion cut out, locally, by a regular
  sequence of length `c`.
- `AlgebraicGeometry.Scheme.Hom.NormalConeData`: the normal cone `N_{Z/X}` of a regular
  immersion of codimension `c`, as data.

## Main statements

- `AlgebraicGeometry.IsRegularImmersion.smooth_comp`
- `AlgebraicGeometry.IsRegularImmersion.ringKrullDim_stalk_add`
- `AlgebraicGeometry.isRegularImmersion_specMap`: a criterion for `Spec S ⟶ Spec R`.
- `AlgebraicGeometry.isRegularImmersion_diagonal`: the diagonal of a smooth separated morphism
  of relative dimension `d > 0` is regular of codimension `d`.
- `AlgebraicGeometry.IsRegularImmersion.comp`: regular immersions compose, adding codimensions.
- `AlgebraicGeometry.IsRegularImmersion.of_isPullback`: stability under flat base change.
- `AlgebraicGeometry.IsRegularImmersion.pullback_map`: exterior products over a field.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {X Y Z : Scheme.{u}}

/-- A closed immersion `i : Z ⟶ X` is a *regular immersion of pure codimension `c`* if, around
every point of `X`, its ideal sheaf is generated by a regular sequence of length `c`.

The condition is imposed at every point of `X`, including the points outside `Z`, where the
ideal is the unit ideal and any sequence generating it will do; this is the usual formulation,
and is what makes the property local on `X`. Note that the sequence is required to be *weakly*
regular: `RingTheory.Sequence.IsRegular` carries the extra condition `⊤ ≠ (r) • ⊤`, which
fails precisely at the points outside `Z`. -/
class IsRegularImmersion (c : ℕ) (i : Z ⟶ X) : Prop extends IsClosedImmersion i where
  /-- Locally on `X` the ideal sheaf of `i` is generated by a regular sequence of length `c`. -/
  exists_isWeaklyRegular_generators (x : X) : ∃ U : X.affineOpens, x ∈ U.1 ∧
    ∃ r : List Γ(X, U.1), r.length = c ∧
      RingTheory.Sequence.IsWeaklyRegular Γ(X, U.1) r ∧
      Ideal.ofList r = (Scheme.Hom.ker i).ideal U

namespace Scheme.Hom

/-- The normal cone `N_{Z/X} = Spec_Z (⨁_{r ≥ 0} I^r/I^{r+1})` of a regular closed immersion
`i : Z ⟶ X` of pure codimension `c`, as data: the scheme `N`, its projection to `Z`, its zero
section, and the two properties the purity chapter uses — that the zero section really is a
closed section, and that `N ⟶ Z` is a vector bundle of rank `c`, of which only smoothness of
relative dimension `c` is expressible in the pinned Mathlib.

Mathlib has no relative `Spec` of a quasi-coherent graded `𝒪_Z`-algebra, so this datum cannot
yet be constructed; it is taken as a hypothesis wherever a normal cone is needed. -/
-- TODO(unify): sk-def-purity-conv — construct the datum for every regular immersion.
-- TODO: nothing ties the datum to `i`: any smooth rank-`c` projection with a closed zero section
-- is accepted, which makes the existence of a deformation to the normal cone
-- (`nonempty_deformationToNormalConeData`) false as stated. Pin the datum down. Smooth purity
-- (`nonempty_iso_dualizingComplex_twistShift`) is `sorry` until the normal bundle of the
-- diagonal is constructed as such a datum; its proof then goes through
-- `nonempty_iso_sectionInvariant_normalCone`.
structure NormalConeData (c : ℕ) (i : Z ⟶ X) where
  /-- The normal cone `N_{Z/X}`. -/
  scheme : Scheme.{u}
  /-- The projection `π : N_{Z/X} ⟶ Z`. -/
  proj : scheme ⟶ Z
  /-- The zero section `0_N : Z ⟶ N_{Z/X}`. -/
  zeroSection : Z ⟶ scheme
  /-- The zero section is a section of the projection. -/
  zeroSection_comp_proj : zeroSection ≫ proj = 𝟙 Z
  /-- The zero section is a closed immersion. -/
  isClosedImmersion_zeroSection : IsClosedImmersion zeroSection
  /-- The normal cone of a regular immersion of codimension `c` is a vector bundle of rank
  `c`; in particular its projection is smooth of pure relative dimension `c`. -/
  smoothOfRelativeDimension_proj : SmoothOfRelativeDimension c proj

attribute [instance] NormalConeData.isClosedImmersion_zeroSection
  NormalConeData.smoothOfRelativeDimension_proj

end Scheme.Hom

/-- Blueprint `sk-lem-regular-smooth`: A regular immersion of smooth schemes over a perfect
field

**Smoothness of the sub-scheme.** Let `i : Z ⟶ X` be a regular closed immersion of pure
codimension `c` with `X` smooth over a perfect field `k` and `Z` regular. Then the structure
morphism of `Z` is smooth too: a regular scheme of finite type over a perfect field is smooth
over it (`AlgebraicGeometry.smooth_of_isRegular`). -/
theorem IsRegularImmersion.smooth_comp {k : Type u} [Field k] [PerfectField k] (c : ℕ)
    (i : Z ⟶ X) [IsRegularImmersion c i] (aX : X ⟶ Spec (.of k)) [Smooth aX]
    [LocallyOfFiniteType (i ≫ aX)]
    (hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) :
    Smooth (i ≫ aX) :=
  have : IsRegular Z := ⟨hZ⟩
  smooth_of_isRegular (i ≫ aX)

/-- Blueprint `sk-lem-regular-smooth`: A regular immersion of smooth schemes over a perfect
field

**The dimension count.** With the hypotheses of `AlgebraicGeometry.IsRegularImmersion.smooth_comp`,
a component of `X` of dimension `n` meets `Z` in pure dimension `n - c`. Stated stalkwise, so
that it is insensitive to the components of `X` that `Z` misses: at every point `z` of `Z` the
local ring of `X` at `i(z)` has Krull dimension `c` more than the local ring of `Z` at `z`.

Near `i(z)` the ideal of `Z` is generated by a weakly regular sequence of length `c`; its image
in the noetherian local ring `𝒪_{X,i(z)}` lies in the maximal ideal, so it is a regular
sequence there, and cutting by a regular sequence of length `c` lowers the dimension by
exactly `c`. The regularity of `Z` is not needed for this count. -/
theorem IsRegularImmersion.ringKrullDim_stalk_add {k : Type u} [Field k] [PerfectField k]
    (c : ℕ) (i : Z ⟶ X) [IsRegularImmersion c i] (aX : X ⟶ Spec (.of k)) [Smooth aX]
    [LocallyOfFiniteType (i ≫ aX)]
    (_hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) (z : Z) :
    ringKrullDim (X.presheaf.stalk (i.base z)) =
      ringKrullDim (Z.presheaf.stalk z) + (c : WithBot ℕ∞) := by
  obtain ⟨U, hxU, r, rfl, hreg, hI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators (c := c) (i := i) (i z)
  have := LocallyOfFiniteType.isLocallyNoetherian aX
  let := X.presheaf.algebra_section_stalk ⟨i z, hxU⟩
  have := U.2.isLocalization_stalk ⟨i z, hxU⟩
  have : Module.Flat Γ(X, U.1) (X.presheaf.stalk (i z)) :=
    IsLocalization.flat _ (U.2.primeIdealOf ⟨i z, hxU⟩).asIdeal.primeCompl
  have hsupp : i z ∈ X.zeroLocus (U := U.1) (i.ker.ideal U) :=
    (Scheme.IdealSheafData.mem_support_iff_of_mem hxU).mp
      (i.range_subset_ker_support ⟨z, rfl⟩)
  have hreg' : RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z))
      (r.map (algebraMap Γ(X, U.1) (X.presheaf.stalk (i z)))) := by
    refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).mpr
      hreg.of_flat
    intro _ hs'
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hs'
    have : s ∈ i.ker.ideal U := hI ▸ Ideal.subset_span hs
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (X.mem_basicOpen _ _ hxU).not.mp ((X.mem_zeroLocus_iff _ _).mp hsupp s this)
  have key := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hreg'
  rw [← Ideal.map_ofList, hI,
    show algebraMap Γ(X, U.1) _ = (X.presheaf.germ U (i z) hxU).hom from rfl,
    ← i.ker_stalkMap U z hxU,
    ringKrullDim_eq_of_ringEquiv
      (RingHom.quotientKerEquivOfSurjective (i.stalkMap_surjective z)), List.length_map] at key
  exact key.symm

namespace IsRegularImmersion

open RingTheory.Sequence

/-- To exhibit the ideal of `i` near `x` as generated by a weakly regular sequence of length `c`,
it suffices to do so after a flat ring map `S →+* Γ(X, U)`. -/
theorem exists_isWeaklyRegular_generators_of_flat {c : ℕ} {i : Z ⟶ X} {x : X}
    (U : X.affineOpens) (hxU : x ∈ U.1) {S : Type u} [CommRing S] (ψ : S →+* Γ(X, U.1))
    (hψ : ψ.Flat) (r : List S) (hr : r.length = c) (hreg : IsWeaklyRegular S r)
    (hI : (Ideal.ofList r).map ψ = (Scheme.Hom.ker i).ideal U) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ ∃ r : List Γ(X, U.1), r.length = c ∧
      IsWeaklyRegular Γ(X, U.1) r ∧ Ideal.ofList r = (Scheme.Hom.ker i).ideal U :=
  ⟨U, hxU, r.map ψ, by rw [List.length_map, hr], hreg.map_of_flat hψ,
    by rw [← Ideal.map_ofList, hI]⟩

/-- Away from the image of a closed immersion `i`, its ideal is the unit ideal, which is
generated by the weakly regular sequence `1, 0, …, 0` of any positive length `c`. -/
theorem exists_isWeaklyRegular_generators_of_notMem_range {c : ℕ} (hc : c ≠ 0) (i : Z ⟶ X)
    [IsClosedImmersion i] {x : X} (hx : x ∉ Set.range i) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ ∃ r : List Γ(X, U.1), r.length = c ∧
      IsWeaklyRegular Γ(X, U.1) r ∧ Ideal.ofList r = (Scheme.Hom.ker i).ideal U := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUi⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_compl hx) i.isClosedEmbedding.isClosed_range.isOpen_compl
  have hU' : i ⁻¹ᵁ U = ⊥ := by
    ext z
    simpa using fun hz : i z ∈ U ↦ hUi hz ⟨z, rfl⟩
  have hI : (Scheme.Hom.ker i).ideal ⟨U, hU⟩ = ⊤ := by
    rw [Scheme.Hom.ker_apply, Ideal.eq_top_iff_one, RingHom.mem_ker]
    have : Subsingleton Γ(Z, i ⁻¹ᵁ U) := hU' ▸ inferInstance
    exact Subsingleton.elim _ _
  refine ⟨⟨U, hU⟩, hxU, 1 :: List.replicate (c - 1) 0, by simp; omega, ?_, ?_⟩
  · rw [isWeaklyRegular_cons_iff]
    refine ⟨fun a b h ↦ by simpa using h, ?_⟩
    have : Subsingleton (QuotSMulTop (1 : Γ(X, U)) Γ(X, U)) :=
      Submodule.Quotient.subsingleton_iff.mpr (by simp)
    rw [isWeaklyRegular_iff_Fin]
    exact fun _ _ _ _ ↦ Subsingleton.elim _ _
  · rw [hI, Ideal.eq_top_iff_one]
    exact Ideal.subset_span (List.mem_cons_self ..)

/-- The ideal of a closed immersion can be read off on an open subscheme: if `i'` is the
restriction of `i` along an open immersion `j` and the ideal of `i'` is generated by a weakly
regular sequence of length `c` near `x'`, then so is the ideal of `i` near `j x'`. -/
theorem exists_isWeaklyRegular_generators_of_isPullback {c : ℕ} {i : Z ⟶ X} {Z' X' : Scheme.{u}}
    {g : Z' ⟶ Z} {i' : Z' ⟶ X'} {j : X' ⟶ X} (h : IsPullback g i' i j) [IsOpenImmersion j]
    [IsClosedImmersion i] [IsRegularImmersion c i'] (x' : X') :
    ∃ U : X.affineOpens, j x' ∈ U.1 ∧ ∃ r : List Γ(X, U.1), r.length = c ∧
      IsWeaklyRegular Γ(X, U.1) r ∧ Ideal.ofList r = (Scheme.Hom.ker i).ideal U := by
  obtain ⟨W, hxW, r, hr, hreg, hI⟩ := exists_isWeaklyRegular_generators (c := c) (i := i') x'
  refine exists_isWeaklyRegular_generators_of_flat ⟨j ''ᵁ W, W.2.image_of_isOpenImmersion j⟩
    ⟨x', hxW, rfl⟩ (j.appIso W).inv.hom
    (.of_bijective (ConcreteCategory.bijective_of_isIso (j.appIso W).inv)) r hr hreg ?_
  rw [hI, Scheme.ker_ideal_of_isPullback_of_isOpenImmersion i i' g j h.flip W]
  exact Ideal.map_comap_of_surjective _
    (ConcreteCategory.bijective_of_isIso (j.appIso W).inv).2 _

/-- Regular immersions are stable under composition with an isomorphism of the target. -/
instance comp_isIso {c : ℕ} (i : Z ⟶ X) [IsRegularImmersion c i] {X' : Scheme.{u}} (e : X ⟶ X')
    [IsIso e] : IsRegularImmersion c (i ≫ e) where
  exists_isWeaklyRegular_generators x := by
    obtain ⟨x, rfl⟩ : x ∈ Set.range e := by
      rw [(ConcreteCategory.bijective_of_isIso e.base).2.range_eq]; trivial
    exact exists_isWeaklyRegular_generators_of_isPullback
      (IsPullback.of_horiz_isIso ⟨by simp⟩ : IsPullback (𝟙 Z) i (i ≫ e) e) x

/-- Regular immersions are stable under composition with an isomorphism of the source. -/
instance isIso_comp {c : ℕ} (i : Z ⟶ X) [IsRegularImmersion c i] {Z' : Scheme.{u}} (e : Z' ⟶ Z)
    [IsIso e] : IsRegularImmersion c (e ≫ i) where
  exists_isWeaklyRegular_generators x := by
    rw [Scheme.Hom.ker_comp_of_isIso]
    exact exists_isWeaklyRegular_generators x

end IsRegularImmersion

open RingTheory.Sequence in
/-- **Regular immersions of affine schemes.** Let `φ : R →+* S` be surjective and let `c` be
positive. Suppose that a weakly regular sequence `r` of length `c` of `R` lies in `ker φ` and
generates it after inverting an element `e` with `φ e = 1`, in the sense that `e` multiplies
`ker φ` into the ideal generated by `r`. Then `Spec S ⟶ Spec R` is a regular immersion of
pure codimension `c`. -/
theorem isRegularImmersion_specMap {R S : Type u} [CommRing R] [CommRing S] {c : ℕ} (hc : c ≠ 0)
    (φ : R →+* S) (hφ : Function.Surjective φ) (r : List R) (hr : r.length = c)
    (hreg : IsWeaklyRegular R r) (hrφ : Ideal.ofList r ≤ RingHom.ker φ) (e : R) (he : φ e = 1)
    (hek : ∀ k ∈ RingHom.ker φ, e * k ∈ Ideal.ofList r) :
    IsRegularImmersion c (Spec.map (CommRingCat.ofHom φ)) where
  toIsClosedImmersion := .spec_of_surjective (CommRingCat.ofHom φ) hφ
  exists_isWeaklyRegular_generators x := by
    have := IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom φ) hφ
    by_cases hx : x ∈ Set.range (Spec.map (CommRingCat.ofHom φ))
    swap
    · exact IsRegularImmersion.exists_isWeaklyRegular_generators_of_notMem_range hc _ hx
    obtain ⟨y, rfl⟩ := hx
    let ι := (Scheme.ΓSpecIso (.of R)).inv
    let D := (Spec (.of R)).basicOpen (ι e)
    let U : (Spec (.of R)).affineOpens := ⟨D, (isAffineOpen_top _).basicOpen _⟩
    have hyU : Spec.map (CommRingCat.ofHom φ) y ∈ U.1 := by
      change y ∈ Spec.map (CommRingCat.ofHom φ) ⁻¹ᵁ (Spec (.of R)).basicOpen (ι e)
      rw [Scheme.preimage_basicOpen]
      change y ∈ (Spec (.of S)).basicOpen ((Spec.map (CommRingCat.ofHom φ)).appTop.hom (ι e))
      rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
      simp [he]
    have := isLocalization_away_of_isAffine (X := Spec (.of R)) (ι e)
    let ψ : R →+* Γ(Spec (.of R), D) := (algebraMap Γ(Spec (.of R), ⊤) _).comp ι.hom
    have hιb := ConcreteCategory.bijective_of_isIso ι
    have hψ : ψ.Flat :=
      .comp (.of_bijective hιb) (RingHom.Flat.holdsForLocalizationAway _ (ι e))
    refine IsRegularImmersion.exists_isWeaklyRegular_generators_of_flat U hyU ψ hψ r hr hreg ?_
    have hker : (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom φ))).ideal
        ⟨⊤, isAffineOpen_top _⟩ = (RingHom.ker φ).map ι.hom := by
      rw [Scheme.Hom.ker_apply]
      have h₁ : RingHom.ker φ =
          (RingHom.ker (Spec.map (CommRingCat.ofHom φ)).appTop.hom).comap ι.hom := by
        rw [RingHom.comap_ker, ← CommRingCat.hom_comp, ← Scheme.ΓSpecIso_inv_naturality,
          CommRingCat.hom_comp, RingHom.ker_comp_of_injective _
            (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of S)).inv).1]
        rfl
      rw [h₁, Ideal.map_comap_of_surjective _ hιb.2]
    rw [← Scheme.IdealSheafData.map_ideal (V := ⟨⊤, isAffineOpen_top _⟩) _
      (by exact le_top (a := D)), hker,
      Ideal.map_map]
    refine le_antisymm (Ideal.map_mono hrφ) (Ideal.map_le_iff_le_comap.mpr fun k hk ↦ ?_)
    obtain ⟨u, hu⟩ : IsUnit (ψ e) := IsLocalization.Away.algebraMap_isUnit (ι e)
    have : ψ k = ↑u⁻¹ * ψ (e * k) := by rw [map_mul, ← hu, Units.inv_mul_cancel_left]
    rw [Ideal.mem_comap]
    exact this ▸ Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem ψ (hek k hk))

namespace IsRegularImmersion

/-- The diagonal of `e ≫ f` for an isomorphism `e` is, up to isomorphisms, that of `f`. -/
theorem diagonal_isIso_comp {c : ℕ} {X' : Scheme.{u}} (e : X' ⟶ X) [IsIso e] (f : X ⟶ Y)
    [IsRegularImmersion c (pullback.diagonal f)] :
    IsRegularImmersion c (pullback.diagonal (e ≫ f)) := by
  have h : pullback.diagonal (e ≫ f) = (e ≫ pullback.diagonal f) ≫
      inv (pullback.map (e ≫ f) (e ≫ f) f f e e (𝟙 Y) (by simp) (by simp)) := by
    rw [IsIso.eq_comp_inv]
    exact (pullback.comp_diagonal e f).symm
  rw [h]
  infer_instance

/-- The diagonal of `f ≫ e` for an isomorphism `e` is, up to an isomorphism, that of `f`. -/
theorem diagonal_comp_isIso {c : ℕ} {Y' : Scheme.{u}} (f : X ⟶ Y) (e : Y ⟶ Y') [IsIso e]
    [IsRegularImmersion c (pullback.diagonal f)] :
    IsRegularImmersion c (pullback.diagonal (f ≫ e)) := by
  rw [pullback.diagonal_comp]
  infer_instance

end IsRegularImmersion

open TensorProduct in
/-- The diagonal of `Spec A ⟶ Spec R` for a standard smooth `R → A` of relative dimension
`d > 0` is a regular immersion of pure codimension `d`. Write `A` as étale over
`R[X₀, …, X_{d-1}]` (`RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial`);
the diagonal is `Spec` of the multiplication `A ⊗[R] A → A`, whose kernel is generated by the
weakly regular sequence `1 ⊗ Xᵢ - Xᵢ ⊗ 1` away from the idempotent of the diagonal of `A` over
`R[X₀, …, X_{d-1}]`. -/
theorem isRegularImmersion_diagonal_specMap {R A : Type u} [CommRing R] [CommRing A] {d : ℕ}
    [NeZero d] (φ : R →+* A) (H : φ.IsStandardSmoothOfRelativeDimension d) :
    IsRegularImmersion d (pullback.diagonal (Spec.map (CommRingCat.ofHom φ))) := by
  algebraize [φ]
  obtain ⟨g, hgC, hg⟩ := H.exists_etale_mvPolynomial
  let ψ : MvPolynomial (Fin d) R →ₐ[R] A :=
    { g with commutes' := fun r ↦ congr($hgC r) }
  have hψ : (ψ : MvPolynomial (Fin d) R →+* A).Etale := hg
  obtain ⟨e, he, hek⟩ := Algebra.TensorProduct.exists_lmul'_eq_one_mul_mem_ofList ψ hψ
  change IsRegularImmersion d (pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R A))))
  rw [diagonal_SpecMap]
  have : IsRegularImmersion d (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom)) := by
    refine isRegularImmersion_specMap (NeZero.ne d) _
      (fun a ↦ ⟨a ⊗ₜ 1, by simp⟩) _ (by simp)
      (Algebra.TensorProduct.isWeaklyRegular_ofFn_one_tmul_sub_tmul_one ψ
        (RingHom.Etale.iff_flat_and_formallyUnramified.mp hψ).1) ?_ e he hek
    refine Ideal.span_le.mpr fun t ht ↦ ?_
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ht
    simp
  infer_instance

/-- The diagonal of a morphism of affine schemes `g : V ⟶ U` whose ring map on global sections
is standard smooth of relative dimension `d > 0` is a regular immersion of pure codimension
`d`. -/
theorem isRegularImmersion_diagonal_of_isAffine {U V : Scheme.{u}} [IsAffine U] [IsAffine V]
    {d : ℕ} [NeZero d] (g : V ⟶ U) (H : g.appTop.hom.IsStandardSmoothOfRelativeDimension d) :
    IsRegularImmersion d (pullback.diagonal g) := by
  have h : g = V.isoSpec.hom ≫ Spec.map g.appTop ≫ U.isoSpec.inv := by
    rw [Scheme.isoSpec_hom_naturality_assoc, Iso.hom_inv_id, Category.comp_id]
  have := isRegularImmersion_diagonal_specMap g.appTop.hom H
  rw [CommRingCat.ofHom_hom] at this
  have := IsRegularImmersion.diagonal_comp_isIso (c := d) (Spec.map g.appTop) U.isoSpec.inv
  rw [h]
  exact IsRegularImmersion.diagonal_isIso_comp _ _

/-- Blueprint `sk-lem-diag-reg`: The diagonal is a regular immersion

Let `f : X ⟶ Y` be smooth and separated of pure relative dimension `d`, let `W = X ×_Y X` and
let `Δ : X ⟶ W` be the diagonal. Then `Δ` is a regular closed immersion of pure codimension
`d`.

Near a point of the diagonal, `f` is a standard smooth morphism `V ⟶ U` of affine opens, so
that `Γ(V)` is étale over `Γ(U)[X₀, …, X_{d-1}]`; the diagonal of `V ⟶ U` is the restriction of
`Δ` to the open `V ×_U V` of `W`, and is cut out by the weakly regular sequence `1 ⊗ Xᵢ - Xᵢ ⊗ 1`
(`AlgebraicGeometry.isRegularImmersion_diagonal_of_isAffine`). Away from the diagonal the ideal
of `Δ` is the unit ideal. This is the étale-local normal form of the blueprint: on the model
`𝔸^d_Y → Y`, the diagonal is the zero section of `𝔸^d`.

The codimension `d` is required to be positive, as in the blueprint's definition of a regular
immersion of pure codimension (`def-pur-regular-immersion`); for `d = 0` the diagonal of an
étale morphism is open and closed, and its ideal is the unit ideal and not the zero ideal
off the diagonal. The blueprint also identifies the normal bundle of `Δ` with the relative
tangent bundle `T_{X/Y}`; Mathlib has no sheaf of relative differentials, and nothing
downstream uses that identification, so it is not stated here. -/
instance isRegularImmersion_diagonal (d : ℕ) [NeZero d] (f : X ⟶ Y) [IsSeparated f]
    [SmoothOfRelativeDimension d f] :
    IsRegularImmersion d (pullback.diagonal f) where
  exists_isWeaklyRegular_generators x := by
    by_cases hx : x ∈ Set.range (pullback.diagonal f)
    swap
    · exact IsRegularImmersion.exists_isWeaklyRegular_generators_of_notMem_range
        (NeZero.ne d) _ hx
    obtain ⟨p, rfl⟩ := hx
    obtain ⟨U, hU, V, hV, hpV, hVU, H⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := f) p
    have : IsAffine U.toScheme := hU
    have : IsAffine V.toScheme := hV
    have H' : (f.resLE U V hVU).appTop.hom.IsStandardSmoothOfRelativeDimension d :=
      (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.arrow_mk_iso_iff
        (arrowResLEAppIso f U V hVU)).mpr H
    have := isRegularImmersion_diagonal_of_isAffine _ H'
    have hpb := isPullback_diagonal_map_of_mono V.ι U.ι (Scheme.Hom.resLE_comp_ι f hVU)
    have key :=
      IsRegularImmersion.exists_isWeaklyRegular_generators_of_isPullback (c := d) hpb
      (pullback.diagonal (f.resLE U V hVU) ⟨p, hpV⟩)
    rwa [← Scheme.Hom.comp_apply, ← hpb.w, Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at key

/-- Restriction maps between affine opens are flat. -/
theorem Scheme.flat_presheaf_map_homOfLE {X : Scheme.{u}} {U V : X.affineOpens}
    (h : U.1 ≤ V.1) : (X.presheaf.map (homOfLE h).op).hom.Flat := by
  have := HasRingHomProperty.appLE @Flat (𝟙 X) inferInstance V U h
  simpa [Scheme.Hom.appLE] using this

namespace IsRegularImmersion

open RingTheory.Sequence

/-- Generators of the ideal of `i` on an affine open `U` restrict to generators on any smaller
affine open, and weak regularity is preserved since restriction maps are flat. -/
theorem isWeaklyRegular_ofList_restrict {i : Z ⟶ X} {U U₀ : X.affineOpens} (h : U₀.1 ≤ U.1)
    {r : List Γ(X, U.1)} (hreg : IsWeaklyRegular Γ(X, U.1) r)
    (hI : Ideal.ofList r = (Scheme.Hom.ker i).ideal U) :
    IsWeaklyRegular Γ(X, U₀.1) (r.map (X.presheaf.map (homOfLE h).op).hom) ∧
      Ideal.ofList (r.map (X.presheaf.map (homOfLE h).op).hom) = (Scheme.Hom.ker i).ideal U₀ :=
  ⟨hreg.map_of_flat (Scheme.flat_presheaf_map_homOfLE h), by
    rw [← Ideal.map_ofList, hI]
    exact Scheme.IdealSheafData.map_ideal _ (U := U₀) (V := U) h⟩

/-- **Composition.** If `i : Z ⟶ Y` and `j : Y ⟶ X` are regular immersions of pure
codimensions `c₁` and `c₂`, then `i ≫ j` is a regular immersion of pure codimension `c₂ + c₁`:
locally the ideal of `Z` in `X` is generated by a regular sequence cutting out `Y` followed by
lifts of a regular sequence cutting out `Z` in `Y`. -/
theorem comp {c₁ c₂ : ℕ} (i : Z ⟶ Y) (j : Y ⟶ X) [IsRegularImmersion c₁ i]
    [IsRegularImmersion c₂ j] : IsRegularImmersion (c₂ + c₁) (i ≫ j) where
  exists_isWeaklyRegular_generators x := by
    obtain ⟨U, hxU, r, hr, hreg, hI⟩ := exists_isWeaklyRegular_generators (c := c₂) (i := j) x
    -- near `x`, the ideal of `i` is generated by a weakly regular sequence over every small
    -- affine open
    have key : ∃ V : X.Opens, x ∈ V ∧ ∀ U₀ : X.affineOpens, U₀.1 ≤ V →
        ∃ s : List Γ(Y, j ⁻¹ᵁ U₀.1), s.length = c₁ ∧ IsWeaklyRegular Γ(Y, j ⁻¹ᵁ U₀.1) s ∧
          Ideal.ofList s = (Scheme.Hom.ker i).ideal ⟨j ⁻¹ᵁ U₀.1, U₀.2.preimage j⟩ := by
      by_cases hx : x ∈ Set.range j
      · obtain ⟨y, rfl⟩ := hx
        obtain ⟨W, hyW, s, hs, hsreg, hsI⟩ :=
          exists_isWeaklyRegular_generators (c := c₁) (i := i) y
        obtain ⟨V, hV, hVW⟩ := j.isEmbedding.isInducing.isOpen_iff.1 W.1.isOpen
        refine ⟨⟨V, hV⟩, show y ∈ j ⁻¹' V from hVW ▸ hyW, fun U₀ hU₀ ↦ ?_⟩
        have hle : j ⁻¹ᵁ U₀.1 ≤ W.1 := fun z hz ↦ by
          change z ∈ (W.1 : Set Y)
          rw [← hVW]
          exact hU₀ hz
        obtain ⟨h₁, h₂⟩ := isWeaklyRegular_ofList_restrict (U₀ := ⟨_, U₀.2.preimage j⟩) hle
          hsreg hsI
        exact ⟨_, by rw [List.length_map, hs], h₁, h₂⟩
      · refine ⟨⟨(Set.range j)ᶜ, j.isClosedEmbedding.isClosed_range.isOpen_compl⟩, hx,
          fun U₀ hU₀ ↦ ?_⟩
        have hempty : j ⁻¹ᵁ U₀.1 = ⊥ := by
          ext z
          simpa using fun hz : j z ∈ U₀.1 ↦ hU₀ hz ⟨z, rfl⟩
        have : Subsingleton Γ(Y, j ⁻¹ᵁ U₀.1) := hempty ▸ inferInstance
        refine ⟨List.replicate c₁ 0, by simp, ?_, ?_⟩
        · rw [isWeaklyRegular_iff_Fin]
          exact fun _ _ _ _ ↦ Subsingleton.elim _ _
        · ext a
          simp [Subsingleton.elim a 0]
    obtain ⟨V, hxV, hV⟩ := key
    obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU₀, hU₀le⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ (U.1 ⊓ V : X.Opens) from ⟨hxU, hxV⟩) (U.1 ⊓ V).isOpen
    have hU₀U : U₀ ≤ U.1 := hU₀le.trans inf_le_left
    obtain ⟨s, hs, hsreg, hsI⟩ := hV ⟨U₀, hU₀⟩ (hU₀le.trans inf_le_right)
    obtain ⟨hr₀reg, hr₀I⟩ := isWeaklyRegular_ofList_restrict (U₀ := ⟨U₀, hU₀⟩) hU₀U hreg hI
    set r₀ := r.map (X.presheaf.map (homOfLE hU₀U).op).hom
    have hφ : Function.Surjective (j.app U₀).hom := j.app_surjective U₀ hU₀
    obtain ⟨t, rfl⟩ := List.map_surjective_iff.2 hφ s
    have hker : RingHom.ker (j.app U₀).hom = Ideal.ofList r₀ := by
      rw [hr₀I, Scheme.Hom.ker_apply j ⟨U₀, hU₀⟩]
    refine ⟨⟨U₀, hU₀⟩, hxU₀, r₀ ++ t, ?_,
      isWeaklyRegular_append_of_surjective _ hφ hr₀reg hker hsreg, ?_⟩
    · rw [List.length_append, List.length_map, hr, ← hs, List.length_map]
    · rw [Scheme.Hom.ker_comp, Scheme.IdealSheafData.ideal_map_of_isAffineHom, ← hsI,
        ← Ideal.map_ofList, Ideal.comap_map_of_surjective _ hφ, ← RingHom.ker_eq_comap_bot,
        hker, Ideal.ofList_append, sup_comm]

end IsRegularImmersion

/-- **Flat base change.** The base change `i' : Z' ⟶ X'` of a regular closed immersion
`i : Z ⟶ X` of pure codimension `c` along a flat morphism `e : X' ⟶ X` is again a regular closed
immersion of pure codimension `c`: a regular sequence stays regular after a flat extension of
scalars, and it still generates the extended ideal. -/
theorem IsRegularImmersion.of_isPullback {Z' X' : Scheme.{u}} (c : ℕ) {i : Z ⟶ X}
    {i' : Z' ⟶ X'} {g : Z' ⟶ Z} {e : X' ⟶ X} (h : IsPullback g i' i e) [IsRegularImmersion c i]
    [Flat e] : IsRegularImmersion c i' := by
  have : IsClosedImmersion i' := MorphismProperty.of_isPullback h inferInstance
  refine { exists_isWeaklyRegular_generators := fun x' ↦ ?_ }
  obtain ⟨U, hxU, r, hr, hreg, hI⟩ := exists_isWeaklyRegular_generators (c := c) (i := i) (e x')
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ := X'.isBasis_affineOpens.exists_subset_of_mem_open
    (show x' ∈ e ⁻¹ᵁ U.1 from hxU) (e ⁻¹ᵁ U.1).isOpen
  refine exists_isWeaklyRegular_generators_of_flat ⟨V, hV⟩ hxV (e.appLE U.1 V hVU).hom
    (HasRingHomProperty.appLE @Flat e ‹_› U ⟨V, hV⟩ hVU) r hr hreg ?_
  rw [hI, Scheme.Hom.ker_of_isPullback i e h,
    Scheme.IdealSheafData.ideal_comap_appLE i.ker e U ⟨V, hV⟩ hVU]

/-- **Exterior products.** For regular closed immersions `i₁ : Z₁ ⟶ X₁` and `i₂ : Z₂ ⟶ X₂` of
pure codimensions `c₁` and `c₂` of schemes over a field `k`, the closed immersion
`Z₁ ×_k Z₂ ⟶ X₁ ×_k X₂` is regular of pure codimension `c₁ + c₂`. It is the composite of
`Z₁ ×_k Z₂ ⟶ Z₁ ×_k X₂` and `Z₁ ×_k X₂ ⟶ X₁ ×_k X₂`, the base changes of `i₂` and `i₁` along the
projections, which are flat because every scheme over a field is flat. -/
theorem IsRegularImmersion.pullback_map {k : Type u} [Field k] {X₁ X₂ Z₁ Z₂ : Scheme.{u}}
    (c₁ c₂ : ℕ) (i₁ : Z₁ ⟶ X₁) (i₂ : Z₂ ⟶ X₂) [IsRegularImmersion c₁ i₁]
    [IsRegularImmersion c₂ i₂] (a₁ : X₁ ⟶ Spec (.of k)) (a₂ : X₂ ⟶ Spec (.of k)) :
    IsRegularImmersion (c₁ + c₂)
      (pullback.map (i₁ ≫ a₁) (i₂ ≫ a₂) a₁ a₂ i₁ i₂ (𝟙 _) (by simp) (by simp)) := by
  have : Subsingleton (Spec (.of k)) := inferInstanceAs (Subsingleton (PrimeSpectrum k))
  let m₂ : pullback (i₁ ≫ a₁) (i₂ ≫ a₂) ⟶ pullback (i₁ ≫ a₁) a₂ :=
    pullback.map _ _ _ _ (𝟙 Z₁) i₂ (𝟙 _) (by simp) (by simp)
  let m₁ : pullback (i₁ ≫ a₁) a₂ ⟶ pullback a₁ a₂ :=
    pullback.map _ _ _ _ i₁ (𝟙 X₂) (𝟙 _) (by simp) (by simp)
  have h₂ : IsPullback (pullback.snd (i₁ ≫ a₁) (i₂ ≫ a₂)) m₂ i₂ (pullback.snd (i₁ ≫ a₁) a₂) :=
    .of_bot (by simpa [m₂] using (IsPullback.of_hasPullback (i₁ ≫ a₁) (i₂ ≫ a₂)).flip)
      (by simp [m₂]) (IsPullback.of_hasPullback (i₁ ≫ a₁) a₂).flip
  have h₁ : IsPullback (pullback.fst (i₁ ≫ a₁) a₂) m₁ i₁ (pullback.fst a₁ a₂) :=
    .of_bot (by simpa [m₁] using IsPullback.of_hasPullback (i₁ ≫ a₁) a₂)
      (by simp [m₁]) (IsPullback.of_hasPullback a₁ a₂)
  have := IsRegularImmersion.of_isPullback c₂ h₂
  have := IsRegularImmersion.of_isPullback c₁ h₁
  have hm : pullback.map (i₁ ≫ a₁) (i₂ ≫ a₂) a₁ a₂ i₁ i₂ (𝟙 _) (by simp) (by simp) = m₂ ≫ m₁ := by
    ext <;> simp [m₁, m₂]
  rw [hm]
  exact IsRegularImmersion.comp m₂ m₁

end AlgebraicGeometry
