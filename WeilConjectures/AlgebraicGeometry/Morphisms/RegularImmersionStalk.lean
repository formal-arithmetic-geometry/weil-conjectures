module

public import WeilConjectures.AlgebraicGeometry.Morphisms.RegularImmersion
public import WeilConjectures.RingTheory.RegularSequenceSpreadOut

/-!
# Regular immersions at the stalks

Blueprint `def-pur-regular-immersion` defines a closed immersion `i : Z ⟶ X` of finite-type
`k`-schemes to be regular of pure codimension `c` stalkwise: for every `z ∈ Z`, the ideal of `Z`
in `𝒪_{X,z}` is generated by a regular sequence of length `c`, and `dim 𝒪_{X,z} = dim 𝒪_{Z,z} + c`.
The repository's `AlgebraicGeometry.IsRegularImmersion` asks for generation by a weakly regular
sequence of length `c` on affine neighbourhoods. This file shows that it gives the blueprint's
stalkwise conditions on a locally Noetherian `X`
(`AlgebraicGeometry.IsRegularImmersion.exists_isRegular_stalk_and_ringKrullDim`): the generators
pass to the flat localization `𝒪_{X,i(z)}`, where they lie in the maximal ideal and hence form a
regular sequence, generating the kernel of `𝒪_{X,i(z)} ⟶ 𝒪_{Z,z}`, and cutting by a regular
sequence of length `c` lowers the dimension by exactly `c`.

Conversely (`AlgebraicGeometry.IsRegularImmersion.of_stalk`), on a locally Noetherian `X` a
stalkwise regular sequence spreads out to an affine neighbourhood, so that the two definitions
agree.
-/

@[expose] public section

universe u

open CategoryTheory RingTheory.Sequence

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}}

/-- Regular closed immersion of pure codimension

Let `i: Z ⟶ X` be a regular immersion of pure codimension `c` (`IsRegularImmersion c i`) with
`X` locally Noetherian. Then, at every point `z ∈ Z`, the ideal of `Z` in `𝒪_{X,i(z)}` (the kernel
of `𝒪_{X,i(z)} ⟶ 𝒪_{Z,z}`) is generated by a regular sequence of length `c`, and `Z` has pure
codimension `c` in `X`: `dim 𝒪_{X,i(z)} = dim 𝒪_{Z,z} + c`. -/
theorem IsRegularImmersion.exists_isRegular_stalk_and_ringKrullDim [IsLocallyNoetherian X]
    (c : ℕ) (i : Z ⟶ X) [IsRegularImmersion c i] (z : Z) :
    (∃ r : List (X.presheaf.stalk (i z)), r.length = c ∧
      RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z)) r ∧
      Ideal.ofList r = RingHom.ker (i.stalkMap z).hom) ∧
    ringKrullDim (X.presheaf.stalk (i z)) =
      ringKrullDim (Z.presheaf.stalk z) + (c : WithBot ℕ∞) := by
  obtain ⟨U, hxU, r, hlen, hreg, hI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators (c := c) (i := i) (i z)
  subst hlen
  let := X.presheaf.algebra_section_stalk ⟨i z, hxU⟩
  have := U.2.isLocalization_stalk ⟨i z, hxU⟩
  have : Module.Flat Γ(X, U.1) (X.presheaf.stalk (i z)) :=
    IsLocalization.flat _ (U.2.primeIdealOf ⟨i z, hxU⟩).asIdeal.primeCompl
  have hsupp : i z ∈ X.zeroLocus (U := U.1) (i.ker.ideal U) :=
    (Scheme.IdealSheafData.mem_support_iff_of_mem hxU).mp
      (i.range_subset_ker_support ⟨z, rfl⟩)
  have hreg' : RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z))
      (r.map (algebraMap Γ(X, U.1) (X.presheaf.stalk (i z)))) := by
    refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).mpr
      hreg.of_flat
    intro _ hs'
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hs'
    have : s ∈ i.ker.ideal U := hI ▸ Ideal.subset_span hs
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (X.mem_basicOpen _ _ hxU).not.mp ((X.mem_zeroLocus_iff _ _).mp hsupp s this)
  have hker : Ideal.ofList (r.map (algebraMap Γ(X, U.1) (X.presheaf.stalk (i z)))) =
      RingHom.ker (i.stalkMap z).hom := by
    rw [← Ideal.map_ofList, hI,
      show algebraMap Γ(X, U.1) _ = (X.presheaf.germ U (i z) hxU).hom from rfl,
      ← i.ker_stalkMap U z hxU]
  refine ⟨⟨_, List.length_map _, hreg', hker⟩, ?_⟩
  have key := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hreg'
  rw [hker, ringKrullDim_eq_of_ringEquiv
      (RingHom.quotientKerEquivOfSurjective (i.stalkMap_surjective z)), List.length_map] at key
  exact key.symm

/-- Regular closed immersion of pure codimension

**The stalkwise definition implies the repository's.** Let `i: Z ⟶ X` be a closed immersion
with `X` locally Noetherian and `c ≥ 1`, such that at every point `z ∈ Z` the ideal of `Z` in
`𝒪_{X,i(z)}` is generated by a (weakly) regular sequence of length `c`. Then `i` is a regular
immersion of pure codimension `c` (`AlgebraicGeometry.IsRegularImmersion`): on an affine open
`U ∋ i(z)` with ring `R = Γ(X, U)`, lift the sequence to `R` up to units; it stays weakly
regular on `R_g` and generates the ideal of `Z` there for some `g` outside the prime of `i(z)`
(`RingTheory.Sequence.exists_isWeaklyRegular_of_isLocalizedModule`,
`Ideal.exists_map_eq_map_of_map_eq_map`), and `D(g) ⊆ U` is the required affine neighbourhood.
Together with `AlgebraicGeometry.IsRegularImmersion.exists_isRegular_stalk_and_ringKrullDim`,
the two definitions agree on locally Noetherian schemes. -/
theorem IsRegularImmersion.of_stalk [IsLocallyNoetherian X] (c : ℕ) (hc : c ≠ 0)
    (i : Z ⟶ X) [IsClosedImmersion i]
    (h : ∀ z : Z, ∃ r : List (X.presheaf.stalk (i z)), r.length = c ∧
      IsWeaklyRegular (X.presheaf.stalk (i z)) r ∧
      Ideal.ofList r = RingHom.ker (i.stalkMap z).hom) :
    IsRegularImmersion c i where
  exists_isWeaklyRegular_generators x := by
    by_cases hx : x ∈ Set.range i
    swap
    · exact IsRegularImmersion.exists_isWeaklyRegular_generators_of_notMem_range hc i hx
    obtain ⟨z, rfl⟩ := hx
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i z)) isOpen_univ
    let U' : X.affineOpens := ⟨U, hU⟩
    have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian U'
    let := X.presheaf.algebra_section_stalk ⟨i z, hxU⟩
    let p := (hU.primeIdealOf ⟨i z, hxU⟩).asIdeal
    have := hU.isLocalization_stalk ⟨i z, hxU⟩
    obtain ⟨r, hlen, hreg, hker⟩ := h z
    rw [i.ker_stalkMap U' z hxU,
      show (X.presheaf.germ U (i z) hxU).hom = algebraMap Γ(X, U) _ from rfl] at hker
    -- lift the sequence to `Γ(X, U)` up to units
    have hlift : ∀ s : X.presheaf.stalk (i z), ∃ a : Γ(X, U),
        Associated s (algebraMap Γ(X, U) (X.presheaf.stalk (i z)) a) := by
      intro s
      obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl s
      exact ⟨a, ⟨(IsLocalization.map_units (X.presheaf.stalk (i z)) t).unit,
        IsLocalization.mk'_spec _ a t⟩⟩
    choose lift hlift using hlift
    let a := r.map lift
    have hassoc : List.Forall₂ Associated r (a.map (algebraMap Γ(X, U) _)) := by
      simp only [a, List.map_map, List.forall₂_map_right_iff]
      exact List.forall₂_same.2 fun s _ ↦ hlift s
    have hreg' := isWeaklyRegular_of_forall₂_associated r hassoc hreg
    have hspan : (Ideal.ofList a).map (algebraMap Γ(X, U) (X.presheaf.stalk (i z))) =
        (i.ker.ideal U').map (algebraMap Γ(X, U) (X.presheaf.stalk (i z))) := by
      rw [Ideal.map_ofList, ← ofList_eq_of_forall₂_associated hassoc, hker]
    obtain ⟨g₁, hg₁p, hg₁⟩ := Ideal.exists_map_eq_map_of_map_eq_map p _ _ hspan
    obtain ⟨g₂, hg₂p, hg₂⟩ := exists_isWeaklyRegular_of_isLocalizedModule p a
      (Algebra.linearMap Γ(X, U) (X.presheaf.stalk (i z))) hreg'
    have hgp : g₁ * g₂ ∉ p := fun h ↦ (Ideal.IsPrime.mem_or_mem inferInstance h).elim hg₁p hg₂p
    have := hU.isLocalization_basicOpen (g₁ * g₂)
    have hu : IsUnit (algebraMap Γ(X, U) Γ(X, X.basicOpen (g₁ * g₂)) (g₁ * g₂)) :=
      IsLocalization.Away.algebraMap_isUnit (g₁ * g₂)
    rw [map_mul] at hu
    have hmem : i z ∈ (X.affineBasicOpen (U := U') (g₁ * g₂)).1 := by
      change i z ∈ X.basicOpen (g₁ * g₂)
      rw [X.mem_basicOpen _ _ hxU]
      exact (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk (i z)) p _).2 hgp
    have hreg₂ : IsWeaklyRegular Γ(X, X.basicOpen (g₁ * g₂))
        (a.map (algebraMap Γ(X, U) Γ(X, X.basicOpen (g₁ * g₂)))) :=
      hg₂ (.powers (g₁ * g₂)) Γ(X, X.basicOpen (g₁ * g₂)) Γ(X, X.basicOpen (g₁ * g₂))
        (Algebra.linearMap _ _) (isUnit_of_mul_isUnit_right hu)
    have hI₂ : Ideal.ofList (a.map (algebraMap Γ(X, U) Γ(X, X.basicOpen (g₁ * g₂)))) =
        i.ker.ideal (X.affineBasicOpen (U := U') (g₁ * g₂)) := by
      rw [← Ideal.map_ofList, hg₁ (.powers (g₁ * g₂)) _ (isUnit_of_mul_isUnit_left hu)]
      exact i.ker.map_ideal_basicOpen U' (g₁ * g₂)
    exact ⟨X.affineBasicOpen (U := U') (g₁ * g₂), hmem,
      a.map (algebraMap Γ(X, U) Γ(X, X.basicOpen (g₁ * g₂))),
      by simpa [a] using hlen, hreg₂, hI₂⟩

end AlgebraicGeometry
