module

public import WeilConjectures.AlgebraicGeometry.Morphisms.RegularImmersion

/-!
# Regular immersions at the stalks

Blueprint `def-pur-regular-immersion` defines a closed immersion `i : Z ⟶ X` of finite-type
`k`-schemes to be regular of pure codimension `c` stalkwise: for every `z ∈ Z`, the ideal of `Z`
in `𝒪_{X,z}` is generated by a regular sequence of length `c`, and `dim 𝒪_{X,z} = dim 𝒪_{Z,z} + c`.
The repository's `AlgebraicGeometry.IsRegularImmersion` asks for generation by a weakly regular
sequence of length `c` on affine neighbourhoods. This file shows that it gives the blueprint's
stalkwise conditions on a locally Noetherian `X`
(`AlgebraicGeometry.IsRegularImmersion.exists_isRegular_stalk_and_ringKrullDim`): the generators
pass to the flat localization `𝒪_{X,i(z)}`, where they lie in the maximal ideal and hence form a
regular sequence, generating the kernel of `𝒪_{X,i(z)} ⟶ 𝒪_{Z,z}`, and cutting by a regular
sequence of length `c` lowers the dimension by exactly `c`.

The converse (a stalkwise regular sequence spreads out to an affine neighbourhood on a locally
Noetherian `X`), the other half of the equivalence of the two definitions, is not formalised.
-/

@[expose] public section

universe u

open CategoryTheory RingTheory.Sequence

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}}

/-- Blueprint `def-pur-regular-immersion`: Regular closed immersion of pure codimension

Let `i : Z ⟶ X` be a regular immersion of pure codimension `c` (`IsRegularImmersion c i`) with
`X` locally Noetherian. Then, at every point `z ∈ Z`, the ideal of `Z` in `𝒪_{X,i(z)}` (the kernel
of `𝒪_{X,i(z)} ⟶ 𝒪_{Z,z}`) is generated by a regular sequence of length `c`, and `Z` has pure
codimension `c` in `X`: `dim 𝒪_{X,i(z)} = dim 𝒪_{Z,z} + c`. -/
theorem IsRegularImmersion.exists_isRegular_stalk_and_ringKrullDim [IsLocallyNoetherian X]
    (c : ℕ) (i : Z ⟶ X) [IsRegularImmersion c i] (z : Z) :
    (∃ r : List (X.presheaf.stalk (i z)), r.length = c ∧
      RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z)) r ∧
      Ideal.ofList r = RingHom.ker (i.stalkMap z).hom) ∧
    ringKrullDim (X.presheaf.stalk (i z)) =
      ringKrullDim (Z.presheaf.stalk z) + (c : WithBot ℕ∞) := by
  obtain ⟨U, hxU, r, hlen, hreg, hI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators (c := c) (i := i) (i z)
  subst hlen
  let := X.presheaf.algebra_section_stalk ⟨i z, hxU⟩
  have := U.2.isLocalization_stalk ⟨i z, hxU⟩
  have : Module.Flat Γ(X, U.1) (X.presheaf.stalk (i z)) :=
    IsLocalization.flat _ (U.2.primeIdealOf ⟨i z, hxU⟩).asIdeal.primeCompl
  have hsupp : i z ∈ X.zeroLocus (U := U.1) (i.ker.ideal U) :=
    (Scheme.IdealSheafData.mem_support_iff_of_mem hxU).mp
      (i.range_subset_ker_support ⟨z, rfl⟩)
  have hreg' : RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z))
      (r.map (algebraMap Γ(X, U.1) (X.presheaf.stalk (i z)))) := by
    refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).mpr
      hreg.of_flat
    intro _ hs'
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hs'
    have : s ∈ i.ker.ideal U := hI ▸ Ideal.subset_span hs
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (X.mem_basicOpen _ _ hxU).not.mp ((X.mem_zeroLocus_iff _ _).mp hsupp s this)
  have hker : Ideal.ofList (r.map (algebraMap Γ(X, U.1) (X.presheaf.stalk (i z)))) =
      RingHom.ker (i.stalkMap z).hom := by
    rw [← Ideal.map_ofList, hI,
      show algebraMap Γ(X, U.1) _ = (X.presheaf.germ U (i z) hxU).hom from rfl,
      ← i.ker_stalkMap U z hxU]
  refine ⟨⟨_, List.length_map _, hreg', hker⟩, ?_⟩
  have key := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hreg'
  rw [hker, ringKrullDim_eq_of_ringEquiv
      (RingHom.quotientKerEquivOfSurjective (i.stalkMap_surjective z)), List.length_map] at key
  exact key.symm

end AlgebraicGeometry
