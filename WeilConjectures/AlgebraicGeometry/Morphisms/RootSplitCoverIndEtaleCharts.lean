/-! # Cyclic root charts over the strict local limit

Source: Stacks Project, Tag 0EYG.
(blueprint: lem-sbc-root-split-cover-ind-etale-charts)
-/

@[expose] public section

universe u
set_option autoImplicit false
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

/-- The affine finite-presentation cover has a cyclic root model over an ind-etale local limit.

Source: Stacks Project, Tag 0EYG, strict henselization and intermediate-root paragraphs;
Tags 02LA and 02VN for descent from the punctured root cover.
(blueprint: lem-sbc-root-split-cover-ind-etale-charts)

Proof: Put U=D(g). The punctured root cover V→U is finite free of positive rank n.
The root and n are units there, so its derivative is a unit and the cover is etale.
It is faithfully flat. Descend the given trivial finite etale cover along V→U to
see that the factor j:Y→U is finite etale. Thus Y is affine and finitely presented
as an R-scheme: U is the spectrum of the one-element localization of R, and j is
finite and finitely presented. In particular p is affine and locally of finite
presentation, which are the two properties required by the later descent step.

Take H to be the strict henselization of R at y, with structural map ι and its closed
point x. The map ι is ind-etale and Spec(ι)(x)=y. Flatness preserves regular
multiplication by g; regularity of R and R/(g) passes to the strict henselization.
The image of g is in the maximal ideal and is prime, since H/(g) is a regular local
domain. The algebra C=H[t]/(t^n-ι(g)) is local: its closed fibre has the only prime
(t). It is strictly henselian, t is regular, and C/(t)=H/(g) is regular, so C is a
regular local domain. Its puncture is connected and normal. Hensel lifting the
simple residue roots of X^n-1 gives the n-th roots of unity in H and a cyclic group
G of order n. The action t↦ζt makes the punctured root cover a connected G-torsor.

Pull the supplied splitting to H. Its descent data give a permutation action of G
on Fin d. Decompose this finite set into orbits, indexed by Fin m. An orbit length
e(k) is positive and divides n, hence is a unit in H. Its stabilizer fixes
s=t^(n/e(k)). Eisenstein at (g) identifies the intermediate fraction field as the
field generated by s, of degree e(k). The algebra H[s]/(s^e(k)-ι(g)) is regular
local, and its puncture is normal. Both it and the orbit cover are the integral
closure of H[1/g] in that field, giving the isomorphism over H[1/g]. Taking the
finite product of the root algebras gives γ and its projection identity. This
calculation stops at the ind-etale limit; it asserts no etale finite-stage model.

Edge cases: d=0 gives m=0 and the empty spectrum of the empty product. For n=1,
all nonempty orbits have size one. The condition g∈y rules out the zero base ring
and a unit divisor, and ensures the strict local puncture is the one in the proof. -/
theorem root_split_cover_indEtale_charts
    (R : CommRingCat.{u}) (g : R) (n : ℕ) (hn : 0 < n ∧ IsUnit (n : R))
    [IsRegularRing R] (hg : IsSMulRegular R g)
    [IsRegularRing (R ⧸ Ideal.span {g})]
    {Y : Scheme.{u}} (p : Y ⟶ Spec R)
    (hj : ∃ j : Y ⟶ Scheme.Opens.toScheme (X := Spec R) (PrimeSpectrum.basicOpen g),
      j ≫ Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g) = p)
    (d : ℕ) (y : Spec R) (hy : g ∈ y.asIdeal) :
    let A := AdjoinRoot ((Polynomial.X : Polynomial R) ^ n - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let q := Spec.map (CommRingCat.ofHom (algebraMap R A))
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap R A g)
    ∀ (δ : pullback p (V.ι ≫ q) ≅ ∐ fun _ : Fin d ↦ V.toScheme),
      δ.hom ≫ Sigma.desc (fun _ : Fin d ↦ 𝟙 V.toScheme) =
        pullback.snd p (V.ι ≫ q) →
    (IsAffineHom p ∧ LocallyOfFinitePresentation p) ∧
    ∃ (H : CommRingCat.{u}) (ι : R →+* H) (x : Spec H),
      ι.IndEtale ∧
      (Spec.map (CommRingCat.ofHom ι)) x = y ∧
      ∃ (m : ℕ) (e : Fin m → ℕ),
        (∀ k, 0 < e k ∧ IsUnit (e k : H)) ∧
        let N := Spec (CommRingCat.of (∀ k : Fin m,
          AdjoinRoot ((Polynomial.X : Polynomial H) ^ e k - Polynomial.C (ι g))))
        let q := Spec.map (CommRingCat.ofHom
          (algebraMap H (∀ k : Fin m,
            AdjoinRoot ((Polynomial.X : Polynomial H) ^ e k - Polynomial.C (ι g)))))
        let V : N.Opens := PrimeSpectrum.basicOpen
          (algebraMap H (∀ k : Fin m,
            AdjoinRoot ((Polynomial.X : Polynomial H) ^ e k - Polynomial.C (ι g))) (ι g))
        ∃ γ : pullback p (Spec.map (CommRingCat.ofHom ι)) ≅ V.toScheme,
          γ.hom ≫ V.ι ≫ q = pullback.snd p (Spec.map (CommRingCat.ofHom ι)) := by
  dsimp only
  intro δ hδ
  obtain ⟨j, hj⟩ := hj
  obtain ⟨hjFinite, hjEtale⟩ :=
    root_split_factor_finite_etale R g n hn p j hj d δ hδ
  have : IsFinite j := hjFinite
  have : Etale j := hjEtale
  have hbasic : IsAffineHom
      (Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g)) := by
    rw [← basicOpen_eq_of_affine g]
    infer_instance
  have : IsAffineHom
      (Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g)) := hbasic
  have hp : IsAffineHom p ∧ LocallyOfFinitePresentation p := by
    rw [← hj]
    exact ⟨inferInstance, inferInstance⟩
  obtain ⟨H, ι, hι, hH, hreg, hquot, hgH, hgm, x, hx⟩ :=
    regular_divisor_strict_local_limit R g hg y hy
  have : IsStrictlyHenselianLocalRing H := hH
  have : IsRegularLocalRing H := hreg
  have : IsRegularLocalRing (H ⧸ Ideal.span {ι g}) := hquot
  obtain ⟨m, e, he, γ, hγ⟩ :=
    root_split_strict_local_orbits R H g ι hgH hgm n hn p j hj d δ hδ
  have hnH : IsUnit (n : H) := by
    simpa only [map_natCast] using hn.2.map ι
  have heUnit : ∀ k, 0 < e k ∧ IsUnit (e k : H) := by
    intro k
    obtain ⟨a, ha⟩ := (he k).2
    have hdvd : (e k : H) ∣ (n : H) := by
      refine ⟨(a : H), ?_⟩
      simpa only [Nat.cast_mul] using congrArg (fun t : ℕ ↦ (t : H)) ha
    exact ⟨(he k).1, isUnit_of_dvd_unit hdvd hnH⟩
  exact ⟨hp, H, ι, x, hι, hx, m, e, heUnit, γ, hγ⟩

end AlgebraicGeometry.Scheme
