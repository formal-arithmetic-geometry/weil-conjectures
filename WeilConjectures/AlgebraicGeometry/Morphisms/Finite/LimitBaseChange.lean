/-!
# Finiteness of a base change descends to a stage of a limit

Let `{Dᵢ}` be a cofiltered system of quasi-compact quasi-separated schemes with affine
transition morphisms and limit `D_∞ = lim Dᵢ`, and let `p : Y ⟶ Dᵢ` be quasi-compact,
quasi-separated and locally of finite type. If the base change `Y ×_{Dᵢ} D_∞ ⟶ D_∞` is finite,
then so is the base change `Y ×_{Dᵢ} Dⱼ ⟶ Dⱼ` for some `j ⟶ i`
(`AlgebraicGeometry.Scheme.exists_isFinite_pullback_snd_of_isLimit`).

We also record that the base change of a limit diagram over a scheme `S` along a morphism
`T ⟶ S` is again a limit diagram (`AlgebraicGeometry.isLimitBaseChangeOverFamilyCone`).

## Implementation details

Over an affine open of `Dᵢ` the base changes are eventually affine, with rings
`Bⱼ = Bᵢ ⊗_{Rᵢ} Rⱼ` and `B_∞ = colim Bⱼ`. The finitely many algebra generators of `Bᵢ` over `Rᵢ`
are integral over `R_∞ = colim Rⱼ` in `B_∞`; their monic equations have coefficients in some
`Rⱼ` and hold in some later `Bⱼ`, which is then generated by integral elements over `Rⱼ`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace CommRingCat

/-- Let `X` be the pushout of `f : R ⟶ A` and `g : R ⟶ B`. If `A` is generated as an `R`-algebra
by a finite set `s` whose images in `X` are integral over `B`, then `B ⟶ X` is finite. -/
lemma finite_of_isPushout {R A B X : CommRingCat.{u}} {f : R ⟶ A} {g : R ⟶ B} {a : A ⟶ X}
    {b : B ⟶ X} (H : IsPushout f g a b) {s : Set A} (hs : s.Finite)
    (hgen : letI := f.hom.toAlgebra; Algebra.adjoin R s = ⊤)
    (hint : ∀ x ∈ s, b.hom.IsIntegralElem (a.hom x)) : b.hom.Finite := by
  let := f.hom.toAlgebra
  let := b.hom.toAlgebra
  let C := Algebra.adjoin B (a.hom '' s)
  have ha (x : A) : a.hom x ∈ C := by
    have hx : x ∈ Algebra.adjoin R s := hgen ▸ Algebra.mem_top
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
    | algebraMap r =>
      have : a.hom (algebraMap R A r) = algebraMap B X (g.hom r) := by
        change (f ≫ a).hom r = (g ≫ b).hom r
        rw [H.w]
      rw [this]
      exact C.algebraMap_mem _
    | add x y _ _ hx hy => rw [map_add]; exact C.add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact C.mul_mem hx hy
  have hle : Subring.closure (Set.range a.hom ∪ Set.range b.hom) ≤ C.toSubring :=
    Subring.closure_le.mpr (Set.union_subset (Set.range_subset_iff.mpr ha)
      (Set.range_subset_iff.mpr fun y ↦ C.algebraMap_mem y))
  have hC : C = ⊤ := by
    refine eq_top_iff.mpr fun x _ ↦ hle ?_
    rw [closure_range_union_range_eq_top_of_isPushout H]
    exact Subring.mem_top x
  have hfg := fg_adjoin_of_finite (R := B) (hs.image a.hom) (by
    rintro _ ⟨x, hx, rfl⟩
    exact hint x hx)
  change Module.Finite B X
  refine ⟨?_⟩
  have h : Subalgebra.toSubmodule C = ⊤ := by rw [hC, Algebra.top_toSubmodule]
  rw [← h]
  exact hfg

end CommRingCat

namespace AlgebraicGeometry

/-- Finiteness of the base change along a composite is finiteness of an iterated base change. -/
lemma isFinite_pullback_snd_comp_iff {X Y Z W : Scheme.{u}} (p : Y ⟶ Z) (g : X ⟶ Z)
    (h : W ⟶ X) :
    IsFinite (pullback.snd p (h ≫ g)) ↔ IsFinite (pullback.snd (pullback.snd p g) h) := by
  rw [← pullbackLeftPullbackSndIso_hom_snd p g h,
    MorphismProperty.cancel_left_of_respectsIso @IsFinite]

section BaseChangeOver

variable {I : Type*} [Category* I] (D : I ⥤ Scheme.{u}) (c : Cone D) {S T : Scheme.{u}}
  (q : ∀ j, D.obj j ⟶ S) (hq : ∀ {j j'} (u : j ⟶ j'), D.map u ≫ q j' = q j)
  (q₀ : c.pt ⟶ S) (hq₀ : ∀ j, c.π.app j ≫ q j = q₀) (f : T ⟶ S)

/-- The base change `{ T ×_S Dⱼ }` of a diagram `{ Dⱼ }` of schemes over `S` along
`f : T ⟶ S`. -/
@[simps] noncomputable def baseChangeOverFamilyDiagram : I ⥤ Scheme.{u} where
  obj j := pullback f (q j)
  map {j j'} u := pullback.map f (q j) f (q j') (𝟙 T) (D.map u) (𝟙 S) (by simp)
    (by simp [hq u])
  map_id j := by apply pullback.hom_ext <;> simp
  map_comp u v := by apply pullback.hom_ext <;> simp

/-- The cone with point `T ×_S lim Dⱼ` over the base changed diagram
`AlgebraicGeometry.baseChangeOverFamilyDiagram`. -/
@[simps] noncomputable def baseChangeOverFamilyCone :
    Cone (baseChangeOverFamilyDiagram D q hq f) where
  pt := pullback f q₀
  π.app j := pullback.map f q₀ f (q j) (𝟙 T) (c.π.app j) (𝟙 S) (by simp) (by simp [hq₀ j])
  π.naturality {j j'} u := by apply pullback.hom_ext <;> simp

/-- **Base change of a connected limit over a base.** If `lim Dⱼ` is a connected limit of
schemes over `S`, then `T ×_S lim Dⱼ` is the limit of the schemes `T ×_S Dⱼ`. -/
noncomputable def isLimitBaseChangeOverFamilyCone [IsConnected I] (hc : IsLimit c) :
    IsLimit (baseChangeOverFamilyCone D c q hq q₀ hq₀ f) :=
  isLimitOfIsPullbackOfIsConnected (F := baseChangeOverFamilyDiagram D q hq f) (G := D)
    (NatTrans.mk (fun j ↦ pullback.snd f (q j)) (by intros; simp)) _ c
    { hom := pullback.snd f q₀
      w := fun j ↦ by simp }
    (fun j ↦ isPullback_pullback_map f q₀ (q j) (c.π.app j) (hq₀ j)) hc

lemma isPullback_baseChangeOverFamilyDiagram_map {j j' : I} (u : j ⟶ j') :
    IsPullback ((baseChangeOverFamilyDiagram D q hq f).map u) (pullback.snd f (q j))
      (pullback.snd f (q j')) (D.map u) :=
  isPullback_pullback_map f (q j) (q j') (D.map u) (hq u)

instance [∀ {i j : I} (u : i ⟶ j), IsAffineHom (D.map u)] {j j' : I} (u : j ⟶ j') :
    IsAffineHom ((baseChangeOverFamilyDiagram D q hq f).map u) :=
  MorphismProperty.of_isPullback (P := @IsAffineHom)
    (isPullback_baseChangeOverFamilyDiagram_map D q hq f u).flip inferInstance

end BaseChangeOver

section Descent

variable {I : Type u} [Category.{u} I] [IsCofiltered I] {D : I ⥤ Scheme.{u}} {c : Cone D}
  (hc : IsLimit c)

include hc in
/-- (Implementation) The coefficients of a polynomial over the global sections of a limit of
affine schemes come from a common stage. -/
lemma exists_coeff_mem_range_appTop [∀ i, IsAffine (D.obj i)] (i₀ : I)
    (P : Polynomial Γ(c.pt, ⊤)) :
    ∃ (j : I) (_ : j ⟶ i₀), ∀ n, P.coeff n ∈ Set.range (c.π.app j).appTop.hom := by
  classical
  have (n : ℕ) : ∃ (j : I) (t : Γ(D.obj j, ⊤)), (c.π.app j).appTop t = P.coeff n :=
    exists_appTop_π_eq_of_isAffine_of_isLimit D c hc _
  choose j t ht using this
  obtain ⟨k, hk⟩ := IsCofiltered.inf_objs_exists (insert i₀ (P.support.image j))
  refine ⟨k, (hk (Finset.mem_insert_self _ _)).some, fun n ↦ ?_⟩
  by_cases hn : n ∈ P.support
  · obtain ⟨u⟩ := hk (Finset.mem_insert_of_mem (Finset.mem_image_of_mem j hn))
    refine ⟨(D.map u).appTop (t n), ?_⟩
    rw [← ht n, ← c.w u, Scheme.Hom.comp_appTop]
    rfl
  · rw [Polynomial.notMem_support_iff.mp hn]
    exact ⟨0, map_zero _⟩

include hc in
/-- (Implementation) The affine case of
`AlgebraicGeometry.Scheme.exists_isFinite_pullback_snd_of_isLimit`: the stages and `Y` are
affine. -/
lemma exists_isFinite_pullback_snd_of_isAffine_of_isAffine [∀ i, IsAffine (D.obj i)] {i : I}
    {Y : Scheme.{u}} [IsAffine Y] (p : Y ⟶ D.obj i) [LocallyOfFiniteType p]
    [IsFinite (pullback.snd p (c.π.app i))] :
    ∃ (j : I) (f : j ⟶ i), IsFinite (pullback.snd p (D.map f)) := by
  classical
  have : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := fun f ↦ isAffineHom_of_isAffine _
  have := isAffineHom_π_app D c hc
  have : IsAffine c.pt := isAffine_of_isAffineHom (X := c.pt) (c.π.app i)
  have : IsAffine (((Functor.const I).obj c.pt).obj i) := inferInstanceAs (IsAffine c.pt)
  let D' := baseChangeDiagram D p
  let c' := baseChangeCone D c p
  have hc' : IsLimit c' := isLimitBaseChangeCone D c p hc
  have (j : Over i) : IsAffine (D'.obj j) :=
    inferInstanceAs (IsAffine (pullback p (D.map j.hom)))
  let φ (j : Over i) : Γ(D.obj j.left, ⊤) ⟶ Γ(D'.obj j, ⊤) :=
    (pullback.snd p (D.map j.hom)).appTop
  let ψ (j : Over i) : Γ(Y, ⊤) ⟶ Γ(D'.obj j, ⊤) := (pullback.fst p (D.map j.hom)).appTop
  have hψ {j j' : Over i} (u : j' ⟶ j) (x : Γ(Y, ⊤)) :
      (D'.map u).appTop.hom ((ψ j).hom x) = (ψ j').hom x := by
    simp only [ψ, ← elementwise_of% Scheme.Hom.comp_appTop, D', baseChangeDiagram_map_fst]
  have hφ {j j' : Over i} (u : j' ⟶ j) :
      (D'.map u).appTop.hom.comp (φ j).hom = (φ j').hom.comp (D.map u.left).appTop.hom := by
    simp only [φ, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, D',
      baseChangeDiagram_map_snd]
  -- the generators become integral at some stage
  let Q (x : Γ(Y, ⊤)) (j : Over i) : Prop := (φ j).hom.IsIntegralElem ((ψ j).hom x)
  have hstep (x : Γ(Y, ⊤)) {j j' : Over i} (u : j' ⟶ j) (P : Polynomial Γ(D.obj j.left, ⊤))
      (hPm : P.Monic) (hP : (D'.map u).appTop.hom (P.eval₂ (φ j).hom ((ψ j).hom x)) = 0) :
      Q x j' := by
    refine ⟨P.map (D.map u.left).appTop.hom, hPm.map _, ?_⟩
    rw [Polynomial.eval₂_map, ← hφ, ← hψ u, ← Polynomial.hom_eval₂]
    exact hP
  have hQmono (x : Γ(Y, ⊤)) {j j' : Over i} (u : j' ⟶ j) (h : Q x j) : Q x j' := by
    obtain ⟨P, hPm, hP⟩ := h
    exact hstep x u P hPm (by rw [hP, map_zero])
  have hQex (x : Γ(Y, ⊤)) : ∃ j, Q x j := by
    let xinf := (pullback.fst p (c.π.app i)).appTop.hom x
    obtain ⟨P, hPm, hP⟩ :=
      (pullback.snd p (c.π.app i)).finite_appTop.to_isIntegral xinf
    obtain ⟨j₁, u, hj₁⟩ := exists_coeff_mem_range_appTop hc i P
    obtain ⟨R, hRP, hRm⟩ : ∃ R : Polynomial Γ(D.obj j₁, ⊤),
        R.map (c.π.app j₁).appTop.hom = P ∧ R.Monic := by
      rcases subsingleton_or_nontrivial Γ(c.pt, ⊤) with h | h
      · exact ⟨1, (show Subsingleton (Polynomial Γ(c.pt, ⊤)) from inferInstance).elim _ _,
          Polynomial.monic_one⟩
      · have : Nontrivial Γ(((Functor.const I).obj c.pt).obj i, ⊤) := h
        obtain ⟨R, hR, -, hRm⟩ := Polynomial.lifts_and_degree_eq_and_monic
          ((Polynomial.lifts_iff_coeff_lifts P).mpr hj₁) hPm
        exact ⟨R, hR, hRm⟩
    let J : Over i := Over.mk u
    let z := R.eval₂ (φ J).hom ((ψ J).hom x)
    have hz : (c'.π.app J).appTop.hom z = 0 := by
      have e1 : (c'.π.app J).appTop.hom ((ψ J).hom x) = xinf := by
        change ((pullback.fst p (D.map J.hom)).appTop ≫ (c'.π.app J).appTop).hom x = _
        rw [← Scheme.Hom.comp_appTop, baseChangeCone_π_app_fst]
        rfl
      have e2 : (c'.π.app J).appTop.hom.comp (φ J).hom =
          (pullback.snd p (c.π.app i)).appTop.hom.comp (c.π.app j₁).appTop.hom := by
        simp only [φ, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, c',
          baseChangeCone_π_app_snd]
        rfl
      rw [Polynomial.hom_eval₂, e1, e2, ← Polynomial.eval₂_map, hRP]
      exact hP
    obtain ⟨J', v, hv⟩ := exists_appTop_map_eq_zero_of_isAffine_of_isLimit D' c' hc' J z hz
    exact ⟨J', hstep x v R hRm hv⟩
  -- generators of the sections of `Y`
  obtain ⟨s, hs⟩ : ∃ s : Finset Γ(Y, ⊤),
      letI := p.appTop.hom.toAlgebra
      Algebra.adjoin Γ(D.obj i, ⊤) (↑s : Set Γ(Y, ⊤)) = ⊤ := by
    have h := (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType) (f := p)).mp
      inferInstance
    let := p.appTop.hom.toAlgebra
    exact h.out
  choose j hj using hQex
  obtain ⟨k, hk⟩ := IsCofiltered.inf_objs_exists (s.image j)
  refine ⟨k.left, k.hom, ?_⟩
  rw [HasAffineProperty.iff_of_isAffine (P := @IsFinite)]
  exact ⟨inferInstance, CommRingCat.finite_of_isPushout
    (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback p (D.map k.hom)))
    s.finite_toSet hs fun x hx ↦ hQmono x (hk (Finset.mem_image_of_mem j hx)).some (hj x)⟩

include hc in
/-- (Implementation) The case of affine stages of
`AlgebraicGeometry.Scheme.exists_isFinite_pullback_snd_of_isLimit`. -/
lemma exists_isFinite_pullback_snd_of_isAffine [∀ i, IsAffine (D.obj i)] {i : I}
    {Y : Scheme.{u}} (p : Y ⟶ D.obj i) [LocallyOfFiniteType p] [QuasiCompact p]
    [QuasiSeparated p] [IsFinite (pullback.snd p (c.π.app i))] :
    ∃ (j : I) (f : j ⟶ i), IsFinite (pullback.snd p (D.map f)) := by
  have : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := fun f ↦ isAffineHom_of_isAffine _
  have := isAffineHom_π_app D c hc
  have : IsAffine c.pt := isAffine_of_isAffineHom (X := c.pt) (c.π.app i)
  have : IsAffine (((Functor.const I).obj c.pt).obj i) := inferInstanceAs (IsAffine c.pt)
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace p
  have : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated p
  have : IsAffine (baseChangeCone D c p).pt :=
    isAffine_of_isAffineHom (pullback.snd p (c.π.app i))
  obtain ⟨j₀, hj₀⟩ := Scheme.exists_isAffine_of_isLimit _ _ (isLimitBaseChangeCone D c p hc)
  have : IsAffine (pullback p (D.map j₀.hom)) := hj₀
  have : IsFinite (pullback.snd (pullback.snd p (D.map j₀.hom)) (c.π.app j₀.left)) := by
    rw [← isFinite_pullback_snd_comp_iff, c.w]
    infer_instance
  obtain ⟨j, f, hf⟩ := exists_isFinite_pullback_snd_of_isAffine_of_isAffine hc
    (pullback.snd p (D.map j₀.hom))
  refine ⟨j, f ≫ j₀.hom, ?_⟩
  rwa [D.map_comp, isFinite_pullback_snd_comp_iff]

include hc in
/-- **Finiteness of a base change descends to a stage of a limit.** Let `{Dᵢ}` be a cofiltered
system of quasi-compact quasi-separated schemes with affine transition morphisms, and let
`p : Y ⟶ Dᵢ` be quasi-compact, quasi-separated and locally of finite type. If the base change of
`p` to `lim Dⱼ` is finite, then so is its base change to some stage `Dⱼ`, `j ⟶ i`. -/
theorem Scheme.exists_isFinite_pullback_snd_of_isLimit
    [∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)] [∀ i, CompactSpace (D.obj i)]
    [∀ i, QuasiSeparatedSpace (D.obj i)] {i : I} {Y : Scheme.{u}} (p : Y ⟶ D.obj i)
    [LocallyOfFiniteType p] [QuasiCompact p] [QuasiSeparated p]
    [IsFinite (pullback.snd p (c.π.app i))] :
    ∃ (j : I) (f : j ⟶ i), IsFinite (pullback.snd p (D.map f)) := by
  classical
  obtain ⟨t, ht⟩ := (isCompact_univ (X := D.obj i)).elim_finite_subcover
    (fun U : (D.obj i).affineOpens ↦ (U : Set (D.obj i))) (fun U ↦ U.1.isOpen) fun x _ ↦ by
      obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
        (D.obj i).isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
      exact Set.mem_iUnion.mpr ⟨⟨U, hU⟩, hxU⟩
  have htop : ⨆ U : t, ((U : (D.obj i).affineOpens) : (D.obj i).Opens) = ⊤ := by
    refine eq_top_iff.mpr fun x _ ↦ ?_
    obtain ⟨U, hUt, hx⟩ : ∃ U ∈ t, x ∈ (U : Set (D.obj i)) := by
      simpa using ht (Set.mem_univ x)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hUt⟩, hx⟩
  -- finiteness over the preimage of an affine open `W` of `Dᵢ` at the stage `j`
  let P (W : (D.obj i).affineOpens) (j : Over i) : Prop :=
    IsFinite (pullback.snd p ((D.map j.hom ⁻¹ᵁ (W : (D.obj i).Opens)).ι ≫ D.map j.hom))
  have hPmono (W : (D.obj i).affineOpens) {j j' : Over i} (u : j' ⟶ j) (h : P W j) :
      P W j' := by
    have e : (D.map j'.hom ⁻¹ᵁ (W : (D.obj i).Opens)).ι ≫ D.map j'.hom =
        (opensDiagram D i W).map u ≫ (D.map j.hom ⁻¹ᵁ (W : (D.obj i).Opens)).ι ≫
          D.map j.hom := by
      rw [opensDiagram_map_ι_assoc, ← D.map_comp, Over.w u]
    have : IsFinite (pullback.snd p
        ((D.map j.hom ⁻¹ᵁ (W : (D.obj i).Opens)).ι ≫ D.map j.hom)) := h
    change IsFinite (pullback.snd p _)
    rw [e, isFinite_pullback_snd_comp_iff]
    infer_instance
  have hPex (W : (D.obj i).affineOpens) : ∃ j, P W j := by
    let ιW := (D.map (Over.mk (𝟙 i)).hom ⁻¹ᵁ (W : (D.obj i).Opens)).ι
    let pW : pullback p ιW ⟶ (opensDiagram D i W).obj (Over.mk (𝟙 i)) := pullback.snd p ιW
    have (j : Over i) : IsAffine ((opensDiagram D i W).obj j) := W.2.preimage _
    have : IsFinite (pullback.snd pW ((opensCone D c i W).π.app (Over.mk (𝟙 i)))) := by
      change IsFinite (pullback.snd (pullback.snd p ιW) _)
      rw [← isFinite_pullback_snd_comp_iff, opensCone_π_ι, isFinite_pullback_snd_comp_iff]
      exact (inferInstance : IsFinite (pullback.snd (pullback.snd p (c.π.app i)) _))
    obtain ⟨j, u, hu⟩ := exists_isFinite_pullback_snd_of_isAffine
      (isLimitOpensCone D c hc i W) pW
    refine ⟨j, ?_⟩
    have e : (D.map j.hom ⁻¹ᵁ (W : (D.obj i).Opens)).ι ≫ D.map j.hom =
        (opensDiagram D i W).map u ≫ ιW := by
      rw [opensDiagram_map_ι]
      congr 2
      simpa using (Over.w u).symm
    change IsFinite (pullback.snd p _)
    rw [e, isFinite_pullback_snd_comp_iff]
    exact hu
  choose j hj using hPex
  obtain ⟨k, hk⟩ := IsCofiltered.inf_objs_exists (t.image j)
  refine ⟨k.left, k.hom, ?_⟩
  refine IsZariskiLocalAtTarget.of_iSup_eq_top
    (fun W : t ↦ D.map k.hom ⁻¹ᵁ ((W : (D.obj i).affineOpens) : (D.obj i).Opens)) ?_
    fun W ↦ ?_
  · rw [← Scheme.Hom.preimage_iSup, htop, Scheme.Hom.preimage_top]
  · have h := hPmono W.1 (hk (Finset.mem_image_of_mem j W.2)).some (hj W.1)
    have : IsFinite (pullback.snd p
        ((D.map k.hom ⁻¹ᵁ ((W : (D.obj i).affineOpens) : (D.obj i).Opens)).ι ≫
          D.map k.hom)) := h
    rw [isFinite_pullback_snd_comp_iff] at this
    rw [morphismRestrict]
    infer_instance

end Descent

end AlgebraicGeometry
