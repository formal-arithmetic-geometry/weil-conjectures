module

public import WeilConjectures.AlgebraicGeometry.Morphisms.Finite.PieceSection
public import WeilConjectures.AlgebraicGeometry.Morphisms.Finite.PieceSections

/-!
# Pieces of a split neighbourhood refine an étale covering

Let `f : X ⟶ Y` be finite, `y : Spec Ω ⟶ Y` a geometric point with `Ω` algebraically closed,
and `W i ⟶ X` a jointly surjective family of étale morphisms. Then there is a split
neighbourhood of `y` each of whose pieces maps to some `W i` over `X`
(`AlgebraicGeometry.Scheme.Hom.SplitNbhd.exists_forall_exists_pieceObj_hom`): every geometric
point `t` of `X` over `y` lifts to some `W i`, the pieces over `t` are cofinal among the étale
neighbourhoods of `t`, and the split neighbourhoods are cofiltered.

-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

noncomputable section

namespace AlgebraicGeometry.Scheme.Hom.SplitNbhd

variable {X Y : Scheme.{u}} (f : X ⟶ Y) [IsFinite f] {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
  (y : Spec (.of Ω) ⟶ Y)

/-- **The pieces of some split neighbourhood refine a given étale covering.** If the étale
`X`-schemes `W i` cover `X`, then there is a split neighbourhood `s` of `y` each of whose pieces
maps to some `W i` over `X`. -/
theorem exists_forall_exists_pieceObj_hom {ι : Type*} (W : ι → X.Etale)
    (hW : ∀ x : X, ∃ i, ∃ w : (W i).left, (W i).hom w = x) :
    ∃ s : SplitNbhd f y, ∀ t : GeometricFiber f y, ∃ i, Nonempty (s.pieceObj t ⟶ W i) := by
  classical
  -- `X` itself, as an étale `X`-scheme, and the covering sieve generated by the `W i`
  let T : X.Etale := Scheme.Etale.mk (𝟙 X)
  let π (i : ι) : W i ⟶ T := MorphismProperty.Over.homMk (W i).hom (Category.comp_id _)
  have hR : Sieve.ofArrows W π ∈ X.smallEtaleTopology T := by
    rw [ofArrows_mem_smallEtaleTopology_iff, Set.eq_univ_iff_forall]
    intro x
    obtain ⟨i, w, hw⟩ := hW x
    exact Set.mem_iUnion.mpr ⟨i, w, hw⟩
  have hpiece (t : GeometricFiber f y) :
      ∃ (s : SplitNbhd f y) (i : ι), Nonempty (s.pieceObj t ⟶ W i) := by
    obtain ⟨Z, h, hh, z, -⟩ := (pointSmallEtale t.1).jointly_surjective _ hR
      (CategoryTheory.Over.homMk t.1 (by simp [T]))
    obtain ⟨_, g, _, ⟨i⟩, rfl⟩ := hh
    obtain ⟨s, ⟨a⟩⟩ := exists_pieceFunctor_obj_hom f t ⟨Z, z⟩
    exact ⟨s, i, ⟨a.val ≫ g⟩⟩
  choose s i a using hpiece
  have := Fintype.ofFinite (GeometricFiber f y)
  obtain ⟨s₀, hs₀⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image s)
  refine ⟨s₀, fun t ↦ ⟨i t, ?_⟩⟩
  obtain ⟨b⟩ := hs₀ (Finset.mem_image_of_mem s (Finset.mem_univ t))
  exact ⟨pieceMap b t ≫ (a t).some⟩

end AlgebraicGeometry.Scheme.Hom.SplitNbhd

end
