module

public import Mathlib.AlgebraicGeometry.AffineTransitionLimit
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import WeilConjectures.Mathlib.AlgebraicGeometry.Sites.SmallAffineZariski

/-!
# Finiteness descends to a stage of a limit

Let `{Dᵢ}` be a cofiltered system of quasi-compact quasi-separated schemes with closed immersions
as transition morphisms, locally of finite type over a quasi-compact quasi-separated scheme `S`,
and let `X = lim Dᵢ`. If `X` is finite over `S`, then so is some `Dᵢ`
(`AlgebraicGeometry.Scheme.exists_isFinite_of_isLimit`).

Over an affine open `U = Spec R` of `S` the stages are eventually affine, `Dᵢ ×_S U = Spec Aᵢ`,
with `X ×_S U = Spec (colim Aᵢ)`. The `R`-algebra `Aᵢ` is generated by finitely many elements,
whose images in `colim Aᵢ` are integral over `R`; the monic equations they satisfy already hold
in some `Aⱼ`, which is then generated by integral elements, as the transition maps are
surjective.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

/-- A morphism is integral if it is affine and integral over each member of an affine open
cover of the target. -/
lemma isIntegralHom_of_iSup_eq_top {X Y : Scheme.{u}} (f : X ⟶ Y) {ι : Type*}
    (U : ι → Y.affineOpens) (hU : ⨆ i, (U i : Y.Opens) = ⊤)
    (h : ∀ i, IsAffineOpen (f ⁻¹ᵁ (U i : Y.Opens)) ∧ (f.app (U i)).hom.IsIntegral) :
    IsIntegralHom f := by
  rw [HasAffineProperty.iff_of_iSup_eq_top (P := @IsIntegralHom) U hU]
  intro i
  refine ⟨(h i).1, ?_⟩
  rw [morphismRestrict_app, CommRingCat.hom_comp]
  refine RingHom.IsIntegral.trans _ _ ?_ ?_
  · have key : ∀ V (_ : V = (U i : Y.Opens)), (f.app V).hom.IsIntegral := by
      rintro V rfl
      exact (h i).2
    exact key _ (Scheme.Opens.ι_image_top _)
  · exact (RingHom.Finite.of_surjective _
      (ConcreteCategory.bijective_of_isIso _).2).to_isIntegral

variable {I : Type u} [Category.{u} I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Cone D)
  (hc : IsLimit c)

include hc in
/-- If the limit is affine over an affine open `U` of the base, then so is some stage. -/
lemma exists_isAffineOpen_preimage_of_isLimit [∀ {i j} (f : i ⟶ j), IsAffineHom (D.map f)]
    [∀ i, CompactSpace (D.obj i)] [∀ i, QuasiSeparatedSpace (D.obj i)] {S : Scheme.{u}}
    [QuasiSeparatedSpace S] (p : ∀ i, D.obj i ⟶ S) (hp : ∀ {i j} (f : i ⟶ j), D.map f ≫ p j = p i)
    (q : c.pt ⟶ S) (hq : ∀ i, c.π.app i ≫ p i = q) {U : S.Opens} (hU : IsAffineOpen U)
    (hqU : IsAffineOpen (q ⁻¹ᵁ U)) (i₀ : I) :
    ∃ (j : I) (_ : j ⟶ i₀), IsAffineOpen (p j ⁻¹ᵁ U) := by
  let V := p i₀ ⁻¹ᵁ U
  have hV : IsCompact (V : Set (D.obj i₀)) := QuasiCompact.isCompact_preimage _ U.2 hU.isCompact
  have (j : Over i₀) : CompactSpace ((opensDiagram D i₀ V).obj j) :=
    isCompact_iff_compactSpace.mp (QuasiCompact.isCompact_preimage _ V.2 hV)
  have (j : Over i₀) : QuasiSeparatedSpace ((opensDiagram D i₀ V).obj j) :=
    (isQuasiSeparated_iff_quasiSeparatedSpace _ (D.map _ ⁻¹ᵁ _).2).mp (.of_quasiSeparatedSpace _)
  have : IsAffine (opensCone D c i₀ V).pt := by
    change IsAffineOpen (c.π.app i₀ ⁻¹ᵁ p i₀ ⁻¹ᵁ U)
    rwa [← Scheme.Hom.comp_preimage, hq]
  obtain ⟨j, hj⟩ := Scheme.exists_isAffine_of_isLimit _ _ (isLimitOpensCone D c hc i₀ V)
  refine ⟨j.left, j.hom, ?_⟩
  have hj' : IsAffineOpen (D.map j.hom ⁻¹ᵁ V) := hj
  rwa [← Scheme.Hom.comp_preimage, hp] at hj'

lemma _root_.RingHom.IsIntegralElem.map' {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    {f : R →+* A} (σ : A →+* B) {y : A} (h : f.IsIntegralElem y) :
    (σ.comp f).IsIntegralElem (σ y) := by
  obtain ⟨P, hP, hy⟩ := h
  exact ⟨P, hP, by rw [← Polynomial.hom_eval₂, hy, map_zero]⟩

include hc in
/-- If the limit is integral over an affine open `U` of the base, and the stages are of finite type
over `U` with surjective transition maps, then some stage is integral over `U`. -/
lemma exists_isIntegral_app_of_isLimit [∀ {i j} (f : i ⟶ j), IsClosedImmersion (D.map f)]
    [∀ i, CompactSpace (D.obj i)] {S : Scheme.{u}} [QuasiSeparatedSpace S]
    (p : ∀ i, D.obj i ⟶ S) (hp : ∀ {i j} (f : i ⟶ j), D.map f ≫ p j = p i)
    [∀ i, LocallyOfFiniteType (p i)] (q : c.pt ⟶ S) (hq : ∀ i, c.π.app i ≫ p i = q)
    [IsIntegralHom q] {U : S.Opens} (hU : IsAffineOpen U) (k : I)
    (hk : IsAffineOpen (p k ⁻¹ᵁ U)) :
    ∃ j : I, IsAffineOpen (p j ⁻¹ᵁ U) ∧ ((p j).app U).hom.IsIntegral := by
  classical
  -- the comparison maps to the sections of the limit over the preimage of `U`
  have hle (j : I) : q ⁻¹ᵁ U ≤ c.π.app j ⁻¹ᵁ p j ⁻¹ᵁ U := by
    rw [← Scheme.Hom.comp_preimage, hq]
  let χ (j : I) := (c.π.app j).appLE (p j ⁻¹ᵁ U) (q ⁻¹ᵁ U) (hle j)
  have hφχ : (p k).app U ≫ χ k = q.app U := by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE,
      Scheme.Hom.appLE_eq_of_eq (hq k) _ _ _ le_rfl, Scheme.Hom.appLE_eq_app]
  have hqint : (q.app U).hom.IsIntegral := q.isIntegral_app U hU
  -- generators of the sections of the stage `k`
  obtain ⟨s, hs⟩ : ∃ s : Finset Γ(D.obj k, p k ⁻¹ᵁ U),
      letI := ((p k).app U).hom.toAlgebra
      Algebra.adjoin Γ(S, U) (↑s : Set Γ(D.obj k, p k ⁻¹ᵁ U)) = ⊤ := by
    have h := (p k).finiteType_appLE hU hk le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    let := ((p k).app U).hom.toAlgebra
    exact h.out
  -- descend the integral equations of the generators one at a time
  have key : ∀ t : Finset Γ(D.obj k, p k ⁻¹ᵁ U), ∃ (j : I)
      (ρ : Γ(D.obj k, p k ⁻¹ᵁ U) ⟶ Γ(D.obj j, p j ⁻¹ᵁ U)), IsAffineOpen (p j ⁻¹ᵁ U) ∧
      Function.Surjective ρ.hom ∧ (p k).app U ≫ ρ = (p j).app U ∧ ρ ≫ χ j = χ k ∧
      ∀ x ∈ t, ((p j).app U).hom.IsIntegralElem (ρ.hom x) := by
    intro t
    induction t using Finset.induction_on with
    | empty =>
      exact ⟨k, 𝟙 _, hk, (ConcreteCategory.bijective_of_isIso (𝟙 _)).2, Category.comp_id _,
        Category.id_comp _, by simp⟩
    | insert x t hxt IH =>
      obtain ⟨j, ρ, hjU, hρs, hρp, hρχ, hρt⟩ := IH
      obtain ⟨P, hPm, hP⟩ := hqint ((χ k).hom x)
      rw [← hφχ, CommRingCat.hom_comp] at hP
      have hP' : (χ k).hom (P.eval₂ ((p k).app U).hom x) = 0 := by
        rw [Polynomial.hom_eval₂]
        exact hP
      let z := ρ.hom (P.eval₂ ((p k).app U).hom x)
      have hz : ((c.π.app j).app (p j ⁻¹ᵁ U)).hom z = 0 := by
        have h1 : (χ j).hom z = 0 := by
          rw [show (χ j).hom z = (ρ ≫ χ j).hom (P.eval₂ ((p k).app U).hom x) from rfl, hρχ]
          exact hP'
        have h2 : (c.pt.presheaf.map (homOfLE (hle j)).op).hom
            (((c.π.app j).app (p j ⁻¹ᵁ U)).hom z) = 0 := h1
        have hinj : Function.Injective (c.pt.presheaf.map (homOfLE (hle j)).op).hom := by
          have heq : q ⁻¹ᵁ U = c.π.app j ⁻¹ᵁ p j ⁻¹ᵁ U := by
            rw [← Scheme.Hom.comp_preimage, hq]
          have : IsIso (homOfLE (hle j)).op := (eqToIso heq).op.isIso_hom
          exact (ConcreteCategory.bijective_of_isIso _).1
        exact hinj (h2.trans (map_zero _).symm)
      obtain ⟨j', f, hf⟩ := exists_app_map_eq_zero_of_isLimit D c hc hjU.isCompact z hz
      have hpre : D.map f ⁻¹ᵁ p j ⁻¹ᵁ U = p j' ⁻¹ᵁ U := by
        rw [← Scheme.Hom.comp_preimage, hp]
      let σ := (D.map f).appLE (p j ⁻¹ᵁ U) (p j' ⁻¹ᵁ U) hpre.ge
      have hσs : Function.Surjective σ.hom := by
        have : IsIso (homOfLE hpre.ge).op := (eqToIso hpre).op.isIso_inv
        exact (ConcreteCategory.bijective_of_isIso
          ((D.obj j').presheaf.map (homOfLE hpre.ge).op)).2.comp
          ((D.map f).app_surjective _ hjU)
      have hσz : σ.hom z = 0 := by
        change ((D.obj j').presheaf.map (homOfLE hpre.ge).op).hom
          (((D.map f).app (p j ⁻¹ᵁ U)).hom z) = 0
        rw [hf, map_zero]
      have hσp : (p j).app U ≫ σ = (p j').app U := by
        rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE,
          Scheme.Hom.appLE_eq_of_eq (hp f) _ _ _ le_rfl, Scheme.Hom.appLE_eq_app]
      have hσρ : ((p j').app U).hom = σ.hom.comp ((p j).app U).hom := by
        rw [← hσp, CommRingCat.hom_comp]
      refine ⟨j', ρ ≫ σ, hpre ▸ hjU.preimage (D.map f), hσs.comp hρs, ?_, ?_, ?_⟩
      · rw [← Category.assoc, hρp, hσp]
      · rw [Category.assoc, Scheme.Hom.appLE_comp_appLE,
          Scheme.Hom.appLE_eq_of_eq (c.w f) _ _ _ (hle j), hρχ]
      · intro y hy
        rw [hσρ]
        rcases Finset.mem_insert.mp hy with rfl | hy
        · refine ⟨P, hPm, ?_⟩
          have e1 : (ρ ≫ σ).hom y = σ.hom (ρ.hom y) := rfl
          have e2 : P.eval₂ ((p j).app U).hom (ρ.hom y) =
              ρ.hom (P.eval₂ ((p k).app U).hom y) := by
            rw [Polynomial.hom_eval₂, ← CommRingCat.hom_comp, hρp]
          rw [e1, ← Polynomial.hom_eval₂, e2]
          exact hσz
        · exact RingHom.IsIntegralElem.map' σ.hom (hρt y hy)
  obtain ⟨j, ρ, hjU, hρs, hρp, -, hρs'⟩ := key s
  refine ⟨j, hjU, fun y ↦ ?_⟩
  obtain ⟨a, rfl⟩ := hρs y
  let := ((p k).app U).hom.toAlgebra
  have ha : a ∈ Algebra.adjoin Γ(S, U) (↑s : Set Γ(D.obj k, p k ⁻¹ᵁ U)) := by
    rw [hs]; trivial
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact hρs' x hx
  | algebraMap r =>
    rw [← hρp, CommRingCat.hom_comp]
    exact RingHom.isIntegralElem_map _
  | add x y _ _ hx hy =>
    rw [map_add]
    exact RingHom.IsIntegralElem.add _ hx hy
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact RingHom.IsIntegralElem.mul _ hx hy

include hc in
/-- **Finiteness descends to a stage of a limit.** Let `{Dᵢ}` be a cofiltered system of
quasi-compact quasi-separated schemes with closed immersions as transition morphisms, locally of
finite type over a quasi-compact quasi-separated scheme `S`. If the limit `lim Dᵢ` is finite over
`S`, then so is some stage `Dᵢ`. -/
theorem Scheme.exists_isFinite_of_isLimit [∀ {i j} (f : i ⟶ j), IsClosedImmersion (D.map f)]
    [∀ i, CompactSpace (D.obj i)] [∀ i, QuasiSeparatedSpace (D.obj i)] {S : Scheme.{u}}
    [CompactSpace S] [QuasiSeparatedSpace S] (p : ∀ i, D.obj i ⟶ S)
    (hp : ∀ {i j} (f : i ⟶ j), D.map f ≫ p j = p i) [∀ i, LocallyOfFiniteType (p i)]
    (q : c.pt ⟶ S) (hq : ∀ i, c.π.app i ≫ p i = q) [IsFinite q] :
    ∃ i, IsFinite (p i) := by
  classical
  obtain ⟨t, ht⟩ := (isCompact_univ (X := S)).elim_finite_subcover
    (fun U : S.affineOpens ↦ (U : Set S)) (fun U ↦ U.1.isOpen) fun x _ ↦ by
      obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
        S.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
      exact Set.mem_iUnion.mpr ⟨⟨U, hU⟩, hxU⟩
  have htop : ⨆ U : t, ((U : S.affineOpens) : S.Opens) = ⊤ := by
    refine eq_top_iff.mpr fun x _ ↦ ?_
    obtain ⟨U, hUt, hx⟩ : ∃ U ∈ t, x ∈ (U : Set S) := by simpa using ht (Set.mem_univ x)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hUt⟩, hx⟩
  -- the property of a stage to be affine and integral over `U`
  let P (U : S.affineOpens) (j : I) : Prop :=
    IsAffineOpen (p j ⁻¹ᵁ (U : S.Opens)) ∧ ((p j).app U).hom.IsIntegral
  have hPmap (U : S.affineOpens) {j j' : I} (f : j' ⟶ j) (h : P U j) : P U j' := by
    have hpre : D.map f ⁻¹ᵁ p j ⁻¹ᵁ (U : S.Opens) = p j' ⁻¹ᵁ U := by
      rw [← Scheme.Hom.comp_preimage, hp]
    refine ⟨hpre ▸ h.1.preimage (D.map f), ?_⟩
    have hσp : (p j).app U ≫ (D.map f).appLE _ _ hpre.ge = (p j').app U := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE,
        Scheme.Hom.appLE_eq_of_eq (hp f) _ _ _ le_rfl, Scheme.Hom.appLE_eq_app]
    rw [← hσp, CommRingCat.hom_comp]
    have : IsIso (homOfLE hpre.ge).op := (eqToIso hpre).op.isIso_inv
    have hσs : Function.Surjective ((D.map f).appLE _ _ hpre.ge).hom :=
      (ConcreteCategory.bijective_of_isIso
        ((D.obj j').presheaf.map (homOfLE hpre.ge).op)).2.comp
        ((D.map f).app_surjective _ h.1)
    exact RingHom.IsIntegral.trans _ _ h.2 (RingHom.Finite.of_surjective _ hσs).to_isIntegral
  have hPex (U : S.affineOpens) : ∃ j, P U j := by
    obtain ⟨i₀⟩ := IsCofiltered.nonempty (C := I)
    obtain ⟨k, -, hk⟩ := exists_isAffineOpen_preimage_of_isLimit D c hc p hp q hq U.2
      (U.2.preimage q) i₀
    exact exists_isIntegral_app_of_isLimit D c hc p hp q hq U.2 k hk
  choose j hj using hPex
  obtain ⟨j₀, hj₀⟩ := IsCofiltered.inf_objs_exists (t.image j)
  refine ⟨j₀, (IsFinite.iff_isIntegralHom_and_locallyOfFiniteType (f := p j₀)).mpr
    ⟨?_, inferInstance⟩⟩
  refine isIntegralHom_of_iSup_eq_top (p j₀) (fun U : t ↦ U.1) htop fun U ↦ ?_
  exact hPmap U.1 (hj₀ (Finset.mem_image_of_mem j U.2)).some (hj U.1)

end AlgebraicGeometry
