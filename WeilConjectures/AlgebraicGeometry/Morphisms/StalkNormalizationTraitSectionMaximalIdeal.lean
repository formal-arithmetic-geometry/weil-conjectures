/-!
# Local algebra of tame trait normalization

Source: Stacks Project, Tags 0EYH and 0EYI(2).
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

set_option maxHeartbeats 800000 in
-- Elaborating the normalization pullbacks and their dependent stalk maps needs this budget.
/-- The maximal ideal at a point above the closed trait section is generated by the
maximal ideal of its image.

Source: Stacks Project, Tags 0EYH and 0EYI(2), used in the trait paragraph of 0EYJ. -/
theorem GaloisCover.stalk_normalization_trait_section_maximalIdeal {S C : Scheme.{u}}
    [IsNoetherian S]
    [QuasiSeparatedSpace S] [IsIntegral S]
    (c : C ⟶ S) [QuasiCompact c] [QuasiSeparated c] [Smooth c] [GeometricallyConnected c]
    (σ : S ⟶ C) (hσ : σ ≫ c = 𝟙 S)
    (G : Type (u + 1)) [Group G] [Finite G]
    (hG : IsUnit (Nat.card G : Γ(S, ⊤)))
    {Cη : Scheme.{u}} (q : Cη ⟶ Spec S.functionField) (j : Cη ⟶ C)
    (hCη : IsPullback q j (S.fromSpecStalk (genericPoint S)) c)
    (sη : Spec S.functionField ⟶ Cη)
    (hsj : sη ≫ j = S.fromSpecStalk (genericPoint S) ≫ σ)
    (Z : GaloisCover G Cη) (hZ : ∃ z : Spec S.functionField ⟶ Z.P, z ≫ Z.π = sη)
    (U : S.Opens)
    (jU : Cη ⟶ (c ⁻¹ᵁ U).toScheme) (PA : (c ⁻¹ᵁ U).toScheme.FiniteEtale)
    (ψ : Z.P ⟶ PA.obj.left) (hjU : jU ≫ (c ⁻¹ᵁ U).ι = j)
    (hψ : IsPullback ψ Z.π PA.obj.hom jU)
    (s : S) (hs : s ∉ U)
    (hmin : ∀ t : S, t ⤳ s → t ∉ U → t = s)
    (hdvr : IsDiscreteValuationRing (S.presheaf.stalk s)) :
    letI : IsFinite PA.obj.hom := PA.property
    letI : QuasiCompact (c ⁻¹ᵁ U).ι :=
      MorphismProperty.of_isPullback (isPullback_morphismRestrict c U)
        (inferInstance : QuasiCompact U.ι)
    let a := S.fromSpecStalk s
    let n := pullback.snd (PA.obj.hom ≫ (c ⁻¹ᵁ U).ι).fromNormalization (pullback.fst c a)
    let τ : Spec (S.presheaf.stalk s) ⟶ pullback c a :=
      pullback.lift (a ≫ σ) (𝟙 _) (by simp [Category.assoc, hσ])
    IsFinite n → ∀ x : (pullback (PA.obj.hom ≫ (c ⁻¹ᵁ U).ι).fromNormalization
      (pullback.fst c a) : Scheme.{u}),
      n x = τ (IsLocalRing.closedPoint (S.presheaf.stalk s)) →
      (IsLocalRing.maximalIdeal ((pullback c a).presheaf.stalk (n x))).map
        (n.stalkMap x).hom = IsLocalRing.maximalIdeal
          ((pullback (PA.obj.hom ≫ (c ⁻¹ᵁ U).ι).fromNormalization
            (pullback.fst c a)).presheaf.stalk x) := by
  let : IsFinite PA.obj.hom := PA.property
  let : QuasiCompact (c ⁻¹ᵁ U).ι :=
    MorphismProperty.of_isPullback (isPullback_morphismRestrict c U)
      (inferInstance : QuasiCompact U.ι)
  dsimp only
  intro hn x hx
  obtain ⟨D, hD, β, hβlocal, hβflat, t, e, K, hK, ord, π, z,
      he, hgen, hpow, hz, hπ⟩ :=
    GaloisCover.stalk_normalization_trait_section_cyclic_data c σ hσ G hG q j
      hCη sη hsj Z hZ U jU PA ψ hjU hψ s hs hmin hdvr hn x hx
  let B := (pullback (PA.obj.hom ≫ (c ⁻¹ᵁ U).ι).fromNormalization
    (pullback.fst c (S.fromSpecStalk s))).presheaf.stalk x
  let J := (IsLocalRing.maximalIdeal
    ((pullback c (S.fromSpecStalk s)).presheaf.stalk
      (pullback.snd (PA.obj.hom ≫ (c ⁻¹ᵁ U).ι).fromNormalization
        (pullback.fst c (S.fromSpecStalk s)) x))).map
      ((pullback.snd (PA.obj.hom ≫ (c ⁻¹ᵁ U).ι).fromNormalization
        (pullback.fst c (S.fromSpecStalk s))).stalkMap x).hom
  let := hD
  let := hK
  let := hβlocal
  let := β.toAlgebra
  have : Module.Flat B D := RingHom.flat_algebraMap_iff.mp hβflat
  have : Module.FaithfullyFlat B D := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hval : (e : ℤ) * Multiplicative.toAdd (ord z) = 1 := by
    have h := congrArg (fun w ↦ Multiplicative.toAdd (ord w)) hz
    simpa [map_pow, hπ] using h
  have hv : 0 < Multiplicative.toAdd (ord z) := by
    by_contra hv
    have hv' : Multiplicative.toAdd (ord z) ≤ 0 := le_of_not_gt hv
    have : (e : ℤ) * Multiplicative.toAdd (ord z) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by positivity) hv'
    omega
  have he1 : e = 1 := by
    have hle : (e : ℤ) ≤ (e : ℤ) * Multiplicative.toAdd (ord z) := by
      nlinarith
    omega
  have ht : t ∈ J.map β := by
    simpa [he1] using hpow
  have hspan : Ideal.span {t} ≤ J.map β := Ideal.span_le.mpr (by simpa using ht)
  have hmap : J.map β = IsLocalRing.maximalIdeal D := by
    rw [hgen, sup_eq_left.mpr hspan]
  have hdescent := congrArg (Ideal.comap β) hmap
  have hcontract : (J.map β).comap β = J := by
    exact J.comap_map_eq_self_of_faithfullyFlat (B := D)
  rw [hcontract, IsLocalRing.maximalIdeal_comap] at hdescent
  exact hdescent

end AlgebraicGeometry.Scheme
