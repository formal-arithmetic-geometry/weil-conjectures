module

public import Mathlib.AlgebraicGeometry.Pullbacks
import Mathlib.AlgebraicGeometry.Morphisms.Flat

/-! # Generation of affine base-change sections

Source: Stacks Project, Tag 01LX (2)-(3), affine pullback calculation.
-/

@[expose] public section

set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
namespace AlgebraicGeometry

/-- The sections over the inverse image of an affine open are generated by
sections from that open and constants from the new base ring (Stacks, Tag 01LX). -/
theorem affineBaseChange_sections_induction
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) (U : X.affineOpens) :
    let g := Spec.map (CommRingCat.ofHom (algebraMap A B))
    let Y := pullback f g
    let pi : Y ⟶ X := pullback.fst f g
    let fB : Y ⟶ Spec (.of B) := pullback.snd f g
    let C := (TopCat.Sheaf.pushforward CommRingCat.{u} pi.base).obj Y.sheaf
    ∀ (P : C.obj.obj (op U.val) → Prop),
      (∀ d : X.presheaf.obj (op U.val), P (pi.app U.val d)) →
      (∀ b : B, P (Y.presheaf.map
        (homOfLE (le_top (a := pi ⁻¹ᵁ U.val))).op
        (((Scheme.ΓSpecIso (.of B)).inv ≫ fB.appTop).hom b))) →
      (∀ r s, P r → P s → P (r + s)) →
      (∀ r s, P r → P s → P (r * s)) → ∀ r, P r := by
  classical
  dsimp only
  let g := Spec.map (CommRingCat.ofHom (algebraMap A B))
  let Y := pullback f g
  let pi : Y ⟶ X := pullback.fst f g
  let fB : Y ⟶ Spec (.of B) := pullback.snd f g
  let W := pi ⁻¹ᵁ U.val
  intro P hd hb hadd hmul r
  have hw : W = pi ⁻¹ᵁ U.val ⊓ fB ⁻¹ᵁ ⊤ := by simp [W]
  have hs : IsIso (pushoutSection (IsPullback.of_hasPullback f g)
      (show ⊤ ≤ g ⁻¹ᵁ ⊤ by simp)
      (show U.val ≤ f ⁻¹ᵁ ⊤ by simp) hw) :=
    isIso_pushoutSection_of_isAffineOpen _ _ _ _
      (isAffineOpen_top (Spec (.of A))) (isAffineOpen_top (Spec (.of B))) U.property
  have hp := (isIso_pushoutSection_iff (IsPullback.of_hasPullback f g)
    (show ⊤ ≤ g ⁻¹ᵁ ⊤ by simp)
    (show U.val ≤ f ⁻¹ᵁ ⊤ by simp) hw).mp hs
  have hd' (d : X.presheaf.obj (op U.val)) :
      P (pi.appLE U.val W (by simp [W]) d) := by
    simpa [W, Scheme.Hom.appLE_eq_app] using hd d
  have hb' (b : (Spec (.of B)).presheaf.obj (op ⊤)) :
      P (fB.appLE ⊤ W (by simp) b) := by
    obtain ⟨b, rfl⟩ := ConcreteCategory.bijective_of_isIso
      (Scheme.ΓSpecIso (.of B)).inv |>.2 b
    simpa [Scheme.Hom.appLE, CommRingCat.comp_apply] using hb b
  let S : Subring (Y.presheaf.obj (op W)) :=
    { carrier := {s | P s}
      zero_mem' := by simpa using hd (0 : X.presheaf.obj (op U.val))
      one_mem' := by simpa using hd (1 : X.presheaf.obj (op U.val))
      add_mem' := fun hx hy ↦ hadd _ _ hx hy
      mul_mem' := fun hx hy ↦ hmul _ _ hx hy
      neg_mem' := fun {x} hx ↦ by
        have hn := hd (-1 : X.presheaf.obj (op U.val))
        simpa using hmul _ _ hn hx }
  have hgen := CommRingCat.closure_range_union_range_eq_top_of_isPushout hp
  have hle : Subring.closure
      (Set.range (pi.appLE U.val W (by simp [W])) ∪
        Set.range (fB.appLE ⊤ W (by simp))) ≤ S := by
    apply Subring.closure_le.mpr
    rintro s (⟨d, rfl⟩ | ⟨b, rfl⟩)
    · exact hd' d
    · exact hb' b
  rw [hgen] at hle
  exact hle (Subring.mem_top r)

end AlgebraicGeometry
