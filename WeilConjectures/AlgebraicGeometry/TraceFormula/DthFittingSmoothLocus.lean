/-!
# The d-th Fitting ideal and the smooth locus

Source: Stacks Project, Divisors, Tag 0C3K (blueprint:
lem-trf-dth-fitting-smooth-locus).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace AlgebraicGeometry

/-- Relative differentials of a locally finitely presented morphism are finite type.
Source: Stacks Project, Divisors, Tag 0C3K, proof (blueprint:
lem-trf-dth-fitting-smooth-locus). The proof is by affine finite-presentation charts,
where differentials are generated by the differentials of algebra generators. -/
theorem relativeDifferentials_isFiniteType {T B : Scheme.{u}} (g : T ⟶ B)
    [LocallyOfFinitePresentation g] : g.relativeDifferentials.IsFiniteType := by
  obtain ⟨_, _, c, _, _, _, _, hfinite⟩ := g.relativeDifferentialSheaf_baseChange (𝟙 B)
  exact (hfinite inferInstance).1

/-- Relative differentials are quasi-coherent on a scheme for a locally finitely
presented morphism. Source: Stacks Project, Divisors, Tag 0C3K (blueprint:
lem-trf-dth-fitting-smooth-locus). -/
theorem relativeDifferentials_isQuasicoherent {T B : Scheme.{u}} (g : T ⟶ B)
    [LocallyOfFinitePresentation g] : g.relativeDifferentials.IsQuasicoherent := by
  exact (g.relativeDifferentialSheaf_baseChange (𝟙 B)).1

attribute [instance] relativeDifferentials_isFiniteType relativeDifferentials_isQuasicoherent

/-- Transport component dimensions across a scheme isomorphism. -/
private theorem pureDimension_of_iso {X Y : Scheme.{u}} (e : X ≅ Y) (d : ℕ)
    (h : Y.IsPureDimension d) : X.IsPureDimension d := by
  intro C hC
  let e' := Scheme.homeoOfIso e
  have hcomp : e' '' C ∈ irreducibleComponents Y := by
    rw [e'.image_eq_preimage_symm]
    obtain ⟨x, hx⟩ := hC.1.nonempty
    exact preimage_mem_irreducibleComponents hC e'.symm.isOpenEmbedding
      ⟨x, hx, e'.symm.surjective x⟩
  exact ((e'.image C).isHomeomorph.topologicalKrullDim_eq _).trans (h _ hcomp)

/-- Padding a finite spanning family with zeros preserves its spanning property. -/
private theorem spanningFamily_pad {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] {n d : ℕ} (hnd : n ≤ d) (v : Fin n → M)
    (hv : Submodule.span R (Set.range v) = ⊤) :
    ∃ w : Fin d → M, Submodule.span R (Set.range w) = ⊤ := by
  classical
  let w := Function.extend (Fin.castLE hnd) v (fun _ ↦ 0)
  refine ⟨w, top_unique ?_⟩
  rw [← hv]
  apply Submodule.span_mono
  rintro _ ⟨i, rfl⟩
  exact ⟨Fin.castLE hnd i, (Fin.castLE_injective hnd).extend_apply v (fun _ ↦ 0) i⟩

/-- For a flat locally finitely presented morphism `g : T ⟶ B` whose geometric fibres
`T ×_B Spec (κ(b)^alg)` are all of pure dimension `d` (the empty fibre vacuously), the
complement of the support of the d-th Fitting ideal of the relative differentials is
the smooth locus. The affine kernel-minor description is the definition of
`fittingIdealSheaf`; its independence and localization are supplied by
`lem-trf-fitting-ideal-independence-base-change`.
Source: Stacks Project, Divisors, Tag 0C3K. (blueprint: lem-trf-dth-fitting-smooth-locus)

Proof plan (the node's four steps):
1. `Ω¹_{T/B}` is finite type and quasi-coherent (the two theorems above). By
   `fitting_ideal_generate_locally` (More on Algebra 07ZC (3)), `x ∉ |Z_d|` iff the stalk
   of `Ω¹_{T/B}` at `x` is generated by at most `d` elements; the complement of the
   support is open.
2. For `x` over `s = g x`, an affine chart `Spec A ∋ x` over `Spec R ∋ s` gives the open
   `Spec (C ⊗ Ω)` of the geometric fibre, `C = A ⊗_R κ(s)`, containing a point over `x`;
   so the geometric fibre is nonempty and pure of dimension `d`. It is locally of finite
   type over `Ω` (base change, `lem-weil-pbc-qcqs-morphism-permanence` (3)); by
   `lem-sbc-equidimensional-open-local-dimension` its dimension at that point is `d`, and
   by `lem-weil-pbc-dimension-at-point-field-extension` (Algebra 00P4) `dim_x T_s = d`.
3. By `smoothAtPoint_iff_flat_stalkMap_and_differentials_generators` (Morphisms 01V9),
   with the flat stalk map and the fibre dimension `d` from Step 2, `g` is smooth at `x`
   iff the stalk of `Ω¹_{T/B}` at `x` is generated by at most `d` elements.
4. Steps 1 and 3 give `V = |T| \ |Z_d|`, open by Step 1. At `d = 1` the Fitting ideal is
   by definition `firstFittingIdealSheaf g` (def-trf-first-fitting-singular-subscheme).
-/
theorem dthFitting_smoothLocus
    {T B : Scheme.{u}} (g : T ⟶ B) (d : ℕ)
    [Flat g] [LocallyOfFinitePresentation g]
    (hpure : ∀ b : B, (pullback g (Spec.map (CommRingCat.ofHom (algebraMap
      (B.residueField b) (AlgebraicClosure (B.residueField b)))) ≫
        B.fromSpecResidueField b)).IsPureDimension d) :
    ∃ V : Set T,
      IsOpen V ∧
      (∀ x : T, x ∈ V ↔ ∃ U : T.Opens, x ∈ U ∧ Smooth (U.ι ≫ g)) ∧
      ((Scheme.Modules.fittingIdealSheaf g.relativeDifferentials d).support : Set T) =
        Set.univ \ V ∧
      (d = 1 →
        Scheme.Modules.fittingIdealSheaf g.relativeDifferentials 1 =
          Scheme.firstFittingIdealSheaf g) := by
  have hpure' : ∀ (b : B) (Ω : Type u) [Field Ω] [Algebra (B.residueField b) Ω]
      [IsAlgClosure (B.residueField b) Ω],
      Nonempty ↥(pullback (g.fiberToSpecResidueField b)
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) Ω)))) →
      (pullback (g.fiberToSpecResidueField b)
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) Ω)))).IsPureDimension d := by
    intro b Ω _ _ _ _
    let a := Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) Ω))
    let a₀ := Spec.map (CommRingCat.ofHom
      (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))))
    let e := IsAlgClosure.equiv (B.residueField b)
      (AlgebraicClosure (B.residueField b)) Ω
    let eS := Scheme.Spec.mapIso e.toRingEquiv.toCommRingCatIso.op
    have ha : a = eS.hom ≫ a₀ := by
      change Spec.map _ = Spec.map (CommRingCat.ofHom e.toRingHom) ≫ Spec.map _
      rw [← Spec.map_comp]
      congr 1
      ext z
      exact (e.commutes z).symm
    let q := asIso (pullback.map g (a ≫ B.fromSpecResidueField b)
      g (a₀ ≫ B.fromSpecResidueField b) (𝟙 T) eS.hom (𝟙 B)
      (by simp) (by simp only [Category.comp_id, ha, Category.assoc]))
    exact pureDimension_of_iso
      (pullbackLeftPullbackSndIso g (B.fromSpecResidueField b) a ≪≫ q) d (hpure b)
  have hdim (x : T) : topologicalKrullDimAt (g.asFiber x) = (d : WithBot ℕ∞) :=
    (geometric_pure_fibre_point_dimension g d hpure' x
      (AlgebraicClosure (B.residueField (g x)))).2.2
  let J := Scheme.Modules.fittingIdealSheaf g.relativeDifferentials d
  refine ⟨(J.support : Set T)ᶜ, J.support.isClosed.isOpen_compl, ?_, ?_, ?_⟩
  · intro x
    have hfit := (Scheme.Modules.fitting_ideal_generate_locally
      T g.relativeDifferentials d).2.2 x |>.2.2
    change x ∉ J.support ↔ _
    rw [hfit, g.smoothAtPoint_iff_flat_stalkMap_and_differentials_generators x]
    constructor
    · rintro ⟨v, hv⟩
      exact ⟨Flat.stalkMap g x, d, v, (hdim x).ge, hv⟩
    · rintro ⟨_, n, v, hn, hv⟩
      rw [hdim x] at hn
      have hnd : n ≤ d := by exact_mod_cast hn
      exact spanningFamily_pad hnd v hv
  · ext x
    simp [J]
  · intro _
    have hfit := (Scheme.Modules.fitting_ideal_generate_locally
      T g.relativeDifferentials 1).1
    apply (Classical.choose_spec (Scheme.existsUnique_firstFittingIdealSheaf g)).2
    intro U
    obtain ⟨n, π, hπ, _⟩ :=
      (Classical.choose_spec (Scheme.existsUnique_firstFittingIdealSheaf g)).1 U
    exact ⟨n, π, hπ, hfit U n π hπ⟩

end AlgebraicGeometry
