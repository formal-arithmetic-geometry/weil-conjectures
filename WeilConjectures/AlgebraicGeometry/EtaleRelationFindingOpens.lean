/-!
# Restriction of a quotient by an fppf relation is an open subspace

Source: Stacks Project, `literature/stacks-project/spaces.tex`, Tag 02WU
(lemma-finding-opens), using Tag 02VH for restriction of the relation and Tags 023Q/02W2
for fppf descent of opens (blueprint: lem-trf-etale-relation-finding-opens).
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.AlgebraicSpace

/-- A universal map to a sheaf is locally surjective, even when the site is larger than
the value universe. This is the local-surjectivity argument used for quotient sheaves in
Stacks Tag 02WU (blueprint: lem-trf-etale-relation-finding-opens). -/
theorem universal_locally_surjective
    {C : Type*} [Category C] (J : GrothendieckTopology C)
    (P : Cᵒᵖ ⥤ Type u) (F : Sheaf J (Type u)) (η : P ⟶ F.obj)
    (hη : ∀ G : Sheaf J (Type u),
      Function.Bijective (fun k : F.obj ⟶ G.obj ↦ η ≫ k)) :
    Presheaf.IsLocallySurjective J η := by
  let A := (Subfunctor.range η).sheafify J
  have hA : Presheaf.IsSheaf J A.toFunctor :=
    (isSheaf_iff_isSheaf_of_type J _).mpr
      ((Subfunctor.range η).sheafify_isSheaf
        ((isSheaf_iff_isSheaf_of_type J _).mp F.property))
  obtain ⟨l, hl⟩ := (hη ⟨A.toFunctor, hA⟩).surjective
    (Subfunctor.toRangeSheafify J η)
  have he : l ≫ A.ι = 𝟙 F.obj := by
    apply (hη F).injective
    simp only [← Category.assoc, hl]
    rfl
  rw [Presheaf.isLocallySurjective_iff_range_sheafify_eq_top']
  apply le_antisymm le_top
  intro T x _
  have hx : (l.app T x).val = x := by
    exact congrArg (fun k ↦ k.app T x) he
  exact hx ▸ (l.app T x).property

/-- Restricting a quotient sheaf by an equivalence relation along a flat, locally finitely
presented morphism is representable by an open immersion.
Source: Stacks Project, Spaces, Tag 02WU (lemma-finding-opens)
(blueprint: lem-trf-etale-relation-finding-opens).

Proof:
1. The Yoneda map of `g` followed by the quotient map coequalizes the restricted
   projections, by the two pullback equations. The coequalizer and sheafification
   universal properties give the canonical map `α` and its compatibility equation.
2. Each sheafification map is locally surjective, even on this large site: the
   subsheaf locally generated by its image is the whole sheaf, since the universal
   property gives a retraction of the inclusion. Coequalizer projections are
   sectionwise surjective, so both scheme-to-quotient maps are locally surjective.
3. Two representatives in `U'` with the same image in `F` determine a map into `R`
   by `etale_relation_kernel_pair`. Pairing this map with the two representatives
   gives a map into the restricted relation, so their images in `F'` coincide.
   For arbitrary sections, intersect the two covering image sieves, apply this
   argument to local representatives, and use sheaf separation to obtain injectivity.
4. Apply `relation_incidence_open_model` with this canonical injective map. Its
   pullback square at the identity of `U` supplies the open model required by
   `fppf_local_open_subfunctor_descent`. That theorem gives an open representing
   every base change. Flip its pullback square to match `IsRepresentableWith`.
   This follows Stacks Tags 045Z and 02WU, retaining the incidence and descent route. -/
theorem etale_relation_finding_opens
    {S : Scheme.{u}} {R U U' : Over S} (s t : R ⟶ U)
    [Mono (prod.lift s t)]
    (hrel : ∀ T : Over S, Equivalence (fun a b : T ⟶ U ↦
      ∃ r : T ⟶ R, r ≫ s = a ∧ r ≫ t = b))
    [Surjective s.left] [Flat s.left] [LocallyOfFinitePresentation s.left]
    [Surjective t.left] [Flat t.left] [LocallyOfFinitePresentation t.left]
    (g : U' ⟶ U) [Flat g.left] [LocallyOfFinitePresentation g.left]
    (F : Sheaf (Scheme.fppfTopology.over S) (Type u))
    (η : coequalizer (yoneda.map s) (yoneda.map t) ⟶ F.obj)
    (hη : ∀ G : Sheaf (Scheme.fppfTopology.over S) (Type u),
      Function.Bijective (fun k : F.obj ⟶ G.obj ↦ η ≫ k))
    (F' : Sheaf (Scheme.fppfTopology.over S) (Type u))
    (η' : coequalizer
      (yoneda.map (pullback.fst (pullback.snd g s ≫ t) g ≫ pullback.fst g s))
      (yoneda.map (pullback.snd (pullback.snd g s ≫ t) g)) ⟶ F'.obj)
    (hη' : ∀ G : Sheaf (Scheme.fppfTopology.over S) (Type u),
      Function.Bijective (fun k : F'.obj ⟶ G.obj ↦ η' ≫ k)) :
    ∃ α : F'.obj ⟶ F.obj,
      (coequalizer.π (yoneda.map (pullback.fst (pullback.snd g s ≫ t) g ≫ pullback.fst g s))
          (yoneda.map (pullback.snd (pullback.snd g s ≫ t) g)) ≫ η') ≫ α =
        yoneda.map g ≫ (coequalizer.π (yoneda.map s) (yoneda.map t) ≫ η) ∧
      AlgebraicSpace.IsRepresentableWith
        (fun _ _ p ↦ IsOpenImmersion p.left) α := by
  let a := pullback.fst (pullback.snd g s ≫ t) g ≫ pullback.fst g s
  let b := pullback.snd (pullback.snd g s ≫ t) g
  let q := coequalizer.π (yoneda.map s) (yoneda.map t) ≫ η
  let q' := coequalizer.π (yoneda.map a) (yoneda.map b) ≫ η'
  have hq : yoneda.map s ≫ q = yoneda.map t ≫ q := by
    dsimp [q]
    rw [← Category.assoc, ← Category.assoc, coequalizer.condition]
  have hab : yoneda.map a ≫ (yoneda.map g ≫ q) =
      yoneda.map b ≫ (yoneda.map g ≫ q) := by
    have hs : a ≫ g =
        (pullback.fst (pullback.snd g s ≫ t) g ≫ pullback.snd g s) ≫ s := by
      dsimp [a]
      simp only [Category.assoc, pullback.condition]
    have ht : b ≫ g =
        (pullback.fst (pullback.snd g s ≫ t) g ≫ pullback.snd g s) ≫ t := by
      dsimp [b]
      simp only [Category.assoc, pullback.condition]
    calc
      _ = yoneda.map (a ≫ g) ≫ q :=
        (Category.assoc (yoneda.map a) (yoneda.map g) q).symm.trans
          (congrArg (fun k ↦ k ≫ q) (yoneda.map_comp a g).symm)
      _ = yoneda.map (b ≫ g) ≫ q := by
        rw [hs, ht]
        simp only [Functor.map_comp, Category.assoc, hq]
      _ = _ := by rw [Functor.map_comp, Category.assoc]
  obtain ⟨α, hα⟩ := (hη' F).surjective
    (coequalizer.desc (yoneda.map g ≫ q) hab)
  change η' ≫ α = coequalizer.desc (yoneda.map g ≫ q) hab at hα
  have hcompat : q' ≫ α = yoneda.map g ≫ q := by
    dsimp [q']
    rw [Category.assoc, hα, coequalizer.π_desc]
  refine ⟨α, hcompat, ?_⟩
  have hηlocal := universal_locally_surjective _ _ F η hη
  have hη'local := universal_locally_surjective _ _ F' η' hη'
  have hπ : Presheaf.IsLocallySurjective (Scheme.fppfTopology.over S)
      (coequalizer.π (yoneda.map s) (yoneda.map t)) := by
    apply Presheaf.isLocallySurjective_of_surjective
    intro T
    exact (epi_iff_surjective _).mp inferInstance
  have hπ' : Presheaf.IsLocallySurjective (Scheme.fppfTopology.over S)
      (coequalizer.π (yoneda.map a) (yoneda.map b)) := by
    apply Presheaf.isLocallySurjective_of_surjective
    intro T
    exact (epi_iff_surjective _).mp inferInstance
  have hqlocal : Presheaf.IsLocallySurjective (Scheme.fppfTopology.over S) q := by
    dsimp [q]
    infer_instance
  have hq'local : Presheaf.IsLocallySurjective (Scheme.fppfTopology.over S) q' := by
    dsimp [q']
    infer_instance
  have hkp := Scheme.etale_relation_kernel_pair s t hrel F η hη
  have hreps (T : Over S) (u v : T ⟶ U')
      (huv : (yoneda.map (u ≫ g) ≫ q) = yoneda.map (v ≫ g) ≫ q) :
      q'.app (op T) u = q'.app (op T) v := by
    let r : T ⟶ R := yoneda.preimage (hkp.lift
      (yoneda.map (u ≫ g)) (yoneda.map (v ≫ g)) huv)
    have hrs : r ≫ s = u ≫ g := by
      apply yoneda.map_injective
      simp only [Functor.map_comp, r, Functor.map_preimage, IsPullback.lift_fst]
    have hrt : r ≫ t = v ≫ g := by
      apply yoneda.map_injective
      simp only [Functor.map_comp, r, Functor.map_preimage, IsPullback.lift_snd]
    let e : T ⟶ Limits.pullback g s := pullback.lift u r hrs.symm
    let d : T ⟶ Limits.pullback (pullback.snd g s ≫ t) g :=
      pullback.lift e v (by simpa only [Category.assoc, e, pullback.lift_snd_assoc]
        using hrt)
    have hda : d ≫ a = u := by simp [d, a, e]
    have hdb : d ≫ b = v := by simp [d, b]
    have heq : yoneda.map a ≫ q' = yoneda.map b ≫ q' := by
      dsimp [q']
      rw [← Category.assoc, ← Category.assoc, coequalizer.condition]
    have heq' := congrArg (fun k ↦ (yoneda.map d ≫ k).app (op T) (𝟙 T)) heq
    simpa [← Functor.map_comp, ← Category.assoc, hda, hdb] using heq'
  have hαinj : ∀ T : Over S, Function.Injective (α.app (op T)) := by
    intro T x y hxy
    let J := Scheme.fppfTopology.over S
    let Z := Presheaf.imageSieve q' x ⊓ Presheaf.imageSieve q' y
    have hZ : Z ∈ J T := J.intersection_covering
      (Presheaf.imageSieve_mem J q' x) (Presheaf.imageSieve_mem J q' y)
    apply (((isSheaf_iff_isSheaf_of_type J _).mp F'.property).isSeparated _ hZ).ext
    intro V f hf
    obtain ⟨u, hu⟩ := hf.1
    obtain ⟨v, hv⟩ := hf.2
    rw [← hu, ← hv]
    apply hreps
    apply yonedaEquiv.injective
    change q.app (op V) (u ≫ g) = q.app (op V) (v ≫ g)
    have hc := congrArg (fun k ↦ k.app (op V)) hcompat
    have hcu := congrArg (fun k ↦ k u) hc
    have hcv := congrArg (fun k ↦ k v) hc
    dsimp at hcu hcv
    rw [← hcu, ← hcv, hu, hv, NatTrans.naturality_apply,
      NatTrans.naturality_apply, hxy]
  obtain ⟨_, _, W, _, _, β, hβ, _⟩ :=
    Scheme.relation_incidence_open_model s t hrel g F η hη F' η' hη' α
      hcompat hαinj
  have hβid := hβ U (𝟙 U)
  simp only [Over.id_left, Scheme.Hom.id_preimage]
    at hβid
  obtain ⟨V, e, he, _⟩ := fppf_local_open_subfunctor_descent.{u, u} U F F' α hαinj q
    hqlocal W hβid.isoPullback hβid.isoPullback_hom_fst
  intro T aT
  refine ⟨Over.mk ((V T aT).ι ≫ T.hom), Over.homMk (V T aT).ι,
    (e T aT).hom ≫ pullback.snd aT α, ?_, ?_⟩
  · apply IsPullback.flip
    refine IsPullback.of_iso_pullback ⟨?_⟩ (e T aT) (he T aT) rfl
    rw [← he T aT, Category.assoc, pullback.condition, ← Category.assoc]
  · change IsOpenImmersion (V T aT).ι
    infer_instance

end AlgebraicGeometry.AlgebraicSpace
