/-! # Uniqueness of the normalized coefficient coordinates

Source: the source identifications in the coefficient-change proposition and its
opening transposition argument (blueprint: lem-pur-coefficient-coordinate-uniqueness).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.MonoidalCategory
open AlgebraicGeometry AlgebraicGeometry.Scheme
open AlgebraicGeometry.ProEtale.CondensedRing
open scoped CategoryTheory.Obj
namespace AlgebraicGeometry.ProEtale.PurityTransport

/-- The normalized first line and balanced tensor recursion determine all scalar
Tate coordinates uniquely.
Source: the canonical source identifications in det-sp-purity-coefficient-change
(blueprint: lem-pur-coefficient-coordinate-uniqueness).
Proof: the first-line normalization identifies the first fields. Choose the proved
balanced monoidal structure on extension of scalars. The two recursion normalizations
then identify every power with the same tensor power of that common first field.
Function extensionality identifies the power fields; all remaining fields are proofs. -/
theorem scalarLineCoordinates_unique (ell : ℕ) [Fact ell.Prime]
    {c c' : Coefficient ell} (a : c.bundled.{u} ell ⟶ c'.bundled ell)
    (ha : c.integralMap ell ≫ a.hom.hom = c'.integralMap ell) (X : Scheme.{u})
    (p q : ScalarLineCoordinates ell a ha X) : p = q := by
  obtain ⟨m, hm⟩ := Mod.exists_extendScalarsMonoidal
    (coefficientMap (Λ := c.obj ell) (Λ' := c'.obj ell) a.hom.hom X)
  cases p with
  | mk first hf power hp =>
    cases q with
    | mk first' hf' power' hp' =>
      have he : first = first' := eq_of_heq (hf.trans hf'.symm)
      cases he
      have hepower : power = power' := funext fun d ↦
        eq_of_heq ((hp m hm d).trans (hp' m hm d).symm)
      cases hepower
      rfl

end AlgebraicGeometry.ProEtale.PurityTransport
