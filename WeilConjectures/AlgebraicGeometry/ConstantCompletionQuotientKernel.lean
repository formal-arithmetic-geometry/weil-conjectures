module
public import WeilConjectures.AlgebraicGeometry.ConstantCompletionBasic

/-! Kernel characterization for a finite constant quotient.

## References

* Stacks Project, Tag 093M
-/
@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits Opposite

set_option autoImplicit false
universe u
namespace CategoryTheory.ConstantCompletion
variable {C : Type u} [SmallCategory C]

-- Set functions on coefficients extend to the underlying constant sheaves. They need
-- not respect any ring operations.
private def constantFunction (J : GrothendieckTopology C) {A : Type u} [CommRing A]
    (f : A → A) : (constant J A).obj ⋙ forget CommRingCat ⟶
      (constant J A).obj ⋙ forget CommRingCat :=
  let P := (Functor.const Cᵒᵖ).obj (CommRingCat.of A)
  let e := sheafifyComposeIso J (forget CommRingCat) P
  e.inv ≫ sheafifyMap J ((Functor.const Cᵒᵖ).map (TypeCat.ofHom f)) ≫ e.hom

private theorem constantFunction_constant (J : GrothendieckTopology C)
    {A : Type u} [CommRing A] (f : A → A) (U : Cᵒᵖ) (a : A) :
    (constantFunction J f).app U ((constantSection (J := J) a).val U) =
      (constantSection (J := J) (f a)).val U := by
  let P := (Functor.const Cᵒᵖ).obj (CommRingCat.of A)
  have h : Functor.whiskerRight (toSheafify J P) (forget CommRingCat) ≫
      constantFunction J f =
      (Functor.const Cᵒᵖ).map (TypeCat.ofHom f) ≫
        Functor.whiskerRight (toSheafify J P) (forget CommRingCat) := by
    dsimp only [constantFunction]
    rw [← Category.assoc, ← Category.assoc, sheafComposeIso_inv_fac,
      ← toSheafify_naturality, Category.assoc]
    erw [sheafComposeIso_hom_fac]
  exact congrArg (fun t ↦ t.app U a) h

/-- The kernel of the section map of a finite constant quotient is generated by the
constant sections of the defining ideal power (Stacks, Tag 093M). -/
theorem constant_quotient_kernel (J : GrothendieckTopology C) (A : Type u)
    [CommRing A] [IsNoetherianRing A] (I : Ideal A) (n : ℕ) (U : C) :
    RingHom.ker ((quotient J A I n).hom.app (op U)).hom =
      Ideal.span (Set.range (fun a : ↥(I ^ (n + 1)) ↦
        (constantSection (J := J) (a : A)).val (op U))) := by
  classical
  let K := I ^ (n + 1)
  let P := (Functor.const Cᵒᵖ).obj (CommRingCat.of A)
  let B := (constant J A).obj
  let η : P ⟶ B := toSheafify J P
  let Q := (Functor.const Cᵒᵖ).obj (CommRingCat.of (A ⧸ K))
  let ε := toSheafify J Q
  let q := (quotient J A I n).hom
  have hB : Presheaf.IsSheaf J B := (constant J A).property
  have hη (V W : Cᵒᵖ) (f : V ⟶ W) (a : A) :
      B.map f (η.app V a) = η.app W a :=
    (NatTrans.naturality_apply η f a).symm
  have hq (V : Cᵒᵖ) (a : A) :
      q.app V (η.app V a) = ε.app V (Ideal.Quotient.mk K a) := by
    exact (ConcreteCategory.congr_hom (NatTrans.congr_app (toSheafify_naturality J
      ((Functor.const Cᵒᵖ).map (CommRingCat.ofHom (Ideal.Quotient.mk K)))) V) a).symm
  obtain ⟨d, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian K)
  have hg' : Ideal.span (Set.range g) = K := hg
  have hex (a : A) (ha : a ∈ K) : ∃ c : Fin d → A, ∑ i, c i * g i = a :=
    Ideal.mem_span_range_iff_exists_fun.mp (hg'.symm ▸ ha)
  let c : A → Fin d → A := fun a ↦ if ha : a ∈ K then (hex a ha).choose else 0
  have hc (a : A) (ha : a ∈ K) : ∑ i, c a i * g i = a := by
    simpa only [c, dite_eq_left ha] using (hex a ha).choose_spec
  let t (i : Fin d) := constantFunction J (fun a ↦ c a i)
  have htn (i : Fin d) {V W : Cᵒᵖ} (f : V ⟶ W) (y : B.obj V) :
      B.map f ((t i).app V y) = (t i).app W (B.map f y) :=
    (NatTrans.naturality_apply (t i) f y).symm
  apply le_antisymm
  · intro x hx
    have hxq : q.app (op U) x = 0 := hx
    have heq : (∑ i, (show B.obj (op U) from (t i).app (op U) x) * η.app (op U) (g i)) = x := by
      apply hB.isSeparated _ _ (Presheaf.imageSieve_mem J η x)
      intro V f hf
      obtain ⟨a, ha⟩ := hf
      change A at a
      have hqa : ε.app (op V) (Ideal.Quotient.mk K a) = ε.app (op V) 0 := by
        rw [← hq, ha, NatTrans.naturality_apply q, hxq, map_zero, map_zero]
      apply hB.isSeparated _ _ (Presheaf.equalizerSieve_mem J ε _ _ hqa)
      intro W k hk
      have hak : a ∈ K := Ideal.Quotient.eq_zero_iff_mem.mp (show
        Ideal.Quotient.mk K a = 0 from hk)
      have hax : B.map k.op (B.map f.op x) = η.app (op W) a := by
        rw [← ha, hη]
      have ht (i : Fin d) :
          B.map k.op (B.map f.op ((t i).app (op U) x)) =
            η.app (op W) (c a i) := by
        rw [htn, htn, hax]
        exact constantFunction_constant J _ _ _
      simp only [map_sum, map_mul, ht, hη]
      simp_rw [← map_mul]
      rw [← map_sum]
      exact congrArg (η.app (op W)) (hc a hak) |>.trans hax.symm
    rw [← heq]
    apply Submodule.sum_mem
    intro i _
    apply Ideal.mul_mem_left
    apply Ideal.subset_span
    refine ⟨⟨g i, ?_⟩, rfl⟩
    change g i ∈ K
    rw [← hg']
    exact Ideal.subset_span (Set.mem_range_self i)
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    change q.app (op U) (η.app (op U) a.val) = 0
    rw [hq, Ideal.Quotient.eq_zero_iff_mem.mpr a.property, map_zero]

end CategoryTheory.ConstantCompletion
