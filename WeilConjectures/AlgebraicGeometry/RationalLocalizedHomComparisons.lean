-- The two coefficient inclusions are definitionally identical for the induced norm.
private theorem pushComparison_iso (ℓ : ℕ) [hℓ : Fact ℓ.Prime]
    (E : PadicAlgCl.FiniteIntermediateField ℓ) {X Y : Scheme.{u}} (f : X ⟶ Y)
    [QuasiCompact f] [QuasiSeparated f] (K : integral X ℓ E)
    (hK : integralConstructible X ℓ E K) :
    IsIso ((CondensedRing.derivedPushHom
      (padicIntegersRingObjToContinuousMapRingObj ℓ E) f).app K) := by
  let : NormedAlgebra ℚ_[ℓ] E.1 := coefficientNormedAlgebra ℓ E
  exact @CondensedRing.integralScalarPushHom_isIso.{u} ℓ hℓ E.1
    (coefficientNorm ℓ E) (coefficientNormedAlgebra ℓ E) X Y f
    inferInstance inferInstance ⟨K, hK⟩

private theorem shriek_preserves_integral
    (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k]
    [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ℓ)]
    (E : PadicAlgCl.FiniteIntermediateField ℓ)
    {X Y : Over (Spec (.of k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsSeparated Y.hom]
    (f : X ⟶ Y) (K : integral X.left ℓ E) (hK : integralConstructible X.left ℓ E K) :
    integralConstructible Y.left ℓ E
      ((shriek (Profinite.padicIntegersRingObj ℓ E.1) f).obj K) := by
  let c := CondensedRing.compactificationOverField f
  exact CondensedRing.PadicIntegersRingObj.boundedConstructible_rightDerivedLowerStar_obj
    ℓ E.1 c.overG ⟨_, CondensedRing.boundedConstructible_openImmersionLowerShriek_obj
      (Profinite.padicIntegersRingObj ℓ E.1) ℓ c.overI ⟨K, hK⟩⟩

private theorem shriek_preserves_rational
    (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k]
    [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ℓ)]
    (E : PadicAlgCl.FiniteIntermediateField ℓ)
    {X Y : Over (Spec (.of k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsSeparated Y.hom]
    (f : X ⟶ Y) (K : rational X.left ℓ E) (hK : rationalConstructible X.left ℓ E K) :
    rationalConstructible Y.left ℓ E
      ((shriek (Profinite.continuousMapRingObj E.1) f).obj K) := by
  let c := CondensedRing.compactificationOverField f
  exact CondensedRing.ContinuousMapRingObj.boundedConstructible_rightDerivedLowerStar_obj
    ℓ E c.overG ⟨_, CondensedRing.boundedConstructible_openImmersionLowerShriek_obj
      (Profinite.continuousMapRingObj E.1) ℓ c.overI ⟨K, hK⟩⟩

