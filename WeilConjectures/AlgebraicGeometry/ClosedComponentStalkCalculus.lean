/-! # Closed components and their ordinary stalk ideals

Source: Stacks Project, Schemes Tags 01IN, 01HV, 01J3; Algebra Tags 00CT, 00ES, 00E3;
Morphisms Tag 0C4H; Étale Cohomology Tag 0BIA
(blueprint: lem-sfb-closed-component-stalk-calculus).

The existing `HilbertSamuel.stalkIdeal` denotes the ideal generated by affine germs.
Finite intersections are cut out by the supremum (sum) of ideal sheaves. Finite reduced
unions use `vanishingIdeal` of the supremum of the closed supports. Components are
indexed without repetitions by `Fin n`, including `n = 0` for the empty subscheme.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe u

open CategoryTheory TopologicalSpace
open AlgebraicGeometry.Scheme.IdealSheafData AlgebraicGeometry.HilbertSamuel

namespace AlgebraicGeometry

private lemma stalkIdeal_affine {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens) (x : X) (hx : x ∈ U.1) :
    stalkIdeal I x = (I.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
  apply le_antisymm
  · apply iSup_le
    intro V
    apply iSup_le
    intro hxV
    obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWU⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open
        (show x ∈ (U.1 ⊓ V.1) from ⟨hx, hxV⟩) (U.1 ⊓ V.1).isOpen
    have hWU' : W ≤ U.1 := fun y hy ↦ (hWU hy).1
    have hWV' : W ≤ V.1 := fun y hy ↦ (hWU hy).2
    have hf (T : X.affineOpens) (hWT : W ≤ T.1) (hxT : x ∈ T.1) :
        (I.ideal T).map (X.presheaf.germ T.1 x hxT).hom =
          (I.ideal ⟨W, hW⟩).map (X.presheaf.germ W x hxW).hom := by
      rw [← I.map_ideal (U := ⟨W, hW⟩) (V := T) hWT, Ideal.map_map,
        ← CommRingCat.hom_comp]
      exact congrArg (fun f : Γ(X, T.1) ⟶ X.presheaf.stalk x ↦
        (I.ideal T).map f.hom) (X.presheaf.germ_res (homOfLE hWT) x hxW).symm
    rw [hf V hWV' hxV, hf U hWU' hx]
  · exact le_iSup_of_le U (le_iSup_of_le hx le_rfl)

private lemma stalkIdeal_iSup {X : Scheme.{u}} {α : Type*}
    (I : α → X.IdealSheafData) (x : X) :
    stalkIdeal (⨆ j, I j) x = ⨆ j, stalkIdeal (I j) x := by
  obtain ⟨V, hV, hx, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := x) (by simp)
  let U : X.affineOpens := ⟨V, hV⟩
  simp only [stalkIdeal_affine _ U x hx, ideal_iSup, iSup_apply, Ideal.map_iSup]

private lemma stalkIdeal_iInf {X : Scheme.{u}} {α : Type*} [Finite α]
    (I : α → X.IdealSheafData) (x : X) :
    stalkIdeal (⨅ j, I j) x = ⨅ j, stalkIdeal (I j) x := by
  obtain ⟨V, hV, hx, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := x) (by simp)
  let U : X.affineOpens := ⟨V, hV⟩
  let := X.presheaf.algebra_section_stalk ⟨x, hx⟩
  have := U.2.isLocalization_stalk ⟨x, hx⟩
  simp only [stalkIdeal_affine _ U x hx, ideal_iInf, iInf_apply]
  let := Fintype.ofFinite α
  have hm : algebraMap Γ(X, U.1) (X.presheaf.stalk x) =
      (X.presheaf.germ U.1 x hx).hom := rfl
  have hi := map_finset_inf
    (IsLocalization.mapFrameHom (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      (X.presheaf.stalk x)) Finset.univ (fun j ↦ (I j).ideal U)
  simp only [Finset.inf_eq_iInf, Finset.mem_univ, iInf_true, Function.comp_apply,
    IsLocalization.mapFrameHom_apply] at hi
  rw [hm] at hi
  exact hi

private lemma stalkIdeal_off_support {X : Scheme.{u}} (I : X.IdealSheafData)
    (x : X) (hx : x ∉ I.support) : stalkIdeal I x = ⊤ := by
  obtain ⟨V, hV, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := x) (by simp)
  let U : X.affineOpens := ⟨V, hV⟩
  rw [stalkIdeal_affine I U x hxU]
  have h : ¬ ∀ a ∈ I.ideal U, ¬ IsUnit (X.presheaf.germ U.1 x hxU a) := by
    simpa only [mem_support_iff_of_mem (U := U) hxU, Scheme.mem_zeroLocus_iff,
      SetLike.mem_coe, X.mem_basicOpen _ x hxU] using hx
  push Not at h
  obtain ⟨a, ha, hu⟩ := h
  exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ ha) hu

private lemma reduced_ideal_eq {X : Scheme.{u}} (I : X.IdealSheafData)
    [IsReduced I.subscheme] : vanishingIdeal I.support = I := by
  have hc : (⟨closure (I.support : Set X), isClosed_closure⟩ :
      TopologicalSpace.Closeds X) = I.support :=
    TopologicalSpace.Closeds.ext I.support.isClosed.closure_eq
  simpa only [ker_subschemeι, range_subschemeι, hc]
    using I.subschemeι.ker_eq_vanishingIdeal.symm

private lemma closed_affine_prime {X : Scheme.{u}} (C : TopologicalSpace.Closeds X)
    (hC : IsIrreducible (C : Set X)) (U : X.affineOpens) (x : X)
    (hxU : x ∈ U.1) (hxC : x ∈ C) :
    ((vanishingIdeal C).ideal U).IsPrime ∧
      (vanishingIdeal C).ideal U ≤ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal := by
  have hr : x ∈ Set.range U.2.fromSpec :=
    ⟨U.2.primeIdealOf ⟨x, hxU⟩, U.2.fromSpec_primeIdealOf ⟨x, hxU⟩⟩
  have hi := hC.preimage U.2.fromSpec.isOpenEmbedding ⟨x, hxC, hr⟩
  refine ⟨PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hi, ?_⟩
  exact PrimeSpectrum.subset_zeroLocus_vanishingIdeal _
    (show U.2.primeIdealOf ⟨x, hxU⟩ ∈ U.2.fromSpec ⁻¹' (C : Set X) by
      change U.2.fromSpec (U.2.primeIdealOf ⟨x, hxU⟩) ∈ (C : Set X)
      rw [U.2.fromSpec_primeIdealOf]
      exact hxC)

private lemma closed_stalk_prime {X : Scheme.{u}} (C : TopologicalSpace.Closeds X)
    (hC : IsIrreducible (C : Set X)) (x : X) (hxC : x ∈ C) :
    (stalkIdeal (vanishingIdeal C) x).IsPrime := by
  obtain ⟨V, hV, hx, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := x) (by simp)
  let U : X.affineOpens := ⟨V, hV⟩
  let := X.presheaf.algebra_section_stalk ⟨x, hx⟩
  have := U.2.isLocalization_stalk ⟨x, hx⟩
  obtain ⟨hq, hqp⟩ := closed_affine_prime C hC U x hx hxC
  rw [stalkIdeal_affine _ U x hx]
  exact IsLocalization.isPrime_of_isPrime_disjoint
    (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl (X.presheaf.stalk x) _ hq
    (Set.disjoint_left.mpr fun a ha hb ↦ ha (hqp hb))

private lemma closed_stalk_le {X : Scheme.{u}} (C D : TopologicalSpace.Closeds X)
    (hC : IsIrreducible (C : Set X)) (hD : IsIrreducible (D : Set X))
    (x : X) (hxC : x ∈ C) (hxD : x ∈ D)
    (hle : stalkIdeal (vanishingIdeal C) x ≤ stalkIdeal (vanishingIdeal D) x) :
    D ≤ C := by
  obtain ⟨V, hV, hx, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := x) (by simp)
  let U : X.affineOpens := ⟨V, hV⟩
  let p := (U.2.primeIdealOf ⟨x, hx⟩).asIdeal
  let := X.presheaf.algebra_section_stalk ⟨x, hx⟩
  have := U.2.isLocalization_stalk ⟨x, hx⟩
  have contract (E : TopologicalSpace.Closeds X) (hE : IsIrreducible (E : Set X))
      (hxE : x ∈ E) :
      (stalkIdeal (vanishingIdeal E) x).comap (X.presheaf.germ U.1 x hx).hom =
        (vanishingIdeal E).ideal U := by
    obtain ⟨hq, hqp⟩ := closed_affine_prime E hE U x hx hxE
    rw [stalkIdeal_affine _ U x hx]
    exact IsLocalization.under_map_of_isPrime_disjoint p.primeCompl
      (X.presheaf.stalk x) hq
      (Set.disjoint_left.mpr fun a ha hb ↦ ha (hqp hb))
  have hq : (vanishingIdeal C).ideal U ≤ (vanishingIdeal D).ideal U := by
    rw [← contract C hC hxC, ← contract D hD hxD]
    exact Ideal.comap_mono hle
  have hpre : U.2.fromSpec ⁻¹' (D : Set X) ⊆ U.2.fromSpec ⁻¹' (C : Set X) :=
    (PrimeSpectrum.vanishingIdeal_anti_mono_iff
      (C.isClosed.preimage U.2.fromSpec.continuous)).mpr hq
  have hdense := closure_image_preimage_of_isPreirreducible U.2.fromSpec
    U.2.fromSpec.isOpenEmbedding.isOpenMap (D : Set X)
    ⟨U.2.primeIdealOf ⟨x, hx⟩, by
      change U.2.fromSpec (U.2.primeIdealOf ⟨x, hx⟩) ∈ (D : Set X)
      rw [U.2.fromSpec_primeIdealOf]
      exact hxD⟩
    hD.isPreirreducible D.isClosed
  change (D : Set X) ⊆ (C : Set X)
  rw [← hdense]
  exact closure_minimal ((Set.image_mono hpre).trans (Set.image_preimage_subset _ _))
    C.isClosed

private lemma finite_minimal_primes {R : Type*} [CommRing R] {α : Type*} [Finite α]
    (P : α → Ideal R) (s : Set α) (hs : ∀ j ∉ s, P j = ⊤)
    (hp : ∀ j ∈ s, (P j).IsPrime)
    (ha : ∀ j ∈ s, ∀ k ∈ s, P j ≤ P k → j = k) :
    Set.BijOn P s (⨅ j, P j).minimalPrimes := by
  classical
  let := Fintype.ofFinite α
  have find (Q : Ideal R) (hQ : Q.IsPrime) (h : (⨅ j, P j) ≤ Q) :
      ∃ j ∈ s, P j ≤ Q := by
    have h' : Finset.univ.inf P ≤ Q := by
      simpa only [Finset.inf_eq_iInf, Finset.mem_univ, iInf_true] using h
    obtain ⟨j, _, hj⟩ := hQ.inf_le'.mp h'
    refine ⟨j, ?_, hj⟩
    by_contra hjs
    exact hQ.ne_top (top_le_iff.mp ((hs j hjs) ▸ hj))
  refine ⟨?_, ?_, ?_⟩
  · intro j hj
    refine ⟨⟨hp j hj, iInf_le P j⟩, ?_⟩
    intro Q hQ hQj
    obtain ⟨k, hk, hkQ⟩ := find Q hQ.1 hQ.2
    have hkj := ha k hk j hj (hkQ.trans hQj)
    simpa only [hkj] using hkQ
  · intro j hj k hk he
    exact ha j hj k hk he.le
  · intro Q hQ
    obtain ⟨j, hj, hjQ⟩ := find Q hQ.1.1 hQ.1.2
    exact ⟨j, hj, le_antisymm hjQ (hQ.2 ⟨hp j hj, iInf_le P j⟩ hjQ)⟩

/-- Closed components, reduced unions and scheme-theoretic intersections at ordinary stalks.
Source: Stacks Project, Tags 01IN, 01HV, 01J3, 00CT, 00ES, 00E3, 0C4H and 0BIA
(blueprint: lem-sfb-closed-component-stalk-calculus).

Proof:
1. On an affine open, the defining ideal sheaf is the tilde of its section ideal.
   The affine-open stalk localization and tilde-stalk localization theorems identify
   its image in the ambient stalk with the extended ideal: fractions a/s with a in I
   are exactly the ideal generated by a/1. This is equality of ideals, including the
   comparison under the canonical ambient localization isomorphism.
2. The affine description of a closed immersion identifies its inverse image with
   Spec(B/I). Localization of a quotient (Tag 00CT) identifies its local ring with
   B_p/I B_p, sending the class of b/s to the germ of its restriction. The displayed
   formula on b/1 determines this ring isomorphism, since denominators become units.
3. Off the closed image some a in I avoids p. Its germ is a unit in the extended ideal,
   so the stalk ideal is the whole ring (also for components missing the point).
4. Scheme-theoretic intersections are cut out by sums (Tag 0C4H). Localization commutes
   with sums because both sides have the same generators. The empty sum is zero,
   cutting out X, so the empty intersection is included.
5. Finite intersections of ideals commute with localization: for a/s in every localized
   ideal choose a denominator t_j outside p with t_j a in I_j, and multiply the finitely
   many t_j. For an empty family both sides are the unit ideal.
6. The reduced induced structure (Tag 01J3) has the ideal of sections vanishing in all
   residue fields on its support. Vanishing on a finite union means vanishing on each
   member. For reduced members their defining ideals are exactly these vanishing
   ideals. Step 5 gives the asserted stalk intersection, also for the empty union.
7. A closed subset of a Noetherian scheme has finitely many distinct irreducible
   components. Their reduced induced structures are nonempty, reduced and irreducible,
   hence integral. Their supports cover H. If H is reduced, uniqueness in Tag 01J3
   identifies their reduced union with H itself. The empty H gives the empty family.
8. Intersecting components with an affine open gives its components: closure and open
   restriction give inverse order correspondences on irreducible closed subsets meeting
   the open. On Spec(B/I), Tag 00ES identifies components with minimal primes over I.
9. A component contains x precisely when its affine prime q is contained in p. Prime
   localization (Tag 00E3) sends q to q B_p, preserving and reflecting minimality over
   I: any smaller prime is still below p. Step 1 identifies this extension with its
   actual stalk ideal, proving the claimed bijection, not just an abstract bijection.
10. Apply step 6 to the components and discard the unit stalk ideals of step 3. This
    leaves the intersection over components through x. Off H both this family and
    the set of primes above the unit ideal are empty. No regularity is used. -/
theorem closed_component_stalk_calculus (X H : Scheme.{u})
    [IsLocallyNoetherian X] [CompactSpace X] (i : H ⟶ X) [IsClosedImmersion i] :
    (∀ (U : X.affineOpens) (x : X) (hx : x ∈ U.1),
      stalkIdeal i.ker x = (i.ker.ideal U).map (X.presheaf.germ U.1 x hx).hom ∧
      ∃ e : X.presheaf.stalk x ≃+*
          Localization.AtPrime (U.2.primeIdealOf ⟨x, hx⟩).asIdeal,
        (∀ b : Γ(X, U.1), e (X.presheaf.germ U.1 x hx b) = algebraMap _ _ b) ∧
        (stalkIdeal i.ker x).map e.toRingHom =
          (i.ker.ideal U).map (algebraMap _ _)) ∧
    (∀ (U : X.affineOpens) (z : H) (hz : i z ∈ U.1),
      ∃ e : (Localization.AtPrime (U.2.primeIdealOf ⟨i z, hz⟩).asIdeal) ⧸
          (i.ker.ideal U).map (algebraMap _ _) ≃+* H.presheaf.stalk z,
        ∀ b : Γ(X, U.1),
          e (Ideal.Quotient.mk _ (algebraMap _ _ b)) =
            i.stalkMap z (X.presheaf.germ U.1 (i z) hz b)) ∧
    (∀ x : X, x ∉ Set.range i → stalkIdeal i.ker x = ⊤) ∧
    (∀ (n : ℕ) (J : Fin n → X.IdealSheafData) (x : X),
      stalkIdeal (⨆ j, J j) x = ⨆ j, stalkIdeal (J j) x) ∧
    (∀ (n : ℕ) (J : Fin n → X.IdealSheafData),
      (∀ j, IsReduced (J j).subscheme) → ∀ x : X,
        stalkIdeal (vanishingIdeal (⨆ j, (J j).support)) x =
          ⨅ j, stalkIdeal (J j) x) ∧
    (IsReduced H → ∃ (n : ℕ) (C : Fin n → TopologicalSpace.Closeds X),
      Function.Injective C ∧
      Set.range (fun j ↦ (C j : Set X)) = Set.image (Set.image i) (irreducibleComponents H) ∧
      (∀ j, IsIntegral (vanishingIdeal (C j)).subscheme) ∧
      i.ker = vanishingIdeal (⨆ j, C j) ∧
      (∀ x : X,
        Set.BijOn (fun j ↦ stalkIdeal (vanishingIdeal (C j)) x)
          {j | x ∈ C j} (stalkIdeal i.ker x).minimalPrimes) ∧
      (∀ (j : Fin n) (x : X), x ∉ C j → stalkIdeal (vanishingIdeal (C j)) x = ⊤) ∧
      (∀ x : X, stalkIdeal i.ker x =
        ⨅ (j : Fin n) (_ : x ∈ C j), stalkIdeal (vanishingIdeal (C j)) x)) := by
  classical
  have affine (U : X.affineOpens) (x : X) (hx : x ∈ U.1) :
      ∃ e : X.presheaf.stalk x ≃+*
          Localization.AtPrime (U.2.primeIdealOf ⟨x, hx⟩).asIdeal,
        ∀ b : Γ(X, U.1), e (X.presheaf.germ U.1 x hx b) = algebraMap _ _ b := by
    let := X.presheaf.algebra_section_stalk ⟨x, hx⟩
    have := U.2.isLocalization_stalk ⟨x, hx⟩
    exact ⟨(IsLocalization.algEquiv (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      (X.presheaf.stalk x) (Localization.AtPrime
        (U.2.primeIdealOf ⟨x, hx⟩).asIdeal)).toRingEquiv, fun b ↦ by
          exact AlgEquiv.commutes _ b⟩
  refine ⟨?_, ?_, ?_, fun n J x ↦ stalkIdeal_iSup J x, ?_, ?_⟩
  · intro U x hx
    obtain ⟨e, he⟩ := affine U x hx
    refine ⟨stalkIdeal_affine _ _ _ _, e, he, ?_⟩
    rw [stalkIdeal_affine _ U x hx, Ideal.map_map]
    congr 1
    exact RingHom.ext he
  · intro U z hz
    obtain ⟨e, he⟩ := affine U (i z) hz
    have hk : RingHom.ker (i.stalkMap z).hom =
        ((i.ker.ideal U).map (algebraMap _ _)).map e.symm.toRingHom := by
      rw [i.ker_stalkMap U z hz, Ideal.map_map]
      congr 1
      apply RingHom.ext
      intro b
      exact ((e.symm_apply_eq).mpr (he b).symm).symm
    refine ⟨(Ideal.quotientEquiv _ _ e.symm hk).trans
      ((i.stalkMap z).hom.quotientKerEquivOfSurjective (i.stalkMap_surjective z)), ?_⟩
    intro b
    simp only [RingEquiv.trans_apply, Ideal.quotientEquiv_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
    rw [← he b, e.symm_apply_apply]
  · intro x hx
    apply stalkIdeal_off_support
    change x ∉ (i.ker.support : Set X)
    rw [i.support_ker, i.isClosedEmbedding.isClosed_range.closure_eq]
    exact hx
  · intro n J hJ x
    have h (j : Fin n) : vanishingIdeal (J j).support = J j := by
      have := hJ j
      exact reduced_ideal_eq (J j)
    rw [vanishingIdeal_iSup]
    simp_rw [h]
    exact stalkIdeal_iInf J x
  · intro hH
    have : IsReduced H := hH
    have : IsNoetherian X := ⟨⟩
    have : NoetherianSpace H := i.isClosedEmbedding.isEmbedding.isInducing.noetherianSpace
    let K := irreducibleComponents H
    have hK : K.Finite := NoetherianSpace.finite_irreducibleComponents
    let := hK.fintype
    let e := (Fintype.equivFin K).symm
    let C (j : Fin (Fintype.card K)) : TopologicalSpace.Closeds X :=
      ⟨i '' (e j).1, i.isClosedEmbedding.isClosedMap _
        (isClosed_of_mem_irreducibleComponents _ (e j).2)⟩
    have hC (j : Fin (Fintype.card K)) : IsIrreducible (C j : Set X) :=
      (e j).2.1.image i i.continuous.continuousOn
    have hinj : Function.Injective C := by
      intro j k hjk
      apply e.injective
      apply Subtype.ext
      exact Set.image_injective.mpr i.isClosedEmbedding.injective
        (congrArg (fun T : TopologicalSpace.Closeds X ↦ (T : Set X)) hjk)
    have hrange : Set.range (fun j ↦ (C j : Set X)) =
        Set.image (Set.image i) (irreducibleComponents H) := by
      ext T
      constructor
      · rintro ⟨j, rfl⟩
        exact ⟨(e j).1, (e j).2, rfl⟩
      · rintro ⟨T, hT, rfl⟩
        obtain ⟨j, hj⟩ := e.surjective ⟨T, hT⟩
        exact ⟨j, congrArg (fun T : K ↦ i '' T.1) hj⟩
    have hcover : (⨆ j, C j : TopologicalSpace.Closeds X) =
        ⟨Set.range i, i.isClosedEmbedding.isClosed_range⟩ := by
      apply le_antisymm
      · exact iSup_le fun j ↦ Set.image_subset_range _ _
      · rintro x ⟨z, rfl⟩
        have hz : z ∈ ⋃₀ irreducibleComponents H := by
          rw [sUnion_irreducibleComponents]
          trivial
        obtain ⟨T, hT, hzT⟩ := hz
        obtain ⟨j, hj⟩ := e.surjective ⟨T, hT⟩
        apply (le_iSup C j : C j ≤ ⨆ j, C j)
        exact ⟨z, (congrArg Subtype.val hj).symm ▸ hzT, rfl⟩
    have hker : i.ker = vanishingIdeal (⨆ j, C j) := by
      rw [hcover, i.ker_eq_vanishingIdeal]
      congr 1
      exact TopologicalSpace.Closeds.ext i.isClosedEmbedding.isClosed_range.closure_eq
    have hoff (j : Fin (Fintype.card K)) (x : X) (hx : x ∉ C j) :
        stalkIdeal (vanishingIdeal (C j)) x = ⊤ := by
      apply stalkIdeal_off_support
      change x ∉ ((vanishingIdeal (C j)).support : Set X)
      rw [coe_support_vanishingIdeal]
      exact hx
    have hall (x : X) : stalkIdeal i.ker x =
        ⨅ j, stalkIdeal (vanishingIdeal (C j)) x := by
      rw [hker, vanishingIdeal_iSup, stalkIdeal_iInf]
    refine ⟨Fintype.card K, C, hinj, hrange, ?_, hker, ?_, hoff, ?_⟩
    · intro j
      let E := (vanishingIdeal (C j)).subscheme
      have hE : Set.range (vanishingIdeal (C j)).subschemeι = (C j : Set X) := by
        simp
      let f := (vanishingIdeal (C j)).subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph
      let g := f.trans (Homeomorph.setCongr hE)
      have : IrreducibleSpace (C j : Set X) := Subtype.irreducibleSpace (hC j)
      have : IrreducibleSpace E := g.irreducibleSpace_iff.mpr inferInstance
      have : IsReduced E := (reduced_induced_closed_subscheme X (C j)).2.2.2.1
      exact (isIntegral_iff_irreducibleSpace_and_isReduced E).mpr
        ⟨inferInstance, inferInstance⟩
    · intro x
      rw [hall]
      apply finite_minimal_primes _ {j | x ∈ C j} (fun j hj ↦ hoff j x hj)
        (fun j hj ↦ closed_stalk_prime (C j) (hC j) x hj)
      intro j hj k hk hjk
      apply e.injective
      apply Subtype.ext
      apply le_antisymm
      · exact (e k).2.2 (e j).2.1
          ((Set.image_subset_image_iff i.isClosedEmbedding.injective).mp
            (closed_stalk_le (C j) (C k) (hC j) (hC k) x hj hk hjk))
      · exact (Set.image_subset_image_iff i.isClosedEmbedding.injective).mp
          (closed_stalk_le (C j) (C k) (hC j) (hC k) x hj hk hjk)
    · intro x
      rw [hall]
      apply le_antisymm
      · exact le_iInf fun j ↦ le_iInf fun _ ↦ iInf_le _ j
      · apply le_iInf
        intro j
        by_cases hx : x ∈ C j
        · exact iInf_le_of_le j (iInf_le _ hx)
        · rw [hoff j x hx]
          exact le_top

end AlgebraicGeometry
