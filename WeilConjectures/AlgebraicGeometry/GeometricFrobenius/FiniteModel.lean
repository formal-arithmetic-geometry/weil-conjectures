/-!
# Models over finite fields of closed subschemes of a geometric fiber

Let `X₀` be an affine scheme of finite type over a finite field `k₀`, with geometric fiber
`X = X₀ ×_{k₀} k̄₀`, and let `C ⊆ X` be a closed subscheme which is a smooth connected curve over
`k̄₀` with a `k̄₀`-point. Then `C` and its inclusion into `X` are defined over a finite extension
`L` of `k₀` (of degree divisible by any given `M > 0`): there is a smooth geometrically connected
affine curve `Y` over `L` with an isomorphism `Ȳ = Y ×_L k̄_L ≅ C` compatible with the structure
morphisms (through a `k₀`-isomorphism `θ : k̄₀ ≅ k̄_L`) and with the geometric Galois Frobenii.

No Galois descent is needed: the ideal of `C` is finitely generated, so its generators, and the
coordinates of the `k̄₀`-point, have coefficients in a finite subfield `L` of `k̄₀`, and `Y` is
cut out of `X₀ ×_{k₀} L` by the same generators.

## Main statements

- `AlgebraicGeometry.Scheme.Hom.exists_finiteModel_of_isClosedImmersion`: blueprint
  `lem-zl-curve-testing-irreducibility` ("the curve and inclusion descend to a finite constant
  extension").
-/

@[expose] public section

universe u

open CategoryTheory Limits TensorProduct

noncomputable section

/-! ### General helper lemmas -/

namespace Algebra.TensorProduct

/-- Every element of `K ⊗[k] R`, for a field extension `K` of `k`, comes from `F ⊗[k] R` for
every intermediate field `F` containing a suitable finite set of coefficients. -/
theorem exists_finset_forall_mem_range_map_val {k K R : Type*} [Field k] [Field K] [Algebra k K]
    [CommRing R] [Algebra k R] (x : K ⊗[k] R) :
    ∃ T : Finset K, ∀ F : IntermediateField k K, (T : Set K) ⊆ F →
      x ∈ (map F.val (AlgHom.id k R)).range := by
  classical
  induction x using TensorProduct.inductionOn with
  | tmul a r =>
    refine ⟨{a}, fun F hF ↦ ⟨⟨a, hF (by simp)⟩ ⊗ₜ r, ?_⟩⟩
    simp
  | add x y hx hy =>
    obtain ⟨T₁, h₁⟩ := hx
    obtain ⟨T₂, h₂⟩ := hy
    refine ⟨T₁ ∪ T₂, fun F hF ↦ add_mem (h₁ F ?_) (h₂ F ?_)⟩
    · exact subset_trans (by simp) hF
    · exact subset_trans (by simp) hF

end Algebra.TensorProduct

namespace AlgebraicGeometry

open CommRingCat

set_option profiler true in
/-- Let `L` be an intermediate field of `K / k`, let `θ : K ≃ Ω` be an `L`-isomorphism, and let
`J` be an ideal of `K ⊗[k] R` generated by elements of `L ⊗[k] R`, so that `J` is the extension of
its contraction `J₀` to `L ⊗[k] R`. Then `(K ⊗[k] R) ⧸ J ≅ Ω ⊗[L] ((L ⊗[k] R) ⧸ J₀)` through
`a ⊗ r ↦ θ a ⊗ (1 ⊗ r)`. -/
theorem exists_ringEquiv_quotient_tensorProduct {k K R Ω : Type*} [Field k] [Field K]
    [Algebra k K] [CommRing R] [Algebra k R] {L : IntermediateField k K} [Field Ω] [Algebra L Ω]
    [Algebra k Ω] [IsScalarTower k L Ω] (θ : K ≃ₐ[L] Ω) (J : Ideal (K ⊗[k] R))
    (hJ : (J.comap (Algebra.TensorProduct.map L.val (AlgHom.id k R))).map
      (Algebra.TensorProduct.map L.val (AlgHom.id k R)) = J) :
    ∃ τ : (K ⊗[k] R) ⧸ J ≃+* Ω ⊗[L] ((L ⊗[k] R) ⧸
        J.comap (Algebra.TensorProduct.map L.val (AlgHom.id k R))),
      ∀ a r, τ (Ideal.Quotient.mk J (a ⊗ₜ r)) = θ a ⊗ₜ Ideal.Quotient.mk _ (1 ⊗ₜ r) := by
  let ι := Algebra.TensorProduct.map L.val (AlgHom.id k R)
  let J₀ := J.comap ι
  let Ψ : K ⊗[k] R ≃+* Ω ⊗[L] (L ⊗[k] R) :=
    (Algebra.TensorProduct.congr (θ.restrictScalars k) AlgEquiv.refl).toRingEquiv.trans
      (Algebra.TensorProduct.cancelBaseChange k L L Ω R).symm.toRingEquiv
  have hΨ (a : K) (r : R) : Ψ (a ⊗ₜ r) = θ a ⊗ₜ (1 ⊗ₜ r) := by
    simp [Ψ]
  have hΨι : (Ψ : K ⊗[k] R →+* _).comp (ι : L ⊗[k] R →+* K ⊗[k] R) =
      (Algebra.TensorProduct.includeRight : L ⊗[k] R →ₐ[L] Ω ⊗[L] (L ⊗[k] R)).toRingHom := by
    refine RingHom.ext fun x ↦ ?_
    induction x using TensorProduct.inductionOn with
    | tmul l r =>
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        ι, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hΨ,
        Algebra.TensorProduct.includeRight_apply]
      rw [IntermediateField.coe_val, ← IntermediateField.algebraMap_apply, AlgEquiv.commutes,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, TensorProduct.smul_tmul',
        smul_eq_mul, mul_one]
    | add x y hx hy => simp only [map_add, hx, hy]
  have hmap : J₀.map (Algebra.TensorProduct.includeRight :
      L ⊗[k] R →ₐ[L] Ω ⊗[L] (L ⊗[k] R)) = J.map (Ψ : K ⊗[k] R →+* _) := by
    rw [← hJ, ← Ideal.map_coe ι, Ideal.map_map, hΨι, AlgHom.toRingHom_eq_coe, Ideal.map_coe]
  let q := Ideal.quotientEquiv J _ Ψ hmap
  let t := Algebra.TensorProduct.tensorQuotientEquiv (R := L) L (L ⊗[k] R) Ω J₀
  refine ⟨q.trans t.symm.toRingEquiv, fun a r ↦ ?_⟩
  change t.symm (q (Ideal.Quotient.mk J (a ⊗ₜ r))) = _
  rw [show q (Ideal.Quotient.mk J (a ⊗ₜ r)) =
    Ideal.Quotient.mk _ (Ψ (a ⊗ₜ r)) from rfl, hΨ]
  exact Algebra.TensorProduct.tensorQuotientEquiv_symm_apply_tmul
    (R := L) L (L ⊗[k] R) Ω J₀ (θ a) (1 ⊗ₜ r)

namespace Scheme.Hom

set_option profiler true in
/-- **Finite-field models of closed subschemes of a geometric fiber** (blueprint:
`lem-zl-curve-testing-irreducibility`, "the curve and inclusion descend to a finite constant
extension"). Let `f : X₀ ⟶ Spec k₀` be an affine scheme of finite type over a finite field, with
geometric fiber `X`, and let `i : C ⟶ X` be a closed immersion of a smooth connected curve over
`k̄₀` with a `k̄₀`-point `c₀`. For every `M > 0` there are a finite extension `L` of `k₀` of degree
divisible by `M` and a smooth geometrically connected affine curve `g : Y ⟶ Spec L` with an
isomorphism `e : Ȳ ≅ C` of its geometric fiber, lying over a `k₀`-embedding `θ : k̄₀ ↪ k̄_L`,
such that `e ≫ i` intertwines the geometric Galois Frobenius of `Ȳ` with the `[L : k₀]`-th power
of that of `X`. -/
theorem exists_finiteModel_of_isClosedImmersion {k₀ : Type u} [Field k₀] [Finite k₀]
    {X₀ : Scheme.{u}} (f : X₀ ⟶ Spec (.of k₀)) [IsAffine X₀] [LocallyOfFiniteType f]
    {C : Scheme.{u}} (i : C ⟶ f.geometricFiber) [IsClosedImmersion i]
    (hC : SmoothOfRelativeDimension 1 (i ≫ f.geometricFiberToAlgebraicClosure))
    [ConnectedSpace C] (c₀ : Spec (.of (AlgebraicClosure k₀)) ⟶ C)
    (hc₀ : c₀ ≫ i ≫ f.geometricFiberToAlgebraicClosure = 𝟙 _) {M : ℕ} (hM : 0 < M) :
    ∃ (L : Type u) (_ : Field L) (_ : Finite L) (_ : Algebra k₀ L) (Y : Scheme.{u})
      (g : Y ⟶ Spec (.of L)),
      M ∣ Module.finrank k₀ L ∧ IsAffine Y ∧ SmoothOfRelativeDimension 1 g ∧
      GeometricallyConnected g ∧ IsSeparated g ∧ LocallyOfFiniteType g ∧ QuasiCompact g ∧
      ∃ (θ : AlgebraicClosure k₀ →ₐ[k₀] AlgebraicClosure L) (e : g.geometricFiber ≅ C),
        e.hom ≫ i ≫ f.geometricFiberToAlgebraicClosure =
          g.geometricFiberToAlgebraicClosure ≫ Spec.map (CommRingCat.ofHom θ.toRingHom) ∧
        (e.hom ≫ i) ≫ (f.geometricGaloisFrobenius ^ Module.finrank k₀ L).asIso.hom =
          g.geometricGaloisFrobenius.asIso.hom ≫ e.hom ≫ i := by
  classical
  obtain ⟨R, _, _, eR, heR⟩ := exists_iso_Spec_of_isAffine f
  set K := AlgebraicClosure k₀
  set eX := f.geometricFiberIsoSpec eR heR
  have : Algebra.FiniteType k₀ R := by
    have h : LocallyOfFiniteType (eR.hom ≫ Spec.map (ofHom (algebraMap k₀ R))) := by
      rw [heR]
      infer_instance
    rw [MorphismProperty.cancel_left_of_respectsIso (P := @LocallyOfFiniteType),
      HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)] at h
    exact RingHom.finiteType_algebraMap.mp h
  have : IsNoetherianRing (K ⊗[k₀] R) := Algebra.FiniteType.isNoetherianRing K _
  -- the ideal `J` of `C`
  obtain ⟨J, eC, hi⟩ := (IsClosedImmersion.Spec_iff (f := i ≫ eX.hom)).mp inferInstance
  obtain ⟨G, hG⟩ : J.FG := IsNoetherian.noetherian J
  -- the point `c₀` as a ring homomorphism `χ`
  obtain ⟨χ', hχ'⟩ : ∃ χ' : CommRingCat.of ((K ⊗[k₀] R) ⧸ J) ⟶ .of K,
      Spec.map χ' = c₀ ≫ eC.hom :=
    ⟨_, Spec.map_preimage _⟩
  have hχ : ofHom (algebraMap K (K ⊗[k₀] R)) ≫ ofHom (Ideal.Quotient.mk J) ≫ χ' = 𝟙 _ := by
    apply Spec.map_injective
    simp only [Spec.map_comp, hχ', Spec.map_id, Category.assoc]
    rw [← reassoc_of% hi, geometricFiberIsoSpec_hom_algebraMap, hc₀]
  let χ : K ⊗[k₀] R →ₐ[K] K :=
    { χ'.hom.comp (Ideal.Quotient.mk J) with
      commutes' a := congr($hχ a) }
  let χR : R →ₐ[k₀] K := (χ.restrictScalars k₀).comp Algebra.TensorProduct.includeRight
  -- the finite field `L`
  choose T hT using fun x : K ⊗[k₀] R ↦
    Algebra.TensorProduct.exists_finset_forall_mem_range_map_val x
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k₀) (A := R)
  obtain ⟨F, hF⟩ := FiniteField.exists_intermediateField_finrank_eq k₀ K hM
  let L : IntermediateField k₀ K :=
    IntermediateField.adjoin k₀ ((G.biUnion T ∪ s.image χR : Finset K) : Set K) ⊔ F
  have : FiniteDimensional k₀ (IntermediateField.adjoin k₀
      ((G.biUnion T ∪ s.image χR : Finset K) : Set K)) :=
    IntermediateField.finiteDimensional_adjoin fun x _ ↦ Algebra.IsIntegral.isIntegral x
  have : FiniteDimensional k₀ F := Module.finite_of_finrank_pos (hF ▸ hM)
  have : Finite L := Module.finite_of_finite k₀
  have hML : M ∣ Module.finrank k₀ L := hF ▸ IntermediateField.finrank_dvd_of_le_right le_sup_right
  have hLsub : ((G.biUnion T ∪ s.image χR : Finset K) : Set K) ⊆ L :=
    (IntermediateField.subset_adjoin _ _).trans (SetLike.coe_subset_coe.mpr le_sup_left)
  have hTL (x : K ⊗[k₀] R) (hx : x ∈ G) : (T x : Set K) ⊆ L := fun y hy ↦
    hLsub (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨x, hx, hy⟩)))
  have hχL (r : R) : χR r ∈ L := by
    have hle : Algebra.adjoin k₀ (s : Set R) ≤ L.toSubalgebra.comap χR :=
      Algebra.adjoin_le fun r hr ↦
        hLsub (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem χR hr)))
    exact hle (hs ▸ Algebra.mem_top)
  -- the ideal `J₀` of `L ⊗[k₀] R` cutting out the model
  let ι := Algebra.TensorProduct.map L.val (AlgHom.id k₀ R)
  have hJ₀ : (J.comap ι).map ι = J := by
    refine le_antisymm Ideal.map_comap_le ?_
    calc J = Ideal.span (G : Set (K ⊗[k₀] R)) := hG.symm
      _ ≤ _ := Ideal.span_le.mpr fun x hx ↦ ?_
    obtain ⟨y, rfl⟩ := hT x L (hTL x hx)
    exact Ideal.mem_map_of_mem _ (Ideal.mem_comap.mpr (hG ▸ Ideal.subset_span hx))
  set J₀ := J.comap ι
  let B := (L ⊗[k₀] R) ⧸ J₀
  let : Algebra L (L ⊗[k₀] R) := Algebra.TensorProduct.leftAlgebra
  let : Algebra L B := Ideal.Quotient.algebra L
  let : Module L B := Algebra.toModule
  let Ω := AlgebraicClosure L
  let : CommRing (Ω ⊗[L] B) := Algebra.TensorProduct.instCommRing
  let : Algebra Ω (Ω ⊗[L] B) := Algebra.TensorProduct.leftAlgebra
  have : Module.IsTorsionFree L K := DivisionSemiring.to_moduleIsTorsionFree
  have : Module.IsTorsionFree L Ω := DivisionSemiring.to_moduleIsTorsionFree
  have : Algebra.IsAlgebraic L K := Algebra.IsAlgebraic.tower_top (K := k₀) L
  let θ₀ : K →ₐ[L] Ω := IsAlgClosed.lift
  let θ' : K →ₐ[k₀] Ω := θ₀.restrictScalars k₀
  have hθ : Function.Bijective θ₀ := bijective_algHom_algebraicClosure θ'
  obtain ⟨τ, hτ⟩ := exists_ringEquiv_quotient_tensorProduct (AlgEquiv.ofBijective θ₀ hθ) J hJ₀
  -- the model `g : Y ⟶ Spec L` and the isomorphism `e : Ȳ ≅ C`
  let g : Spec (.of B) ⟶ Spec (.of L) := Spec.map (ofHom (algebraMap L B))
  let eY := g.geometricFiberIsoSpec (Iso.refl _) (Category.id_comp _)
  let φ : K ⊗[k₀] R →+* Ω ⊗[L] B := τ.toRingHom.comp (Ideal.Quotient.mk J)
  let e : g.geometricFiber ≅ C := eY ≪≫ Scheme.Spec.mapIso τ.toCommRingCatIso.op ≪≫ eC.symm
  have heφ : e.hom ≫ i ≫ eX.hom = eY.hom ≫ Spec.map (ofHom φ) := by
    simp only [e, Iso.trans_hom, Iso.symm_hom, Category.assoc, hi, Iso.inv_hom_id_assoc,
      Functor.mapIso_hom, Iso.op_hom, Scheme.Spec_map, Quiver.Hom.unop_op, ← Spec.map_comp]
    rfl
  have hφ₁ : ofHom (algebraMap K (K ⊗[k₀] R)) ≫ ofHom φ =
      ofHom θ'.toRingHom ≫ ofHom (algebraMap Ω (Ω ⊗[L] B)) := by
    ext a
    refine (hτ a 1).trans ?_
    rw [← Algebra.TensorProduct.one_def, map_one]
    rfl
  have hφ₂ : ofHom (Algebra.TensorProduct.includeRight : R →ₐ[k₀] K ⊗[k₀] R).toRingHom ≫
      ofHom φ = ofHom ((Ideal.Quotient.mk J₀).comp
        (Algebra.TensorProduct.includeRight : R →ₐ[k₀] L ⊗[k₀] R).toRingHom) ≫
        ofHom (Algebra.TensorProduct.includeRight : B →ₐ[L] Ω ⊗[L] B).toRingHom := by
    ext r
    refine (hτ 1 r).trans ?_
    rw [map_one]
    rfl
  let ρ : R →+* B := (Ideal.Quotient.mk J₀).comp
    (Algebra.TensorProduct.includeRight : R →ₐ[k₀] L ⊗[k₀] R).toRingHom
  let h : Spec (.of B) ⟶ X₀ := Spec.map (ofHom ρ) ≫ eR.inv
  have hh : h ≫ f = g ≫ Spec.map (ofHom (algebraMap k₀ L)) := by
    rw [← heR, Category.assoc, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    ext c
    simp only [CommRingCat.hom_comp, hom_ofHom, RingHom.comp_apply,
      ← IsScalarTower.algebraMap_apply, ρ]
    exact congrArg (Ideal.Quotient.mk J₀) (Algebra.TensorProduct.includeRight.commutes c)
  let ιY := geometricFiberExtensionMap g (g ≫ Spec.map (ofHom (algebraMap k₀ L))) rfl θ'
  have he : e.hom ≫ i = ιY ≫ geometricFiberMap h hh := by
    rw [← cancel_mono eX.hom, Category.assoc, heφ]
    refine (isPullback_Spec_tensorProduct k₀ K R).hom_ext ?_ ?_
    · simp only [Category.assoc]
      rw [geometricFiberIsoSpec_hom_algebraMap,
        geometricFiberMap_comp_geometricFiberToAlgebraicClosure,
        geometricFiberExtensionMap_comp_geometricFiberToAlgebraicClosure, ← Spec.map_comp, hφ₁,
        Spec.map_comp, geometricFiberIsoSpec_hom_algebraMap_assoc]
    · simp only [Category.assoc]
      rw [geometricFiberIsoSpec_hom_includeRight,
        geometricFiberMap_comp_geometricFiberProj_assoc,
        geometricFiberExtensionMap_comp_geometricFiberProj_assoc, ← Spec.map_comp, hφ₂,
        Spec.map_comp, geometricFiberIsoSpec_hom_includeRight_assoc]
      simp [h, ρ]
  have h₁ : e.hom ≫ i ≫ f.geometricFiberToAlgebraicClosure =
      g.geometricFiberToAlgebraicClosure ≫ Spec.map (ofHom θ'.toRingHom) := by
    rw [reassoc_of% he]
    simp [ιY]
  -- smoothness and connectedness descend from `Ȳ ≅ C`
  have hsm : SmoothOfRelativeDimension 1 g.geometricFiberToAlgebraicClosure := by
    have h₂ := (MorphismProperty.cancel_left_of_respectsIso (@SmoothOfRelativeDimension 1)
      e.hom _).mpr hC
    rwa [h₁, ← specAlgHomAlgebraicClosureIso_hom,
      MorphismProperty.cancel_right_of_respectsIso (@SmoothOfRelativeDimension 1)] at h₂
  have hP : IsPullback g.geometricFiberProj g.geometricFiberToAlgebraicClosure g
      (Spec.map (ofHom (algebraMap L Ω))) :=
    IsPullback.of_hasPullback _ _
  have : ConnectedSpace g.geometricFiber := Scheme.connectedSpace_of_iso e.symm
  have : ConnectedSpace (Spec (.of B)) := connectedSpace_of_isPullback_Spec_map_algebraMap hP
  -- the `L`-rational point of `Y` induced by `c₀`
  have hmem (x : L ⊗[k₀] R) : χ (ι x) ∈ L := by
    induction x using TensorProduct.inductionOn with
    | tmul l r =>
      have hl : ι (l ⊗ₜ r) = algebraMap K (K ⊗[k₀] R) l *
          (Algebra.TensorProduct.includeRight : R →ₐ[k₀] K ⊗[k₀] R) r := by
        simp [ι]
      rw [hl, map_mul, AlgHom.commutes]
      exact mul_mem l.2 (hχL r)
    | add x y hx hy =>
      rw [map_add, map_add]
      exact add_mem hx hy
  let σ₀ : L ⊗[k₀] R →+* L := (χ.toRingHom.comp ι.toRingHom).codRestrict L hmem
  let σ : B →+* L := Ideal.Quotient.lift J₀ σ₀ fun x hx ↦ by
    refine Subtype.ext ?_
    simp only [σ₀, RingHom.codRestrict_apply, ZeroMemClass.coe_zero]
    exact (congrArg χ'.hom (Ideal.Quotient.eq_zero_iff_mem.mpr hx)).trans (map_zero _)
  have hσl (l : L) : σ (algebraMap L B l) = l := by
    rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk]
    refine Subtype.ext ((congrArg χ ?_).trans (χ.commutes (l : K)))
    simp [ι, Algebra.TensorProduct.algebraMap_apply]
  have hσ : Spec.map (ofHom σ) ≫ g = 𝟙 _ := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext l
    exact congrArg Subtype.val (hσl l)
  have : LocallyOfFiniteType g :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)
  refine ⟨L, inferInstance, inferInstance, inferInstance, Spec (.of B), g, hML, inferInstance,
    of_isPullback_Spec_map_algebraMap _ hP hsm,
    GeometricallyConnected.of_connectedSpace_of_section g _ hσ, inferInstance, inferInstance,
    inferInstance, θ', e, h₁, ?_⟩
  rw [he, Category.assoc, geometricFiberMap_comp_geometricGaloisFrobenius_pow,
    geometricFiberExtensionMap_comp_geometricGaloisFrobenius_pow_finrank_assoc]

end Scheme.Hom

end AlgebraicGeometry
