module

public import WeilConjectures.AlgebraicGeometry.NormalBundle
public import WeilConjectures.AlgebraicGeometry.VectorBundle
public import WeilConjectures.RingTheory.QuasiRegularRees

/-!
# The normal cone of a regular immersion is a vector bundle

Let `i : Z ⟶ X` be a regular closed immersion of pure codimension `c`, with ideal sheaf `I`. Over
an affine open `W = Spec R` of `X` on which `I` is generated by a regular sequence `a₁, …, a_c`, the
normal cone `N_{Z/X}` is `Spec (R[t, I t⁻¹] / t) = Spec ((R / I)[X₁, …, X_c])`
(`Ideal.mvPolynomialEquivReesQuot`, quasi-regularity of regular sequences), which is `𝔸^c` over
`Z ∩ W = Spec (R / I)`, the zero section being `Xₖ = 0`. Two such charts differ by a linear change
of coordinates: the coordinates are the classes of the `aₖ t⁻¹`, and the generators of `I` over a
smaller affine open are linear combinations of each other. Hence `N_{Z/X} ⟶ Z` is a vector bundle
of rank `c` with zero section the augmentation (blueprint `def-pur-normal-bundle`).
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

namespace Scheme.IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData) {c : ℕ} (W : X.AffineZariskiSite)
  (a : Fin c → Γ(X, W.1)) (ha : MvPolynomial.IsRevRegular a)
  (hspan : Ideal.span (Set.range a) = I.siteIdeal W)

/-- Over an affine open `W` on which `I` is generated by a regular sequence `a`, the associated
graded algebra `⨁_r I^r / I^{r+1}` is the polynomial algebra `(𝒪 / I)[X₁, …, X_c]`. -/
noncomputable def normalConeChartRingIso :
    CommRingCat.of (MvPolynomial (ULift.{u} (Fin c)) (I.quotientAlgebra.obj (.op W))) ≅
      I.normalConePresheaf.obj (.op W) :=
  ((MvPolynomial.renameEquiv _ Equiv.ulift).toRingEquiv.trans
    (Ideal.mvPolynomialEquivReesQuotOfEq a ha hspan)).toCommRingCatIso

lemma normalConeChartRingIso_C (x : I.quotientAlgebra.obj (.op W)) :
    (I.normalConeChartRingIso W a ha hspan).hom (MvPolynomial.C x) =
      (I.quotientToNormalCone.app (.op W)) x := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  change Ideal.mvPolynomialEquivReesQuotOfEq a ha hspan
    (MvPolynomial.rename Equiv.ulift (MvPolynomial.C _)) = _
  rw [MvPolynomial.rename_C, Ideal.mvPolynomialEquivReesQuotOfEq_C]
  rfl

lemma C_comp_normalConeChartRingIso_hom :
    CommRingCat.ofHom MvPolynomial.C ≫ (I.normalConeChartRingIso W a ha hspan).hom =
      I.quotientToNormalCone.app (.op W) := by
  ext x
  exact I.normalConeChartRingIso_C W a ha hspan x

lemma normalConeChartRingIso_X (k : ULift.{u} (Fin c)) :
    (I.normalConeChartRingIso W a ha hspan).hom (MvPolynomial.X k) =
      Ideal.Quotient.mk _ ⟨LaurentPolynomial.C (a k.down) * LaurentPolynomial.T (-1),
        Ideal.C_mul_T_neg_one_mem_extendedReesAlgebra (hspan ▸ Ideal.subset_span ⟨k.down, rfl⟩)⟩ := by
  change Ideal.mvPolynomialEquivReesQuotOfEq a ha hspan
    (MvPolynomial.rename Equiv.ulift (MvPolynomial.X _)) = _
  rw [MvPolynomial.rename_X, Ideal.mvPolynomialEquivReesQuotOfEq_X]
  rfl

/-- The augmentation `⨁_r I^r / I^{r+1} ⟶ 𝒪 / I` is, in the chart, `Xₖ ↦ 0`. -/
lemma normalConeChartRingIso_hom_comp_normalConeToQuotient :
    (I.normalConeChartRingIso W a ha hspan).hom ≫ I.normalConeToQuotient.app (.op W) =
      CommRingCat.ofHom MvPolynomial.constantCoeff := by
  ext1
  refine MvPolynomial.ringHom_ext (fun x ↦ ?_) fun k ↦ ?_
  · have := congr($(I.quotientToNormalCone_comp_normalConeToQuotient).app (.op W) x)
    rw [CommRingCat.hom_comp, RingHom.comp_apply, normalConeChartRingIso_C]
    simpa using this
  · rw [CommRingCat.hom_comp, RingHom.comp_apply, normalConeChartRingIso_X]
    change Polynomial.eval 0 ((I.siteIdeal W).extendedReesAlgebraToPolynomial _ Ideal.mk_ker.ge _) = _
    rw [Ideal.extendedReesAlgebraToPolynomial_C_mul_T_neg_one _ _
      (hspan ▸ Ideal.subset_span ⟨k.down, rfl⟩)]
    simp

end Scheme.IdealSheafData

namespace Scheme.Hom

open Scheme.AffineZariskiSite

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The open immersion `Spec (R / I) ⟶ Z` of the part of `Z` over an affine open `W = Spec R` of
`X`. -/
noncomputable def normalBundleBase (W : X.AffineZariskiSite) :
    Spec (i.ker.quotientAlgebra.obj (.op W)) ⟶ Z :=
  colimit.ι (relativeGluingData i.ker.coequifibered_toQuotientAlgebra).functor W ≫
    inv i.toQuotientSpec

instance (W : X.AffineZariskiSite) : IsOpenImmersion (i.normalBundleBase W) := by
  dsimp [normalBundleBase]; infer_instance

/-- Over `W`, the normal cone is `Spec (⨁_r I^r / I^{r+1})`, the base change of `Spec (R / I)`. -/
lemma isPullback_normalBundleBase (W : X.AffineZariskiSite) :
    IsPullback (colimit.ι (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).functor W)
      (Spec.map (i.ker.quotientToNormalCone.app (.op W))) i.normalBundleProj
      (i.normalBundleBase W) := by
  refine (isPullback_ι_relativeGluingMap _ _ _
    i.ker.toQuotientAlgebra_comp_quotientToNormalCone W).of_iso (Iso.refl _) (Iso.refl _)
    (Iso.refl _) (asIso i.toQuotientSpec).symm ?_ ?_ ?_ ?_
  · simp
  · simp
  · simp [normalBundleProj, IdealSheafData.normalConeToQuotientSpec]
  · simp [normalBundleBase]

variable {c : ℕ} (W : X.AffineZariskiSite) (a : Fin c → Γ(X, W.1))
  (ha : MvPolynomial.IsRevRegular a) (hspan : Ideal.span (Set.range a) = i.ker.siteIdeal W)

/-- The chart `N_{Z/X} ×_Z Spec (R / I) ≅ 𝔸^c_{Spec (R / I)}` of the normal cone over an affine open
`W` on which the ideal of `Z` is generated by a regular sequence `a`. -/
noncomputable def normalBundleChart :
    pullback i.normalBundleProj (i.normalBundleBase W) ≅
      𝔸(ULift.{u} (Fin c); Spec (i.ker.quotientAlgebra.obj (.op W))) :=
  (i.isPullback_normalBundleBase W).isoPullback.symm ≪≫
    Scheme.Spec.mapIso (i.ker.normalConeChartRingIso W a ha hspan).op ≪≫
      (AffineSpace.SpecIso _ _).symm

lemma normalBundleChart_hom_over :
    (i.normalBundleChart W a ha hspan).hom ≫
        𝔸(ULift.{u} (Fin c); Spec (i.ker.quotientAlgebra.obj (.op W))) ↘ _ =
      pullback.snd i.normalBundleProj (i.normalBundleBase W) := by
  simp only [normalBundleChart, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom, Iso.op_hom,
    Scheme.Spec_map, Quiver.Hom.unop_op, Category.assoc, AffineSpace.SpecIso_inv_over,
    ← Spec.map_comp, IdealSheafData.C_comp_normalConeChartRingIso_hom]
  exact (i.isPullback_normalBundleBase W).isoPullback_inv_snd

/-- In the chart over `W`, the zero section of the normal cone is the zero section of `𝔸^c`: it is
given by the augmentation `(R / I)[X₁, …, X_c] ⟶ R / I`, `Xₖ ↦ 0`. -/
lemma exists_normalBundleChart_zeroSection :
    ∃ σ : Spec (i.ker.quotientAlgebra.obj (.op W)) ⟶
        pullback i.normalBundleProj (i.normalBundleBase W),
      σ ≫ pullback.fst _ _ = i.normalBundleBase W ≫ i.normalConeZeroSection ∧
      σ ≫ pullback.snd _ _ = 𝟙 _ ∧
      σ ≫ (i.normalBundleChart W a ha hspan).hom =
        AffineSpace.zeroSection (ULift.{u} (Fin c)) _ := by
  have hP := i.isPullback_normalBundleBase W
  refine ⟨Spec.map (i.ker.normalConeToQuotient.app (.op W)) ≫ hP.isoPullback.hom, ?_, ?_, ?_⟩
  · rw [Category.assoc, hP.isoPullback_hom_fst, normalBundleBase, normalConeZeroSection,
      Category.assoc, IsIso.inv_hom_id_assoc, ι_relativeGluingMap]
  · rw [Category.assoc, hP.isoPullback_hom_snd, ← Spec.map_comp, ← NatTrans.comp_app,
      IdealSheafData.quotientToNormalCone_comp_normalConeToQuotient, NatTrans.id_app,
      Spec.map_id]
  · have hc : (i.normalBundleChart W a ha hspan).hom = hP.isoPullback.inv ≫
        Spec.map (i.ker.normalConeChartRingIso W a ha hspan).hom ≫ (AffineSpace.SpecIso _ _).inv :=
      rfl
    have h2 : Spec.map (i.ker.normalConeToQuotient.app (.op W)) ≫
        Spec.map (i.ker.normalConeChartRingIso W a ha hspan).hom =
          Spec.map (CommRingCat.ofHom MvPolynomial.constantCoeff) := by
      rw [← Spec.map_comp, IdealSheafData.normalConeChartRingIso_hom_comp_normalConeToQuotient]
    rw [Category.assoc, hc, Iso.hom_inv_id_assoc]
    erw [reassoc_of% h2]
    refine AffineSpace.hom_ext ?_ fun j ↦ ?_
    · rw [Category.assoc, AffineSpace.SpecIso_inv_over, ← Spec.map_comp,
        AffineSpace.zeroSection_over]
      rw [show CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom MvPolynomial.constantCoeff =
        𝟙 (i.ker.quotientAlgebra.obj (.op W)) from
        CommRingCat.hom_ext (RingHom.ext fun x ↦ MvPolynomial.constantCoeff_C _ _)]
      exact Spec.map_id _
    · rw [AffineSpace.zeroSection_appTop_coord, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
        AffineSpace.SpecIso_inv_appTop_coord, ← CommRingCat.comp_apply,
        ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
      erw [MvPolynomial.constantCoeff_X, map_zero]

/-- The section `aₖ t⁻¹` of the normal cone over the affine open `W`: a coordinate of the chart. -/
noncomputable def normalConeCoord (k : Fin c) :
    Γ(i.ker.normalCone,
      (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase ⁻¹ᵁ W.1) :=
  (sectionsIso i.ker.coequifibered_toNormalConePresheaf W).inv
    (Ideal.Quotient.mk _ ⟨LaurentPolynomial.C (a k) * LaurentPolynomial.T (-1),
      Ideal.C_mul_T_neg_one_mem_extendedReesAlgebra (hspan ▸ Ideal.subset_span ⟨k, rfl⟩)⟩)

lemma top_le_preimage_fst_normalBundleBase :
    ⊤ ≤ pullback.fst i.normalBundleProj (i.normalBundleBase W) ⁻¹ᵁ
      (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase ⁻¹ᵁ W.1 := by
  rw [← (i.isPullback_normalBundleBase W).isoPullback_inv_fst, Scheme.Hom.comp_preimage]
  calc (⊤ : (pullback i.normalBundleProj (i.normalBundleBase W)).Opens)
      = (i.isPullback_normalBundleBase W).isoPullback.inv ⁻¹ᵁ ⊤ := by simp
    _ ≤ _ := Scheme.Hom.preimage_mono _ (top_le_preimage_toBase _ W)

lemma fst_appLE_normalBundleBase :
    (pullback.fst i.normalBundleProj (i.normalBundleBase W)).appLE _ ⊤
        (i.top_le_preimage_fst_normalBundleBase W) =
      (colimit.ι (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).functor W).appLE
        _ ⊤ (top_le_preimage_toBase _ W) ≫
        (i.isPullback_normalBundleBase W).isoPullback.inv.appTop := by
  have hP := i.isPullback_normalBundleBase W
  rw [Scheme.Hom.appLE_congr_hom hP.isoPullback_inv_fst.symm _ _ _ (by
      rw [hP.isoPullback_inv_fst]; exact i.top_le_preimage_fst_normalBundleBase W),
    ← Scheme.Hom.appLE_comp_appLE _ _ _ ⊤ ⊤ (top_le_preimage_toBase _ W) (by simp)]
  congr 1
  simp [Scheme.Hom.appLE]

/-- The coordinates of the chart over `W` are the pullbacks of the sections `aₖ t⁻¹`. -/
lemma normalBundleChart_hom_appTop_coord (k : Fin c) :
    (i.normalBundleChart W a ha hspan).hom.appTop (AffineSpace.coord _ (ULift.up k)) =
      (pullback.fst i.normalBundleProj (i.normalBundleBase W)).appLE _ ⊤
        (i.top_le_preimage_fst_normalBundleBase W) (i.normalConeCoord W a hspan k) := by
  have e1 : ∀ y, (colimit.ι (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).functor
      W).appLE _ ⊤ (top_le_preimage_toBase _ W)
        ((sectionsIso i.ker.coequifibered_toNormalConePresheaf W).inv y) =
          (Scheme.ΓSpecIso _).inv y := fun y ↦ by
    have e0 : (sectionsIso i.ker.coequifibered_toNormalConePresheaf W).inv ≫
        (colimit.ι (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).functor
          W).appLE _ ⊤ (top_le_preimage_toBase _ W) = (Scheme.ΓSpecIso _).inv := by
      rw [Iso.inv_comp_eq, sectionsIso_hom, Category.assoc]
      erw [Iso.hom_inv_id, Category.comp_id]
    exact congr($e0 y)
  have hc : (i.normalBundleChart W a ha hspan).hom =
      (i.isPullback_normalBundleBase W).isoPullback.inv ≫
        Spec.map (i.ker.normalConeChartRingIso W a ha hspan).hom ≫
          (AffineSpace.SpecIso _ _).inv := rfl
  rw [fst_appLE_normalBundleBase, CommRingCat.comp_apply, normalConeCoord, e1, hc,
    Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
    CommRingCat.comp_apply]
  erw [AffineSpace.SpecIso_inv_appTop_coord]
  congr 1
  have := congr($(Scheme.ΓSpecIso_inv_naturality
    (i.ker.normalConeChartRingIso W a ha hspan).hom) (MvPolynomial.X (ULift.up k)))
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply,
    IdealSheafData.normalConeChartRingIso_X] at this
  exact this.symm

/-- Two chart coordinates are related linearly over a smaller affine open `W ⊆ W₁ ∩ W₂`: the
generators `a₂` of the ideal of `Z` are linear combinations of the generators `a₁`, so
`a₂ₖ t⁻¹ = ∑ βₗ a₁ₗ t⁻¹`. -/
lemma exists_normalConeCoord_relation {W₁ W₂ W : X.AffineZariskiSite} (h₁ : W ⟶ W₁)
    (h₂ : W ⟶ W₂) (a₁ : Fin c → Γ(X, W₁.1)) (hs₁ : Ideal.span (Set.range a₁) = i.ker.siteIdeal W₁)
    (a₂ : Fin c → Γ(X, W₂.1)) (hs₂ : Ideal.span (Set.range a₂) = i.ker.siteIdeal W₂)
    (k : Fin c) : ∃ β : Fin c → Γ(X, W.1),
      i.ker.normalCone.presheaf.map (homOfLE
          ((relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase.preimage_mono
            (toOpens_mono h₂.le))).op (i.normalConeCoord W₂ a₂ hs₂ k) =
        ∑ l, (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase.app W.1 (β l) *
          i.ker.normalCone.presheaf.map (homOfLE
            ((relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase.preimage_mono
              (toOpens_mono h₁.le))).op (i.normalConeCoord W₁ a₁ hs₁ l) := by
  set res₁ := (X.affineStructurePresheaf.map h₁.op).hom
  set res₂ := (X.affineStructurePresheaf.map h₂.op).hom
  -- the generators `a₂` are linear combinations of the `a₁` over `W`
  have hW : i.ker.siteIdeal W = Ideal.span (Set.range (res₁ ∘ a₁)) :=
    calc i.ker.siteIdeal W = (i.ker.siteIdeal W₁).map res₁ := (i.ker.map_siteIdeal h₁.op).symm
      _ = (Ideal.span (Set.range a₁)).map res₁ := by rw [hs₁]
      _ = _ := by rw [Ideal.map_span, Set.range_comp]; rfl
  have hmem : res₂ (a₂ k) ∈ i.ker.siteIdeal W := by
    rw [← i.ker.map_siteIdeal h₂.op]
    exact Ideal.mem_map_of_mem _ (hs₂ ▸ Ideal.subset_span ⟨k, rfl⟩)
  rw [hW] at hmem
  obtain ⟨β, hβ⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hmem
  refine ⟨β, ?_⟩
  -- transport to the algebra `⨁_r I^r / I^{r+1}` over `W`
  have hnat {V : X.AffineZariskiSite} (h : W ⟶ V) (y) :
      i.ker.normalCone.presheaf.map (homOfLE
          ((relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase.preimage_mono (toOpens_mono h.le))).op
        ((sectionsIso i.ker.coequifibered_toNormalConePresheaf V).inv y) =
        (sectionsIso i.ker.coequifibered_toNormalConePresheaf W).inv ((i.ker.normalConePresheaf.map h.op) y) := by
    have := sectionsIso_hom_naturality i.ker.coequifibered_toNormalConePresheaf h
    rw [← Iso.eq_comp_inv] at this
    rw [this]
    simp
  have hbase (b : Γ(X, W.1)) : (relativeGluingData i.ker.coequifibered_toNormalConePresheaf).toBase.app W.1 b =
      (sectionsIso i.ker.coequifibered_toNormalConePresheaf W).inv (((i.ker.toReesPresheaf ≫ toQuotientPresheaf i.ker.tIdeal i.ker.map_tIdeal).app (.op W)) b) := by
    have := toBase_appLE_sectionsIso_hom i.ker.coequifibered_toNormalConePresheaf W
    rw [← Iso.eq_comp_inv] at this
    rw [Scheme.Hom.app_eq_appLE]
    exact congr($this b)
  simp only [normalConeCoord]
  simp only [hnat, hbase, ← map_mul, ← map_sum]
  congr 1
  simp only [Scheme.quotientPresheaf_map, CommRingCat.hom_ofHom, Ideal.quotientMap_mk,
    NatTrans.comp_app, CommRingCat.comp_apply, Scheme.toQuotientPresheaf_app,
    IdealSheafData.toReesPresheaf_app, ← map_mul, ← map_sum]
  congr 1
  apply Subtype.ext
  simp [IdealSheafData.reesPresheaf, Ideal.coe_extendedReesAlgebraMap, ← hβ, map_sum,
    Finset.sum_mul, mul_assoc, res₂, res₁]

end Scheme.Hom

end AlgebraicGeometry
