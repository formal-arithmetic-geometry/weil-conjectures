/-! # Pullback of arbitrary ordinary arrows in the finite coordinates
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option genSizeOf false
set_option genInjectivity false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.ProEtale.DiagonalTrace
set_option linter.auxLemma false in
attribute [local instance 100000] Etale.DerivedCategoryModule._proof_1
  Etale.DerivedCategoryModule._proof_2
attribute [local instance 100000] Etale.ordinaryFiniteDerivedCategoryInstance
attribute [local implicit_reducible] Etale.ordinaryFiniteDerivedCategoryInstance
  Etale.ordinaryFiniteSingleFunctor Etale.ordinaryFiniteDegreeZero
attribute [local irreducible] Padic Padic.coefficientExtensionIntegers
open SpTowerClasses

variable (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
  [Algebra (Padic l) E] [FiniteDimensional (Padic l) E]

attribute [local irreducible] Functor.mapDerivedCategory SpTowerP1.nuSingle
  HasDerivedCategory.ofIsGrothendieckAbelian HomologicalComplex.quasiIso
  Etale.projectiveLineTraceTransport geoP1Pullback geoP1PullComparison
  Etale.ordinaryFiniteUnitPullback Etale.ordinaryFiniteShiftedLinePullback

private theorem normalized_square_arrow
    {C D C' D' : Type*} [Category C] [Category D] [Category C'] [Category D']
    (P : C ⥤ D) (Q : C' ⥤ D') (F : C ⥤ C') (G : D ⥤ D')
    (α : F ⋙ Q ≅ P ⋙ G) {U V : C} {U' V' : D}
    (u : P.obj U ≅ U') (v : P.obj V ≅ V') (a : U ⟶ V) :
    (α.app U ≪≫ G.mapIso u).inv ≫ Q.map (F.map a) ≫
        (α.app V ≪≫ G.mapIso v).hom =
      G.map (u.inv ≫ P.map a ≫ v.hom) := by
  simp only [Iso.trans_inv, Iso.trans_hom, Iso.app_hom, Iso.app_inv,
    Functor.mapIso_inv, Functor.mapIso_hom, Functor.map_comp, Category.assoc]
  rw [reassoc_of% (α.hom.naturality a)]
  simp only [Iso.inv_hom_id_app_assoc]

/-- Ordinary pullback commutes with exact site comparison in normalized endpoint
coordinates. -/
theorem finiteOrdinaryPullback_comparison (A : Type (u + 1)) [CommRing A] [Finite A]
    (N : ℕ) (hN : 0 < N) (hA : (N : A) = 0)
    {X Y : Scheme.{u}} (f : X ⟶ Y) (hY : IsUnit (N : Γ(Y, ⊤)))
    (a : Etale.ordinaryFiniteUnit A Y ⟶
      (Etale.ordinaryFiniteLine A N hA Y)⟦(2 : ℤ)⟧) :
    (geoP1UnitPullback A f).inv ≫
        (geoP1Pullback A f).map ((geoP1Comparison A Y).map a) ≫
        (geoP1TwistPullback A N hN hA f hY 1 2).hom =
      (geoP1Comparison A X).map
        (Etale.ordinaryFiniteLinePullbackMap A N hA
          (Etale.projectiveLineTraceTransport N hN A hA) f hY a) := by
  simpa only [geoP1UnitPullback, geoP1TwistPullback,
    Etale.ordinaryFiniteLinePullbackMap, Etale.ordinaryFiniteArrowPullback,
    shiftedLinePullback_eq A N hN hA] using
    (normalized_square_arrow (Etale.ordinaryFinitePullback A f) (geoP1Pullback A f)
      (geoP1Comparison A Y) (geoP1Comparison A X) (geoP1PullComparison A f)
      (Etale.ordinaryFiniteUnitPullback A f)
      (Etale.p1DecompositionTwistPullback A N hN hA f hY 1 2) a)

end AlgebraicGeometry.ProEtale.DiagonalTrace
