/-! # Uniqueness of an étale finite class from its integral Chern adjunct -/
@[expose] public noncomputable section
set_option autoImplicit false
set_option Elab.async false
universe u
open CategoryTheory CategoryTheory.Abelian CategoryTheory.Limits
namespace AlgebraicGeometry.ProEtale.DiagonalTrace
attribute [local irreducible] CategoryTheory.Abelian.Ext Ext.comp Ext.mk₀
  Ext.mapExactFunctor Ext.homEquiv
set_option linter.auxLemma false in
attribute [local instance 100000] Etale.DerivedCategoryModule._proof_1
  Etale.DerivedCategoryModule._proof_2

private theorem etale_chern_of_integral
    (A : Type (u + 1)) [CommRing A] (N : ℕ) (hA : (N : A) = 0)
    {D T : Scheme.{u}} (i : D ⟶ T) (hI : i.ker.IsInvertible)
    (hT : IsUnit (N : Γ(T, ⊤)))
    (b : Ext (Etale.ordinaryFiniteConstant A T) (Scheme.finiteEtaleTateLine T N A hA) 2)
    (hb : (Ext.mk₀ (Etale.ordinaryFiniteIntegralGenerator A T)).comp
      (b.mapExactFunctor (Etale.RawModuleScalarComparison.forget A T)) (zero_add 2) =
        Etale.supportedKummerChern A N hA i hI hT) :
    Etale.ordinaryFiniteExtHomEquiv A T _ _ 2 b =
      Etale.ordinaryFiniteFirstChern A N hA T hT
      (@Scheme.Pic.ofIsInvertible T (Scheme.Modules.dual i.ker.toModules)
        hI.isInvertible_dual_toModules) := by
  apply Etale.ordinaryFiniteFirstChern_unique
  rw [Etale.ordinaryFiniteClass_extHomEquiv]
  simpa only [Etale.ordinaryFiniteExtClassCore, Etale.supportedKummerChern] using hb

/-- An integral Kummer normalization identifies a finite class with a Cartier antecedent. -/
theorem finiteEtale_eq_of_integralChern
    (A : Type (u + 1)) [CommRing A] (N : ℕ) (hA : (N : A) = 0)
    {D T : Scheme.{u}} (i : D ⟶ T) (hI : i.ker.IsInvertible)
    (hT : IsUnit (N : Γ(T, ⊤)))
    (b c : Ext (Etale.ordinaryFiniteConstant A T)
      (Scheme.finiteEtaleTateLine T N A hA) 2)
    (hb : Etale.ordinaryFiniteClass A T _ 2
      (Etale.ordinaryFiniteExtHomEquiv A T _ _ 2 b) =
      Etale.ordinaryFiniteKummerClass A N hA T hT
        (@Scheme.Pic.ofIsInvertible T (Scheme.Modules.dual i.ker.toModules)
          hI.isInvertible_dual_toModules))
    (hc : (Ext.mk₀ (Etale.ordinaryFiniteIntegralGenerator A T)).comp
      (c.mapExactFunctor (Etale.RawModuleScalarComparison.forget A T)) (zero_add 2) =
        Etale.supportedKummerChern A N hA i hI hT) : b = c := by
  have hb' := Etale.ordinaryFiniteFirstChern_unique A N hA T hT _
    (Etale.ordinaryFiniteExtHomEquiv A T _ _ 2 b) hb
  have hc' := etale_chern_of_integral A N hA i hI hT c hc
  exact (Etale.ordinaryFiniteExtHomEquiv A T _ _ 2).injective (hb'.trans hc'.symm)

end AlgebraicGeometry.ProEtale.DiagonalTrace
