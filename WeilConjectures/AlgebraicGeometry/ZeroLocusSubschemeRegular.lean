module

public import WeilConjectures.AlgebraicGeometry.Regular
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import WeilConjectures.Mathlib.AlgebraicGeometry.Noetherian
public import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs
public import WeilConjectures.Mathlib.RingTheory.Smooth.Local

/-!
# Local rings of the zero locus of a function, and regular points

Auxiliary results for showing that the zero locus `V(t)` of a function `t` with germ in
`𝔪ₓ \ 𝔪ₓ²` on a smooth scheme is a regular divisor near `x`.

- The local ring of `V(f) ⊆ Y` at `z` is `𝒪_{Y,z} ⧸ (f)`
  (`AlgebraicGeometry.Scheme.ker_stalkMap_zeroLocusSubschemeι_singleton`,
  `AlgebraicGeometry.Scheme.Opens.stalkZeroLocusSubschemeEquiv`).
- Over a perfect field, a point of a scheme locally of finite type is in the smooth locus if and
  only if its local ring is regular
  (`AlgebraicGeometry.Scheme.Hom.mem_smoothLocus_of_isRegularLocalRing_of_perfectField`,
  `AlgebraicGeometry.Scheme.Hom.isRegularLocalRing_stalk_of_mem_smoothLocus`).
- A locally noetherian scheme with domain local rings has irreducible open neighbourhoods
  (`AlgebraicGeometry.Scheme.exists_mem_isPreirreducible_of_isDomain_stalk`).

## References

* [Stacks Project, Tag 00TV](https://stacks.math.columbia.edu/tag/00TV)
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- The kernel of the stalk map at `z` of the closed immersion `V(f) ⟶ Y` cut out by a global
section `f` is generated by the germ of `f`: the local ring of `V(f)` at `z` is `𝒪_{Y,z} ⧸ (f)`. -/
theorem Scheme.ker_stalkMap_zeroLocusSubschemeι_singleton {Y : Scheme.{u}} (f : Γ(Y, ⊤))
    (z : Y.zeroLocusSubscheme {f}) :
    RingHom.ker ((Y.zeroLocusSubschemeι {f}).stalkMap z).hom =
      Ideal.span {Y.presheaf.germ ⊤ (Y.zeroLocusSubschemeι {f} z) trivial f} := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ (Y.zeroLocusSubschemeι {f} z)) isOpen_univ
  rw [Scheme.Hom.ker_stalkMap _ ⟨U, hU⟩ z hzU, Scheme.IdealSheafData.ker_subschemeι,
    Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map, Ideal.map_span, Set.image_singleton,
    ← CommRingCat.hom_comp, TopCat.Presheaf.germ_res]

/-- The isomorphism between the stalks of an open subscheme `U ⊆ X` and of `X` sends the germ
of the global section of `U` attached to `s : Γ(X, U)` to the germ of `s`. -/
theorem Scheme.Opens.stalkIso_hom_germ_topIso_inv {X : Scheme.{u}} (U : X.Opens) (s : Γ(X, U))
    (w : U) :
    (U.stalkIso w).hom (U.toScheme.presheaf.germ ⊤ w trivial (U.topIso.inv s)) =
      X.presheaf.germ U w.1 w.2 s := by
  rw [← ConcreteCategory.comp_apply, U.germ_stalkIso_hom, Scheme.Opens.topIso_inv]
  exact TopCat.Presheaf.germ_res_apply' _ _ _ _ _

/-- The local ring at `z` of the zero locus in an open subscheme `U ⊆ X` of a function
`s : Γ(X, U)` is the quotient `𝒪_{X,z} ⧸ (s)` of the local ring of `X`. -/
noncomputable def Scheme.Opens.stalkZeroLocusSubschemeEquiv {X : Scheme.{u}} (U : X.Opens)
    (s : Γ(X, U)) (z : U.toScheme.zeroLocusSubscheme {U.topIso.inv s}) :
    (U.toScheme.zeroLocusSubscheme {U.topIso.inv s}).presheaf.stalk z ≃+*
      X.presheaf.stalk (U.toScheme.zeroLocusSubschemeι {U.topIso.inv s} z).1 ⧸
        Ideal.span {X.presheaf.germ U _ (U.toScheme.zeroLocusSubschemeι {U.topIso.inv s} z).2 s} :=
  (RingHom.quotientKerEquivOfSurjective
      ((U.toScheme.zeroLocusSubschemeι {U.topIso.inv s}).stalkMap_surjective z)).symm.trans
    (Ideal.quotientEquiv _ _ (U.stalkIso _).commRingCatIsoToRingEquiv (by
      rw [Scheme.ker_stalkMap_zeroLocusSubschemeι_singleton, Ideal.map_span, Set.image_singleton]
      exact congrArg (fun a ↦ Ideal.span {a}) (U.stalkIso_hom_germ_topIso_inv s _).symm))

/-- Let `t` be a function on an open `V` of `X` and `U ⊆ V` open. The local ring of the zero
locus of `t|_U` at a point `z` over `p ∈ X` is regular if and only if `𝒪_{X,p} ⧸ (t)` is. -/
theorem Scheme.Opens.isRegularLocalRing_stalk_zeroLocusSubscheme_iff {X : Scheme.{u}}
    {U V : X.Opens} (hUV : U ≤ V) (t : Γ(X, V))
    (z : U.toScheme.zeroLocusSubscheme {U.topIso.inv (X.presheaf.map (homOfLE hUV).op t)})
    {p : X} (hp : p ∈ V)
    (hzp : (U.toScheme.zeroLocusSubschemeι {U.topIso.inv (X.presheaf.map (homOfLE hUV).op t)}
      z).1 = p) :
    IsRegularLocalRing
        ((U.toScheme.zeroLocusSubscheme
          {U.topIso.inv (X.presheaf.map (homOfLE hUV).op t)}).presheaf.stalk z) ↔
      IsRegularLocalRing (X.presheaf.stalk p ⧸ Ideal.span {X.presheaf.germ V p hp t}) := by
  subst hzp
  let e := U.stalkZeroLocusSubschemeEquiv (X.presheaf.map (homOfLE hUV).op t) z
  rw [TopCat.Presheaf.germ_res_apply] at e
  exact ⟨fun _ ↦ .of_ringEquiv e, fun _ ↦ .of_ringEquiv e.symm⟩

/-- A point `w` of an open `U ⊆ X` at which the germ of `s : Γ(X, U)` is not a unit lies on
the zero locus of `s`. -/
theorem Scheme.Opens.exists_zeroLocusSubschemeι_eq {X : Scheme.{u}} (U : X.Opens)
    (s : Γ(X, U)) (w : U) (hw : X.presheaf.germ U w.1 w.2 s ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk w.1)) :
    ∃ z, U.toScheme.zeroLocusSubschemeι {U.topIso.inv s} z = w := by
  rw [← Set.mem_range, Scheme.range_zeroLocusSubschemeι_singleton, Scheme.Opens.range_ι]
  intro hw'
  have h := (U.mem_ι_image_iff (x := w)).mpr hw'
  rw [U.ι_image_basicOpen_topIso_inv, X.mem_basicOpen _ _ w.2] at h
  exact (IsLocalRing.mem_maximalIdeal _).mp hw h

/-- **Regular points are smooth over a perfect field**. Let `X` be locally of
finite type over a perfect field `K`. Every point of `X` whose local ring is regular lies in the
smooth locus of `X ⟶ Spec K`. -/
theorem Scheme.Hom.mem_smoothLocus_of_isRegularLocalRing_of_perfectField {K : Type u} [Field K]
    [PerfectField K] {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) [LocallyOfFiniteType f] {x : X}
    [IsRegularLocalRing (X.presheaf.stalk x)] : x ∈ f.smoothLocus := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have hU : IsAffineOpen (⊤ : (Spec (.of K)).Opens) := isAffineOpen_top _
  have hVU : V ≤ f ⁻¹ᵁ ⊤ := le_top
  have hft := f.finiteType_appLE hU hV hVU
  let := (f.appLE ⊤ V hVU).hom.toAlgebra
  rw [Scheme.Hom.mem_smoothLocus, formallySmooth_stalkMap_iff ⊤ hU V hV hVU hxV,
    Algebra.smoothLocus, Set.mem_ofPred_eq, Algebra.IsSmoothAt]
  set q := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
  have : IsRegularLocalRing (Localization.AtPrime q) := by
    let := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
    have := hV.isLocalization_stalk ⟨x, hxV⟩
    exact .of_ringEquiv (IsLocalization.algEquiv q.primeCompl (X.presheaf.stalk x)
      (Localization.AtPrime q)).toRingEquiv
  let e : K ≃+* Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv
  let : Algebra K Γ(X, V) := ((f.appLE ⊤ V hVU).hom.comp e.toRingHom).toAlgebra
  have : Algebra.FiniteType K Γ(X, V) :=
    RingHom.FiniteType.comp hft (RingHom.FiniteType.of_surjective _ e.surjective)
  have : Algebra.EssFiniteType K (IsLocalRing.ResidueField (Localization.AtPrime q)) :=
    inferInstanceAs (Algebra.EssFiniteType K (Localization.AtPrime q ⧸ _))
  have h : Algebra.FormallySmooth K (Localization.AtPrime q) :=
    Algebra.FormallySmooth.localization_of_isRegularLocalRing q
  rw [← RingHom.formallySmooth_algebraMap] at h ⊢
  have heq : algebraMap K (Localization.AtPrime q) =
      (algebraMap Γ(Spec (.of K), ⊤) (Localization.AtPrime q)).comp e.toRingHom := by
    rw [IsScalarTower.algebraMap_eq K Γ(X, V), IsScalarTower.algebraMap_eq Γ(Spec (.of K), ⊤)
      Γ(X, V)]
    rfl
  rw [heq] at h
  have := RingHom.FormallySmooth.respectsIso.2 _ e.symm h
  have hcomp : ((algebraMap Γ(Spec (.of K), ⊤) (Localization.AtPrime q)).comp e.toRingHom).comp
      e.symm.toRingHom = algebraMap Γ(Spec (.of K), ⊤) (Localization.AtPrime q) :=
    RingHom.ext fun a ↦ congrArg (algebraMap _ _) (e.apply_symm_apply a)
  rwa [hcomp] at this

/-- **Smooth points are regular.** The local ring of a scheme over a field `K` at a point of the
smooth locus of `X ⟶ Spec K` is a regular local ring: the smooth locus is an open subscheme
smooth over `K`. -/
theorem Scheme.Hom.isRegularLocalRing_stalk_of_mem_smoothLocus {K : Type u} [Field K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) [LocallyOfFinitePresentation f] {x : X}
    (hx : x ∈ f.smoothLocus) : IsRegularLocalRing (X.presheaf.stalk x) := by
  have : Smooth (f.smoothLocus.ι ≫ f) := by
    rw [← Scheme.Hom.smoothLocus_eq_top_iff, ← Scheme.Hom.preimage_smoothLocus_eq,
      Scheme.Opens.ι_preimage_self]
  have := Smooth.isRegularLocalRing_stalk (f.smoothLocus.ι ≫ f) ⟨x, hx⟩
  exact .of_ringEquiv (f.smoothLocus.stalkIso ⟨x, hx⟩).commRingCatIsoToRingEquiv

/-- In a locally noetherian scheme whose local rings are domains, every point has an open
neighbourhood which is (pre)irreducible: its connected component, which is open since `X` is
locally connected, and irreducible by `AlgebraicGeometry.irreducibleSpace_of_isDomain_stalk`. -/
theorem Scheme.exists_mem_isPreirreducible_of_isDomain_stalk (X : Scheme.{u})
    [IsLocallyNoetherian X] (h : ∀ x : X, IsDomain (X.presheaf.stalk x)) (x : X) :
    ∃ C : X.Opens, x ∈ C ∧ IsPreirreducible (C : Set X) := by
  let C : X.Opens := ⟨connectedComponent x, isOpen_connectedComponent⟩
  have : ConnectedSpace C := Subtype.connectedSpace isConnected_connectedComponent
  have : IrreducibleSpace C.toScheme := irreducibleSpace_of_isDomain_stalk _ fun z ↦
    MulEquiv.isDomain _ (C.stalkIso z).commRingCatIsoToRingEquiv.toMulEquiv
  refine ⟨C, mem_connectedComponent, ?_⟩
  have := (IrreducibleSpace.isIrreducible_univ C).isPreirreducible.image _
    continuous_subtype_val.continuousOn
  rwa [Set.image_univ, Subtype.range_coe] at this

end AlgebraicGeometry
