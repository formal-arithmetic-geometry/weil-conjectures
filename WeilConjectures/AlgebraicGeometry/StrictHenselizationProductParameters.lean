module

public import WeilConjectures.AlgebraicGeometry.StrictHenselizationChartMaximalIdeal
public import WeilConjectures.RingTheory.TensorProductPointIdeal
public import WeilConjectures.AlgebraicGeometry.Sites.StrictHenselizationLocal

/-!
# Regular parameters of the strict henselization of a product at a rational point

Let `k` be an algebraically closed field and `C₁`, `C₂` schemes over `k` with affine open charts
`Spec A₁ ⟶ C₁`, `Spec A₂ ⟶ C₂` containing `k`-points `φ₁`, `φ₂` whose ideals are principal,
generated by `ξ` and `η`. Then the maximal ideal of the strict henselization of `C₁ ×_k C₂` at
the point `(φ₁, φ₂)` is generated by the images of `ξ ⊗ 1` and `1 ⊗ η`
(`AlgebraicGeometry.Scheme.strictHenselization_maximalIdeal_eq_span_pair`). This is the
statement of blueprint `lemma-tangent-cones-on-cover` (ii) that the strict local ring of
`T'` at the point is (a henselization of) `k[ξ, η]` localised at `(ξ, η)`.
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

namespace AlgebraicGeometry.Scheme

/-- The prime ideal of the image of the closed point of a field under `Spec.map f` is the
kernel of `f`. -/
lemma Spec_map_closedPoint_asIdeal {R K F : Type u} [CommRing R] [Field K] [FunLike F R K]
    [RingHomClass F R K] (f : F) :
    (Spec.map (CommRingCat.ofHom (f : R →+* K)) (IsLocalRing.closedPoint K)).asIdeal =
      RingHom.ker f := by
  ext x
  exact Ideal.mem_comap.trans
    (by simp [IsLocalRing.closedPoint, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff])

/-- The affine chart `Spec (A₁ ⊗[k] A₂) ≅ Spec A₁ ×_k Spec A₂ ⟶ C₁ ×_k C₂` built from affine
charts `i₁`, `i₂` of `C₁` and `C₂` over `k`. -/
noncomputable def productChart {k : Type u} [CommRing k] {C₁ C₂ : Scheme.{u}}
    (a₁ : C₁ ⟶ Spec (.of k)) (a₂ : C₂ ⟶ Spec (.of k))
    {A₁ A₂ : Type u} [CommRing A₁] [CommRing A₂] [Algebra k A₁] [Algebra k A₂]
    (i₁ : Spec (.of A₁) ⟶ C₁) (i₂ : Spec (.of A₂) ⟶ C₂)
    (hi₁ : i₁ ≫ a₁ = Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
    (hi₂ : i₂ ≫ a₂ = Spec.map (CommRingCat.ofHom (algebraMap k A₂))) :
    Spec (.of (A₁ ⊗[k] A₂)) ⟶ pullback a₁ a₂ :=
  (pullbackSpecIso k A₁ A₂).inv ≫
    pullback.map _ _ _ _ i₁ i₂ (𝟙 _) (by simp [hi₁]) (by simp [hi₂])

instance {k : Type u} [CommRing k] {C₁ C₂ : Scheme.{u}}
    (a₁ : C₁ ⟶ Spec (.of k)) (a₂ : C₂ ⟶ Spec (.of k))
    {A₁ A₂ : Type u} [CommRing A₁] [CommRing A₂] [Algebra k A₁] [Algebra k A₂]
    (i₁ : Spec (.of A₁) ⟶ C₁) (i₂ : Spec (.of A₂) ⟶ C₂) [IsOpenImmersion i₁]
    [IsOpenImmersion i₂]
    (hi₁ : i₁ ≫ a₁ = Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
    (hi₂ : i₂ ≫ a₂ = Spec.map (CommRingCat.ofHom (algebraMap k A₂))) :
    IsOpenImmersion (productChart a₁ a₂ i₁ i₂ hi₁ hi₂) := by
  unfold productChart
  infer_instance

/-- Let `C₁`, `C₂` be schemes over an algebraically closed field `k`, with affine open charts
`i₁ : Spec A₁ ⟶ C₁`, `i₂ : Spec A₂ ⟶ C₂` over `k`, and `k`-points `φ₁ : A₁ → k`,
`φ₂ : A₂ → k` with principal kernels `(ξ)` and `(η)`. Let `s` be the corresponding `k`-point of
`C₁ ×_k C₂`. Then the strict henselization of `C₁ ×_k C₂` at `s` receives a ring map `ρ` from
`A₁ ⊗[k] A₂`, compatible with the chart, and its maximal ideal is generated by
`ρ (ξ ⊗ 1)` and `ρ (1 ⊗ η)`.
(blueprint: lemma-tangent-cones-on-cover (ii)) -/
theorem strictHenselization_maximalIdeal_eq_span_pair {k : Type u} [Field k] [IsAlgClosed k]
    {C₁ C₂ : Scheme.{u}} (a₁ : C₁ ⟶ Spec (.of k)) (a₂ : C₂ ⟶ Spec (.of k))
    {A₁ A₂ : Type u} [CommRing A₁] [CommRing A₂] [Algebra k A₁] [Algebra k A₂]
    (i₁ : Spec (.of A₁) ⟶ C₁) (i₂ : Spec (.of A₂) ⟶ C₂) [IsOpenImmersion i₁]
    [IsOpenImmersion i₂]
    (hi₁ : i₁ ≫ a₁ = Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
    (hi₂ : i₂ ≫ a₂ = Spec.map (CommRingCat.ofHom (algebraMap k A₂)))
    (φ₁ : A₁ →ₐ[k] k) (φ₂ : A₂ →ₐ[k] k) {ξ : A₁} {η : A₂}
    (hξ : RingHom.ker φ₁ = Ideal.span {ξ}) (hη : RingHom.ker φ₂ = Ideal.span {η})
    (s : Spec (.of k) ⟶ pullback a₁ a₂)
    (hs₁ : s ≫ pullback.fst a₁ a₂ = Spec.map (CommRingCat.ofHom φ₁.toRingHom) ≫ i₁)
    (hs₂ : s ≫ pullback.snd a₁ a₂ = Spec.map (CommRingCat.ofHom φ₂.toRingHom) ≫ i₂) :
    ∃ ρ : CommRingCat.of (A₁ ⊗[k] A₂) ⟶ strictHenselization s,
      Spec.map ρ ≫ productChart a₁ a₂ i₁ i₂ hi₁ hi₂ = strictLocalizationToBase s ∧
      IsLocalRing.maximalIdeal (strictHenselization s) =
        Ideal.span {ρ (ξ ⊗ₜ 1), ρ (1 ⊗ₜ η)} := by
  let φ : A₁ ⊗[k] A₂ →ₐ[k] k :=
    Algebra.TensorProduct.lift φ₁ φ₂ (fun _ _ ↦ Commute.all _ _)
  obtain rfl : s = Spec.map (CommRingCat.ofHom (φ : A₁ ⊗[k] A₂ →+* k)) ≫
      productChart a₁ a₂ i₁ i₂ hi₁ hi₂ := by
    refine pullback.hom_ext ?_ ?_
    · rw [hs₁, productChart, Category.assoc, Category.assoc, pullback.lift_fst,
        pullbackSpecIso_inv_fst_assoc, ← Category.assoc, ← Spec.map_comp]
      congr 3
      ext a
      exact ((Algebra.TensorProduct.lift_tmul φ₁ φ₂ (fun _ _ ↦ Commute.all _ _) a 1).trans
        (by simp)).symm
    · rw [hs₂, productChart, Category.assoc, Category.assoc, pullback.lift_snd,
        pullbackSpecIso_inv_snd_assoc, ← Category.assoc, ← Spec.map_comp]
      congr 3
      ext a
      exact ((Algebra.TensorProduct.lift_tmul φ₁ φ₂ (fun _ _ ↦ Commute.all _ _) 1 a).trans
        (by simp)).symm
  obtain ⟨_, ρ, hρ, hm⟩ := strictHenselization_chart_maximalIdeal (CommRingCat.of (A₁ ⊗[k] A₂))
    (productChart a₁ a₂ i₁ i₂ hi₁ hi₂) (Spec.map (CommRingCat.ofHom (φ : A₁ ⊗[k] A₂ →+* k)))
  refine ⟨ρ, hρ, ?_⟩
  rw [hm, Spec_map_closedPoint_asIdeal,
    Algebra.TensorProduct.ker_lift_eq_span_pair φ₁ φ₂ hξ hη, Ideal.map_span, Set.image_pair]

end AlgebraicGeometry.Scheme
