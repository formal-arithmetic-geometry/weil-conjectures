module
public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.EffectiveCartier
import WeilConjectures.AlgebraicGeometry.Morphisms.RegularImmersion
import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.LineSmooth

/-! # Cartier ideal of the projective-line diagonal

Source: the affine-chart computation in blueprint
lemma-class-diagonal-projective-line (auxiliary; not a blueprint node).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Etale

/-- The diagonal of the projective line over an arbitrary scheme has invertible ideal.
Source: blueprint lemma-class-diagonal-projective-line, proof step 2
(auxiliary; not a blueprint node).

The proof is the standard four-chart computation: on equal-index product charts the
ideal is generated by `v-u` or `u-v`, and on mixed charts by `1-uv` or `uv-1`.
Coefficient comparison proves each generator is a nonzerodivisor over every base ring;
the generators agree by units on overlaps, so the local principal ideals glue to the
diagonal ideal. This intermediate theorem isolates the Cartier calculation used by the
integral identity.
-/
theorem projectiveLine_diagonal_ker_isInvertible (S : Scheme.{u}) :
    (pullback.diagonal (ProjectiveLine S ↘ S)).ker.IsInvertible := by
  intro x
  obtain ⟨U, hx, r, hr, hreg, hI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators
      (c := 1) (i := pullback.diagonal (ProjectiveLine S ↘ S)) x
  cases r with
  | nil => simp at hr
  | cons f r =>
    cases r with
    | nil =>
      refine ⟨U, hx, f, ?_, ?_⟩
      · have hf := (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ f).mp hreg
        exact mem_nonZeroDivisors_iff_right.mpr
          (fun y hy ↦ hf (by simpa [smul_eq_mul, mul_comm] using hy))
      · simpa [Ideal.ofList] using hI.symm
    | cons g r => simp at hr

end AlgebraicGeometry.Etale
