section Fields
variable (l : ℕ) [Fact l.Prime]
variable {E F G H : Type u} [Field E] [Field F] [Field G] [Field H]
variable [Algebra (Padic l) E] [Algebra (Padic l) F] [Algebra (Padic l) G] [Algebra (Padic l) H]
