/-! # Composition of the constructed smooth counits

Source: sk-prop-sp-composition.proof.md, the composite-adjunction transpose
(blueprint: def-pur-general-constructed-composition-trace).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicGeometry.Scheme
open AlgebraicGeometry.ProEtale.CondensedRing
open AlgebraicGeometry.ProEtale.PurityTransport
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.GeneralPurityTransport

/-- Transitivity of the actual constructed counits, before comparing with Brown
right adjoints. The support compositor and the source isomorphism are the specified
proper/open and root-normalized maps, respectively. No new adjoint or map is chosen.

Source: the transposition argument in sk-prop-sp-composition.proof.md
(blueprint: def-pur-general-constructed-composition-trace). -/
def ConstructedCompositionTrace (ell : ℕ) [Fact ell.Prime]
    (k : Type u) [Field k] [Fact (ringChar k).Prime]
    (hk : Finite k ∨ IsAlgClosed k) (hEll : IsUnit (ell : k))
    (c : Coefficient ell) : Prop :=
  ∀ (s : SmoothDatum k) (Z : Over (Spec (.of k)))
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom]
    (g : s.Y.left ⟶ Z.left) [g.IsOver (Spec (.of k))]
    [IsSeparated g] [LocallyOfFiniteType g] [QuasiCompact g]
    (e : ℕ) [SmoothOfRelativeDimension e g] (cg : Compactification g)
    (ch : Compactification (s.map ≫ g))
    (H : CompactSupportComposition.CoherentData (c.obj.{u} ell) k)
    (p : LinePullCoordinates ell c s.map) (K : c.ctf ell Z.left),
    letI : ∀ x : s.X.left, Invertible (ell : s.X.left.residueField x) := fun x ↦
      (show IsUnit (ell : s.X.left.residueField x) from
        (by simpa only [map_natCast] using
          hEll.map ((s.X.left ↘ Spec (.of k)).residueFieldAlgebraMap x))).invertible
    let sg : SmoothDatum k :=
      { X := s.Y, Y := Z, map := g, dim := e, compactification := cg }
    let sh : SmoothDatum k :=
      { X := s.X, Y := Z, map := s.map ≫ g, dim := s.dim + e, compactification := ch }
    let af := constructionFamily ell k hk hEll c s
    let ag := constructionFamily ell k hk hEll c sg
    let ah := constructionFamily ell k hk hEll c sh
    let f₀ := SepFinType.homMk (X := s.X) (Y := s.Y)
      (Over.homMk s.map (comp_over s.map (Spec (.of k))))
    let g₀ := SepFinType.homMk (X := s.Y) (Y := Z)
      (Over.homMk g (comp_over g (Spec (.of k))))
    (H.comp f₀ g₀ s.compactification cg ch).hom.app
        ((inclusion ell c s.X.left).obj
          ((source ell c sh.map sh.dim ah.source_closed).obj K)) ≫ ah.trace K =
      (CondensedRing.rightDerivedLowerShriekOfCompactification (c.obj ell) cg).map
          ((CondensedRing.rightDerivedLowerShriekOfCompactification
            (c.obj ell) s.compactification).map
            (sourceComp ell c s.map g s.dim e p K.obj).hom) ≫
        (CondensedRing.rightDerivedLowerShriekOfCompactification (c.obj ell) cg).map
          (af.trace ((source ell c g e ag.source_closed).obj K)) ≫ ag.trace K

end AlgebraicGeometry.ProEtale.GeneralPurityTransport
