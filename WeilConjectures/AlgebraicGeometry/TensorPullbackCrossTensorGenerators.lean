module

public import WeilConjectures.AlgebraicGeometry.Projective.ProjectiveBundlePullbackSectionNormalization
public import WeilConjectures.AlgebraicGeometry.Modules.TensorSection
import WeilConjectures.AlgebraicGeometry.Modules.TensorPullbackStalk
import WeilConjectures.AlgebraicGeometry.Modules.StalkTensor

/-! # Extending a cross-tensor equation from pulled sections

Source: Stacks Project, Tag 0098 (pullback stalks), followed by bilinearity and sheaf separatedness.
(blueprint: lem-pur-tensor-pullback-cross-tensor-generators).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory Opposite TopologicalSpace MonoidalCategory
open scoped TensorProduct
open scoped ChangeOfRings
namespace AlgebraicGeometry.Scheme.Modules
attribute [local irreducible] tensorPullback

set_option maxHeartbeats 800000 in
-- The proof compares scalar-extension and tensor stalk maps.
private theorem pulled_restrict {X Y : Scheme.{u}} (g : X ⟶ Y)
    {F : Y.Modules} {U V : Y.Opens} (h : V ≤ U) (m : Γ(F, U)) :
    ((tensorPullback g).obj F).presheaf.map
      (homOfLE (g.preimage_mono h)).op (projectiveBundlePullbackSection g m) =
      projectiveBundlePullbackSection g (F.presheaf.map (homOfLE h).op m) := by
  unfold projectiveBundlePullbackSection
  have he := (Hom.app_presheaf_map
    ((projectiveBundlePullbackAdjunction g).unit.app F) (homOfLE h) m).symm
  simp only [Functor.comp_obj, Functor.id_obj, pushforward_obj_presheaf_map] at he
  erw [he]
  rfl

set_option maxHeartbeats 800000 in
-- The proof compares scalar-extension and tensor stalk maps.
private noncomputable def crossStalk {T : Scheme.{u}} {M P Q : T.Modules}
    (q : M ⟶ P) (q' : M ⟶ Q) (x : T) :
    M.presheaf.stalk x →ₗ[T.presheaf.stalk x]
      M.presheaf.stalk x →ₗ[T.presheaf.stalk x]
        P.presheaf.stalk x ⊗[T.presheaf.stalk x] Q.presheaf.stalk x where
  toFun a :=
    { toFun := fun b ↦ q.stalkLinearMap x a ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x b -
        q.stalkLinearMap x b ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x a
      map_add' := by
        intro b c
        simp only [map_add, TensorProduct.tmul_add, TensorProduct.add_tmul]
        abel
      map_smul' := by
        intro r b
        simp only [LinearMap.map_smul, RingHom.id_apply, TensorProduct.tmul_smul,
          TensorProduct.smul_tmul', smul_sub] }
  map_add' := by
    intro a b
    ext c
    change (q.stalkLinearMap x (a + b) ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x c -
      q.stalkLinearMap x c ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x (a + b)) =
      (q.stalkLinearMap x a ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x c -
        q.stalkLinearMap x c ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x a) +
      (q.stalkLinearMap x b ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x c -
        q.stalkLinearMap x c ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x b)
    simp only [map_add, TensorProduct.tmul_add, TensorProduct.add_tmul]
    abel
  map_smul' := by
    intro r a
    ext b
    change (q.stalkLinearMap x (r • a) ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x b -
      q.stalkLinearMap x b ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x (r • a)) =
      r • (q.stalkLinearMap x a ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x b -
        q.stalkLinearMap x b ⊗ₜ[T.presheaf.stalk x] q'.stalkLinearMap x a)
    simp only [LinearMap.map_smul, TensorProduct.tmul_smul,
      TensorProduct.smul_tmul', smul_sub]

set_option maxHeartbeats 800000 in
-- The proof compares scalar-extension and tensor stalk maps.
/-- A cross-tensor identity on pulled affine base sections extends to every local section of
an arbitrary tensor pullback, without a quasi-coherence hypothesis.

Source: Stacks Project, Tag 0098 (pullback stalks), followed by bilinearity and sheaf separatedness.
(blueprint: lem-pur-tensor-pullback-cross-tensor-generators).
Proof: take stalks. A pullback stalk is extension of scalars, and is generated by
1 tensor the germs of base sections. The alternating cross-tensor expression is bilinear;
linearity in each variable reduces it to these generators. Represent two base germs on a
common open and apply the assumed section equation. The tensor-stalk comparison and
separatedness recover the identity on every open. -/
theorem tensorPullback_cross_tensor_of_generators
    {S T : Scheme.{u}} (f : T ⟶ S) (F : S.Modules) {P Q : T.Modules}
    (q : (tensorPullback f).obj F ⟶ P) (q' : (tensorPullback f).obj F ⟶ Q)
    (h : ∀ (U : S.affineOpens) (m n : Γ(F, U.1)),
      tmulSection (q.app (f ⁻¹ᵁ U.1) (projectiveBundlePullbackSection f m))
          (q'.app (f ⁻¹ᵁ U.1) (projectiveBundlePullbackSection f n)) =
        tmulSection (q.app (f ⁻¹ᵁ U.1) (projectiveBundlePullbackSection f n))
          (q'.app (f ⁻¹ᵁ U.1) (projectiveBundlePullbackSection f m))) :
    ∀ (V : T.Opens) (m n : Γ((tensorPullback f).obj F, V)),
      tmulSection (q.app V m) (q'.app V n) =
        tmulSection (q.app V n) (q'.app V m) := by
  classical
  let M := (tensorPullback f).obj F
  have hstalk (x : T) (a b : M.presheaf.stalk x) : crossStalk q q' x a b = 0 := by
    obtain ⟨e, he⟩ := exists_tensorPullback_stalk_iso f x
    have hinv (U : S.Opens) (hx : f x ∈ U) (m : Γ(F, U)) :
        (e.inv.app F) ((1 : T.presheaf.stalk x) ⊗ₜ[S.presheaf.stalk (f x),
          (f.stalkMap x).hom] (F.presheaf.germ U (f x) hx m)) =
          M.presheaf.germ (f ⁻¹ᵁ U) x hx (projectiveBundlePullbackSection f m) := by
      have H := congrArg (e.inv.app F) (he F U hx m)
      change (e.app F).inv ((e.app F).hom
        (M.presheaf.germ (f ⁻¹ᵁ U) x hx (projectiveBundlePullbackSection f m))) = _ at H
      simpa only [Iso.hom_inv_id_apply, Scheme.Modules.presheaf] using H.symm
    have hpure (U V : S.Opens) (hxU : f x ∈ U) (hxV : f x ∈ V)
        (m : Γ(F, U)) (n : Γ(F, V)) :
        crossStalk q q' x
          (M.presheaf.germ (f ⁻¹ᵁ U) x hxU (projectiveBundlePullbackSection f m))
          (M.presheaf.germ (f ⁻¹ᵁ V) x hxV (projectiveBundlePullbackSection f n)) = 0 := by
      obtain ⟨W, hW, hxW, hWUV⟩ := exists_isAffineOpen_mem_and_subset
        (x := f x) (U := U ⊓ V) ⟨hxU, hxV⟩
      let m' := F.presheaf.map (homOfLE (hWUV.trans inf_le_left)).op m
      let n' := F.presheaf.map (homOfLE (hWUV.trans inf_le_right)).op n
      have hm : M.presheaf.germ (f ⁻¹ᵁ U) x hxU
          (projectiveBundlePullbackSection f m) =
          M.presheaf.germ (f ⁻¹ᵁ W) x hxW
            (projectiveBundlePullbackSection f m') := by
        erw [← pulled_restrict f (hWUV.trans inf_le_left) m]
        exact (M.presheaf.germ_res_apply
          (homOfLE (f.preimage_mono (hWUV.trans inf_le_left))) x hxW _).symm
      have hn : M.presheaf.germ (f ⁻¹ᵁ V) x hxV
          (projectiveBundlePullbackSection f n) =
          M.presheaf.germ (f ⁻¹ᵁ W) x hxW
            (projectiveBundlePullbackSection f n') := by
        erw [← pulled_restrict f (hWUV.trans inf_le_right) n]
        exact (M.presheaf.germ_res_apply
          (homOfLE (f.preimage_mono (hWUV.trans inf_le_right))) x hxW _).symm
      rw [hm, hn]
      have H := congrArg (fun z ↦ stalkTensorEquiv P Q x
        ((P ⊗ Q).presheaf.germ (f ⁻¹ᵁ W) x hxW z)) (h ⟨W, hW⟩ m' n')
      simp only [stalkTensorEquiv_germ_tmulSection] at H
      change q.stalkLinearMap x
        (M.presheaf.germ (f ⁻¹ᵁ W) x hxW (projectiveBundlePullbackSection f m')) ⊗ₜ
          q'.stalkLinearMap x
            (M.presheaf.germ (f ⁻¹ᵁ W) x hxW (projectiveBundlePullbackSection f n')) -
        q.stalkLinearMap x
          (M.presheaf.germ (f ⁻¹ᵁ W) x hxW (projectiveBundlePullbackSection f n')) ⊗ₜ
          q'.stalkLinearMap x
            (M.presheaf.germ (f ⁻¹ᵁ W) x hxW (projectiveBundlePullbackSection f m')) = 0
      rw [Hom.stalkLinearMap_germ, Hom.stalkLinearMap_germ,
        Hom.stalkLinearMap_germ, Hom.stalkLinearMap_germ, H, sub_self]
    have hfirst (z : (RingedSpace.moduleStalkFunctor S.toRingedSpace (f x)).obj F) :
        crossStalk q q' x ((e.inv.app F)
          ((1 : T.presheaf.stalk x) ⊗ₜ[S.presheaf.stalk (f x), (f.stalkMap x).hom] z)) = 0 := by
      obtain ⟨U, hxU, m, rfl⟩ := F.presheaf.exists_germ_eq z
      rw [hinv]
      have H₂ : e.inv.app F ≫ ModuleCat.ofHom (crossStalk q q' x
          (M.presheaf.germ (f ⁻¹ᵁ U) x hxU (projectiveBundlePullbackSection f m))) = 0 := by
        apply ModuleCat.ExtendScalars.hom_ext
        intro z
        obtain ⟨V, hxV, n, rfl⟩ := F.presheaf.exists_germ_eq z
        change crossStalk q q' x _ ((e.inv.app F) _) = 0
        rw [hinv]
        exact hpure U V hxU hxV m n
      apply LinearMap.ext
      intro c
      have H₂' := congrArg (fun k ↦ k ((e.hom.app F) c)) H₂
      change crossStalk q q' x _ ((e.app F).inv ((e.app F).hom c)) = 0 at H₂'
      simpa only [Iso.hom_inv_id_apply, LinearMap.zero_apply] using H₂'
    have H : e.inv.app F ≫ ModuleCat.ofHom (crossStalk q q' x) = 0 := by
      apply ModuleCat.ExtendScalars.hom_ext
      intro z
      exact hfirst z
    have H' := congrArg (fun k ↦ k ((e.hom.app F) a) b) H
    change crossStalk q q' x ((e.app F).inv ((e.app F).hom a)) b = 0 at H'
    simpa only [Iso.hom_inv_id_apply] using H'
  intro V m n
  apply TopCat.Presheaf.section_ext ⟨(P ⊗ Q).presheaf, (P ⊗ Q).isSheaf⟩ V
  intro x hx
  change (P ⊗ Q).presheaf.germ V x hx (tmulSection (q.app V m) (q'.app V n)) =
    (P ⊗ Q).presheaf.germ V x hx (tmulSection (q.app V n) (q'.app V m))
  apply (stalkTensorEquiv P Q x).injective
  simp only [stalkTensorEquiv_germ_tmulSection]
  have H := hstalk x (M.presheaf.germ V x hx m) (M.presheaf.germ V x hx n)
  change q.stalkLinearMap x (M.presheaf.germ V x hx m) ⊗ₜ
    q'.stalkLinearMap x (M.presheaf.germ V x hx n) -
      q.stalkLinearMap x (M.presheaf.germ V x hx n) ⊗ₜ
        q'.stalkLinearMap x (M.presheaf.germ V x hx m) = 0 at H
  rw [Hom.stalkLinearMap_germ, Hom.stalkLinearMap_germ,
    Hom.stalkLinearMap_germ, Hom.stalkLinearMap_germ] at H
  exact sub_eq_zero.mp H

end AlgebraicGeometry.Scheme.Modules
