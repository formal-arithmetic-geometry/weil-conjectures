module

public import WeilConjectures.AlgebraicGeometry.TwistingSheafInvertible
public import WeilConjectures.Mathlib.AlgebraicGeometry.Modules.Sheaf

/-!
# The twisting sheaves `𝒪(d)` on `Proj` are generated by their global sections

Let `𝒜 : ℕ → σ` be a graded ring with underlying ring `A`, and let `𝒪(d)`, `d : ℤ`, be the
twisting sheaves on `Proj 𝒜` constructed in `WeilConjectures/AlgebraicGeometry/TwistingSheaf.lean`.
For `d : ℕ` the global sections of `𝒪(d)` attached to the homogeneous elements of degree `d`
generate `𝒪(d)`, under the same covering hypothesis
`AlgebraicGeometry.Proj.IsCoveredByDvdDegree 𝒜 d` under which `𝒪(d)` is invertible.

Indeed, over a basic open set `D₊(f)` with `f` homogeneous of degree `m` and `d = m * k`, the
sections of `𝒪(d)` form a free module of rank one on `f ^ k`
(`AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.sectionPowEquiv`), and that generator is the
restriction of the global section attached to `f ^ k`
(`AlgebraicGeometry.Proj.res_homogeneousSection_eq_sectionPow`). So every section of `𝒪(d)` over
an arbitrary open set is, near each of its points, a multiple of the restriction of a global
section of the family, which is the criterion
`AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_of_forall_exists_mem_span`.

Positivity of the degree is essential: `𝒪(-1)` on `ℙ¹` has no non-zero global section at all.

## Main results

- `AlgebraicGeometry.Proj.isGloballyGenerated_twistingSheaf`: `𝒪(d)`, `d : ℕ`, is generated by
  its global sections as soon as `Proj 𝒜` is covered by the basic open sets of homogeneous
  elements whose degree divides `d`.
- `AlgebraicGeometry.Proj.isGloballyGenerated_twistingSheaf_homogeneousSubmodule`: on the
  projective space `Proj B[Xᵢ]` over an affine base, `𝒪(d)` is generated by its global sections
  for every `d : ℕ`.
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Opposite TopologicalSpace

namespace AlgebraicGeometry

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
variable {𝒜 : ℕ → σ} [GradedRing 𝒜]

namespace Proj

open ProjectiveSpectrum.TwistingSheaf

/-- **`𝒪(d)` is generated by its global sections**, for `d : ℕ`, as soon as `Proj 𝒜` is covered
by basic open sets `D₊(f)` with `f` homogeneous of a degree dividing `d` — the same hypothesis
under which `𝒪(d)` is invertible, see `AlgebraicGeometry.Proj.invertible_twistingSheaf`. The
generating family is that of the global sections attached to the homogeneous elements of degree
`d`: over `D₊(f)` with `f ∈ 𝒜 m` and `d = m * k`, every section of `𝒪(d)` is a multiple of the
restriction of the global section attached to `f ^ k`. -/
theorem isGloballyGenerated_twistingSheaf (d : ℕ) (H : IsCoveredByDvdDegree 𝒜 d) :
    (twistingSheaf 𝒜 d).IsGloballyGenerated := by
  refine Scheme.Modules.isGloballyGenerated_of_forall_exists_mem_span
    (fun a : {a : A // a ∈ 𝒜 d} ↦ homogeneousSection a.2) fun U t x hx ↦ ?_
  obtain ⟨m, f, hf, hfx, hm⟩ := H x
  obtain ⟨k, hk⟩ := Int.natCast_dvd_natCast.1 hm
  have hfk : f ^ k ∈ 𝒜 d := by
    rw [hk, mul_comm]
    simpa [smul_eq_mul] using SetLike.pow_mem_graded k hf
  refine ⟨U ⊓ Proj.basicOpen 𝒜 f, inf_le_left, ⟨hx, hfx⟩, ?_⟩
  refine Submodule.span_mono ?_
    (mem_span_res_homogeneousSection hf inf_le_right k hk hfk _)
  rintro _ rfl
  exact ⟨⟨f ^ k, hfk⟩, rfl⟩

section MvPolynomial

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable (τ B : Type u) [CommRing B]

/-- **The twisting sheaves of non-negative degree on a projective space are generated by their
global sections.** On `Proj B[Xᵢ]`, the projective space over the affine base `Spec B` with
homogeneous coordinates indexed by `τ`, the sheaf `𝒪(d)` is generated by its global sections for
every `d : ℕ`: the irrelevant ideal of the total-degree grading is generated by the variables,
which are homogeneous of degree one. -/
theorem isGloballyGenerated_twistingSheaf_homogeneousSubmodule (d : ℕ) :
    (twistingSheaf (homogeneousSubmodule τ B) d).IsGloballyGenerated :=
  isGloballyGenerated_twistingSheaf d (isCoveredByDvdDegree_of_irrelevant_le_span
    (g := (X : τ → MvPolynomial τ B)) (n := fun _ ↦ 1) (fun i ↦ isHomogeneous_X B i)
    (irrelevant_le_idealOfVars τ B) (fun _ ↦ one_dvd (d : ℤ)))

end MvPolynomial

end Proj

end AlgebraicGeometry
