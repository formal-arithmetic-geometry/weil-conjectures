module

public import WeilConjectures.AlgebraicGeometry.FineFanBlowup
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic

/-!
# Minimal neighborhoods of primes of fine monoids

Source: Illusie--Laszlo--Orgogozo, Exposé VIII, 3.1.1--3.1.4, printed p.98
(blueprint: lem-trf-monoid-prime-minimal-neighborhood).

We follow the dependency's multiplicative notation: products, powers and `1` denote
additive sums, natural multiples and `0`. All fractions live in the canonical group completion.
-/

@[expose] public section

set_option autoImplicit false

universe u

open TopologicalSpace

namespace AlgebraicGeometry.FineFan

open scoped Classical in
/-- A prime complement is a face generated by the selected monoid generators. Their
product defines the smallest open neighborhood and the same localization as the face.
The inverse formula omits one index, so repeated generator values remain distinct.
The last two equivalences use an equality in `P`, not just in its group completion.
We write the complement submonoid as its closure and assert that its carrier is exactly
that complement. The parameter `b`, together with its defining equality, names the
selected product; no further restriction on the generators or the prime is imposed.
Source: ILO VIII 3.1.1--3.1.4(i)--(iii), printed p.98
(blueprint: lem-trf-monoid-prime-minimal-neighborhood).

Proof:
1. The ideal property and properness imply `1` is outside the prime; the prime axiom
   closes the complement under multiplication. If `c*d` avoids the prime,
   neither factor can belong to it, by the ideal property (def-trf-fine-fan-blowup).
2. In any expression in generators for an element outside the prime, remove one
   occurrence of any generator with positive exponent. Step 1 puts that generator
   outside the prime. Conversely all products of selected generators avoid the prime.
3. Apply the same face property at any other prime: the selected product avoids it
   exactly when every selected generator does. Step 2 gives the intersection over
   the entire complement. Empty products and intersections give `D(1)` and the whole space.
4. The product avoids the original prime. Any open neighborhood contains a basic
   neighborhood `D(f)` of the prime, hence `f` is in its complement, and step 3
   puts `D(b)` inside `D(f)` (def-trf-fine-fan-blowup).
5. Since `b` is in the complement, localization at `b` is contained in face localization.
   Write a face element as a product of selected generators with exponents `n_i`.
   Choose `N` at least every `n_i`; multiplying by the product of exponents `N-n_i`
   makes it `b^N`. Thus every face denominator can be replaced by a power of `b`.
6. The product of the other selected indexed generators, times `e_i`, is `b`.
   Dividing the former product by `b` gives the required inverse inside `P_b`.
7. An inverse of a numerator in face localization is `q/f`. Multiplying gives
   `p*q=f` in the completion and then in `P` by fineness. Conversely this equality
   supplies an inverse. Step 1 forces `p` into the face, and for `p` in the face
   take `q=1` and `f=p` (def-trf-fine-fan-blowup).
-/
theorem monoidPrime_minimal_neighborhood
    (P : Type u) [CommMonoid P] (hP : IsFine P)
    (r : ℕ) (e : Fin r → P) (he : Submonoid.closure (Set.range e) = ⊤)
    (x : MonoidPrime P) (b : P)
    (hb : b = (Finset.univ.filter (fun i : Fin r ↦ e i ∉ x.carrier)).prod e) :
    (Submonoid.closure {a : P | a ∉ x.carrier} : Set P) = {a : P | a ∉ x.carrier} ∧
    (∀ c d : P, c * d ∉ x.carrier → c ∉ x.carrier ∧ d ∉ x.carrier) ∧
    (∀ n : Fin r → ℕ, (∏ i : Fin r, e i ^ n i) ∉ x.carrier →
      ∀ i : Fin r, n i ≠ 0 → e i ∉ x.carrier) ∧
    Submonoid.closure {a : P | ∃ i : Fin r, e i ∉ x.carrier ∧ e i = a} =
      Submonoid.closure {a : P | a ∉ x.carrier} ∧
    (basicOpen b : Set (MonoidPrime P)) =
      ⋂ (i : Fin r) (_ : e i ∉ x.carrier), (basicOpen (e i) : Set (MonoidPrime P)) ∧
    (basicOpen b : Set (MonoidPrime P)) =
      ⋂ (f : P) (_ : f ∉ x.carrier), (basicOpen f : Set (MonoidPrime P)) ∧
    x ∈ basicOpen b ∧
    (∀ U : Opens (MonoidPrime P), x ∈ U → basicOpen b ≤ U) ∧
    Algebra.faceLocalization P (Submonoid.powers b) =
      Algebra.faceLocalization P (Submonoid.closure {a : P | a ∉ x.carrier}) ∧
    (∀ i : Fin r, e i ∉ x.carrier →
      Algebra.GrothendieckGroup.of
          (((Finset.univ.filter (fun j : Fin r ↦ e j ∉ x.carrier)).erase i).prod e) *
          (Algebra.GrothendieckGroup.of b)⁻¹ ∈
        Algebra.faceLocalization P (Submonoid.powers b) ∧
      Algebra.GrothendieckGroup.of (e i) *
          (Algebra.GrothendieckGroup.of
            (((Finset.univ.filter (fun j : Fin r ↦ e j ∉ x.carrier)).erase i).prod e) *
            (Algebra.GrothendieckGroup.of b)⁻¹) = 1) ∧
    (∀ p : P,
      ((∃ v : Algebra.faceLocalization P (Submonoid.closure {a : P | a ∉ x.carrier}),
          Algebra.GrothendieckGroup.of p * v.val = 1) ↔
        ∃ q f : P, f ∉ x.carrier ∧ p * q = f) ∧
      ((∃ q f : P, f ∉ x.carrier ∧ p * q = f) ↔ p ∉ x.carrier)) := by
  classical
  have hone (y : MonoidPrime P) : (1 : P) ∉ y.carrier := by
    intro h
    apply y.proper
    apply Set.eq_univ_of_forall
    intro a
    simpa using y.toSubMulAction.smul_mem a h
  have hface (y : MonoidPrime P) (c d : P) (h : c * d ∉ y.carrier) :
      c ∉ y.carrier ∧ d ∉ y.carrier := by
    constructor
    · intro hc
      exact h (by simpa [mul_comm] using y.toSubMulAction.smul_mem d hc)
    · intro hd
      exact h (y.toSubMulAction.smul_mem c hd)
  let F : Submonoid P :=
    { carrier := {a | a ∉ x.carrier}
      one_mem' := hone x
      mul_mem' := x.complement_mul _ _ }
  have hF : Submonoid.closure {a : P | a ∉ x.carrier} = F := by
    exact Submonoid.closure_eq F
  have hprod (y : MonoidPrime P) (s : Finset (Fin r)) (f : Fin r → P) :
      s.prod f ∉ y.carrier ↔ ∀ i ∈ s, f i ∉ y.carrier := by
    induction s using Finset.induction_on with
    | empty => simp [hone y]
    | @insert i s hi ih =>
      rw [Finset.prod_insert hi]
      constructor
      · intro h j hj
        rcases Finset.mem_insert.mp hj with rfl | hj
        · exact (hface y _ _ h).1
        · exact ih.mp (hface y _ _ h).2 j hj
      · intro h
        exact y.complement_mul _ _ (h i (Finset.mem_insert_self _ _))
          (ih.mpr fun j hj ↦ h j (Finset.mem_insert_of_mem hj))
  let S := Finset.univ.filter (fun i : Fin r ↦ e i ∉ x.carrier)
  let T := Submonoid.closure {a : P | ∃ i : Fin r, e i ∉ x.carrier ∧ e i = a}
  have hgen : ∀ a : P, a ∉ x.carrier → a ∈ T := by
    intro a
    have ha : a ∈ Submonoid.closure (Set.range e) := by rw [he]; trivial
    induction ha using Submonoid.closure_induction with
    | mem a ha =>
      rcases ha with ⟨i, rfl⟩
      exact fun hi ↦ Submonoid.subset_closure ⟨i, hi, rfl⟩
    | one => exact fun _ ↦ T.one_mem
    | mul c d _ _ hc hd =>
      intro h
      exact T.mul_mem (hc (hface x c d h).1) (hd (hface x c d h).2)
  have hTF : T = F := by
    apply le_antisymm
    · exact Submonoid.closure_le.mpr fun a ⟨i, hi, ha⟩ ↦ ha ▸ hi
    · exact fun a ha ↦ hgen a ha
  have hbF : b ∉ x.carrier := by
    rw [hb]
    exact (hprod x S e).mpr fun i hi ↦ (Finset.mem_filter.mp hi).2
  have hopen (y : MonoidPrime P) :
      b ∉ y.carrier ↔ ∀ f : P, f ∉ x.carrier → f ∉ y.carrier := by
    constructor
    · intro hy f hf
      have hfT := hgen f hf
      clear hf
      induction hfT using Submonoid.closure_induction with
      | mem a ha =>
        rcases ha with ⟨i, hi, rfl⟩
        exact (hprod y S e).mp (hb ▸ hy) i (Finset.mem_filter.mpr ⟨by simp, hi⟩)
      | one => exact hone y
      | mul c d _ _ hc hd => exact y.complement_mul c d hc hd
    · intro hy
      exact hy b hbF
  have hcofinal : ∀ f : P, f ∉ x.carrier → ∃ q : P, ∃ n : ℕ, f * q = b ^ n := by
    intro f hf
    have hfT := hgen f hf
    clear hf
    induction hfT using Submonoid.closure_induction with
    | mem a ha =>
      rcases ha with ⟨i, hi, rfl⟩
      refine ⟨(S.erase i).prod e, 1, ?_⟩
      rw [pow_one, hb]
      exact Finset.mul_prod_erase S e (Finset.mem_filter.mpr ⟨by simp, hi⟩)
    | one => exact ⟨1, 0, by simp⟩
    | mul c d _ _ hc hd =>
      obtain ⟨q, n, hn⟩ := hc
      obtain ⟨q', n', hn'⟩ := hd
      refine ⟨q * q', n + n', ?_⟩
      rw [pow_add, ← hn, ← hn']
      ac_rfl
  refine ⟨?_, hface x, ?_, ?_, ?_, ?_, hbF, ?_, ?_, ?_, ?_⟩
  · rw [hF]
    rfl
  · intro n hn i hi
    have hni := (hprod x Finset.univ (fun j ↦ e j ^ n j)).mp hn i (by simp)
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hi
    rw [hk, pow_succ] at hni
    exact (hface x _ _ hni).2
  · exact hTF.trans hF.symm
  · ext y
    change b ∉ y.carrier ↔ _
    simp only [Set.mem_iInter]
    change b ∉ y.carrier ↔ ∀ i : Fin r, e i ∉ x.carrier → e i ∉ y.carrier
    rw [hb, hprod]
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  · ext y
    exact (hopen y).trans (by simp only [Set.mem_iInter]; rfl)
  · intro U hx y hy
    have hxy := (hopen y).mp hy
    have hstable : ∀ V : Set (MonoidPrime P), TopologicalSpace.GenerateOpen
        (Set.range (fun a : P ↦ {p : MonoidPrime P | a ∉ p.carrier})) V →
        x ∈ V → y ∈ V := by
      intro V hV
      induction hV with
      | basic V hV =>
        obtain ⟨a, rfl⟩ := hV
        exact hxy a
      | univ => exact fun _ ↦ trivial
      | inter V W _ _ hV hW => exact fun hx ↦ ⟨hV hx.1, hW hx.2⟩
      | sUnion V _ hV =>
        rintro ⟨W, hW, hxW⟩
        exact ⟨W, hW, hV W hW hxW⟩
    exact hstable U U.isOpen hx
  · apply le_antisymm
    · rintro z ⟨p, f, rfl⟩
      refine ⟨p, ⟨f.val, ?_⟩, rfl⟩
      rw [hF]
      exact Submonoid.powers_le.mpr hbF f.property
    · rintro z ⟨p, f, rfl⟩
      have hf : f.val ∉ x.carrier := by
        change f.val ∈ F
        simpa only [hF] using f.property
      obtain ⟨q, n, hn⟩ := hcofinal f.val hf
      refine ⟨p * q, ⟨b ^ n, Submonoid.pow_mem (Submonoid.powers b)
        (Submonoid.mem_powers b) n⟩, ?_⟩
      dsimp only
      rw [← hn, map_mul, map_mul, mul_inv_rev]
      simp only [mul_assoc, mul_left_comm (Algebra.GrothendieckGroup.of q),
        inv_mul_cancel_left]
  · intro i hi
    constructor
    · exact ⟨(S.erase i).prod e, ⟨b, Submonoid.mem_powers b⟩, rfl⟩
    · rw [← mul_assoc, ← map_mul]
      rw [Finset.mul_prod_erase S e (Finset.mem_filter.mpr ⟨by simp, hi⟩), ← hb]
      exact mul_inv_cancel _
  · intro p
    constructor
    · constructor
      · rintro ⟨v, hv⟩
        obtain ⟨q, f, hf⟩ := v.property
        have hpf : p * q = f.val := by
          apply hP.2
          rw [map_mul]
          apply (mul_inv_eq_one).mp
          rw [mul_assoc, ← hf]
          exact hv
        refine ⟨q, f.val, ?_, hpf⟩
        change f.val ∈ F
        simpa only [hF] using f.property
      · rintro ⟨q, f, hf, hpf⟩
        refine ⟨⟨Algebra.GrothendieckGroup.of q *
          (Algebra.GrothendieckGroup.of f)⁻¹,
          ⟨q, ⟨f, Submonoid.subset_closure hf⟩, rfl⟩⟩, ?_⟩
        dsimp only
        rw [← mul_assoc, ← map_mul, hpf]
        exact mul_inv_cancel _
    · constructor
      · rintro ⟨q, f, hf, hpf⟩
        exact (hface x p q (hpf ▸ hf)).1
      · intro hp
        exact ⟨1, p, hp, mul_one p⟩

end AlgebraicGeometry.FineFan
