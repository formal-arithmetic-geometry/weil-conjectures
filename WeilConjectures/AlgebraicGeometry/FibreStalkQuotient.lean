module

public import Mathlib.AlgebraicGeometry.Fiber
public import Mathlib.RingTheory.LocalRing.RingHom.Basic

/-! # The canonical quotient description of a scheme fibre stalk

Source: Stacks Project, Tag 0HA1 (blueprint: lem-sbc-scheme-fibre-stalk-quotient).
-/

@[expose] public section

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry

private lemma spec_stalkCongr {Y : Scheme.{u}} {x y : Y} (h : x = y) :
    Spec.map (Y.presheaf.stalkCongr (.of_eq h)).hom ≫ Y.fromSpecStalk x =
      Y.fromSpecStalk y := by
  subst y
  simp

namespace Scheme.Hom

/-- The first projection of the pointed scheme fibre on stalks.
Source: Stacks Project, Tag 0HA1 (blueprint: lem-sbc-scheme-fibre-stalk-quotient). -/
noncomputable def fiberStalkMap {Y T : Scheme.{u}} (g : Y ⟶ T) (y : Y) :
    Y.presheaf.stalk y ⟶ (g.fiber (g y)).presheaf.stalk (g.asFiber y) :=
  (Y.presheaf.stalkCongr (.of_eq (g.fiberι_asFiber y))).inv ≫
    (g.fiberι (g y)).stalkMap (g.asFiber y)

private lemma spec_fiberStalkMap {Y T : Scheme.{u}} (g : Y ⟶ T) (y : Y) :
    Spec.map (g.fiberStalkMap y) ≫ Y.fromSpecStalk y =
      (g.fiber (g y)).fromSpecStalk (g.asFiber y) ≫ g.fiberι (g y) := by
  dsimp [fiberStalkMap]
  rw [Spec.map_comp, Category.assoc]
  change Spec.map ((g.fiberι (g y)).stalkMap (g.asFiber y)) ≫
    Spec.map (Y.presheaf.stalkCongr (.of_eq (g.fiberι_asFiber y).symm)).hom ≫ _ = _
  rw [spec_stalkCongr (g.fiberι_asFiber y).symm,
    Scheme.SpecMap_stalkMap_fromSpecStalk]

private lemma fiberStalkMap_base {Y T : Scheme.{u}} (g : Y ⟶ T) (y : Y) :
    ∃ k : T.residueField (g y) ⟶ (g.fiber (g y)).presheaf.stalk (g.asFiber y),
      g.stalkMap y ≫ g.fiberStalkMap y = T.residue (g y) ≫ k := by
  let k := Spec.preimage ((g.fiber (g y)).fromSpecStalk (g.asFiber y) ≫
    g.fiberToSpecResidueField (g y))
  refine ⟨k, ?_⟩
  apply Spec.map_injective
  apply (cancel_mono (T.fromSpecStalk (g y))).mp
  simp only [Spec.map_comp, Category.assoc]
  rw [Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc, spec_fiberStalkMap,
    Category.assoc, g.fiber_fac]
  rw [← Category.assoc]
  change _ = Spec.map k ≫ T.fromSpecResidueField (g y)
  rw [Spec.map_preimage]

/-- The fibre projection is surjective on stalks with kernel generated by the base
maximal ideal, and its quotient equivalence sends each original germ to its image.
Source: Stacks Project, Tag 0HA1 (blueprint: lem-sbc-scheme-fibre-stalk-quotient).

Proof: The first projection is a preimmersion, hence its stalk map is surjective.
The base maximal ideal is killed because the cartesian square factors the base
stalk map through its residue field. Conversely, put I equal to that extended
maximal ideal in the source stalk D. The local ring D/I maps canonically to the
fibre: the map from the base stalk factors through its residue field, so the
pullback universal property gives Spec(D/I) to the fibre. The induced local stalk
map composed with the projection is the quotient map. Thus the kernel is contained
in I. The first isomorphism theorem now gives the required equivalence, and its
formula follows directly from its construction. -/
theorem fiberStalkMap_surjective_ker_quotientEquiv {Y T : Scheme.{u}}
    (g : Y ⟶ T) (y : Y) :
    Function.Surjective (g.fiberStalkMap y).hom ∧
      RingHom.ker (g.fiberStalkMap y).hom =
        (IsLocalRing.maximalIdeal (T.presheaf.stalk (g y))).map (g.stalkMap y).hom ∧
      ∃ e : (Y.presheaf.stalk y ⧸
          (IsLocalRing.maximalIdeal (T.presheaf.stalk (g y))).map (g.stalkMap y).hom) ≃+*
          (g.fiber (g y)).presheaf.stalk (g.asFiber y),
        ∀ z : Y.presheaf.stalk y, e (Ideal.Quotient.mk _ z) = (g.fiberStalkMap y).hom z := by
  classical
  let I := (IsLocalRing.maximalIdeal (T.presheaf.stalk (g y))).map (g.stalkMap y).hom
  have hs : Function.Surjective (g.fiberStalkMap y).hom :=
    ((g.fiberι (g y)).stalkMap_surjective (g.asFiber y)).comp
      (ConcreteCategory.bijective_of_isIso
        (Y.presheaf.stalkCongr (.of_eq (g.fiberι_asFiber y))).inv).2
  obtain ⟨k, hk⟩ := fiberStalkMap_base g y
  have hle : I ≤ RingHom.ker (g.fiberStalkMap y).hom := by
    rw [Ideal.map_le_iff_le_comap]
    intro z hz
    have hh := congrArg (fun t ↦ t z) hk
    change (g.fiberStalkMap y) ((g.stalkMap y) z) = 0
    rw [CommRingCat.comp_apply, CommRingCat.comp_apply] at hh
    rw [hh]
    change k (IsLocalRing.residue _ z) = 0
    rw [(IsLocalRing.residue_eq_zero_iff _).mpr hz, map_zero]
  have hI : I ≠ ⊤ := ne_of_lt (IsLocalRing.map_maximalIdeal_lt_top (g.stalkMap y).hom)
  let Q := CommRingCat.of (Y.presheaf.stalk y ⧸ I)
  have : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hI
  have : IsLocalRing Q := IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective
  let q : Y.presheaf.stalk y ⟶ Q := CommRingCat.ofHom (Ideal.Quotient.mk I)
  have : IsLocalHom q.hom := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  let r : T.residueField (g y) ⟶ Q := CommRingCat.ofHom
    (Ideal.Quotient.lift _ (q.hom.comp (g.stalkMap y).hom) (by
      intro z hz
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hz)))
  have hr : T.residue (g y) ≫ r = g.stalkMap y ≫ q := by rfl
  let l : Spec Q ⟶ g.fiber (g y) := pullback.lift
    (Spec.map q ≫ Y.fromSpecStalk y) (Spec.map r) (by
      rw [Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
        ← Spec.map_comp_assoc, ← hr, Spec.map_comp]
      rfl)
  have hl₁ : l ≫ g.fiberι (g y) = Spec.map q ≫ Y.fromSpecStalk y :=
    pullback.lift_fst ..
  have hl : l (IsLocalRing.closedPoint Q) = g.asFiber y := by
    apply (g.fiberι (g y)).isEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hl₁]
    simp only [Scheme.Hom.comp_apply, Spec_closedPoint, Scheme.fromSpecStalk_closedPoint,
      Scheme.Hom.fiberι_asFiber]
  let ψ : (g.fiber (g y)).presheaf.stalk (g.asFiber y) ⟶ Q :=
    ((g.fiber (g y)).presheaf.stalkCongr (.of_eq hl)).inv ≫ Scheme.stalkClosedPointTo l
  have hψ : Spec.map ψ ≫ (g.fiber (g y)).fromSpecStalk (g.asFiber y) = l := by
    dsimp only [ψ]
    rw [Spec.map_comp, Category.assoc]
    change Spec.map (Scheme.stalkClosedPointTo l) ≫
      Spec.map ((g.fiber (g y)).presheaf.stalkCongr (.of_eq hl.symm)).hom ≫ _ = _
    rw [spec_stalkCongr hl.symm, Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
  have hq : g.fiberStalkMap y ≫ ψ = q := by
    apply Spec.map_injective
    apply (cancel_mono (Y.fromSpecStalk y)).mp
    rw [Spec.map_comp, Category.assoc, spec_fiberStalkMap, ← Category.assoc, hψ, hl₁]
  have hker : RingHom.ker (g.fiberStalkMap y).hom = I := by
    apply le_antisymm _ hle
    intro z hz
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q z = 0
    rw [← hq, CommRingCat.comp_apply]
    change ψ ((g.fiberStalkMap y).hom z) = 0
    rw [RingHom.mem_ker.mp hz, map_zero]
  refine ⟨hs, hker, ?_⟩
  let e := (Ideal.quotEquivOfEq hker.symm).trans
    ((g.fiberStalkMap y).hom.quotientKerEquivOfSurjective hs)
  exact ⟨e, fun z ↦ by
    change (g.fiberStalkMap y).hom.quotientKerEquivOfSurjective hs
      (Ideal.Quotient.mk _ z) = _
    rfl⟩

end Scheme.Hom
end AlgebraicGeometry
