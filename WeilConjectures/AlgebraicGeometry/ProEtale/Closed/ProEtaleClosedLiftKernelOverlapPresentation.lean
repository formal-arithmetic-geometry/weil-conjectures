module

public import WeilConjectures.AlgebraicGeometry.ProEtale.Closed.ProEtaleClosedLiftOverlapRelations

import WeilConjectures.AlgebraicGeometry.ProEtale.Closed.ProEtaleClosedLiftArrowNormalization
import WeilConjectures.AlgebraicGeometry.ProEtale.Closed.ProEtaleClosedLiftArrowExact
import Mathlib.CategoryTheory.Abelian.Refinements

/-! # A free-module presentation of the closed-lift relation kernel

Source: Step 1 of `lem-sp-proetale-proper-closed-lift-relations`.
(blueprint: lem-sp-proetale-closed-lift-kernel-overlap-presentation).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.Scheme

/-- Lift a kernel-valued map through the source presentation after an epimorphic
refinement. Its actual-arrow component is a cycle, so exactness lifts that component
through the overlap boundary after one further epimorphic refinement. The other
component already comes from the test relations. Cancel the kernel inclusion and
combine the two lifts into the coproduct. -/
private theorem kernel_presentation_of_arrow_resolution
    {C : Type*} [Category C] [Abelian C] {D B M Q R : C}
    (e : M ⟶ Q) (d : D ⟶ kernel e) (b : B ⟶ M)
    (ρ : R ⟶ B) (r : R ⟶ kernel e)
    (hρ : ρ ≫ b = r ≫ kernel.ι e)
    (hzero : ρ ≫ (b ≫ e) = 0)
    (hgen : Epi (biprod.desc (d ≫ kernel.ι e) b))
    (hex : (ShortComplex.mk ρ (b ≫ e) hzero).Exact) :
    Epi (coprod.desc d r) := by
  let t := biprod.desc (d ≫ kernel.ι e) b
  have : Epi t := hgen
  rw [epi_iff_surjective_up_to_refinements]
  intro T y
  obtain ⟨T', π, hπ, x, hx⟩ :=
    surjective_up_to_refinements_of_epi t (y ≫ kernel.ι e)
  have hbzero : (x ≫ biprod.snd) ≫ (b ≫ e) = 0 := by
    have h := congrArg (fun k ↦ k ≫ e) hx
    simpa [t, biprod.desc_eq, Preadditive.comp_add, Preadditive.add_comp,
      Category.assoc] using h.symm
  obtain ⟨T'', π', hπ', v, hv⟩ := hex.exact_up_to_refinements (x ≫ biprod.snd) hbzero
  have heq : π' ≫ π ≫ y = (π' ≫ x ≫ biprod.fst) ≫ d + v ≫ r := by
    apply (cancel_mono (kernel.ι e)).mp
    simp only [Category.assoc, Preadditive.add_comp]
    calc
      π' ≫ π ≫ y ≫ kernel.ι e = π' ≫ x ≫ t := by rw [← hx]
      _ = (π' ≫ x ≫ biprod.fst) ≫ d ≫ kernel.ι e +
          (π' ≫ x ≫ biprod.snd) ≫ b := by
        simp only [t, biprod.desc_eq, Preadditive.comp_add, Category.assoc]
      _ = _ := by
        change π' ≫ x ≫ biprod.snd = v ≫ ρ at hv
        have h := congrArg (fun k ↦ k ≫ b) hv
        simp only [Category.assoc, hρ] at h ⊢
        rw [h]
  refine ⟨T'', π' ≫ π, inferInstance,
    (π' ≫ x ≫ biprod.fst) ≫ coprod.inl + v ≫ coprod.inr, ?_⟩
  simpa only [Preadditive.add_comp, Category.assoc,
    coprod.inl_desc, coprod.inr_desc] using heq

/-- Closed-lift relations together with elementary overlaps generate the kernel.
This statement needs no properness assumption and does not assert that overlaps
are themselves generated by closed-lift tests.

Source: Step 1 of `lem-sp-proetale-proper-closed-lift-relations`.
(blueprint: lem-sp-proetale-closed-lift-kernel-overlap-presentation).

Proof: form the coproduct B of actual-arrow summands, its map b to the full
augmentation source, and the overlap boundary rho into B. The boundary followed
by b is the given overlap map followed by the kernel inclusion. Normalization
says that the source is generated by b together with d followed by the kernel
inclusion. Actual-arrow exactness says that rho generates the kernel of b e.
For an arbitrary map y into ker(e), lift y followed by the kernel inclusion
through this source presentation after an epimorphic refinement. Its B component
is killed by b e, so lift that component through rho after another epimorphic
refinement. The compatibility equation and cancellation of the kernel inclusion
express the refined y as a d term plus an overlap term. This is surjectivity up
to epimorphic refinements, hence the claimed epimorphism. -/
theorem closedLiftKernel_overlap_presentation (A : Type u) [CommRing A]
    {X Z : Scheme.{u}} (z : Z ⟶ X) (P : X.ProEt) :
    let Q := (ProEtale.freeSheaf (ULift.{u + 1, u} A) X).obj P
    let e := closedLiftGeneratorAugmentation A z Q
    let d := closedLiftGeneratorAugmentation A z (kernel e.hom)
    Epi (coprod.desc d.hom (closedLiftOverlapRelationsMap A z P)) := by
  exact kernel_presentation_of_arrow_resolution _ _ _ _ _
    (closedLiftArrowBoundary_comp A z P) (closedLiftArrowBoundary_zero A z P)
    (closedLiftArrow_normalization A z P) (closedLiftArrow_exact A z P)

end AlgebraicGeometry.Scheme
