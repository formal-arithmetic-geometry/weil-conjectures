module

public import WeilConjectures.AlgebraicGeometry.ProEtale.Closed.ProEtaleClosedLiftArrowComplex
public import Mathlib.Algebra.Homology.ShortComplex.Exact
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Adjunctions

/-! # Relations among actual arrows are generated by elementary overlaps

Source: Step 3 of `lem-sp-proetale-closed-lift-kernel-overlap-presentation`.
(blueprint: lem-sp-proetale-closed-lift-arrow-exact).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.Scheme

/-- The overlap boundary generates the kernel of actual-arrow evaluation.
There are no arbitrary maps from a free test sheaf in this augmentation, only
free maps induced by actual arrows to P. Evaluation need not be epic.

Source: Step 3 of `lem-sp-proetale-closed-lift-kernel-overlap-presentation`.
(blueprint: lem-sp-proetale-closed-lift-arrow-exact).

Proof: before sheafification form the presheaf of sets S whose sections on V
are pairs (t, v), where t is an arrow index and v is an arrow from V to U_t.
The evaluation map sends (t,v) to v followed by t's arrow to P. Its kernel
pair has sections (t,s,v,w) with equal composites into P. The pullback universal
property identifies these with the disjoint union, over (t,s), of arrows from
V to U_t times_P U_s. These identifications are natural in V.

Pass to the free A-module presheaves. They commute with the indicated coproducts,
so the three terms become the presheaf versions of the displayed overlap
source, actual-arrow source, and A[P]. The first map is the difference of
the two projections; the second sends each basis arrow to its composite.
The resulting sequence is exact objectwise: for a finite formal sum mapping
to zero, group its basis vectors by their common composite. Each group has
coefficient sum zero. Choose a basis vector in each nonempty group. Express
the group as the sum, over its other vectors, of the coefficient times the
difference with this chosen vector. Every such difference is indexed by the
kernel pair. Empty groups contribute zero and no representative is chosen
from them. This works over every commutative ring, including the zero ring.

Sheafification of module presheaves preserves finite limits and colimits, hence
preserves this exactness. It also preserves the coproducts, and its comparison
isomorphisms identify the two maps with closedLiftArrowBoundary and the composite
of closedLiftArrowAugmentation with e. Compatibility is checked on each summand
and its Yoneda generator; it is the pullback projection equation, with the same
order and sign as in the definitions. Exactness is invariant under these
isomorphisms, proving the assertion. No cover of P by the tests is required,
because the argument proves exactness at S, not surjectivity onto A[P]. -/
theorem closedLiftArrow_exact (A : Type u) [CommRing A]
    {X Z : Scheme.{u}} (z : Z ⟶ X) (P : X.ProEt) :
    (ShortComplex.mk (closedLiftArrowBoundary A z P)
      (closedLiftArrowAugmentation A z P ≫ (closedLiftGeneratorAugmentation A z
        ((ProEtale.freeSheaf (ULift.{u + 1, u} A) X).obj P)).hom)
      (closedLiftArrowBoundary_zero A z P)).Exact := by
  classical
  let I := ClosedLiftArrowIndex z P
  let Y := uliftYoneda.{u + 1} (C := X.ProEt)
  let W := (Functor.whiskeringRight X.ProEtᵒᵖ _ _).obj
    (ModuleCat.free.{u + 1} (ULift.{u + 1, u} A))
  let L := presheafToSheaf (ProEt.topology X) (ModuleCat.{u + 1} (ULift.{u + 1, u} A))
  let Φ := W ⋙ L
  let adj : Φ ⊣ _ := ((ModuleCat.adj (ULift.{u + 1, u} A)).whiskerRight X.ProEtᵒᵖ).comp
    (sheafificationAdjunction _ _)
  have : Φ.IsLeftAdjoint := adj.isLeftAdjoint
  let Kf : I × I → (X.ProEtᵒᵖ ⥤ Type (u + 1)) := fun ts ↦
    Y.obj (pullback ts.1.val.2 ts.2.val.2)
  let Sf : I → (X.ProEtᵒᵖ ⥤ Type (u + 1)) := fun t ↦ Y.obj t.val.1
  let f : ∐ Kf ⟶ ∐ Sf := Sigma.desc fun ts ↦
    Y.map (pullback.fst ts.1.val.2 ts.2.val.2) ≫ Sigma.ι Sf ts.1
  let g : ∐ Kf ⟶ ∐ Sf := Sigma.desc fun ts ↦
    Y.map (pullback.snd ts.1.val.2 ts.2.val.2) ≫ Sigma.ι Sf ts.2
  let c : ∐ Sf ⟶ Y.obj P := Sigma.desc fun t ↦ Y.map t.val.2
  have hfg : f ≫ c = g ≫ c := by
    apply Sigma.hom_ext
    intro ts
    simp only [f, g, c, Sf, Sigma.ι_desc_assoc, Category.assoc, Sigma.ι_desc, ← Y.map_comp,
      pullback.condition]
  have hK : ∀ (V : X.ProEtᵒᵖ) (x y : (∐ Sf).obj V), c.app V x = c.app V y →
      ∃ k, f.app V k = x ∧ g.app V k = y := by
    intro V x y hxy
    have hS := isColimitOfPreserves ((CategoryTheory.evaluation _ _).obj V)
      (colimit.isColimit (Discrete.functor Sf))
    obtain ⟨⟨t⟩, a, rfl⟩ := Types.jointly_surjective_of_isColimit hS x
    obtain ⟨⟨s⟩, b, rfl⟩ := Types.jointly_surjective_of_isColimit hS y
    have hc : ∀ (r : I) (e : (Sf r).obj V),
        c.app V ((Sigma.ι Sf r).app V e) = ULift.up (e.down ≫ r.val.2) := by
      intro r e
      rw [← types_comp_apply ((Sigma.ι Sf r).app V) (c.app V), ← NatTrans.comp_app,
        Sigma.ι_desc]
      rfl
    have hab : a.down ≫ t.val.2 = b.down ≫ s.val.2 := by
      simp only [Functor.mapCocone_ι_app, colimit.cocone_ι, evaluation_obj_map,
        Discrete.functor_obj_eq_as] at hxy
      erw [hc, hc] at hxy
      exact congrArg ULift.down hxy
    refine ⟨(Sigma.ι Kf (t, s)).app V (ULift.up (pullback.lift a.down b.down hab)), ?_, ?_⟩
    · rw [← types_comp_apply ((Sigma.ι Kf (t, s)).app V) (f.app V), ← NatTrans.comp_app,
        Sigma.ι_desc]
      simp only [NatTrans.comp_app, types_comp_apply]
      erw [uliftYoneda_map_app]
      simp
      rfl
    · rw [← types_comp_apply ((Sigma.ι Kf (t, s)).app V) (g.app V), ← NatTrans.comp_app,
        Sigma.ι_desc]
      simp only [NatTrans.comp_app, types_comp_apply]
      erw [uliftYoneda_map_app]
      simp
      rfl
  have hpre := ModuleCat.exact_whiskeringRight_free_of_surjective_kernelPair
    (R := ULift.{u + 1, u} A) f g c hfg hK
  have hsh := hpre.map L
  refine (ShortComplex.exact_iff_of_iso ?_).2 hsh
  have hΦ : ∀ {a b : X.ProEtᵒᵖ ⥤ Type (u + 1)} (h : a ⟶ b), Φ.map h = L.map (W.map h) :=
    fun _ ↦ rfl
  have hF : ∀ {U V : X.ProEt} (h : U ⟶ V),
      (ProEtale.freeSheaf (ULift.{u + 1, u} A) X).map h = L.map (W.map (Y.map h)) :=
    fun _ ↦ rfl
  refine ShortComplex.isoMk (asIso (sigmaComparison Φ Kf)) (asIso (sigmaComparison Φ Sf))
    (Iso.refl _) ?_ ?_
  · apply Sigma.hom_ext
    intro ts
    erw [reassoc_of% (ι_comp_sigmaComparison Φ Kf ts)]
    simp only [closedLiftArrowBoundary, Sigma.ι_desc_assoc, Preadditive.sub_comp,
      Category.assoc]
    erw [ι_comp_sigmaComparison Φ Sf ts.1, ι_comp_sigmaComparison Φ Sf ts.2]
    simp only [ShortComplex.map_f, hΦ, hF, ← L.map_comp, ← L.map_sub, ← W.map_comp,
      Preadditive.comp_sub]
    erw [← Functor.map_comp, ← Functor.map_comp]
    simp only [f, g, Sigma.ι_desc]
  · apply Sigma.hom_ext
    intro t
    erw [reassoc_of% (ι_comp_sigmaComparison Φ Sf t)]
    simp only [ShortComplex.map_g, Iso.refl_hom, Category.comp_id, closedLiftArrowAugmentation,
      Sigma.ι_desc_assoc, closedLiftArrowι_augmentation]
    simp only [hΦ, hF, ← L.map_comp]
    erw [← Functor.map_comp]
    simp only [c, Sigma.ι_desc]

end AlgebraicGeometry.Scheme
