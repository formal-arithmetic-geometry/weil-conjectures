module

public import WeilConjectures.AlgebraicGeometry.ClosedLiftChain.ProEtaleClosedLiftChainCalculus
public import WeilConjectures.AlgebraicGeometry.ProEtale.Proper.ProEtaleProperClosedFibreConnectedness

/-! # Local arrow chains through the proper closed fibre

Source: Step 3 of `lem-sp-proetale-proper-closed-overlap-chains`.
(blueprint: lem-sp-proetale-proper-closed-lift-local-chains).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.Scheme

/-- Two arrows from closed-lift tests into the proper pullback are locally joined
by a finite chain whose edges extend together to a closed-lift test. This assertion
is about site objects and their arrows, independently of the coefficient ring.

Source: Step 3 of `lem-sp-proetale-proper-closed-overlap-chains`.
(blueprint: lem-sp-proetale-proper-closed-lift-local-chains).

Proof: start with a point of the overlap and its common image in P. Each of the two
tests specializes into the closed fibre. The images of these specializations lie
in the intersection of the closure of the common image with the closed fibre.
By hconnected this intersection is nonempty and connected. Cover that intersection
by affine neighbourhoods. The equivalence relation generated by intersecting
neighbourhoods has one class: the unions of distinct classes would disconnect the
intersection. Thus the two chosen endpoints are joined by a finite sequence.
Refine the closed pieces of these neighbourhoods and each adjacent intersection
by affine weakly contractible objects of the closed pro-etale site. Apply the
canonical closed-site lift to all objects and arrows of this finite diagram.
Full faithfulness and the closed-site adjunction make the two maps at each edge
commute over P. The closed inverse-image evaluation isomorphism identifies the
chosen closed arrows with their lifted sections. The finitely many covers of the
base needed to retain the original common generic arrow split by hW; pulling
back those splittings gives local arrows from the original overlap to the lifted
diagram. Each lifted object is affine, weakly contractible, and specializes into
the closed fibre, hence is a ClosedLiftTest. Its two maps are exactly an Edge.
Taking the union of the resulting local refinements gives a covering family of
the overlap, together with the asserted reflexive transitive chains. No cover
of the original overlap by ClosedLiftTests is asserted. Empty overlaps use the
empty covering family and need no endpoint choices. -/
theorem proper_closed_lift_local_chains
    {B D E : Scheme.{u}} (p : B ⟶ D) (i : E ⟶ D)
    [IsProper p] [IsOpenImmersion i] [QuasiCompact i]
    (W : D.ProEt) [IsAffine W.left]
    (hW : ∀ (F G : Sheaf (ProEt.topology D) (Type (u + 1))) (e : F ⟶ G),
      Epi e → Function.Surjective (e.hom.app (op W)))
    (hconnected :
      let z := (pullback.fst p i).closedComplement
      let P := (proEtaleBaseChange p).obj W
      ∀ C : Set P.left, IsClosed C → IsIrreducible C →
        IsConnected (C ∩ P.hom ⁻¹' Set.range z)) :
    let z := (pullback.fst p i).closedComplement
    let P := (proEtaleBaseChange p).obj W
    ∀ t s : ClosedLiftArrowIndex z P,
      ∃ (κ : Type (u + 1)) (V : κ → B.ProEt)
        (a : ∀ j, V j ⟶ pullback t.val.2 s.val.2),
        Presieve.ofArrows V a ∈ ProEt.precoverage B _ ∧
        ∀ j, Relation.ReflTransGen ClosedLiftChain.Edge
          (⟨t, a j ≫ pullback.fst t.val.2 s.val.2, by
            simp only [Category.assoc]⟩ :
            ClosedLiftChain.Vertex z (a j ≫ pullback.fst t.val.2 s.val.2 ≫ t.val.2))
          ⟨s, a j ≫ pullback.snd t.val.2 s.val.2, by
            simp only [Category.assoc, pullback.condition]⟩ := by sorry

end AlgebraicGeometry.Scheme
