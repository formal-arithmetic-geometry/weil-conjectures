/-! # Relations between free closed-lift generators over a proper boundary test

Source: Step 3 of `lem-sp-proetale-proper-closed-injective-sections`.
(blueprint: lem-sp-proetale-proper-closed-lift-relations).
-/

@[expose] public section

set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace AlgebraicGeometry.Scheme

/-- The relations in the free closed-lift presentation of the proper test object
are generated by the same affine closed-specialization tests.

Source: the augmented free-module relations argument in Step 3 of
`lem-sp-proetale-proper-closed-injective-sections`.
(blueprint: lem-sp-proetale-proper-closed-lift-relations).

Proof: a section of the relation kernel is locally a finite linear combination
of arrows from affine henselian lifts to P = B times_D W whose image in A[P]
is zero. Express its relations by differences on pairwise overlaps. Lift every
base specialization through the proper closure of the image point. Affine
closed-localization refinements give the closed-specialization neighbourhoods.
The weak contractibility of W splits the covers on the base. On the proper
closures, henselian connectedness permits a finite chain of overlap relations
meeting the closed fibre; refine these chains by affine weakly contractible
closed-site objects and their henselian lifts. The free-module relations of the
original section are therefore sums of images of sections on those lifts. Each
such map A[U] to the kernel occurs in its canonical augmentation. Thus that
augmentation is locally surjective, hence epic. The argument concerns relations,
not chosen lifts into an injective. For the empty proper test Q is zero, so the
relation kernel is the source coproduct itself and its summand inclusions already
generate it. With zero coefficients every free sheaf is zero. -/
theorem proper_closedLift_relations_generated
    (A : Type u) [CommRing A] [Finite A]
    {B D E : Scheme.{u}} (p : B ⟶ D) (i : E ⟶ D)
    [IsProper p] [IsOpenImmersion i] [QuasiCompact i]
    (W : D.ProEt) [IsAffine W.left]
    (hW : ∀ (F G : Sheaf (ProEt.topology D) (Type (u + 1))) (e : F ⟶ G),
      Epi e → Function.Surjective (e.hom.app (op W)))
    (hspecializes : ∀ x : W.left, ∃ z : ↥(pullback W.hom i.closedComplement),
      Specializes x ((pullback.fst W.hom i.closedComplement) z)) :
    let z := (pullback.fst p i).closedComplement
    let P := (proEtaleBaseChange p).obj W
    let Q := (ProEtale.freeSheaf (ULift.{u + 1, u} A) B).obj P
    let e := closedLiftGeneratorAugmentation A z Q
    Epi (closedLiftGeneratorAugmentation A z (kernel e.hom)).hom := by
  let z := (pullback.fst p i).closedComplement
  let P := (proEtaleBaseChange p).obj W
  let Q := (ProEtale.freeSheaf (ULift.{u + 1, u} A) B).obj P
  let e := closedLiftGeneratorAugmentation A z Q
  let d := closedLiftGeneratorAugmentation A z (kernel e.hom)
  let r := closedLiftOverlapRelationsMap A z P
  have : Epi (coprod.desc d.hom r) := closedLiftKernel_overlap_presentation A z P
  have hr : r ≫ cokernel.π d.hom = 0 := by
    apply Sigma.hom_ext
    intro ts
    simpa only [r, closedLiftOverlapRelationsMap, Category.assoc,
      Sigma.ι_desc_assoc, comp_zero] using
      proper_closedLift_overlap_cokernel A p i W hW hspecializes ts.1 ts.2
  change Epi d.hom
  apply Abelian.epi_of_cokernel_π_eq_zero
  apply (cancel_epi (coprod.desc d.hom r)).mp
  apply coprod.hom_ext
  · simpa only [coprod.inl_desc_assoc, comp_zero] using cokernel.condition d.hom
  · simpa only [coprod.inr_desc_assoc, comp_zero] using hr

end AlgebraicGeometry.Scheme
