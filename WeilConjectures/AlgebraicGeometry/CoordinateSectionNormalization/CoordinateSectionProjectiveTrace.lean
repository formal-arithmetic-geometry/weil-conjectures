private theorem supportSquare (T : Scheme.{u}) :
    IsPullback (𝟙 T) (sectionMap T) (projectiveZero T) (ProjectiveLine.affineChart T) :=
  (IsPullback.of_vert_isIso_mono (snd := 𝟙 T)
    ⟨by simp only [Category.id_comp, projectiveZero]⟩).flip

private def supportExchange (A : Type (u + 1)) [CommRing A] (T : Scheme.{u}) :=
  Etale.supportedConstantExchange A (projectiveZero T) (sectionMap T)
    (ProjectiveLine.affineChart T) (𝟙 T) (supportSquare T).toCommSq

private instance supportExchange_isIso
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] : IsIso (supportExchange A T) := by
  have := Etale.isIso_baseChangeMap_of_isFinite (ModuleCat.{u + 1} A) (supportSquare T)
  dsimp only [supportExchange, Etale.supportedConstantExchange]
  infer_instance

private def supportRestriction (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :
    (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).obj
      ((Etale.ordinaryFinitePushforward A (projectiveZero T)).obj
        (Etale.ordinaryFiniteUnit A T)) ≅
      (closedImage A T).obj (Etale.ordinaryFiniteUnit A T) :=
  (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).mapIso
    ((Etale.lowerStar (ModuleCat.{u + 1} A) (projectiveZero T)
      ).singleFunctorCompRightDerivedFunctorIso.app (Etale.ordinaryFiniteConstant A T)) ≪≫
    (Etale.ordinaryFiniteSinglePullbackIso A (ProjectiveLine.affineChart T)).app _ ≪≫
    (Etale.ordinaryFiniteSingleFunctor A (AffineSpace PUnit.{u + 1} T)).mapIso
      (asIso (supportExchange A T)) ≪≫
    ((Etale.lowerStar (ModuleCat.{u + 1} A) (sectionMap T)
      ).singleFunctorCompRightDerivedFunctorIso.app (Etale.ordinaryFiniteConstant A T)).symm

private theorem closed_unit_single
    (A : Type (u + 1)) [CommRing A] {X Y : Scheme.{u}}
    (i : X ⟶ Y) [IsClosedImmersion i] :
    Etale.supportedDerivedUnit A i ≫
      (Etale.lowerStar (ModuleCat.{u + 1} A) i).singleFunctorCompRightDerivedFunctorIso.hom.app
        (Etale.ordinaryFiniteConstant A X) =
    (Etale.ordinaryFiniteSingleFunctor A Y).map (Etale.supportedConstantUnit A i) := by
  unfold Etale.supportedDerivedUnit
  exact Adjunction.derivedSingleUnit_comp_comparison _ _ _ _

-- The explicit finite base-change isomorphism preserves the supported constant unit.
private theorem supportRestriction_unit
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :
    (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).map
        (Etale.supportedDerivedUnit A (projectiveZero T)) ≫
      (supportRestriction A T).hom =
    (Etale.ordinaryFiniteUnitPullback A (ProjectiveLine.affineChart T)).hom ≫
      Etale.supportedDerivedUnit A (sectionMap T) := by
  let L := Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)
  let S := Etale.ordinaryFiniteSingleFunctor A (AffineSpace PUnit.{u + 1} T)
  have hu := Etale.supportedBaseChangeUnit A (ProjectiveLine.affineChart T)
    (projectiveZero T) (sectionMap T) (𝟙 T) (supportSquare T).toCommSq
  have hu' : (Etale.upperStar (ModuleCat.{u + 1} A) (ProjectiveLine.affineChart T)).map
      (Etale.supportedConstantUnit A (projectiveZero T)) ≫ supportExchange A T =
      (Scheme.upperStarConstantSheafIso (ModuleCat.{u + 1} A)
        (ProjectiveLine.affineChart T)).hom.app (ModuleCat.of A A) ≫
      Etale.supportedConstantUnit A (sectionMap T) := by
    apply (cancel_epi ((Scheme.upperStarConstantSheafIso (ModuleCat.{u + 1} A)
      (ProjectiveLine.affineChart T)).inv.app (ModuleCat.of A A))).1
    simpa only [Category.assoc, Iso.inv_hom_id_app_assoc, supportExchange,
      Iso.app_inv, Iso.app_hom] using hu
  apply (cancel_mono ((Etale.lowerStar (ModuleCat.{u + 1} A) (sectionMap T)
    ).singleFunctorCompRightDerivedFunctorIso.hom.app
      (Etale.ordinaryFiniteConstant A T))).1
  simp only [supportRestriction, Iso.trans_hom, Functor.mapIso_hom,
    Iso.symm_hom, Iso.app_hom, Iso.app_inv, asIso_hom, Category.assoc]
  rw [← L.map_comp_assoc, closed_unit_single]
  have hn := (Etale.ordinaryFiniteSinglePullbackIso A
    (ProjectiveLine.affineChart T)).hom.naturality
      (Etale.supportedConstantUnit A (projectiveZero T))
  simp only [Functor.comp_map] at hn
  erw [reassoc_of% hn]
  dsimp only [Functor.comp_obj, Functor.id_obj]
  simp only [Iso.inv_hom_id_app]
  rw [← S.map_comp_assoc, hu', S.map_comp, closed_unit_single]
  rw [Etale.ordinaryFiniteUnitPullback_eq]
  simp only [Iso.trans_hom, Iso.app_hom, Functor.mapIso_hom, Category.assoc]
  erw [Category.comp_id]

private theorem single_cancel_epi
    {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]
    {X Y Z : C} (f : X ⟶ Y) [Epi f]
    (g h : (DerivedCategory.singleFunctor C 0).obj Y ⟶
      (DerivedCategory.singleFunctor C 0).obj Z)
    (e : (DerivedCategory.singleFunctor C 0).map f ≫ g =
      (DerivedCategory.singleFunctor C 0).map f ≫ h) : g = h := by
  let S := DerivedCategory.singleFunctor C 0
  have hg : S.map (S.preimage g) = g := S.map_preimage g
  have hh : S.map (S.preimage h) = h := S.map_preimage h
  rw [← hg, ← hh]
  congr 1
  apply (cancel_epi f).1
  apply S.map_injective
  simpa only [Functor.map_comp, hg, hh] using e

private def canonicalSupportRestriction
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u}) :=
  (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).map
      ((Etale.rightDerivedLowerStarComp (ModuleCat.{u + 1} A)
        (sectionMap T) (ProjectiveLine.affineChart T)).inv.app
          (Etale.ordinaryFiniteUnit A T)) ≫
    (Etale.ordinaryFiniteAdjunction A (ProjectiveLine.affineChart T)).counit.app
      ((closedImage A T).obj (Etale.ordinaryFiniteUnit A T))

private theorem canonicalSupportRestriction_unit
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u}) :
    (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).map
        (Etale.supportedDerivedUnit A (projectiveZero T)) ≫
      canonicalSupportRestriction A T =
    (Etale.ordinaryFiniteUnitPullback A (ProjectiveLine.affineChart T)).hom ≫
      Etale.supportedDerivedUnit A (sectionMap T) := by
  let L := Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)
  let R := Etale.ordinaryFinitePushforward A (ProjectiveLine.affineChart T)
  let b := Etale.ordinaryFiniteAdjunction A (ProjectiveLine.affineChart T)
  have hc := Etale.supportedDerivedUnit_comp A (sectionMap T) (ProjectiveLine.affineChart T)
  have hc' : Etale.supportedDerivedUnit A (projectiveZero T) ≫
      (Etale.rightDerivedLowerStarComp (ModuleCat.{u + 1} A)
        (sectionMap T) (ProjectiveLine.affineChart T)).inv.app
          (Etale.ordinaryFiniteUnit A T) =
      Etale.supportedDerivedUnit A (ProjectiveLine.affineChart T) ≫
        R.map (Etale.supportedDerivedUnit A (sectionMap T)) := by
    unfold projectiveZero
    rw [← hc]
    simp only [Category.assoc, Iso.hom_inv_id_app, Functor.comp_obj]
    erw [Category.comp_id]
  have hj : L.map (Etale.supportedDerivedUnit A (ProjectiveLine.affineChart T)) ≫
      b.counit.app (Etale.ordinaryFiniteUnit A (AffineSpace PUnit.{u + 1} T)) =
      (Etale.ordinaryFiniteUnitPullback A (ProjectiveLine.affineChart T)).hom := by
    rw [Etale.supportedDerivedUnit_eq]
    simp only [Functor.map_comp, Category.assoc]
    have hn := b.counit.naturality
      (Etale.ordinaryFiniteUnitPullback A (ProjectiveLine.affineChart T)).hom
    simp only [Functor.comp_map, Functor.id_map] at hn
    erw [hn]
    rw [← Category.assoc, b.left_triangle_components
      (Etale.ordinaryFiniteUnit A (ProjectiveLine T)), Category.id_comp]
  unfold canonicalSupportRestriction
  rw [← L.map_comp_assoc, hc', L.map_comp, Category.assoc]
  have hn := b.counit.naturality (Etale.supportedDerivedUnit A (sectionMap T))
  simp only [Functor.comp_map, Functor.id_map] at hn
  erw [hn]
  rw [← Category.assoc, hj]

-- Cancel the underived closed constant unit after the fully faithful degree-zero embedding.
private theorem supportRestriction_eq_canonical
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :
    (supportRestriction A T).hom = canonicalSupportRestriction A T := by
  let S := Etale.ordinaryFiniteSingleFunctor A (AffineSpace PUnit.{u + 1} T)
  let r := (Etale.lowerStar (ModuleCat.{u + 1} A) (sectionMap T)
    ).singleFunctorCompRightDerivedFunctorIso.app (Etale.ordinaryFiniteConstant A T)
  let k := r.inv ≫ (supportRestriction A T).inv ≫ canonicalSupportRestriction A T ≫ r.hom
  have hunit : Etale.supportedDerivedUnit A (sectionMap T) ≫
      (supportRestriction A T).inv ≫ canonicalSupportRestriction A T =
      Etale.supportedDerivedUnit A (sectionMap T) := by
    apply (cancel_epi (Etale.ordinaryFiniteUnitPullback A
      (ProjectiveLine.affineChart T)).hom).1
    rw [← Category.assoc, ← supportRestriction_unit]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    exact (canonicalSupportRestriction_unit A T).trans
      (supportRestriction_unit A T).symm
  have he : S.map (Etale.supportedConstantUnit A (sectionMap T)) ≫ k =
      S.map (Etale.supportedConstantUnit A (sectionMap T)) ≫ 𝟙 _ := by
    rw [← closed_unit_single]
    change (Etale.supportedDerivedUnit A (sectionMap T) ≫ r.hom) ≫ k =
      (Etale.supportedDerivedUnit A (sectionMap T) ≫ r.hom) ≫ 𝟙 _
    simp only [k, Category.assoc, Iso.hom_inv_id_assoc, Category.comp_id]
    rw [reassoc_of% hunit]
  let := Etale.supported_unit_epi A (sectionMap T)
  have hk := single_cancel_epi (Etale.supportedConstantUnit A (sectionMap T)) k (𝟙 _) he
  apply (cancel_epi (supportRestriction A T).inv).1
  apply (cancel_epi r.inv).1
  apply (cancel_mono r.hom).1
  dsimp only [Functor.comp_obj, Functor.id_obj]
  simp only [Category.assoc, Iso.inv_hom_id]
  erw [Category.id_comp, r.inv_hom_id]
  exact hk.symm

end AlgebraicGeometry.ProEtale.CoordinateSectionNormalization

