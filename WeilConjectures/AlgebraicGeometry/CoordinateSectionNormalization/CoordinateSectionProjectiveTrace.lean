open AffineLinePurity

private theorem projectiveZero_over (T : Scheme.{u}) :
    projectiveZero T ≫ (ProjectiveLine T ↘ T) = 𝟙 T := by
  simp only [projectiveZero, Category.assoc, ProjectiveLine.affineChart_over,
    AffineSpace.zeroSection_comp_over]

private theorem projectiveZeroCartier (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :
    (projectiveZero T).ker.IsInvertible := by
  have h : (projectiveZero T).ker.subschemeι ≫ (ProjectiveLine T ↘ T) =
      inv (projectiveZero T).toImage := by
    apply (cancel_epi (projectiveZero T).toImage).mp
    simp [← Category.assoc, Scheme.Hom.image, projectiveZero_over]
  have : IsIso ((projectiveZero T).ker.subschemeι ≫ (ProjectiveLine T ↘ T)) := by
    rw [h]
    infer_instance
  exact Scheme.IdealSheafData.isInvertible_of_isFinite_of_flat
    (ProjectiveLine T ↘ T) inferInstance inferInstance inferInstance

open ProjectiveSpace Scheme.Modules in
private theorem comp_projectiveZero (T X : Scheme.{u}) (g : X ⟶ T) :
    g ≫ projectiveZero T =
      homOfSections g (ProjectiveLine.pairSections 0 1)
        (ProjectiveLine.span_range_pairSections_one 0) := by
  unfold projectiveZero sectionMap AffineSpace.zeroSection
  rw [← Category.assoc, AffineSpace.comp_homOfVector, Category.comp_id]
  convert ProjectiveLine.homOfVector_comp_affineChart g (0 : Γ(X, ⊤)) using 2
  congr 1
  funext i
  exact map_zero g.appTop.hom

open ProjectiveSpace Scheme.Modules in
private theorem projectiveZero_preimage (T : Scheme.{u}) (i : ULift.{u} (Fin 2)) :
    projectiveZero T ⁻¹ᵁ standardOpen (ULift.{u} (Fin 2)) T i =
      T.basicOpen (ProjectiveLine.pairSections (0 : Γ(T, ⊤)) 1 i) := by
  have h := comp_projectiveZero T T (𝟙 T)
  rw [Category.id_comp] at h
  rw [h, homOfSections_preimage_standardOpen]

set_option maxHeartbeats 1000000 in
-- The chart test compares morphisms into the constructed projective scheme.
open ProjectiveSpace Scheme.Modules in
private theorem projectiveZero_ideal_on_chart (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)]
    (i : ULift.{u} (Fin 2)) (U : (ProjectiveLine T).affineOpens)
    (hi : U.1 ≤ standardOpen (ULift.{u} (Fin 2)) T i) :
    (projectiveZero T).ker.ideal U =
      Ideal.span {(ProjectiveLine T).presheaf.map (homOfLE hi).op
        (coordRatio (ULift.{u} (Fin 2)) T i ⟨0⟩)} := by
  apply kernel_ideal_eq_span_of_test
  intro X g hg
  have hgi : ⊤ ≤ g ⁻¹ᵁ standardOpen (ULift.{u} (Fin 2)) T i :=
    hg.trans (g.preimage_mono hi)
  have hmap : g.appLE U.1 ⊤ hg
      ((ProjectiveLine T).presheaf.map (homOfLE hi).op
        (coordRatio (ULift.{u} (Fin 2)) T i ⟨0⟩)) =
      g.appLE _ ⊤ hgi (coordRatio (ULift.{u} (Fin 2)) T i ⟨0⟩) := by
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  rw [hmap]
  rcases i with ⟨i⟩
  fin_cases i
  · change g.appLE (standardOpen (ULift.{u} (Fin 2)) T ⟨0⟩) ⊤ hgi
        (coordRatio (ULift.{u} (Fin 2)) T ⟨0⟩ ⟨0⟩) = 0 ↔ _
    simp only [coordRatio_self, map_one]
    constructor
    · intro h
      have : IsEmpty X := X.isEmpty_of_subsingleton_Γ (subsingleton_of_zero_eq_one h.symm)
      exact ⟨g ≫ (ProjectiveLine T ↘ T), isInitialOfIsEmpty.hom_ext _ _⟩
    · rintro ⟨h, hh⟩
      have hz : g ⁻¹ᵁ standardOpen (ULift.{u} (Fin 2)) T ⟨0⟩ = ⊥ := by
        rw [← hh, Scheme.Hom.comp_preimage, projectiveZero_preimage]
        simp [ProjectiveLine.pairSections]
      have : IsEmpty X := ⟨fun x ↦ by
        have hx := hgi (show x ∈ (⊤ : X.Opens) from trivial)
        change x ∈ g ⁻¹ᵁ standardOpen (ULift.{u} (Fin 2)) T ⟨0⟩ at hx
        rw [hz] at hx
        exact hx⟩
      exact Subsingleton.elim _ _
  · change ⊤ ≤ g ⁻¹ᵁ standardOpen (ULift.{u} (Fin 2)) T ⟨1⟩ at hgi
    constructor
    · intro h
      refine ⟨g ≫ (ProjectiveLine T ↘ T), ?_⟩
      rw [comp_projectiveZero]
      let p := homOfSections (g ≫ (ProjectiveLine T ↘ T))
        (ProjectiveLine.pairSections (0 : Γ(X, ⊤)) 1)
        (ProjectiveLine.span_range_pairSections_one 0)
      have hp : ⊤ ≤ p ⁻¹ᵁ standardOpen (ULift.{u} (Fin 2)) T ⟨1⟩ := by
        simp [p, homOfSections_preimage_standardOpen, ProjectiveLine.pairSections]
      change p = g
      apply chart_hom_ext (n := ULift.{u} (Fin 2)) (S := T) (X := X)
        (f := p) (g := g) ⟨1⟩ hp hgi
      · exact homOfSections_over _ _ _
      · rintro ⟨k⟩
        fin_cases k
        · dsimp only [p]
          rw [homOfSections_appLE_coordRatio _ _ _ (rfl :
            ProjectiveLine.pairSections (0 : Γ(X, ⊤)) 1 ⟨1⟩ = 1)]
          exact h.symm
        · change p.appLE (standardOpen (ULift.{u} (Fin 2)) T ⟨1⟩) ⊤ hp
              (coordRatio (ULift.{u} (Fin 2)) T ⟨1⟩ ⟨1⟩) =
            g.appLE (standardOpen (ULift.{u} (Fin 2)) T ⟨1⟩) ⊤ hgi
              (coordRatio (ULift.{u} (Fin 2)) T ⟨1⟩ ⟨1⟩)
          simp only [coordRatio_self, map_one]
    · rintro ⟨h, hh⟩
      have he : g = homOfSections h (ProjectiveLine.pairSections (0 : Γ(X, ⊤)) 1)
          (ProjectiveLine.span_range_pairSections_one 0) :=
        hh.symm.trans (comp_projectiveZero T X h)
      rw [Scheme.Hom.appLE_congr_hom he _ _ _ (he ▸ hgi)]
      exact homOfSections_appLE_coordRatio _ _ _ (rfl :
        ProjectiveLine.pairSections (0 : Γ(X, ⊤)) 1 ⟨1⟩ = 1) _ _

open ProjectiveSpace Scheme.Modules in
private theorem projectiveZero_dualIdeal (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :
    Nonempty ((projectiveZero T).ker.toModulesᵛ ≅
      twist (ULift.{u} (Fin 2)) T 1) := by
  let φ := coordinateSection (ULift.{u} (Fin 2)) T ⟨0⟩
  have : SheafOfModules.IsInvertible.{u, u, u} (𝟙_ (ProjectiveLine T).Modules) :=
    IsInvertible.sheafOfModules_isInvertible _
  have : SheafOfModules.IsInvertible.{u, u, u} (twist (ULift.{u} (Fin 2)) T 1) :=
    IsInvertible.sheafOfModules_isInvertible _
  have heq : (projectiveZero T).ker = φ.zeroLocus := by
    let C := {U : (ProjectiveLine T).affineOpens //
      ∃ i : ULift.{u} (Fin 2), U.1 ≤ standardOpen (ULift.{u} (Fin 2)) T i}
    have hcov : ⨆ c : C, c.val.1 = ⊤ := by
      apply eq_top_iff.mpr
      intro x _
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp
        ((iSup_standardOpen (ULift.{u} (Fin 2)) T).ge (show x ∈ ⊤ from trivial))
      obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
        (ProjectiveLine T).isBasis_affineOpens.exists_subset_of_mem_open hi
          (standardOpen (ULift.{u} (Fin 2)) T i).2
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨V, hV⟩, i, hVW⟩, hxV⟩
    apply Scheme.IdealSheafData.ext_of_iSup_eq_top (fun c : C ↦ c.val) hcov
    intro c
    obtain ⟨i, hi⟩ := c.property
    rw [projectiveZero_ideal_on_chart T i c.val hi]
    exact (φ.ideal_zeroLocus c.val (isFreeGenerator_one c.val.1)
      ((isFreeGenerator_twistGenerator (ULift.{u} (Fin 2)) T 1 i).map hi)
      (by
        have hs := φ.app_presheaf_map_of_eq (homOfLE hi)
          (coordinateSection_app_standardOpen (ULift.{u} (Fin 2)) T ⟨0⟩ i)
        change φ.app c.val.1
          ((ProjectiveLine T).presheaf.map (homOfLE hi).op (1 : Γ(ProjectiveLine T, _))) = _
          at hs
        simpa only [map_one] using hs)).symm
  have hφ : φ.zeroLocus.IsInvertible := heq ▸ projectiveZeroCartier T
  obtain ⟨e⟩ := φ.nonempty_iso_dual_toModules_tensorObj hφ
  exact ⟨(heq ▸ (e ≪≫ ρ_ _).symm)⟩

private theorem projectiveSupported_chern
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u})
    [IsNoetherian T] [IsClosedImmersion (projectiveZero T)]
    (N : ℕ) (hN : 0 < N) (hA : (N : A) = 0) (hT : IsUnit (N : Γ(T, ⊤)))
    (hI : (projectiveZero T).ker.IsInvertible)
    (e : (projectiveZero T).ker.toModulesᵛ ≅
      ProjectiveSpace.twist (ULift.{u} (Fin 2)) T 1) :
    Etale.supportedDerivedUnit A (projectiveZero T) ≫
      projectiveSupported A T N hN hA
        (Etale.projectiveLineTraceDatum N hN A hA T hT).invertible_on_projectiveLine hI =
      (Etale.projectiveLineTraceDatum N hN A hA T hT).chern := by
  let := hI.isInvertible_dual_toModules
  apply (Etale.ordinaryFiniteClass_bijective_arbitraryBase A (ProjectiveLine T)
    (Scheme.finiteEtaleTateLine (ProjectiveLine T) N A hA) 2).injective
  have hc := Etale.ordinary_supported_kummer_chern (ProjectiveLine T) N hN A hA
    (Etale.projectiveLineTraceDatum N hN A hA T hT).invertible_on_projectiveLine
    (projectiveZero T) hI
    (Etale.ordinary_supported_kummer_uniqueBoundary (ProjectiveLine T) N hN A hA
      (Etale.projectiveLineTraceDatum N hN A hA T hT).invertible_on_projectiveLine
      (projectiveZero T) hI).exists.choose
    (Etale.ordinary_supported_kummer_uniqueBoundary (ProjectiveLine T) N hN A hA
      (Etale.projectiveLineTraceDatum N hN A hA T hT).invertible_on_projectiveLine
      (projectiveZero T) hI).exists.choose_spec
  rw [projectiveSupported]
  rw [hc]
  rw [(Etale.projectiveLineTraceDatum N hN A hA T hT).chern_spec]
  unfold Etale.supportedKummerChern Etale.ordinaryFiniteP1KummerClass
  rw [Scheme.Pic.ofIsInvertible_eq_of_iso e]
  rfl

/-- The projective coordinate divisor has the positive Chern trace normalization.

Source: literature/blueprint/latest/blueprint/sec-smooth-purity/sk-prop-an/
cor-pur-affine-space-zero-section-purity.proof.md, rank-one supported Cartier normalization
and finite etale-origin transport (blueprint: lem-pur-coordinate-section-projective-trace).

Proof: The zero section is a finite flat section of the smooth relative curve P1/T,
so its ideal is invertible. Test the kernel ideal on the two standard charts to identify
it with the zero locus of the actual coordinate section of O(1). The dual zero-locus
formula gives O(1), and supported Kummer forgetting supports gives its positive Chern class.
Finite base change restricts the projective supported sheaf and its normalized Kummer map
to the affine supported sheaf and map. Transpose the inverse restriction through the
actual open adjunction. Its counit naturality is the supported open-counit equation.
The explicit restriction preserves constant units. Comparing it with the canonical
ordinary-adjunction mate of direct-image composition, and cancelling the underived
closed constant unit through the full faithful degree-zero embedding, identifies them.
The compatible-compactification forget-supports calculation, refinement invariance,
and the identity comparison normalize the source of sectionComposition. Ordinary
constant-unit composition then identifies that source with the two successive units.
Push the supported open-counit equation forward and replace forgetting supports by the
positive Chern class: the result is exactly the specified projective Chern adjunct.
The argument applies at each positive annihilating prime-power exponent and does not
assume that the Noetherian base is of finite type over a field.
-/
theorem coordinateSectionProjectiveTrace
    (P : WeilConjectures.PurityFiniteSetting.{u}) (T : Scheme.{u})
    [IsNoetherian T] [IsClosedImmersion (projectiveZero T)] :
    ProjectiveNormalization P T ∧
    ∀ (b : ℕ) (hA : ((P.coefficients.l ^ (b + 1) : ℕ) : Ring P) = 0)
      (hT : IsUnit ((P.coefficients.l ^ (b + 1) : ℕ) : Γ(T, ⊤)))
      (hI : (sectionMap T).ker.IsInvertible),
    ((sectionComposition (Ring P) T).inv.app (Etale.ordinaryFiniteUnit (Ring P) T) ≫
      (compact (Ring P) T).map
        (restrictedSupported (Ring P) T (P.coefficients.l ^ (b + 1))
          (pow_pos (Fact.out : P.coefficients.l.Prime).pos _) hA hT hI) ≫
    (Etale.ordinaryFinitePushforward (Ring P) (ProjectiveLine T ↘ T)).map
      ((Etale.affineTraceOpenAdjunction (Ring P) T).counit.app
        ((Etale.ordinaryFiniteLine (Ring P) (P.coefficients.l ^ (b + 1)) hA
          (ProjectiveLine T))⟦(2 : ℤ)⟧)) =
      Etale.ordinaryFiniteP1ChernPushforward (Ring P) (P.coefficients.l ^ (b + 1)) hA T
        (Etale.projectiveLineTraceDatum (P.coefficients.l ^ (b + 1))
          (pow_pos (Fact.out : P.coefficients.l.Prime).pos _) (Ring P) hA T hT).chern) := by
  constructor
  · obtain ⟨e⟩ := projectiveZero_dualIdeal T
    refine ⟨projectiveZeroCartier T, ⟨e⟩, ?_⟩
    intro N hN hA hT
    exact projectiveSupported_chern P.Coefficient T N hN hA hT
      (projectiveZeroCartier T) e
  · intro b hA hT hI
    obtain ⟨e⟩ := projectiveZero_dualIdeal T
    refine normalized_trace (Ring P) T _ _ hA hT hI (projectiveZeroCartier T) ?_
    exact projectiveSupported_chern (Ring P) T _ _ hA hT (projectiveZeroCartier T) e

end AlgebraicGeometry.ProEtale.CoordinateSectionNormalization
