private theorem projective_zero_over (T : Scheme.{u}) :
    projectiveZero T ≫ (ProjectiveLine T ↘ T) = 𝟙 T := by
  simp only [projectiveZero, Category.assoc, ProjectiveLine.affineChart_over,
    AffineSpace.zeroSection_comp_over]

private theorem supportExtension_eq
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :
    supportExtension A T =
    (Etale.derivedOpenImmersionLowerShriekToLowerStar (ModuleCat.{u + 1} A)
      (ProjectiveLine.affineChart T)).app
        ((closedImage A T).obj (Etale.ordinaryFiniteUnit A T)) ≫
      (Etale.rightDerivedLowerStarComp (ModuleCat.{u + 1} A)
        (sectionMap T) (ProjectiveLine.affineChart T)).hom.app
          (Etale.ordinaryFiniteUnit A T) := by
  let := Etale.affine_open_unit_isIso A T
  rw [Etale.open_inclusion_normalized, Category.assoc]
  exact open_mate_identity (Etale.affineTraceOpenAdjunction A T)
    (Etale.ordinaryFiniteAdjunction A (ProjectiveLine.affineChart T)) _ _
    ((Etale.rightDerivedLowerStarComp (ModuleCat.{u + 1} A)
      (sectionMap T) (ProjectiveLine.affineChart T)).app (Etale.ordinaryFiniteUnit A T))
    (supportRestriction A T) (supportRestriction_eq_canonical A T).symm

-- Normalize the actual compact-support compositor before using the Chern class equation.
private theorem source_normalization
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u}) [IsNoetherian T]
    [IsClosedImmersion (projectiveZero T)] :
    (sectionComposition A T).inv.app (Etale.ordinaryFiniteUnit A T) ≫
      (Etale.ordinaryFinitePushforward A (ProjectiveLine T ↘ T)).map
        (supportExtension A T) ≫
      (Etale.rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
        (projectiveZero T) (ProjectiveLine T ↘ T) (𝟙 T)
        (projective_zero_over T)).hom.app (Etale.ordinaryFiniteUnit A T) =
    (Etale.rightDerivedLowerStarIdIso A T).inv.app (Etale.ordinaryFiniteUnit A T) := by
  rw [supportExtension_eq]
  exact Etale.section_projective_forget A T (projective_zero_over T)
    (Etale.ordinaryFiniteUnit A T)

private theorem native_right_single_identity
    {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]
    [HasKInjectiveResolutions C]
    (F : C ⥤ C) [F.Additive] [PreservesFiniteLimits F] [PreservesFiniteColimits F]
    (e : F ≅ 𝟭 C) (M : C) :
    (F.rightDerivedFunctorIsoMapDerivedCategory ≪≫
      Functor.mapDerivedCategoryNatIso e ≪≫ Functor.mapDerivedCategoryIdIso C).hom.app
        ((DerivedCategory.singleFunctor C 0).obj M) =
    F.singleFunctorCompRightDerivedFunctorIso.hom.app M ≫
      (DerivedCategory.singleFunctor C 0).map (e.hom.app M) := by
  have h := Etale.SfP1Transport.exact_single_identity F e M
  simp only [Iso.trans_hom, NatTrans.comp_app] at h ⊢
  rw [h]
  simp only [Functor.singleFunctorCompRightDerivedFunctorIso, Iso.trans_hom,
    Functor.isoWhiskerLeft_hom, NatTrans.comp_app, Functor.whiskerLeft_app,
    Functor.comp_obj, Category.assoc]

private theorem supported_identity_native
    (A : Type (u + 1)) [CommRing A] (X : Scheme.{u}) :
    Etale.supportedDerivedUnit A (𝟙 X) ≫
      (Etale.rightDerivedLowerStarIdIso A X).hom.app (Etale.ordinaryFiniteUnit A X) =
    𝟙 _ := by
  let B := ModuleCat.{u + 1} A
  let F := Etale.lowerStar B (𝟙 X)
  let S := DerivedCategory.singleFunctor (Sheaf X.smallEtaleTopology B) 0
  have hr : (Etale.rightDerivedLowerStarIdIso A X).hom.app
      (Etale.ordinaryFiniteUnit A X) =
      F.singleFunctorCompRightDerivedFunctorIso.hom.app
        (Etale.ordinaryFiniteConstant A X) ≫
      S.map ((Etale.lowerStarId B X).hom.app (Etale.ordinaryFiniteConstant A X)) := by
    simpa only [Etale.rightDerivedLowerStarIdIso, Etale.ordinaryFiniteUnit,
      Etale.ordinaryFiniteDegreeZero] using
      native_right_single_identity F (Etale.lowerStarId B X)
        (Etale.ordinaryFiniteConstant A X)
  rw [hr, ← Category.assoc, closed_unit_single]
  change S.map (Etale.supportedConstantUnit A (𝟙 X)) ≫ S.map _ = _
  rw [← S.map_comp]
  have he : Etale.supportedConstantUnit A (𝟙 X) =
      (Etale.lowerStarId B X).inv.app (Etale.ordinaryFiniteConstant A X) := by
    unfold Etale.supportedConstantUnit
    simp only [Iso.app_hom]
    rw [Etale.SfP1Transport.constant_id, Adjunction.homEquiv_unit,
      Etale.upperStarId_hom_app_unit_app]
  rw [he, Iso.inv_hom_id_app]
  simp only [Functor.id_obj, Etale.ordinaryFiniteUnit, Etale.ordinaryFiniteDegreeZero]
  erw [S.map_id]

private theorem source_unit
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u}) [IsNoetherian T]
    [IsClosedImmersion (projectiveZero T)] :
    (sectionComposition A T).inv.app (Etale.ordinaryFiniteUnit A T) ≫
      (Etale.ordinaryFinitePushforward A (ProjectiveLine T ↘ T)).map
        (supportExtension A T) =
    Etale.supportedDerivedUnit A (ProjectiveLine T ↘ T) ≫
      (Etale.ordinaryFinitePushforward A (ProjectiveLine T ↘ T)).map
        (Etale.supportedDerivedUnit A (projectiveZero T)) := by
  apply (cancel_mono ((Etale.rightDerivedLowerStarCompIsoOfComp
    (ModuleCat.{u + 1} A) (projectiveZero T) (ProjectiveLine T ↘ T) (𝟙 T)
    (projective_zero_over T)).hom.app (Etale.ordinaryFiniteUnit A T))).1
  simp only [Category.assoc]
  rw [source_normalization]
  rw [Etale.SfP1Transport.supported_comp_eq A (projectiveZero T) (ProjectiveLine T ↘ T)
    (𝟙 T) (projective_zero_over T)]
  apply (cancel_mono ((Etale.rightDerivedLowerStarIdIso A T).hom.app
    (Etale.ordinaryFiniteUnit A T))).1
  rw [Iso.inv_hom_id_app, supported_identity_native]
  simp only [Functor.id_obj]

-- Combine the open counit equation, the normalized source, and projective Kummer forgetting.
private theorem normalized_trace
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u}) [IsNoetherian T]
    [IsClosedImmersion (projectiveZero T)]
    (N : ℕ) (hN : 0 < N) (hA : (N : A) = 0) (hT : IsUnit (N : Γ(T, ⊤)))
    (hI : (sectionMap T).ker.IsInvertible)
    (hJ : (projectiveZero T).ker.IsInvertible)
    (H : Etale.supportedDerivedUnit A (projectiveZero T) ≫
      projectiveSupported A T N hN hA (affineTraceProjectiveInvertible N T hT) hJ =
      (Etale.projectiveLineTraceDatum N hN A hA T hT).chern) :
    (sectionComposition A T).inv.app (Etale.ordinaryFiniteUnit A T) ≫
      (compact A T).map (restrictedSupported A T N hN hA hT hI) ≫
      (Etale.ordinaryFinitePushforward A (ProjectiveLine T ↘ T)).map
        ((Etale.affineTraceOpenAdjunction A T).counit.app
          ((Etale.ordinaryFiniteLine A N hA (ProjectiveLine T))⟦(2 : ℤ)⟧)) =
      Etale.ordinaryFiniteP1ChernPushforward A N hA T
        (Etale.projectiveLineTraceDatum N hN A hA T hT).chern := by
  let R := Etale.ordinaryFinitePushforward A (ProjectiveLine T ↘ T)
  change (sectionComposition A T).inv.app (Etale.ordinaryFiniteUnit A T) ≫
    R.map ((Etale.affineTraceOpenLeft A T).map
      (restrictedSupported A T N hN hA hT hI)) ≫ R.map _ = _
  rw [← R.map_comp, supported_open_counit A T N hN hA hT hI hJ,
    R.map_comp, ← Category.assoc, source_unit, Category.assoc, ← R.map_comp, H]
  unfold Etale.ordinaryFiniteP1ChernPushforward
  rw [Adjunction.homEquiv_unit, Etale.supportedDerivedUnit_eq]
  simp only [Functor.map_comp, Category.assoc]
  unfold Etale.ordinaryFiniteAdjunction
  rfl

end AlgebraicGeometry.ProEtale.CoordinateSectionNormalization

