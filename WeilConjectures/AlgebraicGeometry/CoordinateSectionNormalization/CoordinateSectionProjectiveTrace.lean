/-! # Projective coordinate section trace

Source: literature/blueprint/latest/blueprint/sec-smooth-purity/sk-prop-an/
cor-pur-affine-space-zero-section-purity.proof.md, rank-one supported Cartier normalization
(blueprint: lem-pur-coordinate-section-projective-trace).

The theorem records the projective Cartier normalization and its equality with the
ordinary projective Chern adjunct, retaining the actual open counit and compact-support
composition from the coordinate-section construction.
-/

@[expose] public noncomputable section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian AlgebraicGeometry
open CategoryTheory.MonoidalCategory AlgebraicGeometry.ProjectiveSpace
open scoped AlgebraicGeometry.Scheme.Modules

open scoped CategoryTheory.Functor

-- Adjacent adjunctions turn the inverse restriction isomorphism into the open inclusion.
private lemma open_mate_identity
    {C D : Type*} [Category C] [Category D]
    {O : C ⥤ D} {L : D ⥤ C} {R : C ⥤ D}
    (a : O ⊣ L) (b : L ⊣ R) [IsIso a.unit]
    (M : C) (N : D) (c : R.obj M ≅ N) (g : L.obj N ≅ M)
    (hg : L.map c.inv ≫ b.counit.app M = g.hom) :
    (a.homEquiv M N).symm g.inv =
      b.unit.app (O.obj M) ≫ R.map (inv (a.unit.app M)) ≫ c.hom := by
  apply (a.homEquiv M N).injective
  simp only [Equiv.apply_symm_apply]
  apply (cancel_mono g.hom).1
  rw [Iso.inv_hom_id, ← hg]
  simp only [Adjunction.homEquiv_unit, Functor.map_comp, Category.assoc]
  have hc : L.map c.hom ≫ L.map c.inv = 𝟙 _ := by
    rw [← L.map_comp, c.hom_inv_id, L.map_id]
  rw [reassoc_of% hc]
  rw [b.counit_naturality]
  rw [← Category.assoc (L.map (b.unit.app _)), b.left_triangle_components (O.obj M)]
  dsimp only [Functor.id_obj, Functor.comp_obj]
  rw [Category.id_comp]
  exact (IsIso.hom_inv_id (a.unit.app M)).symm

