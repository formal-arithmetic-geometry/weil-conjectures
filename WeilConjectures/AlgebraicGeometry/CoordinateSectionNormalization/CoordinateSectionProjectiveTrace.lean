-- The identity comparison is fixed by the two conjugate adjunction comparisons.
attribute [local implicit_reducible] rightDerivedLowerShriek rightDerivedLowerShriekIso
  unboundedFormalism

private lemma identity_inclusion
    {C : Type*} [Category C] {O U R : C ⥤ C}
    (a : O ⊣ U) (b : U ⊣ R) [IsIso a.unit]
    (e : U ≅ 𝟭 C) (o : O ≅ 𝟭 C) (r : R ≅ 𝟭 C)
    (ho : conjugateEquiv Adjunction.id a o.hom = e.inv)
    (hr : conjugateEquiv b Adjunction.id e.inv = r.hom) (M : C) :
    b.unit.app (O.obj M) ≫ R.map (inv (a.unit.app M)) ≫ r.hom.app M =
      o.hom.app M := by
  have ha := unit_conjugateEquiv Adjunction.id a o.hom M
  rw [ho] at ha
  simp only [Adjunction.id_unit, NatTrans.id_app, Functor.id_obj,
    Category.id_comp] at ha
  have hb := unit_conjugateEquiv b Adjunction.id e.inv (O.obj M)
  rw [hr] at hb
  simp only [Adjunction.id_unit, NatTrans.id_app, Functor.id_obj,
    Functor.id_map, Category.id_comp] at hb
  try dsimp only [Functor.id_obj, Functor.comp_obj] at hb ⊢
  erw [r.hom.naturality (inv (a.unit.app M))]
  try dsimp only [Functor.id_obj, Functor.comp_obj]
  rw [← Category.assoc, hb]
  simp only [Functor.id_map]
  have h := congrArg (fun z ↦ inv (a.unit.app M) ≫ z ≫ e.hom.app M) ha
  simp only [Category.assoc, IsIso.inv_hom_id_assoc, Iso.inv_hom_id_app,
    Category.comp_id] at h
  rw [e.hom.naturality] at h
  have h' := congrArg (fun z ↦ e.inv.app (O.obj M) ≫ z) h
  try dsimp only [Functor.id_obj, Functor.comp_obj] at h' ⊢
  simpa only [Category.assoc, Iso.inv_hom_id_app_assoc, Functor.id_map] using h'

private theorem identity_derived_open_inclusion
    (A : Type (u + 1)) [CommRing A] [Finite A] (X : Scheme.{u})
    (M : DerivedCategoryModule A X) :
    (derivedOpenImmersionLowerShriekToLowerStar (ModuleCat.{u + 1} A) (𝟙 X)).app M ≫
      (rightDerivedLowerStarIdIso A X).hom.app M =
    (Functor.mapDerivedCategoryNatIso
      (Adjunction.leftAdjointIdIso
        (openImmersionLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} A) (𝟙 X))
        (upperStarId (ModuleCat.{u + 1} A) X)) ≪≫
      Functor.mapDerivedCategoryIdIso _).hom.app M := by
  let e := Functor.mapDerivedCategoryNatIso (upperStarId (ModuleCat.{u + 1} A) X) ≪≫
    Functor.mapDerivedCategoryIdIso _
  let o := Functor.mapDerivedCategoryNatIso
    (Adjunction.leftAdjointIdIso
      (openImmersionLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} A) (𝟙 X))
      (upperStarId (ModuleCat.{u + 1} A) X)) ≪≫ Functor.mapDerivedCategoryIdIso _
  have hr := congrArg Iso.hom (derived_star_id_conjugate A X)
  have h := identity_inclusion
    (derivedOpenImmersionLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} A) (𝟙 X))
    (mapDerivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} A) (𝟙 X))
    e o (rightDerivedLowerStarIdIso A X) (derived_open_id_conjugate A X) hr M
  simpa only [derivedOpenImmersionLowerShriekToLowerStar, NatTrans.comp_app,
    Functor.whiskerLeft_app, Functor.whiskerRight_app, Functor.associator_inv_app,
    Functor.comp_obj, Functor.id_obj, Category.id_comp, Category.assoc,
    NatIso.isIso_inv_app] using h

private theorem star_identity_comp
    (A : Type (u + 1)) [CommRing A] [Finite A] (X : Scheme.{u})
    (M : DerivedCategoryModule A X) :
    (rightDerivedLowerStarCompHom (ModuleCat.{u + 1} A) (𝟙 X) (𝟙 X) (𝟙 X)
      (Category.id_comp (𝟙 X)).symm).app M =
    (ordinaryFinitePushforward A (𝟙 X)).map ((rightDerivedLowerStarIdIso A X).hom.app M) := by
  have h := (unboundedFormalism A).pfComp'_id_left_inv_app (𝟙 X) M
  rw [unbounded_pf_id] at h
  have hc : ((unboundedFormalism A).pfComp' (𝟙 X) (𝟙 X) (𝟙 X)
      (Category.id_comp (𝟙 X))).inv =
      rightDerivedLowerStarCompHom (ModuleCat.{u + 1} A) (𝟙 X) (𝟙 X) (𝟙 X)
        (Category.id_comp (𝟙 X)).symm := by
    rw [ExchangeFormalism.pfComp', conjugateIsoEquiv_apply_inv, Iso.symm_inv,
      unbounded_pb_comp']
    simpa only [rightDerivedLowerStarCompHom, exact_pb_comp,
      Functor.mapDerivedCategoryTriangleIso, unboundedFormalism] using
      (conjugateEquiv_leftDerivedUpperStarComp_hom (ModuleCat.{u + 1} A)
        (𝟙 X) (𝟙 X) (𝟙 X) (Category.id_comp (𝟙 X)).symm).symm
  rw [hc] at h
  exact h

private theorem model_forget_chosen
    (A : Type (u + 1)) [CommRing A] [Finite A]
    {X Y : Scheme.{u}} {f : X ⟶ Y} [HasCompactification f] [QuasiCompact f]
    (c : Compactification f) (M : DerivedCategoryModule A X) :
    (rightDerivedLowerShriekIso A c).hom.app M ≫
      (compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification f)).app M =
    (compactificationForgetSupports (ModuleCat.{u + 1} A) c).app M := by
  simpa only [rightDerivedLowerShriekIso, compactificationForgetSupports,
    NatTrans.comp_app, Functor.whiskerRight_app, Category.assoc] using
    rightDerivedLowerShriekOfCompactificationIso_hom_app_comp_toLowerStar A
      c (HasCompactification.compactification f) M

private theorem identity_naturality_unitor
    {C : Type*} [Category C] {O R : C ⥤ C}
    (r : R ≅ 𝟭 C) (o : O ≅ 𝟭 C) (M : C) :
    R.map (o.hom.app M) ≫ r.hom.app M =
      (Functor.isoWhiskerLeft O r ≪≫ Functor.rightUnitor O ≪≫ o).hom.app M := by
  simp only [Iso.trans_hom, NatTrans.comp_app, Functor.isoWhiskerLeft_hom,
    Functor.whiskerLeft_app, Functor.rightUnitor_hom_app, Functor.comp_obj,
    Functor.id_obj, Category.id_comp]
  simpa only [Functor.id_map, Functor.id_obj] using r.hom.naturality (o.hom.app M)

private theorem identity_forget_normalization
    (A : Type (u + 1)) [CommRing A] [Finite A] (X : Scheme.{u}) :
    (rightDerivedLowerShriekIsoRightDerivedLowerStar (ModuleCat.{u + 1} A) (𝟙 X)) ≪≫
      rightDerivedLowerStarIdIso A X = unboundedEtaleLowerShriekId A X := by
  apply Iso.ext
  apply NatTrans.ext
  funext M
  let c := Compactification.ofIsProper (𝟙 X)
  have hc := model_forget_chosen A c M
  have hf : (rightDerivedLowerShriekIsoRightDerivedLowerStar
      (ModuleCat.{u + 1} A) (𝟙 X)).hom =
      compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification (𝟙 X)) := by
    rw [rightDerivedLowerShriekIsoRightDerivedLowerStar_hom,
      rightDerivedLowerShriekToLowerStarComp_comp_eq]
    rfl
  simp only [Iso.trans_hom, NatTrans.comp_app]
  rw [hf]
  apply (cancel_epi ((rightDerivedLowerShriekIso A c).hom.app M)).1
  rw [← Category.assoc, hc]
  simp only [unboundedEtaleLowerShriekId, Iso.trans_hom, Iso.symm_hom,
    NatTrans.comp_app]
  rw [Iso.hom_inv_id_app_assoc]
  simp only [compactificationForgetSupports, NatTrans.comp_app,
    Functor.whiskerRight_app]
  dsimp only [c, Compactification.ofIsProper]
  rw [Category.assoc]
  change (ordinaryFinitePushforward A (𝟙 X)).map
      ((derivedOpenImmersionLowerShriekToLowerStar (ModuleCat.{u + 1} A) (𝟙 X)).app M) ≫
      (rightDerivedLowerStarCompHom (ModuleCat.{u + 1} A) (𝟙 X) (𝟙 X) (𝟙 X)
        (Category.id_comp (𝟙 X)).symm).app M ≫
      (rightDerivedLowerStarIdIso A X).hom.app M = _
  rw [star_identity_comp, ← Functor.map_comp_assoc, identity_derived_open_inclusion]
  let O := (openImmersionLowerShriek (ModuleCat.{u + 1} A) (𝟙 X)).mapDerivedCategory
  let o : O ≅ 𝟭 (DerivedCategoryModule A X) := Functor.mapDerivedCategoryNatIso
    (Adjunction.leftAdjointIdIso
      (openImmersionLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} A) (𝟙 X))
      (upperStarId (ModuleCat.{u + 1} A) X)) ≪≫ Functor.mapDerivedCategoryIdIso _
  have ht :
      (Functor.isoWhiskerLeft O (rightDerivedLowerStarIdIso A X) ≪≫
        Functor.rightUnitor O ≪≫ o).hom.app M =
      (identityEtaleCompactSupportComparison A X ≪≫
        Functor.mapDerivedCategoryNatIso
          (Adjunction.leftAdjointIdIso
            (etaleLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} A) (𝟙 X)
              inferInstance) (upperStarId (ModuleCat.{u + 1} A) X)) ≪≫
        Functor.mapDerivedCategoryIdIso _).hom.app M := by
    exact NatTrans.congr_app (congrArg Iso.hom (identity_tail_eq A X)) M
  have hn := identity_naturality_unitor (rightDerivedLowerStarIdIso A X) o M
  simpa only [o, O, ordinaryFinitePushforward, Iso.trans_hom, NatTrans.comp_app] using
    hn.trans ht

-- Pass from compatible compactifications to the chosen ones by refinement compatibility.
private theorem chosen_forget_comp
    (A : Type (u + 1)) [CommRing A] [Finite A]
    {W X S : Scheme.{u}} (p : W ⟶ X) (f : X ⟶ S)
    [HasCompactification p] [HasCompactification f] [HasCompactification (p ≫ f)]
    [QuasiCompact p] [QuasiCompact f] [QuasiCompact (p ≫ f)]
    (E : DerivedCategoryModule A W) :
    (unboundedEtaleLowerShriekCompIso A p f).hom.app E ≫
      (compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification (p ≫ f))).app E =
    (rightDerivedLowerShriek (ModuleCat.{u + 1} A) f).map
      ((compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification p)).app E) ≫
    (compactificationForgetSupports (ModuleCat.{u + 1} A)
      (HasCompactification.compactification f)).app
        ((ordinaryFinitePushforward A p).obj E) ≫
    (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A) p f (p ≫ f) rfl).hom.app E := by
  let d := HasCompactification.compactification f
  let e := (HasCompactification.compactification (p ≫ f)).ofComp d
  have hcomp := coordinateSection_compactificationForgetSupports A p f d e E
  have hα := model_forget_chosen A (d.comp e) E
  have hβ := model_forget_chosen A e.restrict E
  have hβ' : (rightDerivedLowerShriekIso A e.restrict).inv.app E ≫
      (compactificationForgetSupports (ModuleCat.{u + 1} A) e.restrict).app E =
    (compactificationForgetSupports (ModuleCat.{u + 1} A)
      (HasCompactification.compactification p)).app E := by
    rw [← hβ, Iso.inv_hom_id_app_assoc]
  simp only [unboundedEtaleLowerShriekCompIso, Iso.trans_hom, Iso.symm_hom,
    Functor.isoWhiskerRight_hom, NatTrans.comp_app, Functor.whiskerRight_app,
    Category.assoc]
  rw [hα, hcomp]
  erw [← Functor.map_comp_assoc, hβ']
  rfl

private theorem proper_forget_eq
    (A : Type (u + 1)) [CommRing A]
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] :
    (rightDerivedLowerShriekIsoRightDerivedLowerStar (ModuleCat.{u + 1} A) f).hom =
      compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification f) := by
  rw [rightDerivedLowerShriekIsoRightDerivedLowerStar_hom,
    rightDerivedLowerShriekToLowerStarComp_comp_eq]
  rfl

private theorem forget_congr
    (A : Type (u + 1)) [CommRing A] [Finite A]
    {X Y : Scheme.{u}} {f f' : X ⟶ Y}
    [HasCompactification f] [HasCompactification f'] (h : f = f')
    (M : DerivedCategoryModule A X) :
    (unboundedEtaleLowerShriekCongr A h).hom.app M ≫
      (compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification f')).app M =
    (compactificationForgetSupports (ModuleCat.{u + 1} A)
      (HasCompactification.compactification f)).app M ≫
      (rightDerivedLowerStarCongr (ModuleCat.{u + 1} A) h).hom.app M := by
  subst f'
  simp only [unboundedEtaleLowerShriekCongr, rightDerivedLowerStarCongr_refl,
    Iso.refl_hom, NatTrans.id_app, Category.id_comp, Category.comp_id]

-- Transport the same compositor along an equality, without expanding either adjunction.
private theorem star_composition_transport
    (A : Type (u + 1)) [CommRing A]
    {W X S : Scheme.{u}} (p : W ⟶ X) (f : X ⟶ S) (c : W ⟶ S)
    (h : p ≫ f = c) :
    (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
      p f (p ≫ f) rfl).hom ≫
      (rightDerivedLowerStarCongr (ModuleCat.{u + 1} A) h).hom =
    (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A) p f c h).hom := by
  subst c
  simp only [rightDerivedLowerStarCongr_refl, Iso.refl_hom, Category.comp_id]

private theorem chosen_forget_comp_identity
    (A : Type (u + 1)) [CommRing A] [Finite A]
    {W X : Scheme.{u}} (p : W ⟶ X) (f : X ⟶ W)
    [IsProper p] [HasCompactification f] [HasCompactification (p ≫ f)]
    [QuasiCompact f] [QuasiCompact (p ≫ f)] (h : p ≫ f = 𝟙 W)
    (E : DerivedCategoryModule A W) :
    (unboundedEtaleLowerShriekCompIso A p f ≪≫
      unboundedEtaleLowerShriekCongr A h).hom.app E ≫
      (rightDerivedLowerShriekIsoRightDerivedLowerStar
        (ModuleCat.{u + 1} A) (𝟙 W)).hom.app E =
    (rightDerivedLowerShriek (ModuleCat.{u + 1} A) f).map
      ((rightDerivedLowerShriekIsoRightDerivedLowerStar
        (ModuleCat.{u + 1} A) p).hom.app E) ≫
      (compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification f)).app
          ((ordinaryFinitePushforward A p).obj E) ≫
      (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
        p f (𝟙 W) h).hom.app E := by
  have hc := chosen_forget_comp A p f E
  have heq : (unboundedEtaleLowerShriekCongr A h).hom.app E ≫
      (rightDerivedLowerShriekIsoRightDerivedLowerStar
        (ModuleCat.{u + 1} A) (𝟙 W)).hom.app E =
      (compactificationForgetSupports (ModuleCat.{u + 1} A)
        (HasCompactification.compactification (p ≫ f))).app E ≫
      (rightDerivedLowerStarCongr (ModuleCat.{u + 1} A) h).hom.app E := by
    rw [proper_forget_eq]
    exact forget_congr A h E
  simp only [Iso.trans_hom, NatTrans.comp_app, Category.assoc]
  rw [heq, reassoc_of% hc, ← proper_forget_eq]
  have hs := NatTrans.congr_app (star_composition_transport A p f (𝟙 W) h) E
  simp only [NatTrans.comp_app] at hs
  rw [hs]

private theorem compact_source_cancel
    {C D : Type*} [Category C] [Category D]
    {F F' : C ⥤ D} {P P' Q : D ⥤ C} {U₀ U V : C ⥤ C}
    (e : F ≅ F') (b : P' ≅ P) (a : F ⋙ P ≅ U₀) (c : U₀ ≅ U)
    (i : U ≅ 𝟭 C) (u : U ≅ V) (r : V ≅ 𝟭 C) (t : F' ⋙ Q ≅ V)
    (v : P ⟶ Q) (v' : P' ⟶ Q) (M : C)
    (hi : i = u ≪≫ r)
    (ha : (a ≪≫ c).hom.app M ≫ u.hom.app M =
      P.map (e.hom.app M) ≫ v.app (F'.obj M) ≫ t.hom.app M)
    (hb : b.hom.app (F'.obj M) ≫ v.app (F'.obj M) = v'.app (F'.obj M)) :
    (Functor.isoWhiskerRight e.symm P' ≪≫
      Functor.isoWhiskerLeft F b ≪≫ a ≪≫ c ≪≫ i).inv.app M ≫
      v'.app (F'.obj M) ≫ t.hom.app M = r.inv.app M := by
  apply (cancel_epi ((Functor.isoWhiskerRight e.symm P' ≪≫
    Functor.isoWhiskerLeft F b ≪≫ a ≪≫ c ≪≫ i).hom.app M)).1
  simp only [Iso.hom_inv_id_app_assoc]
  rw [hi]
  simp only [Iso.trans_hom, Iso.symm_hom, NatTrans.comp_app,
    Functor.isoWhiskerRight_hom, Functor.isoWhiskerLeft_hom,
    Functor.whiskerRight_app, Functor.whiskerLeft_app, Category.assoc,
    Iso.hom_inv_id_app, Category.comp_id]
  simp only [Iso.trans_hom, NatTrans.comp_app, Category.assoc] at ha
  rw [ha]
  rw [← b.hom.naturality_assoc]
  rw [← Functor.map_comp_assoc, Iso.inv_hom_id_app,
    CategoryTheory.Functor.map_id, Category.id_comp, ← Category.assoc, hb]

attribute [local irreducible] rightDerivedLowerShriekIso unboundedFormalism
  rightDerivedLowerShriekIsoRightDerivedLowerStar
attribute [local implicit_reducible]
  ProEtale.CoordinateSectionNormalization.sectionComposition

private theorem compactification_section_forget
    (A : Type (u + 1)) [CommRing A] [Finite A]
    {W X : Scheme.{u}} (p : W ⟶ X) (f : X ⟶ W)
    [IsProper p] [HasCompactification f] [HasCompactification (p ≫ f)]
    [QuasiCompact f] [QuasiCompact (p ≫ f)]
    (d : Compactification f) (hp : p ≫ f = 𝟙 W)
    (M : DerivedCategoryModule A W) :
    (Functor.isoWhiskerRight
        (rightDerivedLowerShriekIsoRightDerivedLowerStar
          (ModuleCat.{u + 1} A) p).symm
        (rightDerivedLowerShriekOfCompactification (ModuleCat.{u + 1} A) d) ≪≫
      Functor.isoWhiskerLeft (rightDerivedLowerShriek (ModuleCat.{u + 1} A) p)
        (rightDerivedLowerShriekIso A d) ≪≫
      unboundedEtaleLowerShriekCompIso A p f ≪≫
      unboundedEtaleLowerShriekCongr A hp ≪≫
      unboundedEtaleLowerShriekId A W).inv.app M ≫
      (compactificationForgetSupports (ModuleCat.{u + 1} A) d).app
        ((ordinaryFinitePushforward A p).obj M) ≫
      (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
        p f (𝟙 W) hp).hom.app M =
    (rightDerivedLowerStarIdIso A W).inv.app M := by
  have hi := identity_forget_normalization A W
  have ht := model_forget_chosen A d ((ordinaryFinitePushforward A p).obj M)
  have hq := chosen_forget_comp_identity A p f hp M
  exact compact_source_cancel
    (C := DerivedCategoryModule A W) (D := DerivedCategoryModule A X)
    (rightDerivedLowerShriekIsoRightDerivedLowerStar (ModuleCat.{u + 1} A) p)
    (rightDerivedLowerShriekIso A d)
    (unboundedEtaleLowerShriekCompIso A p f)
    (unboundedEtaleLowerShriekCongr A hp)
    (unboundedEtaleLowerShriekId A W)
    (rightDerivedLowerShriekIsoRightDerivedLowerStar (ModuleCat.{u + 1} A) (𝟙 W))
    (rightDerivedLowerStarIdIso A W)
    (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A) p f (𝟙 W) hp)
    (compactificationForgetSupports (ModuleCat.{u + 1} A)
      (HasCompactification.compactification f))
    (compactificationForgetSupports (ModuleCat.{u + 1} A) d) M hi.symm hq ht

private theorem star_comp_association
    (A : Type (u + 1)) [CommRing A]
    {W X Y Z : Scheme.{u}} (p : W ⟶ X) (j : X ⟶ Y) (q : Y ⟶ Z)
    (f : X ⟶ Z) (c : W ⟶ Z) (hf : j ≫ q = f) (hc : (p ≫ j) ≫ q = c)
    (M : DerivedCategoryModule A W) :
    (ordinaryFinitePushforward A q).map
        ((rightDerivedLowerStarComp (ModuleCat.{u + 1} A) p j).hom.app M) ≫
      (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
        (p ≫ j) q c hc).hom.app M =
    (rightDerivedLowerStarCompHom (ModuleCat.{u + 1} A) j q f hf.symm).app
        ((ordinaryFinitePushforward A p).obj M) ≫
      (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A) p f c
        (by rw [← hf, ← Category.assoc]; exact hc)).hom.app M := by
  have ha := rightDerivedLowerStarCompHom_assoc_app (ModuleCat.{u + 1} A)
    p j q (p ≫ j) f c rfl hf.symm hc.symm M
  have hs : (rightDerivedLowerStarComp (ModuleCat.{u + 1} A) p j).hom =
      rightDerivedLowerStarCompHom (ModuleCat.{u + 1} A) p j (p ≫ j) rfl := by
    simpa only [rightDerivedLowerStarCongr_refl, Iso.refl_hom, Category.comp_id] using
      rightDerivedLowerStarComp_hom_comp_congr_hom (ModuleCat.{u + 1} A)
        p j (p ≫ j) rfl
  simp only [rightDerivedLowerStarCompIsoOfComp, conjugateIsoEquiv_apply_hom]
  rw [hs]
  exact ha.symm

private theorem compactification_projective_source_forget
    (A : Type (u + 1)) [CommRing A] [Finite A]
    {W X : Scheme.{u}} (p : W ⟶ X) (f : X ⟶ W)
    [IsProper p] [HasCompactification f] [HasCompactification (p ≫ f)]
    [QuasiCompact f] [QuasiCompact (p ≫ f)]
    (d : Compactification f) (hp : p ≫ f = 𝟙 W)
    (hz : (p ≫ d.i) ≫ d.g = 𝟙 W) (M : DerivedCategoryModule A W) :
    (Functor.isoWhiskerRight
        (rightDerivedLowerShriekIsoRightDerivedLowerStar
          (ModuleCat.{u + 1} A) p).symm
        (rightDerivedLowerShriekOfCompactification (ModuleCat.{u + 1} A) d) ≪≫
      Functor.isoWhiskerLeft (rightDerivedLowerShriek (ModuleCat.{u + 1} A) p)
        (rightDerivedLowerShriekIso A d) ≪≫
      unboundedEtaleLowerShriekCompIso A p f ≪≫
      unboundedEtaleLowerShriekCongr A hp ≪≫
      unboundedEtaleLowerShriekId A W).inv.app M ≫
      (ordinaryFinitePushforward A d.g).map
        ((derivedOpenImmersionLowerShriekToLowerStar (ModuleCat.{u + 1} A) d.i).app
            ((ordinaryFinitePushforward A p).obj M) ≫
          (rightDerivedLowerStarComp (ModuleCat.{u + 1} A) p d.i).hom.app M) ≫
      (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
        (p ≫ d.i) d.g (𝟙 W) hz).hom.app M =
    (rightDerivedLowerStarIdIso A W).inv.app M := by
  have ha := star_comp_association A p d.i d.g f (𝟙 W) d.comm.symm hz M
  simp only [Functor.map_comp, Category.assoc]
  rw [ha]
  simpa only [compactificationForgetSupports, NatTrans.comp_app,
    Functor.whiskerRight_app, ordinaryFinitePushforward, Category.assoc] using
      compactification_section_forget A p f d hp M

set_option maxRecDepth 2048 in
open ProEtale.CoordinateSectionNormalization in
private theorem section_projective_forget
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u}) [IsNoetherian T]
    (hz : projectiveZero T ≫ (ProjectiveLine T ↘ T) = 𝟙 T)
    (M : DerivedCategoryModule A T) :
    (sectionComposition A T).inv.app M ≫
      (ordinaryFinitePushforward A (ProjectiveLine T ↘ T)).map
        ((derivedOpenImmersionLowerShriekToLowerStar (ModuleCat.{u + 1} A)
          (ProjectiveLine.affineChart T)).app ((closedImage A T).obj M) ≫
        (rightDerivedLowerStarComp (ModuleCat.{u + 1} A)
          (sectionMap T) (ProjectiveLine.affineChart T)).hom.app M) ≫
      (rightDerivedLowerStarCompIsoOfComp (ModuleCat.{u + 1} A)
        (projectiveZero T) (ProjectiveLine T ↘ T) (𝟙 T) hz).hom.app M =
    (rightDerivedLowerStarIdIso A T).inv.app M := by
  let : HasCompactification (AffineSpace PUnit.{u + 1} T ↘ T) :=
    (affineTraceLineCompactification T).hasCompactification
  let : HasCompactification (sectionMap T ≫ (AffineSpace PUnit.{u + 1} T ↘ T)) :=
    HasCompactification.of_eq (AffineSpace.zeroSection_comp_over PUnit.{u + 1} T).symm
  have h := compactification_projective_source_forget A (sectionMap T)
    (AffineSpace PUnit.{u + 1} T ↘ T) (affineTraceLineCompactification T)
    (AffineSpace.zeroSection_comp_over PUnit.{u + 1} T) hz M
  refine Eq.mp ?_ h
  congr! (postTransparency := .reducible) <;> rfl

