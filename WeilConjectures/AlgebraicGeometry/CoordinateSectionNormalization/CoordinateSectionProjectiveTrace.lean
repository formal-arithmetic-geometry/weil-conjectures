private theorem ext_restriction_left
    (A : Type (u + 1)) [CommRing A] (N : ℕ) (hA : (N : A) = 0)
    (t : Etale.OrdinaryFiniteTwistTransport A N hA)
    {X Y : Scheme.{u}} (f : X ⟶ Y) (hY : IsUnit (N : Γ(Y, ⊤)))
    (F : Sheaf Y.smallEtaleTopology (ModuleCat.{u + 1} A))
    (G : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} A))
    (e : (Etale.upperStar (ModuleCat.{u + 1} A) f).obj F ⟶ G)
    (κ : Ext F (Scheme.finiteEtaleTateLine Y N A hA) 2)
    (κ' : Ext G (Scheme.finiteEtaleTateLine X N A hA) 2)
    (h : (Ext.mk₀ e).comp κ' (zero_add 2) =
      (κ.mapExactFunctor (Etale.upperStar (ModuleCat.{u + 1} A) f)).comp
        (Ext.mk₀ (t.line f hY).hom) (add_zero 2)) :
    (Etale.ordinaryFinitePullback A f).map κ.hom ≫
      (Etale.ordinaryFiniteShiftedLinePullback A N hA t f hY).hom =
    (Etale.ordinaryFiniteSinglePullbackIso A f).hom.app F ≫
      (Etale.ordinaryFiniteSingleFunctor A X).map e ≫ κ'.hom := by
  have hc := Etale.cached_ext_pullback A f F (Scheme.finiteEtaleTateLine Y N A hA) 2 κ
  have h' : Ext.mk₀CompMk₀ e κ' (𝟙 _) =
      Ext.mk₀CompMk₀ (𝟙 _) (κ.mapExactFunctor
        (Etale.upperStar (ModuleCat.{u + 1} A) f)) (t.line f hY).hom := by
    simpa only [Ext.mk₀CompMk₀, Ext.mk₀_id_comp, Ext.comp_mk₀_id] using h
  have hh := congrArg (Etale.ordinaryFiniteExtHomEquiv A X
    ((Etale.upperStar (ModuleCat.{u + 1} A) f).obj F)
    (Scheme.finiteEtaleTateLine X N A hA) 2) h'
  rw [Etale.cached_ext_conjugation, Etale.cached_ext_conjugation] at hh
  rw [(Etale.ordinaryFiniteSingleFunctor A X).map_id
      ((Etale.upperStar (ModuleCat.{u + 1} A) f).obj F),
    (Etale.ordinaryFiniteSingleFunctor A X).map_id
      (Scheme.finiteEtaleTateLine X N A hA)] at hh
  simp only [Nat.cast_ofNat] at hh
  erw [(shiftFunctor (Etale.DerivedCategoryModule A X) (2 : ℤ)).map_id
    ((Etale.ordinaryFiniteSingleFunctor A X).obj (Scheme.finiteEtaleTateLine X N A hA))]
    at hh
  erw [Category.comp_id, Category.id_comp] at hh
  simp only [Etale.ordinaryFiniteExtHomEquiv_eq, Nat.cast_ofNat] at hc
  rw [Etale.ordinaryFiniteShiftedLinePullback_eq]
  simp only [Iso.trans_hom, Functor.mapIso_hom, Functor.map_comp]
  erw [reassoc_of% hc]
  simpa only [Category.assoc, Etale.ordinaryFiniteSingleFunctor_eq,
    Etale.ordinaryFiniteExtHomEquiv_eq, Etale.ordinaryFiniteLine,
    Etale.ordinaryFiniteDegreeZero, Ext.hom, Nat.cast_ofNat, Functor.map_id,
    Functor.comp_obj, Functor.id_obj, Category.comp_id, Category.id_comp] using
    congrArg (fun c ↦ (Etale.ordinaryFiniteSinglePullbackIso A f).hom.app F ≫ c) hh.symm

-- Kummer restriction uses the explicit base-change comparison, rather than an arbitrary iso.
private theorem supported_restriction
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)]
    (N : ℕ) (hN : 0 < N) (hA : (N : A) = 0) (hT : IsUnit (N : Γ(T, ⊤)))
    (hI : (sectionMap T).ker.IsInvertible)
    (hJ : (projectiveZero T).ker.IsInvertible) :
    (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).map
      (projectiveSupported A T N hN hA (affineTraceProjectiveInvertible N T hT) hJ) ≫
      (Etale.ordinaryFiniteShiftedLinePullback A N hA
        (Etale.projectiveLineTraceTransport N hN A hA) (ProjectiveLine.affineChart T)
        (affineTraceProjectiveInvertible N T hT)).hom =
    (supportRestriction A T).hom ≫
      ordinarySupported A T N hN hA (affineTraceInvertible N T hT 1) hI := by
  let hP := affineTraceProjectiveInvertible N T hT
  let κ := (Etale.ordinary_supported_kummer_uniqueBoundary (ProjectiveLine T) N hN A hA
    hP (projectiveZero T) hJ).exists.choose
  let κ' := ordinaryClass A T N hN hA (affineTraceInvertible N T hT 1) hI
  have hκ := (Etale.ordinary_supported_kummer_uniqueBoundary (ProjectiveLine T) N hN A hA
    hP (projectiveZero T) hJ).exists.choose_spec
  have hκ' := (Etale.ordinary_supported_kummer_uniqueBoundary
    (AffineSpace PUnit.{u + 1} T) N hN A hA (affineTraceInvertible N T hT 1)
    (sectionMap T) hI).exists.choose_spec
  have he := Etale.supported_kummer_boundary_pullback (ProjectiveLine T) N hN A hA hP
    (projectiveZero T) hJ κ hκ (Etale.projectiveLineTraceTransport N hN A hA)
    (sectionMap T) (ProjectiveLine.affineChart T) (𝟙 T) (supportSquare T) hI κ' hκ'
  have hd := ext_restriction_left A N hA (Etale.projectiveLineTraceTransport N hN A hA)
    (ProjectiveLine.affineChart T) hP _ _ (supportExchange A T) κ κ' he
  unfold projectiveSupported ordinarySupported Etale.supportedExactDerivedMap
  rw [Functor.map_comp, Category.assoc, hd]
  simp only [supportRestriction, Iso.trans_hom, Iso.symm_hom,
    Functor.mapIso_hom, asIso_hom, Category.assoc,
    Iso.inv_hom_id_assoc]
  rfl

private def supportExtension (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)] :=
  (Etale.affineTraceOpenAdjunction A T).homEquiv _ _ |>.symm
    (supportRestriction A T).inv

private theorem supported_open_counit
    (A : Type (u + 1)) [CommRing A] [Finite A] (T : Scheme.{u})
    [IsClosedImmersion (projectiveZero T)]
    (N : ℕ) (hN : 0 < N) (hA : (N : A) = 0) (hT : IsUnit (N : Γ(T, ⊤)))
    (hI : (sectionMap T).ker.IsInvertible)
    (hJ : (projectiveZero T).ker.IsInvertible) :
    (Etale.affineTraceOpenLeft A T).map (restrictedSupported A T N hN hA hT hI) ≫
      (Etale.affineTraceOpenAdjunction A T).counit.app
        ((Etale.ordinaryFiniteLine A N hA (ProjectiveLine T))⟦(2 : ℤ)⟧) =
    supportExtension A T ≫
      projectiveSupported A T N hN hA (affineTraceProjectiveInvertible N T hT) hJ := by
  have hr := supported_restriction A T N hN hA hT hI hJ
  have he : restrictedSupported A T N hN hA hT hI =
      (supportRestriction A T).inv ≫
        (Etale.ordinaryFinitePullback A (ProjectiveLine.affineChart T)).map
          (projectiveSupported A T N hN hA (affineTraceProjectiveInvertible N T hT) hJ) := by
    rw [restrictedSupported]
    apply (cancel_mono (Etale.ordinaryFiniteShiftedLinePullback A N hA
      (Etale.projectiveLineTraceTransport N hN A hA) (ProjectiveLine.affineChart T)
      (affineTraceProjectiveInvertible N T hT)).hom).1
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [hr, Iso.inv_hom_id_assoc]
  rw [he, Functor.map_comp, Category.assoc]
  have hn := (Etale.affineTraceOpenAdjunction A T).counit.naturality
    (projectiveSupported A T N hN hA (affineTraceProjectiveInvertible N T hT) hJ)
  simp only [Functor.comp_map, Functor.id_map] at hn
  erw [hn]
  simp only [supportExtension, Adjunction.homEquiv_counit, Category.assoc]

end AlgebraicGeometry.ProEtale.CoordinateSectionNormalization

