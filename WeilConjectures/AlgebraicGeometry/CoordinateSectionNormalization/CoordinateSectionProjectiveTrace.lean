private instance affine_open_unit_isIso
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u}) :
    IsIso (affineTraceOpenAdjunction A T).unit := by
  rw [affineTraceOpenAdjunction, Adjunction.ofNatIsoRight_unit]
  infer_instance

private theorem open_inclusion_normalized
    (A : Type (u + 1)) [CommRing A] (T : Scheme.{u})
    (M : DerivedCategoryModule A (AffineSpace PUnit.{u + 1} T)) :
    (derivedOpenImmersionLowerShriekToLowerStar (ModuleCat.{u + 1} A)
      (ProjectiveLine.affineChart T)).app M =
    (ordinaryFiniteAdjunction A (ProjectiveLine.affineChart T)).unit.app
        ((affineTraceOpenLeft A T).obj M) ≫
      (ordinaryFinitePushforward A (ProjectiveLine.affineChart T)).map
        (inv ((affineTraceOpenAdjunction A T).unit.app M)) := by
  let j := ProjectiveLine.affineChart T
  let e := leftDerivedUpperStarIsoMapDerivedCategory (ModuleCat.{u + 1} A) j
  let a := derivedOpenImmersionLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} A) j
  let b := ordinaryFiniteAdjunction A j
  let R := ordinaryFinitePushforward A j
  have ha : (affineTraceOpenAdjunction A T).unit.app M =
      a.unit.app M ≫ e.inv.app ((affineTraceOpenLeft A T).obj M) := by
    rw [affineTraceOpenAdjunction]
    rfl
  have hb : (mapDerivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} A) j).unit.app
      ((affineTraceOpenLeft A T).obj M) =
      b.unit.app ((affineTraceOpenLeft A T).obj M) ≫
        R.map (e.hom.app ((affineTraceOpenLeft A T).obj M)) := by
    rw [mapDerivedUpperStarLowerStarAdjunction_eq]
    dsimp only [b, ordinaryFiniteAdjunction, R, e]
    simp only [Adjunction.ofNatIsoLeft_unit, NatTrans.comp_app,
      Functor.whiskerRight_app]
    unfold ordinaryFiniteAdjunction
    rfl
  have ha' : inv ((affineTraceOpenAdjunction A T).unit.app M) =
      e.hom.app ((affineTraceOpenLeft A T).obj M) ≫ inv (a.unit.app M) := by
    apply IsIso.inv_eq_of_hom_inv_id
    rw [ha]
    simp only [Category.assoc, Iso.inv_hom_id_app_assoc, IsIso.hom_inv_id]
  rw [ha', R.map_comp, ← Category.assoc, ← hb]
  simp only [derivedOpenImmersionLowerShriekToLowerStar, NatTrans.comp_app,
    Functor.whiskerLeft_app, Functor.whiskerRight_app, Functor.associator_inv_app,
    Functor.comp_obj, Functor.id_obj, Category.id_comp,
    NatIso.isIso_inv_app]
  rfl

