module

public import WeilConjectures.LinearAlgebra.Matrix.MinorIdeal
public import Mathlib.LinearAlgebra.Pi
import WeilConjectures.LinearAlgebra.Matrix.MinorIdealInclusions

/-!
# Row-minor ideals: stabilization and coordinate invariance

Source: Stacks Project, More on Algebra, Tag 07Z8, proof of `lemma-fitting-ideal`,
transposed from columns to rows (blueprint: lem-trf-row-minor-ideal-stable-invariance).

## Main definitions and statements

* `Matrix.rowMinorIdeal`: the ideal of minors of rows in an arbitrary submodule.
* `Matrix.rowMinorIdeal_stable_invariance`: finite-matrix sum description, stabilization,
  and invariance under linear automorphisms.
-/

@[expose] public section

universe u

namespace Matrix

/-- The ideal `D_k(K;n)` of Tag 07Z8's kernel-row description: it is the whole ring
when `n ≤ k`, and otherwise is generated by all `(n-k)`-minors of all `(n-k)`-row
matrices with rows in `K`. The supremum of their minor ideals is the ideal generated
by their combined determinant generators. No finite generation of `K` is required.
Source: Stacks Project, More on Algebra, Tag 07Z8, opening paragraph of the proof
(blueprint: lem-trf-row-minor-ideal-stable-invariance).
-/
noncomputable def rowMinorIdeal {R : Type u} [CommRing R] (n k : ℕ)
    (K : Submodule R (Fin n → R)) : Ideal R :=
  if n ≤ k then ⊤ else
    ⨆ (A : Matrix (Fin (n - k)) (Fin n) R) (_ : ∀ i : Fin (n - k), A i ∈ K),
      minorIdeal (n - k) n (n - k) A

private theorem univ_orderEmb (r : ℕ) :
    ((Finset.univ : Finset (Fin r)).orderEmbOfFin (by simp) : Fin r → Fin r) = id := by
  exact (Finset.orderEmbOfFin_unique (by simp) (fun _ ↦ Finset.mem_univ _)
    (fun _ _ h ↦ h)).symm

private theorem minorIdeal_le_row {R : Type u} [CommRing R] {n k : ℕ}
    (hk : k < n) (K : Submodule R (Fin n → R)) (p : ℕ)
    (A : Matrix (Fin p) (Fin n) R) (hA : ∀ i, A i ∈ K) :
    minorIdeal p n (n - k) A ≤ rowMinorIdeal n k K := by
  classical
  apply Ideal.span_le.mpr
  rintro _ ⟨⟨S, T⟩, rfl⟩
  let B : Matrix (Fin (n - k)) (Fin n) R :=
    A.submatrix (S.val.orderEmbOfFin S.property) id
  have hB : ∀ i, B i ∈ K := fun i ↦ hA _
  rw [rowMinorIdeal, if_neg (by omega)]
  have hle : minorIdeal (n - k) n (n - k) B ≤
      ⨆ (A : Matrix (Fin (n - k)) (Fin n) R) (_ : ∀ i, A i ∈ K),
        minorIdeal (n - k) n (n - k) A :=
    le_iSup_of_le B (le_iSup_of_le hB le_rfl)
  apply hle
  apply Ideal.subset_span
  refine ⟨(⟨Finset.univ, by simp⟩, T), ?_⟩
  simp [B, submatrix, univ_orderEmb]

private theorem row_eq_sum {R : Type u} [CommRing R] {n k : ℕ}
    (hk : k < n) (K : Submodule R (Fin n → R)) :
    rowMinorIdeal n k K =
      ⨆ (p : ℕ) (A : Matrix (Fin p) (Fin n) R) (_ : ∀ i, A i ∈ K),
        minorIdeal p n (n - k) A := by
  apply le_antisymm
  · rw [rowMinorIdeal, if_neg (by omega)]
    exact iSup_le fun A ↦ iSup_le fun hA ↦
      le_iSup_of_le (n - k) (le_iSup_of_le A (le_iSup_of_le hA le_rfl))
  · exact iSup_le fun p ↦ iSup_le fun A ↦ iSup_le fun hA ↦
      minorIdeal_le_row hk K p A hA

private theorem det_mem_row {R : Type u} [CommRing R] {n k : ℕ}
    (hk : k < n) (K : Submodule R (Fin n → R))
    (A : Matrix (Fin (n - k)) (Fin n) R) (hA : ∀ i, A i ∈ K)
    (c : Fin (n - k) → Fin n) (hc : StrictMono c) :
    (A.submatrix id c).det ∈ rowMinorIdeal n k K := by
  classical
  apply minorIdeal_le_row hk K (n - k) A hA
  apply Ideal.subset_span
  let T := Finset.univ.image c
  have hT : T.card = n - k := by simp [T, Finset.card_image_of_injective, hc.injective]
  have he : (T.orderEmbOfFin hT : Fin (n - k) → Fin n) = c :=
    (Finset.orderEmbOfFin_unique hT (by intro i; simp [T]) hc).symm
  refine ⟨(⟨Finset.univ, by simp⟩, ⟨T, hT⟩), ?_⟩
  simp [univ_orderEmb, he, submatrix]

private theorem det_mem_row_size {R : Type u} [CommRing R] {n k r : ℕ}
    (hk : k < n) (hr : n - k = r) (K : Submodule R (Fin n → R))
    (A : Matrix (Fin r) (Fin n) R) (hA : ∀ i, A i ∈ K)
    (c : Fin r → Fin n) (hc : StrictMono c) :
    (A.submatrix id c).det ∈ rowMinorIdeal n k K := by
  subst r
  exact det_mem_row hk K A hA c hc

private theorem row_stable_le {R : Type u} [CommRing R] {n k : ℕ}
    (hk : k < n) (K : Submodule R (Fin n → R)) (d : ℕ) :
    rowMinorIdeal (n + d) k
      (K.comap (LinearMap.pi fun j : Fin n ↦
        (LinearMap.proj (Fin.castAdd d j) : (Fin (n + d) → R) →ₗ[R] R))) ≤
      rowMinorIdeal n k K := by
  have hnew : k < n + d := by omega
  rw [row_eq_sum hnew]
  refine iSup_le fun p ↦ iSup_le fun B ↦ iSup_le fun hB ↦ ?_
  let A : Matrix (Fin p) (Fin n) R := fun i j ↦ B i (Fin.castAdd d j)
  have hA : ∀ i, A i ∈ K := hB
  have hs : n + d - k = (n - k) + d := by omega
  rw [hs]
  exact ((minorIdeal_inclusions p n (n - k) d A).2.1 B (fun _ _ ↦ rfl)).trans
    (minorIdeal_le_row hk K p A hA)

private theorem row_le_stable {R : Type u} [CommRing R] {n k : ℕ}
    (hk : k < n) (K : Submodule R (Fin n → R)) (d : ℕ) :
    rowMinorIdeal n k K ≤ rowMinorIdeal (n + d) k
      (K.comap (LinearMap.pi fun j : Fin n ↦
        (LinearMap.proj (Fin.castAdd d j) : (Fin (n + d) → R) →ₗ[R] R))) := by
  classical
  rw [rowMinorIdeal, if_neg (by omega)]
  refine iSup_le fun A ↦ iSup_le fun hA ↦ Ideal.span_le.mpr ?_
  rintro _ ⟨⟨S, T⟩, rfl⟩
  let r := n - k
  let t : Fin r → Fin n := T.val.orderEmbOfFin T.property
  let B : Matrix (Fin r) (Fin n) R := A.submatrix (S.val.orderEmbOfFin S.property) id
  let E : Matrix (Fin (r + d)) (Fin (n + d)) R :=
    Fin.append (fun i ↦ Fin.append (B i) 0)
      (fun i ↦ Fin.append 0 ((1 : Matrix (Fin d) (Fin d) R) i))
  let c : Fin (r + d) → Fin (n + d) :=
    Fin.append (fun i ↦ Fin.castAdd d (t i)) (Fin.natAdd n)
  -- Old selected columns precede all the newly adjoined columns.
  have hc : StrictMono c := by
    intro i j hij
    cases i using Fin.addCases <;> cases j using Fin.addCases
    · simp only [c, Fin.append_left]
      apply (Fin.strictMono_castAdd d) ((T.val.orderEmbOfFin T.property).strictMono _)
      exact hij
    · simp only [c, Fin.append_left, Fin.append_right]
      change (t _).val < n + _
      omega
    · simp only [Fin.lt_def, Fin.val_natAdd, Fin.val_castAdd] at hij
      omega
    · simpa [c] using (Fin.strictMono_natAdd n) (by simpa using hij)
  have hE : ∀ i, E i ∈ K.comap (LinearMap.pi fun j : Fin n ↦
      (LinearMap.proj (Fin.castAdd d j) : (Fin (n + d) → R) →ₗ[R] R)) := by
    intro i
    change (fun j ↦ E i (Fin.castAdd d j)) ∈ K
    cases i using Fin.addCases
    · simpa [E, B, submatrix] using hA _
    · simpa only [E, Fin.append_right, Fin.append_left] using K.zero_mem
  have hm := det_mem_row_size (by omega : k < n + d)
    (by dsimp [r]; omega : n + d - k = r + d) _ E hE c hc
  -- Reindex the chosen minor as the old minor plus an identity block.
  have he : (E.submatrix id c).submatrix finSumFinEquiv finSumFinEquiv =
      fromBlocks (B.submatrix id t) 0 0 (1 : Matrix (Fin d) (Fin d) R) := by
    ext i j
    cases i <;> cases j <;> simp [E, c, submatrix, fromBlocks]
  rw [← det_submatrix_equiv_self finSumFinEquiv (E.submatrix id c), he,
    det_fromBlocks_zero₁₂, det_one, mul_one] at hm
  exact hm

private theorem row_stable_top {R : Type u} [CommRing R] {n k : ℕ}
    (hk : n ≤ k) (K : Submodule R (Fin n → R)) (d : ℕ) :
    rowMinorIdeal (n + d) k
      (K.comap (LinearMap.pi fun j : Fin n ↦
        (LinearMap.proj (Fin.castAdd d j) : (Fin (n + d) → R) →ₗ[R] R))) = ⊤ := by
  classical
  by_cases hnew : n + d ≤ k
  · simp [rowMinorIdeal, hnew]
  let s := n + d - k
  have hs : s ≤ d := by dsimp [s]; omega
  let c : Fin s → Fin (n + d) := fun i ↦ ⟨n + i.val, by omega⟩
  have hc : StrictMono c := by
    intro i j hij
    change n + i.val < n + j.val
    simpa using hij
  let E : Matrix (Fin s) (Fin (n + d)) R := fun i j ↦ if c i = j then 1 else 0
  have hE : ∀ i, E i ∈ K.comap (LinearMap.pi fun j : Fin n ↦
      (LinearMap.proj (Fin.castAdd d j) : (Fin (n + d) → R) →ₗ[R] R)) := by
    intro i
    change (fun j ↦ E i (Fin.castAdd d j)) ∈ K
    have hz : (fun j ↦ E i (Fin.castAdd d j)) = 0 := by
      funext j
      have hn : c i ≠ Fin.castAdd d j := by
        intro h
        have := congrArg Fin.val h
        dsimp [c] at this
        omega
      simp [E, hn]
    rw [hz]
    exact K.zero_mem
  have hm := det_mem_row_size (by omega : k < n + d) rfl _ E hE c hc
  have he : E.submatrix id c = (1 : Matrix (Fin s) (Fin s) R) := by
    ext i j
    simp [E, submatrix, hc.injective.eq_iff, Matrix.one_apply]
  rw [he, det_one] at hm
  exact Ideal.eq_top_of_isUnit_mem _ hm isUnit_one

private theorem row_map_le {R : Type u} [CommRing R] (n k : ℕ)
    (K : Submodule R (Fin n → R)) (u : (Fin n → R) ≃ₗ[R] (Fin n → R)) :
    rowMinorIdeal n k (K.map u.toLinearMap) ≤ rowMinorIdeal n k K := by
  classical
  by_cases hk : n ≤ k
  · simp [rowMinorIdeal, hk]
  have hkn : k < n := by omega
  rw [row_eq_sum hkn]
  refine iSup_le fun p ↦ iSup_le fun A ↦ iSup_le fun hA ↦ ?_
  let B : Matrix (Fin p) (Fin n) R := fun i ↦ u.symm (A i)
  have hB : ∀ i, B i ∈ K := by
    intro i
    obtain ⟨x, hx, he⟩ := Submodule.mem_map.mp (hA i)
    simpa [B, ← he] using hx
  let C : Matrix (Fin n) (Fin n) R := fun i ↦ u (Pi.single i 1)
  have he : A = B * C := by
    ext i j
    have hz := congrArg (fun z ↦ u z j) (pi_eq_sum_univ' (B i))
    simpa [B, C, mul_apply, dotProduct] using hz
  rw [he]
  exact ((minorIdeal_inclusions p n (n - k) 0 B).2.2 C).trans
    (minorIdeal_le_row hkn K p B hB)

/-- The row-minor ideal is the sum over all finite row matrices, is unchanged by
adjoining arbitrary free coordinates, and is invariant under linear automorphisms.
The comap in the second clause is exactly `K ⊕ R^d` in the first `n` and last `d`
coordinates: its sole membership condition is that the first `n` coordinates lie in `K`.
Source: Stacks Project, More on Algebra, Tag 07Z8, proof of `lemma-fitting-ideal`
(blueprint: lem-trf-row-minor-ideal-stable-invariance).

Proof: (1) Every selected `(n-k)` rows of a finite row matrix still belong to `K`,
so every minor generator belongs to `rowMinorIdeal`. Conversely, every defining
`(n-k)`-row matrix is one of the finite matrices in the supremum. This uses
`def-trf-minor-ideal` and proves the first equality without finite generation.
(2) If `n ≤ k`, the old ideal is the whole ring. If also `n+d ≤ k`, so is the new
one by definition. Otherwise choose `n+d-k ≤ d` standard rows and matching columns
among the last `d` coordinates; the determinant is `1` by
`def-weil-pbc-matrix-determinant`. If `n > k`, append zero columns and `d` standard
rows to a defining matrix. Each old minor becomes a block diagonal minor with an
identity block, with the same determinant by `lem-weil-pbc-block-triangular-determinant`
and the identity determinant formula. Conversely, project any enlarged row matrix
to its first `n` columns. Its rows lie in `K`; part (2) of
`lem-trf-fitting-ideal-minor-inclusions` and clause (1) put every enlarged minor
in the old ideal. These two inclusions give stabilization.
(3) For `n ≤ k`, both ideals are the whole ring. Otherwise the matrix
`C i j = u(e_i) j` expresses the image of every row matrix as `A * C`.
Part (3) of `lem-trf-fitting-ideal-minor-inclusions` and clause (1) give the forward
inclusion. Apply the same argument to `u.symm` and `u(K)` for the reverse inclusion.
-/
theorem rowMinorIdeal_stable_invariance {R : Type u} [CommRing R] (n k : ℕ)
    (K : Submodule R (Fin n → R)) :
    (k < n → rowMinorIdeal n k K =
      ⨆ (p : ℕ) (A : Matrix (Fin p) (Fin n) R) (_ : ∀ i : Fin p, A i ∈ K),
        minorIdeal p n (n - k) A) ∧
    (∀ d : ℕ, rowMinorIdeal (n + d) k
      (K.comap (LinearMap.pi fun j : Fin n ↦
        (LinearMap.proj (Fin.castAdd d j) : (Fin (n + d) → R) →ₗ[R] R))) =
          rowMinorIdeal n k K) ∧
    (∀ u : (Fin n → R) ≃ₗ[R] (Fin n → R),
      rowMinorIdeal n k (K.map u.toLinearMap) = rowMinorIdeal n k K) := by
  refine ⟨fun hk ↦ row_eq_sum hk K, ?_, ?_⟩
  · intro d
    by_cases hk : n ≤ k
    · rw [row_stable_top hk, rowMinorIdeal, if_pos hk]
    · exact le_antisymm (row_stable_le (by omega) K d) (row_le_stable (by omega) K d)
  · intro u
    apply le_antisymm (row_map_le n k K u)
    have he : (K.map u.toLinearMap).map u.symm.toLinearMap = K := by
      ext x
      constructor
      · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
        simpa using hz
      · intro hx
        exact ⟨u x, ⟨x, hx, rfl⟩, u.symm_apply_apply x⟩
    simpa only [he] using row_map_le n k (K.map u.toLinearMap) u.symm

end Matrix
