module

public import Mathlib.LinearAlgebra.TensorProduct.Tower
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Data.Set.Countable
import WeilConjectures.LinearAlgebra.LiftCountablyGeneratedSubmodule

/-!
# Countable submodules adapted to a scalar-extension direct sum

Source: Stacks Project, Algebra, Tag 05A8, `lemma-adapted-submodule`
(blueprint: lem-trf-countable-submodule-adapted-to-base-change-sum).
-/

@[expose] public section

set_option autoImplicit false

universe u v w x y

open scoped TensorProduct DirectSum

namespace Submodule

open Classical in
/-- A countably generated submodule can be enlarged so that its scalar-extension image
is a coordinate subsum of a given decomposition into countably generated modules.
Countable generation is expressed by a countable spanning subset. The coordinate subsum
is the supremum of the ranges of the selected canonical inclusions.

Source: Stacks Project, Algebra, Tag 05A8, `lemma-adapted-submodule`
(blueprint: lem-trf-countable-submodule-adapted-to-base-change-sum).

Proof:
1. Start with `N₀ = C`. For a countably generated `Nₗ`, let `Eₗ` be its tensor image,
   transported through `θ`, and let `Iₗ` consist of the indices with nonzero projection
   of `Eₗ`. Countably many generators, each having finite support under `θ`, show that
   `Iₗ` is countable. The coordinate sum over `Iₗ` is countably generated by the union
   of countable generators of its summands. These assertions use the tensor and direct
   sum definitions (`def-weil-pbc-module-tensor-product`, `def-weil-pbc-direct-sum-modules`).
2. Apply `lem-trf-lift-countably-generated-submodule` (Tag 05A7) to the inverse image
   under `θ` of this coordinate sum, obtaining a countably generated submodule `Pₗ`
   whose tensor image contains it. Put `Nₗ₊₁ = Nₗ + Pₗ`. It contains `Nₗ`, is countably
   generated, and its tensor image contains all the summands indexed by `Iₗ`.
3. Put `P = ⋃ₗ Nₗ` and `J = ⋃ₗ Iₗ`. The increasing union is a submodule containing
   `C`, generated by the countable union of the stage generators. Each summand in `J`
   lies in the tensor image at a later stage. Conversely, any element of the tensor
   product with `P` is a finite sum of pure tensors, so its finitely many second factors
   belong to one common stage. Its image has coordinates only in that stage's `Iₗ`.
4. Transport by `θ` to obtain precisely the coordinate subsum indexed by `J`, expressed
   as the supremum of the canonical summand ranges. No flatness or projectivity is used. -/
theorem exists_countable_submodule_adapted_to_baseChange_directSum
    {A : Type u} [CommRing A] {B : Type v} [CommRing B] [Algebra A B]
    {L : Type w} [AddCommGroup L] [Module A L]
    {I : Type x} {Q : I → Type y} [∀ i, AddCommGroup (Q i)] [∀ i, Module B (Q i)]
    (θ : B ⊗[A] L ≃ₗ[B] ⨁ i : I, Q i)
    (hQ : ∀ i, ∃ s : Set (Q i), s.Countable ∧ Submodule.span B s = ⊤)
    (C : Submodule A L) (hC : ∃ s : Set L, s.Countable ∧ Submodule.span A s = C) :
    ∃ P : Submodule A L,
      (∃ s : Set L, s.Countable ∧ Submodule.span A s = P) ∧ C ≤ P ∧
      ∃ J : Set I,
        LinearMap.range (θ.toLinearMap.comp (P.subtype.baseChange B)) =
          ⨆ j : J, LinearMap.range (DirectSum.lof B I Q j.val) := by
  sorry

end Submodule
