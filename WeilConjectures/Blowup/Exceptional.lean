module

public import WeilConjectures.Blowup.Gluing
public import WeilConjectures.Mathlib.Algebra.Ring.NonZeroDivisors
public import WeilConjectures.Mathlib.AlgebraicGeometry.AffineScheme
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!

# The exceptional ideal of a blow-up

This file studies the extension of the center ideal to its blow-up, following the
blueprint chapter "Nagata compactification".

For an ideal `I` of a ring `A` and `a ∈ I`, the `a`-chart of the affine blow-up
`Bl_I (Spec A)` is `Spec` of the degree-zero part `C` of the localization of the Rees
algebra at `a·X`. We prove the two chart-level facts constituting the principalization
of the center (blueprint: `thm:nagata-blowup-principalizes-center`):

- `AlgebraicGeometry.AffineBlowup.map_awayAlgebraMap_eq_span`: the extension of `I`
  to `C` is generated by (the image of) `a` — every `b ∈ I` is divisible by `a` in `C`,
  with quotient the chart fraction `AffineBlowup.chartDiv`;
- `AlgebraicGeometry.AffineBlowup.awayAlgebraMap_mem_nonZeroDivisors`: the image of `a`
  in `C` is a nonzerodivisor.

We also define, for a quasi-coherent ideal `I` on a scheme `X`:

- `AlgebraicGeometry.Scheme.IdealSheafData.extendedToBlowup`: the extension
  `I·O_{Bl_I X}` of the center to the blow-up, realized as the inverse image ideal
  sheaf `I.comap I.blowupMap`.

The file culminates in the principalization theorem
`Scheme.IdealSheafData.extendedToBlowup_isEffectiveCartier`
(blueprint: `thm:nagata-blowup-principalizes-center`): the extension of the center to
the blow-up is an effective Cartier ideal
(`Scheme.IdealSheafData.IsEffectiveCartier` of
`WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Basic`). The supporting
computation of the inverse image ideal sheaf along an affine probe is
`Scheme.IdealSheafData.ideal_comap_specMap_fromSpec` of
`WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Functorial`.

-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory HomogeneousLocalization Limits Polynomial

namespace AlgebraicGeometry

section ChartAlgebra

variable {A : Type u} [CommRing A] (I : Ideal A)

namespace AffineBlowup

/-- The chart fraction `b/a` in the `a`-chart of the affine blow-up, for `a, b ∈ I`:
the homogeneous fraction `(b·X)/(a·X)` of degree-one elements of the Rees algebra. -/
def chartDiv (a b : A) (ha : a ∈ I) (hb : b ∈ I) :
    HomogeneousLocalization.Away (reesGrading I) (reesX I a ha) :=
  HomogeneousLocalization.mk
    ⟨1, ⟨reesX I b hb, reesX_mem I b hb⟩, ⟨reesX I a ha, reesX_mem I a ha⟩, 1, pow_one _⟩

lemma val_awayAlgebraMap (x : reesAlgebra I) (b : A) :
    (awayAlgebraMap I x b).val =
      Localization.mk (reesGradingZero I b : reesAlgebra I) 1 :=
  rfl

/-- The chart fraction `b/a` multiplied by `a` recovers `b`: division by `a` is possible
in the `a`-chart for every element of `I`. -/
lemma chartDiv_mul_awayAlgebraMap (a b : A) (ha : a ∈ I) (hb : b ∈ I) :
    chartDiv I a b ha hb * awayAlgebraMap I (reesX I a ha) a =
      awayAlgebraMap I (reesX I a ha) b := by
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
    val_awayAlgebraMap, val_awayAlgebraMap, chartDiv, HomogeneousLocalization.val_mk,
    Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  apply Subtype.ext
  simp [Polynomial.C_mul_monomial, mul_comm]

/-- **The extended ideal on a blow-up chart is principal**: the extension of `I` to the
`a`-chart of the blow-up is generated by the image of `a`.
(Blueprint: `thm:nagata-blowup-principalizes-center`, chart form.) -/
theorem map_awayAlgebraMap_eq_span (a : A) (ha : a ∈ I) :
    I.map (awayAlgebraMap I (reesX I a ha)) =
      Ideal.span {awayAlgebraMap I (reesX I a ha) a} := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_) ?_
  · rw [Ideal.mem_comap, Ideal.mem_span_singleton]
    exact ⟨chartDiv I a b ha hb,
      by rw [← chartDiv_mul_awayAlgebraMap I a b ha hb]
         exact mul_comm (chartDiv I a b ha hb) (awayAlgebraMap I (reesX I a ha) a)⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ ha

/-- **The chart equation of the exceptional divisor is a nonzerodivisor**: the image of
`a` in the `a`-chart of the blow-up is a nonzerodivisor.
(Blueprint: `thm:nagata-blowup-principalizes-center`, regularity of the chart
equation.) -/
theorem awayAlgebraMap_mem_nonZeroDivisors (a : A) (ha : a ∈ I) :
    awayAlgebraMap I (reesX I a ha) a ∈
      nonZeroDivisors (HomogeneousLocalization.Away (reesGrading I) (reesX I a ha)) := by
  suffices main : ∀ z : HomogeneousLocalization.Away (reesGrading I) (reesX I a ha),
      z * awayAlgebraMap I (reesX I a ha) a = 0 → z = 0 by
    exact mem_nonZeroDivisors_iff.mpr
      ⟨fun z hz ↦ main z ((mul_comm z (awayAlgebraMap I (reesX I a ha) a)).trans hz), main⟩
  intro z hz
  obtain ⟨n, y, hy, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective (reesGrading I) (reesX_mem I a ha) z
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.Away.val_mk, val_awayAlgebraMap,
    HomogeneousLocalization.val_zero, Localization.mk_mul, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_zero_iff] at hz
  obtain ⟨⟨-, k, rfl⟩, hk⟩ := hz
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk,
    HomogeneousLocalization.val_zero, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_zero_iff]
  refine ⟨⟨reesX I a ha ^ (k + 1), k + 1, rfl⟩, Subtype.ext ?_⟩
  have hcoe := congrArg (fun p : reesAlgebra I ↦ (p : A[X])) hk
  simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, coe_reesX,
    coe_reesGradingZero_apply, ZeroMemClass.coe_zero] at hcoe ⊢
  have key : (Polynomial.monomial 1 a : A[X]) = Polynomial.monomial 1 1 * Polynomial.C a := by
    rw [Polynomial.monomial_mul_C, one_mul]
  calc (Polynomial.monomial 1 a : A[X]) ^ (k + 1) * (y : A[X])
      = Polynomial.monomial 1 1 *
        ((Polynomial.monomial 1 a : A[X]) ^ k * ((y : A[X]) * Polynomial.C a)) := by
        rw [pow_succ, key]; ring
    _ = 0 := by rw [hcoe, mul_zero]

end AffineBlowup

end ChartAlgebra

namespace Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- The extension `I·O_{Bl_I X}` of the center ideal to its blow-up, realized as the
inverse image ideal sheaf of the blow-up map. Its support is the preimage of the
support of `I` by `Scheme.IdealSheafData.support_comap`. -/
abbrev extendedToBlowup (I : X.IdealSheafData) : I.blowup.IdealSheafData :=
  I.comap I.blowupMap

end Scheme.IdealSheafData

section Assembly

variable {X : Scheme.{u}}

/-- The chart of the blow-up over an affine open, composed down to the base: the
composite `Spec C ⟶ Bl_I X ⟶ X` is `Spec` of the chart ring map followed by the
inclusion of the affine open. -/
lemma chart_blowupι_comp_blowupMap (I : X.IdealSheafData) (U : X.affineOpens)
    (a : Γ(X, U.1)) (ha : a ∈ I.ideal U) :
    (AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha) (reesX_mem (I.ideal U) a ha) ≫
        I.blowupι U) ≫ I.blowupMap =
      Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal U)
        (reesX (I.ideal U) a ha))) ≫ U.2.fromSpec :=
  calc (AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha)
        (reesX_mem (I.ideal U) a ha) ≫ I.blowupι U) ≫ I.blowupMap
      = AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha) (reesX_mem (I.ideal U) a ha) ≫
          (I.blowupι U ≫ I.blowupMap) := Category.assoc _ _ _
    _ = AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha) (reesX_mem (I.ideal U) a ha) ≫
          (I.blowupNatTrans.app U ≫ U.1.ι) :=
        congrArg (AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha)
          (reesX_mem (I.ideal U) a ha) ≫ ·) (I.blowupι_blowupMap U)
    _ = AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha) (reesX_mem (I.ideal U) a ha) ≫
          ((AffineBlowup.toSpec (I.ideal U) ≫ U.2.isoSpec.inv) ≫ U.1.ι) :=
        congrArg (fun t ↦ AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha)
          (reesX_mem (I.ideal U) a ha) ≫ t ≫ U.1.ι) (I.blowupNatTrans_app U)
    _ = (AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a ha)
          (reesX_mem (I.ideal U) a ha) ≫ AffineBlowup.toSpec (I.ideal U)) ≫
          (U.2.isoSpec.inv ≫ U.1.ι) := by
        simp only [Category.assoc]
    _ = Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal U)
          (reesX (I.ideal U) a ha))) ≫ (U.2.isoSpec.inv ≫ U.1.ι) :=
        congrArg (· ≫ (U.2.isoSpec.inv ≫ U.1.ι))
          (AffineBlowup.chart_toSpec (I.ideal U) _ _)
    _ = Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal U)
          (reesX (I.ideal U) a ha))) ≫ U.2.fromSpec :=
        congrArg (Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal U)
          (reesX (I.ideal U) a ha))) ≫ ·) U.2.isoSpec_inv_ι

set_option maxHeartbeats 1600000 in
-- The chart rings of the blow-up are large `HomogeneousLocalization` types; unifying
-- them during the assembly of the chart data exceeds the default heartbeat limit.
/-- **Principalization of the center** (blueprint:
`thm:nagata-blowup-principalizes-center`): on the blow-up of a quasi-coherent ideal
`I`, the extension of `I` to the blow-up is an effective Cartier ideal — on the
`a`-chart of the blow-up over an affine open, it is generated by the nonzerodivisor
`a`. -/
theorem Scheme.IdealSheafData.extendedToBlowup_isEffectiveCartier (I : X.IdealSheafData) :
    I.extendedToBlowup.IsEffectiveCartier := by
  intro x
  have hx : I.blowupMap x ∈ (⊤ : X.Opens) := trivial
  rw [← iSup_affineOpens_eq_top X] at hx
  obtain ⟨U, hU⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  have hx2 : x ∈ I.blowupMap ⁻¹ᵁ U.1 := hU
  rw [I.blowupMap_preimage U] at hx2
  obtain ⟨y, rfl⟩ := hx2
  have hy : y ∈ (⊤ : (AffineBlowup (I.ideal U)).Opens) := trivial
  rw [← AffineBlowup.iSup_basicOpen_reesX_eq_top (I.ideal U)] at hy
  obtain ⟨a, hy⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  rw [← AffineBlowup.opensRange_chart (I.ideal U) (reesX (I.ideal U) a.1 a.2)
    (reesX_mem (I.ideal U) a.1 a.2)] at hy
  obtain ⟨z, rfl⟩ := hy
  have hcomp := chart_blowupι_comp_blowupMap I U a.1 a.2
  have hpre : (⊤ : (Spec (.of (HomogeneousLocalization.Away (reesGrading (I.ideal U))
      (reesX (I.ideal U) a.1 a.2)))).Opens) ≤
      (Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal U)
        (reesX (I.ideal U) a.1 a.2))) ≫ U.2.fromSpec) ⁻¹ᵁ U.1 := by
    rw [Scheme.Hom.comp_preimage, U.2.fromSpec_preimage_self]
    exact le_rfl
  refine exists_effectiveCartier_generator_of_comap I.extendedToBlowup
    (AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a.1 a.2)
      (reesX_mem (I.ideal U) a.1 a.2) ≫ I.blowupι U)
    ⟨z, by rw [Scheme.Hom.comp_apply]⟩
    ((Scheme.ΓSpecIso _).inv (AffineBlowup.awayAlgebraMap (I.ideal U)
      (reesX (I.ideal U) a.1 a.2) a.1))
    (map_mem_nonZeroDivisors_of_bijective _ (ConcreteCategory.bijective_of_isIso _)
      (AffineBlowup.awayAlgebraMap_mem_nonZeroDivisors (I.ideal U) a.1 a.2)) ?_
  have h3 : I.extendedToBlowup.comap
      (AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a.1 a.2)
        (reesX_mem (I.ideal U) a.1 a.2) ≫ I.blowupι U) =
      I.comap (Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal U)
        (reesX (I.ideal U) a.1 a.2))) ≫ U.2.fromSpec) :=
    (Scheme.IdealSheafData.comap_comp I _ I.blowupMap).symm.trans
      (congrArg (I.comap ·) hcomp)
  refine (congrArg (fun J ↦ Scheme.IdealSheafData.ideal J ⟨⊤, isAffineOpen_top _⟩) h3).trans ?_
  refine (I.ideal_comap_specMap_fromSpec U _ hpre).trans ?_
  refine (congrArg (fun t ↦ (I.ideal U).map (CommRingCat.Hom.hom t))
    (appLE_specMap_comp_fromSpec U _ hpre)).trans ?_
  refine (congrArg ((I.ideal U).map ·) (CommRingCat.hom_comp _ _)).trans ?_
  refine (Ideal.map_map _ _).symm.trans ?_
  refine (congrArg (Ideal.map _)
    ((congrArg ((I.ideal U).map ·) (CommRingCat.hom_ofHom _)).trans
      (AffineBlowup.map_awayAlgebraMap_eq_span (I.ideal U) a.1 a.2))).trans ?_
  exact (Ideal.map_span _ _).trans (congrArg Ideal.span Set.image_singleton)

end Assembly

end AlgebraicGeometry
