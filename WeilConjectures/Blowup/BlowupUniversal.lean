module

public import WeilConjectures.Blowup.FiniteDegree
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

/-!

# The universal property of blowing up (Stacks Project Tag 0806)

This file proves the universal property of the chart-glued blow-up
`Scheme.IdealSheafData.blowup`: a morphism `t : T ⟶ X` such that the inverse image
ideal sheaf `I.comap t` is invertible factors uniquely through the
blow-up of `I` (existence: `Scheme.IdealSheafData.exists_lift_blowup`; uniqueness:
`Scheme.IdealSheafData.hom_ext_of_isInvertible_comap`; Stacks Project
Tag 0806; blueprint `thm:nagata-blowup-universal-property`).

The proof is chart-local, with the algebraic core the universal property of the
`a`-chart ring `A[I/a]` of the affine blow-up:

- `AlgebraicGeometry.AffineBlowup.chartRingLift`: for a ring map `φ : A →+* R` with
  `φ a` a nonzerodivisor dividing the extension of `I`, the induced map
  `A[I/a] →+* R` sending `x/aⁿ` to the unique solution of `y·φ(a)ⁿ = φ(x)`
  (division by the nonzerodivisor `φ a`);
- `AlgebraicGeometry.AffineBlowup.chartRingHom_ext`: ring maps out of a chart ring
  agreeing on the base and with regular value on the chart denominator are equal;
- `AlgebraicGeometry.AffineBlowup.awayAlgebraMap_mem_nonZeroDivisors_of_mem`:
  the chart section map preserves nonzerodivisors.

On the scheme side we prove, for a quasi-coherent ideal `I` on `X`:

- the invertible-ideal lemma kit: local presentations on a basis
  (`IsInvertible.exists_presentation_le`), stability under products, factors of
  products (`IsInvertible.of_mul_left/right`, the "factor of an invertible product
  ideal" lemma of Stacks Tag 080A), and pullback along blow-up maps
  (`IsInvertible.comap_blowupMap`);
- `Scheme.IdealSheafData.hom_ext_of_isInvertible_comap`: uniqueness of lifts along
  the blow-up map (two morphisms to the blow-up over the same base map with
  invertible inverse image ideal agree), via the chart-overlap localization
  `HomogeneousLocalization.Away.isLocalization_mul`;
- `Scheme.IdealSheafData.exists_lift_blowup`: existence of the universal lift
  (Stacks Project Tag 0806); together with `hom_ext_of_isInvertible_comap` above
  this is the universal property of blowing up.

Elaboration-performance conventions follow
`WeilConjectures.Compactification.FiniteDegree`: chart probes keep their section
ring abstract, no `rw`/`▸` on goals mentioning chart rings, and equalities of
morphisms are assembled by `congrArg`/explicit `calc` steps.

-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Limits Polynomial

namespace AlgebraicGeometry

section RingLemmas

variable {R : Type u} [CommRing R]

/-- If two principal ideals generated by `c` and `d` agree and `c` is a nonzerodivisor,
then `d` is a unit multiple of `c`; in particular `d` is a nonzerodivisor as well. -/
lemma exists_unit_mul_of_span_singleton_eq {c d : R}
    (hc : c ∈ nonZeroDivisors R) (h : Ideal.span {c} = Ideal.span {d}) :
    ∃ u : Rˣ, d = u * c ∧ d ∈ nonZeroDivisors R := by
  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp (h ▸ Ideal.mem_span_singleton_self c)
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp (h.symm ▸ Ideal.mem_span_singleton_self d)
  have hvw : (v * w) * c = 1 * c := by
    rw [one_mul, mul_assoc, hw, hv]
  have h1 : v * w = 1 := (mul_cancel_right_mem_nonZeroDivisors hc).mp hvw
  have h1' : w * v = 1 := by rw [mul_comm]; exact h1
  refine ⟨⟨w, v, h1', h1⟩, hw.symm, ?_⟩
  rw [← hw]
  exact mul_mem_nonZeroDivisors.mpr
    ⟨IsUnit.mem_nonZeroDivisors ⟨⟨w, v, h1', h1⟩, rfl⟩, hc⟩

/-- Powers of a nonzerodivisor are nonzerodivisors, as a submonoid inclusion. -/
lemma powers_le_nonZeroDivisors {r : R} (hr : r ∈ nonZeroDivisors R) :
    Submonoid.powers r ≤ nonZeroDivisors R := by
  rintro - ⟨n, rfl⟩
  exact pow_mem hr n

/-- A left factor of a nonzerodivisor is a nonzerodivisor. -/
lemma left_mem_nonZeroDivisors_of_mul {x y : R} (h : x * y ∈ nonZeroDivisors R) :
    x ∈ nonZeroDivisors R := by
  obtain ⟨h1, h2⟩ := mem_nonZeroDivisors_iff.mp h
  refine mem_nonZeroDivisors_iff.mpr ⟨fun z hz ↦ ?_, fun z hz ↦ ?_⟩
  · exact h1 z (by rw [show x * y * z = x * z * y by ring, hz, zero_mul])
  · exact h2 z (by rw [show z * (x * y) = z * x * y by ring, hz, zero_mul])

/-- Nonzerodivisors map to nonzerodivisors under bijective ring homomorphisms. -/
lemma map_mem_nonZeroDivisors_of_bijective {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (hf : Function.Bijective f) {c : A} (hc : c ∈ nonZeroDivisors A) :
    f c ∈ nonZeroDivisors B := by
  rw [mem_nonZeroDivisors_iff] at hc ⊢
  refine ⟨fun z hz ↦ ?_, fun z hz ↦ ?_⟩ <;> obtain ⟨z, rfl⟩ := hf.2 z
  · have h0 : c * z = 0 := hf.1 (by rw [map_mul, map_zero]; exact hz)
    rw [hc.1 z h0, map_zero]
  · have h0 : z * c = 0 := hf.1 (by rw [map_mul, map_zero]; exact hz)
    rw [hc.2 z h0, map_zero]

/-- The image of a nonzerodivisor in a localization away from an element is a
nonzerodivisor. -/
lemma IsLocalization.Away.algebraMap_mem_nonZeroDivisors {S : Type u} [CommRing S]
    (g : R) [Algebra R S] [IsLocalization.Away g S] {r : R}
    (hr : r ∈ nonZeroDivisors R) : algebraMap R S r ∈ nonZeroDivisors S := by
  have main : ∀ z : S, z * algebraMap R S r = 0 → z = 0 := by
    intro z hz
    obtain ⟨⟨s, m⟩, hsm⟩ := IsLocalization.surj (M := Submonoid.powers g) z
    have hs0 : algebraMap R S (s * r) = 0 := by
      rw [map_mul, ← hsm,
        show z * algebraMap R S (m : R) * algebraMap R S r =
          z * algebraMap R S r * algebraMap R S (m : R) by ring, hz, zero_mul]
    obtain ⟨c, hc⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers g) (S := S) _).mp hs0
    have hcs : (c : R) * s = 0 := (mem_nonZeroDivisors_iff.mp hr).2 _
      (by rw [show (c : R) * s * r = (c : R) * (s * r) by ring, hc])
    have hzs : algebraMap R S s = 0 :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers g) (S := S) s).mpr ⟨c, hcs⟩
    have hzm : z * algebraMap R S (m : R) = 0 := by rw [hsm, hzs]
    exact (IsLocalization.map_units S m).mul_right_cancel (by rw [hzm, zero_mul])
  exact mem_nonZeroDivisors_iff.mpr
    ⟨fun z hz ↦ main z (by rw [mul_comm]; exact hz), main⟩

/-- Multiplication by `C s` for a nonzerodivisor `s` is injective on polynomials. -/
lemma Polynomial.eq_zero_of_C_nonZeroDivisor_mul {A : Type u} [CommRing A] {s : A}
    (hs : s ∈ nonZeroDivisors A) {p : A[X]} (h : Polynomial.C s * p = 0) : p = 0 := by
  ext k
  have hk := congrArg (fun q : A[X] ↦ q.coeff k) h
  simp only [Polynomial.coeff_C_mul, Polynomial.coeff_zero] at hk
  simpa using (mem_nonZeroDivisors_iff.mp hs).1 _ hk

end RingLemmas

section ChartRingLift

/-! ### The universal property of the chart rings

For a ring map `φ : A →+* R` such that `φ a` is a nonzerodivisor and the extension of
`I₀` along `φ` is contained in `(φ a)`, we construct the induced map from the
`a`-chart ring of the blow-up of `I₀` to `R`. The construction passes through the
localization of `R` away from `φ a` (into which `R` embeds since `φ a` is a
nonzerodivisor): the Rees algebra evaluates there via `X ↦ φ(a)⁻¹`, and the image of
the chart ring lands in the image of `R`. -/

namespace AffineBlowup

variable {A : Type u} [CommRing A] (I₀ : Ideal A) {R : Type u} [CommRing R]
  (φ : A →+* R) {a : A}

/-- Evaluation of the Rees algebra in the localization of `R` away from `φ a`,
sending a monomial `g·Xⁿ` to `φ(g)·φ(a)⁻ⁿ`. -/
def chartLiftEval (a : A) : reesAlgebra I₀ →+* Localization.Away (φ a) :=
  (Polynomial.eval₂RingHom ((algebraMap R (Localization.Away (φ a))).comp φ)
    (IsLocalization.Away.invSelf (φ a))).comp (SubringClass.subtype (reesAlgebra I₀))

lemma chartLiftEval_apply (a : A) (z : reesAlgebra I₀) :
    chartLiftEval I₀ φ a z = Polynomial.eval₂ ((algebraMap R (Localization.Away (φ a))).comp φ)
      (IsLocalization.Away.invSelf (φ a)) (z : A[X]) :=
  rfl

lemma chartLiftEval_reesMonomial {n : ℕ} {g : A} (hg : g ∈ I₀ ^ n) :
    chartLiftEval I₀ φ a (reesMonomial I₀ g hg) =
      algebraMap R (Localization.Away (φ a)) (φ g) *
        IsLocalization.Away.invSelf (φ a) ^ n := by
  rw [chartLiftEval_apply, coe_reesMonomial, Polynomial.eval₂_monomial, RingHom.comp_apply]

lemma chartLiftEval_reesX (ha : a ∈ I₀) :
    chartLiftEval I₀ φ a (reesX I₀ a ha) = 1 := by
  rw [chartLiftEval_apply, coe_reesX, Polynomial.eval₂_monomial, RingHom.comp_apply, pow_one,
    IsLocalization.Away.mul_invSelf]

lemma chartLiftEval_reesGradingZero (x : A) :
    chartLiftEval I₀ φ a ((reesGradingZero I₀ x : reesGrading I₀ 0) : reesAlgebra I₀) =
      algebraMap R (Localization.Away (φ a)) (φ x) := by
  rw [chartLiftEval_apply, coe_reesGradingZero_apply, Polynomial.eval₂_C, RingHom.comp_apply]

lemma isUnit_chartLiftEval_reesX (ha : a ∈ I₀) :
    IsUnit (chartLiftEval I₀ φ a (reesX I₀ a ha)) := by
  rw [chartLiftEval_reesX]
  exact isUnit_one

/-- The lift of the chart ring to the localization of `R` away from `φ a`, sending
`g/aⁿ` to `φ(g)·φ(a)⁻ⁿ`. -/
def chartLiftLoc (ha : a ∈ I₀) :
    HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha) →+*
      Localization.Away (φ a) :=
  (Localization.awayLift (chartLiftEval I₀ φ a) (reesX I₀ a ha)
    (isUnit_chartLiftEval_reesX I₀ φ ha)).comp
    (algebraMap (HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha))
      (Localization.Away (reesX I₀ a ha)))

lemma chartLiftLoc_mk (ha : a ∈ I₀) (n : ℕ) (y : reesAlgebra I₀)
    (hy : y ∈ reesGrading I₀ (n • 1)) :
    chartLiftLoc I₀ φ ha
        (HomogeneousLocalization.Away.mk (reesGrading I₀) (reesX_mem I₀ a ha) n y hy) =
      chartLiftEval I₀ φ a y := by
  have h1 : chartLiftEval I₀ φ a (reesX I₀ a ha) * 1 = 1 := by
    rw [mul_one, chartLiftEval_reesX]
  calc chartLiftLoc I₀ φ ha
        (HomogeneousLocalization.Away.mk (reesGrading I₀) (reesX_mem I₀ a ha) n y hy)
      = Localization.awayLift (chartLiftEval I₀ φ a) (reesX I₀ a ha)
          (isUnit_iff_exists_inv.mpr ⟨1, h1⟩)
          (Localization.mk y ⟨reesX I₀ a ha ^ n, n, rfl⟩) := by
        rw [chartLiftLoc, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk]
    _ = chartLiftEval I₀ φ a y * 1 ^ n := Localization.awayLift_mk _ _ y 1 h1 n
    _ = chartLiftEval I₀ φ a y := by rw [one_pow, mul_one]

lemma chartLiftLoc_awayAlgebraMap (ha : a ∈ I₀) (x : A) :
    chartLiftLoc I₀ φ ha (awayAlgebraMap I₀ (reesX I₀ a ha) x) =
      algebraMap R (Localization.Away (φ a)) (φ x) := by
  have h1 : (awayAlgebraMap I₀ (reesX I₀ a ha) x).val =
      Localization.mk ((reesGradingZero I₀ x : reesGrading I₀ 0) : reesAlgebra I₀) 1 :=
    val_awayAlgebraMap _ x
  calc chartLiftLoc I₀ φ ha (awayAlgebraMap I₀ (reesX I₀ a ha) x)
      = Localization.awayLift (chartLiftEval I₀ φ a) (reesX I₀ a ha)
          (isUnit_chartLiftEval_reesX I₀ φ ha)
          (algebraMap (reesAlgebra I₀) (Localization.Away (reesX I₀ a ha))
            ((reesGradingZero I₀ x : reesGrading I₀ 0) : reesAlgebra I₀)) := by
        rw [chartLiftLoc, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, h1,
          Localization.mk_one_eq_algebraMap]
    _ = chartLiftEval I₀ φ a ((reesGradingZero I₀ x : reesGrading I₀ 0) : reesAlgebra I₀) :=
        IsLocalization.Away.lift_eq _ _ _
    _ = algebraMap R (Localization.Away (φ a)) (φ x) := chartLiftEval_reesGradingZero I₀ φ x

variable {I₀ φ}

/-- The image of the chart-ring lift in the localization lies in the image of `R`:
the numerator of a chart fraction is divisible by the corresponding power of `φ a`. -/
lemma chartLiftLoc_mem_range (ha : a ∈ I₀) (hspan : I₀.map φ ≤ Ideal.span {φ a})
    (z : HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha)) :
    chartLiftLoc I₀ φ ha z ∈ (algebraMap R (Localization.Away (φ a))).range := by
  obtain ⟨n, y, hy, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective (reesGrading I₀) (reesX_mem I₀ a ha) z
  obtain ⟨g, hg, rfl⟩ := (mem_reesGrading_iff_exists I₀).mp hy
  rw [chartLiftLoc_mk, chartLiftEval_reesMonomial]
  have hpow : (I₀ ^ (n • 1)).map φ ≤ Ideal.span {φ a ^ (n • 1)} := by
    rw [Ideal.map_pow, ← Ideal.span_singleton_pow]
    exact Ideal.pow_right_mono hspan _
  obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp (hpow (Ideal.mem_map_of_mem φ hg))
  refine ⟨s, ?_⟩
  rw [← hs, map_mul, map_pow,
    show algebraMap R (Localization.Away (φ a)) s *
        algebraMap R (Localization.Away (φ a)) (φ a) ^ (n • 1) *
        IsLocalization.Away.invSelf (φ a) ^ (n • 1) =
      algebraMap R (Localization.Away (φ a)) s *
        (algebraMap R (Localization.Away (φ a)) (φ a) *
          IsLocalization.Away.invSelf (φ a)) ^ (n • 1) by ring,
    IsLocalization.Away.mul_invSelf, one_pow, mul_one]

/-- **The universal property of the blow-up chart ring**: for `φ : A →+* R` with `φ a`
a nonzerodivisor whose span contains the extension of `I₀`, the induced ring map from
the `a`-chart ring of the blow-up of `I₀`, sending `g/aⁿ` to the unique solution `y` of
`y·φ(a)ⁿ = φ(g)`. -/
def chartRingLift (ha : a ∈ I₀) (hnzd : φ a ∈ nonZeroDivisors R)
    (hspan : I₀.map φ ≤ Ideal.span {φ a}) :
    HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha) →+* R :=
  ((RingEquiv.ofLeftInverse
      ((IsLocalization.injective (M := Submonoid.powers (φ a))
        (Localization.Away (φ a))
        (powers_le_nonZeroDivisors hnzd)).hasLeftInverse.choose_spec)).symm.toRingHom.comp
    (Subring.inclusion (fun x hx ↦ by
      obtain ⟨z, rfl⟩ := hx
      exact chartLiftLoc_mem_range ha hspan z))).comp
    (chartLiftLoc I₀ φ ha).rangeRestrict

/-- The defining property of `chartRingLift`: composed with the embedding of `R` in
its localization away from `φ a`, it is the localization lift. -/
lemma algebraMap_chartRingLift (ha : a ∈ I₀) (hnzd : φ a ∈ nonZeroDivisors R)
    (hspan : I₀.map φ ≤ Ideal.span {φ a})
    (z : HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha)) :
    algebraMap R (Localization.Away (φ a)) (chartRingLift ha hnzd hspan z) =
      chartLiftLoc I₀ φ ha z := by
  let e := RingEquiv.ofLeftInverse
      ((IsLocalization.injective (M := Submonoid.powers (φ a))
        (Localization.Away (φ a))
        (powers_le_nonZeroDivisors hnzd)).hasLeftInverse.choose_spec)
  have h1 : algebraMap R (Localization.Away (φ a)) (chartRingLift ha hnzd hspan z) =
      ((e (e.symm ⟨chartLiftLoc I₀ φ ha z, chartLiftLoc_mem_range ha hspan z⟩)) :
        Localization.Away (φ a)) := rfl
  rw [h1, e.apply_symm_apply]

/-- The chart-ring lift restricts to `φ` on the base. -/
lemma chartRingLift_awayAlgebraMap (ha : a ∈ I₀) (hnzd : φ a ∈ nonZeroDivisors R)
    (hspan : I₀.map φ ≤ Ideal.span {φ a}) (x : A) :
    chartRingLift ha hnzd hspan (awayAlgebraMap I₀ (reesX I₀ a ha) x) = φ x := by
  apply IsLocalization.injective (M := Submonoid.powers (φ a)) (Localization.Away (φ a))
    (powers_le_nonZeroDivisors hnzd)
  rw [algebraMap_chartRingLift, chartLiftLoc_awayAlgebraMap]

/-- The chart-ring lift restricts to `φ` on the base, composition form. -/
lemma chartRingLift_comp_awayAlgebraMap (ha : a ∈ I₀) (hnzd : φ a ∈ nonZeroDivisors R)
    (hspan : I₀.map φ ≤ Ideal.span {φ a}) :
    (chartRingLift ha hnzd hspan).comp (awayAlgebraMap I₀ (reesX I₀ a ha)) = φ :=
  RingHom.ext fun x ↦ chartRingLift_awayAlgebraMap ha hnzd hspan x

end AffineBlowup

end ChartRingLift

section ChartRingExt

/-! ### Extensionality for ring maps out of chart rings

Two ring maps out of the chart ring at a homogeneous element `t = τ·Xᵈ` of the Rees
algebra that agree on the base and take a nonzerodivisor value on `τ` are equal: every
chart fraction `g/τⁿ` satisfies `(g/τⁿ)·τⁿ = g`, and division by the nonzerodivisor
image of `τ` is unique. -/

namespace AffineBlowup

variable {A : Type u} [CommRing A] (I₀ : Ideal A)

/-- The generalized chart-fraction division identity on the chart at a homogeneous
element `t = τ·Xᵈ`: the fraction `y/tⁿ` multiplied by `τⁿ` is the numerator
coefficient of `y`. -/
lemma away_mk_mul_awayAlgebraMap_pow {d n : ℕ} {t : reesAlgebra I₀}
    (ht : t ∈ reesGrading I₀ d) {τ : A} (htτ : (t : A[X]) = Polynomial.monomial d τ)
    {y : reesAlgebra I₀} (hy : y ∈ reesGrading I₀ (n • d)) {g : A}
    (hyg : (y : A[X]) = Polynomial.monomial (n • d) g) :
    HomogeneousLocalization.Away.mk (reesGrading I₀) ht n y hy *
        awayAlgebraMap I₀ t τ ^ n =
      awayAlgebraMap I₀ t g := by
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.val_pow, val_awayAlgebraMap, val_awayAlgebraMap,
    HomogeneousLocalization.Away.val_mk, Localization.mk_pow, Localization.mk_mul,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  apply Subtype.ext
  push_cast [htτ, hyg, coe_reesGradingZero_apply]
  simp only [one_mul, smul_eq_mul, one_pow, mul_one, ← Polynomial.C_pow,
    Polynomial.monomial_pow, Polynomial.monomial_mul_C]
  rw [mul_comm n d, mul_comm g (τ ^ n)]

/-- **Extensionality on chart rings**: two ring maps out of the chart ring at a
homogeneous element `t = τ·Xᵈ` agreeing on the base, one of which maps `τ` to a
nonzerodivisor, are equal. -/
lemma chartRingHom_ext {R : Type u} [CommRing R] {d : ℕ} {t : reesAlgebra I₀}
    (ht : t ∈ reesGrading I₀ d) {τ : A} (htτ : (t : A[X]) = Polynomial.monomial d τ)
    {ψ₁ ψ₂ : HomogeneousLocalization.Away (reesGrading I₀) t →+* R}
    (hcomp : ψ₁.comp (awayAlgebraMap I₀ t) = ψ₂.comp (awayAlgebraMap I₀ t))
    (hnzd : ψ₁ (awayAlgebraMap I₀ t τ) ∈ nonZeroDivisors R) :
    ψ₁ = ψ₂ := by
  have hφ : ∀ x : A, ψ₁ (awayAlgebraMap I₀ t x) = ψ₂ (awayAlgebraMap I₀ t x) :=
    fun x ↦ RingHom.congr_fun hcomp x
  ext z
  obtain ⟨n, y, hy, rfl⟩ := HomogeneousLocalization.Away.mk_surjective (reesGrading I₀) ht z
  obtain ⟨g, hg, rfl⟩ := (mem_reesGrading_iff_exists I₀).mp hy
  have hkey := away_mk_mul_awayAlgebraMap_pow I₀ ht htτ hy (coe_reesMonomial I₀ g hg)
  have h₁ := congrArg ψ₁ hkey
  have h₂ := congrArg ψ₂ hkey
  rw [map_mul, map_pow] at h₁ h₂
  have hend : ψ₁ (HomogeneousLocalization.Away.mk (reesGrading I₀) ht n
        (reesMonomial I₀ g hg) hy) * ψ₁ (awayAlgebraMap I₀ t τ) ^ n =
      ψ₂ (HomogeneousLocalization.Away.mk (reesGrading I₀) ht n
        (reesMonomial I₀ g hg) hy) * ψ₁ (awayAlgebraMap I₀ t τ) ^ n := by
    rw [h₁, hφ g, ← h₂, hφ τ]
  exact (mul_cancel_right_mem_nonZeroDivisors (pow_mem hnzd n)).mp hend

end AffineBlowup

end ChartRingExt

section NonZeroDivisorTransfer

namespace AffineBlowup

variable {A : Type u} [CommRing A] (I₀ : Ideal A)

/-- **The chart section map preserves nonzerodivisors**: the image in the `a`-chart
ring of a nonzerodivisor of the base is a nonzerodivisor. This does not generalize
`isRegular_awayAlgebraMap_reesX`, which places no hypothesis on `a`: the two overlap
only in the case `s = a` with `a` itself a nonzerodivisor of `A`. -/
theorem awayAlgebraMap_mem_nonZeroDivisors_of_mem {a : A} (ha : a ∈ I₀) {s : A}
    (hs : s ∈ nonZeroDivisors A) :
    awayAlgebraMap I₀ (reesX I₀ a ha) s ∈
      nonZeroDivisors (HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha)) := by
  suffices main : ∀ z : HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha),
      z * awayAlgebraMap I₀ (reesX I₀ a ha) s = 0 → z = 0 by
    exact mem_nonZeroDivisors_iff.mpr
      ⟨fun z hz ↦ main z ((mul_comm z (awayAlgebraMap I₀ (reesX I₀ a ha) s)).trans hz), main⟩
  intro z hz
  obtain ⟨n, y, hy, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective (reesGrading I₀) (reesX_mem I₀ a ha) z
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.Away.val_mk, val_awayAlgebraMap,
    HomogeneousLocalization.val_zero, Localization.mk_mul, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_zero_iff] at hz
  obtain ⟨⟨-, k, rfl⟩, hk⟩ := hz
  rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk,
    HomogeneousLocalization.val_zero, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_zero_iff]
  refine ⟨⟨reesX I₀ a ha ^ k, k, rfl⟩, Subtype.ext ?_⟩
  have hcoe := congrArg (fun p : reesAlgebra I₀ ↦ (p : A[X])) hk
  simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, coe_reesX,
    coe_reesGradingZero_apply, ZeroMemClass.coe_zero] at hcoe ⊢
  have hCs : Polynomial.C s * ((Polynomial.monomial 1 a : A[X]) ^ k * (y : A[X])) = 0 := by
    calc Polynomial.C s * ((Polynomial.monomial 1 a : A[X]) ^ k * (y : A[X]))
        = (Polynomial.monomial 1 a : A[X]) ^ k * ((y : A[X]) * Polynomial.C s) := by ring
      _ = 0 := hcoe
  exact Polynomial.eq_zero_of_C_nonZeroDivisor_mul hs hCs

end AffineBlowup

end NonZeroDivisorTransfer

section ComapAffineLocality

/-! ### Affine opens adapted to a morphism

Multiplicativity of the inverse image ideal sheaf (`Scheme.IdealSheafData.comap_mul`,
`Scheme.IdealSheafData.comap_pow`) lives in
`WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Functorial`. -/

variable {Y X : Scheme.{u}}

/-- Every point of `Y` lies in an affine open contained in the preimage of an affine
open of `X`. -/
lemma exists_affineOpens_le_preimage (f : Y ⟶ X) (y : Y) :
    ∃ (V : X.affineOpens) (W : Y.affineOpens), W.1 ≤ f ⁻¹ᵁ V.1 ∧ y ∈ W.1 := by
  have hfy : f y ∈ (⊤ : X.Opens) := trivial
  rw [← iSup_affineOpens_eq_top X] at hfy
  obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.mp hfy
  obtain ⟨-, ⟨W₀, hW₀, rfl⟩, hyW₀, hsub⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (show y ∈ ((f ⁻¹ᵁ V.1 : Y.Opens) : Set Y) from hV) (f ⁻¹ᵁ V.1).isOpen
  exact ⟨V, ⟨W₀, hW₀⟩, fun z hz ↦ hsub hz, hyW₀⟩

end ComapAffineLocality

section InvertibleKit

/-! ### The invertible-ideal lemma kit

Local presentations of invertible ideal sheaves on a basis of affine opens, and
stability of invertibility under products, factors of products, and pullback along
blow-up maps. -/

variable {Y : Scheme.{u}}

namespace Scheme.IdealSheafData.IsInvertible
/-- A span-nonzerodivisor presentation of an ideal sheaf on an affine open restricts to
a span-nonzerodivisor presentation on any of its affine basic opens. -/
theorem presentation_restrict_basicOpen {K : Y.IdealSheafData} {U : Y.affineOpens}
    {c : Γ(Y, U.1)} (hc : c ∈ nonZeroDivisors Γ(Y, U.1))
    (hgen : K.ideal U = Ideal.span {c}) (g : Γ(Y, U.1)) (W : Y.affineOpens)
    (hW : W = Y.affineBasicOpen g) :
    ∃ c' ∈ nonZeroDivisors Γ(Y, W.1), K.ideal W = Ideal.span {c'} := by
  subst hW
  change ∃ c' ∈ nonZeroDivisors Γ(Y, Y.basicOpen g),
    K.ideal (Y.affineBasicOpen g) = Ideal.span {c'}
  have : IsLocalization.Away g Γ(Y, Y.basicOpen g) := U.2.isLocalization_basicOpen g
  have halg : algebraMap Γ(Y, U.1) Γ(Y, Y.basicOpen g) =
      (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom :=
    RingHom.algebraMap_toAlgebra _
  refine ⟨algebraMap Γ(Y, U.1) Γ(Y, Y.basicOpen g) c,
    IsLocalization.Away.algebraMap_mem_nonZeroDivisors g hc, ?_⟩
  have hres : (K.ideal U).map
      ((Y.presheaf.map (homOfLE (X := Y.Opens)
        (show (Y.affineBasicOpen g : Y.Opens) ≤ U.1 from Y.affineBasicOpen_le g)).op).hom) =
      K.ideal (Y.affineBasicOpen g) :=
    K.map_ideal (Y.affineBasicOpen_le g)
  rw [← hres, hgen, Ideal.map_span, Set.image_singleton, halg]
  rfl

/-- **Presentations of an invertible ideal exist on a basis**: near any point
and inside any open neighbourhood of it, there is an affine open on which the ideal is
generated by a single nonzerodivisor. -/
theorem exists_presentation_le {K : Y.IdealSheafData} (hK : K.IsInvertible)
    {y : Y} {O : Y.Opens} (hy : y ∈ O) :
    ∃ W : Y.affineOpens, y ∈ W.1 ∧ W.1 ≤ O ∧
      ∃ c ∈ nonZeroDivisors Γ(Y, W.1), K.ideal W = Ideal.span {c} := by
  obtain ⟨U, hyU, c₀, hc₀, hgen⟩ := hK y
  obtain ⟨g, hgle, hyg⟩ := U.2.exists_basicOpen_le (V := O) ⟨y, hy⟩ hyU
  obtain ⟨c', hc', hgen'⟩ := presentation_restrict_basicOpen hc₀ hgen g
    (Y.affineBasicOpen g) rfl
  exact ⟨Y.affineBasicOpen g, hyg, hgle, c', hc', hgen'⟩

/-- Products of invertible ideals are invertible. -/
theorem mul {K₁ K₂ : Y.IdealSheafData} (h₁ : K₁.IsInvertible)
    (h₂ : K₂.IsInvertible) : (K₁ * K₂).IsInvertible := by
  intro y
  obtain ⟨W₁, hyW₁, -, c₁, hc₁, hgen₁⟩ :=
    h₁.exists_presentation_le (O := ⊤) (trivial : y ∈ (⊤ : Y.Opens))
  obtain ⟨W₂, hyW₂, -, c₂, hc₂, hgen₂⟩ := h₂.exists_presentation_le (O := W₁.1) hyW₁
  obtain ⟨f₁, f₂, hff, hyf⟩ := exists_basicOpen_le_affine_inter W₁.2 W₂.2 y ⟨hyW₁, hyW₂⟩
  obtain ⟨c₁', hc₁', hgen₁'⟩ := presentation_restrict_basicOpen hc₁ hgen₁ f₁
    (Y.affineBasicOpen f₁) rfl
  obtain ⟨c₂', hc₂', hgen₂'⟩ := presentation_restrict_basicOpen hc₂ hgen₂ f₂
    (Y.affineBasicOpen f₁) (Subtype.ext hff)
  refine ⟨Y.affineBasicOpen f₁, hyf, c₁' * c₂',
    mul_mem_nonZeroDivisors.mpr ⟨hc₁', hc₂'⟩, ?_⟩
  have hmul : (K₁ * K₂).ideal (Y.affineBasicOpen f₁) =
      K₁.ideal (Y.affineBasicOpen f₁) * K₂.ideal (Y.affineBasicOpen f₁) := by
    rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply]
  rw [hmul, hgen₁', hgen₂', Ideal.span_singleton_mul_span_singleton]

/-- **Factor of an invertible product ideal, ring form** (the algebraic core of Stacks
Project Tag 080A): if `J₁ * J₂ = (c)` with `c` a nonzerodivisor, there are finitely
many elements `tᵢ` generating the unit ideal and elements `aᵢ ∈ J₁` such that in every
localization away from `tᵢ`, the extension of `J₁` is generated by the nonzerodivisor
image of `aᵢ`. -/
theorem _root_.AlgebraicGeometry.exists_span_eq_top_localization_factor_span
    {R : Type u} [CommRing R] {J₁ J₂ : Ideal R} {c : R} (hc : c ∈ nonZeroDivisors R)
    (hmul : J₁ * J₂ = Ideal.span {c}) :
    ∃ (n : ℕ) (a t : Fin n → R), (∀ i, a i ∈ J₁) ∧ Ideal.span (Set.range t) = ⊤ ∧
      ∀ (i : Fin n) (S : Type u) [CommRing S] [Algebra R S]
        [IsLocalization.Away (t i) S],
        algebraMap R S (a i) ∈ nonZeroDivisors S ∧
        J₁.map (algebraMap R S) = Ideal.span {algebraMap R S (a i)} := by
  classical
  -- a finite representation `c = ∑ eᵢ · aᵢ · bᵢ` with `aᵢ ∈ J₁`, `bᵢ ∈ J₂`
  have hcmem : c ∈ J₁ * J₂ := by rw [hmul]; exact Ideal.mem_span_singleton_self c
  obtain ⟨T, T', hT, hT', hcspan⟩ := Submodule.mem_span_mul_finite_of_mem_mul hcmem
  obtain ⟨n, e, u, hu⟩ := Submodule.mem_span_set'.mp hcspan
  have hmem : ∀ i, ∃ (x y : R), x ∈ J₁ ∧ y ∈ J₂ ∧ x * y = (u i : R) := by
    intro i
    obtain ⟨x, hx, y, hy, hxy⟩ := Set.mem_mul.mp (u i).2
    exact ⟨x, y, hT hx, hT' hy, hxy⟩
  choose x y hxJ hyJ hxy using hmem
  -- the elements `aᵢ := x i` with coefficients `eᵢ`; the quotients `tᵢ`
  have hquot : ∀ i, ∃ t : R, t * c = e i * (x i * y i) := by
    intro i
    have : e i * (x i * y i) ∈ J₁ * J₂ := Ideal.mul_mem_left _ _
      (Ideal.mul_mem_mul (hxJ i) (hyJ i))
    rw [hmul] at this
    exact Ideal.mem_span_singleton'.mp this
  choose t ht using hquot
  refine ⟨n, x, t, hxJ, ?_, ?_⟩
  · -- `∑ tᵢ = 1`, so the `tᵢ` generate the unit ideal
    have hsum : (∑ i, t i) * c = 1 * c := by
      rw [one_mul, Finset.sum_mul]
      calc ∑ i, t i * c = ∑ i, e i * (x i * y i) := Finset.sum_congr rfl fun i _ ↦ ht i
        _ = ∑ i, e i • (u i : R) := by
            refine Finset.sum_congr rfl fun i _ ↦ ?_
            rw [smul_eq_mul, hxy i]
        _ = c := hu
    have hone : (∑ i, t i) = 1 := (mul_cancel_right_mem_nonZeroDivisors hc).mp hsum
    rw [eq_top_iff]
    intro r _
    have : r * ∑ i, t i ∈ Ideal.span (Set.range t) := by
      rw [Finset.mul_sum]
      exact Ideal.sum_mem _ fun i _ ↦
        Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    rwa [hone, mul_one] at this
  · intro i S _ _ _
    have hunit : IsUnit (algebraMap R S (t i)) := IsLocalization.Away.algebraMap_isUnit (t i)
    have hcnzd : algebraMap R S c ∈ nonZeroDivisors S :=
      IsLocalization.Away.algebraMap_mem_nonZeroDivisors (t i) hc
    have hxnzd : algebraMap R S (x i) ∈ nonZeroDivisors S := by
      -- `x i * (e i * y i) = t i * c` is a nonzerodivisor
      have hprod : algebraMap R S (x i) * algebraMap R S (e i * y i) ∈ nonZeroDivisors S := by
        have hxi : x i * (e i * y i) = t i * c := by rw [ht i]; ring
        rw [← map_mul, hxi, map_mul]
        exact mul_mem_nonZeroDivisors.mpr ⟨hunit.mem_nonZeroDivisors, hcnzd⟩
      exact left_mem_nonZeroDivisors_of_mul hprod
    refine ⟨hxnzd, le_antisymm (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_) ?_⟩
    · -- every element of `J₁` is a multiple of `x i` after inverting `t i`
      rw [Ideal.mem_comap, Ideal.mem_span_singleton']
      obtain ⟨s, hs⟩ : ∃ s : R, s * c = r * (e i * y i) := by
        refine Ideal.mem_span_singleton'.mp ?_
        rw [← hmul]
        exact Ideal.mul_mem_mul hr (Ideal.mul_mem_left _ _ (hyJ i))
      -- `r * t i = x i * s` after cancelling `c`
      have hkey : (r * t i) * c = (x i * s) * c := by
        calc (r * t i) * c = r * (t i * c) := by ring
          _ = r * (e i * (x i * y i)) := by rw [ht i]
          _ = x i * (r * (e i * y i)) := by ring
          _ = x i * (s * c) := by rw [← hs]
          _ = (x i * s) * c := by ring
      have hrt : r * t i = x i * s := (mul_cancel_right_mem_nonZeroDivisors hc).mp hkey
      refine ⟨(hunit.unit⁻¹ : Sˣ) * algebraMap R S s, ?_⟩
      have hmap : algebraMap R S r * algebraMap R S (t i) =
          algebraMap R S (x i) * algebraMap R S s := by
        rw [← map_mul, ← map_mul, hrt]
      calc (hunit.unit⁻¹ : Sˣ) * algebraMap R S s * algebraMap R S (x i)
          = ((hunit.unit⁻¹ : Sˣ) : S) * (algebraMap R S (x i) * algebraMap R S s) := by ring
        _ = ((hunit.unit⁻¹ : Sˣ) : S) * (algebraMap R S r * algebraMap R S (t i)) := by
            rw [hmap]
        _ = algebraMap R S r * (algebraMap R S (t i) * ((hunit.unit⁻¹ : Sˣ) : S)) := by ring
        _ = algebraMap R S r := by rw [IsUnit.mul_val_inv, mul_one]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ (hxJ i)

/-- **A factor of an invertible product ideal is invertible** (Stacks Project
Tag 080A). -/
theorem of_mul_left {K₁ K₂ : Y.IdealSheafData} (h : (K₁ * K₂).IsInvertible) :
    K₁.IsInvertible := by
  intro y
  obtain ⟨U, hyU, c, hc, hgen⟩ := h y
  have hmulU : K₁.ideal U * K₂.ideal U = Ideal.span {c} := by
    have h1 : (K₁ * K₂).ideal U = K₁.ideal U * K₂.ideal U := by
      rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply]
    rw [← h1, hgen]
  obtain ⟨n, a, t, haJ, htop, hloc⟩ :=
    AlgebraicGeometry.exists_span_eq_top_localization_factor_span hc hmulU
  have hcov : U.1 ≤ ⨆ f : Set.range t, Y.basicOpen f.1 :=
    (U.2.self_le_iSup_basicOpen_iff (s := Set.range t)).mpr htop
  obtain ⟨⟨v, i, rfl⟩, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcov hyU)
  have : IsLocalization.Away (t i) Γ(Y, Y.basicOpen (t i)) :=
    U.2.isLocalization_basicOpen (t i)
  obtain ⟨hnzd, hspan⟩ := hloc i Γ(Y, Y.basicOpen (t i))
  refine ⟨Y.affineBasicOpen (t i), hyi,
    algebraMap Γ(Y, U.1) Γ(Y, Y.basicOpen (t i)) (a i), hnzd, ?_⟩
  have halg : algebraMap Γ(Y, U.1) Γ(Y, Y.basicOpen (t i)) =
      (Y.presheaf.map (homOfLE (Y.basicOpen_le (t i))).op).hom :=
    RingHom.algebraMap_toAlgebra _
  have hres : (K₁.ideal U).map
      ((Y.presheaf.map (homOfLE (X := Y.Opens)
        (show (Y.affineBasicOpen (t i) : Y.Opens) ≤ U.1 from
          Y.affineBasicOpen_le (t i))).op).hom) =
      K₁.ideal (Y.affineBasicOpen (t i)) :=
    K₁.map_ideal (Y.affineBasicOpen_le (t i))
  rw [← hres, ← halg, hspan]
  rfl

/-- A factor of an invertible product ideal is invertible, right version. -/
theorem of_mul_right {K₁ K₂ : Y.IdealSheafData} (h : (K₁ * K₂).IsInvertible) :
    K₂.IsInvertible :=
  of_mul_left (K₂ := K₁) (by rwa [mul_comm] at h)

/-- Membership in the nonzerodivisors transported along an equality of elements. -/
private lemma mem_nonZeroDivisors_of_eq {S : Type u} [CommRing S] {x y : S} (h : x = y)
    (hy : y ∈ nonZeroDivisors S) : x ∈ nonZeroDivisors S := by
  rw [h]; exact hy

/-- **The chart section map of the blow-up preserves nonzerodivisors.** Standalone
lemma with its own heartbeat budget: the chart ring is a large
`HomogeneousLocalization` type. -/
lemma _root_.AlgebraicGeometry.Scheme.IdealSheafData.blowupChartSection_mem_nonZeroDivisors
    (K : Y.IdealSheafData) (V : Y.affineOpens) {a : Γ(Y, V.1)} (ha : a ∈ K.ideal V)
    {s : Γ(Y, V.1)} (hs : s ∈ nonZeroDivisors Γ(Y, V.1)) :
    (K.blowupChartSection V ha).hom s ∈
      nonZeroDivisors Γ(Spec (.of (HomogeneousLocalization.Away (reesGrading (K.ideal V))
        (reesX (K.ideal V) a ha))), ⊤) := by
  have hbridge : (K.blowupChartSection V ha).hom s =
      (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
        (reesGrading (K.ideal V)) (reesX (K.ideal V) a ha)))).inv.hom
        (AffineBlowup.awayAlgebraMap (K.ideal V) (reesX (K.ideal V) a ha) s) := rfl
  refine mem_nonZeroDivisors_of_eq hbridge ?_
  exact map_mem_nonZeroDivisors_of_bijective _
    (ConcreteCategory.bijective_of_isIso _)
    (AffineBlowup.awayAlgebraMap_mem_nonZeroDivisors_of_mem (K.ideal V) ha hs)

/-- The chart probe of the blow-up evaluated at a point: the chart embedding of the
affine chart point. Standalone lemma so that the definitional unfolding of
`blowupChart` happens once, with a directed expected type. -/
lemma _root_.AlgebraicGeometry.Scheme.IdealSheafData.blowupChart_apply
    (K : Y.IdealSheafData) (V : Y.affineOpens) {a : Γ(Y, V.1)} (ha : a ∈ K.ideal V)
    (z : Spec (.of (HomogeneousLocalization.Away (reesGrading (K.ideal V))
      (reesX (K.ideal V) a ha)))) :
    K.blowupChart V ha z =
      K.blowupι V (AffineBlowup.chart (K.ideal V) (reesX (K.ideal V) a ha)
        (reesX_mem (K.ideal V) a ha) z) :=
  Scheme.Hom.comp_apply _ _ z

/-- Criterion for invertibility at a point through an affine open immersion probe: if
`w : Spec R ⟶ Y` is an open immersion whose range contains `x` and the pullback of `I'`
to `Spec R` is generated by a single nonzerodivisor, then `I'` is generated by a single
nonzerodivisor on an affine neighbourhood of `x`. -/
lemma _root_.AlgebraicGeometry.Scheme.IdealSheafData.exists_isRegularPrincipal_ideal_of_comap
    (I' : Y.IdealSheafData) {R : CommRingCat.{u}} (w : Spec R ⟶ Y) [IsOpenImmersion w]
    {x : Y} (hx : x ∈ Set.range w) (c : Γ(Spec R, ⊤))
    (hc : c ∈ nonZeroDivisors Γ(Spec R, ⊤))
    (hspan : (I'.comap w).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {c}) :
    ∃ V : Y.affineOpens, x ∈ V.1 ∧ (I'.ideal V).IsRegularPrincipal := by
  refine ⟨⟨w ''ᵁ ⊤, (isAffineOpen_top (Spec R)).image_of_isOpenImmersion w⟩, ?_, ?_⟩
  · obtain ⟨z, rfl⟩ := hx
    exact ⟨z, trivial, rfl⟩
  · have h1 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I' w
      ⟨⊤, isAffineOpen_top _⟩
    rw [hspan] at h1
    have hbij : Function.Bijective (w.appIso ⊤).inv.hom :=
      ConcreteCategory.bijective_of_isIso _
    refine ⟨(w.appIso ⊤).inv c, map_mem_nonZeroDivisors_of_bijective _ hbij hc, ?_⟩
    have h2 := Ideal.map_comap_of_surjective (w.appIso ⊤).inv.hom hbij.2
      (I'.ideal ⟨w ''ᵁ ⊤, (isAffineOpen_top (Spec R)).image_of_isOpenImmersion w⟩)
    rw [← h1] at h2
    rw [← h2, Ideal.map_span, Set.image_singleton]

/-- **The pullback of an invertible ideal along a blow-up map is invertible**: on the
`a`-chart of the blow-up, a local equation of the pulled-back ideal is the image of a
local equation downstairs, which stays a nonzerodivisor by
`AffineBlowup.awayAlgebraMap_mem_nonZeroDivisors_of_mem`. The chart rings of the
blow-up are large `HomogeneousLocalization` types, whence the raised heartbeat
limit. -/
theorem comap_blowupMap {C : Y.IdealSheafData} (hC : C.IsInvertible)
    (K : Y.IdealSheafData) : (C.comap K.blowupMap).IsInvertible := by
  intro ξ
  obtain ⟨V, hV, -, s, hs, hgen⟩ :=
    hC.exists_presentation_le (O := ⊤) (trivial : K.blowupMap ξ ∈ (⊤ : Y.Opens))
  have hx2 : ξ ∈ K.blowupMap ⁻¹ᵁ V.1 := hV
  rw [K.blowupMap_preimage V] at hx2
  obtain ⟨y, rfl⟩ := hx2
  have hy : y ∈ (⊤ : (AffineBlowup (K.ideal V)).Opens) := trivial
  rw [← AffineBlowup.iSup_basicOpen_reesX_eq_top (K.ideal V)] at hy
  obtain ⟨a, hy⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  rw [← AffineBlowup.opensRange_chart (K.ideal V) (reesX (K.ideal V) a.1 a.2)
    (reesX_mem (K.ideal V) a.1 a.2)] at hy
  obtain ⟨z, rfl⟩ := hy
  refine exists_isRegularPrincipal_ideal_of_comap (C.comap K.blowupMap)
    (K.blowupChart V a.2) ⟨z, K.blowupChart_apply V a.2 z⟩
    ((K.blowupChartSection V a.2).hom s) ?_ ?_
  · exact K.blowupChartSection_mem_nonZeroDivisors V a.2 hs
  · refine (Scheme.IdealSheafData.ideal_comap_comap_blowupChart K C V a.2).trans ?_
    refine (congrArg (fun J : Ideal Γ(Y, V.1) ↦
      J.map (K.blowupChartSection V a.2).hom) hgen).trans ?_
    exact (Ideal.map_span _ _).trans (congrArg Ideal.span Set.image_singleton)

end Scheme.IdealSheafData.IsInvertible

end InvertibleKit

section UniversalPropertyPreparation

/-! ### Preparation for the universal property

Generic factorization lemmas keeping the chart rings abstract: a `Spec`-level
associativity helper, factorization of chart ring maps through the chart-overlap
localization, and the induced span computation on the base. -/

/-- `Spec` of a composite ring map, composed with a further morphism: fully abstract
associativity helper, cheap to instantiate at chart rings. -/
lemma specMap_ofHom_comp_assoc {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    (ψ' : S →+* T) (m : R →+* S) {Z : Scheme.{u}} (C : Spec (CommRingCat.of R) ⟶ Z) :
    Spec.map (CommRingCat.ofHom (ψ'.comp m)) ≫ C =
      Spec.map (CommRingCat.ofHom ψ') ≫ (Spec.map (CommRingCat.ofHom m) ≫ C) := by
  rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]

/-- **Factoring a chart ring map through the chart-overlap localization**: a ring map
out of `A_{(f)}` sending the localization element `g^d/f^e` to a unit factors through
`A_{(fg)}`. -/
lemma _root_.HomogeneousLocalization.Away.exists_factor_of_isUnit {B : Type u} [CommRing B]
    {σ : Type*} [SetLike σ B] [AddSubgroupClass σ B] {𝒜 : ℕ → σ} [GradedRing 𝒜]
    {d e : ℕ} {f g : B} (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 e) {x : B} (hx : x = f * g)
    (hd : d ≠ 0) {R : Type u} [CommRing R]
    (ψ : HomogeneousLocalization.Away 𝒜 f →+* R)
    (hu : IsUnit (ψ (HomogeneousLocalization.Away.isLocalizationElem hf hg))) :
    ∃ ψ' : HomogeneousLocalization.Away 𝒜 x →+* R,
      ψ'.comp (HomogeneousLocalization.awayMap 𝒜 hg hx) = ψ := by
  let := (HomogeneousLocalization.awayMap 𝒜 hg hx).toAlgebra
  have : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem hf hg)
      (HomogeneousLocalization.Away 𝒜 x) :=
    HomogeneousLocalization.Away.isLocalization_mul hf hg hx hd
  refine ⟨IsLocalization.Away.lift (S := HomogeneousLocalization.Away 𝒜 x)
    (HomogeneousLocalization.Away.isLocalizationElem hf hg) hu, ?_⟩
  have h := IsLocalization.Away.lift_comp (S := HomogeneousLocalization.Away 𝒜 x)
    (x := HomogeneousLocalization.Away.isLocalizationElem hf hg) (g := ψ) hu
  rwa [RingHom.algebraMap_toAlgebra] at h

namespace AffineBlowup

variable {A : Type u} [CommRing A] (I₀ : Ideal A)

/-- A factorization through the chart-overlap localization is compatible with the
canonical maps from the base. -/
lemma comp_awayAlgebraMap_of_factor {t s x : reesAlgebra I₀} {e : ℕ}
    (hs : s ∈ reesGrading I₀ e) (hx : x = t * s) {R : Type u} [CommRing R]
    {ψ : HomogeneousLocalization.Away (reesGrading I₀) t →+* R}
    {ψ' : HomogeneousLocalization.Away (reesGrading I₀) x →+* R}
    (hfac : ψ'.comp (HomogeneousLocalization.awayMap (reesGrading I₀) hs hx) = ψ) :
    ψ'.comp (awayAlgebraMap I₀ x) = ψ.comp (awayAlgebraMap I₀ t) := by
  refine RingHom.ext fun r ↦ ?_
  change ψ' (awayAlgebraMap I₀ x r) = ψ (awayAlgebraMap I₀ t r)
  have h1 : awayAlgebraMap I₀ x r =
      HomogeneousLocalization.awayMap (reesGrading I₀) hs hx (awayAlgebraMap I₀ t r) :=
    (HomogeneousLocalization.awayMap_fromZeroRingHom (reesGrading I₀) hs hx
      (reesGradingZero I₀ r)).symm
  calc ψ' (awayAlgebraMap I₀ x r)
      = ψ' (HomogeneousLocalization.awayMap (reesGrading I₀) hs hx
          (awayAlgebraMap I₀ t r)) := congrArg ψ' h1
    _ = ψ (awayAlgebraMap I₀ t r) := RingHom.congr_fun hfac _

/-- The extension of `I₀` along a ring map that factors through the `a`-chart of the
blow-up is generated by the image of `a`. -/
lemma span_map_eq_of_comp_awayAlgebraMap {R : Type u} [CommRing R] {a : A} (ha : a ∈ I₀)
    {φ : A →+* R}
    {ψ : HomogeneousLocalization.Away (reesGrading I₀) (reesX I₀ a ha) →+* R}
    (hcomp : ψ.comp (awayAlgebraMap I₀ (reesX I₀ a ha)) = φ) :
    I₀.map φ = Ideal.span {φ a} := by
  calc I₀.map φ
      = (I₀.map (awayAlgebraMap I₀ (reesX I₀ a ha))).map ψ := by
        rw [Ideal.map_map, hcomp]
    _ = (Ideal.span {awayAlgebraMap I₀ (reesX I₀ a ha) a}).map ψ :=
        congrArg (Ideal.map ψ) (map_awayAlgebraMap_reesX_eq_span_singleton I₀ a ha)
    _ = Ideal.span {ψ (awayAlgebraMap I₀ (reesX I₀ a ha) a)} := by
        rw [Ideal.map_span, Set.image_singleton]
    _ = Ideal.span {φ a} := by
        have h2 : ψ (awayAlgebraMap I₀ (reesX I₀ a ha) a) = φ a := RingHom.congr_fun hcomp a
        rw [h2]

end AffineBlowup

variable {X T : Scheme.{u}}

-- The chart rings of the blow-up are large `HomogeneousLocalization` types; unifying
-- them exceeds the default heartbeat limit.
/-- **Chart capture**: a point of the blow-up over an affine open `V` of the base lies
in the range of a chart probe at some section `a ∈ I(V)`. -/
lemma Scheme.IdealSheafData.exists_mem_opensRange_blowupChart (I : X.IdealSheafData)
    (V : X.affineOpens) {ξ : I.blowup} (hξ : ξ ∈ I.blowupMap ⁻¹ᵁ V.1) :
    ∃ (a : Γ(X, V.1)) (ha : a ∈ I.ideal V), ξ ∈ (I.blowupChart V ha).opensRange := by
  rw [I.blowupMap_preimage V] at hξ
  obtain ⟨y, rfl⟩ := hξ
  have hy : y ∈ (⊤ : (AffineBlowup (I.ideal V)).Opens) := trivial
  rw [← AffineBlowup.iSup_basicOpen_reesX_eq_top (I.ideal V)] at hy
  obtain ⟨a, hy⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  rw [← AffineBlowup.opensRange_chart (I.ideal V) (reesX (I.ideal V) a.1 a.2)
    (reesX_mem (I.ideal V) a.1 a.2)] at hy
  obtain ⟨z, rfl⟩ := hy
  exact ⟨a.1, a.2, ⟨z, I.blowupChart_apply V a.2 z⟩⟩

-- The chart rings of the blow-up are large `HomogeneousLocalization` types; unifying
-- them exceeds the default heartbeat limit.
/-- **Chart-ring extraction of a probe of the blow-up**: an affine probe of `T` on
which a lift `h` of `t` lands in the `a`-chart of the blow-up induces a ring map from
the chart ring restricting to `t` on the base. -/
lemma Scheme.IdealSheafData.exists_chartRingHom_of_probe (I : X.IdealSheafData)
    {t : T ⟶ X} {h : T ⟶ I.blowup} (hht : h ≫ I.blowupMap = t) (V : X.affineOpens)
    {a : Γ(X, V.1)} (ha : a ∈ I.ideal V) (W : T.affineOpens) (hWt : W.1 ≤ t ⁻¹ᵁ V.1)
    (hWh : W.1 ≤ h ⁻¹ᵁ (I.blowupChart V ha).opensRange) :
    ∃ ψ : HomogeneousLocalization.Away (reesGrading (I.ideal V))
        (reesX (I.ideal V) a ha) →+* Γ(T, W.1),
      Spec.map (CommRingCat.ofHom ψ) ≫ I.blowupChart V ha = W.2.fromSpec ≫ h ∧
      ψ.comp (AffineBlowup.awayAlgebraMap (I.ideal V) (reesX (I.ideal V) a ha)) =
        (t.appLE V.1 W.1 hWt).hom := by
  have hrange : Set.range (W.2.fromSpec ≫ h) ⊆ Set.range (I.blowupChart V ha) := by
    rintro - ⟨w, rfl⟩
    have hmem : W.2.fromSpec w ∈ h ⁻¹ᵁ (I.blowupChart V ha).opensRange := by
      apply hWh
      have h0 : W.2.fromSpec w ∈ (W.2.fromSpec).opensRange := ⟨w, rfl⟩
      rwa [W.2.opensRange_fromSpec] at h0
    rw [Scheme.Hom.mem_preimage] at hmem
    rw [Scheme.Hom.comp_apply]
    exact hmem
  have hl : IsOpenImmersion.lift (I.blowupChart V ha) (W.2.fromSpec ≫ h) hrange ≫
      I.blowupChart V ha = W.2.fromSpec ≫ h :=
    IsOpenImmersion.lift_fac _ _ hrange
  have hbase : (Spec.map (Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
      (W.2.fromSpec ≫ h) hrange)) ≫
        Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
          (reesX (I.ideal V) a ha)))) ≫ V.2.fromSpec =
      Spec.map (t.appLE V.1 W.1 hWt) ≫ V.2.fromSpec := by
    calc (Spec.map (Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
        (W.2.fromSpec ≫ h) hrange)) ≫
          Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
            (reesX (I.ideal V) a ha)))) ≫ V.2.fromSpec
        = Spec.map (Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
            (W.2.fromSpec ≫ h) hrange)) ≫
            (Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
              (reesX (I.ideal V) a ha))) ≫ V.2.fromSpec) := Category.assoc _ _ _
      _ = Spec.map (Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
            (W.2.fromSpec ≫ h) hrange)) ≫ (I.blowupChart V ha ≫ I.blowupMap) :=
          congrArg (Spec.map (Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
            (W.2.fromSpec ≫ h) hrange)) ≫ ·) (I.blowupChart_comp_blowupMap V ha).symm
      _ = (Spec.map (Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
            (W.2.fromSpec ≫ h) hrange)) ≫ I.blowupChart V ha) ≫ I.blowupMap :=
          (Category.assoc _ _ _).symm
      _ = (W.2.fromSpec ≫ h) ≫ I.blowupMap := by rw [Spec.map_preimage]; rw [hl]
      _ = W.2.fromSpec ≫ t := by rw [Category.assoc, hht]
      _ = Spec.map (t.appLE V.1 W.1 hWt) ≫ V.2.fromSpec :=
          (IsAffineOpen.SpecMap_appLE_fromSpec t V.2 W.2 hWt).symm
  have hcat : CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
      (reesX (I.ideal V) a ha)) ≫
        Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
          (W.2.fromSpec ≫ h) hrange) = t.appLE V.1 W.1 hWt := by
    apply Spec.map_injective
    apply (cancel_mono V.2.fromSpec).mp
    rw [Spec.map_comp]
    exact hbase
  refine ⟨(Spec.preimage (IsOpenImmersion.lift (I.blowupChart V ha)
    (W.2.fromSpec ≫ h) hrange)).hom, ?_, ?_⟩
  · rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    exact hl
  · have h2 := congrArg CommRingCat.Hom.hom hcat
    rwa [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h2

end UniversalPropertyPreparation

section Uniqueness

/-! ### Uniqueness of lifts along the blow-up map (Stacks Project Tag 0806, uniqueness)

Two lifts of `t : T ⟶ X` to the blow-up of `I` agree when `I.comap t` is invertible:
locally both land in charts of the blow-up over a common affine open of the base, the
extracted chart ring maps are determined by division by the nonzerodivisor local
equation, and the two charts are compared in the chart-overlap localization. -/

variable {X T : Scheme.{u}}

-- The chart rings of the blow-up are large `HomogeneousLocalization` types; unifying
-- them exceeds the default heartbeat limit.
/-- Two lifts of `t` agree on an affine probe landing in charts of the blow-up, when
the pulled-back ideal is generated on the probe by a nonzerodivisor. -/
lemma Scheme.IdealSheafData.probe_comp_eq_of_charts (I : X.IdealSheafData)
    {t : T ⟶ X} {h₁ h₂ : T ⟶ I.blowup}
    (e₁ : h₁ ≫ I.blowupMap = t) (e₂ : h₂ ≫ I.blowupMap = t)
    (V : X.affineOpens) {a b : Γ(X, V.1)} (ha : a ∈ I.ideal V) (hb : b ∈ I.ideal V)
    (W : T.affineOpens) (hWt : W.1 ≤ t ⁻¹ᵁ V.1)
    (hW₁ : W.1 ≤ h₁ ⁻¹ᵁ (I.blowupChart V ha).opensRange)
    (hW₂ : W.1 ≤ h₂ ⁻¹ᵁ (I.blowupChart V hb).opensRange)
    {c : Γ(T, W.1)} (hc : c ∈ nonZeroDivisors Γ(T, W.1))
    (hgen : (I.comap t).ideal W = Ideal.span {c}) :
    W.2.fromSpec ≫ h₁ = W.2.fromSpec ≫ h₂ := by
  obtain ⟨ψ₁, hψ₁, hψ₁c⟩ := I.exists_chartRingHom_of_probe e₁ V ha W hWt hW₁
  obtain ⟨ψ₂, hψ₂, hψ₂c⟩ := I.exists_chartRingHom_of_probe e₂ V hb W hWt hW₂
  -- the extension of `I(V)` on the probe is principal on the images of `a`, `b`, `c`
  have hIφ : (I.ideal V).map (t.appLE V.1 W.1 hWt).hom = Ideal.span {c} := by
    rw [← Scheme.IdealSheafData.ideal_comap_appLE I t V W hWt]
    exact hgen
  have hspan_a : (I.ideal V).map (t.appLE V.1 W.1 hWt).hom =
      Ideal.span {(t.appLE V.1 W.1 hWt).hom a} :=
    AffineBlowup.span_map_eq_of_comp_awayAlgebraMap (I.ideal V) ha hψ₁c
  have hspan_b : (I.ideal V).map (t.appLE V.1 W.1 hWt).hom =
      Ideal.span {(t.appLE V.1 W.1 hWt).hom b} :=
    AffineBlowup.span_map_eq_of_comp_awayAlgebraMap (I.ideal V) hb hψ₂c
  obtain ⟨ua, hua, hanzd⟩ :=
    exists_unit_mul_of_span_singleton_eq hc (hIφ.symm.trans hspan_a)
  obtain ⟨ub, hub, hbnzd⟩ :=
    exists_unit_mul_of_span_singleton_eq hc (hIφ.symm.trans hspan_b)
  -- the localization elements map to units
  have hel₁ : ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
      (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) *
        (t.appLE V.1 W.1 hWt).hom a = (t.appLE V.1 W.1 hWt).hom b := by
    have h0 := congrArg ψ₁
      (AffineBlowup.isLocalizationElem_mul_awayAlgebraMap (I.ideal V) ha hb)
    rw [map_mul] at h0
    have ha' : ψ₁ (AffineBlowup.awayAlgebraMap (I.ideal V) (reesX (I.ideal V) a ha) a) =
        (t.appLE V.1 W.1 hWt).hom a := RingHom.congr_fun hψ₁c a
    have hb' : ψ₁ (AffineBlowup.awayAlgebraMap (I.ideal V) (reesX (I.ideal V) a ha) b) =
        (t.appLE V.1 W.1 hWt).hom b := RingHom.congr_fun hψ₁c b
    rw [← ha', ← hb']
    exact h0
  have hel₂ : ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
      (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) *
        (t.appLE V.1 W.1 hWt).hom b = (t.appLE V.1 W.1 hWt).hom a := by
    have h0 := congrArg ψ₂
      (AffineBlowup.isLocalizationElem_mul_awayAlgebraMap (I.ideal V) hb ha)
    rw [map_mul] at h0
    have ha' : ψ₂ (AffineBlowup.awayAlgebraMap (I.ideal V) (reesX (I.ideal V) b hb) a) =
        (t.appLE V.1 W.1 hWt).hom a := RingHom.congr_fun hψ₂c a
    have hb' : ψ₂ (AffineBlowup.awayAlgebraMap (I.ideal V) (reesX (I.ideal V) b hb) b) =
        (t.appLE V.1 W.1 hWt).hom b := RingHom.congr_fun hψ₂c b
    rw [← ha', ← hb']
    exact h0
  have hu₁ : IsUnit (ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
      (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb))) := by
    have h1 : ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
        (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) * (ua : Γ(T, W.1)) =
        (ub : Γ(T, W.1)) := by
      refine (mul_cancel_right_mem_nonZeroDivisors hc).mp ?_
      calc ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
            (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) *
              (ua : Γ(T, W.1)) * c
          = ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
              (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) *
              ((ua : Γ(T, W.1)) * c) := by ring
        _ = ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
              (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) *
              (t.appLE V.1 W.1 hWt).hom a := by rw [← hua]
        _ = (t.appLE V.1 W.1 hWt).hom b := hel₁
        _ = (ub : Γ(T, W.1)) * c := hub
    refine IsUnit.of_mul_eq_one ((ua : Γ(T, W.1)) * (ub⁻¹ : Γ(T, W.1)ˣ)) ?_
    calc ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
          (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) *
            ((ua : Γ(T, W.1)) * (ub⁻¹ : Γ(T, W.1)ˣ))
        = ψ₁ (HomogeneousLocalization.Away.isLocalizationElem
            (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb)) *
            (ua : Γ(T, W.1)) * (ub⁻¹ : Γ(T, W.1)ˣ) := by ring
      _ = (ub : Γ(T, W.1)) * (ub⁻¹ : Γ(T, W.1)ˣ) := by rw [h1]
      _ = 1 := ub.mul_inv
  have hu₂ : IsUnit (ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
      (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha))) := by
    have h1 : ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
        (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) * (ub : Γ(T, W.1)) =
        (ua : Γ(T, W.1)) := by
      refine (mul_cancel_right_mem_nonZeroDivisors hc).mp ?_
      calc ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
            (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) *
              (ub : Γ(T, W.1)) * c
          = ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
              (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) *
              ((ub : Γ(T, W.1)) * c) := by ring
        _ = ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
              (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) *
              (t.appLE V.1 W.1 hWt).hom b := by rw [← hub]
        _ = (t.appLE V.1 W.1 hWt).hom a := hel₂
        _ = (ua : Γ(T, W.1)) * c := hua
    refine IsUnit.of_mul_eq_one ((ub : Γ(T, W.1)) * (ua⁻¹ : Γ(T, W.1)ˣ)) ?_
    calc ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
          (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) *
            ((ub : Γ(T, W.1)) * (ua⁻¹ : Γ(T, W.1)ˣ))
        = ψ₂ (HomogeneousLocalization.Away.isLocalizationElem
            (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)) *
            (ub : Γ(T, W.1)) * (ua⁻¹ : Γ(T, W.1)ˣ) := by ring
      _ = (ua : Γ(T, W.1)) * (ua⁻¹ : Γ(T, W.1)ˣ) := by rw [h1]
      _ = 1 := ua.mul_inv
  -- factor both chart ring maps through the chart-overlap localization
  obtain ⟨ψ₁', hfac₁⟩ := HomogeneousLocalization.Away.exists_factor_of_isUnit
    (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb) rfl one_ne_zero ψ₁ hu₁
  obtain ⟨ψ₂', hfac₂⟩ := HomogeneousLocalization.Away.exists_factor_of_isUnit
    (reesX_mem (I.ideal V) b hb) (reesX_mem (I.ideal V) a ha)
    (mul_comm (reesX (I.ideal V) a ha) (reesX (I.ideal V) b hb)) one_ne_zero ψ₂ hu₂
  have hcomp₁ := AffineBlowup.comp_awayAlgebraMap_of_factor (I.ideal V)
    (reesX_mem (I.ideal V) b hb) rfl hfac₁
  have hcomp₂ := AffineBlowup.comp_awayAlgebraMap_of_factor (I.ideal V)
    (reesX_mem (I.ideal V) a ha)
    (mul_comm (reesX (I.ideal V) a ha) (reesX (I.ideal V) b hb)) hfac₂
  -- the two factorizations agree
  have hψeq : ψ₁' = ψ₂' := by
    refine AffineBlowup.chartRingHom_ext (I.ideal V)
      (SetLike.mul_mem_graded (reesX_mem (I.ideal V) a ha) (reesX_mem (I.ideal V) b hb))
      (τ := a * b) ?_ ?_ ?_
    · push_cast [coe_reesX]
      rw [Polynomial.monomial_mul_monomial]
    · rw [hcomp₁, hcomp₂, hψ₁c, hψ₂c]
    · refine Scheme.IdealSheafData.IsInvertible.mem_nonZeroDivisors_of_eq
        (RingHom.congr_fun (hcomp₁.trans hψ₁c) (a * b)) ?_
      rw [map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hanzd, hbnzd⟩
  -- assemble the probe equality
  calc W.2.fromSpec ≫ h₁
      = Spec.map (CommRingCat.ofHom ψ₁) ≫ I.blowupChart V ha := hψ₁.symm
    _ = Spec.map (CommRingCat.ofHom (ψ₁'.comp (HomogeneousLocalization.awayMap
          (reesGrading (I.ideal V)) (reesX_mem (I.ideal V) b hb) rfl))) ≫
          I.blowupChart V ha :=
        congrArg (fun ρ ↦ Spec.map (CommRingCat.ofHom ρ) ≫ I.blowupChart V ha) hfac₁.symm
    _ = Spec.map (CommRingCat.ofHom ψ₁') ≫
          (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap
            (reesGrading (I.ideal V)) (reesX_mem (I.ideal V) b hb) rfl)) ≫
            I.blowupChart V ha) :=
        specMap_ofHom_comp_assoc _ _ _
    _ = Spec.map (CommRingCat.ofHom ψ₁') ≫
          (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap
            (reesGrading (I.ideal V)) (reesX_mem (I.ideal V) a ha)
            (mul_comm (reesX (I.ideal V) a ha) (reesX (I.ideal V) b hb)))) ≫
            I.blowupChart V hb) :=
        congrArg (Spec.map (CommRingCat.ofHom ψ₁') ≫ ·)
          (I.specMap_awayMap_blowupChart V ha hb)
    _ = Spec.map (CommRingCat.ofHom ψ₂') ≫
          (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap
            (reesGrading (I.ideal V)) (reesX_mem (I.ideal V) a ha)
            (mul_comm (reesX (I.ideal V) a ha) (reesX (I.ideal V) b hb)))) ≫
            I.blowupChart V hb) := by rw [hψeq]
    _ = Spec.map (CommRingCat.ofHom (ψ₂'.comp (HomogeneousLocalization.awayMap
          (reesGrading (I.ideal V)) (reesX_mem (I.ideal V) a ha)
          (mul_comm (reesX (I.ideal V) a ha) (reesX (I.ideal V) b hb))))) ≫
          I.blowupChart V hb :=
        (specMap_ofHom_comp_assoc _ _ _).symm
    _ = Spec.map (CommRingCat.ofHom ψ₂) ≫ I.blowupChart V hb :=
        congrArg (fun ρ ↦ Spec.map (CommRingCat.ofHom ρ) ≫ I.blowupChart V hb) hfac₂
    _ = W.2.fromSpec ≫ h₂ := hψ₂

-- The chart rings of the blow-up are large `HomogeneousLocalization` types; unifying
-- them exceeds the default heartbeat limit.
/-- **Uniqueness of lifts along the blow-up map** (Stacks Project Tag 0806,
uniqueness): two morphisms to the blow-up of `I` over the same base morphism `t` with
`I.comap t` invertible agree. -/
theorem Scheme.IdealSheafData.hom_ext_of_isInvertible_comap (I : X.IdealSheafData)
    {t : T ⟶ X} (hEC : (I.comap t).IsInvertible)
    {h₁ h₂ : T ⟶ I.blowup} (e₁ : h₁ ≫ I.blowupMap = t) (e₂ : h₂ ≫ I.blowupMap = t) :
    h₁ = h₂ := by
  have key : ∀ z : T, ∃ W : T.affineOpens, z ∈ W.1 ∧
      W.2.fromSpec ≫ h₁ = W.2.fromSpec ≫ h₂ := by
    intro z
    obtain ⟨V, W₀, -, hzW₀⟩ := exists_affineOpens_le_preimage t z
    have htz : t z ∈ (⊤ : X.Opens) := trivial
    rw [← iSup_affineOpens_eq_top X] at htz
    obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.mp htz
    have hz₁ : h₁ z ∈ I.blowupMap ⁻¹ᵁ V.1 := by
      rw [Scheme.Hom.mem_preimage]
      have h0 : I.blowupMap (h₁ z) = t z := by
        rw [← Scheme.Hom.comp_apply, e₁]
      rw [h0]
      exact hV
    have hz₂ : h₂ z ∈ I.blowupMap ⁻¹ᵁ V.1 := by
      rw [Scheme.Hom.mem_preimage]
      have h0 : I.blowupMap (h₂ z) = t z := by
        rw [← Scheme.Hom.comp_apply, e₂]
      rw [h0]
      exact hV
    obtain ⟨a, ha, hmem₁⟩ := I.exists_mem_opensRange_blowupChart V hz₁
    obtain ⟨b, hb, hmem₂⟩ := I.exists_mem_opensRange_blowupChart V hz₂
    have hzO : z ∈ t ⁻¹ᵁ V.1 ⊓ (h₁ ⁻¹ᵁ (I.blowupChart V ha).opensRange ⊓
        h₂ ⁻¹ᵁ (I.blowupChart V hb).opensRange) := by
      refine ⟨?_, ?_, ?_⟩
      · exact hV
      · exact hmem₁
      · exact hmem₂
    obtain ⟨W, hzW, hWle, c, hc, hgen⟩ := hEC.exists_presentation_le hzO
    exact ⟨W, hzW, I.probe_comp_eq_of_charts e₁ e₂ V ha hb W
      (hWle.trans inf_le_left)
      (hWle.trans (le_trans inf_le_right inf_le_left))
      (hWle.trans (le_trans inf_le_right inf_le_right)) hc hgen⟩
  choose W hzW hkey using key
  refine (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) T
    (fun z : T ↦ Spec Γ(T, (W z).1)) (fun z ↦ (W z).2.fromSpec)
    (fun x ↦ ?_) (fun z ↦ inferInstance)).hom_ext h₁ h₂ (fun z ↦ hkey z)
  have hx : x ∈ ((W x).2.fromSpec).opensRange := by
    rw [(W x).2.opensRange_fromSpec]
    exact hzW x
  obtain ⟨y, hy⟩ := hx
  exact ⟨x, y, hy⟩

end Uniqueness

section Existence

/-! ### Existence of lifts along the blow-up map (Stacks Project Tag 0806, existence)

Local construction: on an affine probe where the pulled-back ideal is generated by a
nonzerodivisor `c`, finitely many sections `xⱼ` of `I(V)` and elements `tⱼ` generating
the unit ideal are produced such that away from `tⱼ` the extension of `I(V)` is
principal on the regular image of `xⱼ`; there the chart-ring lift
`AffineBlowup.chartRingLift` provides the map to the `xⱼ`-chart of the blow-up. The
local lifts glue by the uniqueness theorem. -/

/-- **Localization cover for a principal extension** (ring form): if `J.map φ = (c)`
with `c` a nonzerodivisor, there are finitely many `xⱼ ∈ J` and `tⱼ` generating the
unit ideal such that away from `tⱼ` the extension of `J` is generated by the
nonzerodivisor image of `xⱼ`. -/
lemma exists_span_eq_top_localization_span_of_map_eq_span {A R : Type u} [CommRing A]
    [CommRing R] {J : Ideal A} {φ : A →+* R} {c : R} (hc : c ∈ nonZeroDivisors R)
    (hspan : J.map φ = Ideal.span {c}) :
    ∃ (n : ℕ) (x : Fin n → A) (tt : Fin n → R), (∀ j, x j ∈ J) ∧
      Ideal.span (Set.range tt) = ⊤ ∧
      ∀ (j : Fin n) (S : Type u) [CommRing S] [Algebra R S]
        [IsLocalization.Away (tt j) S],
        algebraMap R S (φ (x j)) ∈ nonZeroDivisors S ∧
        (J.map φ).map (algebraMap R S) = Ideal.span {algebraMap R S (φ (x j))} := by
  classical
  have hcmem : c ∈ Ideal.span (φ '' (J : Set A)) := by
    have h0 : c ∈ J.map φ := by rw [hspan]; exact Ideal.mem_span_singleton_self c
    exact h0
  obtain ⟨n, e, u, hu⟩ := Submodule.mem_span_set'.mp hcmem
  have hmem : ∀ i : Fin n, ∃ xa : A, xa ∈ J ∧ φ xa = (u i : R) := by
    intro i
    obtain ⟨xa, hxa, hφ⟩ := (u i).2
    exact ⟨xa, hxa, hφ⟩
  choose x hxJ hφx using hmem
  have hquot : ∀ i, ∃ q : R, q * c = φ (x i) := by
    intro i
    refine Ideal.mem_span_singleton'.mp ?_
    rw [← hspan]
    exact Ideal.mem_map_of_mem φ (hxJ i)
  choose q hq using hquot
  refine ⟨n, x, fun i ↦ e i * q i, hxJ, ?_, ?_⟩
  · have hsum : (∑ i, e i * q i) * c = 1 * c := by
      rw [one_mul, Finset.sum_mul]
      calc ∑ i, e i * q i * c
          = ∑ i, e i * (q i * c) := Finset.sum_congr rfl fun i _ ↦ by ring
        _ = ∑ i, e i • (u i : R) := by
            refine Finset.sum_congr rfl fun i _ ↦ ?_
            rw [hq i, smul_eq_mul, hφx i]
        _ = c := hu
    have hone := (mul_cancel_right_mem_nonZeroDivisors hc).mp hsum
    rw [eq_top_iff]
    intro r _
    have hr : r * ∑ i, e i * q i ∈ Ideal.span (Set.range fun i ↦ e i * q i) := by
      rw [Finset.mul_sum]
      exact Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    rwa [hone, mul_one] at hr
  · intro j S _ _ _
    have hqunit : IsUnit (algebraMap R S (q j)) := by
      refine IsUnit.of_mul_eq_one (algebraMap R S (e j) *
        IsLocalization.Away.invSelf (e j * q j)) ?_
      calc algebraMap R S (q j) *
            (algebraMap R S (e j) * IsLocalization.Away.invSelf (e j * q j))
          = algebraMap R S (e j * q j) * IsLocalization.Away.invSelf (e j * q j) := by
            rw [map_mul]; ring
        _ = 1 := IsLocalization.Away.mul_invSelf _
    have hcnzd : algebraMap R S c ∈ nonZeroDivisors S :=
      IsLocalization.Away.algebraMap_mem_nonZeroDivisors (e j * q j) hc
    have hφx' : algebraMap R S (φ (x j)) = algebraMap R S (q j) * algebraMap R S c := by
      rw [← map_mul, hq j]
    constructor
    · refine Scheme.IdealSheafData.IsInvertible.mem_nonZeroDivisors_of_eq hφx' ?_
      exact mul_mem_nonZeroDivisors.mpr ⟨hqunit.mem_nonZeroDivisors, hcnzd⟩
    · calc (J.map φ).map (algebraMap R S)
          = (Ideal.span {c}).map (algebraMap R S) := by rw [hspan]
        _ = Ideal.span {algebraMap R S c} := by rw [Ideal.map_span, Set.image_singleton]
        _ = Ideal.span {algebraMap R S (q j) * algebraMap R S c} :=
            (Ideal.span_singleton_mul_left_unit hqunit _).symm
        _ = Ideal.span {algebraMap R S (φ (x j))} := by rw [← hφx']

variable {X T : Scheme.{u}}

-- The chart rings of the blow-up are large `HomogeneousLocalization` types; unifying
-- them exceeds the default heartbeat limit.
/-- **Local existence of lifts to the blow-up**: near every point of `T` there is an
affine probe carrying a lift of `t` to the blow-up of `I`. -/
lemma Scheme.IdealSheafData.exists_probe_lift (I : X.IdealSheafData)
    {t : T ⟶ X} (hEC : (I.comap t).IsInvertible) (z : T) :
    ∃ O : T.affineOpens, z ∈ O.1 ∧
      ∃ l : Spec Γ(T, O.1) ⟶ I.blowup, l ≫ I.blowupMap = O.2.fromSpec ≫ t := by
  have htz : t z ∈ (⊤ : X.Opens) := trivial
  rw [← iSup_affineOpens_eq_top X] at htz
  obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.mp htz
  have hztV : z ∈ t ⁻¹ᵁ V.1 := hV
  obtain ⟨W, hzW, hWle, c, hc, hgen⟩ := hEC.exists_presentation_le hztV
  have hφspan : (I.ideal V).map (t.appLE V.1 W.1 hWle).hom = Ideal.span {c} := by
    rw [← Scheme.IdealSheafData.ideal_comap_appLE I t V W hWle]
    exact hgen
  obtain ⟨n, x, tt, hxJ, htop, hloc⟩ :=
    exists_span_eq_top_localization_span_of_map_eq_span hc hφspan
  have hcov : W.1 ≤ ⨆ f : Set.range tt, T.basicOpen f.1 :=
    (W.2.self_le_iSup_basicOpen_iff (s := Set.range tt)).mpr htop
  obtain ⟨⟨v, j, rfl⟩, hzj⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcov hzW)
  have : IsLocalization.Away (tt j) Γ(T, T.basicOpen (tt j)) :=
    W.2.isLocalization_basicOpen (tt j)
  obtain ⟨hnzd, hspan⟩ := hloc j Γ(T, T.basicOpen (tt j))
  have hOle : (T.affineBasicOpen (tt j) : T.Opens) ≤ t ⁻¹ᵁ V.1 :=
    le_trans (T.affineBasicOpen_le (tt j)) hWle
  have halg : algebraMap Γ(T, W.1) Γ(T, T.basicOpen (tt j)) =
      (T.presheaf.map (homOfLE (T.basicOpen_le (tt j))).op).hom :=
    RingHom.algebraMap_toAlgebra _
  have happ : (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom =
      (algebraMap Γ(T, W.1) Γ(T, T.basicOpen (tt j))).comp
        (t.appLE V.1 W.1 hWle).hom := by
    calc (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom
        = (t.appLE V.1 W.1 hWle ≫
            T.presheaf.map (homOfLE (X := T.Opens)
              (T.affineBasicOpen_le (tt j))).op).hom := by
          rw [Scheme.Hom.appLE_map]
      _ = ((T.presheaf.map (homOfLE (X := T.Opens)
            (T.affineBasicOpen_le (tt j))).op).hom).comp
            (t.appLE V.1 W.1 hWle).hom := by rw [CommRingCat.hom_comp]
      _ = (algebraMap Γ(T, W.1) Γ(T, T.basicOpen (tt j))).comp
            (t.appLE V.1 W.1 hWle).hom := by rw [halg]
  have hnzd' : (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom (x j) ∈
      nonZeroDivisors Γ(T, T.basicOpen (tt j)) := by
    refine Scheme.IdealSheafData.IsInvertible.mem_nonZeroDivisors_of_eq
      (RingHom.congr_fun happ (x j)) hnzd
  have hspan' : (I.ideal V).map (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom ≤
      Ideal.span {(t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom (x j)} := by
    refine le_of_eq ?_
    calc (I.ideal V).map (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom
        = ((I.ideal V).map (t.appLE V.1 W.1 hWle).hom).map
            (algebraMap Γ(T, W.1) Γ(T, T.basicOpen (tt j))) := by
          rw [happ, ← Ideal.map_map]
      _ = Ideal.span {algebraMap Γ(T, W.1) Γ(T, T.basicOpen (tt j))
            ((t.appLE V.1 W.1 hWle).hom (x j))} := hspan
      _ = Ideal.span {(t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom (x j)} := by
          have h2 : (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom (x j) =
              algebraMap Γ(T, W.1) Γ(T, T.basicOpen (tt j))
                ((t.appLE V.1 W.1 hWle).hom (x j)) := RingHom.congr_fun happ (x j)
          exact congrArg (fun r ↦ Ideal.span {r}) h2.symm
  refine ⟨T.affineBasicOpen (tt j), hzj,
    Spec.map (CommRingCat.ofHom (AffineBlowup.chartRingLift (hxJ j) hnzd' hspan')) ≫
      I.blowupChart V (hxJ j), ?_⟩
  have hΨcomp : (AffineBlowup.chartRingLift (hxJ j) hnzd' hspan').comp
      (AffineBlowup.awayAlgebraMap (I.ideal V) (reesX (I.ideal V) (x j) (hxJ j))) =
      (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom :=
    AffineBlowup.chartRingLift_comp_awayAlgebraMap (hxJ j) hnzd' hspan'
  calc (Spec.map (CommRingCat.ofHom (AffineBlowup.chartRingLift (hxJ j) hnzd' hspan')) ≫
        I.blowupChart V (hxJ j)) ≫ I.blowupMap
      = Spec.map (CommRingCat.ofHom (AffineBlowup.chartRingLift (hxJ j) hnzd' hspan')) ≫
          (I.blowupChart V (hxJ j) ≫ I.blowupMap) := Category.assoc _ _ _
    _ = Spec.map (CommRingCat.ofHom (AffineBlowup.chartRingLift (hxJ j) hnzd' hspan')) ≫
          (Spec.map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
            (reesX (I.ideal V) (x j) (hxJ j)))) ≫ V.2.fromSpec) :=
        congrArg (Spec.map (CommRingCat.ofHom
            (AffineBlowup.chartRingLift (hxJ j) hnzd' hspan')) ≫ ·)
          (I.blowupChart_comp_blowupMap V (hxJ j))
    _ = Spec.map (CommRingCat.ofHom ((AffineBlowup.chartRingLift (hxJ j) hnzd'
          hspan').comp (AffineBlowup.awayAlgebraMap (I.ideal V)
            (reesX (I.ideal V) (x j) (hxJ j))))) ≫ V.2.fromSpec :=
        (specMap_ofHom_comp_assoc _ _ _).symm
    _ = Spec.map (CommRingCat.ofHom
          (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle).hom) ≫ V.2.fromSpec :=
        congrArg (fun ρ ↦ Spec.map (CommRingCat.ofHom ρ) ≫ V.2.fromSpec) hΨcomp
    _ = Spec.map (t.appLE V.1 (T.affineBasicOpen (tt j)).1 hOle) ≫ V.2.fromSpec := by
        rw [CommRingCat.ofHom_hom]
    _ = (T.affineBasicOpen (tt j)).2.fromSpec ≫ t :=
        IsAffineOpen.SpecMap_appLE_fromSpec t V.2 (T.affineBasicOpen (tt j)).2 hOle

/-- **Existence of lifts along the blow-up map** (Stacks Project Tag 0806, existence):
a morphism `t : T ⟶ X` with `I.comap t` invertible lifts to the blow-up of `I`. -/
theorem Scheme.IdealSheafData.exists_lift_blowup (I : X.IdealSheafData)
    {t : T ⟶ X} (hEC : (I.comap t).IsInvertible) :
    ∃ h : T ⟶ I.blowup, h ≫ I.blowupMap = t := by
  choose O hzO l hl using fun z : T ↦ I.exists_probe_lift hEC z
  have hglue : ∀ z z' : T,
      pullback.fst ((O z).2.fromSpec) ((O z').2.fromSpec) ≫ l z =
      pullback.snd ((O z).2.fromSpec) ((O z').2.fromSpec) ≫ l z' := by
    intro z z'
    refine I.hom_ext_of_isInvertible_comap
      (t := (pullback.fst ((O z).2.fromSpec) ((O z').2.fromSpec) ≫ (O z).2.fromSpec) ≫ t)
      ?_ ?_ ?_
    · rw [Scheme.IdealSheafData.comap_comp]
      exact hEC.comap_of_isOpenImmersion _
    · rw [Category.assoc, hl z, ← Category.assoc]
    · rw [Category.assoc, hl z', ← Category.assoc, ← pullback.condition]
  let 𝒰 : T.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) T
    (fun z : T ↦ Spec Γ(T, (O z).1)) (fun z ↦ (O z).2.fromSpec)
    (fun x ↦ by
      have hx : x ∈ ((O x).2.fromSpec).opensRange := by
        rw [(O x).2.opensRange_fromSpec]
        exact hzO x
      obtain ⟨y, hy⟩ := hx
      exact ⟨x, y, hy⟩)
    (fun z ↦ inferInstance)
  refine ⟨𝒰.glueMorphisms l hglue, 𝒰.hom_ext _ _ fun z ↦ ?_⟩
  rw [← Category.assoc, 𝒰.ι_glueMorphisms l hglue z, hl z]
  rfl

end Existence

end AlgebraicGeometry
