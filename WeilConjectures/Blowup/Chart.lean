module

public import WeilConjectures.Blowup.FiniteDegree
public import WeilConjectures.Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic

/-!

# The charts of the blow-up

Let `X` be a scheme and `I : X.IdealSheafData` a quasi-coherent ideal. The blow-up
`Bl_I(X)` is covered by the affine charts `I.blowupChart V ha` at the degree-one Rees
elements `a·X` attached to sections `a ∈ I(V)` over affine opens `V` of `X`. This file
collects the elementary facts about these charts that are needed away from the
finite-degree approximation: how a chart acts on points, that the centre becomes
principal on a chart, and that for a sum of two centres one may always find a covering
chart whose section lies in one of the two summands.

## Main results

- `AlgebraicGeometry.Scheme.IdealSheafData.blowupChart_apply` — a chart evaluated at a
  point is the chart embedding of the corresponding affine chart point.
- `AlgebraicGeometry.Scheme.IdealSheafData.map_blowupChartAlgebraMap_eq_span` — on the
  `a`-chart the extension of `I(V)` is generated by the image of `a`.
- `AlgebraicGeometry.Scheme.IdealSheafData.exists_mem_range_chart_sup` — every point of
  `Bl_{I₁ ⊔ I₂}(X)` lies in a chart at a section of `I₁` or of `I₂`
  (blueprint: `prop:nagata-affine-blowup-chart-cover`, sum form).

## Implementation notes

`Scheme.IdealSheafData.blowupChart` itself is defined in
`WeilConjectures.Blowup.FiniteDegree`, where it was introduced for the finite-degree
approximation of Stacks Project Tag 0803. It is general blow-up material rather than
finite-degree material, and this file is the natural place for it and for the chart API
around it; moving the definition is left to a separate change, since that file is
imported across the tree.

-/

@[expose] public section

universe u

open CategoryTheory HomogeneousLocalization

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-- The chart probe of the blow-up evaluated at a point: the chart embedding of the
affine chart point. Standalone lemma so that the definitional unfolding of
`blowupChart` happens once, with a directed expected type. -/
lemma Scheme.IdealSheafData.blowupChart_apply
    (I : X.IdealSheafData) (V : X.affineOpens) {a : Γ(X, V.1)} (ha : a ∈ I.ideal V)
    (z : Spec (.of (HomogeneousLocalization.Away (reesGrading (I.ideal V))
      (reesX (I.ideal V) a ha)))) :
    I.blowupChart V ha z =
      I.blowupι V (AffineBlowup.chart (I.ideal V) (reesX (I.ideal V) a ha)
        (reesX_mem (I.ideal V) a ha) z) :=
  Scheme.Hom.comp_apply _ _ z

/-- **The extended centre on a chart is principal**: on the chart of `Bl_I(X)` at a
section `a` of `I` over an affine open `V`, the extension of `I(V)` along the chart
algebra map is generated by the image of `a`. -/
lemma Scheme.IdealSheafData.map_blowupChartAlgebraMap_eq_span
    (I : X.IdealSheafData) (V : X.affineOpens) {a : Γ(X, V.1)} (ha : a ∈ I.ideal V) :
    (I.ideal V).map (CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
        (reesX (I.ideal V) a ha))).hom =
      Ideal.span {(CommRingCat.ofHom (AffineBlowup.awayAlgebraMap (I.ideal V)
        (reesX (I.ideal V) a ha))).hom a} := by
  rw [CommRingCat.hom_ofHom]
  exact AffineBlowup.map_awayAlgebraMap_reesX_eq_span_singleton (I.ideal V) a ha

/-- **The charts at pure degree-one elements cover the blow-up of a sum**: every point
of `Bl_{I₁ ⊔ I₂}(X)` lies in a chart at a degree-one element coming from a local
section of `I₁` or of `I₂`, since `D₊(b₁ + b₂) ⊆ D₊(b₁) ∪ D₊(b₂)`. -/
lemma Scheme.IdealSheafData.exists_mem_range_chart_sup
    (I₁ I₂ : X.IdealSheafData) (x : (I₁ ⊔ I₂).blowup) :
    ∃ (U : X.affineOpens) (b : Γ(X, U.1)) (hb : b ∈ (I₁ ⊔ I₂).ideal U),
      (b ∈ I₁.ideal U ∨ b ∈ I₂.ideal U) ∧
      x ∈ Set.range ((I₁ ⊔ I₂).blowupChart U hb) := by
  have hx : (I₁ ⊔ I₂).blowupMap x ∈ (⊤ : X.Opens) := trivial
  rw [← iSup_affineOpens_eq_top X] at hx
  obtain ⟨U, hU⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  have hx2 : x ∈ (I₁ ⊔ I₂).blowupMap ⁻¹ᵁ U.1 := hU
  rw [(I₁ ⊔ I₂).blowupMap_preimage U] at hx2
  obtain ⟨y, rfl⟩ := hx2
  have hy : y ∈ (⊤ : (AffineBlowup ((I₁ ⊔ I₂).ideal U)).Opens) := trivial
  rw [← AffineBlowup.iSup_basicOpen_reesX_eq_top ((I₁ ⊔ I₂).ideal U)] at hy
  obtain ⟨a, hy⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  obtain ⟨av, hav⟩ := a
  have hsup : (I₁ ⊔ I₂).ideal U = I₁.ideal U ⊔ I₂.ideal U := by
    rw [congrFun (Scheme.IdealSheafData.ideal_sup (I := I₁) (J := I₂)) U, Pi.sup_apply]
  have hav' : av ∈ I₁.ideal U ⊔ I₂.ideal U := hsup ▸ hav
  obtain ⟨b₁, hb₁, b₂, hb₂, hsum⟩ := Submodule.mem_sup.mp hav'
  subst hsum
  have hb₁K : b₁ ∈ (I₁ ⊔ I₂).ideal U := by
    rw [hsup]
    exact Submodule.mem_sup_left hb₁
  have hb₂K : b₂ ∈ (I₁ ⊔ I₂).ideal U := by
    rw [hsup]
    exact Submodule.mem_sup_right hb₂
  rw [show reesX ((I₁ ⊔ I₂).ideal U) (b₁ + b₂) hav =
    reesX ((I₁ ⊔ I₂).ideal U) b₁ hb₁K + reesX ((I₁ ⊔ I₂).ideal U) b₂ hb₂K from
    reesX_add _ hb₁K hb₂K] at hy
  have hy' := TopologicalSpace.Opens.mem_sup.mp (Proj.basicOpen_add_le _ _ _ hy)
  rcases hy' with h | h
  · rw [← AffineBlowup.opensRange_chart ((I₁ ⊔ I₂).ideal U)
      (reesX ((I₁ ⊔ I₂).ideal U) b₁ hb₁K) (reesX_mem _ b₁ hb₁K)] at h
    obtain ⟨z, rfl⟩ := h
    exact ⟨U, b₁, hb₁K, Or.inl hb₁, ⟨z, (I₁ ⊔ I₂).blowupChart_apply U hb₁K z⟩⟩
  · rw [← AffineBlowup.opensRange_chart ((I₁ ⊔ I₂).ideal U)
      (reesX ((I₁ ⊔ I₂).ideal U) b₂ hb₂K) (reesX_mem _ b₂ hb₂K)] at h
    obtain ⟨z, rfl⟩ := h
    exact ⟨U, b₂, hb₂K, Or.inr hb₂, ⟨z, (I₁ ⊔ I₂).blowupChart_apply U hb₂K z⟩⟩

end AlgebraicGeometry
