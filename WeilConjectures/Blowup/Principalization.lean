module

public import WeilConjectures.Blowup.Affine.Principalization
public import WeilConjectures.Blowup.Gluing
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.EffectiveCartier

/-!

# Principalization of the centre on the blow-up

Let `X` be a scheme and `I : X.IdealSheafData` a quasi-coherent ideal. We show that the
extended ideal `I · 𝒪_{Bl_I(X)}`, that is the pullback `I.comap I.blowupMap`, is invertible:
every point of the blow-up has an affine open neighbourhood on which the extended ideal is
generated by a single non-zerodivisor.

The proof reduces twice, using that invertibility is local
(`Scheme.IdealSheafData.IsInvertible.of_iSup_opensRange_eq_top`): first over the chart
embeddings `I.blowupι U` of the affine opens `U` of `X`, then over the standard charts
`AffineBlowup.chart` of the affine blow-up. On such a chart the composite to `X` is `Spec` of
the canonical map `Γ(X, U) ⟶ Γ(X, U)[I(U)/a]`, so `IsInvertible.of_specMap_ofHom_fromSpec`
reduces the statement to the chart-level results of
`WeilConjectures.Blowup.Affine.Principalization`.

Note that no finiteness assumption on `I` is needed: the blueprint's finite-type hypothesis
is only used to keep the chart cover finite, which is irrelevant for a local statement.

## Main results

- `AlgebraicGeometry.Scheme.IdealSheafData.iSup_opensRange_blowupι_eq_top` — the affine
  charts of the blow-up cover it.
- `AlgebraicGeometry.Scheme.IdealSheafData.isInvertible_comap_blowupMap` — the centre becomes
  an invertible ideal on the blow-up (blueprint: `thm:nagata-blowup-principalizes-center`).
- `AlgebraicGeometry.Scheme.IdealSheafData.isEffectiveCartierCenter_subschemeι_comap_blowupMap`
  — the closed subscheme it cuts out is an effective Cartier centre, which is the second half
  of the same blueprint theorem.

-/

@[expose] public section

universe u

open CategoryTheory HomogeneousLocalization

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- The chart embeddings of the affine opens of `X` cover the blow-up.
(blueprint: `prop:nagata-affine-blowup-chart-cover`, global form) -/
lemma iSup_opensRange_blowupι_eq_top :
    ⨆ U : X.affineOpens, (I.blowupι U).opensRange = ⊤ := by
  refine eq_top_iff.mpr fun p _ ↦ ?_
  have hp : I.blowupMap p ∈ (⊤ : X.Opens) := trivial
  rw [← iSup_affineOpens_eq_top X] at hp
  obtain ⟨U, hU⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨U, by rw [← I.blowupMap_preimage U]; exact hU⟩

/-- **Principalization of the centre.** On the blow-up of `X` along a quasi-coherent ideal
`I`, the extended ideal `I · 𝒪_{Bl_I(X)}` is invertible: locally it is generated by a single
non-zerodivisor. (blueprint: `thm:nagata-blowup-principalizes-center`) -/
theorem isInvertible_comap_blowupMap : (I.comap I.blowupMap).IsInvertible := by
  refine IsInvertible.of_iSup_opensRange_eq_top (fun U : X.affineOpens ↦ I.blowupι U)
    I.iSup_opensRange_blowupι_eq_top fun U ↦ ?_
  rw [← comap_comp, blowupι_blowupMap]
  refine IsInvertible.of_iSup_opensRange_eq_top
    (fun a : I.ideal U ↦ AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a a.2)
      (reesX_mem (I.ideal U) a a.2)) ?_ fun a ↦ ?_
  · simpa only [AffineBlowup.opensRange_chart] using
      AffineBlowup.iSup_basicOpen_reesX_eq_top (I.ideal U)
  · rw [← comap_comp]
    have hfac : AffineBlowup.chart (I.ideal U) (reesX (I.ideal U) a a.2)
          (reesX_mem (I.ideal U) a a.2) ≫ (I.blowupNatTrans.app U ≫ U.1.ι) =
        Spec.map (CommRingCat.ofHom
          (AffineBlowup.awayAlgebraMap (I.ideal U) (reesX (I.ideal U) a a.2))) ≫
          U.2.fromSpec := by
      rw [blowupNatTrans_app, Category.assoc, AffineBlowup.chart_toSpec_assoc,
        IsAffineOpen.isoSpec_inv_ι]
    rw [hfac]
    refine IsInvertible.of_specMap_ofHom_fromSpec U _ ?_
    rw [AffineBlowup.map_awayAlgebraMap_reesX_eq_span_singleton]
    exact Ideal.isRegularPrincipal_span_singleton_of_isRegular
      (AffineBlowup.isRegular_awayAlgebraMap_reesX (I.ideal U) a a.2)

/-- **The exceptional divisor is an effective Cartier centre.** The closed subscheme of the
blow-up cut out by the extended ideal `I · 𝒪_{Bl_I(X)}` is an effective Cartier centre, since
that ideal is invertible. This is the second half of the blueprint's principalization
theorem. (blueprint: `thm:nagata-blowup-principalizes-center`, (MLCI1) half) -/
theorem isEffectiveCartierCenter_subschemeι_comap_blowupMap :
    IsEffectiveCartierCenter (I.comap I.blowupMap).subschemeι :=
  I.isInvertible_comap_blowupMap.isEffectiveCartierCenter

end AlgebraicGeometry.Scheme.IdealSheafData
