module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace
public import WeilConjectures.Blowup.Affine.Defs
public import WeilConjectures.Blowup.Affine.PolynomialPresentation
public import WeilConjectures.Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import WeilConjectures.Mathlib.RingTheory.GradedAlgebra.Homogeneous.Maps

/-!

# The projective embedding of the affine blow-up

If the ideal `I : Ideal A` is generated by a family `f : σ → A`, applying `Proj` to the
graded surjection `ρ_I : A[T] ↠ 𝓡_A(I)` of
`WeilConjectures.Blowup.Affine.PolynomialPresentation` embeds the affine blow-up
`Bl_I(Spec A)` as a closed subscheme of the projective space
`ℙ^σ_A = Proj A[T]`, that is, of `AlgebraicGeometry.Proj.projectiveSpaceOverAffine`,
compatibly with the two structure morphisms to `Spec A`.

## Main definitions

- `AlgebraicGeometry.AffineBlowup.toProjectiveSpace` — the projective embedding
  `e_I : Bl_I(Spec A) ⟶ ℙ^σ_A`.

## Main results

- `AlgebraicGeometry.AffineBlowup.isClosedImmersion_toProjectiveSpace` — `e_I` is a closed
  immersion.
- `AlgebraicGeometry.AffineBlowup.toProjectiveSpace_toSpec` — `e_I` is a morphism over
  `Spec A`.

## Implementation notes

Mathlib does not make the total-degree grading of `MvPolynomial σ A` a global instance, since
one may want to grade by another weight function; it is enabled here as a local instance, as
it is in `WeilConjectures.AlgebraicGeometry.ProjectiveSpace`.

## Blueprint

This file implements `def:nagata-affine-blowup-projective-embedding` and
`lemma:nagata-affine-blowup-projective-embedding` of the Nagata compactification blueprint.

`prop:nagata-affine-blowup-projective` — projectivity of `Bl_I(Spec A) ⟶ Spec A` — is *not*
formalized: this Mathlib has no morphism class `IsProjective` for schemes, so the statement
cannot be phrased. What the blueprint's proof needs of it is exactly the closed immersion and
the factorization proved here; properness, which is what the blueprint deduces from
projectivity, is obtained directly in `WeilConjectures.Blowup.Affine.Proper`.

The general input, that `Proj` of a surjective graded ring homomorphism is a closed immersion
(the absolute case of (MLRP3) of `lemma:nagata-relative-proj-interface`), is missing from
Mathlib and is proved in
`WeilConjectures.Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor` as
`AlgebraicGeometry.Proj.isClosedImmersion_map`.

-/

@[expose] public section

universe u

open CategoryTheory HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

namespace AlgebraicGeometry

variable (σ : Type u) (A : Type u) [CommRing A]

namespace AffineBlowup

variable {σ A} {I : Ideal A} (f : σ → A) (hf : ∀ i, f i ∈ I)
  (hspan : Ideal.span (Set.range f) = I)

include hspan in
/-- The graded surjection `ρ_I` satisfies the irrelevant-ideal hypothesis of `Proj.map`. -/
lemma irrelevant_le_map_reesGradedPresentation :
    HomogeneousIdeal.irrelevant (reesGrading I) ≤
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule σ A)).map
        (reesGradedPresentation f hf) :=
  GradedRingHom.irrelevant_le_map_of_surjective (reesGradedPresentation_surjective f hf hspan)

/-- The projective embedding `e_I : Bl_I(Spec A) ⟶ ℙ^σ_A`, obtained by applying `Proj` to the
graded surjection `ρ_I : A[T] ↠ 𝓡_A(I)`.
(blueprint: `def:nagata-affine-blowup-projective-embedding`) -/
noncomputable def toProjectiveSpace : AffineBlowup I ⟶ Proj.projectiveSpaceOverAffine σ A :=
  Proj.map (reesGradedPresentation f hf) (irrelevant_le_map_reesGradedPresentation f hf hspan)

/-- **The affine blow-up embeds as a closed subscheme of projective space**: if `I` is
generated by `f`, the morphism `e_I` is a closed immersion.
(blueprint: `lemma:nagata-affine-blowup-projective-embedding`, closed-immersion part) -/
theorem isClosedImmersion_toProjectiveSpace :
    IsClosedImmersion (toProjectiveSpace f hf hspan) :=
  Proj.isClosedImmersion_map _ _ (reesGradedPresentation_surjective f hf hspan)

/-- In degree zero the graded surjection `ρ_I` is the identity of `A`, under the
identifications of `A` with the degree-zero parts of `A[T]` and of `𝓡_A(I)`. -/
lemma gradeZeroRingHom_reesGradedPresentation_comp :
    (reesGradedPresentation f hf).gradeZeroRingHom.comp
        (MvPolynomial.homogeneousSubmoduleZeroEquiv σ A).toRingHom =
      (reesGradingZero I).toRingHom :=
  RingHom.ext fun a ↦ Subtype.ext <| Subtype.ext <| by simp

/-- **The projective embedding is a morphism over `Spec A`**: composing `e_I` with the
structure morphism of `ℙ^σ_A` gives the blow-up morphism `b_{A,I}`.
(blueprint: `lemma:nagata-affine-blowup-projective-embedding`, degree-zero part) -/
@[reassoc]
theorem toProjectiveSpace_toSpec :
    toProjectiveSpace f hf hspan ≫ Proj.projectiveSpaceOverAffineToSpec σ A = toSpec I := by
  rw [toProjectiveSpace, Proj.projectiveSpaceOverAffineToSpec, ← Category.assoc,
    Proj.map_toSpecZero, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
    gradeZeroRingHom_reesGradedPresentation_comp, toSpec]

/-- **The affine blow-up along a finitely generated ideal factors through a projective
space over `Spec A` by a closed immersion.** This is the content of the blueprint's
projectivity statement that can be phrased in this Mathlib; see the module docstring for why
projectivity itself cannot.
(blueprint: `prop:nagata-affine-blowup-projective`, closed-immersion-plus-factorization
form) -/
theorem exists_isClosedImmersion_comp_projectiveSpaceOverAffineToSpec (hI : I.FG) :
    ∃ (σ : Type u) (_ : Finite σ) (e : AffineBlowup I ⟶ Proj.projectiveSpaceOverAffine σ A),
      IsClosedImmersion e ∧ e ≫ Proj.projectiveSpaceOverAffineToSpec σ A = toSpec I := by
  obtain ⟨s, hs⟩ := hI
  have hmem (i : { x // x ∈ s }) : (i : A) ∈ I := by
    rw [← hs]; exact Ideal.subset_span i.2
  have hspan : Ideal.span (Set.range fun i : { x // x ∈ s } ↦ (i : A)) = I := by
    rw [← hs]; congr 1; ext a; simp
  exact ⟨_, inferInstance, toProjectiveSpace _ hmem hspan,
    isClosedImmersion_toProjectiveSpace _ hmem hspan, toProjectiveSpace_toSpec _ hmem hspan⟩

end AffineBlowup

end AlgebraicGeometry
