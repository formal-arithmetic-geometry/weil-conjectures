module

public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.RingTheory.MvPolynomial.IrreducibleQuadratic
public import WeilConjectures.Blowup.Affine.ReesGrading

/-!

# The polynomial presentation of the Rees algebra

If the ideal `I : Ideal A` is generated by a family `f : σ → A`, the `A`-algebra map
`A[T] = MvPolynomial σ A → 𝓡_A(I)` sending `Tᵢ` to `fᵢ·X` is graded for the total-degree
grading on `A[T]` and the Rees grading on `𝓡_A(I)`, and it is surjective. Applying `Proj`
to it exhibits the affine blow-up `Bl_I(Spec A)` as a closed subscheme of the relative
projective space `ℙ^σ_A`.

## Main definitions

- `AlgebraicGeometry.reesPresentation` — the `A`-algebra map `A[T] → 𝓡_A(I)`, `Tᵢ ↦ fᵢ·X`.
- `AlgebraicGeometry.reesGradedPresentation` — the same map as a homomorphism of graded rings
  `MvPolynomial.homogeneousSubmodule σ A →+*ᵍ reesGrading I`.

## Main results

- `AlgebraicGeometry.reesPresentation_mem_reesGrading` — a form of degree `n` is mapped into
  the degree-`n` piece of the Rees algebra;
- `AlgebraicGeometry.reesPresentation_surjective` — if `f` generates `I`, the map is surjective.

## Blueprint

This file implements `def:nagata-rees-polynomial-map` and
`lemma:nagata-rees-polynomial-surjection` of the Nagata compactification blueprint.

-/

@[expose] public section

universe u v

open Polynomial

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] {σ : Type v} {I : Ideal A} (f : σ → A) (hf : ∀ i, f i ∈ I)

/-- The `A`-algebra map `A[T] → 𝓡_A(I)` sending the variable `Tᵢ` to the degree-one element
`fᵢ·X` of the Rees algebra, for a family `f : σ → A` of elements of `I`.
(blueprint: `def:nagata-rees-polynomial-map`) -/
noncomputable def reesPresentation : MvPolynomial σ A →ₐ[A] reesAlgebra I :=
  MvPolynomial.aeval fun i ↦ reesX I (f i) (hf i)

@[simp]
lemma reesPresentation_X (i : σ) :
    reesPresentation f hf (MvPolynomial.X i) = reesX I (f i) (hf i) := by
  simp [reesPresentation]

@[simp]
lemma reesPresentation_C (a : A) :
    reesPresentation f hf (MvPolynomial.C a) = algebraMap A (reesAlgebra I) a := by
  simp [reesPresentation]

/-- A monomial `c·T^d` is mapped to an element of the degree-`d.degree` piece of the Rees
algebra. -/
lemma reesPresentation_monomial_mem (d : σ →₀ ℕ) (c : A) :
    reesPresentation f hf (MvPolynomial.monomial d c) ∈ reesGrading I d.degree := by
  rw [reesPresentation, MvPolynomial.aeval_monomial, Finsupp.prod]
  have hprod : (∏ i ∈ d.support, reesX I (f i) (hf i) ^ d i) ∈ reesGrading I d.degree := by
    have := SetLike.prod_pow_mem_graded (reesGrading I) (fun _ : σ ↦ (1 : ℕ))
      (fun i ↦ reesX I (f i) (hf i)) (F := d.support) (fun i ↦ d i)
      fun i _ ↦ reesX_mem I (f i) (hf i)
    simpa [Finsupp.degree_apply] using this
  simpa using SetLike.mul_mem_graded (algebraMap_mem_reesGrading_zero I c) hprod

/-- The polynomial presentation of the Rees algebra is graded: a form of degree `n` is mapped
into the degree-`n` piece of the Rees algebra.
(blueprint: `lemma:nagata-rees-polynomial-surjection`, gradedness part) -/
lemma reesPresentation_mem_reesGrading {n : ℕ} {p : MvPolynomial σ A}
    (hp : p ∈ MvPolynomial.homogeneousSubmodule σ A n) :
    reesPresentation f hf p ∈ reesGrading I n := by
  classical
  rw [MvPolynomial.mem_homogeneousSubmodule] at hp
  have hsum : reesPresentation f hf p =
      ∑ d ∈ p.support, reesPresentation f hf (MvPolynomial.monomial d (p.coeff d)) := by
    conv_lhs => rw [p.as_sum]
    rw [map_sum]
  rw [hsum]
  refine sum_mem fun d hd ↦ ?_
  have hdeg : d.degree = n := by
    rw [Finsupp.degree_eq_weight_one]
    exact hp (MvPolynomial.mem_support_iff.mp hd)
  rw [← hdeg]
  exact reesPresentation_monomial_mem f hf d _

/-- The polynomial presentation of the Rees algebra as a homomorphism of graded rings, from
`A[T]` with its total-degree grading to `𝓡_A(I)` with its Rees grading.
(blueprint: `def:nagata-rees-polynomial-map`, graded form) -/
noncomputable def reesGradedPresentation :
    MvPolynomial.homogeneousSubmodule σ A →+*ᵍ reesGrading I where
  __ := (reesPresentation f hf).toRingHom
  map_mem hx := reesPresentation_mem_reesGrading f hf hx

@[simp]
lemma coe_reesGradedPresentation :
    ⇑(reesGradedPresentation f hf) = ⇑(reesPresentation f hf) :=
  rfl

/-- Evaluating the underlying polynomial of `reesPresentation f hf p` at `X = 1` recovers the
evaluation of `p` at the generators `f`. -/
lemma eval_one_coe_reesPresentation (p : MvPolynomial σ A) :
    ((reesPresentation f hf p : reesAlgebra I) : A[X]).eval 1 = MvPolynomial.eval f p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

/-- A form of degree `n` is mapped to the monomial `(p(f))·Xⁿ` of the Rees algebra. -/
lemma reesPresentation_eq_reesMonomial {n : ℕ} {p : MvPolynomial σ A}
    (hp : p ∈ MvPolynomial.homogeneousSubmodule σ A n)
    (h : MvPolynomial.eval f p ∈ I ^ n) :
    reesPresentation f hf p = reesMonomial I (MvPolynomial.eval f p) h := by
  obtain ⟨b, hb, hbe⟩ :=
    (mem_reesGrading_iff_exists I).mp (reesPresentation_mem_reesGrading f hf hp)
  have hval : b = MvPolynomial.eval f p := by
    rw [← eval_one_coe_reesPresentation f hf p, hbe]
    simp
  rw [hbe]
  exact Subtype.ext (by simp [hval])

/-- The polynomial presentation of the Rees algebra is surjective if the family `f` generates
the ideal `I`.
(blueprint: `lemma:nagata-rees-polynomial-surjection`, surjectivity part) -/
theorem reesPresentation_surjective (hspan : Ideal.span (Set.range f) = I) :
    Function.Surjective (reesPresentation f hf) := by
  classical
  have key : ∀ (n : ℕ) (a : A) (ha : a ∈ I ^ n),
      reesMonomial I a ha ∈ (reesPresentation f hf).range := by
    intro n a ha
    obtain ⟨p, hp, hpa⟩ :=
      (Ideal.mem_span_pow_iff_exists_isHomogeneous f a).mp (by rwa [hspan])
    subst hpa
    exact ⟨p, reesPresentation_eq_reesMonomial f hf hp ha⟩
  intro F
  have hcoeff : ∀ n, (F : A[X]).coeff n ∈ I ^ n := (mem_reesAlgebra_iff I (F : A[X])).mp F.2
  have hF : F = ∑ n ∈ (F : A[X]).support, reesMonomial I ((F : A[X]).coeff n) (hcoeff n) := by
    refine Subtype.ext ?_
    rw [AddSubmonoidClass.coe_finsetSum]
    simp only [coe_reesMonomial]
    exact (F : A[X]).as_sum_support
  rw [hF]
  exact (reesPresentation f hf).mem_range.mp (sum_mem fun n _ ↦ key n _ _)

/-- The polynomial presentation of the Rees algebra, as a homomorphism of graded rings, is
surjective if the family `f` generates the ideal `I`.
(blueprint: `lemma:nagata-rees-polynomial-surjection`) -/
theorem reesGradedPresentation_surjective (hspan : Ideal.span (Set.range f) = I) :
    Function.Surjective (reesGradedPresentation f hf) :=
  reesPresentation_surjective f hf hspan

end AlgebraicGeometry
