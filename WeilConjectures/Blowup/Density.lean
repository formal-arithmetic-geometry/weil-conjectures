module

public import WeilConjectures.Blowup.AdmissibleBlowup
public import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.SchemeTheoreticallyDominant

/-!

# Scheme-theoretic density is preserved by admissible blow-ups

This file proves the density-preservation lemma for admissible blow-ups
(blueprint: `lemma:nagata-admissible-blowup-preserves-density`; proof order item 20):

- `Scheme.IdealSheafData.IsInvertible.isSchemeTheoreticallyDominant_compl_support`:
  the complement of the support of an invertible ideal is scheme-theoretically
  dense — locally the restriction map is the localization at a nonzerodivisor;
- `Scheme.IdealSheafData.isSchemeTheoreticallyDominant_blowupMap_preimage_compl_support`:
  the inverse image of the complement of the center is scheme-theoretically dense in a
  blow-up, since the extension of the center to the blow-up is invertible
  (`Scheme.IdealSheafData.isInvertible_comap_blowupMap`);
- `AlgebraicGeometry.IsAdmissible.isSchemeTheoreticallyDominant_preimage_ι`: if `U`
  is a quasi-compact scheme-theoretically dense open of `X`, its inverse image under a
  `U`-admissible blow-up is scheme-theoretically dense in the total space.

It also proves the existence statement of the blueprint's
`lemma:nagata-conrad-schematically-dense-blowup`, in its absolute and relative forms:

- `AlgebraicGeometry.exists_isAdmissible_isSchemeTheoreticallyDominant_preimage`: for a
  quasi-compact open `U` of a qcqs scheme `X` there is a `U`-admissible blow-up in which
  the inverse image of `U` is scheme-theoretically dense — blow up a finite-type center
  supported exactly on the boundary `Uᶜ` (`Scheme.exists_finiteType_ideal_coe_support_eq_compl`,
  Stacks Tag 01PH);
- `AlgebraicGeometry.IsAdmissible.exists_comp_isSchemeTheoreticallyDominant_preimage`: the
  same, dominating a given `U`-admissible blow-up `B` — apply the absolute form on the
  total space of `B` and compose the two blow-ups (`IsAdmissible.exists_comp`, Stacks
  Tag 080L).

-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

namespace Scheme.IdealSheafData

variable {Y : Scheme.{u}}

/-- **The complement of an invertible ideal is scheme-theoretically dense**: on
an affine open where the ideal is generated by a single nonzerodivisor `a`, the
restriction map to the complement of the support is the localization map away from
`a`, which is injective. -/
theorem IsInvertible.isSchemeTheoreticallyDominant_compl_support
    {C : Y.IdealSheafData} (hC : C.IsInvertible) :
    IsSchemeTheoreticallyDominant (Scheme.Opens.ι C.support.compl) := by
  choose V hxV a ha hgen using hC
  constructor
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top V ?_ fun x ↦ ?_
  · rw [eq_top_iff]
    exact fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩
  · rw [Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, ← le_bot_iff]
    refine (Scheme.Hom.ideal_ker_le _ _).trans ?_
    rw [le_bot_iff, ← RingHom.injective_iff_ker_eq_bot]
    -- identify the target open of the restriction with the basic open of `a`
    have himg : Scheme.Opens.ι C.support.compl ''ᵁ
          (Scheme.Opens.ι C.support.compl ⁻¹ᵁ (V x).1) = Y.basicOpen (a x) := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      ext y
      have h1 := Set.ext_iff.mp (C.coe_support_inter (V x)) y
      have h2 : Y.zeroLocus (U := (V x).1) (C.ideal (V x) : Set _) =
          (Y.basicOpen (a x) : Set Y)ᶜ := by
        rw [hgen x, Y.zeroLocus_span, Y.zeroLocus_singleton]
      rw [h2] at h1
      constructor
      · rintro ⟨hy1, hy2⟩
        by_contra hyb
        exact (hy1 : y ∈ (↑C.support : Set Y)ᶜ) ((h1.mpr ⟨hyb, hy2⟩).1)
      · intro hyb
        have hyV : y ∈ (V x).1 := Y.basicOpen_le (a x) hyb
        refine ⟨fun hy ↦ ?_, hyV⟩
        exact (h1.mp ⟨hy, hyV⟩).1 hyb
    -- the restriction map is the localization away from the nonzerodivisor `a`
    have hfac : (homOfLE (Set.image_preimage_subset _ _) :
          Scheme.Opens.ι C.support.compl ''ᵁ
            (Scheme.Opens.ι C.support.compl ⁻¹ᵁ (V x).1) ⟶ (V x).1) =
        eqToHom himg ≫ homOfLE (Y.basicOpen_le (a x)) := Subsingleton.elim _ _
    rw [Scheme.Opens.ι_app, hfac, op_comp, Functor.map_comp, CommRingCat.hom_comp,
      RingHom.coe_comp]
    refine Function.Injective.comp ?_ ?_
    · have hiso : IsIso (Y.presheaf.map (eqToHom himg).op) := inferInstance
      exact ((ConcreteCategory.isIso_iff_bijective _).mp hiso).1
    · have := (V x).2.isLocalization_basicOpen (a x)
      have halg : algebraMap Γ(Y, (V x).1) Γ(Y, Y.basicOpen (a x)) =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (a x))).op).hom :=
        RingHom.algebraMap_toAlgebra _
      rw [← halg]
      exact IsLocalization.injective (M := Submonoid.powers (a x))
        Γ(Y, Y.basicOpen (a x)) (powers_le_nonZeroDivisors (ha x))

/-- **The complement of the center is scheme-theoretically dense in a blow-up**
(blueprint: `lemma:nagata-admissible-blowup-preserves-density`, blow-up part): the
inverse image of the complement of the support of `I` under `I.blowupMap` is
scheme-theoretically dense, because the extension of `I` to the blow-up is an
invertible ideal. -/
theorem isSchemeTheoreticallyDominant_blowupMap_preimage_compl_support
    (I : Y.IdealSheafData) :
    IsSchemeTheoreticallyDominant (I.blowupMap ⁻¹ᵁ I.support.compl).ι := by
  have he : I.blowupMap ⁻¹ᵁ I.support.compl = (I.comap I.blowupMap).support.compl := by
    ext y
    simp [Scheme.IdealSheafData.support_comap]
  rw [he]
  exact I.isInvertible_comap_blowupMap.isSchemeTheoreticallyDominant_compl_support

end Scheme.IdealSheafData

namespace IsAdmissible

variable {X : Scheme.{u}} {U : X.Opens} (B : IsAdmissible X U)

/-- **Scheme-theoretic density is preserved by admissible blow-ups** (blueprint:
`lemma:nagata-admissible-blowup-preserves-density`; proof order item 20): if `U` is a
quasi-compact scheme-theoretically dense open of `X`, then the inverse image of `U`
under any `U`-admissible blow-up is scheme-theoretically dense in the total space. -/
theorem isSchemeTheoreticallyDominant_preimage_ι [QuasiCompact U.ι]
    [IsSchemeTheoreticallyDominant U.ι] :
    IsSchemeTheoreticallyDominant (B.I.blowupMap ⁻¹ᵁ U).ι := by
  have := B.I.isSchemeTheoreticallyDominant_blowupMap_preimage_compl_support
  exact .preimage_ι_of_le B.I.blowupMap B.le_preservedOpen
    B.I.isIso_blowupMap_restrict_support_compl

/-- The blown-up scheme of an admissible blow-up of a Noetherian scheme is
Noetherian. -/
theorem isNoetherian_blowup [IsNoetherian X] : IsNoetherian B.I.blowup := by
  have := B.isProper_blowupMap
  have : IsLocallyNoetherian B.I.blowup :=
    LocallyOfFiniteType.isLocallyNoetherian B.I.blowupMap
  have : CompactSpace B.I.blowup := QuasiCompact.compactSpace_of_compactSpace B.I.blowupMap
  exact ⟨⟩

/-- **Topological density transports through an admissible blow-up**: the inverse
image of a dense subset of a Noetherian scheme is dense in any admissible blow-up.
The preimage of the complement of the center is scheme-theoretically, hence
topologically, dense, and the blow-up is an isomorphism there. -/
theorem dense_preimage_blowupMap [IsNoetherian X] {D : Set X} (hD : Dense D) :
    Dense (B.I.blowupMap ⁻¹' D) := by
  have : IsNoetherian B.I.blowup := B.isNoetherian_blowup
  have : CompactSpace (B.I.blowupMap ⁻¹ᵁ B.preservedOpen).toScheme :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact _)
  have : IsNoetherian (B.I.blowupMap ⁻¹ᵁ B.preservedOpen).toScheme := ⟨⟩
  -- the preimage of the preserved open is (scheme-theoretically, hence) dense
  have hPd : Dense ((B.I.blowupMap ⁻¹ᵁ B.preservedOpen : B.I.blowup.Opens) :
      Set B.I.blowup) := by
    have := B.I.isSchemeTheoreticallyDominant_blowupMap_preimage_compl_support
    have hdr : DenseRange (B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι :=
      Scheme.Hom.denseRange (B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι
    rwa [DenseRange, Scheme.Opens.range_ι] at hdr
  have hiso : IsIso (B.I.blowupMap ∣_ B.preservedOpen) :=
    B.I.isIso_blowupMap_restrict_support_compl
  rw [dense_iff_inter_open]
  rintro O' hO' hne
  -- `O'` meets the dense preimage of the preserved open
  obtain ⟨w, hwO', hwP⟩ := dense_iff_inter_open.mp hPd O' hO' hne
  -- transport the resulting nonempty open along the isomorphism over the preserved
  -- open, and intersect its image with `D`
  let H := Scheme.homeoOfIso (asIso (B.I.blowupMap ∣_ B.preservedOpen))
  have hopen : IsOpen (B.preservedOpen.ι ''
      (H '' ((B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι ⁻¹' O'))) :=
    B.preservedOpen.ι.isOpenEmbedding.isOpenMap _
      (H.isOpenMap _ (hO'.preimage (B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι.continuous))
  obtain ⟨d, hd, hdD⟩ := dense_iff_inter_open.mp hD _ hopen
    ⟨B.preservedOpen.ι (H ⟨w, hwP⟩), ⟨H ⟨w, hwP⟩, ⟨⟨w, hwP⟩, hwO', rfl⟩, rfl⟩⟩
  obtain ⟨-, ⟨v, hvO', rfl⟩, rfl⟩ := hd
  refine ⟨(B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι v, hvO', ?_⟩
  have hcomm : B.I.blowupMap ((B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι v) =
      B.preservedOpen.ι (H v) := by
    have h1 : ((B.I.blowupMap ∣_ B.preservedOpen) ≫ B.preservedOpen.ι) v =
        ((B.I.blowupMap ⁻¹ᵁ B.preservedOpen).ι ≫ B.I.blowupMap) v := by
      rw [morphismRestrict_ι]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    rw [← h1]
    congr 1
  exact Set.mem_preimage.mpr (hcomm ▸ hdD)

end IsAdmissible

/-- **A `U`-admissible blow-up in which `U` becomes scheme-theoretically dense**
(blueprint: `lemma:nagata-conrad-schematically-dense-blowup`, absolute form): for a
quasi-compact open `U` of a qcqs scheme `X` there is a `U`-admissible blow-up
`B.I.blowupMap` whose restriction over `U` is scheme-theoretically dense in the total
space.

Blow up a finite-type center supported exactly on the boundary `Uᶜ`
(`Scheme.exists_finiteType_ideal_coe_support_eq_compl`, Stacks Tag 01PH). Such a center
is `U`-admissible and its preserved open is `U` on the nose, so the density of the
inverse image of the complement of the center
(`Scheme.IdealSheafData.isSchemeTheoreticallyDominant_blowupMap_preimage_compl_support`)
is the assertion. -/
theorem exists_isAdmissible_isSchemeTheoreticallyDominant_preimage
    {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] {U : X.Opens}
    (hU : IsCompact (U : Set X)) :
    ∃ B : IsAdmissible X U, IsSchemeTheoreticallyDominant (B.I.blowupMap ⁻¹ᵁ U).ι := by
  obtain ⟨I, hIft, hIsupp⟩ := X.exists_finiteType_ideal_coe_support_eq_compl U hU
  have hdisj : Disjoint (U : Set X) (I.support : Set X) := by
    rw [hIsupp]; exact disjoint_compl_right
  have hcompl : I.support.compl = U := by
    apply TopologicalSpace.Opens.ext
    change (I.support : Set X)ᶜ = (U : Set X)
    rw [hIsupp, compl_compl]
  refine ⟨⟨I, hIft, hdisj⟩, ?_⟩
  have h := I.isSchemeTheoreticallyDominant_blowupMap_preimage_compl_support
  rwa [hcompl] at h

namespace IsAdmissible

/-- **A further `U`-admissible blow-up in which `U` becomes scheme-theoretically dense**
(blueprint: `lemma:nagata-conrad-schematically-dense-blowup`, relative form): given a
`U`-admissible blow-up `B` of a qcqs scheme `X` along a quasi-compact open `U`, there is
a `U`-admissible blow-up `B'` of `X` dominating it — a morphism `h : B'.I.blowup ⟶
B.I.blowup` over `X` — in which the inverse image of `U` is scheme-theoretically dense.

The total space of `B` is again qcqs and `B.I.blowupMap ⁻¹ᵁ U` is again quasi-compact
(`IsAdmissible.isProper_blowupMap`), so the absolute form
`exists_isAdmissible_isSchemeTheoreticallyDominant_preimage` applies to it; composing the
two blow-ups (`IsAdmissible.exists_comp`, Stacks Tag 080L) gives a `U`-admissible center
`K` on `X` together with an identification of the two total spaces over `X`, along which
the density transports. -/
theorem exists_comp_isSchemeTheoreticallyDominant_preimage
    {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] {U : X.Opens}
    (hU : IsCompact (U : Set X)) (B : IsAdmissible X U) :
    ∃ (B' : IsAdmissible X U) (h : B'.I.blowup ⟶ B.I.blowup),
      h ≫ B.I.blowupMap = B'.I.blowupMap ∧
      IsSchemeTheoreticallyDominant (B'.I.blowupMap ⁻¹ᵁ U).ι := by
  have := B.isProper_blowupMap
  have : CompactSpace B.I.blowup := QuasiCompact.compactSpace_of_compactSpace B.I.blowupMap
  have : QuasiSeparatedSpace B.I.blowup :=
    quasiSeparatedSpace_of_quasiSeparated B.I.blowupMap
  set V : B.I.blowup.Opens := B.I.blowupMap ⁻¹ᵁ U with hVdef
  have hV : IsCompact (V : Set B.I.blowup) :=
    QuasiCompact.isCompact_preimage (f := B.I.blowupMap) _ U.isOpen hU
  obtain ⟨B₂, hB₂⟩ := exists_isAdmissible_isSchemeTheoreticallyDominant_preimage hV
  obtain ⟨K, hKft, hKdisj, iso, hiso⟩ := B.exists_comp B₂
  have hK : K.blowupMap = iso.inv ≫ B₂.I.blowupMap ≫ B.I.blowupMap := by
    rw [← hiso, iso.inv_hom_id_assoc]
  refine ⟨⟨K, hKft, hKdisj⟩, iso.inv ≫ B₂.I.blowupMap, by rw [Category.assoc, ← hK], ?_⟩
  show IsSchemeTheoreticallyDominant (K.blowupMap ⁻¹ᵁ U).ι
  have hpre : K.blowupMap ⁻¹ᵁ U = iso.inv ⁻¹ᵁ (B₂.I.blowupMap ⁻¹ᵁ V) := by rw [hK]; rfl
  rw [hpre]
  exact .preimage_ι_of_isIso iso.inv _

end IsAdmissible

end AlgebraicGeometry
