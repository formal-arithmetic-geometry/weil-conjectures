module

public import WeilConjectures.Blowup.AdmissibleBlowup

/-!

# Deligne's disjointness blow-up

This file proves Deligne's *Lemme* 0.3, in the form of Conrad's Lemma 1.5 of
*Deligne's notes on Nagata compactifications* (blueprint:
`lemma:nagata-conrad-disjointness-blowup`, with the setting
`def:nagata-conrad-disjointness-setup`).

The setting is a morphism `p : Z ⟶ X`, a morphism `f : Y ⟶ Z` over `X` whose source lies
over an open `U ≤ V` of `X`, and two quasi-coherent ideals `I₁` and `I₂` of `X` with

* `V ∖ U ⊆ V(I₁)` as sets, so that `T₁ = V(I₁ * I₁)` is a square-zero thickening of a
  closed subscheme containing the boundary of `U` inside `V`;
* `V(I₂) ⊆ X ∖ V` as sets;
* the closed subscheme `p ⁻¹ T₁ ⊓ Ȳ` of `Z` factors through `p ⁻¹ T₂`, where `Ȳ` is the
  scheme-theoretic image of `f`; in ideal sheaf language this is
  `I₂.comap p ≤ (I₁ * I₁).comap p ⊔ f.ker`.

After blowing up `I₁ ⊔ I₂` and base changing everything along the blow-up map `q`, the
scheme-theoretic image of the base change of `f` no longer meets the part of the base
change of `Z` lying over the closure of `q ⁻¹ (V ∖ U)`.

## Main results

- `AlgebraicGeometry.disjoint_closure_range_of_blowupMap_sup`: the disjointness statement
  itself, with the scheme-theoretic image written as the closure of the range
  (blueprint: `lemma:nagata-conrad-disjointness-blowup`). To read the conclusion in
  ideal-sheaf language instead, rewrite with `Scheme.Hom.support_ker`.

## Implementation notes

The proof is Conrad's affine chart computation, split into two probe lemmas.

`AlgebraicGeometry.disjoint_range_closure_preimage_sdiff_of_probe` handles the charts of
`Bl_{I₁ ⊔ I₂}(X)` at sections of `I₁`: on such a chart the inverse images of `I₁` and of
`I₁ ⊔ I₂` have the same support, so a point of the chart lying over `V(I₁)` lies over
`V(I₂)` as well, which is disjoint from `V`. Hence such a chart misses `q ⁻¹ (V ∖ U)`
altogether, and therefore also its closure. The charts at sections of `I₂` are thus the
only ones that matter, by `Scheme.IdealSheafData.exists_mem_range_chart_sup`; this is
Conrad's Lemma 1.4 in the shape the branch already provides.

`AlgebraicGeometry.false_of_probe_of_mem_closure_range` is the computation on a chart at a
section `s₂` of `I₂`, run on an affine probe `Spec R ⟶ Z'` of the base change lying over
the chart. There the extended centre is generated by the image `σ` of `s₂`, so the
factorization hypothesis reads `σ ∈ σ · a₁ + n` with `a₁` the extension of `I₁` and `n` the
kernel of the base change of `f`; that is, `σ * (1 - h) ∈ n` with `h ∈ a₁`. Since the
source of `f` lies over `U`, which misses `V(I₁ ⊔ I₂)`, the extension of the centre to the
base change of `Y` is the unit ideal, so multiplying by `σ` does not change the kernel and
`1 - h ∈ n`. Then `1 = h + (1 - h)` shows that the inverse images of `I₁` and the kernel
generate the unit ideal on the probe, so their supports do not meet — which is exactly the
assertion at the chosen point.

-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

section Probes

/-- **The charts at sections of the first centre miss the boundary**: on an affine probe of
`Bl_{I₁ ⊔ I₂}(X)` over an affine open `W` of `X` on which the extended centre is generated
by the image of a section of `I₁`, the inverse images of `I₁` and of `I₁ ⊔ I₂` have the
same support. A point of the probe over `V ∖ U` would therefore lie over `V(I₂)`, which is
disjoint from `V`; so the probe misses `q ⁻¹ (V ∖ U)` and, being open, also its closure. -/
lemma disjoint_range_closure_preimage_sdiff_of_probe (I₁ I₂ : X.IdealSheafData)
    {U V : X.Opens} (hI₂V : (I₂.support : Set X) ⊆ (V : Set X)ᶜ)
    (hVU : (V : Set X) \ (U : Set X) ⊆ (I₁.support : Set X))
    (W : X.affineOpens) {b : Γ(X, W.1)} (hb : b ∈ I₁.ideal W)
    {S : CommRingCat.{u}} (φ : Γ(X, W.1) ⟶ S)
    (hspan : ((I₁ ⊔ I₂).ideal W).map φ.hom = Ideal.span {φ.hom b})
    (c : Spec S ⟶ (I₁ ⊔ I₂).blowup) [IsOpenImmersion c]
    (hcomp : c ≫ (I₁ ⊔ I₂).blowupMap = Spec.map φ ≫ W.2.fromSpec) :
    Disjoint (Set.range c)
      (closure ((I₁ ⊔ I₂).blowupMap ⁻¹' ((V : Set X) \ (U : Set X)))) := by
  refine Disjoint.closure_right ?_ ?_
  · rw [Set.disjoint_left]
    rintro _ ⟨y, rfl⟩ hy
    have hpt : (I₁ ⊔ I₂).blowupMap (c y) = (Spec.map φ ≫ W.2.fromSpec) y := by
      rw [← Scheme.Hom.comp_apply, hcomp]
    have hbase : (Spec.map φ ≫ W.2.fromSpec) y ∈ (I₁.support : Set X) := by
      rw [← hpt]; exact hVU hy
    have hbaseV : (Spec.map φ ≫ W.2.fromSpec) y ∈ (V : Set X) := by
      rw [← hpt]; exact hy.1
    have hle := Scheme.IdealSheafData.comap_le_comap_of_ideal_map_eq_span
      (I₁ ⊔ I₂) I₁ W hb φ hspan
    have hmem₁ : y ∈ ((I₁.comap (Spec.map φ ≫ W.2.fromSpec)).support : Set (Spec S)) := by
      rw [Scheme.IdealSheafData.coe_support_comap]
      exact hbase
    have hmem₂ : y ∈ (((I₁ ⊔ I₂).comap (Spec.map φ ≫ W.2.fromSpec)).support : Set (Spec S)) :=
      Scheme.IdealSheafData.support_antitone hle hmem₁
    rw [Scheme.IdealSheafData.coe_support_comap, Set.mem_preimage,
      Scheme.IdealSheafData.coe_support_sup] at hmem₂
    exact hI₂V hmem₂.2 hbaseV
  · rw [← Scheme.Hom.coe_opensRange]
    exact c.opensRange.isOpen

/-- **The affine computation behind the disjointness blow-up**: the chart at a section `b`
of `I₂`, probed by an affine scheme `Spec R` over the chart.

Concretely `κ : Spec R ⟶ Z'` is an affine probe of the base change `Z'` of `Z` whose
composite to `X` factors through the chart probe `Spec φ ≫ fromSpec` of the blow-up, and
`y` is a point of `Spec R` lying both in the scheme-theoretic image of the base change of
`f` and over the support of `I₁`. Such a point cannot exist. -/
lemma false_of_probe_of_mem_closure_range {Z Y Z' Y' : Scheme.{u}} {p : Z ⟶ X} {f : Y ⟶ Z}
    {U : X.Opens} {I₁ I₂ : X.IdealSheafData}
    (hKU : ((I₁ ⊔ I₂).support : Set X) ⊆ (U : Set X)ᶜ)
    (hYU : Set.range (f ≫ p) ⊆ (U : Set X))
    (hfac : I₂.comap p ≤ (I₁ * I₁).comap p ⊔ f.ker)
    {r : Z' ⟶ Z} {p' : Z' ⟶ (I₁ ⊔ I₂).blowup}
    (hw : r ≫ p = p' ≫ (I₁ ⊔ I₂).blowupMap)
    {fY : Y' ⟶ Y} {f' : Y' ⟶ Z'} [QuasiCompact f'] (hcomm : f' ≫ r = fY ≫ f)
    (W : X.affineOpens) {b : Γ(X, W.1)} (hb : b ∈ I₂.ideal W)
    {S R : CommRingCat.{u}} (φ : Γ(X, W.1) ⟶ S)
    (hspan : ((I₁ ⊔ I₂).ideal W).map φ.hom = Ideal.span {φ.hom b})
    (κ : Spec R ⟶ Z') [Flat κ] (μ : Spec R ⟶ Spec S)
    (hfactor : κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap = μ ≫ Spec.map φ ≫ W.2.fromSpec)
    (y : Spec R) (hy₁ : (I₁ ⊔ I₂).blowupMap (p' (κ y)) ∈ (I₁.support : Set X))
    (hy₂ : κ y ∈ closure (Set.range f')) : False := by
  -- The kernel of `f` pulls back into the kernel of its base change `f'`.
  have hkerle : f.ker.comap r ≤ f'.ker := by
    refine Scheme.IdealSheafData.le_ker_of_comap_eq_bot _ ?_
    rw [← Scheme.IdealSheafData.comap_comp, hcomm, Scheme.IdealSheafData.comap_comp,
      Scheme.Hom.comap_ker_self, Scheme.IdealSheafData.comap_bot]
  -- The ideals of sections of the inverse images on the probe.
  have hideal : ∀ J : X.IdealSheafData,
      (J.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ =
        (((J.ideal W).map φ.hom).map (Scheme.ΓSpecIso S).inv.hom).map μ.appTop.hom := by
    intro J
    rw [hfactor, Scheme.IdealSheafData.comap_comp,
      Scheme.IdealSheafData.ideal_top_comap_of_isAffine,
      Scheme.IdealSheafData.ideal_top_comap_specMap_fromSpec J W φ]
  -- The generator of the extended centre on the chart.
  have hK : ((I₁ ⊔ I₂).comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal
        ⟨⊤, isAffineOpen_top (Spec R)⟩ =
      Ideal.span {μ.appTop.hom ((Scheme.ΓSpecIso S).inv.hom (φ.hom b))} := by
    rw [hideal, hspan, Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
  have hb₂ : μ.appTop.hom ((Scheme.ΓSpecIso S).inv.hom (φ.hom b)) ∈
      (I₂.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ := by
    rw [hideal]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hb))
  have hleW : I₁.ideal W ≤ (I₁ ⊔ I₂).ideal W := by
    rw [congrFun (Scheme.IdealSheafData.ideal_sup (I := I₁) (J := I₂)) W, Pi.sup_apply]
    exact le_sup_left
  have h₁le : (I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ ≤
      Ideal.span {μ.appTop.hom ((Scheme.ΓSpecIso S).inv.hom (φ.hom b))} := by
    rw [← hK, hideal, hideal]
    exact Ideal.map_mono (Ideal.map_mono (Ideal.map_mono hleW))
  -- Transport the factorization hypothesis to the probe.
  have hstep : I₂.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) ≤
      I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) * I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) ⊔
        f'.ker.comap κ := by
    have hπ : ∀ J : X.IdealSheafData, J.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) =
        (J.comap p).comap (κ ≫ r) := by
      intro J
      rw [← Scheme.IdealSheafData.comap_comp]
      congr 1
      rw [Category.assoc, hw]
    rw [← Scheme.IdealSheafData.comap_mul, hπ I₂, hπ (I₁ * I₁)]
    refine le_trans (Scheme.IdealSheafData.comap_mono _ hfac) ?_
    simp only [Scheme.IdealSheafData.comap_sup]
    refine sup_le_sup_left ?_ _
    rw [Scheme.IdealSheafData.comap_comp]
    exact Scheme.IdealSheafData.comap_mono _ hkerle
  have hstepI := Scheme.IdealSheafData.le_def.mp hstep ⟨⊤, isAffineOpen_top (Spec R)⟩
  simp only [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Scheme.IdealSheafData.ideal_mul,
    Pi.mul_apply] at hstepI
  -- Divide the factorization identity by the generator.
  have hσmem := hstepI hb₂
  have h11 : (I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ *
      (I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ ≤
      Ideal.span {μ.appTop.hom ((Scheme.ΓSpecIso S).inv.hom (φ.hom b))} *
        (I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ :=
    Ideal.mul_mono h₁le le_rfl
  obtain ⟨z, hz, g, hg, hzg⟩ :=
    Submodule.mem_sup.mp (sup_le_sup_right h11 _ hσmem)
  obtain ⟨h, hh, rfl⟩ := Ideal.mem_span_singleton_mul.mp hz
  have hgeq : μ.appTop.hom ((Scheme.ΓSpecIso S).inv.hom (φ.hom b)) * (1 - h) = g := by
    linear_combination -hzg
  -- The extended centre becomes the unit ideal on the base change of `Y`.
  have hmor : pullback.snd f' κ ≫ κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap =
      (pullback.fst f' κ ≫ fY) ≫ (f ≫ p) := by
    calc pullback.snd f' κ ≫ κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap
        = (pullback.snd f' κ ≫ κ) ≫ (p' ≫ (I₁ ⊔ I₂).blowupMap) := by
          simp only [Category.assoc]
      _ = (pullback.fst f' κ ≫ f') ≫ (r ≫ p) := by rw [pullback.condition, hw]
      _ = pullback.fst f' κ ≫ ((f' ≫ r) ≫ p) := by simp only [Category.assoc]
      _ = (pullback.fst f' κ ≫ fY) ≫ (f ≫ p) := by rw [hcomm]; simp only [Category.assoc]
  have hemp : ∀ w : ↥(pullback f' κ),
      (pullback.snd f' κ ≫ κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) w ∉ ((I₁ ⊔ I₂).support : Set X) := by
    intro w
    rw [hmor, Scheme.Hom.comp_apply]
    exact fun hmem ↦ hKU hmem (hYU ⟨_, rfl⟩)
  have hunit : ((I₁ ⊔ I₂).comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).comap (pullback.snd f' κ) =
      ⊤ := by
    rw [← Scheme.IdealSheafData.comap_comp]
    refine top_le_iff.mp (Scheme.IdealSheafData.le_def.mpr fun T ↦ ?_)
    refine le_of_eq (Scheme.IdealSheafData.ideal_eq_top_of_disjoint_support _ ?_).symm
    rw [Set.disjoint_right]
    intro w hw
    rw [Scheme.IdealSheafData.coe_support_comap, Set.mem_preimage] at hw
    exact absurd hw (hemp w)
  -- Hence `1 - h` lies in the kernel of the base change of `f`.
  have hker'' : (pullback.snd f' κ).ker = f'.ker.comap κ := Scheme.Hom.ker_pullback_snd f' κ
  have hmulle : (I₁ ⊔ I₂).comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) *
      Scheme.IdealSheafData.ofIdealTop (Ideal.span {(1 : Γ(Spec R, ⊤)) - h}) ≤
        (pullback.snd f' κ).ker := by
    refine Scheme.IdealSheafData.le_of_isAffine ?_
    rw [hker'']
    simp only [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, hK,
      Scheme.IdealSheafData.ideal_top_ofIdealTop,
      Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_le_iff_mem, hgeq]
    exact hg
  have hbot : (Scheme.IdealSheafData.ofIdealTop
      (Ideal.span {(1 : Γ(Spec R, ⊤)) - h})).comap (pullback.snd f' κ) = ⊥ := by
    have hle := Scheme.IdealSheafData.comap_mono (pullback.snd f' κ) hmulle
    simp only [Scheme.IdealSheafData.comap_mul] at hle
    rw [hunit, Scheme.IdealSheafData.top_mul, Scheme.Hom.comap_ker_self] at hle
    exact le_bot_iff.mp hle
  have h1mh : (1 : Γ(Spec R, ⊤)) - h ∈ (f'.ker.comap κ).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ := by
    have hle := Scheme.IdealSheafData.le_ker_of_comap_eq_bot _ hbot
    rw [hker''] at hle
    refine Scheme.IdealSheafData.le_def.mp hle ⟨⊤, isAffineOpen_top (Spec R)⟩ ?_
    rw [Scheme.IdealSheafData.ideal_top_ofIdealTop]
    exact Ideal.mem_span_singleton_self _
  -- The two inverse images generate the unit ideal, so their supports do not meet.
  have hone : (1 : Γ(Spec R, ⊤)) ∈
      (I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ ⊔
        (f'.ker.comap κ).ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ := by
    have hsum : h + ((1 : Γ(Spec R, ⊤)) - h) = 1 := by ring
    rw [← hsum]
    exact Submodule.add_mem_sup hh h1mh
  have htop : (⊤ : (Spec R).IdealSheafData) ≤
      I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap) ⊔ f'.ker.comap κ := by
    refine Scheme.IdealSheafData.le_of_isAffine ?_
    simp only [Scheme.IdealSheafData.ideal_top, Pi.top_apply, Scheme.IdealSheafData.ideal_sup,
      Pi.sup_apply]
    exact ((Ideal.eq_top_iff_one _).mpr hone).ge
  have hsupp := congrArg Scheme.IdealSheafData.support (top_le_iff.mp htop)
  rw [Scheme.IdealSheafData.support_sup, Scheme.IdealSheafData.support_top] at hsupp
  -- The point `y` lies in both supports.
  have hy₁' : y ∈ ((I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).support : Set (Spec R)) := by
    rw [Scheme.IdealSheafData.coe_support_comap, Set.mem_preimage]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    exact hy₁
  have hy₂' : y ∈ ((f'.ker.comap κ).support : Set (Spec R)) := by
    rw [Scheme.IdealSheafData.coe_support_comap, Set.mem_preimage, Scheme.Hom.support_ker]
    exact hy₂
  have hmem : y ∈ ((I₁.comap (κ ≫ p' ≫ (I₁ ⊔ I₂).blowupMap)).support ⊓
      (f'.ker.comap κ).support : TopologicalSpace.Closeds (Spec R)) := ⟨hy₁', hy₂'⟩
  rw [hsupp] at hmem
  exact hmem

end Probes

/-- **Deligne's disjointness blow-up** (Deligne, *Lemme* 0.3; Conrad, Lemma 1.5; blueprint:
`lemma:nagata-conrad-disjointness-blowup`).

Differences from the informal statement: the base change is not required to be the chosen
fibre product — any commuting squares `hw` for `Z'` and `hcomm` for `Y'` will do, so the
statement applies to whatever model of the base change the caller has at hand — and the
scheme-theoretic image of `f'` is expressed as the closure of its range, which is what the
quasi-compactness of `f'` makes it. -/
theorem disjoint_closure_range_of_blowupMap_sup {Z Y Z' Y' : Scheme.{u}} {p : Z ⟶ X}
    {f : Y ⟶ Z} {U V : X.Opens} (hUV : U ≤ V) {I₁ I₂ : X.IdealSheafData}
    (hI₂V : (I₂.support : Set X) ⊆ (V : Set X)ᶜ)
    (hVU : (V : Set X) \ (U : Set X) ⊆ (I₁.support : Set X))
    (hYU : Set.range (f ≫ p) ⊆ (U : Set X))
    (hfac : I₂.comap p ≤ (I₁ * I₁).comap p ⊔ f.ker)
    {r : Z' ⟶ Z} {p' : Z' ⟶ (I₁ ⊔ I₂).blowup}
    (hw : r ≫ p = p' ≫ (I₁ ⊔ I₂).blowupMap)
    {fY : Y' ⟶ Y} {f' : Y' ⟶ Z'} [QuasiCompact f'] (hcomm : f' ≫ r = fY ≫ f) :
    Disjoint (closure (Set.range f'))
      (p' ⁻¹' closure ((I₁ ⊔ I₂).blowupMap ⁻¹' ((V : Set X) \ (U : Set X)))) := by
  -- The support of the composite centre is disjoint from `U`.
  have hKU : ((I₁ ⊔ I₂).support : Set X) ⊆ (U : Set X)ᶜ := by
    rw [Scheme.IdealSheafData.coe_support_sup]
    exact fun x hx hxU ↦ hI₂V hx.2 (hUV hxU)
  rw [Set.disjoint_left]
  intro x hx hxb
  -- The image of `x` lies over the support of `I₁`.
  have hxI₁ : (I₁ ⊔ I₂).blowupMap (p' x) ∈ (I₁.support : Set X) := by
    refine closure_minimal (Set.preimage_mono hVU)
      (I₁.support.isClosed.preimage (I₁ ⊔ I₂).blowupMap.continuous) hxb
  -- Pick a chart of the blow-up around the image of `x`.
  obtain ⟨W, b, hbK, hb12, hxc⟩ :=
    Scheme.IdealSheafData.exists_mem_range_chart_sup I₁ I₂ (p' x)
  have hspan : ((I₁ ⊔ I₂).ideal W).map (CommRingCat.ofHom
      (AffineBlowup.awayAlgebraMap ((I₁ ⊔ I₂).ideal W)
        (reesX ((I₁ ⊔ I₂).ideal W) b hbK))).hom =
      Ideal.span {(CommRingCat.ofHom (AffineBlowup.awayAlgebraMap ((I₁ ⊔ I₂).ideal W)
        (reesX ((I₁ ⊔ I₂).ideal W) b hbK))).hom b} := by
    rw [CommRingCat.hom_ofHom]
    exact AffineBlowup.map_awayAlgebraMap_reesX_eq_span_singleton ((I₁ ⊔ I₂).ideal W) b hbK
  have hcomp := (I₁ ⊔ I₂).blowupChart_comp_blowupMap W hbK
  rcases hb12 with hb | hb
  · -- A chart at a section of `I₁` misses the boundary altogether.
    exact Set.disjoint_left.mp (disjoint_range_closure_preimage_sdiff_of_probe
      I₁ I₂ hI₂V hVU W hb _ hspan _ hcomp) hxc hxb
  -- A chart at a section of `I₂`: run the affine computation on an affine probe of `Z'`.
  have hxW : (p' ≫ (I₁ ⊔ I₂).blowupMap) x ∈ (W.1 : Set X) := by
    obtain ⟨y₀, hy₀⟩ := hxc
    have hy₀' : W.2.fromSpec ((Spec.map (CommRingCat.ofHom
        (AffineBlowup.awayAlgebraMap ((I₁ ⊔ I₂).ideal W)
          (reesX ((I₁ ⊔ I₂).ideal W) b hbK)))) y₀) ∈ Set.range W.2.fromSpec := ⟨_, rfl⟩
    rw [W.2.range_fromSpec] at hy₀'
    rwa [Scheme.Hom.comp_apply, ← hy₀, ← Scheme.Hom.comp_apply, hcomp, Scheme.Hom.comp_apply]
  obtain ⟨-, ⟨Ω, hΩ, rfl⟩, hxΩ, hΩsub⟩ :=
    Z'.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ ((p' ⁻¹ᵁ ((I₁ ⊔ I₂).blowupChart W hbK).opensRange ⊓
          (p' ≫ (I₁ ⊔ I₂).blowupMap) ⁻¹ᵁ W.1 : Z'.Opens) : Set Z') from ⟨hxc, hxW⟩)
      (p' ⁻¹ᵁ ((I₁ ⊔ I₂).blowupChart W hbK).opensRange ⊓
        (p' ≫ (I₁ ⊔ I₂).blowupMap) ⁻¹ᵁ W.1).isOpen
  obtain ⟨y, hy⟩ : x ∈ Set.range hΩ.fromSpec := by rw [hΩ.range_fromSpec]; exact hxΩ
  have hμr : Set.range (hΩ.fromSpec ≫ p') ⊆
      Set.range ((I₁ ⊔ I₂).blowupChart W hbK) := by
    rintro _ ⟨z, rfl⟩
    have hz : hΩ.fromSpec z ∈ (Ω : Set Z') := by
      rw [← hΩ.range_fromSpec]; exact ⟨z, rfl⟩
    have hz' := hΩsub hz
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff] at hz'
    rw [Scheme.Hom.comp_apply]
    exact hz'.1
  have hμ : IsOpenImmersion.lift ((I₁ ⊔ I₂).blowupChart W hbK) (hΩ.fromSpec ≫ p') hμr ≫
      (I₁ ⊔ I₂).blowupChart W hbK = hΩ.fromSpec ≫ p' :=
    IsOpenImmersion.lift_fac _ _ hμr
  refine false_of_probe_of_mem_closure_range hKU hYU hfac hw hcomm W hb _ hspan
    hΩ.fromSpec (IsOpenImmersion.lift ((I₁ ⊔ I₂).blowupChart W hbK) (hΩ.fromSpec ≫ p') hμr)
    ?_ y ?_ ?_
  · rw [← hcomp]
    simp only [← Category.assoc, hμ]
  · rw [hy]; exact hxI₁
  · rw [hy]; exact hx

end AlgebraicGeometry
