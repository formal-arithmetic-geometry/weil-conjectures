module

public import WeilConjectures.Mathlib.RingTheory.Unramified.Basic
public import WeilConjectures.Mathlib.RingTheory.Idempotents

/-!
# Rigidity of maps out of unramified algebras

Let `S` be a formally unramified `R`-algebra, essentially of finite type. Two `R`-algebra maps
`f g : S → C` which agree modulo every maximal ideal of `C` are equal
(`Algebra.FormallyUnramified.algHom_eq_of_forall_isMaximal`): the ideal generated by the
`f s - g s` is generated by an idempotent, which lies in the Jacobson radical of `C`.

This is the rigidity input of the trait case of blueprint `sbc-thm-spreading-finite-etale-galois`
([Stacks 0EYJ]).
-/

@[expose] public section

namespace Algebra.FormallyUnramified

variable {R S C : Type*} [CommRing R] [CommRing S] [CommRing C] [Algebra R S] [Algebra R C]
  [EssFiniteType R S] [FormallyUnramified R S]

/-- **Rigidity.** Two `R`-algebra maps `f g : S → C` out of a formally unramified `R`-algebra
`S` of essentially finite type which agree modulo every maximal ideal of `C` are equal. -/
theorem algHom_eq_of_forall_isMaximal (f g : S →ₐ[R] C)
    (h : ∀ (m : Ideal C), m.IsMaximal → ∀ s, f s - g s ∈ m) : f = g := by
  obtain ⟨e, he, hsp⟩ := exists_isIdempotentElem_span_range_sub f g
  have hmem : e ∈ Ideal.jacobson (⊥ : Ideal C) := by
    refine Ideal.mem_sInf.2 fun m ⟨_, hm⟩ ↦ ?_
    have : Ideal.span {e} ≤ m := by
      rw [← hsp, Ideal.span_le]
      rintro _ ⟨s, rfl⟩
      exact h m hm s
    exact this (Ideal.mem_span_singleton_self e)
  have he0 := he.eq_zero_of_mem_jacobson_bot hmem
  refine AlgHom.ext fun s ↦ sub_eq_zero.1 ?_
  have : f s - g s ∈ Ideal.span {e} := hsp ▸ Ideal.subset_span ⟨s, rfl⟩
  rwa [he0, Ideal.span_singleton_eq_bot.2 rfl, Ideal.mem_bot] at this

/-- Variant of `Algebra.FormallyUnramified.algHom_eq_of_forall_isMaximal` for ring maps `f g`
which agree on `R`. -/
theorem ringHom_eq_of_forall_isMaximal (f g : S →+* C)
    (hfg : f.comp (algebraMap R S) = g.comp (algebraMap R S))
    (h : ∀ (m : Ideal C), m.IsMaximal → ∀ s, f s - g s ∈ m) : f = g := by
  letI : Algebra R C := (f.comp (algebraMap R S)).toAlgebra
  let f' : S →ₐ[R] C := { f with commutes' := fun _ ↦ rfl }
  let g' : S →ₐ[R] C := { g with commutes' := fun r ↦ (congr($hfg r)).symm }
  have := algHom_eq_of_forall_isMaximal f' g' h
  exact RingHom.ext fun s ↦ congr($this s)

/-- Two `R`-algebra maps `f g : S → C` from a formally unramified `R`-algebra `S` of essentially
finite type to a local ring which agree modulo the maximal ideal are equal. -/
theorem algHom_eq_of_isLocalRing [IsLocalRing C] (f g : S →ₐ[R] C)
    (h : ∀ s, f s - g s ∈ IsLocalRing.maximalIdeal C) : f = g :=
  algHom_eq_of_forall_isMaximal f g fun m hm s ↦ by
    rw [IsLocalRing.eq_maximalIdeal hm]
    exact h s

end Algebra.FormallyUnramified
