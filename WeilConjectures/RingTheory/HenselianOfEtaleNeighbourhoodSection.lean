module

public import WeilConjectures.RingTheory.HenselianOfEtaleSectionLifting
public import Mathlib.RingTheory.Spectrum.Prime.Topology
import WeilConjectures.RingTheory.EtaleSectionCore
import Mathlib.RingTheory.TensorProduct.Quotient
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Henselian pairs from sections of étale neighbourhoods of the closed set

Let `A` be a ring and `I` an ideal. Suppose every étale `A`-algebra `A'` whose spectrum maps
onto `V(I)` admits an `A`-algebra map `A' → A`. Then `(A, I)` is a henselian pair.

Given an étale `A`-algebra `A'` with an `A`-algebra map `σ : A' → A ⧸ I`, the kernel of the
induced section of `(A ⧸ I) ⊗[A] A'` is generated by `1 - e` for an idempotent `e`
(`Algebra.Etale.exists_idempotent_core`). Writing `e = 1 ⊗ g`, the localization `A'_g` maps
onto `V(I)` through `σ`, and every `A`-algebra map `A'_g → A ⧸ I` agrees with the one induced by
`σ`. So a section `A'_g → A` lifts `σ`, and Stacks Tag 09XI applies.
-/

@[expose] public section

universe u

open TensorProduct

namespace Algebra

private theorem exists_one_tmul_eq {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (I : Ideal A) (t : (A ⧸ I) ⊗[A] B) : ∃ b : B, (1 : A ⧸ I) ⊗ₜ[A] b = t := by
  obtain ⟨x, hx⟩ := (TensorProduct.quotIdealMapEquivQuotTensor B I).surjective t
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact ⟨b, hx⟩

private theorem mem_map_of_one_tmul_eq_zero {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (I : Ideal A) {b : B} (hb : (1 : A ⧸ I) ⊗ₜ[A] b = 0) :
    b ∈ I.map (algebraMap A B) := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  apply (TensorProduct.quotIdealMapEquivQuotTensor B I).injective
  rw [map_zero]
  exact hb

/-- **Henselian pairs from sections of étale neighbourhoods.** If every étale `A`-algebra whose
spectrum maps onto `V(I)` has an `A`-algebra section, then `(A, I)` is a henselian pair.
Source: Stacks Project, Tag 09XI, (5) implies (2). -/
theorem henselianRing_of_etale_surjective_zeroLocus_section (A : Type u) [CommRing A]
    (I : Ideal A)
    (h : ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [Algebra.Etale A A'],
      (∀ p : PrimeSpectrum A, I ≤ p.asIdeal →
        ∃ q : PrimeSpectrum A', PrimeSpectrum.comap (algebraMap A A') q = p) →
      Nonempty (A' →ₐ[A] A)) :
    HenselianRing A I := by
  refine (henselianRing_of_etale_section_lifting.{u, u} A I ?_).2.1
  intro A' _ _ _ σ
  let σT : (A ⧸ I) ⊗[A] A' →ₐ[A ⧸ I] A ⧸ I :=
    Algebra.TensorProduct.lift (AlgHom.id (A ⧸ I) (A ⧸ I)) σ fun _ _ ↦ Commute.all _ _
  have hσT (b : A') : σT ((1 : A ⧸ I) ⊗ₜ[A] b) = σ b := by
    simp [σT, Algebra.TensorProduct.lift_tmul]
  obtain ⟨e, he, hσe, hker, -⟩ := Algebra.Etale.exists_idempotent_core σT
  obtain ⟨g, rfl⟩ := exists_one_tmul_eq I e
  have hσg : IsUnit (σ g) := by rw [← hσT, hσe]; exact isUnit_one
  let A'' := Localization.Away g
  let σ'' : A'' →ₐ[A] A ⧸ I := IsLocalization.Away.liftAlgHom g hσg
  have hσ'' (b : A') : σ'' (algebraMap A' A'' b) = σ b := by
    simp [σ'', IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift]
  -- Every `A`-algebra map `A'' → A ⧸ I` vanishes on the kernel of `σ''`.
  have hkill (ψ : A'' →ₐ[A] A ⧸ I) (z : A'') (hz : σ'' z = 0) : ψ z = 0 := by
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers g) z
    have hb : σ b = 0 := by
      have hz' : σ'' (IsLocalization.mk' (Localization.Away g) b s) = 0 := hz
      rw [← hσ'', ← IsLocalization.mk'_spec (Localization.Away g) b s, map_mul, hz', zero_mul]
    have hb' : (1 : A ⧸ I) ⊗ₜ[A] b ∈ RingHom.ker σT.toRingHom := by
      rw [RingHom.mem_ker]
      exact (hσT b).trans hb
    rw [hker, Ideal.mem_span_singleton'] at hb'
    obtain ⟨c, hc⟩ := hb'
    have hgb : (1 : A ⧸ I) ⊗ₜ[A] (g * b) = 0 := by
      rw [← mul_one (1 : A ⧸ I), ← Algebra.TensorProduct.tmul_mul_tmul, ← hc, mul_comm c,
        ← mul_assoc, mul_sub, mul_one, he.eq, sub_self, zero_mul]
    have hmem := mem_map_of_one_tmul_eq_zero I hgb
    let ψ' := ψ.comp (IsScalarTower.toAlgHom A A' A'')
    have hψ' : I.map (algebraMap A A') ≤ RingHom.ker ψ'.toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
    have h0 : ψ (algebraMap A' A'' g) * ψ (algebraMap A' A'' b) = 0 := by
      rw [← map_mul, ← map_mul]
      exact hψ' hmem
    have hu : IsUnit (ψ (algebraMap A' A'' g)) :=
      (IsLocalization.Away.algebraMap_isUnit g).map ψ
    change ψ (IsLocalization.mk' A'' b s) = 0
    rw [IsLocalization.mk'_eq_mul_mk'_one, map_mul, hu.mul_right_eq_zero.mp h0, zero_mul]
  have huniq (ψ : A'' →ₐ[A] A ⧸ I) : ψ = σ'' := by
    refine AlgHom.ext fun z ↦ ?_
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (σ'' z)
    have hz : σ'' (z - algebraMap A A'' a) = 0 := by
      rw [map_sub, AlgHom.commutes, ← ha]
      exact sub_self _
    have := hkill ψ _ hz
    rw [map_sub, AlgHom.commutes, sub_eq_zero] at this
    rw [this, ← ha]
    rfl
  obtain ⟨τ''⟩ := h A'' fun p hp ↦ by
    obtain ⟨p', rfl⟩ : p ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
      rw [_root_.range_comap_of_surjective _ (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
        Ideal.mk_ker]
      exact hp
    refine ⟨PrimeSpectrum.comap σ''.toRingHom p', ?_⟩
    rw [← PrimeSpectrum.comap_comp_apply]
    congr 1
    ext a
    exact σ''.commutes a
  refine ⟨τ''.comp (IsScalarTower.toAlgHom A A' A''), ?_⟩
  ext b
  have := congrArg (fun ψ : A'' →ₐ[A] A ⧸ I ↦ ψ (algebraMap A' A'' b))
    (huniq ((Ideal.Quotient.mkₐ A I).comp τ''))
  simpa [hσ''] using this

end Algebra
