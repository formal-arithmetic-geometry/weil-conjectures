/-!
# A linear system with prescribed finite base locus

Let `A` be a finite type algebra over an algebraically closed field `k` and `S` a finite set of
maximal ideals of `A`. We construct finitely many elements `v i` of `A` which all vanish on `S`,
whose common zero locus is exactly `S`, which span `m / m²` for `m ∈ S` and `A / m²` for maximal
`m ∉ S` (`exists_linearSystem_of_finite`). This is the linear system used in the ring-level
Bertini argument (blueprint: `lemma-curve-preserving-finite-cover--1`).
-/

@[expose] public section

/-- A finite type algebra over an algebraically closed field has residue field the base field at
every maximal ideal: every element is congruent to a scalar. -/
theorem Ideal.IsMaximal.exists_sub_algebraMap_mem {k A : Type*} [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [Algebra.FiniteType k A] {m : Ideal A} (hm : m.IsMaximal)
    (y : A) : ∃ c : k, y - algebraMap k A c ∈ m := by
  let := Ideal.Quotient.field m
  have : Algebra.FiniteType k (A ⧸ m) :=
    .of_surjective (Ideal.Quotient.mkₐ k m) (Ideal.Quotient.mkₐ_surjective k m)
  have : Module.Finite k (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ m)
  obtain ⟨c, hc⟩ := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k)
    (K := A ⧸ m)).2 (Ideal.Quotient.mk m y)
  refine ⟨c, Ideal.Quotient.eq.mp ?_⟩
  rw [Ideal.Quotient.mk_algebraMap, hc]

section LinearSystem

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A] {m : Ideal A}

/-- If every element of `A` is congruent to a scalar modulo `m`, then the `k`-span of a family of
algebra generators of `A` containing `1` spans `A` modulo `m²`. -/
theorem Submodule.mem_span_sup_sq_of_adjoin_eq_top
    (hres : ∀ y : A, ∃ c : k, y - algebraMap k A c ∈ m) {ι : Type*} {a : ι → A}
    (h1 : (1 : A) ∈ Submodule.span k (Set.range a))
    (ha : Algebra.adjoin k (Set.range a) = ⊤) (y : A) :
    y ∈ Submodule.span k (Set.range a) ⊔ (m ^ 2).restrictScalars k := by
  set V := Submodule.span k (Set.range a) ⊔ (m ^ 2).restrictScalars k
  have hV1 : (1 : A) ∈ V := Submodule.mem_sup_left h1
  have hmul (x z : A) (hx : x ∈ V) (hz : z ∈ V) : x * z ∈ V := by
    obtain ⟨cx, hcx⟩ := hres x
    obtain ⟨cz, hcz⟩ := hres z
    have hxz : x * z = (x - algebraMap k A cx) * (z - algebraMap k A cz) + cx • z + cz • x -
        (cx * cz) • (1 : A) := by
      simp only [Algebra.smul_def, map_mul]
      ring
    rw [hxz]
    refine V.sub_mem (V.add_mem (V.add_mem (Submodule.mem_sup_right ?_) (V.smul_mem _ hz))
      (V.smul_mem _ hx)) (V.smul_mem _ hV1)
    rw [Submodule.restrictScalars_mem, pow_two]
    exact Ideal.mul_mem_mul hcx hcz
  have : Algebra.adjoin k (Set.range a) ≤ V.toSubalgebra hV1 hmul :=
    Algebra.adjoin_le fun x hx ↦ Submodule.mem_sup_left (Submodule.subset_span hx)
  rw [ha] at this
  exact this Algebra.mem_top

/-- Multiplying by a fixed element `g` carries the `k`-span of `a` modulo `m²` into the `k`-span
of the `g * a i` modulo `m²`. -/
theorem Submodule.mul_mem_span_sup_sq {ι κ : Type*} {a : ι → A} {g : κ → A} (j : κ) {r : A}
    (hr : r ∈ Submodule.span k (Set.range a) ⊔ (m ^ 2).restrictScalars k) :
    g j * r ∈ Submodule.span k (Set.range fun p : κ × ι ↦ g p.1 * a p.2) ⊔
      (m ^ 2).restrictScalars k := by
  obtain ⟨s, hs, μ, hμ, rfl⟩ := Submodule.mem_sup.1 hr
  clear hr
  rw [mul_add]
  refine Submodule.add_mem _ (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right ?_)
  · induction hs using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact Submodule.subset_span ⟨(j, i), rfl⟩
    | zero => simp
    | add x z _ _ hx hz =>
      rw [mul_add]
      exact Submodule.add_mem _ hx hz
    | smul c x _ hx =>
      rw [mul_smul_comm]
      exact Submodule.smul_mem _ c hx
  · exact Ideal.mul_mem_left _ _ hμ

/-- Elements of the ideal generated by the `g j` lie in the `k`-span of the `g j * a i`
modulo `m²`, if every element is congruent to a scalar modulo `m` and the `a i` are algebra
generators with `1` in their span. -/
theorem Submodule.mem_span_sup_sq_of_mem_ideal_span
    (hres : ∀ y : A, ∃ c : k, y - algebraMap k A c ∈ m) {ι κ : Type*} [Finite κ] {a : ι → A}
    (h1 : (1 : A) ∈ Submodule.span k (Set.range a))
    (ha : Algebra.adjoin k (Set.range a) = ⊤) {g : κ → A} {y : A}
    (hy : y ∈ Ideal.span (Set.range g)) :
    y ∈ Submodule.span k (Set.range fun p : κ × ι ↦ g p.1 * a p.2) ⊔
      (m ^ 2).restrictScalars k := by
  have := Fintype.ofFinite κ
  obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.1 hy
  refine Submodule.sum_mem _ fun j _ ↦ ?_
  rw [mul_comm]
  exact Submodule.mul_mem_span_sup_sq j (Submodule.mem_span_sup_sq_of_adjoin_eq_top hres h1 ha _)

/-- Membership in the `k`-span of a finite family modulo `m²`, in coordinates. -/
theorem Submodule.exists_sub_sum_mem_of_mem_span_sup {ι : Type*} [Fintype ι] {v : ι → A}
    {x : A} (hx : x ∈ Submodule.span k (Set.range v) ⊔ (m ^ 2).restrictScalars k) :
    ∃ c : ι → k, x - ∑ i, c i • v i ∈ m ^ 2 := by
  obtain ⟨s, hs, μ, hμ, rfl⟩ := Submodule.mem_sup.1 hx
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun k).1 hs
  exact ⟨c, by simpa using hμ⟩

end LinearSystem

/-- **A linear system with base locus `S`.** Let `A` be a finite type algebra over an
algebraically closed field `k` and `S` a finite set of maximal ideals. There are finitely many
elements `v i` of `A` vanishing at every point of `S`, with common zero locus exactly `S`, which
span `A / m²` over `k` for maximal `m ∉ S` and span `m / m²` for `m ∈ S`: take generators `g j`
of the ideal `⋂ S` times algebra generators of `A` (and `1`).
(blueprint: `lemma-curve-preserving-finite-cover--1`) -/
theorem exists_linearSystem_of_finite {k A : Type*} [Field k] [IsAlgClosed k] [CommRing A]
    [Algebra k A] [Algebra.FiniteType k A] (S : Set (Ideal A)) (hS : S.Finite)
    (hSmax : ∀ m ∈ S, m.IsMaximal) :
    ∃ (M : ℕ) (v : Fin M → A),
      (∀ m : Ideal A, m.IsMaximal → m ∉ S → ∀ x : A,
        ∃ c : Fin M → k, x - ∑ i, c i • v i ∈ m ^ 2) ∧
      (∀ m ∈ S, ∀ i, v i ∈ m) ∧
      (∀ m ∈ S, ∀ x ∈ m, ∃ c : Fin M → k, x - ∑ i, c i • v i ∈ m ^ 2) ∧
      (∀ p : Ideal A, p.IsPrime → (∀ i, v i ∈ p) → p ∈ S) := by
  classical
  have := Algebra.FiniteType.isNoetherianRing k A
  -- generators of the ideal `I = ⋂ S`
  set I : Ideal A := hS.toFinset.inf id with hI
  obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (IsNoetherian.noetherian I)
  -- algebra generators, together with `1`
  obtain ⟨t, ht⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k A).FG)
  set t' : Finset A := insert 1 t
  let a : t' → A := Subtype.val
  have ha_range : Set.range a = (t' : Set A) := Subtype.range_coe
  have h1 : (1 : A) ∈ Submodule.span k (Set.range a) :=
    Submodule.subset_span (by simp [ha_range, t'])
  have ha : Algebra.adjoin k (Set.range a) = ⊤ := by
    rw [eq_top_iff, ← ht, ha_range]
    exact Algebra.adjoin_mono (by simp [t'])
  let w : Fin r × t' → A := fun p ↦ g p.1 * a p.2
  let e := Fintype.equivFin (Fin r × t')
  have hrange : Set.range (w ∘ e.symm) = Set.range w := e.symm.surjective.range_comp w
  have hgI (j : Fin r) : g j ∈ I := hg ▸ Submodule.subset_span ⟨j, rfl⟩
  have hIm (m : Ideal A) (hm : m ∈ S) : I ≤ m :=
    Finset.inf_le (f := id) (hS.mem_toFinset.2 hm)
  refine ⟨Fintype.card (Fin r × t'), w ∘ e.symm, fun m hm hmS x ↦ ?_, fun m hm i ↦ ?_,
    fun m hm x hx ↦ ?_, fun p hp hv ↦ ?_⟩
  · -- generic maximal ideal: some generator of `I` is a unit modulo `m`
    have hres := hm.exists_sub_algebraMap_mem (k := k)
    obtain ⟨j, hj⟩ : ∃ j, g j ∉ m := by
      by_contra! h
      have hIle : I ≤ m := by
        rw [← hg, Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        exact h j
      obtain ⟨m', hm', hm'le⟩ := (hm.isPrime.inf_le' (s := hS.toFinset) (f := id)).1 hIle
      exact hmS (((hSmax m' (hS.mem_toFinset.1 hm')).eq_of_le hm.ne_top hm'le) ▸
        hS.mem_toFinset.1 hm')
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv_pow m hj 2
    refine Submodule.exists_sub_sum_mem_of_mem_span_sup ?_
    rw [hrange]
    have hx : x = g j * (y * x) + i * x := by
      linear_combination (-x) * hyi
    rw [hx]
    refine Submodule.add_mem _ (Submodule.mul_mem_span_sup_sq j
      (Submodule.mem_span_sup_sq_of_adjoin_eq_top hres h1 ha _)) (Submodule.mem_sup_right ?_)
    exact Ideal.mul_mem_right _ _ hi
  · exact Ideal.mul_mem_right _ _ (hIm m hm (hgI (e.symm i).1))
  · -- point of `S`: the other points of `S` are comaximal with `m`
    have := hSmax m hm
    have hres := (hSmax m hm).exists_sub_algebraMap_mem (k := k)
    set J : Ideal A := (hS.toFinset.erase m).inf id
    obtain ⟨j, hjJ, hjm⟩ : ∃ j ∈ J, j ∉ m := by
      by_contra! h
      obtain ⟨m', hm', hm'le⟩ :=
        ((hSmax m hm).isPrime.inf_le' (s := hS.toFinset.erase m) (f := id)).1 h
      obtain ⟨hne, hm'S⟩ := Finset.mem_erase.1 hm'
      exact hne ((hSmax m' (hS.mem_toFinset.1 hm'S)).eq_of_le (hSmax m hm).ne_top hm'le)
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv_pow m hjm 2
    refine Submodule.exists_sub_sum_mem_of_mem_span_sup ?_
    rw [hrange]
    have hx' : x = y * x * j + i * x := by
      linear_combination (-x) * hyi
    rw [hx']
    refine Submodule.add_mem _ (Submodule.mem_span_sup_sq_of_mem_ideal_span hres h1 ha ?_)
      (Submodule.mem_sup_right (Ideal.mul_mem_right _ _ hi))
    rw [Ideal.span, hg]
    refine Submodule.mem_finsetInf.2 fun m' hm' ↦ ?_
    by_cases hmm' : m' = m
    · subst hmm'
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hx)
    · exact Ideal.mul_mem_left _ _ (Finset.inf_le (f := id) (Finset.mem_erase.2 ⟨hmm', hm'⟩) hjJ)
  · -- base locus
    have hIp : I ≤ p := by
      rw [← hg, Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      have := hv (e ⟨j, ⟨1, Finset.mem_insert_self 1 t⟩⟩)
      simpa [w, a] using this
    obtain ⟨m', hm', hm'le⟩ := (hp.inf_le' (s := hS.toFinset) (f := id)).1 hIp
    have hm'S := hS.mem_toFinset.1 hm'
    have hpne : p ≠ ⊤ := hp.ne_top
    rwa [← (hSmax m' hm'S).eq_of_le hpne hm'le]
