module

public import Mathlib.RingTheory.AdicCompletion.AsTensorProduct
public import Mathlib.RingTheory.AdicCompletion.Exactness
public import WeilConjectures.RingTheory.AdicCompletion.QuotientPowers

/-!
# Completion of a quotient ring

Let `f : A → B` be a surjective ring map with kernel `J` and let `I ⊆ A` be an ideal. The induced
map `θ = AdicCompletion.mapRingHom f I : Â_I → B̂_{IB}` of adic completions is surjective, and if
`A` is Noetherian its kernel is `J Â_I`. Hence `Â_I ⧸ J Â_I ≃ B̂_{IB}`.

## Main results

- `AdicCompletion.mapRingHom_surjective`
- `AdicCompletion.ker_mapRingHom`
- `AdicCompletion.quotientKerEquiv`
- `AdicCompletion.exists_local_completion_quotient`

## References

- Stacks Project, Lemma 10.97.1, <https://stacks.math.columbia.edu/tag/00MA>
-/

@[expose] public section

namespace AdicCompletion

variable {A B : Type*} [CommRing A] [CommRing B]

/-- A lifting step for surjectivity of `mapRingHom`: a lift of the `n`-th coordinate can be
corrected by an element of `Iⁿ` to a lift of the `(n+1)`-st coordinate. -/
lemma exists_sub_mem_pow_of_mapRingHom {f : A →+* B} (hf : Function.Surjective f) (I : Ideal A)
    (y : AdicCompletion (I.map f) B) (n : ℕ) (a : A)
    (ha : Ideal.Quotient.mk _ (f a) = evalₐ (I.map f) n y) :
    ∃ a' : A, a - a' ∈ I ^ n ∧
      Ideal.Quotient.mk _ (f a') = evalₐ (I.map f) (n + 1) y := by
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (evalₐ (I.map f) (n + 1) y)
  have hab : f a - b ∈ (I ^ n).map f := by
    rw [Ideal.map_pow, ← Ideal.Quotient.eq, ha, ← factorPow_evalₐ (I.map f) n.le_succ, ← hb]
    rfl
  obtain ⟨c, hc, hfc⟩ := (Ideal.mem_map_iff_of_surjective f hf).mp hab
  refine ⟨a - c, by simpa using hc, ?_⟩
  rw [map_sub, hfc, sub_sub_cancel, hb]

/-- The map of adic completions induced by a surjective ring map is surjective. -/
theorem mapRingHom_surjective {f : A →+* B} (hf : Function.Surjective f) (I : Ideal A) :
    Function.Surjective (mapRingHom f I) := by
  intro y
  obtain ⟨b₀, hb₀⟩ := Ideal.Quotient.mk_surjective (evalₐ (I.map f) 0 y)
  obtain ⟨a₀, rfl⟩ := hf b₀
  let s : (n : ℕ) → {a : A // Ideal.Quotient.mk _ (f a) = evalₐ (I.map f) n y} := fun n ↦
    Nat.rec ⟨a₀, hb₀⟩ (fun n t ↦ ⟨(exists_sub_mem_pow_of_mapRingHom hf I y n t.1 t.2).choose,
      (exists_sub_mem_pow_of_mapRingHom hf I y n t.1 t.2).choose_spec.2⟩) n
  have hs (n : ℕ) : (s n).1 - (s (n + 1)).1 ∈ I ^ n :=
    (exists_sub_mem_pow_of_mapRingHom hf I y n (s n).1 (s n).2).choose_spec.1
  refine ⟨mk I A (AdicCauchySequence.mk I A (fun n ↦ (s n).1) fun n ↦ ?_), ?_⟩
  · rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    exact hs n
  · refine ext_evalₐ fun n ↦ ?_
    rw [evalₐ_mapRingHom, evalₐ_mk, AdicCauchySequence.mk_coe, Ideal.quotientMap_mk]
    exact (s n).2

/-- The ideal `J Â` generated by the image of an ideal `J` of `A` in the completion contains the
image under the completion of `J → A` of every element of the completion of `J`. -/
lemma map_subtype_mem_map_algebraMap [IsNoetherianRing A] (I J : Ideal A)
    (z : AdicCompletion I J) :
    map I J.subtype z ∈ J.map (algebraMap A (AdicCompletion I A)) := by
  obtain ⟨t, rfl⟩ := ofTensorProduct_surjective_of_finite I J z
  rw [← LinearMap.comp_apply, ofTensorProduct_naturality]
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul r j =>
    rw [LinearMap.comp_apply, TensorProduct.AlgebraTensorModule.map_tmul, ofTensorProduct_tmul,
      LinearMap.id_apply, Submodule.subtype_apply, smul_eq_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ j.2)
  | add t₁ t₂ h₁ h₂ =>
    rw [map_add]
    exact add_mem h₁ h₂

/-- If `A` is Noetherian and `f : A → B` is surjective, the kernel of the induced map of
adic completions is generated by the kernel of `f`. -/
theorem ker_mapRingHom [IsNoetherianRing A] {f : A →+* B} (hf : Function.Surjective f)
    (I : Ideal A) :
    RingHom.ker (mapRingHom f I) = (RingHom.ker f).map (algebraMap A (AdicCompletion I A)) := by
  set K := RingHom.ker f
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · obtain ⟨a, rfl⟩ := mk_surjective I A x
    have hex : Function.Exact K.subtype K.mkQ := LinearMap.exact_subtype_mkQ K
    have hmk : map I K.mkQ (mk I A a) = 0 := by
      ext n
      rw [map_mk, mk_apply_coe, val_zero_apply, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero, AdicCauchySequence.map_apply_coe]
      have h0 : evalₐ (I.map f) n (mapRingHom f I (mk I A a)) = 0 := by
        rw [RingHom.mem_ker.mp hx, _root_.map_zero]
      rw [evalₐ_mapRingHom, evalₐ_mk, Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem,
        ← Ideal.map_pow] at h0
      obtain ⟨c, hc, hfc⟩ := (Ideal.mem_map_iff_of_surjective f hf).mp h0
      have hk : a n - c ∈ K := by
        rw [RingHom.mem_ker, map_sub, hfc, sub_self]
      have : K.mkQ (a n) = c • K.mkQ 1 := by
        rw [← map_smul, smul_eq_mul, mul_one, Submodule.mkQ_apply, Submodule.mkQ_apply,
          Submodule.Quotient.eq]
        exact hk
      rw [this]
      exact Submodule.smul_mem_smul hc Submodule.mem_top
    obtain ⟨z, hz⟩ := (map_exact Subtype.val_injective hex K.mkQ_surjective
      (I := I) (mk I A a)).mp hmk
    rw [← hz]
    exact map_subtype_mem_map_algebraMap I K z
  · rw [Ideal.map_le_iff_le_comap]
    intro k hk
    rw [Ideal.mem_comap, RingHom.mem_ker, mapRingHom_algebraMap, RingHom.mem_ker.mp hk,
      _root_.map_zero]

/-- For `A` Noetherian and `f : A → B` surjective with kernel `J`, the induced map of adic
completions identifies `Â_I ⧸ J Â_I` with `B̂_{IB}`. -/
noncomputable def quotientKerEquiv [IsNoetherianRing A] {f : A →+* B}
    (hf : Function.Surjective f) (I : Ideal A) :
    AdicCompletion I A ⧸ (RingHom.ker f).map (algebraMap A (AdicCompletion I A)) ≃+*
      AdicCompletion (I.map f) B :=
  (Ideal.quotEquivOfEq (ker_mapRingHom hf I).symm).trans
    (RingHom.quotientKerEquivOfSurjective (mapRingHom_surjective hf I))

@[simp]
theorem quotientKerEquiv_mk [IsNoetherianRing A] {f : A →+* B} (hf : Function.Surjective f)
    (I : Ideal A) (x : AdicCompletion I A) :
    quotientKerEquiv hf I (Ideal.Quotient.mk _ x) = mapRingHom f I x := by
  simp [quotientKerEquiv]

/-- Let `(A, 𝔪)` be a Noetherian local ring and `f : A → B` a surjective ring map with kernel
`J`, and put `𝔫 = f(𝔪)`. Then the induced map `θ : Â → B̂` of the `𝔪`-adic completion of `A` to
the `𝔫`-adic completion of `B` satisfies `θ ∘ c_A = c_B ∘ f`, is surjective with kernel `J Â`,
and hence induces `Â ⧸ J Â ≃ B̂`. (blueprint: `lem-weil-pbc-local-completion-quotient`) -/
theorem exists_local_completion_quotient [IsNoetherianRing A] [IsLocalRing A] (f : A →+* B)
    (hf : Function.Surjective f) :
    ∃ θ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion ((IsLocalRing.maximalIdeal A).map f) B,
      (∀ a, θ (algebraMap A _ a) = algebraMap B _ (f a)) ∧ Function.Surjective θ ∧
      RingHom.ker θ =
        (RingHom.ker f).map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) ∧
      Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A) A ⧸
          (RingHom.ker f).map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) ≃+*
        AdicCompletion ((IsLocalRing.maximalIdeal A).map f) B) :=
  ⟨mapRingHom f _, mapRingHom_algebraMap f _, mapRingHom_surjective hf _, ker_mapRingHom hf _,
    ⟨quotientKerEquiv hf _⟩⟩

end AdicCompletion
