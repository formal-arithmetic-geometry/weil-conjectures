module

public import Mathlib.Algebra.Module.LocalizedModule.Submodule
public import Mathlib.LinearAlgebra.TensorProduct.Finiteness
public import Mathlib.LinearAlgebra.TensorProduct.Pi
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.Flat.Localization
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import WeilConjectures.Mathlib.RingTheory.Flat.Basic

/-!
# Finiteness of modules via formal glueing

Let `φ : R → S` be a flat ring map and `f₁, …, fₜ ∈ R` such that, with `I = (f₁, …, fₜ)`, the
induced map `R ⧸ I → S ⧸ I S` is an isomorphism. Then an `R`-module `M` is finite if and only
if `S ⊗[R] M` is a finite `S`-module and every `M_{fᵢ}` is a finite `R_{fᵢ}`-module
(`Module.finite_iff_formalGlueing`, Stacks, Tag 05EU).

The proof uses that `R → S × ∏ᵢ R_{fᵢ}` is faithfully flat
(`Module.faithfullyFlat_prod_pi_localizationAway`).
-/

@[expose] public section

open TensorProduct

variable {R : Type*} [CommRing R]

namespace Module

section Generators

variable {M : Type*} [AddCommGroup M] [Module R M]

/-- If `S ⊗[R] M` is a finite `S`-module, then it is generated by the image of a finitely
generated submodule `N` of `M`. -/
lemma exists_fg_forall_mem_range_lTensor (S : Type*) [CommRing S] [Algebra R S]
    [Module.Finite S (S ⊗[R] M)] :
    ∃ N : Submodule R M, N.FG ∧ ∀ x : S ⊗[R] M, x ∈ LinearMap.range (N.subtype.lTensor S) := by
  classical
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := S) (M := S ⊗[R] M)
  choose k t m h using fun x : s ↦ TensorProduct.exists_sum_tmul_eq (x : S ⊗[R] M)
  let N := Submodule.span R (Set.range fun p : Σ x : s, Fin (k x) ↦ m p.1 p.2)
  refine ⟨N, Submodule.fg_span (Set.finite_range _), fun x ↦ ?_⟩
  let g := TensorProduct.AlgebraTensorModule.lTensor S S N.subtype
  have hg : LinearMap.range g = ⊤ := by
    rw [eq_top_iff, ← hs, Submodule.span_le]
    intro x hx
    rw [h ⟨x, hx⟩]
    refine sum_mem fun j _ ↦ ⟨t ⟨x, hx⟩ j ⊗ₜ ⟨m ⟨x, hx⟩ j, Submodule.subset_span ⟨⟨⟨x, hx⟩, j⟩,
      rfl⟩⟩, ?_⟩
    simp [g]
  obtain ⟨y, hy⟩ := (LinearMap.range_eq_top.mp hg) x
  exact ⟨y, hy⟩

/-- If `M_f` is a finite `R_f`-module, then there is a finitely generated submodule `N` of `M`
such that every element of `M` is mapped into `N` by some power of `f`. -/
lemma exists_fg_forall_exists_pow_smul_mem (f : R)
    [Module.Finite (Localization.Away f) (LocalizedModule (Submonoid.powers f) M)] :
    ∃ N : Submodule R M, N.FG ∧ ∀ m : M, ∃ k : ℕ, f ^ k • m ∈ N := by
  classical
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := Localization.Away f)
    (M := LocalizedModule (Submonoid.powers f) M)
  let g := LocalizedModule.mkLinearMap (Submonoid.powers f) M
  choose a ha using fun x : s ↦ IsLocalizedModule.mk'_surjective (Submonoid.powers f) g x
  let N := Submodule.span R (Set.range fun x : s ↦ (a x).1)
  refine ⟨N, Submodule.fg_span (Set.finite_range _), fun m ↦ ?_⟩
  have hle : (⊤ : Submodule (Localization.Away f) _) ≤
      N.localized' (Localization.Away f) (Submonoid.powers f) g := by
    rw [← hs, Submodule.span_le]
    intro x hx
    rw [SetLike.mem_coe, Submodule.mem_localized']
    exact ⟨(a ⟨x, hx⟩).1, Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩, (a ⟨x, hx⟩).2, ha ⟨x, hx⟩⟩
  obtain ⟨n, hn, u, hu⟩ := (Submodule.mem_localized' _ _ _ _ _).mp (hle (Submodule.mem_top
    (x := g m)))
  rw [← IsLocalizedModule.mk'_one (Submonoid.powers f), IsLocalizedModule.mk'_eq_mk'_iff] at hu
  obtain ⟨c, hc⟩ := hu
  obtain ⟨⟨_, i, rfl⟩, ⟨_, j, rfl⟩⟩ := (c, u)
  sorry

end Generators

end Module
