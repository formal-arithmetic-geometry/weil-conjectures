module

public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import WeilConjectures.Mathlib.Topology.KrullDimension
public import WeilConjectures.RingTheory.CompleteIntersectionOverField
import WeilConjectures.RingTheory.PolynomialQuotientDimensionAtPointHeightDifference
import WeilConjectures.RingTheory.LocalizedIdealConormalGeneratorBound
import WeilConjectures.RingTheory.LocalCompleteIntersectionPresentation
import WeilConjectures.RingTheory.PrincipalNeighborhoodDimension

/-!
# Conormal generators and global complete intersections

Source: Stacks Project, Algebra, Lemma 00SC (lemma-lci), implication (3) => (1)
(blueprint: lem-weil-pbc-lci-conormal-generators-global-complete-intersection).
-/

@[expose] public section

universe u

namespace Algebra

/-- (blueprint: lem-weil-pbc-lci-conormal-generators-global-complete-intersection)
Stacks Project, Algebra, Lemma 00SC, implication (3) ⇒ (1). The conormal module at a
prime generated by the codimension number of elements yields a principal localization
which is a global complete intersection.

Proof (Stacks 00SC, implication (3) ⇒ (1)):
1. The polynomial-quotient dimension formula gives natural heights `a ≤ b ≤ n`
   and local dimension `d = n - b + a`, hence `d ≤ n`.
2. The polynomial ring is Noetherian, so `I` is finitely generated. Apply the
   localized conormal generator bound to obtain `spanFinrank (I P_Q) ≤ n - d`.
   Choose a minimal finite generating set and pad its enumeration with zeros to
   obtain exactly `n - d` local generators. This also handles the empty family.
3. Apply `exists_principal_localization_presentation_of_local_generators`.
   It supplies `g ∉ q` such that every further localization `S_(g*t)` has a
   presentation with `n + 1` variables and `n - d + 1` equations. The lemma
   combines clearing denominators with the inverse-variable presentation.
4. Choose `t ∉ q` with `dim Spec S_(g*t) = d`, using
   `PrimeSpectrum.exists_mul_away_dimension_eq`. Primality gives `g*t ∉ q`.
   Since `(n + 1) - (n - d + 1) = d`, the presentation satisfies the definition
   of a global complete intersection. -/
theorem conormal_generators_global_complete_intersection
    (k : Type u) [Field k] (n : ℕ)
    (I : Ideal (MvPolynomial (Fin n) k))
    (q : Ideal (MvPolynomial (Fin n) k ⧸ I)) [q.IsPrime] :
    ∃ d : ℕ,
      topologicalKrullDimAt (⟨q, inferInstance⟩ : PrimeSpectrum (MvPolynomial (Fin n) k ⧸ I)) =
          (d : WithBot ℕ∞) ∧ d ≤ n ∧
        ((∃ gens : Fin (n - d) →
              LocalizedModule q.primeCompl (Ideal.Cotangent I),
            Submodule.span (R := Localization.AtPrime q) (Set.range gens) = ⊤) →
          ∃ g : (MvPolynomial (Fin n) k ⧸ I), g ∉ q ∧
            IsGlobalCompleteIntersection k (Localization.Away g)) := by
  classical
  obtain ⟨a, b, _, _, hab, hbn, hdim⟩ :=
    AlgebraicGeometry.topologicalKrullDimAt_polynomial_quotient_eq_height_difference n I q
  let d := n - b + a
  have hdn : d ≤ n := by dsimp [d]; omega
  refine ⟨d, hdim, hdn, ?_⟩
  rintro ⟨gens, hgens⟩
  let P := MvPolynomial (Fin n) k
  let Q := q.comap (Ideal.Quotient.mk I)
  let R := Localization.AtPrime Q
  let J := I.map (algebraMap P R)
  have hI : I.FG := IsNoetherian.noetherian I
  have hJ : J.FG := hI.map (algebraMap P R)
  have hbound : J.spanFinrank ≤ n - d :=
    Ideal.spanFinrank_localized_ideal_le_of_conormal_generators I hI
      ⟨q, inferInstance⟩ (n - d) gens hgens
  obtain ⟨s, hcard, hs⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank hJ
  have hsc : s.card ≤ n - d := hcard.trans_le hbound
  let h : Fin (n - d) → R := fun i ↦
    if hi : i.val < s.card then (s.equivFin.symm ⟨i.val, hi⟩ : R) else 0
  have hgen : Ideal.span (Set.range h) = J := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      dsimp only [h]
      split_ifs with hi
      · rw [← hs]
        exact Ideal.subset_span (s.equivFin.symm ⟨i.val, hi⟩).property
      · exact J.zero_mem
    · rw [← hs]
      apply Ideal.span_le.mpr
      intro x hx
      let i := s.equivFin ⟨x, hx⟩
      have hi : i.val < n - d := lt_of_lt_of_le i.isLt hsc
      have heq : h ⟨i.val, hi⟩ = x := by
        simp [h, i]
      exact heq ▸ Ideal.subset_span ⟨⟨i.val, hi⟩, rfl⟩
  obtain ⟨g, hg, hpres⟩ :=
    exists_principal_localization_presentation_of_local_generators k n I q inferInstance
      (n - d) h hgen.symm
  obtain ⟨t, ht, hdim'⟩ :=
    PrimeSpectrum.exists_mul_away_dimension_eq _ ⟨q, inferInstance⟩ g hg
  obtain ⟨f, hf⟩ := hpres t
  refine ⟨g * t, q.primeCompl.mul_mem hg ht, Or.inr ?_⟩
  refine ⟨n + 1, n - d + 1, f, by omega, hf, ?_⟩
  have harith : n + 1 - (n - d + 1) = d := by omega
  simpa only [harith] using hdim'.trans hdim

end Algebra
