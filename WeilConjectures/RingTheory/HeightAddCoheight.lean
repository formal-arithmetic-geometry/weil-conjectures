/-!
# Height plus coheight in finitely generated domains over a field

Let `B` be a finitely generated domain over a field `K`, of Krull dimension `n`. Every prime `p`
of `B` satisfies `ht p + dim (B ⧸ p) = n`; in terms of the specialization order on
`PrimeSpectrum B`, `height p + coheight p = n`
(`PrimeSpectrum.height_add_coheight_eq_of_finiteType`).

The proof is by induction on `n`. For `p ≠ 0` choose a prime `q ⊆ p` minimal over a nonzero
principal ideal; it has height one by Krull's principal ideal theorem, and `dim (B ⧸ q) = n - 1`
(`PrimeSpectrum.coheight_add_one_eq_of_height_eq_one`). This last statement is reduced along a
Noether normalization `K[T₁, …, Tₙ] ⊆ B` (which satisfies going up and, the polynomial ring being
normal, going down) to a height one prime of `K[T₁, …, Tₙ]`. That one is principal, generated by
an `F` involving some variable `Tᵢ`, and the other `n - 1` variables stay algebraically
independent modulo `F`.
-/

@[expose] public section

open Order

namespace PrimeSpectrum

section Order

variable {R : Type*} [CommRing R]

/-- The coheight of a prime `p` in `PrimeSpectrum R` is the Krull dimension of `R ⧸ p`. -/
theorem coheight_eq_ringKrullDim_quotient (p : PrimeSpectrum R) :
    (coheight p : WithBot ℕ∞) = ringKrullDim (R ⧸ p.asIdeal) := by
  rw [ringKrullDim_quotient, coheight_eq_krullDim_Ici]
  rfl

/-- `height p + coheight p ≤ dim R`. -/
theorem height_add_coheight_le (p : PrimeSpectrum R) :
    ((height p + coheight p : ℕ∞) : WithBot ℕ∞) ≤ ringKrullDim R := by
  have : Nonempty (PrimeSpectrum R) := ⟨p⟩
  rw [ringKrullDim, krullDim_eq_iSup_height_add_coheight_of_nonempty, WithBot.coe_le_coe]
  exact le_iSup (fun a : PrimeSpectrum R ↦ height a + coheight a) p

end Order

section Integral

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S]

/-- Incomparability: contraction of primes along an integral extension is strictly monotone. -/
theorem strictMono_comap_of_isIntegral : StrictMono (comap (algebraMap R S)) :=
  fun _ _ h ↦ Ideal.IsIntegral.comap_lt_comap (R := R) h

/-- Contraction along an integral extension preserves coheight (going up). -/
theorem coheight_comap_of_isIntegral (P : PrimeSpectrum S) :
    coheight (comap (algebraMap R S) P) = coheight P := by
  refine (coheight_eq_of_strictMono _ strictMono_comap_of_isIntegral (fun a b hab ↦ ?_) P).symm
  obtain ⟨Q, hQ, hQp, hQb⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime b.asIdeal a.asIdeal hab.le
  refine ⟨⟨Q, hQp⟩, lt_of_le_of_ne hQ fun h ↦ hab.ne ?_, PrimeSpectrum.ext hQb⟩
  ext1
  change a.asIdeal.comap (algebraMap R S) = b.asIdeal
  rw [← hQb]
  exact congrArg (Ideal.comap (algebraMap R S)) (congrArg PrimeSpectrum.asIdeal h)

/-- Contraction along an integral extension with going down preserves height. -/
theorem height_comap_of_isIntegral [Algebra.HasGoingDown R S] (P : PrimeSpectrum S) :
    height (comap (algebraMap R S) P) = height P := by
  refine (height_eq_of_strictMono _ strictMono_comap_of_isIntegral (fun a b hab ↦ ?_) P).symm
  have : a.asIdeal.LiesOver (a.asIdeal.comap (algebraMap R S)) := ⟨rfl⟩
  obtain ⟨Q, hQa, hQp, hQb⟩ :=
    Ideal.exists_ideal_lt_liesOver_of_lt (p := b.asIdeal)
      (q := a.asIdeal.comap (algebraMap R S)) a.asIdeal hab
  exact ⟨⟨Q, hQp⟩, hQa, PrimeSpectrum.ext hQb.over.symm⟩

end Integral

section Quotient

variable {R : Type*} [CommRing R] {I : Ideal R}

variable (I) in
/-- The primes of `R ⧸ I` are the primes of `R` containing `I`, compatibly with inclusion. -/
theorem strictMono_comap_quotient_mk : StrictMono (comap (Ideal.Quotient.mk I)) :=
  fun x y h ↦ by
    refine lt_of_le_of_ne (Ideal.comap_mono h.le) fun e ↦ h.ne ?_
    ext1
    exact Ideal.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective
      (congrArg PrimeSpectrum.asIdeal e)

theorem lt_of_comap_quotient_mk_lt {a a' : PrimeSpectrum (R ⧸ I)}
    (h : comap (Ideal.Quotient.mk I) a < comap (Ideal.Quotient.mk I) a') : a < a' :=
  lt_of_le_of_ne ((Ideal.comap_le_comap_iff_of_surjective _ Ideal.Quotient.mk_surjective _ _).1
    h.le) fun e ↦ h.ne (by rw [e])

theorem le_comap_quotient_mk (a : PrimeSpectrum (R ⧸ I)) :
    I ≤ (comap (Ideal.Quotient.mk I) a).asIdeal := fun x hx ↦ by
  change Ideal.Quotient.mk I x ∈ a.asIdeal
  rw [Ideal.Quotient.eq_zero_iff_mem.2 hx]
  exact zero_mem _

theorem exists_comap_quotient_mk_eq {b : PrimeSpectrum R} (hb : I ≤ b.asIdeal) :
    ∃ a : PrimeSpectrum (R ⧸ I), comap (Ideal.Quotient.mk I) a = b :=
  ⟨⟨b.asIdeal.map (Ideal.Quotient.mk I), Ideal.map_isPrime_of_surjective
    Ideal.Quotient.mk_surjective (by simpa using hb)⟩, by
    ext1
    change Ideal.comap _ (Ideal.map _ _) = _
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, sup_eq_left.2 hb]⟩

/-- The coheight of a prime of `R ⧸ I` is the coheight of the corresponding prime of `R`. -/
theorem coheight_comap_quotient_mk (a : PrimeSpectrum (R ⧸ I)) :
    coheight (comap (Ideal.Quotient.mk I) a) = coheight a := by
  refine (coheight_eq_of_strictMono _ (strictMono_comap_quotient_mk I) (fun a b hab ↦ ?_) a).symm
  obtain ⟨a', rfl⟩ := exists_comap_quotient_mk_eq ((le_comap_quotient_mk a).trans hab.le)
  exact ⟨a', lt_of_comap_quotient_mk_lt hab, rfl⟩

end Quotient

end PrimeSpectrum

section FiniteType

variable (K : Type*) [Field K]

/-- A nontrivial finitely generated algebra over a field has finite Krull dimension. -/
theorem exists_ringKrullDim_eq_natCast_of_finiteType (B : Type*) [CommRing B] [Nontrivial B]
    [Algebra K B] [Algebra.FiniteType K B] : ∃ n : ℕ, ringKrullDim B = n := by
  have h := ringKrullDim_ne_top_of_finiteType K B
  rcases hB : ringKrullDim B with _ | _ | n
  · have := ringKrullDim_nonneg_of_nontrivial (R := B)
    rw [hB] at this
    exact absurd this (not_le.2 (WithBot.bot_lt_coe _))
  · exact absurd hB h
  · exact ⟨n, rfl⟩

/-- In the polynomial ring `K[T₁, …, Tₙ]`, the quotient by a height one prime has dimension
`n - 1`: the prime is principal, generated by an `F` involving some variable `Tᵢ`, and the
remaining variables are algebraically independent modulo `F`. -/
theorem MvPolynomial.coheight_add_one_eq_of_height_eq_one {n : ℕ}
    (p : PrimeSpectrum (MvPolynomial (Fin n) K)) (hp : p.asIdeal.height = 1) :
    coheight p + 1 = n := by
  have hdim : ringKrullDim (MvPolynomial (Fin n) K) = n := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
    simp
  apply le_antisymm
  · have h := PrimeSpectrum.height_add_coheight_le p
    rw [hdim, ← PrimeSpectrum.height_eq_orderHeight, hp, add_comm] at h
    exact_mod_cast h
  obtain ⟨F, hF⟩ := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hp
  have hF' : p.asIdeal = Ideal.span {F} := hF
  have hF0 : F ≠ 0 := by
    rintro rfl
    exact p.asIdeal.ne_bot_of_height_eq_one hp (by simpa using hF')
  -- `F` involves some variable `Tᵢ`
  obtain ⟨i, hi⟩ : ∃ i, i ∈ F.vars := by
    by_contra! h
    have hC : F = MvPolynomial.C (F.coeff 0) :=
      (MvPolynomial.vars_eq_empty_iff_eq_C).1 (Finset.eq_empty_of_forall_notMem h)
    have hc : F.coeff 0 ≠ 0 := fun h0 ↦ hF0 (by rw [hC, h0, map_zero])
    have : IsUnit F := hC ▸ (isUnit_iff_ne_zero.2 hc).map MvPolynomial.C
    exact p.2.ne_top (hF'.trans (Ideal.span_singleton_eq_top.2 this))
  have hdeg : 0 < F.degreeOf i := by
    rw [Nat.pos_iff_ne_zero]
    intro h0
    obtain ⟨d, hd, hid⟩ := (MvPolynomial.mem_vars_iff_mem_support i).1 hi
    have := (MvPolynomial.degreeOf_le_iff.1 h0.le) d hd
    exact (Finsupp.mem_support_iff.1 hid) (Nat.le_zero.1 this)
  -- the other variables are algebraically independent modulo `F`
  let ι := {j : Fin n // j ≠ i}
  let φ : MvPolynomial ι K →ₐ[K] MvPolynomial (Fin n) K ⧸ p.asIdeal :=
    (Ideal.Quotient.mkₐ K p.asIdeal).comp (MvPolynomial.rename Subtype.val)
  have hφ : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro g hg
    have hmem : MvPolynomial.rename Subtype.val g ∈ Ideal.span {F} := by
      rw [← hF']
      exact Ideal.Quotient.eq_zero_iff_mem.1 hg
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.1 hmem
    by_contra hg0
    have hr0 : MvPolynomial.rename (Subtype.val : ι → Fin n) g ≠ 0 :=
      fun h0 ↦ hg0 ((MvPolynomial.rename_injective _ Subtype.val_injective) (by simpa using h0))
    have hh0 : h ≠ 0 := by rintro rfl; simp at hh; exact hr0 hh.symm
    have h1 : (MvPolynomial.rename (Subtype.val : ι → Fin n) g).degreeOf i = 0 := by
      refine Nat.le_zero.1 (MvPolynomial.degreeOf_le_iff.2 fun d hd ↦ Nat.le_zero.2 ?_)
      by_contra hdi
      have hv : i ∈ (MvPolynomial.rename (Subtype.val : ι → Fin n) g).vars :=
        (MvPolynomial.mem_vars_iff_mem_support i).2 ⟨d, hd, Finsupp.mem_support_iff.2 hdi⟩
      classical
      obtain ⟨j, -, hj⟩ := Finset.mem_image.1 (MvPolynomial.vars_rename _ g hv)
      exact j.2 hj
    rw [← hh, MvPolynomial.degreeOf_mul_eq hh0 hF0] at h1
    omega
  have hle := trdeg_le_of_injective φ hφ
  rw [MvPolynomial.trdeg_of_isDomain] at hle
  obtain ⟨m, hm⟩ := exists_ringKrullDim_eq_natCast_of_finiteType K
    (MvPolynomial (Fin n) K ⧸ p.asIdeal)
  have htr := Algebra.trdeg_eq_of_ringKrullDim_eq K (MvPolynomial (Fin n) K ⧸ p.asIdeal) hm
  have hcard : Cardinal.lift.{u_1} (Cardinal.mk ι) = (n - 1 : ℕ) := by
    simp [ι, Cardinal.mk_fintype, Fintype.card_subtype_compl]
  rw [htr, hcard, Nat.cast_le] at hle
  have hco : coheight p = m := by
    have := PrimeSpectrum.coheight_eq_ringKrullDim_quotient p
    rw [hm] at this
    exact_mod_cast this
  rw [hco]
  exact_mod_cast (by omega : n ≤ m + 1)

variable {K}

/-- In a finitely generated domain `B` of dimension `n` over a field, the quotient by a height
one prime has dimension `n - 1`. -/
theorem PrimeSpectrum.coheight_add_one_eq_of_height_eq_one {B : Type*} [CommRing B] [IsDomain B]
    [Algebra K B] [Algebra.FiniteType K B] {n : ℕ} (hB : ringKrullDim B = n)
    (q : PrimeSpectrum B) (hq : q.asIdeal.height = 1) :
    coheight q + 1 = n := by
  obtain ⟨g, hinj, hfin⟩ := exists_finite_inj_algHom_mvPolynomial_of_ringKrullDim_eq K B n hB
  algebraize [g.toRingHom]
  have : FaithfulSMul (MvPolynomial (Fin n) K) B :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  have : Algebra.IsIntegral (MvPolynomial (Fin n) K) B := ⟨hfin.to_isIntegral⟩
  have hh := height_comap_of_isIntegral (R := MvPolynomial (Fin n) K) q
  have hc := coheight_comap_of_isIntegral (R := MvPolynomial (Fin n) K) q
  rw [← hc]
  refine MvPolynomial.coheight_add_one_eq_of_height_eq_one K _ ?_
  rw [PrimeSpectrum.height_eq_orderHeight, hh, ← PrimeSpectrum.height_eq_orderHeight, hq]

/-- **Height plus coheight.** In a finitely generated domain `B` of dimension `n` over a field
`K`, every prime `p` satisfies `ht p + dim (B ⧸ p) = n`, i.e. `height p + coheight p = n` in
`PrimeSpectrum B`. -/
theorem PrimeSpectrum.height_add_coheight_eq_of_finiteType :
    ∀ (n : ℕ) {B : Type*} [CommRing B] [IsDomain B] [Algebra K B] [Algebra.FiniteType K B],
      ringKrullDim B = n → ∀ p : PrimeSpectrum B, height p + coheight p = n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro B _ _ _ _ hB p
  have hle : ((height p + coheight p : ℕ∞) : WithBot ℕ∞) ≤ n :=
    hB ▸ PrimeSpectrum.height_add_coheight_le p
  have hle' : height p + coheight p ≤ n := by exact_mod_cast hle
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing K B
  by_cases hp : p.asIdeal = ⊥
  · have h0 : height p = 0 := by
      rw [← PrimeSpectrum.height_eq_orderHeight, hp, Ideal.height_bot]
    have h1 : (coheight p : WithBot ℕ∞) = n := by
      rw [PrimeSpectrum.coheight_eq_ringKrullDim_quotient, hp,
        ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot B), hB]
    rw [h0, zero_add]
    exact_mod_cast h1
  obtain ⟨a, hap, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp
  obtain ⟨q, hqmin, hqp⟩ :=
    Ideal.exists_minimalPrimes_le ((Ideal.span_singleton_le_iff_mem _).2 hap)
  have hqprime : q.IsPrime := hqmin.1.1
  let Q : PrimeSpectrum B := ⟨q, hqprime⟩
  have hq0 : q ≠ ⊥ := fun h ↦ ha0 (by
    have : a ∈ q := hqmin.1.2 (Ideal.mem_span_singleton_self a)
    rwa [h, Ideal.mem_bot] at this)
  have hqh : q.height = 1 := by
    refine le_antisymm (Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ q hqmin) ?_
    rw [Order.one_le_iff_ne_zero]
    exact fun h ↦ hq0 (Ideal.height_eq_zero_iff_eq_bot.1 h)
  have hQ := PrimeSpectrum.coheight_add_one_eq_of_height_eq_one (K := K) hB Q hqh
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := by
    rcases n with _ | m
    · exfalso
      have : (coheight Q + 1 : ℕ∞) ≠ 0 := by simp
      exact this (by exact_mod_cast hQ)
    · exact ⟨m, rfl⟩
  have hQm : coheight Q = m := by
    have : coheight Q + 1 = (m : ℕ∞) + 1 := by exact_mod_cast hQ
    exact WithTop.add_right_cancel (by simp) this
  -- the quotient `B ⧸ q`
  have hBq : ringKrullDim (B ⧸ q) = m := by
    rw [← PrimeSpectrum.coheight_eq_ringKrullDim_quotient Q, hQm]
    rfl
  let f : PrimeSpectrum (B ⧸ q) → PrimeSpectrum B := comap (Ideal.Quotient.mk q)
  have hf : StrictMono f := strictMono_comap_quotient_mk q
  obtain ⟨p', hp'⟩ := exists_comap_quotient_mk_eq hqp
  have hco : coheight p' = coheight p := hp' ▸ (coheight_comap_quotient_mk p').symm
  have hht : height p' + 1 ≤ height p := by
    have hfin : height p' ≠ ⊤ := by
      have := height_le_krullDim p'
      rw [← ringKrullDim, hBq] at this
      have : height p' ≤ (m : ℕ∞) := by exact_mod_cast this
      exact ne_top_of_le_ne_top (ENat.natCast_ne_top m) this
    obtain ⟨k, hk⟩ := WithTop.ne_top_iff_exists.1 hfin
    obtain ⟨l, hlast, hlen⟩ := exists_series_of_height_eq_coe p' hk.symm
    have hlt : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum B) < f l.head := by
      refine lt_of_le_of_ne (show (⊥ : Ideal B) ≤ (f l.head).asIdeal from bot_le)
        fun e ↦ hq0 (le_bot_iff.1 ?_)
      rw [show (⊥ : Ideal B) = (f l.head).asIdeal from congrArg PrimeSpectrum.asIdeal e]
      exact PrimeSpectrum.le_comap_quotient_mk _
    let L := (l.map f hf).cons _ hlt
    have := length_le_height_last (p := L)
    rw [RelSeries.cons_length, LTSeries.map_length, hlen] at this
    rw [← hk]
    simpa [L, f, RelSeries.last_cons, LTSeries.last_map, hlast, hp'] using this
  have ih' := ih m (by omega) hBq p'
  refine le_antisymm hle' ?_
  calc ((m + 1 : ℕ) : ℕ∞) = height p' + coheight p' + 1 := by rw [ih']; push_cast; rfl
    _ = height p' + 1 + coheight p' := by ring
    _ ≤ height p + coheight p := by rw [hco]; gcongr


/-- In a finitely generated algebra `A` over a field, primes `q ≤ p` satisfy
`dim (A ⧸ q) ≤ ht p + dim (A ⧸ p)`: in the domain `A ⧸ q` the image of `p` has height plus
coheight `dim (A ⧸ q)`. -/
theorem PrimeSpectrum.coheight_le_height_add_coheight_of_finiteType {A : Type*} [CommRing A]
    [Algebra K A] [Algebra.FiniteType K A] {q p : PrimeSpectrum A} (hqp : q ≤ p) :
    coheight q ≤ height p + coheight p := by
  obtain ⟨m, hm⟩ := exists_ringKrullDim_eq_natCast_of_finiteType K (A ⧸ q.asIdeal)
  obtain ⟨p', hp'⟩ := exists_comap_quotient_mk_eq (I := q.asIdeal) (b := p) hqp
  have h := height_add_coheight_eq_of_finiteType (K := K) m hm p'
  have hq : coheight q = m := by
    have := coheight_eq_ringKrullDim_quotient q
    rw [hm] at this
    exact_mod_cast this
  rw [hq, ← h, ← hp', coheight_comap_quotient_mk]
  gcongr
  exact height_le_height_apply_of_strictMono _ (strictMono_comap_quotient_mk _) p'

/-- Let `A` be a finitely generated algebra over a field, `p` a prime of `A`, and `g ∈ A` such
that every minimal prime of `A` not containing `g` is contained in `p`. Then
`dim A[1/g] ≤ ht p + dim (A ⧸ p)`. -/
theorem ringKrullDim_localization_away_le_of_finiteType {A : Type*} [CommRing A] [Algebra K A]
    [Algebra.FiniteType K A] (p : PrimeSpectrum A) {g : A}
    (hg : ∀ q ∈ minimalPrimes A, g ∉ q → q ≤ p.asIdeal) :
    ringKrullDim (Localization.Away g) ≤ ((height p + coheight p : ℕ∞) : WithBot ℕ∞) := by
  let c : PrimeSpectrum (Localization.Away g) → PrimeSpectrum A :=
    PrimeSpectrum.comap (algebraMap A _)
  have hc : StrictMono c := Monotone.strictMono_of_injective (fun _ _ h ↦ Ideal.comap_mono h)
    (PrimeSpectrum.localization_comap_injective _ (Submonoid.powers g))
  refine iSup_le fun L ↦ ?_
  have hgL : g ∉ (c L.head).asIdeal := fun h ↦ L.head.2.ne_top
    (Ideal.eq_top_of_isUnit_mem _ h (IsLocalization.Away.algebraMap_isUnit g))
  obtain ⟨q, hq, hqL⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ (c L.head).asIdeal)
  have hqprime : q.IsPrime := hq.1.1
  have hqp := hg q hq fun h ↦ hgL (hqL h)
  calc (L.length : WithBot ℕ∞) = ((L.map c hc).length : ℕ∞) := by simp
    _ ≤ (coheight (L.map c hc).head : WithBot ℕ∞) := by
      exact_mod_cast length_le_coheight_head
    _ ≤ (coheight (⟨q, hqprime⟩ : PrimeSpectrum A) : WithBot ℕ∞) := by
      exact_mod_cast coheight_anti (show (⟨q, hqprime⟩ : PrimeSpectrum A) ≤ (L.map c hc).head
        by rw [LTSeries.head_map]; exact hqL)
    _ ≤ _ := by
      exact_mod_cast PrimeSpectrum.coheight_le_height_add_coheight_of_finiteType (K := K)
        (show (⟨q, hqprime⟩ : PrimeSpectrum A) ≤ p from hqp)

/-- In a noetherian ring `A`, every prime `p` admits `g ∉ p` such that every minimal prime of `A`
not containing `g` is contained in `p`: take for `g` a product of elements of the finitely many
minimal primes not contained in `p`, chosen outside `p`. -/
theorem exists_notMem_forall_minimalPrimes_le {A : Type*} [CommRing A] [IsNoetherianRing A]
    (p : Ideal A) [p.IsPrime] :
    ∃ g ∉ p, ∀ q ∈ minimalPrimes A, g ∉ q → q ≤ p := by
  classical
  have hfin : {q ∈ minimalPrimes A | ¬ q ≤ p}.Finite :=
    (minimalPrimes.finite_of_isNoetherianRing A).subset (Set.sep_subset _ _)
  have : ∀ q ∈ {q ∈ minimalPrimes A | ¬ q ≤ p}, ∃ x ∈ q, x ∉ p := fun q hq ↦
    Set.not_subset.1 hq.2
  choose! s hs using this
  refine ⟨∏ q ∈ hfin.toFinset, s q, ?_, fun q hq hg ↦ ?_⟩
  · rw [Ideal.IsPrime.prod_mem_iff]
    rintro ⟨q, hq, hmem⟩
    exact (hs q (hfin.mem_toFinset.1 hq)).2 hmem
  · by_contra hle
    have hqS : q ∈ hfin.toFinset := hfin.mem_toFinset.2 ⟨hq, hle⟩
    obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem s hqS
    exact hg (hc ▸ Ideal.mul_mem_right _ _ (hs q (hfin.mem_toFinset.1 hqS)).1)

end FiniteType
