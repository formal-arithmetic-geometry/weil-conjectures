module

public import Mathlib.Algebra.Category.ModuleCat.Limits
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Filtration
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.LinearAlgebra.TensorProduct.Tower

/-!
# Eventually zero kernels after tensoring a finite submodule inclusion

Source: Stacks Project, More on Algebra, proofs of Tags 0911 and 0912;
Algebra, Artin--Rees lemma Tag 00IN.
(blueprint: lem-weil-pbc-tensor-tower-kernel-pro-zero)
-/

@[expose] public section

universe u v

open CategoryTheory Opposite
open scoped TensorProduct

namespace ModuleCat

/-- Tensor kernels of a finite submodule inclusion are eventually killed by transitions.
Source: Stacks Project, Tags 0911 and 0912, using Artin--Rees (Tag 00IN).
(blueprint: lem-weil-pbc-tensor-tower-kernel-pro-zero)

Proof: fix the finite module P and its submodule K. Artin--Rees gives c such that
K ∩ I^(n+c+1)P is contained in I^(n+1)K for every n. Write J = I^(n+c+1).
The kernel of K/JK → P/JP is (K ∩ JP)/JK. Since F_(n+c) is flat over A/J,
tensoring the exact sequence of this kernel, K/JK and P/JP shows that the kernel
of K ⊗ F_(n+c) → P ⊗ F_(n+c) is generated by k ⊗ x with k ∈ K ∩ JP.
Here quotient cancellation identifies tensors over A/J with the displayed A-tensors.
The image of each generator at level n is zero: write k as a finite sum of elements
of I^(n+1) times elements of K, move the scalars to the other tensor factor, and
use that I^(n+1) annihilates F_n. The quotient cancellation maps send generators
to the same pure tensors, so this is exactly the specified transition map.
Take m = n+c. This also covers K=0, P=0, I=0 and I=A; no surjectivity of the
tower transitions is needed. -/
theorem tensor_kernel_eventually_zero_of_flat_quotients
    (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    (F : ℕᵒᵖ ⥤ ModuleCat.{v} A)
    [∀ n : ℕ, Module (A ⧸ I ^ (n + 1)) (F.obj (op n))]
    [∀ n : ℕ, IsScalarTower A (A ⧸ I ^ (n + 1)) (F.obj (op n))]
    (hflat : ∀ n : ℕ, Module.Flat (A ⧸ I ^ (n + 1)) (F.obj (op n)))
    (P : Type u) [AddCommGroup P] [Module A P] [Module.Finite A P]
    (K : Submodule A P) (n : ℕ) :
    ∃ (m : ℕ) (hnm : n ≤ m),
      ∀ x : TensorProduct A K (F.obj (op m)),
        K.subtype.rTensor (F.obj (op m)) x = 0 →
        (F.map (homOfLE hnm).op).hom.lTensor K x = 0 := by
  obtain ⟨c, hc⟩ := I.exists_pow_inf_eq_pow_smul K
  let m := n + c
  have hbound : I ^ (m + 1) • (⊤ : Submodule A P) ⊓ K ≤ I ^ (n + 1) • K := by
    rw [hc (m + 1) (by dsimp [m]; omega)]
    have he : m + 1 - c = n + 1 := by dsimp [m]; omega
    rw [he]
    exact Submodule.smul_mono le_rfl inf_le_right
  refine ⟨m, by dsimp [m]; omega, ?_⟩
  intro x hx
  let J := I ^ (m + 1)
  let S := A ⧸ J
  let M := F.obj (op m)
  let N := F.obj (op n)
  let t : M →ₗ[A] N := (F.map (homOfLE (show n ≤ m by dsimp [m]; omega)).op).hom
  let : Module.Flat S M := hflat m
  let f : TensorProduct A S K →ₗ[S] TensorProduct A S P := K.subtype.baseChange S
  let eK := TensorProduct.AlgebraTensorModule.cancelBaseChange A S S M K
  let eP := TensorProduct.AlgebraTensorModule.cancelBaseChange A S S M P
  have hnat (z : M ⊗[S] (S ⊗[A] K)) :
      eP (f.lTensor M z) = K.subtype.lTensor M (eK z) := by
    induction z using TensorProduct.inductionOn with
    | tmul a b =>
      induction b using TensorProduct.inductionOn with
      | tmul s k => simp [f, eK, eP]
      | add b b' hb hb' => simp only [map_add, TensorProduct.tmul_add, hb, hb']
    | add z z' hz hz' => simp only [map_add, hz, hz']
  let z := eK.symm (TensorProduct.comm A K M x)
  have hz : f.lTensor M z = 0 := by
    apply eP.injective
    rw [hnat]
    dsimp [z]
    rw [LinearEquiv.apply_symm_apply, LinearMap.lTensor_comm, hx]
    simp
  obtain ⟨b, hb⟩ := ((Module.Flat.lTensor_exact M f.exact_subtype_ker_map) z).mp hz
  have hann (r : A) (hr : r ∈ I ^ (n + 1)) (a : N) : r • a = 0 := by
    have he : (Ideal.Quotient.mk (I ^ (n + 1)) r) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hr
    calc
      r • a = (Ideal.Quotient.mk (I ^ (n + 1)) r) • a := by
        simpa using (IsScalarTower.algebraMap_smul (A ⧸ I ^ (n + 1)) r a).symm
      _ = 0 := by rw [he, zero_smul]
  have hkill (k : K) (hk : (k : P) ∈ I ^ (m + 1) • (⊤ : Submodule A P))
      (a : N) : k ⊗ₜ[A] a = 0 := by
    have hk' : k ∈ I ^ (n + 1) • (⊤ : Submodule A K) := by
      have hb' := hbound (show (k : P) ∈ I ^ (m + 1) • ⊤ ⊓ K from ⟨hk, k.property⟩)
      have he : (I ^ (n + 1) • (⊤ : Submodule A K)).map K.subtype =
          I ^ (n + 1) • K := by
        rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_subtype]
      rw [← he] at hb'
      obtain ⟨k', hk', he'⟩ := hb'
      have hkk : k' = k := Subtype.ext he'
      exact hkk ▸ hk'
    refine Submodule.smul_induction_on hk' ?_ ?_
    · intro r hr k _
      rw [TensorProduct.smul_tmul, hann r hr, TensorProduct.tmul_zero]
    · intro k k' hk hk'
      rw [TensorProduct.add_tmul, hk, hk', add_zero]
  have hkern (q : f.ker) (a : M) :
      t.lTensor K (TensorProduct.comm A M K
        (eK (f.ker.subtype.lTensor M (a ⊗ₜ[S] q)))) = 0 := by
    obtain ⟨k, hk⟩ := (I ^ (m + 1) • (⊤ : Submodule A K)).mkQ_surjective
      (TensorProduct.quotTensorEquivQuotSMul K J q.val)
    have hq : q.val = 1 ⊗ₜ[A] k := by
      apply (TensorProduct.quotTensorEquivQuotSMul K J).injective
      rw [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul]
      exact hk.symm
    have hkP : (k : P) ∈ I ^ (m + 1) • (⊤ : Submodule A P) := by
      have hqzero : f q.val = 0 := q.property
      rw [hq] at hqzero
      have he := congrArg (TensorProduct.quotTensorEquivQuotSMul P J) hqzero
      have he' : (I ^ (m + 1) • (⊤ : Submodule A P)).mkQ k.val = 0 := by
        dsimp only [f] at he
        rw [LinearMap.baseChange_tmul, map_zero] at he
        change (TensorProduct.quotTensorEquivQuotSMul P J)
          ((1 : A ⧸ J) ⊗ₜ[A] k.val) = 0 at he
        rw [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul] at he
        exact he
      exact (Submodule.Quotient.mk_eq_zero _).mp he'
    dsimp only [eK]
    simp only [LinearMap.lTensor_tmul, Submodule.subtype_apply, hq,
      TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul,
      TensorProduct.comm_tmul]
    exact hkill k hkP (t a)
  have hbzero : t.lTensor K (TensorProduct.comm A M K
      (eK (f.ker.subtype.lTensor M b))) = 0 := by
    clear hb
    induction b using TensorProduct.inductionOn with
    | tmul a q => exact hkern q a
    | add b b' hb hb' => simp only [map_add, hb, hb', add_zero]
  rw [hb] at hbzero
  dsimp [z] at hbzero
  simp only [LinearEquiv.apply_symm_apply, TensorProduct.comm_comm] at hbzero
  exact hbzero

end ModuleCat
