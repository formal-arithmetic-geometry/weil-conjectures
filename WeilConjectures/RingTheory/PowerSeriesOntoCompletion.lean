module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.MvPowerSeries.Trunc
import Mathlib.RingTheory.MvPowerSeries.Equiv
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Power series map onto the completion at an ideal generated by finitely many elements

Source: Stacks Project, Tag 0316, second proof
(blueprint: lem-weil-pbc-power-series-onto-completion).
-/

@[expose] public section

universe u

namespace MvPowerSeries

/-- Stacks Project, Tag 0316, second proof:
(blueprint: lem-weil-pbc-power-series-onto-completion).
The map is specified by its projections: truncate below total degree `m`, evaluate at `f`,
and reduce modulo `I ^ m`. These projections define a compatible element of the completion.

Proof: (1) The degree-`m` monomials in `f` generate `I ^ m`, by induction on `m`
(`Ideal.mem_span_pow_iff_exists_isHomogeneous`). Thus every term of degree at least `m`
lies in `I ^ m`. (2) Successive truncations differ by terms of degree `m`, so their residues
are compatible in `AdicCompletion` [def-weil-pbc-adic-completion]. (3) Addition of series is
coefficientwise [def-weil-pbc-multivariate-power-series]; constants evaluate to themselves,
and the first truncation of a variable differs from `f i` by an element of `I`.
(4) The terms omitted from the product of two truncations have total degree at least `m`,
so multiplication agrees modulo `I ^ m`. This defines the ring homomorphism.
(5) For a compatible element choose lifts `r m` of its residues. Write each successive
correction `r (m+1) - r m` as the evaluation of a homogeneous polynomial of degree `m`,
and use `r 1` as its degree-zero part. The series with these homogeneous parts telescopes
to the chosen residues at every positive level, proving surjectivity (also Stacks Tag 05GH).
-/
theorem exists_surjective_toAdicCompletion {R : Type u} [CommRing R] (n : ℕ)
    (f : Fin n → R) (I : Ideal R) (hI : I = Ideal.span (Set.range f)) :
    ∃ Φ : MvPowerSeries (Fin n) R →+* AdicCompletion I R,
      (∀ (F : MvPowerSeries (Fin n) R) (m : ℕ), 1 ≤ m →
        AdicCompletion.evalₐ I m (Φ F) =
          Ideal.Quotient.mk (I ^ m) (MvPolynomial.eval f (MvPowerSeries.truncTotal m F))) ∧
      Function.Surjective Φ ∧
      (∀ i : Fin n, Φ (MvPowerSeries.X i) = AdicCompletion.of I R (f i)) ∧
      (∀ r : R, Φ (MvPowerSeries.C r) = AdicCompletion.of I R r) := by
  classical
  have eval_mem_pow {R : Type u} [CommRing R] (n : ℕ)
      (f : Fin n → R) (I : Ideal R) (hI : I = Ideal.span (Set.range f)) (m : ℕ)
      {p : MvPolynomial (Fin n) R}
      (hp : p ∈ MvPolynomial.idealOfVars (Fin n) R ^ m) :
      MvPolynomial.eval f p ∈ I ^ m := by
    have h : MvPolynomial.idealOfVars (Fin n) R ≤ I.comap (MvPolynomial.eval f) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      change MvPolynomial.eval f (MvPolynomial.X i) ∈ I
      simp only [MvPolynomial.eval_X]
      rw [hI]
      exact Ideal.subset_span ⟨i, rfl⟩
    exact ((pow_le_pow_left' h m).trans (Ideal.le_comap_pow (MvPolynomial.eval f) m)) hp
  let q (m : ℕ) : MvPowerSeries (Fin n) R →+* R ⧸ I ^ m :=
    (Ideal.quotientMap (I ^ m) (MvPolynomial.eval f)
      (fun _ hp ↦ eval_mem_pow n f I hI m hp)).comp
        (truncTotalAlgHom (Fin n) R m).toRingHom
  have hq (F : MvPowerSeries (Fin n) R) (m : ℕ) : q m F =
      Ideal.Quotient.mk (I ^ m) (MvPolynomial.eval f (truncTotal m F)) := by
    dsimp [q, truncTotalAlgHom]
    exact Ideal.quotientMap_mk
  have hcompat : ∀ {a b : ℕ} (h : a ≤ b),
      (Ideal.Quotient.factorPow I h).comp (q b) = q a := by
    intro a b h
    ext F
    simp only [RingHom.comp_apply, hq, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, ← map_sub]
    exact eval_mem_pow n f I hI a
      (truncTotal_sub_truncTotal_mem_pow_idealOfVars h le_rfl F)
  let Φ := AdicCompletion.liftRingHom I q hcompat
  have hΦ (F : MvPowerSeries (Fin n) R) (m : ℕ) :
      AdicCompletion.evalₐ I m (Φ F) =
        Ideal.Quotient.mk (I ^ m) (MvPolynomial.eval f (truncTotal m F)) := by
    rw [AdicCompletion.evalₐ_liftRingHom, hq]
  refine ⟨Φ, fun F m _ ↦ hΦ F m, ?_, ?_, ?_⟩
  · intro ξ
    obtain ⟨r, rfl⟩ := AdicCompletion.mk_surjective I R ξ
    have hd (m : ℕ) : r (m + 1) - r m ∈ I ^ m := by
      rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      exact AdicCompletion.Ideal.mk_eq_mk I (Nat.le_succ m) r
    have hex (m : ℕ) : ∃ p : MvPolynomial (Fin n) R,
        p.IsHomogeneous m ∧ MvPolynomial.eval f p = r (m + 1) - r m := by
      apply (Ideal.mem_span_pow_iff_exists_isHomogeneous f _).mp
      simpa [← hI] using hd m
    choose P hP hPeval using hex
    let F : MvPowerSeries (Fin n) R := fun d ↦ (P d.degree).coeff d
    have htrunc (m : ℕ) : truncTotal m F = ∑ k ∈ Finset.range m, P k := by
      ext d
      rw [coeff_truncTotal_eq_ite, MvPolynomial.coeff_sum]
      change (if d.degree < m then (P d.degree).coeff d else 0) = _
      by_cases hm : d.degree < m
      · rw [if_pos hm]
        symm
        apply Finset.sum_eq_single d.degree
        · intro k hk hkd
          exact (hP k).coeff_eq_zero (Ne.symm hkd)
        · simp [hm]
      · rw [if_neg hm]
        symm
        apply Finset.sum_eq_zero
        intro k hk
        apply (hP k).coeff_eq_zero
        exact fun h ↦ hm (h ▸ Finset.mem_range.mp hk)
    refine ⟨F + C (r 0), ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro m
    rw [hΦ, AdicCompletion.evalₐ_mk]
    by_cases hm : m = 0
    · subst m
      have : Subsingleton (R ⧸ I ^ 0) :=
        Ideal.Quotient.subsingleton_iff.mpr (by simp)
      exact Subsingleton.elim _ _
    · have hC : truncTotal m (C (r 0) : MvPowerSeries (Fin n) R) =
          MvPolynomial.C (r 0) := by
        ext d
        by_cases hd : d = 0
        · subst d
          simp [coeff_truncTotal_eq_ite, Nat.pos_of_ne_zero hm]
        · simp [coeff_truncTotal_eq_ite, coeff_C, MvPolynomial.coeff_C, hd, Ne.symm hd]
      rw [map_add, htrunc, hC, map_add, map_sum, MvPolynomial.eval_C]
      simp only [hPeval]
      congr 1
      have hsum (m : ℕ) :
          (∑ k ∈ Finset.range m, (r (k + 1) - r k)) + r 0 = r m := by
        induction m with
        | zero => simp
        | succ m ih =>
          rw [Finset.sum_range_succ]
          rw [add_right_comm, ih, add_comm, sub_add_cancel]
      exact hsum m
  · intro i
    apply AdicCompletion.ext_evalₐ
    intro m
    rw [hΦ, AdicCompletion.evalₐ_of]
    have hX : truncTotal m (X i : MvPowerSeries (Fin n) R) =
        if 1 < m then MvPolynomial.X i else 0 := by
      by_cases hm : 1 < m <;> simp only [hm, if_true, if_false]
      · ext d
        by_cases hd : d = Finsupp.single i 1
        · subst d
          simp [coeff_truncTotal_eq_ite, hm, MvPolynomial.coeff_X]
        · simp [coeff_truncTotal_eq_ite, coeff_X, MvPolynomial.coeff_X, hd, Ne.symm hd]
      · ext d
        by_cases hd : d = Finsupp.single i 1
        · subst d
          simp [coeff_truncTotal_eq_ite, hm]
        · simp [coeff_truncTotal_eq_ite, coeff_X, hd]
    rw [hX]
    split_ifs with hm
    · simp
    · simp only [map_zero]
      symm
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have hfi : f i ∈ I := hI ▸ Ideal.subset_span ⟨i, rfl⟩
      have hm' : m ≤ 1 := Nat.le_of_not_gt hm
      exact (Ideal.pow_le_pow_right hm') (by simpa using hfi)
  · intro r
    apply AdicCompletion.ext_evalₐ
    intro m
    rw [hΦ, AdicCompletion.evalₐ_of]
    have hC : truncTotal m (C r : MvPowerSeries (Fin n) R) =
        if 0 < m then MvPolynomial.C r else 0 := by
      by_cases hm : 0 < m <;> simp only [hm, if_true, if_false]
      · ext d
        by_cases hd : d = 0
        · subst d
          simp [coeff_truncTotal_eq_ite, hm]
        · simp [coeff_truncTotal_eq_ite, coeff_C, MvPolynomial.coeff_C, hd, Ne.symm hd]
      · have : m = 0 := Nat.eq_zero_of_not_pos hm
        subst m
        ext d
        simp [coeff_truncTotal_eq_ite]
    rw [hC]
    split_ifs with hm
    · simp
    · have : m = 0 := Nat.eq_zero_of_not_pos hm
      subst m
      have : Subsingleton (R ⧸ I ^ 0) :=
        Ideal.Quotient.subsingleton_iff.mpr (by simp)
      exact Subsingleton.elim _ _

end MvPowerSeries
