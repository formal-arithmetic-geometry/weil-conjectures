module

public import WeilConjectures.AlgebraicGeometry.LogRegularPair
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Category.MonCat.FilteredColimits
import Mathlib.CategoryTheory.Limits.ConcreteCategory.Basic
import Mathlib.CategoryTheory.Limits.Types.Filtered

/-!
# Filtered ring colimits and fixed-monoid unit pushouts

Source: Stacks Project, Categories, Tag 04AX, following Definition 002V;
agent-formulated unit-pushout consequence used in Tag 03PQ.
(blueprint: lem-trf-filtered-ring-log-pushout).

The existing `divisorialChartPushout` is used with the range restriction of the prelog map.
Its congruence generators `(e,1) ~ (1,β(e))` generate exactly the relations
`(r*e,a) ~ (r,β(e)*a)`: multiply a generator by `(r,a)`, and conversely set `r=a=1`.
No finiteness or cancellation assumption is made on the fixed commutative monoid.
Mathlib's `CommMonCat.FilteredColimits.colimit` has the underlying set colimit, with
multiplication computed at a common stage.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry

namespace RingTheory

/-- The quotient class `[r,a]` in the existing unit pushout.
Source: the quotient presentation in Tag 04AX's agent-formulated unit-pushout consequence.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
def ringUnitPushoutClass {R A : Type u} [CommMonoid R] [CommRing A]
    (β : R →* A) (r : R) (a : Aˣ) : divisorialChartPushout β.mrangeRestrict :=
  (divisorialChartCongruence β.mrangeRestrict).mk' (r, a)

/-- The pair map respects the generated congruence.
Source: Tag 04AX, unit-pushout consequence, node Step 4.
Proof: a generator identifies `(e,1)` with `(1,a)` when `β(e)=a`.
Compatibility gives `γ(e)=f(a)`, so its image is a target generator. The kernel
is a congruence, hence contains the congruence generated by these relations.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
theorem ringUnitPushoutMap_wellDefined {R A A' : Type u}
    [CommMonoid R] [CommRing A] [CommRing A'] (β : R →* A) (γ : R →* A')
    (f : A →+* A') (h : ∀ r : R, f (β r) = γ r) :
    divisorialChartCongruence β.mrangeRestrict ≤
      Con.ker ((divisorialChartCongruence γ.mrangeRestrict).mk'.comp
        ((MonoidHom.id R).prodMap (Units.map f.toMonoidHom))) := by
  sorry

/-- The induced quotient map, keeping the monoid coordinate and mapping the unit by `f`.
Its data is the actual quotient lift; the preceding theorem supplies only its well-definedness.
Source: Tag 04AX, unit-pushout consequence, node Step 4.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
def ringUnitPushoutMap {R A A' : Type u}
    [CommMonoid R] [CommRing A] [CommRing A'] (β : R →* A) (γ : R →* A')
    (f : A →+* A') (h : ∀ r : R, f (β r) = γ r) :
    divisorialChartPushout β.mrangeRestrict ⟶ divisorialChartPushout γ.mrangeRestrict :=
  CommMonCat.ofHom ((divisorialChartCongruence β.mrangeRestrict).lift
    ((divisorialChartCongruence γ.mrangeRestrict).mk'.comp
      ((MonoidHom.id R).prodMap (Units.map f.toMonoidHom)))
    (ringUnitPushoutMap_wellDefined β γ f h))

/-- Identity transitions act identically on the quotient.
Source: Tag 04AX, unit-pushout consequence, node Step 4.
Proof: on each pair representative the functor identity law fixes the unit and
leaves the first coordinate unchanged. Pair representatives exhaust the quotient.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
theorem ringUnitPushoutDiagram_id {I : Type u} [SmallCategory I]
    (B : I ⥤ CommRingCat.{u}) {R : Type u} [CommMonoid R]
    (β : ∀ i : I, R →* B.obj i)
    (hβ : ∀ {i j : I} (f : i ⟶ j) (r : R), B.map f (β i r) = β j r) (i : I) :
    ringUnitPushoutMap (β i) (β i) (B.map (𝟙 i)).hom (hβ (𝟙 i)) = 𝟙 _ := by
  sorry

/-- Composite transitions compose on the quotient.
Source: Tag 04AX, unit-pushout consequence, node Step 4.
Proof: on a pair representative this is the functor composition law of `B`
and functoriality of `Units.map`. Equality on all pairs is equality on the quotient.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
theorem ringUnitPushoutDiagram_comp {I : Type u} [SmallCategory I]
    (B : I ⥤ CommRingCat.{u}) {R : Type u} [CommMonoid R]
    (β : ∀ i : I, R →* B.obj i)
    (hβ : ∀ {i j : I} (f : i ⟶ j) (r : R), B.map f (β i r) = β j r)
    {i j k : I} (f : i ⟶ j) (g : j ⟶ k) :
    ringUnitPushoutMap (β i) (β k) (B.map (f ≫ g)).hom (hβ (f ≫ g)) =
      ringUnitPushoutMap (β i) (β j) (B.map f).hom (hβ f) ≫
        ringUnitPushoutMap (β j) (β k) (B.map g).hom (hβ g) := by
  sorry

/-- The induced diagram of the actual unit-pushout quotients.
Source: Tag 04AX, unit-pushout consequence, node Step 4.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
def ringUnitPushoutDiagram {I : Type u} [SmallCategory I]
    (B : I ⥤ CommRingCat.{u}) {R : Type u} [CommMonoid R]
    (β : ∀ i : I, R →* B.obj i)
    (hβ : ∀ {i j : I} (f : i ⟶ j) (r : R), B.map f (β i r) = β j r) :
    I ⥤ CommMonCat.{u} where
  obj i := divisorialChartPushout (β i).mrangeRestrict
  map f := ringUnitPushoutMap (β _) (β _) (B.map f).hom (hβ f)
  map_id i := ringUnitPushoutDiagram_id B β hβ i
  map_comp f g := ringUnitPushoutDiagram_comp B β hβ f g

/-- The underlying set colimit with Mathlib's canonical commutative-monoid structure.
Source: Tag 04AX, unit-pushout consequence, node Step 5. This is the explicit
filtered set quotient, not a new choice of an abstract monoid colimit.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
noncomputable abbrev ringUnitPushoutColimit {I : Type u} [SmallCategory I] [IsFiltered I]
    (B : I ⥤ CommRingCat.{u}) {R : Type u} [CommMonoid R]
    (β : ∀ i : I, R →* B.obj i)
    (hβ : ∀ {i j : I} (f : i ⟶ j) (r : R), B.map f (β i r) = β j r) : CommMonCat.{u} :=
  CommMonCat.FilteredColimits.colimit.{u, u} (ringUnitPushoutDiagram B β hβ)

/-- The canonical stage map to the underlying set colimit with its monoid structure.
Source: Tag 04AX, unit-pushout consequence, node Step 5.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
noncomputable def ringUnitPushoutColimitι {I : Type u}
    [SmallCategory I] [IsFiltered I] (B : I ⥤ CommRingCat.{u})
    {R : Type u} [CommMonoid R] (β : ∀ i : I, R →* B.obj i)
    (hβ : ∀ {i j : I} (f : i ⟶ j) (r : R), B.map f (β i r) = β j r) (i : I) :
    divisorialChartPushout (β i).mrangeRestrict ⟶ ringUnitPushoutColimit B β hβ :=
  (CommMonCat.FilteredColimits.colimitCocone.{u, u} (ringUnitPushoutDiagram B β hβ)).ι.app i

/-- Units lift and become equal at common stages, and fixed-monoid unit pushouts
commute with filtered ring colimits, including the prescribed inverse and both inclusions.

Source: Stacks, Tag 04AX, following Definition 002V, with its agent-formulated
unit-pushout consequence used at geometric stalks in Tag 03PQ.
Proof (the eight steps of the DAG node):
1. Filteredness gives simultaneous common targets for finite diagrams: first combine
   objects and then successively equalize the finitely many parallel composites.
2. By `lem-pc-filtered-colimit-commrings-elementwise`, represent the inverse of an
   element whose colimit image is a unit. Move both to one stage and then make their
   product equal to one. This lifts units, also from any prescribed starting stage.
3. Apply the same elementwise eventual-equality clause to the underlying elements
   of two units. Equality of units follows from equality of their values.
4. The quotient maps and diagram above send generators to generators; identities
   and composition are checked on pairs. The maps to the final quotient are compatible.
5. By `lem-weil-pbc-filtered-colimit-sets-elementwise`, compute products at a common
   stage. Step 1 makes this independent of representatives, arrows and target. At a
   common stage the monoid laws hold, giving the canonical monoid structure used here.
6. Define the inverse on `(r,a)` using any stage unit representing `a`. Step 3 makes
   this independent of that unit representative. A common stage proves multiplicativity.
7. For a final relation involving `e`, Step 2 moves a representative of `a` to a stage
   where `β(e)` is a unit. The stage quotient relation then identifies both values of
   the inverse. Its kernel is a congruence, so it respects every generated relation.
8. Both composites fix each represented pair, hence are identities, by the set-colimit
   representative clause. Applying the formula to `(r,1)` and `(1,a)` gives compatibility
   with the fixed monoid and every stage unit group. No finite generation or cancellation
   was used, and unit-representative independence is encoded by quantifying over all lifts.
(blueprint: lem-trf-filtered-ring-log-pushout). -/
theorem filteredRing_logPushout {I : Type u} [SmallCategory I] [IsFiltered I]
    (B : I ⥤ CommRingCat.{u}) {R : Type u} [CommMonoid R]
    (β : ∀ i : I, R →* B.obj i)
    (hβ : ∀ {i j : I} (f : i ⟶ j) (r : R), B.map f (β i r) = β j r)
    (βA : R →* (colimit B : CommRingCat.{u}))
    (hβA : ∀ (i : I) (r : R), colimit.ι B i (β i r) = βA r) :
    (∀ a : (colimit B : CommRingCat.{u})ˣ,
      ∃ (i : I) (b : (B.obj i)ˣ), Units.map (colimit.ι B i).hom.toMonoidHom b = a) ∧
    (∀ (i j : I) (a : (B.obj i)ˣ) (b : (B.obj j)ˣ),
      Units.map (colimit.ι B i).hom.toMonoidHom a =
        Units.map (colimit.ι B j).hom.toMonoidHom b →
      ∃ (k : I) (f : i ⟶ k) (g : j ⟶ k),
        Units.map (B.map f).hom.toMonoidHom a = Units.map (B.map g).hom.toMonoidHom b) ∧
    (∀ (i : I) (r : R), IsUnit (βA r) ↔
      ∃ (j : I) (_f : i ⟶ j), IsUnit (β j r)) ∧
    (∀ (i j k : I) (f : i ⟶ k) (g : j ⟶ k)
      (x : divisorialChartPushout (β i).mrangeRestrict)
      (y : divisorialChartPushout (β j).mrangeRestrict),
      ringUnitPushoutColimitι B β hβ i x * ringUnitPushoutColimitι B β hβ j y =
        ringUnitPushoutColimitι B β hβ k
          ((ringUnitPushoutDiagram B β hβ).map f x *
            (ringUnitPushoutDiagram B β hβ).map g y)) ∧
    ∃ F : ringUnitPushoutColimit B β hβ ≃* divisorialChartPushout βA.mrangeRestrict,
      (∀ (i : I) (r : R) (a : (B.obj i)ˣ),
        F (ringUnitPushoutColimitι B β hβ i (ringUnitPushoutClass (β i) r a)) =
          ringUnitPushoutClass βA r (Units.map (colimit.ι B i).hom.toMonoidHom a)) ∧
      (∀ (r : R) (a : (colimit B : CommRingCat.{u})ˣ) (i : I) (b : (B.obj i)ˣ),
        Units.map (colimit.ι B i).hom.toMonoidHom b = a →
          F.symm (ringUnitPushoutClass βA r a) =
            ringUnitPushoutColimitι B β hβ i (ringUnitPushoutClass (β i) r b)) ∧
      (∀ (i : I) (r : R),
        F (ringUnitPushoutColimitι B β hβ i (ringUnitPushoutClass (β i) r 1)) =
          ringUnitPushoutClass βA r 1) ∧
      (∀ (i : I) (a : (B.obj i)ˣ),
        F (ringUnitPushoutColimitι B β hβ i (ringUnitPushoutClass (β i) 1 a)) =
          ringUnitPushoutClass βA 1 (Units.map (colimit.ι B i).hom.toMonoidHom a)) := by
  sorry

end RingTheory
