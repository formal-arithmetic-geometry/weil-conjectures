module

public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# The singular ideal of a ring map

We define smoothness of a ring map at a prime, the singular ideal `H_{A/R}` as the radical of
the ideal generated by the elements `g` with `A_g` smooth over `R`, and show that its zero locus
is the nonsmooth locus.

## References

* [Stacks, Tag 00TB]
* [Stacks, Tag 07C5]
* [Stacks, Tag 00E0]
-/

@[expose] public section

universe u v

namespace Algebra

/-- Smoothness of `R → A` at a prime: some principal localization outside the prime is a
smooth `R`-algebra. -/
def IsSmoothAtPrime (R : Type u) {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
    (q : PrimeSpectrum A) : Prop :=
  ∃ g : A, g ∉ q.asIdeal ∧ Smooth R (Localization.Away g)

/-- The elements whose principal localizations are smooth over `R`. -/
def smoothElements (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A] :
    Set A :=
  {g | Smooth R (Localization.Away g)}

/-- The singular ideal `H_{A/R}` is the radical of the ideal generated by elements `g`
for which `A_g` is smooth over `R`. -/
def singularIdeal (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A] :
    Ideal A :=
  (Ideal.span (smoothElements R A)).radical

/-- The singular ideal is a radical ideal. -/
theorem singularIdeal_isRadical (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] : (singularIdeal R A).IsRadical := by
  exact Ideal.radical_isRadical _

/-- The smooth locus is the union of the basic opens `D(g)` of the elements `g` with `A_g`
smooth over `R`. -/
theorem smoothAtPrime_locus_eq (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] :
    {q : PrimeSpectrum A | IsSmoothAtPrime R q} =
      ⋃ g ∈ smoothElements R A, (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum A)) := by
  ext q
  simp only [Set.mem_ofPred_eq, Set.mem_iUnion, SetLike.mem_coe,
    PrimeSpectrum.mem_basicOpen, IsSmoothAtPrime, smoothElements, exists_prop]
  exact exists_congr fun g ↦ and_comm

/-- The smooth locus is open in `Spec A`. -/
theorem isOpen_smoothAtPrime_locus (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] :
    IsOpen {q : PrimeSpectrum A | IsSmoothAtPrime R q} := by
  rw [smoothAtPrime_locus_eq]
  exact isOpen_iUnion fun g ↦ isOpen_iUnion fun _ ↦ (PrimeSpectrum.basicOpen g).isOpen


/-- The zero locus of `H_{A/R}` is precisely the nonsmooth locus, or equivalently the
intersection of the zero loci of all smooth localization elements. -/
theorem singularIdeal_zeroLocus (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] :
    PrimeSpectrum.zeroLocus (singularIdeal R A : Set A) =
      {q : PrimeSpectrum A | ¬ IsSmoothAtPrime R q} ∧
    PrimeSpectrum.zeroLocus (singularIdeal R A : Set A) =
      ⋂ g ∈ smoothElements R A, PrimeSpectrum.zeroLocus ({g} : Set A) := by
  rw [singularIdeal, PrimeSpectrum.zeroLocus_radical, PrimeSpectrum.zeroLocus_span]
  constructor
  · ext q
    simp only [PrimeSpectrum.mem_zeroLocus, Set.mem_ofPred_eq, IsSmoothAtPrime,
      smoothElements, Set.subset_def, Set.mem_ofPred_eq]
    constructor
    · intro h ⟨g, hg, hs⟩
      exact hg (h g hs)
    · intro h g hs
      by_contra hg
      exact h ⟨g, hg, hs⟩
  · ext q
    simp only [PrimeSpectrum.mem_zeroLocus, Set.mem_iInter, Set.subset_def,
      Set.mem_singleton_iff, forall_eq]

/-- `H_{A/R}` is the unique radical ideal with the nonsmooth locus as its zero locus. -/
theorem singularIdeal_unique (R : Type u) (A : Type v) [CommRing R] [CommRing A]
    [Algebra R A] (J : Ideal A) (hJ : J.IsRadical)
    (hV : PrimeSpectrum.zeroLocus (J : Set A) =
      {q : PrimeSpectrum A | ¬ IsSmoothAtPrime R q}) :
    J = singularIdeal R A := by
  have h := PrimeSpectrum.zeroLocus_eq_iff.mp
    (hV.trans (singularIdeal_zeroLocus R A).1.symm)
  rwa [hJ.radical, (singularIdeal_isRadical R A).radical] at h


end Algebra
