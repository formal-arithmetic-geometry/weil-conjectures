module

public import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs
public import WeilConjectures.RingTheory.StrictHenselizationDimension
public import WeilConjectures.RingTheory.StrictHenselizationLocalMaximalIdeal
public import WeilConjectures.RingTheory.StrictHenselizationNoetherian
public import WeilConjectures.RingTheory.StrictHenselizationRegular
public import WeilConjectures.RingTheory.StrictHenselizationSurjectiveQuotient

/-!
# Strict henselizations of regular local rings of dimension one

Let `C` be a strict henselization of a noetherian local ring `A` and `I` an ideal of `A` such
that `A ⧸ I` is a regular local ring of dimension one whose maximal ideal is generated by the
image of `t`. Then `C ⧸ I C` is a discrete valuation ring with uniformizer the image of `t`: it is
the strict henselization of `A ⧸ I` (Stacks, Tag 05WS), hence noetherian (Tag 06LJ), regular
(Tag 06LN) of dimension one (Tag 06LK), and its maximal ideal is generated by the maximal ideal
of `A ⧸ I`.

This is the algebraic input to the computation of the punctured trait `X_S - z` at a transverse
corner (blueprint `lemma-punctured-surface-punctured-curve--1`): `X_S` is the spectrum of the strict
henselization of the local ring of the regular curve `X` at the corner, a strictly henselian
trait whose uniformizer is a local equation of the other divisor.

## Main statements

- `Algebra.IsStrictHenselization.isDiscreteValuationRing_quotient`
-/

@[expose] public section

universe u

open IsLocalRing

namespace Algebra.IsStrictHenselization

variable {A K C : Type u} [CommRing A] [IsLocalRing A] [Field K]
  [Algebra (ResidueField A) K] [IsSepClosure (ResidueField A) K]
  [Algebra A K] [IsScalarTower A (ResidueField A) K]
  [CommRing C] [Algebra A C]

set_option backward.isDefEq.respectTransparency false in
/-- **The strict henselization of a trait.** Let `C` be a strict henselization of a local ring
`A`, and `I` an ideal of `A` such that `A ⧸ I` is a regular local ring of dimension one whose
maximal ideal is generated by the image of `t`. Then `C ⧸ I C` is a discrete valuation ring and
the image of `t` is a uniformizer; `J` and `s` are the extension of `I` and the image of `t`
(blueprint `lemma-punctured-surface-punctured-curve--1`). -/
theorem isDiscreteValuationRing_quotient (hC : IsStrictHenselization A K C) (I : Ideal A)
    [IsRegularLocalRing (A ⧸ I)] (hdim : ringKrullDim (A ⧸ I) = 1) (t : A)
    (ht : maximalIdeal (A ⧸ I) = Ideal.span {Ideal.Quotient.mk I t}) (J : Ideal C)
    (hJ : I.map (algebraMap A C) = J) (s : C) (hs : algebraMap A C t = s) :
    ∃ (_ : IsDomain (C ⧸ J)), IsDiscreteValuationRing (C ⧸ J) ∧
      Irreducible (Ideal.Quotient.mk J s) := by
  subst hJ hs
  set B := A ⧸ I
  set D := C ⧸ I.map (algebraMap A C)
  let L := SeparableClosure (ResidueField B)
  let : Algebra B L := ((algebraMap (ResidueField B) L).comp (residue B)).toAlgebra
  have : IsScalarTower B (ResidueField B) L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hD : IsStrictHenselization B L D :=
    hC.surjective_quotient A K C B L (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective I
      (Ideal.mk_ker) rfl
  obtain ⟨_, hm⟩ := strictHenselization_local_maximalIdeal B L D hD
  have : IsNoetherianRing D := (isNoetherianRing_iff_isStrictHenselization B L D hD).1 inferInstance
  have : IsRegularLocalRing D :=
    (isRegularLocalRing_iff_strictHenselization B L D hD).1 inferInstance
  have hdimD : ringKrullDim D = 1 := (ringKrullDim_eq_of_isStrictHenselization B L D hD) ▸ hdim
  have := IsRegularLocalRing.isDiscreteValuationRing D hdimD
  refine ⟨inferInstance, this, ?_⟩
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer, hm, ht, Ideal.map_span,
    Set.image_singleton]
  rfl

/-- The strict henselization of a regular local ring is a domain (Stacks, Tags 06LN, 00NP). -/
theorem isDomain_of_isRegularLocalRing (hC : IsStrictHenselization A K C)
    (hA : IsRegularLocalRing A) : IsDomain C := by
  have := (isRegularLocalRing_iff_strictHenselization A K C hC).1 hA
  infer_instance

end Algebra.IsStrictHenselization

/-- If the maximal ideal of a local ring `A` is generated by an ideal `I` and an element `t`,
then the maximal ideal of `A ⧸ I` is generated by the image of `t`. -/
lemma IsLocalRing.maximalIdeal_quotient_eq_span_singleton {A : Type*} [CommRing A]
    [IsLocalRing A] {I : Ideal A} [IsLocalRing (A ⧸ I)] {t : A}
    (h : I ⊔ Ideal.span {t} = maximalIdeal A) :
    maximalIdeal (A ⧸ I) = Ideal.span {Ideal.Quotient.mk I t} := by
  rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective, ← h, Ideal.map_sup,
    Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, Set.image_singleton]

/-- The localization of a discrete valuation ring away from a uniformizer is its fraction
field. -/
lemma IsDiscreteValuationRing.isFractionRing_of_isLocalization_away {B L : Type*} [CommRing B]
    [IsDomain B] [IsDiscreteValuationRing B] {π : B} (hπ : Irreducible π) [CommRing L]
    [Algebra B L] [IsLocalization.Away π L] : IsFractionRing B L := by
  refine IsLocalization.of_le (Submonoid.powers π) _ ?_ fun r hr ↦ ?_
  · exact Submonoid.powers_le.2 (mem_nonZeroDivisors_of_ne_zero hπ.ne_zero)
  · obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
      (nonZeroDivisors.ne_zero hr) hπ
    rw [map_mul, map_pow]
    exact (u.isUnit.map _).mul ((IsLocalization.Away.algebraMap_isUnit π).pow n)
