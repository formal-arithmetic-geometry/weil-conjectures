module

public import WeilConjectures.RingTheory.TangentCone
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs

/-!
# Initial forms of plane curves spanning all forms of high degree

Let `R` be a local ring with maximal ideal `𝔪`. For `f ∈ 𝔪^d ∖ 𝔪^(d+1)` the *initial form* of `f`
is its class in `𝔪^d/𝔪^(d+1)`, a homogeneous element of degree `d` of the associated graded ring
`gr_𝔪 R = ⨁ 𝔪^n/𝔪^(n+1)`, and the tangent cone of the curve `V(f)` at the closed point is the
cone `V(in f) ⊆ Spec gr_𝔪 R`. Two such tangent cones `V(in f)` and `V(in g)` meet only at the
vertex if and only if the ideal `(in f, in g)` contains all homogeneous elements of large degree,
that is, if for large `n` every element of `𝔪^n` is congruent modulo `𝔪^(n+1)` to an element of
`f 𝔪^(n-d) + g 𝔪^(n-e)`. This is the condition `C_t D ∩ C_t B = {0}` of the blueprint
(`lemma-vanishing-restrictions-after-blowing-up--1`); for a regular curve `H = V(h)`, `h ∈ 𝔪 ∖ 𝔪²`,
the tangent cone is the tangent line `T_t H`.

## Main definitions

- `IsLocalRing.HasOrder f d`: `f ∈ 𝔪^d ∖ 𝔪^(d+1)`.
- `IsLocalRing.InitialFormsSpanHighDegree f g`: the initial forms of `f` and `g` span all forms of
  large degree; for `R` regular this says that the tangent cones of `V(f)` and `V(g)` meet only at
  the origin (`IsLocalRing.TangentConesMeetAtOrigin R (f) (g)`).
- `blowupChart x y`: the ring `R[T]/(xT - y)`, the chart of the blow-up of `Spec R` at
  `(x, y)` on which `x` generates the exceptional ideal.
-/

@[expose] public section

universe u

open Polynomial

namespace IsLocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- `f` has order `d` at the closed point: `f ∈ 𝔪^d ∖ 𝔪^(d+1)`. -/
def HasOrder (f : R) (d : ℕ) : Prop :=
  f ∈ maximalIdeal R ^ d ∧ f ∉ maximalIdeal R ^ (d + 1)

/-- The tangent cones at the closed point of the curves `V(f)` and `V(g)` meet only at the origin:
`f` and `g` have orders `d` and `e`, and for all large `n`,
`𝔪^n ⊆ f 𝔪^(n-d) + g 𝔪^(n-e) + 𝔪^(n+1)`, that is, the initial forms `in f` and `in g` generate
an ideal of the associated graded ring `gr_𝔪 R` containing all forms of large degree. -/
def InitialFormsSpanHighDegree (f g : R) : Prop :=
  ∃ d e : ℕ, HasOrder f d ∧ HasOrder g e ∧ ∃ N : ℕ, ∀ n ≥ N,
    maximalIdeal R ^ n ≤ Ideal.span {f} * maximalIdeal R ^ (n - d) ⊔
      Ideal.span {g} * maximalIdeal R ^ (n - e) ⊔ maximalIdeal R ^ (n + 1)

end IsLocalRing

/-- The chart `R[T]/(xT - y)` of the blow-up of `Spec R` along the ideal `(x, y)`, on which the
exceptional ideal is generated by `x` and `T` is the function `y/x`. -/
abbrev blowupChart {R : Type u} [CommRing R] (x y : R) : Type u :=
  R[X] ⧸ Ideal.span {C x * X - C y}
