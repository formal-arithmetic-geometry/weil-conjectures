module

public import Mathlib.RingTheory.Localization.Algebra
public import Mathlib.RingTheory.Extension.Presentation.Submersive
public import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.RingTheory.MvPolynomial.Localization

/-!
# Integral equations for a rescaled smooth presentation

Source: Stacks Project, Smoothing Ring Maps, Tag 07F4, rescaling the extra variables
and clearing the coefficients of the equations.
-/

@[expose] public section

universe u w x

namespace Algebra

open MvPolynomial

private theorem scale_pderiv {K : Type u} [CommRing K] {ι : Type w}
    (a : ι → K) (p : MvPolynomial ι K) (i : ι) :
    pderiv i (aeval (fun j ↦ C (a j) * X j) p) =
      C (a i) * aeval (fun j ↦ C (a j) * X j) (pderiv i p) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simp [hp, hq, mul_add]
  | mul_X p j hp =>
    simp only [map_mul, aeval_X, pderiv_mul, pderiv_X, hp,
      map_add, map_mul]
    by_cases h : j = i
    · subst j
      simp
      ring
    · simp [h]
      ring

private noncomputable def scaleEquiv {K : Type u} [CommRing K] {ι : Type w}
    (a : ι → Kˣ) : MvPolynomial ι K ≃ₐ[K] MvPolynomial ι K :=
  AlgEquiv.ofAlgHom (aeval (fun i ↦ C (a i : K) * X i))
    (aeval (fun i ↦ C (↑((a i)⁻¹) : K) * X i))
    (by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, AlgHom.id_apply, aeval_X, map_mul, aeval_C,
        MvPolynomial.algebraMap_eq]
      rw [← mul_assoc, ← map_mul]
      simp)
    (by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, AlgHom.id_apply, aeval_X, map_mul, aeval_C,
        MvPolynomial.algebraMap_eq]
      rw [← mul_assoc, ← map_mul]
      simp)

private theorem clear_equation {R : Type u} [CommRing R] (S : Submonoid R)
    {ι : Type w} (q : MvPolynomial ι (Localization S)) :
    ∃ (f : MvPolynomial ι R) (d : S),
      MvPolynomial.map (algebraMap R (Localization S)) f =
        C (algebraMap R (Localization S) d.val) * q := by
  let : Algebra (MvPolynomial ι R) (MvPolynomial ι (Localization S)) :=
    MvPolynomial.algebraMvPolynomial
  obtain ⟨⟨f, d⟩, hd⟩ := IsLocalization.surj (S.map (C (σ := ι))) q
  obtain ⟨r, hr, hrd⟩ := d.property
  refine ⟨f, ⟨r, hr⟩, ?_⟩
  change q * MvPolynomial.map (algebraMap R (Localization S)) d.val =
    MvPolynomial.map (algebraMap R (Localization S)) f at hd
  rw [← hrd, map_C] at hd
  simpa only [mul_comm] using hd.symm


/-- Rescale the extra generators of a smooth presentation so that their images lift
before localization, and clear only the coefficients of its equations.
Source: Stacks Project, Smoothing Ring Maps, Tag 07F4 (`lemma-delocalize-base`),
the paragraph beginning "After multiplying" and the clearing of the `f_j`.
(blueprint: lem-weil-pbc-popescu-rescaled-presentation).

Proof: write each extra generator's image as `l_i/d_i`, with `d_i` in `S`.
For the first `n` indices set `d_i = 1` and use the specified `lfirst i`.
Put `z_i = d_i Q.val_i` and substitute `X_i/d_i` in each equation of `Q`.
Substitution by `d_i X_i` is the inverse automorphism, so evaluation at `z` is
surjective and its kernel is generated by the substituted equations. The chain rule
multiplies row `i` of the selected Jacobian by the unit `d_i⁻¹`. Clear the finitely
many coefficients in each substituted equation by an element of `S`, obtaining
`f_j` over `R`. Multiplication by these units preserves the generated ideal, and
scales each column of the Jacobian by a unit. Thus the evaluated minor is still a
unit. The first generators stay fixed, and every `gamma z_i` is the image of `l_i`.
The construction uses empty products when there are no extra variables or equations;
it also works for the zero localization, without assuming injectivity. -/
theorem exists_rescaled_integral_presentation
    {R : Type u} {Λ : Type w} [CommRing R] [CommRing Λ] [Algebra R Λ]
    (S : Submonoid R) {n m c : ℕ} (hc : c ≤ n + m)
    {D : Type x} [CommRing D] [Algebra (Localization S) D]
    (Q : SubmersivePresentation (Localization S) D (Fin (n + m)) (Fin c))
    (γ : D →ₐ[Localization S] Localization (algebraMapSubmonoid Λ S))
    (lfirst : Fin n → Λ) (hmap : Q.map = Fin.castLE hc)
    (hfirst : ∀ i : Fin n, γ (Q.val (Fin.castAdd m i)) =
      algebraMap Λ (Localization (algebraMapSubmonoid Λ S)) (lfirst i)) :
    ∃ (f : Fin c → MvPolynomial (Fin (n + m)) R)
      (l : Fin (n + m) → Λ) (z : Fin (n + m) → D),
      (∀ i : Fin n, l (Fin.castAdd m i) = lfirst i) ∧
      (∀ i : Fin n, z (Fin.castAdd m i) = Q.val (Fin.castAdd m i)) ∧
      (∀ i, γ (z i) = algebraMap Λ (Localization (algebraMapSubmonoid Λ S)) (l i)) ∧
      Function.Surjective (aeval z : MvPolynomial (Fin (n + m)) (Localization S) →ₐ[_] D) ∧
      RingHom.ker (aeval z : MvPolynomial (Fin (n + m)) (Localization S) →ₐ[_] D) =
        Ideal.span (Set.range (fun j ↦ MvPolynomial.map (algebraMap R (Localization S))
          (f j))) ∧
      IsUnit (aeval z (MvPolynomial.map (algebraMap R (Localization S))
        (Matrix.det (fun i j : Fin c ↦ pderiv (Fin.castLE hc i) (f j))))) := by
  classical
  let K := Localization S
  let L := Localization (algebraMapSubmonoid Λ S)
  have hextra (i : Fin m) : ∃ (d : S) (l : Λ),
      γ (Q.val (Fin.natAdd n i)) * algebraMap R L d.val = algebraMap Λ L l := by
    obtain ⟨⟨l, d⟩, hd⟩ := IsLocalization.surj (algebraMapSubmonoid Λ S)
      (γ (Q.val (Fin.natAdd n i)))
    obtain ⟨r, hr, hrd⟩ := d.property
    refine ⟨⟨r, hr⟩, l, ?_⟩
    change γ (Q.val (Fin.natAdd n i)) * algebraMap Λ L d.val = algebraMap Λ L l at hd
    rw [← hrd, ← IsScalarTower.algebraMap_apply R Λ L] at hd
    exact hd
  choose dextra lextra hextra using hextra
  let d : Fin (n + m) → S := Fin.addCases (fun _ ↦ 1) dextra
  let l : Fin (n + m) → Λ := Fin.addCases lfirst lextra
  have hd (i : Fin n) : d (Fin.castAdd m i) = 1 := by simp [d]
  have hl (i : Fin n) : l (Fin.castAdd m i) = lfirst i := by simp [l]
  have hγd (i : Fin (n + m)) :
      γ (Q.val i) * algebraMap R L (d i).val = algebraMap Λ L (l i) := by
    refine Fin.addCases (fun j ↦ ?_) (fun j ↦ ?_) i
    · simpa only [hd, Submonoid.coe_one, map_one, mul_one, hl] using hfirst j
    · simpa only [d, l, Fin.addCases_right] using hextra j
  let u : Fin (n + m) → Kˣ := fun i ↦ (IsLocalization.map_units K (d i)).unit
  have hu (i) : (u i : K) = algebraMap R K (d i).val :=
    (IsLocalization.map_units K (d i)).unit_spec
  let z : Fin (n + m) → D := fun i ↦ algebraMap K D (u i : K) * Q.val i
  have hz (i : Fin n) : z (Fin.castAdd m i) = Q.val (Fin.castAdd m i) := by
    simp [z, hu, hd]
  have hγz (i) : γ (z i) = algebraMap Λ L (l i) := by
    simp only [z, map_mul, hu]
    rw [γ.commutes, ← IsScalarTower.algebraMap_apply R K L, mul_comm]
    exact hγd i
  let τ := scaleEquiv (fun i ↦ (u i)⁻¹)
  let q := fun j ↦ τ (Q.relation j)
  have het : (aeval z : MvPolynomial (Fin (n + m)) K →ₐ[K] D).comp τ.toAlgHom =
      aeval Q.val := by
    ext i
    simp only [AlgHom.comp_apply, aeval_X]
    have ht : τ (X i) = C (↑((u i)⁻¹) : K) * X i := aeval_X _ i
    simp only [AlgEquiv.coe_toAlgHom]
    rw [ht, map_mul, aeval_C, aeval_X]
    simp only [z]
    rw [← mul_assoc, ← map_mul]
    simp
  have he : Function.Surjective
      (aeval z : MvPolynomial (Fin (n + m)) K →ₐ[K] D) := by
    intro x
    obtain ⟨p, hp⟩ := Q.aeval_val_surjective x
    exact ⟨τ p, (DFunLike.congr_fun het p).trans hp⟩
  have hker : RingHom.ker
      (aeval z : MvPolynomial (Fin (n + m)) K →ₐ[K] D) = Ideal.span (Set.range q) := by
    have hkQ : RingHom.ker (aeval Q.val) = Ideal.comap
        (τ : MvPolynomial (Fin (n + m)) K →+* MvPolynomial (Fin (n + m)) K)
        (RingHom.ker (aeval z : MvPolynomial (Fin (n + m)) K →ₐ[K] D)) := by
      ext p
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker]
      have hp := DFunLike.congr_fun het p
      change aeval z (τ p) = aeval Q.val p at hp
      change aeval Q.val p = 0 ↔ aeval z (τ p) = 0
      rw [hp]
    rw [show Set.range q = τ '' Set.range Q.relation from Set.range_comp' _ _,
      ← Ideal.map_span, Q.span_range_relation_eq_ker, Q.ker_eq_ker_aeval_val,
      hkQ]
    exact (Ideal.map_comap_of_surjective
      (τ : MvPolynomial (Fin (n + m)) K →+* MvPolynomial (Fin (n + m)) K)
      τ.surjective _).symm
  choose f drel hrel using fun j ↦ clear_equation S (q j)
  refine ⟨f, l, z, hl, hz, hγz, he, ?_, ?_⟩
  · rw [hker]
    simp_rw [Ideal.span_range_eq_iSup]
    congr 1
    funext j
    rw [hrel j]
    exact (Ideal.span_singleton_mul_left_unit
      ((IsLocalization.map_units K (drel j)).map C) (q j)).symm
  · have hpartial (i j : Fin c) :
        MvPolynomial.map (algebraMap R K) (pderiv (Fin.castLE hc i) (f j)) =
          C (algebraMap R K (drel j).val) *
            (C (↑((u (Fin.castLE hc i))⁻¹) : K) *
              τ (pderiv (Fin.castLE hc i) (Q.relation j))) := by
      have h := congrArg (pderiv (Fin.castLE hc i)) (hrel j)
      rw [pderiv_map, pderiv_C_mul] at h
      have hscale : pderiv (Fin.castLE hc i) (q j) =
          C (↑((u (Fin.castLE hc i))⁻¹) : K) *
            τ (pderiv (Fin.castLE hc i) (Q.relation j)) :=
        scale_pderiv (fun i ↦ (↑((u i)⁻¹) : K)) (Q.relation j) (Fin.castLE hc i)
      rw [hscale] at h
      exact h
    have hentry (i j : Fin c) :
        aeval z (MvPolynomial.map (algebraMap R K) (pderiv (Fin.castLE hc i) (f j))) =
          algebraMap K D (algebraMap R K (drel j).val) *
            (algebraMap K D (↑((u (Fin.castLE hc i))⁻¹) : K) *
              aeval Q.val (pderiv (Fin.castLE hc i) (Q.relation j))) := by
      rw [hpartial]
      simp only [map_mul, aeval_C]
      have heq := DFunLike.congr_fun het (pderiv (Fin.castLE hc i) (Q.relation j))
      change aeval z (τ (pderiv (Fin.castLE hc i) (Q.relation j))) =
        aeval Q.val (pderiv (Fin.castLE hc i) (Q.relation j)) at heq
      rw [heq]
    let v : Fin c → D := fun j ↦ algebraMap K D (algebraMap R K (drel j).val)
    let w : Fin c → D := fun i ↦ algebraMap K D (↑((u (Fin.castLE hc i))⁻¹) : K)
    let B : Matrix (Fin c) (Fin c) D := fun i j ↦
      aeval Q.val (pderiv (Fin.castLE hc i) (Q.relation j))
    have hB : IsUnit B.det := by
      have h := Q.jacobian_isUnit
      rw [PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Q.algebraMap_apply, AlgHom.map_det] at h
      convert h using 1
      congr 1
      ext i j
      simp only [B, AlgHom.mapMatrix_apply, Matrix.map_apply,
        PreSubmersivePresentation.jacobiMatrix_apply, hmap]
    have hv : IsUnit (∏ j, v j) := by
      apply IsUnit.prod_univ_iff.mpr
      intro j
      exact (IsLocalization.map_units K (drel j)).map (algebraMap K D)
    have hw : IsUnit (∏ i, w i) := by
      apply IsUnit.prod_univ_iff.mpr
      intro i
      exact ((u (Fin.castLE hc i))⁻¹).isUnit.map (algebraMap K D)
    rw [RingHom.map_det, AlgHom.map_det]
    have hmatrix : (aeval z).mapMatrix
        ((MvPolynomial.map (algebraMap R K)).mapMatrix
          (fun i j : Fin c ↦ pderiv (Fin.castLE hc i) (f j))) =
        Matrix.of (fun i j ↦ v j * (w i * B i j)) := by
      ext i j
      exact hentry i j
    rw [hmatrix, Matrix.det_mul_row]
    change IsUnit ((∏ j, v j) * (Matrix.of (fun i j ↦ w i * B i j)).det)
    rw [Matrix.det_mul_column]
    exact hv.mul (hw.mul hB)

end Algebra
