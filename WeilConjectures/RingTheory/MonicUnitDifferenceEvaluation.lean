/-!
# Evaluation splitting for monic polynomials with unit root differences

Source: Stacks Project, Tag 00DT, `lemma-chinese-remainder` in `algebra.tex`, applied to
linear polynomial ideals, and the elementary monic degree argument.
(blueprint: lem-pur-monic-unit-difference-evaluation)
-/

@[expose] public section

universe u

namespace Polynomial

/-- A monic degree `d` polynomial with `d` roots having unit pairwise differences is their
product of linear factors, and evaluation gives the indicated algebra equivalence.
The empty family is allowed: its polynomial product is `1`, and `Fin 0 → R` is the zero ring.

Source: Stacks Project, Tag 00DT, `lemma-chinese-remainder` in `algebra.tex`.
(blueprint: lem-pur-monic-unit-difference-evaluation)

Proof:
1. If `d = 0`, monicity and degree zero give `f = 1`; the quotient by `(1)` and the
   empty product ring both have one element, so the asserted evaluation equivalence exists.
2. Write `L i = X - C (r i)` and `I i = Ideal.span {L i}`. For distinct `i,j`, choose
   the inverse `a` of `r i - r j`. The identity `(-C a) * L i + C a * L j = 1`
   makes the linear factors coprime and the ideals comaximal.
3. By lem-pc-crt-linear-evaluation (`quotientSpanXSubCAlgEquiv`), the evaluation
   quotient by `I i` is `R`. Since `f` evaluates to zero, it belongs to every `I i`.
   By lem-pc-crt-principal-ideal-product (`Ideal.iInf_span_singleton`), their
   intersection is generated by `P = ∏ i, L i`. Thus `f = P * q` for a polynomial `q`.
4. The product `P` is monic of degree `d`. Since the coefficient ring is nonzero,
   `q` is nonzero. If `q` has degree `n` and leading coefficient `b ≠ 0`, the product
   `P * q` has degree `d + n` and leading coefficient `b`, even with zero divisors.
   Comparing degree with `f` gives `n = 0`, and comparing leading coefficients gives
   `q = 1`. Hence `f = P`.
5. By lem-pc-crt-ideal-quotient-product (`Ideal.quotientInfRingEquivPiQuotient`),
   the quotient by the intersection of the `I i` is the product of their quotients.
   Replace the intersection by `(P) = (f)` and compose coordinatewise with the
   single-root evaluation equivalences. This sends `[g]` to `fun i ↦ g.eval (r i)`.
   Constants map to the diagonal constants, so this ring equivalence is an
   `R`-algebra equivalence, as in def-weil-pbc-algebra-hom-quotient. -/
theorem monic_unit_difference_evaluation {R : Type u} [CommRing R] [Nontrivial R]
    {d : ℕ} (f : R[X]) (hf : f.Monic) (hdeg : f.natDegree = d)
    (r : Fin d → R) (hroot : ∀ i : Fin d, f.eval (r i) = 0)
    (hdiff : ∀ i j : Fin d, i ≠ j → IsUnit (r i - r j)) :
    f = ∏ i : Fin d, (X - C (r i)) ∧
      ∃ e : (R[X] ⧸ Ideal.span ({f} : Set R[X])) ≃ₐ[R] (Fin d → R),
        ∀ (g : R[X]) (i : Fin d),
          e (Ideal.Quotient.mkₐ R (Ideal.span ({f} : Set R[X])) g) i = g.eval (r i) := by
  classical
  let L : Fin d → R[X] := fun i => X - C (r i)
  let I : Fin d → Ideal R[X] := fun i => Ideal.span ({L i} : Set R[X])
  have hcop : ∀ i j : Fin d, i ≠ j → IsCoprime (L i) (L j) := by
    intro i j hij
    exact isCoprime_X_sub_C_of_isUnit_sub (hdiff i j hij)
  have hI : Pairwise (fun i j ↦ IsCoprime (I i) (I j)) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).2 (hcop i j hij)
  have hprod : (⨅ i, I i) = Ideal.span ({∏ i, L i} : Set R[X]) := by
    exact Ideal.iInf_span_singleton hcop
  have hmem : ∀ i : Fin d, f ∈ I i := by
    intro i
    change f ∈ Ideal.span ({X - C (r i)} : Set R[X])
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    apply (quotientSpanXSubCAlgEquiv (r i)).injective
    simp [quotientSpanXSubCAlgEquiv_mk, hroot i]
  have hf_inf : f ∈ ⨅ i, I i := by
    rw [Ideal.mem_iInf]
    exact hmem
  have hf_prod : f ∈ Ideal.span ({∏ i, L i} : Set R[X]) := by
    rw [← hprod]
    exact hf_inf
  have hdiv : (∏ i, L i) ∣ f := Ideal.mem_span_singleton.mp hf_prod
  have hPmonic : (∏ i : Fin d, L i).Monic := by
    simpa [L] using
      (monic_prod_of_monic (Finset.univ : Finset (Fin d)) L
        (fun i hi ↦ by exact monic_X_sub_C (r i)))
  have hPdeg : (∏ i : Fin d, L i).natDegree = d := by
    simp [L]
  have hdeg_le : f.natDegree ≤ (∏ i, L i).natDegree := by
    rw [hdeg, hPdeg]
  have hfactor : f = C f.leadingCoeff * (∏ i, L i) :=
    eq_leadingCoeff_mul_of_monic_of_dvd_of_natDegree_le hPmonic hdiv hdeg_le
  have hfactor' : f = ∏ i : Fin d, L i := by
    simpa [hf.leadingCoeff, C_1, one_mul] using hfactor
  have hfspan : Ideal.span ({f} : Set R[X]) = Ideal.span ({∏ i, L i} : Set R[X]) := by
    rw [hfactor']
  let e₁ := Ideal.quotEquivOfEq hfspan
  let e₂ := Ideal.quotEquivOfEq hprod.symm
  let e₃ := Ideal.quotientInfRingEquivPiQuotient I hI
  let e₄ := RingEquiv.piCongrRight fun i ↦ (quotientSpanXSubCAlgEquiv (r i)).toRingEquiv
  let e := (((e₁.trans e₂).trans e₃).trans e₄)
  have he (g : R[X]) (i : Fin d) :
      e (Ideal.Quotient.mk (Ideal.span ({f} : Set R[X])) g) i = g.eval (r i) := by
    change quotientSpanXSubCAlgEquiv (r i)
      (e₃ (e₂ (e₁ (Ideal.Quotient.mk _ g))) i) = _
    rw [Ideal.quotEquivOfEq_mk, Ideal.quotEquivOfEq_mk]
    rfl
  refine ⟨hfactor', { e with commutes' := ?_ }, ?_⟩
  · intro c
    ext i
    exact (he (C c) i).trans eval_C
  · intro g i
    exact he g i

end Polynomial
