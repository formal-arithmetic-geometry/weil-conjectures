module

public import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.Etale.Basic
import WeilConjectures.RingTheory.SmoothProductAlgebra

/-!
# Smoothness over a product ring

Source: literature/stacks-project/algebra.tex, implicit in Lemma Tags 0GIF and 00TD
(blueprint: lem-weil-pbc-smooth-over-product-ring).
-/

@[expose] public section

universe u₁ u₂ v₁ v₂

namespace Algebra

/-- Smooth ring maps on two factors induce a smooth map on product rings.

Source: literature/stacks-project/algebra.tex, Lemma Tags 0GIF and 00TD
(blueprint: lem-weil-pbc-smooth-over-product-ring).

Proof (the three steps of the node):
1. Put `R = R₁ × R₂`. For the first projection use the standard smooth presentation
   `R[x] / ((1,0)x - 1) ≅ R₁`. Identify `R[x]` with `R₁[x] × R₂[x]`; the relation
   becomes `(x - 1, -1)`. Evaluation of the first component at `1` is surjective.
   Its kernel is generated by that relation: if the first component vanishes at `1`,
   division by the monic polynomial `x - 1` writes it as `(x - 1)Q₁`, and the pair
   factors as `(x - 1, -1)(Q₁, -P₂)`. The Jacobian is `(1,0)`, whose image is `1`.
   Thus the projection is standard smooth (def-weil-pbc-standard-smooth-algebra,
   def-weil-pbc-mv-polynomial-ring) and smooth by
   lem-weil-pbc-standard-smooth-is-smooth (00T7). The second projection is analogous.
2. Compose the projections with `φ₁` and `φ₂`, using
   lem-weil-pbc-smooth-ring-map-base-change-composition (00TD). Both factors are
   now smooth over `R` for the structure maps `φ₁ ∘ fst` and `φ₂ ∘ snd`.
3. Apply lem-weil-pbc-smooth-product-algebra (0GIF) to these two `R`-algebras.
   Its product structure map sends `(r₁,r₂)` to `(φ₁ r₁, φ₂ r₂)`, exactly
   `RingHom.prodMap φ₁ φ₂`. By def-weil-pbc-smooth-ring-map this is the conclusion.
-/
theorem smooth_over_product_ring
    (R₁ : Type u₁) (R₂ : Type u₂) (A₁ : Type v₁) (A₂ : Type v₂)
    [CommRing R₁] [CommRing R₂] [CommRing A₁] [CommRing A₂]
    (φ₁ : R₁ →+* A₁) (φ₂ : R₂ →+* A₂)
    (h₁ : @Algebra.Smooth R₁ _ A₁ _ (RingHom.toAlgebra φ₁))
    (h₂ : @Algebra.Smooth R₂ _ A₂ _ (RingHom.toAlgebra φ₂)) :
    @Algebra.Smooth (R₁ × R₂) _ (A₁ × A₂) _ (RingHom.toAlgebra (RingHom.prodMap φ₁ φ₂)) := by
  let : Algebra R₁ A₁ := φ₁.toAlgebra
  let : Algebra R₂ A₂ := φ₂.toAlgebra
  let : Smooth R₁ A₁ := h₁
  let : Smooth R₂ A₂ := h₂
  let : Algebra (R₁ × R₂) R₁ := (RingHom.fst R₁ R₂).toAlgebra
  let : Algebra (R₁ × R₂) R₂ := (RingHom.snd R₁ R₂).toAlgebra
  let : Algebra (R₁ × R₂) A₁ := (φ₁.comp (RingHom.fst R₁ R₂)).toAlgebra
  let : Algebra (R₁ × R₂) A₂ := (φ₂.comp (RingHom.snd R₁ R₂)).toAlgebra
  let : IsScalarTower (R₁ × R₂) R₁ A₁ := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower (R₁ × R₂) R₂ A₂ := IsScalarTower.of_algebraMap_eq' rfl
  let : Smooth (R₁ × R₂) A₁ := Smooth.comp (R₁ × R₂) R₁ A₁
  let : Smooth (R₁ × R₂) A₂ := Smooth.comp (R₁ × R₂) R₂ A₂
  exact Smooth.prod (R₁ × R₂) A₁ A₂

end Algebra
