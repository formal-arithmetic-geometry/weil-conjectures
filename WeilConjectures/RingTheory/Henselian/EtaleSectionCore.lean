module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Idempotents

/-!
# Core splitting for an étale section

Source: Stacks Project, Tag 09XI (blueprint: `lem-weil-pbc-etale-section-idempotent-splitting-core`).
-/

@[expose] public section

universe u v

namespace Algebra.Etale

/-- Core idempotent and product decomposition for an étale algebra with a section.
Source: Stacks Project, Tag 09XI, proof of (5) implies (2), first paragraph.
(blueprint: `lem-weil-pbc-etale-section-idempotent-splitting-core`)

Proof: The section is surjective: r is the image of the structure-map value of r.
Its kernel is finitely generated by finite presentation of both R-algebras. Give R
its S-algebra structure through s. The algebra-homomorphism scalar tower and formal
étale cancellation show that R is formally étale over S. For a surjective formally
étale map, the kernel is an idempotent ideal. The finitely generated idempotent ideal
criterion supplies f with f*f=f and ker(s)=(f). Set e=1-f. Then e is idempotent,
s(f)=0, s(e)=1, and ker(s)=(1-e).

Put C=f.Corner and q(x)=f*x. Since f is a central idempotent, q is a unital ring
homomorphism into C, whose unit is f. Give C its R-algebra structure by q composed
with the structure map R to S. Thus its algebra map is r ↦ f*algebraMap R S r.
The R-algebra map Φ(x)=(s(x),q(x)) is injective: a difference z in its kernel lies
in (f), hence f*z=z, whereas its second coordinate gives f*z=0. It is surjective:
for (r,y) take e*algebraMap R S r+y. Corner membership gives f*y=y, so s(y)=0;
f*e=0 and s(e)=1 give precisely the two required coordinates. Taking the algebra
equivalence of this bijective map proves the claim, with first projection s.
-/
theorem exists_idempotent_core
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.Etale R S] (s : S →ₐ[R] R) :
    ∃ (e : S) (he : IsIdempotentElem e),
      s e = 1 ∧ RingHom.ker s.toRingHom = Ideal.span {1 - e} ∧
      (∃ (_ : Algebra R he.one_sub.Corner),
        (∀ r : R, (algebraMap R he.one_sub.Corner r).1 =
          (1 - e) * algebraMap R S r) ∧
        ∃ Φ : S ≃ₐ[R] R × he.one_sub.Corner, ∀ x : S, (Φ x).1 = s x) := by
  have hs : Function.Surjective s := fun r ↦ ⟨algebraMap R S r, s.commutes r⟩
  have hfg := Algebra.FinitePresentation.ker_fG_of_surjective s hs
  have hid : IsIdempotentElem (RingHom.ker s.toRingHom) := by
    let : Algebra S R := s.toRingHom.toAlgebra
    have : IsScalarTower R S R := IsScalarTower.of_algHom s
    have : Algebra.FormallyEtale S R :=
      Algebra.FormallyEtale.of_restrictScalars (R := R) (A := S) (B := R)
    exact (Algebra.FormallyEtale.iff_of_surjective hs).mp inferInstance
  obtain ⟨f, hf, hker⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hid
  obtain ⟨e, rfl⟩ : ∃ e : S, f = 1 - e := ⟨1 - f, (sub_sub_cancel 1 f).symm⟩
  have he : IsIdempotentElem e := by simpa only [sub_sub_cancel] using hf.one_sub
  have hker' : RingHom.ker s.toRingHom = Ideal.span {(1 - e)} := hker
  have hsf : s (1 - e) = 0 := RingHom.mem_ker.mp (hker' ▸ Ideal.mem_span_singleton_self (1 - e))
  let q : S →+* hf.Corner :=
    { toFun := fun x ↦ ⟨(1 - e) * x, (Subsemigroup.mem_corner_iff hf).mpr
        ⟨by rw [← mul_assoc, hf.eq], by rw [mul_assoc, mul_comm x (1 - e), ← mul_assoc, hf.eq]⟩⟩
      map_one' := by apply Subtype.ext; exact mul_one (1 - e)
      map_mul' := fun x y ↦ by
        apply Subtype.ext
        change (1 - e) * (x * y) = ((1 - e) * x) * ((1 - e) * y)
        calc
          (1 - e) * (x * y) = ((1 - e) * (1 - e)) * (x * y) := by rw [hf.eq]
          _ = ((1 - e) * x) * ((1 - e) * y) := by ring
      map_zero' := by apply Subtype.ext; exact mul_zero (1 - e)
      map_add' := fun x y ↦ by apply Subtype.ext; exact mul_add (1 - e) x y }
  let : Algebra R hf.Corner := (q.comp (algebraMap R S)).toAlgebra
  let qa : S →ₐ[R] hf.Corner := { q with commutes' := fun _ ↦ rfl }
  let φ : S →ₐ[R] R × hf.Corner := s.prod qa
  have hbij : Function.Bijective φ := by
    constructor
    · intro x y hxy
      have hsxy : s (x - y) = 0 := by
        have h : s x = s y := congrArg Prod.fst hxy
        rw [map_sub, h, sub_self]
      have hqxy : (1 - e) * (x - y) = 0 := by
        have h := congrArg (fun z : R × hf.Corner ↦ z.2.1) hxy
        change (1 - e) * x = (1 - e) * y at h
        rw [mul_sub, h, sub_self]
      have hm : x - y ∈ Ideal.span {(1 - e)} := hker' ▸ RingHom.mem_ker.mpr hsxy
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hm
      apply sub_eq_zero.mp
      calc
        x - y = (1 - e) * (x - y) := by rw [hz, ← mul_assoc, hf.eq]
        _ = 0 := hqxy
    · rintro ⟨r, y⟩
      have hfy : (1 - e) * y.1 = y.1 := ((Subsemigroup.mem_corner_iff hf).mp y.2).1
      have hsy : s y.1 = 0 := by
        rw [← hfy, map_mul, hsf, zero_mul]
      refine ⟨e * algebraMap R S r + y.1, ?_⟩
      have hse : s e = 1 := by
        have h : 1 - s e = 0 := by simpa using hsf
        exact (sub_eq_zero.mp h).symm
      apply Prod.ext
      · change s (e * algebraMap R S r + y.1) = r
        simp [hse, hsy]
      · apply Subtype.ext
        change (1 - e) * (e * algebraMap R S r + y.1) = y.1
        rw [mul_add, ← mul_assoc, sub_mul, one_mul, he.eq, sub_self, zero_mul,
          zero_add, hfy]
  refine ⟨e, he, ?_, hker', inferInstance, fun _ ↦ rfl,
    AlgEquiv.ofBijective φ hbij, fun _ ↦ rfl⟩
  have h : 1 - s e = 0 := by simpa using hsf
  exact (sub_eq_zero.mp h).symm

end Algebra.Etale
