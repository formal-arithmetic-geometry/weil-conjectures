/-! # Top cohomology of Koszul coefficient reduction

Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext. -/

@[expose] public section

universe u

open CategoryTheory

namespace ExteriorAlgebra

set_option backward.isDefEq.respectTransparency false in
private theorem top_evaluation_injective (A : Type u) [CommRing A] (r : ℕ)
    (f : Fin r → A) :
    Function.Injective (fun x : (koszulComplex A r f).X r ⟶ ModuleCat.of A A ↦
      x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) := by
  intro x y h
  dsimp only at h
  simp only [koszulComplex] at x y h ⊢
  apply ModuleCat.hom_ext
  apply exteriorPower.linearMap_ext
  let e := Finsupp.basisSingleOne (R := A) (ι := Fin r)
  rw [(x.hom.compAlternatingMap (exteriorPower.ιMulti A r)).eq_smul_basis_det e,
    (y.hom.compAlternatingMap (exteriorPower.ιMulti A r)).eq_smul_basis_det e]
  congr 1

set_option backward.isDefEq.respectTransparency false in
private theorem boundary_top_formula
    (A : Type u) [CommRing A] (n : ℕ) (f : Fin (n + 1) → A) :
    koszulBoundary A (n + 1) f n
        (exteriorPower.ιMulti A (n + 1) (fun i ↦ Finsupp.single i 1)) =
      ∑ i : Fin (n + 1), (((-1 : A) ^ (i.val + 2)) * f i) •
        exteriorPower.ιMulti A n (fun j ↦ Finsupp.single (i.succAbove j) 1) := by
  classical
  let e : Fin (n + 1) → (Fin (n + 1) →₀ A) := fun i ↦ Finsupp.single i 1
  let l := Finsupp.linearCombination A f
  obtain ⟨D, hD1, hrec, huniq, hgen, hzero, hdeg, hform, hleib, hdu⟩ :=
    koszul_differential A (Fin (n + 1) →₀ A) l
  have hc : CliffordAlgebra.contractLeft
      (Q := (0 : QuadraticForm A (Fin (n + 1) →₀ A))) l = D := by
    apply huniq
    · exact CliffordAlgebra.contractLeft_one _ _
    · intro v y
      simpa only [Algebra.smul_def] using
        CliffordAlgebra.contractLeft_ι_mul
          (Q := (0 : QuadraticForm A (Fin (n + 1) →₀ A))) l v y
  apply Subtype.ext
  change CliffordAlgebra.contractLeft _ _ = _
  rw [hc]
  change D (ExteriorAlgebra.ιMulti A (n + 1) e) = _
  rw [hform]
  simp [l, e, Algebra.smul_def, Function.comp_def]

private theorem complement_pairing (A : Type u) [CommRing A] (n : ℕ)
    (i j : Fin (n + 1)) :
    exteriorPower.pairingDual A (Fin (n + 1) →₀ A) n
      (exteriorPower.ιMulti A n
        (fun k ↦ (Finsupp.basisSingleOne :
          Module.Basis (Fin (n + 1)) A (Fin (n + 1) →₀ A)).coord (i.succAbove k)))
      (exteriorPower.ιMulti A n (fun k ↦ Finsupp.single (j.succAbove k) 1)) =
        if i = j then 1 else 0 := by
  classical
  let b : Module.Basis (Fin (n + 1)) A (Fin (n + 1) →₀ A) := Finsupp.basisSingleOne
  by_cases hij : i = j
  · subst j
    simp only [ite_true]
    simpa [b, Function.comp_def, Fin.succAboveOrderEmb] using
      WeilConjectures.ExteriorPower.pairingDual_coord_eq_one b i.succAboveOrderEmb
  · rw [ite_eq_right hij]
    have he : i.succAboveOrderEmb ≠ j.succAboveOrderEmb := by
      intro h
      apply hij
      apply Fin.succAbove_left_injective
      exact congrArg (fun e : Fin n ↪o Fin (n + 1) ↦ (e : Fin n → Fin (n + 1))) h
    simpa [b, Function.comp_def, Fin.succAboveOrderEmb] using
      WeilConjectures.ExteriorPower.pairingDual_coord_eq_zero b i.succAboveOrderEmb
        j.succAboveOrderEmb he

/-- The incoming boundaries are exactly the top functionals whose value on the ordered
standard top wedge vanishes modulo the ideal generated by the sequence.
Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext, local dual Koszul
calculation.

Proof: The top exterior power of A^r has the ordered standard top wedge as its single
basis vector, so evaluation identifies its dual with A. The Koszul boundary of that
wedge is the sum of the complementary ordered wedges with coefficients ± f_i.
Precomposition with this boundary, including the dual differential sign (-1)^r,
therefore has image contained in (f). Conversely the coordinate functional of each
complementary wedge gives ± f_i; the sign is a unit, so every f_i lies in the image.
The image is an A-submodule and hence contains their ideal span, giving equality
with I. Finally the kernel of A -> A/I is I, and top evaluation is injective, so
membership in the incoming image is equivalent to vanishing of the reduced value.
This uses positive rank to have an incoming degree r-1; it does not use regularity.
For I=A both conditions hold for every functional, including over the zero ring. -/
private theorem koszulDual_mem_range_top_iff
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hr : 0 < r) (hf : Ideal.span (Set.range f) = I)
    (x : (koszulDualComplex A r f).X r) :
    x ∈ LinearMap.range ((koszulDualComplex A r f).d (r - 1) r).hom ↔
      Ideal.Quotient.mk I
        (x.hom (exteriorPower.ιMulti A r (fun i ↦ Finsupp.single i 1))) = 0 := by
  classical
  cases r with
  | zero => omega
  | succ n =>
    let e := exteriorPower.ιMulti A (n + 1) (fun i : Fin (n + 1) ↦ Finsupp.single i (1 : A))
    let t : ((koszulComplex A (n + 1) f).X (n + 1) ⟶ ModuleCat.of A A) →ₗ[A] A :=
      { toFun := fun x ↦ x.hom e
        map_add' := by intros; rfl
        map_smul' := by intros; rfl }
    let d := ((koszulDualComplex A (n + 1) f).d n (n + 1)).hom
    have ht : Function.Injective t := top_evaluation_injective A (n + 1) f
    have hval (y : (koszulDualComplex A (n + 1) f).X n) :
        t (d y) = (-1 : A) ^ (n + 1) * y.hom (koszulBoundary A (n + 1) f n e) := by
      simp [t, d, koszulDualComplex, CochainComplex.of_d, koszulDualBoundary,
        Linear.leftComp, koszulComplex, ChainComplex.of_d]
    have hmem (y : (koszulDualComplex A (n + 1) f).X n) : t (d y) ∈ I := by
      rw [hval]
      apply I.mul_mem_left
      dsimp [e]
      rw [boundary_top_formula, map_sum]
      apply Submodule.sum_mem
      intro i hi
      rw [map_smul, smul_eq_mul]
      apply I.mul_mem_right
      apply I.mul_mem_left
      exact hf ▸ Ideal.subset_span (Set.mem_range_self i)
    let b : Module.Basis (Fin (n + 1)) A (Fin (n + 1) →₀ A) := Finsupp.basisSingleOne
    let y (i : Fin (n + 1)) : (koszulDualComplex A (n + 1) f).X n :=
      ModuleCat.ofHom (exteriorPower.pairingDual A (Fin (n + 1) →₀ A) n
        (exteriorPower.ιMulti A n (fun k ↦ b.coord (i.succAbove k))))
    have hy (i : Fin (n + 1)) :
        t (d (y i)) = (-1 : A) ^ (n + 1) * ((-1 : A) ^ (i.val + 2) * f i) := by
      rw [hval]
      dsimp [e]
      rw [boundary_top_formula, map_sum]
      congr 1
      simp only [map_smul, smul_eq_mul, y, ModuleCat.hom_ofHom, b]
      change (∑ j : Fin (n + 1), ((-1 : A) ^ (j.val + 2) * f j) *
        exteriorPower.pairingDual A (Fin (n + 1) →₀ A) n
          (exteriorPower.ιMulti A n (fun k ↦ b.coord (i.succAbove k)))
          (exteriorPower.ιMulti A n (fun k ↦ Finsupp.single (j.succAbove k) 1))) = _
      simp only [b, complement_pairing]
      simp
    have hgen (i : Fin (n + 1)) : f i ∈ LinearMap.range (t.comp d) := by
      let ε := (-1 : A) ^ (n + 1) * (-1 : A) ^ (i.val + 2)
      have hε : ε * ε = 1 := by
        dsimp [ε]
        calc
          _ = ((-1 : A) ^ (n + 1) * (-1 : A) ^ (n + 1)) *
              ((-1 : A) ^ (i.val + 2) * (-1 : A) ^ (i.val + 2)) := by ring
          _ = 1 := by rw [← mul_pow, ← mul_pow]; simp
      refine ⟨ε • y i, ?_⟩
      change t (d (ε • y i)) = f i
      rw [map_smul, map_smul, smul_eq_mul, hy]
      rw [← mul_assoc ((-1 : A) ^ (n + 1)), ← mul_assoc, hε, one_mul]
    have hI : (I : Submodule A A) = LinearMap.range (t.comp d) := by
      apply le_antisymm
      · rw [← hf]
        apply Ideal.span_le.mpr
        rintro a ⟨i, rfl⟩
        exact hgen i
      · rintro a ⟨y, rfl⟩
        exact hmem y
    change x ∈ LinearMap.range d ↔ Ideal.Quotient.mk I (t x) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    constructor
    · rintro ⟨y, rfl⟩
      exact hmem y
    · intro hx
      have hx' : t x ∈ LinearMap.range (t.comp d) := hI ▸ hx
      obtain ⟨y, hy⟩ := hx'
      exact ⟨y, ht hy⟩

private theorem shortComplex_quasiIso_of_surjective {A : Type u} [CommRing A]
    {S T : ShortComplex (ModuleCat.{u} A)} (φ : S ⟶ T)
    (hgS : S.g = 0) (hfT : T.f = 0) (hgT : T.g = 0)
    (hsurj : Function.Surjective φ.τ₂)
    (hker : ∀ x, φ.τ₂ x = 0 → x ∈ LinearMap.range S.f.hom) :
    ShortComplex.QuasiIso φ := by
  rw [ShortComplex.quasiIso_iff_isIso_descOpcycles φ hgS hfT hgT]
  let d := S.descOpcycles φ.τ₂ (by rw [← φ.comm₁₂, hfT]; simp)
  have hp : Function.Surjective S.pOpcycles :=
    (ModuleCat.epi_iff_surjective _).mp inferInstance
  have hd (x : S.X₂) : d (S.pOpcycles x) = φ.τ₂ x := by
    exact ConcreteCategory.congr_hom (S.p_descOpcycles φ.τ₂ _) x
  apply (ConcreteCategory.isIso_iff_bijective d).mpr
  constructor
  · intro x y h
    apply sub_eq_zero.mp
    obtain ⟨z, hz⟩ := hp (x - y)
    have hz0 : φ.τ₂ z = 0 := by
      rw [← hd, hz, map_sub, h, sub_self]
    have hzrange := hker z hz0
    have := (S.moduleCat_pOpcycles_eq_zero_iff z).mpr hzrange
    rwa [hz] at this
  · intro y
    obtain ⟨z, hz⟩ := hsurj y
    exact ⟨S.pOpcycles z, (hd z).trans hz⟩

private theorem koszulDual_outgoing_zero (A : Type u) [CommRing A] (r : ℕ)
    (f : Fin r → A) : (koszulDualComplex A r f).d r (r + 1) = 0 := by
  classical
  let b := (Finsupp.basisSingleOne : Module.Basis (Fin r) A (Fin r →₀ A)).exteriorPower
    (r + 1)
  have : IsEmpty (Set.powersetCard (Fin r) (r + 1)) := ⟨fun s ↦ by
    have hcard : s.val.card ≤ r := by simpa using Finset.card_le_univ s.val
    have hscard : s.val.card = r + 1 := s.property
    omega⟩
  have : Subsingleton (⋀[A]^(r + 1) (Fin r →₀ A)) := b.repr.injective.subsingleton
  have : Subsingleton ((koszulComplex A r f).X (r + 1) ⟶ ModuleCat.of A A) := by
    change Subsingleton
      (ModuleCat.of A (⋀[A]^(r + 1) (Fin r →₀ A)) ⟶ ModuleCat.of A A)
    refine ⟨fun x y ↦ ?_⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro v
    have hv : v = 0 := Subsingleton.elim _ _
    simp [hv]
  have : Subsingleton ((koszulDualComplex A r f).X (r + 1)) := ‹_›
  ext x
  exact Subsingleton.elim _ _

private theorem koszulBoundary_wedge
    (R : Type u) [CommRing R] (r n : ℕ) (f : Fin r → R)
    (v : Fin (n + 1) → (Fin r →₀ R)) :
    koszulBoundary R r f n (exteriorPower.ιMulti R (n + 1) v) =
      Finset.univ.sum (fun i : Fin (n + 1) ↦ (((-1 : R) ^ (i.val + 2)) *
        Finsupp.linearCombination R f (v i)) •
        exteriorPower.ιMulti R n (v ∘ i.succAbove)) := by
  obtain ⟨D, h1, hrec, huniq, hgen, hzero, hdeg, hform, hleib, hderivuniq⟩ :=
    koszul_differential R (Fin r →₀ R) (Finsupp.linearCombination R f)
  have hD : CliffordAlgebra.contractLeft
      (Q := (0 : QuadraticForm R (Fin r →₀ R)))
      (Finsupp.linearCombination R f) = D := by
    apply huniq
    · exact CliffordAlgebra.contractLeft_one _ _
    · intro z y
      simpa only [Algebra.smul_def] using
        CliffordAlgebra.contractLeft_ι_mul (Q := (0 : QuadraticForm R (Fin r →₀ R)))
          (Finsupp.linearCombination R f) z y
  apply Subtype.ext
  simpa only [koszulBoundary, LinearMap.codRestrict_apply, LinearMap.comp_apply,
    Submodule.coe_subtype, exteriorPower.ιMulti_apply_coe, Submodule.coe_sum,
    Submodule.coe_smul, Algebra.smul_def, hD] using hform n v


set_option backward.isDefEq.respectTransparency false in
private theorem quotient_differential_zero
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hf : Ideal.span (Set.range f) = I) (p q : ℕ) :
    (koszulQuotientDualComplex A I r f).d p q = 0 := by
  classical
  by_cases hpq : p + 1 = q
  · subst q
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply ModuleCat.hom_ext
    apply exteriorPower.linearMap_ext
    ext v
    have hxb : x.hom (koszulBoundary A r f p
        (exteriorPower.ιMulti A (p + 1) v)) = 0 := by
      rw [koszulBoundary_wedge, map_sum]
      apply Finset.sum_eq_zero
      intro j hj
      rw [map_smul]
      have hm : Finsupp.linearCombination A f (v j) ∈ I := by
        rw [← hf, ← Ideal.submodule_span_eq, ← Finsupp.range_linearCombination]
        exact LinearMap.mem_range_self _ _
      change Ideal.Quotient.mk I
        (((-1 : A) ^ (j.val + 2)) * Finsupp.linearCombination A f (v j)) * _ = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (I.mul_mem_left _ hm), zero_mul]
    simpa [koszulQuotientDualComplex, koszulQuotientDualBoundary, Linear.leftComp,
      koszulComplex, CochainComplex.of_d, ChainComplex.of_d, hxb] using
      congrArg (fun y : A ⧸ I ↦ ((-1 : A) ^ (p + 1)) • y) hxb
  · apply HomologicalComplex.shape
    simpa using hpq

private theorem reduction_degree_surjective
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A) (n : ℕ) :
    Function.Surjective ((koszulCoefficientReduction A I r f).f n) := by
  let q : ModuleCat.of A A ⟶ ModuleCat.of A (A ⧸ I) := ModuleCat.ofHom I.mkQ
  have : Epi q := (ModuleCat.epi_iff_surjective q).mpr Ideal.Quotient.mk_surjective
  have : Projective ((koszulComplex A r f).X n) := by
    exact ModuleCat.projective_of_free
      ((Finsupp.basisSingleOne : Module.Basis (Fin r) A (Fin r →₀ A)).exteriorPower n)
  intro x
  refine ⟨Projective.factorThru x q, ?_⟩
  change Projective.factorThru x q ≫ q = x
  exact Projective.factorThru_comp x q

/-- Reducing the values of dual Koszul cochains modulo their generated ideal induces
an isomorphism in top cohomology. Regularity is not needed for this calculation.

Source: Stacks Project, Tag 0BQZ, lemma-regular-immersion-ext, top-degree
coefficient calculation. (blueprint: new-j3-koszul-coefficient-top-homology).

Proof: The ordered top wedge is a basis for wedge^r A^r, so evaluation identifies
its A-dual with A and its A/I-dual with A/I. There is no outgoing differential,
since wedge^(r+1) A^r is zero. The incoming dual differential has image I: the
boundary of the ordered top wedge is the sum of complementary wedges with
coefficients ±f_j. Evaluating each complementary coordinate functional shows
that these coefficients generate exactly I. Thus source top cohomology is A/I.
In the quotient-valued dual complex all differentials vanish, since every f_j
acts by zero, so its top cohomology is its top term, also A/I. The reduction map
is the quotient A -> A/I before taking source cohomology, hence becomes the
identity of A/I under these two identifications. For r=0 the generated ideal is
zero and there is no incoming differential, giving the same result. For I=A
both top cohomology modules are zero; no nonzero-ring hypothesis is needed. -/
theorem koszulCoefficientReduction_isIso_top_homology
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hf : Ideal.span (Set.range f) = I) :
    IsIso (HomologicalComplex.homologyMap (koszulCoefficientReduction A I r f) r) := by
  let ψ := (HomologicalComplex.shortComplexFunctor (ModuleCat A) (ComplexShape.up ℕ) r).map
    (koszulCoefficientReduction A I r f)
  change IsIso (ShortComplex.homologyMap ψ)
  apply (ShortComplex.quasiIso_iff ψ).mp
  apply shortComplex_quasiIso_of_surjective ψ
  · change (koszulDualComplex A r f).d r ((ComplexShape.up ℕ).next r) = 0
    rw [(ComplexShape.up ℕ).next_eq' (show r + 1 = r + 1 from rfl)]
    exact koszulDual_outgoing_zero A r f
  · exact quotient_differential_zero A I r f hf _ _
  · exact quotient_differential_zero A I r f hf _ _
  · exact reduction_degree_surjective A I r f r
  · intro x hx
    have hval := congrArg
      (fun y : (koszulQuotientDualComplex A I r f).X r ↦
        y.hom (exteriorPower.ιMulti A r (fun j ↦ Finsupp.single j 1))) hx
    change Ideal.Quotient.mk I
      (x.hom (exteriorPower.ιMulti A r (fun j ↦ Finsupp.single j 1))) = 0 at hval
    by_cases hr : 0 < r
    · have hp : (ComplexShape.up ℕ).prev r = r - 1 :=
        (ComplexShape.up ℕ).prev_eq' (by change r - 1 + 1 = r; omega)
      change x ∈ LinearMap.range
        ((koszulDualComplex A r f).d ((ComplexShape.up ℕ).prev r) r).hom
      rw [hp]
      exact (koszulDual_mem_range_top_iff A I r f hr hf x).mpr hval
    · have hr0 : r = 0 := by omega
      subst r
      have hI : I = ⊥ := by rw [← hf]; simp
      have hquot : Function.Injective (Ideal.Quotient.mk I) :=
        (RingHom.injective_iff_ker_eq_bot _).mpr (by rw [Ideal.mk_ker, hI])
      have hx0 : x = 0 := by
        apply top_evaluation_injective A 0 f
        apply hquot
        simpa using hval
      rw [hx0]
      exact Submodule.zero_mem _

end ExteriorAlgebra
