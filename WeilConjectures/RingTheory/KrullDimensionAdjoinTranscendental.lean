/-!
# Dimension drops when a transcendental element becomes a constant

Let `C` be a finitely generated algebra over a field `K` and `ι : C →ₐ[K] R` a `K`-algebra map
to an algebra `R` over a field `L ⊇ K`, sending some `c ∈ C` to an element `t ∈ L` transcendental
over `K`. Then the `L`-subalgebra of `R` generated by `ι(C)` has dimension at most `dim C - 1`
(`ringKrullDim_adjoin_range_add_one_le`).

Indeed, with `F = K(t) = Frac K[X]` and `E = F ⊗_{K[X]} C` the localization of `C` at the nonzero
polynomials in `c`, the subalgebra is a quotient of `E ⊗_F L`, of dimension `dim E` since `E` is of
finite type over the field `F`; and `dim E + 1 ≤ dim C` since no maximal ideal of `C` survives in
`E`: the residue fields at maximal ideals are finite over `K`
(`ringKrullDim_add_one_le_of_isLocalization`).
-/

@[expose] public section

open Polynomial TensorProduct

/-- If no maximal ideal of `C` is disjoint from the submonoid `M`, then the localization `E` of `C`
at `M` satisfies `dim E + 1 ≤ dim C`. -/
theorem ringKrullDim_add_one_le_of_isLocalization {C E : Type*} [CommRing C] [CommRing E]
    [Algebra C E] (M : Submonoid C) [IsLocalization M E]
    (h : ∀ m : Ideal C, m.IsMaximal → ∃ x ∈ M, x ∈ m) :
    ringKrullDim E + 1 ≤ ringKrullDim C := by
  rw [ringKrullDim, ringKrullDim, ← Order.krullDim_orderDual,
    ← Order.krullDim_orderDual (α := PrimeSpectrum C)]
  let f : (PrimeSpectrum E)ᵒᵈ → (PrimeSpectrum C)ᵒᵈ := fun P ↦
    OrderDual.toDual ⟨(OrderDual.ofDual P).asIdeal.under C, inferInstance⟩
  refine Order.krullDim_add_one_le_of_strictMono f (fun P Q hPQ ↦ ?_) fun P ↦ ?_
  · have hle : (OrderDual.ofDual Q).asIdeal < (OrderDual.ofDual P).asIdeal := hPQ
    change (OrderDual.ofDual Q).asIdeal.under C < (OrderDual.ofDual P).asIdeal.under C
    exact (IsLocalization.orderEmbedding M E).strictMono hle
  · let p := (OrderDual.ofDual P).asIdeal.under C
    have hdisj : Disjoint (M : Set C) p :=
      ((IsLocalization.isPrime_iff_isPrime_disjoint M E _).1 inferInstance).2
    obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p Ideal.IsPrime.ne_top'
    refine ⟨OrderDual.toDual ⟨m, hm.isPrime⟩, lt_of_le_of_ne hpm fun hpm' ↦ ?_⟩
    obtain ⟨x, hxM, hxm⟩ := h m hm
    have hmp : m = p := congrArg (fun Q ↦ (OrderDual.ofDual Q).asIdeal) hpm'
    exact Set.disjoint_left.1 hdisj hxM (hmp ▸ hxm)

/-- In an algebra `C` of finite type over a field `K`, every maximal ideal contains a nonzero
polynomial expression `g(c)` in any given element `c`: the residue field is finite over `K`. -/
theorem exists_aeval_mem_of_isMaximal (K : Type*) {C : Type*} [Field K] [CommRing C] [Algebra K C]
    [Algebra.FiniteType K C] (c : C) (m : Ideal C) [m.IsMaximal] :
    ∃ g : K[X], g ≠ 0 ∧ aeval c g ∈ m := by
  let := Ideal.Quotient.field m
  have : Module.Finite K (C ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (C ⧸ m)
  have hint : IsIntegral K (Ideal.Quotient.mk m c) := Algebra.IsIntegral.isIntegral _
  refine ⟨minpoly K (Ideal.Quotient.mk m c), minpoly.ne_zero hint, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk K,
    ← Polynomial.aeval_algHom_apply,
    Ideal.Quotient.mkₐ_eq_mk, minpoly.aeval]

/-- **The dimension drops when a transcendental element becomes a constant.** Let `C` be of finite
type over a field `K`, let `R` be an algebra over a field `L ⊇ K` and let `ι : C →ₐ[K] R` send
`c ∈ C` to an element `t ∈ L` transcendental over `K`. Then the `L`-subalgebra `L[ι(C)]` of `R`
satisfies `dim L[ι(C)] + 1 ≤ dim C`. -/
theorem ringKrullDim_adjoin_range_add_one_le {K L C R : Type*} [Field K] [Field L] [CommRing C]
    [CommRing R] [Algebra K C] [Algebra.FiniteType K C] [Algebra K L] [Algebra L R] [Algebra K R]
    [IsScalarTower K L R] (ι : C →ₐ[K] R) {c : C} {t : L} (ht : Transcendental K t)
    (hct : ι c = algebraMap L R t) :
    ringKrullDim (Algebra.adjoin L (Set.range ι)) + 1 ≤ ringKrullDim C := by
  classical
  let F := FractionRing K[X]
  let : Algebra K[X] C := (aeval c).toRingHom.toAlgebra
  have : IsScalarTower K K[X] C := .of_algebraMap_eq fun x ↦ by
    change algebraMap K C x = aeval c (Polynomial.C x)
    rw [aeval_C]
  have : Algebra.FiniteType K[X] C := .of_restrictScalars_finiteType K K[X] C
  -- the localization `E = F ⊗_{K[X]} C` of `C`
  let E := F ⊗[K[X]] C
  have hE : ringKrullDim E + 1 ≤ ringKrullDim C := by
    let : Algebra C E := Algebra.TensorProduct.rightAlgebra
    have := IsLocalization.tensorRight (R := K[X]) (S := C) (A := F) (nonZeroDivisors K[X])
    refine ringKrullDim_add_one_le_of_isLocalization
      (Algebra.algebraMapSubmonoid C (nonZeroDivisors K[X])) fun m hm ↦ ?_
    obtain ⟨g, hg, hgm⟩ := exists_aeval_mem_of_isMaximal K c m
    exact ⟨aeval c g, ⟨g, mem_nonZeroDivisors_of_ne_zero hg, rfl⟩, hgm⟩
  -- the field `F = K(t)` maps to `L`
  have hinj : Function.Injective (aeval t : K[X] →ₐ[K] L) := transcendental_iff_injective.1 ht
  let ρ : F →+* L := IsFractionRing.lift hinj
  let : Algebra F L := ρ.toAlgebra
  let : Algebra F R := ((algebraMap L R).comp ρ).toAlgebra
  let : Algebra K[X] R := ((algebraMap F R).comp (algebraMap K[X] F)).toAlgebra
  have : IsScalarTower K[X] F R := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower F L R := .of_algebraMap_eq fun _ ↦ rfl
  have hρ (p : K[X]) : ρ (algebraMap K[X] F p) = aeval t p := IsFractionRing.lift_algebraMap _ _
  let g : C →ₐ[K[X]] R :=
    { ι.toRingHom with
      commutes' p := by
        change ι (aeval c p) = algebraMap L R (ρ (algebraMap K[X] F p))
        rw [hρ, ← Polynomial.aeval_algHom_apply, hct, Polynomial.aeval_algebraMap_apply] }
  let Φ₀ : E →ₐ[F] R := Algebra.TensorProduct.lift (Algebra.ofId F R) g
    fun _ _ ↦ Commute.all _ _
  let j : L →ₐ[F] R := IsScalarTower.toAlgHom F L R
  let Φ : E ⊗[F] L →ₐ[F] R := Algebra.TensorProduct.productMap Φ₀ j
  let D := Algebra.adjoin L (Set.range ι)
  have hΦD (x : E ⊗[F] L) : Φ x ∈ D := by
    induction x using TensorProduct.inductionOn with
    | add x y hx hy => rw [map_add]; exact D.add_mem hx hy
    | tmul e l =>
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      refine D.mul_mem ?_ (D.algebraMap_mem l)
      refine TensorProduct.inductionOn e ?_ ?_
      · intro a b
        rw [Algebra.TensorProduct.lift_tmul]
        refine D.mul_mem ?_ (Algebra.subset_adjoin ⟨b, rfl⟩)
        exact D.algebraMap_mem (ρ a)
      · intro x y hx hy
        rw [map_add]
        exact D.add_mem hx hy
  have hDΦ (y : R) (hy : y ∈ D) : ∃ x, Φ x = y := by
    induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨b, rfl⟩ := hy
      refine ⟨(1 ⊗ₜ b) ⊗ₜ 1, ?_⟩
      rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.lift_tmul, map_one,
        map_one, one_mul, mul_one]
      rfl
    | algebraMap l => exact ⟨1 ⊗ₜ l, by simp [Φ, j]⟩
    | add y z _ _ hy hz =>
      obtain ⟨a, rfl⟩ := hy
      obtain ⟨b, rfl⟩ := hz
      exact ⟨a + b, map_add _ _ _⟩
    | mul y z _ _ hy hz =>
      obtain ⟨a, rfl⟩ := hy
      obtain ⟨b, rfl⟩ := hz
      exact ⟨a * b, map_mul _ _ _⟩
  let ψ : E ⊗[F] L →+* D := Φ.toRingHom.codRestrict D hΦD
  have hψ : Function.Surjective ψ := fun y ↦ by
    obtain ⟨x, hx⟩ := hDΦ y y.2
    exact ⟨x, Subtype.ext hx⟩
  calc ringKrullDim D + 1 ≤ ringKrullDim (E ⊗[F] L) + 1 := by
        gcongr
        exact ringKrullDim_le_of_surjective ψ hψ
    _ = ringKrullDim E + 1 := by rw [ringKrullDim_tensorProduct_of_finiteType]
    _ ≤ ringKrullDim C := hE

/-- The `L`-subalgebra generated by the image of an algebra `C` of finite type over `K` under a
`K`-algebra map `ι : C →ₐ[K] R` into an `L`-algebra `R` is of finite type over `L`. -/
theorem Algebra.finiteType_adjoin_range {K L C R : Type*} [CommRing K] [CommRing L] [CommRing C]
    [CommRing R] [Algebra K C] [Algebra.FiniteType K C] [Algebra K L] [Algebra L R] [Algebra K R]
    [IsScalarTower K L R] (ι : C →ₐ[K] R) :
    Algebra.FiniteType L (Algebra.adjoin L (Set.range ι)) := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := K) (A := C)
  rw [← Subalgebra.fg_iff_finiteType]
  refine ⟨s.image ι, le_antisymm ?_ ?_⟩
  · exact Algebra.adjoin_mono (by simp [Set.image_subset_iff])
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨c, rfl⟩
    have hc : ι c ∈ (Algebra.adjoin K (s : Set C)).map ι := by
      rw [hs]
      exact ⟨c, trivial, rfl⟩
    rw [AlgHom.map_adjoin] at hc
    have hle : Algebra.adjoin K (ι '' s) ≤
        (Algebra.adjoin L ((s.image ι : Finset R) : Set R)).restrictScalars K :=
      Algebra.adjoin_le (by simp [Algebra.subset_adjoin (R := L)])
    exact hle hc
