module

public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.RingTheory.Spectrum.Prime.FreeLocus
public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.Nakayama
public import WeilConjectures.RingTheory.Etale.Coordinates
public import WeilConjectures.RingTheory.LocalGeneratorsClearing

/-!
# Local generators of the kernel of a map of smooth algebras

Let `A` and `B` be smooth `R`-algebras whose Kähler differentials have constant ranks `n` and
`m`, and let `A → B` be surjective with kernel `I`. Then near every prime `p ⊇ I` of `A` the
ideal `I` is generated by `c` elements, where `m + c = n`
(`Algebra.exists_generators_ker_of_smooth`).

The conormal sequence `0 → I/I² → B ⊗[A] Ω[A⁄R] → Ω[B⁄R] → 0` is split exact since `B` is
smooth, so its kernel `K` is a projective `B`-module of constant rank `n - m`, spanned by the
`1 ⊗ d hₖ` for generators `hₖ` of `I`. At `q = pB`, some `n - m` of them form a basis of `K_q`;
by injectivity of `I/I² → B ⊗[A] Ω[A⁄R]` the corresponding `hₖ` generate `I_p` modulo `I_p²`,
hence generate `I_p` by Nakayama's lemma.
-/

@[expose] public section

open KaehlerDifferential TensorProduct

namespace Algebra

variable {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
  [Algebra A B] [IsScalarTower R A B]

/-- **Local generators of the kernel of a map of smooth algebras.** Let `A` be a noetherian
smooth `R`-algebra with Kähler differentials of constant rank `n`, and let `A → B` be surjective
with kernel `I`, where `B` is smooth over `R` with Kähler differentials of constant rank `m`.
Then for every prime `p ⊇ I` there are `c` elements `f₁, …, f_c` of `I`, with `m + c = n`, and
`a ∉ p` such that `a I ⊆ (f₁, …, f_c)`. -/
theorem exists_generators_ker_of_smooth [Smooth R A] [Smooth R B] [IsNoetherianRing A]
    (h : Function.Surjective (algebraMap A B)) {m n : ℕ}
    (hA : ∀ P, Module.rankAtStalk (R := A) Ω[A⁄R] P = n)
    (hB : ∀ Q, Module.rankAtStalk (R := B) Ω[B⁄R] Q = m)
    (p : Ideal A) [p.IsPrime] (hp : RingHom.ker (algebraMap A B) ≤ p) :
    ∃ (c : ℕ) (f : Fin c → A) (a : A), m + c = n ∧ a ∉ p ∧
      (∀ j, f j ∈ RingHom.ker (algebraMap A B)) ∧
      ∀ x ∈ RingHom.ker (algebraMap A B), a * x ∈ Ideal.span (Set.range f) := by
  classical
  set I := RingHom.ker (algebraMap A B)
  set q : Ideal B := p.map (algebraMap A B)
  have hq : q.IsPrime := Ideal.map_isPrime_of_surjective h hp
  have : IsNoetherianRing B := isNoetherianRing_of_surjective A B (algebraMap A B) h
  -- the split conormal sequence `0 → K → B ⊗[A] Ω[A⁄R] → Ω[B⁄R] → 0`
  let φ := mapBaseChange R A B
  let K := LinearMap.ker φ
  obtain ⟨s, hs⟩ := Module.projective_lifting_property φ LinearMap.id
    (mapBaseChange_surjective R A B h)
  have hφs (w : Ω[B⁄R]) : φ (s w) = w := LinearMap.congr_fun hs w
  let ψ : (K × Ω[B⁄R]) →ₗ[B] B ⊗[A] Ω[A⁄R] := K.subtype.coprod s
  have hψ : Function.Bijective ψ := by
    refine ⟨fun x y hxy ↦ ?_, fun y ↦ ⟨(⟨y - s (φ y), ?_⟩, φ y), ?_⟩⟩
    · have h₂ : x.2 = y.2 := by
        simpa [ψ, hφs, LinearMap.mem_ker.mp x.1.2, LinearMap.mem_ker.mp y.1.2] using
          congrArg φ hxy
      refine Prod.ext (Subtype.ext ?_) h₂
      simpa [ψ, h₂] using hxy
    · simp [K, hφs]
    · simp [ψ]
  let e := LinearEquiv.ofBijective ψ hψ
  have hsplit : (LinearMap.fst B K Ω[B⁄R] ∘ₗ e.symm.toLinearMap) ∘ₗ K.subtype =
      LinearMap.id := by
    ext k
    have : e.symm k = (k, 0) := by
      rw [LinearEquiv.symm_apply_eq]
      simp [e, ψ]
    simp [this]
  have : Module.Projective B K := Module.Projective.of_split K.subtype _ hsplit
  have : Module.Finite B K := Module.Finite.of_surjective _
    (LinearMap.surjective_of_comp_eq_id _ _ hsplit)
  have hK : ∀ Q : PrimeSpectrum B, Module.rankAtStalk K Q + m = n := by
    intro Q
    rw [← hB Q, ← Pi.add_apply (f := Module.rankAtStalk K), ← Module.rankAtStalk_prod,
      ← Module.rankAtStalk_eq_of_equiv e.symm, Module.rankAtStalk_baseChange, hA]
  -- `K` is spanned by the `1 ⊗ d g` for generators `g` of `I`
  obtain ⟨G, hG⟩ := (IsNoetherian.noetherian I : I.FG)
  have hdg (x : A) (hx : x ∈ I) : (1 : B) ⊗ₜ[A] D R A x ∈ K := by
    rw [LinearMap.mem_ker, mapBaseChange_tmul, one_smul, map_D, RingHom.mem_ker.mp hx, map_zero]
  have hGI (g : G) : (g : A) ∈ I := hG ▸ Submodule.subset_span g.2
  let v : G → K := fun g ↦ ⟨1 ⊗ₜ D R A g, hdg _ (hGI g)⟩
  have hvspan : Submodule.span B (Set.range v) = ⊤ := by
    let W := Submodule.span B (Set.range fun g : G ↦ (1 : B) ⊗ₜ[A] D R A (g : A))
    have hW : ∀ x ∈ Submodule.span A (G : Set A), (1 : B) ⊗ₜ[A] D R A x ∈ W := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx => exact Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
      | zero => simp
      | add x y _ _ hx hy => rw [map_add, tmul_add]; exact add_mem hx hy
      | smul a x hxI hx =>
        rw [hG] at hxI
        rw [smul_eq_mul, Derivation.leibniz, tmul_add, tmul_smul, tmul_smul,
          ← algebraMap_smul B, ← algebraMap_smul B x, RingHom.mem_ker.mp hxI, zero_smul,
          add_zero]
        exact W.smul_mem _ hx
    refine Submodule.eq_top_iff'.mpr fun k ↦ ?_
    obtain ⟨z, hz⟩ := (exact_kerCotangentToTensor_mapBaseChange R A B h k.1).mp k.2
    obtain ⟨z, rfl⟩ := Ideal.toCotangent_surjective _ z
    rw [kerCotangentToTensor_toCotangent] at hz
    have hk : (k : B ⊗[A] Ω[A⁄R]) ∈ W := hz ▸ hW _ (hG.symm ▸ z.2)
    have hWv : W = (Submodule.span B (Set.range v)).map K.subtype := by
      rw [Submodule.map_span, ← Set.range_comp]
      rfl
    rw [hWv] at hk
    obtain ⟨k', hk', hkk'⟩ := Submodule.mem_map.mp hk
    rwa [← Subtype.ext hkk']
  -- a basis of `K_q` among the `1 ⊗ d g`
  let Bq := Localization.AtPrime q
  let : AddCommGroup K := Submodule.addCommGroup K
  let lK := LocalizedModule.mkLinearMap q.primeCompl K
  have hspanq : Submodule.span Bq (Set.range (lK ∘ v)) = ⊤ := by
    have := span_eq_top_of_isLocalizedModule Bq q.primeCompl lK hvspan
    rwa [← Set.range_comp] at this
  have : Module.Finite Bq (LocalizedModule q.primeCompl K) :=
    Module.Finite.of_isLocalizedModule q.primeCompl lK
  have : Module.FinitePresentation Bq (LocalizedModule q.primeCompl K) :=
    Module.finitePresentation_of_finite _ _
  have : Module.Flat Bq (LocalizedModule q.primeCompl K) := inferInstance
  obtain ⟨κ, a, b, hb⟩ := Module.exists_basis_of_span_of_flat (lK ∘ v) hspanq
  have : Finite κ := Module.Finite.finite_basis b
  let := Fintype.ofFinite κ
  have hκ : m + Fintype.card κ = n := by
    rw [← hK ⟨q, hq⟩, add_comm, ← Module.finrank_eq_card_basis b]
    rfl
  let c := Fintype.card κ
  let eκ : Fin c ≃ κ := (Fintype.equivFin κ).symm
  let f : Fin c → A := fun j ↦ (a (eκ j) : A)
  have hfI (j : Fin c) : f j ∈ I := hGI _
  have hspanf : Submodule.span Bq (lK '' Set.range (v ∘ a ∘ eκ)) = ⊤ := by
    rw [← Set.range_comp, ← b.span_eq]
    congr 1
    ext ω
    simp only [Set.mem_range, Function.comp_apply, hb]
    exact ⟨fun ⟨j, hj⟩ ↦ ⟨eκ j, hj⟩, fun ⟨j, hj⟩ ↦ ⟨eκ.symm j, by simpa using hj⟩⟩
  obtain ⟨t, htq, ht⟩ :=
    IsLocalizedModule.exists_smul_mem_span_of_span_eq_top q.primeCompl Bq lK _ hspanf
  -- hence `t I ⊆ (f) + I²`
  let σ := Function.surjInv h
  have hσ (y : B) : algebraMap A B (σ y) = y := Function.surjInv_eq h y
  have ht'p : σ t ∉ p := fun h' ↦ htq (by rw [← hσ t]; exact Ideal.mem_map_of_mem _ h')
  have hinj : Function.Injective (kerCotangentToTensor R A B) :=
    (FormallySmooth.kerCotangentToTensor_injective_iff h).mpr inferInstance
  have hmain : ∀ x ∈ I, σ t * x ∈ Ideal.span (Set.range f) ⊔ I ^ 2 := by
    intro x hx
    obtain ⟨cB, hcB⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp (ht ⟨_, hdg x hx⟩)
    let z : I := σ t • ⟨x, hx⟩ - ∑ j, σ (cB j) • ⟨f j, hfI j⟩
    have hz : kerToTensor R A B z = 0 := by
      have h₁ := congrArg Subtype.val hcB
      simp only [Submodule.coe_sum, Submodule.coe_smul, Function.comp_apply, v] at h₁
      have e₁ (a : A) (w : B ⊗[A] Ω[A⁄R]) : a • w = algebraMap A B a • w :=
        (algebraMap_smul B a w).symm
      simp only [z, map_sub, map_smul, map_sum, kerToTensor_apply, e₁, hσ]
      rw [← h₁, sub_self]
    have hz₂ : (z : A) ∈ I ^ 2 := (Ideal.toCotangent_eq_zero I z).mp
      (hinj (by rw [map_zero]; exact hz))
    have : σ t * x = z + ∑ j, σ (cB j) * f j := by simp [z]
    rw [this]
    exact add_mem (Ideal.mem_sup_right hz₂) (Ideal.mem_sup_left
      (sum_mem fun j _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)))
  -- Nakayama's lemma at `p`
  let L := Localization.AtPrime p
  have hu : IsUnit (algebraMap A L (σ t)) :=
    IsLocalization.map_units L (⟨σ t, ht'p⟩ : p.primeCompl)
  have hIm : I.map (algebraMap A L) ≤ IsLocalRing.maximalIdeal L := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono hp
  have hle : I.map (algebraMap A L) ≤ (Ideal.span (Set.range f)).map (algebraMap A L) ⊔
      IsLocalRing.maximalIdeal L • I.map (algebraMap A L) := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    have h₁ : algebraMap A L (σ t * x) ∈
        (Ideal.span (Set.range f)).map (algebraMap A L) ⊔ I.map (algebraMap A L) ^ 2 := by
      rw [← Ideal.map_pow, ← Ideal.map_sup]
      exact Ideal.mem_map_of_mem _ (hmain x hx)
    have h₂ : I.map (algebraMap A L) ^ 2 ≤
        IsLocalRing.maximalIdeal L • I.map (algebraMap A L) := by
      rw [pow_two, Ideal.smul_eq_mul]
      exact Ideal.mul_mono_left hIm
    have h₃ : algebraMap A L x = ↑hu.unit⁻¹ * algebraMap A L (σ t * x) := by
      rw [map_mul, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
    rw [Ideal.mem_comap, h₃]
    exact Ideal.mul_mem_left _ _ (sup_le_sup_left h₂ _ h₁)
  have hJ : I.map (algebraMap A L) ≤ (Ideal.span (Set.range f)).map (algebraMap A L) :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (Ideal.FG.map (IsNoetherian.noetherian I) _)
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge hle
  have hgen : I.map (algebraMap A L) = Ideal.span (Set.range (algebraMap A L ∘ f)) := by
    rw [Set.range_comp, ← Ideal.map_span]
    exact le_antisymm hJ (Ideal.map_mono (Ideal.span_le.mpr (by
      rintro _ ⟨j, rfl⟩
      exact hfI j)))
  obtain ⟨F, a₀, ha₀, hF, hFspan⟩ := Ideal.exists_clearing_of_local_generators I p c _ hgen
  exact ⟨c, F, a₀, hκ, ha₀, hF, hFspan⟩

end Algebra
