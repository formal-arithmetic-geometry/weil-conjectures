module

public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Modules with a regular pair generating the maximal ideal are free

Let `(A, 𝔪)` be a Noetherian local ring whose maximal ideal is generated by two elements `x, y`,
and let `M` be a finite `A`-module on which `[x, y]` is a weakly regular sequence. Then `M` is
free (`Module.free_of_isWeaklyRegular_of_maximalIdeal_eq_span_pair`).

Indeed `𝔪 ⊗ M → M` is injective: every element of `𝔪 ⊗ M` has the form `x ⊗ m₁ + y ⊗ m₂`, and
if `x m₁ + y m₂ = 0` then regularity gives `m₂ = x n`, `m₁ = -y n`, so the element is
`-(y x) ⊗ n + (x y) ⊗ n = 0` (this is the exactness of the Koszul complex).

This is step (ii) of the dimension two case of the Zariski–Nagata purity theorem [Stacks 0BMA],
an input of blueprint `sbc-thm-spreading-finite-etale-galois`.
-/

@[expose] public section

open IsLocalRing RingTheory.Sequence TensorProduct
open scoped Pointwise

namespace Module

variable {A M : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [AddCommGroup M]
  [Module A M] [Module.Finite A M]

/-- A finite module over a Noetherian local ring `(A, 𝔪)` with `𝔪 = (x, y)` on which `[x, y]`
is a weakly regular sequence is free. -/
theorem free_of_isWeaklyRegular_of_maximalIdeal_eq_span_pair {x y : A}
    (hm : maximalIdeal A = Ideal.span {x, y}) (hreg : IsWeaklyRegular M [x, y]) :
    Module.Free A M := by
  rw [isWeaklyRegular_cons_iff, isWeaklyRegular_singleton_iff] at hreg
  obtain ⟨hx, hy⟩ := hreg
  have hxm : x ∈ maximalIdeal A := hm ▸ Ideal.subset_span (by simp)
  have hym : y ∈ maximalIdeal A := hm ▸ Ideal.subset_span (by simp)
  set x' : maximalIdeal A := ⟨x, hxm⟩
  set y' : maximalIdeal A := ⟨y, hym⟩
  -- every element of `𝔪 ⊗ M` is of the form `x ⊗ m₁ + y ⊗ m₂`
  have hsurj : ∀ z : maximalIdeal A ⊗[A] M, ∃ m₁ m₂ : M, z = x' ⊗ₜ m₁ + y' ⊗ₜ m₂ := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul a m =>
      obtain ⟨r, s, hrs⟩ := Ideal.mem_span_pair.1
        (show (a : A) ∈ Ideal.span {x, y} from hm ▸ a.2)
      refine ⟨r • m, s • m, ?_⟩
      have : a = r • x' + s • y' := Subtype.ext (by simp [x', y', ← hrs])
      rw [this, add_tmul, smul_tmul, smul_tmul]
    | add z w hz hw =>
      obtain ⟨m₁, m₂, rfl⟩ := hz
      obtain ⟨n₁, n₂, rfl⟩ := hw
      exact ⟨m₁ + n₁, m₂ + n₂, by simp only [tmul_add]; abel⟩
  have := Module.finitePresentation_of_finite A M
  refine free_of_maximalIdeal_rTensor_injective ?_
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro z hz
  obtain ⟨m₁, m₂, rfl⟩ := hsurj z
  replace hz := congr(TensorProduct.lid A M $hz)
  simp only [map_add, LinearMap.rTensor_tmul, Submodule.subtype_apply, TensorProduct.lid_tmul,
    map_zero] at hz
  -- `m₂ = x n`
  have h2 : y • (Submodule.Quotient.mk m₂ : QuotSMulTop x M) = 0 := by
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      eq_neg_of_add_eq_zero_right hz, ← smul_neg]
    exact Submodule.smul_mem_pointwise_smul _ _ ⊤ Submodule.mem_top
  have h2' := hy (show y • (Submodule.Quotient.mk m₂ : QuotSMulTop x M) = y • 0 by
    rw [h2, smul_zero])
  rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_smul_pointwise_iff_exists] at h2'
  obtain ⟨n, -, rfl⟩ := h2'
  -- `m₁ = - y n`
  have h1 : m₁ = -(y • n) := hx (by
    simp only [smul_neg, smul_comm x y n]
    exact eq_neg_of_add_eq_zero_left hz)
  subst h1
  have hxy : y • x' = x • y' := Subtype.ext (by simp [x', y', mul_comm])
  rw [tmul_neg, ← smul_tmul, hxy, smul_tmul, neg_add_cancel]

end Module
