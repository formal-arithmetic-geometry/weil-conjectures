module

public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

/-!
# Transcendence degree of a field generated by the image of a domain

Let `k → L` be fields, `D` a `k`-domain and `f : D →ₐ[k] E` an injective map to an `L`-field `E`
(over `k`) such that `E` is algebraic over the `L`-subalgebra generated by the image of `f`.
Then `trdeg_L E ≤ trdeg_k D` (`Algebra.trdeg_le_of_isAlgebraic_adjoin_range`): the image of a
transcendence basis of `D` over `k` spans `E` in the algebraic matroid over `L`.

This applies to the residue fields of points of fibre products `κ(x) ⊗_{κ(s)} κ(y) → κ(t)`,
and to residue fields of affine schemes of finite type over a field.
-/

@[expose] public section

universe u

open Cardinal

namespace Algebra

/-- **Transcendence degree of a field generated by the image of a domain**: if `f : D →ₐ[k] E` is
injective and `E` is algebraic over the `L`-subalgebra generated by the image of `f`, then
`trdeg_L E ≤ trdeg_k D`. -/
theorem trdeg_le_of_isAlgebraic_adjoin_range {k D L E : Type u} [Field k] [CommRing D]
    [IsDomain D] [Field L] [Field E] [Algebra k D] [Algebra k L] [Algebra L E] [Algebra k E]
    [IsScalarTower k L E] (f : D →ₐ[k] E) (hf : Function.Injective f)
    (halg : Algebra.IsAlgebraic (adjoin L (Set.range f)) E) : trdeg L E ≤ trdeg k D := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis k D
  have hsD := hs.isAlgebraic
  set t : Set E := Set.range (f ∘ ((↑) : s → D))
  have hle : adjoin k t ≤ (adjoin L t).restrictScalars k :=
    adjoin_le fun e he ↦ (Subalgebra.mem_restrictScalars k).2 (subset_adjoin he)
  have hmem (r : adjoin k (Set.range ((↑) : s → D))) : f r ∈ adjoin L t := by
    have hr : f r ∈ (adjoin k (Set.range ((↑) : s → D))).map f := ⟨r, r.2, rfl⟩
    rw [AlgHom.map_adjoin, ← Set.range_comp] at hr
    exact (Subalgebra.mem_restrictScalars k).1 (hle hr)
  let f₀ : adjoin k (Set.range ((↑) : s → D)) →+* adjoin L t :=
    (f.toRingHom.comp (adjoin k (Set.range ((↑) : s → D))).val.toRingHom).codRestrict
      (adjoin L t) hmem
  have hf₀ : Function.Injective f₀ := fun a b hab ↦
    Subtype.ext (hf (congrArg Subtype.val hab))
  have hrange : Set.range f ⊆ (AlgebraicIndependent.matroid L E).closure t := by
    rintro _ ⟨d, rfl⟩
    rw [AlgebraicIndependent.matroid_closure_eq, SetLike.mem_coe,
      Subalgebra.mem_algebraicClosure]
    exact (hsD.isAlgebraic d).ringHom_of_comp_eq f₀ f hf₀ rfl
  have hspan : (AlgebraicIndependent.matroid L E).Spanning t := by
    have h := AlgebraicIndependent.matroid_spanning_iff.2 halg
    rw [Matroid.spanning_iff_ground_subset_closure (by simp)] at h ⊢
    exact h.trans (Matroid.closure_subset_closure_of_subset_closure hrange)
  have := AlgebraicIndependent.matroid_spanning_iff.1 hspan
  calc trdeg L E ≤ #t := Algebra.IsAlgebraic.trdeg_le_cardinalMk L t
    _ ≤ #s := mk_range_le
    _ = trdeg k D := hs.cardinalMk_eq_trdeg

end Algebra
