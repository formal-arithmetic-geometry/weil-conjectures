module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Smooth.Basic

import Mathlib.RingTheory.Etale.Kaehler

/-! # Unramified localization of the corrected-coordinate map

Source: Stacks Project, proof of Lemma 07CH.
(blueprint: lem-weil-pbc-conormal-chart-unramified-localization).
-/

@[expose] public section

set_option autoImplicit false

universe u

namespace Algebra

private theorem conormal_polynomial_chain_rule
    {R S M : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    (n : ℕ) (φ : MvPolynomial (Fin n) R →ₐ[R] S) (d : Derivation R S M)
    (h : MvPolynomial (Fin n) R) :
    d (φ h) = ∑ i, φ (MvPolynomial.pderiv i h) • d (φ (MvPolynomial.X i)) := by
  classical
  induction h using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simp [hp, hq, add_smul, Finset.sum_add_distrib]
  | mul_X p j hp =>
    rw [map_mul, d.leibniz, hp]
    simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, map_mul,
      add_smul, Finset.sum_add_distrib, mul_smul]
    simp only [Pi.single_apply, apply_ite, map_one, map_zero, ite_smul,
      one_smul, zero_smul, smul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    rw [Finset.smul_sum, add_comm]
    congr 1
    apply Finset.sum_congr rfl
    intro i hi
    exact smul_comm _ _ _

set_option backward.isDefEq.respectTransparency false in
/-- A right inverse to the equation Jacobian makes the explicit corrected-coordinate map
unramified after localizing at an element with constant coefficient one.

Source: Stacks Project, proof of Lemma 07CH, the differential calculation and Nakayama
paragraph (smoothing.tex, lines 606--671), https://stacks.math.columbia.edu/tag/07CH.
(blueprint: lem-weil-pbc-conormal-chart-unramified-localization).

Proof. Put C = R[x]/(f), D = C[y], and z_i = x_i - sum_j a_ij y_j. The module of
D-differentials relative to R[z] is generated by the dx_i and dy_j: these elements generate
D as an R-algebra. Modulo (y) times this module, dz_i = 0 gives
 dx_i = sum_j a_ij dy_j. Differentiating f_j = 0 and using the assumed right-inverse
identity then gives dy_j = 0 modulo (y). Thus all the generators belong to (y) times the
module. This module is finite, since D is finite type over R[z] (the original x and y
still generate it). Nakayama's determinant argument gives g - 1 in (y) annihilating the
module. The constant-coefficient map kills every y_j, so constantCoeff g = 1.
Localization of differentials identifies the relative differentials of D_g with the
localization of this annihilated module; since g becomes a unit, that module is zero.
Vanishing of relative differentials is formal unramifiedness. The argument includes
empty sets of variables or equations and zero coefficient rings. -/
theorem exists_unramified_conormal_polynomial_chart
    (R : Type u) [CommRing R] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) R)
    (a : Fin n → Fin c → MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f))
    (ha : ∀ j k, ∑ i, Ideal.Quotient.mk (Ideal.span (Set.range f))
      (MvPolynomial.pderiv i (f j)) * a i k = if j = k then 1 else 0) :
    let C := MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)
    let D := MvPolynomial (Fin c) C
    let θ : MvPolynomial (Fin n) R →ₐ[R] D := MvPolynomial.aeval
      (fun i ↦ MvPolynomial.C (Ideal.Quotient.mk (Ideal.span (Set.range f))
        (MvPolynomial.X i)) - ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X j)
    ∃ g : D, MvPolynomial.constantCoeff g = 1 ∧
      @FormallyUnramified (MvPolynomial (Fin n) R) (Localization.Away g) _ _
        (((IsScalarTower.toAlgHom R D (Localization.Away g)).comp θ).toRingHom.toAlgebra) := by
  classical
  dsimp only
  let P := MvPolynomial (Fin n) R
  let C := P ⧸ Ideal.span (Set.range f)
  let D := MvPolynomial (Fin c) C
  let θ : P →ₐ[R] D := MvPolynomial.aeval
    (fun i ↦ MvPolynomial.C (Ideal.Quotient.mk (Ideal.span (Set.range f))
      (MvPolynomial.X i)) - ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X j)
  let : Algebra P D := θ.toRingHom.toAlgebra
  have : IsScalarTower R P D := IsScalarTower.of_algebraMap_eq (fun r ↦ (θ.commutes r).symm)
  have : FiniteType R C := inferInstance
  have : FiniteType R D := FiniteType.trans (inferInstance : FiniteType R C)
    (inferInstance : FiniteType C D)
  have : FiniteType P D := FiniteType.of_restrictScalars_finiteType R P D
  let I := RingHom.ker (MvPolynomial.constantCoeff : D →+* C)
  have hM : (⊤ : Submodule D (KaehlerDifferential P D)) ≤ I • ⊤ := by
    let M := KaehlerDifferential P D
    let N : Submodule D M := I • ⊤
    let Q := M ⧸ N
    let dP : Derivation P D Q := N.mkQ.compDer (KaehlerDifferential.D P D)
    let d : Derivation R D Q := dP.restrictScalars R
    have hy (j : Fin c) (m : Q) : (MvPolynomial.X j : D) • m = 0 := by
      induction m using Submodule.Quotient.induction_on with
      | _ m =>
        change N.mkQ ((MvPolynomial.X j : D) • m) = 0
        apply (Submodule.Quotient.mk_eq_zero N).mpr
        exact Submodule.smul_mem_smul (by simp [I, RingHom.mem_ker]) (Submodule.mem_top)
    let x (i : Fin n) : D := MvPolynomial.C
      (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.X i))
    have hx (i : Fin n) : d (x i) = ∑ j, (MvPolynomial.C (a i j) : D) • d (MvPolynomial.X j) := by
      have hz := dP.map_algebraMap (MvPolynomial.X i)
      have hθ : algebraMap P D (MvPolynomial.X i) =
          x i - ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X j :=
        MvPolynomial.aeval_X _ _
      rw [hθ] at hz
      change d (x i - ∑ j, MvPolynomial.C (a i j) * MvPolynomial.X j) = 0 at hz
      simpa only [map_sub, map_sum, Derivation.leibniz, hy, add_zero, sub_eq_zero] using hz
    let φ : P →ₐ[R] D :=
      (IsScalarTower.toAlgHom R C D).comp (Ideal.Quotient.mkₐ R (Ideal.span (Set.range f)))
    have hφ (p : P) : φ p = MvPolynomial.C
        (Ideal.Quotient.mk (Ideal.span (Set.range f)) p) := rfl
    have hdy (k : Fin c) : d (MvPolynomial.X k) = 0 := by
      have hfzero : φ (f k) = 0 := by
        rw [hφ, (Ideal.Quotient.eq_zero_iff_mem).mpr
          (Ideal.subset_span (Set.mem_range_self k)), map_zero]
      have heq := conormal_polynomial_chain_rule n φ d (f k)
      rw [hfzero, map_zero] at heq
      change 0 = ∑ i, (MvPolynomial.C
        (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.pderiv i (f k))) : D) •
          d (x i) at heq
      calc
        d (MvPolynomial.X k) =
            ∑ j, (MvPolynomial.C (if k = j then (1 : C) else 0) : D) •
              d (MvPolynomial.X j) := by simp [apply_ite]
        _ = ∑ j, (MvPolynomial.C (∑ i,
            Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.pderiv i (f k)) *
              a i j) : D) • d (MvPolynomial.X j) := by simp_rw [ha]
        _ = ∑ i, (MvPolynomial.C
            (Ideal.Quotient.mk (Ideal.span (Set.range f))
              (MvPolynomial.pderiv i (f k))) : D) • d (x i) := by
          simp_rw [hx, map_sum, map_mul, Finset.sum_smul, Finset.smul_sum, mul_smul]
          rw [Finset.sum_comm]
        _ = 0 := heq.symm
    have hdx (i : Fin n) : d (x i) = 0 := by simp [hx, hdy]
    have hC (r : C) : d (MvPolynomial.C r) = 0 := by
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
      have h := conormal_polynomial_chain_rule n φ d p
      change d (MvPolynomial.C (Ideal.Quotient.mk (Ideal.span (Set.range f)) p)) =
        ∑ i, (MvPolynomial.C
          (Ideal.Quotient.mk (Ideal.span (Set.range f)) (MvPolynomial.pderiv i p)) : D) •
            d (x i) at h
      simpa only [hdx, smul_zero, Finset.sum_const_zero] using h
    have hd (p : D) : d p = 0 := by
      induction p using MvPolynomial.induction_on with
      | C r => exact hC r
      | add p q hp hq => simp [hp, hq]
      | mul_X p j hp => simp [Derivation.leibniz, hp, hdy]
    change (⊤ : Submodule D M) ≤ N
    calc
      ⊤ = Submodule.span D (Set.range (KaehlerDifferential.D P D)) :=
        (KaehlerDifferential.span_range_derivation P D).symm
      _ ≤ N := by
        apply Submodule.span_le.mpr
        rintro _ ⟨p, rfl⟩
        apply (Submodule.Quotient.mk_eq_zero N).mp
        exact hd p
  obtain ⟨g, hg, hkill⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I
      (⊤ : Submodule D (KaehlerDifferential P D)) Module.Finite.fg_top hM
  refine ⟨g, ?_, ?_⟩
  · have h := RingHom.mem_ker.mp hg
    simpa only [map_sub, map_one, sub_eq_zero] using h
  · have halg :
        (((IsScalarTower.toAlgHom R D (Localization.Away g)).comp θ).toRingHom.toAlgebra) =
          (inferInstance : Algebra P (Localization.Away g)) := by
      apply Algebra.algebra_ext
      intro x
      rfl
    change @FormallyUnramified P (Localization.Away g) _ _
      (((IsScalarTower.toAlgHom R D (Localization.Away g)).comp θ).toRingHom.toAlgebra)
    rw [halg]
    have : IsScalarTower P P (Localization.Away g) :=
      @IsScalarTower.of_algebraMap_eq P P (Localization.Away g) _ _ _ _ _ _
        (fun x ↦ by simp)
    apply (formallyUnramified_iff P (Localization.Away g)).mpr
    apply (IsLocalizedModule.subsingleton_iff (Submonoid.powers g)
      (KaehlerDifferential.map P P D (Localization.Away g))).mpr
    intro m
    exact ⟨g, Submonoid.mem_powers g, hkill m (Submodule.mem_top)⟩

end Algebra
