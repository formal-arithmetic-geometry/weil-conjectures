module

public import WeilConjectures.RingTheory.QuasiFiniteAtPrime
public import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.ZariskisMainTheorem

/-!
# A finite subalgebra agreeing near a quasi-finite prime

At a quasi-finite prime `q` of a finite-type algebra `S` over `R`, there are a finite
subalgebra `S'` and `g ∈ S' \ q` with `S'_g ≅ S_g`.

## Implementation details

Zariski's Main Theorem (Tag 00Q9) gives `g` in the integral closure `C` of `R` in `S`, outside
`q`, with `C_g ≅ S_g`. Writing finitely many algebra generators `sᵢ` of `S` as `yᵢ/g^nᵢ` with
`yᵢ ∈ C`, the subalgebra `S'` generated by `g` and the `yᵢ` is finite, and the localized
inclusion `S'_g → S_g` is injective and contains `1/g` and every `sᵢ/1`.

## References

* [Stacks, Tag 00Q9]
* [Stacks, Tag 00QA]
* [Stacks, Tag 00QB] (3)
-/

@[expose] public section

universe u v

namespace Algebra

/-- At a quasi-finite prime of a finite-type algebra, a finite subalgebra has the same
localization away from some element outside the prime. -/
theorem exists_finite_subalgebra_away_of_isQuasiFiniteAtPrime
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.FiniteType R S] (q : PrimeSpectrum S) (hq : IsQuasiFiniteAtPrime R S q) :
    ∃ S' : Subalgebra R S, Module.Finite R S' ∧
      ∃ g : S', g.1 ∉ q.asIdeal ∧
        Function.Bijective (Localization.awayMap S'.val.toRingHom g) := by
  have : QuasiFiniteAt R q.asIdeal := by
    let e := PrimeSpectrum.preimageHomeomorphFiber R S (q.comap (algebraMap R S))
    apply QuasiFiniteAt.of_isOpen_singleton_fiber q
    rwa [← e.isOpen_image, Set.image_singleton]
  have H : ZariskisMainProperty R q.asIdeal :=
    ZariskisMainProperty.of_finiteType q.asIdeal
  obtain ⟨S', hS', g, hg, hbij⟩ :=
    H.exists_fg_and_exists_notMem_and_awayMap_bijective q.asIdeal
  exact ⟨S', Module.Finite.of_fg hS', g, hg, hbij⟩

end Algebra
