module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Extension.Basic
public import Mathlib.Algebra.Exact.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.TensorProduct.Basis
import Mathlib.LinearAlgebra.TensorProduct.Prod
import WeilConjectures.AlgebraicGeometry.CotangentComplexSymmetricAlgebra
import WeilConjectures.RingTheory.ProjectiveSymmetricPresentationConormalEquiv
import WeilConjectures.RingTheory.ProjectiveSymmetricConormalReductionExact

/-!
# Conormal sequence of a projective symmetric-algebra presentation

For a finite polynomial presentation `A = R[x₁,…,xₙ]/I` with projective conormal module
`M = I/I²`, the presentation of `Sym_A(M)` by `R[x, y₁,…,y_m]` has a split exact conormal
sequence, and its conormal module is free (`Algebra.symmetric_projective_presentation_conormal`).

## Implementation details

The equations on `q`, `φ` and `α` in the statement specify the canonical maps without
introducing new definitions, and `φ.toIntAlgHom` only reinterprets the same ring map. Tensor
factors are written `C ⊗[A] M` and `C ⊗[A] K`, via the tensor swap.

Since `M` is projective, `q` splits and `M ⊕ K ≅ A^m`. The map `α` is surjective with kernel
generated by the linear forms associated to `K`; locally on a principal-open cover where `M`
and `K` are free, `α` is a projection `A[u, v] → A[u]` whose kernel is generated by the regular
sequence `v`, which gives the isomorphism `lam` and the injectivity of `i`. Tensoring
`M ⊕ K ≅ A^m` with `C` shows that the right term is projective, so the sequence splits.

## References

* [Stacks, Tag 07CE], proof, with projective `I/I²`
* [Stacks, Tag 07EV], projective case
-/

@[expose] public section

universe u

open scoped TensorProduct

namespace Algebra

/-- Let `P = R[x₁,…,xₙ]`, `A = P/I` with `M = I/I²` projective, `C = Sym_A(M)`, let
`q : A^m → M` send the standard basis to the classes of generators `f_j` of `I`, and let
`K = ker q`. Then the maps `φ : P[y₁,…,y_m] → C` and `α : A[y₁,…,y_m] → C` sending `y_j` to
the class of `f_j` are surjective, `lam` identifies `C ⊗[A] K` with the conormal module of
`α`, and the conormal sequence `0 → C ⊗[A] M → J/J² → C ⊗[A] K → 0` of `φ`, where
`J = ker φ`, with maps `i` and `p`, is split exact. Hence `J/J² ≅ C ⊗[A] (M × K) ≅ C^m`. -/
theorem symmetric_projective_presentation_conormal
    (R : Type u) [CommRing R] (n m : ℕ)
    (I : Ideal (MvPolynomial (Fin n) R)) (f : Fin m → I)
    (hf : Ideal.span (Set.range (fun j ↦ (f j).1)) = I)
    [Module.Projective (MvPolynomial (Fin n) R ⧸ I) I.Cotangent]
    (q : (Fin m → (MvPolynomial (Fin n) R ⧸ I)) →ₗ[(MvPolynomial (Fin n) R ⧸ I)] I.Cotangent)
    (hq : ∀ j : Fin m, q (Pi.single j 1) = I.toCotangent (f j))
    (φ : MvPolynomial (Fin m) (MvPolynomial (Fin n) R) →+* SymmetricAlgebra (MvPolynomial (Fin n)
      R ⧸ I) I.Cotangent)
    (hφC : ∀ x : MvPolynomial (Fin n) R,
      φ (MvPolynomial.C x) = algebraMap (MvPolynomial (Fin n) R ⧸ I) (SymmetricAlgebra
        (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) (Ideal.Quotient.mk I x))
    (hφX : ∀ j : Fin m, φ (MvPolynomial.X j) =
      SymmetricAlgebra.ι (MvPolynomial (Fin n) R ⧸ I) I.Cotangent (q (Pi.single j 1)))
    (α : MvPolynomial (Fin m) (MvPolynomial (Fin n) R ⧸ I) →ₐ[(MvPolynomial (Fin n) R ⧸ I)]
      SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent)
    (hαX : ∀ j : Fin m, α (MvPolynomial.X j) =
      SymmetricAlgebra.ι (MvPolynomial (Fin n) R ⧸ I) I.Cotangent (q (Pi.single j 1))) :
    ∃ (hφ : Function.Surjective φ) (hα : Function.Surjective α),
      ∃ (lam : (SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) ⊗[(MvPolynomial (Fin n)
        R ⧸ I)] LinearMap.ker q ≃ₗ[SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent]
        (Extension.ofSurjective α hα).Cotangent)
        (i : (SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) ⊗[(MvPolynomial (Fin n) R
          ⧸ I)] I.Cotangent →ₗ[SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent]
          (Extension.ofSurjective φ.toIntAlgHom hφ).Cotangent)
        (p : (Extension.ofSurjective φ.toIntAlgHom hφ).Cotangent →ₗ[SymmetricAlgebra (MvPolynomial
          (Fin n) R ⧸ I) I.Cotangent] (SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent)
          ⊗[(MvPolynomial (Fin n) R ⧸ I)] LinearMap.ker q),
        (∀ (c : SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) (k : LinearMap.ker q)
          (y : (Extension.ofSurjective α hα).ker),
          y.1 = ∑ j : Fin m, MvPolynomial.C (k.1 j) * MvPolynomial.X j →
            lam (c ⊗ₜ k) = c • Extension.Cotangent.mk y) ∧
        (∀ (c : SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) (x : I) (y :
          (Extension.ofSurjective φ.toIntAlgHom hφ).ker),
          y.1 = MvPolynomial.C x.1 →
            i (c ⊗ₜ I.toCotangent x) = c • Extension.Cotangent.mk y) ∧
        (∀ (x : (Extension.ofSurjective φ.toIntAlgHom hφ).ker) (y : (Extension.ofSurjective α
          hα).ker),
          y.1 = MvPolynomial.map (Ideal.Quotient.mk I) x.1 →
            lam (p (Extension.Cotangent.mk x)) = Extension.Cotangent.mk y) ∧
        Function.Injective i ∧ Function.Exact i p ∧ Function.Surjective p ∧
        (∃ s : (SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent)
          ⊗[(MvPolynomial (Fin n) R ⧸ I)] LinearMap.ker q
          →ₗ[SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent]
          (Extension.ofSurjective φ.toIntAlgHom hφ).Cotangent,
          p.comp s = LinearMap.id) ∧
        Nonempty ((Extension.ofSurjective φ.toIntAlgHom hφ).Cotangent ≃ₗ[SymmetricAlgebra
          (MvPolynomial (Fin n) R ⧸ I) I.Cotangent]
          (SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) ⊗[(MvPolynomial (Fin n) R ⧸
            I)] (I.Cotangent × LinearMap.ker q)) ∧
        Nonempty ((SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent) ⊗[(MvPolynomial (Fin
          n) R ⧸ I)] (I.Cotangent × LinearMap.ker q)
          ≃ₗ[SymmetricAlgebra (MvPolynomial (Fin n) R ⧸ I) I.Cotangent] (Fin m → SymmetricAlgebra
            (MvPolynomial (Fin n) R ⧸ I) I.Cotangent)) := by
  classical
  let P := MvPolynomial (Fin n) R
  let A := P ⧸ I
  let M := I.Cotangent
  let C := SymmetricAlgebra A M
  have hqsurj : Function.Surjective q := by
    intro z
    obtain ⟨x, rfl⟩ := I.toCotangent_surjective z
    have hx : x.1 ∈ Submodule.span P (Set.range (fun j ↦ (f j).1)) := by
      change x.1 ∈ Ideal.span (Set.range (fun j ↦ (f j).1))
      rw [hf]
      exact x.2
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
    have hax : (∑ j, a j • f j : I) = x := by
      apply Subtype.ext
      simpa using ha
    refine ⟨fun j ↦ Ideal.Quotient.mk I (a j), ?_⟩
    calc
      q (fun j ↦ Ideal.Quotient.mk I (a j)) =
          q (∑ j, Ideal.Quotient.mk I (a j) • Pi.single j 1) := by
        congr 1
        ext j
        simp [Pi.single_apply]
      _ = ∑ j, Ideal.Quotient.mk I (a j) • I.toCotangent (f j) := by
        simp only [map_sum, map_smul, hq]
      _ = I.toCotangent (∑ j, a j • f j) := by
        simp only [map_sum, map_smul]
        apply Finset.sum_congr rfl
        intro j _
        exact algebraMap_smul A (a j) (I.toCotangent (f j))
      _ = I.toCotangent x := congrArg I.toCotangent hax
  have hαeq : α = MvPolynomial.aeval
      (fun j ↦ SymmetricAlgebra.ι A M (q (Pi.single j 1))) := by
    ext j
    rw [MvPolynomial.aeval_X]
    exact hαX j
  have hα : Function.Surjective α := by
    rw [hαeq]
    -- Extract only surjectivity, without introducing the unused dependent conormal data.
    exact (AlgebraicGeometry.cotangentComplex_symmetricAlgebra
      (LinearMap.ker q) q hqsurj rfl).1.choose
  have hφeq : φ = α.toRingHom.comp (MvPolynomial.map (Ideal.Quotient.mk I)) := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, MvPolynomial.map_C]
      change φ (MvPolynomial.C x) = α (algebraMap A _ (Ideal.Quotient.mk I x))
      rw [AlgHom.commutes]
      exact hφC x
    · intro j
      simp only [RingHom.comp_apply, MvPolynomial.map_X]
      exact (hφX j).trans (hαX j).symm
  have hφ : Function.Surjective φ := by
    rw [hφeq]
    exact hα.comp (MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective)
  refine (projective_symmetric_presentation_conormal_equiv A M m q hqsurj α hαX hα).elim
    fun lam hlam ↦ ?_
  obtain ⟨i, r, hi_formula, hr_formula, hi, hir, hr⟩ :=
    projective_symmetric_conormal_reduction_exact P I m q hqsurj α hαX φ hφeq hφ hα
  let p := lam.symm.toLinearMap.comp r
  have hip : Function.Exact i p := lam.symm.postcomp_exact_iff_exact.mpr hir
  have hp : Function.Surjective p := lam.symm.surjective.comp hr
  refine (Module.projective_lifting_property q LinearMap.id hqsurj).elim fun s hs ↦ ?_
  let e₀ := ((LinearMap.exact_subtype_ker_map q).splitSurjectiveEquiv
    (Submodule.injective_subtype _) ⟨s, hs⟩).1
  let e : (M × LinearMap.ker q) ≃ₗ[A] (Fin m → A) :=
    (LinearEquiv.prodComm A M (LinearMap.ker q)).trans e₀.symm
  let inclusion := e.toLinearMap.comp (LinearMap.inr A M (LinearMap.ker q))
  let retraction := (LinearMap.snd A M (LinearMap.ker q)).comp e.symm.toLinearMap
  have hsplit : retraction.comp inclusion = LinearMap.id := by
    ext k
    simp [retraction, inclusion]
  let : Module.Projective A (LinearMap.ker q) :=
    Module.Projective.of_split inclusion retraction hsplit
  refine (Module.projective_lifting_property p LinearMap.id hp).elim fun t ht ↦ ?_
  let eJ := (hip.splitSurjectiveEquiv hi ⟨t, ht⟩).1
  let eprod := TensorProduct.prodRight A C C M (LinearMap.ker q)
  let eFree := (LinearEquiv.baseChange A C _ _ e).trans
    ((Pi.basisFun A (Fin m)).baseChange C).equivFun
  refine ⟨hφ, hα, lam, i, p, hlam, hi_formula, ?_, hi, hip, hp,
    ⟨t, ht⟩, ⟨eJ.trans eprod.symm⟩, ⟨eFree⟩⟩
  intro x y hy
  change lam (lam.symm (r (Extension.Cotangent.mk x))) = _
  rw [lam.apply_symm_apply]
  exact hr_formula x y hy

end Algebra
