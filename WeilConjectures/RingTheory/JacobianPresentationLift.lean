module

public import WeilConjectures.Mathlib.RingTheory.Extension.Presentation.Submersive

/-!
# Lifting a square Jacobian presentation

Source: the Weil conjectures blueprint, sec-smooth-purity, sk-prop-sf-open-closed-triangle,
node def-exc-etale-algebra-lift (blueprint: def-exc-etale-algebra-lift).
-/

@[expose] public section

universe u v

namespace Algebra.SquareJacobianPresentation

variable {A : Type u} [CommRing A] (I : Ideal A)
  {B : Type v} [CommRing B] [Algebra (A ⧸ I) B] {m : ℕ}
  (P : Algebra.SquareJacobianPresentation (A ⧸ I) B (Fin m))

/-- Chosen coefficientwise lifts of the relations. Source: blueprint node
`def-exc-etale-algebra-lift` (blueprint: def-exc-etale-algebra-lift). -/
structure CoefficientLift where
  /-- The lifted relations over the original ring. -/
  relation : Fin m → MvPolynomial (Fin m) A
  /-- Reduction of every lifted coefficient recovers the specified relation. -/
  map_relation : ∀ i, MvPolynomial.map (Ideal.Quotient.mk I) (relation i) = P.relation i

namespace CoefficientLift

variable {I P} (L : CoefficientLift I P)

/-- The determinant of the lifted partial derivatives. Source: blueprint node
`def-exc-etale-algebra-lift` (blueprint: def-exc-etale-algebra-lift). -/
noncomputable def jacobianPolynomial : MvPolynomial (Fin m) A :=
  Matrix.det (fun i j ↦ MvPolynomial.pderiv j (L.relation i))

/-- The ideal generated by the lifted relations and `t * Δ - 1`, with `none` denoting `t`.
Source: blueprint node `def-exc-etale-algebra-lift`
(blueprint: def-exc-etale-algebra-lift). -/
noncomputable def liftIdeal : Ideal (MvPolynomial (Option (Fin m)) A) :=
  Ideal.span (Set.range (fun i ↦ MvPolynomial.rename some (L.relation i)) ∪
    {MvPolynomial.X none * MvPolynomial.rename some L.jacobianPolynomial - 1})

/-- The ring `A[x₁, …, xₘ, t] / (f₁, …, fₘ, t * Δ - 1)`.
Source: blueprint node `def-exc-etale-algebra-lift`
(blueprint: def-exc-etale-algebra-lift). -/
noncomputable abbrev LiftRing : Type u :=
  MvPolynomial (Option (Fin m)) A ⧸ L.liftIdeal

/-- Polynomial reduction sends the old variables to the given generators and `t` to the
inverse of the original Jacobian. Source: blueprint node `def-exc-etale-algebra-lift`
(blueprint: def-exc-etale-algebra-lift). -/
noncomputable def polynomialReduction (_L : CoefficientLift I P) :
    MvPolynomial (Option (Fin m)) A →+* B :=
  MvPolynomial.eval₂Hom ((algebraMap (A ⧸ I) B).comp (Ideal.Quotient.mk I))
    (fun x ↦ match x with
      | none => (↑(P.jacobian_isUnit.unit⁻¹) : B)
      | some i => P.val i)

/-- The defining ideal is killed by polynomial reduction. Source: blueprint node
`def-exc-etale-algebra-lift` (blueprint: def-exc-etale-algebra-lift).

Proof: each lifted relation reduces coefficientwise to `P.relation i`, whose evaluation
at `P.val` is zero by `Algebra.Presentation.aeval_val_relation`. Reduction commutes with
partial derivatives and determinant, so the lifted determinant evaluates to `P.jacobian`
(the transpose convention of `jacobiMatrix` leaves its determinant unchanged). The image
of `t * Δ - 1` is therefore the inverse Jacobian times the Jacobian minus one, hence zero.
The kernel is an ideal containing every generator, so it contains their ideal span. -/
theorem liftIdeal_vanish :
    ∀ q ∈ L.liftIdeal, L.polynomialReduction q = 0 := by
  classical
  intro q hq
  have hle : L.liftIdeal ≤ RingHom.ker L.polynomialReduction := Ideal.span_le.2 ?_
  · exact hle hq
  rintro q (⟨i, rfl⟩ | hq)
  · change MvPolynomial.eval₂Hom
      ((algebraMap (A ⧸ I) B).comp (Ideal.Quotient.mk I))
      (fun x ↦ match x with
      | none => (↑(P.jacobian_isUnit.unit⁻¹) : B)
      | some i => P.val i) (MvPolynomial.rename some (L.relation i)) = 0
    rw [MvPolynomial.eval₂Hom_rename]
    change MvPolynomial.eval₂Hom
      ((algebraMap (A ⧸ I) B).comp (Ideal.Quotient.mk I)) P.val (L.relation i) = 0
    rw [← MvPolynomial.eval₂Hom_map_hom]
    rw [L.map_relation]
    exact P.aeval_val_relation i
  · rw [Set.mem_singleton_iff] at hq
    subst q
    change MvPolynomial.eval₂Hom
      ((algebraMap (A ⧸ I) B).comp (Ideal.Quotient.mk I))
      (fun x ↦ match x with
      | none => (↑(P.jacobian_isUnit.unit⁻¹) : B)
      | some i => P.val i)
      (MvPolynomial.X none * MvPolynomial.rename some L.jacobianPolynomial - 1) = 0
    rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X']
    have hdet :
      MvPolynomial.eval₂Hom
        ((algebraMap (A ⧸ I) B).comp (Ideal.Quotient.mk I))
        (fun x ↦ match x with
        | none => (↑(P.jacobian_isUnit.unit⁻¹) : B)
        | some i => P.val i)
        (MvPolynomial.rename some L.jacobianPolynomial) = P.jacobian := by
      rw [MvPolynomial.eval₂Hom_rename]
      change MvPolynomial.eval₂Hom
        ((algebraMap (A ⧸ I) B).comp (Ideal.Quotient.mk I)) P.val
        L.jacobianPolynomial = P.jacobian
      rw [← MvPolynomial.eval₂Hom_map_hom]
      unfold jacobianPolynomial
      rw [RingHom.map_det]
      have hmatrix :
          (MvPolynomial.map (Ideal.Quotient.mk I)).mapMatrix
            (fun i j ↦ MvPolynomial.pderiv j (L.relation i)) = P.jacobiMatrix.transpose := by
        ext i j : 1
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.transpose_apply,
          P.jacobiMatrix_apply, P.map_eq_id, id_eq]
        rw [← MvPolynomial.pderiv_map, L.map_relation]
      rw [hmatrix, Matrix.det_transpose, P.jacobian_eq_jacobiMatrix_det]
      exact (P.algebraMap_apply _).symm
    calc
      _ = (↑(P.jacobian_isUnit.unit⁻¹) : B) * P.jacobian - 1 := by
        convert congrArg (fun z : B ↦ (↑(P.jacobian_isUnit.unit⁻¹) : B) * z - 1) hdet using 1
        simp only [map_one]
        rfl
      _ = 0 := by
        exact sub_eq_zero.mpr (P.jacobian_isUnit.unit.inv_val)

/-- The canonical map from the lifted quotient to the specified algebra `B`, sending `t`
to the inverse Jacobian. Source: blueprint node `def-exc-etale-algebra-lift`
(blueprint: def-exc-etale-algebra-lift). -/
noncomputable def reduction : L.LiftRing →+* B :=
  Ideal.Quotient.lift L.liftIdeal L.polynomialReduction L.liftIdeal_vanish

end CoefficientLift
end Algebra.SquareJacobianPresentation
