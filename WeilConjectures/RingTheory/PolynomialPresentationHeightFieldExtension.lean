/-!
# Heights in a polynomial presentation after extension of the ground field

Source: Stacks Project, Algebra, proof of Tag 00P4, the commutative square and its
common fibre rings, followed by Tag 00ON.
(blueprint: lem-weil-pbc-polynomial-presentation-height-field-extension).
-/

@[expose] public section

universe u v w

open TensorProduct

namespace AlgebraicGeometry

private theorem flat_square_heights
    {P S P' S' : Type*} [CommRing P] [CommRing S] [CommRing P'] [CommRing S']
    [IsNoetherianRing P] [IsNoetherianRing S]
    [IsNoetherianRing P'] [IsNoetherianRing S']
    (f : P →+* S) (g : P' →+* S') (c : P →+* P') (j : S →+* S')
    (hf : Function.Surjective f) (hg : Function.Surjective g)
    (hc : c.Flat) (hj : j.Flat) (hsq : g.comp c = j.comp f)
    (hker : RingHom.ker g = (RingHom.ker f).map c) (Q : PrimeSpectrum S') :
    let q := Q.asIdeal.comap j
    (q.comap f).height + Q.asIdeal.height =
      (Q.asIdeal.comap g).height + q.height := by
  let q := Q.asIdeal.comap j
  let p := q.comap f
  let Pq := Q.asIdeal.comap g
  let Ip := p.map c
  let Iq := q.map j
  have himage : Ip.map g = Iq := by
    dsimp [Ip, Iq]
    rw [Ideal.map_map, hsq, ← Ideal.map_map, Ideal.map_comap_of_surjective f hf]
  have hk : RingHom.ker g ≤ Ip := by
    rw [hker]
    exact Ideal.map_mono (Ideal.comap_mono bot_le)
  have hpre : Iq.comap g = Ip := by
    rw [← himage, Ideal.comap_map_of_surjective g hg]
    exact sup_eq_left.mpr hk
  let e : P' ⧸ Ip ≃+* S' ⧸ Iq := RingEquiv.ofBijective
    (Ideal.quotientMap Iq g hpre.ge)
    ⟨Ideal.quotientMap_injective' hpre.le, Ideal.quotientMap_surjective hg⟩
  have hecomp : e.toRingHom.comp (Ideal.Quotient.mk Ip) =
      (Ideal.Quotient.mk Iq).comp g := by
    apply RingHom.ext
    intro x
    rfl
  have hmap : (Pq.map (Ideal.Quotient.mk Ip)).map e.toRingHom =
      Q.asIdeal.map (Ideal.Quotient.mk Iq) := by
    rw [Ideal.map_map, hecomp, ← Ideal.map_map]
    congr 1
    exact Ideal.map_comap_of_surjective g hg Q.asIdeal
  have hheight : (Pq.map (Ideal.Quotient.mk Ip)).height =
      (Q.asIdeal.map (Ideal.Quotient.mk Iq)).height := by
    rw [← hmap]
    exact (e.height_map _).symm
  let := c.toAlgebra
  let := j.toAlgebra
  let : Module.Flat P P' := hc
  let : Module.Flat S S' := hj
  have hcon : Pq.comap c = p := by
    dsimp [Pq, p, q]
    rw [Ideal.comap_comap, hsq, ← Ideal.comap_comap]
  let : Pq.LiesOver p := ⟨hcon.symm⟩
  let : Q.asIdeal.LiesOver q := ⟨rfl⟩
  have hP := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown p Pq
  have hQ := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown q Q.asIdeal
  change Pq.height = p.height + (Pq.map (Ideal.Quotient.mk Ip)).height at hP
  change Q.asIdeal.height = q.height + (Q.asIdeal.map (Ideal.Quotient.mk Iq)).height at hQ
  change p.height + Q.asIdeal.height = Pq.height + q.height
  rw [hP, hQ, hheight]
  ac_rfl

/-- A polynomial presentation after scalar extension has the same difference of prime
heights as the original presentation. The equality is written with addition so it makes
sense without choosing natural-number representatives for the heights.

Source: Stacks Project, Algebra, proof of Tag 00P4
(`lemma-dimension-at-a-point-preserved-field-extension`), its commutative square,
"the vertical arrows have the same fibre rings", and the application of Tag 00ON.
(blueprint: lem-weil-pbc-polynomial-presentation-height-field-extension).

Proof: Put P = k[x₁, …, xₙ] and P' = K[x₁, …, xₙ]. Tensor the surjection f with K,
and identify P ⊗[k] K with P' by extension of coefficients. This gives a surjection
 g : P' → S ⊗[k] K. Write c : P → P' for coefficient extension and j : S → S ⊗[k] K
for inclusion. Then g ∘ c = j ∘ f and ker(g) is the ideal generated by c(ker(f)),
by right exactness of scalar extension (equivalently, base change of a presentation).
For a prime Q of S ⊗[k] K put q = j⁻¹(Q), p = f⁻¹(q), and P_Q = g⁻¹(Q).
The commutative square says c⁻¹(P_Q) = p. Surjectivity of f gives f(p) = q, hence
 g(p P') = q (S ⊗[k] K). Since ker(g) ⊆ p P', g induces an isomorphism
 P'/p P' ≃ (S ⊗[k] K)/q(S ⊗[k] K). Under this isomorphism the images of P_Q
and Q correspond. Their heights are therefore equal, say h.
Both vertical maps c and j are flat: they are scalar extensions of the free k-module K.
All four rings are Noetherian: P and P' are polynomial rings in finitely many variables
over fields, and the other two rings are their quotients. Apply Tag 00ON to c and j:
 height(P_Q) = height(p) + h and height(Q) = height(q) + h.
Commutativity and associativity of addition give
 height(p) + height(Q) = height(P_Q) + height(q). No subtraction, finiteness of heights,
or cancellation is required. The argument also covers n = 0; if S is the zero ring,
the surjection g still exists and the assertion about primes is vacuous. -/
theorem polynomial_presentation_height_field_extension
    {k : Type u} {K : Type v} {S : Type w} [Field k] [Field K] [CommRing S]
    [Algebra k K] [Algebra k S] (n : ℕ)
    (f : MvPolynomial (Fin n) k →ₐ[k] S) (hf : Function.Surjective f) :
    ∃ g : MvPolynomial (Fin n) K →+* (S ⊗[k] K), Function.Surjective g ∧
      ∀ Q : PrimeSpectrum (S ⊗[k] K),
        let q := PrimeSpectrum.comap
          (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := S) (B := K)) Q
        (q.asIdeal.comap f.toRingHom).height + Q.asIdeal.height =
          (Q.asIdeal.comap g).height + q.asIdeal.height := by
  let P := MvPolynomial (Fin n) k
  let P' := MvPolynomial (Fin n) K
  let e : P ⊗[k] K ≃+* P' :=
    (Algebra.TensorProduct.comm k P K).toRingEquiv.trans
      (MvPolynomial.algebraTensorAlgEquiv k K).toRingEquiv
  let t := Algebra.TensorProduct.map f (AlgHom.id k K)
  let g := t.toRingHom.comp e.symm.toRingHom
  have ht : Function.Surjective t :=
    Algebra.TensorProduct.map_surjective f (AlgHom.id k K) hf Function.surjective_id
  have hg : Function.Surjective g := ht.comp e.symm.surjective
  refine ⟨g, hg, ?_⟩
  let j := Algebra.TensorProduct.includeLeftRingHom (R := k) (A := S) (B := K)
  let i := Algebra.TensorProduct.includeLeftRingHom (R := k) (A := P) (B := K)
  let c := e.toRingHom.comp i
  have hsq : g.comp c = j.comp f.toRingHom := by
    apply RingHom.ext
    intro x
    change t (e.symm (e (i x))) = j (f x)
    rw [e.symm_apply_apply]
    rfl
  have hker : RingHom.ker g = (RingHom.ker f.toRingHom).map c := by
    change (RingHom.ker t.toRingHom).comap e.symm.toRingHom = _
    have hkT : RingHom.ker t.toRingHom = (RingHom.ker f.toRingHom).map i :=
      Algebra.TensorProduct.rTensor_ker (C := K) f hf
    rw [hkT]
    change ((RingHom.ker f.toRingHom).map i).comap e.symm.toRingHom = _
    rw [show ((RingHom.ker f.toRingHom).map i).comap e.symm.toRingHom =
      ((RingHom.ker f.toRingHom).map i).map e.toRingHom from Ideal.comap_symm e]
    rw [Ideal.map_map]
  have hi : i.Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  have hj : j.Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  have hc : c.Flat := hi.comp (RingHom.Flat.of_bijective e.bijective)
  let : Algebra.FiniteType k S := Algebra.FiniteType.of_surjective f hf
  let : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
  let : IsNoetherianRing (S ⊗[k] K) :=
    isNoetherianRing_of_surjective P' (S ⊗[k] K) g hg
  intro Q
  exact flat_square_heights f.toRingHom g c j hf hg hc hj hsq hker Q

end AlgebraicGeometry
