module

public import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!

# The ideal of a rational point of a tensor product

Let `A`, `B` be `k`-algebras with `k`-points `φ : A →ₐ[k] k` and `ψ : B →ₐ[k] k`. The kernel of
the `k`-point `φ ⊗ ψ : A ⊗_k B →ₐ[k] k` is generated by the kernels of `φ` and `ψ`
(`Algebra.TensorProduct.ker_lift_eq`); in particular, if `ker φ = (ξ)` and `ker ψ = (η)`, it is
`(ξ ⊗ 1, 1 ⊗ η)` (`Algebra.TensorProduct.ker_lift_eq_span_pair`). On the product `C × C` of a
smooth curve with itself these are the regular parameters at a rational point `(c, c)` used in
blueprint `lemma-tangent-cones-on-cover` (ii)–(iii).

-/

@[expose] public section

open scoped TensorProduct

namespace Algebra.TensorProduct

variable {k A B : Type*} [CommRing k] [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]

/-- The kernel of the `k`-point `φ ⊗ ψ` of `A ⊗_k B` is generated by the kernels of `φ` and
`ψ`. -/
theorem ker_lift_eq (φ : A →ₐ[k] k) (ψ : B →ₐ[k] k) :
    RingHom.ker (lift φ ψ (fun _ _ ↦ Commute.all _ _)) =
      (RingHom.ker φ).map (includeLeft : A →ₐ[k] A ⊗[k] B) ⊔
        (RingHom.ker ψ).map (includeRight : B →ₐ[k] A ⊗[k] B) := by
  have hφ : Function.Surjective φ := fun x ↦ ⟨algebraMap k A x, by simp⟩
  have hψ : Function.Surjective ψ := fun x ↦ ⟨algebraMap k B x, by simp⟩
  have h : lift φ ψ (fun _ _ ↦ Commute.all _ _) =
      (Algebra.TensorProduct.lid k k).toAlgHom.comp (map φ ψ) := by
    ext <;> simp
  rw [← map_ker φ ψ hφ hψ]
  ext x
  simp only [RingHom.mem_ker]
  rw [show lift φ ψ (fun _ _ ↦ Commute.all _ _) x =
    Algebra.TensorProduct.lid k k (map φ ψ x) from congrArg (· x) h]
  exact map_eq_zero_iff _ (Algebra.TensorProduct.lid k k).injective

/-- If the `k`-points `φ` and `ψ` have principal kernels `(ξ)` and `(η)`, the kernel of
`φ ⊗ ψ` is `(ξ ⊗ 1, 1 ⊗ η)`. -/
theorem ker_lift_eq_span_pair (φ : A →ₐ[k] k) (ψ : B →ₐ[k] k) {ξ : A} {η : B}
    (hξ : RingHom.ker φ = Ideal.span {ξ}) (hη : RingHom.ker ψ = Ideal.span {η}) :
    RingHom.ker (lift φ ψ (fun _ _ ↦ Commute.all _ _)) = Ideal.span {ξ ⊗ₜ 1, 1 ⊗ₜ η} := by
  rw [ker_lift_eq, hξ, hη, Ideal.map_span, Ideal.map_span, Set.image_singleton,
    Set.image_singleton, Ideal.span_insert]
  rfl

end Algebra.TensorProduct
