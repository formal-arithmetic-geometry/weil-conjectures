module

public import WeilConjectures.RingTheory.TangentConeInitialForms
public import WeilConjectures.RingTheory.QuasiRegular
public import WeilConjectures.RingTheory.RegularLocalGeneratorsRegularSequence
public import Mathlib.RingTheory.Filtration

/-!
# Tangent cones of principal curves in a regular local ring

In a regular local ring `R` the associated graded ring `gr_𝔪 R` is a polynomial ring, in
particular a domain, so the order is additive: if `f` has order `d` and `f a ∈ 𝔪^n`, then
`a ∈ 𝔪^(n-d)`. Hence the initial ideal of `(f)` is generated by the initial form of `f`, and the
condition that the tangent cones of `V(f)` and `V(g)` meet only at the origin
(`IsLocalRing.TangentConesMeetAtOrigin R (f) (g)`) says that the initial forms of `f` and `g`
span all forms of large degree (`IsLocalRing.InitialFormsSpanHighDegree f g`).

## Main results

- `IsLocalRing.HasOrder.mul`: in a regular local ring orders are additive.
- `IsLocalRing.HasOrder.mem_pow_of_mul_mem_pow`: if `f` has order `d` and `f a ∈ 𝔪^n`, `d ≤ n`,
  then `a ∈ 𝔪^(n-d)`.
- `IsLocalRing.InitialFormsSpanHighDegree.of_tangentConesMeetAtOrigin`.
-/

@[expose] public section

universe u

namespace IsLocalRing

section Order

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- A nonzero element of a Noetherian local ring has a finite order (Krull intersection
theorem). -/
theorem exists_hasOrder {f : R} (hf : f ≠ 0) : ∃ d, HasOrder f d := by
  classical
  have hex : ∃ n, f ∉ maximalIdeal R ^ n := by
    by_contra! h
    have : f ∈ ⨅ n : ℕ, maximalIdeal R ^ n := Submodule.mem_iInf _ |>.2 h
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal R).ne_top] at this
    exact hf this
  have h0 : Nat.find hex ≠ 0 := by
    intro h
    have := Nat.find_spec hex
    rw [h, pow_zero, Ideal.one_eq_top] at this
    exact this Submodule.mem_top
  refine ⟨Nat.find hex - 1, ?_, ?_⟩
  · exact not_not.1 (Nat.find_min hex (by omega))
  · rw [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.2 h0)]
    exact Nat.find_spec hex

end Order

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The maximal ideal of a regular local ring is generated by a regular sequence. -/
theorem exists_isRevRegular_span_eq_maximalIdeal :
    ∃ (n : ℕ) (a : Fin n → R), MvPolynomial.IsRevRegular a ∧
      Ideal.span (Set.range a) = maximalIdeal R := by
  classical
  obtain ⟨s, hs, hspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
  have hset : {x | x ∈ s.toList} = (s : Set R) := by ext; simp
  have hd : ringKrullDim R = (s.card : WithBot ℕ∞) := by
    rw [hs, IsRegularLocalRing.spanFinrank_maximalIdeal]
  have hrs : IsRegularSystemOfParameters s.toList :=
    ⟨by rw [hset]; exact hspan, by rw [Finset.length_toList, hd]⟩
  have hreg := (IsRegularLocalRing.isRegular_and_quotients_of_generators R s.card hd _ hrs).1
  obtain ⟨a, ha, haspan⟩ := MvPolynomial.exists_isRevRegular_of_isWeaklyRegular s.toList
    hreg.toIsWeaklyRegular _ rfl
  exact ⟨_, a, ha, haspan.trans hrs.1⟩

/-- In a regular local ring the order is additive: if `f` has order `d` and `g` has order `e`,
then `f g` has order `d + e`, since the associated graded ring is a polynomial ring over the
residue field (quasi-regularity of a regular system of parameters). -/
theorem HasOrder.mul {f g : R} {d e : ℕ} (hf : HasOrder f d) (hg : HasOrder g e) :
    HasOrder (f * g) (d + e) := by
  classical
  refine ⟨by rw [pow_add]; exact Ideal.mul_mem_mul hf.1 hg.1, fun hfg => ?_⟩
  obtain ⟨n, a, ha, hspan⟩ := exists_isRevRegular_span_eq_maximalIdeal (R := R)
  obtain ⟨hf1, hf2⟩ := hf
  obtain ⟨hg1, hg2⟩ := hg
  rw [← hspan] at hf1 hf2 hg1 hg2 hfg
  obtain ⟨F, hF, rfl⟩ := MvPolynomial.exists_isHomogeneous_eval_eq hf1
  obtain ⟨G, hG, rfl⟩ := MvPolynomial.exists_isHomogeneous_eval_eq hg1
  -- a homogeneous polynomial with all coefficients in `𝔪` has value in `𝔪^(deg+1)`
  have key : ∀ {H : MvPolynomial (Fin n) R} {k : ℕ}, H.IsHomogeneous k →
      MvPolynomial.eval a H ∉ Ideal.span (Set.range a) ^ (k + 1) →
        MvPolynomial.map (residue R) H ≠ 0 := by
    intro H k hH hnot h0
    refine hnot ?_
    rw [pow_succ']
    refine hH.eval_mem_mul_pow fun m => ?_
    have := congrArg (fun p : MvPolynomial (Fin n) (ResidueField R) ↦ p.coeff m) h0
    rwa [MvPolynomial.coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
      residue_eq_zero_iff, ← hspan]
      at this
  have hmul := mul_ne_zero (key hF hf2) (key hG hg2)
  rw [← map_mul] at hmul
  refine hmul (MvPolynomial.ext _ _ fun m => ?_)
  rw [MvPolynomial.coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
    residue_eq_zero_iff, ← hspan]
  exact MvPolynomial.coeff_mem_of_eval_mem_pow_succ ha _ (hF.mul hG) (by rwa [map_mul]) m

/-- In a regular local ring, if `f` has order `d`, `d ≤ n` and `f a ∈ 𝔪^n`, then
`a ∈ 𝔪^(n-d)`. -/
theorem HasOrder.mem_pow_of_mul_mem_pow {f a : R} {d n : ℕ} (hf : HasOrder f d)
    (hfa : f * a ∈ maximalIdeal R ^ n) (hdn : d ≤ n) : a ∈ maximalIdeal R ^ (n - d) := by
  by_contra hna
  have ha : a ≠ 0 := by rintro rfl; exact hna (zero_mem _)
  obtain ⟨k, hk⟩ := exists_hasOrder ha
  have hkn : k + 1 ≤ n - d := by
    by_contra! h
    exact hna (Ideal.pow_le_pow_right (by omega) hk.1)
  exact (hf.mul hk).2 (Ideal.pow_le_pow_right (by omega) hfa)

/-- In a regular local ring, if `f` has order `d ≤ n`, then `(f) ∩ 𝔪^n = f 𝔪^(n-d)`. -/
theorem HasOrder.span_singleton_inf_pow_le {f : R} {d n : ℕ} (hf : HasOrder f d) (hdn : d ≤ n) :
    Ideal.span {f} ⊓ maximalIdeal R ^ n ≤ Ideal.span {f} * maximalIdeal R ^ (n - d) := by
  rintro x ⟨hx, hxn⟩
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hx
  rw [mul_comm] at hxn
  rw [mul_comm a f]
  exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self f)
    (hf.mem_pow_of_mul_mem_pow hxn hdn)

/-- In a regular local ring, if the tangent cones of the curves `V(f)` and `V(g)` (`f, g ≠ 0`) meet
only at the origin, then the initial forms of `f` and `g` span all forms of large degree. -/
theorem InitialFormsSpanHighDegree.of_tangentConesMeetAtOrigin {f g : R} (hf : f ≠ 0)
    (hg : g ≠ 0) (h : TangentConesMeetAtOrigin R (Ideal.span {f}) (Ideal.span {g})) :
    InitialFormsSpanHighDegree f g := by
  obtain ⟨d, hd⟩ := exists_hasOrder hf
  obtain ⟨e, he⟩ := exists_hasOrder hg
  obtain ⟨n, hn⟩ := h
  refine ⟨d, e, hd, he, max n (max d e), fun N hN => (hn N (le_of_max_le_left hN)).trans ?_⟩
  have hdN : d ≤ N := (le_max_left d e).trans (le_of_max_le_right hN)
  have heN : e ≤ N := (le_max_right d e).trans (le_of_max_le_right hN)
  gcongr
  · exact hd.span_singleton_inf_pow_le hdN
  · exact he.span_singleton_inf_pow_le heN

end IsLocalRing
