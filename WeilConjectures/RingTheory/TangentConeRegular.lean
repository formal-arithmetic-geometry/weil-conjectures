module

public import WeilConjectures.RingTheory.TangentConeInitialForms
public import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Tangent cones of principal curves in a regular local ring

In a regular local ring `R` the associated graded ring `gr_𝔪 R` is a polynomial ring, in
particular a domain, so the order is additive: if `f` has order `d` and `f a ∈ 𝔪^n`, then
`a ∈ 𝔪^(n-d)`. Hence the initial ideal of `(f)` is generated by the initial form of `f`, and the
condition that the tangent cones of `V(f)` and `V(g)` meet only at the origin
(`IsLocalRing.TangentConesMeetAtOrigin R (f) (g)`) says that the initial forms of `f` and `g`
span all forms of large degree (`IsLocalRing.InitialFormsSpanHighDegree f g`).

## Main results

- `IsLocalRing.InitialFormsSpanHighDegree.of_tangentConesMeetAtOrigin`.
-/

@[expose] public section

universe u

namespace IsLocalRing

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- In a regular local ring, if the tangent cones of the curves `V(f)` and `V(g)` (`f, g ≠ 0`) meet
only at the origin, then the initial forms of `f` and `g` span all forms of large degree. -/
theorem InitialFormsSpanHighDegree.of_tangentConesMeetAtOrigin {f g : R} (hf : f ≠ 0)
    (hg : g ≠ 0) (h : TangentConesMeetAtOrigin R (Ideal.span {f}) (Ideal.span {g})) :
    InitialFormsSpanHighDegree f g :=
  sorry

end IsLocalRing
