module

public import Mathlib.Algebra.Polynomial.Expand
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import WeilConjectures.RingTheory.ExtendedReesAlgebraGraded

/-!
# The power map of extended Rees algebras

For `m : ℕ` the substitution `t ↦ t^m` of Laurent polynomials (`LaurentPolynomial.expand`)
restricts, for ideals `I, J` of `R` with `J ⊆ I^m`, to a map of extended Rees algebras
`R[t, J t⁻¹] ⟶ R[t, I t⁻¹]` (`Ideal.extendedReesAlgebraPowMap`). Geometrically, it is the map
`D_I X ⟶ D_J X` of deformation spaces covering `t ↦ t^m` on the affine line.

## Main statements

- `Ideal.finite_extendedReesAlgebraPowMap`: if moreover `m > 0`, `I` is finitely generated and
  `I^m ⊆ J`, the power map is finite: `R[t, I t⁻¹]` is generated by `t` and the `a t⁻¹` with
  `a` in a finite generating set of `I`, whose `m`-th powers `t^m`, `a^m t^{-m}` come from
  `R[t, J t⁻¹]`.
- `Ideal.ker_extendedReesAlgebraToPolynomial_le_radical`: if `I^m ⊆ J`, the kernel of
  `R[t, I t⁻¹] ⟶ (R / I)[t]` lies in the radical of the ideal generated by the image of the kernel
  of `R[t, J t⁻¹] ⟶ (R / J)[t]`: the power map sends the zero section of `D_I X` onto (the
  underlying set of) the zero section of `D_J X`, and only it.
-/

@[expose] public section

open LaurentPolynomial

namespace LaurentPolynomial

variable (R : Type*) [CommSemiring R]

/-- The substitution `t ↦ t^m` of Laurent polynomials, `T n ↦ T (m * n)`. -/
noncomputable def expand (m : ℕ) : R[T;T⁻¹] →ₐ[R] R[T;T⁻¹] :=
  AddMonoidAlgebra.mapDomainAlgHom R R (AddMonoidHom.mulLeft (m : ℤ))

variable {R}

@[simp]
lemma expand_C (m : ℕ) (r : R) : expand R m (C r) = C r := by
  rw [C_eq_algebraMap, AlgHom.commutes]

@[simp]
lemma expand_T (m : ℕ) (n : ℤ) : expand R m (T n) = T (m * n) := by
  rw [expand, AddMonoidAlgebra.mapDomainAlgHom_apply, T, AddMonoidAlgebra.mapDomain_single]
  rfl

lemma expand_C_mul_T (m : ℕ) (r : R) (n : ℤ) : expand R m (C r * T n) = C r * T (m * n) := by
  rw [map_mul, expand_C, expand_T]

/-- `LaurentPolynomial.expand` extends `Polynomial.expand`. -/
lemma expand_comp_toLaurentAlg (m : ℕ) :
    (expand R m).comp Polynomial.toLaurentAlg =
      Polynomial.toLaurentAlg.comp (Polynomial.expand R m) := by
  refine Polynomial.algHom_ext ?_
  simp [Polynomial.toLaurent_X]

lemma expand_toLaurent (m : ℕ) (p : Polynomial R) :
    expand R m (Polynomial.toLaurent p) = Polynomial.toLaurent (Polynomial.expand R m p) := by
  simpa [Polynomial.toLaurentAlg_apply] using congr($(expand_comp_toLaurentAlg (R := R) m) p)

/-- `LaurentPolynomial.expand` is natural in the coefficient ring. -/
lemma mapRingHom_expand {S : Type*} [CommSemiring S] (φ : R →+* S) (m : ℕ) (x : R[T;T⁻¹]) :
    mapRingHom φ (expand R m x) = expand S m (mapRingHom φ x) := by
  induction x using LaurentPolynomial.induction_on' with
  | add p q hp hq => rw [map_add, map_add, hp, hq, map_add, map_add]
  | C_mul_T n a => simp [expand_C_mul_T]

end LaurentPolynomial

namespace Ideal

variable {R : Type*} [CommRing R] {I J : Ideal R}

lemma expand_mem_extendedReesAlgebra (m : ℕ) (h : J ≤ I ^ m) {x : R[T;T⁻¹]}
    (hx : x ∈ J.extendedReesAlgebra) : expand R m x ∈ I.extendedReesAlgebra := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain rfl | ⟨a, ha, rfl⟩ := hy
    · rw [expand_T, mul_one]
      exact T_natCast_mem_extendedReesAlgebra m
    · rw [expand_C_mul_T]
      exact C_mul_T_mem_extendedReesAlgebra (by simpa using h ha)
  | algebraMap r =>
    rw [AlgHom.commutes]
    exact Subalgebra.algebraMap_mem _ r
  | add x y _ _ hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => rw [map_mul]; exact Subalgebra.mul_mem _ hx hy

/-- The *power map* `R[t, J t⁻¹] ⟶ R[t, I t⁻¹]`, `t ↦ t^m`, for ideals with `J ⊆ I^m`: the
restriction of `LaurentPolynomial.expand`. -/
noncomputable def extendedReesAlgebraPowMap (m : ℕ) (h : J ≤ I ^ m) :
    J.extendedReesAlgebra →+* I.extendedReesAlgebra :=
  ((expand R m).toRingHom.comp J.extendedReesAlgebra.val.toRingHom).codRestrict
    I.extendedReesAlgebra fun x ↦ expand_mem_extendedReesAlgebra m h x.2

@[simp]
lemma coe_extendedReesAlgebraPowMap (m : ℕ) (h : J ≤ I ^ m) (x : J.extendedReesAlgebra) :
    (extendedReesAlgebraPowMap m h x : R[T;T⁻¹]) = expand R m (x : R[T;T⁻¹]) :=
  rfl

@[simp]
lemma extendedReesAlgebraPowMap_algebraMap (m : ℕ) (h : J ≤ I ^ m) (r : R) :
    extendedReesAlgebraPowMap m h (algebraMap R J.extendedReesAlgebra r) =
      algebraMap R I.extendedReesAlgebra r :=
  Subtype.ext (by simp [← LaurentPolynomial.C_eq_algebraMap])

lemma extendedReesAlgebraPowMap_comp_algebraMap (m : ℕ) (h : J ≤ I ^ m) :
    (extendedReesAlgebraPowMap m h).comp (algebraMap R J.extendedReesAlgebra) =
      algebraMap R I.extendedReesAlgebra :=
  RingHom.ext (extendedReesAlgebraPowMap_algebraMap m h)

@[simp]
lemma extendedReesAlgebraPowMap_T (m : ℕ) (h : J ≤ I ^ m) :
    extendedReesAlgebraPowMap m h J.extendedReesAlgebraT = I.extendedReesAlgebraT ^ m :=
  Subtype.ext (by simp [T_pow])

lemma extendedReesAlgebraPowMap_comp_toExtendedReesAlgebra (m : ℕ) (h : J ≤ I ^ m) :
    (extendedReesAlgebraPowMap m h).comp J.toExtendedReesAlgebra =
      I.toExtendedReesAlgebra.comp (Polynomial.expand R m).toRingHom :=
  RingHom.ext fun p ↦ Subtype.ext (by simp [expand_toLaurent])

/-- The power map is natural in the ring. -/
lemma extendedReesAlgebraMap_comp_extendedReesAlgebraPowMap {S : Type*} [CommRing S]
    (φ : R →+* S) {I' J' : Ideal S} (hI : I.map φ ≤ I') (hJ : J.map φ ≤ J') (m : ℕ)
    (h : J ≤ I ^ m) (h' : J' ≤ I' ^ m) :
    (I.extendedReesAlgebraMap φ I' hI).comp (extendedReesAlgebraPowMap m h) =
      (extendedReesAlgebraPowMap m h').comp (J.extendedReesAlgebraMap φ J' hJ) :=
  RingHom.ext fun x ↦ Subtype.ext (by simp [mapRingHom_expand])

/-- If `m > 0`, `I` is finitely generated and `I^m ⊆ J ⊆ I^m`, then the power map
`R[t, J t⁻¹] ⟶ R[t, I t⁻¹]` is finite: `R[t, I t⁻¹]` is of finite type over `R`, and generated by
`t` and the `a t⁻¹` for `a` in a generating set of `I`, whose `m`-th powers `t^m` and `a^m t^{-m}`
lie in the image of the power map. -/
theorem finite_extendedReesAlgebraPowMap {m : ℕ} (hm : 0 < m) (h : J ≤ I ^ m) (h' : I ^ m ≤ J)
    (hI : I.FG) : (extendedReesAlgebraPowMap m h).Finite := by
  refine RingHom.finite_iff_isIntegral_and_finiteType.mpr ⟨?_, ?_⟩
  · let := (extendedReesAlgebraPowMap m h).toAlgebra
    obtain ⟨s, hs⟩ := hI
    have hle := (extendedReesAlgebra_eq_adjoin hs).ge
    have key (x : R[T;T⁻¹])
        (hx : x ∈ Algebra.adjoin R (insert (T 1) ((fun a ↦ C a * T (-1)) '' (s : Set R))))
        (hx' : x ∈ I.extendedReesAlgebra) :
        IsIntegral J.extendedReesAlgebra (⟨x, hx'⟩ : I.extendedReesAlgebra) := by
      induction hx using Algebra.adjoin_induction with
      | mem y hy =>
        refine IsIntegral.of_pow hm ?_
        obtain rfl | ⟨a, ha, rfl⟩ := hy
        · convert isIntegral_algebraMap (R := J.extendedReesAlgebra)
            (x := J.extendedReesAlgebraT)
          exact Subtype.ext (by simp [RingHom.algebraMap_toAlgebra, T_pow])
        · have ha' : a ^ m ∈ J := h' (pow_mem_pow (hs ▸ subset_span ha) m)
          convert isIntegral_algebraMap (R := J.extendedReesAlgebra)
            (x := (⟨_, C_mul_T_neg_one_mem_extendedReesAlgebra ha'⟩ : J.extendedReesAlgebra))
          exact Subtype.ext (by simp [RingHom.algebraMap_toAlgebra, mul_pow, T_pow])
      | algebraMap r =>
        convert isIntegral_algebraMap (R := J.extendedReesAlgebra)
          (x := algebraMap R J.extendedReesAlgebra r)
        exact congrArg Subtype.val (extendedReesAlgebraPowMap_algebraMap m h r).symm
      | add x y hx hy ihx ihy => exact (ihx (hle hx)).add (ihy (hle hy))
      | mul x y hx hy ihx ihy => exact (ihx (hle hx)).mul (ihy (hle hy))
    rintro ⟨x, hx⟩
    exact key x (extendedReesAlgebra_eq_adjoin hs ▸ hx) hx
  · refine RingHom.FiniteType.of_comp_finiteType (f := algebraMap R J.extendedReesAlgebra) ?_
    rw [extendedReesAlgebraPowMap_comp_algebraMap]
    exact RingHom.finiteType_algebraMap.mpr (finiteType_extendedReesAlgebra hI)

lemma _root_.LaurentPolynomial.coeff_C_mul_T (a : R) (j i : ℤ) :
    (C a * T j : R[T;T⁻¹]).coeff i = if i = j then a else 0 := by
  rw [← single_eq_C_mul_T, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  simp only [eq_comm]

/-- The map `R[t, I t⁻¹] ⟶ (R / I)[t]` cutting out the zero section of the deformation space is
surjective. -/
lemma surjective_extendedReesAlgebraToPolynomial {S : Type*} [CommRing S] (φ : R →+* S)
    (hφ : Function.Surjective φ) (h : I ≤ RingHom.ker φ) :
    Function.Surjective (I.extendedReesAlgebraToPolynomial φ h) := by
  intro p
  obtain ⟨q, rfl⟩ := Polynomial.map_surjective φ hφ p
  exact ⟨I.toExtendedReesAlgebra q,
    congr($(extendedReesAlgebraToPolynomial_comp_toExtendedReesAlgebra φ h) q)⟩

/-- `∑ xⱼ tʲ ∈ R[t, I t⁻¹]` lies in the kernel of `R[t, I t⁻¹] ⟶ (R / I)[t]` if and only if
`xⱼ ∈ I^{max(-j, 1)}` for all `j`. -/
lemma mem_ker_extendedReesAlgebraToPolynomial_iff {x : I.extendedReesAlgebra} :
    x ∈ RingHom.ker (I.extendedReesAlgebraToPolynomial (Ideal.Quotient.mk I) Ideal.mk_ker.ge) ↔
      ∀ j, (x : R[T;T⁻¹]).coeff j ∈ I ^ max (-j).toNat 1 := by
  rw [RingHom.mem_ker, ← Polynomial.toLaurent_inj, toLaurent_extendedReesAlgebraToPolynomial,
    map_zero]
  constructor
  · intro h0 j
    have hj := congr(($h0).coeff j)
    rw [AddMonoidAlgebra.coeff_mapRingHom] at hj
    have hI : (x : R[T;T⁻¹]).coeff j ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp (by simpa using hj)
    rcases le_or_gt (-j).toNat 1 with hj' | hj'
    · rwa [max_eq_right hj', pow_one]
    · rw [max_eq_left hj'.le]
      exact coeff_mem_pow_of_mem_extendedReesAlgebra x.2 j
  · intro h
    refine LaurentPolynomial.ext fun j ↦ ?_
    rw [AddMonoidAlgebra.coeff_mapRingHom]
    simpa using Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_self (by omega) (h j))

/-- **The power map and the zero sections.** If `J ⊆ I^m ⊆ J`, the kernel of
`R[t, I t⁻¹] ⟶ (R / I)[t]` lies in the radical of the ideal generated by the image of the kernel of
`R[t, J t⁻¹] ⟶ (R / J)[t]` under the power map: a monomial `c tʲ` with `c ∈ I^{max(-j, 1)}` has
`m`-th power the image of `c^m tʲ`, and `c^m ∈ (I^m)^{max(-j, 1)} ⊆ J^{max(-j, 1)}`. -/
theorem ker_extendedReesAlgebraToPolynomial_le_radical (m : ℕ) (h : J ≤ I ^ m)
    (h' : I ^ m ≤ J) :
    RingHom.ker (I.extendedReesAlgebraToPolynomial (Ideal.Quotient.mk I) Ideal.mk_ker.ge) ≤
      ((RingHom.ker (J.extendedReesAlgebraToPolynomial (Ideal.Quotient.mk J)
        Ideal.mk_ker.ge)).map (extendedReesAlgebraPowMap m h)).radical := by
  classical
  intro x hx
  rw [mem_ker_extendedReesAlgebraToPolynomial_iff] at hx
  have hmono (j : ℤ) (c : R) (hc : c ∈ I ^ max (-j).toNat 1) :
      (⟨C c * T j, C_mul_T_mem_extendedReesAlgebra
        (Ideal.pow_le_pow_right (le_max_left _ _) hc)⟩ : I.extendedReesAlgebra) ∈
        ((RingHom.ker (J.extendedReesAlgebraToPolynomial (Ideal.Quotient.mk J)
          Ideal.mk_ker.ge)).map (extendedReesAlgebraPowMap m h)).radical := by
    have hc' : c ^ m ∈ J ^ max (-j).toNat 1 := by
      have hcm : c ^ m ∈ (I ^ max (-j).toNat 1) ^ m := Ideal.pow_mem_pow hc m
      rw [← pow_mul, mul_comm, pow_mul] at hcm
      exact Ideal.pow_right_mono h' _ hcm
    have hmem : C (c ^ m) * T j ∈ J.extendedReesAlgebra :=
      C_mul_T_mem_extendedReesAlgebra (Ideal.pow_le_pow_right (le_max_left _ _) hc')
    refine ⟨m, ?_⟩
    convert Ideal.mem_map_of_mem (extendedReesAlgebraPowMap m h) (x := ⟨_, hmem⟩) ?_
    · exact Subtype.ext (by simp [mul_pow, T_pow])
    · rw [mem_ker_extendedReesAlgebraToPolynomial_iff]
      intro i
      rw [coeff_C_mul_T]
      split_ifs with hij
      · subst hij
        exact hc'
      · exact zero_mem _
  have hx' : x = ∑ j ∈ (x : R[T;T⁻¹]).coeff.support,
      (⟨C ((x : R[T;T⁻¹]).coeff j) * T j, C_mul_T_mem_extendedReesAlgebra
        (Ideal.pow_le_pow_right (le_max_left _ _) (hx j))⟩ : I.extendedReesAlgebra) := by
    refine Subtype.ext ?_
    rw [AddSubmonoidClass.coe_finsetSum]
    exact LaurentPolynomial.eq_sum_C_mul_T _
  rw [hx']
  exact Ideal.sum_mem _ fun j _ ↦ hmono j _ (hx j)

/-- If `J ⊆ I^m ⊆ J` and `P` is a prime of `R[t, I t⁻¹]` whose preimage under the power map
contains the kernel of `R[t, J t⁻¹] ⟶ (R / J)[t]`, then `P` contains the kernel of
`R[t, I t⁻¹] ⟶ (R / I)[t]`. -/
theorem ker_extendedReesAlgebraToPolynomial_le_of_le_comap (m : ℕ) (h : J ≤ I ^ m)
    (h' : I ^ m ≤ J) (P : Ideal I.extendedReesAlgebra) [P.IsPrime]
    (hP : RingHom.ker (J.extendedReesAlgebraToPolynomial (Ideal.Quotient.mk J) Ideal.mk_ker.ge) ≤
      P.comap (extendedReesAlgebraPowMap m h)) :
    RingHom.ker (I.extendedReesAlgebraToPolynomial (Ideal.Quotient.mk I) Ideal.mk_ker.ge) ≤ P :=
  (ker_extendedReesAlgebraToPolynomial_le_radical m h h').trans
    ((Ideal.radical_mono (Ideal.map_le_iff_le_comap.mpr hP)).trans_eq ‹P.IsPrime›.radical)

/-- For the zero ideal, `R[t, ⊥ t⁻¹] = R[t] ⟶ (R / ⊥)[t]` is injective. -/
lemma injective_extendedReesAlgebraToPolynomial_bot :
    Function.Injective ((⊥ : Ideal R).extendedReesAlgebraToPolynomial (Ideal.Quotient.mk ⊥)
      Ideal.mk_ker.ge) := by
  refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ Subtype.ext (LaurentPolynomial.ext fun j ↦ ?_)
  have hj := mem_ker_extendedReesAlgebraToPolynomial_iff.mp hx j
  rw [Submodule.bot_pow (by omega)] at hj
  simpa using hj

end Ideal
