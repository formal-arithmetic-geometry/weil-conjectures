module

public import WeilConjectures.RingTheory.HenselianDVRExtension
public import WeilConjectures.TraceFormula.Specialization.TraitSliceGaloisTensor

/-!
# Separable closedness of the base in an unramified extension of discrete valuation rings

Let `R₁` be a henselian discrete valuation ring with separably closed residue field `k` and
fraction field `F₁`, and let `R₁ → R` be a local homomorphism to a discrete valuation ring `R`
with fraction field `F`, such that a uniformizer `π` of `R₁` is a uniformizer of `R`, and such
that every element of the residue field `κ` of `R` algebraic over `k` comes from `k`. A typical
example is the strict henselization of `R₁[x]` at the prime `(π)`.

Then `F₁` is separably closed in `F` (`IsDiscreteValuationRing.mem_range_of_isSeparable`). Indeed,
let `c ∈ F` be separable over `F₁`, `E = F₁(c)` and `B` the integral closure of `R₁` in `E`, a
discrete valuation ring with `π = u ϖ ^ e` and `e f = [E : F₁]`, `f` the residue degree. The ring
`B` lies in `R` (which is integrally closed), the inclusion is local, and since `π` stays a
uniformizer in `R` we get `e = 1`; the residue field of `B` embeds in `κ` and is algebraic over
`k`, so `f = 1`. Hence `[E : F₁] = 1`.

As a consequence, for every algebraic extension `Ω₁` of `F₁` the ring `Ω₁ ⊗_{R₁} R = Ω₁ ⊗_{F₁} F`
has a single prime ideal (`IsDiscreteValuationRing.subsingleton_primeSpectrum_tensorProduct`).

## Main statements

- `IsIntegrallyClosed.exists_comp_eq_of_isIntegral`: a ring homomorphism to the fraction field
  with integral values factors through the ring.
- `IsDiscreteValuationRing.mem_range_of_isSeparable`: `F₁` is separably closed in `F`.
- `PrimeSpectrum.subsingleton_tensorProduct_of_forall_mem_range`: if `F` is separably closed in
  `E` and `M / F` is algebraic, then `M ⊗_F E` has at most one prime ideal.
- `IsDiscreteValuationRing.isLocalization_map_nonZeroDivisors`: `F` is the localization of `R` at
  the nonzero elements of `R₁`.
- `IsDiscreteValuationRing.subsingleton_primeSpectrum_tensorProduct`: `Spec(Ω₁ ⊗_{R₁} R)` has
  at most one point.
-/

@[expose] public section

universe u

open IsLocalRing Module IntermediateField

open scoped TensorProduct

/-- If `R` is integrally closed with fraction field `K` and `g : S →+* K` only takes values
integral over `R`, then `g` factors through `R`. -/
theorem IsIntegrallyClosed.exists_comp_eq_of_isIntegral {R K S : Type*} [CommRing R]
    [IsDomain R] [IsIntegrallyClosed R] [Field K] [Algebra R K] [IsFractionRing R K]
    [CommRing S] (g : S →+* K) (hg : ∀ s, IsIntegral R (g s)) :
    ∃ φ : S →+* R, (algebraMap R K).comp φ = g := by
  choose f hf using fun s ↦ IsIntegrallyClosed.isIntegral_iff.1 (hg s)
  have hinj := IsFractionRing.injective R K
  refine ⟨{ toFun := f
            map_one' := hinj (by rw [hf, map_one, map_one])
            map_mul' := fun a b ↦ hinj (by rw [hf, map_mul, map_mul, hf, hf])
            map_zero' := hinj (by rw [hf, map_zero, map_zero])
            map_add' := fun a b ↦ hinj (by rw [hf, map_add, map_add, hf, hf]) }, ?_⟩
  ext s
  exact hf s

namespace IsDiscreteValuationRing

/-- If the maximal ideal of a discrete valuation ring `R` is generated by the maximal ideal of
a discrete valuation ring `R₁`, then the image of a uniformizer of `R₁` is a uniformizer of
`R`. -/
theorem irreducible_algebraMap_of_maximalIdeal_eq_map {R₁ R : Type*} [CommRing R₁] [IsDomain R₁]
    [IsDiscreteValuationRing R₁] [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Algebra R₁ R]
    (hm : IsLocalRing.maximalIdeal R = (IsLocalRing.maximalIdeal R₁).map (algebraMap R₁ R))
    {π : R₁}
    (hπ : Irreducible π) : Irreducible (algebraMap R₁ R π) := by
  rw [irreducible_iff_uniformizer, hm, (irreducible_iff_uniformizer π).1 hπ, Ideal.map_span,
    Set.image_singleton]

/-- If the maximal ideal of a discrete valuation ring `R` is generated by the maximal ideal of
a discrete valuation ring `R₁`, then `R₁ → R` is injective. -/
theorem injective_algebraMap_of_maximalIdeal_eq_map {R₁ R : Type*} [CommRing R₁] [IsDomain R₁]
    [IsDiscreteValuationRing R₁] [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Algebra R₁ R]
    (hm : IsLocalRing.maximalIdeal R = (IsLocalRing.maximalIdeal R₁).map (algebraMap R₁ R)) :
    Function.Injective (algebraMap R₁ R) := by
  obtain ⟨π, hπ⟩ := exists_irreducible R₁
  have hπR := irreducible_algebraMap_of_maximalIdeal_eq_map hm hπ
  rw [injective_iff_map_eq_zero]
  intro x hx
  by_contra hx0
  obtain ⟨n, v, rfl⟩ := eq_unit_mul_pow_irreducible hx0 hπ
  rw [map_mul, map_pow] at hx
  exact pow_ne_zero n hπR.ne_zero
    ((IsUnit.mul_right_eq_zero ((v.isUnit.map (algebraMap R₁ R)))).1 hx)

/-- **The base is separably closed** in a "same uniformizer" extension: let `R₁` be a henselian
discrete valuation ring with separably closed residue field `k` and fraction field `F₁`, and
`R₁ → R` a local homomorphism to a discrete valuation ring `R` with fraction field `F`, such that
the maximal ideal of `R₁` generates that of `R` and every element of the residue field of `R`
algebraic over `k` comes from `k`. Then every element of `F` separable over `F₁` lies in `F₁`. -/
theorem mem_range_of_isSeparable
    {R₁ F₁ F : Type u} {R : Type*} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
    [HenselianLocalRing R₁] [IsSepClosed (ResidueField R₁)]
    [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra R₁ R]
    [IsLocalHom (algebraMap R₁ R)]
    [Field F₁] [Algebra R₁ F₁] [IsFractionRing R₁ F₁] [Field F] [Algebra R F] [IsFractionRing R F]
    [Algebra F₁ F] [Algebra R₁ F] [IsScalarTower R₁ F₁ F] [IsScalarTower R₁ R F]
    (hm : IsLocalRing.maximalIdeal R = (IsLocalRing.maximalIdeal R₁).map (algebraMap R₁ R))
    (hres : ∀ z : ResidueField R, IsAlgebraic (ResidueField R₁) z →
      z ∈ (algebraMap (ResidueField R₁) (ResidueField R)).range)
    (c : F) (hc : IsSeparable F₁ c) : c ∈ (algebraMap F₁ F).range := by
  classical
  obtain ⟨π, hπ⟩ := exists_irreducible R₁
  have hπR := irreducible_algebraMap_of_maximalIdeal_eq_map hm hπ
  set E := F₁⟮c⟯
  have : Algebra.IsSeparable F₁ E := (isSeparable_adjoin_simple_iff_isSeparable F₁ F).2 hc
  have : FiniteDimensional F₁ E := adjoin.finiteDimensional hc.isIntegral
  have := isLocalRing_integralClosure R₁ E
  have := isLocalHom_algebraMap_integralClosure R₁ F₁ E
  have := isDiscreteValuationRing_integralClosure R₁ F₁ E
  set B := integralClosure R₁ E
  have : IsScalarTower R₁ E F := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  obtain ⟨ϖ, u, e, hϖ, hu, he⟩ := exists_eq_unit_mul_pow_mul_finrank_residueField R₁ F₁ E hπ
  -- the inclusion `φ : B → R`
  obtain ⟨φ, hφ⟩ := IsIntegrallyClosed.exists_comp_eq_of_isIntegral (R := R) (K := F)
    ((algebraMap E F).comp (algebraMap B E)) fun b ↦
      (b.2.map (IsScalarTower.toAlgHom R₁ E F)).tower_top
  have hφa (a : R₁) : φ (algebraMap R₁ B a) = algebraMap R₁ R a := by
    apply IsFractionRing.injective R F
    rw [← RingHom.comp_apply, hφ, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  have hϖR : ¬ IsUnit (φ ϖ) := fun h ↦ hπR.not_isUnit (by
    rw [← hφa, hu, map_mul, map_pow]
    exact (u.isUnit.map φ).mul (h.pow e))
  -- the ramification index is `1`
  have he1 : e = 1 := by
    have hirr : Irreducible (φ ϖ ^ e) := by
      rwa [← hφa, hu, map_mul, irreducible_isUnit_mul (u.isUnit.map φ), map_pow] at hπR
    rcases e with _ | _ | e
    · exact absurd (pow_zero (φ ϖ) ▸ hirr) not_irreducible_one
    · rfl
    · rw [pow_succ] at hirr
      rcases hirr.isUnit_or_isUnit rfl with h | h
      · exact absurd ((isUnit_pow_iff (Nat.succ_ne_zero e)).1 h) hϖR
      · exact absurd h hϖR
  -- `φ` is local
  have : IsLocalHom φ := by
    refine ⟨fun x hx ↦ ?_⟩
    by_cases hx0 : x = 0
    · rw [hx0, map_zero] at hx
      exact absurd hx not_isUnit_zero
    obtain ⟨n, v, rfl⟩ := eq_unit_mul_pow_irreducible hx0 hϖ
    rw [map_mul, map_pow] at hx
    rcases n with _ | n
    · rw [pow_zero, mul_one]
      exact v.isUnit
    · exact absurd ((isUnit_pow_iff (Nat.succ_ne_zero n)).1 (isUnit_of_mul_isUnit_right hx)) hϖR
  -- the residue degree is `1`
  have hcomp : (ResidueField.map φ).comp (algebraMap (ResidueField R₁) (ResidueField B)) =
      algebraMap (ResidueField R₁) (ResidueField R) := by
    refine RingHom.ext fun x ↦ ?_
    obtain ⟨a, rfl⟩ := residue_surjective x
    rw [RingHom.comp_apply, ResidueField.algebraMap_residue, ResidueField.algebraMap_residue,
      ResidueField.map_residue, hφa]
  let ψ : ResidueField B →ₐ[ResidueField R₁] ResidueField R :=
    { ResidueField.map φ with commutes' := fun a ↦ congr($hcomp a) }
  have := Algebra.IsAlgebraic.residueField_of_isIntegral (R := R₁) (S := B)
  have hsurj : Function.Surjective (algebraMap (ResidueField R₁) (ResidueField B)) := by
    intro z
    obtain ⟨a, ha⟩ := hres (ψ z) ((Algebra.IsAlgebraic.isAlgebraic z).algHom ψ)
    refine ⟨a, ψ.toRingHom.injective ?_⟩
    exact (ψ.commutes a).trans ha
  have hf : finrank (ResidueField R₁) (ResidueField B) = 1 :=
    (LinearEquiv.ofBijective (Algebra.linearMap _ _)
      ⟨(algebraMap (ResidueField R₁) (ResidueField B)).injective, hsurj⟩).finrank_eq.symm.trans
      (finrank_self _)
  rw [he1, hf, one_mul, eq_comm, IntermediateField.finrank_eq_one_iff] at he
  have hcE : c ∈ E := mem_adjoin_simple_self F₁ c
  rw [he, mem_bot] at hcE
  exact hcE

/-- The fraction field `F` of `R` is the localization of `R` at the image of the nonzero elements
of `R₁`, if the maximal ideal of `R₁` generates that of `R`: every nonzero element of `R` is a
unit times a power of a uniformizer of `R₁`. -/
theorem isLocalization_map_nonZeroDivisors {R₁ R F : Type*} [CommRing R₁] [IsDomain R₁]
    [IsDiscreteValuationRing R₁] [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Algebra R₁ R] [Field F] [Algebra R F] [IsFractionRing R F]
    (hm : IsLocalRing.maximalIdeal R = (IsLocalRing.maximalIdeal R₁).map (algebraMap R₁ R)) :
    IsLocalization ((nonZeroDivisors R₁).map (algebraMap R₁ R)) F where
  map_units := by
    rintro ⟨_, y, hy, rfl⟩
    refine IsUnit.mk0 _ ?_
    rw [Ne, map_eq_zero_iff _ (IsFractionRing.injective R F),
      map_eq_zero_iff _ (injective_algebraMap_of_maximalIdeal_eq_map hm)]
    exact nonZeroDivisors.ne_zero hy
  surj z := by
    obtain ⟨π, hπ⟩ := exists_irreducible R₁
    have hπR := irreducible_algebraMap_of_maximalIdeal_eq_map hm hπ
    obtain ⟨⟨b, b', hb'⟩, h⟩ := IsLocalization.surj (nonZeroDivisors R) z
    obtain ⟨n, v, hv⟩ := eq_unit_mul_pow_irreducible (nonZeroDivisors.ne_zero hb') hπR
    refine ⟨⟨b * ↑v⁻¹, ⟨_, ⟨π ^ n, mem_nonZeroDivisors_of_ne_zero (pow_ne_zero _ hπ.ne_zero),
      rfl⟩⟩⟩, ?_⟩
    have h' : z * algebraMap R F b' = algebraMap R F b := h
    have hvu : algebraMap R F v * algebraMap R F ↑v⁻¹ = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    simp only
    rw [map_pow, map_pow, map_mul, ← h', hv, map_mul, map_pow]
    linear_combination (-(z * algebraMap R F (algebraMap R₁ R π) ^ n)) * hvu
  exists_of_eq {x y} h := ⟨1, by
    simp only [OneMemClass.coe_one, one_mul]
    exact IsFractionRing.injective R F h⟩

end IsDiscreteValuationRing

/-- If `F` is separably closed in `E` and `M / F` is algebraic, then `Spec(M ⊗_F E)` has at most
one point: it is homeomorphic to the spectrum of `M_s ⊗_F E`, `M_s` the separable closure of `F`
in `M`, which is a field. -/
theorem PrimeSpectrum.subsingleton_tensorProduct_of_forall_mem_range {F E M : Type*} [Field F]
    [Field E] [Field M] [Algebra F E] [Algebra F M] [Algebra.IsAlgebraic F M]
    (hE : ∀ c : E, IsSeparable F c → c ∈ (algebraMap F E).range) :
    Subsingleton (PrimeSpectrum (M ⊗[F] E)) := by
  have hF := Algebra.TensorProduct.isField_of_isSeparable_of_forall_mem_range hE
    (separableClosure F M)
  have : Subsingleton (PrimeSpectrum (separableClosure F M ⊗[F] E)) :=
    letI := hF.toField
    inferInstance
  exact (PrimeSpectrum.isHomeomorph_comap_tensorProductMap_of_isPurelyInseparable (R := F)
    (K := separableClosure F M) (S := E) M).injective.subsingleton

namespace IsDiscreteValuationRing

/-- **`Spec(Ω₁ ⊗_{R₁} R)` is a single point** (if nonempty): with the notation of
`IsDiscreteValuationRing.mem_range_of_isSeparable`, for every algebraic extension `Ω₁` of `F₁`,
the ring `Ω₁ ⊗_{R₁} R = Ω₁ ⊗_{F₁} F` has at most one prime ideal. -/
theorem subsingleton_primeSpectrum_tensorProduct
    {R₁ F₁ F : Type u} {R : Type*} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
    [HenselianLocalRing R₁] [IsSepClosed (ResidueField R₁)]
    [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra R₁ R]
    [IsLocalHom (algebraMap R₁ R)]
    [Field F₁] [Algebra R₁ F₁] [IsFractionRing R₁ F₁] [Field F] [Algebra R F] [IsFractionRing R F]
    [Algebra F₁ F] [Algebra R₁ F] [IsScalarTower R₁ F₁ F] [IsScalarTower R₁ R F]
    (Ω₁ : Type*) [Field Ω₁] [Algebra F₁ Ω₁] [Algebra R₁ Ω₁] [IsScalarTower R₁ F₁ Ω₁]
    [Algebra.IsAlgebraic F₁ Ω₁]
    (hm : IsLocalRing.maximalIdeal R = (IsLocalRing.maximalIdeal R₁).map (algebraMap R₁ R))
    (hres : ∀ z : ResidueField R, IsAlgebraic (ResidueField R₁) z →
      z ∈ (algebraMap (ResidueField R₁) (ResidueField R)).range) :
    Subsingleton (PrimeSpectrum (Ω₁ ⊗[R₁] R)) := by
  have : IsLocalization (Algebra.algebraMapSubmonoid R (nonZeroDivisors R₁)) F :=
    isLocalization_map_nonZeroDivisors hm
  have : Algebra.IsPushout R₁ F₁ R F :=
    (Algebra.isPushout_of_isLocalization (nonZeroDivisors R₁) (A := F₁) (T := R) (B := F)).symm
  have := PrimeSpectrum.subsingleton_tensorProduct_of_forall_mem_range (M := Ω₁)
    (mem_range_of_isSeparable (R := R) (F₁ := F₁) (F := F) hm hres)
  let e : Ω₁ ⊗[F₁] F ≃ₐ[F₁] Ω₁ ⊗[R₁] R :=
    (Algebra.TensorProduct.congr AlgEquiv.refl (Algebra.IsPushout.equiv R₁ F₁ R F).symm).trans
      (Algebra.TensorProduct.cancelBaseChange R₁ F₁ F₁ Ω₁ R)
  exact (PrimeSpectrum.comap_injective_of_surjective e.toRingHom e.surjective).subsingleton

/-- Variant of `IsDiscreteValuationRing.subsingleton_primeSpectrum_tensorProduct` for a field
`Ω₁` which is only given as an algebraic `R₁`-algebra with `R₁ → Ω₁` injective (e.g. an algebraic
closure of `F₁`): `Spec(Ω₁ ⊗_{R₁} R)` has at most one point. -/
theorem subsingleton_primeSpectrum_tensorProduct_of_injective
    {R₁ F₁ F : Type u} {R : Type*} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
    [HenselianLocalRing R₁] [IsSepClosed (ResidueField R₁)]
    [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra R₁ R]
    [IsLocalHom (algebraMap R₁ R)]
    [Field F₁] [Algebra R₁ F₁] [IsFractionRing R₁ F₁] [Field F] [Algebra R F] [IsFractionRing R F]
    [Algebra F₁ F] [Algebra R₁ F] [IsScalarTower R₁ F₁ F] [IsScalarTower R₁ R F]
    (Ω₁ : Type*) [Field Ω₁] [Algebra R₁ Ω₁] [Algebra.IsAlgebraic R₁ Ω₁]
    (hΩ : Function.Injective (algebraMap R₁ Ω₁))
    (hm : IsLocalRing.maximalIdeal R = (IsLocalRing.maximalIdeal R₁).map (algebraMap R₁ R))
    (hres : ∀ z : ResidueField R, IsAlgebraic (ResidueField R₁) z →
      z ∈ (algebraMap (ResidueField R₁) (ResidueField R)).range) :
    Subsingleton (PrimeSpectrum (Ω₁ ⊗[R₁] R)) := by
  let : Algebra F₁ Ω₁ := (IsFractionRing.lift (K := F₁) hΩ).toAlgebra
  have : IsScalarTower R₁ F₁ Ω₁ :=
    IsScalarTower.of_algebraMap_eq fun x ↦ (IsFractionRing.lift_algebraMap hΩ x).symm
  have : Algebra.IsAlgebraic F₁ Ω₁ :=
    Algebra.IsAlgebraic.extendScalars (IsFractionRing.injective R₁ F₁)
  exact subsingleton_primeSpectrum_tensorProduct (F₁ := F₁) (F := F) Ω₁ hm hres

end IsDiscreteValuationRing
