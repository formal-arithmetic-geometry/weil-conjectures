module

public import Mathlib.Algebra.Module.Injective
public import Mathlib.Algebra.Module.PID
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import WeilConjectures.Mathlib.LinearAlgebra.Dual.Lemmas

/-!
# Coefficient duality at the finite and integral stages

Let `𝒪` be a discrete valuation ring with uniformizer `ϖ` and `A_n = 𝒪 ⧸ ϖⁿ`, the finite
coefficient stages of the `ℓ`-adic formalism being `𝒪_E ⧸ ϖⁿ` for a finite extension `E` of
`ℚ_ℓ`. This file proves the algebraic distinctions between the stages recorded in the blueprint
lemma `lem-weil-coefficient-frobenius`.

## Main statements

- `IsDiscreteValuationRing.injective_quotient_pow`: `A_n` is self-injective.
- `IsDiscreteValuationRing.isReflexive_quotient_pow`: every finitely generated `A_n`-module `M`
  is reflexive, `M ≅ Hom(Hom(M, A_n), A_n)` by evaluation. Over a field this is
  `Module.IsReflexive` of a finite-dimensional vector space, an instance in mathlib.
- `IsDiscreteValuationRing.dual_quotient_eq_zero`,
  `IsDiscreteValuationRing.not_isReflexive_quotient`: over `𝒪` itself ordinary duality fails for
  torsion modules: `Hom_𝒪(𝒪 ⧸ ϖ, 𝒪) = 0`, so `𝒪 ⧸ ϖ` is not reflexive. Finite projective
  `𝒪`-modules are reflexive (an instance in mathlib).

## Implementation notes

The `A_n`-module `M` is decomposed, as a finitely generated torsion module over the principal
ideal domain `𝒪`, into cyclic modules `𝒪 ⧸ ϖ^m = A_n ⧸ ϖ^m` with `m ≤ n`. Each of these is
reflexive by `Module.isReflexive_quotient_of_colon`: the annihilator of `ϖ^m` in `A_n` is
`ϖ^(n - m)` and conversely, and every map out of an ideal of `A_n` is a multiplication.
-/

@[expose] public section

open Module

namespace IsDiscreteValuationRing

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {ϖ : R}
  (hϖ : Irreducible ϖ) (n : ℕ)

include hϖ

local notation "π" => Ideal.Quotient.mk (Ideal.span {ϖ ^ n})

omit [IsDiscreteValuationRing R] in
lemma pow_dvd_pow_mul_iff {m : ℕ} (hm : m ≤ n) (y : R) :
    ϖ ^ n ∣ ϖ ^ m * y ↔ ϖ ^ (n - m) ∣ y := by
  conv_lhs => rw [← Nat.add_sub_cancel' hm, pow_add]
  exact mul_dvd_mul_iff_left (pow_ne_zero _ hϖ.ne_zero)

omit [IsDomain R] [IsDiscreteValuationRing R] hϖ in
lemma mk_eq_zero_iff (y : R) : π y = 0 ↔ ϖ ^ n ∣ y := by
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]

omit [IsDomain R] [IsDiscreteValuationRing R] hϖ in
lemma mk_mem_span_mk_pow_iff {m : ℕ} (hm : m ≤ n) (y : R) :
    π y ∈ Ideal.span {π (ϖ ^ m)} ↔ ϖ ^ m ∣ y := by
  refine ⟨fun h ↦ ?_, fun ⟨z, hz⟩ ↦ hz ▸ Ideal.mem_span_singleton.2 ⟨π z, by simp⟩⟩
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 h
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [← map_mul, Ideal.Quotient.eq, Ideal.mem_span_singleton] at ha
  have h₁ : ϖ ^ m ∣ z * ϖ ^ m - y := (pow_dvd_pow ϖ hm).trans ha
  have h₂ : ϖ ^ m ∣ z * ϖ ^ m := dvd_mul_left _ _
  simpa using h₂.sub h₁

/-- Every ideal of `A_n = 𝒪 ⧸ ϖⁿ` is generated by the image of some `ϖ^m` with `m ≤ n`. -/
lemma exists_eq_span_mk_pow (J : Ideal (R ⧸ Ideal.span {ϖ ^ n})) :
    ∃ m ≤ n, J = Ideal.span {π (ϖ ^ m)} := by
  have hn : ϖ ^ n ∈ J.comap π := by
    rw [Ideal.mem_comap, (mk_eq_zero_iff n _).2 dvd_rfl]
    exact J.zero_mem
  have hne : J.comap π ≠ ⊥ := fun h ↦
    pow_ne_zero n hϖ.ne_zero ((Submodule.mem_bot R).1 (h ▸ hn))
  obtain ⟨m, hm⟩ := ideal_eq_span_pow_irreducible hne hϖ
  have hmn : m ≤ n := by
    rw [hm, Ideal.mem_span_singleton] at hn
    exact (pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit).1 hn
  refine ⟨m, hmn, ?_⟩
  rw [← Ideal.map_comap_of_surjective π Ideal.Quotient.mk_surjective J, hm, Ideal.map_span,
    Set.image_singleton]

/-- Every cyclic module `A_n ⧸ J` over `A_n = 𝒪 ⧸ ϖⁿ` is reflexive. -/
theorem isReflexive_quotient_quotient_pow (J : Ideal (R ⧸ Ideal.span {ϖ ^ n})) :
    IsReflexive (R ⧸ Ideal.span {ϖ ^ n}) ((R ⧸ Ideal.span {ϖ ^ n}) ⧸ J) := by
  obtain ⟨m, hm, rfl⟩ := exists_eq_span_mk_pow hϖ n J
  set K := (⊥ : Ideal (R ⧸ Ideal.span {ϖ ^ n})).colon
    ((Ideal.span {π (ϖ ^ m)} : Ideal (R ⧸ Ideal.span {ϖ ^ n})) : Set (R ⧸ Ideal.span {ϖ ^ n}))
  -- `c = π w` lies in the annihilator `K` of `ϖ^m` if and only if `ϖ^(n - m) ∣ w`
  have hK (w : R) : π w ∈ K ↔ ϖ ^ (n - m) ∣ w := by
    simp only [K, Submodule.mem_colon, SetLike.mem_coe, smul_eq_mul, Submodule.mem_bot]
    refine ⟨fun h ↦ ?_, fun ⟨z, hz⟩ j hj ↦ ?_⟩
    · have := h _ (Ideal.mem_span_singleton_self _)
      rwa [← map_mul, mk_eq_zero_iff n, mul_comm, pow_dvd_pow_mul_iff hϖ n hm] at this
    · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hj
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective a
      have e : ϖ ^ n = ϖ ^ (n - m) * ϖ ^ m := by rw [← pow_add, Nat.sub_add_cancel hm]
      rw [hz, ← map_mul, ← map_mul, mk_eq_zero_iff, e]
      exact ⟨z * y, by ring⟩
  have hg : π (ϖ ^ (n - m)) ∈ K := (hK _).2 dvd_rfl
  refine Module.isReflexive_quotient_of_colon _ (fun x hx ↦ ?_) fun f ↦ ?_
  · obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    have := hx _ hg
    rw [← map_mul, mk_eq_zero_iff n, mul_comm, pow_dvd_pow_mul_iff hϖ n (Nat.sub_le n m),
      Nat.sub_sub_self hm] at this
    exact (mk_mem_span_mk_pow_iff n hm y).2 this
  · obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (f ⟨_, hg⟩)
    -- `ϖ^m` kills the generator `π ϖ^(n - m)` of `K`, hence also its image `π z`
    have hz₀ : π (ϖ ^ m) * π z = 0 := by
      rw [hz, ← smul_eq_mul, ← map_smul]
      convert f.map_zero
      ext
      simp only [SetLike.val_smul, smul_eq_mul, ZeroMemClass.coe_zero, ← map_mul, ← pow_add,
        Nat.add_sub_cancel' hm]
      exact (mk_eq_zero_iff n _).2 dvd_rfl
    rw [← map_mul, mk_eq_zero_iff n, pow_dvd_pow_mul_iff hϖ n hm] at hz₀
    obtain ⟨b, rfl⟩ := hz₀
    refine ⟨π b, fun c ↦ ?_⟩
    obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (c : R ⧸ Ideal.span {ϖ ^ n})
    obtain ⟨d, rfl⟩ := (hK w).1 (hw ▸ c.2)
    have hc : c = π d • ⟨_, hg⟩ := by
      ext
      simp [← hw, mul_comm]
    rw [hc, map_smul, ← hz, smul_eq_mul]
    simp only [SetLike.val_smul, smul_eq_mul, map_mul]
    ring

/-- Blueprint `lem-weil-coefficient-frobenius`, clause (1) at the finite stages `A_{E,n}`:
`A_n = 𝒪 ⧸ ϖⁿ` is self-injective. By Baer's criterion: a map out of the ideal `(ϖ^m)` sends
`ϖ^m` to an element killed by `ϖ^(n - m)`, hence to a multiple `ϖ^m b`, and is the
multiplication by `b`. In particular `Hom(-, A_n)` is exact. -/
theorem injective_quotient_pow :
    Module.Injective (R ⧸ Ideal.span {ϖ ^ n}) (R ⧸ Ideal.span {ϖ ^ n}) := by
  refine Module.Baer.injective fun I g ↦ ?_
  obtain ⟨m, hm, rfl⟩ := exists_eq_span_mk_pow hϖ n I
  have hgen : π (ϖ ^ m) ∈ Ideal.span {π (ϖ ^ m)} := Ideal.mem_span_singleton_self _
  obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (g ⟨_, hgen⟩)
  have hz₀ : π (ϖ ^ (n - m)) * π z = 0 := by
    rw [hz, ← smul_eq_mul, ← map_smul]
    convert g.map_zero
    ext
    simp only [SetLike.val_smul, smul_eq_mul, ZeroMemClass.coe_zero, ← map_mul, ← pow_add,
      Nat.sub_add_cancel hm]
    exact (mk_eq_zero_iff n _).2 dvd_rfl
  rw [← map_mul, mk_eq_zero_iff, pow_dvd_pow_mul_iff hϖ n (Nat.sub_le n m),
    Nat.sub_sub_self hm] at hz₀
  obtain ⟨b, rfl⟩ := hz₀
  refine ⟨LinearMap.mulRight _ (π b), fun x hx ↦ ?_⟩
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hx
  have : (⟨c * π (ϖ ^ m), hx⟩ : Ideal.span {π (ϖ ^ m)}) = c • ⟨_, hgen⟩ := rfl
  rw [this, map_smul, ← hz, smul_eq_mul, LinearMap.mulRight_apply, map_mul]
  ring

/-- Blueprint `lem-weil-coefficient-frobenius`, clause (1) at the finite stages `A_{E,n}`:
every finitely generated module `M` over `A_n = 𝒪 ⧸ ϖⁿ` is reflexive, the evaluation
`M ⟶ Hom(Hom(M, A_n), A_n)` being an isomorphism. -/
theorem isReflexive_quotient_pow (M : Type*) [AddCommGroup M]
    [Module (R ⧸ Ideal.span {ϖ ^ n}) M] [Module.Finite (R ⧸ Ideal.span {ϖ ^ n}) M] :
    IsReflexive (R ⧸ Ideal.span {ϖ ^ n}) M := by
  classical
  let : Module R M := Module.compHom M π
  have : IsScalarTower R (R ⧸ Ideal.span {ϖ ^ n}) M :=
    ⟨fun r a m ↦ by change (π r * a) • m = π r • a • m; rw [mul_smul]⟩
  have : Module.Finite R M := Module.Finite.trans (R ⧸ Ideal.span {ϖ ^ n}) M
  have hkill (m : M) : ϖ ^ n • m = 0 := by
    change π (ϖ ^ n) • m = 0
    rw [(mk_eq_zero_iff n _).2 dvd_rfl, zero_smul]
  have htors : Module.IsTorsion R M := fun m ↦
    ⟨⟨ϖ ^ n, mem_nonZeroDivisors_of_ne_zero (pow_ne_zero _ hϖ.ne_zero)⟩, hkill m⟩
  obtain ⟨ι, _, p, -, e, ⟨f⟩⟩ := Module.equiv_directSum_of_isTorsion htors
  -- each summand `𝒪 ⧸ p^e` is killed by `ϖⁿ`
  have hle (i : ι) : Ideal.span {ϖ ^ n} ≤ R ∙ p i ^ e i := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    have h := congrArg f (hkill (f.symm (DirectSum.of _ i 1)))
    rw [map_smul, LinearEquiv.apply_symm_apply, map_zero, ← DirectSum.of_smul] at h
    have h' := DFinsupp.single_injective (h.trans (DirectSum.of _ i).map_zero.symm)
    have h'' : (Ideal.Quotient.mk (R ∙ p i ^ e i) (ϖ ^ n)) = 0 := by
      simpa [Algebra.smul_def, Ideal.Quotient.algebraMap_eq] using h'
    exact Ideal.Quotient.eq_zero_iff_mem.1 h''
  let g : M ≃ₗ[R] ∀ i, (R ⧸ Ideal.span {ϖ ^ n}) ⧸
      Ideal.map (Ideal.Quotient.mkₐ R (Ideal.span {ϖ ^ n})) (R ∙ p i ^ e i) :=
    f ≪≫ₗ DirectSum.linearEquivFunOnFintype R ι _ ≪≫ₗ
      LinearEquiv.piCongrRight fun i ↦
        (DoubleQuot.quotQuotEquivQuotOfLEₐ R (hle i)).symm.toLinearEquiv
  have := fun i ↦ isReflexive_quotient_quotient_pow hϖ n
    (Ideal.map (Ideal.Quotient.mkₐ R (Ideal.span {ϖ ^ n})) (R ∙ p i ^ e i))
  have := IsReflexive.pi (A := R ⧸ Ideal.span {ϖ ^ n}) fun i ↦ (R ⧸ Ideal.span {ϖ ^ n}) ⧸
    Ideal.map (Ideal.Quotient.mkₐ R (Ideal.span {ϖ ^ n})) (R ∙ p i ^ e i)
  exact Module.equiv (g.extendScalarsOfSurjective Ideal.Quotient.mk_surjective).symm

omit [IsDiscreteValuationRing R] in
/-- Blueprint `lem-weil-coefficient-frobenius`, clause (2): the integral stage `𝒪` is not
quasi-Frobenius. Ordinary duality kills the torsion module `𝒪 ⧸ ϖ`:
`Hom_𝒪(𝒪 ⧸ ϖ, 𝒪) = 0`. -/
theorem dual_quotient_eq_zero (φ : Dual R (R ⧸ Ideal.span {ϖ})) : φ = 0 := by
  refine LinearMap.ext fun x ↦ ?_
  have h : ϖ • x = 0 := by
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have := congrArg φ h
  rw [map_smul, map_zero, smul_eq_mul] at this
  exact (mul_eq_zero.1 this).resolve_left hϖ.ne_zero

omit [IsDiscreteValuationRing R] in
/-- Blueprint `lem-weil-coefficient-frobenius`, clause (2): ordinary evaluation is not an
isomorphism for every finite `𝒪`-module: `𝒪 ⧸ ϖ` is nonzero while its double dual vanishes.
Derived evaluation is an isomorphism for every perfect complex
(`DerivedCategory.IsPerfect.isIso_toIhomIhomUnit`, clause (3)). -/
theorem not_isReflexive_quotient : ¬ IsReflexive R (R ⧸ Ideal.span {ϖ}) := by
  intro h
  have hinj := h.bijective_dual_eval'.1
  have hne : (Ideal.Quotient.mk (Ideal.span {ϖ}) 1) ≠ 0 := by
    rw [Ne, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
    exact fun h ↦ hϖ.not_isUnit (isUnit_of_dvd_one h)
  refine hne (hinj (LinearMap.ext fun φ ↦ ?_))
  rw [dual_quotient_eq_zero hϖ φ]
  simp

end IsDiscreteValuationRing
