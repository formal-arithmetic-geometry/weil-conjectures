module

public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.RingTheory.IsAdjoinRoot
public import Mathlib.RingTheory.Polynomial.Eisenstein.Basic
public import Mathlib.RingTheory.Polynomial.UniqueFactorization

/-!
# Adjoining an `n`-th root of a uniformizer to a discrete valuation ring

Let `O` be a discrete valuation ring with uniformizer `π` and `n ≠ 0`. The polynomial `Xⁿ - π`
is Eisenstein (`Polynomial.isEisensteinAt_X_pow_sub_C`), and any `O`-algebra `O₂` presented as
`O[X]/(Xⁿ - π)` is a discrete valuation ring whose maximal ideal is generated by the adjoined
root (`IsAdjoinRoot.isDiscreteValuationRing_of_X_pow_sub_C`,
`IsAdjoinRoot.maximalIdeal_eq_span_root`).
-/

@[expose] public section

open Polynomial IsLocalRing

namespace Polynomial

/-- `Xⁿ - π` is Eisenstein at `(π)` for an irreducible element `π` and `n ≠ 0`. -/
theorem isEisensteinAt_X_pow_sub_C {O : Type*} [CommRing O] [IsDomain O] {π : O}
    (hπ : Irreducible π) {n : ℕ} (hn : n ≠ 0) : (X ^ n - C π).IsEisensteinAt (Ideal.span {π}) where
  leading := by
    rw [(monic_X_pow_sub_C π hn).leadingCoeff, Ideal.mem_span_singleton, ← isUnit_iff_dvd_one]
    exact hπ.not_isUnit
  mem {k} hk := by
    rw [natDegree_X_pow_sub_C] at hk
    rw [coeff_sub, coeff_X_pow, coeff_C, if_neg hk.ne]
    split_ifs
    · rw [zero_sub, neg_mem_iff]
      exact Ideal.mem_span_singleton_self π
    · simp
  notMem := by
    rw [coeff_sub, coeff_X_pow, if_neg (Ne.symm hn), coeff_C_zero, zero_sub,
      Ideal.span_singleton_pow, neg_mem_iff, Ideal.mem_span_singleton]
    rintro ⟨c, hc⟩
    refine hπ.not_isUnit (.of_mul_eq_one c ?_)
    apply mul_left_cancel₀ hπ.ne_zero
    rw [mul_one, ← mul_assoc, ← pow_two, ← hc]

end Polynomial

namespace IsAdjoinRoot

variable {O O₂ : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [CommRing O₂]
  [Algebra O O₂] {π : O} {n : ℕ} (h : IsAdjoinRoot O₂ (X ^ n - C π))

/-- The monic presentation `O[X]/(Xⁿ - π)`. -/
noncomputable def toMonicOfXPowSubC (hn : n ≠ 0) : IsAdjoinRootMonic O₂ (X ^ n - C π) :=
  { h with monic := monic_X_pow_sub_C π hn }

omit [IsDomain O] [IsDiscreteValuationRing O] in
include h in
theorem root_pow_eq : h.root ^ n = algebraMap O O₂ π := by
  have := h.map_self
  rw [map_sub, map_pow, map_X, ← h.algebraMap_apply, sub_eq_zero] at this
  exact this

include h in
theorem isDomain_of_X_pow_sub_C (hπ : Irreducible π) (hn : n ≠ 0) : IsDomain O₂ := by
  have hirr : Irreducible (X ^ n - C π) :=
    (isEisensteinAt_X_pow_sub_C hπ hn).irreducible
      ((Ideal.span_singleton_prime hπ.ne_zero).mpr hπ.prime)
      (monic_X_pow_sub_C π hn).isPrimitive (by rw [natDegree_X_pow_sub_C]; omega)
  have : IsDomain (AdjoinRoot (X ^ n - C π)) :=
    AdjoinRoot.isDomain_of_prime (UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr)
  let e := h.algEquiv (AdjoinRoot.isAdjoinRoot (X ^ n - C π))
  exact Function.Injective.isDomain (e : O₂ →+* AdjoinRoot (X ^ n - C π)) e.injective

omit [IsDomain O] [IsDiscreteValuationRing O] in
include h in
/-- Every element of `O[X]/(Xⁿ - π)` is of the form `a + t y` with `a ∈ O`. -/
theorem exists_eq_algebraMap_add_root_mul (x : O₂) :
    ∃ (a : O) (y : O₂), x = algebraMap O O₂ a + h.root * y := by
  obtain ⟨p, rfl⟩ := h.map_surjective x
  obtain ⟨q, hq⟩ : X ∣ p - C (p.coeff 0) := by
    rw [X_dvd_iff, coeff_sub, coeff_C_zero, sub_self]
  refine ⟨p.coeff 0, h.map q, ?_⟩
  rw [h.algebraMap_apply, ← map_X h, ← map_mul, ← map_add, ← hq, add_sub_cancel]

omit [IsDiscreteValuationRing O] in
include h in
theorem nontrivial_of_X_pow_sub_C (hn : n ≠ 0) : Nontrivial O₂ := by
  by_contra hO
  rw [not_nontrivial_iff_subsingleton] at hO
  have h1 : h.map 1 = 0 := Subsingleton.elim _ _
  rw [map_eq_zero_iff] at h1
  have := natDegree_le_of_dvd h1 one_ne_zero
  rw [natDegree_X_pow_sub_C, natDegree_one] at this
  omega

include h in
theorem root_mem_of_isMaximal (hπ : Irreducible π) (hn : n ≠ 0) (M : Ideal O₂) [M.IsMaximal] :
    h.root ∈ M := by
  have : Module.Finite O O₂ := (h.toMonicOfXPowSubC hn).powerBasis.finite
  have : Algebra.IsIntegral O O₂ := Algebra.IsIntegral.of_finite O O₂
  have hM : (M.under O).IsMaximal := Ideal.IsMaximal.under O M
  have hπM : π ∈ M.under O := by
    rw [IsLocalRing.eq_maximalIdeal hM]
    exact hπ.not_isUnit
  rw [Ideal.under, Ideal.mem_comap, ← h.root_pow_eq] at hπM
  exact Ideal.IsPrime.mem_of_pow_mem inferInstance n hπM

include h in
theorem not_isUnit_iff_mem_span_root (hπ : Irreducible π) (hn : n ≠ 0) (x : O₂) :
    ¬IsUnit x ↔ x ∈ Ideal.span {h.root} := by
  have := h.nontrivial_of_X_pow_sub_C hn
  constructor
  · intro hx
    obtain ⟨M, hM, hxM⟩ := exists_max_ideal_of_mem_nonunits hx
    obtain ⟨a, y, rfl⟩ := h.exists_eq_algebraMap_add_root_mul x
    have hroot := h.root_mem_of_isMaximal hπ hn M
    have haM : algebraMap O O₂ a ∈ M := by
      have := M.sub_mem hxM (M.mul_mem_right y hroot)
      rwa [add_sub_cancel_right] at this
    have ha : ¬IsUnit a := fun ha ↦ hM.ne_top (M.eq_top_of_isUnit_mem haM (ha.map _))
    rw [← mem_nonunits_iff, ← mem_maximalIdeal,
      (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ,
      Ideal.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    rw [map_mul, ← h.root_pow_eq, Ideal.mem_span_singleton]
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt (Nat.pos_of_ne_zero hn)
    exact ⟨h.root ^ k * algebraMap O O₂ c + y, by ring⟩
  · intro hx hu
    rw [Ideal.mem_span_singleton] at hx
    obtain ⟨M, hM⟩ := Ideal.exists_maximal O₂
    exact hM.ne_top (M.eq_top_of_isUnit_mem
      (M.mem_of_dvd hx (h.root_mem_of_isMaximal hπ hn M)) hu)

include h in
theorem isLocalRing_of_X_pow_sub_C (hπ : Irreducible π) (hn : n ≠ 0) : IsLocalRing O₂ := by
  have := h.nontrivial_of_X_pow_sub_C hn
  refine IsLocalRing.of_nonunits_add fun a b ha hb ↦ ?_
  rw [mem_nonunits_iff, h.not_isUnit_iff_mem_span_root hπ hn] at ha hb ⊢
  exact Ideal.add_mem _ ha hb

include h in
/-- The maximal ideal of `O[X]/(Xⁿ - π)` is generated by the adjoined root. -/
theorem maximalIdeal_eq_span_root (hπ : Irreducible π) (hn : n ≠ 0) :
    letI := h.isLocalRing_of_X_pow_sub_C hπ hn
    maximalIdeal O₂ = Ideal.span {h.root} := by
  let := h.isLocalRing_of_X_pow_sub_C hπ hn
  ext x
  rw [mem_maximalIdeal, mem_nonunits_iff, h.not_isUnit_iff_mem_span_root hπ hn]

include h in
/-- `O[X]/(Xⁿ - π)` is a discrete valuation ring (it is a domain by
`IsAdjoinRoot.isDomain_of_X_pow_sub_C`). -/
theorem isDiscreteValuationRing_of_X_pow_sub_C [IsDomain O₂] (hπ : Irreducible π) (hn : n ≠ 0) :
    IsDiscreteValuationRing O₂ := by
  have := h.isLocalRing_of_X_pow_sub_C hπ hn
  have : Module.Finite O O₂ := (h.toMonicOfXPowSubC hn).powerBasis.finite
  have : IsNoetherianRing O₂ := isNoetherian_of_tower O inferInstance
  have hfield : ¬IsField O₂ := by
    intro hF
    have h0 : h.root ∈ maximalIdeal O₂ := by
      rw [h.maximalIdeal_eq_span_root hπ hn]
      exact Ideal.mem_span_singleton_self _
    rw [(IsLocalRing.isField_iff_maximalIdeal_eq).mp hF, Ideal.mem_bot] at h0
    have h1 : h.map (C π) = 0 := by
      rw [← h.algebraMap_apply, ← h.root_pow_eq, h0, zero_pow hn]
    rw [map_eq_zero_iff] at h1
    have := natDegree_le_of_dvd h1 (C_ne_zero.mpr hπ.ne_zero)
    rw [natDegree_X_pow_sub_C, natDegree_C] at this
    omega
  refine ((IsDiscreteValuationRing.TFAE O₂ hfield).out 0 4).mpr ?_
  rw [h.maximalIdeal_eq_span_root hπ hn]
  exact ⟨⟨h.root, rfl⟩⟩

end IsAdjoinRoot
