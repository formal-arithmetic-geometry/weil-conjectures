module

public import Mathlib.Algebra.Category.CommAlgCat.Basic
public import Mathlib.CategoryTheory.ObjectProperty.Ind
public import Mathlib.RingTheory.Smooth.Basic
import Mathlib.Algebra.Category.Ring.FinitePresentation

/-! # A smooth factorization of the reduction of a finitely presented algebra

Source: Stacks Project, Smoothing Ring Maps, Lemma Tag 07F5, fourth paragraph;
Algebra, Lemma Tag 00QO.
(blueprint: lem-weil-pbc-popescu-smooth-quotient-factor)
-/

@[expose] public section

universe u v
open CategoryTheory Limits

private def liftBaseToUnder (R : Type u) [CommRing R] :
    CommAlgCat.{max u v} R ⥤ Under (CommRingCat.of (ULift.{v} R)) where
  obj C := Under.mk (CommRingCat.ofHom
    ((algebraMap R C).comp ULift.ringEquiv.toRingHom))
  map f := Under.homMk (CommRingCat.ofHom f.hom.toRingHom) (by
    ext r
    exact f.hom.commutes r.down)

private def liftBaseFromUnder (R : Type u) [CommRing R] :
    Under (CommRingCat.of (ULift.{v} R)) ⥤ CommAlgCat.{max u v} R where
  obj C := by
    let : Algebra R C.right :=
      (C.hom.hom.comp ULift.ringEquiv.symm.toRingHom).toAlgebra
    exact CommAlgCat.of R C.right
  map {C D} f := by
    let : Algebra R C.right :=
      (C.hom.hom.comp ULift.ringEquiv.symm.toRingHom).toAlgebra
    let : Algebra R D.right :=
      (D.hom.hom.comp ULift.ringEquiv.symm.toRingHom).toAlgebra
    exact CommAlgCat.ofHom
      { toRingHom := f.right.hom
        commutes' r :=
          congrArg (fun g : CommRingCat.of (ULift.{v} R) ⟶ _ ↦ g.hom ⟨r⟩) (Under.w f) }

private def liftBaseEquivUnder (R : Type u) [CommRing R] :
    CommAlgCat.{max u v} R ≌ Under (CommRingCat.of (ULift.{v} R)) where
  functor := liftBaseToUnder R
  inverse := liftBaseFromUnder R
  unitIso := NatIso.ofComponents (fun C ↦ by
    refine { hom := ?_, inv := ?_, hom_inv_id := ?_, inv_hom_id := ?_ }
    · exact ConcreteCategory.ofHom
        { toRingHom := RingHom.id C, commutes' _ := rfl }
    · exact ConcreteCategory.ofHom
        { toRingHom := RingHom.id C, commutes' _ := rfl }
    · ext x; rfl
    · ext x; rfl) (by intros; ext x; rfl)
  counitIso := NatIso.ofComponents (fun C ↦ Under.isoMk
    (Iso.refl C.right) (by ext x; rfl)) (by intros; ext x; rfl)

/-- Factor a finitely presented algebra map modulo the square of an element through a
smooth algebra over the quotient base.

Source: Stacks Project, Smoothing Ring Maps, Lemma Tag 07F5, fourth paragraph;
Algebra, Lemma Tag 00QO.
(blueprint: lem-weil-pbc-popescu-smooth-quotient-factor)

Proof: Unpack the filtered colimit of smooth R/(ρ²)-algebras. Forgetting to
commutative rings preserves its colimit: identify algebras over the quotient
with rings under a universe lift of that quotient, and use preservation of
connected colimits by the under-category projection. Regard every term as an
R-algebra. The original A is finitely presented over R, so the map
A → Λ/(ρ²Λ) factors through one term C by 00QO (in filtered form 07C3).
For the ring-category version, replace R by ULift R; its ring equivalence to R
preserves finite presentation, and maps from its elements are exactly maps
from R. The factor map β commutes with R by the structure-map equality in
the factorization lemma. Restrict the colimit map to R to obtain j.
The factorization equality gives j(β(a)) = α(a) modulo ρ². Identify the mapped
principal ideal with the ideal generated by algebraMap R Λ (ρ²). C already
has universe max u v, as prescribed by the given ind-property. This argument
works also for ρ = 0, for a unit ρ, and for zero rings; no nonzerodivisor or
Noetherian hypothesis is required. -/
theorem exists_popescu_smooth_quotient_factor
    (R : Type u) (Λ : Type (max u v)) [CommRing R] [CommRing Λ] [Algebra R Λ]
    (A : Type (max u v)) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A]
    (α : A →ₐ[R] Λ) (ρ : R)
    (hmod : ObjectProperty.ind.{max u v}
      (fun B : CommAlgCat.{max u v} (R ⧸ Ideal.span {ρ ^ 2}) ↦
        Algebra.Smooth (R ⧸ Ideal.span {ρ ^ 2}) B)
      (CommAlgCat.of (R ⧸ Ideal.span {ρ ^ 2})
        (Λ ⧸ (Ideal.span {ρ ^ 2}).map (algebraMap R Λ)))) :
    ∃ (C : Type (max u v)) (_ : CommRing C) (_ : Algebra R C)
      (_ : Algebra (R ⧸ Ideal.span {ρ ^ 2}) C)
      (_ : IsScalarTower R (R ⧸ Ideal.span {ρ ^ 2}) C)
      (_ : Algebra.Smooth (R ⧸ Ideal.span {ρ ^ 2}) C)
      (β : A →ₐ[R] C)
      (j : C →ₐ[R] (Λ ⧸ Ideal.span {algebraMap R Λ (ρ ^ 2)})),
      ∀ a : A, j (β a) = Ideal.Quotient.mk _ (α a) := by
  classical
  obtain ⟨J, _catJ, _filteredJ, pres, hs⟩ := hmod
  let : SmallCategory J := _catJ
  let : IsFiltered J := _filteredJ
  let Q := R ⧸ Ideal.span {ρ ^ 2}
  let L := Λ ⧸ (Ideal.span {ρ ^ 2}).map (algebraMap R Λ)
  let e := liftBaseEquivUnder.{u, v} Q
  let G := e.functor ⋙ Under.forget (CommRingCat.of (ULift.{v} Q))
  let F := pres.diag ⋙ G
  let cc := G.mapCocone pres.cocone
  have hcc : IsColimit cc := isColimitOfPreserves G pres.isColimit
  let r : CommRingCat.{max u v} := CommRingCat.of (ULift.{v} R)
  let f : r ⟶ CommRingCat.of A := CommRingCat.ofHom
    ((algebraMap R A).comp ULift.ringEquiv.toRingHom)
  let t : (Functor.const J).obj r ⟶ F :=
    { app i := CommRingCat.ofHom ((algebraMap Q (pres.diag.obj i)).comp
        ((Ideal.Quotient.mk _).comp ULift.ringEquiv.toRingHom))
      naturality i j g := by
        ext x
        exact ((pres.diag.map g).hom.commutes (Ideal.Quotient.mk _ x.down)).symm }
  let g : CommRingCat.of A ⟶ cc.pt := CommRingCat.ofHom
    ((Ideal.Quotient.mk _).comp α.toRingHom)
  have hfp : f.hom.FinitePresentation :=
    (RingHom.finitePresentation_algebraMap.mpr inferInstance).comp
      (RingHom.FinitePresentation.of_bijective ULift.ringEquiv.bijective)
  obtain ⟨i, b, hb, hbg⟩ := RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
    r F t f cc hcc hfp g (by
      intro i
      ext x
      change Ideal.Quotient.mk _ (α (algebraMap R A x.down)) =
        (pres.ι.app i).hom (algebraMap Q (pres.diag.obj i) (Ideal.Quotient.mk _ x.down))
      rw [α.commutes, (pres.ι.app i).hom.commutes]
      rfl)
  let C := pres.diag.obj i
  let : Algebra R C :=
    ((algebraMap Q C).comp (Ideal.Quotient.mk (Ideal.span {ρ ^ 2}))).toAlgebra
  let : IsScalarTower R Q C := IsScalarTower.of_algebraMap_eq (fun _ ↦ rfl)
  let : Algebra.Smooth Q C := hs i
  let β : A →ₐ[R] C :=
    { toRingHom := b.hom
      commutes' a := congrArg (fun h : r ⟶ F.obj i ↦ h.hom ⟨a⟩) hb }
  have hideal : (Ideal.span {ρ ^ 2}).map (algebraMap R Λ) =
      Ideal.span {algebraMap R Λ (ρ ^ 2)} := by
    rw [Ideal.map_span, Set.image_singleton]
  let k : L ≃ₐ[R] (Λ ⧸ Ideal.span {algebraMap R Λ (ρ ^ 2)}) :=
    Ideal.quotientEquivAlgOfEq R hideal
  let j₀ : C →ₐ[R] L :=
    { toRingHom := (pres.ι.app i).hom.toRingHom
      commutes' a := by
        change (pres.ι.app i).hom (algebraMap Q C (Ideal.Quotient.mk _ a)) = _
        rw [(pres.ι.app i).hom.commutes]
        rfl }
  let j : C →ₐ[R] (Λ ⧸ Ideal.span {algebraMap R Λ (ρ ^ 2)}) :=
    k.toAlgHom.comp j₀
  refine ⟨C, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, β, j, ?_⟩
  intro a
  have hba : (pres.ι.app i).hom (β a) = Ideal.Quotient.mk _ (α a) :=
    (congrArg (fun h : CommRingCat.of A ⟶ cc.pt ↦ h.hom a) hbg).symm
  change k ((pres.ι.app i).hom (β a)) = _
  rw [hba]
  exact Ideal.quotientEquivAlgOfEq_mk R hideal (α a)
