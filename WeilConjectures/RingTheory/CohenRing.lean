module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.AdicCompletion.Basic

/-!
# Cohen rings

Source: Stacks Project, Algebra, Definition Tag 0327
(blueprint: def-weil-pbc-cohen-ring).
-/

@[expose] public section

universe v

/-- A Cohen ring with residue characteristic `p` is a local PID which is not a field,
with maximal ideal generated by the prime number `p`, complete for that ideal.
Source: Stacks Project, Algebra, Definition Tag 0327; completeness is Tag 0317.
(blueprint: def-weil-pbc-cohen-ring) -/
def IsCohenRing (p : ℕ) (R : Type v) [CommRing R] : Prop :=
  Nat.Prime p ∧ ∃ (_ : IsDomain R) (_ : IsDiscreteValuationRing R),
    IsLocalRing.maximalIdeal R = Ideal.span {(p : R)} ∧
      IsAdicComplete (Ideal.span {(p : R)}) R
