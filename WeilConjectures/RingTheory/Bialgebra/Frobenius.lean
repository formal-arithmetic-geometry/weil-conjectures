public import WeilConjectures.RingTheory.HopfAlgebra.Cartier

/-!
# Finite local bialgebras in characteristic `p` have `p`-power dimension

Let `K` be a field of characteristic `p > 0` and let `A` be a finite-dimensional commutative local
`K`-bialgebra, for instance the coordinate ring of a connected finite group scheme over `K`. We
show that `dim_K A` is a power of `p`.

The argument avoids the Milnor–Moore and restricted Poincaré–Birkhoff–Witt theorems. Let
`B = K[aᵖ | a ∈ A]` be the subalgebra generated by `p`-th powers; it is a sub-bialgebra
(`Subalgebra.frobenius`), and it is a proper subalgebra unless `A = K`. Choose `x₁, …, x_r` in the
augmentation ideal `𝔪` lifting a basis of `𝔪/𝔪²`. The invariant derivations of `A` provide
derivations `D_k` of `A` with `D_k xᵢ = δ_{ki}`; they vanish on `B`. Adjoining the `xᵢ` to `B`
one at a time multiplies the dimension by `p` each time, because `xᵢᵖ ∈ B` and `D_i` kills
everything adjoined before `xᵢ`. Hence `dim_K A = pʳ · dim_K B`, and induction on the dimension
concludes.

## Main definitions

- `Subalgebra.bialgebra`: a subalgebra whose comultiplication lands in `S ⊗ S` is a bialgebra.
- `Subalgebra.frobenius`: the subalgebra generated by the `p`-th powers.

## Main statements

- `Subalgebra.finrank_adjoin_insert_eq_mul`: adjoining an element `x` with `xᵖ ∈ E` to a
  subalgebra `E` multiplies the dimension by `p`, given a derivation killing `E` with `D x = 1`.
- `Bialgebra.finrank_eq_pow_mul_finrank_frobenius`: `dim_K A = pʳ · dim_K B` with
  `r = dim_K 𝔪/𝔪²`.
- `Bialgebra.exists_finrank_eq_pow`: a finite-dimensional commutative local bialgebra over a field
  of characteristic `p > 0` has dimension a power of `p`.

## Blueprint

`Bialgebra.exists_finrank_eq_pow` is the algebraic content of `lem-sc-connected-finite-order` and
`sk-prop-av-connected-order`.
-/

@[expose] public section

open Coalgebra TensorProduct Module IsLocalRing

/-! ### Sub-bialgebras -/

namespace Subalgebra

variable {K A : Type*} [Field K] [CommRing A] [Bialgebra K A] {S : Subalgebra K A}

theorem injective_map_val_val :
    Function.Injective (Algebra.TensorProduct.map S.val S.val) :=
  TensorProduct.map_injective_of_flat_flat S.val.toLinearMap S.val.toLinearMap
    Subtype.val_injective Subtype.val_injective

variable (hS : ∀ s ∈ S, Coalgebra.comul (R := K) s ∈ (Algebra.TensorProduct.map S.val S.val).range)

/-- The comultiplication of `A` restricted to a subalgebra `S` with `Δ(S) ⊆ S ⊗ S`. -/
noncomputable def restrictComul : S →ₐ[K] S ⊗[K] S :=
  (AlgEquiv.ofInjective _ injective_map_val_val).symm.toAlgHom.comp
    (((Bialgebra.comulAlgHom K A).comp S.val).codRestrict _ fun s ↦ hS s s.2)

theorem map_val_val_restrictComul (s : S) :
    Algebra.TensorProduct.map S.val S.val (restrictComul hS s) = Coalgebra.comul (R := K) (s : A) :=
  congrArg Subtype.val ((AlgEquiv.ofInjective _ injective_map_val_val).apply_symm_apply
    ⟨Coalgebra.comul (R := K) (s : A), hS s s.2⟩)

/-- A subalgebra `S` of a bialgebra with `Δ(S) ⊆ S ⊗ S` is a bialgebra, a *sub-bialgebra*. -/
noncomputable abbrev bialgebra : Bialgebra K S :=
  Bialgebra.ofAlgHom (restrictComul hS) ((Bialgebra.counitAlgHom K A).comp S.val)
    (by
      let j := Algebra.TensorProduct.map S.val (Algebra.TensorProduct.map S.val S.val)
      have hj : Function.Injective j :=
        TensorProduct.map_injective_of_flat_flat S.val.toLinearMap
          (Algebra.TensorProduct.map S.val S.val).toLinearMap Subtype.val_injective
          injective_map_val_val
      have h₁ (t : S ⊗[K] S) : j (Algebra.TensorProduct.assoc K K K S S S
          (Algebra.TensorProduct.map (restrictComul hS) (.id K S) t)) =
          TensorProduct.assoc K A A A (Coalgebra.comul (R := K) (A := A) |>.rTensor A
            (Algebra.TensorProduct.map S.val S.val t)) := by
        induction t using TensorProduct.induction_on with
        | zero => simp
        | add t₁ t₂ h₁ h₂ => simp only [map_add, h₁, h₂]
        | tmul a b =>
          simp only [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul, AlgHom.id_apply,
            Subalgebra.coe_val]
          rw [← map_val_val_restrictComul hS]
          induction restrictComul hS a using TensorProduct.induction_on with
          | zero => simp
          | add t₁ t₂ h₁ h₂ => simp only [add_tmul, map_add, h₁, h₂]
          | tmul c d => rfl
      have h₂ (t : S ⊗[K] S) : j (Algebra.TensorProduct.map (.id K S) (restrictComul hS) t) =
          (Coalgebra.comul (R := K) (A := A)).lTensor A
            (Algebra.TensorProduct.map S.val S.val t) := by
        induction t using TensorProduct.induction_on with
        | zero => simp
        | add t₁ t₂ h₁ h₂ => simp only [map_add, h₁, h₂]
        | tmul a b =>
          simp only [j, Algebra.TensorProduct.map_tmul, LinearMap.lTensor_tmul, AlgHom.id_apply,
            map_val_val_restrictComul hS, Subalgebra.coe_val]
      refine AlgHom.ext fun s ↦ hj ?_
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [h₁, h₂, map_val_val_restrictComul hS]
      exact Coalgebra.coassoc_apply (s : A))
    (by
      let j := Algebra.TensorProduct.map (.id K K) S.val
      have hj : Function.Injective j :=
        TensorProduct.map_injective_of_flat_flat (AlgHom.id K K).toLinearMap S.val.toLinearMap
          (fun _ _ h ↦ h) Subtype.val_injective
      refine AlgHom.ext fun s ↦ hj ?_
      have h (t : S ⊗[K] S) : j (Algebra.TensorProduct.map
          ((Bialgebra.counitAlgHom K A).comp S.val) (.id K S) t) =
          (Coalgebra.counit (R := K) (A := A)).rTensor A
            (Algebra.TensorProduct.map S.val S.val t) := by
        induction t using TensorProduct.induction_on with
        | zero => simp
        | add t₁ t₂ h₁ h₂ => simp only [map_add, h₁, h₂]
        | tmul a b => rfl
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [h, map_val_val_restrictComul hS, Coalgebra.rTensor_counit_comul]
      rfl)
    (by
      let j := Algebra.TensorProduct.map S.val (.id K K)
      have hj : Function.Injective j :=
        TensorProduct.map_injective_of_flat_flat' S.val.toLinearMap (AlgHom.id K K).toLinearMap
          Subtype.val_injective (fun _ _ h ↦ h)
      refine AlgHom.ext fun s ↦ hj ?_
      have h (t : S ⊗[K] S) : j (Algebra.TensorProduct.map (.id K S)
          ((Bialgebra.counitAlgHom K A).comp S.val) t) =
          (Coalgebra.counit (R := K) (A := A)).lTensor A
            (Algebra.TensorProduct.map S.val S.val t) := by
        induction t using TensorProduct.induction_on with
        | zero => simp
        | add t₁ t₂ h₁ h₂ => simp only [map_add, h₁, h₂]
        | tmul a b => rfl
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [h, map_val_val_restrictComul hS, Coalgebra.lTensor_counit_comul]
      rfl)

end Subalgebra

/-! ### Finite-dimensional subalgebras of local algebras -/

namespace Subalgebra

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A]

/-- In a finite-dimensional subalgebra `S`, an element invertible in the ambient algebra is
invertible in `S`. -/
theorem isUnit_of_isUnit_coe {S : Subalgebra K A} [FiniteDimensional K S] {s : S}
    (hs : IsUnit (s : A)) : IsUnit s := by
  have hinj : Function.Injective (LinearMap.mulLeft K s) := fun t₁ t₂ h ↦ by
    apply Subtype.val_injective
    have := congrArg Subtype.val h
    simp only [LinearMap.mulLeft_apply, Subalgebra.coe_mul] at this
    exact hs.mul_left_cancel this
  obtain ⟨t, ht⟩ := (LinearMap.injective_iff_surjective.1 hinj) 1
  exact isUnit_iff_exists_inv.2 ⟨t, ht⟩

/-- A finite-dimensional subalgebra of a local algebra is local. -/
theorem isLocalRing [IsLocalRing A] (S : Subalgebra K A) [FiniteDimensional K S] :
    IsLocalRing S :=
  IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun s ↦ by
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (s : A) with h | h
    · exact .inl (isUnit_of_isUnit_coe h)
    · exact .inr (isUnit_of_isUnit_coe (s := 1 - s) (by simpa using h))

/-! ### The subalgebra generated by `p`-th powers -/

variable (K A) (p : ℕ)

/-- The subalgebra `K[aᵖ | a ∈ A]` generated by the `p`-th powers. When `K` has characteristic
`p` and `A` is the coordinate ring of a group scheme `G`, it is the coordinate ring of the image
of the relative Frobenius of `G`. -/
def frobenius : Subalgebra K A :=
  Algebra.adjoin K (Set.range fun a : A ↦ a ^ p)

variable {K A p}

theorem pow_mem_frobenius (a : A) : a ^ p ∈ frobenius K A p :=
  Algebra.subset_adjoin ⟨a, rfl⟩

/-- In characteristic `p`, every derivation vanishes on the `p`-th powers. -/
theorem derivation_apply_eq_zero_of_mem_frobenius [Fact p.Prime] [CharP A p]
    (D : Derivation K A A) {b : A} (hb : b ∈ frobenius K A p) : D b = 0 := by
  refine Derivation.eqOn_adjoin (D2 := 0) ?_ hb
  rintro _ ⟨a, rfl⟩
  simp [Derivation.leibniz_pow, nsmul_eq_mul, CharP.cast_eq_zero]

end Subalgebra

namespace Subalgebra

variable {K A : Type*} [Field K] [CommRing A] [Bialgebra K A] {p : ℕ}

/-- In characteristic `p`, the comultiplication maps `K[aᵖ | a ∈ A]` into its tensor square:
`Δ(aᵖ) = Δ(a)ᵖ` is a sum of tensors of `p`-th powers. -/
theorem comul_mem_range_of_mem_frobenius [Nontrivial A] [Fact p.Prime] [CharP K p] :
    ∀ s ∈ frobenius K A p, Coalgebra.comul (R := K) s ∈
      (Algebra.TensorProduct.map (frobenius K A p).val (frobenius K A p).val).range := by
  have : Nontrivial (A ⊗[K] A) :=
    Function.Surjective.nontrivial (f := Algebra.TensorProduct.lmul' (S := A) K)
      fun a ↦ ⟨a ⊗ₜ 1, by simp⟩
  have : CharP (A ⊗[K] A) p := charP_of_injective_algebraMap (algebraMap K _).injective p
  have key (t : A ⊗[K] A) : t ^ p ∈
      (Algebra.TensorProduct.map (frobenius K A p).val (frobenius K A p).val).range := by
    induction t using TensorProduct.induction_on with
    | zero => rw [zero_pow (Fact.out : p.Prime).ne_zero]; exact zero_mem _
    | tmul x y =>
      exact ⟨⟨x ^ p, pow_mem_frobenius x⟩ ⊗ₜ ⟨y ^ p, pow_mem_frobenius y⟩, by
        simp [Algebra.TensorProduct.tmul_pow]⟩
    | add t₁ t₂ h₁ h₂ => rw [add_pow_char]; exact add_mem h₁ h₂
  have : frobenius K A p ≤ Subalgebra.comap (Bialgebra.comulAlgHom K A)
      (Algebra.TensorProduct.map (frobenius K A p).val (frobenius K A p).val).range :=
    Algebra.adjoin_le <| by
      rintro _ ⟨a, rfl⟩
      simpa [Bialgebra.comul_pow] using key (Coalgebra.comul a)
  exact fun s hs ↦ this hs

/-- The `p`-th powers generate a sub-bialgebra. -/
noncomputable abbrev frobeniusBialgebra [Nontrivial A] [Fact p.Prime] [CharP K p] :
    Bialgebra K (frobenius K A p) :=
  Subalgebra.bialgebra comul_mem_range_of_mem_frobenius

/-- An element `b` of `K[aᵖ | a ∈ A]` is congruent to its counit modulo `𝔪²`, where `𝔪` is the
augmentation ideal. -/
theorem sub_algebraMap_mem_sq_of_mem_frobenius [Nontrivial A] [Fact p.Prime] [CharP K p]
    {b : A} (hb : b ∈ frobenius K A p) :
    b - algebraMap K A (Bialgebra.counitAlgHom K A b) ∈
      RingHom.ker (Bialgebra.counitAlgHom K A) ^ 2 := by
  have : CharP A p := charP_of_injective_algebraMap (algebraMap K A).injective p
  set ε := Bialgebra.counitAlgHom K A
  induction hb using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    rw [map_pow, map_pow, ← sub_pow_char]
    exact Ideal.pow_le_pow_right (Fact.out : p.Prime).two_le
      (Ideal.pow_mem_pow (ε.sub_algebraMap_mem_ker a) p)
  | algebraMap r => simp
  | add x y _ _ hx hy =>
    convert add_mem hx hy using 1
    rw [map_add, map_add]
    ring
  | mul x y _ _ hx hy =>
    have : x * y - algebraMap K A (ε (x * y)) =
        (x - algebraMap K A (ε x)) * y + algebraMap K A (ε x) * (y - algebraMap K A (ε y)) := by
      rw [map_mul, map_mul]
      ring
    rw [this]
    exact add_mem (Ideal.mul_mem_right _ _ hx) (Ideal.mul_mem_left _ _ hy)

end Subalgebra

/-! ### Adjoining a `p`-th root -/

namespace Subalgebra

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A] [Nontrivial A]
  {p : ℕ} [Fact p.Prime] [CharP K p]

/-- Let `E` be a subalgebra and `x` an element with `xᵖ ∈ E`. If some derivation `D` kills `E` and
sends `x` to `1`, then `1, x, …, x^{p-1}` is a basis of `E[x]` over `E`; in particular
`dim_K E[x] = p · dim_K E`. -/
theorem finrank_adjoin_insert_eq_mul (E : Subalgebra K A) {x : A} (hx : x ^ p ∈ E)
    (D : Derivation K A A) (hD : ∀ e ∈ E, D e = 0) (hDx : D x = 1) :
    finrank K (Algebra.adjoin K (insert x (E : Set A))) = p * finrank K E := by
  have hp := (Fact.out : p.Prime)
  have hunit (j : ℕ) (hj0 : 0 < j) (hjp : j < p) : IsUnit (j : A) := by
    have : (j : K) ≠ 0 := by
      rw [ne_eq, CharP.cast_eq_zero_iff K p]
      exact fun h ↦ absurd (Nat.le_of_dvd hj0 h) (not_le.2 hjp)
    simpa using (IsUnit.mk0 _ this).map (algebraMap K A)
  have hDterm (c : A) (hc : c ∈ E) (j : ℕ) :
      D (c * x ^ (j + 1)) = ((j + 1 : ℕ) : A) * c * x ^ j := by
    rw [Derivation.leibniz, hD c hc, smul_zero, add_zero, Derivation.leibniz_pow, hDx,
      Nat.add_sub_cancel, smul_eq_mul, nsmul_eq_mul, smul_eq_mul, mul_one]
    ring
  -- linear independence of `1, x, …, x^{p-1}` over `E`
  have key : ∀ n ≤ p, ∀ c : ℕ → A, (∀ j, c j ∈ E) →
      ∑ j ∈ Finset.range n, c j * x ^ j = 0 → ∀ j < n, c j = 0 := by
    intro n
    induction n with
    | zero => intro _ _ _ _ j hj; omega
    | succ n ih =>
      intro hn c hc hsum
      have hsum' := congrArg D hsum
      rw [map_sum, Finset.sum_range_succ', pow_zero, mul_one, hD _ (hc 0), add_zero, map_zero]
        at hsum'
      simp_rw [hDterm _ (hc _)] at hsum'
      have h' := ih (by omega) (fun j ↦ ((j + 1 : ℕ) : A) * c (j + 1))
        (fun j ↦ E.mul_mem (E.natCast_mem _) (hc _)) hsum'
      have hc' : ∀ j < n, c (j + 1) = 0 := fun j hj ↦
        ((hunit (j + 1) (by omega) (by omega)).mul_right_eq_zero).1 (h' j hj)
      rw [Finset.sum_range_succ', Finset.sum_eq_zero fun j hj ↦ by
        rw [hc' j (Finset.mem_range.1 hj), zero_mul], zero_add, pow_zero, mul_one] at hsum
      intro j hj
      rcases j with _ | j
      · exact hsum
      · exact hc' j (by omega)
  have hli : LinearIndependent E (fun j : Fin p ↦ x ^ (j : ℕ)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have := key p le_rfl (fun j ↦ if h : j < p then (g ⟨j, h⟩ : A) else 0)
      (fun j ↦ by split_ifs <;> simp) (by
        rw [← Fin.sum_univ_eq_sum_range (fun j ↦ (if h : j < p then (g ⟨j, h⟩ : A) else 0) *
          x ^ j) p]
        simpa [Subalgebra.smul_def] using hg) i i.2
    simpa using this
  set M := Submodule.span E (Set.range fun j : Fin p ↦ x ^ (j : ℕ))
  have hpow (n : ℕ) : x ^ n ∈ M := by
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      by_cases hn : n < p
      · exact Submodule.subset_span ⟨⟨n, hn⟩, rfl⟩
      · have : x ^ n = (⟨x ^ p, hx⟩ : E) • x ^ (n - p) := by
          rw [Subalgebra.smul_def, smul_eq_mul, ← pow_add, Nat.add_sub_cancel' (not_lt.1 hn)]
        rw [this]
        exact M.smul_mem _ (ih _ (Nat.sub_lt (hp.pos.trans_le (not_lt.1 hn)) hp.pos))
  have hmul (a b : A) (ha : a ∈ M) (hb : b ∈ M) : a * b ∈ M := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨i, rfl⟩ := ha
      induction hb using Submodule.span_induction with
      | mem b hb =>
        obtain ⟨j, rfl⟩ := hb
        rw [← pow_add]
        exact hpow _
      | zero => rw [mul_zero]; exact M.zero_mem
      | add b c _ _ hb hc => rw [mul_add]; exact M.add_mem hb hc
      | smul e b _ hb => rw [mul_smul_comm]; exact M.smul_mem e hb
    | zero => rw [zero_mul]; exact M.zero_mem
    | add a c _ _ ha hc => rw [add_mul]; exact M.add_mem ha hc
    | smul e a _ ha => rw [smul_mul_assoc]; exact M.smul_mem e ha
  have hEM (e : A) (he : e ∈ E) : e ∈ M := by
    have : e = (⟨e, he⟩ : E) • x ^ 0 := by rw [Subalgebra.smul_def, smul_eq_mul, pow_zero, mul_one]
    rw [this]
    exact M.smul_mem _ (hpow 0)
  have heq : Subalgebra.toSubmodule (Algebra.adjoin K (insert x (E : Set A))) =
      M.restrictScalars K := by
    refine le_antisymm ?_ ?_
    · let T : Subalgebra K A := (M.restrictScalars K).toSubalgebra (by simpa using hpow 0)
        (fun a b ha hb ↦ hmul a b ha hb)
      have : Algebra.adjoin K (insert x (E : Set A)) ≤ T :=
        Algebra.adjoin_le (Set.insert_subset_iff.2
          ⟨show x ∈ M by simpa using hpow 1, fun e he ↦ show e ∈ M from hEM e he⟩)
      exact this
    · intro a ha
      induction ha using Submodule.span_induction with
      | mem a ha =>
        obtain ⟨j, rfl⟩ := ha
        exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_insert _ _)) _
      | zero => exact zero_mem _
      | add a c _ _ ha hc => exact add_mem ha hc
      | smul e a _ ha =>
        rw [Subalgebra.smul_def]
        exact Subalgebra.mul_mem _ (Algebra.subset_adjoin (Set.mem_insert_of_mem _ e.2)) ha
  have : Module.Free E M := Module.Free.of_basis (Basis.span hli)
  have hres : finrank K (M.restrictScalars K) = finrank K M := rfl
  rw [← Subalgebra.finrank_toSubmodule, heq, hres,
    ← Module.finrank_mul_finrank K E M, finrank_span_eq_card hli, Fintype.card_fin, mul_comm]

end Subalgebra

/-! ### Generators of a finite local algebra -/

namespace AlgHom

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A] [IsLocalRing A] (ε : A →ₐ[K] K)

/-- The ideal of a `K`-point of a local `K`-algebra is the maximal ideal. -/
theorem ker_eq_maximalIdeal : RingHom.ker ε = maximalIdeal A :=
  IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ fun c ↦
    ⟨algebraMap K A c, ε.commutes c⟩)

variable [FiniteDimensional K A]

/-- Elements of a finite local `K`-algebra lifting a spanning family of the cotangent space at a
`K`-point generate the algebra. -/
theorem adjoin_eq_top_of_span_toCotangent {ι : Type*} [_root_.Finite ι] (x : ι → RingHom.ker ε)
    (hx : Submodule.span K (Set.range fun i ↦ (RingHom.ker ε).toCotangent (x i)) = ⊤) :
    Algebra.adjoin K (Set.range fun i ↦ (x i : A)) = ⊤ := by
  have : IsNoetherianRing A := isNoetherian_of_tower K inferInstance
  have := Fintype.ofFinite ι
  -- the `xᵢ` generate the ideal of `ε` (Nakayama)
  have h₁ : RingHom.ker ε ≤ Ideal.span (Set.range fun i ↦ (x i : A)) := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := RingHom.ker ε)
      (IsNoetherian.noetherian _) ((ker_eq_maximalIdeal ε).le.trans
        (maximalIdeal_le_jacobson ⊥)) fun a ha ↦ ?_
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).1
      (hx ▸ Submodule.mem_top : (RingHom.ker ε).toCotangent ⟨a, ha⟩ ∈ _)
    let y : RingHom.ker ε := ∑ i, algebraMap K A (c i) • x i
    have hy : (y : A) ∈ Ideal.span (Set.range fun i ↦ (x i : A)) := by
      simp only [y, Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul]
      exact sum_mem fun i _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    have hay : a - y ∈ RingHom.ker ε ^ 2 := by
      have : (RingHom.ker ε).toCotangent ⟨a, ha⟩ = (RingHom.ker ε).toCotangent y := by
        rw [← hc]
        simp only [y, map_sum, algebraMap_smul, LinearMap.map_smul_of_tower]
      exact (Ideal.toCotangent_eq _).1 this
    rw [pow_two, ← Ideal.smul_eq_mul] at hay
    exact Submodule.mem_sup.2 ⟨y, hy, a - y, hay, add_sub_cancel _ _⟩
  -- Nakayama over the subalgebra `S = K[x₁, …, x_r]`
  set S := Algebra.adjoin K (Set.range fun i ↦ (x i : A))
  have : IsLocalRing S := Subalgebra.isLocalRing S
  have : Module.Finite S A := Module.Finite.of_restrictScalars_finite K S A
  have hxS (i : ι) : (⟨x i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : S) ∈ maximalIdeal S := by
    refine (mem_maximalIdeal _).2 fun hu ↦ ?_
    have : (x i : A) ∈ maximalIdeal A := ker_eq_maximalIdeal ε ▸ (x i).2
    exact (mem_maximalIdeal _).1 this (hu.map S.val)
  have h₂ : (⊤ : Submodule S A) ≤ Submodule.span S {1} := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := maximalIdeal S)
      Module.Finite.fg_top (maximalIdeal_le_jacobson ⊥) fun a _ ↦ ?_
    have ha : a - algebraMap K A (ε a) ∈ Ideal.span (Set.range fun i ↦ (x i : A)) :=
      h₁ (ε.sub_algebraMap_mem_ker a)
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 ha
    refine Submodule.mem_sup.2 ⟨algebraMap K A (ε a), ?_, a - algebraMap K A (ε a), ?_,
      add_sub_cancel _ _⟩
    · rw [Submodule.mem_span_singleton]
      exact ⟨algebraMap K S (ε a), by rw [Algebra.smul_def, mul_one]; rfl⟩
    · rw [← hc]
      refine sum_mem fun i _ ↦ ?_
      have : c i * (x i : A) = (⟨x i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : S) • c i := by
        rw [Subalgebra.smul_def, smul_eq_mul, mul_comm]
      rw [this]
      exact Submodule.smul_mem_smul (hxS i) Submodule.mem_top
  refine eq_top_iff.2 fun a _ ↦ ?_
  obtain ⟨s, hs⟩ := Submodule.mem_span_singleton.1 (h₂ (Submodule.mem_top (x := a)))
  rw [← hs, Subalgebra.smul_def, smul_eq_mul, mul_one]
  exact s.2

end AlgHom

/-! ### Finite local bialgebras -/

namespace Bialgebra

variable {K A : Type*} [Field K] [CommRing A] [Bialgebra K A] [FiniteDimensional K A]
  [IsLocalRing A] {p : ℕ} [Fact p.Prime] [CharP K p]

local notation "𝔪" => RingHom.ker (Bialgebra.counitAlgHom K A)

variable (K A p) in
/-- A finite-dimensional commutative local bialgebra `A` over a field of characteristic `p > 0`
has dimension `pʳ · dim_K K[aᵖ | a ∈ A]`, where `r` is the dimension of the cotangent space
`𝔪/𝔪²` at the counit. -/
theorem finrank_eq_pow_mul_finrank_frobenius :
    finrank K A = p ^ finrank K (𝔪).Cotangent * finrank K (Subalgebra.frobenius K A p) := by
  set ε := Bialgebra.counitAlgHom K A
  have : IsNoetherianRing A := isNoetherian_of_tower K inferInstance
  have : CharP A p := charP_of_injective_algebraMap (algebraMap K A).injective p
  have : FiniteDimensional K (RingHom.ker ε).Cotangent := ε.finiteDimensional_cotangent
  set r := finrank K (RingHom.ker ε).Cotangent
  set B := Subalgebra.frobenius K A p
  let bV := Module.finBasis K (RingHom.ker ε).Cotangent
  choose x hx using fun i ↦ Ideal.toCotangent_surjective (RingHom.ker ε) (bV i)
  choose D hD using fun k ↦ Bialgebra.exists_derivation_of_cotangent K A (bV.coord k)
  have hε (k i : Fin r) : ε (D k (x i)) = (1 : Matrix (Fin r) (Fin r) K) k i := by
    rw [hD k _ (x i).2, hx, bV.coord_apply, bV.repr_self, Finsupp.single_apply, Matrix.one_apply]
    simp only [eq_comm]
  -- normalise the invariant derivations so that `D' k (x i) = δ_{ki}`
  let M : Matrix (Fin r) (Fin r) A := Matrix.of fun k i ↦ D k (x i)
  have hM : IsUnit M.det := by
    by_contra h
    have hmem : M.det ∈ RingHom.ker ε :=
      ε.ker_eq_maximalIdeal ▸ (mem_maximalIdeal _).2 h
    have : ε M.det = 1 := by
      rw [AlgHom.map_det]
      convert Matrix.det_one (n := Fin r) (R := K)
      ext k i
      exact hε k i
    exact one_ne_zero (this.symm.trans hmem)
  obtain ⟨D', hD'⟩ : ∃ D' : Fin r → Derivation K A A,
      ∀ k i, D' k (x i) = if k = i then 1 else 0 := by
    refine ⟨fun k ↦ ∑ j, M⁻¹ k j • D j, fun k i ↦ ?_⟩
    have h := congrFun (congrFun (Matrix.nonsing_inv_mul M hM) k) i
    rw [Matrix.mul_apply, Matrix.one_apply] at h
    rw [← h]
    change Derivation.coeFnAddMonoidHom (∑ j, M⁻¹ k j • D j) (x i) = _
    rw [map_sum, Finset.sum_apply]
    rfl
  -- adjoin the `xᵢ` to `B` one at a time
  obtain ⟨X, hX⟩ : ∃ X : ℕ → Set A, ∀ n, X n = {a | ∃ l : Fin r, (l : ℕ) < n ∧ (x l : A) = a} :=
    ⟨_, fun _ ↦ rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℕ → Subalgebra K A, ∀ n, E n = Algebra.adjoin K ((B : Set A) ∪ X n) :=
    ⟨_, fun _ ↦ rfl⟩
  have hfin (n : ℕ) (hn : n ≤ r) : finrank K (E n) = p ^ n * finrank K B := by
    induction n with
    | zero =>
      have : X 0 = ∅ := Set.eq_empty_of_forall_notMem fun a ha ↦ by
        obtain ⟨l, hl, _⟩ := (hX 0).subset ha
        omega
      rw [hE, this, Set.union_empty, Algebra.adjoin_eq, pow_zero, one_mul]
    | succ n ih =>
      set l : Fin r := ⟨n, hn⟩
      have hset : (B : Set A) ∪ X (n + 1) = insert (x l : A) ((B : Set A) ∪ X n) := by
        ext a
        simp only [Set.mem_insert_iff, Set.mem_union, hX, Set.mem_ofPred_eq]
        constructor
        · rintro (h | ⟨l', hl', rfl⟩)
          · exact .inr (.inl h)
          · rcases Nat.lt_succ_iff_lt_or_eq.1 hl' with hl' | hl'
            · exact .inr (.inr ⟨l', hl', rfl⟩)
            · exact .inl (by rw [show l' = l from Fin.ext hl'])
        · rintro (rfl | h | ⟨l', hl', rfl⟩)
          · exact .inr ⟨l, Nat.lt_succ_self n, rfl⟩
          · exact .inl h
          · exact .inr ⟨l', by omega, rfl⟩
      have hEn : E (n + 1) = Algebra.adjoin K (insert (x l : A) (E n : Set A)) := by
        rw [hE, hE, Algebra.adjoin_insert_adjoin, hset]
      have hkill : ∀ e ∈ E n, D' l e = 0 := by
        intro e he
        rw [hE] at he
        refine Derivation.eqOn_adjoin (D2 := 0) ?_ he
        rintro a (ha | ha)
        · exact Subalgebra.derivation_apply_eq_zero_of_mem_frobenius _ ha
        · obtain ⟨l', hl', rfl⟩ := (hX n).subset ha
          rw [hD', if_neg (fun h ↦ by rw [← h] at hl'; exact lt_irrefl _ hl')]
          rfl
      have hxl : (x l : A) ^ p ∈ E n := by
        rw [hE]
        exact Algebra.subset_adjoin (.inl (Subalgebra.pow_mem_frobenius _))
      rw [hEn, Subalgebra.finrank_adjoin_insert_eq_mul (E n) hxl (D' l) hkill
        (by rw [hD', if_pos rfl]), ih (by omega), pow_succ]
      ring
  have htop : E r = ⊤ := by
    rw [hE]
    refine eq_top_iff.2 ((ε.adjoin_eq_top_of_span_toCotangent x ?_).ge.trans
      (Algebra.adjoin_mono fun a ⟨i, hi⟩ ↦ .inr ((hX r).superset ⟨i, i.2, hi⟩)))
    simp only [hx, bV.span_eq]
  rw [← hfin r le_rfl, htop]
  exact Subalgebra.topEquiv.toLinearEquiv.finrank_eq.symm

variable (K A p) in
/-- **Blueprint `lem-sc-connected-finite-order`, algebraic form**: a finite-dimensional
commutative local bialgebra over a field of characteristic `p > 0` has dimension a power of `p`.
Applied to the coordinate ring of a connected finite group scheme, this is
`AlgebraicGeometry.exists_finrankΓ_eq_pow`. -/
theorem exists_finrank_eq_pow : ∃ r : ℕ, finrank K A = p ^ r := by
  induction hn : finrank K A using Nat.strong_induction_on generalizing A with
  | _ n ih =>
  set ε := Bialgebra.counitAlgHom K A
  have : IsNoetherianRing A := isNoetherian_of_tower K inferInstance
  by_cases hm : RingHom.ker ε = ⊥
  · refine ⟨0, ?_⟩
    rw [← hn, pow_zero, ← Module.finrank_self K]
    exact (LinearEquiv.ofBijective ε.toLinearMap
      ⟨(RingHom.injective_iff_ker_eq_bot (ε : A →+* K)).2 hm,
      fun c ↦ ⟨algebraMap K A c, ε.commutes c⟩⟩).finrank_eq
  · let B := Subalgebra.frobenius K A p
    let : Bialgebra K B := Subalgebra.frobeniusBialgebra
    have : IsLocalRing B := Subalgebra.isLocalRing B
    have hB : B ≠ ⊤ := fun hB ↦ hm <| by
      refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ (IsNoetherian.noetherian _)
        (fun a ha ↦ ?_) (ε.ker_eq_maximalIdeal.le.trans (maximalIdeal_le_jacobson ⊥))
      have := Subalgebra.sub_algebraMap_mem_sq_of_mem_frobenius (hB ▸ Algebra.mem_top : a ∈ B)
      rwa [show ε a = 0 from ha, map_zero, sub_zero, pow_two, ← Ideal.smul_eq_mul] at this
    have hlt : finrank K B < n := by
      rw [← hn, ← Subalgebra.finrank_toSubmodule]
      refine Submodule.finrank_lt fun h ↦ hB ?_
      rwa [← Algebra.toSubmodule_eq_top]
    obtain ⟨s, hs⟩ := ih _ hlt B rfl
    exact ⟨_, by rw [← hn, finrank_eq_pow_mul_finrank_frobenius K A p, hs, ← pow_add]⟩

end Bialgebra
