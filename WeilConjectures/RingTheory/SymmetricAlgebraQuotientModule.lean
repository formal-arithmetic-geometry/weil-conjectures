module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import WeilConjectures.LinearAlgebra.SymmetricAlgebra.DegreeExact
import WeilConjectures.RingTheory.SymmetricAlgebraQuotientModuleKernel

/-!
# Symmetric algebra of a quotient module

For a surjective linear map `p : N → M`, the induced map `Sym_R(N) → Sym_R(M)` is surjective
with kernel generated by the image of `ker p`, so `Sym_R(M)` is the corresponding quotient of
`Sym_R(N)` (`symmetricAlgebra_quotient_module`).

## Implementation details

Surjectivity and the kernel description come from `symmetricAlgebra_quotient_module_kernel`;
the isomorphism is then the first isomorphism theorem for commutative `R`-algebras.

## References

* [Stacks, Tag 00DO], summed over all degrees
-/

@[expose] public section

universe u v w

/-- Let `R` be a commutative ring and `p : N →ₗ[R] M` a surjective map of `R`-modules. The
symmetric algebra map induced by `p` is surjective, its kernel is the ideal
generated by the canonical images of `ker p`, and the resulting quotient is
isomorphic to the symmetric algebra of `M`. -/
theorem symmetricAlgebra_quotient_module
    (R : Type u) [CommRing R]
    (N : Type v) (M : Type w) [AddCommGroup N] [AddCommGroup M]
    [Module R N] [Module R M]
    (p : N →ₗ[R] M) (hp : Function.Surjective p) :
    Function.Surjective
        (SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)) ∧
      RingHom.ker (SymmetricAlgebra.lift
        ((SymmetricAlgebra.ι R M).comp p)).toRingHom =
        Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N)) ∧
      ∃ e :
          (SymmetricAlgebra R N ⧸
            Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N)))
            ≃ₐ[R] SymmetricAlgebra R M,
        e.toAlgHom.comp (Ideal.Quotient.mkₐ R
          (Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N)))) =
          SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p) := by
  let f : SymmetricAlgebra R N →ₐ[R] SymmetricAlgebra R M :=
    SymmetricAlgebra.lift ((SymmetricAlgebra.ι R M).comp p)
  have h := symmetricAlgebra_quotient_module_kernel R N M p hp
  have hsurj : Function.Surjective f := h.1
  have hker : RingHom.ker f.toRingHom =
      Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker p : Set N)) := h.2
  let e₀ := Ideal.quotientKerAlgEquivOfSurjective hsurj
  let e := (Ideal.quotientEquivAlgOfEq R hker.symm).trans e₀
  refine ⟨hsurj, hker, e, ?_⟩
  ext x
  change e (Ideal.Quotient.mk _ (SymmetricAlgebra.ι R N x)) = f (SymmetricAlgebra.ι R N x)
  change ((Ideal.quotientEquivAlgOfEq R hker.symm).trans e₀)
      (Ideal.Quotient.mk _ (SymmetricAlgebra.ι R N x)) = _
  rw [AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk]
  exact Ideal.quotientKerAlgEquivOfSurjective_mk hsurj _
