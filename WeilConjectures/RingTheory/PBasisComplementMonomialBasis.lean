module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Algebra.Algebra.ZMod
import WeilConjectures.RingTheory.PBasisComplementMonomialBasisLinearIndependent
import WeilConjectures.RingTheory.PBasisComplementMonomialBasisSpanning
import Mathlib.LinearAlgebra.Basis.Basic

/-!
# The finite part of a p-basis over its complementary subfield

Removing a finite part `J` of a p-basis of `k` leaves its bounded monomials as a basis of `k` over
the subfield generated by `k^p` and the remaining p-basis elements.

## Implementation details

The bounded complementary monomials span `kJ` over `F_p(k^p)`. Every exponent function splits
uniquely into its restrictions to `J` and its complement, so grouping coordinates in the given
`F_p(k^p)`-basis gives spanning and independence over `kJ`. The case `J = ∅` is included.

## References

* [Stacks, Tag 07P5] (first paragraph of the proof)
-/

@[expose] public section

set_option autoImplicit false

universe u w

attribute [local instance] ZMod.algebra

namespace RingTheory

/-- Let `t` be a p-basis of a field `k` of characteristic `p` and `J` a finite set of indices.
Over the subfield `kJ` generated by `k^p` and the `t i` with `i ∉ J`, the monomials
`∏ i ∈ J, t i ^ E i` with `E i < p` form a basis of `k`. -/
theorem pBasisComplementMonomialBasis
    (p : ℕ) [Fact p.Prime]
    (k : Type u) [Field k] [CharP k p]
    (I : Type w) (t : I → k)
    (hpb : ∃ b : Module.Basis
      {E : I →₀ ℕ // ∀ i : I, E i < p}
      (IntermediateField.adjoin (ZMod p) (Set.range (fun x : k ↦ x ^ p))) k,
      ∀ E, b E = (E : I →₀ ℕ).prod (fun i e ↦ t i ^ e))
    (J : Finset I) (kJ : Subfield k)
    (hkJ : kJ = Subfield.closure
      (Set.range (fun x : k ↦ x ^ p) ∪ {x : k | ∃ i : I, i ∉ J ∧ t i = x})) :
    ∃ b : Module.Basis (J → Fin p) kJ k,
      ∀ E, b E = ∏ i : J, t i ^ (E i : ℕ) := by
  have hli := pBasisComplementMonomialBasis_linearIndependent p k I t hpb J kJ hkJ
  have hsp := pBasisComplementMonomialBasis_spanning p k I t hpb J kJ hkJ
  refine ⟨Module.Basis.mk hli hsp, ?_⟩
  intro E
  exact Module.Basis.mk_apply hli hsp E

end RingTheory
