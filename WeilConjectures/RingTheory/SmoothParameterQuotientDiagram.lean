/-! # Quotienting smooth polynomial diagrams by their parameters

Source: Stacks Project, Algebra, Tags 00T4 and 00TA; Algebra, Tag 07NF;
Divisors, Tags 063D and 063G; the quotient and colimit universal properties
(blueprint: lem-per-smooth-parameter-quotient-diagram).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace IsLocalRing

/-- A smooth polynomial diagram with a local colimit has compatible regular parameter
quotients, and their colimit is the residue field. This is a base-change statement
for a supplied diagram; it neither constructs smooth approximations nor assumes that
its colimit is regular or complete or that the base is a prime field.

Source: Stacks Project, Algebra, Tags 00T4 and 00TA; Algebra, Tag 07NF;
Divisors, Tags 063D and 063G; the quotient and colimit universal properties
(blueprint: lem-per-smooth-parameter-quotient-diagram).

Proof: Write P=k[X_i], J=(X_i), and J_a=(τ_a(X_i)) in C_a. Naturality of τ
makes every transition map preserve J_a. Define D_a=C_a/J_a and its transition maps
by the quotient universal property, q_a the quotient projections, and γ_a the map
to F=B/n induced by residue∘β_a. Compatibility with τ and generation of n by t
show that these maps kill J_a. Naturality and the displayed commuting square follow
by surjectivity of the quotient maps. The normalization equivalence is the identity.
The maps to the nonzero field F show that D_a, and hence C_a, are nonzero.
The variables are a regular sequence in P: successive quotients are polynomial
rings in the remaining variables, and multiplication by the next variable is
injective on coefficients. Smoothness implies flatness (00TA); tensoring these
injective multiplication maps with C_a proves weak regularity in C_a. The final
quotient D_a is nonzero, giving regularity of the full sequence. Smooth base change
(00T4) along P→P/J=k identifies D_a as a smooth k-algebra. The rings P and k are
regular Noetherian, so smooth ascent (07NF) makes C_a and D_a regular Noetherian.
The affine quotient immersion has kernel generated by the displayed length-d
regular sequence, giving codimension d on the full affine chart (063D, 063G).
For the residue colimit, compose any compatible family D_a→R with q_a and use the
given colimit to obtain a unique B→R. Since the index is nonempty, evaluating at
τ_a(X_i) shows that this map kills every t_i, hence n. It factors uniquely through
F. Surjectivity of each q_a and of B→F proves both the cocone equations and
uniqueness. This proves the ring colimit, including maps to a zero ring R. When
d=0 all the ideals J_a vanish and generation gives n=0; the construction is the
original diagram with its colimit identified with F.
-/
theorem smooth_parameter_quotient_diagram
    (k₀ B : Type u) [Field k₀] [CommRing B] [Algebra k₀ B] [IsLocalRing B]
    (d : ℕ) (t : Fin d → B)
    (hgen : Ideal.span (Set.range t) = maximalIdeal B)
    (I : Type u) [PartialOrder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (C : I ⥤ CommAlgCat.{u} k₀)
    (τ : (Functor.const I).obj (CommAlgCat.of k₀ (MvPolynomial (Fin d) k₀)) ⟶ C)
    (β : C ⟶ (Functor.const I).obj (CommAlgCat.of k₀ B))
    (hcompat : ∀ a : I, (β.app a).hom.comp (τ.app a).hom = MvPolynomial.aeval t)
    (hsmooth : ∀ a : I,
      Smooth (Spec.map (CommRingCat.ofHom (τ.app a).hom.toRingHom)))
    (hcolim : Nonempty (IsColimit
      ((forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u}).mapCocone
        { pt := CommAlgCat.of k₀ B, ι := β }))) :
    (∀ a : I, Nontrivial (C.obj a) ∧ IsRegularRing (C.obj a) ∧
      RingTheory.Sequence.IsRegular (C.obj a)
        (List.ofFn fun i : Fin d ↦ (τ.app a).hom (MvPolynomial.X i))) ∧
    ∃ (D : I ⥤ CommAlgCat.{u} k₀) (q : C ⟶ D)
      (γ : D ⟶ (Functor.const I).obj (CommAlgCat.of k₀ (ResidueField B))),
      (∀ a : I, ∃ e :
          (C.obj a ⧸ Ideal.span (Set.range fun i : Fin d ↦
            (τ.app a).hom (MvPolynomial.X i))) ≃ₐ[k₀] D.obj a,
        ∀ x : C.obj a,
          e (Ideal.Quotient.mk (Ideal.span (Set.range fun i : Fin d ↦
            (τ.app a).hom (MvPolynomial.X i))) x) = (q.app a).hom x) ∧
      (∀ a : I, Nontrivial (D.obj a) ∧ IsRegularRing (D.obj a) ∧
        Smooth (Spec.map (CommRingCat.ofHom (algebraMap k₀ (D.obj a)))) ∧
        IsRegularClosedImmersionWithCodimension
          (Spec.map (CommRingCat.ofHom (q.app a).hom.toRingHom)) (fun _ ↦ d)) ∧
      Nonempty (IsColimit ((forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u}).mapCocone
        { pt := CommAlgCat.of k₀ (ResidueField B), ι := γ })) ∧
      (∀ a : I, (γ.app a).hom.toRingHom.comp (q.app a).hom.toRingHom =
        (residue B).comp (β.app a).hom.toRingHom) := by
  classical
  let K (a : I) : Ideal (C.obj a) :=
    Ideal.span (Set.range fun i : Fin d ↦ (τ.app a).hom (MvPolynomial.X i))
  have hmap {a b : I} (f : a ⟶ b) : K a ≤ (K b).comap (C.map f).hom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change (C.map f).hom ((τ.app a).hom (MvPolynomial.X i)) ∈ K b
    have h := congrArg (fun g ↦ g.hom (MvPolynomial.X i)) (τ.naturality f).symm
    change (C.map f).hom ((τ.app a).hom (MvPolynomial.X i)) =
      (τ.app b).hom (MvPolynomial.X i) at h
    rw [h]
    exact Ideal.subset_span (Set.mem_range_self i)
  let D : I ⥤ CommAlgCat.{u} k₀ :=
    { obj a := CommAlgCat.of k₀ (C.obj a ⧸ K a)
      map f := CommAlgCat.ofHom (Ideal.quotientMapₐ _ (C.map f).hom (hmap f))
      map_id a := by
        ext x
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
        change Ideal.Quotient.mk (K a) ((C.map (𝟙 a)).hom x) = _
        simp
      map_comp f g := by
        ext x
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
        change Ideal.Quotient.mk _ ((C.map (f ≫ g)).hom x) =
          Ideal.Quotient.mk _ ((C.map g).hom ((C.map f).hom x))
        rw [C.map_comp]
        rfl }
  let q : C ⟶ D :=
    { app a := CommAlgCat.ofHom (Ideal.Quotient.mkₐ k₀ (K a))
      naturality a b f := by ext x; rfl }
  let ρ : B →ₐ[k₀] ResidueField B := Ideal.Quotient.mkₐ k₀ (maximalIdeal B)
  have hkill (a : I) : K a ≤ RingHom.ker (ρ.comp (β.app a).hom).toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change residue B ((β.app a).hom ((τ.app a).hom (MvPolynomial.X i))) = 0
    have ht := DFunLike.congr_fun (hcompat a) (MvPolynomial.X i)
    change (β.app a).hom ((τ.app a).hom (MvPolynomial.X i)) =
      (MvPolynomial.aeval (R := k₀) t) (MvPolynomial.X i) at ht
    rw [MvPolynomial.aeval_X] at ht
    rw [ht, residue_eq_zero_iff, ← hgen]
    exact Ideal.subset_span (Set.mem_range_self i)
  let γ : D ⟶ (Functor.const I).obj (CommAlgCat.of k₀ (ResidueField B)) :=
    { app a := CommAlgCat.ofHom (Ideal.Quotient.liftₐ (K a)
        (ρ.comp (β.app a).hom) (fun x hx ↦ hkill a hx))
      naturality a b f := by
        ext x
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact congrArg (fun g ↦ residue B (g.hom x)) (β.naturality f) }
  have hne (a : I) : Nontrivial (D.obj a) := by
    apply nontrivial_of_ne (0 : D.obj a) 1
    intro hz
    have h := congrArg (γ.app a).hom hz
    exact (zero_ne_one : (0 : ResidueField B) ≠ 1)
      (by simpa only [map_zero, map_one] using h)
  have hstage (a : I) :=
    smooth_polynomial_parameter_stage k₀ (C.obj a) d (τ.app a).hom (hsmooth a) (hne a)
  refine ⟨fun a ↦ (hstage a).1, D, q, γ, ?_, ?_, ?_, ?_⟩
  · intro a
    exact ⟨AlgEquiv.refl, fun _ ↦ rfl⟩
  · intro a
    exact ⟨hne a, (hstage a).2⟩
  · let c : Cocone (C ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u}) :=
      { pt := CommRingCat.of B
        ι := Functor.whiskerRight β (forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u}) }
    let hc : IsColimit c := hcolim.some
    let pull (s : Cocone (D ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u})) :
        Cocone (C ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u}) :=
      { pt := s.pt
        ι :=
          { app a := CommRingCat.ofHom ((s.ι.app a).hom.comp (Ideal.Quotient.mk (K a)))
            naturality a b f := by
              ext x
              exact congrArg (fun g ↦ g.hom (Ideal.Quotient.mk (K a) x)) (s.w f) } }
    let g (s : Cocone (D ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u})) :
        B →+* s.pt := (hc.desc (pull s)).hom
    have hg (s : Cocone (D ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u}))
        (a : I) (x : C.obj a) :
        g s ((β.app a).hom x) = (s.ι.app a).hom (Ideal.Quotient.mk (K a) x) :=
      congrArg (fun f ↦ f.hom x) (hc.fac (pull s) a)
    have hker (s : Cocone (D ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u})) :
        maximalIdeal B ≤ RingHom.ker (g s) := by
      rw [← hgen]
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      let a : I := Classical.choice inferInstance
      have ht := DFunLike.congr_fun (hcompat a) (MvPolynomial.X i)
      change (β.app a).hom ((τ.app a).hom (MvPolynomial.X i)) =
        (MvPolynomial.aeval (R := k₀) t) (MvPolynomial.X i) at ht
      rw [MvPolynomial.aeval_X] at ht
      change g s (t i) = 0
      rw [← ht, hg]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))]
      exact map_zero _
    let desc (s : Cocone (D ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u})) :
        CommRingCat.of (ResidueField B) ⟶ s.pt :=
      CommRingCat.ofHom (Ideal.Quotient.lift _ (g s) (fun x hx ↦ hker s hx))
    have hdesc (s : Cocone (D ⋙ forget₂ (CommAlgCat.{u} k₀) CommRingCat.{u})) (x : B) :
        (desc s).hom (residue B x) = g s x := rfl
    refine ⟨{ desc := desc, fac := ?_, uniq := ?_ }⟩
    · intro s a
      ext x
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      change (desc s).hom (residue B ((β.app a).hom x)) = _
      rw [hdesc, hg]
      rfl
    · intro s m hm
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      have he : CommRingCat.ofHom (m.hom.comp (residue B)) =
          CommRingCat.ofHom ((desc s).hom.comp (residue B)) := by
        apply hc.hom_ext
        intro a
        ext x
        change m.hom (residue B ((β.app a).hom x)) =
          (desc s).hom (residue B ((β.app a).hom x))
        rw [hdesc, hg]
        exact congrArg (fun f ↦ f.hom (Ideal.Quotient.mk (K a) x)) (hm a)
      exact congrArg CommRingCat.Hom.hom he
  · intro a
    ext x
    rfl

end IsLocalRing
