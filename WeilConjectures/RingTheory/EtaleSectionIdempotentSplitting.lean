module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Localization.Away.Basic
import WeilConjectures.RingTheory.EtaleSectionCore
import WeilConjectures.RingTheory.EtaleSectionLocalization

/-!
# Idempotent splitting of an étale algebra with a section

An étale `R`-algebra `S` with an `R`-algebra section `s` splits as `R × (1 - e)S` for an
idempotent `e` with `s e = 1`, and `s` identifies the localization `S[1/e]` with `R`.

## Implementation details

The section is surjective and étale by cancellation, so its kernel is a finitely generated
idempotent ideal, generated by an idempotent `1 - e`. The map `x ↦ (s x, (1 - e) * x)` is an
algebra isomorphism with inverse `(r, y) ↦ e * algebraMap R S r + y`. A surjection with kernel
`(1 - e)` identifies its target with the localization away from `e`.

## References

* [Stacks, Tag 09XI], proof of (5) ⇒ (2), first paragraph
* [Stacks, Tag 00U7]
* [Stacks, Tag 00U8]
* [Stacks, Tag 00EH]
-/

@[expose] public section

universe u v

namespace Algebra.Etale

/-- An étale algebra with a section splits off the base ring. The complementary factor
is the corner of `1 - e`, namely `(1 - e)S` with identity `1 - e`. Its algebra map is
specified explicitly, and the localization equivalence extends the given section. -/
theorem exists_idempotent_splitting_of_algHom
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.Etale R S] (s : S →ₐ[R] R) :
    ∃ (e : S) (he : IsIdempotentElem e),
      s e = 1 ∧ RingHom.ker s.toRingHom = Ideal.span {1 - e} ∧
      (∃ (_ : Algebra R he.one_sub.Corner),
        (∀ r : R, (algebraMap R he.one_sub.Corner r).1 =
          (1 - e) * algebraMap R S r) ∧
        ∃ Φ : S ≃ₐ[R] R × he.one_sub.Corner, ∀ x : S, (Φ x).1 = s x) ∧
      (∃ ψ : Localization.Away e ≃ₐ[R] R,
        ∀ x : S, ψ (algebraMap S (Localization.Away e) x) = s x) := by
  obtain ⟨e, he, hse, hker, hprod⟩ := exists_idempotent_core s
  obtain ⟨ψ, hψ⟩ := exists_localization_equiv_of_idempotent s e he hse hker
  exact ⟨e, he, hse, hker, hprod, ⟨ψ, hψ⟩⟩

end Algebra.Etale
