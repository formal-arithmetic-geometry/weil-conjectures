import Mathlib.Tactic.Ring

/-!

# Tangent cones meeting only at the origin

Let `R` be a local ring with maximal ideal `𝔪` and `I`, `J` ideals of `R` (in the application, the
ideals of two curves through the closed point of a surface). The tangent cones of `R ⧸ I` and
`R ⧸ J` are `Spec (gr_𝔪 R / in I)` and `Spec (gr_𝔪 R / in J)`, where `in I` is the ideal of
initial forms of `I` in the associated graded ring `gr_𝔪 R = ⊕ 𝔪^N / 𝔪^(N+1)`. Their supports meet
only at the origin if and only if `in I + in J` contains every homogeneous element of large
degree, that is, if `𝔪^N ⊆ (I ∩ 𝔪^N) + (J ∩ 𝔪^N) + 𝔪^(N+1)` for all large `N`
(`IsLocalRing.TangentConesMeetAtOrigin`); this is the condition `C_t D ∩ C_t B = {0}` of
blueprint `lemma-vanishing-restrictions-after-blowing-up--1`.

-/

@[expose] public section

namespace Ideal

/-- The `N`-th power of the ideal `(x, y)` is generated by the monomials `x^i y^j`, `i + j = N`. -/
theorem span_pair_pow_le_span_monomials {R : Type*} [CommSemiring R] (x y : R) (N : ℕ) :
    span {x, y} ^ N ≤ span {z | ∃ i j, i + j = N ∧ x ^ i * y ^ j = z} := by
  induction N with
  | zero =>
    rw [pow_zero, one_eq_top, top_le_iff, eq_top_iff_one]
    exact subset_span ⟨0, 0, rfl, by simp⟩
  | succ N ih =>
    refine (mul_mono_left ih).trans ?_
    rw [span_mul_span]
    refine span_mono ?_
    rintro _ ⟨_, ⟨i, j, rfl, rfl⟩, w, hw, rfl⟩
    rcases hw with rfl | rfl
    · exact ⟨i + 1, j, by omega, by ring⟩
    · exact ⟨i, j + 1, by omega, by ring⟩

end Ideal

namespace IsLocalRing

variable (R : Type*) [CommRing R] [IsLocalRing R]

/-- The *tangent cones of `R ⧸ I` and `R ⧸ J` meet only at the origin*: the initial ideals
`in I` and `in J` in the associated graded ring `gr_𝔪 R = ⊕ 𝔪^N / 𝔪^(N+1)` together contain every
homogeneous element of large degree, i.e. `𝔪^N ⊆ (I ∩ 𝔪^N) + (J ∩ 𝔪^N) + 𝔪^(N+1)` for all large
`N`. For curves `D`, `B` through the closed point of a surface `Spec R` with ideals `I`, `J`,
this is the condition `C_t D ∩ C_t B = {0}` of blueprint
`lemma-vanishing-restrictions-after-blowing-up--1`. -/
def TangentConesMeetAtOrigin (I J : Ideal R) : Prop :=
  ∃ n : ℕ, ∀ N ≥ n, maximalIdeal R ^ N ≤
    I ⊓ maximalIdeal R ^ N ⊔ J ⊓ maximalIdeal R ^ N ⊔ maximalIdeal R ^ (N + 1)

variable {R}

theorem TangentConesMeetAtOrigin.mono {I J I' J' : Ideal R} (h : TangentConesMeetAtOrigin R I J)
    (hI : I ≤ I') (hJ : J ≤ J') : TangentConesMeetAtOrigin R I' J' := by
  obtain ⟨n, hn⟩ := h
  refine ⟨n, fun N hN => (hn N hN).trans ?_⟩
  gcongr

theorem TangentConesMeetAtOrigin.symm {I J : Ideal R} (h : TangentConesMeetAtOrigin R I J) :
    TangentConesMeetAtOrigin R J I := by
  obtain ⟨n, hn⟩ := h
  refine ⟨n, fun N hN => (hn N hN).trans_eq ?_⟩
  rw [sup_comm (I ⊓ _)]

theorem tangentConesMeetAtOrigin_comm {I J : Ideal R} :
    TangentConesMeetAtOrigin R I J ↔ TangentConesMeetAtOrigin R J I :=
  ⟨.symm, .symm⟩


/-- Multiplying an element of `I ∩ 𝔪^M + J ∩ 𝔪^M + 𝔪^(M+1)` by an element of `𝔪^k` gives an
element of `I ∩ 𝔪^(k+M) + J ∩ 𝔪^(k+M) + 𝔪^(k+M+1)`. -/
theorem mul_mem_inf_sup_inf_sup_pow {I J : Ideal R} {k M N : ℕ} {x y : R}
    (hx : x ∈ maximalIdeal R ^ k)
    (hy : y ∈ I ⊓ maximalIdeal R ^ M ⊔ J ⊓ maximalIdeal R ^ M ⊔ maximalIdeal R ^ (M + 1))
    (hN : k + M = N) :
    x * y ∈ I ⊓ maximalIdeal R ^ N ⊔ J ⊓ maximalIdeal R ^ N ⊔ maximalIdeal R ^ (N + 1) := by
  subst hN
  refine Ideal.mul_le.mp ?_ x hx y hy
  rw [Ideal.mul_sup, Ideal.mul_sup, pow_add, ← pow_add, ← pow_add, add_assoc]
  refine sup_le (sup_le ?_ ?_) le_sup_right
  · exact le_sup_of_le_left (le_sup_of_le_left (le_inf (Ideal.mul_le_right.trans inf_le_left)
      ((Ideal.mul_mono_right inf_le_right).trans_eq (pow_add _ _ _).symm)))
  · exact le_sup_of_le_left (le_sup_of_le_right (le_inf (Ideal.mul_le_right.trans inf_le_left)
      ((Ideal.mul_mono_right inf_le_right).trans_eq (pow_add _ _ _).symm)))

/-- If `f ∈ I` has leading form `x ∈ 𝔪^a`, i.e. `f - x ∈ 𝔪^(a+1)`, then
`x ∈ I ∩ 𝔪^a + J ∩ 𝔪^a + 𝔪^(a+1)`. -/
theorem mem_inf_sup_inf_sup_pow_of_sub_mem_left {I J : Ideal R} {a : ℕ} {f x : R}
    (hfI : f ∈ I) (hx : x ∈ maximalIdeal R ^ a) (hf : f - x ∈ maximalIdeal R ^ (a + 1)) :
    x ∈ I ⊓ maximalIdeal R ^ a ⊔ J ⊓ maximalIdeal R ^ a ⊔ maximalIdeal R ^ (a + 1) := by
  have hfa : f ∈ maximalIdeal R ^ a := by
    simpa using add_mem (Ideal.pow_le_pow_right a.le_succ hf) hx
  simpa using sub_mem (Ideal.mem_sup_left (Ideal.mem_sup_left (Ideal.mem_inf.mpr ⟨hfI, hfa⟩)))
    (Ideal.mem_sup_right hf)

/-- If `g ∈ J` has leading form `x ∈ 𝔪^a`, i.e. `g - x ∈ 𝔪^(a+1)`, then
`x ∈ I ∩ 𝔪^a + J ∩ 𝔪^a + 𝔪^(a+1)`. -/
theorem mem_inf_sup_inf_sup_pow_of_sub_mem_right {I J : Ideal R} {a : ℕ} {g x : R}
    (hgJ : g ∈ J) (hx : x ∈ maximalIdeal R ^ a) (hg : g - x ∈ maximalIdeal R ^ (a + 1)) :
    x ∈ I ⊓ maximalIdeal R ^ a ⊔ J ⊓ maximalIdeal R ^ a ⊔ maximalIdeal R ^ (a + 1) := by
  rw [sup_comm (I ⊓ _)]
  exact mem_inf_sup_inf_sup_pow_of_sub_mem_left hgJ hx hg

theorem monomial_mem_maximalIdeal_pow {ξ η : R} (hξ : ξ ∈ maximalIdeal R)
    (hη : η ∈ maximalIdeal R) (i j : ℕ) : ξ ^ i * η ^ j ∈ maximalIdeal R ^ (i + j) := by
  rw [pow_add]
  exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hξ i) (Ideal.pow_mem_pow hη j)

/-- The case of an axis in blueprint `lemma-tangent-cones-on-cover` (iii): if `𝔪 = (ξ, η)`,
`I` contains an element with leading form `c ξ^a` (`c` a unit) and `J` contains an element with
leading form `u η` (`u` a unit), then the tangent cones of `R ⧸ I` and `R ⧸ J` meet only at the
origin ("the zero loci of `ξ^d` and `η^d` meet only at the origin"). -/
theorem tangentConesMeetAtOrigin_of_axis {I J : Ideal R} {ξ η f g c u : R} {a : ℕ}
    (hm : maximalIdeal R = Ideal.span {ξ, η}) (hc : IsUnit c) (hu : IsUnit u)
    (hf : f - c * ξ ^ a ∈ maximalIdeal R ^ (a + 1)) (hg : g - u * η ∈ maximalIdeal R ^ 2)
    (hfI : f ∈ I) (hgJ : g ∈ J) : TangentConesMeetAtOrigin R I J := by
  have hξ : ξ ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hη : η ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hξa := (Ideal.unit_mul_mem_iff_mem _ hc).mp (mem_inf_sup_inf_sup_pow_of_sub_mem_left
    (J := J) hfI (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hξ a)) hf)
  have hη1 := (Ideal.unit_mul_mem_iff_mem _ hu).mp (mem_inf_sup_inf_sup_pow_of_sub_mem_right
    (I := I) (a := 1) hgJ (by simpa using Ideal.mul_mem_left _ u hη) hg)
  refine ⟨a, fun N hN => ?_⟩
  have hpow := Ideal.span_pair_pow_le_span_monomials ξ η N
  rw [← hm] at hpow
  refine hpow.trans (Ideal.span_le.mpr ?_)
  rintro _ ⟨i, j, hij, rfl⟩
  by_cases hi : a ≤ i
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hi
    rw [pow_add ξ, mul_assoc, mul_comm]
    exact mul_mem_inf_sup_inf_sup_pow (monomial_mem_maximalIdeal_pow hξ hη k j) hξa (by omega)
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (show 1 ≤ j by omega)
    rw [pow_add η, pow_one, mul_left_comm, mul_comm]
    exact mul_mem_inf_sup_inf_sup_pow (monomial_mem_maximalIdeal_pow hξ hη i k) hη1 (by omega)

/-- The case of a cuspidal pair in blueprint `lemma-tangent-cones-on-cover` (iii): if
`𝔪 = (ξ, η)`, `I` contains an element with leading form `c ξ^a` (`c` a unit) and `J` contains an
element with leading form `α ξ^e - β η^e` (`β` a unit), then the tangent cones of `R ⧸ I` and
`R ⧸ J` meet only at the origin ("the zero loci of `ξ^d` and `αξ^d − βη^d` meet only at the
origin"). -/
theorem tangentConesMeetAtOrigin_of_cusp {I J : Ideal R} {ξ η f g c α β : R} {a e : ℕ}
    (hm : maximalIdeal R = Ideal.span {ξ, η}) (he : 1 ≤ e) (hc : IsUnit c) (hβ : IsUnit β)
    (hf : f - c * ξ ^ a ∈ maximalIdeal R ^ (a + 1))
    (hg : g - (α * ξ ^ e - β * η ^ e) ∈ maximalIdeal R ^ (e + 1))
    (hfI : f ∈ I) (hgJ : g ∈ J) : TangentConesMeetAtOrigin R I J := by
  have hξ : ξ ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hη : η ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hξa := (Ideal.unit_mul_mem_iff_mem _ hc).mp (mem_inf_sup_inf_sup_pow_of_sub_mem_left
    (J := J) hfI (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hξ a)) hf)
  have hge := mem_inf_sup_inf_sup_pow_of_sub_mem_right (I := I) hgJ
    (sub_mem (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hξ e))
      (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hη e))) hg
  refine ⟨a + e, fun N hN => ?_⟩
  have hpow := Ideal.span_pair_pow_le_span_monomials ξ η N
  rw [← hm] at hpow
  refine hpow.trans (Ideal.span_le.mpr ?_)
  rintro _ ⟨i, j, hij, rfl⟩
  induction j using Nat.strong_induction_on generalizing i with
  | _ j ih =>
  by_cases hi : a ≤ i
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hi
    rw [pow_add ξ, mul_assoc, mul_comm]
    exact mul_mem_inf_sup_inf_sup_pow (monomial_mem_maximalIdeal_pow hξ hη k j) hξa (by omega)
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (show e ≤ j by omega)
    refine (Ideal.unit_mul_mem_iff_mem _ hβ).mp ?_
    rw [show β * (ξ ^ i * η ^ (e + k)) =
      α * (ξ ^ (i + e) * η ^ k) - ξ ^ i * η ^ k * (α * ξ ^ e - β * η ^ e) by ring]
    exact sub_mem (Ideal.mul_mem_left _ _ (ih k (by omega) (i + e) (by omega)))
      (mul_mem_inf_sup_inf_sup_pow (monomial_mem_maximalIdeal_pow hξ hη i k) hge (by omega))

end IsLocalRing
