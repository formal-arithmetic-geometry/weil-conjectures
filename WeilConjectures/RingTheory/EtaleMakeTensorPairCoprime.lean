/-!
# Making a pair coprime by a principal étale neighbourhood

Source: Stacks Project, More on Algebra, proof of Tag 07M4, the separation and
localization paragraph (blueprint: lem-weil-pbc-etale-make-tensor-pair-coprime).
-/

@[expose] public section

universe u v

namespace AlgebraicGeometry

private theorem quotient_localization_bijective
    {R : Type u} [CommRing R] (I : Ideal R) (a : R)
    (ha : Ideal.Quotient.mk I a = 1) :
    Function.Bijective (Ideal.quotientMap
      (I.map (algebraMap R (Localization.Away a)))
      (algebraMap R (Localization.Away a)) Ideal.le_comap_map) := by
  let D := Localization.Away a
  let φ := algebraMap R D
  let q := Ideal.Quotient.mk I
  let qD := Ideal.Quotient.mk (I.map φ)
  let f := Ideal.quotientMap (I.map φ) φ Ideal.le_comap_map
  let τ : D →+* R ⧸ I := IsLocalization.Away.lift a (ha ▸ isUnit_one)
  have hτ : ∀ r : R, τ (φ r) = q r := fun r => IsLocalization.Away.lift_eq _ _ r
  have hker : I.map φ ≤ RingHom.ker τ := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    change τ (φ r) = 0
    rw [hτ]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
  let g := Ideal.Quotient.lift (I.map φ) τ (fun d hd => hker hd)
  have hleft : Function.LeftInverse g f := by
    intro r
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    change τ (φ r) = q r
    exact hτ r
  have hright : Function.RightInverse g f := by
    have hcomp : f.comp τ = qD := by
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      ext r
      change f (τ (φ r)) = qD (φ r)
      rw [hτ]
      rfl
    intro d
    obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective d
    exact RingHom.congr_fun hcomp d
  exact ⟨hleft.injective, hright.surjective⟩

/-- A pair in an integral base change that is coprime modulo an extended ideal
becomes coprime after a further étale extension preserving that quotient.
Source: Stacks Project, More on Algebra, proof of Tag 07M4, the paragraph starting
with the closedness of the integral spectrum map.
(blueprint: lem-weil-pbc-etale-make-tensor-pair-coprime).

Proof: Put `S = B ⊗[A] C`, an integral `C`-algebra, and `J = (x,z)` in `S`.
Coprimality in `S/IS` says `J + IS = S`. Hence `V(J)` misses `V(IS)`.
The integral spectrum map is closed. Its image of `V(J)` therefore is closed
and misses `V(I)`: a prime above a prime containing `I` contains `IS`, and cannot
contain `J` as well. Apply the separation lemma Tag 07M3 to choose `a ∈ C`
with `a = 1 mod I` and whose image in `S` belongs to `J`. Set `D = C[a⁻¹]`
and let `ψ` be the localization map. Its spectrum map is an open immersion,
hence étale. The canonical map `C/I → D/ID` is bijective: the inverse sends
a fraction `c/aⁿ` to `c mod I`, since `a mod I = 1`; the localization and quotient
universal properties show that these maps are inverse. In `B ⊗[A] D` the image
of `a` is invertible and belongs to the ideal generated by the images of `x,z`.
Multiply the expression of this image in that ideal by its inverse to get a
Bézout identity, which is exactly the asserted coprimality. This identification
uses tensor base change associativity, taking `b ⊗ c` to `b ⊗ ψ(c)`.
This argument also covers `I = ⊤` and zero rings: then `a = 0` is allowed and
its localization is the zero ring. -/
theorem exists_etale_isCoprime_tensor_of_isCoprime_quotient
    {A : Type u} {B : Type v} {C : Type u}
    [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]
    [Algebra.IsIntegral A B] (I : Ideal C) (x z : TensorProduct A B C)
    (h : IsCoprime
      (Ideal.Quotient.mk (I.map (Algebra.TensorProduct.includeRight (R := A) (A := B))) x)
      (Ideal.Quotient.mk (I.map (Algebra.TensorProduct.includeRight (R := A) (A := B))) z)) :
    ∃ (D : Type u) (_ : CommRing D) (ψ : C →+* D),
      letI : Algebra A D := (ψ.comp (algebraMap A C)).toAlgebra;
      let ψA : C →ₐ[A] D := { ψ with commutes' := fun _ => rfl };
      Etale (Spec.map (CommRingCat.ofHom ψ)) ∧
      Function.Bijective (Ideal.quotientMap (I.map ψ) ψ Ideal.le_comap_map) ∧
      IsCoprime (Algebra.TensorProduct.map (AlgHom.id A B) ψA x)
        (Algebra.TensorProduct.map (AlgHom.id A B) ψA z) := by
  classical
  let S := TensorProduct A B C
  let ι : C →+* S := (Algebra.TensorProduct.includeRight (R := A) (A := B)).toRingHom
  let J : Ideal S := Ideal.span {x, z}
  let K := I.map ι
  let q := Ideal.Quotient.mk K
  have hι : ι.IsIntegral := by
    let : Algebra C S := ι.toAlgebra
    let comm : TensorProduct A C B →ₐ[C] S :=
      { (Algebra.TensorProduct.comm A C B).toRingEquiv.toRingHom with
        commutes' := by
          intro c
          change Algebra.TensorProduct.comm A C B (c ⊗ₜ[A] 1) = 1 ⊗ₜ[A] c
          rw [Algebra.TensorProduct.comm_tmul] }
    have : Algebra.IsIntegral C S := Algebra.IsIntegral.of_surjective comm
      (Algebra.TensorProduct.comm A C B).surjective
    exact this.1
  change IsCoprime (q x) (q z) at h
  obtain ⟨ub, vb, huv⟩ := h
  obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective ub
  obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective vb
  change q u = ub at hu
  change q v = vb at hv
  change ub * q x + vb * q z = 1 at huv
  have hw : 1 - (u * x + v * z) ∈ K := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q (1 - (u * x + v * z)) = 0
    rw [map_sub, map_one, map_add, map_mul, map_mul, hu, hv, huv, sub_self]
  have hclosed : IsClosed (PrimeSpectrum.comap ι '' PrimeSpectrum.zeroLocus (J : Set S)) :=
    (PrimeSpectrum.isClosedMap_comap_of_isIntegral ι hι) _
      (PrimeSpectrum.isClosed_zeroLocus _)
  have hdisjoint : Disjoint
      (closure (PrimeSpectrum.comap ι '' PrimeSpectrum.zeroLocus (J : Set S)))
      (PrimeSpectrum.zeroLocus (I : Set C)) := by
    rw [hclosed.closure_eq]
    apply Set.disjoint_left.mpr
    rintro p ⟨s, hs, rfl⟩ hp
    change J ≤ s.asIdeal at hs
    change I ≤ s.asIdeal.comap ι at hp
    have hK : K ≤ s.asIdeal := Ideal.map_le_iff_le_comap.mpr hp
    have hx : x ∈ s.asIdeal := hs (Ideal.subset_span (by simp))
    have hz : z ∈ s.asIdeal := hs (Ideal.subset_span (by simp))
    have hsum : u * x + v * z ∈ s.asIdeal :=
      s.asIdeal.add_mem (s.asIdeal.mul_mem_left u hx) (s.asIdeal.mul_mem_left v hz)
    have hone : (1 : S) ∈ s.asIdeal := by
      have hadd := s.asIdeal.add_mem (hK hw) hsum
      simpa only [sub_add_cancel] using hadd
    exact s.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hone)
  obtain ⟨a, ha, haJ⟩ :=
    PrimeSpectrum.exists_one_mod_mem_of_disjoint_closure_image_zeroLocus ι I J hdisjoint
  obtain ⟨r, s, hrs⟩ := Ideal.mem_span_pair.mp haJ
  let D := Localization.Away a
  let ψ := algebraMap C D
  let : Algebra A D := (ψ.comp (algebraMap A C)).toAlgebra
  let ψA : C →ₐ[A] D := { ψ with commutes' := fun _ => rfl }
  let m := Algebra.TensorProduct.map (AlgHom.id A B) ψA
  have hma : m (ι a) =
      Algebra.TensorProduct.includeRight (R := A) (A := B) (ψ a) := by
    exact AlgHom.congr_fun
      (Algebra.TensorProduct.map_comp_includeRight (AlgHom.id A B) ψA) a
  have hunit : IsUnit (m (ι a)) := by
    rw [hma]
    exact (IsLocalization.Away.algebraMap_isUnit a).map
      (Algebra.TensorProduct.includeRight (R := A) (A := B)).toRingHom
  obtain ⟨t, ht⟩ := hunit.exists_left_inv
  have hc : IsCoprime (m x) (m z) := by
    refine ⟨t * m r, t * m s, ?_⟩
    calc
      _ = t * m (r * x + s * z) := by rw [map_add, map_mul, map_mul]; ring
      _ = 1 := by rw [hrs, ht]
  refine ⟨D, inferInstance, ψ, ?_, quotient_localization_bijective I a ha, hc⟩
  infer_instance

end AlgebraicGeometry
