module

public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.Localization.Defs
public import Mathlib.LinearAlgebra.TensorProduct.Quotient

import WeilConjectures.RingTheory.BaseChangeIdealKernelGenerators
import WeilConjectures.RingTheory.LocalizationIdealKernelGenerators
import WeilConjectures.Algebra.TorOneSurjectiveChangeRings
import WeilConjectures.RingTheory.TorIdealKernelNaturality
import WeilConjectures.RingTheory.TorOneSurjectiveFlatMiddle

/-!
# Generators of the ideal-tensor kernel after localized base change

If `R/I ⊗_R M` is flat over `R/I`, then after base change to `R'` and localization, the kernel of
the multiplication map `IR' ⊗ M' → M'` is spanned by the image of the original kernel
`ker(I ⊗_R M → M)`.

## Implementation details

Stacks 00MM and 00MN give surjections `Tor_1^R(M, Q) ⊗_Q Q' → Tor_1^R(M, Q') → Tor_1^{R'}(N, Q')`
for `Q = R/I` and `Q' = R'/IR'`; under the connecting-map descriptions of Stacks 00M6 these give a
surjection `K ⊗_R R' → K_N` onto the kernel over `R'`. Exactness of localization and
compatibility of tensor products with localization carry this to the localized kernel. No
locality, Noetherianity or finiteness is used.

## References

* [Stacks, Tag 00MO] (proof, second and third paragraphs)
* [Stacks, Tags 00MM, 00MN, 00M6]
-/

@[expose] public section

universe u v w z t

open scoped TensorProduct

namespace Module

/-- The multiplication kernel after localized base change is generated by the original kernel. -/
theorem mem_span_ideal_kernel_localized_baseChange
    {R : Type u} {S : Type v} {R' : Type w} {S' : Type z}
    [CommRing R] [CommRing S] [CommRing R'] [CommRing S']
    [Algebra R S] [Algebra R R'] [Algebra S S'] [Algebra R' S'] [Algebra R S']
    [IsScalarTower R S S'] [IsScalarTower R R' S']
    (I : Ideal R)
    (M : Type t) [AddCommGroup M] [Module S M] [Module R M]
    [IsScalarTower R S M]
    (hloc : ∃ (q : S ⊗[R] R' →+* S') (W : Submonoid (S ⊗[R] R')),
      (∀ (s : S) (r' : R'), q (s ⊗ₜ[R] r') =
        algebraMap S S' s * algebraMap R' S' r') ∧
      (letI := q.toAlgebra; IsLocalization W S'))
    (hquot : Module.Flat (R ⧸ I) ((R ⧸ I) ⊗[R] M))
    (θ : I ⊗[R] M →+ (I.map (algebraMap R R')) ⊗[R'] (S' ⊗[S] M))
    (hθ : ∀ (a : I) (x : M), θ (a ⊗ₜ[R] x) =
      (⟨algebraMap R R' a, Ideal.mem_map_of_mem (algebraMap R R') a.property⟩ :
        I.map (algebraMap R R')) ⊗ₜ[R'] ((1 : S') ⊗ₜ[S] x))
    (z : (I.map (algebraMap R R')) ⊗[R'] (S' ⊗[S] M))
    (hz : TensorProduct.lift
      ((LinearMap.lsmul R' (S' ⊗[S] M)).comp (I.map (algebraMap R R')).subtype) z = 0) :
    TensorProduct.comm R' (I.map (algebraMap R R')) (S' ⊗[S] M) z ∈
      Submodule.span S'
        ((fun k : I ⊗[R] M ↦
          TensorProduct.comm R' (I.map (algebraMap R R')) (S' ⊗[S] M) (θ k)) ''
          (LinearMap.ker (TensorProduct.lift ((LinearMap.lsmul R M).comp I.subtype)) :
            Set (I ⊗[R] M))) := by
  obtain ⟨θN, hθN, hgenN⟩ := exists_baseChange_ideal_kernel_generators (R' := R') I M hquot
  obtain ⟨α, hα, hgenα⟩ := exists_localization_ideal_kernel_generators (S' := S') I M hloc
  let P := Submodule.span S'
    ((fun k : I ⊗[R] M ↦
      TensorProduct.comm R' (I.map (algebraMap R R')) (S' ⊗[S] M) (θ k)) ''
      (LinearMap.ker (TensorProduct.lift ((LinearMap.lsmul R M).comp I.subtype)) :
        Set (I ⊗[R] M)))
  have hcompat (k : I ⊗[R] M) :
      α (TensorProduct.comm R' (I.map (algebraMap R R')) (R' ⊗[R] M) (θN k)) =
        TensorProduct.comm R' (I.map (algebraMap R R')) (S' ⊗[S] M) (θ k) := by
    induction k using TensorProduct.inductionOn with
    | tmul a x => simp [hθN, hθ, hα]
    | add a b ha hb => simp [ha, hb]
  have htransport (y : (I.map (algebraMap R R')) ⊗[R'] (R' ⊗[R] M))
      (hy : TensorProduct.lift
        ((LinearMap.lsmul R' (R' ⊗[R] M)).comp
          (I.map (algebraMap R R')).subtype) y = 0) :
      α (TensorProduct.comm R' (I.map (algebraMap R R')) (R' ⊗[R] M) y) ∈ P := by
    have hmem := hgenN y hy
    refine Submodule.span_induction (p := fun x _ ↦ α x ∈ P) ?_ ?_ ?_ ?_ hmem
    · rintro x ⟨k, hk, rfl⟩
      rw [hcompat]
      exact Submodule.subset_span ⟨k, hk, rfl⟩
    · simp
    · intro x y _ _ hx hy
      simpa using P.add_mem hx hy
    · intro r x _ hx
      rw [α.map_smul]
      simpa only [IsScalarTower.algebraMap_smul] using
        P.smul_mem (algebraMap R' S' r) hx
  apply Submodule.span_le.mpr _ (hgenα z hz)
  rintro _ ⟨y, hy, rfl⟩
  exact htransport y hy

end Module
