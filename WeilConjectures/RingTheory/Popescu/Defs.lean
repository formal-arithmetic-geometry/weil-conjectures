/-!
# Definitions for Popescu's theorem

This file collects the ring-theoretic notions used in the proof of Popescu's theorem (general
Néron desingularization) following the Stacks project, Chapter "Smoothing Ring Maps".

## Main definitions

- `Algebra.EssentiallySmooth R D`: `D` is a localization of a smooth `R`-algebra.
- `Algebra.FormallySmoothAdic R S 𝔫`: formal smoothness for the `𝔫`-adic topology.
- `Algebra.singularIdeal R A`: the singular ideal `H_{A/R}` (Stacks 07C5).
- `Algebra.IsElementaryStandardElement`, `Algebra.IsStrictlyStandardElement` (Stacks 07CC).
- `Algebra.EtalePolynomialCertificate`: a polynomial inverse certificate for a system `f`.
- `Subalgebra.IsPopescuAdmissible`: the admissible Artinian subalgebras of the construction.
-/

@[expose] public section

universe u v w

open IsLocalRing

namespace Algebra

/-- An `R`-algebra `D` is *essentially smooth* if it is isomorphic, as an `R`-algebra, to a
localization `S⁻¹P` of a smooth `R`-algebra `P` at a multiplicative subset `S`.
(blueprint: `def-weil-pbc-essentially-smooth-ring-map`) -/
def EssentiallySmooth (R : Type u) [CommRing R] (D : Type v) [CommRing D] [Algebra R D] : Prop :=
  ∃ (P : Type v) (_ : CommRing P) (_ : Algebra R P) (_ : Algebra.Smooth R P) (S : Submonoid P),
    Nonempty (D ≃ₐ[R] Localization S)

/-- `S` is *formally smooth over `R` for the `𝔫`-adic topology*: every `R`-algebra map
`g : S → D/J` into a square-zero quotient which kills some power `𝔫ᵏ` (`k ≥ 1`) lifts to an
`R`-algebra map `S → D`. (blueprint: `def-weil-pbc-formally-smooth-adic`) -/
def FormallySmoothAdic (R : Type u) [CommRing R] (S : Type v) [CommRing S] [Algebra R S]
    (n : Ideal S) : Prop :=
  ∀ (D : Type v) [CommRing D] [Algebra R D] (J : Ideal D), J ^ 2 = ⊥ →
    ∀ g : S →ₐ[R] D ⧸ J, (∃ k ≥ 1, ∀ x ∈ n ^ k, g x = 0) →
      ∃ f : S →ₐ[R] D, (Ideal.Quotient.mkₐ R J).comp f = g

section Singular

variable (R : Type u) [CommRing R] (A : Type v) [CommRing A] [Algebra R A]

/-- The ring map `R → A` is *smooth at the prime `𝔮`* if `A_g` is a smooth `R`-algebra for some
`g ∉ 𝔮`. (blueprint: `def-weil-pbc-singular-ideal`) -/
def IsSmoothAtPrime (q : Ideal A) : Prop :=
  ∃ g ∉ q, Algebra.Smooth R (Localization.Away g)

/-- The *singular ideal* `H_{A/R}` of `A` over `R`: the radical of the ideal generated by the
elements `g ∈ A` such that `A_g` is a smooth `R`-algebra (Stacks 07C5).
(blueprint: `def-weil-pbc-singular-ideal`) -/
noncomputable def singularIdeal : Ideal A :=
  (Ideal.span {g : A | Algebra.Smooth R (Localization.Away g)}).radical

end Singular

section Standard

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- The common shape of the standard-element conditions: for a presentation
`e : R[x₁,…,xₙ]/(f₁,…,f_m) ≃ A` and `c ≤ min(n,m)`, the element `a` (through any of its lifts)
multiplies each `f_{c+j}` into `(f₁,…,f_c) + (f₁,…,f_m)²`. -/
def StandardRelationCondition {n m : ℕ} (f : Fin m → MvPolynomial (Fin n) R)
    (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A) (c : ℕ) (hcm : c ≤ m)
    (a : A) : Prop :=
  ∀ (a' : MvPolynomial (Fin n) R), e (Ideal.Quotient.mk _ a') = a →
    ∀ j : Fin m, c ≤ j.1 →
      a' * f j ∈ Ideal.span (Set.range fun i : Fin c ↦ f (Fin.castLE hcm i)) ⊔
        Ideal.span (Set.range f) ^ 2

/-- The image in `A` of a polynomial, through a presentation `e`. -/
noncomputable def presentationImage {n m : ℕ} {f : Fin m → MvPolynomial (Fin n) R}
    (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A)
    (g : MvPolynomial (Fin n) R) : A :=
  e (Ideal.Quotient.mk _ g)

/-- `a ∈ A` is *elementary standard in `A` over `R`* (Stacks 07CC): there are a presentation
`A ≅ R[x₁,…,xₙ]/(f₁,…,f_m)` and `c ≤ min(n,m)` such that `a` is a multiple of the `c × c`
Jacobian minor `det(∂f_j/∂x_i)_{i,j ≤ c}` and `a f_{c+j} ∈ (f₁,…,f_c) + (f₁,…,f_m)²`.
(blueprint: `def-weil-pbc-strictly-standard-element`) -/
def IsElementaryStandardElement (R : Type u) [CommRing R] {A : Type v} [CommRing A] [Algebra R A]
    (a : A) : Prop :=
  ∃ (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) R)
    (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A) (c : ℕ) (hcn : c ≤ n)
    (hcm : c ≤ m),
    (∃ a' : A, a = a' * presentationImage e
      (Matrix.det (Matrix.of fun i j : Fin c ↦
        MvPolynomial.pderiv (Fin.castLE hcn i) (f (Fin.castLE hcm j))))) ∧
    StandardRelationCondition f e c hcm a

/-- `a ∈ A` is *strictly standard in `A` over `R`* (Stacks 07CC): there are a presentation
`A ≅ R[x₁,…,xₙ]/(f₁,…,f_m)` and `c ≤ min(n,m)` such that `a` is an `A`-linear combination of the
`c × c` minors `det(∂f_j/∂x_i)_{j ≤ c, i ∈ I}` (`I ⊆ {1,…,n}`, `|I| = c`) and
`a f_{c+j} ∈ (f₁,…,f_c) + (f₁,…,f_m)²`.
(blueprint: `def-weil-pbc-strictly-standard-element`) -/
def IsStrictlyStandardElement (R : Type u) [CommRing R] {A : Type v} [CommRing A] [Algebra R A]
    (a : A) : Prop :=
  ∃ (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) R)
    (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A) (c : ℕ) (_ : c ≤ n)
    (hcm : c ≤ m),
    (∃ aI : {I : Finset (Fin n) // I.card = c} → A, a = ∑ I,
      aI I * presentationImage e (Matrix.det (Matrix.of fun i j : Fin c ↦
        MvPolynomial.pderiv (I.1.orderEmbOfFin I.2 i) (f (Fin.castLE hcm j))))) ∧
    StandardRelationCondition f e c hcm a

end Standard

/-- A *polynomial inverse certificate* for a family `f₁, …, f_m ∈ P = R[x₁,…,xₙ]` with
`J = (f₁,…,f_m)`: a family `c_{jk} ∈ P` such that `∑_j c_{jk} ∂_l f_j - δ_{kl} ∈ J` for all `k, l`
and `∑_k (∂_k f_j) ∑_a c_{ak} f_a - f_j ∈ J²` for all `j`.
(blueprint: `def-weil-pbc-etale-polynomial-certificate`) -/
structure EtalePolynomialCertificate (R : Type u) [CommRing R] {n m : ℕ}
    (f : Fin m → MvPolynomial (Fin n) R) where
  /-- The coefficients `c_{jk}`. -/
  c : Fin m → Fin n → MvPolynomial (Fin n) R
  /-- `∑_j c_{jk} ∂_l f_j ≡ δ_{kl}` modulo `J`. -/
  inverse_mem (k l : Fin n) :
    ∑ j, c j k * MvPolynomial.pderiv l (f j) - (if k = l then 1 else 0) ∈
      Ideal.span (Set.range f)
  reproduce_mem (j : Fin m) :
    ∑ k, MvPolynomial.pderiv k (f j) * (∑ a, c a k * f a) - f j ∈
      Ideal.span (Set.range f) ^ 2

end Algebra

namespace Subalgebra

variable {k : Type u} [Field k] {B : Type v} [CommRing B] [Algebra k B]

/-- A `k`-subalgebra `A ⊆ B` is *admissible relative to the ideal `𝔪 ⊆ B`* if it is an Artinian
local ring, essentially of finite type over `k`, `B` is flat over `A`, and `𝔪_A B = 𝔪`.
(blueprint: `def-weil-pbc-popescu-admissible-subalgebra`) -/
structure IsPopescuAdmissible (A : Subalgebra k B) (m : Ideal B) : Prop where
  isArtinianRing : IsArtinianRing A
  isLocalRing : IsLocalRing A
  essFiniteType : Algebra.EssFiniteType k A
  flat : Module.Flat A B
  map_maximalIdeal : (@maximalIdeal A _ isLocalRing).map (algebraMap A B) = m

end Subalgebra
