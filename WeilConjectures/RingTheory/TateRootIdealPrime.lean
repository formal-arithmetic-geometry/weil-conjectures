module

public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Ideal.GoingUp

/-!
# The prime ideal generated by a purely inseparable root

Source: Stacks Project, Tag 032P, description of the prime over the parameter.
(blueprint: lem-weil-pbc-tate-root-ideal-prime).
-/

@[expose] public section

universe u v
set_option autoImplicit false

/-- The root ideal is prime and contracts to the parameter ideal.
Source: Stacks Project, Tag 032P, the equality describing the prime over `xR`.
(blueprint: lem-weil-pbc-tate-root-ideal-prime).

Proof: Put q = p^e, which is positive. Every element a of the integral closure has
q-th power in R: its power lies in K by hypothesis and is integral, hence belongs
to R by normality. If x is zero, y is zero, and injectivity of R into L identifies
the contraction of the zero ideal with zero. Otherwise y is nonzero. An element
 a belongs to yS exactly when a^q belongs to xR. The forward direction writes
 a = ys and uses s^q in R. For the converse, a^q = xr implies (a/y)^q = r;
 the monic polynomial T^q-r makes a/y integral, so a is in yS. Since xR is
prime, this criterion proves that yS is proper and prime. For r in R, the same
criterion says r is in its contraction exactly when r^q is in xR, equivalently
r is in xR since xR is prime. -/
theorem tate_root_ideal_prime
    (R : Type u) (K L : Type v) [CommRing R] [IsDomain R]
    [Field K] [Field L] [Algebra R K] [IsFractionRing R K]
    [Algebra K L] [Algebra R L] [IsScalarTower R K L]
    (x : R) (hnormal : IsIntegrallyClosed R)
    (p : ℕ) [Fact p.Prime] [CharP K p]
    [IsDomain (R ⧸ Ideal.span ({x} : Set R))]
    (e : ℕ) (hpow : ∀ a : L, a ^ (p ^ e) ∈ (algebraMap K L).range)
    (y : integralClosure R L)
    (hy : y ^ (p ^ e) = algebraMap R (integralClosure R L) x) :
    (Ideal.span ({y} : Set (integralClosure R L))).IsPrime ∧
      (Ideal.span ({y} : Set (integralClosure R L))).comap
        (algebraMap R (integralClosure R L)) = Ideal.span ({x} : Set R)  := by
  let : IsIntegrallyClosed R := hnormal
  let S := integralClosure R L
  let P : Ideal R := Ideal.span ({x} : Set R)
  let : P.IsPrime := (Ideal.Quotient.isDomain_iff_prime P).mp inferInstance
  have hqpos : 0 < p ^ e := pow_pos (Fact.out : p.Prime).pos _
  have hinj : Function.Injective (algebraMap R S) := by
    intro a b h
    apply IsFractionRing.injective R K
    apply (algebraMap K L).injective
    have hL := congrArg Subtype.val h
    change algebraMap R L a = algebraMap R L b at hL
    simpa only [← IsScalarTower.algebraMap_apply R K L] using hL
  have hpowers : ∀ a : S, ∃ r : R, algebraMap R S r = a ^ (p ^ e) := by
    intro a
    obtain ⟨c, hc⟩ := hpow a.val
    have hiL : IsIntegral R (algebraMap K L c) := by
      rw [hc]
      exact a.property.pow _
    have hiK : IsIntegral R c :=
      (isIntegral_algebraMap_iff).mp hiL
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hiK
    refine ⟨r, ?_⟩
    apply Subtype.ext
    change algebraMap R L r = a.val ^ (p ^ e)
    rw [IsScalarTower.algebraMap_apply R K L, hr, hc]
  by_cases hyzero : y = 0
  · have hxzero : x = 0 := by
      apply hinj
      rw [← hy, hyzero, zero_pow (Nat.ne_of_gt hqpos), map_zero]
    simp only [hyzero, hxzero, Ideal.span_singleton_zero]
    refine ⟨inferInstance, ?_⟩
    ext r
    simpa only [Ideal.mem_comap, Ideal.mem_bot, map_zero] using
      (hinj.eq_iff (a := r) (b := 0))
  · obtain ⟨J, hJ, hJP⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := S) P
        (by rw [(RingHom.injective_iff_ker_eq_bot _).mp hinj]; exact bot_le)
    change J.comap (algebraMap R S) = P at hJP
    have hyJ : y ∈ J := by
      apply hJ.mem_of_pow_mem (p ^ e)
      rw [hy]
      change x ∈ J.comap (algebraMap R S)
      rw [hJP]
      exact Ideal.mem_span_singleton_self x
    have heq : Ideal.span ({y} : Set S) = J := by
      apply le_antisymm
      · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hyJ)
      · intro a ha
        obtain ⟨r, hr⟩ := hpowers a
        have hrP : r ∈ P := by
          rw [← hJP]
          change algebraMap R S r ∈ J
          rw [hr]
          exact J.pow_mem_of_mem ha _ hqpos
        obtain ⟨t, ht⟩ := Ideal.mem_span_singleton.mp hrP
        have heqL : (a.val / y.val) ^ (p ^ e) = algebraMap R L t := by
          have hynz : y.val ≠ 0 := fun h ↦ hyzero (Subtype.ext h)
          rw [div_pow, div_eq_iff (pow_ne_zero _ hynz)]
          have hmul : a ^ (p ^ e) = algebraMap R S t * y ^ (p ^ e) := by
            rw [← hr, hy, ht, map_mul, mul_comm]
          exact congrArg Subtype.val hmul
        have hint : IsIntegral R (a.val / y.val) := by
          apply IsIntegral.of_pow hqpos
          rw [heqL]
          exact isIntegral_algebraMap
        let b : S := ⟨a.val / y.val, hint⟩
        apply Ideal.mem_span_singleton.mpr
        refine ⟨b, ?_⟩
        apply Subtype.ext
        exact (mul_div_cancel₀ a.val (fun h ↦ hyzero (Subtype.ext h))).symm
    rw [heq]
    exact ⟨hJ, hJP⟩
