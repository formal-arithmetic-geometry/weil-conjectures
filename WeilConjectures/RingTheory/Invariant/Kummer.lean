/-!
# The Kummer action of `μₙ ≅ ZMod n` on `R[t] ⧸ (tⁿ - π)`

Let `R` be a ring, `π ∈ R`, `R' = R[t] ⧸ (tⁿ - π)` and `ζ ∈ R` with `ζⁿ = 1`. The group
`ZMod n` (written multiplicatively) acts on `R'` by `R`-algebra automorphisms via
`i • t = ζⁱ t` (`AdjoinRoot.kummerAction`). If `1 - ζⁱ` is a unit for `0 < i < n`, then the ring
of invariants is `R` (`AdjoinRoot.isInvariant_kummerAction`). This holds when `ζ` is the image of a
primitive `n`-th root of unity of a domain `A` in which `n` is invertible
(`IsPrimitiveRoot.isUnit_one_sub_pow`), since `∏_{0 < i < n} (1 - ζⁱ) = n`.

This is the totally ramified (tame) Kummer cover used in the trait case of the spreading theorem
for finite étale Galois covers (blueprint `sbc-thm-spreading-finite-etale-galois`).
-/

@[expose] public section

open Polynomial

/-- If `ζ` is a primitive `n`-th root of unity in a domain in which `n` is invertible, then
`1 - ζⁱ` is a unit for `0 < i < n`. -/
lemma IsPrimitiveRoot.isUnit_one_sub_pow {A : Type*} [CommRing A] [IsDomain A] {ζ : A} {n : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hn : IsUnit (n : A)) {i : ℕ} (hi0 : 0 < i) (hin : i < n) :
    IsUnit (1 - ζ ^ i) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
  have h := hζ.prod_one_sub_pow_eq_order
  rw [Nat.cast_add, Nat.cast_one, ← h] at hn
  exact isUnit_of_dvd_unit
    (Finset.dvd_prod_of_mem (fun k ↦ 1 - ζ ^ (k + 1)) (Finset.mem_range.2 (by omega))) hn

namespace AdjoinRoot

variable {R : Type*} [CommRing R] (n : ℕ) (π : R) {ζ : R}

lemma root_X_pow_sub_C_pow : root (X ^ n - C π) ^ n = of (X ^ n - C π) π := by
  have := eval₂_root (X ^ n - C π)
  rwa [eval₂_sub, eval₂_X_pow, eval₂_C, sub_eq_zero] at this

lemma pow_val_add [NeZero n] (hζ : ζ ^ n = 1) (a b : ZMod n) :
    ζ ^ (a + b).val = ζ ^ a.val * ζ ^ b.val := by
  rw [ZMod.val_add, ← pow_add, ← Nat.mod_add_div (a.val + b.val) n, pow_add, pow_mul, hζ,
    one_pow, mul_one, Nat.mod_add_div]

/-- The automorphism `t ↦ ζⁱ t` of `R[t] ⧸ (tⁿ - π)`, for `ζⁿ = 1` and `i ∈ ZMod n`. -/
noncomputable def kummerAut (hζ : ζ ^ n = 1) (i : ZMod n) :
    AdjoinRoot (X ^ n - C π) →ₐ[R] AdjoinRoot (X ^ n - C π) :=
  liftAlgHom (X ^ n - C π) (Algebra.ofId R _)
    (of (X ^ n - C π) (ζ ^ i.val) * root (X ^ n - C π)) (by
      have hz : (ζ ^ i.val) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]
      rw [eval₂_sub, eval₂_X_pow, eval₂_C, mul_pow, ← map_pow, hz, map_one, one_mul,
        root_X_pow_sub_C_pow, sub_eq_zero]
      rfl)

@[simp]
lemma kummerAut_root (hζ : ζ ^ n = 1) (i : ZMod n) :
    kummerAut n π hζ i (root (X ^ n - C π)) =
      of (X ^ n - C π) (ζ ^ i.val) * root (X ^ n - C π) :=
  liftAlgHom_root _ _ _ _

@[simp]
lemma kummerAut_of (hζ : ζ ^ n = 1) (i : ZMod n) (r : R) :
    kummerAut n π hζ i (of (X ^ n - C π) r) = of (X ^ n - C π) r :=
  liftAlgHom_of _ _ _ _ r

/-- The action of `ZMod n` (written multiplicatively) on `R[t] ⧸ (tⁿ - π)` by `i • t = ζⁱ t`. -/
@[instance_reducible]
noncomputable def kummerAction [NeZero n] (hζ : ζ ^ n = 1) :
    MulSemiringAction (Multiplicative (ZMod n)) (AdjoinRoot (X ^ n - C π)) where
  smul i x := kummerAut n π hζ i.toAdd x
  one_smul x := by
    have : kummerAut n π hζ (Multiplicative.toAdd 1) = AlgHom.id R _ :=
      algHom_ext (by simp [ZMod.val_zero])
    exact AlgHom.congr_fun this x
  mul_smul a b x := by
    have : kummerAut n π hζ (a * b).toAdd =
        (kummerAut n π hζ a.toAdd).comp (kummerAut n π hζ b.toAdd) := by
      refine algHom_ext ?_
      simp only [toAdd_mul, kummerAut_root, AlgHom.comp_apply, map_mul, kummerAut_of,
        pow_val_add n hζ]
      ring
    exact AlgHom.congr_fun this x
  smul_zero a := map_zero (kummerAut n π hζ a.toAdd)
  smul_add a := map_add (kummerAut n π hζ a.toAdd)
  smul_one a := map_one (kummerAut n π hζ a.toAdd)
  smul_mul a := map_mul (kummerAut n π hζ a.toAdd)

section Invariant

variable [NeZero n] (hζ : ζ ^ n = 1)

lemma kummerAction_smul_def (i : Multiplicative (ZMod n)) (x : AdjoinRoot (X ^ n - C π)) :
    letI := kummerAction n π hζ
    i • x = kummerAut n π hζ i.toAdd x :=
  rfl

/-- The Kummer action is by `R`-algebra automorphisms. -/
lemma smulCommClass_kummerAction :
    letI := kummerAction n π hζ
    SMulCommClass (Multiplicative (ZMod n)) R (AdjoinRoot (X ^ n - C π)) :=
  let := kummerAction n π hζ
  ⟨fun i r x ↦ map_smul (kummerAut n π hζ i.toAdd) r x⟩

/-- `i • x - x` lies in the ideal generated by `t`: the Kummer action is trivial modulo `t`. -/
lemma kummerAction_smul_sub_mem (i : Multiplicative (ZMod n)) (x : AdjoinRoot (X ^ n - C π)) :
    letI := kummerAction n π hζ
    i • x - x ∈ Ideal.span {root (X ^ n - C π)} := by
  let := kummerAction n π hζ
  obtain ⟨p, rfl⟩ := mk_surjective x
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add, smul_add, add_sub_add_comm]
    exact add_mem hp hq
  | monomial j a =>
    rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, mk_C, mk_X, kummerAction_smul_def,
      map_mul, map_pow, kummerAut_of, kummerAut_root, mul_pow]
    rcases j with _ | j
    · simp
    · have hmem := Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self (root (X ^ n - C π)))
        _ j.succ_pos
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hmem))
        (Ideal.mul_mem_left _ _ hmem)

lemma basis_powerBasis' (i : Fin (powerBasis' (monic_X_pow_sub_C π (NeZero.ne n))).dim) :
    (powerBasis' (monic_X_pow_sub_C π (NeZero.ne n))).basis i =
      root (X ^ n - C π) ^ (i : ℕ) := by
  rw [PowerBasis.basis_eq_pow, powerBasis'_gen]

omit hζ in
lemma injective_algebraMap_X_pow_sub_C [Nontrivial R] :
    Function.Injective (algebraMap R (AdjoinRoot (X ^ n - C π))) := by
  set pb := powerBasis' (monic_X_pow_sub_C π (NeZero.ne n))
  have hdim : pb.dim = n := by rw [powerBasis'_dim, natDegree_X_pow_sub_C]
  have h0 : 0 < pb.dim := by rw [hdim]; exact Nat.pos_of_ne_zero (NeZero.ne n)
  rw [injective_iff_map_eq_zero]
  intro r hr
  have := Fintype.linearIndependent_iff.1 pb.basis.linearIndependent (Pi.single ⟨0, h0⟩ r) (by
    rw [Finset.sum_eq_single ⟨0, h0⟩ (fun i _ hi ↦ by rw [Pi.single_eq_of_ne hi, zero_smul])
      (by simp), Pi.single_eq_same, basis_powerBasis', pow_zero, ← Algebra.algebraMap_eq_smul_one,
      hr]) ⟨0, h0⟩
  simpa using this

/-- **The fixed ring of the Kummer action.** If `ζⁿ = 1` and `1 - ζⁱ` is a unit for
`0 < i < n`, then the invariants of `ZMod n` acting on `R[t] ⧸ (tⁿ - π)` by `t ↦ ζ t` are `R`. -/
theorem isInvariant_kummerAction (hu : ∀ i, 0 < i → i < n → IsUnit (1 - ζ ^ i)) :
    letI := kummerAction n π hζ
    Algebra.IsInvariant R (AdjoinRoot (X ^ n - C π)) (Multiplicative (ZMod n)) := by
  let := kummerAction n π hζ
  refine ⟨fun x hx ↦ ?_⟩
  set pb := powerBasis' (monic_X_pow_sub_C π (NeZero.ne n))
  rcases subsingleton_or_nontrivial R with hR | hR
  · have h10 : (0 : AdjoinRoot (X ^ n - C π)) = 1 := by
      rw [← map_one (algebraMap R _), Subsingleton.elim (1 : R) 0, map_zero]
    have := subsingleton_of_zero_eq_one h10
    exact ⟨0, Subsingleton.elim _ _⟩
  have hdim : pb.dim = n := by rw [powerBasis'_dim, natDegree_X_pow_sub_C]
  set c := pb.basis.repr x
  have hσ : Multiplicative.ofAdd (1 : ZMod n) • x =
      ∑ i, (c i * (ζ ^ (1 : ZMod n).val) ^ (i : ℕ)) • pb.basis i := by
    conv_lhs => rw [← pb.basis.sum_repr x]
    rw [kummerAction_smul_def, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_smul, basis_powerBasis', map_pow, kummerAut_root, toAdd_ofAdd,
      mul_pow, ← map_pow, ← algebraMap_eq, ← Algebra.smul_def, smul_smul]
  have key : ∑ i, (c i * (ζ ^ (1 : ZMod n).val) ^ (i : ℕ) - c i) • pb.basis i = 0 := by
    simp_rw [sub_smul, Finset.sum_sub_distrib, ← hσ, hx, c, pb.basis.sum_repr, sub_self]
  have hc := Fintype.linearIndependent_iff.1 pb.basis.linearIndependent _ key
  have hzero (i : Fin pb.dim) (hi : (i : ℕ) ≠ 0) : c i = 0 := by
    have hin : (i : ℕ) < n := lt_of_lt_of_eq i.2 hdim
    have h1 := hc i
    rw [ZMod.val_one'' (by omega), pow_one] at h1
    have : c i * (1 - ζ ^ (i : ℕ)) = 0 := by linear_combination -h1
    exact (hu i (Nat.pos_of_ne_zero hi) hin).mul_left_eq_zero.1 this
  have h0 : 0 < pb.dim := by rw [hdim]; exact Nat.pos_of_ne_zero (NeZero.ne n)
  refine ⟨c ⟨0, h0⟩, ?_⟩
  rw [← pb.basis.sum_repr x, Finset.sum_eq_single ⟨0, h0⟩
    (fun i _ hi ↦ by rw [hzero i (fun h ↦ hi (Fin.ext h)), zero_smul]) (by simp),
    basis_powerBasis', Fin.val_mk, pow_zero, Algebra.algebraMap_eq_smul_one]

/-- The Kummer action is trivial on the residue field when `t` lies in the maximal ideal. -/
lemma residue_kummerAction_smul [IsLocalRing (AdjoinRoot (X ^ n - C π))]
    (hroot : root (X ^ n - C π) ∈ IsLocalRing.maximalIdeal (AdjoinRoot (X ^ n - C π)))
    (i : Multiplicative (ZMod n)) (x : AdjoinRoot (X ^ n - C π)) :
    letI := kummerAction n π hζ
    IsLocalRing.residue _ (i • x) = IsLocalRing.residue _ x := by
  let := kummerAction n π hζ
  rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
  exact (Ideal.span_singleton_le_iff_mem _).2 hroot (kummerAction_smul_sub_mem n π hζ i x)

end Invariant

/-- The Kummer action for (the image of) a primitive `n`-th root of unity of a domain `A` in which
`n` is invertible has fixed ring `R`. -/
theorem isInvariant_kummerAction_of_isPrimitiveRoot [NeZero n] {A : Type*} [CommRing A]
    [IsDomain A] [Algebra A R] {ζ₀ : A} (hζ₀ : IsPrimitiveRoot ζ₀ n) (hn : IsUnit (n : A)) :
    letI := kummerAction n π (ζ := algebraMap A R ζ₀) (by rw [← map_pow, hζ₀.pow_eq_one, map_one])
    Algebra.IsInvariant R (AdjoinRoot (X ^ n - C π)) (Multiplicative (ZMod n)) :=
  isInvariant_kummerAction n π _ fun _ h0 hi ↦ by
    simpa using (hζ₀.isUnit_one_sub_pow hn h0 hi).map (algebraMap A R)

section Local

variable [IsLocalRing R]

/-- The reduction `R[t] ⧸ (tⁿ - π) → κ(R)`, `t ↦ 0`, for `π` in the maximal ideal. -/
noncomputable def residueX_pow_sub_C [NeZero n] (hπ : π ∈ IsLocalRing.maximalIdeal R) :
    AdjoinRoot (X ^ n - C π) →ₐ[R] IsLocalRing.ResidueField R :=
  liftAlgHom _ (Algebra.ofId R _) 0 (by
    rw [eval₂_sub, eval₂_X_pow, eval₂_C, zero_pow (NeZero.ne n), zero_sub, neg_eq_zero]
    exact (IsLocalRing.residue_eq_zero_iff π).2 hπ)

lemma residueX_pow_sub_C_root [NeZero n] (hπ : π ∈ IsLocalRing.maximalIdeal R) :
    residueX_pow_sub_C n π hπ (root (X ^ n - C π)) = 0 :=
  liftAlgHom_root _ _ _ _

/-- Every maximal ideal of `R[t] ⧸ (tⁿ - π)` contains `t` and the kernel of the reduction to
`κ(R)`. -/
lemma ker_residueX_pow_sub_C_le [NeZero n] (hπ : π ∈ IsLocalRing.maximalIdeal R)
    (P : Ideal (AdjoinRoot (X ^ n - C π))) [hP : P.IsMaximal] :
    root (X ^ n - C π) ∈ P ∧ RingHom.ker (residueX_pow_sub_C n π hπ) ≤ P := by
  have : Module.Finite R (AdjoinRoot (X ^ n - C π)) :=
    (powerBasis' (monic_X_pow_sub_C π (NeZero.ne n))).finite
  have hcomap : P.comap (algebraMap R _) = IsLocalRing.maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal P)
  have hroot : root (X ^ n - C π) ∈ P := by
    refine hP.isPrime.mem_of_pow_mem n ?_
    rw [root_X_pow_sub_C_pow, ← algebraMap_eq, ← Ideal.mem_comap, hcomap]
    exact hπ
  refine ⟨hroot, fun x hx ↦ ?_⟩
  obtain ⟨p, rfl⟩ := mk_surjective x
  obtain ⟨q, hq⟩ := X_dvd_sub_C (p := p)
  have hx' : mk (X ^ n - C π) p = of _ (p.coeff 0) + root _ * mk _ q := by
    rw [← mk_C, ← mk_X, ← map_mul, ← hq, ← map_add, add_sub_cancel]
  rw [RingHom.mem_ker, hx', map_add, map_mul, residueX_pow_sub_C_root, zero_mul,
    add_zero] at hx
  rw [hx']
  refine add_mem ?_ (Ideal.mul_mem_right _ _ hroot)
  rw [← algebraMap_eq, ← Ideal.mem_comap, hcomap, ← IsLocalRing.residue_eq_zero_iff]
  rw [← algebraMap_eq, AlgHom.commutes] at hx
  exact hx

/-- **`R[t] ⧸ (tⁿ - π)` is local** for `R` local, `n ≠ 0` and `π` in the maximal ideal, and `t`
lies in its maximal ideal. -/
theorem isLocalRing_of_mem_maximalIdeal [NeZero n] (hπ : π ∈ IsLocalRing.maximalIdeal R) :
    IsLocalRing (AdjoinRoot (X ^ n - C π)) := by
  have hsurj : Function.Surjective (residueX_pow_sub_C n π hπ) := fun y ↦ by
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨of _ a, by rw [← algebraMap_eq, AlgHom.commutes]; rfl⟩
  have hmax := RingHom.ker_isMaximal_of_surjective _ hsurj
  exact IsLocalRing.of_unique_max_ideal ⟨_, hmax, fun P hP ↦
    (hmax.eq_of_le hP.ne_top (ker_residueX_pow_sub_C_le n π hπ P).2).symm⟩

/-- `R[t] ⧸ (tⁿ - π)` is local when `π` lies in the maximal ideal of the local ring `R`. -/
instance [NeZero n] [Fact (π ∈ IsLocalRing.maximalIdeal R)] :
    IsLocalRing (AdjoinRoot (X ^ n - C π)) :=
  isLocalRing_of_mem_maximalIdeal n π Fact.out

lemma root_mem_maximalIdeal [NeZero n] [Fact (π ∈ IsLocalRing.maximalIdeal R)] :
    root (X ^ n - C π) ∈ IsLocalRing.maximalIdeal (AdjoinRoot (X ^ n - C π)) :=
  (ker_residueX_pow_sub_C_le n π Fact.out _).1

end Local

end AdjoinRoot
