/-!
# The intersection of the p-basis coefficient subrings

Source: Stacks Project, More on Algebra, Tag 07P5, proof of the intersection,
with the coefficient argument of the parent node, steps 3(c) and 5.
-/

@[expose] public section

set_option autoImplicit false

universe u w

attribute [local instance] ZMod.algebra

namespace RingTheory

/-- An element in every field generated by the complement of a finite part of a
p-basis is a pth power.
Source: Stacks Project, More on Algebra, Tag 07P5, proof of (2), last sentence;
parent node lem-weil-pbc-power-series-subring-intersection, proof step 1.
This proves step 1 of lem-weil-pbc-power-series-subring-intersection.

Proof: The Frobenius image is a subfield of k and contains the image of ZMod p,
so it equals the intermediate field obtained by adjoining all pth powers.
Fix J. The span over this field of bounded p-basis monomials supported outside J
is a subfield. It contains 1 and is closed under sums and negatives. To multiply
monomials, add their exponents and reduce modulo p; the removed pth powers of
the t_i are scalars in the Frobenius image. For a nonzero element x of this span,
x^p is in the Frobenius image, and x⁻¹ = (x^p)⁻¹ * x^(p-1), proving closure under
inverses. This span contains the generators of kJ, and conversely each spanning
monomial belongs to kJ, so the span is precisely kJ.

Now expand c in the given basis, with finite support S. Take J to be the union
of the supports of the bounded monomials in S. Since c belongs to kJ, its basis
coordinates also vanish outside the monomials avoiding J. A monomial in S that
avoids J has empty support, hence is the constant monomial. Uniqueness of basis
coordinates thus says c is a scalar times 1, in the Frobenius image. This gives
its pth root in k. The same argument handles empty I and c=0; J is always finite,
and no finite-dimensionality hypothesis on the whole extension is needed. -/
private theorem pBasisCoefficientIntersection
    (p : ℕ) [Fact p.Prime]
    (k : Type u) [Field k] [CharP k p]
    (I : Type w) (t : I → k)
    (hpb : ∃ b : Module.Basis
      {E : I →₀ ℕ // ∀ i : I, E i < p}
      (IntermediateField.adjoin (ZMod p) (Set.range (fun x : k => x ^ p))) k,
      ∀ E, b E = (E : I →₀ ℕ).prod (fun i e => t i ^ e))
    (kJ : Finset I → Subfield k)
    (hkJ : ∀ J, kJ J = Subfield.closure
      (Set.range (fun x : k => x ^ p) ∪ {x : k | ∃ i : I, i ∉ J ∧ t i = x}))
    (c : k) (hc : ∀ J, c ∈ kJ J) :
    ∃ x : k, x ^ p = c := by
  classical
  obtain ⟨b, hb⟩ := hpb
  let P := IntermediateField.adjoin (ZMod p) (Set.range (fun x : k ↦ x ^ p))
  let B := {E : I →₀ ℕ // ∀ i : I, E i < p}
  let z : B := ⟨0, fun _ ↦ (Fact.out : p.Prime).pos⟩
  let S (J : Finset I) : Set B := {E | ∀ i ∈ J, (E : I →₀ ℕ) i = 0}
  let M (J : Finset I) : Submodule P k := Submodule.span P (b '' S J)
  have hz : b z = 1 := by simp [hb, z]
  have hone (J : Finset I) : (1 : k) ∈ M J := by
    rw [← hz]
    exact Submodule.subset_span ⟨z, fun _ _ ↦ rfl, rfl⟩
  have hpth (x : k) : x ^ p ∈ P :=
    IntermediateField.subset_adjoin (ZMod p) _ ⟨x, rfl⟩
  have hmon (J : Finset I) (d : I →₀ ℕ) (hd : ∀ i ∈ J, d i = 0) :
      d.prod (fun i e ↦ t i ^ e) ∈ M J := by
    let r : I →₀ ℕ := d.mapRange (fun e ↦ e % p) (Nat.zero_mod p)
    let E : B := ⟨r, fun i ↦ Nat.mod_lt _ (Fact.out : p.Prime).pos⟩
    let q : k := d.prod (fun i e ↦ (t i ^ p) ^ (e / p))
    have hq : q ∈ P := by
      exact P.toSubfield.prod_mem fun i _ ↦ P.toSubfield.pow_mem (hpth (t i)) _
    have he : E ∈ S J := by
      intro i hi
      simp [E, r, hd i hi]
    have hEq : d.prod (fun i e ↦ t i ^ e) = (⟨q, hq⟩ : P) • b E := by
      rw [IntermediateField.smul_def, smul_eq_mul, hb E]
      change d.prod (fun i e ↦ t i ^ e) = q * r.prod (fun i e ↦ t i ^ e)
      rw [Finsupp.prod_mapRange_index (fun i ↦ pow_zero (t i))]
      change d.prod (fun i e ↦ t i ^ e) =
        d.prod (fun i e ↦ (t i ^ p) ^ (e / p)) * d.prod (fun i e ↦ t i ^ (e % p))
      rw [← Finsupp.prod_mul]
      apply Finset.prod_congr rfl
      intro i hi
      change t i ^ d i = (t i ^ p) ^ (d i / p) * t i ^ (d i % p)
      rw [← pow_mul, ← pow_add, Nat.div_add_mod]
    rw [hEq]
    exact (M J).smul_mem _ (Submodule.subset_span ⟨E, he, rfl⟩)
  have hmul (J : Finset I) (x y : k) (hx : x ∈ M J) (hy : y ∈ M J) :
      x * y ∈ M J := by
    induction hx, hy using Submodule.span_induction₂ with
    | mem_mem x y hx hy =>
      obtain ⟨E, hE, rfl⟩ := hx
      obtain ⟨F, hF, rfl⟩ := hy
      rw [hb E, hb F, ← Finsupp.prod_add_index' (fun i ↦ pow_zero (t i))
        (fun i ↦ pow_add (t i))]
      exact hmon J (E.val + F.val) (fun i hi ↦ by simp [hE i hi, hF i hi])
    | zero_left y hy => simp
    | zero_right x hx => simp
    | add_left x₁ x₂ y hx₁ hx₂ hy h₁ h₂ => simpa [add_mul] using (M J).add_mem h₁ h₂
    | add_right x y₁ y₂ hx hy₁ hy₂ h₁ h₂ => simpa [mul_add] using (M J).add_mem h₁ h₂
    | smul_left a x y hx hy h => simpa [smul_mul_assoc] using (M J).smul_mem a h
    | smul_right a x y hx hy h => simpa [mul_smul_comm] using (M J).smul_mem a h
  have hpow (J : Finset I) (x : k) (hx : x ∈ M J) (q : ℕ) : x ^ q ∈ M J := by
    induction q with
    | zero => simpa using hone J
    | succ q hq => rw [pow_succ]; exact hmul J _ _ hq hx
  have hinv (J : Finset I) (x : k) (hx : x ∈ M J) : x⁻¹ ∈ M J := by
    by_cases hzero : x = 0
    · simp [hzero]
    let a : P := ⟨x ^ p, hpth x⟩
    have hEq : x⁻¹ = a⁻¹ • x ^ (p - 1) := by
      rw [IntermediateField.smul_def, smul_eq_mul]
      change x⁻¹ = (x ^ p)⁻¹ * x ^ (p - 1)
      apply (mul_left_cancel₀ hzero)
      rw [← mul_assoc, mul_comm x ((x ^ p)⁻¹), mul_assoc,
        ← pow_succ', Nat.sub_add_cancel (Fact.out : p.Prime).one_le,
        inv_mul_cancel₀ (pow_ne_zero p hzero), mul_inv_cancel₀ hzero]
    rw [hEq]
    exact (M J).smul_mem _ (hpow J x hx (p - 1))
  have hsub (J : Finset I) : ∀ x ∈ kJ J, x ∈ M J := by
    intro x hx
    rw [hkJ J] at hx
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      rcases hx with ⟨y, rfl⟩ | ⟨i, hi, rfl⟩
      · have hs : (⟨y ^ p, hpth y⟩ : P) • (1 : k) = y ^ p := by
          rw [IntermediateField.smul_def, smul_eq_mul, mul_one]
        change y ^ p ∈ M J
        rw [← hs]
        exact (M J).smul_mem _ (hone J)
      · have hd : ∀ j ∈ J, (Finsupp.single i 1 : I →₀ ℕ) j = 0 := by
          intro j hj
          simp [ne_of_mem_of_not_mem hj hi]
        simpa using hmon J (Finsupp.single i 1) hd
    | one => exact hone J
    | add x y hx hy h₁ h₂ => exact (M J).add_mem h₁ h₂
    | neg x hx h => exact (M J).neg_mem h
    | inv x hx h => exact hinv J x h
    | mul x y hx hy h₁ h₂ => exact hmul J x y h₁ h₂
  let J : Finset I := (b.repr c).support.biUnion (fun E ↦ E.val.support)
  have hsupport : ∀ E ∈ (b.repr c).support, E = z := by
    intro E hE
    have havoid : E ∈ S J := b.repr_support_subset_of_mem_span (S J) (hsub J c (hc J)) hE
    apply Subtype.ext
    apply Finsupp.ext
    intro i
    change E.val i = 0
    by_cases hi : i ∈ E.val.support
    · apply havoid i
      exact Finset.mem_biUnion.mpr ⟨E, hE, hi⟩
    · exact Finsupp.notMem_support_iff.mp hi
  have hrepr : b.repr c = Finsupp.single z (b.repr c z) := by
    ext E
    by_cases hE : E = z
    · subst E; simp
    · have hcE : b.repr c E = 0 := by
        by_contra hne
        exact hE (hsupport E (Finsupp.mem_support_iff.mpr hne))
      simp [hcE, hE]
  have hcP : c ∈ P := by
    rw [← b.linearCombination_repr c, hrepr]
    simp only [Finsupp.linearCombination_single, hz]
    rw [IntermediateField.smul_def, smul_eq_mul, mul_one]
    exact (b.repr c z).property
  have hPF : P.toSubfield ≤ (frobenius k p).fieldRange := by
    apply IntermediateField.adjoin_le_subfield
    · rintro _ ⟨a, rfl⟩
      apply RingHom.mem_fieldRange.mpr
      refine ⟨algebraMap (ZMod p) k a, ?_⟩
      rw [← ZMod.natCast_zmod_val a]
      simp only [map_natCast]
    · rintro _ ⟨x, rfl⟩
      exact RingHom.mem_fieldRange.mpr ⟨x, frobenius_def ..⟩
  obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp (hPF hcP)
  exact ⟨x, hx⟩


private instance seriesCharP (p : ℕ) {k : Type u} [Field k] [CharP k p]
    {σ : Type*} : CharP (MvPowerSeries σ k) p :=
  charP_of_injective_ringHom MvPowerSeries.C_injective p

private theorem exponent_eq_smul (p : ℕ) {σ : Type*} (d : σ →₀ ℕ)
    (hd : ∀ i, p ∣ d i) : ∃ e : σ →₀ ℕ, d = p • e := by
  refine ⟨d.mapRange (fun q ↦ q / p) (Nat.zero_div p), ?_⟩
  ext i
  simp only [Finsupp.mapRange_apply, Finsupp.smul_apply, smul_eq_mul]
  exact (Nat.mul_div_cancel' (hd i)).symm

private theorem series_coeff_pow_smul (p : ℕ) [Fact p.Prime]
    {k : Type u} [Field k] [CharP k p] {σ : Type*}
    (f : MvPowerSeries σ k) (a : σ →₀ ℕ) :
    MvPowerSeries.coeff (p • a) (f ^ p) = (MvPowerSeries.coeff a f) ^ p := by
  rw [← MvPowerSeries.map_frobenius_expand p (Fact.out : p.Prime).ne_zero]
  simp only [MvPowerSeries.coeff_map, MvPowerSeries.coeff_expand_smul, frobenius_def]

private theorem series_coeff_pow_zero (p : ℕ) [Fact p.Prime]
    {k : Type u} [Field k] [CharP k p] {σ : Type*}
    (f : MvPowerSeries σ k) (a : σ →₀ ℕ) (i : σ) (hi : ¬ p ∣ a i) :
    MvPowerSeries.coeff a (f ^ p) = 0 := by
  rw [← MvPowerSeries.map_frobenius_expand p (Fact.out : p.Prime).ne_zero]
  rw [MvPowerSeries.coeff_map,
    MvPowerSeries.coeff_expand_of_not_dvd p (Fact.out : p.Prime).ne_zero f hi, map_zero]

private theorem series_exists_root (p : ℕ) [Fact p.Prime]
    {k : Type u} [Field k] [CharP k p] {σ : Type*}
    (f : MvPowerSeries σ k)
    (hr : ∀ a, ∃ x : k, x ^ p = MvPowerSeries.coeff a f)
    (hd : ∀ a, MvPowerSeries.coeff a f ≠ 0 → ∀ i, p ∣ a i) :
    ∃ h : MvPowerSeries σ k, h ^ p = f := by
  classical
  let h : MvPowerSeries σ k := fun a ↦ (hr (p • a)).choose
  refine ⟨h, MvPowerSeries.ext fun a ↦ ?_⟩
  by_cases ha : ∀ i, p ∣ a i
  · obtain ⟨b, rfl⟩ := exponent_eq_smul p a ha
    rw [series_coeff_pow_smul p]
    exact (hr (p • b)).choose_spec
  · obtain ⟨i, hi⟩ := not_forall.mp ha
    rw [series_coeff_pow_zero p h a i hi]
    exact (not_ne_iff.mp fun hc ↦ hi (hd a hc i)).symm

private theorem polynomial_exists_root (p : ℕ) [Fact p.Prime]
    {k : Type u} [Field k] [CharP k p] (n m : ℕ)
    (f : MvPolynomial (Fin m) (MvPowerSeries (Fin n) k))
    (hr : ∀ a g, ∃ x : k, x ^ p = MvPowerSeries.coeff a (AddMonoidAlgebra.coeff f g))
    (hd : ∀ a g, MvPowerSeries.coeff a (AddMonoidAlgebra.coeff f g) ≠ 0 →
      (∀ i, p ∣ a i) ∧ (∀ j, p ∣ g j)) :
    ∃ h, h ^ p = f := by
  classical
  have hmon : ∀ g, ∃ h : MvPolynomial (Fin m) (MvPowerSeries (Fin n) k),
      h ^ p = MvPolynomial.monomial g (AddMonoidAlgebra.coeff f g) := by
    intro g
    by_cases hg : AddMonoidAlgebra.coeff f g = 0
    · exact ⟨0, by simp [hg, (Fact.out : p.Prime).ne_zero]⟩
    obtain ⟨c, hc⟩ := series_exists_root p (AddMonoidAlgebra.coeff f g)
      (fun a ↦ hr a g) (fun a ha ↦ (hd a g ha).1)
    have hcg : AddMonoidAlgebra.coeff f g ≠ 0 := hg
    have ha : ∃ a, MvPowerSeries.coeff a (AddMonoidAlgebra.coeff f g) ≠ 0 := by
      by_contra! h
      apply hcg
      exact MvPowerSeries.ext fun a ↦ by simpa using h a
    obtain ⟨a, ha⟩ := ha
    obtain ⟨b, hb⟩ := exponent_eq_smul p g (hd a g ha).2
    refine ⟨MvPolynomial.monomial b c, ?_⟩
    rw [MvPolynomial.monomial_pow, hc, hb]
  choose roots hroots using hmon
  refine ⟨∑ g ∈ f.support, roots g, ?_⟩
  rw [sum_pow_char]
  simp only [hroots]
  exact f.as_sum.symm

private theorem polynomial_power_coeff (p : ℕ) [Fact p.Prime]
    {k : Type u} [Field k] [CharP k p] (n m : ℕ)
    (h : MvPolynomial (Fin m) (MvPowerSeries (Fin n) k))
    (a : Fin n →₀ ℕ) (g : Fin m →₀ ℕ) :
    (∃ x : k, x ^ p = MvPowerSeries.coeff a (AddMonoidAlgebra.coeff (h ^ p) g)) ∧
    (MvPowerSeries.coeff a (AddMonoidAlgebra.coeff (h ^ p) g) ≠ 0 →
      (∀ i, p ∣ a i) ∧ (∀ j, p ∣ g j)) := by
  classical
  by_cases hc : MvPowerSeries.coeff a (AddMonoidAlgebra.coeff (h ^ p) g) = 0
  · exact ⟨⟨0, by simp [hc, (Fact.out : p.Prime).ne_zero]⟩, fun hn ↦ (hn hc).elim⟩
  have hg : ∀ j, p ∣ g j := by
    intro j
    by_contra hj
    apply hc
    rw [← MvPolynomial.map_frobenius_expand p, MvPolynomial.coeff_map,
      MvPolynomial.coeff_expand_of_not_dvd h hj, map_zero, map_zero]
  obtain ⟨b, hb⟩ := exponent_eq_smul p g hg
  have hcb : AddMonoidAlgebra.coeff (h ^ p) g = (AddMonoidAlgebra.coeff h b) ^ p := by
    rw [← MvPolynomial.map_frobenius_expand p, MvPolynomial.coeff_map, hb,
      MvPolynomial.coeff_expand_smul p (Fact.out : p.Prime).ne_zero, frobenius_def]
  have ha : ∀ i, p ∣ a i := by
    intro i
    by_contra hi
    apply hc
    rw [hcb, series_coeff_pow_zero p _ a i hi]
  obtain ⟨d, hd⟩ := exponent_eq_smul p a ha
  refine ⟨⟨MvPowerSeries.coeff d (AddMonoidAlgebra.coeff h b), ?_⟩, fun _ ↦ ⟨ha, hg⟩⟩
  rw [hcb, hd, series_coeff_pow_smul p]

/-- The intersection of the coefficient subrings is precisely the pth powers in A.
Source: Stacks Project, More on Algebra, Tag 07P5, proof of (2), last sentence;
the coefficient argument is expanded in parent node steps 3(c) and 5.
(blueprint: lem-weil-pbc-power-series-subring-intersection).

Proof: The pth powers in k form a subfield, since Frobenius is an injective ring
homomorphism. For each finite J, the k^p-span of bounded p-basis monomials whose
supports avoid J equals kJ. Indeed it contains the stated generators and is closed
under multiplication by reducing exponents modulo p. A nonzero element lies in
the span on finitely many generators outside J; this is a finite-dimensional
subring, so its injective multiplication map is surjective and its inverse lies
in the same span. Conversely all those monomials and their k^p-linear combinations
belong to kJ. If c belongs to every kJ, let J be the union of the supports in its
finite p-basis expansion. Its expansion in monomials avoiding J has, by uniqueness,
no nonzero nonconstant coordinate. Thus c belongs to k^p.

If f belongs to every AJ, hAJ gives p-divisible x and y exponents and coefficients
in every kJ, hence in k^p by the preceding argument. At each pair of exponents
(pa,pg), take the unique pth root in k of that coefficient. Make the power series
with these coefficients, for each g. Only finitely many y-columns are nonzero,
because f is a polynomial and Frobenius is injective. They therefore define an
actual polynomial h in A. Coefficientwise Frobenius on power series and the
finite-sum Frobenius identity on polynomials give h^p = f. Conversely the same
identities show that every h^p has p-divisible exponents and coefficients in k^p,
which is contained in every kJ, so hAJ puts h^p in every AJ. The argument includes
empty J, empty I, and n=m=0; no uniform finite bound on power-series supports is used. -/
theorem powerSeriesSubringIntersection
    (p : ℕ) [Fact p.Prime]
    (k : Type u) [Field k] [CharP k p]
    (I : Type w) (t : I → k)
    (hpb : ∃ b : Module.Basis
      {E : I →₀ ℕ // ∀ i : I, E i < p}
      (IntermediateField.adjoin (ZMod p) (Set.range (fun x : k => x ^ p))) k,
      ∀ E, b E = (E : I →₀ ℕ).prod (fun i e => t i ^ e))
    (n m : ℕ) (kJ : Finset I → Subfield k)
    (hkJ : ∀ J, kJ J = Subfield.closure
      (Set.range (fun x : k => x ^ p) ∪ {x : k | ∃ i : I, i ∉ J ∧ t i = x}))
    (AJ : Finset I → Subring (MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)))
    (hAJ : ∀ J f, f ∈ AJ J ↔
      ∀ (a : Fin n →₀ ℕ) (g : Fin m →₀ ℕ),
        MvPowerSeries.coeff a (AddMonoidAlgebra.coeff f g) ∈ kJ J ∧
        (MvPowerSeries.coeff a (AddMonoidAlgebra.coeff f g) ≠ 0 →
          (∀ i, p ∣ a i) ∧ (∀ j, p ∣ g j))) :
    ∀ f : MvPolynomial (Fin m) (MvPowerSeries (Fin n) k),
      (∀ J, f ∈ AJ J) ↔ ∃ h, h ^ p = f := by
  intro f
  constructor
  · intro hf
    apply polynomial_exists_root p n m f
    · intro a g
      exact pBasisCoefficientIntersection p k I t hpb kJ hkJ _
        (fun J ↦ ((hAJ J f).mp (hf J) a g).1)
    · intro a g hc
      exact ((hAJ ∅ f).mp (hf ∅) a g).2 hc
  · rintro ⟨h, rfl⟩ J
    apply (hAJ J (h ^ p)).mpr
    intro a g
    obtain ⟨⟨x, hx⟩, hd⟩ := polynomial_power_coeff p n m h a g
    refine ⟨?_, hd⟩
    rw [hkJ J, ← hx]
    exact Subfield.subset_closure (Or.inl ⟨x, rfl⟩)

end RingTheory
