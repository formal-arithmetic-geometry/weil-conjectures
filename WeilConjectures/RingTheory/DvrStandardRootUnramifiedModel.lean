/-! # The unramified intermediate DVR in the standard root calculation

Source: Stacks Project, Tag 0BRM, final paragraph, and Tag 09EV.
(blueprint: lem-sbc-dvr-standard-root-unramified-model) -/

@[expose] public section
universe u
namespace RingTheory

private theorem dvr_map_injective
    (S T : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    [CommRing T] [IsDomain T] (g : S →+* T) (p : S) (hp : Irreducible p)
    (hgp : g p ≠ 0) : Function.Injective g := by
  intro x z hxz
  by_contra hne
  have hn : x - z ≠ 0 := sub_ne_zero.mpr hne
  have hz : g (x - z) = 0 := by rw [map_sub, hxz, sub_self]
  obtain ⟨n, hn⟩ := IsDiscreteValuationRing.associated_pow_irreducible hn hp
  obtain ⟨w, hw⟩ := hn.symm
  have hnot : g (p ^ n * (w : S)) ≠ 0 := by
    rw [map_mul, map_pow]
    exact mul_ne_zero (pow_ne_zero n hgp) (w.isUnit.map g).ne_zero
  exact hnot (by rw [hw]; exact hz)

/-- The unit-root calculation constructs an unramified DVR over the standard root ring.

Source: Stacks Project, Tag 0BRM, final paragraph; Tags 09EV and 09E7.
(blueprint: lem-sbc-dvr-standard-root-unramified-model)

Proof: Put R = B[t]/(t^e-pi) and D = U[Y]/(Y^e-w). The given relation
j(q)y=rho(t), raised to the e-th power, gives y^e=j(w) after cancellation;
j is injective because it agrees in F with the fraction-field embedding of U.
Thus Y -> y defines D -> T. The Kummer etale theorem makes D etale over U,
since e and w are units. Localize at the inverse image of the maximal ideal
of T, obtaining V and a local map k:V -> T. Flatness and formal unramifiedness
make V regular local, with maximal ideal generated by q. Flatness also keeps
q nonzero, so V is a DVR. The root z of D remains a unit in V. Map R to V
by t -> qz; the root equation holds and its composite with k equals rho on
constants and the root. Hence R -> V is local. Its root maps to a nonzero
uniformizer, so factorization into uniformizer powers proves injectivity.
The finite-separable-fraction lemma gives essential finite type of U/B;
composition and scalar restriction give essential finite type of V/R.
Etaleness gives separability of k(V)/k(U), and transitivity with k(U)/k(B)
gives separability of k(V)/k(B). Restricting the base along k(B) -> k(R)
gives separability over k(R). Since t maps to q times a unit, its image
generates the maximal ideal of V. The local unramified criterion gives
formal unramifiedness over R. The local map k is injective since it does
not kill q. Extend k:V -> T -> F and U -> V to the indicated fraction fields;
uniqueness of fraction-field lifts gives iV composed with iEV equals iE.
This argument covers e=1, and performs no further DVR base change. -/
theorem dvr_standard_root_unramified_model
    (B : Type u) [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    (pi : B) (hpi : Irreducible pi)
    (U : Type u) [CommRing U] [IsDomain U] [IsDiscreteValuationRing U]
    [Algebra B U] [IsLocalHom (algebraMap B U)]
    (e : ℕ) (he : IsUnit (e : B))
    (hsep : Algebra.IsSeparable (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField U))
    (E : Type u) [Field E] [Algebra (FractionRing B) E]
    [Algebra B E] [IsScalarTower B (FractionRing B) E]
    [FiniteDimensional (FractionRing B) E] [Algebra.IsSeparable (FractionRing B) E]
    [Algebra U E] [IsFractionRing U E] [IsScalarTower B U E]
    (T : Type u) [CommRing T] [IsDomain T] [IsDiscreteValuationRing T]
    (F : Type u) [Field F] [Algebra T F] [IsFractionRing T F]
    (iE : E →+* F) (j : U →+* T) (hj : IsLocalHom j)
    (hjE : ∀ c : U, algebraMap T F (j c) = iE (algebraMap U E c))
    (q : U) (hq : Irreducible q) (w : Uˣ)
    (hw : q ^ e * (w : U) = algebraMap B U pi) :
    let R := AdjoinRoot ((Polynomial.X : Polynomial B) ^ e - Polynomial.C pi)
    ∀ (hdom : IsDomain R) (hdvr : IsDiscreteValuationRing R),
    letI := hdom
    letI := hdvr
    ∀ (rho : R →+* T) (_hrho : IsLocalHom rho)
      (_hrhoB : ∀ b : B, rho (algebraMap B R b) = j (algebraMap B U b))
      (y : Tˣ)
      (_hy : j q * (y : T) = rho (AdjoinRoot.root
        ((Polynomial.X : Polynomial B) ^ e - Polynomial.C pi))),
    ∃ (V : Type u) (_ : CommRing V) (_ : IsDomain V)
      (_ : IsDiscreteValuationRing V) (aRV : Algebra R V),
    letI := aRV
    ∃ (_ : IsLocalHom (algebraMap R V)) (_ : FaithfulSMul R V)
      (_ : Algebra.EssFiniteType R V) (_ : Algebra.FormallyUnramified R V)
      (k : V →+* T) (_ : IsLocalHom k),
      (∀ r : R, k (algebraMap R V r) = rho r) ∧
      ∃ (iV : FractionRing V →+* F) (iEV : E →+* FractionRing V),
        (∀ v : V, iV (algebraMap V (FractionRing V) v) = algebraMap T F (k v)) ∧
        (∀ x : E, iV (iEV x) = iE x) := by
  classical
  have hepos : 0 < e := by
    by_contra h
    have he0 : e = 0 := Nat.eq_zero_of_not_pos h
    simp [he0] at he
  dsimp only
  intro hdom hdvr
  let := hdom
  let := hdvr
  intro rho hrho hrhoB y hy
  let f := (Polynomial.X : Polynomial B) ^ e - Polynomial.C pi
  let R := AdjoinRoot f
  have hjinj : Function.Injective j := by
    intro x z hxz
    apply IsFractionRing.injective U E
    apply iE.injective
    rw [← hjE, ← hjE, hxz]
  have hqT : j q ≠ 0 := (map_ne_zero_iff _ hjinj).mpr hq.ne_zero
  have hrel : AdjoinRoot.root f ^ e = algebraMap B R pi := by
    simpa only [f, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero, ← AdjoinRoot.algebraMap_eq] using
      AdjoinRoot.eval₂_root f
  have hypow : (y : T) ^ e = j (w : U) := by
    apply mul_left_cancel₀ (pow_ne_zero e hqT)
    rw [← mul_pow, hy, ← map_pow, hrel, hrhoB, ← hw, map_mul, map_pow]
  let d := (Polynomial.X : Polynomial U) ^ e - Polynomial.C (w : U)
  let D := AdjoinRoot d
  let phi : D →+* T := AdjoinRoot.lift (f := d) j (y : T) (by
    simpa only [d, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero] using hypow)
  have hphiu (c : U) : phi (algebraMap U D c) = j c := AdjoinRoot.lift_of _
  have hphiroot : phi (AdjoinRoot.root d) = (y : T) := AdjoinRoot.lift_root _
  let : Algebra.Etale U D := AdjoinRoot.etale_X_pow_sub_C hepos.ne'
    (by simpa only [map_natCast] using he.map (algebraMap B U)) w.isUnit
  let Q : Ideal D := (IsLocalRing.maximalIdeal T).comap phi
  let : Q.IsPrime := Ideal.IsPrime.comap phi
  let V := Localization.AtPrime Q
  let k : V →+* T := IsLocalization.lift (fun s : Q.primeCompl ↦
    show IsUnit (phi s) from by
      have hs := s.2
      change ¬ ¬ IsUnit (phi (s : D)) at hs
      exact not_not.mp hs)
  have hkD (c : D) : k (algebraMap D V c) = phi c := IsLocalization.lift_eq _ _
  have hkU (c : U) : k (algebraMap U V c) = j c := by
    rw [IsScalarTower.algebraMap_apply U D V, hkD, hphiu]
  have hklocal : IsLocalHom k := by
    constructor
    intro z hz
    obtain ⟨x, s, rfl⟩ := IsLocalization.exists_mk'_eq Q.primeCompl z
    apply (IsLocalization.AtPrime.isUnit_mk'_iff V Q x s).mpr
    intro hx
    have hxunit : IsUnit (phi x) := by
      rw [← hkD, ← IsLocalization.mk'_spec V x s, map_mul]
      exact hz.mul (k.isUnit_map (IsLocalization.map_units V s))
    exact hx hxunit
  have hUVlocal : IsLocalHom (algebraMap U V) := by
    have hcomp : k.comp (algebraMap U V) = j := RingHom.ext hkU
    have : IsLocalHom (k.comp (algebraMap U V)) := hcomp ▸ hj
    exact isLocalHom_of_comp _ k
  let := hUVlocal
  let : Algebra.EssFiniteType U V := Algebra.EssFiniteType.comp U D V
  let : IsNoetherianRing V := Algebra.EssFiniteType.isNoetherianRing U V
  let : Module.Flat U V := Module.Flat.trans U D V
  let : Algebra.FormallyUnramified U V := Algebra.FormallyUnramified.comp U D V
  have hmaxUV : (IsLocalRing.maximalIdeal U).map (algebraMap U V) =
      IsLocalRing.maximalIdeal V := Algebra.FormallyUnramified.map_maximalIdeal
  let : IsRegularLocalRing U := IsRegularLocalRing.of_isIntegrallyClosed U
    (Ring.krullDimLE_iff.mp inferInstance)
  let : IsRegularLocalRing V := IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq hmaxUV
  have hqV : algebraMap U V q ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective U V)).mpr hq.ne_zero
  have hmaxV : IsLocalRing.maximalIdeal V = Ideal.span {algebraMap U V q} := by
    rw [← hmaxUV, hq.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  let : IsDiscreteValuationRing V :=
    IsDiscreteValuationRing.of_maximalIdeal_eq_span_singleton hqV hmaxV
  let z : V := algebraMap D V (AdjoinRoot.root d)
  have hzpow : z ^ e = algebraMap U V (w : U) := by
    have hrelD : AdjoinRoot.root d ^ e = algebraMap U D (w : U) := by
      simpa only [d, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, sub_eq_zero, ← AdjoinRoot.algebraMap_eq] using
        AdjoinRoot.eval₂_root d
    rw [show z ^ e = algebraMap D V (AdjoinRoot.root d ^ e) from (map_pow _ _ _).symm,
      hrelD, ← IsScalarTower.algebraMap_apply U D V]
  have hzunit : IsUnit z := (isUnit_pow_iff hepos.ne').mp
    (hzpow ▸ w.isUnit.map (algebraMap U V))
  let t : V := algebraMap U V q * z
  have htpow : t ^ e = algebraMap B V pi := by
    rw [mul_pow, hzpow, ← map_pow, ← map_mul, hw]
    rfl
  let rv : R →+* V := AdjoinRoot.lift (f := f) (algebraMap B V) t (by
    simpa only [f, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero] using htpow)
  have hrvB (b : B) : rv (algebraMap B R b) = algebraMap B V b := AdjoinRoot.lift_of _
  have hrvroot : rv (AdjoinRoot.root f) = t := AdjoinRoot.lift_root _
  have hkrv : k.comp rv = rho := by
    apply AdjoinRoot.ringHom_ext
    · ext b
      change k (rv (algebraMap B R b)) = rho (algebraMap B R b)
      rw [hrvB, hrhoB, IsScalarTower.algebraMap_apply B U V, hkU]
    · change k (rv (AdjoinRoot.root f)) = rho (AdjoinRoot.root f)
      rw [hrvroot, map_mul, hkU, show k z = (y : T) from (hkD _).trans hphiroot, hy]
  let : Algebra R V := rv.toAlgebra
  have hRVlocal : IsLocalHom (algebraMap R V) := by
    have : IsLocalHom (k.comp rv) := hkrv.symm ▸ hrho
    exact isLocalHom_of_comp rv k
  let := hRVlocal
  obtain ⟨_, _, hmaxR⟩ :=
    AlgebraicGeometry.Scheme.dvr_uniformizer_root_algebra B pi hpi e hepos
  have htR : Irreducible (AdjoinRoot.root f) :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmaxR
  have hrvInj : Function.Injective rv := dvr_map_injective R V rv _ htR (by
    rw [hrvroot]
    exact mul_ne_zero hqV hzunit.ne_zero)
  let : FaithfulSMul R V := (faithfulSMul_iff_algebraMap_injective R V).mpr hrvInj
  have : IsScalarTower B R V := IsScalarTower.of_algebraMap_eq (fun b ↦ (hrvB b).symm)
  let : IsLocalHom (algebraMap B V) := by
    change IsLocalHom ((algebraMap U V).comp (algebraMap B U))
    infer_instance
  let : IsLocalHom (algebraMap B R) := by
    have hcomp : rv.comp (algebraMap B R) = algebraMap B V := RingHom.ext hrvB
    have : IsLocalHom (rv.comp (algebraMap B R)) := hcomp.symm ▸ inferInstance
    exact isLocalHom_of_comp _ rv
  let : Algebra.EssFiniteType B U := dvr_finite_separable_fraction_essFiniteType B U E
  let : Algebra.EssFiniteType B V := Algebra.EssFiniteType.comp B U V
  let : Algebra.EssFiniteType R V := Algebra.EssFiniteType.of_comp B R V
  let : Algebra.IsSeparable (IsLocalRing.ResidueField B)
      (IsLocalRing.ResidueField U) := hsep
  let : Algebra.IsSeparable (IsLocalRing.ResidueField B)
      (IsLocalRing.ResidueField V) := Algebra.IsSeparable.trans
    (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField U) (IsLocalRing.ResidueField V)
  let : Algebra.IsSeparable (IsLocalRing.ResidueField R)
      (IsLocalRing.ResidueField V) := Algebra.isSeparable_tower_top_of_isSeparable
    (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField V)
  have hmaxRV : (IsLocalRing.maximalIdeal R).map (algebraMap R V) =
      IsLocalRing.maximalIdeal V := by
    rw [hmaxR, Ideal.map_span, Set.image_singleton]
    change Ideal.span {rv (AdjoinRoot.root f)} = IsLocalRing.maximalIdeal V
    rw [hrvroot, hmaxV]
    exact Ideal.span_singleton_mul_right_unit hzunit _
  let : Algebra.FormallyUnramified R V := Algebra.FormallyUnramified.of_map_maximalIdeal hmaxRV
  have hqVirr : Irreducible (algebraMap U V q) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hqV hmaxV
  have hkinj : Function.Injective k := dvr_map_injective V T k _ hqVirr (by
    rw [hkU]
    exact hqT)
  let kF : V →+* F := (algebraMap T F).comp k
  have hkFinj : Function.Injective kF := (IsFractionRing.injective T F).comp hkinj
  let iV : FractionRing V →+* F := IsFractionRing.lift hkFinj
  have hiV (v : V) : iV (algebraMap V (FractionRing V) v) = algebraMap T F (k v) :=
    IsFractionRing.lift_algebraMap _ _
  let uL : U →+* FractionRing V :=
    (algebraMap V (FractionRing V)).comp (algebraMap U V)
  have huLinj : Function.Injective uL := (IsFractionRing.injective V (FractionRing V)).comp
    (FaithfulSMul.algebraMap_injective U V)
  let iEV : E →+* FractionRing V := IsFractionRing.lift huLinj
  have hiEV (c : U) : iEV (algebraMap U E c) =
      algebraMap V (FractionRing V) (algebraMap U V c) := IsFractionRing.lift_algebraMap _ _
  have hfield : iV.comp iEV = iE := by
    apply IsFractionRing.ringHom_ext (A := U)
    intro c
    rw [RingHom.comp_apply, hiEV, hiV, hkU, hjE]
  refine ⟨V, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, k, hklocal, ?_,
    iV, iEV, hiV, ?_⟩
  · exact RingHom.congr_fun hkrv
  · exact RingHom.congr_fun hfield

end RingTheory
