/-! # A unit-root algebra localized above the closed point of a DVR

Source: Stacks Project, Tag 0BRM, first claim of the proof; Tag 00PD, the DVR criterion.
(blueprint: lem-sbc-dvr-unit-root-at-prime) -/

@[expose] public section

universe u
namespace RingTheory

private theorem factor_of_bound {S : Type*} [CommRing S] [IsLocalRing S]
    (a : S) (hm : IsLocalRing.maximalIdeal S = Ideal.span {a}) (N : ℕ) :
    ∀ x : S, x ∉ IsLocalRing.maximalIdeal S ^ N →
      ∃ n : ℕ, ∃ y : S, IsUnit y ∧ x = a ^ n * y := by
  induction N with
  | zero => simp
  | succ N ih =>
    intro x hx
    by_cases hu : IsUnit x
    · exact ⟨0, x, hu, by simp⟩
    have hxmem : x ∈ IsLocalRing.maximalIdeal S := by
      simpa [IsLocalRing.mem_maximalIdeal] using hu
    rw [hm, Ideal.mem_span_singleton] at hxmem
    obtain ⟨y, hy⟩ := hxmem
    have hynot : y ∉ IsLocalRing.maximalIdeal S ^ N := by
      intro hyN
      apply hx
      rw [hy, pow_succ']
      exact Ideal.mul_mem_mul (by rw [hm]; exact Ideal.subset_span (by simp)) hyN
    obtain ⟨n, z, hz, hzy⟩ := ih y hynot
    refine ⟨n + 1, z, hz, ?_⟩
    rw [hy, hzy, pow_succ']
    ring

private theorem factor_nonzero {S : Type*} [CommRing S] [IsLocalRing S]
    [IsHausdorff (IsLocalRing.maximalIdeal S) S]
    (a : S) (hm : IsLocalRing.maximalIdeal S = Ideal.span {a})
    (x : S) (hx : x ≠ 0) : ∃ n : ℕ, ∃ y : S, IsUnit y ∧ x = a ^ n * y := by
  have hex : ∃ N : ℕ, x ∉ IsLocalRing.maximalIdeal S ^ N := by
    by_contra! h
    apply hx
    apply IsHausdorff.haus' (I := IsLocalRing.maximalIdeal S)
    intro N
    apply SModEq.zero.mpr
    simpa using h N
  obtain ⟨N, hN⟩ := hex
  exact factor_of_bound a hm N x hN

/-- A prime localization of a unit-root algebra above the closed point is a DVR.

Source: Stacks Project, Tag 0BRM, first claim of the proof; Tag 00PD, the DVR criterion.
(blueprint: lem-sbc-dvr-unit-root-at-prime)

Proof: Write P = X^e-v and B = R[X]/(P). Since e>0, P is monic of positive
degree and B is finite free over R. The root is a unit, since its e-th power
is the unit v. Its derivative e*X^(e-1) is therefore a unit, so B is finite
etale over R. Let L=B_q. The assumption on the contraction of q says that
R -> L is local. This map is flat, being a composite of a finite free map
and a localization, and is faithfully flat since it is local; in particular
it is injective. Choose a uniformizer pi of R. Flatness makes its image a
nonzerodivisor in L. The quotient L/pi L is the localization of the finite
etale residue algebra B/pi B at the prime induced by q. A finite etale
algebra over a field is a product of finite separable fields; this
localization is one of those fields. Hence the maximal ideal of L is
pi L. The ring L is Noetherian (B is finite over the Noetherian ring R),
and pi is a nonzero nonunit. Krull intersection implies that any nonzero
x misses some power of the maximal ideal. Induction on such a bound,
factoring out pi whenever the element is a nonunit, writes x=pi^n*u with
u a unit. Cancelling pi^n proves that a product of two nonzero elements
cannot vanish, so L is a domain. Its maximal ideal is generated by the
nonzero nonunit pi, so pi is irreducible. The preceding unit-times-power
factorization is the DVR criterion of Tag 00PD. The same closed-fibre
computation identifies its residue extension as finite separable.
The argument also covers e=1, when the root algebra is R itself. -/
theorem dvr_unit_root_atPrime
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (e : ℕ) (hepos : 0 < e) (he : IsUnit (e : R)) (v : Rˣ)
    (q : Ideal (AdjoinRoot ((Polynomial.X : Polynomial R) ^ e - Polynomial.C (v : R))))
    [q.IsPrime]
    (hq : q.comap (algebraMap R _) = IsLocalRing.maximalIdeal R) :
    ∃ hdom : IsDomain (Localization.AtPrime q),
    letI := hdom
    ∃ hdvr : IsDiscreteValuationRing (Localization.AtPrime q),
    letI := hdvr
    ∃ hlocal : IsLocalHom (algebraMap R (Localization.AtPrime q)),
    letI := hlocal
    Algebra.IsSeparable (IsLocalRing.ResidueField R)
      (IsLocalRing.ResidueField (Localization.AtPrime q)) ∧
    Function.Injective (algebraMap R (Localization.AtPrime q)) := by
  classical
  let P := (Polynomial.X : Polynomial R) ^ e - Polynomial.C (v : R)
  let B := AdjoinRoot P
  let L := Localization.AtPrime q
  have hmonic : P.Monic := Polynomial.monic_X_pow_sub_C _ hepos.ne'
  let : Module.Finite R B := hmonic.finite_adjoinRoot
  let : Module.Free R B := hmonic.free_adjoinRoot
  have hroot : AdjoinRoot.root P ^ e = algebraMap R B (v : R) := by
    simpa only [P, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero, ← AdjoinRoot.algebraMap_eq] using
      AdjoinRoot.eval₂_root P
  have hunit : IsUnit (AdjoinRoot.root P) := by
    apply (isUnit_pow_iff hepos.ne').mp
    rw [hroot]
    exact v.isUnit.map (algebraMap R B)
  have hderiv : IsUnit (Polynomial.aeval (AdjoinRoot.root P) P.derivative) := by
    have heB : IsUnit (algebraMap R B (e : R)) := he.map (algebraMap R B)
    simpa only [P, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
      Polynomial.derivative_C, sub_zero, map_mul, Polynomial.aeval_C,
      map_pow, Polynomial.aeval_X] using heB.mul (hunit.pow (e - 1))
  have : Algebra.Etale R B := by
    let E : StandardEtalePair R := ⟨P, hmonic, P.derivative, ⟨1, 0, 1, by simp⟩⟩
    have hm : E.HasMap (AdjoinRoot.root P) :=
      ⟨by simp [E, AdjoinRoot.aeval_eq], hderiv⟩
    let equiv : E.Ring ≃ₐ[R] B := .ofAlgHom
      (E.lift (AdjoinRoot.root P) hm)
      (AdjoinRoot.liftAlgHom P (Algebra.ofId R E.Ring) E.X E.hasMap_X.1)
      (AdjoinRoot.algHom_ext (by
        simp only [AlgHom.comp_apply, AdjoinRoot.liftAlgHom_root,
          StandardEtalePair.lift_X]
        rfl))
      (StandardEtalePair.hom_ext (by
        simp only [AlgHom.comp_apply, StandardEtalePair.lift_X, AlgHom.id_apply]
        exact AdjoinRoot.liftAlgHom_root _ _ _ _))
    exact Algebra.Etale.of_equiv equiv
  have hlocal : IsLocalHom (algebraMap R L) := by
    apply ((IsLocalRing.local_hom_TFAE (algebraMap R L)).out 5 1).mp
    ext x
    change algebraMap B L (algebraMap R B x) ∈ IsLocalRing.maximalIdeal L ↔ _
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff L q]
    exact SetLike.ext_iff.mp hq x
  have : Module.Flat R L := Module.Flat.trans R B L
  have : Module.FaithfullyFlat R L := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hinj : Function.Injective (algebraMap R L) := FaithfulSMul.algebraMap_injective R L
  have : IsNoetherianRing B := IsNoetherianRing.of_finite R B
  have : IsNoetherianRing L := inferInstance
  have : Algebra.EssFiniteType R L := Algebra.EssFiniteType.comp R B L
  have : Algebra.FormallyUnramified R L := Algebra.FormallyUnramified.comp R B L
  obtain ⟨pi, hpi⟩ := IsDiscreteValuationRing.exists_irreducible R
  let a : L := algebraMap R L pi
  have hm : IsLocalRing.maximalIdeal L = Ideal.span {a} := by
    rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R), hpi.maximalIdeal_eq,
      Ideal.map_span, Set.image_singleton]
  have hreg : IsLeftRegular a := by
    have h := Module.Flat.isSMulRegular_of_isRegular (M := L) (IsRegular.of_ne_zero hpi.ne_zero)
    simpa only [IsSMulRegular, IsLeftRegular, Algebra.smul_def] using h
  have : NoZeroDivisors L := by
    constructor
    intro x y hxy
    by_cases hx : x = 0
    · exact Or.inl hx
    obtain ⟨n, u, hu, hxu⟩ := factor_nonzero a hm x hx
    right
    have hzero : a ^ n * (u * y) = a ^ n * 0 := by
      rw [← mul_assoc, ← hxu, hxy, mul_zero]
    exact hu.mul_right_eq_zero.mp ((hreg.pow n) hzero)
  have hdom : IsDomain L := (isDomain_iff_noZeroDivisors_and_nontrivial L).mpr
    ⟨inferInstance, inferInstance⟩
  have hdvr : IsDiscreteValuationRing L := by
    have ha : a ≠ 0 := by
      intro ha
      exact one_ne_zero (hreg (by simp [ha]))
    apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    refine ⟨a, IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal a ha hm, ?_⟩
    intro x hx
    obtain ⟨n, y, hy, hxy⟩ := factor_nonzero a hm x hx
    obtain ⟨u, hu⟩ := hy
    refine ⟨n, u, ?_⟩
    simpa [hu, mul_comm] using hxy.symm
  exact ⟨hdom, hdvr, hlocal, inferInstance, hinj⟩

end RingTheory
