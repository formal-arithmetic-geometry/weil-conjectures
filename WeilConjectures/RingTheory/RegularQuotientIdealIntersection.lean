module

public import Mathlib.RingTheory.Regular.RegularSequence
import WeilConjectures.AlgebraicGeometry.KoszulComplex
import WeilConjectures.RingTheory.KoszulRegularSequence
import WeilConjectures.RingTheory.RegularSequenceKoszulRegular
import WeilConjectures.RingTheory.RegularQuotientIdealIntersectionAux

/-!
# Ideal intersection for a sequence regular modulo an ideal

If the images of a finite sequence `gs` in `R/I` form a regular sequence, then
`I ∩ (gs) = I · (gs)`.

## Implementation details

A regular sequence is Koszul regular (Tag 062F), hence `H₁`-regular (Tag 0CEM). For
`x ∈ I ∩ (gs)`, write `x = d₁(a)`; the reduction of `a` modulo `I` is a cycle, hence a boundary
`d₂(β)`, and subtracting `d₂` of a lift of `β` gives coefficients in `I`. For the empty sequence
both sides are zero.

## References

* [Stacks, Tag 0665]
* [Stacks, Tags 062F, 0CEM]
-/

@[expose] public section

universe u

namespace Ideal

/-- If the images of a finite sequence `gs` in `R/I` form a regular sequence, the
intersection of `I` with the ideal generated by `gs` is their ideal product. -/
theorem inf_ofList_eq_mul_of_regular_quotient {R : Type u} [CommRing R]
    (I : Ideal R) (gs : List R)
    (hgs : RingTheory.Sequence.IsRegular (R ⧸ I) (gs.map (Ideal.Quotient.mk I))) :
    I ⊓ Ideal.ofList gs = I * Ideal.ofList gs := by
  apply le_antisymm
  · exact inf_ofList_le_mul_of_regular_quotient I gs hgs
  · refine le_inf ?_ ?_
    · exact mul_le_left
    · exact mul_le_right

end Ideal
