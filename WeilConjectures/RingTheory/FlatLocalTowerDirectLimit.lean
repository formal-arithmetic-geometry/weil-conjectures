module

public import Mathlib.Algebra.Colimit.DirectLimit
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import WeilConjectures.Algebra.Category.ModuleCat.FilteredColimitFlat
import Mathlib.Algebra.Category.ModuleCat.Limits

/-!
# Direct limits of flat local towers

Source: Stacks Project, Algebra, Lemma 10.159.1 (Tag 03C3), directed-system paragraph.
-/

@[expose] public section

universe u v w

open CategoryTheory CategoryTheory.Limits

private theorem flat_directLimit
    {R : Type u} [CommRing R] {I : Type v} [Preorder I]
    [Nonempty I] [IsDirectedOrder I] (A : I → Type v)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)]
    (f : ∀ i j, i ≤ j → A i →ₐ[R] A j)
    [DirectedSystem A (fun i j h ↦ f i j h)]
    (hflat : ∀ i, (algebraMap R (A i)).Flat) :
    (algebraMap R (DirectLimit A f)).Flat := by
  classical
  let g := fun i j h ↦ (f i j h).toLinearMap
  have : DirectedSystem A (fun i j h ↦ g i j h) :=
    inferInstanceAs (DirectedSystem A (fun i j h ↦ f i j h))
  let F := ModuleCat.directLimitDiagram A g
  have : Module.Flat R (colimit F : ModuleCat R) :=
    ModuleCat.filteredColimit_flat F (fun i ↦ by
      change Module.Flat R (A i)
      exact (RingHom.flat_algebraMap_iff).mp (hflat i))
  let e : ModuleCat.of R (Module.DirectLimit A g) ≅ colimit F :=
    (ModuleCat.directLimitIsColimit A g).coconePointUniqueUpToIso
    (colimit.isColimit F)
  have : Module.Flat R (Module.DirectLimit A g) :=
    Module.Flat.of_linearEquiv (e.toLinearEquiv)
  rw [RingHom.flat_algebraMap_iff]
  exact Module.Flat.of_linearEquiv (Module.DirectLimit.linearEquiv A g).symm

namespace IsLocalRing

/-- Source: Stacks Project, Algebra, Lemma 10.159.1 (Tag 03C3), third proof paragraph.
(blueprint: lem-weil-pbc-flat-local-tower-direct-limit)

Proof: Form the direct limit of the rings and the induced map q to K. Each
nonzero image comes from a stage element outside its maximal ideal, hence a unit.
Thus q reflects units, so its domain is local. Compatibility with the map η,
whose kernel is the maximal ideal of R, makes the structural map local. The
kernel of q is the maximal ideal of the limit: q reflects units and K is a field.
The image of the maximal ideal of R lies in this kernel. Conversely, represent
a kernel element at a stage. Its representative lies in the stage's maximal
ideal, which is generated by the image of the maximal ideal of R. Mapping this
ideal to the limit proves the reverse inclusion. Finally, regard the transition
algebra maps as linear maps. The module direct limit is the categorical module
colimit, hence flat by filteredColimit_flat, and its linear equivalence with the
underlying module of the ring direct limit transfers flatness. -/
theorem flat_local_tower_directLimit
    {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type w} [Field K] (η : R →+* K)
    (hη : RingHom.ker η = maximalIdeal R)
    {I : Type v} [Preorder I] [Nonempty I] [IsDirectedOrder I]
    (A : I → Type v) [∀ i, CommRing (A i)] [∀ i, IsLocalRing (A i)]
    [∀ i, Algebra R (A i)] (f : ∀ i j, i ≤ j → A i →ₐ[R] A j)
    [DirectedSystem A (fun i j h ↦ f i j h)]
    (ψ : ∀ i, A i →+* K)
    (hψ : ∀ i j h x, ψ j (f i j h x) = ψ i x)
    (hflat : ∀ i, (algebraMap R (A i)).Flat)
    (hmax : ∀ i, (maximalIdeal R).map (algebraMap R (A i)) = maximalIdeal (A i))
    (hker : ∀ i, RingHom.ker (ψ i) = maximalIdeal (A i))
    (hcomp : ∀ i, (ψ i).comp (algebraMap R (A i)) = η) :
    ∃ (_ : IsLocalRing (DirectLimit A f)),
      IsLocalHom (algebraMap R (DirectLimit A f)) ∧
      (algebraMap R (DirectLimit A f)).Flat ∧
      (maximalIdeal R).map (algebraMap R (DirectLimit A f)) =
        maximalIdeal (DirectLimit A f) ∧
      RingHom.ker (DirectLimit.Ring.lift A f K ψ hψ) = maximalIdeal (DirectLimit A f) := by
  classical
  let S := DirectLimit A f
  let φ : R →+* S := algebraMap R S
  let q : S →+* K := DirectLimit.Ring.lift A f K ψ hψ
  have hqof (i) (a : A i) : q (DirectLimit.Ring.of A f i a) = ψ i a := rfl
  have hqcomp : q.comp φ = η := by
    ext r
    let i : I := Classical.arbitrary I
    change q (algebraMap R (DirectLimit A f) r) = η r
    rw [DirectLimit.algebraMap_def i]
    exact DFunLike.congr_fun (hcomp i) r
  have : IsLocalHom q := ⟨by
    intro x hx
    induction x using DirectLimit.induction with
    | _ i a =>
      have ha : ψ i a ≠ 0 := isUnit_iff_ne_zero.mp hx
      have hu : IsUnit a := notMem_maximalIdeal.mp (by
        rw [← hker i]
        exact ha)
      exact (DirectLimit.Ring.of A f i).isUnit_map hu⟩
  have : IsLocalRing S := q.domain_isLocalRing
  have : IsLocalHom φ := ⟨by
    intro r hr
    apply notMem_maximalIdeal.mp
    rw [← hη]
    change η r ≠ 0
    rw [← hqcomp, RingHom.comp_apply]
    exact isUnit_iff_ne_zero.mp (q.isUnit_map hr)⟩
  have hqker : RingHom.ker q = maximalIdeal S := by
    ext x
    change q x = 0 ↔ ¬ IsUnit x
    rw [← isUnit_map_iff q x, isUnit_iff_ne_zero, not_not]
  have hmap : (maximalIdeal R).map φ = maximalIdeal S := by
    rw [← hqker]
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      change q (φ r) = 0
      rw [← RingHom.comp_apply, hqcomp]
      exact (show r ∈ RingHom.ker η from hη.symm ▸ hr)
    · intro x hx
      induction x using DirectLimit.induction with
      | _ i a =>
        have ha : a ∈ maximalIdeal (A i) := by
          rw [← hker i]
          exact hx
        rw [← hmax i] at ha
        have hle : (maximalIdeal R).map (algebraMap R (A i)) ≤
            ((maximalIdeal R).map φ).comap (DirectLimit.Ring.of A f i) := by
          rw [Ideal.map_le_iff_le_comap]
          intro r hr
          rw [Ideal.mem_comap, Ideal.mem_comap]
          change DirectLimit.Ring.of A f i (algebraMap R (A i) r) ∈
            (maximalIdeal R).map φ
          change (DirectLimit.Algebra.of A f i) (algebraMap R (A i) r) ∈
            (maximalIdeal R).map φ
          rw [AlgHom.commutes]
          exact Ideal.mem_map_of_mem φ hr
        exact hle ha
  exact ⟨inferInstance, inferInstance, flat_directLimit A f hflat, hmap, hqker⟩

end IsLocalRing
