module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Extension.Basic
public import Mathlib.Algebra.Exact.Basic
import WeilConjectures.RingTheory.PolynomialCoefficientConormalInclusion
import WeilConjectures.RingTheory.ProjectiveSymmetricCoefficientIntersection

/-! # Left exactness of coefficient reduction for a projective symmetric presentation

For a split projective symmetric presentation `φ = α ∘ (reduction mod I)` of `Sym_A(I/I²)`, the
sequence `0 → Sym_A(M) ⊗_A I/I² → J/J² → L/L² → 0` of conormal modules is exact, where
`J = ker φ` and `L = ker α`.

## Implementation details

Write `A = P/I`, `M = I/I²`, `C = Sym_A(M)`, `Q = P[y]`, `B = A[y]` and `H = IQ`. Coefficient
reduction `Q → B` has kernel `H`, `H ≤ J` and `J/H = L`, so `r : J/J² → L/L²` is surjective with
kernel the image of `H/(H ∩ J²)`. On a finite principal-open free cover of `A`, adapted
coordinates make `L` generated by a regular sequence, and the regular quotient intersection
theorem gives `H ∩ J² = HJ` locally, hence globally. Since `Q` is free over `P`,
`H/HJ = C ⊗_P I = C ⊗_A (I/I²)`, which yields the injective map `i` with image `ker r`. The zero
ring needs no separate argument.

## References

* [Stacks, Tag 07CE]
* [Stacks, Tag 07CX]
* [Stacks, Tag 07D4]
-/

@[expose] public section

universe u

open scoped TensorProduct

namespace Algebra

/-- For a split projective symmetric presentation, the conormal sequence
`0 → Sym_A(M) ⊗_A I/I² → J/J² → L/L² → 0` is exact, where `J = ker φ` and `L = ker α`; the maps
are inclusion and coefficient reduction on kernel representatives. -/
theorem projective_symmetric_conormal_reduction_exact
    (P : Type u) [CommRing P] (I : Ideal P) (m : ℕ)
    [Module.Projective (P ⧸ I) I.Cotangent]
    (q : (Fin m → P ⧸ I) →ₗ[P ⧸ I] I.Cotangent) (hq : Function.Surjective q)
    (α : MvPolynomial (Fin m) (P ⧸ I) →ₐ[P ⧸ I] SymmetricAlgebra (P ⧸ I) I.Cotangent)
    (hαX : ∀ j, α (MvPolynomial.X j) =
      SymmetricAlgebra.ι (P ⧸ I) I.Cotangent (q (Pi.single j 1)))
    (φ : MvPolynomial (Fin m) P →+* SymmetricAlgebra (P ⧸ I) I.Cotangent)
    (hφeq : φ = α.toRingHom.comp (MvPolynomial.map (Ideal.Quotient.mk I)))
    (hφ : Function.Surjective φ) (hα : Function.Surjective α) :
    ∃ (i : SymmetricAlgebra (P ⧸ I) I.Cotangent ⊗[P ⧸ I] I.Cotangent
        →ₗ[SymmetricAlgebra (P ⧸ I) I.Cotangent]
          (Extension.ofSurjective φ.toIntAlgHom hφ).Cotangent)
      (r : (Extension.ofSurjective φ.toIntAlgHom hφ).Cotangent
        →ₗ[SymmetricAlgebra (P ⧸ I) I.Cotangent] (Extension.ofSurjective α hα).Cotangent),
      (∀ (c : SymmetricAlgebra (P ⧸ I) I.Cotangent) (x : I)
        (y : (Extension.ofSurjective φ.toIntAlgHom hφ).ker),
        y.1 = MvPolynomial.C x.1 →
          i (c ⊗ₜ I.toCotangent x) = c • Extension.Cotangent.mk y) ∧
      (∀ (x : (Extension.ofSurjective φ.toIntAlgHom hφ).ker)
        (y : (Extension.ofSurjective α hα).ker),
        y.1 = MvPolynomial.map (Ideal.Quotient.mk I) x.1 →
          r (Extension.Cotangent.mk x) = Extension.Cotangent.mk y) ∧
      Function.Injective i ∧ Function.Exact i r ∧ Function.Surjective r := by
  let E := Extension.ofSurjective φ.toIntAlgHom hφ
  let F := Extension.ofSurjective α.toRingHom.toIntAlgHom hα
  let π := MvPolynomial.map (Ideal.Quotient.mk I) (σ := Fin m)
  let f : E.Hom F := {
    toRingHom := π
    toRingHom_algebraMap := by intro z; simp
    algebraMap_toRingHom := by
      intro z
      change α (π z) = φ z
      exact (RingHom.congr_fun hφeq z).symm }
  have hf : Function.Surjective f :=
    MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hcomap : F.ker.comap f.toRingHom = E.ker := by
    ext z
    change α (π z) = 0 ↔ φ z = 0
    exact Iff.of_eq (congrArg (fun a ↦ a = 0) (RingHom.congr_fun hφeq z).symm)
  have hle : RingHom.ker f.toRingHom ≤ E.ker := by
    intro z hz
    change φ z = 0
    rw [hφeq]
    change α (π z) = 0
    rw [show π z = 0 from hz, map_zero]
  have heq : F.ker.comap f.toRingHom = RingHom.ker f.toRingHom ⊔ E.ker := by
    rw [hcomap, sup_eq_right.mpr hle]
  let r := Extension.Cotangent.map f
  have hr : Function.Surjective r :=
    Extension.Cotangent.map_surjective_of_comap_eq hf heq
  have hrformula : ∀ (x : E.ker) (y : F.ker), y.1 = π x.1 →
      r (Extension.Cotangent.mk x) = Extension.Cotangent.mk y := by
    intro x y hy
    rw [Extension.Cotangent.map_mk]
    congr 1
    exact Subtype.ext hy.symm
  obtain ⟨i, hi, himage, hinj⟩ := polynomial_coefficient_conormal_inclusion
    P I m (SymmetricAlgebra (P ⧸ I) I.Cotangent) α φ hφeq hφ
  have hiinj : Function.Injective i := hinj.mpr
    (projective_symmetric_coefficient_intersection P I m q hq α hαX φ hφeq)
  have hker := Extension.Cotangent.map_ker_of_surjective hf heq
  rw [inf_eq_left.mpr hle] at hker
  have hexact : Function.Exact i r := by
    intro z
    change z ∈ LinearMap.ker r ↔ z ∈ i.range
    change z ∈ (LinearMap.ker r).restrictScalars E.Ring ↔
      z ∈ i.range.restrictScalars E.Ring
    rw [hker, himage]
  exact ⟨i, r, hi, hrformula, hiinj, hexact, hr⟩

end Algebra
