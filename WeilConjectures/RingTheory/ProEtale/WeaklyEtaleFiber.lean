module

public import Mathlib.RingTheory.Etale.Weakly
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import WeilConjectures.RingTheory.ProEtale.WeakDimension

/-!
# Weakly étale algebras over a principal maximal ideal

Let `A → C` be weakly étale and let `t ∈ A` generate a maximal ideal. The fibre `C ⧸ tC` is
weakly étale over the field `A ⧸ tA`, hence absolutely flat, that is von Neumann regular
(`Algebra.WeaklyEtale.exists_sub_mul_self_mul_mem_span`). Consequently the local ring of `C` at
a prime containing `t` has maximal ideal generated by `t`
(`Algebra.WeaklyEtale.maximalIdeal_localization_eq_span`): weakly étale maps are unramified.
-/

@[expose] public section

open TensorProduct IsLocalRing

namespace Algebra.WeaklyEtale

variable {A C : Type*} [CommRing A] [CommRing C] [Algebra A C] [Algebra.WeaklyEtale A C]

/-- If `A → C` is weakly étale and `t ∈ A` generates a maximal ideal, then the fibre `C ⧸ tC`
is von Neumann regular: every `c ∈ C` satisfies `c ≡ c² b` modulo `t` for some `b`. -/
lemma exists_sub_mul_self_mul_mem_span (t : A) (ht : (Ideal.span {t}).IsMaximal) (c : C) :
    ∃ b : C, c - c * c * b ∈ Ideal.span {algebraMap A C t} := by
  let I := Ideal.span {t}
  letI : Field (A ⧸ I) := Ideal.Quotient.field I
  have : Ring.AbsolutelyFlat ((A ⧸ I) ⊗[A] C) :=
    Ring.AbsolutelyFlat.of_flat_lmul' (A ⧸ I) _ (Algebra.WeaklyEtale.flat_lmul' _ _)
  obtain ⟨y, hy⟩ := Ring.AbsolutelyFlat.exists_eq_mul_self_mul ((1 : A ⧸ I) ⊗ₜ[A] c)
  let J := Ideal.span {algebraMap A C t}
  have hIJ : I ≤ J.comap (algebraMap A C) := by
    rw [Ideal.span_le]
    rintro _ rfl
    exact Ideal.mem_span_singleton_self _
  let φ : (A ⧸ I) ⊗[A] C →ₐ[A] C ⧸ J :=
    Algebra.TensorProduct.lift (Ideal.Quotient.liftₐ I (Algebra.ofId A (C ⧸ J))
        fun a ha ↦ Ideal.Quotient.eq_zero_iff_mem.2 (hIJ ha))
      (Ideal.Quotient.mkₐ A J) fun _ _ ↦ mul_comm _ _
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (φ y)
  refine ⟨b, Ideal.Quotient.eq_zero_iff_mem.1 ?_⟩
  have h := congrArg φ hy
  simp only [map_mul, φ, Algebra.TensorProduct.lift_tmul, map_one, one_mul] at h
  rw [map_sub, map_mul, map_mul, hb]
  exact sub_eq_zero.2 h

/-- **Weakly étale maps are unramified.** If `A → C` is weakly étale, `t ∈ A` generates a maximal
ideal and `𝔮` is a prime of `C` containing `t`, then the maximal ideal of the local ring `C_𝔮` is
generated by `t`. -/
lemma maximalIdeal_localization_eq_span (t : A) (ht : (Ideal.span {t}).IsMaximal)
    (𝔮 : Ideal C) [𝔮.IsPrime] (h𝔮 : algebraMap A C t ∈ 𝔮) :
    maximalIdeal (Localization.AtPrime 𝔮) =
      Ideal.span {algebraMap A (Localization.AtPrime 𝔮) t} := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl x
    have hc : c ∈ 𝔮 := (IsLocalization.AtPrime.mk'_mem_maximal_iff _ 𝔮 c s).1 hx
    obtain ⟨b, hb⟩ := exists_sub_mul_self_mul_mem_span t ht c
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.1 hb
    have hu : IsUnit (algebraMap C (Localization.AtPrime 𝔮) (1 - c * b)) :=
      IsLocalization.map_units (Localization.AtPrime 𝔮)
        (⟨1 - c * b, fun h ↦ (‹𝔮.IsPrime›.ne_top) ((Ideal.eq_top_iff_one _).2
          (by simpa using Ideal.add_mem _ h (Ideal.mul_mem_right b _ hc)))⟩ : 𝔮.primeCompl)
    have hct : algebraMap C (Localization.AtPrime 𝔮) c * algebraMap C _ (1 - c * b) =
        algebraMap C _ z * algebraMap A (Localization.AtPrime 𝔮) t := by
      rw [← map_mul, IsScalarTower.algebraMap_apply A C, ← map_mul, hz]
      ring_nf
    have hc' : algebraMap C (Localization.AtPrime 𝔮) c =
        algebraMap A (Localization.AtPrime 𝔮) t * (algebraMap C _ z * ↑hu.unit⁻¹) := by
      have := congrArg (· * (↑hu.unit⁻¹ : Localization.AtPrime 𝔮)) hct
      simp only [mul_assoc, hu.mul_val_inv, mul_one] at this
      rw [this]
      ring
    dsimp only
    rw [IsLocalization.mk'_eq_mul_mk'_one, hc', mul_assoc]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

  · rw [Ideal.span_le, Set.singleton_subset_iff, IsScalarTower.algebraMap_apply A C,
      SetLike.mem_coe, IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔮]
    exact h𝔮

end Algebra.WeaklyEtale
