module

public import WeilConjectures.RingTheory.ProEtale.ClosedLiftStrictlyHenselian
public import Mathlib.Topology.LocallyConstant.Algebra

/-!
# Idempotents of the geometric generic fibre of a henselian lift

Let `A` be a strictly henselian local ring, `C̄` an `A`-algebra killed by the maximal ideal and
`H = H_A(C̄)` its ind-étale closed lift. For an `A`-algebra `Ω` which is a field and into which `A`
injects, every idempotent of `H ⊗_A Ω` comes from an idempotent of `H`
(`Algebra.ClosedLift.exists_includeLeft_eq_of_isIdempotentElem`): `H` is spanned over `A` by its
idempotents (`Algebra.ClosedLift.mem_span_isIdempotentElem`), and `H ⟶ H ⊗_A Ω` is injective,
`H` being flat over `A`.

Consequently ring maps from a ring additively generated by idempotents, such as the ring
`LC(S, ℤ)` of locally constant integer valued functions on a profinite set, to `H` and to
`H ⊗_A Ω` correspond (`RingHom.bijective_comp_of_forall_exists_eq`): the spaces of connected
components of `Spec H` and of `Spec (H ⊗_A Ω)` agree.

## Main results

- `TensorProduct.exists_includeLeft_eq_of_isIdempotentElem`: if `R` is spanned over `A` by
  idempotents and `R ⟶ R ⊗_A Ω` is injective, every idempotent of `R ⊗_A Ω` comes from `R`.
- `RingHom.bijective_comp_of_forall_exists_eq`: composition with an injective ring map hitting
  every idempotent is bijective on ring maps out of a ring additively generated by idempotents.
- `LocallyConstant.mem_closure_isIdempotentElem`: `LC(S, ℤ)` is additively generated by
  idempotents.
-/

@[expose] public section

universe u v w

open scoped TensorProduct

section Idempotents

variable {A : Type u} {R : Type v} {Ω : Type w} [CommRing A] [CommRing R] [Field Ω]
  [Algebra A R] [Algebra A Ω]

/-- The key step of `TensorProduct.exists_includeLeft_eq_of_isIdempotentElem`: if `y` lies in the
additive submonoid generated by the `e ⊗ ω` with `e` idempotent, then for all `c : Ω` and every
idempotent `g` of `R`, if `(g ⊗ 1) (1 ⊗ c + y)` is idempotent then it comes from an idempotent
of `R`. Induction on the generators, splitting `g` along the idempotent of a generator. -/
private lemma TensorProduct.exists_includeLeft_eq_aux
    (hinj : Function.Injective (Algebra.TensorProduct.includeLeft : R →ₐ[A] R ⊗[A] Ω))
    {y : R ⊗[A] Ω}
    (hy : y ∈ AddSubmonoid.closure {x | ∃ e : R, IsIdempotentElem e ∧ ∃ ω : Ω, x = e ⊗ₜ ω}) :
    ∀ (c : Ω) (g : R), IsIdempotentElem g →
      IsIdempotentElem ((g ⊗ₜ[A] (1 : Ω)) * (1 ⊗ₜ c + y)) →
        ∃ e : R, IsIdempotentElem e ∧ e ⊗ₜ[A] (1 : Ω) = (g ⊗ₜ[A] (1 : Ω)) * (1 ⊗ₜ c + y) := by
  -- `Q z` is the claim for `z`, for all `c` and `g`.
  let Q : R ⊗[A] Ω → Prop := fun z ↦ ∀ (c : Ω) (g : R), IsIdempotentElem g →
    IsIdempotentElem ((g ⊗ₜ[A] (1 : Ω)) * (1 ⊗ₜ c + z)) →
      ∃ e : R, IsIdempotentElem e ∧ e ⊗ₜ[A] (1 : Ω) = (g ⊗ₜ[A] (1 : Ω)) * (1 ⊗ₜ c + z)
  have hinj' (r : R) (hr : r ⊗ₜ[A] (1 : Ω) = 0) : r = 0 := hinj (by simpa using hr)
  have hQ0 : Q 0 := by
    intro c g hg hgc
    rw [add_zero, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul] at hgc ⊢
    have h : g ⊗ₜ[A] (c * c - c) = 0 := by
      rw [TensorProduct.tmul_sub]
      refine sub_eq_zero.2 ?_
      have := hgc.eq
      rwa [Algebra.TensorProduct.tmul_mul_tmul, hg.eq] at this
    by_cases hc : c * c - c = 0
    · have hc' : c * (c - 1) = 0 := by rw [mul_sub, mul_one]; exact hc
      rcases mul_eq_zero.1 hc' with rfl | hc1
      · exact ⟨0, IsIdempotentElem.zero, by simp⟩
      · obtain rfl : c = 1 := sub_eq_zero.1 hc1
        exact ⟨g, hg, rfl⟩
    · refine ⟨0, IsIdempotentElem.zero, ?_⟩
      have hg0 : g = 0 := by
        refine hinj' g ?_
        have : g ⊗ₜ[A] (1 : Ω) = (g ⊗ₜ[A] (c * c - c)) * (1 ⊗ₜ (c * c - c)⁻¹) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_inv_cancel₀ hc]
        rw [this, h, zero_mul]
      simp [hg0]
  -- `Q' y`: adding `y` preserves `Q`.
  let Q' : R ⊗[A] Ω → Prop := fun y ↦ ∀ z, Q z → Q (z + y)
  have hQ' : Q' y := by
    induction hy using AddSubmonoid.closure_induction with
    | mem x hx =>
      obtain ⟨e, he, ω, rfl⟩ := hx
      intro z hz c g hg hgz
      set W := (1 : R) ⊗ₜ[A] c + (z + e ⊗ₜ ω)
      have hge : IsIdempotentElem (g * e) := hg.mul he
      have hge' : IsIdempotentElem (g * (1 - e)) := hg.mul he.one_sub
      have hW₁ : ((g * e) ⊗ₜ[A] (1 : Ω)) * ((g ⊗ₜ[A] (1 : Ω)) * W) =
          ((g * e) ⊗ₜ[A] (1 : Ω)) * (1 ⊗ₜ (c + ω) + z) := by
        rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_right_comm, hg.eq]
        simp only [W, TensorProduct.tmul_add, mul_add, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul, mul_assoc, he.eq]
        abel
      have hW₂ : ((g * (1 - e)) ⊗ₜ[A] (1 : Ω)) * ((g ⊗ₜ[A] (1 : Ω)) * W) =
          ((g * (1 - e)) ⊗ₜ[A] (1 : Ω)) * (1 ⊗ₜ c + z) := by
        rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_right_comm, hg.eq]
        simp only [W, mul_add, Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_assoc,
          sub_mul, one_mul, he.eq, sub_self, mul_zero, TensorProduct.zero_tmul, add_zero]
      have hid (r : R) (hr : IsIdempotentElem r) : IsIdempotentElem (r ⊗ₜ[A] (1 : Ω)) := by
        rw [IsIdempotentElem, Algebra.TensorProduct.tmul_mul_tmul, hr.eq, mul_one]
      obtain ⟨e₁, he₁, h₁⟩ := hz (c + ω) (g * e) hge (hW₁ ▸ (hid _ hge).mul hgz)
      obtain ⟨e₂, he₂, h₂⟩ := hz c (g * (1 - e)) hge' (hW₂ ▸ (hid _ hge').mul hgz)
      have hsum : (g ⊗ₜ[A] (1 : Ω)) * W = (e₁ + e₂) ⊗ₜ[A] (1 : Ω) := by
        rw [TensorProduct.add_tmul, h₁, h₂, ← hW₁, ← hW₂, ← add_mul, ← TensorProduct.add_tmul,
          ← mul_add, add_sub_cancel, mul_one, ← mul_assoc,
          Algebra.TensorProduct.tmul_mul_tmul, hg.eq, mul_one]
      refine ⟨e₁ + e₂, ?_, hsum.symm⟩
      apply hinj
      have := hgz.eq
      rw [hsum, Algebra.TensorProduct.tmul_mul_tmul, mul_one] at this
      simpa using this
    | zero =>
      intro z hz
      simpa using hz
    | add y₁ y₂ _ _ h₁ h₂ =>
      intro z hz
      rw [← add_assoc]
      exact h₂ _ (h₁ z hz)
  simpa using hQ' 0 hQ0

/-- Let `R` be an `A`-algebra spanned over `A` by its idempotents and `Ω` an `A`-algebra which is
a field, such that `R ⟶ R ⊗_A Ω` is injective. Then every idempotent of `R ⊗_A Ω` is the image of
an idempotent of `R`. -/
theorem TensorProduct.exists_includeLeft_eq_of_isIdempotentElem
    (hR : ∀ r : R, r ∈ Submodule.span A {e : R | IsIdempotentElem e})
    (hinj : Function.Injective (Algebra.TensorProduct.includeLeft : R →ₐ[A] R ⊗[A] Ω))
    {ε : R ⊗[A] Ω} (hε : IsIdempotentElem ε) :
    ∃ e : R, IsIdempotentElem e ∧ e ⊗ₜ[A] (1 : Ω) = ε := by
  let M := AddSubmonoid.closure {x : R ⊗[A] Ω | ∃ e : R, IsIdempotentElem e ∧ ∃ ω : Ω,
    x = e ⊗ₜ ω}
  have hM (x : R ⊗[A] Ω) : x ∈ M := by
    induction x using TensorProduct.inductionOn with
    | add x y hx hy => exact M.add_mem hx hy
    | tmul r ω =>
      induction hR r using Submodule.span_induction generalizing ω with
      | mem e he => exact AddSubmonoid.subset_closure ⟨e, he, ω, rfl⟩
      | zero => simp
      | add r s _ _ hr hs => simpa [TensorProduct.add_tmul] using M.add_mem (hr ω) (hs ω)
      | smul a r _ hr =>
        rw [TensorProduct.smul_tmul]
        exact hr _
  obtain ⟨e, he, h⟩ := TensorProduct.exists_includeLeft_eq_aux hinj (hM ε) 0 1
    IsIdempotentElem.one (by
      rwa [TensorProduct.tmul_zero, zero_add, ← Algebra.TensorProduct.one_def, one_mul])
  rw [TensorProduct.tmul_zero, zero_add, ← Algebra.TensorProduct.one_def, one_mul] at h
  exact ⟨e, he, h⟩

end Idempotents

/-- Let `φ : R ⟶ R'` be an injective ring map such that every idempotent of `R'` lies in the
image of `φ`. For every ring `B` additively generated by its idempotents, composition with `φ`
is a bijection from ring maps `B ⟶ R` to ring maps `B ⟶ R'`. -/
theorem RingHom.bijective_comp_of_forall_exists_eq {B R R' : Type*} [Ring B] [Ring R] [Ring R']
    (hB : ∀ b : B, b ∈ AddSubgroup.closure {e : B | IsIdempotentElem e})
    (φ : R →+* R') (hφ : Function.Injective φ)
    (hid : ∀ ε : R', IsIdempotentElem ε → ∃ e, φ e = ε) :
    Function.Bijective (fun ψ : B →+* R ↦ φ.comp ψ) := by
  refine ⟨fun ψ₁ ψ₂ h ↦ RingHom.ext fun b ↦ hφ (RingHom.congr_fun h b), fun ψ' ↦ ?_⟩
  have hrange (b : B) : ψ' b ∈ φ.range := by
    induction hB b using AddSubgroup.closure_induction with
    | mem e he => exact (hid _ (he.map ψ')).imp fun _ h ↦ h
    | zero => simp
    | add x y _ _ hx hy => simpa using φ.range.add_mem hx hy
    | neg x _ hx => simpa using φ.range.neg_mem hx
  let e : R ≃+* φ.range := RingEquiv.ofBijective φ.rangeRestrict
    ⟨fun x y h ↦ hφ (congrArg Subtype.val h), φ.rangeRestrict_surjective⟩
  refine ⟨e.symm.toRingHom.comp (ψ'.codRestrict φ.range hrange), RingHom.ext fun b ↦ ?_⟩
  exact congrArg Subtype.val (e.apply_symm_apply ⟨ψ' b, hrange b⟩)

/-- The ring `LC(S, ℤ)` of locally constant integer valued functions on a compact space is
additively generated by its idempotents, the characteristic functions of the clopen sets. -/
theorem LocallyConstant.mem_closure_isIdempotentElem {S : Type*} [TopologicalSpace S]
    [CompactSpace S] (f : LocallyConstant S ℤ) :
    f ∈ AddSubgroup.closure {e : LocallyConstant S ℤ | IsIdempotentElem e} := by
  classical
  let χ (v : ℤ) : LocallyConstant S ℤ :=
    LocallyConstant.charFn ℤ (f.isLocallyConstant.isClopen_fiber v)
  have hχ (v : ℤ) (x : S) : χ v x = if f x = v then 1 else 0 := by
    dsimp only [χ]
    by_cases hx : f x = v
    · rw [ite_eq_left hx]
      exact (LocallyConstant.charFn_eq_one (Y := ℤ) x _).2 hx
    · rw [ite_eq_right hx]
      exact (LocallyConstant.charFn_eq_zero (Y := ℤ) x _).2 hx
  have hf : f = ∑ v ∈ f.range_finite.toFinset, v • χ v := by
    ext x
    have h := congrFun (map_sum (LocallyConstant.coeFnAddMonoidHom : LocallyConstant S ℤ →+ (S → ℤ))
      (fun v ↦ v • χ v) f.range_finite.toFinset) x
    rw [LocallyConstant.coeFnAddMonoidHom_apply] at h
    rw [h, Finset.sum_apply]
    simp only [LocallyConstant.coeFnAddMonoidHom_apply, LocallyConstant.coe_smul, Pi.smul_apply,
      smul_eq_mul, hχ, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq, ite_eq_left (by simp)]
  rw [hf]
  refine AddSubgroup.sum_mem _ fun v _ ↦ AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure ?_) v
  ext x
  rw [LocallyConstant.coe_mul, Pi.mul_apply, hχ]
  split_ifs <;> simp

namespace Algebra.ClosedLift

variable {A : Type u} [CommRing A]
  {C : Type u} [CommRing C] [Algebra A C] {Ω : Type u} [Field Ω] [Algebra A Ω]

/-- The ind-étale closed lift `H = H_A(C̄)` injects into `H ⊗_A Ω` when `A ⟶ Ω` is injective, `H`
being flat over `A`. -/
theorem injective_includeLeft (hΩ : Function.Injective (algebraMap A Ω)) :
    Function.Injective
      (Algebra.TensorProduct.includeLeft : ClosedLift A C →ₐ[A] ClosedLift A C ⊗[A] Ω) := by
  have h := Module.Flat.lTensor_preserves_injective_linearMap (M := ClosedLift A C)
    (Algebra.linearMap A Ω) hΩ
  intro x y hxy
  apply (_root_.TensorProduct.rid A (ClosedLift A C)).symm.injective
  apply h
  simpa using hxy

/-- If the maximal ideal of the strictly henselian local ring `A` kills `C̄` and `A ⟶ Ω` is an
injective map to a field, every idempotent of `H_A(C̄) ⊗_A Ω` comes from an idempotent of
`H_A(C̄)`. -/
theorem exists_includeLeft_eq_of_isIdempotentElem [IsStrictlyHenselianLocalRing A]
    (hC : ∀ a ∈ IsLocalRing.maximalIdeal A, algebraMap A C a = 0)
    (hΩ : Function.Injective (algebraMap A Ω)) {ε : ClosedLift A C ⊗[A] Ω}
    (hε : IsIdempotentElem ε) :
    ∃ e : ClosedLift A C, IsIdempotentElem e ∧ e ⊗ₜ[A] (1 : Ω) = ε :=
  _root_.TensorProduct.exists_includeLeft_eq_of_isIdempotentElem (mem_span_isIdempotentElem hC)
    (injective_includeLeft hΩ) hε

end Algebra.ClosedLift
