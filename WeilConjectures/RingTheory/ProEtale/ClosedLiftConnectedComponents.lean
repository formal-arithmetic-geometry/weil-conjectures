module

public import WeilConjectures.RingTheory.ProEtale.ClosedLiftStrictlyHenselian
public import Mathlib.Topology.LocallyConstant.Algebra

/-!
# Idempotents of the geometric generic fibre of a henselian lift

Let `A` be a strictly henselian local ring, `C̄` an `A`-algebra killed by the maximal ideal and
`H = H_A(C̄)` its ind-étale closed lift. For an `A`-algebra `Ω` which is a field and into which `A`
injects, every idempotent of `H ⊗_A Ω` comes from an idempotent of `H`
(`Algebra.ClosedLift.exists_includeLeft_eq_of_isIdempotentElem`): `H` is spanned over `A` by its
idempotents (`Algebra.ClosedLift.mem_span_isIdempotentElem`), and `H ⟶ H ⊗_A Ω` is injective,
`H` being flat over `A`.

Consequently ring maps from a ring additively generated by idempotents, such as the ring
`LC(S, ℤ)` of locally constant integer valued functions on a profinite set, to `H` and to
`H ⊗_A Ω` correspond (`RingHom.bijective_comp_of_forall_exists_eq`): the spaces of connected
components of `Spec H` and of `Spec (H ⊗_A Ω)` agree.

## Main results

- `TensorProduct.exists_includeLeft_eq_of_isIdempotentElem`: if `R` is spanned over `A` by
  idempotents and `R ⟶ R ⊗_A Ω` is injective, every idempotent of `R ⊗_A Ω` comes from `R`.
- `RingHom.bijective_comp_of_forall_exists_eq`: composition with an injective ring map hitting
  every idempotent is bijective on ring maps out of a ring additively generated by idempotents.
- `LocallyConstant.mem_closure_isIdempotentElem`: `LC(S, ℤ)` is additively generated by
  idempotents.
-/

@[expose] public section

universe u v w

open scoped TensorProduct

section Idempotents

variable {A : Type u} {R : Type v} {Ω : Type w} [CommRing A] [CommRing R] [Field Ω]
  [Algebra A R] [Algebra A Ω]

end Idempotents

namespace Algebra.ClosedLift

variable {A : Type u} [CommRing A]
  {C : Type u} [CommRing C] [Algebra A C] {Ω : Type u} [Field Ω] [Algebra A Ω]

end Algebra.ClosedLift
