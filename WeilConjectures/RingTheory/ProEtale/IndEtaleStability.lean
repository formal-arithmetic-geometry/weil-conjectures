module

public import WeilConjectures.RingTheory.ProEtale.IndWeaklyEtale

/-!
# Stability properties of ind-étale and ind-Zariski algebras

This file collects the stability properties of ind-étale, ind-Zariski and weakly étale ring maps
of blueprint `lem-weil-pbc-ind-etale-stability`, and proves the ones that were missing:

* `RingHom.IndZariski.isStableUnderBaseChange`: ind-Zariski maps are stable under base change.
* `Algebra.IndZariski.of_surjective_of_forall_exists_isIdempotentElem`: a surjection whose
  kernel is "generated by idempotents" is ind-Zariski.
* `Algebra.IndEtale.indEtale_algHom`: an algebra map between ind-étale `A`-algebras is
  ind-étale.

## Main declarations

* `RingHom.IndEtale.stability`: the bundled statement of `lem-weil-pbc-ind-etale-stability`.
-/

@[expose] public section

universe u

open CategoryTheory Limits TensorProduct

namespace RingHom.IndZariski

/-- Ind-Zariski ring homomorphisms are stable under base change.
Part of blueprint `lem-weil-pbc-ind-etale-stability`. -/
lemma isStableUnderBaseChange : IsStableUnderBaseChange IndZariski := by
  intro R S R' S' _ _ _ _ _ _ _ _ _ _ _ hpush hRS
  rw [iff_ind_isLocalIso] at hRS ⊢
  rw [← CommRingCat.isPushout_iff_isPushout] at hpush
  exact (inferInstance : (MorphismProperty.ind
    (RingHom.toMorphismProperty RingHom.IsLocalIso)).IsStableUnderCobaseChange).1
    hpush.flip hRS

end RingHom.IndZariski

namespace Algebra.IndZariski

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

section

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
instance baseChange (T : Type u) [CommRing T] [Algebra R T] [Algebra.IndZariski R S] :
    Algebra.IndZariski T (T ⊗[R] S) := by
  rw [← RingHom.IndZariski.algebraMap_iff]
  exact RingHom.IndZariski.isStableUnderBaseChange R S T (T ⊗[R] S)
    ((RingHom.IndZariski.algebraMap_iff R S).mpr inferInstance)

end

/-- The submonoid `{1 - e | e ∈ I idempotent}` of a ring. -/
def oneSubIdempotents (I : Ideal R) : Submonoid R where
  carrier := {s | ∃ e ∈ I, IsIdempotentElem e ∧ s = 1 - e}
  one_mem' := ⟨0, I.zero_mem, IsIdempotentElem.zero, by simp⟩
  mul_mem' := by
    rintro _ _ ⟨e, he, he', rfl⟩ ⟨f, hf, hf', rfl⟩
    exact ⟨e + f - e * f, I.sub_mem (I.add_mem he hf) (I.mul_mem_right _ he),
      he'.add_sub_mul hf', by ring⟩

/-- If `f : R → S` is surjective and every element `x` of its kernel satisfies `x * e = x`
for some idempotent `e` of the kernel, then `S` is a localization of `R`, hence ind-Zariski. -/
theorem of_surjective_of_forall_exists_isIdempotentElem
    (hsurj : Function.Surjective (algebraMap R S))
    (h : ∀ x ∈ RingHom.ker (algebraMap R S), ∃ e ∈ RingHom.ker (algebraMap R S),
      IsIdempotentElem e ∧ x * e = x) :
    Algebra.IndZariski R S := by
  have : IsLocalization (oneSubIdempotents (RingHom.ker (algebraMap R S))) S := by
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, e, he, -, rfl⟩
      simp [(RingHom.mem_ker).mp he]
    · intro z
      obtain ⟨x, rfl⟩ := hsurj z
      exact ⟨⟨x, 1⟩, by simp⟩
    · intro x y hxy
      obtain ⟨e, he, he', hxe⟩ := h (x - y) (by simp [RingHom.mem_ker, hxy])
      refine ⟨⟨1 - e, e, he, he', rfl⟩, ?_⟩
      change (1 - e) * x = (1 - e) * y
      linear_combination (-1 : R) * hxe
  exact of_isLocalization S (oneSubIdempotents (RingHom.ker (algebraMap R S)))

end Algebra.IndZariski

namespace Algebra.IndEtale

variable {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]

/-- The set of elements of an ideal admitting an idempotent multiplier from the ideal is an
ideal. -/
private lemma idempotentMultiplier_mem_of_mem_span {R : Type u} [CommRing R] (J : Ideal R)
    (s : Set R)
    (h : ∀ x ∈ s, ∃ e ∈ J, IsIdempotentElem e ∧ x * e = x) {x : R}
    (hx : x ∈ Ideal.span s) : ∃ e ∈ J, IsIdempotentElem e ∧ x * e = x := by
  induction hx using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero => exact ⟨0, J.zero_mem, .zero, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨e, he, he', hxe⟩ := hx
    obtain ⟨f, hf, hf', hyf⟩ := hy
    refine ⟨e + f - e * f, J.sub_mem (J.add_mem he hf) (J.mul_mem_right _ he),
      he'.add_sub_mul hf', ?_⟩
    linear_combination (1 - f) * hxe + (1 - e) * hyf
  | smul a x _ hx =>
    obtain ⟨e, he, he', hxe⟩ := hx
    exact ⟨e, he, he', by rw [smul_eq_mul, mul_assoc, hxe]⟩

variable [Algebra.IndEtale A B] [Algebra.IndEtale A C]

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- If `B` and `C` are ind-étale `A`-algebras, every `A`-algebra map `B → C` is ind-étale.
Part of blueprint `lem-weil-pbc-ind-etale-stability`. -/
theorem indEtale_algHom (f : B →ₐ[A] C) : f.toRingHom.IndEtale := by
  classical
  -- The multiplication map `μ : B ⊗[A] C → C`, `b ⊗ c ↦ f b * c`.
  let μ : B ⊗[A] C →ₐ[A] C := Algebra.TensorProduct.lift f (AlgHom.id A C) fun _ _ ↦ .all _ _
  let g : B ⊗[A] B →ₐ[A] B ⊗[A] C := Algebra.TensorProduct.map (AlgHom.id A B) f
  have hμ_surj : Function.Surjective μ := fun c ↦ ⟨1 ⊗ₜ c, by simp [μ]⟩
  -- Every element `x` satisfies `x - 1 ⊗ μ x ∈ g(I)`, where `I` is the diagonal ideal.
  have hmem : ∀ x : B ⊗[A] C,
      x - 1 ⊗ₜ μ x ∈ (KaehlerDifferential.ideal A B).map g.toRingHom := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy =>
      convert Ideal.add_mem _ hx hy using 1
      simp only [map_add, TensorProduct.tmul_add]
      abel
    | tmul b c =>
      have h1 : b ⊗ₜ[A] (1 : B) - 1 ⊗ₜ b ∈ KaehlerDifferential.ideal A B := by
        rw [KaehlerDifferential.ideal, RingHom.mem_ker]
        simp
      have h2 := Ideal.mul_mem_right ((1 : B) ⊗ₜ[A] c) _
        (Ideal.mem_map_of_mem g.toRingHom h1)
      convert h2 using 1
      simp [g, μ, sub_mul, Algebra.TensorProduct.tmul_mul_tmul]
  -- Hence the kernel of `μ` admits idempotent multipliers.
  have hker : ∀ x ∈ RingHom.ker μ.toRingHom, ∃ e ∈ RingHom.ker μ.toRingHom,
      IsIdempotentElem e ∧ x * e = x := by
    intro x hx
    have hx' : x ∈ (KaehlerDifferential.ideal A B).map g.toRingHom := by
      have := hmem x
      rwa [show μ x = 0 from hx, TensorProduct.tmul_zero, sub_zero] at this
    have hle : (KaehlerDifferential.ideal A B).map g.toRingHom ≤ RingHom.ker μ.toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [KaehlerDifferential.ideal, RingHom.mem_ker] at hy
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have : μ.comp g = f.comp (Algebra.TensorProduct.lmul' A) := by
        ext <;> simp [μ, g]
      change (μ.comp g) y = 0
      rw [this, AlgHom.comp_apply]
      rw [show (Algebra.TensorProduct.lmul' A) y = 0 from hy, map_zero]
    refine idempotentMultiplier_mem_of_mem_span _ _ ?_ hx'
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨e, he, he', hye⟩ :=
      Algebra.IndEtale.exists_isIdempotentElem_mul_eq_of_mem_kaehlerDifferential_ideal hy
    exact ⟨g e, hle (Ideal.mem_map_of_mem _ he), he'.map g, by
      change g y * g e = g y
      rw [← map_mul, hye]⟩
  -- `μ` is ind-Zariski, and `B → B ⊗[A] C` is ind-étale by base change.
  let : Algebra (B ⊗[A] C) C := μ.toRingHom.toAlgebra
  have hμ : μ.toRingHom.IndZariski := by
    rw [← RingHom.algebraMap_toAlgebra μ.toRingHom, RingHom.IndZariski.algebraMap_iff]
    exact Algebra.IndZariski.of_surjective_of_forall_exists_isIdempotentElem hμ_surj hker
  have hinc : (algebraMap B (B ⊗[A] C)).IndEtale :=
    RingHom.IndEtale.isStableUnderBaseChange A C B (B ⊗[A] C)
      ((RingHom.IndEtale.algebraMap_iff A C).mpr inferInstance)
  have hfac : f.toRingHom = μ.toRingHom.comp (algebraMap B (B ⊗[A] C)) := by
    ext b
    simp [μ]
  rw [hfac]
  exact RingHom.IndEtale.comp hμ.indEtale hinc

end Algebra.IndEtale

namespace RingHom.IndEtale

/-- **Blueprint `lem-weil-pbc-ind-etale-stability`** (bundled form). Ind-étale and ind-Zariski
ring maps are stable under base change and composition (stability under filtered colimits is
`RingHom.IndEtale.of_isColimit` and `RingHom.IndZariski.of_isColimit`); ind-étale maps are
weakly étale; an algebra map between ind-étale algebras is ind-étale; weakly étale maps are stable
under composition and base change. -/
theorem stability :
    RingHom.IsStableUnderBaseChange RingHom.IndEtale ∧
    RingHom.IsStableUnderBaseChange RingHom.IndZariski ∧
    (∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (f : R →+* S) (g : S →+* T),
      f.IndEtale → g.IndEtale → (g.comp f).IndEtale) ∧
    (∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (f : R →+* S) (g : S →+* T),
      f.IndZariski → g.IndZariski → (g.comp f).IndZariski) ∧
    (∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S), f.IndEtale → f.WeaklyEtale) ∧
    (∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]
      [Algebra.IndEtale A B] [Algebra.IndEtale A C] (f : B →ₐ[A] C), f.toRingHom.IndEtale) ∧
    (∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (f : R →+* S) (g : S →+* T),
      f.WeaklyEtale → g.WeaklyEtale → (g.comp f).WeaklyEtale) ∧
    (∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T],
      Algebra.WeaklyEtale R S → Algebra.WeaklyEtale T (T ⊗[R] S)) :=
  ⟨isStableUnderBaseChange, RingHom.IndZariski.isStableUnderBaseChange,
    fun _ _ hf hg ↦ hg.comp hf, fun _ _ hf hg ↦ hg.comp hf,
    fun _ hf ↦ hf.weaklyEtale, fun f ↦ Algebra.IndEtale.indEtale_algHom f,
    fun _ _ hf hg ↦ hf.comp hg, fun _ ↦ inferInstance⟩

end RingHom.IndEtale
