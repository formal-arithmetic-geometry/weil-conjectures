module

public import Mathlib.RingTheory.Smooth.Basic
public import WeilConjectures.RingTheory.Kaehler.TraceDuality

/-!
# Duality for the trace of differentials over an arbitrary field

Let `k` be a field, `R = k[t]_g` a localization of the polynomial ring at a nonzero `g`, with the
derivation `D = d/dt`, and `B` a smooth `k`-algebra, finite free over `R`, whose differentials
`Ω_{B/k}` are locally generated by one element (a smooth curve over `k`), and which is generically
unramified over `R`. Then the trace derivation induces an isomorphism `Ω_{B/k} ≅ Hom_R(B, R)`
(`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_smooth`).

Unlike `KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation`, no separability
of the residue field extensions of `B/R` is assumed, and `B` need not be a domain: this is the
local form of Grothendieck duality `f^! Ω_{ℙ¹} ≅ Ω_X` for a generically étale finite flat morphism
`f : X → ℙ¹_k` of smooth curves over an arbitrary field.
-/

@[expose] public section

open Polynomial Algebra

namespace KaehlerDifferential

attribute [local instance] precompModule precompModule_isScalarTower

/-- **Duality for the trace of differentials over an arbitrary field.** Let `R = k[t]_g` be a
localization of `k[t]` at a nonzero polynomial `g`, with a `k`-derivation `D` of `R` such that
`D t = 1`, and let `B` be a smooth `k`-algebra, finite free over `R`, such that `Ω_{B/k}` is
locally generated by one element and `B` is unramified over `R` at its minimal primes. Then the
trace derivation induces an isomorphism `Ω_{B/k} ≅ Hom_R(B, R)`,
`c da ↦ (b ↦ Tr(bC · D(A)))`. -/
theorem bijective_liftKaehlerDifferential_traceDerivation_of_smooth {k R B : Type*} [Field k]
    [CommRing R] [Algebra k R] [Algebra k[X] R] [IsScalarTower k k[X] R] (g : k[X]) (hg : g ≠ 0)
    [IsLocalization.Away g R] [CommRing B] [Algebra R B] [Algebra k B] [IsScalarTower k R B]
    [Module.Free R B] [Module.Finite R B] [Algebra.Smooth k B]
    (D : Derivation k R R) (hD : D (algebraMap k[X] R X) = 1)
    (hsm : ∀ q : Ideal B, q.IsMaximal →
      ∃ ω₀ : Ω[B⁄k], ∃ s ∉ q, ∀ ω : Ω[B⁄k], ∃ b : B, s • ω = b • ω₀)
    (hgen : ∀ (p : Ideal B) [p.IsPrime], p ∈ minimalPrimes B →
      Algebra.FormallyUnramified R (Localization.AtPrime p)) :
    Function.Bijective (traceDerivation (B := B) D).liftKaehlerDifferential :=
  sorry

end KaehlerDifferential
