module

public import Mathlib.RingTheory.Flat.Basic
import WeilConjectures.LinearAlgebra.TensorProduct.ColimitVaryingRings

/-! # Flat modules over directed unions of subrings

Source: literature/stacks-project/algebra.tex, Lemma Tag 05UU (blueprint:
lem-weil-pbc-directed-union-subrings-flat-module)
-/

@[expose] public section

universe u v w x

namespace RingTheory

/-- A module colimit over a directed union of subrings is flat when every stage
is flat. Source: Stacks Project, Algebra, Lemma Tag 05UU, part (2)
(blueprint: lem-weil-pbc-directed-union-subrings-flat-module).

Proof:
1. By `lem-weil-pbc-flat-fg-ideal-criterion`, test injectivity of multiplication
   from each finitely generated ideal tensored with `M`. Choose a common stage
   containing its finitely many generators. The indices above that stage form a
   nonempty directed cofinal upper set.
2. Extend the ideal generated by these elements to every stage in that upper set.
   The rings have union `R`, and the ideals have union the original ideal, since
   finitely many coefficients lie in a common stage. These unions are their
   abelian-group colimits (`def-weil-pbc-category-colimit`); the induced ideal
   action agrees with multiplication in `R`.
3. Condition `h_repr` gives representatives of every element of `M` in the upper
   set. For two representatives with equal images, move them to a common stage
   and apply `h_zero` to their difference: they agree eventually. This makes the
   compatible maps exhibit `M` as the abelian-group colimit
   (`def-weil-pbc-category-colimit`). Moving a scalar and a representative to a
   common stage shows that the induced `R`-action is the given action on `M`.
4. Apply `lem-weil-pbc-filtered-colimit-tensor-varying-rings` to the rings, ideals,
   and stage modules on the upper set. Inclusion on the ideals and the linearity
   of `t` give the required semilinearity. Steps 2 and 3 identify the tensor
   colimit with the original ideal tensored with `M`, taking a stage tensor
   `y ⊗ x` to `y ⊗ ι x`.
5. Each stage multiplication map is injective by stage flatness
   (`def-weil-pbc-flat-ring-map`). These maps commute with transitions. By
   `lem-weil-pbc-filtered-colimit-abelian-groups-exact`, their colimit is injective.
   Under the comparisons of steps 3 and 4 it is the original multiplication map,
   since both send a stage tensor to `y • ι x`. The criterion in step 1 proves
   flatness over `R`. -/
theorem directedUnionSubrings_flat_module
    {R : Type u} [CommRing R]
    {Λ : Type v} [PartialOrder Λ] [Nonempty Λ]
    [IsDirected Λ (· ≤ ·)]
    (Rsub : Λ → Subring R)
    (hR : ∀ {i j : Λ}, i ≤ j → Rsub i ≤ Rsub j)
    (hUnion : (Set.univ : Set R) = ⋃ i, (Rsub i : Set R))
    {M : Type w} [AddCommMonoid M] [Module R M]
    (Mstage : ∀ i : Λ, Type x)
    (instAdd : ∀ i : Λ, AddCommMonoid (Mstage i))
    (instMod : ∀ i : Λ, Module (Rsub i) (Mstage i))
    (ι : ∀ i : Λ,
      letI : Module (Rsub i) M := Module.compHom M (Rsub i).subtype
      Mstage i →ₗ[Rsub i] M)
    (t : ∀ {i j : Λ} (h : i ≤ j),
      letI : Module (Rsub i) (Mstage j) :=
        Module.compHom (Mstage j) (Subring.inclusion (hR h))
      Mstage i →ₗ[Rsub i] Mstage j)
    (t_id : ∀ (i : Λ) (x : Mstage i), t (le_refl i) x = x)
    (t_comp : ∀ {i j k : Λ} (h₁ : i ≤ j) (h₂ : j ≤ k) (x : Mstage i),
      t h₂ (t h₁ x) = t (h₁.trans h₂) x)
    (ι_naturality : ∀ {i j : Λ} (h : i ≤ j) (x : Mstage i),
      ι j (t h x) = ι i x)
    (h_repr : ∀ m : M, ∃ (i : Λ) (x : Mstage i), ι i x = m)
    (h_zero : ∀ {i : Λ} (x : Mstage i), ι i x = 0 →
      ∃ j : Λ, ∃ h : i ≤ j, t h x = 0)
    (hflat : ∀ i : Λ, Module.Flat (Rsub i) (Mstage i)) :
    Module.Flat R M := by
  sorry

end RingTheory
