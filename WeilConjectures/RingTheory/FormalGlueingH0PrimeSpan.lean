module

public import WeilConjectures.RingTheory.FormalGlueingH0
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.Span.Basic
import WeilConjectures.RingTheory.FormalGlueingEquivalence

/-! # Completed components are generated by compatible sections

Source: Stacks Project, Proposition 05ER, its canonical comparison Psi.
(blueprint: lem-sbc-formal-glueing-h0-prime-span)
-/

@[expose] public section

universe u v w
namespace FormalGlueing

open CategoryTheory
open scoped TensorProduct

private theorem cast_heq {R : Type u} [CommRing R] {M N : ModuleCat.{w} R}
    (h : M = N) (x : M) : HEq ((eqToIso h).hom.hom x) x := by
  cases h
  rfl

private theorem mk_heq {R : Type u} [CommRing R] (f : R)
    {M N : ModuleCat.{w} R} (h : M = N) (x : M) (y : N) (hxy : HEq x y) :
    HEq (LocalizedModule.mk x (1 : Submonoid.powers f))
      (LocalizedModule.mk y (1 : Submonoid.powers f)) := by
  cases h
  cases hxy
  rfl

private theorem tmul_heq {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] (φ : R →+* S)
    {M N : ModuleCat.{w} R} (h : M = N) (x : M) (y : N) (hxy : HEq x y) :
    letI : Algebra R S := φ.toAlgebra
    HEq (TensorProduct.tmul R (1 : S) x) (TensorProduct.tmul R (1 : S) y) := by
  cases h
  cases hxy
  rfl

private theorem apply_heq {R : Type u} [CommRing R]
    {M N P Q : ModuleCat.{w} R} (hM : M = N) (hP : P = Q)
    (a : M →ₗ[R] P) (b : N →ₗ[R] Q) (hab : HEq a b)
    (x : M) (y : N) (hxy : HEq x y) : HEq (a x) (b y) := by
  cases hM
  cases hP
  cases hab
  cases hxy
  rfl

private theorem canonical_piece_eq {R : Type u} [CommRing R]
    (f : R) (M : ModuleCat.{w} R) :
    piece f (ModuleCat.of (Localization.Away f) (LocalizedModule.Away f M)) =
      localize f M := by
  dsimp [piece, restrict, ModuleCat.restrictScalars, ModuleCat.RestrictScalars.obj']
  congr 1
  ext r x
  exact IsScalarTower.algebraMap_smul (Localization.Away f) r x

private theorem tuple_mem_h0_iff {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] (φ : R →+* S) {t : ℕ} (f : Fin t → R)
    (X : Data.{u, v, w} φ f)
    (p : restrict φ X.M' × ∀ i : Fin t, piece (f i) (X.M i)) :
    letI : Algebra R S := φ.toAlgebra
    p ∈ h0 φ f X ↔
      (∀ i, X.alpha i (LocalizedModule.mk p.1 1) =
        TensorProduct.tmul R (1 : S) (p.2 i)) ∧
      (∀ i j, X.alpha_overlap i j (LocalizedModule.mk (p.2 i) 1) =
        LocalizedModule.mk (p.2 j) 1) := by
  let : Algebra R S := φ.toAlgebra
  simp only [h0, Submodule.mem_inf, Submodule.mem_iInf, LinearMap.mem_ker,
    LinearMap.sub_apply, sub_eq_zero, LinearMap.comp_apply, LinearMap.fst_apply,
    LinearMap.snd_apply, LinearMap.proj_apply, LocalizedModule.mkLinearMap_apply,
    LinearEquiv.coe_coe]
  rfl

private theorem canonical_tuple {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] (φ : R →+* S) {t : ℕ} (f : Fin t → R)
    (M : ModuleCat.{max u v w} R) (X : Data.{u, v, max u v w} φ f)
    (hP : X.M' = extend φ M)
    (hC : ∀ i, piece (f i) (X.M i) = localize (f i) M)
    (hα : ∀ i, HEq ((X.alpha i).toLinearMap) (compare φ (f i) M))
    (hβ : ∀ i j, HEq ((X.alpha_overlap i j).toLinearMap) (swap (f i) (f j) M))
    (m : M) :
    letI : Algebra R S := φ.toAlgebra
    ∃ h : h0 φ f X,
      h.val.1 = (eqToIso hP.symm).hom.hom (TensorProduct.tmul R (1 : S) m) := by
  let : Algebra R S := φ.toAlgebra
  let p : X.M' := (eqToIso hP.symm).hom.hom (TensorProduct.tmul R (1 : S) m)
  let c (i : Fin t) : piece (f i) (X.M i) :=
    (eqToIso (hC i).symm).hom.hom (LocalizedModule.mk m 1)
  have hp : HEq p (TensorProduct.tmul R (1 : S) m) := cast_heq hP.symm _
  have hc (i) : HEq (c i) (LocalizedModule.mk m (1 : Submonoid.powers (f i))) :=
    cast_heq (hC i).symm _
  refine ⟨⟨(p, c), (tuple_mem_h0_iff φ f X (p, c)).mpr ⟨?_, ?_⟩⟩, rfl⟩
  · intro i
    have hl := apply_heq
      (congrArg (fun N ↦ localize (f i) (restrict φ N)) hP)
      (congrArg (fun N ↦ restrict φ (extend φ N)) (hC i))
      (X.alpha i).toLinearMap (compare φ (f i) M) (hα i)
      (LocalizedModule.mk p 1)
      (LocalizedModule.mk (TensorProduct.tmul R (1 : S) m) 1)
      (mk_heq (f i) (congrArg (restrict φ) hP) _ _ hp)
    have hcompare := LinearMap.congr_fun (exists_compare φ (f i) M).exists.choose_spec
      (TensorProduct.tmul R (1 : S) m)
    change compare φ (f i) M (LocalizedModule.mk (TensorProduct.tmul R (1 : S) m) 1) =
      TensorProduct.tmul R (1 : S) (LocalizedModule.mk m 1) at hcompare
    have hr := tmul_heq φ (hC i) _ _ (hc i)
    exact eq_of_heq (hl.trans ((heq_of_eq hcompare).trans hr.symm))
  · intro i j
    have hl := apply_heq (congrArg (localize (f j)) (hC i))
      (congrArg (localize (f i)) (hC j))
      (X.alpha_overlap i j).toLinearMap (swap (f i) (f j) M) (hβ i j)
      (LocalizedModule.mk (c i) 1) (LocalizedModule.mk (LocalizedModule.mk m 1) 1)
      (mk_heq (f j) (hC i) _ _ (hc i))
    have hswap := (exists_swap (f i) (f j) M).exists.choose_spec m
    have hr := mk_heq (f i) (hC j) _ _ (hc j)
    exact eq_of_heq (hl.trans ((heq_of_eq hswap).trans hr.symm))


private theorem map_compatible_tuple {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] (φ : R →+* S) {t : ℕ} (f : Fin t → R)
    {X Y : Data.{u, v, max u v w} φ f} (ψ : X ⟶ Y) (h : h0 φ f X) :
    ∃ k : h0 φ f Y, k.val.1 = ψ.prime h.val.1 := by
  let : Algebra R S := φ.toAlgebra
  have hh := (tuple_mem_h0_iff φ f X h.val).mp h.property
  let p : restrict φ Y.M' × ∀ i, piece (f i) (Y.M i) :=
    (ψ.prime h.val.1, fun i ↦ ψ.chart i (h.val.2 i))
  refine ⟨⟨p, (tuple_mem_h0_iff φ f Y p).mpr ⟨?_, ?_⟩⟩, rfl⟩
  · intro i
    have he := LinearMap.congr_fun (ψ.prime_compat i) (LocalizedModule.mk h.val.1 1)
    simp only [LinearMap.comp_apply] at he
    rw [localMap, IsLocalizedModule.map_LocalizedModules] at he
    change Y.alpha i (LocalizedModule.mk (ψ.prime h.val.1) 1) =
      (extendMapR φ (ψ.chart i)) (X.alpha i (LocalizedModule.mk h.val.1 1)) at he
    rw [hh.1 i] at he
    exact he
  · intro i j
    have he := LinearMap.congr_fun (ψ.chart_compat i j)
      (LocalizedModule.mk (h.val.2 i) 1)
    simp only [LinearMap.comp_apply] at he
    rw [localMap, IsLocalizedModule.map_LocalizedModules] at he
    change Y.alpha_overlap i j (LocalizedModule.mk (ψ.chart i (h.val.2 i)) 1) =
      localMap (f i) (ψ.chart j) (X.alpha_overlap i j
        (LocalizedModule.mk (h.val.2 i) 1)) at he
    rw [hh.2 i j] at he
    rw [localMap, IsLocalizedModule.map_LocalizedModules] at he
    exact he

/-- The prime coordinates of compatible sections generate the prime module.
Source: Stacks Project, Proposition 05ER (proposition-equivalence), canonical
comparison Psi and the concluding observation that its cokernel Q is zero.
(blueprint: lem-sbc-formal-glueing-h0-prime-span)

Proof: use the canonical equivalence to write X as Can(M). For m in M, the
family with prime coordinate 1 tensor m and chart coordinates m/1 belongs to
H0(Can(M)): the comparison and interchange fraction formulas verify both
families of equations. A morphism of glueing data sends compatible families
to compatible families, by its prime and chart compatibility equations.
Transport these families through the isomorphism Can(M) -> X. Every element
of S tensor M is a finite sum of pure tensors s tensor m, and s tensor m is
s times 1 tensor m. The prime component of the isomorphism is S-linear and
surjective, so the transported prime coordinates span X.M'. This includes
an empty chart family, zero generators, and the zero module. -/
theorem h0_prime_span_eq_top {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] (φ : R →+* S) (t : ℕ) (f : Fin t → R)
    (hflat : φ.Flat)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map φ) φ Ideal.le_comap_map))
    (X : Data.{u, v, max u v w} φ f) :
    Submodule.span S (Set.range (fun h : h0 φ f X ↦ (h.val.1 : X.M'))) = ⊤ := by
  classical
  let : Algebra R S := φ.toAlgebra
  obtain ⟨_, Can, hobj, _hmap, heq⟩ := exists_canonical_equivalence.{u, v, w} φ t f
  obtain ⟨M, ⟨e⟩⟩ := (heq hflat hquot).2 X
  let ep := (eqToIso (hobj M).1).toLinearEquiv
  let q := ep.symm.toLinearMap
  let p : extend φ M →ₗ[S] X.M' := e.hom.prime.comp q
  have hp : Function.Surjective p := by
    intro x
    refine ⟨ep (e.inv.prime x), ?_⟩
    have he := congrArg (fun v : X ⟶ X ↦ v.prime x) e.inv_hom_id
    change e.hom.prime (e.inv.prime x) = x at he
    change e.hom.prime (ep.symm (ep (e.inv.prime x))) = x
    rw [ep.symm_apply_apply]
    exact he
  have hunit (m : M) : p (TensorProduct.tmul R (1 : S) m) ∈
      Submodule.span S (Set.range (fun h : h0 φ f X ↦ (h.val.1 : X.M'))) := by
    have hC (i) : piece (f i) ((Can.obj M).M i) = localize (f i) M :=
      (congrArg (piece (f i)) ((hobj M).2.1 i)).trans (canonical_piece_eq (f i) M)
    obtain ⟨h, hh⟩ := canonical_tuple φ f M (Can.obj M) (hobj M).1 hC
      (hobj M).2.2.1 (hobj M).2.2.2 m
    obtain ⟨k, hk⟩ := map_compatible_tuple φ f e.hom h
    apply Submodule.subset_span
    refine ⟨k, ?_⟩
    exact hk.trans (congrArg e.hom.prime hh)
  apply top_unique
  intro x _
  obtain ⟨y, rfl⟩ := hp x
  change TensorProduct R S M at y
  induction y using TensorProduct.inductionOn with
  | tmul s m =>
      have he : TensorProduct.tmul R s m = s • TensorProduct.tmul R (1 : S) m := by
        simp only [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [he, p.map_smul]
      exact Submodule.smul_mem _ _ (hunit m)
  | add y z hy hz =>
      rw [map_add]
      exact Submodule.add_mem _ (hy Submodule.mem_top) (hz Submodule.mem_top)

end FormalGlueing
