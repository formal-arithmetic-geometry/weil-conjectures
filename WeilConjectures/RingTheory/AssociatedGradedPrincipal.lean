module

public import WeilConjectures.RingTheory.AssociatedGradedRing
public import Mathlib.Algebra.Polynomial.Eval.Defs
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# The associated graded ring of a principal ideal generated by a regular element

For a non-zero-divisor `a` of a commutative ring `R` and `J = (a)`, each graded piece
`J^r / J^{r+1} = (a^r) / (a^{r+1})` is free of rank one over `R / J`: multiplication by `a^r`
induces `R / (a) ≃ J^r / J^{r+1}`.

Applied to `J = (x^m) ⊂ k[x]` this is the computation of the normal cone of the nonreduced point
`Z = V(x^m) ⊂ 𝔸¹` in blueprint `example-normal-cone-point`: every `I^r/I^{r+1}` is free of rank
one over `𝒪_Z = k[x]/(x^m)`.

## Main results

- `Ideal.associatedGradedPieceEquivOfIsSMulRegular`: `R / (a) ≃ (a)^r / (a)^{r+1}`.
- `Polynomial.associatedGradedPieceEquivXPow`: the case `a = x^m` in `R[x]`.
-/

@[expose] public section

universe u

namespace Ideal

variable {R : Type u} [CommRing R]

/-- Multiplication by `a^r`, `R → (a)^r / (a)^{r+1}`. -/
noncomputable def associatedGradedPieceMulPow (a : R) (r : ℕ) :
    R →ₗ[R] associatedGradedPiece (span {a}) r :=
  (Submodule.mkQ _).comp
    ((LinearMap.mulLeft R (a ^ r)).codRestrict ((span {a}) ^ r : Ideal R) fun x ↦ by
      rw [span_singleton_pow]
      exact mul_mem_right _ _ (mem_span_singleton_self _))

lemma associatedGradedPieceMulPow_surjective (a : R) (r : ℕ) :
    Function.Surjective (associatedGradedPieceMulPow a r) := by
  rintro ⟨y, hy⟩
  rw [span_singleton_pow, mem_span_singleton'] at hy
  obtain ⟨x, rfl⟩ := hy
  refine ⟨x, ?_⟩
  change Submodule.Quotient.mk _ = Submodule.Quotient.mk _
  congr 1
  exact Subtype.ext (mul_comm _ _)

lemma ker_associatedGradedPieceMulPow {a : R} (ha : IsSMulRegular R a) (r : ℕ) :
    LinearMap.ker (associatedGradedPieceMulPow a r) = span {a} := by
  ext x
  simp only [associatedGradedPieceMulPow, LinearMap.mem_ker, LinearMap.comp_apply,
    Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
    Submodule.subtype_apply, LinearMap.codRestrict_apply, LinearMap.mulLeft_apply,
    span_singleton_pow, mem_span_singleton]
  constructor
  · rintro ⟨y, hy⟩
    refine ⟨y, (ha.pow r) ?_⟩
    simp only [smul_eq_mul]
    rw [hy]
    ring
  · rintro ⟨y, rfl⟩
    exact ⟨y, by ring⟩

/-- For a non-zero-divisor `a`, multiplication by `a^r` induces an isomorphism
`R / (a) ≃ (a)^r / (a)^{r+1}`: each graded piece of the associated graded ring of `(a)` is free
of rank one over `R / (a)`. -/
noncomputable def associatedGradedPieceEquivOfIsSMulRegular {a : R} (ha : IsSMulRegular R a)
    (r : ℕ) : (R ⧸ span {a}) ≃ₗ[R] associatedGradedPiece (span {a}) r :=
  (Submodule.quotEquivOfEq _ _ (ker_associatedGradedPieceMulPow ha r).symm).trans
    ((associatedGradedPieceMulPow a r).quotKerEquivOfSurjective
      (associatedGradedPieceMulPow_surjective a r))

end Ideal

namespace Polynomial

variable {R : Type u} [CommRing R]

/-- **Normal cone of a nonreduced point** (blueprint `example-normal-cone-point`): for
`Z = V(x^m) ⊂ 𝔸¹` with ideal `I = (x^m)`, every graded piece `I^r / I^{r+1}` is free of rank one
over `𝒪_Z = R[x]/(x^m)`. -/
noncomputable def associatedGradedPieceEquivXPow (m r : ℕ) :
    (R[X] ⧸ Ideal.span {(X : R[X]) ^ m}) ≃ₗ[R[X]]
      Ideal.associatedGradedPiece (Ideal.span {(X : R[X]) ^ m}) r :=
  Ideal.associatedGradedPieceEquivOfIsSMulRegular
    ((isRegular_X (R := R)).pow m).isSMulRegular r

end Polynomial
