module

public import WeilConjectures.RingTheory.Valuation.ResidueSubfield
public import WeilConjectures.RingTheory.Valuation.KummerNormalFormStageOne

/-!
# Approximation by lifts of a Frobenius-closed basis

Let `𝒪` be a valuation subring of a field `Ω` with residue field `ℓ` of characteristic `p`, and
let `K₀ ≤ K` and `K₀ ≤ D ≤ L` be subfields of `Ω` such that

* `D` is discretely valued, with value group generated by `v ϖ`, `ϖ ∈ K₀`;
* `K₀` has the full residue field of `K`;
* the residue field `E` of `D` has a `k`-basis `1, u i ^ p ^ n` (`k` the residue field of `K`),
  and the residue `x̄` of an element `x ∈ D ∩ 𝒪` is a polynomial of degree `< p` in any element
  `ρ ∈ E` which is not a `p`-th power, with coefficients `p`-th powers in `E`.

Lifting the `u i` to `w i ∈ D ∩ 𝒪`, the monomials `w i ^ p ^ n` are valuation independent over
`K`, every element of `D ∩ 𝒪` (and every element of a finite `K`-combination of such elements)
is approximated to arbitrary precision by combinations of the monomials with coefficients in a
discrete subfield `Kst ≤ K`, and the elements of the field generated by `K` and `D ∩ 𝒪` by
combinations with coefficients in `K` (`ValuationSubring.exists_frobeniusLift_package`).
-/

@[expose] public section

open IsLocalRing

namespace ValuationSubring

variable {Ω : Type*} [Field Ω] (𝒪 : ValuationSubring Ω)

/-- **Approximation by lifts of a Frobenius-closed basis** (abstract form). -/
theorem exists_frobeniusLift_package {p : ℕ} [Fact p.Prime] [CharP (ResidueField 𝒪) p]
    (K K₀ D L : Subfield Ω) (hK₀K : K₀ ≤ K) (hK₀D : K₀ ≤ D) (hDL : D ≤ L) (hKL : K ≤ L)
    {ϖ : Ω} (hϖ : ϖ ∈ K₀) (hϖ0 : ϖ ≠ 0) (hϖ1 : 𝒪.valuation ϖ < 1)
    (hdisc : ∀ z ∈ D, z ≠ 0 → ∃ m : ℤ, 𝒪.valuation z = 𝒪.valuation ϖ ^ m)
    (harch : ∀ z : Ω, z ≠ 0 →
      ∃ n : ℕ, 0 < n ∧ ∃ m : ℤ, 𝒪.valuation z ^ n = 𝒪.valuation ϖ ^ m)
    (hroot : ∀ n : ℕ, 0 < n → ∃ z ∈ K, z ^ n = ϖ)
    (halg : ∀ c ∈ K, IsAlgebraic K₀ c)
    (hfull : ∀ y ∈ K, 𝒪.valuation y ≤ 1 → ∃ z ∈ K₀, 𝒪.valuation (y - z) < 1)
    {x : 𝒪} (hxD : (x : Ω) ∈ D)
    {ι : Type*} {u : ι → ResidueField 𝒪} (hu : ∀ i, u i ∈ 𝒪.residueSubfield D)
    (hli : LinearIndependent (𝒪.residueSubfield K)
      (fun j : Option (ι × ℕ) ↦ j.elim 1 fun i ↦ u i.1 ^ p ^ i.2))
    (hsp : ∀ e ∈ 𝒪.residueSubfield D, e ∈ Submodule.span (𝒪.residueSubfield K)
      (Set.range fun j : Option (ι × ℕ) ↦ j.elim 1 fun i ↦ u i.1 ^ p ^ i.2))
    (hpth : ∀ ρ ∈ 𝒪.residueSubfield D, (∀ z ∈ 𝒪.residueSubfield D, z ^ p ≠ ρ) →
      ∃ y : ℕ → ResidueField 𝒪, (∀ j, y j ∈ 𝒪.residueSubfield D) ∧
        residue 𝒪 x = ∑ j ∈ Finset.range p, y j ^ p * ρ ^ j)
    {r : ℕ} (α : Fin r → Ω)
    (hα : ∀ k, ∃ (n : ℕ) (c a : Fin n → Ω), (∀ l, c l ∈ K) ∧
      (∀ l, a l ∈ D ∧ 𝒪.valuation (a l) ≤ 1) ∧ α k = ∑ l, c l * a l) :
    ∃ (w : ι → Ω) (A : Subring Ω) (Kst : Subfield Ω), Kst ≤ K ∧
      -- (P1)
      ((∀ i, w i ∈ A) ∧ (∀ y ∈ A, y ∈ L ∧ 𝒪.valuation y ≤ 1) ∧
        ∀ i, 𝒪.valuation (w i) = 1) ∧
      -- (P2)
      (∀ c : Option (ι × ℕ) →₀ Ω, (∀ j, c j ∈ K) →
        ∀ j, 𝒪.valuation (c j) ≤ 𝒪.valuation (frobeniusComb p w c)) ∧
      -- (P3)
      (∀ c : Option (ι × ℕ) →₀ Ω, (∀ j, c j ∈ K) → (∀ j, 𝒪.valuation (c j) ≤ 1) →
        (∃ i, 𝒪.valuation (c (some (i, 0))) = 1) →
        ∃ (N : ℕ) (y : ℕ → Ω), (∀ k, y k ∈ L ∧ 𝒪.valuation (y k) ≤ 1) ∧
          𝒪.valuation ((x : Ω) - ∑ k ∈ Finset.range N, y k ^ p * frobeniusComb p w c ^ k) < 1) ∧
      -- (P4)
      (∃ γ : 𝒪.ValueGroup, 0 < γ ∧ γ < 1 ∧
        (∀ c ∈ Kst, c ≠ 0 → ∃ n : ℤ, 𝒪.valuation c = γ ^ n) ∧
        ∀ δ : 𝒪.ValueGroup, 0 < δ → ∃ N : ℕ, γ ^ N < δ) ∧
      -- (P5)
      (∀ y ∈ A, ∀ δ : 𝒪.ValueGroup, 0 < δ → ∃ e : Option (ι × ℕ) →₀ Ω, (∀ k, e k ∈ Kst) ∧
        𝒪.valuation (y - frobeniusComb p w e) < δ) ∧
      -- (P6)
      (∀ k, ∀ δ : 𝒪.ValueGroup, 0 < δ → ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ Kst) ∧
        𝒪.valuation (α k - frobeniusComb p w e) < δ) ∧
      -- (P7)
      (Subfield.closure ((K : Set Ω) ∪ A) ≤ L ∧
        ∀ y ∈ Subfield.closure ((K : Set Ω) ∪ A), ∀ δ : 𝒪.ValueGroup, 0 < δ →
          ∃ c : Option (ι × ℕ) →₀ Ω, (∀ j, c j ∈ K) ∧
            𝒪.valuation (y - frobeniusComb p w c) < δ) := by
  sorry

end ValuationSubring
