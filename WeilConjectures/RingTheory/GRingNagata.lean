/-!
# Local G-rings and excellent local rings are Nagata

* A Noetherian domain with finitely many maximal ideals whose localizations at maximal ideals are
  N-1 is N-1 (`isN1_of_finite_maximal`): patch finite intermediate algebras normal above each
  maximal ideal (the argument of Stacks, Tag 0333, without the compactness step).
* A domain finite over a Noetherian local G-domain is N-1 (`isN1_of_finite_of_isGRing`): it is a
  semilocal G-ring, and its localizations at maximal ideals have regular completion maps, hence
  are analytically unramified and N-1 (Stacks, Tag 032Y).
* A Noetherian local G-domain is N-2 (`isN2_of_isGRing`): a finite extension `L` of the fraction
  field is the fraction field of a finite subalgebra generated by an integral basis.
* A Noetherian local G-ring is Nagata (`isNagataRing_of_isGRing`), so an excellent local ring is
  Nagata (`IsExcellentRing.isNagataRing`, the local case of Stacks, Tag 07QV).
-/

@[expose] public section

universe u v

open IsLocalRing

/-- A Noetherian domain with finitely many maximal ideals, whose localizations at all maximal
ideals are N-1, is N-1. -/
theorem isN1_of_finite_maximal (B : Type u) (L : Type v) [CommRing B] [IsDomain B]
    [IsNoetherianRing B] [Field L] [Algebra B L] [IsFractionRing B L]
    (hfin : {m : Ideal B | m.IsMaximal}.Finite)
    (hMax : ∀ (m : Ideal B) [m.IsMaximal],
      IsN1 (Localization.AtPrime m) (FractionRing (Localization.AtPrime m))) :
    IsN1 B L := by
  classical
  have hC (m : {m : Ideal B | m.IsMaximal}) : ∃ C : Subalgebra B L, C ≤ integralClosure B L ∧
      Module.Finite B C ∧ ∀ (q : Ideal C) [q.IsPrime], Ideal.comap (algebraMap B C) q = m.1 →
        IsIntegrallyClosed (Localization.AtPrime q) :=
    have : m.1.IsMaximal := m.2
    exists_local_normal_intermediate_algebra B L m.1 (hMax m.1)
  choose C hCi hCfin hCn using hC
  have : Finite {m : Ideal B | m.IsMaximal} := hfin.to_subtype
  let := Fintype.ofFinite {m : Ideal B | m.IsMaximal}
  let s : Finset (Subalgebra B L) := Finset.univ.image C
  have hs : ∀ D ∈ s, D ≤ integralClosure B L ∧ Module.Finite B D := by
    intro D hD
    obtain ⟨m, -, rfl⟩ := Finset.mem_image.mp hD
    exact ⟨hCi m, hCfin m⟩
  have hcover : ∀ (p : Ideal B) [p.IsPrime], ∃ D ∈ s, ∀ (q : Ideal D) [q.IsPrime],
      Ideal.comap (algebraMap B D) q = p → IsIntegrallyClosed (Localization.AtPrime q) := by
    intro p hp
    obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p hp.ne_top
    let m' : {m : Ideal B | m.IsMaximal} := ⟨m, hm⟩
    refine ⟨C m', Finset.mem_image_of_mem C (Finset.mem_univ _), fun q _ hq ↦ ?_⟩
    have : Algebra.IsIntegral B (C m') := le_integralClosure_iff_isIntegral.mp (hCi m')
    obtain ⟨Q, hqQ, hQ, hQm⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral m q (by rw [Ideal.under_def, hq]; exact hpm)
    have : IsIntegrallyClosed (Localization.AtPrime Q) := hCn m' Q hQm
    have hd : Disjoint (Q.primeCompl : Set (C m')) q :=
      Set.disjoint_left.mpr fun x hx hxq ↦ hx (hqQ hxq)
    let qQ := q.map (algebraMap (C m') (Localization.AtPrime Q))
    have : qQ.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint Q.primeCompl _ q ‹_› hd
    have hcomap : qQ.comap (algebraMap (C m') (Localization.AtPrime Q)) = q :=
      IsLocalization.under_map_of_isPrime_disjoint Q.primeCompl _ ‹_› hd
    have : IsIntegrallyClosed (Localization.AtPrime qQ) :=
      isIntegrallyClosed_of_isLocalization _ qQ.primeCompl qQ.primeCompl_le_nonZeroDivisors
    have key : ∀ (I J : Ideal (C m')) [I.IsPrime] [J.IsPrime], I = J →
        IsLocalization I.primeCompl (Localization.AtPrime qQ) →
          IsLocalization J.primeCompl (Localization.AtPrime qQ) := by
      rintro I J _ _ rfl h
      exact h
    have hloc : IsLocalization q.primeCompl (Localization.AtPrime qQ) := key _ _ hcomap
      (IsLocalization.isLocalization_atPrime_localization_atPrime Q.primeCompl qQ)
    exact IsIntegrallyClosed.of_equiv
      (IsLocalization.algEquiv q.primeCompl (Localization.AtPrime qQ)
        (Localization.AtPrime q)).toRingEquiv
  have hn := finite_normal_cover_sup_normal B L s (fun D hD ↦ (hs D hD).1) hcover
  obtain ⟨S, hS, hSfin, hSn⟩ := finite_normal_sup B L s _ rfl hs hn
  have : IsIntegrallyClosed S :=
    IsIntegrallyClosed.of_localization_maximal (fun q _ _ ↦ hSn q)
  have hclosure : integralClosure B L = S := by
    apply le_antisymm ?_ hS
    intro x hx
    obtain ⟨y, hy⟩ := (isIntegrallyClosed_iff L).mp ‹IsIntegrallyClosed S›
      (((mem_integralClosure_iff B L).mp hx).tower_top (A := S))
    exact hy ▸ y.property
  change Module.Finite B (integralClosure B L)
  rw [hclosure]
  exact hSfin

/-- A domain which is a finite algebra over a Noetherian local G-ring is N-1: it is a semilocal
G-ring, and its localizations at maximal ideals have regular completion maps, so they are
analytically unramified, hence N-1. -/
theorem isN1_of_finite_of_isGRing (A : Type u) (B : Type v) (L : Type*) [CommRing A]
    [IsLocalRing A] [CommRing B] [IsDomain B] [Algebra A B] [Module.Finite A B]
    (hA : IsGRing A) [Field L] [Algebra B L] [IsFractionRing B L] : IsN1 B L := by
  have hB : IsGRing B := isGRing_of_finiteType hA
  have := hA.1
  have := hB.1
  refine isN1_of_finite_maximal B L ?_ fun m _ ↦ ?_
  · refine (Algebra.QuasiFinite.finite_primesOver (R := A) (S := B) (maximalIdeal A)).subset ?_
    intro m (hm : m.IsMaximal)
    have : (m.under A).IsMaximal := inferInstance
    exact ⟨hm.isPrime, ⟨(IsLocalRing.eq_maximalIdeal this).symm⟩⟩
  · have := IsLocalization.isNoetherianRing m.primeCompl (Localization.AtPrime m) inferInstance
    exact isN1_of_isAnalyticallyUnramified _ _
      (isAnalyticallyUnramified_of_isRegular _ (hB.2 m))

/-- A Noetherian local domain which is a G-ring is N-2. A finite extension `L` of its fraction
field is the fraction field of the finite subalgebra `B` generated by an integral basis; the
integral closure of `A` in `L` lies in that of `B`, which is finite by
`isN1_of_finite_of_isGRing`. -/
theorem isN2_of_isGRing (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    (hA : IsGRing A) (K : Type v) [Field K] [Algebra A K] [IsFractionRing A K] : IsN2 A K := by
  intro L _ _ _ _ _
  classical
  have := hA.1
  obtain ⟨s, b, hb⟩ := FiniteDimensional.exists_is_basis_integral A K L
  let B := Algebra.adjoin A (Set.range b)
  have : Module.Finite A B := Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range b)
    (by rintro _ ⟨i, rfl⟩; exact hb i)
  have hAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have : FaithfulSMul B L := (faithfulSMul_iff_algebraMap_injective B L).mpr Subtype.val_injective
  have : IsFractionRing B L := by
    refine IsFractionRing.of_field B L fun z ↦ ?_
    let V : Submodule K L :=
      { carrier := {z | ∃ x y : B, y ≠ 0 ∧ z * (y : L) = x}
        add_mem' := by
          rintro z₁ z₂ ⟨x₁, y₁, hy₁, h₁⟩ ⟨x₂, y₂, hy₂, h₂⟩
          refine ⟨x₁ * y₂ + x₂ * y₁, y₁ * y₂, mul_ne_zero hy₁ hy₂, ?_⟩
          push_cast
          rw [← h₁, ← h₂]
          ring
        zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
        smul_mem' := by
          rintro c z ⟨x, y, hy, h⟩
          obtain ⟨⟨a, t⟩, hat⟩ := IsLocalization.surj (nonZeroDivisors A) c
          refine ⟨algebraMap A B a * x, algebraMap A B t * y, ?_, ?_⟩
          · refine mul_ne_zero (fun ht ↦ ?_) hy
            have : algebraMap A L t = 0 := congrArg Subtype.val ht
            exact nonZeroDivisors.coe_ne_zero t (hAL (this.trans (map_zero _).symm))
          · have hat' := congrArg (algebraMap K L) hat
            simp only [map_mul, ← IsScalarTower.algebraMap_apply] at hat'
            simp only [Algebra.smul_def, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            rw [← h, ← hat']
            ring }
    have hV : V = ⊤ := by
      refine eq_top_iff.mpr (b.span_eq ▸ Submodule.span_le.mpr ?_)
      rintro _ ⟨i, rfl⟩
      exact ⟨⟨b i, Algebra.subset_adjoin ⟨i, rfl⟩⟩, 1, one_ne_zero, mul_one _⟩
    obtain ⟨x, y, hy, h⟩ : z ∈ V := hV ▸ Submodule.mem_top
    refine ⟨x, y, (eq_div_iff ?_).mpr h⟩
    exact fun h0 ↦ hy (Subtype.ext h0)
  have : Module.Finite B (integralClosure B L) := isN1_of_finite_of_isGRing A B L hA
  have : IsScalarTower A B (integralClosure B L) :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : Module.Finite A (integralClosure B L) := Module.Finite.trans B _
  let i : integralClosure A L →ₗ[A] integralClosure B L :=
    { toFun := fun x ↦ ⟨x, x.2.tower_top⟩
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  exact Module.Finite.of_injective i fun x y h ↦
    Subtype.ext (by have := congrArg Subtype.val h; exact this)

/-- A Noetherian local G-ring is Nagata: its quotients by primes are local G-domains, hence N-2
(`isN2_of_isGRing`). -/
theorem isNagataRing_of_isGRing (R : Type u) [CommRing R] [IsLocalRing R] (hR : IsGRing R) :
    IsNagataRing R := by
  refine ⟨hR.1, fun p _ ↦ ?_⟩
  have := IsLocalRing.of_surjective' (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
  exact isN2_of_isGRing (R ⧸ p) (isGRing_quotient hR p) _

/-- An excellent local ring is Nagata (the local case of Stacks, Tag 07QV). -/
theorem IsExcellentRing.isNagataRing {R : Type u} [CommRing R] [IsLocalRing R]
    (hR : IsExcellentRing R) : IsNagataRing R :=
  isNagataRing_of_isGRing R hR.isGRing
