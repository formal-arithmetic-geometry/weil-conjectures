module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.LinearAlgebra.DFinsupp
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The ideal `(g₁x₁, …, gᵢxᵢ)` of a polynomial ring, coefficientwise

Let `R` be a commutative ring, `g : Fin r → R` and `J = (g_j x_j : j < i)` in `R[x_0, …, x_{r-1}]`.
For a multi-index `E` let `I_E ⊆ R` be the ideal generated by the `g_j` with `j < i` and
`E_j > 0`. A polynomial lies in `J` if and only if its coefficient of `x^E` lies in `I_E` for
every `E`; equivalently `R[x] ⧸ J ≅ ⨁_E R ⧸ I_E` as `R`-modules.

## Main statements

- `MvPolynomial.mem_span_C_mul_X_iff`
- `MvPolynomial.exists_linearMap_dfinsupp_quotient`

## References

- Stacks Project, proof of Lemma 10.68.1, <https://stacks.math.columbia.edu/tag/07DW>
-/

@[expose] public section

namespace MvPolynomial

variable {R : Type*} [CommRing R] {r : ℕ} (i : ℕ) (g : Fin r → R)

/-- The ideal `I_E ⊆ R` generated by the `g j` with `j < i` and `E j > 0`. -/
def coeffIdeal (E : Fin r →₀ ℕ) : Ideal R :=
  Ideal.span (g '' {j | (j : ℕ) < i ∧ 0 < E j})

lemma coeffIdeal_mono {E F : Fin r →₀ ℕ} (h : F ≤ E) : coeffIdeal i g F ≤ coeffIdeal i g E :=
  Ideal.span_mono <| Set.image_mono fun j ⟨hj, hF⟩ ↦ ⟨hj, lt_of_lt_of_le hF (h j)⟩

/-- A polynomial lies in `J = (g_j x_j : j < i)` if and only if each coefficient `c_E` lies in
`I_E`. (blueprint: `lem-weil-pbc-polynomial-ideal-coefficients-monomial`) -/
theorem mem_span_C_mul_X_iff (f : MvPolynomial (Fin r) R) :
    f ∈ Ideal.span (Set.range fun j : {j : Fin r // (j : ℕ) < i} ↦ C (g j) * X (j : Fin r)) ↔
      ∀ E, f.coeff E ∈ coeffIdeal i g E := by
  constructor
  · intro hf
    let K : Ideal (MvPolynomial (Fin r) R) :=
      { carrier := {f | ∀ E, f.coeff E ∈ coeffIdeal i g E}
        add_mem' := fun ha hb E ↦ by simpa using add_mem (ha E) (hb E)
        zero_mem' := fun E ↦ by simp
        smul_mem' := fun c f hf E ↦ by
          rw [smul_eq_mul, coeff_mul]
          refine Submodule.sum_mem _ fun x hx ↦ Ideal.mul_mem_left _ _ ?_
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
          exact coeffIdeal_mono i g (by rw [← hx]; exact le_add_self) (hf x.2) }
    refine (Ideal.span_le.mpr ?_ hf : f ∈ K)
    rintro _ ⟨⟨j, hj⟩, rfl⟩ E
    rw [coeff_C_mul, coeff_X]
    split_ifs with h
    · rw [mul_one]
      exact Ideal.subset_span ⟨j, ⟨hj, by simp [← h]⟩, rfl⟩
    · simp
  · intro hf
    rw [f.as_sum]
    refine Submodule.sum_mem _ fun E _ ↦ ?_
    have : coeffIdeal i g E ≤ (Submodule.restrictScalars R (Ideal.span (Set.range
        fun j : {j : Fin r // (j : ℕ) < i} ↦ C (g j) * X (j : Fin r)))).comap
        (monomial E) := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, ⟨hj, hE⟩, rfl⟩
      simp only [SetLike.mem_coe, Submodule.mem_comap, Submodule.restrictScalars_mem]
      have : monomial E (g j) = monomial (E - Finsupp.single j 1) 1 * (C (g j) * X j) := by
        rw [X, C_mul_monomial, monomial_mul, mul_one, one_mul, tsub_add_cancel_of_le]
        exact Finsupp.single_le_iff.mpr hE
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨j, hj⟩, rfl⟩)
    exact this (hf E)


/-- The `R`-linear map `R[x] → ⨁_E R ⧸ I_E`, `∑ c_E x^E ↦ (c_E mod I_E)_E`, is surjective with
kernel `J = (g_j x_j : j < i)`, so `R[x] ⧸ J ≅ ⨁_E (R ⧸ I_E) x^E`.
(blueprint: `lem-weil-pbc-polynomial-ideal-coefficients-monomial`) -/
theorem exists_linearMap_dfinsupp_quotient :
    ∃ φ : MvPolynomial (Fin r) R →ₗ[R] Π₀ E : Fin r →₀ ℕ, R ⧸ coeffIdeal i g E,
      (∀ f E, φ f E = Ideal.Quotient.mk _ (f.coeff E)) ∧ Function.Surjective φ ∧
      LinearMap.ker φ = (Ideal.span (Set.range
        fun j : {j : Fin r // (j : ℕ) < i} ↦ C (g j) * X (j : Fin r))).restrictScalars R := by
  classical
  let φ : MvPolynomial (Fin r) R →ₗ[R] Π₀ E : Fin r →₀ ℕ, R ⧸ coeffIdeal i g E :=
    (DFinsupp.mapRange.linearMap fun E ↦ (coeffIdeal i g E).mkQ) ∘ₗ
      (finsuppLequivDFinsupp R).toLinearMap ∘ₗ (basisMonomials _ R).repr.toLinearMap
  have hφ : ∀ f E, φ f E = Ideal.Quotient.mk _ (f.coeff E) := fun f E ↦ rfl
  refine ⟨φ, hφ, ?_, ?_⟩
  · intro d
    induction d using DFinsupp.induction with
    | h0 => exact ⟨0, map_zero _⟩
    | ha E c d _ _ ih =>
      obtain ⟨f, rfl⟩ := ih
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
      refine ⟨monomial E c + f, ?_⟩
      rw [map_add]
      congr 1
      ext F
      rw [hφ, coeff_monomial, DFinsupp.single_apply]
      by_cases h : E = F
      · subst h; simp
      · rw [if_neg h, dif_neg h, map_zero]
  · ext f
    simp only [LinearMap.mem_ker, Submodule.restrictScalars_mem, mem_span_C_mul_X_iff]
    rw [DFunLike.ext_iff]
    simp [hφ, Ideal.Quotient.eq_zero_iff_mem]

end MvPolynomial
