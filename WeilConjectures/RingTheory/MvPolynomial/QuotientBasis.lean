module

public import Mathlib.LinearAlgebra.Basis.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.Algebra.BigOperators.Finsupp.Basic

/-!
# Quotients of polynomial rings with a prescribed basis

Let `R` be a commutative ring, `n` a type and `w : Fin d → R[n]` a family of `d` polynomials.
For an `R`-algebra `A`, an ideal `I ⊆ A[n]` is *`w`-adapted*
(`MvPolynomial.IsQuotientBasis w I`) if the images of the `w l` form a basis of the
`A`-module `A[n] ⧸ I`. We construct an `R`-algebra `MvPolynomial.QuotientBasisRing w` and a
`w`-adapted ideal `MvPolynomial.quotientBasisIdeal w` of its polynomial ring which are
universal: `R`-algebra maps `QuotientBasisRing w →ₐ[R] A` correspond to `w`-adapted ideals of
`A[n]`, by extension of `quotientBasisIdeal w` (`MvPolynomial.quotientBasisEquiv`).

This is the affine scheme representing the subfunctor `F_W` of the Hilbert functor of points of
an affine space (blueprint `lem-pc-hilb-representable`, Step 4). The blueprint presents it by the
structure constants of the basis; we use instead the coordinates `v (m, k)` of the images of the
monomials `m` in the basis, subject to the relations saying that `w l` has coordinates `e_l`
and that multiplication by each variable is compatible with the coordinates.

## Main definitions

- `MvPolynomial.IsQuotientBasis`: the images of `w` form a basis of `A[n] ⧸ I`.
- `MvPolynomial.QuotientBasisRing`: the universal ring.
- `MvPolynomial.quotientBasisIdeal`: the universal `w`-adapted ideal.
- `MvPolynomial.quotientBasisEquiv`: the universal property.
-/

@[expose] public section

universe u

namespace MvPolynomial

variable {R : Type u} [CommRing R] {n : Type u} {d : ℕ} (w : Fin d → MvPolynomial n R)

/-- An ideal `I` of `A[n]`, for an `R`-algebra `A`, is `w`-adapted if the images of the
polynomials `w l` form a basis of the `A`-module `A[n] ⧸ I`. -/
def IsQuotientBasis {A : Type*} [CommRing A] [Algebra R A] (I : Ideal (MvPolynomial n A)) :
    Prop :=
  LinearIndependent A (fun l ↦ Ideal.Quotient.mk I (map (algebraMap R A) (w l))) ∧
    Submodule.span A (Set.range fun l ↦ Ideal.Quotient.mk I (map (algebraMap R A) (w l))) = ⊤

/-- Given coordinates `v (m, k)` for the monomials `m`, the `k`-th coordinate of a polynomial
`g`, namely `∑ₘ coeff m g * v (m, k)`. -/
noncomputable def quotientBasisCoord {A : Type*} [CommRing A] (v : (n →₀ ℕ) × Fin d → A)
    (g : MvPolynomial n A) (k : Fin d) : A :=
  ∑ m ∈ g.support, coeff m g * v (m, k)

/-- The relations of the universal ring: the coordinates of `w l` are `e_l`, and the coordinates
of `X i * m` are those of `∑ₗ v (m, l) • (X i * w l)`. -/
noncomputable def quotientBasisRelations : Ideal (MvPolynomial ((n →₀ ℕ) × Fin d) R) :=
  Ideal.span (Set.range (fun lk : Fin d × Fin d ↦
      quotientBasisCoord X (map C (w lk.1)) lk.2 - if lk.1 = lk.2 then 1 else 0) ∪
    Set.range (fun imk : n × (n →₀ ℕ) × Fin d ↦
      X (imk.2.1 + Finsupp.single imk.1 1, imk.2.2) -
        ∑ l, X (imk.2.1, l) * quotientBasisCoord X (map C (X imk.1 * w l)) imk.2.2))

/-- The universal ring of `w`-adapted ideals. -/
abbrev QuotientBasisRing : Type u :=
  MvPolynomial ((n →₀ ℕ) × Fin d) R ⧸ quotientBasisRelations w

/-- The ideal of `A[n]` generated by the `m - ∑ₗ v (m, l) • w l`, for the monomials `m`. -/
noncomputable def quotientBasisIdealOf {A : Type*} [CommRing A] [Algebra R A]
    (v : (n →₀ ℕ) × Fin d → A) : Ideal (MvPolynomial n A) :=
  Ideal.span (Set.range fun m ↦ monomial m 1 - ∑ l, C (v (m, l)) * map (algebraMap R A) (w l))

/-- The universal `w`-adapted ideal. -/
noncomputable def quotientBasisIdeal : Ideal (MvPolynomial n (QuotientBasisRing w)) :=
  quotientBasisIdealOf w fun x ↦ Ideal.Quotient.mk _ (X x)

theorem isQuotientBasis_quotientBasisIdeal : IsQuotientBasis w (quotientBasisIdeal w) :=
  sorry

/-- **The universal property of `QuotientBasisRing w`** (blueprint `lem-pc-hilb-representable`,
Step 4 (2)(a)). `R`-algebra maps `QuotientBasisRing w →ₐ[R] A` correspond to `w`-adapted ideals
of `A[n]`, by extending the universal ideal `quotientBasisIdeal w`. -/
noncomputable def quotientBasisEquiv (A : Type*) [CommRing A] [Algebra R A] :
    (QuotientBasisRing w →ₐ[R] A) ≃ {I : Ideal (MvPolynomial n A) // IsQuotientBasis w I} where
  toFun φ := ⟨(quotientBasisIdeal w).map (map φ.toRingHom), sorry⟩
  invFun I := Ideal.Quotient.liftₐ _ (aeval fun x ↦
    (Module.Basis.mk I.2.1 I.2.2.ge).repr (Ideal.Quotient.mk I.1 (monomial x.1 1)) x.2) sorry
  left_inv := sorry
  right_inv := sorry

theorem coe_quotientBasisEquiv_apply {A : Type*} [CommRing A] [Algebra R A]
    (φ : QuotientBasisRing w →ₐ[R] A) :
    (quotientBasisEquiv w A φ).1 = (quotientBasisIdeal w).map (map φ.toRingHom) :=
  rfl

end MvPolynomial
