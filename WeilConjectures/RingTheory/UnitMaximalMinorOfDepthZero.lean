module

public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Defs
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import WeilConjectures.LinearAlgebra.NonzeroMaximalMinorOfInjective

/-!
# Unit maximal minors over a local ring of depth zero

An injective map of finite free modules over a Noetherian local ring of depth zero has a unit
maximal minor.

## Implementation details

The proof reduces modulo the maximal ideal `m`: if `z` has annihilator `m`, then injectivity
of `A` forces the reduced matrix over the residue field to be injective, so it has a nonzero
maximal minor, whose lift is a unit since `R` is local.

## References

* Stacks Project, Algebra, Tags 00MY, 00MW (1), (3), 00MV and 00MT
-/

@[expose] public section

universe u

namespace Matrix

/-- An injective map between finite free modules over a Noetherian local ring whose maximal
ideal is the annihilator of an element has a unit maximal row minor. The ideal generated by
these minors is the whole ring. Rows are listed in increasing order; for zero columns the
empty determinant is one. -/
theorem exists_isUnit_maximal_minor_of_annihilator_eq_maximalIdeal
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {n p : ℕ} (A : Matrix (Fin p) (Fin n) R)
    (hdepth : ∃ z : R, ∀ a : R, a * z = 0 ↔ a ∈ IsLocalRing.maximalIdeal R)
    (hinj : Function.Injective A.mulVec) :
    n ≤ p ∧
      (∃ r : Fin n → Fin p, StrictMono r ∧ IsUnit (A.submatrix r id).det) ∧
      Ideal.span {d : R | ∃ r : Fin n → Fin p, StrictMono r ∧
        d = (A.submatrix r id).det} = ⊤ := by
  classical
  obtain ⟨z, hz⟩ := hdepth
  let q := IsLocalRing.residue R
  have hker : ∀ v : Fin n → IsLocalRing.ResidueField R,
      (A.map q).mulVec v = 0 → v = 0 := by
    intro v hv
    choose w hw using fun j ↦ IsLocalRing.residue_surjective (v j)
    have hqw : q ∘ w = v := funext hw
    have haw : ∀ i, (A.mulVec w) i ∈ IsLocalRing.maximalIdeal R := by
      intro i
      apply (IsLocalRing.residue_eq_zero_iff _).mp
      change q ((A.mulVec w) i) = 0
      rw [q.map_mulVec, hqw, hv]
      rfl
    have hzw : A.mulVec (z • w) = A.mulVec 0 := by
      rw [mulVec_smul, mulVec_zero]
      ext i
      change z * (A.mulVec w) i = 0
      rw [mul_comm]
      exact (hz _).mpr (haw i)
    have hzero := hinj hzw
    ext j
    rw [← hw j]
    apply (IsLocalRing.residue_eq_zero_iff _).mpr
    apply (hz _).mp
    have hj := congr_fun hzero j
    change z * w j = 0 at hj
    simpa only [mul_comm] using hj
  have hred : Function.Injective (A.map q).mulVec := by
    intro v w hvw
    apply sub_eq_zero.mp
    apply hker
    rw [mulVec_sub, hvw, sub_self]
  obtain ⟨hnp, r, hr, hd, _⟩ :=
    exists_strictMono_submatrix_det_ne_zero_of_mulVec_injective (A.map q) hred
  have hu : IsUnit (A.submatrix r id).det := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    change q (A.submatrix r id).det ≠ 0
    rw [q.map_det]
    exact hd
  refine ⟨hnp, ⟨r, hr, hu⟩, ?_⟩
  apply Ideal.eq_top_of_isUnit_mem _ _ hu
  exact Ideal.subset_span ⟨r, hr, rfl⟩

end Matrix
