module

public import Mathlib.Algebra.Polynomial.Coeff
public import Mathlib.RingTheory.Polynomial.Basic
public import WeilConjectures.RingTheory.GradedAlgebra.Standard

/-!
# The graded algebra `⊕ₙ Vⁿ tⁿ` of a submodule

Let `K` be a commutative `k`-algebra and `V` a `k`-submodule of `K`. The polynomials
`F ∈ K[t]` whose coefficient of `tⁿ` lies in `Vⁿ` for all `n` form a `k`-subalgebra
`V.powersAlgebra = ⊕ₙ Vⁿ tⁿ` of `K[t]`, graded by the degree in `t`. If `V` is finitely
generated, it is a standard graded `k`-algebra, generated by `V t`; if `K` is a domain, so is
`V.powersAlgebra`.

If `V` is spanned by `a₀, …, aₙ`, then `V.powersAlgebra = k[a₀ t, …, aₙ t]` is the
homogeneous coordinate ring of the "point" `[a₀ : … : aₙ]` with coordinates in `K`; this is how
the homogeneous coordinate ring of an integral closed subscheme of projective space is
constructed in `AlgebraicGeometry.exists_isStandard_iso_proj`, with `K` its function field.

## Main definitions

- `Submodule.powersAlgebra V` — the subalgebra `⊕ₙ Vⁿ tⁿ` of `K[t]`.
- `Submodule.powersGrading V` — its grading by the degree in `t`.

## Main statements

- `Submodule.powersGrading_isInternal` — the grading is an internal direct sum.
- `Submodule.isStandard_powersGrading` — if `V` is finitely generated, the grading is
  standard.
-/

@[expose] public section

open Polynomial

namespace Submodule

variable {k K : Type*} [CommRing k] [CommRing K] [Algebra k K] (V : Submodule k K)

/-- The `k`-subalgebra `⊕ₙ Vⁿ tⁿ` of `K[t]`: the polynomials whose coefficient of `tⁿ` lies
in `Vⁿ` for all `n`. -/
def powersAlgebra : Subalgebra k K[X] where
  carrier := {F | ∀ d, F.coeff d ∈ V ^ d}
  mul_mem' {F G} hF hG d := by
    rw [coeff_mul]
    refine sum_mem fun x hx => ?_
    rw [← Finset.mem_antidiagonal.mp hx, pow_add]
    exact mul_mem_mul (hF _) (hG _)
  add_mem' {F G} hF hG d := by
    rw [coeff_add]
    exact add_mem (hF d) (hG d)
  algebraMap_mem' c d := by
    rw [Polynomial.algebraMap_apply, coeff_C]
    split_ifs with h
    · subst h
      rw [pow_zero]
      exact algebraMap_mem c
    · exact zero_mem _

variable {V}

lemma mem_powersAlgebra {F : K[X]} : F ∈ V.powersAlgebra ↔ ∀ d, F.coeff d ∈ V ^ d :=
  Iff.rfl

lemma monomial_mem_powersAlgebra {d : ℕ} {c : K} (hc : c ∈ V ^ d) :
    monomial d c ∈ V.powersAlgebra := fun e => by
  rw [coeff_monomial]
  split_ifs with h
  · exact h ▸ hc
  · exact zero_mem _

variable (V)

/-- The degree-`d` part of `⊕ₙ Vⁿ tⁿ`: the elements `c tᵈ` with `c ∈ Vᵈ`. -/
def powersGrading (d : ℕ) : Submodule k V.powersAlgebra where
  carrier := {F | ∀ e, e ≠ d → (F : K[X]).coeff e = 0}
  add_mem' {F G} hF hG e he := by
    simp [coeff_add, hF e he, hG e he]
  zero_mem' e _ := by simp
  smul_mem' c F hF e he := by
    change ((c • F : V.powersAlgebra) : K[X]).coeff e = 0
    rw [SetLike.val_smul, coeff_smul, hF e he, smul_zero]

variable {V}

lemma mem_powersGrading_iff {d : ℕ} {F : V.powersAlgebra} :
    F ∈ V.powersGrading d ↔ ∀ e, e ≠ d → (F : K[X]).coeff e = 0 :=
  Iff.rfl

/-- The element `c tᵈ` of `⊕ₙ Vⁿ tⁿ`, for `c ∈ Vᵈ`. -/
noncomputable def powersMonomial {d : ℕ} (c : K) (hc : c ∈ V ^ d) : V.powersAlgebra :=
  ⟨monomial d c, monomial_mem_powersAlgebra hc⟩

@[simp]
lemma coe_powersMonomial {d : ℕ} (c : K) (hc : c ∈ V ^ d) :
    (powersMonomial c hc : K[X]) = monomial d c :=
  rfl

lemma powersMonomial_mem {d : ℕ} (c : K) (hc : c ∈ V ^ d) :
    powersMonomial c hc ∈ V.powersGrading d := fun e he => by
  rw [coe_powersMonomial, coeff_monomial, if_neg he.symm]

lemma powersMonomial_mul {d e : ℕ} (a b : K) (ha : a ∈ V ^ d) (hb : b ∈ V ^ e) :
    powersMonomial a ha * powersMonomial b hb =
      powersMonomial (d := d + e) (a * b) (by rw [pow_add]; exact mul_mem_mul ha hb) :=
  Subtype.ext <| by simp [monomial_mul_monomial]

lemma coeff_mem_pow (F : V.powersAlgebra) (d : ℕ) : (F : K[X]).coeff d ∈ V ^ d :=
  F.2 d

/-- Membership in the degree-`d` part: `F = c tᵈ` for some `c ∈ Vᵈ`. -/
lemma mem_powersGrading_iff_exists {d : ℕ} {F : V.powersAlgebra} :
    F ∈ V.powersGrading d ↔ ∃ (c : K) (hc : c ∈ V ^ d), F = powersMonomial c hc := by
  constructor
  · intro hF
    refine ⟨(F : K[X]).coeff d, coeff_mem_pow F d, Subtype.ext (Polynomial.ext fun e => ?_)⟩
    rw [coe_powersMonomial, coeff_monomial]
    by_cases h : d = e
    · rw [if_pos h, h]
    · rw [if_neg h, hF e fun he => h he.symm]
  · rintro ⟨c, hc, rfl⟩
    exact powersMonomial_mem c hc

variable (V)

instance powersGrading.instGradedMonoid : SetLike.GradedMonoid V.powersGrading where
  one_mem e he := by
    rw [OneMemClass.coe_one, coeff_one, if_neg he]
  mul_mem {d e F G} hF hG := by
    obtain ⟨a, ha, rfl⟩ := mem_powersGrading_iff_exists.mp hF
    obtain ⟨b, hb, rfl⟩ := mem_powersGrading_iff_exists.mp hG
    rw [powersMonomial_mul]
    exact powersMonomial_mem _ _

/-- The grading of `⊕ₙ Vⁿ tⁿ` by the degree in `t` is an internal direct sum
decomposition. -/
lemma powersGrading_isInternal : DirectSum.IsInternal V.powersGrading := by
  classical
  constructor
  · rw [injective_iff_map_eq_zero]
    intro v hv
    have hne : ∀ j e : ℕ, j ≠ e → ((v j : V.powersAlgebra) : K[X]).coeff e = 0 :=
      fun j e hje => (v j).2 e hje.symm
    have hsum : (∑ i ∈ DFinsupp.support v, ((v i : V.powersAlgebra) : K[X])) = 0 := by
      rw [← AddSubmonoidClass.coe_finsetSum]
      norm_cast
      calc (∑ i ∈ DFinsupp.support v, (v i : V.powersAlgebra))
          = DirectSum.coeAddMonoidHom V.powersGrading v := by
            conv_rhs => rw [← DirectSum.sum_support_of v]
            rw [map_sum]
            simp [DirectSum.coeAddMonoidHom_of]
        _ = 0 := hv
    ext e : 1
    refine Subtype.ext (Subtype.ext (Polynomial.ext fun j => ?_))
    rcases ne_or_eq j e with hje | rfl
    · simpa using hne e j hje.symm
    · have h1 := congrArg (fun p : K[X] => p.coeff j) hsum
      simp only [finsetSum_coeff, coeff_zero] at h1
      rw [Finset.sum_eq_single j (fun i _ hij => hne i j hij)
        (fun hjs => by rw [DFinsupp.notMem_support_iff.mp hjs]; simp)] at h1
      simpa using h1
  · intro F
    refine ⟨∑ d ∈ (F : K[X]).support, DirectSum.of (fun d => (V.powersGrading d : Type _)) d
      ⟨powersMonomial ((F : K[X]).coeff d) (coeff_mem_pow F d), powersMonomial_mem _ _⟩, ?_⟩
    rw [map_sum]
    refine Subtype.ext ?_
    simp only [DirectSum.coeAddMonoidHom_of]
    rw [AddSubmonoidClass.coe_finsetSum]
    simp only [coe_powersMonomial]
    exact ((F : K[X]).as_sum_support).symm

noncomputable instance powersGrading.instGradedAlgebra : GradedAlgebra V.powersGrading where
  __ := (inferInstance : SetLike.GradedMonoid V.powersGrading)
  __ := (powersGrading_isInternal V).chooseDecomposition

/-- The degree-one part of `⊕ₙ Vⁿ tⁿ` is `V t`. -/
lemma map_val_powersGrading_one :
    (V.powersGrading 1).map V.powersAlgebra.val.toLinearMap =
      V.map ((monomial 1 : K →ₗ[K] K[X]).restrictScalars k) := by
  ext F
  simp only [mem_map, AlgHom.toLinearMap_apply, Subalgebra.coe_val]
  constructor
  · rintro ⟨G, hG, rfl⟩
    obtain ⟨c, hc, rfl⟩ := mem_powersGrading_iff_exists.mp hG
    exact ⟨c, by simpa using hc, rfl⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨powersMonomial (d := 1) c (by simpa using hc), powersMonomial_mem _ _, rfl⟩

lemma powersMonomial_mem_adjoin {d : ℕ} (c : K) (hc : c ∈ V ^ d) :
    powersMonomial c hc ∈
      Algebra.adjoin k (V.powersGrading 1 : Set V.powersAlgebra) := by
  induction d generalizing c with
  | zero =>
    obtain ⟨r, rfl⟩ := (Submodule.mem_one).mp (by simpa using hc)
    convert (Algebra.adjoin k (V.powersGrading 1 : Set V.powersAlgebra)).algebraMap_mem r
    exact Subtype.ext (by simp [Polynomial.algebraMap_apply, monomial_zero_left])
  | succ d ih =>
    have hc' : c ∈ V ^ d * V := by rwa [← pow_succ]
    revert hc
    induction hc' using Submodule.mul_induction_on' with
    | mem_mul_mem a ha b hb =>
      intro hab
      have : powersMonomial (d := d + 1) (a * b) hab =
          powersMonomial a ha * powersMonomial (d := 1) b (by simpa using hb) := by
        rw [powersMonomial_mul]
      rw [this]
      exact mul_mem (ih a ha) (Algebra.subset_adjoin (powersMonomial_mem _ _))
    | add x hx y hy ihx ihy =>
      intro hxy
      have hx' : x ∈ V ^ (d + 1) := by rwa [pow_succ]
      have hy' : y ∈ V ^ (d + 1) := by rwa [pow_succ]
      have : powersMonomial (d := d + 1) (x + y) hxy =
          powersMonomial x hx' + powersMonomial y hy' :=
        Subtype.ext (by simp)
      rw [this]
      exact add_mem (ihx hx') (ihy hy')

instance [IsDomain K] : IsDomain V.powersAlgebra :=
  inferInstance

end Submodule

namespace Submodule

open Polynomial

variable {k K : Type*} [Field k] [CommRing K] [Algebra k K] {V : Submodule k K}

/-- If `V` is finitely generated, `⊕ₙ Vⁿ tⁿ` is a standard graded `k`-algebra, generated by
`V t`. -/
theorem isStandard_powersGrading (hV : V.FG) : GradedAlgebra.IsStandard V.powersGrading where
  fg_one := Submodule.fg_of_fg_map_injective _ Subtype.val_injective
    (by rw [map_val_powersGrading_one]; exact hV.map _)
  adjoin_one := by
    classical
    refine eq_top_iff.mpr fun F _ => ?_
    have : F = ∑ d ∈ (F : K[X]).support, powersMonomial ((F : K[X]).coeff d)
        (coeff_mem_pow F d) := by
      refine Subtype.ext ?_
      rw [AddSubmonoidClass.coe_finsetSum]
      simp only [coe_powersMonomial]
      exact (F : K[X]).as_sum_support
    rw [this]
    exact sum_mem fun d _ => powersMonomial_mem_adjoin V _ _

end Submodule
