module

public import Mathlib.RingTheory.HopfAlgebra.Convolution
public import Mathlib.RingTheory.HopfAlgebra.Quotient
public import WeilConjectures.Mathlib.RingTheory.TensorProduct.Maps

/-!
# Hopf ideals generated by a set

In a commutative Hopf algebra `A` over `R` the counit, the comultiplication followed by the
quotient map `A ⊗ A → (A ⧸ I) ⊗ (A ⧸ I)`, and the antipode are algebra homomorphisms. Hence the
ideal `I = span s` generated by a set `s` is a Hopf ideal as soon as the three Hopf ideal
conditions hold on the generators.

## Main results

- `Ideal.isHopfIdeal_span`: a criterion for `Ideal.span s` to be a Hopf ideal in terms of the
  generators `s`.
-/

@[expose] public section

open TensorProduct

variable {R A : Type*} [CommRing R] [CommRing A] [HopfAlgebra R A]

/-- **Hopf ideals generated by a set.** The ideal generated by a set `s` in a commutative Hopf
algebra is a Hopf ideal if the counit vanishes on `s`, the comultiplication of every element of
`s` vanishes in `(A ⧸ span s) ⊗ (A ⧸ span s)`, and the antipode maps `s` into `span s`. -/
theorem Ideal.isHopfIdeal_span {s : Set A}
    (hcounit : ∀ x ∈ s, Coalgebra.counit (R := R) x = 0)
    (hcomul : ∀ x ∈ s, Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R (Ideal.span s))
      (Ideal.Quotient.mkₐ R (Ideal.span s)) (Coalgebra.comul (R := R) x) = 0)
    (hantipode : ∀ x ∈ s, HopfAlgebra.antipode R x ∈ Ideal.span s) :
    (Ideal.span s).IsHopfIdeal R where
  counit_eq_zero x hx := by
    have hle : Ideal.span s ≤ RingHom.ker (Bialgebra.counitAlgHom R A) :=
      Ideal.span_le.2 fun y hy ↦ hcounit y hy
    exact hle hx
  map_mkQ_comul_eq_zero x hx := by
    rw [Algebra.TensorProduct.map_mkQ_restrictScalars_eq_zero_iff]
    have hle : Ideal.span s ≤ RingHom.ker ((Algebra.TensorProduct.map
        (Ideal.Quotient.mkₐ R (Ideal.span s)) (Ideal.Quotient.mkₐ R (Ideal.span s))).comp
          (Bialgebra.comulAlgHom R A)) :=
      Ideal.span_le.2 fun y hy ↦ hcomul y hy
    exact hle hx
  antipode_mem x hx := by
    have hle : Ideal.span s ≤ (Ideal.span s).comap (HopfAlgebra.antipodeAlgHom R A) :=
      Ideal.span_le.2 fun y hy ↦ hantipode y hy
    exact hle hx
