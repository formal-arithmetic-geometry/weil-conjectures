/-!
# `p`-bases of fields of characteristic `p`

Let `K / k` be an extension of fields of characteristic `p`, and let `k K^p` be the subfield of
`K` generated by `k` and the `p`-th powers of elements of `K`. A family `(x_i)_{i ∈ I}` of
elements of `K` is *`p`-independent* over `k` if the monomials `x^E = ∏ x_i ^ (E i)`, for
finitely supported exponents `0 ≤ E i < p`, are linearly independent over `k K^p`; it is a
*`p`-basis* if these monomials form a basis of `K` over `k K^p` (Stacks, Tag 07P1).

## Main statements

- `Field.exists_pBasis_extension`: a `p`-independent family extends to a `p`-basis
  (Stacks, Tag 07P2).
- `Field.exists_pBasis`: every field of characteristic `p` has a `p`-basis over `k^p`.

Both are deduced from versions over an arbitrary field `F → K` containing all `p`-th powers
(`Field.exists_pBasis_extension_of_pow_mem`, `Field.exists_pBasis_of_pow_mem`).

## Implementation notes

We work with subsets `S ⊆ K` and exponents `E : K →₀ ℕ` supported in `S` with values `< p`.
By Zorn's lemma there is a maximal `p`-independent set `T`; if `x` is not in the field
`L = F(T)`, then `x ^ p ∈ L` and `X ^ p - x ^ p` is irreducible over `L`, so the powers
`1, x, …, x ^ (p - 1)` are `L`-independent and `T ∪ {x}` is still `p`-independent. Hence
`L = K`, and `L` is spanned over `F` by the reduced monomials of `T`.
-/

@[expose] public section

open Function Set Module

namespace Field

namespace PBasisAux

variable {K : Type*} [Field K]

/-- Monomial of an exponent function. -/
noncomputable def mono (E : K →₀ ℕ) : K := E.prod fun s e => s ^ e

/-- Reduced exponents supported in `S`. -/
def red (p : ℕ) (S : Set K) : Set (K →₀ ℕ) := {E | ↑E.support ⊆ S ∧ ∀ s, E s < p}

lemma mono_add (E E' : K →₀ ℕ) : mono (E + E') = mono E * mono E' :=
  Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)

lemma mono_zero : mono (0 : K →₀ ℕ) = 1 := Finsupp.prod_zero_index

lemma mono_single (s : K) (n : ℕ) : mono (Finsupp.single s n) = s ^ n :=
  Finsupp.prod_single_index (pow_zero _)

lemma mono_nsmul (n : ℕ) (E : K →₀ ℕ) : mono (n • E) = mono E ^ n := by
  induction n with
  | zero => simp [mono_zero]
  | succ n ih => rw [succ_nsmul, mono_add, ih, pow_succ]

omit [Field K] in
lemma red_mono {p : ℕ} {S T : Set K} (h : S ⊆ T) : red p S ⊆ red p T :=
  fun _ hE => ⟨hE.1.trans h, hE.2⟩

variable {F : Type*} [Field F] [Algebra F K] {p : ℕ}

/-- Every monomial is an `F`-multiple of a reduced one. -/
lemma mono_eq_smul (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range)
    (E : K →₀ ℕ) : ∃ c : F, mono E = c • mono (E.mapRange (· % p) (Nat.zero_mod p)) := by
  have hE : E = p • E.mapRange (· / p) (Nat.zero_div p) +
      E.mapRange (· % p) (Nat.zero_mod p) := by
    ext s; simp [Nat.div_add_mod]
  obtain ⟨c, hc⟩ := hF (mono (E.mapRange (· / p) (Nat.zero_div p)))
  refine ⟨c, ?_⟩
  conv_lhs => rw [hE]
  rw [mono_add, mono_nsmul, Algebra.smul_def, hc]

omit [Field K] in
lemma mapRange_mod_mem_red (hp : 0 < p) {S : Set K} {E : K →₀ ℕ} (hE : ↑E.support ⊆ S) :
    E.mapRange (· % p) (Nat.zero_mod p) ∈ red p S :=
  ⟨(Finset.coe_subset.2 Finsupp.support_mapRange).trans hE, fun _ => Nat.mod_lt _ hp⟩

lemma isAlgebraic (hp : 0 < p) (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range) (x : K) :
    IsAlgebraic F x := by
  obtain ⟨a, ha⟩ := hF x
  refine ⟨Polynomial.X ^ p - Polynomial.C a,
    (Polynomial.monic_X_pow_sub_C a hp.ne').ne_zero, ?_⟩
  simp [ha]

/-- The field generated by `F` and `S` is the `F`-span of reduced monomials of `S`. -/
lemma mem_span_of_mem_adjoin (hp : 0 < p) (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range)
    (S : Set K) {y : K} (hy : y ∈ IntermediateField.adjoin F S) :
    y ∈ Submodule.span F (mono '' red p S) := by
  classical
  have hy' : y ∈ Subalgebra.toSubmodule (Algebra.adjoin F S) := by
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
      (fun x _ => isAlgebraic hp hF x)]
    exact hy
  rw [Algebra.adjoin_eq_span] at hy'
  refine (Submodule.span_le.2 ?_) hy'
  intro m hm
  have : ∃ E : K →₀ ℕ, ↑E.support ⊆ S ∧ m = mono E := by
    induction hm using Submonoid.closure_induction with
    | mem x hx =>
      refine ⟨Finsupp.single x 1, ?_, ((mono_single x 1).trans (pow_one x)).symm⟩
      exact (Finset.coe_subset.2 Finsupp.support_single_subset).trans (by simpa using hx)
    | one => exact ⟨0, by simp, mono_zero.symm⟩
    | mul x y _ _ hx hy =>
      obtain ⟨E, hE, rfl⟩ := hx
      obtain ⟨E', hE', rfl⟩ := hy
      refine ⟨E + E', ?_, (mono_add E E').symm⟩
      exact (Finset.coe_subset.2 Finsupp.support_add).trans (by simpa using And.intro hE hE')
  obtain ⟨E, hE, rfl⟩ := this
  obtain ⟨c, hc⟩ := mono_eq_smul hF E
  rw [SetLike.mem_coe, hc]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, mapRange_mod_mem_red hp hE, rfl⟩)

omit [Field K] in
lemma red_insert_mem [NeZero p] {T : Set K} {x : K} (hx : x ∉ T) (E : red p T) (j : Fin p) :
    E.1 + Finsupp.single x (j : ℕ) ∈ red p (insert x T) := by
  classical
  refine ⟨?_, fun s => ?_⟩
  · refine (Finset.coe_subset.2 Finsupp.support_add).trans ?_
    intro s hs
    simp only [Finset.coe_union, Set.mem_union, Finset.mem_coe] at hs
    rcases hs with hs | hs
    · exact Set.mem_insert_of_mem _ (E.2.1 hs)
    · rw [Finset.mem_coe.1 (Finsupp.support_single_subset hs) |> Finset.mem_singleton.1]
      exact Set.mem_insert _ _
  · have hEx : E.1 x = 0 := Finsupp.notMem_support_iff.1 fun h => hx (E.2.1 h)
    by_cases hs : s = x
    · subst hs; simp [hEx]
    · simpa [Finsupp.single_apply, Ne.symm hs] using E.2.2 s

omit [Field K] in
lemma red_insert_bij [NeZero p] {T : Set K} {x : K} (hx : x ∉ T) :
    Bijective (fun q : red p T × Fin p =>
      (⟨q.1.1 + Finsupp.single x (q.2 : ℕ), red_insert_mem hx q.1 q.2⟩ :
        red p (insert x T))) := by
  classical
  have hEx : ∀ E : red p T, E.1 x = 0 := fun E =>
    Finsupp.notMem_support_iff.1 fun h => hx (E.2.1 h)
  constructor
  · rintro ⟨E, j⟩ ⟨E', j'⟩ h
    have h' : E.1 + Finsupp.single x (j : ℕ) = E'.1 + Finsupp.single x (j' : ℕ) :=
      congrArg Subtype.val h
    have hj : (j : ℕ) = j' := by
      simpa [hEx] using DFunLike.congr_fun h' x
    have hj' : j = j' := Fin.ext hj
    subst hj'
    exact Prod.ext (Subtype.ext (add_right_cancel h')) rfl
  · rintro ⟨G, hG⟩
    refine ⟨(⟨G.erase x, ?_, fun s => ?_⟩, ⟨G x, hG.2 x⟩), ?_⟩
    · intro s hs
      rw [Finset.mem_coe, Finsupp.support_erase, Finset.mem_erase] at hs
      exact (hG.1 hs.2).resolve_left hs.1
    · exact lt_of_le_of_lt (by rw [Finsupp.erase_apply]; split_ifs <;> simp) (hG.2 s)
    · exact Subtype.ext (by simpa [add_comm] using Finsupp.single_add_erase x G)


variable [Fact p.Prime] [CharP K p]

/-- Adjoining an element outside the generated field keeps `p`-independence. -/
lemma linearIndepOn_red_insert (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range) {T : Set K}
    (hT : LinearIndepOn F mono (red p T)) {x : K} (hx : x ∉ IntermediateField.adjoin F T) :
    LinearIndepOn F mono (red p (insert x T)) := by
  classical
  have hp := (Fact.out : p.Prime)
  set L := IntermediateField.adjoin F T
  have hxT : x ∉ T := fun h => hx (IntermediateField.subset_adjoin F T h)
  have hxp : x ^ p ∈ L := by
    obtain ⟨a, ha⟩ := hF x
    rw [← ha]; exact L.algebraMap_mem a
  have hmin : minpoly L x = Polynomial.X ^ p - Polynomial.C ⟨x ^ p, hxp⟩ := by
    refine (minpoly.eq_of_irreducible_of_monic ?_ ?_
      (Polynomial.monic_X_pow_sub_C _ hp.ne_zero)).symm
    · refine X_pow_sub_C_irreducible_of_prime hp fun b hb => hx ?_
      have : (b : K) ^ p = x ^ p := congrArg Subtype.val hb
      have : (b : K) = x := frobenius_inj K p this
      exact this ▸ b.2
    · simp
  have hdeg : (minpoly L x).natDegree = p := by
    rw [hmin]; exact Polynomial.natDegree_X_pow_sub_C
  have hc := linearIndependent_pow (K := L) x
  rw [hdeg] at hc
  have hmemL : ∀ E : red p T, mono E.1 ∈ L := fun E =>
    prod_mem fun s hs => pow_mem (IntermediateField.subset_adjoin F T (E.2.1 hs)) _
  have hb : LinearIndependent F (fun E : red p T => (⟨mono E.1, hmemL E⟩ : L)) :=
    LinearIndependent.of_comp L.val.toLinearMap hT
  have hprod := linearIndependent_smul hb hc
  refine (linearIndependent_equiv' (Equiv.ofBijective _ (red_insert_bij hxT)) ?_).1 hprod
  ext ⟨E, j⟩
  simp [mono_add, mono_single, Algebra.smul_def]

omit [Fact p.Prime] [CharP K p] in
/-- `p`-independence of a union of a chain. -/
lemma linearIndepOn_red_sUnion {c : Set (Set K)} (hchain : IsChain (· ⊆ ·) c)
    (hne : c.Nonempty) (h : ∀ S ∈ c, LinearIndepOn F mono (red p S)) :
    LinearIndepOn F mono (red p (⋃₀ c)) := by
  refine (linearIndepOn_biUnion_of_directed (t := red p) ?_ h).mono ?_
  · intro a ha b hb
    obtain ⟨z, hz, haz, hbz⟩ := hchain.directedOn a ha b hb
    exact ⟨z, hz, red_mono haz, red_mono hbz⟩
  · intro E hE
    rw [Set.sUnion_eq_biUnion] at hE
    obtain ⟨S, hS, hES⟩ :=
      DirectedOn.exists_mem_subset_of_finset_subset_biUnion (f := fun S => S) hne
        hchain.directedOn hE.1
    exact Set.mem_biUnion hS ⟨hES, hE.2⟩

/-- A `p`-independent set extends to a `p`-independent set whose reduced monomials span. -/
lemma exists_red_span (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range) (S0 : Set K)
    (h0 : LinearIndepOn F mono (red p S0)) :
    ∃ T, S0 ⊆ T ∧ LinearIndepOn F mono (red p T) ∧
      ∀ y : K, y ∈ Submodule.span F (mono '' red p T) := by
  have hp := (Fact.out : p.Prime)
  obtain ⟨T, hST, hT⟩ := zorn_subset_nonempty {S : Set K | LinearIndepOn F mono (red p S)}
    (fun c hc hchain hne => ⟨⋃₀ c, linearIndepOn_red_sUnion hchain hne hc,
      fun s hs => Set.subset_sUnion_of_mem hs⟩) S0 h0
  refine ⟨T, hST, hT.prop, fun y => mem_span_of_mem_adjoin hp.pos hF T ?_⟩
  by_contra hy
  have hTy := hT.eq_of_subset (linearIndepOn_red_insert hF hT.prop hy) (Set.subset_insert _ _)
  have : y ∈ T := by rw [hTy]; exact Set.mem_insert y T
  exact hy (IntermediateField.subset_adjoin F T this)

omit [Field K] [Fact p.Prime] [CharP K p] in
lemma mapDomain_mem_red [NeZero p] {ι : Type*} {z : ι → K} (hz : Injective z) {T : Set K}
    (hzT : range z = T) (E : {E : ι →₀ ℕ // ∀ i, E i < p}) :
    E.1.mapDomain z ∈ red p T := by
  classical
  subst hzT
  refine ⟨?_, fun s => ?_⟩
  · intro s hs
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support (Finset.mem_coe.1 hs))
    exact ⟨i, rfl⟩
  · by_cases hs : s ∈ range z
    · obtain ⟨i, rfl⟩ := hs
      rw [Finsupp.mapDomain_apply hz]; exact E.2 i
    · rw [Finsupp.mapDomain_of_notMem_range _ _ hs]; exact Nat.pos_of_neZero p

omit [Field K] [Fact p.Prime] [CharP K p] in
lemma mapDomain_red_bij [NeZero p] {ι : Type*} {z : ι → K} (hz : Injective z) {T : Set K}
    (hzT : range z = T) :
    Bijective (fun E : {E : ι →₀ ℕ // ∀ i, E i < p} =>
      (⟨E.1.mapDomain z, mapDomain_mem_red hz hzT E⟩ : red p T)) := by
  refine ⟨fun E E' h => Subtype.ext (Finsupp.mapDomain_injective hz (congrArg Subtype.val h)),
    fun G => ?_⟩
  have hG : ↑G.1.support ⊆ range z := hzT ▸ G.2.1
  refine ⟨⟨G.1.comapDomain z hz.injOn, fun i => ?_⟩, Subtype.ext ?_⟩
  · rw [Finsupp.comapDomain_apply]; exact G.2.2 _
  · exact Finsupp.mapDomain_comapDomain z hz G.1 hG

omit [Fact p.Prime] [CharP K p] in
lemma mono_mapDomain {ι : Type*} (z : ι → K) (E : ι →₀ ℕ) :
    mono (E.mapDomain z) = E.prod fun i e => z i ^ e :=
  Finsupp.prod_mapDomain_index (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)

omit [Fact p.Prime] [CharP K p] in
/-- Transport a basis of reduced monomials of `T` to a family indexed by `ι`. -/
lemma exists_basis_of_injective [NeZero p] {ι : Type*} {z : ι → K} (hz : Injective z)
    {T : Set K} (hzT : range z = T) (hT : LinearIndepOn F mono (red p T))
    (hsp : ∀ y : K, y ∈ Submodule.span F (mono '' red p T)) :
    ∃ b : Basis {E : ι →₀ ℕ // ∀ i, E i < p} F K,
      ⇑b = fun E => E.1.prod fun i e => z i ^ e := by
  have hsp' : ⊤ ≤ Submodule.span F (range fun E : red p T => mono E.1) := by
    rw [← Set.image_eq_range]; exact fun y _ => hsp y
  refine ⟨(Basis.mk (v := fun E : red p T => mono E.1) hT hsp').reindex
    (Equiv.ofBijective _ (mapDomain_red_bij hz hzT)).symm, ?_⟩
  ext E
  rw [Basis.reindex_apply, Equiv.symm_symm]
  exact (Basis.mk_apply _ _ _).trans (mono_mapDomain z E.1)

end PBasisAux

universe u

open PBasisAux

variable {F : Type*} {K : Type u} [Field F] [Field K] [Algebra F K] {p : ℕ} [Fact p.Prime]
  [CharP K p]

/-- Over a field `F → K` containing all `p`-th powers of `K`, a `p`-independent family extends to
a `p`-basis. -/
theorem exists_pBasis_extension_of_pow_mem (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range)
    {I : Type*} (x : I → K)
    (hx : LinearIndependent F
      fun E : {E : I →₀ ℕ // ∀ i, E i < p} => E.1.prod fun i e => x i ^ e) :
    ∃ (J : Type u) (y : J → K) (b : Basis {E : (I ⊕ J) →₀ ℕ // ∀ l, E l < p} F K),
      ⇑b = fun E => E.1.prod fun l e => Sum.elim x y l ^ e := by
  have hp := (Fact.out : p.Prime)
  have hp1 : 1 < p := hp.one_lt
  have hxinj : Injective x := by
    intro i j hij
    have hmem : ∀ l : I, ∀ m, (Finsupp.single l 1 : I →₀ ℕ) m < p := by
      classical
      intro l m; rw [Finsupp.single_apply]; split_ifs <;> omega
    have key : (fun E : {E : I →₀ ℕ // ∀ i, E i < p} => E.1.prod fun i e => x i ^ e)
        ⟨Finsupp.single i 1, hmem i⟩ =
        (fun E : {E : I →₀ ℕ // ∀ i, E i < p} => E.1.prod fun i e => x i ^ e)
        ⟨Finsupp.single j 1, hmem j⟩ := by
      simp [hij]
    exact Finsupp.single_left_injective one_ne_zero (congrArg Subtype.val (hx.injective key))
  have h0 : LinearIndepOn F mono (red p (range x)) :=
    (linearIndependent_equiv' (Equiv.ofBijective _ (mapDomain_red_bij hxinj rfl))
      (f := fun E : red p (range x) => mono E.1)
      (funext fun E => mono_mapDomain x E.1)).1 hx
  obtain ⟨T, hST, hT, hsp⟩ := exists_red_span hF _ h0
  set z : I ⊕ ↥(T \ range x) → K := Sum.elim x Subtype.val
  have hz : Injective z := hxinj.sumElim Subtype.val_injective fun i j h => j.2.2 ⟨i, h⟩
  have hzT : range z = T := by
    rw [Set.Sum.elim_range, Subtype.range_coe]
    exact Set.union_sdiff_cancel hST
  obtain ⟨b, hb⟩ := exists_basis_of_injective hz hzT hT hsp
  exact ⟨_, _, b, hb⟩

/-- Over a field `F → K` containing all `p`-th powers of `K`, `K` has a `p`-basis. -/
theorem exists_pBasis_of_pow_mem (hF : ∀ x : K, x ^ p ∈ (algebraMap F K).range) :
    ∃ (I : Type u) (t : I → K) (b : Basis {E : I →₀ ℕ // ∀ i, E i < p} F K),
      ⇑b = fun E => E.1.prod fun i e => t i ^ e := by
  have h0 : LinearIndepOn F mono (red p (∅ : Set K)) := by
    refine (LinearIndepOn.singleton (v := mono) (R := F) (i := 0) ?_).mono fun E hE => ?_
    · rw [mono_zero]; exact one_ne_zero
    · exact Finsupp.support_eq_empty.1 (Finset.coe_eq_empty.1 (Set.subset_empty_iff.1 hE.1))
  obtain ⟨T, -, hT, hsp⟩ := exists_red_span hF _ h0
  obtain ⟨b, hb⟩ := exists_basis_of_injective Subtype.val_injective Subtype.range_coe hT hsp
  exact ⟨_, _, b, hb⟩

/-- **Extension to a `p`-basis.** Let `K / k` be an extension of fields of characteristic `p`,
and let `k K^p` be the subfield of `K` generated by `k` and the `p`-th powers. If a family
`(x_i)_{i ∈ I}` is `p`-independent over `k` (the monomials `x^E = ∏ x_i ^ (E i)`,
`0 ≤ E i < p`,
are linearly independent over `k K^p`), then it extends to a `p`-basis: there is a family
`(y_j)_{j ∈ J}` such that the monomials of the combined family `I ⊕ J` form a `k K^p`-basis
of `K`.

(blueprint: `lem-weil-pbc-p-independent-extends-to-p-basis`) -/
theorem exists_pBasis_extension {k : Type*} [Field k] [Algebra k K] (p : ℕ) [Fact p.Prime]
    [CharP K p] {I : Type*} (x : I → K)
    (hx : LinearIndependent (IntermediateField.adjoin k (Set.range fun b : K => b ^ p))
      fun E : {E : I →₀ ℕ // ∀ i, E i < p} => E.1.prod fun i e => x i ^ e) :
    ∃ (J : Type u) (y : J → K) (b : Basis {E : (I ⊕ J) →₀ ℕ // ∀ l, E l < p}
        (IntermediateField.adjoin k (Set.range fun b : K => b ^ p)) K),
      ⇑b = fun E => E.1.prod fun l e => Sum.elim x y l ^ e :=
  exists_pBasis_extension_of_pow_mem
    (fun a => ⟨⟨a ^ p, IntermediateField.subset_adjoin _ _ ⟨a, rfl⟩⟩, rfl⟩) x hx

/-- **Existence of `p`-bases.** A field `k` of characteristic `p` has a `p`-basis: a family
`(t_i)_{i ∈ I}` whose monomials `t^E = ∏ t_i ^ (E i)`, `0 ≤ E i < p` (finitely supported),
form a basis of `k` over the subfield `k^p` of `p`-th powers.

(blueprint: `lem-weil-pbc-p-basis-exists`) -/
theorem exists_pBasis (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] :
    ∃ (I : Type u) (t : I → k)
      (b : Basis {E : I →₀ ℕ // ∀ i, E i < p} (frobenius k p).fieldRange k),
      ⇑b = fun E => E.1.prod fun i e => t i ^ e :=
  exists_pBasis_of_pow_mem fun a => ⟨⟨a ^ p, a, rfl⟩, rfl⟩

end Field
