/-!
# Polynomial quotient fields over a relatively algebraically closed subfield

Source: Stacks Project, Algebra, Tag 037P, proof of
`lemma-field-extension-geometrically-irreducible`, using Tag 00H6(1) and the polynomial PID
argument of Tag 030A
(blueprint: lem-zl-relative-algebraic-closure-polynomial-quotient-field).
-/

@[expose] public section

universe u v

namespace Polynomial

/-- A monic irreducible polynomial stays irreducible over an extension with no new algebraic
    elements. Its polynomial quotient is a nonzero field, with a one-point irreducible spectrum.

Source: Stacks Project, Algebra, Tag 037P, proof of
`lemma-field-extension-geometrically-irreducible`, coefficient descent using Tag 00H6(1),
and the polynomial PID argument of Tag 030A
(blueprint: lem-zl-relative-algebraic-closure-polynomial-quotient-field).

Proof plan:
1. The field-extension map is injective (`def-pc-field-extension`). Degree additivity and the
   description of polynomial units (`def-weil-polynomial-ring`) show that the coefficientwise
   image (`def-weil-coefficientwise-ring-hom-map`) is monic of positive degree. In a factorization
   `P_K = A * B`, put `a = leadingCoeff A`. Rescale the factors to `Q = C a⁻¹ * A` and
   `R = C a * B`; their leading coefficients are one and `Q * R = P_K`.
2. By `lem-zl-monic-divisor-algebraic-coefficients`, every coefficient of both monic divisors
   is algebraic over `k`. The hypothesis supplies unique preimages in `k`. Zero coefficients
   have zero preimages, so finite support is preserved. These preimages define monic
   polynomials `Q₀, R₀`. Injectivity and multiplicativity of the coefficientwise map give
   `P = Q₀ * R₀`.
3. Irreducibility of `P` makes one descended factor a unit. Mapping its inverse and rescaling
   back show that `A` or `B` is a unit. This proves irreducibility of `P_K`.
4. Set `I = Ideal.span {P_K}`. This ideal is proper since `P_K` is not a unit. Every ideal
   containing it is principal by `lem-pur-polynomial-field-pid`, say generated by `G`.
   Write `P_K = G * H`; irreducibility makes `G` or `H` a unit, so that ideal is the whole
   ring or `I`. Thus `I` is maximal. By `lem-weil-common-extension-fields-quotient-field`,
   the literal quotient by `I` is a field, in particular nonzero.
5. The spectrum of a field has exactly one point (`def-weil-affine-spectrum`). In a closed
   cover, a closed subset containing that point is the whole space; thus the spectrum is
   irreducible (`def-weil-irreducible-components`). No separability or finite generation is used.
-/
theorem irreducible_map_and_isField_quotient_of_isAlgebraic_mem
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    (h : ∀ x : K, IsAlgebraic k x → ∃ y : k, algebraMap k K y = x)
    (P : Polynomial k) (hP : P.Monic) (hPirr : Irreducible P) :
    Irreducible (P.map (algebraMap k K)) ∧
      IsField (Polynomial K ⧸ Ideal.span {P.map (algebraMap k K)}) ∧
      Nonempty (Unique (AlgebraicGeometry.Spec
        (CommRingCat.of (Polynomial K ⧸ Ideal.span {P.map (algebraMap k K)})))) ∧
      IrreducibleSpace (AlgebraicGeometry.Spec
        (CommRingCat.of (Polynomial K ⧸ Ideal.span {P.map (algebraMap k K)}))) := by
  have hinj := Polynomial.map_injective (algebraMap k K) (algebraMap k K).injective
  have hmap : Irreducible (P.map (algebraMap k K)) := by
    have hne : P.map (algebraMap k K) ≠ 1 := by
      intro he
      apply hPirr.ne_one
      apply hinj
      simpa only [Polynomial.map_one] using he
    apply (irreducible_of_monic (hP.map _) hne).mpr
    intro Q R hQ hR hQR
    have descend (S : Polynomial K) (hS : S.Monic)
        (hdiv : S ∣ P.map (algebraMap k K)) :
        ∃ S₀ : Polynomial k, S₀.map (algebraMap k K) = S := by
      apply (mem_lifts S).mp
      apply (lifts_iff_coeff_lifts S).mpr
      intro i
      exact h _ (isIntegral_coeff_of_dvd P S hP hS hdiv i).isAlgebraic
    obtain ⟨Q₀, hQ₀⟩ := descend Q hQ ⟨R, hQR.symm⟩
    obtain ⟨R₀, hR₀⟩ := descend R hR ⟨Q, by rw [mul_comm]; exact hQR.symm⟩
    have hfactor : P = Q₀ * R₀ := by
      apply hinj
      rw [Polynomial.map_mul, hQ₀, hR₀, hQR]
    rcases hPirr.isUnit_or_isUnit hfactor with hunit | hunit
    · left
      apply hQ.eq_one_of_isUnit
      rw [← hQ₀]
      exact hunit.map (Polynomial.mapRingHom (algebraMap k K))
    · right
      apply hR.eq_one_of_isUnit
      rw [← hR₀]
      exact hunit.map (Polynomial.mapRingHom (algebraMap k K))
  let I : Ideal (Polynomial K) := Ideal.span {P.map (algebraMap k K)}
  let : I.IsMaximal := PrincipalIdealRing.isMaximal_of_irreducible hmap
  let : Field (Polynomial K ⧸ I) := Ideal.Quotient.field I
  refine ⟨hmap, Field.toIsField _, ?_, ?_⟩
  · exact ⟨inferInstanceAs (Unique (PrimeSpectrum (Polynomial K ⧸ I)))⟩
  · exact inferInstanceAs (IrreducibleSpace (PrimeSpectrum (Polynomial K ⧸ I)))

end Polynomial
