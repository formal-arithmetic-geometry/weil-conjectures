module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.Algebra.Algebra.ZMod
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import WeilConjectures.FieldTheory.IntersectionSubfieldsDifferentialsKernel
import WeilConjectures.FieldTheory.IntersectionSubfieldsDifferentialsPowers

/-! # Intersection of subfields and differentials

A directed family of subfields `Kα` of a field `K` of characteristic `p`, each containing `K^p`
and with intersection `K^p`, detects absolute differentials and `p`-th powers in finite
extensions.

## Implementation details

The subfields of `K` are written as intermediate fields over the prime field `ZMod p`, and the
map `Ω[K⁄ZMod p] → Ω[K⁄Kα]` is `KaehlerDifferential.map`.

The statement about differentials uses a `p`-basis of `K`. The statement about `p`-th powers is
proved by induction on `[L : K]`, reducing to a simple extension `L = K(θ)`. When `θ^p ∈ K`, the
`Kα`-span of the powers of `θ^p` need not be direct; the argument uses a single `Kα₀` not
containing `θ^p`, which corrects the direct-sum assertion of the source.

## References

* [Stacks Project, Tag 07P4](https://stacks.math.columbia.edu/tag/07P4)
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u v w

namespace FieldTheory

/-- The `ZMod p`-algebra structure on a field of characteristic `p`, registered locally. -/
local instance zmodAlgebra (p : ℕ) (K : Type u) [Field K] [CharP K p] :
    Algebra (ZMod p) K := ZMod.algebra (R := K) p

/-- Let `Kα` be a directed family of subfields of `K` (as intermediate fields over `ZMod p`),
each containing `K^p` and with intersection `K^p`. Then a differential in `Ω[K⁄ZMod p]` that
vanishes in every `Ω[K⁄Kα]` is zero, and for every finite extension `L / K`, `L^p` is the
intersection of the subfields generated by `L^p` and `Kα`. -/
theorem intersection_subfields_differentials
    (p : ℕ) [Fact p.Prime] (K : Type u) [Field K] [CharP K p]
    {ι : Type v} (Kα : ι → IntermediateField (ZMod p) K)
    (h₁ : ∀ α : ι, Set.range (fun x : K => x ^ p) ⊆ (Kα α : Set K))
    (h₂ : Set.range (fun x : K => x ^ p) = ((⨅ α, Kα α : IntermediateField (ZMod p) K) : Set K))
    (h₃ : ∀ α β : ι, ∃ γ : ι, Kα γ ≤ Kα α ⊓ Kα β) :
    (∀ ω : Ω[K⁄ZMod p],
      (∀ α : ι, KaehlerDifferential.map (ZMod p) (Kα α) K K ω = 0) → ω = 0) ∧
    (∀ (L : Type w) [Field L] [Algebra K L] [FiniteDimensional K L],
      Set.range (fun x : L => x ^ p) =
        ⋂ α : ι, ((Subfield.closure (Set.range (fun x : L => x ^ p) ∪
          (algebraMap K L '' (Kα α : Set K))) : Set L))) := by
  exact ⟨intersection_subfields_differentials_kernel p K Kα h₁ h₂ h₃,
    intersection_subfields_differentials_powers p K Kα h₁ h₂ h₃⟩

end FieldTheory
