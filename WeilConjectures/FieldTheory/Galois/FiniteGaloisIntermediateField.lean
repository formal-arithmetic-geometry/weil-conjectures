module

public import Mathlib.FieldTheory.Galois.Infinite
public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.Order.Interval.Finset.Defs
import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# The lattice of finite Galois subextensions of a Galois extension

Let `Ω/L` be a Galois extension (possibly infinite) and `J` the lattice of finite Galois
subextensions of `Ω/L` (`FiniteGaloisIntermediateField L Ω`).

* `J` is a locally finite order: a finite Galois extension has finitely many intermediate fields
  (`FiniteGaloisIntermediateField.instLocallyFiniteOrder`).
* For `k, j ∈ J`, the image `N j k` of `Gal(Ω/k)` in `Gal(j/L)`
  (`FiniteGaloisIntermediateField.restrictFixingSubgroup`) is a normal subgroup, with
  `N j k ⊔ N j m = N j (k ⊓ m)` (by the Galois correspondence of `Ω/L`), `N j j = ⊥` and
  `N j ⊥ = ⊤`.
* For `k ≤ j` and lifts `c a ∈ Gal(Ω/L)` of the elements `a ∈ Gal(k/L)`, the map
  `(a, n) ↦ (c a)|_j * n` is a bijection `Gal(k/L) × N j k ≃ Gal(j/L)`
  (`FiniteGaloisIntermediateField.bijective_restrictNormalHom_mul`).
-/

@[expose] public section

open IntermediateField

namespace FiniteGaloisIntermediateField

variable {L Ω : Type*} [Field L] [Field Ω] [Algebra L Ω]

/-- The finite Galois subextensions below a given one form a finite set. -/
lemma finite_Iic (b : FiniteGaloisIntermediateField L Ω) : (Set.Iic b).Finite := by
  have : Algebra.IsSeparable L b := inferInstance
  have : Finite (IntermediateField L b) :=
    Field.finite_intermediateField_of_exists_primitive_element L b
      (Field.exists_primitive_element L b)
  refine Set.finite_coe_iff.1 (Finite.of_injective
    (fun k : Set.Iic b ↦ IntermediateField.restrict (F := k.1.toIntermediateField) k.2) ?_)
  intro k k' hkk'
  apply Subtype.ext
  apply val_injective
  rw [← lift_restrict (F := k.1.toIntermediateField) k.2,
    ← lift_restrict (F := k'.1.toIntermediateField) k'.2]
  exact congrArg lift hkk'

/-- The finite Galois subextensions of a Galois extension form a locally finite order. -/
noncomputable instance instLocallyFiniteOrder :
    LocallyFiniteOrder (FiniteGaloisIntermediateField L Ω) :=
  LocallyFiniteOrder.ofFiniteIcc fun _ b ↦ (finite_Iic b).subset Set.Icc_subset_Iic_self

/-- The fixing subgroup of a finite Galois subextension `k` is the kernel of the restriction to
`k`. -/
lemma fixingSubgroup_eq_ker (k : FiniteGaloisIntermediateField L Ω) :
    k.toIntermediateField.fixingSubgroup =
      (AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) k).ker :=
  Subgroup.ext fun σ ↦ (mem_fixingSubgroup_iff σ k).trans MonoidHom.mem_ker.symm

variable [IsGalois L Ω]

/-- **Galois correspondence**: the fixing subgroup of an intersection of finite Galois
subextensions is generated by the fixing subgroups. -/
lemma fixingSubgroup_inf (k m : FiniteGaloisIntermediateField L Ω) :
    (k ⊓ m).toIntermediateField.fixingSubgroup =
      k.toIntermediateField.fixingSubgroup ⊔ m.toIntermediateField.fixingSubgroup := by
  refine le_antisymm ?_ (sup_le (fixingSubgroup_le inf_le_left) (fixingSubgroup_le inf_le_right))
  set H := k.toIntermediateField.fixingSubgroup ⊔ m.toIntermediateField.fixingSubgroup
  have hH : IsClosed (H : Set (Ω ≃ₐ[L] Ω)) := H.isClosed_of_isOpen
    (Subgroup.isOpen_mono le_sup_left k.toIntermediateField.fixingSubgroup_isOpen)
  have hfix : ∀ k' : FiniteGaloisIntermediateField L Ω,
      k'.toIntermediateField.fixingSubgroup ≤ H → fixedField H ≤ k'.toIntermediateField :=
    fun k' hk' ↦ by
      conv_rhs => rw [← InfiniteGalois.fixedField_fixingSubgroup k'.toIntermediateField]
      intro x hx
      rw [mem_fixedField_iff] at hx ⊢
      exact fun σ hσ ↦ hx σ (hk' hσ)
  calc (k ⊓ m).toIntermediateField.fixingSubgroup ≤ (fixedField H).fixingSubgroup :=
        fixingSubgroup_le (le_inf (hfix k le_sup_left) (hfix m le_sup_right))
    _ = H := InfiniteGalois.fixingSubgroup_fixedField ⟨H, hH⟩

omit [IsGalois L Ω] in
/-- The fixing subgroup of the bottom element is everything. -/
lemma fixingSubgroup_bot :
    (⊥ : FiniteGaloisIntermediateField L Ω).toIntermediateField.fixingSubgroup = ⊤ :=
  top_le_iff.1 fun σ _ x ↦ by
    obtain ⟨y, hy⟩ := IntermediateField.mem_bot.1 x.2
    rw [AlgEquiv.smul_def, ← hy, AlgEquiv.commutes]

/-- The image `N j k` of `Gal(Ω/k)` in `Gal(j/L)` under restriction. -/
noncomputable def restrictFixingSubgroup (j k : FiniteGaloisIntermediateField L Ω) :
    Subgroup (j ≃ₐ[L] j) :=
  k.toIntermediateField.fixingSubgroup.map (AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) j)

/-- The subgroup `N j k` is normal. -/
lemma restrictFixingSubgroup_normal (j k : FiniteGaloisIntermediateField L Ω) :
    (restrictFixingSubgroup j k).Normal := by
  unfold restrictFixingSubgroup
  rw [fixingSubgroup_eq_ker]
  exact (MonoidHom.normal_ker _).map _ (AlgEquiv.restrictNormalHom_surjective Ω)

/-- `N j k ⊔ N j m = N j (k ⊓ m)`. -/
lemma restrictFixingSubgroup_sup (j k m : FiniteGaloisIntermediateField L Ω) :
    restrictFixingSubgroup j k ⊔ restrictFixingSubgroup j m =
      restrictFixingSubgroup j (k ⊓ m) := by
  rw [restrictFixingSubgroup, restrictFixingSubgroup, restrictFixingSubgroup, fixingSubgroup_inf,
    Subgroup.map_sup]

omit [IsGalois L Ω] in
/-- `N j j` is trivial. -/
lemma restrictFixingSubgroup_self (j : FiniteGaloisIntermediateField L Ω) :
    restrictFixingSubgroup j j = ⊥ := by
  rw [restrictFixingSubgroup, Subgroup.map_eq_bot_iff, fixingSubgroup_eq_ker]

/-- `N j ⊥` is everything. -/
lemma restrictFixingSubgroup_bot (j : FiniteGaloisIntermediateField L Ω) :
    restrictFixingSubgroup j ⊥ = ⊤ := by
  rw [restrictFixingSubgroup, fixingSubgroup_bot,
    Subgroup.map_top_of_surjective _ (AlgEquiv.restrictNormalHom_surjective Ω)]

omit [IsGalois L Ω] in
/-- For `k ≤ j`, an automorphism of `Ω` whose restriction to `j` lies in `N j k` fixes `k`. -/
lemma mem_fixingSubgroup_of_mem_restrictFixingSubgroup {j k : FiniteGaloisIntermediateField L Ω}
    (hkj : k ≤ j) {σ : Ω ≃ₐ[L] Ω}
    (hσ : AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) j σ ∈ restrictFixingSubgroup j k) :
    σ ∈ k.toIntermediateField.fixingSubgroup := by
  obtain ⟨τ, hτ, hτσ⟩ := hσ
  have : τ⁻¹ * σ ∈ k.toIntermediateField.fixingSubgroup := by
    refine fixingSubgroup_le hkj ?_
    rw [fixingSubgroup_eq_ker, MonoidHom.mem_ker, map_mul, map_inv, hτσ, inv_mul_cancel]
  simpa using mul_mem hτ this

/-- For `k ≤ j` and lifts `c a ∈ Gal(Ω/L)` of the elements `a ∈ Gal(k/L)`, the map
`(a, n) ↦ (c a)|_j * n` is a bijection `Gal(k/L) × N j k → Gal(j/L)`. -/
lemma bijective_restrictNormalHom_mul {j k : FiniteGaloisIntermediateField L Ω} (hkj : k ≤ j)
    (c : (k ≃ₐ[L] k) → (Ω ≃ₐ[L] Ω))
    (hc : ∀ a, AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) k (c a) = a) :
    Function.Bijective (fun x : (k ≃ₐ[L] k) × restrictFixingSubgroup j k ↦
      AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) j (c x.1) * x.2) := by
  set r := AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) j
  set rk := AlgEquiv.restrictNormalHom (F := L) (K₁ := Ω) k
  constructor
  · rintro ⟨a, n⟩ ⟨a', n'⟩ h
    dsimp only at h
    have hmem : r ((c a')⁻¹ * c a) ∈ restrictFixingSubgroup j k := by
      have e : (r (c a'))⁻¹ * r (c a) = n' * (n : j ≃ₐ[L] j)⁻¹ := by
        rw [inv_mul_eq_iff_eq_mul, ← mul_assoc, ← h, mul_inv_cancel_right]
      rw [map_mul, map_inv, e]
      exact mul_mem n'.2 (inv_mem n.2)
    have h1 := mem_fixingSubgroup_of_mem_restrictFixingSubgroup hkj hmem
    rw [fixingSubgroup_eq_ker, MonoidHom.mem_ker, map_mul, map_inv, hc, hc, inv_mul_eq_one] at h1
    subst h1
    exact Prod.ext rfl (Subtype.ext (mul_left_cancel h))
  · intro g
    obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := L) (K₁ := j) Ω g
    have hmem : (c (rk τ))⁻¹ * τ ∈ k.toIntermediateField.fixingSubgroup := by
      rw [fixingSubgroup_eq_ker, MonoidHom.mem_ker, map_mul, map_inv, hc, inv_mul_cancel]
    exact ⟨⟨rk τ, ⟨r ((c (rk τ))⁻¹ * τ), Subgroup.mem_map_of_mem _ hmem⟩⟩, by
      simp [r]⟩

end FiniteGaloisIntermediateField
