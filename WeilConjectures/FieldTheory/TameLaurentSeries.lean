/-!
# Tame extensions of `K((t))`

Let `K` be a separably closed field of characteristic exponent `q` and `F` the fraction field
of `K⟦X⟧` (e.g. `FractionRing K⟦X⟧` or `LaurentSeries K`). By Hensel's lemma, units of `K⟦X⟧`
have `N`-th roots for every `N` invertible in `K`, so `F^× / F^×N` is generated by `X`. As the
integral closure of `K⟦X⟧` in a finite separable extension `L / F` is a DVR with purely
inseparable residue extension, `X` has an `m`-th root in `L` for every `m ∣ [L : F]` invertible
in `K` (`IsDiscreteValuationRing.exists_pow_eq_algebraMap_of_dvd_finrank`); together with the
Eisenstein polynomial `T ^ m - X`, this shows that the extensions of degree prime to `q` are
the `F(X ^ (1 / m))`, and that the absolute Galois group of `F(X ^ (1 / n) : q ∤ n)` is
pro-`q` (Serre, *Local Fields*, IV §2).

## Main statements

- `PowerSeries.exists_pow_eq_of_constantCoeff_ne_zero`: `N`-th roots of units of `K⟦X⟧`.
- `PowerSeries.exists_eq_X_zpow_mul_pow`, `PowerSeries.dvd_of_X_zpow_eq_pow`:
  `F^× / F^×N ≅ ℤ / N`, generated by `X`.
- `PowerSeries.exists_pow_eq_X_of_pow_eq_X_mul_unit`: an `N`-th root of `X u` gives one of `X`.
- `PowerSeries.irreducible_X_pow_sub_C_X_of_ne_zero`, `PowerSeries.finrank_adjoin_of_pow_eq_X`:
  `[F(X ^ (1 / N)) : F] = N`.
- `PowerSeries.exists_pow_finrank_eq_X_and_adjoin_eq_top`: an extension of `F` of degree `N`
  invertible in `K` is `F(X ^ (1 / N))`.
- `PowerSeries.exists_pow_ringExpChar_pow_eq_one`: in a finite Galois extension of `F`, an
  automorphism fixing the tame roots of `X` has `q`-power order.
- `PowerSeries.tendsto_pow_ringExpChar_pow`: in a Galois extension `Ω / F`, an automorphism `σ`
  fixing the tame roots of `X` satisfies `σ ^ (q ^ k) → 1` (pro-`q`-ness).
-/

@[expose] public section

universe u

open Polynomial IsLocalRing Module IntermediateField

/-- A finite extension whose degree is invertible in the base field is separable: its
inseparable degree is a power of the characteristic exponent dividing the degree. -/
theorem Algebra.IsSeparable.of_natCast_finrank_ne_zero (F E : Type*) [Field F] [Field E]
    [Algebra F E] [FiniteDimensional F E] (h : (finrank F E : F) ≠ 0) :
    Algebra.IsSeparable F E := by
  obtain ⟨n, hn⟩ := finInsepDegree_eq_pow F E (ringExpChar F)
  have hdvd : ringExpChar F ^ n ∣ finrank F E :=
    hn ▸ ⟨_, (Field.finSepDegree_mul_finInsepDegree F E).symm.trans (mul_comm _ _)⟩
  have hcop := (ExpChar.coprime_of_natCast_ne_zero (q := ringExpChar F) h).pow_right n
  rw [isSeparable_iff_finInsepDegree_eq_one, hn]
  exact Nat.Coprime.eq_one_of_dvd hcop.symm hdvd

/-- Every nonzero natural number is `m * q ^ a` with `m` invertible in a field `K` of
exponential characteristic `q`. -/
lemma exists_eq_mul_ringExpChar_pow (K : Type*) [Field K] {n : ℕ} (hn : n ≠ 0) :
    ∃ m a : ℕ, n = m * ringExpChar K ^ a ∧ (m : K) ≠ 0 := by
  generalize hq : ringExpChar K = q
  have : ExpChar K q := hq ▸ inferInstance
  rcases this with _ | ⟨hp⟩
  · exact ⟨n, 0, by simp, Nat.cast_ne_zero.2 hn⟩
  · refine ⟨ordCompl[q] n, n.factorization q, by rw [mul_comm, Nat.ordProj_mul_ordCompl_eq_self],
      fun h ↦ Nat.not_dvd_ordCompl hp hn ((CharP.cast_eq_zero_iff K q _).1 h)⟩

namespace PowerSeries

variable {K : Type u} [Field K]

/-- An integer invertible in `K` is invertible in the residue field of `K⟦X⟧`. -/
lemma natCast_residueField_ne_zero {N : ℕ} (hN : (N : K) ≠ 0) :
    (N : ResidueField K⟦X⟧) ≠ 0 := by
  rwa [← map_natCast (residueFieldEquiv K), EmbeddingLike.map_ne_zero_iff]

/-- **Roots of units.** Over a separably closed field `K`, every power series with nonzero
constant coefficient has an `N`-th root for every `N` invertible in `K` (Hensel's lemma). -/
theorem exists_pow_eq_of_constantCoeff_ne_zero [IsSepClosed K] {N : ℕ} (hN : (N : K) ≠ 0)
    {f : K⟦X⟧} (hf : constantCoeff f ≠ 0) : ∃ g : K⟦X⟧, g ^ N = f :=
  HenselianLocalRing.exists_pow_eq_of_isUnit (natCast_residueField_ne_zero hN)
    (isUnit_iff_constantCoeff.2 hf.isUnit)

variable {F : Type u} [Field F] [Algebra K⟦X⟧ F] [IsFractionRing K⟦X⟧ F]

/-- **`F^× / F^×N` is generated by `X`.** Over a separably closed field `K`, every nonzero
element of the fraction field `F` of `K⟦X⟧` is `X ^ k * y ^ N` for every `N` invertible
in `K`. -/
theorem exists_eq_X_zpow_mul_pow [IsSepClosed K] {N : ℕ} (hN : (N : K) ≠ 0) {x : F}
    (hx : x ≠ 0) : ∃ (k : ℤ) (y : F), x = algebraMap K⟦X⟧ F X ^ k * y ^ N := by
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := K⟦X⟧) x
  have ha : a ≠ 0 := by
    rintro rfl
    simp at hx
  obtain ⟨m, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha X_irreducible
  obtain ⟨n, v, rfl⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible (nonZeroDivisors.ne_zero hb)
      X_irreducible
  obtain ⟨w, hw⟩ := HenselianLocalRing.exists_pow_eq_of_isUnit
    (natCast_residueField_ne_zero hN) u.isUnit
  obtain ⟨w', hw'⟩ := HenselianLocalRing.exists_pow_eq_of_isUnit
    (natCast_residueField_ne_zero hN) v.isUnit
  have hT : algebraMap K⟦X⟧ F X ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective K⟦X⟧ F)).2 X_ne_zero
  refine ⟨m - n, algebraMap K⟦X⟧ F w / algebraMap K⟦X⟧ F w', ?_⟩
  rw [zpow_sub₀ hT, zpow_natCast, zpow_natCast, div_pow, ← hw, ← hw']
  simp only [map_mul, map_pow]
  ring

omit [IsFractionRing K⟦X⟧ F] in
/-- An integer invertible in `K` is invertible in any field `F` containing `K⟦X⟧`. -/
lemma natCast_ne_zero_of_natCast_ne_zero {N : ℕ} (hN : (N : K) ≠ 0) : (N : F) ≠ 0 := by
  rw [← map_natCast ((algebraMap K⟦X⟧ F).comp (algebraMap K K⟦X⟧))]
  exact (map_ne_zero_iff _ (RingHom.injective _)).2 hN

/-- `X ^ k` is an `N`-th power in the fraction field of `K⟦X⟧` only if `N ∣ k`. -/
theorem dvd_of_X_zpow_eq_pow {N : ℕ} (hN : N ≠ 0) {k : ℤ} {y : F}
    (h : algebraMap K⟦X⟧ F PowerSeries.X ^ k = y ^ N) : (N : ℤ) ∣ k := by
  have hT : algebraMap K⟦X⟧ F PowerSeries.X ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective K⟦X⟧ F)).2 X_ne_zero
  have hN' : (0 : ℤ) < N := by exact_mod_cast Nat.pos_of_ne_zero hN
  have hr : (((k % N).toNat : ℕ) : ℤ) = k % N := Int.toNat_of_nonneg (Int.emod_nonneg _ hN'.ne')
  have hrN : (k % N).toNat < N := by
    have := Int.emod_lt_of_pos k hN'
    omega
  have hk := Int.mul_ediv_add_emod k N
  have hz : (y * algebraMap K⟦X⟧ F PowerSeries.X ^ (-(k / N))) ^ N =
      algebraMap K⟦X⟧ F (PowerSeries.X ^ (k % N).toNat) := by
    rw [mul_pow, ← h, ← zpow_natCast, ← zpow_mul, ← zpow_add₀ hT, map_pow, ← zpow_natCast, hr]
    congr 1
    linarith
  obtain ⟨z, hz'⟩ := IsIntegrallyClosed.isIntegral_iff.1
    (⟨Polynomial.X ^ N - Polynomial.C (PowerSeries.X ^ (k % N).toNat), monic_X_pow_sub_C _ hN,
      by rw [eval₂_sub, eval₂_X_pow, Polynomial.eval₂_C, hz, sub_self]⟩ :
      IsIntegral K⟦X⟧ (y * algebraMap K⟦X⟧ F PowerSeries.X ^ (-(k / N))))
  rw [← hz', ← map_pow] at hz
  have hz2 := IsFractionRing.injective K⟦X⟧ F hz
  have hz0 : z ≠ 0 := by
    rintro rfl
    exact pow_ne_zero _ X_ne_zero (hz2.symm.trans (zero_pow hN))
  obtain ⟨j, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hz0 X_irreducible
  have hjr := IsDiscreteValuationRing.unit_mul_pow_congr_pow X_irreducible X_irreducible (u ^ N) 1
    (j * N) _ (by rw [Units.val_one, one_mul, Units.val_pow_eq_pow_val, ← hz2, mul_pow, pow_mul])
  have hr0 := Nat.eq_zero_of_dvd_of_lt ⟨j, hjr.symm.trans (mul_comm _ _)⟩ hrN
  exact ⟨k / N, by omega⟩

/-- **Kummer.** Over a separably closed field `K`, if `π ^ N = X * u` for a unit `u` of
`K⟦X⟧` and `N` invertible in `K`, then `X` has an `N`-th root. -/
theorem exists_pow_eq_X_of_pow_eq_X_mul_unit [IsSepClosed K] {E : Type*} [CommRing E]
    [Algebra K⟦X⟧ E] {N : ℕ} (hN : (N : K) ≠ 0) {π : E} {u : K⟦X⟧} (hu : IsUnit u)
    (hπ : π ^ N = algebraMap K⟦X⟧ E (PowerSeries.X * u)) :
    ∃ γ : E, γ ^ N = algebraMap K⟦X⟧ E PowerSeries.X := by
  obtain ⟨w, hw⟩ := HenselianLocalRing.exists_pow_eq_of_isUnit
    (natCast_residueField_ne_zero hN) hu
  have hN0 : N ≠ 0 := by
    rintro rfl
    simp at hN
  obtain ⟨w, rfl⟩ := (isUnit_pow_iff hN0).1 (hw ▸ hu)
  refine ⟨π * algebraMap K⟦X⟧ E ↑w⁻¹, ?_⟩
  rw [mul_pow, hπ, ← map_pow, ← map_mul, ← hw, mul_assoc, ← mul_pow, Units.mul_inv, one_pow,
    mul_one]

/-- **Eisenstein.** `T ^ N - X` is irreducible over the fraction field of `K⟦X⟧`. -/
theorem irreducible_X_pow_sub_C_X_of_ne_zero {N : ℕ} (hN : N ≠ 0) :
    Irreducible (Polynomial.X ^ N - Polynomial.C (algebraMap K⟦X⟧ F PowerSeries.X)) := by
  have hmon : (Polynomial.X ^ N - Polynomial.C (PowerSeries.X : K⟦X⟧)).Monic :=
    monic_X_pow_sub_C _ hN
  have hdeg : (Polynomial.X ^ N - Polynomial.C (PowerSeries.X : K⟦X⟧)).natDegree = N :=
    natDegree_X_pow_sub_C
  have hP : Ideal.span {(PowerSeries.X : K⟦X⟧)} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact X_irreducible.not_isUnit
  have hE := hmon.isEisensteinAt_of_mem_of_notMem hP (fun {n} hn ↦ by
      rw [hdeg] at hn
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C, ite_eq_right hn.ne]
      split_ifs <;> simp)
    (by
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
        ite_eq_right (Ne.symm hN),
        ite_eq_left rfl, zero_sub,
        Ideal.span_singleton_pow, Ideal.mem_span_singleton, dvd_neg]
      intro h
      have := (pow_dvd_pow_iff (X_ne_zero (R := K)) X_irreducible.not_isUnit (n := 2) (m := 1)).1
        (by rwa [pow_one])
      omega)
  have hirr := hE.irreducible ((Ideal.span_singleton_prime X_ne_zero).2 X_prime)
    hmon.isPrimitive (by rw [hdeg]; exact Nat.pos_of_ne_zero hN)
  simpa using (hmon.irreducible_iff_irreducible_map_fraction_map (K := F)).1 hirr

/-- An `N`-th root of `X` generates an extension of degree `N` of the fraction field of
`K⟦X⟧`. -/
theorem finrank_adjoin_of_pow_eq_X {L : Type*} [Field L] [Algebra F L] [Algebra K⟦X⟧ L]
    [IsScalarTower K⟦X⟧ F L] {N : ℕ} (hN : N ≠ 0) {γ : L}
    (hγ : γ ^ N = algebraMap K⟦X⟧ L PowerSeries.X) : finrank F F⟮γ⟯ = N := by
  have hroot : Polynomial.aeval γ
      (Polynomial.X ^ N - Polynomial.C (algebraMap K⟦X⟧ F PowerSeries.X)) = 0 := by
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
      ← IsScalarTower.algebraMap_apply, hγ, sub_self]
  rw [IntermediateField.adjoin.finrank ⟨_, monic_X_pow_sub_C _ hN, hroot⟩,
    ← minpoly.eq_of_irreducible_of_monic (irreducible_X_pow_sub_C_X_of_ne_zero hN) hroot
      (monic_X_pow_sub_C _ hN), natDegree_X_pow_sub_C]

/-- **Tame extensions of `K((X))`.** Let `K` be separably closed. A finite extension `L` of the
fraction field `F` of `K⟦X⟧` whose degree `N` is invertible in `K` is generated by an `N`-th
root of `X`. -/
theorem exists_pow_finrank_eq_X_and_adjoin_eq_top [IsSepClosed K] {L : Type u} [Field L]
    [Algebra F L] [Algebra K⟦X⟧ L] [IsScalarTower K⟦X⟧ F L] [FiniteDimensional F L]
    (h : (finrank F L : K) ≠ 0) :
    ∃ γ : L, γ ^ finrank F L = algebraMap K⟦X⟧ L PowerSeries.X ∧ F⟮γ⟯ = ⊤ := by
  have := Algebra.IsSeparable.of_natCast_finrank_ne_zero F L
    (natCast_ne_zero_of_natCast_ne_zero h)
  obtain ⟨γ, hγ⟩ := IsDiscreteValuationRing.exists_pow_eq_algebraMap_of_dvd_finrank K⟦X⟧ F L
    (natCast_residueField_ne_zero h) dvd_rfl X_irreducible
  refine ⟨γ, hγ, IntermediateField.eq_of_le_of_finrank_eq le_top ?_⟩
  rw [finrank_adjoin_of_pow_eq_X finrank_pos.ne' hγ, IntermediateField.finrank_top']

/-- **Finite Galois extensions of `K((X))` are tame-by-`p`.** Let `K` be separably closed of
characteristic exponent `q`, and `L` a finite Galois extension of the fraction field `F` of
`K⟦X⟧`. An automorphism `τ` of `L / F` fixing every `n`-th root of `X` in `L`, for `n`
invertible in `K`, has order a power of `q`: writing `[L : F] = m q ^ a` with `m` invertible
in `K`, `L` contains an `m`-th root `γ` of `X`, `[F(γ) : F] = m`, and `τ` lies in
`Gal(L / F(γ))`, of order `q ^ a`. -/
theorem exists_pow_ringExpChar_pow_eq_one [IsSepClosed K] {L : Type u} [Field L] [Algebra F L]
    [Algebra K⟦X⟧ L] [IsScalarTower K⟦X⟧ F L] [FiniteDimensional F L] [IsGalois F L]
    (τ : Gal(L/F))
    (hτ : ∀ (n : ℕ) (z : L), (n : K) ≠ 0 → z ^ n = algebraMap K⟦X⟧ L PowerSeries.X → τ z = z) :
    ∃ a : ℕ, τ ^ ringExpChar K ^ a = 1 := by
  obtain ⟨m, a, hn, hm⟩ := exists_eq_mul_ringExpChar_pow K (finrank_pos (R := F) (M := L)).ne'
  obtain ⟨γ, hγ⟩ := IsDiscreteValuationRing.exists_pow_eq_algebraMap_of_dvd_finrank K⟦X⟧ F L
    (natCast_residueField_ne_zero hm) ⟨_, hn⟩ X_irreducible
  have hm0 : m ≠ 0 := by
    rintro rfl
    simp at hm
  have hτE : τ ∈ F⟮γ⟯.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    rw [← IntermediateField.mem_toSubalgebra,
      IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (Algebra.IsAlgebraic.isAlgebraic γ)] at hx
    exact Algebra.adjoin_le (S := AlgHom.equalizer (τ : L →ₐ[F] L) (AlgHom.id F L))
      (Set.singleton_subset_iff.2 (hτ m γ hm hγ)) hx
  have hcard : Nat.card F⟮γ⟯.fixingSubgroup = ringExpChar K ^ a := by
    rw [IsGalois.card_fixingSubgroup_eq_finrank]
    have := Module.finrank_mul_finrank F F⟮γ⟯ L
    rw [finrank_adjoin_of_pow_eq_X hm0 hγ, hn] at this
    exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hm0) this
  refine ⟨a, ?_⟩
  have := congrArg Subtype.val (pow_card_eq_one' (x := (⟨τ, hτE⟩ : F⟮γ⟯.fixingSubgroup)))
  rwa [hcard, Subgroup.coe_pow] at this

/-- **The tame quotient.** Let `K` be separably closed of characteristic exponent `q`, `F` the
fraction field of `K⟦X⟧` and `Ω / F` a Galois extension (e.g. a separable closure). An
automorphism `σ` of `Ω / F` fixing every `n`-th root of `X` in `Ω`, for `n` invertible in `K`,
satisfies `σ ^ (q ^ k) → 1` in the Krull topology: the subgroup of such automorphisms (the
absolute Galois group of `F(X ^ (1 / n) : q ∤ n)` when `Ω` is separably closed) is pro-`q`. -/
theorem tendsto_pow_ringExpChar_pow [IsSepClosed K] {Ω : Type u} [Field Ω] [Algebra F Ω]
    [Algebra K⟦X⟧ Ω] [IsScalarTower K⟦X⟧ F Ω] [IsGalois F Ω] (σ : Gal(Ω/F))
    (hσ : ∀ (n : ℕ) (z : Ω), (n : K) ≠ 0 → z ^ n = algebraMap K⟦X⟧ Ω PowerSeries.X → σ z = z) :
    Filter.Tendsto (fun k : ℕ ↦ σ ^ ringExpChar K ^ k) Filter.atTop (nhds 1) := by
  intro s hs
  obtain ⟨E, _, _, hE⟩ := (krullTopology_mem_nhds_one_iff_of_normal F Ω s).1 hs
  have : IsGalois F E := IsGalois.mk
  obtain ⟨a, ha⟩ := exists_pow_ringExpChar_pow_eq_one (AlgEquiv.restrictNormalHom E σ)
    fun n z hn hz ↦ Subtype.ext (by
      rw [AlgEquiv.restrictNormalHom_apply]
      exact hσ n z hn (by rw [← IntermediateField.coe_pow, hz]; rfl))
  rw [Filter.mem_map, Filter.mem_atTop_sets]
  refine ⟨a, fun k hk ↦ hE ?_⟩
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  have hτk : AlgEquiv.restrictNormalHom E σ ^ ringExpChar K ^ k = 1 := by
    rw [← Nat.add_sub_cancel' hk, pow_add, pow_mul, ha, one_pow]
  have := AlgEquiv.restrictNormalHom_apply E (σ ^ ringExpChar K ^ k) ⟨x, hx⟩
  rw [map_pow, hτk, AlgEquiv.one_apply] at this
  exact this.symm

end PowerSeries
