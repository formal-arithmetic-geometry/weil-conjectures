/-!
# Galois cohomology of a finite field

Let `k` be a finite field with `q` elements, `Ω` an algebraic closure of `k` and
`G = Gal(Ω/k)`. For every `N > 0`, the roots of `X ^ (q ^ N) - X` in `Ω` form the unique
subextension `k_N` of degree `N` of `Ω / k`, whose Galois group is cyclic of order `N`, generated by
the arithmetic Frobenius `φ : x ↦ x ^ q`. Recording the exponent `a mod N` with `σ = φ ^ a` on
`k_N` gives continuous characters `G → ℤ / N`; for `N = ℓ ^ m` they are compatible, and define a
continuous character `χ : G → ℤ_ℓ` with `χ φ = 1`. Its kernel has finite quotients of order
prime to `ℓ`: if `E / k` is finite of degree `ℓ ^ b n'` with `ℓ ∤ n'`, then `k_{ℓ ^ b} ⊆ E`, and the
image of `ker χ` in `Gal(E/k)` lies in `Gal(E/k_{ℓ ^ b})`, of order `n'`.

Hence `(G, χ, φ)` is an `ℓ`-adic procyclic quotient (`DiscreteModule.IsEllAdicQuotient`), and
`Hᵠ(G, M) = 0` for `q ≥ 2` and every `ℓ`-primary discrete `G`-module `M`, for every prime `ℓ`
(blueprint `lemma-cohomological-dimension-base-field`).

## Main statements

- `FiniteField.mem_iff_pow_card_pow_finrank_eq`: a finite subextension of degree `n` consists of
  the roots of `X ^ (q ^ n) - X`.
- `FiniteField.exists_continuousMonoidHom_zmod`: the characters `G → ℤ / N`.
- `FiniteField.exists_isEllAdicQuotient`: the `ℓ`-adic procyclic quotient of `G`.
- `FiniteField.subsingleton_H_galois`: the vanishing above degree one.
-/

@[expose] public section

universe w u

open Module Polynomial

/-- If `x ^ Q = x`, then `x ^ (Q ^ m) = x` for all `m`. -/
lemma pow_pow_eq_self_of_pow_eq_self {M : Type*} [Monoid M] {x : M} {Q : ℕ} (h : x ^ Q = x)
    (m : ℕ) : x ^ Q ^ m = x := by
  induction m with
  | zero => rw [pow_zero, pow_one]
  | succ m ih => rw [pow_succ, pow_mul, ih, h]

/-- If `x ^ (Q ^ a) = x` and `a ∣ n`, then `x ^ (Q ^ n) = x`. -/
lemma pow_pow_eq_self_of_dvd {M : Type*} [Monoid M] {x : M} {Q a n : ℕ}
    (h : x ^ Q ^ a = x) (hn : a ∣ n) : x ^ Q ^ n = x := by
  obtain ⟨c, rfl⟩ := hn
  rw [pow_mul]
  exact pow_pow_eq_self_of_pow_eq_self h c

namespace FiniteField

variable {k Ω : Type*} [Field k] [Fintype k] [Field Ω] [Algebra k Ω]

/-- In an extension `Ω` of a finite field `k` with `q` elements, a finite intermediate field `E`
of degree `n` consists exactly of the roots of `X ^ (q ^ n) - X`. -/
theorem mem_iff_pow_card_pow_finrank_eq (E : IntermediateField k Ω) [FiniteDimensional k E]
    {x : Ω} : x ∈ E ↔ x ^ Fintype.card k ^ finrank k E = x := by
  classical
  have : Finite E := Module.finite_of_finite k
  have := Fintype.ofFinite E
  set Q := Fintype.card k ^ finrank k E
  have hQ : Fintype.card E = Q := Module.card_eq_pow_finrank
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · have := FiniteField.pow_card (⟨x, hx⟩ : E)
    rw [hQ] at this
    exact congrArg Subtype.val this
  · have h1 : 1 < Q := Nat.one_lt_pow finrank_pos.ne' Fintype.one_lt_card
    have hne : (X ^ Q - X : Ω[X]) ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero Ω h1
    let T := (X ^ Q - X : Ω[X]).roots.toFinset
    have hT {y : Ω} : y ∈ T ↔ y ^ Q = y := by
      simp [T, mem_roots hne, sub_eq_zero]
    let S : Finset Ω := Finset.univ.map (Function.Embedding.subtype (· ∈ E))
    have hS : S ⊆ T := by
      intro y hy
      simp only [S, Finset.mem_map, Finset.mem_univ, true_and, Function.Embedding.coe_subtype]
        at hy
      obtain ⟨y, rfl⟩ := hy
      rw [hT, ← hQ]
      exact congrArg Subtype.val (FiniteField.pow_card y)
    have hcard : T.card ≤ S.card := by
      rw [Finset.card_map, Finset.card_univ, hQ]
      exact (Multiset.toFinset_card_le _).trans
        ((card_roots' _).trans (FiniteField.X_pow_card_sub_X_natDegree_eq Ω h1).le)
    have hxT : x ∈ T := hT.2 hx
    rw [← Finset.eq_of_subset_of_card_le hS hcard] at hxT
    simpa [S] using hxT

variable (k Ω) in
/-- **The characters `Gal(Ω/k) → ℤ / N`.** For `N > 0` there is a continuous homomorphism
`χ : Gal(Ω/k) → ℤ / N` such that `χ σ = a` if and only if `σ` acts as `x ↦ x ^ (q ^ a)` on the
roots of `X ^ (q ^ N) - X`, the subextension of degree `N`. -/
theorem exists_continuousMonoidHom_zmod [IsAlgClosed Ω] {N : ℕ} (hN : N ≠ 0) :
    ∃ χ : Gal(Ω/k) →ₜ* Multiplicative (ZMod N), ∀ (σ : Gal(Ω/k)) (a : ℕ),
      χ σ = .ofAdd (a : ZMod N) ↔
        ∀ x : Ω, x ^ Fintype.card k ^ N = x → σ x = x ^ Fintype.card k ^ a := by
  classical
  obtain ⟨E, hE⟩ := exists_intermediateField_finrank_eq k Ω (Nat.pos_of_ne_zero hN)
  have hEfin : FiniteDimensional k E := Module.finite_of_finrank_pos (hE ▸ Nat.pos_of_ne_zero hN)
  have hmem (x : Ω) : x ∈ E ↔ x ^ Fintype.card k ^ N = x := by
    rw [mem_iff_pow_card_pow_finrank_eq E, hE]
  have : Finite E := Module.finite_of_finite k
  let φ := frobeniusAlgEquivOfAlgebraic k E
  have hgen (g : Gal(E/k)) : g ∈ Subgroup.zpowers φ := by
    obtain ⟨i, rfl⟩ := (bijective_frobeniusAlgEquivOfAlgebraic_pow k E).2 g
    exact ⟨i, zpow_natCast φ i⟩
  have hcard : Nat.card Gal(E/k) = N := by rw [IsGalois.card_aut_eq_finrank, hE]
  let e := zmodMulEquivOfGenerator hgen hcard
  let χ : Gal(Ω/k) →* Multiplicative (ZMod N) :=
    e.symm.toMonoidHom.comp (AlgEquiv.restrictNormalHom E)
  have hχ (σ : Gal(Ω/k)) (a : ℕ) : χ σ = .ofAdd (a : ZMod N) ↔
      ∀ x : Ω, x ^ Fintype.card k ^ N = x → σ x = x ^ Fintype.card k ^ a := by
    have he : e (.ofAdd (a : ZMod N)) = φ ^ a := by
      rw [← Int.cast_natCast, zmodMulEquivOfGenerator_apply_ofAdd_intCast, zpow_natCast]
    simp only [χ, MonoidHom.coe_comp, Function.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.symm_apply_eq, he, AlgEquiv.ext_iff]
    refine ⟨fun h x hx ↦ ?_, fun h y ↦ ?_⟩
    · have := congrArg Subtype.val (h ⟨x, (hmem x).2 hx⟩)
      rw [AlgEquiv.restrictNormalHom_apply, AlgEquiv.coe_pow,
        coe_frobeniusAlgEquivOfAlgebraic_iterate] at this
      simpa using this
    · apply Subtype.val_injective
      rw [AlgEquiv.restrictNormalHom_apply, AlgEquiv.coe_pow,
        coe_frobeniusAlgEquivOfAlgebraic_iterate]
      simp [h y ((hmem y).1 y.2)]
  refine ⟨⟨χ, ?_⟩, hχ⟩
  refine continuous_of_continuousAt_one χ ?_
  rw [ContinuousAt, map_one, nhds_discrete (Multiplicative (ZMod N)), Filter.tendsto_pure]
  filter_upwards [E.fixingSubgroup_isOpen.mem_nhds E.fixingSubgroup.one_mem] with σ hσ
  have hσ' : σ ∈ (AlgEquiv.restrictNormalHom (K₁ := Ω) E).ker := by
    rwa [E.restrictNormalHom_ker]
  simp only [χ, MonoidHom.coe_comp, Function.comp_apply, (MonoidHom.mem_ker).1 hσ', map_one]

variable (k Ω) in
/-- **The `ℓ`-adic quotient of the absolute Galois group of a finite field.** For every prime
`ℓ`, the group `Gal(Ω/k)` has a continuous character `χ : Gal(Ω/k) → ℤ_ℓ` with `χ φ = 1` on the
arithmetic Frobenius `φ : x ↦ x ^ q`, whose kernel has all its finite quotients of order prime to
`ℓ`. The reduction of `χ σ` modulo `ℓ ^ m` is the exponent `a` with `σ = φ ^ a` on the
subextension of degree `ℓ ^ m`. -/
theorem exists_isEllAdicQuotient [IsAlgClosed Ω] [Algebra.IsAlgebraic k Ω] (ℓ : ℕ)
    [Fact ℓ.Prime] :
    ∃ χ : Gal(Ω/k) →ₜ* Multiplicative ℤ_[ℓ],
      DiscreteModule.IsEllAdicQuotient ℓ χ (frobeniusAlgEquivOfAlgebraic k Ω) := by
  classical
  have : IsAlgClosure k Ω := ⟨‹_›, ‹_›⟩
  set q := Fintype.card k
  set φ := frobeniusAlgEquivOfAlgebraic k Ω
  choose c hc using fun n : ℕ ↦ exists_continuousMonoidHom_zmod k Ω
    (pow_ne_zero n (Fact.out : ℓ.Prime).ne_zero)
  have hc' (n : ℕ) (σ : Gal(Ω/k)) :
      c n σ = .ofAdd (((c n σ).toAdd.val : ℕ) : ZMod (ℓ ^ n)) := by
    rw [ZMod.natCast_zmod_val, ofAdd_toAdd]
  have hcompat (n : ℕ) (σ : Gal(Ω/k)) :
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_add_right n 1)) (ZMod (ℓ ^ n)) (c (n + 1) σ).toAdd =
        (c n σ).toAdd := by
    set a := (c (n + 1) σ).toAdd.val
    have h2 : c n σ = .ofAdd (a : ZMod (ℓ ^ n)) :=
      (hc n σ a).2 fun x hx ↦ (hc (n + 1) σ a).1 (hc' (n + 1) σ) x
        (pow_pow_eq_self_of_dvd hx (pow_dvd_pow ℓ (Nat.le_add_right n 1)))
    rw [h2, toAdd_ofAdd, ZMod.castHom_apply, ← ZMod.natCast_zmod_val (c (n + 1) σ).toAdd,
      ZMod.cast_natCast (pow_dvd_pow ℓ (Nat.le_add_right n 1))]
  set χ := (PadicInt.continuousMonoidHomEquiv ℓ Gal(Ω/k)).symm ⟨c, hcompat⟩
  have hχc (n : ℕ) (g : Gal(Ω/k)) : PadicInt.toZModPow n (χ g).toAdd = (c n g).toAdd :=
    congrArg (fun f ↦ (f.1 n g).toAdd)
      ((PadicInt.continuousMonoidHomEquiv ℓ Gal(Ω/k)).apply_symm_apply ⟨c, hcompat⟩)
  have hc1 (n : ℕ) : c n φ = .ofAdd 1 := by
    simpa using (hc n φ 1).2 fun x _ ↦ by simp [φ]
  refine ⟨χ, ⟨?_, fun U hU ↦ ?_⟩⟩
  · apply Multiplicative.toAdd.injective
    refine PadicInt.ext_of_toZModPow.mp fun n ↦ ?_
    rw [hχc, hc1, toAdd_ofAdd, toAdd_ofAdd, map_one]
  -- the `ℓ`-freeness of `ker χ`
  obtain ⟨E, hEfin, hEnorm, hEU⟩ := (krullTopology_mem_nhds_one_iff_of_normal k Ω U).1
    (hU.mem_nhds U.one_mem)
  have : Finite E := Module.finite_of_finite k
  set N := E.fixingSubgroup
  set K := χ.toMonoidHom.ker
  set n := finrank k E
  have hn0 : n ≠ 0 := Module.finrank_pos.ne'
  set b := n.factorization ℓ
  set M := (c b).toMonoidHom.ker
  have hKM : K ≤ M := fun σ (hσ : χ σ = 1) ↦ by
    have := hχc b σ
    rw [hσ, toAdd_one, map_zero] at this
    exact MonoidHom.mem_ker.2 (Multiplicative.toAdd.injective (this.symm.trans toAdd_one.symm))
  have hNM : N ≤ M := by
    intro σ hσ
    have : c b σ = .ofAdd ((0 : ℕ) : ZMod (ℓ ^ b)) := (hc b σ 0).2 fun x hx ↦ by
      have hxE : x ∈ E :=
        (mem_iff_pow_card_pow_finrank_eq E).2 (pow_pow_eq_self_of_dvd hx (Nat.ordProj_dvd n ℓ))
      rw [pow_zero, pow_one]
      exact (_root_.mem_fixingSubgroup_iff _).1 hσ x hxE
    rw [Nat.cast_zero, ofAdd_zero] at this
    exact MonoidHom.mem_ker.2 this
  have hMindex : M.index = ℓ ^ b := by
    rw [Subgroup.index_ker]
    have : (c b).toMonoidHom.range = ⊤ := by
      rw [eq_top_iff]
      rintro x -
      refine ⟨φ ^ x.toAdd.val, Multiplicative.toAdd.injective ?_⟩
      simp [hc1]
    rw [this, Subgroup.card_top]
    exact (Nat.card_congr Multiplicative.toAdd).trans (Nat.card_zmod _)
  have hNker : (AlgEquiv.restrictNormalHom (K₁ := Ω) E).ker = N := E.restrictNormalHom_ker
  have hNindex : N.index = n := by
    rw [← hNker, Subgroup.index_ker,
      MonoidHom.range_eq_top_of_surjective _ (AlgEquiv.restrictNormalHom_surjective Ω),
      Subgroup.card_top, IsGalois.card_aut_eq_finrank]
  intro hdvd
  have h1 : ℓ ∣ N.relIndex K := hdvd.trans (Subgroup.relIndex_dvd_of_le_left K hEU)
  have : N.Normal := by
    rw [← hNker]
    exact MonoidHom.normal_ker _
  rw [← Subgroup.relIndex_sup_right] at h1
  have h2 : N.relIndex (K ⊔ N) ∣ N.relIndex M :=
    ⟨_, (Subgroup.relIndex_mul_relIndex N (K ⊔ N) M le_sup_right (sup_le hKM hNM)).symm⟩
  have h3 : N.relIndex M * ℓ ^ b = n := by
    rw [← hMindex, ← hNindex]
    exact Subgroup.relIndex_mul_index hNM
  obtain ⟨d, hd⟩ := h1.trans h2
  have h4 : ℓ ^ (b + 1) ∣ n := ⟨d, by rw [← h3, hd]; ring⟩
  exact Nat.pow_succ_factorization_not_dvd hn0 (Fact.out : ℓ.Prime) h4

omit [Fintype k] in
/-- Blueprint `lemma-cohomological-dimension-base-field` (Galois cohomology form): the absolute
Galois group of a finite field has `ℓ`-cohomological dimension one, for every prime `ℓ`:
`Hᵠ(Gal(Ω/k), M) = 0` for `q > 1` and every `ℓ`-primary discrete `Gal(Ω/k)`-module `M`. -/
theorem subsingleton_H_galois [Finite k] [IsAlgClosed Ω] [Algebra.IsAlgebraic k Ω] (ℓ : ℕ)
    [Fact ℓ.Prime] (M : DiscreteModule.{w} Gal(Ω/k)) (hM : DiscreteModule.IsPrimary ℓ M) {q : ℕ}
    (hq : 1 < q) : Subsingleton (DiscreteModule.H Gal(Ω/k) M q) := by
  have := Fintype.ofFinite k
  have : IsAlgClosure k Ω := ⟨‹_›, ‹_›⟩
  have : IsGalois k Ω := ⟨⟩
  obtain ⟨χ, h⟩ := exists_isEllAdicQuotient k Ω ℓ
  exact h.subsingleton_H M hM hq

end FiniteField
