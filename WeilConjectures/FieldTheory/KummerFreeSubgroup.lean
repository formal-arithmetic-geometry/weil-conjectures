/-! ### Kummer characters -/

namespace IsPrimitiveRoot

variable {M : Type*} [CommMonoid M] {z : M} {n : ℕ}

/-- Powers of a primitive `n`-th root of unity only depend on the exponent modulo `n`. -/
theorem pow_val_natCast (hz : IsPrimitiveRoot z n) (k : ℕ) : z ^ (k : ZMod n).val = z ^ k := by
  have := pow_mod_orderOf z k
  rwa [← hz.eq_orderOf, ← ZMod.val_natCast] at this

/-- The powers `z ^ c.val`, `c : ZMod n`, of a primitive `n`-th root of unity `z` are
distinct. -/
theorem pow_val_injective [NeZero n] (hz : IsPrimitiveRoot z n) :
    Function.Injective fun c : ZMod n ↦ z ^ c.val :=
  fun c c' h ↦ ZMod.val_injective n (hz.pow_inj (ZMod.val_lt c) (ZMod.val_lt c') h)

theorem pow_val_add [NeZero n] (hz : IsPrimitiveRoot z n) (c c' : ZMod n) :
    z ^ (c + c').val = z ^ c.val * z ^ c'.val := by
  rw [← pow_add, ← hz.pow_val_natCast (c.val + c'.val), Nat.cast_add, ZMod.natCast_zmod_val,
    ZMod.natCast_zmod_val]

end IsPrimitiveRoot

/-- If `s (m + 1) ^ r = s m` for all `m`, then `s m ^ r ^ m = s 0`. -/
theorem pow_pow_eq_of_succ_pow_eq {M : Type*} [Monoid M] {s : ℕ → M} {r : ℕ}
    (hs : ∀ m, s (m + 1) ^ r = s m) (m : ℕ) : s m ^ r ^ m = s 0 := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ', pow_mul, hs, ih]

/-- In a separably closed field in which `r` is invertible, every element `y` has a compatible
system of `r`-power roots: `s 0 = y` and `s (m + 1) ^ r = s m`. -/
theorem IsSepClosed.exists_succ_pow_eq {L : Type*} [Field L] [IsSepClosed L] (r : ℕ)
    [NeZero (r : L)] (y : L) : ∃ s : ℕ → L, s 0 = y ∧ ∀ m, s (m + 1) ^ r = s m :=
  ⟨fun m ↦ Nat.rec y (fun _ x ↦ (IsSepClosed.exists_pow_nat_eq x r).choose) m, rfl,
    fun _ ↦ (IsSepClosed.exists_pow_nat_eq _ r).choose_spec⟩

/-- A *Kummer system* for `r` over `K` in `L`: compatible primitive `r ^ m`-th roots of unity
`ζ m` fixed by `L ≃ₐ[K] L`, and compatible `r ^ m`-th roots `α m` of a nonzero element `α 0`
fixed by `L ≃ₐ[K] L`. -/
structure KummerSystem (K L : Type*) [Field K] [Field L] [Algebra K L] (r : ℕ) where
  /-- The compatible primitive `r ^ m`-th roots of unity. -/
  ζ : ℕ → L
  /-- The compatible `r ^ m`-th roots of `α 0`. -/
  α : ℕ → L
  isPrimitiveRoot_ζ (m : ℕ) : IsPrimitiveRoot (ζ m) (r ^ m)
  ζ_succ_pow (m : ℕ) : ζ (m + 1) ^ r = ζ m
  map_ζ (σ : L ≃ₐ[K] L) (m : ℕ) : σ (ζ m) = ζ m
  α_succ_pow (m : ℕ) : α (m + 1) ^ r = α m
  α_zero_ne_zero : α 0 ≠ 0
  map_α_zero (σ : L ≃ₐ[K] L) : σ (α 0) = α 0

namespace KummerSystem

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {r : ℕ} [Fact r.Prime]
  (S : KummerSystem K L r)

omit [Fact r.Prime] in
theorem α_pow (m : ℕ) : S.α m ^ r ^ m = S.α 0 :=
  pow_pow_eq_of_succ_pow_eq S.α_succ_pow m

theorem α_ne_zero (m : ℕ) : S.α m ≠ 0 := fun h ↦
  S.α_zero_ne_zero (by rw [← S.α_pow m, h, zero_pow (pow_ne_zero _ (Fact.out : r.Prime).ne_zero)])

theorem exists_eq_pow_val_mul (σ : L ≃ₐ[K] L) (m : ℕ) :
    ∃ c : ZMod (r ^ m), σ (S.α m) = S.ζ m ^ c.val * S.α m := by
  obtain ⟨i, hi, hzi⟩ := (S.isPrimitiveRoot_ζ m).eq_pow_of_pow_eq_one (ξ := σ (S.α m) / S.α m)
    (by rw [div_pow, ← map_pow, S.α_pow, S.map_α_zero, div_self S.α_zero_ne_zero])
  refine ⟨i, ?_⟩
  rw [ZMod.val_cast_of_lt hi, hzi, div_mul_cancel₀ _ (S.α_ne_zero m)]

theorem eq_of_pow_val_mul_eq {m : ℕ} {c c' : ZMod (r ^ m)}
    (h : S.ζ m ^ c.val * S.α m = S.ζ m ^ c'.val * S.α m) : c = c' :=
  (S.isPrimitiveRoot_ζ m).pow_val_injective (mul_right_cancel₀ (S.α_ne_zero m) h)

/-- The Kummer character modulo `r ^ m`: `σ (α m) = ζ m ^ c * α m` with `c = charZMod m σ`. -/
noncomputable def charZMod (m : ℕ) : (L ≃ₐ[K] L) →* Multiplicative (ZMod (r ^ m)) where
  toFun σ := .ofAdd (S.exists_eq_pow_val_mul σ m).choose
  map_one' := congrArg Multiplicative.ofAdd (S.eq_of_pow_val_mul_eq
    ((S.exists_eq_pow_val_mul 1 m).choose_spec.symm.trans (by simp)))
  map_mul' σ τ := by
    have hσ := (S.exists_eq_pow_val_mul σ m).choose_spec
    have hτ := (S.exists_eq_pow_val_mul τ m).choose_spec
    have hστ := (S.exists_eq_pow_val_mul (σ * τ) m).choose_spec
    generalize (S.exists_eq_pow_val_mul σ m).choose = a at hσ ⊢
    generalize (S.exists_eq_pow_val_mul τ m).choose = b at hτ ⊢
    generalize (S.exists_eq_pow_val_mul (σ * τ) m).choose = c at hστ ⊢
    rw [← ofAdd_add]
    refine congrArg Multiplicative.ofAdd (S.eq_of_pow_val_mul_eq (hστ.symm.trans ?_))
    rw [AlgEquiv.mul_apply, hτ, map_mul, map_pow, S.map_ζ, hσ,
      (S.isPrimitiveRoot_ζ m).pow_val_add]
    ring

theorem charZMod_spec (σ : L ≃ₐ[K] L) (m : ℕ) :
    σ (S.α m) = S.ζ m ^ (S.charZMod m σ).toAdd.val * S.α m :=
  (S.exists_eq_pow_val_mul σ m).choose_spec

theorem charZMod_eq_iff {σ : L ≃ₐ[K] L} {m : ℕ} {c : ZMod (r ^ m)} :
    (S.charZMod m σ).toAdd = c ↔ σ (S.α m) = S.ζ m ^ c.val * S.α m :=
  ⟨fun h ↦ h ▸ S.charZMod_spec σ m,
    fun h ↦ S.eq_of_pow_val_mul_eq ((S.charZMod_spec σ m).symm.trans h)⟩

theorem castHom_charZMod_succ (m : ℕ) (σ : L ≃ₐ[K] L) :
    ZMod.castHom (pow_dvd_pow r (Nat.le_add_right m 1)) (ZMod (r ^ m))
      (S.charZMod (m + 1) σ).toAdd = (S.charZMod m σ).toAdd := by
  rw [eq_comm, charZMod_eq_iff, ZMod.castHom_apply, ZMod.cast_eq_val,
    (S.isPrimitiveRoot_ζ m).pow_val_natCast, ← S.α_succ_pow, ← S.ζ_succ_pow, map_pow,
    S.charZMod_spec σ (m + 1)]
  ring

theorem continuous_charZMod [Algebra.IsIntegral K L] (m : ℕ) : Continuous (S.charZMod m) := by
  refine continuous_of_continuousAt_one _ ?_
  rw [ContinuousAt, map_one, nhds_discrete (Multiplicative (ZMod (r ^ m))), Filter.tendsto_pure]
  have := adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (R := K) (S.α m))
  filter_upwards [(K⟮S.α m⟯.fixingSubgroup_isOpen).mem_nhds (one_mem _)] with τ hτ
  have hτ' : τ (S.α m) = S.α m :=
    (_root_.mem_fixingSubgroup_iff _).mp hτ _ (mem_adjoin_simple_self K _)
  rw [← toAdd_eq_zero, charZMod_eq_iff, hτ']
  simp

/-- The Kummer character `(L ≃ₐ[K] L) → ℤ_[r]` of a Kummer system: its reduction modulo `r ^ m`
is `charZMod m`. -/
noncomputable def char [Algebra.IsIntegral K L] : (L ≃ₐ[K] L) →ₜ* Multiplicative ℤ_[r] :=
  (PadicInt.continuousMonoidHomEquiv r _).symm
    ⟨fun m ↦ ⟨S.charZMod m, S.continuous_charZMod m⟩, fun m σ ↦ S.castHom_charZMod_succ m σ⟩

variable [Algebra.IsIntegral K L]

theorem toZModPow_char (m : ℕ) (σ : L ≃ₐ[K] L) :
    PadicInt.toZModPow m (S.char σ).toAdd = (S.charZMod m σ).toAdd := by
  rw [← PadicInt.continuousMonoidHomEquiv_apply_coe, char, Equiv.apply_symm_apply]
  rfl

end KummerSystem

/-- Existence of Kummer systems: if `L` is separably closed, `r` is invertible in `K` and `K`
contains all `r ^ m`-th roots of unity, then every nonzero `x ∈ K` is the start `α 0` of a
Kummer system. -/
theorem KummerSystem.exists_α_zero_eq {K L : Type*} [Field K] [Field L] [Algebra K L]
    [IsSepClosed L] {r : ℕ} [Fact r.Prime] (hr : (r : K) ≠ 0)
    (hζ : ∀ m, ∃ ζ : K, IsPrimitiveRoot ζ (r ^ m)) {x : K} (hx : x ≠ 0) :
    ∃ S : KummerSystem K L r, S.α 0 = algebraMap K L x := by
  have hr' : r.Prime := Fact.out
  have : NeZero (r : L) := ⟨by rwa [← map_natCast (algebraMap K L), map_ne_zero]⟩
  obtain ⟨ζ₁, hζ₁⟩ := hζ 1
  have hζ₁' : IsPrimitiveRoot (algebraMap K L ζ₁) r := by
    simpa using hζ₁.map_of_injective (algebraMap K L).injective
  obtain ⟨w, hw0, hw⟩ := IsSepClosed.exists_succ_pow_eq r (algebraMap K L ζ₁)
  obtain ⟨α, hα0, hα⟩ := IsSepClosed.exists_succ_pow_eq r (algebraMap K L x)
  have hwprim (m : ℕ) : IsPrimitiveRoot (w m) (r ^ (m + 1)) := by
    have h1 : w m ^ r ^ m = algebraMap K L ζ₁ := hw0 ▸ pow_pow_eq_of_succ_pow_eq hw m
    have := IsPrimitiveRoot.orderOf (w m)
    rwa [orderOf_eq_prime_pow (by rw [h1]; exact hζ₁'.ne_one hr'.one_lt)
      (by rw [pow_succ, pow_mul, h1, hζ₁'.pow_eq_one])] at this
  refine ⟨⟨fun m ↦ w m ^ r, α, fun m ↦ ?_, fun m ↦ ?_, fun σ m ↦ ?_, hα, ?_, fun σ ↦ ?_⟩, hα0⟩
  · exact (hwprim m).pow (pow_pos hr'.pos _) (pow_succ' r m)
  · rw [hw]
  · obtain ⟨ζ, hζm⟩ := hζ m
    obtain ⟨i, -, hi⟩ := (hζm.map_of_injective (algebraMap K L).injective).eq_pow_of_pow_eq_one
      (ξ := w m ^ r) (by rw [← pow_mul, ← pow_succ', (hwprim m).pow_eq_one])
    rw [← hi, map_pow, AlgEquiv.commutes]
  · rwa [hα0, map_ne_zero]
  · rw [hα0, AlgEquiv.commutes]

