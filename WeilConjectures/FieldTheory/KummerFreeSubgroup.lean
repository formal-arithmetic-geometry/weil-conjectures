/-!
# Free abelian subgroups of Galois groups detected by Kummer characters

Let `K` be a field, `r` a prime invertible in `K` such that `K` contains all `r ^ m`-th roots of
unity, and `L` a separable closure of `K`. For finitely many nonzero `f i ∈ K` which are not
`r`-th powers, we construct a homomorphism `φ` from a free abelian group of countable rank to
`L ≃ₐ[K] L` such that `φ x` fixes all the `r`-power roots of some `f i` only when `x = 1`.

The construction goes through the Kummer characters `χ_f : (L ≃ₐ[K] L) → ℤ_[r]`, defined by
`σ (f ^ (1 / r ^ m)) = ζ_{r ^ m} ^ χ_f(σ) * f ^ (1 / r ^ m)` (`KummerSystem.char`). These are
continuous for the Krull topology, and nontrivial when `f` is not an `r`-th power. We choose
`σ` on which all the `χ_{f i}` are nonzero (`exists_forall_map_ne_one`); on the closure `C` of
the cyclic group generated by `σ` all these characters are proportional, and the image of `C`
under each of them is `ℤ_[r] χ(σ)`. Since `ℤ_[r]` contains a transcendental element `t`, the
powers `t ^ j` give countably many elements of the abelian group `C` with `ℤ`-linearly
independent characters.

## Main definitions

- `KummerSystem`: compatible systems of `r`-power roots of unity and of `r`-power roots of an
  element of `K`.
- `KummerSystem.char`: the associated continuous Kummer character `(L ≃ₐ[K] L) → ℤ_[r]`.

## Main statements

- `exists_forall_map_ne_one`: finitely many nontrivial characters with values in a torsion-free
  group have a common non-kernel element.
- `ContinuousMonoidHom.exists_monoidHom_finsupp`: a family of continuous `ℤ_[p]`-characters of a
  compact group, all nonzero on one element, is jointly injective on some free abelian subgroup
  of countable rank.
- `exists_injective_kummer_free_of_isSepClosed`, `exists_injective_kummer_free`: the main
  result, for an arbitrary separable closure and for `SeparableClosure K` respectively.
-/

@[expose] public section

open Topology IntermediateField

universe u w

/-! ### Choosing an element on which finitely many characters are nonzero -/

/-- Finitely many nontrivial homomorphisms from a group to a torsion-free group (here the
additive group of a domain of characteristic zero) have a common element outside their
kernels. -/
theorem exists_forall_map_ne_one {G R ι : Type*} [Group G] [CommRing R] [IsDomain R]
    [CharZero R] [Finite ι] (χ : ι → G →* Multiplicative R) (hχ : ∀ i, ∃ g, χ i g ≠ 1) :
    ∃ g, ∀ i, χ i g ≠ 1 := by
  classical
  have := Fintype.ofFinite ι
  suffices ∀ s : Finset ι, ∃ g, ∀ i ∈ s, χ i g ≠ 1 by simpa using this Finset.univ
  intro s
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert j s hj ih =>
    obtain ⟨g, hg⟩ := ih
    by_cases hgj : χ j g = 1
    · obtain ⟨h, hh⟩ := hχ j
      have hfin : (⋃ i ∈ s, {n : ℕ | χ i (g ^ n * h) = 1}).Finite := by
        refine s.finite_toSet.biUnion fun i hi ↦ Set.Subsingleton.finite ?_
        intro n hn n' hn'
        have ha : (χ i g).toAdd ≠ 0 := fun h0 ↦ hg i hi (by rwa [toAdd_eq_zero] at h0)
        replace hn := congrArg Multiplicative.toAdd hn
        replace hn' := congrArg Multiplicative.toAdd hn'
        simp only [map_mul, map_pow, toAdd_mul, toAdd_pow, nsmul_eq_mul, toAdd_one] at hn hn'
        have h' : (n : R) * (χ i g).toAdd = n' * (χ i g).toAdd := by
          linear_combination hn - hn'
        exact_mod_cast mul_right_cancel₀ ha h'
      obtain ⟨n, hn⟩ := hfin.exists_notMem
      simp only [Set.mem_iUnion, Set.mem_ofPred_eq, not_exists] at hn
      refine ⟨g ^ n * h, fun i hi ↦ ?_⟩
      rcases Finset.mem_insert.mp hi with rfl | hi
      · simpa [hgj] using hh
      · exact hn i hi
    · exact ⟨g, fun i hi ↦ (Finset.mem_insert.mp hi).elim (fun h ↦ h ▸ hgj) (hg i)⟩

/-! ### Continuous `ℤ_[p]`-characters on the closure of a cyclic subgroup -/

namespace ContinuousMonoidHom

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] {p : ℕ}
  [Fact p.Prime]

/-- Two continuous `ℤ_[p]`-valued characters are proportional on the closure of a cyclic
subgroup. -/
theorem toAdd_mul_toAdd_eq_of_mem_closure_zpowers (χ χ' : G →ₜ* Multiplicative ℤ_[p])
    {σ τ : G} (hτ : τ ∈ (Subgroup.zpowers σ).topologicalClosure) :
    (χ' σ).toAdd * (χ τ).toAdd = (χ σ).toAdd * (χ' τ).toAdd := by
  rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe] at hτ
  refine closure_minimal (t := {τ | (χ' σ).toAdd * (χ τ).toAdd = (χ σ).toAdd * (χ' τ).toAdd})
    ?_ (isClosed_eq ?_ ?_) hτ
  · rintro _ ⟨n, rfl⟩
    simp only [Set.mem_ofPred_eq, map_zpow, toAdd_zpow, zsmul_eq_mul]
    ring
  · exact continuous_const.mul (continuous_toAdd.comp χ.continuous)
  · exact continuous_const.mul (continuous_toAdd.comp χ'.continuous)

/-- The image under a continuous `ℤ_[p]`-character `χ` of the closure of the cyclic subgroup
generated by `σ` contains all the multiples `b * χ σ`, for `b ∈ ℤ_[p]`. -/
theorem exists_mem_closure_zpowers_toAdd_eq [CompactSpace G] (χ : G →ₜ* Multiplicative ℤ_[p])
    (σ : G) (b : ℤ_[p]) :
    ∃ τ ∈ (Subgroup.zpowers σ).topologicalClosure, (χ τ).toAdd = b * (χ σ).toAdd := by
  have hχ : Continuous fun τ ↦ (χ τ).toAdd := continuous_toAdd.comp χ.continuous
  have hC : IsClosed ((fun τ ↦ (χ τ).toAdd) ''
      ((Subgroup.zpowers σ).topologicalClosure : Set G)) :=
    IsCompact.isClosed ((Subgroup.isClosed_topologicalClosure _).isCompact.image hχ)
  have hsub : Set.range (Int.cast : ℤ → ℤ_[p]) ⊆ (· * (χ σ).toAdd) ⁻¹'
      ((fun τ ↦ (χ τ).toAdd) '' ((Subgroup.zpowers σ).topologicalClosure : Set G)) := by
    rintro _ ⟨n, rfl⟩
    refine ⟨σ ^ n, Subgroup.le_topologicalClosure _ (Subgroup.zpow_mem_zpowers σ n), ?_⟩
    simp [zsmul_eq_mul]
  obtain ⟨τ, hτ, h⟩ := closure_minimal hsub (hC.preimage (continuous_id.mul continuous_const))
    (PadicInt.denseRange_intCast b)
  exact ⟨τ, hτ, h⟩

/-- A family of continuous `ℤ_[p]`-characters `χ i` of a compact group which are all nonzero
on one element `σ` is jointly injective on some free abelian subgroup of countable rank: there
is `φ : ⊕_ℕ ℤ → G` such that `χ i (φ x) = 0` only for `x = 0`. -/
theorem exists_monoidHom_finsupp [CompactSpace G] [T2Space G] {ι : Type*}
    (χ : ι → G →ₜ* Multiplicative ℤ_[p]) {σ : G} (hσ : ∀ i, χ i σ ≠ 1) :
    ∃ φ : Multiplicative (ULift.{w} ℕ →₀ ℤ) →* G, ∀ i x, χ i (φ x) = 1 → x = 1 := by
  rcases isEmpty_or_nonempty ι with hι | ⟨⟨i₀⟩⟩
  · exact ⟨1, fun i ↦ isEmptyElim i⟩
  obtain ⟨t, ht⟩ := PadicInt.exists_transcendental p
  choose τ hτC hτ using fun j : ULift.{w} ℕ ↦
    (χ i₀).exists_mem_closure_zpowers_toAdd_eq σ (t ^ j.down)
  let C := (Subgroup.zpowers σ).topologicalClosure
  let _ : CommGroup C := (Subgroup.zpowers σ).commGroupTopologicalClosure fun x y ↦
    (IsMulCommutative.is_comm (M := Subgroup.zpowers σ)).comm x y
  let ψ : (ULift.{w} ℕ →₀ ℤ) →+ Additive C :=
    Finsupp.liftAddHom fun j ↦ zmultiplesHom (Additive C) (Additive.ofMul ⟨τ j, hτC j⟩)
  let φ : Multiplicative (ULift.{w} ℕ →₀ ℤ) →* G :=
    C.subtype.comp (AddMonoidHom.toMultiplicativeLeft ψ)
  have hφC (x) : φ x ∈ C := (AddMonoidHom.toMultiplicativeLeft ψ x).2
  have hφ (y : ULift.{w} ℕ →₀ ℤ) : (χ i₀ (φ (.ofAdd y))).toAdd =
      Finsupp.linearCombination ℤ (fun j : ULift.{w} ℕ ↦ t ^ j.down) y * (χ i₀ σ).toAdd := by
    induction y using Finsupp.induction_linear with
    | zero => simp
    | add y y' hy hy' =>
      rw [ofAdd_add, map_mul, map_mul, toAdd_mul, hy, hy', map_add, add_mul]
    | single j k =>
      simp [φ, ψ, AddMonoidHom.toMultiplicativeLeft, hτ j, zsmul_eq_mul, mul_assoc]
  refine ⟨φ, fun i x hx ↦ ?_⟩
  have h := toAdd_mul_toAdd_eq_of_mem_closure_zpowers (χ i₀) (χ i) (hφC x)
  rw [hx, toAdd_one, mul_zero] at h
  have hi : (χ i σ).toAdd ≠ 0 := fun h0 ↦ hσ i (by rwa [toAdd_eq_zero] at h0)
  have hi₀ : (χ i₀ σ).toAdd ≠ 0 := fun h0 ↦ hσ i₀ (by rwa [toAdd_eq_zero] at h0)
  rw [mul_eq_zero, or_iff_right hi, ← ofAdd_toAdd x, hφ, mul_eq_zero, or_iff_left hi₀] at h
  have hli := (ht.linearIndependent_pow.comp _ ULift.down_injective)
  rw [← ofAdd_toAdd x, linearIndependent_iff.mp hli _ h, ofAdd_zero]

end ContinuousMonoidHom

/-! ### Kummer characters -/

namespace IsPrimitiveRoot

variable {M : Type*} [CommMonoid M] {z : M} {n : ℕ}

/-- Powers of a primitive `n`-th root of unity only depend on the exponent modulo `n`. -/
theorem pow_val_natCast (hz : IsPrimitiveRoot z n) (k : ℕ) : z ^ (k : ZMod n).val = z ^ k := by
  have := pow_mod_orderOf z k
  rwa [← hz.eq_orderOf, ← ZMod.val_natCast] at this

/-- The powers `z ^ c.val`, `c : ZMod n`, of a primitive `n`-th root of unity `z` are
distinct. -/
theorem pow_val_injective [NeZero n] (hz : IsPrimitiveRoot z n) :
    Function.Injective fun c : ZMod n ↦ z ^ c.val :=
  fun c c' h ↦ ZMod.val_injective n (hz.pow_inj (ZMod.val_lt c) (ZMod.val_lt c') h)

theorem pow_val_add [NeZero n] (hz : IsPrimitiveRoot z n) (c c' : ZMod n) :
    z ^ (c + c').val = z ^ c.val * z ^ c'.val := by
  rw [← pow_add, ← hz.pow_val_natCast (c.val + c'.val), Nat.cast_add, ZMod.natCast_zmod_val,
    ZMod.natCast_zmod_val]

end IsPrimitiveRoot

/-- If `s (m + 1) ^ r = s m` for all `m`, then `s m ^ r ^ m = s 0`. -/
theorem pow_pow_eq_of_succ_pow_eq {M : Type*} [Monoid M] {s : ℕ → M} {r : ℕ}
    (hs : ∀ m, s (m + 1) ^ r = s m) (m : ℕ) : s m ^ r ^ m = s 0 := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ', pow_mul, hs, ih]

/-- In a separably closed field in which `r` is invertible, every element `y` has a compatible
system of `r`-power roots: `s 0 = y` and `s (m + 1) ^ r = s m`. -/
theorem IsSepClosed.exists_succ_pow_eq {L : Type*} [Field L] [IsSepClosed L] (r : ℕ)
    [NeZero (r : L)] (y : L) : ∃ s : ℕ → L, s 0 = y ∧ ∀ m, s (m + 1) ^ r = s m :=
  ⟨fun m ↦ Nat.rec y (fun _ x ↦ (IsSepClosed.exists_pow_nat_eq x r).choose) m, rfl,
    fun _ ↦ (IsSepClosed.exists_pow_nat_eq _ r).choose_spec⟩

/-- A *Kummer system* for `r` over `K` in `L`: compatible primitive `r ^ m`-th roots of unity
`ζ m` fixed by `L ≃ₐ[K] L`, and compatible `r ^ m`-th roots `α m` of a nonzero element `α 0`
fixed by `L ≃ₐ[K] L`. -/
structure KummerSystem (K L : Type*) [Field K] [Field L] [Algebra K L] (r : ℕ) where
  /-- The compatible primitive `r ^ m`-th roots of unity. -/
  ζ : ℕ → L
  /-- The compatible `r ^ m`-th roots of `α 0`. -/
  α : ℕ → L
  isPrimitiveRoot_ζ (m : ℕ) : IsPrimitiveRoot (ζ m) (r ^ m)
  ζ_succ_pow (m : ℕ) : ζ (m + 1) ^ r = ζ m
  map_ζ (σ : L ≃ₐ[K] L) (m : ℕ) : σ (ζ m) = ζ m
  α_succ_pow (m : ℕ) : α (m + 1) ^ r = α m
  α_zero_ne_zero : α 0 ≠ 0
  map_α_zero (σ : L ≃ₐ[K] L) : σ (α 0) = α 0

namespace KummerSystem

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {r : ℕ} [Fact r.Prime]
  (S : KummerSystem K L r)

omit [Fact r.Prime] in
theorem α_pow (m : ℕ) : S.α m ^ r ^ m = S.α 0 :=
  pow_pow_eq_of_succ_pow_eq S.α_succ_pow m

theorem α_ne_zero (m : ℕ) : S.α m ≠ 0 := fun h ↦
  S.α_zero_ne_zero (by rw [← S.α_pow m, h, zero_pow (pow_ne_zero _ (Fact.out : r.Prime).ne_zero)])

theorem exists_eq_pow_val_mul (σ : L ≃ₐ[K] L) (m : ℕ) :
    ∃ c : ZMod (r ^ m), σ (S.α m) = S.ζ m ^ c.val * S.α m := by
  obtain ⟨i, hi, hzi⟩ := (S.isPrimitiveRoot_ζ m).eq_pow_of_pow_eq_one (ξ := σ (S.α m) / S.α m)
    (by rw [div_pow, ← map_pow, S.α_pow, S.map_α_zero, div_self S.α_zero_ne_zero])
  refine ⟨i, ?_⟩
  rw [ZMod.val_cast_of_lt hi, hzi, div_mul_cancel₀ _ (S.α_ne_zero m)]

theorem eq_of_pow_val_mul_eq {m : ℕ} {c c' : ZMod (r ^ m)}
    (h : S.ζ m ^ c.val * S.α m = S.ζ m ^ c'.val * S.α m) : c = c' :=
  (S.isPrimitiveRoot_ζ m).pow_val_injective (mul_right_cancel₀ (S.α_ne_zero m) h)

/-- The Kummer character modulo `r ^ m`: `σ (α m) = ζ m ^ c * α m` with `c = charZMod m σ`. -/
noncomputable def charZMod (m : ℕ) : (L ≃ₐ[K] L) →* Multiplicative (ZMod (r ^ m)) where
  toFun σ := .ofAdd (S.exists_eq_pow_val_mul σ m).choose
  map_one' := congrArg Multiplicative.ofAdd (S.eq_of_pow_val_mul_eq
    ((S.exists_eq_pow_val_mul 1 m).choose_spec.symm.trans (by simp)))
  map_mul' σ τ := by
    have hσ := (S.exists_eq_pow_val_mul σ m).choose_spec
    have hτ := (S.exists_eq_pow_val_mul τ m).choose_spec
    have hστ := (S.exists_eq_pow_val_mul (σ * τ) m).choose_spec
    generalize (S.exists_eq_pow_val_mul σ m).choose = a at hσ ⊢
    generalize (S.exists_eq_pow_val_mul τ m).choose = b at hτ ⊢
    generalize (S.exists_eq_pow_val_mul (σ * τ) m).choose = c at hστ ⊢
    rw [← ofAdd_add]
    refine congrArg Multiplicative.ofAdd (S.eq_of_pow_val_mul_eq (hστ.symm.trans ?_))
    rw [AlgEquiv.mul_apply, hτ, map_mul, map_pow, S.map_ζ, hσ,
      (S.isPrimitiveRoot_ζ m).pow_val_add]
    ring

theorem charZMod_spec (σ : L ≃ₐ[K] L) (m : ℕ) :
    σ (S.α m) = S.ζ m ^ (S.charZMod m σ).toAdd.val * S.α m :=
  (S.exists_eq_pow_val_mul σ m).choose_spec

theorem charZMod_eq_iff {σ : L ≃ₐ[K] L} {m : ℕ} {c : ZMod (r ^ m)} :
    (S.charZMod m σ).toAdd = c ↔ σ (S.α m) = S.ζ m ^ c.val * S.α m :=
  ⟨fun h ↦ h ▸ S.charZMod_spec σ m,
    fun h ↦ S.eq_of_pow_val_mul_eq ((S.charZMod_spec σ m).symm.trans h)⟩

theorem castHom_charZMod_succ (m : ℕ) (σ : L ≃ₐ[K] L) :
    ZMod.castHom (pow_dvd_pow r (Nat.le_add_right m 1)) (ZMod (r ^ m))
      (S.charZMod (m + 1) σ).toAdd = (S.charZMod m σ).toAdd := by
  rw [eq_comm, charZMod_eq_iff, ZMod.castHom_apply, ZMod.cast_eq_val,
    (S.isPrimitiveRoot_ζ m).pow_val_natCast, ← S.α_succ_pow, ← S.ζ_succ_pow, map_pow,
    S.charZMod_spec σ (m + 1)]
  ring

theorem continuous_charZMod [Algebra.IsIntegral K L] (m : ℕ) : Continuous (S.charZMod m) := by
  refine continuous_of_continuousAt_one _ ?_
  rw [ContinuousAt, map_one, nhds_discrete (Multiplicative (ZMod (r ^ m))), Filter.tendsto_pure]
  have := adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (R := K) (S.α m))
  filter_upwards [(K⟮S.α m⟯.fixingSubgroup_isOpen).mem_nhds (one_mem _)] with τ hτ
  have hτ' : τ (S.α m) = S.α m :=
    (_root_.mem_fixingSubgroup_iff _).mp hτ _ (mem_adjoin_simple_self K _)
  rw [← toAdd_eq_zero, charZMod_eq_iff, hτ']
  simp

/-- The Kummer character `(L ≃ₐ[K] L) → ℤ_[r]` of a Kummer system: its reduction modulo `r ^ m`
is `charZMod m`. -/
noncomputable def char [Algebra.IsIntegral K L] : (L ≃ₐ[K] L) →ₜ* Multiplicative ℤ_[r] :=
  (PadicInt.continuousMonoidHomEquiv r _).symm
    ⟨fun m ↦ ⟨S.charZMod m, S.continuous_charZMod m⟩, fun m σ ↦ S.castHom_charZMod_succ m σ⟩

variable [Algebra.IsIntegral K L]

theorem toZModPow_char (m : ℕ) (σ : L ≃ₐ[K] L) :
    PadicInt.toZModPow m (S.char σ).toAdd = (S.charZMod m σ).toAdd := by
  rw [← PadicInt.continuousMonoidHomEquiv_apply_coe, char, Equiv.apply_symm_apply]
  rfl

theorem char_eq_one {σ : L ≃ₐ[K] L} (h : ∀ m, σ (S.α m) = S.α m) : S.char σ = 1 := by
  rw [← toAdd_eq_zero]
  refine PadicInt.ext_of_toZModPow.mp fun m ↦ ?_
  rw [toZModPow_char, map_zero, charZMod_eq_iff, h m]
  simp

theorem char_ne_one {σ : L ≃ₐ[K] L} (h : σ (S.α 1) ≠ S.α 1) : S.char σ ≠ 1 := by
  intro h1
  have := S.toZModPow_char 1 σ
  rw [h1, toAdd_one, map_zero, eq_comm, charZMod_eq_iff] at this
  exact h (by simpa using this)

/-- The Kummer character of an element of `K` which is not an `r`-th power is nontrivial. -/
theorem exists_char_ne_one [IsGalois K L] {x : K} (hα : S.α 0 = algebraMap K L x)
    (hx : ¬∃ u : K, u ^ r = x) : ∃ σ, S.char σ ≠ 1 := by
  obtain ⟨σ, hσ⟩ : ∃ σ : L ≃ₐ[K] L, σ (S.α 1) ≠ S.α 1 := by
    by_contra! H
    obtain ⟨u, hu⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (S.α 1)).mpr H
    refine hx ⟨u, (algebraMap K L).injective ?_⟩
    rw [map_pow, hu, ← hα]
    exact S.α_succ_pow 0
  exact ⟨σ, S.char_ne_one hσ⟩

end KummerSystem

/-- Existence of Kummer systems: if `L` is separably closed, `r` is invertible in `K` and `K`
contains all `r ^ m`-th roots of unity, then every nonzero `x ∈ K` is the start `α 0` of a
Kummer system. -/
theorem KummerSystem.exists_α_zero_eq {K L : Type*} [Field K] [Field L] [Algebra K L]
    [IsSepClosed L] {r : ℕ} [Fact r.Prime] (hr : (r : K) ≠ 0)
    (hζ : ∀ m, ∃ ζ : K, IsPrimitiveRoot ζ (r ^ m)) {x : K} (hx : x ≠ 0) :
    ∃ S : KummerSystem K L r, S.α 0 = algebraMap K L x := by
  have hr' : r.Prime := Fact.out
  have : NeZero (r : L) := ⟨by rwa [← map_natCast (algebraMap K L), map_ne_zero]⟩
  obtain ⟨ζ₁, hζ₁⟩ := hζ 1
  have hζ₁' : IsPrimitiveRoot (algebraMap K L ζ₁) r := by
    simpa using hζ₁.map_of_injective (algebraMap K L).injective
  obtain ⟨w, hw0, hw⟩ := IsSepClosed.exists_succ_pow_eq r (algebraMap K L ζ₁)
  obtain ⟨α, hα0, hα⟩ := IsSepClosed.exists_succ_pow_eq r (algebraMap K L x)
  have hwprim (m : ℕ) : IsPrimitiveRoot (w m) (r ^ (m + 1)) := by
    have h1 : w m ^ r ^ m = algebraMap K L ζ₁ := hw0 ▸ pow_pow_eq_of_succ_pow_eq hw m
    have := IsPrimitiveRoot.orderOf (w m)
    rwa [orderOf_eq_prime_pow (by rw [h1]; exact hζ₁'.ne_one hr'.one_lt)
      (by rw [pow_succ, pow_mul, h1, hζ₁'.pow_eq_one])] at this
  refine ⟨⟨fun m ↦ w m ^ r, α, fun m ↦ ?_, fun m ↦ ?_, fun σ m ↦ ?_, hα, ?_, fun σ ↦ ?_⟩, hα0⟩
  · exact (hwprim m).pow (pow_pos hr'.pos _) (pow_succ' r m)
  · rw [hw]
  · obtain ⟨ζ, hζm⟩ := hζ m
    obtain ⟨i, -, hi⟩ := (hζm.map_of_injective (algebraMap K L).injective).eq_pow_of_pow_eq_one
      (ξ := w m ^ r) (by rw [← pow_mul, ← pow_succ', (hwprim m).pow_eq_one])
    rw [← hi, map_pow, AlgEquiv.commutes]
  · rwa [hα0, map_ne_zero]
  · rw [hα0, AlgEquiv.commutes]

/-! ### The main result -/

/-- Let `L` be a separable closure of `K`, `r` a prime invertible in `K` such that `K` contains
all `r ^ m`-th roots of unity, and `f i ∈ K` finitely many nonzero elements which are not
`r`-th powers. There is a homomorphism `φ` from a free abelian group of countable rank to
`L ≃ₐ[K] L` such that, for each `i`, `φ x` fixes all the `r`-power roots of `f i` only when
`x = 1`. -/
theorem exists_injective_kummer_free_of_isSepClosed {K L : Type*} [Field K] [Field L]
    [Algebra K L] [IsSepClosed L] [IsGalois K L] {r : ℕ} (hr : r.Prime) (hrK : (r : K) ≠ 0)
    (hζ : ∀ m, ∃ ζ : K, IsPrimitiveRoot ζ (r ^ m)) {ι : Type*} [Finite ι] (f : ι → K)
    (hf0 : ∀ i, f i ≠ 0) (hf : ∀ i, ¬∃ u : K, u ^ r = f i) :
    ∃ φ : Multiplicative (ULift.{w} ℕ →₀ ℤ) →* (L ≃ₐ[K] L),
      ∀ i (x : Multiplicative (ULift.{w} ℕ →₀ ℤ)),
        (∀ (m : ℕ) (β : L), β ^ (r ^ m) = algebraMap K L (f i) → φ x β = β) → x = 1 := by
  have : Fact r.Prime := ⟨hr⟩
  choose S hS using fun i ↦ KummerSystem.exists_α_zero_eq (L := L) hrK hζ (hf0 i)
  obtain ⟨σ, hσ⟩ := exists_forall_map_ne_one (fun i ↦ (S i).char.toMonoidHom)
    fun i ↦ (S i).exists_char_ne_one (hS i) (hf i)
  obtain ⟨φ, hφ⟩ := ContinuousMonoidHom.exists_monoidHom_finsupp.{w} (fun i ↦ (S i).char) hσ
  exact ⟨φ, fun i x hx ↦ hφ i x ((S i).char_eq_one fun m ↦
    hx m _ (by rw [(S i).α_pow, hS i]))⟩

/-- **Free abelian subgroups detected by Kummer characters.** Let `r` be a prime invertible in
`K` such that `K` contains all `r ^ m`-th roots of unity, and `f i ∈ K` finitely many nonzero
elements which are not `r`-th powers. There is a homomorphism `φ` from a free abelian group of
countable rank to the absolute Galois group `Ksep ≃ₐ[K] Ksep` such that, for each `i`, `φ x`
fixes all the `r`-power roots of `f i` only when `x = 1`. -/
theorem exists_injective_kummer_free {K : Type u} [Field K] {r : ℕ} (hr : r.Prime)
    (hrK : (r : K) ≠ 0) (hζ : ∀ m, ∃ ζ : K, IsPrimitiveRoot ζ (r ^ m)) {ι : Type*} [Finite ι]
    (f : ι → K) (hf0 : ∀ i, f i ≠ 0) (hf : ∀ i, ¬∃ u : K, u ^ r = f i) :
    ∃ φ : Multiplicative (ULift.{w} ℕ →₀ ℤ) →* (SeparableClosure K ≃ₐ[K] SeparableClosure K),
      ∀ i (x : Multiplicative (ULift.{w} ℕ →₀ ℤ)),
        (∀ (m : ℕ) (β : SeparableClosure K), β ^ (r ^ m) = algebraMap K _ (f i) →
          φ x β = β) → x = 1 :=
  exists_injective_kummer_free_of_isSepClosed hr hrK hζ f hf0 hf
