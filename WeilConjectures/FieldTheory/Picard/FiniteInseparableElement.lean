module

public import WeilConjectures.FieldTheory.Picard.FieldTower
public import WeilConjectures.FieldTheory.SeparableExtension
public import Mathlib.FieldTheory.Separable
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# An inseparable element in a finite nonseparable field extension

A finite field extension that is not separable contains an element whose minimal polynomial
is inseparable.

## Implementation details

The proof is by contraposition: if every element is separable, then every finitely generated
intermediate field is finite, hence algebraic and separably generated by the empty
transcendence basis, so the extension is separable in the sense of Tag 030O.

## References

* Stacks Project, Algebra, Definition 10.42.1 (Tag 030O)
-/

@[expose] public section

universe u v

namespace FieldExtension

/-- A finite field extension that is not separable has an element whose minimal polynomial
is inseparable. -/
theorem exists_not_isSeparable_of_not_isSeparableExtension
    (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K]
    (hfinite : degree k K ≠ ⊤) (hnot : ¬ Algebra.IsSeparableExtension k K) :
    ∃ α : K, ¬ IsSeparable k α := by
  classical
  have : Module.Finite k K := by
    by_contra hf
    exact hfinite (by simp [degree, hf])
  by_contra h
  push Not at h
  apply hnot
  have : Algebra.IsSeparable k K := ⟨h⟩
  intro F _
  refine ⟨∅, ?_, ?_⟩
  · refine ⟨algebraicIndependent_empty_type_iff.mpr (algebraMap k F).injective, ?_⟩
    intro s hs _
    have : IsEmpty s := hs.isEmpty_of_isAlgebraic
    simpa only [Set.range_eq_empty] using (Set.isEmpty_coe_sort.mp this).symm
  · exact Algebra.isSeparable_tower_top_of_isSeparable k _ F

end FieldExtension
