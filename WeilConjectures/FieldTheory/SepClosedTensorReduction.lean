module

public import Mathlib.FieldTheory.IsSepClosed
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.Spectrum.Prime.Homeomorph
import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# Purely inseparable base change and reduction of a tensor product

Source: Stacks Project, Algebra, Lemma 00I7, first and second paragraphs
(blueprint: lem-weil-pbc-sepclosed-tensor-reduction).
-/

@[expose] public section

universe u v w
open scoped TensorProduct

private theorem quotient_spectrum_homeomorph
    (A : Type*) [CommRing A] (I : Ideal A) (hI : I ≤ nilradical A) :
    Nonempty (PrimeSpectrum A ≃ₜ PrimeSpectrum (A ⧸ I)) := by
  have h := PrimeSpectrum.isHomeomorph_comap (Ideal.Quotient.mk I)
    (fun x ↦ ⟨1, by omega, by simpa using Ideal.Quotient.mk_surjective x⟩)
    (by simpa using hI)
  exact ⟨(h.homeomorph _).symm⟩

private theorem reduced_baseChange_domain
    (k : Type u) [Field k] [IsSepClosed k]
    (K : Type v) [Field K] [Algebra k K] :
    IsDomain ((AlgebraicClosure k ⊗[k] K) ⧸
      nilradical (AlgebraicClosure k ⊗[k] K)) := by
  let Ω := AlgebraicClosure k
  have h := PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable k Ω K
  let e := (PrimeSpectrum.homeomorphOfRingEquiv
    (Algebra.TensorProduct.comm k Ω K).toRingEquiv).trans (h.homeomorph _)
  have : IrreducibleSpace (PrimeSpectrum (Ω ⊗[k] K)) :=
    e.irreducibleSpace_iff.mpr inferInstance
  have : (nilradical (Ω ⊗[k] K)).IsPrime :=
    PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical.mp inferInstance
  infer_instance

private theorem tensor_reduce_right_homeomorph
    (k A B : Type*) [Field k] [CommRing A] [CommRing B]
    [Algebra k A] [Algebra k B] :
    Nonempty (PrimeSpectrum (A ⊗[k] B) ≃ₜ
      PrimeSpectrum (A ⊗[k] (B ⧸ nilradical B))) := by
  let I := (nilradical B).map (Algebra.TensorProduct.includeRight (R := k) (A := A)).toRingHom
  have hI : I ≤ nilradical (A ⊗[k] B) := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact (mem_nilradical.mpr ((mem_nilradical.mp hx).map _))
  obtain ⟨e⟩ := quotient_spectrum_homeomorph (A ⊗[k] B) I hI
  exact ⟨e.trans (PrimeSpectrum.homeomorphOfRingEquiv
    (Algebra.TensorProduct.tensorQuotientEquiv (R := k) k B A
      (nilradical B)).symm.toRingEquiv)⟩

/-- Passing to the algebraic closure and reducing each factor gives domains without
changing the spectrum of the original tensor product.
Source: Stacks Project, Algebra, Lemma 00I7, first and second paragraphs
(blueprint: lem-weil-pbc-sepclosed-tensor-reduction).

Proof: The algebraic closure of a separably closed field is purely inseparable, since each
algebraic element has a suitable power separable over the base and that power lies in the
base. Purely inseparable base change induces a homeomorphism on spectra. Apply this to
both fields and to their tensor product. Each base-changed field therefore has a spectrum
with exactly one point. Its reduction is reduced and has a unique prime, which is zero,
so it is a domain. The kernel of the surjection from the tensor product of the base-changed
factors to the tensor product of their reductions is generated by nilpotent elements
from the factors. Every element of this kernel is a finite sum of nilpotents and hence
nilpotent. Quotienting by this kernel leaves the spectrum unchanged. Finally the
associativity and base-change isomorphisms identify the tensor product of the base-changed
factors with the base change of the original tensor product. Composing these
homeomorphisms gives the asserted homeomorphism. -/
theorem IsSepClosed.tensor_reduction_domains_homeomorph
    (k : Type u) [Field k] [IsSepClosed k]
    (K : Type v) [Field K] [Algebra k K]
    (L : Type w) [Field L] [Algebra k L] :
    let Ω := AlgebraicClosure k
    let R := (Ω ⊗[k] K) ⧸ nilradical (Ω ⊗[k] K)
    let S := (Ω ⊗[k] L) ⧸ nilradical (Ω ⊗[k] L)
    IsDomain R ∧ IsDomain S ∧
      Nonempty (PrimeSpectrum (K ⊗[k] L) ≃ₜ PrimeSpectrum (R ⊗[Ω] S)) := by
  let Ω := AlgebraicClosure k
  let A := Ω ⊗[k] K
  let B := Ω ⊗[k] L
  let R := A ⧸ nilradical A
  let S := B ⧸ nilradical B
  refine ⟨reduced_baseChange_domain k K, reduced_baseChange_domain k L, ?_⟩
  have h := PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable k Ω (K ⊗[k] L)
  let e₀ := (h.homeomorph _).symm.trans
    (PrimeSpectrum.homeomorphOfRingEquiv
      (Algebra.TensorProduct.comm k (K ⊗[k] L) Ω).toRingEquiv)
  let f : (A ⊗[Ω] B) ≃ₐ[Ω] Ω ⊗[k] (K ⊗[k] L) :=
    (Algebra.TensorProduct.cancelBaseChange k Ω Ω A L).trans
      (Algebra.TensorProduct.assoc k k Ω Ω K L)
  let e₁ := PrimeSpectrum.homeomorphOfRingEquiv f.symm.toRingEquiv
  obtain ⟨e₂⟩ := tensor_reduce_right_homeomorph Ω A B
  let e₃ := PrimeSpectrum.homeomorphOfRingEquiv
    (Algebra.TensorProduct.comm Ω A S).toRingEquiv
  obtain ⟨e₄⟩ := tensor_reduce_right_homeomorph Ω S A
  let e₅ := PrimeSpectrum.homeomorphOfRingEquiv
    (Algebra.TensorProduct.comm Ω S R).toRingEquiv
  exact ⟨e₀.trans (e₁.trans (e₂.trans (e₃.trans (e₄.trans e₅))))⟩
