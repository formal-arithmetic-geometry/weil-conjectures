module

public import Mathlib.Data.Set.Finite.Basic
public import Mathlib.GroupTheory.SemidirectProduct

/-!
# Characters of a split cyclic extension

Let `N` be a group equipped with an automorphism `α`, and let `W = N ⋊_α ℤ` be the associated
split cyclic extension, with multiplication `(u, n) * (v, m) = (u * α ^ n v, n + m)`. We realise
`W` as Mathlib's `SemidirectProduct`, namely `N ⋊[φ] Multiplicative ℤ` for a homomorphism
`φ : Multiplicative ℤ →* MulAut N`. Under this identification the degree map `deg` is
`SemidirectProduct.rightHom`, the subgroup `P` is `SemidirectProduct.rightHom.ker`, which by
`SemidirectProduct.range_inl_eq_ker_rightHom` is the range of `SemidirectProduct.inl`, and the
degree-one element `γ = (1, 1)` is `SemidirectProduct.inrOfAddOne`.

A character of `W` valued in a commutative group `A` splits as the product of an *unramified*
part `χ_z : w ↦ z ^ deg w`, where `z = χ γ`, and a *finite* part `χ_fin : w ↦ χ w * z ^ (-deg w)`,
whose image is exactly the image `χ (P)` of the degree-zero subgroup. In the application `A` is
the unit group `Eˣ` of a field and `χ` is a rank-one character, with finite geometric image.

## Main declarations

* `SemidirectProduct.inrOfAddOne`: the degree-one element `γ = (1, 1)` of `N ⋊[φ] Multiplicative ℤ`.
* `SemidirectProduct.degreeCharacter`: the character `χ_z : w ↦ z ^ deg w` attached to `z : A`.
* `SemidirectProduct.finitePart`: the finite part `χ_fin = χ / χ_z` of a character `χ`, where
  `z = χ γ`.
* `SemidirectProduct.eq_finitePart_mul_degreeCharacter`: the factorisation `χ = χ_fin * χ_z`.
* `SemidirectProduct.finitePart_inrOfAddOne`: the finite part is trivial on `γ`.
* `SemidirectProduct.range_finitePart`: the image of the finite part is the image of `χ` on the
  degree-zero subgroup.
* `SemidirectProduct.finite_range_finitePart`: consequently the finite part has finite image as
  soon as `χ` does on the degree-zero subgroup.

## Blueprint

`SemidirectProduct.inrOfAddOne`, `SemidirectProduct.degreeCharacter` and
`SemidirectProduct.finitePart` implement `sk-d-ab-rankone`;
`SemidirectProduct.eq_finitePart_mul_degreeCharacter`,
`SemidirectProduct.finitePart_inrOfAddOne` and `SemidirectProduct.range_finitePart` implement
`sk-p-rankone`.
-/

@[expose] public section

namespace SemidirectProduct

variable {N : Type*} [Group N] {A : Type*} [CommGroup A] {φ : Multiplicative ℤ →* MulAut N}

variable (φ) in
/-- The degree-one element `γ = (1, 1)` of the split cyclic extension `N ⋊[φ] Multiplicative ℤ`;
every element of the extension is uniquely of the form `u * γ ^ n` with `u` in the copy of `N`.
(blueprint: `sk-d-ab-rankone`) -/
abbrev inrOfAddOne : N ⋊[φ] Multiplicative ℤ := inr (Multiplicative.ofAdd 1)

variable (φ) in
/-- The character `χ_z` sending an element `w` of the split cyclic extension to `z ^ deg w`, where
the degree `deg w` is read off by `SemidirectProduct.rightHom`.
(blueprint: `sk-d-ab-rankone`) -/
def degreeCharacter (z : A) : (N ⋊[φ] Multiplicative ℤ) →* A :=
  (zpowersHom A z).comp rightHom

/-- The finite part `χ_fin` of a character `χ`, obtained by dividing `χ` by the character `χ_z`
attached to `z = χ γ`; explicitly `χ_fin w = χ w * z ^ (-deg w)`.
(blueprint: `sk-d-ab-rankone`) -/
def finitePart (χ : (N ⋊[φ] Multiplicative ℤ) →* A) : (N ⋊[φ] Multiplicative ℤ) →* A :=
  χ / degreeCharacter φ (χ (inrOfAddOne φ))

variable (χ : (N ⋊[φ] Multiplicative ℤ) →* A)

@[simp]
theorem degreeCharacter_apply (z : A) (w : N ⋊[φ] Multiplicative ℤ) :
    degreeCharacter φ z w = z ^ (rightHom w).toAdd :=
  rfl

theorem finitePart_apply (w : N ⋊[φ] Multiplicative ℤ) :
    finitePart χ w = χ w / χ (inrOfAddOne φ) ^ (rightHom w).toAdd :=
  rfl

/-- The finite part of a character agrees with the character on the degree-zero subgroup. -/
@[simp]
theorem finitePart_inl (u : N) : finitePart χ (inl u) = χ (inl u) := by
  simp [finitePart_apply]

/-- A character of a split cyclic extension factors as the product of its finite part and the
degree character attached to `z = χ γ`.
(blueprint: `sk-p-rankone`) -/
theorem eq_finitePart_mul_degreeCharacter :
    χ = finitePart χ * degreeCharacter φ (χ (inrOfAddOne φ)) :=
  (div_mul_cancel χ _).symm

/-- The finite part of a character is trivial on the degree-one element `γ`.
(blueprint: `sk-p-rankone`) -/
@[simp]
theorem finitePart_inrOfAddOne : finitePart χ (inrOfAddOne φ) = 1 := by
  simp [finitePart_apply]

/-- The finite part of a character is trivial on the copy `inr` of `ℤ`, generated by `γ`. -/
@[simp]
theorem finitePart_inr (g : Multiplicative ℤ) : finitePart χ (inr g) = 1 := by
  have : (finitePart χ).comp (inr : Multiplicative ℤ →* N ⋊[φ] Multiplicative ℤ) = 1 :=
    MonoidHom.ext_mint (finitePart_inrOfAddOne χ)
  exact DFunLike.congr_fun this g

/-- The image of the finite part of a character is exactly its image on the degree-zero subgroup.
(blueprint: `sk-p-rankone`) -/
theorem range_finitePart :
    Set.range (finitePart χ) = Set.range (χ.comp (inl : N →* _)) := by
  ext a
  constructor
  · rintro ⟨w, rfl⟩
    refine ⟨w.left, ?_⟩
    conv_rhs => rw [← inl_left_mul_inr_right w]
    rw [map_mul, finitePart_inl, finitePart_inr, mul_one, MonoidHom.comp_apply]
  · rintro ⟨u, rfl⟩
    exact ⟨inl u, finitePart_inl χ u⟩

/-- A character whose restriction to the degree-zero subgroup has finite image has a finite part
with finite image.
(blueprint: `sk-p-rankone`) -/
theorem finite_range_finitePart (hχ : (Set.range (χ.comp (inl : N →* _))).Finite) :
    (Set.range (finitePart χ)).Finite :=
  (range_finitePart χ).symm ▸ hχ

end SemidirectProduct
