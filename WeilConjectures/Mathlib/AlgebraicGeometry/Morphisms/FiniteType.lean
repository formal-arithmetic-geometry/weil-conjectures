module

public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType

/-!
# Ring generators over an affine chart of a morphism locally of finite type

`AlgebraicGeometry.exists_finset_mem_subring_closure_of_locallyOfFiniteType`: if
`π : X ⟶ S` is locally of finite type and `W ⊆ X`, `V ⊆ S` are affine opens with
`W ≤ π ⁻¹ᵁ V`, then `Γ(W, ⊤)` is generated *as a ring* by the image of `Γ(V, ⊤)` together
with a finite set of sections.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- **Ring generators over an affine chart.** If `π` is locally of finite type and `W`, `V`
are affine opens with `W ≤ π ⁻¹ᵁ V`, then `Γ(W, ⊤)` is the subring generated by the image
of `Γ(V, ⊤)` and finitely many further sections. This is the ring-theoretic
finite-generation of `π` on the chart, restated with `Subring.closure` in place of
`Algebra.adjoin`. -/
theorem exists_finset_mem_subring_closure_of_locallyOfFiniteType {X S : Scheme.{u}}
    (π : X ⟶ S) [LocallyOfFiniteType π] {W : X.Opens} {V : S.Opens} (hWV : W ≤ π ⁻¹ᵁ V)
    (hW : IsAffineOpen W) (hV : IsAffineOpen V) :
    ∃ s : Finset Γ(W.toScheme, ⊤), ∀ y : Γ(W.toScheme, ⊤),
      y ∈ Subring.closure (Set.range (π.resLE V W hWV).appTop ∪ ↑s) := by
  classical
  have : IsAffine W.toScheme := hW
  have : IsAffine V.toScheme := hV
  have hft : RingHom.FiniteType ((π.resLE V W hWV).appTop).hom :=
    HasRingHomProperty.appTop (P := @LocallyOfFiniteType) (π.resLE V W hWV) inferInstance
  algebraize [((π.resLE V W hWV).appTop).hom]
  have hFT : Algebra.FiniteType Γ(V.toScheme, ⊤) Γ(W.toScheme, ⊤) := hft
  obtain ⟨s, hs⟩ := hFT.out
  refine ⟨s, fun y ↦ ?_⟩
  have hy : y ∈ Algebra.adjoin Γ(V.toScheme, ⊤) (↑s : Set Γ(W.toScheme, ⊤)) := by
    rw [hs]
    exact Algebra.mem_top
  induction hy using Algebra.adjoin_induction with
  | mem z hz => exact Subring.subset_closure (Set.mem_union_right _ hz)
  | algebraMap c => exact Subring.subset_closure (Set.mem_union_left _ ⟨c, rfl⟩)
  | add _ _ _ _ h1 h2 => exact add_mem h1 h2
  | mul _ _ _ _ h1 h2 => exact mul_mem h1 h2

end AlgebraicGeometry
