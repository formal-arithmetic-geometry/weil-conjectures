module

public import Mathlib.AlgebraicGeometry.Morphisms.UniversallyClosed
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Basic

public import Mathlib.AlgebraicGeometry.Pullbacks

/-!
# Complements on closed immersions

Six unrelated groups of small results.

The first is about **immersions that are universally closed**. A preimmersion whose underlying
map is closed — for instance a proper one — is already a closed immersion. In the special case
of an open immersion, the range is moreover a clopen subset of the target: such a morphism is
what is classically called a *clopen immersion*, and it identifies the source with a
connected-component union of the target.

The second completes the API of `AlgebraicGeometry.IsClosedImmersion.lift`, the comparison
morphism into a closed subscheme whose ideal sheaf is contained in another. Mathlib supplies
its defining factorization (`lift_fac`) and an invertibility criterion (`isIso_lift`) but not
the two remaining clauses of the universal property: that the lift is itself a closed
immersion when both morphisms are, and that it is the *unique* morphism over the target.
Together with `Scheme.Hom.toImage_imageι` these give the universal property of the
scheme-theoretic image in the form stated in the Nagata blueprint
(`lemma:nagata-scheme-image-universal`), and its packaging as a minimality statement:
the scheme-theoretic image is the smallest closed subscheme of the target through which
the morphism factors.

The third is the **factorization of a point through a closed immersion**: a morphism from a
reduced scheme whose set-theoretic image lands in the range of a closed immersion factors
uniquely through it. The case that gets used is a morphism from the spectrum of a field.

The fourth is an **affine descent criterion**: a morphism into a fibre product of affine
schemes is a closed immersion as soon as the target ring is generated, as a ring, by the
images of the two structure maps.  It is stated ring-theoretically, in terms of a
`Subring.closure`, so that it can be applied without providing algebra instances.

The fifth computes the **kernel of a stalk map** of a closed immersion `i : Z ⟶ X`: at a
point `z` of `Z`, it is the ideal of the stalk `𝒪_{X,i(z)}` generated by the ideal sheaf of
`i` on any affine open neighbourhood of `i(z)`.

The sixth is the **open complement** `AlgebraicGeometry.Scheme.Hom.openComplement` of the
range of a closed immersion.

## Main results

- `AlgebraicGeometry.IsClosedImmersion.of_isOpenImmersion` — an open immersion with closed
  range is a closed immersion;
- `AlgebraicGeometry.IsClosedImmersion.of_universallyClosed` — a universally closed
  preimmersion, e.g. a proper immersion, is a closed immersion;
- `AlgebraicGeometry.Scheme.Hom.isClopen_range` — an open immersion that is universally
  closed has clopen range;
- `AlgebraicGeometry.isClosedImmersion_lift` — the lift of a closed immersion through a
  closed immersion is a closed immersion;
- `AlgebraicGeometry.IsClosedImmersion.eq_lift` — the lift is the unique morphism over the
  target;
- `AlgebraicGeometry.Scheme.Hom.toImage_lift` — a morphism factoring through a closed
  immersion `z` also factors through `z` after passing to its scheme-theoretic image, with
  `AlgebraicGeometry.Scheme.Hom.ker_le_ker_imageι_comp` supplying its hypothesis;
- `AlgebraicGeometry.Scheme.Hom.ker_le_ker_iff_existsUnique_fac` — a closed subscheme
  contains the scheme-theoretic image of `g` if and only if `g` factors through it, and
  then uniquely;
- `AlgebraicGeometry.IsClosedImmersion.existsUnique_fac_of_range_subset_range` — a morphism
  from a reduced scheme whose range is contained in the range of a closed immersion factors
  uniquely through it, with `AlgebraicGeometry.IsClosedImmersion.existsUnique_fac_of_field`
  the special case of a morphism from the spectrum of a field;
- `AlgebraicGeometry.Scheme.range_base_subset_of_closedPoint_mem` — a morphism from the
  spectrum of a field has its whole range inside any set containing the image of the closed
  point, the observation which turns the pointwise hypothesis of the previous statement into
  a hypothesis on ranges.

- `AlgebraicGeometry.isClosedImmersion_pullbackLift_spec` — a morphism
  `Spec W ⟶ Spec S ×_{Spec R} Spec T` is a closed immersion if `W` is generated as a ring
  by the images of `S` and `T`.
- `AlgebraicGeometry.Scheme.Hom.ker_stalkMap` — the kernel of the stalk map of a closed
  immersion is generated by the sections of its ideal sheaf on any affine open neighbourhood.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

variable {X Y : Scheme.{u}} (f : X ⟶ Y)

/-- An open immersion with closed range is a closed immersion. -/
lemma IsClosedImmersion.of_isOpenImmersion [IsOpenImmersion f] (hf : IsClosed (Set.range f)) :
    IsClosedImmersion f :=
  .of_isPreimmersion f hf

/-- A preimmersion that is universally closed is a closed immersion. In particular this applies
to a proper immersion, since `IsImmersion` extends `IsPreimmersion`. -/
@[stacks 01IQ]
lemma IsClosedImmersion.of_universallyClosed [IsPreimmersion f] [UniversallyClosed f] :
    IsClosedImmersion f :=
  .of_isPreimmersion f f.isClosedMap.isClosed_range

/-- An open immersion that is universally closed is a closed immersion. In particular this
applies to a proper open immersion. -/
lemma IsClosedImmersion.of_isOpenImmersion_of_universallyClosed
    [IsOpenImmersion f] [UniversallyClosed f] :
    IsClosedImmersion f :=
  .of_isOpenImmersion f f.isClosedMap.isClosed_range

/-- The range of an open immersion that is universally closed is clopen. -/
lemma Scheme.Hom.isClopen_range [IsOpenImmersion f] [UniversallyClosed f] :
    IsClopen (Set.range f) :=
  ⟨f.isClosedMap.isClosed_range, f.isOpenEmbedding.isOpen_range⟩

section Lift

variable {Z : Scheme.{u}}

/-- The lift of a closed immersion `g` through a closed immersion `f` is again a closed
immersion: it composes with `f` to give `g`, and `IsClosedImmersion.of_comp_isClosedImmersion`
applies. -/
instance isClosedImmersion_lift (f : X ⟶ Z) (g : Y ⟶ Z) [IsClosedImmersion f]
    [IsClosedImmersion g] (H : f.ker ≤ g.ker) :
    IsClosedImmersion (IsClosedImmersion.lift f g H) :=
  have : IsClosedImmersion (IsClosedImmersion.lift f g H ≫ f) := by
    rw [IsClosedImmersion.lift_fac]
    infer_instance
  .of_comp_isClosedImmersion _ f

/-- `IsClosedImmersion.lift f g H` is the **unique** morphism composing with `f` to give `g`,
since a closed immersion is a monomorphism. -/
lemma IsClosedImmersion.eq_lift (f : X ⟶ Z) (g : Y ⟶ Z) [IsClosedImmersion f]
    (H : f.ker ≤ g.ker) (c : Y ⟶ X) (hc : c ≫ f = g) :
    c = IsClosedImmersion.lift f g H := by
  rw [← cancel_mono f, hc, IsClosedImmersion.lift_fac]

/-- If `g` factors as `h ≫ z` through the closed immersion `z`, then so does its
scheme-theoretic image, compatibly: the comparison `IsClosedImmersion.lift z g.imageι`
composed with the factor `g.toImage` recovers `h`.

This is the third equality of the universal property of the scheme-theoretic image; the other
two are `Scheme.Hom.toImage_imageι` and `IsClosedImmersion.lift_fac`. The factorization is
taken as a propositional hypothesis rather than by forcing the target to be syntactically
`h ≫ z`, so that the lemma rewrites at an arbitrary `g`. -/
lemma Scheme.Hom.toImage_lift {g : X ⟶ Y} (h : X ⟶ Z) (z : Z ⟶ Y) [IsClosedImmersion z]
    (w : h ≫ z = g) (H : z.ker ≤ g.imageι.ker) :
    g.toImage ≫ IsClosedImmersion.lift z g.imageι H = h := by
  rw [← cancel_mono z, Category.assoc, IsClosedImmersion.lift_fac, Scheme.Hom.toImage_imageι, w]

/-- The hypothesis of `AlgebraicGeometry.Scheme.Hom.toImage_lift`: the ideal sheaf of a closed
immersion `z` is contained in that of the scheme-theoretic image of any morphism factoring
through `z`. -/
lemma Scheme.Hom.ker_le_ker_imageι_comp (h : X ⟶ Z) (z : Z ⟶ Y) :
    z.ker ≤ (h ≫ z).imageι.ker := by
  rw [Scheme.IdealSheafData.ker_subschemeι]
  exact Scheme.Hom.le_ker_comp h z

/-- The scheme-theoretic image is the smallest closed subscheme of `Y` through which `g`
factors: a closed subscheme `z : Z ⟶ Y` contains the scheme-theoretic image of `g` (i.e.
`z.ker ≤ g.ker`) if and only if `g` factors through `z`, and the factorization is then
unique because `z` is a monomorphism. -/
theorem Scheme.Hom.ker_le_ker_iff_existsUnique_fac (g : X ⟶ Y) (z : Z ⟶ Y)
    [IsClosedImmersion z] : z.ker ≤ g.ker ↔ ∃! h : X ⟶ Z, h ≫ z = g := by
  refine ⟨fun H ↦ ?_, fun ⟨h, w, _⟩ ↦ ?_⟩
  · have hz : z.ker ≤ g.imageι.ker := by rwa [Scheme.IdealSheafData.ker_subschemeι]
    have hfac : (g.toImage ≫ IsClosedImmersion.lift z g.imageι hz) ≫ z = g := by simp
    exact ⟨_, hfac, fun h' hh' ↦ by rw [← cancel_mono z, hh', hfac]⟩
  · rw [← w]
    exact Scheme.Hom.le_ker_comp h z

end Lift

section Point

variable {Z : Scheme.{u}}

/-- A morphism `s : X ⟶ Y` from a **reduced** scheme whose set-theoretic image is contained in
the range of a closed immersion `i : Z ⟶ Y` factors uniquely through `i`.

Reducedness of the source is needed: for `X = Y = Spec k[ε]` and `Z` the reduced point, the
identity of `X` has image the single point of `Z` but does not factor through `Z`. -/
theorem IsClosedImmersion.existsUnique_fac_of_range_subset_range [IsReduced X] (i : Z ⟶ Y)
    [IsClosedImmersion i] (s : X ⟶ Y) (hs : Set.range s.base ⊆ Set.range i.base) :
    ∃! t : X ⟶ Z, t ≫ i = s :=
  (Scheme.Hom.ker_le_ker_iff_existsUnique_fac s i).mp
    ((Scheme.IdealSheafData.le_ker_iff_range_subset_support i.ker s).mpr
      (hs.trans (Scheme.Hom.range_subset_ker_support i)))

/-- The spectrum of a field has a single point, so a morphism `s : Spec K ⟶ Y` has its whole
range inside any set containing the image of the closed point. -/
lemma Scheme.range_base_subset_of_closedPoint_mem {K : Type u} [Field K]
    (s : Spec (CommRingCat.of K) ⟶ Y) {S : Set Y}
    (hs : s.base (IsLocalRing.closedPoint K) ∈ S) : Set.range s.base ⊆ S := by
  rintro _ ⟨p, rfl⟩
  rwa [Subsingleton.elim p (IsLocalRing.closedPoint K)]

/-- A morphism from the spectrum of a field whose unique point lies in the range of a closed
immersion `i` factors uniquely through `i`.
(blueprint: `lemma:openclosed-point-factors`) -/
theorem IsClosedImmersion.existsUnique_fac_of_field {K : Type u} [Field K] (i : Z ⟶ Y)
    [IsClosedImmersion i] (s : Spec (CommRingCat.of K) ⟶ Y)
    (hs : s.base (IsLocalRing.closedPoint K) ∈ Set.range i.base) :
    ∃! t : Spec (CommRingCat.of K) ⟶ Z, t ≫ i = s :=
  IsClosedImmersion.existsUnique_fac_of_range_subset_range i s
    (Scheme.range_base_subset_of_closedPoint_mem s hs)

/-- For a point `x` with `{x}` locally closed, the morphism `Spec κ(x) ⟶ X` factors through a
closed immersion into the open `W = X ∖ (closure {x} ∖ {x})`, which contains `x` as a closed
point. -/
lemma exists_isClosedImmersion_comp_ι_eq_fromSpecResidueField {x : Y}
    (hx : IsLocallyClosed ({x} : Set Y)) :
    ∃ (W : Y.Opens) (g : Spec (Y.residueField x) ⟶ W), x ∈ W ∧ IsClosedImmersion g ∧
      g ≫ W.ι = Y.fromSpecResidueField x := by
  let W : Y.Opens := ⟨coborder {x}, hx.isOpen_coborder⟩
  have hxW : x ∈ W := subset_coborder rfl
  have hr : Set.range (Y.fromSpecResidueField x).base ⊆ Set.range W.ι.base := by
    rw [Scheme.range_fromSpecResidueField, Scheme.Opens.range_ι, Set.singleton_subset_iff]
    exact hxW
  let g := IsOpenImmersion.lift W.ι (Y.fromSpecResidueField x) hr
  have hg : g ≫ W.ι = Y.fromSpecResidueField x := IsOpenImmersion.lift_fac _ _ _
  refine ⟨W, g, hxW, ?_, hg⟩
  have : IsPreimmersion (g ≫ W.ι) := by rw [hg]; infer_instance
  have : IsPreimmersion g := .of_comp g W.ι
  refine .of_isPreimmersion g ?_
  have : Set.range g.base = W.ι.base ⁻¹' closure {x} := by
    refine Set.ext fun w ↦ ⟨?_, fun hw ↦ ?_⟩
    · rintro ⟨p, rfl⟩
      rw [Set.mem_preimage, ← Scheme.Hom.comp_apply, hg]
      exact subset_closure (Scheme.range_fromSpecResidueField x ▸ ⟨p, rfl⟩)
    · have hw' : W.ι.base w ∈ (W : Set Y) := by rw [← Scheme.Opens.range_ι]; exact ⟨w, rfl⟩
      have : W.ι.base w ∈ coborder {x} ∩ closure {x} := ⟨hw', hw⟩
      rw [coborder_inter_closure, Set.mem_singleton_iff] at this
      obtain ⟨p, hp⟩ : x ∈ Set.range (Y.fromSpecResidueField x).base := by
        rw [Scheme.range_fromSpecResidueField]; rfl
      refine ⟨p, W.ι.isOpenEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, hg, hp, this]
  rw [this]
  exact isClosed_closure.preimage W.ι.base.hom.continuous


end Point

section AffineDescent

open Limits

/-- **Affine descent of closed immersions along a pushout of rings**: if a ring `W`
receives maps `u : S →+* W` and `v : T →+* W` agreeing on `R` and is generated as a ring by
their images, then the induced morphism `Spec W ⟶ Spec S ×_{Spec R} Spec T` is a closed
immersion. -/
lemma isClosedImmersion_pullbackLift_spec {R S T W : Type u} [CommRing R] [CommRing S]
    [CommRing T] [CommRing W] (f : R →+* S) (g : R →+* T) (u : S →+* W) (v : T →+* W)
    (hcomm : u.comp f = v.comp g)
    (hgen : Subring.closure (Set.range u ∪ Set.range v) = ⊤) :
    IsClosedImmersion
      (pullback.lift (Spec.map (CommRingCat.ofHom u)) (Spec.map (CommRingCat.ofHom v))
        (by rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← CommRingCat.ofHom_comp, hcomm]) :
        Spec (.of W) ⟶
          pullback (Spec.map (CommRingCat.ofHom f)) (Spec.map (CommRingCat.ofHom g))) := by
  have hw : CommRingCat.ofHom f ≫ CommRingCat.ofHom u =
      CommRingCat.ofHom g ≫ CommRingCat.ofHom v := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm]
  set d : pushout (CommRingCat.ofHom f) (CommRingCat.ofHom g) ⟶ CommRingCat.of W :=
    pushout.desc (CommRingCat.ofHom u) (CommRingCat.ofHom v) hw with hd
  have hsurj : Function.Surjective d.hom := by
    rw [← RingHom.range_eq_top, eq_top_iff, ← hgen, Subring.closure_le]
    rintro z (⟨b, rfl⟩ | ⟨c, rfl⟩)
    · refine ⟨(pushout.inl (CommRingCat.ofHom f) (CommRingCat.ofHom g)).hom b, ?_⟩
      rw [hd, ← CommRingCat.comp_apply, pushout.inl_desc]
      rfl
    · refine ⟨(pushout.inr (CommRingCat.ofHom f) (CommRingCat.ofHom g)).hom c, ?_⟩
      rw [hd, ← CommRingCat.comp_apply, pushout.inr_desc]
      rfl
  have hsq := isPullback_SpecMap_pushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
  have heq : (pullback.lift (Spec.map (CommRingCat.ofHom u)) (Spec.map (CommRingCat.ofHom v))
      (by rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp, hcomm]) :
      Spec (.of W) ⟶
        pullback (Spec.map (CommRingCat.ofHom f)) (Spec.map (CommRingCat.ofHom g))) =
      Spec.map d ≫ hsq.isoPullback.hom := by
    refine pullback.hom_ext ?_ ?_
    · rw [pullback.lift_fst, Category.assoc, IsPullback.isoPullback_hom_fst, ← Spec.map_comp,
        hd, pushout.inl_desc]
    · rw [pullback.lift_snd, Category.assoc, IsPullback.isoPullback_hom_snd, ← Spec.map_comp,
        hd, pushout.inr_desc]
  rw [heq]
  have : IsClosedImmersion (Spec.map d) := IsClosedImmersion.spec_of_surjective d hsurj
  infer_instance

end AffineDescent

section StalkMap

variable {Z : Scheme.{u}}

/-- The kernel of the stalk map of a closed immersion `i : Z ⟶ X` at `z` is the extension to the
stalk `𝒪_{X,i(z)}` of the ideal of `i` on any affine open `U` containing `i(z)`: the stalk of
`Z` at `z` is the quotient of `𝒪_{X,i(z)}` by the stalk of the ideal sheaf. -/
lemma Scheme.Hom.ker_stalkMap (i : Z ⟶ X) [IsClosedImmersion i] (U : X.affineOpens) (z : Z)
    (hz : i z ∈ U.1) :
    RingHom.ker (i.stalkMap z).hom = (i.ker.ideal U).map (X.presheaf.germ U (i z) hz).hom := by
  let := X.presheaf.algebra_section_stalk ⟨i z, hz⟩
  have hX := U.2.isLocalization_stalk ⟨i z, hz⟩
  have hV : IsAffineOpen (i ⁻¹ᵁ U.1) := U.2.preimage i
  let := Z.presheaf.algebra_section_stalk (⟨z, hz⟩ : i ⁻¹ᵁ U.1)
  have hZ := hV.isLocalization_stalk ⟨z, hz⟩
  rw [Scheme.Hom.ker_apply]
  apply le_antisymm
  · intro s hs
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective
      (U.2.primeIdealOf ⟨i z, hz⟩).asIdeal.primeCompl s
    have hst := IsLocalization.mk'_spec (X.presheaf.stalk (i z)) a t
    have ha : Z.presheaf.germ (i ⁻¹ᵁ U.1) z hz (i.app U a) = 0 := by
      rw [← Scheme.Hom.germ_stalkMap_apply]
      change (i.stalkMap z).hom (algebraMap _ _ a) = 0
      rw [← hst, map_mul, RingHom.mem_ker.mp hs, zero_mul]
    obtain ⟨⟨g, hg⟩, hga⟩ := (IsLocalization.map_eq_zero_iff
      (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl _ _).mp ha
    obtain ⟨h, rfl⟩ := i.app_surjective U.1 U.2 g
    have hu : IsUnit (X.presheaf.germ U (i z) hz h) := by
      apply isUnit_of_map_unit (i.stalkMap z).hom
      rw [Scheme.Hom.germ_stalkMap_apply]
      exact IsLocalization.map_units (M := (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl)
        (Z.presheaf.stalk z) ⟨_, hg⟩
    have hha : h * a ∈ RingHom.ker (i.app U).hom := by
      simpa [RingHom.mem_ker] using hga
    have hmem := Ideal.mem_map_of_mem (X.presheaf.germ U (i z) hz).hom hha
    rw [map_mul, Ideal.unit_mul_mem_iff_mem _ hu] at hmem
    change IsLocalization.mk' _ a t ∈ _
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ hmem
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simp only [Ideal.mem_comap, RingHom.mem_ker, Scheme.Hom.germ_stalkMap_apply]
    rw [RingHom.mem_ker.mp ha, map_zero]

end StalkMap

section OpenComplement

variable {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The open complement of the range of a closed immersion `i : Z ⟶ X`. -/
def Scheme.Hom.openComplement : X.Opens :=
  ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩

@[simp]
lemma Scheme.Hom.coe_openComplement : (i.openComplement : Set X) = (Set.range i)ᶜ :=
  rfl

/-- A closed immersion and the inclusion of its open complement have complementary ranges. -/
lemma Scheme.Hom.range_eq_compl_range_openComplement_ι :
    Set.range i = (Set.range i.openComplement.ι)ᶜ := by
  rw [Scheme.Opens.range_ι, coe_openComplement, compl_compl]

end OpenComplement

end AlgebraicGeometry
