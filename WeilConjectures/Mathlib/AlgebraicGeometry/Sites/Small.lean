module

public import Mathlib.AlgebraicGeometry.PullbackCarrier
public import Mathlib.AlgebraicGeometry.Sites.Small
public import Mathlib.CategoryTheory.Sites.CoverPreserving
public import Mathlib.CategoryTheory.Sites.Equivalence
public import Mathlib.CategoryTheory.Sites.Over
public import WeilConjectures.Mathlib.CategoryTheory.Limits.MorphismProperty
public import WeilConjectures.Mathlib.CategoryTheory.MorphismProperty.Comma
public import WeilConjectures.Mathlib.CategoryTheory.MorphismProperty.OverAdjunction

/-!

# Base change and localization for the small sites

Base change along an arbitrary morphism is continuous for the small `Q`-topologies of
`P`-schemes, for `Q ≤ P`: it preserves covers because covers are jointly surjective
families of `Q`-morphisms and the base change square is cartesian, and it preserves
compatible families because it is representably flat, the small site being finitely
complete.

Moreover, the localization of the small site of `S` at an object `U` is the small site of
`U.left`: the equivalence of categories
`CategoryTheory.MorphismProperty.Over.overEquiv` matches the localized topology with the
small topology of `U.left`, both being generated by the jointly surjective families of
`Q`-morphisms. This is the small-site counterpart of mathlib's
`CategoryTheory.Over.iteratedSliceEquiv` together with the instance
`CategoryTheory.Over.iteratedSliceEquiv.inverse.IsDenseSubsite` of
`Mathlib.CategoryTheory.Sites.Over` for a localization of a localization. The composite
`P.Over ⊤ U.left ⥤ Over U ⥤ P.Over ⊤ S` is the localization functor
`MorphismProperty.Over.map ⊤ U.prop`, whose cocontinuity is proved separately, for the
same reason, as `CategoryTheory.GrothendieckTopology.isCocontinuous_overMap_of_le`.

## Main results

- `AlgebraicGeometry.Scheme.coverPreserving_overPullback`: base change along an arbitrary
  morphism preserves the covering sieves of the small `Q`-topologies.
- `AlgebraicGeometry.Scheme.isContinuous_overPullback`: base change along an arbitrary
  morphism is continuous for the small `Q`-topologies.
- `AlgebraicGeometry.Scheme.isCocontinuous_overEquivFunctor_of_le` and
  `AlgebraicGeometry.Scheme.isCocontinuous_overEquivInverse_of_le`: both functors of the
  equivalence `Over U ≌ P.Over ⊤ U.left` are cocontinuous.
- `AlgebraicGeometry.Scheme.overSheafEquiv`: sheaves on the small site of `S` localized at
  `U` are sheaves on the small site of `U.left`.
-/

@[expose] public section

universe v u u'

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

variable (P Q : MorphismProperty Scheme.{u})
  [P.IsMultiplicative] [P.IsStableUnderBaseChange] [P.HasOfPostcompProperty P]
  [Q.IsMultiplicative] [Q.IsStableUnderBaseChange]

/-- Base change along an *arbitrary* morphism `g : W ⟶ U` preserves the covering sieves of
the small `Q`-topologies of `P`-schemes, for `Q ≤ P`.

Both squares below are cartesian, so a point `x` of `V ×_U W` and a preimage `w` of its
image in `V` under a covering morphism `φ.left` are jointly a point of `V' ×_U W`:

```
  V' ×_U W ──(Over.pullback P ⊤ g).map φ──→ V ×_U W ──────→ W
      │                                        │            │
      │ pullback.fst V'.hom g                  │ fst V.hom g│ g
      ↓                                        ↓            ↓
      V' ───────────── φ.left ──────────────→ V ──V.hom──→ U
```
-/
lemma coverPreserving_overPullback (hQP : Q ≤ P) {W U : Scheme.{u}} (g : W ⟶ U) :
    CoverPreserving (U.smallGrothendieckTopology Q (Q := P))
      (W.smallGrothendieckTopology Q (Q := P)) (MorphismProperty.Over.pullback P ⊤ g) where
  cover_preserve {V S} hS := by
    rw [smallGrothendieckTopology_eq_toGrothendieck_smallPretopology U hQP] at hS
    rw [smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W hQP]
    replace hS := (mem_toGrothendieck_smallPretopology _ _).mp hS
    refine (mem_toGrothendieck_smallPretopology _ _).mpr fun x ↦ ?_
    obtain ⟨V', φ, w, hSφ, hφl, hφw⟩ := hS (pullback.fst V.hom g x)
    have h := MorphismProperty.Over.isPullback_map_left g φ
    obtain ⟨ξ, -, hξ⟩ := Scheme.exists_preimage_of_isPullback h w x hφw
    exact ⟨_, (MorphismProperty.Over.pullback P ⊤ g).map φ, ξ,
      ⟨V', φ, 𝟙 _, hSφ, (Category.id_comp _).symm⟩, Q.of_isPullback h hφl, hξ⟩

/-- Base change along an *arbitrary* morphism `g : W ⟶ U` is continuous for the small
`Q`-topologies of `P`-schemes, for `Q ≤ P`. -/
theorem isContinuous_overPullback (hQP : Q ≤ P) {W U : Scheme.{u}} (g : W ⟶ U) :
    (MorphismProperty.Over.pullback P ⊤ g).IsContinuous
      (U.smallGrothendieckTopology Q (Q := P)) (W.smallGrothendieckTopology Q (Q := P)) :=
  Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat _ _) (coverPreserving_overPullback P Q hQP g)

section Localization

variable {P Q} (hQP : Q ≤ P) {S : Scheme.{u}} (U : P.Over ⊤ S)

include hQP in
/-- The functor `Over U ⥤ P.Over ⊤ U.left` of
`CategoryTheory.MorphismProperty.Over.overEquiv` is cocontinuous for the localized small
`Q`-topology and the small `Q`-topology of `U.left`: a jointly surjective family of
`Q`-morphisms over `U.left` is one over `S`. -/
lemma isCocontinuous_overEquivFunctor_of_le :
    (MorphismProperty.Over.overEquiv U).functor.IsCocontinuous
      ((S.smallGrothendieckTopology Q (Q := P)).over U)
      (U.left.smallGrothendieckTopology Q (Q := P)) where
  cover_lift {t R} hR := by
    rw [smallGrothendieckTopology_eq_toGrothendieck_smallPretopology _ hQP] at hR
    rw [GrothendieckTopology.mem_over_iff,
      smallGrothendieckTopology_eq_toGrothendieck_smallPretopology _ hQP]
    replace hR := (mem_toGrothendieck_smallPretopology _ _).mp hR
    refine (mem_toGrothendieck_smallPretopology _ _).mpr fun x ↦ ?_
    obtain ⟨V, g, y, hg, hgQ, hy⟩ := hR x
    -- `g` is a morphism over `U.left`; read it as a morphism over `S`
    refine ⟨MorphismProperty.Over.mk ⊤ (V.hom ≫ U.hom) (P.comp_mem _ _ V.prop U.prop),
      MorphismProperty.Over.homMk g.left ?_, y, ?_, hgQ, hy⟩
    · rw [← MorphismProperty.Over.w t.hom, ← Category.assoc]
      congr 1
      exact MorphismProperty.Over.w g
    · rw [Sieve.overEquiv_iff]
      change R.arrows ((MorphismProperty.Over.overEquiv U).functor.map _)
      rw [MorphismProperty.Over.overEquiv_functor_map_homMk U g _ rfl]
      exact R.downward_closed hg _

include hQP in
/-- The functor `P.Over ⊤ U.left ⥤ Over U` of
`CategoryTheory.MorphismProperty.Over.overEquiv` is cocontinuous for the small
`Q`-topology of `U.left` and the localized small `Q`-topology: a jointly surjective family
of `Q`-morphisms over `S` is one over `U.left`. -/
lemma isCocontinuous_overEquivInverse_of_le :
    (MorphismProperty.Over.overEquiv U).inverse.IsCocontinuous
      (U.left.smallGrothendieckTopology Q (Q := P))
      ((S.smallGrothendieckTopology Q (Q := P)).over U) where
  cover_lift {V R} hR := by
    rw [GrothendieckTopology.mem_over_iff,
      smallGrothendieckTopology_eq_toGrothendieck_smallPretopology _ hQP] at hR
    rw [smallGrothendieckTopology_eq_toGrothendieck_smallPretopology _ hQP]
    replace hR := (mem_toGrothendieck_smallPretopology _ _).mp hR
    refine (mem_toGrothendieck_smallPretopology _ _).mpr fun x ↦ ?_
    obtain ⟨W, h, y, hh, hhQ, hy⟩ := hR x
    rw [Sieve.overEquiv_iff] at hh
    -- `h` is a morphism over `S`; read it as a morphism over `U.left`
    refine ⟨MorphismProperty.Over.mk ⊤ (h.left ≫ V.hom) (P.comp_mem _ _ (hQP _ hhQ) V.prop),
      MorphismProperty.Over.homMk h.left rfl, y, ?_, hhQ, hy⟩
    change R.arrows ((MorphismProperty.Over.overEquiv U).inverse.map _)
    rw [MorphismProperty.Over.overEquiv_inverse_map_homMk U h]
    exact R.downward_closed hh _

include hQP in
/-- The inverse of `CategoryTheory.MorphismProperty.Over.overEquiv` exhibits the small site
of `U.left` as a dense subsite of the localization of the small site of `S` at `U`. Both
functors being cocontinuous, this is the only instance needed to transport sheaves. -/
lemma isDenseSubsite_overEquivInverse_of_le :
    (MorphismProperty.Over.overEquiv U).inverse.IsDenseSubsite
      (U.left.smallGrothendieckTopology Q (Q := P))
      ((S.smallGrothendieckTopology Q (Q := P)).over U) :=
  have := isCocontinuous_overEquivFunctor_of_le hQP U
  have := isCocontinuous_overEquivInverse_of_le hQP U
  (MorphismProperty.Over.overEquiv U).isDenseSubsite_inverse_of_isCocontinuous _ _

variable (A : Type u') [Category.{v} A]
  [(MorphismProperty.Over.overEquiv U).inverse.IsDenseSubsite
    (U.left.smallGrothendieckTopology Q (Q := P))
    ((S.smallGrothendieckTopology Q (Q := P)).over U)]

/-- **Sheaves on the small site of `S` localized at `U` are sheaves on the small site of
`U.left`**, the sheaf corresponding to `G` being `V ↦ G(V ⟶ U)`. -/
def overSheafEquiv :
    Sheaf ((S.smallGrothendieckTopology Q (Q := P)).over U) A ≌
      Sheaf (U.left.smallGrothendieckTopology Q (Q := P)) A :=
  (MorphismProperty.Over.overEquiv U).sheafCongr _ _ A

end Localization

end AlgebraicGeometry.Scheme
