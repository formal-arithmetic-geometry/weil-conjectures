module

public import Mathlib.Algebra.Algebra.Subalgebra.Directed
public import Mathlib.AlgebraicGeometry.AffineTransitionLimit
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.FiniteType

/-!
# Noetherian approximation of quasi-compact quasi-separated schemes

A *Noetherian approximation* of a scheme `S` is a cofiltered system of Noetherian schemes
with affine transition morphisms, together with a limit cone over the system with point `S`
(`AlgebraicGeometry.Scheme.NoetherianApproximation`).

Absolute Noetherian approximation (Stacks Project Tag 01ZA) asserts that every
quasi-compact quasi-separated scheme admits a Noetherian approximation
(`AlgebraicGeometry.Scheme.nonempty_noetherianApproximation`, currently a stated
obligation, see below).

In this file we prove the affine case: for an affine scheme `S`, the spectra of the
finitely generated `ℤ`-subalgebras of `Γ(S, ⊤)` form a Noetherian approximation
(`AlgebraicGeometry.Scheme.NoetherianApproximation.ofIsAffine`). The key algebraic input
is that `Γ(S, ⊤)` is the filtered colimit of its finitely generated `ℤ`-subalgebras
(`AlgebraicGeometry.Scheme.NoetherianApproximation.isColimitStagesRingCocone`), and the
geometric translation is that `Spec`, being a right adjoint, preserves limits.

(Blueprint: `def:nagata-noetherian-inverse-system`, `prop:nagata-noetherian-inverse-system`.)
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

/-- A **Noetherian approximation** of a scheme `S`: a cofiltered system of Noetherian
schemes with affine transition morphisms, exhibiting `S` as the limit of the system.
By absolute Noetherian approximation (Stacks Project Tag 01ZA,
`AlgebraicGeometry.Scheme.nonempty_noetherianApproximation`), every quasi-compact
quasi-separated scheme admits one.
(Blueprint: `def:nagata-noetherian-inverse-system`.) -/
structure Scheme.NoetherianApproximation (S : Scheme.{u}) where
  /-- The index category of the inverse system. -/
  I : Type u
  /-- The category structure on the index type. -/
  [smallCategory : SmallCategory I]
  /-- The index category is cofiltered. -/
  [isCofiltered : IsCofiltered I]
  /-- The diagram of Noetherian stages. -/
  D : I ⥤ Scheme.{u}
  /-- Every stage is a Noetherian scheme. -/
  isNoetherian_obj (i : I) : IsNoetherian (D.obj i)
  /-- The transition morphisms of the system are affine. -/
  isAffineHom_map {i j : I} (f : i ⟶ j) : IsAffineHom (D.map f)
  /-- The projections from `S` to the stages. -/
  π : (Functor.const I).obj S ⟶ D
  /-- `S` is the limit of its Noetherian stages. -/
  isLimit : IsLimit (Cone.mk S π)

namespace Scheme.NoetherianApproximation

attribute [instance] smallCategory isCofiltered isNoetherian_obj isAffineHom_map

variable (S : Scheme.{u})

/-- The directed poset of finitely generated `ℤ`-subalgebras of the ring of global
sections of `S`. For affine `S`, the spectra of these subalgebras are the Noetherian
stages of the Noetherian approximation of `S`. -/
def FGSubalgebras : Type u := {A : Subalgebra ℤ Γ(S, ⊤) // A.FG}

instance : Preorder (FGSubalgebras S) :=
  inferInstanceAs (Preorder {A : Subalgebra ℤ Γ(S, ⊤) // A.FG})

instance : Nonempty (FGSubalgebras S) :=
  ⟨⟨⊥, Subalgebra.fg_bot⟩⟩

instance : IsDirected (FGSubalgebras S) (· ≤ ·) :=
  ⟨fun A B => ⟨⟨A.1 ⊔ B.1, A.2.sup B.2⟩, Subtype.coe_le_coe.mp le_sup_left,
    Subtype.coe_le_coe.mp le_sup_right⟩⟩

/-- The finitely generated `ℤ`-subalgebra of `Γ(S, ⊤)` generated by one element,
as a term of `FGSubalgebras S`. -/
def adjoinSingleton (x : Γ(S, ⊤)) : FGSubalgebras S :=
  ⟨Algebra.adjoin ℤ {x}, by simpa using Subalgebra.fg_adjoin_finset ({x} : Finset _)⟩

lemma self_mem_adjoinSingleton (x : Γ(S, ⊤)) : x ∈ (adjoinSingleton S x).1 :=
  Algebra.self_mem_adjoin_singleton ℤ x

lemma iSup_val_fgSubalgebras : ⨆ A : FGSubalgebras S, A.1 = ⊤ :=
  le_antisymm le_top fun x _ =>
    le_iSup (fun A : FGSubalgebras S => A.1) (adjoinSingleton S x)
      (self_mem_adjoinSingleton S x)

/-- The diagram of finitely generated `ℤ`-subalgebras of `Γ(S, ⊤)` in commutative
rings, with the inclusions as transition maps. -/
@[simps]
def stagesRingDiagram : FGSubalgebras S ⥤ CommRingCat.{u} where
  obj A := .of A.1
  map {A B} f := CommRingCat.ofHom (Subalgebra.inclusion (leOfHom f)).toRingHom
  map_id A := by ext x; rfl
  map_comp f g := by ext x; rfl

/-- The ring of global sections of `S` as a cocone over the diagram of its finitely
generated `ℤ`-subalgebras. -/
@[simps]
def stagesRingCocone : Cocone (stagesRingDiagram S) where
  pt := Γ(S, ⊤)
  ι :=
    { app := fun A => CommRingCat.ofHom A.1.val.toRingHom
      naturality := fun A B f => by ext x; rfl }

/-- Auxiliary for `isColimitStagesRingCocone`: the ring homomorphism out of `Γ(S, ⊤)`
induced by a cocone under the diagram of finitely generated `ℤ`-subalgebras, defined
via `Subalgebra.iSupLift`. -/
noncomputable def descHom (s : Cocone (stagesRingDiagram S)) : Γ(S, ⊤) →+* s.pt :=
  ((Subalgebra.iSupLift (fun A : FGSubalgebras S => A.1)
      (fun A B => ⟨⟨A.1 ⊔ B.1, A.2.sup B.2⟩, le_sup_left, le_sup_right⟩)
      (fun A => by exact (s.ι.app A).hom.toIntAlgHom)
      (fun A B h => AlgHom.ext fun x => by
        have := congrArg (fun φ : (stagesRingDiagram S).obj A ⟶ s.pt => φ.hom x)
          (s.w (homOfLE (show A ≤ B from h)))
        exact this.symm)
      ⊤ (iSup_val_fgSubalgebras S).ge).comp
    Subalgebra.topEquiv.symm.toAlgHom).toRingHom

lemma descHom_val (s : Cocone (stagesRingDiagram S)) (A : FGSubalgebras S) (x : A.1) :
    descHom S s (A.1.val x) = (s.ι.app A).hom x := by
  have h1 : Subalgebra.topEquiv.symm.toAlgHom (A.1.val x)
      = Subalgebra.inclusion (le_top : A.1 ≤ ⊤) x :=
    Subtype.ext rfl
  simp only [descHom, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.comp_apply, h1,
    Subalgebra.iSupLift_inclusion]
  rfl

/-- A commutative ring is the filtered colimit of its finitely generated
`ℤ`-subalgebras. -/
noncomputable def isColimitStagesRingCocone : IsColimit (stagesRingCocone S) where
  desc s := CommRingCat.ofHom (descHom S s)
  fac s A := by
    ext x
    exact descHom_val S s A x
  uniq s m hm := by
    ext x
    have hx : x ∈ (adjoinSingleton S x).1 := self_mem_adjoinSingleton S x
    have h1 := congrArg
      (fun φ : (stagesRingDiagram S).obj (adjoinSingleton S x) ⟶ s.pt => φ.hom ⟨x, hx⟩)
      (hm (adjoinSingleton S x))
    exact h1.trans (descHom_val S s (adjoinSingleton S x) ⟨x, hx⟩).symm

variable [IsAffine S]

/-- **Noetherian approximation of an affine scheme**: the spectra of the finitely
generated `ℤ`-subalgebras of `Γ(S, ⊤)` form a cofiltered system of Noetherian schemes
with affine transition maps whose limit is `S`. This is the affine case of Stacks
Project Tag 01ZA. -/
noncomputable def ofIsAffine : S.NoetherianApproximation where
  I := (FGSubalgebras S)ᵒᵖ
  D := (stagesRingDiagram S).op ⋙ Scheme.Spec
  isNoetherian_obj i := by
    have : Algebra.FiniteType ℤ i.unop.1 := (Subalgebra.fg_iff_finiteType _).mp i.unop.2
    have : IsNoetherianRing i.unop.1 := Algebra.FiniteType.isNoetherianRing ℤ _
    exact inferInstanceAs (IsNoetherian (Spec (CommRingCat.of i.unop.1)))
  isAffineHom_map f := inferInstanceAs (IsAffineHom (Spec.map _))
  π := (Functor.const _).map S.isoSpec.hom ≫ (Scheme.Spec.mapCone (stagesRingCocone S).op).π
  isLimit :=
    (isLimitOfPreserves Scheme.Spec (isColimitStagesRingCocone S).op).ofIsoLimit
      (Cone.ext S.isoSpec.symm fun A => by simp)

end Scheme.NoetherianApproximation

/-- **Absolute Noetherian approximation** (Stacks Project Tag 01ZA): every quasi-compact
quasi-separated scheme is the limit of a cofiltered system of Noetherian schemes with
affine transition morphisms.

The affine case is `AlgebraicGeometry.Scheme.NoetherianApproximation.ofIsAffine`. The
general case glues stage systems over a finite affine cover; its proof is a stated
obligation of the Nagata compactification chapter and is tracked as its own issue. Do
not derive instances from this theorem while it is a `sorry`.
(Blueprint: `prop:nagata-noetherian-inverse-system`.) -/
@[stacks 01ZA]
theorem Scheme.nonempty_noetherianApproximation (S : Scheme.{u})
    [CompactSpace S] [QuasiSeparatedSpace S] :
    Nonempty S.NoetherianApproximation := by
  sorry

end AlgebraicGeometry
