module

public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

/-!
# Effective Cartier centres

A morphism `z : Z ⟶ X` is an *effective Cartier centre* if it identifies `Z` with the closed
subscheme cut out by an invertible ideal on `X`. This is the scheme-theoretic form of "the
closed subscheme `Z` is an effective Cartier divisor": on an affine chart it says that the
defining ideal of `Z` is generated by a single non-zerodivisor.

Such a `z` is automatically a closed immersion, and conversely a closed immersion is an
effective Cartier centre exactly when its kernel is invertible
(`AlgebraicGeometry.isEffectiveCartierCenter_iff_isInvertible_ker`). So the isomorphism `α`
in the definition carries no information beyond the invertibility of `z.ker`; it is
determined by `z` through the universal property of closed immersions.

## Main definitions

- `AlgebraicGeometry.IsEffectiveCartierCenter`

## Main results

- `AlgebraicGeometry.IsEffectiveCartierCenter.isClosedImmersion`
- `AlgebraicGeometry.isEffectiveCartierCenter_iff_isInvertible_ker`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.isEffectiveCartierCenter`

## Blueprint

This file implements predicate (MLCI1) of `def:nagata-invertible-ideal-effective-cartier` and
the final assertion of `lemma:nagata-invertible-ideal-effective-cartier`, that under the
correspondence between closed immersions and quasi-coherent ideals, (MLCI1) is the
affine-local statement that the defining ideal of `Z` is generated by one non-zerodivisor.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}}

/-- A morphism `z : Z ⟶ X` is an **effective Cartier centre** if there is an invertible ideal
`J` on `X` and an isomorphism `α : Z ≅ Spec_X(𝒪_X/J)` over `X`.

`Spec_X(𝒪_X/J)` is `Scheme.IdealSheafData.subscheme`, and `IsEffectiveCartierCenter z` forces
`z` to be a closed immersion; see `IsEffectiveCartierCenter.isClosedImmersion`.
(blueprint: `def:nagata-invertible-ideal-effective-cartier`, (MLCI1)) -/
def IsEffectiveCartierCenter (z : Z ⟶ X) : Prop :=
  ∃ J : X.IdealSheafData, J.IsInvertible ∧ ∃ α : Z ≅ J.subscheme, α.hom ≫ J.subschemeι = z

/-- An effective Cartier centre is a closed immersion, being an isomorphism followed by the
inclusion of a closed subscheme. -/
lemma IsEffectiveCartierCenter.isClosedImmersion {z : Z ⟶ X} (hz : IsEffectiveCartierCenter z) :
    IsClosedImmersion z := by
  obtain ⟨J, -, α, rfl⟩ := hz
  infer_instance

/-- The closed subscheme cut out by an invertible ideal is an effective Cartier centre. This
is the direction used in practice: an invertibility statement about an ideal upgrades for
free to a statement about the closed immersion it defines.
(blueprint: part of `lemma:nagata-invertible-ideal-effective-cartier`) -/
lemma Scheme.IdealSheafData.IsInvertible.isEffectiveCartierCenter {J : X.IdealSheafData}
    (hJ : J.IsInvertible) : IsEffectiveCartierCenter J.subschemeι :=
  ⟨J, hJ, Iso.refl _, Category.id_comp _⟩

/-- **A closed immersion is an effective Cartier centre exactly when its kernel is
invertible.** Unfolding `Scheme.IdealSheafData.IsInvertible`, the right-hand side is the
affine-local assertion that the defining ideal of `Z` is generated by one non-zerodivisor, so
this is the promised description of (MLCI1) under the correspondence between closed
immersions and quasi-coherent ideals.

The forward direction holds because the kernel does not change under precomposition with an
isomorphism, and the kernel of `J.subschemeι` is `J`. The backward direction produces the
isomorphism from the universal property of closed immersions: `z` and `z.ker.subschemeι` are
two closed immersions with the same kernel, hence canonically isomorphic over `X`.
(blueprint: final assertion of `lemma:nagata-invertible-ideal-effective-cartier`) -/
lemma isEffectiveCartierCenter_iff_isInvertible_ker {z : Z ⟶ X} [IsClosedImmersion z] :
    IsEffectiveCartierCenter z ↔ z.ker.IsInvertible := by
  refine ⟨fun ⟨J, hJ, α, hα⟩ ↦ ?_, fun h ↦ ⟨z.ker, h, ?_, ?_⟩⟩
  · rwa [← hα, Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_subschemeι]
  · have := IsClosedImmersion.isIso_lift z.ker.subschemeι z
      (Scheme.IdealSheafData.ker_subschemeι z.ker)
    exact asIso (IsClosedImmersion.lift z.ker.subschemeι z
      (Scheme.IdealSheafData.ker_subschemeι z.ker).le)
  · exact IsClosedImmersion.lift_fac _ _ _

end AlgebraicGeometry
