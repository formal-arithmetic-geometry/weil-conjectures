module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import WeilConjectures.Mathlib.Algebra.Category.Ring.Constructions
public import WeilConjectures.Mathlib.Algebra.Ring.NonZeroDivisors
public import WeilConjectures.Mathlib.AlgebraicGeometry.AffineScheme
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme

/-!
# The inverse image ideal sheaf on an affine probe

For a morphism `Spec S ⟶ X` factoring through an affine open `U` as
`Spec.map φ ≫ fromSpec`, we compute the ideal of sections of the inverse image ideal
sheaf `I.comap _` on `⊤` as the extension of `I(U)` along the section map
(`AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_specMap_fromSpec`). The pullback
of the subscheme of `I` is computed explicitly: it is `Spec` of the quotient by the
extended ideal, via the pushout property of quotient rings
(`CommRingCat.isPushout_quotient`) and the affine chart of the subscheme
(`AlgebraicGeometry.isPullback_subschemeCover_f`).

We derive a criterion for an ideal sheaf to be generated by a single nonzerodivisor on
an affine neighbourhood of a point, through an affine open immersion probe
(`AlgebraicGeometry.exists_effectiveCartier_generator_of_comap`).
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-- **The inverse image ideal sheaf on an affine probe**: for an affine open
`U ⊆ X` and a morphism `Spec S ⟶ X` of the form `Spec.map φ ≫ fromSpec`, the ideal of
sections of `I.comap _` on `⊤` is the extension of `I(U)` along the section map.
(Blueprint: part of `thm:nagata-blowup-principalizes-center`, the affine description of
the inverse image ideal sheaf.) -/
theorem Scheme.IdealSheafData.ideal_comap_specMap_fromSpec (I : X.IdealSheafData)
    (U : X.affineOpens) {S : CommRingCat.{u}} (φ : Γ(X, U.1) ⟶ S)
    (h : (⊤ : (Spec S).Opens) ≤ (Spec.map φ ≫ U.2.fromSpec) ⁻¹ᵁ U.1) :
    (I.comap (Spec.map φ ≫ U.2.fromSpec)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      (I.ideal U).map ((Spec.map φ ≫ U.2.fromSpec).appLE U.1 ⊤ h).hom := by
  -- the explicit pullback of the subscheme along the probe
  have s1 := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_quotient φ (I.ideal U))
  have H := (s1.paste_horiz (isPullback_subschemeCover_f I U)).flip
  -- the first projection is the quotient `Spec` map, up to the pullback isomorphism
  have hfst : pullback.fst (Spec.map φ ≫ U.2.fromSpec) I.subschemeι =
      H.isoPullback.inv ≫ Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk ((I.ideal U).map φ.hom))) :=
    ((Iso.inv_comp_eq _).mpr H.isoPullback_hom_fst.symm).symm
  have hker : I.comap (Spec.map φ ≫ U.2.fromSpec) =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk ((I.ideal U).map φ.hom)))).ker := by
    change (pullback.fst (Spec.map φ ≫ U.2.fromSpec) I.subschemeι).ker = _
    rw [hfst, Scheme.Hom.ker_comp_of_isIso]
  refine (congrArg (fun J ↦ Scheme.IdealSheafData.ideal J ⟨⊤, isAffineOpen_top _⟩)
    hker).trans ?_
  refine (ideal_top_ker_specMap_quotient _).trans ?_
  -- identify the two descriptions of the extended ideal
  refine Eq.symm ?_
  refine (congrArg (fun t ↦ (I.ideal U).map (CommRingCat.Hom.hom t))
    (appLE_specMap_comp_fromSpec U φ h)).trans ?_
  refine (congrArg ((I.ideal U).map ·) (CommRingCat.hom_comp _ _)).trans ?_
  exact (Ideal.map_map _ _).symm

/-- Criterion for the effective-Cartier property at a point through an affine open
immersion probe: if `w : Spec R ⟶ Y` is an open immersion whose range contains `x` and
the pullback of `I'` to `Spec R` is generated by a single nonzerodivisor, then `I'` is
generated by a single nonzerodivisor on an affine neighbourhood of `x`. -/
lemma exists_effectiveCartier_generator_of_comap {Y : Scheme.{u}} (I' : Y.IdealSheafData)
    {R : CommRingCat.{u}} (w : Spec R ⟶ Y) [IsOpenImmersion w] {x : Y}
    (hx : x ∈ Set.range w) (c : Γ(Spec R, ⊤)) (hc : c ∈ nonZeroDivisors Γ(Spec R, ⊤))
    (hspan : (I'.comap w).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {c}) :
    ∃ V : Y.affineOpens, x ∈ V.1 ∧
      ∃ a ∈ nonZeroDivisors Γ(Y, V.1), I'.ideal V = Ideal.span {a} := by
  refine ⟨⟨w ''ᵁ ⊤, (isAffineOpen_top (Spec R)).image_of_isOpenImmersion w⟩, ?_, ?_⟩
  · obtain ⟨z, rfl⟩ := hx
    exact ⟨z, trivial, rfl⟩
  · have h1 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I' w
      ⟨⊤, isAffineOpen_top _⟩
    rw [hspan] at h1
    have hbij : Function.Bijective (w.appIso ⊤).inv.hom :=
      ConcreteCategory.bijective_of_isIso _
    refine ⟨(w.appIso ⊤).inv c, map_mem_nonZeroDivisors_of_bijective _ hbij hc, ?_⟩
    have h2 := Ideal.map_comap_of_surjective (w.appIso ⊤).inv.hom hbij.2
      (I'.ideal ⟨w ''ᵁ ⊤, (isAffineOpen_top (Spec R)).image_of_isOpenImmersion w⟩)
    rw [← h1] at h2
    rw [← h2, Ideal.map_span, Set.image_singleton]

end AlgebraicGeometry
