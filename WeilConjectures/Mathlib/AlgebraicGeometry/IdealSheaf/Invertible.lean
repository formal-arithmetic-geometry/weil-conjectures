module

public import Mathlib.AlgebraicGeometry.FunctionField
public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Affine
public import WeilConjectures.Mathlib.RingTheory.Ideal.RegularPrincipal

/-!
# Invertible ideal sheaves

A quasi-coherent ideal `J` on a scheme `X` is *invertible* if every point of `X` has an affine
open neighbourhood on which `J` is generated by a single non-zerodivisor. Equivalently, `J`
is locally principal and the corresponding closed subscheme is an effective Cartier divisor.

The predicate is stated pointwise, so that it is local by construction; the two ways of
producing it in practice are `IsInvertible.of_isAffine` on an affine scheme and
`IsInvertible.of_iSup_opensRange_eq_top`, which checks the condition after pulling back along
a family of open immersions covering `X`.

## Main definitions

- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyPrincipal`

## Main results

- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.of_isAffine`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.comap_of_flat`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.comap_of_isOpenImmersion`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.of_iSup_opensRange_eq_top`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.pow`
- `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyPrincipal.isInvertible`: on an integral
  scheme a nonzero locally principal ideal is invertible.

## Blueprint

This file implements `def:nagata-invertible-ideal-effective-cartier` (MLCI0) and the parts of
`lemma:nagata-invertible-ideal-effective-cartier` asserting locality and stability under
restriction to an open subscheme, under isomorphism, and under flat pullback.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- A quasi-coherent ideal is **invertible** if every point has an affine open neighbourhood
on which the ideal is generated by a single non-zerodivisor. Its vanishing locus is an
*effective Cartier divisor*.
(blueprint: `def:nagata-invertible-ideal-effective-cartier`, (MLCI0),
`def-sc-effective-cartier-divisor`) -/
def IsInvertible (J : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧ (J.ideal U).IsRegularPrincipal

lemma IsInvertible.of_isAffine [IsAffine X] {J : X.IdealSheafData}
    (h : (J.ideal ⟨⊤, isAffineOpen_top X⟩).IsRegularPrincipal) : J.IsInvertible :=
  fun _ ↦ ⟨⟨⊤, isAffineOpen_top X⟩, trivial, h⟩

/-- **Invertibility is stable under flat pullback.** If `f : X ⟶ Y` is flat and `J` is an
invertible ideal on `Y`, then the extended ideal `J · 𝒪_X` is invertible.

On an affine chart `V ⊆ f ⁻¹ᵁ U` the extended ideal is `(J.ideal U).map (f.appLE U V)` by
`ideal_comap_appLE`, that map is flat by `Scheme.Hom.flat_appLE`, and a flat ring map sends
non-zerodivisors to non-zerodivisors.
(blueprint: part of `lemma:nagata-invertible-ideal-effective-cartier`) -/
lemma IsInvertible.comap_of_flat {J : Y.IdealSheafData} (hJ : J.IsInvertible) (f : X ⟶ Y)
    [Flat f] : (J.comap f).IsInvertible := by
  intro x
  obtain ⟨U, hxU, hU⟩ := hJ (f x)
  obtain ⟨V, hVaff, hxV, hVU⟩ :=
    exists_isAffineOpen_mem_and_subset (U := f ⁻¹ᵁ U.1) (x := x) hxU
  refine ⟨⟨V, hVaff⟩, hxV, ?_⟩
  rw [ideal_comap_appLE J f U ⟨V, hVaff⟩ hVU]
  exact hU.map_of_flat (f.flat_appLE U.2 hVaff hVU)

/-- Invertibility is preserved by restriction along an open immersion; in particular by
restriction to an open subscheme and by isomorphism. This is the special case of
`IsInvertible.comap_of_flat` for an open immersion, which is flat.
(blueprint: part of `lemma:nagata-invertible-ideal-effective-cartier`) -/
lemma IsInvertible.comap_of_isOpenImmersion {J : Y.IdealSheafData} (hJ : J.IsInvertible)
    (f : X ⟶ Y) [IsOpenImmersion f] : (J.comap f).IsInvertible :=
  hJ.comap_of_flat f

/-- Powers of an invertible ideal are invertible: a power of a local single
nonzerodivisor generator generates the power. -/
lemma IsInvertible.pow {C : X.IdealSheafData} (hC : C.IsInvertible) (d : ℕ) :
    (C ^ d).IsInvertible := by
  intro x
  obtain ⟨U, hxU, a, ha, hgen⟩ := hC x
  refine ⟨U, hxU, a ^ d, pow_mem ha d, ?_⟩
  rw [ideal_pow, Pi.pow_apply, hgen, Ideal.span_singleton_pow]

/-- Invertibility on an affine chart: if a morphism `Spec R ⟶ X` is `Spec` of a ring map `ψ`
followed by the canonical morphism of an affine open `U`, and the extension of `J.ideal U`
along `ψ` is generated by a non-zerodivisor, then the pullback of `J` is invertible. -/
lemma IsInvertible.of_specMap_ofHom_fromSpec {J : X.IdealSheafData} (U : X.affineOpens)
    {R : Type u} [CommRing R] (ψ : Γ(X, U.1) →+* R)
    (h : ((J.ideal U).map ψ).IsRegularPrincipal) :
    (J.comap (Spec.map (CommRingCat.ofHom ψ) ≫ U.2.fromSpec)).IsInvertible := by
  refine IsInvertible.of_isAffine ?_
  rw [ideal_top_comap_specMap_ofHom_fromSpec]
  exact h.map_of_bijective (ConcreteCategory.bijective_of_isIso _)

/-- **Invertibility is local.** If `X` is covered by the ranges of a family of open immersions
along which the pullback of `J` is invertible, then `J` is invertible.
(blueprint: part of `lemma:nagata-invertible-ideal-effective-cartier`) -/
lemma IsInvertible.of_iSup_opensRange_eq_top {ι : Type*} {Z : ι → Scheme.{u}}
    {J : X.IdealSheafData} (g : ∀ i, Z i ⟶ X) [∀ i, IsOpenImmersion (g i)]
    (hg : ⨆ i, (g i).opensRange = ⊤) (h : ∀ i, (J.comap (g i)).IsInvertible) :
    J.IsInvertible := by
  intro x
  have hx : x ∈ ⨆ i, (g i).opensRange := by rw [hg]; trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨z, rfl⟩ := hi
  obtain ⟨V, hzV, hV⟩ := h i z
  refine ⟨⟨g i ''ᵁ V.1, V.2.image_of_isOpenImmersion (g i)⟩, ⟨z, hzV, rfl⟩, ?_⟩
  refine .of_comap_of_bijective
    (f := ((g i).appIso V).inv.hom) (ConcreteCategory.bijective_of_isIso _) ?_
  rwa [← ideal_comap_of_isOpenImmersion]

/-- A quasi-coherent ideal is **locally principal** if every point has an affine open
neighbourhood on which the ideal is generated by a single element; i.e. the corresponding
closed subscheme is locally cut out by one equation. -/
def IsLocallyPrincipal (J : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧ (J.ideal U).IsPrincipal

/-- An invertible ideal is locally principal. -/
lemma IsInvertible.isLocallyPrincipal {J : X.IdealSheafData} (hJ : J.IsInvertible) :
    J.IsLocallyPrincipal := by
  intro x
  obtain ⟨U, hx, s, -, hs⟩ := hJ x
  exact ⟨U, hx, ⟨s, hs⟩⟩

/-- **Locally principal ideals pull back to locally principal ideals**: on an affine chart the
pulled back ideal is the extension of the ideal, by `ideal_comap_appLE`. -/
lemma IsLocallyPrincipal.comap {J : Y.IdealSheafData} (hJ : J.IsLocallyPrincipal) (f : X ⟶ Y) :
    (J.comap f).IsLocallyPrincipal := by
  intro x
  obtain ⟨U, hxU, ⟨b, hb⟩⟩ := hJ (f x)
  obtain ⟨V, hVaff, hxV, hVU⟩ :=
    exists_isAffineOpen_mem_and_subset (U := f ⁻¹ᵁ U.1) (x := x) hxU
  refine ⟨⟨V, hVaff⟩, hxV, ⟨f.appLE U.1 V hVU b, ?_⟩⟩
  rw [ideal_comap_appLE J f U ⟨V, hVaff⟩ hVU, hb, Ideal.submodule_span_eq, Ideal.map_span,
    Set.image_singleton]

/-- **On an integral scheme a nonzero locally principal ideal is invertible.** A local generator
`b` of `J` on a nonempty affine open `U` is nonzero: otherwise `J` vanishes on `U`, hence on
every affine open (they all meet `U`, and restriction maps of an integral scheme are
injective), so `J = ⊥`. In the domain `Γ(X, U)`, the nonzero `b` is a non-zerodivisor. -/
lemma IsLocallyPrincipal.isInvertible [IsIntegral X] {J : X.IdealSheafData}
    (hJ : J.IsLocallyPrincipal) (h : J ≠ ⊥) : J.IsInvertible := by
  intro x
  obtain ⟨U, hxU, ⟨b, hb⟩⟩ := hJ x
  refine ⟨U, hxU, b, ?_, hb⟩
  have : Nonempty U.1 := ⟨⟨x, hxU⟩⟩
  refine mem_nonZeroDivisors_of_ne_zero fun hb0 ↦ h (IdealSheafData.ext (funext fun W ↦ ?_))
  rw [ideal_bot, Pi.bot_apply, eq_bot_iff]
  intro a ha
  rw [Ideal.mem_bot]
  rcases isEmpty_or_nonempty W.1 with hW | ⟨⟨y, hyW⟩⟩
  · have : Subsingleton Γ(X, W.1) :=
      CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty
        (by ext z; exact iff_false_intro fun hz ↦ hW.false ⟨z, hz⟩))
    exact Subsingleton.elim _ _
  -- `W` and `U` meet, since `X` is irreducible; pick a basic open `V` of `U` inside `W`.
  obtain ⟨z, hzW, hzU⟩ : ((W.1 : Set X) ∩ U.1).Nonempty :=
    nonempty_preirreducible_inter W.1.2 U.1.2 ⟨y, hyW⟩ ⟨x, hxU⟩
  obtain ⟨g, hgW, hzg⟩ := U.2.exists_basicOpen_le ⟨z, hzW⟩ hzU
  let V := X.affineBasicOpen g
  have hVW : V ≤ W := hgW
  have hVU : V ≤ U := X.basicOpen_le g
  have hV : J.ideal V = ⊥ := by
    rw [← J.map_ideal hVU, hb, hb0, Ideal.submodule_span_eq, Ideal.span_singleton_eq_bot.mpr rfl,
      Ideal.map_bot]
  have hzV : z ∈ V.1 := hzg
  have : X.presheaf.map (homOfLE hVW).op a = 0 := by
    rw [← Ideal.mem_bot, ← hV, ← J.map_ideal hVW]
    exact Ideal.mem_map_of_mem _ ha
  have hgerm := X.presheaf.germ_res_apply (homOfLE (show V.1 ≤ W.1 from hVW)) z hzV a
  refine germ_injective_of_isIntegral (X := X) z hzW ?_
  rw [← hgerm, map_zero]
  exact (congr(X.presheaf.germ V.1 z hzV $this)).trans (map_zero _)

end AlgebraicGeometry.Scheme.IdealSheafData
