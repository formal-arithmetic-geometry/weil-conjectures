module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic

/-!
# Complements on ideal sheaves of schemes

We record:

- `AlgebraicGeometry.Scheme.IdealSheafData.ideal_eq_top_of_disjoint_support`: on an
  affine open disjoint from the support of a quasi-coherent ideal, the ideal of
  sections is the unit ideal;
- `AlgebraicGeometry.Scheme.IdealSheafData.FiniteType`: finite-type ideal sheaves;
- `AlgebraicGeometry.Scheme.IdealSheafData.IsEffectiveCartier`: ideal sheaves locally
  generated by a single nonzerodivisor (blueprint: `def:nagata-effective-cartier-ideal`);
- `AlgebraicGeometry.ideal_top_ofIdealTop` / `AlgebraicGeometry.ideal_top_ker_specMap_quotient`:
  the ideals of sections on `⊤` of `ofIdealTop` and of the kernel ideal sheaf of `Spec`
  of a quotient map.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- On an affine open disjoint from the support, the ideal is the unit ideal.
(blueprint: `lemma:nagata-ideal-unit-off-support`) -/
lemma ideal_eq_top_of_disjoint_support {U : X.affineOpens}
    (hU : Disjoint (U.1 : Set X) (I.support : Set X)) : I.ideal U = ⊤ := by
  have hsub : X.zeroLocus (U := U.1) (I.ideal U) ∩ U.1 ⊆ (∅ : Set X) := fun x hx ↦
    (Set.disjoint_left.mp hU hx.2 (I.zeroLocus_inter_subset_supportSet U hx)).elim
  have h := (U.2.fromSpec_image_zeroLocus _).trans_subset hsub
  simp only [Set.subset_empty_iff, Set.image_eq_empty] at h
  exact PrimeSpectrum.zeroLocus_empty_iff_eq_top.mp h

/-- An ideal sheaf is of finite type if its ideal of sections on every affine open is
finitely generated. -/
def FiniteType (I : X.IdealSheafData) : Prop :=
  ∀ U : X.affineOpens, (I.ideal U).FG

/-- An ideal sheaf is an effective Cartier ideal if it is, locally on an affine cover,
generated by a single nonzerodivisor.
(Blueprint: `def:nagata-effective-cartier-ideal`.) -/
def IsEffectiveCartier (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧
    ∃ a ∈ nonZeroDivisors Γ(X, U.1), I.ideal U = Ideal.span {a}

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry

/-- The ideal of sections on `⊤` of `ofIdealTop`. -/
lemma ideal_top_ofIdealTop {Y : Scheme.{u}} [IsAffine Y] (K : Ideal Γ(Y, ⊤)) :
    (Scheme.IdealSheafData.ofIdealTop K).ideal ⟨⊤, isAffineOpen_top _⟩ = K := by
  have h1 : Y.presheaf.map ((homOfLE le_top).op :
      Opposite.op (⊤ : Y.Opens) ⟶ Opposite.op (((⟨⊤, isAffineOpen_top Y⟩ :
        Y.affineOpens) : Y.Opens))) = 𝟙 _ := Y.presheaf.map_id _
  rw [Scheme.IdealSheafData.ofIdealTop_ideal, h1, CommRingCat.hom_id, Ideal.map_id]

/-- The kernel ideal sheaf of `Spec` of a quotient map, on global sections. -/
lemma ideal_top_ker_specMap_quotient {S : CommRingCat.{u}} (L : Ideal S) :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk L))).ker.ideal
      ⟨⊤, isAffineOpen_top _⟩ = L.map (Scheme.ΓSpecIso S).inv.hom := by
  rw [Scheme.ker_of_isAffine, ideal_top_ofIdealTop]
  have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk L))).appTop =
      (Scheme.ΓSpecIso S).hom ≫ CommRingCat.ofHom (Ideal.Quotient.mk L) ≫
        (Scheme.ΓSpecIso _).inv := by
    rw [Scheme.ΓSpecIso_inv_naturality, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
  rw [happ]
  have hdec : (((Scheme.ΓSpecIso S).hom ≫ CommRingCat.ofHom (Ideal.Quotient.mk L) ≫
      (Scheme.ΓSpecIso _).inv)).hom =
      ((Scheme.ΓSpecIso (.of (S ⧸ L))).symm.commRingCatIsoToRingEquiv.toRingHom).comp
        ((Ideal.Quotient.mk L).comp (Scheme.ΓSpecIso S).hom.hom) := rfl
  rw [hdec, RingHom.ker_equiv_comp, ← RingHom.comap_ker, Ideal.mk_ker]
  exact (Ideal.map_symm (Scheme.ΓSpecIso S).commRingCatIsoToRingEquiv).symm

end AlgebraicGeometry
