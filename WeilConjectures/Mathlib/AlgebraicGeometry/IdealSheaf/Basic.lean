module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# Complements on quasi-coherent ideal sheaves

Complements to `Mathlib.AlgebraicGeometry.IdealSheaf.Basic`: the ideal of sections away from
the support, the support and the radical of the vanishing ideal sheaf of a closed subset, the
radicality of the kernel ideal sheaf of a morphism from a reduced scheme, the comparison of an
ideal sheaf on an affine scheme with its ideal of global sections, and the kernel ideal sheaf
of a morphism of affine schemes.

## Main results

- `AlgebraicGeometry.Scheme.IdealSheafData.ideal_eq_top_of_disjoint_support`: on an affine
  open disjoint from the support, the ideal of sections is the unit ideal;
- `AlgebraicGeometry.Scheme.IdealSheafData.le_ker_iff_range_subset_support`: an ideal sheaf is
  contained in the kernel of a morphism from a reduced scheme exactly when the range of the
  morphism lies in its support;
- `AlgebraicGeometry.Scheme.IdealSheafData.eq_zero_iff_of_isAffine`: on an affine scheme an
  ideal sheaf vanishes exactly when its ideal of global sections does;
- `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_sup`: the set-level form of
  `support_sup`;
- `AlgebraicGeometry.Scheme.IdealSheafData.support_vanishingIdeal` and
  `AlgebraicGeometry.Scheme.IdealSheafData.radical_vanishingIdeal`: the vanishing ideal sheaf
  of a closed subset `Z` has support `Z` and is radical;
- `AlgebraicGeometry.Scheme.IdealSheafData.radical_ker`: the kernel ideal sheaf of a morphism
  from a reduced scheme is radical;
- `AlgebraicGeometry.Scheme.Hom.ideal_top_ker_specMap`: the ideal of global sections of the
  kernel ideal sheaf of `Spec φ` is the ideal generated by the kernel of `φ`, with
  `AlgebraicGeometry.Scheme.Hom.pow_ker_specMap_eq_zero` and
  `AlgebraicGeometry.Scheme.Hom.mul_ker_specMap_eq_zero` as consequences.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- On an affine open disjoint from the support, the ideal is the unit ideal.
(blueprint: `lemma:nagata-ideal-unit-off-support`) -/
lemma ideal_eq_top_of_disjoint_support {U : X.affineOpens}
    (hU : Disjoint (U.1 : Set X) (I.support : Set X)) : I.ideal U = ⊤ := by
  have hsub : X.zeroLocus (U := U.1) (I.ideal U) ∩ U.1 ⊆ (∅ : Set X) := fun x hx ↦
    (Set.disjoint_left.mp hU hx.2 (I.zeroLocus_inter_subset_supportSet U hx)).elim
  have h := (U.2.fromSpec_image_zeroLocus _).trans_subset hsub
  simp only [Set.subset_empty_iff, Set.image_eq_empty] at h
  exact PrimeSpectrum.zeroLocus_empty_iff_eq_top.mp h

/-- An ideal sheaf is contained in the kernel of a morphism from a reduced scheme exactly
when the range of the morphism lies in its support. -/
lemma le_ker_iff_range_subset_support {W : Scheme.{u}} (g : W ⟶ X) [IsReduced W] :
    I ≤ g.ker ↔ Set.range g ⊆ (I.support : Set X) := by
  rw [← map_bot, le_map_iff_comap_le, le_bot_iff, ← support_eq_top_iff, support_comap]
  simp [TopologicalSpace.Closeds.ext_iff, Set.preimage_eq_univ_iff]

/-- The kernel ideal sheaf of a morphism from a reduced scheme is radical: its radical has the
same support, which already contains the range of the morphism. -/
lemma radical_ker {W : Scheme.{u}} (g : W ⟶ X) [IsReduced W] : g.ker.radical = g.ker :=
  le_antisymm ((le_ker_iff_range_subset_support _ g).mpr (by
    rw [support_radical]
    exact (le_ker_iff_range_subset_support _ g).mp le_rfl)) (le_radical _)

/-- On an affine scheme, an ideal sheaf vanishes exactly when its ideal of global sections is
the zero ideal. -/
lemma eq_zero_iff_of_isAffine [IsAffine X] :
    I = 0 ↔ I.ideal ⟨⊤, isAffineOpen_top X⟩ = ⊥ := by
  refine ⟨fun h ↦ ?_, fun h ↦ ext_of_isAffine ?_⟩ <;>
    rw [h, zero_eq_bot, ideal_bot, Pi.bot_apply]

/-- The support of a sum of ideal sheaves is the intersection of the supports: the
set-level form of `support_sup`. -/
lemma coe_support_sup (I₁ I₂ : X.IdealSheafData) :
    ((I₁ ⊔ I₂).support : Set X) = (I₁.support : Set X) ∩ (I₂.support : Set X) := by
  rw [support_sup, TopologicalSpace.Closeds.coe_inf]

-- TODO: upstream this by adding the `support` projection to the `@[simps! ideal coe_support]`
-- attribute on `IdealSheafData.vanishingIdeal` in `Mathlib/AlgebraicGeometry/IdealSheaf/Basic.lean`
-- and dropping the `coe_support` one, after which this lemma and the `attribute` below go away.
-- Mathlib's simps-generated `coe_support_vanishingIdeal` states the same thing after the
-- coercion to sets, so its left-hand side sits strictly inside the one below: keeping both in
-- the default simp set would leave the normal form of `↑(vanishingIdeal Z).support` up to simp's
-- internal ordering, which is why `coe_support_vanishingIdeal` is taken out of it here.
/-- The support of the vanishing ideal sheaf of a closed subset `Z` is `Z`. -/
@[simp]
lemma support_vanishingIdeal (Z : TopologicalSpace.Closeds X) :
    (vanishingIdeal Z).support = Z := rfl

attribute [-simp] coe_support_vanishingIdeal

/-- The vanishing ideal sheaf of a closed subset is radical: it is the vanishing ideal sheaf
of its own support. -/
@[simp]
lemma radical_vanishingIdeal (Z : TopologicalSpace.Closeds X) :
    (vanishingIdeal Z).radical = vanishingIdeal Z := by
  rw [← vanishingIdeal_support, support_vanishingIdeal]

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry.Scheme.Hom

/-- The kernel of `Spec φ` on global sections is the ideal generated by the kernel of `φ`
along the canonical isomorphism `R ≅ Γ(Spec R, ⊤)`:

```
      R ─────────── φ ──────────────▶ S
      │                               │
      │ (ΓSpecIso R).inv              │ (ΓSpecIso S).inv
      ▼                               ▼
Γ(Spec R, ⊤) ─(Spec φ).appTop─▶ Γ(Spec S, ⊤)
```
-/
lemma ker_appTop_specMap {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    RingHom.ker (Spec.map φ).appTop.hom = (RingHom.ker φ.hom).map (ΓSpecIso R).inv.hom := by
  have he : (Spec.map φ).appTop = (ΓSpecIso R).hom ≫ φ ≫ (ΓSpecIso S).inv := by
    rw [ΓSpecIso_inv_naturality, Iso.hom_inv_id_assoc]
  have hker : RingHom.ker (Spec.map φ).appTop.hom =
      (RingHom.ker φ.hom).comap (ΓSpecIso R).hom.hom := by
    rw [he, CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_assoc, ← RingHom.comap_ker]
    exact RingHom.ker_comp_of_injective _
      (ΓSpecIso S).symm.commRingCatIsoToRingEquiv.injective
  rw [hker]
  exact (Ideal.map_comap_of_equiv (ΓSpecIso R).symm.commRingCatIsoToRingEquiv).symm

/-- The ideal of global sections of the kernel ideal sheaf of `Spec φ` is the ideal generated
by the kernel of `φ`. -/
lemma ideal_top_ker_specMap {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    (Spec.map φ).ker.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ =
      (RingHom.ker φ.hom).map (ΓSpecIso R).inv.hom := by
  rw [ker_of_isAffine, IdealSheafData.ofIdealTop_ideal, ker_appTop_specMap]
  simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]

/-- If the kernel of a ring homomorphism `φ` has vanishing `n`-th power, so does the kernel
ideal sheaf of `Spec φ`. -/
lemma pow_ker_specMap_eq_zero {R S : CommRingCat.{u}} {n : ℕ} (φ : R ⟶ S)
    (hφ : RingHom.ker φ.hom ^ n = ⊥) : (Spec.map φ).ker ^ n = 0 := by
  rw [IdealSheafData.eq_zero_iff_of_isAffine, IdealSheafData.ideal_pow, Pi.pow_apply,
    ideal_top_ker_specMap, ← Ideal.map_pow, hφ, Ideal.map_bot]

/-- If the kernels of two ring homomorphisms out of `R` have vanishing product, so do the
kernel ideal sheaves of the induced morphisms of affine schemes. -/
lemma mul_ker_specMap_eq_zero {R S S' : CommRingCat.{u}} (φ : R ⟶ S) (ψ : R ⟶ S')
    (h : RingHom.ker φ.hom * RingHom.ker ψ.hom = ⊥) :
    (Spec.map φ).ker * (Spec.map ψ).ker = 0 := by
  rw [IdealSheafData.eq_zero_iff_of_isAffine, IdealSheafData.ideal_mul, Pi.mul_apply,
    ideal_top_ker_specMap, ideal_top_ker_specMap, ← Ideal.map_mul, h, Ideal.map_bot]

end AlgebraicGeometry.Scheme.Hom
