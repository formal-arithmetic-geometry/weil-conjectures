/-!
# Morphisms into the integral model of affine space

`AlgebraicGeometry.AffineSpace.toSpecMvPolyIntEquiv` identifies morphisms `Y ⟶ Spec ℤ[m]`
with families of global sections of `Y`. We record how it evaluates on a morphism that
factors through the spectrum of a ring:

- `AlgebraicGeometry.AffineSpace.toSpecMvPolyIntEquiv_comp_SpecMap`.

We also record how `AlgebraicGeometry.AffineSpace.homOfVector` interacts with the functoriality
of affine space in the base, in `AlgebraicGeometry.AffineSpace.homOfVector_comp_map`, and that
`AlgebraicGeometry.AffineSpace.map` is an open immersion whenever the map of bases is.

Finally, `AlgebraicGeometry.AffineSpace.isClosedImmersion_homOfVector` is the criterion for a
morphism into an affine space over an affine base to be a closed immersion.

## Main definitions

The part of the additive group structure of relative affine space that is used elsewhere:

- `AlgebraicGeometry.AffineSpace.zeroSection`: the zero section `S ⟶ 𝔸(n; S)`.
- `AlgebraicGeometry.AffineSpace.neg`: the reflection `x ↦ -x`.
- `AlgebraicGeometry.AffineSpace.add`: the addition `𝔸(n; S) ×_S 𝔸(n; S) ⟶ 𝔸(n; S)`.
- `AlgebraicGeometry.AffineSpace.smul`: the scaling `x ↦ c x` by a global function `c`.
- `AlgebraicGeometry.AffineSpace.translation`: the translation `x ↦ x + a`.
- `AlgebraicGeometry.AffineSpace.linearMap`: the linear map `x ↦ A x` given by a matrix `A`.
- `AlgebraicGeometry.AffineSpace.stdPairing`: the standard pairing on `𝔸(n; S) ×_S 𝔸(n; S)`.
- `AlgebraicGeometry.AffineSpace.reindexIso`: relabelling the coordinates along a bijection.
- `AlgebraicGeometry.AffineSpace.sumIso`: `𝔸(n ⊕ m; S) ≅ 𝔸(m; 𝔸(n; S))`.

-/

/-!
# Immersions of quasi-affine schemes into relative affine space

This file proves Stacks Tag 04II: a quasi-affine scheme `X` that is locally of finite type
over a scheme `S` admits an immersion into a relative affine space `𝔸(Fin n; S)` over `S`.

## Main results

- `AlgebraicGeometry.AffineSpace.homOfVector_map`: naturality of `homOfVector` in the base.
- `AlgebraicGeometry.AffineSpace.isImmersion_homOfVector`: if `Y` and `V` are affine and the
  chosen sections `w` contain a unit `w j` such that `Γ(Y, ⊤)` is generated by the image of
  `Γ(V, ⊤)`, the sections `w` and the inverse of `w j`, then `homOfVector g w : Y ⟶ 𝔸(n; V)`
  is an immersion (a closed immersion into the basic open of the `j`-th coordinate).
- `AlgebraicGeometry.exists_immersion_affineSpace_of_quasiAffine`: **Stacks 04II**. If `X` is
  quasi-affine and `π : X ⟶ S` is locally of finite type, there are `n : ℕ` and an immersion
  `i : X ⟶ 𝔸(ULift (Fin n); S)` with `i ≫ 𝔸(ULift (Fin n); S) ↘ S = π`.
- `AlgebraicGeometry.iteratedAffineLine` and `AlgebraicGeometry.iteratedAffineLineProj`: the
  `r`-fold relative affine line over `S` and its projection to `S`, the composition of the `r`
  affine-line projections.
- `AlgebraicGeometry.Scheme.Hom.toIteratedAffineLine`: the morphism to the iterated affine line
  with prescribed coordinates (blueprint `def-zl-localized-coordinates`).
- `AlgebraicGeometry.AffineSpace.range_zeroSection`: the image of the zero section is the common
  zero locus of the coordinates.
- `AlgebraicGeometry.AffineSpace.isAffine_fiber_of_isOpenImmersion`: the fibres of an open
  subscheme of the relative affine line `𝔸¹_Y` over the points of `Y` are affine.

## Blueprint

This implements `lemma:nagata-quasi-affine-immersion-affine-space-exists` of the Nagata
compactification blueprint. Following the Stacks project, the hypotheses are that the
*scheme* `X` is quasi-affine (`X.IsQuasiAffine`) and that `π` is locally of finite type;
no hypothesis on `S` is needed. This applies in particular to the case needed for the
Nagata compactification of an affine morphism, where `X` is affine
(`lemma:nagata-affine-finite-type-is-quasi-affine` is the Mathlib instance
`[IsAffine X] : X.IsQuasiAffine`).
-/

@[expose] public section

universe u

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineSpace

/-- The family of sections classifying a morphism `Y ⟶ Spec R ⟶ Spec ℤ[m]` is obtained by
evaluating the ring map `ℤ[m] ⟶ R` at the variables. -/
lemma toSpecMvPolyIntEquiv_comp_SpecMap {m : Type u} {Y : Scheme.{u}} {R : CommRingCat.{u}}
    (h : Y ⟶ Spec R) (ψ : CommRingCat.of (MvPolynomial m (ULift.{u} ℤ)) ⟶ R) (j : m) :
    toSpecMvPolyIntEquiv m (h ≫ Spec.map ψ) j =
      h.appTop ((Scheme.ΓSpecIso R).inv (ψ (MvPolynomial.X j))) := by
  rw [toSpecMvPolyIntEquiv_comp]
  congr 1
  rw [toSpecMvPolyIntEquiv_apply, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
    CommRingCat.comp_apply]

section Map

variable {m : Type u} {S T : Scheme.{u}}

/-- Changing the base of `AlgebraicGeometry.AffineSpace.homOfVector` along `f : S ⟶ T` amounts
to composing the structure morphism with `f`. -/
@[reassoc]
lemma homOfVector_comp_map {X : Scheme.{u}} (h : X ⟶ S) (f : S ⟶ T) (v : m → Γ(X, ⊤)) :
    homOfVector h v ≫ map m f = homOfVector (h ≫ f) v := by
  refine hom_ext ?_ fun j ↦ ?_
  · rw [Category.assoc, map_over, homOfVector_over_assoc, homOfVector_over]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, map_appTop_coord,
      homOfVector_appTop_coord, homOfVector_appTop_coord]

instance isOpenImmersion_map (f : S ⟶ T) [IsOpenImmersion f] : IsOpenImmersion (map m f) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (isPullback_map (n := m) f).flip ‹_›

end Map

/-- If the global sections of an affine scheme `X` are generated as a ring by the image of
`Γ(T, ⊤)` together with a family `v`, the morphism `X ⟶ 𝔸(m; T)` classifying `v` over
`h : X ⟶ T` is a closed immersion. -/
lemma isClosedImmersion_homOfVector {m : Type u} {X T : Scheme.{u}} [IsAffine X]
    [IsAffine T] (h : X ⟶ T) (v : m → Γ(X, ⊤))
    (hgen : Subring.closure (Set.range h.appTop ∪ Set.range v) = ⊤) :
    IsClosedImmersion (homOfVector h v) := by
  refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
  have hle : Subring.closure (Set.range ⇑h.appTop ∪ Set.range v) ≤
      RingHom.range (homOfVector h v).appTop.hom := by
    rw [Subring.closure_le]
    rintro y (⟨a, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨(𝔸(m; T) ↘ T).appTop a, ?_⟩
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, homOfVector_over]
    · exact ⟨coord T i, homOfVector_appTop_coord _ _ _⟩
  exact fun x ↦ hle ((Subring.eq_top_iff' _).mp hgen x)

end AlgebraicGeometry.AffineSpace

open CategoryTheory Limits TopologicalSpace

noncomputable section

namespace AlgebraicGeometry

/-- The affine line `𝔸¹_R` over a commutative ring `R`, the relative affine space on a
one-element index type over `Spec R`. -/
abbrev affineLine (R : Type u) [CommRing R] : Scheme.{u} :=
  𝔸(PUnit.{u + 1}; Spec (CommRingCat.of R))

namespace AffineSpace

variable {n : Type u} {S : Scheme.{u}}

@[reassoc]
lemma homOfVector_map {X T : Scheme.{u}} (f : X ⟶ S) (g : S ⟶ T) (v : n → Γ(X, ⊤)) :
    homOfVector f v ≫ map n g = homOfVector (f ≫ g) v := by
  apply hom_ext
  · rw [Category.assoc, map_over, homOfVector_over_assoc, homOfVector_over]
  · intro i
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, map_appTop_coord,
      homOfVector_appTop_coord, homOfVector_appTop_coord]

instance {S T : Scheme.{u}} (f : S ⟶ T) [IsOpenImmersion f] : IsOpenImmersion (map n f) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (isPullback_map (n := n) f).flip
    inferInstance

/-- Let `Y` be an affine scheme over an affine scheme `V` and let `w` be a family of global
sections of `Y` containing a unit `w j` such that `Γ(Y, ⊤)` is generated, as a ring, by the
image of `Γ(V, ⊤)` together with the sections `w` and the inverse of `w j`. Then the induced
morphism `Y ⟶ 𝔸(n; V)` is an immersion; indeed it is a closed immersion into the basic open
of the `j`-th coordinate. -/
theorem isImmersion_homOfVector {Y V : Scheme.{u}} [IsAffine Y] [IsAffine V]
    (g : Y ⟶ V) (w : n → Γ(Y, ⊤)) (j : n) (hu : IsUnit (w j))
    (hgen : Subring.closure
      (Set.range g.appTop ∪ Set.range w ∪ {(↑hu.unit⁻¹ : Γ(Y, ⊤))}) = ⊤) :
    IsImmersion (homOfVector g w) := by
  have hB : IsAffine (𝔸(n; V).basicOpen (coord V j)).toScheme :=
    (isAffineOpen_top 𝔸(n; V)).basicOpen (coord V j)
  -- the morphism factors through the basic open of the `j`-th coordinate
  have hpre : homOfVector g w ⁻¹ᵁ 𝔸(n; V).basicOpen (coord V j) = ⊤ := by
    rw [Scheme.preimage_basicOpen_top, homOfVector_appTop_coord, Y.basicOpen_of_isUnit hu]
  have hrange : Set.range (homOfVector g w).base ⊆
      Set.range (𝔸(n; V).basicOpen (coord V j)).ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro - ⟨y, rfl⟩
    have hy : y ∈ homOfVector g w ⁻¹ᵁ 𝔸(n; V).basicOpen (coord V j) := hpre.ge trivial
    exact hy
  rw [← IsOpenImmersion.lift_fac (𝔸(n; V).basicOpen (coord V j)).ι (homOfVector g w) hrange]
  suffices h : IsClosedImmersion
      (IsOpenImmersion.lift (𝔸(n; V).basicOpen (coord V j)).ι (homOfVector g w) hrange) by
    infer_instance
  generalize hℓ : IsOpenImmersion.lift (𝔸(n; V).basicOpen (coord V j)).ι
    (homOfVector g w) hrange = ℓ
  have hfac : ℓ ≫ (𝔸(n; V).basicOpen (coord V j)).ι = homOfVector g w := by
    rw [← hℓ]; exact IsOpenImmersion.lift_fac _ _ hrange
  apply IsClosedImmersion.of_surjective_of_isAffine
  -- surjectivity of `ℓ.appTop`: the generators of `Γ(Y, ⊤)` are all in the image
  have hcoord : ∀ s : n, ℓ.appTop ((𝔸(n; V).basicOpen (coord V j)).ι.appTop (coord V s)) = w s := by
    intro s
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, hfac, homOfVector_appTop_coord]
  have hg' : ℓ ≫ (𝔸(n; V).basicOpen (coord V j)).ι ≫ 𝔸(n; V) ↘ V = g := by
    rw [← Category.assoc, hfac, homOfVector_over]
  have hbase : ∀ c : Γ(V, ⊤),
      ℓ.appTop (((𝔸(n; V).basicOpen (coord V j)).ι ≫ 𝔸(n; V) ↘ V).appTop c) = g.appTop c := by
    intro c
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, ← Category.assoc, hfac,
      homOfVector_over]
  -- the restriction of the `j`-th coordinate to its basic open is a unit
  have hc : IsUnit ((𝔸(n; V).basicOpen (coord V j)).ι.appTop (coord V j)) := by
    refine Scheme.isUnit_of_le_basicOpen (le_of_eq ?_)
    rw [← Scheme.preimage_basicOpen_top, Scheme.Opens.ι_preimage_self]
  -- `ℓ.appTop` maps the inverse of the coordinate to the inverse of `w j`
  have hinv : ℓ.appTop (↑hc.unit⁻¹ : _) = (↑hu.unit⁻¹ : Γ(Y, ⊤)) := by
    have h1 : w j * ℓ.appTop (↑hc.unit⁻¹ : _) = 1 := by
      rw [← hcoord j, ← map_mul, IsUnit.mul_val_inv, map_one]
    calc ℓ.appTop (↑hc.unit⁻¹ : _)
        = ((↑hu.unit⁻¹ : Γ(Y, ⊤)) * w j) * ℓ.appTop (↑hc.unit⁻¹ : _) := by
          rw [IsUnit.val_inv_mul, one_mul]
      _ = (↑hu.unit⁻¹ : Γ(Y, ⊤)) * (w j * ℓ.appTop (↑hc.unit⁻¹ : _)) := mul_assoc _ _ _
      _ = (↑hu.unit⁻¹ : Γ(Y, ⊤)) := by rw [h1, mul_one]
  suffices hsub : Set.range g.appTop ∪ Set.range w ∪ {(↑hu.unit⁻¹ : Γ(Y, ⊤))} ⊆
      Set.range ℓ.appTop by
    intro y
    have hy : y ∈ Subring.closure (Set.range g.appTop ∪ Set.range w ∪
        {(↑hu.unit⁻¹ : Γ(Y, ⊤))}) := hgen.ge trivial
    induction hy using Subring.closure_induction with
    | mem z hz => exact hsub hz
    | zero => exact ⟨0, map_zero _⟩
    | one => exact ⟨1, map_one _⟩
    | add _ _ _ _ h1 h2 => obtain ⟨p, rfl⟩ := h1; obtain ⟨q, rfl⟩ := h2
                           exact ⟨p + q, map_add _ p q⟩
    | mul _ _ _ _ h1 h2 => obtain ⟨p, rfl⟩ := h1; obtain ⟨q, rfl⟩ := h2
                           exact ⟨p * q, map_mul _ p q⟩
    | neg _ _ h1 => obtain ⟨p, rfl⟩ := h1; exact ⟨-p, map_neg _ p⟩
  rintro x ((⟨c, rfl⟩ | ⟨s, rfl⟩) | rfl)
  · exact ⟨((𝔸(n; V).basicOpen (coord V j)).ι ≫ 𝔸(n; V) ↘ V).appTop c, hbase c⟩
  · exact ⟨(𝔸(n; V).basicOpen (coord V j)).ι.appTop (coord V s), hcoord s⟩
  · exact ⟨(↑hc.unit⁻¹ : _), hinv⟩

end AffineSpace

open AffineSpace

/-- Variant of `exists_immersion_affineSpace_of_quasiAffine` (Stacks 04II) producing an
immersion into an affine space with an unspecified finite index type. -/
theorem exists_immersion_affineSpace_of_quasiAffine' {X S : Scheme.{u}} (π : X ⟶ S)
    [X.IsQuasiAffine] [LocallyOfFiniteType π] :
    ∃ (σ : Type u) (_ : Finite σ) (i : X ⟶ 𝔸(σ; S)),
      i ≫ 𝔸(σ; S) ↘ S = π ∧ IsImmersion i := by
  classical
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated X.toSpecΓ
  -- Step 1: at every point, choose an affine basic open mapping into an affine open of `S`
  have hchart : ∀ x : X, ∃ r : Γ(X, ⊤), IsAffineOpen (X.basicOpen r) ∧ x ∈ X.basicOpen r ∧
      ∃ V : S.Opens, IsAffineOpen V ∧ X.basicOpen r ≤ π ⁻¹ᵁ V := by
    intro x
    obtain ⟨V, hV, hπxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π x) trivial
    obtain ⟨-, ⟨-, ⟨r, hraff, rfl⟩, rfl⟩, hxr, hrV⟩ :=
      (Scheme.IsQuasiAffine.isBasis_basicOpen X).exists_subset_of_mem_open
        (show x ∈ (π ⁻¹ᵁ V : Set X) from hπxV) (π ⁻¹ᵁ V).2
    exact ⟨r, hraff, hxr, V, hV, fun y hy ↦ hrV hy⟩
  choose r hraff hxr V hVaff hrV using hchart
  -- Step 2: extract a finite subcover by quasi-compactness
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ (X.basicOpen (r x) : Set X)) (fun x ↦ (X.basicOpen (r x)).2)
    (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hxr x⟩)
  -- Step 3: clear denominators, using the qcqs lemma
  have hnum : ∀ (x : X) (g : Γ(X.basicOpen (r x), ⊤)), ∃ (b : Γ(X, ⊤)) (m : ℕ),
      g * (X.basicOpen (r x)).ι.appTop (r x) ^ m = (X.basicOpen (r x)).ι.appTop b := by
    intro x g
    have := Γ_restrict_isLocalization_of_qcqs X (r x)
    obtain ⟨⟨b, q⟩, hq⟩ := IsLocalization.surj (M := Submonoid.powers (r x)) g
    obtain ⟨m, hm⟩ := q.2
    refine ⟨b, m, ?_⟩
    have halg : ⇑(algebraMap Γ(X, ⊤) Γ(X.basicOpen (r x), ⊤)) =
        ⇑((X.basicOpen (r x)).ι.appTop) := rfl
    rw [halg] at hq
    rw [← hm] at hq
    rw [map_pow] at hq
    exact hq
  choose b m hbm using hnum
  -- Step 4: finite-type generators over each affine chart
  have hgens : ∀ x : X, ∃ s : Finset Γ(X.basicOpen (r x), ⊤),
      ∀ y : Γ(X.basicOpen (r x), ⊤), y ∈ Subring.closure
        (Set.range (π.resLE (V x) (X.basicOpen (r x)) (hrV x)).appTop ∪ ↑s) := by
    intro x
    have : IsAffine (X.basicOpen (r x)).toScheme := hraff x
    have : IsAffine (V x).toScheme := hVaff x
    have hft : RingHom.FiniteType ((π.resLE (V x) (X.basicOpen (r x)) (hrV x)).appTop).hom :=
      HasRingHomProperty.appTop (P := @LocallyOfFiniteType)
        (π.resLE (V x) (X.basicOpen (r x)) (hrV x)) inferInstance
    let := ((π.resLE (V x) (X.basicOpen (r x)) (hrV x)).appTop).hom.toAlgebra
    have hFT : Algebra.FiniteType Γ(V x, ⊤) Γ(X.basicOpen (r x), ⊤) := hft
    obtain ⟨s, hs⟩ := hFT.out
    refine ⟨s, fun y ↦ ?_⟩
    have hy : y ∈ Algebra.adjoin Γ(V x, ⊤) (↑s : Set Γ(X.basicOpen (r x), ⊤)) := by
      rw [hs]; exact Algebra.mem_top
    induction hy using Algebra.adjoin_induction with
    | mem z hz => exact Subring.subset_closure (Set.mem_union_right _ hz)
    | algebraMap c => exact Subring.subset_closure (Set.mem_union_left _ ⟨c, rfl⟩)
    | add _ _ _ _ h1 h2 => exact add_mem h1 h2
    | mul _ _ _ _ h1 h2 => exact mul_mem h1 h2
  choose s hs using hgens
  -- Step 5: assemble the global tuple of sections
  let σ : Type u := {x : X // x ∈ t} ⊕
    (Σ jj : {x : X // x ∈ t}, {g : Γ(X.basicOpen (r jj.1), ⊤) // g ∈ s jj.1})
  let v : σ → Γ(X, ⊤) := Sum.elim (fun jj ↦ r jj.1) (fun p ↦ b p.1.1 p.2.1)
  refine ⟨σ, inferInstance, homOfVector π v, homOfVector_over π v, ?_⟩
  -- Step 6: the morphism is an immersion, checked over each chart
  apply IsZariskiLocalAtTarget.of_forall_source_exists_preimage
  intro x
  have hx := ht (Set.mem_univ x)
  simp only [Set.mem_iUnion, exists_prop] at hx
  obtain ⟨j, hjt, hxj⟩ := hx
  have hjcoord : v (Sum.inl ⟨j, hjt⟩) = r j := rfl
  -- the preimage of the distinguished affine open of `𝔸(σ; S)` is the chart
  have hUeq : homOfVector π v ⁻¹ᵁ
      ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩))) =
      X.basicOpen (r j) := by
    have h2 : homOfVector π v ⁻¹ᵁ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩)) =
        X.basicOpen (r j) := by
      rw [Scheme.preimage_basicOpen_top, homOfVector_appTop_coord, hjcoord]
    have h1 : homOfVector π v ⁻¹ᵁ ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j) = π ⁻¹ᵁ V j := by
      change (homOfVector π v ≫ 𝔸(σ; S) ↘ S) ⁻¹ᵁ V j = π ⁻¹ᵁ V j
      rw [homOfVector_over]
    have hinf : homOfVector π v ⁻¹ᵁ
        ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩))) =
        homOfVector π v ⁻¹ᵁ ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j) ⊓
          homOfVector π v ⁻¹ᵁ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩)) := rfl
    rw [hinf, h1, h2]
    exact inf_eq_right.mpr (hrV j)
  refine ⟨(𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩)), ?_, ?_⟩
  · have : x ∈ homOfVector π v ⁻¹ᵁ
        ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩))) := by
      rw [hUeq]; exact hxj
    exact this
  · rw [hUeq, comp_homOfVector, ← Scheme.Hom.resLE_comp_ι π (hrV j), ← homOfVector_map]
    have : IsAffine (X.basicOpen (r j)).toScheme := hraff j
    have : IsAffine (V j).toScheme := hVaff j
    -- the restriction of `r j` to its own basic open is a unit
    have hu : IsUnit (((X.basicOpen (r j)).ι.appTop ∘ v) (Sum.inl ⟨j, hjt⟩)) := by
      change IsUnit ((X.basicOpen (r j)).ι.appTop (r j))
      refine Scheme.isUnit_of_le_basicOpen (le_of_eq ?_)
      rw [← Scheme.preimage_basicOpen_top, Scheme.Opens.ι_preimage_self]
    -- the generation hypothesis over the chart
    have hgen : Subring.closure
        (Set.range (π.resLE (V j) (X.basicOpen (r j)) (hrV j)).appTop ∪
          Set.range ((X.basicOpen (r j)).ι.appTop ∘ v) ∪
          {(↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))}) = ⊤ := by
      refine le_antisymm le_top fun y _ ↦ ?_
      refine Subring.closure_le.mpr ?_ (hs j y)
      rintro z (hz | hz)
      · exact Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ hz))
      · -- a finite-type generator `z` equals `b j z` divided by a power of `r j`
        have hres : (X.basicOpen (r j)).ι.appTop (b j z) ∈ Subring.closure
            (Set.range (π.resLE (V j) (X.basicOpen (r j)) (hrV j)).appTop ∪
              Set.range ((X.basicOpen (r j)).ι.appTop ∘ v) ∪
              {(↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))}) :=
          Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _
            ⟨Sum.inr ⟨⟨j, hjt⟩, ⟨z, hz⟩⟩, rfl⟩))
        have hinv : (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ∈ Subring.closure
            (Set.range (π.resLE (V j) (X.basicOpen (r j)) (hrV j)).appTop ∪
              Set.range ((X.basicOpen (r j)).ι.appTop ∘ v) ∪
              {(↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))}) :=
          Subring.subset_closure (Set.mem_union_right _ rfl)
        have hzeq : z = (X.basicOpen (r j)).ι.appTop (b j z) *
            (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ^ m j z := by
          have h1 : (X.basicOpen (r j)).ι.appTop (r j) *
              (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) = 1 := hu.mul_val_inv
          calc z = z * ((X.basicOpen (r j)).ι.appTop (r j) *
                (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))) ^ m j z := by
                rw [h1, one_pow, mul_one]
            _ = z * (X.basicOpen (r j)).ι.appTop (r j) ^ m j z *
                (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ^ m j z := by ring
            _ = (X.basicOpen (r j)).ι.appTop (b j z) *
                (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ^ m j z := by rw [hbm j z]
        rw [hzeq]
        exact mul_mem hres (pow_mem hinv _)
    have h1 : IsImmersion (homOfVector (π.resLE (V j) (X.basicOpen (r j)) (hrV j))
        ((X.basicOpen (r j)).ι.appTop ∘ v)) :=
      isImmersion_homOfVector _ _ (Sum.inl ⟨j, hjt⟩) hu hgen
    infer_instance

/-- **Stacks Tag 04II**: a quasi-affine scheme that is locally of finite type over `S` admits
an immersion into a relative affine space over `S`. This is
`lemma:nagata-quasi-affine-immersion-affine-space-exists` of the Nagata compactification
blueprint. -/
@[stacks 04II]
theorem exists_immersion_affineSpace_of_quasiAffine {X S : Scheme.{u}} (π : X ⟶ S)
    [X.IsQuasiAffine] [LocallyOfFiniteType π] :
    ∃ (n : ℕ) (i : X ⟶ 𝔸(ULift.{u} (Fin n); S)),
      i ≫ 𝔸(ULift.{u} (Fin n); S) ↘ S = π ∧ IsImmersion i := by
  obtain ⟨σ, hfin, i, hover, himm⟩ := exists_immersion_affineSpace_of_quasiAffine' π
  obtain ⟨k, ⟨eqv⟩⟩ := Finite.exists_equiv_fin σ
  let e : ULift.{u} (Fin k) ≃ σ := Equiv.ulift.trans eqv.symm
  have h1 : reindex (⇑e) S ≫ reindex (⇑e.symm) S = 𝟙 𝔸(σ; S) := by
    apply hom_ext
    · simp
    · intro s
      simp [reindex_appTop_coord]
  have h2 : reindex (⇑e.symm) S ≫ reindex (⇑e) S = 𝟙 𝔸(ULift.{u} (Fin k); S) := by
    apply hom_ext
    · simp
    · intro s
      simp [reindex_appTop_coord]
  have : IsIso (reindex (⇑e) S) := ⟨reindex (⇑e.symm) S, h1, h2⟩
  refine ⟨k, i ≫ reindex (⇑e) S, ?_, ?_⟩
  · rw [Category.assoc, reindex_over, hover]
  · have := himm
    infer_instance

/-- The `j`-th coordinate of a morphism to relative affine space precomposed with `m` is the
pullback along `m` of the `j`-th defining section. -/
lemma AffineSpace.comp_homOfVector_appTop_coord {n : Type u} {S T Y : Scheme.{u}} (m : T ⟶ Y)
    (h : Y ⟶ S) (v : n → Γ(Y, ⊤)) (j : n) :
    (m ≫ AffineSpace.homOfVector h v).appTop (AffineSpace.coord S j) = m.appTop (v j) := by
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, AffineSpace.homOfVector_appTop_coord]

/-- Two morphisms from `Spec T` to a relative affine space, given by ring maps out of `R` and
`S` together with defining vectors of sections of `R` and `S`, agree as soon as the underlying
morphisms to the base agree and the defining sections have the same image in `T`. -/
lemma AffineSpace.specMap_comp_homOfVector_eq {X : Scheme.{u}} {σ : Type u}
    {R S T : CommRingCat.{u}} (φ : R ⟶ T) (ψ : S ⟶ T) (pR : Spec R ⟶ X) (pS : Spec S ⟶ X)
    (hp : Spec.map φ ≫ pR = Spec.map ψ ≫ pS) (vR : σ → R) (vS : σ → S)
    (hv : ∀ j, φ (vR j) = ψ (vS j)) :
    Spec.map φ ≫ AffineSpace.homOfVector pR (fun j ↦ (Scheme.ΓSpecIso R).inv (vR j)) =
      Spec.map ψ ≫ AffineSpace.homOfVector pS (fun j ↦ (Scheme.ΓSpecIso S).inv (vS j)) := by
  refine AffineSpace.hom_ext ?_ ?_
  · rw [Category.assoc, Category.assoc, AffineSpace.homOfVector_over,
      AffineSpace.homOfVector_over, hp]
  · intro j
    rw [AffineSpace.comp_homOfVector_appTop_coord, AffineSpace.comp_homOfVector_appTop_coord,
      ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      ← Scheme.ΓSpecIso_inv_naturality, ← Scheme.ΓSpecIso_inv_naturality,
      CommRingCat.comp_apply, CommRingCat.comp_apply, hv j]

/-- Two morphisms to a relative affine space with the same structure morphism agree if their
coordinates agree after multiplication by a unit. -/
lemma AffineSpace.hom_ext_of_mul_unit {S T : Scheme.{u}} {σ : Type u} {F G : T ⟶ 𝔸(σ; S)}
    (h₁ : F ≫ 𝔸(σ; S) ↘ S = G ≫ 𝔸(σ; S) ↘ S) {w : Γ(T, ⊤)} (hw : IsUnit w)
    (h₂ : ∀ j, w * F.appTop (AffineSpace.coord S j) = w * G.appTop (AffineSpace.coord S j)) :
    F = G :=
  AffineSpace.hom_ext h₁ fun j ↦ hw.mul_left_cancel (h₂ j)

variable {X : Scheme.{u}}

/-- If the coordinates of `G` are used as the defining vector, `homOfVector` composed with the
base-change map recovers `G`. -/
lemma AffineSpace.homOfVector_coord_comp_map {σ : Type u} {S T Z : Scheme.{u}} (p : Z ⟶ S)
    (h : S ⟶ T) (G : Z ⟶ 𝔸(σ; T)) (hG : G ≫ 𝔸(σ; T) ↘ T = p ≫ h) :
    AffineSpace.homOfVector p (fun j ↦ G.appTop (AffineSpace.coord T j)) ≫
      AffineSpace.map σ h = G := by
  refine AffineSpace.hom_ext ?_ fun j ↦ ?_
  · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc,
      AffineSpace.homOfVector_over, hG]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, AffineSpace.map_appTop_coord,
      AffineSpace.homOfVector_appTop_coord]

namespace AffineSpace

section GroupLaw

variable (n : Type u) (S : Scheme.{u})

set_option hygiene false in
/-- The first projection `𝔸(n; S) ×_S 𝔸(n; S) ⟶ 𝔸(n; S)`. -/
local notation "pr₁" => Limits.pullback.fst (𝔸(n; S) ↘ S) (𝔸(n; S) ↘ S)

set_option hygiene false in
/-- The second projection `𝔸(n; S) ×_S 𝔸(n; S) ⟶ 𝔸(n; S)`. -/
local notation "pr₂" => Limits.pullback.snd (𝔸(n; S) ↘ S) (𝔸(n; S) ↘ S)

/-- The zero section `S ⟶ 𝔸(n; S)`, the unit of the additive group law. -/
def zeroSection : S ⟶ 𝔸(n; S) :=
  homOfVector (𝟙 S) 0

@[reassoc (attr := simp)]
lemma zeroSection_over : zeroSection n S ≫ 𝔸(n; S) ↘ S = 𝟙 S :=
  homOfVector_over _ _

@[simp]
lemma zeroSection_appTop_coord (i : n) : (zeroSection n S).appTop (coord S i) = 0 :=
  homOfVector_appTop_coord _ _ _

/-- The reflection `x ↦ -x` of `𝔸(n; S)`, the inverse of the additive group law. -/
def neg : 𝔸(n; S) ⟶ 𝔸(n; S) :=
  homOfVector (𝔸(n; S) ↘ S) fun i ↦ -coord S i

@[reassoc (attr := simp)]
lemma neg_over : neg n S ≫ 𝔸(n; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

@[simp]
lemma neg_appTop_coord (i : n) : (neg n S).appTop (coord S i) = -coord S i :=
  homOfVector_appTop_coord _ _ _

@[simp]
lemma neg_comp_neg : neg n S ≫ neg n S = 𝟙 𝔸(n; S) := by
  refine hom_ext ?_ fun i ↦ ?_
  · rw [Category.assoc, neg_over, neg_over, Category.id_comp]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, neg_appTop_coord, map_neg,
      neg_appTop_coord, neg_neg]
    simp

@[simp]
lemma zeroSection_comp_neg : zeroSection n S ≫ neg n S = zeroSection n S := by
  refine hom_ext ?_ fun i ↦ ?_
  · rw [Category.assoc, neg_over, zeroSection_over]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, neg_appTop_coord, map_neg,
      zeroSection_appTop_coord, neg_zero]

/-- The addition `(x, y) ↦ x + y` of `𝔸(n; S)`, a morphism `𝔸(n; S) ×_S 𝔸(n; S) ⟶ 𝔸(n; S)`,
the group law of the additive group scheme. -/
def add : Limits.pullback (𝔸(n; S) ↘ S) (𝔸(n; S) ↘ S) ⟶ 𝔸(n; S) :=
  homOfVector (pr₁ ≫ 𝔸(n; S) ↘ S) fun i ↦ (pr₁).appTop (coord S i) + (pr₂).appTop (coord S i)

@[reassoc (attr := simp)]
lemma add_over : add n S ≫ 𝔸(n; S) ↘ S = pr₁ ≫ 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

@[simp]
lemma add_appTop_coord (i : n) :
    (add n S).appTop (coord S i) = (pr₁).appTop (coord S i) + (pr₂).appTop (coord S i) :=
  homOfVector_appTop_coord _ _ _

/-- The scaling `x ↦ c x` of `𝔸(n; S)` by a global function `c` on `S`. -/
def smul (c : Γ(S, ⊤)) : 𝔸(n; S) ⟶ 𝔸(n; S) :=
  homOfVector (𝔸(n; S) ↘ S) fun i ↦ (𝔸(n; S) ↘ S).appTop c * coord S i

@[reassoc (attr := simp)]
lemma smul_over (c : Γ(S, ⊤)) : smul n S c ≫ 𝔸(n; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

@[simp]
lemma smul_appTop_coord (c : Γ(S, ⊤)) (i : n) :
    (smul n S c).appTop (coord S i) = (𝔸(n; S) ↘ S).appTop c * coord S i :=
  homOfVector_appTop_coord _ _ _

/-- Scaling by `-1` is the reflection `x ↦ -x`. -/
lemma smul_neg_one : smul n S (-1) = neg n S :=
  hom_ext (by simp) fun i ↦ by simp

variable {n S}

/-- The translation `x ↦ x + a` of `𝔸(n; S)` by a vector `a` of global functions on `S`. -/
def translation (a : n → Γ(S, ⊤)) : 𝔸(n; S) ⟶ 𝔸(n; S) :=
  homOfVector (𝔸(n; S) ↘ S) fun i ↦ coord S i + (𝔸(n; S) ↘ S).appTop (a i)

@[reassoc (attr := simp)]
lemma translation_over (a : n → Γ(S, ⊤)) : translation a ≫ 𝔸(n; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

@[simp]
lemma translation_appTop_coord (a : n → Γ(S, ⊤)) (i : n) :
    (translation a).appTop (coord S i) = coord S i + (𝔸(n; S) ↘ S).appTop (a i) :=
  homOfVector_appTop_coord _ _ _

@[simp]
lemma translation_zero : translation (0 : n → Γ(S, ⊤)) = 𝟙 𝔸(n; S) :=
  hom_ext (by simp) fun i ↦ by simp

/-- Translation by `a + b` is translation by `a` followed by translation by `b`. -/
@[reassoc]
lemma translation_add (a b : n → Γ(S, ⊤)) :
    translation (a + b) = translation a ≫ translation b := by
  refine hom_ext (by simp) fun i ↦ ?_
  simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, translation_appTop_coord, map_add,
    Pi.add_apply, add_assoc]
  rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, translation_over]

/-- The linear endomorphism `x ↦ A x` of `𝔸(n; S)` given by a square matrix `A` of global
functions on `S`: the `i`-th coordinate of the image is `∑ⱼ Aᵢⱼ xⱼ`. -/
def linearMap [Fintype n] (A : Matrix n n Γ(S, ⊤)) : 𝔸(n; S) ⟶ 𝔸(n; S) :=
  homOfVector (𝔸(n; S) ↘ S) fun i ↦ ∑ j, (𝔸(n; S) ↘ S).appTop (A i j) * coord S j

section LinearMap

variable [Fintype n]

@[reassoc (attr := simp)]
lemma linearMap_over (A : Matrix n n Γ(S, ⊤)) : linearMap A ≫ 𝔸(n; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

@[simp]
lemma linearMap_appTop_coord (A : Matrix n n Γ(S, ⊤)) (i : n) :
    (linearMap A).appTop (coord S i) = ∑ j, (𝔸(n; S) ↘ S).appTop (A i j) * coord S j :=
  homOfVector_appTop_coord _ _ _

@[simp]
lemma linearMap_one [DecidableEq n] : linearMap (1 : Matrix n n Γ(S, ⊤)) = 𝟙 𝔸(n; S) :=
  hom_ext (by simp) fun i ↦ by simp [Matrix.one_apply]

/-- The linear map of a product of matrices is the composite of the linear maps. -/
@[reassoc]
lemma linearMap_mul (A B : Matrix n n Γ(S, ⊤)) :
    linearMap (A * B) = linearMap B ≫ linearMap A := by
  refine hom_ext (by simp) fun i ↦ ?_
  have h (c : Γ(S, ⊤)) : (linearMap B).appTop ((𝔸(n; S) ↘ S).appTop c) =
      (𝔸(n; S) ↘ S).appTop c := by
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, linearMap_over]
  simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, linearMap_appTop_coord, map_sum,
    map_mul, h, Matrix.mul_apply, Finset.mul_sum, Finset.sum_mul, mul_assoc]
  exact Finset.sum_comm

/-- A linear map fixes the zero section. -/
@[reassoc (attr := simp)]
lemma zeroSection_comp_linearMap (A : Matrix n n Γ(S, ⊤)) :
    zeroSection n S ≫ linearMap A = zeroSection n S :=
  hom_ext (by simp) fun i ↦ by simp

/-- Linear maps are compatible with base change. -/
@[reassoc]
lemma map_comp_linearMap {T : Scheme.{u}} (f : T ⟶ S) (A : Matrix n n Γ(S, ⊤)) :
    map n f ≫ linearMap A = linearMap (A.map f.appTop) ≫ map n f := by
  refine hom_ext (by simp) fun i ↦ ?_
  have h (c : Γ(S, ⊤)) : (map n f).appTop ((𝔸(n; S) ↘ S).appTop c) =
      (𝔸(n; T) ↘ T).appTop (f.appTop c) := by
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, map_over, Scheme.Hom.comp_appTop,
      CommRingCat.comp_apply]
  simp [h]

/-- The linear automorphism `x ↦ A x` of `𝔸(n; S)` given by an invertible matrix `A`. -/
@[simps]
def linearMapIso [DecidableEq n] (A : (Matrix n n Γ(S, ⊤))ˣ) : 𝔸(n; S) ≅ 𝔸(n; S) where
  hom := linearMap A
  inv := linearMap ↑A⁻¹
  hom_inv_id := by rw [← linearMap_mul, Units.inv_mul, linearMap_one]
  inv_hom_id := by rw [← linearMap_mul, Units.mul_inv, linearMap_one]

end LinearMap

variable (n S)

/-- The standard pairing `⟨x, ξ⟩ = ∑ᵢ xᵢ ξᵢ` on `𝔸(n; S) ×_S 𝔸(n; S)`, a global function on
the fibre product. -/
def stdPairing [Fintype n] : Γ(Limits.pullback (𝔸(n; S) ↘ S) (𝔸(n; S) ↘ S), ⊤) :=
  ∑ i : n, (pr₁).appTop (coord S i) * (pr₂).appTop (coord S i)

end GroupLaw

end AffineSpace

/-! ### The iterated relative affine line

`AlgebraicGeometry.iteratedAffineLine S r` is the `r`-fold relative affine line over `S`,
obtained by applying `S ↦ 𝔸¹_S` to `S` exactly `r` times, and
`AlgebraicGeometry.iteratedAffineLineProj S r` is its projection to `S`, the composition of the
`r` affine-line projections. This records "a composition of `r` affine-line projections" as a
single morphism: the relative affine space `𝔸(n; S)` with `n` of cardinality `r` is isomorphic
to it over `S`, but that isomorphism is not available in mathlib.
-/

/-- The `r`-fold relative affine line over `S`, the `r`-th iterate of `S ↦ 𝔸¹_S`. -/
def iteratedAffineLine (S : Scheme.{u}) : ℕ → Scheme.{u}
  | 0 => S
  | r + 1 => 𝔸(PUnit.{u + 1}; iteratedAffineLine S r)

/-- The projection of the `r`-fold relative affine line over `S` to `S`: the composition of the
`r` affine-line projections. -/
def iteratedAffineLineProj (S : Scheme.{u}) : ∀ r : ℕ, iteratedAffineLine S r ⟶ S
  | 0 => 𝟙 S
  | r + 1 => (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r) ≫
      iteratedAffineLineProj S r

@[simp]
lemma iteratedAffineLine_zero (S : Scheme.{u}) : iteratedAffineLine S 0 = S := rfl

lemma iteratedAffineLine_succ (S : Scheme.{u}) (r : ℕ) :
    iteratedAffineLine S (r + 1) = 𝔸(PUnit.{u + 1}; iteratedAffineLine S r) := rfl

@[simp]
lemma iteratedAffineLineProj_zero (S : Scheme.{u}) : iteratedAffineLineProj S 0 = 𝟙 S := rfl

lemma iteratedAffineLineProj_succ (S : Scheme.{u}) (r : ℕ) :
    iteratedAffineLineProj S (r + 1) =
      (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r) ≫
        iteratedAffineLineProj S r :=
  rfl

instance (S : Scheme.{u}) : ∀ r : ℕ, IsAffineHom (iteratedAffineLineProj S r)
  | 0 => inferInstanceAs (IsAffineHom (𝟙 S))
  | r + 1 => by
    have := instIsAffineHomIteratedAffineLineProj S r
    rw [iteratedAffineLineProj_succ]
    infer_instance

instance (S : Scheme.{u}) : ∀ r : ℕ, LocallyOfFiniteType (iteratedAffineLineProj S r)
  | 0 => inferInstanceAs (LocallyOfFiniteType (𝟙 S))
  | r + 1 => by
    have := instLocallyOfFiniteTypeIteratedAffineLineProj S r
    rw [iteratedAffineLineProj_succ]
    infer_instance

namespace iteratedAffineLine

/-- The coordinates of the iterated affine line: the `0`-th coordinate is the coordinate of the
outermost affine line, and the others are pulled back from `iteratedAffineLine S r`. -/
noncomputable def coord (S : Scheme.{u}) : ∀ r : ℕ, Fin r → Γ(iteratedAffineLine S r, ⊤)
  | 0 => Fin.elim0
  | r + 1 => Fin.cons (AffineSpace.coord (iteratedAffineLine S r) PUnit.unit)
      fun i ↦ (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop
        (coord S r i)

/-- The iterated affine line over an affine scheme is affine. -/
instance isAffine (S : Scheme.{u}) [IsAffine S] : ∀ r : ℕ, IsAffine (iteratedAffineLine S r)
  | 0 => ‹_›
  | r + 1 => by
    have := isAffine S r
    exact inferInstanceAs (IsAffine 𝔸(PUnit.{u + 1}; iteratedAffineLine S r))

end iteratedAffineLine

/-- The morphism `X ⟶ 𝔸ʳ_S` over `g : X ⟶ S` with coordinates `t₁, …, t_r ∈ Γ(X, ⊤)`, as a
morphism to the iterated affine line: the coordinate `t 0` is the coordinate of the outermost
affine line.

For `X = Spec B_s` over `S = Spec A_s` this is the map `ν_t : Spec B_s ⟶ 𝔸ᵈ_{D(s)}` of blueprint
`def-zl-localized-coordinates`, given by `A_s[T₁, …, T_d] → B_s`, `Tᵢ ↦ tᵢ`; see
`AlgebraicGeometry.Scheme.Hom.toIteratedAffineLine_appTop_comp_evalCoord`. -/
noncomputable def Scheme.Hom.toIteratedAffineLine {X S : Scheme.{u}} (g : X ⟶ S) :
    ∀ {r : ℕ}, (Fin r → Γ(X, ⊤)) → (X ⟶ iteratedAffineLine S r)
  | 0, _ => g
  | _ + 1, t => AffineSpace.homOfVector (g.toIteratedAffineLine (Fin.tail t)) fun _ ↦ t 0

section toIteratedAffineLine

variable {X S : Scheme.{u}} (g : X ⟶ S)

lemma Scheme.Hom.toIteratedAffineLine_succ {r : ℕ} (t : Fin (r + 1) → Γ(X, ⊤)) :
    g.toIteratedAffineLine t =
      AffineSpace.homOfVector (g.toIteratedAffineLine (Fin.tail t)) fun _ ↦ t 0 :=
  rfl

lemma Scheme.Hom.toIteratedAffineLine_comp_over {r : ℕ} (t : Fin (r + 1) → Γ(X, ⊤)) :
    g.toIteratedAffineLine t ≫
        (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r) =
      g.toIteratedAffineLine (Fin.tail t) :=
  AffineSpace.homOfVector_over _ _

@[reassoc (attr := simp)]
lemma Scheme.Hom.toIteratedAffineLine_proj :
    ∀ {r : ℕ} (t : Fin r → Γ(X, ⊤)),
      g.toIteratedAffineLine t ≫ iteratedAffineLineProj S r = g
  | 0, _ => Category.comp_id _
  | r + 1, t => by
    calc g.toIteratedAffineLine t ≫ iteratedAffineLineProj S (r + 1)
        = (g.toIteratedAffineLine t ≫
            (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r)) ≫
              iteratedAffineLineProj S r := (Category.assoc _ _ _).symm
      _ = g := by rw [toIteratedAffineLine_comp_over, toIteratedAffineLine_proj]

lemma iteratedAffineLine.coord_succ_zero (S : Scheme.{u}) (r : ℕ) :
    coord S (r + 1) 0 = AffineSpace.coord (iteratedAffineLine S r) PUnit.unit :=
  rfl

lemma iteratedAffineLine.coord_succ_succ (S : Scheme.{u}) (r : ℕ) (i : Fin r) :
    coord S (r + 1) i.succ =
      (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop (coord S r i) :=
  rfl

lemma Scheme.Hom.toIteratedAffineLine_appTop_coord :
    ∀ {r : ℕ} (t : Fin r → Γ(X, ⊤)) (i : Fin r),
      (g.toIteratedAffineLine t).appTop (iteratedAffineLine.coord S r i) = t i
  | 0, _, i => i.elim0
  | r + 1, t, i => by
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · rw [iteratedAffineLine.coord_succ_zero]
      exact AffineSpace.homOfVector_appTop_coord _ _ _
    · rw [iteratedAffineLine.coord_succ_succ]
      erw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, toIteratedAffineLine_comp_over,
        toIteratedAffineLine_appTop_coord]
      rfl

/-- The evaluation of polynomials at the coordinates of the iterated affine line. -/
noncomputable def iteratedAffineLine.evalCoord (S : Scheme.{u}) (r : ℕ) :
    MvPolynomial (Fin r) Γ(S, ⊤) →+* Γ(iteratedAffineLine S r, ⊤) :=
  eval₂Hom (iteratedAffineLineProj S r).appTop.hom (coord S r)

/-- On global sections, `g.toIteratedAffineLine t` evaluates polynomials at `t`. -/
lemma Scheme.Hom.toIteratedAffineLine_appTop_comp_evalCoord {r : ℕ} (t : Fin r → Γ(X, ⊤)) :
    (g.toIteratedAffineLine t).appTop.hom.comp (iteratedAffineLine.evalCoord S r) =
      eval₂Hom g.appTop.hom t := by
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
  · simp only [iteratedAffineLine.evalCoord, RingHom.comp_apply, eval₂Hom_C]
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, toIteratedAffineLine_proj]
  · simp [iteratedAffineLine.evalCoord, toIteratedAffineLine_appTop_coord]

lemma iteratedAffineLine.evalCoord_succ_rename (S : Scheme.{u}) (r : ℕ)
    (q : MvPolynomial (Fin r) Γ(S, ⊤)) :
    evalCoord S (r + 1) (rename Fin.succ q) =
      (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop
        (evalCoord S r q) := by
  have : (evalCoord S (r + 1)).comp (rename Fin.succ).toRingHom =
      (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop.hom.comp
        (evalCoord S r) := by
    refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
    · change evalCoord S (r + 1) (rename Fin.succ (C a)) =
        (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop.hom
          (evalCoord S r (C a))
      rw [rename_C]
      simp only [evalCoord, eval₂Hom_C]
      rfl
    · change evalCoord S (r + 1) (rename Fin.succ (X i)) =
        (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop.hom
          (evalCoord S r (X i))
      rw [rename_X]
      simp only [evalCoord, eval₂Hom_X']
      rfl
  exact congr($this q)

/-- Over an affine base, the global functions on the iterated affine line are polynomials in the
coordinates. -/
lemma iteratedAffineLine.evalCoord_surjective (S : Scheme.{u}) [IsAffine S] :
    ∀ r : ℕ, Function.Surjective (evalCoord S r)
  | 0 => fun y ↦ ⟨C (show Γ(S, ⊤) from y), by rw [evalCoord, eval₂Hom_C]; rfl⟩
  | r + 1 => by
    have hsurj : Function.Surjective (eval₂Hom
        (𝔸(PUnit.{u + 1}; iteratedAffineLine S r) ↘ iteratedAffineLine S r).appTop.hom
        (AffineSpace.coord (iteratedAffineLine S r))) := by
      have := ConcreteCategory.bijective_of_isIso
        ((AffineSpace.isoOfIsAffine PUnit.{u + 1} (iteratedAffineLine S r)).hom.app ⊤)
      have h := AffineSpace.isoOfIsAffine_hom_appTop (n := PUnit.{u + 1})
        (S := iteratedAffineLine S r)
      intro y
      obtain ⟨x, hx⟩ := this.2 y
      refine ⟨(Scheme.ΓSpecIso _).hom x, ?_⟩
      rw [← hx]
      exact congr($(h).hom x).symm
    intro y
    obtain ⟨p, rfl⟩ := hsurj y
    induction p using MvPolynomial.induction_on with
    | C a =>
      obtain ⟨q, rfl⟩ := evalCoord_surjective S r a
      exact ⟨rename Fin.succ q, by rw [evalCoord_succ_rename, eval₂Hom_C]⟩
    | add p q hp hq =>
      obtain ⟨a, ha⟩ := hp
      obtain ⟨b, hb⟩ := hq
      exact ⟨a + b, by rw [map_add, ha, hb]; exact (map_add _ _ _).symm⟩
    | mul_X p n hp =>
      obtain ⟨a, ha⟩ := hp
      refine ⟨a * X 0, ?_⟩
      cases n
      have h1 : evalCoord S (r + 1) (X 0) =
          AffineSpace.coord (iteratedAffineLine S r) PUnit.unit := by
        simp only [evalCoord, eval₂Hom_X']
        rfl
      calc evalCoord S (r + 1) (a * X 0) = evalCoord S (r + 1) a * evalCoord S (r + 1) (X 0) :=
            map_mul _ _ _
        _ = _ := by rw [ha, h1, map_mul (eval₂Hom _ _), eval₂Hom_X']

end toIteratedAffineLine


@[simp]
lemma AffineSpace.zeroSection_comp_over (n : Type u) (S : Scheme.{u}) :
    AffineSpace.zeroSection n S ≫ 𝔸(n; S) ↘ S = 𝟙 S :=
  AffineSpace.homOfVector_over _ _

/-- The unit section `S ⟶ 𝔸(n; S)` of relative affine space: the morphism over `S` all of
whose coordinates are `1`, i.e. the section `t = 1`. It is the normalization point of weak
`𝔸¹`-invariance, where a comparison on `𝔸(n; S)` is pinned down by its restriction to
`t = 1`; this is why it sits here alongside `AffineSpace.zeroSection`. -/
noncomputable def AffineSpace.oneSection (n : Type u) (S : Scheme.{u}) : S ⟶ 𝔸(n; S) :=
  AffineSpace.homOfVector (𝟙 S) 1

@[simp]
lemma AffineSpace.oneSection_comp_over (n : Type u) (S : Scheme.{u}) :
    AffineSpace.oneSection n S ≫ 𝔸(n; S) ↘ S = 𝟙 S :=
  AffineSpace.homOfVector_over _ _

/-- The zero section is compatible with base change: it is the base change of the zero
section of `𝔸(n; T)` along any `f : S ⟶ T`. -/
lemma AffineSpace.zeroSection_comp_map {n : Type u} {S T : Scheme.{u}} (f : S ⟶ T) :
    AffineSpace.zeroSection n S ≫ AffineSpace.map n f = f ≫ AffineSpace.zeroSection n T := by
  refine AffineSpace.hom_ext ?_ fun j ↦ ?_
  · simp [AffineSpace.zeroSection]
  · simp [AffineSpace.zeroSection]

/-- The zero section of relative affine space over an *affine* base is a closed immersion:
`𝔸(n; S)` is then affine and its global sections are generated by `Γ(S, ⊤)` together with the
coordinates, which the zero section sends to `0`. -/
instance AffineSpace.isClosedImmersion_zeroSection_of_isAffine (n : Type u) (S : Scheme.{u})
    [IsAffine S] : IsClosedImmersion (AffineSpace.zeroSection n S) := by
  refine AffineSpace.isClosedImmersion_homOfVector _ _ ?_
  rw [Subring.eq_top_iff']
  exact fun x ↦ Subring.subset_closure (Or.inl ⟨x, by simp⟩)

/-- The zero section of relative affine space is a closed immersion. Over an affine base this
is `AffineSpace.isClosedImmersion_zeroSection_of_isAffine`, and the general case follows
because the zero section is the base change of the zero section over `Spec ℤ` along the
structure morphism. -/
instance AffineSpace.isClosedImmersion_zeroSection (n : Type u) (S : Scheme.{u}) :
    IsClosedImmersion (AffineSpace.zeroSection n S) := by
  set T : Scheme.{u} := Spec (.of (ULift.{u} ℤ)) with hT
  set f : S ⟶ T := specULiftZIsTerminal.from S with hf
  have hpaste : IsPullback f (AffineSpace.zeroSection n S ≫ 𝔸(n; S) ↘ S)
      (AffineSpace.zeroSection n T ≫ 𝔸(n; T) ↘ T) f := by
    simpa using
      (IsPullback.of_horiz_isIso (CommSq.mk (show 𝟙 S ≫ f = f ≫ 𝟙 T by simp))).flip
  exact MorphismProperty.of_isPullback
    (IsPullback.of_bot hpaste (AffineSpace.zeroSection_comp_map f).symm
      (AffineSpace.isPullback_map f)) inferInstance

/-- The image of the zero section of `𝔸(n; S)` is the common zero locus of the coordinates. -/
lemma AffineSpace.range_zeroSection (n : Type u) (S : Scheme.{u}) :
    Set.range (AffineSpace.zeroSection n S) =
      {y | ∀ i, y ∉ 𝔸(n; S).basicOpen (AffineSpace.coord S i)} := by
  ext y
  constructor
  · rintro ⟨s, rfl⟩ i hi
    have : s ∈ AffineSpace.zeroSection n S ⁻¹ᵁ 𝔸(n; S).basicOpen (AffineSpace.coord S i) := hi
    rw [Scheme.preimage_basicOpen_top, AffineSpace.zeroSection_appTop_coord,
      Scheme.basicOpen_zero] at this
    exact this
  · intro hy
    let f := 𝔸(n; S).fromSpecResidueField y
    have hf (i : n) : f.appTop (AffineSpace.coord S i) = 0 := by
      rw [← basicOpen_eq_bot_iff, ← Scheme.preimage_basicOpen_top, eq_bot_iff]
      intro p hp
      have hp' : f p ∈ Set.range f := ⟨p, rfl⟩
      rw [Scheme.range_fromSpecResidueField] at hp'
      exact hy i (hp' ▸ hp)
    have key : f ≫ 𝔸(n; S) ↘ S ≫ AffineSpace.zeroSection n S = f := by
      refine AffineSpace.hom_ext (by simp) fun i ↦ ?_
      rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, Scheme.Hom.comp_appTop,
        CommRingCat.comp_apply, AffineSpace.zeroSection_appTop_coord, map_zero, map_zero, hf]
    obtain ⟨p⟩ : Nonempty (Spec (𝔸(n; S).residueField y)) := inferInstance
    refine ⟨(𝔸(n; S) ↘ S) (f p), ?_⟩
    have hp' : f p ∈ Set.range f := ⟨p, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at hp'
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, key]
    exact hp'

/-- The fibre of an open subscheme `U ⊆ 𝔸¹_Y` over any point of `Y` is affine: it is an open
subscheme of the affine line over a field, whose coordinate ring is a principal ideal domain. -/
theorem AffineSpace.isAffine_fiber_of_isOpenImmersion {U Y : Scheme.{u}}
    (u : U ⟶ 𝔸(PUnit.{u + 1}; Y)) [IsOpenImmersion u] (y : Y) :
    IsAffine ((u ≫ 𝔸(PUnit.{u + 1}; Y) ↘ Y).fiber y) := by
  let g := Y.fromSpecResidueField y
  let π := 𝔸(PUnit.{u + 1}; Y) ↘ Y
  let f : pullback u (pullback.fst π g) ⟶ Spec (.of (MvPolynomial PUnit (Y.residueField y))) :=
    pullback.snd u (pullback.fst π g) ≫
      (AffineSpace.isPullback_map (n := PUnit) g).isoPullback.inv ≫
      (AffineSpace.SpecIso PUnit (Y.residueField y)).hom
  have : IsPrincipalIdealRing (MvPolynomial PUnit.{u + 1} (Y.residueField y)) :=
    IsPrincipalIdealRing.of_surjective
      (MvPolynomial.uniqueAlgEquiv (Y.residueField y) PUnit).symm.toRingHom
      (MvPolynomial.uniqueAlgEquiv (Y.residueField y) PUnit).symm.surjective
  have : IsAffine (pullback u (pullback.fst π g)) :=
    isAffine_of_isOpenImmersion_of_isPrincipalIdealRing f
  change IsAffine (pullback (u ≫ π) g)
  exact .of_isIso (pullbackRightPullbackFstIso π g u).inv

namespace AffineSpace

variable (n : Type u) {S T : Scheme.{u}}

/-- For `g : T ⟶ S`, the ring map `Γ(T)[n] ⟶ Γ(𝔸(n; S) ×[S] T)` sending a variable to the
pullback of the corresponding coordinate. It is an isomorphism when `T` is affine
(`AlgebraicGeometry.AffineSpace.toΓPullback_bijective`). -/
noncomputable def toΓPullback (g : T ⟶ S) :
    MvPolynomial n Γ(T, ⊤) →+* Γ(Limits.pullback (𝔸(n; S) ↘ S) g, ⊤) :=
  eval₂Hom (Limits.pullback.snd (𝔸(n; S) ↘ S) g).appTop.hom
    fun i ↦ (Limits.pullback.fst (𝔸(n; S) ↘ S) g).appTop (coord S i)

/-- Over an affine scheme `T`, the ring map `Γ(T)[n] ⟶ Γ(𝔸(n; S) ×[S] T)` is bijective: the
pullback is `𝔸(n; T) ≅ Spec Γ(T)[n]`. -/
theorem toΓPullback_bijective (g : T ⟶ S) [IsAffine T] :
    Function.Bijective (toΓPullback n g) := by
  let e := (isPullback_map (n := n) g).isoPullback
  have he : Function.Bijective e.hom.appTop :=
    ConcreteCategory.bijective_of_isIso _
  have key : e.hom.appTop.hom.comp (toΓPullback n g) =
      eval₂Hom (𝔸(n; T) ↘ T).appTop.hom (coord T) := by
    refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
    · simp [toΓPullback, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, e]
    · simp [toΓPullback, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, e]
  rw [← Function.Bijective.of_comp_iff' he, ← RingHom.coe_comp, key]
  have : eval₂Hom (𝔸(n; T) ↘ T).appTop.hom (coord T) =
      ((Scheme.ΓSpecIso _).inv ≫ (isoOfIsAffine n T).hom.appTop).hom := by
    rw [isoOfIsAffine_hom_appTop, Iso.inv_hom_id_assoc, CommRingCat.hom_ofHom]
  rw [this]
  exact ConcreteCategory.bijective_of_isIso _

/-- The ring maps `AlgebraicGeometry.AffineSpace.toΓPullback` are compatible with base change
along a morphism `h : T' ⟶ T` of schemes over `S`. -/
theorem appTop_pullbackMap_toΓPullback {T' : Scheme.{u}} (g : T ⟶ S) (g' : T' ⟶ S)
    (h : T' ⟶ T) (hh : h ≫ g = g') (p : MvPolynomial n Γ(T, ⊤)) :
    (Limits.pullback.map (𝔸(n; S) ↘ S) g' (𝔸(n; S) ↘ S) g (𝟙 _) h (𝟙 S) (by simp)
        (by simp [hh])).appTop (toΓPullback n g p) =
      toΓPullback n g' (MvPolynomial.map h.appTop.hom p) := by
  refine RingHom.congr_fun (f := RingHom.comp (CommRingCat.Hom.hom _) (toΓPullback n g))
    (g := (toΓPullback n g').comp (MvPolynomial.map h.appTop.hom)) ?_ p
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
  · simp only [toΓPullback, RingHom.coe_comp, Function.comp_apply, MvPolynomial.map_C,
      coe_eval₂Hom, eval₂_C]
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop,
      ← Scheme.Hom.comp_appTop, pullback.lift_snd]
  · simp only [toΓPullback, RingHom.coe_comp, Function.comp_apply, MvPolynomial.map_X,
      coe_eval₂Hom, eval₂_X]
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, pullback.lift_fst,
      Category.comp_id]

end AffineSpace

/-! ### Splitting off coordinates

Relabelling the coordinates along a bijection is an isomorphism of affine spaces
(`AlgebraicGeometry.AffineSpace.reindexIso`), and affine space in the coordinates `n ⊕ m` over
`S` is affine space in the coordinates `m` over `𝔸(n; S)`
(`AlgebraicGeometry.AffineSpace.sumIso`). Both are compatible with the zero sections; together
they write `𝔸^{c+1}_S` as the affine line over `𝔸^c_S`.
-/

namespace AffineSpace

variable {n m : Type u} (S : Scheme.{u})

set_option backward.isDefEq.respectTransparency.types false in
/-- Relabelling the coordinates along a bijection `e : m ≃ n` is an isomorphism
`𝔸(n; S) ≅ 𝔸(m; S)` over `S`. -/
@[simps]
noncomputable def reindexIso (e : m ≃ n) : 𝔸(n; S) ≅ 𝔸(m; S) where
  hom := reindex e S
  inv := reindex e.symm S
  hom_inv_id := by ext1 <;> simp
  inv_hom_id := by ext1 <;> simp

/-- Relabelling the coordinates preserves the zero section. -/
@[reassoc (attr := simp)]
lemma zeroSection_comp_reindex (i : m → n) :
    zeroSection n S ≫ reindex i S = zeroSection m S := by
  apply hom_ext
  · rw [Category.assoc, reindex_over, zeroSection_comp_over, zeroSection_comp_over]
  · intro j
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, reindex_appTop_coord,
      zeroSection_appTop_coord, zeroSection_appTop_coord]

/-- The map `𝔸(n ⊕ m; S) ⟶ 𝔸(m; 𝔸(n; S))`: the `n`-coordinates define the map to `𝔸(n; S)`
and the `m`-coordinates the remaining ones. -/
noncomputable def sumHom : 𝔸(n ⊕ m; S) ⟶ 𝔸(m; 𝔸(n; S)) :=
  homOfVector (homOfVector (𝔸(n ⊕ m; S) ↘ S) (coord S ∘ Sum.inl)) (coord S ∘ Sum.inr)

/-- The map `𝔸(m; 𝔸(n; S)) ⟶ 𝔸(n ⊕ m; S)`, inverse to `sumHom`. -/
noncomputable def sumInv : 𝔸(m; 𝔸(n; S)) ⟶ 𝔸(n ⊕ m; S) :=
  homOfVector (𝔸(m; 𝔸(n; S)) ↘ 𝔸(n; S) ≫ 𝔸(n; S) ↘ S)
    (Sum.elim ((𝔸(m; 𝔸(n; S)) ↘ 𝔸(n; S)).appTop ∘ coord S) (coord 𝔸(n; S)))

/-- The `n`-coordinates of `sumHom` define its composite with the projection to `𝔸(n; S)`. -/
lemma sumHom_over : sumHom S ≫ 𝔸(m; 𝔸(n; S)) ↘ 𝔸(n; S) =
    homOfVector (𝔸(n ⊕ m; S) ↘ S) (coord S ∘ Sum.inl) :=
  homOfVector_over _ _

set_option backward.isDefEq.respectTransparency.types false in
/-- Affine space in the coordinates `n ⊕ m` over `S` is affine space in the coordinates `m`
over affine space in the coordinates `n`: `𝔸(n ⊕ m; S) ≅ 𝔸(m; 𝔸(n; S))`. -/
noncomputable def sumIso : 𝔸(n ⊕ m; S) ≅ 𝔸(m; 𝔸(n; S)) where
  hom := sumHom S
  inv := sumInv S
  hom_inv_id := by
    apply hom_ext
    · rw [Category.assoc, sumInv, homOfVector_over, reassoc_of% sumHom_over, homOfVector_over,
        Category.id_comp]
    · rintro (i | i)
      · simp only [sumInv, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
          homOfVector_appTop_coord, Sum.elim_inl, Function.comp_apply]
        rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, sumHom_over,
          homOfVector_appTop_coord]
        simp
      · simp [sumInv, sumHom]
  inv_hom_id := by
    apply hom_ext
    · apply hom_ext
      · simp only [Category.assoc, sumHom_over, homOfVector_over, sumInv, Category.id_comp]
      · intro i
        simp only [Category.assoc, sumHom_over, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
          homOfVector_appTop_coord, Function.comp_apply, sumInv, Sum.elim_inl, Category.id_comp]
    · intro i
      simp [sumHom, sumInv]

/-- The forward map of `sumIso`. -/
lemma sumIso_hom : (sumIso S).hom = sumHom (n := n) (m := m) S := rfl

/-- `sumIso` is compatible with the projections to `S`. -/
@[reassoc (attr := simp)]
lemma sumIso_hom_over_over :
    (sumIso S).hom ≫ 𝔸(m; 𝔸(n; S)) ↘ 𝔸(n; S) ≫ 𝔸(n; S) ↘ S = 𝔸(n ⊕ m; S) ↘ S := by
  rw [sumIso_hom, reassoc_of% sumHom_over, homOfVector_over]

set_option backward.isDefEq.respectTransparency.types false in
/-- `sumIso` carries the zero section of `𝔸(n ⊕ m; S)` to the composite of the zero sections
of `𝔸(n; S)` and of `𝔸(m; 𝔸(n; S))`. -/
@[reassoc (attr := simp)]
lemma zeroSection_comp_sumIso_hom :
    zeroSection (n ⊕ m) S ≫ (sumIso S).hom = zeroSection n S ≫ zeroSection m 𝔸(n; S) := by
  apply hom_ext
  · rw [Category.assoc, Category.assoc, zeroSection_comp_over, Category.comp_id, sumIso_hom,
      sumHom_over]
    apply hom_ext
    · rw [Category.assoc, homOfVector_over, zeroSection_comp_over, zeroSection_comp_over]
    · intro i
      rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, homOfVector_appTop_coord,
        Function.comp_apply, zeroSection_appTop_coord, zeroSection_appTop_coord]
  · intro i
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, Scheme.Hom.comp_appTop,
      CommRingCat.comp_apply, zeroSection_appTop_coord, map_zero, sumIso_hom, sumHom,
      homOfVector_appTop_coord, Function.comp_apply, zeroSection_appTop_coord]

end AffineSpace

end AlgebraicGeometry

namespace AlgebraicGeometry

/-- The affine space `𝔸(m; S)` over an affine scheme with noetherian ring of global sections
has dimension `dim S + |m|`. -/
lemma topologicalKrullDim_affineSpace_of_isAffine {S : Scheme.{u}} [IsAffine S]
    [IsNoetherianRing Γ(S, ⊤)] (m : Type u) [Finite m] :
    topologicalKrullDim 𝔸(m; S) = topologicalKrullDim S + Nat.card m := by
  rw [IsHomeomorph.topologicalKrullDim_eq _
      (Scheme.homeoOfIso (AffineSpace.isoOfIsAffine m S)).isHomeomorph,
    IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso S.isoSpec).isHomeomorph]
  change topologicalKrullDim (PrimeSpectrum (MvPolynomial m Γ(S, ⊤))) =
    topologicalKrullDim (PrimeSpectrum Γ(S, ⊤)) + _
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    MvPolynomial.ringKrullDim_of_isNoetherianRing]

end AlgebraicGeometry
