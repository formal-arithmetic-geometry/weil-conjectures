/-!
# Morphisms into the integral model of affine space

`AlgebraicGeometry.AffineSpace.toSpecMvPolyIntEquiv` identifies morphisms `Y ⟶ Spec ℤ[m]`
with families of global sections of `Y`. We record how it evaluates on a morphism that
factors through the spectrum of a ring:

- `AlgebraicGeometry.AffineSpace.toSpecMvPolyIntEquiv_comp_SpecMap`.

We also record how `AlgebraicGeometry.AffineSpace.homOfVector` interacts with the functoriality
of affine space in the base, in `AlgebraicGeometry.AffineSpace.homOfVector_comp_map`, and that
`AlgebraicGeometry.AffineSpace.map` is an open immersion whenever the map of bases is.

Finally, `AlgebraicGeometry.AffineSpace.isClosedImmersion_homOfVector` is the criterion for a
morphism into an affine space over an affine base to be a closed immersion.


-/

/-!
# Immersions of quasi-affine schemes into relative affine space

This file proves Stacks Tag 04II: a quasi-affine scheme `X` that is locally of finite type
over a scheme `S` admits an immersion into a relative affine space `𝔸(Fin n; S)` over `S`.

## Main results

- `AlgebraicGeometry.AffineSpace.homOfVector_map`: naturality of `homOfVector` in the base.
- `AlgebraicGeometry.AffineSpace.isImmersion_homOfVector`: if `Y` and `V` are affine and the
  chosen sections `w` contain a unit `w j` such that `Γ(Y, ⊤)` is generated by the image of
  `Γ(V, ⊤)`, the sections `w` and the inverse of `w j`, then `homOfVector g w : Y ⟶ 𝔸(n; V)`
  is an immersion (a closed immersion into the basic open of the `j`-th coordinate).
- `AlgebraicGeometry.exists_immersion_affineSpace_of_quasiAffine`: **Stacks 04II**. If `X` is
  quasi-affine and `π : X ⟶ S` is locally of finite type, there are `n : ℕ` and an immersion
  `i : X ⟶ 𝔸(ULift (Fin n); S)` with `i ≫ 𝔸(ULift (Fin n); S) ↘ S = π`.

## Blueprint

This implements `lemma:nagata-quasi-affine-immersion-affine-space-exists` of the Nagata
compactification blueprint. Following the Stacks project, the hypotheses are that the
*scheme* `X` is quasi-affine (`X.IsQuasiAffine`) and that `π` is locally of finite type;
no hypothesis on `S` is needed. This applies in particular to the case needed for the
Nagata compactification of an affine morphism, where `X` is affine
(`lemma:nagata-affine-finite-type-is-quasi-affine` is the Mathlib instance
`[IsAffine X] : X.IsQuasiAffine`).
-/

@[expose] public section

universe u

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineSpace

/-- The family of sections classifying a morphism `Y ⟶ Spec R ⟶ Spec ℤ[m]` is obtained by
evaluating the ring map `ℤ[m] ⟶ R` at the variables. -/
lemma toSpecMvPolyIntEquiv_comp_SpecMap {m : Type u} {Y : Scheme.{u}} {R : CommRingCat.{u}}
    (h : Y ⟶ Spec R) (ψ : CommRingCat.of (MvPolynomial m (ULift.{u} ℤ)) ⟶ R) (j : m) :
    toSpecMvPolyIntEquiv m (h ≫ Spec.map ψ) j =
      h.appTop ((Scheme.ΓSpecIso R).inv (ψ (MvPolynomial.X j))) := by
  rw [toSpecMvPolyIntEquiv_comp]
  congr 1
  rw [toSpecMvPolyIntEquiv_apply, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
    CommRingCat.comp_apply]

section Map

variable {m : Type u} {S T : Scheme.{u}}

/-- Changing the base of `AlgebraicGeometry.AffineSpace.homOfVector` along `f : S ⟶ T` amounts
to composing the structure morphism with `f`. -/
@[reassoc]
lemma homOfVector_comp_map {X : Scheme.{u}} (h : X ⟶ S) (f : S ⟶ T) (v : m → Γ(X, ⊤)) :
    homOfVector h v ≫ map m f = homOfVector (h ≫ f) v := by
  refine hom_ext ?_ fun j ↦ ?_
  · rw [Category.assoc, map_over, homOfVector_over_assoc, homOfVector_over]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, map_appTop_coord,
      homOfVector_appTop_coord, homOfVector_appTop_coord]

instance isOpenImmersion_map (f : S ⟶ T) [IsOpenImmersion f] : IsOpenImmersion (map m f) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (isPullback_map (n := m) f).flip ‹_›

end Map

/-- If the global sections of an affine scheme `X` are generated as a ring by the image of
`Γ(T, ⊤)` together with a family `v`, the morphism `X ⟶ 𝔸(m; T)` classifying `v` over
`h : X ⟶ T` is a closed immersion. -/
lemma isClosedImmersion_homOfVector {m : Type u} {X T : Scheme.{u}} [IsAffine X]
    [IsAffine T] (h : X ⟶ T) (v : m → Γ(X, ⊤))
    (hgen : Subring.closure (Set.range h.appTop ∪ Set.range v) = ⊤) :
    IsClosedImmersion (homOfVector h v) := by
  refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
  have hle : Subring.closure (Set.range ⇑h.appTop ∪ Set.range v) ≤
      RingHom.range (homOfVector h v).appTop.hom := by
    rw [Subring.closure_le]
    rintro y (⟨a, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨(𝔸(m; T) ↘ T).appTop a, ?_⟩
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, homOfVector_over]
    · exact ⟨coord T i, homOfVector_appTop_coord _ _ _⟩
  exact fun x ↦ hle ((Subring.eq_top_iff' _).mp hgen x)

end AlgebraicGeometry.AffineSpace

open CategoryTheory Limits TopologicalSpace

noncomputable section

namespace AlgebraicGeometry


namespace AffineSpace

variable {n : Type u} {S : Scheme.{u}}

@[reassoc]
lemma homOfVector_map {X T : Scheme.{u}} (f : X ⟶ S) (g : S ⟶ T) (v : n → Γ(X, ⊤)) :
    homOfVector f v ≫ map n g = homOfVector (f ≫ g) v := by
  apply hom_ext
  · rw [Category.assoc, map_over, homOfVector_over_assoc, homOfVector_over]
  · intro i
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, map_appTop_coord,
      homOfVector_appTop_coord, homOfVector_appTop_coord]

instance {S T : Scheme.{u}} (f : S ⟶ T) [IsOpenImmersion f] : IsOpenImmersion (map n f) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (isPullback_map (n := n) f).flip
    inferInstance

/-- Let `Y` be an affine scheme over an affine scheme `V` and let `w` be a family of global
sections of `Y` containing a unit `w j` such that `Γ(Y, ⊤)` is generated, as a ring, by the
image of `Γ(V, ⊤)` together with the sections `w` and the inverse of `w j`. Then the induced
morphism `Y ⟶ 𝔸(n; V)` is an immersion; indeed it is a closed immersion into the basic open
of the `j`-th coordinate. -/
theorem isImmersion_homOfVector {Y V : Scheme.{u}} [IsAffine Y] [IsAffine V]
    (g : Y ⟶ V) (w : n → Γ(Y, ⊤)) (j : n) (hu : IsUnit (w j))
    (hgen : Subring.closure
      (Set.range g.appTop ∪ Set.range w ∪ {(↑hu.unit⁻¹ : Γ(Y, ⊤))}) = ⊤) :
    IsImmersion (homOfVector g w) := by
  have hB : IsAffine (𝔸(n; V).basicOpen (coord V j)).toScheme :=
    (isAffineOpen_top 𝔸(n; V)).basicOpen (coord V j)
  -- the morphism factors through the basic open of the `j`-th coordinate
  have hpre : homOfVector g w ⁻¹ᵁ 𝔸(n; V).basicOpen (coord V j) = ⊤ := by
    rw [Scheme.preimage_basicOpen_top, homOfVector_appTop_coord, Y.basicOpen_of_isUnit hu]
  have hrange : Set.range (homOfVector g w).base ⊆
      Set.range (𝔸(n; V).basicOpen (coord V j)).ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro - ⟨y, rfl⟩
    have hy : y ∈ homOfVector g w ⁻¹ᵁ 𝔸(n; V).basicOpen (coord V j) := hpre.ge trivial
    exact hy
  rw [← IsOpenImmersion.lift_fac (𝔸(n; V).basicOpen (coord V j)).ι (homOfVector g w) hrange]
  suffices h : IsClosedImmersion
      (IsOpenImmersion.lift (𝔸(n; V).basicOpen (coord V j)).ι (homOfVector g w) hrange) by
    infer_instance
  generalize hℓ : IsOpenImmersion.lift (𝔸(n; V).basicOpen (coord V j)).ι
    (homOfVector g w) hrange = ℓ
  have hfac : ℓ ≫ (𝔸(n; V).basicOpen (coord V j)).ι = homOfVector g w := by
    rw [← hℓ]; exact IsOpenImmersion.lift_fac _ _ hrange
  apply IsClosedImmersion.of_surjective_of_isAffine
  -- surjectivity of `ℓ.appTop`: the generators of `Γ(Y, ⊤)` are all in the image
  have hcoord : ∀ s : n, ℓ.appTop ((𝔸(n; V).basicOpen (coord V j)).ι.appTop (coord V s)) = w s := by
    intro s
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, hfac, homOfVector_appTop_coord]
  have hg' : ℓ ≫ (𝔸(n; V).basicOpen (coord V j)).ι ≫ 𝔸(n; V) ↘ V = g := by
    rw [← Category.assoc, hfac, homOfVector_over]
  have hbase : ∀ c : Γ(V, ⊤),
      ℓ.appTop (((𝔸(n; V).basicOpen (coord V j)).ι ≫ 𝔸(n; V) ↘ V).appTop c) = g.appTop c := by
    intro c
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, ← Category.assoc, hfac,
      homOfVector_over]
  -- the restriction of the `j`-th coordinate to its basic open is a unit
  have hc : IsUnit ((𝔸(n; V).basicOpen (coord V j)).ι.appTop (coord V j)) := by
    refine Scheme.isUnit_of_le_basicOpen (le_of_eq ?_)
    rw [← Scheme.preimage_basicOpen_top, Scheme.Opens.ι_preimage_self]
  -- `ℓ.appTop` maps the inverse of the coordinate to the inverse of `w j`
  have hinv : ℓ.appTop (↑hc.unit⁻¹ : _) = (↑hu.unit⁻¹ : Γ(Y, ⊤)) := by
    have h1 : w j * ℓ.appTop (↑hc.unit⁻¹ : _) = 1 := by
      rw [← hcoord j, ← map_mul, IsUnit.mul_val_inv, map_one]
    calc ℓ.appTop (↑hc.unit⁻¹ : _)
        = ((↑hu.unit⁻¹ : Γ(Y, ⊤)) * w j) * ℓ.appTop (↑hc.unit⁻¹ : _) := by
          rw [IsUnit.val_inv_mul, one_mul]
      _ = (↑hu.unit⁻¹ : Γ(Y, ⊤)) * (w j * ℓ.appTop (↑hc.unit⁻¹ : _)) := mul_assoc _ _ _
      _ = (↑hu.unit⁻¹ : Γ(Y, ⊤)) := by rw [h1, mul_one]
  suffices hsub : Set.range g.appTop ∪ Set.range w ∪ {(↑hu.unit⁻¹ : Γ(Y, ⊤))} ⊆
      Set.range ℓ.appTop by
    intro y
    have hy : y ∈ Subring.closure (Set.range g.appTop ∪ Set.range w ∪
        {(↑hu.unit⁻¹ : Γ(Y, ⊤))}) := hgen.ge trivial
    induction hy using Subring.closure_induction with
    | mem z hz => exact hsub hz
    | zero => exact ⟨0, map_zero _⟩
    | one => exact ⟨1, map_one _⟩
    | add _ _ _ _ h1 h2 => obtain ⟨p, rfl⟩ := h1; obtain ⟨q, rfl⟩ := h2
                           exact ⟨p + q, map_add _ p q⟩
    | mul _ _ _ _ h1 h2 => obtain ⟨p, rfl⟩ := h1; obtain ⟨q, rfl⟩ := h2
                           exact ⟨p * q, map_mul _ p q⟩
    | neg _ _ h1 => obtain ⟨p, rfl⟩ := h1; exact ⟨-p, map_neg _ p⟩
  rintro x ((⟨c, rfl⟩ | ⟨s, rfl⟩) | rfl)
  · exact ⟨((𝔸(n; V).basicOpen (coord V j)).ι ≫ 𝔸(n; V) ↘ V).appTop c, hbase c⟩
  · exact ⟨(𝔸(n; V).basicOpen (coord V j)).ι.appTop (coord V s), hcoord s⟩
  · exact ⟨(↑hc.unit⁻¹ : _), hinv⟩

end AffineSpace

open AffineSpace

/-- Variant of `exists_immersion_affineSpace_of_quasiAffine` (Stacks 04II) producing an
immersion into an affine space with an unspecified finite index type. -/
theorem exists_immersion_affineSpace_of_quasiAffine' {X S : Scheme.{u}} (π : X ⟶ S)
    [X.IsQuasiAffine] [LocallyOfFiniteType π] :
    ∃ (σ : Type u) (_ : Finite σ) (i : X ⟶ 𝔸(σ; S)),
      i ≫ 𝔸(σ; S) ↘ S = π ∧ IsImmersion i := by
  classical
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated X.toSpecΓ
  -- Step 1: at every point, choose an affine basic open mapping into an affine open of `S`
  have hchart : ∀ x : X, ∃ r : Γ(X, ⊤), IsAffineOpen (X.basicOpen r) ∧ x ∈ X.basicOpen r ∧
      ∃ V : S.Opens, IsAffineOpen V ∧ X.basicOpen r ≤ π ⁻¹ᵁ V := by
    intro x
    obtain ⟨V, hV, hπxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π x) trivial
    obtain ⟨-, ⟨-, ⟨r, hraff, rfl⟩, rfl⟩, hxr, hrV⟩ :=
      (Scheme.IsQuasiAffine.isBasis_basicOpen X).exists_subset_of_mem_open
        (show x ∈ (π ⁻¹ᵁ V : Set X) from hπxV) (π ⁻¹ᵁ V).2
    exact ⟨r, hraff, hxr, V, hV, fun y hy ↦ hrV hy⟩
  choose r hraff hxr V hVaff hrV using hchart
  -- Step 2: extract a finite subcover by quasi-compactness
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ (X.basicOpen (r x) : Set X)) (fun x ↦ (X.basicOpen (r x)).2)
    (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hxr x⟩)
  -- Step 3: clear denominators, using the qcqs lemma
  have hnum : ∀ (x : X) (g : Γ(X.basicOpen (r x), ⊤)), ∃ (b : Γ(X, ⊤)) (m : ℕ),
      g * (X.basicOpen (r x)).ι.appTop (r x) ^ m = (X.basicOpen (r x)).ι.appTop b := by
    intro x g
    have := Γ_restrict_isLocalization_of_qcqs X (r x)
    obtain ⟨⟨b, q⟩, hq⟩ := IsLocalization.surj (M := Submonoid.powers (r x)) g
    obtain ⟨m, hm⟩ := q.2
    refine ⟨b, m, ?_⟩
    have halg : ⇑(algebraMap Γ(X, ⊤) Γ(X.basicOpen (r x), ⊤)) =
        ⇑((X.basicOpen (r x)).ι.appTop) := rfl
    rw [halg] at hq
    rw [← hm] at hq
    rw [map_pow] at hq
    exact hq
  choose b m hbm using hnum
  -- Step 4: finite-type generators over each affine chart
  have hgens : ∀ x : X, ∃ s : Finset Γ(X.basicOpen (r x), ⊤),
      ∀ y : Γ(X.basicOpen (r x), ⊤), y ∈ Subring.closure
        (Set.range (π.resLE (V x) (X.basicOpen (r x)) (hrV x)).appTop ∪ ↑s) := by
    intro x
    have : IsAffine (X.basicOpen (r x)).toScheme := hraff x
    have : IsAffine (V x).toScheme := hVaff x
    have hft : RingHom.FiniteType ((π.resLE (V x) (X.basicOpen (r x)) (hrV x)).appTop).hom :=
      HasRingHomProperty.appTop (P := @LocallyOfFiniteType)
        (π.resLE (V x) (X.basicOpen (r x)) (hrV x)) inferInstance
    let := ((π.resLE (V x) (X.basicOpen (r x)) (hrV x)).appTop).hom.toAlgebra
    have hFT : Algebra.FiniteType Γ(V x, ⊤) Γ(X.basicOpen (r x), ⊤) := hft
    obtain ⟨s, hs⟩ := hFT.out
    refine ⟨s, fun y ↦ ?_⟩
    have hy : y ∈ Algebra.adjoin Γ(V x, ⊤) (↑s : Set Γ(X.basicOpen (r x), ⊤)) := by
      rw [hs]; exact Algebra.mem_top
    induction hy using Algebra.adjoin_induction with
    | mem z hz => exact Subring.subset_closure (Set.mem_union_right _ hz)
    | algebraMap c => exact Subring.subset_closure (Set.mem_union_left _ ⟨c, rfl⟩)
    | add _ _ _ _ h1 h2 => exact add_mem h1 h2
    | mul _ _ _ _ h1 h2 => exact mul_mem h1 h2
  choose s hs using hgens
  -- Step 5: assemble the global tuple of sections
  let σ : Type u := {x : X // x ∈ t} ⊕
    (Σ jj : {x : X // x ∈ t}, {g : Γ(X.basicOpen (r jj.1), ⊤) // g ∈ s jj.1})
  let v : σ → Γ(X, ⊤) := Sum.elim (fun jj ↦ r jj.1) (fun p ↦ b p.1.1 p.2.1)
  refine ⟨σ, inferInstance, homOfVector π v, homOfVector_over π v, ?_⟩
  -- Step 6: the morphism is an immersion, checked over each chart
  apply IsZariskiLocalAtTarget.of_forall_source_exists_preimage
  intro x
  have hx := ht (Set.mem_univ x)
  simp only [Set.mem_iUnion, exists_prop] at hx
  obtain ⟨j, hjt, hxj⟩ := hx
  have hjcoord : v (Sum.inl ⟨j, hjt⟩) = r j := rfl
  -- the preimage of the distinguished affine open of `𝔸(σ; S)` is the chart
  have hUeq : homOfVector π v ⁻¹ᵁ
      ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩))) =
      X.basicOpen (r j) := by
    have h2 : homOfVector π v ⁻¹ᵁ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩)) =
        X.basicOpen (r j) := by
      rw [Scheme.preimage_basicOpen_top, homOfVector_appTop_coord, hjcoord]
    have h1 : homOfVector π v ⁻¹ᵁ ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j) = π ⁻¹ᵁ V j := by
      change (homOfVector π v ≫ 𝔸(σ; S) ↘ S) ⁻¹ᵁ V j = π ⁻¹ᵁ V j
      rw [homOfVector_over]
    have hinf : homOfVector π v ⁻¹ᵁ
        ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩))) =
        homOfVector π v ⁻¹ᵁ ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j) ⊓
          homOfVector π v ⁻¹ᵁ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩)) := rfl
    rw [hinf, h1, h2]
    exact inf_eq_right.mpr (hrV j)
  refine ⟨(𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩)), ?_, ?_⟩
  · have : x ∈ homOfVector π v ⁻¹ᵁ
        ((𝔸(σ; S) ↘ S) ⁻¹ᵁ V j ⊓ 𝔸(σ; S).basicOpen (coord S (Sum.inl ⟨j, hjt⟩))) := by
      rw [hUeq]; exact hxj
    exact this
  · rw [hUeq, comp_homOfVector, ← Scheme.Hom.resLE_comp_ι π (hrV j), ← homOfVector_map]
    have : IsAffine (X.basicOpen (r j)).toScheme := hraff j
    have : IsAffine (V j).toScheme := hVaff j
    -- the restriction of `r j` to its own basic open is a unit
    have hu : IsUnit (((X.basicOpen (r j)).ι.appTop ∘ v) (Sum.inl ⟨j, hjt⟩)) := by
      change IsUnit ((X.basicOpen (r j)).ι.appTop (r j))
      refine Scheme.isUnit_of_le_basicOpen (le_of_eq ?_)
      rw [← Scheme.preimage_basicOpen_top, Scheme.Opens.ι_preimage_self]
    -- the generation hypothesis over the chart
    have hgen : Subring.closure
        (Set.range (π.resLE (V j) (X.basicOpen (r j)) (hrV j)).appTop ∪
          Set.range ((X.basicOpen (r j)).ι.appTop ∘ v) ∪
          {(↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))}) = ⊤ := by
      refine le_antisymm le_top fun y _ ↦ ?_
      refine Subring.closure_le.mpr ?_ (hs j y)
      rintro z (hz | hz)
      · exact Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ hz))
      · -- a finite-type generator `z` equals `b j z` divided by a power of `r j`
        have hres : (X.basicOpen (r j)).ι.appTop (b j z) ∈ Subring.closure
            (Set.range (π.resLE (V j) (X.basicOpen (r j)) (hrV j)).appTop ∪
              Set.range ((X.basicOpen (r j)).ι.appTop ∘ v) ∪
              {(↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))}) :=
          Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _
            ⟨Sum.inr ⟨⟨j, hjt⟩, ⟨z, hz⟩⟩, rfl⟩))
        have hinv : (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ∈ Subring.closure
            (Set.range (π.resLE (V j) (X.basicOpen (r j)) (hrV j)).appTop ∪
              Set.range ((X.basicOpen (r j)).ι.appTop ∘ v) ∪
              {(↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))}) :=
          Subring.subset_closure (Set.mem_union_right _ rfl)
        have hzeq : z = (X.basicOpen (r j)).ι.appTop (b j z) *
            (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ^ m j z := by
          have h1 : (X.basicOpen (r j)).ι.appTop (r j) *
              (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) = 1 := hu.mul_val_inv
          calc z = z * ((X.basicOpen (r j)).ι.appTop (r j) *
                (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤))) ^ m j z := by
                rw [h1, one_pow, mul_one]
            _ = z * (X.basicOpen (r j)).ι.appTop (r j) ^ m j z *
                (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ^ m j z := by ring
            _ = (X.basicOpen (r j)).ι.appTop (b j z) *
                (↑hu.unit⁻¹ : Γ(X.basicOpen (r j), ⊤)) ^ m j z := by rw [hbm j z]
        rw [hzeq]
        exact mul_mem hres (pow_mem hinv _)
    have h1 : IsImmersion (homOfVector (π.resLE (V j) (X.basicOpen (r j)) (hrV j))
        ((X.basicOpen (r j)).ι.appTop ∘ v)) :=
      isImmersion_homOfVector _ _ (Sum.inl ⟨j, hjt⟩) hu hgen
    infer_instance

/-- **Stacks Tag 04II**: a quasi-affine scheme that is locally of finite type over `S` admits
an immersion into a relative affine space over `S`. This is
`lemma:nagata-quasi-affine-immersion-affine-space-exists` of the Nagata compactification
blueprint. -/
@[stacks 04II]
theorem exists_immersion_affineSpace_of_quasiAffine {X S : Scheme.{u}} (π : X ⟶ S)
    [X.IsQuasiAffine] [LocallyOfFiniteType π] :
    ∃ (n : ℕ) (i : X ⟶ 𝔸(ULift.{u} (Fin n); S)),
      i ≫ 𝔸(ULift.{u} (Fin n); S) ↘ S = π ∧ IsImmersion i := by
  obtain ⟨σ, hfin, i, hover, himm⟩ := exists_immersion_affineSpace_of_quasiAffine' π
  obtain ⟨k, ⟨eqv⟩⟩ := Finite.exists_equiv_fin σ
  let e : ULift.{u} (Fin k) ≃ σ := Equiv.ulift.trans eqv.symm
  have h1 : reindex (⇑e) S ≫ reindex (⇑e.symm) S = 𝟙 𝔸(σ; S) := by
    apply hom_ext
    · simp
    · intro s
      simp [reindex_appTop_coord]
  have h2 : reindex (⇑e.symm) S ≫ reindex (⇑e) S = 𝟙 𝔸(ULift.{u} (Fin k); S) := by
    apply hom_ext
    · simp
    · intro s
      simp [reindex_appTop_coord]
  have : IsIso (reindex (⇑e) S) := ⟨reindex (⇑e.symm) S, h1, h2⟩
  refine ⟨k, i ≫ reindex (⇑e) S, ?_, ?_⟩
  · rw [Category.assoc, reindex_over, hover]
  · have := himm
    infer_instance

/-- The `j`-th coordinate of a morphism to relative affine space precomposed with `m` is the
pullback along `m` of the `j`-th defining section. -/
lemma AffineSpace.comp_homOfVector_appTop_coord {n : Type u} {S T Y : Scheme.{u}} (m : T ⟶ Y)
    (h : Y ⟶ S) (v : n → Γ(Y, ⊤)) (j : n) :
    (m ≫ AffineSpace.homOfVector h v).appTop (AffineSpace.coord S j) = m.appTop (v j) := by
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, AffineSpace.homOfVector_appTop_coord]

/-- Two morphisms from `Spec T` to a relative affine space, given by ring maps out of `R` and
`S` together with defining vectors of sections of `R` and `S`, agree as soon as the underlying
morphisms to the base agree and the defining sections have the same image in `T`. -/
lemma AffineSpace.specMap_comp_homOfVector_eq {X : Scheme.{u}} {σ : Type u}
    {R S T : CommRingCat.{u}} (φ : R ⟶ T) (ψ : S ⟶ T) (pR : Spec R ⟶ X) (pS : Spec S ⟶ X)
    (hp : Spec.map φ ≫ pR = Spec.map ψ ≫ pS) (vR : σ → R) (vS : σ → S)
    (hv : ∀ j, φ (vR j) = ψ (vS j)) :
    Spec.map φ ≫ AffineSpace.homOfVector pR (fun j ↦ (Scheme.ΓSpecIso R).inv (vR j)) =
      Spec.map ψ ≫ AffineSpace.homOfVector pS (fun j ↦ (Scheme.ΓSpecIso S).inv (vS j)) := by
  refine AffineSpace.hom_ext ?_ ?_
  · rw [Category.assoc, Category.assoc, AffineSpace.homOfVector_over,
      AffineSpace.homOfVector_over, hp]
  · intro j
    rw [AffineSpace.comp_homOfVector_appTop_coord, AffineSpace.comp_homOfVector_appTop_coord,
      ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      ← Scheme.ΓSpecIso_inv_naturality, ← Scheme.ΓSpecIso_inv_naturality,
      CommRingCat.comp_apply, CommRingCat.comp_apply, hv j]

/-- Two morphisms to a relative affine space with the same structure morphism agree if their
coordinates agree after multiplication by a unit. -/
lemma AffineSpace.hom_ext_of_mul_unit {S T : Scheme.{u}} {σ : Type u} {F G : T ⟶ 𝔸(σ; S)}
    (h₁ : F ≫ 𝔸(σ; S) ↘ S = G ≫ 𝔸(σ; S) ↘ S) {w : Γ(T, ⊤)} (hw : IsUnit w)
    (h₂ : ∀ j, w * F.appTop (AffineSpace.coord S j) = w * G.appTop (AffineSpace.coord S j)) :
    F = G :=
  AffineSpace.hom_ext h₁ fun j ↦ hw.mul_left_cancel (h₂ j)

variable {X : Scheme.{u}}

/-- If the coordinates of `G` are used as the defining vector, `homOfVector` composed with the
base-change map recovers `G`. -/
lemma AffineSpace.homOfVector_coord_comp_map {σ : Type u} {S T Z : Scheme.{u}} (p : Z ⟶ S)
    (h : S ⟶ T) (G : Z ⟶ 𝔸(σ; T)) (hG : G ≫ 𝔸(σ; T) ↘ T = p ≫ h) :
    AffineSpace.homOfVector p (fun j ↦ G.appTop (AffineSpace.coord T j)) ≫
      AffineSpace.map σ h = G := by
  refine AffineSpace.hom_ext ?_ fun j ↦ ?_
  · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc,
      AffineSpace.homOfVector_over, hG]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, AffineSpace.map_appTop_coord,
      AffineSpace.homOfVector_appTop_coord]

/-- The zero section `S ⟶ 𝔸(n; S)` of relative affine space: the morphism over `S` all of
whose coordinates are `0`. -/
noncomputable def AffineSpace.zeroSection (n : Type u) (S : Scheme.{u}) : S ⟶ 𝔸(n; S) :=
  AffineSpace.homOfVector (𝟙 S) 0

@[simp]
lemma AffineSpace.zeroSection_comp_over (n : Type u) (S : Scheme.{u}) :
    AffineSpace.zeroSection n S ≫ 𝔸(n; S) ↘ S = 𝟙 S :=
  AffineSpace.homOfVector_over _ _

/-- The unit section `S ⟶ 𝔸(n; S)` of relative affine space: the morphism over `S` all of
whose coordinates are `1`. -/
noncomputable def AffineSpace.oneSection (n : Type u) (S : Scheme.{u}) : S ⟶ 𝔸(n; S) :=
  AffineSpace.homOfVector (𝟙 S) 1

@[simp]
lemma AffineSpace.oneSection_comp_over (n : Type u) (S : Scheme.{u}) :
    AffineSpace.oneSection n S ≫ 𝔸(n; S) ↘ S = 𝟙 S :=
  AffineSpace.homOfVector_over _ _

/-- The zero section of relative affine space is a closed immersion: it is the vanishing
locus of the coordinates, and being a closed immersion is local on the base, where
`AffineSpace.isClosedImmersion_homOfVector` applies. -/
instance AffineSpace.isClosedImmersion_zeroSection (n : Type u) (S : Scheme.{u}) :
    IsClosedImmersion (AffineSpace.zeroSection n S) :=
  sorry

end AlgebraicGeometry
