module

public import Mathlib.CategoryTheory.Sites.MayerVietorisSquare
public import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic
public import Mathlib.Topology.Sheaves.Flasque
public import WeilConjectures.Mathlib.CategoryTheory.Sites.SheafCohomology.Basic

/-!
# Injective sheaves are flasque, and flasque sheaves are acyclic

Let `X` be a topological space. For an open `U` of `X`, the free abelian sheaf `ℤ[U]` generated
by `U` corepresents the sections over `U`: morphisms `ℤ[U] ⟶ F` are sections of `F` over `U`
(`TopCat.Sheaf.freeOpenHomEquiv`). For `V ≤ U` the morphism `ℤ[V] ⟶ ℤ[U]` is a monomorphism, so
every section over `V` of an injective sheaf extends to `U`: injective abelian sheaves are
flasque. Embedding a flasque sheaf into an injective one, the quotient is again flasque, and
global sections of the injective sheaf surject onto those of the quotient; dimension shifting
then shows that flasque sheaves have no higher cohomology.

## Main definitions

- `TopCat.Sheaf.freeOpen`: the free abelian sheaf `ℤ[U]` on an open `U`.
- `TopCat.Sheaf.freeOpenHomEquiv`: the section over `U` attached to a morphism `ℤ[U] ⟶ F`.

## Main statements

- `TopCat.Sheaf.exists_map_eq_of_mono_freeOpen`: sections over `V` of a sheaf `F` extend to
  `U ≥ V` as soon as `F` has the extension property along `ℤ[V] ⟶ ℤ[U]`.
- `TopCat.Sheaf.isFlasque_of_injective`: injective abelian sheaves are flasque.
- `TopCat.Sheaf.IsFlasque.subsingleton_H`: flasque abelian sheaves have vanishing cohomology in
  positive degrees.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite TopologicalSpace Abelian

namespace TopCat.Sheaf

variable {X : TopCat.{u}}

/-- The free abelian sheaf `ℤ[U]` generated by an open `U`: the sheafification of the free
abelian presheaf on the presheaf of sets represented by `U`. -/
noncomputable abbrev freeOpen (U : Opens X) :
    CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} :=
  (presheafToSheaf _ _).obj (yoneda.obj U ⋙ AddCommGrpCat.free)

/-- The morphism `ℤ[V] ⟶ ℤ[U]` induced by an inclusion `V ≤ U`. -/
noncomputable abbrev freeOpenMap {U V : Opens X} (i : V ⟶ U) : freeOpen V ⟶ freeOpen U :=
  (presheafToSheaf _ _).map (Functor.whiskerRight (yoneda.map i) AddCommGrpCat.free)

/-- Morphisms `ℤ[U] ⟶ F` are the sections of `F` over `U`. -/
noncomputable def freeOpenHomEquiv (U : Opens X)
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) :
    (freeOpen U ⟶ F) ≃ F.obj.obj (op U) :=
  ((sheafificationAdjunction _ _).homEquiv _ _).trans
    (((AddCommGrpCat.adj.whiskerRight (C := (Opens X)ᵒᵖ)).homEquiv _ _).trans yonedaEquiv)

variable {F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}}

/-- Restricting the section attached to `ψ : ℤ[U] ⟶ F` to `V ≤ U` gives the section attached to
the composite `ℤ[V] ⟶ ℤ[U] ⟶ F`. -/
lemma freeOpenHomEquiv_comp {U V : Opens X} (i : V ⟶ U) (ψ : freeOpen U ⟶ F) :
    freeOpenHomEquiv V F (freeOpenMap i ≫ ψ) = F.obj.map i.op (freeOpenHomEquiv U F ψ) := by
  simp only [freeOpenHomEquiv, Equiv.trans_apply]
  rw [Adjunction.homEquiv_naturality_left]
  erw [Adjunction.homEquiv_naturality_left]
  exact (yonedaEquiv_naturality _ i).symm

/-- Sections over `V` of a sheaf `F` extend to `U ≥ V` as soon as every morphism `ℤ[V] ⟶ F`
extends along `ℤ[V] ⟶ ℤ[U]`. -/
lemma exists_map_eq_of_mono_freeOpen {U V : Opens X} (i : V ⟶ U)
    (h : ∀ ψ : freeOpen V ⟶ F, ∃ φ : freeOpen U ⟶ F, freeOpenMap i ≫ φ = ψ)
    (s : F.obj.obj (op V)) : ∃ t : F.obj.obj (op U), F.obj.map i.op t = s := by
  obtain ⟨ψ, rfl⟩ := (freeOpenHomEquiv V F).surjective s
  obtain ⟨φ, rfl⟩ := h ψ
  exact ⟨freeOpenHomEquiv U F φ, (freeOpenHomEquiv_comp i φ).symm⟩

/-- **Injective sheaves are flasque**: every section over `V` of an injective abelian sheaf
extends to any open `U ≥ V`, since `ℤ[V] ⟶ ℤ[U]` is a monomorphism. -/
theorem isFlasque_of_injective [Injective F] : Presheaf.IsFlasque F.obj where
  epi {U V} i := by
    refine (AddCommGrpCat.epi_iff_surjective _).mpr fun s ↦ ?_
    have : Mono (freeOpenMap i.unop) := inferInstance
    exact exists_map_eq_of_mono_freeOpen i.unop
      (fun ψ ↦ ⟨Injective.factorThru ψ (freeOpenMap i.unop), Injective.comp_factorThru _ _⟩) s

variable [HasExt.{u} (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})]
  [EnoughInjectives (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})]

/-- Blueprint `lem-sc-zariski-flasque-acyclic`: Flasque sheaves are acyclic.

**Flasque sheaves are acyclic** (flasque in the sense of blueprint `def-sc-zariski-flasque`,
Mathlib's `TopCat.Sheaf.IsFlasque`): a flasque abelian sheaf has vanishing cohomology in every
positive degree. Embed `F` into an injective sheaf `I`; the quotient `Q` is flasque, global
sections of `I` surject onto those of `Q`, which kills `H¹(F)`, and `Hⁿ⁺¹(F) ≅ Hⁿ(Q)` for
`n ≥ 1`. -/
theorem IsFlasque.subsingleton_H (n : ℕ) :
    ∀ (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
      [Presheaf.IsFlasque F.obj], Subsingleton (CategoryTheory.Sheaf.H F (n + 1)) := by
  induction n with
  | zero =>
    intro F _
    refine CategoryTheory.Sheaf.subsingleton_H_one_of_surjective F (T := ⊤)
      isTerminalTop fun E Q ι π w hS ↦ ?_
    have : Presheaf.IsFlasque (ShortComplex.mk ι π w).X₁.obj := ‹_›
    exact (AddCommGrpCat.epi_iff_surjective _).mp (IsFlasque.epi_of_shortExact hS)
  | succ n ih =>
    intro F _
    let S := ShortComplex.mk (Injective.ι F) (cokernel.π (Injective.ι F)) (cokernel.condition _)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    have : Presheaf.IsFlasque S.X₁.obj := ‹_›
    have : Presheaf.IsFlasque S.X₂.obj := isFlasque_of_injective
    have : Presheaf.IsFlasque S.X₃.obj := IsFlasque.of_shortExact_of_isFlasque₁₂ hS
    have := ih S.X₃
    have : Subsingleton (CategoryTheory.Sheaf.H S.X₂ (n + 1 + 1)) :=
      subsingleton_of_forall_eq 0 fun x ↦ Ext.eq_zero_of_injective x
    obtain ⟨hsurj⟩ := (⟨CategoryTheory.Sheaf.H.δSucc_surjective hS (n + 1)⟩ :
      Nonempty (Function.Surjective (CategoryTheory.Sheaf.H.δSucc hS (n + 1))))
    exact hsurj.subsingleton

end TopCat.Sheaf
