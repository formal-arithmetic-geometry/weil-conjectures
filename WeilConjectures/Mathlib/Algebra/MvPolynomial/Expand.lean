module

public import Mathlib.Algebra.MvPolynomial.Expand
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The ideal generated by `expand n f - f`

The ideal of `MvPolynomial σ R` generated by the differences `expand n f - f` is generated by
the differences `X i ^ n - X i` (blueprint `lemma-frobenius-fixed-scheme`): modulo the latter,
`expand n` agrees with the identity on the generators `X i`.
-/

@[expose] public section

namespace MvPolynomial

variable {σ R : Type*} [CommRing R] (n : ℕ)

/-- `expand n f - f` lies in the ideal generated by the `X i ^ n - X i`. -/
theorem expand_sub_self_mem_span (f : MvPolynomial σ R) :
    expand n f - f ∈ Ideal.span (Set.range fun i ↦ (X i ^ n - X i : MvPolynomial σ R)) := by
  set I := Ideal.span (Set.range fun i ↦ (X i ^ n - X i : MvPolynomial σ R))
  have h : (Ideal.Quotient.mkₐ R I).comp (expand n) = Ideal.Quotient.mkₐ R I :=
    algHom_ext fun i ↦ by
      simp only [AlgHom.comp_apply, expand_X, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq]
      exact Ideal.subset_span ⟨i, rfl⟩
  rw [← Ideal.Quotient.eq]
  exact congr($h f)

/-- The ideal generated by the `expand n f - f` is generated by the `X i ^ n - X i`. -/
theorem span_range_expand_sub_self :
    Ideal.span (Set.range fun f : MvPolynomial σ R ↦ expand n f - f) =
      Ideal.span (Set.range fun i ↦ (X i ^ n - X i : MvPolynomial σ R)) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨f, rfl⟩
    exact expand_sub_self_mem_span n f
  · rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨X i, by simp [expand_X]⟩


/-- **The equations of the fixed scheme** (blueprint `lemma-frobenius-fixed-scheme`): let `J`
be an ideal of `R[t_i]_{i ∈ σ}` stable under the substitution `t_i ↦ t_i^n`, and `φ` the induced
endomorphism of `B = R[t]/J`. The ideal of `B` generated by the `φ(b) - b` is generated by the
`t_i^n - t_i`. -/
theorem span_range_quotientMapₐ_expand_sub_self (J : Ideal (MvPolynomial σ R))
    (h : J ≤ J.comap (expand n)) :
    Ideal.span (Set.range fun b : MvPolynomial σ R ⧸ J ↦ Ideal.quotientMapₐ J (expand n) h b - b) =
      (Ideal.span (Set.range fun i ↦ (X i ^ n - X i : MvPolynomial σ R))).map
        (Ideal.Quotient.mk J) := by
  rw [← span_range_expand_sub_self, Ideal.map_span]
  congr 1
  ext b
  constructor
  · rintro ⟨b, rfl⟩
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective b
    exact ⟨_, ⟨f, rfl⟩, by simp⟩
  · rintro ⟨_, ⟨f, rfl⟩, rfl⟩
    exact ⟨Ideal.Quotient.mk J f, by simp⟩

end MvPolynomial
