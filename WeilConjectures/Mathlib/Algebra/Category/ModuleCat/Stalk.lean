module

public import Mathlib.Algebra.Category.Grp.EpiMono
public import Mathlib.Algebra.Category.ModuleCat.Stalk
public import Mathlib.Algebra.Homology.ShortComplex.ExactFunctor
public import Mathlib.Topology.Sheaves.LocallySurjective
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import WeilConjectures.Mathlib.Topology.Sheaves.Stalks

/-!
# Stalks of sheaves of modules

Mathlib's `Mathlib/Algebra/Category/ModuleCat/Stalk.lean` endows the stalk of a presheaf of
modules with a module structure over the stalk of the presheaf of rings. This file adds the
three things that are needed to *compute* with stalks:

* the map induced on stalks by a morphism of presheaves of modules is linear, and the germ map
  itself is semilinear over the germ map on functions;
* taking stalks is an exact functor on sheaves of modules;
* the stalks of a sheaf of modules generated by its global sections are spanned by the germs of
  those global sections, together with the section-level criterion in the opposite direction: a
  family of sections spanning the sections of `M` locally generates `M`.

Exactness is obtained by combining left exactness, which holds already at the level of
presheaves because a stalk is a filtered colimit
(`TopCat.Presheaf.stalkFunctor_preservesFiniteLimits`), with the fact that an epimorphism of
sheaves is locally surjective, hence surjective on stalks.

The statement about global generation is the local-to-global content of
`SheafOfModules.IsGloballyGenerated`, and it is obtained without computing the stalk of a free
sheaf of modules. A family `s : I → M.sections` of generating sections gives a morphism of
*presheaves* of modules `PresheafOfModules.freeObjHom s` out of the free presheaf of modules on
the constant presheaf with value `I`, whose image over each open subset is the submodule spanned
by the `s i` there (`PresheafOfModules.range_freeObjHom_app`). That morphism is the composite of
the sheafification unit with an epimorphism of sheaves of modules
(`SheafOfModules.epi_sheafifyFreeObjDesc`); both factors are surjective on stalks, the unit
because the sheafification map of presheaves of abelian groups is locally surjective, and the
epimorphism because the stalk functor preserves epimorphisms.

## Main declarations

* `SheafOfModules.isGloballyGenerated_of_forall_exists_mem_span`: **a family of sections whose
  restrictions span the sections of `M` locally generates `M`**, the criterion by which a
  concrete sheaf of modules is shown to be generated by its global sections.
* `PresheafOfModules.stalkMapₗ`: the map induced on stalks by a morphism of presheaves of
  modules, as a linear map over the stalk of the structure presheaf of rings.
* `PresheafOfModules.germₛₗ`: the germ map on sections, as a map semilinear over the germ map of
  the presheaf of rings.
* `SheafOfModules.stalkFunctor`: taking the stalk at `x`, as a functor to abelian groups.
* `CategoryTheory.ShortComplex.ShortExact.map_stalkFunctor`: a short exact sequence of sheaves
  of modules induces a short exact sequence of stalks.
* `SheafOfModules.exists_mem_span_germ_eq`: **the stalks of a sheaf of modules generated by its
  global sections are spanned by the germs of its global sections**, in the form that every
  element of a stalk is the germ of a section which is an `R`-linear combination of global
  sections.

-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite TopologicalSpace

namespace PresheafOfModules

variable {X : TopCat.{u}} {R : X.Presheaf CommRingCat.{u}}
  {M N : PresheafOfModules.{u} (R ⋙ forget₂ CommRingCat RingCat)} (φ : M ⟶ N) (x : X)

/-- The map induced on stalks by a morphism of presheaves of modules, as a linear map over the
stalk of the presheaf of rings. -/
noncomputable def stalkMapₗ :
    TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x →ₗ[R.stalk x]
      TopCat.Presheaf.stalk (C := Ab.{u}) N.presheaf x where
  toFun := (TopCat.Presheaf.stalkFunctor Ab.{u} x).map ((toPresheaf _).map φ)
  map_add' := map_add _
  map_smul' r m := by
    obtain ⟨V, hxV, a, rfl⟩ := R.exists_germ_eq r
    obtain ⟨U, hUV, hxU, s, rfl⟩ :=
      TopCat.Presheaf.exists_le_germ_eq (C := Ab.{u}) M.presheaf m hxV
    rw [RingHom.id_apply, ← R.germ_res_apply (homOfLE hUV) x hxU a, ← germ_smul]
    -- `erw`: after `← germ_smul` the section lives in `M.obj (op U)`, which is the carrier of
    -- `M.presheaf.obj (op U)` only up to unfolding `PresheafOfModules.presheaf`.
    erw [TopCat.Presheaf.stalkFunctor_map_germ_apply,
      TopCat.Presheaf.stalkFunctor_map_germ_apply, ← germ_smul]
    congr 1
    exact map_smul (φ.app (op U)).hom _ _

@[simp]
lemma stalkMapₗ_apply (m : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) :
    stalkMapₗ φ x m = (TopCat.Presheaf.stalkFunctor Ab.{u} x).map ((toPresheaf _).map φ) m := rfl

end PresheafOfModules

namespace SheafOfModules

variable {X : TopCat.{u}} (R : TopCat.Sheaf RingCat.{u} X)

/-- Taking the stalk at `x`, as a functor from sheaves of modules to abelian groups. -/
noncomputable def stalkFunctor (x : X) : SheafOfModules.{u} R ⥤ Ab.{u} :=
  SheafOfModules.forget R ⋙ PresheafOfModules.toPresheaf R.obj ⋙
    TopCat.Presheaf.stalkFunctor Ab.{u} x

instance (x : X) : PreservesFiniteLimits (stalkFunctor R x) :=
  letI : PreservesFiniteLimits (TopCat.Presheaf.stalkFunctor Ab.{u} x) := inferInstance
  letI : PreservesFiniteLimits
      (PresheafOfModules.toPresheaf R.obj ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} x) :=
    comp_preservesFiniteLimits _ _
  comp_preservesFiniteLimits _ _

instance (x : X) : (stalkFunctor R x).Additive :=
  Functor.additive_of_preserves_binary_products _

instance (x : X) : (stalkFunctor R x).PreservesEpimorphisms where
  preserves {M N} φ hφ := by
    have := hφ
    have := (toSheaf R).map_epi φ
    exact (AddCommGrpCat.epi_iff_surjective _).2
      (TopCat.Sheaf.surjective_stalkFunctor_map_of_epi ((toSheaf R).map φ) x)

end SheafOfModules

namespace CategoryTheory.ShortComplex.ShortExact

variable {X : TopCat.{u}} {R : TopCat.Sheaf RingCat.{u} X}

/-- **Taking stalks is exact**: a short exact sequence of sheaves of modules induces a short
exact sequence of stalks at every point. -/
lemma map_stalkFunctor {S : ShortComplex (SheafOfModules.{u} R)} (hS : S.ShortExact) (x : X) :
    (S.map (SheafOfModules.stalkFunctor R x)).ShortExact := by
  have := hS.mono_f
  have := hS.epi_g
  have h := (Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono
    (SheafOfModules.stalkFunctor R x)).1 inferInstance S hS
  exact { exact := h.1, mono_f := h.2, epi_g := (SheafOfModules.stalkFunctor R x).map_epi _ }

end CategoryTheory.ShortComplex.ShortExact

namespace SheafOfModules

open PresheafOfModules TopologicalSpace

variable {X : TopCat.{u}} {R : TopCat.Sheaf RingCat.{u} X}

section Generators

variable {M : SheafOfModules.{u} R} {I : Type u} (s : I → M.sections)

/-- **A sheaf of modules whose sections are locally spanned by a family of sections is generated
by that family.** If every section of `M` over every open subset `U` becomes, on a neighbourhood
`V ⊆ U` of any prescribed point, an `R`-linear combination of the restrictions of the `s i`,
then the `s i` generate `M`.

This is the section-level counterpart of `SheafOfModules.exists_mem_span_germ_eq_of_epi`, read
in the opposite direction — not a literal converse, since the hypothesis here starts from a
section over an open subset rather than from an element of a stalk. The
morphism `free I ⟶ M` classified by the `s i` is locally surjective by hypothesis
(`SheafOfModules.span_le_range_freeHomEquiv_symm_app`), hence an epimorphism of sheaves of
abelian groups, hence an epimorphism of sheaves of modules because `SheafOfModules.toSheaf` is
faithful:

```
    free I ─────────────▶ M            in `SheafOfModules R`
      │  freeHomEquiv.symm s │
   toSheaf                toSheaf
      ▼                      ▼
  toSheaf (free I) ─────▶ toSheaf M    in `Sheaf (Opens X) AddCommGrpCat`
```

The bottom morphism is an epimorphism because a morphism of sheaves of abelian groups on a
topological space is an epimorphism as soon as it is locally surjective. -/
theorem isGloballyGenerated_of_forall_exists_mem_span
    (h : ∀ (U : Opens X) (t : M.val.obj (op U)) (x : X), x ∈ U →
      ∃ V : Opens X, ∃ hVU : V ≤ U, x ∈ V ∧
        M.val.map (homOfLE hVU).op t ∈ Submodule.span (R.obj.obj (op V))
          (Set.range fun i ↦ sections.eval (s i) (op V))) :
    M.IsGloballyGenerated := by
  refine isGloballyGenerated_iff_exists.2 ⟨I, M.freeHomEquiv.symm s, ?_⟩
  have : CategoryTheory.Sheaf.IsLocallySurjective ((toSheaf R).map (M.freeHomEquiv.symm s)) :=
    (TopCat.Presheaf.isLocallySurjective_iff _).2 fun U t x hx ↦ by
      obtain ⟨V, hVU, hxV, hmem⟩ := h U t x hx
      exact ⟨V, hVU, span_le_range_freeHomEquiv_symm_app s (op V) hmem, hxV⟩
  exact (toSheaf R).epi_of_epi_map inferInstance

/-- The morphism of presheaves of modules attached to a family of generating sections is
surjective on stalks: it is the composite of the sheafification unit, which is locally
surjective, with an epimorphism of sheaves of modules. See the triangle in the docstring of
`SheafOfModules.unit_comp_sheafifyFreeObjDesc`. -/
theorem surjective_stalkFunctor_map_freeObjHom [Epi (M.freeHomEquiv.symm s)] (x : X) :
    Function.Surjective ((TopCat.Presheaf.stalkFunctor Ab.{u} x).map
      ((toPresheaf R.obj).map (freeObjHom s))) := by
  have := epi_sheafifyFreeObjDesc s
  have hunit : Function.Surjective ((TopCat.Presheaf.stalkFunctor Ab.{u} x).map
      ((toPresheaf R.obj).map ((sheafificationAdjunction (𝟙 R.obj)).unit.app
        (freeObj ((Functor.const (Opens X)ᵒᵖ).obj I))))) := by
    rw [toPresheaf_map_sheafificationAdjunction_unit_app]
    refine (TopCat.Presheaf.locally_surjective_iff_surjective_on_stalks _).1 ?_ x
    exact Presheaf.isLocallySurjective_toSheafify' _ _
  have hdesc := (AddCommGrpCat.epi_iff_surjective _).1
    ((stalkFunctor R x).map_epi (sheafifyFreeObjDesc s))
  rw [← unit_comp_sheafifyFreeObjDesc s, Functor.map_comp, Functor.map_comp]
  exact hdesc.comp hunit

/-- Every element of a stalk of a sheaf of modules generated by the sections `s i` is the germ
of an `R`-linear combination of the `s i`. -/
theorem exists_mem_span_germ_eq_of_epi [Epi (M.freeHomEquiv.symm s)] (x : X)
    (z : TopCat.Presheaf.stalk (C := Ab.{u}) M.val.presheaf x) :
    ∃ (V : Opens X) (hxV : x ∈ V) (t : M.val.obj (op V)),
      t ∈ Submodule.span (R.obj.obj (op V))
        (Set.range fun i ↦ sections.eval (s i) (op V)) ∧
        TopCat.Presheaf.germ (C := Ab.{u}) M.val.presheaf V x hxV t = z := by
  obtain ⟨w, rfl⟩ := surjective_stalkFunctor_map_freeObjHom s x z
  obtain ⟨V, hxV, u, rfl⟩ := TopCat.Presheaf.exists_germ_eq (C := Ab.{u})
    (freeObj (R := R.obj) ((Functor.const (Opens X)ᵒᵖ).obj I)).presheaf w
  refine ⟨V, hxV, Hom.app (freeObjHom s) (op V) u,
    (range_freeObjHom_app s (op V)).le ⟨u, rfl⟩, ?_⟩
  exact (TopCat.Presheaf.stalkFunctor_map_germ_apply V x hxV
    ((toPresheaf R.obj).map (freeObjHom s)) u).symm

end Generators

/-- Every element of a stalk of a free sheaf of modules is the germ of an `R`-linear combination
of the tautological sections: the description of the stalk of a free sheaf of modules. -/
theorem exists_mem_span_germ_eq_freeSection (I : Type u) (x : X)
    (z : TopCat.Presheaf.stalk (C := Ab.{u}) (free (R := R) I).val.presheaf x) :
    ∃ (V : Opens X) (hxV : x ∈ V) (t : (free (R := R) I).val.obj (op V)),
      t ∈ Submodule.span (R.obj.obj (op V))
        (Set.range fun i ↦ sections.eval (freeSection (R := R) i) (op V)) ∧
        TopCat.Presheaf.germ (C := Ab.{u}) (free (R := R) I).val.presheaf V x hxV t = z :=
  have hid : (free (R := R) I).freeHomEquiv.symm (fun i ↦ freeSection (R := R) i) = 𝟙 _ :=
    (free (R := R) I).freeHomEquiv.symm_apply_apply _
  have : Epi ((free (R := R) I).freeHomEquiv.symm fun i ↦ freeSection (R := R) i) := by
    rw [hid]
    infer_instance
  exists_mem_span_germ_eq_of_epi _ x z

/-- **Every element of a stalk of a sheaf of modules generated by its global sections is the germ
of an `R`-linear combination of global sections.** -/
theorem exists_mem_span_germ_eq (M : SheafOfModules.{u} R) [M.IsGloballyGenerated] (x : X)
    (z : TopCat.Presheaf.stalk (C := Ab.{u}) M.val.presheaf x) :
    ∃ (V : Opens X) (hxV : x ∈ V) (t : M.val.obj (op V)),
      t ∈ Submodule.span (R.obj.obj (op V))
        (Set.range fun s : M.sections ↦ sections.eval s (op V)) ∧
        TopCat.Presheaf.germ (C := Ab.{u}) M.val.presheaf V x hxV t = z := by
  obtain ⟨σ⟩ := IsGloballyGenerated.nonempty_generatingSections (M := M)
  have := σ.epi
  obtain ⟨V, hxV, t, ht, hz⟩ := exists_mem_span_germ_eq_of_epi σ.s x z
  refine ⟨V, hxV, t, Submodule.span_mono ?_ ht, hz⟩
  rintro _ ⟨i, rfl⟩
  exact ⟨σ.s i, rfl⟩

end SheafOfModules
