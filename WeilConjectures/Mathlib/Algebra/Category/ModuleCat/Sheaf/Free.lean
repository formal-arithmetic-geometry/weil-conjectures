module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Sheafification
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import Mathlib.CategoryTheory.Preadditive.Biproducts
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Presheaf.Free

/-!
# Free sheaves of modules and sheafification

`SheafOfModules.free I` is the coproduct of copies of `SheafOfModules.unit R` indexed by `I`,
so for a one-element type `I` it is the unit itself. This is
`SheafOfModules.freeUniqueIso`, which is how properties proved for the free sheaves of modules
are transported to the structure sheaf.

## The free sheaf of modules on a finite type is a biproduct

The category of sheaves of modules is preadditive, so for a finite `I` the coproduct decomposition
of `SheafOfModules.free I` is also a product decomposition: `SheafOfModules.freeBicone` is the
bicone with point `free I` whose injections are `SheafOfModules.ιFree`, and
`SheafOfModules.isBilimitFreeBicone` says it is a bilimit. This is what makes the projections
`SheafOfModules.πFree` available and gives `SheafOfModules.sum_πFree_comp_ιFree`, the identity
that decomposes any section — or any germ, after applying an additive functor — into its `I`
components.

Sheafifying the free *presheaf* of modules on the constant presheaf of types with value `I`
gives `SheafOfModules.sheafifyFreeObj R I`, and a family `s : I → M.sections` of sections of a
sheaf of modules `M` induces a morphism `SheafOfModules.sheafifyFreeObjDesc s` out of it, the
adjunct of the presheaf-level `PresheafOfModules.freeObjHom`. The free sheaf of modules maps to
`sheafifyFreeObj R I` compatibly with the morphisms classified by `s`
(`SheafOfModules.freeToSheafifyFreeObj_comp`), which is how generation by global sections is
transferred from `SheafOfModules.free I` to the sheafification of `freeObj (const I)`.

## Main declarations

- `SheafOfModules.freeUniqueIso`: the free sheaf of modules on a one-element type is the unit.
- `SheafOfModules.πFree`, `SheafOfModules.isBilimitFreeBicone`,
  `SheafOfModules.sum_πFree_comp_ιFree`: the projections of the free sheaf of modules on a
  finite type, and the bilimit structure they come from.
- `SheafOfModules.sheafifyFreeObj`, `SheafOfModules.sheafifyFreeObjDesc`: the sheafification of
  the free presheaf of modules on the constant presheaf with value `I`, and the morphism out of
  it attached to a family of sections.
- `SheafOfModules.freeToSheafifyFreeObj`, `SheafOfModules.freeToSheafifyFreeObj_comp`: the
  comparison morphism from `SheafOfModules.free I`, and its compatibility with the two morphisms
  classified by a family of sections.

## TODO

`SheafOfModules.freeToSheafifyFreeObj` is an isomorphism: both sides are coproducts of copies of
`SheafOfModules.unit R`, because `Functor.const Cᵒᵖ`, `PresheafOfModules.freeObj` and the
sheafification are all left adjoints, hence commute with the decomposition `I ≅ ∐ (fun _ : I ↦
PUnit)`. Only the factorisation `SheafOfModules.freeToSheafifyFreeObj_comp` is needed here, but
with the isomorphism in hand `Epi (M.freeHomEquiv.symm s)` becomes equivalent to local
surjectivity of `PresheafOfModules.freeObjHom s`, which is the criterion needed to prove that a
concrete sheaf of modules is generated by its global sections.
-/

@[expose] public section

universe u v₁ u₁

open CategoryTheory Limits PresheafOfModules

namespace SheafOfModules

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- The free sheaf of modules on a one-element type is the unit. -/
noncomputable def freeUniqueIso (I : Type u) [Unique I] : free (R := R) I ≅ unit R :=
  coproductUniqueIso (fun (_ : I) ↦ unit R)

section Biproduct

variable (I : Type u)

/-- **The bicone with point `free I` whose injections are `SheafOfModules.ιFree`.** For a finite
`I` it is a bilimit (`SheafOfModules.isBilimitFreeBicone`), so it exhibits `free I` as the
biproduct of `I` copies of `unit R`. -/
noncomputable def freeBicone : Bicone (fun _ : I ↦ unit R) :=
  Bicone.ofColimitCocone (isColimitFreeCofan (R := R) I)

@[simp]
lemma freeBicone_ι (i : I) : (freeBicone (R := R) I).ι i = ιFree i := rfl

/-- **The free sheaf of modules on a finite type is the biproduct of copies of `unit R`.** -/
noncomputable def isBilimitFreeBicone [Fintype I] : (freeBicone (R := R) I).IsBilimit :=
  biconeIsBilimitOfColimitCoconeOfIsColimit (isColimitFreeCofan I)

variable {I}

/-- **The `j`-th projection `free I ⟶ unit R` of the free sheaf of modules on `I`**, the
identity on the `j`-th summand and zero on the others:

```
  unit R ──ιFree k──▶ free I
        ╲                │
  δ k j  ╲               │ πFree j
          ╲              ▼
           ╲───────────▶ unit R
```

commutes with `δ k j = 𝟙` for `k = j` (`SheafOfModules.ιFree_πFree_self`) and `δ k j = 0`
otherwise (`SheafOfModules.ιFree_πFree_of_ne`). -/
noncomputable def πFree (j : I) : free (R := R) I ⟶ unit R :=
  (freeBicone I).π j

@[reassoc (attr := simp)]
lemma ιFree_πFree_self (j : I) : ιFree (R := R) j ≫ πFree j = 𝟙 (unit R) := by
  simpa [πFree] using (freeBicone (R := R) I).ι_π j j

@[reassoc (attr := simp)]
lemma ιFree_πFree_of_ne {k j : I} (h : k ≠ j) : ιFree (R := R) k ≫ πFree j = 0 := by
  simpa [πFree, h] using (freeBicone (R := R) I).ι_π k j

variable (I)

/-- **The injections and the projections of the free sheaf of modules on a finite type compose
to the identity.** -/
lemma sum_πFree_comp_ιFree [Fintype I] :
    ∑ j : I, πFree (R := R) j ≫ ιFree j = 𝟙 (free I) :=
  IsBilimit.total (isBilimitFreeBicone (R := R) I)

end Biproduct

section Sheafify

variable {M : SheafOfModules.{u} R} {I : Type u} (s : I → M.sections)

/-- **Every linear combination of the sections `s i` over an object of the site is in the image
of the morphism `free I ⟶ M` they classify**: the tautological section `i` of
`SheafOfModules.free I` is sent to `s i`, by
`SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection`. This is the sheaf-level counterpart
of `PresheafOfModules.range_freeObjHom_app`, and is what makes that morphism locally surjective
when the `s i` span the sections of `M` locally. -/
lemma span_le_range_freeHomEquiv_symm_app (U : Cᵒᵖ) :
    Submodule.span (R.obj.obj U) (Set.range fun i ↦ sections.eval (s i) U) ≤
      LinearMap.range (Hom.app (M.freeHomEquiv.symm s).val U).hom := by
  rw [Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  exact ⟨sections.eval (freeSection (R := R) i) U,
    congrArg (fun σ ↦ sections.eval σ U) (sectionsMap_freeHomEquiv_symm_freeSection s i)⟩

variable (R I) in
/-- The sheafification of the free presheaf of modules on the constant presheaf of types with
value `I`. -/
noncomputable def sheafifyFreeObj : SheafOfModules.{u} R :=
  (sheafification (𝟙 R.obj)).obj (freeObj ((Functor.const Cᵒᵖ).obj I))

/-- The morphism of sheaves of modules `sheafifyFreeObj R I ⟶ M` attached to a family
`s : I → M.sections` of sections, the adjunct of `PresheafOfModules.freeObjHom`. -/
noncomputable def sheafifyFreeObjDesc : sheafifyFreeObj R I ⟶ M :=
  ((sheafificationAdjunction (𝟙 R.obj)).homEquiv _ _).symm (freeObjHom s)

/-- `PresheafOfModules.freeObjHom` is the composite of the unit of the sheafification adjunction
with `SheafOfModules.sheafifyFreeObjDesc`. Writing `U` for the forgetful functor
`SheafOfModules R ⥤ PresheafOfModules R.obj`, the triangle

```
                    unit.app (freeObj (const I))
  freeObj (const I) ────────────────────────────▶ U (sheafifyFreeObj R I)
          ╲                                                  │
            ╲  freeObjHom s                                  │ U (sheafifyFreeObjDesc s)
              ╲                                              ▼
                ──────────────────────────────────────▶    U M
```

commutes; it is the triangle expressing that `sheafifyFreeObjDesc s` is the adjunct of
`freeObjHom s`. -/
lemma unit_comp_sheafifyFreeObjDesc :
    (sheafificationAdjunction (𝟙 R.obj)).unit.app
        (freeObj (R := R.obj) ((Functor.const Cᵒᵖ).obj I)) ≫
      (forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj)).map
        (sheafifyFreeObjDesc s) = freeObjHom s := by
  have h := Equiv.apply_symm_apply ((sheafificationAdjunction (𝟙 R.obj)).homEquiv
    (freeObj ((Functor.const Cᵒᵖ).obj I)) M) (freeObjHom s)
  rwa [Adjunction.homEquiv_unit] at h

variable (R I) in
/-- The morphism from the free sheaf of modules on `I` to `SheafOfModules.sheafifyFreeObj R I`
classified by the images under the sheafification unit of the tautological sections
`PresheafOfModules.freeObjSection`. -/
noncomputable def freeToSheafifyFreeObj : free (R := R) I ⟶ sheafifyFreeObj R I :=
  (sheafifyFreeObj R I).freeHomEquiv.symm fun i ↦ PresheafOfModules.sectionsMap
    ((sheafificationAdjunction (𝟙 R.obj)).unit.app _) (freeObjSection R.obj I i)

/-- **The morphism `free I ⟶ M` classified by a family of sections factors through
`SheafOfModules.sheafifyFreeObj R I`**: the triangle

```
              freeToSheafifyFreeObj R I
  free I ──────────────────────────────────▶ sheafifyFreeObj R I
         ╲                                            │
           ╲  freeHomEquiv.symm s                     │ sheafifyFreeObjDesc s
             ╲                                        ▼
               ───────────────────────────────────▶   M
```

commutes. -/
lemma freeToSheafifyFreeObj_comp :
    freeToSheafifyFreeObj R I ≫ sheafifyFreeObjDesc s = M.freeHomEquiv.symm s := by
  apply M.freeHomEquiv.injective
  rw [Equiv.apply_symm_apply]
  funext i
  have hfree : (sheafifyFreeObj R I).freeHomEquiv (freeToSheafifyFreeObj R I) i =
      PresheafOfModules.sectionsMap ((sheafificationAdjunction (𝟙 R.obj)).unit.app _)
        (freeObjSection R.obj I i) :=
    congrFun ((sheafifyFreeObj R I).freeHomEquiv.apply_symm_apply _) i
  rw [freeHomEquiv_comp_apply, hfree]
  refine PresheafOfModules.sections_ext _ _ fun V ↦ ?_
  exact (congrArg (fun f ↦ PresheafOfModules.Hom.app f V (ModuleCat.freeMk i))
    (unit_comp_sheafifyFreeObjDesc s)).trans (freeObjHom_app_freeMk s V i)

end Sheafify

end SheafOfModules
