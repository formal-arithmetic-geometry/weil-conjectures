module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Free
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Sheafification
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Adjunctions

/-!
# Sheaves generated by their global sections, and complements on generating sections

Mathlib defines `SheafOfModules.GeneratingSections`, a *choice* of a family of global sections
generating a sheaf of modules. This file turns it into a property:

- `SheafOfModules.IsGloballyGenerated`: a sheaf of modules is generated by its global sections.

Mathlib also defines `SheafOfModules.IsFiniteType` through the existence of
`SheafOfModules.LocalGeneratorsData` whose families of generators are all finite, but does not
record the two elementary ways of producing such data. This file adds them:

- `SheafOfModules.LocalGeneratorsData.isFiniteType`: local generators of finite type witness
  that the sheaf is of finite type;
- `SheafOfModules.GeneratingSections.isFiniteType`: a finite family of global generating
  sections witnesses that the sheaf is of finite type;
- `SheafOfModules.isFiniteType_of_iso`: being of finite type is invariant under isomorphisms.

Finally, a family of global sections `s : I → M.sections` defines a morphism of *presheaves* of
modules `PresheafOfModules.freeObj (const I) ⟶ M` from the free presheaf of modules on the
constant presheaf of types with value `I`, whose sections over an object of the site are the
`R`-linear combinations of the `s i` there. This is the presheaf-level shadow of the morphism
`free I ⟶ M` classified by `s`, and it is the form in which generation by global sections is
usable *locally*:

- `SheafOfModules.freeObjHom`: the morphism of presheaves of modules attached to `s`;
- `SheafOfModules.freeObjHom_app_mem_span`: its image over an object of the site consists of
  `R`-linear combinations of the `s i`;
- `SheafOfModules.epi_sheafifyFreeObjDesc`: if `s` generates `M`, the morphism of sheaves of
  modules obtained from `SheafOfModules.freeObjHom` by sheafification is an epimorphism.

The last statement is what makes `SheafOfModules.freeObjHom` locally surjective, since the unit
of the sheafification adjunction is.
-/

@[expose] public section

universe w u v' u' u₁ v₁

open CategoryTheory Limits

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

namespace SheafOfModules

section GloballyGenerated

variable {M N : SheafOfModules.{u} R}

/-- A sheaf of modules is **generated by its global sections** if it admits a family of
generating global sections, that is, if some free sheaf of modules admits an epimorphism onto
it whose components are global sections.

This is `SheafOfModules.GeneratingSections` turned into a `Prop`. -/
class IsGloballyGenerated (M : SheafOfModules.{u} R) : Prop where
  nonempty_generatingSections : Nonempty M.GeneratingSections

/-- A sheaf of modules is generated by its global sections if and only if it is a quotient of
a free sheaf of modules. -/
theorem isGloballyGenerated_iff_exists :
    M.IsGloballyGenerated ↔ ∃ (I : Type u) (p : free I ⟶ M), Epi p := by
  constructor
  · rintro ⟨⟨σ⟩⟩
    exact ⟨σ.I, σ.π, σ.epi⟩
  · rintro ⟨I, p, hp⟩
    exact ⟨⟨{ I := I, s := M.freeHomEquiv p, epi := by rwa [Equiv.symm_apply_apply] }⟩⟩

/-- A quotient of a sheaf of modules generated by its global sections is generated by its
global sections. -/
theorem IsGloballyGenerated.of_epi (hM : M.IsGloballyGenerated) (p : M ⟶ N) [Epi p] :
    N.IsGloballyGenerated :=
  ⟨hM.nonempty_generatingSections.elim fun σ ↦ ⟨σ.ofEpi p⟩⟩

/-- Being generated by its global sections is invariant under isomorphism. -/
theorem IsGloballyGenerated.of_iso (hM : M.IsGloballyGenerated) (e : M ≅ N) :
    N.IsGloballyGenerated :=
  hM.of_epi e.hom

/-- Isomorphic sheaves of modules are generated by their global sections together. -/
theorem isGloballyGenerated_congr (e : M ≅ N) :
    M.IsGloballyGenerated ↔ N.IsGloballyGenerated :=
  ⟨fun hM ↦ hM.of_iso e, fun hN ↦ hN.of_iso e.symm⟩

end GloballyGenerated

section FreeObj

open PresheafOfModules

variable {M : SheafOfModules.{u} R} {I : Type u} (s : I → M.sections)

/-- A family `s : I → M.sections` of sections of a sheaf of modules, read as a morphism of
presheaves of types from the constant presheaf with value `I`. -/
noncomputable def constToSections :
    (Functor.const Cᵒᵖ).obj I ⟶ M.val.presheaf ⋙ CategoryTheory.forget Ab where
  app _ := ↾fun i ↦ (s i).1 _
  naturality _ _ f := by ext i; simpa using ((s i).2 f).symm

/-- **The morphism of presheaves of modules attached to a family of sections**: the free
presheaf of `R`-modules on the constant presheaf of types with value `I` maps to (the underlying
presheaf of modules of) `M` by sending the tautological element `i` to the section `s i`. -/
noncomputable def freeObjHom :
    PresheafOfModules.freeObj (R := R.obj) ((Functor.const Cᵒᵖ).obj I) ⟶
      (PresheafOfModules.restrictScalars (𝟙 R.obj)).obj ((SheafOfModules.forget R).obj M) :=
  PresheafOfModules.freeObjDesc (constToSections s)

omit [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
@[simp]
lemma freeObjHom_app_freeMk (V : Cᵒᵖ) (i : I) :
    PresheafOfModules.Hom.app (freeObjHom s) V (ModuleCat.freeMk i) =
      PresheafOfModules.sections.eval (s i) V :=
  ModuleCat.freeDesc_apply _ i

omit [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- **The sections of `M` in the image of `SheafOfModules.freeObjHom` are the `R`-linear
combinations of the sections `s i`.** -/
lemma freeObjHom_app_mem_span (V : Cᵒᵖ)
    (u : (PresheafOfModules.freeObj (R := R.obj) ((Functor.const Cᵒᵖ).obj I)).obj V) :
    PresheafOfModules.Hom.app (freeObjHom s) V u ∈
      Submodule.span (R.obj.obj V)
        (Set.range fun i ↦ PresheafOfModules.sections.eval (s i) V) := by
  have hu : u ∈ Submodule.span (R.obj.obj V)
      (Set.range (ModuleCat.freeMk (R := R.obj.obj V) (X := I))) := by
    rw [ModuleCat.span_range_freeMk]; trivial
  refine Submodule.span_mono ?_ (Submodule.apply_mem_span_image_of_mem_span
    (PresheafOfModules.Hom.app (freeObjHom s) V).hom hu)
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  exact ⟨i, (freeObjHom_app_freeMk s V i).symm⟩

section Sheafify

variable [Presheaf.IsLocallyInjective J (𝟙 R.obj)] [Presheaf.IsLocallySurjective J (𝟙 R.obj)]

variable (R I) in
/-- The sheafification of the free presheaf of modules on the constant presheaf with value `I`.

It is isomorphic to `SheafOfModules.free I`, but only the morphism
`SheafOfModules.freeToSheafifyFreeObj` from the latter to it is needed here. -/
noncomputable def sheafifyFreeObj : SheafOfModules.{u} R :=
  (PresheafOfModules.sheafification (𝟙 R.obj)).obj
    (PresheafOfModules.freeObj ((Functor.const Cᵒᵖ).obj I))

/-- The morphism of sheaves of modules `sheafifyFreeObj R I ⟶ M` attached to a family
`s : I → M.sections` of sections, the adjunct of `SheafOfModules.freeObjHom`. -/
noncomputable def sheafifyFreeObjDesc : sheafifyFreeObj R I ⟶ M :=
  ((PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).homEquiv _ _).symm (freeObjHom s)

/-- **`SheafOfModules.freeObjHom` is the composite of the unit of the sheafification adjunction
with `SheafOfModules.sheafifyFreeObjDesc`.** -/
lemma unit_comp_sheafifyFreeObjDesc :
    (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).unit.app
        (PresheafOfModules.freeObj (R := R.obj) ((Functor.const Cᵒᵖ).obj I)) ≫
      (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj)).map
        (sheafifyFreeObjDesc s) = freeObjHom s := by
  have h := Equiv.apply_symm_apply ((PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).homEquiv
    (PresheafOfModules.freeObj ((Functor.const Cᵒᵖ).obj I)) M) (freeObjHom s)
  rwa [Adjunction.homEquiv_unit] at h

variable (R I) in
/-- The tautological sections of the free presheaf of modules on the constant presheaf with
value `I`. -/
noncomputable def freeObjSection (i : I) :
    (PresheafOfModules.freeObj (R := R.obj) ((Functor.const Cᵒᵖ).obj I)).sections :=
  PresheafOfModules.sectionsMk (fun _ ↦ ModuleCat.freeMk i)
    fun _ _ _ ↦ ModuleCat.freeDesc_apply _ i

variable (R I) in
/-- The morphism from the free sheaf of modules on `I` to `SheafOfModules.sheafifyFreeObj R I`
classified by the tautological sections. -/
noncomputable def freeToSheafifyFreeObj : free (R := R) I ⟶ sheafifyFreeObj R I :=
  (sheafifyFreeObj R I).freeHomEquiv.symm fun i ↦ PresheafOfModules.sectionsMap
    ((PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).unit.app _) (freeObjSection R I i)

/-- **The morphism `free I ⟶ M` classified by `s` factors through
`SheafOfModules.sheafifyFreeObj R I`.** -/
lemma freeToSheafifyFreeObj_comp :
    freeToSheafifyFreeObj R I ≫ sheafifyFreeObjDesc s = M.freeHomEquiv.symm s := by
  apply M.freeHomEquiv.injective
  rw [Equiv.apply_symm_apply]
  funext i
  have h1 : (sheafifyFreeObj R I).freeHomEquiv (freeToSheafifyFreeObj R I) i =
      PresheafOfModules.sectionsMap
        ((PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).unit.app _)
        (freeObjSection R I i) :=
    congrFun ((sheafifyFreeObj R I).freeHomEquiv.apply_symm_apply _) i
  rw [freeHomEquiv_comp_apply, h1]
  refine PresheafOfModules.sections_ext _ _ fun V ↦ ?_
  exact (congrArg (fun f ↦ PresheafOfModules.Hom.app f V (ModuleCat.freeMk i))
    (unit_comp_sheafifyFreeObjDesc s)).trans (freeObjHom_app_freeMk s V i)

/-- **A family of generating sections makes `SheafOfModules.sheafifyFreeObjDesc` an
epimorphism**, because the morphism `free I ⟶ M` it classifies factors through it. -/
lemma epi_sheafifyFreeObjDesc [Epi (M.freeHomEquiv.symm s)] : Epi (sheafifyFreeObjDesc s) :=
  have : Epi (freeToSheafifyFreeObj R I ≫ sheafifyFreeObjDesc s) := by
    rw [freeToSheafifyFreeObj_comp]; infer_instance
  epi_of_epi (freeToSheafifyFreeObj R I) _

end Sheafify

end FreeObj


attribute [instance] LocalGeneratorsData.IsFiniteType.isFiniteType

variable [∀ (X : C), HasWeakSheafify (J.over X) AddCommGrpCat.{u}]
  [∀ (X : C), (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]

namespace LocalGeneratorsData

/-- Transporting local generators along an isomorphism of sheaves of modules. -/
@[simps]
noncomputable def ofIsIso {M N : SheafOfModules.{u} R} (f : M ⟶ N) [IsIso f]
    (q : M.LocalGeneratorsData) :
    N.LocalGeneratorsData where
  I := q.I
  X := q.X
  coversTop := q.coversTop
  generators i := (q.generators i).ofEpi (f.over (q.X i))

instance {M N : SheafOfModules.{u} R} (f : M ⟶ N) [IsIso f] (q : M.LocalGeneratorsData)
    [q.IsFiniteType] : (q.ofIsIso f).IsFiniteType where
  isFiniteType i := inferInstanceAs ((q.generators i).ofEpi _).IsFiniteType

instance IsFiniteType.shrink {M : SheafOfModules.{u} R} (q : M.LocalGeneratorsData)
    [q.IsFiniteType] : q.shrink.IsFiniteType where
  isFiniteType i := inferInstanceAs (q.generators i.2.choose).IsFiniteType

omit [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- A sheaf of modules admitting local generators of finite type is of finite type. -/
theorem isFiniteType {M : SheafOfModules.{u} R} (q : M.LocalGeneratorsData) [q.IsFiniteType] :
    M.IsFiniteType :=
  ⟨q.shrink, inferInstance⟩

omit [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The form of `SheafOfModules.LocalGeneratorsData.isFiniteType` which takes the finiteness of
each family of generators as an ordinary hypothesis. -/
theorem isFiniteType_of_forall {M : SheafOfModules.{u} R} (q : M.LocalGeneratorsData)
    (h : ∀ i, (q.generators i).IsFiniteType) : M.IsFiniteType :=
  ⟨q.shrink, ⟨fun i ↦ h i.2.choose⟩⟩

end LocalGeneratorsData

omit [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- Being of finite type is invariant under isomorphisms. -/
theorem isFiniteType_of_iso {M N : SheafOfModules.{u} R} (e : M ≅ N) [M.IsFiniteType] :
    N.IsFiniteType :=
  have ⟨q, _⟩ := IsFiniteType.exists_localGeneratorsData M
  (q.ofIsIso e.hom).isFiniteType

section

variable [∀ (X : C), HasSheafify (J.over X) AddCommGrpCat.{u}] [HasBinaryProducts C]

instance {M : SheafOfModules.{u} R} (G : M.GeneratingSections) [G.IsFiniteType] :
    G.localGeneratorsData.IsFiniteType where
  isFiniteType i := by
    dsimp [GeneratingSections.localGeneratorsData]
    infer_instance

/-- A sheaf of modules generated by finitely many global sections is of finite type. -/
theorem GeneratingSections.isFiniteType {M : SheafOfModules.{u} R} (G : M.GeneratingSections)
    [G.IsFiniteType] : M.IsFiniteType :=
  G.localGeneratorsData.isFiniteType

end

end SheafOfModules
