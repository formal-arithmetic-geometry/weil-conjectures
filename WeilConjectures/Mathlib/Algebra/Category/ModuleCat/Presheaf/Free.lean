module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Free
public import WeilConjectures.Mathlib.Algebra.Category.ModuleCat.Adjunctions
public import WeilConjectures.Mathlib.CategoryTheory.Yoneda

/-!
# The presheaf of modules generated by a family of sections

Let `M` be a presheaf of modules over a presheaf of rings `R` on a category `C`. A family
`s : I → M.sections` of sections of `M` is the same thing as a morphism of presheaves of types
from the constant presheaf with value `I` to the underlying presheaf of types of `M`
(`CategoryTheory.Functor.constHomEquivSections`), hence, by the adjunction defining the free
presheaf of modules, the same thing as a morphism of presheaves of modules
`PresheafOfModules.freeObj (const I) ⟶ M`.

## Main declarations

- `PresheafOfModules.freeObjHom`: the morphism of presheaves of modules attached to `s`.
- `PresheafOfModules.range_freeObjHom_app`: its image over an object of `C` is the submodule
  spanned by the `s i` there.
- `PresheafOfModules.freeObjSection`: the tautological sections of `freeObj (const I)`.
-/

@[expose] public section

universe u v₁ u₁

open CategoryTheory

namespace PresheafOfModules

variable {C : Type u₁} [Category.{v₁} C] {R : Cᵒᵖ ⥤ RingCat.{u}} {M : PresheafOfModules.{u} R}
  {I : Type u} (s : I → M.sections)

/-- The morphism of presheaves of modules attached to a family `s : I → M.sections` of sections:
the free presheaf of `R`-modules on the constant presheaf of types with value `I` maps to `M` by
sending the tautological element `i` to the section `s i`. -/
noncomputable def freeObjHom : freeObj (R := R) ((Functor.const Cᵒᵖ).obj I) ⟶ M :=
  freeObjDesc ((Functor.constHomEquivSections _ _).symm s)

@[simp]
lemma freeObjHom_app_freeMk (V : Cᵒᵖ) (i : I) :
    Hom.app (freeObjHom s) V (ModuleCat.freeMk i) = sections.eval (s i) V :=
  ModuleCat.freeDesc_apply _ i

/-- **The sections of `M` in the image of `PresheafOfModules.freeObjHom` are exactly the
`R`-linear combinations of the sections `s i`.** -/
lemma range_freeObjHom_app (V : Cᵒᵖ) :
    LinearMap.range (Hom.app (freeObjHom s) V).hom =
      Submodule.span (R.obj V) (Set.range fun i ↦ sections.eval (s i) V) := by
  rw [LinearMap.range_eq_map, ← ModuleCat.span_range_freeMk (R.obj V) I, Submodule.map_span,
    ← Set.range_comp]
  exact congrArg _ (congrArg Set.range (funext (freeObjHom_app_freeMk s V)))

variable (R I) in
/-- The tautological sections of the free presheaf of modules on the constant presheaf of types
with value `I`. -/
noncomputable def freeObjSection (i : I) :
    (freeObj (R := R) ((Functor.const Cᵒᵖ).obj I)).sections :=
  sectionsMk (fun _ ↦ ModuleCat.freeMk i) fun _ _ _ ↦ ModuleCat.freeDesc_apply _ i

end PresheafOfModules
