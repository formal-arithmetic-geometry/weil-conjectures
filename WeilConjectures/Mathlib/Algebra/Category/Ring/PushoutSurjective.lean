module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Pushouts along surjections of commutative rings

A commutative square of commutative rings whose two legs out of the corner opposite the source
are surjective is a pushout as soon as the kernels match up: the cokernel side is
`B ⧸ f(ker g)`.

## Main results

- `CommRingCat.isPushout_of_surjective`
-/

@[expose] public section

universe u

open CategoryTheory

namespace CommRingCat

/-- A commutative square of rings `f ≫ inl = g ≫ inr` in which `g` and `inl` are surjective and
the kernel of `inl` lies in the ideal generated by the image of the kernel of `g` is a pushout:
`P = B ⧸ f(ker g)` is the base change of `C = A ⧸ ker g` along `f`. -/
lemma isPushout_of_surjective {A B C P : CommRingCat.{u}} (f : A ⟶ B) (g : A ⟶ C)
    (inl : B ⟶ P) (inr : C ⟶ P) (w : f ≫ inl = g ≫ inr) (hg : Function.Surjective g)
    (hinl : Function.Surjective inl)
    (hker : RingHom.ker inl.hom ≤ (RingHom.ker g.hom).map f.hom) :
    IsPushout f g inl inr := by
  have hle : ∀ s : Limits.PushoutCocone f g, RingHom.ker inl.hom ≤ RingHom.ker s.inl.hom := by
    intro s
    refine hker.trans (Ideal.map_le_iff_le_comap.mpr fun a ha ↦ ?_)
    rw [Ideal.mem_comap, RingHom.mem_ker, ← CommRingCat.comp_apply, s.condition,
      CommRingCat.comp_apply, RingHom.mem_ker.mp ha, map_zero]
  let desc : ∀ s : Limits.PushoutCocone f g, P ⟶ s.pt := fun s ↦
    ofHom (inl.hom.liftOfSurjective hinl ⟨s.inl.hom, hle s⟩)
  have hdesc : ∀ (s : Limits.PushoutCocone f g) (y : B), desc s (inl y) = s.inl y :=
    fun s y ↦ RingHom.liftOfSurjective_comp_apply _ hinl ⟨s.inl.hom, hle s⟩ y
  refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk _ desc (fun s ↦ ?_)
    (fun s ↦ ?_) (fun s m hl _ ↦ ?_))
  · ext x
    exact hdesc s x
  · ext x
    obtain ⟨y, rfl⟩ := hg x
    have h1 : inr (g y) = inl (f y) := by
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, w]
    have h2 : s.inr (g y) = s.inl (f y) := by
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, s.condition]
    change desc s (inr (g y)) = s.inr (g y)
    rw [h1, h2, hdesc]
  · ext x
    obtain ⟨y, rfl⟩ := hinl x
    change m (inl y) = desc s (inl y)
    rw [hdesc, ← CommRingCat.comp_apply, hl]

end CommRingCat
