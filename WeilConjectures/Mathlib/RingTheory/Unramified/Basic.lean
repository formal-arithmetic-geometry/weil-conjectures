module

public import Mathlib.RingTheory.Unramified.Basic
public import Mathlib.RingTheory.Ideal.IdempotentFG

/-!
# The diagonal of an unramified algebra is open and closed

For an unramified `R`-algebra `S` of finite type, the kernel of the multiplication map
`S ⊗[R] S → S` is generated by an idempotent.
-/

@[expose] public section

open TensorProduct

/-- For an unramified algebra `S` of finite type over `R`, the kernel of the multiplication map
`S ⊗[R] S → S` is generated by an idempotent: the diagonal is open and closed. -/
lemma Algebra.FormallyUnramified.exists_isIdempotentElem_ker_lmul' (R S : Type*) [CommRing R]
    [CommRing S] [Algebra R S] [Algebra.FormallyUnramified R S] [Algebra.EssFiniteType R S] :
    ∃ e : S ⊗[R] S, IsIdempotentElem e ∧
      RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S) = Ideal.span {e} :=
  (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg R S)).mp
    ((Ideal.cotangent_subsingleton_iff _).mp (inferInstanceAs (Subsingleton (Ω[S⁄R]))))
