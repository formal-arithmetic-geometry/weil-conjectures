module

public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.Unramified.Basic

/-!
# Sections of unramified algebras

If `S` is a formally unramified, finitely presented `R`-algebra and `σ : S →ₐ[R] R` is a section,
then the kernel of `σ` is generated by an idempotent: geometrically, a section of an unramified
morphism is an open and closed immersion.

## Main statements

- `Algebra.FormallyUnramified.exists_isIdempotentElem_ker_eq_span`
-/

@[expose] public section

namespace Algebra.FormallyUnramified

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The kernel `K` of a section `σ : S →ₐ[R] R` of a formally unramified algebra is idempotent:
the two maps `S ⟶ S / K²`, the quotient map and `s ↦ σ(s)`, agree modulo the square-zero ideal
`K / K²`, hence agree, so `s - σ(s) ∈ K²` for every `s`. -/
lemma ker_le_ker_sq_of_section [FormallyUnramified R S] (σ : S →ₐ[R] R) :
    RingHom.ker σ ≤ RingHom.ker σ ^ 2 := by
  set K := RingHom.ker σ
  set N : Ideal (S ⧸ K ^ 2) := K.map (Ideal.Quotient.mk (K ^ 2))
  have hN : N ^ 2 = ⊥ := by
    rw [← Ideal.map_pow, Ideal.map_quotient_self]
  have key := FormallyUnramified.comp_injective (R := R) (A := S) N hN
    (a₁ := Ideal.Quotient.mkₐ R (K ^ 2)) (a₂ := (Algebra.ofId R (S ⧸ K ^ 2)).comp σ) (by
      ext x
      change Ideal.Quotient.mk N (Ideal.Quotient.mk (K ^ 2) x) =
        Ideal.Quotient.mk N (Ideal.Quotient.mk (K ^ 2) (algebraMap R S (σ x)))
      rw [Ideal.Quotient.eq, ← map_sub]
      refine Ideal.mem_map_of_mem _ ?_
      rw [RingHom.mem_ker, map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply,
        sub_self])
  intro x hx
  have := congr($key x)
  simp only [Ideal.Quotient.mkₐ_eq_mk, AlgHom.comp_apply, Algebra.ofId_apply] at this
  rw [RingHom.mem_ker.mp hx, map_zero] at this
  exact Ideal.Quotient.eq_zero_iff_mem.mp this

/-- **A section of an unramified algebra is open and closed.** If `S` is formally unramified and
finitely presented over `R`, the kernel of an `R`-algebra section `σ : S →ₐ[R] R` is generated by
an idempotent. -/
theorem exists_isIdempotentElem_ker_eq_span [FormallyUnramified R S] [FinitePresentation R S]
    (σ : S →ₐ[R] R) : ∃ e : S, IsIdempotentElem e ∧ RingHom.ker σ = Ideal.span {e} := by
  have hfg : (RingHom.ker σ).FG :=
    FinitePresentation.ker_fG_of_surjective σ fun r ↦ ⟨algebraMap R S r, σ.commutes r⟩
  refine (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp ?_
  refine le_antisymm Ideal.mul_le_left ?_
  rw [← pow_two]
  exact ker_le_ker_sq_of_section σ

end Algebra.FormallyUnramified
