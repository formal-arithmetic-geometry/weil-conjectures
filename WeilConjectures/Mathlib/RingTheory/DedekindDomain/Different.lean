public import Mathlib.RingTheory.DedekindDomain.Different
public import Mathlib.RingTheory.Etale.Field
public import Mathlib.RingTheory.Etale.Kaehler
public import WeilConjectures.Mathlib.RingTheory.Conductor

/-!
# The Kähler different of a finite extension of Dedekind domains

Let `k` be a field and `A → B` a finite torsion-free extension of Dedekind domains over `k`, with
fraction fields `K ⊆ L`, `L / K` separable. Assume that `Ω_{A/k}` is free on `dt` for some `t : A`,
and that `Ω_{B/k}` is locally generated by one element (e.g. `B` is smooth of relative dimension one
over `k`). Then `Ω_{L/k} = L dt`, and dividing by `dt` gives a `B`-linear map
`ι : Ω_{B/k} → L`. We show that its image is the inverse different
`𝔇⁻¹ = {y ∈ L | Tr(y B) ⊆ A}` (`Submodule.traceDual A K 1`), provided the residue field
extensions are separable. This is Dedekind's theorem that the different is the Kähler different.

Locally at a maximal ideal `q` of `B` we choose `x : B` with conductor `s ∉ q`
(`Ideal.exists_not_conductor_le`), so that `L = K(x)` and `B_q = A[x]_q`. By Euler's formula the
inverse different of `A[x]` is `f'(x)⁻¹ A[x]` (`traceForm_dualSubmodule_adjoin`), where `f` is the
minimal polynomial of `x`, and `d x / d t = -f^∂(x) / f'(x)` where `f^∂` differentiates the
coefficients of `f`. Smoothness forces `f'(x)` or `f^∂(x)` to be a unit at `q`: otherwise the two
derivations `P(x) ↦ P^∂(x)` and `P(x) ↦ P'(x)` modulo `q` would make `Ω_{B/k} ⊗ κ(q)`
two-dimensional.

## Main definitions

- `Polynomial.mapCoeffsLinear`: apply a linear map to the coefficients of a polynomial.
- `KaehlerDifferential.toFractionRing`: the map `ι : Ω_{B/k} → L`, `ω ↦ ω / dt`.

## Main statements

- `KaehlerDifferential.range_toFractionRing`: the image of `ι` is the inverse different.
-/

@[expose] public section

open Polynomial

namespace Polynomial

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]

/-- Apply a `k`-linear map `d : A → A` to the coefficients of a polynomial. -/
noncomputable def mapCoeffsLinear (d : A →ₗ[k] A) : A[X] →ₗ[k] A[X] :=
  lsum fun n ↦ (monomial n).restrictScalars k ∘ₗ d

@[simp]
lemma mapCoeffsLinear_monomial (d : A →ₗ[k] A) (n : ℕ) (a : A) :
    mapCoeffsLinear d (monomial n a) = monomial n (d a) := by
  simp [mapCoeffsLinear, lsum_apply]

/-- Applying a derivation `d` to the coefficients is a derivation of `A[X]`. -/
lemma mapCoeffsLinear_mul (d : A →ₗ[k] A) (hd : ∀ a b, d (a * b) = a * d b + b * d a)
    (P Q : A[X]) :
    mapCoeffsLinear d (P * Q) = P * mapCoeffsLinear d Q + Q * mapCoeffsLinear d P := by
  induction P using Polynomial.induction_on' with
  | add P₁ P₂ h₁ h₂ => simp only [add_mul, map_add, h₁, h₂]; ring
  | monomial i a =>
    induction Q using Polynomial.induction_on' with
    | add Q₁ Q₂ h₁ h₂ => simp only [mul_add, map_add, h₁, h₂]; ring
    | monomial j b =>
      simp only [monomial_mul_monomial, mapCoeffsLinear_monomial, hd, map_add, add_comm j i]

end Polynomial

namespace Derivation

variable {k A B L : Type*} [CommRing k] [CommRing A] [CommRing B] [CommRing L] [Algebra k A]
  [Algebra k B] [Algebra A B] [Algebra B L] [Algebra k L]

/-- The chain rule for a derivation `δ : B → L` on `P(y)` for a polynomial `P` over `A`, when `δ`
acts on `A` through a linear map `d : A → A`: `δ(P(y)) = P^d(y) + P'(y) δ(y)`. -/
lemma apply_aeval (δ : Derivation k B L) (d : A →ₗ[k] A)
    (hδ : ∀ a, δ (algebraMap A B a) = algebraMap B L (algebraMap A B (d a))) (y : B) (P : A[X]) :
    δ (aeval y P) = algebraMap B L (aeval y (mapCoeffsLinear d P)) +
      algebraMap B L (aeval y (derivative P)) * δ y := by
  induction P using Polynomial.induction_on' with
  | add P Q hP hQ => simp only [map_add, hP, hQ, add_mul]; ring
  | monomial n a =>
    rw [aeval_monomial, mapCoeffsLinear_monomial, aeval_monomial, derivative_monomial,
      aeval_monomial, Derivation.leibniz, Derivation.leibniz_pow, hδ]
    rw [nsmul_eq_mul]
    have : algebraMap B L (algebraMap A B (n : A)) = (n : L) := by simp
    simp only [Algebra.smul_def, map_mul, map_pow, this]
    ring

end Derivation

namespace Derivation

variable {k B : Type*} [CommRing k] [CommRing B] [Algebra k B] (q : Ideal B) [q.IsMaximal]

/-- Let `C ⊆ B` and `s ∈ C` with `s B ⊆ C` and `s ∉ q`. A `k`-derivation `e : C → B / q` (with
`C` acting through `B → B / q`) extends to a derivation of `B`, namely
`b ↦ s⁻¹ (e(s b) - b e(s))`. -/
lemma exists_extend_of_mul_mem (C : Subalgebra k B) (s : B) (hsC : s ∈ C) (hsq : s ∉ q)
    (hs : ∀ b, s * b ∈ C) (e : C →ₗ[k] B ⧸ q)
    (he : ∀ c₁ c₂ : C,
      e (c₁ * c₂) = Ideal.Quotient.mk q c₁ * e c₂ + Ideal.Quotient.mk q c₂ * e c₁) :
    ∃ E : Derivation k B (B ⧸ q), ∀ c : C, E c = e c := by
  let := Ideal.Quotient.field q
  have hs0 : Ideal.Quotient.mk q s ≠ 0 := by rwa [ne_eq, Ideal.Quotient.eq_zero_iff_mem]
  have hmk (a : k) (b : B) : Ideal.Quotient.mk q (a • b) = a • Ideal.Quotient.mk q b := by
    simp [Algebra.smul_def, Ideal.Quotient.mk_algebraMap]
  let f : B →ₗ[k] B ⧸ q :=
    { toFun b := (Ideal.Quotient.mk q s)⁻¹ *
        (e ⟨s * b, hs b⟩ - Ideal.Quotient.mk q b * e ⟨s, hsC⟩)
      map_add' b b' := by
        have : (⟨s * (b + b'), hs _⟩ : C) = ⟨s * b, hs b⟩ + ⟨s * b', hs b'⟩ := by
          ext; simp [mul_add]
        rw [this, map_add, map_add]
        ring
      map_smul' a b := by
        have : (⟨s * (a • b), hs _⟩ : C) = a • ⟨s * b, hs b⟩ := by
          ext; simp
        rw [this, hmk, RingHom.id_apply]
        erw [e.map_smul]
        simp only [Algebra.smul_def]
        ring }
  have hf (b : B) : f b = (Ideal.Quotient.mk q s)⁻¹ *
      (e ⟨s * b, hs b⟩ - Ideal.Quotient.mk q b * e ⟨s, hsC⟩) := rfl
  refine ⟨Derivation.mk' f fun b₁ b₂ ↦ ?_, fun c ↦ ?_⟩
  · have h₁ := he ⟨s, hsC⟩ ⟨s * (b₁ * b₂), hs _⟩
    have h₂ := he ⟨s * b₁, hs b₁⟩ ⟨s * b₂, hs b₂⟩
    have : (⟨s, hsC⟩ * ⟨s * (b₁ * b₂), hs _⟩ : C) = ⟨s * b₁, hs b₁⟩ * ⟨s * b₂, hs b₂⟩ := by
      ext; simp only [Subalgebra.coe_mul]; ring
    rw [this, h₂] at h₁
    simp only [map_mul] at h₁
    rw [hf, hf, hf, Algebra.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
    set E₁₂ := e ⟨s * (b₁ * b₂), hs _⟩
    set E₁ := e ⟨s * b₁, hs b₁⟩
    set E₂ := e ⟨s * b₂, hs b₂⟩
    set Eₛ := e ⟨s, hsC⟩
    set u := Ideal.Quotient.mk q s
    clear_value E₁₂ E₁ E₂ Eₛ u
    have h₁' : Ideal.Quotient.mk q b₁ * E₂ + Ideal.Quotient.mk q b₂ * E₁ =
        E₁₂ + Ideal.Quotient.mk q b₁ * Ideal.Quotient.mk q b₂ * Eₛ :=
      mul_left_cancel₀ hs0 (by linear_combination h₁)
    field_simp
    linear_combination (-1 : B ⧸ q) * h₁'
  · have h₁ := he ⟨s, hsC⟩ c
    have : (⟨s, hsC⟩ * c : C) = ⟨s * c, hs c⟩ := rfl
    rw [this] at h₁
    change f c = e c
    rw [hf, h₁]
    field_simp
    ring

end Derivation

namespace KaehlerDifferential

variable {k A B : Type*} [Field k] [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]
  [Algebra A B] [IsScalarTower k A B]

/-- A `k`-linear map `e₀ : A[X] → B / q` satisfying the Leibniz rule with respect to evaluation at
`x` and vanishing on the minimal polynomial of `x` descends to `A[x]`. -/
lemma exists_linearMap_adjoin_of_aeval [IsDomain A] [IsIntegrallyClosed A] [IsDomain B]
    [Module.IsTorsionFree A B] (q : Ideal B) {x : B} (hx : IsIntegral A x)
    (e₀ : A[X] →ₗ[k] B ⧸ q)
    (he₀ : ∀ P Q, e₀ (P * Q) =
      Ideal.Quotient.mk q (aeval x P) * e₀ Q + Ideal.Quotient.mk q (aeval x Q) * e₀ P)
    (hm : e₀ (minpoly A x) = 0) :
    ∃ e : (Algebra.adjoin A {x}).restrictScalars k →ₗ[k] B ⧸ q,
      (∀ c₁ c₂, e (c₁ * c₂) =
        Ideal.Quotient.mk q c₁ * e c₂ + Ideal.Quotient.mk q c₂ * e c₁) ∧
      ∀ (P : A[X]) (c : (Algebra.adjoin A {x}).restrictScalars k), (c : B) = aeval x P →
        e c = e₀ P := by
  have hwd (P Q : A[X]) (h : aeval x P = aeval x Q) : e₀ P = e₀ Q := by
    obtain ⟨R, hR⟩ := minpoly.isIntegrallyClosed_dvd hx (p := P - Q) (by simp [h])
    rw [← sub_eq_zero, ← map_sub, hR, he₀, hm, minpoly.aeval]
    simp
  have hrep (c : (Algebra.adjoin A {x}).restrictScalars k) : ∃ P : A[X], aeval x P = c := by
    have : (c : B) ∈ (aeval (R := A) x).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact c.2
    exact this
  choose P hP using hrep
  let e : (Algebra.adjoin A {x}).restrictScalars k →ₗ[k] B ⧸ q :=
    { toFun c := e₀ (P c)
      map_add' c₁ c₂ := by
        rw [← map_add]
        exact hwd _ _ (by simp [hP])
      map_smul' a c := by
        rw [RingHom.id_apply, ← map_smul]
        exact hwd _ _ (by simp [hP, Algebra.smul_def, ← IsScalarTower.algebraMap_apply]) }
  have he (c) : e c = e₀ (P c) := rfl
  refine ⟨e, fun c₁ c₂ ↦ ?_, fun Q c hc ↦ (he c).trans (hwd _ _ ((hP c).trans hc))⟩
  rw [he, he, he, hwd (P (c₁ * c₂)) (P c₁ * P c₂) (by simp [hP]), he₀, hP, hP]

/-- **Smoothness forces a Jacobian minor to be a unit.** Let `d : A → A` be a `k`-derivation with
`d t = 1`, let `x : B` be integral over `A` with minimal polynomial `f` and a conductor element
`s ∉ q`, and assume `Ω_{B/k}` is generated by one element near `q`. Then `f'(x) ∉ q` or
`f^d(x) ∉ q`, where `f^d` applies `d` to the coefficients of `f`. -/
lemma aeval_derivative_notMem_or [IsDomain A] [IsIntegrallyClosed A] [IsDomain B]
    [Module.IsTorsionFree A B] (q : Ideal B) [q.IsMaximal] (d : A →ₗ[k] A)
    (hd : ∀ a b, d (a * b) = a * d b + b * d a) (t : A) (ht : d t = 1) {x : B}
    (hx : IsIntegral A x) {s : B} (hs : s ∈ conductor A x) (hsq : s ∉ q)
    (hΩ : ∃ s₀ ∉ q, ∃ ω₀ : Ω[B⁄k], ∀ ω : Ω[B⁄k], ∃ c : B, s₀ • ω = c • ω₀) :
    aeval x (derivative (minpoly A x)) ∉ q ∨
      aeval x (mapCoeffsLinear d (minpoly A x)) ∉ q := by
  by_contra! h
  obtain ⟨h₁, h₂⟩ := h
  let := Ideal.Quotient.field q
  let Ck := (Algebra.adjoin A {x}).restrictScalars k
  have hsC : s ∈ Ck := by
    simpa [Ck] using conductor_subset_adjoin hs
  have hs' (b : B) : s * b ∈ Ck := by
    simpa [Ck] using (mem_conductor_iff.1 hs) b
  -- The two derivations `P(x) ↦ P^d(x)` and `P(x) ↦ P'(x)` modulo `q`.
  let ev : A[X] →ₗ[k] B ⧸ q :=
    (Ideal.Quotient.mkₐ k q).toLinearMap ∘ₗ ((aeval x).restrictScalars k).toLinearMap
  have hev (P : A[X]) : ev P = Ideal.Quotient.mk q (aeval x P) := rfl
  let e₁ : A[X] →ₗ[k] B ⧸ q := ev ∘ₗ mapCoeffsLinear d
  let e₂ : A[X] →ₗ[k] B ⧸ q := ev ∘ₗ (derivative (R := A)).restrictScalars k
  have he₁ : ∀ P Q, e₁ (P * Q) =
      Ideal.Quotient.mk q (aeval x P) * e₁ Q + Ideal.Quotient.mk q (aeval x Q) * e₁ P := by
    intro P Q
    change Ideal.Quotient.mk q (aeval x (mapCoeffsLinear d (P * Q))) = _ * Ideal.Quotient.mk q
      (aeval x (mapCoeffsLinear d Q)) + _ * Ideal.Quotient.mk q (aeval x (mapCoeffsLinear d P))
    rw [mapCoeffsLinear_mul d hd]
    simp only [map_add, map_mul]
  have he₂ : ∀ P Q, e₂ (P * Q) =
      Ideal.Quotient.mk q (aeval x P) * e₂ Q + Ideal.Quotient.mk q (aeval x Q) * e₂ P := by
    intro P Q
    change Ideal.Quotient.mk q (aeval x (derivative (P * Q))) = _ * Ideal.Quotient.mk q
      (aeval x (derivative Q)) + _ * Ideal.Quotient.mk q (aeval x (derivative P))
    rw [derivative_mul]
    simp only [map_add, map_mul]
    ring
  obtain ⟨f₁, hf₁, hf₁'⟩ := exists_linearMap_adjoin_of_aeval (k := k) q hx e₁ he₁
    (by simpa [e₁, hev, Ideal.Quotient.eq_zero_iff_mem] using h₂)
  obtain ⟨f₂, hf₂, hf₂'⟩ := exists_linearMap_adjoin_of_aeval (k := k) q hx e₂ he₂
    (by simpa [e₂, hev, Ideal.Quotient.eq_zero_iff_mem] using h₁)
  obtain ⟨E₁, hE₁⟩ := Derivation.exists_extend_of_mul_mem q Ck s hsC hsq hs' f₁ hf₁
  obtain ⟨E₂, hE₂⟩ := Derivation.exists_extend_of_mul_mem q Ck s hsC hsq hs' f₂ hf₂
  have htC : algebraMap A B t ∈ Ck := Subalgebra.algebraMap_mem _ t
  have hxC : x ∈ Ck := Algebra.self_mem_adjoin_singleton A x
  have hd1 : d 1 = 0 := by simpa using hd 1 1
  have v₁t : E₁ (algebraMap A B t) = 1 := by
    rw [hE₁ ⟨_, htC⟩, hf₁' (C t) _ (by simp)]
    simp [e₁, hev, ← monomial_zero_left, ht]
  have v₂t : E₂ (algebraMap A B t) = 0 := by
    rw [hE₂ ⟨_, htC⟩, hf₂' (C t) _ (by simp)]
    simp [e₂, hev]
  have v₁x : E₁ x = 0 := by
    rw [hE₁ ⟨_, hxC⟩, hf₁' X _ (by simp)]
    simp [e₁, hev, ← monomial_one_one_eq_X, hd1]
  have v₂x : E₂ x = 1 := by
    rw [hE₂ ⟨_, hxC⟩, hf₂' X _ (by simp)]
    simp [e₂, hev]
  obtain ⟨s₀, hs₀q, ω₀, hω₀⟩ := hΩ
  obtain ⟨c₁, hc₁⟩ := hω₀ (D k B (algebraMap A B t))
  obtain ⟨c₂, hc₂⟩ := hω₀ (D k B x)
  have hs₀ : Ideal.Quotient.mk q s₀ ≠ 0 := by rwa [ne_eq, Ideal.Quotient.eq_zero_iff_mem]
  have k₁ := congr(E₁.liftKaehlerDifferential $hc₁)
  have k₂ := congr(E₂.liftKaehlerDifferential $hc₁)
  have k₃ := congr(E₁.liftKaehlerDifferential $hc₂)
  have k₄ := congr(E₂.liftKaehlerDifferential $hc₂)
  simp only [map_smul, Derivation.liftKaehlerDifferential_comp_D, v₁t, v₂t, v₁x, v₂x,
    Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one, mul_zero] at k₁ k₂ k₃ k₄
  have hc₁0 : Ideal.Quotient.mk q c₁ ≠ 0 := fun h ↦ hs₀ (by rw [k₁, h, zero_mul])
  have : E₂.liftKaehlerDifferential ω₀ = 0 := by
    simpa [hc₁0] using k₂.symm
  apply hs₀
  rw [k₄, this, mul_zero]

end KaehlerDifferential
