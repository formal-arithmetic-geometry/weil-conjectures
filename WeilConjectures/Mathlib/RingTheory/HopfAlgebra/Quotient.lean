module

public import Mathlib.RingTheory.Bialgebra.Convolution
public import Mathlib.RingTheory.HopfAlgebra.GroupLike
public import Mathlib.RingTheory.HopfAlgebra.Quotient

/-!
# Convolution products of algebra homomorphisms killing a Hopf ideal

If two algebra homomorphisms out of a Hopf algebra `A` vanish on a Hopf ideal `I`, then so does
their convolution product: both factor through the quotient Hopf algebra `A ⧸ I`, and the
quotient map is a bialgebra homomorphism.

## Blueprint

- `sk-d-geometry`: the points of a closed subgroup scheme `V(I)` of an affine group scheme form a
  subgroup.
-/

@[expose] public section

open WithConv

variable {R A B : Type*} [CommRing R] [CommRing A] [HopfAlgebra R A] [CommRing B] [Algebra R B]

namespace Ideal.IsHopfIdeal

/-- The zero ideal is a Hopf ideal. -/
instance bot : (⊥ : Ideal A).IsHopfIdeal R where
  counit_eq_zero x hx := by simp_all
  map_mkQ_comul_eq_zero x hx := by
    rw [Submodule.restrictScalars_mem, Ideal.mem_bot] at hx
    rw [hx, map_zero, map_zero]
  antipode_mem x hx := by simp_all

/-- The convolution product of two algebra homomorphisms vanishing on a Hopf ideal vanishes on
it. (blueprint: `sk-d-geometry`) -/
theorem convMul_apply_eq_zero {I : Ideal A} [I.IsHopfIdeal R] {f g : A →ₐ[R] B}
    (hf : ∀ a ∈ I, f a = 0) (hg : ∀ a ∈ I, g a = 0) {a : A} (ha : a ∈ I) :
    (toConv f * toConv g) a = 0 := by
  let q : A →ₐc[R] A ⧸ I := Bialgebra.Quotient.mkBialgHom I
  have hf' : f = (Ideal.Quotient.liftₐ I f hf).comp (q : A →ₐ[R] A ⧸ I) := by ext; rfl
  have hg' : g = (Ideal.Quotient.liftₐ I g hg).comp (q : A →ₐ[R] A ⧸ I) := by ext; rfl
  rw [hf', hg', ← AlgHom.convMul_comp_bialgHom_distrib]
  have : q a = 0 := Ideal.Quotient.eq_zero_iff_mem.2 ha
  simp [this]

open Coalgebra in
/-- The ideal generated by a set `s` of elements of a commutative Hopf algebra is a Hopf ideal as
soon as every generator `a` satisfies `ε(a) = 0`, `S(a) ∈ (s)`, and `Δ(a)` vanishes in
`A ⧸ (s) ⊗ A ⧸ (s)`. -/
theorem of_span {s : Set A} (hε : ∀ a ∈ s, counit (R := R) a = 0)
    (hΔ : ∀ a ∈ s, Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R (Ideal.span s))
      (Ideal.Quotient.mkₐ R (Ideal.span s)) (comul (R := R) a) = 0)
    (hS : ∀ a ∈ s, HopfAlgebra.antipode R a ∈ Ideal.span s) :
    (Ideal.span s).IsHopfIdeal R where
  counit_eq_zero x hx := by
    rw [Submodule.restrictScalars_mem] at hx
    induction hx using Submodule.span_induction with
    | mem a ha => exact hε a ha
    | zero => simp
    | add x y _ _ hx hy => simp [hx, hy]
    | smul r x _ hx =>
      rw [smul_eq_mul, ← Bialgebra.counitAlgHom_apply, map_mul, Bialgebra.counitAlgHom_apply, hx,
        mul_zero]
  map_mkQ_comul_eq_zero x hx := by
    change Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R (Ideal.span s))
      (Ideal.Quotient.mkₐ R (Ideal.span s)) (comul (R := R) x) = 0
    rw [Submodule.restrictScalars_mem] at hx
    induction hx using Submodule.span_induction with
    | mem a ha => exact hΔ a ha
    | zero => simp
    | add x y _ _ hx hy => simp [hx, hy]
    | smul r x _ hx =>
      rw [smul_eq_mul, ← Bialgebra.comulAlgHom_apply, map_mul, map_mul,
        Bialgebra.comulAlgHom_apply, hx, mul_zero]
  antipode_mem x hx := by
    induction hx using Submodule.span_induction with
    | mem a ha => exact hS a ha
    | zero => simp
    | add x y _ _ hx hy => simpa using Ideal.add_mem _ hx hy
    | smul r x _ hx =>
      rw [smul_eq_mul, HopfAlgebra.antipode_mul_distrib]
      exact Ideal.mul_mem_left _ _ hx

/-- For a group-like element `g`, the ideal `(g - 1)` is a Hopf ideal. -/
theorem span_singleton_sub_one {g : A} (hg : IsGroupLikeElem R g) :
    (Ideal.span {g - 1}).IsHopfIdeal R := by
  have hq : Ideal.Quotient.mkₐ R (Ideal.span {g - 1}) g = 1 := by
    rw [← sub_eq_zero, ← map_one (Ideal.Quotient.mkₐ R _), ← map_sub, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span rfl
  refine of_span ?_ ?_ ?_ <;> simp only [Set.mem_singleton_iff, forall_eq]
  · simp [hg.counit_eq_one]
  · simp [hg.comul_eq_tmul_self, hq, Algebra.TensorProduct.one_def]
  · have : HopfAlgebra.antipode R (g - 1) = -HopfAlgebra.antipode R g * (g - 1) := by
      rw [map_sub, HopfAlgebra.antipode_one, neg_mul, mul_sub, hg.antipode_mul_cancel, mul_one,
        neg_sub]
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

open Coalgebra in
/-- For a primitive element `x`, with `Δ(x) = x ⊗ 1 + 1 ⊗ x`, `ε(x) = 0` and `S(x) = -x`, the
ideal `(x)` is a Hopf ideal. -/
theorem span_singleton_of_comul_eq {x : A} (hΔ : comul (R := R) x = x ⊗ₜ 1 + 1 ⊗ₜ x)
    (hε : counit (R := R) x = 0) (hS : HopfAlgebra.antipode R x = -x) :
    (Ideal.span {x}).IsHopfIdeal R := by
  have hq : Ideal.Quotient.mkₐ R (Ideal.span {x}) x = 0 := by
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span rfl
  refine of_span ?_ ?_ ?_ <;> simp only [Set.mem_singleton_iff, forall_eq]
  · exact hε
  · simp [hΔ, hq]
  · rw [hS]
    exact Ideal.neg_mem_iff.2 (Ideal.subset_span rfl)

end Ideal.IsHopfIdeal
