public import Mathlib.RingTheory.Bialgebra.Convolution
public import Mathlib.RingTheory.HopfAlgebra.GroupLike
public import Mathlib.RingTheory.HopfAlgebra.Quotient
public import WeilConjectures.Mathlib.RingTheory.TensorProduct.Maps

/-!
# Convolution products of algebra homomorphisms killing a Hopf ideal

If two algebra homomorphisms out of a Hopf algebra `A` vanish on a Hopf ideal `I`, then so does
their convolution product: both factor through the quotient Hopf algebra `A ⧸ I`, and the
quotient map is a bialgebra homomorphism.

An ideal generated by a set `s` is a Hopf ideal as soon as the Hopf ideal conditions hold on `s`
(`Ideal.isHopfIdeal_span`). In particular `(g - 1)` is a Hopf ideal for a group-like element `g`
(`IsGroupLikeElem.isHopfIdeal_span_sub_one`) and `(q)` is a Hopf ideal for a primitive element `q`
(`Ideal.isHopfIdeal_span_singleton_of_comul_eq`).

## Blueprint

- `sk-d-geometry`: the points of a closed subgroup scheme `V(I)` of an affine group scheme form a
  subgroup.
- `def-sc-gm-ga`, `def-sc-general-linear-group`: the ideals `(t^n - 1)`, `(y^p)` and `(det - 1)`
  cutting out `μ_n`, `α_p` and `SL_n` are Hopf ideals.
-/

@[expose] public section

open WithConv

variable {R A B : Type*} [CommRing R] [CommRing A] [HopfAlgebra R A] [CommRing B] [Algebra R B]

namespace Ideal.IsHopfIdeal

/-- The zero ideal is a Hopf ideal. -/
instance bot : (⊥ : Ideal A).IsHopfIdeal R where
  counit_eq_zero x hx := by simp_all
  map_mkQ_comul_eq_zero x hx := by
    rw [Submodule.restrictScalars_mem, Ideal.mem_bot] at hx
    rw [hx, map_zero, map_zero]
  antipode_mem x hx := by simp_all

/-- The convolution product of two algebra homomorphisms vanishing on a Hopf ideal vanishes on
it. (blueprint: `sk-d-geometry`) -/
theorem convMul_apply_eq_zero {I : Ideal A} [I.IsHopfIdeal R] {f g : A →ₐ[R] B}
    (hf : ∀ a ∈ I, f a = 0) (hg : ∀ a ∈ I, g a = 0) {a : A} (ha : a ∈ I) :
    (toConv f * toConv g) a = 0 := by
  let q : A →ₐc[R] A ⧸ I := Bialgebra.Quotient.mkBialgHom I
  have hf' : f = (Ideal.Quotient.liftₐ I f hf).comp (q : A →ₐ[R] A ⧸ I) := by ext; rfl
  have hg' : g = (Ideal.Quotient.liftₐ I g hg).comp (q : A →ₐ[R] A ⧸ I) := by ext; rfl
  rw [hf', hg', ← AlgHom.convMul_comp_bialgHom_distrib]
  have : q a = 0 := Ideal.Quotient.eq_zero_iff_mem.2 ha
  simp [this]

end Ideal.IsHopfIdeal

open Coalgebra HopfAlgebra TensorProduct

namespace Ideal

/-- An ideal generated by a set `s` is a Hopf ideal as soon as the counit vanishes on `s`, the
comultiplication maps `s` to zero in `(A ⧸ I) ⊗ (A ⧸ I)` and the antipode maps `s` into the
ideal. -/
theorem isHopfIdeal_span {s : Set A} (counit_eq_zero : ∀ x ∈ s, counit (R := R) x = 0)
    (comul_eq_zero : ∀ x ∈ s, Algebra.TensorProduct.map (Quotient.mkₐ R (span s))
      (Quotient.mkₐ R (span s)) (comul (R := R) x) = 0)
    (antipode_mem : ∀ x ∈ s, antipode R x ∈ span s) :
    (span s).IsHopfIdeal R where
  counit_eq_zero x hx := by
    have := (span_le (I := RingHom.ker (Bialgebra.counitAlgHom R A))).2 counit_eq_zero hx
    rwa [RingHom.mem_ker, Bialgebra.counitAlgHom_apply] at this
  map_mkQ_comul_eq_zero x hx := by
    rw [Algebra.TensorProduct.map_mkQ_restrictScalars_eq_zero_iff]
    exact RingHom.mem_ker.1 ((span_le (I := RingHom.ker ((Algebra.TensorProduct.map
      (Quotient.mkₐ R (span s)) (Quotient.mkₐ R (span s))).comp
        (Bialgebra.comulAlgHom R A)))).2 comul_eq_zero hx)
  antipode_mem x hx :=
    (span_le (I := (span s).comap (antipodeAlgHom R A))).2 antipode_mem hx

/-- The ideal generated by a primitive element `q` (`Δ q = q ⊗ 1 + 1 ⊗ q`, `ε q = 0`) is a Hopf
ideal. -/
theorem isHopfIdeal_span_singleton_of_comul_eq {q : A} (hε : counit (R := R) q = 0)
    (hΔ : comul (R := R) q = q ⊗ₜ 1 + 1 ⊗ₜ q) : (span {q}).IsHopfIdeal R := by
  have hmem : q ∈ span {q} := subset_span rfl
  have hS : antipode R q = -q := by
    have := mul_antipode_rTensor_comul_apply (R := R) q
    rw [hΔ, hε] at this
    simpa [eq_neg_iff_add_eq_zero] using this
  refine isHopfIdeal_span ?_ ?_ ?_ <;> rintro x rfl
  · exact hε
  · simp [hΔ, Quotient.eq_zero_iff_mem.2 hmem]
  · rw [hS]
    exact neg_mem hmem

end Ideal

/-- The ideal generated by `g - 1`, for a group-like element `g`, is a Hopf ideal. -/
theorem IsGroupLikeElem.isHopfIdeal_span_sub_one {g : A} (hg : IsGroupLikeElem R g) :
    (Ideal.span {g - 1}).IsHopfIdeal R := by
  have hmem : g - 1 ∈ Ideal.span {g - 1} := Ideal.subset_span rfl
  have hg1 : Ideal.Quotient.mk (Ideal.span {g - 1}) g = 1 := by
    rw [← sub_eq_zero, ← map_one (Ideal.Quotient.mk _), ← map_sub,
      Ideal.Quotient.eq_zero_iff_mem]
    exact hmem
  refine Ideal.isHopfIdeal_span ?_ ?_ ?_ <;> rintro x rfl
  · simp [hg.counit_eq_one]
  · simp [hg.comul_eq_tmul_self, hg1, Algebra.TensorProduct.one_def]
  · have : antipode R g - 1 = -antipode R g * (g - 1) := by
      rw [neg_mul, mul_sub, hg.antipode_mul_cancel, mul_one]
      ring
    rw [map_sub, antipode_one, this]
    exact Ideal.mul_mem_left _ _ hmem
