module

public import Mathlib.RingTheory.LocalRing.Quotient

/-!
# Annihilators in Artinian local principal ideal rings

- `IsLocalRing.exists_isUnit_mul_pow_of_maximalIdeal_eq_span`: if the maximal ideal of a local
  ring is generated by `π` and `π ^ n = 0`, every nonzero element is a unit times `π ^ j`, `j < n`.
- `IsLocalRing.exists_forall_mul_eq_zero_iff_mem`: in an Artinian local principal ideal ring (for
  instance a finite one, such as `ℤ ⧸ ℓⁿ`), every ideal is the annihilator of a single element.
-/

@[expose] public section

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- In a local ring whose maximal ideal is generated by `π`, with `π ^ n = 0`, every nonzero
element is a unit times a power `π ^ j` with `j < n`. -/
lemma exists_isUnit_mul_pow_of_maximalIdeal_eq_span {π : R}
    (hπ : maximalIdeal R = Ideal.span {π}) {n : ℕ} (hn : π ^ n = 0) {x : R} (hx : x ≠ 0) :
    ∃ u j, IsUnit u ∧ j < n ∧ x = u * π ^ j := by
  classical
  set j := Nat.findGreatest (fun j => π ^ j ∣ x) n
  obtain ⟨u, hu⟩ : π ^ j ∣ x :=
    Nat.findGreatest_spec (P := fun j => π ^ j ∣ x) (Nat.zero_le n) (by simp)
  have hjn : j < n := by
    refine lt_of_le_of_ne (Nat.findGreatest_le n) fun h => hx ?_
    rw [hu, h, hn, zero_mul]
  refine ⟨u, j, ?_, hjn, by rw [hu, mul_comm]⟩
  by_contra hu'
  have : u ∈ Ideal.span {π} := hπ ▸ (mem_maximalIdeal u).2 hu'
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.1 this
  exact Nat.findGreatest_is_greatest (Nat.lt_succ_self j) hjn ⟨c, by rw [hu, pow_succ, mul_assoc]⟩

/-- In an Artinian local principal ideal ring (for instance a finite one), every ideal is the
annihilator of a single element. -/
theorem exists_forall_mul_eq_zero_iff_mem [IsArtinianRing R] [IsPrincipalIdealRing R]
    (J : Ideal R) : ∃ a : R, ∀ x : R, x * a = 0 ↔ x ∈ J := by
  classical
  obtain ⟨π, hπ⟩ := (IsPrincipalIdealRing.principal (maximalIdeal R)).principal
  have hnil : ∃ n, π ^ n = 0 := by
    obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := R)
    rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top] at hn
    refine ⟨n, ?_⟩
    rw [← Ideal.mem_bot, ← Ideal.zero_eq_bot, ← hn]
    exact Ideal.pow_mem_pow (hπ ▸ Ideal.mem_span_singleton_self π) n
  set n := Nat.find hnil
  have hn : π ^ n = 0 := Nat.find_spec hnil
  obtain ⟨b, rfl⟩ := (IsPrincipalIdealRing.principal J).principal
  by_cases hb : b = 0
  · refine ⟨1, fun x => ?_⟩
    simp [hb]
  obtain ⟨u, k, hu, hkn, rfl⟩ := exists_isUnit_mul_pow_of_maximalIdeal_eq_span hπ hn hb
  refine ⟨π ^ (n - k), fun x => ⟨fun hx => ?_, fun hx => ?_⟩⟩
  · by_cases hx0 : x = 0
    · simp [hx0]
    obtain ⟨v, j, hv, -, rfl⟩ := exists_isUnit_mul_pow_of_maximalIdeal_eq_span hπ hn hx0
    rw [mul_assoc, ← pow_add, hv.mul_right_eq_zero] at hx
    have hkj : k ≤ j := by
      have := Nat.find_min' hnil hx
      lia
    rw [Submodule.mem_span_singleton]
    refine ⟨v * π ^ (j - k) * hu.unit⁻¹, ?_⟩
    rw [smul_eq_mul, mul_assoc, mul_assoc, ← mul_assoc _ u, hu.val_inv_mul, one_mul,
      ← pow_add, Nat.sub_add_cancel hkj]
  · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hx
    rw [mul_assoc, mul_assoc, ← pow_add, Nat.add_sub_cancel' hkn.le, hn, mul_zero, mul_zero]

end IsLocalRing
