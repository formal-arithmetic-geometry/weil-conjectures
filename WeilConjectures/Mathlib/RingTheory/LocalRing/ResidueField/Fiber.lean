module

public import Mathlib.RingTheory.LocalRing.ResidueField.Fiber

/-!
# The fibre ring of a local homomorphism

For a local homomorphism `f : R →+* S` out of a local ring, the *fibre ring* `S ⧸ m_R S` is the
fibre of `f` over the closed point of `R`. For `f` the stalk map of a morphism of schemes
`f : X ⟶ Y` at a point `x` with image `y = f x`, it is the local ring `𝒪_{X_y, x}` of the
scheme-theoretic fibre `X_y` at `x`.

## Main definitions and results

* `RingHom.fiberRing`: the fibre ring `S ⧸ m_R S` of a local homomorphism `f : R →+* S`.
* `Ideal.Fiber.algEquivFiberRing`: the fibre ring is mathlib's fibre `κ(m_R) ⊗[R] S` of `f` at
  the maximal ideal of `R`, which makes the whole of `Ideal.Fiber` available for it.
* `RingHom.instIsLocalRingFiberRing`: the fibre ring of a local homomorphism of local rings is a
  local ring.

## Design

The fibre ring is spelled as a quotient rather than as the tensor product `κ(m_R) ⊗[R] S`
because that is the presentation for which `ringKrullDim` is directly computable, and the
presentation a geometric consumer meets: the local ring of a scheme-theoretic fibre comes with a
surjection from the local ring of the source. `Ideal.Fiber.algEquivFiberRing` connects the two.
-/

@[expose] public section

open IsLocalRing

universe u v

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/-- The *fibre ring* of a local homomorphism `f : R →+* S` out of a local ring: the quotient of
`S` by the ideal generated by the image of the maximal ideal of `R`.

For `f` the stalk map of a morphism of schemes `f : X ⟶ Y` at a point `x` with image `y = f x`,
this is the local ring `𝒪_{X_y, x}` of the scheme-theoretic fibre `X_y` at `x`. -/
abbrev RingHom.fiberRing [IsLocalRing R] (f : R →+* S) : Type v :=
  S ⧸ (maximalIdeal R).map f

/-- The fibre ring of a local homomorphism of local rings is a local ring. -/
instance RingHom.instIsLocalRingFiberRing [IsLocalRing R] [IsLocalRing S] (f : R →+* S)
    [IsLocalHom f] : IsLocalRing f.fiberRing :=
  have : Nontrivial f.fiberRing :=
    Ideal.Quotient.nontrivial_iff.mpr (map_maximalIdeal_lt_top f).ne
  .of_surjective' _ Ideal.Quotient.mk_surjective

variable (R S) in
/-- The fibre ring of `f : R →+* S` over the closed point of `R` is the fibre `κ(m_R) ⊗[R] S`
of `f` at the maximal ideal of `R`. -/
noncomputable def Ideal.Fiber.algEquivFiberRing [IsLocalRing R] [Algebra R S] :
    (maximalIdeal R).Fiber S ≃ₐ[R] (algebraMap R S).fiberRing :=
  (Algebra.TensorProduct.congr (.symm <| .ofBijective _
    (Ideal.bijective_algebraMap_quotient_residueField (maximalIdeal R))) .refl).trans <|
    (Algebra.TensorProduct.comm _ _ _).trans
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot S
        (maximalIdeal R)).symm.restrictScalars _)
