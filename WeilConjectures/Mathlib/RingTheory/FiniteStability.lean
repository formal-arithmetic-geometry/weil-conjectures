module

public import Mathlib.RingTheory.FiniteStability
public import Mathlib.RingTheory.KrullDimension.Field
public import Mathlib.RingTheory.KrullDimension.Polynomial

/-!
# Krull dimension of the base change of a finitely generated algebra

## Main results

- `ringKrullDim_tensorProduct_le_of_surjective`: the base change to a field of an algebra
  generated by `n` elements has Krull dimension at most `n`.
-/

@[expose] public section

open scoped TensorProduct

/-- If an `R`-algebra `A` is generated by `n` elements, its base change `B ⊗[R] A` to a field `B`
has Krull dimension at most `n`: it is a quotient of `B[X₁, …, Xₙ]`. -/
theorem ringKrullDim_tensorProduct_le_of_surjective {R A B : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [Field B] [Algebra R B] {n : ℕ} (f : MvPolynomial (Fin n) R →ₐ[R] A)
    (hf : Function.Surjective f) : ringKrullDim (B ⊗[R] A) ≤ n := by
  let g : MvPolynomial (Fin n) B →ₐ[B] B ⊗[R] A :=
    (Algebra.TensorProduct.map (AlgHom.id B B) f).comp
      (MvPolynomial.algebraTensorAlgEquiv R B).symm.toAlgHom
  have hg : Function.Surjective g :=
    (Algebra.FiniteType.baseChangeAux_surj B hf).comp (AlgEquiv.surjective _)
  refine (ringKrullDim_le_of_surjective g.toRingHom hg).trans ?_
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add]
  simp
