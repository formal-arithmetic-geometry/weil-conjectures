module

public import Mathlib.RingTheory.DiscreteValuationRing.TFAE

/-!
# Local domains with principal maximal ideal

A noetherian local domain whose maximal ideal is generated by a single nonzero element is a
discrete valuation ring. This is one of the equivalences of `IsDiscreteValuationRing.TFAE`,
stated with an explicit generator.
-/

@[expose] public section

open IsLocalRing

/-- **Local domains with principal maximal ideal.** A noetherian local domain `R` whose maximal
ideal is `(t)` for some `t ≠ 0` is a discrete valuation ring.

(blueprint: `lem-sc-principal-ideal-dvr`) -/
theorem IsDiscreteValuationRing.of_maximalIdeal_eq_span_singleton {R : Type*} [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] [IsDomain R] {t : R} (ht : t ≠ 0)
    (h : maximalIdeal R = Ideal.span {t}) : IsDiscreteValuationRing R := by
  have hR : ¬IsField R := by
    rw [isField_iff_maximalIdeal_eq, h, Ideal.span_singleton_eq_bot]
    exact ht
  have hp : (maximalIdeal R).IsPrincipal := ⟨⟨t, h⟩⟩
  exact ((IsDiscreteValuationRing.TFAE R hR).out 0 4).mpr hp
