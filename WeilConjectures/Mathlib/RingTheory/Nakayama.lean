module

public import Mathlib.RingTheory.Nakayama
public import Mathlib.RingTheory.Ideal.Maximal
public import Mathlib.Tactic.Algebraize

/-!
# Surjectivity of finite ring maps via Nakayama's lemma

A finite `A`-module `Q` with `Q = m Q` for every maximal ideal `m` of `A` is zero. As an
application, a finite ring map `ψ : A →+* B` is surjective as soon as it is so "at every maximal
ideal of `B`": residually surjective, unramified, and injective on maximal ideals. This is the
algebraic content of the criterion that a proper morphism which is injective on closed points
and unramified there, with trivial residue field extensions, is a closed immersion.

## Main results

- `Module.subsingleton_of_forall_isMaximal_top_le_smul`
- `RingHom.surjective_of_finite_of_forall_isMaximal`
-/

@[expose] public section

variable {A B : Type*} [CommRing A] [CommRing B]

/-- A finite `A`-module `Q` with `Q = m • Q` for every maximal ideal `m` of `A` is zero. -/
lemma Module.subsingleton_of_forall_isMaximal_top_le_smul {Q : Type*} [AddCommGroup Q]
    [Module A Q] [Module.Finite A Q]
    (h : ∀ m : Ideal A, m.IsMaximal → (⊤ : Submodule A Q) ≤ m • ⊤) :
    Subsingleton Q := by
  by_contra hQ
  rw [not_subsingleton_iff_nontrivial] at hQ
  obtain ⟨m, hm, hle⟩ := (Module.annihilator A Q).exists_le_maximal
    (by
      rw [Ne, Module.annihilator_eq_top_iff]
      exact not_subsingleton Q)
  obtain ⟨r, hr, hr0⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m
    (⊤ : Submodule A Q) Module.Finite.fg_top (h m hm)
  have : r ∈ m := hle (Module.mem_annihilator.mpr fun q ↦ hr0 q trivial)
  exact hm.ne_top ((Ideal.eq_top_iff_one _).mpr (by simpa using m.sub_mem this hr))

namespace RingHom

/-- **A closed immersion criterion for finite ring maps.** Let `ψ : A →+* B` be finite. Suppose
that for every maximal ideal `n` of `B`, with `m = ψ⁻¹ n`,
* `A ⧸ m ⟶ B ⧸ n` is surjective,
* `n B_n = m B_n`,
* `n` is the only maximal ideal of `B` over `m`.
Then `ψ` is surjective. -/
theorem surjective_of_finite_of_forall_isMaximal {ψ : A →+* B} (hψ : ψ.Finite)
    (hres : ∀ n : Ideal B, n.IsMaximal → ∀ b, ∃ a, b - ψ a ∈ n)
    (hunr : ∀ n : Ideal B, n.IsMaximal → ∀ x ∈ n, ∃ u ∉ n, u * x ∈ (n.comap ψ).map ψ)
    (hinj : ∀ n n' : Ideal B, n.IsMaximal → n'.IsMaximal → n.comap ψ = n'.comap ψ → n = n') :
    Function.Surjective ψ := by
  algebraize [ψ]
  -- for every maximal `m` of `A` and every `b`, `b ∈ ψ(A) + m B`
  have key (m : Ideal A) (hm : m.IsMaximal) (b : B) : ∃ a, b - ψ a ∈ m.map ψ := by
    set J := m.map ψ
    by_cases hJ : J = ⊤
    · exact ⟨0, hJ ▸ trivial⟩
    have hcomap (n : Ideal B) (hn : n.IsMaximal) (hJn : J ≤ n) : n.comap ψ = m :=
      (hm.eq_of_le (Ideal.comap_ne_top ψ hn.ne_top)
        (Ideal.map_le_iff_le_comap.mp hJn)).symm
    obtain ⟨n, hn, hJn⟩ := J.exists_le_maximal hJ
    -- `n = J`, since `n B_n` is generated by an element of `J` and `n` is the only maximal
    -- ideal containing `J`
    have hnJ : n ≤ J := by
      intro x hx
      obtain ⟨u, hu, hux⟩ := hunr n hn x hx
      have huxJ : u * x ∈ J := by rwa [hcomap n hn hJn] at hux
      have htop : J ⊔ Ideal.span {u} = ⊤ := by
        by_contra h
        obtain ⟨n', hn', hle⟩ := (J ⊔ Ideal.span {u}).exists_le_maximal h
        have := hinj n n' hn hn' ((hcomap n hn hJn).trans
          (hcomap n' hn' (le_sup_left.trans hle)).symm)
        exact hu (this ▸ hle (le_sup_right (a := J) (Ideal.mem_span_singleton_self u)))
      obtain ⟨j, hj, w, hw, hjw⟩ := Submodule.mem_sup.mp (htop ▸ (Submodule.mem_top (x := 1)))
      obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton'.mp hw
      have : x = j * x + v * (u * x) := by
        calc x = (j + v * u) * x := by rw [hjw, one_mul]
          _ = _ := by ring
      rw [this]
      exact J.add_mem (J.mul_mem_right _ hj) (J.mul_mem_left _ huxJ)
    obtain ⟨a, ha⟩ := hres n hn b
    exact ⟨a, hnJ ha⟩
  let N : Submodule A B := LinearMap.range (Algebra.linearMap A B)
  have hN (m : Ideal A) (hm : m.IsMaximal) : (⊤ : Submodule A (B ⧸ N)) ≤ m • ⊤ := by
    have h : N ⊔ m • (⊤ : Submodule A B) = ⊤ := by
      refine eq_top_iff.mpr fun b _ ↦ ?_
      obtain ⟨a, ha⟩ := key m hm b
      have hb : b = algebraMap A B a + (b - ψ a) := by
        rw [RingHom.algebraMap_toAlgebra]
        ring
      rw [hb]
      refine Submodule.add_mem_sup ⟨a, rfl⟩ ?_
      rw [Ideal.smul_top_eq_map]
      exact ha
    have := congrArg (Submodule.map N.mkQ) h
    rw [Submodule.map_sup, Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ,
      Submodule.mkQ_map_self, bot_sup_eq] at this
    exact this.symm.le
  have := Module.subsingleton_of_forall_isMaximal_top_le_smul (Q := B ⧸ N) hN
  intro b
  have : Submodule.Quotient.mk (p := N) b = 0 := Subsingleton.elim _ _
  obtain ⟨a, ha⟩ := (Submodule.Quotient.mk_eq_zero N).mp this
  exact ⟨a, ha⟩

end RingHom
