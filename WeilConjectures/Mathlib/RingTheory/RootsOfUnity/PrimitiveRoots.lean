module

public import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-!
# The roots of unity generated by a primitive root

For a primitive `n`-th root of unity `ζ` in a domain `R`, the map `a ↦ ζ ^ a` identifies `ZMod n`
with the group `μₙ(R)` of `n`-th roots of unity.

## Main definitions

- `IsPrimitiveRoot.zmodAddEquivRootsOfUnity`: the isomorphism `ZMod n ≃+ μₙ(R)`, `a ↦ ζ ^ a`.
-/

@[expose] public section

namespace IsPrimitiveRoot

variable {R : Type*} [CommRing R] [IsDomain R] {n : ℕ} [NeZero n] {ζ : Rˣ}

end IsPrimitiveRoot
