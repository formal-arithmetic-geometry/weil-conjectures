module

public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.RingTheory.Conductor
public import Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas
public import Mathlib.RingTheory.Unramified.LocalRing

/-!
# Local generators of finite extensions of Dedekind domains

Let `B` be a Dedekind domain, finite and torsion-free over a Dedekind domain `A`, and let `q` be
a nonzero prime of `B` whose residue field is separable over that of `p = q ∩ A`. We show that
`B` is monogenic over `A` locally at `q`: there is `x : B` whose conductor `{s | s B ⊆ A[x]}` is not
contained in `q`.

The element `x` reduces to a nonzero generator `θ` of `κ(q) / κ(p)` and lies in every other prime
over `p`; moreover `h(x) ∉ q²` for a monic lift `h` of the minimal polynomial of `θ`. Then `q` is
the only prime of `B` over `q' = q ∩ A[x]`, and `q' B_q = q B_q` is generated by the uniformizer
`h(x)`.
By Nakayama's lemma `A[x]_{q'} → B_q` is surjective, so every `b : B` has a multiple `u b ∈ A[x]`
with `u ∉ q'`.

## Main statements

- `Localization.localRingHom_surjective_of_primesOver_eq_singleton_of_map_eq`: a variant of
  `Localization.localRingHom_surjective_of_primesOver_eq_singleton` for ramified primes.
- `Ideal.exists_not_conductor_le`: local monogenicity of finite extensions of Dedekind domains.
-/

@[expose] public section

open Polynomial IsLocalRing

namespace Localization

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {p : Ideal R} [p.IsPrime]
  {q : Ideal S} [q.IsPrime]

/-- Let `S` be finite over `R` and `q` the only prime of `S` over `p`. If `p S_q` is the maximal
ideal of `S_q` and `R → S / q` is surjective, then `R_p → S_q` is surjective. This is
`Localization.localRingHom_surjective_of_primesOver_eq_singleton` without the hypothesis that `S`
is unramified at `q`. -/
lemma localRingHom_surjective_of_primesOver_eq_singleton_of_map_eq
    (hq : p.primesOver S = {q}) [Module.Finite R S] [q.LiesOver p]
    [Algebra (Localization.AtPrime p) (Localization.AtPrime q)]
    [Localization.AtPrime.IsLiesOverAlgebra p q]
    (hmax : p.map (algebraMap R (Localization.AtPrime q)) = maximalIdeal _)
    (hres : ∀ s : S, ∃ r : R, algebraMap R S r - s ∈ q) :
    Function.Surjective (localRingHom p q (algebraMap R S) (q.over_def p)) := by
  have := Localization.finite_of_primesOver_eq_singleton hq
  rw [← Localization.AtPrime.IsLiesOverAlgebra.algebraMap_eq]
  change Function.Surjective (Algebra.linearMap _ _)
  rw [← LinearMap.range_eq_top, ← top_le_iff]
  apply Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
    (maximalIdeal_le_jacobson _)
  have hm : (maximalIdeal (Localization.AtPrime p)).map
      (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) = maximalIdeal _ := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    exact hmax
  rw [Ideal.smul_top_eq_map, hm]
  rintro x -
  obtain ⟨⟨s, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
  obtain ⟨r₁, hr₁⟩ := hres s
  obtain ⟨r₂, hr₂⟩ := hres t
  have hr₂p : r₂ ∉ p := by
    rw [q.over_def p, Ideal.mem_comap]
    intro h
    exact t.2 (by simpa using q.sub_mem h hr₂)
  let a : Localization.AtPrime p := IsLocalization.mk' _ r₁ (⟨r₂, hr₂p⟩ : p.primeCompl)
  have ha : algebraMap (Localization.AtPrime p) (Localization.AtPrime q) a =
      IsLocalization.mk' _ (algebraMap R S r₁)
        (⟨algebraMap R S r₂, fun h ↦ hr₂p ((q.over_def p).symm ▸ h)⟩ : q.primeCompl) := by
    rw [Localization.AtPrime.IsLiesOverAlgebra.algebraMap_eq, Localization.localRingHom_mk']
  refine Submodule.mem_sup.2 ⟨algebraMap _ _ a, ⟨a, rfl⟩, _ - _, ?_, add_sub_cancel _ _⟩
  rw [Submodule.restrictScalars_mem, ha, ← IsLocalization.mk'_sub,
    IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime q) q]
  have : s * algebraMap R S r₂ - algebraMap R S r₁ * t =
      s * (algebraMap R S r₂ - t) - t * (algebraMap R S r₁ - s) := by ring
  rw [this]
  exact q.sub_mem (q.mul_mem_left _ hr₂) (q.mul_mem_left _ hr₁)

/-- Under the hypotheses of `localRingHom_surjective_of_primesOver_eq_singleton_of_map_eq`, if `S`
is a domain, every `b : S` has a multiple `u b` with `u ∉ p` in the image of `R`. -/
lemma exists_notMem_mul_mem_range_of_primesOver_eq_singleton [IsDomain S]
    (hq : p.primesOver S = {q}) [Module.Finite R S] [q.LiesOver p]
    (hmax : p.map (algebraMap R (Localization.AtPrime q)) = maximalIdeal _)
    (hres : ∀ s : S, ∃ r : R, algebraMap R S r - s ∈ q) (b : S) :
    ∃ u ∉ p, ∃ c : R, algebraMap R S c = algebraMap R S u * b := by
  let := Localization.AtPrime.algebraOfLiesOver p q
  obtain ⟨y, hy⟩ := localRingHom_surjective_of_primesOver_eq_singleton_of_map_eq hq hmax hres
    (algebraMap S _ b)
  obtain ⟨⟨c, u⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl y
  refine ⟨u, u.2, c, ?_⟩
  rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_iff_eq_mul, ← map_mul] at hy
  exact (IsLocalization.injective (Localization.AtPrime q)
    q.primeCompl_le_nonZeroDivisors) (hy.trans (by rw [mul_comm]))

end Localization

namespace Ideal

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- **Local monogenicity.** Let `B` be a Dedekind domain, finite and torsion-free over a Dedekind
domain `A`, and `q` a nonzero prime of `B` whose residue field is separable over that of
`p = q ∩ A`. Then there is `x : B` whose conductor `{s | s B ⊆ A[x]}` is not contained in `q`. -/
theorem exists_not_conductor_le [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B]
    [Module.IsTorsionFree A B] (q : Ideal B) [q.IsMaximal] (hq : q ≠ ⊥)
    [Algebra.IsSeparable (A ⧸ q.under A) (B ⧸ q)] :
    ∃ x : B, ¬ conductor A x ≤ q := by
  classical
  have : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  have : FaithfulSMul A B := inferInstance
  set p := q.under A with hp_def
  have hpmax : p.IsMaximal := Ideal.IsMaximal.under A q
  have hp0 : p ≠ ⊥ := Ideal.under_ne_bot A hq
  let := Ideal.Quotient.field p
  let := Ideal.Quotient.field q
  have hqtop : q ≠ ⊤ := Ideal.IsMaximal.ne_top inferInstance
  -- A nonzero generator `θ` of `κ(q) / κ(p)`.
  obtain ⟨θ, hθ0, hθ⟩ : ∃ θ : B ⧸ q, θ ≠ 0 ∧ Algebra.adjoin (A ⧸ p) {θ} = ⊤ := by
    have : Module.Finite (A ⧸ p) (B ⧸ q) := Module.Finite.of_restrictScalars_finite A _ _
    obtain ⟨θ, hθ⟩ := Field.exists_primitive_element (A ⧸ p) (B ⧸ q)
    have hθ' : Algebra.adjoin (A ⧸ p) {θ} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (Algebra.IsAlgebraic.isAlgebraic θ), hθ, IntermediateField.top_toSubalgebra]
    by_cases h0 : θ = 0
    · refine ⟨1, one_ne_zero, ?_⟩
      rw [h0] at hθ'
      rw [eq_top_iff, ← hθ']
      exact Algebra.adjoin_le (by simp)
    · exact ⟨θ, h0, hθ'⟩
  obtain ⟨θ', rfl⟩ := Ideal.Quotient.mk_surjective θ
  -- A monic lift `h` of the minimal polynomial of `θ`.
  have hθint : IsIntegral (A ⧸ p) (Ideal.Quotient.mk q θ') := Algebra.IsIntegral.isIntegral _
  obtain ⟨h, hhmap, -, hhmonic⟩ := lifts_and_degree_eq_and_monic
    (map_surjective (algebraMap A (A ⧸ p)) Ideal.Quotient.mk_surjective
      (minpoly (A ⧸ p) (Ideal.Quotient.mk q θ'))) (minpoly.monic hθint)
  have hmk (y : B) (P : A[X]) :
      Ideal.Quotient.mk q (aeval y P) =
        aeval (Ideal.Quotient.mk q y) (P.map (algebraMap A (A ⧸ p))) := by
    rw [aeval_map_algebraMap, ← Ideal.Quotient.algebraMap_eq, aeval_algebraMap_apply]
  have hθq (y : B) (hy : Ideal.Quotient.mk q y = Ideal.Quotient.mk q θ') : aeval y h ∈ q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, hmk, hy, hhmap, minpoly.aeval]
  have hθq' (y : B) (hy : Ideal.Quotient.mk q y = Ideal.Quotient.mk q θ') :
      aeval y (derivative h) ∉ q := by
    intro hmem
    rw [← Ideal.Quotient.eq_zero_iff_mem, hmk, hy, ← derivative_map, hhmap] at hmem
    exact (Algebra.IsSeparable.isSeparable (A ⧸ p)
      (Ideal.Quotient.mk q θ')).aeval_derivative_ne_zero (minpoly.aeval _ _) hmem
  -- The Chinese remainder theorem over the primes above `p`.
  set s := IsDedekindDomain.primesOverFinset p B with hs_def
  have hmem_s {Q : Ideal B} : Q ∈ s ↔ Q ∈ p.primesOver B :=
    IsDedekindDomain.mem_primesOverFinset_iff hp0 B
  have hqp : q.LiesOver p := ⟨rfl⟩
  have hqs : q ∈ s := hmem_s.2 ⟨inferInstance, hqp⟩
  have hprime : ∀ Q ∈ s, Prime (id Q) := fun Q hQ ↦ by
    obtain ⟨hQ, hQl⟩ := hmem_s.1 hQ
    exact Ideal.prime_of_isPrime (Ideal.ne_bot_of_liesOver_of_ne_bot hp0 Q) hQ
  have crt (z : B) : ∃ y : B, y - z ∈ q ^ 2 ∧ ∀ Q ∈ s, Q ≠ q → y ∈ Q := by
    obtain ⟨y, hy⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := s) id
      (fun Q ↦ if Q = q then 2 else 1) hprime (fun _ _ _ _ h ↦ h)
      (fun Q ↦ if Q.1 = q then z else 0)
    exact ⟨y, by simpa using hy q hqs, fun Q hQ hQq ↦ by simpa [hQq] using hy Q hQ⟩
  have hq2 : q ^ 2 ≤ q := Ideal.pow_le_self two_ne_zero
  obtain ⟨x₀, hx₀, hx₀Q⟩ := crt θ'
  obtain ⟨π₀, hπ₀, hπ₀'⟩ := Ideal.exists_mem_pow_notMem_pow_succ q hq hqtop 1
  rw [pow_one] at hπ₀
  obtain ⟨π, hπ, hπQ⟩ := crt π₀
  have hπq : π ∈ q := by simpa using q.add_mem (hq2 hπ) hπ₀
  have hπq2 : π ∉ q ^ 2 := fun h ↦ hπ₀' (by simpa using (q ^ 2).sub_mem h hπ)
  have htaylor : aeval (x₀ + π) h - (aeval x₀ h + aeval x₀ (derivative h) * π) ∈ q ^ 2 := by
    have h2 : (Ideal.Quotient.mk (q ^ 2) π) ^ 2 = 0 := by
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.pow_mem_pow hπq 2
    have := aeval_add_of_sq_eq_zero h (Ideal.Quotient.mk (q ^ 2) x₀) _ h2
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_add, map_mul, sub_eq_zero]
    simp only [← Ideal.Quotient.algebraMap_eq, ← aeval_algebraMap_apply, map_add] at this ⊢
    exact this
  have hprim2 : (q ^ 2).IsPrimary := Ideal.isPrimary_of_isMaximal_radical (by
    rw [Ideal.radical_pow _ two_ne_zero, (inferInstance : q.IsMaximal).isPrime.radical]
    infer_instance)
  have hrad : (q ^ 2).radical = q := by
    rw [Ideal.radical_pow _ two_ne_zero, (inferInstance : q.IsMaximal).isPrime.radical]
  -- The element `x`.
  let x : B := if aeval x₀ h ∈ q ^ 2 then x₀ + π else x₀
  have hxθ : Ideal.Quotient.mk q x = Ideal.Quotient.mk q θ' := by
    rw [Ideal.Quotient.eq]
    by_cases hx : aeval x₀ h ∈ q ^ 2
    · simpa [x, hx, add_sub_right_comm] using q.add_mem (hq2 hx₀) hπq
    · simpa [x, hx] using hq2 hx₀
  have hxQ (Q : Ideal B) (hQ : Q ∈ s) (hQq : Q ≠ q) : x ∈ Q := by
    by_cases hx : aeval x₀ h ∈ q ^ 2
    · simpa [x, hx] using Q.add_mem (hx₀Q Q hQ hQq) (hπQ Q hQ hQq)
    · simpa [x, hx] using hx₀Q Q hQ hQq
  have hhx : aeval x h ∉ q ^ 2 := by
    by_cases hx : aeval x₀ h ∈ q ^ 2
    · simp only [x, hx, if_true]
      intro h'
      have hmul : aeval x₀ (derivative h) * π ∈ q ^ 2 := by
        have := (q ^ 2).sub_mem h' htaylor
        simpa using (q ^ 2).sub_mem this hx
      rcases (Ideal.isPrimary_iff.1 hprim2).2 hmul with h₁ | h₁
      · exact hθq' x₀ (by rw [Ideal.Quotient.eq]; exact hq2 hx₀) (hq2 h₁)
      · rw [hrad] at h₁
        rcases (Ideal.isPrimary_iff.1 hprim2).2 (by rwa [mul_comm] at hmul) with h₂ | h₂
        · exact hπq2 h₂
        · exact hθq' x₀ (by rw [Ideal.Quotient.eq]; exact hq2 hx₀) (hrad ▸ h₂)
    · simp [x, hx]
  have hx0 : x ∉ q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, hxθ]
    exact hθ0
  -- The subalgebra `A[x]` and the prime `q' = q ∩ A[x]`.
  let C := Algebra.adjoin A {x}
  have hxC : x ∈ C := Algebra.self_mem_adjoin_singleton A x
  let q' : Ideal C := q.under C
  have : Module.Finite C B := Module.Finite.of_restrictScalars_finite A C B
  have : Algebra.IsIntegral C B := Algebra.IsIntegral.of_finite C B
  have hq'p : q'.LiesOver p := Ideal.under_liesOver_of_liesOver C q p
  have hprim : q'.primesOver B = {q} := by
    ext Q
    refine ⟨fun ⟨hQ, hQl⟩ ↦ ?_, ?_⟩
    · have : Q.LiesOver p := Ideal.LiesOver.trans Q q' p
      by_contra hQq
      have hxQ' := hxQ Q (hmem_s.2 ⟨hQ, this⟩) hQq
      have : (⟨x, hxC⟩ : C) ∈ q' := by rw [hQl.over]; exact hxQ'
      exact hx0 this
    · rintro rfl
      exact ⟨inferInstance, inferInstance⟩
  have hres (b : B) : ∃ c : C, algebraMap C B c - b ∈ q := by
    have hb : Ideal.Quotient.mk q b ∈ Algebra.adjoin (A ⧸ p) {Ideal.Quotient.mk q θ'} :=
      hθ ▸ Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨P, hP⟩ := hb
    obtain ⟨P', rfl⟩ := map_surjective (algebraMap A (A ⧸ p)) Ideal.Quotient.mk_surjective P
    refine ⟨⟨aeval x P', aeval_mem_adjoin_singleton A x⟩, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
    change Ideal.Quotient.mk q (aeval x P') = _
    rw [hmk, hxθ]
    exact hP
  have hmax : q'.map (algebraMap C (Localization.AtPrime q)) = maximalIdeal _ := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply C B,
        IsLocalization.AtPrime.to_map_mem_maximal_iff _ q]
      exact hc
    · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
      intro y hy
      obtain ⟨J, hJ⟩ : q ∣ Ideal.span {aeval x h} :=
        Ideal.dvd_iff_le.2 (Ideal.span_le.2 (Set.singleton_subset_iff.2 (hθq x hxθ)))
      obtain ⟨j, hjJ, hjq⟩ : ∃ j ∈ J, j ∉ q := by
        by_contra! hJq
        apply hhx
        have : Ideal.span {aeval x h} ≤ q * q := by
          rw [hJ]
          exact Ideal.mul_mono_right hJq
        rw [pow_two]
        exact this (Ideal.mem_span_singleton_self _)
      obtain ⟨b, hb⟩ : ∃ b, b * aeval x h = j * y := by
        rw [← Ideal.mem_span_singleton', hJ, mul_comm j]
        exact Ideal.mul_mem_mul hy hjJ
      have hu : IsUnit (algebraMap B (Localization.AtPrime q) j) :=
        IsLocalization.map_units _ (⟨j, hjq⟩ : q.primeCompl)
      rw [Ideal.mem_comap]
      have : algebraMap B (Localization.AtPrime q) y =
          algebraMap C (Localization.AtPrime q) ⟨aeval x h, aeval_mem_adjoin_singleton A x⟩ *
            (algebraMap B _ b * hu.unit⁻¹) := by
        rw [IsScalarTower.algebraMap_apply C B, eq_comm, ← hu.mul_left_inj, mul_assoc, mul_assoc,
          IsUnit.val_inv_mul, mul_one]
        change algebraMap B _ (aeval x h) * algebraMap B _ b = _
        rw [← map_mul, ← map_mul, mul_comm, hb, mul_comm]
      rw [this]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hθq x hxθ))
  -- A conductor element outside `q`.
  obtain ⟨g, hg⟩ := Module.Finite.fg_top (R := A) (M := B)
  choose u hu c hc using fun b ↦
    Localization.exists_notMem_mul_mem_range_of_primesOver_eq_singleton hprim hmax hres b
  let t : C := ∏ b ∈ g, u b
  have ht : t ∉ q' := by
    rw [Ideal.IsPrime.prod_mem_iff]
    rintro ⟨b, -, hb⟩
    exact hu b hb
  have htcond : (t : B) ∈ conductor A x := by
    intro b
    have hb : b ∈ Submodule.span A (g : Set B) := hg ▸ Submodule.mem_top
    induction hb using Submodule.span_induction with
    | mem b hb =>
      have : (t : B) * b = (∏ b' ∈ g.erase b, u b' : C) * (algebraMap C B (u b) * b) := by
        rw [show (t : B) = ((∏ b ∈ g, u b : C) : B) from rfl, ← Finset.mul_prod_erase g u hb]
        simp only [Subalgebra.coe_mul]
        change _ = _ * ((u b : B) * b)
        ring
      rw [this, ← hc b]
      exact C.mul_mem (SetLike.coe_mem _) (SetLike.coe_mem _)
    | zero => simp
    | add b b' _ _ hb hb' => simpa [mul_add] using C.add_mem hb hb'
    | smul a b _ hb => simpa [mul_smul_comm] using C.smul_mem hb a
  exact ⟨x, fun hle ↦ ht (hle htcond)⟩

end Ideal
