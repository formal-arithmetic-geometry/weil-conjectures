module

public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.Localization.BaseChange
public import Mathlib.RingTheory.ReesAlgebra
public import Mathlib.RingTheory.TensorProduct.MonoidAlgebra

/-!
# The extended Rees algebra

For an ideal `I` of a commutative ring `R`, the *extended Rees algebra* is the subalgebra

`R[t, I t⁻¹] = ⨁_{n ∈ ℤ} I^{-n} tⁿ ⊆ R[t, t⁻¹]`

(with `I^m = R` for `m ≤ 0`) generated by `t` and the elements `x t⁻¹` with `x ∈ I`. Its spectrum
is the affine piece of the deformation to the normal cone of `V(I) ⊆ Spec R`: inverting `t` gives
`R[t, t⁻¹]`, and setting `t = 0` gives the associated graded ring `⨁_{r ≥ 0} I^r / I^{r+1}`.

## Main definitions

- `Ideal.extendedReesAlgebra`: the extended Rees algebra `R[t, I t⁻¹] ⊆ R[t, t⁻¹]`.
- `Ideal.extendedReesAlgebraMap`: its functoriality along `R ⟶ S`, landing in the extended
  Rees algebra of the extended ideal `I S`.

## Main statements

- `Ideal.isLocalization_extendedReesAlgebra`: `R[t, t⁻¹]` is the localization of the extended
  Rees algebra at `t`.
- `Ideal.isBaseChange_extendedReesAlgebraMap`: along a flat `R ⟶ S`, the extended Rees algebra
  of `I S` is the base change of that of `I`.
-/

@[expose] public section

open LaurentPolynomial Polynomial

open scoped TensorProduct

namespace Ideal

variable {R : Type*} [CommRing R] (I : Ideal R)

/-- The *extended Rees algebra* `R[t, I t⁻¹] = ⨁_{n ∈ ℤ} I^{-n} tⁿ ⊆ R[t, t⁻¹]` of an ideal `I`:
the subalgebra of Laurent polynomials generated by `t` and the elements `x t⁻¹` with `x ∈ I`. -/
noncomputable def extendedReesAlgebra : Subalgebra R R[T;T⁻¹] :=
  Algebra.adjoin R (insert (T 1) ((fun x ↦ LaurentPolynomial.C x * T (-1)) '' I))

variable {I}

lemma T_one_mem_extendedReesAlgebra : (T 1 : R[T;T⁻¹]) ∈ I.extendedReesAlgebra :=
  Algebra.subset_adjoin (Set.mem_insert _ _)

lemma C_mul_T_neg_one_mem_extendedReesAlgebra {x : R} (hx : x ∈ I) :
    LaurentPolynomial.C x * T (-1) ∈ I.extendedReesAlgebra :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨x, hx, rfl⟩)

lemma C_mem_extendedReesAlgebra (x : R) :
    LaurentPolynomial.C x ∈ I.extendedReesAlgebra := by
  rw [LaurentPolynomial.C_eq_algebraMap]
  exact Subalgebra.algebraMap_mem _ x

lemma T_natCast_mem_extendedReesAlgebra (n : ℕ) :
    (T n : R[T;T⁻¹]) ∈ I.extendedReesAlgebra := by
  rw [show (n : ℤ) = n * 1 by simp, ← T_pow]
  exact Subalgebra.pow_mem _ T_one_mem_extendedReesAlgebra n

lemma toLaurent_mem_extendedReesAlgebra (p : R[X]) :
    toLaurent p ∈ I.extendedReesAlgebra := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
  | monomial n a =>
    rw [← C_mul_X_pow_eq_monomial, toLaurent_C_mul_X_pow]
    exact Subalgebra.mul_mem _ (C_mem_extendedReesAlgebra a)
      (T_natCast_mem_extendedReesAlgebra n)

variable (I) in
/-- `t` as an element of the extended Rees algebra. -/
noncomputable def extendedReesAlgebraT : I.extendedReesAlgebra :=
  ⟨T 1, T_one_mem_extendedReesAlgebra⟩

@[simp]
lemma coe_extendedReesAlgebraT : (I.extendedReesAlgebraT : R[T;T⁻¹]) = T 1 := rfl

variable (I) in
/-- `R[t, t⁻¹]` is the localization of the extended Rees algebra at `t`. -/
instance isLocalization_extendedReesAlgebra :
    IsLocalization.Away I.extendedReesAlgebraT R[T;T⁻¹] where
  map_units := by
    rintro ⟨_, n, rfl⟩
    simp only [map_pow]
    exact (isUnit_T 1).pow n
  surj f := by
    obtain ⟨n, f', hf'⟩ := exists_T_pow f
    refine ⟨⟨⟨toLaurent f', toLaurent_mem_extendedReesAlgebra f'⟩,
      ⟨_, n, rfl⟩⟩, ?_⟩
    simp only [map_pow]
    change f * (T 1) ^ n = toLaurent f'
    rw [hf', T_pow, mul_one]
  exists_of_eq {x y} h := ⟨1, by simpa using Subtype.ext h⟩

lemma extendedReesAlgebra_top : (⊤ : Ideal R).extendedReesAlgebra = ⊤ := by
  rw [eq_top_iff]
  intro f _
  induction f using LaurentPolynomial.induction_on_mul_T with
  | _ f n =>
    have hT : (T (-n : ℤ) : R[T;T⁻¹]) ∈ (⊤ : Ideal R).extendedReesAlgebra := by
      rw [show (-n : ℤ) = n * (-1) by ring, ← T_pow]
      refine Subalgebra.pow_mem _ ?_ n
      have := C_mul_T_neg_one_mem_extendedReesAlgebra (I := (⊤ : Ideal R)) (x := (1 : R))
        Submodule.mem_top
      rwa [map_one, one_mul] at this
    exact Subalgebra.mul_mem _ (toLaurent_mem_extendedReesAlgebra f) hT

section Map

variable {S S' : Type*} [CommRing S] [CommRing S']

/-- The extension of scalars `R[t, t⁻¹] ⟶ S[t, t⁻¹]` along a ring map `φ : R ⟶ S`. -/
noncomputable abbrev laurentMap (φ : R →+* S) : R[T;T⁻¹] →+* S[T;T⁻¹] :=
  AddMonoidAlgebra.mapRingHom ℤ φ

@[simp]
lemma laurentMap_C (φ : R →+* S) (x : R) :
    laurentMap φ (LaurentPolynomial.C x) = LaurentPolynomial.C (φ x) := by
  rw [← single_eq_C, AddMonoidAlgebra.mapRingHom_single]
  rfl

@[simp]
lemma laurentMap_T (φ : R →+* S) (n : ℤ) : laurentMap φ (T n : R[T;T⁻¹]) = T n := by
  rw [T, AddMonoidAlgebra.mapRingHom_single, map_one]
  rfl

lemma laurentMap_mem_extendedReesAlgebra (φ : R →+* S) {J : Ideal S} (h : I.map φ ≤ J)
    {x : R[T;T⁻¹]} (hx : x ∈ I.extendedReesAlgebra) :
    laurentMap φ x ∈ J.extendedReesAlgebra := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain rfl | ⟨x, hx, rfl⟩ := hy
    · rw [laurentMap_T]
      exact T_one_mem_extendedReesAlgebra
    · rw [map_mul, laurentMap_C, laurentMap_T]
      exact C_mul_T_neg_one_mem_extendedReesAlgebra (h (mem_map_of_mem _ hx))
  | algebraMap r =>
    rw [← LaurentPolynomial.C_eq_algebraMap, laurentMap_C]
    exact C_mem_extendedReesAlgebra _
  | add x y _ _ hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => rw [map_mul]; exact Subalgebra.mul_mem _ hx hy

variable (I) in
/-- The functoriality `R[t, I t⁻¹] ⟶ S[t, J t⁻¹]` of the extended Rees algebra along a ring map
`φ : R ⟶ S` with `φ(I) ⊆ J`, induced by `R[t, t⁻¹] ⟶ S[t, t⁻¹]`. -/
noncomputable def extendedReesAlgebraMap (φ : R →+* S) (J : Ideal S) (h : I.map φ ≤ J) :
    I.extendedReesAlgebra →+* J.extendedReesAlgebra :=
  ((laurentMap φ).comp I.extendedReesAlgebra.val.toRingHom).codRestrict
    J.extendedReesAlgebra fun x ↦ laurentMap_mem_extendedReesAlgebra φ h x.2

@[simp]
lemma coe_extendedReesAlgebraMap (φ : R →+* S) (J : Ideal S) (h : I.map φ ≤ J)
    (x : I.extendedReesAlgebra) :
    (I.extendedReesAlgebraMap φ J h x : S[T;T⁻¹]) = laurentMap φ (x : R[T;T⁻¹]) :=
  rfl

lemma extendedReesAlgebraMap_id :
    I.extendedReesAlgebraMap (RingHom.id R) I (by simp) = RingHom.id _ := by
  ext x
  simp [laurentMap]

lemma extendedReesAlgebraMap_comp (φ : R →+* S) (ψ : S →+* S') (J : Ideal S) (K : Ideal S')
    (h : I.map φ ≤ J) (h' : J.map ψ ≤ K) :
    (J.extendedReesAlgebraMap ψ K h').comp (I.extendedReesAlgebraMap φ J h) =
      I.extendedReesAlgebraMap (ψ.comp φ) K
        (by rw [← Ideal.map_map]; exact (Ideal.map_mono h).trans h') := by
  ext x
  simp [laurentMap, AddMonoidAlgebra.mapRingHom_comp]

@[simp]
lemma extendedReesAlgebraMap_T (φ : R →+* S) (J : Ideal S) (h : I.map φ ≤ J) :
    I.extendedReesAlgebraMap φ J h I.extendedReesAlgebraT = J.extendedReesAlgebraT :=
  Subtype.ext (laurentMap_T φ 1)

end Map

section BaseChange

variable (S : Type*) [CommRing S] [Algebra R S]

variable (I) in
/-- The functoriality `R[t, I t⁻¹] ⟶ S[t, (I S) t⁻¹]` along an `R`-algebra `S`, as an `R`-algebra
map. -/
noncomputable def extendedReesAlgebraAlgHom :
    I.extendedReesAlgebra →ₐ[R] (I.map (algebraMap R S)).extendedReesAlgebra where
  __ := I.extendedReesAlgebraMap (algebraMap R S) _ le_rfl
  commutes' r := Subtype.ext <| by
    change laurentMap (algebraMap R S) (algebraMap R R[T;T⁻¹] r) = _
    rw [← LaurentPolynomial.C_eq_algebraMap, laurentMap_C]
    exact (LaurentPolynomial.C_eq_algebraMap _).trans (IsScalarTower.algebraMap_apply _ _ _ _).symm

@[simp]
lemma coe_extendedReesAlgebraAlgHom (x : I.extendedReesAlgebra) :
    (I.extendedReesAlgebraAlgHom S x : S[T;T⁻¹]) = laurentMap (algebraMap R S) x :=
  rfl

/-- **Flat base change of the extended Rees algebra.** Along a flat `R`-algebra `S`, the extended
Rees algebra of `I S` is the base change `S ⊗_R R[t, I t⁻¹]`: tensoring the inclusion
`R[t, I t⁻¹] ⊆ R[t, t⁻¹]` with `S` stays injective, and its image is generated by `t` and the
`x t⁻¹` with `x ∈ I S`. -/
theorem isBaseChange_extendedReesAlgebraAlgHom [Module.Flat R S] :
    IsBaseChange S (I.extendedReesAlgebraAlgHom S).toLinearMap := by
  set J := I.map (algebraMap R S)
  let L : S ⊗[R] I.extendedReesAlgebra →ₐ[S] J.extendedReesAlgebra :=
    Algebra.TensorProduct.lift (Algebra.ofId S _) (I.extendedReesAlgebraAlgHom S)
      fun _ _ ↦ Commute.all _ _
  have hL : ∀ z, (L z : S[T;T⁻¹]) = AddMonoidAlgebra.scalarTensorEquiv R S
      (LinearMap.lTensor S I.extendedReesAlgebra.val.toLinearMap z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a x =>
      simp only [L, Algebra.TensorProduct.lift_tmul, LinearMap.lTensor_tmul,
        AddMonoidAlgebra.scalarTensorEquiv_tmul]
      rw [Algebra.ofId_apply, ← Algebra.smul_def]
      rfl
    | add x y hx hy => simp only [map_add, Subalgebra.coe_add, hx, hy]
  have hinj : Function.Injective L := by
    intro x y hxy
    have := congrArg (fun z : J.extendedReesAlgebra ↦ (z : S[T;T⁻¹])) hxy
    simp only [hL] at this
    exact Module.Flat.lTensor_preserves_injective_linearMap (M := S) _
      Subtype.val_injective ((AddMonoidAlgebra.scalarTensorEquiv R S).injective this)
  have hsurj : Function.Surjective L := by
    let K : Subalgebra S S[T;T⁻¹] := L.range.map J.extendedReesAlgebra.val
    have hK : J.extendedReesAlgebra ≤ K := by
      refine Algebra.adjoin_le ?_
      rintro _ (rfl | ⟨y, hy, rfl⟩)
      · refine ⟨_, ⟨1 ⊗ₜ I.extendedReesAlgebraT, rfl⟩, ?_⟩
        show ((L (1 ⊗ₜ I.extendedReesAlgebraT) : J.extendedReesAlgebra) : S[T;T⁻¹]) = T 1
        simp only [L, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rw [coe_extendedReesAlgebraAlgHom, coe_extendedReesAlgebraT, laurentMap_T]
      · induction hy using Submodule.span_induction with
        | mem y hy =>
          obtain ⟨x, hx, rfl⟩ := hy
          refine ⟨_, ⟨1 ⊗ₜ ⟨_, C_mul_T_neg_one_mem_extendedReesAlgebra hx⟩, rfl⟩, ?_⟩
          show ((L (1 ⊗ₜ ⟨_, C_mul_T_neg_one_mem_extendedReesAlgebra hx⟩) :
            J.extendedReesAlgebra) : S[T;T⁻¹]) = _
          simp only [L, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rw [coe_extendedReesAlgebraAlgHom, map_mul, laurentMap_C, laurentMap_T]
        | zero => simp
        | add y z _ _ hy hz =>
          show LaurentPolynomial.C (y + z) * T (-1) ∈ K
          rw [map_add, add_mul]; exact K.add_mem hy hz
        | smul a y _ hy =>
          show LaurentPolynomial.C (a • y) * T (-1) ∈ K
          rw [smul_eq_mul, map_mul, mul_assoc, LaurentPolynomial.C_eq_algebraMap, ← Algebra.smul_def]
          exact K.smul_mem hy a
    intro z
    obtain ⟨_, ⟨w, rfl⟩, hw⟩ := hK z.2
    exact ⟨w, Subtype.ext hw⟩
  refine IsBaseChange.of_equiv (LinearEquiv.ofBijective L.toLinearMap ⟨hinj, hsurj⟩) fun x ↦ ?_
  show L (1 ⊗ₜ x) = _
  simp only [L, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  rfl

end BaseChange

end Ideal
