/-!
# Regular local rings are domains

We prove that a regular local ring is a domain (Stacks Project Tag 00NP), by induction on the
embedding dimension. If the maximal ideal `𝔪` is nonzero, prime avoidance gives `x ∈ 𝔪` outside
`𝔪²` and outside every minimal prime. Then `R ⧸ (x)` is regular of one dimension less, hence a
domain, so `(x)` is prime; a minimal prime `p ⊆ (x)` satisfies `p = x p` and vanishes by Nakayama.

As a consequence, the irreducible components of the spectrum of a ring whose local rings at
maximal ideals are regular are pairwise disjoint; for a finitely generated algebra over a field
they are open and closed, and they are the connected components.

## Main results

- `IsRegularLocalRing.isDomain`: a regular local ring is an integral domain.
- `IsRegularLocalRing.inf_sq_le_mul`: if `P` and `P ⧸ I` are regular local rings, then
  `I ∩ 𝔪² ⊆ 𝔪 I`, i.e. `I` is generated by elements independent in `𝔪 / 𝔪²`.
- `IsRegularLocalRing.of_isIntegrallyClosed`: an integrally closed noetherian local domain of
  dimension at most one is regular.
- `IsRegularLocalRing.isIntegrallyClosed`: a regular local ring of dimension at most one is
  integrally closed.
- `IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq`: a flat local extension `R → S` of
  noetherian local rings with `𝔪_R S = 𝔪_S` and `R` regular has `S` regular.
- `IsRegularLocalRing.localization_of_etale`: the localizations at primes of an étale algebra
  over a regular ring are regular local rings.
- `PrimeSpectrum.disjoint_of_mem_irreducibleComponents`: irreducible components of a smooth
  affine variety do not meet.
- `IsRegularRing.localization`: a localization of a regular ring is regular.

## Blueprint

- `sk-i-geometry`: regular local rings are domains.
- `lem-sc-regular-local-domain`: regular local rings are domains.
- `lem-wf-smooth-components-disjoint`: irreducible components of a smooth variety do not meet.
-/

@[expose] public section

open IsLocalRing

universe u

/-- In a Noetherian local ring, if `x ∈ 𝔪 \ 𝔪²` then the maximal ideal of `R ⧸ (x)` needs at
least one generator fewer than `𝔪`: extend the image of `x` in `𝔪 / 𝔪²` to a basis and lift it to
generators of `𝔪` by Nakayama; the generator `x` dies in `R ⧸ (x)`. -/
theorem IsLocalRing.spanFinrank_map_quotient_span_singleton_add_one_le {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] {x : R}
    (hx : x ∈ maximalIdeal R) (hx2 : x ∉ maximalIdeal R ^ 2) :
    ((maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x}))).spanFinrank + 1 ≤
      (maximalIdeal R).spanFinrank := by
  classical
  set m := maximalIdeal R
  set v := m.toCotangent ⟨x, hx⟩
  have hv : v ≠ 0 := by rwa [Ne, Ideal.toCotangent_eq_zero]
  have hs : LinearIndepOn (ResidueField R) id {v} := LinearIndepOn.singleton hv
  set B := hs.extend (Set.subset_univ _)
  have hvB : v ∈ B := hs.subset_extend _ rfl
  let b := Module.Basis.extend hs
  have hBfin : B.Finite := Set.toFinite B
  have hBcard : B.ncard = m.spanFinrank := by
    rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, Module.finrank_eq_nat_card_basis b,
      Nat.card_coe_set_eq]
  let g : CotangentSpace R → m := Function.surjInv m.toCotangent_surjective
  have hg (w) : m.toCotangent (g w) = w := Function.surjInv_eq _ w
  set t : Set m := insert ⟨x, hx⟩ (g '' (B \ {v}))
  have himg : m.toCotangent '' t = B := by
    rw [Set.image_insert_eq, Set.image_image]
    simp only [hg, Set.image_id']
    exact Set.insert_sdiff_singleton.trans (Set.insert_eq_of_mem hvB)
  have hspan : Submodule.span R t = ⊤ := by
    rw [← CotangentSpace.span_image_eq_top_iff, himg]
    simpa [b, Module.Basis.coe_extend] using b.span_eq
  have hm : m = Ideal.span (Subtype.val '' t) := by
    change m = Submodule.span R (m.subtype '' t)
    rw [Submodule.span_image, hspan, Submodule.map_top, Submodule.range_subtype]
  have hmap : m.map (Ideal.Quotient.mk (Ideal.span {x})) =
      Ideal.span ((fun w ↦ Ideal.Quotient.mk (Ideal.span {x}) (g w : R)) '' (B \ {v})) := by
    conv_lhs => rw [hm]
    rw [Ideal.map_span, Set.image_image, Set.image_insert_eq,
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self x)]
    unfold Ideal.span
    rw [Submodule.span_insert_zero, Set.image_image]
  rw [hmap]
  calc _ ≤ ((fun w ↦ Ideal.Quotient.mk (Ideal.span {x}) (g w : R)) '' (B \ {v})).ncard + 1 := by
        gcongr
        exact Submodule.spanFinrank_span_le_ncard_of_finite ((hBfin.sdiff).image _)
    _ ≤ (B \ {v}).ncard + 1 := by gcongr; exact Set.ncard_image_le hBfin.sdiff
    _ = m.spanFinrank := by
        rw [Set.ncard_sdiff_singleton_add_one hvB hBfin, hBcard]

/-- If `x ∈ 𝔪 \ 𝔪²` in a regular local ring `R`, then `R ⧸ (x)` is a regular local ring whose
maximal ideal needs one generator fewer: `dim R ≤ dim (R ⧸ (x)) + 1` by Krull's height theorem. -/
theorem IsRegularLocalRing.quotient_span_singleton {R : Type u} [CommRing R] [IsRegularLocalRing R]
    {x : R} (hx : x ∈ maximalIdeal R) (hx2 : x ∉ maximalIdeal R ^ 2) :
    ∃ _ : IsLocalRing (R ⧸ Ideal.span {x}), IsRegularLocalRing (R ⧸ Ideal.span {x}) ∧
      (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank + 1 = (maximalIdeal R).spanFinrank := by
  have hne : Ideal.span {x} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (mem_maximalIdeal x).1 hx
  have : Nontrivial (R ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.2 hne
  have hloc : IsLocalRing (R ⧸ Ideal.span {x}) :=
    .of_surjective' _ Ideal.Quotient.mk_surjective
  have hmax := map_maximalIdeal_of_surjective _ (Ideal.Quotient.mk_surjective (I := Ideal.span {x}))
  have h1 := IsLocalRing.spanFinrank_map_quotient_span_singleton_add_one_le hx hx2
  rw [hmax] at h1
  have h2 : ringKrullDim R ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1 := by
    have := ringKrullDim_le_ringKrullDim_quotient_add_card {x} (by
      simpa [ringJacobson_eq_maximalIdeal] using hx)
    rwa [Finset.coe_singleton, Finset.card_singleton, Nat.cast_one] at this
  have h3 := ringKrullDim_le_spanFinrank_maximalIdeal (R := R ⧸ Ideal.span {x})
  have h4 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  have h5 : (0 : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ Ideal.span {x}) :=
    ringKrullDim_nonneg_of_nontrivial
  set e := (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank
  set d := (maximalIdeal R).spanFinrank
  obtain ⟨n, hn⟩ : ∃ n : ℕ, ringKrullDim (R ⧸ Ideal.span {x}) = n := by
    obtain ⟨a, ha⟩ := WithBot.ne_bot_iff_exists.1 (ne_bot_of_le_ne_bot WithBot.coe_ne_bot h5)
    rw [← ha] at h3
    have ha' : a ≤ e := by exact_mod_cast h3
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, a = n :=
      ⟨a.toNat, (ENat.natCast_toNat (ne_top_of_le_ne_top (ENat.natCast_ne_top e) ha')).symm⟩
    exact ⟨n, ha.symm⟩
  rw [hn] at h2 h3
  rw [← h4] at h2
  have h2' : d ≤ n + 1 := by exact_mod_cast h2
  have h3' : n ≤ e := by exact_mod_cast h3
  refine ⟨hloc, (isRegularLocalRing_iff _).2 ?_, by omega⟩
  rw [hn]
  congr 1
  omega

/-- A regular local ring whose maximal ideal is generated by `n` elements is a domain; this is
proved by induction on `n`, see the module docstring. -/
theorem IsRegularLocalRing.isDomain_of_spanFinrank_eq :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsRegularLocalRing R],
      (maximalIdeal R).spanFinrank = n → IsDomain R
  | 0, R, _, _, h => by
    rw [Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal R).fg_of_isNoetherianRing,
      ← isField_iff_maximalIdeal_eq] at h
    let := h.toField
    infer_instance
  | n + 1, R, _, _, h => by
    classical
    set m := maximalIdeal R
    have hdim : ringKrullDim R = (n + 1 : ℕ) := by
      rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, h]
    have hfin := minimalPrimes.finite_of_isNoetherianRing R
    let f : Option (Ideal R) → Ideal R := fun i ↦ i.elim (m ^ 2) id
    let s : Finset (Option (Ideal R)) := insert none (hfin.toFinset.image some)
    have hnot : ¬ (m : Set R) ⊆ ⋃ i ∈ (s : Set (Option (Ideal R))), (f i : Set R) := by
      rw [Ideal.subset_union_prime none none (by
        rintro (_ | p) hp h1 -
        · exact absurd rfl h1
        · simp only [s, Finset.mem_insert, reduceCtorEq, Finset.mem_image, Set.Finite.mem_toFinset,
            Option.some.injEq, exists_eq_right, false_or] at hp
          exact hp.1.1)]
      rintro ⟨_ | p, hp, hle⟩
      · have : m = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot m m
          m.fg_of_isNoetherianRing (by rw [smul_eq_mul, ← pow_two]; exact hle)
          (by rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top])
        rw [this, Submodule.spanFinrank_bot] at h
        omega
      · simp only [s, Finset.mem_insert, reduceCtorEq, Finset.mem_image, Set.Finite.mem_toFinset,
          Option.some.injEq, exists_eq_right, false_or] at hp
        have hpm : p = m := le_antisymm (le_maximalIdeal hp.1.1.ne_top) hle
        have := Ideal.height_eq_zero_iff.2 (hpm ▸ hp)
        rw [← maximalIdeal_height_eq_ringKrullDim, this] at hdim
        have : (0 : ℕ) = n + 1 := by exact_mod_cast hdim
        omega
    obtain ⟨x, hxm, hx⟩ := Set.not_subset.1 hnot
    simp only [Set.mem_iUnion, not_exists] at hx
    have hx2 : x ∉ m ^ 2 := hx none (by simp [s])
    have hxp (p : Ideal R) (hp : p ∈ minimalPrimes R) : x ∉ p :=
      hx (some p) (by simp only [s, Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff,
        reduceCtorEq, Set.mem_image, Finset.mem_coe, Set.Finite.mem_toFinset, Option.some.injEq,
        exists_eq_right, false_or]; exact hp)
    obtain ⟨_, hreg, hrank⟩ := IsRegularLocalRing.quotient_span_singleton hxm hx2
    have := isDomain_of_spanFinrank_eq n (R ⧸ Ideal.span {x}) (by
      have := hrank.trans h
      omega)
    have hprime := (Ideal.Quotient.isDomain_iff_prime _).1 this
    obtain ⟨p, hp, hpx⟩ := Ideal.exists_minimalPrimes_le (bot_le (a := Ideal.span {x}))
    have hp' : p ∈ minimalPrimes R := hp
    have : p = ⊥ := by
      refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot m p p.fg_of_isNoetherianRing
        (fun y hy ↦ ?_) (by rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top])
      obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.1 (hpx hy)
      have hz : z ∈ p := (hp'.1.1.mem_or_mem hy).resolve_right (hxp p hp')
      rw [mul_comm]
      exact Submodule.smul_mem_smul hxm hz
    have hbot : (⊥ : Ideal R).IsPrime := this ▸ hp'.1.1
    exact IsDomain.of_bot_isPrime R

/-- A regular local ring is an integral domain. (blueprint: `sk-i-geometry`,
`lem-sc-regular-local-domain`) -/
instance IsRegularLocalRing.isDomain (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    IsDomain R :=
  isDomain_of_spanFinrank_eq _ R rfl

/-- If `I ≤ 𝔪²`, then the maximal ideal of `R ⧸ I` needs at least as many generators as `𝔪`:
lifts of generators of the maximal ideal of `R ⧸ I` generate `𝔪` modulo `I ≤ 𝔪²`, hence
generate `𝔪` by Nakayama's lemma. -/
theorem IsLocalRing.spanFinrank_maximalIdeal_le_of_le_sq {R : Type u} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] {I : Ideal R} (hI : I ≤ maximalIdeal R ^ 2) :
    (maximalIdeal R).spanFinrank ≤ ((maximalIdeal R).map (Ideal.Quotient.mk I)).spanFinrank := by
  classical
  set f := Ideal.Quotient.mk I
  set I' := (maximalIdeal R).map f
  obtain ⟨T', hT', hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (p := I') (IsNoetherian.noetherian I')
  set g := Function.surjInv (Ideal.Quotient.mk_surjective (I := I))
  have hg (a) : f (g a) = a := Function.surjInv_eq _ a
  have hIm : I ≤ maximalIdeal R := hI.trans (Ideal.pow_le_self two_ne_zero)
  have h1 : Ideal.map f (Ideal.span (g '' T')) = I' := by
    rw [Ideal.map_span, Set.image_image]
    simp only [hg, Set.image_id']
    exact hspan
  have h2 := Ideal.comap_map_of_surjective' f Ideal.Quotient.mk_surjective
    (Ideal.span (g '' T'))
  rw [h1, Ideal.comap_map_of_surjective' f Ideal.Quotient.mk_surjective, Ideal.mk_ker,
    sup_eq_left.2 hIm] at h2
  have hm : maximalIdeal R = Ideal.span (g '' T') := by
    refine le_antisymm ?_ (h2 ▸ le_sup_left)
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (maximalIdeal R).fg_of_isNoetherianRing
      (I := maximalIdeal R) (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]) ?_
    rw [Ideal.smul_eq_mul, ← pow_two]
    conv_lhs => rw [h2]
    exact sup_le_sup_left hI _
  rw [hm]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (T'.finite_toSet.image g)).trans ?_
  rw [← hT']
  exact (Set.ncard_image_le T'.finite_toSet).trans (Set.ncard_coe_finset T').le

namespace IsRegularLocalRing

/-- Auxiliary statement for `IsRegularLocalRing.inf_sq_le_mul`, by induction on the number of
generators of the maximal ideal: if some `f ∈ I` lies outside `𝔪²`, pass to the regular ring
`P ⧸ (f)`; otherwise `I ≤ 𝔪²` forces `dim P ≤ dim (P ⧸ I)`, hence `I = 0` as `P` is a domain. -/
theorem inf_sq_le_mul_aux : ∀ (e : ℕ) (P : Type u) [CommRing P] [IsRegularLocalRing P],
    (maximalIdeal P).spanFinrank = e → ∀ (I : Ideal P), IsRegularLocalRing (P ⧸ I) →
      I ⊓ maximalIdeal P ^ 2 ≤ maximalIdeal P * I := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro P _ _ he I hI
  set m := maximalIdeal P
  have he' : (maximalIdeal P).spanFinrank = e := he
  have hItop : I ≠ ⊤ := fun h ↦ by
    have : Nontrivial (P ⧸ I) := inferInstance
    exact (Ideal.Quotient.nontrivial_iff.1 this) h
  have hIm : I ≤ m := le_maximalIdeal hItop
  have hmax := map_maximalIdeal_of_surjective _ (Ideal.Quotient.mk_surjective (I := I))
  by_cases hsq : I ≤ m ^ 2
  · suffices I = ⊥ by simp [this]
    by_contra hne
    have h1 := spanFinrank_maximalIdeal_le_of_le_sq hsq
    rw [hmax] at h1
    have h2 := hI.spanFinrank_maximalIdeal
    obtain ⟨y, hyI, hy0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    have hy : y ∈ nonZeroDivisors P := mem_nonZeroDivisors_of_ne_zero hy0
    have h3 : ringKrullDim (P ⧸ I) + 1 ≤ ringKrullDim P := by
      refine le_trans ?_ (ringKrullDim_quotient_succ_le_of_nonZeroDivisor hy)
      gcongr
      exact ringKrullDim_le_of_surjective (Ideal.Quotient.factor
        (Ideal.span_le.2 (Set.singleton_subset_iff.2 hyI))) (Ideal.Quotient.factor_surjective _)
    have h4 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := P)
    rw [← h2, ← h4] at h3
    have : (maximalIdeal (P ⧸ I)).spanFinrank + 1 ≤ m.spanFinrank := by exact_mod_cast h3
    omega
  obtain ⟨f, hfI, hf2⟩ := SetLike.not_le_iff_exists.1 hsq
  obtain ⟨_, hreg', hrank⟩ := IsRegularLocalRing.quotient_span_singleton (hIm hfI) hf2
  have hle : Ideal.span {f} ≤ I := Ideal.span_le.2 (Set.singleton_subset_iff.2 hfI)
  set φ := Ideal.Quotient.mk (Ideal.span {f})
  have : IsRegularLocalRing ((P ⧸ Ideal.span {f}) ⧸ I.map φ) :=
    hI.of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hle).symm
  have key := ih _ (by omega) (P ⧸ Ideal.span {f}) rfl (I.map φ) this
  have hmax' := map_maximalIdeal_of_surjective _
    (Ideal.Quotient.mk_surjective (I := Ideal.span {f}))
  rintro g ⟨hgI, hg2⟩
  have hg' : φ g ∈ I.map φ ⊓ maximalIdeal (P ⧸ Ideal.span {f}) ^ 2 := by
    refine ⟨Ideal.mem_map_of_mem _ hgI, ?_⟩
    rw [← hmax', ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hg2
  have := key hg'
  rw [← hmax', ← Ideal.map_mul, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
    at this
  obtain ⟨h, hh, hgh⟩ := this
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 (Ideal.Quotient.eq.1 hgh.symm)
  have ham : a ∈ m := by
    by_contra hau
    have hu : IsUnit a := (mem_maximalIdeal a).not.1 hau |> not_not.1
    apply hf2
    have hmI : m * I ≤ m ^ 2 := pow_two m ▸ Ideal.mul_mono_right hIm
    have : f = ↑hu.unit⁻¹ * (g - h) := by
      rw [← ha, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.sub_mem _ hg2 (hmI hh))
  have : g = h + a * f := by rw [ha]; ring
  rw [this]
  exact Ideal.add_mem _ hh (Ideal.mul_mem_mul ham hfI)

/-- Let `P` be a regular local ring and `I` an ideal such that `P ⧸ I` is regular. Then `I` is
generated by elements whose images in `𝔪 / 𝔪²` are linearly independent, i.e.
`I ∩ 𝔪² ⊆ 𝔪 I`. -/
theorem inf_sq_le_mul {P : Type u} [CommRing P] [IsRegularLocalRing P] (I : Ideal P)
    [IsRegularLocalRing (P ⧸ I)] : I ⊓ maximalIdeal P ^ 2 ≤ maximalIdeal P * I :=
  inf_sq_le_mul_aux _ P rfl I ‹_›

end IsRegularLocalRing

/-- An integrally closed noetherian local domain of Krull dimension at most one is a regular
local ring: it is a field or, by Stacks `00PD`, a discrete valuation ring.
(blueprint: `lem-sc-normal-dim1-dvr`) -/
theorem IsRegularLocalRing.of_isIntegrallyClosed (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [IsDomain R] [IsIntegrallyClosed R] (h : ringKrullDim R ≤ 1) :
    IsRegularLocalRing R := by
  have : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr (by exact_mod_cast h)
  have : Ring.DimensionLEOne R :=
    ⟨fun {p} hp hp' ↦ Ring.krullDimLE_one_iff_of_noZeroDivisors.mp this p hp hp'⟩
  have : IsDedekindDomain R := { }
  exact .of_isRegularRing_of_isLocalRing R

/-- A regular local ring of Krull dimension at most one is integrally closed: it is a field or
a discrete valuation ring. -/
theorem IsRegularLocalRing.isIntegrallyClosed (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (h : ringKrullDim R ≤ 1) : IsIntegrallyClosed R := by
  by_cases hR : IsField R
  · let := hR.toField
    infer_instance
  have hdim : ringKrullDim R = 1 := by
    refine le_antisymm h (not_lt.mp fun h' ↦ hR ?_)
    have : Ring.KrullDimLE 0 R :=
      Ring.krullDimLE_iff.mpr (ENat.WithBot.lt_add_one_iff.mp (by simpa using h'))
    exact Ring.KrullDimLE.isField_of_isDomain
  have hfin : Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) = 1 := by
    have := (IsRegularLocalRing.iff_finrank_cotangentSpace R).mp inferInstance
    rw [hdim] at this
    exact_mod_cast this
  have : IsDiscreteValuationRing R := ((IsDiscreteValuationRing.TFAE R hR).out 0 5).mpr hfin
  infer_instance

/-- Let `R → S` be a flat local homomorphism of noetherian local rings with `𝔪_R S = 𝔪_S`. If
`R` is regular, so is `S`: `𝔪_S` is generated by `dim R` elements, and `dim R ≤ dim S` by going
down for flat ring maps. -/
theorem IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [IsRegularLocalRing R] [IsLocalRing S] [IsNoetherianRing S]
    [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) : IsRegularLocalRing S := by
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have : (maximalIdeal S).LiesOver (maximalIdeal R) :=
    ⟨(((local_hom_TFAE (algebraMap R S)).out 0 4 rfl rfl).mp inferInstance).symm⟩
  rw [← h, ← maximalIdeal_height_eq_ringKrullDim,
    Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal R) (maximalIdeal S)]
  calc (((maximalIdeal R).map (algebraMap R S)).spanFinrank : WithBot ℕ∞)
      ≤ (maximalIdeal R).spanFinrank := by
        exact_mod_cast Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian _)
    _ = (maximalIdeal R).height := by
        rw [IsRegularLocalRing.spanFinrank_maximalIdeal, maximalIdeal_height_eq_ringKrullDim]
    _ ≤ _ := by exact_mod_cast le_self_add

/-- Let `A` be an étale algebra over a regular ring `R`. The localization of `A` at a prime `P`
is a regular local ring: it is flat over the regular local ring `R_p`, `p = P ∩ R`, and
`p A_P = P A_P` since `A` is unramified at `P`. -/
theorem IsRegularLocalRing.localization_of_etale {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [Algebra.Etale R A] [IsRegularRing R] (P : Ideal A) [P.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime P) := by
  set p := P.comap (algebraMap R A)
  have : P.LiesOver p := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver p P
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing R A
  have : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime P)) :=
    Localization.isLocalHom_localRingHom _ _ _ _
  have : Module.Flat (Localization.AtPrime p) (Localization.AtPrime P) :=
    RingHom.Flat.localRingHom (f := algebraMap R A)
      (RingHom.flat_algebraMap_iff.mpr inferInstance) P p rfl
  refine IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq (R := Localization.AtPrime p) ?_
  rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  exact ((Algebra.isUnramifiedAt_iff_map_eq R p P).mp inferInstance).2

namespace PrimeSpectrum

variable {A : Type*} [CommRing A]

/-- Blueprint `lem-wf-smooth-components-disjoint`: if the localization of `A` at every maximal
ideal is a regular local ring (for instance `A` the coordinate ring of a smooth affine variety),
then distinct irreducible components of `Spec A` are disjoint.

A component is `V(p)` for a minimal prime `p`. If `x ∈ V(p₁) ∩ V(p₂)` and `𝔪 ⊇ x` is maximal, the
domain `A_𝔪` forces every minimal prime inside `𝔪` to equal the kernel of `A → A_𝔪`, so
`p₁ = p₂`. -/
theorem disjoint_of_mem_irreducibleComponents
    (h : ∀ (m : Ideal A) [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m))
    {Z₁ Z₂ : Set (PrimeSpectrum A)} (h₁ : Z₁ ∈ irreducibleComponents (PrimeSpectrum A))
    (h₂ : Z₂ ∈ irreducibleComponents (PrimeSpectrum A)) (hne : Z₁ ≠ Z₂) : Disjoint Z₁ Z₂ := by
  refine Set.disjoint_left.2 fun x hx₁ hx₂ ↦ hne ?_
  have hc₁ := (isClosed_of_mem_irreducibleComponents _ h₁).closure_eq
  have hc₂ := (isClosed_of_mem_irreducibleComponents _ h₂).closure_eq
  have hp₁ : vanishingIdeal Z₁ ∈ minimalPrimes A :=
    vanishingIdeal_mem_minimalPrimes.2 (by rwa [hc₁])
  have hp₂ : vanishingIdeal Z₂ ∈ minimalPrimes A :=
    vanishingIdeal_mem_minimalPrimes.2 (by rwa [hc₂])
  obtain ⟨m, hm, hxm⟩ := x.asIdeal.exists_le_maximal x.2.ne_top
  have := h m
  have hq := RingHom.ker_isPrime (algebraMap A (Localization.AtPrime m))
  have key (p : Ideal A) (hp : p ∈ minimalPrimes A) (hpx : p ≤ x.asIdeal) :
      p = RingHom.ker (algebraMap A (Localization.AtPrime m)) := by
    have hqp : RingHom.ker (algebraMap A (Localization.AtPrime m)) ≤ p := by
      intro a ha
      obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl _ a).1 ha
      have : s * a ∈ p := by rw [hsa]; exact p.zero_mem
      exact (hp.1.1.mem_or_mem this).resolve_left fun hsp ↦ hs (hxm (hpx hsp))
    exact le_antisymm (hp.2 ⟨hq, bot_le⟩ hqp) hqp
  have hle (Z : Set (PrimeSpectrum A)) (hx : x ∈ Z) : vanishingIdeal Z ≤ x.asIdeal :=
    fun f hf ↦ (mem_vanishingIdeal _ _).1 hf x hx
  rw [← hc₁, ← hc₂, ← zeroLocus_vanishingIdeal_eq_closure, ← zeroLocus_vanishingIdeal_eq_closure,
    key _ hp₁ (hle _ hx₁), key _ hp₂ (hle _ hx₂)]

/-- Blueprint `lem-wf-smooth-components-disjoint`, consequence: for a finitely generated algebra `A`
over a field whose local rings at maximal ideals are regular, each irreducible component of
`Spec A` is open and closed, its complement being the finite union of the other components. -/
theorem isClopen_of_mem_irreducibleComponents (k : Type*) [Field k] [Algebra k A]
    [Algebra.FiniteType k A]
    (h : ∀ (m : Ideal A) [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m))
    {Z : Set (PrimeSpectrum A)} (hZ : Z ∈ irreducibleComponents (PrimeSpectrum A)) :
    IsClopen Z := by
  have := Algebra.FiniteType.isNoetherianRing k A
  refine ⟨isClosed_of_mem_irreducibleComponents _ hZ, ?_⟩
  have hfin := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    (α := PrimeSpectrum A)
  have hc : Zᶜ = ⋃₀ (irreducibleComponents (PrimeSpectrum A) \ {Z}) := by
    ext x
    constructor
    · intro hx
      exact ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x,
        fun h ↦ hx ((Set.mem_singleton_iff.1 h) ▸ mem_irreducibleComponent)⟩,
        mem_irreducibleComponent⟩
    · rintro ⟨W, ⟨hW, hWZ⟩, hxW⟩ hxZ
      exact Set.disjoint_left.1 (disjoint_of_mem_irreducibleComponents h hW hZ hWZ) hxW hxZ
  rw [← isClosed_compl_iff, hc, Set.sUnion_eq_biUnion]
  exact (hfin.sdiff).isClosed_biUnion fun W hW ↦ isClosed_of_mem_irreducibleComponents _ hW.1

/-- Blueprint `lem-wf-smooth-components-disjoint`, consequence: for a finitely generated algebra `A`
over a field whose local rings at maximal ideals are regular, the irreducible components of
`Spec A` are its connected components. -/
theorem connectedComponent_eq_of_mem_irreducibleComponents (k : Type*) [Field k] [Algebra k A]
    [Algebra.FiniteType k A]
    (h : ∀ (m : Ideal A) [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m))
    {Z : Set (PrimeSpectrum A)} (hZ : Z ∈ irreducibleComponents (PrimeSpectrum A)) {x}
    (hx : x ∈ Z) : connectedComponent x = Z :=
  subset_antisymm ((isClopen_of_mem_irreducibleComponents k h hZ).connectedComponent_subset hx)
    (hZ.prop.isPreirreducible.isPreconnected
      |>.subset_connectedComponent hx)

end PrimeSpectrum

/-- **One-dimensional regular local rings.** A regular local ring of Krull dimension one is a
discrete valuation ring: its maximal ideal is generated by one element by Nakayama, and it is a
domain (`IsRegularLocalRing.isDomain`), so
`IsDiscreteValuationRing.of_maximalIdeal_eq_span_singleton` applies.

(blueprint: `lem-sc-regular-dim1-dvr`) -/
theorem IsRegularLocalRing.isDiscreteValuationRing (R : Type*) [CommRing R]
    [IsRegularLocalRing R] (h : ringKrullDim R = 1) : IsDiscreteValuationRing R := by
  have hR : ¬IsField R := fun hR ↦ by
    let := hR.toField
    simp [ringKrullDim_eq_zero_of_field] at h
  have hfin : Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) = 1 := by
    have := (IsRegularLocalRing.iff_finrank_cotangentSpace R).mp inferInstance
    rw [h] at this
    exact_mod_cast this
  have hp : (IsLocalRing.maximalIdeal R).IsPrincipal :=
    ((IsDiscreteValuationRing.TFAE R hR).out 5 4).mp hfin
  have hne : IsLocalRing.maximalIdeal R ≠ ⊥ := isField_iff_maximalIdeal_eq.not.mp hR
  refine .of_maximalIdeal_eq_span_singleton (t := hp.generator) (fun ht ↦ hne ?_) ?_
  · rw [← Ideal.span_singleton_generator (IsLocalRing.maximalIdeal R), ht,
      Ideal.span_singleton_eq_bot]
  · exact (Ideal.span_singleton_generator _).symm

/-- A localization of a regular ring is regular: its localizations at primes are localizations of
the original ring at primes. -/
instance IsRegularRing.localization {R : Type*} [CommRing R] [IsRegularRing R] (M : Submonoid R) :
    IsRegularRing (Localization M) := by
  rw [isRegularRing_iff]
  intro p _
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M p).toRingEquiv
