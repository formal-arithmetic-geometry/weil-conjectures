module

public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.RingHom.Flat

/-!
# Ideals generated by a single non-zerodivisor

An ideal is *regular principal* if it is generated by a single non-zerodivisor. This is the
affine-local shape of an invertible ideal sheaf, and unlike plain principality it is stable
under the ring isomorphisms produced by changing an affine chart.

## Main definitions

- `Ideal.IsRegularPrincipal`

## Main results

- `Ideal.IsRegularPrincipal.map_of_bijective`
- `Ideal.IsRegularPrincipal.of_comap_of_bijective`
- `Ideal.IsRegularPrincipal.map_of_flat`
-/

@[expose] public section

namespace Ideal

variable {R S : Type*} [CommRing R] [CommRing S]

/-- An ideal is *regular principal* if it is generated by a single non-zerodivisor. -/
def IsRegularPrincipal (J : Ideal R) : Prop :=
  ∃ s ∈ nonZeroDivisors R, J = Ideal.span {s}

lemma isRegularPrincipal_span_singleton {s : R} (hs : s ∈ nonZeroDivisors R) :
    (Ideal.span {s} : Ideal R).IsRegularPrincipal :=
  ⟨s, hs, rfl⟩

lemma isRegularPrincipal_span_singleton_of_isRegular {s : R} (hs : IsRegular s) :
    (Ideal.span {s} : Ideal R).IsRegularPrincipal :=
  isRegularPrincipal_span_singleton (isRegular_iff_mem_nonZeroDivisors.mp hs)

/-- Regular principality is preserved by a ring isomorphism. -/
lemma IsRegularPrincipal.map_of_bijective {J : Ideal R} (hJ : J.IsRegularPrincipal)
    {f : R →+* S} (hf : Function.Bijective f) : (J.map f).IsRegularPrincipal := by
  obtain ⟨s, hs, rfl⟩ := hJ
  refine ⟨f s, ?_, by rw [Ideal.map_span, Set.image_singleton]⟩
  have key : ∀ x : S, x * f s = 0 → x = 0 := by
    intro x hx
    obtain ⟨y, rfl⟩ := hf.2 x
    have hy : y * s = 0 := hf.1 (by rw [map_mul, hx, map_zero])
    rw [(mem_nonZeroDivisors_iff.mp hs).2 y hy, map_zero]
  exact mem_nonZeroDivisors_iff.mpr ⟨fun x hx ↦ key x (by rwa [mul_comm]), key⟩

/-- Regular principality descends along a ring isomorphism. -/
lemma IsRegularPrincipal.of_comap_of_bijective {J : Ideal S} {f : R →+* S}
    (hf : Function.Bijective f) (hJ : (J.comap f).IsRegularPrincipal) :
    J.IsRegularPrincipal := by
  rw [← Ideal.map_comap_of_surjective f hf.2 J]
  exact hJ.map_of_bijective hf

/-- Regular principality is preserved by pulling back along a ring isomorphism. -/
lemma IsRegularPrincipal.comap_of_bijective {J : Ideal S} (hJ : J.IsRegularPrincipal)
    {f : R →+* S} (hf : Function.Bijective f) : (J.comap f).IsRegularPrincipal := by
  refine of_comap_of_bijective (f := ((RingEquiv.ofBijective f hf).symm : S →+* R))
    (RingEquiv.bijective _) ?_
  rwa [Ideal.comap_comap,
    show f.comp ((RingEquiv.ofBijective f hf).symm : S →+* R) = RingHom.id S from
      RingHom.ext fun x ↦ (RingEquiv.ofBijective f hf).apply_symm_apply x,
    Ideal.comap_id]

/-- The image of a non-zerodivisor under a flat ring homomorphism is a non-zerodivisor:
multiplication by it is scalar multiplication on a flat module. -/
lemma _root_.RingHom.Flat.map_mem_nonZeroDivisors {f : R →+* S} (hf : f.Flat) {s : R}
    (hs : s ∈ nonZeroDivisors R) : f s ∈ nonZeroDivisors S := by
  letI := f.toAlgebra
  haveI : Module.Flat R S := hf
  have hreg : IsSMulRegular S s := Module.Flat.isSMulRegular_of_nonZeroDivisors hs
  have key : ∀ x : S, f s * x = 0 → x = 0 := fun x hx ↦
    hreg (by simpa [Algebra.smul_def, RingHom.algebraMap_toAlgebra] using hx)
  exact mem_nonZeroDivisors_iff.mpr ⟨key, fun x hx ↦ key x (by rwa [mul_comm])⟩

/-- **Regular principality is stable under flat base change.** Extending an ideal generated by
a non-zerodivisor along a flat ring homomorphism again gives such an ideal: the generator
stays a non-zerodivisor because a flat module is torsion-free. -/
lemma IsRegularPrincipal.map_of_flat {J : Ideal R} (hJ : J.IsRegularPrincipal) {f : R →+* S}
    (hf : f.Flat) : (J.map f).IsRegularPrincipal := by
  obtain ⟨s, hs, rfl⟩ := hJ
  exact ⟨f s, hf.map_mem_nonZeroDivisors hs, by rw [Ideal.map_span, Set.image_singleton]⟩

end Ideal
