module

public import Mathlib.RingTheory.Ideal.Span

/-!
# Transferring membership in a span along a partially defined additive map

`Ideal.mem_span_range_of_forall_mem`: if an ideal `I` of `A` is generated by a family
`gen`, and `F` assigns to every element of `I` a value in a commutative ring `M`
additively and compatibly with multiplication by ring elements through a map `c : A → M`,
then the value of `F` at any element of `I` lies in the ideal of `M` generated by the
values of `F` on `gen`.

This is the common skeleton of the two span-induction arguments used for the Rees algebra
of a blow-up centre: the degree-one elements `a · X` and the chart slopes `b / a`.
-/

@[expose] public section

namespace Ideal

variable {A : Type*} [CommRing A] {I : Ideal A} {M : Type*} [CommRing M]

/-- Let `I` be generated by `gen` and let `F` assign to every element of `I` a value in a
commutative ring `M`, additively, sending `0` to `0`, and turning multiplication by `r : A`
into multiplication by `c r`. Then the value of `F` at any element of `I` lies in the ideal
generated by the values of `F` on `gen`. -/
theorem mem_span_range_of_forall_mem {c : A → M} {F : ∀ b : A, b ∈ I → M}
    (hzero : ∀ h : (0 : A) ∈ I, F 0 h = 0)
    (hadd : ∀ {x y : A} (hx : x ∈ I) (hy : y ∈ I) (hxy : x + y ∈ I),
      F (x + y) hxy = F x hx + F y hy)
    (hmul : ∀ (r : A) {x : A} (hx : x ∈ I) (hrx : r * x ∈ I),
      F (r * x) hrx = c r * F x hx)
    {κ : Type*} {gen : κ → A} (hgen : ∀ k, gen k ∈ I)
    (hspan : Ideal.span (Set.range gen) = I) {b : A} (hb : b ∈ I) :
    F b hb ∈ Ideal.span (Set.range fun k ↦ F (gen k) (hgen k)) := by
  have key : ∀ x, x ∈ Ideal.span (Set.range gen) → ∀ hx : x ∈ I,
      F x hx ∈ Ideal.span (Set.range fun k ↦ F (gen k) (hgen k)) := by
    intro x hx₀
    induction hx₀ using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨k, rfl⟩ := hy
        exact fun _ ↦ Ideal.subset_span ⟨k, rfl⟩
    | zero => exact fun h ↦ (hzero h) ▸ zero_mem _
    | add x y hx hy ihx ihy =>
        intro hxy
        have hxI : x ∈ I := hspan ▸ hx
        have hyI : y ∈ I := hspan ▸ hy
        rw [hadd hxI hyI hxy]
        exact add_mem (ihx hxI) (ihy hyI)
    | smul r x hx ihx =>
        intro hrx
        have hxI : x ∈ I := hspan ▸ hx
        have h : F (r • x) hrx = c r * F x hxI := hmul r hxI hrx
        rw [h]
        exact Ideal.mul_mem_left _ _ (ihx hxI)
  exact key b (hspan.symm ▸ hb) hb

end Ideal
