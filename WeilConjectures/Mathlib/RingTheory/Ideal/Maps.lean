module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Extensions of ideals along a ring homomorphism

Since `Ideal.map φ N` is the span of `φ '' N`, finite generation of `Ideal.map φ N` is
witnessed by finitely many elements of `N` itself. Applied to a finite family of ring
homomorphisms simultaneously, this is the algebraic core of the finite-type extension
theorem for quasi-coherent ideal sheaves (Stacks Project Tag 01PF).

The same description of `Ideal.map φ N` as a span also computes the image of the
linear-combination map of a finite family `e` of elements of the source, and shows that
coefficients in `Ideal.map φ J` annihilate the images of the `e i` as soon as `J` annihilates
the `e i`; and it describes the relations between the `e i` themselves when `J * I = ⊥` for an
ideal `I` containing them.

Extension of ideals also controls the transport of `I • N` along a map `M →ₛₗ[σ] M'` which is
semilinear over a ring map `σ`, the variant of `Submodule.map_smul''` needed when the two
modules live over different rings.

## Main results

- `Ideal.exists_finset_subset_span_image_eq`: a finitely generated `Ideal.map φ N` is
  generated by the image of a finite subset of `N`;
- `Ideal.exists_fg_le_map_eq`: if `N.map (φ i)` is finitely generated for each member of a
  finite family of ring homomorphisms, a single finitely generated subideal `N' ≤ N`
  realizes all of these extensions simultaneously;
- `Ideal.sum_mul_eq_zero_of_forall_mem_map`: if the ideal `J` annihilates each `e i`, every
  family of coefficients in `J.map φ` is a relation between the `φ (e i)`;
- `Ideal.ker_linearCombination_eq_pi`: if `J * I = ⊥`, if the `e i` lie in `I` and if every
  relation between the `e i` has its coefficients in `J`, the relations between the `e i` are
  exactly the families of coefficients in `J`;
- `Ideal.range_linearCombination_algebraMap`: the image of `r ↦ ∑ i, r i * e i` over an
  `R`-algebra `S` is the extension of the ideal spanned by the `e i`;
- `Submodule.smul_le_comap_smul`: the extension of an ideal along `σ : R →+* S` controls the
  image of `I • N` under a map semilinear over `σ`. This is the semilinear counterpart of
  `Submodule.map_smul''`, which is the case of an `R`-linear map.
-/

@[expose] public section

namespace Ideal

variable {R : Type*} [CommSemiring R]

/-- The generators of a finitely generated extension `N.map φ` can be taken to be images of
elements of `N`: the extension is the span of the image of a finite subset of `N`. -/
theorem exists_finset_subset_span_image_eq {S : Type*} [CommSemiring S] (N : Ideal R)
    (φ : R →+* S) (H : (N.map φ).FG) :
    ∃ T : Finset R, (T : Set R) ⊆ (N : Set R) ∧ Ideal.span (φ '' T) = N.map φ := by
  classical
  obtain ⟨G, hG⟩ := H
  have hspan : Ideal.span (φ '' (N : Set R)) = N.map φ := by
    rw [← Ideal.map_span, Ideal.span_eq]
  -- Each of the finitely many generators of `N.map φ` lies in the span of finitely many
  -- elements of `φ '' N`; picking preimages of those gives the finite subset of `N`.
  have hmem : ∀ y ∈ G, y ∈ Ideal.span (φ '' (N : Set R)) := by
    intro y hy
    rw [hspan, ← hG]
    exact Ideal.subset_span hy
  choose T hTsub hTmem using fun y : G ↦ Submodule.mem_span_finite_of_mem_span (hmem y y.2)
  choose pre hpreN hpre using
    fun (y : G) (z : {z // z ∈ T y}) ↦ hTsub y (Finset.mem_coe.mpr z.2)
  refine ⟨G.attach.biUnion fun y ↦ (T y).attach.image (pre y), fun x hx ↦ ?_,
    le_antisymm ?_ ?_⟩
  · obtain ⟨y, -, hy⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.mp hy
    exact hpreN y z
  · rw [Ideal.span_le]
    rintro w ⟨x, hx, rfl⟩
    obtain ⟨y, -, hy⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.mp hy
    exact Ideal.mem_map_of_mem _ (hpreN y z)
  · rw [← hG, Ideal.span_le]
    intro y hy
    have hsub : (T ⟨y, hy⟩ : Set S) ⊆
        φ '' (G.attach.biUnion fun y ↦ (T y).attach.image (pre y)) := by
      intro z hz
      refine ⟨pre ⟨y, hy⟩ ⟨z, Finset.mem_coe.mp hz⟩, ?_, hpre _ _⟩
      rw [Finset.mem_coe, Finset.mem_biUnion]
      exact ⟨⟨y, hy⟩, Finset.mem_attach _ _,
        Finset.mem_image.mpr ⟨_, Finset.mem_attach _ _, rfl⟩⟩
    exact Ideal.span_mono hsub (hTmem ⟨y, hy⟩)

/-- Clearing denominators: if the extensions of an ideal `N` along a finite family of
ring homomorphisms are all finitely generated, then a single finitely generated subideal
`N' ≤ N` realizes all of them (Stacks Project Tag 01PF, affine core). -/
theorem exists_fg_le_map_eq {ι : Type*} (N : Ideal R) (s : Finset ι) (S : ι → Type*)
    [∀ i, CommSemiring (S i)] (φ : ∀ i, R →+* S i) (H : ∀ i ∈ s, (N.map (φ i)).FG) :
    ∃ N' : Ideal R, N' ≤ N ∧ N'.FG ∧ ∀ i ∈ s, N'.map (φ i) = N.map (φ i) := by
  classical
  choose T hTsub hTspan using
    fun i : s ↦ N.exists_finset_subset_span_image_eq (φ i) (H i i.2)
  have hle : ((s.attach.biUnion T : Finset R) : Set R) ⊆ (N : Set R) := by
    intro x hx
    obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    exact hTsub i (Finset.mem_coe.mpr hi)
  refine ⟨Ideal.span (s.attach.biUnion T : Finset R), Ideal.span_le.mpr hle, ⟨_, rfl⟩,
    fun i hi ↦ le_antisymm (Ideal.map_mono (Ideal.span_le.mpr hle)) ?_⟩
  rw [← hTspan ⟨i, hi⟩]
  refine Ideal.span_le.mpr ?_
  rintro z ⟨x, hx, rfl⟩
  refine Ideal.mem_map_of_mem _ (Ideal.subset_span ?_)
  rw [Finset.mem_coe, Finset.mem_biUnion]
  exact ⟨⟨i, hi⟩, Finset.mem_attach _ _, Finset.mem_coe.mp hx⟩

section LinearCombination

variable {S : Type*} [CommSemiring S] {ι : Type*} [Fintype ι] {J : Ideal R} {e : ι → R}

/-- If every element of the ideal `J` annihilates each member of a finite family `e`, then
every family of coefficients in the extension `J.map φ` is a relation between the `φ (e i)`. -/
theorem sum_mul_eq_zero_of_forall_mem_map (φ : R →+* S) (he : ∀ i, ∀ m ∈ J, m * e i = 0)
    {r : ι → S} (hr : ∀ i, r i ∈ J.map φ) : ∑ i, r i * φ (e i) = 0 := by
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  have key : ∀ x ∈ Submodule.span S (φ '' (J : Set R)), x * φ (e i) = 0 := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      rw [← map_mul, he i m hm, map_zero]
    | zero => rw [zero_mul]
    | add x y _ _ hx hy => rw [add_mul, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_eq_mul, mul_assoc, hx, mul_zero]
  exact key _ (hr i)

/-- If `J * I = ⊥`, if a finite family `e` takes its values in `I`, and if every relation
between the `e i` has all its coefficients in `J`, then the relations between the `e i` are
exactly the families of coefficients in `J`. -/
theorem ker_linearCombination_eq_pi {I : Ideal R} (hJI : J * I = ⊥) (heI : ∀ i, e i ∈ I)
    (he : ∀ c : ι → R, ∑ i, c i * e i = 0 → ∀ i, c i ∈ J) :
    LinearMap.ker (Fintype.linearCombination R e) = Submodule.pi Set.univ fun _ ↦ J := by
  ext c
  simp only [LinearMap.mem_ker, Fintype.linearCombination_apply, smul_eq_mul, Submodule.mem_pi,
    Set.mem_univ, forall_const]
  refine ⟨he c, fun hc ↦ Finset.sum_eq_zero fun i _ ↦ mem_bot.mp ?_⟩
  exact hJI ▸ mul_mem_mul (hc i) (heI i)

/-- The image of the linear-combination map `r ↦ ∑ i, r i * e i` of a finite family `e` of
elements of `R`, over an `R`-algebra `S`, is the extension of the ideal spanned by the `e i`. -/
theorem range_linearCombination_algebraMap [Algebra R S] :
    LinearMap.range (Fintype.linearCombination S fun i ↦ algebraMap R S (e i)) =
      (span (Set.range e)).map (algebraMap R S) := by
  rw [Fintype.range_linearCombination, map_span, ← Set.range_comp]
  rfl

end LinearCombination

end Ideal

namespace Submodule

variable {R S M M' : Type*} [Semiring R] [Semiring S] [AddCommMonoid M] [Module R M]
  [AddCommMonoid M'] [Module S M']

/-- **`I • N` transports along a semilinear map.** A map `f : M →ₛₗ[σ] M'` carrying the
submodule `N` into the submodule `P` carries `I • N` into `J • P`, as soon as the ring map `σ`
carries the ideal `I` into the ideal `J`.

This is the semilinear counterpart of `Submodule.map_smul''`, which is the case of an
`R`-linear map. It is stated with `Submodule.comap` rather than `Submodule.map` because the
latter would require `σ` to be surjective. -/
theorem smul_le_comap_smul {σ : R →+* S} (f : M →ₛₗ[σ] M') {I : Ideal R} {J : Ideal S}
    (hIJ : Ideal.map σ I ≤ J) {N : Submodule R M} {P : Submodule S M'} (hNP : N ≤ P.comap f) :
    I • N ≤ (J • P).comap f :=
  smul_le.2 fun r hr n hn ↦ by
    rw [mem_comap, map_smulₛₗ]
    exact smul_mem_smul (hIJ (Ideal.mem_map_of_mem _ hr)) (hNP hn)

/-- **Membership in `I • ⊤` transports along a semilinear map**, the case `N = P = ⊤` of
`Submodule.smul_le_comap_smul`. -/
theorem mem_smul_top_of_semilinear {σ : R →+* S} (f : M →ₛₗ[σ] M') {I : Ideal R} {J : Ideal S}
    (hIJ : Ideal.map σ I ≤ J) {z : M} (hz : z ∈ I • (⊤ : Submodule R M)) :
    f z ∈ J • (⊤ : Submodule S M') :=
  smul_le_comap_smul f hIJ (by simp) hz

end Submodule
