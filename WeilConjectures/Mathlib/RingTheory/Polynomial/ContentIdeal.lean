module

public import Mathlib.RingTheory.Polynomial.ContentIdeal

/-!
# Further facts about the content ideal of a polynomial

## Main results

- `Polynomial.span_range_coeff`: the content ideal is generated by all coefficients.
- `Polynomial.contentIdeal_prod_eq_top`: a finite product of polynomials whose content ideals
  are the unit ideal has unit content ideal.
- `Polynomial.contentIdeal_C_mul_X_add_C`: the content ideal of `x X + y` is `(x, y)`.
-/

@[expose] public section

namespace Polynomial

variable {R : Type*} [CommRing R]

/-- The content ideal of a polynomial is the ideal generated by all of its coefficients
(including the zero ones). -/
lemma span_range_coeff (p : R[X]) : Ideal.span (Set.range p.coeff) = p.contentIdeal := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨k, rfl⟩
    exact coeff_mem_contentIdeal p k
  · intro r hr
    obtain ⟨k, -, rfl⟩ := mem_coeffs_iff.mp (Finset.mem_coe.mp hr)
    exact Ideal.subset_span ⟨k, rfl⟩

/-- A finite product of polynomials whose content ideals are the unit ideal has unit content
ideal. -/
lemma contentIdeal_prod_eq_top {ι : Type*} (s : Finset ι) (f : ι → R[X])
    (h : ∀ i ∈ s, (f i).contentIdeal = ⊤) : (∏ i ∈ s, f i).contentIdeal = ⊤ := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha]
    exact contentIdeal_mul_eq_top_of_contentIdeal_eq_top (h a (by simp))
      (ih fun i hi ↦ h i (by simp [hi]))

/-- The content ideal of the linear polynomial `x X + y` is the ideal `(x, y)`. -/
lemma contentIdeal_C_mul_X_add_C (x y : R) :
    (C x * X + C y).contentIdeal = Ideal.span {x, y} := by
  rw [← span_range_coeff]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨k, rfl⟩
    rcases k with _ | _ | k
    · rw [coeff_add, coeff_C_mul_X, coeff_C_zero, if_neg zero_ne_one, zero_add]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    · rw [coeff_add, coeff_C_mul_X, coeff_C, if_pos rfl, if_neg (by omega), add_zero]
      exact Ideal.subset_span (Set.mem_insert _ _)
    · rw [coeff_add, coeff_C_mul_X, coeff_C, if_neg (by omega), if_neg (by omega), add_zero]
      exact zero_mem _
  · rintro _ (rfl | rfl)
    · exact Ideal.subset_span ⟨1, by rw [coeff_add, coeff_C_mul_X, coeff_C, if_pos rfl,
        if_neg one_ne_zero, add_zero]⟩
    · exact Ideal.subset_span ⟨0, by rw [coeff_add, coeff_C_mul_X, coeff_C_zero,
        if_neg zero_ne_one, zero_add]⟩

end Polynomial
