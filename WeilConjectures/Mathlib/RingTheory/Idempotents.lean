module

public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Jacobson.Ideal
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.RingTheory.Noetherian.Defs

/-!
# Idempotents in local rings and in the Jacobson radical

In a local ring, the only idempotent elements are `0` and `1`.
More generally, any idempotent lying in the Jacobson radical of an arbitrary
commutative ring must be zero.

In a Noetherian ring, a family of nonzero orthogonal idempotents is finite
(`OrthogonalIdempotents.finite_of_isNoetherianRing`).
-/

@[expose] public section

/-- An idempotent element of a commutative ring that lies in the Jacobson radical
(of the zero ideal) is zero. -/
lemma IsIdempotentElem.eq_zero_of_mem_jacobson_bot {R : Type*} [CommRing R]
    {e : R} (he : IsIdempotentElem e) (hmem : e ∈ Ideal.jacobson (⊥ : Ideal R)) :
    e = 0 := by
  rw [Ideal.mem_jacobson_bot] at hmem
  have hu : IsUnit (1 - e) := by simpa [mul_neg_one, neg_add_eq_sub] using hmem (-1)
  exact hu.mul_left_eq_zero.mp he.mul_one_sub_self

/-- In a local ring, every idempotent element is `0` or `1`. -/
lemma IsIdempotentElem.eq_zero_or_one_of_isLocalRing {R : Type*} [CommRing R]
    [IsLocalRing R] {e : R} (he : IsIdempotentElem e) : e = 0 ∨ e = 1 := by
  rcases Classical.em (e ∈ IsLocalRing.maximalIdeal R) with hmem | hnmem
  · exact .inl <| he.eq_zero_of_mem_jacobson_bot <| by
      rwa [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  · rw [IsLocalRing.notMem_maximalIdeal] at hnmem
    exact .inr (sub_eq_zero.mp (hnmem.mul_right_eq_zero.mp he.mul_one_sub_self)).symm

/-- In a Noetherian ring, a family of pairwise orthogonal nonzero idempotents is finite. The
ideal generated by the family is generated by finitely many of its members, and an idempotent
`e i` outside such a finite subfamily is killed by every element of the ideal it generates,
in particular by itself. -/
theorem OrthogonalIdempotents.finite_of_isNoetherianRing {R : Type*} [CommRing R]
    [IsNoetherianRing R] {I : Type*} {e : I → R} (he : OrthogonalIdempotents e)
    (hne : ∀ i, e i ≠ 0) : Finite I := by
  have hinj : Function.Injective e := fun i j hij ↦ by
    by_contra h
    exact hne i (by rw [← (he.idem i).eq]; nth_rw 2 [hij]; exact he.ortho h)
  by_contra hI
  rw [not_finite_iff_infinite] at hI
  obtain ⟨s, hs, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (Set.range e)).1
    (IsNoetherian.noetherian (Ideal.span (Set.range e)))
  obtain ⟨i, hi⟩ : ∃ i, e i ∉ s := by
    by_contra! h
    exact Set.infinite_range_of_injective hinj
      (s.finite_toSet.subset fun x ⟨i, hx⟩ ↦ hx ▸ h i)
  have hmem : e i ∈ Submodule.span R (s : Set R) := hspan ▸ Submodule.subset_span ⟨i, rfl⟩
  have key : ∀ x ∈ Submodule.span R (s : Set R), e i * x = 0 := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hs hy
      exact he.ortho (fun hij ↦ hi (hij ▸ hy))
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]
  exact hne i (by simpa [(he.idem i).eq] using key _ hmem)
