module

public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import WeilConjectures.Mathlib.Algebra.MvPolynomial.Basic
public import WeilConjectures.Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization

/-!
# The total-degree grading on `MvPolynomial`

For the total-degree grading `MvPolynomial.gradedAlgebra` on `MvPolynomial σ R`, the
degree-zero part is the ring of constants and the irrelevant ideal is the ideal generated by
the variables. We record the resulting ring isomorphism, the description of the irrelevant
ideal and, for a finite index type, that `MvPolynomial σ R` is of finite type over its
degree-zero part.

We then identify the degree-zero part of the localization of `MvPolynomial σ R` away from a
variable `Xᵢ`: it is the polynomial ring in the variables `Xⱼ / Xᵢ` for `j ≠ i`. This is the
algebraic form of the statement that the standard affine chart `D₊(Xᵢ)` of the projective
space `Proj R[Xⱼ : j ∈ σ]` is an affine space over `R`.

## Main definitions

- `MvPolynomial.homogeneousSubmoduleZeroEquiv` — the isomorphism
  `R ≃+* MvPolynomial.homogeneousSubmodule σ R 0`, given by `r ↦ C r`.
- `MvPolynomial.dehomogenizeX` — dehomogenisation with respect to `Xᵢ`, the `R`-algebra map
  `R[Xⱼ : j ∈ σ] → R[Yⱼ : j ≠ i]` sending `Xᵢ` to `1` and `Xⱼ` to `Yⱼ`.
- `MvPolynomial.homogeneousLocalizationAwayXEquiv` — the `R`-algebra isomorphism
  `HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) ≃ₐ[R] R[Yⱼ : j ≠ i]`
  sending the class of `Xⱼ / Xᵢ` to `Yⱼ`.

## Main results

- `MvPolynomial.toIdeal_irrelevant_homogeneousSubmodule` — the irrelevant ideal of the
  total-degree grading is the ideal generated by the variables.
- `MvPolynomial.adjoin_range_X_eq_top` — `MvPolynomial σ R` is generated as an algebra over
  its degree-zero part by the variables.
- `MvPolynomial.instFiniteTypeHomogeneousSubmoduleZero` — for `Finite σ`, the ring
  `MvPolynomial σ R` is of finite type over `MvPolynomial.homogeneousSubmodule σ R 0`.
- `MvPolynomial.IsHomogeneous.eval₂Hom_const_mul` — scaling every variable by a constant `c`
  scales the value of a form of degree `n` by `c ^ n`.
- `MvPolynomial.awayXRatio` — the ratio `Xₖ / Xᵢ` in the degree-zero localization
  `(R[Xⱼ]_{Xᵢ})₀`, an affine coordinate of the standard chart `D₊(Xᵢ)`.
- `MvPolynomial.closure_range_awayXRatio_eq_top` — over a ring of integers, `(R[Xⱼ]_{Xᵢ})₀` is
  generated as a ring by the ratios `Xₖ / Xᵢ`.

## Implementation notes

The total-degree grading is not a global instance in Mathlib, since one may want to grade
`MvPolynomial σ R` by another weight function, so it is enabled locally here.

The isomorphism `homogeneousLocalizationAwayXEquiv` is built from two mutually inverse
`R`-algebra maps: dehomogenisation `R[Xⱼ] → R[Yⱼ : j ≠ i]` induces the forward map by the
universal property of the localization, since it sends `Xᵢ` to the unit `1`; the inverse is
`aeval` at the classes `Xⱼ / Xᵢ`. That the two are inverse to each other on the localization
side comes down to `IsHomogeneous.eval₂Hom_const_mul`: substituting `Xⱼ ↦ Xⱼ / Xᵢ` into a form
of degree `n` gives that form divided by `Xᵢ ^ n`. It is stated with `@[no_expose]`, so
downstream files should compute with the rewrite lemmas below rather than unfold it.
-/

@[expose] public section

universe u

namespace MvPolynomial

section GradeZero

attribute [local instance] MvPolynomial.gradedAlgebra

variable (σ : Type*) (R : Type*) [CommRing R]

/-- The base ring is isomorphic to the degree-zero piece of `R[X]` for the total-degree
grading, via `r ↦ C r`. -/
noncomputable def homogeneousSubmoduleZeroEquiv : R ≃+* homogeneousSubmodule σ R 0 where
  toFun r := ⟨C r, isHomogeneous_C σ r⟩
  invFun p := coeff 0 (p : MvPolynomial σ R)
  left_inv r := by simp
  right_inv p := Subtype.ext
    (totalDegree_eq_zero_iff_eq_C.mp ((totalDegree_zero_iff_isHomogeneous _).mpr p.2)).symm
  map_mul' r s := Subtype.ext (by simp)
  map_add' r s := Subtype.ext (by simp)

@[simp]
lemma coe_homogeneousSubmoduleZeroEquiv (r : R) :
    (homogeneousSubmoduleZeroEquiv σ R r : MvPolynomial σ R) = C r :=
  rfl

/-- The irrelevant ideal of the total-degree grading on `R[X]` is the ideal generated by the
variables. -/
theorem toIdeal_irrelevant_homogeneousSubmodule :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule σ R)).toIdeal =
      Ideal.span (Set.range (X : σ → MvPolynomial σ R)) := by
  have h1 : Ideal.span (Set.range (X : σ → MvPolynomial σ R)) = idealOfVars σ R ^ 1 :=
    (pow_one _).symm
  ext p
  rw [h1, mem_pow_idealOfVars_iff']
  simp only [HomogeneousIdeal.toIdeal_irrelevant, RingHom.mem_ker,
    GradedRing.projZeroRingHom_apply]
  rw [show ((DirectSum.decompose (homogeneousSubmodule σ R) p 0 : homogeneousSubmodule σ R 0) :
      MvPolynomial σ R) = homogeneousComponent 0 p from decomposition.decompose'_apply p 0,
    homogeneousComponent_zero, C_eq_zero]
  refine ⟨fun h d hd ↦ ?_, fun h ↦ h 0 (by simp)⟩
  obtain rfl : d = 0 := by
    simpa [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff] using hd
  exact h

/-- `R[X]` is generated over the degree-zero part of the total-degree grading by the
variables. -/
lemma adjoin_range_X_eq_top :
    Algebra.adjoin (homogeneousSubmodule σ R 0) (Set.range (X : σ → MvPolynomial σ R)) = ⊤ := by
  rw [eq_top_iff]
  rintro p -
  induction p using MvPolynomial.induction_on with
  | C r => exact Subalgebra.algebraMap_mem _ (homogeneousSubmoduleZeroEquiv σ R r)
  | add p q hp hq => exact add_mem hp hq
  | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- For a finite index type, `R[X]` is generated over the degree-zero part of the
total-degree grading by the variables. -/
instance [Finite σ] : Algebra.FiniteType (homogeneousSubmodule σ R 0) (MvPolynomial σ R) := by
  classical
  cases nonempty_fintype σ
  refine ⟨⟨Finset.univ.image (X : σ → MvPolynomial σ R), ?_⟩⟩
  rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, adjoin_range_X_eq_top]

end GradeZero

lemma IsHomogeneous.eval₂Hom_const_mul {σ R S : Type*} [CommSemiring R]
    [CommSemiring S] {φ : MvPolynomial σ R} {n : ℕ} (hφ : φ.IsHomogeneous n) (f : R →+* S) (c : S)
    (g : σ → S) : eval₂Hom f (fun j ↦ c * g j) φ = c ^ n * eval₂Hom f g φ := by
  classical
  simp only [coe_eval₂Hom, eval₂_eq]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun s hs ↦ ?_
  rw [Finset.prod_congr rfl fun j _ ↦ mul_pow c (g j) (s j), Finset.prod_mul_distrib,
    Finset.prod_pow_eq_pow_sum, ← hφ.degree_eq_sum_deg_support hs]
  ring

/-- Every variable is homogeneous of degree one for the total-degree grading. -/
lemma X_mem_homogeneousSubmodule_one (R : Type*) [CommSemiring R] {σ : Type*} (j : σ) :
    X j ∈ homogeneousSubmodule σ R 1 :=
  isHomogeneous_X R j

section Ratio

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type*) [CommRing R] {σ : Type*}

/-- The ratio `Xₖ / Xᵢ` of two variables, as an element of the degree-zero part
`(R[Xⱼ]_{Xᵢ})₀` of the localization of `R[Xⱼ]` at `Xᵢ`. These ratios are the affine
coordinates of the standard chart `D₊(Xᵢ)` of a projective space. -/
noncomputable def awayXRatio (i k : σ) :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X k)
    (by simpa using X_mem_homogeneousSubmodule_one R k)

/-- The element `Xₖ / Xᵢ` exhibiting `(R[X]_{XᵢXₖ})₀` as a localization of `(R[X]_{Xᵢ})₀` is the
ratio `Xₖ / Xᵢ`. -/
lemma isLocalizationElem_X (i k : σ) :
    HomogeneousLocalization.Away.isLocalizationElem
        (X_mem_homogeneousSubmodule_one R i) (X_mem_homogeneousSubmodule_one R k) =
      awayXRatio R i k := by
  apply HomogeneousLocalization.val_injective
  simp [HomogeneousLocalization.Away.val_mk, awayXRatio]

@[simp]
lemma awayXRatio_self (i : σ) : awayXRatio R i i = 1 :=
  HomogeneousLocalization.Away.mk_self _ _ _

end Ratio

section Chart

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type*) [CommRing R] {σ : Type*} [DecidableEq σ] (i : σ)

/-- Dehomogenisation with respect to the variable `Xᵢ`: the `R`-algebra map
`R[Xⱼ : j ∈ σ] → R[Yⱼ : j ≠ i]` sending `Xᵢ` to `1` and `Xⱼ` to `Yⱼ` for `j ≠ i`. -/
noncomputable def dehomogenizeX : MvPolynomial σ R →ₐ[R] MvPolynomial {j : σ // j ≠ i} R :=
  aeval fun j ↦ if h : j = i then 1 else X ⟨j, h⟩

@[simp]
lemma dehomogenizeX_X_self : dehomogenizeX R i (X i) = 1 := by
  simp [dehomogenizeX]

@[simp]
lemma dehomogenizeX_X_of_ne {j : σ} (h : j ≠ i) : dehomogenizeX R i (X j) = X ⟨j, h⟩ := by
  simp [dehomogenizeX, h]

/-- The `R`-algebra map `R[Yⱼ : j ≠ i] → (R[Xⱼ]_{Xᵢ})₀` sending `Yⱼ` to the class of
`Xⱼ / Xᵢ`. This is the inverse of `homogeneousLocalizationAwayXEquiv`. -/
private noncomputable def toAwayX : MvPolynomial {j : σ // j ≠ i} R →ₐ[R]
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  aeval fun j ↦ HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1
    (X j.1) (by simpa using X_mem_homogeneousSubmodule_one R j.1)

/-- `toAwayX` followed by the inclusion of `(R[Xⱼ]_{Xᵢ})₀` into the full localization
`R[Xⱼ]_{Xᵢ}`, where the computations below take place. -/
private noncomputable def valToAwayX :
    MvPolynomial {j : σ // j ≠ i} R →+* Localization.Away (X i : MvPolynomial σ R) :=
  (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i))
    (Localization.Away (X i : MvPolynomial σ R))).comp (toAwayX R i).toRingHom

/-- Substituting `Xⱼ ↦ Xⱼ / Xᵢ` for all `j`, including `j = i`, factors through
dehomogenisation with respect to `Xᵢ`. -/
private lemma valToAwayX_comp_dehomogenizeX :
    (valToAwayX R i).comp (dehomogenizeX R i).toRingHom =
      eval₂Hom
        ((algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R))).comp C)
        (fun j : σ ↦ IsLocalization.Away.invSelf
            (S := Localization.Away (X i : MvPolynomial σ R)) (X i : MvPolynomial σ R) *
          algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R)) (X j)) := by
  apply ringHom_ext
  · intro r
    change valToAwayX R i (dehomogenizeX R i (C r)) = _
    simp [valToAwayX, toAwayX, dehomogenizeX, Localization.mk_one_eq_algebraMap]
  · intro j
    change valToAwayX R i (dehomogenizeX R i (X j)) = _
    by_cases h : j = i
    · subst h
      simp [valToAwayX, IsLocalization.Away.invSelf]
    · rw [dehomogenizeX_X_of_ne R i h]
      simp only [valToAwayX, toAwayX, RingHom.coe_comp, Function.comp_apply,
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X,
        HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        eval₂Hom_X', pow_one, IsLocalization.Away.invSelf, ← Localization.mk_eq_mk',
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]

/-- Substituting `Xⱼ ↦ Xⱼ / Xᵢ` into a form `a` of degree `n` gives `a / Xᵢ ^ n`. -/
private lemma valToAwayX_dehomogenizeX {n : ℕ} {a : MvPolynomial σ R}
    (ha : a.IsHomogeneous n) :
    valToAwayX R i (dehomogenizeX R i a) =
      Localization.mk a (⟨(X i : MvPolynomial σ R) ^ n, n, rfl⟩ :
        Submonoid.powers (X i : MvPolynomial σ R)) := by
  have h₁ : valToAwayX R i (dehomogenizeX R i a) =
      ((valToAwayX R i).comp (dehomogenizeX R i).toRingHom) a := rfl
  have h₂ : eval₂Hom
      ((algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R))).comp C)
      (fun j : σ ↦ algebraMap (MvPolynomial σ R)
        (Localization.Away (X i : MvPolynomial σ R)) (X j)) =
      algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R)) :=
    ringHom_ext (fun r ↦ by simp) (fun j ↦ by simp)
  rw [h₁, valToAwayX_comp_dehomogenizeX R i, IsHomogeneous.eval₂Hom_const_mul ha, h₂]
  simp [IsLocalization.Away.invSelf, ← Localization.mk_eq_mk',
    ← Localization.mk_one_eq_algebraMap, Localization.mk_pow, Localization.mk_mul]

/-- Dehomogenising a form of degree `n` and homogenising back recovers the class of
`a / Xᵢ ^ n`. -/
private lemma toAwayX_dehomogenizeX (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    toAwayX R i (dehomogenizeX R i a) =
      HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) n a ha := by
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.Away.val_mk]
  exact valToAwayX_dehomogenizeX R i (by simpa using ha)

/-- The ring map `(R[Xⱼ]_{Xᵢ})₀ → R[Yⱼ : j ≠ i]` induced by dehomogenisation, which sends
`Xᵢ` to the unit `1`. -/
private noncomputable def ofAwayXRingHom :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) →+*
      MvPolynomial {j : σ // j ≠ i} R :=
  (Localization.awayLift (dehomogenizeX R i).toRingHom (X i) (by simp)).comp
    (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i))
      (Localization.Away (X i : MvPolynomial σ R)))

/-- `ofAwayXRingHom` sends the class of `a / Xᵢ ^ n` to the dehomogenisation of `a`. -/
private lemma ofAwayXRingHom_awayMk (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    ofAwayXRingHom R i (HomogeneousLocalization.Away.mk _
      (X_mem_homogeneousSubmodule_one R i) n a ha) = dehomogenizeX R i a := by
  rw [ofAwayXRingHom, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk (v := 1) (hv := by simp)]
  simp

omit [DecidableEq σ] in
/-- The structure map of `(R[Xⱼ]_{Xᵢ})₀` as an `R`-algebra is the class of `C r / Xᵢ ^ 0`. -/
private lemma awayMk_zero_C (r : R) (h) :
    HomogeneousLocalization.Away.mk (homogeneousSubmodule σ R)
        (X_mem_homogeneousSubmodule_one R i) 0 (C r) h =
      algebraMap R (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i)) r := by
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_algebraMap]
  simp only [algebraMap_eq, pow_zero]
  rfl

/-- `ofAwayXRingHom` as a map of `R`-algebras. -/
private noncomputable def ofAwayX :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) →ₐ[R]
      MvPolynomial {j : σ // j ≠ i} R where
  __ := ofAwayXRingHom R i
  commutes' r := by
    change ofAwayXRingHom R i (algebraMap R _ r) = _
    rw [← awayMk_zero_C R i r (by simp), ofAwayXRingHom_awayMk]
    simp [dehomogenizeX, algebraMap_eq]

/-- **The standard affine chart of projective space is an affine space**, algebraically: the
degree-zero part of the localization of the polynomial ring `R[Xⱼ : j ∈ σ]`, graded by total
degree, away from the variable `Xᵢ`, is the polynomial ring `R[Yⱼ : j ≠ i]`, via
`Yⱼ ↦ Xⱼ / Xᵢ`. -/
@[no_expose]
noncomputable def homogeneousLocalizationAwayXEquiv :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) ≃ₐ[R]
      MvPolynomial {j : σ // j ≠ i} R :=
  AlgEquiv.ofAlgHom (ofAwayX R i) (toAwayX R i)
    (by
      refine algHom_ext fun j ↦ ?_
      change ofAwayXRingHom R i (toAwayX R i (X j)) = _
      rw [toAwayX, aeval_X, ofAwayXRingHom_awayMk, dehomogenizeX_X_of_ne R i j.2]
      simp)
    (by
      refine AlgHom.ext fun z ↦ ?_
      obtain ⟨n, a, ha, rfl⟩ :=
        HomogeneousLocalization.Away.mk_surjective _ (X_mem_homogeneousSubmodule_one R i) z
      change toAwayX R i (ofAwayXRingHom R i _) = _
      rw [ofAwayXRingHom_awayMk, toAwayX_dehomogenizeX]
      rfl)

/-- The isomorphism sends the class of `a / Xᵢ ^ n`, for `a` a form of degree `n`, to the
dehomogenisation of `a`. -/
@[simp]
lemma homogeneousLocalizationAwayXEquiv_awayMk (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    homogeneousLocalizationAwayXEquiv R i
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) n a ha) =
      dehomogenizeX R i a :=
  ofAwayXRingHom_awayMk R i n a ha

/-- The inverse isomorphism sends `Yⱼ` to the class of `Xⱼ / Xᵢ`. -/
@[simp]
lemma homogeneousLocalizationAwayXEquiv_symm_X (j : {j : σ // j ≠ i}) :
    (homogeneousLocalizationAwayXEquiv R i).symm (X j) =
      HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X j.1)
        (by simpa using X_mem_homogeneousSubmodule_one R j.1) := by
  rw [AlgEquiv.symm_apply_eq, homogeneousLocalizationAwayXEquiv_awayMk,
    dehomogenizeX_X_of_ne R i j.2]

/-- The class of `Xᵢ / Xᵢ` is sent to `1`. -/
lemma homogeneousLocalizationAwayXEquiv_awayMk_X_self (h) :
    homogeneousLocalizationAwayXEquiv R i
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X i) h) = 1 := by
  rw [homogeneousLocalizationAwayXEquiv_awayMk, dehomogenizeX_X_self]

/-- The class of `Xⱼ / Xᵢ` is sent to `Yⱼ`, for `j ≠ i`. -/
lemma homogeneousLocalizationAwayXEquiv_awayMk_X_of_ne {j : σ} (hj : j ≠ i) (h) :
    homogeneousLocalizationAwayXEquiv R i
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X j) h) =
      X ⟨j, hj⟩ := by
  rw [homogeneousLocalizationAwayXEquiv_awayMk, dehomogenizeX_X_of_ne R i hj]

/-- The isomorphism is a map of `R`-algebras: it sends the class of a constant `r` to `C r`. -/
lemma homogeneousLocalizationAwayXEquiv_algebraMap (r : R) :
    homogeneousLocalizationAwayXEquiv R i
      (algebraMap R (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i)) r) = C r := by
  rw [AlgEquiv.commutes, algebraMap_eq]

end Chart


section Generators

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **The standard affine chart of projective space is generated by the affine coordinates**:
if every element of `R` is an integer, the degree-zero part of the localization of `R[Xⱼ]`
away from the variable `Xᵢ` is generated as a ring by the ratios `Xₖ / Xᵢ`. -/
theorem closure_range_awayXRatio_eq_top (R : Type*) [CommRing R] {σ : Type*}
    (hR : Function.Surjective ((↑) : ℤ → R)) (i : σ) :
    Subring.closure (Set.range (awayXRatio R i)) = ⊤ := by
  classical
  set E := (homogeneousLocalizationAwayXEquiv R i).toRingEquiv.toRingHom with hEdef
  have hE : ∀ k : σ, E (awayXRatio R i k) = dehomogenizeX R i (X k) :=
    fun k ↦ homogeneousLocalizationAwayXEquiv_awayMk R i 1 (X k) _
  have himg : Subring.map E (Subring.closure (Set.range (awayXRatio R i))) = ⊤ := by
    rw [RingHom.map_closure, ← top_le_iff, ← closure_range_X_eq_top {j : σ // j ≠ i} hR]
    refine Subring.closure_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    exact Subring.subset_closure ⟨awayXRatio R i j.1, ⟨j.1, rfl⟩, by
      rw [hE, dehomogenizeX_X_of_ne R i j.2]⟩
  have hinj : Function.Injective E := (homogeneousLocalizationAwayXEquiv R i).injective
  have h := congrArg (Subring.comap E) himg
  rwa [Subring.comap_map_eq_self_of_injective hinj, Subring.comap_top] at h

end Generators

end MvPolynomial
