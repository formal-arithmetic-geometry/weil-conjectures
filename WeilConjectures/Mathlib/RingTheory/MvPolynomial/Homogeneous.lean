/-!
# The total-degree grading on `MvPolynomial`

For the total-degree grading `MvPolynomial.gradedAlgebra` on `MvPolynomial σ R`, the
degree-zero part is the ring of constants and the irrelevant ideal is the ideal generated by
the variables. We record the resulting ring isomorphism, the description of the irrelevant
ideal and, for a finite index type, that `MvPolynomial σ R` is of finite type over its
degree-zero part.

We then identify the degree-zero part of the localization of `MvPolynomial σ R` away from a
variable `Xᵢ`: it is the polynomial ring in the variables `Xⱼ / Xᵢ` for `j ≠ i`. This is the
algebraic form of the statement that the standard affine chart `D₊(Xᵢ)` of the projective
space `Proj R[Xⱼ : j ∈ σ]` is an affine space over `R`.

## Main definitions

- `MvPolynomial.homogeneousSubmoduleZeroEquiv` — the isomorphism
  `R ≃+* MvPolynomial.homogeneousSubmodule σ R 0`, given by `r ↦ C r`.
- `MvPolynomial.dehomogenizeX` — dehomogenisation with respect to `Xᵢ`, the `R`-algebra map
  `R[Xⱼ : j ∈ σ] → R[Yⱼ : j ≠ i]` sending `Xᵢ` to `1` and `Xⱼ` to `Yⱼ`.
- `MvPolynomial.homogeneousLocalizationAwayXEquiv` — the `R`-algebra isomorphism
  `HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) ≃ₐ[R] R[Yⱼ : j ≠ i]`
  sending the class of `Xⱼ / Xᵢ` to `Yⱼ`.

## Main results

- `MvPolynomial.toIdeal_irrelevant_homogeneousSubmodule` — the irrelevant ideal of the
  total-degree grading is the ideal generated by the variables.
- `MvPolynomial.adjoin_range_X_eq_top` — `MvPolynomial σ R` is generated as an algebra over
  its degree-zero part by the variables.
- `MvPolynomial.instFiniteTypeHomogeneousSubmoduleZero` — for `Finite σ`, the ring
  `MvPolynomial σ R` is of finite type over `MvPolynomial.homogeneousSubmodule σ R 0`.
- `MvPolynomial.IsHomogeneous.eval₂Hom_const_mul` — scaling every variable by a constant `c`
  scales the value of a form of degree `n` by `c ^ n`.
- `MvPolynomial.IsHomogeneous.det` — the determinant of an `n × n` matrix of forms of degree
  `d` is a form of degree `n * d`.
- `MvPolynomial.awayXRatio` — the ratio `Xₖ / Xᵢ` in the degree-zero localization
  `(R[Xⱼ]_{Xᵢ})₀`, an affine coordinate of the standard chart `D₊(Xᵢ)`.
- `MvPolynomial.closure_range_awayXRatio_eq_top` — over a ring of integers, `(R[Xⱼ]_{Xᵢ})₀` is
  generated as a ring by the ratios `Xₖ / Xᵢ`.
- `MvPolynomial.awayMonomialBasis` — the degree-zero localization of `R[Xᵢ]` away from
  `∏_{i ∈ s} Xᵢ` is free over `R` on the Laurent monomials `xᵉ` with `∑ eᵢ = 0` and `eᵢ ≥ 0`
  for `i ∉ s` (`MvPolynomial.awayMonomial`).

## Implementation notes

The total-degree grading is not a global instance in Mathlib, since one may want to grade
`MvPolynomial σ R` by another weight function, so it is enabled locally here.

The isomorphism `homogeneousLocalizationAwayXEquiv` is built from two mutually inverse
`R`-algebra maps: dehomogenisation `R[Xⱼ] → R[Yⱼ : j ≠ i]` induces the forward map by the
universal property of the localization, since it sends `Xᵢ` to the unit `1`; the inverse is
`aeval` at the classes `Xⱼ / Xᵢ`. That the two are inverse to each other on the localization
side comes down to `IsHomogeneous.eval₂Hom_const_mul`: substituting `Xⱼ ↦ Xⱼ / Xᵢ` into a form
of degree `n` gives that form divided by `Xᵢ ^ n`. It is stated with `@[no_expose]`, so
downstream files should compute with the rewrite lemmas below rather than unfold it.
-/

@[expose] public section

universe u

namespace MvPolynomial

section GradeZero

attribute [local instance] MvPolynomial.gradedAlgebra

variable (σ : Type*) (R : Type*) [CommRing R]

/-- The base ring is isomorphic to the degree-zero piece of `R[X]` for the total-degree
grading, via `r ↦ C r`. -/
noncomputable def homogeneousSubmoduleZeroEquiv : R ≃+* homogeneousSubmodule σ R 0 where
  toFun r := ⟨C r, isHomogeneous_C σ r⟩
  invFun p := coeff 0 (p : MvPolynomial σ R)
  left_inv r := by simp
  right_inv p := Subtype.ext
    (totalDegree_eq_zero_iff_eq_C.mp ((totalDegree_zero_iff_isHomogeneous _).mpr p.2)).symm
  map_mul' r s := Subtype.ext (by simp)
  map_add' r s := Subtype.ext (by simp)

@[simp]
lemma coe_homogeneousSubmoduleZeroEquiv (r : R) :
    (homogeneousSubmoduleZeroEquiv σ R r : MvPolynomial σ R) = C r :=
  rfl

/-- The irrelevant ideal of the total-degree grading on `R[X]` is the ideal generated by the
variables. -/
theorem toIdeal_irrelevant_homogeneousSubmodule :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule σ R)).toIdeal =
      Ideal.span (Set.range (X : σ → MvPolynomial σ R)) := by
  have h1 : Ideal.span (Set.range (X : σ → MvPolynomial σ R)) = idealOfVars σ R ^ 1 :=
    (pow_one _).symm
  ext p
  rw [h1, mem_pow_idealOfVars_iff']
  simp only [HomogeneousIdeal.toIdeal_irrelevant, RingHom.mem_ker,
    GradedRing.projZeroRingHom_apply]
  rw [show ((DirectSum.decompose (homogeneousSubmodule σ R) p 0 : homogeneousSubmodule σ R 0) :
      MvPolynomial σ R) = homogeneousComponent 0 p from decomposition.decompose'_apply p 0,
    homogeneousComponent_zero, C_eq_zero]
  refine ⟨fun h d hd ↦ ?_, fun h ↦ h 0 (by simp)⟩
  obtain rfl : d = 0 := by
    simpa [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff] using hd
  exact h

/-- `R[X]` is generated over the degree-zero part of the total-degree grading by the
variables. -/
lemma adjoin_range_X_eq_top :
    Algebra.adjoin (homogeneousSubmodule σ R 0) (Set.range (X : σ → MvPolynomial σ R)) = ⊤ := by
  rw [eq_top_iff]
  rintro p -
  induction p using MvPolynomial.induction_on with
  | C r => exact Subalgebra.algebraMap_mem _ (homogeneousSubmoduleZeroEquiv σ R r)
  | add p q hp hq => exact add_mem hp hq
  | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- For a finite index type, `R[X]` is generated over the degree-zero part of the
total-degree grading by the variables. -/
instance [Finite σ] : Algebra.FiniteType (homogeneousSubmodule σ R 0) (MvPolynomial σ R) := by
  classical
  cases nonempty_fintype σ
  refine ⟨⟨Finset.univ.image (X : σ → MvPolynomial σ R), ?_⟩⟩
  rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, adjoin_range_X_eq_top]

end GradeZero

lemma IsHomogeneous.eval₂Hom_const_mul {σ R S : Type*} [CommSemiring R]
    [CommSemiring S] {φ : MvPolynomial σ R} {n : ℕ} (hφ : φ.IsHomogeneous n) (f : R →+* S) (c : S)
    (g : σ → S) : eval₂Hom f (fun j ↦ c * g j) φ = c ^ n * eval₂Hom f g φ := by
  classical
  simp only [coe_eval₂Hom, eval₂_eq]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun s hs ↦ ?_
  rw [Finset.prod_congr rfl fun j _ ↦ mul_pow c (g j) (s j), Finset.prod_mul_distrib,
    Finset.prod_pow_eq_pow_sum, ← hφ.degree_eq_sum_deg_support hs]
  ring

/-- Evaluating a polynomial that is homogeneous of degree `n` at `c • g` gives `c ^ n` times
its value at `g`. The `eval₂` form of `MvPolynomial.IsHomogeneous.eval₂Hom_const_mul`. -/
theorem IsHomogeneous.eval₂_const_mul {σ R S : Type*} [CommSemiring R] [CommSemiring S]
    {φ : MvPolynomial σ R} {n : ℕ} (hφ : φ.IsHomogeneous n) (f : R →+* S) (c : S) (g : σ → S) :
    _root_.MvPolynomial.eval₂ f (fun i ↦ c * g i) φ = c ^ n * _root_.MvPolynomial.eval₂ f g φ :=
  hφ.eval₂Hom_const_mul f c g

/-- Every variable is homogeneous of degree one for the total-degree grading. -/
lemma X_mem_homogeneousSubmodule_one (R : Type*) [CommSemiring R] {σ : Type*} (j : σ) :
    X j ∈ homogeneousSubmodule σ R 1 :=
  isHomogeneous_X R j

section Ratio

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type*) [CommRing R] {σ : Type*}

/-- The ratio `Xₖ / Xᵢ` of two variables, as an element of the degree-zero part
`(R[Xⱼ]_{Xᵢ})₀` of the localization of `R[Xⱼ]` at `Xᵢ`. These ratios are the affine
coordinates of the standard chart `D₊(Xᵢ)` of a projective space. -/
noncomputable def awayXRatio (i k : σ) :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X k)
    (by simpa using X_mem_homogeneousSubmodule_one R k)

/-- The element `Xₖ / Xᵢ` exhibiting `(R[X]_{XᵢXₖ})₀` as a localization of `(R[X]_{Xᵢ})₀` is the
ratio `Xₖ / Xᵢ`. -/
lemma isLocalizationElem_X (i k : σ) :
    HomogeneousLocalization.Away.isLocalizationElem
        (X_mem_homogeneousSubmodule_one R i) (X_mem_homogeneousSubmodule_one R k) =
      awayXRatio R i k := by
  apply HomogeneousLocalization.val_injective
  simp [HomogeneousLocalization.Away.val_mk, awayXRatio]

@[simp]
lemma awayXRatio_self (i : σ) : awayXRatio R i i = 1 :=
  HomogeneousLocalization.Away.mk_self _ _ _

end Ratio

section Chart

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type*) [CommRing R] {σ : Type*} [DecidableEq σ] (i : σ)

/-- Dehomogenisation with respect to the variable `Xᵢ`: the `R`-algebra map
`R[Xⱼ : j ∈ σ] → R[Yⱼ : j ≠ i]` sending `Xᵢ` to `1` and `Xⱼ` to `Yⱼ` for `j ≠ i`. -/
noncomputable def dehomogenizeX : MvPolynomial σ R →ₐ[R] MvPolynomial {j : σ // j ≠ i} R :=
  aeval fun j ↦ if h : j = i then 1 else X ⟨j, h⟩

@[simp]
lemma dehomogenizeX_X_self : dehomogenizeX R i (X i) = 1 := by
  simp [dehomogenizeX]

@[simp]
lemma dehomogenizeX_X_of_ne {j : σ} (h : j ≠ i) : dehomogenizeX R i (X j) = X ⟨j, h⟩ := by
  simp [dehomogenizeX, h]

/-- The `R`-algebra map `R[Yⱼ : j ≠ i] → (R[Xⱼ]_{Xᵢ})₀` sending `Yⱼ` to the class of
`Xⱼ / Xᵢ`. This is the inverse of `homogeneousLocalizationAwayXEquiv`. -/
private noncomputable def toAwayX : MvPolynomial {j : σ // j ≠ i} R →ₐ[R]
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  aeval fun j ↦ HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1
    (X j.1) (by simpa using X_mem_homogeneousSubmodule_one R j.1)

/-- `toAwayX` followed by the inclusion of `(R[Xⱼ]_{Xᵢ})₀` into the full localization
`R[Xⱼ]_{Xᵢ}`, where the computations below take place. -/
private noncomputable def valToAwayX :
    MvPolynomial {j : σ // j ≠ i} R →+* Localization.Away (X i : MvPolynomial σ R) :=
  (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i))
    (Localization.Away (X i : MvPolynomial σ R))).comp (toAwayX R i).toRingHom

/-- Substituting `Xⱼ ↦ Xⱼ / Xᵢ` for all `j`, including `j = i`, factors through
dehomogenisation with respect to `Xᵢ`. -/
private lemma valToAwayX_comp_dehomogenizeX :
    (valToAwayX R i).comp (dehomogenizeX R i).toRingHom =
      eval₂Hom
        ((algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R))).comp C)
        (fun j : σ ↦ IsLocalization.Away.invSelf
            (S := Localization.Away (X i : MvPolynomial σ R)) (X i : MvPolynomial σ R) *
          algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R)) (X j)) := by
  apply ringHom_ext
  · intro r
    change valToAwayX R i (dehomogenizeX R i (C r)) = _
    simp [valToAwayX, toAwayX, dehomogenizeX, Localization.mk_one_eq_algebraMap]
  · intro j
    change valToAwayX R i (dehomogenizeX R i (X j)) = _
    by_cases h : j = i
    · subst h
      simp [valToAwayX, IsLocalization.Away.invSelf]
    · rw [dehomogenizeX_X_of_ne R i h]
      simp only [valToAwayX, toAwayX, RingHom.coe_comp, Function.comp_apply,
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X,
        HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        eval₂Hom_X', pow_one, IsLocalization.Away.invSelf, ← Localization.mk_eq_mk',
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]

/-- Substituting `Xⱼ ↦ Xⱼ / Xᵢ` into a form `a` of degree `n` gives `a / Xᵢ ^ n`. -/
private lemma valToAwayX_dehomogenizeX {n : ℕ} {a : MvPolynomial σ R}
    (ha : a.IsHomogeneous n) :
    valToAwayX R i (dehomogenizeX R i a) =
      Localization.mk a (⟨(X i : MvPolynomial σ R) ^ n, n, rfl⟩ :
        Submonoid.powers (X i : MvPolynomial σ R)) := by
  have h₁ : valToAwayX R i (dehomogenizeX R i a) =
      ((valToAwayX R i).comp (dehomogenizeX R i).toRingHom) a := rfl
  have h₂ : eval₂Hom
      ((algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R))).comp C)
      (fun j : σ ↦ algebraMap (MvPolynomial σ R)
        (Localization.Away (X i : MvPolynomial σ R)) (X j)) =
      algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R)) :=
    ringHom_ext (fun r ↦ by simp) (fun j ↦ by simp)
  rw [h₁, valToAwayX_comp_dehomogenizeX R i, IsHomogeneous.eval₂Hom_const_mul ha, h₂]
  simp [IsLocalization.Away.invSelf, ← Localization.mk_eq_mk',
    ← Localization.mk_one_eq_algebraMap, Localization.mk_pow, Localization.mk_mul]

/-- Dehomogenising a form of degree `n` and homogenising back recovers the class of
`a / Xᵢ ^ n`. -/
private lemma toAwayX_dehomogenizeX (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    toAwayX R i (dehomogenizeX R i a) =
      HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) n a ha := by
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.Away.val_mk]
  exact valToAwayX_dehomogenizeX R i (by simpa using ha)

/-- The ring map `(R[Xⱼ]_{Xᵢ})₀ → R[Yⱼ : j ≠ i]` induced by dehomogenisation, which sends
`Xᵢ` to the unit `1`. -/
private noncomputable def ofAwayXRingHom :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) →+*
      MvPolynomial {j : σ // j ≠ i} R :=
  (Localization.awayLift (dehomogenizeX R i).toRingHom (X i) (by simp)).comp
    (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i))
      (Localization.Away (X i : MvPolynomial σ R)))

/-- `ofAwayXRingHom` sends the class of `a / Xᵢ ^ n` to the dehomogenisation of `a`. -/
private lemma ofAwayXRingHom_awayMk (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    ofAwayXRingHom R i (HomogeneousLocalization.Away.mk _
      (X_mem_homogeneousSubmodule_one R i) n a ha) = dehomogenizeX R i a := by
  rw [ofAwayXRingHom, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk (v := 1) (hv := by simp)]
  simp

omit [DecidableEq σ] in
/-- The structure map of `(R[Xⱼ]_{Xᵢ})₀` as an `R`-algebra is the class of `C r / Xᵢ ^ 0`. -/
private lemma awayMk_zero_C (r : R) (h) :
    HomogeneousLocalization.Away.mk (homogeneousSubmodule σ R)
        (X_mem_homogeneousSubmodule_one R i) 0 (C r) h =
      algebraMap R (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i)) r := by
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_algebraMap]
  simp only [algebraMap_eq, pow_zero]
  rfl

/-- `ofAwayXRingHom` as a map of `R`-algebras. -/
private noncomputable def ofAwayX :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) →ₐ[R]
      MvPolynomial {j : σ // j ≠ i} R where
  __ := ofAwayXRingHom R i
  commutes' r := by
    change ofAwayXRingHom R i (algebraMap R _ r) = _
    rw [← awayMk_zero_C R i r (by simp), ofAwayXRingHom_awayMk]
    simp [dehomogenizeX, algebraMap_eq]

/-- **The standard affine chart of projective space is an affine space**, algebraically: the
degree-zero part of the localization of the polynomial ring `R[Xⱼ : j ∈ σ]`, graded by total
degree, away from the variable `Xᵢ`, is the polynomial ring `R[Yⱼ : j ≠ i]`, via
`Yⱼ ↦ Xⱼ / Xᵢ`. -/
@[no_expose]
noncomputable def homogeneousLocalizationAwayXEquiv :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) ≃ₐ[R]
      MvPolynomial {j : σ // j ≠ i} R :=
  AlgEquiv.ofAlgHom (ofAwayX R i) (toAwayX R i)
    (by
      refine algHom_ext fun j ↦ ?_
      change ofAwayXRingHom R i (toAwayX R i (X j)) = _
      rw [toAwayX, aeval_X, ofAwayXRingHom_awayMk, dehomogenizeX_X_of_ne R i j.2]
      simp)
    (by
      refine AlgHom.ext fun z ↦ ?_
      obtain ⟨n, a, ha, rfl⟩ :=
        HomogeneousLocalization.Away.mk_surjective _ (X_mem_homogeneousSubmodule_one R i) z
      change toAwayX R i (ofAwayXRingHom R i _) = _
      rw [ofAwayXRingHom_awayMk, toAwayX_dehomogenizeX]
      rfl)

/-- The isomorphism sends the class of `a / Xᵢ ^ n`, for `a` a form of degree `n`, to the
dehomogenisation of `a`. -/
@[simp]
lemma homogeneousLocalizationAwayXEquiv_awayMk (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    homogeneousLocalizationAwayXEquiv R i
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) n a ha) =
      dehomogenizeX R i a :=
  ofAwayXRingHom_awayMk R i n a ha

/-- The inverse isomorphism sends `Yⱼ` to the class of `Xⱼ / Xᵢ`. -/
@[simp]
lemma homogeneousLocalizationAwayXEquiv_symm_X (j : {j : σ // j ≠ i}) :
    (homogeneousLocalizationAwayXEquiv R i).symm (X j) =
      HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X j.1)
        (by simpa using X_mem_homogeneousSubmodule_one R j.1) := by
  rw [AlgEquiv.symm_apply_eq, homogeneousLocalizationAwayXEquiv_awayMk,
    dehomogenizeX_X_of_ne R i j.2]

/-- The class of `Xᵢ / Xᵢ` is sent to `1`. -/
lemma homogeneousLocalizationAwayXEquiv_awayMk_X_self (h) :
    homogeneousLocalizationAwayXEquiv R i
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X i) h) = 1 := by
  rw [homogeneousLocalizationAwayXEquiv_awayMk, dehomogenizeX_X_self]

/-- The class of `Xⱼ / Xᵢ` is sent to `Yⱼ`, for `j ≠ i`. -/
lemma homogeneousLocalizationAwayXEquiv_awayMk_X_of_ne {j : σ} (hj : j ≠ i) (h) :
    homogeneousLocalizationAwayXEquiv R i
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one R i) 1 (X j) h) =
      X ⟨j, hj⟩ := by
  rw [homogeneousLocalizationAwayXEquiv_awayMk, dehomogenizeX_X_of_ne R i hj]

/-- The isomorphism is a map of `R`-algebras: it sends the class of a constant `r` to `C r`. -/
lemma homogeneousLocalizationAwayXEquiv_algebraMap (r : R) :
    homogeneousLocalizationAwayXEquiv R i
      (algebraMap R (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i)) r) = C r := by
  rw [AlgEquiv.commutes, algebraMap_eq]

end Chart


section Generators

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **The standard affine chart of projective space is generated by the affine coordinates**:
if every element of `R` is an integer, the degree-zero part of the localization of `R[Xⱼ]`
away from the variable `Xᵢ` is generated as a ring by the ratios `Xₖ / Xᵢ`. -/
theorem closure_range_awayXRatio_eq_top (R : Type*) [CommRing R] {σ : Type*}
    (hR : Function.Surjective ((↑) : ℤ → R)) (i : σ) :
    Subring.closure (Set.range (awayXRatio R i)) = ⊤ := by
  classical
  set E := (homogeneousLocalizationAwayXEquiv R i).toRingEquiv.toRingHom with hEdef
  have hE : ∀ k : σ, E (awayXRatio R i k) = dehomogenizeX R i (X k) :=
    fun k ↦ homogeneousLocalizationAwayXEquiv_awayMk R i 1 (X k) _
  have himg : Subring.map E (Subring.closure (Set.range (awayXRatio R i))) = ⊤ := by
    rw [RingHom.map_closure, ← top_le_iff, ← closure_range_X_eq_top {j : σ // j ≠ i} hR]
    refine Subring.closure_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    exact Subring.subset_closure ⟨awayXRatio R i j.1, ⟨j.1, rfl⟩, by
      rw [hE, dehomogenizeX_X_of_ne R i j.2]⟩
  have hinj : Function.Injective E := (homogeneousLocalizationAwayXEquiv R i).injective
  have h := congrArg (Subring.comap E) himg
  rwa [Subring.comap_map_eq_self_of_injective hinj, Subring.comap_top] at h

end Generators

/-- A homogeneous polynomial of degree `r` in elements of `I` lies in `I ^ r`. -/
theorem IsHomogeneous.aeval_mem_pow {k A ι : Type*} [CommRing k] [CommRing A] [Algebra k A]
    {I : Ideal A} {x : ι → A} (hx : ∀ i, x i ∈ I)
    {f : MvPolynomial ι k} {r : ℕ} (hf : f.IsHomogeneous r) : MvPolynomial.aeval x f ∈ I ^ r := by
  classical
  rw [f.as_sum, map_sum]
  refine Ideal.sum_mem _ fun d hd ↦ ?_
  rw [aeval_monomial]
  refine Ideal.mul_mem_left _ _ ?_
  have hd' : d.degree = r := by
    rw [Finsupp.degree_eq_weight_one]
    exact hf (mem_support_iff.1 hd)
  rw [← hd', Finsupp.degree_apply, Finsupp.prod, ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun i _ ↦ Ideal.pow_mem_pow (hx i) _

section Forms

/-- The determinant of a matrix of forms of degree `m` is a form of degree `card ι * m`. -/
theorem IsHomogeneous.det {ι σ R : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]
    {M : Matrix ι ι (MvPolynomial σ R)} {m : ℕ} (hM : ∀ i j, (M i j).IsHomogeneous m) :
    M.det.IsHomogeneous (Fintype.card ι * m) := by
  rw [Matrix.det_apply]
  refine IsHomogeneous.sum _ _ _ fun e _ => ?_
  have := IsHomogeneous.prod Finset.univ (fun i => M (e i) i) (fun _ => m) fun i _ => hM _ _
  rw [Finset.sum_const, Finset.card_univ, smul_eq_mul] at this
  exact (mem_homogeneousSubmodule _ _).mp
    (zsmul_mem ((mem_homogeneousSubmodule _ _).mpr this) _)

/-- Applying a `K`-linear map `f : L → K` to the coefficients of a form over `L` gives a form of
the same degree over `K`. -/
theorem IsHomogeneous.sum_monomial_linearMap {σ K L : Type*} [CommRing K]
    [CommRing L] [Algebra K L] (f : L →ₗ[K] K) {G : MvPolynomial σ L} {d : ℕ}
    (hG : G.IsHomogeneous d) :
    (∑ s ∈ G.support, monomial s (f (coeff s G))).IsHomogeneous d :=
  IsHomogeneous.sum _ _ _ fun _ hs =>
    isHomogeneous_monomial _ (hG.degree_eq_sum_deg_support hs).symm

/-- Evaluating the polynomial obtained by applying a `K`-linear map `f : L → K` to the
coefficients of `G` at a point `y` with coordinates in `K` is `f` of the value of `G` at `y`. -/
theorem eval_sum_monomial_linearMap {σ K L : Type*} [CommRing K] [CommRing L]
    [Algebra K L] (f : L →ₗ[K] K) (G : MvPolynomial σ L) (y : σ → K) :
    eval y (∑ s ∈ G.support, monomial s (f (coeff s G))) = f (eval (algebraMap K L ∘ y) G) := by
  rw [map_sum, eval_eq (algebraMap K L ∘ y) G, map_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [eval_monomial, Finsupp.prod]
  simp only [Function.comp_apply, ← map_pow, ← map_prod, mul_comm (coeff s G),
    ← Algebra.smul_def, map_smul, smul_eq_mul]
  exact mul_comm _ _

end Forms

end MvPolynomial

namespace MvPolynomial

open HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

variable {n : Type*} [Fintype n] (R : Type*) [CommRing R]

/-- The monomial `∏ᵢ Xᵢ ^ aᵢ` with coefficient `1`, for an exponent vector `a : n → ℤ`, the
negative exponents being read as `0`. -/
noncomputable def monomialToNat (a : n → ℤ) : MvPolynomial n R :=
  monomial (Finsupp.equivFunOnFinite.symm fun i ↦ (a i).toNat) 1

variable {R}

lemma monomialToNat_mul {a b : n → ℤ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    monomialToNat R a * monomialToNat R b = monomialToNat R (a + b) := by
  rw [monomialToNat, monomialToNat, monomialToNat, monomial_mul, one_mul]
  congr 2
  ext i
  simp [Int.toNat_add (ha i) (hb i)]

lemma monomialToNat_pow {a : n → ℤ} (ha : 0 ≤ a) (k : ℕ) :
    monomialToNat R a ^ k = monomialToNat R (k • a) := by
  induction k with
  | zero =>
    rw [pow_zero, zero_smul, monomialToNat]
    have : (Finsupp.equivFunOnFinite.symm fun i ↦ ((0 : n → ℤ) i).toNat) = 0 := by
      ext i
      simp
    rw [this, ← C_1, C_apply]
  | succ k ih =>
    rw [pow_succ, ih, monomialToNat_mul (nsmul_nonneg ha k) ha, succ_nsmul]

lemma monomialToNat_mem (a : n → ℤ) :
    monomialToNat R a ∈ homogeneousSubmodule n R (∑ i, (a i).toNat) := by
  rw [mem_homogeneousSubmodule]
  refine isHomogeneous_monomial _ ?_
  rw [Finsupp.degree_eq_sum]
  simp

lemma monomialToNat_mem_of_sum {a : n → ℤ} (ha : 0 ≤ a) {k : ℕ} (h : ∑ i, a i = k) :
    monomialToNat R a ∈ homogeneousSubmodule n R k := by
  convert monomialToNat_mem (R := R) a
  zify
  rw [← h]
  exact Finset.sum_congr rfl fun i _ ↦ (Int.toNat_of_nonneg (ha i)).symm

lemma monomialToNat_eq_prod (a : n → ℤ) :
    monomialToNat R a = ∏ i, X i ^ (a i).toNat := by
  rw [monomialToNat, monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (fun _ ↦ pow_zero _)]
  rfl

lemma monomialToNat_mem_iff {P : Ideal (MvPolynomial n R)} [P.IsPrime] (a : n → ℤ) :
    monomialToNat R a ∈ P ↔ ∃ i, 0 < a i ∧ X i ∈ P := by
  rw [monomialToNat_eq_prod, Ideal.IsPrime.prod_mem_iff]
  refine ⟨fun ⟨i, _, hi⟩ ↦ ⟨i, ?_, ?_⟩, fun ⟨i, hi, hX⟩ ↦ ⟨i, Finset.mem_univ _, ?_⟩⟩
  · by_contra h
    rw [Int.toNat_of_nonpos (not_lt.1 h), pow_zero, ← Ideal.eq_top_iff_one] at hi
    exact Ideal.IsPrime.ne_top ‹_› hi
  · exact Ideal.IsPrime.mem_of_pow_mem ‹_› _ hi
  · exact Ideal.pow_mem_of_mem _ hX _ (by omega)

lemma monomialToNat_zero : monomialToNat R (0 : n → ℤ) = 1 := by
  rw [monomialToNat]
  have : (Finsupp.equivFunOnFinite.symm fun i ↦ ((0 : n → ℤ) i).toNat) = 0 := by
    ext i
    simp
  rw [this, ← C_1, C_apply]

omit [Fintype n] in
lemma cast_sum_toNat {a : n → ℤ} (ha : 0 ≤ a) (t : Finset n) :
    ((∑ i ∈ t, (a i).toNat : ℕ) : ℤ) = ∑ i ∈ t, a i := by
  push_cast
  exact Finset.sum_congr rfl fun i _ ↦ Int.toNat_of_nonneg (ha i)

/-- Two fractions of monomials agree in a localization as soon as their exponents do. -/
lemma mk_monomialToNat_eq_mk {M : Submonoid (MvPolynomial n R)} {a b a' b' : n → ℤ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (ha' : 0 ≤ a') (hb' : 0 ≤ b') (h : a + b' = a' + b)
    (hbM : monomialToNat R b ∈ M) (hbM' : monomialToNat R b' ∈ M) :
    Localization.mk (monomialToNat R a) ⟨_, hbM⟩ =
      Localization.mk (monomialToNat R a') ⟨_, hbM'⟩ := by
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul]
  rw [monomialToNat_mul hb' ha, monomialToNat_mul hb ha', add_comm b', h, add_comm]

/-- A fraction of monomials in a localization only depends on the difference of the exponents. -/
lemma mk_eq_mk_of_monomialToNat {M : Submonoid (MvPolynomial n R)} {x x' : MvPolynomial n R}
    {d d' : M} {a b a' b' : n → ℤ} (ha : 0 ≤ a) (hb : 0 ≤ b) (ha' : 0 ≤ a') (hb' : 0 ≤ b')
    (hx : x = monomialToNat R a) (hd : (d : MvPolynomial n R) = monomialToNat R b)
    (hx' : x' = monomialToNat R a') (hd' : (d' : MvPolynomial n R) = monomialToNat R b')
    (h : a + b' = a' + b) : Localization.mk x d = Localization.mk x' d' := by
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul]
  rw [hx, hd, hx', hd', monomialToNat_mul hb' ha, monomialToNat_mul hb ha', add_comm b', h,
    add_comm]

section Away


variable (s : Set n) (m : ℤ)

/-- The exponent vectors `e : n → ℤ` with `∑ eᵢ = m` and `eᵢ ≥ 0` for `i ∉ s`: the exponents of
the Laurent monomials of degree `m` whose denominators only involve the variables `Xᵢ`,
`i ∈ s`. -/
def laurentExponents : Set (n → ℤ) := {e | ∑ i, e i = m ∧ ∀ i ∉ s, 0 ≤ e i}

lemma laurentExponents_mono {s t : Set n} (hts : t ⊆ s) (m : ℤ) :
    laurentExponents t m ⊆ laurentExponents s m :=
  fun _ he ↦ ⟨he.1, fun i hi ↦ he.2 i fun h ↦ hi (hts h)⟩

omit [Fintype n] in
lemma indicator_one_nonneg : 0 ≤ s.indicator (1 : n → ℤ) := fun i ↦ by
  by_cases h : i ∈ s <;> simp [h]

/-- The degree `|s|` of the monomial `∏_{i ∈ s} Xᵢ`. -/
noncomputable abbrev indicatorDegree : ℕ := ∑ i, (s.indicator (1 : n → ℤ) i).toNat

lemma cast_indicatorDegree : (indicatorDegree s : ℤ) = ∑ i, s.indicator (1 : n → ℤ) i := by
  push_cast
  exact Finset.sum_congr rfl fun i _ ↦ Int.toNat_of_nonneg (indicator_one_nonneg s i)

variable (R) in
lemma monomialToNat_indicator_mem :
    monomialToNat R (s.indicator 1) ∈ homogeneousSubmodule n R (indicatorDegree s) :=
  monomialToNat_mem _

/-- The number `∑ᵢ max(-eᵢ, 0)`, large enough that `e + N • 1_s ≥ 0` for `e` nonnegative
outside `s`. -/
def negExponentSum (e : n → ℤ) : ℕ := ∑ i, (-e i).toNat

variable {s m}

omit [Fintype n] in
lemma add_nsmul_indicator_nonneg {e : n → ℤ} (he : ∀ i ∉ s, 0 ≤ e i) {N : ℕ}
    (hN : ∀ i, -e i ≤ N) : 0 ≤ e + N • s.indicator (1 : n → ℤ) := by
  intro i
  by_cases hi : i ∈ s
  · simp [Set.indicator_of_mem hi]
    linarith [hN i]
  · simp [Set.indicator_of_notMem hi, he i hi]

lemma neg_le_negExponentSum (e : n → ℤ) (i : n) : -e i ≤ negExponentSum e := by
  have h : (-e i).toNat ≤ negExponentSum e :=
    Finset.single_le_sum (f := fun j ↦ (-e j).toNat) (fun _ _ ↦ Nat.zero_le _)
      (Finset.mem_univ i)
  have := Int.self_le_toNat (-e i)
  omega

lemma sum_add_nsmul_indicator {e : n → ℤ} (he : ∑ i, e i = 0) (N : ℕ) :
    ∑ i, (e + N • s.indicator (1 : n → ℤ)) i = ((N • indicatorDegree s : ℕ) : ℤ) := by
  rw [smul_eq_mul, Nat.cast_mul, cast_indicatorDegree, Finset.mul_sum]
  simp only [Pi.add_apply, Finset.sum_add_distrib, he, zero_add, nsmul_eq_mul, Pi.mul_apply,
    Pi.natCast_apply]

lemma monomialToNat_add_nsmul_indicator_mem {e : n → ℤ} (he : e ∈ laurentExponents s 0)
    {N : ℕ} (hN : ∀ i, -e i ≤ N) :
    monomialToNat R (e + N • s.indicator 1) ∈
      homogeneousSubmodule n R (N • indicatorDegree s) :=
  monomialToNat_mem_of_sum (add_nsmul_indicator_nonneg he.2 hN) (sum_add_nsmul_indicator he.1 N)

variable (R s) in
/-- **The Laurent monomial `xᵉ`** in the degree-zero part of the localization of
`R[Xᵢ : i ∈ n]` away from `∏_{i ∈ s} Xᵢ`, for an exponent vector `e` with `∑ eᵢ = 0` and
`eᵢ ≥ 0` for `i ∉ s`: the fraction `x^{e + N 1_s} / (∏_{i ∈ s} Xᵢ)^N` for `N` large. -/
noncomputable def awayMonomial (e : laurentExponents s 0) :
    Away (homogeneousSubmodule n R) (monomialToNat R (s.indicator 1)) :=
  Away.mk _ (monomialToNat_indicator_mem R s) (negExponentSum e.1)
    (monomialToNat R (e.1 + negExponentSum e.1 • s.indicator 1))
    (monomialToNat_add_nsmul_indicator_mem e.2 (neg_le_negExponentSum e.1))

/-- `awayMonomial` may be computed with any large enough power of the denominator. -/
lemma awayMonomial_eq (e : laurentExponents s 0) {N : ℕ} (hN : ∀ i, -e.1 i ≤ N) :
    Away.mk _ (monomialToNat_indicator_mem R s) N (monomialToNat R (e.1 + N • s.indicator 1))
      (monomialToNat_add_nsmul_indicator_mem e.2 hN) = awayMonomial R s e := by
  have h0 := indicator_one_nonneg s
  refine Away.mk_eq_mk_of_mul_pow_eq (𝒜 := homogeneousSubmodule n R)
    (monomialToNat_indicator_mem R s) _ _ ?_
  rw [monomialToNat_pow h0, monomialToNat_pow h0,
    monomialToNat_mul (add_nsmul_indicator_nonneg e.2.2 hN) (nsmul_nonneg h0 _),
    monomialToNat_mul (add_nsmul_indicator_nonneg e.2.2 (neg_le_negExponentSum e.1))
      (nsmul_nonneg h0 _)]
  congr 1
  rw [add_assoc, add_assoc, ← add_nsmul, ← add_nsmul, add_comm N]

/-- The value of `∑ⱼ gⱼ • x^{eⱼ}` in the localization, all Laurent monomials being written with
the same denominator. -/
lemma val_sum_smul_awayMonomial (t : Finset (laurentExponents s 0))
    (g : laurentExponents s 0 → R) {N : ℕ} (hN : ∀ e ∈ t, ∀ i, -e.1 i ≤ N) :
    (∑ e ∈ t, g e • awayMonomial R s e).val =
      Localization.mk (∑ e ∈ t, C (g e) * monomialToNat R (e.1 + N • s.indicator 1))
        ⟨monomialToNat R (s.indicator 1) ^ N, by use N⟩ := by
  rw [Localization.mk_sum, val_sum]
  refine Finset.sum_congr rfl fun e he ↦ ?_
  rw [val_smul, ← awayMonomial_eq e (hN e he),
    Away.val_mk, Localization.smul_mk, smul_eq_C_mul]

/-- **The Laurent monomials `xᵉ` are linearly independent** in the degree-zero part of the
localization of `R[Xᵢ : i ∈ n]` away from `∏_{i ∈ s} Xᵢ`. -/
theorem linearIndependent_awayMonomial : LinearIndependent R (awayMonomial R s) := by
  classical
  rw [linearIndependent_iff']
  intro t g hg e₀ he₀
  have h0 := indicator_one_nonneg s
  set N := ∑ e ∈ t, negExponentSum e.1
  have hN : ∀ e ∈ t, ∀ i, -e.1 i ≤ N := fun e he i ↦ (neg_le_negExponentSum e.1 i).trans
    (Nat.cast_le.2 (Finset.single_le_sum (f := fun e : laurentExponents s 0 ↦ negExponentSum e.1)
      (fun _ _ ↦ Nat.zero_le _) he))
  have hv := congrArg HomogeneousLocalization.val hg
  rw [val_sum_smul_awayMonomial t g hN, HomogeneousLocalization.val_zero,
    Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hv
  obtain ⟨⟨c, k, rfl⟩, hk⟩ := hv
  dsimp only at hk
  have hnn : ∀ e ∈ t, 0 ≤ e.1 + (N + k) • s.indicator (1 : n → ℤ) := fun e he ↦
    add_nsmul_indicator_nonneg e.2.2 fun i ↦ (hN e he i).trans (by push_cast; omega)
  let u : laurentExponents s 0 → n →₀ ℕ := fun e ↦
    Finsupp.equivFunOnFinite.symm fun i ↦ ((e.1 + (N + k) • s.indicator (1 : n → ℤ)) i).toNat
  have hk' : ∑ e ∈ t, monomial (u e) (g e) = 0 := by
    rw [← hk, Finset.mul_sum]
    refine Finset.sum_congr rfl fun e he ↦ ?_
    have hexp : k • s.indicator (1 : n → ℤ) + (e.1 + N • s.indicator 1) =
        e.1 + (N + k) • s.indicator 1 := by
      rw [add_nsmul]
      abel
    rw [monomialToNat_pow h0, mul_left_comm, monomialToNat_mul (nsmul_nonneg h0 k)
      (add_nsmul_indicator_nonneg e.2.2 (hN e he)), hexp, monomialToNat, C_mul_monomial, mul_one]
  have hu : ∀ e ∈ t, u e = u e₀ → e = e₀ := fun e he h ↦ Subtype.ext (funext fun i ↦ by
    have hi := congr($(h) i)
    simp only [u, Finsupp.coe_equivFunOnFinite_symm] at hi
    have h1 := Int.toNat_of_nonneg (hnn e he i)
    have h2 := Int.toNat_of_nonneg (hnn e₀ he₀ i)
    have h3 : (e.1 + (N + k) • s.indicator (1 : n → ℤ)) i =
        (e₀.1 + (N + k) • s.indicator (1 : n → ℤ)) i := by
      omega
    simpa using h3)
  have := congrArg (coeff (u e₀)) hk'
  rw [coeff_sum, coeff_zero, Finset.sum_eq_single e₀ (fun e he hne ↦ by
    rw [coeff_monomial, if_neg fun h ↦ hne (hu e he h)]) (fun h ↦ (h he₀).elim),
    coeff_monomial, if_pos rfl] at this
  exact this

/-- **The Laurent monomials `xᵉ` span** the degree-zero part of the localization of
`R[Xᵢ : i ∈ n]` away from `∏_{i ∈ s} Xᵢ`: a fraction `a / (∏_{i ∈ s} Xᵢ)^N` with `a` homogeneous
of degree `N |s|` is the sum of the fractions of the monomials of `a`. -/
theorem span_awayMonomial : Submodule.span R (Set.range (awayMonomial R s)) = ⊤ := by
  classical
  refine eq_top_iff.2 fun z _ ↦ ?_
  obtain ⟨N, a, ha, rfl⟩ := Away.mk_surjective _ (monomialToNat_indicator_mem R s) z
  have hdeg : ∀ u ∈ a.support, ∑ i, (u i : ℤ) = N * ∑ i, s.indicator (1 : n → ℤ) i := by
    intro u hu
    have h := ((mem_homogeneousSubmodule _ _).1 ha) (mem_support_iff.1 hu)
    replace h : u.degree = N • indicatorDegree s :=
      (congrFun (congrArg DFunLike.coe Finsupp.degree_eq_weight_one) u).trans h
    rw [Finsupp.degree_eq_sum] at h
    rw [← cast_indicatorDegree, ← Nat.cast_mul, ← smul_eq_mul, ← h]
    push_cast
    rfl
  let e : a.support → laurentExponents s 0 := fun u ↦
    ⟨fun i ↦ (u.1 i : ℤ) - N * s.indicator 1 i, by
      simp only [Finset.sum_sub_distrib, ← Finset.mul_sum, hdeg u.1 u.2, sub_self], fun i hi ↦ by
      simp [Set.indicator_of_notMem hi]⟩
  have key : ∀ u : a.support, ∃ h, Away.mk _ (monomialToNat_indicator_mem R s) N
      (monomial u.1 (1 : R)) h = awayMonomial R s (e u) := by
    intro u
    have hN : ∀ i, -(e u).1 i ≤ N := fun i ↦ by
      have : s.indicator (1 : n → ℤ) i ≤ 1 := by by_cases h : i ∈ s <;> simp [h]
      have : (0 : ℤ) ≤ N := Nat.cast_nonneg N
      simp only [e]
      nlinarith [Int.natCast_nonneg (u.1 i)]
    have hmono : monomialToNat R ((e u).1 + N • s.indicator 1) = monomial u.1 1 := by
      rw [monomialToNat]
      congr 1
      ext i
      simp [e]
    refine ⟨hmono ▸ monomialToNat_add_nsmul_indicator_mem (e u).2 hN, ?_⟩
    rw [← awayMonomial_eq (e u) hN]
    congr 1
    exact hmono.symm
  have hz : Away.mk _ (monomialToNat_indicator_mem R s) N a ha =
      ∑ u ∈ a.support.attach, coeff u.1 a • awayMonomial R s (e u) := by
    apply HomogeneousLocalization.val_injective
    rw [val_sum, Away.val_mk]
    conv_lhs => rw [a.as_sum]
    rw [← Finset.sum_attach, Localization.mk_sum]
    refine Finset.sum_congr rfl fun u _ ↦ ?_
    obtain ⟨h, hu⟩ := key u
    rw [val_smul, ← hu, Away.val_mk, Localization.smul_mk, smul_monomial, smul_eq_mul, mul_one]
  rw [hz]
  exact Submodule.sum_mem _ fun u _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)

variable (R s) in
/-- **The monomial basis** of the degree-zero part of the localization of `R[Xᵢ : i ∈ n]` away
from `∏_{i ∈ s} Xᵢ`: the Laurent monomials `xᵉ` with `∑ eᵢ = 0` and `eᵢ ≥ 0` for `i ∉ s`. -/
noncomputable def awayMonomialBasis :
    Module.Basis (laurentExponents s 0) R
      (Away (homogeneousSubmodule n R) (monomialToNat R (s.indicator 1))) :=
  .mk linearIndependent_awayMonomial span_awayMonomial.ge

@[simp]
lemma awayMonomialBasis_apply (e : laurentExponents s 0) :
    awayMonomialBasis R s e = awayMonomial R s e :=
  Module.Basis.mk_apply _ _ _

end Away

end MvPolynomial
