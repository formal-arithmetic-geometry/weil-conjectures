module

public import Mathlib.RingTheory.Ideal.AssociatedPrime.Finiteness
public import Mathlib.RingTheory.Regular.ProjectiveDimension
public import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Finite projective dimension over regular local rings

We prove that every finitely generated module over a regular local ring has finite projective
dimension.

The maximal ideal `𝔪` of a regular local ring `R` is generated by a regular sequence of length
`d = dim R` (by induction on `d`, using that `R ⧸ (x)` is regular of dimension `d - 1` for
`x ∈ 𝔪 \ 𝔪²`), so the residue field has projective dimension `d`. For a prime `𝔭 ≠ 𝔪` choose
`y ∈ 𝔪 \ 𝔭`; then `y` is regular on `R ⧸ 𝔭` and `pd (R ⧸ (𝔭, y)) = pd (R ⧸ 𝔭) + 1`, while
`R ⧸ (𝔭, y)` has a prime filtration with subquotients `R ⧸ 𝔮` for primes `𝔮 ⊋ 𝔭`. Hence a
noetherian induction on `𝔭` shows that every `R ⧸ 𝔭` has finite projective dimension, and so does
every finitely generated module, which admits a prime filtration.

## Main results

- `IsRegularLocalRing.exists_isRegular_ofList_eq_maximalIdeal`: the maximal ideal of a regular
  local ring is generated by a regular sequence of length `spanFinrank 𝔪`.
- `ModuleCat.exists_hasProjectiveDimensionLE_of_le_annihilator`: over a noetherian ring, a
  finitely generated module killed by `I` has finite projective dimension provided all `R ⧸ 𝔭`
  with `I ≤ 𝔭` prime do.
- `IsRegularLocalRing.exists_hasProjectiveDimensionLE`: every finitely generated module over a
  regular local ring has finite projective dimension.
-/

@[expose] public section

universe v u

open CategoryTheory IsLocalRing RingTheory.Sequence

/-- In a regular local ring whose maximal ideal needs `n` generators, the maximal ideal is
generated by a weakly regular sequence of length `n`. -/
theorem IsRegularLocalRing.exists_isWeaklyRegular_ofList_eq_maximalIdeal :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsRegularLocalRing R],
      (maximalIdeal R).spanFinrank = n → ∃ rs : List R,
        IsWeaklyRegular R rs ∧ Ideal.ofList rs = maximalIdeal R ∧ rs.length = n
  | 0, R, _, _, h => by
    rw [Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal R).fg_of_isNoetherianRing] at h
    exact ⟨[], IsWeaklyRegular.nil R R, by rw [Ideal.ofList_nil, h], rfl⟩
  | n + 1, R, _, _, h => by
    set m := maximalIdeal R
    have hne : m ≠ ⊥ := by
      intro h0
      rw [h0, Submodule.spanFinrank_bot] at h
      omega
    obtain ⟨x, hxm, hx2⟩ : ∃ x ∈ m, x ∉ m ^ 2 := by
      by_contra! hle
      exact hne (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot m m m.fg_of_isNoetherianRing
        (by rwa [smul_eq_mul, ← pow_two]) (by rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top]))
    obtain ⟨_, _, hrank⟩ := IsRegularLocalRing.quotient_span_singleton hxm hx2
    obtain ⟨rs', hreg, hspan, hlen⟩ := exists_isWeaklyRegular_ofList_eq_maximalIdeal n
      (R ⧸ Ideal.span {x}) (Nat.succ_injective (hrank.trans h))
    have hsurj := Ideal.Quotient.mk_surjective (I := Ideal.span {x})
    set rs := rs'.map (Function.surjInv hsurj)
    have hmap : rs.map (Ideal.Quotient.mk (Ideal.span {x})) = rs' := by
      simp [rs, List.map_map, Function.comp_def, Function.surjInv_eq hsurj]
    refine ⟨x :: rs, ?_, ?_, by simp [rs, hlen]⟩
    · rw [isWeaklyRegular_cons_iff]
      refine ⟨?_, ?_⟩
      · refine fun a b hab ↦ mul_left_cancel₀ ?_ hab
        rintro rfl
        exact hx2 (zero_mem _)
      · have e : QuotSMulTop x R ≃ₗ[R] R ⧸ Ideal.span {x} :=
          Submodule.quotEquivOfEq _ _ (by
            rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.mul_top])
        rw [e.isWeaklyRegular_congr, ← isWeaklyRegular_map_algebraMap_iff (R ⧸ Ideal.span {x}),
          Ideal.Quotient.algebraMap_eq, hmap]
        exact hreg
    · rw [Ideal.ofList_cons, ← Ideal.mk_ker (I := Ideal.span {x}), sup_comm,
        ← Ideal.comap_map_of_surjective' _ hsurj, Ideal.map_ofList, hmap, hspan]
      exact IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective _ hsurj)

/-- The maximal ideal of a regular local ring is generated by a regular sequence whose length is
the minimal number of generators of the maximal ideal. -/
theorem IsRegularLocalRing.exists_isRegular_ofList_eq_maximalIdeal (R : Type u) [CommRing R]
    [IsRegularLocalRing R] : ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = maximalIdeal R ∧
      rs.length = (maximalIdeal R).spanFinrank := by
  obtain ⟨rs, hreg, hspan, hlen⟩ := exists_isWeaklyRegular_ofList_eq_maximalIdeal _ R rfl
  refine ⟨rs, IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal R (fun r hr ↦ ?_) hreg, hspan, hlen⟩
  rw [← hspan]
  exact Ideal.subset_span hr

/-- The residue field `R ⧸ 𝔪` of a regular local ring `R` has projective dimension equal to the
minimal number of generators of `𝔪` (which is the Krull dimension of `R`). -/
theorem IsRegularLocalRing.projectiveDimension_quotient_maximalIdeal {R : Type u} [CommRing R]
    [IsRegularLocalRing R] [Small.{v} R] :
    projectiveDimension (ModuleCat.of R (Shrink.{v} (R ⧸ maximalIdeal R))) =
      (maximalIdeal R).spanFinrank := by
  obtain ⟨rs, hreg, hspan, hlen⟩ := exists_isRegular_ofList_eq_maximalIdeal R
  rw [← hlen, ← hspan]
  exact ModuleCat.projectiveDimension_quotient_eq_length rs hreg

namespace ModuleCat

variable {R : Type u} [CommRing R]

/-- Over a noetherian ring `R`, let `I` be an ideal such that `R ⧸ 𝔭` has finite projective
dimension for every prime `𝔭 ⊇ I`. Then every finitely generated `R`-module annihilated by `I`
has finite projective dimension. This follows from the existence of prime filtrations. -/
theorem exists_hasProjectiveDimensionLE_of_le_annihilator [IsNoetherianRing R] (I : Ideal R)
    (h : ∀ (p : Ideal R), p.IsPrime → I ≤ p → ∀ (N : Type v) [AddCommGroup N] [Module R N],
      (N ≃ₗ[R] R ⧸ p) → ∃ n : ℕ, HasProjectiveDimensionLE (ModuleCat.of R N) n)
    (N : Type v) [AddCommGroup N] [Module R N] [Module.Finite R N]
    (hN : I ≤ Module.annihilator R N) :
    ∃ n : ℕ, HasProjectiveDimensionLE (ModuleCat.of R N) n := by
  refine IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime (A := R) ‹_›
    (motive := fun N _ _ _ ↦ I ≤ Module.annihilator R N →
      ∃ n : ℕ, HasProjectiveDimensionLE (ModuleCat.of R N) n) ?_ ?_ ?_ hN
  · intro N _ _ _ _ _
    have := (ModuleCat.isZero_of_subsingleton (ModuleCat.of R N)).hasProjectiveDimensionLT_zero
    exact ⟨0, hasProjectiveDimensionLT_of_ge _ 0 1 zero_le_one⟩
  · intro N _ _ _ p e hI
    exact h p.1 p.2 (hI.trans_eq (e.annihilator_eq.trans Ideal.annihilator_quotient)) N e
  · intro N₁ _ _ _ N₂ _ _ _ N₃ _ _ _ f g hf hg hfg h₁ h₃ hI
    obtain ⟨n₁, hn₁⟩ := h₁ (hI.trans (f.annihilator_le_of_injective hf))
    obtain ⟨n₃, hn₃⟩ := h₃ (hI.trans (g.annihilator_le_of_surjective hg))
    have hS := ModuleCat.shortComplex_shortExact
      (ModuleCat.shortComplexOfCompEqZero f g hfg.linearMap_comp_eq_zero) hfg hf hg
    exact ⟨max n₁ n₃, hS.hasProjectiveDimensionLT_X₂ _
      (hasProjectiveDimensionLT_of_ge _ (n₁ + 1) _ (by omega))
      (hasProjectiveDimensionLT_of_ge _ (n₃ + 1) _ (by omega))⟩

end ModuleCat

namespace IsRegularLocalRing

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [Small.{v} R]

/-- Over a regular local ring `R`, every module isomorphic to `R ⧸ 𝔭` for a prime `𝔭` has finite
projective dimension. This is proved by noetherian induction on `𝔭`: for `𝔭 = 𝔪` it follows from
`projectiveDimension_quotient_maximalIdeal`; otherwise for `y ∈ 𝔪 \ 𝔭` the module `R ⧸ (𝔭, y)`
has finite projective dimension by the induction hypothesis, and it equals `pd (R ⧸ 𝔭) + 1`. -/
theorem exists_hasProjectiveDimensionLE_of_linearEquiv_quotient (p : Ideal R) [p.IsPrime]
    (N : Type v) [AddCommGroup N] [Module R N] (e : N ≃ₗ[R] R ⧸ p) :
    ∃ n : ℕ, HasProjectiveDimensionLE (ModuleCat.of R N) n := by
  suffices key : ∀ p : Ideal R, p.IsPrime → ∀ (N : Type v) [AddCommGroup N] [Module R N],
      (N ≃ₗ[R] R ⧸ p) → ∃ n : ℕ, HasProjectiveDimensionLE (ModuleCat.of R N) n from
    key p ‹_› N e
  intro p
  induction p using WellFoundedGT.induction with | _ p ih
  intro hp N _ _ e
  have : Module.Finite R N := Module.Finite.equiv e.symm
  rw [← projectiveDimension_ne_top_iff]
  by_cases hpm : p = maximalIdeal R
  · obtain rfl := hpm
    let e' : N ≃ₗ[R] Shrink.{v} (R ⧸ maximalIdeal R) := e.trans (Shrink.linearEquiv R _).symm
    rw [projectiveDimension_eq_of_iso e'.toModuleIso, projectiveDimension_quotient_maximalIdeal]
    exact nofun
  obtain ⟨y, hym, hyp⟩ := SetLike.not_le_iff_exists.1
    (fun h ↦ hpm ((le_maximalIdeal hp.ne_top).antisymm h))
  have hreg : IsSMulRegular N y := by
    rw [e.isSMulRegular_congr]
    intro a b (hab : y • a = y • b)
    rw [Algebra.smul_def, Algebra.smul_def] at hab
    exact mul_left_cancel₀ (by rwa [Ne, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem]) hab
  have hann : p ≤ Module.annihilator R N := (e.annihilator_eq.trans Ideal.annihilator_quotient).ge
  obtain ⟨n, hn⟩ := ModuleCat.exists_hasProjectiveDimensionLE_of_le_annihilator
    (p ⊔ Ideal.span {y}) (fun q hq hpq N _ _ e ↦ ih q (lt_of_le_of_ne (le_sup_left.trans hpq)
      (fun h ↦ hyp (h ▸ hpq (Ideal.mem_sup_right (Ideal.mem_span_singleton_self y))))) hq N e)
    (QuotSMulTop y N) (sup_le (hann.trans ((Submodule.mkQ _).annihilator_le_of_surjective
      (Submodule.mkQ_surjective _))) ((Ideal.span_singleton_le_iff_mem _).2
        (QuotSMulTop.mem_annihilator N y)))
  have := (projectiveDimension_ne_top_iff _).2 ⟨n, hn⟩
  rw [ModuleCat.projectiveDimension_quotSMulTop_eq_succ_of_isSMulRegular (ModuleCat.of R N) y
    hreg hym] at this
  intro htop
  rw [htop] at this
  exact this rfl

/-- Every finitely generated module over a regular local ring has finite projective dimension. -/
theorem exists_hasProjectiveDimensionLE (M : ModuleCat.{v} R) [Module.Finite R M] :
    ∃ n : ℕ, HasProjectiveDimensionLE M n :=
  ModuleCat.exists_hasProjectiveDimensionLE_of_le_annihilator ⊥
    (fun p _ _ N _ _ e ↦ exists_hasProjectiveDimensionLE_of_linearEquiv_quotient p N e) M bot_le

end IsRegularLocalRing
