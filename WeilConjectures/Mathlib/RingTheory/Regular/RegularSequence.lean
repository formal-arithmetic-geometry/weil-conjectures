/-!
# Regular sequences in polynomial rings

- `RingTheory.Sequence.IsWeaklyRegular.map_of_flat`: a weakly regular sequence stays weakly
  regular along a flat ring homomorphism.
- `MvPolynomial.isWeaklyRegular_ofFn_X_sub_C`: in `A[X₀, …, Xₙ₋₁]` the sequence
  `X₀ - a₀, …, Xₙ₋₁ - aₙ₋₁` is weakly regular.
-/

@[expose] public section

open RingTheory.Sequence
open scoped Pointwise

namespace RingTheory.Sequence

/-- A weakly regular sequence of a ring `R` stays weakly regular in `S` along a flat ring
homomorphism `R →+* S`. -/
theorem IsWeaklyRegular.map_of_flat {R S : Type*} [CommRing R] [CommRing S] {f : R →+* S}
    (hf : f.Flat) {rs : List R} (h : IsWeaklyRegular R rs) : IsWeaklyRegular S (rs.map f) := by
  algebraize [f]
  exact h.of_flat

/-- Let `φ : A →+* B` be surjective with kernel generated by a weakly regular sequence `r`. If
`t` is a sequence of `A` whose image in `B` is weakly regular, then `r ++ t` is weakly regular in
`A`. -/
theorem isWeaklyRegular_append_of_surjective {A B : Type*} [CommRing A] [CommRing B]
    (φ : A →+* B) (hφ : Function.Surjective φ) {r t : List A} (hr : IsWeaklyRegular A r)
    (hker : RingHom.ker φ = Ideal.ofList r) (ht : IsWeaklyRegular B (t.map φ)) :
    IsWeaklyRegular A (r ++ t) := by
  algebraize [φ]
  rw [isWeaklyRegular_append_iff]
  refine ⟨hr, ?_⟩
  have h : (Ideal.ofList r • ⊤ : Submodule A A) = LinearMap.ker (Algebra.linearMap A B) := by
    ext a
    rw [smul_eq_mul, Ideal.mul_top, ← hker]
    simp [RingHom.mem_ker, RingHom.algebraMap_toAlgebra]
  let e : (A ⧸ (Ideal.ofList r • ⊤ : Submodule A A)) ≃ₗ[A] B :=
    (Submodule.quotEquivOfEq _ _ h).trans
      ((Algebra.linearMap A B).quotKerEquivOfSurjective hφ)
  rw [e.isWeaklyRegular_congr, ← isWeaklyRegular_map_algebraMap_iff B B]
  exact ht

/-- **Relations among a weakly regular sequence.** If `v₁, …, vₙ` is a weakly regular sequence
of a commutative ring and `∑ aⱼ vⱼ = 0`, every coefficient `aⱼ` lies in the ideal `(v₁, …, vₙ)`.
-/
theorem IsWeaklyRegular.mem_span_of_sum_mul_eq_zero {R : Type*} [CommRing R] :
    ∀ {n : ℕ} (v : Fin n → R), IsWeaklyRegular R (List.ofFn v) → ∀ (a : Fin n → R),
      ∑ j, a j * v j = 0 → ∀ j, a j ∈ Ideal.span (Set.range v)
  | 0, _, _, _, _, j => j.elim0
  | n + 1, v, hv, a, ha, j => by
    rw [List.ofFn_succ', List.concat_eq_append, isWeaklyRegular_append_iff,
      isWeaklyRegular_singleton_iff] at hv
    obtain ⟨hv₁, hv₂⟩ := hv
    set w : Fin n → R := fun i ↦ v i.castSucc
    have hI : Ideal.ofList (List.ofFn w) = Ideal.span (Set.range w) := by
      rw [Ideal.ofList]
      congr 1
      ext x
      simp [List.mem_ofFn]
    rw [Fin.sum_univ_castSucc] at ha
    -- the last coefficient lies in `(v₁, …, vₙ)`
    have hlast : a (Fin.last n) ∈ Ideal.span (Set.range w) := by
      have hmem : v (Fin.last n) * a (Fin.last n) ∈ Ideal.span (Set.range w) := by
        have : v (Fin.last n) * a (Fin.last n) = -∑ i : Fin n, a i.castSucc * w i := by
          rw [eq_neg_iff_add_eq_zero, add_comm, mul_comm]; exact ha
        rw [this]
        exact neg_mem (Ideal.sum_mem _ fun i _ ↦
          Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
      rw [← hI] at hmem ⊢
      have := hv₂ (a₁ := Submodule.Quotient.mk (a (Fin.last n)))
        (a₂ := 0) (by
          change v (Fin.last n) • Submodule.Quotient.mk _ = v (Fin.last n) • 0
          rw [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
            smul_eq_mul, Ideal.mul_top]
          exact hmem)
      rwa [Submodule.Quotient.mk_eq_zero, smul_eq_mul, Ideal.mul_top] at this
    obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.mp hlast
    have hw : IsWeaklyRegular R (List.ofFn w) := hv₁
    have ih := mem_span_of_sum_mul_eq_zero w hw (fun i ↦ a i.castSucc + b i * v (Fin.last n))
      (by
        rw [← ha, ← hb]
        simp only [add_mul, Finset.sum_add_distrib, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl fun i _ ↦ by ring)
    have hle : Ideal.span (Set.range w) ≤ Ideal.span (Set.range v) :=
      Ideal.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨_, rfl⟩)
    refine Fin.lastCases (hle hlast) (fun i ↦ ?_) j
    have h1 := hle (ih i)
    have h2 : b i * v (Fin.last n) ∈ Ideal.span (Set.range v) :=
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, rfl⟩)
    simpa using sub_mem h1 h2

/-- **Change of generators of an ideal generated by a weakly regular sequence.** If `v` is weakly
regular and `w` spans the same ideal `I`, then `w = M v` for a matrix `M` whose determinant is a
unit modulo `I`. -/
theorem IsWeaklyRegular.exists_mulVec_isUnit_det {R : Type*} [CommRing R] {n : ℕ}
    (v w : Fin n → R) (hv : IsWeaklyRegular R (List.ofFn v))
    (h : Ideal.span (Set.range w) = Ideal.span (Set.range v)) :
    ∃ M : Matrix (Fin n) (Fin n) R, w = M.mulVec v ∧
      IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range v)) M.det) := by
  choose M hM using fun i ↦ Ideal.mem_span_range_iff_exists_fun.mp
    (h ▸ Ideal.subset_span ⟨i, rfl⟩ : w i ∈ Ideal.span (Set.range v))
  choose N hN using fun i ↦ Ideal.mem_span_range_iff_exists_fun.mp
    (h ▸ Ideal.subset_span ⟨i, rfl⟩ : v i ∈ Ideal.span (Set.range w))
  refine ⟨Matrix.of M, funext fun i ↦ (hM i).symm.trans (by simp [Matrix.mulVec, dotProduct]), ?_⟩
  -- `N M - 1` has entries in the ideal, since its rows are relations among `v`
  have hrel : ∀ i j, (Matrix.of N * Matrix.of M - 1) i j ∈ Ideal.span (Set.range v) := by
    intro i
    refine mem_span_of_sum_mul_eq_zero v hv _ ?_
    have : v i = ∑ k, N i k * ∑ j, M k j * v j := by
      rw [← hN i]; exact Finset.sum_congr rfl fun k _ ↦ by rw [hM k]
    simp only [Matrix.sub_apply, Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply, sub_mul,
      Finset.sum_sub_distrib, Finset.sum_mul, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq,
      Finset.mem_univ, if_true]
    rw [sub_eq_zero, this, Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by ring
  have hmap : (Ideal.Quotient.mk (Ideal.span (Set.range v))).mapMatrix
      (Matrix.of N * Matrix.of M) = 1 := by
    ext i j
    have := Ideal.Quotient.eq_zero_iff_mem.mpr (hrel i j)
    simp only [Matrix.sub_apply, map_sub] at this
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, ← sub_eq_zero]
    simpa [Matrix.one_apply, apply_ite] using this
  have hdet := congrArg Matrix.det hmap
  rw [← RingHom.map_det, Matrix.det_mul, map_mul, Matrix.det_one] at hdet
  exact IsUnit.of_mul_eq_one (b := Ideal.Quotient.mk _ (Matrix.of N).det)
    (by rw [mul_comm]; exact hdet)

end RingTheory.Sequence

namespace MvPolynomial

variable {A : Type*} [CommRing A]

/-- In the polynomial ring `A[X₀, …, Xₙ₋₁]`, the sequence `X₀ - a₀, …, Xₙ₋₁ - aₙ₋₁` is weakly
regular: modulo `X₀ - a₀` the ring is `A[X₁, …, Xₙ₋₁]`, on which `X₀ - a₀` is a non-zero
divisor because it is monic in `X₀`. -/
theorem isWeaklyRegular_ofFn_X_sub_C : ∀ {n : ℕ} (a : Fin n → A),
    IsWeaklyRegular (MvPolynomial (Fin n) A) (List.ofFn fun i ↦ X i - C (a i))
  | 0, _ => by simp [isWeaklyRegular_iff]
  | n + 1, a => by
    set B := MvPolynomial (Fin n) A
    let e := (finSuccEquiv A n).toRingEquiv
    rw [e.toAddEquiv.isWeaklyRegular_congr (bs := (List.ofFn fun i ↦ X i - C (a i)).map e)
      (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr fun r _ x ↦ map_mul e r x)),
      List.ofFn_succ, List.map_cons, isWeaklyRegular_cons_iff]
    have hC (x : A) : finSuccEquiv A n (C x) = Polynomial.C (C x) := by
      rw [← algebraMap_eq, AlgEquiv.commutes, Polynomial.algebraMap_apply, algebraMap_eq]
    have h0 : e (X 0 - C (a 0)) = Polynomial.X - Polynomial.C (C (a 0)) := by
      simp [hC, e, finSuccEquiv_X_zero]
    have hs : (List.ofFn fun i : Fin n ↦ X i.succ - C (a i.succ)).map e =
        (List.ofFn fun i : Fin n ↦ X i - C (a i.succ)).map (Polynomial.C (R := B)) := by
      rw [List.map_ofFn, List.map_ofFn]
      congr 1
      funext i
      change finSuccEquiv A n (X i.succ - C (a i.succ)) = Polynomial.C (X i - C (a i.succ))
      rw [map_sub, finSuccEquiv_X_succ, hC, Polynomial.C_sub]
    rw [h0, hs]
    refine ⟨(Polynomial.monic_X_sub_C _).isRegular.left.isSMulRegular, ?_⟩
    have hI : (Polynomial.X - Polynomial.C (C (a 0)) : Polynomial B) •
        (⊤ : Submodule (Polynomial B) (Polynomial B)) =
        Ideal.span {Polynomial.X - Polynomial.C (C (a 0))} := by
      ext x
      simp [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton', mul_comm]
    let ψ : QuotSMulTop (Polynomial.X - Polynomial.C (C (a 0)) : Polynomial B) (Polynomial B) ≃+
        B :=
      (Submodule.quotEquivOfEq _ _ hI).toAddEquiv.trans
        (Polynomial.quotientSpanXSubCAlgEquiv (C (a 0))).toAddEquiv
    refine (ψ.isWeaklyRegular_congr ?_).mpr (isWeaklyRegular_ofFn_X_sub_C (a ∘ Fin.succ))
    refine List.forall₂_map_left_iff.mpr (List.forall₂_same.mpr fun r _ x ↦ ?_)
    induction x using Submodule.Quotient.induction_on with
    | H p =>
      change Polynomial.quotientSpanXSubCAlgEquiv (C (a 0)) (Ideal.Quotient.mk _ (.C r * p)) =
        r * Polynomial.quotientSpanXSubCAlgEquiv (C (a 0)) (Ideal.Quotient.mk _ p)
      rw [Polynomial.quotientSpanXSubCAlgEquiv_mk, Polynomial.quotientSpanXSubCAlgEquiv_mk,
        Polynomial.eval_mul, Polynomial.eval_C]

end MvPolynomial
