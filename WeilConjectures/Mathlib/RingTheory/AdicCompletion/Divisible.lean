module

public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.Finiteness.Cardinality

/-!
# Divisible sequences and derived Nakayama for a principal ideal

Let `ϖ` be an element of a commutative ring `R` and `M` an `R`-module. A sequence `x : ℕ → M`
with `x n = ϖ • x (n + 1)` for all `n` is a compatible system of `ϖ`-power roots of `x 0`; these
sequences are the `R`-linear maps `R[1/ϖ] ⟶ M`. If every such sequence starts with `0`
(a consequence of `M` being derived `ϖ`-complete), then:

* `Module.eq_zero_of_forall_exists_eq_smul` (derived Nakayama): `M = ϖ M` forces `M = 0`;
* `Module.finite_of_forall_exists_add_smul`: if `R` is `ϖ`-adically complete and `M` is
  generated by a finite set modulo `ϖ M`, then `M` is finitely generated.

The completeness of `R` enters through `IsAdicComplete.exists_eq_add_mul`: the recursion
`t n = a n + ϖ * t (n + 1)` is solved by the convergent series `t n = ∑ₖ ϖᵏ a (n + k)`.
-/

@[expose] public section

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- In a `ϖ`-adically complete ring, the recursion `t n = a n + ϖ * t (n + 1)` has a solution
for every sequence `a`: the series `t n = ∑ₖ ϖᵏ a (n + k)`. -/
theorem IsAdicComplete.exists_eq_add_mul {ϖ : R} [IsAdicComplete (Ideal.span {ϖ}) R]
    (a : ℕ → R) : ∃ t : ℕ → R, ∀ n, t n = a n + ϖ * t (n + 1) := by
  let I := Ideal.span {ϖ}
  let s : ℕ → ℕ → R := fun n N ↦ ∑ k ∈ Finset.range N, ϖ ^ k * a (n + k)
  have hmem (n N d : ℕ) : s n (N + d) - s n N ∈ (I ^ N • ⊤ : Submodule R R) := by
    have h : s n (N + d) - s n N = ϖ ^ N • ∑ k ∈ Finset.range d, ϖ ^ k * a (n + (N + k)) := by
      simp only [s, Finset.sum_range_add, add_sub_cancel_left, smul_eq_mul, Finset.mul_sum,
        pow_add, mul_assoc]
    rw [h]
    exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self ϖ) N)
      Submodule.mem_top
  have hcauchy (n : ℕ) {m k : ℕ} (hmk : m ≤ k) :
      s n m ≡ s n k [SMOD (I ^ m • ⊤ : Submodule R R)] := by
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmk
    rw [SModEq.sub_mem, ← neg_sub]
    exact neg_mem (hmem n m d)
  choose t ht using fun n ↦ IsPrecomplete.prec' (I := I) (s n) (hcauchy n)
  refine ⟨t, fun n ↦ (IsHausdorff.eq_iff_smodEq (I := I)).2 fun N ↦ ?_⟩
  have hs : s n (N + 1) = a n + ϖ • s (n + 1) N := by
    simp only [s, Finset.sum_range_succ', pow_zero, one_mul, add_zero, smul_eq_mul,
      Finset.mul_sum]
    rw [add_comm]
    refine congrArg (a n + ·) (Finset.sum_congr rfl fun k _ ↦ ?_)
    rw [pow_succ', mul_assoc, Nat.add_right_comm, Nat.add_assoc]
  have h₁ : t n ≡ s n (N + 1) [SMOD (I ^ N • ⊤ : Submodule R R)] :=
    ((ht n (N + 1)).mono (Submodule.smul_mono_left
      (Ideal.pow_le_pow_right (Nat.le_succ N)))).symm
  have h₂ : a n + ϖ • s (n + 1) N ≡ a n + ϖ • t (n + 1) [SMOD (I ^ N • ⊤ : Submodule R R)] :=
    SModEq.add SModEq.rfl ((ht (n + 1) N).smul ϖ)
  rw [hs] at h₁
  exact h₁.trans h₂

/-- In a `ϖ`-adically complete ring, the recursion `t n = a n + ϖ • t (n + 1)` has a solution
in `ι → R` for every sequence `a`, coordinatewise by `IsAdicComplete.exists_eq_add_mul`. -/
theorem IsAdicComplete.exists_eq_add_smul_pi {ϖ : R} [IsAdicComplete (Ideal.span {ϖ}) R]
    {ι : Type*} (a : ℕ → ι → R) : ∃ t : ℕ → ι → R, ∀ n, t n = a n + ϖ • t (n + 1) := by
  choose t ht using fun i ↦ IsAdicComplete.exists_eq_add_mul (ϖ := ϖ) fun n ↦ a n i
  exact ⟨fun n i ↦ t i n, fun n ↦ funext fun i ↦ ht i n⟩

namespace Module

/-- **Derived Nakayama.** If every sequence `x` with `x n = ϖ • x (n + 1)` has `x 0 = 0`, and
every element of `M` is divisible by `ϖ`, then `M = 0`. -/
theorem eq_zero_of_forall_exists_eq_smul {ϖ : R}
    (hM : ∀ x : ℕ → M, (∀ n, x n = ϖ • x (n + 1)) → x 0 = 0)
    (h : ∀ m : M, ∃ m', m = ϖ • m') (m : M) : m = 0 := by
  choose g hg using h
  exact hM (fun n ↦ g^[n] m) fun n ↦ by
    rw [Function.iterate_succ_apply']
    exact hg _

/-- **Lifting surjectivity from `M / ϖ M`.** Let `N` be a module in which the recursion
`t n = a n + ϖ • t (n + 1)` is always solvable, and `M` a module in which every sequence `x`
with `x n = ϖ • x (n + 1)` has `x 0 = 0`. A linear map `φ : N ⟶ M` which is surjective modulo
`ϖ M` is surjective: writing `y = φ a₀ + ϖ y₁`, `y₁ = φ a₁ + ϖ y₂`, … and `t₀ = ∑ ϖⁿ aₙ`, the
differences `yₙ - φ tₙ` form such a sequence, so `y = φ t₀`. -/
theorem surjective_of_forall_exists_add_smul {ϖ : R} {N : Type*} [AddCommGroup N] [Module R N]
    (hN : ∀ a : ℕ → N, ∃ t : ℕ → N, ∀ n, t n = a n + ϖ • t (n + 1))
    (hM : ∀ x : ℕ → M, (∀ n, x n = ϖ • x (n + 1)) → x 0 = 0)
    (φ : N →ₗ[R] M) (h : ∀ y : M, ∃ a y', y = φ a + ϖ • y') : Function.Surjective φ := by
  choose A G hAG using h
  intro y
  obtain ⟨t, ht⟩ := hN fun n ↦ A (G^[n] y)
  refine ⟨t 0, ?_⟩
  have key := hM (fun n ↦ G^[n] y - φ (t n)) fun n ↦ by
    rw [Function.iterate_succ_apply', ht n, map_add, map_smul, smul_sub]
    calc G^[n] y - (φ (A (G^[n] y)) + ϖ • φ (t (n + 1)))
        = (φ (A (G^[n] y)) + ϖ • G (G^[n] y)) - (φ (A (G^[n] y)) + ϖ • φ (t (n + 1))) := by
          rw [← hAG]
      _ = ϖ • G (G^[n] y) - ϖ • φ (t (n + 1)) := by abel
  rw [Function.iterate_zero_apply, sub_eq_zero] at key
  exact key.symm

/-- **Finite generation from finite generation modulo `ϖ`.** Let `R` be `ϖ`-adically complete
and `M` a module in which every sequence `x` with `x n = ϖ • x (n + 1)` has `x 0 = 0`. If `M` is
generated by a finite set `s` modulo `ϖ M`, it is finitely generated. -/
theorem finite_of_forall_exists_add_smul {ϖ : R} [IsAdicComplete (Ideal.span {ϖ}) R]
    (hM : ∀ x : ℕ → M, (∀ n, x n = ϖ • x (n + 1)) → x 0 = 0) (s : Finset M)
    (h : ∀ y : M, ∃ z ∈ Submodule.span R (s : Set M), ∃ y', y = z + ϖ • y') :
    Module.Finite R M := by
  let φ := Fintype.linearCombination R (fun i : s ↦ (i : M))
  have hφ : LinearMap.range φ = Submodule.span R (s : Set M) := by
    rw [Fintype.range_linearCombination, Subtype.range_coe_subtype]
    rfl
  refine Module.Finite.of_surjective φ (surjective_of_forall_exists_add_smul
    (IsAdicComplete.exists_eq_add_smul_pi (ϖ := ϖ)) hM φ fun y ↦ ?_)
  obtain ⟨z, hz, y', rfl⟩ := h y
  rw [← hφ] at hz
  obtain ⟨a, rfl⟩ := hz
  exact ⟨a, y', rfl⟩

end Module
