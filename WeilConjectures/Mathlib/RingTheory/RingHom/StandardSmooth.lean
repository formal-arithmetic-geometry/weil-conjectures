module

public import Mathlib.RingTheory.RingHom.StandardSmooth
public import Mathlib.RingTheory.TensorProduct.MvPolynomial
public import WeilConjectures.Mathlib.RingTheory.Regular.RegularSequence
public import WeilConjectures.Mathlib.RingTheory.Unramified.Finite

/-!
# The diagonal of an algebra étale over a polynomial ring

Let `φ : R[X₀, …, X_{d-1}] → A` be an étale `R`-algebra map, so that `A` is standard smooth of
relative dimension `d` over `R` with coordinates `aᵢ = φ(Xᵢ)`
(`Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial`). The kernel of the
multiplication `A ⊗[R] A → A` is then, after inverting a single element `e` with `e ↦ 1`,
generated by the weakly regular sequence `1 ⊗ aᵢ - aᵢ ⊗ 1`:

- `Algebra.TensorProduct.isWeaklyRegular_ofFn_one_tmul_sub_tmul_one`: the sequence is weakly
  regular in `A ⊗[R] A`; it is the image of the weakly regular sequence `Xᵢ - aᵢ` of
  `A[X₀, …, X_{d-1}] = A ⊗[R] R[X₀, …, X_{d-1}]` under the flat map `A ⊗ φ`.
- `Algebra.TensorProduct.exists_lmul'_eq_one_mul_mem_ofList`: such an `e` exists; modulo the
  sequence, `A ⊗[R] A` becomes `A ⊗[R[X]] A`, in which the kernel of the multiplication is cut
  out by an idempotent since `A` is unramified over `R[X]`.
-/

@[expose] public section

open TensorProduct MvPolynomial RingTheory.Sequence

namespace Algebra.TensorProduct

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {d : ℕ}

/-- For a flat `R`-algebra map `φ : R[X₀, …, X_{d-1}] → A`, the sequence `1 ⊗ φ(Xᵢ) - φ(Xᵢ) ⊗ 1`
is weakly regular in `A ⊗[R] A`. -/
theorem isWeaklyRegular_ofFn_one_tmul_sub_tmul_one (φ : MvPolynomial (Fin d) R →ₐ[R] A)
    (hφ : (φ : MvPolynomial (Fin d) R →+* A).Flat) :
    IsWeaklyRegular (A ⊗[R] A) (List.ofFn fun i ↦ (1 : A) ⊗ₜ[R] φ (X i) - φ (X i) ⊗ₜ[R] 1) := by
  let ψ : MvPolynomial (Fin d) A →+* A ⊗[R] A :=
    (lTensor (S := A) A φ : A ⊗[R] MvPolynomial (Fin d) R →+* A ⊗[R] A).comp
      (algebraTensorAlgEquiv (σ := Fin d) R A).symm.toRingEquiv.toRingHom
  have hψ : ψ.Flat :=
    .comp (.of_bijective (algebraTensorAlgEquiv R A).symm.bijective) (RingHom.Flat.lTensor A hφ)
  have hC (i : Fin d) :
      (algebraTensorAlgEquiv (σ := Fin d) R A).symm (C (φ (X i))) = φ (X i) ⊗ₜ[R] 1 := by
    rw [← algebraMap_eq, AlgEquiv.commutes, algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply]
  have hl : (List.ofFn fun i ↦ X i - C (φ (X i))).map ψ =
      List.ofFn fun i ↦ (1 : A) ⊗ₜ[R] φ (X i) - φ (X i) ⊗ₜ[R] 1 := by
    rw [List.map_ofFn]
    congr 1
    ext i
    simp [ψ, hC]
  rw [← hl]
  exact (isWeaklyRegular_ofFn_X_sub_C fun i ↦ φ (X i)).map_of_flat hψ

/-- For an étale `R`-algebra map `φ : R[X₀, …, X_{d-1}] → A`, there is `e : A ⊗[R] A` mapping to
`1` under the multiplication `A ⊗[R] A → A` which multiplies the kernel of the multiplication
into the ideal generated by `1 ⊗ φ(Xᵢ) - φ(Xᵢ) ⊗ 1`. -/
theorem exists_lmul'_eq_one_mul_mem_ofList (φ : MvPolynomial (Fin d) R →ₐ[R] A)
    (hφ : (φ : MvPolynomial (Fin d) R →+* A).Etale) :
    ∃ e : A ⊗[R] A, lmul' R e = 1 ∧ ∀ k ∈ RingHom.ker (lmul' R (S := A)),
      e * k ∈ Ideal.ofList (List.ofFn fun i ↦ (1 : A) ⊗ₜ[R] φ (X i) - φ (X i) ⊗ₜ[R] 1) := by
  algebraize [(φ : MvPolynomial (Fin d) R →+* A)]
  have : IsScalarTower R (MvPolynomial (Fin d) R) A :=
    .of_algebraMap_eq' φ.comp_algebraMap.symm
  have : Algebra.Etale (MvPolynomial (Fin d) R) A := hφ
  obtain ⟨e, he, hek⟩ :=
    FormallyUnramified.exists_lmul'_eq_one_mul_mem_ker (R := R) (P := MvPolynomial (Fin d) R)
      (A := A)
  refine ⟨e, he, fun k hk ↦ ker_mapOfCompatibleSMul_le _ (fun p ↦ ?_) (hek k hk)⟩
  change φ p ⊗ₜ[R] (1 : A) - 1 ⊗ₜ[R] φ p ∈ _
  induction p using MvPolynomial.induction_on with
  | C r => simp [Algebra.algebraMap_eq_smul_one, smul_tmul]
  | add p q hp hq =>
    convert add_mem hp hq using 1
    simp only [map_add, add_tmul, tmul_add]
    abel
  | mul_X p i hp =>
    have hi : (1 : A) ⊗ₜ[R] φ (X i) - φ (X i) ⊗ₜ[R] 1 ∈
        Ideal.ofList (List.ofFn fun i ↦ (1 : A) ⊗ₜ[R] φ (X i) - φ (X i) ⊗ₜ[R] 1) :=
      Ideal.subset_span (List.mem_ofFn.mpr ⟨i, rfl⟩)
    convert add_mem (Ideal.mul_mem_left _ (φ p ⊗ₜ[R] (1 : A)) (neg_mem hi))
      (Ideal.mul_mem_left _ ((1 : A) ⊗ₜ[R] φ (X i)) hp) using 1
    simp only [map_mul, tmul_mul_tmul, mul_one, one_mul, mul_sub, mul_neg]
    rw [mul_comm (φ (X i)) (φ p)]
    abel

end Algebra.TensorProduct
