/-!
# The dimension of a finitely generated domain over a field

The Krull dimension of a domain `A` that is a finitely generated algebra over a field `k` is the
transcendence degree of `A`, equivalently of its field of fractions, over `k`.

The transcendence degree used here is `Algebra.trdeg`, the cardinal-valued transcendence degree of
`Mathlib/RingTheory/AlgebraicIndependent/Basic.lean`: it is defined for an arbitrary algebra, not
just for a field extension, and `Algebra.trdeg k A` therefore already makes sense for the ring `A`
itself. It is finite here, so the comparison with `ringKrullDim A : WithBot ℕ∞` is made through
`Cardinal.toNat`.

## Main results

* `ringKrullDim_eq_trdeg`: `ringKrullDim A = Cardinal.toNat (Algebra.trdeg k A)` for a domain `A`
  which is a finitely generated algebra over a field `k`.
* `ringKrullDim_eq_trdeg_of_isFractionRing`: the same with the transcendence degree taken over the
  field of fractions of `A`, `ringKrullDim A = Cardinal.toNat (Algebra.trdeg k K)`.
* `Algebra.FiniteType.exists_ringKrullDim_le`: a finitely generated algebra over a field has
  finite Krull dimension.
* `ringKrullDim_quotient_lt`: quotienting a finitely generated domain over a field by a nonzero
  prime strictly drops the Krull dimension.

The first two are proved from Noether normalization: `A` is finite, hence integral, over a
polynomial ring `k[X₀, …, X_{s-1}]` embedded in it, and both sides of the equality are unchanged
on passing to that subring — the Krull dimension by `Algebra.IsIntegral.ringKrullDim_eq` and the
transcendence degree because `A` is algebraic over it.

The same normalization, now combined with going down, gives the dimension formula:

* `Ideal.height_add_ringKrullDim_quotient`: `height p + dim (A ⧸ p) = dim A` for a prime `p` of a
  domain `A` which is a finitely generated algebra over a field `k`. In other words such an `A` is
  catenary and equidimensional.
* `ringKrullDim_quotient_add_one_of_height_eq_one`: the case of a height one prime, which is the
  inductive step of the dimension formula.
* `MvPolynomial.ringKrullDim_quotient_add_one_of_height_eq_one`: the same for a polynomial ring,
  where a height one prime is generated by a single irreducible polynomial `g`; the variables
  other than one occurring in `g` remain algebraically independent modulo `g`, by
  `MvPolynomial.algebraicIndependent_quotient_span_singleton`.

Only the inequality `height p + dim (A ⧸ p) ≥ dim A` has content: the reverse one is
concatenation of chains. Going down is available because a polynomial ring over a field is a
unique factorisation domain, hence integrally closed.
-/

@[expose] public section

variable (k : Type*) (A : Type*) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
  [Algebra.FiniteType k A]

/-- **The dimension of a finitely generated domain over a field is its transcendence degree.**

If `A` is a domain which is a finitely generated algebra over a field `k`, then the Krull dimension
of `A` is the transcendence degree of `A` over `k`. -/
theorem ringKrullDim_eq_trdeg : ringKrullDim A = Cardinal.toNat (Algebra.trdeg k A) := by
  obtain ⟨s, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg k A
  let _ : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin s) k) A := IsScalarTower.of_algHom g
  have : Module.Finite (MvPolynomial (Fin s) k) A := hfin
  have hfaithful : FaithfulSMul (MvPolynomial (Fin s) k) A :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  have hbase : FaithfulSMul k (MvPolynomial (Fin s) k) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (MvPolynomial.C_injective _ _)
  have htrdeg : Cardinal.toNat (Algebra.trdeg k A) = s := by
    have hz : Algebra.trdeg (MvPolynomial (Fin s) k) A = 0 := trdeg_eq_zero
    have h := lift_trdeg_add_eq k (MvPolynomial (Fin s) k) A
    rw [hz, MvPolynomial.trdeg_of_isDomain] at h
    simpa using congrArg Cardinal.toNat h.symm
  rw [htrdeg, Algebra.IsIntegral.ringKrullDim_eq (MvPolynomial (Fin s) k) A,
    MvPolynomial.ringKrullDim_fin_of_field]

/-- **The dimension of a finitely generated domain over a field is the transcendence degree of its
function field.**

If `A` is a domain which is a finitely generated algebra over a field `k` and `K` is a field of
fractions of `A`, then the Krull dimension of `A` is the transcendence degree of `K` over `k`. -/
@[stacks 00P0]
theorem ringKrullDim_eq_trdeg_of_isFractionRing (K : Type*) [Field K] [Algebra A K] [Algebra k K]
    [IsScalarTower k A K] [IsFractionRing A K] :
    ringKrullDim A = Cardinal.toNat (Algebra.trdeg k K) := by
  have : FaithfulSMul k A :=
    (faithfulSMul_iff_algebraMap_injective k A).mpr (algebraMap k A).injective
  have h : Cardinal.toNat (Algebra.trdeg k K) = Cardinal.toNat (Algebra.trdeg k A) := by
    simpa using congrArg Cardinal.toNat (IsFractionRing.lift_trdeg_eq k A K)
  rw [h, ringKrullDim_eq_trdeg k A]

/-- A finitely generated algebra over a field has finite Krull dimension: it is a quotient of a
polynomial ring in finitely many variables. -/
theorem Algebra.FiniteType.exists_ringKrullDim_le (k : Type*) (A : Type*) [Field k] [CommRing A]
    [Algebra k A] [Algebra.FiniteType k A] : ∃ n : ℕ, ringKrullDim A ≤ n := by
  obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  refine ⟨n, ?_⟩
  rw [← MvPolynomial.ringKrullDim_fin_of_field k n]
  exact ringKrullDim_le_of_surjective φ.toRingHom hφ

/-- A ring which is of finite type over a field has finite Krull dimension. -/
theorem RingHom.FiniteType.exists_ringKrullDim_le {k A : Type*} [Field k] [CommRing A]
    {φ : k →+* A} (hφ : φ.FiniteType) : ∃ n : ℕ, ringKrullDim A ≤ n :=
  let _ : Algebra k A := φ.toAlgebra
  have : Algebra.FiniteType k A := hφ
  Algebra.FiniteType.exists_ringKrullDim_le k A

include k in
/-- **Quotienting by a nonzero prime lowers the dimension.**

If `A` is a domain which is a finitely generated algebra over a field `k` and `p` is a nonzero
prime ideal of `A`, then `dim (A ⧸ p) < dim A`.

A nonzero element of `p` is a nonzero divisor of `A`, so any chain of primes of `A ⧸ p` extends
by the zero ideal to a chain of primes of `A` of length one more; the dimension of `A ⧸ p` is
finite because `A ⧸ p` is again a finitely generated `k`-algebra. -/
theorem ringKrullDim_quotient_lt (p : Ideal A) [p.IsPrime] (hp : p ≠ ⊥) :
    ringKrullDim (A ⧸ p) < ringKrullDim A := by
  obtain ⟨r, hrp, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp
  have hle : ringKrullDim (A ⧸ p) + 1 ≤ ringKrullDim A :=
    ringKrullDim_succ_le_of_surjective (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
      (mem_nonZeroDivisors_of_ne_zero hr0) (Ideal.Quotient.eq_zero_iff_mem.mpr hrp)
  rw [ringKrullDim_eq_trdeg k (A ⧸ p)] at hle ⊢
  exact ENat.WithBot.add_one_le_iff.mp hle

/-- If `g` is a nonzero polynomial in which the variable `i` occurs, then the images of all the
other variables in `k[X₀, …, Xₙ] ⧸ (g)` are algebraically independent over `k`.

Indeed a polynomial in the other variables which is divisible by `g` is either zero or has
degree at least `1` in the variable `i`, which it does not. -/
theorem MvPolynomial.algebraicIndependent_quotient_span_singleton (k : Type*) [Field k] {n : ℕ}
    {g : MvPolynomial (Fin (n + 1)) k} (hg0 : g ≠ 0) {i : Fin (n + 1)} (hi : g.degreeOf i ≠ 0) :
    AlgebraicIndependent k fun j : Fin n ↦
      Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X (i.succAbove j)) := by
  classical
  rw [algebraicIndependent_iff_injective_aeval]
  have key : (MvPolynomial.aeval fun j : Fin n ↦
        Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X (i.succAbove j)) :
        MvPolynomial (Fin n) k →ₐ[k] _) =
      (Ideal.Quotient.mkₐ k (Ideal.span {g})).comp (MvPolynomial.rename i.succAbove) := by
    apply MvPolynomial.algHom_ext
    intro j
    simp
  rw [key, injective_iff_map_eq_zero]
  intro h hh
  simp only [AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hh
  by_contra hne
  have hfne : MvPolynomial.rename i.succAbove h ≠ 0 := fun hc ↦
    hne (MvPolynomial.rename_injective _ Fin.succAbove_right_injective (by simpa using hc))
  have hvars : (MvPolynomial.rename i.succAbove h).degreeOf i = 0 := by
    by_contra hc
    obtain ⟨j, -, hj⟩ := MvPolynomial.mem_vars_rename _ _
      (MvPolynomial.mem_vars_iff_degreeOf_ne_zero.mpr hc)
    exact Fin.succAbove_ne i j hj
  obtain ⟨c, hc⟩ := hh
  have hcne : c ≠ 0 := by rintro rfl; simp only [mul_zero] at hc; exact hfne hc
  rw [hc, MvPolynomial.degreeOf_mul_eq hg0 hcne] at hvars
  omega

/-- **Quotienting a polynomial ring by a height one prime lowers the dimension by exactly one.**

A height one prime `q` of `k[X₀, …, X_{n-1}]` is generated by an irreducible polynomial `g`, and
the `n - 1` variables other than one occurring in `g` stay algebraically independent modulo `g`. -/
theorem MvPolynomial.ringKrullDim_quotient_add_one_of_height_eq_one (k : Type*) [Field k] (n : ℕ)
    (q : Ideal (MvPolynomial (Fin n) k)) [q.IsPrime] (hq : q.height = 1) :
    ringKrullDim (MvPolynomial (Fin n) k ⧸ q) + 1 = n := by
  have hdim : ringKrullDim (MvPolynomial (Fin n) k) = n :=
    MvPolynomial.ringKrullDim_fin_of_field k n
  have hqbot : q ≠ ⊥ := q.ne_bot_of_height_eq_one hq
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := Nat.exists_eq_succ_of_ne_zero <| by
    rintro rfl
    have h := Ideal.height_le_ringKrullDim_of_isPrime (I := q)
    rw [hq, hdim, Nat.cast_zero, ← WithBot.coe_zero, WithBot.coe_le_coe] at h
    simp at h
  obtain ⟨g, hgmem, hgprime⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹q.IsPrime› hqbot
  have hqspan : q = Ideal.span {g} := Ideal.eq_span_singleton_of_height_eq_one hq hgmem hgprime
  subst hqspan
  obtain ⟨i, hi⟩ : ∃ i, g.degreeOf i ≠ 0 := by
    by_contra hcon
    push Not at hcon
    have hv : g.vars = ∅ := by
      ext j
      simp [MvPolynomial.mem_vars_iff_degreeOf_ne_zero, hcon j]
    rw [MvPolynomial.vars_eq_empty_iff_eq_C] at hv
    have hc0 : g.coeff 0 ≠ 0 := fun h ↦ hgprime.ne_zero (by rw [hv, h, map_zero])
    exact hgprime.not_isUnit (hv ▸ (isUnit_iff_ne_zero.mpr hc0).map MvPolynomial.C)
  have hai := MvPolynomial.algebraicIndependent_quotient_span_singleton k hgprime.ne_zero hi
  set t := Cardinal.toNat (Algebra.trdeg k (MvPolynomial (Fin (m + 1)) k ⧸ Ideal.span {g})) with ht
  have hdq : ringKrullDim (MvPolynomial (Fin (m + 1)) k ⧸ Ideal.span {g}) = (t : ℕ) :=
    ringKrullDim_eq_trdeg k _
  -- the `m` remaining variables are algebraically independent modulo `g`
  have hmt : m ≤ t := by
    have h2 : Cardinal.lift (Algebra.trdeg k (MvPolynomial (Fin (m + 1)) k ⧸ Ideal.span {g}))
        < Cardinal.aleph0 :=
      Cardinal.lift_lt_aleph0.mpr trdeg_lt_aleph0_of_finiteType
    simpa [ht] using Cardinal.toNat_le_toNat hai.lift_cardinalMk_le_trdeg h2
  -- and quotienting by the nonzero prime `(g)` does drop the dimension
  have htm : t < m + 1 := by
    have hlt := ringKrullDim_quotient_lt k (MvPolynomial (Fin (m + 1)) k) (Ideal.span {g}) hqbot
    rw [hdq, hdim] at hlt
    exact_mod_cast hlt
  rw [hdq, show t = m from le_antisymm (by omega) hmt]
  norm_cast

/-- **Quotienting a finitely generated domain over a field by a height one prime lowers the
dimension by exactly one.**

By Noether normalization `A` is finite over a polynomial ring `P`; the contraction `q` of `p`
to `P` again has height one, by incomparability and by going down, the latter being available
because `P` is a unique factorisation domain, hence integrally closed. Both `dim A = dim P` and
`dim (A ⧸ p) = dim (P ⧸ q)` because the extensions are integral and injective, so the statement
follows from the case of a polynomial ring. -/
theorem ringKrullDim_quotient_add_one_of_height_eq_one (k A : Type*) [Field k] [CommRing A]
    [IsDomain A] [Algebra k A] [Algebra.FiniteType k A] (p : Ideal A) [p.IsPrime]
    (hp : p.height = 1) :
    ringKrullDim (A ⧸ p) + 1 = ringKrullDim A := by
  obtain ⟨s, f, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg k A
  let _ : Algebra (MvPolynomial (Fin s) k) A := f.toRingHom.toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin s) k) A := IsScalarTower.of_algHom f
  have : Module.Finite (MvPolynomial (Fin s) k) A := hfin
  have : FaithfulSMul (MvPolynomial (Fin s) k) A :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  have hq : (p.under (MvPolynomial (Fin s) k)).height = 1 := by
    rw [Ideal.height_under_eq_of_hasGoingDown, hp]
  rw [Algebra.IsIntegral.ringKrullDim_quotient_under_eq (MvPolynomial (Fin s) k) A p,
    Algebra.IsIntegral.ringKrullDim_eq (MvPolynomial (Fin s) k) A,
    MvPolynomial.ringKrullDim_fin_of_field]
  exact MvPolynomial.ringKrullDim_quotient_add_one_of_height_eq_one k s _ hq

/-- **The dimension formula for a finitely generated domain over a field.**

If `A` is a domain which is a finitely generated algebra over a field `k` and `p` is a prime
ideal of `A`, then `height p + dim (A ⧸ p) = dim A`.

The proof is by induction on the height of `p`. If `p` has height `n + 1`, a chain of primes
realising the height has a prime `p'` one step below `p`; then `p'` has height `n`, and `p ⧸ p'`
has height one in the finitely generated domain `A ⧸ p'`, so that
`dim (A ⧸ p) + 1 = dim (A ⧸ p')`. -/
theorem Ideal.height_add_ringKrullDim_quotient (k A : Type*) [Field k] [CommRing A] [IsDomain A]
    [Algebra k A] [Algebra.FiniteType k A] (p : Ideal A) [p.IsPrime] :
    (p.height : WithBot ℕ∞) + ringKrullDim (A ⧸ p) = ringKrullDim A := by
  have hA : ringKrullDim A = (Cardinal.toNat (Algebra.trdeg k A) : ℕ) := ringKrullDim_eq_trdeg k A
  have : FiniteRingKrullDim A :=
    finiteRingKrullDim_iff_ne_bot_and_top.mpr ⟨by rw [hA]; simp, by
      rw [hA, ← WithBot.coe_natCast, Ne, WithBot.coe_eq_top]
      exact ENat.natCast_ne_top _⟩
  obtain ⟨N, hN⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := p))
  suffices H : ∀ (N : ℕ) (p : Ideal A) (_ : p.IsPrime), p.height = N →
      (p.height : WithBot ℕ∞) + ringKrullDim (A ⧸ p) = ringKrullDim A from
    H N p ‹_› hN.symm
  clear! p
  intro N
  induction N with
  | zero =>
    intro p hp hh
    have := hp
    have hbot : p = ⊥ := Ideal.height_eq_zero_iff_eq_bot.mp (by rw [hh]; simp)
    subst hbot
    rw [hh, ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot A)]
    simp
  | succ N ih =>
    intro p hp hh
    have := hp
    obtain ⟨p', hp'prime, hlt, hge⟩ :
        ∃ p' : Ideal A, p'.IsPrime ∧ p' < p ∧ (N : ℕ∞) ≤ p'.height := by
      obtain ⟨l, hlast, hlen⟩ := p.exists_ltSeries_length_eq_height
      have hlen' : l.length = N + 1 := by exact_mod_cast hlen.trans hh
      refine ⟨l.eraseLast.last.asIdeal, l.eraseLast.last.isPrime,
        (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr
          (hlast ▸ l.eraseLast_last_rel_last (by omega)), ?_⟩
      rw [PrimeSpectrum.height_eq_orderHeight l.eraseLast.last]
      simpa [hlen'] using Order.length_le_height_last (p := l.eraseLast)
    have := hp'prime
    have hle' : p' ≤ p := hlt.le
    -- the prime one step below `p` in a chain realising the height has height exactly `N`
    have hp'h : p'.height = (N : ℕ∞) := by
      have hle := Ideal.height_add_one_le_of_lt_of_isPrime hlt
      rw [hh] at hle
      obtain ⟨j, hj⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := p'))
      rw [← hj] at hge hle ⊢
      have h2 : (j : ℕ∞) + 1 ≤ (N : ℕ∞) + 1 := by push_cast at hle ⊢; exact hle
      have h3 : j ≤ N := by
        exact_mod_cast (WithTop.add_le_add_iff_right (by simp)).mp h2
      have h4 : N ≤ j := by exact_mod_cast hge
      exact_mod_cast le_antisymm h3 h4
    have hih := ih _ hp'prime hp'h
    -- `p ⧸ p'` has height one in `A ⧸ p'`
    have hPprime : (p.map (Ideal.Quotient.mk p')).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hle')
    have hcomapP : Ideal.comap (Ideal.Quotient.mk p') (p.map (Ideal.Quotient.mk p')) = p := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hle']
    have hPne : p.map (Ideal.Quotient.mk p') ≠ ⊥ := by
      intro hbot
      have hpp : p ≤ p' := by
        have h1 : p ≤ Ideal.comap (Ideal.Quotient.mk p') (p.map (Ideal.Quotient.mk p')) :=
          Ideal.le_comap_map
        rw [hbot] at h1
        simpa [← RingHom.ker_eq_comap_bot, Ideal.mk_ker] using h1
      exact absurd (hlt.trans_le hpp) (lt_irrefl _)
    have hPheight : (p.map (Ideal.Quotient.mk p')).height = 1 := by
      refine le_antisymm ?_ (Order.one_le_iff_ne_zero.mpr ?_)
      · rw [show ((1 : ℕ∞)) = ((1 : ℕ) : ℕ∞) from by norm_cast, Ideal.height_le_iff]
        intro Q hQ hQlt
        have := hQ
        -- a prime strictly below `p ⧸ p'` contracts to a prime between `p'` and `p`
        have hrle : p' ≤ Q.comap (Ideal.Quotient.mk p') := by
          simpa [← RingHom.ker_eq_comap_bot, Ideal.mk_ker] using
            Ideal.comap_mono (f := Ideal.Quotient.mk p') (bot_le : ⊥ ≤ Q)
        have hrlt : Q.comap (Ideal.Quotient.mk p') < p := by
          rw [← hcomapP]
          refine lt_of_le_of_ne (Ideal.comap_mono hQlt.le) fun hEq ↦ hQlt.ne ?_
          rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk p')
              Ideal.Quotient.mk_surjective Q, hEq,
            Ideal.map_comap_of_surjective (Ideal.Quotient.mk p') Ideal.Quotient.mk_surjective]
        -- it cannot lie strictly between them, as `p` has height `N + 1`
        have hrp' : Q.comap (Ideal.Quotient.mk p') = p' := by
          by_contra hne'
          have h2 := Ideal.height_add_one_le_of_lt_of_isPrime (lt_of_le_of_ne hrle (Ne.symm hne'))
          have h3 := Ideal.height_add_one_le_of_lt_of_isPrime hrlt
          rw [hp'h] at h2
          rw [hh] at h3
          have hcon : ((N + 2 : ℕ) : ℕ∞) ≤ ((N + 1 : ℕ) : ℕ∞) := by
            push_cast
            calc (N : ℕ∞) + 1 + 1
                ≤ (Q.comap (Ideal.Quotient.mk p')).height + 1 := by gcongr
              _ ≤ (N : ℕ∞) + 1 := by push_cast at h3; exact h3
          have := (Nat.cast_le (α := ℕ∞)).mp hcon
          omega
        have hQbot : Q = ⊥ := by
          rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk p') Ideal.Quotient.mk_surjective Q,
            hrp', Ideal.map_quotient_self]
        rw [hQbot]
        simp
      · rw [Ne, Ideal.height_eq_zero_iff_eq_bot]
        exact hPne
    have hkey := ringKrullDim_quotient_add_one_of_height_eq_one k (A ⧸ p') _ hPheight
    rw [ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hle')] at hkey
    rw [hp'h] at hih
    rw [hh, ← hih, ← hkey]
    push_cast
    abel
