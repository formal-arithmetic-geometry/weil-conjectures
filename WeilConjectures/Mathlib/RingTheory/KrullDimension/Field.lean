/-!
# The dimension of a finitely generated domain over a field

The Krull dimension of a domain `A` that is a finitely generated algebra over a field `k` is the
transcendence degree of `A`, equivalently of its field of fractions, over `k`.

The transcendence degree used here is `Algebra.trdeg`, the cardinal-valued transcendence degree of
`Mathlib/RingTheory/AlgebraicIndependent/Basic.lean`: it is defined for an arbitrary algebra, not
just for a field extension, and `Algebra.trdeg k A` therefore already makes sense for the ring `A`
itself. It is finite here, so the comparison with `ringKrullDim A : WithBot ℕ∞` is made through
`Cardinal.toNat`.

## Main results

* `ringKrullDim_eq_trdeg`: `ringKrullDim A = Cardinal.toNat (Algebra.trdeg k A)` for a domain `A`
  which is a finitely generated algebra over a field `k`.
* `ringKrullDim_eq_trdeg_of_isFractionRing`: the same with the transcendence degree taken over the
  field of fractions of `A`, `ringKrullDim A = Cardinal.toNat (Algebra.trdeg k K)`.
* `Algebra.FiniteType.exists_ringKrullDim_le`: a finitely generated algebra over a field has
  finite Krull dimension.
* `ringKrullDim_quotient_lt`: quotienting a finitely generated domain over a field by a nonzero
  prime strictly drops the Krull dimension.

The first two are proved from Noether normalization: `A` is finite, hence integral, over a
polynomial ring `k[X₀, …, X_{s-1}]` embedded in it, and both sides of the equality are unchanged
on passing to that subring — the Krull dimension by `Algebra.IsIntegral.ringKrullDim_eq` and the
transcendence degree because `A` is algebraic over it.

The same normalization, now combined with going down, gives the dimension formula:

* `Ideal.height_add_ringKrullDim_quotient`: `height p + dim (A ⧸ p) = dim A` for a prime `p` of a
  domain `A` which is a finitely generated algebra over a field `k`.
* `Ideal.height_eq_ringKrullDim_of_isMaximal`: every maximal ideal of such an `A` has height
  `dim A`; equivalently, the local ring of `A` at a closed point has dimension `dim A`.
* `Ideal.height_under_eq_of_ringKrullDim_eq`: if `B` is an integral algebra over `A`, both being
  finitely generated domains over `k` of the same dimension, then a prime of `B` and its
  contraction to `A` have the same height. This is the algebraic form of the statement that a
  finite morphism between varieties of the same dimension preserves codimension.

Only the inequality `height p + dim (A ⧸ p) ≥ dim A` has content: the reverse one holds over an
arbitrary commutative ring by concatenation of chains, and is
`Ideal.height_add_ringKrullDim_quotient_le`. Going down is available because a polynomial ring
over a field is a unique factorization domain, hence integrally closed.

Two intermediate statements are recorded as theorems because they carry the induction:
`ringKrullDim_quotient_add_one_of_height_eq_one`, the case of a height one prime, and
`MvPolynomial.ringKrullDim_quotient_add_one_of_height_eq_one`, its polynomial ring case, where a
height one prime is generated by a single irreducible polynomial `g` and the variables other than
one occurring in `g` remain algebraically independent modulo `g`. Both are subsumed by the
dimension formula.
-/

@[expose] public section

variable (k : Type*) (A : Type*) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
  [Algebra.FiniteType k A]

/-- **The dimension of a finitely generated domain over a field is its transcendence degree.**

If `A` is a domain which is a finitely generated algebra over a field `k`, then the Krull dimension
of `A` is the transcendence degree of `A` over `k`. -/
theorem ringKrullDim_eq_trdeg : ringKrullDim A = Cardinal.toNat (Algebra.trdeg k A) := by
  obtain ⟨s, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg k A
  let _ : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin s) k) A := IsScalarTower.of_algHom g
  have : Module.Finite (MvPolynomial (Fin s) k) A := hfin
  have hfaithful : FaithfulSMul (MvPolynomial (Fin s) k) A :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  have hbase : FaithfulSMul k (MvPolynomial (Fin s) k) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (MvPolynomial.C_injective _ _)
  have htrdeg : Cardinal.toNat (Algebra.trdeg k A) = s := by
    have hz : Algebra.trdeg (MvPolynomial (Fin s) k) A = 0 := trdeg_eq_zero
    have h := lift_trdeg_add_eq k (MvPolynomial (Fin s) k) A
    rw [hz, MvPolynomial.trdeg_of_isDomain] at h
    simpa using congrArg Cardinal.toNat h.symm
  rw [htrdeg, Algebra.IsIntegral.ringKrullDim_eq (MvPolynomial (Fin s) k) A,
    MvPolynomial.ringKrullDim_fin_of_field]

/-- **The dimension of a finitely generated domain over a field is the transcendence degree of its
function field.**

If `A` is a domain which is a finitely generated algebra over a field `k` and `K` is a field of
fractions of `A`, then the Krull dimension of `A` is the transcendence degree of `K` over `k`. -/
@[stacks 00P0]
theorem ringKrullDim_eq_trdeg_of_isFractionRing (K : Type*) [Field K] [Algebra A K] [Algebra k K]
    [IsScalarTower k A K] [IsFractionRing A K] :
    ringKrullDim A = Cardinal.toNat (Algebra.trdeg k K) := by
  have : FaithfulSMul k A :=
    (faithfulSMul_iff_algebraMap_injective k A).mpr (algebraMap k A).injective
  have h : Cardinal.toNat (Algebra.trdeg k K) = Cardinal.toNat (Algebra.trdeg k A) := by
    simpa using congrArg Cardinal.toNat (IsFractionRing.lift_trdeg_eq k A K)
  rw [h, ringKrullDim_eq_trdeg k A]

include k in
/-- A domain which is a finitely generated algebra over a field has finite Krull dimension. -/
theorem finiteRingKrullDim_of_finiteType : FiniteRingKrullDim A := by
  have hA : ringKrullDim A = (Cardinal.toNat (Algebra.trdeg k A) : ℕ) := ringKrullDim_eq_trdeg k A
  refine finiteRingKrullDim_iff_ne_bot_and_top.mpr ⟨by simp [hA], ?_⟩
  rw [hA, ← WithBot.coe_natCast, Ne, WithBot.coe_eq_top]
  exact ENat.natCast_ne_top _

/-- A finitely generated algebra over a field has finite Krull dimension: it is a quotient of a
polynomial ring in finitely many variables. -/
theorem Algebra.FiniteType.exists_ringKrullDim_le (k : Type*) (A : Type*) [Field k] [CommRing A]
    [Algebra k A] [Algebra.FiniteType k A] : ∃ n : ℕ, ringKrullDim A ≤ n := by
  obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  refine ⟨n, ?_⟩
  rw [← MvPolynomial.ringKrullDim_fin_of_field k n]
  exact ringKrullDim_le_of_surjective φ.toRingHom hφ

/-- A ring which is of finite type over a field has finite Krull dimension. -/
theorem RingHom.FiniteType.exists_ringKrullDim_le {k A : Type*} [Field k] [CommRing A]
    {φ : k →+* A} (hφ : φ.FiniteType) : ∃ n : ℕ, ringKrullDim A ≤ n :=
  let _ : Algebra k A := φ.toAlgebra
  have : Algebra.FiniteType k A := hφ
  Algebra.FiniteType.exists_ringKrullDim_le k A

include k in
/-- **Quotienting by a nonzero prime lowers the dimension.**

If `A` is a domain which is a finitely generated algebra over a field `k` and `p` is a nonzero
prime ideal of `A`, then `dim (A ⧸ p) < dim A`.

A nonzero element of `p` is a nonzero divisor of `A`, so any chain of primes of `A ⧸ p` extends
by the zero ideal to a chain of primes of `A` of length one more; the dimension of `A ⧸ p` is
finite because `A ⧸ p` is again a finitely generated `k`-algebra. -/
theorem ringKrullDim_quotient_lt (p : Ideal A) [p.IsPrime] (hp : p ≠ ⊥) :
    ringKrullDim (A ⧸ p) < ringKrullDim A := by
  obtain ⟨r, hrp, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp
  have hle : ringKrullDim (A ⧸ p) + 1 ≤ ringKrullDim A :=
    ringKrullDim_succ_le_of_surjective (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
      (mem_nonZeroDivisors_of_ne_zero hr0) (Ideal.Quotient.eq_zero_iff_mem.mpr hrp)
  rw [ringKrullDim_eq_trdeg k (A ⧸ p)] at hle ⊢
  exact ENat.WithBot.add_one_le_iff.mp hle

namespace MvPolynomial

/-- **Quotienting a polynomial ring by a height one prime lowers the dimension by exactly one.** -/
@[stacks 00OR]
theorem ringKrullDim_quotient_add_one_of_height_eq_one (n : ℕ)
    (q : Ideal (MvPolynomial (Fin n) k)) [q.IsPrime] (hq : q.height = 1) :
    ringKrullDim (MvPolynomial (Fin n) k ⧸ q) + 1 = n := by
  have hdim : ringKrullDim (MvPolynomial (Fin n) k) = n := ringKrullDim_fin_of_field k n
  have hqbot : q ≠ ⊥ := q.ne_bot_of_height_eq_one hq
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := Nat.exists_eq_succ_of_ne_zero <| by
    rintro rfl
    have h := Ideal.height_le_ringKrullDim_of_isPrime (I := q)
    rw [hq, hdim] at h
    norm_num at h
  -- a height one prime of a unique factorization domain is generated by a prime element
  obtain ⟨g, hgmem, hgprime⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹q.IsPrime› hqbot
  obtain rfl : q = Ideal.span {g} := Ideal.eq_span_singleton_of_height_eq_one hq hgmem hgprime
  obtain ⟨i, hi⟩ := vars_nonempty_of_prime hgprime
  have hcard : Cardinal.mk {j : Fin (m + 1) // j ≠ i} = (m : Cardinal) := by
    simp [Cardinal.mk_fintype, Fintype.card_subtype_compl]
  set t := Cardinal.toNat (Algebra.trdeg k (MvPolynomial (Fin (m + 1)) k ⧸ Ideal.span {g}))
  have hdq : ringKrullDim (MvPolynomial (Fin (m + 1)) k ⧸ Ideal.span {g}) = t :=
    ringKrullDim_eq_trdeg k _
  -- the `m` variables other than `i` are algebraically independent modulo `g`
  have hmt : m ≤ t := by
    have hfin : Cardinal.lift
        (Algebra.trdeg k (MvPolynomial (Fin (m + 1)) k ⧸ Ideal.span {g})) < Cardinal.aleph0 :=
      Cardinal.lift_lt_aleph0.mpr trdeg_lt_aleph0_of_finiteType
    have h := Cardinal.toNat_le_toNat
      (algebraicIndependent_quotient_span_singleton hi).lift_cardinalMk_le_trdeg hfin
    simpa [hcard] using h
  -- and quotienting by the nonzero prime `(g)` does drop the dimension
  have htm : t < m + 1 := by
    have hlt := ringKrullDim_quotient_lt k (MvPolynomial (Fin (m + 1)) k) (Ideal.span {g}) hqbot
    rw [hdq, hdim] at hlt
    exact_mod_cast hlt
  have htm' : t = m := le_antisymm (by omega) hmt
  rw [hdq, htm']
  norm_cast

end MvPolynomial

section DimensionFormula

variable {A}

include k in
/-- **Quotienting a finitely generated domain over a field by a height one prime lowers the
dimension by exactly one.** -/
@[stacks 00P1]
theorem ringKrullDim_quotient_add_one_of_height_eq_one (p : Ideal A) [p.IsPrime]
    (hp : p.height = 1) :
    ringKrullDim (A ⧸ p) + 1 = ringKrullDim A := by
  -- by Noether normalization `A` is finite over a polynomial ring `P`
  obtain ⟨s, f, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg k A
  let _ : Algebra (MvPolynomial (Fin s) k) A := f.toRingHom.toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin s) k) A := IsScalarTower.of_algHom f
  have : Module.Finite (MvPolynomial (Fin s) k) A := hfin
  have : FaithfulSMul (MvPolynomial (Fin s) k) A :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  -- `P` is a unique factorization domain, hence integrally closed, so going down holds and the
  -- contraction `q` of `p` to `P` again has height one
  have hq : (p.under (MvPolynomial (Fin s) k)).height = 1 := by
    rw [Algebra.HasGoingDown.height_under, hp]
  -- both quotients and both rings have the same dimension, the extensions being integral
  rw [Algebra.IsIntegral.ringKrullDim_quotient_eq (MvPolynomial (Fin s) k) A p,
    Algebra.IsIntegral.ringKrullDim_eq (MvPolynomial (Fin s) k) A,
    MvPolynomial.ringKrullDim_fin_of_field]
  exact MvPolynomial.ringKrullDim_quotient_add_one_of_height_eq_one k s _ hq

include k in
/-- The dimension formula, by induction on the height of `p`. -/
private theorem height_add_ringKrullDim_quotient_aux :
    ∀ (N : ℕ) (p : Ideal A) [p.IsPrime], p.height = N →
      (p.height : WithBot ℕ∞) + ringKrullDim (A ⧸ p) = ringKrullDim A := by
  intro N
  induction N with
  | zero =>
    intro p hp hh
    obtain rfl : p = ⊥ := Ideal.height_eq_zero_iff_eq_bot.mp (by simp [hh])
    rw [hh, ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot A)]
    simp
  | succ N ih =>
    intro p hp hh
    have hx : Order.height (⟨p, hp⟩ : PrimeSpectrum A) = (N : ℕ∞) + 1 := by
      rw [← PrimeSpectrum.height_eq_orderHeight, hh]
      norm_cast
    obtain ⟨-, ⟨p', hlt, hp'h⟩, hall⟩ := Order.height_eq_coe_add_one_iff.mp hx
    -- a prime of height `N` below `p` is covered by `p`, as nothing below `p` has height `> N`
    have hcov : p' ⋖ (⟨p, hp⟩ : PrimeSpectrum A) := by
      refine ⟨hlt, fun z hz hzp ↦ ?_⟩
      have h := (Order.height_add_one_le hz).trans (hall z hzp)
      rw [hp'h] at h
      simp [ENat.natCast_add_one_le_iff] at h
    have hle : p'.asIdeal ≤ p := (PrimeSpectrum.asIdeal_le_asIdeal p' ⟨p, hp⟩).mpr hlt.le
    have hih := ih p'.asIdeal (by rw [PrimeSpectrum.height_eq_orderHeight, hp'h])
    rw [PrimeSpectrum.height_eq_orderHeight, hp'h] at hih
    -- `p ⧸ p'` has height one in the finitely generated domain `A ⧸ p'`
    have hPprime : (p.map (Ideal.Quotient.mk p'.asIdeal)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    have hPheight := Ideal.height_map_quotientMk_of_covBy hcov
    have hkey := ringKrullDim_quotient_add_one_of_height_eq_one k (A := A ⧸ p'.asIdeal) _ hPheight
    rw [ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hle)] at hkey
    rw [hh, ← hih, ← hkey]
    push_cast
    abel

include k in
/-- **The dimension formula for a finitely generated domain over a field.**

If `A` is a domain which is a finitely generated algebra over a field `k` and `p` is a prime
ideal of `A`, then `height p + dim (A ⧸ p) = dim A`. -/
@[stacks 00P1]
theorem Ideal.height_add_ringKrullDim_quotient (p : Ideal A) [p.IsPrime] :
    (p.height : WithBot ℕ∞) + ringKrullDim (A ⧸ p) = ringKrullDim A := by
  have : FiniteRingKrullDim A := finiteRingKrullDim_of_finiteType k A
  obtain ⟨N, hN⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := p))
  exact height_add_ringKrullDim_quotient_aux k N p hN.symm

include k in
/-- **Every maximal ideal of a finitely generated domain over a field has height the dimension of
the ring.** Equivalently, the local ring of a variety at a closed point has the dimension of the
variety. -/
@[stacks 00OS]
theorem Ideal.height_eq_ringKrullDim_of_isMaximal (m : Ideal A) [m.IsMaximal] :
    (m.height : WithBot ℕ∞) = ringKrullDim A := by
  have hzero : ringKrullDim (A ⧸ m) = 0 := ringKrullDim_eq_zero_of_isField
    ((Ideal.Quotient.maximal_ideal_iff_isField_quotient m).mp ‹_›)
  have h := Ideal.height_add_ringKrullDim_quotient k m
  rwa [hzero, add_zero] at h

end DimensionFormula

section IntegralExtension

/-- **Contraction preserves height along an integral extension of finitely generated domains of
the same dimension.**

Let `A` and `B` be domains which are finitely generated algebras over a field `k`, with `B`
integral over `A`, and suppose that `A` and `B` have the same Krull dimension. Then every prime
`q` of `B` has the same height as its contraction `q ∩ A`.

Note that `A → B` is not assumed injective, and that going down — which would need `A` to be
integrally closed — is not used: the dimension formula in each of `A` and `B` reduces the claim to
`dim (A ⧸ q ∩ A) = dim (B ⧸ q)`, which holds because `A ⧸ q ∩ A → B ⧸ q` is an injective integral
extension. -/
theorem Ideal.height_under_eq_of_ringKrullDim_eq (k : Type*) [Field k] {A B : Type*} [CommRing A]
    [CommRing B] [IsDomain A] [IsDomain B] [Algebra k A] [Algebra k B] [Algebra.FiniteType k A]
    [Algebra.FiniteType k B] [Algebra A B] [Algebra.IsIntegral A B]
    (hdim : ringKrullDim A = ringKrullDim B) (q : Ideal B) [q.IsPrime] :
    (q.under A).height = q.height := by
  -- the two quotients are finitely generated domains over `k` of the same dimension
  have : Algebra.FiniteType k (A ⧸ q.under A) :=
    .of_surjective (Ideal.Quotient.mkₐ k (q.under A)) Ideal.Quotient.mk_surjective
  have hquot : ringKrullDim (B ⧸ q) = ringKrullDim (A ⧸ q.under A) :=
    Algebra.IsIntegral.ringKrullDim_quotient_eq A B q
  -- that common dimension is a natural number
  obtain ⟨n, hn⟩ : ∃ n : ℕ, ringKrullDim (A ⧸ q.under A) = (n : ℕ) :=
    ⟨_, ringKrullDim_eq_trdeg k (A ⧸ q.under A)⟩
  -- and so are the two heights
  have : FiniteRingKrullDim A := finiteRingKrullDim_of_finiteType k A
  have : FiniteRingKrullDim B := finiteRingKrullDim_of_finiteType k B
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := q.under A))
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := q))
  -- the dimension formula in `A` and in `B` now differ only by the height
  have hA := Ideal.height_add_ringKrullDim_quotient k (q.under A)
  have hB := Ideal.height_add_ringKrullDim_quotient k q
  rw [hn, ← ha, hdim] at hA
  rw [hquot, hn, ← hb] at hB
  have key : ((a : ℕ∞) : WithBot ℕ∞) + (n : WithBot ℕ∞) = ((b : ℕ∞) : WithBot ℕ∞) +
      (n : WithBot ℕ∞) := hA.trans hB.symm
  rw [← ha, ← hb]
  have hab : a + n = b + n := by exact_mod_cast key
  rw [Nat.add_right_cancel hab]

end IntegralExtension
