module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Unramified.Basic

/-!
# Étale algebras with a section

Let `C` be an étale `B`-algebra and `σ : C →ₐ[B] B` a `B`-algebra map (automatically a section
of `B → C`). Then `C ≅ B × R` as `B`-algebras for an étale `B`-algebra `R`, with the first
projection given by `σ`. Geometrically: a section of an étale morphism of affine schemes is an
open and closed immersion.

## Proof

The kernel `I` of the multiplication `C ⊗[B] C → C` is generated by an idempotent `e` because
`C` is unramified over `B` (`Ω[C⁄B] = 0`) and `I` is finitely generated. Pushing `e` forward along
`ψ : C ⊗[B] C → C`, `a ⊗ b ↦ σ(a) b`, gives an idempotent `ε` generating `ker σ`. Hence
`C ≅ C ⧸ (ε) × C ⧸ (1 - ε) ≅ B × R`, and `R = C ⧸ (1 - ε)` is the localization of `C` away
from `ε`, hence étale over `B`.

## Main statement

- `Algebra.Etale.exists_algEquiv_prod_of_algHom`
-/

@[expose] public section

universe u

open TensorProduct

namespace Algebra.Etale

variable {B C : Type u} [CommRing B] [CommRing C] [Algebra B C]

/-- The `B`-algebra map `C ⊗[B] C → C`, `a ⊗ b ↦ σ(a) b`, attached to a `B`-algebra map
`σ : C →ₐ[B] B`. -/
noncomputable def sectionMul (σ : C →ₐ[B] B) : C ⊗[B] C →ₐ[B] C :=
  Algebra.TensorProduct.lift ((Algebra.ofId B C).comp σ) (AlgHom.id B C) fun _ _ ↦ Commute.all _ _

@[simp]
lemma sectionMul_tmul (σ : C →ₐ[B] B) (a b : C) :
    sectionMul σ (a ⊗ₜ b) = algebraMap B C (σ a) * b := by
  simp [sectionMul]

/-- `σ ∘ sectionMul σ = σ ∘ lmul'`. -/
lemma comp_sectionMul (σ : C →ₐ[B] B) :
    σ.comp (sectionMul σ) = σ.comp (Algebra.TensorProduct.lmul' B) := by
  ext a <;> simp

/-- The kernel of a `B`-algebra map `σ : C →ₐ[B] B` is generated by the image of a generator of
the kernel of the multiplication map of `C ⊗[B] C`. -/
lemma ker_eq_span_sectionMul (σ : C →ₐ[B] B) (e : C ⊗[B] C)
    (he : KaehlerDifferential.ideal B C = Ideal.span {e}) :
    RingHom.ker σ = Ideal.span {sectionMul σ e} := by
  apply le_antisymm
  · intro x hx
    have hmem : (1 : C) ⊗ₜ[B] x - x ⊗ₜ[B] 1 ∈ KaehlerDifferential.ideal B C :=
      KaehlerDifferential.one_smul_sub_smul_one_mem_ideal B x
    rw [he] at hmem
    have hx' : x = sectionMul σ ((1 : C) ⊗ₜ[B] x - x ⊗ₜ[B] 1) := by
      simp [RingHom.mem_ker.mp hx]
    rw [hx']
    have := Ideal.mem_map_of_mem (sectionMul σ).toRingHom hmem
    rwa [Ideal.map_span, Set.image_singleton] at this
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
    have h₁ : σ (sectionMul σ e) = σ (Algebra.TensorProduct.lmul' B e) :=
      congr($(comp_sectionMul σ) e)
    have h₂ : Algebra.TensorProduct.lmul' B e = 0 := by
      have : e ∈ KaehlerDifferential.ideal B C := he ▸ Ideal.mem_span_singleton_self e
      exact RingHom.mem_ker.mp this
    rw [h₁, h₂, map_zero]

/-- If `C` is an étale `B`-algebra with a section `σ : C →ₐ[B] B`, then `C ≅ B × R` for an étale
`B`-algebra `R`, the first projection being `σ`. -/
theorem exists_algEquiv_prod_of_algHom [Algebra.Etale B C] (σ : C →ₐ[B] B) :
    ∃ (R : Type u) (_ : CommRing R) (_ : Algebra B R) (_ : Algebra.Etale B R)
      (e : C ≃ₐ[B] B × R), ∀ c, (e c).1 = σ c := by
  obtain ⟨e, he, hsp⟩ : ∃ e, IsIdempotentElem e ∧
      KaehlerDifferential.ideal B C = Ideal.span {e} :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg B C)).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[C⁄B]
  set ε := sectionMul σ e with hε_def
  have hε : IsIdempotentElem ε := he.map (sectionMul σ)
  have hker : RingHom.ker σ = Ideal.span {ε} := ker_eq_span_sectionMul σ e hsp
  have hσ : Function.Surjective σ := fun b ↦ ⟨algebraMap B C b, by simp⟩
  -- The decomposition `C ≅ C ⧸ (ε) × C ⧸ (1 - ε)`.
  let e₁ : C ≃ₐ[B] (C ⧸ Ideal.span {ε}) × (C ⧸ Ideal.span {1 - ε}) :=
    AlgEquiv.prodQuotientOfIsIdempotentElem (R := B) hε hε.one_sub (by ring)
      (by rw [mul_sub, mul_one, hε.eq, sub_self])
  -- The first factor is `B`.
  let e₂ : (C ⧸ Ideal.span {ε}) ≃ₐ[B] B :=
    ((Ideal.span {ε}).quotientEquivAlgOfEq B hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hσ)
  -- The second factor is the localization of `C` away from `ε`, hence étale over `B`.
  have hloc : IsLocalization.Away ε (C ⧸ Ideal.span {1 - ε}) :=
    IsLocalization.away_of_isIdempotentElem hε (by simp) Ideal.Quotient.mk_surjective
  have : Algebra.Etale C (C ⧸ Ideal.span {1 - ε}) := Algebra.Etale.of_isLocalizationAway ε
  have : Algebra.Etale B (C ⧸ Ideal.span {1 - ε}) := Algebra.Etale.comp B C _
  refine ⟨C ⧸ Ideal.span {1 - ε}, inferInstance, inferInstance, inferInstance,
    e₁.trans (AlgEquiv.prodCongr e₂ AlgEquiv.refl), fun c ↦ ?_⟩
  simp only [e₁, e₂, Ideal.quotientKerAlgEquivOfSurjective]
  exact RingHom.kerLift_mk (σ : C →+* B) c

end Algebra.Etale
