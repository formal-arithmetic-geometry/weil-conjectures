module

public import Mathlib.RingTheory.Etale.Weakly
public import Mathlib.RingTheory.Flat.Localization
public import Mathlib.RingTheory.Kaehler.Basic

/-!

# Algebras generated by idempotents are weakly étale

A commutative `R`-algebra `S` is weakly étale when `S` is flat over `R` and the multiplication
map `S ⊗[R] S → S` is flat (`Algebra.WeaklyEtale`). This file proves that a flat `R`-algebra
`S` which is generated as a ring by its idempotents is weakly étale. The example of interest is
the ring `LocallyConstant X ℤ` of locally constant integer-valued functions on a profinite set
`X`, which is free over `ℤ` (Nöbeling) and generated by the characteristic functions of clopen
subsets; its spectrum `X × Spec ℤ` is then a weakly étale `ℤ`-scheme, see
`WeilConjectures.CategoryTheory.RingObjects.ProfiniteToScheme`.

The proof goes through two general facts.

* The quotient of a commutative ring `B` by an ideal `I = (e_i)` generated by idempotents is
  the localization of `B` at the multiplicative set generated by the complementary idempotents
  `1 - e_i` (`Ideal.isLocalization_quotient_span_of_isIdempotentElem`), hence is flat over `B`
  (`Ideal.flat_quotient_span_of_isIdempotentElem`).
* The kernel of the multiplication map `S ⊗[R] S → S` is generated by the elements
  `1 ⊗ s - s ⊗ 1` for `s` in any set generating `S` as a ring
  (`Algebra.TensorProduct.ker_lmul'_eq_span`). When `s = e` is an idempotent,
  `d(e) = 1 ⊗ e - e ⊗ 1` satisfies `d(e)³ = d(e)`, so that `d(e)` and the idempotent `d(e)²`
  generate the same ideal (`Algebra.TensorProduct.span_image_eq_span_image_sq`).

## Main results

* `Ideal.flat_quotient_span_of_isIdempotentElem`: `B ⧸ (e_i)` is flat over `B` for idempotents
  `e_i`.
* `Algebra.TensorProduct.flat_lmul'_of_isIdempotentElem`: the multiplication map
  `S ⊗[R] S → S` is flat when `S` is generated as a ring by idempotents.
* `Algebra.WeaklyEtale.of_subring_closure_isIdempotentElem`: a flat `R`-algebra generated as a
  ring by idempotents is weakly étale.

-/

@[expose] public section

open TensorProduct

namespace Ideal

variable {B : Type*} [CommRing B] {E : Set B}

/-- The product of the complementary idempotents `1 - e` over a finite set `F` of idempotents
kills the ideal generated by `F`. -/
lemma prod_one_sub_mul_eq_zero_of_mem_span (hE : ∀ e ∈ E, IsIdempotentElem e) {F : Finset B}
    (hF : ↑F ⊆ E) {x : B} (hx : x ∈ span (F : Set B)) : (∏ e ∈ F, (1 - e)) * x = 0 := by
  classical
  induction hx using Submodule.span_induction with
  | mem e he =>
    rw [← Finset.mul_prod_erase F _ he, mul_right_comm, sub_mul, one_mul, (hE e (hF he)).eq,
      sub_self, zero_mul]
  | zero => rw [mul_zero]
  | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
  | smul a x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]

/-- The product of the complementary idempotents `1 - e` over a finite subset of `E` lies in the
multiplicative set generated by the `1 - e`, `e ∈ E`. -/
lemma prod_one_sub_mem_closure {F : Finset B} (hF : ↑F ⊆ E) :
    ∏ e ∈ F, (1 - e) ∈ Submonoid.closure ((fun e ↦ 1 - e) '' E) :=
  Submonoid.prod_mem _ fun e he ↦ Submonoid.subset_closure ⟨e, hF he, rfl⟩

/-- The quotient of a commutative ring `B` by the ideal generated by a set `E` of idempotents is
the localization of `B` at the multiplicative set generated by the complementary idempotents
`1 - e`, `e ∈ E`: inverting the idempotent `1 - e` kills `e`. -/
theorem isLocalization_quotient_span_of_isIdempotentElem (hE : ∀ e ∈ E, IsIdempotentElem e) :
    IsLocalization (Submonoid.closure ((fun e ↦ 1 - e) '' E)) (B ⧸ span E) := by
  rw [isLocalization_iff]
  refine ⟨fun y ↦ ?_, fun z ↦ ?_, fun {x y} h ↦ ?_⟩
  · obtain ⟨y, hy⟩ := y
    suffices algebraMap B (B ⧸ span E) y = 1 by rw [this]; exact isUnit_one
    induction hy using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨e, he, rfl⟩ := hx
      rw [map_sub, map_one, Quotient.algebraMap_eq,
        Quotient.eq_zero_iff_mem.mpr (subset_span he), sub_zero]
    | one => rw [map_one]
    | mul x y _ _ hx hy => rw [map_mul, hx, hy, one_mul]
  · obtain ⟨z, rfl⟩ := Quotient.mk_surjective z
    exact ⟨⟨z, 1⟩, by simp⟩
  · rw [Quotient.algebraMap_eq, Quotient.eq] at h
    obtain ⟨F, hF, hxy⟩ := Submodule.mem_span_finite_of_mem_span h
    refine ⟨⟨∏ e ∈ F, (1 - e), prod_one_sub_mem_closure hF⟩, ?_⟩
    simpa [mul_sub, sub_eq_zero] using prod_one_sub_mul_eq_zero_of_mem_span hE hF hxy

/-- The quotient of a commutative ring by an ideal generated by idempotents is flat, being a
localization. -/
theorem flat_quotient_span_of_isIdempotentElem (hE : ∀ e ∈ E, IsIdempotentElem e) :
    Module.Flat B (B ⧸ span E) :=
  haveI := isLocalization_quotient_span_of_isIdempotentElem hE
  IsLocalization.flat _ (Submonoid.closure ((fun e ↦ 1 - e) '' E))

/-- The quotient map by an ideal generated by idempotents is a flat ring homomorphism. -/
theorem flat_quotient_mk_span_of_isIdempotentElem (hE : ∀ e ∈ E, IsIdempotentElem e) :
    (Quotient.mk (span E)).Flat := by
  rw [← Quotient.algebraMap_eq, RingHom.flat_algebraMap_iff]
  exact flat_quotient_span_of_isIdempotentElem hE

end Ideal

namespace Algebra.TensorProduct

variable (R : Type*) {S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The "differential" `s ↦ 1 ⊗ s - s ⊗ 1` is additive, kills `1` and satisfies the Leibniz rule
`d(ab) = (1 ⊗ a) d(b) + (b ⊗ 1) d(a)`, so the set of `s` with `d(s)` in a given ideal of
`S ⊗[R] S` is a subring as soon as the ideal contains the `d(e)` for `e` in a generating set.
Hence the kernel of the multiplication map is generated by the `d(e)`, `e ∈ E`, for any set `E`
generating `S` as a ring. -/
theorem ker_lmul'_eq_span {E : Set S} (hE : Subring.closure E = ⊤) :
    RingHom.ker (lmul' R : S ⊗[R] S →ₐ[R] S) =
      Ideal.span ((fun e ↦ (1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) '' E) := by
  refine le_antisymm ?_ ?_
  · rw [← KaehlerDifferential.ideal, ← KaehlerDifferential.span_range_eq_ideal, Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    suffices h : ∀ a ∈ Subring.closure E, (1 : S) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : S) ∈
        Ideal.span ((fun e ↦ (1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) '' E) from
      h a (hE ▸ Subring.mem_top a)
    intro a ha
    induction ha using Subring.closure_induction with
    | mem e he => exact Ideal.subset_span ⟨e, he, rfl⟩
    | zero => simp only [tmul_zero, zero_tmul, sub_self]; exact zero_mem _
    | one => simp only [sub_self]; exact zero_mem _
    | add a b _ _ ha hb =>
      have : (1 : S) ⊗ₜ[R] (a + b) - (a + b) ⊗ₜ[R] (1 : S) =
          ((1 : S) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : S)) + ((1 : S) ⊗ₜ[R] b - b ⊗ₜ[R] (1 : S)) := by
        rw [tmul_add, add_tmul]; ring
      rw [this]; exact add_mem ha hb
    | neg a _ ha =>
      have : (1 : S) ⊗ₜ[R] (-a) - (-a) ⊗ₜ[R] (1 : S) =
          -((1 : S) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : S)) := by
        rw [tmul_neg, neg_tmul]; ring
      rw [this]; exact neg_mem ha
    | mul a b _ _ ha hb =>
      have : (1 : S) ⊗ₜ[R] (a * b) - (a * b) ⊗ₜ[R] (1 : S) =
          ((1 : S) ⊗ₜ[R] a) * ((1 : S) ⊗ₜ[R] b - b ⊗ₜ[R] (1 : S)) +
            (b ⊗ₜ[R] (1 : S)) * ((1 : S) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : S)) := by
        simp only [mul_sub, tmul_mul_tmul, one_mul, mul_one, mul_comm b a]; ring
      rw [this]; exact add_mem (Ideal.mul_mem_left _ _ hb) (Ideal.mul_mem_left _ _ ha)
  · rw [Ideal.span_le]
    rintro _ ⟨a, -, rfl⟩
    exact KaehlerDifferential.one_smul_sub_smul_one_mem_ideal R a

variable {R}

/-- For an idempotent `e`, the element `d(e) = 1 ⊗ e - e ⊗ 1` satisfies `d(e)³ = d(e)`. -/
lemma one_tmul_sub_tmul_one_pow_three {e : S} (he : IsIdempotentElem e) :
    ((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) ^ 3 = (1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S) := by
  have hx : ((1 : S) ⊗ₜ[R] e) * ((1 : S) ⊗ₜ[R] e) = (1 : S) ⊗ₜ[R] e := by
    rw [tmul_mul_tmul, one_mul, he.eq]
  have hy : (e ⊗ₜ[R] (1 : S)) * (e ⊗ₜ[R] (1 : S)) = e ⊗ₜ[R] (1 : S) := by
    rw [tmul_mul_tmul, one_mul, he.eq]
  linear_combination ((1 : S) ⊗ₜ[R] e + 1 - 3 * (e ⊗ₜ[R] (1 : S))) * hx +
    (3 * ((1 : S) ⊗ₜ[R] e) - e ⊗ₜ[R] (1 : S) - 1) * hy

/-- For an idempotent `e`, the square of `d(e) = 1 ⊗ e - e ⊗ 1` is an idempotent. -/
lemma isIdempotentElem_one_tmul_sub_tmul_one_sq {e : S} (he : IsIdempotentElem e) :
    IsIdempotentElem (((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) ^ 2) := by
  change _ ^ 2 * _ ^ 2 = _ ^ 2
  rw [← pow_add, show 2 + 2 = 3 + 1 by rfl, pow_succ, one_tmul_sub_tmul_one_pow_three he,
    ← pow_two]

/-- For a set `E` of idempotents, the elements `d(e)` and the idempotents `d(e)²`, `e ∈ E`,
generate the same ideal of `S ⊗[R] S`. -/
lemma span_image_eq_span_image_sq {E : Set S} (hE : ∀ e ∈ E, IsIdempotentElem e) :
    Ideal.span ((fun e ↦ (1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) '' E) =
      Ideal.span ((fun e ↦ ((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) ^ 2) '' E) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨e, he, rfl⟩
    dsimp only
    have : (1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S) =
        ((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) ^ 2 * ((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) := by
      rw [← pow_succ, one_tmul_sub_tmul_one_pow_three (hE e he)]
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨e, he, rfl⟩)
  · rintro _ ⟨e, he, rfl⟩
    dsimp only
    rw [pow_two]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨e, he, rfl⟩)

variable (R)

/-- The multiplication map `S ⊗[R] S → S` is surjective. -/
lemma lmul'_surjective : Function.Surjective (lmul' R : S ⊗[R] S →ₐ[R] S) :=
  fun s ↦ ⟨s ⊗ₜ[R] 1, by rw [lmul'_apply_tmul, mul_one]⟩

/-- If `S` is generated as a ring by idempotents, the multiplication map `S ⊗[R] S → S` is flat:
it identifies `S` with the quotient of `S ⊗[R] S` by its kernel, which is generated by the
idempotents `(1 ⊗ e - e ⊗ 1)²`. -/
theorem flat_lmul'_of_isIdempotentElem
    (hS : Subring.closure {e : S | IsIdempotentElem e} = ⊤) :
    (lmul' R (S := S)).Flat := by
  have hsurj := lmul'_surjective R (S := S)
  have hker : RingHom.ker (lmul' R : S ⊗[R] S →ₐ[R] S) =
      Ideal.span ((fun e ↦ ((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) ^ 2) ''
        {e : S | IsIdempotentElem e}) :=
    (ker_lmul'_eq_span R hS).trans (span_image_eq_span_image_sq fun _ he ↦ he)
  have : ((lmul' R : S ⊗[R] S →ₐ[R] S) : S ⊗[R] S →+* S) =
      (RingHom.quotientKerEquivOfSurjective hsurj).toRingHom.comp
        (Ideal.Quotient.mk (RingHom.ker (lmul' R : S ⊗[R] S →ₐ[R] S))) :=
    RingHom.ext fun x ↦ (RingHom.quotientKerEquivOfSurjective_apply_mk hsurj x).symm
  rw [AlgHom.toRingHom_eq_coe, this]
  refine RingHom.Flat.comp ?_ (RingHom.Flat.of_bijective (RingEquiv.bijective _))
  have key : ∀ I : Ideal (S ⊗[R] S),
      I = Ideal.span ((fun e ↦ ((1 : S) ⊗ₜ[R] e - e ⊗ₜ[R] (1 : S)) ^ 2) ''
        {e : S | IsIdempotentElem e}) → (Ideal.Quotient.mk I).Flat := by
    rintro _ rfl
    exact Ideal.flat_quotient_mk_span_of_isIdempotentElem
      (by rintro _ ⟨e, he, rfl⟩; exact isIdempotentElem_one_tmul_sub_tmul_one_sq he)
  exact key _ hker

end Algebra.TensorProduct

namespace Algebra.WeaklyEtale

variable (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]

/-- A flat `R`-algebra `S` which is generated as a ring by idempotents is weakly étale. -/
theorem of_subring_closure_isIdempotentElem [Module.Flat R S]
    (hS : Subring.closure {e : S | IsIdempotentElem e} = ⊤) : Algebra.WeaklyEtale R S where
  flat_lmul' := Algebra.TensorProduct.flat_lmul'_of_isIdempotentElem R hS

end Algebra.WeaklyEtale
