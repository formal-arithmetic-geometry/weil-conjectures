/-!
# Étale coordinates extending a regular sequence

-/

@[expose] public section

open TensorProduct IsLocalRing KaehlerDifferential

namespace IsLocalRing

variable {P : Type*} [CommRing P] [IsLocalRing P] [IsNoetherianRing P]

/-- In a noetherian local ring, the members `f₁, …, f_c` of a regular sequence generating an
ideal `J` are linearly independent in `J/𝔪J`: otherwise `J` would be generated by `c - 1` of
them by Nakayama's lemma, and Krull's height theorem would bound the drop of dimension
`dim P - dim P/J = c` by `c - 1`. Stated in `κ ⊗ J/J²`, which is `J/𝔪J`. -/
theorem linearIndependent_tmul_toCotangent_of_isRegular {c : ℕ} (f : Fin c → P) (J : Ideal P)
    (hJ : J = Ideal.span (Set.range f)) (hreg : RingTheory.Sequence.IsRegular P (List.ofFn f)) :
    LinearIndependent (ResidueField P) (fun a ↦ (1 : ResidueField P) ⊗ₜ[P]
      J.toCotangent ⟨f a, hJ ▸ Ideal.subset_span ⟨a, rfl⟩⟩) := by
  classical
  have hf : ∀ a, f a ∈ J := fun a ↦ hJ ▸ Ideal.subset_span ⟨a, rfl⟩
  set w : Fin c → J := fun a ↦ ⟨f a, hf a⟩ with hw
  set v : Fin c → ResidueField P ⊗[P] J.Cotangent :=
    fun a ↦ (1 : ResidueField P) ⊗ₜ[P] J.toCotangent (w a) with hv
  have hofList : Ideal.ofList (List.ofFn f) = J := by
    rw [hJ, Ideal.ofList]
    congr 1
    ext x
    simp [List.mem_ofFn]
  have hJtop : J ≠ ⊤ := by
    intro h
    apply hreg.top_ne_smul
    rw [hofList, h, Submodule.top_smul]
  have hJm : J ≤ maximalIdeal P := le_maximalIdeal hJtop
  have hsurj : Function.Surjective (algebraMap P (ResidueField P)) :=
    IsLocalRing.residue_surjective
  -- the `wₐ` span `J`
  have hspanJ : Submodule.span P (Set.range w) = ⊤ := by
    subst hJ
    convert Submodule.span_span_coe_preimage (R := P) (s := Set.range f) using 2
    ext ⟨x, hx⟩
    simp [w]
  -- a family spanning `J/J²` spans `κ ⊗ J/J²`, and conversely by Nakayama
  have hmap : ∀ s : Set (Fin c), (Submodule.span P (J.toCotangent ∘ w '' s)).map
      (TensorProduct.mk P (ResidueField P) J.Cotangent 1) =
        (Submodule.span (ResidueField P) (v '' s)).restrictScalars P := by
    intro s
    rw [Submodule.restrictScalars_span P _ hsurj, Submodule.map_span, ← Set.image_comp]
    rfl
  have hspan : Submodule.span (ResidueField P) (Set.range v) = ⊤ := by
    have h1 : Submodule.span P (J.toCotangent ∘ w '' Set.univ) = ⊤ := by
      rw [Set.image_comp, Set.image_univ, ← Submodule.map_span, hspanJ, Submodule.map_top,
        LinearMap.range_eq_top]
      exact J.toCotangent_surjective
    have h2 := congrArg (Submodule.map (TensorProduct.mk P (ResidueField P) J.Cotangent 1)) h1
    rw [hmap, Set.image_univ] at h2
    rw [← Submodule.restrictScalars_eq_top_iff P, h2]
    exact (IsLocalRing.map_tensorProduct_mk_eq_top).mpr rfl
  rw [linearIndependent_iff_notMem_span]
  intro b hb
  set s : Set (Fin c) := Set.univ \ {b}
  have hs : Submodule.span (ResidueField P) (v '' s) = ⊤ := by
    rw [eq_top_iff, ← hspan, Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    by_cases hab : a = b
    · exact hab ▸ hb
    · exact Submodule.subset_span ⟨a, by simp [s, hab], rfl⟩
  have hN : Submodule.span P (J.toCotangent ∘ w '' s) = ⊤ := by
    rw [← IsLocalRing.map_tensorProduct_mk_eq_top, hmap, hs]
    rfl
  -- hence `J` is generated by the `fₐ`, `a ≠ b`
  have hJle : J ≤ Ideal.span (f '' s) := by
    have hfg : (J : Submodule P P).FG := IsNoetherian.noetherian J
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := J) hfg ?_ ?_
    · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
      exact hJm
    · intro x hx
      have hx' : J.toCotangent ⟨x, hx⟩ ∈ Submodule.span P (J.toCotangent ∘ w '' s) :=
        hN ▸ Submodule.mem_top
      rw [Set.image_comp, ← Submodule.map_span] at hx'
      obtain ⟨y, hy, hyx⟩ := hx'
      rw [Ideal.toCotangent_eq] at hyx
      have hy' : (y : P) ∈ Ideal.span (f '' s) := by
        have := Submodule.mem_map_of_mem (f := J.subtype) hy
        rw [Submodule.map_span, ← Set.image_comp] at this
        exact this
      have : x = y + (x - y) := by ring
      rw [this]
      refine Submodule.add_mem_sup hy' ?_
      rw [Ideal.smul_eq_mul, ← pow_two]
      have := (J ^ 2).neg_mem hyx
      simpa using this
  have hJeq : J = Ideal.span (f '' s) :=
    le_antisymm hJle (Ideal.span_le.mpr (by rintro _ ⟨a, -, rfl⟩; exact hf a))
  -- Krull's height theorem against the dimension drop along a regular sequence
  have hdim := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hreg
  rw [hofList, List.length_ofFn] at hdim
  have hkrull := ringKrullDim_le_ringKrullDim_quotient_add_card
    (Finset.univ.filter (· ≠ b) |>.image f) (by
      rintro _ hx
      obtain ⟨a, -, rfl⟩ := Finset.mem_image.mp hx
      rw [IsLocalRing.ringJacobson_eq_maximalIdeal]
      exact hJm (hf a))
  have hset : ((Finset.univ.filter (· ≠ b) |>.image f : Finset P) : Set P) = f '' s := by
    ext; simp [s]
  rw [hset, ← hJeq] at hkrull
  have hcard : (Finset.univ.filter (· ≠ b) |>.image f).card + 1 ≤ c := by
    calc _ ≤ (Finset.univ.filter (· ≠ b)).card + 1 := by gcongr; exact Finset.card_image_le
      _ = c := by
        rw [Finset.filter_ne', Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ,
          Fintype.card_fin]
        have := b.pos
        omega
  have : Nontrivial (P ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJtop
  have hle : ringKrullDim (P ⧸ J) ≤ ringKrullDim P :=
    le_of_le_of_eq (le_add_of_nonneg_right (by exact_mod_cast Nat.zero_le c)) hdim
  obtain ⟨n, hn⟩ : ∃ n : ℕ, ringKrullDim (P ⧸ J) = n := by
    have hlt : ringKrullDim (P ⧸ J) < ⊤ := lt_of_le_of_lt hle ringKrullDim_lt_top
    obtain ⟨q, hq⟩ := WithBot.ne_bot_iff_exists.mp
      (ne_bot_of_le_ne_bot WithBot.zero_ne_bot (ringKrullDim_nonneg_of_nontrivial (R := P ⧸ J)))
    rw [← hq] at hlt
    obtain ⟨n, rfl⟩ := ENat.ne_top_iff_exists.mp
      (WithBot.coe_lt_coe.mp (hlt : (q : WithBot ℕ∞) < ((⊤ : ℕ∞) : WithBot ℕ∞))).ne
    exact ⟨n, hq.symm⟩
  rw [← hdim, hn] at hkrull
  have : n + c ≤ n + (Finset.univ.filter (· ≠ b) |>.image f).card := by exact_mod_cast hkrull
  omega

end IsLocalRing
