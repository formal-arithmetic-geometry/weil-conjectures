module

public import Mathlib.FieldTheory.Fixed

/-!
# Counting algebra maps to a field

By Dedekind's independence of characters, the `R`-algebra maps from `A` to a field `K` are
`K`-linearly independent. If `A` is generated by `n` elements as an `R`-module, they are
therefore at most `n` in number.

## Main statements

- `AlgHom.not_injective_of_span_eq_top`.
-/

@[expose] public section

/-- If `A` is generated by `n` elements as an `R`-module, there are at most `n` distinct
`R`-algebra maps from `A` to a field. -/
lemma AlgHom.not_injective_of_span_eq_top {R A K : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [Field K] [Algebra R K] {n : ℕ} (s : Fin n → A)
    (hs : Submodule.span R (Set.range s) = ⊤) (ψ : Fin (n + 1) → (A →ₐ[R] K)) :
    ¬ Function.Injective ψ := by
  intro hinj
  let E : (A →ₗ[R] K) →ₗ[K] (Fin n → K) :=
    { toFun f := fun k ↦ f (s k)
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }
  have hE : LinearMap.ker E = ⊥ := by
    refine LinearMap.ker_eq_bot'.mpr fun f hf ↦ LinearMap.ext_on_range hs fun k ↦ ?_
    exact congr_fun hf k
  have := (((linearIndependent_toLinearMap R A K).comp ψ hinj).map' E hE).fintype_card_le_finrank
  simp at this
