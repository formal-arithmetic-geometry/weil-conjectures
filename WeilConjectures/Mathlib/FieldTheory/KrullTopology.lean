module

public import Mathlib.FieldTheory.KrullTopology
public import Mathlib.FieldTheory.Galois.Infinite
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# The Krull topology on the fixing subgroup of an intermediate field

Let `L / K` be an algebraic extension and `E` an intermediate field. The fixing subgroup
`Gal(L / E) ≤ Gal(L / K)`, with the subspace topology of the Krull topology, is isomorphic as a
topological group to `Gal(L / E)` with its own Krull topology.

## Main definitions and statements

- `IntermediateField.mem_fixingSubgroup_adjoin_iff`: an automorphism fixes `K(S)` if and only
  if it fixes `S`.
- `IntermediateField.fixingSubgroupContinuousMulEquiv`: the isomorphism of topological groups
  `E.fixingSubgroup ≃ₜ* Gal(L / E)`.
- `InfiniteGalois.fixingSubgroup_fixedField_of_isOpen`,
  `InfiniteGalois.finiteDimensional_fixedField_of_isOpen`: an open subgroup `U` of the Galois
  group of a Galois extension is the fixing subgroup of its fixed field, which is finite.
-/

@[expose] public section

namespace IntermediateField

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- An automorphism fixes the intermediate field `K(S)` if and only if it fixes `S`. -/
theorem mem_fixingSubgroup_adjoin_iff (S : Set L) (σ : Gal(L/K)) :
    σ ∈ (adjoin K S).fixingSubgroup ↔ ∀ x ∈ S, σ x = x := by
  refine ⟨fun h x hx ↦ (mem_fixingSubgroup_iff _ σ).1 h x (subset_adjoin K S hx), fun h ↦ ?_⟩
  rw [← Subgroup.zpowers_le, ← le_iff_le, adjoin_le_iff]
  rintro x hx ⟨τ, hτ⟩
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hτ
  exact (MulAction.stabilizer Gal(L/K) x).zpow_mem (MulAction.mem_stabilizer_iff.2 (h x hx)) m

/-- A finite-dimensional intermediate field is generated by a finite set. -/
theorem exists_finset_adjoin_eq_of_finiteDimensional (F : IntermediateField K L)
    [FiniteDimensional K F] : ∃ S : Finset L, adjoin K (S : Set L) = F :=
  essFiniteType_iff.1 inferInstance

variable [Algebra.IsAlgebraic K L] (E : IntermediateField K L)

/-- For an algebraic extension `L / K` and an intermediate field `E`, the fixing subgroup of `E`
in `Gal(L / K)`, with the subspace topology of the Krull topology, is isomorphic as a
topological group to `Gal(L / E)` with the Krull topology, via
`IntermediateField.fixingSubgroupEquiv`. -/
def fixingSubgroupContinuousMulEquiv : E.fixingSubgroup ≃ₜ* Gal(L/E) where
  toMulEquiv := fixingSubgroupEquiv E
  continuous_toFun := by
    refine continuous_of_continuousAt_one (fixingSubgroupEquiv E) (continuousAt_def.2 ?_)
    intro N hN
    rw [map_one, krullTopology_mem_nhds_one_iff] at hN
    obtain ⟨F, _, hFN⟩ := hN
    obtain ⟨S, hS⟩ := exists_finset_adjoin_eq_of_finiteDimensional F
    have : FiniteDimensional K (adjoin K (S : Set L)) :=
      finiteDimensional_adjoin fun x _ ↦ (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
    refine Filter.mem_of_superset (((adjoin K (S : Set L)).fixingSubgroup_isOpen.preimage
      continuous_subtype_val).mem_nhds (Set.mem_preimage.2 (one_mem _))) fun σ hσ ↦ hFN ?_
    rw [SetLike.mem_coe, ← hS, mem_fixingSubgroup_adjoin_iff]
    exact (mem_fixingSubgroup_adjoin_iff _ (σ : Gal(L/K))).1 hσ
  continuous_invFun := by
    refine continuous_induced_rng.2 (continuous_of_continuousAt_one
      (E.fixingSubgroup.subtype.comp (fixingSubgroupEquiv E).symm.toMonoidHom)
      (continuousAt_def.2 ?_))
    intro N hN
    rw [map_one, krullTopology_mem_nhds_one_iff] at hN
    obtain ⟨F, _, hFN⟩ := hN
    obtain ⟨S, hS⟩ := exists_finset_adjoin_eq_of_finiteDimensional F
    have hSF (x : L) (hx : x ∈ (S : Set L)) : x ∈ F := hS ▸ subset_adjoin K _ hx
    have : FiniteDimensional E (adjoin E (S : Set L)) :=
      finiteDimensional_adjoin fun x hx ↦
        (isIntegral_iff.1 (IsIntegral.of_finite K (⟨x, hSF x hx⟩ : F))).tower_top
    refine Filter.mem_of_superset ((adjoin E (S : Set L)).fixingSubgroup_isOpen.mem_nhds
      (one_mem _)) fun σ hσ ↦ hFN ?_
    rw [SetLike.mem_coe, ← hS, mem_fixingSubgroup_adjoin_iff]
    exact (mem_fixingSubgroup_adjoin_iff _ σ).1 hσ

@[simp]
lemma fixingSubgroupContinuousMulEquiv_apply (σ : E.fixingSubgroup) (x : L) :
    fixingSubgroupContinuousMulEquiv E σ x = (σ : Gal(L/K)) x :=
  rfl

@[simp]
lemma fixingSubgroupContinuousMulEquiv_symm_apply (σ : Gal(L/E)) (x : L) :
    ((fixingSubgroupContinuousMulEquiv E).symm σ : Gal(L/K)) x = σ x :=
  rfl

end IntermediateField

namespace InfiniteGalois

variable {k K : Type*} [Field k] [Field K] [Algebra k K] [IsGalois k K]

/-- An open subgroup of the Galois group of a Galois extension is the fixing subgroup of its
fixed field. -/
theorem fixingSubgroup_fixedField_of_isOpen (U : Subgroup Gal(K/k))
    (hU : IsOpen (U : Set Gal(K/k))) :
    (IntermediateField.fixedField U).fixingSubgroup = U :=
  fixingSubgroup_fixedField ⟨U, OpenSubgroup.isClosed ⟨U, hU⟩⟩

/-- The fixed field of an open subgroup of the Galois group of a Galois extension is finite. -/
theorem finiteDimensional_fixedField_of_isOpen (U : Subgroup Gal(K/k))
    (hU : IsOpen (U : Set Gal(K/k))) : FiniteDimensional k (IntermediateField.fixedField U) :=
  (isOpen_iff_finite _).1 (by
    rw [fixingSubgroup_fixedField_of_isOpen U hU]
    exact hU)

end InfiniteGalois
