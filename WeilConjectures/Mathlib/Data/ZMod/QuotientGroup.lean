module

public import Mathlib.Data.ZMod.QuotientGroup

/-!
# The `m`-torsion of `ZMod d`

The subgroup of `ZMod d` killed by `m` is generated by `d / gcd m d`, hence has `gcd m d`
elements.

## Main results

- `ZMod.card_nsmul_eq_zero`
-/

@[expose] public section

open AddSubgroup

namespace ZMod

/-- The number of elements of `ZMod d` killed by `m` is `gcd m d`. -/
theorem card_nsmul_eq_zero (m : ℕ) {d : ℕ} [NeZero d] :
    Nat.card {x : ZMod d // m • x = 0} = m.gcd d := by
  have hd : d ≠ 0 := NeZero.ne d
  set g := m.gcd d with hg
  have hgd : g ∣ d := Nat.gcd_dvd_right m d
  have hgm : g ∣ m := Nat.gcd_dvd_left m d
  have hg0 : 0 < g := Nat.pos_of_ne_zero fun h => hd (Nat.eq_zero_of_gcd_eq_zero_right h)
  have hsd : d / g ∣ d := Nat.div_dvd_of_dvd hgd
  have hdg : g * (d / g) = d := Nat.mul_div_cancel' hgd
  have hmg : g * (m / g) = m := Nat.mul_div_cancel' hgm
  have hkey : ∀ x : ZMod d, m • x = 0 ↔ x ∈ zmultiples ((d / g : ℕ) : ZMod d) := by
    intro x
    constructor
    · intro hx
      have hxv : ((x.val : ℕ) : ZMod d) = x := ZMod.natCast_rightInverse x
      have hdvd : d ∣ m * x.val := by
        rw [← ZMod.natCast_eq_zero_iff, Nat.cast_mul, hxv, ← nsmul_eq_mul, hx]
      have h1 : g * (d / g) ∣ g * (m / g * x.val) := by
        rw [hdg, ← mul_assoc, hmg]; exact hdvd
      have h2 : d / g ∣ m / g * x.val := (mul_dvd_mul_iff_left hg0.ne').mp h1
      have h3 : d / g ∣ x.val :=
        (Nat.coprime_div_gcd_div_gcd hg0).symm.dvd_of_dvd_mul_left h2
      obtain ⟨c, hc⟩ := h3
      have hxc : x = c • ((d / g : ℕ) : ZMod d) := by
        rw [← hxv, hc, nsmul_eq_mul, Nat.cast_mul, mul_comm]
      rw [hxc]
      exact nsmul_mem (mem_zmultiples _) c
    · intro hx
      obtain ⟨c, rfl⟩ := mem_zmultiples_iff.mp hx
      have hma : m • ((d / g : ℕ) : ZMod d) = 0 := by
        rw [nsmul_eq_mul, ← Nat.cast_mul, ZMod.natCast_eq_zero_iff]
        refine ⟨m / g, ?_⟩
        conv_lhs => rw [← hmg]
        conv_rhs => rw [← hdg]
        exact mul_right_comm _ _ _
      rw [smul_comm, hma, smul_zero]
  calc Nat.card {x : ZMod d // m • x = 0}
      = Nat.card (zmultiples ((d / g : ℕ) : ZMod d)) :=
        Nat.card_congr (Equiv.subtypeEquivRight hkey)
    _ = addOrderOf ((d / g : ℕ) : ZMod d) := Nat.card_zmultiples _
    _ = d / Nat.gcd d (d / g) := ZMod.addOrderOf_coe _ hd
    _ = d / (d / g) := by rw [Nat.gcd_eq_right hsd]
    _ = g := Nat.div_div_self hgd hd

end ZMod
