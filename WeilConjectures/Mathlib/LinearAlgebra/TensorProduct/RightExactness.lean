module

public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import WeilConjectures.Mathlib.LinearAlgebra.TensorProduct.Submodule

/-!
# Intersections of extended ideals in a tensor product over a field

For ideals `I ⊆ A` and `J ⊆ B` of algebras over a field `R`, an element of `A ⊗[R] B` lying in
both extended ideals `I (A ⊗ B)` and `J (A ⊗ B)` comes from `I ⊗[R] J`; we state this for any
`C ≅ A ⊗[R] B`.

## Main statements

- `Algebra.TensorProduct.exists_map_subtype_eq_of_mem_map_inf_map`
-/

@[expose] public section

open scoped TensorProduct

namespace Algebra.TensorProduct

open _root_.TensorProduct

variable {R A B C : Type*} [Field R] [CommRing A] [CommRing B] [CommRing C] [Algebra R A]
  [Algebra R B] [Algebra R C]

/-- Let `C ≅ A ⊗[R] B` over a field `R`, via `φ : A → C` and `ψ : B → C`, and let `I ⊆ A`,
`J ⊆ B` be ideals. An element of `C` lying in the ideals generated by `I` and by `J` is the image
of an element of `I ⊗[R] J`. -/
theorem exists_map_subtype_eq_of_mem_map_inf_map (φ : A →ₐ[R] C) (ψ : B →ₐ[R] C)
    (hμ : Function.Bijective (lift φ ψ fun _ _ ↦ Commute.all _ _)) (I : Ideal A) (J : Ideal B)
    {c : C} (hc : c ∈ I.map φ ⊓ J.map ψ) :
    ∃ w : (I.restrictScalars R) ⊗[R] (J.restrictScalars R),
      lift φ ψ (fun _ _ ↦ Commute.all _ _) (_root_.TensorProduct.map (I.restrictScalars R).subtype
        (J.restrictScalars R).subtype w) = c := by
  set μ := lift φ ψ fun _ _ ↦ Commute.all _ _
  let e : A ⊗[R] B ≃ₐ[R] C := AlgEquiv.ofBijective μ hμ
  have hφ : φ = μ.comp includeLeft := by ext; simp [μ]
  have hψ : ψ = μ.comp includeRight := by ext; simp [μ]
  have h1 (K' : Ideal (A ⊗[R] B)) {f : A ⊗[R] B →ₐ[R] C} (hf : f = μ)
      (h : c ∈ K'.map f) : e.symm c ∈ K' := by
    subst hf
    obtain ⟨x, hx, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ hμ.2).mp h
    convert hx
    exact e.symm_apply_apply x
  have hmem : e.symm c ∈ (I.map (includeLeft : A →ₐ[R] A ⊗[R] B)).restrictScalars R ⊓
      (J.map (includeRight : B →ₐ[R] A ⊗[R] B)).restrictScalars R := by
    refine ⟨h1 _ rfl ?_, h1 _ rfl ?_⟩
    · have : Ideal.map μ (Ideal.map (includeLeft : A →ₐ[R] A ⊗[R] B) I) = Ideal.map φ I := by
        rw [← Ideal.map_coe μ, ← Ideal.map_coe includeLeft, Ideal.map_map, ← Ideal.map_coe φ, hφ]
        rfl
      exact this ▸ hc.1
    · have : Ideal.map μ (Ideal.map (includeRight : B →ₐ[R] A ⊗[R] B) J) = Ideal.map ψ J := by
        rw [← Ideal.map_coe μ, ← Ideal.map_coe includeRight, Ideal.map_map, ← Ideal.map_coe ψ,
          hψ]
        rfl
      exact this ▸ hc.2
  rw [Ideal.map_includeLeft_eq, Ideal.map_includeRight_eq,
    LinearMap.range_rTensor_inf_range_lTensor] at hmem
  obtain ⟨w, hw⟩ := hmem
  exact ⟨w, by rw [hw]; exact e.apply_symm_apply c⟩

end Algebra.TensorProduct
