module

public import Mathlib.CategoryTheory.Sites.LocallyBijective
public import Mathlib.CategoryTheory.Sites.Subsheaf

/-!
# Isomorphisms of sheaves which are invertible on a generating family of every object

A morphism of sheaves of types (or of sheaves with values in a concrete category whose
forgetful functor preserves limits and reflects isomorphisms) is an isomorphism as soon as every
object `X` of the site admits a family of arrows `Y ⟶ X` generating a covering sieve such that
the morphism is invertible at each `Y`. The morphism is *not* assumed to be invertible at the
other members of the generated sieve, which is what distinguishes this criterion from
`CategoryTheory.Sheaf.isIso_of_isIso_app_of_mem` (in
`WeilConjectures.Mathlib.CategoryTheory.Sites.Sheaf`).

This is the form in which étale-local arguments are glued, e.g. in degree-zero flat base change
`AlgebraicGeometry.Etale.isIso_baseChangeMap_app_of_flat`: there, the members of the family
are charts on which both sheaves can be computed, and these charts are not stable under
refinement.

## Main results

- `CategoryTheory.Presieve.isIso_of_isIso_app_of_generate_mem`: the criterion for sheaves of
  types.
- `CategoryTheory.Sheaf.isIso_of_isIso_app_of_generate_mem`: the criterion for sheaves with
  values in a concrete category.
- `CategoryTheory.Presheaf.isLocallySurjective_toSheafify_of_types`: the sheafification map of a
  presheaf of types is locally surjective, in any universe where sheafification exists.
- `CategoryTheory.Sheaf.isIso_sheafificationAdjunction_homEquiv_symm`: a locally bijective
  morphism from a presheaf of types to a sheaf induces an isomorphism from the sheafification.
-/

@[expose] public section

universe w v₁ u₁ u₂

open CategoryTheory Limits Opposite

namespace CategoryTheory

variable {C : Type u₁} [Category.{v₁} C] (J : GrothendieckTopology C)

/-- A morphism of type-valued sheaves is an isomorphism as soon as every object `X` admits a
family of arrows `R`, generating a covering sieve, at whose sources the morphism is invertible.

In contrast to `CategoryTheory.Presheaf.isIso_of_isIso_app_of_mem`, the morphism need not be
invertible at the other members of the sieve generated by `R`: injectivity at every object
follows from separatedness, and then a section of the target over `X` is glued from its
preimages over the sources of `R`, which are compatible by injectivity. -/
lemma Presieve.isIso_of_isIso_app_of_generate_mem {P Q : Cᵒᵖ ⥤ Type w}
    (hP : Presieve.IsSheaf J P) (hQ : Presieve.IsSheaf J Q) (φ : P ⟶ Q)
    (h : ∀ X : C, ∃ R : Presieve X, Sieve.generate R ∈ J X ∧
      ∀ ⦃Y : C⦄ (f : Y ⟶ X), R f → IsIso (φ.app (op Y))) :
    IsIso φ := by
  have inj : ∀ X : C, Function.Injective (φ.app (op X)) := by
    intro X a b hab
    obtain ⟨R, hR, hiso⟩ := h X
    refine (hP _ hR).isSeparatedFor.ext ?_
    rintro Y f ⟨Z, k, l, hl, rfl⟩
    have := hiso l hl
    have hinj := ((isIso_iff_bijective (φ.app (op Z))).1 this).1
    simp only [op_comp, Functor.map_comp_apply]
    congr 1
    apply hinj
    rw [NatTrans.naturality_apply, NatTrans.naturality_apply, hab]
  have surj : ∀ X : C, Function.Surjective (φ.app (op X)) := by
    intro X t
    obtain ⟨R, hR, hiso⟩ := h X
    have hPR := (Presieve.isSheafFor_iff_generate R).2 (hP _ hR)
    have hQR := (Presieve.isSheafFor_iff_generate R).2 (hQ _ hR)
    let x : Presieve.FamilyOfElements P R := fun Y f hf ↦
      haveI := hiso f hf
      inv (φ.app (op Y)) (Q.map f.op t)
    have hx : ∀ ⦃Y : C⦄ (f : Y ⟶ X) (hf : R f), φ.app (op Y) (x f hf) = Q.map f.op t := by
      intro Y f hf
      have := hiso f hf
      simp [x]
    have hxc : x.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
      apply inj
      rw [NatTrans.naturality_apply, NatTrans.naturality_apply, hx f₁ h₁, hx f₂ h₂,
        ← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, hcomm]
    obtain ⟨s, hs, -⟩ := hPR x hxc
    refine ⟨s, hQR.isSeparatedFor.ext fun Y f hf ↦ ?_⟩
    rw [← NatTrans.naturality_apply, hs f hf, hx f hf]
  have : ∀ X : Cᵒᵖ, IsIso (φ.app X) := fun X ↦
    (isIso_iff_bijective _).2 ⟨inj X.unop, surj X.unop⟩
  exact NatIso.isIso_of_isIso_app φ

variable {A : Type u₂} [Category.{max v₁ u₁} A] [HasLimits A]

/-- A morphism of sheaves with values in a concrete category `(A, s)`, where `s` preserves limits
and reflects isomorphisms, is an isomorphism as soon as every object `X` admits a family of
arrows `R`, generating a covering sieve, at whose sources the morphism is invertible. This is
`CategoryTheory.Presieve.isIso_of_isIso_app_of_generate_mem` applied to the underlying sheaves
of types. -/
lemma Sheaf.isIso_of_isIso_app_of_generate_mem (s : A ⥤ Type (max v₁ u₁)) [PreservesLimits s]
    [s.ReflectsIsomorphisms] {F G : Sheaf J A} (φ : F ⟶ G)
    (h : ∀ X : C, ∃ R : Presieve X, Sieve.generate R ∈ J X ∧
      ∀ ⦃Y : C⦄ (f : Y ⟶ X), R f → IsIso (φ.hom.app (op Y))) :
    IsIso φ := by
  have hF := (isSheaf_iff_isSheaf_of_type J _).1
    ((Presheaf.isSheaf_iff_isSheaf_forget J F.obj s).1 F.property)
  have hG := (isSheaf_iff_isSheaf_of_type J _).1
    ((Presheaf.isSheaf_iff_isSheaf_forget J G.obj s).1 G.property)
  have := Presieve.isIso_of_isIso_app_of_generate_mem J hF hG (Functor.whiskerRight φ.hom s)
    fun X ↦ by
      obtain ⟨R, hR, hiso⟩ := h X
      refine ⟨R, hR, fun Y f hf ↦ ?_⟩
      have := hiso f hf
      exact inferInstanceAs (IsIso (s.map (φ.hom.app (op Y))))
  have : ∀ X : Cᵒᵖ, IsIso (φ.hom.app X) := fun X ↦ by
    have : IsIso (s.map (φ.hom.app X)) :=
      inferInstanceAs (IsIso ((Functor.whiskerRight φ.hom s).app X))
    exact isIso_of_reflects_iso _ s
  have : IsIso ((sheafToPresheaf J A).map φ) := NatIso.isIso_of_isIso_app φ.hom
  exact isIso_of_reflects_iso φ (sheafToPresheaf J A)

section SheafifyTypes

variable [HasWeakSheafify J (Type w)]

namespace Presheaf

/-- The sheafification map of a presheaf of types is locally surjective, for presheaves with
values in an arbitrary universe in which sheafification exists.
Source: Stacks Project, Tag 00WM (auxiliary; not a blueprint node). -/
lemma isLocallySurjective_toSheafify_of_types (P : Cᵒᵖ ⥤ Type w) :
    IsLocallySurjective J (toSheafify J P) := by
  rw [isLocallySurjective_iff_range_sheafify_eq_top']
  have hP : Presieve.IsSheaf J (sheafify J P) :=
    (isSheaf_iff_isSheaf_of_type _ _).1 ((presheafToSheaf J (Type w)).obj P).property
  let R := (Subfunctor.range (toSheafify J P)).sheafify J
  have hR : Presheaf.IsSheaf J R.toFunctor :=
    (isSheaf_iff_isSheaf_of_type _ _).2 (Subfunctor.sheafify_isSheaf _ hP)
  let s : sheafify J P ⟶ R.toFunctor :=
    sheafifyLift J (Subfunctor.toRangeSheafify J (toSheafify J P)) hR
  have hs : s ≫ R.ι = 𝟙 _ := by
    refine sheafify_hom_ext J _ _ ((presheafToSheaf J (Type w)).obj P).property ?_
    rw [← Category.assoc, toSheafify_sheafifyLift, Category.comp_id]
    rfl
  refine eq_top_iff.2 fun U x _ ↦ ?_
  have hx : (s ≫ R.ι).app U x = x := by rw [hs]; rfl
  rw [← hx]
  exact (s.app U x).2

end Presheaf

namespace Sheaf

/-- A locally bijective morphism `φ : P ⟶ H` from a presheaf of types to a sheaf of types induces
an isomorphism from the sheafification of `P` to `H`.
Source: Stacks Project, Tag 00WJ (auxiliary; not a blueprint node). -/
lemma isIso_sheafificationAdjunction_homEquiv_symm [HasSheafify J (Type w)]
    {P : Cᵒᵖ ⥤ Type w} {H : Sheaf J (Type w)} (φ : P ⟶ H.obj)
    [Presheaf.IsLocallyInjective J φ] [Presheaf.IsLocallySurjective J φ] :
    IsIso (((sheafificationAdjunction J (Type w)).homEquiv P H).symm φ) := by
  have fac : toSheafify J P ≫ (((sheafificationAdjunction J (Type w)).homEquiv P H).symm φ).hom =
      φ := by
    have h := ((sheafificationAdjunction J (Type w)).homEquiv P H).apply_symm_apply φ
    rwa [Adjunction.homEquiv_unit] at h
  have := Presheaf.isLocallySurjective_toSheafify_of_types J P
  have : J.HasSheafCompose (forget (Type w)) := ⟨fun _ hP ↦ hP⟩
  rw [← Sheaf.isLocallyBijective_iff_isIso (A := Type w)]
  exact ⟨Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac J φ fac,
    Presheaf.isLocallySurjective_of_isLocallySurjective_fac J fac⟩

end Sheaf

end SheafifyTypes

end CategoryTheory
