module

public import Mathlib.CategoryTheory.Sites.Sieves

/-!
# Sieves

Ported from the `proetale` package (`Proetale.Mathlib.CategoryTheory.Sites.Sieves`).
-/

@[expose] public section

namespace CategoryTheory

variable {C : Type*} [Category C]

@[simp]
lemma Presieve.map_comp {C D E : Type*} [Category* C] [Category* D]
    [Category* E] (F : C ⥤ D) (G : D ⥤ E) {X : C} (R : Presieve X) :
    R.map (F ⋙ G) = (R.map F).map G := by
  refine le_antisymm ?_ ?_
  · rw [Presieve.map_le_iff_le_functorPullback]
    intro Y f hf
    apply Presieve.map_map
    apply Presieve.map_map
    exact hf
  · rw [Presieve.map_le_iff_le_functorPullback, Presieve.map_le_iff_le_functorPullback]
    intro Y f hf
    apply Presieve.map_map
    exact hf

/-- The sieve generated by a single arrow `f` is contained in any sieve containing `f`. -/
lemma Sieve.generate_singleton_le {Z W : C} {f : Z ⟶ W} {S : Sieve W} (h : S f) :
    Sieve.generate (Presieve.singleton f) ≤ S := by
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨⟩
  exact h

end CategoryTheory
