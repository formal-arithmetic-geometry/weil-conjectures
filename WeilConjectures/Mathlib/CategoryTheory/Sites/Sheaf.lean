module

public import Mathlib.CategoryTheory.Sites.Sheaf

/-!
# A local criterion for a morphism of sheaves to be an isomorphism

A morphism of sheaves is an isomorphism as soon as, at every object `X` of the site, it is
invertible on the members of *some* covering sieve of `X`. Both sheaves are the limit of
their restriction to a covering sieve
(`CategoryTheory.Presheaf.isSheaf_iff_isLimit`), so a morphism which is invertible on the
whole diagram induces an isomorphism of the limits, which is the morphism at `X`.

This is the sheaf-theoretic ingredient of
`AlgebraicGeometry.Etale.isIso_of_isIso_openImmersionRestriction`, where the covering sieve
of an étale `X`-scheme `V` is generated by the base changes of `V` along a jointly surjective
family of open immersions. Note that no hypothesis on the coefficient category is needed: in
particular this does not go through stalks, and applies to sheaves valued in an arbitrary
category.

## Main results

- `CategoryTheory.Presheaf.isIso_app_of_isIso_app_of_mem`: the statement at a single object.
- `CategoryTheory.Presheaf.isIso_of_isIso_app_of_mem` and
  `CategoryTheory.Sheaf.isIso_of_isIso_app_of_mem`: the global statements, for a morphism of
  presheaves which are sheaves and for a morphism in the category of sheaves.
-/

@[expose] public section

universe v₁ v₂ u₁ u₂

open CategoryTheory Category Limits Opposite

namespace CategoryTheory

variable {C : Type u₁} [Category.{v₁} C] {A : Type u₂} [Category.{v₂} A]
  (J : GrothendieckTopology C) {G G' : Cᵒᵖ ⥤ A}

namespace Presheaf

set_option backward.isDefEq.respectTransparency false in
/-- A morphism of sheaves which is invertible at every object of some covering sieve of `X`
is invertible at `X`: both sides are the limit of their restrictions to the sieve, and the
induced morphism of the two limit diagrams is an isomorphism by assumption. -/
lemma isIso_app_of_isIso_app_of_mem (hG : IsSheaf J G) (hG' : IsSheaf J G') (φ : G ⟶ G')
    {X : C} (S : Sieve X) (hS : S ∈ J X)
    (h : ∀ ⦃Y : C⦄ (f : Y ⟶ X), S f → IsIso (φ.app (op Y))) :
    IsIso (φ.app (op X)) := by
  obtain ⟨hc⟩ := (isSheaf_iff_isLimit J G).1 hG S hS
  obtain ⟨hc'⟩ := (isSheaf_iff_isLimit J G').1 hG' S hS
  have hiso : ∀ T, IsIso ((Functor.whiskerLeft S.arrows.diagram.op φ).app T) := by
    rintro ⟨T⟩
    exact h T.obj.hom T.property
  have : IsIso (Functor.whiskerLeft S.arrows.diagram.op φ) := NatIso.isIso_of_isIso_app _
  have key : φ.app (op X) = (IsLimit.conePointsIsoOfNatIso hc hc'
      (asIso (Functor.whiskerLeft S.arrows.diagram.op φ))).hom := by
    refine hc'.hom_ext fun T => ?_
    rw [IsLimit.conePointsIsoOfNatIso_hom_comp]
    exact (φ.naturality (S.arrows.cocone.ι.app T.unop).op).symm
  rw [key]
  infer_instance

/-- A morphism of sheaves which, at every object, is invertible on the members of some
covering sieve is an isomorphism. -/
lemma isIso_of_isIso_app_of_mem (hG : IsSheaf J G) (hG' : IsSheaf J G') (φ : G ⟶ G')
    (h : ∀ X : C, ∃ S : Sieve X, S ∈ J X ∧
      ∀ ⦃Y : C⦄ (f : Y ⟶ X), S f → IsIso (φ.app (op Y))) :
    IsIso φ := by
  have : ∀ X : Cᵒᵖ, IsIso (φ.app X) := by
    rintro ⟨X⟩
    obtain ⟨S, hS, hSiso⟩ := h X
    exact isIso_app_of_isIso_app_of_mem J hG hG' φ S hS hSiso
  exact NatIso.isIso_of_isIso_app _

end Presheaf

namespace Sheaf

/-- A morphism of sheaves which, at every object, is invertible on the members of some
covering sieve is an isomorphism. -/
lemma isIso_of_isIso_app_of_mem {G G' : Sheaf J A} (φ : G ⟶ G')
    (h : ∀ X : C, ∃ S : Sieve X, S ∈ J X ∧
      ∀ ⦃Y : C⦄ (f : Y ⟶ X), S f → IsIso (φ.hom.app (op Y))) :
    IsIso φ := by
  have hval : IsIso φ.hom :=
    Presheaf.isIso_of_isIso_app_of_mem J G.property G'.property φ.hom h
  have : IsIso ((sheafToPresheaf J A).map φ) := hval
  exact isIso_of_reflects_iso φ (sheafToPresheaf J A)

end Sheaf

end CategoryTheory

/-! ### Sheaves whose sections vanish -/

namespace CategoryTheory.Sheaf

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}
  {A : Type u₂} [Category.{v₂} A]

/-- A sheaf whose sections are all terminal is terminal. -/
noncomputable def isTerminalOfIsTerminalObj (F : Sheaf J A) (h : ∀ U, IsTerminal (F.obj.obj U)) :
    IsTerminal F :=
  IsTerminal.isTerminalOfObj (sheafToPresheaf J A) _ (Functor.isTerminal h)

/-- A sheaf whose sections are all zero objects is a zero object. Morphisms of sheaves are
morphisms of the underlying presheaves, so this is `CategoryTheory.Functor.isZero` transported
along `CategoryTheory.Sheaf.homEquiv`. -/
lemma isZero_of_isZero_obj (F : Sheaf J A) (h : ∀ U, IsZero (F.obj.obj U)) : IsZero F := by
  have h1 : IsZero F.obj := Functor.isZero _ h
  refine ⟨fun G => ?_, fun G => ?_⟩
  · obtain ⟨u⟩ := h1.unique_to G.obj
    exact ⟨Equiv.unique Sheaf.homEquiv⟩
  · obtain ⟨u⟩ := h1.unique_from G.obj
    exact ⟨Equiv.unique Sheaf.homEquiv⟩

/-- A sheaf whose sections are all zero objects is initial. -/
noncomputable def isInitialOfIsZeroObj (F : Sheaf J A) (h : ∀ U, IsZero (F.obj.obj U)) :
    IsInitial F :=
  (isZero_of_isZero_obj F h).isInitial

end CategoryTheory.Sheaf
