module

public import Mathlib.CategoryTheory.Presentable.Finite

/-!

# Objects generated by finitely many finitely presentable objects

An object `P` of a category is *generated by finitely presentable objects*
(`CategoryTheory.IsGeneratedByFinitelyPresentable`) if there is a finite jointly epimorphic family
of morphisms `G i ⟶ P` out of finitely presentable objects `G i`. In a filtered colimit whose
point is such an object, some coprojection is an epimorphism
(`CategoryTheory.IsGeneratedByFinitelyPresentable.exists_epi_ι`): each `G i ⟶ P` factors
through some stage, and the stages have a common upper bound.

This replaces the noetherianity of the point (`CategoryTheory.exists_epi_ι_of_isNoetherianObject`)
for sheaves such as the constructible sheaves on the pro-étale site, which are quotients of finite
sums of extensions by zero of constant sheaves on quasi-compact étale objects, but are not
noetherian objects in general.

-/

@[expose] public section

universe w v u

namespace CategoryTheory

open Limits

variable {C : Type u} [Category.{v} C]

/-- An object `P` is *generated by finitely presentable objects* if there is a finite family of
finitely presentable objects `G i` (for filtered colimits indexed by categories in `Type w`) with
morphisms `g i : G i ⟶ P` which are jointly epimorphic. -/
def IsGeneratedByFinitelyPresentable (P : C) : Prop :=
  ∃ (n : ℕ) (G : Fin n → C) (g : ∀ i, G i ⟶ P), (∀ i, IsFinitelyPresentable.{w} (G i)) ∧
    ∀ ⦃Z : C⦄ (f f' : P ⟶ Z), (∀ i, g i ≫ f = g i ≫ f') → f = f'

namespace IsGeneratedByFinitelyPresentable

/-- Being generated by finitely presentable objects passes to quotients. -/
lemma of_epi {P Q : C} (p : P ⟶ Q) [Epi p] (hP : IsGeneratedByFinitelyPresentable.{w} P) :
    IsGeneratedByFinitelyPresentable.{w} Q := by
  obtain ⟨n, G, g, hG, hg⟩ := hP
  refine ⟨n, G, fun i ↦ g i ≫ p, hG, fun Z f f' h ↦ ?_⟩
  rw [← cancel_epi p]
  exact hg _ _ fun i ↦ by simpa using h i

/-- Being generated by finitely presentable objects is invariant under isomorphism. -/
lemma of_iso {P Q : C} (e : P ≅ Q) (hP : IsGeneratedByFinitelyPresentable.{w} P) :
    IsGeneratedByFinitelyPresentable.{w} Q :=
  of_epi e.hom hP

/-- A finitely presentable object is generated by finitely presentable objects. -/
lemma of_isFinitelyPresentable (P : C) [IsFinitelyPresentable.{w} P] :
    IsGeneratedByFinitelyPresentable.{w} P :=
  ⟨1, fun _ ↦ P, fun _ ↦ 𝟙 P, fun _ ↦ inferInstance, fun _ f f' h ↦ by simpa using h 0⟩

/-- **A filtered colimit whose point is generated by finitely presentable objects is attained**:
some coprojection of a colimit cocone over a filtered category is an epimorphism. -/
theorem exists_epi_ι {J : Type w} [SmallCategory J] [IsFiltered J] {F : J ⥤ C} {c : Cocone F}
    (hc : IsColimit c) (hP : IsGeneratedByFinitelyPresentable.{w} c.pt) :
    ∃ j, Epi (c.ι.app j) := by
  classical
  obtain ⟨n, G, g, hG, hg⟩ := hP
  choose j p hp using fun i ↦ (hG i).exists_hom_of_isColimit hc (g i)
  obtain ⟨k, hk⟩ := IsFiltered.sup_objs_exists (Finset.univ.image j)
  refine ⟨k, ⟨fun {Z} f f' h ↦ hg f f' fun i ↦ ?_⟩⟩
  have hi := (hk (Finset.mem_image_of_mem j (Finset.mem_univ i))).some
  rw [← hp i, ← c.w hi]
  simp only [Category.assoc, h]

end IsGeneratedByFinitelyPresentable

end CategoryTheory
