module

public import Mathlib.CategoryTheory.MorphismProperty.Retract
public import Mathlib.CategoryTheory.Triangulated.Generators
public import WeilConjectures.Mathlib.CategoryTheory.Triangulated.Functor

/-!
# Invertibility of natural transformations on a generating class

Let `τ : F₁ ⟶ F₂` be a natural transformation between triangulated functors `C ⥤ D` which is
compatible with the shifts. We introduce the object property `τ.isoLocus` of the objects `X`
such that `τ.app X` is an isomorphism, and show that it is a triangulated subcategory of `C`
which is closed under isomorphisms and retracts. As a consequence, if `τ` is an isomorphism on
the objects of `P : ObjectProperty C`, it is an isomorphism on the triangulated envelope
`P.triangEnvelope` (`CategoryTheory.NatTrans.isIso_app_of_triangEnvelope`), and `τ` is an
isomorphism when `P` is a classical generator
(`CategoryTheory.NatTrans.isIso_of_isClassicalTriangulatedGenerator`).

This only propagates *invertibility*: a natural transformation is not determined by its
values on a generating class.

This is blueprint `sk-lem-sf-determination`.
-/

@[expose] public section

namespace CategoryTheory.NatTrans

open Category Limits Pretriangulated ObjectProperty ZeroObject

variable {C D : Type*} [Category* C] [Category* D] {F₁ F₂ : C ⥤ D}

/-- The object property of the objects `X` such that `τ.app X` is an isomorphism. -/
def isoLocus (τ : F₁ ⟶ F₂) : ObjectProperty C := fun X ↦ IsIso (τ.app X)

@[simp]
lemma isoLocus_iff (τ : F₁ ⟶ F₂) (X : C) : τ.isoLocus X ↔ IsIso (τ.app X) := Iff.rfl

instance (τ : F₁ ⟶ F₂) : τ.isoLocus.IsStableUnderRetracts where
  of_retract h hY :=
    MorphismProperty.of_retract (P := MorphismProperty.isomorphisms D)
      (τ.retractArrowApp h) hY

instance (τ : F₁ ⟶ F₂) : τ.isoLocus.IsClosedUnderIsomorphisms := inferInstance

/-- Part of blueprint `sk-lem-sf-determination`: a natural transformation which is an
isomorphism on `Y` is an isomorphism on every retract of `Y`, for instance on every direct
summand of `Y`. -/
lemma isIso_app_of_retract (τ : F₁ ⟶ F₂) {X Y : C} (h : Retract X Y) [IsIso (τ.app Y)] :
    IsIso (τ.app X) :=
  τ.isoLocus.prop_of_retract h (inferInstanceAs (IsIso (τ.app Y)))

section Shift

variable [HasShift C ℤ] [HasShift D ℤ] [F₁.CommShift ℤ] [F₂.CommShift ℤ]
  (τ : F₁ ⟶ F₂) [NatTrans.CommShift τ ℤ]

/-- Part of blueprint `sk-lem-sf-determination`: a natural transformation compatible with the
shifts is an isomorphism on `X⟦n⟧` if and only if it is an isomorphism on `X`. -/
lemma isIso_app_shift_iff (X : C) (n : ℤ) : IsIso (τ.app (X⟦n⟧)) ↔ IsIso (τ.app X) := by
  rw [NatTrans.app_shift τ n X]
  constructor
  · intro h
    have : IsIso ((τ.app X)⟦n⟧') := by
      have := IsIso.of_isIso_comp_left ((F₁.commShiftIso n).hom.app X)
        ((τ.app X)⟦n⟧' ≫ (F₂.commShiftIso n).inv.app X)
      exact IsIso.of_isIso_comp_right _ ((F₂.commShiftIso n).inv.app X)
    exact isIso_of_reflects_iso _ (shiftFunctor D n)
  · intro _
    infer_instance

instance : τ.isoLocus.IsStableUnderShift ℤ where
  isStableUnderShiftBy n :=
    { le_shift X hX := by
        rw [prop_shift_iff, isoLocus_iff, isIso_app_shift_iff]
        exact hX }

end Shift

section Triangulated

variable [HasZeroObject C] [HasZeroObject D] [Preadditive C] [Preadditive D] [HasShift C ℤ]
  [HasShift D ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive] [Pretriangulated C] [Pretriangulated D]
  [F₁.CommShift ℤ] [F₂.CommShift ℤ] [F₁.IsTriangulated] [F₂.IsTriangulated]
  (τ : F₁ ⟶ F₂) [NatTrans.CommShift τ ℤ]

instance : τ.isoLocus.IsTriangulated where
  exists_zero := ⟨0, isZero_zero C, by
    rw [isoLocus_iff]
    have e := (F₁.map_isZero (isZero_zero C)).iso (F₂.map_isZero (isZero_zero C))
    rw [(F₁.map_isZero (isZero_zero C)).eq_of_src (τ.app 0) e.hom]
    infer_instance⟩
  toIsTriangulatedClosed₂ := .mk' fun _ hT h₁ h₃ ↦
    isIso_app_obj₂_of_isIso_app_obj₁₃ τ hT h₁ h₃

/-- Blueprint `lem-sf-generating-class-determination` (and `sk-lem-sf-determination`): a
natural transformation between triangulated functors, compatible with the shifts, which is an
isomorphism on the objects of `P` is an isomorphism on the thick subcategory generated by `P`,
i.e. on the triangulated envelope `P.triangEnvelope`. -/
lemma isIso_app_of_triangEnvelope {P : ObjectProperty C} (h : ∀ X, P X → IsIso (τ.app X))
    {X : C} (hX : P.triangEnvelope X) : IsIso (τ.app X) :=
  (P.triangEnvelope_le_iff (Q := τ.isoLocus)).2 h X hX

/-- Blueprint `lem-sf-generating-class-determination` (and `sk-lem-sf-determination`): a
natural transformation between triangulated functors, compatible with the shifts, which is an
isomorphism on the objects of a classical generator `P` is an isomorphism. -/
lemma isIso_of_isClassicalTriangulatedGenerator {P : ObjectProperty C}
    (hP : P.IsClassicalTriangulatedGenerator) (h : ∀ X, P X → IsIso (τ.app X)) : IsIso τ := by
  rw [NatTrans.isIso_iff_isIso_app]
  intro X
  apply τ.isIso_app_of_triangEnvelope h
  rw [hP]
  trivial

end Triangulated

end CategoryTheory.NatTrans
