module

public import WeilConjectures.CategoryTheory.Pro.Basic
import Mathlib.CategoryTheory.Sites.Limits

/-! # Pointwise colimits on sites generated by finite hypercovers -/

@[expose] public section

universe u v uA vA w

open CategoryTheory Limits Opposite

namespace CategoryTheory

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

private def PreOneHypercover.multicospanCompIso
    {C : Type u} [Category.{v} C] {A : Type uA} [Category.{vA} A]
    {B : Type*} [Category* B] {X : C} (E : PreOneHypercover X)
    (P : Cᵒᵖ ⥤ A) (G : A ⥤ B) :
    (E.multicospanIndex P).multicospan ⋙ G ≅
      (E.multicospanIndex (P ⋙ G)).multicospan :=
  NatIso.ofComponents (fun k ↦ match k with
    | .left _ => Iso.refl _
    | .right _ => Iso.refl _) (by
      rintro (a | a) (b | b) (f | f | f) <;> simp)

private theorem finiteHypercover_isSheaf_comp
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [(J.finiteOneHypercover.{v, u, w}).IsGenerating]
    {A : Type uA} [Category.{vA} A] {B : Type*} [Category* B]
    (P : Cᵒᵖ ⥤ A) (hP : Presheaf.IsSheaf J P)
    (G : A ⥤ B) [PreservesFiniteLimits G] : Presheaf.IsSheaf J (P ⋙ G) := by
  rw [J.finiteOneHypercover.isSheaf_iff]
  intro X E hE
  let : E.toPreOneHypercover.Finite := hE
  let e := E.toPreOneHypercover.multicospanCompIso P G
  have h := isLimitOfPreserves G (E.isLimitMultifork ⟨P, hP⟩)
  refine ⟨IsLimit.ofIsoLimit ((IsLimit.postcomposeHomEquiv e _).symm h) ?_⟩
  exact Cone.ext (Iso.refl _) (by rintro (k | k) <;> simp [e,
    PreOneHypercover.multicospanCompIso, PreOneHypercover.multifork])

/-- Colimits commuting with finite limits are computed pointwise on a site generated
by finite one-hypercovers. Source: Stacks Project, Tag 0738, finite sheaf-condition limits.
(blueprint: stage3-finite-hypercover-colimits).

Proof: Combine the diagram of sheaf presheaves into a presheaf valued in the functor
category. Evaluation jointly reflects limits, so it is a sheaf. Each finite hypercover
has a finite multicospan category; the colimit functor preserves its limiting multifork.
Thus the pointwise colimit is a sheaf. The presheaf colimit therefore creates the sheaf
colimit, proving preservation by the sheaf inclusion. Empty diagrams are covered too. -/
theorem sheafToPresheaf_preservesColimits_of_finiteHypercovers
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [(J.finiteOneHypercover.{v, u, w}).IsGenerating]
    {A : Type uA} [Category.{vA} A]
    {I : Type*} [Category* I] [HasColimitsOfShape I A]
    [PreservesFiniteLimits (colim : (I ⥤ A) ⥤ A)] :
    PreservesColimitsOfShape I (sheafToPresheaf J A) := by
  constructor
  intro D
  suffices CreatesColimit D (sheafToPresheaf J A) from inferInstance
  refine Sheaf.createsColimitOfIsSheaf _ (fun c hc ↦ ?_)
  let P := (D ⋙ sheafToPresheaf J A).flip
  have hP : Presheaf.IsSheaf J P := by
    rw [Presheaf.isSheaf_iff_multifork]
    intro X S
    refine ⟨evaluationJointlyReflectsLimits _ (fun i ↦ ?_)⟩
    exact IsLimit.ofIsoLimit
      ((IsLimit.postcomposeHomEquiv (S.multicospanComp ((evaluation I A).obj i) P) _).symm
        ((D.obj i).property.isLimitMultifork S))
      (S.mapMultifork ((evaluation I A).obj i) P).symm
  let e : c.pt ≅ P ⋙ colim := hc.coconePointUniqueUpToIso (pointwiseIsColimit _)
  rw [Presheaf.isSheaf_of_iso_iff e]
  exact finiteHypercover_isSheaf_comp J P hP colim

end CategoryTheory
