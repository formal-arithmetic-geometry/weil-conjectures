module

public import Mathlib.Algebra.Category.ModuleCat.AB
public import Mathlib.Algebra.Category.ModuleCat.Projective
public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.ModuleEmbedding.GabrielPopescu
public import WeilConjectures.CategoryTheory.DerivedCategory.CompactGenerators
public import WeilConjectures.CategoryTheory.DerivedCategory.RightDerivedFunctor.Adjunction
public import WeilConjectures.CategoryTheory.DerivedCategory.RightDerivedFunctor.FullyFaithful
public import WeilConjectures.CategoryTheory.GrothendieckAbelian.HasDerivedCategory

/-!
# Brown representability for derived categories of Grothendieck abelian categories

Let `C` be a Grothendieck abelian category. We show that its unbounded derived category has
Brown representability (Stacks `0F5Y`), so that every triangulated functor out of `D(C)` which
preserves coproducts is a left adjoint.

* For a ring `R`, the derived category `D(R)` is compactly generated by `R` placed in degree
  `0`, hence has Brown representability.
* By the Gabriel–Popescu theorem, for a separator `G` of `C` with `R = End(G)ᵐᵒᵖ`, the functor
  `Hom(G, -) : C ⥤ Mod R` is fully faithful and has an exact left adjoint `- ⊗ G`. On derived
  categories this gives an adjunction `D(- ⊗ G) ⊣ R Hom(G, -)` whose right adjoint is fully
  faithful, and Brown representability descends along it.

## Main statements

- `ModuleCat.hasBrownRepresentability_derivedCategory`: `D(R)` has Brown representability.
- `CategoryTheory.IsGrothendieckAbelian.hasBrownRepresentability_derivedCategory`: `D(C)` has
  Brown representability for a Grothendieck abelian category `C`.
- `CategoryTheory.IsGrothendieckAbelian.isLeftAdjoint_of_preservesCoproducts`: a triangulated
  functor out of `D(C)` which preserves coproducts is a left adjoint.
-/

@[expose] public section

universe v u

open CategoryTheory Limits Abelian Pretriangulated

namespace ModuleCat

variable (R : Type v) [Ring R]

/-- The free module `R` detects zero modules. -/
lemma isZero_of_forall_self_hom_eq_zero (M : ModuleCat.{v} R)
    (hM : ∀ g : ModuleCat.of R R ⟶ M, g = 0) : IsZero M := by
  rw [IsZero.iff_id_eq_zero]
  ext x
  have := congrArg (fun g ↦ g.hom (1 : R)) (hM (ModuleCat.ofHom (LinearMap.toSpanSingleton R _ x)))
  simpa using this

variable [HasDerivedCategory.{v} (ModuleCat.{v} R)]

/-- **Brown representability** for the derived category of a ring: it is compactly generated by
the free module of rank one. -/
theorem hasBrownRepresentability_derivedCategory :
    HasBrownRepresentability (DerivedCategory (ModuleCat.{v} R)) :=
  DerivedCategory.hasBrownRepresentability_of_projective (fun _ : PUnit.{v + 1} ↦
    ModuleCat.of R R) (fun _ ↦ isCompactObject_self R)
    (fun M hM ↦ isZero_of_forall_self_hom_eq_zero R M (hM PUnit.unit))

end ModuleCat

namespace CategoryTheory.IsGrothendieckAbelian

variable {C : Type u} [Category.{v} C] [Abelian C] [IsGrothendieckAbelian.{v} C]

/-- The left adjoint `- ⊗ G` of `Hom(G, -)` is additive. -/
instance {G : C} : (tensorObj G).Additive :=
  (tensorObjPreadditiveCoyonedaObjAdjunction G).left_adjoint_additive

/-- `Hom(G, -)` is faithful for a separator `G`. -/
instance : (preadditiveCoyonedaObj (separator C)).Faithful :=
  (isSeparator_iff_faithful_preadditiveCoyonedaObj _).1 (isSeparator_separator C)

/-- `Hom(G, -)` is full for a separator `G` (Gabriel–Popescu). -/
instance : (preadditiveCoyonedaObj (separator C)).Full :=
  GabrielPopescu.full _ (isSeparator_separator C)

/-- The left adjoint `- ⊗ G` of `Hom(G, -)` is exact for a separator `G` (Gabriel–Popescu). -/
instance : PreservesFiniteLimits (tensorObj (separator C)) :=
  GabrielPopescu.preservesFiniteLimits _ (isSeparator_separator C)

/-- `Hom(G, -)` preserves K-injective complexes, being right adjoint to the exact `- ⊗ G`. -/
instance : (preadditiveCoyonedaObj (separator C)).PreservesKInjectiveComplexes :=
  (tensorObjPreadditiveCoyonedaObjAdjunction (separator C)).preservesKInjectiveComplexes

local instance : HasKInjectiveResolutions C :=
  hasKInjectiveResolutions_of_isGrothendieckAbelian.{v}

variable [HasDerivedCategory.{v} C]

/-- **Brown representability** for the derived category of a Grothendieck abelian category
(Stacks `0F5Y`): every additive cohomological functor sending coproducts to products is
representable. By Gabriel–Popescu, `D(C)` is a Bousfield localization of the compactly generated
`D(End(G)ᵐᵒᵖ)` for a separator `G`, along `D(- ⊗ G) ⊣ R Hom(G, -)`. -/
theorem hasBrownRepresentability_derivedCategory :
    HasBrownRepresentability (DerivedCategory C) := by
  let := HasDerivedCategory.ofIsGrothendieckAbelian.{v} (ModuleCat.{v} (End (separator C))ᵐᵒᵖ)
  let adj := Adjunction.mapDerivedCategoryRightDerivedAdjunction
    (tensorObjPreadditiveCoyonedaObjAdjunction (separator C))
  have (K : Type v) :
      PreservesColimitsOfShape (Discrete K) (tensorObj (separator C)).mapDerivedCategory :=
    Functor.preservesColimitsOfShape_mapDerivedCategory _ K
  exact (ModuleCat.hasBrownRepresentability_derivedCategory
    (End (separator C))ᵐᵒᵖ).of_adjunction adj

/-- **Brown representability for Grothendieck abelian categories** (Stacks `0F5Y`): a
triangulated functor `F : D(C) ⥤ D` out of the derived category of a Grothendieck abelian
category which preserves coproducts is a left adjoint. -/
theorem isLeftAdjoint_of_preservesCoproducts {D : Type*} [Category.{v} D] [HasZeroObject D]
    [HasShift D ℤ] [Preadditive D] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (F : DerivedCategory C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]
    [∀ K : Type v, PreservesColimitsOfShape (Discrete K) F] :
    F.IsLeftAdjoint :=
  hasBrownRepresentability_derivedCategory.isLeftAdjoint F

end CategoryTheory.IsGrothendieckAbelian
