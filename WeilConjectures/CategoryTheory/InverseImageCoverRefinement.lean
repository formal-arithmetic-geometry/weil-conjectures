/-! # Representable refinement of an inverse-image cover

Source: Stacks Project, Sites, Tag 00WL, local lifting for inverse image.
(blueprint: lem-weil-pbc-inverse-image-cover-refinement).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
namespace CategoryTheory

/-- The objects carrying sections of the inverse images of a covering family of
associated representables cover the source site.

Source: Stacks Project, Sites, Tag 00WL.
(blueprint: lem-weil-pbc-inverse-image-cover-refinement).

Proof: map the locally surjective family of associated representables to the terminal
sheaf through the left adjoint. Its target remains terminal by left exactness. The local
lifting assertion at its unique section supplies, on a covering sieve of each object,
a section of one inverse-image representable. Each lift indexes a chart on that very
object; its identity arrow witnesses membership in the sieve generated by the charts.
No subcanonicity or nonempty-family hypothesis is used. -/
theorem inverseImage_cover_refinement
    {C D : Type u} [SmallCategory C] [SmallCategory D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    (L : Sheaf J (Type u) ⥤ Sheaf K (Type u))
    (V : Sheaf K (Type u) ⥤ Sheaf J (Type u)) (adj : L ⊣ V)
    [PreservesFiniteLimits L]
    (A : Type u) (U : A → C) (hU : J.CoversTop U) :
    K.CoversTop (fun t : Σ W : D, Σ a : A,
      (L.obj ((presheafToSheaf J (Type u)).obj (yoneda.obj (U a)))).obj.obj (op W) ↦
        t.1) := by
  let T : Sheaf J (Type u) := ⊤_ _
  let Y (a : A) : Sheaf J (Type u) :=
    (presheafToSheaf J (Type u)).obj (yoneda.obj (U a))
  let q (a : A) : Y a ⟶ T := terminal.from _
  have hq : ∀ (W : Cᵒᵖ) (x : T.obj.obj W),
      ∃ S : Sieve W.unop, S ∈ J W.unop ∧
        ∀ (Z : C) (g : Z ⟶ W.unop), S g →
          ∃ (a : A) (y : (Y a).obj.obj (op Z)),
            (q a).hom.app (op Z) y = T.obj.map g.op x := by
    intro W x
    refine ⟨Sieve.ofObjects U W.unop, hU W.unop, ?_⟩
    rintro Z g ⟨a, ⟨b⟩⟩
    refine ⟨a, (toSheafify J (yoneda.obj (U a))).app (op Z) b, ?_⟩
    let E := sheafToPresheaf J (Type u) ⋙ (evaluation Cᵒᵖ (Type u)).obj (op Z)
    let : Unique (T.obj.obj (op Z)) :=
      Types.isTerminalEquivUnique _ (terminalIsTerminal.isTerminalObj E)
    exact Subsingleton.elim _ _
  intro W
  let E := L ⋙ sheafToPresheaf K (Type u) ⋙
    (evaluation Dᵒᵖ (Type u)).obj (op W)
  let : Unique ((L.obj T).obj.obj (op W)) :=
    Types.isTerminalEquivUnique _ (terminalIsTerminal.isTerminalObj E)
  obtain ⟨S, hS, hlift⟩ := Sheaf.map_jointly_locally_surjective L V adj q hq
    (op W) default
  apply K.superset_covering _ hS
  intro Z g hg
  obtain ⟨a, y, _⟩ := hlift Z g hg
  exact ⟨⟨Z, a, y⟩, ⟨𝟙 Z⟩⟩

end CategoryTheory
