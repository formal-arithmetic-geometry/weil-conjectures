module

public import Mathlib.CategoryTheory.Limits.HasLimits
public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.CategoryTheory.Types.Basic
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.Order.Directed
import Mathlib.Data.Quot

/-!
# Eventual morphisms of directed local categories

Source: latest blueprint, `sec-six-functors-basics/sk-prop-qlbar-two-colimit/`
`det-def-sfb-filtered-two-colimit-model.proof.md`, paragraphs “The colimit is filtered”
and “Composition” (blueprint: lem-sfb-directed-local-category-quotient).

The declarations below are the input data, concrete quotient constructions and individual
clauses of that lemma. Stage Hom sets, labels and indices have independent universes.
`ULift` places the Hom diagram in a universe containing both its indices and its Hom sets.
-/

@[expose] public section

set_option autoImplicit false

universe w u v z

namespace CategoryTheory.DirectedLocalCategory

open CategoryTheory Limits

variable {I : Type w} [Preorder I] {O : Type u}

/-- The labels born by stage `k`.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
abbrev StageObject (birth : O → I) (k : I) := {a : O // birth a ≤ k}

variable (birth : O → I) [E : ∀ k : I, Category.{v} (StageObject birth k)]

/-- The stage Hom set, retaining the proofs that both labels have been born.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
abbrev StageHom (k : I) (a b : O) (ha : birth a ≤ k) (hb : birth b ≤ k) :=
  (⟨a, ha⟩ : StageObject birth k) ⟶ ⟨b, hb⟩

variable {birth} (T : Transitions birth)

/-- The common-stage preorder `J_ab`.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
abbrev Index (birth : O → I) (a b : O) := {k : I // birth a ≤ k ∧ birth b ≤ k}

variable (birth)

/-- A representative is a stage in `J_ab` and a morphism at that stage.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
abbrev Rep (a b : O) :=
  (k : Index birth a b) × StageHom birth k.val a b k.property.1 k.property.2

variable {birth}

namespace Transitions

/-- Eventual equality means equality after transport to one common later stage.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def Eventual {a b : O} (r s : Rep birth a b) : Prop :=
  ∃ (p : I) (hr : r.1.val ≤ p) (hs : s.1.val ≤ p), T.map hr r.2 = T.map hs s.2

/-- The generating relation, a single forward transport.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def Step {a b : O} (r s : Rep birth a b) : Prop :=
  ∃ h : r.1.val ≤ s.1.val, T.map h r.2 = s.2

/-- The quotient by eventual equality; no injectivity of transport is assumed.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def Hom (a b : O) : Type (max w v) := Quot (T.Eventual (a := a) (b := b))

/-- The quotient by the equivalence relation generated by forward transport.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def GeneratedHom (a b : O) : Type (max w v) := Quot (T.Step (a := a) (b := b))

/-- The class of a stage representative in the eventual-equality quotient.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def classOf {a b : O} (r : Rep birth a b) : T.Hom a b := Quot.mk _ r

/-- The class in the quotient generated by forward transport.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def generatedClass {a b : O} (r : Rep birth a b) : T.GeneratedHom a b := Quot.mk _ r

/-- The transition function on the canonical universe lifts, with both universes fixed.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def liftedMap {a b : O} {k n : Index birth a b} (h : k ≤ n) :
    ULift.{w} (StageHom birth k.val a b k.property.1 k.property.2) →
      ULift.{w} (StageHom birth n.val a b n.property.1 n.property.2) :=
  fun g ↦ ⟨T.map h g.down⟩

/-- Identity law for the lifted Hom diagram.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: evaluate on `ULift` elements and apply the assumed `map_refl`. -/
theorem diagram_map_id (a b : O) (k : Index birth a b) :
    T.liftedMap (le_refl k) = id := by
  have _ := hI
  have _ := hdir
  funext g
  exact congrArg ULift.up (T.map_refl g.down)

/-- Composition law for the lifted Hom diagram.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: evaluate the functions and apply `map_trans` to their underlying stage morphisms. -/
theorem diagram_map_comp (a b : O) (k n p : Index birth a b) (h : k ≤ n) (h' : n ≤ p) :
    T.liftedMap (h.trans h') = T.liftedMap h' ∘ T.liftedMap h := by
  have _ := hI
  have _ := hdir
  funext g
  exact congrArg ULift.up (T.map_trans h h' g.down).symm

/-- The Hom diagram, lifted only to place its colimit in `Type (max w v)`.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def diagram (a b : O) : Index birth a b ⥤ Type (max w v) where
  obj k := ULift.{w} (StageHom birth k.val a b k.property.1 k.property.2)
  map h := ↾T.liftedMap (leOfHom h)
  map_id k := congrArg TypeCat.ofHom (T.diagram_map_id a b k)
  map_comp h h' := congrArg TypeCat.ofHom (T.diagram_map_comp a b _ _ _
    (leOfHom h) (leOfHom h'))

/-- The class maps form a compatible cocone.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: a representative and its forward transport are eventually equal at the target stage;
apply `classOf_properties`. -/
theorem classOf_naturality (a b : O) (k n : Index birth a b) (h : k ≤ n) :
    (fun g : ULift.{w} (StageHom birth k.val a b k.property.1 k.property.2) ↦
      T.classOf ⟨n, T.map h g.down⟩) = (fun g ↦ T.classOf ⟨k, g.down⟩) := by
  have _ := hI
  have _ := hdir
  funext g
  apply Quot.sound
  exact ⟨n.val, le_rfl, h, T.map_refl _⟩

/-- The cocone whose vertex is the actual eventual-equality quotient.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def cocone (a b : O) : Cocone (T.diagram a b) where
  pt := T.Hom a b
  ι :=
    { app := fun k ↦ ↾fun g ↦ T.classOf ⟨k, g.down⟩
      naturality := fun {k n} h ↦ congrArg TypeCat.ofHom
        (T.classOf_naturality a b k n (leOfHom h)) }

/-- The quotient is a colimit in the precise categorical sense.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: by `classOf_properties` all elements are represented, and equal classes agree at a
common stage. A compatible cocone therefore defines a unique function on classes.
This is [def-weil-pbc-category-colimit], equivalently the recognition criterion in
[lem-weil-pbc-filtered-colimit-sets-elementwise]. -/
theorem cocone_isColimit (a b : O) : Nonempty (IsColimit (T.cocone a b)) := by
  have _ := hI
  have _ := hdir
  refine ⟨{
    desc := fun s ↦ ↾Quot.lift (fun r ↦ s.ι.app r.1 ⟨r.2⟩) (by
      rintro r t ⟨p, hr, ht, e⟩
      let k : Index birth a b :=
        ⟨p, r.1.property.1.trans hr, r.1.property.2.trans hr⟩
      have er := types_congr_hom (s.w (homOfLE (show r.1 ≤ k from hr)))
        (ULift.up r.2)
      have et := types_congr_hom (s.w (homOfLE (show t.1 ≤ k from ht)))
        (ULift.up t.2)
      exact er.symm.trans ((congrArg (fun g ↦ s.ι.app k (ULift.up g)) e).trans et))
    fac := ?_
    uniq := ?_ }⟩
  · intro s k
    ext g
    rfl
  · intro s m hm
    apply ConcreteCategory.hom_ext
    intro x
    induction x using Quot.inductionOn with
    | h r => exact ConcreteCategory.congr_hom (hm r.1) ⟨r.2⟩

/-- The explicit universal property, also allowing target sets in any universe.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: send a represented class to the assigned value. Eventual equality and compatibility
make this independent of representatives. Representation of every class gives uniqueness. -/
theorem existsUnique_desc (a b : O) (S : Type z)
    (f : ∀ k : Index birth a b, StageHom birth k.val a b k.property.1 k.property.2 → S)
    (hf : ∀ (k n : Index birth a b) (h : k ≤ n)
      (g : StageHom birth k.val a b k.property.1 k.property.2), f n (T.map h g) = f k g) :
    ∃! u : T.Hom a b → S, ∀ r : Rep birth a b, u (T.classOf r) = f r.1 r.2 := by
  have _ := hI
  have _ := hdir
  let u : T.Hom a b → S := Quot.lift (fun r ↦ f r.1 r.2) (by
    rintro r s ⟨p, hr, hs, e⟩
    let k : Index birth a b :=
      ⟨p, r.1.property.1.trans hr, r.1.property.2.trans hr⟩
    exact (hf r.1 k hr r.2).symm.trans ((congrArg (f k) e).trans (hf s.1 k hs s.2)))
  refine ⟨u, fun r ↦ rfl, ?_⟩
  intro v hv
  funext x
  induction x using Quot.inductionOn with
  | h r => exact hv r

private theorem eventual_refl {a b : O} (r : Rep birth a b) : T.Eventual r r := by
  have _ := hI
  have _ := hdir
  exact ⟨r.1.val, le_rfl, le_rfl, rfl⟩

private theorem eventual_symm {a b : O} {r s : Rep birth a b}
    (h : T.Eventual r s) : T.Eventual s r := by
  have _ := hI
  have _ := hdir
  obtain ⟨p, hr, hs, e⟩ := h
  exact ⟨p, hs, hr, e.symm⟩

private theorem eventual_trans {a b : O} {r s t : Rep birth a b}
    (h : T.Eventual r s) (h' : T.Eventual s t) : T.Eventual r t := by
  have _ := hI
  have _ := hdir
  obtain ⟨p, hr, hs, e⟩ := h
  obtain ⟨q, hs', ht, e'⟩ := h'
  obtain ⟨m, hp, hq⟩ := exists_ge_ge p q
  refine ⟨m, hr.trans hp, ht.trans hq, ?_⟩
  calc
    T.map (hr.trans hp) r.2 = T.map hp (T.map hr r.2) := (T.map_trans _ _ _).symm
    _ = T.map hp (T.map hs s.2) := congrArg (T.map hp) e
    _ = T.map (hs.trans hp) s.2 := T.map_trans _ _ _
    _ = T.map hq (T.map hs' s.2) := (T.map_trans _ _ _).symm
    _ = T.map hq (T.map ht t.2) := congrArg (T.map hq) e'
    _ = T.map (ht.trans hq) t.2 := T.map_trans _ _ _

private theorem step_eventual {a b : O} {r s : Rep birth a b}
    (h : T.Step r s) : T.Eventual r s := by
  have _ := hI
  have _ := hdir
  obtain ⟨h, e⟩ := h
  exact ⟨s.1.val, h, le_rfl, e.trans (T.map_refl s.2).symm⟩

/-- Eventual equality is an equivalence relation and is exactly the equivalence closure of `Step`.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: take the original stage for reflexivity and reverse the equality for symmetry.
For transitivity take an upper bound of the two witnesses, then use `map_trans`.
A forward step is eventual equality at its target. Conversely two eventually equal
representatives are connected by two forward steps to their common transported representative. -/
theorem eventual_equivalence (a b : O) :
    _root_.Equivalence (T.Eventual (a := a) (b := b)) ∧
      ∀ r s : Rep birth a b, T.Eventual r s ↔ Relation.EqvGen T.Step r s := by
  have _ := hI
  have _ := hdir
  refine ⟨⟨T.eventual_refl, fun h ↦ T.eventual_symm h,
    fun h h' ↦ T.eventual_trans h h'⟩, ?_⟩
  intro r s
  constructor
  · rintro ⟨p, hr, hs, e⟩
    let t : Rep birth a b :=
      ⟨⟨p, r.1.property.1.trans hr, r.1.property.2.trans hr⟩, T.map hr r.2⟩
    exact Relation.EqvGen.trans r t s (Relation.EqvGen.rel _ _ ⟨hr, rfl⟩)
      (Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ ⟨hs, e.symm⟩))
  · intro h
    induction h with
    | rel r s h => exact T.step_eventual h
    | refl r => exact T.eventual_refl r
    | symm r s h ih => exact T.eventual_symm ih
    | trans r s t h h' ih ih' => exact T.eventual_trans ih ih'

/-- Every Hom class is represented, and equality is exactly the common-stage condition.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: quotient induction supplies representatives. Equality in `Quot` is the equivalence
closure of its relation, which equals that relation by `eventual_equivalence`. -/
theorem classOf_properties (a b : O) :
    Function.Surjective (T.classOf (a := a) (b := b)) ∧
      ∀ r s : Rep birth a b, T.classOf r = T.classOf s ↔ T.Eventual r s := by
  have _ := hI
  have _ := hdir
  refine ⟨?_, fun r s ↦ (T.eventual_equivalence a b).1.quot_mk_eq_iff r s⟩
  intro x
  induction x using Quot.inductionOn with
  | h r => exact ⟨r, rfl⟩

/-- The common-stage preorder is filtered, including nonemptiness.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: an upper bound of the two birth indices belongs to `J_ab`; upper bounds of stages
remain in `J_ab`. Parallel arrows in a preorder coincide and are equalized by the identity.
This is `IsFiltered` from [def-weil-pbc-category-colimit]. -/
theorem index_isFiltered (a b : O) : IsFiltered (Index birth a b) := by
  have _ := E
  have _ := hI
  have _ := hdir
  obtain ⟨k, ha, hb⟩ := exists_ge_ge (birth a) (birth b)
  let : Nonempty (Index birth a b) := ⟨⟨k, ha, hb⟩⟩
  let : IsDirectedOrder (Index birth a b) := ⟨fun k n ↦ by
    obtain ⟨p, hk, hn⟩ := exists_ge_ge k.val n.val
    exact ⟨⟨p, k.property.1.trans hk, k.property.2.trans hk⟩, hk, hn⟩⟩
  infer_instance

variable [hI : Nonempty I] [hdir : IsDirected I (· ≤ ·)]

include hI hdir

/-- A chosen common upper bound, used only in the concrete composition construction.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
noncomputable def upper (k n : I) : {m : I // k ≤ m ∧ n ≤ m} :=
  ⟨(exists_ge_ge k n).choose, (exists_ge_ge k n).choose_spec⟩

/-- Compose representatives at a specified common stage.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def compAt {a b c : O} (r : Rep birth a b) (s : Rep birth b c)
    (m : I) (hr : r.1.val ≤ m) (hs : s.1.val ≤ m) : Rep birth a c :=
  ⟨⟨m, r.1.property.1.trans hr, s.1.property.2.trans hs⟩,
    T.map hr r.2 ≫ T.map hs s.2⟩

/-- The composite class before descent, evaluated at the chosen upper bound.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
noncomputable def compositeClass {a b c : O} (r : Rep birth a b) (s : Rep birth b c) :
    T.Hom a c :=
  T.classOf (T.compAt r s (upper r.1.val s.1.val).val
    (upper r.1.val s.1.val).property.1 (upper r.1.val s.1.val).property.2)

/-- The formula is independent of both the representatives and the common stage.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: move the witnesses for eventual equality and both choices of common stage to a
further upper bound. Apply `map_trans` and `map_comp`, then compare the resulting equal
stage composites. No injectivity or antisymmetry is used. -/
theorem compositeClass_independent {a b c : O}
    (r r' : Rep birth a b) (s s' : Rep birth b c)
    (hr : T.Eventual r r') (hs : T.Eventual s s')
    (m n : I) (hmr : r.1.val ≤ m) (hms : s.1.val ≤ m)
    (hnr : r'.1.val ≤ n) (hns : s'.1.val ≤ n) :
    T.classOf (T.compAt r s m hmr hms) = T.classOf (T.compAt r' s' n hnr hns) := by
  have _ := hI
  have _ := hdir
  obtain ⟨p, hrp, hrp', er⟩ := hr
  obtain ⟨q, hsq, hsq', es⟩ := hs
  obtain ⟨v, hpv, hqv⟩ := exists_ge_ge p q
  obtain ⟨w, hvw, hmw⟩ := exists_ge_ge v m
  obtain ⟨z, hwz, hnz⟩ := exists_ge_ge w n
  have hpz := hpv.trans (hvw.trans hwz)
  have hqz := hqv.trans (hvw.trans hwz)
  have hmz := hmw.trans hwz
  apply Quot.sound
  refine ⟨z, hmz, hnz, ?_⟩
  dsimp only [compAt]
  simp only [T.map_comp, T.map_trans]
  have er' := congrArg (T.map hpz) er
  have es' := congrArg (T.map hqz) es
  simp only [T.map_trans] at er' es'
  rw [er', es']

/-- Well-definedness in the second input, needed by `Quot.lift₂`.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: use `compositeClass_independent` with the first representative unchanged and the
chosen upper bounds. Reflexivity of eventual equality supplies the unchanged input. -/
theorem compositeClass_right {a b c : O} (r : Rep birth a b) (s s' : Rep birth b c)
    (h : T.Eventual s s') : T.compositeClass r s = T.compositeClass r s' := by
  have _ := hI
  have _ := hdir
  exact T.compositeClass_independent r r s s' (T.eventual_refl r) h _ _ _ _ _ _

/-- Well-definedness in the first input, needed by `Quot.lift₂`.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: use `compositeClass_independent` with the second representative unchanged and the
chosen upper bounds. Reflexivity supplies the unchanged input. -/
theorem compositeClass_left {a b c : O} (r r' : Rep birth a b) (s : Rep birth b c)
    (h : T.Eventual r r') : T.compositeClass r s = T.compositeClass r' s := by
  have _ := hI
  have _ := hdir
  exact T.compositeClass_independent r r' s s h (T.eventual_refl s) _ _ _ _ _ _

/-- Composition on the concrete quotient, by separate descent in its two inputs.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
noncomputable def comp {a b c : O} : T.Hom a b → T.Hom b c → T.Hom a c :=
  Quot.lift₂ T.compositeClass T.compositeClass_right T.compositeClass_left

variable (birth) in
/-- The identity representative is the stage identity at the birth index.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def identityRep (a : O) : Rep birth a a :=
  ⟨⟨birth a, le_rfl, le_rfl⟩, 𝟙 (⟨a, le_rfl⟩ : StageObject birth (birth a))⟩

/-- The identity class is exactly the class of the birth-stage identity.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def identity (a : O) : T.Hom a a := T.classOf (identityRep birth a)

/-- The displayed common-stage formula holds for every choice of upper bound.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: unfold the two quotient lifts on classes and compare the chosen common stage with
`m` using `compositeClass_independent` and reflexivity. -/
theorem comp_classOf {a b c : O} (r : Rep birth a b) (s : Rep birth b c)
    (m : I) (hr : r.1.val ≤ m) (hs : s.1.val ≤ m) :
    T.comp (T.classOf r) (T.classOf s) = T.classOf (T.compAt r s m hr hs) := by
  have _ := hI
  have _ := hdir
  exact T.compositeClass_independent r r s s (T.eventual_refl r) (T.eventual_refl s)
    _ m _ _ hr hs

/-- The formula descends separately even through the single generating relation `Step`.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: a generating step is eventual equality at its target stage. Apply
`compositeClass_left` or `compositeClass_right` respectively. -/
theorem compositeClass_step {a b c : O} :
    (∀ (r r' : Rep birth a b) (s : Rep birth b c), T.Step r r' →
      T.compositeClass r s = T.compositeClass r' s) ∧
    (∀ (r : Rep birth a b) (s s' : Rep birth b c), T.Step s s' →
      T.compositeClass r s = T.compositeClass r s') := by
  have _ := hI
  have _ := hdir
  exact ⟨fun r r' s h ↦ T.compositeClass_left r r' s (T.step_eventual h),
    fun r s s' h ↦ T.compositeClass_right r s s' (T.step_eventual h)⟩

/-- Forward transport relates equal eventual classes.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: take the target of the forward step as common stage and use `map_refl`. -/
theorem classOf_step {a b : O} (r s : Rep birth a b) (h : T.Step r s) :
    T.classOf r = T.classOf s := by
  have _ := hI
  have _ := hdir
  exact Quot.sound (T.step_eventual h)

/-- The identity-on-representatives map from the generated quotient to eventual classes.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def generatedToHom (a b : O) : T.GeneratedHom a b → T.Hom a b :=
  Quot.lift T.classOf T.classOf_step

/-- The identity-on-representatives comparison is bijective.
Source: the blueprint proof, “The colimit is filtered”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: both quotients have the same equivalence relation by `eventual_equivalence`.
Representation gives surjectivity, and the equality characterization gives injectivity. -/
theorem generatedToHom_bijective (a b : O) : Function.Bijective (T.generatedToHom a b) := by
  have _ := hI
  have _ := hdir
  constructor
  · intro x y e
    induction x using Quot.inductionOn with
    | h r =>
      induction y using Quot.inductionOn with
      | h s =>
        apply Quot.eqvGen_sound
        exact (T.eventual_equivalence a b).2 r s |>.mp
          ((T.classOf_properties a b).2 r s |>.mp e)
  · intro x
    induction x using Quot.inductionOn with
    | h r => exact ⟨T.generatedClass r, rfl⟩

/-- The canonical bijection, uniquely specified by its values on representatives.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
noncomputable def generatedEquiv (a b : O) : T.GeneratedHom a b ≃ T.Hom a b :=
  Equiv.ofBijective (T.generatedToHom a b) (T.generatedToHom_bijective a b)

/-- Identity in the generated quotient, using the same birth-stage representative.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
def generatedIdentity (a : O) : T.GeneratedHom a a := T.generatedClass (identityRep birth a)

/-- Composition in the generated quotient, transported by the canonical bijections.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
noncomputable def generatedComp {a b c : O}
    (f : T.GeneratedHom a b) (g : T.GeneratedHom b c) : T.GeneratedHom a c :=
  (T.generatedEquiv a c).symm (T.comp (T.generatedEquiv a b f) (T.generatedEquiv b c g))

/-- The generated quotient has the same formula, and the comparison preserves it and identities.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: apply the injective canonical comparison and compute on representatives using
`comp_classOf`. Its values on representatives are definitionally the same classes;
this also proves preservation of the birth identity. Preservation of arbitrary composites
follows from the inverse identities of the bijections. -/
theorem generated_formulas :
    (∀ a : O, T.generatedEquiv a a (T.generatedIdentity a) = T.identity a) ∧
    (∀ {a b c : O} (f : T.GeneratedHom a b) (g : T.GeneratedHom b c),
      T.generatedEquiv a c (T.generatedComp f g) =
        T.comp (T.generatedEquiv a b f) (T.generatedEquiv b c g)) ∧
    (∀ {a b c : O} (r : Rep birth a b) (s : Rep birth b c)
      (m : I) (hr : r.1.val ≤ m) (hs : s.1.val ≤ m),
      T.generatedComp (T.generatedClass r) (T.generatedClass s) =
        T.generatedClass (T.compAt r s m hr hs)) := by
  have _ := hI
  have _ := hdir
  refine ⟨fun a ↦ rfl, fun f g ↦ (T.generatedEquiv _ _).apply_symm_apply _, ?_⟩
  intro a b c r s m hr hs
  apply (T.generatedEquiv a c).injective
  change (T.generatedEquiv a c) ((T.generatedEquiv a c).symm
    (T.comp (T.classOf r) (T.classOf s))) = T.classOf (T.compAt r s m hr hs)
  rw [Equiv.apply_symm_apply, T.comp_classOf]

private theorem class_transport {a b : O} (r : Rep birth a b)
    (m : I) (hr : r.1.val ≤ m) :
    T.classOf r = T.classOf
      ⟨⟨m, r.1.property.1.trans hr, r.1.property.2.trans hr⟩, T.map hr r.2⟩ := by
  have _ := hI
  have _ := hdir
  exact Quot.sound ⟨m, hr, le_rfl, (T.map_refl _).symm⟩

private theorem comp_same_stage {a b c : O} (m : I)
    (ha : birth a ≤ m) (hb : birth b ≤ m) (hc : birth c ≤ m)
    (f : StageHom birth m a b ha hb) (g : StageHom birth m b c hb hc) :
    T.comp (T.classOf ⟨⟨m, ha, hb⟩, f⟩) (T.classOf ⟨⟨m, hb, hc⟩, g⟩) =
      T.classOf ⟨⟨m, ha, hc⟩, f ≫ g⟩ := by
  have _ := hI
  have _ := hdir
  rw [T.comp_classOf _ _ m le_rfl le_rfl]
  simp only [compAt, T.map_refl]

/-- The quotient operations satisfy both unit laws and associativity.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient).
Proof: represent the morphisms and move them all to one common stage. Use `map_id`
for birth-stage identities, `map_comp` and `map_trans` for repeated compositions, then
apply the two identity laws and associativity in that ordinary stage category. -/
theorem category_laws :
    (∀ {a b : O} (f : T.Hom a b), T.comp (T.identity a) f = f) ∧
    (∀ {a b : O} (f : T.Hom a b), T.comp f (T.identity b) = f) ∧
    (∀ {a b c d : O} (f : T.Hom a b) (g : T.Hom b c) (h : T.Hom c d),
      T.comp (T.comp f g) h = T.comp f (T.comp g h)) := by
  have _ := hI
  have _ := hdir
  refine ⟨?_, ?_, ?_⟩
  · intro a b f
    induction f using Quot.inductionOn with
    | h r =>
      change T.comp (T.classOf (identityRep birth a)) (T.classOf r) = T.classOf r
      rw [T.comp_classOf _ _ r.1.val r.1.property.1 le_rfl]
      dsimp only [compAt, identityRep]
      simp only [T.map_id, T.map_refl, Category.id_comp]
  · intro a b f
    induction f using Quot.inductionOn with
    | h r =>
      change T.comp (T.classOf r) (T.classOf (identityRep birth b)) = T.classOf r
      rw [T.comp_classOf _ _ r.1.val le_rfl r.1.property.2]
      dsimp only [compAt, identityRep]
      simp only [T.map_id, T.map_refl, Category.comp_id]
  · intro a b c d f g h
    induction f using Quot.inductionOn with
    | h r =>
      induction g using Quot.inductionOn with
      | h s =>
        induction h using Quot.inductionOn with
        | h t =>
          obtain ⟨p, hrp, hsp⟩ := exists_ge_ge r.1.val s.1.val
          obtain ⟨m, hpm, htm⟩ := exists_ge_ge p t.1.val
          have hrm := hrp.trans hpm
          have hsm := hsp.trans hpm
          change T.comp (T.comp (T.classOf r) (T.classOf s)) (T.classOf t) =
            T.comp (T.classOf r) (T.comp (T.classOf s) (T.classOf t))
          rw [T.class_transport r m hrm, T.class_transport s m hsm,
            T.class_transport t m htm]
          simp only [T.comp_same_stage, Category.assoc]

/-- The actual category on the given label set `O`, with the constructed quotient Hom sets.
Source: the blueprint proof, “Composition”
(blueprint: lem-sfb-directed-local-category-quotient). -/
@[instance_reducible]
noncomputable def category : Category.{max w v} O where
  Hom := T.Hom
  id := T.identity
  comp := T.comp
  id_comp := T.category_laws.1
  comp_id := T.category_laws.2.1
  assoc := T.category_laws.2.2

end Transitions

end CategoryTheory.DirectedLocalCategory
