/-! # Nonfinite-coefficient compactness from finite base cohomological dimension

This is the rational-coefficient Ext input needed by the corrected Brown theorem.
The adopted source currently records the corresponding compactness declarations over finite
or separably closed fields; this theorem isolates the finite-cd extension.
(blueprint: lem-sfb-brown-finite-cd-nonfinite-compact)
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry AlgebraicGeometry.ProEtale

namespace CategoryTheory

attribute [local instance 30000] brownHypothesesCondensedMonoidal
  brownHypothesesCondensedBraided brownHypothesesSheafMonoidal
  brownHypothesesSheafBraided brownHypothesesCoefficientMonObj
  brownHypothesesModuleMonoidalClosed
attribute [local instance 20000] AlgebraicGeometry.ProEtale.sheafBraidedCategory
attribute [local irreducible] DerivedCategory.monoidalClosed CategoryTheory.Mod.monoidalClosed
attribute [local irreducible] AlgebraicGeometry.ProEtale.upperStarFromPoint
  AlgebraicGeometry.ProEtale.CondensedRing.upperStar

private theorem boundedConstructible_single
    {X : Scheme.{u}} (R : Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
    [MonObj R] [IsCommMonObj R]
    (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) R)
    (hM : IsConstructibleModuleObject R M) (n : ℤ) :
    boundedConstructible R ((DerivedCategory.singleFunctor _ n).obj M) := by
  rw [mem_boundedConstructible_iff]
  refine ⟨⟨n, n, ?_⟩, ?_⟩
  · intro i hi
    rcases hi with hi | hi
    · exact DerivedCategory.isZero_of_isGE _ n i hi
    · exact DerivedCategory.isZero_of_isLE _ n i hi
  · intro i
    rcases eq_or_ne i n with rfl | hi
    · exact constructible_of_iso
        ((DerivedCategory.singleFunctorCompHomologyFunctorIso _ i).app M).symm hM
    · rcases lt_or_gt_of_ne hi with hi | hi
      · exact isConstructibleModuleObject_of_isZero R
          (DerivedCategory.isZero_of_isGE _ n i hi)
      · exact isConstructibleModuleObject_of_isZero R
          (DerivedCategory.isZero_of_isLE _ n i hi)

private theorem continuous_bound_from_integral
    (ℓ : ℕ) [Fact ℓ.Prime] (E : Type) [NormedField E]
    [NormedAlgebra ℚ_[ℓ] E] [FiniteDimensional ℚ_[ℓ] E]
    (X : Scheme.{u}) [TopologicalSpace.NoetherianSpace X]
    (hb : HasUniformConstructibleExtBound
      (condensedRingObj (CondensedRing.integralCoeff ℓ E) X)) :
    HasUniformConstructibleExtBound
      (condensedRingObj (Profinite.continuousMapRingObj E) X) := by
  let R := condensedRingObj (CondensedRing.integralCoeff ℓ E) X
  let F := Mod.extendScalars (coefficientMap (CondensedRing.integralScalarMap ℓ E) X)
  let L := CondensedRing.integralScalarExtension ℓ E X
  have : F.leftDerivedFunctor.Additive :=
    Functor.additive_of_iso F.leftDerivedFunctorIsoMapDerivedCategory.symm
  have model (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj E) X))
      (hM : IsConstructibleModuleObject _ M) :
      ∃ N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) R,
        IsConstructibleModuleObject R N ∧ Nonempty (F.obj N ≅ M) := by
    obtain ⟨S, hS⟩ := hM
    exact CondensedRing.continuousConstructible_integral_gluing ℓ E X M S
      (fun a ↦ CondensedRing.continuousConstructible_integral_stratum ℓ E X
        (S.immersion a) _ (hS a))
  intro M hM
  obtain ⟨A, hA, ⟨eA⟩⟩ := model M hM
  obtain ⟨d, hd⟩ := hb A hA
  refine ⟨d, ?_⟩
  intro B hB n hn f
  obtain ⟨B₀, hB₀, ⟨eB⟩⟩ := model B hB
  let A' : CondensedRing.integralConstructible ℓ E X :=
    ⟨(DerivedCategory.singleFunctor _ 0).obj A, boundedConstructible_single R A hA 0⟩
  let B' : CondensedRing.integralConstructible ℓ E X :=
    ⟨(DerivedCategory.singleFunctor _ n).obj B₀, boundedConstructible_single R B₀ hB₀ n⟩
  let es (i : ℤ) : DerivedCategory.singleFunctor _ i ⋙ L ≅
      F ⋙ DerivedCategory.singleFunctor _ i :=
    Functor.isoWhiskerLeft (DerivedCategory.singleFunctor _ i)
      F.leftDerivedFunctorIsoMapDerivedCategory ≪≫ F.mapDerivedCategorySingleFunctor i
  let a : L.obj A'.obj ≅ (DerivedCategory.singleFunctor _ 0).obj M :=
    (es 0).app A ≪≫ (DerivedCategory.singleFunctor _ 0).mapIso eA
  let b : L.obj B'.obj ≅ (DerivedCategory.singleFunctor _ n).obj B :=
    (es n).app B₀ ≪≫ (DerivedCategory.singleFunctor _ n).mapIso eB
  let f' := a.hom ≫ f ≫ b.inv
  obtain ⟨s, g, hg⟩ :=
    CondensedRing.continuousConstructible_clear_denominators ℓ E X A' B' f'
  have hg0 : g.hom = 0 := hd B₀ hB₀ n hn g.hom
  have hf0 : ℓ ^ s • f' = 0 := by
    rw [hg, hg0]
    change F.leftDerivedFunctor.map 0 = 0
    simp
  have hi (j : ℕ) : IsIso (ℓ ^ j • 𝟙 (L.obj A'.obj)) := by
    induction j with
    | zero => simpa using (inferInstance : IsIso (𝟙 (L.obj A'.obj)))
    | succ j ih =>
      have : IsIso (ℓ • 𝟙 (L.obj A'.obj)) :=
        CondensedRing.derived_nsmul_isIso ℓ E X _
      have heq : ℓ ^ (j + 1) • 𝟙 (L.obj A'.obj) =
          (ℓ ^ j • 𝟙 (L.obj A'.obj)) ≫ (ℓ • 𝟙 (L.obj A'.obj)) := by
        simp only [pow_succ, CategoryTheory.Preadditive.nsmul_comp,
          CategoryTheory.Preadditive.comp_nsmul, Category.id_comp, mul_smul]
        exact smul_comm _ _ _
      rw [heq]
      infer_instance
  have := hi s
  have hf' : f' = 0 := by
    apply (cancel_epi (ℓ ^ s • 𝟙 (L.obj A'.obj))).mp
    simpa only [CategoryTheory.Preadditive.nsmul_comp, Category.id_comp, comp_zero] using hf0
  dsimp [f'] at hf' ⊢
  apply (cancel_epi a.hom).mp
  apply (cancel_mono b.inv).mp
  simpa only [comp_zero, zero_comp, Category.assoc] using hf'

private theorem uniform_bound_coefficientIso
    {X : Scheme.{u}} {R S : Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}}
    [MonObj R] [MonObj S] [IsCommMonObj R] [IsCommMonObj S]
    (e : R ≅ S) [IsMonHom e.inv]
    (h : HasUniformConstructibleExtBound S) : HasUniformConstructibleExtBound R := by
  let F : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) R ⥤
      Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) S :=
    Mod.comap (D := Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) e.inv
  have : F.IsEquivalence := (Mod.comapEquivalenceOfIsIso e.inv).isEquivalence_functor
  have : F.mapDerivedCategory.IsEquivalence := Functor.isEquivalence_mapDerivedCategory F
  intro M hM
  obtain ⟨d, hd⟩ := h (F.obj M) (constructible_comap e.inv hM)
  refine ⟨d, fun B hB n hn f ↦ ?_⟩
  let a := (F.mapDerivedCategorySingleFunctor 0).app M
  let b := (F.mapDerivedCategorySingleFunctor n).app B
  have hf := hd (F.obj B) (constructible_comap e.inv hB) n hn
    (a.inv ≫ F.mapDerivedCategory.map f ≫ b.hom)
  apply F.mapDerivedCategory.map_injective
  rw [Functor.map_zero]
  apply (cancel_epi a.inv).mp
  apply (cancel_mono b.hom).mp
  simpa only [comp_zero, zero_comp, Category.assoc] using hf

/-- Uniform constructible Ext bounds for rational and finite-subextension-valued
algebraic-closure coefficients over a field of finite ℓ-cohomological dimension.

Source: blueprint latest, `sk-lem-uniform-constructible-ext.proof.md` and
`sk-lem-int-ext.proof.md`. (blueprint: lem-sfb-brown-finite-cd-nonfinite-compact).

Proof: X is compact and locally Noetherian, hence topologically Noetherian. For a finite
coefficient field E, every constructible E-sheaf M is the rationalization of a
constructible integral sheaf A, glued from integral models on the strata. Fix A and its
uniform integral cutoff from the finite-cd integral bound. For a constructible target B
choose an integral model B0. Exact rationalization identifies the rationalized
single-degree complexes of A and B0 with those of M and B; denominator clearing writes
ell^s times any map between them as the rationalization of an integral map, which
vanishes below the cutoff. Multiplication by ell is invertible rationally, so the map
vanishes. The base rational ring is isomorphic to the bottom finite field ring, and
restriction along that isomorphism is an equivalence preserving constructibility, which
transports the bound. For the finite-subextension-valued algebraic closure, descend a
fixed constructible source to a constructible A over one finite field E; Ext continuity
over E gives a cutoff for A against every ind-constructible E-target. The restriction to
E of every constructible algebraic-closure target is ind-constructible, and the derived
scalar adjunction transports the vanishing. The cutoff depends only on the source; the
zero module and the empty scheme need no separate argument. -/
theorem brownHypotheses_rational_uniformExtBound_of_finite_cd
    (ℓ : ℕ) [Fact ℓ.Prime]
    {k : Type u} [Field k] [Fact (ringChar k ≠ ℓ)]
    (hcd : cohomologicalDimension ℓ (Fact.out : ℓ.Prime) (Spec (.of k)) < ⊤)
    {X : Scheme.{u}} (aX : X ⟶ Spec (.of k))
    [IsSeparated aX] [LocallyOfFiniteType aX] [QuasiCompact aX] :
    HasUniformConstructibleExtBound
      (condensedRingObj (Profinite.continuousMapRingObj.{u} ℚ_[ℓ]) X) ∧
    (∀ E : PadicAlgCl.FiniteIntermediateField ℓ,
      HasUniformConstructibleExtBound
        (condensedRingObj (Profinite.continuousMapRingObj.{u} E) X)) ∧
    HasUniformConstructibleExtBound
      (condensedRingObj (Profinite.padicAlgClRingObj.{u} ℓ) X) := by
  classical
  let _ : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace aX
  let _ : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian aX
  have : IsNoetherian X := ⟨⟩
  have hfinite : ∀ E : PadicAlgCl.FiniteIntermediateField ℓ,
      HasUniformConstructibleExtBound
        (condensedRingObj (Profinite.continuousMapRingObj.{u} E) X) := by
    intro E
    let := PadicAlgCl.normedFieldOfAlgebra ℓ E
    let : NormedAlgebra ℚ_[ℓ] E :=
      { norm_smul_le c x := by
          change ‖algebraMap E (PadicAlgCl ℓ) (c • x)‖ ≤
            ‖c‖ * ‖algebraMap E (PadicAlgCl ℓ) x‖
          rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, norm_mul,
            PadicAlgCl.norm_extends] }
    have hO : (PadicAlgCl.integers ℓ E).toSubring = CondensedRing.continuousIntegers ℓ E := by
      ext x
      rfl
    apply continuous_bound_from_integral ℓ E X
    have hb := brownHypotheses_integral_uniformExtBound_of_finite_cd ℓ hcd aX E
    change HasUniformConstructibleExtBound
      (condensedRingObj (Profinite.continuousMapRingObj
        (PadicAlgCl.integers ℓ E).toSubring) X) at hb
    rw [hO] at hb
    exact hb
  refine ⟨?_, hfinite, ?_⟩
  · obtain ⟨_, _, _, _, _, _, _, _, q, _, _⟩ :=
      Profinite.base_coefficient_condensed_identification.{u} ℓ
    let e : condensedRingObj (Profinite.continuousMapRingObj.{u} ℚ_[ℓ]) X ≅
        condensedRingObj (Profinite.continuousMapRingObj
          (⊥ : IntermediateField ℚ_[ℓ] (PadicAlgCl ℓ))) X :=
      (upperStarFromPoint X).mapIso ((Mon.forget _).mapIso q)
    have : IsMonHom e.inv :=
      inferInstanceAs (IsMonHom ((upperStarFromPoint X).map q.inv.hom))
    exact uniform_bound_coefficientIso e (hfinite ⟨⊥, inferInstance⟩)
  · intro M hM
    obtain ⟨E, A, hA, ⟨eA⟩⟩ := exists_constructible_finiteCoefficient_model X ℓ M hM
    let := PadicAlgCl.normedFieldOfAlgebra ℓ E
    let : NormedAlgebra ℚ_[ℓ] E :=
      { norm_smul_le c x := by
          change ‖algebraMap E (PadicAlgCl ℓ) (c • x)‖ ≤
            ‖c‖ * ‖algebraMap E (PadicAlgCl ℓ) x‖
          rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, norm_mul,
            PadicAlgCl.norm_extends] }
    have hInd := HasIndConstructibleExtBound.of_continuity
      (CondensedRing.hasConstructibleExtContinuity_continuousMapRingObj ℓ E aX) (hfinite E)
    obtain ⟨d, hd⟩ := hInd.exists_eq_zero A hA
    refine ⟨d, ?_⟩
    intro B hB n hn f
    let F := Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl X ℓ E)
    let G := Mod.comap (D := Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (padicSubfieldRingObjToPadicAlgCl X ℓ E)
    have : F.leftDerivedFunctor.Additive :=
      Functor.additive_of_iso F.leftDerivedFunctorIsoMapDerivedCategory.symm
    let adj := Mod.derivedExtendMapDerivedCategoryAdjunction
      (padicSubfieldRingObjToPadicAlgCl X ℓ E)
    let a : F.leftDerivedFunctor.obj ((DerivedCategory.singleFunctor _ 0).obj A) ≅
        (DerivedCategory.singleFunctor _ 0).obj M :=
      (Functor.singleFunctorCompLeftDerivedFunctorIso F).app A ≪≫
        (DerivedCategory.singleFunctor _ 0).mapIso eA
    let b := (G.mapDerivedCategorySingleFunctor n).app B
    let g := adj.homEquiv _ _ (a.hom ≫ f)
    have hg : g ≫ b.hom = 0 :=
      hd (G.obj B) (algClRestriction_indConstructible X ℓ E B hB) n hn (g ≫ b.hom)
    have hg0 : g = 0 := by
      apply (cancel_mono b.hom).mp
      simpa only [zero_comp] using hg
    have hf : a.hom ≫ f = 0 := by
      apply (adj.homEquiv _ _).injective
      simpa only [Adjunction.homAddEquiv_zero] using hg0
    apply (cancel_epi a.hom).mp
    simpa only [comp_zero] using hf

end CategoryTheory
