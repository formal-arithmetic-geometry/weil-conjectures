/-! # Derived tensor with a principal quotient is a multiplication cone

The chosen mixed derived tensor is compared with the two-term free coefficient resolution.
(blueprint: lem-pod-principal-derived-tensor-cone) -/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe u wR wA
open CategoryTheory CategoryTheory.Limits MonoidalCategory
open CategoryTheory.Functor
open scoped ChangeOfRings

namespace DerivedCategory

/-- For a surjection with principal kernel generated by a regular scalar, restriction of
the mixed derived tensor with its quotient ring is the scalar mapping cone.

Proof: choose an ordinary K-flat resolution P of C. The universal mixed-tensor counit
computes the chosen derived tensor on P. Restriction identifies this mixed total tensor
with the ordinary total tensor of P and the restricted quotient in degree zero. Its
single-factor comparison and the K-flat tensor computation identify it with
QP tensor the quotient. Transport QP to QC. The short exact coefficient sequence gives
the final isomorphism with the multiplication cone, via its two-term free resolution.
Source: Stacks Tags 05RT and 06Y6; original blueprint step 11.
(blueprint: lem-pod-principal-derived-tensor-cone) -/
theorem principalDerivedTensorCone {R A : Type u} [CommRing R] [CommRing A]
    [HasDerivedCategory.{wR} (ModuleCat.{u} R)]
    [HasDerivedCategory.{wA} (ModuleCat.{u} A)]
    (f : R →+* A) (t : R) (ht : Function.Injective (fun x : R ↦ t * x))
    (hf : Function.Surjective f) (hk : ∀ x : R, f x = 0 ↔ ∃ y : R, t * y = x)
    (C : CochainComplex (ModuleCat.{u} R) ℤ) :
    let N := (HomologicalComplex.single (ModuleCat.{u} A) (.up ℤ) 0).obj
      (ModuleCat.of A A)
    let L := ((exists_derivedTensor_second_factor_functor f).2.choose).obj N
    Nonempty (((ModuleCat.restrictScalars f).mapDerivedCategory).obj
      (L.obj (Q.obj C)) ≅ Q.obj (CochainComplex.mappingCone (t • 𝟙 C))) := by
  dsimp only
  let N := (HomologicalComplex.single (ModuleCat.{u} A) (.up ℤ) 0).obj
    (ModuleCat.of A A)
  let L := ((exists_derivedTensor_second_factor_functor f).2.choose).obj N
  let εL := (exists_derivedTensor_second_factor_functor f).2.choose_spec.choose N
  have : L.IsLeftDerivedFunctor εL
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (.up ℤ)) :=
    (exists_derivedTensor_second_factor_functor f).2.choose_spec.choose_spec.1 N
  let LP := (exists_mixedTensor_pointwise_leftDerived f N).choose
  let εP := (exists_mixedTensor_pointwise_leftDerived f N).choose_spec.choose
  have : LP.IsLeftDerivedFunctor εP
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (.up ℤ)) :=
    (exists_mixedTensor_pointwise_leftDerived f N).choose_spec.choose_spec.1
  let Λ := (Classical.choice (inferInstance :
    Abelian.HasFunctorialFlatResolution (ModuleCat.{u} R))).reduced
  let P := Λ.resolutionFunctor.obj C
  let p := Λ.resolutionNatTrans.app C
  have hp : QuasiIso p := inferInstance
  have hP := Λ.kFlat_resolutionFunctor_obj ObjectProperty.flat.essImage_ι_le C
  have : IsIso (εP.app P) :=
    (exists_mixedTensor_pointwise_leftDerived f N).choose_spec.choose_spec.2.2 P hP
  let S := (ModuleCat.restrictScalars f).mapHomologicalComplex (.up ℤ)
  let SD := (ModuleCat.restrictScalars f).mapDerivedCategory
  let B := (ModuleCat.mixedTensor f).flip.map₂CochainComplex
  let M := (ModuleCat.restrictScalars f).obj (ModuleCat.of A A)
  let eL := (L.mapIso (asIso (Q.map p))).symm ≪≫
    (Functor.leftDerivedUnique LP L εL εP
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (.up ℤ))).app (Q.obj P) ≪≫
    asIso (εP.app P)
  let eR : S.obj ((B.obj P).obj N) ≅ P ⊗ S.obj N :=
    (((CochainComplex.exists_mixedTensor_restriction_iso f).some).app P).app N
  let eS : S.obj N ≅ (HomologicalComplex.single _ (.up ℤ) 0).obj M :=
    ((ModuleCat.restrictScalars f).mapCochainComplexSingleFunctor 0).app (ModuleCat.of A A)
  let eT : P ⊗ (HomologicalComplex.single _ (.up ℤ) 0).obj M ≅
      ((tensorRight M).mapHomologicalComplex (.up ℤ)).obj P :=
    CochainComplex.mapBifunctorSingle₂Iso (curriedTensor (ModuleCat.{u} R)) M P
  let q : 𝟙_ (ModuleCat.{u} R) ⟶ M := ModuleCat.ofHom (Y := M)
    { toFun := f
      map_add' := f.map_add
      map_smul' := by intro a b; exact f.map_mul a b }
  have hz : (t • 𝟙 (𝟙_ (ModuleCat.{u} R))) ≫ q = 0 := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change f (t * x) = 0
    exact (hk _).2 ⟨x, rfl⟩
  have hs : (ShortComplex.mk (t • 𝟙 (𝟙_ (ModuleCat.{u} R))) q hz).ShortExact := by
    refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
    · apply (ShortComplex.moduleCat_exact_iff _).2
      intro x hx
      exact (hk x).1 hx
    · exact (ModuleCat.mono_iff_injective _).2 ht
    · exact (ModuleCat.epi_iff_surjective _).2 hf
  let d := scalarConeDesc hz
  have hd : QuasiIso d :=
    CochainComplex.mappingCone.quasiIso_descShortComplex
      (hs.map_of_exact (HomologicalComplex.single (ModuleCat.{u} R) (.up ℤ) 0))
  have hμ : IsIso (Functor.LaxMonoidal.μ
      (Q : CochainComplex (ModuleCat.{u} R) ℤ ⥤ _) C (scalarCone t)) := by
    have := DerivedMonoidal.isIso_counit_app_app_of_kFlat_right Qh
      (HomotopyCategory.quasiIso (ModuleCat.{u} R) (.up ℤ))
      ((HomotopyCategory.quotient _ _).obj C) _ (kFlat_scalarCone t)
    have h : IsIso (Functor.LaxMonoidal.μ Qh
        ((HomotopyCategory.quotient _ _).obj C)
        ((HomotopyCategory.quotient _ _).obj (scalarCone t))) := this
    change IsIso ((_ ⊗ₘ _) ≫ (Functor.LaxMonoidal.μ Qh _ _ ≫ Qh.map _) ≫ _)
    infer_instance
  let red : Q.obj C ⊗ (singleFunctor (ModuleCat.{u} R) 0).obj M ≅
      Q.obj (CochainComplex.mappingCone (t • 𝟙 C)) :=
    whiskerLeftIso (Q.obj C) ((singleFunctorIsoCompQ _ 0).app M) ≪≫
      whiskerLeftIso (Q.obj C) (asIso (Q.map d)).symm ≪≫
      asIso (Functor.LaxMonoidal.μ Q C (scalarCone t)) ≪≫
      Q.mapIso (tensorScalarConeIso' C t)
  exact ⟨SD.mapIso eL ≪≫
    (ModuleCat.restrictScalars f).mapDerivedCategoryFactors.app ((B.obj P).obj N) ≪≫
    Q.mapIso eR ≪≫ Q.mapIso (whiskerLeftIso P eS) ≪≫ Q.mapIso eT ≪≫
    (QObjTensorSingleFunctorObjIso P hP M).symm ≪≫
    whiskerRightIso (asIso (Q.map p)) _ ≪≫ red⟩

end DerivedCategory
