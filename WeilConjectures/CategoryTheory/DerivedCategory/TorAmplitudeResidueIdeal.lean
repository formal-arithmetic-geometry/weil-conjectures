module

public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.CategoryTheory.Preadditive.Biproducts
public import WeilConjectures.CategoryTheory.DerivedCategory.TorAmplitudeResidue

/-!
# Tor amplitude is tested on the residue ring of a nilpotent ideal

Let `C` be a closed braided monoidal Grothendieck abelian category with functorial flat
resolutions, linear over a commutative ring `R` compatibly with the tensor product, and let `I`
be a finitely generated nilpotent ideal of `R`. Let `κ` be an object killed by `I` such that
`κ ⊗ F ≅ F` for every object `F` killed by `I` (for sheaves of `R`-modules, the constant sheaf
`R / I`), and assume that tensoring with an object killed by `I` preserves monomorphisms between
objects killed by `I` (for sheaves of `R`-modules: every `R / I`-module is semisimple).

Then an object `K` of `D(C)` has Tor amplitude in `[a, b]` exactly when `K ⊗ᴸ κ` has homology
concentrated in `[a, b]`
(`DerivedCategory.torAmplitudeIn_iff_tensorSingleConcentratedIn_of_ideal`).

This generalises `DerivedCategory.torAmplitudeIn_iff_homologyConcentratedIn_tensor_singleFunctor`,
in which `I` is principal, to the Jacobson radical of an arbitrary finite ring, which need not be
principal. The proof is the same: for `F` killed by `I`, represent `K` by a K-flat complex `P`;
then `K ⊗ᴸ F` is `(P ⊗ κ) ⊗ F`, and `- ⊗ F` preserves the exactness of the complex `P ⊗ κ` of
objects killed by `I`. A general `F` is killed by a power `Iᵐ` and has the finite filtration by
the `Iˢ F`, whose graded pieces are killed by `I`
(`CategoryTheory.exists_shortExact_of_smul_eq_zero_of_mem_pow_succ`).
-/

@[expose] public section

open CategoryTheory Limits MonoidalCategory

universe v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] [Abelian C] {R : Type*} [CommRing R] [Linear R C]

/-- The elements of `R` acting by zero on an object form an ideal: if the generators of an
ideal act by zero, so does every element of the ideal. -/
lemma smul_id_eq_zero_of_mem_span {ι : Type*} (r : ι → R) {X : C} (h : ∀ i, r i • 𝟙 X = 0)
    {x : R} (hx : x ∈ Ideal.span (Set.range r)) : x • 𝟙 X = 0 := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    exact h i
  | zero => exact zero_smul _ _
  | add y z _ _ hy hz => rw [add_smul, hy, hz, add_zero]
  | smul s y _ hy => rw [smul_eq_mul, mul_smul, hy, smul_zero]

/-- The image of a morphism into an object killed by an ideal `I` is killed by `I`. -/
lemma smul_id_image_eq_zero_of_ideal (I : Ideal R) {X Y : C} (g : X ⟶ Y)
    (hY : ∀ x ∈ I, x • 𝟙 Y = 0) : ∀ x ∈ I, x • 𝟙 (image g) = 0 :=
  fun x hx ↦ smul_id_image_eq_zero x g (hY x hx)

/-- **The filtration of an object killed by a power of an ideal.** Let `I` be the ideal
generated by a finite family `r`. An object `F` killed by `Iᵐ⁺¹` is an extension of an object
killed by `I` (the quotient `F / I F`) by an object killed by `Iᵐ` (the image `I F` of the
map `⨁ᵢ F ⟶ F` given by the `rᵢ`). -/
lemma exists_shortExact_of_smul_eq_zero_of_mem_pow_succ {ι : Type*} [Finite ι] (r : ι → R)
    {m : ℕ} {F : C} (hF : ∀ x ∈ Ideal.span (Set.range r) ^ (m + 1), x • 𝟙 F = 0) :
    ∃ (S : ShortComplex C) (_ : S.ShortExact) (_ : S.X₂ = F),
      (∀ x ∈ Ideal.span (Set.range r) ^ m, x • 𝟙 S.X₁ = 0) ∧
        ∀ x ∈ Ideal.span (Set.range r), x • 𝟙 S.X₃ = 0 := by
  have := Fintype.ofFinite ι
  have : HasFiniteBiproducts C := Abelian.hasFiniteBiproducts
  let φ : (⨁ fun _ : ι ↦ F) ⟶ F := biproduct.desc fun i ↦ r i • 𝟙 F
  refine ⟨ShortComplex.mk (image.ι φ) (cokernel.π (image.ι φ)) (cokernel.condition _),
    { exact := ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel _) }, rfl,
    fun x hx ↦ ?_, fun x hx ↦ smul_id_eq_zero_of_mem_span r (fun i ↦ ?_) hx⟩
  · have h : x • φ = 0 := by
      refine biproduct.hom_ext' _ _ fun i ↦ ?_
      rw [Linear.comp_smul, biproduct.ι_desc, comp_zero, smul_smul]
      exact hF _ (by
        rw [pow_succ]
        exact Ideal.mul_mem_mul hx (Ideal.subset_span ⟨i, rfl⟩))
    refine (cancel_mono (image.ι φ)).1 ((cancel_epi (factorThruImage φ)).1 ?_)
    rw [zero_comp, comp_zero, Linear.smul_comp, Category.id_comp, Linear.comp_smul, image.fac, h]
  · change r i • 𝟙 (cokernel (image.ι φ)) = 0
    refine (cancel_epi (cokernel.π (image.ι φ))).1 ?_
    have : r i • 𝟙 F = biproduct.ι (fun _ : ι ↦ F) i ≫ factorThruImage φ ≫ image.ι φ := by
      rw [image.fac, biproduct.ι_desc]
    rw [comp_zero, Linear.comp_smul, Category.comp_id, ← Category.id_comp (cokernel.π _),
      ← Linear.smul_comp, this, Category.assoc, Category.assoc, cokernel.condition, comp_zero,
      comp_zero]

variable [MonoidalCategory C] [BraidedCategory C] [MonoidalClosed C] [MonoidalPreadditive C]

/-- **Exactness of `- ⊗ F` on objects killed by an ideal.** Let `F` be killed by `I`, and assume
that `- ⊗ F` preserves monomorphisms between objects killed by `I`. Then `- ⊗ F` preserves the
exactness of a short complex `S` whose last object is killed by `I`. -/
lemma ShortComplex.Exact.map_tensorRight_of_ideal (I : Ideal R) {F : C}
    (hmono : ∀ {X Y : C} (f : X ⟶ Y) [Mono f], (∀ x ∈ I, x • 𝟙 X = 0) →
      (∀ x ∈ I, x • 𝟙 Y = 0) → Mono (f ▷ F))
    {S : ShortComplex C} (hS : S.Exact) (h₃ : ∀ x ∈ I, x • 𝟙 S.X₃ = 0) :
    (S.map (tensorRight F)).Exact := by
  have := preservesFiniteColimits_tensorRight F
  let S' : ShortComplex C := ShortComplex.mk S.f (factorThruImage S.g)
    ((cancel_mono (image.ι S.g)).1 (by simp))
  let φ : S' ⟶ S := { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := image.ι S.g }
  have hS' : S'.Exact := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 hS
  have hS'F : (S'.map (tensorRight F)).Exact :=
    hS'.map_of_epi_of_preservesCokernel _ (inferInstanceAs (Epi (factorThruImage S.g)))
      inferInstance
  let ψ := (tensorRight F).mapShortComplex.map φ
  have : IsIso ψ.τ₁ := inferInstanceAs (IsIso ((tensorRight F).map (𝟙 _)))
  have : IsIso ψ.τ₂ := inferInstanceAs (IsIso ((tensorRight F).map (𝟙 _)))
  have : Mono ψ.τ₃ := hmono (image.ι S.g) (smul_id_image_eq_zero_of_ideal I S.g h₃) h₃
  exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ).1 hS'F

/-- **Exactness of `- ⊗ F` on complexes of objects killed by an ideal.** In the situation of
`CategoryTheory.ShortComplex.Exact.map_tensorRight_of_ideal`, tensoring with `F` preserves the
exactness in a given degree of a complex of objects killed by `I`. -/
lemma HomologicalComplex.ExactAt.map_tensorRight_of_ideal (I : Ideal R) {F : C}
    (hmono : ∀ {X Y : C} (f : X ⟶ Y) [Mono f], (∀ x ∈ I, x • 𝟙 X = 0) →
      (∀ x ∈ I, x • 𝟙 Y = 0) → Mono (f ▷ F))
    {P : CochainComplex C ℤ} (hP : ∀ n, ∀ x ∈ I, x • 𝟙 (P.X n) = 0) {i : ℤ} (h : P.ExactAt i) :
    (((tensorRight F).mapHomologicalComplex _).obj P).ExactAt i :=
  ShortComplex.Exact.map_tensorRight_of_ideal I hmono h (hP _)

end CategoryTheory

namespace DerivedCategory

open CategoryTheory

section TensorSingle

variable (C : Type u) [Category.{v} C] [Abelian C] [MonoidalCategory C] [BraidedCategory C]
  [MonoidalClosed C] [MonoidalPreadditive C] [IsGrothendieckAbelian.{v} C]
  [HasDerivedCategory.{v} C] [Abelian.HasFunctorialFlatResolution C]

/-- The object `K ⊗ᴸ F[0]` has homology concentrated in `[a, b]`: the condition defining Tor
amplitude in `[a, b]` (`DerivedCategory.torAmplitudeIn`), for a single test object `F`.

Stating results through this predicate rather than through `K ⊗ᴸ F[0]` keeps the monoidal
structure on `D(C)` the one of `DerivedCategory.torAmplitudeIn` after specialisation. -/
def TensorSingleConcentratedIn (a b : ℤ) (K : DerivedCategory C) (F : C) : Prop :=
  homologyConcentratedIn a b (K ⊗ (singleFunctor C 0).obj F)

lemma torAmplitudeIn_iff_forall_tensorSingleConcentratedIn (a b : ℤ) (K : DerivedCategory C) :
    torAmplitudeIn C a b K ↔ ∀ F : C, TensorSingleConcentratedIn C a b K F :=
  Iff.rfl


end TensorSingle

variable {C : Type u} [Category.{v} C] [Abelian C] [MonoidalCategory C] [BraidedCategory C]
  [MonoidalClosed C] [MonoidalPreadditive C]
  {R : Type*} [CommRing R] [Linear R C] [MonoidalLinear R C]
  [IsGrothendieckAbelian.{v} C] [HasDerivedCategory.{v} C]
  [Abelian.HasFunctorialFlatResolution C]

/-- **The residue test for objects killed by an ideal.** Let `κ` and `F` be killed by `I`, with
`κ ⊗ F ≅ F`, and assume that tensoring with `F` preserves monomorphisms between objects killed
by `I`. If `K ⊗ᴸ κ` has homology concentrated in `[a, b]`, so has `K ⊗ᴸ F`. -/
lemma homologyConcentratedIn_tensor_singleFunctor_of_ideal (I : Ideal R) {κ F : C}
    (hκ : ∀ x ∈ I, x • 𝟙 κ = 0) (e : κ ⊗ F ≅ F)
    (hmono : ∀ {X Y : C} (f : X ⟶ Y) [Mono f], (∀ x ∈ I, x • 𝟙 X = 0) →
      (∀ x ∈ I, x • 𝟙 Y = 0) → Mono (f ▷ F))
    {a b : ℤ} {K : DerivedCategory C}
    (hK : homologyConcentratedIn a b (K ⊗ (singleFunctor C 0).obj κ)) :
    homologyConcentratedIn a b (K ⊗ (singleFunctor C 0).obj F) := by
  obtain ⟨P, π, hπ, -, hP⟩ := CochainComplex.exists_quasiIso_flat_kFlat (Q.objPreimage K)
  let eP : Q.obj P ≅ K := asIso (Q.map π) ≪≫ Q.objObjPreimageIso K
  let Pκ := ((tensorRight κ).mapHomologicalComplex (.up ℤ)).obj P
  have hPκ : ∀ n, ∀ x ∈ I, x • 𝟙 (Pκ.X n) = 0 := fun n x hx ↦ by
    change x • 𝟙 (P.X n ⊗ κ) = 0
    rw [← MonoidalCategory.whiskerLeft_id, ← MonoidalLinear.whiskerLeft_smul, hκ x hx,
      MonoidalPreadditive.whiskerLeft_zero]
  have h₁ : homologyConcentratedIn a b (Q.obj Pκ) :=
    (homologyConcentratedIn a b).prop_of_iso
      (whiskerRightIso eP.symm _ ≪≫ QObjTensorSingleFunctorObjIso P hP κ) hK
  rw [homologyConcentratedIn_iff, ← DerivedCategory.IsGE, ← DerivedCategory.IsLE,
    isGE_Q_obj_iff, isLE_Q_obj_iff, CochainComplex.isGE_iff, CochainComplex.isLE_iff] at h₁
  let e' : ((tensorRight κ).mapHomologicalComplex (.up ℤ) ⋙
      (tensorRight F).mapHomologicalComplex (.up ℤ)).obj P ≅
      ((tensorRight F).mapHomologicalComplex (.up ℤ)).obj P :=
    (Functor.mapHomologicalComplexCompIso (NatIso.ofComponents (F := tensorRight κ ⋙ tensorRight F)
      (G := tensorRight F)
      (fun X ↦ α_ X κ F ≪≫ whiskerLeftIso X e) (fun f ↦ by simp [whisker_exchange])) _).app P
  refine (homologyConcentratedIn a b).prop_of_iso
    (Q.mapIso e' ≪≫ (QObjTensorSingleFunctorObjIso P hP F).symm ≪≫ whiskerRightIso eP _) ?_
  let G := ((tensorRight F).mapHomologicalComplex (.up ℤ)).obj Pκ
  have : CochainComplex.IsGE G a := (CochainComplex.isGE_iff G a).2 fun i hi ↦
    HomologicalComplex.ExactAt.map_tensorRight_of_ideal I hmono hPκ (h₁.1 i hi)
  have : CochainComplex.IsLE G b := (CochainComplex.isLE_iff G b).2 fun i hi ↦
    HomologicalComplex.ExactAt.map_tensorRight_of_ideal I hmono hPκ (h₁.2 i hi)
  exact ⟨inferInstanceAs ((Q.obj G).IsGE a), inferInstanceAs ((Q.obj G).IsLE b)⟩

/-- **The residue test for a nilpotent ideal.** Let `I` be a nilpotent ideal of `R` generated by
a finite family `r`, let `κ` be killed by `I` with `κ ⊗ F ≅ F` for every `F` killed by `I`, and
assume that tensoring with an object killed by `I` preserves monomorphisms between objects killed
by `I`. Then `K ∈ D(C)` has Tor amplitude in `[a, b]` if and only if `K ⊗ᴸ κ` has homology
concentrated in `[a, b]`.

One direction is the definition of Tor amplitude. Conversely, for `F` killed by `I` this is
`DerivedCategory.homologyConcentratedIn_tensor_singleFunctor_of_ideal`; a general `F` is killed
by `Iⁿ = 0`, and the short exact sequences `0 ⟶ I F ⟶ F ⟶ F / I F ⟶ 0`
(`CategoryTheory.exists_shortExact_of_smul_eq_zero_of_mem_pow_succ`) give distinguished triangles
whose outer terms, after tensoring with `K`, have homology in `[a, b]` by induction. -/
theorem torAmplitudeIn_iff_tensorSingleConcentratedIn_of_ideal {ι : Type*}
    [Finite ι] (r : ι → R) {n : ℕ} (hn : Ideal.span (Set.range r) ^ n = ⊥) {κ : C}
    (hκ : ∀ x ∈ Ideal.span (Set.range r), x • 𝟙 κ = 0)
    (eκ : ∀ F : C, (∀ x ∈ Ideal.span (Set.range r), x • 𝟙 F = 0) → Nonempty (κ ⊗ F ≅ F))
    (hmono : ∀ F : C, (∀ x ∈ Ideal.span (Set.range r), x • 𝟙 F = 0) → ∀ {X Y : C} (f : X ⟶ Y)
      [Mono f], (∀ x ∈ Ideal.span (Set.range r), x • 𝟙 X = 0) →
        (∀ x ∈ Ideal.span (Set.range r), x • 𝟙 Y = 0) → Mono (f ▷ F))
    (a b : ℤ) (K : DerivedCategory C) :
    torAmplitudeIn C a b K ↔ TensorSingleConcentratedIn C a b K κ := by
  refine ⟨fun hK ↦ hK κ, fun hK F ↦ ?_⟩
  change homologyConcentratedIn a b (K ⊗ (singleFunctor C 0).obj κ) at hK
  have key : ∀ (m : ℕ) (F : C), (∀ x ∈ Ideal.span (Set.range r) ^ m, x • 𝟙 F = 0) →
      homologyConcentratedIn a b (K ⊗ (singleFunctor C 0).obj F) := by
    intro m
    induction m with
    | zero =>
      intro F hF
      have hF' : 𝟙 F = 0 := by
        rw [← one_smul R (𝟙 F)]
        exact hF 1 (by simp)
      have hZ : IsZero (K ⊗ (singleFunctor C 0).obj F) :=
        MonoidalCategory.isZero_tensorObj_of_isZero_right K
          ((singleFunctor C 0).map_isZero ((IsZero.iff_id_eq_zero F).2 hF'))
      exact ⟨TStructure.t.isGE_of_isZero hZ a, TStructure.t.isLE_of_isZero hZ b⟩
    | succ m ih =>
      intro F hF
      obtain ⟨S, hS, rfl, h₁, h₃⟩ := exists_shortExact_of_smul_eq_zero_of_mem_pow_succ r hF
      have hT := ((curriedTensor (DerivedCategory C)).obj K).map_distinguished _
        hS.singleTriangle_distinguished
      have hT₁ := ih _ h₁
      obtain ⟨e⟩ := eκ _ h₃
      have hT₃ := homologyConcentratedIn_tensor_singleFunctor_of_ideal _ hκ e (hmono _ h₃) hK
      exact ⟨TStructure.t.isGE₂ _ hT a hT₁.1 hT₃.1, TStructure.t.isLE₂ _ hT b hT₁.2 hT₃.2⟩
  exact key n F (by
    intro x hx
    rw [hn, Ideal.mem_bot] at hx
    rw [hx, zero_smul])

end DerivedCategory
