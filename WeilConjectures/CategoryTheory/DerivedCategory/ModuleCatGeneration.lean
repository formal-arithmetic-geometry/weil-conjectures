public import Mathlib.Algebra.Category.ModuleCat.AB
public import Mathlib.Algebra.Category.ModuleCat.Projective
public import Mathlib.Algebra.Homology.DerivedCategory.ShortExact
public import Mathlib.CategoryTheory.Abelian.Projective.Extend
public import Mathlib.CategoryTheory.Abelian.Projective.Resolution
public import WeilConjectures.CategoryTheory.DerivedCategory.Coproducts
public import WeilConjectures.CategoryTheory.DerivedCategory.ModuleCatTelescope
public import WeilConjectures.CategoryTheory.GrothendieckAbelian.KInjectiveResolution
public import WeilConjectures.Mathlib.CategoryTheory.Triangulated.Functor
public import WeilConjectures.Mathlib.CategoryTheory.Triangulated.Generators

/-!
# The derived category of a ring is generated by the ring

Let `R` be a commutative ring and `τ : F ⟶ G` a natural transformation, compatible with the
shifts, between triangulated functors `D(R) ⥤ T` which preserve coproducts. If `τ` is an
isomorphism at `R[0]`, then it is an isomorphism
(`DerivedCategory.isIso_of_isIso_app_singleFunctor_obj_self`). In other words, `R[0]` generates
`D(R)` as a localizing subcategory.

The class of objects `K` such that `τ.app K` is an isomorphism is closed under isomorphisms,
shifts, extensions (two out of three in distinguished triangles), coproducts and retracts.
Hence it contains:

1. the free modules `(⨁ R)[0]` and their retracts, the projective modules `P[0]`;
2. the bounded complexes all of whose terms `M` satisfy the property for `M[0]`, by induction
   along the stupid truncations `σ^{≥ a}`, which give short exact sequences of complexes
   `0 ⟶ σ^{≥ a + 1} L ⟶ σ^{≥ a} L ⟶ Lᵃ[-a] ⟶ 0`;
3. the complexes `L` which are the union of an increasing sequence of subcomplexes `Lₙ` in the
   class, thanks to the telescope short exact sequence `0 ⟶ ∐ Lₙ ⟶ ∐ Lₙ ⟶ L ⟶ 0`;
4. every module `M[0]`, as `M` is quasi-isomorphic to a projective resolution, which is the
   union of its stupid truncations, bounded complexes of projective modules;
5. every complex `L`, which is the union of the bounded subcomplexes `σ^{≥ -m} τ^{≤ m} L`.

## Main statements

- `CategoryTheory.NatTrans.isIso_app_of_isColimit_cofan`: closure under coproducts. Closure
  under shifts and retracts is in `WeilConjectures.Mathlib.CategoryTheory.Triangulated.Generators`.
- `DerivedCategory.isIso_app_Q_obj_of_isStrictlyGE_of_isStrictlyLE`: bounded complexes.
- `DerivedCategory.isIso_app_Q_obj_of_telescope`: telescopes.
- `DerivedCategory.isIso_of_isIso_app_singleFunctor_obj_self`: the main theorem.
-/

@[expose] public section

universe w v

open CategoryTheory Category Limits Pretriangulated

namespace CategoryTheory.NatTrans

variable {C D : Type*} [Category* C] [Category* D] {F G : C ⥤ D} (τ : F ⟶ G)

/-- If `F` and `G` preserve a coproduct and a natural transformation `τ : F ⟶ G` is an
isomorphism at the summands, it is an isomorphism at the coproduct. -/
lemma isIso_app_of_isColimit_cofan {J : Type*} {X : J → C} {c : Cofan X} (hc : IsColimit c)
    [PreservesColimit (Discrete.functor X) F] [PreservesColimit (Discrete.functor X) G]
    (h : ∀ j, IsIso (τ.app (X j))) : IsIso (τ.app c.pt) := by
  let hF := isColimitOfPreserves F hc
  let hG := isColimitOfPreserves G hc
  have : τ.app c.pt = (IsColimit.coconePointsIsoOfNatIso hF hG
      (Discrete.natIso fun j ↦ asIso (τ.app (X j.as)))).hom := hF.hom_ext fun j ↦ by
    rw [IsColimit.comp_coconePointsIsoOfNatIso_hom]
    simp
  rw [this]
  infer_instance

end CategoryTheory.NatTrans

namespace DerivedCategory

open CochainComplex

variable {R : Type v} [CommRing R] [HasDerivedCategory.{w} (ModuleCat.{v} R)]
  {T : Type*} [Category* T] {F G : DerivedCategory (ModuleCat.{v} R) ⥤ T} (τ : F ⟶ G)

/-- If `τ` is an isomorphism at `R[0]` and `F`, `G` preserve coproducts, then `τ` is an
isomorphism at `P[0]` for every projective module `P`, a retract of the free module
`⨁_{p ∈ P} R`. -/
lemma isIso_app_singleFunctor_obj_of_projective
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
    (h : IsIso (τ.app ((singleFunctor _ 0).obj (ModuleCat.of R R))))
    (P : ModuleCat.{v} R) [Projective P] :
    IsIso (τ.app ((singleFunctor _ 0).obj P)) := by
  classical
  let Z : P → ModuleCat.{v} R := fun _ ↦ ModuleCat.of R R
  let e : (ModuleCat.coproductCocone Z).pt ⟶ P :=
    ModuleCat.ofHom (DirectSum.toModule R P P fun p ↦ LinearMap.toSpanSingleton R P p)
  have : Epi e := (ModuleCat.epi_iff_surjective _).2 fun p ↦
    ⟨DirectSum.lof R P (fun p ↦ Z p) p (1 : R),
      (DirectSum.toModule_lof R (M := fun _ : P ↦ R) p (1 : R)).trans (one_smul R p)⟩
  have : IsIso (τ.app ((singleFunctor _ 0).obj (ModuleCat.coproductCocone Z).pt)) :=
    NatTrans.isIso_app_of_isColimit_cofan τ (isColimitCofanMkQObj
      (isColimitCofanMkObjOfIsColimit (HomologicalComplex.single _ (.up ℤ) 0) _ _
        (ModuleCat.coproductCoconeIsColimit Z))) fun _ ↦ h
  exact NatTrans.isIso_app_of_retract τ
    (Retract.map ⟨Projective.factorThru (𝟙 P) e, e, Projective.factorThru_comp _ _⟩
      (singleFunctor _ 0))

variable [HasShift T ℤ] [F.CommShift ℤ] [G.CommShift ℤ] [NatTrans.CommShift τ ℤ]

/-- If `τ` is an isomorphism at a module placed in degree `0`, then it is an isomorphism at this
module placed in any degree. -/
lemma isIso_app_singleFunctor_obj_of_isIso (M : ModuleCat.{v} R)
    (h : IsIso (τ.app ((singleFunctor _ 0).obj M))) (n : ℤ) :
    IsIso (τ.app ((singleFunctor _ n).obj M)) := by
  rw [← NatTrans.isIso_app_iff_of_iso τ
    (((singleFunctors (ModuleCat.{v} R)).shiftIso (-n) n 0 (by lia)).app M)]
  exact (NatTrans.isIso_app_shift_iff τ _ _).2 h

variable [Preadditive T] [HasZeroObject T] [∀ n : ℤ, (CategoryTheory.shiftFunctor T n).Additive]
  [Pretriangulated T] [F.IsTriangulated] [G.IsTriangulated]

/-- If `τ` is an isomorphism at all the terms `Lⁱ[0]` of a bounded complex `L`, then it is an
isomorphism at `L`. The proof is by induction along the stupid truncations of `L`. -/
lemma isIso_app_Q_obj_of_isStrictlyGE_of_isStrictlyLE (L : CochainComplex (ModuleCat.{v} R) ℤ)
    (a b : ℤ) [L.IsStrictlyGE a] [L.IsStrictlyLE b]
    (hL : ∀ i, IsIso (τ.app ((singleFunctor _ 0).obj (L.X i)))) : IsIso (τ.app (Q.obj L)) := by
  have key (n : ℕ) :
      IsIso (τ.app (Q.obj (subcomplex (stupidTruncGEFamily L (b + 1 - n))))) := by
    induction n with
    | zero =>
      have hZ : IsZero (Q.obj (subcomplex (stupidTruncGEFamily L (b + 1 - (0 : ℕ))))) :=
        Q.map_isZero (isZero_of_isStrictlyGE_of_isStrictlyLE _ (b + 1 - (0 : ℕ)) b (by lia))
      exact ⟨⟨0, (F.map_isZero hZ).eq_of_src _ _, (G.map_isZero hZ).eq_of_src _ _⟩⟩
    | succ n ih =>
      rw [show b + 1 - ((n + 1 : ℕ) : ℤ) = b - n by lia]
      rw [show b + 1 - (n : ℤ) = b - n + 1 by lia] at ih
      exact NatTrans.isIso_app_obj₂_of_isIso_app_obj₁₃ τ
        (triangleOfSES_distinguished (stupidTruncShortComplex_shortExact (L := L) (b - n))) ih
        (isIso_app_singleFunctor_obj_of_isIso τ _ (hL _) _)
  have : L.IsStrictlyGE (b + 1 - (b + 1 - a).toNat) :=
    isStrictlyGE_of_ge L _ a (by lia)
  rw [← NatTrans.isIso_app_iff_of_iso τ
    (Q.mapIso (asIso (subcomplexι (stupidTruncGEFamily L (b + 1 - (b + 1 - a).toNat)))))]
  exact key _

/-- If a complex `L` is the union of an increasing sequence of subcomplexes `N n` at which `τ`
is an isomorphism, then `τ` is an isomorphism at `L`: this follows from the telescope short
exact sequence `0 ⟶ ∐ₙ N n ⟶ ∐ₙ N n ⟶ L ⟶ 0`. -/
lemma isIso_app_Q_obj_of_telescope [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
    {L : CochainComplex (ModuleCat.{v} R) ℤ} (N : ℕ → L.SubcomplexFamily)
    (hN : ∀ n, N n ≤ N (n + 1)) (hL : ∀ i (x : L.X i), ∃ n, x ∈ (N n).N i)
    (h : ∀ n, IsIso (τ.app (Q.obj (subcomplex (N n))))) :
    IsIso (τ.app (Q.obj L)) := by
  have : PreservesColimitsOfShape (Discrete ℕ) F :=
    preservesColimitsOfShape_of_equiv (Discrete.equivalence Equiv.ulift) F
  have : PreservesColimitsOfShape (Discrete ℕ) G :=
    preservesColimitsOfShape_of_equiv (Discrete.equivalence Equiv.ulift) G
  have h₁ : IsIso (τ.app (Q.obj (∐ fun n ↦ subcomplex (N n)))) :=
    NatTrans.isIso_app_of_isColimit_cofan τ (isColimitCofanMkQObj (coproductIsCoproduct _)) h
  exact NatTrans.isIso_app_obj₃_of_isIso_app_obj₁₂ τ
    (triangleOfSES_distinguished (telescopeShortComplex_shortExact N hN hL)) h₁ h₁

/-- If `τ` is an isomorphism at `R[0]`, it is an isomorphism at `M[0]` for every module `M`:
a projective resolution of `M` is the union of its stupid truncations, which are bounded
complexes of projective modules. -/
lemma isIso_app_singleFunctor_obj [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
    (h : IsIso (τ.app ((singleFunctor _ 0).obj (ModuleCat.of R R)))) (M : ModuleCat.{v} R) :
    IsIso (τ.app ((singleFunctor _ 0).obj M)) := by
  let P := (projectiveResolution M).cochainComplex
  have hP : IsIso (τ.app (Q.obj P)) :=
    isIso_app_Q_obj_of_telescope τ (fun m ↦ stupidTruncGEFamily P (-m))
      (fun m ↦ stupidTruncGEFamily_le_of_le (by lia))
      (fun i x ↦ ⟨(-i).toNat, (mem_stupidTruncGEFamily_iff x).2 (Or.inl (by lia))⟩)
      fun m ↦ isIso_app_Q_obj_of_isStrictlyGE_of_isStrictlyLE τ _ (-m) 0
        fun i ↦ isIso_app_singleFunctor_obj_of_projective τ h _
  exact (NatTrans.isIso_app_iff_of_iso τ (asIso (Q.map (projectiveResolution M).π'))).1 hP

/-- **`R[0]` generates `D(R)` as a localizing subcategory**: a natural transformation, compatible
with the shifts, between coproduct-preserving triangulated functors out of `D(R)`, which is an
isomorphism at `R[0]`, is an isomorphism. -/
theorem isIso_of_isIso_app_singleFunctor_obj_self
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
    (h : IsIso (τ.app ((singleFunctor _ 0).obj (ModuleCat.of R R)))) :
    IsIso τ := by
  have hL (L : CochainComplex (ModuleCat.{v} R) ℤ) : IsIso (τ.app (Q.obj L)) :=
    isIso_app_Q_obj_of_telescope τ (truncFamily L) truncFamily_le_succ exists_mem_truncFamily
      fun m ↦ isIso_app_Q_obj_of_isStrictlyGE_of_isStrictlyLE τ _ (-m) m
        fun i ↦ isIso_app_singleFunctor_obj τ h _
  rw [NatTrans.isIso_iff_isIso_app]
  intro X
  exact (NatTrans.isIso_app_iff_of_iso τ (Q.objObjPreimageIso X)).1 (hL _)

end DerivedCategory
