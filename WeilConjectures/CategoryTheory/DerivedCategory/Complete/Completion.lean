module

public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.Principal
public import Mathlib.CategoryTheory.Triangulated.Adjunction

/-!
# The derived completion functor

Let `(C, J)` be an essentially small site, `R` a commutative ring and `I = (ϖ)` an ideal
generated by a nonzerodivisor. This file constructs the *derived completion*

```
  K ↦ K^ = R lim_n (K ⊗ᴸ R/Iⁿ),   D(J, R) ⥤ D_comp(J, R),
```

as a left adjoint of the inclusion of the derived complete objects
(`DerivedCategory.derivedComplete`), and shows that it is a triangulated `R`-linear functor.
The unit `K ⟶ K^` is the map to the homotopy limit of the reductions of `K` which appears in
the proof of `DerivedCategory.derivedComplete_of_rightOrthogonal`, whose cone is an object on
which `ϖ` acts invertibly.

Homotopy limits are not functorial in a triangulated category, so the functor is not built by
choosing homotopy limits: it is obtained from the universal property of the unit. For a
triangulated category `C`, a class `S` of objects stable under shifts and a class `P` of
objects right orthogonal to `S`, if every object `K` sits in a distinguished triangle
`K ⟶ F ⟶ X ⟶ K⟦1⟧` with `F ∈ P` and `X ∈ S`, then `K ⟶ F` is a reflection of `K` into `P`
(`CategoryTheory.ObjectProperty.bijective_comp_of_distinguished`), which gives a left adjoint
of the inclusion of `P` (`CategoryTheory.ObjectProperty.reflectorOfDistinguished`).

## Main definitions

- `DerivedCategory.derivedCompletion J I h`: the derived completion functor.
- `DerivedCategory.derivedCompletionAdjunction J I h`: it is left adjoint to the inclusion of
  the derived complete objects.

## Main results

- `DerivedCategory.isIso_derivedCompletion_map`: the derived completion inverts the morphisms
  whose cone is an object on which `ϖ` acts invertibly.
- `DerivedCategory.isIso_derivedCompletionAdjunction_unit_app`: the unit `K ⟶ K^` is an
  isomorphism if (and only if) `K` is derived complete.
-/

@[expose] public section

universe w v u

open CategoryTheory Category Limits Opposite Pretriangulated

namespace CategoryTheory

section Reflector

variable {C : Type*} [Category* C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  (S : ObjectProperty C) [S.IsStableUnderShift ℤ]

namespace ObjectProperty

variable {S} in
/-- Let `K ⟶ F ⟶ X ⟶ K⟦1⟧` be a distinguished triangle with `X` in a class `S` of objects
stable under shifts. Then every object `Y` right orthogonal to `S` sees `K ⟶ F` as an
isomorphism: precomposition `Hom(F, Y) ⟶ Hom(K, Y)` is bijective. -/
lemma bijective_comp_of_distinguished {K F X : C} {φ : K ⟶ F} {g : F ⟶ X}
    {h : X ⟶ K⟦(1 : ℤ)⟧} (hT : Triangle.mk φ g h ∈ distTriang C) (hX : S X) {Y : C}
    (hY : S.rightOrthogonal Y) : Function.Bijective (fun a : F ⟶ Y ↦ φ ≫ a) := by
  refine ⟨fun a b hab ↦ ?_, fun c ↦ ?_⟩
  · rw [← sub_eq_zero]
    obtain ⟨d, hd⟩ := Triangle.yoneda_exact₂ _ hT (a - b) (by
      change φ ≫ (a - b) = 0
      rw [Preadditive.comp_sub]
      exact sub_eq_zero.2 hab)
    simp [hd, hY d hX]
  · obtain ⟨d, hd⟩ := Triangle.yoneda_exact₂ _ (inv_rot_of_distTriang _ hT) c
      (hY _ (S.le_shift (-1) X hX))
    exact ⟨d, hd.symm⟩

variable (P : ObjectProperty C) (hP : ∀ Y, P Y → S.rightOrthogonal Y)
  (h : ∀ K : C, ∃ (F X : C) (φ : K ⟶ F) (g : F ⟶ X) (h : X ⟶ K⟦(1 : ℤ)⟧),
    Triangle.mk φ g h ∈ distTriang C ∧ S X ∧ P F)

/-- The object of `P` attached to an object `K` by `h`. -/
noncomputable def reflectorOfDistinguishedObj (K : C) : P.FullSubcategory :=
  ⟨(h K).choose, (h K).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.2⟩

/-- The morphism `K ⟶ F` of the triangle attached to `K` by `h`. -/
noncomputable def reflectorOfDistinguishedι (K : C) :
    K ⟶ (reflectorOfDistinguishedObj S P h K).obj :=
  (h K).choose_spec.choose_spec.choose

omit [S.IsStableUnderShift ℤ] in
lemma exists_distinguished_reflectorOfDistinguishedι (K : C) :
    ∃ (X : C) (g : (reflectorOfDistinguishedObj S P h K).obj ⟶ X) (h' : X ⟶ K⟦(1 : ℤ)⟧),
      Triangle.mk (reflectorOfDistinguishedι S P h K) g h' ∈ distTriang C ∧ S X := by
  obtain ⟨g, h', hT, hX, -⟩ := (h K).choose_spec.choose_spec.choose_spec
  exact ⟨_, g, h', hT, hX⟩

include hP in
lemma bijective_reflectorOfDistinguishedι (K : C) (Y : P.FullSubcategory) :
    Function.Bijective
      (fun a : (reflectorOfDistinguishedObj S P h K).obj ⟶ Y.obj ↦
        reflectorOfDistinguishedι S P h K ≫ a) := by
  obtain ⟨X, g, h', hT, hX⟩ := exists_distinguished_reflectorOfDistinguishedι S P h K
  exact bijective_comp_of_distinguished hT hX (hP _ Y.property)

/-- The bijection `Hom(F, Y) ≃ Hom(K, Y)` for `Y` in `P`, induced by `K ⟶ F`. -/
noncomputable def reflectorOfDistinguishedEquiv (K : C) (Y : P.FullSubcategory) :
    (reflectorOfDistinguishedObj S P h K ⟶ Y) ≃ (K ⟶ P.ι.obj Y) :=
  InducedCategory.homEquiv.trans
    (Equiv.ofBijective _ (bijective_reflectorOfDistinguishedι S P hP h K Y))

/-- The left adjoint of the inclusion of `P`, when every object `K` sits in a distinguished
triangle `K ⟶ F ⟶ X ⟶ K⟦1⟧` with `F ∈ P` and `X ∈ S`, the objects of `P` being right
orthogonal to `S`. -/
noncomputable def reflectorOfDistinguished : C ⥤ P.FullSubcategory :=
  Adjunction.leftAdjointOfEquiv (reflectorOfDistinguishedEquiv S P hP h)
    (fun _ _ _ _ _ ↦ (assoc _ _ _).symm)

/-- `ObjectProperty.reflectorOfDistinguished` is left adjoint to the inclusion. -/
noncomputable def reflectorOfDistinguishedAdjunction :
    reflectorOfDistinguished S P hP h ⊣ P.ι :=
  Adjunction.adjunctionOfEquivLeft _ _

lemma reflectorOfDistinguishedAdjunction_unit_app (K : C) :
    (reflectorOfDistinguishedAdjunction S P hP h).unit.app K = reflectorOfDistinguishedι S P h K := by
  change reflectorOfDistinguishedι S P h K ≫ 𝟙 _ = _
  rw [comp_id]

end ObjectProperty

end Reflector

section Linear

variable {C D : Type*} [Category* C] [Category* D] [Preadditive C] [Preadditive D]
  (R : Type*) [Semiring R] [Linear R C] [Linear R D] {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G)

include adj in
/-- The left adjoint of an `R`-linear functor between `R`-linear categories is `R`-linear. -/
lemma Adjunction.linear_leftAdjoint [G.Linear R] : F.Linear R where
  map_smul {X Y} f r := (adj.homEquiv X (F.obj Y)).injective (by
    have h := adj.unit.naturality f
    have h' := adj.unit.naturality (r • f)
    dsimp at h h'
    simp only [Adjunction.homEquiv_unit, Functor.map_smul, Linear.comp_smul]
    rw [← h, ← h', Linear.smul_comp])

end Linear

end CategoryTheory

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  (J : GrothendieckTopology C) {R : Type (u + 1)} [CommRing R]

section Triangle

attribute [-instance] commShift₂CurriedTensor commShiftTensorLeft commShiftTensorRight
  isTriangulated_tensorLeft isTriangulated_tensorRight monoidalPreadditive monoidalLinear

open MonoidalCategory

noncomputable local instance (priority := high) :
    MonoidalCategory (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalCategory

noncomputable local instance (priority := high) :
    MonoidalPreadditive (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalPreadditive

noncomputable local instance (priority := high) :
    MonoidalLinear R (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalLinear

noncomputable local instance (priority := high) :
    (curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).CommShift₂Int :=
  (sheafTensorStructure J R).commShift₂

noncomputable local instance (priority := high)
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ((curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).obj K).IsTriangulated :=
  (sheafTensorStructure J R).isTriangulated_tensorLeft K

noncomputable local instance (priority := high)
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ((curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).flip.obj K).IsTriangulated :=
  (sheafTensorStructure J R).isTriangulated_tensorRight K

local instance : IsIso (sheafTensorStructure J R).ε := (sheafTensorStructure J R).isIso_ε

variable {J} {I : Ideal R} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ})

include hϖ hI in
/-- **The completion triangle.** Every object `K` of `D(J, R)` sits in a distinguished triangle
`K ⟶ K^ ⟶ X ⟶ K⟦1⟧` in which `K^` is derived complete for `I = (ϖ)` (it is a homotopy limit
`R lim_n (K ⊗ᴸ R/Iⁿ)`) and `ϖ` acts invertibly on `X`. This is the first half of the proof of
`DerivedCategory.derivedComplete_of_rightOrthogonal`, which does not use the hypothesis made
there on `K`. -/
theorem exists_distinguished_derivedComplete (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ∃ (F X : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) (φ : K ⟶ F) (g : F ⟶ X)
      (h : X ⟶ K⟦(1 : ℤ)⟧), Triangle.mk φ g h ∈ distTriang _ ∧ smulInvertible J ϖ X ∧
        derivedComplete J I F := by
  have hϖI := mem_of_eq_span hI
  let G := derivedCompletionDiagram J I K
  let c := derivedCompletionCone J I K
  let P : Fan fun n : ℕ ↦ G.obj (op n) := Fan.mk _ (Pi.π _)
  have hP : IsLimit P := productIsProduct _
  obtain ⟨F, ι, ε, hT⟩ := distinguished_cocone_triangle₁ (𝟙 P.pt - towerShift hP)
  -- the Milnor triangle of the constant tower `K`
  let c₀ : Cone ((Functor.const ℕᵒᵖ).obj K) := { pt := K, π := 𝟙 _ }
  have : ∀ n, IsIso (c₀.π.app n) := fun n ↦ by dsimp [c₀]; infer_instance
  obtain ⟨PK, hPK, δK, hTK⟩ := IsHomotopyLimit.of_isIso_π c₀
  let m := productTowerMap (PF := PK) hP c.π
  obtain ⟨φ, hφ₁, hφ₃⟩ := complete_distinguished_triangle_morphism₁ _ _ hTK hT m m
    (productTowerMap_comp_sub_towerShift hPK hP c.π).symm
  replace hφ₁ : Fan.IsLimit.lift hPK (fun n ↦ c₀.π.app (op n)) ≫ m = φ ≫ ι := hφ₁
  replace hφ₃ : δK ≫ φ⟦(1 : ℤ)⟧' = m ≫ ε := hφ₃
  -- `F` is right orthogonal to `smulInvertible J ϖ`
  have hF : (smulInvertible J ϖ).rightOrthogonal F := by
    intro L f hL
    have h₀ : f ≫ ι = 0 := Fan.IsLimit.hom_ext hP _ _ fun n ↦ by
      rw [zero_comp]
      exact hL.hom_eq_zero (smul_id_derivedCompletionDiagram_obj J hϖI K n) _
    obtain ⟨g, hg⟩ := Triangle.coyoneda_exact₁ _ hT (f⟦(1 : ℤ)⟧')
      (by
        rw [Triangle.mk_mor₁]
        exact ((shiftFunctor _ (1 : ℤ)).map_comp f ι).symm.trans
          (by rw [h₀, Functor.map_zero]))
    have : g = 0 := Fan.IsLimit.hom_ext hP _ _ fun n ↦ by
      rw [zero_comp]
      exact (ObjectProperty.le_shift _ 1 L hL).hom_eq_zero
        (smul_id_derivedCompletionDiagram_obj J hϖI K n) _
    rw [this, zero_comp] at hg
    exact (shiftFunctor _ (1 : ℤ)).map_eq_zero_iff.mp hg
  obtain ⟨X, g, h, hX⟩ := distinguished_cocone_triangle φ
  refine ⟨F, X, φ, g, h, hX, ?_, derivedComplete_of_rightOrthogonal hϖ hI hF⟩
  -- `ϖ` acts invertibly on `X`, through `X ⊗ᴸ R/ϖ = 0`
  let M := (quotPowFunctor J I).obj (op 1)
  let TM := (curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).flip.obj M
  let F' : ℕᵒᵖ ⥤ _ := (Functor.const ℕᵒᵖ).obj K ⋙ TM
  let G' : ℕᵒᵖ ⥤ _ := G ⋙ TM
  let PM : Fan fun n : ℕ ↦ G'.obj (op n) := Fan.mk (P.pt ⊗ M) fun j ↦ P.proj j ▷ M
  have hPM : IsLimit PM := isLimit_fan_whiskerRight_quot hϖ hI hP
  let PKM : Fan fun n : ℕ ↦ F'.obj (op n) := Fan.mk (PK.pt ⊗ M) fun j ↦ PK.proj j ▷ M
  have hPKM : IsLimit PKM := isLimit_fan_whiskerRight_quot hϖ hI hPK
  have htK : TM.map (towerShift hPK) = towerShift hPKM :=
    Fan.IsLimit.hom_ext hPKM _ _ fun n ↦ by
      change TM.map _ ≫ TM.map _ = _
      rw [towerShift_proj, ← TM.map_comp, towerShift_proj, TM.map_comp]
      rfl
  have ht : TM.map (towerShift hP) = towerShift hPM :=
    Fan.IsLimit.hom_ext hPM _ _ fun n ↦ by
      change TM.map _ ≫ TM.map _ = _
      rw [towerShift_proj, ← TM.map_comp, towerShift_proj, TM.map_comp]
      rfl
  have hTKM : Triangle.mk (TM.map (Fan.IsLimit.lift hPK fun n ↦ c₀.π.app (op n)))
      (𝟙 _ - towerShift hPKM) (TM.map δK ≫ (TM.commShiftIso (1 : ℤ)).hom.app K) ∈
        distTriang _ :=
    isomorphic_distinguished _ (TM.map_distinguished _ hTK) _
      (Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp; rfl)
        (by
          simp only [Triangle.mk_mor₂, Iso.refl_hom, comp_id, id_comp]
          change _ = TM.map (𝟙 PK.pt - towerShift hPK)
          rw [Functor.map_sub, CategoryTheory.Functor.map_id, htK]
          rfl)
        (by simp; rfl))
  have hTFM : Triangle.mk (TM.map ι) (𝟙 _ - towerShift hPM)
      (TM.map ε ≫ (TM.commShiftIso (1 : ℤ)).hom.app F) ∈ distTriang _ :=
    isomorphic_distinguished _ (TM.map_distinguished _ hT) _
      (Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp; rfl)
        (by
          simp only [Triangle.mk_mor₂, Iso.refl_hom, comp_id, id_comp]
          change _ = TM.map (𝟙 P.pt - towerShift hP)
          rw [Functor.map_sub, CategoryTheory.Functor.map_id, ht]
          rfl)
        (by simp; rfl))
  let a : F' ⟶ G' := Functor.whiskerRight c.π TM
  have hb := exists_lift_whiskerRight_derivedCompletionCone hϖ hI K
  choose b hb₁ hb₂ using hb
  have hm : productTowerMap (PF := PKM) hPM a = TM.map m :=
    Fan.IsLimit.hom_ext hPM _ _ fun n ↦ by
      rw [productTowerMap_proj]
      change _ = TM.map _ ≫ TM.map _
      rw [← TM.map_comp, productTowerMap_proj, TM.map_comp]
      rfl
  have hφM : IsIso (TM.map φ) := isIso_of_proIso hPKM hPM hTKM hTFM a b hb₁ hb₂ (TM.map φ)
    (by rw [hm]; dsimp; rw [← TM.map_comp, ← TM.map_comp, hφ₁])
    (by
      rw [hm, assoc, ← TM.commShiftIso_hom_naturality, ← TM.map_comp_assoc, hφ₃,
        TM.map_comp_assoc])
  have hXM : IsZero (X ⊗ M) :=
    (Triangle.isZero₃_iff_isIso₁ _ (TM.map_distinguished _ hX)).2 hφM
  have h₁ := (Triangle.isZero₃_iff_isIso₁ _
    (tensorQuotPowTriangle_distinguished hϖ hI X 1)).1 hXM
  change IsIso (X ◁ (quotPowTriangle J hϖ hI 1).mor₁) at h₁
  rw [quotPowTriangle_mor₁, pow_one, MonoidalLinear.whiskerLeft_smul,
    MonoidalCategory.whiskerLeft_id] at h₁
  change IsIso (ϖ • 𝟙 X)
  have : ϖ • 𝟙 X = (unitIso X).hom ≫ (ϖ • 𝟙 _) ≫ (unitIso X).inv := by
    rw [Linear.smul_comp, id_comp, Linear.comp_smul, Iso.hom_inv_id]
  have h₂ : IsIso (ϖ • 𝟙 (X ⊗ (singleFunctor (Sheaf J (ModuleCat.{u + 1} R)) 0).obj
      (𝟙_ (Sheaf J (ModuleCat.{u + 1} R))))) := h₁
  rw [this]
  infer_instance

end Triangle

section Completion

variable (I : Ideal R) (h : ∃ ϖ ∈ nonZeroDivisors R, I = Ideal.span {ϖ})

/-- The objects on which a chosen generator of `I` acts invertibly. -/
noncomputable abbrev completionKernel : ObjectProperty (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  smulInvertible J h.choose

lemma derivedComplete_le_rightOrthogonal :
    ∀ Y, derivedComplete J I Y → (completionKernel J I h).rightOrthogonal Y := fun _ hY ↦
  rightOrthogonal_of_derivedComplete (mem_of_eq_span h.choose_spec.2) hY

/-- Blueprint `def-weil-derived-limit` (the derived limit of the reductions), as a functor:
the **derived completion** `K ↦ K^ = R lim_n (K ⊗ᴸ R/Iⁿ)` of `D(J, R)` into its derived
complete objects, for an ideal `I` generated by a nonzerodivisor. It is the left adjoint of the
inclusion (`DerivedCategory.derivedCompletionAdjunction`), the unit `K ⟶ K^` being the map to a
homotopy limit of the tower of reductions of `K` whose cone is killed by inverting the generator
(`DerivedCategory.exists_distinguished_derivedComplete`). -/
noncomputable def derivedCompletion :
    DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)) ⥤ (derivedComplete J I).FullSubcategory :=
  ObjectProperty.reflectorOfDistinguished (completionKernel J I h) (derivedComplete J I)
    (derivedComplete_le_rightOrthogonal J I h)
    (exists_distinguished_derivedComplete h.choose_spec.1 h.choose_spec.2)

/-- The derived completion is left adjoint to the inclusion of the derived complete objects. -/
noncomputable def derivedCompletionAdjunction :
    derivedCompletion J I h ⊣ (derivedComplete J I).ι :=
  ObjectProperty.reflectorOfDistinguishedAdjunction _ _ _ _

variable {J I}

/-- The unit `K ⟶ K^` of the derived completion sits in a distinguished triangle whose third
object is one on which the generator of `I` acts invertibly. -/
lemma exists_distinguished_derivedCompletionAdjunction_unit_app
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ∃ (X : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) (g : _ ⟶ X) (h' : X ⟶ K⟦(1 : ℤ)⟧),
      Triangle.mk ((derivedCompletionAdjunction J I h).unit.app K) g h' ∈ distTriang _ ∧
        completionKernel J I h X := by
  rw [derivedCompletionAdjunction, ObjectProperty.reflectorOfDistinguishedAdjunction_unit_app]
  exact ObjectProperty.exists_distinguished_reflectorOfDistinguishedι _ _ _ K

/-- The derived completion inverts every morphism `s : K ⟶ K'` sitting in a distinguished
triangle `K ⟶ K' ⟶ X ⟶ K⟦1⟧` with `X` an object on which the generator of `I` acts
invertibly. -/
lemma isIso_derivedCompletion_map {K K' X : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
    {s : K ⟶ K'} {g : K' ⟶ X} {h' : X ⟶ K⟦(1 : ℤ)⟧} (hT : Triangle.mk s g h' ∈ distTriang _)
    (hX : completionKernel J I h X) : IsIso ((derivedCompletion J I h).map s) := by
  let adj := derivedCompletionAdjunction J I h
  refine isIso_of_coyoneda_map_bijective _ fun T ↦ ?_
  have hb := ObjectProperty.bijective_comp_of_distinguished hT hX
    (derivedComplete_le_rightOrthogonal J I h _ T.property)
  have e : (fun x : (derivedCompletion J I h).obj K' ⟶ T ↦
      (derivedCompletion J I h).map s ≫ x) =
      (adj.homEquiv K T).symm ∘ (fun a ↦ s ≫ a) ∘ adj.homEquiv K' T := by
    funext x
    simp only [Function.comp_apply, adj.homEquiv_naturality_left_symm, Equiv.symm_apply_apply]
  rw [e]
  exact (adj.homEquiv K T).symm.bijective.comp (hb.comp (adj.homEquiv K' T).bijective)

/-- The unit `K ⟶ K^` of the derived completion is an isomorphism at a derived complete
object. -/
lemma isIso_derivedCompletionAdjunction_unit_app
    {K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))} (hK : derivedComplete J I K) :
    IsIso ((derivedCompletionAdjunction J I h).unit.app K) := by
  have : IsIso ((derivedCompletionAdjunction J I h).unit.app ((derivedComplete J I).ι.obj
      ⟨K, hK⟩)) := inferInstance
  exact this

end Completion

end DerivedCategory
