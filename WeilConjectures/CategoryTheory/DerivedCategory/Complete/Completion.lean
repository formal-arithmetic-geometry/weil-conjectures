module

public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.IntegralCoefficient

/-!
# The derived completion

Let `(C, J)` be an essentially small site, `R` a commutative ring and `I = (ϖ)` an ideal
generated by a nonzerodivisor. Every object `K` of `D(J, R) = DerivedCategory (Sheaf J
(ModuleCat R))` has a *derived completion* `K ⟶ K^`: the homotopy limit
`K^ = R lim_n (K ⊗ᴸ R/ϖⁿ)` of its reductions, with the map induced by the reduction maps. The
object `K^` is derived complete and the cone of `K ⟶ K^` is an object on which `ϖ` acts
invertibly (Stacks, Tag 091V). Consequently `K ⟶ K^` is universal among maps from `K` to
derived complete objects, and the completion is a left adjoint of the inclusion of the derived
complete objects.

At the integral stage `R = 𝒪_E`, `I = 𝔪_E` of the `ℓ`-adic formalism this is the functor
`D(J, 𝒪_E) ⥤ D_comp(J, 𝒪_E)` along which the operations of the integral stage are obtained from
the plain operations of `D(J, 𝒪_E)`: an operation of the integral stage is the derived limit of
its finite reductions, that is, the derived completion of the plain operation.

## Main definitions

- `DerivedCategory.derivedCompletion`: the derived completion functor
  `D(J, R) ⥤ (derivedComplete J I).FullSubcategory`, left adjoint to the inclusion
  (`DerivedCategory.derivedCompletionAdjunction`).
- `DerivedCategoryDerivedCompleteIntegral.completion`: its specialisation
  `D(J, 𝒪_E) ⥤ D_comp(J, 𝒪_E)`.

## Main results

- `DerivedCategory.exists_distTriang_derivedComplete_smulInvertible`: every `K` sits in a
  distinguished triangle `K ⟶ F ⟶ X ⟶ K⟦1⟧` with `F` derived complete and `ϖ` acting invertibly
  on `X`.
- `DerivedCategory.bijective_comp_of_smulInvertible`: a morphism whose cone has `ϖ` acting
  invertibly induces bijections on morphisms into derived complete objects.
- `DerivedCategory.isIso_derivedCompletion_map_of_smulInvertible`: the derived completion
  inverts such morphisms.

## Implementation notes

The construction of the triangle repeats the first half of the proof of
`DerivedCategory.derivedComplete_of_rightOrthogonal`, which does not use its hypothesis there:
the homotopy limit `F` of the reductions of an arbitrary `K` is right orthogonal to the objects
on which `ϖ` acts invertibly, and the comparison map `φ : K ⟶ F` becomes an isomorphism after
`- ⊗ᴸ R/ϖ`.
-/

@[expose] public section

universe w u

open CategoryTheory Category Limits MonoidalCategory Opposite Pretriangulated

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  (J : GrothendieckTopology C) {R : Type (u + 1)} [CommRing R]

attribute [-instance] commShift₂CurriedTensor commShiftTensorLeft commShiftTensorRight
  isTriangulated_tensorLeft isTriangulated_tensorRight monoidalPreadditive monoidalLinear

noncomputable local instance (priority := high) :
    MonoidalCategory (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalCategory

noncomputable local instance (priority := high) :
    MonoidalPreadditive (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalPreadditive

noncomputable local instance (priority := high) :
    MonoidalLinear R (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalLinear

noncomputable local instance (priority := high) :
    (curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).CommShift₂Int :=
  (sheafTensorStructure J R).commShift₂

noncomputable local instance (priority := high)
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ((curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).obj K).IsTriangulated :=
  (sheafTensorStructure J R).isTriangulated_tensorLeft K

noncomputable local instance (priority := high)
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ((curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).flip.obj K).IsTriangulated :=
  (sheafTensorStructure J R).isTriangulated_tensorRight K

local instance : IsIso (sheafTensorStructure J R).ε := (sheafTensorStructure J R).isIso_ε

variable {J}

section Triangle

variable {I : Ideal R} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ})

include hϖ hI in
/-- **The derived completion triangle.** For `I = (ϖ)` with `ϖ` a nonzerodivisor, every object
`K` of `D(J, R)` sits in a distinguished triangle `K ⟶ F ⟶ X ⟶ K⟦1⟧` with `F` derived complete
for `I` and `ϖ` acting invertibly on `X` (Stacks, Tag 091V). Here `F = R lim_n (K ⊗ᴸ R/ϖⁿ)` is
the homotopy limit of the reductions of `K`. -/
theorem exists_distTriang_derivedComplete_smulInvertible
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ∃ (F X : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) (φ : K ⟶ F) (g : F ⟶ X)
      (h : X ⟶ K⟦(1 : ℤ)⟧), Triangle.mk φ g h ∈ distTriang _ ∧ derivedComplete J I F ∧
        smulInvertible J ϖ X := by
  have hϖI := mem_of_eq_span hI
  let G := derivedCompletionDiagram J I K
  let c := derivedCompletionCone J I K
  let P : Fan fun n : ℕ ↦ G.obj (op n) := Fan.mk _ (Pi.π _)
  have hP : IsLimit P := productIsProduct _
  obtain ⟨F, ι, ε, hT⟩ := distinguished_cocone_triangle₁ (𝟙 P.pt - towerShift hP)
  -- the Milnor triangle of the constant tower `K`
  let c₀ : Cone ((Functor.const ℕᵒᵖ).obj K) := { pt := K, π := 𝟙 _ }
  have : ∀ n, IsIso (c₀.π.app n) := fun n ↦ by dsimp [c₀]; infer_instance
  obtain ⟨PK, hPK, δK, hTK⟩ := IsHomotopyLimit.of_isIso_π c₀
  let m := productTowerMap (PF := PK) hP c.π
  obtain ⟨φ, hφ₁, hφ₃⟩ := complete_distinguished_triangle_morphism₁ _ _ hTK hT m m
    (productTowerMap_comp_sub_towerShift hPK hP c.π).symm
  replace hφ₁ : Fan.IsLimit.lift hPK (fun n ↦ c₀.π.app (op n)) ≫ m = φ ≫ ι := hφ₁
  replace hφ₃ : δK ≫ φ⟦(1 : ℤ)⟧' = m ≫ ε := hφ₃
  -- `F` is right orthogonal to `smulInvertible J ϖ`
  have hF : (smulInvertible J ϖ).rightOrthogonal F := by
    intro L f hL
    have h₀ : f ≫ ι = 0 := Fan.IsLimit.hom_ext hP _ _ fun n ↦ by
      rw [zero_comp]
      exact hL.hom_eq_zero (smul_id_derivedCompletionDiagram_obj J hϖI K n) _
    obtain ⟨g, hg⟩ := Triangle.coyoneda_exact₁ _ hT (f⟦(1 : ℤ)⟧')
      (by rw [Triangle.mk_mor₁, ← Functor.map_comp, h₀, Functor.map_zero])
    have : g = 0 := Fan.IsLimit.hom_ext hP _ _ fun n ↦ by
      rw [zero_comp]
      exact (ObjectProperty.le_shift _ 1 L hL).hom_eq_zero
        (smul_id_derivedCompletionDiagram_obj J hϖI K n) _
    rw [this, zero_comp] at hg
    exact (shiftFunctor _ (1 : ℤ)).map_eq_zero_iff.mp hg
  obtain ⟨X, g, h, hX⟩ := distinguished_cocone_triangle φ
  -- `ϖ` acts invertibly on `X`, through `X ⊗ᴸ R/ϖ = 0`
  let M := (quotPowFunctor J I).obj (op 1)
  let TM := (curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).flip.obj M
  let F' : ℕᵒᵖ ⥤ _ := (Functor.const ℕᵒᵖ).obj K ⋙ TM
  let G' : ℕᵒᵖ ⥤ _ := G ⋙ TM
  let PM : Fan fun n : ℕ ↦ G'.obj (op n) := Fan.mk (P.pt ⊗ M) fun j ↦ P.proj j ▷ M
  have hPM : IsLimit PM := isLimit_fan_whiskerRight_quot hϖ hI hP
  let PKM : Fan fun n : ℕ ↦ F'.obj (op n) := Fan.mk (PK.pt ⊗ M) fun j ↦ PK.proj j ▷ M
  have hPKM : IsLimit PKM := isLimit_fan_whiskerRight_quot hϖ hI hPK
  have htK : TM.map (towerShift hPK) = towerShift hPKM :=
    Fan.IsLimit.hom_ext hPKM _ _ fun n ↦ by
      change TM.map _ ≫ TM.map _ = _
      rw [towerShift_proj, ← TM.map_comp, towerShift_proj, TM.map_comp]
      rfl
  have ht : TM.map (towerShift hP) = towerShift hPM :=
    Fan.IsLimit.hom_ext hPM _ _ fun n ↦ by
      change TM.map _ ≫ TM.map _ = _
      rw [towerShift_proj, ← TM.map_comp, towerShift_proj, TM.map_comp]
      rfl
  have hTKM : Triangle.mk (TM.map (Fan.IsLimit.lift hPK fun n ↦ c₀.π.app (op n)))
      (𝟙 _ - towerShift hPKM) (TM.map δK ≫ (TM.commShiftIso (1 : ℤ)).hom.app K) ∈
        distTriang _ :=
    isomorphic_distinguished _ (TM.map_distinguished _ hTK) _
      (Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp; rfl)
        (by
          simp only [Triangle.mk_mor₂, Iso.refl_hom, comp_id, id_comp]
          change _ = TM.map (𝟙 PK.pt - towerShift hPK)
          rw [Functor.map_sub, CategoryTheory.Functor.map_id, htK]
          rfl)
        (by simp; rfl))
  have hTFM : Triangle.mk (TM.map ι) (𝟙 _ - towerShift hPM)
      (TM.map ε ≫ (TM.commShiftIso (1 : ℤ)).hom.app F) ∈ distTriang _ :=
    isomorphic_distinguished _ (TM.map_distinguished _ hT) _
      (Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp; rfl)
        (by
          simp only [Triangle.mk_mor₂, Iso.refl_hom, comp_id, id_comp]
          change _ = TM.map (𝟙 P.pt - towerShift hP)
          rw [Functor.map_sub, CategoryTheory.Functor.map_id, ht]
          rfl)
        (by simp; rfl))
  let a : F' ⟶ G' := Functor.whiskerRight c.π TM
  have hb := exists_lift_whiskerRight_derivedCompletionCone hϖ hI K
  choose b hb₁ hb₂ using hb
  have hm : productTowerMap (PF := PKM) hPM a = TM.map m :=
    Fan.IsLimit.hom_ext hPM _ _ fun n ↦ by
      rw [productTowerMap_proj]
      change _ = TM.map _ ≫ TM.map _
      rw [← TM.map_comp, productTowerMap_proj, TM.map_comp]
      rfl
  have hφM : IsIso (TM.map φ) := isIso_of_proIso hPKM hPM hTKM hTFM a b hb₁ hb₂ (TM.map φ)
    (by rw [hm]; dsimp; rw [← TM.map_comp, ← TM.map_comp, hφ₁])
    (by
      rw [hm, assoc, ← TM.commShiftIso_hom_naturality, ← TM.map_comp_assoc, hφ₃,
        TM.map_comp_assoc])
  have hXM : IsZero (X ⊗ M) :=
    (Triangle.isZero₃_iff_isIso₁ _ (TM.map_distinguished _ hX)).2 hφM
  have hXinv : smulInvertible J ϖ X := by
    have h₁ := (Triangle.isZero₃_iff_isIso₁ _ (tensorQuotPowTriangle_distinguished hϖ hI X 1)).1 hXM
    change IsIso (X ◁ (quotPowTriangle J hϖ hI 1).mor₁) at h₁
    rw [quotPowTriangle_mor₁, pow_one, MonoidalLinear.whiskerLeft_smul,
      MonoidalCategory.whiskerLeft_id] at h₁
    change IsIso (ϖ • 𝟙 X)
    have : ϖ • 𝟙 X = (unitIso X).hom ≫ (ϖ • 𝟙 _) ≫ (unitIso X).inv := by
      rw [Linear.smul_comp, id_comp, Linear.comp_smul, Iso.hom_inv_id]
    have h₂ : IsIso (ϖ • 𝟙 (X ⊗ (singleFunctor (Sheaf J (ModuleCat.{u + 1} R)) 0).obj
        (𝟙_ (Sheaf J (ModuleCat.{u + 1} R))))) := h₁
    rw [this]
    infer_instance
  exact ⟨F, X, φ, g, h, hX, derivedComplete_of_rightOrthogonal hϖ hI hF, hXinv⟩

end Triangle

/-- **Morphisms with `ϖ`-invertible cone.** Let `u : S ⟶ T` be a morphism of `D(J, R)` whose cone
`X` (in a distinguished triangle `S ⟶ T ⟶ X ⟶ S⟦1⟧`) has `ϖ` acting invertibly. Then composition
with `u` is a bijection `(T ⟶ G) ≃ (S ⟶ G)` for every `G` receiving no nonzero map from an object
on which `ϖ` acts invertibly, e.g. every `G` derived complete for `(ϖ)`. -/
theorem bijective_comp_of_smulInvertible {ϖ : R}
    {S T X G : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))} {u : S ⟶ T} {g : T ⟶ X}
    {h : X ⟶ S⟦(1 : ℤ)⟧} (hT : Triangle.mk u g h ∈ distTriang _) (hX : smulInvertible J ϖ X)
    (hG : (smulInvertible J ϖ).rightOrthogonal G) :
    Function.Bijective (fun a : T ⟶ G ↦ u ≫ a) := by
  refine ⟨fun a b hab ↦ ?_, fun c ↦ ?_⟩
  · rw [← sub_eq_zero]
    obtain ⟨d, hd⟩ := Triangle.yoneda_exact₂ _ hT (a - b)
      (by rw [Triangle.mk_mor₁, Preadditive.comp_sub]; exact sub_eq_zero.2 hab)
    rw [hd, hG d hX, comp_zero]
  · obtain ⟨d, hd⟩ := Triangle.yoneda_exact₂ _ (inv_rot_of_distTriang _ hT) c
      (hG _ (ObjectProperty.le_shift _ (-1) X hX))
    exact ⟨d, hd.symm⟩

section Completion

variable (J) {I : Ideal R} (hI : ∃ ϖ ∈ nonZeroDivisors R, I = Ideal.span {ϖ})

include hI in
/-- For an ideal `I` generated by a nonzerodivisor, every object `K` of `D(J, R)` has a map
`φ : K ⟶ F` to a derived complete object which is universal: composition with `φ` is a bijection
`(F ⟶ G) ≃ (K ⟶ G)` for every derived complete `G`. -/
theorem exists_derivedComplete_bijective_comp
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ∃ (F : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) (_ : derivedComplete J I F)
      (φ : K ⟶ F), ∀ G, derivedComplete J I G → Function.Bijective (fun a : F ⟶ G ↦ φ ≫ a) := by
  obtain ⟨ϖ, hϖ, hI⟩ := hI
  obtain ⟨F, X, φ, g, h, hT, hF, hX⟩ := exists_distTriang_derivedComplete_smulInvertible hϖ hI K
  exact ⟨F, hF, φ, fun G hG ↦ bijective_comp_of_smulInvertible hT hX
    (rightOrthogonal_of_derivedComplete (mem_of_eq_span hI) hG)⟩

/-- The derived completion `K^ = R lim_n (K ⊗ᴸ R/Iⁿ)` of an object `K` of `D(J, R)`, for an ideal
`I` generated by a nonzerodivisor, as an object of the full subcategory of derived complete
objects. -/
noncomputable def derivedCompletionObj (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    (derivedComplete J I).FullSubcategory :=
  ⟨(exists_derivedComplete_bijective_comp J hI K).choose,
    (exists_derivedComplete_bijective_comp J hI K).choose_spec.choose⟩

/-- The completion map `K ⟶ K^`. -/
noncomputable def toDerivedCompletionObj (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    K ⟶ (derivedCompletionObj J hI K).obj :=
  (exists_derivedComplete_bijective_comp J hI K).choose_spec.choose_spec.choose

lemma bijective_toDerivedCompletionObj_comp
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))
    (G : (derivedComplete J I).FullSubcategory) :
    Function.Bijective (fun a : (derivedCompletionObj J hI K).obj ⟶ G.obj ↦
      toDerivedCompletionObj J hI K ≫ a) :=
  (exists_derivedComplete_bijective_comp J hI K).choose_spec.choose_spec.choose_spec G.obj G.2

/-- The universal property of the derived completion: morphisms `K^ ⟶ G` to a derived complete
object correspond to morphisms `K ⟶ G`, by composition with `K ⟶ K^`. -/
noncomputable def derivedCompletionHomEquiv (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))
    (G : (derivedComplete J I).FullSubcategory) :
    (derivedCompletionObj J hI K ⟶ G) ≃ (K ⟶ (derivedComplete J I).ι.obj G) :=
  (derivedComplete J I).fullyFaithfulι.homEquiv.trans
    (Equiv.ofBijective _ (bijective_toDerivedCompletionObj_comp J hI K G))

/-- **The derived completion functor** `D(J, R) ⥤ D_comp(J, R)`, `K ↦ K^ = R lim_n (K ⊗ᴸ R/Iⁿ)`,
for an ideal `I` generated by a nonzerodivisor: the left adjoint of the inclusion of the derived
complete objects (`DerivedCategory.derivedCompletionAdjunction`). -/
noncomputable def derivedCompletion :
    DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)) ⥤ (derivedComplete J I).FullSubcategory :=
  Adjunction.leftAdjointOfEquiv (derivedCompletionHomEquiv J hI) fun _ _ _ _ _ ↦ by
    simp only [derivedCompletionHomEquiv, Equiv.trans_apply, Equiv.ofBijective_apply,
      Functor.FullyFaithful.homEquiv_apply, Functor.map_comp, Category.assoc]

/-- The derived completion is left adjoint to the inclusion of the derived complete objects. -/
noncomputable def derivedCompletionAdjunction :
    derivedCompletion J hI ⊣ (derivedComplete J I).ι :=
  Adjunction.adjunctionOfEquivLeft _ _

variable {J}

/-- **The derived completion inverts morphisms with `ϖ`-invertible cone.** If `I = (ϖ)` and
`u : S ⟶ T` sits in a distinguished triangle `S ⟶ T ⟶ X ⟶ S⟦1⟧` with `ϖ` acting invertibly on
`X`, then the derived completion of `u` is an isomorphism. -/
theorem isIso_derivedCompletion_map_of_smulInvertible {ϖ : R} (hIϖ : I = Ideal.span {ϖ})
    {S T X : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))} {u : S ⟶ T} {g : T ⟶ X}
    {h : X ⟶ S⟦(1 : ℤ)⟧} (hT : Triangle.mk u g h ∈ distTriang _) (hX : smulInvertible J ϖ X) :
    IsIso ((derivedCompletion J hI).map u) := by
  rw [isIso_iff_coyoneda_map_bijective]
  intro G
  let adj := derivedCompletionAdjunction J hI
  have e : (fun x : (derivedCompletion J hI).obj T ⟶ G ↦ (derivedCompletion J hI).map u ≫ x) =
      (adj.homEquiv S G).symm ∘ (fun a ↦ u ≫ a) ∘ adj.homEquiv T G := by
    funext x
    simp only [Function.comp_apply, Equiv.eq_symm_apply]
    exact adj.homEquiv_naturality_left u x
  rw [e]
  exact (adj.homEquiv S G).symm.bijective.comp
    ((bijective_comp_of_smulInvertible hT hX
      (rightOrthogonal_of_derivedComplete (mem_of_eq_span hIϖ) G.2)).comp
      (adj.homEquiv T G).bijective)

end Completion

end DerivedCategory

section Integral

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  (J : GrothendieckTopology C) (l : ℕ) [Fact l.Prime] (E : Type w) [Field E]
  [Algebra E (PadicAlgCl l)] [Algebra ℚ_[l] E] [IsScalarTower ℚ_[l] E (PadicAlgCl l)]
  [FiniteDimensional ℚ_[l] E] [Small.{u + 1} E]

/-- The derived completion `D(J, 𝒪_E) ⥤ D_comp(J, 𝒪_E)`, `K ↦ K^ = R lim_n (K ⊗ᴸ 𝒪_E/𝔪_Eⁿ)`, left
adjoint to the inclusion `DerivedCategoryDerivedCompleteIntegral.ι`. This is how the operations
of the integral stage of the `ℓ`-adic formalism, defined levelwise as derived limits of their
finite reductions, are obtained from the plain operations of `D(J, 𝒪_E)`. -/
noncomputable def DerivedCategoryDerivedCompleteIntegral.completion :
    DerivedCategory (Sheaf J (ModuleCat.{u + 1} (Shrink.{u + 1} (PadicAlgCl.integers l E)))) ⥤
      DerivedCategoryDerivedCompleteIntegral J l E :=
  DerivedCategory.derivedCompletion J
    (PadicAlgCl.exists_mem_nonZeroDivisors_maximalIdealShrink_eq_span.{w, u} l E)

/-- The derived completion is left adjoint to the inclusion of `D_comp(J, 𝒪_E)`. -/
noncomputable def DerivedCategoryDerivedCompleteIntegral.completionAdjunction :
    DerivedCategoryDerivedCompleteIntegral.completion J l E ⊣
      DerivedCategoryDerivedCompleteIntegral.ι J l E :=
  DerivedCategory.derivedCompletionAdjunction J _

end Integral
