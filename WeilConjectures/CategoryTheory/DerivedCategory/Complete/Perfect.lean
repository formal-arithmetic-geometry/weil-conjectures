/-!
# Derived complete complexes with perfect reduction are perfect

Let `R` be a principal ideal domain which is complete for the ideal generated by a nonzerodivisor
`ϖ`. A complex `C ∈ D(R)` which is derived `ϖ`-complete, in the sense that it receives no nonzero
morphism from an object on which `ϖ` acts invertibly, and whose reduction
`C ⊗ᴸ R/ϖ = cone(ϖ : C ⟶ C)` is perfect, is itself perfect (compare Stacks, Tag 0CQG). This is
the algebraic input of the integral stage of `lemma-perfect-complexes-geometric-point` (Step 2 of
the proof of `lemma-perfect-complexes-geometric-point`), where `R = 𝒪_E`.

## Main statements

- `DerivedCategory.isPerfect_of_rightOrthogonal_of_isPerfect_obj₃`: the statement above.
- `DerivedCategory.eq_zero_of_smul_succ_eq_of_rightOrthogonal`: the cohomology modules of a
  derived complete complex contain no nonzero `ϖ`-divisible sequence.
- `Module.Finite.of_forall_smul_succ_eq`: a Nakayama lemma for such modules over a complete ring.
- `DerivedCategory.isPerfect_of_isGE_of_isLE`: over a principal ideal domain, a bounded complex
  with finitely generated cohomology is perfect.

## Implementation notes

The completeness of `R` cannot be dropped: over `R = ℤ_(p)` the module `ℤ_p` is derived
`p`-complete with perfect reduction `𝔽_p`, but it is not finitely generated.
-/

@[expose] public section

universe u

open CategoryTheory Limits Pretriangulated Pointwise
namespace Module

variable {R : Type*} [CommRing R] {ϖ : R} {H : Type*} [AddCommGroup H] [Module R H]

/-- A module in which every `ϖ`-divisible sequence vanishes, and which is `ϖ`-divisible, is
zero. -/
lemma eq_zero_of_forall_smul_surjective
    (hH : ∀ x : ℕ → H, (∀ n, ϖ • x (n + 1) = x n) → x 0 = 0)
    (hdiv : ∀ y : H, ∃ z, ϖ • z = y) (y : H) : y = 0 := by
  choose f hf using hdiv
  let x : ℕ → H := fun n ↦ Nat.rec y (fun _ z ↦ f z) n
  exact hH x fun n ↦ hf (x n)

/-- Over a ring which is `ϖ`-adically complete, every sequence `a` has a "solution" `s` of
`s k = a k + ϖ s (k + 1)`, namely `s k = ∑ⱼ ϖʲ a (k + j)`. -/
lemma exists_eq_add_mul_succ [IsAdicComplete (Ideal.span {ϖ}) R] (a : ℕ → R) :
    ∃ s : ℕ → R, ∀ k, s k = a k + ϖ * s (k + 1) := by
  let I := Ideal.span {ϖ}
  let p : ℕ → ℕ → R := fun k N ↦ ∑ j ∈ Finset.range N, ϖ ^ j * a (k + j)
  have hp (k N : ℕ) : p k (N + 1) = a k + ϖ * p (k + 1) N := by
    simp only [p]
    rw [Finset.sum_range_succ', Finset.mul_sum]
    simp only [pow_zero, one_mul, add_zero, pow_succ]
    rw [add_comm]
    congr 1
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [show k + (j + 1) = k + 1 + j by omega]
    ring
  have hmem (N : ℕ) (r : R) : r ∈ (I ^ N • ⊤ : Submodule R R) ↔ ϖ ^ N ∣ r := by
    rw [smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  have hcauchy (k : ℕ) {m n : ℕ} (hmn : m ≤ n) :
      p k m ≡ p k n [SMOD (I ^ m • ⊤ : Submodule R R)] := by
    rw [SModEq.sub_mem, hmem]
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
    refine ⟨-∑ j ∈ Finset.range d, ϖ ^ j * a (k + (m + j)), ?_⟩
    simp only [p]
    rw [Finset.sum_range_add, mul_neg, Finset.mul_sum]
    simp only [pow_add, mul_assoc]
    ring
  choose L hL using fun k ↦ IsPrecomplete.prec' (I := I) (p k) (hcauchy k)
  refine ⟨L, fun k ↦ ?_⟩
  rw [← sub_eq_zero]
  refine IsHausdorff.haus' (I := I) _ fun N ↦ ?_
  rw [SModEq.sub_mem, sub_zero, hmem]
  have h₁ := (hL k (N + 1)).symm
  have h₂ := (hL (k + 1) N).symm
  rw [SModEq.sub_mem, hmem] at h₁ h₂
  obtain ⟨c₁, hc₁⟩ := h₁
  obtain ⟨c₂, hc₂⟩ := h₂
  refine ⟨ϖ * c₁ - ϖ * c₂, ?_⟩
  have : L k - (a k + ϖ * L (k + 1)) = (L k - p k (N + 1)) - ϖ * (L (k + 1) - p (k + 1) N) := by
    rw [hp]; ring
  rw [this, hc₁, hc₂]
  ring

/-- **A Nakayama lemma for modules without `ϖ`-divisible sequences.** Let `R` be `ϖ`-adically
complete and `H` an `R`-module in which every `ϖ`-divisible sequence vanishes. If `H / ϖ H` is
finitely generated, so is `H`. -/
theorem Finite.of_forall_smul_succ_eq [IsAdicComplete (Ideal.span {ϖ}) R]
    (hH : ∀ x : ℕ → H, (∀ n, ϖ • x (n + 1) = x n) → x 0 = 0)
    [Module.Finite R (H ⧸ (ϖ • ⊤ : Submodule R H))] : Module.Finite R H := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R (H ⧸ (ϖ • ⊤ : Submodule R H))
  obtain ⟨g, hg⟩ := Module.projective_lifting_property (ϖ • ⊤ : Submodule R H).mkQ f
    (Submodule.mkQ_surjective _)
  -- every element is `g a + ϖ h`
  have hdec (h : H) : ∃ a : Fin n → R, ∃ h' : H, h = g a + ϖ • h' := by
    obtain ⟨a, ha⟩ := hf (Submodule.mkQ _ h)
    rw [← hg, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.mkQ_apply,
      Submodule.Quotient.eq, Submodule.mem_smul_pointwise_iff_exists] at ha
    obtain ⟨h', -, hh'⟩ := ha
    exact ⟨a, -h', by rw [smul_neg, hh']; abel⟩
  choose A B hAB using hdec
  refine Module.Finite.of_surjective g fun h ↦ ?_
  let hs : ℕ → H := fun k ↦ Nat.rec h (fun _ z ↦ B z) k
  let a : ℕ → Fin n → R := fun k ↦ A (hs k)
  have hrec (k : ℕ) : hs k = g (a k) + ϖ • hs (k + 1) := hAB (hs k)
  choose S hS using fun t : Fin n ↦ exists_eq_add_mul_succ (ϖ := ϖ) fun k ↦ a k t
  let s : ℕ → Fin n → R := fun k t ↦ S t k
  have hs' (k : ℕ) : s k = a k + ϖ • s (k + 1) := funext fun t ↦ hS t k
  refine ⟨s 0, ?_⟩
  have := hH (fun k ↦ hs k - g (s k)) fun k ↦ by
    rw [hrec k, hs' k, map_add, map_smul, smul_sub]
    abel
  exact (sub_eq_zero.1 this).symm

end Module

namespace DerivedCategory

variable {R : Type u} [CommRing R]

section Telescope

variable (ϖ : R)

/-- The map `1 - ϖ · shift` on the free module `ℕ →₀ R`, sending `eₙ` to `eₙ - ϖ eₙ₊₁`. Its
cokernel is `R[1/ϖ]` (`DerivedCategory.telescopeShortComplex_shortExact`). -/
noncomputable def telescopeMap : (ℕ →₀ R) →ₗ[R] (ℕ →₀ R) :=
  LinearMap.id - ϖ • Finsupp.lmapDomain R R Nat.succ

/-- The map `ℕ →₀ R ⟶ R[1/ϖ]` sending `eₙ` to `ϖ⁻ⁿ`. -/
noncomputable def telescopeToAway : (ℕ →₀ R) →ₗ[R] Localization.Away ϖ :=
  Finsupp.linearCombination R fun n ↦ (IsLocalization.Away.invSelf ϖ : Localization.Away ϖ) ^ n

/-- `telescopeMap ϖ` on a basis vector. -/
lemma telescopeMap_single (n : ℕ) (r : R) :
    telescopeMap ϖ (Finsupp.single n r) =
      Finsupp.single n r - Finsupp.single (n + 1) (ϖ * r) := by
  simp [telescopeMap, Finsupp.smul_single]

/-- `telescopeToAway ϖ` on a basis vector. -/
lemma telescopeToAway_single (n : ℕ) (r : R) :
    telescopeToAway ϖ (Finsupp.single n r) =
      r • (IsLocalization.Away.invSelf ϖ : Localization.Away ϖ) ^ n := by
  simp [telescopeToAway]

/-- The composite `ℕ →₀ R ⟶ ℕ →₀ R ⟶ R[1/ϖ]` vanishes. -/
lemma telescopeToAway_comp_telescopeMap : telescopeToAway ϖ ∘ₗ telescopeMap ϖ = 0 := by
  refine Finsupp.lhom_ext fun n r ↦ ?_
  rw [LinearMap.comp_apply, telescopeMap_single, map_sub, telescopeToAway_single,
    telescopeToAway_single, LinearMap.zero_apply, sub_eq_zero, Algebra.smul_def,
    Algebra.smul_def, map_mul, pow_succ]
  linear_combination (-(algebraMap R (Localization.Away ϖ) r *
    (IsLocalization.Away.invSelf ϖ : Localization.Away ϖ) ^ n)) *
      IsLocalization.Away.mul_invSelf (S := Localization.Away ϖ) ϖ

/-- The map `eₙ ↦ eₙ - ϖ eₙ₊₁` is injective. -/
lemma injective_telescopeMap : Function.Injective (telescopeMap ϖ) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro y hy
  have h (k : ℕ) : telescopeMap ϖ y k = y k - ϖ * Finsupp.mapDomain Nat.succ y k := by
    simp [telescopeMap]
  have hk : ∀ k, y k = 0 := by
    intro k
    induction k with
    | zero =>
      have := h 0
      rw [hy, Finsupp.mapDomain_of_notMem_range _ _ (by simp), mul_zero, sub_zero] at this
      exact this.symm
    | succ k ih =>
      have := h (k + 1)
      rw [hy, Finsupp.mapDomain_apply_of_injective Nat.succ_injective, ih, mul_zero,
        sub_zero] at this
      exact this.symm
  exact Finsupp.ext hk

/-- Every element of `R[1/ϖ]` is some `r ϖ⁻ⁿ`. -/
lemma surjective_telescopeToAway : Function.Surjective (telescopeToAway ϖ) := by
  intro z
  obtain ⟨n, a, h⟩ := IsLocalization.Away.surj ϖ z
  refine ⟨Finsupp.single n a, ?_⟩
  rw [telescopeToAway_single, Algebra.smul_def, ← h, mul_assoc, ← mul_pow,
    IsLocalization.Away.mul_invSelf, one_pow, mul_one]

/-- `r eₙ ≡ ϖᵏ r eₙ₊ₖ` modulo the image of `telescopeMap ϖ`. -/
lemma single_sub_single_mem_range (n k : ℕ) (r : R) :
    Finsupp.single n r - Finsupp.single (n + k) (ϖ ^ k * r) ∈
      LinearMap.range (telescopeMap ϖ) := by
  induction k with
  | zero => simp
  | succ k ih =>
    have : Finsupp.single n r - Finsupp.single (n + (k + 1)) (ϖ ^ (k + 1) * r) =
        (Finsupp.single n r - Finsupp.single (n + k) (ϖ ^ k * r)) +
          telescopeMap ϖ (Finsupp.single (n + k) (ϖ ^ k * r)) := by
      rw [telescopeMap_single, pow_succ', mul_assoc, ← add_assoc]
      abel
    rw [this]
    exact add_mem ih (LinearMap.mem_range_self _ _)

/-- Modulo the image of `telescopeMap ϖ`, every element is a multiple of `e_M` for `M` large. -/
lemma exists_sub_single_mem_range (y : ℕ →₀ R) :
    ∃ N, ∀ M, N ≤ M → ∃ c : R, y - Finsupp.single M c ∈ LinearMap.range (telescopeMap ϖ) := by
  induction y using Finsupp.induction with
  | zero => exact ⟨0, fun M _ ↦ ⟨0, by simp⟩⟩
  | single_add n r y _ _ ih =>
    obtain ⟨N, hN⟩ := ih
    refine ⟨max n N, fun M hM ↦ ?_⟩
    obtain ⟨c, hc⟩ := hN M (le_of_max_le_right hM)
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (le_of_max_le_left hM)
    refine ⟨ϖ ^ k * r + c, ?_⟩
    have : Finsupp.single n r + y - Finsupp.single (n + k) (ϖ ^ k * r + c) =
        (Finsupp.single n r - Finsupp.single (n + k) (ϖ ^ k * r)) +
          (y - Finsupp.single (n + k) c) := by
      rw [Finsupp.single_add]
      abel
    rw [this]
    exact add_mem (single_sub_single_mem_range ϖ n k r) hc

variable {ϖ}

/-- Exactness in the middle of `ℕ →₀ R ⟶ ℕ →₀ R ⟶ R[1/ϖ]` for a nonzerodivisor `ϖ`. -/
lemma ker_telescopeToAway_le (hϖ : ϖ ∈ nonZeroDivisors R) :
    LinearMap.ker (telescopeToAway ϖ) ≤ LinearMap.range (telescopeMap ϖ) := by
  intro y hy
  obtain ⟨N, hN⟩ := exists_sub_single_mem_range ϖ y
  obtain ⟨c, hc⟩ := hN N le_rfl
  have hc' : telescopeToAway ϖ (y - Finsupp.single N c) = 0 := by
    obtain ⟨z, hz⟩ := hc
    rw [← hz, ← LinearMap.comp_apply, telescopeToAway_comp_telescopeMap, LinearMap.zero_apply]
  rw [map_sub, LinearMap.mem_ker.1 hy, zero_sub, neg_eq_zero, telescopeToAway_single,
    Algebra.smul_def] at hc'
  have h0 : algebraMap R (Localization.Away ϖ) c = 0 := by
    calc algebraMap R (Localization.Away ϖ) c
        = algebraMap R (Localization.Away ϖ) c * (algebraMap R (Localization.Away ϖ) ϖ *
            (IsLocalization.Away.invSelf ϖ : Localization.Away ϖ)) ^ N := by
          rw [IsLocalization.Away.mul_invSelf, one_pow, mul_one]
      _ = (algebraMap R (Localization.Away ϖ) c *
            (IsLocalization.Away.invSelf ϖ : Localization.Away ϖ) ^ N) *
            algebraMap R (Localization.Away ϖ) ϖ ^ N := by ring
      _ = 0 := by rw [hc', zero_mul]
  have hinj := IsLocalization.injective (Localization.Away ϖ)
    (M := Submonoid.powers ϖ) (Submonoid.powers_le.2 hϖ)
  rw [show c = 0 from hinj (by rw [h0, map_zero]), Finsupp.single_zero, sub_zero] at hc
  exact hc

/-- The short complex `ℕ →₀ R ⟶ ℕ →₀ R ⟶ R[1/ϖ]` of `R`-modules, the first map being
`eₙ ↦ eₙ - ϖ eₙ₊₁` and the second `eₙ ↦ ϖ⁻ⁿ`. -/
noncomputable def telescopeShortComplex (ϖ : R) : ShortComplex (ModuleCat.{u} R) :=
  ShortComplex.mk (ModuleCat.ofHom (telescopeMap ϖ)) (ModuleCat.ofHom (telescopeToAway ϖ))
    (by ext1; exact telescopeToAway_comp_telescopeMap ϖ)

/-- For a nonzerodivisor `ϖ`, the sequence `0 ⟶ ℕ →₀ R ⟶ ℕ →₀ R ⟶ R[1/ϖ] ⟶ 0` is exact: this
is the presentation of `R[1/ϖ]` as the colimit of `R ──ϖ──▶ R ──ϖ──▶ ⋯`. -/
lemma telescopeShortComplex_shortExact (hϖ : ϖ ∈ nonZeroDivisors R) :
    (telescopeShortComplex ϖ).ShortExact where
  exact := (ShortComplex.moduleCat_exact_iff_ker_sub_range _).2 (ker_telescopeToAway_le hϖ)
  mono_f := (ModuleCat.mono_iff_injective _).2 (injective_telescopeMap ϖ)
  epi_g := (ModuleCat.epi_iff_surjective _).2 (surjective_telescopeToAway ϖ)

end Telescope


variable [HasDerivedCategory.{u} (ModuleCat.{u} R)]

/-- Let `ϖ` be a nonzerodivisor and `C ∈ D(R)` an object receiving no nonzero map from an object
on which `ϖ` acts invertibly. Then every `ϖ`-divisible sequence `x` of `H⁰(C)`
(`ϖ • x (n + 1) = x n`) vanishes. Such a sequence is a map `ℕ →₀ R ⟶ H⁰(C)`, that is, a map
`(ℕ →₀ R)[0] ⟶ C`, which is killed by `eₙ ↦ eₙ - ϖ eₙ₊₁`; it therefore factors through the
cokernel `R[1/ϖ][0]` (`DerivedCategory.telescopeShortComplex_shortExact`), on which `ϖ` acts
invertibly. -/
lemma eq_zero_of_smul_succ_eq_of_rightOrthogonal_zero {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R)
    {C : DerivedCategory (ModuleCat.{u} R)}
    (hC : ∀ (L : DerivedCategory (ModuleCat.{u} R)) (f : L ⟶ C), IsIso (ϖ • 𝟙 L) → f = 0)
    (x : ℕ → (homologyFunctor (ModuleCat.{u} R) 0).obj C) (hx : ∀ n, ϖ • x (n + 1) = x n) :
    x 0 = 0 := by
  let S : ShortComplex (ModuleCat.{u} R) := telescopeShortComplex ϖ
  have hS : S.ShortExact := telescopeShortComplex_shortExact hϖ
  have : Projective S.X₂ := inferInstanceAs (Projective (ModuleCat.of R (ℕ →₀ R)))
  have : Projective S.X₁ := inferInstanceAs (Projective (ModuleCat.of R (ℕ →₀ R)))
  let v : S.X₂ ⟶ (homologyFunctor (ModuleCat.{u} R) 0).obj C :=
    ModuleCat.ofHom (Finsupp.linearCombination R x)
  let g := (singleFunctorZeroHomEquiv S.X₂ C).symm v
  have hv : S.f ≫ v = 0 := by
    ext1
    refine Finsupp.lhom_ext fun n r ↦ ?_
    change Finsupp.linearCombination R x (telescopeMap ϖ (Finsupp.single n r)) = 0
    rw [telescopeMap_single, map_sub, Finsupp.linearCombination_single,
      Finsupp.linearCombination_single, mul_smul, smul_comm ϖ r, hx, sub_self]
  have hg : (singleFunctor (ModuleCat.{u} R) 0).map S.f ≫ g = 0 := by
    apply (singleFunctorZeroHomEquiv S.X₁ C).injective
    have hnat := (singleFunctorCompHomologyFunctorIso (ModuleCat.{u} R) 0).inv.naturality S.f
    simp only [Functor.id_obj, Functor.comp_obj, Functor.id_map, Functor.comp_map] at hnat
    rw [singleFunctorZeroHomEquiv_apply, singleFunctorZeroHomEquiv_apply, Functor.map_comp,
      ← Category.assoc, ← hnat, Category.assoc]
    have : (singleFunctorCompHomologyFunctorIso (ModuleCat.{u} R) 0).inv.app S.X₂ ≫
        (homologyFunctor (ModuleCat.{u} R) 0).map g = v := by
      rw [← singleFunctorZeroHomEquiv_apply, Equiv.apply_symm_apply]
    rw [this, hv, Functor.map_zero, Limits.comp_zero]
  obtain ⟨h, hh⟩ := Triangle.yoneda_exact₂ _ hS.singleTriangle_distinguished g hg
  have hinv : IsIso (ϖ • 𝟙 ((singleFunctor (ModuleCat.{u} R) 0).obj S.X₃)) := by
    rw [← (singleFunctor (ModuleCat.{u} R) 0).map_id, ← Functor.map_smul]
    have : IsIso (ϖ • 𝟙 S.X₃) := by
      refine ⟨⟨ModuleCat.ofHom (LinearMap.mulLeft R
        (IsLocalization.Away.invSelf ϖ : Localization.Away ϖ)), ?_, ?_⟩⟩ <;>
        refine ModuleCat.hom_ext (LinearMap.ext fun (z : Localization.Away ϖ) ↦ ?_)
      · change IsLocalization.Away.invSelf ϖ * (ϖ • z) = z
        rw [Algebra.smul_def, ← mul_assoc, mul_comm (IsLocalization.Away.invSelf ϖ),
          IsLocalization.Away.mul_invSelf, one_mul]
      · change ϖ • (IsLocalization.Away.invSelf ϖ * z) = z
        rw [Algebra.smul_def, ← mul_assoc, IsLocalization.Away.mul_invSelf, one_mul]
    infer_instance
  have hg0 : g = 0 := by rw [hh, hC _ h hinv, Limits.comp_zero]
  have hv0 : v = 0 := by
    have := congrArg (singleFunctorZeroHomEquiv S.X₂ C) hg0
    rw [Equiv.apply_symm_apply] at this
    rw [this, singleFunctorZeroHomEquiv_apply, Functor.map_zero, Limits.comp_zero]
  have := congrArg (fun φ ↦ φ.hom (Finsupp.single 0 1)) hv0
  simp only [v, ModuleCat.hom_ofHom, ModuleCat.hom_zero, LinearMap.zero_apply] at this
  erw [Finsupp.linearCombination_single, one_smul] at this
  exact this

/-- The divisible-sequence lemma `eq_zero_of_smul_succ_eq_of_rightOrthogonal_zero` in every
degree `n`: apply it to `C⟦n⟧`, whose `H⁰` is `Hⁿ(C)`. -/
lemma eq_zero_of_smul_succ_eq_of_rightOrthogonal {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R)
    {C : DerivedCategory (ModuleCat.{u} R)}
    (hC : ∀ (L : DerivedCategory (ModuleCat.{u} R)) (f : L ⟶ C), IsIso (ϖ • 𝟙 L) → f = 0)
    (n : ℤ) (x : ℕ → (homologyFunctor (ModuleCat.{u} R) n).obj C)
    (hx : ∀ k, ϖ • x (k + 1) = x k) : x 0 = 0 := by
  let e : (homologyFunctor (ModuleCat.{u} R) 0).obj (C⟦n⟧) ≅
      (homologyFunctor (ModuleCat.{u} R) n).obj C :=
    ((homologyFunctor (ModuleCat.{u} R) 0).shiftIso n 0 n (add_zero n)).app C
  have hC' : ∀ (L : DerivedCategory (ModuleCat.{u} R)) (f : L ⟶ C⟦n⟧), IsIso (ϖ • 𝟙 L) →
      f = 0 := by
    intro L f hL
    have hL' : IsIso (ϖ • 𝟙 (L⟦-n⟧)) := by
      rw [← (shiftFunctor _ (-n)).map_id, ← Functor.map_smul]
      infer_instance
    have h0 := hC _ (f⟦-n⟧' ≫ (shiftFunctorCompIsoId _ n (-n) (add_neg_cancel n)).hom.app C) hL'
    rw [Preadditive.IsIso.comp_right_eq_zero] at h0
    exact (shiftFunctor _ (-n)).map_injective (by rw [h0, Functor.map_zero])
  have := eq_zero_of_smul_succ_eq_of_rightOrthogonal_zero hϖ hC' (fun k ↦ e.inv (x k))
    fun k ↦ by rw [← map_smul, hx]
  rw [← e.inv_hom_id_apply (x 0), this, map_zero]


/-- A finitely generated projective module placed in any degree is a perfect complex. -/
lemma isPerfect_singleFunctor_obj_of_projective (M : ModuleCat.{u} R) [Module.Projective R M]
    [Module.Finite R M] (n : ℤ) : ((singleFunctor (ModuleCat.{u} R) n).obj M).IsPerfect := by
  let P := (HomologicalComplex.single (ModuleCat.{u} R) (ComplexShape.up ℤ) n).obj M
  refine (isPerfect_Q_obj P n n fun i ↦ ?_).of_iso
    ((singleFunctorIsoCompQ (ModuleCat.{u} R) n).app M).symm
  by_cases hi : i = n
  · subst hi
    let e := (HomologicalComplex.singleObjXSelf (.up ℤ) i M).toLinearEquiv
    exact ⟨Module.Projective.of_equiv e.symm, Module.Finite.equiv e.symm⟩
  · have hz : IsZero (P.X i) := HomologicalComplex.isZero_single_obj_X _ _ _ _ hi
    have : Subsingleton (P.X i) := ModuleCat.isZero_iff_subsingleton.1 hz
    exact ⟨inferInstance, inferInstance⟩

/-- A zero object of `D(R)` is perfect. -/
lemma isPerfect_of_isZero {X : DerivedCategory (ModuleCat.{u} R)} (hX : IsZero X) :
    X.IsPerfect :=
  (isPerfect_singleFunctor_obj_of_projective (ModuleCat.of R (Fin 0 → R)) 0).of_iso
    (IsZero.iso ((singleFunctor _ 0).map_isZero (ModuleCat.isZero_of_subsingleton _)) hX)

section PID

variable [IsDomain R] [IsPrincipalIdealRing R]

/-- Over a principal ideal domain, a finitely generated module placed in any degree is a perfect
complex: it has a resolution `0 ⟶ K ⟶ Rᵏ ⟶ M ⟶ 0` with `K` free. -/
lemma isPerfect_singleFunctor_obj (M : ModuleCat.{u} R) [Module.Finite R M] (n : ℤ) :
    ((singleFunctor (ModuleCat.{u} R) n).obj M).IsPerfect := by
  suffices h0 : ((singleFunctor (ModuleCat.{u} R) 0).obj M).IsPerfect from
    (h0.shift (-n)).of_iso (((singleFunctors (ModuleCat.{u} R)).shiftIso (-n) n 0 (by lia)).app M)
  obtain ⟨k, f, hf⟩ := Module.Finite.exists_fin' R M
  let K := LinearMap.ker f
  let S : ShortComplex (ModuleCat.{u} R) :=
    ShortComplex.mk (ModuleCat.ofHom K.subtype) (ModuleCat.ofHom f)
      (by ext1; exact LinearMap.ext fun x ↦ x.2)
  have hS : S.ShortExact :=
    { exact := (ShortComplex.moduleCat_exact_iff_ker_sub_range _).2
        fun x hx ↦ ⟨⟨x, hx⟩, rfl⟩
      mono_f := (ModuleCat.mono_iff_injective _).2 K.injective_subtype
      epi_g := (ModuleCat.epi_iff_surjective _).2 hf }
  have : Module.Free R K := Module.free_of_finite_type_torsion_free'
  have : Module.Projective R S.X₁ := inferInstanceAs (Module.Projective R K)
  have : Module.Finite R S.X₁ := inferInstanceAs (Module.Finite R K)
  have : Module.Projective R S.X₂ := inferInstanceAs (Module.Projective R (Fin k → R))
  have : Module.Finite R S.X₂ := inferInstanceAs (Module.Finite R (Fin k → R))
  exact isPerfect_obj₂_of_distTriang _ (rot_of_distTriang _ hS.singleTriangle_distinguished)
    (isPerfect_singleFunctor_obj_of_projective S.X₂ 0)
    ((isPerfect_singleFunctor_obj_of_projective S.X₁ 0).shift 1)

/-- Over a principal ideal domain, an object of `D(R)` with cohomology concentrated in
`[a, a + n - 1]`, finitely generated there, is perfect. The proof is an induction along the
truncation triangles `τ_{< b} X ⟶ X ⟶ τ_{≥ b} X ⟶`, the last term being a finitely generated
module placed in degree `b`. -/
lemma isPerfect_of_isGE_of_isLE (n : ℕ) :
    ∀ (a : ℤ) (X : DerivedCategory (ModuleCat.{u} R)), X.IsGE a → X.IsLE (a + n - 1) →
      (∀ q, a ≤ q → q < a + n → Module.Finite R ((homologyFunctor (ModuleCat.{u} R) q).obj X)) →
        X.IsPerfect := by
  induction n with
  | zero =>
    intro a X _ _ _
    have : X.IsLE (a - 1) := by simpa using ‹X.IsLE (a + ↑(0 : ℕ) - 1)›
    exact isPerfect_of_isZero (TStructure.t.isZero X (a - 1) a (by lia))
  | succ n ih =>
    intro a X _ _ hX
    set b : ℤ := a + n
    have hT := TStructure.t.triangleLTGE_distinguished b X
    have : X.IsLE b := TStructure.t.isLE_of_le X (a + ↑(n + 1) - 1) _ (by lia)
    have : ((TStructure.t.triangleLTGE b).obj X).obj₃.IsLE b :=
      inferInstanceAs (TStructure.t.IsLE ((TStructure.t.truncGE b).obj X) b)
    have : ((TStructure.t.triangleLTGE b).obj X).obj₃.IsGE b :=
      inferInstanceAs (TStructure.t.IsGE ((TStructure.t.truncGE b).obj X) b)
    obtain ⟨Y, ⟨e⟩⟩ := exists_iso_singleFunctor_obj_of_isGE_of_isLE
      ((TStructure.t.triangleLTGE b).obj X).obj₃ b
    have := isIso_homologyFunctor_map_truncGEπ_app X b b le_rfl
    have : Module.Finite R Y := by
      have : Module.Finite R ((homologyFunctor (ModuleCat.{u} R) b).obj
          ((𝟭 (DerivedCategory (ModuleCat.{u} R))).obj X)) := hX b (by lia) (by lia)
      exact Module.Finite.equiv
        (asIso ((homologyFunctor _ b).map ((TStructure.t.truncGEπ b).app X)) ≪≫
          (homologyFunctor _ b).mapIso e ≪≫
            (singleFunctorCompHomologyFunctorIso _ b).app Y).toLinearEquiv
    refine isPerfect_obj₂_of_distTriang _ hT ?_
      ((isPerfect_singleFunctor_obj Y b).of_iso e.symm)
    refine ih a _ ?_ ?_ fun q hq hq' ↦ ?_
    · exact inferInstanceAs (TStructure.t.IsGE ((TStructure.t.truncLT b).obj X) a)
    · exact TStructure.t.isLE_truncLT_obj _ _ _ (by lia)
    · have := isIso_homologyFunctor_map_truncLTι_app X b q (by lia)
      have : Module.Finite R ((homologyFunctor (ModuleCat.{u} R) q).obj
          ((𝟭 (DerivedCategory (ModuleCat.{u} R))).obj X)) := hX q hq (by lia)
      exact Module.Finite.equiv
        (asIso ((homologyFunctor _ q).map ((TStructure.t.truncLTι b).app X))).symm.toLinearEquiv



/-- **Derived complete complexes with perfect reduction are perfect.** Let `R` be a principal ideal
domain, complete for the ideal generated by a nonzerodivisor `ϖ`. A complex `C ∈ D(R)` which
receives no nonzero morphism from an object on which `ϖ` acts invertibly, and whose reduction
`C₁ = cone(ϖ : C ⟶ C)` is perfect, is perfect.

The exact sequences `Hⁿ(C) ──ϖ──▶ Hⁿ(C) ⟶ Hⁿ(C₁)` show that `Hⁿ(C)/ϖ` embeds in `Hⁿ(C₁)`. Every
`ϖ`-divisible sequence of `Hⁿ(C)` vanishes
(`DerivedCategory.eq_zero_of_smul_succ_eq_of_rightOrthogonal`), so by the Nakayama lemma
`Module.Finite.of_forall_smul_succ_eq` the module `Hⁿ(C)` is finitely generated, and it vanishes
when `Hⁿ(C₁)` does. A bounded complex with finitely generated cohomology over a principal ideal
domain is perfect (`DerivedCategory.isPerfect_of_isGE_of_isLE`). -/
theorem isPerfect_of_rightOrthogonal_of_isPerfect_obj₃ {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R)
    [IsAdicComplete (Ideal.span {ϖ}) R]
    {C C₁ : DerivedCategory (ModuleCat.{u} R)} {g : C ⟶ C₁} {h : C₁ ⟶ C⟦(1 : ℤ)⟧}
    (hT : Triangle.mk (ϖ • 𝟙 C) g h ∈ distTriang _)
    (hC : ∀ (L : DerivedCategory (ModuleCat.{u} R)) (f : L ⟶ C), IsIso (ϖ • 𝟙 L) → f = 0)
    (hC₁ : C₁.IsPerfect) : C.IsPerfect := by
  have hker (n : ℤ) : LinearMap.ker ((homologyFunctor (ModuleCat.{u} R) n).map g).hom =
      (ϖ • ⊤ : Submodule R ((homologyFunctor (ModuleCat.{u} R) n).obj C)) := by
    have hex := (homologyFunctor (ModuleCat.{u} R) n).map_distinguished_exact _ hT
    rw [ShortComplex.moduleCat_exact_iff_range_eq_ker] at hex
    change LinearMap.range ((homologyFunctor _ n).map (ϖ • 𝟙 C)).hom =
      LinearMap.ker ((homologyFunctor (ModuleCat.{u} R) n).map g).hom at hex
    rw [← hex, homologyFunctor_map_smul_id]
    ext y
    simp [Submodule.mem_smul_pointwise_iff_exists, eq_comm]
  have hfin (n : ℤ) : Module.Finite R ((homologyFunctor (ModuleCat.{u} R) n).obj C) := by
    have : Module.Finite R ((homologyFunctor (ModuleCat.{u} R) n).obj C₁) :=
      hC₁.finite_homology n
    have : Module.Finite R (((homologyFunctor (ModuleCat.{u} R) n).obj C) ⧸
        (ϖ • ⊤ : Submodule R ((homologyFunctor (ModuleCat.{u} R) n).obj C))) := by
      rw [← hker n]
      exact Module.Finite.equiv ((homologyFunctor _ n).map g).hom.quotKerEquivRange.symm
    exact Module.Finite.of_forall_smul_succ_eq
      (eq_zero_of_smul_succ_eq_of_rightOrthogonal hϖ hC n)
  have hzero (n : ℤ) (hn : IsZero ((homologyFunctor (ModuleCat.{u} R) n).obj C₁)) :
      IsZero ((homologyFunctor (ModuleCat.{u} R) n).obj C) := by
    have hy (y : (homologyFunctor (ModuleCat.{u} R) n).obj C) : y = 0 := by
      refine Module.eq_zero_of_forall_smul_surjective
        (eq_zero_of_smul_succ_eq_of_rightOrthogonal hϖ hC n) (fun y ↦ ?_) y
      have : y ∈ LinearMap.ker ((homologyFunctor (ModuleCat.{u} R) n).map g).hom := by
        rw [hn.eq_of_tgt ((homologyFunctor (ModuleCat.{u} R) n).map g) 0]
        simp
      rw [hker n, Submodule.mem_smul_pointwise_iff_exists] at this
      obtain ⟨z, -, hz⟩ := this
      exact ⟨z, hz⟩
    have : Subsingleton ((homologyFunctor (ModuleCat.{u} R) n).obj C) :=
      ⟨fun y z ↦ by rw [hy y, hy z]⟩
    exact ModuleCat.isZero_of_subsingleton _
  obtain ⟨a, b, ha, hb⟩ := hC₁.exists_homologyConcentratedIn
  have : C₁.IsGE a := ha
  have : C₁.IsLE b := hb
  have : C.IsGE a := by
    rw [isGE_iff]
    exact fun i hi ↦ hzero i (C₁.isZero_of_isGE a i hi)
  have : C.IsLE b := by
    rw [isLE_iff]
    exact fun i hi ↦ hzero i (C₁.isZero_of_isLE b i hi)
  exact isPerfect_of_isGE_of_isLE (b - a + 1).toNat a C ‹_›
    (TStructure.t.isLE_of_le C b _ (by lia)) fun q _ _ ↦ hfin q

/-- The criterion `DerivedCategory.isPerfect_of_rightOrthogonal_of_isPerfect_obj₃` transported
along an `R`-linear triangulated equivalence `F : D ⥤ D(R)`: if `N ∈ D` receives no nonzero
morphism from an object on which `ϖ` acts invertibly, and `F` of the reduction
`N₁ = cone(ϖ : N ⟶ N)` is perfect, then `F N` is perfect. -/
theorem isPerfect_obj_of_rightOrthogonal_of_isPerfect_obj₃ {D : Type*} [Category* D]
    [Preadditive D] [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
    [Pretriangulated D] [Linear R D] (F : D ⥤ DerivedCategory (ModuleCat.{u} R))
    [F.IsEquivalence] [F.Linear R] [F.CommShift ℤ] [F.IsTriangulated]
    {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R) [IsAdicComplete (Ideal.span {ϖ}) R]
    {N N₁ : D} {g : N ⟶ N₁} {h : N₁ ⟶ N⟦(1 : ℤ)⟧}
    (hT : Triangle.mk (ϖ • 𝟙 N) g h ∈ distTriang _)
    (hN : ∀ (L : D) (f : L ⟶ N), IsIso (ϖ • 𝟙 L) → f = 0)
    (hN₁ : (F.obj N₁).IsPerfect) : (F.obj N).IsPerfect := by
  have h1 : F.map (ϖ • 𝟙 N) = ϖ • 𝟙 (F.obj N) := by
    rw [Functor.map_smul, CategoryTheory.Functor.map_id]
  refine isPerfect_of_rightOrthogonal_of_isPerfect_obj₃ hϖ
    (g := F.map g) (h := F.map h ≫ (F.commShiftIso (1 : ℤ)).hom.app N) ?_ ?_ hN₁
  · refine isomorphic_distinguished _ (F.map_distinguished _ hT) _
      (Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_)
    · exact (Category.comp_id _).trans (h1.symm.trans (Category.id_comp _).symm)
    · exact (Category.comp_id _).trans (Category.id_comp _).symm
    · exact ((congrArg _ (CategoryTheory.Functor.map_id _ _)).trans
        (Category.comp_id _)).trans (Category.id_comp _).symm
  · intro L f hL
    let ε := F.asEquivalence.counitIso.app L
    have hL' : IsIso (ϖ • 𝟙 (F.inv.obj L)) := by
      have : IsIso (F.map (ϖ • 𝟙 (F.inv.obj L))) := by
        have e : F.map (ϖ • 𝟙 (F.inv.obj L)) = ε.hom ≫ (ϖ • 𝟙 L) ≫ ε.inv := by
          rw [Functor.map_smul, CategoryTheory.Functor.map_id, Linear.smul_comp,
            Linear.comp_smul]
          exact congrArg (ϖ • ·) (ε.hom_inv_id.symm.trans
            (congrArg (ε.hom ≫ ·) (Category.id_comp ε.inv).symm))
        rw [e]
        infer_instance
      exact isIso_of_reflects_iso _ F
    have h0 := hN _ (F.preimage (ε.hom ≫ f)) hL'
    have : ε.hom ≫ f = 0 := by
      rw [← F.map_preimage (ε.hom ≫ f), h0, Functor.map_zero]
    rwa [Preadditive.IsIso.comp_left_eq_zero] at this

end PID

end DerivedCategory
