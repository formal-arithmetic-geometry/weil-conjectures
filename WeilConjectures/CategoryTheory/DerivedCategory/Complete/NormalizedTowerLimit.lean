/-!
# The derived limit of a normalized tower

Let `(C, J)` be an essentially small site, `R` a commutative ring and `I = (ϖ)` an ideal
generated by a nonzerodivisor, and put `A_n = R ⧸ Iⁿ`. A tower `K : ℕᵒᵖ ⥤ D(J, R)` is
*normalized* (`DerivedCategory.IsNormalizedTower`) if it is the restriction of scalars to `R` of
levels `L_n ∈ D(J, A_n)` whose transitions `L_{n+1} ⟶ Res L_n` exhibit `L_n` as the derived
base change `L_{n+1} ⊗ᴸ_{A_{n+1}} A_n`.

For such a tower and its derived limit `K_R = R lim_n K_n` (the point of a homotopy limit cone,
`CategoryTheory.Pretriangulated.IsHomotopyLimit`), this file proves the realization statement, apart
from the cohomological range:

* `K_R ⊗ᴸ_R A_n ≅ K_n`, compatibly with the transitions and with the legs of the cone
  (`DerivedCategory.IsNormalizedTower.exists_derivedCompletionDiagram_iso`);
* `K_R` is derived complete (`DerivedCategory.IsNormalizedTower.derivedComplete`).

The proof follows the blueprint: the tower is strictified into a normalized adic tower of
complexes (`DerivedCategory.exists_isNormalizedAdicTower`), for which `- ⊗ᴸ_R A_n` is the mapping
cone of `ϖⁿ`, commutes with the derived limit, and the tower of the first terms of the cones is
pro-zero (`DerivedCategory.exists_derivedCompletionDiagram_iso_of_isNormalizedAdicTower`).
Neither constructibility nor any uniformity of the levels is needed.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite Pretriangulated

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  (J : GrothendieckTopology C) {R : Type (u + 1)} [CommRing R] (I : Ideal R)

/-- Restriction of scalars along `R ⟶ R ⧸ Iⁿ`, from `D(J, R ⧸ Iⁿ)` to `D(J, R)`. -/
noncomputable abbrev levelRestrictScalars (n : ℕ) :
    DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n))) ⥤
      DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)) :=
  Sheaf.derivedRestrictScalars J (Ideal.Quotient.mk (I ^ n))

/-- Restriction of scalars along `R ⧸ Iⁿ ⟶ R ⧸ Iʲ` for `j ≤ n`, from `D(J, R ⧸ Iʲ)` to
`D(J, R ⧸ Iⁿ)`. -/
noncomputable abbrev levelTransitionRestrictScalars {j n : ℕ} (h : j ≤ n) :
    DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ j))) ⥤
      DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n))) :=
  Sheaf.derivedRestrictScalars J (Ideal.Quotient.factor (Ideal.pow_le_pow_right h))

/-- Restricting scalars from `R ⧸ Iʲ` to `R ⧸ Iⁿ` and then to `R` is restricting scalars from
`R ⧸ Iʲ` to `R`. -/
noncomputable abbrev levelRestrictScalarsCompIso {j n : ℕ} (h : j ≤ n) :
    levelTransitionRestrictScalars J I h ⋙ levelRestrictScalars J I n ≅
      levelRestrictScalars J I j :=
  Sheaf.derivedRestrictScalarsCompIso _
    (Ideal.Quotient.factor_comp_mk (Ideal.pow_le_pow_right h)).symm

/-- A tower `K : ℕᵒᵖ ⥤ D(J, R)` is *normalized* with respect to the ideal `I` and levels
`L_n ∈ D(J, A_n)` over the rings `A_n = R ⧸ Iⁿ` if
- `K_n` is `L_n` with scalars restricted to `R`;
- the transition `K_{n+1} ⟶ K_n` is the restriction to `R` of a map
  `t_n : L_{n+1} ⟶ Res L_n` in `D(J, A_{n+1})` exhibiting `L_n` as the derived base change
  `L_{n+1} ⊗ᴸ_{A_{n+1}} A_n` (`CategoryTheory.Sheaf.IsDerivedBaseChange`).

The base change is taken over `A_{n+1}`, not over `R`: for `I = (ϖ)` with `ϖ` a nonzerodivisor,
`L_n ⊗ᴸ_R R ⧸ Iʲ` has an extra `Tor₁` term. -/
def IsNormalizedTower (K : ℕᵒᵖ ⥤ DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))
    (L : ∀ n : ℕ, DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n)))) : Prop :=
  ∃ (eK : ∀ n : ℕ, K.obj (op n) ≅ (levelRestrictScalars J I n).obj (L n))
    (t : ∀ n : ℕ, L (n + 1) ⟶ (levelTransitionRestrictScalars J I n.le_succ).obj (L n)),
    (∀ n : ℕ, Sheaf.IsDerivedBaseChange (t n)) ∧
    ∀ n : ℕ, K.map (homOfLE n.le_succ).op =
      (eK (n + 1)).hom ≫ (levelRestrictScalars J I (n + 1)).map (t n) ≫
        (levelRestrictScalarsCompIso J I n.le_succ).hom.app (L n) ≫ (eK n).inv

section StrictModel

variable {J I} {ϖ : R} {T : ℕᵒᵖ ⥤ CochainComplex (Sheaf J (ModuleCat.{u + 1} R)) ℤ}
  {K : ℕᵒᵖ ⥤ DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}

end StrictModel

variable {J I} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ})
  {K : ℕᵒᵖ ⥤ DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
  {L : ∀ n : ℕ, DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n)))}

namespace IsNormalizedTower

variable (hK : IsNormalizedTower J I K L)

end IsNormalizedTower

end DerivedCategory
