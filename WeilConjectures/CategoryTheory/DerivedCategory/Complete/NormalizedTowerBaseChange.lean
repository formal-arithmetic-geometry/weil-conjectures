module

public import WeilConjectures.Algebra.Category.ModuleCat.Sheaf.ExtendScalarsFlat
public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.NormalizedTowerLimit
public import WeilConjectures.CategoryTheory.Triangulated.HomotopyLimit.Existence

/-!
# The legs of the derived limit of a normalized tower are derived base changes

Let `(C, J)` be an essentially small site, `R` a commutative ring and `I = (ϖ)` an ideal
generated by a nonzerodivisor, and put `A_n = R ⧸ Iⁿ`. Let `L_n ∈ D(J, A_n)` be a normalized
tower: its transitions `t_n : L_{n+1} ⟶ Res L_n` exhibit `L_n` as the derived base change
`L_{n+1} ⊗ᴸ_{A_{n+1}} A_n`. For a homotopy limit `K = R lim_n Res L_n`, each leg
`K ⟶ Res L_n` exhibits `L_n` as the derived base change `K ⊗ᴸ_R A_n`
(`DerivedCategory.isDerivedBaseChange_π_comp_towerFunctorIso_hom`).

## Proof

The tower is represented by its strict model `T_n = Res P_n`
(`DerivedCategory.towerFunctor`), with `P_n` a K-flat complex of flat sheaves of
`A_n`-modules. The reduction `K ⊗ᴸ R ⧸ Iⁿ` of the leg, followed by the *action map*
`cone(ϖⁿ on Res P_n) ⟶ Res P_n` (`DerivedCategory.restrictScalarsActionMap`), is an isomorphism
(`DerivedCategory.isIso_reduction_comp_coneToLevel`). The action map is natural with respect to
the restrictions of scalars of all morphisms of `D(J, A_n)`
(`DerivedCategory.reductionFunctor_map_comp_actionMap`). Choosing a K-flat model `P` of `K`
with flat terms, the strict reduction `P ⟶ Res(P ⧸ ϖⁿ)` is a derived base change
(`CategoryTheory.Functor.ReductionDatum.bijective_comp_map`), and its reduction followed by the
action map is the quasi-isomorphism `cone(ϖⁿ on P) ⟶ Res(P ⧸ ϖⁿ)`. So the morphism
`P ⧸ ϖⁿ ⟶ L_n` adjoint to the leg becomes an isomorphism after restriction of scalars, and
restriction of scalars reflects isomorphisms.
-/

@[expose] public section

set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory Category Limits MonoidalCategory Opposite Pretriangulated

namespace CategoryTheory.Pretriangulated

variable {C : Type*} [Category C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] [HasLimitsOfShape (Discrete ℕ) C]

/-- A cone over a tower is a homotopy limit cone as soon as its legs in positive degrees exhibit
its point as the homotopy limit of the shifted tower `n ↦ F (n + 1)`. -/
lemma IsHomotopyLimit.of_whisker_addOpFunctor_one {F : ℕᵒᵖ ⥤ C} (c : Cone F)
    (hc : IsHomotopyLimit (c.whisker (addOpFunctor 1))) : IsHomotopyLimit c := by
  have hh := isHomotopyLimit_homotopyLimitCone F
  obtain ⟨e, he⟩ := (hh.whiskerAdd 1).exists_iso hc
  refine hh.of_iso (Iso.refl F) c e fun n ↦ ?_
  have he' (k : ℕ) : e.hom ≫ c.π.app (op (k + 1)) = (homotopyLimitCone F).π.app (op (k + 1)) :=
    he k
  rcases n with _ | k
  · rw [Iso.refl_hom, NatTrans.id_app, comp_id, ← c.w (homOfLE (Nat.le_succ 0)).op,
      reassoc_of% he', Cone.w]
  · rw [Iso.refl_hom, NatTrans.id_app, comp_id, he']

end CategoryTheory.Pretriangulated

namespace CategoryTheory.Pretriangulated

section Succ

variable {C : Type*} [Category C]

/-- The cone over a tower `F` obtained from a cone over the shifted tower `n ↦ F (n + 1)`, with
leg at `0` the leg at `1` followed by the transition `F 1 ⟶ F 0`. -/
@[simps pt]
def coneOfAddOpFunctorOne {F : ℕᵒᵖ ⥤ C} (c : Cone (addOpFunctor 1 ⋙ F)) : Cone F where
  pt := c.pt
  π := NatTrans.ofOpSequence
    (fun k ↦ match k with
      | 0 => c.π.app (op 0) ≫ F.map (homOfLE (Nat.le_succ 0)).op
      | k + 1 => c.π.app (op k))
    (fun k ↦ by
      rcases k with _ | k
      · simp
      · have := c.w (homOfLE k.le_succ).op
        simp only [Functor.const_obj_obj, Functor.comp_obj, addOpFunctor_obj, Functor.comp_map,
          Functor.const_obj_map, id_comp] at this ⊢
        rw [← this]
        rfl)

@[simp]
lemma coneOfAddOpFunctorOne_π_app_succ {F : ℕᵒᵖ ⥤ C} (c : Cone (addOpFunctor 1 ⋙ F)) (k : ℕ) :
    (coneOfAddOpFunctorOne c).π.app (op (k + 1)) = c.π.app (op k) :=
  rfl

end Succ

variable {C : Type*} [Category C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] [HasLimitsOfShape (Discrete ℕ) C]

/-- The cone `Pretriangulated.coneOfAddOpFunctorOne c` is a homotopy limit cone as soon as `c`
is. -/
lemma IsHomotopyLimit.coneOfAddOpFunctorOne {F : ℕᵒᵖ ⥤ C} {c : Cone (addOpFunctor 1 ⋙ F)}
    (hc : IsHomotopyLimit c) : IsHomotopyLimit (coneOfAddOpFunctorOne c) :=
  .of_whisker_addOpFunctor_one _ (hc.of_iso (Iso.refl _) _ (Iso.refl _) fun _ ↦ by
    simp only [Iso.refl_hom, NatTrans.id_app, comp_id, id_comp]
    rfl)

end CategoryTheory.Pretriangulated

namespace CochainComplex

variable {R : Type*} [Ring R] {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [Linear R 𝒜]
  {r : R} {X : CochainComplex 𝒜 ℤ}

/-- The *action map* `cone(r on X) ⟶ X` of a complex `X` killed by `r`: it vanishes on the
shifted copy of `X` and is the identity on the other one. -/
noncomputable def smulActionMap (h : r • 𝟙 X = 0) : mappingCone (r • 𝟙 X) ⟶ X :=
  mappingCone.desc _ 0 (𝟙 _) (by simp [h])

@[reassoc (attr := simp)]
lemma inr_smulActionMap (h : r • 𝟙 X = 0) : mappingCone.inr _ ≫ smulActionMap h = 𝟙 _ := by
  simp [smulActionMap]

@[reassoc (attr := simp)]
lemma inl_v_smulActionMap_f (h : r • 𝟙 X = 0) (p q : ℤ) (hpq : p + (-1) = q) :
    (mappingCone.inl (r • 𝟙 X)).v p q hpq ≫ (smulActionMap h).f q = 0 := by
  simp [smulActionMap]

end CochainComplex

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  {J : GrothendieckTopology C}

section Conservative

variable {A A' : Type (u + 1)} [CommRing A] [CommRing A'] (f : A →+* A')

/-- Derived restriction of scalars of sheaves reflects isomorphisms: it commutes with the
cohomology sheaves, and restriction of scalars of sheaves reflects isomorphisms. -/
lemma isIso_of_isIso_derivedRestrictScalars_map
    {M N : DerivedCategory (Sheaf J (ModuleCat.{u + 1} A'))} (g : M ⟶ N)
    [IsIso ((Sheaf.derivedRestrictScalars J f).map g)] : IsIso g := by
  rw [DerivedCategory.isIso_iff]
  intro n
  have : IsIso ((Sheaf.restrictScalars J f).map ((DerivedCategory.homologyFunctor _ n).map g)) :=
    (NatIso.isIso_map_iff (Functor.mapDerivedCategoryHomologyFunctorIso
      (Sheaf.restrictScalars J f) n) g).2 (by
        dsimp only [Functor.comp_map]
        infer_instance)
  exact isIso_of_reflects_iso _ (Sheaf.restrictScalars J f)

end Conservative

/-- Every object of the derived category of sheaves of modules over the zero ring is zero. -/
lemma isZero_of_subsingleton {A : Type (u + 1)} [CommRing A] [Subsingleton A]
    (N : DerivedCategory (Sheaf J (ModuleCat.{u + 1} A))) : IsZero N := by
  rw [IsZero.iff_id_eq_zero]
  calc 𝟙 N = (1 : A) • 𝟙 N := (one_smul _ _).symm
    _ = (0 : A) • 𝟙 N := by rw [Subsingleton.elim (1 : A) 0]
    _ = 0 := zero_smul _ _

section Action

variable {R B : Type (u + 1)} [CommRing R] [CommRing B] (ψ : R →+* B)

/-- Restriction of scalars of complexes of sheaves along `ψ : R →+* B`. -/
noncomputable abbrev resComplex :
    CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ ⥤
      CochainComplex (Sheaf J (ModuleCat.{u + 1} R)) ℤ :=
  (Sheaf.restrictScalars J ψ).mapHomologicalComplex (.up ℤ)

variable {ψ} {r : R} (hr : ψ r = 0)

omit [EssentiallySmall.{u + 1} C] in
include hr in
lemma smul_id_resComplex_obj (Y : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ) :
    r • 𝟙 ((resComplex ψ).obj Y) = 0 := by
  ext i : 1
  exact Sheaf.smul_id_restrictScalars_obj (J := J) ψ hr _

/-- The *action map* `cone(r on Res Y) ⟶ Res Y` of a complex `Y` of sheaves of `B`-modules, for
`r` killed by `ψ`: it vanishes on the shifted copy of `Res Y` and is the identity on the other
one. -/
noncomputable def restrictScalarsActionMap (Y : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ) :
    CochainComplex.mappingCone (r • 𝟙 ((resComplex ψ).obj Y)) ⟶ (resComplex ψ).obj Y :=
  CochainComplex.smulActionMap (smul_id_resComplex_obj hr Y)

@[reassoc (attr := simp)]
lemma inr_restrictScalarsActionMap (Y : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ) :
    CochainComplex.mappingCone.inr _ ≫ restrictScalarsActionMap hr Y = 𝟙 _ := by
  simp [restrictScalarsActionMap]

@[reassoc (attr := simp)]
lemma inl_v_restrictScalarsActionMap_f (Y : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ)
    (p q : ℤ) (hpq : p + (-1) = q) :
    (CochainComplex.mappingCone.inl (r • 𝟙 ((resComplex ψ).obj Y))).v p q hpq ≫
      (restrictScalarsActionMap hr Y).f q = 0 := by
  simp [restrictScalarsActionMap]

/-- The action map is natural in the complex of sheaves of `B`-modules. -/
@[reassoc]
lemma mappingCone_map_restrictScalarsActionMap
    {Y Y' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ} (f : Y ⟶ Y') :
    CochainComplex.mappingCone.map (r • 𝟙 ((resComplex ψ).obj Y))
        (r • 𝟙 ((resComplex ψ).obj Y')) ((resComplex ψ).map f) ((resComplex ψ).map f)
        (by simp) ≫ restrictScalarsActionMap hr Y' =
      restrictScalarsActionMap hr Y ≫ (resComplex ψ).map f := by
  refine CochainComplex.IsNormalizedAdicTower.mappingCone_hom_ext (fun p q hpq ↦ ?_) ?_
  · simp [CochainComplex.mappingCone.map]
  · simp [CochainComplex.mappingCone.map]

/-- Restriction of scalars `Q(Res Y) ⟶ Q(Res Y')` of a morphism `Q Y ⟶ Q Y'` of `D(J, B)`. -/
noncomputable def resQ {Y Y' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ}
    (g : Q.obj Y ⟶ Q.obj Y') : Q.obj ((resComplex ψ).obj Y) ⟶ Q.obj ((resComplex ψ).obj Y') :=
  (Sheaf.restrictScalars J ψ).mapDerivedCategoryFactors.inv.app Y ≫
    (Sheaf.derivedRestrictScalars J ψ).map g ≫
      (Sheaf.restrictScalars J ψ).mapDerivedCategoryFactors.hom.app Y'

omit hr

lemma resQ_comp {Y Y' Y'' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ}
    (g : Q.obj Y ⟶ Q.obj Y') (g' : Q.obj Y' ⟶ Q.obj Y'') :
    resQ (ψ := ψ) (g ≫ g') = resQ g ≫ resQ g' := by
  simp [resQ]

lemma resQ_Q_map {Y Y' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ} (f : Y ⟶ Y') :
    resQ (ψ := ψ) (Q.map f) = Q.map ((resComplex ψ).map f) :=
  Functor.mapDerivedCategoryFactors_inv_app_comp_map_comp_hom_app _ f

lemma resQ_inv {Y Y' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ}
    (g : Q.obj Y ⟶ Q.obj Y') [IsIso g] [IsIso (resQ (ψ := ψ) g)] :
    resQ (ψ := ψ) (inv g) = inv (resQ (ψ := ψ) g) := by
  refine IsIso.eq_inv_of_hom_inv_id (f := resQ (ψ := ψ) g) ?_
  rw [← resQ_comp, IsIso.hom_inv_id]
  simp [resQ]

lemma isIso_resQ {Y Y' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ}
    (g : Q.obj Y ⟶ Q.obj Y') [IsIso g] : IsIso (resQ (ψ := ψ) g) := by
  dsimp only [resQ]
  infer_instance

end Action

section Main

variable {R : Type (u + 1)} [CommRing R] {I : Ideal R}
  (L : ∀ n : ℕ, DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n))))
  (t : ∀ n : ℕ, L (n + 1) ⟶ (levelTransitionRestrictScalars J I n.le_succ).obj (L n))

/-- The strict model `n ↦ Res P_n` of a tower `L_n ∈ D(J, R ⧸ Iⁿ)`
(`DerivedCategory.towerFunctor`). -/
noncomputable abbrev quotientTowerFunctor :
    ℕᵒᵖ ⥤ CochainComplex (Sheaf J (ModuleCat.{u + 1} R)) ℤ :=
  towerFunctor (J := J) (A := fun n ↦ R ⧸ I ^ n)
    (fun h ↦ Ideal.Quotient.factor (Ideal.pow_le_pow_right h)) (fun n ↦ Ideal.Quotient.mk (I ^ n))
    (fun _ ↦ Ideal.Quotient.factor_comp_mk _) L t

/-- The identification of the levels of `DerivedCategory.quotientTowerFunctor` with the
restrictions of scalars of the given levels. -/
noncomputable abbrev quotientTowerFunctorIso (n : ℕ) :
    Q.obj ((quotientTowerFunctor L t).obj (op n)) ≅ (levelRestrictScalars J I n).obj (L n) :=
  towerFunctorIso (J := J) (A := fun n ↦ R ⧸ I ^ n)
    (fun h ↦ Ideal.Quotient.factor (Ideal.pow_le_pow_right h)) (fun n ↦ Ideal.Quotient.mk (I ^ n))
    (fun _ ↦ Ideal.Quotient.factor_comp_mk _) L t n

end Main

section Reduction

attribute [-instance] commShift₂CurriedTensor commShiftTensorLeft commShiftTensorRight
  isTriangulated_tensorLeft isTriangulated_tensorRight monoidalPreadditive monoidalLinear

variable (J) {R : Type (u + 1)} [CommRing R]

noncomputable local instance (priority := high) normalizedTowerBaseChangeMonoidalCategory :
    MonoidalCategory (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalCategory

noncomputable local instance (priority := high) normalizedTowerBaseChangeMonoidalPreadditive :
    MonoidalPreadditive (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalPreadditive

noncomputable local instance (priority := high) normalizedTowerBaseChangeMonoidalLinear :
    MonoidalLinear R (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  (sheafTensorStructure J R).monoidalLinear

noncomputable local instance (priority := high) normalizedTowerBaseChangeCommShift₂ :
    (curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).CommShift₂Int :=
  (sheafTensorStructure J R).commShift₂

noncomputable local instance (priority := high) normalizedTowerBaseChangeIsTriangulatedLeft
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ((curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).obj K).IsTriangulated :=
  (sheafTensorStructure J R).isTriangulated_tensorLeft K

noncomputable local instance (priority := high) normalizedTowerBaseChangeIsTriangulatedRight
    (K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :
    ((curriedTensor (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)))).flip.obj K).IsTriangulated :=
  (sheafTensorStructure J R).isTriangulated_tensorRight K

local instance normalizedTowerBaseChangeIsIsoε : IsIso (sheafTensorStructure J R).ε :=
  (sheafTensorStructure J R).isIso_ε

variable {J} {B : Type (u + 1)} [CommRing B] {ψ : R →+* B}
  {I : Ideal R} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ}) (n : ℕ)
  (hψ : ψ (ϖ ^ n) = 0)

/-- The reduction `Q(Res Y) ⊗ᴸ R ⧸ Iⁿ ⟶ Q(Res Y)` given by the action map. -/
noncomputable def reductionActionMap (Y : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ) :
    (reductionFunctor J I n).obj (Q.obj ((resComplex ψ).obj Y)) ⟶ Q.obj ((resComplex ψ).obj Y) :=
  (reductionConeIso hϖ hI n ((resComplex ψ).obj Y)).hom ≫ Q.map (restrictScalarsActionMap hψ Y)

/-- The reduction of the action map is natural with respect to the restrictions of scalars of
all morphisms of `D(J, B)`. -/
lemma reductionFunctor_map_comp_actionMap
    {Y Y' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ} (g : Q.obj Y ⟶ Q.obj Y') :
    (reductionFunctor J I n).map (resQ g) ≫ reductionActionMap hϖ hI n hψ Y' =
      reductionActionMap hϖ hI n hψ Y ≫ resQ g := by
  have hstrict {Z Z' : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ} (f : Z ⟶ Z') :
      (reductionFunctor J I n).map (resQ (ψ := ψ) (Q.map f)) ≫ reductionActionMap hϖ hI n hψ Z' =
        reductionActionMap hϖ hI n hψ Z ≫ resQ (Q.map f) := by
    rw [resQ_Q_map, reductionActionMap, reductionActionMap, ← assoc]
    erw [reductionConeIso_hom_naturality]
    rw [assoc, ← Functor.map_comp, mappingCone_map_restrictScalarsActionMap, Functor.map_comp,
      assoc]
  obtain ⟨X, s, hs, f, rfl⟩ := DerivedCategory.right_fac g
  have h₁ := hstrict s
  have : IsIso (resQ (ψ := ψ) (Q.map s)) := isIso_resQ _
  rw [resQ_comp, resQ_inv, Functor.map_comp, assoc, hstrict f, Functor.map_inv,
    IsIso.inv_comp_eq, ← assoc, h₁, assoc, IsIso.hom_inv_id_assoc]

variable {n} in
include hϖ in
/-- For a complex `P` of flat sheaves of `R`-modules and a surjection `f : R →+* B` with kernel
`(ϖⁿ)`, the strict reduction `P ⟶ Res(P ⧸ ϖⁿ)` followed by the action map is the
quasi-isomorphism `cone(ϖⁿ on P) ⟶ Res(P ⧸ ϖⁿ)` given by the short exact sequence
`0 ⟶ P ⟶ P ⟶ Res(P ⧸ ϖⁿ) ⟶ 0`. -/
lemma isIso_Q_map_mappingCone_map_comp_restrictScalarsActionMap (f : R →+* B)
    (hf : Function.Surjective f) (hker : RingHom.ker f = Ideal.span {ϖ ^ n}) (hfϖ : f (ϖ ^ n) = 0)
    (P : CochainComplex (Sheaf J (ModuleCat.{u + 1} R)) ℤ)
    (hP : ∀ i, ObjectProperty.flat (P.X i)) :
    IsIso (Q.map (CochainComplex.mappingCone.map (ϖ ^ n • 𝟙 P)
      (ϖ ^ n • 𝟙 ((resComplex f).obj
        (((Sheaf.reductionDatum J f hf (ϖ ^ n) hker).Φ.mapHomologicalComplex (.up ℤ)).obj P)))
      ((Sheaf.reductionDatum J f hf (ϖ ^ n) hker).complexMap P)
      ((Sheaf.reductionDatum J f hf (ϖ ^ n) hker).complexMap P) (by simp) ≫
        restrictScalarsActionMap hfϖ _)) := by
  let D := Sheaf.reductionDatum J f hf (ϖ ^ n) hker
  have hzero : (ϖ ^ n • 𝟙 P) ≫ D.complexMap P = 0 := by
    ext i : 1
    exact D.σ_comp_r (P.X i)
  let S := ShortComplex.mk _ _ hzero
  have hS : S.ShortExact := by
    refine HomologicalComplex.shortExact_of_degreewise_shortExact _ fun i ↦ ?_
    have hex : Function.Exact (fun b : R ↦ 0 * b) (fun b : R ↦ ϖ ^ n * b) := by
      intro x
      refine ⟨fun hx ↦ ⟨0, ?_⟩, ?_⟩
      · simp [(mem_nonZeroDivisors_iff.1 (pow_mem hϖ n)).1 x hx]
      · rintro ⟨y, rfl⟩
        simp
    have hmono := (Sheaf.exact_smul_of_flat J (hP i) 0 (ϖ ^ n) (by simp) hex).mono_g (by simp)
    exact
      { exact := D.exact (P.X i)
        mono_f := hmono
        epi_g := D.epi_r (P.X i) }
  have := CochainComplex.mappingCone.quasiIso_descShortComplex hS
  have heq : CochainComplex.mappingCone.map (ϖ ^ n • 𝟙 P)
      (ϖ ^ n • 𝟙 ((resComplex f).obj ((D.Φ.mapHomologicalComplex (.up ℤ)).obj P)))
      (D.complexMap P) (D.complexMap P) (by simp) ≫ restrictScalarsActionMap hfϖ _ =
      CochainComplex.mappingCone.descShortComplex S := by
    refine CochainComplex.IsNormalizedAdicTower.mappingCone_hom_ext (fun p q hpq ↦ ?_) ?_
    · have h₂ : (CochainComplex.mappingCone.inl (ϖ ^ n • 𝟙 P)).v p q hpq ≫
          (CochainComplex.mappingCone.descShortComplex S).f q = 0 := by
        erw [CochainComplex.mappingCone.inl_v_desc_f]
        simp
      rw [h₂]
      simp [CochainComplex.mappingCone.map]
    · simp [CochainComplex.mappingCone.map, CochainComplex.mappingCone.descShortComplex, S]
  rw [heq, isIso_Q_map_iff_quasiIso]
  infer_instance

/-- A morphism to a restricted complex is a derived base change if its reduction followed by
the action map is an isomorphism. -/
private lemma isDerivedBaseChange_of_isIso_reductionActionMap
    (hψsurj : Function.Surjective ψ) (hker : RingHom.ker ψ = Ideal.span {ϖ ^ n})
    (Y : CochainComplex (Sheaf J (ModuleCat.{u + 1} B)) ℤ)
    {K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
    (η : K ⟶ Q.obj ((resComplex ψ).obj Y))
    (hη : IsIso ((reductionFunctor J I n).map η ≫ reductionActionMap hϖ hI n hψ Y)) :
    Sheaf.IsDerivedBaseChange
      (η ≫ (Sheaf.restrictScalars J ψ).mapDerivedCategoryFactors.inv.app Y) := by
  let F := Sheaf.restrictScalars J ψ
  obtain ⟨M⟩ := KFlatModel.nonempty (J := J) K
  let D := Sheaf.reductionDatum J ψ hψsurj (ϖ ^ n) hker
  have := Sheaf.restrictScalars_full J ψ hψsurj
  let Z := (D.Φ.mapHomologicalComplex (.up ℤ)).obj M.P
  let u : Q.obj M.P ⟶ F.mapDerivedCategory.obj (Q.obj Z) :=
    Q.map (D.complexMap M.P) ≫ F.mapDerivedCategoryFactors.inv.app Z
  have hu : Sheaf.IsDerivedBaseChange u := fun N ↦ D.bijective_comp_map M.P M.isKFlat N
  obtain ⟨g, hg⟩ := (hu (Q.obj Y)).2
    (M.iso.hom ≫ η ≫ F.mapDerivedCategoryFactors.inv.app Y)
  replace hg : u ≫ F.mapDerivedCategory.map g =
      M.iso.hom ≫ η ≫ F.mapDerivedCategoryFactors.inv.app Y := hg
  have key : Q.map (D.complexMap M.P) ≫ resQ g = M.iso.hom ≫ η := by
    change Q.map (D.complexMap M.P) ≫ F.mapDerivedCategoryFactors.inv.app Z ≫
      F.mapDerivedCategory.map g ≫ F.mapDerivedCategoryFactors.hom.app Y = _
    rw [← assoc, ← assoc, hg, assoc, assoc, Iso.inv_hom_id_app]
    erw [comp_id]
  have hred : (reductionFunctor J I n).map M.iso.hom ≫
      ((reductionFunctor J I n).map η ≫ reductionActionMap hϖ hI n hψ Y) =
      ((reductionConeIso hϖ hI n M.P).hom ≫
        Q.map (CochainComplex.mappingCone.map (ϖ ^ n • 𝟙 M.P)
          (ϖ ^ n • 𝟙 ((resComplex ψ).obj Z))
          (D.complexMap M.P) (D.complexMap M.P) (by simp) ≫
            restrictScalarsActionMap hψ Z)) ≫ resQ g := by
    rw [← Functor.map_comp_assoc, ← key, Functor.map_comp, assoc,
      reductionFunctor_map_comp_actionMap hϖ hI n hψ g, reductionActionMap, ← assoc, ← assoc]
    erw [reductionConeIso_hom_naturality]
    simp
    rfl
  have hW := isIso_Q_map_mappingCone_map_comp_restrictScalarsActionMap hϖ
    ψ hψsurj hker hψ M.P M.flat
  let W := (reductionConeIso hϖ hI n M.P).hom ≫
    Q.map (CochainComplex.mappingCone.map (ϖ ^ n • 𝟙 M.P)
      (ϖ ^ n • 𝟙 ((resComplex ψ).obj Z))
      (D.complexMap M.P) (D.complexMap M.P) (by simp) ≫ restrictScalarsActionMap hψ Z)
  have : IsIso (W ≫ resQ g) := by
    rw [← hred]
    infer_instance
  have : IsIso (resQ (ψ := ψ) g) := IsIso.of_isIso_comp_left W _
  have : IsIso (F.mapDerivedCategory.map g) := by
    have : IsIso (F.mapDerivedCategoryFactors.inv.app Z ≫
        F.mapDerivedCategory.map g ≫ F.mapDerivedCategoryFactors.hom.app Y) :=
      ‹IsIso (resQ (ψ := ψ) g)›
    have : IsIso (F.mapDerivedCategory.map g ≫ F.mapDerivedCategoryFactors.hom.app Y) :=
      IsIso.of_isIso_comp_left (F.mapDerivedCategoryFactors.inv.app Z) _
    exact IsIso.of_isIso_comp_right _ (F.mapDerivedCategoryFactors.hom.app Y)
  have : IsIso g := isIso_of_isIso_derivedRestrictScalars_map ψ g
  have heq : η ≫ F.mapDerivedCategoryFactors.inv.app Y =
      M.iso.symm.hom ≫ u ≫ F.mapDerivedCategory.map (asIso g).hom := by
    rw [asIso_hom, hg]
    simp
  rw [heq]
  exact (hu.comp_map_iso (asIso g)).of_iso M.iso.symm

include hϖ hI in
/-- **The legs of the derived limit of a normalized tower are derived base changes.** Let
`L_n ∈ D(J, R ⧸ Iⁿ)` be a tower whose transitions `t_n : L_{n+1} ⟶ Res L_n` exhibit `L_n` as
the derived base change `L_{n+1} ⊗ᴸ R ⧸ Iⁿ`, and let `c` be a homotopy limit cone over its
strict model `n ↦ Res P_n` (`DerivedCategory.quotientTowerFunctor`). Then each leg
`c.pt ⟶ Res L_n` exhibits `L_n` as the derived base change `c.pt ⊗ᴸ_R R ⧸ Iⁿ`. -/
theorem isDerivedBaseChange_π_comp_quotientTowerFunctorIso_hom
    (L : ∀ n : ℕ, DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n))))
    (t : ∀ n : ℕ, L (n + 1) ⟶ (levelTransitionRestrictScalars J I n.le_succ).obj (L n))
    (ht : ∀ n, Sheaf.IsDerivedBaseChange (t n)) {c : Cone (quotientTowerFunctor L t ⋙ Q)}
    (hc : IsHomotopyLimit c) :
    Sheaf.IsDerivedBaseChange (c.π.app (op n) ≫ (quotientTowerFunctorIso L t n).hom) := by
  have hT := isNormalizedAdicTower_towerFunctor (J := J) (A := fun n ↦ R ⧸ I ^ n)
    (fun h ↦ Ideal.Quotient.factor (Ideal.pow_le_pow_right h)) (fun n ↦ Ideal.Quotient.mk (I ^ n))
    (fun _ ↦ Ideal.Quotient.factor_comp_mk _) (fun _ _ ↦ Ideal.Quotient.factor_comp _ _)
    (Ideal.Quotient.mk_pow_eq_zero_of_eq_span hI) (Ideal.Quotient.exact_mul_mk_pow hϖ hI)
    (fun _ ↦ Ideal.Quotient.factor_surjective _) (Ideal.Quotient.ker_factor_pow_eq_span hI) L t ht
  let T := quotientTowerFunctor L t
  have hiso : IsIso ((reductionFunctor J I n).map (c.π.app (op n)) ≫
      (reductionConeIso hϖ hI n (T.obj (op n))).hom ≫
        Q.map (hT.coneToLevel (k := n) (n := n) (N := n) le_rfl le_rfl)) := by
    rw [reduction_comp_coneToLevel_eq hϖ hI hT le_rfl le_rfl (Nat.le_add_left n 0)]
    exact isIso_reduction_comp_coneToLevel hϖ hI hT hc n
  let Mn := towerModel (J := J) (A := fun n ↦ R ⧸ I ^ n)
    (φ := fun n ↦ Ideal.Quotient.factor (Ideal.pow_le_pow_right n.le_succ)) L t n
  have hψn : Ideal.Quotient.mk (I ^ n) (ϖ ^ n) = 0 := Ideal.Quotient.mk_pow_eq_zero_of_eq_span hI n
  have hcone : hT.coneToLevel (k := n) (n := n) (N := n) le_rfl le_rfl =
      CochainComplex.smulActionMap (hT.smul_eq_zero n) := by
    refine CochainComplex.IsNormalizedAdicTower.mappingCone_hom_ext (fun p q hpq ↦ ?_) ?_
    · simp
    · rw [CochainComplex.IsNormalizedAdicTower.inr_coneToLevel, CochainComplex.inr_smulActionMap]
      exact T.map_id _
  rw [hcone] at hiso
  -- the leg, with target the restriction of scalars of the model `P_n` of `L_n`
  obtain ⟨π', hπ'⟩ : ∃ π' : c.pt ⟶ Q.obj ((resComplex (Ideal.Quotient.mk (I ^ n))).obj Mn.P),
      π' = c.π.app (op n) := ⟨_, rfl⟩
  replace hiso : IsIso ((reductionFunctor J I n).map π' ≫ reductionActionMap hϖ hI n hψn Mn.P) := by
    rw [hπ']
    exact hiso
  have hker : RingHom.ker (Ideal.Quotient.mk (I ^ n)) = Ideal.span {ϖ ^ n} := by
    rw [Ideal.mk_ker, hI, Ideal.span_singleton_pow]
  have hbase := isDerivedBaseChange_of_isIso_reductionActionMap hϖ hI n hψn
    Ideal.Quotient.mk_surjective hker Mn.P π' hiso
  have hbase' := hbase.comp_map_iso Mn.iso
  simpa only [hπ', quotientTowerFunctorIso, towerFunctorIso, Iso.trans_hom, Iso.symm_hom,
    Functor.mapIso_hom, Iso.app_inv, assoc] using hbase'

end Reduction

section Succ

variable {R : Type (u + 1)} [CommRing R] {I : Ideal R} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R)
  (hI : I = Ideal.span {ϖ})
  (M : ∀ n : ℕ, DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ (n + 1)))))
  (s : ∀ n : ℕ, M (n + 1) ⟶ (levelTransitionRestrictScalars J I (n + 1).le_succ).obj (M n))

/-- The tower `n ↦ Res M_n` in `D(J, R)` of the restrictions of scalars of levels
`M_n ∈ D(J, R ⧸ Iⁿ⁺¹)` with transitions `s_n : M_{n+1} ⟶ Res M_n`. -/
noncomputable def succTowerRestrict : ℕᵒᵖ ⥤ DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)) :=
  Functor.ofOpSequence fun n ↦ (levelRestrictScalars J I (n + 2)).map (s n) ≫
    (levelRestrictScalarsCompIso J I (n + 1).le_succ).hom.app (M n)

open ZeroObject in
/-- The levels `M_n ∈ D(J, R ⧸ Iⁿ⁺¹)`, preceded by the zero object of `D(J, R ⧸ I⁰)`. -/
noncomputable def towerOfSucc : ∀ n : ℕ, DerivedCategory (Sheaf J (ModuleCat.{u + 1} (R ⧸ I ^ n)))
  | 0 => 0
  | n + 1 => M n

open ZeroObject in
/-- The transitions of `DerivedCategory.towerOfSucc`. -/
noncomputable def towerOfSuccMap : ∀ n : ℕ,
    towerOfSucc M (n + 1) ⟶ (levelTransitionRestrictScalars J I n.le_succ).obj (towerOfSucc M n)
  | 0 => 0
  | n + 1 => s n

variable {M s} in
lemma isDerivedBaseChange_towerOfSuccMap (hs : ∀ n, Sheaf.IsDerivedBaseChange (s n)) :
    ∀ n, Sheaf.IsDerivedBaseChange (towerOfSuccMap M s n)
  | 0 => fun N ↦ by
    have : Subsingleton (R ⧸ I ^ 0) := Ideal.Quotient.subsingleton_iff.2 (by simp)
    have hN := isZero_of_subsingleton N
    refine ⟨fun g₁ g₂ _ ↦ hN.eq_of_tgt _ _, fun g ↦ ⟨0, ?_⟩⟩
    exact ((levelTransitionRestrictScalars J I (Nat.le_succ 0)).map_isZero hN).eq_of_tgt _ _
  | n + 1 => hs n

/-- The comparison of `DerivedCategory.succTowerRestrict` with the shifted strict model of
`DerivedCategory.towerOfSucc`. -/
noncomputable def succTowerRestrictToStrict :
    succTowerRestrict M s ⟶
      addOpFunctor 1 ⋙ quotientTowerFunctor (towerOfSucc M) (towerOfSuccMap M s) ⋙ Q :=
  NatTrans.ofOpSequence
    (fun n ↦ (quotientTowerFunctorIso (towerOfSucc M) (towerOfSuccMap M s) (n + 1)).inv) fun n ↦ by
    have h := Q_map_towerFunctor_map_comp_towerFunctorIso_hom (J := J)
      (A := fun n ↦ R ⧸ I ^ n) (fun h ↦ Ideal.Quotient.factor (Ideal.pow_le_pow_right h))
      (fun n ↦ Ideal.Quotient.mk (I ^ n)) (fun _ ↦ Ideal.Quotient.factor_comp_mk _)
      (towerOfSucc M) (towerOfSuccMap M s) (n + 1)
    unfold succTowerRestrict
    erw [Functor.ofOpSequence_map_homOfLE_succ]
    rw [Iso.comp_inv_eq, assoc]
    erw [h]
    simp only [Iso.inv_hom_id_assoc]
    rfl

instance : IsIso (succTowerRestrictToStrict M s) := by
  have : ∀ n, IsIso ((succTowerRestrictToStrict M s).app n) := fun n ↦ by
    rw [succTowerRestrictToStrict, NatTrans.ofOpSequence_app]
    infer_instance
  exact NatIso.isIso_of_isIso_app _

include hϖ hI in
/-- **The legs of the derived limit of a normalized tower are derived base changes.** Let
`M_n ∈ D(J, R ⧸ Iⁿ⁺¹)` be levels with transitions `s_n : M_{n+1} ⟶ Res M_n` exhibiting `M_n`
as the derived base change `M_{n+1} ⊗ᴸ R ⧸ Iⁿ⁺¹`, and let `c` be a homotopy limit cone over the
tower `n ↦ Res M_n` of `D(J, R)`. Then each leg `c.pt ⟶ Res M_n` exhibits `M_n` as the derived
base change `c.pt ⊗ᴸ_R R ⧸ Iⁿ⁺¹`. -/
theorem isDerivedBaseChange_π_app_of_isHomotopyLimit
    (hs : ∀ n, Sheaf.IsDerivedBaseChange (s n)) {c : Cone (succTowerRestrict M s)}
    (hc : IsHomotopyLimit c) (n : ℕ) :
    Sheaf.IsDerivedBaseChange (f := Ideal.Quotient.mk (I ^ (n + 1))) (c.π.app (op n)) := by
  let α := succTowerRestrictToStrict M s
  let c₁ : Cone (addOpFunctor 1 ⋙ quotientTowerFunctor (towerOfSucc M) (towerOfSuccMap M s) ⋙ Q) :=
    { pt := c.pt, π := c.π ≫ α }
  have hc₁ : IsHomotopyLimit c₁ := hc.of_iso (asIso α) c₁ (Iso.refl _) fun _ ↦ by simp [c₁]
  have h := isDerivedBaseChange_π_comp_quotientTowerFunctorIso_hom hϖ hI (n + 1) _ _
    (isDerivedBaseChange_towerOfSuccMap hs) hc₁.coneOfAddOpFunctorOne
  have e : (coneOfAddOpFunctorOne c₁).π.app (op (n + 1)) ≫
      (quotientTowerFunctorIso (towerOfSucc M) (towerOfSuccMap M s) (n + 1)).hom =
      c.π.app (op n) := by
    simp [c₁, α, succTowerRestrictToStrict, NatTrans.ofOpSequence_app]
  rw [e] at h
  exact h

end Succ

end DerivedCategory
