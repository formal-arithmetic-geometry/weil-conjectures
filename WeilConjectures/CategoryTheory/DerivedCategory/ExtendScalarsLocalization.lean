module

public import WeilConjectures.CategoryTheory.DerivedCategory.FlatExtendScalars
public import WeilConjectures.CategoryTheory.DerivedCategory.ProjectiveSingle
public import WeilConjectures.CategoryTheory.DerivedCategory.RationalizationLift

/-!
# Extension of scalars to a localization on `R[n]`

Let `K` be a field which is a localization of a commutative ring `R` at a submonoid `M`. The
derived extension of scalars `D(R) ⥤ D(K)` induces a bijection, up to `M`, on the morphisms
`R ⟶ R[n]` (`ModuleCat.locHomBijective_derivedExtendScalars_single`): both sides vanish for
`n ≠ 0`, and for `n = 0` this is the localization map `R ⟶ K`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace DerivedCategory

variable {A : Type (u + 1)} [CommRing A] {V : ModuleCat.{u + 1} A}

/-- If a module `V` is generated by `v₀`, every endomorphism of `V[0]` is a scalar. -/
lemma exists_eq_smul_id_singleFunctor (v₀ : V) (hgen : ∀ v : V, ∃ c : A, v = c • v₀)
    (g : (singleFunctor (ModuleCat.{u + 1} A) 0).obj V ⟶ (singleFunctor _ 0).obj V) :
    ∃ c : A, g = c • 𝟙 _ := by
  obtain ⟨φ, rfl⟩ := (singleFunctor (ModuleCat.{u + 1} A) 0).map_surjective g
  obtain ⟨c, hc⟩ := hgen (φ v₀)
  refine ⟨c, ?_⟩
  have : φ = c • 𝟙 V := by
    ext v
    obtain ⟨d, rfl⟩ := hgen v
    simp only [map_smul, hc, ModuleCat.hom_smul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply, smul_smul, mul_comm]
  rw [this, Functor.map_smul, CategoryTheory.Functor.map_id]

/-- If a linear form `ε` on `V` takes the value `1` at `v₀`, the scalar `c` acts by zero on
`V[0]` only if `c = 0`. -/
lemma eq_zero_of_smul_id_singleFunctor_eq_zero (v₀ : V) (ε : V →ₗ[A] A) (hε : ε v₀ = 1) {c : A}
    (h : c • 𝟙 ((singleFunctor (ModuleCat.{u + 1} A) 0).obj V) = 0) : c = 0 := by
  have h' : c • 𝟙 V = 0 := (singleFunctor (ModuleCat.{u + 1} A) 0).map_injective (by
    rw [Functor.map_smul, CategoryTheory.Functor.map_id, h, Functor.map_zero])
  have := congr_arg (fun φ : V ⟶ V ↦ ε (φ v₀)) h'
  simpa [hε] using this

end DerivedCategory

namespace ModuleCat

open ChangeOfRings

variable {R S : Type (u + 1)} [CommRing R] [CommRing S] (f : R →+* S)

set_option backward.isDefEq.respectTransparency false in
/-- The extension of scalars of `R` is generated by `1 ⊗ 1`. -/
lemma exists_eq_smul_one_tmul_one (v : (extendScalars.{u + 1, u + 1, u + 1} f).obj (of R R)) :
    ∃ c : S, v = c • ((1 : S) ⊗ₜ[R, f] (1 : R)) := by
  letI : Module R S := Module.compHom S f
  change TensorProduct R S R at v
  induction v using TensorProduct.induction_on with
  | zero => exact ⟨0, by rw [zero_smul]⟩
  | tmul s r =>
    refine ⟨s * f r, ?_⟩
    change s ⊗ₜ[R, f] r = (s * f r) • ((1 : S) ⊗ₜ[R, f] (1 : R))
    rw [ExtendScalars.smul_tmul, mul_one]
    have : r = r • (1 : R) := by simp
    conv_lhs => rw [this]
    exact (TensorProduct.smul_tmul r s (1 : R)).symm.trans (by rw [mul_comm]; rfl)
  | add x y hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨d, hd⟩ := hy
    exact ⟨c + d, by rw [hc, hd, add_smul]⟩

set_option backward.isDefEq.respectTransparency false in
/-- The morphism `R ⟶ S` of `R`-modules. -/
noncomputable def selfHom : of R R ⟶ (restrictScalars.{u + 1, u + 1, u + 1} f).obj (of S S) :=
  ofHom
    { toFun := fun r ↦ (f r : S)
      map_add' := f.map_add
      map_smul' := fun r x ↦ by
        simp only [smul_eq_mul, map_mul, RingHom.id_apply]
        rfl }

/-- The linear form on the extension of scalars of `R` sending `s ⊗ r` to `s f(r)`. -/
noncomputable def extendScalarsSelfForm :
    (extendScalars.{u + 1, u + 1, u + 1} f).obj (of R R) →ₗ[S] S :=
  (((extendRestrictScalarsAdj.{u + 1, u + 1, u + 1} f).homEquiv _ (of S S)).symm
    (selfHom f)).hom

lemma extendScalarsSelfForm_one_tmul_one :
    extendScalarsSelfForm f ((1 : S) ⊗ₜ[R, f] (1 : R)) = 1 := by
  have := extendRestrictScalarsAdj_homEquiv_apply.{u + 1, u + 1, u + 1}
    (((extendRestrictScalarsAdj.{u + 1, u + 1, u + 1} f).homEquiv _ (of S S)).symm (selfHom f))
    (1 : R)
  rw [Equiv.apply_symm_apply] at this
  rw [extendScalarsSelfForm, ← this]
  exact f.map_one

end ModuleCat

end
