module

public import WeilConjectures.CategoryTheory.DerivedCategory.FlatExtendScalars
public import WeilConjectures.CategoryTheory.DerivedCategory.ProjectiveSingle
public import WeilConjectures.CategoryTheory.DerivedCategory.RationalizationLift

/-!
# Extension of scalars to a localization on `R[n]`

Let `K` be a field which is a localization of a commutative ring `R` at a submonoid `M`. The
derived extension of scalars `D(R) ⥤ D(K)` induces a bijection, up to `M`, on the morphisms
`R ⟶ R[n]` (`ModuleCat.locHomBijective_derivedExtendScalars_single`): both sides vanish for
`n ≠ 0`, and for `n = 0` this is the localization map `R ⟶ K`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace DerivedCategory

variable {A : Type (u + 1)} [CommRing A] {V : ModuleCat.{u + 1} A}

/-- If a module `V` is generated by `v₀`, every endomorphism of `V[0]` is a scalar. -/
lemma exists_eq_smul_id_singleFunctor (v₀ : V) (hgen : ∀ v : V, ∃ c : A, v = c • v₀)
    (g : (singleFunctor (ModuleCat.{u + 1} A) 0).obj V ⟶ (singleFunctor _ 0).obj V) :
    ∃ c : A, g = c • 𝟙 _ := by
  obtain ⟨φ, rfl⟩ := (singleFunctor (ModuleCat.{u + 1} A) 0).map_surjective g
  obtain ⟨c, hc⟩ := hgen (φ v₀)
  refine ⟨c, ?_⟩
  have : φ = c • 𝟙 V := by
    ext v
    obtain ⟨d, rfl⟩ := hgen v
    simp only [map_smul, hc, ModuleCat.hom_smul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply, smul_smul, mul_comm]
  rw [this, Functor.map_smul, CategoryTheory.Functor.map_id]

/-- If a linear form `ε` on `V` takes the value `1` at `v₀`, the scalar `c` acts by zero on
`V[0]` only if `c = 0`. -/
lemma eq_zero_of_smul_id_singleFunctor_eq_zero (v₀ : V) (ε : V →ₗ[A] A) (hε : ε v₀ = 1) {c : A}
    (h : c • 𝟙 ((singleFunctor (ModuleCat.{u + 1} A) 0).obj V) = 0) : c = 0 := by
  have h' : c • 𝟙 V = 0 := (singleFunctor (ModuleCat.{u + 1} A) 0).map_injective (by
    rw [Functor.map_smul, CategoryTheory.Functor.map_id, h, Functor.map_zero])
  have := congr_arg (fun φ : V ⟶ V ↦ ε (φ v₀)) h'
  simpa [hε] using this

end DerivedCategory

namespace ModuleCat

open ChangeOfRings

variable {R S : Type (u + 1)} [CommRing R] [CommRing S] (f : R →+* S)

set_option backward.isDefEq.respectTransparency false in
/-- The extension of scalars of `R` is generated by `1 ⊗ 1`. -/
lemma exists_eq_smul_one_tmul_one (v : (extendScalars.{u + 1, u + 1, u + 1} f).obj (of R R)) :
    ∃ c : S, v = c • ((1 : S) ⊗ₜ[R, f] (1 : R)) := by
  let : Module R S := Module.compHom S f
  change TensorProduct R S R at v
  induction v using TensorProduct.inductionOn with
  | tmul s r =>
    refine ⟨s * f r, ?_⟩
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    have : r = r • (1 : R) := by simp
    conv_lhs => rw [this]
    rw [← TensorProduct.smul_tmul]
    congr 1
    exact mul_comm (f r) s
  | add x y hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨d, hd⟩ := hy
    exact ⟨c + d, by rw [hc, hd, add_smul]⟩

set_option backward.isDefEq.respectTransparency false in
/-- The morphism `R ⟶ S` of `R`-modules. -/
noncomputable def selfHom : of R R ⟶ (restrictScalars.{u + 1, u + 1, u + 1} f).obj (of S S) :=
  let : Module R S := Module.compHom S f
  ofHom (X := R) (Y := S) { toFun := f, map_add' := f.map_add, map_smul' := f.map_mul }

/-- The linear form on the extension of scalars of `R` sending `s ⊗ r` to `s f(r)`. -/
noncomputable def extendScalarsSelfForm :
    (extendScalars.{u + 1, u + 1, u + 1} f).obj (of R R) →ₗ[S] S :=
  (((extendRestrictScalarsAdj.{u + 1, u + 1, u + 1} f).homEquiv _ (of S S)).symm
    (selfHom f)).hom

set_option backward.isDefEq.respectTransparency false in
lemma extendScalarsSelfForm_one_tmul_one :
    extendScalarsSelfForm f ((1 : S) ⊗ₜ[R, f] (1 : R)) = 1 := by
  have := extendRestrictScalarsAdj_homEquiv_apply.{u + 1, u + 1, u + 1}
    (((extendRestrictScalarsAdj.{u + 1, u + 1, u + 1} f).homEquiv _ (of S S)).symm (selfHom f))
    (1 : R)
  rw [Equiv.apply_symm_apply] at this
  rw [extendScalarsSelfForm, ← this]
  exact f.map_one

lemma extendScalarsSelfForm_smul (a : S) :
    extendScalarsSelfForm f (a • ((1 : S) ⊗ₜ[R, f] (1 : R))) = a := by
  rw [map_smul, extendScalarsSelfForm_one_tmul_one, smul_eq_mul, mul_one]

/-- The extension of scalars of `R` along `f : R →+* S` is `S`. -/
noncomputable def extendScalarsSelfIso :
    (extendScalars.{u + 1, u + 1, u + 1} f).obj (of R R) ≅ of S S :=
  (LinearEquiv.ofBijective (extendScalarsSelfForm f)
    ⟨fun v w h ↦ by
      obtain ⟨a, rfl⟩ := exists_eq_smul_one_tmul_one f v
      obtain ⟨b, rfl⟩ := exists_eq_smul_one_tmul_one f w
      rw [extendScalarsSelfForm_smul, extendScalarsSelfForm_smul] at h
      rw [h],
    fun c ↦ ⟨c • ((1 : S) ⊗ₜ[R, f] (1 : R)), extendScalarsSelfForm_smul f c⟩⟩).toModuleIso

/-- The derived extension of scalars of `R[0]` is `S[0]`. -/
noncomputable def derivedExtendScalarsSingleIso (hf : f.Flat) :
    (derivedExtendScalars f hf).obj ((DerivedCategory.singleFunctor _ 0).obj (of R R)) ≅
      (DerivedCategory.singleFunctor _ 0).obj (of S S) :=
  have : PreservesFiniteLimits (extendScalars.{u + 1, u + 1, u + 1} f) :=
    preservesFiniteLimits_extendScalars_of_flat hf
  ((extendScalars.{u + 1, u + 1, u + 1} f).mapDerivedCategorySingleFunctor 0).app (of R R) ≪≫
    (DerivedCategory.singleFunctor _ 0).mapIso (extendScalarsSelfIso f)


end ModuleCat

namespace DerivedCategory

variable {C : Type*} [Category* C] [Abelian C] [HasDerivedCategory C]

/-- For a projective `P` and `n ≠ 0`, there are no nonzero morphisms `P[0] ⟶ X[0]⟦n⟧`. -/
lemma eq_zero_of_singleFunctor_shift (P X : C) [Projective P] {n : ℤ} (hn : n ≠ 0)
    (φ : (singleFunctor C 0).obj P ⟶ ((singleFunctor C 0).obj X)⟦n⟧) : φ = 0 := by
  let e : ((singleFunctor C 0).obj X)⟦n⟧ ≅ (singleFunctor C (-n)).obj X :=
    ((singleFunctors C).shiftIso n (-n) 0 (by lia)).app X
  refine eq_zero_of_isZero_homology_zero P _ ?_ φ
  refine IsZero.of_iso ?_ ((homologyFunctor C 0).mapIso e)
  rcases lt_or_gt_of_ne hn with h | h
  · exact isZero_of_isGE _ (-n) 0 (by lia)
  · exact isZero_of_isLE _ (-n) 0 (by lia)

end DerivedCategory

namespace ModuleCat

open DerivedCategory

variable {R K : Type (u + 1)} [CommRing R] [Field K] [Algebra R K] (M : Submonoid R)
  [IsLocalization M K] (hf : (algebraMap R K).Flat)

/-- The derived extension of scalars to a localization `K` of `R` at `M` is bijective up to `M`
on the morphisms `R[0] ⟶ R[0]⟦n⟧`. -/
theorem locHomBijective_derivedExtendScalars_single (n : ℤ) :
    Rationalization.LocHomBijective M K (derivedExtendScalars (algebraMap R K) hf)
      ((singleFunctor (ModuleCat.{u + 1} R) 0).obj (of R R))
      (((singleFunctor (ModuleCat.{u + 1} R) 0).obj (of R R))⟦n⟧) := by
  let F := derivedExtendScalars (algebraMap R K) hf
  let S := (singleFunctor (ModuleCat.{u + 1} R) 0).obj (of R R)
  let V := (extendScalars.{u + 1, u + 1, u + 1} (algebraMap R K)).obj (of R R)
  have : PreservesFiniteLimits (extendScalars.{u + 1, u + 1, u + 1} (algebraMap R K)) :=
    preservesFiniteLimits_extendScalars_of_flat hf
  let e : F.obj S ≅ (singleFunctor _ 0).obj V :=
    ((extendScalars.{u + 1, u + 1, u + 1} (algebraMap R K)).mapDerivedCategorySingleFunctor
      0).app (of R R)
  have : Projective V := by
    change Projective (ModuleCat.of K _)
    infer_instance
  by_cases hn : n = 0
  · subst hn
    refine Rationalization.LocHomBijective.of_iso ?_ (Iso.refl S)
      ((shiftFunctorZero _ ℤ).app S).symm
    refine ⟨fun f hf₀ ↦ ?_, fun g ↦ ?_⟩
    · obtain ⟨c, rfl⟩ := exists_eq_smul_id_singleFunctor (1 : R)
        (fun v ↦ ⟨v, by simp⟩) f
      rw [derivedExtendScalars_map_smul_id] at hf₀
      have h₁ : algebraMap R K c • 𝟙 ((singleFunctor _ 0).obj V) = 0 := by
        rw [← Rationalization.smul_id_conj e, hf₀, zero_comp, comp_zero]
      have h₂ := eq_zero_of_smul_id_singleFunctor_eq_zero _ (extendScalarsSelfForm _)
        (extendScalarsSelfForm_one_tmul_one _) h₁
      obtain ⟨m, hm⟩ := IsLocalization.exists_of_eq (M := M) (x := c) (y := 0)
        (by rw [h₂, map_zero])
      refine ⟨m, m.2, ?_⟩
      rw [smul_smul, mul_zero] at *
      rw [hm, zero_smul]
    · obtain ⟨x, hx⟩ := exists_eq_smul_id_singleFunctor _ (exists_eq_smul_one_tmul_one _)
        (e.inv ≫ g ≫ e.hom)
      obtain ⟨⟨r, m⟩, rfl⟩ := IsLocalization.mk'_surjective M x
      refine ⟨m, m.2, r • 𝟙 S, ?_⟩
      have hg : g = IsLocalization.mk' K r m • 𝟙 (F.obj S) := by
        rw [← Rationalization.smul_id_conj e.symm, Iso.symm_inv, Iso.symm_hom, ← hx]
        simp
      rw [derivedExtendScalars_map_smul_id, hg, smul_smul, IsLocalization.mk'_spec']
  · refine ⟨fun f _ ↦ ⟨1, M.one_mem, ?_⟩, fun g ↦ ⟨1, M.one_mem, 0, ?_⟩⟩
    · rw [eq_zero_of_singleFunctor_shift _ _ hn f, smul_zero]
    · have : g = 0 := by
        rw [← cancel_epi e.inv, comp_zero]
        rw [← cancel_mono ((F.commShiftIso n).hom.app S ≫ e.hom⟦n⟧'), zero_comp]
        exact eq_zero_of_singleFunctor_shift _ _ hn _
      rw [this, smul_zero, Functor.map_zero]

end ModuleCat
