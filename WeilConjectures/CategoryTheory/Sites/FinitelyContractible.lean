/-!
# Finitely contractible objects of a site

An object `X` of a site `(C, J)` is *finitely contractible* if every covering sieve of `X`
contains a finite covering family of pairwise disjoint monomorphisms
(`CategoryTheory.GrothendieckTopology.IsFinitelyContractible`). For instance, in the small
pro-étale site, the spectrum of a w-contractible ring is finitely contractible (Stacks 0990).

The main result is that sections over a finitely contractible object preserve epimorphisms of
sheaves with values in any abelian category `A`
(`CategoryTheory.GrothendieckTopology.epi_app_of_isFinitelyContractible`). Since we have no
elements at our disposal, we argue as follows: the presheaf cokernel `K` of an epimorphism of
sheaves `φ : F ⟶ G` takes finite disjoint covers to finite products, as `F` and `G` do. Hence its
restriction to the full subcategory of finitely contractible objects is a sheaf for the
restricted topology, and its right Kan extension `H` along this subcategory is a sheaf on `C`.
The unit `K ⟶ H` vanishes since `φ` is an epimorphism of sheaves, but it is a split monomorphism
on sections over finitely contractible objects, so `K` vanishes there.

## Main definitions

- `CategoryTheory.GrothendieckTopology.IsFiniteDisjointCover`: a finite covering family of
  pairwise disjoint monomorphisms.
- `CategoryTheory.GrothendieckTopology.IsFinitelyContractible`: every covering sieve contains a
  finite disjoint cover.

## Main results

- `CategoryTheory.GrothendieckTopology.IsFinitelyContractible.of_isFiniteDisjointCover`: the
  members of a finite disjoint cover of a finitely contractible object are finitely
  contractible.
- `CategoryTheory.GrothendieckTopology.epi_app_of_isFinitelyContractible`: sections over a
  finitely contractible object preserve epimorphisms of sheaves.
-/

@[expose] public section

universe w v u u'

open CategoryTheory Limits Opposite

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- A finite family of monomorphisms `f i : Y i ⟶ X` which covers `X` and is pairwise disjoint:
any object mapping compatibly to `Y i` and `Y j` with `i ≠ j` is covered by the empty sieve. -/
structure IsFiniteDisjointCover {X : C} {ι : Type} (Y : ι → C) (f : ∀ i, Y i ⟶ X) : Prop where
  finite : Finite ι
  mem : Sieve.ofArrows Y f ∈ J X
  mono (i : ι) : Mono (f i)
  disjoint (i j : ι) (hij : i ≠ j) (Z : C) (a : Z ⟶ Y i) (b : Z ⟶ Y j) (h : a ≫ f i = b ≫ f j) :
    ⊥ ∈ J Z

/-- An object `X` is finitely contractible if every covering sieve of `X` contains the members
of a finite disjoint cover of `X`. -/
def IsFinitelyContractible (X : C) : Prop :=
  ∀ S ∈ J X, ∃ (ι : Type) (Y : ι → C) (f : ∀ i, Y i ⟶ X), J.IsFiniteDisjointCover Y f ∧
    ∀ i, S (f i)

variable {J}

/-- The members of a finite disjoint cover of a finitely contractible object are finitely
contractible. -/
lemma IsFinitelyContractible.of_isFiniteDisjointCover {X : C} (hX : J.IsFinitelyContractible X)
    {ι : Type} {Y : ι → C} {f : ∀ i, Y i ⟶ X} (hf : J.IsFiniteDisjointCover Y f) (i : ι) :
    J.IsFinitelyContractible (Y i) := by
  classical
  intro S hS
  -- the sieve of `X` generated by `S` and the other members of the cover
  let S' : Sieve X :=
    { arrows := fun Z g ↦ (∃ s : Z ⟶ Y i, S s ∧ g = s ≫ f i) ∨
        ∃ j, j ≠ i ∧ ∃ a : Z ⟶ Y j, g = a ≫ f j
      downward_closed := by
        rintro Z W g (⟨s, hs, rfl⟩ | ⟨j, hj, a, rfl⟩) h
        · exact Or.inl ⟨h ≫ s, S.downward_closed hs h, by simp⟩
        · exact Or.inr ⟨j, hj, h ≫ a, by simp⟩ }
  have hS' : S' ∈ J X := by
    refine J.transitive hf.mem _ ?_
    rintro Z _ ⟨W, a, _, ⟨k⟩, rfl⟩
    rw [Sieve.pullback_comp]
    refine J.pullback_stable a ?_
    by_cases hk : k = i
    · subst hk
      exact J.superset_covering (fun Z s hs ↦ Or.inl ⟨s, hs, rfl⟩) hS
    · exact J.superset_covering (fun Z g _ ↦ Or.inr ⟨k, hk, g, rfl⟩) (J.top_mem _)
  obtain ⟨κ, Z, z, hz, hzS'⟩ := hX S' hS'
  have := hz.finite
  let good (k : κ) : Prop := ∃ s : Z k ⟶ Y i, S s ∧ z k = s ≫ f i
  let s (k : {k // good k}) : Z k.1 ⟶ Y i := k.2.choose
  have hs (k : {k // good k}) : S (s k) ∧ z k.1 = s k ≫ f i := k.2.choose_spec
  have := hf.mono i
  refine ⟨{k // good k}, fun k ↦ Z k.1, s, ⟨inferInstance, ?_, fun k ↦ ?_, ?_⟩, fun k ↦ (hs k).1⟩
  · refine J.transitive (J.pullback_stable (f i) hz.mem) _ ?_
    rintro T h ⟨_, c, _, ⟨k⟩, hc⟩
    by_cases hk : good k
    · have hh : h = c ≫ s ⟨k, hk⟩ := by
        rw [← cancel_mono (f i), ← hc, Category.assoc, ← (hs ⟨k, hk⟩).2]
      refine J.superset_covering (fun W g _ ↦ ?_) (J.top_mem _)
      rw [Sieve.pullback_apply, hh, ← Category.assoc]
      exact Sieve.downward_closed _
        (Sieve.ofArrows_mk (fun k : {k // good k} ↦ Z k.1) s ⟨k, hk⟩) _
    · obtain ⟨j, hj, a, ha⟩ := (hzS' k).resolve_left hk
      refine J.superset_covering bot_le (hf.disjoint j i hj T (c ≫ a) h ?_)
      rw [Category.assoc, ← ha, hc]
  · have : Mono (s k ≫ f i) := by
      rw [← (hs k).2]
      exact hz.mono k.1
    exact mono_of_mono _ (f i)
  · intro k l hkl W a b hab
    refine hz.disjoint k.1 l.1 (fun h ↦ hkl (Subtype.ext h)) W a b ?_
    rw [(hs k).2, (hs l).2, ← Category.assoc, hab, Category.assoc]

section Sheaf

variable {A : Type u'} [Category.{w} A]

/-- A sheaf turns a finite disjoint cover into a product: morphisms to the sections over `X` are
the families of morphisms to the sections over the members of the cover. -/
lemma IsFiniteDisjointCover.existsUnique_of_isSheaf {P : Cᵒᵖ ⥤ A} (hP : Presheaf.IsSheaf J P)
    {X : C} {ι : Type} {Y : ι → C} {f : ∀ i, Y i ⟶ X} (hf : J.IsFiniteDisjointCover Y f) {E : A}
    (x : ∀ i, E ⟶ P.obj (op (Y i))) :
    ∃! g : E ⟶ P.obj (op X), ∀ i, g ≫ P.map (f i).op = x i := by
  refine hP.existsUnique_amalgamation_ofArrows f hf.mem x fun W i j a b h ↦ ?_
  by_cases hij : i = j
  · subst hij
    have := hf.mono i
    obtain rfl := (cancel_mono (f i)).1 h
    rfl
  · exact hP.hom_ext ⟨⊥, hf.disjoint i j hij W a b h⟩ _ _ fun I ↦ (I.hf : False).elim

/-- The sections of a sheaf over an object covered by the empty sieve vanish. -/
lemma isZero_obj_of_bot_mem [Preadditive A] {P : Cᵒᵖ ⥤ A} (hP : Presheaf.IsSheaf J P) {Z : C}
    (hZ : ⊥ ∈ J Z) : IsZero (P.obj (op Z)) := by
  rw [IsZero.iff_id_eq_zero]
  exact hP.hom_ext ⟨⊥, hZ⟩ _ _ fun I ↦ (I.hf : False).elim

end Sheaf

section Biproduct

variable {A : Type u'} [Category.{w} A] [Preadditive A] [HasFiniteBiproducts A]

/-- A finite biproduct of cokernel coforks is a cokernel cofork. -/
noncomputable def isColimitBiproductMapCokernelCofork {ι : Type} [Finite ι]
    {F G K : ι → A} (φ : ∀ i, F i ⟶ G i) (π : ∀ i, G i ⟶ K i) (w : ∀ i, φ i ≫ π i = 0)
    (h : ∀ i, IsColimit (CokernelCofork.ofπ (π i) (w i))) :
    IsColimit (CokernelCofork.ofπ (f := biproduct.map φ) (biproduct.map π) (by
      ext i j
      simp [w])) := by
  have := Fintype.ofFinite ι
  refine CokernelCofork.IsColimit.ofπ _ _
    (fun {T} g hg ↦ biproduct.desc fun i ↦ (h i).desc (CokernelCofork.ofπ (biproduct.ι G i ≫ g)
      (by rw [← biproduct.ι_map_assoc, hg, comp_zero]))) (fun {T} g hg ↦ ?_) ?_
  · ext i
    simp only [biproduct.ι_map_assoc, biproduct.ι_desc]
    exact (h i).fac _ WalkingParallelPair.one
  · intro T g hg m hm
    ext i
    rw [biproduct.ι_desc]
    refine (h i).hom_ext fun j ↦ ?_
    have hfac := (h i).fac (CokernelCofork.ofπ (biproduct.ι G i ≫ g)
      (by rw [← biproduct.ι_map_assoc, hg, comp_zero])) WalkingParallelPair.one
    cases j
    · simp [reassoc_of% (w i)]
    · dsimp at hfac ⊢
      rw [hfac, ← hm, biproduct.ι_map_assoc]

end Biproduct

section Cokernel

variable {A : Type u'} [Category.{w} A] [Abelian A]

/-- Let `φ : F ⟶ G` be a morphism of sheaves and `π : G ⟶ K` a morphism of presheaves which is
objectwise a cokernel of `φ`. Then `K` turns finite disjoint covers into products. -/
lemma IsFiniteDisjointCover.bijective_of_cokernel {F G K : Cᵒᵖ ⥤ A}
    (hF : Presheaf.IsSheaf J F) (hG : Presheaf.IsSheaf J G) (φ : F ⟶ G) (π : G ⟶ K)
    (w : φ ≫ π = 0)
    (hπ : ∀ V, IsColimit (CokernelCofork.ofπ (f := φ.app V) (π.app V)
      (by rw [← NatTrans.comp_app, w]; rfl)))
    {X : C} {ι : Type} {Y : ι → C} {f : ∀ i, Y i ⟶ X} (hf : J.IsFiniteDisjointCover Y f)
    (E : A) :
    Function.Bijective fun (x : E ⟶ K.obj (op X)) (i : ι) ↦ x ≫ K.map (f i).op := by
  have := hf.finite
  have := Fintype.ofFinite ι
  -- the comparison maps from sections over `X` to the biproduct of the sections over the `Y i`
  let α (P : Cᵒᵖ ⥤ A) : P.obj (op X) ⟶ ⨁ fun i ↦ P.obj (op (Y i)) :=
    biproduct.lift fun i ↦ P.map (f i).op
  have hα {P Q : Cᵒᵖ ⥤ A} (ψ : P ⟶ Q) :
      ψ.app (op X) ≫ α Q = α P ≫ biproduct.map fun i ↦ ψ.app (op (Y i)) := by
    ext i
    simp [α]
  have hiso {P : Cᵒᵖ ⥤ A} (hP : Presheaf.IsSheaf J P) : IsIso (α P) := by
    refine isIso_of_yoneda_map_bijective _ fun T ↦ ⟨fun x y hxy ↦ ?_, fun y ↦ ?_⟩
    · refine (hf.existsUnique_of_isSheaf hP fun i ↦ x ≫ P.map (f i).op).unique
        (fun i ↦ rfl) fun i ↦ ?_
      have := congrArg (· ≫ biproduct.π _ i) hxy
      simpa [α] using this.symm
    · obtain ⟨g, hg, -⟩ := hf.existsUnique_of_isSheaf hP fun i ↦ y ≫ biproduct.π _ i
      refine ⟨g, ?_⟩
      ext i
      simpa [α] using hg i
  have := hiso hF
  have := hiso hG
  -- the biproduct of the cokernels is the cokernel of the biproduct
  have hc := isColimitBiproductMapCokernelCofork (fun i ↦ φ.app (op (Y i)))
    (fun i ↦ π.app (op (Y i))) (fun i ↦ by rw [← NatTrans.comp_app, w]; rfl) fun i ↦ hπ _
  have hzero : biproduct.map (fun i ↦ φ.app (op (Y i))) ≫ inv (α G) ≫ π.app (op X) = 0 := by
    rw [← cancel_epi (α F), ← Category.assoc, ← Category.assoc, ← hα, Category.assoc,
      IsIso.hom_inv_id_assoc, ← NatTrans.comp_app, w, comp_zero]
    rfl
  let β : (⨁ fun i ↦ K.obj (op (Y i))) ⟶ K.obj (op X) :=
    hc.desc (CokernelCofork.ofπ _ hzero)
  have hβ : (biproduct.map fun i ↦ π.app (op (Y i))) ≫ β = inv (α G) ≫ π.app (op X) :=
    hc.fac _ WalkingParallelPair.one
  have hαK : IsIso (α K) := by
    refine ⟨β, ?_, ?_⟩
    · refine (CokernelCofork.IsColimit.isColimit_π_epi (hπ (op X))).left_cancellation _ _ ?_
      dsimp only [Cofork.ofπ_pt, Cofork.π_ofπ]
      rw [reassoc_of% (hα π), hβ, IsIso.hom_inv_id_assoc, Category.comp_id]
    · refine (CokernelCofork.IsColimit.isColimit_π_epi hc).left_cancellation _ _ ?_
      dsimp only [Cofork.ofπ_pt, Cofork.π_ofπ]
      rw [reassoc_of% hβ, hα π, IsIso.inv_hom_id_assoc, Category.comp_id]
  -- conclude with the universal property of the biproduct
  have hbij : Function.Bijective fun (x : E ⟶ K.obj (op X)) ↦ x ≫ α K :=
    ((isIso_iff_yoneda_map_bijective _).1 hαK) E
  let e : (E ⟶ ⨁ fun i ↦ K.obj (op (Y i))) ≃ ∀ i, E ⟶ K.obj (op (Y i)) :=
    { toFun := fun x i ↦ x ≫ biproduct.π _ i
      invFun := fun y ↦ biproduct.lift y
      left_inv := fun x ↦ by ext; simp
      right_inv := fun y ↦ by ext; simp }
  convert e.bijective.comp hbij using 1
  ext x i
  simp [e, α]

end Cokernel

section Ran

variable {A : Type u'} [Category.{w} A] [Abelian A]

variable (J) in
/-- The inclusion of the full subcategory of finitely contractible objects is locally cover
dense: every covering sieve of a finitely contractible object contains a finite disjoint cover,
whose members are again finitely contractible. -/
instance locallyCoverDense_isFinitelyContractible :
    (ObjectProperty.ι J.IsFinitelyContractible).LocallyCoverDense J where
  functorPushforward_functorPullback_mem := by
    intro X T
    obtain ⟨ι, Y, f, hf, hfT⟩ := X.property T.1 T.2
    refine J.superset_covering ?_ hf.mem
    rintro Z _ ⟨W, a, _, ⟨i⟩, rfl⟩
    refine ⟨⟨Y i, X.property.of_isFiniteDisjointCover hf i⟩, ObjectProperty.homMk (f i), a,
      ?_, rfl⟩
    exact hfT i

/-- The presheaf cokernel `K` of a morphism of sheaves, restricted to the finitely contractible
objects, is a sheaf for the restricted topology. -/
lemma isSheaf_restrictedTopology_of_cokernel {F G K : Cᵒᵖ ⥤ A}
    (hF : Presheaf.IsSheaf J F) (hG : Presheaf.IsSheaf J G) (φ : F ⟶ G) (π : G ⟶ K)
    (w : φ ≫ π = 0)
    (hπ : ∀ V, IsColimit (CokernelCofork.ofπ (f := φ.app V) (π.app V)
      (by rw [← NatTrans.comp_app, w]; rfl))) :
    Presheaf.IsSheaf ((ObjectProperty.ι J.IsFinitelyContractible).restrictedTopology J)
      ((ObjectProperty.ι J.IsFinitelyContractible).op ⋙ K) := by
  let ι := ObjectProperty.ι J.IsFinitelyContractible
  have hprod := fun {X : C} {κ : Type} {Y : κ → C} {f : ∀ i, Y i ⟶ X}
    (hf : J.IsFiniteDisjointCover Y f) (E : A) ↦
    IsFiniteDisjointCover.bijective_of_cokernel hF hG φ π w hπ hf E
  intro E W T hT
  rw [Functor.mem_restrictedTopology_iff] at hT
  obtain ⟨κ, Y, f, hf, hfT⟩ := W.property _ hT
  let Y' (k : κ) : J.IsFinitelyContractible.FullSubcategory :=
    ⟨Y k, W.property.of_isFiniteDisjointCover hf k⟩
  let f' (k : κ) : Y' k ⟶ W := ObjectProperty.homMk (f k)
  have hf'T (k : κ) : T (f' k) := by
    obtain ⟨Z, t, g, ht, hg⟩ := hfT k
    have : f' k = ObjectProperty.homMk g ≫ t := by
      ext
      exact hg
    rw [this]
    exact T.downward_closed ht _
  intro x hx
  have hxs := hx.to_sieveCompatible
  -- the amalgamation, obtained from the product decomposition over the cover `f`
  obtain ⟨t, ht⟩ := (hprod hf E).2 fun k ↦ x (f' k) (hf'T k)
  have ht' (k : κ) : t ≫ K.map (f k).op = x (f' k) (hf'T k) := congrFun ht k
  refine ⟨t, fun V g hg ↦ ?_, fun t' ht'' ↦ (hprod hf E).1 ?_⟩
  · -- check on a finite disjoint cover of `V` refining the pullback of `f` along `g`
    obtain ⟨λ', Z, z, hz, hzR⟩ := V.property _ (J.pullback_stable g.hom hf.mem)
    refine (hprod hz E).1 (funext fun l ↦ ?_)
    obtain ⟨_, c, _, ⟨k⟩, hc⟩ := hzR l
    let z' : (⟨Z l, V.property.of_isFiniteDisjointCover hz l⟩ :
      J.IsFinitelyContractible.FullSubcategory) ⟶ V := ObjectProperty.homMk (z l)
    let c' : (⟨Z l, V.property.of_isFiniteDisjointCover hz l⟩ :
      J.IsFinitelyContractible.FullSubcategory) ⟶ Y' k := ObjectProperty.homMk c
    have hzc : z' ≫ g = c' ≫ f' k := by
      ext
      exact hc.symm
    have h₁ := hxs g z' hg
    have h₂ := hxs (f' k) c' (hf'T k)
    have h₃ : x (z' ≫ g) (T.downward_closed hg z') = x (c' ≫ f' k)
        (T.downward_closed (hf'T k) c') := by
      congr 1
    simp only [Functor.comp_obj, Functor.op_obj, coyoneda_obj_obj, Functor.comp_map,
      Functor.op_map, coyoneda_obj_map] at h₁ h₂ ⊢
    change (t ≫ K.map g.hom.op) ≫ K.map (z l).op = x g hg ≫ K.map (z l).op
    rw [← h₁] at h₃
    rw [h₃, h₂, ← ht' k, Category.assoc, Category.assoc, ← K.map_comp, ← K.map_comp, ← op_comp,
      ← op_comp]
    change t ≫ K.map (z l ≫ g.hom).op = t ≫ K.map (c ≫ f k).op
    rw [hc]
  · funext k
    rw [ht' k]
    exact ht'' (f' k) (hf'T k)

variable [HasLimitsOfSize.{v, max u v} A]

/-- **Sections over finitely contractible objects preserve epimorphisms.** If `X` is finitely
contractible, then for every epimorphism of sheaves `φ : F ⟶ G` with values in an abelian
category, the morphism of sections `F(X) ⟶ G(X)` is an epimorphism. -/
theorem epi_app_of_isFinitelyContractible {F G : Sheaf J A} (φ : F ⟶ G) [Epi φ] {X : C}
    (hX : J.IsFinitelyContractible X) : Epi (φ.hom.app (op X)) := by
  let ι := ObjectProperty.ι J.IsFinitelyContractible
  let K := cokernel φ.hom
  let π : G.obj ⟶ K := cokernel.π φ.hom
  have w : φ.hom ≫ π = 0 := cokernel.condition _
  have hπ (V : Cᵒᵖ) : IsColimit (CokernelCofork.ofπ (f := φ.app V) (π.app V)
      (by rw [← NatTrans.comp_app, w]; rfl)) :=
    CokernelCofork.mapIsColimit _ (cokernelIsCokernel φ.hom) ((evaluation _ A).obj V)
  -- the right Kan extension of the restriction of `K` to finitely contractible objects
  have hK := isSheaf_restrictedTopology_of_cokernel F.property G.property φ.hom π w hπ
  have : ∀ (P : J.IsFinitelyContractible.FullSubcategoryᵒᵖ ⥤ A),
      ι.op.HasPointwiseRightKanExtension P := fun _ _ ↦ inferInstance
  let H : Cᵒᵖ ⥤ A := ι.op.ran.obj (ι.op ⋙ K)
  have hH : Presheaf.IsSheaf J H :=
    ι.ran_isSheaf_of_isCocontinuous _ J ⟨ι.op ⋙ K, hK⟩
  let u : K ⟶ H := (ι.op.ranAdjunction A).unit.app K
  -- the unit `K ⟶ H` vanishes, since `φ` is an epimorphism of sheaves
  have hu : u = 0 := by
    have : (ObjectProperty.homMk (π ≫ u) : G ⟶ ⟨H, hH⟩) = ObjectProperty.homMk 0 := by
      rw [← cancel_epi φ]
      ext : 1
      simp [reassoc_of% w]
    have h' : π ≫ u = π ≫ 0 := by
      rw [comp_zero]
      exact congrArg (fun ψ ↦ ψ.hom) this
    exact (cancel_epi π).1 h'
  -- but it is a split monomorphism on sections over `X`
  have hsplit := ι.op.ranCounit_app_app_ranAdjunction_unit_app_app K (op ⟨X, hX⟩)
  rw [hu] at hsplit
  have hz : IsZero (K.obj (op X)) := by
    rw [IsZero.iff_id_eq_zero]
    exact hsplit.symm.trans (by simp)
  exact Preadditive.epi_of_isZero_cokernel' _ (hπ (op X)) hz

end Ran

end CategoryTheory.GrothendieckTopology
