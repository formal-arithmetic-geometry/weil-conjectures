module

public import Mathlib.CategoryTheory.Sites.Grothendieck
public import WeilConjectures.AlgebraicTopology.SemiSimplicialObject.Basic

/-!
# Semi-simplicial hypercovers

Let `(C, J)` be a site. A semi-simplicial object `U` of `C` is a *hypercover* (of the terminal
object of the topos) if

* every object `W` is covered by objects admitting a map to `U.obj 0`; and
* for every compatible family `x : Fin (n + 2) → (W ⟶ U.obj n)` (the boundary of a would-be
  `(n + 1)`-simplex with values in `W`), the morphisms `g : W' ⟶ W` along which `x` lifts to an
  `(n + 1)`-simplex `W' ⟶ U.obj (n + 1)` form a covering sieve of `W`.

When `C` has finite limits and a terminal object `T`, this says that `U.obj 0 ⟶ T` and the
matching maps `U.obj (n + 1) ⟶ M_{n + 1}(U)` are coverings
(`CategoryTheory.SemiSimplicialObject.isHypercover_iff`): this is the usual notion of a
hypercover, except that we only use face maps. The degeneracies and the splitting of the
hypercovers of [Stacks, Tag 01G5] play no role in the computation of cohomology by hypercovers,
which only uses the cochain complex `C^•(U, F)` with the alternating sum of the face maps.

## Main definitions

- `CategoryTheory.SemiSimplicialObject.coverSieve`, `CategoryTheory.SemiSimplicialObject.liftSieve`:
  the sieves of local existence of `0`-simplices and of local lifts of boundaries.
- `CategoryTheory.SemiSimplicialObject.IsHypercover`: semi-simplicial hypercovers.
- `CategoryTheory.SemiSimplicialObject.const`: the constant semi-simplicial object, a hypercover
  when its value is a terminal object.
-/

@[expose] public section

universe v u

open CategoryTheory Limits Opposite

namespace CategoryTheory.SemiSimplicialObject

variable {C : Type u} [Category.{v} C]

section Sieves

variable (U : SemiSimplicialObject C)

/-- The sieve on `W` of the morphisms `W' ⟶ W` such that `W'` admits a morphism to `U.obj 0`. -/
def coverSieve (W : C) : Sieve W where
  arrows W' _ := Nonempty (W' ⟶ U.obj 0)
  downward_closed := fun ⟨y⟩ g ↦ ⟨g ≫ y⟩

/-- The sieve on `W` of the morphisms `g : W' ⟶ W` along which the family
`x : Fin (n + 2) → (W ⟶ U.obj n)` lifts to an `(n + 1)`-simplex `y : W' ⟶ U.obj (n + 1)`, i.e.
`y ≫ U.δ n i = g ≫ x i` for all `i`. -/
def liftSieve {n : ℕ} {W : C} (x : Fin (n + 2) → (W ⟶ U.obj n)) : Sieve W where
  arrows W' g := ∃ y : W' ⟶ U.obj (n + 1), ∀ i, y ≫ U.δ n i = g ≫ x i
  downward_closed := by
    rintro W' W'' g ⟨y, hy⟩ g'
    exact ⟨g' ≫ y, fun i ↦ by rw [Category.assoc, hy, Category.assoc]⟩

lemma mem_liftSieve_iff {n : ℕ} {W W' : C} (x : Fin (n + 2) → (W ⟶ U.obj n)) (g : W' ⟶ W) :
    U.liftSieve x g ↔ ∃ y : W' ⟶ U.obj (n + 1), ∀ i, y ≫ U.δ n i = g ≫ x i :=
  Iff.rfl

end Sieves

/-- A semi-simplicial object `U` of a site `(C, J)` is a *hypercover* if every object is covered
by objects mapping to `U.obj 0`, and every compatible family `Fin (n + 2) → (W ⟶ U.obj n)` lifts
locally on `W` to an `(n + 1)`-simplex of `U`. -/
structure IsHypercover (J : GrothendieckTopology C) (U : SemiSimplicialObject C) : Prop where
  /-- Every object is locally covered by objects mapping to `U.obj 0`. -/
  coverSieve_mem (W : C) : U.coverSieve W ∈ J W
  /-- Compatible boundaries lift locally. -/
  liftSieve_mem {n : ℕ} {W : C} (x : Fin (n + 2) → (W ⟶ U.obj n)) (hx : U.Compatible x) :
    U.liftSieve x ∈ J W

section Const

/-- The constant semi-simplicial object with value `X`: all face maps are identities. -/
@[simps]
def const (X : C) : SemiSimplicialObject C where
  obj _ := X
  δ _ _ := 𝟙 X
  δ_comp_δ _ _ _ _ := rfl

/-- The constant semi-simplicial object on a terminal object is a hypercover. -/
lemma isHypercover_const (J : GrothendieckTopology C) {T : C} (hT : IsTerminal T) :
    (const T).IsHypercover J where
  coverSieve_mem W := by
    convert J.top_mem W
    ext W' g
    simpa [coverSieve] using ⟨hT.from W'⟩
  liftSieve_mem {n W} x _ := by
    convert J.top_mem W
    ext W' g
    simp only [Sieve.top_apply, iff_true]
    exact ⟨g ≫ x 0, fun i ↦ by simpa using hT.hom_ext _ _⟩

end Const

section Matching

variable [HasFiniteLimits C] (J : GrothendieckTopology C) (U : SemiSimplicialObject C)

/-- The lifting sieve of a compatible family is the pullback, along the corresponding morphism to
the matching object, of the sieve generated by the matching map. -/
lemma liftSieve_eq_pullback {n : ℕ} {W : C} (x : Fin (n + 2) → (W ⟶ U.obj n))
    (hx : U.Compatible x) :
    U.liftSieve x =
      (Sieve.ofArrows (fun _ : Unit ↦ U.obj (n + 1)) (fun _ ↦ U.toMatching n)).pullback
      (U.matchingLift x hx) := by
  sorry

/-- In a category with finite limits and a terminal object `T`, `U` is a hypercover if and only
if `U.obj 0 ⟶ T` and all the matching maps `U.obj (n + 1) ⟶ M_{n + 1}(U)` are coverings. -/
lemma isHypercover_iff {T : C} (hT : IsTerminal T) :
    U.IsHypercover J ↔
      Sieve.ofArrows (fun _ : Unit ↦ U.obj 0) (fun _ ↦ hT.from (U.obj 0)) ∈ J T ∧
        ∀ n : ℕ, Sieve.ofArrows (fun _ : Unit ↦ U.obj (n + 1)) (fun _ ↦ U.toMatching n) ∈
          J (U.matching n) := by
  sorry

end Matching

end CategoryTheory.SemiSimplicialObject
