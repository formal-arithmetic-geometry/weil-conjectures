module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology
public import Mathlib.CategoryTheory.Sites.DenseSubsite.SheafEquiv
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
public import WeilConjectures.Mathlib.CategoryTheory.Sites.DenseSubsite.Basic

/-!
# Sheaves on a dense class of objects

Let `(C, J)` be a site with pullbacks and `B` a class of objects of `C` which is cover-dense,
closed under isomorphisms and under fibre products, and such that every covering sieve of an
object of `B` contains a finite covering family of objects of `B`
(`CategoryTheory.GrothendieckTopology.FinitaryDenseClass`).

If a presheaf `P` satisfies the sheaf condition for enough covering families of objects of `B`
(`CategoryTheory.ObjectProperty.isSheaf_inducedTopology_of_isSheafFor`), its restriction to the
full subcategory of `B` is a sheaf for the induced topology. Consequently the sheafification
of `P` does not change its sections over objects of `B`
(`CategoryTheory.ObjectProperty.isIso_toSheafify_app_of_isSheafFor`,
`CategoryTheory.GrothendieckTopology.FinitaryDenseClass.isIso_toSheafify_app`).
-/

@[expose] public section

universe w v u

open CategoryTheory Limits Opposite

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) (B : ObjectProperty C)

namespace ObjectProperty

variable {B} in
/-- If `P` is separated for a presieve `R` of `B`-objects contained in a sieve `Q`, then the
restriction of `P` to the full subcategory of `B` is separated for the pullback of `Q`. -/
lemma isSeparatedFor_functorPullback {P : Cᵒᵖ ⥤ Type w} {Y : B.FullSubcategory}
    (Q : Sieve Y.obj) (R : Presieve Y.obj) (hRQ : R ≤ Q) (hRB : ∀ ⦃V⦄ (f : V ⟶ Y.obj), R f → B V)
    (hR : R.IsSeparatedFor P) :
    Presieve.IsSeparatedFor (B.ι.op ⋙ P) (Q.functorPullback B.ι : Presieve Y) := by
  intro x t₁ t₂ h₁ h₂
  let y : Presieve.FamilyOfElements P R := fun _ f _ ↦ P.map f.op t₁
  refine hR y t₁ t₂ (fun _ _ _ ↦ rfl) (fun V f hf ↦ ?_)
  let f' : (⟨V, hRB f hf⟩ : B.FullSubcategory) ⟶ Y := homMk f
  have hf' : (Q.functorPullback B.ι : Presieve Y) f' := hRQ _ f hf
  exact (h₂ f' hf').trans (h₁ f' hf').symm

variable {B} in
/-- If `P` is a sheaf for a presieve `R` of `B`-objects whose pairwise fibre products are in
`B`, then the restriction of `P` to the full subcategory of `B` is a sheaf for the pullback of
the sieve generated by `R`. -/
lemma isSheafFor_functorPullback_generate [HasPullbacks C] {P : Cᵒᵖ ⥤ Type w}
    {U : B.FullSubcategory} (R : Presieve U.obj) (hRB : ∀ ⦃V⦄ (f : V ⟶ U.obj), R f → B V)
    (hpb : ∀ ⦃V W⦄ (f : V ⟶ U.obj) (g : W ⟶ U.obj), R f → R g → B (pullback f g))
    (hR : R.IsSheafFor P) :
    Presieve.IsSheafFor (B.ι.op ⋙ P) ((Sieve.generate R).functorPullback B.ι : Presieve U) := by
  intro x hx
  let lift {V : C} (f : V ⟶ U.obj) (hf : R f) : (⟨V, hRB f hf⟩ : B.FullSubcategory) ⟶ U :=
    homMk f
  have hlift {V : C} (f : V ⟶ U.obj) (hf : R f) :
      ((Sieve.generate R).functorPullback B.ι : Presieve U) (lift f hf) :=
    Sieve.le_generate R _ f hf
  let y : Presieve.FamilyOfElements P R := fun _ f hf ↦ x (lift f hf) (hlift f hf)
  have hy : y.Compatible := by
    rw [Presieve.pullbackCompatible_iff]
    intro V₁ V₂ f₁ f₂ hf₁ hf₂
    let Z : B.FullSubcategory := ⟨pullback f₁ f₂, hpb f₁ f₂ hf₁ hf₂⟩
    exact hx (homMk (pullback.fst f₁ f₂) : Z ⟶ _) (homMk (pullback.snd f₁ f₂) : Z ⟶ _)
      (hlift f₁ hf₁) (hlift f₂ hf₂) (B.ι.map_injective pullback.condition)
  obtain ⟨t, ht, ht'⟩ := hR y hy
  have hamalg (s : P.obj (op U.obj)) :
      Presieve.FamilyOfElements.IsAmalgamation x s ↔ y.IsAmalgamation s := by
    refine ⟨fun hs V f hf ↦ hs (lift f hf) (hlift f hf), fun hs W g hg ↦ ?_⟩
    obtain ⟨V, k, f, hf, hkf⟩ := hg
    have hg' : g = (homMk k : W ⟶ ⟨V, hRB f hf⟩) ≫ lift f hf := B.ι.map_injective hkf.symm
    subst hg'
    rw [hx.to_sieveCompatible (lift f hf) (homMk k) (hlift f hf)]
    have h := hs f hf
    dsimp only [y] at h
    rw [← h]
    simp [lift]
  exact ⟨t, (hamalg t).2 ht, fun s hs ↦ ht' s ((hamalg s).1 hs)⟩

variable [B.ι.IsCoverDense J]

/-- Let `B` be a cover-dense class of objects of a site `(C, J)` with pullbacks, closed under
fibre products. If every covering sieve of an object of `B` contains a covering presieve of
`B`-objects for which the presheaf of types `P` satisfies the sheaf condition, then the
restriction of `P` to the full subcategory of `B` is a sheaf for the induced topology. -/
theorem isSheaf_inducedTopology_of_isSheafFor [HasPullbacks C]
    (hpb : ∀ ⦃U V W : C⦄ (f : V ⟶ U) (g : W ⟶ U), B U → B V → B W → B (pullback f g))
    (P : Cᵒᵖ ⥤ Type w)
    (hP : ∀ U : C, B U → ∀ S ∈ J U, ∃ R : Presieve U, R ≤ S ∧ Sieve.generate R ∈ J U ∧
      (∀ ⦃V⦄ (f : V ⟶ U), R f → B V) ∧ R.IsSheafFor P) :
    Presieve.IsSheaf (B.ι.inducedTopology J) (B.ι.op ⋙ P) := by
  intro U S hS
  rw [Functor.mem_inducedTopology_iff_of_isCoverDense] at hS
  obtain ⟨R, hRS, hRJ, hRB, hR⟩ := hP U.obj U.property _ hS
  refine Presieve.isSheafFor_subsieve_aux _ (S := (Sieve.generate R).functorPullback B.ι)
    ?_ ?_ fun Y g _ ↦ ?_
  · conv_rhs => rw [← Sieve.functorPullback_functorPushforward_eq (F := B.ι) (S := S)]
    exact Sieve.functorPullback_monotone _ _ ((Sieve.generate_le_iff _ _).2 hRS)
  · exact isSheafFor_functorPullback_generate R hRB
      (fun _ _ f g hf hg ↦ hpb f g U.property (hRB f hf) (hRB g hg)) hR
  · obtain ⟨R', hR'S, -, hR'B, hR'⟩ :=
      hP Y.obj Y.property _ (J.pullback_stable (B.ι.map g) hRJ)
    rw [← Sieve.functorPullback_pullback]
    exact isSeparatedFor_functorPullback _ R' hR'S hR'B hR'.isSeparatedFor

/-- `A`-valued version of `CategoryTheory.ObjectProperty.isSheaf_inducedTopology_of_isSheafFor`:
if every covering sieve of an object of `B` contains a covering presieve of `B`-objects for which
`P` satisfies the sheaf condition, then sheafification does not change the sections of `P` over
objects of `B`. -/
theorem isIso_toSheafify_app_of_isSheafFor [HasPullbacks C] {A : Type*} [Category* A]
    [HasWeakSheafify J A] [HasWeakSheafify (B.ι.inducedTopology J) A]
    [(B.ι.sheafPushforwardContinuous A (B.ι.inducedTopology J) J).IsEquivalence]
    (hpb : ∀ ⦃U V W : C⦄ (f : V ⟶ U) (g : W ⟶ U), B U → B V → B W → B (pullback f g))
    (P : Cᵒᵖ ⥤ A)
    (hP : ∀ (E : A) (U : C), B U → ∀ S ∈ J U, ∃ R : Presieve U, R ≤ S ∧
      Sieve.generate R ∈ J U ∧ (∀ ⦃V⦄ (f : V ⟶ U), R f → B V) ∧
        R.IsSheafFor (P ⋙ coyoneda.obj (op E)))
    (U : C) (hU : B U) :
    IsIso ((toSheafify J P).app (op U)) := by
  have := Functor.IsDenseSubsite.isIso_whiskerLeft_toSheafify (B.ι.inducedTopology J) J B.ι A P
    fun E ↦ isSheaf_inducedTopology_of_isSheafFor J B hpb _ (hP E)
  exact inferInstanceAs (IsIso ((B.ι.op.whiskerLeft (toSheafify J P)).app (op ⟨U, hU⟩)))

end ObjectProperty

namespace GrothendieckTopology

/-- A class `B` of objects of a site `(C, J)` with pullbacks is a *finitary dense class* if
every object is covered by objects of `B`, `B` is closed under isomorphisms and fibre
products, and every covering sieve of an object of `B` contains a finite covering family of
objects of `B`. -/
structure FinitaryDenseClass [HasPullbacks C] : Prop where
  /-- Every object has a covering sieve whose arrows have sources in `B`. -/
  exists_cover (Y : C) : ∃ S ∈ J Y, ∀ ⦃Z : C⦄ (g : Z ⟶ Y), S g → B Z
  /-- `B` is closed under isomorphisms. -/
  of_iso ⦃V W : C⦄ (e : V ≅ W) : B V → B W
  /-- `B` is closed under fibre products. -/
  pullback_mem ⦃U V W : C⦄ (f : V ⟶ U) (g : W ⟶ U) :
    B U → B V → B W → B (Limits.pullback f g)
  /-- Every covering sieve of an object of `B` contains a finite covering family of objects
  of `B`. -/
  exists_finite (U : C) (hU : B U) (S : Sieve U) (hS : S ∈ J U) :
    ∃ (n : ℕ) (V : Fin n → C) (f : ∀ i, V i ⟶ U),
      (∀ i, B (V i)) ∧ (∀ i, S (f i)) ∧ Sieve.ofArrows V f ∈ J U

namespace FinitaryDenseClass

variable {J B} [HasPullbacks C]

/-- The inclusion of a finitary dense class is cover-dense. -/
lemma isCoverDense (hB : J.FinitaryDenseClass B) : B.ι.IsCoverDense J where
  is_cover Y := by
    obtain ⟨S, hS, hSB⟩ := hB.exists_cover Y
    refine J.superset_covering (fun Z g hg ↦ ?_) hS
    exact ⟨{ obj := ⟨Z, hSB g hg⟩, lift := 𝟙 Z, map := g }⟩

/-- If a presheaf `P` satisfies the sheaf condition for all finite covering families of
`B`-objects of objects of a finitary dense class `B`, then sheafification does not change the
sections of `P` over objects of `B`. -/
theorem isIso_toSheafify_app (hB : J.FinitaryDenseClass B) {A : Type*} [Category* A]
    [HasWeakSheafify J A] [HasWeakSheafify (B.ι.inducedTopology J) A]
    [(B.ι.sheafPushforwardContinuous A (B.ι.inducedTopology J) J).IsEquivalence]
    (P : Cᵒᵖ ⥤ A)
    (hP : ∀ (E : A) (U : C), B U → ∀ (n : ℕ) (V : Fin n → C) (f : ∀ i, V i ⟶ U),
      (∀ i, B (V i)) → Sieve.ofArrows V f ∈ J U →
        (Presieve.ofArrows V f).IsSheafFor (P ⋙ coyoneda.obj (op E)))
    (U : C) (hU : B U) :
    IsIso ((CategoryTheory.toSheafify J P).app (op U)) := by
  have := hB.isCoverDense
  refine ObjectProperty.isIso_toSheafify_app_of_isSheafFor J B hB.pullback_mem P
    (fun E U hU S hS ↦ ?_) U hU
  obtain ⟨n, V, f, hV, hfS, hf⟩ := hB.exists_finite U hU S hS
  refine ⟨Presieve.ofArrows V f, ?_, hf, ?_, hP E U hU n V f hV hf⟩
  · rintro _ _ ⟨i⟩
    exact hfS i
  · rintro _ _ ⟨i⟩
    exact hV i

end FinitaryDenseClass

end GrothendieckTopology

end CategoryTheory
