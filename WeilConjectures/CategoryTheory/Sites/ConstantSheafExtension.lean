module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
public import Mathlib.CategoryTheory.Sites.EpiMono
public import WeilConjectures.Mathlib.CategoryTheory.Sites.ConstantSheafOver

/-!
# Extensions of constant sheaves of modules are locally constant

Let `(C, J)` be a site, `Λ` a ring and `0 ⟶ M_C ⟶ E ⟶ N_C ⟶ 0` a short exact sequence of
sheaves of `Λ`-modules whose outer terms are constant sheaves, with `N` finitely presented.
Then every object `T` has a covering sieve over whose non-degenerate members `V` the
restriction `E|_V` is constant (`CategoryTheory.Sheaf.exists_mem_forall_isConstant_over`).

The proof avoids torsors. Choose generators `n₁, …, n_r` of `N` and generators `q₁, …, q_s` of
the kernel `Q` of `p : Λʳ ⟶ N`. Locally the constant sections `nₖ` lift to sections `eₖ` of `E`
(an epimorphism of sheaves is locally surjective). Then `∑ₖ q_{jk} eₖ` lies in `M_C`, and after
a further refinement it is a constant section `mⱼ`. Over such a `V` the submodule `B` of `E(V)`
generated by `M` and the `eₖ` sits in a short exact sequence `0 ⟶ M ⟶ B ⟶ N ⟶ 0`. The adjoint
`B_V ⟶ E|_V` of the inclusion `B ⊆ E(V)` is a morphism of short exact sequences which is an
isomorphism on the outer terms, hence an isomorphism
(`CategoryTheory.Sheaf.isConstant_over_of_lifts`). This gives the extension part of
`lemma-constructible-flc-serre`; the torsor of splittings of the blueprint proof is not needed.

-/

@[expose] public section

universe v u v'

open CategoryTheory Limits Opposite

namespace CategoryTheory.Sheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) {Λ : Type v'} [Ring Λ]
  [HasSheafify J (ModuleCat.{v'} Λ)] [J.WEqualsLocallyBijective (ModuleCat.{v'} Λ)]

section Core

variable {M N : ModuleCat.{v'} Λ} {E : Sheaf J (ModuleCat.{v'} Λ)}
  {ι : (constantSheaf J (ModuleCat.{v'} Λ)).obj M ⟶ E}
  {π : E ⟶ (constantSheaf J (ModuleCat.{v'} Λ)).obj N} {w : ι ≫ π = 0}

/-- **The core step**: over a non-degenerate object `V`, if the generators `nₖ` of `N` lift to
sections `eₖ` of `E` over `V` and every relation `∑ₖ q_{jk} nₖ = 0` between them is witnessed
by a constant section `mⱼ` of `M_C` over `V`, then `E|_V` is constant. -/
theorem isConstant_over_of_lifts (hS : (ShortComplex.mk ι π w).ShortExact) {V : C}
    (hV : (⊥ : Sieve V) ∉ J V) [HasSheafify (J.over V) (ModuleCat.{v'} Λ)]
    [PreservesFiniteLimits (J.overPullback (ModuleCat.{v'} Λ) V)]
    [PreservesFiniteColimits (J.overPullback (ModuleCat.{v'} Λ) V)]
    [IsIso (constantSheafOverHom J (ModuleCat.{v'} Λ) V M)]
    [IsIso (constantSheafOverHom J (ModuleCat.{v'} Λ) V N)]
    {r s : ℕ} (n : Fin r → N) (hn : Submodule.span Λ (Set.range n) = ⊤)
    (q : Fin s → (Fin r →₀ Λ))
    (hq : Submodule.span Λ (Set.range q) = LinearMap.ker (Finsupp.linearCombination Λ n))
    (e : Fin r → E.obj.obj (op V)) (m : Fin s → M)
    (he : ∀ k, π.hom.app (op V) (e k) =
      (CategoryTheory.toSheafify J ((Functor.const Cᵒᵖ).obj N)).app (op V) (n k))
    (hm : ∀ j, ι.hom.app (op V)
      ((CategoryTheory.toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op V) (m j)) =
        Finsupp.linearCombination Λ e (q j)) :
    (E.over V).IsConstant (J.over V) := by
  classical
  let uM : M ⟶ ((constantSheaf J (ModuleCat.{v'} Λ)).obj M).obj.obj (op V) :=
    (CategoryTheory.toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op V)
  let uN : N ⟶ ((constantSheaf J (ModuleCat.{v'} Λ)).obj N).obj.obj (op V) :=
    (CategoryTheory.toSheafify J ((Functor.const Cᵒᵖ).obj N)).app (op V)
  set ιV := ι.hom.app (op V)
  set πV := π.hom.app (op V)
  have huM : Function.Injective uM := J.toSheafify_const_app_injective M hV
  have huN : Function.Injective uN := J.toSheafify_const_app_injective N hV
  have : Mono ι := hS.mono_f
  have hιV : Function.Injective ιV := by
    rw [← ModuleCat.mono_iff_injective]
    have : Mono ι.hom := (sheafToPresheaf J _).map_mono ι
    exact (NatTrans.mono_iff_mono_app _).1 this (op V)
  have hπι (x : M) : πV (ιV (uM x)) = 0 := by
    change (ι ≫ π).hom.app (op V) (uM x) = 0
    rw [w]
    rfl
  let L : M × (Fin r →₀ Λ) →ₗ[Λ] E.obj.obj (op V) :=
    (ιV.hom ∘ₗ uM.hom) ∘ₗ LinearMap.fst Λ M _ +
      Finsupp.linearCombination Λ e ∘ₗ LinearMap.snd Λ M _
  have hL (x : M × (Fin r →₀ Λ)) :
      L x = ιV (uM x.1) + Finsupp.linearCombination Λ e x.2 := rfl
  have hπlc (c : Fin r →₀ Λ) :
      πV (Finsupp.linearCombination Λ e c) = uN (Finsupp.linearCombination Λ n c) := by
    induction c using Finsupp.induction_linear with
    | zero => simp only [map_zero]
    | add c d hc hd => simp only [map_add, hc, hd]
    | single k a =>
      rw [Finsupp.linearCombination_single, Finsupp.linearCombination_single, map_smul, map_smul,
        he]
      rfl
  have hπL (x : M × (Fin r →₀ Λ)) : πV (L x) = uN (Finsupp.linearCombination Λ n x.2) := by
    rw [hL, map_add, hπι, hπlc, zero_add]
  let B := LinearMap.range L
  have hrange : LinearMap.range (πV.hom ∘ₗ B.subtype) ≤ LinearMap.range uN.hom := by
    rintro _ ⟨⟨_, x, rfl⟩, rfl⟩
    exact ⟨_, (hπL x).symm⟩
  let eN := LinearEquiv.ofInjective uN.hom huN
  let pB : B →ₗ[Λ] N := eN.symm.toLinearMap ∘ₗ
    (πV.hom ∘ₗ B.subtype).codRestrict _ fun b ↦ hrange ⟨b, rfl⟩
  have hpB (b : B) : uN (pB b) = πV b := by
    have h := congrArg Subtype.val (eN.apply_symm_apply
      ⟨πV b, hrange ⟨b, rfl⟩⟩)
    rw [LinearEquiv.ofInjective_apply] at h
    exact h
  let iB : M →ₗ[Λ] B := L.rangeRestrict ∘ₗ LinearMap.inl Λ M _
  have hiB (x : M) : (iB x : E.obj.obj (op V)) = ιV (uM x) := by
    change L (x, 0) = _
    rw [hL, map_zero, add_zero]
  sorry

end Core

end CategoryTheory.Sheaf
