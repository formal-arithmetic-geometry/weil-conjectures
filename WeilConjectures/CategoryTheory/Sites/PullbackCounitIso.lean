module

public import Mathlib.CategoryTheory.Sites.LocallyBijective
public import Mathlib.CategoryTheory.Sites.Pullback
public import Mathlib.CategoryTheory.Limits.ConcreteCategory.Basic

/-!
# The counit of the pullback–pushforward adjunction on sheaves

Let `F : C ⥤ D` be a continuous functor between sites `(C, J)` and `(D, K)`, and let
`F^* ⊣ F_*` be the adjunction on sheaves whose left adjoint is the sheafification of the left
Kan extension along `F.op` (`Functor.sheafPullbackConstruction.sheafAdjunctionContinuous`).
The counit `F^* F_* G ⟶ G` is the sheafification of the counit
`ε : lan (F.op ⋙ G) ⟶ G` of the Kan extension adjunction.

We give a criterion for this counit to be an isomorphism. Suppose that every object `Y` of `D`
has a morphism to some `F.obj X`, and that for every `ψ : Y ⟶ F.obj X` the morphisms
`f : Y' ⟶ Y` such that `f ≫ ψ` is, up to an isomorphism `Y' ≅ F.obj X'`, the image `F.map h` of a
morphism `h : X' ⟶ X` generate a covering sieve (`Functor.liftPresieve`). Then `ε` is locally
injective and locally surjective, hence the counit is an isomorphism
(`Functor.isIso_sheafAdjunctionContinuous_counit_app`).

This is the abstract form of the argument for the full faithfulness of the direct image along a
closed immersion on pro-étale sites: there, objects of the closed site are covered by base
changes of objects of the ambient site, by henselian lifting.
-/

@[expose] public section

universe w

open CategoryTheory Limits Opposite

namespace CategoryTheory.Functor

variable {C D H : Type*} [Category* C] [Category* D] [Category* H]
  {FH : H → H → Type*} {CH : H → Type*} [∀ X Y, FunLike (FH X Y) (CH X) (CH Y)]
  [ConcreteCategory H FH] (F : C ⥤ D)

/-- The presieve on `Y` of the morphisms `f : Y' ⟶ Y` such that `f ≫ ψ` is, up to an isomorphism
`c : Y' ≅ F.obj X'`, the image under `F` of a morphism `h : X' ⟶ X`. -/
def liftPresieve {Y : D} {X : C} (ψ : Y ⟶ F.obj X) : Presieve Y :=
  fun Y' f ↦ ∃ (X' : C) (h : X' ⟶ X) (c : Y' ≅ F.obj X'), c.hom ≫ F.map h = f ≫ ψ

section Presheaf

variable [∀ P : Cᵒᵖ ⥤ H, F.op.HasPointwiseLeftKanExtension P] (G : Dᵒᵖ ⥤ H)

/-- The counit `lan (F.op ⋙ G) ⟶ G` of the left Kan extension adjunction, after the unit. -/
lemma lanAdjunction_counit_app_app_lanUnit_app_app (X : C) (t : ToType (G.obj (op (F.obj X)))) :
    ((F.op.lanAdjunction H).counit.app G).app (op (F.obj X))
      ((F.op.lanUnit.app (F.op ⋙ G)).app (op X) t) = t := by
  have h := ConcreteCategory.congr_hom
    (F.op.lanUnit_app_app_lanAdjunction_counit_app_app G (op X)) t
  simpa using h

/-- The counit `lan (F.op ⋙ G) ⟶ G` is locally surjective as soon as every object is covered by
objects isomorphic to images of `F`. -/
lemma isLocallySurjective_lanAdjunction_counit_app (K : GrothendieckTopology D)
    (hF : ∀ Y : D, Sieve.generate (fun Y' (_ : Y' ⟶ Y) ↦ ∃ X' : C, Nonempty (Y' ≅ F.obj X')) ∈
      K Y) :
    Presheaf.IsLocallySurjective K ((F.op.lanAdjunction H).counit.app G) where
  imageSieve_mem {Y} s := by
    refine K.superset_covering ?_ (hF Y)
    rintro Y' f ⟨Y'', g, f', ⟨X', ⟨c⟩⟩, rfl⟩
    refine Sieve.downward_closed _ ?_ g
    let ε := (F.op.lanAdjunction H).counit.app G
    refine ⟨(F.op.lan.obj (F.op ⋙ G)).map c.hom.op ((F.op.lanUnit.app (F.op ⋙ G)).app (op X')
      (G.map c.inv.op (G.map f'.op s))), ?_⟩
    rw [NatTrans.naturality_apply (φ := ε), lanAdjunction_counit_app_app_lanUnit_app_app,
      ← ConcreteCategory.comp_apply, ← G.map_comp, ← op_comp, c.hom_inv_id, op_id, G.map_id]
    rfl

/-- The counit `lan (F.op ⋙ G) ⟶ G` is locally injective as soon as the sieves generated by
`Functor.liftPresieve` are covering. -/
lemma isLocallyInjective_lanAdjunction_counit_app (K : GrothendieckTopology D) [RepresentablyFlat F]
    [∀ Y : Dᵒᵖ, PreservesColimitsOfShape (CostructuredArrow F.op Y) (forget H)]
    (hS : ∀ {Y : D} {X : C} (ψ : Y ⟶ F.obj X), Sieve.generate (F.liftPresieve ψ) ∈ K Y) :
    Presheaf.IsLocallyInjective K ((F.op.lanAdjunction H).counit.app G) where
  equalizerSieve_mem {Y} x y hxy := by
    let P := F.op.lan.obj (F.op ⋙ G)
    let ε := (F.op.lanAdjunction H).counit.app G
    have : IsFiltered (CostructuredArrow F.op Y) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence F Y.unop)
    let hc := F.op.isPointwiseLeftKanExtensionLeftKanExtensionUnit (F.op ⋙ G) Y
    obtain ⟨j₁, x₁, rfl⟩ := Concrete.isColimit_exists_rep _ hc x
    obtain ⟨j₂, y₁, rfl⟩ := Concrete.isColimit_exists_rep _ hc y
    obtain ⟨k, g₁, g₂, -⟩ := IsFilteredOrEmpty.cocone_objs j₁ j₂
    rw [← (LeftExtension.mk _ (F.op.leftKanExtensionUnit (F.op ⋙ G))).coconeAt Y |>.w g₁,
      ← (LeftExtension.mk _ (F.op.leftKanExtensionUnit (F.op ⋙ G))).coconeAt Y |>.w g₂] at hxy ⊢
    simp only [ConcreteCategory.comp_apply] at hxy ⊢
    generalize (CostructuredArrow.proj F.op Y ⋙ F.op ⋙ G).map g₁ x₁ = x₂ at hxy ⊢
    generalize (CostructuredArrow.proj F.op Y ⋙ F.op ⋙ G).map g₂ y₁ = y₂ at hxy ⊢
    obtain ⟨⟨X⟩, ⟨⟩, ψ⟩ := k
    obtain ⟨ψ⟩ := ψ
    -- the value of `ε` on the image of an element `t` at the stage `ψ`
    have hε : ∀ t, ε.app Y (((LeftExtension.mk _ (F.op.leftKanExtensionUnit (F.op ⋙ G))).coconeAt
        Y).ι.app (CostructuredArrow.mk ψ.op) t) = G.map ψ.op t := by
      intro t
      simp only [LeftExtension.coconeAt_ι_app, LeftExtension.mk_hom, LeftExtension.mk_right,
        CostructuredArrow.mk_left, CostructuredArrow.mk_hom_eq_self, ConcreteCategory.comp_apply]
      rw [NatTrans.naturality_apply (φ := ε)]
      congr 1
      exact lanAdjunction_counit_app_app_lanUnit_app_app F G X t
    change ε.app Y _ = ε.app Y _ at hxy
    rw [hε, hε] at hxy
    refine K.superset_covering ?_ (hS ψ)
    rw [Sieve.generate_le_iff]
    rintro Y' f ⟨X', h, c, hc⟩
    simp only [Presheaf.equalizerSieve_apply, LeftExtension.coconeAt_ι_app,
      LeftExtension.mk_hom, LeftExtension.mk_right, CostructuredArrow.mk_left,
      CostructuredArrow.mk_hom_eq_self, ConcreteCategory.comp_apply]
    have key : ∀ t, (F.op.leftKanExtension (F.op ⋙ G)).map f.op
        ((F.op.leftKanExtension (F.op ⋙ G)).map ψ.op
          ((F.op.leftKanExtensionUnit (F.op ⋙ G)).app (op X) t)) =
        (F.op.leftKanExtension (F.op ⋙ G)).map c.hom.op
          ((F.op.leftKanExtensionUnit (F.op ⋙ G)).app (op X') (G.map (F.map h).op t)) := by
      intro t
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, ← hc, op_comp,
        Functor.map_comp, ConcreteCategory.comp_apply]
      congr 1
      exact (NatTrans.naturality_apply (F.op.leftKanExtensionUnit (F.op ⋙ G)) h.op t).symm
    rw [key, key]
    congr 2
    have hinj : Function.Injective (G.map c.hom.op) := by
      intro a b hab
      have := congrArg (G.map c.inv.op) hab
      rwa [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← G.map_comp,
        ← op_comp, c.inv_hom_id, op_id, G.map_id] at this
    apply hinj
    rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← G.map_comp, ← op_comp,
      hc, op_comp, G.map_comp, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, hxy]

end Presheaf

section Sheaf

variable [∀ P : Cᵒᵖ ⥤ H, F.op.HasPointwiseLeftKanExtension P]
  (J : GrothendieckTopology C) (K : GrothendieckTopology D) [F.IsContinuous J K]
  [HasWeakSheafify K H]

/-- The counit of `F^* ⊣ F_*`, precomposed with the sheafification map, is the counit of the left
Kan extension adjunction. -/
lemma toSheafify_sheafAdjunctionContinuous_counit_app_hom (G : Sheaf K H) :
    toSheafify K _ ≫
        ((sheafPullbackConstruction.sheafAdjunctionContinuous F H J K).counit.app G).hom =
      (F.op.lanAdjunction H).counit.app G.obj := by
  have h := Adjunction.map_restrictFullyFaithful_counit_app
    ((F.op.lanAdjunction H).comp (sheafificationAdjunction K H))
    (fullyFaithfulSheafToPresheaf J H) (Functor.FullyFaithful.id _)
    (L := sheafPullbackConstruction.sheafPullback F H J K)
    (R := F.sheafPushforwardContinuous H J K) (Iso.refl _) (Iso.refl _) G
  simp only [Functor.id_map, Iso.refl_inv, NatTrans.id_app, Functor.map_id, Category.id_comp,
    Adjunction.comp_counit_app] at h
  change toSheafify K _ ≫ ((sheafPullbackConstruction.sheafAdjunctionContinuous F H J K).counit.app
    G).hom = _
  rw [show (sheafPullbackConstruction.sheafAdjunctionContinuous F H J K).counit.app G = _ from h]
  simp

variable [RepresentablyFlat F]
  [∀ Y : Dᵒᵖ, PreservesColimitsOfShape (CostructuredArrow F.op Y) (forget H)]
  [(forget H).ReflectsIsomorphisms] [K.HasSheafCompose (forget H)] [K.WEqualsLocallyBijective H]

include FH in
/-- **The counit of `F^* ⊣ F_*` is an isomorphism** when every object of `D` is covered by
objects isomorphic to images of `F`, compatibly with any given morphism to an image of `F`
(`Functor.liftPresieve`). -/
theorem isIso_sheafAdjunctionContinuous_counit_app
    (hF : ∀ Y : D, Sieve.generate (fun Y' (_ : Y' ⟶ Y) ↦ ∃ X' : C, Nonempty (Y' ≅ F.obj X')) ∈
      K Y)
    (hS : ∀ {Y : D} {X : C} (ψ : Y ⟶ F.obj X), Sieve.generate (F.liftPresieve ψ) ∈ K Y)
    (G : Sheaf K H) :
    IsIso ((sheafPullbackConstruction.sheafAdjunctionContinuous F H J K).counit.app G) := by
  have hε := toSheafify_sheafAdjunctionContinuous_counit_app_hom F J K G
  have := isLocallySurjective_lanAdjunction_counit_app F G.obj K hF
  have := isLocallyInjective_lanAdjunction_counit_app F G.obj K hS
  rw [← Sheaf.isLocallyBijective_iff_isIso]
  exact ⟨Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac K _ hε,
    Presheaf.isLocallySurjective_of_isLocallySurjective_fac K hε⟩

end Sheaf

end CategoryTheory.Functor
