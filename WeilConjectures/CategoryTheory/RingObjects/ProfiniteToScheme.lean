/-!

# Profinite sets as pro-étale `ℤ`-schemes: the morphism of sites `Sch_proét → *_proét`

The pro-étale site of a point is the category of profinite sets with the coherent topology
[Bhatt–Scholze, Example 4.1.10]: a profinite set `S = lim Sᵢ` corresponds to the affine scheme
`S × Spec ℤ = Spec (LocallyConstant S ℤ) = lim ⨆_{Sᵢ} Spec ℤ`, which is weakly étale over
`Spec ℤ`, and finite jointly surjective families of profinite sets correspond to pro-étale
covers. This file constructs the functor `Profinite.toScheme : Profinite ⥤ Scheme`,
`S ↦ Spec (LocallyConstant S ℤ)`, and shows that it is a continuous functor from the coherent
topology on `Profinite` to the big pro-étale topology `Scheme.proetaleTopology` on `Scheme`,
i.e. a morphism of sites `(Scheme, proét) → (Profinite, coherent)`. The pullback of sheaves
along it, restricted to the small pro-étale site of a scheme `X`, is the pullback along the
structure morphism `X → Spec ℤ` from the pro-étale topos of a point to that of `X`, see
`WeilConjectures.CategoryTheory.RingObjects.Pullback`.

* `Spec (LocallyConstant S ℤ) → Spec ℤ` is weakly étale: `LocallyConstant S ℤ` is a free
  `ℤ`-module (Nöbeling's theorem, `LocallyConstant.freeOfProfinite`) and is generated as a ring
  by the idempotents `1_U`, `U` clopen, so that it is weakly étale over `ℤ` by
  `Algebra.WeaklyEtale.of_subring_closure_isIdempotentElem`. By cancellation, every
  `toScheme.map f` is weakly étale.
* A finite jointly surjective family `Sₐ → S` of profinite sets induces a jointly surjective
  family of schemes `Spec (LocallyConstant Sₐ ℤ) → Spec (LocallyConstant S ℤ)`: every prime of
  `LocallyConstant S ℤ` lies over a point `s ∈ S` and is the preimage of a prime over any
  preimage of `s` (`LocallyConstant.exists_isPrime_comap_comapRingHom_eq`). Since the schemes are
  affine, this is a pro-étale cover, and `toScheme` is cover preserving
  (`Profinite.toScheme_coverPreserving`).
* `toScheme` preserves finite limits: `Spec (LocallyConstant S ℤ) = S × Spec ℤ`, and the functor
  `S ↦ S × Spec ℤ` preserves finite limits. Concretely this is the identification
  `LocallyConstant (S ×_T S') ℤ = LocallyConstant S ℤ ⊗_{LocallyConstant T ℤ} LocallyConstant S' ℤ`.
  This is recorded as the instance `Profinite.toScheme_preservesFiniteLimits`, currently
  with `sorry`. It makes `toScheme` representably flat, hence compatible preserving, so that
  it is continuous (`Profinite.toScheme_isContinuous`); the pullback functor on sheaves then
  commutes with finite limits.

The base ring of the category `Scheme.{u}` is `ULift.{u} ℤ`, so that `Spec (ULift ℤ)` is its
terminal object (`AlgebraicGeometry.specULiftZIsTerminal`); `LocallyConstant S ℤ` is made a
`ULift ℤ`-algebra through `ULift.algebra'`.

## Main definitions

* `Profinite.toScheme`: the functor `S ↦ Spec (LocallyConstant S ℤ)`.
* `Profinite.toSpecInt`: the structure morphism `Spec (LocallyConstant S ℤ) ⟶ Spec ℤ`, which is
  weakly étale (`Profinite.weaklyEtale_toSpecInt`).
* `Profinite.toScheme_coverPreserving`, `Profinite.toScheme_isContinuous`: `toScheme` is a
  continuous functor from the coherent topology to the pro-étale topology.

-/

@[expose] public section

universe u

open CategoryTheory AlgebraicGeometry Limits Opposite

/-- Two ring homomorphisms out of `ULift ℤ` agree. -/
lemma RingHom.ext_ulift_int {R : Type*} [NonAssocSemiring R] (f g : ULift.{u} ℤ →+* R) :
    f = g := by
  have h := RingHom.ext_int (f.comp ULift.ringEquiv.symm.toRingHom)
    (g.comp ULift.ringEquiv.symm.toRingHom)
  ext x
  exact RingHom.congr_fun h x.down

namespace Profinite

/-- The ring `LocallyConstant S ℤ` of locally constant integer-valued functions on a profinite
set `S` is weakly étale over `ℤ`: it is free (Nöbeling) and generated by idempotents. -/
instance weaklyEtale_locallyConstant (S : Profinite.{u}) :
    Algebra.WeaklyEtale ℤ (LocallyConstant S ℤ) :=
  .of_subring_closure_isIdempotentElem ℤ _
    LocallyConstant.subring_closure_isIdempotentElem_eq_top

/-- The functor `S ↦ Spec (LocallyConstant S ℤ) = S × Spec ℤ` from profinite sets to schemes, a
profinite set being viewed as a pro-étale `ℤ`-scheme. A continuous map `f : S ⟶ T` is sent to
`Spec` of the pullback of functions `f^* : LocallyConstant T ℤ →+* LocallyConstant S ℤ`. -/
noncomputable def toScheme : Profinite.{u} ⥤ Scheme.{u} where
  obj S := Spec (CommRingCat.of (LocallyConstant S ℤ))
  map f := Spec.map (CommRingCat.ofHom (LocallyConstant.comapRingHom (Z := ℤ) f.hom.hom))
  map_id S := by
    change Spec.map (CommRingCat.ofHom (RingHom.id _)) = _
    rw [CommRingCat.ofHom_id, Spec.map_id]
  map_comp f g := by
    rw [← Spec.map_comp]
    rfl

lemma toScheme_obj (S : Profinite.{u}) :
    toScheme.obj S = Spec (CommRingCat.of (LocallyConstant S ℤ)) :=
  rfl

lemma toScheme_map {S T : Profinite.{u}} (f : S ⟶ T) :
    toScheme.map f =
      Spec.map (CommRingCat.ofHom (LocallyConstant.comapRingHom (Z := ℤ) f.hom.hom)) :=
  rfl

/-! ### Weak étaleness -/

attribute [local instance] ULift.algebra'

/-- `LocallyConstant S ℤ` is weakly étale over `ULift ℤ`, the base ring of `Scheme.{u}`. -/
instance weaklyEtale_ulift_locallyConstant (S : Profinite.{u}) :
    Algebra.WeaklyEtale (ULift.{u} ℤ) (LocallyConstant S ℤ) :=
  haveI : Module.Flat (ULift.{u} ℤ) (LocallyConstant S ℤ) :=
    Module.Flat.ulift_left_iff.mpr inferInstance
  .of_subring_closure_isIdempotentElem _ _
    LocallyConstant.subring_closure_isIdempotentElem_eq_top

/-- The structure morphism `Spec (LocallyConstant S ℤ) ⟶ Spec ℤ`, with `Spec (ULift ℤ)` the
terminal scheme of `Scheme.{u}`. -/
noncomputable abbrev toSpecInt (S : Profinite.{u}) :
    toScheme.obj S ⟶ Spec (CommRingCat.of (ULift.{u} ℤ)) :=
  Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) (LocallyConstant S ℤ)))

/-- The structure morphism `Spec (LocallyConstant S ℤ) ⟶ Spec ℤ` is weakly étale, since
`LocallyConstant S ℤ` is a weakly étale `ℤ`-algebra: it is flat, and the diagonal is `Spec` of the
flat multiplication map `LocallyConstant S ℤ ⊗ LocallyConstant S ℤ → LocallyConstant S ℤ`. -/
instance weaklyEtale_toSpecInt (S : Profinite.{u}) : WeaklyEtale (toSpecInt S) where
  flat := Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
  flat_diagonal := by
    rw [toSpecInt, diagonal_SpecMap, MorphismProperty.cancel_right_of_respectsIso (P := @Flat),
      Flat.SpecMap_iff, CommRingCat.hom_ofHom, AlgHom.toRingHom_eq_coe]
    exact Algebra.WeaklyEtale.flat_lmul' (ULift.{u} ℤ) (LocallyConstant S ℤ)

/-- The morphisms `toScheme.map f` are morphisms of `ℤ`-schemes. -/
lemma toScheme_map_comp_toSpecInt {S T : Profinite.{u}} (f : S ⟶ T) :
    toScheme.map f ≫ toSpecInt T = toSpecInt S := by
  rw [toScheme_map, toSpecInt, toSpecInt, ← Spec.map_comp]
  congr 1

/-- A morphism of pro-étale `ℤ`-schemes `S × Spec ℤ → T × Spec ℤ` induced by a continuous map of
profinite sets is weakly étale, by cancellation. -/
instance weaklyEtale_toScheme_map {S T : Profinite.{u}} (f : S ⟶ T) :
    WeaklyEtale (toScheme.map f) :=
  haveI : WeaklyEtale (toScheme.map f ≫ toSpecInt T) := by
    rw [toScheme_map_comp_toSpecInt]
    infer_instance
  WeaklyEtale.of_comp (toScheme.map f) (toSpecInt T)

instance isAffine_toScheme_obj (S : Profinite.{u}) : IsAffine (toScheme.obj S) :=
  inferInstanceAs (IsAffine (Spec _))

instance compactSpace_toScheme_obj (S : Profinite.{u}) : CompactSpace (toScheme.obj S) :=
  inferInstanceAs (CompactSpace (Spec _))

/-- A morphism of affine schemes is quasi-compact. -/
instance quasiCompact_toScheme_map {S T : Profinite.{u}} (f : S ⟶ T) :
    QuasiCompact (toScheme.map f) :=
  (HasAffineProperty.iff_of_isAffine (P := @QuasiCompact)).mpr inferInstance

/-! ### Covers -/

/-- A jointly surjective family of profinite sets `Yₐ → B` induces a jointly surjective family
of schemes `Spec (LocallyConstant Yₐ ℤ) → Spec (LocallyConstant B ℤ)`: a prime of
`LocallyConstant B ℤ` lies over a point `b = πₐ y` of `B`, and is then the preimage of a prime
of `LocallyConstant Yₐ ℤ` lying over `y`. -/
theorem exists_mem_range_toScheme_map {α : Type*} {B : Profinite.{u}} (Y : α → Profinite.{u})
    (π : ∀ a, Y a ⟶ B) (hπ : ∀ b : B, ∃ (a : α) (y : Y a), π a y = b) (p : toScheme.obj B) :
    ∃ a, p ∈ Set.range (toScheme.map (π a)) := by
  obtain ⟨b, hb⟩ := LocallyConstant.exists_ker_evalRingHom_le p.asIdeal
  obtain ⟨a, y, hy⟩ := hπ b
  obtain ⟨q, hq, hqp⟩ := LocallyConstant.exists_isPrime_comap_comapRingHom_eq
    (π a).hom.hom p.asIdeal hb hy
  exact ⟨a, ⟨q, hq⟩, PrimeSpectrum.ext hqp⟩

/-- The pro-étale cover `Spec (LocallyConstant Yₐ ℤ) → Spec (LocallyConstant B ℤ)` of schemes
induced by a jointly surjective family `Yₐ → B` of profinite sets. -/
@[simps I₀ X f]
noncomputable def coverOfJointlySurjective {α : Type} {B : Profinite.{u}} (Y : α → Profinite.{u})
    (π : ∀ a, Y a ⟶ B) (hπ : ∀ b : B, ∃ (a : α) (y : Y a), π a y = b) :
    (toScheme.obj B).Cover (Scheme.precoverage @WeaklyEtale) where
  I₀ := α
  X a := toScheme.obj (Y a)
  f a := toScheme.map (π a)
  mem₀ := (Scheme.presieve₀_mem_precoverage_iff _).mpr
    ⟨exists_mem_range_toScheme_map Y π hπ, fun _ ↦ inferInstance⟩

/-- The pro-étale cover induced by a finite jointly surjective family of profinite sets is a
covering family of the big pro-étale site: it is quasi-compact, being finite with affine
members. -/
theorem presieve₀_coverOfJointlySurjective_mem_proetalePrecoverage {α : Type} [Finite α]
    {B : Profinite.{u}} (Y : α → Profinite.{u}) (π : ∀ a, Y a ⟶ B)
    (hπ : ∀ b : B, ∃ (a : α) (y : Y a), π a y = b) :
    (coverOfJointlySurjective Y π hπ).presieve₀ ∈ Scheme.proetalePrecoverage (toScheme.obj B) :=
  haveI : Finite (coverOfJointlySurjective Y π hπ).I₀ := ‹Finite α›
  haveI : ∀ a, QuasiCompact ((coverOfJointlySurjective Y π hπ).f a) := fun a ↦
    quasiCompact_toScheme_map (π a)
  ⟨(Scheme.presieve₀_mem_qcPrecoverage_iff).mpr QuasiCompactCover.of_finite,
    (coverOfJointlySurjective Y π hπ).mem₀⟩

/-! ### Continuity -/

/-- The functor `S ↦ Spec (LocallyConstant S ℤ) = S × Spec ℤ` preserves finite limits: `Spec`
preserves limits, the terminal profinite set is sent to `Spec ℤ`, and
`LocallyConstant (S ×_T S') ℤ = LocallyConstant S ℤ ⊗_{LocallyConstant T ℤ} LocallyConstant S' ℤ`
for a fibre product of profinite sets. Together with `Profinite.toScheme_coverPreserving` this
makes `toScheme` a morphism of sites in the sense of SGA 4 IV 4.9. -/
instance toScheme_preservesFiniteLimits : PreservesFiniteLimits toScheme.{u} :=
  sorry

instance toScheme_representablyFlat : RepresentablyFlat toScheme.{u} :=
  flat_of_preservesFiniteLimits _

/-- The functor `toScheme` sends covering sieves of the coherent topology on profinite sets to
covering sieves of the pro-étale topology on schemes: a finite jointly surjective family of
profinite sets induces a pro-étale cover. -/
theorem toScheme_coverPreserving :
    CoverPreserving (coherentTopology Profinite.{u}) Scheme.proetaleTopology.{u} toScheme.{u} where
  cover_preserve {B S} hS := by
    rw [coherentTopology, Coverage.mem_toGrothendieck] at hS
    induction hS with
    | of X R hR =>
      obtain ⟨α, _, Ys, π, rfl, hπ⟩ := hR
      have hsurj := ((Profinite.effectiveEpiFamily_tfae Ys π).out 0 2).mp hπ
      refine Scheme.proetaleTopology.superset_covering ?_
        (Precoverage.mem_toGrothendieck_iff.mpr (Precoverage.Saturate.of _ _
          (presieve₀_coverOfJointlySurjective_mem_proetalePrecoverage Ys π hsurj)))
      rw [Sieve.generate_le_iff]
      intro Z g hg
      obtain ⟨a⟩ := hg
      exact ⟨Ys a, π a, 𝟙 _, ⟨Ys a, 𝟙 _, π a, Presieve.ofArrows.mk a, Category.id_comp _⟩,
        (Category.id_comp _).symm⟩
    | top X =>
      rw [Sieve.functorPushforward_top]
      exact Scheme.proetaleTopology.top_mem _
    | transitive X R S _ _ ihR ihS =>
      refine Scheme.proetaleTopology.transitive ihR _ ?_
      rintro Z g ⟨W, f, h, hf, rfl⟩
      rw [Sieve.pullback_comp]
      exact Scheme.proetaleTopology.pullback_stable h (Scheme.proetaleTopology.superset_covering
        (Sieve.functorPushforward_pullback_le toScheme f S) (ihS hf))

/-- The functor `S ↦ Spec (LocallyConstant S ℤ)` is a continuous functor from the coherent
topology on profinite sets to the pro-étale topology on schemes, i.e. a morphism of sites
`(Scheme, proét) → (Profinite, coherent)`: it is cover preserving and representably flat. -/
instance toScheme_isContinuous :
    toScheme.{u}.IsContinuous (coherentTopology Profinite.{u}) Scheme.proetaleTopology.{u} :=
  Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) toScheme_coverPreserving

end Profinite
