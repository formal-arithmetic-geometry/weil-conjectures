/-! # Scalar multiplication on finite-stage morphism classes

Source: blueprint `def-weil-pbc-qbar-category`, scalar-action formula
(blueprint: def-weil-pbc-qbar-category).

The generic quotient construction is specialized below to the actual rational
finite coefficient stages and their canonical derived scalar-extension system.

## Main definitions

* `AlgebraicGeometry.Scheme.pbcQbarCategory` is the finite-stage pair category.
* `CategoryTheory.StageSystem.qbarScalarHom` is its common-stage scalar action.
* `AlgebraicGeometry.Scheme.pbcQbarLinear` supplies the resulting linear structure.
* `AlgebraicGeometry.Scheme.pbcQbarTriangulated` retains the common-stage Verdier structure.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe w u v

open CategoryTheory

namespace CategoryTheory.StageSystem

variable (l : ℕ) [Fact l.Prime] (Qbar : Type w) [Field Qbar] [Algebra ℚ_[l] Qbar]
  [qbarClosure : IsAlgClosure ℚ_[l] Qbar]
variable {C : Padic.FiniteCoefficientFields l Qbar → Type u}
  [∀ E, Category.{v} (C E)] [∀ E, Preadditive (C E)] [∀ E, Linear E.val (C E)]
  (S : StageSystem C) [IsDirectedOrder (Padic.FiniteCoefficientFields l Qbar)]

set_option linter.unusedSectionVars false in
include qbarClosure in
/-- A scalar in the algebraic closure generates a finite simple extension.
Source: blueprint scalar-action paragraph (blueprint: def-weil-pbc-qbar-category).
Proof: the scalar is algebraic over Q_l since Qbar is an algebraic closure.
Its minimal polynomial gives a finite spanning set of powers in the simple extension. -/
theorem qbarScalarField_finite (α : Qbar) :
    FiniteDimensional ℚ_[l] (IntermediateField.adjoin ℚ_[l] ({α} : Set Qbar)) := by
  exact IntermediateField.adjoin.finiteDimensional
    (Algebra.IsAlgebraic.isAlgebraic α).isIntegral

/-- The actual simple extension generated by the scalar. Its eventual choice disappears
in morphism classes. Source: blueprint scalar-action paragraph
(blueprint: def-weil-pbc-qbar-category). -/
def qbarScalarField (α : Qbar) : Padic.FiniteCoefficientFields l Qbar :=
  ⟨IntermediateField.adjoin ℚ_[l] ({α} : Set Qbar), qbarScalarField_finite l Qbar α⟩

/-- The chosen finite field contains the scalar.
Source: blueprint scalar-action paragraph (blueprint: def-weil-pbc-qbar-category).
Proof: the generating singleton is contained in its intermediate-field adjoin. -/
theorem qbarScalarField_mem (α : Qbar) : α ∈ (qbarScalarField l Qbar α).val := by
  exact IntermediateField.subset_adjoin ℚ_[l] {α} (Set.mem_singleton α)

/-- Transport a representative to the compositum with the scalar field, then multiply
its transported arrow by that scalar. Source: blueprint scalar-action paragraph
(blueprint: def-weil-pbc-qbar-category). -/
def qbarScalarRep (α : Qbar) {X Y : S.PairCategory} (r : PairCategory.Rep X Y) :
    PairCategory.Rep X Y :=
  let N := Padic.finiteCoefficientCompositum l Qbar r.k (qbarScalarField l Qbar α)
  let hM : r.k ≤ N :=
    ((Padic.finiteCoefficientFields_properties l Qbar).1 r.k (qbarScalarField l Qbar α)).1
  let hα : qbarScalarField l Qbar α ≤ N :=
    ((Padic.finiteCoefficientFields_properties l Qbar).1 r.k (qbarScalarField l Qbar α)).2
  { k := N
    hX := r.hX.trans hM
    hY := r.hY.trans hM
    u := (⟨α, hα (qbarScalarField_mem l Qbar α)⟩ : N.val) • S.tr hM r.u }

/-- Semilinearity with respect to the actual inclusions of coefficient fields.
Source: blueprint scalar-extension input (blueprint: def-weil-pbc-qbar-category). -/
def QbarScalarCompatible : Prop :=
  ∀ {E F : Padic.FiniteCoefficientFields l Qbar} (h : E ≤ F)
    {K L : C E} (a : E.val) (f : K ⟶ L),
    (S.T h).map (a • f) = (IntermediateField.inclusion h a) • (S.T h).map f

omit qbarClosure [IsDirectedOrder (Padic.FiniteCoefficientFields l Qbar)] in
private lemma qbar_tr_smul (hS : QbarScalarCompatible l Qbar S)
    {i j M N : Padic.FiniteCoefficientFields l Qbar}
    {hi : i ≤ M} {hj : j ≤ M} (h : M ≤ N) {x : C i} {y : C j}
    (a : M.val) (f : (S.T hi).obj x ⟶ (S.T hj).obj y) :
    S.tr h (a • f) = (IntermediateField.inclusion h a) • S.tr h f := by
  unfold QbarScalarCompatible at hS
  simp only [tr, hS, Linear.comp_smul, Linear.smul_comp]

/-- Scalar multiplication respects eventual equality of representatives.
Source: blueprint scalar-action formula (blueprint: def-weil-pbc-qbar-category).
Proof: choose a common stage witnessing equality of the original representatives,
then enlarge it to contain both scalar-field composita. Semilinearity moves the
scalar through each transition functor. Bilinearity of composition moves the scalar
through the two associator components in transport. Both resulting scalars are the
same element of the enlarged intermediate field, and the original transported
arrows agree there. Thus the multiplied representatives are eventually equal. -/
theorem qbarScalarRep_rel (hS : QbarScalarCompatible l Qbar S) (α : Qbar)
    {X Y : S.PairCategory} {r s : PairCategory.Rep X Y} (h : PairCategory.Rep.Rel r s) :
    PairCategory.Rep.Rel (qbarScalarRep l Qbar S α r) (qbarScalarRep l Qbar S α s) := by
  obtain ⟨p, hr, hs, e⟩ := h
  obtain ⟨b, hb₁, hb₂⟩ := exists_ge_ge
    (qbarScalarRep l Qbar S α r).k (qbarScalarRep l Qbar S α s).k
  obtain ⟨m, hm₁, hm₂⟩ := exists_ge_ge p b
  refine ⟨m, hb₁.trans hm₂, hb₂.trans hm₂, ?_⟩
  dsimp only [qbarScalarRep] at hb₁ hb₂ ⊢
  rw [qbar_tr_smul l Qbar S hS, qbar_tr_smul l Qbar S hS, tr_tr, tr_tr]
  exact congrArg (fun f ↦ (⟨α, _⟩ : m.val) • f)
    (PairCategory.Rep.rel_of_eq hr hs e hm₁)

/-- Scalar multiplication on morphism classes, as opposed to on objects. This is the
class `[N, alpha * u_N]` of the source, with auxiliary choices removed by the quotient.
Source: blueprint scalar-action paragraph (blueprint: def-weil-pbc-qbar-category). -/
def qbarScalarHom (hS : QbarScalarCompatible l Qbar S) (α : Qbar)
    {X Y : S.PairCategory} (f : X ⟶ Y) : X ⟶ Y :=
  Quotient.map (qbarScalarRep l Qbar S α)
    (fun _ _ h ↦ qbarScalarRep_rel l Qbar S hS α h) f

/-- The scalar action can be computed at any overfield containing the scalar and
representative stage; this includes equal stages. Source: blueprint scalar-action
formula (blueprint: def-weil-pbc-qbar-category).
Proof: compare the chosen compositum representative and the displayed representative
at a common finite overfield. The coefficient inclusions send both scalar elements
to the same element, and semilinearity and the transport cocycle identify the arrows.
Quotient equality is exactly eventual equality at such a common stage. -/
theorem qbarScalarHom_mkHom (hS : QbarScalarCompatible l Qbar S) (α : Qbar)
    {X Y : S.PairCategory} (M : Padic.FiniteCoefficientFields l Qbar)
    (hX : X.stage ≤ M) (hY : Y.stage ≤ M)
    (u : X.toStage hX ⟶ Y.toStage hY)
    (N : Padic.FiniteCoefficientFields l Qbar) (hMN : M ≤ N) (hα : α ∈ N.val) :
    qbarScalarHom l Qbar S hS α (PairCategory.mkHom M hX hY u) =
      PairCategory.mkHom N (hX.trans hMN) (hY.trans hMN)
        ((⟨α, hα⟩ : N.val) • S.tr hMN u) := by
  change PairCategory.mkHom _ _ _ _ = _
  rw [PairCategory.mkHom_eq_mkHom_iff']
  obtain ⟨p, hp, hN⟩ := exists_ge_ge
    (Padic.finiteCoefficientCompositum l Qbar M (qbarScalarField l Qbar α)) N
  refine ⟨p, hp, hN, ?_⟩
  rw [qbar_tr_smul l Qbar S hS, qbar_tr_smul l Qbar S hS, tr_tr, tr_tr]
  rfl

private lemma qbarScalarHom_at (hS : QbarScalarCompatible l Qbar S)
    {X Y : S.PairCategory} (M : Padic.FiniteCoefficientFields l Qbar)
    (hX : X.stage ≤ M) (hY : Y.stage ≤ M)
    (u : X.toStage hX ⟶ Y.toStage hY) (a : M.val) :
    qbarScalarHom l Qbar S hS a.val (PairCategory.mkHom M hX hY u) =
      PairCategory.mkHom M hX hY (a • u) := by
  rw [qbarScalarHom_mkHom l Qbar S hS a.val M hX hY u M le_rfl a.property]
  simpa only [qbar_tr_smul l Qbar S hS, IntermediateField.inclusion_self,
    AlgHom.id_apply] using
    (PairCategory.mkHom_tr (le_rfl : M ≤ M) (a • u))

section Linear
variable [transitionAdditive : ∀ {E F : Padic.FiniteCoefficientFields l Qbar}
    (h : E ≤ F), (S.T h).Additive]
include transitionAdditive

/-- The actual quotient scalar action satisfies the module and bilinearity laws.
Source: blueprint scalar-action paragraph (blueprint: def-weil-pbc-qbar-category).
Proof: choose a common field containing all scalar coefficients and all representatives
in each displayed identity. Use the action formula at this field. The six module laws
are the corresponding field-module laws there. Both composition laws follow from
finite-stage linearity. The common-stage equality criterion then descends each law. -/
theorem qbarScalarHom_laws (hS : QbarScalarCompatible l Qbar S) :
    (∀ (X Y : S.PairCategory) (f : X ⟶ Y), qbarScalarHom l Qbar S hS 1 f = f) ∧
    (∀ (X Y : S.PairCategory) (a b : Qbar) (f : X ⟶ Y),
      qbarScalarHom l Qbar S hS (a * b) f =
        qbarScalarHom l Qbar S hS a (qbarScalarHom l Qbar S hS b f)) ∧
    (∀ (X Y : S.PairCategory) (a : Qbar), qbarScalarHom l Qbar S hS a (0 : X ⟶ Y) = 0) ∧
    (∀ (X Y : S.PairCategory) (a : Qbar) (f g : X ⟶ Y),
      qbarScalarHom l Qbar S hS a (f + g) =
        qbarScalarHom l Qbar S hS a f + qbarScalarHom l Qbar S hS a g) ∧
    (∀ (X Y : S.PairCategory) (a b : Qbar) (f : X ⟶ Y),
      qbarScalarHom l Qbar S hS (a + b) f =
        qbarScalarHom l Qbar S hS a f + qbarScalarHom l Qbar S hS b f) ∧
    (∀ (X Y : S.PairCategory) (f : X ⟶ Y), qbarScalarHom l Qbar S hS 0 f = 0) ∧
    (∀ (X Y Z : S.PairCategory) (a : Qbar) (f : X ⟶ Y) (g : Y ⟶ Z),
      qbarScalarHom l Qbar S hS a f ≫ g = qbarScalarHom l Qbar S hS a (f ≫ g)) ∧
    (∀ (X Y Z : S.PairCategory) (a : Qbar) (f : X ⟶ Y) (g : Y ⟶ Z),
      f ≫ qbarScalarHom l Qbar S hS a g = qbarScalarHom l Qbar S hS a (f ≫ g)) := by
  unfold QbarScalarCompatible at hS
  have hadd := (S.pairPreadditive_exists).exists.choose_spec
  have add_mk {X Y : S.PairCategory} (M : Padic.FiniteCoefficientFields l Qbar)
      (hX : X.stage ≤ M) (hY : Y.stage ≤ M)
      (f g : X.toStage hX ⟶ Y.toStage hY) := (hadd X Y M hX hY f g).1
  have zero_mk {X Y : S.PairCategory} (M : Padic.FiniteCoefficientFields l Qbar)
      (hX : X.stage ≤ M) (hY : Y.stage ≤ M) :=
    (hadd X Y M hX hY 0 0).2
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro X Y f
    induction f using PairCategory.hom_induction with
    | h M hX hY u =>
      simpa only [OneMemClass.coe_one, one_smul] using
        qbarScalarHom_at l Qbar S hS M hX hY u (1 : M.val)
  · intro X Y a b f
    let A := Padic.finiteCoefficientCompositum l Qbar
      (qbarScalarField l Qbar a) (qbarScalarField l Qbar b)
    obtain ⟨M, hM, hX, hY, u, rfl⟩ := PairCategory.exists_le_mkHom_eq f A
    have ha : a ∈ M.val := hM (((Padic.finiteCoefficientFields_properties l Qbar).1 _ _).1
      (qbarScalarField_mem l Qbar a))
    have hb : b ∈ M.val := hM (((Padic.finiteCoefficientFields_properties l Qbar).1 _ _).2
      (qbarScalarField_mem l Qbar b))
    let a' : M.val := ⟨a, ha⟩
    let b' : M.val := ⟨b, hb⟩
    change qbarScalarHom l Qbar S hS ((a' * b' : M.val) : Qbar)
      (PairCategory.mkHom M hX hY u) =
        qbarScalarHom l Qbar S hS (a' : Qbar)
          (qbarScalarHom l Qbar S hS (b' : Qbar) (PairCategory.mkHom M hX hY u))
    rw [qbarScalarHom_at l Qbar S hS M hX hY u (a' * b'),
      qbarScalarHom_at l Qbar S hS M hX hY u b',
      qbarScalarHom_at l Qbar S hS M hX hY (b' • u) a', mul_smul]
  · intro X Y a
    obtain ⟨M, hM, hX, hY, u, _⟩ :=
      PairCategory.exists_le_mkHom_eq (0 : X ⟶ Y) (qbarScalarField l Qbar a)
    let a' : M.val := ⟨a, hM (qbarScalarField_mem l Qbar a)⟩
    rw [← zero_mk M hX hY, qbarScalarHom_at l Qbar S hS M hX hY 0 a', smul_zero]
  · intro X Y a f g
    obtain ⟨M, hM, hX, hY, _, _, u, v, rfl, rfl⟩ :=
      PairCategory.exists_common_stage f g (qbarScalarField l Qbar a)
    let a' : M.val := ⟨a, hM (qbarScalarField_mem l Qbar a)⟩
    rw [← add_mk, qbarScalarHom_at l Qbar S hS M hX hY (u + v) a',
      qbarScalarHom_at l Qbar S hS M hX hY u a',
      qbarScalarHom_at l Qbar S hS M hX hY v a', smul_add, add_mk]
  · intro X Y a b f
    let A := Padic.finiteCoefficientCompositum l Qbar
      (qbarScalarField l Qbar a) (qbarScalarField l Qbar b)
    obtain ⟨M, hM, hX, hY, u, rfl⟩ := PairCategory.exists_le_mkHom_eq f A
    have ha : a ∈ M.val := hM (((Padic.finiteCoefficientFields_properties l Qbar).1 _ _).1
      (qbarScalarField_mem l Qbar a))
    have hb : b ∈ M.val := hM (((Padic.finiteCoefficientFields_properties l Qbar).1 _ _).2
      (qbarScalarField_mem l Qbar b))
    let a' : M.val := ⟨a, ha⟩
    let b' : M.val := ⟨b, hb⟩
    change qbarScalarHom l Qbar S hS ((a' + b' : M.val) : Qbar)
      (PairCategory.mkHom M hX hY u) =
        qbarScalarHom l Qbar S hS (a' : Qbar) (PairCategory.mkHom M hX hY u) +
          qbarScalarHom l Qbar S hS (b' : Qbar) (PairCategory.mkHom M hX hY u)
    rw [qbarScalarHom_at l Qbar S hS M hX hY u (a' + b'),
      qbarScalarHom_at l Qbar S hS M hX hY u a',
      qbarScalarHom_at l Qbar S hS M hX hY u b', add_smul, add_mk]
  · intro X Y f
    induction f using PairCategory.hom_induction with
    | h M hX hY u =>
      simpa only [ZeroMemClass.coe_zero, zero_smul, zero_mk M hX hY] using
        qbarScalarHom_at l Qbar S hS M hX hY u (0 : M.val)
  · intro X Y Z a f g
    obtain ⟨M, hM, hX, hY, _, hZ, u, v, rfl, rfl⟩ :=
      PairCategory.exists_common_stage f g (qbarScalarField l Qbar a)
    let a' : M.val := ⟨a, hM (qbarScalarField_mem l Qbar a)⟩
    rw [qbarScalarHom_at l Qbar S hS M hX hY u a',
      PairCategory.mkHom_comp_mkHom, PairCategory.mkHom_comp_mkHom,
      qbarScalarHom_at l Qbar S hS M hX hZ (u ≫ v) a', Linear.smul_comp]
  · intro X Y Z a f g
    obtain ⟨M, hM, hX, hY, _, hZ, u, v, rfl, rfl⟩ :=
      PairCategory.exists_common_stage f g (qbarScalarField l Qbar a)
    let a' : M.val := ⟨a, hM (qbarScalarField_mem l Qbar a)⟩
    rw [qbarScalarHom_at l Qbar S hS M hY hZ v a',
      PairCategory.mkHom_comp_mkHom, PairCategory.mkHom_comp_mkHom,
      qbarScalarHom_at l Qbar S hS M hX hZ (u ≫ v) a', Linear.comp_smul]

/-- The Qbar-linear structure has the explicitly constructed scalar action on Homs.
Source: blueprint scalar-action paragraph (blueprint: def-weil-pbc-qbar-category). -/
@[instance_reducible]
def qbarPairLinear (hS : QbarScalarCompatible l Qbar S) : Linear Qbar S.PairCategory where
  homModule X Y :=
    { smul := fun a f ↦ qbarScalarHom l Qbar S hS a f
      one_smul := (qbarScalarHom_laws l Qbar S hS).1 X Y
      mul_smul := (qbarScalarHom_laws l Qbar S hS).2.1 X Y
      smul_zero := (qbarScalarHom_laws l Qbar S hS).2.2.1 X Y
      smul_add := (qbarScalarHom_laws l Qbar S hS).2.2.2.1 X Y
      add_smul := (qbarScalarHom_laws l Qbar S hS).2.2.2.2.1 X Y
      zero_smul := (qbarScalarHom_laws l Qbar S hS).2.2.2.2.2.1 X Y }
  smul_comp X Y Z := (qbarScalarHom_laws l Qbar S hS).2.2.2.2.2.2.1 X Y Z
  comp_smul X Y Z f a g := (qbarScalarHom_laws l Qbar S hS).2.2.2.2.2.2.2 X Y Z a f g

end Linear
end CategoryTheory.StageSystem

open scoped TensorProduct in
private lemma tensor_map_smul
    {R A S B M N : Type*} [CommRing R] [CommRing A] [CommRing S] [CommRing B]
    [Algebra R A] [Algebra S B] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module S N] (k : A →+* B) (F : M → N)
    (m : A ⊗[R] M →+ B ⊗[S] N)
    (hm : ∀ a f, m (a ⊗ₜ[R] f) = k a ⊗ₜ[S] F f)
    (a : A) (f : A ⊗[R] M) : m (a • f) = k a • m f := by
  induction f using TensorProduct.inductionOn with
  | tmul b f =>
    simp only [TensorProduct.smul_tmul', smul_eq_mul, hm, map_mul]
  | add f g hf hg => simp only [smul_add, map_add, hf, hg]

namespace AlgebraicGeometry.Scheme
attribute [local irreducible] pbcRationalCoefficientEquiv
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped TensorProduct

section StageScalars
variable (l : ℕ) [Fact l.Prime] (Qbar : Type w)
    [Field Qbar] [Algebra ℚ_[l] Qbar] [IsAlgClosure ℚ_[l] Qbar]
    (T : Scheme.{u})

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
set_option linter.unusedSectionVars false in
/-- The fraction field of the actual lifted integer ring is the original finite
intermediate field, fixed by its inclusion of integral elements.
Source: blueprint order 1311, finite-stage scalar action; the recorded
integers-localization-uniformizer lemma
(blueprint: def-weil-pbc-qbar-category).
Proof: apply coefficientExtension_localization_uniformizer to the canonical small
field. Transport across ULift on the integer ring and Shrink.algEquiv on its field.
The resulting ring equivalence fixes every integral element. Every localization
element is an integral numerator divided by a uniformizer power, so this property
determines the equivalence uniquely. -/
theorem qbarStageFieldEquiv_exists (E : Padic.FiniteCoefficientFields l Qbar) :
    ∃! e : Localization.Away (pbcStageUniformizer.{u} l Qbar E) ≃+* E.val,
      ∀ a : PbcIntegralRing l (pbcFiniteField.{u} l Qbar E),
        e (algebraMap (PbcIntegralRing l (pbcFiniteField.{u} l Qbar E))
          (Localization.Away (pbcStageUniformizer.{u} l Qbar E)) a) =
            (Shrink.algEquiv ℚ_[l] E.val) a.down.val := by
  let e := (pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar E)).trans
    (Shrink.algEquiv ℚ_[l] E.val).toRingEquiv
  have he (a : PbcIntegralRing l (pbcFiniteField.{u} l Qbar E)) :
      e (algebraMap _ (Localization.Away (pbcStageUniformizer.{u} l Qbar E)) a) =
        (Shrink.algEquiv ℚ_[l] E.val) a.down.val := by
    dsimp [e]
    rw [scalarRationalCoefficient]
    rfl
  refine ⟨e, he, ?_⟩
  intro e' he'
  apply RingEquiv.toRingHom_injective
  apply IsLocalization.ringHom_ext (Submonoid.powers (pbcStageUniformizer.{u} l Qbar E))
  apply RingHom.ext
  intro a
  exact (he' a).trans (he a).symm

/-- The uniquely integral-normalized coefficient-field identification.
Source: blueprint order 1311 (blueprint: def-weil-pbc-qbar-category). -/
def qbarStageFieldEquiv (E : Padic.FiniteCoefficientFields l Qbar) :
    Localization.Away (pbcStageUniformizer.{u} l Qbar E) ≃+* E.val :=
  (qbarStageFieldEquiv_exists.{w, u} l Qbar E).exists.choose

/-- The finite-stage field acts on the existing tensor Homs by the inverse of the
integral-normalized localization equivalence. Source: blueprint order 1311
(blueprint: def-weil-pbc-qbar-category). -/
instance qbarStageLinear (E : Padic.FiniteCoefficientFields l Qbar) :
    Linear E.val (pbcStageCategory l Qbar T E) where
  homModule K L := Module.compHom (K ⟶ L) (qbarStageFieldEquiv.{w, u} l Qbar E).symm.toRingHom
  smul_comp K L M a f g :=
    Linear.smul_comp K L M ((qbarStageFieldEquiv.{w, u} l Qbar E).symm a) f g
  comp_smul K L M f a g :=
    Linear.comp_smul K L M f ((qbarStageFieldEquiv.{w, u} l Qbar E).symm a) g

end StageScalars

section QbarCoefficients
variable (l : ℕ) [Fact l.Prime] (Qbar : Type w)
    [Field Qbar] [Algebra ℚ_[l] Qbar] [IsAlgClosure ℚ_[l] Qbar]
    (T : Scheme.{u}) [IsNoetherian T]
    [hDim : Fact (∃ n : ℕ, topologicalKrullDim T ≤ (n : WithBot ℕ∞))]
    [hInv : Fact (∀ t : T, IsUnit (l : T.presheaf.stalk t))]

/-- The Qbar coefficient category is exactly the actual finite-stage pair category.
Source: blueprint order 1311 (blueprint: def-weil-pbc-qbar-category).
Objects and Hom classes are unchanged; no Karoubi envelope occurs. -/
abbrev pbcQbarCategory := PbcFiniteStagePairCategory l Qbar T hDim.out hInv.out

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
attribute [-instance] ULift.module in
/-- Coefficient transport is semilinear for the actual intermediate-field inclusions.
Source: blueprint scalar action (blueprint: def-weil-pbc-qbar-category).
Proof: the completed coefficient map sends each constant integral scalar to its
actual field-inclusion image, as can be checked after every finite quotient. On
K-flat tensor representatives this gives integral semilinearity. Pass to the
raw tensor Homs and invert the uniformizer: the integral-normalized fraction-field
equivalences identify the resulting scalar map with IntermediateField.inclusion.
The tensor-unit conjugations used at repeated fields commute with these actions.
Thus the literal-identity normalization has the same semilinearity formula. -/
theorem pbcQbarScalarCompatible :
    StageSystem.QbarScalarCompatible l Qbar (pbcScalarSystem l Qbar T hDim.out hInv.out) := by
  classical
  have he (E : Padic.FiniteCoefficientFields l Qbar) :
      qbarStageFieldEquiv.{w, u} l Qbar E =
        (pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar E)).trans
          (Shrink.algEquiv ℚ_[l] E.val).toRingEquiv := by
    apply (qbarStageFieldEquiv_exists.{w, u} l Qbar E).unique
    · exact (qbarStageFieldEquiv_exists.{w, u} l Qbar E).exists.choose_spec
    · intro a
      dsimp
      rw [scalarRationalCoefficient]
      rfl
  intro E F h K L a f
  change (pbcScalarExtension l Qbar T hDim.out hInv.out h).map (a • f) =
    (IntermediateField.inclusion h a) •
      (pbcScalarExtension l Qbar T hDim.out hInv.out h).map f
  by_cases hEF : E = F
  · subst F
    rw [show pbcScalarExtension l Qbar T hDim.out hInv.out h = 𝟭 _ from
      dite_eq_left (Eq.refl E)]
    rfl
  · let B := pbcRationalScalarExtension l (pbcFiniteField.{u} l Qbar E)
      (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
      T hDim.out hInv.out
    have hb : pbcStageLocalization l Qbar T E ⋙ B =
        pbcIntegralScalarExtension l Qbar T hDim.out hInv.out h ⋙
          pbcStageLocalization l Qbar T F := by
      rw [pbcIntegralScalarExtension_eq l Qbar T hDim.out hInv.out h]
      refine CategoryTheory.Functor.ext
        (F := pbcStageLocalization l Qbar T E ⋙ B)
        (G := pbcEmbeddingIntegralTensor l (pbcFiniteField.{u} l Qbar E)
          (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
          T hDim.out hInv.out ⋙ pbcStageLocalization l Qbar T F) (fun _ ↦ rfl) ?_
      intro K L f
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
      change pbcRationalScalarHom l (pbcFiniteField.{u} l Qbar E)
        (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
        T hDim.out hInv.out K L (1 ⊗ₜ[_] f) = _
      rw [pbcRationalScalarHom_tmul]
      simp only [map_one]
      rfl
    have hB : pbcScalarExtension l Qbar T hDim.out hInv.out h = B := by
      simp only [pbcScalarExtension, dite_eq_right hEF]
      exact (pbcRationalScalarExtension_exists l Qbar T hDim.out hInv.out h).unique
        (pbcRationalScalarExtension_exists l Qbar T hDim.out hInv.out h).exists.choose_spec hb
    rw [hB]
    change pbcRationalScalarHom l (pbcFiniteField.{u} l Qbar E)
      (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
      T hDim.out hInv.out K.obj L.obj
        ((qbarStageFieldEquiv.{w, u} l Qbar E).symm a • f) =
      (qbarStageFieldEquiv.{w, u} l Qbar F).symm (IntermediateField.inclusion h a) •
        pbcRationalScalarHom l (pbcFiniteField.{u} l Qbar E)
          (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
          T hDim.out hInv.out K.obj L.obj f
    let k := (pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar F)).symm.toRingHom.comp
      ((pbcFiniteFieldInclusion l Qbar h).toRingHom.comp
        (pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar E)).toRingHom)
    have ht := tensor_map_smul
      (R := PbcIntegralRing l (pbcFiniteField.{u} l Qbar E))
      (A := Localization.Away (pbcStageUniformizer.{u} l Qbar E))
      (S := PbcIntegralRing l (pbcFiniteField.{u} l Qbar F))
      (B := Localization.Away (pbcStageUniformizer.{u} l Qbar F))
      k (fun f ↦ (pbcEmbeddingIntegralTensor l (pbcFiniteField.{u} l Qbar E)
        (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
        T hDim.out hInv.out).map f)
      (pbcRationalScalarHom l (pbcFiniteField.{u} l Qbar E)
        (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
        T hDim.out hInv.out K.obj L.obj)
      (pbcRationalScalarHom_tmul l (pbcFiniteField.{u} l Qbar E)
        (pbcFiniteField.{u} l Qbar F) (pbcFiniteFieldInclusion l Qbar h)
        T hDim.out hInv.out K.obj L.obj)
      ((qbarStageFieldEquiv.{w, u} l Qbar E).symm a) f
    refine ht.trans ?_
    congr 1
    rw [he E, he F]
    change (pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar F)).symm
      ((Shrink.algEquiv ℚ_[l] F.val).symm (IntermediateField.inclusion h
        ((Shrink.algEquiv ℚ_[l] E.val)
          ((pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar E))
            ((pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar E)).symm
              ((Shrink.algEquiv ℚ_[l] E.val).symm a)))))) =
      (pbcRationalCoefficientEquiv l (pbcFiniteField.{u} l Qbar F)).symm
        ((Shrink.algEquiv ℚ_[l] F.val).symm (IntermediateField.inclusion h a))
    rw [RingEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]

/-- The Qbar-linear structure uses exactly the common-stage scalar action.
Source: blueprint order 1311 (blueprint: def-weil-pbc-qbar-category). -/
instance pbcQbarLinear : Linear Qbar (pbcQbarCategory l Qbar T) :=
  StageSystem.qbarPairLinear l Qbar (pbcScalarSystem l Qbar T hDim.out hInv.out)
    (pbcQbarScalarCompatible l Qbar T)

end QbarCoefficients
end AlgebraicGeometry.Scheme
