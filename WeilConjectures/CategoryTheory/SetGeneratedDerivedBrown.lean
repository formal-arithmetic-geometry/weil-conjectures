module

public import WeilConjectures.CategoryTheory.GrothendieckAbelian.HasDerivedCategory
public import WeilConjectures.CategoryTheory.Triangulated.LocalizingClosure
public import Mathlib.CategoryTheory.Triangulated.Yoneda
public import Mathlib.CategoryTheory.Triangulated.Opposite.Pretriangulated
import WeilConjectures.CategoryTheory.SixFunctors.SetGeneratedDerivedSolutionSet
import WeilConjectures.CategoryTheory.SixFunctors.CohomologicalSolutionSetRepresentability
import WeilConjectures.CategoryTheory.SmoothPurity.CountableCoproductsIdempotentComplete

/-!
# Brown representability in a set-generated derived hull

Source: literature/krause-localization-theory-arXiv-0806.1324.pdf, Section 7.7,
Theorems 7.2.1 and 5.1.1 (blueprint: lem-dla1-set-generated-derived-brown).

The proof first applies the set-generated solution-set theorem to the localizing closure
of the given small family.  The closure has the ambient coproducts and is idempotent complete
by the countable-coproduct criterion.  The cohomological solution-set representability theorem
then yields a representing object.  Its underlying bijections are additive because the given
functor is additive, so they assemble to an isomorphism in abelian groups.
-/

@[expose] public section

universe v u

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.Pretriangulated
open CategoryTheory.Pretriangulated.Opposite

namespace CategoryTheory

/--
Brown representability for the localizing subcategory generated by a small family in the
unbounded derived category of a Grothendieck abelian category.

Source: literature/krause-localization-theory-arXiv-0806.1324.pdf, Section 7.7,
Theorems 7.2.1 and 5.1.1 (blueprint: lem-dla1-set-generated-derived-brown).

Proof: Let `P` be the range of `g` and `Q := P.localizingClosure`.  The definition of
`localizingClosure` supplies repleteness, triangulated closure, coproduct closure, and minimality;
its full subcategory inherits the ambient shifts, triangles, and coproducts.  Apply
`setGeneratedDerived_cohomological_solutionSet` with `P` and `Q` to obtain a small weakly
universal family for `H`.  The countable coproducts in `Q` split idempotents by
`isIdempotentComplete_of_countableCoproducts`.  Apply
`cohomological_isRepresentable_of_solutionSet` to obtain an underlying set-valued
representing object.  If `e_X` is the resulting natural bijection, additivity gives
`e_X(f + g) = e_X(f) + e_X(g)` and `e_X(0) = 0`; hence every `e_X` is an abelian-group
isomorphism, natural in `X`, yielding the displayed natural isomorphism.
-/
theorem setGeneratedDerivedBrownRepresentability
    {A : Type u} [Category.{v} A] [Abelian A]
    [IsGrothendieckAbelian.{v} A] [HasDerivedCategory.{v} A]
    [HasCoproducts.{v} (DerivedCategory A)]
    (G : Type v) (g : G → DerivedCategory A)
    (H :
      (ObjectProperty.localizingClosure
        (Set.range g : ObjectProperty (DerivedCategory A))).FullSubcategoryᵒᵖ ⥤
          AddCommGrpCat.{v})
    [H.Additive] [H.IsHomological]
    (hH : ∀ I : Type v, PreservesLimitsOfShape (Discrete I) H) :
    ∃ R :
      (ObjectProperty.localizingClosure
        (Set.range g : ObjectProperty (DerivedCategory A))).FullSubcategory,
      Nonempty (preadditiveYoneda.obj R ≅ H) := by
  classical
  let P : ObjectProperty (DerivedCategory A) := Set.range g
  have : ObjectProperty.Small.{v} P := by
    exact small_of_surjective
      (f := fun i : G ↦ (⟨g i, ⟨i, rfl⟩⟩ : Subtype P))
      (by rintro ⟨_, i, rfl⟩; exact ⟨i, rfl⟩)
  have : IsIdempotentComplete P.localizingClosure.FullSubcategory :=
    isIdempotentComplete_of_countableCoproducts _
  have hsol := setGeneratedDerived_cohomological_solutionSet P P.localizingClosure
    P.le_localizingClosure
    (fun Q hQ _ _ hcop ↦ by
      have : Q.IsLocalizing := ⟨hcop⟩
      exact ObjectProperty.localizingClosure_le hQ) H hH
  have hrep := cohomological_isRepresentable_of_solutionSet H hH hsol
  obtain ⟨R, ⟨e⟩⟩ := hrep.has_representation
  let x : H.obj (op R) := e.homEquiv (𝟙 R)
  let α : preadditiveYoneda.obj R ⟶ H :=
    { app Y := AddCommGrpCat.ofHom
        { toFun f := H.map f.op x
          map_zero' := by simp
          map_add' f g := by
            exact congrArg (fun t : H.obj (op R) ⟶ H.obj Y ↦ t x)
              (H.map_add (f := f.op) (g := g.op)) }
      naturality Y Y' f := by
        ext g
        change H.map (f.unop ≫ g).op x = H.map f (H.map g.op x)
        rw [op_comp, H.map_comp]
        rfl }
  have hα (Y) : Function.Bijective (α.app Y) := by
    change Function.Bijective (fun f : Y.unop ⟶ R ↦ H.map f.op x)
    have he : (fun f : Y.unop ⟶ R ↦ H.map f.op x) = e.homEquiv := by
      funext f
      exact (e.homEquiv_eq f).symm
    rw [he]
    exact e.homEquiv.bijective
  have : ∀ Y, IsIso (α.app Y) :=
    fun Y ↦ (ConcreteCategory.isIso_iff_bijective _).2 (hα Y)
  have : IsIso α := NatIso.isIso_of_isIso_app α
  exact ⟨R, ⟨asIso α⟩⟩

end CategoryTheory
