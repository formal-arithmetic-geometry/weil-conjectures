module

public import WeilConjectures.CategoryTheory.Triangulated.Brown.Basic

/-!
# Brown representability for compactly generated triangulated categories

Let `C` be a pretriangulated category with coproducts, compactly generated by a family `S`
(all shifts `S i⟦n⟧` are compact and detect zero objects). Then every additive cohomological
functor `H : Cᵒᵖ ⥤ AddCommGrpCat` sending coproducts to products is representable
(Neeman, *The Grothendieck duality theorem via Bousfield's techniques and Brown
representability*, Theorem 3.1; Stacks `0F5Y` for the well generated case).

## Proof

Write `G` for the family of all shifts `S i⟦n⟧`. We build a tower `X₀ ⟶ X₁ ⟶ ⋯` with classes
`uₙ ∈ H Xₙ` compatible under the transition maps:

* `X₀ = ∐_{(k, x), x ∈ H (G k)} G k`, so that `Hom(G k, X₀) ⟶ H (G k)` is surjective;
* `X_{n+1}` is the cone of `∐_{(k, φ)} G k ⟶ Xₙ`, the sum over all `φ : G k ⟶ Xₙ` killing
  `uₙ`; the class `uₙ` extends to `X_{n+1}` since `H` is cohomological.

The homotopy colimit `X` of the tower (the cone of `1 - shift` on `∐ Xₙ`) carries a class `u`
restricting to all `uₙ`, and compactness of the `G k` shows that `Hom(G k, X) ⟶ H (G k)`,
`φ ↦ H φ u`, is bijective. Moreover `X` is *cellular*: it lies in every class of objects
containing the `G k` and closed under coproducts and cones.

The objects `Y` for which `Hom(Y⟦n⟧, X) ⟶ H (Y⟦n⟧)` is bijective for all `n` form such a class
(five lemma), so they contain all cellular objects. Finally every object `Y` is cellular:
applying the construction to `Hom(-, Y)` gives a cellular `X_Y` with a morphism `X_Y ⟶ Y`
inducing bijections on `Hom(G k, -)`; its cone is zero since the `G k` detect zero objects.

## Main statements

- `CategoryTheory.Pretriangulated.IsCompactGeneratingFamily.hasBrownRepresentability`.
-/

@[expose] public section

universe w u

namespace CategoryTheory.Pretriangulated

open Limits Opposite Preadditive

variable {C : Type u} [Category.{w} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- An object is `G`-*cellular* if it belongs to every class of objects which contains the
objects `G k` and is closed under coproducts (indexed by types in `Type w`) and cones. -/
def IsCellular {κ : Type w} (G : κ → C) (X : C) : Prop :=
  ∀ P : ObjectProperty C, (∀ k, P (G k)) →
    (∀ ⦃J : Type w⦄ (f : J → C) (c : Cofan f), IsColimit c → (∀ j, P (f j)) → P c.pt) →
    (∀ T ∈ distTriang C, P T.obj₁ → P T.obj₂ → P T.obj₃) → P X

namespace IsCellular

variable {κ : Type w} {G : κ → C}

lemma of_cofan {J : Type w} {f : J → C} (c : Cofan f) (hc : IsColimit c)
    (hf : ∀ j, IsCellular G (f j)) : IsCellular G c.pt :=
  fun P h₁ h₂ h₃ ↦ h₂ f c hc fun j ↦ hf j P h₁ h₂ h₃

lemma of_triangle (T : Triangle C) (hT : T ∈ distTriang C) (h₁ : IsCellular G T.obj₁)
    (h₂ : IsCellular G T.obj₂) : IsCellular G T.obj₃ :=
  fun P hP₁ hP₂ hP₃ ↦ hP₃ T hT (h₁ P hP₁ hP₂ hP₃) (h₂ P hP₁ hP₂ hP₃)

lemma generator (k : κ) : IsCellular G (G k) := fun _ h₁ _ _ ↦ h₁ k

/-- A cellular object is cellular for any larger family. -/
lemma of_iso {X Y : C} (e : X ≅ Y) (hX : IsCellular G X) : IsCellular G Y := by
  let c : Cofan (fun _ : PUnit.{w + 1} ↦ X) := Cofan.mk Y fun _ ↦ e.hom
  have hc : IsColimit c := mkCofanColimit c (fun s ↦ e.inv ≫ s.inj PUnit.unit)
    (fun s j ↦ by simp [c]) (fun s m hm ↦ by simp [← hm PUnit.unit, c])
  exact of_cofan c hc fun _ ↦ hX

end IsCellular

section Algebra

/-- Let `Q` be a coproduct of a sequence `Zₙ`, with `σ : Q ⟶ Q` induced by maps
`gₙ : Zₙ ⟶ Z_{n+1}`. A finite sum `∑ ψₙ ≫ ιₙ` killed by `1 - σ` is zero. -/
lemma sum_eq_zero_of_comp_sub_eq_zero {Z : ℕ → C} (g : ∀ n, Z n ⟶ Z (n + 1)) (Q : Cofan Z)
    (hQ : IsColimit Q) (σ : Q.pt ⟶ Q.pt) (hσ : ∀ n, Q.inj n ≫ σ = g n ≫ Q.inj (n + 1))
    {Y : C} (s : Finset ℕ) (ψ : ∀ n, Y ⟶ Z n)
    (h : (∑ n ∈ s, ψ n ≫ Q.inj n) ≫ (𝟙 _ - σ) = 0) : ∑ n ∈ s, ψ n ≫ Q.inj n = 0 := by
  classical
  -- projections `Q ⟶ Z m`
  let p (m : ℕ) : Q.pt ⟶ Z m := Cofan.IsColimit.desc hQ fun n ↦
    if hn : n = m then eqToHom (congrArg Z hn) else 0
  have hp (n m : ℕ) : Q.inj n ≫ p m = if hn : n = m then eqToHom (congrArg Z hn) else 0 :=
    Cofan.IsColimit.fac hQ _ n
  let ψ' (n : ℕ) : Y ⟶ Z n := if n ∈ s then ψ n else 0
  set x := ∑ n ∈ s, ψ n ≫ Q.inj n with hx
  have hxp (m : ℕ) : x ≫ p m = ψ' m := by
    simp only [x, ψ', sum_comp, Category.assoc, hp]
    split_ifs with hm
    · rw [Finset.sum_eq_single m (fun b _ hb ↦ by rw [dif_neg hb, comp_zero])
        (fun h ↦ absurd hm h)]
      simp
    · exact Finset.sum_eq_zero fun n hn ↦ by
        rw [dif_neg (fun h ↦ hm (h ▸ hn)), comp_zero]
  have hxσp (m : ℕ) : x ≫ σ ≫ p (m + 1) = ψ' m ≫ g m := by
    simp only [x, ψ', sum_comp, Category.assoc, reassoc_of% hσ, hp]
    split_ifs with hm
    · rw [Finset.sum_eq_single m (fun b _ hb ↦ by
        rw [dif_neg (fun h ↦ hb (by omega)), comp_zero, comp_zero])
        (fun h ↦ absurd hm h)]
      simp
    · rw [zero_comp]
      exact Finset.sum_eq_zero fun n hn ↦ by
        rw [dif_neg (fun h ↦ hm (by rw [show m = n by omega]; exact hn)), comp_zero,
          comp_zero]
  have hxσ0 : x ≫ σ ≫ p 0 = 0 := by
    simp only [x, sum_comp, Category.assoc, reassoc_of% hσ, hp]
    exact Finset.sum_eq_zero fun n _ ↦ by
      rw [dif_neg (Nat.succ_ne_zero n), comp_zero, comp_zero]
  have hψ' : ∀ m, ψ' m = 0 := by
    intro m
    induction m with
    | zero =>
      have := h =≫ p 0
      rw [Category.assoc, sub_comp, Category.id_comp, comp_sub, hxp, hxσ0, sub_zero,
        zero_comp] at this
      exact this
    | succ m ih =>
      have := h =≫ p (m + 1)
      rw [Category.assoc, sub_comp, Category.id_comp, comp_sub, hxp, hxσp, ih, zero_comp,
        sub_zero, zero_comp] at this
      exact this
  refine Finset.sum_eq_zero fun n hn ↦ ?_
  have := hψ' n
  simp only [ψ', hn, if_true] at this
  rw [this, zero_comp]

end Algebra


variable (H : Cᵒᵖ ⥤ AddCommGrpCat.{w}) [H.Additive] {κ : Type w} (G : κ → C)
  [HasCoproducts.{w} C]

include G in
omit [H.Additive] in
lemma hasCoproductsOfShape_nat : HasCoproductsOfShape ℕ C := hasCoproductsOfShape_of_small.{w} C ℕ

attribute [local instance] hasCoproductsOfShape_nat

section Tower

variable {H}

lemma IsBrownFunctor.exists_stage₀ (hH : IsBrownFunctor H) :
    ∃ (X : C) (u : H.obj (op X)), IsCellular G X ∧
      ∀ k (x : H.obj (op (G k))), ∃ φ : G k ⟶ X, H.map φ.op u = x := by
  let I := Σ k, H.obj (op (G k))
  let f : I → C := fun i ↦ G i.1
  obtain ⟨u, hu⟩ := (hH.bijective f _ (coproductIsCoproduct f)).2 fun i ↦ i.2
  refine ⟨∐ f, u, IsCellular.of_cofan _ (coproductIsCoproduct f)
    fun i ↦ IsCellular.generator i.1, fun k x ↦ ⟨Sigma.ι f ⟨k, x⟩, ?_⟩⟩
  exact congrFun hu ⟨k, x⟩

lemma IsBrownFunctor.exists_step (hH : IsBrownFunctor H) (X : C) (u : H.obj (op X)) :
    ∃ (X' : C) (f : X ⟶ X') (u' : H.obj (op X')), (IsCellular G X → IsCellular G X') ∧
      H.map f.op u' = u ∧ ∀ k (φ : G k ⟶ X), H.map φ.op u = 0 → φ ≫ f = 0 := by
  let I := Σ k, {φ : G k ⟶ X // H.map φ.op u = 0}
  let F : I → C := fun i ↦ G i.1
  let g : ∐ F ⟶ X := Sigma.desc fun i ↦ i.2.1
  obtain ⟨X', f, h, hT⟩ := distinguished_cocone_triangle g
  have hg : H.map g.op u = 0 := by
    apply (hH.bijective F _ (coproductIsCoproduct F)).1
    funext i
    simp only [cofan_mk_inj, map_zero]
    rw [← H.map_op_comp_apply]
    simp only [g, Sigma.ι_desc]
    exact i.2.2
  obtain ⟨u', hu'⟩ := hH.exact _ hT u hg
  refine ⟨X', f, u', fun hX ↦ IsCellular.of_triangle _ hT ?_ hX, hu', fun k φ hφ ↦ ?_⟩
  · exact IsCellular.of_cofan _ (coproductIsCoproduct F) fun i ↦ IsCellular.generator i.1
  · have : φ = Sigma.ι F ⟨k, φ, hφ⟩ ≫ g := by simp [g]
    rw [this, Category.assoc, show g ≫ f = 0 from comp_distTriang_mor_zero₁₂ _ hT, comp_zero]

end Tower

/-- The data of the tower used in the proof of Brown representability. -/
structure BrownTower where
  /-- The terms of the tower. -/
  X : ℕ → C
  /-- The transition maps. -/
  f (n : ℕ) : X n ⟶ X (n + 1)
  /-- The compatible classes. -/
  u (n : ℕ) : H.obj (op (X n))
  cellular (n : ℕ) : IsCellular G (X n)
  hu (n : ℕ) : H.map (f n).op (u (n + 1)) = u n
  surj (k : κ) (x : H.obj (op (G k))) : ∃ φ : G k ⟶ X 0, H.map φ.op (u 0) = x
  kill (n : ℕ) (k : κ) (φ : G k ⟶ X n) : H.map φ.op (u n) = 0 → φ ≫ f n = 0

variable {H G}

lemma IsBrownFunctor.nonempty_brownTower (hH : IsBrownFunctor H) :
    Nonempty (BrownTower H G) := by
  obtain ⟨X₀, u₀, hX₀, hsurj⟩ := hH.exists_stage₀ G
  choose X' f u' hcell hu hkill using hH.exists_step G
  let t : ℕ → Σ X : C, H.obj (op X) := fun n ↦ Nat.rec ⟨X₀, u₀⟩
    (fun _ p ↦ ⟨X' p.1 p.2, u' p.1 p.2⟩) n
  have ht (n : ℕ) : t (n + 1) = ⟨X' (t n).1 (t n).2, u' (t n).1 (t n).2⟩ := rfl
  have hcellt (n : ℕ) : IsCellular G (t n).1 := by
    induction n with
    | zero => exact hX₀
    | succ n ih => exact hcell _ _ ih
  exact ⟨{
    X n := (t n).1
    f n := f (t n).1 (t n).2
    u n := (t n).2
    cellular := hcellt
    hu n := hu _ _
    surj := hsurj
    kill n := hkill _ _ }⟩

namespace BrownTower

variable (𝒯 : BrownTower H G)

/-- The shift map `∐ Xₙ ⟶ ∐ Xₙ`. -/
noncomputable def σ : ∐ 𝒯.X ⟶ ∐ 𝒯.X := Sigma.desc fun n ↦ 𝒯.f n ≫ Sigma.ι 𝒯.X (n + 1)

@[reassoc (attr := simp)]
lemma ι_σ (n : ℕ) : Sigma.ι 𝒯.X n ≫ 𝒯.σ = 𝒯.f n ≫ Sigma.ι 𝒯.X (n + 1) := by
  simp [σ]

end BrownTower

/-- The output of the construction: an object `X` with a class `u` such that `φ ↦ H φ u` is
bijective on the `G k`, and `X` is cellular. -/
lemma IsBrownFunctor.exists_cellular (hH : IsBrownFunctor H)
    (hG : ∀ k, IsCompactObject (G k)) :
    ∃ (X : C) (u : H.obj (op X)), IsCellular G X ∧
      ∀ k, Function.Bijective (fun φ : G k ⟶ X ↦ H.map φ.op u) := by
  obtain ⟨𝒯⟩ := hH.nonempty_brownTower (G := G)
  obtain ⟨X, π, δ, hT⟩ := distinguished_cocone_triangle (𝟙 (∐ 𝒯.X) - 𝒯.σ)
  let πn (n : ℕ) : 𝒯.X n ⟶ X := Sigma.ι 𝒯.X n ≫ π
  have hπ (n : ℕ) : 𝒯.f n ≫ πn (n + 1) = πn n := by
    have := Sigma.ι 𝒯.X n ≫= comp_distTriang_mor_zero₁₂ _ hT
    simp only [Triangle.mk_mor₁, Triangle.mk_mor₂, comp_sub, Category.comp_id,
      sub_comp, 𝒯.ι_σ_assoc, comp_zero, sub_eq_zero] at this
    exact this.symm
  have hπle (n : ℕ) : ∀ N, n ≤ N → ∃ g : 𝒯.X n ⟶ 𝒯.X N, g ≫ πn N = πn n := by
    intro N hN
    induction N, hN using Nat.le_induction with
    | base => exact ⟨𝟙 _, Category.id_comp _⟩
    | succ N _ ih =>
      obtain ⟨g, hg⟩ := ih
      exact ⟨g ≫ 𝒯.f N, by rw [Category.assoc, hπ, hg]⟩
  -- the class `u`
  obtain ⟨U, hU⟩ := (hH.bijective 𝒯.X _ (coproductIsCoproduct 𝒯.X)).2 𝒯.u
  have hU' (n : ℕ) : H.map (Sigma.ι 𝒯.X n).op U = 𝒯.u n := congrFun hU n
  obtain ⟨u, hu⟩ := hH.exact _ hT U (by
    apply (hH.bijective 𝒯.X _ (coproductIsCoproduct 𝒯.X)).1
    funext n
    simp only [cofan_mk_inj, Triangle.mk_mor₁, map_zero]
    rw [← H.map_op_comp_apply, comp_sub, Category.comp_id,
      𝒯.ι_σ, op_sub, H.map_sub, AddCommGrpCat.hom_sub, AddMonoidHom.sub_apply, hU',
      H.map_op_comp_apply, hU', 𝒯.hu, sub_self])
  have hun (n : ℕ) : H.map (πn n).op u = 𝒯.u n := by
    simp only [πn, H.map_op_comp_apply]
    erw [hu]
    exact hU' n
  -- maps from compact objects factor through a finite stage
  have hfac (k : κ) (φ : G k ⟶ X) : ∃ (N : ℕ) (ψ : G k ⟶ 𝒯.X N), φ = ψ ≫ πn N := by
    have hP1 := isColimitCofanMkObjOfIsColimit (shiftFunctor C (1 : ℤ)) 𝒯.X _
      (coproductIsCoproduct 𝒯.X)
    obtain ⟨s, ψ, hψ⟩ := hG k _ _ hP1 (φ ≫ δ)
    have hδ : φ ≫ δ = 0 := by
      rw [hψ]
      refine sum_eq_zero_of_comp_sub_eq_zero (fun n ↦ (𝒯.f n)⟦(1 : ℤ)⟧') _ hP1
        (𝒯.σ⟦(1 : ℤ)⟧') (fun n ↦ ?_) s ψ ?_
      · simp only [cofan_mk_inj, ← Functor.map_comp, 𝒯.ι_σ]
      · have h₀ := comp_distTriang_mor_zero₃₁ _ hT
        simp only [Triangle.mk_mor₃, Triangle.mk_mor₁, Functor.map_sub, Functor.map_id] at h₀
        simp only [Cofan.mk_pt] at hψ ⊢
        rw [← hψ, Category.assoc, h₀, comp_zero]
    obtain ⟨χ, hχ⟩ := Triangle.coyoneda_exact₃ _ hT φ hδ
    obtain ⟨s', χ', hχ'⟩ := hG k _ _ (coproductIsCoproduct 𝒯.X) χ
    obtain ⟨N, hN⟩ : ∃ N, ∀ n ∈ s', n ≤ N := ⟨s'.sup id, fun n hn ↦ Finset.le_sup (f := id) hn⟩
    choose g hg using fun n (hn : n ∈ s') ↦ hπle n N (hN n hn)
    refine ⟨∑ n ∈ s'.attach, χ' n ≫ g n.1 n.2, ?_⟩
    rw [hχ, hχ']
    simp only [cofan_mk_inj, Triangle.mk_mor₂, sum_comp, Category.assoc]
    rw [← Finset.sum_attach]
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    rw [hg]
  refine ⟨X, u, ?_, fun k ↦ ⟨?_, fun x ↦ ?_⟩⟩
  · refine IsCellular.of_triangle _ hT ?_ ?_ <;>
      exact IsCellular.of_cofan _ (coproductIsCoproduct 𝒯.X) 𝒯.cellular
  · rw [← AddMonoidHom.coe_mk (M := G k ⟶ X) ⟨fun φ ↦ H.map φ.op u, by simp⟩ (by
      intro a b; simp [op_add, H.map_add])]
    rw [injective_iff_map_eq_zero]
    intro φ hφ
    obtain ⟨N, ψ, rfl⟩ := hfac k φ
    simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, H.map_op_comp_apply,
      hun] at hφ
    rw [← hπ, ← Category.assoc, 𝒯.kill N k ψ hφ, zero_comp]
  · obtain ⟨φ, hφ⟩ := 𝒯.surj k x
    refine ⟨φ ≫ πn 0, ?_⟩
    simp only [H.map_op_comp_apply, hun, hφ]

section Good

variable {X : C} (u : H.obj (op X))

/-- `Y` is *good* for `u ∈ H X` if `φ ↦ H φ u` is a bijection `Hom(Y, X) ≃ H Y`. -/
def IsGoodFor (Y : C) : Prop := Function.Bijective (fun φ : Y ⟶ X ↦ H.map φ.op u)

variable {u}

lemma IsGoodFor.of_iso {Y Y' : C} (e : Y ≅ Y') (h : IsGoodFor u Y) : IsGoodFor u Y' := by
  have key : (fun φ : Y' ⟶ X ↦ H.map φ.op u) =
      (fun x ↦ H.map e.inv.op x) ∘ (fun φ : Y ⟶ X ↦ H.map φ.op u) ∘ (fun φ ↦ e.hom ≫ φ) := by
    funext φ
    simp only [Function.comp_apply, ← H.map_op_comp_apply, Iso.inv_hom_id_assoc]
  rw [IsGoodFor, key]
  refine (ConcreteCategory.bijective_of_isIso (H.map e.inv.op)).comp (h.comp ?_)
  exact (Function.bijective_iff_has_inverse).2 ⟨fun φ ↦ e.inv ≫ φ, fun φ ↦ by simp,
    fun φ ↦ by simp⟩

lemma exact_leftComp (T : Triangle C) (hT : T ∈ distTriang C) (X : C) :
    Function.Exact (leftComp X T.mor₂) (leftComp X T.mor₁) := fun y ↦ by
  change T.mor₁ ≫ y = 0 ↔ ∃ z, T.mor₂ ≫ z = y
  refine ⟨fun hy ↦ ?_, fun ⟨z, hz⟩ ↦ by rw [← hz, comp_distTriang_mor_zero₁₂_assoc _ hT]⟩
  obtain ⟨z, hz⟩ := Triangle.yoneda_exact₂ T hT y hy
  exact ⟨z, hz.symm⟩

lemma IsBrownFunctor.isGoodFor_obj₃ (hH : IsBrownFunctor H) (T : Triangle C)
    (hT : T ∈ distTriang C) (h₁ : IsGoodFor u T.obj₁) (h₂ : IsGoodFor u T.obj₂)
    (h₁' : IsGoodFor u (T.obj₁⟦(1 : ℤ)⟧)) (h₂' : IsGoodFor u (T.obj₂⟦(1 : ℤ)⟧)) :
    IsGoodFor u T.obj₃ := by
  have hT' := rot_of_distTriang _ hT
  have hT'' := rot_of_distTriang _ hT'
  have hc {A B : C} (m : A ⟶ B) : (H.map m.op).hom.comp (brownHom H u B) =
      (brownHom H u A).comp (leftComp X m) := by
    ext φ
    exact (H.map_op_comp_apply m φ u).symm
  exact AddMonoidHom.bijective_of_surjective_of_bijective_of_bijective_of_injective
    (leftComp X T.rotate.rotate.mor₂) (leftComp X T.mor₃) (leftComp X T.mor₂)
    (leftComp X T.mor₁)
    (H.map T.rotate.rotate.mor₂.op).hom (H.map T.mor₃.op).hom (H.map T.mor₂.op).hom
    (H.map T.mor₁.op).hom
    (brownHom H u _) (brownHom H u _) (brownHom H u _) (brownHom H u _) (brownHom H u _)
    (hc _) (hc _) (hc _) (hc _)
    (exact_leftComp _ hT'' X) (exact_leftComp _ hT' X) (exact_leftComp _ hT X)
    (hH.functionExact _ hT'') (hH.functionExact _ hT') (hH.functionExact _ hT)
    h₂'.2 h₁' h₂ h₁.1

/-- `Y` is good for `u` in all shifts. -/
def IsGoodForAll (u : H.obj (op X)) (Y : C) : Prop := ∀ n : ℤ, IsGoodFor u (Y⟦n⟧)

lemma IsBrownFunctor.isGoodForAll_obj₃ (hH : IsBrownFunctor H) (T : Triangle C)
    (hT : T ∈ distTriang C) (h₁ : IsGoodForAll u T.obj₁) (h₂ : IsGoodForAll u T.obj₂) :
    IsGoodForAll u T.obj₃ := fun n ↦
  hH.isGoodFor_obj₃ _ (Triangle.shift_distinguished T hT n) (h₁ n) (h₂ n)
    ((h₁ (n + 1)).of_iso ((shiftFunctorAdd C n 1).app _))
    ((h₂ (n + 1)).of_iso ((shiftFunctorAdd C n 1).app _))

lemma IsBrownFunctor.isGoodForAll_of_cofan (hH : IsBrownFunctor H) {J : Type w} {f : J → C}
    (c : Cofan f) (hc : IsColimit c) (hf : ∀ j, IsGoodForAll u (f j)) :
    IsGoodForAll u c.pt := fun n ↦ by
  have hc' := isColimitCofanMkObjOfIsColimit (shiftFunctor C n) f c.inj hc
  have hA := (isBrownFunctor_preadditiveYoneda X).bijective _ _ hc'
  have hB := hH.bijective _ _ hc'
  have hP : Function.Bijective (fun (ψ : ∀ j, (f j)⟦n⟧ ⟶ X) (j : J) ↦
      H.map (ψ j).op u) := by
    refine ⟨fun a b h ↦ funext fun j ↦ (hf j n).1 (congrFun h j), fun y ↦ ?_⟩
    choose ψ hψ using fun j ↦ (hf j n).2 (y j)
    exact ⟨ψ, funext hψ⟩
  have key : (fun (x : H.obj (op (c.pt⟦n⟧))) (j : J) ↦ H.map ((c.inj j)⟦n⟧').op x) ∘
      (fun φ : c.pt⟦n⟧ ⟶ X ↦ H.map φ.op u) =
      (fun (ψ : ∀ j, (f j)⟦n⟧ ⟶ X) (j : J) ↦ H.map (ψ j).op u) ∘
        (fun (φ : c.pt⟦n⟧ ⟶ X) (j : J) ↦ (c.inj j)⟦n⟧' ≫ φ) := by
    funext φ j
    simp only [Function.comp_apply, ← H.map_op_comp_apply, Iso.inv_hom_id_assoc]
  have := hP.comp hA
  rw [← key] at this
  exact (Function.Bijective.of_comp_iff' hB _).1 this

lemma IsCellular.isGoodForAll {κ : Type w} {G : κ → C} (hH : IsBrownFunctor H) {Y : C}
    (hY : IsCellular G Y) (hG : ∀ k, IsGoodForAll u (G k)) : IsGoodForAll u Y :=
  hY (fun Y ↦ IsGoodForAll u Y) hG (fun _ _ c hc hf ↦ hH.isGoodForAll_of_cofan c hc hf)
    (fun T hT h₁ h₂ ↦ hH.isGoodForAll_obj₃ T hT h₁ h₂)

end Good

/-- The family of all shifts of a family of objects. -/
def shiftedFamily {ι : Type w} (S : ι → C) : ι × ℤ → C := fun p ↦ (S p.1)⟦p.2⟧

variable {ι : Type w} {S : ι → C}

/-- In a category compactly generated by `S`, every object is cellular for the shifts of
`S`. -/
lemma IsCompactGeneratingFamily.isCellular (hS : IsCompactGeneratingFamily S) (Y : C) :
    IsCellular (shiftedFamily S) Y := by
  obtain ⟨X, u, hX, hu⟩ := (isBrownFunctor_preadditiveYoneda Y).exists_cellular
    (G := shiftedFamily S) (fun p ↦ hS.isCompactObject p.1 p.2)
  have hu' (i : ι) (n : ℤ) : Function.Bijective (fun φ : (S i)⟦n⟧ ⟶ X ↦ φ ≫ u) := hu ⟨i, n⟩
  have hu'' (i : ι) (n : ℤ) : Function.Bijective (fun φ : (S i)⟦n⟧⟦(-1 : ℤ)⟧ ⟶ X ↦ φ ≫ u) :=
    IsGoodFor.of_iso (H := preadditiveYoneda.obj Y) (u := u)
      ((shiftFunctorAdd C n (-1)).app (S i)) (hu ⟨i, n + (-1)⟩)
  obtain ⟨Z, v, w', hT⟩ := distinguished_cocone_triangle u
  have hZ : IsZero Z := hS.isZero Z fun i n φ ↦ by
    let adj := (shiftEquiv' C (-1 : ℤ) 1 (by norm_num)).toAdjunction
    have hψ : φ ≫ w' = 0 := by
      set χ := (adj.homEquiv _ _).symm (φ ≫ w') with hχ
      have hχu : χ ≫ u = 0 := by
        rw [hχ, ← Adjunction.homEquiv_naturality_right_symm, Category.assoc]
        erw [comp_distTriang_mor_zero₃₁ _ hT]
        rw [comp_zero, Adjunction.homEquiv_counit, Functor.map_zero, zero_comp]
      have hχ0 : χ = 0 := (hu'' i n).1 (by simpa using hχu)
      rw [← (adj.homEquiv _ _).apply_symm_apply (φ ≫ w'), ← hχ, hχ0,
        Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]
    obtain ⟨a, ha⟩ := Triangle.coyoneda_exact₃ _ hT φ hψ
    obtain ⟨b, hb⟩ := (hu' i n).2 a
    simp only at hb
    rw [ha, ← hb, Category.assoc]
    erw [comp_distTriang_mor_zero₁₂ _ hT]
    rw [comp_zero]
  have : IsIso u := (Triangle.isZero₃_iff_isIso₁ _ hT).1 hZ
  exact hX.of_iso (asIso u)

/-- **Brown representability** (Neeman): in a pretriangulated category with coproducts which is
compactly generated, every additive cohomological functor sending coproducts to products is
representable. -/
theorem IsCompactGeneratingFamily.hasBrownRepresentability (hS : IsCompactGeneratingFamily S) :
    HasBrownRepresentability C := by
  intro H _ hH
  obtain ⟨X, u, -, hu⟩ := hH.exists_cellular (G := shiftedFamily S)
    (fun p ↦ hS.isCompactObject p.1 p.2)
  refine ⟨X, u, fun Y ↦ ?_⟩
  have hG (p : ι × ℤ) : IsGoodForAll u (shiftedFamily S p) := fun n ↦
    IsGoodFor.of_iso ((shiftFunctorAdd C p.2 n).app (S p.1)) (hu ⟨p.1, p.2 + n⟩)
  exact ((hS.isCellular Y).isGoodForAll hH hG 0).of_iso ((shiftFunctorZero C ℤ).app Y)

end CategoryTheory.Pretriangulated
