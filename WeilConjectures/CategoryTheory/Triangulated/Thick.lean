module

public import Mathlib.CategoryTheory.ObjectProperty.Retract
public import Mathlib.CategoryTheory.Triangulated.Subcategory

/-!
# Thick subcategories

A full subcategory `P` of a pretriangulated category is *thick* if it contains `0`, is closed
under isomorphisms, shifts in both directions and cones (if two vertices of a distinguished
triangle satisfy `P`, so does the third), and under direct summands (retracts). The thick
subcategory generated by a class `S` of objects is the intersection of all thick subcategories
containing `S` (blueprint `pur9-def-thick`).

## Main definitions

- `CategoryTheory.ObjectProperty.IsThick`: thick subcategories.
- `CategoryTheory.ObjectProperty.thickClosure`: the thick subcategory generated by `S`.
-/

@[expose] public section

namespace CategoryTheory

open Limits Pretriangulated ZeroObject

variable {C : Type*} [Category* C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

namespace ObjectProperty

/-- Blueprint `pur9-def-thick`: a full subcategory `P` of a pretriangulated category is *thick* if
it contains `0` and is closed under shifts in both directions and under cones (a triangulated
subcategory, `CategoryTheory.ObjectProperty.IsTriangulated`), closed under isomorphisms, and
closed under direct summands, i.e. retracts. -/
class IsThick (P : ObjectProperty C) : Prop extends P.IsTriangulated,
    P.IsClosedUnderIsomorphisms, P.IsStableUnderRetracts

/-- Blueprint `pur9-def-thick`: the thick subcategory generated by a class `S` of objects, the
intersection of all thick subcategories containing `S`. -/
def thickClosure (S : ObjectProperty C) : ObjectProperty C :=
  fun X ↦ ∀ P : ObjectProperty C, P.IsThick → S ≤ P → P X

variable (S : ObjectProperty C)

lemma le_thickClosure : S ≤ S.thickClosure :=
  fun _ hX _ _ hSP ↦ hSP _ hX

lemma thickClosure_le {P : ObjectProperty C} [hP : P.IsThick] (h : S ≤ P) :
    S.thickClosure ≤ P :=
  fun _ hX ↦ hX P hP h

instance : S.thickClosure.IsClosedUnderIsomorphisms where
  of_iso e hX P _ hSP := P.prop_of_iso e (hX P ‹_› hSP)

instance : S.thickClosure.IsStableUnderRetracts where
  of_retract r hY P _ hSP := P.prop_of_retract r (hY P ‹_› hSP)

instance : S.thickClosure.ContainsZero where
  exists_zero := ⟨0, isZero_zero C, fun P _ _ ↦ by
    obtain ⟨Z, hZ, hPZ⟩ := P.exists_prop_of_containsZero
    exact P.prop_of_iso (hZ.isoZero ≪≫ (isZero_zero C).isoZero.symm) hPZ⟩

instance (a : ℤ) : S.thickClosure.IsStableUnderShiftBy a where
  le_shift _ hX P _ hSP := P.le_shift a _ (hX P ‹_› hSP)

instance : S.thickClosure.IsStableUnderShift ℤ where

instance : S.thickClosure.IsTriangulatedClosed₂ where
  ext₂' T hT h₁ h₃ := S.thickClosure.le_isoClosure _ fun P _ hSP ↦
    P.ext_of_isTriangulatedClosed₂ T hT (h₁ P ‹_› hSP) (h₃ P ‹_› hSP)

/-- The thick subcategory generated by `S` is thick. -/
instance : S.thickClosure.IsThick where

/-- The thick subcategory generated by `S` is the smallest thick subcategory containing `S`. -/
lemma thickClosure_le_iff {P : ObjectProperty C} [P.IsThick] :
    S.thickClosure ≤ P ↔ S ≤ P :=
  ⟨fun h ↦ (S.le_thickClosure).trans h, S.thickClosure_le⟩

end ObjectProperty

end CategoryTheory
