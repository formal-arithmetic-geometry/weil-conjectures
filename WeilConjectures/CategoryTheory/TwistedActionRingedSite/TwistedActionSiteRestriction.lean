module

public import WeilConjectures.CategoryTheory.TwistedActionRingedSite.TwistedActionRingedSiteDataSupplement
import WeilConjectures.CategoryTheory.TwistedActionRingedSite.TwistedActionSiteCore
import WeilConjectures.CategoryTheory.TwistedActionRingedSite.TwistedActionModuleRestriction
import WeilConjectures.CategoryTheory.TwistedActionRingedSite.TwistedActionSetRestriction
import WeilConjectures.CategoryTheory.TwistedActionRingedSite.TwistedActionGeometricRestriction

/-! # Construction of the twisted action site and its restriction equivalences

Source: steps 1--6 of the agent-formulated twisted variant of Stacks Tag 00W0.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite MonoidalCategory

namespace CategoryTheory.TwistedActionRingedSite

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    (s : C ≌ C) [s.functor.IsContinuous J J] [s.inverse.IsContinuous J J]
    (R : Sheaf J CommRingCat.{u})
    (a : (s.inverse.sheafPushforwardContinuous CommRingCat.{u} J J).obj R ≅ R)

-- The inverse translation is scalar transport along the inverse ring isomorphism,
-- followed by precomposition with s. The two coherence equations are the triangle
-- identities of s and the inverse identities of the coefficient isomorphism.
private theorem sigma_isEquivalence : (sigma J s R a).IsEquivalence := by
  let c : ring R ≅ (s.inverse.sheafPushforwardContinuous RingCat.{u} J J).obj (ring R) :=
    (sheafCompose J (forget₂ CommRingCat RingCat)).mapIso a.symm
  let ψ : ring R ⟶ (s.functor.sheafPushforwardContinuous RingCat.{u} J J).obj (ring R) :=
    { hom := Functor.whiskerRight s.op.unitIso.hom (ring R).obj ≫
        Functor.whiskerLeft s.functor.op c.inv.hom }
  have H₁ : Functor.whiskerRight (NatTrans.op s.symm.counit) (ring R).obj =
      ψ.hom ≫ s.functor.op.whiskerLeft c.hom.hom := by
    apply NatTrans.ext
    funext U
    change (ring R).obj.map _ =
      ((ring R).obj.map _ ≫ c.inv.hom.app _) ≫ c.hom.hom.app _
    rw [Category.assoc]
    have hc := congrArg (fun f ↦ f.hom.app (s.functor.op.obj U)) c.inv_hom_id
    have hc' : c.inv.hom.app (s.functor.op.obj U) ≫
        c.hom.hom.app (s.functor.op.obj U) = 𝟙 _ := hc
    change (ring R).obj.map (s.unitInv.app U.unop).op =
      (ring R).obj.map (s.unitInv.app U.unop).op ≫
        (c.inv.hom.app (s.functor.op.obj U) ≫ c.hom.hom.app (s.functor.op.obj U))
    exact (Category.comp_id _).symm.trans
      (congrArg (fun f ↦ (ring R).obj.map (s.unitInv.app U.unop).op ≫ f) hc'.symm)
  have H₂ : c.hom.hom ≫ s.inverse.op.whiskerLeft ψ.hom ≫
      Functor.whiskerRight (NatTrans.op s.symm.unit) (ring R).obj = 𝟙 (ring R).obj := by
    apply NatTrans.ext
    funext U
    change c.hom.hom.app U ≫
      ((ring R).obj.map (s.unitInv.app (s.inverse.obj U.unop)).op ≫
        c.inv.hom.app (s.functor.op.obj (s.inverse.op.obj U))) ≫
        (ring R).obj.map (s.counitInv.app U.unop).op = 𝟙 _
    rw [Category.assoc]
    have hn := c.inv.hom.naturality (s.counitInv.app U.unop).op
    change (ring R).obj.map (s.inverse.map (s.counitInv.app U.unop)).op ≫
      c.inv.hom.app U =
      c.inv.hom.app (s.functor.op.obj (s.inverse.op.obj U)) ≫
        (ring R).obj.map (s.counitInv.app U.unop).op at hn
    rw [← hn]
    have hm : (ring R).obj.map (s.unitInv.app (s.inverse.obj U.unop)).op ≫
        (ring R).obj.map (s.inverse.map (s.counitInv.app U.unop)).op = 𝟙 _ := by
      rw [← Functor.map_comp, ← op_comp]
      simp
    rw [← Category.assoc ((ring R).obj.map _) ((ring R).obj.map _) _, hm]
    change c.hom.hom.app U ≫ 𝟙 _ ≫ c.inv.hom.app U = 𝟙 _
    have hc : c.hom.hom.app U ≫ c.inv.hom.app U = 𝟙 _ :=
      congrArg (fun f ↦ f.hom.app U) c.hom_inv_id
    exact (congrArg (fun f ↦ c.hom.hom.app U ≫ f)
      (Category.id_comp (c.inv.hom.app U))).trans hc
  let : s.symm.functor.IsContinuous J J := inferInstanceAs (s.inverse.IsContinuous J J)
  let : s.symm.inverse.IsContinuous J J := inferInstanceAs (s.functor.IsContinuous J J)
  exact inferInstanceAs
    (SheafOfModules.pushforwardPushforwardEquivalence s.symm c.hom ψ H₁ H₂).functor.IsEquivalence

/-- Construction of the integer-labelled ringed site and its restriction equivalences.
Source: steps 1--6 of the twisted action-site argument, Stacks 00W0 motivation
(blueprint: lem-sf-twisted-action-site-restriction).

Proof: construct arrows as the disjoint union of maps into the coherent integer powers
of the chosen site equivalence. The unit and associativity coherence give the category
laws. Give the category the infimum topology generated by images of covering sieves.
Every arrow factors as a zero-degree arrow followed by a power isomorphism. Pulling a
generating cover back along a degree-n arrow therefore amounts to translating that cover
by the n-th power and taking its pullback in C. This shows that a presheaf is a sheaf
exactly when its restriction to C is one. Extend the given ring isomorphism along integer
powers, using inverse maps for negative powers, to obtain the coefficient sheaf.
For sets and modules, restriction recovers the action from the inverse of the
minus-one generator; conversely the iterated action defines all restriction maps.
These two constructions are inverse, including their maps and additive structures.
Translation of modules is an equivalence by precomposition with the inverse site
functor and transport of scalars along the ring isomorphism. For sets the forgetful functor
preserves finite limits, and its right
adjoint is the product of integer translates, with the shift action; a map into it is
uniquely determined by its zeroth component. This adjunction and preservation of finite
limits give the geometric morphism in the asserted direction. Its structural ring map
is coefficient restriction. The identical product construction on modules is its direct
image, and the adjunction is linear because all its component formulas are semilinear.
This proves the module-pullback adjunction. No tensor, internal Hom, or induction is used.
The constructions also apply to an empty site, the zero ring and the identity equivalence.
-/
theorem siteRestriction [HasPullbacks C] : Nonempty (RestrictionPresentation J s R a) := by
  obtain ⟨S, hc⟩ := siteCore J s R a
  let := S.category
  let := S.inclusion_continuous
  let := sigma_isEquivalence J s R a
  obtain ⟨eM, cM, hM⟩ := moduleRestriction J s R a S
  obtain ⟨eS, cS, hS⟩ := setRestriction J s R a S
  obtain ⟨g, hg, hIso, hRing, ⟨adj⟩⟩ := geometricRestriction J s R a S hc
  exact ⟨{
    toSite := S
    translation := (sigma J s R a).asEquivalence
    translation_eq := rfl
    modules := eM
    restriction := cM
    module_generator := hM
    modules_add := by
      let U : Modules S.coefficient ⥤ Modules R := SheafOfModules.pushforward
        ((sheafCompose J (forget₂ CommRingCat RingCat)).map S.coefficientRestriction.inv)
      let : U.Additive := ⟨by intro M N f h; ext X x; rfl⟩
      let : (eM.functor ⋙ forgetPairs (sigma J s R a)).Additive :=
        Functor.additive_of_iso cM.symm
      intro M N f h
      exact Functor.map_add (eM.functor ⋙ forgetPairs (sigma J s R a))
    sets := eS
    setsRestriction := cS
    set_generator := hS
    geometric := g
    geometric_inverse := hg
    structural := hIso
    structural_eq := hRing
    modulePullback := adj.ofNatIsoLeft cM.symm }⟩

end CategoryTheory.TwistedActionRingedSite
