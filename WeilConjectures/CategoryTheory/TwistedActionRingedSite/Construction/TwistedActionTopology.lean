module

public import WeilConjectures.CategoryTheory.TwistedActionRingedSite.Construction.TwistedActionCategory
public import Mathlib.CategoryTheory.Sites.Equivalence
public import Mathlib.CategoryTheory.Sites.CoverLifting

/-! # The topology generated by degree-zero covering sieves

Source: step 2 of the agent-formulated twisted-site construction, motivated by
Stacks Sites, Tag 00W0 (proposition-sheaves-on-group). The existing integer action
site supplies the topology and its sheaf criterion; only the object copy changes.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite

namespace CategoryTheory.TwistedActionRingedSite.Construction

variable {C : Type u} [SmallCategory C] (s : C ≌ C)

/-- Changing from the prescribed object copy to the existing integer action category.
Source: Mathlib's induced category and the identical underlying objects
(blueprint: lem-sf-twisted-action-topology). -/
noncomputable def copyEquivalence :
    letI := shift s
    letI := category s
    Object C ≌ IntegerActionSite C := by
  letI := shift s
  letI := category s
  exact {
    functor := inducedFunctor (fun X : Object C ↦ IntegerActionSite.mk X.base)
    inverse := {
      obj X := ⟨X.obj⟩
      map f := InducedCategory.homMk f
      map_id X := rfl
      map_comp f g := rfl }
    unitIso := NatIso.ofComponents (fun X ↦ Iso.refl X)
    counitIso := NatIso.ofComponents (fun X ↦ Iso.refl X)
    functor_unitIso_comp X := by
      change (inducedFunctor (fun X : Object C ↦ IntegerActionSite.mk X.base)).map
        (𝟙 X) ≫ 𝟙 _ = 𝟙 _
      rw [Category.comp_id]
      exact Functor.map_id _ X }

/-- The transported topology, an explicit construction from the original topology.
Source: the existing integer action topology and equivalence of object copies
(blueprint: lem-sf-twisted-action-topology). -/
@[reducible] noncomputable def topology (J : GrothendieckTopology C) :
    letI := category s
    GrothendieckTopology (Object C) :=
  letI := shift s
  letI := category s
  (copyEquivalence s).functor.inducedTopology (integerActionTopology J.toPrecoverage)

variable (J : GrothendieckTopology C)
    [s.functor.IsContinuous J J] [s.inverse.IsContinuous J J]

/-- Every nonnegative iterate of a continuous autoequivalence is continuous.
Source: composition of continuous functors
(blueprint: lem-sf-twisted-action-topology). -/
theorem powNat_continuous (e : C ≌ C) [e.functor.IsContinuous J J] (n : ℕ) :
    (e.powNat n).functor.IsContinuous J J := by
  cases n with
  | zero =>
      change (𝟭 C).IsContinuous J J
      infer_instance
  | succ n =>
    induction n with
    | zero =>
        change e.functor.IsContinuous J J
        infer_instance
    | succ n ih =>
      let := ih
      exact Functor.isContinuous_comp e.functor (e.powNat (n + 1)).functor J J J

/-- Every integer power is continuous in the original topology.
Source: positive iteration of s and of its continuous inverse
(blueprint: lem-sf-twisted-action-topology). -/
theorem power_continuous (n : ℤ) : (s ^ n).functor.IsContinuous J J := by
  cases n with
  | ofNat n => exact powNat_continuous J s n
  | negSucc n =>
    let : s.symm.functor.IsContinuous J J :=
      show s.inverse.IsContinuous J J from inferInstance
    exact powNat_continuous J s.symm (n + 1)

/-- The covering precoverage associated to J generates J itself.
Source: generation by all covering sieves
(blueprint: lem-sf-twisted-action-topology). -/
theorem base_toGrothendieck : J.toPrecoverage.toGrothendieck = J := by
  apply le_antisymm J.toGrothendieck_toPrecoverage_le
  intro X S hS
  have h := Precoverage.generate_mem_toGrothendieck
    ((J.arrows_mem_toPrecoverage_iff S).mpr hS)
  simpa only [Sieve.generate_sieve] using h

/-- Integer translation preserves and reflects the original covering presieves.
Source: continuity in both directions and the full faithfulness of each power
(blueprint: lem-sf-twisted-action-topology). -/
theorem power_covers :
    letI := shift s
    ∀ (n : ℤ) (X : C) (R : Presieve X),
      R ∈ J.toPrecoverage X ↔
        R.map (shiftFunctor C n) ∈ J.toPrecoverage ((shiftFunctor C n).obj X) := by
  let := shift s
  intro n X R
  let : (shiftFunctor C n).IsContinuous J J := power_continuous s J n
  let : (shiftFunctor C (-n)).IsContinuous J J := power_continuous s J (-n)
  rw [GrothendieckTopology.mem_toPrecoverage_iff,
    GrothendieckTopology.mem_toPrecoverage_iff, Sieve.generate_map_eq_functorPushforward]
  constructor
  · exact (CoverPreserving.of_isContinuous (shiftFunctor C n) J J).cover_preserve
  · intro h
    have h' := (CoverPreserving.of_isContinuous (shiftFunctor C (-n)) J J).cover_preserve h
    change ((Sieve.generate R).functorPushforward (shiftEquiv C n).functor).functorPushforward
      (shiftEquiv C n).inverse ∈ J _ at h'
    rwa [Sieve.functorPushforward_equivalence_eq_pullback (shiftEquiv C n),
      J.pullback_mem_iff_of_isIso] at h'

omit [s.functor.IsContinuous J J] [s.inverse.IsContinuous J J] in
set_option backward.defeqAttrib.useBackward true in
/-- The transported topology is precisely the infimum of the required generators.
Source: the universal property of the generated integer action topology
(blueprint: lem-sf-twisted-action-topology). -/
theorem topology_eq :
    letI := category s
    topology s J =
      sInf {K : GrothendieckTopology (Object C) |
        ∀ (X : C) (S : Sieve X), S ∈ J X →
          S.functorPushforward (inclusion s) ∈ K ((inclusion s).obj X)} := by
  let := shift s
  let := category s
  let E := copyEquivalence s
  let K := integerActionTopology J.toPrecoverage
  apply le_antisymm
  · apply le_sInf
    intro L hL
    have hKL : K ≤ E.inverse.inducedTopology L := by
      apply sInf_le
      intro X R hR
      rw [Functor.mem_inducedTopology_iff_of_isCoverDense,
        Sieve.generate_map_eq_functorPushforward, ← Sieve.functorPushforward_comp]
      change (Sieve.generate R).functorPushforward (inclusion s) ∈ L _
      exact hL X (Sieve.generate R) hR
    intro X S hS
    rw [Functor.mem_inducedTopology_iff_of_isCoverDense] at hS
    have hh := hKL _ hS
    rw [Functor.mem_inducedTopology_iff_of_isCoverDense,
      Sieve.functorPushforward_equivalence_eq_pullback E] at hh
    simpa [E, copyEquivalence] using hh
  · apply sInf_le
    intro X S hS
    rw [Functor.mem_inducedTopology_iff_of_isCoverDense, ← Sieve.functorPushforward_comp]
    change S.functorPushforward (integerActionInclusion (C := C)) ∈ K _
    rw [← Sieve.generate_sieve S, ← Sieve.generate_map_eq_functorPushforward]
    apply (GrothendieckTopology.mem_sInf _ _).mpr
    intro L hL
    exact hL X S.arrows ((J.arrows_mem_toPrecoverage_iff S).mpr hS)

set_option backward.defeqAttrib.useBackward true in
/-- The generated topology has exactly the original sheaf condition on restriction,
and the degree-zero inclusion lifts covers.
Source: the existing integer action sheaf criterion and equivalence of object copies
(blueprint: lem-sf-twisted-action-topology). -/
theorem topology_criterion :
    letI := category s
    (inclusion s).IsCocontinuous J (topology s J) ∧
      ∀ P : (Object C)ᵒᵖ ⥤ Type u,
        Presieve.IsSheaf (topology s J) P ↔
          Presieve.IsSheaf J ((inclusion s).op ⋙ P) := by
  let := shift s
  let := category s
  let E := copyEquivalence s
  let K := integerActionTopology J.toPrecoverage
  have hcrit := integerActionTopologyCriterion J.toPrecoverage (power_covers s J)
  let : E.functor.IsDenseSubsite (topology s J) K := by
    change E.functor.IsDenseSubsite (E.functor.inducedTopology K) K
    infer_instance
  let : E.inverse.IsContinuous K (topology s J) := by
    change E.symm.functor.IsContinuous K (E.symm.inverse.inducedTopology K)
    infer_instance
  refine ⟨⟨?_⟩, ?_⟩
  · intro X S hS
    rw [Functor.mem_inducedTopology_iff_of_isCoverDense] at hS
    have h := (hcrit.1 X _).mp hS
    rw [base_toGrothendieck] at h
    change ((S.functorPushforward E.functor).functorPullback
      (inclusion s ⋙ E.functor)) ∈ J X at h
    rwa [Sieve.functorPullback_comp, Sieve.functorPullback_functorPushforward_eq] at h
  · intro P
    have hE : Presieve.IsSheaf (topology s J) P ↔
        Presieve.IsSheaf K (E.inverse.op ⋙ P) := by
      constructor
      · exact E.inverse.op_comp_isSheaf_of_isSheaf_type K
      · intro h
        exact E.functor.op_comp_isSheaf_of_isSheaf_type (topology s J) h
    rw [hE, hcrit.2.2, base_toGrothendieck]
    rfl

/-- Restriction along the degree-zero inclusion is continuous.
Source: the forward direction of the sheaf criterion
(blueprint: lem-sf-twisted-action-topology). -/
theorem inclusion_continuous :
    letI := category s
    (inclusion s).IsContinuous J (topology s J) := by
  let := category s
  constructor
  intro P
  exact ((topology_criterion s J).2 P.obj).mp
    ((isSheaf_iff_isSheaf_of_type _ _).mp P.property)

/-- The same criterion holds for presheaves of commutative rings.
Source: the Hom-valued definition of sheaves
(blueprint: lem-sf-twisted-action-topology). -/
theorem ring_isSheaf
    (P : letI := category s; (Object C)ᵒᵖ ⥤ CommRingCat.{u})
    (h : letI := category s; Presheaf.IsSheaf J ((inclusion s).op ⋙ P)) :
    letI := category s
    Presheaf.IsSheaf (topology s J) P := by
  let := category s
  intro E
  exact ((topology_criterion s J).2 (P ⋙ coyoneda.obj (op E))).mpr (h E)

end CategoryTheory.TwistedActionRingedSite.Construction
