module

public import WeilConjectures.AlgebraicGeometry.RegularImmersionChart

/-!
# Étale linearization of a regular immersion

Let `i : Z ⟶ X` be a regular immersion of pure codimension `c`, with `X` smooth over a perfect
field `k` and `Z` regular. Then `Z` is smooth over `k`, and étale locally the pair `(X, Z)` is
the linear pair `(𝔸^{c+m}_k, 𝔸^m_k)`.

## Main results

- `AlgebraicGeometry.IsRegularImmersion.smooth_comp_and_exists_etale_affineSpace`
  (`lem-pur-regular-immersion-linearization`).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

variable {k : Type u} [Field k]

/-- Blueprint `lem-pur-regular-immersion-linearization`: étale linearization of a regular
immersion.

Let `i : Z ⟶ X` be a regular (closed) immersion of pure codimension `c`, with `X` smooth over
the perfect field `k` and `Z` regular. Then

1. `Z` is smooth over `k` (`AlgebraicGeometry.IsRegularImmersion.smooth_comp`);
2. the pair `(X, Z)` is étale locally the linear pair: every point `z` of `Z` has an affine open
   neighbourhood `U` of `i z` in `X` with functions `f₁, …, f_c` on `U` generating the ideal of
   `Z ∩ U`, and an étale morphism `v : U ⟶ 𝔸^c_{𝔸^m_k} = 𝔸^{c+m}_k` whose first `c`
   coordinates `x₁, …, x_c` pull back to the `fᵢ`
   (`AlgebraicGeometry.IsRegularImmersion.exists_etale_affineSpace`). Hence `Z ∩ U` is the
   inverse image under `v` of the linear subspace `𝔸^m_k = {x₁ = ⋯ = x_c = 0}`, with ideal
   generated by `x₁, …, x_c`. -/
theorem IsRegularImmersion.smooth_comp_and_exists_etale_affineSpace [PerfectField k]
    {X Z : Scheme.{u}} (c : ℕ) (i : Z ⟶ X) [IsRegularImmersion c i] (aX : X ⟶ Spec (.of k))
    [Smooth aX] (hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) :
    Smooth (i ≫ aX) ∧ ∀ z : Z,
      ∃ (U : X.affineOpens) (_ : i.base z ∈ U.1) (f : Fin c → Γ(X, U.1)) (m : ℕ)
        (v : U.1.toScheme ⟶ 𝔸(ULift.{u} (Fin c); 𝔸(ULift.{u} (Fin m); Spec (.of k)))),
        Ideal.span (Set.range f) = (Scheme.Hom.ker i).ideal U ∧ Etale v ∧
          ∀ a, v.appTop (AffineSpace.coord _ (ULift.up a)) = U.1.topIso.inv (f a) :=
  ⟨IsRegularImmersion.smooth_comp c i aX hZ,
    IsRegularImmersion.exists_etale_affineSpace c i aX hZ⟩

end AlgebraicGeometry
