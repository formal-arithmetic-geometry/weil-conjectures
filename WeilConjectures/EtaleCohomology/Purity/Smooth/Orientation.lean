module

public import WeilConjectures.EtaleCohomology.Purity.Smooth.AffineLine
public import WeilConjectures.EtaleCohomology.Purity.Smooth.KummerBaseChange
public import WeilConjectures.SixFunctors.Etale.Derived.GeometricPoint

/-!
# The orientation of the zero section of the affine line

Let `t` be the coordinate of the affine line `𝔸¹_Y` and `s : V(t) ⟶ 𝔸¹_Y` the zero section,
realised as the closed subscheme cut out by `t`
(`AlgebraicGeometry.AffineSpace.zeroSectionIsoZeroLocusSubscheme` identifies it with `Y`).
The Kummer boundary `∂κ(t) ∈ H²_{s(Y)}(𝔸¹_Y, Λ(1))` of the coordinate is a class with supports,
and its adjoint is the *orientation* (fundamental class) of the zero section

`pur_s : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]`.

For a normalized rank-one datum it is an isomorphism, so `Rs^! Λ(1)[2]` is concentrated in
degree zero with cohomology sheaf `Λ`, generated by `∂κ(t)` (`sk-prop-a1`). A morphism
`Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` is a section of this sheaf, so it is determined by its pullbacks to the
geometric points. The orientation is compatible with base change along every `v : Y' ⟶ Y`
(`prop-pur-affine-line-orientation-base-change`), and it is the unique morphism whose
restrictions to the geometric points of `Y` are the orientations there
(`prop-pur-affine-line-orientation-uniqueness`).

## Main definitions

- `AlgebraicGeometry.Etale.affineLineOrientation`: the orientation `pur_s`.
- `AlgebraicGeometry.Etale.restrictAffineLineZeroLocusHom`: the restriction of morphisms
  `Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` along `𝔸¹_v`.

## Main statements

- `AlgebraicGeometry.Etale.isIso_affineLineOrientation`
- `AlgebraicGeometry.Etale.isZero_homology_rightDerivedUpperShriek_affineLineZeroLocus`
- `AlgebraicGeometry.Etale.eq_zero_of_leftDerivedUpperStar_map_eq_zero_affineLineZeroLocus`
- `AlgebraicGeometry.Etale.restrictAffineLineZeroLocusHom_affineLineOrientation`
- `AlgebraicGeometry.Etale.affineLineOrientation_hom_ext_of_restrictAffineLineZeroLocusHom`
- `AlgebraicGeometry.Etale.eq_affineLineOrientation_iff`
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

variable (Λ : Type (u + 1)) [CommRing Λ] [Finite Λ] [HasKummerClass Λ] (Y : Scheme.{u})

/-- Blueprint `sk-prop-a1`: Rank-one orientation: the fundamental class of the zero section

The *orientation* (fundamental class) of the zero section `s : V(t) ⟶ 𝔸¹_Y`, realised as the
closed subscheme cut out by the coordinate `t`:

`pur_s : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]`,

the adjoint (`AlgebraicGeometry.Etale.supportedClassMap`) of the Kummer boundary
`∂κ(t) ∈ H²_{s(Y)}(𝔸¹_Y, Λ(1))` (`AlgebraicGeometry.Etale.kummerBoundary`). Under the bijection
`AlgebraicGeometry.Etale.supportedClassMap_bijective` between `Hom(Λ_{V(t)}, Rs^! Λ(1)[2])` and
`H²_{s(Y)}(𝔸¹_Y, Λ(1))` it is the global section `∂κ(t)`. -/
noncomputable def affineLineOrientation :
    constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧) :=
  supportedClassMap Λ _ (shiftSupportedClass (ModuleCat.{u + 1} Λ) _ 2
    (kummerBoundary Λ (AffineSpace.coord Y (ULift.up 0))))

/-- Blueprint `sk-prop-a1`: Rank-one orientation: the fundamental class of the zero section

For a normalized rank-one datum the orientation `pur_s : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` of the zero
section is an isomorphism: the map `Λ ⟶ H⁰(Rs^! Λ(1)[2])`, `1 ↦ ∂κ(t)`, is an isomorphism of
sheaves and `Rs^! Λ(1)[2]` is concentrated in degree zero. This is the rank-one normalisation
`AlgebraicGeometry.Etale.HasKummerClass.IsNormalized`; the blueprint derives it from the long
exact sequence of `Rp_*` applied to the localization triangle of the closed–open pair
`(s, j)`. -/
theorem isIso_affineLineOrientation [HasKummerClass.IsNormalized Λ]
    [HasInvertibleExponent Λ Y] :
    IsIso (affineLineOrientation Λ Y) :=
  HasKummerClass.IsNormalized.isIso_supportedClassMap_kummerBoundary_coord Y

/-- Blueprint `sk-prop-a1`: Rank-one orientation: the fundamental class of the zero section

The orientation `pur_s` induces an isomorphism `Λ ≅ H⁰(Rs^! Λ(1)[2])` of cohomology sheaves,
`1 ↦ ∂κ(t)`. -/
theorem isIso_homology_zero_map_affineLineOrientation [HasKummerClass.IsNormalized Λ]
    [HasInvertibleExponent Λ Y] :
    IsIso ((_root_.DerivedCategory.homologyFunctor _ 0).map (affineLineOrientation Λ Y)) := by
  have := isIso_affineLineOrientation Λ Y
  infer_instance

/-- Blueprint `sk-prop-a1`: Rank-one orientation: the fundamental class of the zero section

`Rs^! Λ(1)[2]` is concentrated in degree zero: its cohomology sheaves vanish in every degree
`n ≠ 0`, since it is isomorphic to `Λ_{V(t)}` through the orientation. -/
theorem isZero_homology_rightDerivedUpperShriek_affineLineZeroLocus
    [HasKummerClass.IsNormalized Λ] [HasInvertibleExponent Λ Y] (n : ℤ) (hn : n ≠ 0) :
    IsZero ((_root_.DerivedCategory.homologyFunctor _ n).obj
      ((R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧))) := by
  have := isIso_affineLineOrientation Λ Y
  refine IsZero.of_iso ?_ ((_root_.DerivedCategory.homologyFunctor _ n).mapIso
    ((asIso (affineLineOrientation Λ Y)).symm ≪≫
      constantComplexIsoSingleFunctor Λ _))
  exact (HomologicalComplex.isZero_single_obj_homology _ _ _ _ hn).of_iso
    ((_root_.DerivedCategory.homologyFunctor _ n).mapIso
      ((_root_.DerivedCategory.singleFunctorIsoCompQ _ 0).app _) ≪≫
      (_root_.DerivedCategory.homologyFunctorFactors _ n).app _)

set_option maxHeartbeats 3000000 in
-- the instance arguments of the derived pullbacks along geometric points of the zero locus are
-- expensive to unify
/-- Blueprint `prop-pur-affine-line-orientation-uniqueness`: Uniqueness of the global
orientation

*Injectivity of the restriction to geometric points.* For a normalized rank-one datum, a
morphism `φ : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` whose pullback along every geometric point
`x : Spec Ω ⟶ V(t)` vanishes is zero: through the orientation, `Rs^! Λ(1)[2]` is the constant
sheaf `Λ` placed in degree zero (`AlgebraicGeometry.Etale.isIso_affineLineOrientation`), so `φ`
is a section of a sheaf, which is determined by its stalks
(`AlgebraicGeometry.Etale.constantComplex_hom_ext_of_leftDerivedUpperStar_map_eq`).
Consequently two such morphisms with the same pullbacks to all geometric points are equal. -/
theorem eq_zero_of_leftDerivedUpperStar_map_eq_zero_affineLineZeroLocus
    [HasKummerClass.IsNormalized Λ] [HasInvertibleExponent Λ Y]
    (φ : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧))
    (h : ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω]
      (x : Spec (.of Ω) ⟶ 𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}),
      (L((x)^*[ModuleCat.{u + 1} Λ])).map φ = 0) :
    φ = 0 := by
  have := isIso_affineLineOrientation Λ Y
  exact constantComplex_hom_ext_of_leftDerivedUpperStar_map_eq
    (asIso (affineLineOrientation Λ Y)).symm fun Ω _ _ x ↦ by
      rw [h Ω x, Functor.map_zero]

set_option maxHeartbeats 3000000 in
-- the instance arguments of the derived pullbacks along geometric points of the zero locus are
-- expensive to unify
/-- Blueprint `prop-pur-affine-line-orientation-uniqueness`: Uniqueness of the global
orientation

Two morphisms `φ ψ : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` whose pullbacks along every geometric point
`x : Spec Ω ⟶ V(t)` agree are equal. For the form with the restrictions along `𝔸¹_v` used by the
blueprint, see
`AlgebraicGeometry.Etale.affineLineOrientation_hom_ext_of_restrictAffineLineZeroLocusHom`. -/
theorem affineLineOrientation_hom_ext [HasKummerClass.IsNormalized Λ]
    [HasInvertibleExponent Λ Y]
    {φ ψ : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧)}
    (h : ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω]
      (x : Spec (.of Ω) ⟶ 𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}),
      (L((x)^*[ModuleCat.{u + 1} Λ])).map φ = (L((x)^*[ModuleCat.{u + 1} Λ])).map ψ) :
    φ = ψ := by
  rw [← sub_eq_zero]
  exact eq_zero_of_leftDerivedUpperStar_map_eq_zero_affineLineZeroLocus Λ Y _ fun Ω _ _ x ↦ by
    rw [Functor.map_sub, h Ω x, sub_self]

variable {Y} {Y' : Scheme.{u}}

/-- The closed subschemes `V(t) ⊂ 𝔸¹` of the zero sections over `Y'` and `Y` form a pullback
square along `𝔸¹_v : 𝔸¹_{Y'} ⟶ 𝔸¹_Y` for every `v : Y' ⟶ Y`; the map `V(t') ⟶ V(t)` is `v`
through the identifications `Y ≅ V(t)`
(`AlgebraicGeometry.AffineSpace.zeroSectionIsoZeroLocusSubscheme`). -/
lemma isPullback_zeroLocusSubschemeι_coord (v : Y' ⟶ Y) :
    IsPullback
      ((AffineSpace.zeroSectionIsoZeroLocusSubscheme (ULift.{u} (Fin 1)) Y'
          (s := {AffineSpace.coord Y' (ULift.up 0)}) Set.range_unique).inv ≫ v ≫
        (AffineSpace.zeroSectionIsoZeroLocusSubscheme (ULift.{u} (Fin 1)) Y
          (s := {AffineSpace.coord Y (ULift.up 0)}) Set.range_unique).hom)
      (𝔸(ULift.{u} (Fin 1); Y').zeroLocusSubschemeι {AffineSpace.coord Y' (ULift.up 0)})
      (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι {AffineSpace.coord Y (ULift.up 0)})
      (AffineSpace.map (ULift.{u} (Fin 1)) v) := by
  have he := (Iso.inv_comp_eq _).2
    (AffineSpace.zeroSectionIsoZeroLocusSubscheme_hom_zeroLocusSubschemeι (ULift.{u} (Fin 1)) Y
      (s := {AffineSpace.coord Y (ULift.up 0)}) Set.range_unique).symm
  have he' := (Iso.inv_comp_eq _).2
    (AffineSpace.zeroSectionIsoZeroLocusSubscheme_hom_zeroLocusSubschemeι (ULift.{u} (Fin 1)) Y'
      (s := {AffineSpace.coord Y' (ULift.up 0)}) Set.range_unique).symm
  have hpaste : IsPullback v
      (AffineSpace.zeroSection (ULift.{u} (Fin 1)) Y' ≫ 𝔸(ULift.{u} (Fin 1); Y') ↘ Y')
      (AffineSpace.zeroSection (ULift.{u} (Fin 1)) Y ≫ 𝔸(ULift.{u} (Fin 1); Y) ↘ Y) v := by
    rw [AffineSpace.zeroSection_comp_over, AffineSpace.zeroSection_comp_over]
    exact IsPullback.of_vert_isIso ⟨by simp⟩
  have hs := IsPullback.of_bot hpaste (AffineSpace.zeroSection_comp_map v).symm
    (AffineSpace.isPullback_map v)
  rw [← he, ← he']
  exact (IsPullback.of_vert_isIso ⟨by simp⟩).paste_vert hs

/-- Blueprint `prop-pur-affine-line-orientation-base-change`: Base change of the global
orientation

For every morphism `v : Y' ⟶ Y` the exceptional base change comparison carries the pullback of
the orientation `pur_s` of the zero section of `𝔸¹_Y` to the orientation `pur_{s'}` of the
zero section of `𝔸¹_{Y'}`. Here `pur_s` is read as its global section
`∂κ(t) ∈ H²_{s(Y)}(𝔸¹_Y, Λ(1))` (`AlgebraicGeometry.Etale.supportedClassMap_bijective`), the
comparison of exceptional inverse images is the restriction of supports
`L𝔸¹_v^* Rs_! Rs^! ⟶ Rs'_! Rs'^! L𝔸¹_v^*` (`AlgebraicGeometry.Etale.restrictSupportedClass`),
and the statement is that the adjoint of the restricted class is `pur_{s'}`.

The blueprint deduces this from the uniqueness of the orientation and the computation of both
sides at the geometric points; here it is proved directly: the Kummer class is compatible with
pullback, and so is the boundary of the supported localization triangle
(`AlgebraicGeometry.Etale.kummerBoundary_baseChange`). -/
theorem supportedClassMap_restrictSupportedClass_affineLineOrientation (v : Y' ⟶ Y) :
    supportedClassMap Λ _
        (restrictSupportedClass (ModuleCat.{u + 1} Λ) (AffineSpace.map (ULift.{u} (Fin 1)) v) _ _
          _ (isPullback_zeroLocusSubschemeι_coord v)
          (leftDerivedUpperStarConstantComplexIso Λ (AffineSpace.map (ULift.{u} (Fin 1)) v)).inv
          (((L((AffineSpace.map (ULift.{u} (Fin 1)) v)^*[ModuleCat.{u + 1} Λ])).commShiftIso
              (2 : ℤ)).app _ ≪≫
            (shiftFunctor _ (2 : ℤ)).mapIso
              (leftDerivedUpperStarTateObjectIso (AffineSpace.map (ULift.{u} (Fin 1)) v) 1))
          (shiftSupportedClass (ModuleCat.{u + 1} Λ) _ 2
            (kummerBoundary Λ (AffineSpace.coord Y (ULift.up 0))))) =
      affineLineOrientation Λ Y' := by
  rw [restrictSupportedClass_shiftSupportedClass,
    kummerBoundary_baseChange_of_eq Λ _ _ _ (AffineSpace.map_appTop_coord v _)]
  rfl

/-- The restriction of a morphism `φ : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` along `𝔸¹_v : 𝔸¹_{Y'} ⟶ 𝔸¹_Y`
for `v : Y' ⟶ Y`: the restriction of supports of `φ`
(`AlgebraicGeometry.Etale.restrictSupportedHom`) for the base change square of the zero
sections (`AlgebraicGeometry.Etale.isPullback_zeroLocusSubschemeι_coord`), read through
`L𝔸¹_v^* (Λ(1)[2]) ≅ Λ(1)[2]`. It is the exceptional base change `Lv^* Rs^! ⟶ Rs'^! L𝔸¹_v^*`
applied to the pullback of `φ`. -/
noncomputable def restrictAffineLineZeroLocusHom (v : Y' ⟶ Y)
    (φ : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧)) :
    constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y').zeroLocusSubscheme
        {AffineSpace.coord Y' (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y').zeroLocusSubschemeι
          {AffineSpace.coord Y' (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y') 1)⟦(2 : ℤ)⟧) :=
  restrictSupportedHom Λ (AffineSpace.map (ULift.{u} (Fin 1)) v) _ _ _
    (isPullback_zeroLocusSubschemeι_coord v)
    (((L((AffineSpace.map (ULift.{u} (Fin 1)) v)^*[ModuleCat.{u + 1} Λ])).commShiftIso
        (2 : ℤ)).app _ ≪≫
      (shiftFunctor _ (2 : ℤ)).mapIso
        (leftDerivedUpperStarTateObjectIso (AffineSpace.map (ULift.{u} (Fin 1)) v) 1)) φ

/-- Blueprint `prop-pur-affine-line-orientation-base-change`: Base change of the global
orientation

For every morphism `v : Y' ⟶ Y` the restriction of the orientation `pur_s` of the zero section
of `𝔸¹_Y` along `𝔸¹_v` (`AlgebraicGeometry.Etale.restrictAffineLineZeroLocusHom`) is the
orientation `pur_{s'}` of the zero section of `𝔸¹_{Y'}`. This is
`AlgebraicGeometry.Etale.supportedClassMap_restrictSupportedClass_affineLineOrientation`, read
on morphisms instead of classes with supports. -/
theorem restrictAffineLineZeroLocusHom_affineLineOrientation (v : Y' ⟶ Y) :
    restrictAffineLineZeroLocusHom Λ v (affineLineOrientation Λ Y) =
      affineLineOrientation Λ Y' := by
  have h : (supportedClassMapEquiv Λ _ _).symm (affineLineOrientation Λ Y) =
      shiftSupportedClass (ModuleCat.{u + 1} Λ) _ 2
        (kummerBoundary Λ (AffineSpace.coord Y (ULift.up 0))) :=
    (Equiv.symm_apply_eq _).2 rfl
  rw [restrictAffineLineZeroLocusHom, restrictSupportedHom, h]
  exact supportedClassMap_restrictSupportedClass_affineLineOrientation Λ v

variable (Y)

omit [Finite Λ] in
/-- Every endomorphism `c` of `Λ_{V(t)}` is the pullback `s^♯ h` of an endomorphism `h` of
`Λ_{𝔸¹_Y}`: through `Y ≅ V(t)`, take for `h` the pullback of `c` along the projection
`𝔸¹_Y ⟶ Y`, a retraction of the zero section. -/
lemma exists_constantComplexEndPullback_zeroLocusSubschemeι_eq
    (c : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)})) :
    ∃ h : constantComplex Λ 𝔸(ULift.{u} (Fin 1); Y) ⟶ constantComplex Λ 𝔸(ULift.{u} (Fin 1); Y),
      constantComplexEndPullback Λ
        (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι {AffineSpace.coord Y (ULift.up 0)}) h = c := by
  let e := AffineSpace.zeroSectionIsoZeroLocusSubscheme (ULift.{u} (Fin 1)) Y
    (s := {AffineSpace.coord Y (ULift.up 0)}) Set.range_unique
  refine ⟨constantComplexEndPullback Λ (𝔸(ULift.{u} (Fin 1); Y) ↘ Y)
    (constantComplexEndPullback Λ e.hom c), constantComplexEnd_ext fun Ω _ _ x ↦ ?_⟩
  rw [constantComplexEndPullback_constantComplexEndPullback _ _ e.inv rfl,
    constantComplexEndPullback_constantComplexEndPullback x e.inv _ rfl,
    constantComplexEndPullback_constantComplexEndPullback _ e.hom x (by simp)]

set_option maxHeartbeats 3000000 in
-- the instance arguments of the derived pullbacks along geometric points of the zero locus are
-- expensive to unify
/-- Blueprint `prop-pur-affine-line-orientation-uniqueness`: Uniqueness of the global
orientation

*Injectivity of the restriction to geometric points.* For a normalized rank-one datum, two
morphisms `φ ψ : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` whose restrictions along `𝔸¹_v` agree for every
geometric point `v : Spec Ω ⟶ Y` (`AlgebraicGeometry.Etale.restrictAffineLineZeroLocusHom`) are
equal.

Through the orientation (`AlgebraicGeometry.Etale.isIso_affineLineOrientation`), `φ` and `ψ` are
`s^♯ h ≫ pur_s` for endomorphisms `h` of `Λ_{𝔸¹_Y}`, and their restrictions are
`s'^♯ (𝔸¹_v^♯ h) ≫ pur_{s'}`. Since `pur_{s'}` is an isomorphism, the hypothesis gives the
equality of the pullbacks of the two endomorphisms of `Λ_{V(t)}` to every geometric point of
`V(t) ≅ Y`, and endomorphisms of a constant sheaf are determined at the geometric points. -/
theorem affineLineOrientation_hom_ext_of_restrictAffineLineZeroLocusHom
    [HasKummerClass.IsNormalized Λ] [HasInvertibleExponent Λ Y]
    {φ ψ : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧)}
    (h : ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (v : Spec (.of Ω) ⟶ Y),
      restrictAffineLineZeroLocusHom Λ v φ = restrictAffineLineZeroLocusHom Λ v ψ) :
    φ = ψ := by
  have := isIso_affineLineOrientation Λ Y
  have key : ∀ φ' : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧),
      ∃ h : constantComplex Λ 𝔸(ULift.{u} (Fin 1); Y) ⟶ constantComplex Λ 𝔸(ULift.{u} (Fin 1); Y),
        φ' = constantComplexEndPullback Λ
          (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι {AffineSpace.coord Y (ULift.up 0)}) h ≫
            affineLineOrientation Λ Y := fun φ' ↦ by
    obtain ⟨h, hh⟩ := exists_constantComplexEndPullback_zeroLocusSubschemeι_eq Λ Y
      (φ' ≫ inv (affineLineOrientation Λ Y))
    exact ⟨h, by rw [hh, Category.assoc, IsIso.inv_hom_id, Category.comp_id]⟩
  obtain ⟨h₁, rfl⟩ := key φ
  obtain ⟨h₂, rfl⟩ := key ψ
  congr 1
  refine constantComplexEnd_ext fun Ω _ _ x ↦ ?_
  let e := AffineSpace.zeroSectionIsoZeroLocusSubscheme (ULift.{u} (Fin 1)) Y
    (s := {AffineSpace.coord Y (ULift.up 0)}) Set.range_unique
  let e' := AffineSpace.zeroSectionIsoZeroLocusSubscheme (ULift.{u} (Fin 1)) (Spec (.of Ω))
    (s := {AffineSpace.coord (Spec (.of Ω)) (ULift.up 0)}) Set.range_unique
  have : HasInvertibleExponent Λ (Spec (.of Ω)) := HasInvertibleExponent.of_hom (x ≫ e.inv)
  have := isIso_affineLineOrientation Λ (Spec (.of Ω))
  have hv := h Ω (x ≫ e.inv)
  rw [restrictAffineLineZeroLocusHom, restrictAffineLineZeroLocusHom,
    restrictSupportedHom_constantComplexEndPullback_comp,
    restrictSupportedHom_constantComplexEndPullback_comp, ← restrictAffineLineZeroLocusHom,
    restrictAffineLineZeroLocusHom_affineLineOrientation, cancel_mono] at hv
  have hx : e'.hom ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of Ω)).zeroLocusSubschemeι
        {AffineSpace.coord (Spec (.of Ω)) (ULift.up 0)} ≫
          AffineSpace.map (ULift.{u} (Fin 1)) (x ≫ e.inv) =
      x ≫ 𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι {AffineSpace.coord Y (ULift.up 0)} := by
    rw [← (isPullback_zeroLocusSubschemeι_coord (x ≫ e.inv)).w]
    simp [e, e']
  rw [constantComplexEndPullback_constantComplexEndPullback x _ _ hx,
    constantComplexEndPullback_constantComplexEndPullback x _ _ hx,
    ← constantComplexEndPullback_constantComplexEndPullback e'.hom _ _ rfl,
    ← constantComplexEndPullback_constantComplexEndPullback e'.hom _ _ rfl,
    ← constantComplexEndPullback_constantComplexEndPullback _ _ _ rfl,
    ← constantComplexEndPullback_constantComplexEndPullback _ _ _ rfl, hv]

/-- Blueprint `prop-pur-affine-line-orientation-uniqueness`: Uniqueness of the global
orientation

For a normalized rank-one datum, the orientation `pur_s` is the unique morphism
`φ : Λ_{V(t)} ⟶ Rs^! Λ(1)[2]` whose restriction along `𝔸¹_v` is the orientation
`pur_{Spec Ω}` for every geometric point `v : Spec Ω ⟶ Y`. The orientation has this property by
its base change (`AlgebraicGeometry.Etale.restrictAffineLineZeroLocusHom_affineLineOrientation`),
and it is the only one by the injectivity of the restriction to the geometric points
(`AlgebraicGeometry.Etale.affineLineOrientation_hom_ext_of_restrictAffineLineZeroLocusHom`). -/
theorem eq_affineLineOrientation_iff [HasKummerClass.IsNormalized Λ] [HasInvertibleExponent Λ Y]
    (φ : constantComplex Λ (𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubscheme
        {AffineSpace.coord Y (ULift.up 0)}) ⟶
      (R(𝔸(ULift.{u} (Fin 1); Y).zeroLocusSubschemeι
          {AffineSpace.coord Y (ULift.up 0)})^![ModuleCat.{u + 1} Λ]).obj
        ((tateObject Λ 𝔸(ULift.{u} (Fin 1); Y) 1)⟦(2 : ℤ)⟧)) :
    φ = affineLineOrientation Λ Y ↔
      ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (v : Spec (.of Ω) ⟶ Y),
        restrictAffineLineZeroLocusHom Λ v φ = affineLineOrientation Λ (Spec (.of Ω)) := by
  refine ⟨?_, fun h ↦ affineLineOrientation_hom_ext_of_restrictAffineLineZeroLocusHom Λ Y
    fun Ω _ _ v ↦ ?_⟩
  · rintro rfl Ω _ _ v
    exact restrictAffineLineZeroLocusHom_affineLineOrientation Λ v
  · rw [h Ω v, restrictAffineLineZeroLocusHom_affineLineOrientation]

