module

public import WeilConjectures.EtaleCohomology.Purity.RealSheaves.Construction
public import WeilConjectures.EtaleCohomology.Purity.RealSheaves.Rankin
public import WeilConjectures.Mathlib.NumberTheory.Padics.Complex
public import WeilConjectures.Mathlib.RingTheory.PowerSeries.PiTopology
public import Mathlib.RingTheory.RootsOfUnity.Complex
public import Mathlib.Topology.Algebra.ClopenNhdofOne

/-!
# Chebotarev density for the Weil group of a curve over a finite field

Let `W` be the Weil group of a smooth geometrically connected affine curve `C₀` over `𝔽_q`. We
show that a finite quotient `π : W(C₀) → Q`, with open kernel, in which every local Frobenius
element becomes trivial, is trivial
(`AlgebraicGeometry.WeilGroup.map_eq_one_of_map_frobenius_eq_one`). The proof compares Euler
products through the Euler-product form of the Grothendieck–Lefschetz trace formula,
`AlgebraicGeometry.WeilGroup.exists_eulerSeries_mul_eq_coe` (blueprint `cor-rp-euler-product`):

* For the trivial representation, the Euler series is
  `Z(T) = ∏ₓ (1 - T ^ eₓ)⁻¹`, and `Z(T) · (1 - q T) ^ m = P₀(T)` is a polynomial, `m ≤ 1`. Since
  `Z` has nonnegative coefficients and infinitely many nonzero ones, it is not a polynomial
  (`PowerSeries.WithPiTopology.tprod_inv_one_sub_X_pow_ne_coe`), so `m = 1` and `1 - q T` does
  not divide `P₀`.
* If the geometric part `π₁(C)` of `W` maps onto a nontrivial subgroup `H` of `Q`, the part of
  the regular representation of `Q` without `H`-invariants is a representation `V` with no
  geometric coinvariants, on which all Frobenius elements act trivially. Its Euler series is
  `Z ^ dim V = P` for a polynomial `P`, so that `P₀ ^ dim V = P · (1 - q T) ^ dim V`, and
  `1 - q T` divides `P₀`.
* Otherwise `Q` is a cyclic quotient of the degree, of order `f ≥ 2`, and every closed point has
  degree divisible by `f`. Then `Z(T)` is a power series in `T ^ f`, and substituting `ζ T` for a
  primitive `f`-th root of unity `ζ` gives `P₀(T) (1 - ζ q T) = P₀(ζ T) (1 - q T)`, so that
  again `1 - q T` divides `P₀`.

Applied to the finite quotients of `W`, this is the density of the normal subgroup generated by
the Frobenius elements (`AlgebraicGeometry.WeilGroup.dense_frobenius_of_isAffine`). A curve which
is not affine contains a nonempty affine open, and density passes along the restriction of Weil
groups (`AlgebraicGeometry.WeilGroup.Restriction.dense_frobenius`).

## Main statements

- `AlgebraicGeometry.WeilGroup.map_eq_one_of_map_frobenius_eq_one`: a finite quotient of the
  Weil group of an affine curve in which all Frobenius elements are trivial is trivial.
- `AlgebraicGeometry.WeilGroup.dense_frobenius`: **Chebotarev density**, the local Frobenius
  elements generate a dense normal subgroup of the Weil group of a smooth geometrically
  connected curve.
-/

@[expose] public section

universe u

open CategoryTheory
open scoped PowerSeries.WithPiTopology

namespace AlgebraicGeometry.WeilGroup

variable {K : Type u} [Field K] [Finite K] {C : Scheme.{u}} {p : C ⟶ Spec (.of K)} [IsCurve p]
  (W : WeilGroup p) (l : ℕ) [Fact l.Prime] (ι : PadicAlgCl l →+* ℂ)

section EulerSeries

variable (p) in
/-- The local factor `(1 - T ^ eₓ)⁻¹` of the zeta function of the curve at a closed point `x`. -/
noncomputable abbrev zetaFactor (x : C.finitePoints) : PowerSeries ℂ :=
  ((1 : PowerSeries ℂ) - PowerSeries.X ^ p.degreeOver x.1)⁻¹

variable (p) in
/-- The local factors of the zeta function form a multipliable family. -/
lemma multipliable_zetaFactor : Multipliable (zetaFactor p) :=
  PowerSeries.WithPiTopology.multipliable_inv_one_sub_X_pow (fun x ↦ p.degreeOver_ne_zero x.2)
    (p.finite_setOf_degreeOver_le)

omit [IsCurve p] in
lemma inv_pow_eq_pow_inv {f : PowerSeries ℂ} (hf : PowerSeries.constantCoeff f ≠ 0)
    (n : ℕ) :
    (f ^ n)⁻¹ = f⁻¹ ^ n := by
  rw [eq_comm, PowerSeries.eq_inv_iff_mul_eq_one (by simpa using pow_ne_zero n hf), ← mul_pow,
    PowerSeries.inv_mul_cancel _ hf, one_pow]

variable {V : Type u} [AddCommGroup V] [Module (PadicAlgCl l) V]
  [FiniteDimensional (PadicAlgCl l) V] {ρ : Representation (PadicAlgCl l) W.carrier V}

/-- The local factor of the Euler series at a closed point where the Frobenius acts trivially
is a power of the local factor of the zeta function. -/
lemma eulerFactor_eq_of_frobenius_eq_one {x : C.finitePoints} (hx : ρ (W.frobenius x) = 1) :
    W.eulerFactor l ρ ι x = zetaFactor p x ^ Module.finrank (PadicAlgCl l) V := by
  rw [eulerFactor, localPolynomial, hx, LinearMap.charpolyRev_one]
  simp only [Polynomial.map_pow, Polynomial.map_sub, Polynomial.map_one, Polynomial.map_X,
    Polynomial.pow_comp, Polynomial.sub_comp, Polynomial.one_comp, Polynomial.X_comp,
    Polynomial.coe_pow, Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_X]
  exact inv_pow_eq_pow_inv (by simp [p.degreeOver_ne_zero x.2]) _

/-- The Euler series of a representation on which every Frobenius element acts trivially is a
power of the zeta function. -/
lemma eulerSeries_eq_pow (h : ∀ x, ρ (W.frobenius x) = 1) :
    W.eulerSeries l ρ ι = (∏' x, zetaFactor p x) ^ Module.finrank (PadicAlgCl l) V := by
  rw [eulerSeries]
  simp_rw [eulerFactor_eq_of_frobenius_eq_one W l ι (h _)]
  exact (multipliable_zetaFactor p).tprod_pow _

/-- The trivial one-dimensional representation of the Weil group. -/
noncomputable abbrev trivialLine :
    Representation (PadicAlgCl l) W.carrier (PUnit.{u + 1} → PadicAlgCl l) :=
  Representation.trivial _ _ _

lemma isLisse_trivialLine : W.IsLisse l (W.trivialLine l) :=
  IsLisse.of_continuous_apply fun φ v ↦ by
    simpa [Representation.trivial] using continuous_const

lemma eulerSeries_trivialLine :
    W.eulerSeries l (W.trivialLine l) ι = ∏' x, zetaFactor p x := by
  rw [eulerSeries_eq_pow W l ι fun _ ↦ rfl, Module.finrank_fintype_fun_eq_card, Fintype.card_unique,
    pow_one]

lemma compactTopFrobenius_trivialLine :
    W.compactTopFrobenius l (W.trivialLine l) = (Nat.card K : PadicAlgCl l) • 1 := by
  rw [compactTopFrobenius]
  congr 1
  refine LinearMap.ext fun c ↦ Representation.Coinvariants.induction_on c fun v ↦ ?_
  simp [Representation.toCoinvariants_mk]

end EulerSeries

section Polynomial

omit [Finite K] [IsCurve p] in
/-- `1 - q T` is a prime polynomial for `q ≠ 0`. -/
lemma prime_one_sub_C_mul_X {q : ℂ} (hq : q ≠ 0) :
    Prime (1 - Polynomial.C q * Polynomial.X : Polynomial ℂ) := by
  have h : (Polynomial.X - Polynomial.C q⁻¹) * Polynomial.C (-q) =
      (1 - Polynomial.C q * Polynomial.X : Polynomial ℂ) := by
    rw [sub_mul, ← Polynomial.C_mul, mul_neg, inv_mul_cancel₀ hq, Polynomial.C_neg,
      Polynomial.C_neg, Polynomial.C_1]
    ring
  rw [← h]
  exact (associated_mul_unit_right _ _ (Polynomial.isUnit_C.2 (neg_ne_zero.2 hq).isUnit)).prime
    (Polynomial.prime_X_sub_C _)

omit [Finite K] [IsCurve p] in
/-- If `Z (1 - q T) = P₀` with `1 - q T` dividing `P₀`, then `Z` is a polynomial. -/
lemma exists_eq_coe_of_dvd {Z : PowerSeries ℂ} {q : ℂ} {P₀ : Polynomial ℂ}
    (h : Z * ((1 - Polynomial.C q * Polynomial.X : Polynomial ℂ) : PowerSeries ℂ) = P₀)
    (hdvd : (1 - Polynomial.C q * Polynomial.X : Polynomial ℂ) ∣ P₀) :
    ∃ R : Polynomial ℂ, Z = R := by
  obtain ⟨R, rfl⟩ := hdvd
  refine ⟨R, mul_right_cancel₀ ?_ (h.trans ?_)⟩
  · intro h0
    have := congrArg PowerSeries.constantCoeff h0
    simp at this
  · rw [Polynomial.coe_mul, mul_comm]

end Polynomial

section Core

variable [SmoothOfRelativeDimension 1 p] [GeometricallyConnected p]

include W in
/-- The trace formula for the trivial representation: `Z(T) (1 - q T) = P₀(T)` for a polynomial
`P₀` not divisible by `1 - q T`, where `Z(T) = ∏ₓ (1 - T ^ eₓ)⁻¹` is the zeta function. -/
lemma exists_zeta_mul_eq_coe [IsAffine C] [Fact (ringChar K ≠ l)] :
    ∃ P₀ : Polynomial ℂ, (∏' x, zetaFactor p x) *
      ((1 - Polynomial.C (Nat.card K : ℂ) * Polynomial.X : Polynomial ℂ) : PowerSeries ℂ) = P₀ ∧
      ¬ (1 - Polynomial.C (Nat.card K : ℂ) * Polynomial.X : Polynomial ℂ) ∣ P₀ := by
  have : ConnectedSpace C := GeometricallyConnected.connectedSpace_of_subsingleton p
  have : Nonempty C.finitePoints := by
    obtain ⟨x, hx⟩ := p.exists_mem_finitePoints
    exact ⟨⟨x, hx⟩⟩
  have hZ (R : Polynomial ℂ) : ∏' x, zetaFactor p x ≠ R :=
    PowerSeries.WithPiTopology.tprod_inv_one_sub_X_pow_ne_coe (fun x ↦ p.degreeOver_ne_zero x.2)
      (multipliable_zetaFactor p) R
  obtain ⟨ι⟩ := PadicAlgCl.nonempty_ringHom_complex l
  obtain ⟨P₀, hP₀⟩ := exists_eulerSeries_mul_eq_coe ι (W := W) (ρ := W.trivialLine l)
    (W.isLisse_trivialLine l)
  rw [eulerSeries_trivialLine, compactTopFrobenius_trivialLine,
    LinearMap.charpolyRev_smul_one] at hP₀
  have hmap : Polynomial.map ι (1 - Polynomial.C (Nat.card K : PadicAlgCl l) * Polynomial.X) =
      1 - Polynomial.C (Nat.card K : ℂ) * Polynomial.X := by
    rw [Polynomial.map_sub, Polynomial.map_one, Polynomial.map_mul, Polynomial.map_C,
      Polynomial.map_X, map_natCast]
  rw [Polynomial.map_pow, hmap, Polynomial.coe_pow] at hP₀
  set m := Module.finrank (PadicAlgCl l)
    (Representation.Coinvariants ((W.trivialLine l).comp W.geometric.subtype))
  have hm : m ≤ 1 := by
    refine (Submodule.finrank_quotient_le _).trans ?_
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_unique]
  obtain hm0 | hm1 : m = 0 ∨ m = 1 := by omega
  · rw [hm0, pow_zero, mul_one] at hP₀
    exact absurd hP₀ (hZ P₀)
  · rw [hm1, pow_one] at hP₀
    refine ⟨P₀, hP₀, fun hdvd ↦ ?_⟩
    obtain ⟨R, hR⟩ := exists_eq_coe_of_dvd hP₀ hdvd
    exact hZ R hR

include W in
/-- If the degrees of all closed points of an affine curve are divisible by `f ≥ 2`, the trace
formula is contradicted: the zeta function `Z(T)` is then a power series in `T ^ f`, so
substituting `ζ T` for a primitive `f`-th root of unity `ζ` in `Z(T) (1 - q T) = P₀(T)` gives
`P₀(T) (1 - ζ q T) = P₀(ζ T) (1 - q T)`, and `1 - q T` would divide `P₀(T)`. -/
lemma false_of_dvd_degreeOver [IsAffine C] [Fact (ringChar K ≠ l)] {f : ℕ} (hf : 2 ≤ f)
    (hfe : ∀ x : C.finitePoints, f ∣ p.degreeOver x.1) : False := by
  obtain ⟨P₀, hP₀, hndvd⟩ := exists_zeta_mul_eq_coe W l
  have hZf : ∏' x, zetaFactor p x ∈ PowerSeries.dvdSupportSubmonoid f :=
    tprod_mem (PowerSeries.WithPiTopology.isClosed_dvdSupportSubmonoid f) fun x ↦
      PowerSeries.inv_one_sub_X_pow_mem_dvdSupportSubmonoid (p.degreeOver_ne_zero x.2) (hfe x)
  have hζ := Complex.isPrimitiveRoot_exp f (by omega)
  set ζ := Complex.exp (2 * Real.pi * Complex.I / f)
  have h₁ := congrArg (PowerSeries.rescale ζ) hP₀
  rw [map_mul, PowerSeries.rescale_eq_self_of_mem_dvdSupportSubmonoid hZf hζ.pow_eq_one,
    ← Polynomial.coe_comp_C_mul_X, ← Polynomial.coe_comp_C_mul_X] at h₁
  set A : Polynomial ℂ := 1 - Polynomial.C (Nat.card K : ℂ) * Polynomial.X
  have key : P₀ * A.comp (Polynomial.C ζ * Polynomial.X) =
      P₀.comp (Polynomial.C ζ * Polynomial.X) * A := by
    apply Polynomial.coe_inj.1
    rw [Polynomial.coe_mul, Polynomial.coe_mul, ← hP₀, ← h₁]
    ring
  have hq : (Nat.card K : ℂ) ≠ 0 := Nat.cast_ne_zero.2 Nat.card_pos.ne'
  have hdvd : A ∣ P₀ * A.comp (Polynomial.C ζ * Polynomial.X) := by
    rw [key]
    exact dvd_mul_left _ _
  rcases (prime_one_sub_C_mul_X hq).dvd_or_dvd hdvd with h | h
  · exact hndvd h
  · have h₂ := Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero h (x := (Nat.card K : ℂ)⁻¹)
      (by simp [hq])
    simp only [A, Polynomial.eval_comp, Polynomial.eval_sub, Polynomial.eval_one,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X] at h₂
    rw [mul_left_comm, mul_inv_cancel₀ hq, mul_one, sub_eq_zero] at h₂
    exact hζ.ne_one (by omega) h₂.symm

include W in
/-- A lisse representation of positive dimension on which every Frobenius element acts
trivially and which has no geometric coinvariants contradicts the trace formula: its Euler
series is `Z(T) ^ d` for `d = dim V`, a polynomial `P(T)`, so that
`P₀(T) ^ d = P(T) (1 - q T) ^ d` and `1 - q T` would divide `P₀(T)`. -/
lemma false_of_subsingleton_coinvariants [IsAffine C] [Fact (ringChar K ≠ l)] {V : Type u}
    [AddCommGroup V] [Module (PadicAlgCl l) V] [FiniteDimensional (PadicAlgCl l) V]
    {ρ : Representation (PadicAlgCl l) W.carrier V} (hρ : W.IsLisse l ρ)
    (hF : ∀ x, ρ (W.frobenius x) = 1) (hV : 0 < Module.finrank (PadicAlgCl l) V)
    [Subsingleton (Representation.Coinvariants (ρ.comp W.geometric.subtype))] : False := by
  obtain ⟨P₀, hP₀, hndvd⟩ := exists_zeta_mul_eq_coe W l
  obtain ⟨ι⟩ := PadicAlgCl.nonempty_ringHom_complex l
  obtain ⟨P, hP⟩ := exists_eulerSeries_mul_eq_coe (ρ := ρ) ι hρ
  rw [eulerSeries_eq_pow W l ι hF, LinearMap.charpolyRev_of_subsingleton, Polynomial.map_one,
    Polynomial.coe_one, mul_one] at hP
  set A : Polynomial ℂ := 1 - Polynomial.C (Nat.card K : ℂ) * Polynomial.X
  set d := Module.finrank (PadicAlgCl l) V
  have key : P₀ ^ d = P * A ^ d := by
    apply Polynomial.coe_inj.1
    rw [Polynomial.coe_pow, Polynomial.coe_mul, Polynomial.coe_pow, ← hP₀, ← hP, mul_pow]
  have hq : (Nat.card K : ℂ) ≠ 0 := Nat.cast_ne_zero.2 Nat.card_pos.ne'
  have hdvd : A ∣ P₀ ^ d := by
    rw [key]
    exact (dvd_pow_self A hV.ne').mul_left P
  exact hndvd ((prime_one_sub_C_mul_X hq).dvd_of_dvd_pow hdvd)

end Core

section FiniteQuotient

variable [SmoothOfRelativeDimension 1 p] [GeometricallyConnected p] {Q : Type u} [Group Q]
  [Finite Q]

open Representation in
/-- If the geometric part of the Weil group maps onto a nontrivial subgroup `H` of a finite
quotient `π : W(C₀) → Q`, the vectors of the regular representation of `Q` with vanishing
`H`-average form a representation of `W(C₀)` contradicting the trace formula, provided all the
Frobenius elements map to `1`. -/
lemma false_of_map_geometric [IsAffine C] [Fact (ringChar K ≠ l)] (π : W.carrier →* Q)
    (hπ : Function.Surjective π) (hπo : IsOpen (π.ker : Set W.carrier))
    (hF : ∀ x, π (W.frobenius x) = 1) {g₀ : W.carrier} (hg₀ : g₀ ∈ W.geometric)
    (hπg₀ : π g₀ ≠ 1) : False := by
  classical
  let k := PadicAlgCl l
  let H : Subgroup Q := W.geometric.map π
  have hHn : H.Normal := W.deg.normal_ker.map π hπ
  have : Fintype Q := Fintype.ofFinite Q
  have : Fintype H := Fintype.ofFinite H
  let ρQ := Representation.ofMulAction k Q Q
  let σ : Module.End k (MonoidAlgebra k Q) := ∑ h : H, ρQ h
  have hσ (q : Q) : σ * ρQ q = ρQ q * σ := by
    let e : H ≃ H := (MulAut.conjNormal q).toEquiv
    calc σ * ρQ q = ∑ h : H, ρQ (h * q) := by simp [σ, Finset.sum_mul, map_mul]
      _ = ∑ h : H, ρQ (q * h) := (Fintype.sum_equiv e (fun h ↦ ρQ (q * h))
            (fun h ↦ ρQ (h * q)) fun h ↦ by simp [e, MulAut.conjNormal_apply]).symm
      _ = ρQ q * σ := by simp [σ, Finset.mul_sum, map_mul]
  let Vs := LinearMap.ker σ
  have hVs (q : Q) : Vs ≤ Vs.comap (ρQ q) := fun v hv ↦ by
    simp only [Submodule.mem_comap, LinearMap.mem_ker, Vs] at hv ⊢
    rw [← Module.End.mul_apply, hσ, Module.End.mul_apply, hv, map_zero]
  let ρ : Representation k W.carrier Vs :=
    Representation.subrepresentation (ρQ.comp π) Vs fun g ↦ hVs (π g)
  have hρ (g : W.carrier) (v : Vs) : (ρ g v : MonoidAlgebra k Q) = ρQ (π g) v := rfl
  -- the representation is lisse, since it factors through the finite discrete quotient `Q`
  let : TopologicalSpace Q := ⊥
  have : DiscreteTopology Q := ⟨rfl⟩
  have hπc : Continuous π := continuous_of_continuousAt_one π <| by
    rw [ContinuousAt, map_one, nhds_discrete Q, Filter.tendsto_pure]
    exact Filter.eventually_of_mem (hπo.mem_nhds π.ker.one_mem) fun g hg ↦ hg
  have hlisse : W.IsLisse l ρ := IsLisse.of_continuous_apply fun φ v ↦ by
    have : (fun g : W.geometric ↦ φ (ρ g v)) =
        (fun q : Q ↦ φ ⟨ρQ q v, hVs q v.2⟩) ∘ π ∘ Subtype.val := rfl
    rw [this]
    exact continuous_of_discreteTopology.comp (hπc.comp continuous_subtype_val)
  -- the Frobenius elements act trivially
  have hFr (x : C.finitePoints) : ρ (W.frobenius x) = 1 :=
    LinearMap.ext fun v ↦ Subtype.ext (by rw [hρ, hF x, map_one]; rfl)
  -- the representation is nonzero
  have hpos : 0 < Module.finrank k Vs := by
    refine Module.finrank_pos_iff_exists_ne_zero.2 ?_
    let h₀ : H := ⟨π g₀, Subgroup.mem_map_of_mem π hg₀⟩
    let v₀ : MonoidAlgebra k Q := MonoidAlgebra.single 1 1 - MonoidAlgebra.single (π g₀) 1
    have hv₀ : v₀ ∈ Vs := by
      change σ v₀ = 0
      rw [map_sub, sub_eq_zero, LinearMap.sum_apply, LinearMap.sum_apply]
      simp only [ρQ, Representation.ofMulAction_single, smul_eq_mul, mul_one]
      exact (Fintype.sum_equiv (Equiv.mulRight h₀) _ _ fun h ↦ rfl).symm
    refine ⟨⟨v₀, hv₀⟩, fun h0 ↦ ?_⟩
    have := congrArg (fun f : MonoidAlgebra k Q ↦ f.coeff 1) (congrArg Subtype.val h0)
    simp [v₀, hπg₀.symm] at this
  -- the geometric coinvariants vanish
  have : Subsingleton (Coinvariants (ρ.comp W.geometric.subtype)) := by
    refine subsingleton_of_forall_eq 0 fun c ↦ Coinvariants.induction_on c fun v ↦ ?_
    rw [Coinvariants.mk_eq_zero]
    have hgh (h : H) : ∃ g : W.geometric, π g = h := by
      obtain ⟨g, hg, hgh⟩ := Subgroup.mem_map.1 h.2
      exact ⟨⟨g, hg⟩, hgh⟩
    choose gh hgh using hgh
    have hN : (Fintype.card H : k) ≠ 0 := Nat.cast_ne_zero.2 Fintype.card_ne_zero
    have key : (Fintype.card H : k) • v = ∑ h : H, (v - ρ (gh h) v) := by
      apply Subtype.ext
      have hv : σ v = 0 := v.2
      simp only [σ, LinearMap.sum_apply] at hv
      simp only [Submodule.coe_smul, Submodule.coe_sum, Submodule.coe_sub, hρ, hgh,
        Finset.sum_sub_distrib, hv, sub_zero, Finset.sum_const, Finset.card_univ,
        ← Nat.cast_smul_eq_nsmul k]
    have hv : v = (Fintype.card H : k)⁻¹ • ∑ h : H, (v - ρ (gh h) v) := by
      rw [← key, smul_smul, inv_mul_cancel₀ hN, one_smul]
    rw [hv]
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun h _ ↦ ?_)
    rw [← neg_sub]
    exact Submodule.neg_mem _ (Coinvariants.sub_mem_ker (gh h) v)
  exact false_of_subsingleton_coinvariants W l hlisse hFr hpos

/-- **A finite quotient of the Weil group of a smooth geometrically connected affine curve over a
finite field in which all the local Frobenius elements become trivial is trivial.**

This is the form of the Chebotarev density theorem proved here: the representations of the
quotient are compared with the trivial representation through the Euler-product form of the
Grothendieck–Lefschetz trace formula (blueprint `cor-rp-euler-product`). -/
theorem map_eq_one_of_map_frobenius_eq_one [IsAffine C] (π : W.carrier →* Q)
    (hπ : Function.Surjective π) (hπo : IsOpen (π.ker : Set W.carrier))
    (hF : ∀ x, π (W.frobenius x) = 1) (g : W.carrier) : π g = 1 := by
  obtain ⟨l, hl, hlK⟩ : ∃ l, l.Prime ∧ ringChar K ≠ l := by
    by_cases h : ringChar K = 2
    · exact ⟨3, Nat.prime_three, by omega⟩
    · exact ⟨2, Nat.prime_two, h⟩
  have : Fact l.Prime := ⟨hl⟩
  have : Fact (ringChar K ≠ l) := ⟨hlK⟩
  by_cases hgeo : ∀ g ∈ W.geometric, π g = 1
  · -- `π` factors through the degree: a cyclic quotient
    set a := π W.frobeniusLift
    have hpow (w : W.carrier) : π w = a ^ (W.deg w).toAdd := by
      have hc : w * (W.frobeniusLift ^ (W.deg w).toAdd)⁻¹ ∈ W.geometric := by
        rw [MonoidHom.mem_ker, map_mul, map_inv, map_zpow, W.deg_frobeniusLift, ← ofAdd_zsmul,
          smul_eq_mul, mul_one, ofAdd_toAdd, mul_inv_cancel]
      have := hgeo _ hc
      rwa [map_mul, map_inv, map_zpow, mul_inv_eq_one] at this
    by_contra hg
    have ha : a ≠ 1 := fun ha ↦ hg (by rw [hpow, ha, one_zpow])
    have hf : 2 ≤ orderOf a := by
      have h₁ : 0 < orderOf a := (isOfFinOrder_of_finite a).orderOf_pos
      have h₂ : orderOf a ≠ 1 := fun h ↦ ha (orderOf_eq_one_iff.1 h)
      omega
    refine false_of_dvd_degreeOver W l hf fun x ↦ orderOf_dvd_of_pow_eq_one ?_
    have := hF x
    rwa [hpow, W.deg_frobenius, toAdd_ofAdd, zpow_natCast] at this
  · push Not at hgeo
    obtain ⟨g₀, hg₀, hπg₀⟩ := hgeo
    exact (false_of_map_geometric W l π hπ hπo hF hg₀ hπg₀).elim

end FiniteQuotient

section Density

/-- The normal subgroup generated by a finite quotient of the Weil group of an affine curve and
its local Frobenius elements is everything. -/
lemma normalClosure_frobenius_sup_eq_top [IsAffine C] [SmoothOfRelativeDimension 1 p]
    [GeometricallyConnected p] (N : Subgroup W.carrier) [N.Normal] [N.FiniteIndex]
    (hN : IsOpen (N : Set W.carrier)) :
    Subgroup.normalClosure (Set.range W.frobenius) ⊔ N = ⊤ := by
  set H := Subgroup.normalClosure (Set.range W.frobenius)
  have : (H ⊔ N).FiniteIndex := Subgroup.finiteIndex_of_le le_sup_right
  have : Finite (W.carrier ⧸ (H ⊔ N)) := Subgroup.finite_quotient_of_finiteIndex
  have hπ := map_eq_one_of_map_frobenius_eq_one W (QuotientGroup.mk' (H ⊔ N))
    (QuotientGroup.mk'_surjective _)
    (by rw [QuotientGroup.ker_mk']; exact Subgroup.isOpen_mono le_sup_right hN)
    fun x ↦ (QuotientGroup.eq_one_iff _).2
      (le_sup_left (a := H) (Subgroup.subset_normalClosure ⟨x, rfl⟩))
  exact eq_top_iff.2 fun g _ ↦ (QuotientGroup.eq_one_iff g).1 (hπ g)

variable (N' : Subgroup W.fundamentalGroup) [N'.Normal]

/-- The map from the Weil group to the finite group `π₁(C₀, s) / N' × ℤ / D`. -/
noncomputable def toQuotientProdZMod (D : ℕ) :
    W.carrier →* (W.fundamentalGroup ⧸ N') × Multiplicative (ZMod D) :=
  ((QuotientGroup.mk' N').comp W.toFundamentalGroup).prod
    ((AddMonoidHom.toMultiplicative (Int.castAddHom (ZMod D))).comp W.deg)

lemma mem_ker_toQuotientProdZMod {D : ℕ} {g : W.carrier} :
    g ∈ (W.toQuotientProdZMod N' D).ker ↔
      W.toFundamentalGroup g ∈ N' ∧ (D : ℤ) ∣ (W.deg g).toAdd := by
  simp only [MonoidHom.mem_ker, toQuotientProdZMod, MonoidHom.prod_apply, MonoidHom.comp_apply,
    QuotientGroup.mk'_apply, Prod.mk_eq_one, QuotientGroup.eq_one_iff]
  refine and_congr Iff.rfl ?_
  rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
  exact Multiplicative.ofAdd.apply_eq_iff_eq (y := 0)

omit [N'.Normal] in
/-- The geometric elements of the Weil group mapping into an open subgroup of `π₁(C₀, s)` form an
open subset of the Weil group. -/
lemma isOpen_setOf_mem_geometric_toFundamentalGroup_mem
    (hN' : IsOpen (N' : Set W.fundamentalGroup)) :
    IsOpen {g : W.carrier | g ∈ W.geometric ∧ W.toFundamentalGroup g ∈ N'} := by
  have h₁ : IsOpen ((fun g : W.geometric ↦ (W.weilGroupEquiv g).1.1) ⁻¹' N') :=
    hN'.preimage W.isEmbedding_ker.continuous
  convert W.isOpen_ker.isOpenMap_subtype_val _ h₁ using 1
  ext g
  simp only [Set.mem_ofPred_eq, Set.mem_image, Set.mem_preimage, Subtype.exists]
  exact ⟨fun h ↦ ⟨g, h.1, h.2, rfl⟩, by rintro ⟨g, hg, h, rfl⟩; exact ⟨hg, h⟩⟩

lemma finiteIndex_ker_toQuotientProdZMod (hN' : IsOpen (N' : Set W.fundamentalGroup)) {D : ℕ}
    [NeZero D] : (W.toQuotientProdZMod N' D).ker.FiniteIndex := by
  have : Finite (W.fundamentalGroup ⧸ N') := Subgroup.quotient_finite_of_isOpen N' hN'
  exact Subgroup.finiteIndex_ker _

lemma isOpen_ker_toQuotientProdZMod (hN' : IsOpen (N' : Set W.fundamentalGroup)) (D : ℕ) :
    IsOpen ((W.toQuotientProdZMod N' D).ker : Set W.carrier) := by
  obtain ⟨V, hV⟩ : ∃ V : Subgroup W.carrier,
      (V : Set W.carrier) = {g | g ∈ W.geometric ∧ W.toFundamentalGroup g ∈ N'} :=
    ⟨W.geometric ⊓ N'.comap W.toFundamentalGroup, rfl⟩
  refine Subgroup.isOpen_mono (H₁ := V) (fun g hg ↦ ?_) ?_
  · rw [← SetLike.mem_coe, hV] at hg
    rw [mem_ker_toQuotientProdZMod]
    refine ⟨hg.2, ?_⟩
    rw [show W.deg g = 1 from hg.1]
    exact dvd_zero _
  · rw [hV]
    exact W.isOpen_setOf_mem_geometric_toFundamentalGroup_mem N' hN'

/-- **Chebotarev density** for the Weil group of a smooth geometrically connected affine curve
over a finite field: the local Frobenius elements generate a dense normal subgroup.

A basis of neighbourhoods of `1` is given by the geometric elements `V` mapping into an open
normal subgroup `N'` of `π₁(C₀, s)`. The quotient `W / V` is an extension of `ℤ` by a finite
group, and the subgroups of finite index `N_D` of the elements mapping into `N'` with degree
divisible by `D` approximate `V`: the normal subgroup `H` generated by the Frobenius elements
satisfies `H N_D = W` (`map_eq_one_of_map_frobenius_eq_one`), which first produces an element
`h₁ ∈ H` mapping into `N'` with nonzero degree, and then, for `D = |deg h₁|`, shows `H V = W`. -/
theorem dense_frobenius_of_isAffine [IsAffine C] [SmoothOfRelativeDimension 1 p]
    [GeometricallyConnected p] :
    Dense ((Subgroup.normalClosure (Set.range W.frobenius) : Subgroup W.carrier) :
      Set W.carrier) := by
  classical
  set H := Subgroup.normalClosure (Set.range W.frobenius)
  have := W.connectedSpace
  have : TotallyDisconnectedSpace W.fundamentalGroup :=
    (PreGaloisCategory.toAutHomeo (Scheme.FiniteEtale.fiber W.basePoint)
      W.fundamentalGroup).symm.totallyDisconnectedSpace
  have hmem (N' : Subgroup W.fundamentalGroup) [N'.Normal]
      (hN' : IsOpen (N' : Set W.fundamentalGroup)) (D : ℕ)
      [NeZero D] (w : W.carrier) : ∃ h ∈ H, ∃ n, W.toFundamentalGroup n ∈ N' ∧
        (D : ℤ) ∣ (W.deg n).toAdd ∧ w = h * n := by
    have := W.finiteIndex_ker_toQuotientProdZMod N' hN' (D := D)
    have hsup := W.normalClosure_frobenius_sup_eq_top _ (W.isOpen_ker_toQuotientProdZMod N' hN' D)
    have hw : w ∈ ((H ⊔ (W.toQuotientProdZMod N' D).ker : Subgroup _) : Set W.carrier) := by
      rw [hsup]
      trivial
    rw [Subgroup.mul_normal] at hw
    obtain ⟨h, hh, n, hn, rfl⟩ := hw
    exact ⟨h, hh, n, ((W.mem_ker_toQuotientProdZMod N').1 hn).1,
      ((W.mem_ker_toQuotientProdZMod N').1 hn).2, rfl⟩
  rw [dense_iff_inter_open]
  rintro U hU ⟨w, hwU⟩
  -- an open normal subgroup `N'` of `π₁(C₀, s)` such that `w V ⊆ U`
  let e : W.geometric → W.fundamentalGroup := fun g ↦ (W.weilGroupEquiv g).1.1
  obtain ⟨O, hO, hOe⟩ := W.isEmbedding_ker.isInducing.isOpen_iff.1
    (hU.preimage (continuous_const.mul continuous_subtype_val) :
      IsOpen {g : W.geometric | w * g ∈ U})
  have h1O : (1 : W.fundamentalGroup) ∈ O := by
    have : (1 : W.geometric) ∈ e ⁻¹' O := by
      rw [hOe]
      simpa using hwU
    simpa [e] using this
  obtain ⟨N₀, hN₀O⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hO h1O
  set N' : Subgroup W.fundamentalGroup := N₀.toSubgroup
  have : N'.Normal := N₀.isNormal'
  have hN'o : IsOpen (N' : Set W.fundamentalGroup) := N₀.isOpen'
  have hV (v : W.carrier) (hv : v ∈ W.geometric) (hvN : W.toFundamentalGroup v ∈ N') :
      w * v ∈ U := by
    have : (⟨v, hv⟩ : W.geometric) ∈ e ⁻¹' O := hN₀O hvN
    rw [hOe] at this
    exact this
  -- an element `h₁ ∈ H` mapping into `N'`, of nonzero degree
  set γ := W.frobeniusLift
  have : Finite (W.fundamentalGroup ⧸ N') :=
    Subgroup.quotient_finite_of_isOpen _ hN'o
  set r := orderOf (QuotientGroup.mk (W.toFundamentalGroup γ) :
    W.fundamentalGroup ⧸ N')
  have hr : 0 < r := (isOfFinOrder_of_finite _).orderOf_pos
  have hγr : W.toFundamentalGroup (γ ^ r) ∈ N' := by
    rw [map_pow, ← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, pow_orderOf_eq_one]
  have : NeZero (2 * r) := ⟨by omega⟩
  obtain ⟨h₁, hh₁, n₁, hn₁N, ⟨t, ht⟩, hz⟩ := hmem N' hN'o (2 * r) (γ ^ r)
  have hh₁' : h₁ = γ ^ r * n₁⁻¹ := by
    rw [hz]
    group
  have hh₁N : W.toFundamentalGroup h₁ ∈ N' := by
    rw [hh₁', map_mul, map_inv]
    exact mul_mem hγr (inv_mem hn₁N)
  have hdeg₁ : (W.deg h₁).toAdd = r * (1 - 2 * t) := by
    rw [hh₁', map_mul, map_inv, map_pow, toAdd_mul, toAdd_inv, toAdd_pow, ht,
      W.deg_frobeniusLift, toAdd_ofAdd]
    push_cast
    ring
  have hdeg₁0 : (W.deg h₁).toAdd ≠ 0 := by
    rw [hdeg₁]
    refine mul_ne_zero (by exact_mod_cast hr.ne') fun h ↦ ?_
    omega
  have : NeZero (W.deg h₁).toAdd.natAbs := ⟨Int.natAbs_ne_zero.2 hdeg₁0⟩
  obtain ⟨h₂, hh₂, n₂, hn₂N, hn₂D, hw⟩ := hmem N' hN'o (W.deg h₁).toAdd.natAbs w
  obtain ⟨m, hm⟩ := Int.natAbs_dvd.1 hn₂D
  -- `v = h₁ ^ (-m) n₂` is geometric and maps into `N'`
  set v := h₁ ^ (-m) * n₂
  have hvgeo : v ∈ W.geometric := by
    rw [MonoidHom.mem_ker, ← toAdd_eq_zero, map_mul, map_zpow, toAdd_mul, toAdd_zpow, hm]
    ring
  have hvN : W.toFundamentalGroup v ∈ N' := by
    rw [map_mul, map_zpow]
    exact mul_mem (zpow_mem hh₁N _) hn₂N
  refine ⟨h₂ * h₁ ^ m, ?_, mul_mem hh₂ (zpow_mem hh₁ m)⟩
  have : h₂ * h₁ ^ m = w * v⁻¹ := by
    rw [hw]
    simp only [v, mul_inv_rev, zpow_neg, inv_inv]
    group
  rw [this]
  exact hV _ (inv_mem hvgeo) (by rw [map_inv]; exact inv_mem hvN)

end Density

section Restriction

variable {U : Scheme.{u}} {pU : U ⟶ Spec (.of K)} [IsCurve pU] {j : U ⟶ C} [IsOpenImmersion j]
  [Nonempty U] {WU : WeilGroup pU} {WC : WeilGroup p}

/-- Chebotarev density passes along a restriction of Weil groups: the restriction is continuous
and surjective, and carries the local Frobenius elements of `W(U₀)` into Frobenius conjugacy
classes of `W(C₀)`. -/
theorem Restriction.dense_frobenius (R : Restriction j WU WC)
    (h : Dense ((Subgroup.normalClosure (Set.range WU.frobenius) : Subgroup WU.carrier) :
      Set WU.carrier)) :
    Dense ((Subgroup.normalClosure (Set.range WC.frobenius) : Subgroup WC.carrier) :
      Set WC.carrier) := by
  refine (R.surjective_restrict.denseRange.dense_image R.continuous_restrict h).mono ?_
  rw [← Subgroup.coe_map, Subgroup.map_normalClosure _ _ R.surjective_restrict]
  refine Subgroup.normalClosure_le_normal ?_
  rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
  have : Finite (U.residueField x.1) := x.2
  let y : C.finitePoints := ⟨j x.1, Finite.of_equiv _
    (Scheme.FiniteEtale.residueFieldEquiv j x.1).symm.toEquiv⟩
  obtain ⟨c, hc⟩ := isConj_iff.1 (R.restrict_frobenius x y rfl)
  rw [← hc]
  exact (Subgroup.normalClosure_normal (s := Set.range WC.frobenius)).conj_mem _
    (Subgroup.subset_normalClosure ⟨y, rfl⟩) c

end Restriction

section OpenSubcurve

variable {U : Scheme.{u}} (j : U ⟶ C) [IsOpenImmersion j]

omit [Finite K] in
/-- An affine open of a curve is a curve. -/
lemma isCurve_comp_of_isAffine [IsAffine U] : IsCurve (j ≫ p) where
  krullDim_le_one :=
    j.isOpenEmbedding.isInducing.topologicalKrullDim_le.trans (IsCurve.krullDim_le_one (f := p))

omit [Finite K] [IsCurve p] in
/-- A nonempty open of a smooth geometrically connected scheme over a field is geometrically
connected: it is geometrically irreducible. -/
lemma geometricallyConnected_comp [Nonempty U] [Smooth p] [GeometricallyConnected p] :
    GeometricallyConnected (j ≫ p) := by
  have : GeometricallyIrreducible p := .of_smooth_of_geometricallyConnected p
  have : Surjective (j ≫ p) := ⟨fun _ ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩
  infer_instance

end OpenSubcurve

section General

variable [SmoothOfRelativeDimension 1 p] [GeometricallyConnected p] [ConnectedSpace C]
  (s : Spec (.of (AlgebraicClosure K)) ⟶ C) (G : Type u) [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [CompactSpace G] [∀ P, MulAction G ((Scheme.FiniteEtale.fiber s).obj P)]
  [PreGaloisCategory.IsFundamentalGroup (Scheme.FiniteEtale.fiber s) G]

/-- **Chebotarev density** for the Weil group `AlgebraicGeometry.WeilGroup.ofFundamentalGroup`
of a smooth geometrically connected curve over a finite field: the local Frobenius elements
generate a dense normal subgroup. The curve contains a nonempty affine open `U₀`, for which this
is `AlgebraicGeometry.WeilGroup.dense_frobenius_of_isAffine`, and density passes along the
restriction `W(U₀) → W(C₀)`. -/
theorem dense_frobenius_ofFundamentalGroup :
    Dense ((Subgroup.normalClosure (Set.range (ofFundamentalGroup p s G).frobenius) :
      Subgroup (ofFundamentalGroup p s G).carrier) : Set (ofFundamentalGroup p s G).carrier) := by
  have := SmoothOfRelativeDimension.smooth 1 p
  obtain ⟨x⟩ : Nonempty C := inferInstance
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : C.Opens) from trivial)
  have : IsAffine V := hV
  have : Nonempty V := ⟨⟨x, hxV⟩⟩
  have : IsCurve (V.ι ≫ p) := isCurve_comp_of_isAffine V.ι
  have : SmoothOfRelativeDimension 1 (V.ι ≫ p) := by
    simpa using smoothOfRelativeDimension_comp (n := 0) (m := 1) V.ι p
  have : GeometricallyConnected (V.ι ≫ p) := geometricallyConnected_comp V.ι
  have : ConnectedSpace V := GeometricallyConnected.connectedSpace_of_subsingleton (V.ι ≫ p)
  obtain ⟨sV⟩ := (V.ι ≫ p).nonempty_algebraicClosure_point
  obtain ⟨GV, _, _⟩ := Scheme.FiniteEtale.exists_isFundamentalGroup sV
  obtain ⟨τ⟩ := PreGaloisCategory.nonempty_iso_of_fiberFunctor
    (Scheme.FiniteEtale.fiber (sV ≫ V.ι)) (Scheme.FiniteEtale.fiber s)
  exact (restrictionOfPath V.ι rfl τ GV G).dense_frobenius
    (dense_frobenius_of_isAffine (ofFundamentalGroup (V.ι ≫ p) sV GV))

end General

/-- **Chebotarev density** for the Weil group of a smooth geometrically connected curve over a
finite field: the local Frobenius elements generate a dense normal subgroup.

Every Weil group is isomorphic to the standard one built from its base point and fundamental
group (`AlgebraicGeometry.WeilGroup.toStandard`), compatibly with the local Frobenius elements up
to conjugacy, and for the standard one this is
`AlgebraicGeometry.WeilGroup.dense_frobenius_ofFundamentalGroup`. -/
theorem dense_frobenius [SmoothOfRelativeDimension 1 p] [GeometricallyConnected p] :
    Dense ((Subgroup.normalClosure (Set.range W.frobenius) : Subgroup W.carrier) :
      Set W.carrier) := by
  have := W.connectedSpace
  have hd := dense_frobenius_ofFundamentalGroup (p := p) W.basePoint W.fundamentalGroup
  have h₂ := W.toStandard.symm.toHomeomorph.surjective.denseRange.dense_image
    W.toStandard.symm.continuous hd
  refine h₂.mono ?_
  rintro _ ⟨g, hg, rfl⟩
  set N := Subgroup.normalClosure (Set.range W.frobenius)
  have : (N.map W.toStandard.toMulEquiv.toMonoidHom).Normal :=
    (Subgroup.normalClosure_normal).map _ W.toStandard.surjective
  have hle : Subgroup.normalClosure (Set.range W.standard.frobenius) ≤
      N.map W.toStandard.toMulEquiv.toMonoidHom := by
    refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨x, rfl⟩
    obtain ⟨c, hc⟩ := isConj_iff.1 (W.isConj_toStandard_frobenius x)
    rw [← hc]
    exact this.conj_mem _ (Subgroup.mem_map_of_mem _ (Subgroup.subset_normalClosure ⟨x, rfl⟩)) c
  obtain ⟨g', hg', hgg'⟩ := Subgroup.mem_map.1 (hle hg)
  rw [← hgg']
  convert hg'
  exact iff_of_eq (congrArg (· ∈ (N : Set W.carrier)) (W.toStandard.symm_apply_apply g'))

end AlgebraicGeometry.WeilGroup
