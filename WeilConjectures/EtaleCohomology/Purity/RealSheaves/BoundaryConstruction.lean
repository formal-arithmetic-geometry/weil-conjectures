module

public import WeilConjectures.AlgebraicGeometry.FundamentalGroup.Inertia
public import WeilConjectures.EtaleCohomology.Purity.RealSheaves.Construction
public import WeilConjectures.Mathlib.Topology.KrullDimension

/-!
# The boundary of an open subcurve and the kernel of the restriction of Weil groups

Let `j : U₀ ⟶ C₀` be a nonempty open of a smooth geometrically connected curve over a finite
field, `U₀` geometrically connected. The boundary `C₀ \ U₀` is finite and consists of closed
points (`AlgebraicGeometry.WeilGroup.finite_boundary`,
`AlgebraicGeometry.WeilGroup.boundary_subset_finitePoints`), since `C₀` is irreducible of
dimension at most one.

The local kernel at a boundary point `z` (`AlgebraicGeometry.WeilGroup.weilLocalKernel`) is the
kernel of `π₁(U₀) → π₁(U₀ ∪ {z})`, i.e. the subgroup acting trivially on the finite étale covers
of `U₀` which extend over `z`, intersected with the geometric part of `W(U₀)`. These generate the
kernel of the restriction `W(U₀) → W(C₀)` as a closed normal subgroup
(`AlgebraicGeometry.WeilGroup.ker_restrictionHom_eq`), since a cover of `U₀` extending over each
`U₀ ∪ {z}` extends over `C₀`.

The local kernel at `z` is the closed normal subgroup generated by the conjugates of the inertia
group `I_z`, not `I_z` itself. The boundary datum of `d-real-boundary`, with the genuine
decomposition and inertia groups at the boundary points, is constructed in
`WeilConjectures.EtaleCohomology.Purity.RealSheaves.BoundaryInertia`.
-/

@[expose] public section

universe u

open CategoryTheory Limits PreGaloisCategory

namespace AlgebraicGeometry.WeilGroup

open Scheme.FiniteEtale

variable {K : Type u} [Field K] [Finite K] {C U : Scheme.{u}} {p : C ⟶ Spec (.of K)} [IsCurve p]
  [GeometricallyConnected p] [ConnectedSpace C] [Smooth p] {pU : U ⟶ Spec (.of K)} [IsCurve pU]
  [GeometricallyConnected pU] [ConnectedSpace U] (j : U ⟶ C) [IsOpenImmersion j] [Nonempty U]

section Boundary

omit [Finite K] [GeometricallyConnected p] [ConnectedSpace U] [IsCurve pU]
  [GeometricallyConnected pU] in
include p in
lemma irreducibleSpace_of_smooth : IrreducibleSpace C := by
  have := LocallyOfFiniteType.isLocallyNoetherian p
  have := IsRegular.of_smooth p
  exact IsRegular.irreducibleSpace C

omit [Finite K] [GeometricallyConnected p] [ConnectedSpace U] [IsCurve pU]
  [GeometricallyConnected pU] in
include p in
/-- The boundary of a nonempty open of a smooth connected curve is finite. -/
lemma finite_boundary : (Set.range j.base)ᶜ.Finite := by
  have := irreducibleSpace_of_smooth (p := p)
  have := LocallyOfFiniteType.isLocallyNoetherian p
  have : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace p
  have : IsNoetherian C := {}
  obtain ⟨u⟩ := (inferInstance : Nonempty U)
  exact j.isOpenEmbedding.isOpen_range.finite_compl_of_topologicalKrullDim_le_one
    (IsCurve.krullDim_le_one (f := p)) ⟨_, u, rfl⟩

end Boundary

variable (hj : j ≫ p = pU) {sU : Spec (.of (AlgebraicClosure K)) ⟶ U}
  {sC : Spec (.of (AlgebraicClosure K)) ⟶ C} (τ : fiber (sU ≫ j) ≅ fiber sC)
  (GU : Type u) [Group GU] [TopologicalSpace GU] [IsTopologicalGroup GU] [CompactSpace GU]
  [∀ P, MulAction GU ((fiber sU).obj P)] [IsFundamentalGroup (fiber sU) GU]
  (GC : Type u) [Group GC] [TopologicalSpace GC] [IsTopologicalGroup GC] [CompactSpace GC]
  [∀ P, MulAction GC ((fiber sC).obj P)] [IsFundamentalGroup (fiber sC) GC]

include hj

section LocalKernel

omit hj

omit [Finite K] [GeometricallyConnected p] [ConnectedSpace U] [IsCurve pU]
  [GeometricallyConnected pU] in
include p in
/-- The boundary `C₀ \ U₀` as a finite set. -/
noncomputable def boundaryFinset : Finset C := (finite_boundary (p := p) j).toFinset

omit [Finite K] [GeometricallyConnected p] [ConnectedSpace U] [IsCurve pU]
  [GeometricallyConnected pU] in
lemma coe_boundaryFinset : (↑(boundaryFinset (p := p) j) : Set C) = (Set.range j.base)ᶜ :=
  Set.Finite.coe_toFinset _

omit [Finite K] [GeometricallyConnected p] [ConnectedSpace U] [IsCurve pU]
  [GeometricallyConnected pU] in
lemma isClosed_of_mem_boundaryFinset :
    ∀ z ∈ boundaryFinset (p := p) j, IsClosed ({z} : Set C) := fun z hz ↦ by
  have := irreducibleSpace_of_smooth (p := p)
  obtain ⟨u⟩ := (inferInstance : Nonempty U)
  refine j.isOpenEmbedding.isOpen_range.isClosed_singleton_of_mem_compl
    (IsCurve.krullDim_le_one (f := p)) ⟨_, u, rfl⟩ ?_
  have hz' : z ∈ (↑(boundaryFinset (p := p) j) : Set C) := hz
  rwa [coe_boundaryFinset] at hz'

end LocalKernel

end AlgebraicGeometry.WeilGroup
