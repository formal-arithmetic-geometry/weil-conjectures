/-!
# Existence of strictly henselian neighbourhoods of boundary points

Let `j : U₀ ⟶ C₀` be a nonempty open of a smooth geometrically connected curve over a finite
field `k₀`. For every boundary point `z` with closed point `x`, some conjugate `σ • Q_z` of the
chosen point `Q_z` over `z`, by an element `σ ∈ Gal(Ω / k(C))` lying in the Weil group, is
compatible with the geometric point `x̄`, and hence gives a strictly henselian neighbourhood of
the boundary point for the conjugated inertia group and residue Frobenius lift
(`AlgebraicGeometry.WeilGroup.exists_boundaryNeighbourhood_conj`, blueprint
`lem-wf-boundary-stalk-invariants`).

* The constant field of `k(C)` is `k₀`: for a finite extension `F / k₀`, the ring
  `Γ(C₀, W) ⊗_{k₀} F` is a domain, `C₀ ×_{k₀} F` being connected and regular
  (`AlgebraicGeometry.WeilGroup.isDomain_sections_tensorProduct`).
* Hence every `k₀`-automorphism of `k̄ ⊆ Ω` extends to `Ω` over `k(C)`; an extension of the
  geometric Frobenius lies in the Weil group with degree one.
* Conjugating `Q_z` by a power of it adjusts the embedding `κ(x) ↪ k̄` induced by `Q_z` to the one
  of `x̄`.
-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing PreGaloisCategory
open scoped Pointwise TensorProduct

namespace AlgebraicGeometry.WeilGroup

open Scheme Scheme.FiniteEtale ProEtale

variable {K : Type u} [Field K] [Finite K] {C U : Scheme.{u}} [C.Over (Spec (.of K))]
  [U.Over (Spec (.of K))] [IsCurve (C ↘ Spec (.of K))] [GeometricallyConnected (C ↘ Spec (.of K))]
  [ConnectedSpace C] [Smooth (C ↘ Spec (.of K))] [IsIntegral C]
  (j : U ⟶ C) [IsOpenImmersion j] [Nonempty U] [j.IsOver (Spec (.of K))]

local notation "Ω" => SeparableClosure (Scheme.functionField C)

omit [Finite K] [IsCurve (C ↘ Spec (.of K))] [ConnectedSpace C] [IsIntegral C] in
/-- **The constant field of a geometrically connected smooth curve.** For an affine open `W` and
a field extension `F / k₀`, the ring `Γ(C₀, W) ⊗_{k₀} F` is a domain: it is the ring of an affine
open of `C₀ ×_{k₀} F`, which is connected and smooth over `F`, hence integral. -/
theorem isDomain_sections_tensorProduct {W : C.Opens} (hW : IsAffineOpen W) [Nonempty W]
    (F : Type u) [Field F] [Algebra K F] :
    letI := (sectionsStructHom (k₀ := K) hW).toAlgebra
    IsDomain (Γ(C, W) ⊗[K] F) := by
  let := (sectionsStructHom (k₀ := K) hW).toAlgebra
  set iC := C ↘ Spec (.of K)
  set f := Spec.map (CommRingCat.ofHom (algebraMap K F))
  have : ConnectedSpace ↥(pullback iC f) :=
    GeometricallyConnected.geometrically_connectedSpace f _ _ (IsPullback.of_hasPullback iC f)
  have : IsRegular (pullback iC f) := IsRegular.of_smooth (pullback.snd iC f)
  have : IsLocallyNoetherian (pullback iC f) :=
    LocallyOfFiniteType.isLocallyNoetherian (pullback.snd iC f)
  have := IsRegular.isIntegral (pullback iC f)
  have hfp : hW.fromSpec ≫ iC = Spec.map (CommRingCat.ofHom (algebraMap K Γ(C, W))) := by
    change _ = Spec.map (CommRingCat.ofHom (sectionsStructHom (k₀ := K) hW))
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  let ι : Spec (.of (Γ(C, W) ⊗[K] F)) ⟶ pullback iC f :=
    (pullbackSpecIso K Γ(C, W) F).inv ≫
      pullback.map _ _ _ _ hW.fromSpec (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hfp]) (by simp [f])
  have : Nonempty (Spec (.of (Γ(C, W) ⊗[K] F))) := inferInstance
  have := isIntegral_of_isOpenImmersion ι
  exact (affine_isIntegral_iff _).1 this

omit [IsCurve (C ↘ Spec (.of K))] [ConnectedSpace C] in
/-- **Extending automorphisms of `k̄` to `Ω`, finite level.** For a `k₀`-automorphism `Φ` of `k̄`
and finitely many `y ∈ k̄`, some `σ ∈ Gal(Ω / k(C))` satisfies `σ (ι y) = ι (Φ y)`, `ι` the
embedding `k̄ ↪ Ω` of the geometric generic point. For a primitive element `α` of the subfield
`F` generated by the `y`, the elements `ι α` and `ι (Φ α)` are images of `1 ⊗ α` under injective
maps `Γ(C, W) ⊗_{k₀} F ⟶ Ω` (`Γ(C, W) ⊗_{k₀} F` being a domain integral over `Γ(C, W)`), hence
have the same minimal polynomial over `k(C)`. -/
theorem exists_galois_genericEmb_finset {W : C.Opens} (hW : IsAffineOpen W) [Nonempty W]
    [IsDedekindDomain Γ(C, W)] (Φ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K)
    (S : Finset (AlgebraicClosure K)) :
    ∃ σ : Gal(Ω/C.functionField), ∀ y ∈ S,
      σ (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j (Φ y) := by
  classical
  let : Algebra K Γ(C, W) := (sectionsStructHom (k₀ := K) hW).toAlgebra
  let : Algebra K Ω := ((algebraMap Γ(C, W) Ω).comp (sectionsStructHom (k₀ := K) hW)).toAlgebra
  have : IsScalarTower K Γ(C, W) Ω := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsFractionRing Γ(C, W) C.functionField :=
    functionField_isFractionRing_of_isAffineOpen C W hW
  have hRΩ : Function.Injective (algebraMap Γ(C, W) Ω) :=
    injective_algebraMap_sections_of_isAffineOpen hW
  have hgen : (genericEmb (U ↘ Spec (.of K)) j).comp (algebraMap K _) = algebraMap K Ω := by
    rw [genericEmb_comp_algebraMap, genericStructHom_eq j hW]
    rfl
  let e : AlgebraicClosure K →ₐ[K] Ω :=
    { toRingHom := genericEmb (U ↘ Spec (.of K)) j, commutes' := RingHom.congr_fun hgen }
  let F := IntermediateField.adjoin K (S : Set (AlgebraicClosure K))
  have : FiniteDimensional K F :=
    IntermediateField.finiteDimensional_adjoin fun x _ ↦ Algebra.IsIntegral.isIntegral x
  obtain ⟨α, hα⟩ := Field.exists_primitive_element K F
  let ψ : F →ₐ[K] Ω := e.comp F.val
  let ψ' : F →ₐ[K] Ω := (e.comp Φ.toAlgHom).comp F.val
  have := isDomain_sections_tensorProduct (K := K) hW F
  -- the maps `Γ(C, W) ⊗_{k₀} F ⟶ Ω` are injective
  have hinj (ν : Γ(C, W) ⊗[K] F →ₐ[Γ(C, W)] Ω) : Function.Injective ν := by
    have hker : RingHom.ker ν.toRingHom = ⊥ := by
      refine Ideal.eq_bot_of_under_eq_bot (R := Γ(C, W)) ?_
      ext r
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AlgHom.commutes, Ideal.mem_bot]
      exact ⟨fun h ↦ hRΩ (h.trans (map_zero _).symm), fun h ↦ by rw [h, map_zero]⟩
    exact (RingHom.injective_iff_ker_eq_bot _).2 hker
  let μ : Γ(C, W) ⊗[K] F →ₐ[Γ(C, W)] Ω :=
    Algebra.TensorProduct.lift (Algebra.ofId _ Ω) ψ fun _ _ ↦ Commute.all _ _
  let μ' : Γ(C, W) ⊗[K] F →ₐ[Γ(C, W)] Ω :=
    Algebra.TensorProduct.lift (Algebra.ofId _ Ω) ψ' fun _ _ ↦ Commute.all _ _
  have hμ : μ (1 ⊗ₜ α) = ψ α := by simp [μ]
  have hμ' : μ' (1 ⊗ₜ α) = ψ' α := by simp [μ']
  -- `ψ α` and `ψ' α` satisfy the same polynomials over `Γ(C, W)`
  have hsame (p : Polynomial Γ(C, W)) (hp : Polynomial.aeval (ψ α) p = 0) :
      Polynomial.aeval (ψ' α) p = 0 := by
    rw [← hμ, Polynomial.aeval_algHom_apply] at hp
    have h0 := hinj μ (hp.trans (map_zero μ).symm)
    rw [← hμ', Polynomial.aeval_algHom_apply, h0, map_zero]
  -- hence the same minimal polynomial over `k(C)`
  have hint : _root_.IsIntegral C.functionField (ψ α) := Algebra.IsIntegral.isIntegral _
  have haeval : Polynomial.aeval (ψ' α) (minpoly C.functionField (ψ α)) = 0 := by
    obtain ⟨b, hb, hbq⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors Γ(C, W))
      (minpoly C.functionField (ψ α))
    have h1 := hsame _ (IsLocalization.integerNormalization_aeval_eq_zero
      (nonZeroDivisors Γ(C, W)) _ (minpoly.aeval C.functionField (ψ α)))
    rw [← Polynomial.aeval_map_algebraMap C.functionField, hbq,
      ← IsScalarTower.algebraMap_smul C.functionField b, map_smul, Algebra.smul_def,
      mul_eq_zero, ← IsScalarTower.algebraMap_apply] at h1
    refine h1.resolve_left fun h ↦ nonZeroDivisors.ne_zero hb (hRΩ ?_)
    rw [map_zero]
    exact h
  have hmin := minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hint) haeval
    (minpoly.monic hint)
  obtain ⟨σ, hσ⟩ := (Normal.minpoly_eq_iff_mem_orbit (F := C.functionField) (E := Ω)).1 hmin.symm
  refine ⟨σ, fun y hy ↦ ?_⟩
  let σK : Ω →ₐ[K] Ω :=
    { σ.toRingHom with
      commutes' c := by
        change σ (algebraMap Γ(C, W) Ω (algebraMap K Γ(C, W) c)) = _
        rw [IsScalarTower.algebraMap_apply Γ(C, W) C.functionField Ω, AlgEquiv.commutes]
        rfl }
  have hext : σK.comp ψ = ψ' := by
    have htop : Algebra.adjoin K {α} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (Algebra.IsAlgebraic.isAlgebraic α), hα, IntermediateField.top_toSubalgebra]
    refine AlgHom.ext_of_adjoin_eq_top htop ?_
    rintro _ rfl
    exact hσ
  exact AlgHom.congr_fun hext ⟨y, IntermediateField.subset_adjoin K _ hy⟩

/-- In the Krull topology, the set of automorphisms mapping `a` to `b` is closed: an automorphism
`σ` with `σ a ≠ b` has the open neighbourhood `σ Gal(L / k(a))` of such automorphisms. -/
lemma isClosed_setOf_algEquiv_apply_eq {k L : Type*} [Field k] [Field L] [Algebra k L]
    [Algebra.IsAlgebraic k L] (a b : L) : IsClosed {σ : Gal(L/k) | σ a = b} := by
  rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
  intro σ hσ
  let E : IntermediateField k L := IntermediateField.adjoin k {a}
  have : FiniteDimensional k E :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral a)
  refine ⟨(σ * ·) '' (E.fixingSubgroup : Set Gal(L/k)), ?_, ?_, ⟨1, one_mem _, mul_one σ⟩⟩
  · rintro _ ⟨τ, hτ, rfl⟩ h
    have hτa : τ a = a := (IntermediateField.mem_fixingSubgroup_iff E τ).1 hτ _
      (IntermediateField.subset_adjoin k _ rfl)
    apply hσ
    have h' : (σ * τ) a = b := h
    rwa [AlgEquiv.mul_apply, hτa] at h'
  · exact (Homeomorph.mulLeft σ).isOpenMap _ (IntermediateField.fixingSubgroup_isOpen E)

omit [IsCurve (C ↘ Spec (.of K))] [ConnectedSpace C] in
/-- **Extending automorphisms of `k̄` to `Ω`.** Every `k₀`-automorphism `Φ` of `k̄` extends to an
automorphism of `Ω` over `k(C)` through the embedding `ι : k̄ ↪ Ω` of the geometric generic point:
the finite-level extensions (`exists_galois_genericEmb_finset`) form a directed family of
nonempty closed subsets of the compact group `Gal(Ω / k(C))`. -/
theorem exists_galois_genericEmb {W : C.Opens} (hW : IsAffineOpen W) [Nonempty W]
    [IsDedekindDomain Γ(C, W)] (Φ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
    ∃ σ : Gal(Ω/C.functionField), ∀ y,
      σ (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j (Φ y) := by
  classical
  let t : Finset (AlgebraicClosure K) → Set Gal(Ω/C.functionField) := fun S ↦
    {σ | ∀ y ∈ S, σ (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j (Φ y)}
  have hclosed (S : Finset (AlgebraicClosure K)) : IsClosed (t S) := by
    have : t S = ⋂ y ∈ S, {σ : Gal(Ω/C.functionField) |
        σ (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j (Φ y)} := by
      ext σ
      simp [t]
    rw [this]
    exact isClosed_biInter fun y _ ↦ isClosed_setOf_algEquiv_apply_eq _ _
  have hne (S : Finset (AlgebraicClosure K)) : (t S).Nonempty :=
    exists_galois_genericEmb_finset j hW Φ S
  have hdir : Directed (· ⊇ ·) t := fun S₁ S₂ ↦ ⟨S₁ ∪ S₂,
    fun σ h y hy ↦ h y (Finset.mem_union_left _ hy),
    fun σ h y hy ↦ h y (Finset.mem_union_right _ hy)⟩
  obtain ⟨σ, hσ⟩ := IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed t hdir hne
    (fun S ↦ (hclosed S).isCompact) hclosed
  exact ⟨σ, fun y ↦ Set.mem_iInter.1 hσ {y} y (Finset.mem_singleton_self y)⟩

omit [IsCurve (C ↘ Spec (.of K))] [GeometricallyConnected (C ↘ Spec (.of K))]
  [ConnectedSpace C] [Smooth (C ↘ Spec (.of K))] [C.Over (Spec (.of K))]
  [j.IsOver (Spec (.of K))] in
/-- The elements of `Ω` integral over `k₀` are the elements of `ι(k̄)`, `ι` the embedding of the
geometric generic point. -/
lemma exists_genericEmb_eq_of_isIntegral {z : Ω}
    (hz : letI := (genericStructHom (U ↘ Spec (.of K)) j).toAlgebra; _root_.IsIntegral K z) :
    ∃ c, genericEmb (U ↘ Spec (.of K)) j c = z := by
  let := (genericStructHom (U ↘ Spec (.of K)) j).toAlgebra
  let eK : AlgebraicClosure K →ₐ[K] Ω :=
    { toRingHom := genericEmb (U ↘ Spec (.of K)) j, commutes' := genericEmb_algebraMap j }
  let E := integralClosure K Ω
  let ε : AlgebraicClosure K →+* E :=
    eK.toRingHom.codRestrict E fun c ↦ (Algebra.IsIntegral.isIntegral (R := K) c).map eK
  have hint : ε.IsIntegral := by
    let := ε.toAlgebra
    have : IsScalarTower K (AlgebraicClosure K) E := IsScalarTower.of_algebraMap_eq fun c ↦
      Subtype.ext (genericEmb_algebraMap j c).symm
    intro e
    have he : _root_.IsIntegral K e :=
      (isIntegral_algHom_iff E.val Subtype.val_injective).1 e.2
    exact he.tower_top (A := AlgebraicClosure K)
  obtain ⟨c, hc⟩ := (IsAlgClosed.ringHom_bijective_of_isIntegral ε hint).2 ⟨z, hz⟩
  exact ⟨c, congrArg Subtype.val hc⟩

omit [Finite K] [C.Over (Spec (.of K))] [IsCurve (C ↘ Spec (.of K))]
  [GeometricallyConnected (C ↘ Spec (.of K))]
  [ConnectedSpace C] [Smooth (C ↘ Spec (.of K))] [j.IsOver (Spec (.of K))] in
lemma constantCoverPoint_congr (A : FiniteEtaleAlgebra K) {ψ ψ' : A.1 →+* Ω} (h : ψ = ψ')
    (hψ : ψ.comp (algebraMap K A.1) = genericStructHom (U ↘ Spec (.of K)) j)
    (hψ' : ψ'.comp (algebraMap K A.1) = genericStructHom (U ↘ Spec (.of K)) j) :
    constantCoverPoint j A ψ hψ = constantCoverPoint j A ψ' hψ' := by
  subst h
  rfl

lemma FiniteEtaleAlgebra.frobenius_pow_apply (A : FiniteEtaleAlgebra K) (m : ℕ) (x : A.1) :
    (A.frobenius ^ m) x = x ^ (Nat.card K ^ m) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ', AlgEquiv.mul_apply, ih, FiniteEtaleAlgebra.frobenius_apply, ← pow_mul,
      pow_succ]

omit [Finite K] in
lemma geometricFrobeniusAlgEquivOfAlgebraic_pow_apply_pow [Fintype K] (n : ℕ)
    (c : AlgebraicClosure K) :
    (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K) ^ n)
      (c ^ (Nat.card K ^ n)) = c := by
  have h : (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K) ^ n) c =
      c ^ (Nat.card K ^ n) := by
    rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate,
      Nat.card_eq_fintype_card]
  rw [← h, FiniteField.geometricFrobeniusAlgEquivOfAlgebraic_eq_inv, inv_pow, AlgEquiv.aut_inv,
    AlgEquiv.symm_apply_apply]

/-- A Galois lift of a Frobenius power makes a boundary chart compatible with its geometric
residue point. -/
lemma exists_boundaryChart_galois_compatible (x : C.finitePoints)
    (c : BoundaryChart (C ↘ Spec (.of K)) j x.1) :
    ∃ (σ : Gal(Ω/C.functionField)) (n : ℕ),
      (∀ y, σ (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j
        (letI := Fintype.ofFinite K
         (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K) ^ n) y)) ∧
      ∀ a : Γ(C, c.W), ∃ b ∈ σ • c.point, (b : Ω) =
        genericEmb (U ↘ Spec (.of K)) j ((C ↘ Spec (.of K)).geometricFiberPointEmb x
          (sectionsResidue x c.mem a)) - algebraMap Γ(C, c.W) Ω a := by
  let _ := Fintype.ofFinite K
  have hW := c.isAffineOpen
  have : IsDedekindDomain Γ(C, c.W) := isDedekindDomain_of_isAffineOpen (C ↘ Spec (.of K)) hW
  have hε₀ : (genericEmb (U ↘ Spec (.of K)) j).comp (algebraMap K (AlgebraicClosure K)) =
      (algebraMap Γ(C, c.W) Ω).comp (sectionsStructHom (k₀ := K) hW) := by
    rw [genericEmb_comp_algebraMap, genericStructHom_eq j hW]
  obtain ⟨ι₀, hι₀k, hι₀⟩ := exists_residueField_emb_compatible hW c.point x c.mem _ hε₀
  have : Finite (C.residueField x.1) := C.mem_finitePoints.1 x.2
  obtain ⟨i, hi⟩ := FiniteField.exists_apply_eq_pow_card_pow_of_comp_eq
    ((C ↘ Spec (.of K)).residueFieldAlgebraMap x.1)
    (hι₀k.trans (Scheme.Hom.geometricFiberPointEmb_comp_residueFieldAlgebraMap _ x).symm)
  let := ((C ↘ Spec (.of K)).residueFieldAlgebraMap x.1).toAlgebra
  have : Module.Finite K (C.residueField x.1) := Module.Finite.of_finite
  have hE : Nat.card (C.residueField x.1) =
      Fintype.card K ^ Module.finrank K (C.residueField x.1) := by
    rw [Module.natCard_eq_pow_finrank (K := K), Nat.card_eq_fintype_card]
  obtain ⟨n, -, hn⟩ := FiniteField.exists_geometricFrobeniusAlgEquivOfAlgebraic_pow_apply_eq K
    (AlgebraicClosure K) Module.finrank_pos hE ι₀ i
  obtain ⟨σ, hσ⟩ := exists_galois_genericEmb j hW
    (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K) ^ n)
  refine ⟨σ, n, hσ, fun a ↦ ?_⟩
  obtain ⟨b₀, hb₀, hb₀'⟩ := hι₀ a
  refine ⟨σ • b₀, Ideal.smul_mem_pointwise_smul σ b₀ c.point hb₀, ?_⟩
  change σ (b₀ : Ω) = _
  rw [hb₀', map_sub, hσ, hn, ← hi,
    IsScalarTower.algebraMap_apply Γ(C, c.W) C.functionField Ω, AlgEquiv.commutes]

section Weil

variable [IsCurve (U ↘ Spec (.of K))] [GeometricallyConnected (U ↘ Spec (.of K))]
  [ConnectedSpace U] (sU : Spec (.of (AlgebraicClosure K)) ⟶ U)
  (GU : Type u) [Group GU] [TopologicalSpace GU] [IsTopologicalGroup GU] [CompactSpace GU]
  [∀ P, MulAction GU ((fiber sU).obj P)] [IsFundamentalGroup (fiber sU) GU]

omit [C.Over (Spec (.of K))] [IsCurve (C ↘ Spec (.of K))]
  [GeometricallyConnected (C ↘ Spec (.of K))]
  [ConnectedSpace C] [Smooth (C ↘ Spec (.of K))] [j.IsOver (Spec (.of K))]
  [IsCurve (U ↘ Spec (.of K))] in
/-- **Galois automorphisms acting on `k̄` as a Frobenius power lie in the Weil group.** If
`σ ∘ ι = ι ∘ Φⁿ` on `k̄`, `Φ` the geometric Frobenius, then `(ρ(σ), n)` lies in the Weil group:
on the fibre at the generic point of a constant cover `U₀ ×_{k₀} Spec A`, consisting of the
`k₀`-embeddings `ψ : A ↪ Ω`, `σ` acts as the `n`-th power of the geometric Frobenius. This is
the converse of `AlgebraicGeometry.WeilGroup.genericEmb_galois`. -/
theorem mem_weilGroup_of_forall_genericEmb (σ : Gal(Ω/C.functionField)) (n : ℕ)
    (h : ∀ y, σ (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j
      (letI := Fintype.ofFinite K
       (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K) ^ n) y)) :
    (genericGaloisMap j sU GU σ, Multiplicative.ofAdd (n : ℤ)) ∈
      weilGroup (U ↘ Spec (.of K)) sU GU := by
  let _ := Fintype.ofFinite K
  rw [mem_weilGroup_iff]
  intro A y
  obtain ⟨y₀, rfl⟩ := (ConcreteCategory.bijective_of_isIso
    ((genericPath j sU).hom.app (constantCover (U ↘ Spec (.of K)) A))).2 y
  obtain ⟨ψ, hψ, rfl⟩ : ∃ ψ hψ, y₀ = constantCoverPoint j A ψ hψ :=
    ⟨_, (fiberConstantCoverEquiv (U ↘ Spec (.of K)) (genericBasePoint j) A y₀).2,
      ((fiberConstantCoverEquiv (U ↘ Spec (.of K)) (genericBasePoint j) A).symm_apply_apply
        y₀).symm⟩
  simp only [toAdd_ofAdd, zpow_natCast]
  rw [genericGaloisMap, galoisToFundamentalGroup_smul, galoisToAut_constantCoverPoint,
    geometricFrobenius_pow_path, geometricFrobenius_pow_constantCoverPoint]
  congr 1
  refine constantCoverPoint_congr j A (RingHom.ext fun a ↦ ?_) _ _
  let := (genericStructHom (U ↘ Spec (.of K)) j).toAlgebra
  let ψK : A.1 →ₐ[K] Ω := { toRingHom := ψ, commutes' := RingHom.congr_fun hψ }
  set b := ((A.frobenius.symm ^ n : A.1 ≃ₐ[K] A.1)) a
  have hab : a = b ^ (Nat.card K ^ n) := by
    have hinv : (A.frobenius.symm ^ n : A.1 ≃ₐ[K] A.1) = (A.frobenius ^ n)⁻¹ := by
      rw [← AlgEquiv.aut_inv, inv_pow]
    rw [← FiniteEtaleAlgebra.frobenius_pow_apply]
    change a = (A.frobenius ^ n) ((A.frobenius.symm ^ n : A.1 ≃ₐ[K] A.1) a)
    rw [hinv, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
  obtain ⟨c, hc⟩ := exists_genericEmb_eq_of_isIntegral j (z := ψ b)
    ((Algebra.IsIntegral.isIntegral (R := K) b).map ψK)
  change σ (ψ a) = ψ b
  rw [hab, map_pow, ← hc, ← map_pow, h, geometricFrobeniusAlgEquivOfAlgebraic_pow_apply_pow]

variable [SmoothOfRelativeDimension 1 (C ↘ Spec (.of K))]
  {sC : Spec (.of (AlgebraicClosure K)) ⟶ C} (τ : fiber (sU ≫ j) ≅ fiber sC)
  (GC : Type u) [Group GC] [TopologicalSpace GC] [IsTopologicalGroup GC] [CompactSpace GC]
  [∀ P, MulAction GC ((fiber sC).obj P)] [IsFundamentalGroup (fiber sC) GC]

omit [IsCurve (U ↘ Spec (.of K))] in
/-- A compatible Galois conjugate of a chart gives a boundary neighbourhood for the conjugated
Frobenius lift. -/
lemma nonempty_boundaryChart_conjugate (x : C.finitePoints) (hz : x.1 ∉ Set.range j.base)
    (c : BoundaryChart (C ↘ Spec (.of K)) j x.1) (σF : Gal(Ω/C.functionField))
    (hσF : σF • c.point = c.point)
    (hFk : ∀ y, σF (genericEmb (U ↘ Spec (.of K)) j y) = genericEmb (U ↘ Spec (.of K)) j
      (letI := Fintype.ofFinite K
       (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K) ^
        (C ↘ Spec (.of K)).degreeOver x.1) y)) :
    ∃ (σ : Gal(Ω/C.functionField)) (n : ℤ),
      (genericGaloisMap j sU GU σ, Multiplicative.ofAdd n) ∈
        weilGroup (U ↘ Spec (.of K)) sU GU ∧
      Nonempty (BoundaryNeighbourhood (K := K) j ((σ • c.point).inertia Gal(Ω/C.functionField))
        (σ * σF * σ⁻¹) x) := by
  let _ := Fintype.ofFinite K
  let : MulSemiringAction Gal(Ω/C.functionField) (integralClosure Γ(C, c.W) Ω) := inferInstance
  let : MulAction Gal(Ω/C.functionField) (Ideal (integralClosure Γ(C, c.W) Ω)) := inferInstance
  obtain ⟨σ, n, hσ, hQ⟩ := exists_boundaryChart_galois_compatible j x c
  refine ⟨σ, n, mem_weilGroup_of_forall_genericEmb j sU GU σ n hσ, ?_⟩
  have : (σ • c.point).IsMaximal := by
    rw [Ideal.pointwise_smul_eq_comap]
    exact Ideal.comap_isMaximal_of_surjective _
      (MulSemiringAction.toRingEquiv _ _ σ⁻¹).surjective
  set Φ := FiniteField.geometricFrobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)
  have hσinv (y : AlgebraicClosure K) : σ⁻¹ (genericEmb (U ↘ Spec (.of K)) j y) =
      genericEmb (U ↘ Spec (.of K)) j ((Φ ^ n)⁻¹ y) := by
    have h := hσ ((Φ ^ n)⁻¹ y)
    rw [← AlgEquiv.mul_apply (Φ ^ n), mul_inv_cancel, AlgEquiv.one_apply] at h
    rw [← h, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
  refine nonempty_boundaryNeighbourhood_of_compatible j hz c x rfl (σ • c.point) hQ
    (σ * σF * σ⁻¹) ?_ ?_
  · change (σ * σF * σ⁻¹) • (σ • c.point) = σ • c.point
    rw [mul_smul, mul_smul, inv_smul_smul, hσF]
  · intro y
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hσinv, hFk, hσ, ← AlgEquiv.mul_apply,
      ← AlgEquiv.mul_apply, (Commute.pow_pow_self Φ n _).eq, mul_assoc, mul_inv_cancel, mul_one]

omit [IsCurve (U ↘ Spec (.of K))] in
/-- **Strictly henselian neighbourhoods of boundary points exist** (blueprint
`lem-wf-boundary-stalk-invariants`). For a boundary point `z` with closed point `x`, there is
`σ ∈ Gal(Ω / k(C))` whose image in `π₁(U₀)` lies in the Weil group (with some degree `n`) such that
the conjugate `σ • Q_z` of the chosen point `Q_z` over `z` gives a strictly henselian
neighbourhood of the boundary point, for its inertia group `σ I_z σ⁻¹` and the conjugate
`σ σ_F σ⁻¹` of the residue Frobenius lift. The element `σ` acts on `k̄ ⊆ Ω` by a power of the
geometric Frobenius, chosen so that `σ • Q_z` induces on `κ(x)` the embedding of `x̄`. -/
theorem exists_boundaryNeighbourhood_conj (z : ↥((Set.range j.base)ᶜ)) (x : C.finitePoints)
    (hx : x.1 = z.1) :
    ∃ (σ : Gal(Ω/C.functionField)) (n : ℤ),
      (genericGaloisMap j sU GU σ, Multiplicative.ofAdd n) ∈
        weilGroup (U ↘ Spec (.of K)) sU GU ∧
      Nonempty (BoundaryNeighbourhood (K := K) j
        ((σ • (boundaryChart (p := C ↘ Spec (.of K)) j z).point).inertia
          Gal(Ω/C.functionField))
        (σ * boundaryFrobeniusLift (p := C ↘ Spec (.of K)) j sU GU τ GC z * σ⁻¹) x) := by
  obtain ⟨z, hz⟩ := z
  obtain ⟨x, hxf⟩ := x
  simp only at hx
  subst hx
  exact nonempty_boundaryChart_conjugate j sU GU ⟨x, hxf⟩ hz
    (boundaryChart (p := C ↘ Spec (.of K)) j ⟨x, hz⟩)
    (boundaryFrobeniusLift (p := C ↘ Spec (.of K)) j sU GU τ GC ⟨x, hz⟩)
    (boundaryFrobeniusLift_mem_stabilizer (p := C ↘ Spec (.of K)) j sU GU τ GC ⟨x, hz⟩)
    (genericEmb_galois j sU GU _ _
      (mem_weilGroup_boundaryFrobeniusLift (p := C ↘ Spec (.of K)) j sU GU
        (comp_over j _) τ GC ⟨x, hz⟩))

