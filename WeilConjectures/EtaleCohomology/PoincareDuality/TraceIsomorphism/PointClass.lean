/-!
# All rational points have the same class

Let `a : X ⟶ Spec k` be smooth and proper of pure relative dimension `d` over an algebraically
closed field `k`, with `X` connected, and let `Λ` be a self-injective finite coefficient ring.
For a `k`-point `x` of `X`, write `⌊x⌋ ∈ H^{2d}(X, Λ(d))` for the fundamental class
`[x ⊂ X] ∈ H^{2d}_x(X, Λ(d))` with its supports forgotten. Then `⌊x⌋ = ⌊y⌋` for any two
`k`-points (`AlgebraicGeometry.Etale.fundamentalClass_comp_counit_eq_of_section`).

The point `y` is the base change of the diagonal `Δ : X ⟶ X ×_k X` along the section
`j_y = (𝟙, a ≫ y)` of the first projection, so `⌊y⌋` is the restriction of `⌊Δ⌋` along `j_y`
(`AlgebraicGeometry.Etale.restrictSupportedClass_fundamentalClass_of_isPullback`), and restriction
along `j_y` does not depend on `y` (`AlgebraicGeometry.Etale.pullbackLiftSectionRestrict_eq`):
by proper base change it is evaluation of global sections at the point `y`, which is determined
by `H^0(X, Λ) = Λ` (`AlgebraicGeometry.Etale.injective_comp_unit_tateObject_shift`).

In codimension `d = 0` a regular immersion is an isomorphism
(`AlgebraicGeometry.IsRegularImmersion.isIso_of_zero`) and there is only one point.
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

/-- A regular closed immersion of codimension `0` into a reduced scheme is an isomorphism: its
ideal is locally generated by the empty sequence, so it vanishes. -/
lemma IsRegularImmersion.isIso_of_zero {X Z : Scheme.{u}} [IsReduced X] (i : Z ⟶ X)
    [IsRegularImmersion 0 i] : IsIso i := by
  rw [IsClosedImmersion.isIso_iff_ker_eq_bot, ← Scheme.IdealSheafData.support_eq_top_iff,
    eq_top_iff]
  intro p _
  obtain ⟨U, hpU, r, hr, -, hI⟩ := IsRegularImmersion.exists_isWeaklyRegular_generators (c := 0)
    (i := i) p
  rw [List.length_eq_zero_iff] at hr
  subst hr
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem hpU, ← hI]
  simp [Ideal.ofList]

namespace Etale

attribute [local instance] HasInvertibleExponent.opens

section Coherence

variable {Λ : Type (u + 1)} [CommRing Λ] [HasTateTwist Λ] {X S : Scheme.{u}} (a : X ⟶ S)

/-- Restriction along the section `j_y` of the identification `Λ(m)[2m] ≅ Lp₂^* La^* Λ_S(m)[2m]`
on `X ×_S X` is the identification `Λ(m)[2m] ≅ La^* Λ_S(m)[2m]` on `X`. -/
lemma pullbackLiftSection_tateShiftIso [HasInvertibleExponent Λ X] [HasInvertibleExponent Λ S]
    [HasInvertibleExponent Λ (pullback a a)] (y : S ⟶ X) (hy : y ≫ a = 𝟙 S) (m : ℤ) :
    (leftDerivedUpperStarTateShiftIso Λ (pullbackLiftSection a y hy) m).inv ≫
      (L((pullbackLiftSection a y hy)^*[ModuleCat.{u + 1} Λ])).map
        ((leftDerivedUpperStarTateShiftIso Λ (pullback.snd a a ≫ a) m).inv ≫
          (leftDerivedUpperStarComp _ (pullback.snd a a) a).hom.app _) ≫
      ((leftDerivedUpperStarComp _ (pullbackLiftSection a y hy) (pullback.snd a a)).inv.app _ ≫
        (leftDerivedUpperStarComp _ a y (pullbackLiftSection a y hy ≫ pullback.snd a a)
          (pullbackLiftSection_snd a y hy)).hom.app _) ≫
      (L((a)^*[ModuleCat.{u + 1} Λ])).map
        ((leftDerivedUpperStarCompSectionIso _ y a hy).hom.app _) =
    (leftDerivedUpperStarTateShiftIso Λ a m).inv := by
  have he : a = (pullbackLiftSection a y hy) ≫ pullback.snd a a ≫ a := by
    rw [pullbackLiftSection_snd_assoc, hy, Category.comp_id]
  have hT := congrArg Iso.inv (leftDerivedUpperStarTateShiftIso_comp Λ (pullbackLiftSection a y hy)
    (pullback.snd a a ≫ a)
    a he m)
  simp only [Iso.trans_inv, Functor.mapIso_inv, Iso.app_inv] at hT
  set Q := (tateObject Λ S m)⟦2 * m⟧
  have A₁ := leftDerivedUpperStarComp_assoc'_app (ModuleCat.{u + 1} Λ) (pullbackLiftSection a y hy)
    (pullback.snd a a) a
    ((pullbackLiftSection a y hy) ≫ pullback.snd a a) (pullback.snd a a ≫ a) a rfl rfl
    (by rw [Category.assoc, ← he]) Q
  have A₂ := leftDerivedUpperStarComp_assoc'_app (ModuleCat.{u + 1} Λ) a y a
    ((pullbackLiftSection a y hy) ≫ pullback.snd a a) (𝟙 S) a (pullbackLiftSection_snd a y hy)
    hy.symm
    (by rw [Category.assoc, ← he]) Q
  have U := leftDerivedUpperStarComp_id_right_hom_app (ModuleCat.{u + 1} Λ) a Q
  rw [hT]
  simp only [Functor.map_comp, Category.assoc, cancel_epi]
  rw [← cancel_epi ((leftDerivedUpperStarComp _ (pullbackLiftSection a y hy)
      (pullback.snd a a ≫ a) a he).hom.app Q),
    Iso.hom_inv_id_app, reassoc_of% A₁, Iso.hom_inv_id_app_assoc, ← reassoc_of% A₂]
  simp only [leftDerivedUpperStarCompSectionIso, Iso.trans_hom, Iso.symm_hom,
    NatTrans.comp_app, Functor.map_comp]
  rw [← Functor.map_comp_assoc, Iso.hom_inv_id_app]
  simpa using U


end Coherence

/-- Forgetting the supports of a restricted class: the restriction of supports followed by the
counit is the restriction of the class with forgotten supports. -/
lemma restrictSupportedClass_comp_counit {Λ : Type (u + 1)} [CommRing Λ] {U X Z Z' : Scheme.{u}}
    (e : U ⟶ X) (i : Z ⟶ X) (i' : Z' ⟶ U) [IsClosedImmersion i] [IsClosedImmersion i']
    (g : Z' ⟶ Z) (hg : IsPullback g i' i e) {K L : DerivedCategoryModule Λ X}
    {K' L' : DerivedCategoryModule Λ U} (σ : K' ⟶ (L((e)^*[ModuleCat.{u + 1} Λ])).obj K)
    (τ : (L((e)^*[ModuleCat.{u + 1} Λ])).obj L ≅ L')
    (γ : K ⟶ (R(i)_![ModuleCat.{u + 1} Λ]).obj ((R(i)^![ModuleCat.{u + 1} Λ]).obj L)) :
    restrictSupportedClass (ModuleCat.{u + 1} Λ) e i i' g hg σ τ γ ≫
        (rightDerivedUpperShriekAdjunction _ i').counit.app L' =
      σ ≫ (L((e)^*[ModuleCat.{u + 1} Λ])).map
        (γ ≫ (rightDerivedUpperShriekAdjunction _ i).counit.app L) ≫ τ.hom := by
  have h := (existsUnique_supportedRestriction (ModuleCat.{u + 1} Λ) e i i' g hg L L'
    τ).exists.choose_spec
  rw [restrictSupportedClass, Category.assoc, Category.assoc]
  erw [h]
  rw [Functor.map_comp_assoc]

/-- **The class of a section generates.** Let `x` be a section of `a : X ⟶ S` which is a closed
immersion, and `γ : Λ_X ⟶ Rx_! Rx^! L` a class supported on `x` whose adjoint
`Λ_S ⟶ Rx^! L` (`AlgebraicGeometry.Etale.supportedClassMap`) is an isomorphism. Then its image
`Λ_S ⟶ Ra_* Λ_X ⟶ Ra_* Rx_! Rx^! L` in `H^0(S, Ra_* Rx_! Rx^! L)` is an isomorphism: up to the
forget-supports isomorphism it is the unit of `La^* ⋙ Lx^* ⊣ Rx_* ⋙ Ra_*`, whose left adjoint
is `L(x ≫ a)^* = 𝟭`, followed by `Ra_* Rx_*` of the adjoint of `γ`. -/
lemma isIso_unit_comp_map_of_isIso_supportedClassMap {Λ : Type (u + 1)} [CommRing Λ] [Finite Λ]
    {X S : Scheme.{u}} (a : X ⟶ S) (x : S ⟶ X) [IsClosedImmersion x] (hx : x ≫ a = 𝟙 S)
    {L : DerivedCategoryModule Λ X} {U : DerivedCategoryModule Λ S}
    (e : (L((a)^*[ModuleCat.{u + 1} Λ])).obj U ≅ constantComplex Λ X)
    (γ : constantComplex Λ X ⟶
      (R(x)_![ModuleCat.{u + 1} Λ]).obj ((R(x)^![ModuleCat.{u + 1} Λ]).obj L))
    (h : IsIso (supportedClassMap Λ x γ)) :
    IsIso ((derivedUpperStarLowerStarAdjunction _ a).unit.app U ≫
      (R((a)_*[ModuleCat.{u + 1} Λ])).map (e.hom ≫ γ)) := by
  let c := HasCompactification.compactification x
  let adjGI := (derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) c.g).comp
    (derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) c.i)
  let adjC := (derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) a).comp adjGI
  have hu : IsIso adjC.unit := adjC.isIso_unit_of_iso_id
    (Functor.isoWhiskerLeft _ (leftDerivedUpperStarComp _ c.i c.g x c.comm).symm ≪≫
      leftDerivedUpperStarCompSectionIso _ x a hx)
  let F := (rightDerivedLowerShriekToLowerStarComp (ModuleCat.{u + 1} Λ) x).app
    ((R(x)^![ModuleCat.{u + 1} Λ]).obj L)
  have hfc : γ ≫ F = adjGI.unit.app _ ≫
      (R((c.i)_*[ModuleCat.{u + 1} Λ]) ⋙ R((c.g)_*[ModuleCat.{u + 1} Λ])).map
        ((compactificationConstantComplexIso Λ x).hom ≫ supportedClassMap Λ x γ) := by
    rw [supportedClassMap, Iso.hom_inv_id_assoc, rightDerivedLowerShriekTranspose]
    exact ((Adjunction.homEquiv_unit _ _ _ _).symm.trans (Equiv.apply_symm_apply _ _)).symm
  have hn := adjGI.unit.naturality e.hom
  simp only [Functor.id_map, Functor.comp_map] at hn
  have inner : e.hom ≫ γ =
      adjGI.unit.app _ ≫
        (R((c.i)_*[ModuleCat.{u + 1} Λ]) ⋙ R((c.g)_*[ModuleCat.{u + 1} Λ])).map
          ((L((c.g)^*[ModuleCat.{u + 1} Λ]) ⋙ L((c.i)^*[ModuleCat.{u + 1} Λ])).map
            e.hom ≫
          (compactificationConstantComplexIso Λ x).hom ≫ supportedClassMap Λ x γ) ≫ inv F := by
    rw [← cancel_mono F]
    simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    rw [hfc]
    simp only [Functor.comp_map, Functor.map_comp] at hn ⊢
    rw [reassoc_of% hn]
  have key : (derivedUpperStarLowerStarAdjunction _ a).unit.app U ≫
      (R((a)_*[ModuleCat.{u + 1} Λ])).map (e.hom ≫ γ) =
      adjC.unit.app _ ≫ (R((a)_*[ModuleCat.{u + 1} Λ])).map
        ((R((c.i)_*[ModuleCat.{u + 1} Λ]) ⋙ R((c.g)_*[ModuleCat.{u + 1} Λ])).map
          ((L((c.g)^*[ModuleCat.{u + 1} Λ]) ⋙ L((c.i)^*[ModuleCat.{u + 1} Λ])).map
            e.hom ≫
          (compactificationConstantComplexIso Λ x).hom ≫ supportedClassMap Λ x γ) ≫ inv F) := by
    rw [inner]
    simp only [adjC, adjGI, Adjunction.comp_unit_app, Functor.map_comp, Category.assoc]
  rw [key]
  infer_instance

section PointClass

variable (Λ : Type (u + 1)) [CommRing Λ] [Finite Λ] [HasKummerClass Λ]
  [HasKummerClass.IsNormalized Λ] {k : Type u} [Field k] [IsAlgClosed k]
  [HasInvertibleExponent Λ (Spec (.of k))] {X : Scheme.{u}} [HasInvertibleExponent Λ X] {d : ℕ}
  (a : X ⟶ Spec (.of k)) [IsProper a] [SmoothOfRelativeDimension d a]

omit [HasInvertibleExponent Λ (Spec (.of k))] in
/-- The class `⌊y⌋` of a `k`-point is the restriction along `j_y = (𝟙, a ≫ y)` of the class
`⌊Δ⌋` of the diagonal, supports forgotten. -/
lemma fundamentalClass_comp_counit_eq_restrict [NeZero d] (y : Spec (.of k) ⟶ X)
    [IsRegularImmersion d y] (hy : y ≫ a = 𝟙 _) :
    haveI := SmoothOfRelativeDimension.smooth d a
    haveI : HasInvertibleExponent Λ (pullback a a) := .of_hom (pullback.fst a a)
    fundamentalClass Λ d y a IsRegular.isRegularLocalRing_stalk ≫
        (rightDerivedUpperShriekAdjunction _ y).counit.app _ =
      (leftDerivedUpperStarConstantComplexIso Λ (pullbackLiftSection a y hy)).inv ≫
        (L((pullbackLiftSection a y hy)^*[ModuleCat.{u + 1} Λ])).map
          (fundamentalClass Λ d (pullback.diagonal a) (pullback.fst a a ≫ a)
              (Smooth.isRegularLocalRing_stalk a) ≫
            (rightDerivedUpperShriekAdjunction _ (pullback.diagonal a)).counit.app _) ≫
        (leftDerivedUpperStarTateShiftIso Λ (pullbackLiftSection a y hy) d).hom := by
  have := SmoothOfRelativeDimension.smooth d a
  have : HasInvertibleExponent Λ (pullback a a) := .of_hom (pullback.fst a a)
  have : Smooth (pullbackLiftSection a y hy ≫ pullback.fst a a ≫ a) := by
    rw [pullbackLiftSection_fst_assoc]
    infer_instance
  have h := restrictSupportedClass_fundamentalClass_of_isPullback Λ d (pullback.diagonal a)
    (pullback.fst a a ≫ a) (Smooth.isRegularLocalRing_stalk a) (pullbackLiftSection a y hy) y y
    (isPullback_diagonal_pullbackLiftSection a y hy) IsRegular.isRegularLocalRing_stalk
  rw [fundamentalClass_congr Λ d y (pullbackLiftSection_fst_assoc a y hy a)] at h
  rw [← h, restrictSupportedClass_comp_counit]

/-- The restriction along `j_y` of the class of the diagonal, read through the Tate object
`Λ_k(d)[2d]` of the base, is the class `⌊y⌋` up to isomorphisms independent of `y`. -/
lemma pullbackLiftSectionRestrict_fundamentalClass [NeZero d] (y : Spec (.of k) ⟶ X)
    [IsRegularImmersion d y] (hy : y ≫ a = 𝟙 _) :
    haveI := SmoothOfRelativeDimension.smooth d a
    haveI : HasInvertibleExponent Λ (pullback a a) := .of_hom (pullback.fst a a)
    pullbackLiftSectionRestrict a Λ y hy
        ((leftDerivedUpperStarConstantComplexIso Λ (pullback.fst a a)).hom ≫
          (fundamentalClass Λ d (pullback.diagonal a) (pullback.fst a a ≫ a)
              (Smooth.isRegularLocalRing_stalk a) ≫
            (rightDerivedUpperShriekAdjunction _ (pullback.diagonal a)).counit.app _) ≫
          (leftDerivedUpperStarTateShiftIso Λ (pullback.snd a a ≫ a) d).inv ≫
          (leftDerivedUpperStarComp _ (pullback.snd a a) a).hom.app _) =
      ((leftDerivedUpperStarId _ X).inv.app _ ≫
          (leftDerivedUpperStarConstantComplexIso Λ (𝟙 X)).hom) ≫
        (fundamentalClass Λ d y a IsRegular.isRegularLocalRing_stalk ≫
          (rightDerivedUpperShriekAdjunction _ y).counit.app _) ≫
        (leftDerivedUpperStarTateShiftIso Λ a d).inv := by
  have := SmoothOfRelativeDimension.smooth d a
  have : HasInvertibleExponent Λ (pullback a a) := .of_hom (pullback.fst a a)
  rw [fundamentalClass_comp_counit_eq_restrict Λ a y hy,
    ← pullbackLiftSection_tateShiftIso a y hy (d : ℤ),
    leftDerivedUpperStarConstantComplexIso_comp Λ (pullbackLiftSection a y hy) (pullback.fst a a)
      (𝟙 X) (pullbackLiftSection_fst a y hy).symm]
  simp only [pullbackLiftSectionRestrict, leftDerivedUpperStarCompSectionIso, Iso.trans_hom,
    Iso.trans_inv, Iso.symm_inv, Iso.app_hom, Functor.mapIso_hom, NatTrans.comp_app,
    Functor.map_comp, Category.assoc, Iso.hom_inv_id_assoc]

/-- **All `k`-points have the same class.** For `a : X ⟶ Spec k` smooth and proper of pure
relative dimension `d` over the algebraically closed `k`, with `X` connected, and a
self-injective coefficient ring `Λ`, the fundamental classes of any two `k`-points `x`, `y` of
`X` agree in `H^{2d}(X, Λ(d))` once their supports are forgotten.

The point `y` is the base change of the diagonal along `j_y = (𝟙, a ≫ y)`, so its class is the
restriction of that of the diagonal along `j_y`
(`AlgebraicGeometry.Etale.pullbackLiftSectionRestrict_fundamentalClass`), and that restriction
does not depend on `y` (`AlgebraicGeometry.Etale.pullbackLiftSectionRestrict_eq`). In
codimension `0` the points are isomorphisms, hence equal. -/
theorem fundamentalClass_comp_counit_eq_of_section [Module.Injective Λ Λ] [ConnectedSpace X]
    (x y : Spec (.of k) ⟶ X) [IsRegularImmersion d x] [IsRegularImmersion d y]
    (hx : x ≫ a = 𝟙 _) (hy : y ≫ a = 𝟙 _) :
    haveI := SmoothOfRelativeDimension.smooth d a
    fundamentalClass Λ d x a IsRegular.isRegularLocalRing_stalk ≫
        (rightDerivedUpperShriekAdjunction _ x).counit.app _ =
      fundamentalClass Λ d y a IsRegular.isRegularLocalRing_stalk ≫
        (rightDerivedUpperShriekAdjunction _ y).counit.app _ := by
  have := SmoothOfRelativeDimension.smooth d a
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · have : ∀ z : X, _root_.IsReduced (X.presheaf.stalk z) := fun z ↦
      have := Smooth.isRegularLocalRing_stalk a z
      inferInstance
    have : IsReduced X := isReduced_of_isReduced_stalk X
    have := IsRegularImmersion.isIso_of_zero x
    have := IsRegularImmersion.isIso_of_zero y
    obtain rfl : y = x := by
      have ha : a = inv x := IsIso.eq_inv_of_hom_inv_id hx
      rw [ha] at hy
      rw [← cancel_mono (inv x), hy, IsIso.hom_inv_id]
    rfl
  · have : NeZero d := ⟨hd.ne'⟩
    have : HasInvertibleExponent Λ (pullback a a) := .of_hom (pullback.fst a a)
    have h := pullbackLiftSectionRestrict_eq a Λ x y hx hy
      (injective_comp_unit_tateObject_shift Λ a d (2 * d))
      ((leftDerivedUpperStarConstantComplexIso Λ (pullback.fst a a)).hom ≫
          (fundamentalClass Λ d (pullback.diagonal a) (pullback.fst a a ≫ a)
              (Smooth.isRegularLocalRing_stalk a) ≫
            (rightDerivedUpperShriekAdjunction _ (pullback.diagonal a)).counit.app _) ≫
          (leftDerivedUpperStarTateShiftIso Λ (pullback.snd a a ≫ a) d).inv ≫
          (leftDerivedUpperStarComp _ (pullback.snd a a) a).hom.app _)
    rw [pullbackLiftSectionRestrict_fundamentalClass Λ a x hx,
      pullbackLiftSectionRestrict_fundamentalClass Λ a y hy] at h
    simpa only [cancel_epi, cancel_mono] using h

end PointClass

end Etale

end AlgebraicGeometry
