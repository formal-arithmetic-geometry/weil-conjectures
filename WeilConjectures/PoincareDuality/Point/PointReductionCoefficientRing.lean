module
public import WeilConjectures.PoincareDuality.Point.PointSectionsDerivedReductionData
import all WeilConjectures.AlgebraicGeometry.Standard.StandardQuotientsPerfectSupplement

/-! # The normalized principal quotient of lifted integral coefficients
(blueprint: lem-pod-point-reduction-coefficient-ring) -/
@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory
namespace WeilConjectures

/-- The actual lifted quotient is surjective, its kernel is generated by the indicated
uniformizer power, and that power is regular on the integral ring.

Proof: the DVR uniformizer is nonzero. Cancel its positive power in the subring of the
coefficient field. Surjectivity is quotient surjectivity; kernel membership is divisibility
by the generator of the principal ideal. Transport all three assertions through ULift.
Source: the coefficient DVR and Stacks Tag 05RT; original blueprint step 1.
(blueprint: lem-pod-point-reduction-coefficient-ring) -/
theorem pointReductionQuotient_properties (l : ℕ) [Fact l.Prime]
    (E : Type u) [Field E] [Algebra ℚ_[l] E] [FiniteDimensional ℚ_[l] E] (n : ℕ) :
    Function.Injective (fun x : ULift.{u + 1, u} (Padic.coefficientExtensionIntegers l E) ↦
      ULift.up (Padic.coefficientExtensionUniformizer l E) ^ (n + 1) * x) ∧
    Function.Surjective (pointReductionQuotient l E n) ∧
    ∀ x : ULift.{u + 1, u} (Padic.coefficientExtensionIntegers l E),
      pointReductionQuotient l E n x = 0 ↔ ∃ y,
        ULift.up (Padic.coefficientExtensionUniformizer l E) ^ (n + 1) * y = x := by
  refine ⟨?_, ?_, ?_⟩
  · intro x y hxy
    apply ULift.ext
    exact mul_left_cancel₀ (pow_ne_zero _
      (AlgebraicGeometry.uniformizer_ne_zero l E)) (congrArg ULift.down hxy)
  · intro x
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective x.down
    exact ⟨ULift.up y, ULift.ext hy⟩
  · intro x
    change ULift.up (Ideal.Quotient.mk _ x.down) = 0 ↔ _
    rw [ULift.ext_iff]
    change Ideal.Quotient.mk _ x.down = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem, Padic.coefficientExtensionIdeal,
      Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨y, hy⟩
      exact ⟨ULift.up y, ULift.ext hy.symm⟩
    · rintro ⟨y, hy⟩
      exact ⟨y.down, (congrArg ULift.down hy).symm⟩

end WeilConjectures
