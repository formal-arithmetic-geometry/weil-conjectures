module

public import Mathlib.AlgebraicGeometry.Geometrically.Irreducible
public import Mathlib.RingTheory.Polynomial.Basic
public import WeilConjectures.DeligneLaumon.AffineLine.Defs
public import WeilConjectures.Mathlib.AlgebraicGeometry.Geometrically.Connected
public import WeilConjectures.Mathlib.AlgebraicGeometry.Geometrically.Irreducible
public import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import WeilConjectures.Mathlib.AlgebraicGeometry.Noetherian

/-!
# Dense opens of the affine line

A dense open `U₀` of the affine line `𝔸¹_{k₀}` over a field is a smooth geometrically connected
affine curve: it is smooth of relative dimension one and geometrically irreducible as a nonempty
open of `𝔸¹_{k₀}`, and it is affine because every open subset of `Spec k₀[x]` is a basic open,
`k₀[x]` being a principal ideal domain.

## Main statements

- `AlgebraicGeometry.IsAffineOpen.of_isPrincipalIdealRing`: every open of an affine scheme with
  a principal ideal ring of global sections is affine.
- `AlgebraicGeometry.affineLine.isAffineOpen`: every open of `𝔸¹_{k₀}` is affine.
- Instances on the open `U₀` of a `AlgebraicGeometry.WeilSheaf.LisseOnDenseOpen`: it is affine,
  of finite type, smooth of relative dimension one and geometrically irreducible, hence
  geometrically connected, over `k₀`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

/-- Every open of an affine scheme whose ring of global sections is a principal ideal ring is
affine: its complement is the zero locus of an ideal, which is generated by one section `f`, so
the open is the basic open of `f`. -/
theorem IsAffineOpen.of_isPrincipalIdealRing {X : Scheme.{u}} [IsAffine X]
    [IsPrincipalIdealRing Γ(X, ⊤)] (V : X.Opens) : IsAffineOpen V := by
  obtain ⟨I, hI⟩ := (Scheme.eq_zeroLocus_of_isClosed_of_isAffine (X := X) _).1
    V.isOpen.isClosed_compl
  have hV : V = X.basicOpen (Submodule.IsPrincipal.generator I) := by
    refine TopologicalSpace.Opens.ext (compl_injective ?_)
    rw [hI, ← Scheme.zeroLocus_singleton,
      ← Scheme.zeroLocus_span X {Submodule.IsPrincipal.generator I}, Ideal.span_singleton_generator]
  rw [hV]
  exact (isAffineOpen_top X).basicOpen _

variable {k₀ : Type u} [Field k₀]

/-- The ring of global functions of the affine line over a field is a principal ideal ring: it is
the polynomial ring in one variable. -/
instance affineLine.isPrincipalIdealRing_Γ :
    IsPrincipalIdealRing Γ(affineLine k₀, ⊤) := by
  let e₁ : Γ(Spec (.of (MvPolynomial PUnit.{u + 1} k₀)), ⊤) ≅ Γ(affineLine k₀, ⊤) :=
    Scheme.Γ.mapIso (AffineSpace.SpecIso PUnit.{u + 1} (.of k₀)).op
  let e₂ : Γ(affineLine k₀, ⊤) ≃+* MvPolynomial PUnit.{u + 1} k₀ :=
    (e₁.symm ≪≫ Scheme.ΓSpecIso (.of (MvPolynomial PUnit.{u + 1} k₀))).commRingCatIsoToRingEquiv
  let e : Polynomial k₀ ≃+* Γ(affineLine k₀, ⊤) :=
    (MvPolynomial.uniqueAlgEquiv k₀ PUnit.{u + 1}).symm.toRingEquiv.trans e₂.symm
  exact IsPrincipalIdealRing.of_surjective e.toRingHom e.surjective

/-- Every open subscheme of the affine line over a field is affine: its complement is the zero
locus of an ideal of `k₀[x]`, which is principal, so the open is a basic open. -/
theorem affineLine.isAffineOpen (V : (affineLine k₀).Opens) : IsAffineOpen V :=
  IsAffineOpen.of_isPrincipalIdealRing V

section Opens

variable {X : Scheme.{u}} [X.Over (Spec (.of k₀))] (W : X.Opens)

/-- An open of a scheme smooth of relative dimension one over `k₀` is smooth of relative dimension
one over `k₀`. -/
theorem Scheme.Opens.smoothOfRelativeDimension_one
    [SmoothOfRelativeDimension 1 (X ↘ Spec (.of k₀))] :
    SmoothOfRelativeDimension 1 (W.toScheme ↘ Spec (.of k₀)) := by
  rw [← comp_over W.ι, ← zero_add 1]
  infer_instance

/-- A nonempty open of a geometrically irreducible `k₀`-scheme is geometrically irreducible. -/
theorem Scheme.Opens.geometricallyIrreducible [Nonempty W]
    [GeometricallyIrreducible (X ↘ Spec (.of k₀))] :
    GeometricallyIrreducible (W.toScheme ↘ Spec (.of k₀)) := by
  rw [← comp_over W.ι]
  exact GeometricallyIrreducible.comp_of_isOpenImmersion W.ι _

/-- An open of a `k₀`-scheme locally of finite type is locally of finite type over `k₀`. -/
theorem Scheme.Opens.locallyOfFiniteType [LocallyOfFiniteType (X ↘ Spec (.of k₀))] :
    LocallyOfFiniteType (W.toScheme ↘ Spec (.of k₀)) := by
  rw [← comp_over W.ι]
  infer_instance

/-- An open of a separated `k₀`-scheme is separated over `k₀`. -/
theorem Scheme.Opens.isSeparated [IsSeparated (X ↘ Spec (.of k₀))] :
    IsSeparated (W.toScheme ↘ Spec (.of k₀)) := by
  rw [← comp_over W.ι]
  infer_instance

/-- The geometric fiber of a geometrically irreducible smooth `k₀`-scheme is irreducible: the
structure morphism is universally open. -/
theorem irreducibleSpace_geometricFiber_of_smooth (Y : Scheme.{u}) [Y.Over (Spec (.of k₀))]
    [GeometricallyIrreducible (Y ↘ Spec (.of k₀))] [Smooth (Y ↘ Spec (.of k₀))] :
    IrreducibleSpace (Y ↘ Spec (.of k₀)).geometricFiber := by
  have : IrreducibleSpace (Scheme.specAlgebraicClosure k₀).left :=
    inferInstanceAs (IrreducibleSpace (Spec (.of (AlgebraicClosure k₀))))
  exact inferInstanceAs (IrreducibleSpace ↥(pullback (C := Scheme.{u})
    (Y ↘ Spec (.of k₀)) (Scheme.specAlgebraicClosure k₀).hom))

end Opens

namespace WeilSheaf.LisseOnDenseOpen

variable [Finite k₀] {l : ℕ} [Fact l.Prime] [Fact (ringChar k₀ ≠ l)]
  (D : LisseOnDenseOpen k₀ l)

/-- The structure morphism of `U₀` factors through the open immersion `j : U₀ ↪ 𝔸¹`. -/
theorem over_eq : D.U ↘ Spec (.of k₀) = D.j ≫ affineLine k₀ ↘ Spec (.of k₀) :=
  (comp_over D.j (Spec (.of k₀))).symm

/-- The dense open `U₀` is affine, as an open of the affine line. -/
instance isAffine : IsAffine D.U :=
  have : IsAffine D.j.opensRange := affineLine.isAffineOpen _
  .of_isIso D.j.isoOpensRange.hom

/-- The dense open `U₀` is of finite type over `k₀`, as an open of the affine line. -/
instance locallyOfFiniteType : LocallyOfFiniteType (D.U ↘ Spec (.of k₀)) := by
  rw [over_eq]
  infer_instance

/-- The dense open `U₀` is smooth of relative dimension one over `k₀`, as an open of `𝔸¹`. -/
instance smoothOfRelativeDimension :
    SmoothOfRelativeDimension 1 (D.U ↘ Spec (.of k₀)) := by
  rw [over_eq, ← zero_add 1]
  have : SmoothOfRelativeDimension 1 (affineLine k₀ ↘ Spec (.of k₀)) := by
    simpa using AffineSpace.smoothOfRelativeDimension_over PUnit.{u + 1} (Spec (.of k₀))
  infer_instance

/-- The dense open `U₀` is nonempty: `j` is dominant and the affine line is nonempty. -/
theorem nonempty_U : Nonempty D.U :=
  D.j.denseRange.nonempty_iff.2
    ⟨((affineLine k₀ ↘ Spec (.of k₀)).surjective (IsLocalRing.closedPoint k₀)).choose⟩

/-- The dense open `U₀` is geometrically irreducible over `k₀`, as a nonempty open of the
geometrically irreducible affine line. -/
instance geometricallyIrreducible : GeometricallyIrreducible (D.U ↘ Spec (.of k₀)) := by
  have : Surjective (D.j ≫ affineLine k₀ ↘ Spec (.of k₀)) := by
    refine ⟨fun y ↦ ?_⟩
    obtain ⟨x⟩ := D.nonempty_U
    exact ⟨x, Subsingleton.elim (α := Spec (.of k₀)) _ _⟩
  rw [over_eq]
  infer_instance

/-- The dense open `U₀` is geometrically connected over `k₀`. -/
instance geometricallyConnected : GeometricallyConnected (D.U ↘ Spec (.of k₀)) :=
  GeometricallyConnected.of_geometricallyIrreducible _

/-- The dense open `U₀` is separated over `k₀`, as an open of the affine line. -/
instance isSeparated : IsSeparated (D.U ↘ Spec (.of k₀)) := by
  rw [over_eq]
  infer_instance

/-- The dense open `U₀` is quasi-compact over `k₀`, as a quasi-compact open of the affine line. -/
instance quasiCompact_over : QuasiCompact (D.U ↘ Spec (.of k₀)) := by
  rw [over_eq]
  infer_instance

/-- The geometric fiber `Ū` of the dense open `U₀` is irreducible: `U₀` is geometrically
irreducible and smooth, hence universally open, over `k₀`. -/
instance irreducibleSpace_geometricFiber :
    IrreducibleSpace (D.U ↘ Spec (.of k₀)).geometricFiber := by
  have : UniversallyOpen (D.U ↘ Spec (.of k₀)) := by
    have := SmoothOfRelativeDimension.smooth 1 (D.U ↘ Spec (.of k₀))
    infer_instance
  have : IrreducibleSpace (Scheme.specAlgebraicClosure k₀).left :=
    inferInstanceAs (IrreducibleSpace (Spec (.of (AlgebraicClosure k₀))))
  exact inferInstanceAs (IrreducibleSpace ↥(pullback (C := Scheme.{u})
    (D.U ↘ Spec (.of k₀)) (Scheme.specAlgebraicClosure k₀).hom))

/-- The dense open `U₀` is irreducible. -/
instance irreducibleSpace : IrreducibleSpace D.U :=
  GeometricallyIrreducible.irreducibleSpace_of_subsingleton (f := D.U ↘ Spec (.of k₀))

/-- The dense open `U₀` is Noetherian, being of finite type over a field. -/
instance isNoetherian : IsNoetherian D.U :=
  isNoetherian_of_locallyOfFiniteType (D.U ↘ Spec (.of k₀))

/-- The dense open `U₀` is reduced, as an open of the affine line. -/
instance isReduced : IsReduced D.U :=
  isReduced_of_isOpenImmersion D.j

end WeilSheaf.LisseOnDenseOpen

end AlgebraicGeometry
