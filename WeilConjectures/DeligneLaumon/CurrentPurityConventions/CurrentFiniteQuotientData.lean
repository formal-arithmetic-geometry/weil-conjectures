module

public import WeilConjectures.DeligneLaumon.CurrentPurityConventions.Setting.CurrentPurityConventions
public import WeilConjectures.NumberTheory.Padics.CoefficientExtensionFinite

/-! # Annihilators of the current distinguished finite coefficients

Source: latest purity conventions and finite reduction of purity
(blueprint: lem-pur-current-finite-quotient-data).
-/

@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory AlgebraicGeometry

namespace WeilConjectures.CurrentPurityConventions

/-- The prime power kills the actual valuation-ring quotient and is invertible on
any scheme over the fixed field. No ramification divisibility condition is used.
Source: def-pur-conventions, distinguished quotients; finite reduction, common exponent
(blueprint: lem-pur-current-finite-quotient-data).

Proof: the extending absolute value of ell is less than one. Thus ell lies in the
maximal ideal generated by the uniformizer. Its nth power lies in the nth power
of that ideal, so its image in the quotient and its size lift vanish. The field
has characteristic p different from ell; hence ell is a unit in the field. Its
image on scheme sections and every power are units. The proof includes n=0,
where the quotient is the zero ring, and empty schemes. -/
theorem currentFiniteQuotientData (P : Setting.{u})
    (E : IntermediateField (Padic P.coefficients.l) P.coefficients.Qbar)
    [FiniteDimensional (Padic P.coefficients.l) E] (n : ℕ)
    (T : Scheme.{u}) (a : T ⟶ Spec (.of P.field.k)) :
    ((P.coefficients.l ^ n : ℕ) :
      ULift.{u + 1, u} (Padic.coefficientExtensionRing P.coefficients.l E n)) = 0 ∧
    IsUnit ((P.coefficients.l ^ n : ℕ) : Γ(T, ⊤)) := by
  constructor
  · have h := (Padic.extension_integers_dvr P.coefficients.l E
      (Padic.coefficientExtensionAbsoluteValue P.coefficients.l E)
      (spectralNorm_extends (K := Padic P.coefficients.l) (L := E))).choose_spec.choose_spec
    have hmem : (P.coefficients.l : Padic.coefficientExtensionIntegers
        P.coefficients.l E) ∈ Padic.coefficientExtensionMaximalIdeal P.coefficients.l E := by
      apply (h.2.1 _).mpr
      change Padic.coefficientExtensionAbsoluteValue P.coefficients.l E
        (P.coefficients.l : E) < 1
      rw [← map_natCast (algebraMap (Padic P.coefficients.l) E)]
      change spectralNorm (Padic P.coefficients.l) E
        (algebraMap (Padic P.coefficients.l) E P.coefficients.l) < 1
      rw [spectralNorm_extends]
      exact Padic.norm_p_lt_one
    have hgen : Ideal.span {Padic.coefficientExtensionUniformizer P.coefficients.l E} =
        Padic.coefficientExtensionMaximalIdeal P.coefficients.l E :=
      h.2.2.2.2.2.2.2.2.2.2.2.2.2.1.choose_spec
    apply ULift.down_injective
    change ((P.coefficients.l ^ n : ℕ) : Padic.coefficientExtensionIntegers
      P.coefficients.l E ⧸ Padic.coefficientExtensionIdeal P.coefficients.l E n) = 0
    rw [← map_natCast (Ideal.Quotient.mk
      (Padic.coefficientExtensionIdeal P.coefficients.l E n)),
      Ideal.Quotient.eq_zero_iff_mem, Nat.cast_pow]
    change (P.coefficients.l : Padic.coefficientExtensionIntegers P.coefficients.l E) ^ n ∈
      Ideal.span {Padic.coefficientExtensionUniformizer P.coefficients.l E} ^ n
    rw [hgen]
    exact Ideal.pow_mem_pow hmem n
  · let : Fintype P.field.k₀ := Fintype.ofFinite _
    let : Fact P.field.p.Prime := ⟨P.field.prime⟩
    let : CharP P.field.k₀ P.field.p := charP_of_card_eq_prime_pow (by
      rw [← Nat.card_eq_fintype_card, P.field.card_base, P.field.cardinality_eq])
    let : CharP P.field.k P.field.p :=
      charP_of_injective_algebraMap' P.field.k₀ P.field.p
    have hl : IsUnit (P.coefficients.l : P.field.k) :=
      isUnit_iff_ne_zero.mpr (CharP.cast_ne_zero_of_ne_of_prime _
        (Fact.out : P.coefficients.l.Prime) P.coefficients.different.symm)
    let g := (Scheme.ΓSpecIso (.of P.field.k)).inv ≫ a.appTop
    simpa only [map_natCast, Nat.cast_pow] using (hl.map g.hom).pow n

end WeilConjectures.CurrentPurityConventions
