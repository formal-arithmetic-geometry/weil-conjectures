/-! # Images generated by countably many lisse subsheaves

Source: finite-rank stabilization of the Frobenius-orbit sum in
`sk-i-dl-general-real` (blueprint: lem-zl-lisse-countable-image).
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory Limits
attribute [local instance] Abelian.hasFiniteBiproducts
open scoped AlgebraicGeometry.ProEtale
namespace AlgebraicGeometry.ProEtale

private theorem bounded_nat_function_max (d : ℕ → ℕ) (B : ℕ) (h : ∀ n, d n ≤ B) :
    ∃ n, ∀ m, d m ≤ d n := by
  induction B with
  | zero => exact ⟨0, fun m ↦ (h m).trans (Nat.zero_le _)⟩
  | succ B ih =>
    by_cases he : ∃ n, d n = B + 1
    · obtain ⟨n, hn⟩ := he
      exact ⟨n, fun m ↦ hn ▸ h m⟩
    · apply ih
      intro n
      have hn := h n
      have hne : d n ≠ B + 1 := fun hn ↦ he ⟨n, hn⟩
      omega

private theorem lisse_finite_image {l : ℕ} [Fact l.Prime]
    {Y : Scheme.{u}} [IsLocallyNoetherian Y]
    {A V : AdicSheaf l Y} (hA : IsAdicLisseSheaf A) (hV : IsAdicLisseSheaf V)
    (f : A ⟶ V) : IsAdicLisseSheaf (image f) :=
  (hV.kernel_cokernel (hA.kernel_cokernel hV f).2 (cokernel.π f)).1.of_iso
    (Abelian.imageIsoImage f)

private noncomputable abbrev stalkDimension {l : ℕ} [Fact l.Prime]
    {Y : Scheme.{u}} {K : Type u} [Field K] [IsAlgClosed K]
    (s : Spec (.of K) ⟶ Y) (A : AdicSheaf l Y) : ℕ :=
  Module.finrank (PadicAlgCl l)
    ((WeilCoefficients.toModuleCat l).obj ((geometricStalkFunctor l s).obj A))

private theorem lisse_stalk_finite {l : ℕ} [Fact l.Prime]
    {Y : Scheme.{u}} {K : Type u} [Field K] [IsAlgClosed K]
    (s : Spec (.of K) ⟶ Y) {A : AdicSheaf l Y} (hA : IsAdicLisseSheaf A) :
    FiniteDimensional (PadicAlgCl l)
      ((WeilCoefficients.toModuleCat l).obj ((geometricStalkFunctor l s).obj A)) :=
  (hA.upperStar s).isAdicConstructibleSheaf.finiteDimensional_globalSections

private theorem stalkDimension_le_of_mono {l : ℕ} [Fact l.Prime]
    {Y : Scheme.{u}} {K : Type u} [Field K] [IsAlgClosed K]
    (s : Spec (.of K) ⟶ Y) {A V : AdicSheaf l Y} (hV : IsAdicLisseSheaf V)
    (f : A ⟶ V) [Mono f] : stalkDimension s A ≤ stalkDimension s V := by
  have := lisse_stalk_finite s hV
  exact LinearMap.finrank_le_finrank_of_injective
    (f := ((WeilCoefficients.toModuleCat l).map ((geometricStalkFunctor l s).map f)).hom)
    ((ModuleCat.mono_iff_injective _).1 inferInstance)

private theorem lisse_iso_of_stalkDimension_sum_eq
    {l : ℕ} [Fact l.Prime] {Y : Scheme.{u}} [IsLocallyNoetherian Y]
    {K : Type u} [Field K] [IsAlgClosed K] {N : ℕ}
    (s : Fin N → (Spec (.of K) ⟶ Y))
    (hs : ∀ y : Y, ∃ (η : Y) (i : Fin N), η ⤳ y ∧
      η ⤳ (s i).base (IsLocalRing.closedPoint K))
    {A V : AdicSheaf l Y} (hA : IsAdicLisseSheaf A) (hV : IsAdicLisseSheaf V)
    (f : A ⟶ V) [Mono f]
    (heq : (∑ i, stalkDimension (s i) A) = ∑ i, stalkDimension (s i) V) : IsIso f := by
  have hC := (hA.kernel_cokernel hV f).2
  have hi (i : Fin N) : stalkDimension (s i) A = stalkDimension (s i) V :=
    (Finset.sum_eq_sum_iff_of_le (fun i _ ↦ stalkDimension_le_of_mono (s i) hV f)).1
      heq i (Finset.mem_univ i)
  have hz (i : Fin N) : Subsingleton
      ((Sheaf.Γ _ (WeilCoefficients.{u} l)).obj ((s i)^*[_].obj (cokernel f).X)) := by
    have := lisse_stalk_finite (s i) hA
    have := lisse_stalk_finite (s i) hV
    let ω := geometricStalkFunctor l (s i)
    have hsurj : Function.Surjective
        ((WeilCoefficients.toModuleCat l).map (ω.map f)).hom :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hi i)).1
        ((ModuleCat.mono_iff_injective _).1 inferInstance)
    have hπ : Function.Surjective (ω.map (cokernel.π f)).hom :=
      (ModuleCat.epi_iff_surjective _).1 (Functor.map_epi ω (cokernel.π f))
    have hzero : ω.map f ≫ ω.map (cokernel.π f) = 0 := by
      rw [← Functor.map_comp, cokernel.condition, Functor.map_zero]
    refine ⟨fun y y' ↦ ?_⟩
    have key (z : (WeilCoefficients.toModuleCat l).obj (ω.obj (cokernel f))) : z = 0 := by
      obtain ⟨x, rfl⟩ := hπ z
      obtain ⟨a, rfl⟩ := hsurj x
      exact congrArg (fun φ ↦ φ.hom a) hzero
    rw [key y, key y']
  have hzero : IsZero (cokernel f) :=
    hC.isZero_of_subsingleton_globalSections_upperStar K (fun y ↦ by
      obtain ⟨η, i, hη, hηi⟩ := hs y
      exact ⟨η, s i, hη, hηi, hz i⟩)
  have : Epi f := Abelian.epi_of_cokernel_π_eq_zero _ (hzero.eq_of_tgt _ _)
  exact isIso_of_mono_of_epi f

private theorem lisse_countable_image_of_detecting
    {l : ℕ} [Fact l.Prime] {Y : Scheme.{u}} [IsLocallyNoetherian Y]
    {K : Type u} [Field K] [IsAlgClosed K] {N : ℕ}
    (s : Fin N → (Spec (.of K) ⟶ Y))
    (hs : ∀ y : Y, ∃ (η : Y) (i : Fin N), η ⤳ y ∧
      η ⤳ (s i).base (IsLocalRing.closedPoint K))
    (A : ℤ → AdicSheaf l Y) (V : AdicSheaf l Y)
    (f : ∀ n, A n ⟶ V) (hA : ∀ n, IsAdicLisseSheaf (A n))
    (hV : IsAdicLisseSheaf V) : IsAdicLisseSheaf (image (Sigma.desc f)) := by
  classical
  let e := Equiv.intEquivNat
  let σ (n : ℕ) : (⨁ fun i : Fin n ↦ A (e.symm i)) ⟶ V :=
    biproduct.desc fun i ↦ f (e.symm i)
  have hW (n : ℕ) : IsAdicLisseSheaf (⨁ fun i : Fin n ↦ A (e.symm i)) :=
    IsAdicLisseSheaf.biproduct_fin n _ (fun i ↦ hA _)
  have hT (n : ℕ) : IsAdicLisseSheaf (image (σ n)) := lisse_finite_image (hW n) hV _
  let d (T : AdicSheaf l Y) : ℕ := ∑ i, stalkDimension (s i) T
  have hbd (n : ℕ) : d (image (σ n)) ≤ d V :=
    Finset.sum_le_sum (fun i _ ↦ stalkDimension_le_of_mono (s i) hV (image.ι (σ n)))
  obtain ⟨n, hn⟩ := bounded_nat_function_max (fun n ↦ d (image (σ n))) (d V) hbd
  let incl (m : ℕ) (h : n ≤ m) :
      (⨁ fun i : Fin n ↦ A (e.symm i)) ⟶ ⨁ fun i : Fin m ↦ A (e.symm i) :=
    biproduct.desc fun i ↦ biproduct.ι (fun i : Fin m ↦ A (e.symm i)) (i.castLE h)
  have hσ (m : ℕ) (h : n ≤ m) : incl m h ≫ σ m = σ n := by
    refine biproduct.hom_ext' _ _ (fun i ↦ ?_)
    simp [incl, σ]
  let c (m : ℕ) (h : n ≤ m) : image (σ n) ⟶ image (σ m) :=
    image.eqToHom (hσ m h).symm ≫ image.preComp (incl m h) (σ m)
  have hc (m : ℕ) (h : n ≤ m) : c m h ≫ image.ι (σ m) = image.ι (σ n) := by
    simp only [c, Category.assoc, image.preComp_ι]
    exact image.lift_fac _
  have hiso (m : ℕ) (h : n ≤ m) : IsIso (c m h) := by
    have : Mono (c m h) := by dsimp [c]; infer_instance
    apply lisse_iso_of_stalkDimension_sum_eq s hs (hT n) (hT m) (c m h)
    apply le_antisymm
    · exact Finset.sum_le_sum (fun i _ ↦ stalkDimension_le_of_mono (s i) (hT m) (c m h))
    · exact hn m
  let ι := image.ι (σ n)
  have hfac (j : ℤ) : f j ≫ cokernel.π ι = 0 := by
    obtain ⟨z, rfl⟩ := e.symm.surjective j
    let m := max n (z + 1)
    have hnm : n ≤ m := le_max_left _ _
    have hjm : z < m := lt_of_lt_of_le (Nat.lt_succ_self _) (le_max_right _ _)
    have := hiso m hnm
    have h1 : f (e.symm z) = biproduct.ι (fun i : Fin m ↦ A (e.symm i)) ⟨z, hjm⟩ ≫
        factorThruImage (σ m) ≫ inv (c m hnm) ≫ ι := by
      rw [(IsIso.inv_comp_eq (c m hnm)).2 (hc m hnm).symm, image.fac]
      simp [σ]
    rw [h1]
    simp [ι]
  have hσzero : Sigma.desc f ≫ cokernel.π ι = 0 := by
    apply Sigma.hom_ext
    intro j
    simpa only [Sigma.ι_desc_assoc, comp_zero] using hfac j
  let g := Abelian.monoLift ι (Sigma.desc f) hσzero
  have hg : g ≫ ι = Sigma.desc f := Abelian.monoLift_comp _ _ _
  let q : image (Sigma.desc f) ⟶ image (σ n) :=
    image.lift { I := image (σ n), m := ι, e := g, fac := hg }
  have hq : q ≫ ι = image.ι (Sigma.desc f) := image.lift_fac _
  let t : (⨁ fun i : Fin n ↦ A (e.symm i)) ⟶ image (Sigma.desc f) :=
    biproduct.desc fun i ↦ Sigma.ι A (e.symm i) ≫ factorThruImage (Sigma.desc f)
  have ht : t ≫ image.ι (Sigma.desc f) = σ n := by
    apply biproduct.hom_ext'
    intro i
    simp [t, σ]
  let p : image (σ n) ⟶ image (Sigma.desc f) :=
    image.lift { I := image (Sigma.desc f), m := image.ι _, e := t, fac := ht }
  have hp : p ≫ image.ι (Sigma.desc f) = ι := image.lift_fac _
  have : Mono q := mono_of_mono_fac hq
  have hpq : p ≫ q = 𝟙 _ := by
    apply (cancel_mono ι).1
    simpa only [Category.assoc, hq, Category.id_comp] using hp
  have : Epi q := (SplitEpi.mk p hpq).epi
  have : IsIso q := isIso_of_mono_of_epi q
  exact (hT n).of_iso (asIso q).symm


/-- An image generated by lisse sheaves inside a lisse sheaf is lisse.
Source: the finite Frobenius-orbit sum in `sk-i-dl-general-real`; here the
finite-rank argument is stated independently of Frobenius.

Proof: the geometric fibre is Noetherian. Choose one geometric point over a
closed point of each of its finitely many irreducible components. For each
finite subset of the integer-indexed family, the image of its finite direct sum
is lisse: finite sums are lisse, and images are kernels of cokernels in the
abelian category of lisse sheaves on a locally Noetherian scheme. The sum of the
ranks at the chosen points is bounded by the corresponding sum for `V`. Choose
a finite subset maximizing it. Adding any further summand gives a monomorphism
between two such finite images. Its cokernel is lisse and has rank zero at each
chosen point, hence everywhere by specialization and generization of lisse
ranks. The monomorphism is therefore an isomorphism. Every summand consequently
factors through the chosen finite image, so the coproduct map does too. Its
image is exactly that finite image and is lisse. The empty scheme and zero ambient
sheaf cause no exception: all images are zero. No lissity of the infinite
coproduct itself is asserted.
(blueprint: lem-zl-lisse-countable-image). -/
theorem isAdicLisseSheaf_image_sigma
    {k : Type u} [Field k] [Finite k] {l : ℕ} [Fact l.Prime]
    {X : Scheme.{u}} [X.Over (Spec (.of k))]
    [LocallyOfFiniteType (X ↘ Spec (.of k))] [QuasiCompact (X ↘ Spec (.of k))]
    (A : ℤ → AdicSheaf l (X ↘ Spec (.of k)).geometricFiber)
    (V : AdicSheaf l (X ↘ Spec (.of k)).geometricFiber)
    (f : ∀ n, A n ⟶ V) (hA : ∀ n, IsAdicLisseSheaf (A n))
    (hV : IsAdicLisseSheaf V) : IsAdicLisseSheaf (image (Sigma.desc f)) := by
  have : IsLocallyNoetherian (X ↘ Spec (.of k)).geometricFiber :=
    LocallyOfFiniteType.isLocallyNoetherian
      (X ↘ Spec (.of k)).geometricFiberToAlgebraicClosure
  obtain ⟨N, s, hs⟩ := WeilSheaf.exists_geometricPoints_specializes k X
  exact lisse_countable_image_of_detecting s hs A V f hA hV

end AlgebraicGeometry.ProEtale
