module

public import WeilConjectures.DeligneLaumon.CondensedGenericWeilData

/-! # Reconstruction from the normalized Weil fibre functor
Source: Weil II (1.1.12), generic-fibre proof steps 2 and 5--6.
(blueprint: lem-dl-a1-normalized-weil-fibre-descent).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj TensorProduct
namespace AlgebraicGeometry.ProEtale.CondensedGenericWeil

variable (D : WeilConjectures.FiniteFieldDatum.{u})
  (U₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType U₀.hom] [QuasiCompact U₀.hom]
  [ConnectedSpace U₀.left]

variable {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
  (t : Spec (.of Ω) ⟶ (D.geometricFiber U₀).left)
  (G : ProfiniteGrp.{u})
  [∀ Q, MulAction G ((FiniteEtale.fiber (t ≫ projection D U₀)).obj Q)]
  [PreGaloisCategory.IsFundamentalGroup (FiniteEtale.fiber (t ≫ projection D U₀)) G]

variable (ell : ℕ) [Fact ell.Prime]


/-- The normalized fibre action is fully faithful and essentially surjective.
This concerns a supplied functor, not its
construction or its exactness and tensor consequences.

Source: Weil II (1.1.12), proof steps 2 and 5--6.
(blueprint: lem-dl-a1-normalized-weil-fibre-descent).

Proof: put C_i = Phi^i C for the constant-field degree d and write the return map f on C.
Restriction of a Weil pair is a pair (N,a:f*N iso N). Reconstruct such a pair by transporting
N to each C_i and gluing by the disjoint-open-cover sheaf condition. Its Frobenius arrows
are identities between successive transported copies, and a on the last-to-first return.
The same component formulas prove that this reconstruction and restriction are inverse
on objects and morphisms. A map of geometric fibres lifts uniquely to a sheaf map on C by
the normal lisse correspondence in S. It commutes with a exactly when it intertwines the
return operator T, by naturality of L_s and cancellation of that invertible path map.
Since W is generated by P and s, these are exactly the Weil-equivariant maps, proving
fullness and faithfulness. Conversely, for an allowed W-representation use its restriction
to P to reconstruct N. The map R(s)L_s is geometric-equivariant; fullness reconstructs a,
and the inverse matrix reconstructs its inverse. The cyclic reconstruction gives the Weil
pair. Its fibre is the original representation by agreement on P and s. This is also the
fibre under the supplied normalized functor, by its normalized geometric and return laws. -/
theorem normalized_weil_fibre_descent
    (hEll : ell ≠ D.p) [IsSeparated U₀.hom]
    (hNormal : ∀ z : U₀.left, IsDomain (U₀.left.presheaf.stalk z) ∧
      IsIntegrallyClosed (U₀.left.presheaf.stalk z))
    (hGeneric : ∃ Z ∈ irreducibleComponents (D.geometricFiber U₀).left,
      IsGenericPoint (t (IsLocalRing.closedPoint Ω)) Z)
    (A : Geometry D U₀ t G) (S : RealCondensedFibre.System.{u} ell)
    (M : NormalizedFunctor D U₀ t G ell A S) :
    M.functor.Full ∧ M.functor.Faithful ∧ M.functor.EssSurj := by
  sorry

end AlgebraicGeometry.ProEtale.CondensedGenericWeil
