/-! # Restriction calculus for condensed coefficients on a smooth curve

Source: literature/blueprint/latest/blueprint/sec-deligne-laumon-a1/
sk-lem-wft-curve-heart/thm-a1-curve-perverse-heart.proof.md, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus).

All categories below are the actual module categories and their ordinary derived
categories. The abbreviations only shorten these existing types. In particular the
constructible predicate remains the finite constant local-model predicate.
-/

@[expose] public noncomputable section
set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.Triangulated AlgebraicGeometry
open Opposite AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CurveRestriction

/-- The existing pulled-back finite-subextension-valued coefficient ring.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev coefficients (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) :=
  condensedRingObj (Profinite.padicAlgClRingObj ell) T

/-- The actual category of internal modules over the pulled-back coefficient ring.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev Modules (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) :=
  Mod (Sheaf (Scheme.ProEt.topology T) Ab.{u + 1}) (coefficients ell T)

/-- The ordinary ambient derived category of these module sheaves.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev Ambient (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) :=
  DerivedCategory (Modules ell T)

/-- The existing finite constant local-model constructibility predicate.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev constructible (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) :=
  IsConstantModelConstructible (Profinite.padicAlgClRingObj ell) T

/-- The existing bounded constructibility predicate in the ambient derived category.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev boundedConstructible (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) :=
  constantModelBoundedConstructible (Profinite.padicAlgClRingObj ell) T

/-- The full category of bounded complexes with constructible ordinary cohomology.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev Bounded (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) :=
  ConstantModelBoundedConstructible (Profinite.padicAlgClRingObj ell) T

/-- The existing locally finite free coefficient-module predicate.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev lisse (ell : ℕ) [Fact ell.Prime] {T : Scheme.{u}} (M : Modules ell T) :=
  IsLisseCoefficientModule (Profinite.padicAlgClRingObj ell) M

/-- Ordinary coefficient-module restriction.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev pull (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y) :=
  CondensedRing.upperStar (Profinite.padicAlgClRingObj ell) f

/-- Ordinary coefficient-module direct image.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev push (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y) :=
  CondensedRing.lowerStar (Profinite.padicAlgClRingObj ell) f

/-- The total derived functor of the full module pullback composite.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev derivedPull (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y) :=
  CondensedRing.moduleObjectDerivedPullback (Profinite.padicAlgClRingObj ell) f

/-- The total derived functor of the full module pushforward composite.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev derivedPush (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y) :=
  CondensedRing.moduleObjectDerivedPushforward (Profinite.padicAlgClRingObj ell) f

/-- Ordinary module-sheaf cohomology, with no completion or coefficient localization.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev cohomology (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) (m : ℤ) :=
  DerivedCategory.homologyFunctor (Modules ell T) m

/-- The specified bottom comparison, composed with the actual lower-truncation unit.
It is defined on all ambient objects; it is invertible when the object is in degrees ≥ m.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def bottomMap (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (m : ℤ) (K : Ambient ell X) :
    (cohomology ell Y m).obj ((derivedPush ell f).obj K) ⟶
      (push ell f).obj ((cohomology ell X m).obj K) :=
  (cohomology ell Y m).map ((derivedPush ell f).map
    ((DerivedCategory.TStructure.t.truncGEπ m).app K)) ≫
      ((push ell f).rightDerivedFunctorTruncatedBottomIso m).hom.app K

/-- The canonical cohomology comparison for the exact pullback, transported to its
total left derived functor by the published exact-functor comparison.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def pullCohomology (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (m : ℤ) :
    cohomology ell Y m ⋙ pull ell f ≅ derivedPull ell f ⋙ cohomology ell X m :=
  (pull ell f).mapDerivedCategoryHomologyFunctorIso m ≪≫
    Functor.isoWhiskerRight
      (CondensedRing.leftDerivedUpperStarIsoMapDerivedCategory
        (Profinite.padicAlgClRingObj ell) f).symm (cohomology ell X m)

/-- Closure in all module sheaves, including extensions of arbitrary short exact sequences.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def HeartClosure (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) : Prop :=
  (∀ (M N : Modules ell T) (f : M ⟶ N),
    constructible ell T M → constructible ell T N →
      constructible ell T (kernel f) ∧ constructible ell T (cokernel f)) ∧
  (∀ S : ShortComplex (Modules ell T), S.ShortExact →
    constructible ell T S.X₁ → constructible ell T S.X₃ → constructible ell T S.X₂)

/-- The induced standard bounded t-structure and its actual ambient truncations.
The inherited triangulated structure is supplied as conclusion data, not as a hypothesis.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
structure Standard (ell : ℕ) [Fact ell.Prime] (T : Scheme.{u}) where
  [triangulated : (boundedConstructible ell T).IsTriangulated]
  t : TStructure (Bounded ell T)
  le (K : Bounded ell T) (m : ℤ) :
    t.IsLE K m ↔ DerivedCategory.TStructure.t.IsLE K.obj m
  ge (K : Bounded ell T) (m : ℤ) :
    t.IsGE K m ↔ DerivedCategory.TStructure.t.IsGE K.obj m
  bounded (K : Bounded ell T) : t.bounded K
  heart : t.Heart (ConstantModelConstructible (Profinite.padicAlgClRingObj ell) T)
  heart_normalization : Nonempty (heart.ι ⋙ (boundedConstructible ell T).ι ≅
    ObjectProperty.ι (IsConstantModelConstructible (Profinite.padicAlgClRingObj ell) T) ⋙
      DerivedCategory.singleFunctor (Modules ell T) 0)
  truncLE (m : ℤ) : ∃ α : t.truncLE m ⋙ (boundedConstructible ell T).ι ≅
      (boundedConstructible ell T).ι ⋙ DerivedCategory.TStructure.t.truncLE m,
    ∀ K : Bounded ell T,
      α.hom.app K ≫ (DerivedCategory.TStructure.t.truncLEι m).app K.obj =
        (boundedConstructible ell T).ι.map ((t.truncLEι m).app K)
  truncGE (m : ℤ) : ∃ α : t.truncGE m ⋙ (boundedConstructible ell T).ι ≅
      (boundedConstructible ell T).ι ⋙ DerivedCategory.TStructure.t.truncGE m,
    ∀ K : Bounded ell T,
      (boundedConstructible ell T).ι.map ((t.truncGEπ m).app K) ≫ α.hom.app K =
        (DerivedCategory.TStructure.t.truncGEπ m).app K.obj

/-- The open--closed module calculus and preservation of the specified full categories.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def ImmersionCalculus (ell : ℕ) [Fact ell.Prime] {C U Z : Scheme.{u}}
    (j : U ⟶ C) (i : Z ⟶ C) [IsClosedImmersion i] : Prop :=
  PreservesFiniteLimits (pull ell j) ∧ PreservesFiniteColimits (pull ell j) ∧
  PreservesFiniteLimits (pull ell i) ∧ PreservesFiniteColimits (pull ell i) ∧
  (∀ M : Modules ell C,
    IsZero ((pull ell j).obj M) → IsZero ((pull ell i).obj M) → IsZero M) ∧
  PreservesFiniteLimits (push ell i) ∧ PreservesFiniteColimits (push ell i) ∧
  (push ell i).Full ∧ (push ell i).Faithful ∧
  (∀ N : Modules ell Z,
    IsIso ((CondensedRing.upperStarLowerStarAdjunction
      (Profinite.padicAlgClRingObj ell) i).counit.app N)) ∧
  (∀ M : Modules ell C, (push ell i).essImage M ↔ IsZero ((pull ell j).obj M)) ∧
  (∀ N : Modules ell U,
    IsIso ((CondensedRing.upperStarLowerStarAdjunction
      (Profinite.padicAlgClRingObj ell) j).counit.app N)) ∧
  (∀ N : Modules ell U, lisse ell N → constructible ell C ((push ell j).obj N)) ∧
  (∀ M : Modules ell C, constructible ell C M →
    constructible ell U ((pull ell j).obj M) ∧
    constructible ell Z ((pull ell i).obj M)) ∧
  (∀ N : Modules ell Z, constructible ell Z N → constructible ell C ((push ell i).obj N)) ∧
  (∀ K : Bounded ell C,
    boundedConstructible ell U ((derivedPull ell j).obj K.obj) ∧
    boundedConstructible ell Z ((derivedPull ell i).obj K.obj)) ∧
  (∀ K : Bounded ell Z,
    boundedConstructible ell C ((derivedPush ell i).obj K.obj)) ∧
  (∀ K : Bounded ell U, boundedConstructible ell C ((derivedPush ell j).obj K.obj))

/-- The curve clauses and the bottom-cohomology normalization.

Proof:
1. The schemes C,U,Z are Noetherian and finite-dimensional: they are finite type over a field, and
the open U is quasi-compact since C is Noetherian. The prime ℓ remains invertible on them. Apply
[det-lem-coefficient-heart-closure] with Λ=Ω to each T. Its last assertion identifies the
finite-constant-model notion in the statement with lissity on a finite stratification, and gives
closure under kernels, cokernels and extensions in the ambient module category. Thus this is
closure for the actual pulled-back condensed coefficients, rather than for discrete Ω-sheaves.
2. For finitely many sheaves choose a common adapted finite stratification by
[det-lem-coefficient-heart-common-stratification]. Apply
[lem-sfb-coefficient-heart-curve-generic-neighborhood]. On each W_C in that statement, pull the
sheaves back to T_C=W_C×_C S_{j(C)}. They are lisse there by restriction from the adapted stratum;
[lem-sfb-coefficient-heart-curve-lisse-descent] along the surjective closed immersion T_C→W_C makes
them lisse on W_C. The union of these opens is dense and works for every sheaf. Its reduced
complement is finite and consists of closed points by [lem-sfb-coefficient-heart-curve-complement].
The same conclusion applies to the given dense U. Its complement Z is a finite discrete space: each
singleton is closed and its complement is a finite union of closed singletons, hence each singleton
is open. An adapted finite stratification of reduced Z therefore makes every constructible sheaf
lisse on each of these open singleton schemes, hence lisse on Z. No connectedness of C or
nonemptiness of Z is required.
3. On each connected component of T, [cor-galois-lisse-representations](2) identifies the given
finite-E lisse sheaf with a continuous finite-dimensional representation of the profinite
fundamental group. By [lem-pod-profinite-stable-lattice] it admits a stable finite free
O_E-lattice. The finite-coefficient equivalence in the same corollary turns its quotients into
finite locally free L_n, with L_(n+1) tensor A_(E,n)=L_n. There are finitely many components, so
these systems assemble on T. The inverse of the reduction equivalence in
[lem-per-lisse-completed-system-comparison] is precisely lim_n ν_T^*L_n and is lisse over the
completed integral ring. The coefficient isomorphisms of [sk-prop-sfb-qlbar-colimit-x] identify
that ring with the pulled-back continuous O_E ring and its localization with E_T. Hence Ω_T⊗ Lhat
is locally Ω_T^r and is lisse, including rank zero. The fully faithful rational realization in the
system-comparison lemma carries an isomorphism between two lattice representatives of the given
rational object to its specified isomorphism; the identity of that object gives the canonical
comparison and its composition law. For different coefficient fields first extend to their finite
compositum. The same lemma gives compatibility with finite coefficient extension and module
pullback. Together with the coefficient comparisons of [sk-prop-sfb-qlbar-colimit-x] this gives
exactly the stated open, closed and automorphism comparisons. These assertions concern
finite-extension objects; they do not presume that every arbitrary lisse E_T-module has a global
lisse lattice.
4. For T=C,U,Z, [lem-sfb-adic-constructibility-predicate-comparison] identifies
finite-constant-local-model constructibility with stratified local-finite-presentation
constructibility for the specified adic ring objects. These are equal object predicates in the same
ambient derived category; no completion is imposed. Use the ambient standard t-structure of
[def-sbc-standard-tstructure-derived-category]. Its truncations retain the original cohomology
sheaves on one side of the cutoff and put zero on the other. Consequently they preserve boundedness
and constructibility, and their ambient truncation triangles lie in the full constructible
subcategory. This subcategory is triangulated with inherited triangles by
[lem-sfb-bounded-constructible-triangulated-finiteness]. The ambient t-structure axioms therefore
restrict, boundedness follows from the finite cohomological interval, and its heart consists
exactly of constructible module sheaves placed in degree zero. Since the subcategory is full in the
ambient module derived category, its cohomology is ordinary module-sheaf cohomology.
5. Apply [lem-weil-pbc-condensed-open-closed-recollement] to the coefficient ring underline Ω and
the quasi-compact j. It gives exact j^*,i^*,i_*, the adjunctions, full faithfulness of i_* and
i^*i_*≅id. Its first triangle is the sheaf short exact sequence 0→j_!j^*F→F→i_*i^*F→0, since all
three functors in it are exact. Thus j^*F=i^*F=0 implies F=0; if j^*F=0, its actual unit F→i_*i^*F
is an isomorphism. Conversely j^*i_*G=0 by [lem-sfb-proetale-open-disjoint-direct-image]. The
identities respect module actions, because all maps are the module adjunction maps. For an object
V→U of the pro-etale site, V×_C U=V, so restricting the sheaf j_*G back to U evaluates to G(V); the
counit j^*j_*G→G is therefore an isomorphism. Using the predicate comparison of step 4 on source
and target, pullback preserves constructibility by [lem-weil-pbc-module-constructible-pullback],
and i_* does so by [lem-weil-pbc-condensed-constructible-open-closed-images]. Exactness and
[lem-weil-pbc-exact-functor-bounded-below] now give preservation of bounded constructible complexes
by j^*,i^*,i_* and their commutation with ordinary cohomology.
6. First take a constructible Omega_U-module F. Via
[lem-sfb-adic-constructibility-predicate-comparison], apply
[lem-weil-pbc-condensed-finite-presentation-descent] to obtain a constructible finite-E model F_E
and Omega_U tensor_(E_U) F_E=F. The same predicate comparison makes F_E constructible in the finite
constant local model sense. Clause (1) of [lem-integral-ctf-equals-bc] gives F_E Tor amplitude
[0,0]; hence its ordinary scalar extension equals Omega_U tensor^L_(E_U) F_E. Apply
[lem-per-condensed-finite-extension-direct-image] to j:U→C. It gives bounded constructible ambient
Rj_(E,*)F_E for any field k with ell invertible. The coefficient-change isomorphism of
[lem-sfb-qlbar-direct-image-comparison] now identifies Rj_*F with Omega_C tensor^L_(E_C)
Rj_(E,*)F_E. By the predicate comparison on C and [lem-sfb-extend-to-qlbar-constructible], this is
bounded constructible in the required finite-local-model sense. For general bounded constructible
M, [lem-sfb-bounded-cohomology-cone-witness] constructs M from finitely many shifts and cones of
its cohomology sheaves. Apply the triangulated Rj_* of [det-def-sfb-module-derived-pushpull] to
that finite construction and use step 4. This proves the assertion without a whole-complex
coefficient descent or any change of ambient category.
7. The module adjunction j^*⊣j_* makes j_* left exact. The module categories have the
injective-resolution hypotheses by [prop-pur-kinjective-resolutions-exist]; their small-site
representatives are taken in the fixed larger universe. For M∈D^{≥m},
[lem-weil-pbc-derived-functor-negative-vanishing] gives Rj_*M∈D^{≥m}. Apply
[lem-pc-derived-bottom-unit-normalization] with S=j_* and n=m. Since τ^{≥m}M≅M, its natural bottom
comparison gives H^m(Rj_*M)≅j_*H^mM. In particular, for lisse F on U in degree zero,
H^0(Rj_*F)=j_*F. Step 6 makes Rj_*F constructible, so this equality proves the remaining ordinary
j_* constructibility clause.
8. For the assertion about the unit, represent K by a complex N, apply j^* termwise, and choose the
bounded-below injective model for j^*K. The unit equation in
[lem-trf-bounded-below-derived-adjunction] says that the actual derived unit is the termwise
ordinary unit N→j_*j^*N followed by the right-derived comparison. The cycle/quotient compatibility
in [lem-pc-derived-bottom-unit-normalization], applied in degree m to that comparison, identifies
its map on H^m with j_* applied to the cohomology quotient. Since j^* is exact,
[lem-weil-pbc-exact-functor-bounded-below] identifies H^m(j^*K) with j^*H^mK. Naturality of the
ordinary unit on the cycle inclusion and cohomology quotient then gives exactly H^mK→j_*j^*H^mK.
This argument uses the lower bound only on j^*K; it does not replace K by τ^{≥m}K or impose a lower
bound on K at degree m.
9. Let h be a compatible automorphism of the immersion pair. Its equivalence of pro-etale sites and
exact inverse image are [lem-weil-proetale-isomorphism-inverse-image]; coefficient pullbacks are
identified by [sk-prop-sfb-cartesian-coefficients]. The composition and 2-isomorphism comparisons
in [lem-sfb-ringed-derived-monoidal-comparisons] identify h-pullback of the module adjunctions with
the original adjunctions, including units and counits. Exact equivalences commute with kernels and
cokernels, so applying h to the good-truncation complexes identifies their actual maps and
triangles with the good truncations of h^*K. The bottom comparison of step 7 is natural and is
defined by the same cycle and quotient maps, and the unit calculation in step 8 consequently
respects these comparisons. The finite-level and limit comparisons of step 3 already commute with
h. Over a finite-field model take h to be geometric Frobenius on its geometric fibre. Apply these
natural comparisons to the isomorphism h^*K≅K: they give precisely the Frobenius structures and
equivariant maps in [sk-def-sf-weil-complexes]. This uses only Frobenius pairs in the ambient
categories.
Source: curve-heart proof, Steps 0--4
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
theorem condensed_curve_restriction_calculus
    (ell : ℕ) [Fact ell.Prime] (k : Type u) [Field k] [PerfectField k]
    (hEll : IsUnit (ell : k))
    (C : Scheme.{u}) (s : C ⟶ Spec (.of k))
    [Smooth s] [QuasiCompact s] [IsSeparated s] (hPure : C.IsPureDimension 1)
    {U Z : Scheme.{u}} (j : U ⟶ C) [IsOpenImmersion j]
    (i : Z ⟶ C) [IsClosedImmersion i] [IsReduced Z]
    (hDense : Dense (Set.range j)) (hComplement : Set.range j = (Set.range i)ᶜ) :
    (∀ T : Scheme.{u}, T = C ∨ T = U ∨ T = Z →
      HeartClosure ell T ∧ Nonempty (Standard ell T)) ∧
    (∀ (n : ℕ) (F : Fin n → Modules ell C),
      (∀ a : Fin n, constructible ell C (F a)) →
      ∃ W : C.Opens, Dense (W : Set C) ∧ Set.Finite ((W : Set C)ᶜ) ∧
        (∀ x : C, x ∉ W → IsClosed ({x} : Set C)) ∧
        ∀ a : Fin n, lisse ell ((pull ell W.ι).obj (F a))) ∧
    (∀ F : Modules ell Z, constructible ell Z F → lisse ell F) ∧
    ImmersionCalculus ell j i ∧
    (∀ (m : ℤ) (M : Bounded ell U),
      (∀ a : ℤ, a < m → IsZero ((cohomology ell U a).obj M.obj)) →
      (∀ a : ℤ, a < m →
        IsZero ((cohomology ell C a).obj ((derivedPush ell j).obj M.obj))) ∧
      IsIso (bottomMap ell j m M.obj)) ∧
    (∀ (m : ℤ) (K : Bounded ell C),
      DerivedCategory.TStructure.t.IsGE ((derivedPull ell j).obj K.obj) m →
      (cohomology ell C m).map
          ((CondensedRing.derivedUpperStarLowerStarAdjunction
            (Profinite.padicAlgClRingObj ell) j).unit.app K.obj) ≫
        bottomMap ell j m ((derivedPull ell j).obj K.obj) ≫
        (push ell j).map ((pullCohomology ell j m).inv.app K.obj) =
      (CondensedRing.upperStarLowerStarAdjunction
        (Profinite.padicAlgClRingObj ell) j).unit.app ((cohomology ell C m).obj K.obj)) := by
  sorry


/-- The existing reconstructed commutative section-ring sheaf of an internal ring.
Source: curve-heart proof, Step 0, coefficient comparisons
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev sectionRing (T : Scheme.{u})
    (R : Sheaf (Scheme.ProEt.topology T) Ab.{u + 1}) [MonObj R] [IsCommMonObj R] :=
  InternalAbelianSheafModule.sectionRingSheaf.{u + 1, u + 1, u}
    (Scheme.ProEt.topology T) R

/-- The canonical finite-subfield inclusion, reconstructed on sections after point pullback.
Source: curve-heart proof, Step 0, Omega tensor formula
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def finiteSectionLeg (ell : ℕ) [Fact ell.Prime]
    (E : PadicAlgCl.FiniteIntermediateField ell) (T : Scheme.{u}) :
    sectionRing T (condensedRingObj (Profinite.continuousMapRingObj E) T) ⟶
      sectionRing T (coefficients ell T) :=
  IntegralModelsStacks.sectionMap T
    ((upperStarFromPoint T).map (Profinite.padicSubfieldRingObjToPadicAlgCl ell E))

/-- The comparison is fixed on every continuous section, including its coefficient embedding.
The algebraic equivalence merely permits the existing lattice category's coefficient universe.
Source: curve-heart proof, Step 0, coefficient comparisons
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def IsCoefficientTransport (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell) (E : PadicAlgCl.FiniteIntermediateField ell)
    (e : P.E ≃ₐ[ℚ_[ell]] E)
    (χ : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj E) P.X)) : Prop :=
  ∀ (V : P.X.ProEtᵒᵖ) (f : (CompletedLisse.rationalRing ell P).obj.obj V)
      (x : V.unop.left),
    (((chartComparison P.X E).hom.app V).hom ((χ.hom.hom.app V).hom f)).down x =
      e (f.down x)

/-- Transport from the recorded spectral-norm coefficients is the unique section-normalized
comparison, not a chosen unrelated equivalence.
Source: curve-heart proof, Step 0, and BS 6.8.2
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: the finite extension's spectral norm is the restricted p-adic norm. An algebraic
identification therefore identifies the continuous-function rings pointwise. Compose with
the inverse of chartComparison. Its monoid compatibility gives the reconstructed ring
isomorphism. The displayed section equation and the invertibility of chartComparison
prove uniqueness. This includes the empty test object. -/
theorem coefficient_transport_existsUnique (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell) (E : PadicAlgCl.FiniteIntermediateField ell)
    (e : P.E ≃ₐ[ℚ_[ell]] E) :
    ∃! χ : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj E) P.X),
      IsCoefficientTransport ell P E e χ := by
  sorry

/-- Actual ordinary scalar extension from the finite rational coefficient sheaf to Omega.
Source: curve-heart proof, Step 0, Omega tensor formula
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def scalarRealization (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell) (E : PadicAlgCl.FiniteIntermediateField ell)
    (χ : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj E) P.X)) :=
  completedAdicChange P.X (χ.hom ≫ finiteSectionLeg ell E P.X)

/-- Lattice realization is the recorded rational reconstruction followed by actual tensor
extension and the existing sectionwise/internal equivalence.
Source: curve-heart proof, Step 0, lattice realization
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def latticeRealization (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell) (E : PadicAlgCl.FiniteIntermediateField ell)
    (χ : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj E) P.X))
    (c : CompletedLisse.Comparison ell P) : CompletedLisse.RawRational ell P ⥤ Modules ell P.X :=
  c.rationalRealization ⋙ ObjectProperty.ι _ ⋙ scalarRealization ell P E χ ⋙
    (InternalModuleOperations.equivalence (Profinite.padicAlgClRingObj ell) P.X).inverse

/-- The completed integral ring maps to Omega by localization and the specified finite-field
inclusion. This is the coefficient map in Omega tensor over the completed integral ring.
Source: curve-heart proof, Step 0, lattice realization
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def completedToOmega (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell) (E : PadicAlgCl.FiniteIntermediateField ell)
    (χ : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj E) P.X))
    (c : CompletedLisse.Comparison ell P) :
    CompletedLisse.completedRing ell P ⟶ sectionRing P.X (coefficients ell P.X) :=
  c.coefficientIso.inv ≫ lisseIntegerToFieldSized ell P.E P.X ≫
    χ.hom ≫ finiteSectionLeg ell E P.X

/-- Every finite-extension rational lisse sheaf admits a finite-free lattice representative.
Source: curve-heart proof, Step 0(i), Weil II (1.1.1)
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: on each connected component the finite-extension lisse sheaf is a continuous
finite-dimensional representation of the profinite fundamental group. Compactness of its
image gives an invariant finite-free valuation-ring lattice. Its quotients form the
finite-free compatible etale system by the finite-coefficient monodromy equivalence.
The rationalized lattice gives the original representation and thus the displayed
isomorphism. The finitely many connected components assemble these systems. The empty
scheme and the zero representation give the empty and rank-zero systems. -/
theorem free_lattice_representative (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell)
    (F : Scheme.LisseRationalSheaf ell P.E P.X) :
    ∃ G : CompletedLisse.RawRational ell P, Nonempty (F ≅ G.obj) := by
  sorry

/-- The finite-free etale system reconstructs by its actual inverse limit. Its Omega
realization is lisse and agrees with tensor of that completion, normalized on 1 tensor x.
Source: curve-heart proof, Step 0, lattice realization
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: completion_limit of the completed-system comparison identifies the integral
reconstruction with the inverse limit of the etale-to-pro-etale images. The quotient and
scalar equations there identify its completed integral action. Its rationalObject
identifies rational reconstruction with localization. Associativity of ordinary scalar
extension gives the displayed isomorphism; its equation follows on pure tensors from
associativity and the scalar-extension units. Local finite free bases extend to Omega
bases, proving lissity, including rank zero. The functor on raw rational morphisms is
normalized by rational_map, so its mapIso of any identification of rational objects is
precisely the lattice-change comparison. Functoriality gives identities and cocycles. -/
theorem lattice_realization_calculus (ell : ℕ) [Fact ell.Prime]
    (P : CompletedLisse.Base.{u} ell) (E : PadicAlgCl.FiniteIntermediateField ell)
    (e : P.E ≃ₐ[ℚ_[ell]] E)
    (χ : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj E) P.X))
    (hχ : IsCoefficientTransport ell P E e χ)
    (c : CompletedLisse.Comparison ell P) :
    (∀ F : CompletedLisse.Systems ell P,
      Nonempty (IsLimit (Cone.mk _ (c.completion F)))) ∧
    (∀ F : CompletedLisse.RawRational ell P,
      lisse ell ((latticeRealization ell P E χ c).obj F) ∧
      ∃ β : (scalarRealization ell P E χ).obj (c.rationalRealization.obj F).obj ≅
          (completedAdicChange P.X (completedToOmega ell P E χ c)).obj
            (c.equivalence.inverse.obj ⟨F.obj.integral, F.property⟩).obj,
        ∀ (V : P.X.ProEtᵒᵖ)
          (x : (c.equivalence.inverse.obj ⟨F.obj.integral, F.property⟩).obj.val.obj V),
          β.hom.val.app V
            (completedAdicChangeTensor P.X (χ.hom ≫ finiteSectionLeg ell E P.X)
              (c.rationalRealization.obj F).obj V 1
              ((c.rationalObject F).inv.val.app V
                (completedAdicChangeTensor P.X
                  (c.coefficientIso.inv ≫ lisseIntegerToFieldSized ell P.E P.X)
                  (c.equivalence.inverse.obj ⟨F.obj.integral, F.property⟩).obj V 1 x))) =
          completedAdicChangeTensor P.X (completedToOmega ell P E χ c)
            (c.equivalence.inverse.obj ⟨F.obj.integral, F.property⟩).obj V 1 x) ∧
    (∀ F : CompletedLisse.RawRational ell P,
      (latticeRealization ell P E χ c).mapIso (Iso.refl F) = Iso.refl _) ∧
    (∀ (F G H : CompletedLisse.RawRational ell P) (a : F ≅ G) (b : G ≅ H),
      (latticeRealization ell P E χ c).mapIso (a ≪≫ b) =
        (latticeRealization ell P E χ c).mapIso a ≪≫
          (latticeRealization ell P E χ c).mapIso b) := by
  sorry

/-- Realization commutes with simultaneous scheme restriction and finite-field extension.
The section equation specifies the actual tensor-unit comparison uniquely. Together with
Operation.rational it gives the comparison on raw rational lisse sheaves.
Source: curve-heart proof, Step 0 and automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: pullback of the coefficient inclusion is the same inclusion on the pulled-back
scheme, by the cartesian coefficient comparisons. The tensor-formula adjunctions give
both composites the same right adjoint. Its unique normalized left-adjoint comparison
has the displayed unit equation. Pure tensors locally generate, proving uniqueness.
Whisker this comparison by cP.rationalRealization and compose with Operation.rational;
the latter's rational_normalization identifies the lattice projections. Identity and
composition follow from uniqueness, so open restriction, closed restriction, compatible
automorphisms and finite-field inclusions all commute, including mixed compositions. -/
theorem lattice_realization_restriction (ell : ℕ) [Fact ell.Prime]
    {P Q : CompletedLisse.Base.{u} ell} (a : CompletedLisse.Arrow ell P Q)
    (EP EQ : PadicAlgCl.FiniteIntermediateField ell)
    (eP : P.E ≃ₐ[ℚ_[ell]] EP) (eQ : Q.E ≃ₐ[ℚ_[ell]] EQ)
    (he : ∀ x : P.E, (eQ (a.coefficient x) : PadicAlgCl ell) = (eP x : PadicAlgCl ell))
    (χP : CompletedLisse.rationalRing ell P ≅
      sectionRing P.X (condensedRingObj (Profinite.continuousMapRingObj EP) P.X))
    (χQ : CompletedLisse.rationalRing ell Q ≅
      sectionRing Q.X (condensedRingObj (Profinite.continuousMapRingObj EQ) Q.X))
    (hχP : IsCoefficientTransport ell P EP eP χP)
    (hχQ : IsCoefficientTransport ell Q EQ eQ χQ)
    (cP : CompletedLisse.Comparison ell P) (cQ : CompletedLisse.Comparison ell Q)
    (o : CompletedLisse.Operation ell a cP cQ) :
    ∃! δ : scalarRealization ell P EP χP ⋙
        InternalModuleOperations.upperStar (Profinite.padicAlgClRingObj ell) a.scheme ≅
      o.modules.rationalAmbient ⋙ scalarRealization ell Q EQ χQ,
      ∀ (M : SheafOfModules.{u + 1}
          ((adicLisseForget P.X).obj (CompletedLisse.rationalRing ell P)))
        (V : P.X.ProEt) (x : M.val.obj (op V)),
        (δ.hom.app M).val.app (op ((proEtaleBaseChange a.scheme).obj V))
          (((InternalModuleOperations.adjunction (Profinite.padicAlgClRingObj ell)
            a.scheme).unit.app ((scalarRealization ell P EP χP).obj M)).val.app (op V)
              (completedAdicChangeTensor P.X (χP.hom ≫ finiteSectionLeg ell EP P.X)
                M (op V) 1 x)) =
        completedAdicChangeTensor Q.X (χQ.hom ≫ finiteSectionLeg ell EQ Q.X)
          (o.modules.rationalAmbient.obj M) (op ((proEtaleBaseChange a.scheme).obj V)) 1
          (((o.modules.rationalAdjunction.unit.app M).val.app (op V)) x) := by
  sorry


/-- Exact automorphism inverse image is the published action used for strict Weil pairs.
Source: curve-heart proof, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
abbrev action (ell : ℕ) [Fact ell.Prime] {T : Scheme.{u}} (g : T ≅ T) :=
  CondensedRing.StrictWeil.action (Profinite.padicAlgClRingObj ell) g

/-- The canonical square of ordinary inverse images from composition and the given square.
Source: curve-heart proof, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def pullSquare (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (gX : X ≅ X) (gY : Y ≅ Y) (h : gX.hom ≫ f = f ≫ gY.hom) :
    pull ell gY.hom ⋙ pull ell f ≅ pull ell f ⋙ pull ell gX.hom :=
  (CondensedRing.upperStarComp (Profinite.padicAlgClRingObj ell) f gY.hom).symm ≪≫
    CondensedRing.upperStarCongr (Profinite.padicAlgClRingObj ell) h.symm ≪≫
    CondensedRing.upperStarComp (Profinite.padicAlgClRingObj ell) gX.hom f

/-- The same canonical square on total derived pullback and exact automorphism actions.
Source: curve-heart proof, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def derivedPullSquare (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (gX : X ≅ X) (gY : Y ≅ Y) (h : gX.hom ≫ f = f ≫ gY.hom) :
    action ell gY ⋙ derivedPull ell f ≅ derivedPull ell f ⋙ action ell gX :=
  Functor.isoWhiskerLeft (action ell gY)
      (CondensedRing.leftDerivedUpperStarIsoMapDerivedCategory
        (Profinite.padicAlgClRingObj ell) f) ≪≫
    (Functor.mapDerivedCategoryCompIso (pull ell gY.hom) (pull ell f)).symm ≪≫
    Functor.mapDerivedCategoryNatIso (pullSquare ell f gX gY h) ≪≫
    Functor.mapDerivedCategoryCompIso (pull ell f) (pull ell gX.hom) ≪≫
    Functor.isoWhiskerRight
      (CondensedRing.leftDerivedUpperStarIsoMapDerivedCategory
        (Profinite.padicAlgClRingObj ell) f).symm (action ell gX)

/-- Ordinary direct-image comparison is the actual adjunction mate of the pullback square.
Source: curve-heart proof, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def pushSquare (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (gX : X ≅ X) (gY : Y ≅ Y) (h : gX.hom ≫ f = f ≫ gY.hom) :
    push ell f ⋙ pull ell gY.hom ⟶ pull ell gX.hom ⋙ push ell f :=
  (mateEquiv
    (CondensedRing.upperStarLowerStarAdjunction (Profinite.padicAlgClRingObj ell) f)
    (CondensedRing.upperStarLowerStarAdjunction (Profinite.padicAlgClRingObj ell) f)
    (.mk _ _ _ _ (pullSquare ell f gX gY h).hom)).natTrans

/-- Total derived direct-image comparison is the actual mate for the derived adjunction.
Source: curve-heart proof, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def derivedPushSquare (ell : ℕ) [Fact ell.Prime] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (gX : X ≅ X) (gY : Y ≅ Y) (h : gX.hom ≫ f = f ≫ gY.hom) :
    derivedPush ell f ⋙ action ell gY ⟶ action ell gX ⋙ derivedPush ell f :=
  (mateEquiv
    (CondensedRing.derivedUpperStarLowerStarAdjunction (Profinite.padicAlgClRingObj ell) f)
    (CondensedRing.derivedUpperStarLowerStarAdjunction (Profinite.padicAlgClRingObj ell) f)
    (.mk _ _ _ _ (derivedPullSquare ell f gX gY h).hom)).natTrans

/-- Naturality of the specified bottom comparison in the actual ambient derived category.
Source: curve-heart proof, Step 3, lowest-cohomology identification
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: the lower-truncation projection is natural, and so is the published truncated
bottom isomorphism. Whisker the former by derived pushforward and ordinary cohomology,
and compose its naturality square with the latter's square. This is the equation below.
For objects in degrees at least m the components are invertible by the curve theorem. -/
theorem bottom_naturality (ell : ℕ) [Fact ell.Prime]
    {X Y : Scheme.{u}} (f : X ⟶ Y) (m : ℤ)
    {M N : Ambient ell X} (a : M ⟶ N) :
    (cohomology ell Y m).map ((derivedPush ell f).map a) ≫ bottomMap ell f m N =
      bottomMap ell f m M ≫ (push ell f).map ((cohomology ell X m).map a) := by
  sorry

/-- Every adjunction and the bottom comparison commute with compatible automorphisms.
The mates in this statement are constructed above, so their normalizations are fixed.
Source: curve-heart proof, Steps 0--4, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: an isomorphism of schemes induces an exact equivalence of coefficient-module
categories. Composition comparisons give pullSquare. Their exact derived functors give
derivedPullSquare. The mate construction gives the displayed unit and counit equations;
using the inverse automorphisms proves both mates invertible. Exact inverse image
commutes with cycles, boundaries and quotients. Apply it to the truncation-unit and
cycle-quotient construction of bottomMap. This gives the displayed cohomology square.
It identifies the derived-unit equation with the ordinary-unit equation in bottom
degree. Applying this simultaneously to j and i gives all the immersion-pair maps.
For finite-field models specialize the compatible automorphisms to modelFrobenius;
the resulting commuting equations are exactly the morphism equations for Weil pairs. -/
theorem automorphism_calculus (ell : ℕ) [Fact ell.Prime]
    {X Y : Scheme.{u}} (f : X ⟶ Y) (gX : X ≅ X) (gY : Y ≅ Y)
    (h : gX.hom ≫ f = f ≫ gY.hom) :
    IsIso (pushSquare ell f gX gY h) ∧
    IsIso (derivedPushSquare ell f gX gY h) ∧
    (∀ M : Modules ell Y,
      (pull ell gY.hom).map
          ((CondensedRing.upperStarLowerStarAdjunction
            (Profinite.padicAlgClRingObj ell) f).unit.app M) ≫
        (pushSquare ell f gX gY h).app ((pull ell f).obj M) =
      (CondensedRing.upperStarLowerStarAdjunction
        (Profinite.padicAlgClRingObj ell) f).unit.app ((pull ell gY.hom).obj M) ≫
        (push ell f).map ((pullSquare ell f gX gY h).hom.app M)) ∧
    (∀ N : Modules ell X,
      (pull ell f).map ((pushSquare ell f gX gY h).app N) ≫
        (CondensedRing.upperStarLowerStarAdjunction
          (Profinite.padicAlgClRingObj ell) f).counit.app ((pull ell gX.hom).obj N) =
      (pullSquare ell f gX gY h).hom.app ((push ell f).obj N) ≫
        (pull ell gX.hom).map ((CondensedRing.upperStarLowerStarAdjunction
          (Profinite.padicAlgClRingObj ell) f).counit.app N)) ∧
    (∀ K : Ambient ell Y,
      (action ell gY).map
          ((CondensedRing.derivedUpperStarLowerStarAdjunction
            (Profinite.padicAlgClRingObj ell) f).unit.app K) ≫
        (derivedPushSquare ell f gX gY h).app ((derivedPull ell f).obj K) =
      (CondensedRing.derivedUpperStarLowerStarAdjunction
        (Profinite.padicAlgClRingObj ell) f).unit.app ((action ell gY).obj K) ≫
        (derivedPush ell f).map ((derivedPullSquare ell f gX gY h).hom.app K)) ∧
    (∀ K : Ambient ell X,
      (derivedPull ell f).map ((derivedPushSquare ell f gX gY h).app K) ≫
        (CondensedRing.derivedUpperStarLowerStarAdjunction
          (Profinite.padicAlgClRingObj ell) f).counit.app ((action ell gX).obj K) =
      (derivedPullSquare ell f gX gY h).hom.app ((derivedPush ell f).obj K) ≫
        (action ell gX).map ((CondensedRing.derivedUpperStarLowerStarAdjunction
          (Profinite.padicAlgClRingObj ell) f).counit.app K)) ∧
    (∀ (m : ℤ) (M : Ambient ell X),
      ((pull ell gY.hom).mapDerivedCategoryHomologyFunctorIso m).hom.app
          ((derivedPush ell f).obj M) ≫
        (cohomology ell Y m).map ((derivedPushSquare ell f gX gY h).app M) ≫
        bottomMap ell f m ((action ell gX).obj M) =
      (pull ell gY.hom).map (bottomMap ell f m M) ≫
        (pushSquare ell f gX gY h).app ((cohomology ell X m).obj M) ≫
        (push ell f).map
          (((pull ell gX.hom).mapDerivedCategoryHomologyFunctorIso m).hom.app M)) := by
  sorry

/-- The exact-pullback cohomology identification itself respects compatible automorphisms.
Source: curve-heart proof, Steps 0--4, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: pullSquare is obtained by functor composition and the given equality of scheme
maps. The homology comparison for an exact functor is natural under exact natural
isomorphisms and composition: on representing complexes each map is induced on kernels
and then on their quotient by boundaries. Its two composites are therefore equal. The
exact-functor identification of total derived pullback gives the displayed equation. -/
theorem automorphism_pull_cohomology (ell : ℕ) [Fact ell.Prime]
    {X Y : Scheme.{u}} (f : X ⟶ Y) (gX : X ≅ X) (gY : Y ≅ Y)
    (h : gX.hom ≫ f = f ≫ gY.hom) (m : ℤ) (K : Ambient ell Y) :
    (pull ell gX.hom).map ((pullCohomology ell f m).hom.app K) ≫
      ((pull ell gX.hom).mapDerivedCategoryHomologyFunctorIso m).hom.app
        ((derivedPull ell f).obj K) =
    (pullSquare ell f gX gY h).inv.app ((cohomology ell Y m).obj K) ≫
      (pull ell f).map
        (((pull ell gY.hom).mapDerivedCategoryHomologyFunctorIso m).hom.app K) ≫
      (pullCohomology ell f m).hom.app ((action ell gY).obj K) ≫
      (cohomology ell X m).map ((derivedPullSquare ell f gX gY h).hom.app K) := by
  sorry

/-- Good truncations commute with automorphism pullback with the actual truncation maps.
Source: curve-heart proof, Steps 1--4, automorphism paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus).

Proof: the exact-functor truncation comparisons are the unique factorization of the
pulled-back good-truncation inclusion and projection. Their defining factorizations give
the two equations. Exactness preserves the same cohomology vanishing intervals and
constructibility, so the comparisons restrict to the bounded constructible category. -/
theorem automorphism_truncations (ell : ℕ) [Fact ell.Prime]
    {T : Scheme.{u}} (g : T ≅ T) :
    (∀ K : Ambient ell T,
      boundedConstructible ell T ((action ell g).obj K) ↔ boundedConstructible ell T K) ∧
    (∀ (m : ℤ) (K : Ambient ell T),
      ((pull ell g.hom).mapDerivedCategoryTruncLEIso m).hom.app K ≫
        (DerivedCategory.TStructure.t.truncLEι m).app ((action ell g).obj K) =
      (action ell g).map ((DerivedCategory.TStructure.t.truncLEι m).app K)) ∧
    (∀ (m : ℤ) (K : Ambient ell T),
      (action ell g).map ((DerivedCategory.TStructure.t.truncGEπ m).app K) ≫
        ((pull ell g.hom).mapDerivedCategoryTruncGEIso m).hom.app K =
      (DerivedCategory.TStructure.t.truncGEπ m).app ((action ell g).obj K)) := by
  sorry

/-- Induced Frobenius isomorphism on the upper standard truncation, for any compatible
scheme automorphism and in particular geometric Frobenius of a finite-field model.
Source: curve-heart proof, Frobenius paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def truncationWeilLE (ell : ℕ) [Fact ell.Prime] {T : Scheme.{u}}
    (g : T ≅ T) (K : Ambient ell T) (φ : (action ell g).obj K ≅ K) (m : ℤ) :
    (action ell g).obj ((DerivedCategory.TStructure.t.truncLE m).obj K) ≅
      (DerivedCategory.TStructure.t.truncLE m).obj K :=
  ((pull ell g.hom).mapDerivedCategoryTruncLEIso m).app K ≪≫
    (DerivedCategory.TStructure.t.truncLE m).mapIso φ

/-- Induced Frobenius isomorphism on the lower standard truncation.
Source: curve-heart proof, Frobenius paragraph
(blueprint: lem-per-condensed-curve-restriction-calculus). -/
def truncationWeilGE (ell : ℕ) [Fact ell.Prime] {T : Scheme.{u}}
    (g : T ≅ T) (K : Ambient ell T) (φ : (action ell g).obj K ≅ K) (m : ℤ) :
    (action ell g).obj ((DerivedCategory.TStructure.t.truncGE m).obj K) ≅
      (DerivedCategory.TStructure.t.truncGE m).obj K :=
  ((pull ell g.hom).mapDerivedCategoryTruncGEIso m).app K ≪≫
    (DerivedCategory.TStructure.t.truncGE m).mapIso φ

end AlgebraicGeometry.ProEtale.CurveRestriction
