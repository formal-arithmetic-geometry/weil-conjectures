module

public import Mathlib.NumberTheory.Padics.PadicIntegers
public import Mathlib.Algebra.DirectSum.Basic
import Mathlib.Algebra.DirectSum.Finsupp
import WeilConjectures.Mathlib.NumberTheory.Padics.PadicIntegers
import WeilConjectures.Mathlib.RingTheory.Algebraic.Basic

/-!
# Independent powers in an `r`-adic integer

Source: the counterexample paragraph of
`literature/blueprint/latest/blueprint/part-six-operations/sec-smooth-base-change/`
`sec-sbc-uniform/sk-rem-sbc-scope/sk-rem-sf-fullcd-scope.md`,
sentence "Pick `g` with `χ(g)=1` and countably many `ℚ`-linearly independent elements of the
pro-`r` part of the closed procyclic subgroup generated by `g`; they span an abstract subgroup
`H ≅ ⊕_ℕ ℤ`". The abstract countable free subgroup is placed in the pro-`r` factor there; the
construction through a transcendental element is supplied by the agent
(blueprint: lem-sf-padic-powers-independent).
-/

@[expose] public section

set_option autoImplicit false

/-- For every prime `r`, some `r`-adic integer `t` has powers `(t ^ n)_{n ≥ 0}` linearly
independent over `ℤ`; equivalently the additive map `⊕_{n ∈ ℕ} ℤ → ℤ_[r]`,
`(a_n) ↦ ∑ a_n t ^ n`, is injective. The direct-sum map is the canonical additive homomorphism
whose restriction to the `n`-th summand sends an integer `a` to `(a : ℤ_[r]) * t ^ n`.

Proof (node lem-sf-padic-powers-independent):
1. By the existence theorem for `p`-adic transcendence with `p = r`
   (`PadicInt.exists_transcendental`, blueprint: lem-sf-padic-transcendental-existence), there is
   `t : ℤ_[r]` transcendental over `ℤ`; the prime hypothesis is the instance `Fact r.Prime`.
2. Powers of a transcendental element are linearly independent
   (`Transcendental.linearIndependent_pow`, blueprint:
   lem-sf-transcendental-powers-linear-independent), applied with `R = ℤ`, `A = ℤ_[r]`, `x = t`
   and the canonical `ℤ`-algebra structure, gives `LinearIndependent ℤ (fun n => t ^ n)`.
3. Unfolding `LinearIndependent`: a finitely supported family `a : ℕ →₀ ℤ` with
   `∑ a_n t ^ n = 0` vanishes; the direct-sum map sends `a` to this sum, so its kernel is zero
   and it is injective (this covers empty support and the coefficient at `n = 0`).

Source: the counterexample paragraph cited in the module docstring
(blueprint: lem-sf-padic-powers-independent).
-/
theorem exists_padic_powers_independent (r : ℕ) [Fact r.Prime] :
    ∃ t : ℤ_[r],
      LinearIndependent ℤ (fun n : ℕ => t ^ n) ∧
        Function.Injective
          (DirectSum.toAddMonoid
            (fun n : ℕ =>
              (AddMonoidHom.mulRight (t ^ n)).comp
                (Int.castRingHom (ℤ_[r])).toAddMonoidHom)) := by
  classical
  obtain ⟨t, ht⟩ := PadicInt.exists_transcendental r
  have hli : LinearIndependent ℤ (fun n : ℕ ↦ t ^ n) := ht.linearIndependent_pow
  refine ⟨t, hli, ?_⟩
  let e := finsuppLEquivDirectSum ℤ ℤ ℕ
  let f := DirectSum.toAddMonoid (fun n : ℕ ↦
    (AddMonoidHom.mulRight (t ^ n)).comp (Int.castRingHom (ℤ_[r])).toAddMonoidHom)
  have hf : f = (Finsupp.linearCombination ℤ (fun n : ℕ ↦ t ^ n)).toAddMonoidHom.comp
      e.symm.toAddMonoidHom := by
    apply DirectSum.addHom_ext
    intro n a
    change f (DirectSum.of (fun _ : ℕ ↦ ℤ) n a) =
      Finsupp.linearCombination ℤ (fun n : ℕ ↦ t ^ n)
        (e.symm (DirectSum.of (fun _ : ℕ ↦ ℤ) n a))
    rw [show e.symm (DirectSum.of (fun _ : ℕ ↦ ℤ) n a) = Finsupp.single n a from
      finsuppLEquivDirectSum_symm_lof ℤ ℤ ℕ n a]
    simp [f, zsmul_eq_mul]
  change Function.Injective f
  rw [hf]
  exact hli.finsuppLinearCombination_injective.comp e.symm.injective

end
