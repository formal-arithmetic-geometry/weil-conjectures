/-!
# The absolute Galois group of a finite field

Source: literature/blueprint/main-20261015/blueprint/sec-six-functors-basics/sk-lem-base-field-cd/
sk-lem-base-field-cd-galois-group.md (blueprint: lemma-cohomological-dimension-base-field--2).

## Main statements

* For a finite field, the unique degree-`n` intermediate field in a separable closure is
  the root field of `X^(q^n) - X` and its automorphism group is generated by Frobenius.
* The absolute Galois group is the profinite completion of the infinite cyclic group,
  with arithmetic Frobenius corresponding to its canonical generator.
-/

@[expose] public section

set_option autoImplicit false

universe u v

open scoped Polynomial

open CategoryTheory

private theorem hom_ext_of_dense
    {G : Type v} [Group G] [TopologicalSpace G] {a : G}
    (hd : DenseRange (zpowersHom G a))
    {A : Type u} [Group A] [TopologicalSpace A] [T2Space A]
    (r s : G →* A) (hr : Continuous r) (hs : Continuous s) (h : r a = s a) :
    r = s := by
  apply DFunLike.ext'
  apply hd.equalizer hr hs
  funext z
  simp only [Function.comp_apply, zpowersHom_apply, map_zpow, h]

private theorem completion_equiv
    (P : ProfiniteGrp.{v}) (a : P)
    (hd : DenseRange (zpowersHom P a))
    (hq : ∀ H : FiniteIndexNormalSubgroup (Multiplicative ℤ),
      ∃ f : P →* (ProfiniteGrp.ProfiniteCompletion.diagram
          (GrpCat.of (Multiplicative ℤ))).obj H,
        Continuous f ∧ f a = QuotientGroup.mk (Multiplicative.ofAdd (1 : ℤ))) :
    ∃ e : P ≃ₜ* ProfiniteGrp.ProfiniteCompletion.completion
        (GrpCat.of (Multiplicative ℤ)),
      e a = ProfiniteGrp.ProfiniteCompletion.etaFn (GrpCat.of (Multiplicative ℤ))
        (Multiplicative.ofAdd (1 : ℤ)) := by
  classical
  let Z := GrpCat.of (Multiplicative ℤ)
  let D := ProfiniteGrp.ProfiniteCompletion.diagram Z
  let f (H : FiniteIndexNormalSubgroup (Multiplicative ℤ)) : P →* D.obj H :=
    (hq H).choose
  have hf (H) : Continuous (f H) := (hq H).choose_spec.1
  have hfa (H) : f H a = QuotientGroup.mk (Multiplicative.ofAdd (1 : ℤ)) :=
    (hq H).choose_spec.2
  have hcompat {H J : FiniteIndexNormalSubgroup (Multiplicative ℤ)} (h : H ⟶ J) :
      ((D.map h).hom.toMonoidHom).comp (f H) = f J := by
    apply hom_ext_of_dense hd _ _ ((D.map h).hom.continuous_toFun.comp (hf H)) (hf J)
    simp only [MonoidHom.comp_apply, hfa]
    rfl
  let F : P →* ProfiniteGrp.ProfiniteCompletion.completion Z := {
    toFun x := ⟨fun H ↦ f H x, fun {_ _} h ↦ DFunLike.congr_fun (hcompat h) x⟩
    map_one' := Subtype.ext (funext fun H ↦ map_one (f H))
    map_mul' x y := Subtype.ext (funext fun H ↦ map_mul (f H) x y) }
  have hF : Continuous F :=
    continuous_induced_rng.mpr (continuous_pi fun H ↦ hf H)
  have hFa : F a = ProfiniteGrp.ProfiniteCompletion.etaFn Z
      (Multiplicative.ofAdd (1 : ℤ)) := by
    apply Subtype.ext
    funext H
    exact hfa H
  have hFpow (z : Multiplicative ℤ) :
      F (a ^ z.toAdd) = ProfiniteGrp.ProfiniteCompletion.etaFn Z z := by
    apply Subtype.ext
    funext H
    change f H (a ^ z.toAdd) = QuotientGroup.mk z
    rw [map_zpow, hfa]
    have hz : (Multiplicative.ofAdd (1 : ℤ)) ^ z.toAdd = z := by
      apply Multiplicative.toAdd.injective
      simp
    exact (map_zpow (QuotientGroup.mk' H.toSubgroup) _ _).symm.trans
      (congrArg (QuotientGroup.mk' H.toSubgroup) hz)
  have hsurj : Function.Surjective F := by
    have hdF : DenseRange F :=
      (ProfiniteGrp.ProfiniteCompletion.denseRange Z).mono (by
        rintro _ ⟨z, rfl⟩
        exact ⟨a ^ (Multiplicative.toAdd z : ℤ), hFpow z⟩)
    have hclosed : IsClosed (Set.range F) := hF.isClosedMap.isClosed_range
    rw [← Set.range_eq_univ, ← closure_eq_iff_isClosed.mpr hclosed, hdF.closure_eq]
  have hinj : Function.Injective F := by
    apply (injective_iff_map_eq_one F).mpr
    intro x hx
    apply ProfiniteGrp.toLimit_injective P
    apply Subtype.ext
    funext U
    have : Finite (P.diagram.obj U) := inferInstanceAs (Finite (P ⧸ U.toOpenSubgroup.toSubgroup))
    let π := (ProfiniteGrp.proj U).hom.toMonoidHom
    let z := π.comp (zpowersHom P a)
    have : z.ker.FiniteIndex := Subgroup.finiteIndex_ker z
    let H : FiniteIndexNormalSubgroup (Multiplicative ℤ) :=
      FiniteIndexNormalSubgroup.ofSubgroup z.ker
    let q : D.obj H →* (P.diagram.obj U) := QuotientGroup.lift z.ker z le_rfl
    have : DiscreteTopology (D.obj H) := ⟨rfl⟩
    have hqcont : Continuous q := continuous_of_discreteTopology
    have heq : q.comp (f H) = π := by
      apply hom_ext_of_dense hd _ _ (hqcont.comp (hf H))
        (ProfiniteGrp.proj U).hom.continuous_toFun
      simp only [MonoidHom.comp_apply, hfa]
      change z (Multiplicative.ofAdd (1 : ℤ)) = π a
      simp [z, zpowersHom_apply]
    have hxH : f H x = 1 := congrArg (fun c ↦ c.val H) hx
    change π x = π 1
    rw [← DFunLike.congr_fun heq x, MonoidHom.comp_apply, hxH, map_one, map_one]
  let e : P ≃ₜ* ProfiniteGrp.ProfiniteCompletion.completion Z := {
    Continuous.homeoOfEquivCompactToT2
      (f := Equiv.ofBijective F ⟨hinj, hsurj⟩) hF with
    map_mul' := F.map_mul' }
  exact ⟨e, hFa⟩

private theorem frobenius_dense
    (K : Type u) (Ks : Type v) [Field K] [Field Ks] [Fintype K] [Algebra K Ks]
    [IsSepClosure K Ks] :
    DenseRange (zpowersHom (Gal(Ks / K))
      (FiniteField.frobeniusAlgEquivOfAlgebraic K Ks)) := by
  let φ := FiniteField.frobeniusAlgEquivOfAlgebraic K Ks
  let H : ClosedSubgroup (Gal(Ks / K)) :=
    ⟨(Subgroup.zpowers φ).topologicalClosure, (Subgroup.zpowers φ).isClosed_topologicalClosure⟩
  have hf : IntermediateField.fixedField H.toSubgroup = ⊥ := by
    apply le_antisymm ?_ bot_le
    intro x hx
    apply IntermediateField.mem_bot.mpr
    apply (FiniteField.frobeniusAlgEquivOfAlgebraic_apply_eq_self_iff K Ks).mp
    exact ((IntermediateField.mem_fixedField_iff H.toSubgroup x).mp hx) φ
      ((Subgroup.zpowers φ).le_topologicalClosure (Subgroup.mem_zpowers φ))
  have htop : H.toSubgroup = ⊤ := by
    rw [← InfiniteGalois.fixingSubgroup_fixedField H, hf,
      IntermediateField.fixingSubgroup_bot]
  change Dense (Subgroup.zpowers φ : Set (Gal(Ks / K)))
  rw [dense_iff_closure_eq, ← Subgroup.topologicalClosure_coe]
  exact congrArg (fun J : Subgroup (Gal(Ks / K)) ↦ (J : Set (Gal(Ks / K)))) htop

/-- The finite-field absolute Galois group statement, including its finite cyclic quotients.

Source: literature/blueprint/main-20261015/blueprint/sec-six-functors-basics/
sk-lem-base-field-cd/sk-lem-base-field-cd-galois-group.md, paragraphs 1--2
(blueprint: lemma-cohomological-dimension-base-field--2).

Proof:
1. Use `exists_unique_subfield_of_closure` in the algebraic closure supplied by
   `IsSepClosure.isAlgClosure_of_perfectField`. Convert its root subfield into an
   intermediate field using its containment of the base field.
2. Apply `Module.card_eq_pow_finrank` and injectivity of powers of `q > 1` to obtain
   degree `n`. Conversely a positive degree implies finite-dimensionality, so the same
   cardinality formula and subfield uniqueness give uniqueness by degree.
3. Mathlib's finite-field Frobenius has order equal to the degree and its first `n`
   powers give all automorphisms. Convert their `Fin n` indices to `ZMod n`.
4. Frobenius powers are dense: the closed subgroup they generate has fixed field `K`,
   since Frobenius-fixed elements are precisely the base-field elements. The closed
   subgroup form of infinite Galois correspondence identifies this subgroup with the
   whole absolute Galois group (`frobenius_dense`).
5. For each finite-index subgroup `H` of multiplicative `ℤ`, let `g` be the image of
   `1` in its quotient. Restriction to the degree-`orderOf g` root field, followed by
   the homomorphism sending its Frobenius to `g`, gives a continuous quotient map.
6. The maps are compatible because they agree on dense Frobenius powers. They give a
   continuous homomorphism to the completion. Its image contains the dense image of
   `ℤ`; compactness makes it surjective. Every open normal quotient of the Galois group
   factors through one of these coordinates: take the kernel of its composite with
   the Frobenius-power homomorphism from `ℤ`. Finite quotients separate points, so the
   constructed map is injective. Compact-to-Hausdorff gives the continuous inverse.
   The value on Frobenius is the compatible tuple of images of `1` by construction.

The topological argument is the coordinatewise inverse-limit argument of blueprint
paragraph 2, using all finite cyclic quotients directly rather than identifying an
indexing category with positive integers ordered by divisibility. Mathlib's profinite
Galois group instance supplies compactness via the Krull inverse-limit theorem.
-/
theorem finiteField_absoluteGaloisGroup
    (K : Type u) (Ks : Type v) [Field K] [Field Ks] [Fintype K] [Algebra K Ks]
    [IsSepClosure K Ks] :
    ∃ φ : Gal(Ks / K),
      (∀ x : Ks, φ x = x ^ Fintype.card K) ∧
      (∀ n : ℕ, 1 ≤ n →
        ∃ Kn : IntermediateField K Ks,
          Module.finrank K Kn = n ∧
          (∀ E : IntermediateField K Ks, Module.finrank K E = n → E = Kn) ∧
          (∀ x : Ks,
            x ∈ Kn ↔
              Polynomial.eval₂ (algebraMap K Ks) x
                (Polynomial.X ^ (Fintype.card K ^ n) - Polynomial.X) = 0) ∧
          IsGalois K Kn ∧
          ∃ φn : Kn ≃ₐ[K] Kn,
            (∀ x : Kn, φn x = x ^ Fintype.card K) ∧
            orderOf φn = n ∧
            (∀ g : Kn ≃ₐ[K] Kn, ∃ j : ZMod n, g = φn ^ j.val)) ∧
      ∃ e : Gal(Ks / K) ≃ₜ* ProfiniteGrp.ProfiniteCompletion.completion
          (GrpCat.of (Multiplicative ℤ)),
        e φ =
          ProfiniteGrp.ProfiniteCompletion.etaFn (GrpCat.of (Multiplicative ℤ))
            (Multiplicative.ofAdd (1 : ℤ)) := by
  classical
  have : IsAlgClosure K Ks := IsSepClosure.isAlgClosure_of_perfectField K Ks
  have hfinite :
    ∀ n : ℕ, 1 ≤ n →
        ∃ Kn : IntermediateField K Ks,
          Module.finrank K Kn = n ∧
          (∀ E : IntermediateField K Ks, Module.finrank K E = n → E = Kn) ∧
          (∀ x : Ks,
            x ∈ Kn ↔
              Polynomial.eval₂ (algebraMap K Ks) x
                (Polynomial.X ^ (Fintype.card K ^ n) - Polynomial.X) = 0) ∧
          IsGalois K Kn ∧
          ∃ φn : Kn ≃ₐ[K] Kn,
            (∀ x : Kn, φn x = x ^ Fintype.card K) ∧
            orderOf φn = n ∧
            (∀ g : Kn ≃ₐ[K] Kn, ∃ j : ZMod n, g = φn ^ j.val) := by
    intro n hn
    obtain ⟨p, hpchar, a, hp, hq⟩ := FiniteField.card' K
    obtain ⟨E, hmem, hcard, huniq, hbase, _⟩ :=
      FiniteField.exists_unique_subfield_of_closure p a (Fintype.card K) hp a.property
        hq K (by simp) Ks n hn
    let Kn : IntermediateField K Ks := E.toIntermediateField fun x ↦
      hbase (RingHom.mem_fieldRange_self _ x)
    have hc : Nat.card Kn = Fintype.card K ^ n := hcard
    have : Finite Kn := (Nat.card_pos_iff.mp (by
      rw [hc]
      exact pow_pos Fintype.card_pos n)).2
    let _ : Fintype Kn := Fintype.ofFinite Kn
    have hdegree : Module.finrank K Kn = n := by
      apply (Nat.pow_right_injective (Fintype.one_lt_card (α := K)))
      change Fintype.card K ^ Module.finrank K Kn = Fintype.card K ^ n
      rw [← Module.card_eq_pow_finrank (K := K), ← Nat.card_eq_fintype_card]
      exact hc
    refine ⟨Kn, hdegree, ?_, ?_, inferInstance,
      FiniteField.frobeniusAlgEquivOfAlgebraic K Kn, (fun x ↦ rfl), ?_, ?_⟩
    · intro L hL
      have : FiniteDimensional K L := Module.finite_of_finrank_pos (by omega)
      have : Finite L := Module.finite_of_finite K
      let _ : Fintype L := Fintype.ofFinite L
      have heq : L.toSubfield = E := huniq L.toSubfield (by
        change Nat.card L = _
        rw [Nat.card_eq_fintype_card, Module.card_eq_pow_finrank (K := K), hL])
      exact IntermediateField.toSubfield_injective heq
    · intro x
      change x ∈ E ↔ _
      simpa only [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        sub_eq_zero] using hmem x
    · rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, hdegree]
    · intro g
      obtain ⟨j, hj⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow K Kn).2 g
      have : NeZero n := ⟨by omega⟩
      refine ⟨(j.val : ZMod n), ?_⟩
      rw [ZMod.val_natCast_of_lt (by omega)]
      exact hj.symm
  refine ⟨FiniteField.frobeniusAlgEquivOfAlgebraic K Ks, (fun x ↦ rfl), hfinite, ?_⟩
  apply completion_equiv (ProfiniteGrp.of (Gal(Ks / K)))
    (FiniteField.frobeniusAlgEquivOfAlgebraic K Ks) (frobenius_dense K Ks)
  intro H
  let Q := (ProfiniteGrp.ProfiniteCompletion.diagram
    (GrpCat.of (Multiplicative ℤ))).obj H
  have : Finite Q := inferInstanceAs (Finite (Multiplicative ℤ ⧸ H.toSubgroup))
  let g : Q := QuotientGroup.mk (Multiplicative.ofAdd (1 : ℤ))
  obtain ⟨Kn, hdegree, _, _, hgal, φn, hφn, horder, hpow⟩ :=
    hfinite (orderOf g) (orderOf_pos g)
  have : FiniteDimensional K Kn := Module.finite_of_finrank_pos (by
    rw [hdegree]
    exact orderOf_pos g)
  have : IsGalois K Kn := hgal
  have hgen : ∀ σ : Gal(Kn / K), σ ∈ Subgroup.zpowers φn := by
    intro σ
    obtain ⟨j, rfl⟩ := hpow σ
    exact ⟨(j.val : ℤ), zpow_natCast φn j.val⟩
  let t : Gal(Kn / K) →* Q := monoidHomOfForallMemZpowers hgen horder.symm.dvd
  let r : Gal(Ks / K) →* Gal(Kn / K) := AlgEquiv.restrictNormalHom Kn
  have hr : r (FiniteField.frobeniusAlgEquivOfAlgebraic K Ks) = φn := by
    ext x
    rw [AlgEquiv.restrictNormalHom_apply]
    exact (congrArg Subtype.val (hφn x)).symm
  have : DiscreteTopology (Gal(Kn / K)) := inferInstance
  refine ⟨t.comp r, (continuous_of_discreteTopology : Continuous t).comp
    (InfiniteGalois.restrictNormalHom_continuous Kn), ?_⟩
  change t (r (FiniteField.frobeniusAlgEquivOfAlgebraic K Ks)) = g
  rw [hr]
  exact monoidHomOfForallMemZpowers_apply_gen hgen horder.symm.dvd

end
