module

public import WeilConjectures.Mathlib.AlgebraicGeometry.Sites.Etale
public import WeilConjectures.Mathlib.CategoryTheory.NatIso
public import WeilConjectures.Mathlib.CategoryTheory.Sites.Sheaf
public import WeilConjectures.SixFunctors.LowerShriek.OpenImmersion.Etale

/-!
# Restriction along an open cover is conservative

Let `g i : W i ⟶ X` be a jointly surjective family of open immersions. This file proves that
a morphism of sheaves on the small étale site of `X` which becomes invertible after
restricting along every `g i` is itself invertible
(`AlgebraicGeometry.Etale.isIso_of_isIso_openImmersionRestriction`).

The statement is proved objectwise, from the general local criterion
`CategoryTheory.Sheaf.isIso_of_isIso_app_of_mem`: a morphism of sheaves is invertible as soon
as, at every object of the site, it is invertible on the members of some covering sieve. At an
étale `X`-scheme `V` the covering sieve used is the one generated by the base changes
`V ×_X W i` (`AlgebraicGeometry.Scheme.Etale.ofArrows_baseChange_mem_smallEtaleTopology`).
Every member of that sieve factors through one of the base changes, hence maps into the range
of the corresponding open immersion, where the objectwise statement below applies.

That objectwise statement holds because an étale `X`-scheme `V` mapping into the range of
`g i` is the image of the étale `W i`-scheme `V ×_X W i` under the localization functor
(`AlgebraicGeometry.Scheme.Etale.isoMapEtaleObj`). The sections of a restricted sheaf over an
étale `W i`-scheme are by definition the sections of the original sheaf over its image
(`AlgebraicGeometry.Etale.openImmersionRestriction_map_hom_app`), so invertibility of the
restricted morphism transports back along `CategoryTheory.NatTrans.isIso_app_of_iso`.

The comparison `j_! ⟶ j_*` for an open immersion `j` with clopen range, and its consequence
for a proper morphism, are deduced from this in
`WeilConjectures.SixFunctors.LowerShriek.Proper`, using the cover of `X` by `j` and by the
complement of its range.

## Main results

- `AlgebraicGeometry.Etale.isIso_app_of_isIso_openImmersionRestriction`: a morphism of sheaves
  whose restriction along an open immersion `j` is invertible is invertible at every étale
  `X`-scheme mapping into the range of `j`.
- `AlgebraicGeometry.Etale.isIso_of_isIso_openImmersionRestriction`: the restrictions along a
  jointly surjective family of open immersions are jointly conservative.
-/

@[expose] public section

universe u' u

open CategoryTheory Opposite

namespace AlgebraicGeometry

variable (A : Type u') [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
variable {X : Scheme.{u}} {G G' : Sheaf X.smallEtaleTopology A} (φ : G ⟶ G')

omit [Abelian A] [IsGrothendieckAbelian.{u + 1} A] in
/-- **Invertibility of `j^* φ` gives invertibility of `φ` over the range of `j`.** If `V` is
an étale `X`-scheme mapping into the range of `j`, it is the image of the étale `U`-scheme
`V ×_X U` under the localization functor, and the sections of `j^* G` over `V ×_X U` are the
sections of `G` over `V`.

```
   V ←──≅── V ×_X U        G(V) ←───≅──── (j^* G)(V ×_X U)
    ╲         │              │                │
     ╲ V.hom  │          φ_V │                │ (j^* φ)_{V ×_X U}
      ↘       ↓              ↓                ↓
        X ←── U           G'(V) ←──≅──── (j^* G')(V ×_X U)
          j
```
-/
lemma Etale.isIso_app_of_isIso_openImmersionRestriction {U : Scheme.{u}} (j : U ⟶ X)
    [IsOpenImmersion j] (h : IsIso ((Etale.openImmersionRestriction A j).map φ)) (V : X.Etale)
    (hV : Set.range V.hom.base ⊆ Set.range j.base) :
    IsIso (φ.hom.app (op V)) := by
  have h1 : IsIso (((Etale.openImmersionRestriction A j).map φ).hom.app
      (op (j.Etale.obj V))) := inferInstance
  rw [Etale.openImmersionRestriction_map_hom_app] at h1
  exact NatTrans.isIso_app_of_iso φ.hom (Scheme.Etale.isoMapEtaleObj j V hV).op.symm

omit [Abelian A] [IsGrothendieckAbelian.{u + 1} A] in
/-- **The restrictions along a jointly surjective family of open immersions are jointly
conservative.** A morphism of sheaves on the small étale site of `X` which becomes invertible
after restricting along every member of an open cover of `X` is invertible.

Each étale `X`-scheme `V` is covered by its base changes `V ×_X W i`, and every member of the
sieve they generate maps into the range of one of the open immersions, where the previous
lemma applies.

```
     V ×_X W i ─────→ V
         │            │
         ↓            ↓
        W i ───g i──→ X
```
-/
lemma Etale.isIso_of_isIso_openImmersionRestriction {ι : Type*} {W : ι → Scheme.{u}}
    (g : ∀ i, W i ⟶ X) [∀ i, IsOpenImmersion (g i)]
    (hg : ⋃ i, Set.range (g i).base = Set.univ)
    (h : ∀ i, IsIso ((Etale.openImmersionRestriction A (g i)).map φ)) :
    IsIso φ := by
  refine Sheaf.isIso_of_isIso_app_of_mem _ φ fun V ↦
    ⟨_, Scheme.Etale.ofArrows_baseChange_mem_smallEtaleTopology V g hg, ?_⟩
  rintro T f ⟨-, a, -, ⟨i⟩, rfl⟩
  exact Etale.isIso_app_of_isIso_openImmersionRestriction A φ (g i) (h i) T
    ((Scheme.Etale.range_hom_base_subset a).trans
      (Scheme.Etale.range_baseChange_hom_base_subset (g i) V))

end AlgebraicGeometry
