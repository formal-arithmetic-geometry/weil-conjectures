/-! # Ordinary tensor support for native open extension

Source: Stacks, Modules on Sites, Tag 0E8I.
(blueprint: lem-coef-native-open-tensor-ordinary-supported).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
set_option backward.isDefEq.respectTransparency true
set_option backward.isDefEq.respectTransparency.types true
set_option linter.style.haveILetI false
universe u
open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry AlgebraicGeometry.Scheme
open WeilConjectures.SemilinearSections
namespace WeilConjectures.CoefSupportOpenTensor

attribute [-instance] SemilinearSections.hasDerived SemilinearSections.moduleAbelian
  SemilinearSections.abelianSheafify SemilinearSections.locallyBijective
  SemilinearSections.sequenceSmall SemilinearSections.sliceSmall

variable (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
  [Algebra ℚ_[l] E] [FiniteDimensional ℚ_[l] E]

/-- Ordinary tensoring with an extended module stays in the image of open extension.
Source: Stacks, sites-modules.tex, lemma-j-shriek-and-tensor, Tag 0E8I.
(blueprint: lem-coef-native-open-tensor-ordinary-supported).

Proof: identify the open pro-etale site with the slice of the ambient site at
its subterminal open object. Take the product of this equivalence with the
coefficient index, with the vertical covering topology. The constant-section
isomorphism identifies the coefficient ring on the open with the restricted
ambient ring, naturally for all coefficient quotients. Uniqueness of left
adjoints identifies the transported localized extension with the native
extension. On the slice, extension by zero has sections locally generated by
sections indexed by lifts to the open object. Tensoring these generators with
ambient sections and restricting their second factors gives the localized
extension/tensor isomorphism of 0E8I. Its inverse inserts the open sections in
the ambient extension and takes their tensor product. The two composites are
the identity on the generators, hence on the sheafifications. Transport this
isomorphism back to the sequence sites: it exhibits the tensor as the extension
of the tensor of the original open module with the restricted ambient module,
which proves membership in the essential image. All maps are sheaf maps on the
sequence site, so coefficient-quotient compatibility is included. For the empty
open the extension and tensor are zero; the same argument applies to zero
coefficient rings. This assertion concerns ordinary modules only and does not
assert an adjunction normalization, tensorator, cochain comparison or flatness. -/
theorem nativeOpenTensor_ordinary_supported {X Z : Scheme.{u}} (j : X ⟶ Z)
    [IsOpenImmersion j]
    (M : coefficientSequenceModules.{u, u} l E X)
    (N : coefficientSequenceModules.{u, u} l E Z) :
    (ProEtale.VaryingRing.extension (compactSupportSystemLevel l E)
      (compactSupportSystemQuotient l E) j).essImage
        (ordinaryTensor.{u + 1, u, u} (coefficientSequenceTopology (ProEt.topology Z))
          (coefficientSequenceCommRingSheaf.{u, u} l E Z)
          ((ProEtale.VaryingRing.extension (compactSupportSystemLevel l E)
            (compactSupportSystemQuotient l E) j).obj M) N) := by
  let T := ordinaryTensor.{u + 1, u, u}
    (coefficientSequenceTopology (ProEt.topology Z))
    (coefficientSequenceCommRingSheaf.{u, u} l E Z)
    ((ProEtale.VaryingRing.extension (compactSupportSystemLevel l E)
      (compactSupportSystemQuotient l E) j).obj M) N
  haveI : IsIso ((AlgebraicGeometry.ProEtale.VaryingRing.moduleJAdj
      (compactSupportSystemLevel l E) (compactSupportSystemQuotient l E) j).counit.app T) :=
    nativeOpenTensor_ordinary_counit_isIso l E j M N
  exact Functor.essImage.ofIso
    (asIso ((AlgebraicGeometry.ProEtale.VaryingRing.moduleJAdj
      (compactSupportSystemLevel l E) (compactSupportSystemQuotient l E) j).counit.app T))
    ((AlgebraicGeometry.ProEtale.VaryingRing.extension
      (compactSupportSystemLevel l E) (compactSupportSystemQuotient l E) j).obj_mem_essImage _)

end WeilConjectures.CoefSupportOpenTensor
