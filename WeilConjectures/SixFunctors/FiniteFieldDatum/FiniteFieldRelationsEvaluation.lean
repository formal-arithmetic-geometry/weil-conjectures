/-!
# Finite-field evaluation with arbitrary model relations

Source: latest Weil conjectures blueprint, `thm-trf-frobenius-fixed-points.proof.md`,
Step 2, factorization of the coordinate ring
(blueprint: lem-trf-finite-field-relations-evaluation).

The helper definitions name the ideals, solution set, and model maps in this single statement.
They use the prescribed subfield and its prescribed base embedding, including when `r = 0`.
-/

@[expose] public section

noncomputable section

universe u

namespace WeilConjectures.FiniteFieldDatum

/-- The ideal generated by the finite-field equations in the geometric polynomial ring.
Source: blueprint `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
def relationEquationIdeal (D : WeilConjectures.FiniteFieldDatum.{u}) (m r : ℕ) :
    Ideal (MvPolynomial (Fin r) D.k) :=
  Ideal.span (Set.range fun i : Fin r ↦
    (MvPolynomial.X i : MvPolynomial (Fin r) D.k) ^ (D.q ^ m) - MvPolynomial.X i)

/-- Extension of the arbitrary model ideal along the fixed coefficient inclusion.
Source: blueprint `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
def extendedRelationIdeal (D : WeilConjectures.FiniteFieldDatum.{u}) (r : ℕ)
    (a : Ideal (MvPolynomial (Fin r) D.k₀)) : Ideal (MvPolynomial (Fin r) D.k) :=
  Ideal.map (MvPolynomial.map (algebraMap D.k₀ D.k)) a

/-- The surviving tuples: every model relation evaluates to zero in the specified subfield.
Source: blueprint `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
def relationSolutions (D : WeilConjectures.FiniteFieldDatum.{u}) (m : ℕ) (hm : 1 ≤ m)
    (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) :
    Set (Fin r → D.extensionSubfield m hm) :=
  {x | ∀ f ∈ a, MvPolynomial.eval₂Hom (D.extensionEmbedding m hm) x f = 0}

/-- The coordinate ideal generated by all evaluated model relations, in the closure.
Source: blueprint `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
def relationCoordinateIdeal (D : WeilConjectures.FiniteFieldDatum.{u}) (m : ℕ)
    (hm : 1 ≤ m) (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀))
    (x : Fin r → D.extensionSubfield m hm) : Ideal D.k :=
  Ideal.span ((fun f : MvPolynomial (Fin r) D.k₀ ↦
    MvPolynomial.eval₂Hom (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f) '' (a : Set _))

/-- Model algebra maps to the specified finite extension. The explicit last instance is
exactly the algebra structure induced by `D.extensionEmbedding m hm`; it is not arbitrary.
Source: blueprint `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation). -/
abbrev relationModelPoints (D : WeilConjectures.FiniteFieldDatum.{u}) (m : ℕ)
    (hm : 1 ≤ m) (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) :=
  @AlgHom D.k₀ (MvPolynomial (Fin r) D.k₀ ⧸ a) (D.extensionSubfield m hm)
    _ _ _ _ (D.extensionEmbedding m hm).toAlgebra

/-- Evaluation gives both finite product decompositions, the product of coordinate ideals,
and the canonical identification of surviving tuples with model algebra maps. The last
formula identifies each surviving projection with the scalar extension of its model map:
`C c * map f` represents the pure tensor `[f] ⊗ c`, and these span the base change.
No nonzero quotient or positive number of variables is assumed. For zero variables the
function type is the singleton empty tuple; for an empty solution set the function algebra
is the zero algebra, hence so is the second quotient.

Source: latest blueprint `thm-trf-frobenius-fixed-points.proof.md`, Step 2
(blueprint: lem-trf-finite-field-relations-evaluation).

Proof plan:
1. The unique-subfield theorem gives `card E = q^m` and compatibility of the base embedding.
   FiniteField.roots_X_pow_card_sub_X and the monic root product factor the field equations
   into distinct factors `X i - C c`, for `c` in `E`.
2. Polynomial evaluation kills their ideal. Conversely, apply the grid vanishing theorem
   MvPolynomial.combinatorial_nullstellensatz_exists_linearCombination with each grid `E`
   to identify the kernel with relationEquationIdeal (the DAG grid-vanishing node).
3. MvPolynomial.indicator, mapped from `E` to `k`, interpolates arbitrary functions on the
   finite grid. The quotient first isomorphism theorem gives `e₁` and its evaluation formula.
4. Ideal.piOrderIso identifies the image of the extended model ideal with the product of
   its coordinate images, which are exactly the spans in relationCoordinateIdeal.
5. On the solution set all these generators vanish; outside it one is nonzero and hence
   a unit in the field. Restriction of functions to the solution set is surjective, with
   kernel the indicated product ideal. Pulling back gives the sum of the two ideals.
   The quotient first isomorphism theorem gives `e₂` with its evaluation formula.
6. The solution set is finite as a subset of the finite grid. Evaluation descends to each
   model quotient; conversely a model algebra map gives its tuple by the images of `X i`.
   The polynomial universal property and quotient surjectivity make these inverse.
7. Coefficient-embedding compatibility identifies the projection on each pure tensor with
   `c * phi([f])`. For `r = 0` the interpolation product is `1`; for an empty solution set
   restriction has total kernel. Thus the same argument includes both edge cases. -/
private theorem subfield_grid_product {K : Type u} [Field K] (E : Subfield K)
    [Fintype E] {r : ℕ} (i : Fin r) :
    (∏ c : E, (MvPolynomial.X i - MvPolynomial.C c.val)) =
      (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E - MvPolynomial.X i := by
  classical
  have hmon : (Polynomial.X ^ Fintype.card E - Polynomial.X : Polynomial E).Monic :=
    Polynomial.monic_X_pow_sub (by simpa using Fintype.one_lt_card (α := E))
  have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmon
    (by simp [FiniteField.roots_X_pow_card_sub_X,
      FiniteField.X_pow_card_sub_X_natDegree_eq E Fintype.one_lt_card])
  rw [FiniteField.roots_X_pow_card_sub_X] at hprod
  have h := congrArg
    (Polynomial.eval₂RingHom (MvPolynomial.C.comp E.subtype) (MvPolynomial.X i)) hprod
  simpa using h

private theorem subfield_grid_surjective {K : Type u} [Field K] (E : Subfield K)
    [Finite E] (r : ℕ) : Function.Surjective
      (fun f : MvPolynomial (Fin r) K ↦ fun x : Fin r → E ↦
        MvPolynomial.eval (fun i ↦ (x i).val) f) := by
  classical
  let _ : Fintype E := Fintype.ofFinite E
  have heval (x y : Fin r → E) :
      MvPolynomial.eval (fun i ↦ (y i).val)
          (MvPolynomial.map E.subtype (MvPolynomial.indicator x)) =
        if y = x then 1 else 0 := by
    change MvPolynomial.eval (E.subtype ∘ y)
      (MvPolynomial.map E.subtype (MvPolynomial.indicator x)) = _
    rw [← MvPolynomial.map_eval]
    by_cases h : y = x
    · subst y
      simp [MvPolynomial.eval_indicator_apply_eq_one]
    · simp [h, MvPolynomial.eval_indicator_apply_eq_zero y x h]
  intro z
  refine ⟨∑ x : Fin r → E, MvPolynomial.C (z x) *
    MvPolynomial.map E.subtype (MvPolynomial.indicator x), ?_⟩
  funext y
  simp [heval]

private theorem subfield_grid_kernel {K : Type u} [Field K] (E : Subfield K)
    [Fintype E] (r : ℕ) (f : MvPolynomial (Fin r) K) :
    (∀ x : Fin r → E, MvPolynomial.eval (fun i ↦ (x i).val) f = 0) ↔
      f ∈ Ideal.span (Set.range fun i : Fin r ↦
        (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E -
          MvPolynomial.X i) := by
  classical
  let S : Finset K := Finset.univ.map (⟨Subtype.val, Subtype.val_injective⟩ : E ↪ K)
  have hS : ∀ x : K, x ∈ S ↔ x ∈ E := by simp [S]
  have hprod (i : Fin r) :
      (∏ c ∈ S, (MvPolynomial.X i - MvPolynomial.C c)) =
        (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E -
          MvPolynomial.X i := by
    simpa [S] using subfield_grid_product E i
  constructor
  · intro hf
    obtain ⟨h, _, hh⟩ := MvPolynomial.combinatorial_nullstellensatz_exists_linearCombination
      (fun _ : Fin r ↦ S) (fun _ ↦ ⟨0, (hS 0).2 E.zero_mem⟩) f
      (fun x hx ↦ by simpa using hf (fun i ↦ ⟨x i, (hS _).1 (hx i)⟩))
    simp_rw [hprod] at hh
    rw [hh, Finsupp.linearCombination_apply, Finsupp.sum]
    exact Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _
      (Ideal.subset_span (Set.mem_range_self i))
  · intro hf x
    have hle : Ideal.span (Set.range fun i : Fin r ↦
        (MvPolynomial.X i : MvPolynomial (Fin r) K) ^ Fintype.card E -
          MvPolynomial.X i) ≤ RingHom.ker (MvPolynomial.eval (fun i ↦ (x i).val)) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      have h := congrArg E.subtype (FiniteField.pow_card (x i))
      simpa [RingHom.mem_ker, sub_eq_zero] using h
    exact hle hf


theorem finite_field_relations_evaluation (D : WeilConjectures.FiniteFieldDatum.{u})
    (m : ℕ) (hm : 1 ≤ m) (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) :
    ∃ e₁ : (MvPolynomial (Fin r) D.k ⧸ D.relationEquationIdeal m r) ≃ₐ[D.k]
        ((Fin r → D.extensionSubfield m hm) → D.k),
    ∃ e₂ : (MvPolynomial (Fin r) D.k ⧸
        (D.extendedRelationIdeal r a ⊔ D.relationEquationIdeal m r)) ≃ₐ[D.k]
        (D.relationSolutions m hm r a → D.k),
    ∃ points : D.relationSolutions m hm r a ≃ D.relationModelPoints m hm r a,
      (∀ (f : MvPolynomial (Fin r) D.k) (x : Fin r → D.extensionSubfield m hm),
        e₁ (Ideal.Quotient.mk (D.relationEquationIdeal m r) f) x =
          MvPolynomial.eval (fun i ↦ (x i).val) f) ∧
      (∀ (f : MvPolynomial (Fin r) D.k) (x : D.relationSolutions m hm r a),
        e₂ (Ideal.Quotient.mk
          (D.extendedRelationIdeal r a ⊔ D.relationEquationIdeal m r) f) x =
          MvPolynomial.eval (fun i ↦ (x.val i).val) f) ∧
      Ideal.map e₁.toRingHom
        (Ideal.map (Ideal.Quotient.mk (D.relationEquationIdeal m r))
          (D.extendedRelationIdeal r a)) = Ideal.pi (D.relationCoordinateIdeal m hm r a) ∧
      (∀ x : Fin r → D.extensionSubfield m hm,
        (x ∈ D.relationSolutions m hm r a → D.relationCoordinateIdeal m hm r a x = ⊥) ∧
        (x ∉ D.relationSolutions m hm r a → D.relationCoordinateIdeal m hm r a x = ⊤)) ∧
      (D.relationSolutions m hm r a).Finite ∧
      (∀ (x : D.relationSolutions m hm r a) (f : MvPolynomial (Fin r) D.k₀),
        points x (Ideal.Quotient.mk a f) =
          MvPolynomial.eval₂Hom (D.extensionEmbedding m hm) x.val f) ∧
      (∀ (x : D.relationSolutions m hm r a) (c : D.k)
          (f : MvPolynomial (Fin r) D.k₀),
        e₂ (Ideal.Quotient.mk
          (D.extendedRelationIdeal r a ⊔ D.relationEquationIdeal m r)
          (MvPolynomial.C c * MvPolynomial.map (algebraMap D.k₀ D.k) f)) x =
            c * (D.extensionSubfield m hm).subtype (points x (Ideal.Quotient.mk a f))) := by
  classical
  let E := D.extensionSubfield m hm
  let ι := D.extensionEmbedding m hm
  have hspec := (FiniteField.exists_unique_subfield_of_closure D.p D.a D.q D.prime
    D.exponent_pos D.cardinality_eq D.k₀ D.card_base D.k m hm).choose_spec
  have hcard : Nat.card E = D.q ^ m := hspec.2.1
  have hι : E.subtype.comp ι = algebraMap D.k₀ D.k := hspec.2.2.2.2.2.2.choose_spec
  have hqpos : 0 < D.q := by
    rw [D.cardinality_eq]
    exact pow_pos D.prime.pos _
  have : Finite E := (Nat.card_pos_iff.mp (by rw [hcard]; exact pow_pos hqpos m)).2
  let _ : Fintype E := Fintype.ofFinite E
  have hc : Fintype.card E = D.q ^ m := by rwa [← Nat.card_eq_fintype_card]
  let T := Fin r → E
  let P := MvPolynomial (Fin r) D.k
  let J := relationEquationIdeal D m r
  let A := extendedRelationIdeal D r a
  let S := relationSolutions D m hm r a
  let L := relationCoordinateIdeal D m hm r a
  let v : P →ₐ[D.k] (T → D.k) :=
    AlgHom.pi (fun x ↦ MvPolynomial.aeval (fun i ↦ (x i).val))
  have hv (f : P) (x : T) : v f x = MvPolynomial.eval (fun i ↦ (x i).val) f := rfl
  have hsurj : Function.Surjective v := subfield_grid_surjective E r
  have hker : RingHom.ker v = J := by
    ext f
    change v f = 0 ↔ f ∈ J
    rw [funext_iff]
    simpa only [hv, Pi.zero_apply, J, relationEquationIdeal, ← hc] using
      subfield_grid_kernel E r f
  let e₁ : (P ⧸ J) ≃ₐ[D.k] (T → D.k) :=
    (Ideal.quotientEquivAlgOfEq D.k hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  have he₁ (f : P) : e₁ (Ideal.Quotient.mk J f) = v f := by
    exact Ideal.quotientKerAlgEquivOfSurjective_mk hsurj f
  have hval (x : T) (f : MvPolynomial (Fin r) D.k₀) :
      E.subtype (MvPolynomial.eval₂Hom ι x f) =
        MvPolynomial.eval₂Hom (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f := by
    change E.subtype (MvPolynomial.eval₂ ι x f) =
      MvPolynomial.eval₂ (algebraMap D.k₀ D.k) (fun i ↦ E.subtype (x i)) f
    have hh := MvPolynomial.map_eval₂Hom ι x E.subtype f
    change E.subtype (MvPolynomial.eval₂ ι x f) =
      MvPolynomial.eval₂ (E.subtype.comp ι) (fun i ↦ E.subtype (x i)) f at hh
    rw [hι] at hh
    exact hh
  have hcoord (x : T) :
      Ideal.map (Pi.evalRingHom (fun _ : T ↦ D.k) x) (Ideal.map v.toRingHom A) = L x := by
    rw [Ideal.map_map]
    change Ideal.map _ (Ideal.map _ a) = _
    rw [Ideal.map_map]
    have heq :
        (Pi.evalRingHom (fun _ : T ↦ D.k) x).comp
            (v.toRingHom.comp (MvPolynomial.map (algebraMap D.k₀ D.k))) =
          MvPolynomial.eval₂Hom (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) := by
      apply RingHom.ext
      intro f
      exact MvPolynomial.eval_map (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f
    rw [RingHom.comp_assoc, heq]
    rfl
  have hmap : Ideal.map v.toRingHom A = Ideal.pi L := by
    have h := (Ideal.piOrderIso (R := fun _ : T ↦ D.k)).symm_apply_apply
      (Ideal.map v.toRingHom A)
    change Ideal.pi (fun x ↦ Ideal.map (Pi.evalRingHom (fun _ : T ↦ D.k) x)
      (Ideal.map v.toRingHom A)) = _ at h
    simpa only [hcoord] using h.symm
  have hbot (x : T) (hx : x ∈ S) : L x = ⊥ := by
    apply le_antisymm _ bot_le
    apply Ideal.span_le.mpr
    rintro z ⟨f, hf, rfl⟩
    change MvPolynomial.eval₂Hom (algebraMap D.k₀ D.k) (fun i ↦ (x i).val) f = 0
    rw [← hval, hx f hf, map_zero]
  have htop (x : T) (hx : x ∉ S) : L x = ⊤ := by
    have hn : ∃ f ∈ a, MvPolynomial.eval₂Hom ι x f ≠ 0 := by
      change ¬ ∀ f ∈ a, MvPolynomial.eval₂Hom ι x f = 0 at hx
      push Not at hx
      exact hx
    obtain ⟨f, hf, hnf⟩ := hn
    have hne : MvPolynomial.eval₂Hom (algebraMap D.k₀ D.k)
        (fun i ↦ (x i).val) f ≠ 0 := by
      rw [← hval]
      exact (map_ne_zero E.subtype).mpr hnf
    exact Ideal.eq_top_of_isUnit_mem _
      (Ideal.subset_span ⟨f, hf, rfl⟩) (isUnit_iff_ne_zero.mpr hne)
  let ρ : (T → D.k) →ₐ[D.k] (S → D.k) :=
    AlgHom.pi (fun x ↦ Pi.evalAlgHom D.k (fun _ : T ↦ D.k) x.val)
  have hρsurj : Function.Surjective ρ := by
    intro z
    refine ⟨fun x ↦ if hx : x ∈ S then z ⟨x, hx⟩ else 0, ?_⟩
    ext x
    simp [ρ, x.property]
  have hρker : RingHom.ker ρ = Ideal.pi L := by
    ext z
    change (fun x : S ↦ z x.val) = 0 ↔ ∀ x, z x ∈ L x
    rw [funext_iff]
    constructor
    · intro hz x
      by_cases hx : x ∈ S
      · simpa only [hbot x hx, Ideal.mem_bot, Pi.zero_apply] using hz ⟨x, hx⟩
      · rw [htop x hx]
        exact Submodule.mem_top
    · intro hz x
      simpa only [hbot x.val x.property, Ideal.mem_bot, Pi.zero_apply] using hz x.val
  let w : P →ₐ[D.k] (S → D.k) := ρ.comp v
  have hwsurj : Function.Surjective w := hρsurj.comp hsurj
  have hwker : RingHom.ker w = A ⊔ J := by
    change Ideal.comap v.toRingHom (RingHom.ker ρ) = _
    rw [hρker, ← hmap, Ideal.comap_map_of_surjective v.toRingHom hsurj,
      ← RingHom.ker_eq_comap_bot]
    exact congrArg (A ⊔ ·) hker
  let e₂ : (P ⧸ (A ⊔ J)) ≃ₐ[D.k] (S → D.k) :=
    (Ideal.quotientEquivAlgOfEq D.k hwker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hwsurj)
  have he₂ (f : P) : e₂ (Ideal.Quotient.mk (A ⊔ J) f) = w f := by
    exact Ideal.quotientKerAlgEquivOfSurjective_mk hwsurj f
  let _ : Algebra D.k₀ E := ι.toAlgebra
  let point (x : S) : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E :=
    Ideal.Quotient.liftₐ a (MvPolynomial.aeval x.val) x.property
  let tuple (φ : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E) : T :=
    fun i ↦ φ (Ideal.Quotient.mk a (MvPolynomial.X i))
  have htuple (φ : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E)
      (f : MvPolynomial (Fin r) D.k₀) :
      MvPolynomial.eval₂Hom ι (tuple φ) f = φ (Ideal.Quotient.mk a f) := by
    have heq : MvPolynomial.aeval (tuple φ) = φ.comp (Ideal.Quotient.mkₐ D.k₀ a) := by
      ext i
      simp only [MvPolynomial.aeval_X]
      rfl
    exact AlgHom.congr_fun heq f
  let back (φ : (MvPolynomial (Fin r) D.k₀ ⧸ a) →ₐ[D.k₀] E) : S :=
    ⟨tuple φ, fun f hf ↦ by rw [htuple, Ideal.Quotient.eq_zero_iff_mem.mpr hf, map_zero]⟩
  let points : S ≃ relationModelPoints D m hm r a :=
    { toFun := point
      invFun := back
      left_inv := fun x ↦ by
        apply Subtype.ext
        funext i
        exact MvPolynomial.eval₂Hom_X' ι x.val i
      right_inv := fun φ ↦ by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro i
        change MvPolynomial.eval₂Hom ι (tuple φ) (MvPolynomial.X i) = _
        exact htuple φ (MvPolynomial.X i) }
  refine ⟨e₁, e₂, points, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro f x
    exact congrFun (he₁ f) x
  · intro f x
    exact congrFun (he₂ f) x
  · have heq : e₁.toRingHom.comp (Ideal.Quotient.mk J) = v.toRingHom :=
      RingHom.ext he₁
    have hmap' : Ideal.map (e₁.toRingHom.comp (Ideal.Quotient.mk J)) A = Ideal.pi L := by
      rw [heq]
      exact hmap
    simpa [A, J, Ideal.map_map] using hmap'
  · intro x
    constructor
    · intro hx
      exact hbot x hx
    · intro hx
      exact htop x hx
  · exact Set.toFinite S
  · intro x f
    have ht : tuple (points x) = x.val := by
      funext i
      change (points x) (Ideal.Quotient.mk a (MvPolynomial.X i)) = x.val i
      change (point x) (Ideal.Quotient.mk a (MvPolynomial.X i)) = x.val i
      simp [point]
    rw [← ht]
    exact (htuple (points x) f).symm
  · intro x c f
    rw [he₂]
    change MvPolynomial.eval (fun i ↦ (x.val i).val)
      (MvPolynomial.C c * MvPolynomial.map (algebraMap D.k₀ D.k) f) =
        c * E.subtype (MvPolynomial.eval₂Hom ι x.val f)
    rw [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_map, hval]
    rfl

end WeilConjectures.FiniteFieldDatum
