@[expose] public section
set_option autoImplicit false

universe u

open Topology

namespace ProcyclicPrimary

private theorem power_coordinate
    (C : Type u) [Group C] [TopologicalSpace C] [IsTopologicalGroup C]
    [CompactSpace C] [T2Space C] [TotallyDisconnectedSpace C]
    (g : C) (hg : DenseRange (fun n : ℤ ↦ g ^ n)) :
    ∃ q : Multiplicative integerResidues →ₜ* C,
      (∀ (n : ℤ) (a : integerResidues),
        (∀ m : ℕ+, a.1 m = (n : ZMod m.1)) → q (Multiplicative.ofAdd a) = g ^ n) ∧
      (∀ q' : Multiplicative integerResidues →ₜ* C,
        (∀ (n : ℤ) (a : integerResidues),
          (∀ m : ℕ+, a.1 m = (n : ZMod m.1)) →
            q' (Multiplicative.ofAdd a) = g ^ n) → q' = q) ∧ Function.Surjective q := by
  obtain ⟨q, hq, hrange, hu⟩ := existsUnique_profiniteIntegerPowerHom C g
  refine ⟨q, ?_, ?_, ?_⟩
  · intro n a ha
    have heq : a = profiniteIntegerInt n := Subtype.ext (funext ha)
    change q a = _
    rw [heq]
    exact hq n
  · intro q' hq'
    exact hu q' (fun n ↦ hq' n (profiniteIntegerInt n) (fun _ ↦ rfl))
  · have hsurj : Function.Surjective q := Set.range_eq_univ.mp (hrange.trans hg.closure_range)
    exact hsurj

private def residueEquiv : integerResidues ≃+ ProfiniteIntegers where
  toFun a := ⟨a.1, a.2⟩
  invFun a := ⟨a.1, a.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

private theorem residueEquiv_symm_continuous : Continuous residueEquiv.symm :=
  continuous_subtype_val.subtype_mk _

private theorem finite_coprime_of_power_surjective
    {F : Type*} [Group F] [Finite F] {r : ℕ} (hr : r.Prime)
    (hpow : Function.Surjective (fun x : F ↦ x ^ r)) : Nat.Coprime (Nat.card F) r := by
  apply Nat.Coprime.symm
  apply hr.coprime_iff_not_dvd.mpr
  intro hdiv
  let : Fact r.Prime := ⟨hr⟩
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' r hdiv
  have hinj : Function.Injective (fun x : F ↦ x ^ r) :=
    (Finite.injective_iff_surjective).mpr hpow
  have hx1 : x = 1 := hinj (by simpa [hx] using pow_orderOf_eq_one x)
  rw [hx1, orderOf_one] at hx
  exact hr.ne_one hx.symm

private theorem padic_nsmul_surjective (p n : ℕ) [Fact p.Prime]
    (h : p.Coprime n) : Function.Surjective (fun x : ℤ_[p] ↦ n • x) := by
  have hu : IsUnit (n : ℤ_[p]) := PadicInt.isUnit_iff.mpr (PadicInt.norm_natCast_eq_one_iff.mpr h)
  intro x
  obtain ⟨u, hu⟩ := hu
  refine ⟨↑u⁻¹ * x, ?_⟩
  change n • (↑u⁻¹ * x) = x
  rw [nsmul_eq_mul, ← hu]
  simp [← mul_assoc]

private theorem padic_finite_quotient
    (r : ℕ) [Fact r.Prime] (F : Type u) [Group F] [Finite F]
    (f : Multiplicative ℤ_[r] →* F) (hf : Function.Surjective f) :
    ∃ k : ℕ, Nat.card F = r ^ k := by
  have hprime (l : ℕ) (hl : l.Prime) (hd : l ∣ Nat.card F) : l = r := by
    by_contra hne
    have hsur : Function.Surjective (fun x : F ↦ x ^ l) := by
      intro x
      obtain ⟨z, rfl⟩ := hf x
      obtain ⟨w, hw⟩ := padic_nsmul_surjective r l
        ((Nat.coprime_primes Fact.out hl).mpr (Ne.symm hne)) z.toAdd
      refine ⟨f (Multiplicative.ofAdd w), ?_⟩
      change f (Multiplicative.ofAdd w) ^ l = f z
      rw [← map_pow]
      change f (Multiplicative.ofAdd (l • w)) = f z
      change l • w = z.toAdd at hw
      rw [hw]
      rfl
    exact (hl.coprime_iff_not_dvd.mp
      (finite_coprime_of_power_surjective hl hsur).symm) hd
  have hd : Nat.card F ∣ r ^ Nat.card F := by
    apply (Nat.dvd_pow_self_iff Nat.card_pos.ne' (Fact.out : r.Prime).ne_zero).mpr
    intro l hl
    obtain ⟨hlp, hld, _⟩ := Nat.mem_primeFactors.mp hl
    rw [hprime l hlp hld]
    exact Nat.mem_primeFactors.mpr ⟨Fact.out, dvd_refl _, (Fact.out : r.Prime).ne_zero⟩
  exact (IsPGroup.of_card_dvd_pow hd).exists_card_eq

private theorem divisible_finite_quotient
    (D : Type*) [Group D] (r : ℕ) (hr : r.Prime)
    (hd : Function.Surjective (fun x : D ↦ x ^ r))
    (F : Type u) [Group F] [Finite F] (f : D →* F) (hf : Function.Surjective f) :
    Nat.Coprime (Nat.card F) r := by
  apply finite_coprime_of_power_surjective hr
  intro x
  obtain ⟨y, rfl⟩ := hf x
  obtain ⟨z, rfl⟩ := hd y
  exact ⟨f z, (f.map_pow z r).symm⟩

private theorem pro_p_map_trivial
    (P D : Type u) [Group P] [TopologicalSpace P]
    [Group D] [TopologicalSpace D] [IsTopologicalGroup D]
    [CompactSpace D] [T2Space D] [TotallyDisconnectedSpace D]
    (r : ℕ)
    (hP : ∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F]
      [DiscreteTopology F] (f : P →ₜ* F), Function.Surjective f →
        ∃ k : ℕ, Nat.card F = r ^ k)
    (hD : ∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F]
      [DiscreteTopology F] (f : D →ₜ* F), Function.Surjective f →
        Nat.Coprime (Nat.card F) r)
    (f : P →ₜ* D) : ∀ x, f x = 1 := by
  classical
  intro x
  apply (ProfiniteGrp.continuousMulEquivLimittoFiniteQuotientFunctor
    (ProfiniteGrp.of D)).injective
  apply Subtype.ext
  funext N
  let Q := D ⧸ N.toSubgroup
  let q : D →ₜ* Q := ⟨QuotientGroup.mk' N.toSubgroup, QuotientGroup.continuous_mk⟩
  have hc := hD Q q (QuotientGroup.mk'_surjective N.toSubgroup)
  let ff := q.comp f
  let fr : P →ₜ* ff.toMonoidHom.range :=
    ⟨ff.toMonoidHom.rangeRestrict, ff.continuous.subtype_mk _⟩
  obtain ⟨k, hk⟩ := hP ff.toMonoidHom.range fr ff.toMonoidHom.rangeRestrict_surjective
  have hcard : Nat.card ff.toMonoidHom.range = 1 :=
    Nat.eq_one_of_dvd_coprimes (hc.pow_right k)
      (Subgroup.card_subgroup_dvd_card _) (hk ▸ dvd_refl _)
  have hsub : Subsingleton ff.toMonoidHom.range := (Nat.card_eq_one_iff_unique.mp hcard).1
  have heq : ff x = 1 := by
    exact congrArg Subtype.val (hsub.elim (fr x) 1)
  change q (f x) = q 1
  rw [map_one]
  exact heq

private theorem primary_lift
    (C : Type u) [Group C] [TopologicalSpace C] [IsTopologicalGroup C]
    [CompactSpace C] [T2Space C] [TotallyDisconnectedSpace C]
    (g : C)
    (r : ℕ) [Fact r.Prime]
    (χ : C →ₜ* Multiplicative ℤ_[r]) (hχ : χ g = Multiplicative.ofAdd 1)
    (q : Multiplicative integerResidues →ₜ* C)
    (hq : ∀ (n : ℤ) (a : integerResidues),
      (∀ m : ℕ+, a.1 m = (n : ZMod m.1)) → q (Multiplicative.ofAdd a) = g ^ n)
    (hsurj : Function.Surjective q) :
    ∃ s : Multiplicative ℤ_[r] →ₜ* C,
      (∀ z, χ (s z) = z) ∧ Set.range s = (primaryImage q.toMonoidHom r : Set C) ∧
      Function.Surjective (fun x : χ.toMonoidHom.ker ↦ x ^ r) := by
  classical
  obtain ⟨Θ, hΘ, hc, hci, ⟨j, hj, hjΘ, hd⟩, _⟩ := profinite_integers_crt
  let pr : Nat.Primes := ⟨r, Fact.out⟩
  let R := ∀ p : Nat.Primes, PadicIntAt p
  let e : integerResidues ≃+ R := residueEquiv.trans Θ.toAddEquiv
  have heci : Continuous e.symm := residueEquiv_symm_continuous.comp hci
  let i : PadicIntAt pr →+ R := AddMonoidHom.single PadicIntAt pr
  have hisame (z : PadicIntAt pr) : i z pr = z := Pi.single_eq_same pr z
  have hine (p : Nat.Primes) (h : p ≠ pr) (z : PadicIntAt pr) : i z p = 0 :=
    Pi.single_eq_of_ne h z
  have hic : Continuous (fun z : ℤ_[r] ↦ i z) := by
    have hid : Continuous (fun z : ℤ_[r] ↦ (z : PadicIntAt pr)) := continuous_id
    exact (continuous_single pr).comp hid
  let lift : Multiplicative ℤ_[r] →ₜ* Multiplicative integerResidues :=
    ⟨(e.symm.toAddMonoidHom.comp i).toMultiplicative, heci.comp hic⟩
  let s := q.comp lift
  have hchar : ∀ a : integerResidues,
      χ (q (Multiplicative.ofAdd a)) = Multiplicative.ofAdd (e a pr) := by
    have hd' : DenseRange j := hd
    have hf := hd'.equalizer
      (χ.continuous.comp (q.continuous.comp residueEquiv_symm_continuous))
      ((continuous_apply pr).comp hc) (by
        funext n
        change χ (q (Multiplicative.ofAdd (residueEquiv.symm (j n)))) =
          Multiplicative.ofAdd (Θ (j n) pr)
        have hj' : ∀ m : ℕ+, (residueEquiv.symm (j n)).1 m = (n : ZMod m.1) :=
          fun m ↦ hj n ⟨m.1, m.2⟩
        calc
          _ = χ (g ^ n) := congrArg χ (hq n (residueEquiv.symm (j n)) hj')
          _ = _ := by
            rw [map_zpow, hχ, hjΘ]
            change (Multiplicative.ofAdd (1 : ℤ_[r])) ^ n = Multiplicative.ofAdd (n : ℤ_[r])
            rw [← ofAdd_zsmul, zsmul_one])
    intro a
    exact congrFun hf (residueEquiv a)
  have hs : ∀ z, χ (s z) = z := by
    intro z
    change χ (q (Multiplicative.ofAdd (e.symm (i z.toAdd)))) = z
    rw [hchar, e.apply_symm_apply]
    rw [hisame]
    rfl
  refine ⟨s, hs, ?_, ?_⟩
  · ext x
    constructor
    · rintro ⟨z, rfl⟩
      refine ⟨Multiplicative.ofAdd (e.symm (i z.toAdd)), ?_, rfl⟩
      intro l hl hne k
      have hne' : (⟨l, hl⟩ : Nat.Primes) ≠ pr := by
        intro h; exact hne (congrArg Subtype.val h)
      have hh := hΘ (residueEquiv (e.symm (i z.toAdd))) ⟨l, hl⟩ k
      change _ = _ at hh
      have heq : Θ (residueEquiv (e.symm (i z.toAdd))) = i z.toAdd :=
        e.apply_symm_apply _
      rw [heq] at hh
      rw [hine _ hne', map_zero] at hh
      exact hh.symm
    · rintro ⟨a, ha, hax⟩
      have heq : e a.toAdd = i (e a.toAdd pr) := by
        ext p
        by_cases h : p = pr
        · subst p; exact (hisame _).symm
        · have hne : (p : ℕ) ≠ r := by
            intro hn
            apply h
            exact Subtype.ext hn
          have hz : e a.toAdd p = 0 := by
            let : Fact (p : ℕ).Prime := ⟨p.2⟩
            change (Θ (residueEquiv a.toAdd) p : @PadicInt p ⟨p.2⟩) = 0
            apply PadicInt.ext_of_toZModPow.mp
            intro k
            rw [map_zero]
            exact (hΘ (residueEquiv a.toAdd) p k).trans (ha p p.2 hne k)
          exact hz.trans (hine p h _).symm
      refine ⟨Multiplicative.ofAdd (e a.toAdd pr), ?_⟩
      change q (Multiplicative.ofAdd (e.symm (i (e a.toAdd pr)))) = x
      rw [← heq, e.symm_apply_apply]
      exact hax
  · intro x
    obtain ⟨a, hax⟩ := hsurj (x : C)
    have hapr : e a.toAdd pr = 0 := by
      have hh := hchar a.toAdd
      change χ (q a) = Multiplicative.ofAdd (e a.toAdd pr) at hh
      rw [hax] at hh
      have hx : χ (x : C) = 1 := x.property
      rw [hx] at hh
      exact (congrArg Multiplicative.toAdd hh).symm
    have div (p : Nat.Primes) (h : p ≠ pr) :
        ∃ z : PadicIntAt p, r • z = e a.toAdd p := by
      have hne : (p : ℕ) ≠ r := fun hn ↦ h (Subtype.ext hn)
      let : Fact (p : ℕ).Prime := ⟨p.2⟩
      exact padic_nsmul_surjective p r
        ((Nat.coprime_primes p.2 Fact.out).mpr hne) _
    let b : R := fun p ↦ if h : p = pr then 0 else (div p h).choose
    have hbpr : b pr = 0 := by simp [b]
    have hb : r • b = e a.toAdd := by
      ext p
      by_cases h : p = pr
      · subst p; change r • b pr = _; rw [hbpr, hapr, smul_zero]
      · change r • b p = _
        simpa only [b, dif_neg h] using (div p h).choose_spec
    have hb' : r • e.symm b = a.toAdd := by
      apply e.injective
      rw [map_nsmul, e.apply_symm_apply, hb]
    refine ⟨⟨q (Multiplicative.ofAdd (e.symm b)), ?_⟩, ?_⟩
    · change χ (q (Multiplicative.ofAdd (e.symm b))) = 1
      rw [hchar, e.apply_symm_apply, hbpr]
      rfl
    · apply Subtype.ext
      change (q (Multiplicative.ofAdd (e.symm b))) ^ r = (x : C)
      rw [← map_pow]
      change q (Multiplicative.ofAdd (r • e.symm b)) = (x : C)
      rw [hb']
      exact hax

/-- A normalized character identifies the primary factor with the additive r-adic integers.
The power map is uniquely specified by its values on every ordinary integer residue tuple.
The factor is closed, all its finite continuous quotients have r-power order, its complement
has prime-to-r finite quotients, and multiplication gives the actual direct-product map.

Source: blueprint latest, part-six-operations/sec-smooth-base-change/sec-sbc-uniform/
sk-rem-sbc-scope/sk-rem-sf-fullcd-scope.md, counterexample paragraph.
(blueprint: lem-sf-procyclic-primary-factor)

Proof (the six steps of the node).
1. Extend integer powers to the residue limit using the finite quotients of C. Its image
   is the closure of the powers, hence C, and C is abelian. CRT identifies the residue
   limit with the product of all prime-adic integer rings.
2. The composite of the character and the power map agrees with the r-coordinate
   projection on the dense integer residues; Hausdorffness gives equality everywhere.
3. Restrict the power map to the r-supported tuples. The identity in step 2 makes it
   injective and gives mutually inverse continuous maps with the character restriction.
4. The image of the complementary coordinates is exactly the character kernel. Every
   element is uniquely the product of its primary lift and a kernel element; this formula
   is continuous and inverse to multiplication, giving the normalized product equivalence.
5. Multiplication by any other prime is invertible on the r-adic integers. The induced
   power map on a finite quotient is surjective, hence injective; Cauchy's theorem then
   excludes that prime from its order. Thus the quotient has r-power order.
6. Divide complementary CRT coordinates by r to show that the character kernel is
   r-divisible. The same finite power-map argument makes its quotient orders prime to r.
   A pro-r subgroup projects trivially to every such finite quotient by Lagrange's theorem;
   the finite-quotient presentation then makes its kernel projection trivial. Hence it
   lies in the primary factor, proving maximality.
-/
theorem procyclic_primary_factor
    (C : Type u) [Group C] [TopologicalSpace C] [IsTopologicalGroup C]
    [CompactSpace C] [T2Space C] [TotallyDisconnectedSpace C]
    (g : C) (hg : DenseRange (fun n : ℤ ↦ g ^ n))
    (r : ℕ) [Fact r.Prime]
    (χ : C →ₜ* Multiplicative ℤ_[r]) (hχ : χ g = Multiplicative.ofAdd 1) :
    ∃ q : Multiplicative integerResidues →ₜ* C,
      (∀ (n : ℤ) (a : integerResidues),
        (∀ m : ℕ+, a.1 m = (n : ZMod m.1)) → q (Multiplicative.ofAdd a) = g ^ n) ∧
      (∀ q' : Multiplicative integerResidues →ₜ* C,
        (∀ (n : ℤ) (a : integerResidues),
          (∀ m : ℕ+, a.1 m = (n : ZMod m.1)) →
            q' (Multiplicative.ofAdd a) = g ^ n) → q' = q) ∧
      IsClosed (primaryImage q.toMonoidHom r : Set C) ∧
      (∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F] [DiscreteTopology F]
        (f : primaryImage q.toMonoidHom r →ₜ* F), Function.Surjective f →
          ∃ k : ℕ, Nat.card F = r ^ k) ∧
      (∀ H : ClosedSubgroup C,
        (∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F] [DiscreteTopology F]
          (f : H →ₜ* F), Function.Surjective f → ∃ k : ℕ, Nat.card F = r ^ k) →
        H.toSubgroup ≤ primaryImage q.toMonoidHom r) ∧
      (∃ e : primaryImage q.toMonoidHom r ≃ₜ* Multiplicative ℤ_[r],
        ∀ x : primaryImage q.toMonoidHom r, e x = χ (x : C)) ∧
      (∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F] [DiscreteTopology F]
        (f : χ.toMonoidHom.ker →ₜ* F), Function.Surjective f →
          Nat.Coprime (Nat.card F) r) ∧
      (∃ e : (primaryImage q.toMonoidHom r × χ.toMonoidHom.ker) ≃ₜ* C,
        ∀ x : primaryImage q.toMonoidHom r × χ.toMonoidHom.ker,
          e x = (x.1 : C) * (x.2 : C)) := by
  classical
  obtain ⟨q, hq, hu, hsurj⟩ := power_coordinate C g hg
  obtain ⟨s, hs, hrange, hdiv⟩ := primary_lift C g r χ hχ q hq hsurj
  let S := primaryImage q.toMonoidHom r
  have hsS (z : Multiplicative ℤ_[r]) : s z ∈ S := by
    change s z ∈ (primaryImage q.toMonoidHom r : Set C)
    rw [← hrange]
    exact ⟨z, rfl⟩
  have hfix (x : S) : s (χ (x : C)) = (x : C) := by
    obtain ⟨z, hz⟩ := (show (x : C) ∈ Set.range s by rw [hrange]; exact x.property)
    rw [← hz, hs]
  let se : Multiplicative ℤ_[r] ≃ₜ* S :=
    { toFun := fun z ↦ ⟨s z, hsS z⟩
      invFun := fun x ↦ χ (x : C)
      left_inv := hs
      right_inv := fun x ↦ Subtype.ext (hfix x)
      map_mul' := fun x y ↦ Subtype.ext (s.map_mul x y)
      continuous_toFun := s.continuous.subtype_mk _
      continuous_invFun := χ.continuous.comp continuous_subtype_val }
  have hclosed : IsClosed (S : Set C) := by
    rw [← hrange]
    exact s.continuous.isClosedMap.isClosed_range
  have hcomm : ∀ x y : C, x * y = y * x :=
    hg.induction_on₂ (isClosed_eq (continuous_fst.mul continuous_snd)
      (continuous_snd.mul continuous_fst)) (fun m n ↦ zpow_mul_comm g m n)
  let : CommGroup C := { ‹Group C› with mul_comm := hcomm }
  let π : C →ₜ* χ.toMonoidHom.ker :=
    { toFun := fun x ↦ ⟨(s (χ x))⁻¹ * x, by simp [map_mul, map_inv, hs]⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := by
        intro x y
        apply Subtype.ext
        change (s (χ (x * y)))⁻¹ * (x * y) =
          ((s (χ x))⁻¹ * x) * ((s (χ y))⁻¹ * y)
        simp only [map_mul, mul_inv_rev]
        ac_rfl
      continuous_toFun :=
        ((s.continuous.comp χ.continuous).inv.mul continuous_id).subtype_mk
          (fun x ↦ by
            change χ ((s (χ x))⁻¹ * x) = 1
            simp only [map_mul, map_inv, hs, inv_mul_cancel]) }
  let prodEquiv : (S × χ.toMonoidHom.ker) ≃ₜ* C :=
    { toFun := fun x ↦ (x.1 : C) * (x.2 : C)
      invFun := fun x ↦ (se (χ x), π x)
      left_inv := by
        intro x
        apply Prod.ext
        · apply Subtype.ext
          change s (χ ((x.1 : C) * (x.2 : C))) = (x.1 : C)
          have hx : χ (x.2 : C) = 1 := x.2.property
          rw [map_mul, hx, mul_one]
          exact hfix x.1
        · apply Subtype.ext
          change (s (χ ((x.1 : C) * (x.2 : C))))⁻¹ *
            ((x.1 : C) * (x.2 : C)) = (x.2 : C)
          have hx : χ (x.2 : C) = 1 := x.2.property
          rw [map_mul, hx, mul_one, hfix]
          exact inv_mul_cancel_left _ _
      right_inv := by
        intro x
        change s (χ x) * ((s (χ x))⁻¹ * x) = x
        exact mul_inv_cancel_left _ _
      map_mul' := by
        intro x y
        change ((x.1 : C) * (y.1 : C)) * ((x.2 : C) * (y.2 : C)) =
          ((x.1 : C) * (x.2 : C)) * ((y.1 : C) * (y.2 : C))
        ac_rfl
      continuous_toFun :=
        (continuous_subtype_val.comp continuous_fst).mul
          (continuous_subtype_val.comp continuous_snd)
      continuous_invFun := (se.continuous.comp χ.continuous).prodMk π.continuous }
  have hpow : ∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F]
      [DiscreteTopology F] (f : S →ₜ* F), Function.Surjective f →
        ∃ k : ℕ, Nat.card F = r ^ k := by
    intro F _ _ _ _ f hf
    exact padic_finite_quotient r F (f.toMonoidHom.comp se.toMulEquiv.toMonoidHom)
      (hf.comp se.surjective)
  have hker : ∀ (F : Type u) [Group F] [Finite F] [TopologicalSpace F]
      [DiscreteTopology F] (f : χ.toMonoidHom.ker →ₜ* F), Function.Surjective f →
        Nat.Coprime (Nat.card F) r := by
    intro F _ _ _ _ f hf
    exact divisible_finite_quotient _ r Fact.out hdiv F f.toMonoidHom hf
  refine ⟨q, hq, hu, hclosed, hpow, ?_, ⟨se.symm, fun _ ↦ rfl⟩, hker,
    ⟨prodEquiv, fun _ ↦ rfl⟩⟩
  intro H hH x hx
  have hKclosed : IsClosed (χ.toMonoidHom.ker : Set C) :=
    isClosed_eq χ.continuous continuous_const
  let : CompactSpace χ.toMonoidHom.ker := isCompact_iff_compactSpace.mp hKclosed.isCompact
  let f : H →ₜ* χ.toMonoidHom.ker :=
    ⟨π.toMonoidHom.comp H.toSubgroup.subtype, π.continuous.comp continuous_subtype_val⟩
  have hπ := pro_p_map_trivial H χ.toMonoidHom.ker r hH hker f ⟨x, hx⟩
  have hpx : (s (χ x))⁻¹ * x = 1 := congrArg Subtype.val hπ
  have heq : s (χ x) = x := inv_mul_eq_one.mp hpx
  exact heq ▸ hsS (χ x)

end ProcyclicPrimary
