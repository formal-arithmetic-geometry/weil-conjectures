/-!
# Sections of étale sheaves after an extension of an algebraically closed base field

Let `k` be an algebraically closed field, `K/k` a field extension, `X` a quasi-compact and
quasi-separated scheme over `k` and `F` an étale sheaf on `X`. Pullback along the projection
`X_K = X ×_k K ⟶ X` is a bijection `Γ(X, F) ≅ Γ(X_K, F|_{X_K})`.

The field `K` is the filtered union of the `k`-subalgebras `A` generated by finite subsets, so
`X_K` is the limit of the `X_A = X ×_k A` and every section over `X_K` comes from some `X_A`
(`AlgebraicGeometry.Etale.unitComparison_app_surjective_of_isLimit`). Each `A` is a finitely
generated domain, so it has a `k`-point by the Nullstellensatz and `Spec A ⟶ Spec k` is
geometrically connected; by rigidity
(`AlgebraicGeometry.Etale.surjective_unit_app_of_section`) every section over `X_A` comes from
`X`. Injectivity holds since `X_K ⟶ X` is surjective.

## References

- Stacks Project, Lemma 59.39.4, <https://stacks.math.columbia.edu/tag/0A3I>
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

/-- **Nullstellensatz.** A nontrivial finitely generated algebra over an algebraically closed
field `k` has a `k`-point. -/
lemma Algebra.FiniteType.nonempty_algHom_of_isAlgClosed (k B : Type*) [Field k] [IsAlgClosed k]
    [CommRing B] [Nontrivial B] [Algebra k B] [Algebra.FiniteType k B] :
    Nonempty (B →ₐ[k] k) := by
  obtain ⟨m, hm⟩ := Ideal.exists_maximal B
  letI := Ideal.Quotient.field m
  have : Algebra.FiniteType k (B ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m)
      Ideal.Quotient.mk_surjective
  have : Module.Finite k (B ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (B ⧸ m)
  exact ⟨(IsAlgClosed.lift : (B ⧸ m) →ₐ[k] k).comp (Ideal.Quotient.mkₐ k m)⟩

namespace AlgebraicGeometry

open Scheme Etale

section Limit

variable (k K : Type u) [Field k] [Field K] [Algebra k K]

/-- The diagram of the `k`-subalgebras of `K` generated by finite subsets of `K`. -/
noncomputable def adjoinFinsetDiagram : Finset K ⥤ CommRingCat.{u} where
  obj S := .of (Algebra.adjoin k (S : Set K))
  map h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.2 (leOfHom h)))).toRingHom

/-- `K` as the cocone of the `k`-subalgebras generated by finite subsets of `K`. -/
noncomputable def adjoinFinsetCocone : Cocone (adjoinFinsetDiagram k K) where
  pt := .of K
  ι := { app S := CommRingCat.ofHom (Algebra.adjoin k (S : Set K)).val.toRingHom }

/-- `K` is the filtered colimit of its `k`-subalgebras generated by finite subsets. -/
noncomputable def isColimitAdjoinFinsetCocone : IsColimit (adjoinFinsetCocone k K) := by
  classical
  have := reflectsColimitsOfShape_of_reflectsIsomorphisms (G := forget CommRingCat.{u})
    (J := Finset K)
  refine isColimitOfReflects (forget CommRingCat.{u})
    (Types.FilteredColimit.isColimitOf _ _ (fun x ↦ ?_) (fun i j xi xj h ↦ ?_))
  · exact ⟨{x}, ⟨x, Algebra.subset_adjoin (by simp)⟩, rfl⟩
  · refine ⟨i ∪ j, homOfLE Finset.subset_union_left, homOfLE Finset.subset_union_right, ?_⟩
    exact Subtype.ext h

variable {k K}

lemma adjoinFinsetDiagram_algebraMap_comp_map {S S' : Finset K} (h : S ⟶ S') :
    CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (S : Set K))) ≫
      (adjoinFinsetDiagram k K).map h =
    CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (S' : Set K))) := by
  ext; rfl

lemma adjoinFinsetCocone_algebraMap_comp_ι (S : Finset K) :
    CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (S : Set K))) ≫
      (adjoinFinsetCocone k K).ι.app S = CommRingCat.ofHom (algebraMap k K) := by
  ext; rfl

lemma spec_map_adjoinFinsetDiagram_map_id (S : Finset K) :
    Spec.map ((adjoinFinsetDiagram k K).map (𝟙 S)) = 𝟙 _ := by
  rw [CategoryTheory.Functor.map_id]
  exact Spec.map_id _

variable (K) {X : Scheme.{u}} (p : X ⟶ Spec (.of k))

set_option backward.isDefEq.respectTransparency false in
/-- The cofiltered system of the base changes `X ×_k A` of `X` to the `k`-subalgebras `A` of
`K` generated by finite subsets. -/
noncomputable def baseChangeAdjoinFinsetDiagram : (Finset K)ᵒᵖ ⥤ Scheme.{u} where
  obj S := pullback p
    (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (S.unop : Set K)))))
  map h := pullback.map _ _ _ _ (𝟙 X) (Spec.map ((adjoinFinsetDiagram k K).map h.unop)) (𝟙 _)
    (by simp) (by rw [← Spec.map_comp, adjoinFinsetDiagram_algebraMap_comp_map]; simp)
  map_id S := by
    apply pullback.hom_ext
    · simp
    · simp only [unop_id, spec_map_adjoinFinsetDiagram_map_id]
      simp only [pullback.lift_snd, Category.id_comp]
      exact Category.comp_id _
  map_comp f g := by
    apply pullback.hom_ext <;> simp [← Spec.map_comp]

/-- `X_K` as a cone over the base changes `X ×_k A`. -/
noncomputable def baseChangeAdjoinFinsetCone : Cone (baseChangeAdjoinFinsetDiagram K p) where
  pt := pullback p (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  π :=
    { app S := pullback.map _ _ _ _ (𝟙 X) (Spec.map ((adjoinFinsetCocone k K).ι.app S.unop))
        (𝟙 _) (by simp) (by rw [← Spec.map_comp, adjoinFinsetCocone_algebraMap_comp_ι]; simp)
      naturality S S' h := by
        apply pullback.hom_ext
        · simp [baseChangeAdjoinFinsetDiagram]
        · simp only [baseChangeAdjoinFinsetDiagram, Functor.const_obj_obj, Functor.const_obj_map,
            Category.id_comp, Category.assoc, pullback.lift_snd, pullback.lift_snd_assoc,
            ← Spec.map_comp]
          rw [← (adjoinFinsetCocone k K).w h.unop] }

/-- The structure morphisms `X ×_k A ⟶ X`. -/
noncomputable def baseChangeAdjoinFinsetπ :
    baseChangeAdjoinFinsetDiagram K p ⟶ (Functor.const _).obj X where
  app S := pullback.fst _ _
  naturality S S' h := by simp [baseChangeAdjoinFinsetDiagram]

lemma baseChangeAdjoinFinset_fst_eq (S : (Finset K)ᵒᵖ) :
    pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
      (baseChangeAdjoinFinsetCone K p).π.app S ≫ (baseChangeAdjoinFinsetπ K p).app S := by
  simp [baseChangeAdjoinFinsetCone, baseChangeAdjoinFinsetπ]

/-- `X_K` is the limit of the base changes `X ×_k A` of `X` to the `k`-subalgebras `A` of `K`
generated by finite subsets. -/
noncomputable def isLimitBaseChangeAdjoinFinsetCone : IsLimit (baseChangeAdjoinFinsetCone K p) := by
  let hSpec : IsLimit (Scheme.Spec.mapCone (adjoinFinsetCocone k K).op) :=
    isLimitOfPreserves Scheme.Spec (isColimitAdjoinFinsetCocone k K).op
  -- all the structure morphisms to `X` agree
  have hfst (s : Cone (baseChangeAdjoinFinsetDiagram K p)) (S : (Finset K)ᵒᵖ) :
      s.π.app S ≫ pullback.fst _ _ = s.π.app (op ∅) ≫ pullback.fst _ _ := by
    rw [← s.w (homOfLE (Finset.empty_subset S.unop)).op, Category.assoc]
    simp [baseChangeAdjoinFinsetDiagram]
  let specCone (s : Cone (baseChangeAdjoinFinsetDiagram K p)) :
      Cone ((adjoinFinsetDiagram k K).op ⋙ Scheme.Spec) :=
    { pt := s.pt
      π :=
        { app S := s.π.app S ≫ pullback.snd _ _
          naturality S S' h := by
            rw [← s.w h]
            simp [baseChangeAdjoinFinsetDiagram] } }
  refine
    { lift s := pullback.lift (s.π.app (op ∅) ≫ pullback.fst _ _) (hSpec.lift (specCone s)) ?_
      fac s S := ?_
      uniq s m hm := ?_ }
  · have := hSpec.fac (specCone s) (op ∅)
    simp only [Functor.mapCone_π_app, Cocone.op_π, NatTrans.op_app, Scheme.Spec_map,
      Quiver.Hom.unop_op] at this
    rw [← adjoinFinsetCocone_algebraMap_comp_ι (k := k) ∅, Spec.map_comp, ← Category.assoc,
      this]
    simp [specCone, pullback.condition]
  · apply pullback.hom_ext
    · simp [baseChangeAdjoinFinsetCone, hfst]
    · have := hSpec.fac (specCone s) S
      simp only [Functor.mapCone_π_app, Cocone.op_π, NatTrans.op_app, Scheme.Spec_map,
        Quiver.Hom.unop_op] at this
      simp [baseChangeAdjoinFinsetCone, this, specCone]
  · apply pullback.hom_ext
    · rw [pullback.lift_fst, ← hm (op ∅)]
      simp [baseChangeAdjoinFinsetCone]
    · rw [pullback.lift_snd]
      refine hSpec.uniq (specCone s) _ fun S ↦ ?_
      simp only [Functor.mapCone_π_app, Cocone.op_π, NatTrans.op_app, Scheme.Spec_map,
        Quiver.Hom.unop_op, specCone, ← hm S]
      simp [baseChangeAdjoinFinsetCone]

end Limit

lemma Etale.isIso_terminal_hom (X : Scheme.{u}) : IsIso (⊤_ X.Etale).hom := by
  let e := terminalIsTerminal.uniqueUpToIso
    (MorphismProperty.Over.mkIdTerminal @AlgebraicGeometry.Etale X)
  have : IsIso e.hom.left :=
    ⟨e.inv.left, congrArg (·.left) e.hom_inv_id, congrArg (·.left) e.inv_hom_id⟩
  have h : e.hom.left = (⊤_ X.Etale).hom :=
    (Category.comp_id _).symm.trans (MorphismProperty.Over.w e.hom)
  rw [← h]
  exact this

/-- **Sections are invariant under extension of an algebraically closed base field**, for
abelian sheaves. Let `k` be an algebraically closed field, `K/k` a field extension and
`p : X ⟶ Spec k` quasi-compact and quasi-separated. For every abelian étale sheaf `G` on `X`,
pullback along the projection `X ×_k K ⟶ X` is an isomorphism `Γ(X, G) ≅ Γ(X ×_k K, G|)`. -/
theorem Etale.isIso_globalSectionsUpperStarMap_addCommGrpCat_of_isAlgClosed {k K : Type u}
    [Field k] [Field K] [Algebra k K] [IsAlgClosed k] {X : Scheme.{u}} (p : X ⟶ Spec (.of k))
    [QuasiCompact p] [QuasiSeparated p] (G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}) :
    IsIso (globalSectionsUpperStarMap AddCommGrpCat.{u + 1}
      (pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap k K)))) G) := by
  simp only [globalSectionsUpperStarMap, isIso_comp_left_iff, ← Category.assoc,
    isIso_comp_right_iff]
  rw [ConcreteCategory.isIso_iff_bijective]
  have := isIso_terminal_hom X
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated p
  have : CompactSpace (⊤_ X.Etale).left :=
    QuasiCompact.compactSpace_of_compactSpace (Y := X) (⊤_ X.Etale).hom
  have : QuasiSeparatedSpace (⊤_ X.Etale).left :=
    quasiSeparatedSpace_of_quasiSeparated (Y := X) (⊤_ X.Etale).hom
  refine ⟨?_, fun t ↦ ?_⟩
  · -- injectivity: `X_K ⟶ X` is surjective
    have : Surjective (pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
      MorphismProperty.pullback_fst (P := @Surjective) _ _ inferInstance
    exact injective_unit_app_of_surjective _ G _
  · -- surjectivity: every section comes from some `X ×_k A`, `A` finitely generated
    have (j : (Finset K)ᵒᵖ) : CompactSpace ((baseChangeAdjoinFinsetDiagram K p).obj j) :=
      inferInstanceAs (CompactSpace ↥(pullback p _))
    have (j : (Finset K)ᵒᵖ) : QuasiSeparatedSpace ((baseChangeAdjoinFinsetDiagram K p).obj j) :=
      quasiSeparatedSpace_of_quasiSeparated (pullback.snd p
        (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (j.unop : Set K))))))
    have : ∀ {i j : (Finset K)ᵒᵖ} (f : i ⟶ j),
        IsAffineHom ((baseChangeAdjoinFinsetDiagram K p).map f) := fun {i j} f ↦ by
      have : IsAffineHom (pullback.fst p (Spec.map
          (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (j.unop : Set K)))))) :=
        MorphismProperty.pullback_fst (P := @IsAffineHom) _ _ inferInstance
      have : IsAffineHom ((baseChangeAdjoinFinsetDiagram K p).map f ≫ pullback.fst _ _) := by
        simp only [baseChangeAdjoinFinsetDiagram, pullback.lift_fst, Category.comp_id]
        exact MorphismProperty.pullback_fst (P := @IsAffineHom) _ _ inferInstance
      exact IsAffineHom.of_comp _ (pullback.fst p
        (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (j.unop : Set K))))))
    obtain ⟨S, s, hs⟩ := unitComparison_app_surjective_of_isLimit
      (baseChangeAdjoinFinsetDiagram K p) (baseChangeAdjoinFinsetπ K p)
      (baseChangeAdjoinFinsetCone K p) _ (baseChangeAdjoinFinset_fst_eq K p)
      (isLimitBaseChangeAdjoinFinsetCone K p) G (⊤_ X.Etale) t
    let B := Algebra.adjoin k (S.unop : Set K)
    have : Algebra.FiniteType k B := Algebra.FiniteType.adjoin_of_finite S.unop.finite_toSet
    obtain ⟨a⟩ := Algebra.FiniteType.nonempty_algHom_of_isAlgClosed k B
    have : ConnectedSpace (Spec (.of B)) := inferInstanceAs (ConnectedSpace (PrimeSpectrum B))
    have : GeometricallyConnected (Spec.map (CommRingCat.ofHom (algebraMap k B))) :=
      GeometricallyConnected.of_connectedSpace_of_isSepClosed _
    have : GeometricallyConnected ((baseChangeAdjoinFinsetπ K p).app S) :=
      inferInstanceAs
        (GeometricallyConnected (pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap k B)))))
    -- the section of `X ×_k A ⟶ X` given by the `k`-point `a` of `A`
    have ha : CommRingCat.ofHom (algebraMap k B) ≫ CommRingCat.ofHom a.toRingHom = 𝟙 _ := by
      ext x
      simp
    let σ : X ⟶ (baseChangeAdjoinFinsetDiagram K p).obj S :=
      pullback.lift (𝟙 X) (p ≫ Spec.map (CommRingCat.ofHom a.toRingHom))
        (by rw [Category.assoc, ← Spec.map_comp, ha, Spec.map_id, Category.comp_id,
          Category.id_comp])
    obtain ⟨s₀, rfl⟩ := surjective_unit_app_of_section _ σ (pullback.lift_fst _ _ _) G
      (⊤_ X.Etale) s
    refine ⟨s₀, Eq.trans ?_ hs⟩
    exact (congrArg (fun φ ↦ φ.hom.app (op (⊤_ X.Etale)) s₀)
      (unit_app_comp_unitComparison _ _ _ (baseChangeAdjoinFinset_fst_eq K p S) G)).symm

variable (Λ : Type (u + 1)) [CommRing Λ]

/-- **Sections are invariant under extension of an algebraically closed base field.** Let `k`
be an algebraically closed field, `K/k` a field extension and `p : X ⟶ Spec k` quasi-compact
and quasi-separated. For every étale sheaf `F` of `Λ`-modules on `X`, pullback along the
projection `X ×_k K ⟶ X` is an isomorphism `Γ(X, F) ≅ Γ(X ×_k K, F|)`. -/
@[stacks 0A3I]
theorem Etale.isIso_globalSectionsUpperStarMap_of_isAlgClosed {k K : Type u} [Field k] [Field K]
    [Algebra k K] [IsAlgClosed k] {X : Scheme.{u}} (p : X ⟶ Spec (.of k)) [QuasiCompact p]
    [QuasiSeparated p] (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) :
    IsIso (globalSectionsUpperStarMap (ModuleCat.{u + 1} Λ)
      (pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap k K)))) F) :=
  (isIso_globalSectionsUpperStarMap_iff_forget₂ Λ _ F).2
    (isIso_globalSectionsUpperStarMap_addCommGrpCat_of_isAlgClosed p _)

end AlgebraicGeometry
