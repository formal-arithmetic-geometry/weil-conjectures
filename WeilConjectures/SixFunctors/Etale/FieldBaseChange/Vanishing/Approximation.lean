module

public import WeilConjectures.Mathlib.AlgebraicGeometry.AffineTransitionLimit
public import WeilConjectures.Mathlib.Algebra.Category.Ring.FilteredColimits

/-!
# Affine schemes over a field as limits of affine schemes of finite type

Let `K` be a field and `A` a `K`-algebra. The spectra of the `K`-subalgebras of `A` generated by
finite subsets form a cofiltered system of affine schemes of finite type over `K`, with affine
transition morphisms, whose limit is `Spec A`
(`AlgebraicGeometry.Scheme.isLimitAdjoinFinsetSpecCone`). Consequently every affine scheme over
`Spec K` is such a limit (`AlgebraicGeometry.Scheme.exists_isLimit_finiteType_of_isAffine`).
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

namespace Scheme

variable (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A]

/-- The spectra of the `K`-subalgebras of `A` generated by finite subsets of `A`. -/
noncomputable def adjoinFinsetSpecDiagram : (Finset A)ᵒᵖ ⥤ Scheme.{u} :=
  (CommRingCat.adjoinFinsetDiagram K A).op ⋙ Scheme.Spec

/-- The structure morphisms of the stages of `AlgebraicGeometry.Scheme.adjoinFinsetSpecDiagram`
to `Spec K`. -/
noncomputable def adjoinFinsetSpecStructure :
    adjoinFinsetSpecDiagram K A ⟶ (Functor.const _).obj (Spec (.of K)) where
  app s := Spec.map (CommRingCat.ofHom (algebraMap K (Algebra.adjoin K (s.unop : Set A))))
  naturality s s' f := by
    simp only [adjoinFinsetSpecDiagram, Functor.comp_map, Functor.op_map, Scheme.Spec_map,
      Quiver.Hom.unop_op, Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id,
      ← Spec.map_comp, CommRingCat.ofHom_algebraMap_comp_adjoinFinsetDiagram_map]

/-- `Spec A` as a cone over `AlgebraicGeometry.Scheme.adjoinFinsetSpecDiagram`. -/
noncomputable def adjoinFinsetSpecCone : Cone (adjoinFinsetSpecDiagram K A) :=
  Scheme.Spec.mapCone (CommRingCat.adjoinFinsetCocone K A).op

/-- `Spec A` is the limit of the spectra of the `K`-subalgebras of `A` generated by finite
subsets, since `A` is their filtered colimit and `Spec` turns colimits into limits. -/
noncomputable def isLimitAdjoinFinsetSpecCone : IsLimit (adjoinFinsetSpecCone K A) :=
  isLimitOfPreserves Scheme.Spec (CommRingCat.isColimitAdjoinFinsetCocone K A).op

instance isAffine_adjoinFinsetSpecDiagram_obj (s : (Finset A)ᵒᵖ) :
    IsAffine ((adjoinFinsetSpecDiagram K A).obj s) :=
  inferInstanceAs (IsAffine (Spec _))

instance isAffineHom_adjoinFinsetSpecDiagram_map {s s' : (Finset A)ᵒᵖ} (f : s ⟶ s') :
    IsAffineHom ((adjoinFinsetSpecDiagram K A).map f) :=
  inferInstanceAs (IsAffineHom (Spec.map _))

/-- The stages of `AlgebraicGeometry.Scheme.adjoinFinsetSpecDiagram` are of finite presentation
over `Spec K`, being spectra of finitely generated algebras over the Noetherian ring `K`. -/
instance locallyOfFinitePresentation_adjoinFinsetSpecStructure_app (s : (Finset A)ᵒᵖ) :
    LocallyOfFinitePresentation ((adjoinFinsetSpecStructure K A).app s) := by
  have : Algebra.FiniteType K (Algebra.adjoin K (s.unop : Set A)) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)
  refine HasRingHomProperty.Spec_iff.mpr ?_
  exact RingHom.FinitePresentation.of_finiteType.mp (RingHom.finiteType_algebraMap.mpr this)

/-- The legs of `AlgebraicGeometry.Scheme.adjoinFinsetSpecCone` are morphisms over `Spec K`. -/
lemma adjoinFinsetSpecCone_π_app_comp (s : (Finset A)ᵒᵖ) :
    (adjoinFinsetSpecCone K A).π.app s ≫ (adjoinFinsetSpecStructure K A).app s =
      Spec.map (CommRingCat.ofHom (algebraMap K A)) := by
  simp only [adjoinFinsetSpecCone, adjoinFinsetSpecStructure, Functor.mapCone_π_app,
    Scheme.Spec_map, Cocone.op_π, NatTrans.op_app, Quiver.Hom.unop_op, ← Spec.map_comp,
    CommRingCat.ofHom_algebraMap_comp_adjoinFinsetCocone_ι_app]

/-- The legs of `Spec A` over the stages, precomposed with an isomorphism `Z ≅ Spec A`. -/
noncomputable def adjoinFinsetSpecπ {Z : Scheme.{u}} (i : Z ≅ Spec (.of A)) :
    (Functor.const _).obj Z ⟶ adjoinFinsetSpecDiagram K A :=
  (Functor.const _).map i.hom ≫ (adjoinFinsetSpecCone K A).π

/-- A scheme isomorphic to `Spec A` is the limit of the spectra of the `K`-subalgebras of `A`
generated by finite subsets. -/
noncomputable def isLimitAdjoinFinsetSpecπ {Z : Scheme.{u}} (i : Z ≅ Spec (.of A)) :
    IsLimit (Cone.mk Z (adjoinFinsetSpecπ K A i)) :=
  (isLimitAdjoinFinsetSpecCone K A).ofIsoLimit
    (Cone.ext i.symm fun s ↦ by simp [adjoinFinsetSpecπ])

variable {K}

/-- A morphism from an affine scheme `Z` to `Spec K` is `Z ≅ Spec Γ(Z, ⊤)` followed by the
spectrum of the induced ring map `K ⟶ Γ(Z, ⊤)`. -/
lemma isoSpec_hom_SpecMap_ΓSpecIso_inv_comp_appTop {Z : Scheme.{u}} [IsAffine Z]
    (a : Z ⟶ Spec (.of K)) :
    Z.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop) = a := by
  rw [Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc,
    Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]

/-- **Affine schemes over a field are limits of affine schemes of finite type.** An affine
scheme `Z` over `Spec K` is the limit of a cofiltered system of affine schemes of finite
presentation over `Spec K` with affine transition morphisms. -/
theorem exists_isLimit_finiteType_of_isAffine {Z : Scheme.{u}} [IsAffine Z]
    (a : Z ⟶ Spec (.of K)) :
    ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D : I ⥤ Scheme.{u})
      (t : D ⟶ (Functor.const I).obj (Spec (.of K))) (π : (Functor.const I).obj Z ⟶ D),
      Nonempty (IsLimit (Cone.mk Z π)) ∧ (∀ i, IsAffine (D.obj i)) ∧
      (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) ∧
      (∀ i, LocallyOfFinitePresentation (t.app i)) ∧ ∀ i, π.app i ≫ t.app i = a := by
  let : Algebra K Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop).hom.toAlgebra
  refine ⟨(Finset Γ(Z, ⊤))ᵒᵖ, inferInstance, inferInstance, adjoinFinsetSpecDiagram K Γ(Z, ⊤),
    adjoinFinsetSpecStructure K Γ(Z, ⊤), adjoinFinsetSpecπ K Γ(Z, ⊤) Z.isoSpec,
    ⟨isLimitAdjoinFinsetSpecπ K Γ(Z, ⊤) Z.isoSpec⟩, inferInstance, inferInstance, inferInstance,
    fun s ↦ ?_⟩
  rw [adjoinFinsetSpecπ, NatTrans.comp_app, Category.assoc, adjoinFinsetSpecCone_π_app_comp]
  exact isoSpec_hom_SpecMap_ΓSpecIso_inv_comp_appTop a

end Scheme

end AlgebraicGeometry
