module

public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.RationalizationRecollement
public import WeilConjectures.SixFunctors.Etale.Derived.LocalizationIntegralClosedSupport

/-!
# The closed-support triangle on `Dᵇc(-, E)`

Let `Λ` be a noetherian ring and `I = (ϖ)` an ideal generated by a nonzerodivisor, with `Λ ⧸ I`
of exponent invertible on a field `k` (the integral stage `Λ = 𝒪_E`, `I = 𝔪_E`), and let `M` be a
submonoid of `Λ` (for instance the powers of `ϖ`). Following blueprint
`def-weil-rationalization-karoubi`, the rational stage is the raw scalar localization

`Dᵇc(X, E) = Dᵇc(X, 𝒪_E)[M⁻¹]`,

`CategoryTheory.Rationalization M` of the triangulated category
`(AlgebraicGeometry.Etale.DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory`,
with no Karoubi completion. This file proves clauses (1)–(4) of blueprint
`prop-sf-localization-all-stages` at the stage `E`, for a closed immersion `i : Z ⟶ X` and the
complementary quasi-compact open immersion `j : U ⟶ X`, `X` being of finite type over `k`:

1. `Rj_* : Dᵇc(U, E) ⥤ Dᵇc(X, E)` is the functor induced by the integral `Rj_*`
   (`AlgebraicGeometry.Etale.boundedConstructibleRationalRightDerivedLowerStar`);
2. `i_* : Dᵇc(Z, E) ⥤ Dᵇc(X, E)` has a right adjoint `Ri^!`
   (`AlgebraicGeometry.Etale.boundedConstructibleRationalClosedUpperShriekAdjunction`);
3. for `K ∈ Dᵇc(X, E)` the counit `i_* Ri^! K ⟶ K` and the unit `K ⟶ Rj_* j^* K` extend to a
   distinguished triangle with a unique third arrow
   (`existsUnique_distTriang_boundedConstructibleRationalClosedSupportTriangle`),
   functorial in `K`, because `Hom(i_* Q[m], Rj_* G) = 0`;
4. `Ri^! Rj_* = 0` and the unit `Q ⟶ Ri^! i_* Q` is an isomorphism
   (`AlgebraicGeometry.Etale.isZero_boundedConstructibleRationalClosedUpperShriek_obj`,
   `AlgebraicGeometry.Etale.isIso_boundedConstructibleRationalClosedUpperShriekAdjunction_unit`).

The proof applies the rationalization of recollement data
(`WeilConjectures.CategoryTheory.DerivedCategory.Complete.RationalizationRecollement`) to the
integral recollement data of `WeilConjectures.SixFunctors.Etale.Derived.LocalizationIntegral`:
the integral `i_*`, `j^*` and `Rj_*` are `Λ`-linear triangulated functors, `i_*` is fully
faithful, `j^* ⊣ Rj_*` has invertible counit, `j^* i_* = 0`, and an object killed by `j^*` is in
the essential image of `i_*`. As at the integral stage, the triangulated structure on
`Dᵇc(-, 𝒪_E)` uses that constructible sheaves of `Λ`-modules are closed under extensions.
-/

@[expose] public section

universe u

open CategoryTheory Limits Pretriangulated

namespace AlgebraicGeometry

open Scheme

namespace Etale

variable {Λ : Type (u + 1)} [CommRing Λ] (M : Submonoid Λ) {I : Ideal Λ}

set_option hygiene false in
/-- The rational stage `Dᵇc(X, E) = Dᵇc(X, 𝒪_E)[M⁻¹]`. -/
local notation "𝐃ᵇc(" X ")" =>
  Rationalization M (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory

section Operations

variable {U X Y : Scheme.{u}} [IsNoetherianRing Λ]
  [Fact (∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})]
  [(constructibleSheaf (ModuleCat.{u + 1} Λ) X).IsClosedUnderExtensions]
  [(constructibleSheaf (ModuleCat.{u + 1} Λ) Y).IsClosedUnderExtensions]
  [(constructibleSheaf (ModuleCat.{u + 1} Λ) U).IsClosedUnderExtensions]

variable (I) in
/-- The pullback `j^* : Dᵇc(X, E) ⥤ Dᵇc(U, E)` along an open immersion, induced by the integral
pullback `AlgebraicGeometry.Etale.boundedConstructibleIntegralUpperStar`.
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
noncomputable abbrev boundedConstructibleRationalUpperStar (j : U ⟶ X) [IsOpenImmersion j] :
    𝐃ᵇc(X) ⥤ 𝐃ᵇc(U) :=
  Rationalization.map M (boundedConstructibleIntegralUpperStar I j)

variable {k : Type u} [Field k] [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))]

variable (I) in
/-- Blueprint `prop-sf-localization-all-stages`, clause (1) at the rational stage `E`: the
direct image `Rf_* : Dᵇc(Y, E) ⥤ Dᵇc(X, E)` for `f` separated, quasi-compact and locally of
finite type (e.g. a quasi-compact open immersion `j`), induced by the integral direct image
`AlgebraicGeometry.Etale.boundedConstructibleIntegralRightDerivedLowerStar`, which carries
`Dᵇc(Y, 𝒪_E)` into `Dᵇc(X, 𝒪_E)`. -/
noncomputable abbrev boundedConstructibleRationalRightDerivedLowerStar (aX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType aX] [QuasiCompact aX] (f : Y ⟶ X) [IsSeparated f] [QuasiCompact f]
    [LocallyOfFiniteType f] : 𝐃ᵇc(Y) ⥤ 𝐃ᵇc(X) :=
  Rationalization.map M (boundedConstructibleIntegralRightDerivedLowerStar I aX f)

/-- The adjunction `j^* ⊣ Rj_*` on `Dᵇc(-, E)` for a quasi-compact open immersion `j`, induced by
`AlgebraicGeometry.Etale.boundedConstructibleIntegralUpperStarLowerStarAdjunction`.
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
noncomputable def boundedConstructibleRationalUpperStarLowerStarAdjunction
    (aX : X ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX] (j : U ⟶ X)
    [IsOpenImmersion j] [QuasiCompact j] :
    boundedConstructibleRationalUpperStar M I j ⊣
      boundedConstructibleRationalRightDerivedLowerStar M I aX j :=
  Rationalization.mapAdjunction M (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)

/-- For a quasi-compact open immersion `j`, the counit `j^* Rj_* ⟶ 𝟭` on `Dᵇc(-, E)` is an
isomorphism, as it is on `Dᵇc(-, 𝒪_E)`.
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
instance isIso_boundedConstructibleRationalUpperStarLowerStarAdjunction_counit
    (aX : X ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX] (j : U ⟶ X)
    [IsOpenImmersion j] [QuasiCompact j] :
    IsIso (boundedConstructibleRationalUpperStarLowerStarAdjunction M (I := I) aX j).counit :=
  Rationalization.isIso_mapAdjunction_counit _

end Operations

section ClosedSupport

variable {U Z X : Scheme.{u}} [IsNoetherianRing Λ]
  [Fact (∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})]
  [(constructibleSheaf (ModuleCat.{u + 1} Λ) X).IsClosedUnderExtensions]
  [(constructibleSheaf (ModuleCat.{u + 1} Λ) Z).IsClosedUnderExtensions]
  [(constructibleSheaf (ModuleCat.{u + 1} Λ) U).IsClosedUnderExtensions]
  {k : Type u} [Field k] [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))] (aX : X ⟶ Spec (.of k))
  [LocallyOfFiniteType aX] [QuasiCompact aX] (i : Z ⟶ X) [IsClosedImmersion i] (j : U ⟶ X)
  [IsOpenImmersion j] [QuasiCompact j] (hij : Set.range i.base = (Set.range j.base)ᶜ)

/-- Blueprint `prop-sf-closed-unit-all-stages`, rational stage `E`: the direct image
`i_* : Dᵇc(Z, E) ⥤ Dᵇc(X, E)` along a closed immersion is fully faithful, being induced by a fully
faithful `Λ`-linear triangulated functor (`CategoryTheory.Rationalization.full_map`,
`CategoryTheory.Rationalization.faithful_map`).
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
noncomputable def fullyFaithfulBoundedConstructibleRationalRightDerivedLowerStar :
    (boundedConstructibleRationalRightDerivedLowerStar M I aX i).FullyFaithful :=
  .ofFullyFaithful _

omit [QuasiCompact j] in
include hij in
/-- `j^* i_* = 0` on `Dᵇc(-, E)`, as on `Dᵇc(-, 𝒪_E)`
(`CategoryTheory.Rationalization.isZero_map_obj_map_obj`).
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
lemma isZero_boundedConstructibleRationalUpperStar_obj_rightDerivedLowerStar_obj (Q : 𝐃ᵇc(Z)) :
    IsZero ((boundedConstructibleRationalUpperStar M I j).obj
      ((boundedConstructibleRationalRightDerivedLowerStar M I aX i).obj Q)) :=
  Rationalization.isZero_map_obj_map_obj
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij) Q

include hij in
/-- An object of `Dᵇc(X, E)` killed by `j^*` lies in the essential image of `i_*`
(`CategoryTheory.Rationalization.essImage_map_of_isZero`).
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
lemma boundedConstructibleRationalRightDerivedLowerStar_essImage_of_isZero (K : 𝐃ᵇc(X))
    (hK : IsZero ((boundedConstructibleRationalUpperStar M I j).obj K)) :
    (boundedConstructibleRationalRightDerivedLowerStar M I aX i).essImage K :=
  Rationalization.essImage_map_of_isZero
    (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (boundedConstructibleIntegralRightDerivedLowerStar_essImage_of_isZero aX i j hij) K hK

include hij in
/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the rational stage `E`, the
vanishing: `Hom(i_* Q[m], Rj_* G) = 0` for `Q ∈ Dᵇc(Z, E)` and `G ∈ Dᵇc(U, E)`. -/
lemma subsingleton_hom_shift_boundedConstructibleRational (Q : 𝐃ᵇc(Z)) (G : 𝐃ᵇc(U)) (m : ℤ) :
    Subsingleton (((boundedConstructibleRationalRightDerivedLowerStar M I aX i).obj Q)⟦m⟧ ⟶
      (boundedConstructibleRationalRightDerivedLowerStar M I aX j).obj G) :=
  Recollement.subsingleton_hom_shift _ _
    (boundedConstructibleRationalUpperStarLowerStarAdjunction M aX j)
    (isZero_boundedConstructibleRationalUpperStar_obj_rightDerivedLowerStar_obj M aX i j hij)
    Q G m

include j hij in
/-- The direct image `i_* : Dᵇc(Z, E) ⥤ Dᵇc(X, E)` along a closed immersion is a left adjoint
(`CategoryTheory.Rationalization.isLeftAdjoint_map`).
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
lemma isLeftAdjoint_boundedConstructibleRationalRightDerivedLowerStar :
    (boundedConstructibleRationalRightDerivedLowerStar M I aX i).IsLeftAdjoint :=
  Rationalization.isLeftAdjoint_map (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij)
    (boundedConstructibleIntegralRightDerivedLowerStar_essImage_of_isZero aX i j hij)

variable (I) in
include aX i j hij in
/-- Blueprint `prop-sf-localization-all-stages`, clause (2) at the rational stage `E`: the
exceptional inverse image `Ri^! : Dᵇc(X, E) ⥤ Dᵇc(Z, E)` along a closed immersion, the right
adjoint of `i_*`
(`AlgebraicGeometry.Etale.isLeftAdjoint_boundedConstructibleRationalRightDerivedLowerStar`). -/
noncomputable def boundedConstructibleRationalClosedUpperShriek : 𝐃ᵇc(X) ⥤ 𝐃ᵇc(Z) :=
  have := isLeftAdjoint_boundedConstructibleRationalRightDerivedLowerStar M (I := I) aX i j hij
  (boundedConstructibleRationalRightDerivedLowerStar M I aX i).rightAdjoint

/-- Blueprint `prop-sf-localization-all-stages`, clause (2) at the rational stage `E`: the
direct image `i_* : Dᵇc(Z, E) ⥤ Dᵇc(X, E)` along a closed immersion has the right adjoint `Ri^!`,
constructed by the recollement argument on the rationalized recollement data
(`CategoryTheory.Rationalization.isLeftAdjoint_map`). -/
noncomputable def boundedConstructibleRationalClosedUpperShriekAdjunction :
    boundedConstructibleRationalRightDerivedLowerStar M I aX i ⊣
      boundedConstructibleRationalClosedUpperShriek M I aX i j hij :=
  have := isLeftAdjoint_boundedConstructibleRationalRightDerivedLowerStar M (I := I) aX i j hij
  Adjunction.ofIsLeftAdjoint _

/-- The closed-support triangle `i_* Ri^! K ⟶ K ⟶ Rj_* j^* K ⟶ (i_* Ri^! K)[1]` on
`Dᵇc(X, E)`, with third arrow `w`.
Blueprint `prop-sf-localization-all-stages` (rational stage `E`). -/
noncomputable abbrev boundedConstructibleRationalClosedSupportTriangle (K : 𝐃ᵇc(X))
    (w : (boundedConstructibleRationalRightDerivedLowerStar M I aX j).obj
        ((boundedConstructibleRationalUpperStar M I j).obj K) ⟶
      ((boundedConstructibleRationalRightDerivedLowerStar M I aX i).obj
        ((boundedConstructibleRationalClosedUpperShriek M I aX i j hij).obj K))⟦(1 : ℤ)⟧) :
    Triangle 𝐃ᵇc(X) :=
  Recollement.triangle (boundedConstructibleRationalUpperStarLowerStarAdjunction M aX j)
    (boundedConstructibleRationalClosedUpperShriekAdjunction M aX i j hij) K w

/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the rational stage `E`: for
`K ∈ Dᵇc(X, E)`, the counit `i_* Ri^! K ⟶ K` and the unit `K ⟶ Rj_* j^* K` extend to a
distinguished triangle `i_* Ri^! K ⟶ K ⟶ Rj_* j^* K ⟶ (i_* Ri^! K)[1]` of `Dᵇc(X, E)`, and its
third arrow is unique, as `Hom(i_* Q[m], Rj_* G) = 0`
(`AlgebraicGeometry.Etale.subsingleton_hom_shift_boundedConstructibleRational`). -/
theorem existsUnique_distTriang_boundedConstructibleRationalClosedSupportTriangle (K : 𝐃ᵇc(X)) :
    ∃! w, boundedConstructibleRationalClosedSupportTriangle M aX i j hij K w ∈ distTriang _ :=
  Rationalization.existsUnique_distTriang_counit_unit_map
    (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij)
    (boundedConstructibleIntegralRightDerivedLowerStar_essImage_of_isZero aX i j hij)
    (boundedConstructibleRationalClosedUpperShriekAdjunction M aX i j hij) K

/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the rational stage `E`,
functoriality: for `φ : K ⟶ K'` in `Dᵇc(X, E)` and distinguished closed-support triangles of `K`
and `K'`, the triple `(i_* Ri^! φ, φ, Rj_* j^* φ)` is a morphism of triangles. -/
theorem exists_triangleHom_boundedConstructibleRationalClosedSupportTriangle {K K' : 𝐃ᵇc(X)}
    (φ : K ⟶ K') {w w'}
    (hw : boundedConstructibleRationalClosedSupportTriangle M aX i j hij K w ∈ distTriang _)
    (hw' : boundedConstructibleRationalClosedSupportTriangle M aX i j hij K' w' ∈ distTriang _) :
    ∃ τ : boundedConstructibleRationalClosedSupportTriangle M aX i j hij K w ⟶
        boundedConstructibleRationalClosedSupportTriangle M aX i j hij K' w',
      τ.hom₁ = (boundedConstructibleRationalRightDerivedLowerStar M I aX i).map
          ((boundedConstructibleRationalClosedUpperShriek M I aX i j hij).map φ) ∧
        τ.hom₂ = φ ∧
        τ.hom₃ = (boundedConstructibleRationalRightDerivedLowerStar M I aX j).map
          ((boundedConstructibleRationalUpperStar M I j).map φ) :=
  Recollement.exists_triangleHom _ _
    (isZero_boundedConstructibleRationalUpperStar_obj_rightDerivedLowerStar_obj M aX i j hij)
    φ hw hw'

/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the rational stage `E`,
functoriality: a morphism of distinguished closed-support triangles is determined by its middle
component. -/
theorem boundedConstructibleRationalClosedSupportTriangle_hom_ext {K K' : 𝐃ᵇc(X)} {w w'}
    (hw : boundedConstructibleRationalClosedSupportTriangle M aX i j hij K w ∈ distTriang _)
    (hw' : boundedConstructibleRationalClosedSupportTriangle M aX i j hij K' w' ∈ distTriang _)
    {τ τ' : boundedConstructibleRationalClosedSupportTriangle M aX i j hij K w ⟶
      boundedConstructibleRationalClosedSupportTriangle M aX i j hij K' w'}
    (h : τ.hom₂ = τ'.hom₂) : τ = τ' :=
  Recollement.triangleHom_ext _ _
    (isZero_boundedConstructibleRationalUpperStar_obj_rightDerivedLowerStar_obj M aX i j hij)
    hw hw' h

/-- Blueprint `prop-sf-localization-all-stages`, clause (4) at the rational stage `E`:
`Ri^! Rj_* G = 0` for `G ∈ Dᵇc(U, E)`, as `Hom(Q, Ri^! Rj_* G) = Hom(i_* Q, Rj_* G) = 0`. -/
theorem isZero_boundedConstructibleRationalClosedUpperShriek_obj (G : 𝐃ᵇc(U)) :
    IsZero ((boundedConstructibleRationalClosedUpperShriek M I aX i j hij).obj
      ((boundedConstructibleRationalRightDerivedLowerStar M I aX j).obj G)) :=
  Recollement.isZero_obj_obj (boundedConstructibleRationalUpperStarLowerStarAdjunction M aX j)
    (boundedConstructibleRationalClosedUpperShriekAdjunction M aX i j hij)
    (isZero_boundedConstructibleRationalUpperStar_obj_rightDerivedLowerStar_obj M aX i j hij) G

/-- Blueprint `prop-sf-localization-all-stages`, clause (4) at the rational stage `E`: the unit
`Q ⟶ Ri^! i_* Q` is an isomorphism, `i_*` being fully faithful on `Dᵇc(-, E)` (blueprint
`prop-sf-closed-unit-all-stages`). -/
instance isIso_boundedConstructibleRationalClosedUpperShriekAdjunction_unit :
    IsIso (boundedConstructibleRationalClosedUpperShriekAdjunction M (I := I) aX i j hij).unit :=
  Adjunction.unit_isIso_of_L_fully_faithful _

end ClosedSupport

end Etale

end AlgebraicGeometry
