 namespace lean {
+/* === BEGIN kernel defeq instrumentation (local debug build) ===
+   Runtime-controlled via environment variables (all default to "off"):
+     LEAN_DEFEQ_TRACE_MS=<n>        report every is_def_eq_core call taking >= n ms
+     LEAN_DELTA_TRACE_N=<n>         log the first n lazy_delta_reduction_step decisions
+     LEAN_DELTA_TRACE_MINDEPTH=<n>  only log delta steps at is_def_eq_core depth >= n
+*/
+static bool     g_defeq_trace_init      = false;
+static unsigned g_defeq_trace_ms        = 0;
+static long     g_delta_trace_budget    = 0;
+static unsigned g_delta_trace_mindepth  = 0;
+static thread_local unsigned g_defeq_depth = 0;
+
+static void lean_defeq_trace_init() {
+    if (g_defeq_trace_init) return;
+    g_defeq_trace_init = true;
+    if (char const * v = std::getenv("LEAN_DEFEQ_TRACE_MS")) g_defeq_trace_ms = (unsigned)atol(v);
+    if (char const * v = std::getenv("LEAN_DELTA_TRACE_N"))  g_delta_trace_budget = atol(v);
+    if (char const * v = std::getenv("LEAN_DELTA_TRACE_MINDEPTH")) g_delta_trace_mindepth = (unsigned)atol(v);
+}
+
+static std::string lean_head_desc(expr const & e) {
+    expr const & f = get_app_fn(e);
+    std::string h;
+    if (is_constant(f))    h = const_name(f).to_string();
+    else if (is_fvar(f))   h = "#fvar";
+    else if (is_sort(f))   h = "#Sort";
+    else if (is_lambda(f)) h = "#lam";
+    else if (is_pi(f))     h = "#forall";
+    else if (is_proj(f))   h = "#proj:" + proj_sname(f).to_string();
+    else if (is_lit(f))    h = "#lit";
+    else if (is_let(f))    h = "#let";
+    else if (is_mdata(f))  h = "#mdata";
+    else                   h = "#other";
+    return h + "/" + std::to_string(get_app_num_args(e));
+}
+
+static std::string lean_hint_desc(optional<constant_info> const & d) {
+    if (!d) return std::string("-");
+    reducibility_hints h = d->get_hints();
+    if (h.is_regular()) return std::string("regular:") + std::to_string(h.get_height());
+    if (h.is_abbreviation()) return std::string("abbrev");
+    return std::string("opaque");
+}
+
+static void lean_delta_log(char const * action, expr const & t, expr const & s,
+                           optional<constant_info> const & d_t, optional<constant_info> const & d_s) {
+    if (g_delta_trace_budget <= 0) return;
+    if (g_defeq_depth < g_delta_trace_mindepth) return;
+    g_delta_trace_budget--;
+    fprintf(stderr, "[DELTA] depth=%u action=%-16s lhs=%s [%s]  rhs=%s [%s]\n",
+            g_defeq_depth, action,
+            lean_head_desc(t).c_str(), lean_hint_desc(d_t).c_str(),
+            lean_head_desc(s).c_str(), lean_hint_desc(d_s).c_str());
+    fflush(stderr);
+}
+/* === END kernel defeq instrumentation === */
+
 static name * g_kernel_fresh = nullptr;
 static expr * g_dont_care    = nullptr;
 static name * g_bool_true    = nullptr;
@@ -999,6 +1059,16 @@ optional<expr> type_checker::try_unfold_proj_app(expr const & e) {
 auto type_checker::lazy_delta_reduction_step(expr & t_n, expr & s_n) -> reduction_status {
     auto d_t = is_delta(t_n);
