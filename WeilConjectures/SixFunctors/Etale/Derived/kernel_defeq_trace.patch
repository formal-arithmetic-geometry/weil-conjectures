+    if (g_delta_trace_budget > 0) {
+        char const * act = (!d_t && !d_s) ? "no-delta"
+                         : (d_t && !d_s) ? "unfold-lhs?proj-rhs"
+                         : (!d_t && d_s) ? "unfold-rhs?proj-lhs"
+                         : (compare(d_t->get_hints(), d_s->get_hints()) < 0) ? "unfold-lhs(height)"
+                         : (compare(d_t->get_hints(), d_s->get_hints()) > 0) ? "unfold-rhs(height)"
+                         : (is_app(t_n) && is_app(s_n) && is_eqp(*d_t, *d_s) && d_t->get_hints().is_regular()) ? "try-args-then-both"
+                         : "unfold-both";
+        lean_delta_log(act, t_n, s_n, d_t, d_s);
+    }
     if (!d_t && !d_s) {
         return reduction_status::DefUnknown;
     } else if (d_t && !d_s) {
@@ -1169,6 +1239,23 @@ bool type_checker::is_def_eq_unit_like(expr const & t, expr const & s) {
 }
 
 bool type_checker::is_def_eq_core(expr const & t, expr const & s) {
+    lean_defeq_trace_init();
+    if (g_defeq_trace_ms == 0 && g_delta_trace_budget == 0) return is_def_eq_core_impl(t, s);
+    unsigned d = g_defeq_depth++;
+    auto start = std::chrono::steady_clock::now();
+    bool r;
+    try { r = is_def_eq_core_impl(t, s); } catch (...) { g_defeq_depth = d; throw; }
+    g_defeq_depth = d;
+    long long ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+    if (g_defeq_trace_ms && ms >= (long long)g_defeq_trace_ms) {
+        fprintf(stderr, "[DEFEQ-SLOW] depth=%u ms=%lld res=%d lhs=%s rhs=%s\n", d, ms, (int)r,
+                lean_head_desc(t).c_str(), lean_head_desc(s).c_str());
+        fflush(stderr);
+    }
+    return r;
+}
