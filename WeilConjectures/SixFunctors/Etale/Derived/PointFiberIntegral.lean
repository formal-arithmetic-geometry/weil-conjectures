/-!
# Integral constructible complexes over a geometric point

Let `k` be a separably closed field and `Λ` a complete discrete valuation ring with finite
residue field, for instance the ring of integers `𝒪_E` of a finite extension `E` of `ℚ_ℓ`, with
maximal ideal `I = (ϖ)`. The integral stage `Dᵇc(Spec k, Λ)` of the `ℓ`-adic formalism
(`AlgebraicGeometry.Etale.DerivedCategory.boundedConstructibleIntegral`) consists of the objects
of `D((Spec k)_ét, Λ)` which are derived complete and whose reductions `K ⊗ᴸ Λ/Iⁿ⁺¹` are
bounded constructible of Tor amplitude in one common interval. This file shows that these are
exactly the bounded constructible objects, so that the global sections induce an equivalence

`Fib_s : Dᵇc(Spec k, Λ) ≌ Dᵇ_fg(Λ)`

with the bounded complexes of `Λ`-modules with finitely generated cohomology modules, all of which
are derived complete.

## Main statements

- `AlgebraicGeometry.Etale.boundedConstructibleIntegral_iff_boundedConstructible`: on `Spec k`,
  the integral stage consists of the bounded constructible complexes.
- `AlgebraicGeometry.Etale.pointFiberIntegralEquivalence` and, for `Λ = 𝒪_E`,
  `AlgebraicGeometry.Etale.pointFiberIntegerRingEquivalence` (`def-weil-finite-coefficient-point`,
  integral stage): `Fib_s : Dᵇc(Spec k, Λ) ≌ Dᵇ_fg(Λ)`.
- `DerivedCategory.boundedFiniteCohomology_rightOrthogonal`: the objects of `Dᵇ_fg(Λ)` are
  derived complete, i.e. receive no nonzero map from an object on which `ϖ` acts invertibly.

## Proof

If `K` is bounded constructible, the dévissage of bounded complexes reduces the claim to a
constructible sheaf, the constant sheaf on a finitely generated `Λ`-module, which is a cokernel of
a map of finite free modules; so it reduces to `Λ` placed in degree `0`. Its reductions are the
constant sheaves `Λ/Iⁿ⁺¹`, of Tor amplitude in `[-1, 0]` by the triangles `Λ ⟶ Λ ⟶ Λ/Iⁿ⁺¹`; and
`Λ` is derived complete, being the homotopy limit of the tower `Λ/Iⁿ`, as it is for modules
(`DerivedCategory.isHomotopyLimit_mapCone_Q_of_epi`).

Conversely, let `K` be derived complete with reductions `Kₙ` of Tor amplitude in `[a, b]` with
constructible cohomology. Morphisms out of `Λ` placed in degree `j` compute the global sections of
the cohomology sheaves (`AlgebraicGeometry.Etale.homSingleLinearEquiv`), which for the `Kₙ` are
finite and vanish outside `[a, b]`. The Milnor sequence of the homotopy limit `K = R lim Kₙ`
then shows that `M = Hom(Λ[-j], K)` is the inverse limit of the finite groups
`Hom(Λ[-j], Kₙ)`: it vanishes outside `[a, b]`, it is `ϖ`-adically separated, and `M/ϖM`
embeds into `Hom(Λ[-j], K₁)`, so `M` is finitely generated
(`Module.finite_of_isHausdorff_of_ker_le`).
-/

@[expose] public section

universe w u

open CategoryTheory Limits Opposite Pretriangulated

/-! ### A finiteness criterion for separated modules -/

section Algebra

variable {Λ M : Type*} [CommRing Λ] [AddCommGroup M] [Module Λ M]

/-- Let `I = (ϖ)` be a principal ideal of a ring `Λ` which is `I`-adically precomplete. A
module `M` which is `I`-adically separated and which is generated by finitely many elements
modulo `I` is generated by them. -/
lemma Module.span_eq_top_of_isHausdorff {I : Ideal Λ} {ϖ : Λ} (hI : I = Ideal.span {ϖ})
    [IsPrecomplete I Λ] [IsHausdorff I M] {r : ℕ} (x : Fin r → M)
    (hx : ∀ y : M, ∃ (c : Fin r → Λ) (z : M), y = ∑ i, c i • x i + ϖ • z) :
    Submodule.span Λ (Set.range x) = ⊤ := by
  have hϖ : ϖ ∈ I := hI ▸ Ideal.mem_span_singleton_self ϖ
  choose c z hcz using hx
  refine eq_top_iff.2 fun y _ ↦ ?_
  -- the successive remainders `yₘ`, with `y = ∑ Sₘ i • x i + ϖᵐ • yₘ`
  let ys : ℕ → M := fun m ↦ Nat.rec (motive := fun _ ↦ M) y (fun _ w ↦ z w) m
  let S : ℕ → Fin r → Λ := fun m i ↦ ∑ k ∈ Finset.range m, ϖ ^ k * c (ys k) i
  have hS (m : ℕ) : y = ∑ i, S m i • x i + ϖ ^ m • ys m := by
    induction m with
    | zero => simp [S, ys]
    | succ m ih =>
      have h : ys m = ∑ i, c (ys m) i • x i + ϖ • ys (m + 1) := hcz (ys m)
      calc y = ∑ i, S m i • x i + ϖ ^ m • ys m := ih
        _ = ∑ i, S m i • x i + ϖ ^ m • (∑ i, c (ys m) i • x i + ϖ • ys (m + 1)) := by
          rw [← h]
        _ = ∑ i, S (m + 1) i • x i + ϖ ^ (m + 1) • ys (m + 1) := by
          simp only [S, Finset.sum_range_succ, add_smul, Finset.sum_add_distrib, smul_add,
            Finset.smul_sum, smul_smul, pow_succ, add_assoc]
  have hmem {m : ℕ} {a : Λ} (ha : a ∈ I ^ m) (w : M) : a • w ∈ I ^ m • (⊤ : Submodule Λ M) :=
    Submodule.smul_mem_smul ha Submodule.mem_top
  have hpow (m : ℕ) : ϖ ^ m ∈ I ^ m := Ideal.pow_mem_pow hϖ m
  have hcauchy (i : Fin r) {m n : ℕ} (hmn : m ≤ n) :
      S m i ≡ S n i [SMOD I ^ m • (⊤ : Submodule Λ Λ)] := by
    rw [SModEq.sub_mem, ← neg_mem_iff, neg_sub]
    have : S n i - S m i = ∑ k ∈ Finset.Ico m n, ϖ ^ k * c (ys k) i := by
      simp only [S]
      rw [← Finset.sum_range_add_sum_Ico _ hmn, add_sub_cancel_left]
    rw [this]
    refine Submodule.sum_mem _ fun k hk ↦ ?_
    have hk : m ≤ k := (Finset.mem_Ico.1 hk).1
    rw [← smul_eq_mul]
    exact Submodule.smul_mem_smul (Ideal.pow_le_pow_right hk (hpow k)) Submodule.mem_top
  choose L hL using fun i ↦ IsPrecomplete.prec inferInstance (hcauchy i)
  have hy : y - ∑ i, L i • x i = 0 := by
    refine IsHausdorff.haus (I := I) inferInstance _ fun m ↦ ?_
    rw [SModEq.sub_mem, sub_zero]
    have hm : y - ∑ i, L i • x i = ∑ i, (S m i - L i) • x i + ϖ ^ m • ys m := by
      conv_lhs => rw [hS m]
      simp only [sub_smul, Finset.sum_sub_distrib]
      abel
    rw [hm]
    refine Submodule.add_mem _ (Submodule.sum_mem _ fun i _ ↦ hmem ?_ _) (hmem (hpow m) _)
    have := SModEq.sub_mem.1 (hL i m)
    rwa [smul_eq_mul, Ideal.mul_top] at this
  rw [sub_eq_zero] at hy
  rw [hy]
  exact Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- Let `I = (ϖ)` be a principal ideal of a ring `Λ` which is `I`-adically precomplete, and let
`M` be an `I`-adically separated `Λ`-module. If an additive map `f : M → T` to a finite group has
its kernel in `IM`, then `M` is finitely generated. -/
lemma Module.finite_of_isHausdorff_of_ker_le {I : Ideal Λ} {ϖ : Λ} (hI : I = Ideal.span {ϖ})
    [IsPrecomplete I Λ] [IsHausdorff I M] {T : Type*} [AddCommGroup T] [Finite T] (f : M →+ T)
    (hf : ∀ y, f y = 0 → ∃ z, y = ϖ • z) : Module.Finite Λ M := by
  classical
  -- choose representatives of the finitely many values of `f`
  obtain ⟨r, ⟨e⟩⟩ := Finite.exists_equiv_fin (Set.range f)
  let x : Fin r → M := fun i ↦ (e.symm i).2.choose
  have hx (i : Fin r) : f (x i) = e.symm i := (e.symm i).2.choose_spec
  refine ⟨⟨Finset.univ.image x, ?_⟩⟩
  rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  refine Module.span_eq_top_of_isHausdorff hI x fun y ↦ ?_
  let i := e ⟨f y, y, rfl⟩
  obtain ⟨z, hz⟩ := hf (y - x i) (by rw [map_sub, hx, Equiv.symm_apply_apply, sub_self])
  refine ⟨Pi.single i 1, z, ?_⟩
  rw [← hz]
  simp [Pi.single_apply]

end Algebra

namespace AlgebraicGeometry

open Scheme

namespace Etale

/-! ### Morphisms out of the constant sheaf `Λ` on a geometric point -/

section Point

variable {Λ : Type (u + 1)} [CommRing Λ] {k : Type u} [Field k] [IsSepClosed k]

instance : (pointSections Λ k).Linear Λ where
  map_smul _ _ := rfl

variable (Λ k) in
/-- The constant sheaf `Λ` on `Spec k`. -/
noncomputable abbrev unitSheaf : Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ) :=
  (constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj (ModuleCat.of Λ Λ)

/-- Over a separably closed field `k`, the morphisms `Λ ⟶ F` of étale sheaves on `Spec k` are the
global sections of `F`. -/
noncomputable def unitSheafHomLinearEquiv
    (F : Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)) :
    (unitSheaf Λ k ⟶ F) ≃ₗ[Λ] (pointSections Λ k).obj F :=
  letI : (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).inverse.Linear Λ :=
    inferInstanceAs ((pointSections Λ k).Linear Λ)
  letI : (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).inverse.Additive :=
    inferInstanceAs ((pointSections Λ k).Additive)
  ({ toEquiv := (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).toAdjunction.homEquiv
       (ModuleCat.of Λ Λ) F
     map_add' f g := by
       simp only [Equiv.toFun_as_coe, Adjunction.homEquiv_unit,
         Functor.map_add, Preadditive.comp_add]
     map_smul' c f := by
       simp only [Equiv.toFun_as_coe, Adjunction.homEquiv_unit, Functor.map_smul,
         Linear.comp_smul, RingHom.id_apply]
       } : _ ≃ₗ[Λ] _) ≪≫ₗ
    ModuleCat.homSelfLinearEquiv Λ _

/-- Over a separably closed field `k`, the morphisms `Λ[-j] ⟶ Y` in `D((Spec k)_ét, Λ)` are the
global sections of the `j`-th cohomology sheaf of `Y`: the constant sheaf `Λ` is projective. -/
noncomputable def homSingleLinearEquiv
    (Y : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)))
    (j : ℤ) :
    ((DerivedCategory.singleFunctor _ j).obj (unitSheaf Λ k) ⟶ Y) ≃ₗ[Λ]
      (pointSections Λ k).obj ((DerivedCategory.homologyFunctor _ j).obj Y) :=
  ({ toEquiv := DerivedCategory.homSingleEquivOfProjective (unitSheaf Λ k) j Y
     map_add' f g := by simp [DerivedCategory.homSingleToHomology]
     map_smul' c f := by simp [DerivedCategory.homSingleToHomology] } : _ ≃ₗ[Λ] _) ≪≫ₗ
    unitSheafHomLinearEquiv _

end Point

/-! ### The reduction triangles -/

/-- The small étale site of a scheme is essentially small. Instance search does not find this
in the presence of the imports of this file. This single instance is used throughout the file, so
that all statements about derived completeness below use the same instance. -/
local instance essentiallySmall_etale_pointFiberIntegral (X : Scheme.{u}) :
    EssentiallySmall.{u + 1} X.Etale :=
  have : LocallySmall.{u + 1} X.Etale :=
    @locallySmall_of_univLE X.Etale _ (@univLE_of_max.{u, u + 1} UnivLE.self)
  essentiallySmall_of_small_of_locallySmall _

section Reduction

variable {Λ : Type (u + 1)} [CommRing Λ] {I : Ideal Λ} {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ)
  (hI : I = Ideal.span {ϖ}) {X : Scheme.{u}}

include hϖ hI in
/-- The reduction `K ⊗ᴸ (Λ/Iⁿ)_X` is the cone of the multiplication by `ϖⁿ` on `K`: the
triangle `Λ ⟶ Λ ⟶ Λ/Iⁿ ⟶ Λ⟦1⟧` tensored with `K`. -/
lemma exists_distTriang_reductionModIdeal
    (K : DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) (n : ℕ) :
    ∃ (g : K ⟶ (reductionModIdeal Λ X (I ^ n)).obj K)
      (h : (reductionModIdeal Λ X (I ^ n)).obj K ⟶ K⟦(1 : ℤ)⟧),
      Triangle.mk (ϖ ^ n • 𝟙 K) g h ∈ distTriang _ := by
  let F := (derivedTensor (ModuleCat.{u + 1} Λ) X).obj K
  let T := DerivedCategory.quotPowTriangle X.smallEtaleTopology hϖ hI n
  have hT : F.mapTriangle.obj T ∈ distTriang _ :=
    F.map_distinguished _ (DerivedCategory.quotPowTriangle_distinguished _ hϖ hI n)
  let u : F.obj T.obj₁ ≅ K := derivedTensorSingleUnitIso K
  have hmor : F.map T.mor₁ = ϖ ^ n • 𝟙 (F.obj T.obj₁) := by
    rw [DerivedCategory.quotPowTriangle_mor₁, Functor.map_smul, CategoryTheory.Functor.map_id]
  refine ⟨u.inv ≫ F.map T.mor₂,
    F.map T.mor₃ ≫ (F.commShiftIso (1 : ℤ)).hom.app _ ≫ u.hom⟦(1 : ℤ)⟧',
    isomorphic_distinguished _ hT _ (Triangle.isoMk _ _ u.symm u.symm (Iso.refl _) ?_ ?_ ?_)⟩
  · change (ϖ ^ n • 𝟙 K) ≫ u.inv = u.inv ≫ F.map T.mor₁
    rw [hmor, Linear.smul_comp, Linear.comp_smul, Category.id_comp, Category.comp_id]
  · change (u.inv ≫ F.map T.mor₂) ≫ 𝟙 _ = u.inv ≫ F.map T.mor₂
    rw [Category.comp_id]
  · change (F.map T.mor₃ ≫ (F.commShiftIso (1 : ℤ)).hom.app _ ≫ u.hom⟦(1 : ℤ)⟧') ≫
      u.inv⟦(1 : ℤ)⟧' = 𝟙 _ ≫ F.map T.mor₃ ≫ (F.commShiftIso (1 : ℤ)).hom.app _
    rw [Category.assoc, Category.assoc, ← Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
    simp

include hϖ hI in
/-- The terms `K ⊗ᴸ Λ/Iⁿ` of the tower of reductions of `DerivedCategory.derivedCompletionDiagram`
are the reductions `AlgebraicGeometry.Etale.reductionModIdeal`: both are cones of the
multiplication by `ϖⁿ` on `K`. -/
lemma nonempty_iso_derivedCompletionDiagram_obj
    (K : DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) (n : ℕ) :
    Nonempty ((DerivedCategory.derivedCompletionDiagram X.smallEtaleTopology I K).obj (op n) ≅
      (reductionModIdeal Λ X (I ^ n)).obj K) := by
  obtain ⟨h, hT⟩ := DerivedCategory.exists_distTriang_derivedCompletionCone hϖ hI K n
  obtain ⟨g', h', hT'⟩ := exists_distTriang_reductionModIdeal hϖ hI K n
  obtain ⟨e, -⟩ := Pretriangulated.exists_iso_of_arrow_iso _ _ hT hT' (Iso.refl _)
  exact ⟨Triangle.π₃.mapIso e⟩

end Reduction

/-! ### The integral stage over a geometric point -/

section IntegralPoint

variable {Λ : Type (u + 1)} [CommRing Λ] {I : Ideal Λ} {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ)
  (hI : I = Ideal.span {ϖ}) {k : Type u} [Field k] [IsSepClosed k]

/-- A finitely generated module killed by an ideal `J` with `Λ ⧸ J` finite is finite. -/
lemma _root_.Module.Finite.finite_of_smul_eq_zero {M : Type*} [AddCommGroup M] [Module Λ M]
    [Module.Finite Λ M] {J : Ideal Λ} [Finite (Λ ⧸ J)] (hJ : ∀ a ∈ J, ∀ x : M, a • x = 0) :
    Finite M := by
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := Λ) (M := M)
  let φ : (s → Λ ⧸ J) → M := fun c ↦ ∑ i, (c i).out • (i : M)
  refine Finite.of_surjective φ fun y ↦ ?_
  have hy : y ∈ Submodule.span Λ (s : Set M) := hs ▸ Submodule.mem_top
  obtain ⟨c, hc⟩ := (Finsupp.mem_span_iff_linearCombination Λ _ _).1 hy
  refine ⟨fun i ↦ Ideal.Quotient.mk J (c i), ?_⟩
  rw [← hc, Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have : (Ideal.Quotient.mk J (c i)).out - c i ∈ J := by
    rw [← Ideal.Quotient.eq, Ideal.Quotient.mk_out]
  rw [← sub_eq_zero, ← sub_smul, hJ _ this]

include hI in
/-- `ϖⁿ` kills the morphisms into the reduction `K ⊗ᴸ Λ/Iⁿ`, hence so does `Iⁿ`. -/
lemma smul_eq_zero_of_mem_pow {X : Scheme.{u}} {n : ℕ}
    {L K : DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hK : ϖ ^ n • 𝟙 K = 0) {a : Λ} (ha : a ∈ I ^ n) (f : L ⟶ K) : a • f = 0 := by
  rw [hI, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
  obtain ⟨b, rfl⟩ := ha
  rw [mul_smul, ← Category.comp_id f, ← Linear.comp_smul, hK, Limits.comp_zero, smul_zero]

variable (Λ k) in
/-- The constant sheaf `Λ` on `Spec k` placed in degree `j`. -/
noncomputable abbrev unitSingle (j : ℤ) :
    DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)) :=
  (DerivedCategory.singleFunctor _ j).obj (unitSheaf Λ k)

/-- An étale sheaf on `Spec k` with no nonzero global section is zero. -/
lemma isZero_of_subsingleton_pointSections
    (F : Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))
    (h : Subsingleton ((pointSections Λ k).obj F)) : IsZero F := by
  have : (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).functor.Additive :=
    additive_constantSheaf Λ _
  exact (Functor.map_isZero (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).functor
    (ModuleCat.isZero_of_subsingleton ((pointSections Λ k).obj F))).of_iso
    ((constantSheafEquivalenceOfIsSepClosed Λ (k := k)).counitIso.app F).symm

/-- Morphisms `Λ[-j] ⟶ R` vanish when the `j`-th cohomology sheaf of `R` does. -/
lemma subsingleton_hom_unitSingle
    {R : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))} {j : ℤ}
    (hR : IsZero ((DerivedCategory.homologyFunctor _ j).obj R)) :
    Subsingleton (unitSingle Λ k j ⟶ R) :=
  (homSingleLinearEquiv R j).toEquiv.subsingleton_congr.2
    (ModuleCat.subsingleton_of_isZero ((pointSections Λ k).map_isZero hR))

variable [IsNoetherianRing Λ] [Finite (Λ ⧸ I)]

include hI in
/-- Let `R` be a bounded constructible object of `D((Spec k)_ét, Λ)` killed by `ϖⁿ`. The
morphisms `Λ[-j] ⟶ R` form a finite group. -/
lemma finite_hom_unitSingle {n : ℕ}
    {R : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hR : DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) (Spec (.of k)) R)
    (hn : ϖ ^ n • 𝟙 R = 0) (j : ℤ) : Finite (unitSingle Λ k j ⟶ R) := by
  have := (isConstructibleSheaf_iff_moduleFinite_pointSections _).1 (hR.2 j)
  have : Module.Finite Λ (unitSingle Λ k j ⟶ R) :=
    Module.Finite.equiv (homSingleLinearEquiv R j).symm
  have : Finite (Λ ⧸ I ^ n) := Ideal.finite_quotient_pow (IsNoetherian.noetherian I) n
  exact Module.Finite.finite_of_smul_eq_zero (J := I ^ n)
    fun a ha f ↦ smul_eq_zero_of_mem_pow hI hn ha f

include hϖ hI in
/-- The terms `Kₙ = K ⊗ᴸ Λ/Iⁿ` of the tower of reductions of an object `K` of the integral stage:
the morphism groups `Hom(Λ[-j], Kₙ)` are finite, and vanish outside the common Tor amplitude
interval `[a, b]` of the reductions. -/
lemma finite_hom_unitSingle_derivedCompletionDiagram
    {K : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    {a b : ℤ} (hab : ∀ n : ℕ,
      DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) (Spec (.of k))
          ((reductionModIdeal Λ (Spec (.of k)) (I ^ (n + 1))).obj K) ∧
        DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) (Spec (.of k)) a b
          ((reductionModIdeal Λ (Spec (.of k)) (I ^ (n + 1))).obj K)) (n : ℕ) (j : ℤ) :
    Finite (unitSingle Λ k j ⟶ (_root_.DerivedCategory.derivedCompletionDiagram
      (Spec (.of k)).smallEtaleTopology I K).obj (op n)) ∧
    (j < a ∨ b < j → Subsingleton (unitSingle Λ k j ⟶
      (_root_.DerivedCategory.derivedCompletionDiagram
        (Spec (.of k)).smallEtaleTopology I K).obj (op n))) := by
  have hϖI : ϖ ∈ I := hI ▸ Ideal.mem_span_singleton_self ϖ
  cases n with
  | zero =>
    obtain ⟨h, hT⟩ := _root_.DerivedCategory.exists_distTriang_derivedCompletionCone hϖ hI K 0
    have : IsIso (ϖ ^ 0 • 𝟙 K) := by rw [pow_zero, one_smul]; infer_instance
    have hz := (Triangle.isZero₃_iff_isIso₁ _ hT).2 this
    have : Subsingleton (unitSingle Λ k j ⟶ (_root_.DerivedCategory.derivedCompletionDiagram
        (Spec (.of k)).smallEtaleTopology I K).obj (op 0)) :=
      ⟨fun f g ↦ hz.eq_of_tgt f g⟩
    exact ⟨Finite.of_subsingleton, fun _ ↦ this⟩
  | succ n =>
    obtain ⟨e⟩ := nonempty_iso_derivedCompletionDiagram_obj hϖ hI K (n + 1)
    obtain ⟨hbc, hta⟩ := hab n
    have hn : ϖ ^ (n + 1) • 𝟙 ((reductionModIdeal Λ (Spec (.of k)) (I ^ (n + 1))).obj K) = 0 :=
      smul_id_reductionModIdeal (Ideal.pow_mem_pow hϖI _) K
    have hfin := finite_hom_unitSingle hI hbc hn j
    refine ⟨Finite.of_equiv _ ((Iso.refl _).homCongr e.symm), fun hj ↦ ?_⟩
    obtain ⟨h₁, h₂⟩ := _root_.DerivedCategory.homologyConcentratedIn_of_torAmplitudeIn hta
    have hz : IsZero ((_root_.DerivedCategory.homologyFunctor _ j).obj
        ((reductionModIdeal Λ (Spec (.of k)) (I ^ (n + 1))).obj K)) := by
      rcases hj with hj | hj
      · exact _root_.DerivedCategory.isZero_of_isGE _ a j hj
      · exact _root_.DerivedCategory.isZero_of_isLE _ b j hj
    have := subsingleton_hom_unitSingle hz
    exact ((Iso.refl _).homCongr e.symm).subsingleton_congr.1 this

omit [IsSepClosed k] [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] in
/-- For a derived complete `K` whose reductions have finite morphism groups out of `Λ[-j]`, the
Milnor map `Hom(Λ[-j], K) ⟶ limₙ Hom(Λ[-j], Kₙ)` is bijective. -/
lemma bijective_milnorMap_unitSingle
    {K : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hc : _root_.DerivedCategory.derivedComplete (Spec (.of k)).smallEtaleTopology I K) (j : ℤ)
    (hF : ∀ n : ℕ, Finite (unitSingle Λ k (j - 1) ⟶
      (_root_.DerivedCategory.derivedCompletionDiagram
        (Spec (.of k)).smallEtaleTopology I K).obj (op n))) :
    Function.Bijective (milnorMap (_root_.DerivedCategory.derivedCompletionCone
      (Spec (.of k)).smallEtaleTopology I K) (unitSingle Λ k j)) := by
  have (n : ℕ) : Finite ((unitSingle Λ k j)⟦(1 : ℤ)⟧ ⟶
      (_root_.DerivedCategory.derivedCompletionDiagram
        (Spec (.of k)).smallEtaleTopology I K).obj (op n)) :=
    have := hF n
    Finite.of_equiv _ ((((_root_.DerivedCategory.singleFunctors _).shiftIso 1 (j - 1) j
      (by lia)).app (unitSheaf Λ k)).homCongr (Iso.refl _)).symm
  exact IsHomotopyLimit.bijective_milnorMap hc _

omit [IsSepClosed k] [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] in
include hI in
/-- For a derived complete `K` whose Milnor maps are injective, `Hom(Λ[-j], K)` is
`ϖ`-adically separated: an element divisible by every `ϖⁿ` maps to zero in every
`Hom(Λ[-j], Kₙ)`, which is killed by `ϖⁿ`. -/
lemma isHausdorff_hom_unitSingle
    {K : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))} {j : ℤ}
    (hM : Function.Injective (milnorMap (_root_.DerivedCategory.derivedCompletionCone
      (Spec (.of k)).smallEtaleTopology I K) (unitSingle Λ k j))) :
    IsHausdorff I (unitSingle Λ k j ⟶ K) := by
  have hϖI : ϖ ∈ I := hI ▸ Ideal.mem_span_singleton_self ϖ
  refine ⟨fun x hx ↦ hM <| Subtype.ext <| funext fun n ↦ ?_⟩
  have hxn := hx n
  rw [SModEq.zero, hI, Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists] at hxn
  obtain ⟨y, -, rfl⟩ := hxn
  change (ϖ ^ n • y) ≫ _ = (0 : unitSingle Λ k j ⟶ K) ≫ _
  rw [Limits.zero_comp, Linear.smul_comp, ← Category.comp_id (Cone.π _ |>.app _),
    ← Category.assoc, ← Linear.comp_smul,
    _root_.DerivedCategory.smul_id_derivedCompletionDiagram_obj _ hϖI K n, Limits.comp_zero]

omit [IsSepClosed k] [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] in
include hϖ hI in
/-- The kernel of the reduction `Hom(Λ[-j], K) ⟶ Hom(Λ[-j], K ⊗ᴸ Λ/I)` is `ϖ Hom(Λ[-j], K)`. -/
lemma exists_eq_smul_of_comp_derivedCompletionCone_eq_zero
    {K : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))} {j : ℤ}
    (y : unitSingle Λ k j ⟶ K)
    (hy : y ≫ (_root_.DerivedCategory.derivedCompletionCone
      (Spec (.of k)).smallEtaleTopology I K).π.app (op 1) = 0) :
    ∃ z, y = ϖ • z := by
  obtain ⟨h₁, hT₁⟩ := _root_.DerivedCategory.exists_distTriang_derivedCompletionCone hϖ hI K 1
  obtain ⟨z, hz⟩ := Triangle.coyoneda_exact₂ _ hT₁ y hy
  refine ⟨z, ?_⟩
  rw [hz]
  change z ≫ (ϖ ^ 1 • 𝟙 K) = _
  rw [pow_one, Linear.comp_smul]
  erw [Category.comp_id]

include hϖ hI in
/-- Over a separably closed field `k`, an object of the integral stage `Dᵇc(Spec k, Λ)` is
bounded constructible. Writing `K = R lim Kₙ` for its reductions `Kₙ = K ⊗ᴸ Λ/Iⁿ`, the Milnor
sequence identifies `Hom(Λ[-j], K)` with the inverse limit of the finite groups
`Hom(Λ[-j], Kₙ)`, which vanish outside the common Tor amplitude interval of the `Kₙ`; and
`Hom(Λ[-j], K)` is `ϖ`-adically separated with `Hom(Λ[-j], K)/ϖ` embedded in `Hom(Λ[-j], K₁)`,
hence finitely generated. -/
theorem boundedConstructible_of_boundedConstructibleIntegral [IsPrecomplete I Λ]
    {K : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hK : DerivedCategory.boundedConstructibleIntegral I (Spec (.of k)) K) :
    DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) (Spec (.of k)) K := by
  obtain ⟨hc, a, b, hab⟩ := hK
  have hF := finite_hom_unitSingle_derivedCompletionDiagram hϖ hI hab
  have hM (j : ℤ) := bijective_milnorMap_unitSingle hc j fun n ↦ (hF n (j - 1)).1
  have hzero (j : ℤ) (hj : j < a ∨ b < j) :
      IsZero ((_root_.DerivedCategory.homologyFunctor _ j).obj K) := by
    refine isZero_of_subsingleton_pointSections _
      ((homSingleLinearEquiv K j).toEquiv.subsingleton_congr.1 ⟨fun f g ↦ (hM j).1 ?_⟩)
    refine Subtype.ext (funext fun n ↦ ?_)
    have := (hF n j).2 hj
    exact Subsingleton.elim _ _
  refine ⟨⟨⟨a, (_root_.DerivedCategory.isGE_iff K a).2 fun j hj ↦ hzero j (Or.inl hj)⟩,
    ⟨b, (_root_.DerivedCategory.isLE_iff K b).2 fun j hj ↦ hzero j (Or.inr hj)⟩⟩, fun j ↦ ?_⟩
  rw [isConstructibleSheaf_iff_moduleFinite_pointSections]
  suffices Module.Finite Λ (unitSingle Λ k j ⟶ K) from
    Module.Finite.equiv (homSingleLinearEquiv K j)
  have := isHausdorff_hom_unitSingle hI (hM j).1
  have := (hF 1 j).1
  exact Module.finite_of_isHausdorff_of_ker_le hI
    (Preadditive.rightComp _ ((_root_.DerivedCategory.derivedCompletionCone
      (Spec (.of k)).smallEtaleTopology I K).π.app (op 1)))
    fun y hy ↦ exists_eq_smul_of_comp_derivedCompletionCone_eq_zero hϖ hI y hy

/-! ### Bounded constructible complexes lie in the integral stage -/

omit [IsNoetherianRing Λ] in
/-- A constant sheaf on a finitely generated module is constructible on `Spec k`. -/
lemma isConstructibleSheaf_constantSheaf_of_isSepClosed (M : ModuleCat.{u + 1} Λ)
    [Module.Finite Λ M] :
    IsConstructibleSheaf
      ((constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj M) := by
  rw [isConstructibleSheaf_iff_moduleFinite_pointSections]
  have : Module.Finite Λ ((𝟭 (ModuleCat.{u + 1} Λ)).obj M) := inferInstanceAs (Module.Finite Λ M)
  exact Module.Finite.equiv
    ((constantSheafEquivalenceOfIsSepClosed Λ (k := k)).unitIso.app M).toLinearEquiv

variable [IsAdicComplete I Λ]

omit [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] in
include hϖ hI in
/-- The constant sheaf `Λ` on `Spec k`, placed in degree `0`, is derived complete: it is the
homotopy limit of the constant sheaves `Λ/Iⁿ`, as `Λ` is for `Λ`-modules
(`DerivedCategory.isHomotopyLimit_mapCone_Q_of_epi`), and those are killed by `ϖⁿ`. -/
lemma derivedComplete_unitSingle :
    _root_.DerivedCategory.derivedComplete (Spec (.of k)).smallEtaleTopology I
      (unitSingle Λ k 0) := by
  have hϖI : ϖ ∈ I := hI ▸ Ideal.mem_span_singleton_self ϖ
  rw [_root_.DerivedCategory.derivedComplete_iff_rightOrthogonal hϖ hI]
  intro Y f hY
  -- the homotopy limit `Λ = R lim Λ/Iⁿ` for modules
  let T : ℕᵒᵖ ⥤ CochainComplex (ModuleCat.{u + 1} Λ) ℤ :=
    Ideal.quotPowFunctor I ⋙ HomologicalComplex.single _ (ComplexShape.up ℤ) 0
  let c := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).mapCone (Ideal.quotPowCone I)
  have hc : IsLimit c := isLimitOfPreserves _ (Ideal.isLimitQuotPowCone I)
  have hT (n : ℕ) (i : ℤ) : Epi ((T.map (homOfLE n.le_succ).op).f i) := by
    by_cases hi : i = 0
    · subst hi
      change Epi (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        ((Ideal.quotPowFunctor I).map (homOfLE n.le_succ).op)).f 0)
      rw [HomologicalComplex.single_map_f_self]
      have : Epi ((Ideal.quotPowFunctor I).map (homOfLE n.le_succ).op) := by
        rw [ModuleCat.epi_iff_surjective]
        exact Submodule.factor_surjective (Ideal.pow_le_pow_right n.le_succ)
      infer_instance
    · exact (HomologicalComplex.isZero_single_obj_X _ _ _ _ hi).epi _
  have hQ := DerivedCategory.isHomotopyLimit_mapCone_Q_of_epi hT hc
  -- transported to sheaves on `Spec k`
  have : (constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).IsEquivalence :=
    (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).isEquivalence_functor
  have : (constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).Additive :=
    additive_constantSheaf Λ _
  let G :=
    (constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).mapDerivedCategory
  have hG := hQ.map G
  let eG (M : ModuleCat.{u + 1} Λ) : G.obj (DerivedCategory.Q.obj
      ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj M)) ≅
      (_root_.DerivedCategory.singleFunctor _ 0).obj
        ((constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj M) :=
    G.mapIso ((DerivedCategory.singleFunctorIsoCompQ _ 0).app M).symm ≪≫
      ((constantSheaf _ _).mapDerivedCategorySingleFunctor 0).app M
  have hkill (Z : _root_.DerivedCategory
      (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)))
      (hZ : _root_.DerivedCategory.smulInvertible _ ϖ Z) (n : ℕ)
      (g : Z ⟶ (T ⋙ DerivedCategory.Q ⋙ G).obj (op n)) : g = 0 := by
    rw [← cancel_mono (eG _).hom, Limits.zero_comp]
    exact hZ.hom_eq_zero
      (_root_.DerivedCategory.smul_id_quotPowFunctor_obj _ hϖI n) _
  have h0 := hG.hom_ext_zero (hkill Y hY) (hkill _ (ObjectProperty.le_shift _ 1 Y hY))
    (f ≫ (eG _).inv)
  rwa [← cancel_mono (eG _).inv, Limits.zero_comp]

omit [IsSepClosed k] [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] [IsAdicComplete I Λ] in
include hϖ hI in
/-- The reductions `Λ ⊗ᴸ Λ/Iⁿ` of the constant sheaf `Λ` are the constant sheaves `Λ/Iⁿ`. -/
lemma nonempty_iso_reductionModIdeal_unitSingle (n : ℕ) :
    Nonempty ((reductionModIdeal Λ (Spec (.of k)) (I ^ n)).obj (unitSingle Λ k 0) ≅
      (DerivedCategory.singleFunctor _ 0).obj
        ((constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
          (ModuleCat.of Λ (Λ ⧸ I ^ n)))) := by
  obtain ⟨g, h, hT⟩ := exists_distTriang_reductionModIdeal hϖ hI (unitSingle Λ k 0) n
  have hT' :=
    _root_.DerivedCategory.quotPowTriangle_distinguished (Spec (.of k)).smallEtaleTopology hϖ hI n
  obtain ⟨e, -⟩ := Pretriangulated.exists_iso_of_arrow_iso _ _ hT hT'
    (Arrow.isoMk (Iso.refl _) (Iso.refl _) (by
      rw [_root_.DerivedCategory.quotPowTriangle_mor₁]
      simp only [Iso.refl_hom, Category.comp_id, Category.id_comp, Arrow.mk_hom]
      rfl))
  exact ⟨Triangle.π₃.mapIso e⟩

omit [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] [IsAdicComplete I Λ] in
include hϖ hI in
/-- The constant sheaf `Λ/Iⁿ` on `Spec k`, placed in degree `0`, is bounded constructible of
Tor amplitude in `[-1, 0]`: it is the cone of `ϖⁿ : Λ ⟶ Λ`, and `Λ` is flat. -/
lemma boundedConstructible_torAmplitudeIn_single_quot (n : ℕ) :
    DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) (Spec (.of k))
        ((DerivedCategory.singleFunctor _ 0).obj
          ((constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
            (ModuleCat.of Λ (Λ ⧸ I ^ n)))) ∧
      DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) (Spec (.of k)) (-1) 0
        ((DerivedCategory.singleFunctor _ 0).obj
          ((constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
            (ModuleCat.of Λ (Λ ⧸ I ^ n)))) := by
  have := isConstructibleSheaf_constantSheaf_of_isSepClosed (k := k)
    (ModuleCat.of Λ (Λ ⧸ I ^ n))
  refine ⟨DerivedCategory.boundedConstructible_singleFunctor_obj _ 0, ?_⟩
  have hT :=
    _root_.DerivedCategory.quotPowTriangle_distinguished (Spec (.of k)).smallEtaleTopology hϖ hI n
  have hU : DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) (Spec (.of k)) 0 0
      ((DerivedCategory.singleFunctor _ 0).obj
        (MonoidalCategory.tensorUnit
          (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)))) :=
    _root_.DerivedCategory.torAmplitudeIn_singleFunctor_obj_of_flat
      (ObjectProperty.flat_of_isDualizable isDualizable_unit)
  have h := DerivedCategory.torAmplitudeIn_obj₂ (ModuleCat.{u + 1} Λ) (rot_of_distTriang _ hT)
    hU (DerivedCategory.torAmplitudeIn.shift hU 1)
  exact h.mono (by simp) (by simp)

omit [IsNoetherianRing Λ] [Finite (Λ ⧸ I)] in
include hϖ hI in
/-- The constant sheaf `Λ` on `Spec k`, placed in degree `0`, lies in the integral stage. -/
lemma boundedConstructibleIntegral_unitSingle :
    DerivedCategory.boundedConstructibleIntegral I (Spec (.of k)) (unitSingle Λ k 0) := by
  refine ⟨derivedComplete_unitSingle hϖ hI, -1, 0, fun n ↦ ?_⟩
  obtain ⟨e⟩ := nonempty_iso_reductionModIdeal_unitSingle (k := k) hϖ hI (n + 1)
  obtain ⟨h₁, h₂⟩ := boundedConstructible_torAmplitudeIn_single_quot (k := k) hϖ hI (n + 1)
  exact ⟨(DerivedCategory.boundedConstructible _ _).prop_of_iso e.symm h₁,
    (DerivedCategory.torAmplitudeIn _ _ _ _).prop_of_iso e.symm h₂⟩

omit [IsAdicComplete I Λ] in
include hϖ hI in
/-- The constant sheaves `M` on `Spec k` placed in degree `0` which lie in the integral stage
satisfy the two-out-of-three property along short exact sequences of `Λ`-modules. -/
lemma boundedConstructibleIntegral_single_of_shortExact {S : ShortComplex (ModuleCat.{u + 1} Λ)}
    (hS : S.ShortExact) :
    let P : ModuleCat.{u + 1} Λ → Prop := fun M ↦
      DerivedCategory.boundedConstructibleIntegral I (Spec (.of k))
        ((DerivedCategory.singleFunctor _ 0).obj
          ((constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj M))
    (P S.X₁ → P S.X₂ → P S.X₃) ∧ (P S.X₁ → P S.X₃ → P S.X₂) := by
  intro P
  have : Fact (∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ}) := ⟨⟨ϖ, hϖ, hI⟩⟩
  have := DerivedCategory.isClosedUnderIsomorphisms_boundedConstructibleIntegral
    (X := Spec (.of k)) hϖ hI
  have hS' := hS.map_of_exact (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).functor
  have hT := hS'.singleTriangle_distinguished
  refine ⟨fun h₁ h₂ ↦ ?_, fun h₁ h₃ ↦ ?_⟩
  · exact
      (DerivedCategory.boundedConstructibleIntegral I (Spec (.of k))).ext_of_isTriangulatedClosed₂
      _ (rot_of_distTriang _ hT) h₂
      ((DerivedCategory.boundedConstructibleIntegral I (Spec (.of k))).le_shift 1 _ h₁)
  · exact
      (DerivedCategory.boundedConstructibleIntegral I (Spec (.of k))).ext_of_isTriangulatedClosed₂
      _ hT h₁ h₃

