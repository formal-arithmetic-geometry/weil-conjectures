/-!
# Integral constructible complexes over a geometric point

Let `k` be a separably closed field and `Λ` a complete discrete valuation ring with finite
residue field, for instance the ring of integers `𝒪_E` of a finite extension `E` of `ℚ_ℓ`, with
maximal ideal `I = (ϖ)`. The integral stage `Dᵇc(Spec k, Λ)` of the `ℓ`-adic formalism
(`AlgebraicGeometry.Etale.DerivedCategory.boundedConstructibleIntegral`) consists of the objects
of `D((Spec k)_ét, Λ)` which are derived complete and whose reductions `K ⊗ᴸ Λ/Iⁿ⁺¹` are
bounded constructible of Tor amplitude in one common interval. This file shows that these are
exactly the bounded constructible objects, so that the global sections induce an equivalence

`Fib_s : Dᵇc(Spec k, Λ) ≌ Dᵇ_fg(Λ)`

with the bounded complexes of `Λ`-modules with finitely generated cohomology modules, all of which
are derived complete.

## Main statements

- `AlgebraicGeometry.Etale.boundedConstructibleIntegral_iff_boundedConstructible`: on `Spec k`,
  the integral stage consists of the bounded constructible complexes.
- `AlgebraicGeometry.Etale.pointFiberIntegralEquivalence` (`def-weil-finite-coefficient-point`,
  integral stage): `Fib_s : Dᵇc(Spec k, Λ) ≌ Dᵇ_fg(Λ)`.
- `DerivedCategory.boundedFiniteCohomology_rightOrthogonal`: the objects of `Dᵇ_fg(Λ)` are
  derived complete, i.e. receive no nonzero map from an object on which `ϖ` acts invertibly.

## Proof

If `K` is bounded constructible, the dévissage of bounded complexes reduces the claim to a
constructible sheaf, the constant sheaf on a finitely generated `Λ`-module, which is a cokernel of
a map of finite free modules; so it reduces to `Λ` placed in degree `0`. Its reductions are the
constant sheaves `Λ/Iⁿ⁺¹`, of Tor amplitude in `[-1, 0]` by the triangles `Λ ⟶ Λ ⟶ Λ/Iⁿ⁺¹`; and
`Λ` is derived complete, being the homotopy limit of the tower `Λ/Iⁿ`, as it is for modules
(`DerivedCategory.isHomotopyLimit_mapCone_Q_of_epi`).

Conversely, let `K` be derived complete with reductions `Kₙ` of Tor amplitude in `[a, b]` with
constructible cohomology. Morphisms out of `Λ` placed in degree `j` compute the global sections of
the cohomology sheaves (`AlgebraicGeometry.Etale.homSingleEquiv`), which for the `Kₙ` are finite
and vanish outside `[a, b]`. The Milnor sequence of the homotopy limit `K = R lim Kₙ` then shows
that `M = Hom(Λ[-j], K)` is the inverse limit of the finite groups `Hom(Λ[-j], Kₙ)`: it vanishes
outside `[a, b]`, it is `ϖ`-adically separated, and `M/ϖM` embeds into `Hom(Λ[-j], K₁)`, so `M`
is finitely generated (`Module.finite_of_isHausdorff_of_ker_le`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite Pretriangulated

/-! ### A finiteness criterion for separated modules -/

section Algebra

variable {Λ M : Type*} [CommRing Λ] [AddCommGroup M] [Module Λ M]

/-- Let `I = (ϖ)` be a principal ideal of a ring `Λ` which is `I`-adically precomplete. A
module `M` which is `I`-adically separated and which is generated by finitely many elements
modulo `I` is generated by them. -/
lemma Module.span_eq_top_of_isHausdorff {I : Ideal Λ} {ϖ : Λ} (hI : I = Ideal.span {ϖ})
    [IsPrecomplete I Λ] [IsHausdorff I M] {r : ℕ} (x : Fin r → M)
    (hx : ∀ y : M, ∃ (c : Fin r → Λ) (z : M), y = ∑ i, c i • x i + ϖ • z) :
    Submodule.span Λ (Set.range x) = ⊤ := by
  have hϖ : ϖ ∈ I := hI ▸ Ideal.mem_span_singleton_self ϖ
  choose c z hcz using hx
  refine eq_top_iff.2 fun y _ ↦ ?_
  -- the successive remainders `yₘ`, with `y = ∑ Sₘ i • x i + ϖᵐ • yₘ`
  let ys : ℕ → M := fun m ↦ Nat.rec (motive := fun _ ↦ M) y (fun _ w ↦ z w) m
  let S : ℕ → Fin r → Λ := fun m i ↦ ∑ k ∈ Finset.range m, ϖ ^ k * c (ys k) i
  have hS (m : ℕ) : y = ∑ i, S m i • x i + ϖ ^ m • ys m := by
    induction m with
    | zero => simp [S, ys]
    | succ m ih =>
      have h : ys m = ∑ i, c (ys m) i • x i + ϖ • ys (m + 1) := hcz (ys m)
      calc y = ∑ i, S m i • x i + ϖ ^ m • ys m := ih
        _ = ∑ i, S m i • x i + ϖ ^ m • (∑ i, c (ys m) i • x i + ϖ • ys (m + 1)) := by
          rw [← h]
        _ = ∑ i, S (m + 1) i • x i + ϖ ^ (m + 1) • ys (m + 1) := by
          simp only [S, Finset.sum_range_succ, add_smul, Finset.sum_add_distrib, smul_add,
            Finset.smul_sum, smul_smul, pow_succ, add_assoc]
  have hmem {m : ℕ} {a : Λ} (ha : a ∈ I ^ m) (w : M) : a • w ∈ I ^ m • (⊤ : Submodule Λ M) :=
    Submodule.smul_mem_smul ha Submodule.mem_top
  have hpow (m : ℕ) : ϖ ^ m ∈ I ^ m := Ideal.pow_mem_pow hϖ m
  have hcauchy (i : Fin r) {m n : ℕ} (hmn : m ≤ n) :
      S m i ≡ S n i [SMOD I ^ m • (⊤ : Submodule Λ Λ)] := by
    rw [SModEq.sub_mem, ← neg_mem_iff, neg_sub]
    have : S n i - S m i = ∑ k ∈ Finset.Ico m n, ϖ ^ k * c (ys k) i := by
      simp only [S]
      rw [← Finset.sum_range_add_sum_Ico _ hmn, add_sub_cancel_left]
    rw [this]
    refine Submodule.sum_mem _ fun k hk ↦ ?_
    have hk : m ≤ k := (Finset.mem_Ico.1 hk).1
    rw [← smul_eq_mul]
    exact Submodule.smul_mem_smul (Ideal.pow_le_pow_right hk (hpow k)) Submodule.mem_top
  choose L hL using fun i ↦ IsPrecomplete.prec inferInstance (hcauchy i)
  have hy : y - ∑ i, L i • x i = 0 := by
    refine IsHausdorff.haus (I := I) inferInstance _ fun m ↦ ?_
    rw [SModEq.sub_mem, sub_zero]
    have hm : y - ∑ i, L i • x i = ∑ i, (S m i - L i) • x i + ϖ ^ m • ys m := by
      conv_lhs => rw [hS m]
      simp only [sub_smul, Finset.sum_sub_distrib]
      abel
    rw [hm]
    refine Submodule.add_mem _ (Submodule.sum_mem _ fun i _ ↦ hmem ?_ _) (hmem (hpow m) _)
    have := SModEq.sub_mem.1 (hL i m)
    rwa [smul_eq_mul, Ideal.mul_top] at this
  rw [sub_eq_zero] at hy
  rw [hy]
  exact Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- Let `I = (ϖ)` be a principal ideal of a ring `Λ` which is `I`-adically precomplete, and let
`M` be an `I`-adically separated `Λ`-module. If an additive map `f : M → T` to a finite group has
its kernel in `IM`, then `M` is finitely generated. -/
lemma Module.finite_of_isHausdorff_of_ker_le {I : Ideal Λ} {ϖ : Λ} (hI : I = Ideal.span {ϖ})
    [IsPrecomplete I Λ] [IsHausdorff I M] {T : Type*} [AddCommGroup T] [Finite T] (f : M →+ T)
    (hf : ∀ y, f y = 0 → ∃ z, y = ϖ • z) : Module.Finite Λ M := by
  classical
  -- choose representatives of the finitely many values of `f`
  obtain ⟨r, ⟨e⟩⟩ := Finite.exists_equiv_fin (Set.range f)
  let x : Fin r → M := fun i ↦ (e.symm i).2.choose
  have hx (i : Fin r) : f (x i) = e.symm i := (e.symm i).2.choose_spec
  refine ⟨⟨Finset.univ.image x, ?_⟩⟩
  rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  refine Module.span_eq_top_of_isHausdorff hI x fun y ↦ ?_
  let i := e ⟨f y, y, rfl⟩
  obtain ⟨z, hz⟩ := hf (y - x i) (by rw [map_sub, hx, Equiv.symm_apply_apply, sub_self])
  refine ⟨Pi.single i 1, z, ?_⟩
  rw [← hz]
  simp [Pi.single_apply]

end Algebra

namespace AlgebraicGeometry

open Scheme

namespace Etale

/-! ### Morphisms out of the constant sheaf `Λ` on a geometric point -/

section Point

variable {Λ : Type (u + 1)} [CommRing Λ] {k : Type u} [Field k] [IsSepClosed k]

instance : (pointSections Λ k).Linear Λ where
  map_smul _ _ := rfl

variable (Λ k) in
/-- The constant sheaf `Λ` on `Spec k`. -/
noncomputable abbrev unitSheaf : Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ) :=
  (constantSheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj (ModuleCat.of Λ Λ)

/-- Over a separably closed field `k`, the morphisms `Λ ⟶ F` of étale sheaves on `Spec k` are the
global sections of `F`. -/
noncomputable def unitSheafHomLinearEquiv
    (F : Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)) :
    (unitSheaf Λ k ⟶ F) ≃ₗ[Λ] (pointSections Λ k).obj F :=
  letI : (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).inverse.Linear Λ :=
    inferInstanceAs ((pointSections Λ k).Linear Λ)
  letI : (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).inverse.Additive :=
    inferInstanceAs ((pointSections Λ k).Additive)
  ({ toEquiv := (constantSheafEquivalenceOfIsSepClosed Λ (k := k)).toAdjunction.homEquiv
       (ModuleCat.of Λ Λ) F
     map_add' f g := by
       simp only [Equiv.toFun_as_coe, Adjunction.homEquiv_unit,
         Functor.map_add, Preadditive.comp_add]
     map_smul' c f := by
       simp only [Equiv.toFun_as_coe, Adjunction.homEquiv_unit, Functor.map_smul,
         Linear.comp_smul, RingHom.id_apply]
       } : _ ≃ₗ[Λ] _) ≪≫ₗ
    ModuleCat.homSelfLinearEquiv Λ _

/-- Over a separably closed field `k`, the morphisms `Λ[-j] ⟶ Y` in `D((Spec k)_ét, Λ)` are the
global sections of the `j`-th cohomology sheaf of `Y`: the constant sheaf `Λ` is projective. -/
noncomputable def homSingleLinearEquiv
    (Y : DerivedCategory (Sheaf (Spec (.of k)).smallEtaleTopology (ModuleCat.{u + 1} Λ)))
    (j : ℤ) :
    ((DerivedCategory.singleFunctor _ j).obj (unitSheaf Λ k) ⟶ Y) ≃ₗ[Λ]
      (pointSections Λ k).obj ((DerivedCategory.homologyFunctor _ j).obj Y) :=
  ({ toEquiv := DerivedCategory.homSingleEquivOfProjective (unitSheaf Λ k) j Y
     map_add' f g := by simp [DerivedCategory.homSingleToHomology]
     map_smul' c f := by simp [DerivedCategory.homSingleToHomology] } : _ ≃ₗ[Λ] _) ≪≫ₗ
    unitSheafHomLinearEquiv _

end Point

/-! ### The reduction triangles -/

section Reduction

/-- The small étale site of a scheme is essentially small. Instance search does not find this
in the presence of the imports of this file. -/
local instance (X : Scheme.{u}) : EssentiallySmall.{u + 1} X.Etale :=
  have : LocallySmall.{u + 1} X.Etale :=
    @locallySmall_of_univLE X.Etale _ (@univLE_of_max.{u, u + 1} UnivLE.self)
  essentiallySmall_of_small_of_locallySmall _

variable {Λ : Type (u + 1)} [CommRing Λ] {I : Ideal Λ} {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ)
  (hI : I = Ideal.span {ϖ}) {X : Scheme.{u}}

include hϖ hI in
/-- The reduction `K ⊗ᴸ (Λ/Iⁿ)_X` is the cone of the multiplication by `ϖⁿ` on `K`: the
triangle `Λ ⟶ Λ ⟶ Λ/Iⁿ ⟶ Λ⟦1⟧` tensored with `K`. -/
lemma exists_distTriang_reductionModIdeal
    (K : DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) (n : ℕ) :
    ∃ (g : K ⟶ (reductionModIdeal Λ X (I ^ n)).obj K)
      (h : (reductionModIdeal Λ X (I ^ n)).obj K ⟶ K⟦(1 : ℤ)⟧),
      Triangle.mk (ϖ ^ n • 𝟙 K) g h ∈ distTriang _ := by
  let F := (derivedTensor (ModuleCat.{u + 1} Λ) X).obj K
  let T := DerivedCategory.quotPowTriangle X.smallEtaleTopology hϖ hI n
  have hT : F.mapTriangle.obj T ∈ distTriang _ :=
    F.map_distinguished _ (DerivedCategory.quotPowTriangle_distinguished _ hϖ hI n)
  let u : F.obj T.obj₁ ≅ K := derivedTensorSingleUnitIso K
  have hmor : F.map T.mor₁ = ϖ ^ n • 𝟙 (F.obj T.obj₁) := by
    rw [DerivedCategory.quotPowTriangle_mor₁, Functor.map_smul, CategoryTheory.Functor.map_id]
  refine ⟨u.inv ≫ F.map T.mor₂,
    F.map T.mor₃ ≫ (F.commShiftIso (1 : ℤ)).hom.app _ ≫ u.hom⟦(1 : ℤ)⟧',
    isomorphic_distinguished _ hT _ (Triangle.isoMk _ _ u.symm u.symm (Iso.refl _) ?_ ?_ ?_)⟩
  · change (ϖ ^ n • 𝟙 K) ≫ u.inv = u.inv ≫ F.map T.mor₁
    rw [hmor, Linear.smul_comp, Linear.comp_smul, Category.id_comp, Category.comp_id]
  · change (u.inv ≫ F.map T.mor₂) ≫ 𝟙 _ = u.inv ≫ F.map T.mor₂
    rw [Category.comp_id]
  · change (F.map T.mor₃ ≫ (F.commShiftIso (1 : ℤ)).hom.app _ ≫ u.hom⟦(1 : ℤ)⟧') ≫
      u.inv⟦(1 : ℤ)⟧' = 𝟙 _ ≫ F.map T.mor₃ ≫ (F.commShiftIso (1 : ℤ)).hom.app _
    rw [Category.assoc, Category.assoc, ← Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
    simp

include hϖ hI in
/-- The terms `K ⊗ᴸ Λ/Iⁿ` of the tower of reductions of `DerivedCategory.derivedCompletionDiagram`
are the reductions `AlgebraicGeometry.Etale.reductionModIdeal`: both are cones of the
multiplication by `ϖⁿ` on `K`. -/
lemma nonempty_iso_derivedCompletionDiagram_obj
    (K : DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) (n : ℕ) :
    Nonempty ((DerivedCategory.derivedCompletionDiagram X.smallEtaleTopology I K).obj (op n) ≅
      (reductionModIdeal Λ X (I ^ n)).obj K) := by
  obtain ⟨h, hT⟩ := DerivedCategory.exists_distTriang_derivedCompletionCone hϖ hI K n
  obtain ⟨g', h', hT'⟩ := exists_distTriang_reductionModIdeal hϖ hI K n
  obtain ⟨e, -⟩ := Pretriangulated.exists_iso_of_arrow_iso _ _ hT hT' (Iso.refl _)
  exact ⟨Triangle.π₃.mapIso e⟩

end Reduction

end Etale

end AlgebraicGeometry
