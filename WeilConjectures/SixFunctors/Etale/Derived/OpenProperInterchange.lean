module

public import Mathlib.AlgebraicGeometry.Morphisms.IsIso
public import WeilConjectures.Compactification.Defs
public import WeilConjectures.SixFunctors.Etale.Derived.OpenImmersionLowerShriekLowerStarExchange

/-!
# Interchanging a proper direct image and an extension by zero

Let `p : X ⟶ Y` be proper, `i : Y ⟶ W` an open immersion and `X ⟶[j] Z ⟶[r] W` a
compactification of `p ≫ i` with `X` dense in `Z`. This file proves the three statements of
blueprint `proposition-composition-base-change-rf-shriek--1`, the interchange step in the proof of
the composition law `R(f ≫ g)_! ≅ Rf_! ⋙ Rg_!`
(`AlgebraicGeometry.Etale.nonempty_iso_rightDerivedLowerShriek_comp`), on the unbounded derived
categories of étale sheaves:

1. `r⁻¹(Y) = X` and `r` restricts to `p` over `Y`, i.e. the square `p ≫ i = j ≫ r` is cartesian
   (`AlgebraicGeometry.Compactification.isPullback_of_denseRange`);
2. there is a unique map `ι_K : i_! Rp_* K ⟶ Rr_* j_! K` whose restriction to `Y` is the
   identity of `Rp_* K`, namely the exchange map
   `AlgebraicGeometry.Etale.openImmersionLowerShriekLowerStarExchange` of this square
   (`AlgebraicGeometry.Etale.homEquiv_eq_lowerStarOpenImmersionLowerShriekRestrictionIso_inv_iff`);
   the identification of the restriction `i^* Rr_* j_! K` with `Rp_* K` is
   `AlgebraicGeometry.Etale.lowerStarOpenImmersionLowerShriekRestrictionIso`, built from the
   isomorphism `Rp_* j^* ≅ i^* Rr_*` (restriction to an open commutes with direct images),
   which is the conjugate of the base change isomorphism `p^* j_! ≅ i_! r^*` of the
   extension by zero;
3. for torsion coefficients `ι_K` is an isomorphism for all `K`
   (`AlgebraicGeometry.Etale.isIso_openImmersionLowerShriekLowerStarExchange_of_isAddTorsion_ring`).

The blueprint states (3) on the localizing subcategory generated by `Dᵇctf`; for the étale
sites with finite coefficients the interchange map is an isomorphism on the whole unbounded
derived category.
-/

@[expose] public section

universe u' u

open CategoryTheory Limits

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

section Geometry

variable {X Y W : Scheme.{u}} {p : X ⟶ Y} [IsProper p] {i : Y ⟶ W} [IsOpenImmersion i]

/-- Part (1) of blueprint `proposition-composition-base-change-rf-shriek--1`: let `p : X ⟶ Y` be
proper, `i : Y ⟶ W` an open immersion and `e = (X ⟶[e.i] e.Z ⟶[e.g] W)` a compactification of
`p ≫ i` in which `X` is dense. Then `e.g⁻¹(Y) = X` and `e.g` restricts to `p` over `Y`: the square
```
  X --e.i--> e.Z
  |           |
  p          e.g
  ↓           ↓
  Y ---i----> W
```
is cartesian. The induced open immersion `X ⟶ e.Z ×_W Y` is proper over `Y`, hence has closed
range; being dense, it is surjective, hence an isomorphism. -/
theorem Compactification.isPullback_of_denseRange (e : Compactification (p ≫ i))
    (he : DenseRange e.i.base) : IsPullback p e.i i e.g := by
  let ℓ : X ⟶ pullback i e.g := pullback.lift p e.i e.comm
  have hℓ₁ : ℓ ≫ pullback.fst i e.g = p := pullback.lift_fst _ _ _
  have hℓ₂ : ℓ ≫ pullback.snd i e.g = e.i := pullback.lift_snd _ _ _
  have : IsOpenImmersion (ℓ ≫ pullback.snd i e.g) := by rw [hℓ₂]; infer_instance
  have : IsOpenImmersion ℓ := .of_comp ℓ (pullback.snd i e.g)
  have : IsSeparated (pullback.fst i e.g) := MorphismProperty.pullback_fst _ _ inferInstance
  have : IsProper (ℓ ≫ pullback.fst i e.g) := by rw [hℓ₁]; infer_instance
  have : IsProper ℓ := .of_comp ℓ (pullback.fst i e.g)
  have hclosed : IsClosed (Set.range ℓ.base) := (Scheme.Hom.isClopen_range ℓ).isClosed
  have hdense : Dense (Set.range ℓ.base) := by
    have h := he.preimage (pullback.snd i e.g).isOpenEmbedding.isOpenMap
    convert h using 1
    rw [← hℓ₂, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      Set.preimage_image_eq _ (pullback.snd i e.g).isOpenEmbedding.injective]
  have : Surjective ℓ := ⟨by
    rw [← Set.range_eq_univ, ← hclosed.closure_eq]; exact hdense.closure_eq⟩
  have : IsIso ℓ := (isIso_iff_isOpenImmersion_and_surjective ℓ).2 ⟨inferInstance, inferInstance⟩
  exact IsPullback.of_iso_pullback ⟨e.comm⟩ (asIso ℓ) hℓ₁ hℓ₂

end Geometry

namespace Etale

variable (A : Type u') [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
  [HasSmallSiteSheafify A] [MonoidalCategory A] [MonoidalPreadditive A] [SymmetricCategory A]
  [MonoidalClosed A] [Abelian.HasFunctorialFlatResolution A]

variable {X Y Z W : Scheme.{u}} {p : X ⟶ Y} {j : X ⟶ Z} {i : Y ⟶ W} {r : Z ⟶ W}
  [IsOpenImmersion i] [IsOpenImmersion j]

/-- **Restriction to an open commutes with direct images**: for a cartesian square
`p ≫ i = j ≫ r` with `i` and `j` open immersions, the isomorphism `Rp_* j^* ≅ i^* Rr_*` of
functors `D(Z_ét) ⥤ D(Y_ét)`. It is the conjugate, along the composite adjunctions
`Dp^* ⋙ Dj_! ⊣ Dj^* ⋙ Rp_*` and `Di_! ⋙ Dr^* ⊣ Rr_* ⋙ Di^*`, of the base change isomorphism
`Dp^* ⋙ Dj_! ≅ Di_! ⋙ Dr^*` of the extension by zero. -/
noncomputable def lowerStarUpperStarOpenImmersionIso (hsq : IsPullback p j i r) :
    D((j)^*[A]) ⋙ R((p)_*[A]) ≅ R((r)_*[A]) ⋙ D((i)^*[A]) :=
  conjugateIsoEquiv ((mapDerivedUpperStarLowerStarAdjunction A p).comp
      (derivedOpenImmersionLowerShriekUpperStarAdjunction A j))
    ((derivedOpenImmersionLowerShriekUpperStarAdjunction A i).comp
      (mapDerivedUpperStarLowerStarAdjunction A r))
    (mapDerivedCategoryOpenImmersionLowerShriekBaseChangeIso A hsq).symm

/-- The isomorphism `Rp_* j^* ≅ i^* Rr_*` is the mate of the exchange map
`Rp_* ⋙ Di_! ⟶ Dj_! ⋙ Rr_*` along the adjunctions `Dj_! ⊣ Dj^*` and `Di_! ⊣ Di^*`: both are
iterated mates of the base change isomorphism of the extension by zero. -/
lemma lowerStarUpperStarOpenImmersionIso_hom (hsq : IsPullback p j i r) :
    (lowerStarUpperStarOpenImmersionIso A hsq).hom =
      (mateEquiv (derivedOpenImmersionLowerShriekUpperStarAdjunction A j)
        (derivedOpenImmersionLowerShriekUpperStarAdjunction A i)
        (openImmersionLowerShriekLowerStarExchange A hsq)) := by
  rw [openImmersionLowerShriekLowerStarExchange, iterated_mateEquiv_conjugateEquiv]
  rfl

/-- **The restriction of `Rr_* j_! K` to the open `Y`**: for a cartesian square
`p ≫ i = j ≫ r` with `i` and `j` open immersions, the identification
`i^* Rr_* j_! K ≅ Rp_* j^* j_! K ≅ Rp_* K`, by
`AlgebraicGeometry.Etale.lowerStarUpperStarOpenImmersionIso` and the unit `K ≅ j^* j_! K`. -/
noncomputable def lowerStarOpenImmersionLowerShriekRestrictionIso (hsq : IsPullback p j i r)
    (K : DerivedCategory (Sheaf X.smallEtaleTopology A)) :
    D((i)^*[A]).obj (R((r)_*[A]).obj (D((j)_!open[A]).obj K)) ≅ R((p)_*[A]).obj K :=
  ((lowerStarUpperStarOpenImmersionIso A hsq).app (D((j)_!open[A]).obj K)).symm ≪≫
    R((p)_*[A]).mapIso
      (asIso ((derivedOpenImmersionLowerShriekUpperStarAdjunction A j).unit.app K)).symm

/-- **The exchange map restricts to the identity over `Y`**: under the adjunction
`Di_! ⊣ Di^*`, the exchange map `i_! Rp_* K ⟶ Rr_* j_! K` corresponds to the inverse of the
identification `i^* Rr_* j_! K ≅ Rp_* K` of
`AlgebraicGeometry.Etale.lowerStarOpenImmersionLowerShriekRestrictionIso`. -/
lemma homEquiv_openImmersionLowerShriekLowerStarExchange_app (hsq : IsPullback p j i r)
    (K : DerivedCategory (Sheaf X.smallEtaleTopology A)) :
    (derivedOpenImmersionLowerShriekUpperStarAdjunction A i).homEquiv _ _
        ((openImmersionLowerShriekLowerStarExchange A hsq).app K) =
      (lowerStarOpenImmersionLowerShriekRestrictionIso A hsq K).inv := by
  rw [Adjunction.homEquiv_unit]
  simp only [lowerStarOpenImmersionLowerShriekRestrictionIso, Iso.trans_inv, Iso.symm_inv,
    Iso.app_hom, lowerStarUpperStarOpenImmersionIso_hom]
  exact (unit_mateEquiv (derivedOpenImmersionLowerShriekUpperStarAdjunction A j)
    (derivedOpenImmersionLowerShriekUpperStarAdjunction A i)
    (openImmersionLowerShriekLowerStarExchange A hsq) K).symm

/-- **Uniqueness of the interchange map**: a map `ι : i_! Rp_* K ⟶ Rr_* j_! K` restricts to the
identity of `Rp_* K` over `Y` (under the identification
`AlgebraicGeometry.Etale.lowerStarOpenImmersionLowerShriekRestrictionIso`) if and only if it is
the exchange map. Maps out of `i_! Rp_* K` are determined by their restriction to `Y`, by the
adjunction `Di_! ⊣ Di^*`. -/
lemma homEquiv_eq_lowerStarOpenImmersionLowerShriekRestrictionIso_inv_iff
    (hsq : IsPullback p j i r) (K : DerivedCategory (Sheaf X.smallEtaleTopology A))
    (ι : D((i)_!open[A]).obj (R((p)_*[A]).obj K) ⟶
      R((r)_*[A]).obj (D((j)_!open[A]).obj K)) :
    (derivedOpenImmersionLowerShriekUpperStarAdjunction A i).homEquiv _ _ ι =
        (lowerStarOpenImmersionLowerShriekRestrictionIso A hsq K).inv ↔
      ι = (openImmersionLowerShriekLowerStarExchange A hsq).app K := by
  rw [← homEquiv_openImmersionLowerShriekLowerStarExchange_app A hsq K]
  exact (Adjunction.homEquiv _ _ _).apply_eq_iff_eq

/-- Blueprint `proposition-composition-base-change-rf-shriek--1`: Interchanging proper direct image
and extension by zero.

Let `Λ` be a finite coefficient ring, `p : X ⟶ Y` proper, `i : Y ⟶ W` an open immersion and
`e = (X ⟶[e.i] e.Z ⟶[e.g] W)` a compactification of `p ≫ i` with `X` dense in `e.Z`. Then

1. `e.g⁻¹(Y) = X` and `e.g` restricts to `p` over `Y`: the square `p ≫ i = e.i ≫ e.g` is
   cartesian;
2. for `K ∈ D(X_ét, Λ)` there is a unique map `ι_K : i_! Rp_* K ⟶ R(e.g)_* (e.i)_! K` whose
   restriction to `Y` is the identity of `Rp_* K` (under the identification
   `AlgebraicGeometry.Etale.lowerStarOpenImmersionLowerShriekRestrictionIso`), namely the
   exchange map `AlgebraicGeometry.Etale.openImmersionLowerShriekLowerStarExchange`;
3. `ι_K` is an isomorphism for every `K` (on the whole unbounded derived category, which
   contains the localizing subcategory of the blueprint).

The map `ι` is a natural transformation, so it commutes with morphisms of `K`; it also commutes
with shifts, the derived functors involved being triangulated. -/
theorem existsUnique_openImmersionLowerShriekLowerStarExchange (Λ : Type (u + 1)) [CommRing Λ]
    [Finite Λ] {X Y W : Scheme.{u}} {p : X ⟶ Y} [IsProper p] {i : Y ⟶ W} [IsOpenImmersion i]
    (e : Compactification (p ≫ i)) (he : DenseRange e.i.base) :
    ∃ hsq : IsPullback p e.i i e.g,
      (∀ (K : DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)))
        (ι : D((i)_!open[ModuleCat.{u + 1} Λ]).obj (R((p)_*[ModuleCat.{u + 1} Λ]).obj K) ⟶
          R((e.g)_*[ModuleCat.{u + 1} Λ]).obj (D((e.i)_!open[ModuleCat.{u + 1} Λ]).obj K)),
        (derivedOpenImmersionLowerShriekUpperStarAdjunction _ i).homEquiv _ _ ι =
            (lowerStarOpenImmersionLowerShriekRestrictionIso _ hsq K).inv ↔
          ι = (openImmersionLowerShriekLowerStarExchange _ hsq).app K) ∧
        IsIso (openImmersionLowerShriekLowerStarExchange (ModuleCat.{u + 1} Λ) hsq) := by
  have hsq := e.isPullback_of_denseRange he
  exact ⟨hsq, homEquiv_eq_lowerStarOpenImmersionLowerShriekRestrictionIso_inv_iff _ hsq,
    isIso_openImmersionLowerShriekLowerStarExchange_of_isAddTorsion_ring Λ isAddTorsion_of_finite
      hsq⟩

end Etale

end AlgebraicGeometry
