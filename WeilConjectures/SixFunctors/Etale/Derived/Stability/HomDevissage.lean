public import WeilConjectures.SixFunctors.Etale.Derived.VerdierPreservation

/-!
# Internal Hom preserves `Dctf`, by dévissage

For a field `k`, a finite ring `Λ` whose exponent is invertible on `k` and a scheme `X` of
finite type over `k`, the derived internal hom `RHom(K, L)` of two objects of `Dctf(X_ét, Λ)`
lies in `Dctf(X_ét, Λ)` (`AlgebraicGeometry.Etale.constructibleFiniteTor_derivedHom_of_field`,
blueprint `proposition-six-operations-dctf--15`).

The proof is a dévissage in the first variable. The objects `K` with `RHom(K, L) ∈ Dctf` form
a thick subcategory (`definition-verdier-dual-evaluation--3`), and `Dctf(X, Λ)` is the thick
subcategory generated by the objects `Rg_* Rj_! P`, for `j : U ⟶ Ū` an open immersion, `g : Ū ⟶ X` a
closed immersion and `P` a lisse flat sheaf on `U`
(`AlgebraicGeometry.Etale.ctf_generated_by_rightDerivedLowerStar_rightDerivedLowerShriek`).
For such a generator, the tensor–Hom exchange for `g` and for `j`
(`AlgebraicGeometry.Etale.derivedHomRightDerivedLowerShriekIsoOfFinite`, the instances of
blueprint `lemma-internal-adjunction-two-exchange-formulas--1` used by the blueprint proof) gives
```
RHom(Rg_* Rj_! P, L) ≅ Rg_* RHom(Rj_! P, Rg^! L) ≅ Rg_* Rj_* RHom(P, Rj^! Rg^! L),
```
and `RHom(P, M) ≅ P^∨ ⊗ᴸ M` for the lisse flat, hence dualizable, sheaf `P`
(`proposition-six-operations-dctf--15`). Each of `Rg^!`, `Rj^!`, `P^∨ ⊗ᴸ -`, `Rj_*` and `Rg_*`
preserves `Dctf`.

## Implementation notes

The blueprint states the lemma over a separably closed field; the proof only uses the
stability of `Dctf` under `Rf_*` and `Rf^!`, which holds over any field
(`AlgebraicGeometry.Etale.constructibleFiniteTor_rightDerivedLowerStar`,
`AlgebraicGeometry.Etale.constructibleFiniteTor_rightDerivedUpperShriek`), so no hypothesis on
`k` is made. The blueprint proof runs the Noetherian induction itself, with a dense open on
which `K` is perfect; here that induction is the one inside the generation theorem.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Opposite ZeroObject Pretriangulated

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

open _root_.AlgebraicGeometry.Etale.DerivedCategory

variable (Λ : Type (u + 1)) [CommRing Λ] [Finite Λ]

/-- A lisse flat sheaf `P` placed in degree `0` has a left dual in `Dctf(X, Λ)`: the internal
dual `[P, Λ_X]` in degree `0`. -/
lemma exists_exactPairing_singleFunctor_of_isFiniteLocallyConstantSheaf {X : Scheme.{u}}
    (P : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) [IsFiniteLocallyConstantSheaf P]
    (hP : ObjectProperty.flat P) :
    ∃ D, constructibleFiniteTor (ModuleCat.{u + 1} Λ) X D ∧
      Nonempty (ExactPairing D ((_root_.DerivedCategory.singleFunctor _ 0).obj P)) := by
  let C := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj P
  have hCl (n : ℤ) : IsFiniteLocallyConstantSheaf (C.X n) := by
    by_cases hn : n = 0
    · subst hn
      exact IsFiniteLocallyConstantSheaf.of_iso (HomologicalComplex.singleObjXSelf _ 0 P).symm
    · exact IsFiniteLocallyConstantSheaf.of_isZero
        (HomologicalComplex.isZero_single_obj_X _ _ _ _ hn)
  have hCf (n : ℤ) : ObjectProperty.flat (C.X n) := by
    by_cases hn : n = 0
    · subst hn
      exact ObjectProperty.prop_of_iso _ (HomologicalComplex.singleObjXSelf _ 0 P).symm hP
    · exact ObjectProperty.flat_of_isZero (HomologicalComplex.isZero_single_obj_X _ _ _ _ hn)
  let _ (n : ℤ) : HasRightDual (C.X n) :=
    { rightDual := (ihom (C.X n)).obj (𝟙_ _)
      exact := letI := exactPairingIhomUnitOfIsFiniteLocallyConstantSheaf (C.X n) (hCf n)
        BraidedCategory.exactPairing_swap _ _ }
  obtain ⟨_⟩ := _root_.DerivedCategory.nonempty_exactPairing_Q_obj_rightDual C 0 0
  obtain ⟨ep⟩ := nonempty_exactPairing_swap (_root_.DerivedCategory.Q.obj C)
    (_root_.DerivedCategory.Q.obj (CochainComplex.rightDual C))
  refine ⟨_, constructibleFiniteTor_Q_obj_of_flat Λ (CochainComplex.rightDual C) (-0) (-0)
    (fun n ↦ ?_) (fun n ↦ ?_), ⟨@exactPairingCongrRight _ _ _ _ _ _ ep
      ((_root_.DerivedCategory.singleFunctorIsoCompQ _ 0).app P)⟩⟩
  · -- the dual of a lisse flat sheaf is flat, being dualizable
    exact IsDualizable.flat ⟨@HasRightDual.mk _ _ _ _ (C.X (-n))
      (exactPairingIhomUnitOfIsFiniteLocallyConstantSheaf (C.X (-n)) (hCf (-n)))⟩
  · -- and lisse
    have := isFiniteLocallyConstantSheaf_ihom_unit_of_flat (C.X (-n)) (hCf (-n))
    exact IsFiniteLocallyConstantSheaf.isConstructibleSheaf this

/-- Blueprint `proposition-six-operations-dctf--15` in the form used by
`proposition-six-operations-dctf--15`: for a lisse flat sheaf `P` in degree `0` and
`M ∈ Dctf(X, Λ)`, `RHom(P, M) ≅ P^∨ ⊗ᴸ M` lies in `Dctf(X, Λ)`. -/
lemma constructibleFiniteTor_derivedHom_singleFunctor_of_isFiniteLocallyConstantSheaf
    {X : Scheme.{u}} (P : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))
    [IsFiniteLocallyConstantSheaf P] (hP : ObjectProperty.flat P)
    {M : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hM : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X M) :
    constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj
        (op ((_root_.DerivedCategory.singleFunctor _ 0).obj P))).obj M) := by
  let K := (_root_.DerivedCategory.singleFunctor
    (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) 0).obj P
  obtain ⟨D, hD, ⟨_⟩⟩ := exists_exactPairing_singleFunctor_of_isFiniteLocallyConstantSheaf Λ P hP
  obtain ⟨_⟩ := nonempty_exactPairing_swap D K
  have hKd : IsDualizable K := ⟨⟨D⟩⟩
  obtain ⟨e⟩ := nonempty_iso_coefficientDual_tensor hKd M
  have hDual : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      ((coefficientDual (ModuleCat.{u + 1} Λ) X).obj (op K)) :=
    (constructibleFiniteTor _ X).prop_of_iso (coefficientDualIsoOfExactPairing D K).symm hD
  exact (constructibleFiniteTor _ X).prop_of_iso e (constructibleFiniteTor_tensor Λ X hDual hM)

/-- If `RHom(K, L)` lies in `Dctf(X, Λ)`, so does `RHom(K⟦n⟧, L) ≅ RHom(K, L)⟦-n⟧`. -/
lemma constructibleFiniteTor_derivedHom_shift {X : Scheme.{u}}
    {K L : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hK : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op K)).obj L)) (n : ℤ) :
    constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op (K⟦n⟧))).obj L) := by
  have h : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      ((((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op K)).obj L)⟦-n⟧) :=
    (constructibleFiniteTor _ X).le_shift (-n) _ hK
  let e : ((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op (K⟦n⟧))).obj L ≅
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op K)).obj L)⟦-n⟧ :=
    (derivedHomShiftIso (ModuleCat.{u + 1} Λ) K n).app L
  exact (constructibleFiniteTor _ X).prop_of_iso e.symm h

/-- For `L ∈ Dctf(X, Λ)`, the objects `K` with `RHom(K, L) ∈ Dctf(X, Λ)` form a thick
subcategory of `D(X_ét, Λ)`: `RHom(-, L)` is exact (`definition-verdier-dual-evaluation--3`) and
turns shifts into opposite shifts. -/
lemma isTriangulated_inverseImage_derivedHom_left {X : Scheme.{u}}
    (L : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) :
    ObjectProperty.IsTriangulated (fun K ↦ constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op K)).obj L)) where
  exists_zero := ⟨0, isZero_zero _, (constructibleFiniteTor _ X).prop_of_isZero
    (isZero_derivedHom_obj_of_isZero _ (isZero_zero _) L)⟩
  isStableUnderShiftBy n := ⟨fun _ hK ↦ constructibleFiniteTor_derivedHom_shift Λ hK n⟩
  ext₂' T hT h₁ h₃ := ObjectProperty.le_isoClosure _ _
    (derivedHom_mem_of_distTriang_left (constructibleFiniteTor _ X) L T hT h₁ h₃)

/-- The generator case of `proposition-six-operations-dctf--15`: for `j : U ⟶ Ū` an open
immersion, `g : Ū ⟶ X` a closed immersion, `P` a lisse flat sheaf on `U` and `L ∈ Dctf(X, Λ)`,
`RHom(Rg_* Rj_! P, L) ≅ Rg_* Rj_* RHom(P, Rj^! Rg^! L)` lies in `Dctf(X, Λ)`. -/
lemma constructibleFiniteTor_derivedHom_rightDerivedLowerStar_rightDerivedLowerShriek
    {k : Type u} [Field k] {X Ubar U : Scheme.{u}} (aX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType aX] [QuasiCompact aX] [HasInvertibleExponent Λ X]
    (j : U ⟶ Ubar) [IsOpenImmersion j] [HasCompactification j] [QuasiCompact j]
    (g : Ubar ⟶ X) [IsClosedImmersion g]
    (P : Sheaf U.smallEtaleTopology (ModuleCat.{u + 1} Λ)) [IsFiniteLocallyConstantSheaf P]
    (hP : ObjectProperty.flat P)
    {L : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hL : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X L) :
    constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op ((R((g)_*[ModuleCat.{u + 1} Λ])).obj
        ((R(j)_![ModuleCat.{u + 1} Λ]).obj
          ((_root_.DerivedCategory.singleFunctor _ 0).obj P))))).obj L) := by
  have : HasInvertibleExponent Λ Ubar := .of_hom g
  let P₀ := (_root_.DerivedCategory.singleFunctor
    (Sheaf U.smallEtaleTopology (ModuleCat.{u + 1} Λ)) 0).obj P
  let N := (R(j)_![ModuleCat.{u + 1} Λ]).obj P₀
  let M := (R(g)^![Λ]).obj L
  have hM : constructibleFiniteTor (ModuleCat.{u + 1} Λ) Ubar M :=
    constructibleFiniteTor_rightDerivedUpperShriek Λ aX g hL
  have hjM := constructibleFiniteTor_rightDerivedUpperShriek Λ (g ≫ aX) j hM
  have hH := constructibleFiniteTor_derivedHom_singleFunctor_of_isFiniteLocallyConstantSheaf Λ P
    hP hjM
  have hjH := constructibleFiniteTor_rightDerivedLowerStar Λ (j ≫ g ≫ aX) (g ≫ aX) j rfl hH
  -- `Rj_* RHom(P, Rj^! M) ≅ RHom(Rj_! P, M)`
  have h₁ : constructibleFiniteTor (ModuleCat.{u + 1} Λ) Ubar
      (((RHom(Ubar)[ModuleCat.{u + 1} Λ]).obj (op N)).obj M) :=
    (constructibleFiniteTor _ Ubar).prop_of_iso
      (((derivedHomRightDerivedLowerShriekIsoOfFinite Λ j).app (op P₀)).app M) hjH
  have h₂ := constructibleFiniteTor_rightDerivedLowerStar Λ (g ≫ aX) aX g rfl h₁
  -- `Rg_* RHom(N, Rg^! L) ≅ RHom(Rg_! N, L)`
  have h₃ : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op ((R(g)_![ModuleCat.{u + 1} Λ]).obj N))).obj L) :=
    (constructibleFiniteTor _ X).prop_of_iso
      (((derivedHomRightDerivedLowerShriekIsoOfFinite Λ g).app (op N)).app L) h₂
  -- `Rg_! ≅ Rg_*`
  exact (constructibleFiniteTor _ X).prop_of_iso
    (((RHom(X)[ModuleCat.{u + 1} Λ]).flip.obj L).mapIso
      ((rightDerivedLowerShriekIsoRightDerivedLowerStar _ g).app N).op).symm h₃

/-- Blueprint `proposition-six-operations-dctf--15`: Internal Hom preserves finite Tor amplitude by
dévissage.

Let `k` be a field, `Λ` a finite ring whose exponent is invertible on `X` (for instance a
finite `ℓ`-primary ring with `ℓ ≠ char k`) and `X` a scheme of finite type over `k`. For
`K, L ∈ Dctf(X_ét, Λ)`, the internal hom `RHom(K, L)` lies in `Dctf(X_ét, Λ)`. The blueprint
assumes `k` separably closed; this is not needed.

By the generation theorem for `Dctf(X, Λ)` it suffices to treat `K = Rg_* Rj_! P` with `g`
a closed immersion, `j` an open immersion and `P` lisse flat. Then
`RHom(Rg_* Rj_! P, L) ≅ Rg_* Rj_* RHom(P, Rj^! Rg^! L)` by the tensor–Hom exchanges for `g`
and `j` (`lemma-internal-adjunction-two-exchange-formulas--1`), and `RHom(P, -)` is `P^∨ ⊗ᴸ -` since
`P` is dualizable. -/
theorem constructibleFiniteTor_derivedHom_of_field {k : Type u} [Field k] {X : Scheme.{u}}
    (aX : X ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX]
    [HasInvertibleExponent Λ X]
    {K L : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hK : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X K)
    (hL : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X L) :
    constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op K)).obj L) := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace aX
  have : IsNoetherian X := { __ := LocallyOfFiniteType.isLocallyNoetherian aX }
  let Q : ObjectProperty
      (_root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) :=
    fun K ↦ constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
      (((RHom(X)[ModuleCat.{u + 1} Λ]).obj (op K)).obj L)
  let F := (RHom(X)[ModuleCat.{u + 1} Λ]).flip.obj L
  have : Q.IsTriangulated := isTriangulated_inverseImage_derivedHom_left Λ L
  have : Q.IsClosedUnderIsomorphisms :=
    ⟨fun e hK ↦ (constructibleFiniteTor _ X).prop_of_iso (F.mapIso e.op).symm hK⟩
  have : Q.IsStableUnderRetracts :=
    ⟨fun e hK ↦ (constructibleFiniteTor _ X).prop_of_retract (e.op.map F) hK⟩
  refine ctf_generated_by_rightDerivedLowerStar_rightDerivedLowerShriek Λ X Q
    (fun str i Ubar j _ _ g _ _ _ P _ hP ↦ ?_) K hK
  have : TopologicalSpace.NoetherianSpace (str.domain i) :=
    (str.immersion i).isEmbedding.isInducing.noetherianSpace
  have : QuasiCompact j := ⟨fun _ _ _ ↦ TopologicalSpace.NoetherianSpace.isCompact _⟩
  exact constructibleFiniteTor_derivedHom_rightDerivedLowerStar_rightDerivedLowerShriek Λ aX j g
    P hP hL

end Etale

end AlgebraicGeometry
