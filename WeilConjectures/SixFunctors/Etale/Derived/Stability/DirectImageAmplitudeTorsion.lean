module

public import WeilConjectures.CategoryTheory.DerivedCategory.CoproductsOfHomologyProperty
public import WeilConjectures.ConstructibleSheaf.RestrictScalars
public import WeilConjectures.SixFunctors.Etale.Derived.DirectImageAmplitude
public import WeilConjectures.SixFunctors.Etale.Derived.RestrictScalarsLowerStarSingle

/-!
# Amplitude of the direct image of complexes killed by an integer

Let `k` be a field, `f : X ⟶ Y` a morphism of `k`-schemes of finite type with `dim X ≤ d`, and
`Λ` an arbitrary commutative ring. The bound `Rf_* D^{≤ n} ⊆ D^{≤ n + 2d}` of
`AlgebraicGeometry.Etale.isLE_rightDerivedLowerStar_obj` assumes `Λ` torsion. This file proves
it for bounded complexes killed by a nonzero integer `N`
(`AlgebraicGeometry.Etale.isLE_rightDerivedLowerStar_obj_of_nsmul_id_eq_zero`):

* a sheaf `F` of `Λ`-modules killed by `N` is the restriction of scalars of a sheaf of
  `Λ ⧸ N`-modules, and restriction of scalars commutes with `Rf_*`
  (`AlgebraicGeometry.Etale.restrictScalarsRightDerivedLowerStarSingleIso`); the ring `Λ ⧸ N` is
  torsion, so `Rf_* F` vanishes above `2d`;
* a bounded complex killed by `N` has its homology sheaves killed by `N`, and the dévissage
  `DerivedCategory.isLE_obj_of_isLE_of_homologyProperty` concludes.
-/

@[expose] public section

universe u

open CategoryTheory Limits ZeroObject

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

variable (Λ : Type (u + 1)) [CommRing Λ]

variable {Λ} in
/-- An object of a `Λ`-linear category killed by an integer `N` is killed by the ideal of `Λ`
generated by `N`. -/
lemma smul_id_eq_zero_of_mem_span_natCast {C : Type*} [Category* C] [Preadditive C]
    [Linear Λ C] {Z : C} {N : ℕ} (hZ : N • 𝟙 Z = 0) :
    ∀ r ∈ Ideal.span {(N : Λ)}, r • 𝟙 Z = 0 := fun r hr ↦ by
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hr
  rw [mul_smul, Nat.cast_smul_eq_nsmul, hZ, smul_zero]

variable {k : Type u} [Field k] {X Y : Scheme.{u}} (aX : X ⟶ Spec (.of k))
  (aY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX] [LocallyOfFiniteType aY]
  [QuasiCompact aY] (f : X ⟶ Y) (hf : f ≫ aY = aX) (d : ℕ)
  (hd : topologicalKrullDim X ≤ (d : WithBot ℕ∞))

include hf hd in
/-- **The direct image of a sheaf killed by an integer vanishes above twice the dimension.** Let
`f : X ⟶ Y` be a morphism of `k`-schemes of finite type with `dim X ≤ d`, and `F` an étale sheaf
of `Λ`-modules on `X` killed by a nonzero integer `N`. Then `Rf_* F` vanishes above `2d`.

The sheaf `F` is the restriction of scalars of the sheaf `Hom_Λ(Λ ⧸ N, F)` of `Λ ⧸ N`-modules
(`CategoryTheory.Sheaf.restrictScalarsCoextendScalarsIso`), restriction of scalars commutes with
`Rf_*`, and `Λ ⧸ N` is torsion, so `AlgebraicGeometry.Etale.isLE_rightDerivedLowerStar_obj`
applies. -/
theorem isLE_rightDerivedLowerStar_singleFunctor_obj_of_nsmul_id_eq_zero
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) (N : ℕ) [NeZero N]
    (hF : N • 𝟙 F = 0) :
    ((R((f)_*[ModuleCat.{u + 1} Λ])).obj
      ((_root_.DerivedCategory.singleFunctor _ 0).obj F)).IsLE (2 * (d : ℤ)) := by
  let J := Ideal.span {(N : Λ)}
  let F' := (Sheaf.coextendScalars X.smallEtaleTopology J).obj F
  let e : (Sheaf.restrictScalars X.smallEtaleTopology (Ideal.Quotient.mk J)).obj F' ≅ F :=
    Sheaf.restrictScalarsCoextendScalarsIso F (smul_id_eq_zero_of_mem_span_natCast hF)
  have hJ : IsAddTorsion (Λ ⧸ J) := fun x ↦ by
    refine isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨N, Nat.pos_of_ne_zero (NeZero.ne N), ?_⟩
    rw [nsmul_eq_mul, ← map_natCast (Ideal.Quotient.mk _),
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self _), zero_mul]
  have h := isLE_rightDerivedLowerStar_obj (Λ ⧸ J) hJ aX aY f hf d hd
    ((_root_.DerivedCategory.singleFunctor _ 0).obj F') 0
  rw [zero_add] at h
  have := (Sheaf.restrictScalars Y.smallEtaleTopology
    (Ideal.Quotient.mk J)).isLE_mapDerivedCategory_obj
    ((R((f)_*[ModuleCat.{u + 1} (Λ ⧸ J)])).obj ((_root_.DerivedCategory.singleFunctor _ 0).obj F'))
    (2 * (d : ℤ))
  exact _root_.DerivedCategory.TStructure.t.isLE_of_iso
    (restrictScalarsRightDerivedLowerStarSingleIso (Ideal.Quotient.mk J) f F' ≪≫
      (R((f)_*[ModuleCat.{u + 1} Λ])).mapIso
        ((_root_.DerivedCategory.singleFunctor _ 0).mapIso e)) _

/-- The class of objects of a preadditive category killed by an integer `N`. -/
def nsmulIdEqZero {C : Type*} [Category* C] [Preadditive C] (N : ℕ) : ObjectProperty C :=
  fun Z ↦ N • 𝟙 Z = 0

instance {C : Type*} [Category* C] [Preadditive C] (N : ℕ) :
    (nsmulIdEqZero (C := C) N).IsClosedUnderIsomorphisms where
  of_iso {Z Z'} e hZ := by
    have : N • 𝟙 Z' = e.inv ≫ (N • 𝟙 Z) ≫ e.hom := by simp
    simp only [nsmulIdEqZero] at hZ ⊢
    rw [this, hZ, zero_comp, comp_zero]

instance {C : Type*} [Category* C] [Preadditive C] [HasZeroObject C] (N : ℕ) :
    (nsmulIdEqZero (C := C) N).ContainsZero where
  exists_zero := ⟨0, isZero_zero C, (isZero_zero C).eq_of_src _ _⟩

include hf hd in
/-- **The derived direct image of a complex killed by an integer raises degrees by at most twice
the dimension.** Let `f : X ⟶ Y` be a morphism of `k`-schemes of finite type with `dim X ≤ d`,
and `K ∈ D(X_ét, Λ)` a bounded complex killed by a nonzero integer `N`, vanishing above `n`. Then
`Rf_* K` vanishes above `n + 2d`. The homology sheaves of `K` are killed by `N`, so this is the
dévissage `DerivedCategory.isLE_obj_of_isLE_of_homologyProperty` from the case of a sheaf,
`AlgebraicGeometry.Etale.isLE_rightDerivedLowerStar_singleFunctor_obj_of_nsmul_id_eq_zero`. -/
theorem isLE_rightDerivedLowerStar_obj_of_nsmul_id_eq_zero
    (K : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)))
    (hK : _root_.DerivedCategory.TStructure.t.bounded K) (N : ℕ) [NeZero N] (hN : N • 𝟙 K = 0)
    (n : ℤ) [K.IsLE n] :
    ((R((f)_*[ModuleCat.{u + 1} Λ])).obj K).IsLE (n + 2 * (d : ℤ)) :=
  _root_.DerivedCategory.isLE_obj_of_isLE_of_homologyProperty (R((f)_*[ModuleCat.{u + 1} Λ]))
    (2 * (d : ℤ)) (nsmulIdEqZero N)
    (fun F hF ↦ isLE_rightDerivedLowerStar_singleFunctor_obj_of_nsmul_id_eq_zero Λ aX aY f hf d hd
      F N hF) K hK (fun q ↦ by
        simp only [nsmulIdEqZero]
        rw [← CategoryTheory.Functor.map_id, ← Functor.map_nsmul, hN, Functor.map_zero]) n

end Etale

end AlgebraicGeometry
