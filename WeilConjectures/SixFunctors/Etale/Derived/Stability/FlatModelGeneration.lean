/-!
# Strata of a flat constructible sheaf and generation of `Dctf` by `a_! L`

Let `X` be a Noetherian scheme and `Λ` a finite commutative ring. This file proves blueprint
`lemma-flat-models-generators--2`:

1. a flat constructible sheaf `F` of `Λ`-modules on `X_ét` has a finite chain of opens
   `∅ = V₀ ⊆ V₁ ⊆ ⋯ ⊆ V_m = X` such that `F` restricted to each locally closed stratum
   `V_{r+1} \ V_r` is finite locally constant and flat, with finite projective stalks
   (`AlgebraicGeometry.Etale.exists_chain_opens_flat_isFiniteLocallyConstantSheaf`);
2. the sheaves `a_! L = g_* j_! L`, for `a = j ≫ g` a locally closed immersion and `L` flat, are
   flat (`AlgebraicGeometry.Etale.flat_lowerStar_openImmersionLowerShriek`), constructible and
   lie in `Dctf(X, Λ)` (`AlgebraicGeometry.Etale.constructibleFiniteTor_of_ctfGenerators`), and
   `F` lies in every triangulated subcategory containing them
   (`AlgebraicGeometry.Etale.prop_singleFunctor_of_flat`);
3. `Dctf(X, Λ)` is the thick subcategory of `D(X_ét, Λ)` generated by these objects
   (`constructibleFiniteTor_eq_triangEnvelope_ctfGenerators_of_isNoetherian`).

A finite locally constant sheaf is flat if and only if its stalks are finite projective
`Λ`-modules (`AlgebraicGeometry.Etale.flat_iff_forall_projective_sheafFiber`), so the generators
are the `a_! L` with `L` locally constant with finite projective stalks, as in the blueprint.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite ZeroObject

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

open _root_.AlgebraicGeometry.Etale.DerivedCategory

variable {Λ : Type (u + 1)} [CommRing Λ] {X : Scheme.{u}}

/-! ### Flatness on an open and its closed complement -/

section Flat

/-- A sheaf of `Λ`-modules on `X_ét` is flat as soon as its restrictions to an open `U` and to
the complementary closed subscheme `Z` are flat: flatness is checked on stalks, and every
geometric point of `X` factors through `U` or through `Z`. -/
theorem flat_of_flat_upperStar {U Z : Scheme.{u}} (j : U ⟶ X) (i : Z ⟶ X) [IsOpenImmersion j]
    [IsClosedImmersion i] (hij : Set.range i.base = (Set.range j.base)ᶜ)
    (G : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))
    (hj : ObjectProperty.flat ((j)^*[ModuleCat.{u + 1} Λ].obj G))
    (hi : ObjectProperty.flat ((i)^*[ModuleCat.{u + 1} Λ].obj G)) :
    ObjectProperty.flat G := by
  refine (flat_iff_forall_flat_sheafFiber_obj G).2 fun s ↦ ?_
  obtain ⟨t, rfl, -⟩ | ⟨t, rfl, -⟩ := existsUnique_fac_or_fac_of_range_eq_compl j i hij s
  · exact ObjectProperty.prop_of_iso _ ((upperStarCompUliftSheafFiberIso _ j t).app G)
      ((flat_iff_forall_flat_sheafFiber_obj _).1 hj t)
  · exact ObjectProperty.prop_of_iso _ ((upperStarCompUliftSheafFiberIso _ i t).app G)
      ((flat_iff_forall_flat_sheafFiber_obj _).1 hi t)

/-- Extension by zero along an open immersion preserves flatness: `j_! L` restricts to `L` on
`U` and to `0` on the closed complement. -/
theorem flat_openImmersionLowerShriek_obj {U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    {L : Sheaf U.smallEtaleTopology (ModuleCat.{u + 1} Λ)} (hL : ObjectProperty.flat L) :
    ObjectProperty.flat ((j)_!open[ModuleCat.{u + 1} Λ].obj L) := by
  obtain ⟨Z, i, _, hi⟩ := exists_isClosedImmersion_range_eq_compl j
  refine flat_of_flat_upperStar j i hi _ ?_ ?_
  · exact ObjectProperty.prop_of_iso _
      ((asIso (openImmersionLowerShriekUpperStarAdjunction _ j).unit).app L) hL
  · exact ObjectProperty.flat_of_isZero (isZero_upperStar_openImmersionLowerShriek_of_disjoint_range
      _ j i (disjoint_range_of_range_eq_compl j i hi) L)

/-- The pushforward along a closed immersion preserves flatness: `i_* L` restricts to `L` on
`Z` (`i^* i_* ≅ 𝟭`) and to `0` on the open complement. -/
theorem flat_lowerStar_obj_of_isClosedImmersion {Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] {L : Sheaf Z.smallEtaleTopology (ModuleCat.{u + 1} Λ)}
    (hL : ObjectProperty.flat L) :
    ObjectProperty.flat ((i)_*[ModuleCat.{u + 1} Λ].obj L) := by
  let V := openComplementOfIsClosedImmersion i
  have hi : Set.range i.base = (Set.range V.ι.base)ᶜ := by
    simp [V, openComplementOfIsClosedImmersion]
  refine flat_of_flat_upperStar V.ι i hi _ ?_ ?_
  · exact ObjectProperty.flat_of_isZero (isZero_upperStar_lowerStar_of_disjoint_range
      _ V.ι i (disjoint_range_of_range_eq_compl V.ι i hi) L)
  · exact ObjectProperty.prop_of_iso _
      ((asIso (upperStarLowerStarAdjunction _ i).counit).app L).symm hL

/-- The sheaf `a_! L = g_* j_! L` attached to a locally closed immersion `a = j ≫ g` (an open
immersion followed by a closed immersion) and a flat sheaf `L` is flat. -/
theorem flat_lowerStar_openImmersionLowerShriek {U Ubar : Scheme.{u}} (j : U ⟶ Ubar)
    [IsOpenImmersion j] (g : Ubar ⟶ X) [IsClosedImmersion g]
    {L : Sheaf U.smallEtaleTopology (ModuleCat.{u + 1} Λ)} (hL : ObjectProperty.flat L) :
    ObjectProperty.flat ((g)_*[ModuleCat.{u + 1} Λ].obj
      ((j)_!open[ModuleCat.{u + 1} Λ].obj L)) :=
  flat_lowerStar_obj_of_isClosedImmersion g (flat_openImmersionLowerShriek_obj j hL)

/-- Over a finite ring `Λ`, a finite sheaf of `Λ`-modules on `X_ét` (one with finitely generated
stalks, for instance a finite locally constant sheaf) is flat if and only if all its stalks at
geometric points are (finite) projective `Λ`-modules: a finite flat module over the Noetherian
ring `Λ` is finitely presented and flat, hence projective. -/
theorem flat_iff_forall_projective_sheafFiber [Finite Λ]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) [IsFiniteSheaf F] :
    ObjectProperty.flat F ↔ ∀ {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ X),
      Module.Projective Λ ((pointSmallEtale s).sheafFiber.obj F : ModuleCat.{u + 1} Λ) := by
  rw [flat_iff_forall_flat_sheafFiber_obj]
  refine ⟨fun h Ω _ _ s ↦ ?_, fun h Ω _ _ s ↦ ?_⟩
  · have : Module.Flat Λ ((pointSmallEtale s).sheafFiber.obj F : ModuleCat.{u + 1} Λ) :=
      (ModuleCat.flat_iff_flat _).1 (ObjectProperty.prop_of_iso _
        (((pointSmallEtale s).uliftSheafFiberIso _).app F) (h s))
    have : Module.Finite Λ ((pointSmallEtale s).sheafFiber.obj F : ModuleCat.{u + 1} Λ) :=
      (ModuleCat.isFinitelyGenerated_iff _).1
        (IsFiniteSheaf.isFinitelyGenerated_sheafFiber Ω s)
    have : IsNoetherianRing Λ := inferInstance
    have : Module.FinitePresentation Λ
        ((pointSmallEtale s).sheafFiber.obj F : ModuleCat.{u + 1} Λ) :=
      Module.finitePresentation_of_finite _ _
    exact Module.Flat.projective_of_finitePresentation
  · have := h s
    exact ObjectProperty.prop_of_iso _ (((pointSmallEtale s).uliftSheafFiberIso _).app F).symm
      ((ModuleCat.flat_iff_flat _).2 inferInstance)

end Flat

/-! ### Strata of a flat constructible sheaf -/

section Strata

variable [Finite Λ]

/-- Blueprint `lemma-flat-models-generators--2`, part (1): strata of a flat constructible sheaf.

Let `X` be Noetherian and `F` a flat constructible sheaf of `Λ`-modules on `X_ét`. There is a
finite chain of opens `∅ = V₀ ⊆ V₁ ⊆ ⋯ ⊆ V_m = X` such that, for every locally closed stratum
`S_r = V_{r+1} \ V_r` and every immersion `a : Y ⟶ X` with image `S_r`, the restriction `a^* F`
is finite locally constant and flat, with finite projective stalks. The closed subsets
`X \ V_r` are the `X_{≥ r}` of the blueprint, and `S_r` is open in `X \ V_r`. -/
theorem exists_chain_opens_flat_isFiniteLocallyConstantSheaf [IsNoetherian X]
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) [IsConstructibleSheaf F]
    (hF : ObjectProperty.flat F) :
    ∃ (m : ℕ) (V : Fin (m + 1) → X.Opens), V 0 = ⊥ ∧ V (Fin.last m) = ⊤ ∧
      ∀ r : Fin m, V r.castSucc ≤ V r.succ ∧
        ∀ (Y : Scheme.{u}) (a : Y ⟶ X) [IsImmersion a],
          Set.range a.base = (V r.succ : Set X) \ V r.castSucc →
          IsFiniteLocallyConstantSheaf ((a)^*[ModuleCat.{u + 1} Λ].obj F) ∧
          ObjectProperty.flat ((a)^*[ModuleCat.{u + 1} Λ].obj F) ∧
          ∀ {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ Y),
            Module.Projective Λ
              ((pointSmallEtale s).sheafFiber.obj
                ((a)^*[ModuleCat.{u + 1} Λ].obj F) : ModuleCat.{u + 1} Λ) := by
  obtain ⟨S, hS⟩ := IsConstructibleSheaf.exists_stratification
    (FA := fun M N : ModuleCat.{u + 1} Λ ↦ M →ₗ[Λ] N) (CA := fun M : ModuleCat.{u + 1} Λ ↦ M)
    (F := F)
  obtain ⟨m, V, hV0, hVm, hstep⟩ := S.exists_chain_opens (⊥ : X.Opens)
  refine ⟨m, V, hV0, hVm, fun r ↦ ⟨(hstep r).1, fun Y a _ ha ↦ ?_⟩⟩
  obtain ⟨k, hk⟩ := (hstep r).2
  have := hS k
  have : IsFiniteLocallyConstantSheaf ((a)^*[ModuleCat.{u + 1} Λ].obj F) :=
    IsFiniteLocallyConstantSheaf.upperStar_of_range_subset _ (S.immersion k)
      (by rw [S.range_immersion]; exact ha ▸ hk) F
  have hflat : ObjectProperty.flat ((a)^*[ModuleCat.{u + 1} Λ].obj F) :=
    Functor.PreservesFlat.flat_obj (F := (a)^*[_]) hF
  exact ⟨this, hflat, (flat_iff_forall_projective_sheafFiber _).1 hflat⟩

end Strata

/-! ### The generators `a_! L` -/

section Generators

variable [Finite Λ]

variable (Λ) in
/-- Blueprint `lemma-flat-models-generators--2`, part (2): the generators lie in `Dctf`.

Let `X` be Noetherian, `a = j ≫ g : U ⟶ X` a locally closed immersion (an open immersion
`j : U ⟶ Ū` followed by a closed immersion `g : Ū ⟶ X`) and `L` a flat finite locally constant
sheaf of `Λ`-modules on `U`. Then `a_! L = g_* j_! L` is a flat constructible sheaf, the derived
`Rg_* Rj_! L` is `a_! L` placed in degree `0`, and it lies in `Dctf(X, Λ)` (Tor amplitude
`[0, 0]`). -/
theorem constructibleFiniteTor_rightDerivedLowerStar_rightDerivedLowerShriek [IsNoetherian X]
    {U Ubar : Scheme.{u}} (j : U ⟶ Ubar) [IsOpenImmersion j] [HasCompactification j]
    (g : Ubar ⟶ X) [IsClosedImmersion g]
    (L : Sheaf U.smallEtaleTopology (ModuleCat.{u + 1} Λ)) [IsFiniteLocallyConstantSheaf L]
    (hL : ObjectProperty.flat L) :
    ObjectProperty.flat ((g)_*[ModuleCat.{u + 1} Λ].obj
        ((j)_!open[ModuleCat.{u + 1} Λ].obj L)) ∧
      IsConstructibleSheaf ((g)_*[ModuleCat.{u + 1} Λ].obj
        ((j)_!open[ModuleCat.{u + 1} Λ].obj L)) ∧
      Nonempty ((R((g)_*[ModuleCat.{u + 1} Λ])).obj ((R(j)_![ModuleCat.{u + 1} Λ]).obj
          ((_root_.DerivedCategory.singleFunctor _ 0).obj L)) ≅
        (_root_.DerivedCategory.singleFunctor _ 0).obj ((g)_*[ModuleCat.{u + 1} Λ].obj
          ((j)_!open[ModuleCat.{u + 1} Λ].obj L))) ∧
      constructibleFiniteTor (ModuleCat.{u + 1} Λ) X
        ((R((g)_*[ModuleCat.{u + 1} Λ])).obj ((R(j)_![ModuleCat.{u + 1} Λ]).obj
          ((_root_.DerivedCategory.singleFunctor _ 0).obj L))) := by
  have : TopologicalSpace.NoetherianSpace Ubar :=
    g.isClosedEmbedding.isInducing.noetherianSpace
  have : TopologicalSpace.NoetherianSpace U := j.isOpenEmbedding.isInducing.noetherianSpace
  have : QuasiCompact j := ⟨fun _ _ _ ↦ TopologicalSpace.NoetherianSpace.isCompact _⟩
  have : TopologicalSpace.NoetherianSpace (openComplementOfIsClosedImmersion g) :=
    (openComplementOfIsClosedImmersion g).ι.isOpenEmbedding.isInducing.noetherianSpace
  have : QuasiCompact (openComplementOfIsClosedImmersion g).ι :=
    ⟨fun _ _ _ ↦ TopologicalSpace.NoetherianSpace.isCompact _⟩
  have : IsFinite g := ((IsClosedImmersion.iff_isFinite_and_mono g).1 inferInstance).1
  have : IsConstructibleSheaf L := IsFiniteLocallyConstantSheaf.isConstructibleSheaf ‹_›
  have : IsConstructibleSheaf ((j)_!open[ModuleCat.{u + 1} Λ].obj L) :=
    IsConstructibleSheaf.openImmersionLowerShriek_of_quasiCompact j L
  have hc : IsConstructibleSheaf ((g)_*[ModuleCat.{u + 1} Λ].obj
      ((j)_!open[ModuleCat.{u + 1} Λ].obj L)) :=
    IsConstructibleSheaf.lowerStar_of_isClosedImmersion_of_quasiCompact g _
  have hf := flat_lowerStar_openImmersionLowerShriek j g hL
  let e : (R((g)_*[ModuleCat.{u + 1} Λ])).obj ((R(j)_![ModuleCat.{u + 1} Λ]).obj
      ((_root_.DerivedCategory.singleFunctor _ 0).obj L)) ≅
      (_root_.DerivedCategory.singleFunctor _ 0).obj ((g)_*[ModuleCat.{u + 1} Λ].obj
        ((j)_!open[ModuleCat.{u + 1} Λ].obj L)) :=
    (R((g)_*[ModuleCat.{u + 1} Λ])).mapIso
        ((rightDerivedLowerShriekIsoOfIsOpenImmersion Λ j).app _ ≪≫
          (((j)_!open[ModuleCat.{u + 1} Λ]).mapDerivedCategorySingleFunctor 0).app L) ≪≫
      (Etale.rightDerivedFunctorLowerStarIsoMapDerivedCategory _ g).app _ ≪≫
      (((g)_*[ModuleCat.{u + 1} Λ]).mapDerivedCategorySingleFunctor 0).app _
  refine ⟨hf, hc, ⟨e⟩, (constructibleFiniteTor _ X).prop_of_iso e.symm
    ⟨boundedConstructible_singleFunctor_obj _ 0, 0, 0,
      torAmplitudeIn_singleFunctor_obj_of_flat Λ _ hf⟩⟩

variable (Λ) in
/-- Blueprint `lemma-flat-models-generators--2`, part (2): every generator of `ctfGenerators` (an
object `Rg_* Rj_! L ≅ a_! L`) lies in `Dctf(X, Λ)`, for `X` Noetherian. -/
theorem constructibleFiniteTor_of_ctfGenerators [IsNoetherian X]
    {K : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))}
    (hK : ctfGenerators Λ X K) : constructibleFiniteTor (ModuleCat.{u + 1} Λ) X K := by
  obtain ⟨str, i, Ubar, j, _, _, g, _, -, -, L, _, hL, ⟨e⟩⟩ := hK
  exact (constructibleFiniteTor _ X).prop_of_iso e.symm
    (constructibleFiniteTor_rightDerivedLowerStar_rightDerivedLowerShriek Λ j g L hL).2.2.2

variable (Λ) in
/-- Blueprint `lemma-flat-models-generators--2`, part (2): a flat constructible sheaf `F` on a
Noetherian `X` is an iterated extension of the sheaves `a_! L` of its strata, in the form: every
triangulated property of objects of `D(X_ét, Λ)`, closed under isomorphisms and holding for the
generators `Rg_* Rj_! L ≅ a_! L` (`L` lisse and flat on a stratum), holds for `F` placed in
degree `0`. This is the Noetherian induction on the open–closed sequences
`0 ⟶ j_!(F|_U) ⟶ F ⟶ i_* i^* F ⟶ 0` of
`AlgebraicGeometry.Etale.prop_rightDerivedLowerStar_of_flat`. -/
theorem prop_singleFunctor_of_flat [IsNoetherian X]
    (P : ObjectProperty
      (_root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))))
    [P.IsTriangulated] [P.IsClosedUnderIsomorphisms] (hP : ctfGenerators Λ X ≤ P)
    (F : Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) [IsConstructibleSheaf F]
    (hF : ObjectProperty.flat F) :
    P ((_root_.DerivedCategory.singleFunctor _ 0).obj F) :=
  P.prop_of_iso ((rightDerivedLowerStarIdIso Λ X).app _)
    (prop_rightDerivedLowerStar_of_flat Λ X P
      (fun str i Ubar j _ _ g _ h₁ h₂ L _ hL ↦ hP _
        ⟨str, i, Ubar, j, inferInstance, inferInstance, g, inferInstance, h₁, h₂, L,
          inferInstance, hL, ⟨Iso.refl _⟩⟩)
      ⊤ (𝟙 X) (by simp) F hF)

variable (Λ) in
/-- Blueprint `lemma-flat-models-generators--2`: Strata of a flat constructible sheaf and
generation by `a_! L`, part (3).

Let `X` be a Noetherian scheme and `Λ` a finite commutative ring. Then `Dctf(X, Λ)` is the
smallest full subcategory of `D(X_ét, Λ)` containing the objects `a_! L` and closed under
shifts, extensions (cones) and direct summands (`ObjectProperty.triangEnvelope`). Here
`a = j ≫ g` is a locally closed immersion of a stratum `U` of a stratification of `X`, with
`j : U ⟶ Ū` open and `g : Ū ⟶ X` the closed immersion of the closure, `a_! L = Rg_* Rj_! L`,
and `L` is locally constant and flat, equivalently with finite projective stalks
(`AlgebraicGeometry.Etale.flat_iff_forall_projective_sheafFiber`); these are the objects of
`AlgebraicGeometry.Etale.ctfGenerators`.

The generators lie in `Dctf(X, Λ)` (`constructibleFiniteTor_of_ctfGenerators`), which is thick;
conversely an object of `Dctf(X, Λ)` has a bounded flat constructible model, whose stupid
truncations reduce it to its terms, each an iterated extension of sheaves `a_! L`
(`AlgebraicGeometry.Etale.ctf_generated_by_rightDerivedLowerStar_rightDerivedLowerShriek`). -/
theorem constructibleFiniteTor_eq_triangEnvelope_ctfGenerators_of_isNoetherian
    (X : Scheme.{u}) [IsNoetherian X] :
    constructibleFiniteTor (ModuleCat.{u + 1} Λ) X = (ctfGenerators Λ X).triangEnvelope := by
  refine le_antisymm (fun K hK ↦ ?_) ((ObjectProperty.triangEnvelope_le_iff _).2
    fun K hK ↦ constructibleFiniteTor_of_ctfGenerators Λ hK)
  refine ctf_generated_by_rightDerivedLowerStar_rightDerivedLowerShriek Λ X _
    (fun str i Ubar j _ _ g _ h₁ h₂ L _ hL ↦ ?_) K hK
  exact ObjectProperty.le_triangEnvelope _ _
    ⟨str, i, Ubar, j, inferInstance, inferInstance, g, inferInstance, h₁, h₂, L, inferInstance,
      hL, ⟨Iso.refl _⟩⟩

end Generators

end Etale

end AlgebraicGeometry
