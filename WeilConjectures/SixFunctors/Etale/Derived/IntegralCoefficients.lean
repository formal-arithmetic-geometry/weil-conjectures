/-!
# Integral coefficients: internal hom, exceptional adjoint and normalized towers

Let `Λ` be a ring with an ideal `I = (ϖ)` generated by a nonzerodivisor, the intended case
being `Λ = 𝒪_E` and `I = 𝔪_E` for a finite extension `E` of `ℚ_ℓ`, and put `A_n = Λ ⧸ Iⁿ`.
This file states the results of the blueprint on integral coefficients that the preservation
matrix `rem-sf-preservation-matrix` cites:

- `AlgebraicGeometry.Etale.nonempty_iso_reductionModIdeal_derivedHom` and
  `AlgebraicGeometry.Etale.derivedComplete_derivedHom` (`lem-coef-integral-hom-reduction`):
  the internal hom commutes with reduction and preserves derived completeness;
- `AlgebraicGeometry.Etale.boundedConstructibleIntegral_derivedHom`
  (`cor-coef-integral-internal-hom`): the internal hom preserves `Dᵇc(X, Λ)`;
- `AlgebraicGeometry.Etale.boundedConstructibleIntegral_exceptionalAdjoint`
  (`prop-coef-integral-exceptional-adjoint`): the integral exceptional adjoint;
- `AlgebraicGeometry.Etale.NormalizedTower` (`def-coef-normalized-dvr-tower`) and
  `AlgebraicGeometry.Etale.NormalizedTower.isDerivedBaseChange_of_isHomotopyLimit`
  (`lem-coef-normalized-dvr-effectivity`): a normalized tower is the tower of reductions of its
  derived limit.

## Implementation notes

As elsewhere in the repository
(`AlgebraicGeometry.Etale.DerivedCategory.boundedConstructibleIntegral`) the integral stage
is realised on the small étale site, an object of `D(X, A_n)` being often recorded through its
restriction of scalars to `Λ`, and the reduction `K ⊗ᴸ_Λ A_n` through
`AlgebraicGeometry.Etale.reductionModIdeal`. When an object of `D(X_ét, A_n)` itself is needed,
the derived base change `K ⊗ᴸ_Λ A_n ∈ D(X_ét, A_n)` is characterised by its universal property
(`AlgebraicGeometry.Etale.IsDerivedBaseChange`): it is left adjoint to restriction of scalars.
The comparison maps of the blueprint are only asserted to exist, as in
`WeilConjectures.SixFunctors.ProEtale.FiniteCoefficient.Derived.HomComparison`.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

-- Elaborate the ring structure of the quotients `Λ ⧸ Iⁿ` through their commutative ring
-- structure, as in the general results about `[CommRing Λ']` applied to them: the kernel compares
-- `Ideal.Quotient.instRingQuotient` with `CommRing.toRing Ideal.Quotient.commRing` inside derived
-- categories only very slowly.
attribute [local instance 2000] CommRing.toRing

set_option hygiene false in
/-- The derived category `D(X_ét, Λ)` of étale sheaves of `Λ`-modules on `X`. -/
local notation "𝐃(" X ", " Λ ")" =>
  _root_.DerivedCategory (Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u + 1} Λ))

/-- The small étale site of a scheme is essentially small. Instance search does not find this
in the presence of the imports of this file. -/
local instance (X : Scheme.{u}) : EssentiallySmall.{u + 1} X.Etale :=
  have : LocallySmall.{u + 1} X.Etale :=
    @locallySmall_of_univLE X.Etale _ (@univLE_of_max.{u, u + 1} UnivLE.self)
  essentiallySmall_of_small_of_locallySmall _

section RestrictScalars

variable {Λ Λ' : Type (u + 1)} [CommRing Λ] [CommRing Λ'] (φ : Λ →+* Λ') (X : Scheme.{u})

/-- Restriction of scalars `D(X_ét, Λ') ⥤ D(X_ét, Λ)` along a ring morphism `φ : Λ →+* Λ'`,
induced by the exact restriction of scalars of étale sheaves: the case of the small étale site
of `CategoryTheory.Sheaf.derivedRestrictScalars`. -/
noncomputable abbrev derivedRestrictScalars : 𝐃(X, Λ') ⥤ 𝐃(X, Λ) :=
  Sheaf.derivedRestrictScalars X.smallEtaleTopology φ

variable {φ X}

/-- Every element of `J` acts by zero on a restriction of scalars along `Λ →+* Λ ⧸ J`. -/
lemma smul_id_derivedRestrictScalars_obj {J : Ideal Λ} {r : Λ} (hr : r ∈ J)
    (N : 𝐃(X, Λ ⧸ J)) :
    r • 𝟙 ((derivedRestrictScalars (Ideal.Quotient.mk J) X).obj N) = 0 := by
  let F := Sheaf.restrictScalars X.smallEtaleTopology (Ideal.Quotient.mk J)
  let P := (_root_.DerivedCategory.Q).objPreimage N
  let e : (derivedRestrictScalars (Ideal.Quotient.mk J) X).obj N ≅
      (_root_.DerivedCategory.Q).obj ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj P) :=
    (derivedRestrictScalars _ X).mapIso ((_root_.DerivedCategory.Q).objObjPreimageIso N).symm ≪≫
      F.mapDerivedCategoryFactors.app P
  have h₀ : r • 𝟙 ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj P) = 0 := by
    refine HomologicalComplex.hom_ext _ _ fun i ↦ ?_
    simp only [HomologicalComplex.smul_f_apply, HomologicalComplex.id_f,
      HomologicalComplex.zero_f]
    change r • 𝟙 (F.obj (P.X i)) = 0
    ext U x
    have hr' : Ideal.Quotient.mk J r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
    change r • x = 0
    rw [ModuleCat.restrictScalars.smul_def, hr', zero_smul]
  have h₁ : r • 𝟙 ((_root_.DerivedCategory.Q).obj
      ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj P)) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← Functor.map_smul, h₀, Functor.map_zero]
  have : r • 𝟙 ((derivedRestrictScalars (Ideal.Quotient.mk J) X).obj N) =
      e.hom ≫ (r • 𝟙 _) ≫ e.inv := by
    rw [Linear.smul_comp, Linear.comp_smul, Category.id_comp, Iso.hom_inv_id]
  rw [this, h₁, zero_comp, comp_zero]

/-- A morphism `η : K ⟶ Res K'` from `K ∈ D(X_ét, Λ)` to the restriction of scalars of
`K' ∈ D(X_ét, Λ')` *exhibits `K'` as the derived base change `K ⊗ᴸ_Λ Λ'`* if it is universal
among morphisms from `K` to restrictions of scalars: derived base change is left adjoint to
restriction of scalars. For `Λ' = Λ ⧸ J` the restriction of scalars of `K'` is then the
reduction `K ⊗ᴸ (Λ ⧸ J)_X` (`AlgebraicGeometry.Etale.reductionModIdeal`). This is the case of
the small étale site of `CategoryTheory.Sheaf.IsDerivedBaseChange`. -/
abbrev IsDerivedBaseChange {K : 𝐃(X, Λ)} {K' : 𝐃(X, Λ')}
    (η : K ⟶ (derivedRestrictScalars φ X).obj K') : Prop :=
  Sheaf.IsDerivedBaseChange η

end RestrictScalars

variable {Λ : Type (u + 1)} [CommRing Λ] (I : Ideal Λ)

section Reduction

variable {X Y : Scheme.{u}}

/-- **Triangulated linear functors commute with reduction modulo a power of a nonzerodivisor.**
For a nonzerodivisor `ϖ` of `Λ`, `n : ℕ` and a triangulated `Λ`-linear functor
`Φ : D(X_ét, Λ) ⥤ D(Y_ét, Λ)`, there is an isomorphism `Φ(K ⊗ᴸ Λ/(ϖⁿ)) ≅ Φ(K) ⊗ᴸ Λ/(ϖⁿ)`:
both are cones of the multiplication by `ϖⁿ`, on `Φ(K)`. -/
theorem nonempty_iso_map_reductionModIdeal (Φ : 𝐃(X, Λ) ⥤ 𝐃(Y, Λ)) [Φ.CommShift ℤ]
    [Φ.IsTriangulated] [Φ.Linear Λ] {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ) (n : ℕ)
    (K : 𝐃(X, Λ)) :
    Nonempty (Φ.obj ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ n)).obj K) ≅
      (reductionModIdeal Λ Y (Ideal.span {ϖ} ^ n)).obj (Φ.obj K)) := by
  let FX := (derivedTensor (ModuleCat.{u + 1} Λ) X).obj K
  let FY := (derivedTensor (ModuleCat.{u + 1} Λ) Y).obj (Φ.obj K)
  let TX := _root_.DerivedCategory.quotPowTriangle X.smallEtaleTopology hϖ rfl n
  let TY := _root_.DerivedCategory.quotPowTriangle Y.smallEtaleTopology hϖ rfl n
  have h₁ : Φ.mapTriangle.obj (FX.mapTriangle.obj TX) ∈ distTriang _ :=
    Φ.map_distinguished _ (FX.map_distinguished _
      (_root_.DerivedCategory.quotPowTriangle_distinguished _ hϖ rfl n))
  have h₂ : FY.mapTriangle.obj TY ∈ distTriang _ :=
    FY.map_distinguished _ (_root_.DerivedCategory.quotPowTriangle_distinguished _ hϖ rfl n)
  have hX : (Φ.mapTriangle.obj (FX.mapTriangle.obj TX)).mor₁ =
      ϖ ^ n • 𝟙 (Φ.obj (FX.obj TX.obj₁)) := by
    change Φ.map (FX.map TX.mor₁) = _
    rw [_root_.DerivedCategory.quotPowTriangle_mor₁, Functor.map_smul,
      CategoryTheory.Functor.map_id, Functor.map_smul, CategoryTheory.Functor.map_id]
  have hY : (FY.mapTriangle.obj TY).mor₁ = ϖ ^ n • 𝟙 (FY.obj TY.obj₁) := by
    change FY.map TY.mor₁ = _
    rw [_root_.DerivedCategory.quotPowTriangle_mor₁, Functor.map_smul,
      CategoryTheory.Functor.map_id]
  let u : Φ.obj (FX.obj TX.obj₁) ≅ FY.obj TY.obj₁ :=
    Φ.mapIso (derivedTensorSingleUnitIso K) ≪≫ (derivedTensorSingleUnitIso (Φ.obj K)).symm
  obtain ⟨e, -, -⟩ := Pretriangulated.exists_iso_of_arrow_iso _ _ h₁ h₂
    (Arrow.isoMk u u (by
      change u.hom ≫ (FY.mapTriangle.obj TY).mor₁ =
        (Φ.mapTriangle.obj (FX.mapTriangle.obj TX)).mor₁ ≫ u.hom
      rw [hX, hY, Linear.comp_smul, Category.comp_id]
      erw [Linear.smul_comp, Category.id_comp]))
  exact ⟨Pretriangulated.Triangle.π₃.mapIso e⟩

/-- The internal hom commutes with reduction modulo a power of a nonzerodivisor in its second
variable: `RHom(K, L) ⊗ᴸ Λ ⧸ (ϖⁿ) ≅ RHom(K, L ⊗ᴸ Λ ⧸ (ϖⁿ))`, `RHom(K, -)` being a triangulated
`Λ`-linear functor (the right adjoint of `K ⊗ᴸ -`). -/
theorem nonempty_iso_reductionModIdeal_derivedHom_obj {X : Scheme.{u}} {ϖ : Λ}
    (hϖ : ϖ ∈ nonZeroDivisors Λ) (n : ℕ) (K L : 𝐃(X, Λ)) :
    Nonempty ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ n)).obj
        (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) ≅
      ((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ n)).obj L)) := by
  let adj := derivedTensorHomAdjunction (ModuleCat.{u + 1} Λ) K
  let := adj.rightAdjointCommShift ℤ
  have := adj.commShift_of_leftAdjoint ℤ
  have := adj.isTriangulated_rightAdjoint
  have := adj.right_adjoint_linear (R := Λ)
  obtain ⟨e⟩ := nonempty_iso_map_reductionModIdeal
    ((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)) hϖ n L
  exact ⟨e.symm⟩

end Reduction

section HomReduction

variable {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ) (hI : I = Ideal.span {ϖ}) {X : Scheme.{u}}

include hϖ hI in
/-- Blueprint `lem-coef-integral-hom-reduction`: Integral internal Hom and reduction.

Let `I = (ϖ)` be generated by a nonzerodivisor of `Λ` and `A_n = Λ ⧸ Iⁿ`. For arbitrary
complexes `K, L` of étale `Λ`-sheaves with derived reductions `K_n, L_n ∈ D(X_ét, A_n)`, there
is an isomorphism `RHom_Λ(K, L) ⊗ᴸ_Λ A_n ≅ RHom_{A_n}(K_n, L_n)`, read after restriction of
scalars to `Λ`. No perfectness assumption on `K` is imposed. -/
theorem nonempty_iso_reductionModIdeal_derivedHom (n : ℕ) {K L : 𝐃(X, Λ)}
    {Kn Ln : 𝐃(X, Λ ⧸ I ^ n)}
    {η : K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj Kn}
    {η' : L ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj Ln}
    (hη : IsDerivedBaseChange η) (hη' : IsDerivedBaseChange η') :
    Nonempty ((reductionModIdeal Λ X (I ^ n)).obj
        (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) ≅
      (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj
        (((derivedHom (ModuleCat.{u + 1} (Λ ⧸ I ^ n)) X).obj (op Kn)).obj Ln)) := by
  subst hI
  have hφ : Function.Surjective (Ideal.Quotient.mk (Ideal.span {ϖ} ^ n)) :=
    Ideal.Quotient.mk_surjective
  have ha : RingHom.ker (Ideal.Quotient.mk (Ideal.span {ϖ} ^ n)) = Ideal.span {ϖ ^ n} := by
    rw [Ideal.mk_ker, Ideal.span_singleton_pow]
  obtain ⟨e₁⟩ := nonempty_iso_reductionModIdeal_derivedHom_obj hϖ n K L
  obtain ⟨e₂⟩ := nonempty_iso_derivedHom_derivedTensor_of_isDerivedBaseChange
    (Λ' := Λ ⧸ Ideal.span {ϖ} ^ n) hφ ha X hη hη'
  let q := (constantSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).mapIso
    (Ideal.quotientEquivAlgOfEq Λ
      (Ideal.mk_ker (I := Ideal.span {ϖ} ^ n))).toLinearEquiv.toModuleIso
  exact ⟨e₁ ≪≫ ((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).mapIso
    (((derivedTensor (ModuleCat.{u + 1} Λ) X).obj L).mapIso
      ((_root_.DerivedCategory.singleFunctor _ 0).mapIso q)).symm ≪≫ e₂⟩

include hϖ hI in
/-- Blueprint `lem-coef-integral-hom-reduction`: Integral internal Hom and reduction.

If `L` is derived complete for `I = (ϖ)`, then so is `RHom_Λ(K, L)`, for every `K`. -/
theorem derivedComplete_derivedHom {K L : 𝐃(X, Λ)}
    (hL : DerivedCategory.derivedComplete X.smallEtaleTopology I L) :
    DerivedCategory.derivedComplete X.smallEtaleTopology I
      (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) := by
  rw [DerivedCategory.derivedComplete_iff_rightOrthogonal hϖ hI] at hL ⊢
  intro Z φ (hZ : IsIso (ϖ • 𝟙 Z))
  let adj := derivedTensorHomAdjunction (ModuleCat.{u + 1} Λ) K
  have hZ' : DerivedCategory.smulInvertible X.smallEtaleTopology ϖ
      (((derivedTensor (ModuleCat.{u + 1} Λ) X).obj K).obj Z) := by
    change IsIso (ϖ • 𝟙 _)
    rw [← ((derivedTensor (ModuleCat.{u + 1} Λ) X).obj K).map_id, ← Functor.map_smul]
    infer_instance
  rw [← (adj.homEquiv Z L).apply_symm_apply φ, hL ((adj.homEquiv Z L).symm φ) hZ',
    Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]

end HomReduction

/-- The exceptional inverse image `Rf^!` is triangulated, being right adjoint to the triangulated
`Rf_!`. -/
lemma isTriangulated_rightDerivedUpperShriek {X Y : Scheme.{u}} (f : X ⟶ Y)
    [HasCompactification f] [(R(f)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] :
    (R(f)^![ModuleCat.{u + 1} Λ]).IsTriangulated :=
  have := (rightDerivedUpperShriekAdjunction (ModuleCat.{u + 1} Λ) f).commShift_of_leftAdjoint ℤ
  (rightDerivedUpperShriekAdjunction _ f).isTriangulated_rightAdjoint

/-- The exceptional inverse image `Rf^!` commutes with derived limits of reductions: for a
derived complete `L ∈ D(Y_ét, Λ)` and a homotopy limit cone `c` of the tower
`n ↦ Rf^!(L ⊗ᴸ Λ ⧸ Iⁿ)`, there is an isomorphism `Rf^! L ≅ c.pt` compatible with the legs.
Indeed `Rf^!` is a triangulated right adjoint, so it carries the Milnor triangle exhibiting
`L = R lim_n L ⊗ᴸ Λ ⧸ Iⁿ` to a Milnor triangle. -/
theorem exists_iso_rightDerivedUpperShriek {X Y : Scheme.{u}} (f : X ⟶ Y)
    [HasCompactification f] [(R(f)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] {L : 𝐃(Y, Λ)}
    (hL : DerivedCategory.derivedComplete Y.smallEtaleTopology I L)
    {c : Cone (DerivedCategory.derivedCompletionDiagram Y.smallEtaleTopology I L ⋙
      R(f)^![ModuleCat.{u + 1} Λ])} (hc : Pretriangulated.IsHomotopyLimit c) :
    ∃ e : (R(f)^![ModuleCat.{u + 1} Λ]).obj L ≅ c.pt, ∀ n : ℕ,
      e.hom ≫ c.π.app (op n) = (R(f)^![ModuleCat.{u + 1} Λ]).map
        ((DerivedCategory.derivedCompletionCone Y.smallEtaleTopology I L).π.app (op n)) := by
  let adj := rightDerivedUpperShriekAdjunction (ModuleCat.{u + 1} Λ) f
  have := adj.commShift_of_leftAdjoint ℤ
  have : (R(f)^![ModuleCat.{u + 1} Λ]).IsTriangulated := adj.isTriangulated_rightAdjoint
  have : (R(f)^![ModuleCat.{u + 1} Λ]).Additive := adj.right_adjoint_additive
  exact (hL.map (R(f)^![ModuleCat.{u + 1} Λ])).exists_iso hc

/-- An element of `J` kills the reduction `K ⊗ᴸ (Λ ⧸ J)_X`. -/
lemma smul_id_reductionModIdeal_obj_eq_zero {X : Scheme.{u}} {J : Ideal Λ} {r : Λ} (hr : r ∈ J)
    (K : 𝐃(X, Λ)) :
    r • 𝟙 ((reductionModIdeal Λ X J).obj K) = 0 := by
  have hM : r • 𝟙 (ModuleCat.of Λ (Λ ⧸ J)) = 0 := by
    refine ModuleCat.hom_ext (LinearMap.ext fun x ↦ ?_)
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp only [ModuleCat.hom_smul, ModuleCat.hom_id, LinearMap.smul_apply, LinearMap.id_coe,
      id_eq, ModuleCat.hom_zero, LinearMap.zero_apply]
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul (Ideal.Quotient.mk J),
      Ideal.Quotient.eq_zero_iff_mem]
    exact J.mul_mem_right _ hr
  change r • 𝟙 (((derivedTensor (ModuleCat.{u + 1} Λ) X).obj K).obj _) = 0
  rw [← CategoryTheory.Functor.map_id, ← Functor.map_smul,
    ← (_root_.DerivedCategory.singleFunctor _ 0).map_id, ← Functor.map_smul,
    ← (constantSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).map_id, ← Functor.map_smul, hM,
    Functor.map_zero, Functor.map_zero, Functor.map_zero]

/-- The short complex `Λ ⧸ (ϖ) ⟶ Λ ⧸ (ϖ)ᵐ⁺¹ ⟶ Λ ⧸ (ϖ)ᵐ`: multiplication by `ϖᵐ`, then the
projection. -/
noncomputable def quotSpanPowSuccShortComplex (ϖ : Λ) (m : ℕ) :
    ShortComplex (ModuleCat.{u + 1} Λ) :=
  ShortComplex.mk
    (ModuleCat.ofHom ((Ideal.span {ϖ} ^ 1).liftQ
      ((Ideal.span {ϖ} ^ (m + 1)).mkQ ∘ₗ (ϖ ^ m • LinearMap.id)) (by
        intro x hx
        rw [Ideal.span_singleton_pow] at hx
        obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hx
        rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.smul_apply, LinearMap.id_apply,
          Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Ideal.span_singleton_pow,
          Ideal.mem_span_singleton']
        exact ⟨y, by rw [smul_eq_mul, pow_one, pow_succ]; ring⟩)))
    (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ m))))
    (by
      refine ModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext fun y ↦ ?_))
      refine (Submodule.Quotient.mk_eq_zero _).2 ?_
      change ϖ ^ m * y ∈ _
      exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self ϖ) m))

lemma quotSpanPowSuccShortComplex_shortExact {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ) (m : ℕ) :
    (quotSpanPowSuccShortComplex ϖ m).ShortExact := by
  refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
  · intro y
    constructor
    · intro hy
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ y
      have hz : z ∈ Ideal.span {ϖ} ^ m := (Submodule.Quotient.mk_eq_zero _).1 hy
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hz
      obtain ⟨w, rfl⟩ := hz
      exact ⟨Submodule.Quotient.mk w, congrArg Submodule.Quotient.mk (by
        change ϖ ^ m * w = w * ϖ ^ m
        ring)⟩
    · rintro ⟨x, rfl⟩
      have := ConcreteCategory.congr_hom (quotSpanPowSuccShortComplex ϖ m).zero x
      simp at this ⊢
  · intro x y h
    obtain ⟨w, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    obtain ⟨w', rfl⟩ := Submodule.Quotient.mk_surjective _ y
    have h' : Submodule.Quotient.mk (p := Ideal.span {ϖ} ^ (m + 1)) (ϖ ^ m * w) =
        Submodule.Quotient.mk (ϖ ^ m * w') := h
    rw [Submodule.Quotient.eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h'
    obtain ⟨v, hv⟩ := h'
    rw [Submodule.Quotient.eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    refine ⟨v, sub_eq_zero.1 ((mem_nonZeroDivisors_iff.1 (pow_mem hϖ m)).1 _ ?_)⟩
    linear_combination hv
  · intro x
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    exact ⟨Submodule.Quotient.mk y, rfl⟩

section Constructible

variable [IsDomain Λ] [IsNoetherianRing Λ] [IsAdicComplete I Λ] [Finite (Λ ⧸ I)]
  {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ) (hI : I = Ideal.span {ϖ})
  {k : Type u} [Field k] [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))]

include hϖ hI in
/-- Blueprint `cor-coef-integral-internal-hom`: Integral constructible internal Hom.

Let `Λ` be a Noetherian domain, complete for `I = (ϖ)` with `Λ ⧸ I` finite of exponent
invertible on `k` (the integral stage `Λ = 𝒪_E`), and let `X` be of finite type over `k`. For
`K, L ∈ Dᵇc(X, Λ)`, the internal hom `RHom_Λ(K, L)` lies in `Dᵇc(X, Λ)`; its reductions are
the finite internal homs `RHom_{A_n}(K_n, L_n)`; and if the reductions of `K` and `L` have Tor
amplitude in `[a, b]` and `[c, e]` (measured as in
`AlgebraicGeometry.Etale.DerivedCategory.boundedConstructibleIntegral`) and `dim X ≤ d`, the
reductions of `RHom_Λ(K, L)` have Tor amplitude in `[c - b - 2d, e - a + 2d]`. -/
theorem boundedConstructibleIntegral_derivedHom {X : Scheme.{u}} (aX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType aX] [QuasiCompact aX] {K L : 𝐃(X, Λ)}
    (hK : DerivedCategory.boundedConstructibleIntegral I X K)
    (hL : DerivedCategory.boundedConstructibleIntegral I X L) :
    DerivedCategory.boundedConstructibleIntegral I X
        (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) ∧
      (∀ (n : ℕ) (Kn Ln : 𝐃(X, Λ ⧸ I ^ n))
        (η : K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj Kn)
        (η' : L ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj Ln),
        IsDerivedBaseChange η → IsDerivedBaseChange η' →
          Nonempty ((reductionModIdeal Λ X (I ^ n)).obj
              (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) ≅
            (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj
              (((derivedHom (ModuleCat.{u + 1} (Λ ⧸ I ^ n)) X).obj (op Kn)).obj Ln))) ∧
      ∀ d : ℕ, topologicalKrullDim X ≤ (d : WithBot ℕ∞) → ∀ a b c e : ℤ,
        (∀ n : ℕ, DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X a b
          ((reductionModIdeal Λ X (I ^ (n + 1))).obj K)) →
        (∀ n : ℕ, DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X c e
          ((reductionModIdeal Λ X (I ^ (n + 1))).obj L)) →
        ∀ n : ℕ, DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X
          (c - b - 2 * (d : ℤ)) (e - a + 2 * (d : ℤ))
          ((reductionModIdeal Λ X (I ^ (n + 1))).obj
            (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L)) :=
  ⟨⟨derivedComplete_derivedHom I hϖ hI hL.1, sorry⟩,
    fun n _ _ _ _ hη hη' ↦ nonempty_iso_reductionModIdeal_derivedHom I hϖ hI n hη hη', sorry⟩

omit [IsDomain Λ] [Finite (Λ ⧸ I)] in
include hϖ in
/-- If the reduction modulo `(ϖ)` of `M` is bounded constructible of Tor amplitude in `[a, b]`,
so are all its reductions modulo `(ϖ)ⁿ⁺¹`: the reductions sit in distinguished triangles
`M ⊗ᴸ Λ ⧸ (ϖ) ⟶ M ⊗ᴸ Λ ⧸ (ϖ)ⁿ⁺² ⟶ M ⊗ᴸ Λ ⧸ (ϖ)ⁿ⁺¹ ⟶`. -/
theorem boundedConstructible_and_torAmplitudeIn_reductionModIdeal_of_one
    [Finite (Λ ⧸ Ideal.span {ϖ})] {X : Scheme.{u}} {a b : ℤ} {M : 𝐃(X, Λ)}
    (h : DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) X
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ 1)).obj M) ∧
      DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X a b
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ 1)).obj M)) (n : ℕ) :
    DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) X
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ (n + 1))).obj M) ∧
      DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X a b
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ (n + 1))).obj M) := by
  induction n with
  | zero => exact h
  | succ n ih =>
    let FM := (derivedTensor (ModuleCat.{u + 1} Λ) X).obj M
    have hS := (quotSpanPowSuccShortComplex_shortExact hϖ (n + 1)).map_of_exact
      (constantSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))
    have hT := FM.map_distinguished _ hS.singleTriangle_distinguished
    have : Finite (Λ ⧸ Ideal.span {ϖ} ^ (n + 1 + 1)) :=
      Ideal.finite_quotient_pow ⟨{ϖ}, by simp⟩ _
    exact ⟨DerivedCategory.boundedConstructible_obj₂_of_smul_eq_zero
        (J := Ideal.span {ϖ} ^ (n + 1 + 1)) hT h.1 ih.1
        fun r hr ↦ smul_id_reductionModIdeal_obj_eq_zero hr M,
      torAmplitudeIn_obj₂_of_distTriang_of_sheaf hT h.2 ih.2⟩

include hϖ hI in
/-- Blueprint `det-sfb-coefficient-comparisons-exceptional`: Coefficient comparison for `f^!`,
for the coefficient map `Λ ⟶ A_n = Λ ⧸ Iⁿ` from the integral stage to a finite stage.

For `L ∈ Dᵇc(Y, Λ)` and a derived base change `L_n = L ⊗ᴸ_Λ A_n ∈ D(Y_ét, A_n)`, the exceptional
inverse image commutes with the coefficient change:
`(Rf^! L) ⊗ᴸ_Λ A_n ≅ Rf_n^! L_n`, read after restriction of scalars to `Λ`.

This is a known weakening of the blueprint node: the blueprint asserts that the specific
transposed comparison map `β_{f,K}` is an isomorphism, compatibly with composition and with
restriction to opens; here only the existence of some isomorphism is stated. -/
theorem nonempty_iso_reductionModIdeal_rightDerivedUpperShriek {X Y : Scheme.{u}}
    (aY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType aY] [QuasiCompact aY] (f : X ⟶ Y)
    [QuasiCompact f] [HasCompactification f] [(R(f)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint]
    (n : ℕ) [(R(f)_![ModuleCat.{u + 1} (Λ ⧸ I ^ n)]).IsLeftAdjoint] {L : 𝐃(Y, Λ)}
    (hL : DerivedCategory.boundedConstructibleIntegral I Y L) {Ln : 𝐃(Y, Λ ⧸ I ^ n)}
    {η : L ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) Y).obj Ln}
    (hη : IsDerivedBaseChange η) :
    Nonempty ((reductionModIdeal Λ X (I ^ n)).obj ((R(f)^![ModuleCat.{u + 1} Λ]).obj L) ≅
      (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj
        ((R(f)^![ModuleCat.{u + 1} (Λ ⧸ I ^ n)]).obj Ln)) :=
  sorry

omit [IsAdicComplete I Λ] [Finite (Λ ⧸ I)] in
include hϖ in
/-- The first finite stage of the integral exceptional inverse image: for `L ∈ Dᵇc(Y, Λ)` whose
reduction modulo `(ϖ)` has Tor amplitude in `[a, b]` over `Λ`, its derived base change
`L₁ = L ⊗ᴸ_Λ Λ ⧸ (ϖ)` is bounded constructible of Tor amplitude in `[a + 1, b]` over `Λ ⧸ (ϖ)`,
and `(Rf^! L) ⊗ᴸ Λ ⧸ (ϖ) ≅ Res Rf_1^! L₁`. -/
theorem exists_reductionModIdeal_one_rightDerivedUpperShriek [IsAdicComplete (Ideal.span {ϖ}) Λ]
    [Finite (Λ ⧸ Ideal.span {ϖ})] [Finite (Λ ⧸ Ideal.span {ϖ} ^ 1)]
    [HasInvertibleExponent (Λ ⧸ Ideal.span {ϖ}) (Spec (.of k))] {X Y : Scheme.{u}}
    (aY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType aY] [QuasiCompact aY] (f : X ⟶ Y)
    [QuasiCompact f] [HasCompactification f] [(R(f)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint]
    {L : 𝐃(Y, Λ)} (hL : DerivedCategory.boundedConstructibleIntegral (Ideal.span {ϖ}) Y L)
    {a b : ℤ} (hab : DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) Y
        ((reductionModIdeal Λ Y (Ideal.span {ϖ} ^ 1)).obj L) ∧
      DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) Y a b
        ((reductionModIdeal Λ Y (Ideal.span {ϖ} ^ 1)).obj L)) :
    ∃ L₁ : 𝐃(Y, Λ ⧸ Ideal.span {ϖ} ^ 1),
      DerivedCategory.boundedConstructible (ModuleCat.{u + 1} (Λ ⧸ Ideal.span {ϖ} ^ 1)) Y L₁ ∧
      DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} (Λ ⧸ Ideal.span {ϖ} ^ 1)) Y (a + 1) b
        L₁ ∧
      Nonempty ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ 1)).obj
          ((R(f)^![ModuleCat.{u + 1} Λ]).obj L) ≅
        (derivedRestrictScalars (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) X).obj
          ((R(f)^![ModuleCat.{u + 1} (Λ ⧸ Ideal.span {ϖ} ^ 1)]).obj L₁)) := by
  have hk : RingHom.ker (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) = Ideal.span {ϖ ^ 1} := by
    rw [Ideal.mk_ker, Ideal.span_singleton_pow]
  have hsurj : Function.Surjective (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) :=
    Ideal.Quotient.mk_surjective
  have ha' : ϖ ^ 1 ∈ nonZeroDivisors Λ := pow_mem hϖ 1
  let L₁ := (derivedExtendScalars hsurj hk Y).obj L
  obtain ⟨s⟩ := nonempty_iso_reductionModIdeal_rightDerivedUpperShriek (Ideal.span {ϖ}) hϖ rfl
    aY f 1 hL (isDerivedBaseChange_derivedExtendScalarsAdjunction_unit hsurj hk Y L)
  obtain ⟨r⟩ := nonempty_iso_derivedRestrictScalars_derivedExtendScalars hsurj hk Y L
  have hbc : DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) Y
      (((derivedTensor (ModuleCat.{u + 1} Λ) Y).obj L).obj
        (quotientSingle (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) Y)) := by
    rw [quotientSingle, Ideal.mk_ker]
    exact hab.1
  have ht : DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) Y a b
      (((derivedTensor (ModuleCat.{u + 1} Λ) Y).obj L).obj
        (quotientSingle (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) Y)) := by
    rw [quotientSingle, Ideal.mk_ker]
    exact hab.2
  exact ⟨L₁, (boundedConstructible_derivedRestrictScalars_iff _ L₁).1
      ((DerivedCategory.boundedConstructible _ Y).prop_of_iso r.symm hbc),
    torAmplitudeIn_derivedExtendScalars hsurj hk ha' ht, ⟨s⟩⟩

include hϖ hI in
/-- Blueprint `prop-coef-integral-exceptional-adjoint`: The integral exceptional adjoint on
constructible complexes.

For a separated finite-type `f : X ⟶ Y` of finite-type `k`-schemes and `L ∈ Dᵇc(Y, Λ)`, put
`G_f L = R lim_n Res_n Rf_n^! L_n`, the derived limit of the finite exceptional inverse images of
the reductions of `L`. As restriction of scalars commutes with `Rf^!`,
`Res_n Rf_n^! L_n = Rf^!(L ⊗ᴸ A_n)`, so `G_f L` is the point of a homotopy limit cone `c` of the
tower `n ↦ Rf^!(L ⊗ᴸ Λ ⧸ Iⁿ)`. Likewise the integral dualizing complex
`ω_{X,Λ} = R lim_n Res_n Ra_n^! A_n` is the point of a homotopy limit cone `ωX` of the tower
`n ↦ Ra_X^!(Λ ⧸ Iⁿ)`, the integral Verdier dual is `𝔻_{X,Λ} = RHom(-, ω_{X,Λ})`, and similarly
on `Y`. Then:

1. `G_f L ∈ Dᵇc(X, Λ)`, and `(G_f L) ⊗ᴸ A_n ≅ Rf^!(L ⊗ᴸ A_n)`;
2. `G_f` is right adjoint to the integral `Rf_!` on the constructible categories, with the
   canonical unit and counit: `G_f L` is identified with `Rf^! L` compatibly with the maps to the
   `Rf^!(L ⊗ᴸ A_n)` (`AlgebraicGeometry.Etale.exists_iso_rightDerivedUpperShriek`), so that the
   adjunction is `AlgebraicGeometry.Etale.rightDerivedUpperShriekAdjunction` transported along
   this isomorphism;
3. `G_f L ≅ 𝔻_{X,Λ} f^*_comp 𝔻_{Y,Λ} L`, where the completed pullback `f^*_comp M` is the
   derived complete object `N` receiving a map from `Lf^* M` inducing isomorphisms on all
   reductions;
4. if `k` is algebraically closed and the reductions of `L` have Tor amplitude in `[a, b]`,
   those of `G_f L` have Tor amplitude
   in `[a - 2 dim X, b + 2 dim Y]`. -/
theorem boundedConstructibleIntegral_exceptionalAdjoint {X Y : Scheme.{u}}
    (aX : X ⟶ Spec (.of k)) (aY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX]
    [LocallyOfFiniteType aY] [QuasiCompact aY] [IsSeparated aX] [IsSeparated aY]
    [HasCompactification aX] [HasCompactification aY]
    [(R(aX)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] [(R(aY)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint]
    (f : X ⟶ Y) (hf : f ≫ aY = aX) [QuasiCompact f] [HasCompactification f]
    [(R(f)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] {L : 𝐃(Y, Λ)}
    (hL : DerivedCategory.boundedConstructibleIntegral I Y L)
    {c : Cone (DerivedCategory.derivedCompletionDiagram Y.smallEtaleTopology I L ⋙
      R(f)^![ModuleCat.{u + 1} Λ])} (hc : Pretriangulated.IsHomotopyLimit c) :
    (DerivedCategory.boundedConstructibleIntegral I X c.pt ∧
      ∀ n : ℕ, Nonempty ((reductionModIdeal Λ X (I ^ n)).obj c.pt ≅
        (R(f)^![ModuleCat.{u + 1} Λ]).obj ((reductionModIdeal Λ Y (I ^ n)).obj L))) ∧
    (∃ e : (R(f)^![ModuleCat.{u + 1} Λ]).obj L ≅ c.pt, ∀ n : ℕ,
      e.hom ≫ c.π.app (op n) = (R(f)^![ModuleCat.{u + 1} Λ]).map
        ((DerivedCategory.derivedCompletionCone Y.smallEtaleTopology I L).π.app (op n))) ∧
    (∀ (ωX : Cone (DerivedCategory.quotPowFunctor (Spec (.of k)).smallEtaleTopology I ⋙
        R(aX)^![ModuleCat.{u + 1} Λ])) (_ : Pretriangulated.IsHomotopyLimit ωX)
      (ωY : Cone (DerivedCategory.quotPowFunctor (Spec (.of k)).smallEtaleTopology I ⋙
        R(aY)^![ModuleCat.{u + 1} Λ])) (_ : Pretriangulated.IsHomotopyLimit ωY)
      (N : 𝐃(X, Λ)) (φ : (L((f)^*[ModuleCat.{u + 1} Λ])).obj
        (((derivedHom (ModuleCat.{u + 1} Λ) Y).obj (op L)).obj ωY.pt) ⟶ N),
      DerivedCategory.derivedComplete X.smallEtaleTopology I N →
        (∀ n : ℕ, IsIso ((reductionModIdeal Λ X (I ^ n)).map φ)) →
          Nonempty (c.pt ≅ ((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op N)).obj ωX.pt)) ∧
    ∀ dX dY : ℕ, topologicalKrullDim X ≤ (dX : WithBot ℕ∞) →
      topologicalKrullDim Y ≤ (dY : WithBot ℕ∞) → ∀ a b : ℤ,
        (∀ n : ℕ, DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) Y a b
          ((reductionModIdeal Λ Y (I ^ (n + 1))).obj L)) →
        ∀ n : ℕ, DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X
          (a - 2 * (dX : ℤ)) (b + 2 * (dY : ℤ))
          ((reductionModIdeal Λ X (I ^ (n + 1))).obj c.pt) := by
  subst hI
  obtain ⟨e, he⟩ := exists_iso_rightDerivedUpperShriek _ f hL.1 hc
  -- `c.pt ≅ Rf^! L` is derived complete, `Rf^!` being right adjoint to the linear `Rf_!`
  have hcpt : DerivedCategory.derivedComplete X.smallEtaleTopology (Ideal.span {ϖ}) c.pt := by
    rw [DerivedCategory.derivedComplete_iff_rightOrthogonal hϖ rfl]
    intro Z g (hZ : IsIso (ϖ • 𝟙 Z))
    let adj := rightDerivedUpperShriekAdjunction (ModuleCat.{u + 1} Λ) f
    have hZ' : DerivedCategory.smulInvertible Y.smallEtaleTopology ϖ
        ((R(f)_![ModuleCat.{u + 1} Λ]).obj Z) := by
      change IsIso (ϖ • 𝟙 _)
      rw [← (R(f)_![ModuleCat.{u + 1} Λ]).map_id, ← Functor.map_smul]
      infer_instance
    have hL' := (DerivedCategory.derivedComplete_iff_rightOrthogonal hϖ rfl L).1 hL.1
    have h₀ : g ≫ e.inv = 0 := by
      rw [← (adj.homEquiv Z L).apply_symm_apply (g ≫ e.inv),
        hL' ((adj.homEquiv Z L).symm (g ≫ e.inv)) hZ',
        Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]
    rw [← Category.comp_id g, ← e.inv_hom_id, ← Category.assoc, h₀, zero_comp]
  -- the first finite stage `Λ ⧸ (ϖ)`
  have : Finite (Λ ⧸ Ideal.span {ϖ} ^ 1) := by rw [pow_one]; infer_instance
  have : HasInvertibleExponent (Λ ⧸ Ideal.span {ϖ} ^ 1) (Spec (.of k)) := by
    rw [pow_one]; infer_instance
  have : HasInvertibleExponent (Λ ⧸ Ideal.span {ϖ} ^ 1) Y := .of_hom aY
  have hk : RingHom.ker (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) = Ideal.span {ϖ ^ 1} := by
    rw [Ideal.mk_ker, Ideal.span_singleton_pow]
  have hsurj : Function.Surjective (Ideal.Quotient.mk (Ideal.span {ϖ} ^ 1)) :=
    Ideal.Quotient.mk_surjective
  have ha' : ϖ ^ 1 ∈ nonZeroDivisors Λ := pow_mem hϖ 1
  obtain ⟨a, b, hab⟩ := hL.2
  obtain ⟨L₁, hb₁, ht₁, ⟨s⟩⟩ := exists_reductionModIdeal_one_rightDerivedUpperShriek hϖ aY f hL
    (hab 0)
  obtain ⟨hNbc, a', b', hNt⟩ := constructibleFiniteTor_rightDerivedUpperShriek
    (Λ ⧸ Ideal.span {ϖ} ^ 1) aY f ⟨hb₁, a + 1, b, ht₁⟩
  have h₁ : DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) X
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ 1)).obj ((R(f)^![ModuleCat.{u + 1} Λ]).obj L)) ∧
      DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X (a' - 1) b'
        ((reductionModIdeal Λ X (Ideal.span {ϖ} ^ 1)).obj ((R(f)^![ModuleCat.{u + 1} Λ]).obj L)) :=
    ⟨(DerivedCategory.boundedConstructible _ X).prop_of_iso s.symm
      ((boundedConstructible_derivedRestrictScalars_iff _ _).2 hNbc),
      (DerivedCategory.torAmplitudeIn _ X _ _).prop_of_iso s.symm
        (torAmplitudeIn_derivedRestrictScalars hsurj hk ha' hNt)⟩
  have hall := boundedConstructible_and_torAmplitudeIn_reductionModIdeal_of_one hϖ h₁
  refine ⟨⟨⟨hcpt, a' - 1, b', fun n ↦
    ⟨(DerivedCategory.boundedConstructible _ X).prop_of_iso
        ((reductionModIdeal Λ X _).mapIso e) (hall n).1,
      (DerivedCategory.torAmplitudeIn _ X _ _).prop_of_iso
        ((reductionModIdeal Λ X _).mapIso e) (hall n).2⟩⟩, fun n ↦ ?_⟩, ⟨e, he⟩, sorry, ?_⟩
  · have := isTriangulated_rightDerivedUpperShriek (Λ := Λ) f
    obtain ⟨e'⟩ := nonempty_iso_map_reductionModIdeal (R(f)^![ModuleCat.{u + 1} Λ]) hϖ n L
    exact ⟨(reductionModIdeal Λ X _).mapIso e.symm ≪≫ e'.symm⟩
  · intro dX dY hdX hdY a₀ b₀ hab₀ n
    -- the Tor amplitude bound of the finite stages is available over algebraically closed `k`
    by_cases hkc : IsAlgClosed k
    swap
    · sorry
    subst hf
    obtain ⟨L₁, hb₁, ht₁, ⟨s⟩⟩ := exists_reductionModIdeal_one_rightDerivedUpperShriek hϖ aY f hL
      ⟨(hab 0).1, hab₀ 0⟩
    have hE := constructibleFiniteTor_and_torAmplitudeIn_rightDerivedUpperShriek
      (Λ ⧸ Ideal.span {ϖ} ^ 1) aY f dX dY hdX hdY (a₀ + 1) b₀ hb₁ ht₁
    have ht := torAmplitudeIn_derivedRestrictScalars hsurj hk ha' hE.2
    have heq : a₀ + 1 - 2 * (dX : ℤ) - 1 = a₀ - 2 * (dX : ℤ) := by ring
    rw [heq] at ht
    exact (DerivedCategory.torAmplitudeIn _ X _ _).prop_of_iso
      ((reductionModIdeal Λ X _).mapIso e)
      (boundedConstructible_and_torAmplitudeIn_reductionModIdeal_of_one hϖ
        ⟨h₁.1, (DerivedCategory.torAmplitudeIn _ X _ _).prop_of_iso s.symm ht⟩ n).2

end Constructible

section Tower

/-- The quotient map `Λ ⧸ Iⁿ⁺² →+* Λ ⧸ Iⁿ⁺¹`. -/
noncomputable abbrev quotientPowSuccFactor (n : ℕ) : Λ ⧸ I ^ (n + 2) →+* Λ ⧸ I ^ (n + 1) :=
  Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ (n + 1)))

/-- Blueprint `def-coef-normalized-dvr-tower`: A normalized DVR tower.

A normalized tower on `X` consists of complexes `M_n ∈ D(X_ét, A_n)`, `A_n = Λ ⧸ Iⁿ⁺¹`, with
transition maps `M_{n+1} ⟶ Res M_n` whose adjoints `M_{n+1} ⊗ᴸ_{A_{n+1}} A_n ⟶ M_n` are
isomorphisms: each transition map exhibits `M_n` as the derived base change of `M_{n+1}`
(`AlgebraicGeometry.Etale.IsDerivedBaseChange`). The transition maps between arbitrary levels
are the composites of the consecutive ones, so they satisfy the quotient cocycle. No
constructibility or common stratification is part of the definition.

The blueprint places normalized towers on the pro-étale site; this is the small étale version.
The pro-étale version, with its derived limit, is `AlgebraicGeometry.ProEtale.IsNormalizedTower`
and `AlgebraicGeometry.ProEtale.exists_derivedCompletionDiagram_iso`. -/
structure NormalizedTower (X : Scheme.{u}) where
  /-- The complex `M_n ∈ D(X_ét, Λ ⧸ Iⁿ⁺¹)`. -/
  obj (n : ℕ) : 𝐃(X, Λ ⧸ I ^ (n + 1))
  /-- The transition map `M_{n+1} ⟶ Res M_n`. -/
  map (n : ℕ) : obj (n + 1) ⟶ (derivedRestrictScalars (quotientPowSuccFactor I n) X).obj (obj n)
  /-- The adjoint `M_{n+1} ⊗ᴸ A_n ⟶ M_n` of the transition map is an isomorphism. -/
  isDerivedBaseChange (n : ℕ) : IsDerivedBaseChange (map n)

variable {I} {X : Scheme.{u}}

/-- Restricting scalars to `Λ ⧸ Iⁿ⁺²` and then to `Λ` is restricting scalars to `Λ`. -/
noncomputable def derivedRestrictScalarsQuotientPowSuccIso (n : ℕ) :
    derivedRestrictScalars (quotientPowSuccFactor I n) X ⋙
        derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 2))) X ≅
      derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X :=
  (Functor.mapDerivedCategoryCompIso _ _).symm ≪≫
    Functor.mapDerivedCategoryNatIso
      (Sheaf.restrictScalarsCompIso X.smallEtaleTopology _ _ _ (by ext; rfl))

/-- The tower `n ↦ Res M_n` in `D(X_ét, Λ)` of the restrictions of scalars of a normalized
tower, with the restricted transition maps. -/
noncomputable def NormalizedTower.restrict (M : NormalizedTower I X) : ℕᵒᵖ ⥤ 𝐃(X, Λ) :=
  Functor.ofOpSequence fun n ↦
    (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 2))) X).map (M.map n) ≫
      (derivedRestrictScalarsQuotientPowSuccIso n).hom.app (M.obj n)

/-- The transition map `K_{n+1} ⟶ Res K_n` of the tower of derived reductions of `K`: the map
adjoint to `η_n`. -/
lemma exists_transition_of_isDerivedBaseChange {K : 𝐃(X, Λ)}
    (Kn : ∀ n : ℕ, 𝐃(X, Λ ⧸ I ^ (n + 1)))
    (η : ∀ n : ℕ, K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X).obj (Kn n))
    (hη : ∀ n : ℕ, IsDerivedBaseChange (η n)) (n : ℕ) :
    ∃ t : Kn (n + 1) ⟶ (derivedRestrictScalars (quotientPowSuccFactor I n) X).obj (Kn n),
      η (n + 1) ≫ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 2))) X).map t =
        η n ≫ (derivedRestrictScalarsQuotientPowSuccIso n).inv.app (Kn n) :=
  (hη (n + 1) ((derivedRestrictScalars (quotientPowSuccFactor I n) X).obj (Kn n))).2 _

/-- Blueprint `rem-sf-tower-shapes-occurring`: the reductions of an object form a normalized
tower.

For `K ∈ D(X_ét, Λ)` and derived reductions `η_n : K ⟶ Res K_n` exhibiting each
`K_n ∈ D(X_ét, Λ ⧸ Iⁿ⁺¹)` as `K ⊗ᴸ_Λ Λ ⧸ Iⁿ⁺¹`, the transition maps `K_{n+1} ⟶ Res K_n` are
the maps adjoint to `η_n`, and they exhibit `K_n` as `K_{n+1} ⊗ᴸ Λ ⧸ Iⁿ⁺¹`. -/
noncomputable def NormalizedTower.ofIsDerivedBaseChange {K : 𝐃(X, Λ)}
    (Kn : ∀ n : ℕ, 𝐃(X, Λ ⧸ I ^ (n + 1)))
    (η : ∀ n : ℕ, K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X).obj (Kn n))
    (hη : ∀ n : ℕ, IsDerivedBaseChange (η n)) : NormalizedTower I X where
  obj := Kn
  map n := (exists_transition_of_isDerivedBaseChange Kn η hη n).choose
  isDerivedBaseChange n N := by
    have hspec := (exists_transition_of_isDerivedBaseChange Kn η hη n).choose_spec
    set t := (exists_transition_of_isDerivedBaseChange Kn η hη n).choose
    let e := (derivedRestrictScalarsQuotientPowSuccIso (I := I) (X := X) n).app N
    rw [← Function.Bijective.of_comp_iff' (hη (n + 1)
      ((derivedRestrictScalars (quotientPowSuccFactor I n) X).obj N))]
    have h : ((fun g' ↦ η (n + 1) ≫
          (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 2))) X).map g') ∘
        fun g ↦ t ≫ (derivedRestrictScalars (quotientPowSuccFactor I n) X).map g) =
        (fun h ↦ h ≫ e.inv) ∘
          fun g ↦ η n ≫ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X).map g := by
      funext g
      have hnat := (derivedRestrictScalarsQuotientPowSuccIso (I := I) (X := X) n).inv.naturality g
      simp only [Functor.comp_obj, Functor.comp_map] at hnat
      simp only [Function.comp_apply, Functor.map_comp, ← Category.assoc, hspec]
      simp only [Category.assoc, e, Iso.app_inv, hnat]
    rw [h]
    refine Function.Bijective.comp ?_ (hη n N)
    exact Function.bijective_iff_has_inverse.2 ⟨fun h ↦ h ≫ e.hom, fun h ↦ by simp,
      fun h ↦ by simp⟩

@[simp]
lemma NormalizedTower.ofIsDerivedBaseChange_obj {K : 𝐃(X, Λ)}
    (Kn : ∀ n : ℕ, 𝐃(X, Λ ⧸ I ^ (n + 1)))
    (η : ∀ n : ℕ, K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X).obj (Kn n))
    (hη : ∀ n : ℕ, IsDerivedBaseChange (η n)) :
    (NormalizedTower.ofIsDerivedBaseChange Kn η hη).obj = Kn :=
  rfl

variable {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ) (hI : I = Ideal.span {ϖ})

include hϖ hI in
/-- The derived limit of a normalized tower is derived complete: each `Res M_n` is killed by
`ϖⁿ⁺¹`, so it receives no nonzero map from an object on which `ϖ` acts invertibly, and neither
does the homotopy limit (`CategoryTheory.Pretriangulated.IsHomotopyLimit.hom_ext_zero`). -/
theorem NormalizedTower.derivedComplete_of_isHomotopyLimit (M : NormalizedTower I X)
    {c : Cone M.restrict} (hc : Pretriangulated.IsHomotopyLimit c) :
    DerivedCategory.derivedComplete X.smallEtaleTopology I c.pt := by
  subst hI
  rw [DerivedCategory.derivedComplete_iff_rightOrthogonal hϖ rfl]
  intro Z f hZ
  have hF (n : ℕ) : ϖ ^ (n + 1) • 𝟙 (M.restrict.obj (op n)) = 0 :=
    smul_id_derivedRestrictScalars_obj
      (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self ϖ) _) (M.obj n)
  exact hc.hom_ext_zero (fun n g ↦ DerivedCategory.smulInvertible.hom_eq_zero hZ (hF n) g)
    (fun n g ↦ (ObjectProperty.le_shift _ 1 Z hZ).hom_eq_zero (hF n) g) f

include hϖ hI in
/-- Blueprint `lem-coef-normalized-dvr-effectivity`: Effectivity of a normalized DVR tower.

For a normalized tower `M_n` and its derived limit `M = R lim_n Res M_n` (the point of a
homotopy limit cone `c` of `AlgebraicGeometry.Etale.NormalizedTower.restrict`), the canonical
maps `M ⟶ Res M_n` exhibit `M_n` as the derived base change `M ⊗ᴸ_Λ A_n`, i.e. they induce
isomorphisms `M ⊗ᴸ_Λ A_n ≅ M_n`; in particular `M` is derived complete. No constructibility
or boundedness is required. -/
theorem NormalizedTower.isDerivedBaseChange_of_isHomotopyLimit (M : NormalizedTower I X)
    {c : Cone M.restrict} (hc : Pretriangulated.IsHomotopyLimit c) :
    (∀ n : ℕ, IsDerivedBaseChange (φ := Ideal.Quotient.mk (I ^ (n + 1))) (c.π.app (op n))) ∧
      DerivedCategory.derivedComplete X.smallEtaleTopology I c.pt :=
  ⟨sorry, M.derivedComplete_of_isHomotopyLimit hϖ hI hc⟩

/-- Blueprint `rem-sf-tower-shapes-occurring`: Tower shapes that occur.

1. The derived reductions `K_n = K ⊗ᴸ_Λ Λ ⧸ Iⁿ⁺¹` of any `K ∈ D(X_ét, Λ)` form a normalized
   tower (`AlgebraicGeometry.Etale.NormalizedTower.ofIsDerivedBaseChange`).
2. Membership in `Dᵇc(X, Λ)` is derived completeness together with finite-level
   constructibility of the reductions and a uniform Tor bound.

The common Tor interval of the reductions of an integral object is
`lem-coef-integral-residue-tor`. The converse, that a normalized tower is the tower of
reductions of its derived limit, is the separate effectivity theorem
`AlgebraicGeometry.Etale.NormalizedTower.isDerivedBaseChange_of_isHomotopyLimit`
(`lem-coef-normalized-dvr-effectivity`), which the remark cites; the compact-support and
exceptional versions are `prop-coef-integral-exceptional-adjoint`. -/
theorem exists_normalizedTower_and_boundedConstructibleIntegral_iff :
    (∀ (K : 𝐃(X, Λ)) (Kn : ∀ n : ℕ, 𝐃(X, Λ ⧸ I ^ (n + 1)))
      (η : ∀ n : ℕ, K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X).obj (Kn n)),
      (∀ n : ℕ, IsDerivedBaseChange (η n)) → ∃ M : NormalizedTower I X, M.obj = Kn) ∧
    ∀ K : 𝐃(X, Λ), DerivedCategory.boundedConstructibleIntegral I X K ↔
      DerivedCategory.derivedComplete X.smallEtaleTopology I K ∧ ∃ a b : ℤ, ∀ n : ℕ,
        DerivedCategory.boundedConstructible (ModuleCat.{u + 1} Λ) X
            ((reductionModIdeal Λ X (I ^ (n + 1))).obj K) ∧
          DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X a b
            ((reductionModIdeal Λ X (I ^ (n + 1))).obj K) :=
  ⟨fun _ Kn η hη ↦ ⟨NormalizedTower.ofIsDerivedBaseChange Kn η hη, rfl⟩, fun _ ↦ Iff.rfl⟩

end Tower

section Matrix

variable [IsDomain Λ] [IsNoetherianRing Λ] [IsAdicComplete I Λ] [Finite (Λ ⧸ I)]
  {ϖ : Λ} (hϖ : ϖ ∈ nonZeroDivisors Λ) (hI : I = Ideal.span {ϖ})
  {k : Type u} [Field k] [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))]

include hϖ hI in
/-- Blueprint `rem-sf-preservation-matrix`: Preservation results and their actual hypotheses,
the integral entries (item 5).

At the integral stage (`Λ` a Noetherian domain complete for `I = (ϖ)`, `Λ ⧸ I` finite of
exponent invertible on `k`), for a separated finite-type morphism `f : X ⟶ Y` of separated
finite-type `k`-schemes:

* the internal hom commutes with reduction, both as `RHom(K, L) ⊗ᴸ A_n ≅ RHom(K, L ⊗ᴸ A_n)`
  and as `RHom_Λ(K, L) ⊗ᴸ A_n ≅ RHom_{A_n}(K_n, L_n)`, and preserves derived completeness
  (`lem-coef-integral-hom-reduction`), and preserves `Dᵇc(-, Λ)`
  (`cor-coef-integral-internal-hom`);
* the derived limit `G_f L` of the reduced exceptional inverse images lies in `Dᵇc(X, Λ)` and
  is identified with `Rf^! L` compatibly with the maps to the `Rf^!(L ⊗ᴸ A_n)`, so that it is
  right adjoint to `Rf_!` on the constructible categories through
  `AlgebraicGeometry.Etale.rightDerivedUpperShriekAdjunction`; its reductions are
  `(G_f L) ⊗ᴸ A_n ≅ Rf^!(L ⊗ᴸ A_n)` (`prop-coef-integral-exceptional-adjoint`);
* the derived reductions of any object form a normalized tower, and a normalized tower is the
  tower of reductions of its derived limit, which is derived complete
  (`rem-sf-tower-shapes-occurring`, `lem-coef-normalized-dvr-effectivity`). -/
theorem preservationMatrix_integral {X Y : Scheme.{u}}
    (aX : X ⟶ Spec (.of k)) (aY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX]
    [LocallyOfFiniteType aY] [QuasiCompact aY] [IsSeparated aX] [IsSeparated aY]
    [HasCompactification aX] [HasCompactification aY]
    [(R(aX)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] [(R(aY)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint]
    (f : X ⟶ Y) (hf : f ≫ aY = aX) [QuasiCompact f] [HasCompactification f]
    [(R(f)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] :
    (∀ (n : ℕ) (K L : 𝐃(X, Λ)),
      Nonempty ((reductionModIdeal Λ X (I ^ n)).obj
          (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) ≅
        ((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj
          ((reductionModIdeal Λ X (I ^ n)).obj L))) ∧
    (∀ (n : ℕ) (K L : 𝐃(X, Λ)) (Kn Ln : 𝐃(X, Λ ⧸ I ^ n))
      (η : K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj Kn)
      (η' : L ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj Ln),
      IsDerivedBaseChange η → IsDerivedBaseChange η' →
        Nonempty ((reductionModIdeal Λ X (I ^ n)).obj
            (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L) ≅
          (derivedRestrictScalars (Ideal.Quotient.mk (I ^ n)) X).obj
            (((derivedHom (ModuleCat.{u + 1} (Λ ⧸ I ^ n)) X).obj (op Kn)).obj Ln))) ∧
    (∀ K L : 𝐃(X, Λ), DerivedCategory.derivedComplete X.smallEtaleTopology I L →
      DerivedCategory.derivedComplete X.smallEtaleTopology I
        (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L)) ∧
    (∀ K L : 𝐃(X, Λ), DerivedCategory.boundedConstructibleIntegral I X K →
      DerivedCategory.boundedConstructibleIntegral I X L →
        DerivedCategory.boundedConstructibleIntegral I X
          (((derivedHom (ModuleCat.{u + 1} Λ) X).obj (op K)).obj L)) ∧
    (∀ L : 𝐃(Y, Λ), DerivedCategory.boundedConstructibleIntegral I Y L →
      ∀ c : Cone (DerivedCategory.derivedCompletionDiagram Y.smallEtaleTopology I L ⋙
        R(f)^![ModuleCat.{u + 1} Λ]), Pretriangulated.IsHomotopyLimit c →
        DerivedCategory.boundedConstructibleIntegral I X c.pt ∧
          (∃ e : (R(f)^![ModuleCat.{u + 1} Λ]).obj L ≅ c.pt, ∀ n : ℕ,
            e.hom ≫ c.π.app (op n) = (R(f)^![ModuleCat.{u + 1} Λ]).map
              ((DerivedCategory.derivedCompletionCone Y.smallEtaleTopology I L).π.app (op n))) ∧
          ∀ n : ℕ, Nonempty ((reductionModIdeal Λ X (I ^ n)).obj c.pt ≅
            (R(f)^![ModuleCat.{u + 1} Λ]).obj ((reductionModIdeal Λ Y (I ^ n)).obj L))) ∧
    (∀ (K : 𝐃(X, Λ)) (Kn : ∀ n : ℕ, 𝐃(X, Λ ⧸ I ^ (n + 1)))
      (η : ∀ n : ℕ, K ⟶ (derivedRestrictScalars (Ideal.Quotient.mk (I ^ (n + 1))) X).obj (Kn n)),
      (∀ n : ℕ, IsDerivedBaseChange (η n)) → ∃ M : NormalizedTower I X, M.obj = Kn) ∧
    ∀ (M : NormalizedTower I X) (c : Cone M.restrict), Pretriangulated.IsHomotopyLimit c →
      (∀ n : ℕ, IsDerivedBaseChange (φ := Ideal.Quotient.mk (I ^ (n + 1))) (c.π.app (op n))) ∧
        DerivedCategory.derivedComplete X.smallEtaleTopology I c.pt :=
  ⟨fun n K L ↦ hI ▸ nonempty_iso_reductionModIdeal_derivedHom_obj hϖ n K L,
    fun n _ _ _ _ _ _ hη hη' ↦ nonempty_iso_reductionModIdeal_derivedHom I hϖ hI n hη hη',
    fun _ _ hL ↦ derivedComplete_derivedHom I hϖ hI hL,
    fun _ _ hK hL ↦ (boundedConstructibleIntegral_derivedHom I hϖ hI aX hK hL).1,
    fun _ hL _ hc ↦
      have h := boundedConstructibleIntegral_exceptionalAdjoint I hϖ hI aX aY f hf hL hc
      ⟨h.1.1, h.2.1, h.1.2⟩,
    (exists_normalizedTower_and_boundedConstructibleIntegral_iff (I := I) (X := X)).1,
    fun M _ hc ↦ M.isDerivedBaseChange_of_isHomotopyLimit hϖ hI hc⟩

end Matrix

