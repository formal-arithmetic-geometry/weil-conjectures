open CategoryTheory Opposite Limits

open scoped CategoryTheory.Functor

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  {J : GrothendieckTopology C} {C' : Type (u + 1)} [Category.{u} C'] [EssentiallySmall.{u + 1} C']
  {J' : GrothendieckTopology C'} {R : Type (u + 1)} [CommRing R]

/-- Derived completeness for an ideal `I = (ϖ)` generated by a nonzerodivisor is preserved by
right adjoints whose left adjoint is `R`-linear: such a right adjoint preserves right
orthogonality to the objects on which `ϖ` acts invertibly. -/
lemma derivedComplete_obj_of_adjunction_of_mem_nonZeroDivisors {I : Ideal R} {ϖ : R}
    (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ})
    {F : DerivedCategory (Sheaf J' (ModuleCat.{u + 1} R)) ⥤
      DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
    {G : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)) ⥤
      DerivedCategory (Sheaf J' (ModuleCat.{u + 1} R))}
    (adj : F ⊣ G) [F.Additive] [F.Linear R] {K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
    (hK : derivedComplete J I K) : derivedComplete J' I (G.obj K) := by
  rw [derivedComplete_iff_rightOrthogonal hϖ hI] at hK ⊢
  have := adj.right_adjoint_additive
  intro Z φ (hZ : IsIso (ϖ • 𝟙 Z))
  have hZ' : smulInvertible J ϖ (F.obj Z) := by
    change IsIso (ϖ • 𝟙 _)
    rw [← F.map_id, ← Functor.map_smul]
    infer_instance
  rw [← (adj.homEquiv Z K).apply_symm_apply φ, hK ((adj.homEquiv Z K).symm φ) hZ',
    Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

/-- Derived completeness for a principal ideal of a domain is preserved by right adjoints whose
left adjoint is `R`-linear. -/
lemma derivedComplete_obj_of_adjunction [IsDomain R] {I : Ideal R} (hI : I.IsPrincipal)
    {F : DerivedCategory (Sheaf J' (ModuleCat.{u + 1} R)) ⥤
      DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
    {G : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R)) ⥤
      DerivedCategory (Sheaf J' (ModuleCat.{u + 1} R))}
    (adj : F ⊣ G) [F.Additive] [F.Linear R] {K : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}
    (hK : derivedComplete J I K) : derivedComplete J' I (G.obj K) := by
  obtain ⟨ϖ, hϖ⟩ := hI.principal
  rw [Ideal.submodule_span_eq] at hϖ
  by_cases h0 : ϖ = 0
  · rw [hϖ, h0, Ideal.span_singleton_eq_bot.mpr rfl]
    exact derivedComplete_bot J' _
  · exact derivedComplete_obj_of_adjunction_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero h0) hϖ adj hK

/-- Derived completeness for a principal ideal of a domain is invariant under isomorphism. -/
lemma derivedComplete_of_iso [IsDomain R] {I : Ideal R} (hI : I.IsPrincipal)
    {K L : DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))} (e : K ≅ L)
    (hK : derivedComplete J I K) : derivedComplete J I L := by
  obtain ⟨ϖ, hϖ⟩ := hI.principal
  rw [Ideal.submodule_span_eq] at hϖ
  by_cases h0 : ϖ = 0
  · rw [hϖ, h0, Ideal.span_singleton_eq_bot.mpr rfl]
    exact derivedComplete_bot J _
  · have hϖ0 := mem_nonZeroDivisors_of_ne_zero h0
    rw [derivedComplete_iff_rightOrthogonal hϖ0 hϖ] at hK ⊢
    intro Z φ hZ
    rw [← Category.comp_id φ, ← e.inv_hom_id, ← Category.assoc, hK (φ ≫ e.inv) hZ, zero_comp]

end DerivedCategory

namespace AlgebraicGeometry

open Scheme

namespace Etale

set_option hygiene false in
local notation "𝐃(" X ", " Λ ")" =>
  _root_.DerivedCategory (Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u + 1} Λ))

set_option hygiene false in
local notation "Λ_(" X ", " Λ ")" =>
  (_root_.DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology X)
    (ModuleCat.{u + 1} Λ)) 0).obj
      ((constantSheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u + 1} Λ)).obj (ModuleCat.of Λ Λ))

section General

variable {Λ : Type (u + 1)} [CommRing Λ] [IsDomain Λ] (I : Ideal Λ) (hI : I.IsPrincipal)

include hI

theorem derivedComplete_rightDerivedLowerStar' {X Y : Scheme.{u}} (f : X ⟶ Y) (K : 𝐃(X, Λ))
    (hK : DerivedCategory.derivedComplete X.smallEtaleTopology I K) :
    DerivedCategory.derivedComplete Y.smallEtaleTopology I
      ((R((f)_*[ModuleCat.{u + 1} Λ])).obj K) :=
  DerivedCategory.derivedComplete_obj_of_adjunction hI
    (derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) f) hK

theorem derivedComplete_rightDerivedLowerShriek' {X Y : Scheme.{u}} (f : X ⟶ Y)
    [HasCompactification f] [IsProper f] (K : 𝐃(X, Λ))
    (hK : DerivedCategory.derivedComplete X.smallEtaleTopology I K) :
    DerivedCategory.derivedComplete Y.smallEtaleTopology I
      ((R(f)_![ModuleCat.{u + 1} Λ]).obj K) :=
  DerivedCategory.derivedComplete_of_iso hI
    ((rightDerivedLowerShriekIsoRightDerivedLowerStar _ f).app K).symm
    (derivedComplete_rightDerivedLowerStar' I hI f K hK)

theorem derivedComplete_coefficientDual' {X : Scheme.{u}}
    (hΛ : DerivedCategory.derivedComplete X.smallEtaleTopology I Λ_(X, Λ)) (K : 𝐃(X, Λ))
    (hK : DerivedCategory.derivedComplete X.smallEtaleTopology I K) :
    DerivedCategory.derivedComplete X.smallEtaleTopology I
      ((DerivedCategory.coefficientDual (ModuleCat.{u + 1} Λ) X).obj (op K)) :=
  DerivedCategory.derivedComplete_obj_of_adjunction hI
    (derivedTensorHomAdjunction (ModuleCat.{u + 1} Λ) K)
    (DerivedCategory.derivedComplete_of_iso hI
      (singleFunctorObjUnitIso (ModuleCat.{u + 1} Λ) X) hΛ)

end General

end Etale

end AlgebraicGeometry

