/-!
# Tor amplitude and constructibility under extension and restriction of scalars

Let `φ : Λ →+* Λ'` be a surjective morphism of commutative rings whose kernel is generated by a
nonzerodivisor `a`, for instance `Λ ⟶ Λ ⧸ (ϖⁿ)`. For étale sheaves on a scheme `X`:

- `AlgebraicGeometry.Etale.torAmplitudeIn_derivedExtendScalars`: if `L ⊗ᴸ (Λ ⧸ ker φ)` has Tor
  amplitude in `[α, β]` over `Λ`, then `L ⊗ᴸ_Λ Λ'` has Tor amplitude in `[α + 1, β]` over `Λ'`;
- `AlgebraicGeometry.Etale.torAmplitudeIn_derivedRestrictScalars`: if `N` has Tor amplitude in
  `[α, β]` over `Λ'`, its restriction of scalars has Tor amplitude in `[α - 1, β]` over `Λ`;
- `AlgebraicGeometry.Etale.boundedConstructible_derivedRestrictScalars_iff`: for `Λ' = Λ ⧸ J`
  finite, restriction of scalars preserves and reflects bounded constructibility.

These follow from the projection formula
`AlgebraicGeometry.Etale.nonempty_iso_derivedRestrictScalars_derivedTensor`.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Opposite Pretriangulated

attribute [local instance high] SymmetricCategory.toBraidedCategory
attribute [local instance 20000] GrothendieckTopology.braidedCategory_sheaf_of_essentiallySmall

namespace AlgebraicGeometry

open Scheme

namespace Etale

set_option hygiene false in
/-- The derived category `D(X_ét, Λ)` of étale sheaves of `Λ`-modules on `X`. -/
local notation "𝐃(" X ", " Λ ")" =>
  _root_.DerivedCategory (Sheaf (Scheme.smallEtaleTopology X) (ModuleCat.{u + 1} Λ))

variable {Λ Λ' : Type (u + 1)} [CommRing Λ] [CommRing Λ'] {φ : Λ →+* Λ'}
  (hφ : Function.Surjective φ) {a : Λ} (ha : RingHom.ker φ = Ideal.span {a}) {X : Scheme.{u}}

section General

variable (A : Type*) [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
  [MonoidalCategory A] [MonoidalPreadditive A] [SymmetricCategory A] [MonoidalClosed A]
  [Abelian.HasFunctorialFlatResolution A] (X : Scheme.{u})

end General

end Etale

end AlgebraicGeometry
