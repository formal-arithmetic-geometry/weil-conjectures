module

public import Mathlib.RingTheory.Artinian.Module
public import Mathlib.RingTheory.SimpleModule.Basic
public import Mathlib.Algebra.Category.ModuleCat.Biproducts
public import WeilConjectures.CategoryTheory.DerivedCategory.TorAmplitudeResidueIdeal
public import WeilConjectures.SixFunctors.Etale.Derived.TorAmplitude

/-!
# The residue test for Tor amplitude on the étale site, for a finite coefficient ring

Let `Λ` be a finite commutative ring, `J ⊆ Λ` its Jacobson radical (a nilpotent ideal, with
`Λ ⧸ J` a finite product of finite fields) and `κ = Λ ⧸ J`. For a scheme `X`, an object `K` of
`D(X_ét, Λ)` has Tor amplitude in `[a, b]` if and only if `K ⊗ᴸ κ_X` has homology concentrated in
`[a, b]`, where `κ_X` is the constant sheaf with value `κ`
(`AlgebraicGeometry.Etale.DerivedCategory.torAmplitudeIn_iff_tensorSingleConcentratedIn`,
blueprint `theorem-f-shriek-finite-coefficients--1`).

This is the categorical residue test
`DerivedCategory.torAmplitudeIn_iff_tensorSingleConcentratedIn_of_ideal`, whose
inputs are proved here for sheaves of `Λ`-modules on any essentially small site:

- `CategoryTheory.Sheaf.mono_whiskerRight_of_smul_eq_zero_of_ideal`: tensoring with any sheaf
  preserves monomorphisms whose target is killed by an ideal `I` with `Λ ⧸ I` semisimple.
  Sectionwise such a monomorphism is a split monomorphism of `Λ`-modules
  (`ModuleCat.isSplitMono_of_smul_eq_zero_of_ideal`).
- `CategoryTheory.Sheaf.constantSheafQuotientTensorIso`: for an ideal `I` generated by a finite
  family `r`, the constant sheaf `(Λ ⧸ I)` satisfies `(Λ ⧸ I) ⊗ F ≅ F` for every sheaf `F` killed
  by `I`. Indeed `Λ ⧸ I` is the cokernel of the map `Λʳ ⟶ Λ` given by `r`
  (`ModuleCat.quotientSpanRangeIsoCokernel`), the constant sheaf functor and `- ⊗ F` are right
  exact, and the map `Λʳ ⊗ F ⟶ Λ ⊗ F` is zero.

The blueprint states the residue test for `Λ = 𝒪_E / ϖⁿ`, a local ring with principal maximal
ideal, and for bounded constructible `K`; it holds for every `K` and every finite ring.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

namespace ModuleCat

variable {Λ : Type*} [CommRing Λ]

/-- A monomorphism of `Λ`-modules whose target is killed by an ideal `I` is split when `Λ ⧸ I` is
a semisimple ring: the target is a semisimple module. -/
lemma isSplitMono_of_smul_eq_zero_of_ideal (I : Ideal Λ) [IsSemisimpleRing (Λ ⧸ I)]
    {M N : ModuleCat Λ} (f : M ⟶ N) [Mono f] (hN : ∀ x ∈ I, x • 𝟙 N = 0) : IsSplitMono f := by
  have hN' : Module.IsTorsionBySet Λ N I := fun n x ↦ by
    simpa using congr($(hN x.1 x.2) n)
  let := hN'.module
  have : IsSemisimpleModule Λ N := hN'.isSemisimpleModule_iff.1 inferInstance
  obtain ⟨g, hg⟩ := IsSemisimpleModule.extension_property f.hom
    ((ModuleCat.mono_iff_injective f).1 inferInstance) LinearMap.id
  exact ⟨⟨ModuleCat.ofHom g, by ext x; exact congr($hg x)⟩⟩

/-- The map `Λʳ ⟶ Λ` given by a finite family `r` of elements of `Λ`. -/
noncomputable abbrev biproductDescSmul {ι : Type} [Fintype ι] (r : ι → Λ) :
    (⨁ fun _ : ι ↦ ModuleCat.of Λ Λ) ⟶ ModuleCat.of Λ Λ :=
  biproduct.desc fun i ↦ r i • 𝟙 _

/-- The range of the map `Λʳ ⟶ Λ` given by a finite family `r` is the ideal generated by `r`. -/
lemma range_biproductDescSmul {ι : Type} [Fintype ι] (r : ι → Λ) :
    LinearMap.range (biproductDescSmul r).hom = Ideal.span (Set.range r) := by
  classical
  refine le_antisymm ?_ (Ideal.span_le.2 ?_)
  · rintro _ ⟨v, rfl⟩
    have h : biproductDescSmul r =
        ∑ i, biproduct.π (fun _ : ι ↦ ModuleCat.of Λ Λ) i ≫ (r i • 𝟙 _) :=
      biproduct.desc_eq
    rw [h, ModuleCat.hom_sum, LinearMap.sum_apply]
    refine Ideal.sum_mem _ fun i _ ↦ ?_
    change r i • (biproduct.π (fun _ : ι ↦ ModuleCat.of Λ Λ) i).hom v ∈ _
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · rintro _ ⟨i, rfl⟩
    refine ⟨(biproduct.ι (fun _ : ι ↦ ModuleCat.of Λ Λ) i).hom 1, ?_⟩
    change (biproduct.ι (fun _ : ι ↦ ModuleCat.of Λ Λ) i ≫ biproductDescSmul r).hom 1 = r i
    rw [biproduct.ι_desc]
    simp

/-- The quotient `Λ ⧸ (r)` by the ideal generated by a finite family `r` is the cokernel of the
map `Λʳ ⟶ Λ` given by `r`. -/
noncomputable def quotientSpanRangeIsoCokernel {ι : Type} [Fintype ι] (r : ι → Λ) :
    ModuleCat.of Λ (Λ ⧸ Ideal.span (Set.range r)) ≅ cokernel (biproductDescSmul r) :=
  (Submodule.quotEquivOfEq _ _ (range_biproductDescSmul r).symm).toModuleIso ≪≫
    (ModuleCat.cokernelIsoRangeQuotient _).symm

end ModuleCat

namespace CategoryTheory.Sheaf

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  {J : GrothendieckTopology C} {Λ : Type (u + 1)} [CommRing Λ]

/-- Let `Λ ⧸ I` be a semisimple ring. For sheaves of `Λ`-modules on an essentially small site,
tensoring with any sheaf `F` preserves monomorphisms `f` whose target is killed by `I`.

Sectionwise `f` is a split monomorphism (`ModuleCat.isSplitMono_of_smul_eq_zero_of_ideal`), so
the presheaf tensor product `f ▷ F` is a monomorphism, and so is its sheafification. -/
lemma mono_whiskerRight_of_smul_eq_zero_of_ideal (I : Ideal Λ) [IsSemisimpleRing (Λ ⧸ I)]
    {X Y : Sheaf J (ModuleCat.{u + 1} Λ)} (f : X ⟶ Y) [Mono f] (hY : ∀ x ∈ I, x • 𝟙 Y = 0)
    (F : Sheaf J (ModuleCat.{u + 1} Λ)) : Mono (f ▷ F) := by
  have : Mono f.hom := inferInstanceAs (Mono ((sheafToPresheaf J _).map f))
  have (U : Cᵒᵖ) : Mono ((f.hom ▷ F.obj).app U) := by
    have : IsSplitMono (f.hom.app U) :=
      ModuleCat.isSplitMono_of_smul_eq_zero_of_ideal I _ fun x hx ↦
        congr(($(hY x hx)).hom.app U)
    exact inferInstanceAs (Mono ((tensorRight _).map (f.hom.app U)))
  have : Mono (f.hom ▷ F.obj) := NatTrans.mono_of_mono_app _
  have : Mono ((sheafToPresheaf J _ ⋙ tensorRight F.obj ⋙ presheafToSheaf J _).map f) :=
    inferInstanceAs (Mono ((presheafToSheaf J _).map (f.hom ▷ F.obj)))
  change Mono ((tensorRight F).map f)
  rw [← NatIso.naturality_2 (Sheaf.tensorRightIso F) f]
  infer_instance

variable (J) in
/-- The constant sheaf with value `Λ ⧸ I` is killed by `I`. -/
lemma smul_id_constantSheaf_quotient_eq_zero (I : Ideal Λ) {x : Λ} (hx : x ∈ I) :
    x • 𝟙 ((constantSheaf J (ModuleCat.{u + 1} Λ)).obj (ModuleCat.of Λ (Λ ⧸ I))) = 0 := by
  have h : x • 𝟙 (ModuleCat.of Λ (Λ ⧸ I)) = 0 := by
    refine ModuleCat.hom_ext (LinearMap.ext fun y ↦ ?_)
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    change Ideal.Quotient.mk I (x • y) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem, smul_eq_mul]
    exact I.mul_mem_right y hx
  rw [← CategoryTheory.Functor.map_id, ← Functor.map_smul, h, Functor.map_zero]

variable (J) in
/-- Let `I` be the ideal generated by a finite family `r`. For every sheaf `F` of `Λ`-modules
killed by `I`, the image of the map `Λʳ ⟶ Λ` given by `r` under the constant sheaf functor becomes
zero after tensoring with `F`. -/
lemma constantSheaf_map_biproductDescSmul_whiskerRight_eq_zero {ι : Type} [Fintype ι]
    (r : ι → Λ) (F : Sheaf J (ModuleCat.{u + 1} Λ))
    (hF : ∀ x ∈ Ideal.span (Set.range r), x • 𝟙 F = 0) :
    (constantSheaf J (ModuleCat.{u + 1} Λ)).map (ModuleCat.biproductDescSmul r) ▷ F = 0 := by
  classical
  have h : ModuleCat.biproductDescSmul r =
      ∑ i, biproduct.π (fun _ : ι ↦ ModuleCat.of Λ Λ) i ≫ (r i • 𝟙 _) :=
    biproduct.desc_eq
  rw [h, Functor.map_sum, CategoryTheory.sum_whiskerRight]
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  rw [Functor.map_comp, Functor.map_smul, CategoryTheory.Functor.map_id, comp_whiskerRight,
    MonoidalLinear.smul_whiskerRight, id_whiskerRight, ← MonoidalCategory.whiskerLeft_id,
    ← MonoidalLinear.whiskerLeft_smul, hF _ (Ideal.subset_span ⟨i, rfl⟩),
    MonoidalPreadditive.whiskerLeft_zero, comp_zero]

variable (J) in
/-- Let `I` be the ideal generated by a finite family `r`. For every sheaf `F` of `Λ`-modules
killed by `I`, the constant sheaf `Λ ⧸ I` satisfies `(Λ ⧸ I) ⊗ F ≅ F`: the constant sheaf functor
and `- ⊗ F` are right exact, `Λ ⧸ I` is the cokernel of `Λʳ ⟶ Λ`
(`ModuleCat.quotientSpanRangeIsoCokernel`), and that map becomes zero after tensoring with `F`
(`CategoryTheory.Sheaf.constantSheaf_map_biproductDescSmul_whiskerRight_eq_zero`). -/
noncomputable def constantSheafQuotientTensorIso {ι : Type} [Fintype ι] (r : ι → Λ)
    (F : Sheaf J (ModuleCat.{u + 1} Λ)) (hF : ∀ x ∈ Ideal.span (Set.range r), x • 𝟙 F = 0) :
    (constantSheaf J (ModuleCat.{u + 1} Λ)).obj
        (ModuleCat.of Λ (Λ ⧸ Ideal.span (Set.range r))) ⊗ F ≅ F :=
  haveI : PreservesFiniteColimits (constantSheaf J (ModuleCat.{u + 1} Λ)) :=
    comp_preservesFiniteColimits (Functor.const _) (presheafToSheaf J _)
  haveI := preservesFiniteColimits_tensorRight F
  (tensorRight F).mapIso ((constantSheaf J _).mapIso (ModuleCat.quotientSpanRangeIsoCokernel r) ≪≫
      PreservesCokernel.iso (constantSheaf J _) _) ≪≫
    PreservesCokernel.iso (tensorRight F) _ ≪≫
    cokernelIsoOfEq (constantSheaf_map_biproductDescSmul_whiskerRight_eq_zero J r F hF) ≪≫
    cokernelZeroIsoTarget ≪≫
    whiskerRightIso (Functor.Monoidal.εIso (presheafToSheaf J _)).symm F ≪≫ λ_ F

end CategoryTheory.Sheaf

namespace AlgebraicGeometry.Etale.DerivedCategory

open Scheme

variable {Λ : Type (u + 1)} [CommRing Λ]

/-- Blueprint `theorem-f-shriek-finite-coefficients--1`: Testing finite Tor amplitude at the residue
field.

Let `Λ` be a finite ring with Jacobson radical `J`, and let `κ_X` be the constant étale sheaf on
`X` with value `κ = Λ ⧸ J`. Then `K ∈ D(X_ét, Λ)` has Tor amplitude in `[a, b]` if and only if
`K ⊗ᴸ κ_X` has homology concentrated in `[a, b]`. The blueprint states this for
`Λ = 𝒪_E / ϖⁿ`, with residue field `κ`, and for bounded `K` with constructible cohomology; it holds
for every `K` and every finite ring `Λ`.

This is `DerivedCategory.torAmplitudeIn_iff_tensorSingleConcentratedIn_of_ideal`
for the nilpotent ideal `J`, generated by its finitely many elements: `κ_X ⊗ F ≅ F` for `F` killed
by `J` (`CategoryTheory.Sheaf.constantSheafQuotientTensorIso`), and sheaves of `κ`-modules are
flat over `κ`, `κ` being semisimple
(`CategoryTheory.Sheaf.mono_whiskerRight_of_smul_eq_zero_of_ideal`). -/
theorem torAmplitudeIn_iff_tensorSingleConcentratedIn [Finite Λ] {X : Scheme.{u}} (a b : ℤ)
    (K : _root_.DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ))) :
    torAmplitudeIn (ModuleCat.{u + 1} Λ) X a b K ↔
      _root_.DerivedCategory.TensorSingleConcentratedIn _ a b K
        ((constantSheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
          (ModuleCat.of Λ (Λ ⧸ Ring.jacobson Λ))) := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin (Ring.jacobson Λ)
  let r : Fin n → Λ := fun i ↦ (e.symm i).1
  have hr : Ideal.span (Set.range r) = Ring.jacobson Λ := by
    have : Set.range r = (Ring.jacobson Λ : Set Λ) := by
      ext x
      exact ⟨fun ⟨i, hi⟩ ↦ hi ▸ (e.symm i).2, fun hx ↦ ⟨e ⟨x, hx⟩, by simp [r]⟩⟩
    rw [this, Ideal.span_eq]
  obtain ⟨n, hn⟩ := (IsSemiprimaryRing.isNilpotent : IsNilpotent (Ring.jacobson Λ))
  rw [← hr] at hn ⊢
  have : IsSemisimpleRing (Λ ⧸ Ideal.span (Set.range r)) := by
    rw [hr]
    infer_instance
  exact _root_.DerivedCategory.torAmplitudeIn_iff_tensorSingleConcentratedIn_of_ideal
    (C := Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) (R := Λ) r hn
    (fun x hx ↦ Sheaf.smul_id_constantSheaf_quotient_eq_zero _ _ hx)
    (fun F hF ↦ ⟨Sheaf.constantSheafQuotientTensorIso _ r F hF⟩)
    (fun F _ _ _ f _ _ hY ↦ Sheaf.mono_whiskerRight_of_smul_eq_zero_of_ideal _ f hY F) a b K

end AlgebraicGeometry.Etale.DerivedCategory
