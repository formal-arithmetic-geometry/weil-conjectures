module

public import WeilConjectures.ConstructibleSheaf.Simple
public import WeilConjectures.Mathlib.Topology.KrullDimension.Specialization
public import WeilConjectures.Mathlib.Topology.LocallyClosed
public import WeilConjectures.SixFunctors.Etale.Perverse.Basic

/-!
# The support of a constructible sheaf and its stalks

Let `G` be a sheaf of `Λ`-modules on the small étale site of a scheme `Y`. The points with a
nonzero stalk lie in the support `sheafSupport G`. If `Y` has Noetherian underlying space and
`G` is constructible, conversely every point of the support is a specialization of a point
with a nonzero stalk; hence the dimension of the support is bounded by the dimensions of the
closures of the points with nonzero stalk.

## Main statements

- `AlgebraicGeometry.Etale.compl_stalkZeroLocus_subset_sheafSupport`: points with a nonzero
  stalk lie in the support.
- `AlgebraicGeometry.Etale.sheafSupport_subset_iUnion_closure`: for a constructible sheaf,
  every point of the support specializes from a point with a nonzero stalk.
- `AlgebraicGeometry.Etale.topologicalKrullDim_sheafSupport_le`: the dimension of the support
  is bounded by the dimensions of the closures of the points with nonzero stalk.
- `AlgebraicGeometry.Etale.exists_not_isZero_upperStar_of_notMem_stalkZeroLocus`: at a point
  with nonzero stalk, the pullback to some geometric point is nonzero.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Etale

open Scheme

variable {Λ : Type (u + 1)} [Ring Λ] {Y : Scheme.{u}}
  (G : Sheaf Y.smallEtaleTopology (ModuleCat.{u + 1} Λ))

/-- A point at which some stalk of `G` is nonzero lies in the support of `G`: the stalks of the
restriction of `G` to an open neighbourhood are those of `G`. -/
lemma compl_stalkZeroLocus_subset_sheafSupport : (stalkZeroLocus G)ᶜ ⊆ sheafSupport G := by
  intro y hy U hyU hU
  obtain ⟨z, rfl⟩ : y ∈ Set.range U.ι.base := U.range_ι ▸ hyU
  exact hy (mem_stalkZeroLocus_of_upperStar U.ι G
    ((isZero_iff_stalkZeroLocus_eq_univ _).1 hU ▸ Set.mem_univ z))

/-- The support of `G` lies in the closure of the set of points with a nonzero stalk: on the
open complement of this closure all stalks of `G` vanish, hence so does `G`. -/
lemma sheafSupport_subset_closure_compl_stalkZeroLocus :
    sheafSupport G ⊆ closure (stalkZeroLocus G)ᶜ := by
  intro x hx
  by_contra hxc
  refine hx ⟨(closure (stalkZeroLocus G)ᶜ)ᶜ, isClosed_closure.isOpen_compl⟩ hxc ?_
  rw [isZero_iff_stalkZeroLocus_eq_univ, Set.eq_univ_iff_forall]
  intro z
  refine mem_stalkZeroLocus_upperStar _ G ?_
  have hz : (Scheme.Opens.ι _).base z ∈ (closure (stalkZeroLocus G)ᶜ)ᶜ :=
    (Scheme.Opens.range_ι _).subset ⟨z, rfl⟩
  exact not_not.1 fun h ↦ hz (subset_closure h)

/-- Along an immersion `f` such that `f^* G` is locally constant, the points of the range of
`f` with a nonzero stalk form a locally closed subset: the image of the closed complement of the
clopen set `stalkZeroLocus (f^* G)`. -/
lemma isLocallyClosed_compl_stalkZeroLocus_inter_range {Z : Scheme.{u}} (f : Z ⟶ Y)
    [IsImmersion f] [IsLocallyConstantSheaf (((f)^*[ModuleCat.{u + 1} Λ]).obj G)] :
    IsLocallyClosed ((stalkZeroLocus G)ᶜ ∩ Set.range f.base) := by
  have : (stalkZeroLocus G)ᶜ ∩ Set.range f.base =
      f.base '' (stalkZeroLocus (((f)^*[ModuleCat.{u + 1} Λ]).obj G))ᶜ := by
    ext y
    constructor
    · rintro ⟨hy, z, rfl⟩
      exact ⟨z, fun h ↦ hy (mem_stalkZeroLocus_of_upperStar f G h), rfl⟩
    · rintro ⟨z, hz, rfl⟩
      exact ⟨fun h ↦ hz (mem_stalkZeroLocus_upperStar f G h), z, rfl⟩
  rw [this]
  exact (isClopen_stalkZeroLocus _).compl.isClosed.isLocallyClosed.image
    f.isEmbedding.isInducing f.isLocallyClosed_range

/-- **The support of a constructible sheaf is generated by the points with nonzero stalk.** If
`Y` has Noetherian underlying space and `G` is constructible, every point of the support of `G`
is a specialization of a point at which a stalk of `G` is nonzero: on each stratum of a
stratification trivializing `G` these points form a locally closed set, and in a noetherian
sober space every point of the closure of a locally closed set specializes from it. -/
theorem sheafSupport_subset_iUnion_closure [TopologicalSpace.NoetherianSpace Y]
    [IsConstructibleSheaf G] :
    sheafSupport G ⊆ ⋃ y ∈ (stalkZeroLocus G)ᶜ, closure {y} := by
  obtain ⟨S, hS⟩ := ‹IsConstructibleSheaf G›.exists_stratification
  have hN (i : Fin S.n) :
      IsLocallyClosed ((stalkZeroLocus G)ᶜ ∩ Set.range (S.immersion i).base) :=
    have := (hS i).toIsLocallyConstantSheaf
    isLocallyClosed_compl_stalkZeroLocus_inter_range G (S.immersion i)
  have hcover : (stalkZeroLocus G)ᶜ =
      ⋃ i, (stalkZeroLocus G)ᶜ ∩ Set.range (S.immersion i).base := by
    rw [← Set.inter_iUnion]
    simp_rw [S.range_immersion]
    rw [S.iUnion_stratum_eq_univ, Set.inter_univ]
  calc sheafSupport G ⊆ closure (stalkZeroLocus G)ᶜ :=
        sheafSupport_subset_closure_compl_stalkZeroLocus G
    _ = ⋃ i, closure ((stalkZeroLocus G)ᶜ ∩ Set.range (S.immersion i).base) := by
        rw [hcover, closure_iUnion_of_finite, ← hcover]
    _ ⊆ _ := Set.iUnion_subset fun i ↦ (hN i).closure_subset_iUnion_closure_singleton.trans
        (Set.biUnion_subset_biUnion_left Set.inter_subset_left)

/-- For a constructible sheaf on a scheme with Noetherian underlying space, the support is
nonempty exactly when some stalk is nonzero. -/
lemma sheafSupport_nonempty_iff [TopologicalSpace.NoetherianSpace Y] [IsConstructibleSheaf G] :
    (sheafSupport G).Nonempty ↔ ∃ y, y ∉ stalkZeroLocus G := by
  refine ⟨fun ⟨x, hx⟩ ↦ ?_, fun ⟨y, hy⟩ ↦
    ⟨y, compl_stalkZeroLocus_subset_sheafSupport G hy⟩⟩
  obtain ⟨y, hy, -⟩ := Set.mem_iUnion₂.1 (sheafSupport_subset_iUnion_closure G hx)
  exact ⟨y, hy⟩

/-- **Dimension of the support of a constructible sheaf.** If `Y` has Noetherian underlying
space and `G` is constructible, the support of `G` has dimension at most `N` as soon as the
closure of every point with a nonzero stalk does. -/
theorem topologicalKrullDim_sheafSupport_le [TopologicalSpace.NoetherianSpace Y]
    [IsConstructibleSheaf G] (N : WithBot ℕ∞)
    (h : ∀ y ∉ stalkZeroLocus G, topologicalKrullDim (closure {y} : Set Y) ≤ N) :
    topologicalKrullDim (sheafSupport G) ≤ N :=
  topologicalKrullDim_le_of_subset_iUnion_closure_singleton (isClosed_sheafSupport G)
    (sheafSupport_subset_iUnion_closure G) h

/-- At a point `y` where some stalk of `G` is nonzero, there is a geometric point
`s : Spec Ω ⟶ Y` over `y` such that the pullback `s^* G` is nonzero: its stalk at the identity
geometric point of `Spec Ω` is the stalk of `G` at `s`. -/
lemma exists_not_isZero_upperStar_of_notMem_stalkZeroLocus {y : Y}
    (hy : y ∉ stalkZeroLocus G) :
    ∃ (Ω : Type u) (_ : Field Ω) (_ : IsSepClosed Ω) (s : Spec (.of Ω) ⟶ Y),
      s.base (IsLocalRing.closedPoint Ω) = y ∧
        ¬ IsZero (((s)^*[ModuleCat.{u + 1} Λ]).obj G) := by
  simp only [stalkZeroLocus, Set.mem_ofPred_eq, not_forall] at hy
  obtain ⟨Ω, _, _, s, hs, hz⟩ := hy
  refine ⟨Ω, inferInstance, inferInstance, s, hs, fun h ↦ hz ?_⟩
  have := (isZero_sheafFiber_of_isZero h (𝟙 _)).of_iso
    ((upperStarCompSheafFiberIso (ModuleCat.{u + 1} Λ) s (𝟙 _)).app G).symm
  rwa [Category.id_comp] at this

end AlgebraicGeometry.Etale
