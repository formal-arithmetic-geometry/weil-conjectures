module

public import WeilConjectures.Mathlib.AlgebraicGeometry.Sites.Etale
public import WeilConjectures.Mathlib.CategoryTheory.NatIso
public import WeilConjectures.Mathlib.CategoryTheory.Sites.Sheaf
public import WeilConjectures.SixFunctors.Etale.LowerShriek.OpenImmersion.Defs

/-!
# Restriction along an étale cover is conservative

Let `g i : W i ⟶ X` be a jointly surjective family of étale morphisms. This file proves that
a morphism of sheaves on the small étale site of `X` which becomes invertible after
restricting along every `g i` is itself invertible
(`AlgebraicGeometry.Etale.isIso_of_isIso_localizationRestriction`). Here restriction is the
functor `AlgebraicGeometry.Etale.localizationRestriction` of
`WeilConjectures.SixFunctors.Etale.LowerShriek.OpenImmersion.Defs`, which for an open immersion is
`AlgebraicGeometry.Etale.openImmersionRestriction`.

The statement is proved objectwise, from the general local criterion
`CategoryTheory.Sheaf.isIso_of_isIso_app_of_mem`: a morphism of sheaves is invertible as soon
as, at every object of the site, it is invertible on the members of some covering sieve. At an
étale `X`-scheme `V` the covering sieve used is the one generated by the base changes
`V ×_X W i` (`AlgebraicGeometry.Scheme.Etale.ofArrows_baseChange_mem_smallEtaleTopology`).
Every member of that sieve factors through one of the base changes, hence through the
corresponding `g i`, where the objectwise statement below applies.

That objectwise statement holds because an étale `X`-scheme `V` whose structure morphism
factors as `p ≫ g` is the image of the étale `W`-scheme `p` under the localization functor
along `g`. The sections of a restricted sheaf over an étale `W`-scheme are by definition the
sections of the original sheaf over its image
(`AlgebraicGeometry.Etale.localizationRestriction_map_hom_app`), so invertibility
of the restricted morphism transports back along `CategoryTheory.NatTrans.isIso_app_of_iso`.

## Main results

- `AlgebraicGeometry.Etale.isIso_app_of_isIso_localizationRestriction`: a morphism of sheaves
  whose restriction along an étale `g : W ⟶ X` is invertible is invertible at every étale
  `X`-scheme whose structure morphism factors through `g`.
- `AlgebraicGeometry.Etale.isIso_of_isIso_localizationRestriction`: the restrictions along a
  jointly surjective family of étale morphisms are jointly conservative.
-/

@[expose] public section

universe u' u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry

variable (A : Type u') [Category.{u + 1} A]
variable {X : Scheme.{u}} {G G' : Sheaf X.smallEtaleTopology A} (φ : G ⟶ G')

/-- **Invertibility of `g^* φ` gives invertibility of `φ` at every `V` factoring through
`g`.** If the structure morphism of an étale `X`-scheme `V` factors through `g`, then `V` is
the image of the étale `W`-scheme `p` under the localization functor along `g`, so the
sections of `g^* G` over `p` are the sections of `G` over `V` and likewise for `G'`; hence
`φ` at `V` is `g^* φ` at `p`.

```
   V.left ───p───→ W
       ╲           │
  V.hom ╲          │ g
         ↘         ↓
                   X
```
-/
lemma Etale.isIso_app_of_isIso_localizationRestriction {W : Scheme.{u}} (g : W ⟶ X) [Etale g]
    (h : IsIso ((Etale.localizationRestriction A g inferInstance).map φ))
    (V : X.Etale) (p : V.left ⟶ W) (hp : p ≫ g = V.hom) :
    IsIso (φ.hom.app (op V)) := by
  have hpetale : Etale p := by
    have : Etale (p ≫ g) := hp ▸ V.prop
    exact MorphismProperty.of_postcomp (W' := @Etale) _ p g ‹_› ‹_›
  have h1 : IsIso (((Etale.localizationRestriction A g inferInstance).map φ).hom.app
      (op (MorphismProperty.Over.mk ⊤ p hpetale))) := inferInstance
  rw [Etale.localizationRestriction_map_hom_app] at h1
  have e : (MorphismProperty.Over.map ⊤ (inferInstance : Etale g)).obj
      (MorphismProperty.Over.mk ⊤ p hpetale) ≅ V :=
    MorphismProperty.Over.isoMk (Iso.refl _) (by simpa using hp.symm)
  exact @NatTrans.isIso_app_of_iso _ _ _ _ _ _ φ.hom _ _ e.op h1

/-- **The restrictions along a jointly surjective family of étale morphisms are jointly
conservative.** A morphism of sheaves on the small étale site of `X` which becomes invertible
after restricting along every member of an étale cover of `X` is invertible.

Each étale `X`-scheme `V` is covered by its base changes `V ×_X W i`, and the structure
morphism of every member of the sieve they generate factors through one of the `g i`, where
the previous lemma applies.

```
     V ×_X W i ─────→ W i
         │            │ g i
         ↓            ↓
         V ─────────→ X
```
-/
lemma Etale.isIso_of_isIso_localizationRestriction {ι : Type*} {W : ι → Scheme.{u}}
    (g : ∀ i, W i ⟶ X) [∀ i, Etale (g i)]
    (hg : ⋃ i, Set.range (g i).base = Set.univ)
    (h : ∀ i, IsIso ((Etale.localizationRestriction A (g i) inferInstance).map φ)) :
    IsIso φ := by
  refine Sheaf.isIso_of_isIso_app_of_mem _ φ fun V ↦
    ⟨_, Scheme.Etale.ofArrows_baseChange_mem_smallEtaleTopology V g hg, ?_⟩
  -- a member of the sieve generated by the base changes is a morphism `a` from an étale
  -- `X`-scheme `T` to the `i`-th base change `V ×_X W i`, followed by the projection to `V`
  rintro T f ⟨-, a, -, ⟨i⟩, rfl⟩
  refine Etale.isIso_app_of_isIso_localizationRestriction A φ (g i) (h i) T
    (a.left ≫ pullback.snd V.hom (g i)) ?_
  rw [Category.assoc, ← pullback.condition]
  exact MorphismProperty.Over.w a

end AlgebraicGeometry
