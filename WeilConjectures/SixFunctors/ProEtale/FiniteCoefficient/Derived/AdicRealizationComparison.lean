module

public import WeilConjectures.Algebra.Homology.DerivedCategory.AdicTowerMap
public import WeilConjectures.Mathlib.Algebra.Homology.DerivedCategory.ExactFunctor
public import WeilConjectures.SixFunctors.ProEtale.Comparison.Linear
public import WeilConjectures.SixFunctors.ProEtale.FiniteCoefficient.Derived.AdicRealization

/-!
# The pro-étale realization of a normalized system of étale complexes

Let `R` be a commutative ring with an ideal `I = (ϖ)` generated by a nonzerodivisor, and put
`A_n = R ⧸ Iⁿ`. Given a normalized system of complexes `K_n ∈ D(X_ét, A_n)` on the small étale
site (`DerivedCategory.IsNormalizedTower`), its realization in blueprint `sk-prop-trace-adic` (i)
is the derived limit `K_R = R lim_n ν^* K_n` in `D(X_proét, R)`, where
`ν^* : Sh(X_ét) ⥤ Sh(X_proét)` is the exact comparison functor. This file proves
(`AlgebraicGeometry.ProEtale.derivedComplete_and_exists_iso_of_isNormalizedTower_comparison`):

* `K_R` is derived complete;
* `K_R ⊗ᴸ_R A_n ≅ ν^* K_n` for every `n`, compatibly with the transitions;
* if all `K_n` lie in a common range of degrees `[a, b]`, so does `K_R`.

The range statement is false for the derived limit on the étale site itself.

The proof strictifies the étale tower into a normalized adic tower of complexes
(`DerivedCategory.IsNormalizedTower.exists_iso_isNormalizedAdicTower`), which `ν^*` sends to a
normalized adic tower of pro-étale complexes (`CochainComplex.IsNormalizedAdicTower.map`). The
statements for a tower of the derived category represented by a normalized adic tower are
`DerivedCategory.exists_derivedCompletionDiagram_iso_of_iso_isNormalizedAdicTower`,
`DerivedCategory.derivedComplete_of_iso_isNormalizedAdicTower` and
`DerivedCategory.epi_homologyFunctor_map_of_iso_isNormalizedAdicTower`.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite Pretriangulated

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  {J : GrothendieckTopology C} {R : Type (u + 1)} [CommRing R] {I : Ideal R} {ϖ : R}
  {T : ℕᵒᵖ ⥤ CochainComplex (Sheaf J (ModuleCat.{u + 1} R)) ℤ}
  {K : ℕᵒᵖ ⥤ DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))}

/-- Let `K` be a tower in `D(J, R)` represented by a normalized `ϖ`-adic tower of complexes `T`,
with `I = (ϖ)` and `ϖ` a nonzerodivisor. Then the derived limit `K_R` of `K` (the point of a
homotopy limit cone `c`) satisfies `K_R ⊗ᴸ_R R ⧸ Iⁿ ≅ K_n`, compatibly with the transitions, the
legs of `c` being the reduction maps followed by these isomorphisms. -/
theorem exists_derivedCompletionDiagram_iso_of_iso_isNormalizedAdicTower
    (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ})
    (hT : CochainComplex.IsNormalizedAdicTower ϖ T) (E : T ⋙ Q ≅ K) {c : Cone K}
    (hc : IsHomotopyLimit c) :
    ∃ e : derivedCompletionDiagram J I c.pt ≅ K, ∀ n : ℕ,
      c.π.app (op n) = (derivedCompletionCone J I c.pt).π.app (op n) ≫ e.hom.app (op n) := by
  let c' : Cone (T ⋙ Q) := { pt := c.pt, π := c.π ≫ E.inv }
  have hc' : IsHomotopyLimit c' :=
    hc.of_iso E.symm c' (Iso.refl _) (fun n ↦ by simp [c'])
  obtain ⟨e', he'⟩ := exists_derivedCompletionDiagram_iso_of_isNormalizedAdicTower hϖ hI hT hc'
  refine ⟨e' ≪≫ E, fun n ↦ ?_⟩
  have h := he' n
  simp only [c', NatTrans.comp_app] at h
  calc c.π.app _ = (c.π.app (op n) ≫ E.inv.app _) ≫ E.hom.app _ := by simp
    _ = _ := by rw [h]; simp

/-- The derived limit of a tower of `D(J, R)` represented by a normalized `ϖ`-adic tower of
complexes, with `I = (ϖ)` and `ϖ` a nonzerodivisor, is derived complete. -/
theorem derivedComplete_of_iso_isNormalizedAdicTower (hϖ : ϖ ∈ nonZeroDivisors R)
    (hI : I = Ideal.span {ϖ}) (hT : CochainComplex.IsNormalizedAdicTower ϖ T) (E : T ⋙ Q ≅ K)
    {c : Cone K} (hc : IsHomotopyLimit c) : derivedComplete J I c.pt := by
  obtain ⟨e, he⟩ := exists_derivedCompletionDiagram_iso_of_iso_isNormalizedAdicTower hϖ hI hT E hc
  refine hc.of_iso e.symm _ (Iso.refl _) fun n ↦ ?_
  rw [he n]
  simp

/-- The transitions `K_{n+1} ⟶ K_n` of a tower of `D(J, R)` represented by a normalized
`ϖ`-adic tower of complexes, whose first level `K_1` lies in degrees `≤ b`, are surjective on
`H^b` (`CochainComplex.IsNormalizedAdicTower.epi_homologyMap_map`). -/
lemma epi_homologyFunctor_map_of_iso_isNormalizedAdicTower
    (hT : CochainComplex.IsNormalizedAdicTower ϖ T) (E : T ⋙ Q ≅ K) (b : ℤ)
    (hb : (K.obj (op 1)).IsLE b) (n : ℕ) :
    Epi ((homologyFunctor _ b).map (K.map (homOfLE n.le_succ).op)) := by
  have hE : K.map (homOfLE n.le_succ).op =
      (E.app (op (n + 1))).inv ≫ Q.map (T.map (homOfLE n.le_succ).op) ≫ (E.app (op n)).hom := by
    rw [← Functor.comp_map, Iso.app_hom, Iso.app_inv, E.hom.naturality, Iso.inv_hom_id_app_assoc]
  have h₁ : (T.obj (op 1)).ExactAt (b + 1) := by
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    refine (isZero_of_isLE _ b (b + 1) (by lia) (hX := hb)).of_iso ?_
    exact ((homologyFunctorFactors _ (b + 1)).app _).symm ≪≫
      (homologyFunctor _ (b + 1)).mapIso (E.app (op 1))
  have := hT.epi_homologyMap_map b h₁ n
  rw [hE, Functor.map_comp, Functor.map_comp]
  have hQ : (homologyFunctor _ b).map (Q.map (T.map (homOfLE n.le_succ).op)) = _ :=
    (NatIso.naturality_2 (homologyFunctorFactors _ b) (T.map (homOfLE n.le_succ).op)).symm
  rw [hQ]
  exact epi_comp' inferInstance (epi_comp' (epi_comp' inferInstance
    (epi_comp' this inferInstance)) inferInstance)

end DerivedCategory

namespace AlgebraicGeometry.ProEtale

variable {X : Scheme.{u}} {R : Type (u + 1)} [CommRing R] {I : Ideal R} {ϖ : R}
  {K : ℕᵒᵖ ⥤ DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} R))}
  {L : ∀ n : ℕ, DerivedCategory (Sheaf X.smallEtaleTopology (ModuleCat.{u + 1} (R ⧸ I ^ n)))}

/-- A normalized tower `K` of étale complexes, pulled back to the pro-étale site by the exact
`R`-linear functor `ν^*`, is represented by a normalized `ϖ`-adic tower of complexes of
pro-étale sheaves. -/
lemma exists_iso_isNormalizedAdicTower_comparison (hϖ : ϖ ∈ nonZeroDivisors R)
    (hI : I = Ideal.span {ϖ}) (hK : DerivedCategory.IsNormalizedTower X.smallEtaleTopology I K L) :
    ∃ (T : ℕᵒᵖ ⥤ CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R)) ℤ)
      (_ : T ⋙ DerivedCategory.Q ≅
        K ⋙ (comparisonUpperStar (ModuleCat.{u + 1} R) X).mapDerivedCategory),
      CochainComplex.IsNormalizedAdicTower ϖ T := by
  obtain ⟨T, E, hT⟩ := hK.exists_iso_isNormalizedAdicTower hϖ hI
  let F := comparisonUpperStar (ModuleCat.{u + 1} R) X
  exact ⟨T ⋙ F.mapHomologicalComplex _, Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft T F.mapDerivedCategoryFactors.symm ≪≫ (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight E _, hT.map⟩

/-- Blueprint `sk-prop-trace-adic` (i), *realization* of a normalized system of étale complexes:
let `K_n ∈ D(X_ét, R ⧸ Iⁿ)` be a normalized system (`DerivedCategory.IsNormalizedTower`) with
`I = (ϖ)`, `ϖ` a nonzerodivisor, and let `K_R = R lim_n ν^* K_n` be the derived limit in
`D(X_proét, R)` of its pullback by the comparison functor `ν^*` (the point of a homotopy limit
cone `c`). Then
1. `K_R` is derived complete;
2. `K_R ⊗ᴸ_R R ⧸ Iⁿ ≅ ν^* K_n` for every `n`, compatibly with the transitions, the legs
   `K_R ⟶ ν^* K_n` of `c` being the reduction maps followed by these isomorphisms;
3. if the `K_n` share a range of degrees `[a, b]`, then `K_R` lies in `[a, b]`.

The range statement is false for the derived limit on the étale site, which is why the
realization is taken on the pro-étale site. -/
theorem derivedComplete_and_exists_iso_of_isNormalizedTower_comparison
    (hϖ : ϖ ∈ nonZeroDivisors R) (hI : I = Ideal.span {ϖ})
    (hK : DerivedCategory.IsNormalizedTower X.smallEtaleTopology I K L)
    {c : Cone (K ⋙ (comparisonUpperStar (ModuleCat.{u + 1} R) X).mapDerivedCategory)}
    (hc : IsHomotopyLimit c) :
    DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I c.pt ∧
      (∃ e : DerivedCategory.derivedCompletionDiagram (Scheme.ProEt.topology X) I c.pt ≅
          K ⋙ (comparisonUpperStar (ModuleCat.{u + 1} R) X).mapDerivedCategory,
        ∀ n : ℕ, c.π.app (op n) =
          (DerivedCategory.derivedCompletionCone (Scheme.ProEt.topology X) I c.pt).π.app (op n) ≫
            e.hom.app (op n)) ∧
      ∀ a b : ℤ, (∀ n : ℕ, (K.obj (op n)).IsGE a ∧ (K.obj (op n)).IsLE b) →
        c.pt.IsGE a ∧ c.pt.IsLE b := by
  obtain ⟨T, E, hT⟩ := exists_iso_isNormalizedAdicTower_comparison hϖ hI hK
  refine ⟨DerivedCategory.derivedComplete_of_iso_isNormalizedAdicTower hϖ hI hT E hc,
    DerivedCategory.exists_derivedCompletionDiagram_iso_of_iso_isNormalizedAdicTower hϖ hI hT E hc,
    fun a b hab ↦ ?_⟩
  let F := comparisonUpperStar (ModuleCat.{u + 1} R) X
  have hab' (n : ℕ) : (F.mapDerivedCategory.obj (K.obj (op n))).IsGE a ∧
      (F.mapDerivedCategory.obj (K.obj (op n))).IsLE b := by
    have := (hab n).1
    have := (hab n).2
    exact ⟨F.isGE_mapDerivedCategory_obj _ a, F.isLE_mapDerivedCategory_obj _ b⟩
  have := CountableAB4Star.ofShape
    (C := Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R)) ℕ
  exact DerivedCategory.isGE_and_isLE_of_isHomotopyLimit hc a b hab'
    (DerivedCategory.epi_homologyFunctor_map_of_iso_isNormalizedAdicTower hT E b (hab' 1).2)
    fun _ _ hP t ht hF ↦ epi_one_sub_of_epi hP t ht hF

end AlgebraicGeometry.ProEtale
