module

public import WeilConjectures.Algebra.Homology.DerivedCategory.TowerLimitRange
public import WeilConjectures.AlgebraicGeometry.ProEtale.Replete
public import WeilConjectures.AlgebraicGeometry.ProEtale.WeaklyContractible
public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.NormalizedTowerLimit
public import WeilConjectures.CategoryTheory.Sites.WeaklyContractibleProducts

/-!
# The adic realization of a normalized system on the pro-étale site

Let `R` be a commutative ring with an ideal `I = (ϖ)` generated by a nonzerodivisor (the intended
case being `R = 𝒪_E` and `I = 𝔪_E` for a finite extension `E` of `ℚ_ℓ`), and put
`A_n = R ⧸ Iⁿ`. For a normalized system of complexes `K_n ∈ D(X_proét, A_n)`
(`DerivedCategory.IsNormalizedTower`), with derived limit `K_R = R lim_n K_n` in
`D(X_proét, R)`, this file proves item (i) of blueprint `sk-prop-trace-adic`
(`AlgebraicGeometry.ProEtale.derivedComplete_and_exists_iso_of_isNormalizedTower`):

* `K_R` is derived complete;
* `K_R ⊗ᴸ_R A_n ≅ K_n` for every `n`, compatibly with the transitions;
* if all `K_n` lie in a common range of degrees `[a, b]`, so does `K_R`.

The first two hold on any site (`WeilConjectures.CategoryTheory.DerivedCategory.Complete`
`.NormalizedTowerLimit`). The third uses the pro-étale site: countable products of sheaves are
exact, so the cohomology of `K_R` sits in the exact sequences
`0 ⟶ R¹lim_n H^{i-1}(K_n) ⟶ Hⁱ(K_R) ⟶ lim_n Hⁱ(K_n) ⟶ 0`; in the top degree `b` the transitions
`H^b(K_{n+1}) ⟶ H^b(K_n)` are surjective (right exactness of the base change in the top degree),
and the pro-étale site is covered by weakly contractible objects, so the `R¹lim` term vanishes.
On the small étale site the range statement fails (the `R¹lim` of a tower of surjections need
not vanish), which is why the realization is taken on the pro-étale site.

The hypotheses of the blueprint that the levels are bounded constructible of finite Tor
amplitude, with a common Tor amplitude, are not needed.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite Pretriangulated

namespace AlgebraicGeometry.ProEtale

variable {X : Scheme.{u}}

/-- On the pro-étale site, `1 - t` is an epimorphism on a product `∏ Fₙ` of the terms of a tower
`F` of sheaves of modules with epimorphic transitions, `t` being the transition endomorphism:
the `R¹lim` of such a tower vanishes. The site is covered by weakly contractible objects
(Stacks 0990), on which this is the Mittag-Leffler property of towers of surjections. -/
lemma epi_one_sub_of_epi {Λ : Type (u + 1)} [Ring Λ]
    {F : ℕᵒᵖ ⥤ Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)}
    {P : Fan fun n : ℕ ↦ F.obj (op n)} (hP : IsLimit P) (t : P.pt ⟶ P.pt)
    (ht : ∀ n : ℕ, t ≫ P.proj n = P.proj (n + 1) ≫ F.map (homOfLE n.le_succ).op)
    (hF : ∀ n : ℕ, Epi (F.map (homOfLE n.le_succ).op)) : Epi (𝟙 P.pt - t) :=
  GrothendieckTopology.epi_one_sub_of_forall_exists.{u + 1, u}
    (fun W : X.ProEt ↦ IsAffine W.left ∧
      (Scheme.ProEt.topology X).IsWeaklyContractible.{u + 1} W)
    (fun V ↦ Scheme.ProEt.exists_isWeaklyContractible_cover V) (fun _ hW ↦ hW.2) hP t ht hF

variable {R : Type (u + 1)} [CommRing R] {I : Ideal R} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R)
  (hI : I = Ideal.span {ϖ})
  {K : ℕᵒᵖ ⥤ DerivedCategory (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R))}
  {L : ∀ n : ℕ,
    DerivedCategory (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} (R ⧸ I ^ n)))}
  (hK : DerivedCategory.IsNormalizedTower (Scheme.ProEt.topology X) I K L) {c : Cone K}
  (hc : IsHomotopyLimit c)

include hϖ hI hK hc in
/-- Blueprint `sk-prop-trace-adic` (i), cohomological range: if all levels of a normalized
system on the pro-étale site lie in a common range of degrees `[a, b]`, so does its realization
`K_R = R lim_n K_n`. -/
theorem isGE_and_isLE_of_isNormalizedTower (a b : ℤ)
    (hab : ∀ n : ℕ, (K.obj (op n)).IsGE a ∧ (K.obj (op n)).IsLE b) :
    c.pt.IsGE a ∧ c.pt.IsLE b := by
  have := CountableAB4Star.ofShape
    (C := Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R)) ℕ
  exact DerivedCategory.isGE_and_isLE_of_isHomotopyLimit hc a b hab
    (hK.epi_homologyFunctor_map hϖ hI b (hab 1).2)
    fun _ _ hP t ht hF ↦ epi_one_sub_of_epi hP t ht hF

include hϖ hI hK hc in
/-- Blueprint `sk-prop-trace-adic` (i), *realization*: let `K_n ∈ D(X_proét, R ⧸ Iⁿ)` be a
normalized system (`DerivedCategory.IsNormalizedTower`) and `K_R = R lim_n K_n` its derived
limit in `D(X_proét, R)` (the point of a homotopy limit cone `c`). Then
1. `K_R` is derived complete;
2. `K_R ⊗ᴸ_R R ⧸ Iⁿ ≅ K_n` for every `n`, compatibly with the transitions, the legs
   `K_R ⟶ K_n` of `c` being the reduction maps followed by these isomorphisms;
3. if the `K_n` share a range of degrees `[a, b]`, then `K_R` lies in `[a, b]`. -/
theorem derivedComplete_and_exists_iso_of_isNormalizedTower :
    DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I c.pt ∧
      (∃ e : DerivedCategory.derivedCompletionDiagram (Scheme.ProEt.topology X) I c.pt ≅ K,
        ∀ n : ℕ, c.π.app (op n) =
          (DerivedCategory.derivedCompletionCone (Scheme.ProEt.topology X) I c.pt).π.app (op n) ≫
            e.hom.app (op n)) ∧
      ∀ a b : ℤ, (∀ n : ℕ, (K.obj (op n)).IsGE a ∧ (K.obj (op n)).IsLE b) →
        c.pt.IsGE a ∧ c.pt.IsLE b :=
  ⟨hK.derivedComplete hϖ hI hc, hK.exists_derivedCompletionDiagram_iso hϖ hI hc,
    fun a b hab ↦ isGE_and_isLE_of_isNormalizedTower hϖ hI hK hc a b hab⟩

end AlgebraicGeometry.ProEtale
