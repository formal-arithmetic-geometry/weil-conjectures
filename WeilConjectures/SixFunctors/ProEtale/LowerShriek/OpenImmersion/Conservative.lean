module

public import WeilConjectures.Mathlib.AlgebraicGeometry.Sites.Proetale
public import WeilConjectures.Mathlib.CategoryTheory.NatIso
public import WeilConjectures.Mathlib.CategoryTheory.Sites.Sheaf
public import WeilConjectures.SixFunctors.ProEtale.LowerShriek.OpenImmersion.Defs

/-!
# Restriction along a pro-étale cover is conservative

This is the pro-étale counterpart of
`WeilConjectures.SixFunctors.Etale.LowerShriek.OpenImmersion.Conservative`.

Let `g i : W i ⟶ X` be a pro-étale covering family, that is, a family of weakly étale
morphisms whose associated presieve lies in `AlgebraicGeometry.Scheme.proetalePrecoverage`.
This file proves that a morphism of sheaves on the small pro-étale site of `X` which becomes
invertible after restricting along every `g i` is itself invertible
(`AlgebraicGeometry.ProEtale.isIso_of_isIso_localizationRestriction`). Here restriction is
the functor `AlgebraicGeometry.ProEtale.localizationRestriction` of
`WeilConjectures.SixFunctors.ProEtale.LowerShriek.OpenImmersion.Defs`, which for an open
immersion is `AlgebraicGeometry.ProEtale.openImmersionRestriction`.

Note the difference with the étale statement: joint surjectivity of the `g i` is *not*
enough, since the pro-étale topology imposes a quasi-compactness condition on covers as
well. The hypothesis is membership in the pro-étale precoverage, which by
`AlgebraicGeometry.Scheme.zariskiPrecoverage_le_proetalePrecoverage` is in particular
satisfied by a Zariski open cover.

The statement is proved objectwise, from the general local criterion
`CategoryTheory.Sheaf.isIso_of_isIso_app_of_mem`: a morphism of sheaves is invertible as soon
as, at every object of the site, it is invertible on the members of some covering sieve. At a
weakly étale `X`-scheme `V` the covering sieve used is the one generated by the base changes
`V ×_X W i` (`AlgebraicGeometry.Scheme.ProEt.ofArrows_baseChange_mem_topology`).
Every member of that sieve factors through one of the base changes, hence through the
corresponding `g i`, where the objectwise statement below applies.

That objectwise statement holds because a weakly étale `X`-scheme `V` whose structure
morphism factors as `p ≫ g` is the image of the weakly étale `W`-scheme `p` under the
localization functor along `g`. The sections of a restricted sheaf over a weakly étale
`W`-scheme are by definition the sections of the original sheaf over its image
(`AlgebraicGeometry.ProEtale.localizationRestriction_map_hom_app`), so invertibility
of the restricted morphism transports back along `CategoryTheory.NatTrans.isIso_app_of_iso`.

## Main results

- `AlgebraicGeometry.ProEtale.isIso_app_of_isIso_localizationRestriction`: a morphism of
  sheaves whose restriction along a weakly étale `g : W ⟶ X` is invertible is invertible at
  every weakly étale `X`-scheme whose structure morphism factors through `g`.
- `AlgebraicGeometry.ProEtale.isIso_of_isIso_localizationRestriction`: the restrictions
  along a pro-étale covering family are jointly conservative.
-/

@[expose] public section

universe u' u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry

variable (A : Type u') [Category.{u + 1} A]
variable {X : Scheme.{u}} {G G' : Sheaf (Scheme.ProEt.topology X) A} (φ : G ⟶ G')

/-- **Invertibility of `g^* φ` gives invertibility of `φ` at every `V` factoring through
`g`.** If the structure morphism of a weakly étale `X`-scheme `V` factors through `g`, then
`V` is the image of the weakly étale `W`-scheme `p` under the localization functor along
`g`, so the sections of `g^* G` over `p` are the sections of `G` over `V` and likewise for
`G'`; hence `φ` at `V` is `g^* φ` at `p`.

```
   V.left ───p───→ W
       ╲           │
  V.hom ╲          │ g
         ↘         ↓
                   X
```
-/
lemma ProEtale.isIso_app_of_isIso_localizationRestriction {W : Scheme.{u}} (g : W ⟶ X)
    [WeaklyEtale g]
    (h : IsIso ((ProEtale.localizationRestriction A g inferInstance).map φ))
    (V : X.ProEt) (p : V.left ⟶ W) (hp : p ≫ g = V.hom) :
    IsIso (φ.hom.app (op V)) := by
  have hpweaklyEtale : WeaklyEtale p := by
    have : WeaklyEtale (p ≫ g) := hp ▸ V.prop
    exact MorphismProperty.of_postcomp (W := @WeaklyEtale) (W' := @WeaklyEtale) p g ‹_› ‹_›
  have h1 : IsIso (((ProEtale.localizationRestriction A g inferInstance).map φ).hom.app
      (op (MorphismProperty.Over.mk ⊤ p hpweaklyEtale))) := inferInstance
  rw [ProEtale.localizationRestriction_map_hom_app] at h1
  have e : (MorphismProperty.Over.map ⊤ (inferInstance : WeaklyEtale g)).obj
      (MorphismProperty.Over.mk ⊤ p hpweaklyEtale) ≅ V :=
    MorphismProperty.Over.isoMk (Iso.refl _) (by simpa using hp.symm)
  exact @NatTrans.isIso_app_of_iso _ _ _ _ _ _ φ.hom _ _ e.op h1

/-- **The restrictions along a pro-étale covering family are jointly conservative.** A
morphism of sheaves on the small pro-étale site of `X` which becomes invertible after
restricting along every member of a pro-étale cover of `X` is invertible.

Each weakly étale `X`-scheme `V` is covered by its base changes `V ×_X W i`, and the
structure morphism of every member of the sieve they generate factors through one of the
`g i`, where the previous lemma applies.

```
     V ×_X W i ─────→ W i
         │            │ g i
         ↓            ↓
         V ─────────→ X
```
-/
lemma ProEtale.isIso_of_isIso_localizationRestriction {ι : Type*} {W : ι → Scheme.{u}}
    (g : ∀ i, W i ⟶ X) [∀ i, WeaklyEtale (g i)]
    (hg : Presieve.ofArrows W g ∈ Scheme.proetalePrecoverage X)
    (h : ∀ i, IsIso ((ProEtale.localizationRestriction A (g i) inferInstance).map φ)) :
    IsIso φ := by
  refine Sheaf.isIso_of_isIso_app_of_mem _ φ fun V ↦
    ⟨_, Scheme.ProEt.ofArrows_baseChange_mem_topology V g hg, ?_⟩
  -- a member of the sieve generated by the base changes is a morphism `a` from a weakly
  -- étale `X`-scheme `T` to the `i`-th base change `V ×_X W i`, followed by the projection
  -- to `V`
  rintro T f ⟨-, a, -, ⟨i⟩, rfl⟩
  refine ProEtale.isIso_app_of_isIso_localizationRestriction A φ (g i) (h i) T
    (a.left ≫ pullback.snd V.hom (g i)) ?_
  rw [Category.assoc, ← pullback.condition]
  exact MorphismProperty.Over.w a

end AlgebraicGeometry
