module
public import WeilConjectures.SixFunctors.ProEtale.InternalCompletionSectionTransport
import all WeilConjectures.AlgebraicGeometry.ConstantCompletionCore
import all WeilConjectures.AlgebraicGeometry.IntegralConstantCompletion
import WeilConjectures.SixFunctors.ProEtale.InternalDiscreteQuotientComparison

/-! # A global generator of the constant residue kernel

Source: integral-models proof (1), Stacks Tags 099I, 099L and 0A0E.
(auxiliary; not a blueprint node).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
set_option backward.isDefEq.respectTransparency false
universe u
open CategoryTheory CategoryTheory.Limits Opposite
open scoped CategoryTheory.Obj
attribute [local irreducible] AlgebraicGeometry.ProEtale.upperStarFromPoint
namespace AlgebraicGeometry.ProEtale.InternalCompletionTransport
private theorem generating_list_of_span
    {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
    {R : Sheaf J CommRingCat.{u}} (K : RingedSiteIdeal R)
    (a : (R.obj ⋙ forget CommRingCat).sections)
    (h : ∀ V, K.sections V = Ideal.span {a.val (op V)}) (U : C) :
    IsRingedIdealGeneratingList R K.module K.inclusion U 1
      (fun _ ↦ a.val (op U)) := by
  let b : Fin 1 → ((R.over U).obj ⋙ forget CommRingCat).sections := fun _ ↦
    { val := fun V ↦ a.val (op V.unop.left)
      property := fun g ↦ a.property ((Over.forget U).op.map g) }
  obtain ⟨σ, e, he⟩ := ConstantCompletion.ideal_generated_global_sections
    (R.over U) (ConstantCompletion.overIdeal K U) 1 b (fun V ↦ by
      change K.sections V.left = Ideal.span (Set.range (fun _ : Fin 1 ↦ a.val (op V.left)))
      simpa only [Set.range_const] using h V.left)
  refine ⟨σ, e, fun i ↦ ?_⟩
  exact congrArg (fun s ↦ s.val (op (Over.mk (𝟙 U)))) (he i)

variable (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
    [Algebra (Padic l) E] [FiniteDimensional (Padic l) E] (X : Scheme.{u})

/-- The kernel of the first constant residue map has a singleton global generating list.

Source: integral-models proof (1); Stacks Tags 099I and 099L; the coefficient
integers are a discrete valuation ring.
(auxiliary; not a blueprint node).

Proof: compare the actual discrete quotient with the standard constant quotient
using discrete_quotient_comparison. The first coefficient ideal lifts to the ideal
generated by the lifted uniformizer. The existing constant-coefficient kernel formula
therefore identifies the standard kernel with the principal ideal of its constant
section. Evaluate the commuting comparison square objectwise. The comparison maps
are bijective, so the actual kernel is the ideal image of that principal ideal, hence
the principal ideal of the transported global section. Restrict this section to each
slice and apply ideal_generated_global_sections to its singleton list. Evaluating the
inclusion equality at the terminal slice object gives IsRingedIdealGeneratingList.
The zero ring and the empty scheme need no separate argument. Decomposing through the
coefficient comparison postpones no ideal-generation step.
-/
theorem residue_generator [IsNoetherian X] :
    ∃ a : ((ring l E X).obj ⋙ forget CommRingCat).sections,
      ∀ U : Scheme.coefficientProEtaleSiteModel.{u, u} X,
        IsRingedIdealGeneratingList (ring l E X)
          (ConstantCompletion.kernelIdeal (residue l E X)).module
          (ConstantCompletion.kernelIdeal (residue l E X)).inclusion U 1
          (fun _ ↦ a.val (op U)) := by
  let t : ULift.{u + 1} (Padic.coefficientExtensionIntegers l E) :=
    ULift.up (Padic.coefficientExtensionUniformizer l E)
  have hI : Ideal.map ULift.ringEquiv.symm.toRingHom
      (Padic.coefficientExtensionIdeal l E 1) = IntegralConstantCompletion.ideal l E := by
    simp only [Padic.coefficientExtensionIdeal, pow_one, IntegralConstantCompletion.ideal,
      Ideal.map_span, Set.image_singleton]
    rfl
  have hc := IntegralModelsStacks.discrete_quotient_comparison X
    (Padic.coefficientExtensionIntegers l E) (Padic.coefficientExtensionIdeal l E 1)
  dsimp only at hc
  rw [hI] at hc
  obtain ⟨e, f, hf⟩ := hc
  let b := ConstantCompletion.algebraSection e.hom t
  refine ⟨b, fun U ↦ generating_list_of_span _ b (fun V ↦ ?_) U⟩
  have hK : (ConstantCompletion.kernelIdeal (residue l E X)).sections V =
      RingHom.ker ((residue l E X).hom.app (op V)).hom :=
    (ConstantCompletion.kernelIdeal_existsUnique (residue l E X)).exists.choose_spec V
  rw [hK]
  have hk := IntegralConstantCompletion.finite_kernel l E X false 0 V
  simp only [Nat.zero_add, pow_one] at hk
  have hs : RingHom.ker ((residue l E X).hom.app (op V)).hom =
      Ideal.map (e.hom.hom.app (op V)).hom
        (RingHom.ker ((IntegralConstantCompletion.quotientMap l E X false 0).hom.app
          (op V)).hom) := by
    ext x
    rw [Ideal.mem_map_iff_of_surjective _ (ConcreteCategory.bijective_of_isIso
      (e.hom.hom.app (op V))).surjective]
    constructor
    · intro hx
      refine ⟨e.inv.hom.app (op V) x, ?_, ?_⟩
      · change (IntegralConstantCompletion.quotientMap l E X false 0).hom.app (op V)
          (e.inv.hom.app (op V) x) = 0
        apply (ConcreteCategory.bijective_of_isIso (f.hom.hom.app (op V))).injective
        have hh := ConcreteCategory.congr_hom
          (congrArg (fun q ↦ q.hom.app (op V)) hf) (e.inv.hom.app (op V) x)
        change f.hom.hom.app (op V)
          ((IntegralConstantCompletion.quotientMap l E X false 0).hom.app (op V)
            (e.inv.hom.app (op V) x)) =
          (residue l E X).hom.app (op V)
            (e.hom.hom.app (op V) (e.inv.hom.app (op V) x)) at hh
        have he : e.hom.hom.app (op V) (e.inv.hom.app (op V) x) = x :=
          ConcreteCategory.congr_hom
            (congrArg (fun q ↦ q.hom.app (op V)) e.inv_hom_id) x
        rw [he, hx] at hh
        simpa only [map_zero] using hh
      · exact ConcreteCategory.congr_hom
          (congrArg (fun q ↦ q.hom.app (op V)) e.inv_hom_id) x
    · rintro ⟨y, hy, rfl⟩
      change (residue l E X).hom.app (op V) (e.hom.hom.app (op V) y) = 0
      have hh := ConcreteCategory.congr_hom
        (congrArg (fun q ↦ q.hom.app (op V)) hf) y
      change f.hom.hom.app (op V)
        ((IntegralConstantCompletion.quotientMap l E X false 0).hom.app (op V) y) =
        (residue l E X).hom.app (op V) (e.hom.hom.app (op V) y) at hh
      change (IntegralConstantCompletion.quotientMap l E X false 0).hom.app (op V) y = 0
        at hy
      rw [hy, map_zero] at hh
      exact hh.symm
  rw [hs, hk, Ideal.map_span, Set.image_singleton]
  rfl

end AlgebraicGeometry.ProEtale.InternalCompletionTransport
