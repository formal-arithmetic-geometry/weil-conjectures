module

public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.Completion
public import WeilConjectures.SixFunctors.ProEtale.Derived.LowerShriekBaseChange
public import WeilConjectures.SixFunctors.ProEtale.Derived.ScalarExtension

/-!
# The completed exchange transformations on the pro-étale site

Let `R` be a commutative ring and `I = (ϖ)` an ideal generated by a nonzerodivisor (the intended
case is `R = 𝒪_E`, `I = 𝔪_E`). At the adic stages the six operations act on the derived complete
objects of `D(X_proét, R)`, and the pullback has to be completed: the *completed pullback* of
blueprint `def-weil-pbc-completed-pullback` is

`Lg^*_comp K = (Lg^* K)^ = R lim_n (Lg^* K ⊗ᴸ R/Iⁿ)`,

the derived completion (`DerivedCategory.derivedCompletion`) of the ordinary derived pullback.

For a commutative square of schemes

```
  X' --g'--> X
  |          |
  f'         f
  ↓          ↓
  Y' --g---> Y
```

this file constructs the *completed exchange transformations* of blueprint `sk-def-sf-exchanges`:

* the completed direct-image exchange `Ex_*^comp : Lg^*_comp Rf_* ⟶ Rf'_* Lg'^*_comp`, obtained
  from `Ex_*` by completing, `Rf'_*` preserving derived complete objects;
* for an open-immersion square, the completed extension-by-zero comparison
  `j'_! Lg_U^*_comp ⟶ Lg^*_comp j_!`, which is an isomorphism on derived complete objects by
  blueprint `lem-cbc-completed-extension-zero-comparison`;
* for a cartesian square and a compactification `c = (X ⟶[j] X̄ ⟶[p] Y)` of `f`, the completed
  compact-support exchange `Ex_!^comp : Lg^*_comp Rf_! ⟶ Rf'_! Lg'^*_comp` on derived complete
  objects (blueprint `def-cbc-completed-exchange-map`): `Ex_*^comp` for `p` at `j_! K`, followed
  by the inverse of the completed extension-by-zero comparison.

## Main definitions

- `AlgebraicGeometry.ProEtale.completedUpperStar`: `Lg^*_comp`.
- `AlgebraicGeometry.ProEtale.completedDerivedBaseChangeMap`: `Ex_*^comp`.
- `AlgebraicGeometry.ProEtale.completedOpenImmersionLowerShriekBaseChangeMap`: the completed
  extension-by-zero comparison.
- `AlgebraicGeometry.ProEtale.completedRightDerivedLowerShriekOfCompactificationBaseChangeMap`,
  `AlgebraicGeometry.ProEtale.completedRightDerivedLowerShriekBaseChangeMap`: `Ex_!^comp`.

## Implementation notes

As everywhere in the project (see `WeilConjectures.SixFunctors.ProEtale.TraceFormula.Adic`), the
adic stage is modelled inside the single derived category `D(X_proét, R)` of sheaves of
`R`-modules, the derived complete objects forming the full subcategory
`DerivedCategory.derivedComplete`.

The inverse of the completed extension-by-zero comparison is only available on derived complete
objects, so `Ex_!^comp` is a natural transformation of functors on the full subcategory of
derived complete objects of `D(X_proét, R)`. That the comparison is an isomorphism there is
blueprint `lem-cbc-completed-extension-zero-comparison` of the compact-support base change
subsection, recorded as
`AlgebraicGeometry.ProEtale.isIso_completedOpenImmersionLowerShriekBaseChangeMap_app`.
-/

@[expose] public section

universe u

open CategoryTheory Limits Pretriangulated

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace ProEtale

variable {R : Type (u + 1)} [CommRing R] (I : Ideal R)
  (hI : ∃ ϖ ∈ nonZeroDivisors R, I = Ideal.span {ϖ})

set_option hygiene false in
/-- The derived category `D(X_proét, R)` of pro-étale sheaves of `R`-modules on `X`. -/
local notation "𝐃(" X ")" =>
  _root_.DerivedCategory (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R))

set_option hygiene false in
/-- The derived complete objects of `D(X_proét, R)`. -/
local notation "𝐂(" X ")" =>
  (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).FullSubcategory

section Completion

/-- The derived completion `K ↦ K^` of `D(X_proét, R)`, as an endofunctor. -/
noncomputable abbrev completion (X : Scheme.{u}) : 𝐃(X) ⥤ 𝐃(X) :=
  _root_.DerivedCategory.derivedCompletion (Scheme.ProEt.topology X) I hI ⋙
    (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι

/-- The unit `K ⟶ K^` of the derived completion. -/
noncomputable abbrev completionUnit (X : Scheme.{u}) : 𝟭 𝐃(X) ⟶ completion I hI X :=
  (_root_.DerivedCategory.derivedCompletionAdjunction (Scheme.ProEt.topology X) I hI).unit

/-- Blueprint `def-weil-pbc-completed-pullback`: Completed pullback.

The **completed pullback** `Lg^*_comp K = (Lg^* K)^ = R lim_n (Lg^* K ⊗ᴸ R/Iⁿ)` along
`g : T' ⟶ T`, as a functor `D(T_proét, R) ⥤ D_comp(T'_proét, R)` into the derived complete
objects: the derived completion of the derived pullback. The comparison from the ordinary
pullback is the completion map of `Lg^* K` (`AlgebraicGeometry.ProEtale.completionUnit`). -/
noncomputable def completedUpperStar {T' T : Scheme.{u}} (g : T' ⟶ T) : 𝐃(T) ⥤ 𝐂(T') :=
  L((g)^*[ModuleCat.{u + 1} R]) ⋙
    _root_.DerivedCategory.derivedCompletion (Scheme.ProEt.topology T') I hI

end Completion

section LowerStar

variable {I}

include hI in
/-- **`Rf_*` preserves derived completeness** on the pro-étale sites: for `I = (ϖ)` with `ϖ` a
nonzerodivisor, derived completeness is right orthogonality to the objects on which `ϖ` acts
invertibly, and a map `Z ⟶ Rf_* K` is the transpose of a map `Lf^* Z ⟶ K`, on whose source `ϖ`
acts invertibly, `Lf^*` being `R`-linear. -/
theorem derivedComplete_rightDerivedLowerStar {X Y : Scheme.{u}} (f : X ⟶ Y) (K : 𝐃(X))
    (hK : _root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I K) :
    _root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology Y) I
      ((R((f)_*[ModuleCat.{u + 1} R])).obj K) := by
  obtain ⟨ϖ, hϖ, hϖI⟩ := hI
  rw [_root_.DerivedCategory.derivedComplete_iff_rightOrthogonal hϖ hϖI] at hK ⊢
  intro Z g (hZ : IsIso (ϖ • 𝟙 Z))
  let adj := derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} R) f
  have hZ' : IsIso (ϖ • 𝟙 ((L((f)^*[ModuleCat.{u + 1} R])).obj Z)) := by
    rw [← CategoryTheory.Functor.map_id, ← Functor.map_smul]
    infer_instance
  have h := hK ((adj.homEquiv _ _).symm g) hZ'
  rw [← (adj.homEquiv _ _).apply_symm_apply g, h, Adjunction.homEquiv_unit,
    Functor.map_zero, Limits.comp_zero]

variable (I)

/-- The restriction of `Rf_*` to the derived complete objects. -/
noncomputable def completeRightDerivedLowerStar {X Y : Scheme.{u}} (f : X ⟶ Y) : 𝐂(X) ⥤ 𝐂(Y) :=
  ObjectProperty.lift _
    ((_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι ⋙
      R((f)_*[ModuleCat.{u + 1} R]))
    (fun K ↦ derivedComplete_rightDerivedLowerStar hI f K.1 K.2)

end LowerStar

section Square

variable {X' X Y' Y : Scheme.{u}} {g' : X' ⟶ X} {f' : X' ⟶ Y'} {f : X ⟶ Y} {g : Y' ⟶ Y}

/-- The **completed direct-image exchange** `Ex_*^comp : Lg^*_comp Rf_* ⟶ Rf'_* Lg'^*_comp` of a
commutative square `g' ≫ f = f' ≫ g`, as a natural transformation of functors
`D(X_proét, R) ⥤ D_comp(Y'_proét, R)`: the derived completion of the exchange map
`Ex_* : Lg^* Rf_* ⟶ Rf'_* Lg'^*` (`AlgebraicGeometry.ProEtale.derivedBaseChangeMap`) followed
by `Rf'_*` of the completion map `Lg'^* ⟶ Lg'^*_comp`, extended to `(Lg^* Rf_* K)^` through the
universal property of the completion, `Rf'_* Lg'^*_comp K` being derived complete. This is the
map `Ex^comp_{□,K}` of blueprint `thm-weil-pbc-complete-proetale`, an isomorphism for `f`
proper and `K` derived complete with étale-origin reductions. -/
noncomputable def completedDerivedBaseChangeMap (sq : CommSq g' f' f g) :
    R((f)_*[ModuleCat.{u + 1} R]) ⋙ completedUpperStar I hI g ⟶
      completedUpperStar I hI g' ⋙ completeRightDerivedLowerStar I hI f' :=
  Functor.whiskerRight
      (derivedBaseChangeMap (ModuleCat.{u + 1} R) sq ≫
        Functor.whiskerLeft L((g')^*[ModuleCat.{u + 1} R])
          (Functor.whiskerRight (completionUnit I hI X') R((f')_*[ModuleCat.{u + 1} R])))
      (_root_.DerivedCategory.derivedCompletion (Scheme.ProEt.topology Y') I hI) ≫
    Functor.whiskerLeft (completedUpperStar I hI g' ⋙ completeRightDerivedLowerStar I hI f')
      (_root_.DerivedCategory.derivedCompletionAdjunction (Scheme.ProEt.topology Y') I hI).counit

end Square

section OpenImmersion

variable {I}

include hI in
/-- Let `F : D(X_proét, R) ⥤ D(Y_proét, R)` be a triangulated `R`-linear functor. Then the
derived completion inverts `F` applied to a completion map `N ⟶ N^`: its cone is `F` of an
object on which `ϖ` acts invertibly, and `ϖ` acts invertibly on its image under the `R`-linear
`F`. -/
lemma isIso_completion_map_map_completionUnit_app {X Y : Scheme.{u}} (F : 𝐃(X) ⥤ 𝐃(Y))
    [F.CommShift ℤ] [F.IsTriangulated] [F.Linear R] (N : 𝐃(X)) :
    IsIso ((_root_.DerivedCategory.derivedCompletion (Scheme.ProEt.topology Y) I hI).map
      (F.map ((completionUnit I hI X).app N))) := by
  obtain ⟨Z, g, h', hT, hZ⟩ :=
    _root_.DerivedCategory.exists_distinguished_derivedCompletionAdjunction_unit_app (I := I)
      (h := hI) N
  refine _root_.DerivedCategory.isIso_derivedCompletion_map (h := hI)
    (F.map_distinguished _ hT) ?_
  change IsIso (hI.choose • 𝟙 (F.obj Z))
  have hZ' : IsIso (hI.choose • 𝟙 Z) := hZ
  rw [← CategoryTheory.Functor.map_id, ← Functor.map_smul]
  infer_instance

variable (I)

variable {U' U Z' Z : Scheme.{u}} {g' : U' ⟶ U} {j' : U' ⟶ Z'} {j : U ⟶ Z} {g'' : Z' ⟶ Z}
  [IsOpenImmersion j] [IsOpenImmersion j']

/-- The extension by zero `j_!` along an open immersion is `R`-linear, being left adjoint to the
`R`-linear restriction `j^*`. -/
instance linear_openImmersionLowerShriek : ((j)_!open[ModuleCat.{u + 1} R]).Linear R :=
  (ProEtale.openImmersionLowerShriekUpperStarAdjunction (ModuleCat.{u + 1} R) j).left_adjoint_linear

/-- The completion map `j'_!(N) ⟶ j'_!(N^)` becomes an isomorphism after completion. -/
noncomputable def completionMapOpenImmersionLowerShriek :
    L((g')^*[ModuleCat.{u + 1} R]) ⋙ D((j')_!open[ModuleCat.{u + 1} R]) ⋙ completion I hI Z' ⟶
      completedUpperStar I hI g' ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology U') I).ι ⋙
        D((j')_!open[ModuleCat.{u + 1} R]) ⋙ completion I hI Z' :=
  Functor.whiskerLeft L((g')^*[ModuleCat.{u + 1} R])
    (Functor.whiskerRight
      (Functor.whiskerRight (completionUnit I hI U') D((j')_!open[ModuleCat.{u + 1} R]))
      (completion I hI Z'))

instance isIso_completionMapOpenImmersionLowerShriek :
    IsIso (completionMapOpenImmersionLowerShriek I hI (g' := g') (j' := j')) := by
  have (K : 𝐃(U)) :
      IsIso ((completionMapOpenImmersionLowerShriek I hI (g' := g') (j' := j')).app K) := by
    have := isIso_completion_map_map_completionUnit_app hI
      D((j')_!open[ModuleCat.{u + 1} R]) ((L((g')^*[ModuleCat.{u + 1} R])).obj K)
    exact (inferInstance : IsIso ((_root_.DerivedCategory.derivedComplete _ I).ι.map
      ((_root_.DerivedCategory.derivedCompletion (Scheme.ProEt.topology Z') I hI).map
        (D((j')_!open[ModuleCat.{u + 1} R]).map
          ((completionUnit I hI U').app ((L((g')^*[ModuleCat.{u + 1} R])).obj K))))))
  exact NatIso.isIso_of_isIso_app _

/-- The **completed extension-by-zero comparison** `j'_! Lg_U^*_comp ⟶ Lg^*_comp j_!` for a
cartesian square `g' ≫ j = j' ≫ g''` with `j`, `j'` open immersions: at `K` it is the composite
```
j'_!((Lg'^* K)^) ⟶ (j'_!((Lg'^* K)^))^ ≅ (j'_!(Lg'^* K))^ ≅ (Lg''^* j_! K)^
```
of the completion map of `j'_!((Lg'^* K)^)`, the inverse of the completion of `j'_!` of the
completion map of `Lg'^* K` (an isomorphism by
`AlgebraicGeometry.ProEtale.isIso_completion_map_map_completionUnit_app`), and the completion of
the base change isomorphism `Lg'^* ⋙ Dj'_! ≅ Dj_! ⋙ Lg''^*`
(`AlgebraicGeometry.ProEtale.derivedOpenImmersionLowerShriekBaseChangeIso`). Its inverse, on
derived complete objects, is the comparison `Lg^*_comp j_! K ⟶ j'_! Lg_U^*_comp K` of blueprint
`lem-cbc-completed-extension-zero-comparison`. -/
noncomputable def completedOpenImmersionLowerShriekBaseChangeMap (hsq : IsPullback g' j' j g'') :
    completedUpperStar I hI g' ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology U') I).ι ⋙
        D((j')_!open[ModuleCat.{u + 1} R]) ⟶
      D((j)_!open[ModuleCat.{u + 1} R]) ⋙ completedUpperStar I hI g'' ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology Z') I).ι :=
  Functor.whiskerLeft (completedUpperStar I hI g' ⋙
      (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology U') I).ι ⋙
        D((j')_!open[ModuleCat.{u + 1} R])) (completionUnit I hI Z') ≫
    inv (completionMapOpenImmersionLowerShriek I hI (g' := g') (j' := j')) ≫
    Functor.whiskerRight
      (derivedOpenImmersionLowerShriekBaseChangeIso (ModuleCat.{u + 1} R) hsq).hom
      (completion I hI Z')

/-- Blueprint `lem-cbc-completed-extension-zero-comparison`: Completed extension-by-zero base
change.

Let `R` be a Noetherian ring and `I = (ϖ)` an ideal generated by a nonzerodivisor with every
`R/Iⁿ` finite (an adic coefficient datum, for instance `R = 𝒪_E`), let `g' ≫ j = j' ≫ g''` be an
open-immersion square, and let `K ∈ D(U_proét, R)` be derived `I`-complete. Then the canonical
comparison between `Lg''^*_comp j_! K` and `j'_! Lg'^*_comp K` is an isomorphism (natural in `K`,
being a component of a natural transformation). The comparison is spelled in the direction
`j'_! Lg'^*_comp K ⟶ Lg''^*_comp j_! K` of
`AlgebraicGeometry.ProEtale.completedOpenImmersionLowerShriekBaseChangeMap`, the direction in
which it is defined without knowing that `j'_!` preserves derived completeness. -/
theorem isIso_completedOpenImmersionLowerShriekBaseChangeMap_app [IsNoetherianRing R]
    [∀ n : ℕ, Finite (R ⧸ I ^ n)] (hsq : IsPullback g' j' j g'') (K : 𝐃(U))
    (hK : _root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology U) I K) :
    IsIso ((completedOpenImmersionLowerShriekBaseChangeMap I hI hsq).app K) :=
  sorry

end OpenImmersion

section LowerShriek

variable [IsNoetherianRing R] [∀ n : ℕ, Finite (R ⧸ I ^ n)]

variable {X' X Y' Y : Scheme.{u}} {g' : X' ⟶ X} {f' : X' ⟶ Y'} {f : X ⟶ Y} {g : Y' ⟶ Y}

instance (sq : IsPullback g' f' f g) (c : Compactification f) :
    IsIso (Functor.whiskerLeft
      (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι
      (completedOpenImmersionLowerShriekBaseChangeMap I hI (c.isPullback_i_ofIsPullback sq))) :=
  by
    have (K : 𝐂(X)) : IsIso ((Functor.whiskerLeft
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι
        (completedOpenImmersionLowerShriekBaseChangeMap I hI
          (c.isPullback_i_ofIsPullback sq))).app K) :=
      isIso_completedOpenImmersionLowerShriekBaseChangeMap_app I hI _ K.1 K.2
    exact NatIso.isIso_of_isIso_app _

/-- Blueprint `def-cbc-completed-exchange-map`: Completed compact-support exchange map.

For a cartesian square `g' ≫ f = f' ≫ g` and a compactification `c = (X ⟶[j] X̄ ⟶[p] Y)` of `f`
with base change `c ×_Y Y' = (X' ⟶[j'] X̄' ⟶[p'] Y')`, the **completed compact-support exchange
map** `Ex_!^comp(c) : Lg^*_comp Rf_!(c) K ⟶ Rf'_!(c ×_Y Y') Lg'^*_comp K` for `K ∈ D(X_proét, R)`
derived complete, as a natural transformation of functors on the derived complete objects. It
is the completed direct-image exchange `Ex_*^comp` for `p` at `j_! K`
(`AlgebraicGeometry.ProEtale.completedDerivedBaseChangeMap`), followed by `Rp'_*` of the inverse
of the completed extension-by-zero comparison `j'_! Lg'^*_comp K ≅ Lḡ^*_comp j_! K`
(`AlgebraicGeometry.ProEtale.completedOpenImmersionLowerShriekBaseChangeMap`, an isomorphism on
derived complete objects by blueprint `lem-cbc-completed-extension-zero-comparison`). -/
noncomputable def completedRightDerivedLowerShriekOfCompactificationBaseChangeMap
    (sq : IsPullback g' f' f g) (c : Compactification f) :
    (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι ⋙
        Rf_!(c)[ModuleCat.{u + 1} R] ⋙ completedUpperStar I hI g ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology Y') I).ι ⟶
      (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι ⋙
        completedUpperStar I hI g' ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X') I).ι ⋙
        Rf_!(c.ofIsPullback sq)[ModuleCat.{u + 1} R] :=
  Functor.whiskerLeft ((_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι ⋙
      D((c.i)_!open[ModuleCat.{u + 1} R]))
    (Functor.whiskerRight
      (completedDerivedBaseChangeMap I hI (IsPullback.of_hasPullback c.g g).toCommSq)
      (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology Y') I).ι) ≫
    Functor.whiskerRight
      (inv (Functor.whiskerLeft
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι
        (completedOpenImmersionLowerShriekBaseChangeMap I hI (c.isPullback_i_ofIsPullback sq))))
      R(((c.ofIsPullback sq).g)_*[ModuleCat.{u + 1} R])

/-- Blueprint `sk-def-sf-exchanges`: Exchange and projection transformations, typed (the
completed exchange `Ex_!^comp` at the adic stages).

The completed compact-support exchange `Ex_!^comp : Lg^*_comp Rf_! ⟶ Rf'_! Lg'^*_comp` on the
derived complete objects of `D(X_proét, R)`, for the chosen compactification of `f`:
`AlgebraicGeometry.ProEtale.completedRightDerivedLowerShriekOfCompactificationBaseChangeMap`
(blueprint `def-cbc-completed-exchange-map`). -/
noncomputable def completedRightDerivedLowerShriekBaseChangeMap [HasCompactification f]
    (sq : IsPullback g' f' f g) :
    (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι ⋙
        R(f)_![ModuleCat.{u + 1} R] ⋙ completedUpperStar I hI g ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology Y') I).ι ⟶
      (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X) I).ι ⋙
        completedUpperStar I hI g' ⋙
        (_root_.DerivedCategory.derivedComplete (Scheme.ProEt.topology X') I).ι ⋙
        Rf_!((HasCompactification.compactification f).ofIsPullback sq)[ModuleCat.{u + 1} R] :=
  completedRightDerivedLowerShriekOfCompactificationBaseChangeMap I hI sq _

end LowerShriek

end ProEtale

end AlgebraicGeometry
