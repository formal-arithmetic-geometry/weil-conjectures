/-!
# Finding extension data locally

Let `N` be a complex of pro-étale sheaves of `Λ`-modules on `Y`, over a Noetherian ring `Λ`, with
a perfect top part `j : c(E₀) ⟶ N` in degrees `≥ m`, and suppose that `Q(N)` is a retract of
`Q(L')` for every subcomplex `L' ⊆ N` containing finitely many given global sections `xₖ` (the
output of the local retract statement `exists_sieve_retract`). This file shows that `Q(N)`
locally has extension data in degree `m` (`AlgebraicGeometry.ProEtale.HasExtensionData`).

The subcomplex `L₀ ⊆ N` spanned by `c(E₀)` and the `xₖ` agrees with `N` in degrees `≥ m`, and
`Q(N)` is a retract of `Q(L₀)`, so `p₀ = H^m(L₀ ⊆ N)` is a split epimorphism, with section `σ`
say. Its kernel is the image of the idempotent `e = 1 - p₀ σ` of `H^m(L₀)`. Now `H^m(L₀)` is a
quotient of `Z^m(L₀) ≅ c(Z^m(E₀))`, which is globally finitely generated as `Λ` is Noetherian;
hence so is the kernel of `p₀`, generated by sections `uₜ`. Locally, each `uₜ` is the class of a
cycle of `L₀` whose image in `N` is a coboundary `d yₜ`. After pullback to the members of a
covering sieve, adding the sections `yₜ` to `L₀` gives a subcomplex `L''` with `H^m(L'' ⊆ N)` an
isomorphism (`AlgebraicGeometry.ProEtale.isLocally_hasExtensionData`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite MonoidalCategory

open scoped CategoryTheory.Functor

section Abelian

variable {C : Type*} [Category* C] [Abelian C]

/-- In an abelian category, if `q ≫ p = p₀` with `q` an epimorphism and every morphism killed by
`p₀` killed by `q`, then `p` is a monomorphism. -/
lemma CategoryTheory.mono_of_epi_of_comp_eq {X₀ X₁ X₂ : C} {q : X₀ ⟶ X₁} {p : X₁ ⟶ X₂}
    {p₀ : X₀ ⟶ X₂} [Epi q] (hq : q ≫ p = p₀)
    (h : ∀ ⦃T : C⦄ (a : T ⟶ X₀), a ≫ p₀ = 0 → a ≫ q = 0) : Mono p := by
  refine Preadditive.mono_of_cancel_zero _ fun {T} a ha ↦ ?_
  have h₁ : pullback.fst q a ≫ p₀ = 0 := by
    rw [← hq, ← Category.assoc, pullback.condition, Category.assoc, ha, comp_zero]
  have h₂ := h _ h₁
  rw [pullback.condition] at h₂
  exact (cancel_epi (pullback.snd q a)).1 (h₂.trans (comp_zero).symm)

end Abelian

namespace AlgebraicGeometry.ProEtale

open _root_.AlgebraicGeometry.Scheme Sheaf

variable {Λ : Type (u + 1)} [CommRing Λ]

/-- A chain map `φ` commutes with `toCycles`. -/
@[reassoc]
lemma toCycles_cyclesMap {C : Type*} [Category* C] [Abelian C] {K L : CochainComplex C ℤ}
    (φ : K ⟶ L) (i j : ℤ) :
    K.toCycles i j ≫ HomologicalComplex.cyclesMap φ j = φ.f i ≫ L.toCycles i j := by
  rw [← cancel_mono (L.iCycles j), Category.assoc, HomologicalComplex.cyclesMap_i,
    HomologicalComplex.toCycles_i_assoc, Category.assoc, HomologicalComplex.toCycles_i, φ.comm]

/-- A chain map which is a monomorphism in degree `i` induces a monomorphism on cycles. -/
lemma mono_cyclesMap {C : Type*} [Category* C] [Abelian C] {K L : CochainComplex C ℤ}
    (φ : K ⟶ L) (i : ℤ) [Mono (φ.f i)] : Mono (HomologicalComplex.cyclesMap φ i) := by
  have : Mono (HomologicalComplex.cyclesMap φ i ≫ L.iCycles i) := by
    rw [HomologicalComplex.cyclesMap_i]
    infer_instance
  exact mono_of_mono_fac rfl

/-- A chain map which is an isomorphism in degree `i` and a monomorphism in degree `i + 1`
induces an isomorphism on cycles. -/
lemma isIso_cyclesMap {C : Type*} [Category* C] [Abelian C] {K L : CochainComplex C ℤ}
    (φ : K ⟶ L) (i : ℤ) (h₂ : IsIso (φ.f i)) (h₃ : Mono (φ.f (i + 1))) :
    IsIso (HomologicalComplex.cyclesMap φ i) := by
  have : Mono (φ.f ((ComplexShape.up ℤ).next i)) := by
    rwa [CochainComplex.next]
  exact ShortComplex.isIso_cyclesMap_of_isIso_of_mono'
    ((HomologicalComplex.shortComplexFunctor C (.up ℤ) i).map φ) h₂ this

/-- The degree `m` cycles of the subcomplex spanned by a perfect top part `c(E₀)` (over a
Noetherian ring) and finitely many sections are globally finitely generated. -/
lemma isGloballyFinitelyGenerated_cycles_span [IsNoetherianRing Λ] {Y : Scheme.{u}} {m : ℤ}
    {N : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ}
    {E₀ : CochainComplex (ModuleCat.{u + 1} Λ) ℤ}
    (j : ((constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)).mapHomologicalComplex
      _).obj E₀ ⟶ N) (hj : ∀ i, Mono (j.f i)) (hj' : ∀ i, m ≤ i → IsIso (j.f i))
    (hfin : Module.Finite Λ (E₀.X m))
    {n : ℕ} (p : Fin n → ℤ) (x : ∀ k, (N.X (p k)).obj.obj (op (terminalProEt Y))) :
    IsGloballyFinitelyGenerated ((span j p x).cycles m) := by
  let c := constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)
  have : Epi (j.f m) := by have := hj' m le_rfl; infer_instance
  have := isIso_spanι_f j p x m
  have : IsIso (HomologicalComplex.cyclesMap j m) := isIso_cyclesMap j m (hj' m le_rfl) (hj _)
  have : IsIso (HomologicalComplex.cyclesMap (spanι j p x) m) :=
    isIso_cyclesMap _ m inferInstance inferInstance
  have : Module.Finite Λ (E₀.cycles m) :=
    Module.Finite.of_injective (E₀.iCycles m).hom
      ((ModuleCat.mono_iff_injective _).1 inferInstance)
  have e : ((c.mapHomologicalComplex (.up ℤ)).obj E₀).cycles m ≅ c.obj (E₀.cycles m) :=
    (E₀.sc m).mapCyclesIso c
  exact (IsGloballyFinitelyGenerated.constantSheaf_obj _).of_iso
    (e.symm ≪≫ asIso (HomologicalComplex.cyclesMap j m) ≪≫
      (asIso (HomologicalComplex.cyclesMap (spanι j p x) m)).symm)

/-- **Local lifting of a section of the kernel of `H^m(ι)`.** Let `ι : L ⟶ N` be a chain map
and `u` a global section of `H^m(L)` with `H^m(ι)(u) = 0`. Locally, `u` is the class of a cycle
`z` of `L` whose image in `N` is the coboundary of a section `y` of `N^{m-1}`. -/
lemma exists_sieve_homologyπ_eq_and_toCycles_eq {Y : Scheme.{u}}
    {L N : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ}
    (ι : L ⟶ N) (m : ℤ) (u : (L.homology m).obj.obj (op (terminalProEt Y)))
    (hu : (HomologicalComplex.homologyMap ι m).hom.app _ u = 0) :
    ∃ R ∈ Scheme.ProEt.topology Y (terminalProEt Y), ∀ ⦃W : Y.ProEt⦄
      (w : W ⟶ terminalProEt Y), R w →
      ∃ (z : (L.cycles m).obj.obj (op W)) (y : (N.X (m - 1)).obj.obj (op W)),
        (L.homologyπ m).hom.app _ z = (L.homology m).obj.map w.op u ∧
        (N.toCycles (m - 1) m).hom.app _ y = (HomologicalComplex.cyclesMap ι m).hom.app _ z := by
  have := (Sheaf.isLocallySurjective_iff_epi' _ (L.homologyπ m)).2 inferInstance
  have h₁ : ∀ ⦃W' : Y.ProEt⦄ (f : W' ⟶ terminalProEt Y),
      Presheaf.imageSieve (L.homologyπ m).hom u f → ∃ z : (L.cycles m).obj.obj (op W'),
        (L.homologyπ m).hom.app _ z = (L.homology m).obj.map f.op u := fun _ _ hf ↦ hf
  choose z hz using h₁
  have hS : (ShortComplex.mk (N.toCycles (m - 1) m) (N.homologyπ m)
      (N.toCycles_comp_homologyπ _ _)).Exact :=
    ShortComplex.exact_of_g_is_cokernel _ (N.homologyIsCokernel (m - 1) m (by simp))
  have h₂ (W' : Y.ProEt) (f : W' ⟶ terminalProEt Y)
      (hf : Presheaf.imageSieve (L.homologyπ m).hom u f) :=
    exists_sieve_eq_of_exact hS ((HomologicalComplex.cyclesMap ι m).hom.app _ (z f hf)) (by
      change (N.homologyπ m).hom.app _ ((HomologicalComplex.cyclesMap ι m).hom.app _
        (z f hf)) = 0
      rw [← comp_hom_app_apply, ← HomologicalComplex.homologyπ_naturality, comp_hom_app_apply,
        hz, Sheaf.hom_app_map_apply, hu, map_zero])
  choose R hR hR' using h₂
  refine ⟨Sieve.bind (Presheaf.imageSieve (L.homologyπ m).hom u).arrows (fun W' f hf ↦ R W' f hf),
    (Scheme.ProEt.topology Y).bind_covering (Presheaf.imageSieve_mem _ _ u)
      (fun W' f hf ↦ hR W' f hf), fun W w ⟨W', g, f, hf, hg, hgf⟩ ↦ ?_⟩
  subst hgf
  obtain ⟨y, hy⟩ := hR' W' f hf g hg
  refine ⟨(L.cycles m).obj.map g.op (z f hf), y, ?_, ?_⟩
  · rw [Sheaf.hom_app_map_apply, hz, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  · rw [Sheaf.hom_app_map_apply]
    exact hy

set_option maxHeartbeats 400000 in -- the section chase on the pulled back complexes is slow
/-- **Adding local coboundaries makes `H^m` injective.** Let `ι : L ⟶ N` be a subcomplex equal
to `N` in degrees `≥ m` such that `p₀ = H^m(ι)` has a section `σ`, let `gen : c(Λⁿ) ⟶ H^m(L)` be
an epimorphism and `e = 1 - p₀ σ`. Suppose that over `W ∈ Y_proét` the restrictions of the
global sections `uₜ = e(gen(δₜ))` are the classes of cycles `zₜ` of `L` with `ι(zₜ) = d yₜ`.
Then, after pullback along `W ⟶ Y`, the subcomplex spanned by `L` and the sections `yₜ` has
injective `H^m`. -/
lemma mono_homologyMap_spanι_upperStar {Y : Scheme.{u}} (W : Y.ProEt)
    (w : W ⟶ terminalProEt Y) {m : ℤ}
    {L N : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ}
    (ι : L ⟶ N) (hι : ∀ i, Mono (ι.f i)) (hι' : ∀ i, m ≤ i → IsIso (ι.f i))
    (σ : N.homology m ⟶ L.homology m) (hσ : σ ≫ HomologicalComplex.homologyMap ι m = 𝟙 _)
    {n : ℕ} (gen : (constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)).obj
      (ModuleCat.of Λ (Fin n → Λ)) ⟶ L.homology m) [Epi gen]
    (z : Fin n → (L.cycles m).obj.obj (op W)) (y : Fin n → (N.X (m - 1)).obj.obj (op W))
    (hz : ∀ t, (L.homologyπ m).hom.app _ (z t) = (L.homology m).obj.map w.op
      ((gen ≫ (𝟙 _ - HomologicalComplex.homologyMap ι m ≫ σ)).hom.app _
        (constSection _ _ (Pi.single t 1))))
    (hy : ∀ t, (N.toCycles (m - 1) m).hom.app _ (y t) =
      (HomologicalComplex.cyclesMap ι m).hom.app _ (z t)) :
    Mono (HomologicalComplex.homologyMap (spanι (((W.hom)^*[ModuleCat.{u + 1} Λ]
      |>.mapHomologicalComplex (.up ℤ)).map ι) (fun _ : Fin n ↦ m - 1)
        (fun t ↦ (sectionTransport W (N.X (m - 1))).hom (y t))) m) := by
  have : WeaklyEtale W.hom := W.prop
  let G := (W.hom)^*[ModuleCat.{u + 1} Λ]
  let GC := G.mapHomologicalComplex (.up ℤ)
  let ι' := GC.map ι
  let y' := fun t ↦ (sectionTransport W (N.X (m - 1))).hom (y t)
  let ι'' := spanι ι' (fun _ : Fin n ↦ m - 1) y'
  let lift := spanLift ι' (fun _ : Fin n ↦ m - 1) y'
  let p₀ := HomologicalComplex.homologyMap ι m
  let e := 𝟙 _ - p₀ ≫ σ
  let q := HomologicalComplex.homologyMap lift m
  have hι'f (i : ℤ) : ι'.f i = G.map (ι.f i) := rfl
  have hι'iso (i : ℤ) (hi : m ≤ i) : IsIso (ι'.f i) := by
    have := hι' i hi
    rw [hι'f]
    infer_instance
  have hι'mono (i : ℤ) : Mono (ι'.f i) := by
    have := hι i
    rw [hι'f]
    infer_instance
  have hι''iso (i : ℤ) (hi : m ≤ i) : IsIso (ι''.f i) := by
    have := hι'iso i hi
    exact isIso_spanι_f _ _ _ i
  have hlift (i : ℤ) : lift.f i ≫ ι''.f i = ι'.f i := by
    rw [← HomologicalComplex.comp_f, spanLift_spanι]
  have hliftiso (i : ℤ) (hi : m ≤ i) : IsIso (lift.f i) := by
    have := hι''iso i hi
    have := hι'iso i hi
    have : IsIso (lift.f i ≫ ι''.f i) := by rw [hlift]; infer_instance
    exact IsIso.of_isIso_comp_right _ (ι''.f i)
  have : Epi q := HomologicalComplex.epi_homologyMap_of_epi_of_mono lift (CochainComplex.next ℤ m)
    (have := hliftiso m le_rfl; inferInstance) (have := hliftiso (m + 1) (by lia); inferInstance)
  have hq : q ≫ HomologicalComplex.homologyMap ι'' m = HomologicalComplex.homologyMap ι' m := by
    rw [← HomologicalComplex.homologyMap_comp, spanLift_spanι]
  refine mono_of_epi_of_comp_eq hq fun T a ha ↦ ?_
  let Φ := upperStarHomologyIso W.hom L m
  have hΦ := homologyMap_upperStarHomologyIso_hom W.hom m ι
  have he : a ≫ Φ.hom = a ≫ Φ.hom ≫ G.map e := by
    have : a ≫ Φ.hom ≫ G.map p₀ = 0 := by
      rw [← hΦ]
      erw [reassoc_of% ha]
      rw [zero_comp]
    simp only [e, Functor.map_sub, Functor.map_id, Functor.map_comp, Preadditive.comp_sub,
      Category.comp_id, reassoc_of% this, zero_comp, sub_zero]
  suffices key : G.map e ≫ Φ.inv ≫ q = 0 by
    rw [← Category.id_comp a, ← Category.assoc, ← Φ.hom_inv_id, ← Category.assoc,
      Category.assoc a, he]
    simp [key]
  rw [← cancel_epi ((upperStarConstantSheafIso W.hom).inv.app _ ≫ G.map gen), comp_zero]
  refine constantSheaf_hom_ext fun v ↦ ?_
  rw [zero_hom_app_apply, pi_eq_sum_univ v, constSection_terminal_sum, map_sum]
  refine Finset.sum_eq_zero fun t _ ↦ ?_
  rw [map_smul]
  refine (congrArg _ ?_).trans (smul_zero _)
  sorry

open _root_.DerivedCategory in
/-- **Extension data exist locally.** Let `Λ` be Noetherian, let `N` be a complex of pro-étale
sheaves on `Y` with a perfect top part `j : c(E₀) ⟶ N` in degrees `≥ m`, and let `xₖ` be
finitely many global sections of terms of `N` such that `Q(N)` is a retract of `Q(L')` for every
subcomplex `L' ⊆ N` containing the `xₖ`. Then `Q(N)` locally has extension data in degree
`m`. -/
theorem isLocally_hasExtensionData [IsNoetherianRing Λ] {Y : Scheme.{u}} {m b : ℤ}
    (N : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ)
    (E₀ : CochainComplex (ModuleCat.{u + 1} Λ) ℤ)
    (j : ((constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)).mapHomologicalComplex
      _).obj E₀ ⟶ N) (hj : ∀ i, Mono (j.f i)) (hj' : ∀ i, m ≤ i → IsIso (j.f i))
    [E₀.IsStrictlyGE m] [E₀.IsStrictlyLE b]
    (hfree : ∀ i, Module.Free Λ (E₀.X i) ∧ Module.Finite Λ (E₀.X i))
    {n : ℕ} (p : Fin n → ℤ) (x : ∀ k, (N.X (p k)).obj.obj (op (terminalProEt Y)))
    (hx : ∀ (L' : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ)
      (ι : L' ⟶ N), (∀ i, Mono (ι.f i)) → (∀ k, ∃ x' : (L'.X (p k)).obj.obj
        (op (terminalProEt Y)), (ι.f (p k)).hom.app _ x' = x k) →
      ∃ r : Q.obj N ⟶ Q.obj L', r ≫ Q.map ι = 𝟙 _) :
    IsLocally (ModuleCat.{u + 1} Λ) (fun _ K ↦ HasExtensionData K m) (Q.obj N) := by
  let c := constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)
  let L₀ := span j p x
  let ι₀ := spanι j p x
  have hι₀ (i : ℤ) (hi : m ≤ i) : IsIso (ι₀.f i) := by
    have : Epi (j.f i) := by have := hj' i hi; infer_instance
    exact isIso_spanι_f j p x i
  obtain ⟨s₀, hs₀⟩ := hx L₀ ι₀ (fun i ↦ inferInstance) (exists_spanι_f_app_eq j p x)
  -- the section `σ` of `p₀ = H^m(ι₀)`
  let H := homologyFunctor (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) m
  let hF := homologyFunctorFactors (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) m
  let p₀ := HomologicalComplex.homologyMap ι₀ m
  let σ : N.homology m ⟶ L₀.homology m := hF.inv.app N ≫ H.map s₀ ≫ hF.hom.app L₀
  have hσ : σ ≫ p₀ = 𝟙 _ := by
    have h := hF.hom.naturality ι₀
    dsimp only [Functor.comp_map] at h
    change _ ≫ _ ≫ hF.hom.app L₀ ≫ (HomologicalComplex.homologyFunctor _ _ m).map ι₀ = _
    rw [← h, ← H.map_comp_assoc, hs₀, CategoryTheory.Functor.map_id, Category.id_comp,
      Iso.inv_hom_id_app]
    rfl
  -- generators of the kernel of `p₀`
  obtain ⟨V, hV, gen, hgen⟩ := (isGloballyFinitelyGenerated_cycles_span j hj hj' (hfree m).2 p
    x).of_epi (L₀.homologyπ m)
  obtain ⟨n', π, hπ⟩ := Module.Finite.exists_fin' Λ V
  have : Epi (ModuleCat.ofHom π : ModuleCat.of Λ (Fin n' → Λ) ⟶ V) :=
    (ModuleCat.epi_iff_surjective _).2 hπ
  let gen₀ := c.map (ModuleCat.ofHom π) ≫ gen
  have : Epi gen₀ := epi_comp _ _
  let ζ := gen₀ ≫ (𝟙 _ - p₀ ≫ σ)
  have hζ : ζ ≫ p₀ = 0 := by
    simp only [ζ, Category.assoc, Preadditive.sub_comp, Category.id_comp, hσ, Category.comp_id,
      sub_self, comp_zero]
  let u (t : Fin n') : (L₀.homology m).obj.obj (op (terminalProEt Y)) :=
    ζ.hom.app _ (constSection _ _ (Pi.single t 1))
  have hu (t : Fin n') : p₀.hom.app _ (u t) = 0 := by
    rw [← comp_hom_app_apply, hζ, zero_hom_app_apply]
  choose R hR hR' using fun t ↦ exists_sieve_homologyπ_eq_and_toCycles_eq ι₀ m (u t) (hu t)
  refine IsLocally.of_mem_topology ((Scheme.ProEt.topology Y).iInf_mem R hR) fun W w hw ↦ ?_
  choose z y hz hy using fun t ↦ hR' t w ((iInf_le (fun t ↦ R t) t : _) w hw)
  have : WeaklyEtale W.hom := W.prop
  let g := W.hom
  let G := (g)^*[ModuleCat.{u + 1} Λ]
  let GC := G.mapHomologicalComplex (.up ℤ)
  let ι' := GC.map ι₀
  let y' := fun t ↦ (sectionTransport W (N.X (m - 1))).hom (y t)
  let L'' := span ι' (fun _ : Fin n' ↦ m - 1) y'
  let ι'' := spanι ι' (fun _ : Fin n' ↦ m - 1) y'
  have hι'iso (i : ℤ) (hi : m ≤ i) : IsIso (ι'.f i) := by
    have := hι₀ i hi
    change IsIso (G.map (ι₀.f i))
    infer_instance
  have hι''iso (i : ℤ) (hi : m ≤ i) : IsIso (ι''.f i) := by
    have := hι'iso i hi
    exact isIso_spanι_f _ _ _ i
  obtain ⟨s₀', hs₀'⟩ := exists_comp_Q_map_upperStar_eq_id g ι₀ ⟨s₀, hs₀⟩
  refine HasExtensionData.of_iso (leftDerivedUpperStarQObjIso g N).symm
    ⟨GC.obj N, E₀, (upperStarConstantComplexIso g E₀).inv ≫ GC.map j, b, L'', ι'',
      ⟨Iso.refl _⟩, fun i ↦ ?_, fun i hi ↦ ?_, inferInstance, inferInstance, hfree,
      fun i ↦ inferInstance, hι''iso, ⟨s₀' ≫ Q.map (spanLift _ _ _), ?_⟩, ?_, ?_⟩
  · have := hj i
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f, GC]
    infer_instance
  · have := hj' i hi
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f, GC]
    infer_instance
  · rw [Category.assoc, ← Q.map_comp, spanLift_spanι, hs₀']
  · rw [quasiIsoAt_iff_isIso_homologyMap]
    have : Epi (HomologicalComplex.homologyMap ι'' m) :=
      HomologicalComplex.epi_homologyMap_of_epi_of_mono ι'' (CochainComplex.next ℤ m)
        (have := hι''iso m le_rfl; inferInstance)
        (have := hι''iso (m + 1) (by lia); inferInstance)
    have : Mono (HomologicalComplex.homologyMap ι'' m) :=
      mono_homologyMap_spanι_upperStar W w ι₀ (fun i ↦ inferInstance) hι₀ σ hσ gen₀ z y hz hy
    exact isIso_of_mono_of_epi _
  · refine isGloballyFinitelyGenerated_span_X _ _ _ (m - 1) (IsGloballyFinitelyGenerated.upperStar g
      (isGloballyFinitelyGenerated_span_X j p x (m - 1) (.of_isZero (c.map_isZero
        (E₀.isZero_of_isStrictlyGE m (m - 1) (by lia))))))

end AlgebraicGeometry.ProEtale
