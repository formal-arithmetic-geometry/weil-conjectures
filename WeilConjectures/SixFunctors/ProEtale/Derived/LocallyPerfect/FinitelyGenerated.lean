module

public import WeilConjectures.SixFunctors.ProEtale.ConstantSheaf
public import WeilConjectures.SixFunctors.ProEtale.Derived.DualizableRetract

/-!
# Pro-étale sheaves generated by finitely many global sections

Let `Y` be a scheme and `Λ` a commutative ring. A pro-étale sheaf of `Λ`-modules `F` on `Y` is
*globally finitely generated* if it is a quotient of the constant sheaf `c(V)` attached to a
finitely generated `Λ`-module `V`, that is, if finitely many global sections of `F` generate it.
In the proof that dualizable complexes are locally perfect (Stacks, Tag 0FPV) these sheaves are
the terms of the finite subcomplexes which are later replaced by finite free constant sheaves.

## Main definitions

- `AlgebraicGeometry.ProEtale.IsGloballyFinitelyGenerated`: the property above.

## Main results

- `AlgebraicGeometry.ProEtale.IsGloballyFinitelyGenerated.sigma`: finite coproducts.
- `AlgebraicGeometry.ProEtale.IsGloballyFinitelyGenerated.upperStar`: stability under pullback.
- `AlgebraicGeometry.ProEtale.isGloballyFinitelyGenerated_sigma_unitDisk_X`: the terms of a
  finite sum of the free complexes `unitDisk n`.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite MonoidalCategory

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale

open _root_.AlgebraicGeometry.Scheme

variable {Λ : Type (u + 1)} [CommRing Λ] {Y : Scheme.{u}}

/-- A pro-étale sheaf of `Λ`-modules is *globally finitely generated* if it is a quotient of
the constant sheaf attached to a finitely generated `Λ`-module. -/
def IsGloballyFinitelyGenerated (F : Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) :
    Prop :=
  ∃ (V : ModuleCat.{u + 1} Λ) (_ : Module.Finite Λ V)
    (f : (constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)).obj V ⟶ F), Epi f

namespace IsGloballyFinitelyGenerated

variable {F G : Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)}

lemma of_epi (hF : IsGloballyFinitelyGenerated F) (g : F ⟶ G) [Epi g] :
    IsGloballyFinitelyGenerated G := by
  obtain ⟨V, hV, f, hf⟩ := hF
  exact ⟨V, hV, f ≫ g, epi_comp _ _⟩

lemma of_iso (hF : IsGloballyFinitelyGenerated F) (e : F ≅ G) :
    IsGloballyFinitelyGenerated G :=
  hF.of_epi e.hom

lemma of_isZero (hF : IsZero F) : IsGloballyFinitelyGenerated F :=
  ⟨ModuleCat.of Λ PUnit, inferInstance, 0, ⟨fun _ _ _ ↦ hF.eq_of_src _ _⟩⟩

/-- The constant sheaf attached to a finitely generated module is globally finitely
generated. -/
lemma constantSheaf_obj (V : ModuleCat.{u + 1} Λ) [Module.Finite Λ V] :
    IsGloballyFinitelyGenerated
      ((constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)).obj V) :=
  ⟨V, inferInstance, 𝟙 _, inferInstance⟩

/-- The unit sheaf `Λ_Y` is globally finitely generated. -/
lemma unit : IsGloballyFinitelyGenerated (𝟙_ (Sheaf (Scheme.ProEt.topology Y)
    (ModuleCat.{u + 1} Λ))) :=
  have : Module.Finite Λ (𝟙_ (ModuleCat.{u + 1} Λ)) := inferInstanceAs (Module.Finite Λ Λ)
  (constantSheaf_obj (𝟙_ (ModuleCat.{u + 1} Λ))).of_iso
    (Functor.Monoidal.εIso (constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ))).symm

/-- A finite coproduct of globally finitely generated sheaves is globally finitely
generated. -/
lemma sigma {J : Type} [Finite J] {F : J → Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)}
    (hF : ∀ j, IsGloballyFinitelyGenerated (F j)) : IsGloballyFinitelyGenerated (∐ F) := by
  choose V hV f hf using hF
  have := Fintype.ofFinite J
  have : Module.Finite Λ (ModuleCat.of Λ (∀ j, V j)) :=
    inferInstanceAs (Module.Finite Λ (∀ j, V j))
  let c := constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)
  let e : ModuleCat.of Λ (∀ j, V j) ≅ ∐ V :=
    (ModuleCat.biproductIsoPi V).symm ≪≫ biproduct.isoCoproduct V
  exact ⟨_, this, c.map e.hom ≫ (PreservesCoproduct.iso c V).hom ≫ Sigma.map f,
    inferInstance⟩

/-- A binary coproduct of globally finitely generated sheaves is globally finitely
generated. -/
lemma coprod (hF : IsGloballyFinitelyGenerated F) (hG : IsGloballyFinitelyGenerated G) :
    IsGloballyFinitelyGenerated (F ⨿ G) := by
  obtain ⟨V, hV, f, hf⟩ := hF
  obtain ⟨W, hW, g, hg⟩ := hG
  have : Module.Finite Λ (ModuleCat.of Λ (V × W)) := inferInstanceAs (Module.Finite Λ (V × W))
  let c := constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)
  let e : ModuleCat.of Λ (V × W) ≅ V ⨿ W :=
    (ModuleCat.biprodIsoProd V W).symm ≪≫ biprod.isoCoprod V W
  exact ⟨_, this, c.map e.hom ≫ (PreservesColimitPair.iso c V W).inv ≫ coprod.map f g,
    inferInstance⟩

/-- The pullback of a globally finitely generated sheaf is globally finitely generated. -/
lemma upperStar {Z : Scheme.{u}} (g : Z ⟶ Y) (hF : IsGloballyFinitelyGenerated F) :
    IsGloballyFinitelyGenerated ((g)^*[ModuleCat.{u + 1} Λ].obj F) := by
  obtain ⟨V, hV, f, hf⟩ := hF
  exact ⟨V, hV, (upperStarConstantSheafIso g).inv.app V ≫ (g)^*[ModuleCat.{u + 1} Λ].map f,
    inferInstance⟩

end IsGloballyFinitelyGenerated

/-- The terms of the free complex `unitDisk n` are globally finitely generated. -/
lemma isGloballyFinitelyGenerated_unitDisk_X (n i : ℤ) :
    IsGloballyFinitelyGenerated ((unitDisk (X := Y) (Λ := Λ) n).X i) := by
  by_cases h₀ : i = n
  · subst h₀
    exact IsGloballyFinitelyGenerated.unit.of_iso (HomologicalComplex.doubleXIso₀ _ _).symm
  by_cases h₁ : i = n + 1
  · subst h₁
    exact IsGloballyFinitelyGenerated.unit.of_iso (HomologicalComplex.doubleXIso₁ _ _ (by
      lia)).symm
  exact .of_isZero (HomologicalComplex.isZero_double_X _ _ _ h₀ h₁)

/-- The terms of a finite sum of the free complexes `unitDisk (p k)` are globally finitely
generated. -/
lemma isGloballyFinitelyGenerated_sigma_unitDisk_X {m : ℕ} (p : Fin m → ℤ) (i : ℤ) :
    IsGloballyFinitelyGenerated ((∐ fun k ↦ unitDisk (X := Y) (Λ := Λ) (p k)).X i) :=
  (IsGloballyFinitelyGenerated.sigma fun k ↦ isGloballyFinitelyGenerated_unitDisk_X (p k) i).of_iso
    (PreservesCoproduct.iso (HomologicalComplex.eval _ (.up ℤ) i) _).symm

end AlgebraicGeometry.ProEtale
