module

public import WeilConjectures.SixFunctors.ProEtale.Derived.LocallyPerfect.ConstantMap
public import WeilConjectures.SixFunctors.ProEtale.Derived.LocallyPerfect.Extend
public import WeilConjectures.SixFunctors.ProEtale.Derived.LocallyPerfect.FinitelyGenerated

/-!
# Data for extending a perfect top part by one degree

Let `K ∈ D(Y_proét, Λ)` have a perfect top part in degrees `≥ m`, witnessed by `K ≅ Q(M)` and
`j : c(E₀) ⟶ M`. The inductive step of Stacks, Tag 0FPV, (`hasPerfectTop_sub_one`) needs a
subcomplex `ι : L' ⟶ M`, equal to `M` in degrees `≥ m`, such that `Q(ι)` has a section,
`H^m(ι)` is an isomorphism and `L'^{m-1}` is generated by finitely many global sections, the
differential `L'^{m-1} ⟶ L'^m = c(E₀^m)` being induced by a linear map on generators. This file
bundles all of this but the last condition into `HasExtensionData K m`, shows that it is stable
under pullback along weakly étale morphisms, and that the last condition holds locally, so that
`HasExtensionData K m` implies that `K` locally has a perfect top part in degrees `≥ m - 1`.

## Main definitions

- `AlgebraicGeometry.ProEtale.HasExtensionData`: the data above.

## Main results

- `AlgebraicGeometry.ProEtale.HasExtensionData.upperStar`: stability under pullback.
- `AlgebraicGeometry.ProEtale.HasExtensionData.isLocally_hasPerfectTop`: extension data in degree
  `m` give, locally, a perfect top part in degrees `≥ m - 1`.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite MonoidalCategory

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale

open _root_.AlgebraicGeometry.Scheme

variable {Λ : Type (u + 1)} [CommRing Λ]

/-- The isomorphism `Lg^*(Q M) ≅ Q(g^* M)` is natural in the complex `M`. -/
@[reassoc]
lemma leftDerivedUpperStarQObjIso_hom_naturality {Y Z : Scheme.{u}} (g : Z ⟶ Y)
    {M M' : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ}
    (f : M ⟶ M') :
    L((g)^*[ModuleCat.{u + 1} Λ]).map (DerivedCategory.Q.map f) ≫
        (leftDerivedUpperStarQObjIso g M').hom =
      (leftDerivedUpperStarQObjIso g M).hom ≫
        DerivedCategory.Q.map (((g)^*[ModuleCat.{u + 1} Λ].mapHomologicalComplex _).map f) := by
  simp only [leftDerivedUpperStarQObjIso, Iso.trans_hom, Iso.app_hom, Category.assoc]
  rw [← NatTrans.naturality_assoc]
  have := ((g)^*[ModuleCat.{u + 1} Λ].mapDerivedCategoryFactors).hom.naturality f
  dsimp at this ⊢
  rw [this]

/-- A section of `Q(ι)` pulls back to a section of `Q(g^* ι)`. -/
lemma exists_comp_Q_map_upperStar_eq_id {Y Z : Scheme.{u}} (g : Z ⟶ Y)
    {L' M : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ}
    (ι : L' ⟶ M) (h : ∃ s : DerivedCategory.Q.obj M ⟶ DerivedCategory.Q.obj L',
      s ≫ DerivedCategory.Q.map ι = 𝟙 _) :
    ∃ s : DerivedCategory.Q.obj (((g)^*[ModuleCat.{u + 1} Λ].mapHomologicalComplex _).obj M) ⟶
        DerivedCategory.Q.obj (((g)^*[ModuleCat.{u + 1} Λ].mapHomologicalComplex _).obj L'),
      s ≫ DerivedCategory.Q.map (((g)^*[ModuleCat.{u + 1} Λ].mapHomologicalComplex _).map ι) =
        𝟙 _ := by
  obtain ⟨s, hs⟩ := h
  refine ⟨(leftDerivedUpperStarQObjIso g M).inv ≫ L((g)^*[ModuleCat.{u + 1} Λ]).map s ≫
    (leftDerivedUpperStarQObjIso g L').hom, ?_⟩
  rw [Category.assoc, Category.assoc, ← leftDerivedUpperStarQObjIso_hom_naturality,
    ← Functor.map_comp_assoc, hs, CategoryTheory.Functor.map_id, Category.id_comp,
    Iso.inv_hom_id]

/-- `K ∈ D(Y_proét, Λ)` *has extension data in degree `m`* if `K ≅ Q(M)` for a complex `M`
with a perfect top part `j : c(E₀) ⟶ M` in degrees `≥ m` (as in `HasPerfectTop`), together with
a subcomplex `ι : L' ⟶ M` which is equal to `M` in degrees `≥ m`, such that `Q(ι)` has a
section, `H^m(ι)` is an isomorphism and `L'^{m-1}` is globally finitely generated. -/
def HasExtensionData {Y : Scheme.{u}}
    (K : DerivedCategory (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ))) (m : ℤ) :
    Prop :=
  ∃ (M : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ)
    (E₀ : CochainComplex (ModuleCat.{u + 1} Λ) ℤ)
    (j : ((constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)).mapHomologicalComplex
      _).obj E₀ ⟶ M) (b : ℤ)
    (L' : CochainComplex (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)) ℤ) (ι : L' ⟶ M),
    Nonempty (K ≅ DerivedCategory.Q.obj M) ∧ (∀ i, Mono (j.f i)) ∧
      (∀ i, m ≤ i → IsIso (j.f i)) ∧ E₀.IsStrictlyGE m ∧ E₀.IsStrictlyLE b ∧
      (∀ i, Module.Free Λ (E₀.X i) ∧ Module.Finite Λ (E₀.X i)) ∧
      (∀ i, Mono (ι.f i)) ∧ (∀ i, m ≤ i → IsIso (ι.f i)) ∧
      (∃ s : DerivedCategory.Q.obj M ⟶ DerivedCategory.Q.obj L',
        s ≫ DerivedCategory.Q.map ι = 𝟙 _) ∧
      QuasiIsoAt ι m ∧ IsGloballyFinitelyGenerated (L'.X (m - 1))

lemma HasExtensionData.of_iso {Y : Scheme.{u}}
    {K K' : DerivedCategory (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ))}
    (e : K ≅ K') {m : ℤ} (h : HasExtensionData K m) : HasExtensionData K' m := by
  obtain ⟨M, E₀, j, b, L', ι, ⟨e'⟩, h⟩ := h
  exact ⟨M, E₀, j, b, L', ι, ⟨e.symm ≪≫ e'⟩, h⟩

/-- Extension data are stable under derived pullback along a weakly étale morphism. -/
lemma HasExtensionData.upperStar {Y Z : Scheme.{u}} (g : Z ⟶ Y)
    {K : DerivedCategory (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ))} {m : ℤ}
    (h : HasExtensionData K m) :
    HasExtensionData (L((g)^*[ModuleCat.{u + 1} Λ]).obj K) m := by
  obtain ⟨M, E₀, j, b, L', ι, ⟨e⟩, hj, hj', hE, hE', hfree, hι, hι', hs, hm, hL'⟩ := h
  let G := (g)^*[ModuleCat.{u + 1} Λ].mapHomologicalComplex (.up ℤ)
  refine ⟨G.obj M, E₀, (upperStarConstantComplexIso g E₀).inv ≫ G.map j, b, G.obj L', G.map ι,
    ⟨L((g)^*[ModuleCat.{u + 1} Λ]).mapIso e ≪≫ leftDerivedUpperStarQObjIso g M⟩,
    fun i ↦ ?_, fun i hi ↦ ?_, hE, hE', hfree, fun i ↦ ?_, fun i hi ↦ ?_,
    exists_comp_Q_map_upperStar_eq_id g ι hs, inferInstance, hL'.upperStar g⟩
  · have := hj i
    simp only [G, HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f]
    infer_instance
  · have := hj' i hi
    simp only [G, HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f]
    infer_instance
  · have := hι i
    simp only [G, Functor.mapHomologicalComplex_map_f]
    infer_instance
  · have := hι' i hi
    simp only [G, Functor.mapHomologicalComplex_map_f]
    infer_instance

/-- **Extension data give, locally, a perfect top part one degree lower.** The generating
sections of `L'^{m-1}` have differentials in `L'^m ≅ c(E₀^m)` which are locally constant
(`AlgebraicGeometry.ProEtale.exists_sieve_upperStar_map_eq_constantSheaf_map`); after pullback
to the members of the corresponding covering sieve, `hasPerfectTop_sub_one` applies. -/
theorem HasExtensionData.isLocally_hasPerfectTop {Y : Scheme.{u}}
    {K : DerivedCategory (Sheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ))} {m : ℤ}
    (h : HasExtensionData K m) :
    IsLocally (ModuleCat.{u + 1} Λ) (fun _ K ↦ HasPerfectTop K (m - 1)) K := by
  obtain ⟨M, E₀, j, b, L', ι, ⟨e⟩, hj, hj', hE, hE', hfree, hι, hι', ⟨s, hs⟩, hm, hL'⟩ := h
  obtain ⟨V, hV, gen, hgen⟩ := hL'
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' Λ V
  let c := constantSheaf (Scheme.ProEt.topology Y) (ModuleCat.{u + 1} Λ)
  let V₀ := ModuleCat.of Λ (Fin n → Λ)
  have : Epi (ModuleCat.ofHom π : V₀ ⟶ V) := (ModuleCat.epi_iff_surjective _).2 hπ
  let gen₀ : c.obj V₀ ⟶ L'.X (m - 1) := c.map (ModuleCat.ofHom π) ≫ gen
  have := hj' m le_rfl
  let f : c.obj V₀ ⟶ c.obj (E₀.X m) := gen₀ ≫ L'.d (m - 1) m ≫ ι.f m ≫ inv (j.f m)
  obtain ⟨R, hR, hR'⟩ := exists_sieve_upperStar_map_eq_constantSheaf_map f
  refine IsLocally.of_mem_topology_of_nonempty (fun _ _ _ e h ↦ h.of_iso e) hR
    fun W w hw hne ↦ ?_
  obtain ⟨A, hA⟩ := hR' w hw hne
  have : WeaklyEtale W.hom := W.prop
  let g := W.hom
  let G := (g)^*[ModuleCat.{u + 1} Λ]
  let GC := G.mapHomologicalComplex (.up ℤ)
  let c' := constantSheaf (Scheme.ProEt.topology W.left) (ModuleCat.{u + 1} Λ)
  let j' := (upperStarConstantComplexIso g E₀).inv ≫ GC.map j
  have hj'f (i : ℤ) : j'.f i = (upperStarConstantSheafIso g).inv.app (E₀.X i) ≫ G.map (j.f i) :=
    rfl
  obtain ⟨s', hs'⟩ := exists_comp_Q_map_upperStar_eq_id g ι ⟨s, hs⟩
  let gen' : c'.obj V₀ ⟶ (GC.obj L').X (m - 1) :=
    (upperStarConstantSheafIso g).inv.app V₀ ≫ G.map gen₀
  have : Epi gen₀ := epi_comp _ _
  have : Epi gen' := epi_comp _ _
  have : E₀.IsStrictlyGE m := hE
  have : E₀.IsStrictlyLE b := hE'
  have hA' : gen' ≫ (GC.obj L').d (m - 1) m ≫ (GC.map ι).f m = c'.map A ≫ j'.f m := by
    rw [← hA, hj'f]
    simp only [Category.assoc, Iso.hom_inv_id_app_assoc, gen', GC,
      Functor.mapHomologicalComplex_obj_d, Functor.mapHomologicalComplex_map_f, ← G.map_comp, f,
      IsIso.inv_hom_id, Category.comp_id]
  refine (hasPerfectTop_sub_one (GC.obj M) (GC.obj L') E₀ j' (fun i ↦ ?_) (fun i hi ↦ ?_) hfree
    (GC.map ι) (fun i ↦ ?_) (fun i hi ↦ ?_) s' hs' ?_ V₀ gen' A hA').of_iso
    (L((g)^*[ModuleCat.{u + 1} Λ]).mapIso e ≪≫ leftDerivedUpperStarQObjIso g M).symm
  · have := hj i
    rw [hj'f]
    infer_instance
  · have := hj' i hi
    rw [hj'f]
    infer_instance
  · have := hι i
    simp only [GC, Functor.mapHomologicalComplex_map_f]
    infer_instance
  · have := hι' i hi
    simp only [GC, Functor.mapHomologicalComplex_map_f]
    infer_instance
  · have : QuasiIsoAt (GC.map ι) m := inferInstance
    exact (quasiIsoAt_iff' _ _ _ _ (by simp) (by simp)).1 this |>.isIso_homologyMap

end AlgebraicGeometry.ProEtale
