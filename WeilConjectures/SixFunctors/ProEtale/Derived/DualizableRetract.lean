/-!
# Dualizable complexes of pro-étale sheaves are retracts of finite subcomplexes

Let `X` be a scheme and `Λ` a commutative ring. This file proves the first step of Stacks,
Tag 0FPV (dualizable complexes are perfect) for `D(X_proét, Λ)`, the sheaf version of
`DerivedCategory.exists_retract_of_exactPairing`: a dualizable object `C ≅ Q(L)` factors through
`Q(L')` for a finite subcomplex `L' ⊆ L`, generated by finitely many global sections.

For sheaves, writing the coevaluation as a finite sum of pure tensors is only possible locally.
The statement here is therefore the global-section form: it assumes that the cocycle
representing the coevaluation over the terminal object is a finite sum of pure tensors of global
sections, and avoids restriction functors.

## Main definitions

- `AlgebraicGeometry.ProEtale.generatedSubcomplex`,
  `AlgebraicGeometry.ProEtale.generatedSubcomplexι`:
  the subcomplex of a complex `L` generated by finitely many sections over the terminal object
  and their differentials, as the image of a chain map from a sum of the free complexes
  `𝟙_ ⟶ 𝟙_` (`AlgebraicGeometry.ProEtale.unitDisk`).

## Main statements

- `CategoryTheory.exists_comp_eq_of_coevaluation_comp_whiskerRight`: the zigzag factorisation.
- `CochainComplex.mono_whiskerRight_f`: tensoring a degreewise monomorphism with a complex of
  flat objects gives a degreewise monomorphism.
- `AlgebraicGeometry.ProEtale.isStrictlyGE_generatedSubcomplex`,
  `AlgebraicGeometry.ProEtale.isStrictlyLE_generatedSubcomplex`: generated subcomplexes are
  strictly bounded.
- `AlgebraicGeometry.ProEtale.exists_comp_Q_map_generatedSubcomplexι_eq`: if the coevaluation of
  `C` is given by a finite sum of pure tensors of global sections `xₖ ⊗ yₖ`, then `C ≅ Q(L)`
  factors through the subcomplex generated by the `xₖ`.
-/

@[expose] public section

universe v u' u

open CategoryTheory Limits MonoidalCategory Opposite

namespace CategoryTheory

variable {𝒞 : Type u'} [Category.{v} 𝒞] [MonoidalCategory 𝒞]

/-- **Zigzag factorisation.** Let `C` have a right dual `D`. If the coevaluation followed by
`f ▷ D` factors through `g ▷ D`, then `f : C ⟶ Y` factors through `g : Y' ⟶ Y`. -/
lemma exists_comp_eq_of_coevaluation_comp_whiskerRight {C D Y Y' : 𝒞} [ExactPairing C D]
    (f : C ⟶ Y) (g : Y' ⟶ Y) (v : 𝟙_ 𝒞 ⟶ Y' ⊗ D) (hv : v ≫ g ▷ D = η_ C D ≫ f ▷ D) :
    ∃ w : C ⟶ Y', w ≫ g = f := by
  have key : (tensorRightHomEquiv _ C D _).symm v ≫ g = (λ_ C).hom ≫ f := by
    rw [← tensorRightHomEquiv_symm_coevaluation_comp_whiskerRight (Y' := D), ← hv,
      Equiv.eq_symm_apply, tensorRightHomEquiv_naturality, Equiv.apply_symm_apply]
  exact ⟨(λ_ C).inv ≫ _, by rw [Category.assoc, key, Iso.inv_hom_id_assoc]⟩

end CategoryTheory

namespace CochainComplex

variable {C : Type u} [Category.{v} C] [Abelian C] [IsGrothendieckAbelian.{v} C]
  [MonoidalCategory C] [MonoidalPreadditive C] [MonoidalClosed C] [BraidedCategory C]

/-- Tensoring a degreewise monomorphism of complexes `ι : L' ⟶ L` with a complex `F` of flat
objects gives a degreewise monomorphism `L' ⊗ F ⟶ L ⊗ F`: in each degree it is a coproduct of
the monomorphisms `L'ᵖ ⊗ F^q ⟶ Lᵖ ⊗ F^q`. -/
lemma mono_whiskerRight_f {L' L : CochainComplex C ℤ} (ι : L' ⟶ L) [∀ n, Mono (ι.f n)]
    (F : CochainComplex C ℤ) (hF : ∀ q, ObjectProperty.flat (F.X q)) (j : ℤ) :
    Mono ((ι ▷ F).f j) := by
  have (i : ℤ × ℤ) : Mono (ι.f i.1 ▷ F.X i.2) := by
    have : PreservesFiniteLimits (tensorRight (F.X i.2)) := (hF i.2).tensorRight.1
    exact (tensorRight (F.X i.2)).map_mono (ι.f i.1)
  exact MorphismProperty.IsStableUnderColimitsOfShape.condition
    (W := MorphismProperty.monomorphisms C) _ _ (colimit.cocone _)
    (colimit.cocone _) (colimit.isColimit _) (colimit.isColimit _)
    (Discrete.natTrans fun i ↦ ι.f i.as.1.1 ▷ F.X i.as.1.2)
    (fun i ↦ by exact this i.as.1) _ (fun ⟨⟨⟨p, q⟩, h⟩⟩ ↦ by
      refine (HomologicalComplex.ι_mapBifunctorMap ι (𝟙 F) _ _ p q j h).trans ?_
      simp only [curriedTensor_obj_obj, curriedTensor_map_app, HomologicalComplex.id_f,
        curriedTensor_obj_map, whiskerLeft_id, Category.id_comp,
        Functor.mapBifunctorHomologicalComplex_obj_obj_toGradedObject,
        Discrete.functor_obj_eq_as, Functor.const_obj_obj]
      rfl)

/-- The tensor product `ι ▷ F` of a chain map with a complex, on the summand `Lᵖ ⊗ F^q` of
`(L ⊗ F)ʲ`, is `ι.f p ▷ F.X q`. -/
@[reassoc]
lemma ιTensorObj_comp_whiskerRight_f {L' L : CochainComplex C ℤ} (ι : L' ⟶ L)
    (F : CochainComplex C ℤ) (p q j : ℤ) (h : p + q = j) :
    HomologicalComplex.ιTensorObj L' F p q j h ≫ (ι ▷ F).f j =
      ι.f p ▷ F.X q ≫ HomologicalComplex.ιTensorObj L F p q j h := by
  refine (HomologicalComplex.ι_mapBifunctorMap ι (𝟙 F) _ _ p q j h).trans ?_
  simp only [curriedTensor_obj_obj, curriedTensor_map_app, HomologicalComplex.id_f,
    curriedTensor_obj_map, whiskerLeft_id, Category.id_comp]

end CochainComplex

namespace AlgebraicGeometry.ProEtale

open Scheme

variable {Λ : Type (u + 1)} [CommRing Λ] {X : Scheme.{u}}

section Tensor

variable {F F' : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)}

/-- The comparison `tensorSection F G : F ⊗ G ⟶ (F ⊗ G)` from the objectwise tensor product is
natural in `F`. -/
@[reassoc]
lemma whiskerRight_comp_tensorSection (f : F ⟶ F')
    (G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) :
    f.hom ▷ G.obj ≫ tensorSection F' G = tensorSection F G ≫ (f ▷ G).hom := by
  let ε := (sheafificationAdjunction (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)).counit
  have key : (presheafToSheaf _ _).map (f.hom ▷ G.obj) ≫
      ((Functor.Monoidal.μIso (presheafToSheaf (Scheme.ProEt.topology X) _) F'.obj G.obj).inv ≫
        (ε.app F' ⊗ₘ ε.app G)) =
      ((Functor.Monoidal.μIso (presheafToSheaf (Scheme.ProEt.topology X) _) F.obj G.obj).inv ≫
        (ε.app F ⊗ₘ ε.app G)) ≫ f ▷ G := by
    have hε := ε.naturality f
    dsimp at hε
    rw [Functor.Monoidal.map_whiskerRight]
    simp only [Functor.Monoidal.μIso_inv, Category.assoc, Functor.Monoidal.μ_δ_assoc]
    rw [← tensorHom_id, tensorHom_comp_tensorHom, hε, ← tensorHom_id, tensorHom_comp_tensorHom,
      Category.id_comp]
    simp
  rw [tensorSection, tensorSection, toSheafify_naturality_assoc, Category.assoc]
  exact congrArg (toSheafify _ _ ≫ ·) (congrArg (·.hom) key)

/-- Pure tensors of sections are compatible with `f ▷ G`. -/
lemma whiskerRight_hom_app_tensorSectionMap (f : F ⟶ F')
    (G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) (V : X.ProEt)
    (x : F.obj.obj (op V)) (y : G.obj.obj (op V)) :
    (f ▷ G).hom.app (op V) (tensorSectionMap F G V (x ⊗ₜ y)) =
      tensorSectionMap F' G V (f.hom.app (op V) x ⊗ₜ y) :=
  (ConcreteCategory.congr_hom
    (NatTrans.congr_app (whiskerRight_comp_tensorSection f G) (op V)) (x ⊗ₜ y)).symm

/-- A monomorphism of pro-étale sheaves of modules is injective on sections. -/
lemma injective_hom_app_of_mono (f : F ⟶ F') [Mono f] (U : X.ProEtᵒᵖ) :
    Function.Injective (f.hom.app U) := by
  have : Mono f.hom := (sheafToPresheaf _ _).map_mono f
  exact (ModuleCat.mono_iff_injective _).1 inferInstance

end Tensor

section Generated

variable (L : CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ)

/-- The free complex `𝟙_ ⟶ 𝟙_` on one generator in degree `n`, placed in degrees `n` and
`n + 1`. -/
noncomputable abbrev unitDisk (n : ℤ) :
    CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ :=
  HomologicalComplex.double (𝟙 (𝟙_ (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ))))
    (show (ComplexShape.up ℤ).Rel n (n + 1) from rfl)

/-- The chain map out of `unitDisk n` sending the generator to a section `s` of `Lⁿ` over the
terminal object (and hence `d` of the generator to `d s`). -/
noncomputable def unitDiskHom {n : ℤ} (s : (L.X n).obj.obj (op (terminalProEt X))) :
    unitDisk n ⟶ L :=
  ((HomologicalComplex.evalCompCoyonedaCorepresentableByDoubleId _ (by simp) _).homEquiv).symm
    ((unitHomEquiv _).symm s)

variable {m : ℕ} (p : Fin m → ℤ) (x : ∀ k, (L.X (p k)).obj.obj (op (terminalProEt X)))

/-- The chain map from a finite sum of the free complexes `unitDisk (p k)` to `L`, sending the
generators to the sections `x k`. -/
noncomputable def generatedSubcomplexDesc : ∐ (fun k ↦ unitDisk (X := X) (Λ := Λ) (p k)) ⟶ L :=
  Sigma.desc fun k ↦ unitDiskHom L (x k)

/-- The subcomplex of `L` generated by finitely many sections `x k` of `L^{p k}` over the
terminal object and their differentials: the image of `generatedSubcomplexDesc`. -/
noncomputable def generatedSubcomplex :
    CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ :=
  Limits.image (generatedSubcomplexDesc L p x)

/-- The inclusion of the subcomplex generated by the sections `x k`. -/
noncomputable def generatedSubcomplexι : generatedSubcomplex L p x ⟶ L :=
  Limits.image.ι _

instance : Mono (generatedSubcomplexι L p x) := by
  dsimp [generatedSubcomplexι]
  infer_instance

/-- The generating sections `x k` lie in the subcomplex they generate. -/
lemma exists_generatedSubcomplexι_f_app_eq (k : Fin m) :
    ∃ x' : ((generatedSubcomplex L p x).X (p k)).obj.obj (op (terminalProEt X)),
      ((generatedSubcomplexι L p x).f (p k)).hom.app _ x' = x k := by
  refine ⟨unitHomEquiv _ ((HomologicalComplex.doubleXIso₀ _ _).inv ≫
    (Sigma.ι _ k ≫ factorThruImage (generatedSubcomplexDesc L p x)).f (p k)), ?_⟩
  rw [← unitHomEquiv_comp, Category.assoc, ← HomologicalComplex.comp_f, Category.assoc,
    generatedSubcomplexι, image.fac, generatedSubcomplexDesc, Sigma.ι_desc]
  rw [unitDiskHom,
    ← HomologicalComplex.evalCompCoyonedaCorepresentableByDoubleId_homEquiv_apply (h := by simp),
    Equiv.apply_symm_apply]
  exact (unitHomEquiv (L.X (p k))).apply_symm_apply (x k)

/-- A sum of the free complexes `unitDisk (p k)` vanishes outside the degrees `p k`, `p k + 1`. -/
lemma isZero_sigma_unitDisk_X (i : ℤ) (h : ∀ k, i ≠ p k ∧ i ≠ p k + 1) :
    IsZero ((∐ (fun k ↦ unitDisk (X := X) (Λ := Λ) (p k))).X i) := by
  rw [IsZero.iff_id_eq_zero]
  refine (isColimitOfPreserves (HomologicalComplex.eval _ _ i)
    (colimit.isColimit (Discrete.functor fun k ↦ unitDisk (X := X) (Λ := Λ) (p k)))).hom_ext
      fun ⟨k⟩ ↦ ?_
  exact (HomologicalComplex.isZero_double_X (𝟙 (𝟙_ _))
    (show (ComplexShape.up ℤ).Rel (p k) (p k + 1) from rfl) i (h k).1 (h k).2).eq_of_src _ _

/-- The subcomplex generated by the sections `x k` vanishes outside the degrees `p k`,
`p k + 1`. -/
lemma isZero_generatedSubcomplex_X (i : ℤ) (h : ∀ k, i ≠ p k ∧ i ≠ p k + 1) :
    IsZero ((generatedSubcomplex L p x).X i) :=
  IsZero.of_epi ((factorThruImage (generatedSubcomplexDesc L p x)).f i)
    (isZero_sigma_unitDisk_X p i h)

/-- The subcomplex generated by the sections `x k` vanishes below the degrees `p k`. -/
lemma isStrictlyGE_generatedSubcomplex (a : ℤ) (h : ∀ k, a ≤ p k) :
    (generatedSubcomplex L p x).IsStrictlyGE a := by
  rw [CochainComplex.isStrictlyGE_iff]
  intro i hi
  exact isZero_generatedSubcomplex_X L p x i fun k ↦ ⟨by have := h k; lia, by have := h k; lia⟩

/-- The subcomplex generated by the sections `x k` vanishes above the degrees `p k + 1`. -/
lemma isStrictlyLE_generatedSubcomplex (b : ℤ) (h : ∀ k, p k + 1 ≤ b) :
    (generatedSubcomplex L p x).IsStrictlyLE b := by
  rw [CochainComplex.isStrictlyLE_iff]
  intro i hi
  exact isZero_generatedSubcomplex_X L p x i fun k ↦ ⟨by have := h k; lia, by have := h k; lia⟩

end Generated

section Retract

open _root_.DerivedCategory Sheaf

/-- Chain maps out of the unit in degree `0`: the cocycle of a composite `g ≫ h` is the image
under `h` of the cocycle of `g`. -/
lemma singleUnitHomEquiv_comp_coe
    {M N : CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ}
    (g : (HomologicalComplex.single _ (.up ℤ) 0).obj
      (𝟙_ (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ))) ⟶ M) (h : M ⟶ N) :
    (singleUnitHomEquiv N (g ≫ h)).1 = (h.f 0).hom.app _ (singleUnitHomEquiv M g).1 :=
  rfl

/-- **A dualizable complex is a retract of a finite subcomplex** (Stacks, Tag 0FPV, first
step), global-section form. Let `C` have a right dual `D` in `D(X_proét)`, with `C ≅ Q(L)` and
`D ≅ Q(F)` for a K-flat complex `F` of flat sheaves. Suppose that the coevaluation, transported
to `𝟙 ⟶ Q(L ⊗ F)`, factors through `Q(φ)` for a chain map `φ` out of the unit in degree `0`, whose
cocycle over the terminal object is a finite sum `∑ₖ xₖ ⊗ yₖ` of pure tensors of global sections
`xₖ ∈ L^{pₖ}`, `yₖ ∈ F^{-pₖ}`. Then `C ≅ Q(L)` factors through `Q(L')`, for the subcomplex
`L' ⊆ L` generated by the `xₖ` (which is strictly bounded, see
`isStrictlyGE_generatedSubcomplex` and `isStrictlyLE_generatedSubcomplex`).

As `F` has flat terms, `L' ⊗ F ⟶ L ⊗ F` is a monomorphism, so the lift `∑ₖ xₖ ⊗ yₖ` of the cocycle
to `L' ⊗ F` is again a cocycle. The coevaluation thus factors through `Q(L') ⊗ D`, and the
zigzag identity factors `C ≅ Q(L)` through `Q(L')`. -/
theorem exists_comp_Q_map_generatedSubcomplexι_eq
    (C D : _root_.DerivedCategory (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)))
    [ExactPairing C D]
    (L : CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ)
    (e : C ≅ Q.obj L)
    (F : CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ)
    (hFflat : ∀ n, ObjectProperty.flat (F.X n))
    (hF : (HomologicalComplex.quasiIso _ (.up ℤ)).kFlat F) (eD : D ≅ Q.obj F)
    (φ : (HomologicalComplex.single _ (.up ℤ) 0).obj
      (𝟙_ (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ))) ⟶ L ⊗ F)
    (v : 𝟙_ _ ⟶ Q.obj ((HomologicalComplex.single _ (.up ℤ) 0).obj
      (𝟙_ (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)))))
    (hφ : η_ C D ≫ e.hom ▷ D ≫ Q.obj L ◁ eD.hom ≫ (QObjTensorQObjIsoOfKFlatRight L F hF).hom =
      v ≫ Q.map φ)
    {m : ℕ} (p : Fin m → ℤ) (x : ∀ k, (L.X (p k)).obj.obj (op (terminalProEt X)))
    (y : ∀ k, (F.X (-p k)).obj.obj (op (terminalProEt X)))
    (hxy : (singleUnitHomEquiv (L ⊗ F) φ).1 =
      ∑ k, (HomologicalComplex.ιTensorObj L F (p k) (-p k) 0 (by simp)).hom.app _
        (tensorSectionMap _ _ _ (x k ⊗ₜ y k))) :
    ∃ w : C ⟶ Q.obj (generatedSubcomplex L p x),
      w ≫ Q.map (generatedSubcomplexι L p x) = e.hom := by
  choose x' hx' using exists_generatedSubcomplexι_f_app_eq L p x
  let s : ((generatedSubcomplex L p x ⊗ F).X 0).obj.obj (op (terminalProEt X)) :=
    ∑ k, (HomologicalComplex.ιTensorObj (generatedSubcomplex L p x) F (p k) (-p k) 0
      (by simp)).hom.app _
      (tensorSectionMap _ _ _ (x' k ⊗ₜ y k))
  have hs : ((generatedSubcomplexι L p x ▷ F).f 0).hom.app _ s =
      (singleUnitHomEquiv (L ⊗ F) φ).1 := by
    rw [hxy, map_sum]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    refine (congr_hom_app_apply (CochainComplex.ιTensorObj_comp_whiskerRight_f
      (generatedSubcomplexι L p x) F (p k) (-p k) 0
        (by simp)) _).trans ?_
    exact congrArg ((HomologicalComplex.ιTensorObj L F (p k) (-p k) 0 (by simp)).hom.app _)
      ((whiskerRight_hom_app_tensorSectionMap _ _ _ _ _).trans (by rw [hx']))
  have : ∀ n, Mono ((generatedSubcomplexι L p x).f n) := fun n ↦ inferInstance
  have : Mono ((generatedSubcomplexι L p x ▷ F).f 1) :=
    CochainComplex.mono_whiskerRight_f (generatedSubcomplexι L p x) F hFflat 1
  have hd : ((generatedSubcomplex L p x ⊗ F).d 0 1).hom.app _ s = 0 := by
    apply injective_hom_app_of_mono ((generatedSubcomplexι L p x ▷ F).f 1)
    rw [← comp_hom_app_apply, ← HomologicalComplex.Hom.comm, comp_hom_app_apply, hs,
      (singleUnitHomEquiv (L ⊗ F) φ).2, map_zero]
  let φ' := (singleUnitHomEquiv (generatedSubcomplex L p x ⊗ F)).symm ⟨s, hd⟩
  have hφ' : φ' ≫ generatedSubcomplexι L p x ▷ F = φ := by
    apply (singleUnitHomEquiv (L ⊗ F)).injective
    refine Subtype.ext ?_
    refine (singleUnitHomEquiv_comp_coe φ' (generatedSubcomplexι L p x ▷ F)).trans ?_
    simp only [φ', Equiv.apply_symm_apply]
    exact hs
  let T (K : CochainComplex (Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} Λ)) ℤ) :
      Q.obj K ⊗ D ≅ Q.obj (K ⊗ F) :=
    whiskerLeftIso (Q.obj K) eD ≪≫ QObjTensorQObjIsoOfKFlatRight K F hF
  have hT : Q.map (generatedSubcomplexι L p x) ▷ D ≫ (T L).hom =
      (T (generatedSubcomplex L p x)).hom ≫ Q.map (generatedSubcomplexι L p x ▷ F) := by
    rw [Iso.trans_hom, Iso.trans_hom, whiskerLeftIso_hom, whiskerLeftIso_hom,
      ← whisker_exchange_assoc, qObjTensorQObjIsoOfKFlatRight_hom_naturality, Category.assoc]
  refine exists_comp_eq_of_coevaluation_comp_whiskerRight e.hom
    (Q.map (generatedSubcomplexι L p x))
    (v ≫ Q.map φ' ≫ (T (generatedSubcomplex L p x)).inv) ?_
  rw [← cancel_mono (T L).hom, Category.assoc, Category.assoc, Category.assoc, hT,
    Iso.inv_hom_id_assoc, ← Q.map_comp, hφ', ← hφ]
  rw [Iso.trans_hom, whiskerLeftIso_hom]
  simp only [Category.assoc]

end Retract

end AlgebraicGeometry.ProEtale
