/-!
# Pro-étale locally finitely generated module objects

Let `Λ` be a commutative condensed ring and `X` a scheme. A module object `M` over `Λ_X` on
`X_proét` is *pro-étale locally finitely generated*
(`ProEtale.CondensedRing.IsLocallyFinitelyGenerated`) if there is a pro-étale cover `{gᵢ}` such
that every `gᵢ^* M` is a quotient of a free module of finite rank. We record:

* finitely generated module objects are closed under quotients and extensions, and kernels of
  epimorphisms from free modules of finite rank onto finitely presented ones are locally finitely
  generated (`ProEtale.CondensedRing.IsLocallyFinitelyGenerated.of_epi`,
  `ProEtale.CondensedRing.IsLocallyFinitelyGenerated.of_exact`,
  `ProEtale.CondensedRing.IsLocallyFinitelyGenerated.kernel_of_isFree`);
* morphisms from free modules of finite rank lift pro-étale locally through epimorphisms
  (`ProEtale.CondensedRing.exists_cover_lift_of_isFree`), since epimorphisms onto free modules
  split pro-étale locally.

The arguments are diagram chases up to refinements in an abelian category
(`CategoryTheory.epi_biprod_desc_of_exact`, `CategoryTheory.epi_biprod_desc_kernel_lift`).
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped CategoryTheory.Obj

/-! ### Diagram chases -/

namespace CategoryTheory

variable {C : Type*} [Category* C] [Abelian C]

/-- Let `A ⟶ B ⟶ K` be exact, `e : A' ⟶ A` an epimorphism and `s : K' ⟶ B` such that `s ≫ g` is
an epimorphism. Then `[e ≫ f, s] : A' ⊞ K' ⟶ B` is an epimorphism: `B` is generated by the
images of `A` and of `s`. -/
lemma epi_biprod_desc_of_exact {S : ShortComplex C} (hS : S.Exact) {A' K' : C} (e : A' ⟶ S.X₁)
    [Epi e] (s : K' ⟶ S.X₂) [Epi (s ≫ S.g)] : Epi (biprod.desc (e ≫ S.f) s) := by
  rw [epi_iff_surjective_up_to_refinements]
  intro T x
  obtain ⟨T₁, π₁, _, y, hy⟩ := surjective_up_to_refinements_of_epi (s ≫ S.g) (x ≫ S.g)
  obtain ⟨T₂, π₂, _, z, hz⟩ := hS.exact_up_to_refinements (π₁ ≫ x - y ≫ s) (by
    rw [Preadditive.sub_comp, Category.assoc, hy, Category.assoc, sub_self])
  obtain ⟨T₃, π₃, _, w, hw⟩ := surjective_up_to_refinements_of_epi e z
  refine ⟨T₃, π₃ ≫ π₂ ≫ π₁, inferInstance, biprod.lift w (π₃ ≫ π₂ ≫ y), ?_⟩
  rw [biprod.lift_desc, Category.assoc, ← reassoc_of% hw, ← hz]
  simp only [Preadditive.comp_sub, Category.assoc, sub_add_cancel]

/-- Let `H ⟶ G ⟶ Q` be exact, and `p : F ⟶ Q` together with `s : F ⟶ G` and `t : G ⟶ F` such
that `s ≫ π = p` and `t ≫ p = π`. Then the kernel of `p` is generated by the images of `1 - s ≫ t`
and of `a ≫ t`, i.e. it is a quotient of `F ⊞ H`. -/
lemma epi_biprod_desc_kernel_lift {S : ShortComplex C} (hS : S.Exact) {F : C} (p : F ⟶ S.X₃)
    (s : F ⟶ S.X₂) (t : S.X₂ ⟶ F) (hs : s ≫ S.g = p) (ht : t ≫ p = S.g) :
    Epi (biprod.desc (kernel.lift p (𝟙 F - s ≫ t) (by
        rw [Preadditive.sub_comp, Category.assoc, ht, hs, Category.id_comp, sub_self]))
      (kernel.lift p (S.f ≫ t) (by rw [Category.assoc, ht, S.zero]))) := by
  rw [epi_iff_surjective_up_to_refinements]
  intro T x
  obtain ⟨T₁, π₁, _, z, hz⟩ := hS.exact_up_to_refinements (x ≫ kernel.ι p ≫ s) (by
    rw [Category.assoc, Category.assoc, hs, kernel.condition, comp_zero])
  refine ⟨T₁, π₁, inferInstance, biprod.lift (π₁ ≫ x ≫ kernel.ι p) z, ?_⟩
  rw [biprod.lift_desc, ← cancel_mono (kernel.ι p)]
  simp only [Preadditive.add_comp, Category.assoc, kernel.lift_ι, Preadditive.comp_sub,
    Category.comp_id]
  rw [reassoc_of% hz]
  abel

end CategoryTheory

/-! ### Finitely generated module objects -/

namespace CategoryTheory.Mod

open MonoidalCategory

variable {C : Type*} [Category* C] [MonoidalCategory C] [Abelian C] [MonoidalPreadditive C]
  (R : C) [MonObj R] [PreservesFiniteColimits (tensorLeft R)]

/-- A module object is *finitely generated* if it is a quotient of a free module of finite
rank. -/
def IsFinitelyGenerated (M : Mod C R) : Prop :=
  ∃ (n : ℕ) (p : finiteFree R n ⟶ M), Epi p

variable {R}

omit [PreservesFiniteColimits (tensorLeft R)] in
/-- A quotient of a finitely generated module object is finitely generated. -/
lemma IsFinitelyGenerated.of_epi {M N : Mod C R} (h : IsFinitelyGenerated R M) (f : M ⟶ N)
    [Epi f] : IsFinitelyGenerated R N := by
  obtain ⟨n, p, _⟩ := h
  exact ⟨n, p ≫ f, epi_comp _ _⟩

omit [PreservesFiniteColimits (tensorLeft R)] in
/-- Being finitely generated is invariant under isomorphism. -/
lemma IsFinitelyGenerated.of_iso {M N : Mod C R} (h : IsFinitelyGenerated R M) (e : M ≅ N) :
    IsFinitelyGenerated R N :=
  h.of_epi e.hom

omit [PreservesFiniteColimits (tensorLeft R)] in
/-- A quotient of a free module object of finite rank is finitely generated. -/
lemma IsFree.isFinitelyGenerated_of_epi {P M : Mod C R} (hP : IsFree R P) (p : P ⟶ M) [Epi p] :
    IsFinitelyGenerated R M := by
  obtain ⟨n, ⟨e⟩⟩ := hP
  exact ⟨n, e.inv ≫ p, epi_comp _ _⟩

/-- A finitely presented module object is finitely generated. -/
lemma IsFinitelyPresented.isFinitelyGenerated {M : Mod C R} (h : IsFinitelyPresented R M) :
    IsFinitelyGenerated R M := by
  obtain ⟨n, m, f, ⟨e⟩⟩ := h
  exact ⟨n, cokernel.π f ≫ e.inv, epi_comp _ _⟩

end CategoryTheory.Mod

/-! ### Pro-étale locally finitely generated module objects -/

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

/-- **Refining the members of a pro-étale cover.** If every member `𝒰.X i` of a pro-étale cover
has a pro-étale cover on whose members `Q` holds for the composite to `X`, then `Q` holds for the
members of a pro-étale cover of `X`. The property `Q` is kept abstract, so that the members of the
composite cover need not be unfolded inside `Q`. -/
lemma exists_cover_bind {X : Scheme.{u}} (Q : ∀ Y : Scheme.{u}, (Y ⟶ X) → Prop)
    (𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X)
    (h : ∀ i, ∃ 𝒱 : Scheme.Cover.{u} Scheme.proetalePrecoverage (𝒰.X i), ∀ j,
      Q (𝒱.X j) (𝒱.f j ≫ 𝒰.f i)) :
    ∃ 𝒲 : Scheme.Cover.{u} Scheme.proetalePrecoverage X, ∀ k, Q (𝒲.X k) (𝒲.f k) := by
  choose 𝒱 h𝒱 using h
  exact ⟨𝒰.bind 𝒱, fun k ↦ h𝒱 k.1 k.2⟩

variable {Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}} [MonObj Λ] [IsCommMonObj Λ]

/-- The pullback of a finitely generated module object is finitely generated. -/
lemma IsFinitelyGenerated.upperStar {W X : Scheme.{u}} (g : W ⟶ X)
    {M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hM : Mod.IsFinitelyGenerated (condensedRingObj Λ X) M) :
    Mod.IsFinitelyGenerated (condensedRingObj Λ W) ((g)^*⟦Λ⟧.obj M) := by
  obtain ⟨n, p, _⟩ := hM
  exact (IsFree.upperStar Λ g ⟨n, ⟨Iso.refl _⟩⟩).isFinitelyGenerated_of_epi ((g)^*⟦Λ⟧.map p)

variable (Λ) in
/-- A module object over `Λ_X` is *pro-étale locally finitely generated* if its pullbacks to the
members of a pro-étale cover are finitely generated. -/
def IsLocallyFinitelyGenerated {X : Scheme.{u}}
    (M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)) : Prop :=
  ∃ 𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X, ∀ i,
    Mod.IsFinitelyGenerated (condensedRingObj Λ (𝒰.X i)) ((𝒰.f i)^*⟦Λ⟧.obj M)

/-- A finitely generated module object is pro-étale locally finitely generated. -/
lemma IsFinitelyGenerated.isLocallyFinitelyGenerated {X : Scheme.{u}}
    {M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hM : Mod.IsFinitelyGenerated (condensedRingObj Λ X) M) :
    IsLocallyFinitelyGenerated Λ M :=
  ⟨.singleton (𝟙 X) (Precoverage.mem_coverings_of_isIso _),
    fun _ ↦ IsFinitelyGenerated.upperStar _ hM⟩

/-- Pro-étale local finite generation is local: if the pullbacks of `M` to the members of a
pro-étale cover are locally finitely generated, so is `M`. -/
lemma isLocallyFinitelyGenerated_of_cover {X : Scheme.{u}}
    {M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X)
    (h : ∀ i, IsLocallyFinitelyGenerated Λ ((𝒰.f i)^*⟦Λ⟧.obj M)) :
    IsLocallyFinitelyGenerated Λ M := by
  refine exists_cover_bind (fun Y g ↦ Mod.IsFinitelyGenerated (condensedRingObj Λ Y)
    ((g)^*⟦Λ⟧.obj M)) 𝒰 fun i ↦ ?_
  obtain ⟨𝒱, h𝒱⟩ := h i
  exact ⟨𝒱, fun j ↦
    (h𝒱 j).of_iso ((CondensedRing.upperStarComp Λ (𝒱.f j) (𝒰.f i)).app M).symm⟩

/-- A quotient of a pro-étale locally finitely generated module object is pro-étale locally
finitely generated. -/
lemma IsLocallyFinitelyGenerated.of_epi {X : Scheme.{u}}
    {M N : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (h : IsLocallyFinitelyGenerated Λ M) (f : M ⟶ N) [Epi f] : IsLocallyFinitelyGenerated Λ N := by
  obtain ⟨𝒰, h𝒰⟩ := h
  exact ⟨𝒰, fun i ↦ (h𝒰 i).of_epi ((𝒰.f i)^*⟦Λ⟧.map f)⟩

/-- Pro-étale local finite generation is invariant under isomorphism. -/
lemma IsLocallyFinitelyGenerated.of_iso {X : Scheme.{u}}
    {M N : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (h : IsLocallyFinitelyGenerated Λ M) (e : M ≅ N) : IsLocallyFinitelyGenerated Λ N :=
  h.of_epi e.hom

/-- The pullback of a pro-étale locally finitely generated module object is pro-étale locally
finitely generated. -/
lemma IsLocallyFinitelyGenerated.upperStar {W X : Scheme.{u}} (g : W ⟶ X)
    {M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hM : IsLocallyFinitelyGenerated Λ M) : IsLocallyFinitelyGenerated Λ ((g)^*⟦Λ⟧.obj M) := by
  obtain ⟨𝒰, h𝒰⟩ := hM
  refine ⟨𝒰.pullback₁ g, fun i ↦ ?_⟩
  let a : (𝒰.pullback₁ g).X i ⟶ 𝒰.X i := pullback.snd g (𝒰.f i)
  exact (IsFinitelyGenerated.upperStar a (h𝒰 i)).of_iso
    (upperStarSquareIso Λ (a := a) (b := (𝒰.pullback₁ g).f i) pullback.condition.symm M)

/-- A pro-étale locally finitely presented module object is pro-étale locally finitely
generated. -/
lemma _root_.AlgebraicGeometry.ProEtale.IsLocallyFinitelyPresented.isLocallyFinitelyGenerated
    {X : Scheme.{u}}
    {M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hM : IsLocallyFinitelyPresented (condensedRingObj Λ X) M) :
    IsLocallyFinitelyGenerated Λ M := by
  obtain ⟨𝒰, h𝒰⟩ := (isLocallyFinitelyPresented_iff M).1 hM
  exact ⟨𝒰, fun i ↦ (h𝒰 i).isFinitelyGenerated⟩

/-- A finitely presented module object is pro-étale locally finitely presented. -/
lemma IsFinitelyPresented.isLocallyFinitelyPresented {X : Scheme.{u}}
    {M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hM : Mod.IsFinitelyPresented (condensedRingObj Λ X) M) :
    IsLocallyFinitelyPresented (condensedRingObj Λ X) M :=
  (isLocallyFinitelyPresented_iff M).2 ⟨.singleton (𝟙 X) (Precoverage.mem_coverings_of_isIso _),
    fun _ ↦ IsFinitelyPresented.upperStar Λ _ hM⟩

/-! ### Local lifting -/

/-- **Morphisms from free modules lift pro-étale locally through epimorphisms**: for an
epimorphism `q : B ⟶ C` and a morphism `t : P ⟶ C` from a free module of finite rank, there is a
pro-étale cover on whose members `g` the pullback `g^* t` factors through `g^* q`. -/
lemma exists_cover_lift_of_isFree {X : Scheme.{u}}
    {B C P : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)} (q : B ⟶ C)
    [Epi q] (hP : Mod.IsFree (condensedRingObj Λ X) P) (t : P ⟶ C) :
    ∃ 𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X, ∀ i,
      ∃ s : (𝒰.f i)^*⟦Λ⟧.obj P ⟶ (𝒰.f i)^*⟦Λ⟧.obj B,
        s ≫ (𝒰.f i)^*⟦Λ⟧.map q = (𝒰.f i)^*⟦Λ⟧.map t := by
  obtain ⟨𝒰, h𝒰⟩ := freeEpiLocalSplitting X (condensedRingObj Λ X) _ _ (pullback.snd q t) hP
  refine ⟨𝒰, fun i ↦ ?_⟩
  have : IsSplitEpi ((𝒰.f i)^*⟦Λ⟧.map (pullback.snd q t)) :=
    inferInstanceAs (IsSplitEpi ((Mod.extendScalars (condensedPullbackHom Λ (𝒰.f i))).map
      (((𝒰.f i)^*[Ab.{u + 1}].mapMod (condensedRingObj Λ X)).map (pullback.snd q t))))
  refine ⟨section_ ((𝒰.f i)^*⟦Λ⟧.map (pullback.snd q t)) ≫
    (𝒰.f i)^*⟦Λ⟧.map (pullback.fst q t), ?_⟩
  rw [Category.assoc, ← Functor.map_comp, pullback.condition, Functor.map_comp,
    IsSplitEpi.id_assoc]

/-! ### Extensions and kernels -/

/-- If `M` and `N` are finitely generated, a common pro-étale cover makes both pullbacks
finitely generated. -/
lemma exists_cover_isFinitelyGenerated_and {X : Scheme.{u}}
    {M N : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hM : IsLocallyFinitelyGenerated Λ M) (hN : IsLocallyFinitelyGenerated Λ N) :
    ∃ 𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X, ∀ i,
      Mod.IsFinitelyGenerated (condensedRingObj Λ (𝒰.X i)) ((𝒰.f i)^*⟦Λ⟧.obj M) ∧
      Mod.IsFinitelyGenerated (condensedRingObj Λ (𝒰.X i)) ((𝒰.f i)^*⟦Λ⟧.obj N) := by
  obtain ⟨𝒰, h𝒰⟩ := hM
  obtain ⟨𝒱, h𝒱⟩ := hN
  have hQ (L : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))
      ⦃Y W : Scheme.{u}⦄ (a : Y ⟶ W) (f : W ⟶ X)
      (h : Mod.IsFinitelyGenerated (condensedRingObj Λ W) ((f)^*⟦Λ⟧.obj L)) :
      Mod.IsFinitelyGenerated (condensedRingObj Λ Y) ((a ≫ f)^*⟦Λ⟧.obj L) :=
    (IsFinitelyGenerated.upperStar a h).of_iso ((CondensedRing.upperStarComp Λ a f).app L).symm
  exact exists_cover_forall_and _ _ (hQ M) (hQ N) 𝒰 𝒱 h𝒰 h𝒱

/-- An exact sequence `A ⟶ B ⟶ K ⟶ 0` with `A` and `K` finitely generated has `B` pro-étale
locally finitely generated. -/
lemma isLocallyFinitelyGenerated_of_exact_of_isFinitelyGenerated {X : Scheme.{u}}
    {S : ShortComplex (Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))}
    (hS : S.Exact) [Epi S.g] (h₁ : Mod.IsFinitelyGenerated (condensedRingObj Λ X) S.X₁)
    (h₃ : Mod.IsFinitelyGenerated (condensedRingObj Λ X) S.X₃) :
    IsLocallyFinitelyGenerated Λ S.X₂ := by
  obtain ⟨a, e, _⟩ := h₁
  obtain ⟨c, p, _⟩ := h₃
  obtain ⟨𝒰, h𝒰⟩ := exists_cover_lift_of_isFree S.g ⟨c, ⟨Iso.refl _⟩⟩ p
  refine ⟨𝒰, fun i ↦ ?_⟩
  obtain ⟨s, hs⟩ := h𝒰 i
  let F := (𝒰.f i)^*⟦Λ⟧
  have hS' : (S.map F).Exact := hS.map F
  have : Epi (s ≫ (S.map F).g) := by
    rw [ShortComplex.map_g, hs]
    infer_instance
  have : Epi (F.map e) := inferInstance
  have := epi_biprod_desc_of_exact (S := S.map F) hS' (F.map e) s
  exact (free_biprod (IsFree.upperStar Λ _ ⟨a, ⟨Iso.refl _⟩⟩)
    (IsFree.upperStar Λ _ ⟨c, ⟨Iso.refl _⟩⟩)).isFinitelyGenerated_of_epi
    (biprod.desc (F.map e ≫ (S.map F).f) s)

/-- **Extensions**: an exact sequence `A ⟶ B ⟶ K ⟶ 0` with `A` and `K` pro-étale locally
finitely generated has `B` pro-étale locally finitely generated. -/
lemma IsLocallyFinitelyGenerated.of_exact {X : Scheme.{u}}
    {S : ShortComplex (Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))}
    (hS : S.Exact) [Epi S.g] (h₁ : IsLocallyFinitelyGenerated Λ S.X₁)
    (h₃ : IsLocallyFinitelyGenerated Λ S.X₃) : IsLocallyFinitelyGenerated Λ S.X₂ := by
  obtain ⟨𝒰, h𝒰⟩ := exists_cover_isFinitelyGenerated_and h₁ h₃
  refine isLocallyFinitelyGenerated_of_cover 𝒰 fun i ↦ ?_
  have : Epi (S.map (𝒰.f i)^*⟦Λ⟧).g :=
    inferInstanceAs (Epi ((𝒰.f i)^*⟦Λ⟧.map S.g))
  exact isLocallyFinitelyGenerated_of_exact_of_isFinitelyGenerated (S := S.map (𝒰.f i)^*⟦Λ⟧)
    (hS.map _) (h𝒰 i).1 (h𝒰 i).2

/-- Let `H ⟶ G ⟶ Q` be exact with `H` and `G` free of finite rank, and `p : P ⟶ Q` an
epimorphism from a free module of finite rank factoring through `G`. Then the kernel of `p` is
pro-étale locally finitely generated: pro-étale locally `G ⟶ Q` lifts through `p`, and then the
kernel of `p` is a quotient of `P ⊞ H` (`CategoryTheory.epi_biprod_desc_kernel_lift`). -/
lemma isLocallyFinitelyGenerated_kernel_of_lift {X : Scheme.{u}}
    {S : ShortComplex (Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))}
    (hS : S.Exact) (hX₁ : Mod.IsFree (condensedRingObj Λ X) S.X₁)
    (hX₂ : Mod.IsFree (condensedRingObj Λ X) S.X₂)
    {P : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hP : Mod.IsFree (condensedRingObj Λ X) P) (p : P ⟶ S.X₃) [Epi p] (s : P ⟶ S.X₂)
    (hs : s ≫ S.g = p) : IsLocallyFinitelyGenerated Λ (kernel p) := by
  obtain ⟨𝒰, h𝒰⟩ := exists_cover_lift_of_isFree p hX₂ S.g
  refine ⟨𝒰, fun i ↦ ?_⟩
  obtain ⟨t, ht⟩ := h𝒰 i
  let F := (𝒰.f i)^*⟦Λ⟧
  have hs' : F.map s ≫ (S.map F).g = F.map p := by
    rw [ShortComplex.map_g, ← F.map_comp, hs]
  obtain ⟨q, _⟩ : ∃ q : F.obj P ⊞ F.obj S.X₁ ⟶ kernel (F.map p), Epi q :=
    ⟨_, epi_biprod_desc_kernel_lift (S := S.map F) (hS.map F) (F.map p) (F.map s) t hs' ht⟩
  exact ((free_biprod (IsFree.upperStar Λ _ hP)
    (IsFree.upperStar Λ _ hX₁)).isFinitelyGenerated_of_epi q).of_iso (PreservesKernel.iso F p).symm

/-- The kernel of an epimorphism from a free module of finite rank onto a finitely presented
module is pro-étale locally finitely generated. -/
lemma isLocallyFinitelyGenerated_kernel_of_isFinitelyPresented {X : Scheme.{u}}
    {P Q : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hP : Mod.IsFree (condensedRingObj Λ X) P) (p : P ⟶ Q) [Epi p]
    (hQ : Mod.IsFinitelyPresented (condensedRingObj Λ X) Q) :
    IsLocallyFinitelyGenerated Λ (kernel p) := by
  obtain ⟨n, m, a, ⟨e⟩⟩ := hQ
  let S := ShortComplex.mk a (cokernel.π a) (cokernel.condition a)
  have hS : S.Exact := S.exact_of_g_is_cokernel (cokernelIsCokernel a)
  have : Epi S.g := inferInstanceAs (Epi (cokernel.π a))
  obtain ⟨𝒰, h𝒰⟩ := exists_cover_lift_of_isFree S.g hP (p ≫ e.hom)
  refine isLocallyFinitelyGenerated_of_cover 𝒰 fun i ↦ ?_
  obtain ⟨s, hs⟩ := h𝒰 i
  let F := (𝒰.f i)^*⟦Λ⟧
  have : Epi (F.map (p ≫ e.hom)) := inferInstance
  exact (isLocallyFinitelyGenerated_kernel_of_lift (S := S.map F) (hS.map F)
    (IsFree.upperStar Λ _ ⟨m, ⟨Iso.refl _⟩⟩) (IsFree.upperStar Λ _ ⟨n, ⟨Iso.refl _⟩⟩)
    (IsFree.upperStar Λ _ hP) (F.map (p ≫ e.hom)) s hs).of_iso
    ((PreservesKernel.iso F (p ≫ e.hom)).symm ≪≫ F.mapIso (kernelCompMono p e.hom))

/-- **Kernels**: the kernel of an epimorphism from a free module of finite rank onto a
pro-étale locally finitely presented module is pro-étale locally finitely generated. -/
lemma IsLocallyFinitelyGenerated.kernel_of_isFree {X : Scheme.{u}}
    {P Q : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (hP : Mod.IsFree (condensedRingObj Λ X) P) (p : P ⟶ Q) [Epi p]
    (hQ : IsLocallyFinitelyPresented (condensedRingObj Λ X) Q) :
    IsLocallyFinitelyGenerated Λ (kernel p) := by
  obtain ⟨𝒰, h𝒰⟩ := (isLocallyFinitelyPresented_iff Q).1 hQ
  refine isLocallyFinitelyGenerated_of_cover 𝒰 fun i ↦ ?_
  have : Epi ((𝒰.f i)^*⟦Λ⟧.map p) := inferInstance
  exact (isLocallyFinitelyGenerated_kernel_of_isFinitelyPresented (IsFree.upperStar Λ _ hP) _
    (h𝒰 i)).of_iso (PreservesKernel.iso _ p).symm

end AlgebraicGeometry.ProEtale.CondensedRing
