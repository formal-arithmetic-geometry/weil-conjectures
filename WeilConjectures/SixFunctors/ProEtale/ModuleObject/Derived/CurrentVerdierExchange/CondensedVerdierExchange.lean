/-! # Verdier exchange with its specified naturality and comparison squares

Source: latest blueprint part-duality-trace-formula/sec-poincare-duality/
sec-perfect-complexes-on-the-point-and-two-exchange-formulas/sk-def-ops/sk-thm-sf-package,
fix-cor-verdier-exchange.md and its three-step proof
(blueprint: fix-cor-verdier-exchange).

The canonical map and composition mate are the recorded ordinary condensed constructions
`condensedVerdierEpsilon` and `condensedVerdierDualizingComparison`. The statements below
retain their actual evaluation/counit normalization, including under nonflat finite reduction.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor
namespace AlgebraicGeometry.ProEtale.CondensedRing
namespace CurrentVerdierExchange

local instance (k : Type u) [Field k] :
    LocallyOfFiniteType (Over.mk (𝟙 (Spec (.of k)))).hom :=
  inferInstanceAs (LocallyOfFiniteType (𝟙 _))
local instance (k : Type u) [Field k] :
    QuasiCompact (Over.mk (𝟙 (Spec (.of k)))).hom :=
  inferInstanceAs (QuasiCompact (𝟙 _))
local instance (k : Type u) [Field k] :
    IsSeparated (Over.mk (𝟙 (Spec (.of k)))).hom :=
  inferInstanceAs (IsSeparated (𝟙 _))

/-- The source's exceptional admissibility, using the existing finite-ring and native
predicates. Finite coefficients retain FullCD; higher coefficients are tested at the
ring itself. The finite presentation is identified as a ring object, not merely as a type.
Source: fix-cor-verdier-exchange.md, admissibility hypotheses, and
 def-weil-exceptional-adjoint-admissibility, clauses (1)--(3)
(blueprint: fix-cor-verdier-exchange). -/
def admissible (ell : ℕ) [Fact ell.Prime] (Λ : ScalarSixRing.{u})
    {X Y : Scheme.{u}} {f : X ⟶ Y} (c : Compactification f) : Prop :=
  (∃ (A : Type u) (_ : CommRing A) (_ : Finite A),
    Nonempty (Mon.mk Λ.X ≅ Mon.mk (cartesianFinitePointRing A)) ∧
      WeilConjectures.IsExceptionalAdjointAdmissibleAtFiniteRing A c) ∨
  (IsNativeExceptionalCoefficient ell Λ.X ∧
    IsExceptionalAdjointAdmissibleAtCondensedRing Λ.X c)

variable (ell : ℕ) [Fact ell.Prime] (k : Type u) [Field k]
  [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ell)]
  (hk : Finite k ∨ IsAlgClosed k)
  (Λ : ScalarSixRing.{u}) (hΛ : IsLocalizingAdmissibleCoefficient ell Λ.X)
  {X Y : Over (Spec (.of k))}
  [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsSeparated Y.hom]
  (f : X ⟶ Y)

/-- Invertibility of exactly the source's canonical exchange. This is an isomorphism
D_Y(Rf_! M) to Rf_* D_X M, not a free isomorphism of two unspecified presentations.
Source: fix-cor-verdier-exchange.md and proof Steps 1--2
(blueprint: fix-cor-verdier-exchange).
Proof: take the mate of the normalized compact-support compositor at the coefficient
unit to obtain c_f. The exceptional image omega_Y of that unit is finite-Tor by
admissibility. Invert the tensor-adjunction pairing at omega_Y and follow it by
Rf_* RHom(M,c_f). Both factors are isomorphisms; their composite is the specified epsilon.
This uses no biduality theorem. -/
theorem exchange_isIso
    (_hf : admissible ell Λ (compactificationOverField f))
    (_haX : admissible ell Λ (compactificationOverField (Over.mkIdTerminal.from X)))
    (_haY : admissible ell Λ (compactificationOverField (Over.mkIdTerminal.from Y)))
    (M : ConstantModelConstructibleFiniteTor Λ.X X.left) :
    IsIso (exchange ell k hk Λ hΛ f M) := by
  sorry

/-- The integer shift square, with the negative shift in the dual's first variable.
The membership proof in the conclusion merely presents the shifted finite-Tor object.
Source: fix-cor-verdier-exchange.proof.md, Step 3
(blueprint: fix-cor-verdier-exchange).
Proof: apply the first-variable shift square of tensor-adjunction at omega_Y.
The canonical source-Hom shift is natural in its second argument, so it commutes
with RHom(M,c_f). The derived direct-image shift transports the other side.
Invert the first pairing and paste; the input shift r becomes the output shift -r. -/
theorem exchange_shift
    (M : ConstantModelConstructibleFiniteTor Λ.X X.left) (r : ℤ) :
    letI : (moduleObjectDerivedPushforward Λ.X f.left).CommShift ℤ :=
      Functor.instCommShiftDerivedCategoryRightDerivedFunctorInt (lowerStar Λ.X f.left)
    let F := rightDerivedLowerShriekOfCompactification Λ.X (compactificationOverField f)
    let wX := condensedVerdierDualizingComplex ell k
      (Fact.out : ringChar k ≠ ell) hk Λ.X hΛ X
    let wY := condensedVerdierDualizingComplex ell k
      (Fact.out : ringChar k ≠ ell) hk Λ.X hΛ Y
    ∃ hMr : (constantModelBoundedConstructible Λ.X X.left ⊓
        _root_.DerivedCategory.finiteTorAmplitude _) (M.obj⟦r⟧),
      ((derivedHom Λ.X Y.left).map ((F.commShiftIso r).inv.app M.obj).op).app wY ≫
          (siteHomSourceShift (F.obj M.obj) r).hom.app wY ≫
          (shiftFunctor _ (-r)).map (exchange ell k hk Λ hΛ f M) =
        exchange ell k hk Λ hΛ f ⟨M.obj⟦r⟧, hMr⟩ ≫
          (moduleObjectDerivedPushforward Λ.X f.left).map
            ((siteHomSourceShift M.obj r).hom.app wX) ≫
          ((moduleObjectDerivedPushforward Λ.X f.left).commShiftIso (-r)).hom.app
            (((derivedHom Λ.X X.left).obj (op M.obj)).obj wX) := by
  sorry

/-- The specified scalar comparison on dualizing objects, as the exceptional mate of
compact-support scalar change, followed by the canonical scalar-unit identification.
The supplied q is pinned to scalarCompactSupportMap in the scalar theorem below.
Source: fix-cor-verdier-exchange.proof.md, Step 3, beta at a_T
(blueprint: fix-cor-verdier-exchange). -/
def omegaScalar {Λ' : ScalarSixRing.{u}}
    (hΛ' : IsLocalizingAdmissibleCoefficient ell Λ'.X) (a : Λ ⟶ Λ')
    (T : Over (Spec (.of k)))
    [LocallyOfFiniteType T.hom] [QuasiCompact T.hom] [IsSeparated T.hom]
    (hW : (constantModelBoundedConstructible Λ'.X T.left ⊓
      _root_.DerivedCategory.finiteTorAmplitude _)
      ((scalarSixChange a T.left).obj
        (condensedVerdierDualizingComplex ell k
          (Fact.out : ringChar k ≠ ell) hk Λ.X hΛ T)))
    (q : (scalarSixChange a (Spec (.of k))).obj
        ((rightDerivedLowerShriekOfCompactification Λ.X
          (compactificationOverField (Over.mkIdTerminal.from T))).obj
          (condensedVerdierDualizingComplex ell k
            (Fact.out : ringChar k ≠ ell) hk Λ.X hΛ T)) ≅
      (rightDerivedLowerShriekOfCompactification Λ'.X
        (compactificationOverField (Over.mkIdTerminal.from T))).obj
        ((scalarSixChange a T.left).obj
          (condensedVerdierDualizingComplex ell k
            (Fact.out : ringChar k ≠ ell) hk Λ.X hΛ T))) :
    (scalarSixChange a T.left).obj
        (condensedVerdierDualizingComplex ell k
          (Fact.out : ringChar k ≠ ell) hk Λ.X hΛ T) ⟶
      condensedVerdierDualizingComplex ell k
        (Fact.out : ringChar k ≠ ell) hk Λ'.X hΛ' T :=
  ((ctfExceptionalAdjunction Λ'.X ell k
    (WeilConjectures.exceptionalCurrentFieldCD ell k hk) (Over.mkIdTerminal.from T) hΛ'
      ).homEquiv ⟨_, hW⟩
        ⟨𝟙_ _, condensedCoefficientUnit_mem Λ'.X (Spec (.of k))⟩
    (ObjectProperty.homMk (q.inv ≫
      (scalarSixChange a (Spec (.of k))).map
        ((ctfExceptionalAdjunction Λ.X ell k
          (WeilConjectures.exceptionalCurrentFieldCD ell k hk) (Over.mkIdTerminal.from T) hΛ
          ).counit.app ⟨𝟙_ _, condensedCoefficientUnit_mem Λ.X (Spec (.of k))⟩).hom ≫
      (Functor.Monoidal.εIso (scalarSixChange a (Spec (.of k)))).inv))).hom

end CurrentVerdierExchange
end AlgebraicGeometry.ProEtale.CondensedRing
