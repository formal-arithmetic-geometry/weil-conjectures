/-! # Composite normalization of finite compact-support reductions -/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale.CondensedRing.FiniteSupportReduction

variable (ell : ℕ) [Fact ell.Prime] (E : PadicAlgCl.FiniteIntermediateField ell)
  (π : PadicAlgCl.integers ell E)

/-- The output transitions obey the prescribed composite-restriction cocycle.
Source: latest blueprint lem-coef-integral-compact-support.proof.md, final paragraph,
compatibility with the finite reductions by scalar-six coefficient composition.
(blueprint: lem-coef-normalized-cocycle-aux).

Proof: Transpose both displayed routes under the composite of the two derived
extension/restriction adjunctions. Naturality moves the first compact-support
comparison through scalar extension and the second input beta through the second
compact-support comparison. Apply the compact-support coefficient cocycle for this
same compactification. The scalar associator pentagon then identifies the successive
input beta maps with the direct beta, using coefficientLaws for the actual quotient
composition and integral reduction. The definition of scalarSixTower as the unique
left-adjoint comparison identifies the composite Hom equivalence with the direct
one transported by restrictComp. Injectivity of that equivalence gives the equation.
No inverse quotient map or flatness is used. Repeated indices are permitted, including
r=m=n=0; the same pentagon and quotient equalities apply. -/
theorem normalizedCocycleAux (D : WeilConjectures.FiniteFieldDatum.{u})
    (_hell : ell ≠ D.p)
    (_hπ : Ideal.span {π} = IsLocalRing.maximalIdeal (PadicAlgCl.integers ell E))
    {X Y : Over (Spec (.of D.k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsSeparated Y.hom]
    (f : X ⟶ Y) (c : Compactification f.left)
    (K : ConstantModelConstructibleFiniteTor (latticeIntegralRing.{u} ell E).X X.left) :
    ∀ (r m n : ℕ) (hrm : m ≤ r) (hmn : n ≤ m),
      tau ell E π c K.obj (hmn.trans hrm) ≫
          (restrictComp ell E π Y.left hrm hmn).hom.app
            (supportLevel ell E π c K.obj n) =
        tau ell E π c K.obj hrm ≫
          (restrict ell E π Y.left hrm).map (tau ell E π c K.obj hmn) := by
  sorry

end AlgebraicGeometry.ProEtale.CondensedRing.FiniteSupportReduction
