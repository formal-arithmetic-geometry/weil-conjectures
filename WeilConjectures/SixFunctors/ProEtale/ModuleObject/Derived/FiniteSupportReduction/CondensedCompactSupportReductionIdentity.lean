/-! # Identity normalization of finite compact-support reductions -/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale.CondensedRing.FiniteSupportReduction

variable (ell : ℕ) [Fact ell.Prime] (E : PadicAlgCl.FiniteIntermediateField ell)
  (π : PadicAlgCl.integers ell E)

/-- The identity-index output transition has the prescribed unit normalization.
Source: latest blueprint lem-coef-integral-compact-support.proof.md, final paragraph,
scalar-six compatibility with coefficient composition and identities.
(blueprint: lem-coef-normalized-identity-aux).

Proof: Use coefficientLaws to identify the identity-index quotient with the identity
coefficient map. The right-unit law for the scalar tower identifies beta with the
canonical scalar unitor at K_n. The identity compact-support comparison followed by
compact support of this unitor is the scalar unitor at M_n: expand the proper/open
comparison, apply the identity direct-image mate law, and the open scalar unit law.
Finally the defining extension/restriction adjunction sends this scalar unitor to
identity after the explicit restriction unitor. This is the triangle identity for the
adjunction transported by coefficientMap_id, Mod.comapId, and mapDerivedCategoryIdIso.
The equality is valid for n=0 (the quotient by pi), zero K, and empty schemes. -/
theorem normalizedIdentityAux (D : WeilConjectures.FiniteFieldDatum.{u})
    (_hell : ell ≠ D.p)
    (_hπ : Ideal.span {π} = IsLocalRing.maximalIdeal (PadicAlgCl.integers ell E))
    {X Y : Over (Spec (.of D.k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsSeparated Y.hom]
    (f : X ⟶ Y) (c : Compactification f.left)
    (K : ConstantModelConstructibleFiniteTor (latticeIntegralRing.{u} ell E).X X.left) :
    ∀ n : ℕ, tau ell E π c K.obj (le_refl n) ≫
      (restrictUnit ell E π Y.left n).hom.app (supportLevel ell E π c K.obj n) = 𝟙 _ := by
  sorry

end AlgebraicGeometry.ProEtale.CondensedRing.FiniteSupportReduction
