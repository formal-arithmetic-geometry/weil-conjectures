section
open AlgebraicGeometry.ProEtale.QuotientChange

/-- Identity normalization for the same condensed direct-image mate.
Source: fix-prop-coherence, the identity clause of the exchange coherence (assembly step 1,
fix-lem-exchanges), written on `scalarAmbientExchange` and `exchangeScalarIdentity` of
`Sheaf.SecSmoothPurity.CondensedScalarExchangeCoherence`; that module states only the pasting
laws (blueprint: fix-prop-coherence). -/
def directExchangeIdentity : Prop :=
  ∀ (R : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj R] [IsCommMonObj R] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (sq : ChosenCartesianSquare (𝟙 X) f f (𝟙 Y)),
    scalarAmbientExchange R sq =
      Functor.whiskerLeft (F R f) (exchangeScalarIdentity R Y).hom ≫
        (Functor.rightUnitor (F R f)).hom ≫ (Functor.leftUnitor (F R f)).inv ≫
        Functor.whiskerRight (exchangeScalarIdentity R X).inv (F R f)

end

