/-- The canonically normalized geometric units, composition pentagon, compactification and
arbitrary-base-change coherence.
Source: fix-prop-coherence, the clause supplied by `coherentData_exists`
in `Sheaf.SixFunctors.CondensedCompactSupportCompositionData` (blueprint: fix-prop-coherence). -/
def geometricOperations : Prop :=
  ∀ (ℓ p : ℕ) [Fact ℓ.Prime] [Fact p.Prime]
    (_hpℓ : p ≠ ℓ) (k : Type u) [Field k] [CharP k p] (_hk : Finite k ∨ IsAlgClosed k)
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] (_hΛ : IsLocalizingAdmissibleCoefficient ℓ Λ),
    Nonempty (CoherentData Λ k)

end

