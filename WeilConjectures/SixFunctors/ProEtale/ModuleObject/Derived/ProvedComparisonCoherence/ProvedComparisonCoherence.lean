/-- Evaluation-defined general finite-Tor internal Hom on both finite coefficient sites, including
identity, composition and arbitrary finite ring maps.
Source: fix-prop-coherence, the clause supplied by `thmCoefFiniteHom`
in `Sheaf.SixFunctors.CoefFiniteHom` (blueprint: fix-prop-coherence). -/
def finiteHom : Prop :=
  ∀ (k : Type u) [Field k] (_hbase : Finite k ∨ IsAlgClosed k)
    (ell : ℕ) [Fact ell.Prime] (_hell : (ell : k) ≠ 0)
    {A B C : Type (u + 1)} [CommRing A] [CommRing B] [CommRing C]
    [Finite A] [Finite B] [Finite C]
    (φ : A →+* B) (ψ : B →+* C)
    (_hA : ∃ n : ℕ, (ell ^ n : A) = 0)
    (_hB : ∃ n : ℕ, (ell ^ n : B) = 0)
    (_hC : ∃ n : ℕ, (ell ^ n : C) = 0)
    (X : Scheme.{u}) [X.Over (Spec (.of k))]
    [IsSeparated (X ↘ Spec (.of k))]
    [LocallyOfFiniteType (X ↘ Spec (.of k))]
    [QuasiCompact (X ↘ Spec (.of k))],
    Nonempty (FiniteCoefficientHomLaws X φ ψ)

end

section
open AlgebraicGeometry.ProEtale.CondensedIntegralHom

/-- Arbitrary integral internal Hom, evaluation and every transpose; there is no site-perfect
hypothesis.
Source: fix-prop-coherence, the clause supplied by `integralHomReduction`
in `Sheaf.Paper.CondensedIntegralHomReduction` (blueprint: fix-prop-coherence). -/
def integralHom : Prop :=
  ∀ (l : ℕ) [Fact l.Prime] (E : Type u) [Field E]
    [Algebra (Padic l) E] [FiniteDimensional (Padic l) E] (X : Scheme.{u})
    (K L : DerivedCategory (AdicCompletion.Modules l E X)),
    (IsDerivedComplete l E X L → IsDerivedComplete l E X
      (((CondensedRing.derivedHom (DerivedNakayama.integerRing l E) X).obj (op K)).obj L)) ∧
    ∀ n : ℕ, IsIso (comparison l E X n K L) ∧
      ((AdicCompletion.derivedReduction l E X n).obj K ◁ comparison l E X n K L) ≫
        (CondensedRing.derivedTensorHomAdjunction (DerivedNakayama.quotientRing l E (n + 1))
          ((AdicCompletion.derivedReduction l E X n).obj K)).counit.app
            ((AdicCompletion.derivedReduction l E X n).obj L) =
        reductionEvaluation l E X n K L ∧
      ∀ (T : DerivedCategory (AdicCompletion.Modules l E X))
        (f : T ⟶
          (((CondensedRing.derivedHom (DerivedNakayama.integerRing l E) X).obj (op K)).obj L)),
        (CondensedRing.derivedTensorHomAdjunction (DerivedNakayama.quotientRing l E (n + 1))
          ((AdicCompletion.derivedReduction l E X n).obj K)).homEquiv _ _
            ((reductionTensorIso l E X n K T).inv ≫
              (AdicCompletion.derivedReduction l E X n).map
                (((CondensedRing.derivedTensorHomAdjunction
                  (DerivedNakayama.integerRing l E) K).homEquiv T L).symm f)) =
          (AdicCompletion.derivedReduction l E X n).map f ≫ comparison l E X n K L

end

