/-- Horizontal and vertical mate pasting for the specified condensed direct-image exchange.
Source: fix-prop-coherence, the clause supplied by `condensedScalarExchangePasting`
in `Sheaf.SecSmoothPurity.CondensedScalarExchangeCoherence` (blueprint: fix-prop-coherence). -/
def directExchangePasting : Prop :=
  ∀ (R : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj R] [IsCommMonObj R],
    (∀ {X₂ X₁ X₀ Y₂ Y₁ Y₀ : Scheme.{u}}
      {u₁ : X₁ ⟶ X₀} {u₂ : X₂ ⟶ X₁}
      {v₁ : Y₁ ⟶ Y₀} {v₂ : Y₂ ⟶ Y₁}
      {f₀ : X₀ ⟶ Y₀} {f₁ : X₁ ⟶ Y₁} {f₂ : X₂ ⟶ Y₂}
      (s₁ : ChosenCartesianSquare u₁ f₁ f₀ v₁)
      (s₂ : ChosenCartesianSquare u₂ f₂ f₁ v₂),
      mateEquiv (adj R f₀) (adj R f₂)
          (TwoSquare.hComp
            (TwoSquare.mk _ _ _ _ (scalarPullbackSquare R s₁).hom)
            (TwoSquare.mk _ _ _ _ (scalarPullbackSquare R s₂).hom)) =
        TwoSquare.vComp
          (TwoSquare.mk _ _ _ _ (scalarAmbientExchange R s₁))
          (TwoSquare.mk _ _ _ _ (scalarAmbientExchange R s₂))) ∧
    (∀ {X' X Y' Y Z' Z : Scheme.{u}}
      {u : X' ⟶ X} {v : Y' ⟶ Y} {w : Z' ⟶ Z}
      {f : X ⟶ Y} {f' : X' ⟶ Y'} {g : Y ⟶ Z} {g' : Y' ⟶ Z'}
      (s₁ : ChosenCartesianSquare u f' f v)
      (s₂ : ChosenCartesianSquare v g' g w),
      mateEquiv ((adj R g).comp (adj R f)) ((adj R g').comp (adj R f'))
          (TwoSquare.vComp
            (TwoSquare.mk _ _ _ _ (scalarPullbackSquare R s₂).hom)
            (TwoSquare.mk _ _ _ _ (scalarPullbackSquare R s₁).hom)) =
        TwoSquare.hComp
          (TwoSquare.mk _ _ _ _ (scalarAmbientExchange R s₁))
          (TwoSquare.mk _ _ _ _ (scalarAmbientExchange R s₂)))

end

