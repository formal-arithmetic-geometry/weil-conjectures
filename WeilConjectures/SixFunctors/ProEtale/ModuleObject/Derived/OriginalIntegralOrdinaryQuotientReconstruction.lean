/-! # Integral reconstruction by ordinary positive quotients

Source: Hemo--Richarz--Scholbach, Propositions 5.1 and 7.6 and Theorem 7.7;
Bhatt--Scholze, Section 6.1.
(blueprint: lem-sp-original-integral-ordinary-quotient-reconstruction)
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits DerivedCategory
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale.CondensedRing

open AlgebraicGeometry Scheme

/-- A constructible integral module in degree zero is generated by its ordinary
positive quotients using triangles and countable products.

Source: Hemo--Richarz--Scholbach, Propositions 5.1 and 7.6 and Theorem 7.7;
Bhatt--Scholze, Section 6.1, repleteness.
(blueprint: lem-sp-original-integral-ordinary-quotient-reconstruction).

Proof: on a pro-etale presentation cover of each constructible stratum evaluate the
finite presentation on w-contractible affine tests. Its matrix has continuous entries
on the extremally disconnected component space. The integral coefficient ring is compact;
compact solution spaces and projectivity of that component space give compatible continuous
lifts of the finite quotient solutions. Thus the presented module is separated and is the
limit of its ordinary quotients by positive powers of ell. The ell powers are cofinal with
uniformizer powers. Exact open/closed localization reassembles the finite stratification;
constructibility of its immersions gives the needed limit preservation. The quotient
transitions are epimorphic. Repleteness makes this tower acyclic for inverse limit, so its
Roos sequence 0 -> M -> product Q_n -> product Q_n -> 0 is exact. Apply the single-complex
functor; exact countable products identify its product terms with the products of Q_n[0].
The resulting distinguished triangle puts M[0] in every replete triangulated property closed
under countable products containing all Q_n[0]. Zero presentations, torsion modules and
empty strata satisfy the same sequence. No assertion about derived-reduction cohomology
or finite constant local models is used. -/
theorem originalIntegralOrdinaryQuotientReconstruction
    (ell : ℕ) [Fact ell.Prime]
    (E : IntermediateField ℚ_[ell] (PadicAlgCl ell))
    [FiniteDimensional ℚ_[ell] E]
    (X : Scheme.{u})
    (M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.padicIntegersRingObj ell E) X))
    (hM : IsConstructibleModuleObject
      (condensedRingObj (Profinite.padicIntegersRingObj ell E) X) M)
    (P : ObjectProperty (DerivedCategory
      (Mod (Sheaf (ProEt.topology X) Ab.{u + 1})
        (condensedRingObj (Profinite.padicIntegersRingObj ell E) X))))
    [P.IsClosedUnderIsomorphisms] [P.IsTriangulated]
    [P.IsClosedUnderLimitsOfShape (Discrete ℕ)]
    (hquot : ∀ n : ℕ, P ((DerivedCategory.singleFunctor _ 0).obj
      (cokernel (ell ^ (n + 1) • 𝟙 M)))) :
    P ((DerivedCategory.singleFunctor _ 0).obj M) := by
  have h := originalIntegralOrdinaryQuotientRoos ell E X M hM
  let R := Profinite.padicIntegersRingObj ell E
  let C := Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (condensedRingObj R X)
  let e := InternalAbelianSheafModule.sectionModuleEquivalence.{u + 1, u + 1, u}
    (ProEt.topology X) (condensedRingObj R X)
  let B : Sheaf (ProEt.topology X) RingCat.{u + 1} :=
    (sheafCompose (ProEt.topology X)
      (forget₂ CommRingCat.{u + 1} RingCat.{u + 1})).obj
        (InternalAbelianSheafModule.sectionRingSheaf.{u + 1, u + 1, u}
          (ProEt.topology X) (condensedRingObj R X))
  have : HasExactLimitsOfShape (Discrete ℕ) (SheafOfModules.{u + 1} B) :=
    Scheme.ProEt.products_exact.{u, u, 0} X B ℕ
  have : HasExactLimitsOfShape (Discrete ℕ) C :=
    HasExactLimitsOfShape.of_codomain_equivalence (Discrete ℕ) e.symm
  have : PreservesLimitsOfShape (Discrete ℕ)
      ((CochainComplex.singleFunctors C).functor 0) :=
    inferInstanceAs (PreservesLimitsOfShape _ (HomologicalComplex.single C _ 0))
  have : PreservesLimitsOfShape (Discrete ℕ) (DerivedCategory.singleFunctor C 0) :=
    preservesLimitsOfShape_of_natIso
      (F := (CochainComplex.singleFunctors C).functor 0 ⋙ DerivedCategory.Q)
      ((SingleFunctors.evaluation _ _ 0).mapIso
        (singleFunctorsPostcompQIso C)).symm
  have hp : P ((DerivedCategory.singleFunctor C 0).obj
      (∏ᶜ (fun n : ℕ ↦ cokernel (ell ^ (n + 1) • 𝟙 M)))) := by
    exact P.prop_of_isLimit (isLimitOfPreserves (DerivedCategory.singleFunctor C 0)
      (limit.isLimit (Discrete.functor (fun n : ℕ ↦ cokernel (ell ^ (n + 1) • 𝟙 M)))))
      (fun j ↦ hquot j.as)
  exact P.ext_of_isTriangulatedClosed₁ h.singleTriangle h.singleTriangle_distinguished hp hp

end AlgebraicGeometry.ProEtale.CondensedRing
