/-! # Native condensed integral compact-support projection laws

Source: literature/blueprint/latest/blueprint/sec-six-functors/sk-rem-sf-pf-done/
fix-prop-projection-formula.proof.md, integral reconstruction and final coherence sentences
(blueprint: lem-sf-projection-integral-stage-laws).

All maps below are existing ordinary module-derived maps. The auxiliary predicates spell
out the equations, including the normalized condensed compact-support compositor. Proofs
of membership in its localizing domain are conclusions, never assumptions on the first input.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
set_option Elab.async false

universe u
open CategoryTheory CategoryTheory.Limits MonoidalCategory
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor
open scoped AlgebraicGeometry.ProEtale.CondensedRing.CachedModInstances

namespace AlgebraicGeometry.ProEtale.CondensedRing.NativeIntegralProjection

open CompactificationReindexing

/-- The native quotient O_E/(pi^n), with its quotient topology, hence the usual finite
(discrete) topology when pi is a uniformizer and n is positive. No completion is used.
Source: the integral finite-reduction clause of fix-prop-projection-formula
(blueprint: lem-sf-projection-integral-stage-laws). -/
abbrev quotientRing (ell : ℕ) [Fact ell.Prime]
    (E : PadicAlgCl.FiniteIntermediateField ell) (pi : PadicAlgCl.integers ell E) (n : ℕ) :
    ScalarSixRing.{u} :=
  letI := PadicAlgCl.normedFieldOfAlgebra ell E
  scalarSixTopologicalRing (PadicAlgCl.integers ell E ⧸ Ideal.span {pi} ^ n)

/-- Postcomposition by the quotient ring homomorphism on every profinite test object.
Source: the integral finite-reduction clause of fix-prop-projection-formula
(blueprint: lem-sf-projection-integral-stage-laws). -/
def reduction (ell : ℕ) [Fact ell.Prime]
    (E : PadicAlgCl.FiniteIntermediateField ell) (pi : PadicAlgCl.integers ell E) (n : ℕ) :
    (⟨Profinite.padicIntegersRingObj ell E⟩ : ScalarSixRing.{u}) ⟶ quotientRing ell E pi n := by
  letI := PadicAlgCl.normedFieldOfAlgebra ell E
  exact scalarSixContinuousMap (Ideal.Quotient.mk (Ideal.span {pi} ^ n))
    (QuotientRing.isOpenQuotientMap_mk _).continuous

/-- The identity-open compactification identifies its support functor with direct image.
Source: fix-prop-projection-formula, proper-coincidence clause
(blueprint: lem-sf-projection-integral-stage-laws). -/
def properIdentity (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] :
    F Λ (Compactification.ofIsProper f) ≅ R Λ f :=
  Functor.isoWhiskerRight (derivedOpenImmersionLowerShriekId Λ X) (R Λ f) ≪≫
    Functor.leftUnitor (R Λ f)

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
  [MonObj Λ] [IsCommMonObj Λ] (k : Type u) [Field k]

end AlgebraicGeometry.ProEtale.CondensedRing.NativeIntegralProjection
