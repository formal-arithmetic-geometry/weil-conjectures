/-! # Canonical finite-reduction comparisons

Source: current blueprint thm-pur-finite-reduction-of-purity, proof Step 2.
(blueprint: def-pur-finite-reduction-comparisons).
Levels m,n mean the positive exponents m+1,n+1. All categories are native modules
on the small pro-etale site over the pulled-back condensed quotient coefficient.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Functor CategoryTheory.Obj
namespace AlgebraicGeometry.ProEtale.CondensedRing.FinitePurityReduction

variable (ell : ℕ) [Fact ell.Prime]
variable (E : Type u) [Field E] [Algebra (Padic ell) E]
  [FiniteDimensional (Padic ell) E]

/-- The unique comparison on Lf* K(d)[2d], fixed simultaneously in all compatible
primitive-root charts. Source: Step 2
(blueprint: def-pur-finite-reduction-comparisons). -/
def sourceComparison (m n : ℕ) (hmn : m ≤ n)
    (D : WeilConjectures.FiniteFieldDatum.{u}) (hEll : ell ≠ D.p)
    {X Y : Over (Spec (.of D.k))} (f : X ⟶ Y) (d : ℕ)
    (K : DerivedCategory (ModuleRingedComparison.internalModules
      (coefficient ell E n).X Y.left)) :=
  (sourceComparison_existsUnique ell E m n hmn D hEll f d K).exists.choose

/-- The coefficient-unit map is the scalar adjunct of the degree-zero map
of regular modules. Thus its transpose is fixed on all ring sections.
Source: Step 2, scalar unit (blueprint: def-pur-finite-reduction-comparisons). -/
def unitMap (m n : ℕ) (hmn : m ≤ n) (X : Scheme.{u}) :=
  FinitePositiveReduction.derivedMap ell E X m n hmn 0 0

end AlgebraicGeometry.ProEtale.CondensedRing.FinitePurityReduction
