/-! # Finite scalar sections of constructible modules on a geometric point

Source: Bhatt--Scholze, Example 4.1.10, and the point finite-presentation argument in
latest blueprint, smooth-proper relative purity, Step 3
(blueprint: lem-zl-constructible-point-scalar-sections-finite).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

-- Use the site-size specialization of the scalar-section construction.
attribute [-instance] WeilConjectures.integralOperationsSiteSmall
attribute [local instance 10000] CategoryTheory.GrothendieckTopology.hasSheafify_proEtTopology

universe u v w
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

-- Pullback to a geometric point is fully faithful, so the canonical scalar map is onto.
private theorem scalarMap_surjective
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] (k : Type u) [Field k] [IsAlgClosed k] :
    Function.Surjective (CohomologyTransport.scalarMap Λ (Spec (.of k))) := by
  let := Functor.additive_of_preserves_binary_products (upperStarFromPoint (Spec (.of k)))
  exact (InternalAbelianSheafModule.sectionGlobalEval_bijective
    (Scheme.ProEt.topology (Spec (.of k))) (condensedRingObj Λ (Spec (.of k)))
    (Scheme.ProEt.mk (𝟙 (Spec (.of k))))
    (MorphismProperty.Over.mkIdTerminal @AlgebraicGeometry.WeaklyEtale (Spec (.of k)))).2.comp
      ((InternalAbelianSheafModule.globalMapFunctor_bijective
        (upperStarFromPoint (Spec (.of k))) (Functor.FullyFaithful.ofFullyFaithful _) Λ).2.comp
        (InternalAbelianSheafModule.sectionGlobalEquiv (coherentTopology Profinite.{u}) Λ
          (⊤_ Profinite.{u}) terminalIsTerminal).symm.surjective)

-- The evaluated regular module is generated by the image of 1.
private theorem regular_sections_finite
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] {R : Type v} [CommRing R]
    (rho : R →+* condensedScalarRing Λ) (hrho : Function.Surjective rho)
    (k : Type u) [Field k] [IsAlgClosed k] :
    Module.Finite R (((CohomologyTransport.sections Λ (Spec (.of k))) ⋙
      ModuleCat.restrictScalars.{u + 1} rho).obj
      (Mod.regular (condensedRingObj Λ (Spec (.of k))))) := by
  let φ := (CohomologyTransport.scalarMap Λ (Spec (.of k))).comp rho
  let f : R →ₗ[R] (((CohomologyTransport.sections Λ (Spec (.of k))) ⋙
      ModuleCat.restrictScalars.{u + 1} rho).obj
      (Mod.regular (condensedRingObj Λ (Spec (.of k))))) :=
    { toFun := fun x ↦ φ x
      map_add' := φ.map_add
      map_smul' := fun r s ↦ φ.map_mul r s }
  exact Module.Finite.of_surjective f ((scalarMap_surjective Λ k).comp hrho)

-- Exact evaluation turns finite free presentations into finite module presentations.
private theorem finite_of_presentation
    {C : Type w} [Category C] [MonoidalCategory C] [Abelian C]
    [MonoidalPreadditive C] (O : C) [MonObj O]
    [PreservesFiniteColimits (MonoidalCategory.tensorLeft O)]
    {R : Type v} [CommRing R] (F : Mod C O ⥤ ModuleCat.{u} R)
    [F.Additive] [PreservesFiniteColimits F]
    [Module.Finite R (F.obj (Mod.regular O))]
    (M : Mod C O) (hM : Mod.IsFinitelyPresented O M) : Module.Finite R (F.obj M) := by
  obtain ⟨n, m, f, ⟨e⟩⟩ := hM
  let b := F.mapBiproduct (fun _ : Fin n ↦ Mod.regular O) ≪≫
    ModuleCat.biproductIsoPi (fun _ : Fin n ↦ F.obj (Mod.regular O))
  have : Module.Finite R (F.obj (Mod.finiteFree O n)) :=
    Module.Finite.equiv b.toLinearEquiv.symm
  have : Module.Finite R (cokernel (F.map f) : ModuleCat R) :=
    Module.Finite.equiv (ModuleCat.cokernelIsoRangeQuotient (F.map f)).toLinearEquiv.symm
  exact Module.Finite.equiv (F.mapIso e ≪≫ PreservesCokernel.iso F f).toLinearEquiv.symm

/-- Scalar sections of a constructible module on an algebraically closed point are finite.
Source: Bhatt--Scholze, Example 4.1.10 and constructible-module local presentations;
latest blueprint, smooth-proper purity proof, the paragraph on constructible cohomology
on a point (blueprint: lem-zl-constructible-point-scalar-sections-finite).

Proof: pull the constructible module back along the identity geometric point. Every
pro-etale cover of that point splits, so the existing stalk finite-presentation theorem
gives a global finite free presentation. The identity pullback comparison transports
this presentation to the original module. Scalar sections are exact at this point.
The scalar map from Lambda(*) to the terminal section ring is surjective: express it
as inverse terminal evaluation, the map on tensor-unit global sections of the fully
faithful monoidal point pullback, and terminal evaluation. Restriction along the given
surjective rho makes the evaluated regular module cyclic. Applying sections to the
finite presentation therefore expresses the evaluated module as a cokernel between
finite modules. Finite biproducts and quotients of finite modules are finite, and the
presentation isomorphism transports that conclusion to the original module. This also
covers zero coefficient rings, the zero module, and rank-zero presentations. -/
theorem constructiblePointScalarSections_finite
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] {R : Type v} [CommRing R]
    (rho : R →+* condensedScalarRing Λ) (hrho : Function.Surjective rho)
    (k : Type u) [Field k] [IsAlgClosed k]
    (M : Mod (Sheaf (Scheme.ProEt.topology (Spec (.of k))) Ab.{u + 1})
      (condensedRingObj Λ (Spec (.of k))))
    (hM : IsConstructibleModuleObject (condensedRingObj Λ (Spec (.of k))) M) :
    Module.Finite R (((CohomologyTransport.sections Λ (Spec (.of k))) ⋙
      ModuleCat.restrictScalars.{u + 1} rho).obj M) := by
  have hfp := isFinitelyPresented_upperStar_of_isConstructibleModuleObject
    Λ (Field.toIsField k) IsField.isSepClosed_toField hM (𝟙 _)
  have hfp' := hfp.of_iso ((upperStarId Λ _).app M)
  let F := CohomologyTransport.sections Λ (Spec (.of k)) ⋙
    ModuleCat.restrictScalars.{u + 1} rho
  have : Module.Finite R (F.obj (Mod.regular (condensedRingObj Λ (Spec (.of k))))) :=
    regular_sections_finite Λ rho hrho k
  exact finite_of_presentation _ F M hfp'

end AlgebraicGeometry.ProEtale.CondensedRing
