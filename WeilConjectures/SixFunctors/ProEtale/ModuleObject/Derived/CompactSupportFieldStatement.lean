/-! # Projection formula over finite coefficient fields and their algebraic closure

Source: `literature/blueprint/latest/blueprint/part-duality-trace-formula/sec-poincare-duality/`
`sec-perfect-complexes-on-the-point-and-two-exchange-formulas/sk-thm-sf-tensor-hom/`
`sk-thm-sf-pf-proetale/thm-sf-pf-field.md`
(blueprint: thm-sf-pf-field).

The statement uses the canonical projection transformation from `def-sf-pf`; scalar
compatibility is expressed by the canonical tensor, pullback and compact-support
comparison maps for the three coefficient morphisms in the statement.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped CategoryTheory.Obj CategoryTheory.Functor
open scoped AlgebraicGeometry.ProEtale.CondensedRing.CachedModInstances

namespace AlgebraicGeometry.ProEtale.CondensedRing

/-- The isomorphism clause of the field projection formula.

Source: the current blueprint, `thm-sf-pf-field`, statement (blueprint: thm-sf-pf-field).
The proof first transports the canonical projection map through localization and scalar
extension, then uses integral-model generation for the finite field case and finite-stage
descent for the algebraic closure case.
-/
def projectionFormulaFieldIsoClause (Λ : ScalarSixRing.{u})
    {X Y : Scheme.{u}} {f : X ⟶ Y} (c : Compactification f) : Prop :=
  ∀ (K : BoundedConstructible (condensedRingObj Λ.X X))
    (L : BoundedConstructible (condensedRingObj Λ.X Y)),
    boundedConstructible (condensedRingObj Λ.X Y)
        (((rightDerivedLowerShriekOfCompactification Λ.X c).obj K.obj) ⊗ L.obj) ∧
      boundedConstructible (condensedRingObj Λ.X Y)
        ((rightDerivedLowerShriekOfCompactification Λ.X c).obj
          (K.obj ⊗ (upperStar Λ.X f).leftDerivedFunctor.obj L.obj)) ∧
      IsIso (exceptionalProjectionMorphismOfCompactification Λ.X c K.obj L.obj)

set_option maxHeartbeats 800000 in
-- Elaborating the five dependent coefficient clauses needs a larger local budget.
end AlgebraicGeometry.ProEtale.CondensedRing
