/-! # The eight-clause six-operations package

Source: literature/blueprint/latest/blueprint/part-duality-trace-formula/sec-poincare-duality/
sec-perfect-complexes-on-the-point-and-two-exchange-formulas/sk-def-ops/sk-thm-sf-package/
_section.md and sk-thm-sf-package.proof.md (blueprint: sk-thm-sf-package).

The package exposes the individual assertions, including the compatibility equations.
The setting is that of def-sf-setting: a field k, finite or algebraically closed, with
ringChar k ≠ ell; no finite-field or Frobenius datum. Clause (6) is stated on the current
records: the condensed package biduality and Verdier exchange, `sfCondensedDualPerfect`
(sk-thm-sf-dual-perfect), and the native global-duality, Poincare-pairing and
epsilon-composition fields. Fields whose recorded objects exist only for prime
characteristic (smooth purity, the dual-perfect orientation, the canonical compactification
comparison) keep `[Fact (ringChar k).Prime]` as an explicit field hypothesis; every other
component is restated over k. clause5_smooth_product is stated over SepFinType k at a finite
ell-primary coefficient (A_{E,n} among them) with the general-k data of
def-sf-smooth-kunneth-compatibility-data (Sheaf.Paper.SixOperationsPackageSmoothKunneth).
-/
@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor
namespace AlgebraicGeometry.ProEtale.CondensedRing

/-- The setting hypothesis gives finite ell-cohomological dimension of k.
Source: def-sf-setting (blueprint: def-sf-setting). -/
theorem sixOperationsBaseFieldFiniteCD (ell : ℕ) [Fact ell.Prime] (k : Type u) [Field k]
    (hk : Finite k ∨ IsAlgClosed k) : BaseFieldFiniteCD ell k :=
  hk.elim (fun h ↦ haveI := h; BaseFieldFiniteCD.of_finite ell k)
    (fun h ↦ haveI := h; BaseFieldFiniteCD.of_isAlgClosed ell k)

/-- ell is invertible in k: the setting hypothesis ringChar k ≠ ell, ell prime.
Source: def-sf-setting (blueprint: def-sf-setting). -/
theorem sixOperationsEllUnit (ell : ℕ) [Fact ell.Prime] (k : Type u) [Field k]
    [Fact (ringChar k ≠ ell)] : IsUnit (ell : k) := by
  apply isUnit_iff_ne_zero.mpr
  intro h
  have hdvd := (CharP.cast_eq_zero_iff k (ringChar k) ell).mp h
  rcases (Nat.dvd_prime (Fact.out : ell.Prime)).mp hdvd with he | he
  · have h1 : ((1 : ℕ) : k) = 0 :=
      (CharP.cast_eq_zero_iff k (ringChar k) 1).mpr (by simp [he])
    exact (one_ne_zero (α := k)) (by simpa using h1)
  · exact (Fact.out : ringChar k ≠ ell) he

section SixOpsClauses
open CategoryTheory.Pretriangulated CategoryTheory.Pretriangulated.Opposite Opposite

/-- Statement of the field `opening_preservation` of `SixOperationsPackage`. -/
def SixOpsOpeningPreservation (ell : ℕ) [Fact ell.Prime] (k : Type u) [Field k]
    [Fact (ringChar k ≠ ell)] : Prop :=
    ∀ (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ], IsLocalizingAdmissibleCoefficient ell Λ →
    ∀ {X Y : Scheme.{u}}
      [X.Over (Spec (.of k))] [Y.Over (Spec (.of k))]
      [LocallyOfFiniteType (X ↘ Spec (.of k))]
      [QuasiCompact (X ↘ Spec (.of k))] [IsSeparated (X ↘ Spec (.of k))]
      [LocallyOfFiniteType (Y ↘ Spec (.of k))]
      [QuasiCompact (Y ↘ Spec (.of k))] [IsSeparated (Y ↘ Spec (.of k))]
      (f : X ⟶ Y) [f.IsOver (Spec (.of k))]
      [LocallyOfFiniteType f] [QuasiCompact f] [IsSeparated f],
    (∀ K : _root_.DerivedCategory
        (Mod (Sheaf (Scheme.ProEt.topology Y) Ab.{u + 1}) (condensedRingObj Λ Y)),
      (constantModelBoundedConstructible Λ Y K ∧
          _root_.DerivedCategory.finiteTorAmplitude _ K) →
        constantModelBoundedConstructible Λ X ((L((f)^*⟦Λ⟧)).obj K) ∧
          _root_.DerivedCategory.finiteTorAmplitude _ ((L((f)^*⟦Λ⟧)).obj K)) ∧
    (∀ K M : _root_.DerivedCategory
        (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)),
      (constantModelBoundedConstructible Λ X K ∧
          _root_.DerivedCategory.finiteTorAmplitude _ K) →
      (constantModelBoundedConstructible Λ X M ∧
          _root_.DerivedCategory.finiteTorAmplitude _ M) →
        constantModelBoundedConstructible Λ X
            (((-⊗ᴸ-(X)⟦Λ⟧).obj K).obj M) ∧
          _root_.DerivedCategory.finiteTorAmplitude _ (((-⊗ᴸ-(X)⟦Λ⟧).obj K).obj M)) ∧
    (∀ {S Sbar : Scheme.{u}}
        [S.Over (Spec (.of k))] [Sbar.Over (Spec (.of k))]
        [LocallyOfFiniteType (S ↘ Spec (.of k))]
        [QuasiCompact (S ↘ Spec (.of k))] [IsSeparated (S ↘ Spec (.of k))]
        [LocallyOfFiniteType (Sbar ↘ Spec (.of k))]
        [QuasiCompact (Sbar ↘ Spec (.of k))] [IsSeparated (Sbar ↘ Spec (.of k))]
        (a : S ⟶ X) (u : S ⟶ Sbar) (i : Sbar ⟶ X)
        (ha : a = u ≫ i) [a.IsOver (Spec (.of k))]
        [u.IsOver (Spec (.of k))] [i.IsOver (Spec (.of k))]
        [IsOpenImmersion u] [IsClosedImmersion i]
        (K : _root_.DerivedCategory
          (Mod (Sheaf (Scheme.ProEt.topology S) Ab.{u + 1}) (condensedRingObj Λ S))),
      (constantModelBoundedConstructible Λ S K ∧
          _root_.DerivedCategory.finiteTorAmplitude _ K) →
        constantModelBoundedConstructible Λ X
            ((D((u)_!open⟦Λ⟧) ⋙ R((i)_*⟦Λ⟧)).obj K) ∧
          _root_.DerivedCategory.finiteTorAmplitude _
            ((D((u)_!open⟦Λ⟧) ⋙ R((i)_*⟦Λ⟧)).obj K)) ∧
    (∀ K : _root_.DerivedCategory
        (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)),
      (constantModelBoundedConstructible Λ X K ∧
          _root_.DerivedCategory.finiteTorAmplitude _ K) →
        constantModelBoundedConstructible Λ Y
            ((R((f)_*⟦Λ⟧)).obj K) ∧
          _root_.DerivedCategory.finiteTorAmplitude _ ((R((f)_*⟦Λ⟧)).obj K)) ∧
    (∀ K : _root_.DerivedCategory
        (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)),
      (constantModelBoundedConstructible Λ X K ∧
          _root_.DerivedCategory.finiteTorAmplitude _ K) →
        constantModelBoundedConstructible Λ Y
            ((rightDerivedLowerShriekOfCompactification Λ
              (@HasCompactification.compactification X Y f
              (HasCompactification.of_isOver (S := Spec (.of k)) f))).obj K) ∧
          _root_.DerivedCategory.finiteTorAmplitude _
            ((rightDerivedLowerShriekOfCompactification Λ
              (@HasCompactification.compactification X Y f
              (HasCompactification.of_isOver (S := Spec (.of k)) f))).obj K)) ∧
    (∀ (h : ∀ K, localizingClosureProEtale Λ X K →
          localizingClosureProEtale Λ Y
            ((rightDerivedLowerShriekOfCompactification Λ
              (@HasCompactification.compactification X Y f
              (HasCompactification.of_isOver (S := Spec (.of k)) f))).obj K))
        (G : (localizingClosureProEtale Λ Y).FullSubcategory ⥤
          (localizingClosureProEtale Λ X).FullSubcategory)
        (_adj : (localizingLowerShriek Λ (@HasCompactification.compactification X Y f
              (HasCompactification.of_isOver (S := Spec (.of k)) f)) h) ⊣ G),
      ∀ K : _root_.DerivedCategory
        (Mod (Sheaf (Scheme.ProEt.topology Y) Ab.{u + 1}) (condensedRingObj Λ Y)),
        (hK : constantModelBoundedConstructible Λ Y K ∧
            _root_.DerivedCategory.finiteTorAmplitude _ K) →
          constantModelBoundedConstructible Λ X
