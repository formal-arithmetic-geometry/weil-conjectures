      (b : X''.obj.left ⟶ X'.obj.left) (w : Y''.obj.left ⟶ Y'.obj.left)
      (sq : IsPullback a f'.hom.left f.hom.left v)
      (sq' : IsPullback b f''.hom.left f'.hom.left w)
      (outer : IsPullback (b ≫ a) f''.hom.left f.hom.left (w ≫ v))
      (c : Compactification f.hom.left) (c' : Compactification f'.hom.left)
      (c'' : Compactification f''.hom.left)
      (K : (localizingClosureProEtale Λ X.obj.left).FullSubcategory),
    (leftDerivedUpperStarComp Λ w v).hom.app
        ((rightDerivedLowerShriekOfCompactification Λ c).obj K.obj) ≫
        (moduleObjectDerivedPullback Λ w).map ((H.exchange sq c c').hom.app K) ≫
        (H.exchange sq' c' c'').hom.app
          ⟨_, (H.pullback_preserves X' X a).1 K.obj K.property⟩ =
      (H.exchange outer c c'').hom.app K ≫
        (rightDerivedLowerShriekOfCompactification Λ c'').map
          ((leftDerivedUpperStarComp Λ b a).hom.app K.obj)

