module

public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.Derived.Native.NativeLineTensorFiniteness
public import WeilConjectures.AlgebraicGeometry.Native.NativeSignedLine
import WeilConjectures.Mathlib.CategoryTheory.Monoidal.Closed.Braided

/-! # Ordinary derived finiteness for signed local lines
Source: prop-weil-twist-preserves (blueprint: lem-twist-native-signed-finiteness).
-/
@[expose] public noncomputable section
set_option autoImplicit false
universe u
open CategoryTheory MonoidalCategory MonoidalClosed Limits
open scoped CategoryTheory.Obj
namespace AlgebraicGeometry.ProEtale.CondensedRing

-- Fix the site universe before generic imported enlargement instances are tried.
local instance (Y : Scheme.{u}) : EssentiallySmall.{u + 1} Y.ProEt :=
  essentiallySmallSelf.{0} _

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
  [MonObj Λ] [IsCommMonObj Λ] (X : Scheme.{u})

/-- The native module category for the pulled-back condensed coefficient ring.
Source: prop-weil-twist-preserves (blueprint: lem-twist-native-signed-finiteness). -/
abbrev NativeTwistModules : Type (u + 2) :=
  Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)

/-- The finiteness and inverse properties of all signed powers of a native line.
The ambient category and tensor are the ordinary unbounded derived ones.
Source: prop-weil-twist-preserves (blueprint: lem-twist-native-signed-finiteness). -/
structure NativeLineFiniteness : Prop where
  /-- A local regular basis for every signed line. -/
  locallyTrivial : ∀ m : ℤ, ∃ 𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X,
    ∀ i : 𝒰.I₀, Nonempty
      (((ProEtale.upperStar Ab.{u + 1} (𝒰.f i)).mapMod (condensedRingObj Λ X)).obj (𝒯 m) ≅
        Mod.regular ((ProEtale.upperStar Ab.{u + 1} (𝒰.f i)).obj (condensedRingObj Λ X)))
  /-- The opposite twist is the internal dual. -/
  dual : ∀ m : ℤ, Nonempty ((ihom (𝒯 m)).obj (𝟙_ _) ≅ 𝒯 (-m))
  /-- Opposite signed powers cancel. -/
  cancel : ∀ m : ℤ, Nonempty (𝒯 m ⊗ 𝒯 (-m) ≅ 𝟙_ _)
  /-- Every signed line is locally free. -/
  locallyFree : ∀ m : ℤ, IsLocallyFree (condensedRingObj Λ X) (𝒯 m)
  /-- The canonical evaluation is invertible. -/
  evaluation : ∀ m : ℤ, IsIso ((ihom.ev (𝒯 m)).app (𝟙_ _))
  /-- Exact tensor computes cohomology in every degree. -/
  homology : ∀ (m : ℤ) (K : DerivedCategory (NativeTwistModules Λ X)) (i : ℤ),
    Nonempty ((DerivedCategory.homologyFunctor (NativeTwistModules Λ X) i).obj
      (K ⊗ (DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 m)) ≅
        𝒯 m ⊗ (DerivedCategory.homologyFunctor (NativeTwistModules Λ X) i).obj K)
  /-- Every cohomological interval is preserved. -/
  cohomologicalInterval : ∀ (m : ℤ) (K : DerivedCategory (NativeTwistModules Λ X)) (a b : ℤ),
    DerivedCategory.homologyConcentratedIn a b K →
    DerivedCategory.homologyConcentratedIn a b
      (K ⊗ (DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 m))
  /-- Every Tor interval is preserved. -/
  torInterval : ∀ (m : ℤ) (K : DerivedCategory (NativeTwistModules Λ X)) (a b : ℤ),
    _root_.DerivedCategory.torAmplitudeIn (NativeTwistModules Λ X) a b K →
    _root_.DerivedCategory.torAmplitudeIn (NativeTwistModules Λ X) a b
      (K ⊗ (DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 m))
  /-- Bounded constructibility is preserved. -/
  boundedConstructible : ∀ (m : ℤ) (K : DerivedCategory (NativeTwistModules Λ X)),
    ProEtale.boundedConstructible (condensedRingObj Λ X) K →
    ProEtale.boundedConstructible (condensedRingObj Λ X)
      (K ⊗ (DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 m))
  /-- Constructibility with finite Tor amplitude is preserved. -/
  constructibleFiniteTor : ∀ (m : ℤ) (K : DerivedCategory (NativeTwistModules Λ X)),
    condensedConstructibleFiniteTor Λ X K →
    condensedConstructibleFiniteTor Λ X
      (K ⊗ (DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 m))
  /-- Tensor with the opposite line is the inverse on the entire derived category. -/
  equivalence : ∀ n : ℤ,
    ∃ e : DerivedCategory (NativeTwistModules Λ X) ≌ DerivedCategory (NativeTwistModules Λ X),
      e.functor = tensorRight
        ((DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 n)) ∧
      e.inverse = tensorRight
        ((DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).obj (𝒯 (-n)))

/-- The actual family is generated by a native local line with all finiteness properties.
The equality records the prescribed family, including the adopted algebraic-closure twists.
Source: prop-weil-twist-preserves (blueprint: lem-twist-native-signed-finiteness). -/
def NativeTwistFiniteness (T : ℤ → NativeTwistModules Λ X) : Prop :=
  ∃ L : NativeTwistModules Λ X,
    T = coefficientSignedTwist X (condensedRingObj Λ X) L ∧ NativeLineFiniteness Λ X L

/-- A native local line has all signed ordinary derived finiteness properties.
Source: prop-weil-twist-preserves, steps 1--4
(blueprint: lem-twist-native-signed-finiteness).
Proof: the signed-line lemma gives local freeness and canonical evaluation for every
power, and cancellation of opposite powers. Apply native locally free tensor
finiteness to each power. The K-flat single tensor comparison carries ordinary
cancellation to the derived unit. Symmetry gives the other cancellation; the
standard tensor-right equivalence has exactly the two prescribed tensor functors.
All cohomological and Tor endpoints are unchanged. -/
theorem nativeSignedLine_finiteness
    (L : NativeTwistModules Λ X)
    (hL : ∃ 𝒰 : Scheme.Cover.{u} Scheme.proetalePrecoverage X, ∀ i : 𝒰.I₀,
      Nonempty (((ProEtale.upperStar Ab.{u + 1} (𝒰.f i)).mapMod (condensedRingObj Λ X)).obj L ≅
        Mod.regular ((ProEtale.upperStar Ab.{u + 1} (𝒰.f i)).obj (condensedRingObj Λ X)))) :
    NativeTwistFiniteness Λ X (coefficientSignedTwist X (condensedRingObj Λ X) L) := by
  refine ⟨L, rfl, ?_⟩
  obtain ⟨hl, hf, hv, hd, he⟩ := nativeSignedLine (condensedRingObj Λ X) L hL
  have hfin (m : ℤ) := nativeLineTensor_finiteness _ (hf m)
  refine ⟨hl, hd, he, hf, fun m ↦ (hv m).isIso_ev _, fun m ↦ (hfin m).1,
    fun m ↦ (hfin m).2.1, fun m ↦ (hfin m).2.2.1,
    fun m ↦ (hfin m).2.2.2.1, fun m ↦ (hfin m).2.2.2.2, fun n ↦ ?_⟩
  let := _root_.DerivedCategory.braidedCategory' (C := NativeTwistModules Λ X)
  let e := (hf n).singleFunctorTensorObjIso
      (coefficientSignedTwist X (condensedRingObj Λ X) L (-n)) 0 ≪≫
    (DerivedCategory.singleFunctor (NativeTwistModules Λ X) 0).mapIso (he n).some ≪≫
    DerivedCategory.singleFunctorObjUnitIso _
  exact ⟨tensorRightEquivalenceOfTensorIso e (β_ _ _ ≪≫ e), rfl, rfl⟩

section SignedLine

variable (L : NativeTwistModules Λ X)

local notation "𝒯" => coefficientSignedTwist X (condensedRingObj Λ X) L

end SignedLine

end AlgebraicGeometry.ProEtale.CondensedRing
