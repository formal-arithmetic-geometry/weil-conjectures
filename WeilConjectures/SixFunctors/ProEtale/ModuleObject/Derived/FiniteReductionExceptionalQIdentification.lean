/-!
# Identification of the finite exceptional compact-support reduction map

Source: `literature/blueprint/latest/blueprint/part-duality-trace-formula/
sec-smooth-purity/sec-sp-grp-ladic-summary/sec-change-of-finite-coefficients/
sk-lem-sp-reduction/thm-pur-finite-reduction-of-purity.proof.md`, Steps 2 and 4
(blueprint: lem-pur-finite-reduction-exceptional-q-identification).

The scalar-adjunction transpose of the ambient proper/open compact-support comparison is
identified with the restriction used by the finite exceptional construction.  The theorem
is deliberately a statement only; its proof is deferred to the proving stage.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

universe u

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry AlgebraicGeometry.Scheme
open AlgebraicGeometry.ProEtale
open AlgebraicGeometry.ProEtale.CondensedRing
open AlgebraicGeometry.ProEtale.FiniteDiscreteOrdinary
open WeilConjectures.NativeFiniteExceptional

namespace AlgebraicGeometry.ProEtale.CondensedRing

/-- Restriction of scalars on the ordinary native derived module categories.
Source: the scalar adjunction in Step 2 of the finite reduction proof
(blueprint: lem-pur-finite-reduction-exceptional-q-identification). -/
abbrev finiteQRestriction {A B : ScalarSixRing.{u}} (a : A ⟶ B) (T : Scheme.{u}) :
    DerivedCategory (ModuleRingedComparison.internalModules B.X T) ⥤
      DerivedCategory (ModuleRingedComparison.internalModules A.X T) :=
  (Mod.comap (coefficientMap (Λ := A.X) (Λ' := B.X) a.hom.hom T)).mapDerivedCategory

/-- The published scalar adjunction, with its K-flat tensor-unit normalization.
Source: Step 2, scalar-adjunction Hom bijection
(blueprint: lem-pur-finite-reduction-exceptional-q-identification). -/
abbrev finiteQScalarAdjunction {A B : ScalarSixRing.{u}} (a : A ⟶ B) (T : Scheme.{u}) :
    scalarSixChange a T ⊣ finiteQRestriction a T :=
  Mod.derivedExtendMapDerivedCategoryAdjunction
    (coefficientMap (Λ := A.X) (Λ' := B.X) a.hom.hom T)

/-- Compact support for the specified factorization, on all ordinary derived modules.
Source: Step 2, F_R = Rp_* j_!
(blueprint: lem-pur-finite-reduction-exceptional-q-identification). -/
abbrev finiteQCompactSupport (A : ScalarSixRing.{u})
    {X Z Y : Scheme.{u}} (j : X ⟶ Z) [IsOpenImmersion j] (p : Z ⟶ Y) :=
  (openImmersionLowerShriek A.X j).mapDerivedCategory ⋙ RootCoordinateFace.lower A.X p

/-- Restriction/open comparison, obtained by exact localization of the canonical
ordinary extension-by-zero comparison, which is identity on restricted sections.
Source: Step 2, o_j
(blueprint: lem-pur-finite-reduction-exceptional-q-identification). -/
def finiteQOpenRestriction {A B : ScalarSixRing.{u}} (a : A ⟶ B)
    {X Z : Scheme.{u}} (j : X ⟶ Z) [IsOpenImmersion j] :
    (openImmersionLowerShriek B.X j).mapDerivedCategory ⋙ finiteQRestriction a Z ≅
      finiteQRestriction a X ⋙ (openImmersionLowerShriek A.X j).mapDerivedCategory :=
  (Functor.mapDerivedCategoryCompIso _ _).symm ≪≫
    Functor.mapDerivedCategoryNatIso
      (comapOpenImmersionLowerShriekIso (Λ := A.X) (Λ' := B.X) a.hom.hom j) ≪≫
    Functor.mapDerivedCategoryCompIso _ _

end AlgebraicGeometry.ProEtale.CondensedRing

namespace WeilConjectures.NativeFiniteExceptional

local instance (ell : ℕ) [Fact ell.Prime] (E : Type u) [Field E]
    [Algebra (Padic ell) E] [FiniteDimensional (Padic ell) E] (r : ℕ) :
    TopologicalSpace (Ring ell E r) := ⊥
local instance (ell : ℕ) [Fact ell.Prime] (E : Type u) [Field E]
    [Algebra (Padic ell) E] [FiniteDimensional (Padic ell) E] (r : ℕ) :
    DiscreteTopology (Ring ell E r) := ⟨rfl⟩
local instance (ell : ℕ) [Fact ell.Prime] (E : Type u) [Field E]
    [Algebra (Padic ell) E] [FiniteDimensional (Padic ell) E] (r : ℕ) :
    IsTopologicalRing (Ring ell E r) := inferInstance
local instance (ell : ℕ) [Fact ell.Prime] (E : Type u) [Field E]
    [Algebra (Padic ell) E] [FiniteDimensional (Padic ell) E] (r : ℕ) :
    Finite (Ring ell E r) :=
  Padic.finite_coefficientExtensionRing ell E (r + 1) (Nat.succ_pos r)

end WeilConjectures.NativeFiniteExceptional
