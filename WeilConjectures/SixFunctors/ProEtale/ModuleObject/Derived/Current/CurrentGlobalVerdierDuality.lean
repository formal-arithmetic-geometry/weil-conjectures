/-! # Global Verdier duality on the condensed pro-etale site

Source: latest blueprint, `sk-thm-sf-global-duality`, equations (1), (2) and the
mixed-support/evaluation/exceptional-counit normalization
(blueprint: sk-thm-sf-global-duality).

The right adjoint is any realization of the recorded constructible exceptional
adjunction. The canonical first map is defined from its counit, rather than
chosen from a nonempty collection of unrelated isomorphisms.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale.CondensedRing.Current

/-- The coefficient unit in the full constructible finite-Tor category.
Source: `sk-def-ops`, `omega_X = a_X^! Lambda_s` (blueprint: sk-def-ops). -/
def globalCoefficientUnit
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ] (k : Type u) [Field k] :
    ConstantModelConstructibleFiniteTor Λ (Spec (.of k)) :=
  ⟨𝟙_ _, condensedCoefficientUnit_mem Λ (Spec (.of k))⟩

end AlgebraicGeometry.ProEtale.CondensedRing.Current
