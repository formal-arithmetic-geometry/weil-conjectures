/-! # Data for the condensed derived Poincare identification

Source: latest blueprint, `sk-thm-sf-identification`, (11.6), (11.7), and Complement
(blueprint: def-sf-current-identification-data).

All pairings below are actual cup/evaluation/normalized-trace composites. The
identification with global duality is an equality of morphisms. The coefficient
squares use the recorded scalar-six maps, including nonflat finite reductions.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry Scheme
open scoped CategoryTheory.Obj CategoryTheory.Functor
open scoped AlgebraicGeometry.ProEtale.CondensedRing.CachedModInstances

-- Keep the same site-size instances as the recorded condensed pairing interface.
attribute [-instance] WeilConjectures.integralOperationsSiteSmall
attribute [local instance 10000] CategoryTheory.GrothendieckTopology.hasSheafify_proEtTopology
-- Scalar sections use the Grothendieck localization in the module hom universe.
attribute [local instance 20000] HasDerivedCategory.ofIsGrothendieckAbelian

namespace AlgebraicGeometry.ProEtale.CondensedRing.Current

/-- The ordinary-dual scalar comparison is the evaluation-defined Hom mate,
followed by the regular-unit comparison. No arbitrary dual comparison is chosen.
Source: scalar-six compatibility in (11.7) (blueprint: sk-thm-sf-identification). -/
def identificationDualScalar {Λ Λ' : ScalarSixRing.{u}} (a : Λ ⟶ Λ')
    (X : Scheme.{u}) (K : DerivedCategory (ModuleRingedComparison.internalModules Λ.X X)) :
    (scalarSixChange a X).obj ((ihom K).obj (𝟙_ _)) ⟶
      (ihom ((scalarSixChange a X).obj K)).obj (𝟙_ _) :=
  scalarSixHomComparison a X K (𝟙_ _) ≫
    (ihom ((scalarSixChange a X).obj K)).map
      (Functor.Monoidal.εIso (scalarSixChange a X)).inv

set_option maxHeartbeats 1600000 in
-- Nested scalar tower coordinates require more reduction than the default limit.
/-- Canonical Tate scalar map in arbitrary isomorphic coefficient coordinates.
The native degree-zero map uses normalized balanced tensor-power coordinates;
the surrounding maps are precisely the scalar tower associators.
Source: scalar-six compatibility and the purity-transport coefficient square
(blueprint: sk-thm-sf-identification). -/
def identificationLineScalar
    (ell : ℕ) [Fact ell.Prime] {Λ Λ' : ScalarSixRing.{u}}
    (c c' : PurityTransport.Coefficient ell)
    (e : c.bundled.{u} ell ≅ Λ) (e' : c'.bundled.{u} ell ≅ Λ') (a : Λ ⟶ Λ')
    (ha : c.integralMap ell ≫ (e.hom ≫ a ≫ e'.inv).hom.hom = c'.integralMap ell)
    (X : Scheme.{u})
    (p : PurityTransport.ScalarLineCoordinates ell (e.hom ≫ a ≫ e'.inv) ha X)
    (d : ℕ) :
    (scalarSixChange a X).obj (currentTwist ell Λ.X c e X d) ⟶
      currentTwist ell Λ'.X c' e' X d :=
  let L := (DerivedCategory.singleFunctor _ 0).obj (c.line ell X d)
  ((scalarSixTower e.hom a X).app L).hom ≫
    eqToHom (congrArg (fun b : c.bundled.{u} ell ⟶ Λ' ↦ (scalarSixChange b X).obj L)
      (show e.hom ≫ a = (e.hom ≫ a ≫ e'.inv) ≫ e'.hom by simp)) ≫
    ((scalarSixTower (e.hom ≫ a ≫ e'.inv) e'.hom X).app L).inv ≫
    (scalarSixChange e'.hom X).map
      (PurityTransport.scalarLineZero ell (e.hom ≫ a ≫ e'.inv) X d (p.power d))

set_option maxHeartbeats 4000000 in
-- Elaborating all derived coefficient diagrams together needs a larger heartbeat budget.
end AlgebraicGeometry.ProEtale.CondensedRing.Current
