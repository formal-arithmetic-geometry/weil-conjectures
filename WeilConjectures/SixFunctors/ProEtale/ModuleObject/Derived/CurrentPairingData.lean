/-! # Pairing data over a general base field

Source: literature/blueprint/latest/blueprint/part-duality-trace-formula/
sec-poincare-duality/sec-the-trace-map-in-top-degree/sk-cor-trace/
sk-def-pairing-data/_section.md, node `sk-def-pairing-data`, order 3602.
The geometric point is the structure morphism of a chosen algebraic closure.
The geometric-point fibre is obtained by derived pullback along it followed by
terminal sections.  The site-valued cup is the existing
projection/counit construction, transported by the strong-monoidal pullback.
The smooth trace uses the reviewed general-field trace dependency.
(blueprint: sk-def-pairing-data)
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

/-- The geometric point `u : Spec kbar ⟶ Spec k` given by the algebraic closure
`k → kbar`.  For algebraically closed `k` and `kbar = k` it is `Spec` of the
identity, that is the identity point.
Source: the geometric-point clause of `sk-def-pairing-data`, order 3602
(blueprint: sk-def-pairing-data). -/
abbrev geometricPairingPoint (k kbar : Type u) [Field k] [Field kbar] [Algebra k kbar] :
    Spec (.of kbar) ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k kbar))

/-- The geometric coefficient fibre `Γ(sbar, -) ∘ Lu^*` at the algebraic-closure
point `u = geometricPairingPoint k kbar`.
Source: the geometric-point realization clause of `sk-def-pairing-data`, order 3602
(blueprint: sk-def-pairing-data). -/
noncomputable abbrev geometricPairingFiber
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1})
    [MonObj Λ] [IsCommMonObj Λ]
    (k kbar : Type u) [Field k] [Field kbar] [Algebra k kbar] [IsAlgClosed kbar]
    [IsAlgClosure k kbar] (_hk : Finite k ∨ IsAlgClosed k) :
    DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology (Spec (.of k))) Ab.{u + 1})
      (condensedRingObj Λ (Spec (.of k)))) ⥤
    DerivedCategory (ModuleCat.{u + 1} (condensedScalarRing Λ)) :=
  moduleObjectDerivedPullback Λ (geometricPairingPoint k kbar) ⋙
    (CohomologyTransport.sections Λ (Spec (.of kbar))).mapDerivedCategory

/-- The smooth datum used by the pairing trace, with target the base point.
Source: the smooth morphism and compactification clauses of
`part-duality-trace-formula/sec-poincare-duality/sec-the-trace-map-in-top-degree/
sk-cor-trace/sk-def-pairing-data/_section.md` (blueprint: sk-def-pairing-data). -/
abbrev generalPairingSmoothDatum (k : Type u) [Field k]
    (X : Over (Spec (.of k))) [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [IsSeparated X.hom] (d : ℕ)
    [SmoothOfRelativeDimension d X.hom] (cf : Compactification X.hom) :
    GeneralPurityTransport.SmoothDatum k where
  X := X
  Y := Over.mk (𝟙 (Spec (.of k)))
  yFinite := (inferInstance : LocallyOfFiniteType (𝟙 (Spec (.of k))))
  yQuasiCompact := (inferInstance : QuasiCompact (𝟙 (Spec (.of k))))
  ySeparated := (inferInstance : IsSeparated (𝟙 (Spec (.of k))))
  map := X.hom
  isOver := ⟨Category.comp_id X.hom⟩
  dim := d
  compactification := cf

/-- The unit comparison `q` identifying the smooth-source unit with the Tate line.
Source: the trace clause of `sk-def-pairing-data` (equation (10.24) of
`sk-def-sp-trace` at `Λ_s`), with the canonical strong-monoidal unit comparison
(blueprint: sk-def-pairing-data). -/
def generalPairingTraceUnitSource (ell : ℕ) [Fact ell.Prime]
    (k : Type u) [Field k] (c : PurityTransport.Coefficient ell)
    (s : GeneralPurityTransport.SmoothDatum k) :
    (c.smoothSource ell s.map s.dim).obj (𝟙_ _) ≅
      c.derivedLine ell s.X.left s.dim :=
  tensorIso (leftDerivedUpperStarUnitIso (c.obj ell) s.map) (Iso.refl _) ≪≫ λ_ _

end AlgebraicGeometry.ProEtale.CondensedRing
