/-! # Open immersion scalar squares

Source: latest blueprint, det-lem-int-tensor-projection.proof.md, open immersion
paragraph; Stacks Tags 0E8I and 0E48.
(blueprint: lem-sfb-immersion-open-scalar-squares).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped CategoryTheory.Obj CategoryTheory.Functor
namespace AlgebraicGeometry.ProEtale.CondensedRing

/-- The specified open projection commutes with coefficient change on every input.
Source: Stacks Tags 0E8I and 0E48; the open immersion paragraph of the latest blueprint
(blueprint: lem-sfb-immersion-open-scalar-squares).

Proof: replace the scalar open map by its normalized conjugate. Transpose both sides under
the exact open adjunction, use the unit equation for the conjugate comparison, and apply
the monoidal tensor comparison and the pullback theta naturality. The two transposes agree
by the mate-pasting and adjunct-counit identities, so hom-equivalence injectivity gives the
square for all unbounded derived objects. No scalar-flatness hypothesis is used.
-/
theorem immersionOpenScalarSquares {Λ Λ' : ScalarSixRing.{u}} (a : Λ ⟶ Λ')
    {S Z : Scheme.{u}} (j : S ⟶ Z) [IsOpenImmersion j] :
    ∀ (D : DerivedCategory (supportModules Λ.X Z))
      (L : DerivedCategory (supportModules Λ.X S)),
      ImmersionOpenScalarSquare a j D L := by sorry

end AlgebraicGeometry.ProEtale.CondensedRing
