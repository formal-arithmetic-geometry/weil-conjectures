module

public import WeilConjectures.ConstructibleSheaf.FinitePushforward.Presentation
public import WeilConjectures.Mathlib.CategoryTheory.Presentable.Finite
public import WeilConjectures.SixFunctors.ProEtale.ConstructibleSheaf
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison.EtaleOrigin.Constructible
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.GaloisTraceInfinite.SheafIso

/-!
# Constructible module objects with finite coefficients are finitely generated

Let `T` be a finite discrete commutative ring, `Λ = C(-, T)` and `X` a quasi-compact
quasi-separated scheme. A constructible `Λ_X`-module object `M` on `X_proét` is generated by
finitely many finitely presentable objects
(`ProEtale.CondensedRing.isGeneratedByFinitelyPresentable_of_isConstructibleModuleObject`), in
the sense of `CategoryTheory.IsGeneratedByFinitelyPresentable`: there are finitely many morphisms
out of finitely presentable objects which are jointly epimorphic. Hence so are the cohomology
sheaves of a bounded constructible complex
(`ProEtale.CondensedRing.isGeneratedByFinitelyPresentable_homology_of_boundedConstructible`).
Such objects are in general not noetherian objects.

The generators are the module objects `ν^*(w_! T)` for étale maps `w : U ⟶ X` from affine
schemes (`ProEtale.CondensedRing.lowerShriekUnitModuleObject`), read through the
finite-coefficient comparison `ProEtale.finiteCoefficientModEquivalence`:
* morphisms `ν^*(w_! T) ⟶ M` are the sections of `M` over `U`, viewed as a pro-étale object
  (`ProEtale.CondensedRing.lowerShriekUnitModuleObjectHom_bijective`), by the adjunctions
  `ν^* ⊣ ν_*` and `w_! ⊣ w^*`; sections over the quasi-compact quasi-separated `U` commute with
  filtered colimits (`Scheme.ProEt.isColimitSectionsOfIsColimitOfShrink`), so `ν^*(w_! T)` is
  finitely presentable (`ProEtale.CondensedRing.isFinitelyPresentable_lowerShriekUnitModuleObject`);
* a constructible module object is `ν^*` of a constructible étale sheaf
  (`ProEtale.exists_isConstructibleSheaf_iso_comparisonUpperStar_obj`), which is a quotient of a
  finite sum of sheaves `w_! T` (`Etale.exists_epi_sigma_lowerShriekUnit`).
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory MonObj Limits Opposite

open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

/-- Sections of abelian pro-étale sheaves over a quasi-compact quasi-separated object commute with
filtered colimits indexed by small categories in `Type u`. -/
lemma preservesFilteredColimitsOfSize_abSectionsFunctor {X : Scheme.{u}} (W : X.ProEt)
    [CompactSpace W.left] [QuasiSeparatedSpace W.left] :
    PreservesFilteredColimitsOfSize.{u, u} (Scheme.ProEt.abSectionsFunctor W) where
  preserves_filtered_colimits _ _ _ := ⟨fun {_} ↦ ⟨fun hc ↦
    ⟨Scheme.ProEt.isColimitSectionsOfIsColimitOfShrink hc W⟩⟩⟩

variable (T : Type) [TopologicalSpace T] [CommRing T] [IsTopologicalRing T] [DiscreteTopology T]
  [Finite T] {X : Scheme.{u}}

-- the instance search for the forgetful functor of module objects goes through its adjoints
omit [DiscreteTopology T] [Finite T] in
/-- The forgetful functor from `Λ_X`-module objects to abelian pro-étale sheaves preserves filtered
colimits. -/
lemma preservesFilteredColimitsOfSize_forget_continuousMapRingObj :
    PreservesFilteredColimitsOfSize.{u, u} (Mod.forget (D := Sheaf (Scheme.ProEt.topology X)
      Ab.{u + 1}) (condensedRingObj (Profinite.continuousMapRingObj T) X)) where
  preserves_filtered_colimits _ _ _ := inferInstance

/-- The module object `ν^*(w_! T)` on `X_proét`, for an étale `w : U ⟶ X`: the extension by zero of
the constant sheaf `T` on `U_ét`, pulled back to the pro-étale site and read as a
`Λ_X`-module object through `ProEtale.finiteCoefficientModEquivalence`. -/
noncomputable def lowerShriekUnitModuleObject {U : Scheme.{u}} (w : U ⟶ X) (hw : Etale w) :
    Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T) X) :=
  (finiteCoefficientModEquivalence X T).inverse.obj
    ((ν^*(X)[ModuleCat.{u + 1} (ULift.{u + 1} T)]).obj
      (Etale.lowerShriekUnit (Λ := ULift.{u + 1} T) w hw))

/-- The morphism `ν^*(w_! T) ⟶ M` corresponding to a section of `M` over `U`, viewed as an object
of the pro-étale site of `X`: the section is a morphism `w_! T ⟶ ν_* M` (`Etale.sectionHom`), and
`ν^* ⊣ ν_*`. -/
noncomputable def lowerShriekUnitModuleObjectHom {U : Scheme.{u}} (w : U ⟶ X) (hw : Etale w)
    (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T) X))
    (σ : ((Mod.forget _).obj M).obj.obj (op ((toProEt X).obj (Etale.self w hw)))) :
    lowerShriekUnitModuleObject T w hw ⟶ M :=
  ((finiteCoefficientModEquivalence X T).symm.toAdjunction.homEquiv _ _).symm
    (((comparisonAdjunction _ X).homEquiv _ _).symm (Etale.sectionHom _ w hw σ))

/-- The morphism `ν^*(w_! T) ⟶ M` of a section is natural in `M`. -/
lemma lowerShriekUnitModuleObjectHom_comp {U : Scheme.{u}} (w : U ⟶ X) (hw : Etale w)
    {M M' : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T) X)} (g : M ⟶ M')
    (σ : ((Mod.forget _).obj M).obj.obj (op ((toProEt X).obj (Etale.self w hw)))) :
    lowerShriekUnitModuleObjectHom T w hw M σ ≫ g =
      lowerShriekUnitModuleObjectHom T w hw M' (((Mod.forget _).map g).hom.app _ σ) := by
  rw [lowerShriekUnitModuleObjectHom, lowerShriekUnitModuleObjectHom]
  erw [← Adjunction.homEquiv_naturality_right_symm]
  erw [← Adjunction.homEquiv_naturality_right_symm]
  erw [Etale.sectionHom_comp]
  rfl

/-- Morphisms `ν^*(w_! T) ⟶ M` are the sections of `M` over `U`. -/
lemma lowerShriekUnitModuleObjectHom_bijective {U : Scheme.{u}} (w : U ⟶ X) (hw : Etale w)
    (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T) X)) :
    Function.Bijective (lowerShriekUnitModuleObjectHom T w hw M) :=
  (Equiv.bijective _).comp ((Equiv.bijective _).comp
    ⟨Etale.sectionHom_injective _ w hw, Etale.sectionHom_surjective _ w hw⟩)

/-- The functor `Hom(ν^*(w_! T), -)` is the functor of sections over `U`. -/
noncomputable def sectionsIsoCoyonedaLowerShriekUnitModuleObject {U : Scheme.{u}} (w : U ⟶ X)
    (hw : Etale w) :
    Mod.forget _ ⋙ Scheme.ProEt.abSectionsFunctor ((toProEt X).obj (Etale.self w hw)) ⋙
        forget AddCommGrpCat.{u + 1} ≅
      coyoneda.obj (op (lowerShriekUnitModuleObject T w hw)) :=
  NatIso.ofComponents (fun M ↦ (Equiv.ofBijective _
    (lowerShriekUnitModuleObjectHom_bijective T w hw M)).toIso)
    fun g ↦ by
      ext σ
      exact (lowerShriekUnitModuleObjectHom_comp T w hw g σ).symm

/-- For an étale `w : U ⟶ X` with `U` quasi-compact and quasi-separated, the module object
`ν^*(w_! T)` is finitely presentable: maps out of it are the sections over `U`, which commute with
filtered colimits. -/
theorem isFinitelyPresentable_lowerShriekUnitModuleObject {U : Scheme.{u}} (w : U ⟶ X)
    (hw : Etale w) [CompactSpace U] [QuasiSeparatedSpace U] :
    IsFinitelyPresentable.{u} (lowerShriekUnitModuleObject T w hw) := by
  rw [isFinitelyPresentable_iff_preservesFilteredColimitsOfSize]
  have : CompactSpace ((toProEt X).obj (Etale.self w hw)).left := ‹_›
  have : QuasiSeparatedSpace ((toProEt X).obj (Etale.self w hw)).left := ‹_›
  have := preservesFilteredColimitsOfSize_abSectionsFunctor ((toProEt X).obj (Etale.self w hw))
  have := preservesFilteredColimitsOfSize_forget_continuousMapRingObj T (X := X)
  have : PreservesFilteredColimitsOfSize.{u, u} (forget AddCommGrpCat.{u + 1}) :=
    preservesFilteredColimitsOfSize_shrink.{u, u + 1, u, u + 1} _
  exact ⟨fun J _ _ ↦ preservesColimitsOfShape_of_natIso
    (sectionsIsoCoyonedaLowerShriekUnitModuleObject T w hw)⟩

/-- **Constructible module objects with finite coefficients are finitely generated**: on a
quasi-compact quasi-separated scheme `X`, a constructible `Λ_X`-module object `M` is generated by
finitely many finitely presentable objects `ν^*(w_! T)`. -/
theorem isGeneratedByFinitelyPresentable_of_isConstructibleModuleObject [CompactSpace X]
    [QuasiSeparatedSpace X]
    {M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T) X)}
    (hM : IsConstructibleModuleObject _ M) :
    IsGeneratedByFinitelyPresentable.{u} M := by
  obtain ⟨G, hG, ⟨e⟩⟩ := exists_isConstructibleSheaf_iso_comparisonUpperStar_obj
    (ULift.{u + 1} T) (isConstructible_finiteCoefficientModEquivalence_functor_obj T hM)
  obtain ⟨n, U, w, hw, hU, π, hπ⟩ := Etale.exists_epi_sigma_lowerShriekUnit G
  let adj := (comparisonAdjunction (ModuleCat.{u + 1} (ULift.{u + 1} T)) X).comp
    (finiteCoefficientModEquivalence X T).symm.toAdjunction
  refine ⟨n, fun i ↦ lowerShriekUnitModuleObject T (w i) (hw i), fun i ↦
    (finiteCoefficientModEquivalence X T).inverse.map
      ((ν^*(X)[ModuleCat.{u + 1} (ULift.{u + 1} T)]).map
        (Sigma.ι (fun i ↦ Etale.lowerShriekUnit (Λ := ULift.{u + 1} T) (w i) (hw i)) i ≫ π) ≫
        e.hom) ≫
      (finiteCoefficientModEquivalence X T).unitIso.inv.app M, fun i ↦ ?_, fun Z f f' h ↦ ?_⟩
  · have := hU i
    exact isFinitelyPresentable_lowerShriekUnitModuleObject T (w i) (hw i)
  · -- the morphisms are `L(ι_i ≫ π) ≫ c` for the left adjoint `L = ν^* ⋙ E⁻¹` and an
    -- isomorphism `c`; transpose along `L ⊣ R` and use that `π` is an epimorphism
    let c := (finiteCoefficientModEquivalence X T).inverse.map e.hom ≫
      (finiteCoefficientModEquivalence X T).unitIso.inv.app M
    have hc (i : Fin n) : (Sigma.ι (fun i ↦ Etale.lowerShriekUnit (Λ := ULift.{u + 1} T) (w i)
        (hw i)) i ≫ π) ≫ adj.homEquiv _ _ (c ≫ f) =
        (Sigma.ι (fun i ↦ Etale.lowerShriekUnit (Λ := ULift.{u + 1} T) (w i) (hw i)) i ≫ π) ≫
          adj.homEquiv _ _ (c ≫ f') := by
      rw [← Adjunction.homEquiv_naturality_left, ← Adjunction.homEquiv_naturality_left]
      congr 1
      have := h i
      simp only [Functor.comp_map, Functor.map_comp, Category.assoc, c] at this ⊢
      exact this
    have hπ' := Sigma.hom_ext _ _ fun i ↦ by simpa only [Category.assoc] using hc i
    rw [cancel_epi π, Equiv.apply_eq_iff_eq] at hπ'
    have : IsIso c := by
      dsimp only [c]
      infer_instance
    exact (cancel_epi c).1 hπ'

/-- **The cohomology sheaves of a bounded constructible complex with finite coefficients are
finitely generated**: on a quasi-compact quasi-separated scheme, they are generated by finitely
many finitely presentable objects. -/
theorem isGeneratedByFinitelyPresentable_homology_of_boundedConstructible [CompactSpace X]
    [QuasiSeparatedSpace X]
    {K : DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T) X))}
    (hK : boundedConstructible _ K) (q : ℤ) :
    IsGeneratedByFinitelyPresentable.{u} ((DerivedCategory.homologyFunctor _ q).obj K) :=
  isGeneratedByFinitelyPresentable_of_isConstructibleModuleObject T (hK.2 q)

end AlgebraicGeometry.ProEtale.CondensedRing
