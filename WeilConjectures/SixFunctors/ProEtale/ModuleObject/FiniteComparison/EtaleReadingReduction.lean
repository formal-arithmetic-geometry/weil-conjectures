module

public import WeilConjectures.CategoryTheory.ModuleObjects.DerivedExtendScalarsTransition
public import WeilConjectures.NumberTheory.Padics.IntegersModPowTransition
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.DerivedComplete.LiftMorphisms
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison.ChangeOfRings
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison.EtaleOriginReadingProof
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison.EtaleReadingReductionComparison
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison.EtaleReduction
public import WeilConjectures.TateTwist.FiniteRootsOfUnity

/-!
# The étale reading of the reductions `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ`

Let `ρ : 𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ` be the reduction (`ProEtale.CondensedRing.integersModPowCoeffTransition`),
surjective with kernel generated by `ℓⁿ`, and `Ψ = - ⊗ᴸ_{𝒪_E ⧸ ℓⁿ⁺¹} 𝒪_E ⧸ ℓⁿ` the derived
extension of scalars of étale sheaves along `ρ` (`AlgebraicGeometry.Etale.derivedExtendScalars`).
This file shows that the étale reading `red_n = Rν_* Φ (- ⊗ᴸ 𝒪_E ⧸ ℓⁿ)` of the reductions of
bounded constructible `𝒪_E`-complexes (`ProEtale.CondensedRing.etaleReduction`) carries the
condensed reduction `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ` to `Ψ`:

* `ProEtale.CondensedRing.etaleReductionExtendScalarsIso`: the natural isomorphism
  `β : Ψ(red_{n+1} K) ≅ red_n K`. It is assembled from the commutation of `Ψ` with `Rν_*` on
  objects of étale origin (`ProEtale.derivedExtendScalarsComparisonLowerStarMap`), the
  compatibility of the finite-coefficient comparison `Φ` with the extension of scalars
  (`ProEtale.finiteCoefficientDerivedEquivalenceExtendScalarsIso`) and the transitivity of the
  condensed derived extensions of scalars (`Mod.derivedExtendScalarsCompIso`);
* `ProEtale.CondensedRing.derivedExtendScalarsReduction_derivedReductionMap_eq`: a criterion, read
  on the étale site through `β`, for the condensed reduction
  (`Mod.derivedExtendScalarsReduction`) of a morphism `red_{n+1} K ⟶ red_{n+1} L` to be a given
  morphism `red_n K ⟶ red_n L`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (ℓ : ℕ) [Fact ℓ.Prime] (E : Type) [Field E] [Algebra E (PadicAlgCl ℓ)] (n : ℕ)

/-! ### The coefficient rings -/

/-- The reduction `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ` of the finite coefficient rings of étale sheaves. -/
noncomputable abbrev integersModPowCoeffTransition :
    integersModPowCoeff.{u} ℓ E (n + 1) →+* integersModPowCoeff.{u} ℓ E n :=
  (PadicAlgCl.integersModPowTransition ℓ E n).ulift

lemma integersModPowCoeffTransition_surjective :
    Function.Surjective (integersModPowCoeffTransition.{u} ℓ E n) :=
  PadicAlgCl.integersModPowULiftTransition_surjective.{u + 1} ℓ E n

/-- The kernel of `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ` is generated by `ℓⁿ`. -/
lemma ker_integersModPowCoeffTransition :
    RingHom.ker (integersModPowCoeffTransition.{u} ℓ E n) =
      Ideal.span {ULift.up (PadicAlgCl.integersModPowMk ℓ E (n + 1)
        ((ℓ : PadicAlgCl.integers ℓ E) ^ n))} :=
  PadicAlgCl.ker_integersModPowULiftTransition.{u + 1} ℓ E n

/-- The characteristic of `𝒪_E ⧸ ℓⁿ⁺¹` is `ℓ` times that of `𝒪_E ⧸ ℓⁿ`. -/
lemma ringChar_integersModPowCoeff_succ :
    ringChar (integersModPowCoeff.{u} ℓ E (n + 1)) =
      ringChar (integersModPowCoeff.{u} ℓ E n) * ℓ := by
  rw [ringChar_integersModPowCoeff, ringChar_integersModPowCoeff, pow_succ]

/-- The derived extension of scalars `Ψ = - ⊗ᴸ_{𝒪_E ⧸ ℓⁿ⁺¹} 𝒪_E ⧸ ℓⁿ` of étale sheaves on `Y`
along the reduction `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ`. -/
noncomputable abbrev integersModPowDerivedExtendScalars (Y : Scheme.{u}) :
    DerivedCategory (Sheaf Y.smallEtaleTopology
        (ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E (n + 1)))) ⥤
      DerivedCategory (Sheaf Y.smallEtaleTopology
        (ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n))) :=
  Etale.derivedExtendScalars (integersModPowCoeffTransition_surjective ℓ E n)
    (ker_integersModPowCoeffTransition ℓ E n) Y

/-! ### The condensed transition -/

section Condensed

variable [Algebra ℚ_[ℓ] E] [IsScalarTower ℚ_[ℓ] E (PadicAlgCl ℓ)] [FiniteDimensional ℚ_[ℓ] E]
  (X : Scheme.{u}) [TopologicalSpace.NoetherianSpace X]

/-- The condensed reduction `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ` of the reductions of bounded constructible
`𝒪_E`-complexes: `(𝒪_E ⧸ ℓⁿ) ⊗ᴸ_{𝒪_E ⧸ ℓⁿ⁺¹} red_{n+1} K ≅ red_n K`, from the transitivity
isomorphism of the derived extensions of scalars (`Mod.derivedExtendScalarsCompIso`). -/
noncomputable def boundedConstructibleIntegersModPowReductionTransitionIso :
    boundedConstructibleIntegersModPowReduction X ℓ E (n + 1) ⋙ (boundedConstructible _).ι ⋙
        (Mod.extendScalars (integersModPowTransition X ℓ E n)).leftDerivedFunctor ≅
      boundedConstructibleIntegersModPowReduction X ℓ E n ⋙ (boundedConstructible _).ι :=
  (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight (boundedConstructibleIntegersModPowReductionCompatibility X ℓ E (n + 1))
      _ ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (Mod.derivedExtendScalarsCompIso _ _ _
      (integersModPowReduction_comp_integersModPowTransition X ℓ E n)).symm ≪≫
    (boundedConstructibleIntegersModPowReductionCompatibility X ℓ E n).symm

lemma boundedConstructibleIntegersModPowReductionTransitionIso_hom_app
    (K : Dᵇc(X)⟦Profinite.padicIntegersRingObj ℓ E⟧) :
    (boundedConstructibleIntegersModPowReductionTransitionIso ℓ E n X).hom.app K =
      (Mod.extendScalars (integersModPowTransition X ℓ E n)).leftDerivedFunctor.map
          ((boundedConstructibleIntegersModPowReductionCompatibility X ℓ E (n + 1)).hom.app K) ≫
        (Mod.derivedExtendScalarsCompIso _ _ _
          (integersModPowReduction_comp_integersModPowTransition X ℓ E n)).inv.app
            ((boundedConstructible _).ι.obj K) ≫
        (boundedConstructibleIntegersModPowReductionCompatibility X ℓ E n).inv.app K := by
  simp [boundedConstructibleIntegersModPowReductionTransitionIso]

end Condensed

/-! ### The étale reading of the condensed transition -/

section Reading

variable {k : Type u} [Field k] [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ℓ)]
  [Algebra ℚ_[ℓ] E] [IsScalarTower ℚ_[ℓ] E (PadicAlgCl ℓ)] [FiniteDimensional ℚ_[ℓ] E]
  (X : Over (Spec (.of k))) [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]

/-- The derived extension of scalars of the étale reading of a bounded constructible condensed
`𝒪_E ⧸ ℓⁿ⁺¹`-complex `M`, compared with the étale reading of its condensed extension of scalars:
`Ψ(Rν_* Φ M) ⟶ Rν_* Ψ(Φ M) ≅ Rν_* Φ((𝒪_E ⧸ ℓⁿ) ⊗ᴸ M)`, by the base change map of `Rν_*`
(`ProEtale.derivedExtendScalarsComparisonLowerStarMap`) and the compatibility of `Φ` with the
extension of scalars (`ProEtale.finiteCoefficientDerivedEquivalenceExtendScalarsIso`). -/
noncomputable def finiteEtaleReadingExtendScalarsMap :
    finiteEtaleReading ℓ E (n + 1) X ⋙ integersModPowDerivedExtendScalars ℓ E n X.left ⟶
      (boundedConstructible _).ι ⋙
        (Mod.extendScalars (integersModPowTransition X.left ℓ E n)).leftDerivedFunctor ⋙
          (finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E n)).functor ⋙
            R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)]) :=
  Functor.whiskerLeft ((boundedConstructible _).ι ⋙
      (finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E (n + 1))).functor)
      (derivedExtendScalarsComparisonLowerStarMap (integersModPowCoeffTransition_surjective ℓ E n)
        (ker_integersModPowCoeffTransition ℓ E n) X.left) ≫
    Functor.whiskerLeft (boundedConstructible _).ι
      (Functor.whiskerRight (finiteCoefficientDerivedEquivalenceExtendScalarsIso X.left
        (PadicAlgCl.integersModPowTransition_surjective ℓ E n)
        (ker_integersModPowCoeffTransition ℓ E n)).hom
        R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)]))

lemma finiteEtaleReadingExtendScalarsMap_app
    (M : Dᵇc(X.left)⟦Profinite.integersModPowRingObj ℓ E (n + 1)⟧) :
    (finiteEtaleReadingExtendScalarsMap ℓ E n X).app M =
      (derivedExtendScalarsComparisonLowerStarMap (integersModPowCoeffTransition_surjective ℓ E n)
          (ker_integersModPowCoeffTransition ℓ E n) X.left).app
          ((finiteCoefficientDerivedEquivalence X.left
            (PadicAlgCl.integersModPow ℓ E (n + 1))).functor.obj M.obj) ≫
        R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)]).map
          ((finiteCoefficientDerivedEquivalenceExtendScalarsIso X.left
            (PadicAlgCl.integersModPowTransition_surjective ℓ E n)
            (ker_integersModPowCoeffTransition ℓ E n)).hom.app M.obj) :=
  rfl

/-- At the reduction `red_{n+1} K` of a bounded constructible `𝒪_E`-complex, the comparison
`finiteEtaleReadingExtendScalarsMap` is an isomorphism: `Φ(red_{n+1} K)` is of étale origin, and
its extension of scalars `Φ((𝒪_E ⧸ ℓⁿ) ⊗ᴸ red_{n+1} K) ≅ Φ(red_n K)` is bounded below. -/
lemma isIso_finiteEtaleReadingExtendScalarsMap_app
    (K : Dᵇc(X.left)⟦Profinite.padicIntegersRingObj ℓ E⟧) :
    IsIso ((finiteEtaleReadingExtendScalarsMap ℓ E n X).app
      ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K)) := by
  rw [finiteEtaleReadingExtendScalarsMap_app]
  have hL : DerivedCategory.plusEtaleOrigin _ X.left
      ((finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E (n + 1))).functor.obj
        ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K).obj) := by
    obtain ⟨M₀, hM₀, ⟨e⟩⟩ := etaleOriginReading ℓ E (n + 1) X
      ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K)
    exact ⟨M₀, hM₀.1.1, ⟨e⟩⟩
  have hL' : DerivedCategory.TStructure.t.plus
      ((ProEtale.derivedExtendScalars (integersModPowCoeffTransition_surjective ℓ E n)
        (ker_integersModPowCoeffTransition ℓ E n) X.left).obj
        ((finiteCoefficientDerivedEquivalence X.left
          (PadicAlgCl.integersModPow ℓ E (n + 1))).functor.obj
          ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K).obj)) := by
    obtain ⟨M₀, hM₀, ⟨e⟩⟩ := etaleOriginReading ℓ E n X
      ((boundedConstructibleIntegersModPowReduction X.left ℓ E n).obj K)
    exact DerivedCategory.TStructure.t.plus.prop_of_iso
      (((finiteCoefficientDerivedEquivalenceExtendScalarsIso X.left
        (PadicAlgCl.integersModPowTransition_surjective ℓ E n)
        (ker_integersModPowCoeffTransition ℓ E n)).app _ ≪≫
        (finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E n)).functor.mapIso
          ((boundedConstructibleIntegersModPowReductionTransitionIso ℓ E n X.left).app K)).symm)
      (DerivedCategory.plusEtaleOrigin.plus ⟨M₀, hM₀.1.1, ⟨e⟩⟩)
  have := isIso_derivedExtendScalarsComparisonLowerStarMap_app
    (integersModPowCoeffTransition_surjective ℓ E n) (ker_integersModPowCoeffTransition ℓ E n)
    X.left _ hL hL'
  infer_instance

/-- Blueprint `det-sp-purity-coefficient-change` (the coefficient change on the étale site).
**The étale reading carries the condensed reduction `𝒪_E ⧸ ℓⁿ⁺¹ ⟶ 𝒪_E ⧸ ℓⁿ` to `Ψ`**: the natural
isomorphism `β : Ψ(red_{n+1} K) ≅ red_n K` of the étale readings of the reductions of bounded
constructible `𝒪_E`-complexes, where `Ψ = - ⊗ᴸ_{𝒪_E ⧸ ℓⁿ⁺¹} 𝒪_E ⧸ ℓⁿ`. It is
`finiteEtaleReadingExtendScalarsMap` at `red_{n+1} K`, followed by the étale reading of the
condensed isomorphism `(𝒪_E ⧸ ℓⁿ) ⊗ᴸ red_{n+1} K ≅ red_n K`
(`boundedConstructibleIntegersModPowReductionTransitionIso`). -/
noncomputable def etaleReductionExtendScalarsIso :
    etaleReduction ℓ E (n + 1) X ⋙ integersModPowDerivedExtendScalars ℓ E n X.left ≅
      etaleReduction ℓ E n X :=
  have : IsIso (Functor.whiskerLeft (boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1))
      (finiteEtaleReadingExtendScalarsMap ℓ E n X)) :=
    (NatTrans.isIso_iff_isIso_app _).2 fun K ↦ isIso_finiteEtaleReadingExtendScalarsMap_app ℓ E n X K
  asIso (Functor.whiskerLeft (boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1))
      (finiteEtaleReadingExtendScalarsMap ℓ E n X)) ≪≫
    Functor.isoWhiskerRight (boundedConstructibleIntegersModPowReductionTransitionIso ℓ E n X.left)
      ((finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E n)).functor ⋙
        R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)]))

lemma etaleReductionExtendScalarsIso_hom_app
    (K : Dᵇc(X.left)⟦Profinite.padicIntegersRingObj ℓ E⟧) :
    (etaleReductionExtendScalarsIso ℓ E n X).hom.app K =
      (finiteEtaleReadingExtendScalarsMap ℓ E n X).app
          ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K) ≫
        ((finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E n)).functor ⋙
          R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)])).map
          ((boundedConstructibleIntegersModPowReductionTransitionIso ℓ E n X.left).hom.app K) :=
  rfl

/-- The component at `K` of `etaleReductionExtendScalarsIso`, between the objects
`Ψ(ρ(red_{n+1} K))` and `ρ(red_n K)` written with the étale readings `ρ`
(`finiteEtaleReading`). -/
noncomputable def etaleReductionExtendScalarsIsoApp
    (K : Dᵇc(X.left)⟦Profinite.padicIntegersRingObj ℓ E⟧) :
    (integersModPowDerivedExtendScalars ℓ E n X.left).obj ((finiteEtaleReading ℓ E (n + 1) X).obj
        ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K)) ≅
      (finiteEtaleReading ℓ E n X).obj ((boundedConstructibleIntegersModPowReduction X.left ℓ E n).obj K) :=
  have := isIso_finiteEtaleReadingExtendScalarsMap_app ℓ E n X K
  asIso ((finiteEtaleReadingExtendScalarsMap ℓ E n X).app
      ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K)) ≪≫
    ((finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E n)).functor ⋙
      R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)])).mapIso
      ((boundedConstructibleIntegersModPowReductionTransitionIso ℓ E n X.left).app K)

lemma etaleReductionExtendScalarsIsoApp_hom
    (K : Dᵇc(X.left)⟦Profinite.padicIntegersRingObj ℓ E⟧) :
    (etaleReductionExtendScalarsIsoApp ℓ E n X K).hom =
      (finiteEtaleReadingExtendScalarsMap ℓ E n X).app
          ((boundedConstructibleIntegersModPowReduction X.left ℓ E (n + 1)).obj K) ≫
        ((finiteCoefficientDerivedEquivalence X.left (PadicAlgCl.integersModPow ℓ E n)).functor ⋙
          R(ν_*(X.left)[ModuleCat.{u + 1} (integersModPowCoeff.{u} ℓ E n)])).map
          ((boundedConstructibleIntegersModPowReductionTransitionIso ℓ E n X.left).hom.app K) :=
  rfl

lemma etaleReductionExtendScalarsIso_app
    (K : Dᵇc(X.left)⟦Profinite.padicIntegersRingObj ℓ E⟧) :
    (etaleReductionExtendScalarsIso ℓ E n X).app K = etaleReductionExtendScalarsIsoApp ℓ E n X K :=
  Iso.ext (etaleReductionExtendScalarsIso_hom_app ℓ E n X K)

end Reading

end AlgebraicGeometry.ProEtale.CondensedRing
