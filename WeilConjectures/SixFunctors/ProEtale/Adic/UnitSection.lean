module

public import WeilConjectures.SixFunctors.ProEtale.Adic.TrivialRepresentation
public import WeilConjectures.SixFunctors.ProEtale.UpperLowerStar.GlobalSectionsMonoidal

/-!
# The stalk of the constant `ℓ`-adic sheaf at a point with values in a field

For a morphism `s : Spec K ⟶ Z` from the spectrum of a field, the stalk
`Γ(Spec K, s^* ℚ̄_ℓ,Z)` of the constant `ℓ`-adic sheaf is `ℚ̄_ℓ`, generated by the unit section:
the unit `ℚ̄_ℓ ⟶ Γ(Spec K, s^* ℚ̄_ℓ,Z)`, image of the unit of the sheaf of rings `ℚ̄_ℓ,Z` under the
lax monoidal functor `Γ ∘ s^*`, is an isomorphism (`AlgebraicGeometry.ProEtale.isIso_unitSection`).
Indeed `s^* ℚ̄_ℓ,Z ≅ ℚ̄_ℓ,Spec K` as sheaves of rings, and the locally finite functions on the
point `Spec K` are the constants.
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory MonObj Functor.LaxMonoidal Opposite Limits

namespace AlgebraicGeometry.ProEtale

open scoped Obj

variable {l : ℕ} [Fact l.Prime] {K : Type u} [Field K] {Z : Scheme.{u}}

variable (l) in
/-- The unit section `ℚ̄_ℓ ⟶ Γ(Spec K, s^* ℚ̄_ℓ,Z)` of the stalk of the constant sheaf: the image
of the unit of the sheaf of rings `ℚ̄_ℓ,Z` under the lax monoidal functor `Γ ∘ s^*`. -/
noncomputable def unitSection (s : Spec (.of K) ⟶ Z) :
    𝟙_ (WeilCoefficients.{u} l) ⟶
      (Sheaf.Γ _ _).obj ((s)^*[WeilCoefficients.{u} l].obj (adicConstantSheaf l Z)) :=
  ε ((s)^*[WeilCoefficients.{u} l] ⋙ Sheaf.Γ _ _) ≫
    ((s)^*[WeilCoefficients.{u} l] ⋙ Sheaf.Γ _ _).map η[adicConstantSheaf l Z]

lemma unitSection_eq (s : Spec (.of K) ⟶ Z) :
    unitSection l s = (η[(adicConstantSheaf l (Spec (.of K))).obj]).app
        (op (Scheme.ProEt.mk (𝟙 _))) ≫
      (Sheaf.ΓNatIsoSheafSections _ _ (Scheme.ProEt.isTerminalMkId _)).inv.app
        (adicConstantSheaf l (Spec (.of K))) ≫
        (Sheaf.Γ _ _).map (inv (((upperStarLowerStarAdjunction (WeilCoefficients.{u} l) s).homEquiv
          _ _).symm (adicConstantSheafToLowerStar l s))) := by
  have h₁ : η[(s)^*[WeilCoefficients.{u} l].obj (adicConstantSheaf l Z)] =
      η[adicConstantSheaf l (Spec (.of K))] ≫
        inv (((upperStarLowerStarAdjunction (WeilCoefficients.{u} l) s).homEquiv
          _ _).symm (adicConstantSheafToLowerStar l s)) :=
    (IsMonHom.one_hom (f := inv (((upperStarLowerStarAdjunction (WeilCoefficients.{u} l)
      s).homEquiv
          _ _).symm (adicConstantSheafToLowerStar l s)))).symm
  rw [unitSection, Functor.LaxMonoidal.comp_ε, Functor.comp_map, Category.assoc,
    ← Functor.map_comp, ← Functor.obj.η_def, h₁, Functor.map_comp, ε_Γ]
  simp only [Category.assoc]
  rw [← NatTrans.naturality_assoc, Functor.flip_obj_map, ← Category.assoc,
    ← NatTrans.comp_app, adicConstantSheaf_ε_comp_map_one']

/-- The unit section of the stalk of the constant sheaf is an isomorphism: the stalk is
`ℚ̄_ℓ`. -/
instance isIso_unitSection (s : Spec (.of K) ⟶ Z) : IsIso (unitSection l s) := by
  rw [unitSection_eq]
  suffices IsIso ((η[(adicConstantSheaf l (Spec (.of K))).obj]).app
      (op (Scheme.ProEt.mk (𝟙 _)))) by infer_instance
  rw [ConcreteCategory.isIso_iff_bijective]
  have : ConnectedSpace (Spec (.of K)) := inferInstance
  refine ⟨fun a b h ↦ ?_, fun f ↦ ?_⟩
  · have h' := congrArg (fun f : (adicConstantSheaf l (Spec (.of K))).obj.obj
      (op (Scheme.ProEt.mk (𝟙 _))) ↦ f.down.1 (IsLocalRing.closedPoint K)) h
    simp only [adicConstantSheaf_one_app] at h'
    exact ULift.ext _ _ (by simpa using h')
  · refine ⟨ULift.up (f.down.1 (IsLocalRing.closedPoint K)), ?_⟩
    rw [adicConstantSheaf_one_app]
    exact congrArg ULift.up (@PadicAlgCl.locallyFiniteFunctions_eq_algebraMap _ _ _ _
      (inferInstanceAs (PreconnectedSpace (Spec (.of K)))) f.down _).symm

end AlgebraicGeometry.ProEtale
