module

public import WeilConjectures.SixFunctors.ProEtale.Adic.LatticeGeneration
public import WeilConjectures.SixFunctors.ProEtale.Adic.LocallyFiniteDecomposition

/-!
# Lisse sheaves whose sections are `C(U, M) ⊗_{𝒪_E} ℚ̄_ℓ`

Let `R ⊆ ℚ̄_ℓ` be a principal ideal domain containing `ℤ_ℓ` with values in a finite extension
`E` of `ℚ_ℓ` (typically `R = 𝒪_E`), `M` a finitely generated `R`-module and
`ψ_U : C(U, M) → F(U)` natural `C(U, R)`-semilinear maps to the sections of a sheaf of
`ℚ̄_ℓ,X`-modules. They induce `ℚ̄_ℓ ⊗_R C(U, M) → F(U)`, `c ⊗ m ↦ c • ψ(m)`
(`AlgebraicGeometry.ProEtale.AdicSheaf.tensorSections`). If it is bijective for every affine
`U` (the expected description of `F = Rⁱg_* ℚ̄_ℓ,T = colim_{E'} (Rⁱg_* 𝒪_{E,T}) ⊗_{𝒪_E} E'` on the
universal cover, where `Rⁱg_* 𝒪_{E,T} = C(-, M)`), then:

- `F` is generated by the image of `ψ` on affine objects (surjectivity);
- the inverse followed by evaluation at a point, `ℚ̄_ℓ ⊗_R C(U, M) → ℚ̄_ℓ ⊗_R M`, is a pointwise
  evaluation compatible with the action of `ℚ̄_ℓ,X(U)`: a locally finite function on the
  quasi-compact `U` is a combination of `ℤ_ℓ`-valued functions with constant coefficients
  (`PadicAlgCl.exists_eq_sum_mul_padicInt`), which act through `ψ` by semilinearity.

Hence a sheaf whose pullback to a weakly étale cover has such a description is lisse
(`AlgebraicGeometry.ProEtale.IsAdicLisseSheaf.of_bijective_tensorSections`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite TensorProduct

namespace AlgebraicGeometry.ProEtale.AdicSheaf

open PadicAlgCl

variable {l : ℕ} [Fact l.Prime] {X : Scheme.{u}} (F : AdicSheaf l X)
  {R : Type} [CommRing R] [TopologicalSpace R] [Algebra R (PadicAlgCl l)]
  (hι : Continuous (algebraMap R (PadicAlgCl l)))
  {E : IntermediateField ℚ_[l] (PadicAlgCl l)} [FiniteDimensional ℚ_[l] E]
  (hιE : ∀ x, algebraMap R (PadicAlgCl l) x ∈ E)
  {M : Type} [AddCommGroup M] [Module R M] [TopologicalSpace M] [IsTopologicalAddGroup M]
  [ContinuousSMul R M]
  (ψ : ∀ U : X.ProEt, C(U.left, M) →+ F.X.obj.obj (op U))
  (hψι : ∀ (U : X.ProEt) (g : C(U.left, R)) (m : C(U.left, M)),
    ψ U (g • m) = sectionAct F (ULift.up (ringValuedFunction _ hι hιE g)) (ψ U m))

include hψι in
/-- `ψ` is `R`-linear, `R` acting on sections through `R ⊆ ℚ̄_ℓ`. -/
lemma map_smul_of_semilinear (U : X.ProEt) (r : R) (m : C(U.left, M)) :
    ψ U (r • m) = ULift.up (algebraMap R (PadicAlgCl l) r) • ψ U m := by
  have h := hψι U (ContinuousMap.const _ r) m
  have h0 : (ContinuousMap.const _ r : C(U.left, R)) • m = r • m := rfl
  rw [h0] at h
  rw [h]
  exact algebraMap_sectionAct F (ULift.up (algebraMap R (PadicAlgCl l) r)) _

include hι hιE hψι in
/-- The map `ℚ̄_ℓ ⊗_R C(U, M) → F(U)`, `c ⊗ m ↦ c • ψ(m)`. -/
noncomputable def tensorSections (U : X.ProEt) :
    PadicAlgCl l ⊗[R] C(U.left, M) →+ F.X.obj.obj (op U) :=
  TensorProduct.liftAddHom
    (AddMonoidHom.mk' (fun c ↦ AddMonoidHom.mk' (fun m ↦ ULift.up c • ψ U m)
      fun m m' ↦ by rw [map_add, smul_add])
      fun c c' ↦ by ext m; exact add_smul (ULift.up c) (ULift.up c') (ψ U m))
    fun r c m ↦ by
      change ULift.up (r • c) • ψ U m = ULift.up c • ψ U (r • m)
      rw [map_smul_of_semilinear F hι hιE ψ hψι]
      have h : (ULift.up (r • c) : ULift.{u + 1} (PadicAlgCl l)) =
          ULift.up c * ULift.up (algebraMap R (PadicAlgCl l) r) :=
        ULift.ext ((Algebra.smul_def r c).trans (mul_comm _ _))
      rw [h]
      exact mul_smul _ _ _

@[simp]
lemma tensorSections_tmul (U : X.ProEt) (c : PadicAlgCl l) (m : C(U.left, M)) :
    tensorSections F hι hιE ψ hψι U (c ⊗ₜ m) = ULift.up c • ψ U m :=
  rfl

/-- If `ℚ̄_ℓ ⊗_R C(U, M) → F(U)` is surjective, every section over `U` is a finite sum
`∑ aⱼ • ψ(mⱼ)` (with constant `aⱼ`). -/
lemma exists_sum_of_surjective_tensorSections (U : X.ProEt)
    (h : Function.Surjective (tensorSections F hι hιE ψ hψι U)) (x : F.X.obj.obj (op U)) :
    ∃ (n : ℕ) (a : Fin n → (adicConstantSheaf l X).obj.obj (op U)) (m : Fin n → C(U.left, M)),
      x = ∑ j, sectionAct F (a j) (ψ U (m j)) := by
  obtain ⟨τ, rfl⟩ := h x
  induction τ using TensorProduct.inductionOn with
  | tmul c m =>
    refine ⟨1, fun _ ↦ ULift.up (algebraMap _ _ c), fun _ ↦ m, ?_⟩
    rw [Fin.sum_univ_one, algebraMap_sectionAct F (ULift.up c)]
    rfl
  | add τ τ' hτ hτ' =>
    obtain ⟨n, a, m, h⟩ := hτ
    obtain ⟨n', a', m', h'⟩ := hτ'
    refine ⟨n + n', Fin.append a a', Fin.append m m', ?_⟩
    rw [map_add, h, h', Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]

/-- Evaluation at a point, `ℚ̄_ℓ ⊗_R C(T, M) → ℚ̄_ℓ ⊗_R M`. -/
noncomputable def tensorEval {T : Type*} [TopologicalSpace T] (x : T) :
    PadicAlgCl l ⊗[R] C(T, M) →ₗ[PadicAlgCl l] PadicAlgCl l ⊗[R] M :=
  LinearMap.baseChange _ ⟨⟨fun m ↦ m x, fun _ _ ↦ rfl⟩, fun _ _ ↦ rfl⟩

@[simp]
lemma tensorEval_tmul {T : Type*} [TopologicalSpace T] (x : T) (c : PadicAlgCl l) (m : C(T, M)) :
    tensorEval (R := R) x (c ⊗ₜ m) = c ⊗ₜ m x :=
  rfl

variable {κ : ℤ_[l] →+* R} (hκ : Continuous κ)
  (hικ : ∀ z, algebraMap R (PadicAlgCl l) (κ z) = algebraMap ℚ_[l] _ (PadicInt.Coe.ringHom z))

include hψι hκ hικ in
/-- **The action of `ℚ̄_ℓ,X(U)` on `ℚ̄_ℓ ⊗_R C(U, M)`**: for quasi-compact `U` and a locally
finite function `a`, the action of `a` on the image of `ℚ̄_ℓ ⊗_R C(U, M) → F(U)` lifts to an
additive endomorphism `A` of `ℚ̄_ℓ ⊗_R C(U, M)` which, after evaluation at a point `x`, is
multiplication by `a(x)`. -/
lemma exists_sectionAct_tensorSections (U : X.ProEt) [CompactSpace U.left]
    (a : (adicConstantSheaf l X).obj.obj (op U))
    (ha : a.down.1 ∈ finiteIntermediateFieldValued l U.left) :
    ∃ A : PadicAlgCl l ⊗[R] C(U.left, M) →+ PadicAlgCl l ⊗[R] C(U.left, M),
      (∀ τ, sectionAct F a (tensorSections F hι hιE ψ hψι U τ) =
        tensorSections F hι hιE ψ hψι U (A τ)) ∧
      ∀ x τ, tensorEval x (A τ) = a.down.1 x • tensorEval x τ := by
  obtain ⟨E₁, _, hE₁⟩ := ha
  obtain ⟨n, c, g, hcg⟩ := exists_eq_sum_mul_padicInt (T := U.left) a.down.1 E₁ hE₁
  let h (k : Fin n) : C(U.left, R) := (⟨κ, hκ⟩ : C(ℤ_[l], R)).comp (g k)
  let sm (k : Fin n) : C(U.left, M) →ₗ[R] C(U.left, M) :=
    { toFun := fun m ↦ h k • m
      map_add' := fun m m' ↦ ContinuousMap.ext fun x ↦ by
        simp only [ContinuousMap.smul_apply', ContinuousMap.add_apply, smul_add]
      map_smul' := fun r m ↦ ContinuousMap.ext fun x ↦ by
        simp only [ContinuousMap.smul_apply', ContinuousMap.smul_apply, RingHom.id_apply]
        exact smul_comm _ _ _ }
  let B (k : Fin n) := LinearMap.baseChange (PadicAlgCl l) (sm k)
  have hB (k : Fin n) (d : PadicAlgCl l) (m : C(U.left, M)) : B k (d ⊗ₜ m) = d ⊗ₜ (h k • m) :=
    rfl
  have hax (x : U.left) : a.down.1 x = ∑ k, c k * algebraMap R (PadicAlgCl l) (h k x) :=
    (hcg x).trans (Finset.sum_congr rfl fun k _ ↦ by rw [← hικ]; rfl)
  -- `a = ∑ cₖ (ι ∘ κ ∘ gₖ)`
  have ha (t : F.X.obj.obj (op U)) : sectionAct F a t = ∑ k, ULift.up (c k) •
      sectionAct F (ULift.up (ringValuedFunction _ hι hιE (h k))) t := by
    have ha' : a = ∑ k, (ULift.up (c k) : ULift.{u + 1} (PadicAlgCl l)) •
        (ULift.up (ringValuedFunction _ hι hιE (h k)) :
          (adicConstantSheaf l X).obj.obj (op U)) := by
      refine ULift.ext (Subtype.ext (ContinuousMap.ext fun x ↦ ?_))
      let ev : (adicConstantSheaf l X).obj.obj (op U) →+ PadicAlgCl l :=
        ⟨⟨fun b ↦ b.down.1 x, rfl⟩, fun _ _ ↦ rfl⟩
      change ev a = ev _
      rw [map_sum]
      exact (hax x).trans (Finset.sum_congr rfl fun k _ ↦ rfl)
    rw [ha', sum_sectionAct]
    exact Finset.sum_congr rfl fun k _ ↦ smul_sectionAct F _ _ t
  refine ⟨AddMonoidHom.mk' (fun τ ↦ ∑ k, c k • B k τ) fun τ τ' ↦ by
    simp only [map_add, smul_add, Finset.sum_add_distrib], fun τ ↦ ?_, fun x τ ↦ ?_⟩
  · induction τ using TensorProduct.inductionOn with
    | add τ τ' hτ hτ' => simp only [map_add, sectionAct_add, hτ, hτ']
    | tmul d m =>
      simp only [AddMonoidHom.mk'_apply, hB, TensorProduct.smul_tmul', map_sum,
        tensorSections_tmul]
      rw [sectionAct_smul, ha, Finset.smul_sum]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [hψι]
      have e : (ULift.up (c k • d) : ULift.{u + 1} (PadicAlgCl l)) =
          ULift.up d * ULift.up (c k) :=
        ULift.ext ((smul_eq_mul _ _).trans (mul_comm _ _))
      rw [e]
      exact (mul_smul _ _ _).symm
  · induction τ using TensorProduct.inductionOn with
    | add τ τ' hτ hτ' => simp only [map_add, hτ, hτ', smul_add]
    | tmul d m =>
      simp only [AddMonoidHom.mk'_apply, hB, map_sum, map_smul, tensorEval_tmul,
        ContinuousMap.smul_apply', TensorProduct.tmul_smul, hax, Finset.sum_smul]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [mul_smul, algebraMap_smul]

end AlgebraicGeometry.ProEtale.AdicSheaf

namespace AlgebraicGeometry.ProEtale

open AdicSheaf PadicAlgCl

/-- **A sheaf whose sections on a cover are `ℚ̄_ℓ ⊗_R C(U, M)` is lisse**: let `p : Y ⟶ S` be
weakly étale, surjective and quasi-compact, `ℤ_ℓ ⊆ R ⊆ E` a principal ideal domain (typically
`𝒪_E`), `M` a finitely generated `R`-module with its module topology and
`ψ_U : C(U, M) → (p^* F)(U)` natural `C(U, R)`-semilinear maps. If `ℚ̄_ℓ ⊗_R C(U, M) → (p^* F)(U)`,
`c ⊗ m ↦ c • ψ(m)`, is bijective for every affine `U`, then `F` is lisse. -/
theorem IsAdicLisseSheaf.of_bijective_tensorSections {l : ℕ} [Fact l.Prime] {S Y : Scheme.{u}}
    (p : Y ⟶ S) [WeaklyEtale p] [Surjective p] [QuasiCompact p] {F : AdicSheaf l S}
    {R : Type} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [TopologicalSpace R]
    [IsTopologicalRing R] [Algebra R (PadicAlgCl l)] [FaithfulSMul R (PadicAlgCl l)]
    (hι : Continuous (algebraMap R (PadicAlgCl l))) {E : IntermediateField ℚ_[l] (PadicAlgCl l)}
    [FiniteDimensional ℚ_[l] E] (hιE : ∀ x, algebraMap R (PadicAlgCl l) x ∈ E)
    {κ : ℤ_[l] →+* R} (hκ : Continuous κ)
    (hικ : ∀ z, algebraMap R (PadicAlgCl l) (κ z) = algebraMap ℚ_[l] _ (PadicInt.Coe.ringHom z))
    {M : Type} [AddCommGroup M] [Module R M] [Module.Finite R M] [TopologicalSpace M]
    [IsTopologicalAddGroup M] [ContinuousSMul R M] [IsModuleTopology R M]
    (ψ : ∀ U : Y.ProEt, C(U.left, M) →+ ((p)^*ᵃ[l].obj F).X.obj.obj (op U))
    (hψ : ∀ ⦃U V : Y.ProEt⦄ (f : V ⟶ U) (m : C(U.left, M)),
      ψ V (m.comp f.left.base.hom) = ((p)^*ᵃ[l].obj F).X.obj.map f.op (ψ U m))
    (hψι : ∀ (U : Y.ProEt) (g : C(U.left, R)) (m : C(U.left, M)),
      ψ U (g • m) = sectionAct _ (ULift.up (ringValuedFunction _ hι hιE g)) (ψ U m))
    (hbij : ∀ (U : Y.ProEt) [IsAffine U.left],
      Function.Bijective (tensorSections _ hι hιE ψ hψι U)) :
    IsAdicLisseSheaf F := by
  refine IsAdicLisseSheaf.of_lattice_tensor p (algebraMap R _) hι
    (FaithfulSMul.algebraMap_injective R _) hιE ψ hψ hψι
    (fun U _ x ↦ exists_sum_of_surjective_tensorSections _ hι hιE ψ hψι U (hbij U).2 x)
    (fun U _ x ↦ (tensorEval x).toAddMonoidHom.comp
      (AddEquiv.ofBijective _ (hbij U)).symm.toAddMonoidHom)
    (fun U _ m x ↦ ?_) (fun U _ x a t ha ↦ ?_)
  · have h1 : (AddEquiv.ofBijective _ (hbij U)).symm (ψ U m) = 1 ⊗ₜ m := by
      rw [AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, tensorSections_tmul]
      exact (one_smul _ _).symm
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom, h1,
      LinearMap.toAddMonoidHom_coe, tensorEval_tmul]
  · obtain ⟨A, hA₁, hA₂⟩ := exists_sectionAct_tensorSections _ hι hιE ψ hψι hκ hικ U a ha
    obtain ⟨τ, rfl⟩ := (hbij U).2 t
    have h2 (σ) : (AddEquiv.ofBijective _ (hbij U)).symm (tensorSections _ hι hιE ψ hψι U σ) =
        σ := (AddEquiv.ofBijective _ (hbij U)).symm_apply_apply σ
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom,
      LinearMap.toAddMonoidHom_coe, hA₁, h2, hA₂]

end AlgebraicGeometry.ProEtale
