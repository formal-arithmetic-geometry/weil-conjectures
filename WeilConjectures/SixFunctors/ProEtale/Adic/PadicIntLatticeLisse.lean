module

public import WeilConjectures.SixFunctors.ProEtale.Adic.Constructible
public import WeilConjectures.SixFunctors.ProEtale.Adic.PadicIntModuleUpperStar

/-!
# Rationalisations of `ℓ`-adic towers are lisse

Let `(Gₙ)` be a tower of `ℤ_ℓ,X`-modules on `X_proét` whose transitions are cokernels of `ℓⁿ`
(`Gₙ₊₁/ℓⁿ ≅ Gₙ`) and whose underlying abelian sheaves are locally isomorphic to `(ℤ/ℓⁿ)_X^r`.
Then the `ℓ`-adic sheaf `ℚ̄_ℓ ⊗_{ℤ_ℓ} lim Gₙ` is lisse
(`AlgebraicGeometry.ProEtale.isAdicLisseSheaf_adicSheafExtendScalars_limit`):

1. the lattice `lim Gₙ` is pro-étale locally isomorphic to `ℤ_ℓ,X^r` as an abelian sheaf
   (`AlgebraicGeometry.ProEtale.exists_cover_nonempty_iso_padicIntAbSheaf_pow_of_isColimit`),
   over the members `W` of a cover; the isomorphism over the slice `X_proét / W` is an
   isomorphism of the pullbacks to `W_proét`
   (`AlgebraicGeometry.ProEtale.localizationRestrictionIsoOfOverPullbackIso`);
2. such an isomorphism is automatically `ℤ_ℓ`-linear
   (`AlgebraicGeometry.ProEtale.modIsoBiproductRegularOfIso`);
3. extension of scalars commutes with the pullback and sends `ℤ_ℓ,W` to `ℚ̄_ℓ,W`
   (`AlgebraicGeometry.ProEtale.adicUpperStarAdicSheafExtendScalarsIso`).
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory MonObj Limits Opposite

namespace AlgebraicGeometry.ProEtale

open Scheme

attribute [local instance] Sheaf.monoidalCategory Abelian.hasFiniteBiproducts

variable {X : Scheme.{u}}

/-- For `W : X_proét`, the localization functor `W_proét ⥤ X_proét` factors through the slice
`X_proét / W`. -/
noncomputable def ProEt.localizationToOver (W : X.ProEt) :
    W.left.ProEt ⥤ Over W where
  obj T := Over.mk (MorphismProperty.Over.homMk T.hom rfl trivial :
    (MorphismProperty.Over.map ⊤ W.prop).obj T ⟶ W)
  map {T T'} φ := Over.homMk
    (U := Over.mk (MorphismProperty.Over.homMk T.hom rfl trivial :
      (MorphismProperty.Over.map ⊤ W.prop).obj T ⟶ W))
    (V := Over.mk (MorphismProperty.Over.homMk T'.hom rfl trivial :
      (MorphismProperty.Over.map ⊤ W.prop).obj T' ⟶ W))
    ((MorphismProperty.Over.map ⊤ W.prop).map φ) (by
      ext
      exact MorphismProperty.Over.w φ)

/-- An isomorphism of the restrictions of two sheaves to the slice over `W : X_proét` is an
isomorphism of their restrictions along the localization functor `W_proét ⥤ X_proét`. -/
noncomputable def localizationRestrictionIsoOfOverPullbackIso {A : Type*} [Category.{u + 1} A]
    {W : X.ProEt} {F G : Sheaf (ProEt.topology X) A}
    (e : ((ProEt.topology X).overPullback A W).obj F ≅
      ((ProEt.topology X).overPullback A W).obj G) :
    (localizationRestriction A W.hom W.prop).obj F ≅
      (localizationRestriction A W.hom W.prop).obj G :=
  (fullyFaithfulSheafToPresheaf _ _).preimageIso
    (Functor.isoWhiskerLeft (ProEt.localizationToOver W).op ((sheafToPresheaf _ _).mapIso e))

variable (l : ℕ) [Fact l.Prime]

/-- **Additive isomorphisms onto `ℤ_ℓ^r` are `ℤ_ℓ`-linear**: an isomorphism of abelian sheaves
from a `ℤ_ℓ,Y`-module `M` to `ℤ_ℓ,Y^r` is an isomorphism of modules, `ℤ_ℓ,Y` being generated by
the integers modulo `ℓⁿ` and `ℤ_ℓ,Y^r` being `ℓ`-adically separated. -/
noncomputable def modIsoBiproductRegularOfIso {Y : Scheme.{u}} {r : ℕ}
    (M : Mod (Sheaf (ProEt.topology Y) Ab.{u + 1}) (padicIntAbSheaf Y l))
    (α : M.X ≅ ⨁ fun _ : Fin r ↦ padicIntAbSheaf Y l) :
    M ≅ ⨁ fun _ : Fin r ↦ Mod.regular (padicIntAbSheaf Y l) :=
  Mod.isoMk (α ≪≫ ((Mod.forget (padicIntAbSheaf Y l)).mapBiproduct
      (fun _ : Fin r ↦ Mod.regular (padicIntAbSheaf Y l))).symm)
    (Mod.act_comp_eq_of_epi _ (fun k : ℕ × Fin r ↦ ((l ^ k.1 : ℕ) : ℤ))
      (fun _ ↦ Functor.map_epi (tensorRight M.X) _)
      (fun k ↦ ((Mod.forget (padicIntAbSheaf Y l)).mapBiproduct
        (fun _ : Fin r ↦ Mod.regular (padicIntAbSheaf Y l))).hom ≫ biproduct.π _ k.2 ≫
          padicIntAbSheafToZModPow Y l k.1)
      (fun k ↦ by
        have : ((l ^ k.1 : ℕ) : ℤ) • padicIntAbSheafToZModPow Y l k.1 = 0 := by
          rw [← Category.comp_id (padicIntAbSheafToZModPow Y l k.1), ← Preadditive.comp_zsmul,
            zsmul_id_zmodPowAbSheafDiagram_obj, comp_zero]
        rw [← Preadditive.comp_zsmul, ← Preadditive.comp_zsmul, this, comp_zero, comp_zero])
      (fun f hf ↦ by
        rw [← cancel_mono ((Mod.forget (padicIntAbSheaf Y l)).mapBiproduct
          (fun _ : Fin r ↦ Mod.regular (padicIntAbSheaf Y l))).hom, zero_comp]
        exact eq_zero_of_comp_padicIntAbSheafToZModPow_eq_zero Y l _ fun n i ↦
          hf (n, i)))

section

attribute [local instance] preservesBinaryBiproducts_of_preservesBinaryCoproducts

/-- Extension of scalars to `ℓ`-adic sheaves is a left adjoint. -/
instance (Y : Scheme.{u}) : (adicSheafExtendScalars Y l).IsLeftAdjoint :=
  (adicSheafExtendScalarsRestrictAdjunction Y l).isLeftAdjoint

/-- Extension of scalars to `ℓ`-adic sheaves is additive, being a left adjoint. -/
instance (Y : Scheme.{u}) : (adicSheafExtendScalars Y l).Additive :=
  Functor.additive_of_preservesBinaryBiproducts _

end

/-- **A `ℤ_ℓ,X`-module locally isomorphic to `ℤ_ℓ^r` has lisse rationalisation, locally**: if the
underlying abelian sheaf of `M` is isomorphic to `ℤ_ℓ,X^r` over `W : X_proét`, then the pullback
of `ℚ̄_ℓ ⊗ M` to `W` is `ℚ̄_ℓ,W^r`. -/
noncomputable def adicUpperStarAdicSheafExtendScalarsIso {r : ℕ} (W : X.ProEt)
    (M : Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (padicIntAbSheaf X l))
    (e : ((ProEt.topology X).overPullback Ab.{u + 1} W).obj M.X ≅
      ((ProEt.topology X).overPullback Ab.{u + 1} W).obj
        (⨁ fun _ : Fin r ↦ padicIntAbSheaf X l)) :
    (W.hom)^*ᵃ[l].obj ((adicSheafExtendScalars X l).obj M) ≅
      ⨁ fun _ : Fin r ↦ AdicSheaf.unit l W.left :=
  haveI : WeaklyEtale W.hom := W.prop
  ((padicIntModUpperStarCompAdicSheafExtendScalarsIso l W.hom).app M).symm ≪≫
    (adicSheafExtendScalars W.left l).mapIso (modIsoBiproductRegularOfIso l _
      ((upperStarIsoLocalizationRestriction Ab.{u + 1} W.hom W.prop).app _ ≪≫
        localizationRestrictionIsoOfOverPullbackIso e ≪≫
        ((upperStarIsoLocalizationRestriction Ab.{u + 1} W.hom W.prop).app _).symm ≪≫
        (W.hom)^*[Ab.{u + 1}].mapBiproduct _ ≪≫
        biproduct.mapIso fun _ ↦ asIso (upperStarPadicIntAbSheafHom l W.hom))) ≪≫
    (adicSheafExtendScalars W.left l).mapBiproduct _ ≪≫
    biproduct.mapIso fun _ ↦ adicSheafExtendScalarsRegularIso l W.left

variable (X) in
/-- **The rationalisation of an `ℓ`-adic tower of rank `r` is lisse.** Let `(Gₙ)` be a tower of
`ℤ_ℓ,X`-modules on `X_proét` whose transitions are cokernels of `ℓⁿ` (`Gₙ₊₁/ℓⁿ ≅ Gₙ`) and whose
underlying abelian sheaves are each locally isomorphic to `(ℤ/ℓⁿ)_X^r`. Then the extension of
scalars `ℚ̄_ℓ ⊗_{ℤ_ℓ} lim Gₙ` is a lisse `ℓ`-adic sheaf: the lattice `lim Gₙ` is locally
`ℤ_ℓ,X^r`, as an abelian sheaf (`ProEtale.exists_cover_nonempty_iso_padicIntAbSheaf_pow`) hence
as a module (`ProEtale.modIsoBiproductRegularOfIso`), and extension of scalars commutes with
the pullback (`ProEtale.padicIntModUpperStarCompAdicSheafExtendScalarsIso`). -/
theorem isAdicLisseSheaf_adicSheafExtendScalars_limit (r : ℕ)
    (G : ℕᵒᵖ ⥤ Mod (Sheaf (ProEt.topology X) Ab.{u + 1}) (padicIntAbSheaf X l))
    (hG : ∀ n : ℕ, ∃ w : (((l ^ n : ℕ) : ℤ) • 𝟙 _) ≫
        (G ⋙ Mod.forget _).map (homOfLE n.le_succ).op = 0,
      Nonempty (IsColimit (CokernelCofork.ofπ _ w)))
    (hloc : ∀ (n : ℕ) (V : X.ProEt), ∃ S ∈ ProEt.topology X V,
      ∀ ⦃Y : X.ProEt⦄ (f : Y ⟶ V), S f →
        Nonempty ((isoPresheaf ((zmodPowAbSheafDiagramPow X l r).obj (op n))
          ((G ⋙ Mod.forget _).obj (op n))).obj (op Y))) :
    IsAdicLisseSheaf ((adicSheafExtendScalars X l).obj (limit G)) := by
  obtain ⟨κ, W, f, hcov, hiso⟩ := exists_cover_nonempty_iso_padicIntAbSheaf_pow_of_isColimit X l r
    (G ⋙ Mod.forget _) hG hloc (ProEt.mk (𝟙 X))
  obtain ⟨R, hR, hle⟩ := ProEt.mem_topology_iff.1 hcov
  refine ⟨R.map (ProEt.forget X ⋙ Over.forget X), ProEt.mem_precoverage_iff.1 hR, ?_⟩
  rintro V _ ⟨hu⟩
  obtain ⟨Z, k, _, ⟨i⟩, rfl⟩ := hle _ _ hu
  have hk : (ProEt.forget X ⋙ Over.forget X).map (k ≫ f i) = k.left ≫ (W i).hom := by
    rw [← MorphismProperty.Over.w (f i), ← Category.assoc]
    exact (Category.comp_id _).symm
  exact ⟨r, ⟨(adicUpperStarCongr l hk).app _ ≪≫ (adicUpperStarComp l k.left (W i).hom).app _ ≪≫
    (k.left)^*ᵃ[l].mapIso (adicUpperStarAdicSheafExtendScalarsIso l (W i) (limit G)
      (((ProEt.topology X).overPullback Ab.{u + 1} (W i)).mapIso
        (preservesLimitIso (Mod.forget _) G) ≪≫ (hiso i).some)) ≪≫
    (k.left)^*ᵃ[l].mapBiproduct _ ≪≫ biproduct.mapIso fun _ ↦ adicUpperStarUnitIso l k.left⟩⟩

end AlgebraicGeometry.ProEtale
