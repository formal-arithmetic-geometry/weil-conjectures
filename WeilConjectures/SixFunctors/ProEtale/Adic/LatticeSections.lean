module

public import WeilConjectures.CategoryTheory.RingObjects.EllAdic
public import WeilConjectures.SixFunctors.ProEtale.Adic.ConstantSheafColimit
public import WeilConjectures.LinearAlgebra.FreeModule.TorsionCoordinates
public import WeilConjectures.SixFunctors.ProEtale.Adic.FreeSections
public import WeilConjectures.SixFunctors.ProEtale.Comparison.Continuity

/-!
# `ℓ`-adic sheaves generated by a lattice

Let `R` be a topological ring with a continuous embedding `ι : R → ℚ̄_ℓ` into a finite
subextension `E ⊆ ℚ̄_ℓ` (typically `R = 𝒪_E`), and `M` a topological `R`-module (typically a
finitely generated `𝒪_E`-module with its `ℓ`-adic topology). Let `F` be a sheaf of
`ℚ̄_ℓ,X`-modules and `ψ_U : C(U, M) → F(U)` additive maps, natural in `U` and semilinear:
`ψ(g • m) = ι(g) • ψ(m)` for `g ∈ C(U, R)`.

*Lattice data* for `M` of rank `r` is a family `b₁, …, bᵣ` of elements of `M`, continuous
coordinate functions `c₁, …, cᵣ : M → R` and `d ∈ R` with `ι(d) ≠ 0` such that
`d • (m - ∑ cᵢ(m) bᵢ) = 0`; a finitely generated module over a principal ideal domain, with its
module topology, has such data with `bᵢ` a basis modulo torsion
(`IsModuleTopology.exists_coord_smul_sub_sum_eq_zero`). Then, `ι(d)` being invertible in
`ℚ̄_ℓ`, the torsion part dies and `ψ(m) = ∑ ι(cᵢ ∘ m) • sᵢ` for the global sections `sᵢ = ψ(bᵢ)`
(`AlgebraicGeometry.ProEtale.AdicSheaf.lattice_eq_sum`). Consequently, if `F` is locally
generated over `ℚ̄_ℓ,X` by the image of `ψ` and `(aᵢ) ↦ ∑ aᵢ • sᵢ` is injective on sections,
then `F ≅ ℚ̄_ℓ,Xʳ` (`AlgebraicGeometry.ProEtale.AdicSheaf.isIso_ofSections_of_lattice`,
`AlgebraicGeometry.ProEtale.AdicSheaf.nonempty_iso_of_lattice`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

attribute [local instance] Abelian.hasFiniteBiproducts

namespace AlgebraicGeometry.ProEtale.AdicSheaf

open PadicAlgCl

variable {l : ℕ} [Fact l.Prime] {X : Scheme.{u}}
  {R : Type} [CommRing R] [TopologicalSpace R] (ι : R →+* PadicAlgCl l) (hι : Continuous ι)
  {E : IntermediateField ℚ_[l] (PadicAlgCl l)} [FiniteDimensional ℚ_[l] E] (hιE : ∀ x, ι x ∈ E)

include hι hιE in
/-- The locally finite function `ι ∘ g` attached to a continuous `R`-valued function `g`. -/
noncomputable def ringValuedFunction {T : Type*} [TopologicalSpace T] (g : C(T, R)) :
    locallyFiniteFunctions l T :=
  ⟨⟨ι ∘ g, hι.comp g.continuous⟩,
    finiteIntermediateFieldValued_le_locallyFiniteFunctions l T
      ⟨E, inferInstance, fun x ↦ hιE (g x)⟩⟩

variable (F : AdicSheaf l X) {M : Type} [AddCommGroup M] [Module R M] [TopologicalSpace M]
  [IsTopologicalAddGroup M] [ContinuousSMul R M]
  (ψ : ∀ U : X.ProEt, C(U.left, M) →+ F.X.obj.obj (op U))
  (hψ : ∀ ⦃U V : X.ProEt⦄ (f : V ⟶ U) (m : C(U.left, M)),
    ψ V (m.comp f.left.base.hom) = F.X.obj.map f.op (ψ U m))
  (hψι : ∀ (U : X.ProEt) (g : C(U.left, R)) (m : C(U.left, M)),
    ψ U (g • m) = sectionAct F (ULift.up (ringValuedFunction ι hι hιE g)) (ψ U m))
  {r : ℕ} (b : Fin r → M) (c : Fin r → C(M, R)) (d : R) (hd : ι d ≠ 0)
  (hk : ∀ m : M, d • (m - ∑ i, c i m • b i) = 0)

include hψι hd in
/-- A section in the image of `ψ` of a function with values killed by `d` is zero, `ι(d)` being
invertible in `ℚ̄_ℓ`. -/
lemma eq_zero_of_smul_eq_zero {U : X.ProEt} {t : C(U.left, M)} (ht : ∀ x, d • t x = 0) :
    ψ U t = 0 := by
  have h := hψι U (ContinuousMap.const _ d) t
  have h0 : (ContinuousMap.const _ d : C(U.left, R)) • t = 0 := ContinuousMap.ext ht
  rw [h0, map_zero] at h
  have h1 : (ULift.up (ringValuedFunction ι hι hιE (ContinuousMap.const U.left d)) :
      (adicConstantSheaf l X).obj.obj (op U)) = ULift.up (algebraMap _ _ (ι d)) := rfl
  rw [h1, algebraMap_sectionAct F (ULift.up (ι d))] at h
  have hc : (ULift.up (ι d) : ULift.{u + 1} (PadicAlgCl l)) ≠ 0 := fun h0 ↦
    hd (congrArg ULift.down h0)
  exact ((smul_eq_zero.1 h.symm).resolve_left hc)

include hψ hψι hk hd in
/-- **The image of a lattice**: `ψ(m) = ∑ ι(cᵢ ∘ m) • sᵢ|_U` for the global sections
`sᵢ = ψ(bᵢ)`, the torsion part `m - ∑ (cᵢ ∘ m) bᵢ` being killed by `d`. -/
lemma lattice_eq_sum (U : X.ProEt) (m : C(U.left, M)) :
    ψ U m = ∑ i, sectionAct F (ULift.up (ringValuedFunction ι hι hιE ((c i).comp m)))
      (restrictTop F (ψ (proEtTop X) (ContinuousMap.const _ (b i))) (op U)) := by
  have hb (i : Fin r) : ψ U (ContinuousMap.const _ (b i)) =
      restrictTop F (ψ (proEtTop X) (ContinuousMap.const _ (b i))) (op U) :=
    hψ (toProEtTop U) (ContinuousMap.const _ (b i))
  have ht : ψ U (m - ∑ i, ((c i).comp m) • ContinuousMap.const _ (b i)) = 0 := by
    refine eq_zero_of_smul_eq_zero ι hι hιE F ψ hψι d hd fun x ↦ ?_
    simpa [ContinuousMap.smul_apply'] using hk (m x)
  rw [map_sub, sub_eq_zero, map_sum] at ht
  rw [ht]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [hψι, hb]

include hψ hψι hk hd in
/-- **An `ℓ`-adic sheaf generated by a lattice of rank `r` is `ℚ̄_ℓ,Xʳ`**: if `F` is locally
generated over `ℚ̄_ℓ,X` by the image of the semilinear maps `ψ_U : C(U, M) → F(U)`, and the
sections `sᵢ = ψ(bᵢ)` are linearly independent over `ℚ̄_ℓ,X(U)` for every `U`, then
`(aᵢ) ↦ ∑ aᵢ • sᵢ` is an isomorphism `ℚ̄_ℓ,Xʳ ≅ F`. -/
theorem isIso_ofSections_of_lattice
    (hinj : ∀ U, Function.Injective (sectionsLinearMap F
      (fun i ↦ ψ (proEtTop X) (ContinuousMap.const _ (b i))) U))
    (hgen : ∀ (U : X.ProEt) (x : F.X.obj.obj (op U)), ∃ S ∈ Scheme.ProEt.topology X U,
      ∀ ⦃V : X.ProEt⦄ (f : V ⟶ U), S f → ∃ (n : ℕ)
        (a : Fin n → (adicConstantSheaf l X).obj.obj (op V)) (m : Fin n → C(V.left, M)),
          F.X.obj.map f.op x = ∑ j, sectionAct F (a j) (ψ V (m j))) :
    IsIso (ofSections F (fun i ↦ ψ (proEtTop X) (ContinuousMap.const _ (b i)))) := by
  refine isIso_ofSections_of_injective F _ hinj fun U x ↦ ?_
  obtain ⟨S, hS, h⟩ := hgen U x
  refine ⟨S, hS, fun V f hf ↦ ?_⟩
  obtain ⟨n, a, m, hx⟩ := h f hf
  let g (i : Fin r) (j : Fin n) : (adicConstantSheaf l X).obj.obj (op V) :=
    ULift.up (ringValuedFunction ι hι hιE ((c i).comp (m j)))
  refine ⟨fun i ↦ ∑ j, ULift.up ((a j).down * (g i j).down), ?_⟩
  have h1 (j : Fin n) : sectionAct F (a j) (ψ V (m j)) = ∑ i, sectionAct F
      (ULift.up ((a j).down * (g i j).down))
      (restrictTop F (ψ (proEtTop X) (ContinuousMap.const _ (b i))) (op V)) := by
    rw [lattice_eq_sum ι hι hιE F ψ hψ hψι b c d hd hk, sectionAct_sum]
    exact Finset.sum_congr rfl fun i _ ↦ (mul_sectionAct F (a j) (g i j) _).symm
  rw [hx, sectionsLinearMap_apply, Finset.sum_congr rfl fun j _ ↦ h1 j, Finset.sum_comm]
  exact Finset.sum_congr rfl fun i _ ↦ sum_sectionAct F _ _ _

omit hk in
include hψ hψι in
/-- **An `ℓ`-adic sheaf generated by a finitely generated lattice**: let `M` be a finitely
generated module, with its module topology, over a principal ideal domain `R ⊆ E` (typically
`𝒪_E`), and `ψ_U : C(U, M) → F(U)` natural semilinear maps. If `F` is locally generated over
`ℚ̄_ℓ,X` by the image of `ψ`, and `ψ` maps every basis of `M` modulo torsion to sections which
are linearly independent over `ℚ̄_ℓ,X(U)` for every `U`, then `F ≅ ℚ̄_ℓ,Xʳ` with `r` the rank
of `M`. -/
theorem nonempty_iso_of_lattice [IsDomain R] [IsPrincipalIdealRing R] [IsTopologicalRing R]
    [Module.Finite R M] [IsModuleTopology R M] (hιinj : Function.Injective ι)
    (hinj : ∀ b : Fin (Module.finrank R (M ⧸ Submodule.torsion R M)) → M,
      LinearIndependent R ((Submodule.torsion R M).mkQ ∘ b) → ∀ U, Function.Injective
        (sectionsLinearMap F (fun i ↦ ψ (proEtTop X) (ContinuousMap.const _ (b i))) U))
    (hgen : ∀ (U : X.ProEt) (x : F.X.obj.obj (op U)), ∃ S ∈ Scheme.ProEt.topology X U,
      ∀ ⦃V : X.ProEt⦄ (f : V ⟶ U), S f → ∃ (n : ℕ)
        (a : Fin n → (adicConstantSheaf l X).obj.obj (op V)) (m : Fin n → C(V.left, M)),
          F.X.obj.map f.op x = ∑ j, sectionAct F (a j) (ψ V (m j))) :
    Nonempty ((⨁ fun _ : Fin (Module.finrank R (M ⧸ Submodule.torsion R M)) ↦ unit l X) ≅
      F) := by
  obtain ⟨b, c, d, hb, hd, hk⟩ := IsModuleTopology.exists_coord_smul_sub_sum_eq_zero (R := R)
    (M := M)
  have hιd : ι d ≠ 0 := fun h ↦ hd (hιinj (h.trans (map_zero ι).symm))
  have := isIso_ofSections_of_lattice ι hι hιE F ψ hψ hψι b c d hιd hk (hinj b hb) hgen
  exact ⟨asIso (ofSections F fun i ↦ ψ (proEtTop X) (ContinuousMap.const _ (b i)))⟩

omit [FiniteDimensional ℚ_[l] E] in
/-- **Injectivity on quasi-compact objects**: `(aᵢ) ↦ ∑ aᵢ • sᵢ|_U` is injective for every `U`
as soon as it is injective on families of functions with values in finite subextensions of
`ℚ̄_ℓ` over quasi-compact `U`: a locally finite function on `U` is such a function on every
affine open of `U`. -/
lemma sectionsLinearMap_injective_of_compactSpace (s : Fin r → F.X.obj.obj (op (proEtTop X)))
    (h : ∀ (U : X.ProEt) [CompactSpace U.left]
      (a : Fin r → (adicConstantSheaf l X).obj.obj (op U)),
      (∀ i, (a i).down.1 ∈ finiteIntermediateFieldValued l U.left) →
        sectionsLinearMap F s (op U) a = 0 → a = 0) (U : X.ProEtᵒᵖ) :
    Function.Injective (sectionsLinearMap F s U) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  funext i
  refine ULift.ext (Subtype.ext (ContinuousMap.ext fun x ↦ ?_))
  obtain ⟨W, hW, hxW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.1
    U.unop.left.isBasis_affineOpens) (show x ∈ (⊤ : U.unop.left.Opens) from trivial)
  let ιW := overOpensι (P := @WeaklyEtale) (fun _ _ ↦ inferInstance) U.unop W
  have : CompactSpace (overOpens (P := @WeaklyEtale) (fun _ _ ↦ inferInstance) U.unop W).left :=
    isCompact_iff_compactSpace.1 hW.isCompact
  have h0 := h _ (fun i ↦ (adicConstantSheaf l X).obj.map ιW.op (a i))
    (fun i ↦ mem_finiteIntermediateFieldValued_of_mem_locallyFiniteFunctions
      ((adicConstantSheaf l X).obj.map ιW.op (a i)).down.2)
    (by
      rw [← map_sectionsLinearMap]
      change F.X.obj.map ιW.op (sectionsLinearMap F s U a) = 0
      rw [ha, map_zero])
  exact congrArg (fun b ↦ (b i).down.1 ⟨x, hxW⟩) h0

end AlgebraicGeometry.ProEtale.AdicSheaf
