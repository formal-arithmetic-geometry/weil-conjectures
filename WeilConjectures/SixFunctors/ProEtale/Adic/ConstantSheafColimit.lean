module

public import WeilConjectures.CategoryTheory.RingObjects.EllAdic
public import WeilConjectures.SixFunctors.ProEtale.Adic.ConstantSheaf
public import WeilConjectures.SixFunctors.ProEtale.Comparison.Continuity

/-!
# The constant `ℓ`-adic sheaf as the colimit of the sheaves `E_X`

The repository has two constructions of the `ℚ̄_ℓ`-sheaf of Bhatt–Scholze (*The pro-étale
topology for schemes*, §6.8) on the pro-étale site of a scheme `X`:

- `AlgebraicGeometry.ProEtale.adicConstantSheaf`, the sheaf of `ℚ̄_ℓ`-modules of continuous
  functions `U → ℚ̄_ℓ` whose values locally span finite-dimensional `ℚ_ℓ`-subspaces, the
  coefficient ring of the `ℓ`-adic sheaves `AlgebraicGeometry.ProEtale.AdicSheaf`;
- `AlgebraicGeometry.ProEtale.padicAlgClSheaf`, the ring object of abelian sheaves obtained by
  sheafifying the continuous functions with values in a finite subextension `E ⊆ ℚ̄_ℓ`, which
  is the colimit `colim_E E_X` of the sheaves `E_X = C(-, E)`
  (`AlgebraicGeometry.ProEtale.isColimitPadicAlgClSheafCocone`).

This file identifies them: the inclusion of the presheaf of functions with values in a finite
subextension into the sheaf of locally finite functions is locally bijective, since on a
quasi-compact scheme a locally finite function takes values in a finite subextension, so its
sheafification is an isomorphism
(`AlgebraicGeometry.ProEtale.padicAlgClSheafIsoAdicConstantSheaf`). Consequently the abelian
sheaf underlying `ℚ̄_ℓ,X` is `colim_E E_X`
(`AlgebraicGeometry.ProEtale.isColimitAdicConstantSheafCocone`). This is the first step of the
comparison of `ℓ`-adic sheaves with `ℓ`-adic towers of torsion sheaves needed for the
finiteness theorem (`WeilConjectures.SixFunctors.ProEtale.Adic.LowerStar`).
-/

@[expose] public section
universe u

open CategoryTheory Limits Opposite

namespace PadicAlgCl

variable {l : ℕ} [Fact l.Prime] {T : Type*} [TopologicalSpace T]

/-- A continuous function with values in a finite subextension of `ℚ̄_ℓ` is locally finite. -/
lemma mem_locallyFiniteFunctions_of_mem_finiteIntermediateFieldValued {f : C(T, PadicAlgCl l)}
    (hf : f ∈ finiteIntermediateFieldValued l T) : f ∈ locallyFiniteFunctions l T := by
  obtain ⟨E, hE, hfE⟩ := hf
  refine mem_locallyFiniteFunctions_of_finiteDimensional (Submodule.finiteDimensional_of_le
    (S₂ := Subalgebra.toSubmodule E.toSubalgebra) (Submodule.span_le.2 ?_))
  rintro _ ⟨x, rfl⟩
  exact hfE x

/-- On a compact space, a locally finite function takes values in a finite subextension of
`ℚ̄_ℓ`: the span of its values is finite-dimensional, and the subfield generated by a finite
spanning set is a finite extension of `ℚ_ℓ`, `ℚ̄_ℓ` being algebraic over `ℚ_ℓ`. -/
lemma mem_finiteIntermediateFieldValued_of_mem_locallyFiniteFunctions [CompactSpace T]
    {f : C(T, PadicAlgCl l)} (hf : f ∈ locallyFiniteFunctions l T) :
    f ∈ finiteIntermediateFieldValued l T := by
  have hfin := finiteDimensional_span_range_of_mem_locallyFiniteFunctions hf
  obtain ⟨S, hS⟩ := Module.Finite.iff_fg.1 hfin
  refine ⟨IntermediateField.adjoin ℚ_[l] (S : Set (PadicAlgCl l)),
    IntermediateField.finiteDimensional_adjoin fun x _ ↦ Algebra.IsIntegral.isIntegral x,
    fun x ↦ ?_⟩
  have hx : f x ∈ Submodule.span ℚ_[l] (Set.range f) := Submodule.subset_span ⟨x, rfl⟩
  rw [← hS] at hx
  exact (Submodule.span_le.2 (IntermediateField.subset_adjoin ℚ_[l] _) :
    Submodule.span ℚ_[l] (S : Set (PadicAlgCl l)) ≤
      Subalgebra.toSubmodule (IntermediateField.adjoin ℚ_[l] _).toSubalgebra) hx

end PadicAlgCl

namespace AlgebraicGeometry.ProEtale

open PadicAlgCl Scheme

variable (X : Scheme.{u}) (l : ℕ) [Fact l.Prime]


/-- The inclusion of the continuous functions with values in a finite subextension of `ℚ̄_ℓ`
into the locally finite functions. -/
noncomputable def finiteIntermediateFieldValuedToLocallyFiniteFunctions (T : Type*)
    [TopologicalSpace T] :
    finiteIntermediateFieldValued l T →+ locallyFiniteFunctions l T where
  toFun f := ⟨f.1, mem_locallyFiniteFunctions_of_mem_finiteIntermediateFieldValued f.2⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The inclusion of the presheaf of continuous functions with values in a finite
subextension of `ℚ̄_ℓ` into the presheaf of locally finite functions underlying `ℚ̄_ℓ,X`,
as a morphism of abelian presheaves. -/
noncomputable def padicAlgClPresheafToAdicConstantSheaf :
    padicAlgClRingPresheaf X l ⋙ forget₂ RingCat.{u + 1} Ab.{u + 1} ⟶
      (adicConstantSheaf l X).obj ⋙ forget₂ (WeilCoefficients.{u} l) Ab.{u + 1} where
  app U := AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
    ((finiteIntermediateFieldValuedToLocallyFiniteFunctions l U.unop.left).comp
      AddEquiv.ulift.toAddMonoidHom))
  naturality _ _ _ := rfl

/-- The inclusion of the functions with values in a finite subextension of `ℚ̄_ℓ` into the
locally finite functions becomes an isomorphism after sheafification: it is injective, and a
locally finite function takes values in a finite subextension on every affine open. -/
lemma w_padicAlgClPresheafToAdicConstantSheaf :
    (ProEt.topology X).W (padicAlgClPresheafToAdicConstantSheaf X l) := by
  rw [GrothendieckTopology.W_iff_isLocallyBijective]
  refine ⟨Presheaf.isLocallyInjective_of_injective _ _ fun U x y h ↦ ?_,
    ⟨fun {U} s ↦ ?_⟩⟩
  · obtain ⟨x⟩ := x
    obtain ⟨y⟩ := y
    have h' : (x : C(U.unop.left, PadicAlgCl l)) = y := by
      have := congrArg (fun z : ULift.{u + 1} (locallyFiniteFunctions l U.unop.left) ↦
        (z.down : C(U.unop.left, PadicAlgCl l))) h
      exact this
    rw [Subtype.ext h']
  · refine ProEt.mem_topology_of_isOpenImmersion U _
      (fun i : U.left.affineOpens ↦
        overOpens (P := @WeaklyEtale) (fun _ _ ↦ inferInstance) U i.1)
      (fun i ↦ overOpensι (P := @WeaklyEtale) (fun _ _ ↦ inferInstance) U i.1) (fun i ↦ by
        exact inferInstanceAs (IsOpenImmersion i.1.ι)) (fun x ↦ ?_) fun i ↦ ?_
    · obtain ⟨W, hW, hxW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.1
        U.left.isBasis_affineOpens) (show x ∈ (⊤ : U.left.Opens) from trivial)
      exact ⟨⟨W, hW⟩, ⟨x, hxW⟩, rfl⟩
    · have : CompactSpace (i.1 : U.left.Opens) :=
        isCompact_iff_compactSpace.1 i.2.isCompact
      exact ⟨ULift.up ⟨s.down.1.comp i.1.ι.base.hom,
        mem_finiteIntermediateFieldValued_of_mem_locallyFiniteFunctions
          (T := (i.1 : U.left.Opens)) (comp_mem_locallyFiniteFunctions s.down.2 _)⟩, rfl⟩

/-- **`ℚ̄_ℓ,X = colim_E E_X`**: the ring object `ℚ̄_ℓ,X` of abelian sheaves, the
sheafification of the continuous functions with values in finite subextensions of `ℚ̄_ℓ`
(`AlgebraicGeometry.ProEtale.padicAlgClSheaf`), is the abelian sheaf underlying the constant
`ℓ`-adic sheaf `AlgebraicGeometry.ProEtale.adicConstantSheaf` of locally finite functions. -/
noncomputable def padicAlgClSheafIsoAdicConstantSheaf :
    padicAlgClSheaf X l ≅ (sheafCompose (ProEt.topology X)
      (forget₂ (WeilCoefficients.{u} l) Ab.{u + 1})).obj (adicConstantSheaf l X) :=
  have := ((ProEt.topology X).W_iff _).1 (w_padicAlgClPresheafToAdicConstantSheaf X l)
  asIso ((presheafToSheaf _ _).map (padicAlgClPresheafToAdicConstantSheaf X l)) ≪≫
    asIso ((sheafificationAdjunction _ _).counit.app ((sheafCompose (ProEt.topology X)
      (forget₂ (WeilCoefficients.{u} l) Ab.{u + 1})).obj (adicConstantSheaf l X)))

/-- The abelian sheaf underlying the constant `ℓ`-adic sheaf `ℚ̄_ℓ,X` is the colimit of the
sheaves `E_X` of continuous `E`-valued functions over the finite subextensions `E ⊆ ℚ̄_ℓ` of
`ℚ_ℓ` (Bhatt–Scholze, §6.8). -/
noncomputable def isColimitAdicConstantSheafCocone :
    IsColimit ((padicAlgClSheafCocone X l).extend
      (padicAlgClSheafIsoAdicConstantSheaf X l).hom) :=
  IsColimit.extendIso _ (isColimitPadicAlgClSheafCocone X l)

end AlgebraicGeometry.ProEtale
