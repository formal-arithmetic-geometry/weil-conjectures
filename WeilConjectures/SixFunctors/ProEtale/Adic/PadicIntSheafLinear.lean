/-!
# Additive maps of `ℤ_ℓ,X`-modules are `ℤ_ℓ,X`-linear

A morphism of abelian sheaves between two module objects over `ℤ_ℓ,X` (the ring object of
continuous `ℤ_ℓ`-valued functions on `X_proét`) is automatically `ℤ_ℓ,X`-linear as soon as the
target is `ℓ`-adically separated, e.g. a finite free module `ℤ_ℓ,X^r`. This rests on two facts:

* the linearity criterion `CategoryTheory.Mod.act_comp_eq_of_epi`: if the unit `𝟙 ⟶ R` and the
  multiplications by integers `N k` are jointly epimorphic onto `R`, then every morphism into an
  `R`-module separated by maps killed by the `N k` is `R`-linear;
* `ℤ_ℓ,X` is generated by the integers modulo `ℓⁿ`
  (`AlgebraicGeometry.ProEtale.epi_biprodDesc_one_padicIntAbSheaf`): a continuous function to
  `ℤ_ℓ` is locally `k + ℓⁿ g` for an integer `k`
  (`PadicInt.exists_isOpen_eq_intCast_add_pow_mul`), and `ℤ_ℓ,X^r` is `ℓ`-adically separated
  (`AlgebraicGeometry.ProEtale.eq_zero_of_comp_padicIntAbSheafToZModPow_eq_zero`).

To identify the unit of `ℤ_ℓ,X` on sections, we show that the ring object structure of the
abelian sheaf underlying a sheaf of rings is, on presheaves, the ring structure of the sections
(`CategoryTheory.Sheaf.μ_sheafToPresheaf_comp_map_mul_sheafCompose`,
`CategoryTheory.Sheaf.ε_sheafToPresheaf_comp_map_one_sheafCompose`), and that it is compatible
with pushforwards (`CategoryTheory.Sheaf.monObjObj_sheafPushforwardContinuous_eq`).
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory MonObj Limits Opposite

namespace CategoryTheory.Mod

variable {C : Type*} [Category* C] [MonoidalCategory C] [Preadditive C] [MonoidalPreadditive C]
  [HasBinaryBiproducts C] {R : C} [MonObj R]

end CategoryTheory.Mod

namespace CategoryTheory.Sheaf

universe w

variable {C : Type*} [Category* C] (J : GrothendieckTopology C) [HasWeakSheafify J Ab.{w}]
  [(J.W (A := Ab.{w})).IsMonoidal] [J.HasSheafCompose (forget₂ RingCat.{w} Ab.{w})]
  (S : Sheaf J RingCat.{w})

attribute [local instance] Sheaf.monoidalCategory Sheaf.braidedCategory

open Functor.LaxMonoidal Functor.OplaxMonoidal

omit [(J.W (A := Ab.{w})).IsMonoidal] in
/-- The underlying morphism of presheaves of the inverse of `Sheaf.sheafifyRingPresheafIso` is
the unit of the sheafification adjunction. -/
lemma sheafToPresheaf_map_sheafifyRingPresheafIso_inv :
    (sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).inv =
      (sheafificationAdjunction J Ab.{w}).unit.app (S.obj ⋙ forget₂ RingCat.{w} Ab.{w}) := by
  rw [← cancel_mono ((sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).hom),
    ← Functor.map_comp, Iso.inv_hom_id, Functor.map_id]
  exact ((sheafificationAdjunction J Ab.{w}).right_triangle_components _).symm

/-- The multiplication of the ring object of abelian sheaves underlying a sheaf of rings `S`,
read on presheaves through the tensor map of `sheafToPresheaf`, is the multiplication of the
presheaf of rings `S`. -/
lemma μ_sheafToPresheaf_comp_map_mul_sheafCompose :
    Functor.LaxMonoidal.μ (sheafToPresheaf J Ab.{w})
        ((sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S)
        ((sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S) ≫
      (sheafToPresheaf J Ab.{w}).map μ[(sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S] =
    μ[S.obj ⋙ forget₂ RingCat.{w} Ab.{w}] := by
  let adj := sheafificationAdjunction J Ab.{w}
  have h := adj.unit_app_tensor_comp_map_δ (S.obj ⋙ forget₂ RingCat.{w} Ab.{w})
    (S.obj ⋙ forget₂ RingCat.{w} Ab.{w})
  have he : adj.unit.app (S.obj ⋙ forget₂ RingCat.{w} Ab.{w}) ≫
      (sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).hom = 𝟙 _ :=
    adj.right_triangle_components _
  erw [MonObj.ofIso_mul, Functor.obj.μ_def]
  rw [Functor.map_comp, ← μ_natural_assoc,
    sheafToPresheaf_map_sheafifyRingPresheafIso_inv,
    Functor.map_comp, Functor.map_comp, ← reassoc_of% h, Category.assoc,
    ← Functor.map_comp_assoc,
    Functor.Monoidal.δ_μ, Functor.map_id, Category.id_comp]
  erw [← adj.unit.naturality_assoc, he, Category.comp_id]
  rfl

variable {J} {D : Type*} [Category* D] {K : GrothendieckTopology D} (F : C ⥤ D)
  [F.IsContinuous J K] [HasWeakSheafify K Ab.{w}] [(K.W (A := Ab.{w})).IsMonoidal]
  [K.HasSheafCompose (forget₂ RingCat.{w} Ab.{w})] (S : Sheaf K RingCat.{w})

/-- The ring object structure on the pushforward `F_* S` of the abelian sheaf underlying a
sheaf of rings `S`, induced by the lax monoidal pushforward `F_*`, is the ring object structure
of the abelian sheaf underlying the pushforward `F_* S` of the sheaf of rings. -/
lemma monObjObj_sheafPushforwardContinuous_eq :
    (F.sheafPushforwardContinuous Ab.{w} J K).monObjObj
        ((sheafCompose K (forget₂ RingCat.{w} Ab.{w})).obj S) =
      monObj_sheafCompose_obj J ((F.sheafPushforwardContinuous RingCat.{w} J K).obj S) := by
  refine MonObj.ext _ _ (Sheaf.hom_ext_of_μ_comp ?_)
  have h₁ := μ_sheafToPresheaf_comp_map_mul_sheafCompose J
    ((F.sheafPushforwardContinuous RingCat.{w} J K).obj S)
  have h₂ := μ_sheafToPresheaf_comp_map_mul_sheafCompose K S
  have h₃ := Functor.μ_sheafToPresheaf_comp_map_μ_sheafPushforwardContinuous F Ab.{w} J K
    ((sheafCompose K (forget₂ RingCat.{w} Ab.{w})).obj S)
    ((sheafCompose K (forget₂ RingCat.{w} Ab.{w})).obj S)
  erw [h₁, Functor.map_comp, reassoc_of% h₃]
  erw [← Functor.map_comp, h₂]
  rfl

end CategoryTheory.Sheaf

