module

public import WeilConjectures.CategoryTheory.ModuleObjects.Preadditive
public import WeilConjectures.CategoryTheory.Sites.PushforwardMonoidal
public import WeilConjectures.SixFunctors.ProEtale.Adic.PadicIntAbSheafPowLocal
public import WeilConjectures.SixFunctors.ProEtale.Adic.ProEtOpenCover

/-!
# Additive maps of `ℤ_ℓ,X`-modules are `ℤ_ℓ,X`-linear

A morphism of abelian sheaves between two module objects over `ℤ_ℓ,X` (the ring object of
continuous `ℤ_ℓ`-valued functions on `X_proét`) is automatically `ℤ_ℓ,X`-linear as soon as the
target is `ℓ`-adically separated, e.g. a finite free module `ℤ_ℓ,X^r`. This rests on two facts:

* the linearity criterion `CategoryTheory.Mod.act_comp_eq_of_epi`: if the unit `𝟙 ⟶ R` and the
  multiplications by integers `N k` are jointly epimorphic onto `R`, then every morphism into an
  `R`-module separated by maps killed by the `N k` is `R`-linear;
* `ℤ_ℓ,X` is generated by the integers modulo `ℓⁿ`
  (`AlgebraicGeometry.ProEtale.epi_biprodDesc_one_padicIntAbSheaf`): a continuous function to
  `ℤ_ℓ` is locally `k + ℓⁿ g` for an integer `k`
  (`PadicInt.exists_isOpen_eq_intCast_add_pow_mul`), and `ℤ_ℓ,X^r` is `ℓ`-adically separated
  (`AlgebraicGeometry.ProEtale.eq_zero_of_comp_padicIntAbSheafToZModPow_eq_zero`).

To identify the unit of `ℤ_ℓ,X` on sections, we show that the ring object structure of the
abelian sheaf underlying a sheaf of rings is, on presheaves, the ring structure of the sections
(`CategoryTheory.Sheaf.μ_sheafToPresheaf_comp_map_mul_sheafCompose`,
`CategoryTheory.Sheaf.ε_sheafToPresheaf_comp_map_one_sheafCompose`), and that it is compatible
with pushforwards (`CategoryTheory.Sheaf.monObjObj_sheafPushforwardContinuous_eq`).
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory MonObj Limits Opposite

namespace CategoryTheory.Mod

variable {C : Type*} [Category* C] [MonoidalCategory C] [Preadditive C] [MonoidalPreadditive C]
  [HasBinaryBiproducts C] {R : C} [MonObj R]

/-- **Linearity criterion.** Let `R` be a monoid object and `M`, `T` two `R`-modules. Suppose
that, for integers `N k`, the unit `𝟙 ⟶ R` and the multiplication by `N k` are jointly
epimorphic after tensoring with `M` (`R` is generated by the integers modulo `N k`), and that
`T` is separated for the maps `π n : T ⟶ T' n` killed by `N k`. Then every morphism `M ⟶ T` is
`R`-linear. -/
lemma act_comp_eq_of_epi {M T : Mod C R} (φ : M.X ⟶ T.X) {κ : Type*} (N : κ → ℤ)
    (hR : ∀ k, Epi (biprod.desc η[R] (N k • 𝟙 R) ▷ M.X))
    {T' : κ → C} (π : ∀ k, T.X ⟶ T' k) (hπ : ∀ k, N k • π k = 0)
    (hsep : ∀ {Z : C} (f : Z ⟶ T.X), (∀ k, f ≫ π k = 0) → f = 0) :
    act M.X ≫ φ = R ◁ φ ≫ act T.X := by
  have h₁ : η[R] ▷ M.X ≫ (act M.X ≫ φ - R ◁ φ ≫ act T.X) = 0 := by
    rw [Preadditive.comp_sub, one_act_assoc, ← whisker_exchange_assoc, one_act,
      leftUnitor_naturality, sub_self]
  rw [← sub_eq_zero]
  refine hsep _ fun n ↦ ?_
  have := hR n
  rw [← cancel_epi (biprod.desc η[R] (N n • 𝟙 R) ▷ M.X), comp_zero, biprod.desc_eq,
    MonoidalPreadditive.add_whiskerRight, comp_whiskerRight, comp_whiskerRight,
    Preadditive.add_comp, Category.assoc, Category.assoc, reassoc_of% h₁, zsmul_whiskerRight,
    id_whiskerRight, Preadditive.zsmul_comp, Category.id_comp, ← Preadditive.comp_zsmul,
    hπ n]
  simp

end CategoryTheory.Mod

namespace CategoryTheory.Sheaf

universe w

variable {C : Type*} [Category* C] (J : GrothendieckTopology C) [HasWeakSheafify J Ab.{w}]
  [(J.W (A := Ab.{w})).IsMonoidal] [J.HasSheafCompose (forget₂ RingCat.{w} Ab.{w})]
  (S : Sheaf J RingCat.{w})

attribute [local instance] Sheaf.monoidalCategory Sheaf.braidedCategory

open Functor.LaxMonoidal Functor.OplaxMonoidal

omit [(J.W (A := Ab.{w})).IsMonoidal] in
/-- The underlying morphism of presheaves of the inverse of `Sheaf.sheafifyRingPresheafIso` is
the unit of the sheafification adjunction. -/
lemma sheafToPresheaf_map_sheafifyRingPresheafIso_inv :
    (sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).inv =
      (sheafificationAdjunction J Ab.{w}).unit.app (S.obj ⋙ forget₂ RingCat.{w} Ab.{w}) := by
  rw [← cancel_mono ((sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).hom),
    ← Functor.map_comp, Iso.inv_hom_id, Functor.map_id]
  exact ((sheafificationAdjunction J Ab.{w}).right_triangle_components _).symm

/-- The multiplication of the ring object of abelian sheaves underlying a sheaf of rings `S`,
read on presheaves through the tensor map of `sheafToPresheaf`, is the multiplication of the
presheaf of rings `S`. -/
lemma μ_sheafToPresheaf_comp_map_mul_sheafCompose :
    Functor.LaxMonoidal.μ (sheafToPresheaf J Ab.{w})
        ((sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S)
        ((sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S) ≫
      (sheafToPresheaf J Ab.{w}).map μ[(sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S] =
    μ[S.obj ⋙ forget₂ RingCat.{w} Ab.{w}] := by
  let adj := sheafificationAdjunction J Ab.{w}
  have h := adj.unit_app_tensor_comp_map_δ (S.obj ⋙ forget₂ RingCat.{w} Ab.{w})
    (S.obj ⋙ forget₂ RingCat.{w} Ab.{w})
  have he : adj.unit.app (S.obj ⋙ forget₂ RingCat.{w} Ab.{w}) ≫
      (sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).hom = 𝟙 _ :=
    adj.right_triangle_components _
  erw [MonObj.ofIso_mul, Functor.obj.μ_def]
  rw [Functor.map_comp, ← μ_natural_assoc,
    sheafToPresheaf_map_sheafifyRingPresheafIso_inv,
    Functor.map_comp, Functor.map_comp, ← reassoc_of% h, Category.assoc,
    ← Functor.map_comp_assoc,
    Functor.Monoidal.δ_μ, Functor.map_id, Category.id_comp]
  erw [← adj.unit.naturality_assoc, he, Category.comp_id]
  rfl

/-- The unit of the ring object of abelian sheaves underlying a sheaf of rings `S`, read on
presheaves through the unit map of `sheafToPresheaf`, is the unit of the presheaf of rings
`S`. -/
lemma ε_sheafToPresheaf_comp_map_one_sheafCompose :
    ε (sheafToPresheaf J Ab.{w}) ≫
      (sheafToPresheaf J Ab.{w}).map η[(sheafCompose J (forget₂ RingCat.{w} Ab.{w})).obj S] =
    η[S.obj ⋙ forget₂ RingCat.{w} Ab.{w}] := by
  let adj := sheafificationAdjunction J Ab.{w}
  have h := adj.unit_app_unit_comp_map_η
  have he : adj.unit.app (S.obj ⋙ forget₂ RingCat.{w} Ab.{w}) ≫
      (sheafToPresheaf J Ab.{w}).map (sheafifyRingPresheafIso J S).hom = 𝟙 _ :=
    adj.right_triangle_components _
  erw [MonObj.ofIso_one, Functor.obj.η_def]
  simp only [Functor.map_comp, Category.assoc]
  rw [← h, Category.assoc, ← Functor.map_comp_assoc,
    Functor.Monoidal.η_ε, Functor.map_id, Category.id_comp]
  erw [← adj.unit.naturality_assoc, he, Category.comp_id]
  rfl

variable {J} {D : Type*} [Category* D] {K : GrothendieckTopology D} (F : C ⥤ D)
  [F.IsContinuous J K] [HasWeakSheafify K Ab.{w}] [(K.W (A := Ab.{w})).IsMonoidal]
  [K.HasSheafCompose (forget₂ RingCat.{w} Ab.{w})] (S : Sheaf K RingCat.{w})

/-- The ring object structure on the pushforward `F_* S` of the abelian sheaf underlying a
sheaf of rings `S`, induced by the lax monoidal pushforward `F_*`, is the ring object structure
of the abelian sheaf underlying the pushforward `F_* S` of the sheaf of rings. -/
lemma monObjObj_sheafPushforwardContinuous_eq :
    (F.sheafPushforwardContinuous Ab.{w} J K).monObjObj
        ((sheafCompose K (forget₂ RingCat.{w} Ab.{w})).obj S) =
      monObj_sheafCompose_obj J ((F.sheafPushforwardContinuous RingCat.{w} J K).obj S) := by
  refine MonObj.ext _ _ (Sheaf.hom_ext_of_μ_comp ?_)
  have h₁ := μ_sheafToPresheaf_comp_map_mul_sheafCompose J
    ((F.sheafPushforwardContinuous RingCat.{w} J K).obj S)
  have h₂ := μ_sheafToPresheaf_comp_map_mul_sheafCompose K S
  have h₃ := Functor.μ_sheafToPresheaf_comp_map_μ_sheafPushforwardContinuous F Ab.{w} J K
    ((sheafCompose K (forget₂ RingCat.{w} Ab.{w})).obj S)
    ((sheafCompose K (forget₂ RingCat.{w} Ab.{w})).obj S)
  erw [h₁, Functor.map_comp, reassoc_of% h₃]
  erw [← Functor.map_comp, h₂]
  rfl

end CategoryTheory.Sheaf

namespace PadicInt

variable {p : ℕ} [Fact p.Prime]

/-- **Continuous `p`-adic functions are locally integers modulo `pⁿ`**: near every point, a
continuous function `s : T → ℤ_p` is `k + pⁿ g` for an integer `k` and a continuous `g`. -/
lemma exists_isOpen_eq_intCast_add_pow_mul {T : Type*} [TopologicalSpace T] (s : C(T, ℤ_[p]))
    (n : ℕ) (t₀ : T) :
    ∃ O : Set T, IsOpen O ∧ t₀ ∈ O ∧ ∃ (k : ℤ) (g : C(O, ℤ_[p])),
      ∀ y : O, s y = k + (p : ℤ_[p]) ^ n * g y := by
  set k : ℤ := ((toZModPow n (s t₀)).val : ℤ)
  have hk : toZModPow n (k : ℤ_[p]) = toZModPow n (s t₀) := by simp [k]
  have hp : (p : ℚ_[p]) ^ n ≠ 0 := pow_ne_zero _ (by exact_mod_cast (Fact.out : p.Prime).ne_zero)
  have hnorm (y : T) (hy : toZModPow n (s y) = toZModPow n (s t₀)) :
      ‖((s y : ℚ_[p]) - k) / (p : ℚ_[p]) ^ n‖ ≤ 1 := by
    have := norm_sub_le_of_toZModPow_eq (hy.trans hk.symm)
    have hp0 : (0 : ℝ) < p := by exact_mod_cast (Fact.out : p.Prime).pos
    rw [norm_div, Padic.norm_p_pow, div_le_one (zpow_pos hp0 _)]
    calc ‖(s y : ℚ_[p]) - k‖ = ‖s y - (k : ℤ_[p])‖ := by
          rw [PadicInt.norm_def]
          push_cast
          rfl
      _ ≤ _ := this
  refine ⟨{y | toZModPow n (s y) = toZModPow n (s t₀)},
    ((isLocallyConstant_toZModPow n).comp_continuous s.continuous).isOpen_fiber _, rfl, k,
    ⟨fun y ↦ ⟨_, hnorm y.1 y.2⟩, ?_⟩, fun y ↦ ?_⟩
  · exact Continuous.subtype_mk (((continuous_subtype_val.comp
      (s.continuous.comp continuous_subtype_val)).sub continuous_const).div_const _) _
  · refine Subtype.ext ?_
    simp only [ContinuousMap.coe_mk, coe_add, coe_intCast, coe_mul, coe_pow, coe_natCast]
    field_simp
    ring

end PadicInt

namespace AlgebraicGeometry.ProEtale

open Scheme

variable (X : Scheme.{u}) (l : ℕ) [Fact l.Prime]

attribute [local instance] Sheaf.monoidalCategory Abelian.hasFiniteBiproducts

/-- **`ℤ_ℓ,X` is generated by the integers modulo `ℓⁿ`**: the unit `𝟙 ⟶ ℤ_ℓ,X` and the
multiplication by `ℓⁿ` are jointly epimorphic, since a continuous function to `ℤ_ℓ` is locally
of the form `k + ℓⁿ g` with `k` an integer. -/
instance epi_biprodDesc_one_padicIntAbSheaf (n : ℕ) :
    Epi (biprod.desc η[padicIntAbSheaf X l] (((l ^ n : ℕ) : ℤ) • 𝟙 (padicIntAbSheaf X l))) := by
  suffices Sheaf.IsLocallySurjective
      (biprod.desc η[padicIntAbSheaf X l] (((l ^ n : ℕ) : ℤ) • 𝟙 (padicIntAbSheaf X l))) from
    Sheaf.epi_of_isLocallySurjective _
  refine ⟨fun {U} s ↦ ?_⟩
  choose O hO hmem k g hg using
    fun x ↦ PadicInt.exists_isOpen_eq_intCast_add_pow_mul (ULift.down s) n x
  refine (ProEt.topology X).superset_covering ?_ (ProEt.generate_ofArrows_mem_topology U
    (fun x ↦ ⟨O x, hO x⟩) fun x ↦ ⟨x, hmem x⟩)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨x⟩
  have h₁ := congr_app (Sheaf.ε_sheafToPresheaf_comp_map_one_sheafCompose
    (ProEt.topology X) (padicIntSheaf X l)) (op (ProEt.ofOpens U ⟨O x, hO x⟩))
  refine ⟨(biprod.inl : _ ⟶ 𝟙_ _ ⊞ padicIntAbSheaf X l).hom.app _
      ((Functor.LaxMonoidal.ε (sheafToPresheaf (ProEt.topology X) Ab.{u + 1})).app _
        (ULift.up (k x))) +
    (biprod.inr : padicIntAbSheaf X l ⟶ _).hom.app _ (ULift.up (g x)), ?_⟩
  rw [map_add, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
    ← NatTrans.comp_app, ← NatTrans.comp_app]
  erw [← ObjectProperty.FullSubcategory.comp_hom, ← ObjectProperty.FullSubcategory.comp_hom,
    biprod.inl_desc, biprod.inr_desc]
  erw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, h₁]
  refine ULift.ext (ContinuousMap.ext fun y ↦ ?_)
  have h₂ : (((l ^ n : ℕ) : ℤ) • 𝟙 (padicIntAbSheaf X l)).hom.app
      (op (ProEt.ofOpens U ⟨O x, hO x⟩)) (ULift.up (g x)) =
      ((l ^ n : ℕ) : ℤ) • ULift.up (g x) := rfl
  have h₃ : η[(padicIntSheaf X l).obj ⋙ forget₂ RingCat.{u + 1} Ab.{u + 1}].app
      (op (ProEt.ofOpens U ⟨O x, hO x⟩))
      (ULift.up (k x)) = ((k x : ℤ) : ULift.{u + 1} C(O x, ℤ_[l])) := rfl
  rw [h₂]
  erw [h₃]
  convert (hg x y).symm using 1
  · calc _ = (k x : ℤ_[l]) + ((l ^ n : ℕ) : ℤ) • g x y := rfl
      _ = _ := by
        push_cast
        rw [zsmul_eq_mul]
        push_cast
        rfl
  · rfl

omit [Fact l.Prime] in
/-- The sheaf `(ℤ/ℓⁿ)_X` is killed by `ℓⁿ`. -/
lemma zsmul_id_zmodPowAbSheafDiagram_obj (n : ℕ) :
    ((l ^ n : ℕ) : ℤ) • 𝟙 ((zmodPowAbSheafDiagram X l).obj (op n)) = 0 := by
  ext U s
  refine ULift.ext (ContinuousMap.ext fun t ↦ ?_)
  calc _ = ((l ^ n : ℕ) : ℤ) • (ULift.down s t) := rfl
    _ = 0 := by
      rw [zsmul_eq_mul, Int.cast_natCast, ZMod.natCast_self, zero_mul]
    _ = _ := rfl

/-- The reduction `ℤ_ℓ,X ⟶ (ℤ/ℓⁿ)_X` of abelian sheaves. -/
noncomputable abbrev padicIntAbSheafToZModPow (n : ℕ) :
    padicIntAbSheaf X l ⟶ (zmodPowAbSheafDiagram X l).obj (op n) :=
  ((sheafCompose (ProEt.topology X) (forget₂ RingCat.{u + 1} Ab.{u + 1})).mapCone
    (padicIntSheafCone X l)).π.app (op n)

/-- **`ℤ_ℓ,X^r` is `ℓ`-adically separated**: a morphism into `ℤ_ℓ,X^r` whose reductions modulo
all `ℓⁿ` vanish is zero. -/
lemma eq_zero_of_comp_padicIntAbSheafToZModPow_eq_zero {r : ℕ}
    {Z : Sheaf (ProEt.topology X) Ab.{u + 1}}
    (f : Z ⟶ ⨁ fun _ : Fin r ↦ padicIntAbSheaf X l)
    (hf : ∀ (n : ℕ) (i : Fin r), f ≫ biproduct.π _ i ≫ padicIntAbSheafToZModPow X l n = 0) :
    f = 0 := by
  refine biproduct.hom_ext _ _ fun i ↦ (isLimitPadicIntAbSheafCone X l).hom_ext fun n ↦ ?_
  rw [Category.assoc, hf n.unop i, zero_comp, zero_comp]

end AlgebraicGeometry.ProEtale
