module

public import WeilConjectures.CategoryTheory.Monoidal.Mod.EvaluationPairing
public import WeilConjectures.Mathlib.CategoryTheory.Sites.GlobalSections
public import WeilConjectures.SixFunctors.ProEtale.Adic.AlgClosedField
public import WeilConjectures.SixFunctors.ProEtale.Adic.InternalHomEvaluation
public import WeilConjectures.SixFunctors.ProEtale.Adic.UnitSection
public import WeilConjectures.SixFunctors.ProEtale.UpperLowerStar.GlobalSectionsMonoidal
public import WeilConjectures.SixFunctors.ProEtale.UpperLowerStar.MonoidalIso

/-!
# The stalk of the internal hom out of a lisse sheaf

Let `s : Spec K ⟶ Z` be a geometric point, `K` algebraically closed, and write
`G_s = Γ(Spec K, s^* G)` for the stalk of a sheaf `G`. The evaluation
`𝓗om(F, ℚ̄_ℓ) ⊗ F ⟶ ℚ̄_ℓ` induces a pairing of stalks
`𝓗om(F, ℚ̄_ℓ)_s → Hom(F_s, (ℚ̄_ℓ)_s)` (`CategoryTheory.Mod.evaluationPairing`). For `F` lisse it
is bijective (`AlgebraicGeometry.ProEtale.IsAdicLisseSheaf.bijective_evaluationPairing`): the
point `s` lifts to a member `f` of a pro-étale cover trivialising `F`, every weakly étale scheme
over `Spec K` with a point having a section, and the pullback along the weakly étale `f`
commutes with internal homs compatibly with the evaluations
(`AlgebraicGeometry.ProEtale.adicUpperStarIhomIso_evaluation`). This reduces the claim to a free
sheaf `ℚ̄_ℓⁿ`, for which it is
`CategoryTheory.Mod.bijective_evaluationPairing_of_iso_biproduct`, the stalk of `ℚ̄_ℓ` being
generated by its unit (`AlgebraicGeometry.ProEtale.isIso_unitSection`).
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory Functor.LaxMonoidal Limits

namespace AlgebraicGeometry.ProEtale

variable {l : ℕ} [Fact l.Prime] {K : Type u} [Field K]

variable (l) in
/-- The stalk functor `G ↦ Γ(Spec K, s^* G)` at a point `s : Spec K ⟶ Z`. -/
noncomputable abbrev stalkFunctor {Z : Scheme.{u}} (s : Spec (.of K) ⟶ Z) :
    Sheaf (Scheme.ProEt.topology Z) (WeilCoefficients.{u} l) ⥤ WeilCoefficients.{u} l :=
  (s)^*[WeilCoefficients.{u} l] ⋙ Sheaf.Γ _ _

/-- The pairing of stalks at `t ≫ f`, for `f` weakly étale, is the pairing of stalks at `t` of
the pullbacks along `f`. -/
lemma bijective_evaluationPairing_comp_iff {Z V : Scheme.{u}} (f : V ⟶ Z) [WeaklyEtale f]
    (t : Spec (.of K) ⟶ V) (M N : AdicSheaf l Z) :
    Function.Bijective (Mod.evaluationPairing (stalkFunctor l (t ≫ f)) M N) ↔
      Function.Bijective (Mod.evaluationPairing (stalkFunctor l t) ((f)^*ᵃ[l].obj M)
        ((f)^*ᵃ[l].obj N)) := by
  let τ : stalkFunctor l (t ≫ f) ≅ (f)^*[WeilCoefficients.{u} l] ⋙ stalkFunctor l t :=
    Functor.isoWhiskerRight (upperStarComp _ t f) _ ≪≫ Functor.associator _ _ _
  have : NatTrans.IsMonoidal τ.hom := by
    dsimp only [τ, Iso.trans_hom, Functor.isoWhiskerRight_hom]
    infer_instance
  rw [Mod.bijective_evaluationPairing_iff_of_iso _ τ]
  refine LinearMap.bijective_iff_of_linearEquiv _ _
    ((stalkFunctor l t).mapIso ((Mod.forget _).mapIso
      ((adicUpperStarIhomIso l f M).app N))).toLinearEquiv
    (LinearEquiv.refl _ _) (LinearEquiv.refl _ _) fun v w ↦ ?_
  change ((stalkFunctor l t).map (Mod.evaluation _ _)).hom ((μ (stalkFunctor l t) _ _).hom
      (((stalkFunctor l t).map ((adicUpperStarIhomIso l f M).hom.app N).hom).hom v ⊗ₜ w)) =
    (((f)^*[WeilCoefficients.{u} l] ⋙ stalkFunctor l t).map (Mod.evaluation M N)).hom
      ((μ ((f)^*[WeilCoefficients.{u} l] ⋙ stalkFunctor l t) _ _).hom (v ⊗ₜ w))
  have hm : ((stalkFunctor l t).map ((adicUpperStarIhomIso l f M).hom.app N).hom ▷ _) ≫
      μ (stalkFunctor l t) _ _ ≫
        (stalkFunctor l t).map (Mod.evaluation ((f)^*ᵃ[l].obj M) ((f)^*ᵃ[l].obj N)) =
      μ ((f)^*[WeilCoefficients.{u} l] ⋙ stalkFunctor l t) ((Mod.ihom M).obj N).X M.X ≫
        ((f)^*[WeilCoefficients.{u} l] ⋙ stalkFunctor l t).map (Mod.evaluation M N) := by
    rw [μ_natural_left_assoc, ← Functor.map_comp, adicUpperStarIhomIso_evaluation]
    erw [Functor.map_comp]
    rfl
  exact congrArg (fun m ↦ m.hom (v ⊗ₜ w)) hm

variable [IsAlgClosed K]

/-- **The stalk of the dual of a lisse sheaf is the dual of the stalk.** For `F` lisse and a
geometric point `s`, the pairing `𝓗om(F, ℚ̄_ℓ)_s → Hom(F_s, (ℚ̄_ℓ)_s)` induced by the evaluation
is bijective. -/
theorem IsAdicLisseSheaf.bijective_evaluationPairing {Z : Scheme.{u}} {F : AdicSheaf l Z}
    (hF : IsAdicLisseSheaf F) (s : Spec (.of K) ⟶ Z) :
    Function.Bijective (Mod.evaluationPairing (stalkFunctor l s) F (AdicSheaf.unit l Z)) := by
  obtain ⟨R, hR, h⟩ := hF
  obtain ⟨ι, V, f, rfl⟩ := R.exists_eq_ofArrows
  have hR' : _ ∈ Scheme.precoverage (@WeaklyEtale : MorphismProperty Scheme.{u}) _ :=
    (show Scheme.proetalePrecoverage ≤ Scheme.precoverage @WeaklyEtale from inf_le_right) _ hR
  rw [Scheme.ofArrows_mem_precoverage_iff (@WeaklyEtale : MorphismProperty Scheme.{u})] at hR'
  obtain ⟨i, v, hv⟩ := hR'.1 (s.base (IsLocalRing.closedPoint K))
  have : WeaklyEtale (f i) := hR'.2 i
  obtain ⟨p, -, hp⟩ := Scheme.Pullback.exists_preimage_pullback (f := f i) (g := s)
    v (IsLocalRing.closedPoint K) hv
  have : WeaklyEtale (pullback.snd (f i) s) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback (f i) s) ‹_›
  obtain ⟨σ, hσ⟩ := exists_comp_eq_id_of_weaklyEtale (pullback.snd (f i) s) p
  have hs : (σ ≫ pullback.fst (f i) s) ≫ f i = s := by
    rw [Category.assoc, pullback.condition, ← Category.assoc, hσ, Category.id_comp]
  rw [← hs, bijective_evaluationPairing_comp_iff,
    Mod.bijective_evaluationPairing_iff_of_iso_right _ _ (adicUpperStarUnitIso l (f i))]
  obtain ⟨n, ⟨e⟩⟩ := h (f i) (.mk i)
  have : IsIso (ε (stalkFunctor l (σ ≫ pullback.fst (f i) s)) ≫
      (stalkFunctor l (σ ≫ pullback.fst (f i) s)).map
        (MonObj.one (X := adicConstantSheaf l (V i)))) :=
    isIso_unitSection (l := l) (σ ≫ pullback.fst (f i) s)
  exact Mod.bijective_evaluationPairing_of_iso_biproduct _ e _

end AlgebraicGeometry.ProEtale

namespace AlgebraicGeometry.WeilCoefficients

variable {l : ℕ} [Fact l.Prime] {M N L : WeilCoefficients.{u} l}

/-- A perfect pairing `M × N → L` of modules over `ULift ℚ̄_ℓ`, with `L ≅ ULift ℚ̄_ℓ`, identifies
`M` with the `ℚ̄_ℓ`-dual of `N`: `m ↦ (n ↦ θ (p m n))`. -/
noncomputable def dualLinearMap
    (p : M →ₗ[ULift.{u + 1} (PadicAlgCl l)] N →ₗ[ULift (PadicAlgCl l)] L)
    (θ : L →ₗ[ULift.{u + 1} (PadicAlgCl l)] ULift.{u + 1} (PadicAlgCl l)) :
    (toModuleCat l).obj M →ₗ[PadicAlgCl l] Module.Dual (PadicAlgCl l) ((toModuleCat l).obj N) where
  toFun (m : M) :=
    { toFun (n : N) := (θ (p m n)).down
      map_add' (n n' : N) := by
        change (θ (p m (n + n'))).down = (θ (p m n)).down + (θ (p m n')).down
        rw [map_add, map_add]
        rfl
      map_smul' c (n : N) := by
        change (θ (p m ((ULift.up c : ULift (PadicAlgCl l)) • n))).down = c * (θ (p m n)).down
        rw [map_smul, map_smul]
        rfl }
  map_add' (m m' : M) := by
    ext (n : N)
    change (θ (p (m + m') n)).down = (θ (p m n)).down + (θ (p m' n)).down
    rw [map_add, LinearMap.add_apply, map_add]
    rfl
  map_smul' c (m : M) := by
    ext (n : N)
    change (θ (p ((ULift.up c : ULift (PadicAlgCl l)) • m) n)).down = c * (θ (p m n)).down
    rw [map_smul, LinearMap.smul_apply, map_smul]
    rfl

lemma dualLinearMap_apply (p : M →ₗ[ULift.{u + 1} (PadicAlgCl l)] N →ₗ[ULift (PadicAlgCl l)] L)
    (θ : L →ₗ[ULift.{u + 1} (PadicAlgCl l)] ULift.{u + 1} (PadicAlgCl l)) (m : M) (n : N) :
    dualLinearMap p θ m n = (θ (p m n)).down :=
  rfl

lemma bijective_dualLinearMap
    {p : M →ₗ[ULift.{u + 1} (PadicAlgCl l)] N →ₗ[ULift (PadicAlgCl l)] L}
    (hp : Function.Bijective p)
    (θ : L ≃ₗ[ULift.{u + 1} (PadicAlgCl l)] ULift.{u + 1} (PadicAlgCl l)) :
    Function.Bijective (dualLinearMap p θ.toLinearMap) := by
  refine ⟨fun (m : M) (m' : M) h ↦ hp.1 (LinearMap.ext fun (n : N) ↦
    θ.injective (ULift.ext _ _ ?_)), fun φ ↦ ?_⟩
  · exact LinearMap.congr_fun h n
  · let ψ : N →ₗ[ULift.{u + 1} (PadicAlgCl l)] L :=
      { toFun (n : N) := θ.symm (ULift.up (φ n))
        map_add' n n' := (congrArg (fun a ↦ θ.symm (ULift.up a)) (φ.map_add n n')).trans
          (map_add θ.symm _ _)
        map_smul' c n := (congrArg (fun a ↦ θ.symm (ULift.up a)) (φ.map_smul c.down n)).trans
          (map_smul θ.symm c _) }
    obtain ⟨m, hm⟩ := hp.2 ψ
    refine ⟨m, LinearMap.ext fun (n : N) ↦ ?_⟩
    rw [dualLinearMap_apply, hm]
    change (θ (θ.symm (ULift.up (φ n)))).down = φ n
    rw [LinearEquiv.apply_symm_apply]

end AlgebraicGeometry.WeilCoefficients

namespace AlgebraicGeometry.WeilCoefficients

variable {l : ℕ} [Fact l.Prime]

lemma linearEquivOfIso_apply {M N : WeilCoefficients.{u} l} (e : M ≅ N) (x : M) :
    linearEquivOfIso e x = e.hom.hom x :=
  rfl

end AlgebraicGeometry.WeilCoefficients

namespace AlgebraicGeometry.WeilCoefficients

variable {l : ℕ} [Fact l.Prime]

open MonoidalCategory in
/-- A pairing `P ⊗ Q ⟶ T ⟶ R` of modules over `ULift ℚ̄_ℓ` intertwining automorphisms of `P`,
`Q` and `R` whose last one is the identity is invariant under the automorphisms. -/
lemma pairing_linearEquivOfIso {P Q T R : WeilCoefficients.{u} l} (eP : P ≅ P) (eQ : Q ≅ Q)
    (eR : R ≅ R) (g₁ : P ⊗ Q ⟶ T) (g₂ : T ⟶ R)
    (h : (eP.hom ⊗ₘ eQ.hom) ≫ g₁ ≫ g₂ = (g₁ ≫ g₂) ≫ eR.hom)
    (hR : linearEquivOfIso eR = LinearEquiv.refl _ _) (p : P) (q : Q) :
    g₂.hom (g₁.hom (linearEquivOfIso eP p ⊗ₜ linearEquivOfIso eQ q)) =
      g₂.hom (g₁.hom (p ⊗ₜ q)) := by
  have h₁ := ModuleCat.tmul_eq_of_tensorHom_comp h p q
  have h₂ := congrArg (fun e ↦ e (g₂.hom (g₁.hom (p ⊗ₜ q)))) hR
  exact h₁.trans h₂

end AlgebraicGeometry.WeilCoefficients
