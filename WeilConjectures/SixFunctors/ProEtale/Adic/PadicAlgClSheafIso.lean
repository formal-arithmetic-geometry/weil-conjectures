module

public import WeilConjectures.SixFunctors.ProEtale.Adic.PadicAlgClSheafComparison
public import WeilConjectures.SixFunctors.ProEtale.Adic.ProEtOpenCover

/-!
# The two models of `ℚ̄_ℓ,X` agree

A locally finite function `f : U → ℚ̄_ℓ` takes, near every point, values in a finite
subextension `E ⊆ ℚ̄_ℓ` of `ℚ_ℓ`: near the point its values span a finite-dimensional
`ℚ_ℓ`-subspace `V`, and the field generated by a finite spanning set of `V` is finite over
`ℚ_ℓ`, `ℚ̄_ℓ` being algebraic (`PadicAlgCl.exists_isOpen_mem_finiteIntermediateField`). Open
covers being coverings of `X_proét`, the inclusion of the presheaf of functions with values in a
finite subextension into the locally finite functions is locally surjective
(`AlgebraicGeometry.ProEtale.isLocallySurjective_padicAlgClPresheafToAdicConstantSheaf`). It
is also injective, so the comparison `padicAlgClSheaf X ℓ ⟶ adicConstantSheaf ℓ X` is an
isomorphism of abelian sheaves
(`AlgebraicGeometry.ProEtale.padicAlgClSheafIsoAdicConstantSheaf`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite Topology

namespace PadicAlgCl

variable {l : ℕ} [Fact l.Prime] {T : Type*} [TopologicalSpace T]

/-- A locally finite function `f : T → ℚ̄_ℓ` takes values in a finite subextension of `ℚ_ℓ` on
an open neighbourhood of every point. -/
lemma exists_isOpen_mem_finiteIntermediateField {f : C(T, PadicAlgCl l)}
    (hf : f ∈ locallyFiniteFunctions l T) (x : T) :
    ∃ W : Set T, IsOpen W ∧ x ∈ W ∧ ∃ E : IntermediateField ℚ_[l] (PadicAlgCl l),
      FiniteDimensional ℚ_[l] E ∧ ∀ y ∈ W, f y ∈ E := by
  obtain ⟨N, hN, hfin⟩ := hf x
  obtain ⟨W, hWN, hWo, hxW⟩ := mem_nhds_iff.1 hN
  obtain ⟨t, ht⟩ := (Submodule.fg_iff_finiteDimensional _).2 hfin
  refine ⟨W, hWo, hxW, IntermediateField.adjoin ℚ_[l] (t : Set (PadicAlgCl l)),
    IntermediateField.finiteDimensional_adjoin fun z _ ↦ Algebra.IsIntegral.isIntegral z,
    fun y hy ↦ ?_⟩
  have hy' : f y ∈ Submodule.span ℚ_[l] (t : Set (PadicAlgCl l)) :=
    ht ▸ Submodule.subset_span ⟨y, hWN hy, rfl⟩
  exact (Submodule.span_le (p := Subalgebra.toSubmodule
    (IntermediateField.adjoin ℚ_[l] (t : Set (PadicAlgCl l))).toSubalgebra)).2
    (IntermediateField.subset_adjoin _ _) hy'

end PadicAlgCl

namespace AlgebraicGeometry.ProEtale

open Scheme

variable (X : Scheme.{u}) (l : ℕ) [Fact l.Prime]

/-- The inclusion of the functions with values in a finite subextension into the locally finite
functions is locally surjective for the pro-étale topology: a locally finite function is, on
the members of an open cover, valued in finite subextensions. -/
instance isLocallySurjective_padicAlgClPresheafToAdicConstantSheaf :
    Presheaf.IsLocallySurjective (ProEt.topology X)
      (padicAlgClPresheafToAdicConstantSheaf X l) where
  imageSieve_mem {U} s := by
    let f : C(U.left, PadicAlgCl l) := s.down.1
    have hf : f ∈ PadicAlgCl.locallyFiniteFunctions l U.left := s.down.2
    choose W hWo hxW E hE hfE using PadicAlgCl.exists_isOpen_mem_finiteIntermediateField hf
    refine (ProEt.topology X).superset_covering ?_ (ProEt.generate_ofArrows_mem_topology U
      (fun x ↦ ⟨W x, hWo x⟩) fun x ↦ ⟨x, hxW x⟩)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨x⟩
    exact ⟨ULift.up ⟨f.comp (Scheme.Opens.ι ⟨W x, hWo x⟩).base.hom,
      ⟨E x, hE x, fun y ↦ hfE x _ y.2⟩⟩, rfl⟩

/-- The inclusion of the functions with values in a finite subextension into the locally finite
functions is locally injective, being injective. -/
instance isLocallyInjective_padicAlgClPresheafToAdicConstantSheaf :
    Presheaf.IsLocallyInjective (ProEt.topology X)
      (padicAlgClPresheafToAdicConstantSheaf X l) :=
  Presheaf.isLocallyInjective_of_injective _ _ fun _ _ _ h ↦
    ULift.ext (Subtype.ext (congrArg (fun z ↦ z.down.1) h))

/-- **The two models of `ℚ̄_ℓ,X` agree**: the comparison
`padicAlgClSheaf X ℓ ⟶ adicConstantSheaf ℓ X`
is an isomorphism of abelian sheaves, the inclusion of the defining presheaves being locally
bijective. -/
instance isIso_padicAlgClSheafToAdicConstantSheaf :
    IsIso (padicAlgClSheafToAdicConstantSheaf X l) := by
  have hW : (ProEt.topology X).W (padicAlgClPresheafToAdicConstantSheaf X l) :=
    (GrothendieckTopology.W_iff_isLocallyBijective _ _).2 ⟨inferInstance, inferInstance⟩
  rw [GrothendieckTopology.W_iff] at hW
  rw [padicAlgClSheafToAdicConstantSheaf, Adjunction.homEquiv_counit]
  infer_instance

/-- The isomorphism of abelian sheaves between the two models `padicAlgClSheaf X ℓ` and
`adicConstantSheaf ℓ X` of `ℚ̄_ℓ,X`. -/
noncomputable def padicAlgClSheafIsoAdicConstantSheaf :
    padicAlgClSheaf X l ≅
      (sheafCompose (ProEt.topology X) (forget₂ (WeilCoefficients.{u} l) Ab.{u + 1})).obj
        (adicConstantSheaf l X) :=
  asIso (padicAlgClSheafToAdicConstantSheaf X l)

end AlgebraicGeometry.ProEtale
