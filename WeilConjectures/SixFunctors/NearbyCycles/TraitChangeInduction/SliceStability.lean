/-!

# The compositum of a slice is relatively separably closed in that of a finer slice

Let `H : D₁ ⟶ D₂` be a morphism of strict-localization slice traits over a change of traits
`R₁ ⟶ R₂`, the identity on the fields `κ(x)^alg` of the closed points, with composita
`Lᵢ = Ωᵢ(Sᵢ(x))`. Then `L₁` is relatively separably closed in `L₂`
(`AlgebraicGeometry.SliceTrait.Hom.mem_compositum_of_ΩMap_mem`): an element of the separable
closure of `L₁` whose image lies in `L₂` lies in `L₁`.

This is the stability theorem of Ohm and Kuhlmann for `L₁ = Ω₁(x)^{sh}` (Gauss valuation) in
the case needed. Since `L₁^sep / L₁` is pro-`p`, `p` the residual characteristic exponent
(`AlgebraicGeometry.SliceTrait.exists_finrank_eq_pow`), a nontrivial finite separable extension of
`L₁` inside `L₂` would contain a Galois extension of degree `p`
(`IntermediateField.exists_isGalois_finrank_eq_prime_le`), generated by an Artin–Schreier root
(equal characteristic) or a Kummer root (mixed characteristic); the normal forms of
`SliceStabilityCharP` and `SliceStabilityMixedChar` show that such a root already lies in `L₁`.

-/

@[expose] public section

universe u

open IsLocalRing IntermediateField

/-- In a field of prime characteristic `p`, the roots of `X ^ p - X` are the images of
integers. -/
lemma exists_intCast_eq_of_pow_char_eq_self {F : Type*} [Field F] (p : ℕ) [hp : Fact p.Prime]
    [CharP F p] {y : F} (hy : y ^ p = y) : ∃ n : ℤ, (n : F) = y := by
  classical
  by_contra h
  push Not at h
  set f : Polynomial F := Polynomial.X ^ p - Polynomial.X with hf
  have hf0 : f ≠ 0 := by
    intro h0
    have := congrArg Polynomial.natDegree h0
    rw [hf, Polynomial.natDegree_sub_eq_left_of_natDegree_lt (by
      rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]; exact hp.out.one_lt),
      Polynomial.natDegree_X_pow, Polynomial.natDegree_zero] at this
    exact hp.out.ne_zero this
  have hroot : ∀ z : F, z ^ p = z → z ∈ f.roots := fun z hz ↦ by
    rw [Polynomial.mem_roots hf0, Polynomial.IsRoot, hf, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, hz, sub_self]
  have hcast : ∀ n : ℕ, (n : F) ^ p = n := fun n ↦ by
    have := congrArg (ZMod.castHom (dvd_refl p) F) (ZMod.pow_card (n : ZMod p))
    rwa [map_pow, map_natCast] at this
  have hinj : Set.InjOn (fun n : ℕ ↦ (n : F)) (Finset.range p) := by
    intro m hm n hn hmn
    simp only [Finset.coe_range, Set.mem_Iio] at hm hn
    have := (CharP.natCast_eq_natCast F p).1 hmn
    exact Nat.ModEq.eq_of_lt_of_lt this hm hn
  set S : Finset F := insert y ((Finset.range p).image fun n : ℕ ↦ (n : F)) with hS
  have hyS : y ∉ (Finset.range p).image fun n : ℕ ↦ (n : F) := by
    simp only [Finset.mem_image]
    rintro ⟨n, -, hn⟩
    exact h n (by exact_mod_cast hn)
  have hcard : S.card = p + 1 := by
    rw [hS, Finset.card_insert_of_notMem hyS, Finset.card_image_of_injOn hinj, Finset.card_range]
  have hle : S.val ≤ f.roots := by
    refine (Multiset.le_iff_subset S.nodup).2 fun z hz ↦ ?_
    rw [Finset.mem_val, hS, Finset.mem_insert, Finset.mem_image] at hz
    rcases hz with rfl | ⟨n, -, rfl⟩
    · exact hroot _ hy
    · exact hroot _ (hcast n)
  have h1 := Multiset.card_le_card hle
  have h2 := Polynomial.card_roots' f
  rw [Finset.card_val, hcard] at h1
  have hdeg : f.natDegree = p := by
    rw [hf, Polynomial.natDegree_sub_eq_left_of_natDegree_lt (by
      rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]; exact hp.out.one_lt),
      Polynomial.natDegree_X_pow]
  rw [hdeg] at h2
  omega

/-- A finite Galois intermediate field of `Ω / L` is a finite Galois intermediate field of the
separable closure. -/
lemma IntermediateField.exists_finrank_eq_pow_of_separableClosure {L Ω : Type*} [Field L]
    [Field Ω] [Algebra L Ω] {p : ℕ}
    (hdeg : ∀ L' : FiniteGaloisIntermediateField L (separableClosure L Ω),
      ∃ k, Module.finrank L L' = p ^ k)
    (N : IntermediateField L Ω) (hN : FiniteDimensional L N) (hG : IsGalois L N) :
    ∃ k, Module.finrank L N = p ^ k := by
  have hle : N ≤ separableClosure L Ω := (le_separableClosure_iff L Ω N).2 inferInstance
  let e := IntermediateField.restrictAlgEquiv hle
  have : FiniteDimensional L (IntermediateField.restrict hle) := e.toLinearEquiv.finiteDimensional
  have : IsGalois L (IntermediateField.restrict hle) := IsGalois.of_algEquiv e
  obtain ⟨k, hk⟩ := hdeg ⟨IntermediateField.restrict hle⟩
  exact ⟨k, e.toLinearEquiv.finrank_eq.trans hk⟩

namespace AlgebraicGeometry.SliceTrait.Hom

attribute [local instance] algebraR algebraΩ algebraBaseΩ algebraRΩ

variable {R₁ R₂ : Type u} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
  [IsStrictlyHenselianLocalRing R₁] [CommRing R₂] [IsDomain R₂] [IsDiscreteValuationRing R₂]
  [IsStrictlyHenselianLocalRing R₂] {ι : R₁ →+* R₂} {Ω₁ Ω₂ : Type u} [Field Ω₁] [Field Ω₂]
  [IsAlgClosed Ω₁] [IsAlgClosed Ω₂] {c : Ω₁ →+* Ω₂} {a₁ : R₁ →+* Ω₁} {a₂ : R₂ →+* Ω₂}
  (ha₁ : Function.Injective a₁) (halg₁ : letI := a₁.toAlgebra; Algebra.IsAlgebraic R₁ Ω₁)
  (ha₂ : Function.Injective a₂) (halg₂ : letI := a₂.toAlgebra; Algebra.IsAlgebraic R₂ Ω₂)
  {κ : Type u} [Field κ] [IsSepClosed κ] {b₁ : R₁ →+* κ} {b₂ : R₂ →+* κ}
  (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) (hb₂ : RingHom.ker b₂ = maximalIdeal R₂)

local notation "𝒟₁" => sliceTraitOfStrictLocalization (a₁ := a₁) (b₁ := b₁) ha₁ halg₁ hb₁
local notation "𝒟₂" => sliceTraitOfStrictLocalization (a₁ := a₂) (b₁ := b₂) ha₂ halg₂ hb₂

omit [IsAlgClosed Ω₂] in
include ha₁ halg₁ ha₂ halg₂ hb₁ hb₂ in
/-- **The compositum of a strict-localization slice is relatively separably closed in that of a
finer one** (Ohm–Kuhlmann stability): for a morphism `H : D₁ ⟶ D₂` of strict-localization
slice traits which is the identity on the fields of the closed points, an element of the
separable closure of `L₁ = Ω₁(S₁(x))` whose image lies in `L₂ = Ω₂(S₂(x))` lies in `L₁`. -/
theorem mem_compositum_of_ΩMap_mem (H : SliceTrait.Hom ι c 𝒟₁ 𝒟₂) (hκ : ∀ y, H.κMap y = y)
    {x : (𝒟₁).Ω} (hxsep : letI := a₁.toAlgebra; IsSeparable (𝒟₁).compositum x)
    (hx : letI := a₂.toAlgebra; H.ΩMap x ∈ (𝒟₂).compositum) :
    letI := a₁.toAlgebra
    x ∈ (𝒟₁).compositum := by
  classical
  let := a₁.toAlgebra
  let := a₂.toAlgebra
  set L := (𝒟₁).compositum with hLdef
  by_contra hxL
  -- `H.ΩMap` maps `L⟮x⟯` into `L₂`
  have hmap : ∀ y ∈ L⟮x⟯, H.ΩMap y ∈ (𝒟₂).compositum := by
    have : (L⟮x⟯).toSubfield ≤ (𝒟₂).compositum.toSubfield.comap H.ΩMap := by
      rw [adjoin_toSubfield]
      refine Subfield.closure_le.2 ?_
      rintro _ (⟨l, rfl⟩ | h)
      · exact H.ΩMap_mem_compositum _ l.2
      · rw [Set.mem_singleton_iff] at h
        subst h
        exact hx
    exact fun y hy ↦ this hy
  have hxint := hxsep.isIntegral
  set M := L⟮x⟯ with hMdef
  have : FiniteDimensional L M := adjoin.finiteDimensional hxint
  have : Algebra.IsSeparable L M := (isSeparable_adjoin_simple_iff_isSeparable L (𝒟₁).Ω).2 hxsep
  have hM : M ≠ ⊥ := by
    intro h
    have : x ∈ (⊥ : IntermediateField L (𝒟₁).Ω) := h ▸ mem_adjoin_simple_self L x
    obtain ⟨l, hl⟩ := mem_bot.1 this
    exact hxL (hl ▸ l.2)
  -- the degree of finite Galois extensions of `L`
  have hdeg : ∀ r : ℕ, [Fact r.Prime] → (∀ n : ℕ, (n : ResidueField R₁) = 0 → r ∣ n) →
      ∀ N : IntermediateField L (𝒟₁).Ω, FiniteDimensional L N → IsGalois L N →
        ∃ k, Module.finrank L N = r ^ k := fun r _ hr ↦
    IntermediateField.exists_finrank_eq_pow_of_separableClosure
      ((𝒟₁).exists_finrank_eq_pow hr)
  obtain ⟨q, hq⟩ := CharP.exists (ResidueField R₁)
  rcases CharP.char_is_prime_or_zero (ResidueField R₁) q with hqp | rfl
  · -- residual characteristic `q > 0`
    have : Fact q.Prime := ⟨hqp⟩
    have hqdvd : ∀ n : ℕ, (n : ResidueField R₁) = 0 → q ∣ n := fun n hn ↦
      (CharP.cast_eq_zero_iff (ResidueField R₁) q n).1 hn
    obtain ⟨M', hM'M, hM'G, hM'deg⟩ := IntermediateField.exists_isGalois_finrank_eq_prime_le
      (hdeg q hqdvd) M hM
    have : Module.Free L M' := Module.Free.of_divisionRing L M'
    have : FiniteDimensional L M' := Module.finite_of_finrank_eq_succ (by
      rw [hM'deg]; exact (Nat.succ_pred_eq_of_pos hqp.pos).symm)
    obtain ⟨cΩ, hcΩ⟩ := CharP.exists Ω₁
    rcases CharP.char_is_prime_or_zero Ω₁ cΩ with hcp | rfl
    · -- equal characteristic
      have hcq : cΩ = q := by
        have h1 : a₁ (cΩ : R₁) = 0 := by rw [map_natCast]; exact CharP.cast_eq_zero Ω₁ cΩ
        have h2 : (cΩ : R₁) = 0 := ha₁ (by rw [h1, map_zero])
        have h3 : (cΩ : ResidueField R₁) = 0 := by
          rw [← map_natCast (residue R₁), h2, map_zero]
        exact ((Nat.prime_dvd_prime_iff_eq hqp hcp).1 (hqdvd cΩ h3)).symm
      subst hcq
      have : CharP Ω₂ cΩ := charP_of_injective_ringHom c.injective cΩ
      have : CharP R₂ cΩ := a₂.charP ha₂ cΩ
      have : CharP (ResidueField R₂) cΩ := (CharP.charP_iff_prime_eq_zero hqp).2
        (by rw [← map_natCast (residue R₂), CharP.cast_eq_zero, map_zero])
      have : CharP (𝒟₁).Ω cΩ := charP_of_injective_ringHom (𝒟₁).ωS.injective cΩ
      have : CharP L cΩ := charP_of_injective_ringHom (algebraMap Ω₁ L).injective cΩ
      obtain ⟨θ, hθ, hθp⟩ := IsGalois.exists_not_mem_range_pow_sub_self_mem_range cΩ hM'deg
      obtain ⟨l, hl⟩ := hθp
      set θ₀ : (𝒟₁).Ω := ((θ : M') : (𝒟₁).Ω) with hθ₀
      have hθ₀M : θ₀ ∈ M := hM'M θ.2
      have hαeq : (l : (𝒟₁).Ω) = θ₀ ^ cΩ - θ₀ := by
        have := congrArg (fun z : M' ↦ ((z : M') : (𝒟₁).Ω)) hl
        simpa using this
      obtain ⟨θ₁, hθ₁L, hθ₁⟩ := exists_artinSchreier_root_of_charP ha₁ halg₁ ha₂ halg₂ hb₁ hb₂
        cΩ H hκ l.2 ⟨H.ΩMap θ₀, hmap θ₀ hθ₀M, by rw [← map_pow, ← map_sub, hαeq]⟩
      have hy : (θ₀ - θ₁) ^ cΩ = θ₀ - θ₁ := by
        rw [sub_pow_char]
        linear_combination -hθ₁ - hαeq
      obtain ⟨n, hn⟩ := exists_intCast_eq_of_pow_char_eq_self cΩ hy
      have hθ₀L : θ₀ ∈ L := by
        have : θ₀ = θ₁ + (n : (𝒟₁).Ω) := by rw [hn]; ring
        rw [this]
        exact add_mem hθ₁L (intCast_mem L n)
      exact hθ ⟨⟨θ₀, hθ₀L⟩, Subtype.ext rfl⟩
    · -- mixed characteristic
      have : CharZero Ω₁ := CharP.charP_to_charZero Ω₁
      have : NeZero (q : Ω₁) := ⟨Nat.cast_ne_zero.2 hqp.ne_zero⟩
      have : CharP (ResidueField R₂) q := (CharP.charP_iff_prime_eq_zero hqp).2 (by
        rw [← map_natCast (residue R₂), IsLocalRing.residue_eq_zero_iff,
          IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have h1 : IsUnit (H.ψ ((𝒟₁).φ (q : R₁))) := by
          rw [map_natCast, map_natCast, ← map_natCast (𝒟₂).φ]
          exact hu.map _
        have h3 : (𝒟₁).φ (q : R₁) ∈ maximalIdeal (𝒟₁).R := by
          rw [(𝒟₁).maximalIdeal_eq]
          exact Ideal.mem_map_of_mem _ (by
            rw [← IsLocalRing.residue_eq_zero_iff, map_natCast, CharP.cast_eq_zero])
        exact (IsLocalRing.mem_maximalIdeal _).1 h3 ((isUnit_map_iff H.ψ _).1 h1))
      obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot Ω₁ q
      have hζL : (primitiveRoots q L).Nonempty :=
        ⟨algebraMap Ω₁ L ζ, (mem_primitiveRoots hqp.pos).2
          (hζ.map_of_injective (algebraMap Ω₁ L).injective)⟩
      obtain ⟨θ, hθ, hθp⟩ := IsGalois.exists_not_mem_range_pow_mem_range q hζL hM'deg
      obtain ⟨l, hl⟩ := hθp
      set θ₀ : (𝒟₁).Ω := ((θ : M') : (𝒟₁).Ω) with hθ₀
      have hθ₀M : θ₀ ∈ M := hM'M θ.2
      have hαeq : (l : (𝒟₁).Ω) = θ₀ ^ q := by
        have := congrArg (fun z : M' ↦ ((z : M') : (𝒟₁).Ω)) hl
        simpa using this
      obtain ⟨θ₁, hθ₁L, hθ₁⟩ := exists_pow_root_of_mixedChar ha₁ halg₁ ha₂ halg₂ hb₁ hb₂
        q H hκ l.2 ⟨H.ΩMap θ₀, hmap θ₀ hθ₀M, by rw [← map_pow, hαeq]⟩
      have hθ₀0 : θ₀ ≠ 0 := by
        intro h
        exact hθ ⟨0, by
          rw [map_zero]
          exact Subtype.ext (by rw [ZeroMemClass.coe_zero]; exact h.symm)⟩
      have hθ₁0 : θ₁ ≠ 0 := by
        rintro rfl
        rw [zero_pow hqp.ne_zero, hαeq] at hθ₁
        exact hθ₀0 (pow_eq_zero_iff hqp.ne_zero |>.1 hθ₁.symm)
      have hroot : (θ₀ / θ₁) ^ q = 1 := by
        rw [div_pow, hθ₁, hαeq, div_self (pow_ne_zero _ hθ₀0)]
      obtain ⟨i, -, hi⟩ := (hζ.map_of_injective (𝒟₁).ωS.injective).eq_pow_of_pow_eq_one hroot
      have hθ₀L : θ₀ ∈ L := by
        have : θ₀ = θ₁ * (𝒟₁).ωS ζ ^ i := by rw [hi, mul_div_cancel₀ _ hθ₁0]
        rw [this]
        exact mul_mem hθ₁L (pow_mem (IntermediateField.algebraMap_mem L ζ) _)
      exact hθ ⟨⟨θ₀, hθ₀L⟩, Subtype.ext rfl⟩
  · -- residual characteristic `0`: `L` is separably closed
    have h0 : ∀ r : ℕ, (∀ n : ℕ, (n : ResidueField R₁) = 0 → r ∣ n) := fun r n hn ↦ by
      rw [CharP.cast_eq_zero_iff (ResidueField R₁) 0] at hn
      exact (Nat.eq_zero_of_zero_dvd hn) ▸ dvd_zero r
    have : Fact (2 : ℕ).Prime := ⟨Nat.prime_two⟩
    have : Fact (3 : ℕ).Prime := ⟨Nat.prime_three⟩
    obtain ⟨M', -, hM'G, hM'deg⟩ := IntermediateField.exists_isGalois_finrank_eq_prime_le
      (hdeg 2 (h0 2)) M hM
    have : Module.Free L M' := Module.Free.of_divisionRing L M'
    have : FiniteDimensional L M' := Module.finite_of_finrank_eq_succ hM'deg
    obtain ⟨k, hk⟩ := hdeg 3 (h0 3) M' inferInstance hM'G
    rw [hM'deg] at hk
    have := congrArg (· % 2) hk
    simp [Nat.pow_mod] at this

end AlgebraicGeometry.SliceTrait.Hom
