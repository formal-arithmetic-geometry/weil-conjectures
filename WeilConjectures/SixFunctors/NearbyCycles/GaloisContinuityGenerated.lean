module

public import WeilConjectures.Mathlib.CategoryTheory.Presentable.Finite
public import WeilConjectures.SixFunctors.NearbyCycles.GaloisContinuityNoetherian

/-!

# Continuity of the Galois action on finitely generated cohomology sheaves of nearby cycles

Let `N` be a model of `X` with special fibre `X'` and `j : N.generic ⟶ N.total` quasi-compact and
quasi-separated, `h : N.generic ⟶ Spec L`, `Ω/L` a Galois extension, `T₀` a finite discrete ring
and `Λ = C(-, T₀)`. Let `C` be such that `Lε^* C` is bounded below of étale origin.

If the cohomology sheaf `Hᵠ(Ψ_{N_Ω} C)` of the nearby cycles of the Galois layer is generated by
finitely many finitely presentable objects (`CategoryTheory.IsGeneratedByFinitelyPresentable`),
then an open subgroup of `Gal(Ω/L)` acts trivially on it: there is a finite Galois subextension
`L'` such that every `σ` fixing `L'` pointwise acts as the identity
(`NearbyCyclesModel.exists_forall_homology_galoisLayerAction_eq_id_of_isGenerated`), and similarly
for finitely many degrees at once
(`NearbyCyclesModel.exists_forall_mem_finset_homology_galoisLayerAction_eq_id_of_isGenerated`).

This is the argument of `NearbyCyclesModel.exists_forall_homology_galoisLayerAction_eq_id`, with
the noetherianity of `Hᵠ(Ψ_{N_Ω} C)` (which fails for pro-étale sheaves in general) replaced by
finite generation: by continuity
(`NearbyCyclesModel.nonempty_isColimit_homology_nearbyCycles_galoisTower`), `Hᵠ(Ψ_{N_Ω} C)` is the
filtered colimit of the cohomology sheaves of the finite layers, and the colimit is attained at
some level `L'` (`CategoryTheory.IsGeneratedByFinitelyPresentable.exists_epi_ι`), on which `σ`
acts through its restriction to `L'`, i.e. trivially.
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped CategoryTheory.Functor CategoryTheory.Obj

-- Reuse the tensor existence proofs when elaborating the derived pullbacks in this file.
private theorem generatedContinuity_hasTensor₄ObjExt (S : AlgebraicGeometry.Scheme.{u})
    (R : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology S) Ab.{u + 1})
    [MonObj R] [IsCommMonObj R] :
    ∀ P Q R₁ S₁ : GradedObject ℤ (Mod (Sheaf
      (AlgebraicGeometry.Scheme.ProEt.topology S) Ab.{u + 1}) R),
      GradedObject.HasTensor₄ObjExt P Q R₁ S₁ := by
  infer_instance

private theorem generatedContinuity_hasGoodTensor₁₂Tensor (S : AlgebraicGeometry.Scheme.{u})
    (R : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology S) Ab.{u + 1})
    [MonObj R] [IsCommMonObj R] :
    ∀ P Q R₁ : GradedObject ℤ (Mod (Sheaf
      (AlgebraicGeometry.Scheme.ProEt.topology S) Ab.{u + 1}) R),
      GradedObject.HasGoodTensor₁₂Tensor P Q R₁ := by
  infer_instance

private theorem generatedContinuity_hasGoodTensorTensor₂₃ (S : AlgebraicGeometry.Scheme.{u})
    (R : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology S) Ab.{u + 1})
    [MonObj R] [IsCommMonObj R] :
    ∀ P Q R₁ : GradedObject ℤ (Mod (Sheaf
      (AlgebraicGeometry.Scheme.ProEt.topology S) Ab.{u + 1}) R),
      GradedObject.HasGoodTensorTensor₂₃ P Q R₁ := by
  infer_instance

/-- Cancel an epimorphism after applying functors, and transport through an intertwining iso. -/
private lemma map_eq_of_epi_comp_of_intertwining
    {C D E : Type*} [Category* C] [Category* D] [Category* E]
    (Q : C ⥤ D) (F : D ⥤ E) {A B : C} {Z : D}
    (i : A ⟶ B) [hi : Epi ((Q ⋙ F).map i)] (e : Q.obj B ≅ Z)
    {u v : B ⟶ B} {x y : Z ⟶ Z} (huv : i ≫ u = i ≫ v)
    (hx : e.hom ≫ x = Q.map u ≫ e.hom) (hy : e.hom ≫ y = Q.map v ≫ e.hom) :
    F.map x = F.map y := by
  have h : (Q ⋙ F).map u = (Q ⋙ F).map v := by
    apply (cancel_epi ((Q ⋙ F).map i)).1
    simpa only [Functor.map_comp] using congrArg (Q ⋙ F).map huv
  apply (cancel_epi (F.map e.hom)).1
  rw [← F.map_comp, ← F.map_comp, hx, hy, F.map_comp, F.map_comp]
  exact congrArg (fun f ↦ f ≫ F.map e.hom) h

namespace AlgebraicGeometry.ProEtale.CondensedRing.NearbyCyclesModel

open Scheme

variable {X X' : Scheme.{u}} (N : NearbyCyclesModel X X') {L : Type u} [Field L]
  (h : N.generic ⟶ Spec (.of L)) (Ω : Type u) [Field Ω] [Algebra L Ω] [IsGalois L Ω]
  (T₀ : Type) [TopologicalSpace T₀] [CommRing T₀] [IsTopologicalRing T₀]
  [DiscreteTopology T₀] [Finite T₀]

/-- **Continuity of the Galois action on a finitely generated cohomology sheaf of nearby cycles**
(torsion coefficients). If `Lε^* C` is bounded below of étale origin and `Hᵠ(Ψ_{N_Ω} C)` is
generated by finitely many finitely presentable objects, there is a finite Galois subextension
`L'` of `Ω/L` such that every `σ ∈ Gal(Ω/L)` fixing `L'` pointwise acts trivially on
`Hᵠ(Ψ_{N_Ω} C)`. -/
theorem exists_forall_homology_galoisLayerAction_eq_id_of_isGenerated [QuasiCompact N.j]
    [QuasiSeparated N.j]
    (C : DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T₀) X)))
    (hC : DerivedCategory.plusEtaleOrigin (ModuleCat.{u + 1} (ULift.{u + 1} T₀)) N.generic
      ((finiteCoefficientDerivedEquivalence N.generic T₀).functor.obj
        (L((N.ε)^*⟦Profinite.continuousMapRingObj T₀⟧).obj C)))
    (q : ℤ) (hfg : IsGeneratedByFinitelyPresentable.{u} ((DerivedCategory.homologyFunctor _ q).obj
      (((N.galoisLayer h Ω).nearbyCycles (Profinite.continuousMapRingObj T₀)).obj
        (L((𝟙 X)^*⟦Profinite.continuousMapRingObj T₀⟧).obj C)))) :
    ∃ L' : FiniteGaloisIntermediateField L Ω, ∀ σ : Ω ≃ₐ[L] Ω, (∀ x : L', σ x = x) →
      (DerivedCategory.homologyFunctor _ q).map
        (N.galoisLayerAction (Profinite.continuousMapRingObj T₀) h Ω σ
          (L((𝟙 X)^*⟦Profinite.continuousMapRingObj T₀⟧).obj C)) = 𝟙 _ := by
  have hcomplex := exists_complex_of_plusEtaleOrigin T₀ _ hC
  obtain ⟨K, a, hKa, hterms, ⟨e⟩⟩ := hcomplex
  choose F₀ hF₀ using hterms
  have hKe (n : ℤ) := essImage_comparisonUpperStar_X T₀ (K.X n) (F₀ n) (hF₀ n).some
  have hK (n : ℤ) :=
    rightAcyclic_condensedRingLowerStar_upperStar_of_iso (Ω := Ω) T₀ h (K.X n) (F₀ n) (hF₀ n)
  have hΦ := N.nonempty_isColimit_homology_nearbyCycles_galoisTower T₀ h Ω K a hKe q
  obtain ⟨hΦ⟩ := hΦ
  let H := DerivedCategory.homologyFunctor
    (Mod (Sheaf (Scheme.ProEt.topology X') Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T₀) X')) q
  have := generatedContinuity_hasTensor₄ObjExt N.total
    (condensedRingObj (Profinite.continuousMapRingObj T₀) N.total)
  have := generatedContinuity_hasGoodTensor₁₂Tensor N.total
    (condensedRingObj (Profinite.continuousMapRingObj T₀) N.total)
  have := generatedContinuity_hasGoodTensorTensor₂₃ N.total
    (condensedRingObj (Profinite.continuousMapRingObj T₀) N.total)
  let Ψ := R((N.j)_*⟦Profinite.continuousMapRingObj T₀⟧) ⋙
    L((N.i)^*⟦Profinite.continuousMapRingObj T₀⟧) ⋙ H
  let Φ := DerivedCategory.Q ⋙ Ψ
  let eK := GaloisTower.derivedTraceIso (Profinite.continuousMapRingObj T₀) K a hK _ e
  let κ := N.galoisLayerExchangeIso h Ω (Profinite.continuousMapRingObj T₀) C
  have hgen : IsGeneratedByFinitelyPresentable.{u} (Φ.mapCocone
      ((galoisTower Ω h).complexCocone (Profinite.continuousMapRingObj T₀) K)).pt :=
    hfg.of_iso ((Ψ.mapIso eK) ≪≫ H.mapIso κ).symm
  have hj_exists := hgen.exists_epi_ι hΦ
  obtain ⟨j, hj⟩ := hj_exists
  let L' : FiniteGaloisIntermediateField L Ω := j
  refine ⟨L', fun σ hσ ↦ ?_⟩
  have hU (τ : Ω ≃ₐ[L] Ω) (hτ : ∀ x : L', τ x = x) :=
    (galoisTower Ω h).complexCocone_ι_app_comp_unitTransport _ K _
      (pullbackAction_fst h _ specGaloisAction_comp τ) j 1
      (restrictNormal_eq_one_of_forall_apply_eq Ω L' τ hτ ▸
        pullbackAction_comp_galoisLevelProjection h L' τ)
  have he (τ : Ω ≃ₐ[L] Ω) :=
    GaloisTower.derivedTraceIso_hom_comp_derivedUnitTransport
      (Profinite.continuousMapRingObj T₀) K a hK _ e
      (pullbackAction h _ specGaloisAction_comp τ)
      (pullbackAction_fst h _ specGaloisAction_comp τ)
  have hA := map_eq_of_epi_comp_of_intertwining (hi := hj) DerivedCategory.Q Ψ
    (((galoisTower Ω h).complexCocone (Profinite.continuousMapRingObj T₀) K).ι.app j) eK
    ((hU σ hσ).trans (hU 1 fun _ ↦ rfl).symm) (he σ) (he 1)
  have hact (τ : Ω ≃ₐ[L] Ω) := congrArg H.map
    (galoisLayerAut_autAction (Profinite.continuousMapRingObj T₀) N h Ω τ C)
  simp only [H.map_comp] at hact
  exact (hact σ).trans ((congrArg (fun f ↦ H.map κ.inv ≫ f ≫ H.map κ.hom) hA).trans
    ((hact 1).symm.trans ((congrArg H.map
      (N.galoisLayerAction_one (Profinite.continuousMapRingObj T₀) h Ω _)).trans (H.map_id _))))

/-- **Continuity of the Galois action on finitely generated cohomology sheaves of nearby
cycles**, for finitely many degrees at once: if the `Hᵠ(Ψ_{N_Ω} C)` are generated by finitely
presentable objects for `q ∈ s`, there is a single finite Galois subextension `L'` such that every
`σ` fixing `L'` pointwise acts trivially on all of them. -/
theorem exists_forall_mem_finset_homology_galoisLayerAction_eq_id_of_isGenerated
    [QuasiCompact N.j] [QuasiSeparated N.j]
    (C : DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj (Profinite.continuousMapRingObj T₀) X)))
    (hC : DerivedCategory.plusEtaleOrigin (ModuleCat.{u + 1} (ULift.{u + 1} T₀)) N.generic
      ((finiteCoefficientDerivedEquivalence N.generic T₀).functor.obj
        (L((N.ε)^*⟦Profinite.continuousMapRingObj T₀⟧).obj C)))
    (s : Finset ℤ) (hs : ∀ q ∈ s, IsGeneratedByFinitelyPresentable.{u}
      ((DerivedCategory.homologyFunctor _ q).obj
        (((N.galoisLayer h Ω).nearbyCycles (Profinite.continuousMapRingObj T₀)).obj
          (L((𝟙 X)^*⟦Profinite.continuousMapRingObj T₀⟧).obj C)))) :
    ∃ L' : FiniteGaloisIntermediateField L Ω, ∀ q ∈ s, ∀ σ : Ω ≃ₐ[L] Ω, (∀ x : L', σ x = x) →
      (DerivedCategory.homologyFunctor _ q).map
        (N.galoisLayerAction (Profinite.continuousMapRingObj T₀) h Ω σ
          (L((𝟙 X)^*⟦Profinite.continuousMapRingObj T₀⟧).obj C)) = 𝟙 _ := by
  choose L' hL' using fun (q : ℤ) (hq : q ∈ s) ↦
    N.exists_forall_homology_galoisLayerAction_eq_id_of_isGenerated h Ω T₀ C hC q (hs q hq)
  refine ⟨s.attach.sup fun q ↦ L' q.1 q.2, fun q hq σ hσ ↦ hL' q hq σ fun x ↦
    hσ ⟨x, Finset.le_sup (f := fun q : s ↦ L' q.1 q.2) (s.mem_attach ⟨q, hq⟩) x.2⟩⟩

end AlgebraicGeometry.ProEtale.CondensedRing.NearbyCyclesModel
