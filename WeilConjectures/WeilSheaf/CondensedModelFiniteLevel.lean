module

public import Mathlib.FieldTheory.Finite.GaloisField
public import WeilConjectures.WeilSheaf.CondensedModelDescent

/-!
# Descent of morphisms from the finite levels of the geometric fibre

Let `k` be a finite field, `f : X₀ ⟶ Spec k` and `K` a finite extension of `k` (for instance
`FiniteField.galoisExtension k n = 𝔽_{qⁿ}`). The *finite level* `X₀ ⊗_k K = X₀ ×_{Spec k} Spec K`
(`AlgebraicGeometry.Scheme.Hom.finiteLevel`) carries the Galois action `𝟙 × Spec σ` of
`Gal(K / k)` (`AlgebraicGeometry.Scheme.Hom.finiteLevelGaloisMap`), in particular the finite-level
Frobenius `Fr_K = 𝟙 × Spec γ` for the geometric Frobenius `γ = (x ↦ x ^ q)⁻¹`
(`AlgebraicGeometry.Scheme.Hom.finiteLevelFrobenius`). This file supplies the finite-level input
of Galois descent along the geometric fibre `X̄ = X₀ ⊗_k k̄ ⟶ X₀`:

1. **Finite Galois coverings of fields.** For a finite Galois extension `K / k`, the action of
   `Gal(K / k)` on `Spec K ⟶ Spec k` is Galois in the sense of
   `AlgebraicGeometry.ProEtale.IsGaloisAction`
   (`AlgebraicGeometry.ProEtale.isGaloisAction_spec_map`).
   Rather than decomposing `K ⊗_k K ≅ ∏_σ K` we argue with a primitive element `α`: for two
   `k`-algebra maps `φ, ψ : K → Γ(T, 𝒪_T)`, the identity `∏_τ (ψ α - φ (τ α)) = 0`
   (`IsGalois.prod_sub_eq_zero`) shows that the basic opens
   `D(∏_{τ ≠ σ} (ψ α - φ (τ α)))` cover `T` (look at residue fields), and on the `σ`-th of them
   `ψ = φ ∘ σ`.
2. **Base change.** Galois actions are stable under base change
   (`AlgebraicGeometry.ProEtale.IsGaloisAction.pullback_of_comp_eq`); hence the positive powers
   of `Fr_K` form a Galois action on `q_K : X₀ ⊗_k K ⟶ X₀`
   (`AlgebraicGeometry.ProEtale.isGaloisAction_finiteLevelFrobeniusPow`), the Galois group of a
   finite extension of finite fields being generated by the Frobenius
   (`FiniteField.exists_geometricFrobeniusAlgEquivOfAlgebraic_pow_succ_eq`).
3. **Compatibility with the geometric fibre.** For a `k`-embedding `θ : K ↪ k̄`, the morphism
   `ι = 𝟙 × Spec θ : X̄ ⟶ X₀ ⊗_k K` (`AlgebraicGeometry.Scheme.Hom.geometricFiberToFiniteLevel`)
   lies over `X₀` and intertwines the geometric Galois Frobenius `Fr` of `X̄` with `Fr_K`:
   `Fr ≫ ι = ι ≫ Fr_K`
   (`AlgebraicGeometry.Scheme.Hom.geometricGaloisFrobenius_hom_comp_geometricFiberToFiniteLevel`).
4. **Descent from a finite level.** A morphism `q_K^* M ⟶ q_K^* N` of module objects over a
   condensed ring which commutes with `Fr_K` is `q_K^* φ` for a unique `φ : M ⟶ N`
   (`AlgebraicGeometry.ProEtale.CondensedRing.existsUnique_upperStar_finiteLevelProj_map_eq`).

The remaining (profinite) step of the descent along `X̄ ⟶ X₀` is to show that an `Fr`-invariant
morphism `p^* M ⟶ p^* N` between constructible sheaves is of the form `ι^*` of an `Fr_K`-invariant
morphism at some finite level `K`.
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Limits Polynomial

open scoped CategoryTheory.Obj

namespace IsGalois

variable {k K : Type*} [Field k] [Field K] [Algebra k K] [FiniteDimensional k K] [IsGalois k K]
  {R : Type*} [CommRing R] (φ ψ : K →+* R)

/-- For a finite Galois extension `K / k` and `α ∈ K`, the polynomial `∏_τ (X - τ α)` has its
coefficients in `k`, so it has the same image under two ring homomorphisms `K →+* R` which agree
on `k`. -/
lemma map_prod_X_sub_C_eq (h : φ.comp (algebraMap k K) = ψ.comp (algebraMap k K)) (α : K) :
    (∏ τ : Gal(K/k), (X - C (τ α))).map φ = (∏ τ : Gal(K/k), (X - C (τ α))).map ψ := by
  set Q := ∏ τ : Gal(K/k), (X - C (τ α))
  have hQ (σ : Gal(K/k)) : Q.map (σ : K →+* K) = Q := by
    simp only [Q, Polynomial.map_prod, Polynomial.map_sub, map_X, map_C]
    exact Fintype.prod_equiv (Equiv.mulLeft σ) _ _ fun τ ↦ by simp
  ext j
  have hj : Q.coeff j ∈ (⊥ : IntermediateField k K) := by
    rw [mem_bot_iff_fixed]
    intro σ
    simpa using congrArg (coeff · j) (hQ σ)
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hj
  rw [coeff_map, coeff_map, ← hc]
  exact congrArg (· c) h

/-- For a finite Galois extension `K / k`, two ring homomorphisms `φ ψ : K →+* R` which agree on
`k` satisfy `∏_τ (ψ α - φ (τ α)) = 0`: `ψ α` is a root of the image under `φ` of the polynomial
`∏_τ (X - τ α)` with coefficients in `k`. -/
lemma prod_sub_eq_zero (h : φ.comp (algebraMap k K) = ψ.comp (algebraMap k K)) (α : K) :
    ∏ τ : Gal(K/k), (ψ α - φ (τ α)) = 0 := by
  have := congrArg (eval (ψ α)) (map_prod_X_sub_C_eq φ ψ h α)
  rw [eval_map, eval_map, eval₂_at_apply] at this
  simp only [eval₂_finsetProd, eval₂_sub, eval₂_X, eval₂_C, eval_prod, eval_sub, eval_X,
    eval_C] at this
  rw [this, Finset.prod_eq_zero (Finset.mem_univ 1) (by simp), map_zero]

variable (pb : PowerBasis k K) [DecidableEq Gal(K/k)]

/-- The factor `ψ α - φ (σ α)` of the vanishing product `∏_τ (ψ α - φ (τ α))`
(`IsGalois.prod_sub_eq_zero`) is annihilated by the product of the other factors. -/
lemma mul_prod_erase_sub_eq_zero (h : φ.comp (algebraMap k K) = ψ.comp (algebraMap k K))
    (α : K) (σ : Gal(K/k)) :
    (ψ α - φ (σ α)) * ∏ τ ∈ Finset.univ.erase σ, (ψ α - φ (τ α)) = 0 := by
  rw [Finset.mul_prod_erase _ (fun τ : Gal(K/k) ↦ ψ α - φ (τ α)) (Finset.mem_univ σ)]
  exact prod_sub_eq_zero φ ψ h α

/-- For two ring homomorphisms `φ ψ : K →+* R` which agree on `k` and a ring homomorphism `ε` from
`R` to a field, one of the products `∏_{τ ≠ σ} (ψ α - φ (τ α))` for the generator `α` of a power
basis has nonzero image under `ε`: `ε ψ α = ε φ (σ α)` for some `σ`, and the `τ α` are pairwise
distinct. -/
lemma exists_map_prod_erase_sub_ne_zero (h : φ.comp (algebraMap k K) = ψ.comp (algebraMap k K))
    {F : Type*} [Field F] (ε : R →+* F) :
    ∃ σ : Gal(K/k), ε (∏ τ ∈ Finset.univ.erase σ, (ψ pb.gen - φ (τ pb.gen))) ≠ 0 := by
  have h₀ := congrArg ε (prod_sub_eq_zero φ ψ h pb.gen)
  rw [map_prod, map_zero, Finset.prod_eq_zero_iff] at h₀
  obtain ⟨σ, -, hσ⟩ := h₀
  rw [map_sub, sub_eq_zero] at hσ
  refine ⟨σ, ?_⟩
  rw [map_prod, Finset.prod_ne_zero_iff]
  intro τ hτ
  rw [map_sub, hσ, ← map_sub, ← map_sub, ← RingHom.comp_apply,
    map_ne_zero_iff _ (ε.comp φ).injective, sub_ne_zero]
  intro he
  refine (Finset.ne_of_mem_erase hτ) (AlgEquiv.coe_toAlgHom_injective ?_)
  exact pb.algHom_ext he.symm

/-- For two ring homomorphisms `φ ψ : K →+* R` which agree on `k`, if a ring homomorphism
`r : R →+* S` makes `∏_{τ ≠ σ} (ψ α - φ (τ α))` invertible, for the generator `α` of a power basis,
then `r ∘ ψ = r ∘ φ ∘ σ`. -/
lemma comp_eq_of_isUnit (h : φ.comp (algebraMap k K) = ψ.comp (algebraMap k K))
    {S : Type*} [CommRing S] (r : R →+* S) (σ : Gal(K/k))
    (hu : IsUnit (r (∏ τ ∈ Finset.univ.erase σ, (ψ pb.gen - φ (τ pb.gen))))) :
    r.comp ψ = r.comp (φ.comp (σ : K →+* K)) := by
  have h₀ := congrArg r (mul_prod_erase_sub_eq_zero φ ψ h pb.gen σ)
  rw [map_mul, map_zero, hu.mul_left_eq_zero, map_sub, sub_eq_zero] at h₀
  let : Algebra k S := ((r.comp φ).comp (algebraMap k K)).toAlgebra
  let f₁ : K →ₐ[k] S :=
    { r.comp ψ with
      commutes' c := by
        simp only [RingHom.toMonoidHom_eq_coe, OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe,
          MonoidHom.coe_ofClass, RingHom.comp_apply, RingHom.algebraMap_toAlgebra]
        rw [← RingHom.comp_apply ψ, ← h, RingHom.comp_apply] }
  let f₂ : K →ₐ[k] S :=
    { r.comp (φ.comp (σ : K →+* K)) with
      commutes' c := by simp [RingHom.algebraMap_toAlgebra] }
  have := pb.algHom_ext (f := f₁) (g := f₂) h₀
  exact RingHom.ext fun x ↦ congrArg (· x) this

end IsGalois

namespace FiniteField

variable {k : Type u} [Field k] [Fintype k] (K : Type u) [Field K] [Algebra k K]

/-- Every element of the Galois group of a finite extension of a finite field is a positive power
of the geometric Frobenius. -/
theorem exists_geometricFrobeniusAlgEquivOfAlgebraic_pow_succ_eq [FiniteDimensional k K]
    (τ : Gal(K/k)) : ∃ m : ℕ, geometricFrobeniusAlgEquivOfAlgebraic k K ^ (m + 1) = τ := by
  have : Finite K := Module.finite_of_finite k
  have hτ : τ ∈ Subgroup.zpowers (geometricFrobeniusAlgEquivOfAlgebraic k K) := by
    rw [geometricFrobeniusAlgEquivOfAlgebraic_eq_inv, Subgroup.zpowers_inv]
    obtain ⟨j, rfl⟩ := (bijective_frobeniusAlgEquivOfAlgebraic_pow k K).2 τ
    exact Subgroup.npow_mem_zpowers _ _
  rw [← mem_powers_iff_mem_zpowers] at hτ
  obtain ⟨j, rfl⟩ := hτ
  have := orderOf_pos (geometricFrobeniusAlgEquivOfAlgebraic k K)
  refine ⟨j + orderOf (geometricFrobeniusAlgEquivOfAlgebraic k K) - 1, ?_⟩
  rw [Nat.sub_add_cancel (by omega), pow_add, pow_orderOf_eq_one, mul_one]

variable {K} in
/-- A `k`-embedding `θ : K ↪ L` of algebraic extensions of a finite field `k` intertwines the
geometric Frobenius of `K` and of `L`. -/
theorem algHom_geometricFrobeniusAlgEquivOfAlgebraic_apply [Algebra.IsAlgebraic k K]
    {L : Type u} [Field L] [Algebra k L] [Algebra.IsAlgebraic k L] (θ : K →ₐ[k] L) (x : K) :
    θ (geometricFrobeniusAlgEquivOfAlgebraic k K x) =
      geometricFrobeniusAlgEquivOfAlgebraic k L (θ x) := by
  obtain ⟨y, rfl⟩ := (frobeniusAlgEquivOfAlgebraic k K).surjective x
  simp only [geometricFrobeniusAlgEquivOfAlgebraic_eq_inv, AlgEquiv.aut_inv,
    AlgEquiv.symm_apply_apply]
  rw [AlgEquiv.eq_symm_apply, coe_frobeniusAlgEquivOfAlgebraic, coe_frobeniusAlgEquivOfAlgebraic,
    map_pow]

end FiniteField

namespace AlgebraicGeometry.Scheme

/-- A section `f` of a scheme over `U` becomes a unit on every open `V ⊆ U` contained in the basic
open `D(f)`. -/
lemma isUnit_presheaf_map_of_le_basicOpen (T : Scheme.{u}) {U V : T.Opens} (f : Γ(T, U))
    (hV : V ≤ T.basicOpen f) (hVU : V ≤ U) : IsUnit (T.presheaf.map (homOfLE hVU).op f) := by
  have : T.presheaf.map (homOfLE hVU).op =
      T.presheaf.map (homOfLE (T.basicOpen_le f)).op ≫ T.presheaf.map (homOfLE hV).op := by
    rw [← Functor.map_comp]
    rfl
  rw [this, CommRingCat.comp_apply]
  exact (T.toRingedSpace.isUnit_res_basicOpen f).map _

/-- Two morphisms `T ⟶ Spec R` agree if the induced ring homomorphisms `R ⟶ Γ(T, ⊤)` agree. -/
lemma hom_ext_of_ΓSpecIso_inv_comp_appTop {R : CommRingCat.{u}} {T : Scheme.{u}}
    {a b : T ⟶ Spec R}
    (h : (ΓSpecIso R).inv ≫ a.appTop = (ΓSpecIso R).inv ≫ b.appTop) : a = b := by
  refine ext_of_isAffine ?_
  rwa [cancel_epi] at h

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.ProEtale

/-- **Finite Galois coverings of fields.** For a finite Galois extension `K / k`, the action of
`Gal(K / k)` on `Spec K` over `Spec k` is Galois: if `ρ i = Spec (σ i)` for a family `σ` which
exhausts `Gal(K / k)`, then `ρ` is a Galois action on `Spec K ⟶ Spec k`. -/
theorem isGaloisAction_spec_map {k K : Type u} [Field k] [Field K] [Algebra k K]
    [FiniteDimensional k K] [IsGalois k K] {Γ : Type u} (ρ : Γ → (Spec (.of K) ⟶ Spec (.of K)))
    (σ : Γ → Gal(K/k)) (hρσ : ∀ i, ρ i = Spec.map (CommRingCat.ofHom (σ i : K →+* K)))
    (hσ : Function.Surjective σ) :
    IsGaloisAction (Spec.map (CommRingCat.ofHom (algebraMap k K))) ρ := by
  classical
  intro T a b hab
  let pb := Field.powerBasisOfFiniteOfSeparable k K
  let φ : K →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop).hom
  let ψ : K →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ b.appTop).hom
  have hφψ : φ.comp (algebraMap k K) = ψ.comp (algebraMap k K) := by
    have := congrArg (fun c ↦ ((Scheme.ΓSpecIso (.of k)).inv ≫ c.appTop).hom) hab
    simp only [Scheme.Hom.comp_appTop, ← Scheme.ΓSpecIso_inv_naturality_assoc,
      CommRingCat.hom_comp, CommRingCat.hom_ofHom] at this
    exact this
  let d (τ : Gal(K/k)) : Γ(T, ⊤) := ∏ τ' ∈ Finset.univ.erase τ, (ψ pb.gen - φ (τ' pb.gen))
  refine ⟨fun i ↦ T.basicOpen (d (σ i)), fun x ↦ ?_, fun i ↦ ?_⟩
  · obtain ⟨τ, hτ⟩ := IsGalois.exists_map_prod_erase_sub_ne_zero φ ψ pb hφψ
      (T.evaluation ⊤ x (by trivial)).hom
    obtain ⟨i, rfl⟩ := hσ τ
    exact ⟨i, (T.evaluation_ne_zero_iff_mem_basicOpen (U := ⊤) x (by trivial) _).mp hτ⟩
  · have hu : IsUnit ((T.basicOpen (d (σ i))).ι.appTop.hom (d (σ i))) := by
      rw [Scheme.Opens.ι_appTop]
      exact T.isUnit_presheaf_map_of_le_basicOpen _ (Scheme.Opens.ι_image_top _).le _
    have key := IsGalois.comp_eq_of_isUnit φ ψ pb hφψ _ (σ i) hu
    rw [hρσ i]
    refine Scheme.hom_ext_of_ΓSpecIso_inv_comp_appTop ?_
    simp only [Scheme.Hom.comp_appTop, Category.assoc, ← Scheme.ΓSpecIso_inv_naturality_assoc]
    ext1
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact key

/-- **Galois actions are stable under base change.** If `ρ` is a Galois action on `g : Y ⟶ X`,
then for `h : X' ⟶ X` the endomorphisms `ρ' i = 𝟙 × ρ i` of `X' ×_X Y` form a Galois action on the
projection `X' ×_X Y ⟶ X'`. -/
theorem IsGaloisAction.pullback_of_comp_eq {X Y X' : Scheme.{u}} {g : Y ⟶ X} (h : X' ⟶ X)
    {Γ : Type u} {ρ : Γ → (Y ⟶ Y)} (hgal : IsGaloisAction g ρ)
    (ρ' : Γ → (pullback h g ⟶ pullback h g))
    (hfst : ∀ i, ρ' i ≫ pullback.fst h g = pullback.fst h g)
    (hsnd : ∀ i, ρ' i ≫ pullback.snd h g = pullback.snd h g ≫ ρ i) :
    IsGaloisAction (pullback.fst h g) ρ' := by
  intro T a b hab
  obtain ⟨U, hU, hUρ⟩ := hgal T (a ≫ pullback.snd h g) (b ≫ pullback.snd h g) (by
    rw [Category.assoc, Category.assoc, ← pullback.condition, reassoc_of% hab])
  refine ⟨U, hU, fun i ↦ pullback.hom_ext ?_ ?_⟩
  · rw [Category.assoc, Category.assoc, Category.assoc, hfst, hab]
  · rw [Category.assoc, Category.assoc, Category.assoc, hsnd, hUρ i, Category.assoc]

end AlgebraicGeometry.ProEtale

namespace AlgebraicGeometry.Scheme.Hom

section Field

variable {k : Type u} [Field k] {X₀ : Scheme.{u}} (f : X₀ ⟶ Spec (.of k))
  (K : Type u) [Field K] [Algebra k K]

/-- The finite level `X₀ ⊗_k K = X₀ ×_{Spec k} Spec K` of a scheme `X₀` over a field `k`, for a
field extension `K` of `k` (typically the extension `FiniteField.galoisExtension k n` of degree `n`
of a finite field). -/
def finiteLevel : Scheme.{u} :=
  pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))

/-- The projection `q_K : X₀ ⊗_k K ⟶ X₀`. -/
def finiteLevelProj : f.finiteLevel K ⟶ X₀ :=
  pullback.fst _ _

/-- The structure morphism `X₀ ⊗_k K ⟶ Spec K`. -/
def finiteLevelToSpec : f.finiteLevel K ⟶ Spec (.of K) :=
  pullback.snd _ _

/-- Two morphisms into the finite level `X₀ ⊗_k K` agree if their composites with the projection
to `X₀` and with the structure morphism to `Spec K` agree. -/
lemma finiteLevel_hom_ext {T : Scheme.{u}} {a b : T ⟶ f.finiteLevel K}
    (h₁ : a ≫ f.finiteLevelProj K = b ≫ f.finiteLevelProj K)
    (h₂ : a ≫ f.finiteLevelToSpec K = b ≫ f.finiteLevelToSpec K) : a = b :=
  pullback.hom_ext h₁ h₂

/-- The projection `X₀ ⊗_k K ⟶ X₀` is weakly étale for a separable algebraic extension `K / k`: it
is the base change of `Spec K ⟶ Spec k`, and `K` is an ind-étale `k`-algebra. -/
instance weaklyEtale_finiteLevelProj [Algebra.IsSeparable k K] :
    WeaklyEtale (f.finiteLevelProj K) := by
  have : Algebra.IndEtale k K := Algebra.IndEtale.of_isSeparable k K
  rw [finiteLevelProj]
  infer_instance

/-- The projection `X₀ ⊗_k K ⟶ X₀` is surjective. -/
instance surjective_finiteLevelProj : Surjective (f.finiteLevelProj K) := by
  have : Surjective (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
    ⟨fun _ ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩
  rw [finiteLevelProj]
  infer_instance

/-- The projection `X₀ ⊗_k K ⟶ X₀` is quasi-compact (it is affine). -/
instance quasiCompact_finiteLevelProj : QuasiCompact (f.finiteLevelProj K) := by
  rw [finiteLevelProj]
  infer_instance

variable {K}

/-- The Galois action `𝟙 × Spec σ` on `X₀ ⊗_k K` of a `k`-automorphism `σ` of `K`. -/
def finiteLevelGaloisMap (σ : Gal(K/k)) : f.finiteLevel K ⟶ f.finiteLevel K :=
  pullback.map _ _ _ _ (𝟙 X₀) (Spec.map (CommRingCat.ofHom (σ : K →+* K))) (𝟙 _) (by simp) (by
    rw [Category.comp_id, ← Spec.map_comp]
    congr 1
    ext c
    simp)

/-- The Galois action on `X₀ ⊗_k K` lies over `X₀`. -/
@[reassoc (attr := simp)]
lemma finiteLevelGaloisMap_comp_finiteLevelProj (σ : Gal(K/k)) :
    f.finiteLevelGaloisMap σ ≫ f.finiteLevelProj K = f.finiteLevelProj K := by
  simp [finiteLevelGaloisMap, finiteLevelProj]

/-- The Galois action `𝟙 × Spec σ` on `X₀ ⊗_k K` lies over `Spec σ`. -/
@[reassoc (attr := simp)]
lemma finiteLevelGaloisMap_comp_finiteLevelToSpec (σ : Gal(K/k)) :
    f.finiteLevelGaloisMap σ ≫ f.finiteLevelToSpec K =
      f.finiteLevelToSpec K ≫ Spec.map (CommRingCat.ofHom (σ : K →+* K)) := by
  simp [finiteLevelGaloisMap, finiteLevelToSpec]

/-- The Galois action on `X₀ ⊗_k K` is an action: `(𝟙 × Spec σ) ≫ (𝟙 × Spec τ) = 𝟙 × Spec (σ τ)`.
-/
lemma finiteLevelGaloisMap_comp (σ τ : Gal(K/k)) :
    f.finiteLevelGaloisMap σ ≫ f.finiteLevelGaloisMap τ = f.finiteLevelGaloisMap (σ * τ) := by
  refine f.finiteLevel_hom_ext K ?_ ?_
  · simp
  · simp only [Category.assoc, finiteLevelGaloisMap_comp_finiteLevelToSpec,
      finiteLevelGaloisMap_comp_finiteLevelToSpec_assoc, ← Spec.map_comp]
    rfl

variable (θ : K →ₐ[k] AlgebraicClosure k)

/-- The morphism `ι = 𝟙 × Spec θ : X̄ = X₀ ⊗_k k̄ ⟶ X₀ ⊗_k K` from the geometric fibre to a finite
level, for a `k`-embedding `θ : K ↪ k̄`. -/
def geometricFiberToFiniteLevel : f.geometricFiber ⟶ f.finiteLevel K :=
  pullback.map f (Scheme.specAlgebraicClosure k).hom f
    (Spec.map (CommRingCat.ofHom (algebraMap k K))) (𝟙 X₀)
    (Spec.map (CommRingCat.ofHom θ.toRingHom)) (𝟙 _) (by simp) (by
      simp only [Category.comp_id, Scheme.specAlgebraicClosure, Over.mk_hom, ← Spec.map_comp]
      congr 1
      ext c
      simp)

/-- `ι` lies over `X₀`: `ι ≫ q_K = p`. -/
@[reassoc (attr := simp)]
lemma geometricFiberToFiniteLevel_comp_finiteLevelProj :
    f.geometricFiberToFiniteLevel θ ≫ f.finiteLevelProj K = f.geometricFiberProj := by
  simp [geometricFiberToFiniteLevel, finiteLevelProj, geometricFiberProj]

/-- `ι` lies over `Spec θ`. -/
@[reassoc (attr := simp)]
lemma geometricFiberToFiniteLevel_comp_finiteLevelToSpec :
    f.geometricFiberToFiniteLevel θ ≫ f.finiteLevelToSpec K =
      f.geometricFiberToAlgebraicClosure ≫ Spec.map (CommRingCat.ofHom θ.toRingHom) := by
  simp [geometricFiberToFiniteLevel, finiteLevelToSpec, geometricFiberToAlgebraicClosure]

end Field

section FiniteField

variable {k : Type u} [Field k] [Fintype k] {X₀ : Scheme.{u}} (f : X₀ ⟶ Spec (.of k))
  (K : Type u) [Field K] [Algebra k K] [FiniteDimensional k K]

/-- The finite-level Frobenius `Fr_K = 𝟙 × Spec γ` of `X₀ ⊗_k K`, for the geometric Frobenius `γ`
of a finite extension `K` of the finite field `k`. -/
def finiteLevelFrobenius : f.finiteLevel K ⟶ f.finiteLevel K :=
  f.finiteLevelGaloisMap (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic k K)

/-- The positive powers `Fr_K ^ (m + 1) = 𝟙 × Spec (γ ^ (m + 1))` of the finite-level Frobenius. -/
def finiteLevelFrobeniusPow (m : ℕ) : f.finiteLevel K ⟶ f.finiteLevel K :=
  f.finiteLevelGaloisMap (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic k K ^ (m + 1))

/-- The finite-level Frobenius lies over `X₀`. -/
@[reassoc (attr := simp)]
lemma finiteLevelFrobenius_comp_finiteLevelProj :
    f.finiteLevelFrobenius K ≫ f.finiteLevelProj K = f.finiteLevelProj K :=
  f.finiteLevelGaloisMap_comp_finiteLevelProj _

lemma finiteLevelFrobeniusPow_zero :
    f.finiteLevelFrobeniusPow K 0 = f.finiteLevelFrobenius K := by
  rw [finiteLevelFrobeniusPow, zero_add, pow_one, finiteLevelFrobenius]

lemma finiteLevelFrobeniusPow_succ (m : ℕ) :
    f.finiteLevelFrobeniusPow K (m + 1) =
      f.finiteLevelFrobenius K ≫ f.finiteLevelFrobeniusPow K m := by
  rw [finiteLevelFrobeniusPow, finiteLevelFrobenius, finiteLevelFrobeniusPow,
    finiteLevelGaloisMap_comp, ← pow_succ']

variable {K} (θ : K →ₐ[k] AlgebraicClosure k)

/-- The geometric Frobenius `σ` of `Spec k̄` lies over the geometric Frobenius of `Spec K` along a
`k`-embedding `θ : K ↪ k̄`. -/
lemma specGeometricFrobenius_hom_comp_spec_map :
    (specGeometricFrobenius k).asIso.hom ≫ Spec.map (CommRingCat.ofHom θ.toRingHom) =
      Spec.map (CommRingCat.ofHom θ.toRingHom) ≫
        Spec.map (CommRingCat.ofHom
          (FiniteField.geometricFrobeniusAlgEquivOfAlgebraic k K : K →+* K)) := by
  rw [specGeometricFrobenius_hom, ← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext x
  exact (FiniteField.algHom_geometricFrobeniusAlgEquivOfAlgebraic_apply θ x).symm

/-- **The geometric fibre and the finite levels.** The morphism `ι = 𝟙 × Spec θ : X̄ ⟶ X₀ ⊗_k K`
intertwines the geometric Galois Frobenius `Fr` of `X̄` with the finite-level Frobenius:
`Fr ≫ ι = ι ≫ Fr_K`. -/
theorem geometricGaloisFrobenius_hom_comp_geometricFiberToFiniteLevel :
    f.geometricGaloisFrobenius.asIso.hom ≫ f.geometricFiberToFiniteLevel θ =
      f.geometricFiberToFiniteLevel θ ≫ f.finiteLevelFrobenius K := by
  refine f.finiteLevel_hom_ext K ?_ ?_
  · simp [finiteLevelFrobenius]
  · rw [Category.assoc, geometricFiberToFiniteLevel_comp_finiteLevelToSpec,
      geometricGaloisFrobenius_hom_comp_geometricFiberToAlgebraicClosure_assoc,
      specGeometricFrobenius_hom_comp_spec_map, Category.assoc, finiteLevelFrobenius,
      finiteLevelGaloisMap_comp_finiteLevelToSpec,
      geometricFiberToFiniteLevel_comp_finiteLevelToSpec_assoc]

end FiniteField

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.ProEtale

variable {k : Type u} [Field k] [Fintype k] {X₀ : Scheme.{u}} (f : X₀ ⟶ Spec (.of k))
  (K : Type u) [Field K] [Algebra k K] [FiniteDimensional k K]

/-- **The finite levels are Galois coverings with cyclic group generated by the Frobenius.** The
positive powers of the finite-level Frobenius `Fr_K = 𝟙 × Spec γ` form a Galois action on the
projection `q_K : X₀ ⊗_k K ⟶ X₀`, for a finite extension `K` of the finite field `k`. -/
theorem isGaloisAction_finiteLevelFrobeniusPow :
    IsGaloisAction (f.finiteLevelProj K)
      fun m : ULift.{u} ℕ ↦ f.finiteLevelFrobeniusPow K m.down := by
  have : Finite K := Module.finite_of_finite k
  have hsurj : Function.Surjective fun m : ULift.{u} ℕ ↦
      FiniteField.geometricFrobeniusAlgEquivOfAlgebraic k K ^ (m.down + 1) := fun τ ↦ by
    obtain ⟨m, hm⟩ := FiniteField.exists_geometricFrobeniusAlgEquivOfAlgebraic_pow_succ_eq K τ
    exact ⟨⟨m⟩, hm⟩
  exact IsGaloisAction.pullback_of_comp_eq f (isGaloisAction_spec_map _ _ (fun _ ↦ rfl) hsurj) _
    (fun m ↦ f.finiteLevelGaloisMap_comp_finiteLevelProj _)
    fun m ↦ f.finiteLevelGaloisMap_comp_finiteLevelToSpec _

namespace CondensedRing

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]

/-- **Descent of morphisms from a finite level.** Let `K` be a finite extension of the finite
field `k` (for instance `FiniteField.galoisExtension k n`) and `q_K : X₀ ⊗_k K ⟶ X₀` the
projection. A morphism `ψ : q_K^* M ⟶ q_K^* N` of module objects over `Λ` which commutes with the
finite-level Frobenius `Fr_K = 𝟙 × Spec γ`, i.e. with the canonical isomorphism
`Fr_K^* q_K^* ≅ (Fr_K ≫ q_K)^* = q_K^*`, is `q_K^* φ` for a unique `φ : M ⟶ N`. -/
theorem existsUnique_upperStar_finiteLevelProj_map_eq
    {M N : Mod (Sheaf (Scheme.ProEt.topology X₀) Ab.{u + 1}) (condensedRingObj Λ X₀)}
    (ψ : (f.finiteLevelProj K)^*⟦Λ⟧.obj M ⟶ (f.finiteLevelProj K)^*⟦Λ⟧.obj N)
    (hψ : (f.finiteLevelFrobenius K)^*⟦Λ⟧.map ψ ≫
        (upperStarComp Λ (f.finiteLevelFrobenius K) (f.finiteLevelProj K)).inv.app N ≫
        (upperStarCongr Λ (f.finiteLevelFrobenius_comp_finiteLevelProj K)).hom.app N =
      ((upperStarComp Λ (f.finiteLevelFrobenius K) (f.finiteLevelProj K)).inv.app M ≫
        (upperStarCongr Λ (f.finiteLevelFrobenius_comp_finiteLevelProj K)).hom.app M) ≫ ψ) :
    ∃! φ : M ⟶ N, (f.finiteLevelProj K)^*⟦Λ⟧.map φ = ψ :=
  existsUnique_upperStar_map_eq_of_isGaloisAction_pow Λ (f.finiteLevelProj K)
    (f.finiteLevelFrobenius_comp_finiteLevelProj K) (f.finiteLevelFrobeniusPow_zero K)
    (f.finiteLevelFrobeniusPow_succ K) (isGaloisAction_finiteLevelFrobeniusPow f K) ψ hψ

end CondensedRing

end AlgebraicGeometry.ProEtale
