/-! # Underived ringed-site presentation of native Weil sheaves

Source: the Frobenius action-site construction in the internal-Hom paragraph of
prose-10-20; Stacks 00W0 and 00YV.
-/

@[expose] public section
set_option autoImplicit false
universe u
open CategoryTheory CategoryTheory.Limits Opposite WeilConjectures
namespace AlgebraicGeometry.ProEtaleWeilSheaf

private theorem fixedPair_transport_equivalence
    {C D : Type*} [Category C] [Category D]
    {F : C ⥤ C} {G : D ⥤ D} (L : C ≌ D)
    (c : L.functor ⋙ G ≅ F ⋙ L.functor) :
    (Endofunctor.IsoAlgebra.mapOfNatIso c).IsEquivalence := by
  let T := Endofunctor.IsoAlgebra.mapOfNatIso c
  let ff : T.FullyFaithful :=
    Endofunctor.IsoAlgebra.fullyFaithfulMapOfNatIso c L.fullyFaithfulFunctor
  let : T.Full := ff.full
  let : T.Faithful := ff.faithful
  let : T.EssSurj := ⟨fun M ↦ by
    let B := L.inverse.obj M.carrier
    let b : L.functor.obj B ≅ M.carrier := L.counitIso.app M.carrier
    let t : F.obj B ≅ B := L.functor.preimageIso
      ((c.app B).symm ≪≫ G.mapIso b ≪≫ M.str ≪≫ b.symm)
    refine ⟨Endofunctor.IsoAlgebra.mk B t,
      ⟨ObjectProperty.isoMk _ (Endofunctor.Algebra.isoMk b ?_)⟩⟩
    change G.map b.hom ≫ M.str.hom =
      (c.hom.app B ≫ L.functor.map t.hom) ≫ b.hom
    simp [t, Category.assoc]⟩
  exact { }

private noncomputable def inverse_hom_comparison
    {A B : Type*} [Category A] [Category B] (E : B ≌ A)
    (HA : Aᵒᵖ × A ⥤ A) (HB : Bᵒᵖ × B ⥤ B)
    (h : HB ⋙ E.functor ≅ E.functor.op.prod E.functor ⋙ HA) :
    HA ⋙ E.inverse ≅ E.inverse.op.prod E.inverse ⋙ HB := by
  let e : (E.inverse.op.prod E.inverse) ⋙ (E.functor.op.prod E.functor) ≅
      𝟭 (Aᵒᵖ × A) := NatIso.prod (NatIso.op E.counitIso.symm) E.counitIso
  exact (Functor.leftUnitor (HA ⋙ E.inverse)).symm ≪≫
    Functor.isoWhiskerRight e.symm (HA ⋙ E.inverse) ≪≫
    Functor.isoWhiskerLeft (E.inverse.op.prod E.inverse)
      (Functor.isoWhiskerRight h.symm E.inverse) ≪≫
    Functor.isoWhiskerLeft ((E.inverse.op.prod E.inverse) ⋙ HB) E.unitIso.symm ≪≫
    (Functor.rightUnitor _)

/-- Native Weil sheaves admit an additive ringed-site presentation preserving the
underived internal Hom, naturally in both module variables.

Source: prose-10-20, internal-Hom paragraph; the action-site
part of native tensor lift steps 1--2; Stacks 00W0 and 00YV.
(blueprint: lem-sf-native-weil-ringed-presentation)

Proof: replace the geometric pro-etale site by its small model and identify
internal abelian module sheaves with sectionwise module sheaves. Postcomposition
by geometric Frobenius is a site equivalence. Its coefficient identification
relabels the continuous functions without changing their values. Form the
semidirect site with integer-labelled arrows and the topology generated by
ordinary covers. Restriction to degree-zero arrows identifies its module sheaves
with modules equipped with an invertible Frobenius action. Compose this
restriction equivalence with the small-site and internal-module equivalences to
obtain E. All three equivalences are additive on module maps. Internal Hom on
the action site restricts to ordinary internal Hom with contragredient action:
the action sends f to theta_target composed with Frobenius(f) composed with
inverse theta_source. This is precisely ihomBifunctor. Local evaluation and
precomposition identify the two Hom sheaves, naturally in source and target.
This is an underived statement; it constructs neither derived tensor nor an
adjunction on a derived category. The empty site and zero modules obey the same
restriction equivalence and Hom formulas. -/
theorem native_weil_ringed_presentation
    (k₀ : Type u) [Field k₀] [Finite k₀] (l : ℕ) [Fact l.Prime]
    [Fact (ringChar k₀ ≠ l)] (X : Scheme.{u})
    [X.Over (Spec (CommRingCat.of k₀))]
    [LocallyOfFiniteType (X ↘ Spec (CommRingCat.of k₀))]
    [QuasiCompact (X ↘ Spec (CommRingCat.of k₀))]
    [IsSeparated (X ↘ Spec (CommRingCat.of k₀))] :
    ∃ (C : Type (u + 1)) (_ : SmallCategory C) (J : GrothendieckTopology C)
      (R : Sheaf J CommRingCat.{u + 1})
      (E : ProEtaleWeilSheaf k₀ l X ≌ RingedTensorModules.{u + 1, u + 1, u + 1} J R),
      E.functor.Additive ∧ Nonempty
        (Functor.uncurry.obj (ihomBifunctor k₀ l X) ⋙ E.functor ≅
          (E.functor.op.prod E.functor) ⋙
            Functor.uncurry.obj (SheafOfModules.homFunctor (R := R))) := by
  obtain ⟨A⟩ := native_frobenius_ringed_model k₀ l X
  obtain ⟨P⟩ := TwistedActionRingedSite.presentation A.J A.s A.R A.a
  let _ := P.category
  have : (Endofunctor.IsoAlgebra.mapOfNatIso A.comparison).IsEquivalence :=
    fixedPair_transport_equivalence A.E A.comparison
  have : (A.toWeil P).IsEquivalence := inferInstanceAs
    (P.modules.functor ⋙ Endofunctor.IsoAlgebra.mapOfNatIso A.comparison).IsEquivalence
  have hK : (A.toWeil P).Additive := by
    constructor
    intro M N f g
    apply Endofunctor.IsoAlgebra.hom_ext
    change A.E.functor.map (P.modules.functor.map (f + g)).hom.f =
      A.E.functor.map (P.modules.functor.map f).hom.f +
        A.E.functor.map (P.modules.functor.map g).hom.f
    rw [P.modules_add]
    exact A.additive.map_add
  let K := (A.toWeil P).asEquivalence
  have : K.functor.Additive := hK
  have hInv : K.inverse.Additive := K.inverse_additive
  obtain ⟨h⟩ := native_action_site_hom_comparison A P
  exact ⟨TwistedActionRingedSite.Object A.C, inferInstance, P.topology,
    P.coefficient, K.symm, hInv,
    ⟨inverse_hom_comparison K (Functor.uncurry.obj (ihomBifunctor k₀ l X))
      (Functor.uncurry.obj (SheafOfModules.homFunctor (R := P.coefficient))) h⟩⟩

end AlgebraicGeometry.ProEtaleWeilSheaf
