module

public import WeilConjectures.CategoryTheory.Adjunction.ProjectionMorphismDualizable
public import WeilConjectures.PoincareDuality.ProjectionFormulaMonoidal
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.Derived.BoundedConstructibleSmoothBaseChange
public import WeilConjectures.TraceFormula.ConstructibleGenerationLowerStar
public import WeilConjectures.TraceFormula.PurityBaseChange
public import WeilConjectures.TraceFormula.PurityOrientation
public import WeilConjectures.TraceFormula.PurityTensorMapDualizable

/-!

# Smooth purity for `ℚ̄_ℓ`-coefficients by dévissage

Let `f : X ⟶ Y` be a smooth morphism of separated `k`-schemes of finite type. This file proves
that the purity map `γ_{f,K} : Lf^* K ⊗ Rf^! ℚ̄_ℓ ⟶ Rf^! K`
(`ProEtale.CondensedRing.upperShriekUnitTensorMap`) is an isomorphism for every bounded
constructible `K` (`ProEtale.CondensedRing.isIso_upperShriekUnitTensorMap_of_smooth`; blueprint
`theorem-sp-qbar`, in the form `Rf_! ⊣ Lf^*(-) ⊗ Rf^! ℚ̄_ℓ`, and
`proposition-exceptional-inverse-image-smooth-morphism`, (G11)).

## Proof

The objects `K` for which `γ_{f,K}` is an isomorphism form a triangulated subcategory
(`isIso_upperShriekUnitTensorMap_of_triangEnvelope`), and `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` is generated by the
objects `Rg_* Rj_* L` with `g : Z ⟶ Y` a closed immersion, `j : U ⟶ Z` an open immersion and `L`
dualizable (`triangEnvelope_lisseLowerStarGenerator`). For such a generator:

1. `γ_{f_U, L}` is an isomorphism for the base change `f_U` of `f` to `U`, since `L` is dualizable
   and the projection formula is a module structure
   (`isIso_upperShriekUnitTensorMap_of_isDualizable`);
2. `γ` is compatible with the pushforward along an immersion `g` whose base change `g'` satisfies
   `Lf^* Rg_* N ≅ Rg'_* M` (`isIso_upperShriekUnitTensorMap_lowerStar`): by the compatibility of
   `γ` with base change (`map_upperShriekUnitTensorMap_comp_upperShriekBaseChange`), the
   exceptional base change map being invertible on pushforwards (`isIso_exceptionalBaseChange`)
   and at the unit (`isIso_upperShriekBaseChange_unit_of_smooth`), `Lg'^* γ_{f, Rg_* N}` is an
   isomorphism; both its source and its target lie in the essential image of `Rg'_*` (the
   source because `Rf^! ℚ̄_ℓ` is dualizable, `isDualizable_upperShriek_unit_of_smooth`), on which
   `Lg'^*` is conservative.

This is applied to the open immersion `j`, where `Lf_Z^* Rj_* L ≅ Rj'_* Lf_U^* L` is smooth base
change (`isIso_boundedConstructibleBaseChange_of_smooth`), and to the closed immersion
`g`, where `Lf^* Rg_* ≅ Rg'_* Lf_Z^*` is proper base change.

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Functor.OplaxMonoidal

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

attribute [local instance] boundedConstructibleBraiding

variable (ℓ : ℕ) [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]

section Steps

variable {X Y X' Y' : Over (Spec (.of k))}
  [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom] [LocallyOfFiniteType Y.hom]
  [QuasiCompact Y.hom] [IsSeparated Y.hom]
  [LocallyOfFiniteType X'.hom] [QuasiCompact X'.hom] [IsSeparated X'.hom]
  [LocallyOfFiniteType Y'.hom] [QuasiCompact Y'.hom] [IsSeparated Y'.hom]

variable {f : X ⟶ Y} {g : Y' ⟶ Y} {f' : X' ⟶ Y'} {g' : X' ⟶ X}

/-- **The purity map along a pushforward**: for a cartesian square
```
X' --g'--> X
|          |
f'         f
v          v
Y' --g---> Y
```
in which the pushforwards along `g` and `g'` are fully faithful (the counits of `Lg^* ⊣ Rg_*`
and `Lg'^* ⊣ Rg'_*` are isomorphisms), `Rf^! ℚ̄_ℓ` is dualizable and the exceptional base change
map is an isomorphism at the unit, if `Lf^* Rg_* N ≅ Rg'_* M` for some `M` and `γ_{f', N}` is an
isomorphism, then so is `γ_{f, Rg_* N}`. -/
theorem isIso_upperShriekUnitTensorMap_lowerStar (sq : IsPullback g' f' f g)
    [IsIso (boundedConstructibleUpperStarLowerStarAdjunction
      ℓ g).counit]
    [IsIso (boundedConstructibleUpperStarLowerStarAdjunction
      ℓ g').counit]
    (hω : IsDualizable ((boundedConstructibleUpperShriek ℓ f).obj
      (𝟙_ (Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧))))
    [IsIso (upperShriekBaseChange ℓ sq (𝟙_ (Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧)))]
    (N : Dᵇc(Y'.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (M : Dᵇc(X'.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (e : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ f).obj
        ((boundedConstructibleLowerStar ℓ g).obj N) ≅
      (boundedConstructibleLowerStar ℓ g').obj M)
    [IsIso (upperShriekUnitTensorMap ℓ f' N)] :
    IsIso (upperShriekUnitTensorMap ℓ f
      ((boundedConstructibleLowerStar ℓ g).obj N)) := by
  let ag := boundedConstructibleUpperStarLowerStarAdjunction ℓ g
  let ag' := boundedConstructibleUpperStarLowerStarAdjunction ℓ g'
  have := isIso_boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq
  -- `γ_{f'}` at `Lg^* Rg_* N ≅ N`
  have h₁ : IsIso (upperShriekUnitTensorMap ℓ f'
      ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ g).obj
        ((boundedConstructibleLowerStar ℓ g).obj N))) := by
    have : IsIso (upperShriekUnitTensorMap ℓ f' ((𝟭 _).obj N)) :=
      inferInstanceAs (IsIso (upperShriekUnitTensorMap ℓ f' N))
    exact isIso_upperShriekUnitTensorMap_of_iso ℓ f' (asIso (ag.counit.app N))
  -- the exceptional base change map at `Rg_* N`
  have hβ : IsIso (upperShriekBaseChange ℓ sq
      ((boundedConstructibleLowerStar ℓ g).obj N)) :=
    Adjunction.isIso_exceptionalBaseChange
      (boundedConstructibleUpperShriekAdjunction ℓ f)
      (boundedConstructibleUpperShriekAdjunction ℓ f') ag ag'
      (boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq) N
  -- `Lg'^* γ_{f, Rg_* N}` is an isomorphism
  have hmap : IsIso ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ g').map
      (upperShriekUnitTensorMap ℓ f
        ((boundedConstructibleLowerStar ℓ g).obj N))) := by
    have : IsIso ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ g').map
        (upperShriekUnitTensorMap ℓ f
          ((boundedConstructibleLowerStar ℓ g).obj N)) ≫
        upperShriekBaseChange ℓ sq
          ((boundedConstructibleLowerStar ℓ g).obj N)) := by
      rw [map_upperShriekUnitTensorMap_comp_upperShriekBaseChange]
      infer_instance
    exact IsIso.of_isIso_comp_right _ (upperShriekBaseChange ℓ sq
      ((boundedConstructibleLowerStar ℓ g).obj N))
  -- the target lies in the essential image of `Rg'_*`
  have ht : IsIso (ag'.unit.app ((boundedConstructibleUpperShriek
      ℓ f).obj
        ((boundedConstructibleLowerStar ℓ g).obj N))) :=
    Adjunction.isIso_unit_app_of_iso_of_isIso_counit_app ag'
      (asIso ((conjugateEquiv
        ((boundedConstructibleUpperShriekAdjunction ℓ f).comp ag)
        (ag'.comp (boundedConstructibleUpperShriekAdjunction ℓ f'))
        (inv (boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq))).app N))
  -- the source lies in the essential image of `Rg'_*`
  have hs : IsIso (ag'.unit.app ((boundedConstructibleUpperStar
      (Profinite.padicAlgClRingObj ℓ) ℓ f).obj
        ((boundedConstructibleLowerStar ℓ g).obj N) ⊗
      (boundedConstructibleUpperShriek ℓ f).obj
        (𝟙_ (Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧)))) := by
    have := ag'.isIso_projectionMorphism_of_isDualizable hω M
    exact Adjunction.isIso_unit_app_of_iso_of_isIso_counit_app ag'
      (whiskerRightIso e _ ≪≫ asIso (ag'.projectionMorphism M _))
  exact Adjunction.isIso_of_isIso_map_of_isIso_unit_app ag' _

end Steps

section Assembly

variable {X Y : Over (Spec (.of k))}
  [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom] [LocallyOfFiniteType Y.hom]
  [QuasiCompact Y.hom] [IsSeparated Y.hom]

/-- **The purity map of a smooth morphism is an isomorphism on the generators**: for `f` smooth,
a closed immersion `g : Z ⟶ Y`, an open immersion `j : U ⟶ Z` and a dualizable `L` on `U`, the
purity map `γ_{f, Rg_* Rj_* L}` is an isomorphism. -/
theorem isIso_upperShriekUnitTensorMap_lowerStar_lowerStar (f : X ⟶ Y) [Smooth f.left]
    {Z U : Over (Spec (.of k))} [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    [IsSeparated Z.hom] [LocallyOfFiniteType U.hom] [QuasiCompact U.hom] [IsSeparated U.hom]
    (g : Z ⟶ Y) [IsClosedImmersion g.left] (j : U ⟶ Z) [IsOpenImmersion j.left]
    {L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hL : IsDualizable L) :
    IsIso (upperShriekUnitTensorMap ℓ f
      ((boundedConstructibleLowerStar ℓ g).obj
        ((boundedConstructibleLowerStar ℓ j).obj L))) := by
  -- the base change `f_Z : X ⨯_Y Z ⟶ Z` of `f` along `g`, and `f_U` of `f_Z` along `j`
  have sq₁ := IsPullback.of_hasPullback f g
  have sq₂ := IsPullback.of_hasPullback (pullback.snd f g) j
  -- the open step
  have := isIso_upperShriekUnitTensorMap_of_isDualizable ℓ (pullback.snd (pullback.snd f g) j) hL
  have := (Adjunction.Triple.mk
    (boundedConstructibleOpenImmersionLowerShriekUpperStarAdjunction
      (Profinite.padicAlgClRingObj ℓ) ℓ j)
    (boundedConstructibleUpperStarLowerStarAdjunction ℓ j)).isIso_unit_iff_isIso_counit.1
      inferInstance
  have := (Adjunction.Triple.mk
    (boundedConstructibleOpenImmersionLowerShriekUpperStarAdjunction
      (Profinite.padicAlgClRingObj ℓ) ℓ (pullback.fst (pullback.snd f g) j))
    (boundedConstructibleUpperStarLowerStarAdjunction ℓ
      (pullback.fst (pullback.snd f g) j))).isIso_unit_iff_isIso_counit.1 inferInstance
  have := isIso_upperShriekBaseChange_unit_of_smooth ℓ sq₂
  have := isIso_boundedConstructibleBaseChange_of_smooth ℓ sq₂.flip L
  have := isIso_upperShriekUnitTensorMap_lowerStar ℓ sq₂
    (isDualizable_upperShriek_unit_of_smooth ℓ (pullback.snd f g)) L _
    (asIso ((boundedConstructibleBaseChange ℓ
      sq₂.flip.toCommSq).app L))
  -- the closed step
  have := isIso_upperShriekBaseChange_unit_of_smooth ℓ sq₁
  have := isIso_boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq₁.flip
  exact isIso_upperShriekUnitTensorMap_lowerStar ℓ sq₁
    (isDualizable_upperShriek_unit_of_smooth ℓ f) _ _
    ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ f).mapIso
        ((boundedConstructibleLowerShriekIsoLowerStar_padicAlgCl ℓ g).app _).symm ≪≫
      asIso ((boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq₁.flip).app _) ≪≫
      (boundedConstructibleLowerShriekIsoLowerStar_padicAlgCl ℓ (pullback.fst f g)).app _)

/-- **Smooth purity for `ℚ̄_ℓ`-coefficients** (blueprint `theorem-sp-qbar`, in the form
`Rf_! ⊣ Lf^*(-) ⊗ Rf^! ℚ̄_ℓ`; `proposition-exceptional-inverse-image-smooth-morphism`, (G11)): for a
smooth morphism `f`, the purity map `γ_{f,K} : Lf^* K ⊗ Rf^! ℚ̄_ℓ ⟶ Rf^! K` is an isomorphism for
every bounded constructible `K`. -/
theorem isIso_upperShriekUnitTensorMap_of_smooth (f : X ⟶ Y) [Smooth f.left]
    (K : Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    IsIso (upperShriekUnitTensorMap ℓ f K) := by
  refine isIso_upperShriekUnitTensorMap_of_triangEnvelope ℓ f ?_
    (triangEnvelope_lisseLowerStarGenerator ℓ Y K)
  rintro K ⟨Z, _, _, _, g, _, U, _, _, _, _, j, _, L, hL, ⟨e⟩⟩
  have := isIso_upperShriekUnitTensorMap_lowerStar_lowerStar ℓ f g j hL
  exact isIso_upperShriekUnitTensorMap_of_iso ℓ f e

end Assembly

end AlgebraicGeometry.ProEtale.CondensedRing
