module

public import WeilConjectures.NumberTheory.Padics.CoefficientExtensionFinite
public import WeilConjectures.NumberTheory.Padics.CoefficientExtensionTorsion

/-! # Primary torsion in the finite coefficient quotient

Source: literature/blueprint/latest/blueprint/part-duality-trace-formula/
sec-lefschetz-verdier/sec-trace-classes-and-the-lefschetz-verdier-formula/
sk-d-proper-pushforward/sk-d-integral/def-trf-integration.md,
standing coefficient A_E,n (blueprint: lem-trf-finite-coefficient-primary).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace Padic

/-- The finite quotient is ell-primary. Source: the coefficient convention A_E,n
and the DVR description of O_E (blueprint: lem-trf-finite-coefficient-primary).

Proof: ell has absolute value less than one, hence belongs to the maximal ideal of O_E,
which is generated by the chosen uniformizer. Therefore ell^n belongs to (varpi_E)^n.
Its image in A_E,n is zero, so ell^n annihilates every quotient element. The exponent n
is positive by hn. This supplies the primary witness required by the current native API. -/
theorem coefficientExtensionRing_primary (ell : ℕ) [Fact ell.Prime]
    (E : Type) [Field E] [Algebra (Padic ell) E] [FiniteDimensional (Padic ell) E]
    (n : ℕ) (hn : 1 ≤ n) :
    ∃ m : ℕ, 0 < m ∧ ∀ a : Padic.coefficientExtensionRing ell E n, (ell ^ m) • a = 0 := by
  exact ⟨n, hn, Padic.pow_nsmul_coefficientExtensionRing ell E n⟩


end Padic
