/-!

# The curves `D'`, `H'`, `B'` of the surface `T'` of a cover datum

Part of blueprint `lemma-tangent-cones-on-cover`. The strict local ring `R'` of `T'` is a
regular local ring of dimension two
(`AlgebraicGeometry.Scheme.isRegularLocalRing_strictHenselization_of_smoothOfRelativeDimension`)
with maximal ideal `(ξ, η)`, where a point of `T'` lies over `c` in the first (second) factor iff
`ξ` (`η`) vanishes at it (`AlgebraicGeometry.Etale.CurveLocalModel.CoverDatum.exists_parameters`).
Since the fibre of `p` over `y` is discrete, the points of `T'` over the horizontal axis are those
with `η = 0`, so `H' = Spec (R' ⧸ (η))` is a discrete valuation ring; `D'` and `B'` meet `H'` only
in the closed point and contain non-closed points, so they have dimension one.

-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing

open scoped TensorProduct

section Algebra

variable {R : Type*} [CommRing R]

/-- If `d < 2` in `WithBot ℕ∞`, then `d ≤ 1`. -/
lemma WithBot.ENat.le_one_of_lt_two {d : WithBot ℕ∞} (hd : d < 2) : d ≤ 1 := by
  induction d using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe n =>
    induction n using ENat.recTopCoe with
    | top => exact absurd hd (by decide)
    | coe n =>
      have h : ((n : ℕ) : WithBot ℕ∞) < ((2 : ℕ) : WithBot ℕ∞) := hd
      exact (Nat.cast_le (α := WithBot ℕ∞)).mpr (by have := Nat.cast_lt.mp h; omega)

/-- In a regular local ring of dimension two whose maximal ideal is generated by `x` and `y`,
the element `y` is nonzero and the quotient by `y` is a regular local ring of dimension one. -/
theorem IsRegularLocalRing.quotient_span_singleton_of_maximalIdeal_eq_span_pair
    [IsRegularLocalRing R] (hdim : ringKrullDim R = 2) {x y : R}
    (hm : maximalIdeal R = Ideal.span {x, y}) :
    y ≠ 0 ∧ ∃ _ : IsLocalRing (R ⧸ Ideal.span {y}),
      IsRegularLocalRing (R ⧸ Ideal.span {y}) ∧ ringKrullDim (R ⧸ Ideal.span {y}) = 1 := by
  have hfr : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) = 2 := by
    rw [IsRegularLocalRing.spanFinrank_maximalIdeal, hdim]
  have hy0 : y ≠ 0 := by
    rintro rfl
    have h1 : (maximalIdeal R).spanFinrank ≤ 1 := by
      rw [hm, Set.pair_comm, Ideal.span_insert_zero]
      have := Submodule.spanFinrank_span_le_encard (R := R) ({x} : Set R)
      rw [Set.encard_singleton] at this
      exact_mod_cast this
    have h2 : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) ≤ 1 := by exact_mod_cast h1
    rw [hfr] at h2
    exact absurd h2 (by decide)
  have hym : y ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hne : Ideal.span {y} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (mem_maximalIdeal y).1 hym
  have : Nontrivial (R ⧸ Ideal.span {y}) := Ideal.Quotient.nontrivial_iff.mpr hne
  have hloc : IsLocalRing (R ⧸ Ideal.span {y}) :=
    .of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have hd1 : ringKrullDim (R ⧸ Ideal.span {y}) = 1 := by
    refine WithBot.ENat.eq_one_of_add_one_eq_two ?_
    rw [← hdim]
    exact ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hy0) hym
  refine ⟨hy0, hloc, ?_, hd1⟩
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
  rw [hd1, ← map_maximalIdeal_of_surjective (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective,
    hm, Ideal.map_span, Set.image_pair,
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self y), Set.pair_comm,
    Ideal.span_insert_zero]
  have := Submodule.spanFinrank_span_le_encard (R := R ⧸ Ideal.span {y})
    ({Ideal.Quotient.mk _ x} : Set (R ⧸ Ideal.span {y}))
  rw [Set.encard_singleton] at this
  exact_mod_cast this

/-- In a local domain of dimension two, the quotient by a nonzero ideal contained in a
non-maximal prime has dimension one. -/
theorem ringKrullDim_quotient_eq_one_of_dim_two [IsDomain R] [IsLocalRing R]
    (hdim : ringKrullDim R = 2) {I : Ideal R} (hI : I ≠ ⊥) (P : Ideal R) [P.IsPrime]
    (hIP : I ≤ P) (hP : P ≠ maximalIdeal R) : ringKrullDim (R ⧸ I) = 1 := by
  have hlt := ringKrullDim_quotient_lt_of_ne_bot (by rw [hdim]; decide) hI
  rw [hdim] at hlt
  refine le_antisymm (WithBot.ENat.le_one_of_lt_two hlt) ?_
  rw [ringKrullDim_quotient]
  refine Order.one_le_krullDim_iff.mpr ⟨⟨⟨P, inferInstance⟩, hIP⟩,
    ⟨⟨maximalIdeal R, inferInstance⟩, hIP.trans (le_maximalIdeal Ideal.IsPrime.ne_top')⟩, ?_⟩
  refine lt_of_le_of_ne (le_maximalIdeal Ideal.IsPrime.ne_top') fun h ↦ hP ?_
  exact congrArg (fun z : PrimeSpectrum R ↦ z.asIdeal) (congrArg Subtype.val h)

end Algebra

namespace AlgebraicGeometry.Scheme

/-- The strict henselization does not change along an open immersion. -/
noncomputable def strictHenselizationEquivOfIsOpenImmersion {S U : Scheme.{u}} {Ω : Type u}
    [Field Ω] [IsSepClosed Ω] (j : U ⟶ S) [IsOpenImmersion j] (s : Spec (.of Ω) ⟶ U) :
    strictHenselization (s ≫ j) ≃+* strictHenselization s :=
  have := isIso_strictLocalizationMap_of_isOpenImmersion j s
  Iso.commRingCatIsoToRingEquiv
    { hom := Spec.preimage (strictLocalizationMap j s)
      inv := Spec.preimage (inv (strictLocalizationMap j s))
      hom_inv_id := Spec.map_injective (by simp)
      inv_hom_id := Spec.map_injective (by simp) }

/-- The strict henselization of a scheme smooth of relative dimension `n` over an algebraically
closed field `k` at a `k`-rational point is a regular local ring of dimension `n`. -/
theorem isRegularLocalRing_strictHenselization_of_smoothOfRelativeDimension {k : Type u}
    [Field k] [IsAlgClosed k] {S : Scheme.{u}} (f : S ⟶ Spec (.of k)) (n : ℕ)
    [SmoothOfRelativeDimension n f] (s : Spec (.of k) ⟶ S) (hs : s ≫ f = 𝟙 _) :
    IsRegularLocalRing (strictHenselization s) ∧ ringKrullDim (strictHenselization s) = n := by
  obtain ⟨R, a, ha, ⟨z, hz⟩, -⟩ := exists_affine_mem_range_and_range_subset
    (show s (closedPoint k) ∈ (⊤ : S.Opens) from trivial)
  have hsub : Set.range s ⊆ Set.range a := by
    rintro _ ⟨w, rfl⟩
    rw [Subsingleton.elim w (closedPoint k)]
    exact ⟨z, hz⟩
  obtain ⟨t, rfl⟩ : ∃ t, t ≫ a = s := ⟨IsOpenImmersion.lift a s hsub,
    IsOpenImmersion.lift_fac _ _ _⟩
  suffices IsRegularLocalRing (strictHenselization t) ∧ ringKrullDim (strictHenselization t) = n by
    let e := strictHenselizationEquivOfIsOpenImmersion a t
    obtain ⟨h1, h2⟩ := this
    exact ⟨.of_ringEquiv e.symm, (ringKrullDim_eq_of_ringEquiv e).trans h2⟩
  have ht : t ≫ a ≫ f = 𝟙 _ := by rw [← Category.assoc, hs]
  obtain ⟨b, hb⟩ : ∃ b, Spec.map b = strictLocalizationToBase t :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨q, hq, K, hK, aK, hsep, aLK, hLK, aLH, hcomp, hH⟩ :=
    strictHenselizationRing_local_presentation R t b hb
  obtain ⟨_, hm⟩ := Algebra.strictHenselization_local_maximalIdeal _ K _ hH
  set x := t (closedPoint k) with hx
  have hqx : q = x.asIdeal := by
    have h1 : (maximalIdeal (strictHenselization t)).comap b.hom = x.asIdeal := by
      have : Spec.map b (closedPoint (strictHenselization t)) = x := by
        rw [hb, ← spec_map_strictHenselizationEval_apply t (closedPoint k),
          ← Scheme.Hom.comp_apply, spec_map_strictHenselizationEval_comp_strictLocalizationToBase]
      rw [← this, Spec.map_apply, PrimeSpectrum.comap_asIdeal]
      rfl
    have h2 : (maximalIdeal (strictHenselization t)).comap
        (algebraMap (Localization.AtPrime q) (strictHenselization t)) =
          maximalIdeal (Localization.AtPrime q) := by
      refine ((maximalIdeal.isMaximal _).eq_of_le ?_ ?_).symm
      · exact Ideal.IsPrime.ne_top'
      · rw [← Ideal.map_le_iff_le_comap, hm]
    have h3 : b.hom = (algebraMap (Localization.AtPrime q) (strictHenselization t)).comp
        (algebraMap R (Localization.AtPrime q)) := RingHom.ext fun r ↦ (hcomp r).symm
    rw [← h1, h3, ← Ideal.comap_comap, h2]
    exact (Localization.AtPrime.under_maximalIdeal).symm
  subst hqx
  let eS := (Spec.stalkIso R x).commRingCatIsoToRingEquiv
  have : SmoothOfRelativeDimension n (a ≫ f) := by
    have := smoothOfRelativeDimension_comp (n := 0) (m := n) a f
    rwa [zero_add] at this
  have : Smooth (a ≫ f) := SmoothOfRelativeDimension.smooth n _
  have := Smooth.isRegularLocalRing_stalk (a ≫ f) x
  have hreg : IsRegularLocalRing (Localization.AtPrime x.asIdeal) :=
    .of_ringEquiv (R := (Spec R).presheaf.stalk x) eS
  have hdim : ringKrullDim (Localization.AtPrime x.asIdeal) = n := by
    rw [← ringKrullDim_eq_of_ringEquiv eS, hx,
      ringKrullDim_stalk_rationalPoint_eq_topologicalKrullDimAt (a ≫ f) t ht,
      topologicalKrullDimAt_eq_of_smoothOfRelativeDimension (a ≫ f) n]
  exact ⟨(Algebra.isRegularLocalRing_iff_strictHenselization _ K _ hH).1 hreg,
    (Algebra.ringKrullDim_eq_of_isStrictHenselization _ K _ hH).symm.trans hdim⟩


/-- A `k`-rational point of a scheme smooth of relative dimension one over `k` has an affine open
chart over `k` in which its ideal is principal. -/
theorem exists_affineChart_ker_eq_span_singleton {k : Type u} [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 f] (c : Spec (.of k) ⟶ C)
    (hc : c ≫ f = 𝟙 _) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra k A) (i : Spec (.of A) ⟶ C)
      (_ : IsOpenImmersion i) (_ : i ≫ f = Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (φ : A →ₐ[k] k) (ξ : A),
      RingHom.ker φ = Ideal.span {ξ} ∧ c = Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ i := by
  have : IsClosedImmersion c := isClosedImmersion_of_comp_eq_id f c hc
  have hcl : IsClosed ({c (closedPoint k)} : Set C) := by
    simpa using c.isClosedEmbedding.isClosedMap _
      (isClosed_discrete _ : IsClosed ({closedPoint k} : Set (Spec (.of k))))
  obtain ⟨R, a, ha, ⟨z, hz⟩, -⟩ := exists_affine_mem_range_and_range_subset
    (show c (closedPoint k) ∈ (⊤ : C.Opens) from trivial)
  have hsub : Set.range c ⊆ Set.range a := by
    rintro _ ⟨w, rfl⟩
    rw [Subsingleton.elim w (closedPoint k)]
    exact ⟨z, hz⟩
  obtain ⟨t, rfl⟩ : ∃ t, t ≫ a = c := ⟨IsOpenImmersion.lift a c hsub,
    IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨ψ₀, rfl⟩ : ∃ ψ₀, Spec.map ψ₀ = t := ⟨Spec.preimage _, Spec.map_preimage _⟩
  -- the local ring at the point is a discrete valuation ring
  set x := Spec.map ψ₀ (closedPoint k) with hx
  set q := x.asIdeal with hqx
  have hq : q = RingHom.ker ψ₀.hom := by
    rw [hqx, hx, Spec.map_apply, PrimeSpectrum.comap_asIdeal]
    exact Spec_map_closedPoint_asIdeal (R := R) (K := k) ψ₀.hom
  have : SmoothOfRelativeDimension 1 (a ≫ f) := by
    have := smoothOfRelativeDimension_comp (n := 0) (m := 1) a f
    rwa [zero_add] at this
  have : Smooth f := SmoothOfRelativeDimension.smooth 1 f
  have : IsLocallyNoetherian (Spec R) := LocallyOfFiniteType.isLocallyNoetherian (a ≫ f)
  have : IsNoetherianRing R := isLocallyNoetherian_Spec.mp this
  rw [Scheme.Hom.comp_apply] at hcl
  let e : Localization.AtPrime q ≃+* C.presheaf.stalk (a x) :=
    ((Spec.stalkIso R x).symm ≪≫ (asIso (a.stalkMap x)).symm).commRingCatIsoToRingEquiv
  have := Smooth.isRegularLocalRing_stalk f (a x)
  have : IsRegularLocalRing (Localization.AtPrime q) := .of_ringEquiv e.symm
  have : IsDiscreteValuationRing (Localization.AtPrime q) :=
    IsRegularLocalRing.isDiscreteValuationRing _ (by
      rw [ringKrullDim_eq_of_ringEquiv e]
      exact ringKrullDim_stalk_eq_one_of_smoothOfRelativeDimension_one f hcl)
  obtain ⟨g, hgq, π, hπq, hgπ, -⟩ :=
    Ideal.exists_away_regularPrincipal_of_isDiscreteValuationRing q (Localization.AtPrime q)
  -- the chart
  let A := Localization.Away g
  let ι : R ⟶ CommRingCat.of A := CommRingCat.ofHom (algebraMap R A)
  obtain ⟨χ, hχ⟩ : ∃ χ, Spec.map χ = (Spec.map ι ≫ a) ≫ f := ⟨Spec.preimage _, Spec.map_preimage _⟩
  let : Algebra k A := χ.hom.toAlgebra
  have hgu : IsUnit (ψ₀.hom g) := by
    refine isUnit_iff_ne_zero.mpr fun h ↦ hgq ?_
    rw [hq, RingHom.mem_ker]
    exact h
  let ψ : A →+* k := IsLocalization.Away.lift g hgu
  have hψι : ψ.comp (algebraMap R A) = ψ₀.hom := IsLocalization.Away.lift_comp g hgu
  have hc' : Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map ι ≫ a = Spec.map ψ₀ ≫ a := by
    rw [← Category.assoc, ← Spec.map_comp]
    congr 2
    ext r
    exact congrArg (fun φ : R →+* k ↦ φ r) hψι
  have hψχ : ψ.comp χ.hom = RingHom.id k := by
    have : Spec.map (χ ≫ CommRingCat.ofHom ψ) = Spec.map (𝟙 _) := by
      rw [Spec.map_comp, hχ]
      simp only [Category.assoc]
      rw [reassoc_of% hc', ← Category.assoc, hc, Spec.map_id]
    exact congrArg CommRingCat.Hom.hom (Spec.map_injective this)
  let φ : A →ₐ[k] k :=
    { ψ with commutes' := fun r ↦ congrArg (fun φ : k →+* k ↦ φ r) hψχ }
  refine ⟨A, inferInstance, inferInstance, Spec.map ι ≫ a, inferInstance, hχ.symm, φ,
    algebraMap R A π, ?_, hc'.symm⟩
  -- the kernel
  have hcomap : (RingHom.ker φ).under R = q := by
    ext r
    rw [Ideal.under, Ideal.mem_comap, RingHom.mem_ker, hq, RingHom.mem_ker]
    exact iff_of_eq (congrArg (· = 0) (congrArg (fun φ : R →+* k ↦ φ r) hψι))
  rw [← IsLocalization.map_under (Submonoid.powers g) A (RingHom.ker φ), hcomap]
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_)
    (Ideal.span_le.mpr (by simpa using Ideal.mem_map_of_mem _ hπq))
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hgπ r hr)
  have hu : IsUnit (algebraMap R A g) := IsLocalization.Away.algebraMap_isUnit g
  rw [Ideal.mem_comap, ← Ideal.unit_mul_mem_iff_mem _ hu, ← map_mul, ← hb, map_mul, mul_comm]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- In an affine open chart `i : Spec A ⟶ C` through which a `k`-point `φ` with principal kernel
`(ξ)` factors, a point of the chart lies over the image of `φ` iff it lies on `ξ = 0`. -/
lemma chart_apply_eq_iff {k : Type u} [Field k] {C : Scheme.{u}} {A : Type u} [CommRing A]
    [Algebra k A] (i : Spec (.of A) ⟶ C) [IsOpenImmersion i] (φ : A →ₐ[k] k) {ξ : A}
    (hξ : RingHom.ker φ = Ideal.span {ξ}) (w : Spec (.of A)) :
    i w = i (Spec.map (CommRingCat.ofHom φ.toRingHom) (closedPoint k)) ↔ ξ ∈ w.asIdeal := by
  have hmax : (RingHom.ker φ).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective φ fun r ↦ ⟨algebraMap k A r, φ.commutes r⟩
  have hξ' : RingHom.ker φ.toRingHom = Ideal.span {ξ} := hξ
  have hpt : (Spec.map (CommRingCat.ofHom φ.toRingHom) (closedPoint k)).asIdeal =
      RingHom.ker φ.toRingHom :=
    Spec_map_closedPoint_asIdeal (F := A →ₐ[k] k) φ
  rw [i.isOpenEmbedding.injective.eq_iff, PrimeSpectrum.ext_iff, hpt]
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · rw [h, hξ']
    exact Ideal.mem_span_singleton_self ξ
  · refine (hmax.eq_of_le Ideal.IsPrime.ne_top' ?_).symm
    rw [hξ, Ideal.span_le, Set.singleton_subset_iff]
    exact h

/-- **Regular parameters of the strict henselization of a product of curves.** Let `C₁`, `C₂` be
smooth curves over an algebraically closed field `k` and `s` a `k`-point of `C₁ ×_k C₂`. The
maximal ideal of the strict henselization at `s` is generated by two elements `ξ`, `η`, and a
point of the strict localization lies over the first (second) coordinate of `s` iff `ξ` (`η`)
vanishes at it. -/
theorem exists_strictHenselization_parameters {k : Type u} [Field k] [IsAlgClosed k]
    {C₁ C₂ : Scheme.{u}} (f₁ : C₁ ⟶ Spec (.of k)) (f₂ : C₂ ⟶ Spec (.of k))
    [SmoothOfRelativeDimension 1 f₁] [SmoothOfRelativeDimension 1 f₂]
    (s : Spec (.of k) ⟶ pullback f₁ f₂) (hs₁ : (s ≫ pullback.fst f₁ f₂) ≫ f₁ = 𝟙 _)
    (hs₂ : (s ≫ pullback.snd f₁ f₂) ≫ f₂ = 𝟙 _) :
    ∃ ξ η : strictHenselization s, maximalIdeal (strictHenselization s) = Ideal.span {ξ, η} ∧
      (∀ z, pullback.fst f₁ f₂ (strictLocalizationToBase s z) =
        (s ≫ pullback.fst f₁ f₂) (closedPoint k) ↔ ξ ∈ z.asIdeal) ∧
      (∀ z, pullback.snd f₁ f₂ (strictLocalizationToBase s z) =
        (s ≫ pullback.snd f₁ f₂) (closedPoint k) ↔ η ∈ z.asIdeal) := by
  obtain ⟨A₁, _, _, i₁, _, hi₁, φ₁, ξ, hξ, hc₁⟩ :=
    exists_affineChart_ker_eq_span_singleton f₁ _ hs₁
  obtain ⟨A₂, _, _, i₂, _, hi₂, φ₂, η, hη, hc₂⟩ :=
    exists_affineChart_ker_eq_span_singleton f₂ _ hs₂
  obtain ⟨ρ, hρ, hm⟩ := strictHenselization_maximalIdeal_eq_span_pair f₁ f₂ i₁ i₂ hi₁ hi₂ φ₁ φ₂
    hξ hη s hc₁ hc₂
  refine ⟨ρ (ξ ⊗ₜ 1), ρ (1 ⊗ₜ η), hm, fun z ↦ ?_, fun z ↦ ?_⟩
  · have h : productChart f₁ f₂ i₁ i₂ hi₁ hi₂ ≫ pullback.fst f₁ f₂ =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫ i₁ := by
      rw [productChart, Category.assoc, pullback.lift_fst, pullbackSpecIso_inv_fst_assoc]
    rw [← hρ, hc₁]
    simp only [Scheme.Hom.comp_apply]
    rw [← Scheme.Hom.comp_apply _ (pullback.fst f₁ f₂), h]
    simp only [Scheme.Hom.comp_apply]
    rw [chart_apply_eq_iff i₁ φ₁ hξ]
    rfl
  · have h : productChart f₁ f₂ i₁ i₂ hi₁ hi₂ ≫ pullback.snd f₁ f₂ =
        Spec.map (CommRingCat.ofHom (R := A₂) (S := A₁ ⊗[k] A₂)
          (AlgHom.toRingHom Algebra.TensorProduct.includeRight)) ≫ i₂ := by
      rw [productChart, Category.assoc, pullback.lift_snd, pullbackSpecIso_inv_snd_assoc]
      rfl
    rw [← hρ, hc₂]
    simp only [Scheme.Hom.comp_apply]
    rw [← Scheme.Hom.comp_apply _ (pullback.snd f₁ f₂), h]
    simp only [Scheme.Hom.comp_apply]
    rw [chart_apply_eq_iff i₂ φ₂ hη]
    rfl

/-- A point of the strict localization of a smooth curve over an algebraically closed field `k`
at a `k`-point `c` lying over `c` is the closed point. -/
theorem eq_closedPoint_of_strictLocalizationToBase_eq_of_smooth {k : Type u} [Field k]
    [IsAlgClosed k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 f]
    (c : Spec (.of k) ⟶ C) (hc : c ≫ f = 𝟙 _) (z : strictLocalization c)
    (hz : strictLocalizationToBase c z = c (closedPoint k)) :
    z = closedPoint (strictHenselization c) := by
  obtain ⟨A, _, _, i, _, -, φ, ξ, hξ, rfl⟩ := exists_affineChart_ker_eq_span_singleton f c hc
  obtain ⟨_, ρ, hρ, hm⟩ := strictHenselization_chart_maximalIdeal (.of A) i
    (Spec.map (CommRingCat.ofHom φ.toRingHom))
  rw [← hρ, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, i.isOpenEmbedding.injective.eq_iff,
    PrimeSpectrum.ext_iff, Spec.map_apply, PrimeSpectrum.comap_asIdeal] at hz
  refine PrimeSpectrum.ext ((le_maximalIdeal Ideal.IsPrime.ne_top').antisymm ?_)
  rw [hm, Ideal.map_le_iff_le_comap, ← hz]

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Etale.CurveLocalModel

open Scheme

variable {k : Type u} [Field k] (M : CurveLocalModel k)

/-- A point of `X ×_k X` with second coordinate `y` lies on the horizontal axis `X × {y}`. -/
lemma mem_range_horizontal {w : ↥(pullback M.f M.f)}
    (hw : pullback.snd M.f M.f w = M.y (closedPoint k)) : w ∈ Set.range M.horizontal := by
  have hmem : w ∈ Set.range (pullback.fst (pullback.snd M.f M.f) M.y) := by
    rw [Scheme.Pullback.range_fst]
    exact ⟨_, hw.symm⟩
  obtain ⟨q, rfl⟩ := hmem
  refine ⟨(pullback.fst (pullback.snd M.f M.f) M.y ≫ pullback.fst M.f M.f) q, ?_⟩
  have e : (pullback.fst (pullback.snd M.f M.f) M.y ≫ pullback.fst M.f M.f) ≫ M.horizontal =
      pullback.fst (pullback.snd M.f M.f) M.y := by
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, horizontal, pullback.lift_fst, Category.comp_id]
    · rw [Category.assoc, horizontal, pullback.lift_snd, Category.assoc,
        pullback.condition_assoc, ← Category.assoc, pullback.condition, Category.assoc,
        ← Category.assoc M.y, M.y_comp, Category.id_comp]
  rw [← Scheme.Hom.comp_apply, e]

/-- A point of `X ×_k X` with first coordinate `y` lies on the vertical axis `{y} × X`. -/
lemma mem_range_vertical {w : ↥(pullback M.f M.f)}
    (hw : pullback.fst M.f M.f w = M.y (closedPoint k)) : w ∈ Set.range M.vertical := by
  have hmem : w ∈ Set.range (pullback.fst (pullback.fst M.f M.f) M.y) := by
    rw [Scheme.Pullback.range_fst]
    exact ⟨_, hw.symm⟩
  obtain ⟨q, rfl⟩ := hmem
  refine ⟨(pullback.fst (pullback.fst M.f M.f) M.y ≫ pullback.snd M.f M.f) q, ?_⟩
  have e : (pullback.fst (pullback.fst M.f M.f) M.y ≫ pullback.snd M.f M.f) ≫ M.vertical =
      pullback.fst (pullback.fst M.f M.f) M.y := by
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, vertical, pullback.lift_fst, Category.assoc,
        ← pullback.condition_assoc, ← Category.assoc, pullback.condition, Category.assoc,
        ← Category.assoc M.y, M.y_comp, Category.id_comp]
    · rw [Category.assoc, vertical, pullback.lift_snd, Category.comp_id]
  rw [← Scheme.Hom.comp_apply, e]

lemma y_comp_graph : M.y ≫ M.graph = M.diagPoint :=
  pullback.hom_ext (by simp [graph, diagPoint, M.y_comp_h]) (by simp [graph, diagPoint])

lemma y_comp_vertical : M.y ≫ M.vertical = M.diagPoint :=
  pullback.hom_ext (by simp [vertical, diagPoint, reassoc_of% M.y_comp])
    (by simp [vertical, diagPoint])

lemma y_comp_horizontal : M.y ≫ M.horizontal = M.diagPoint :=
  pullback.hom_ext (by simp [horizontal, diagPoint])
    (by simp [horizontal, diagPoint, reassoc_of% M.y_comp])

end AlgebraicGeometry.Etale.CurveLocalModel

/-- The vanishing ideal of a set of points is contained in the prime of each of its points. -/
lemma PrimeSpectrum.vanishingIdeal_le_asIdeal {R : Type*} [CommRing R]
    {Z : Set (PrimeSpectrum R)} {x : PrimeSpectrum R} (hx : x ∈ Z) :
    PrimeSpectrum.vanishingIdeal Z ≤ x.asIdeal :=
  fun _ hf ↦ (PrimeSpectrum.mem_vanishingIdeal _ _).mp hf x hx

namespace AlgebraicGeometry.Etale.CurveLocalModel.CoverDatum

open Scheme

variable {k : Type u} [Field k] [IsAlgClosed k] {M : CurveLocalModel k} {ℓ : ℕ}
  {Λ : Type (u + 1)} [CommRing Λ]
  {PL PK : CochainComplex (Sheaf M.X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) ℤ}
  (D : M.CoverDatum ℓ PL PK)

omit [IsAlgClosed k] in
lemma fst_g_apply (w : D.S') :
    pullback.fst M.f M.f (D.g w) = D.p (pullback.fst D.fC D.fC w) := by
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
  congr 1
  simp [g]

omit [IsAlgClosed k] in
lemma snd_g_apply (w : D.S') :
    pullback.snd M.f M.f (D.g w) = D.p (pullback.snd D.fC D.fC w) := by
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
  congr 1
  simp [g]

lemma p_c : D.p (D.c (closedPoint k)) = M.y (closedPoint k) := by
  rw [← Scheme.Hom.comp_apply, D.c_comp]

/-- A point of `C` over `y` specializing to `c` is `c`: the fibre of the quasi-finite `p` over
`y` is discrete. -/
lemma eq_c_of_specializes {x : D.C} (hx : D.p x = M.y (closedPoint k))
    (hsp : x ⤳ D.c (closedPoint k)) : x = D.c (closedPoint k) := by
  have : LocallyQuasiFinite D.p := by
    rw [← D.pU_ι]
    infer_instance
  have := (D.p.isDiscrete_preimage_singleton (M.y (closedPoint k))).to_subtype
  have h : (⟨x, hx⟩ : D.p ⁻¹' {M.y (closedPoint k)}) ⤳ ⟨D.c (closedPoint k), D.p_c⟩ :=
    Topology.IsInducing.subtypeVal.specializes_iff.mp hsp
  exact congrArg Subtype.val h.eq

lemma τ'_closedPoint :
    strictLocalizationToBase D.s' (closedPoint (strictHenselization D.s')) =
      D.s' (closedPoint k) :=
  strictLocalizationToBase_apply_closedPoint D.s'

lemma fst_eq_c {z : D.T'}
    (hz : D.p (pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z)) =
      M.y (closedPoint k)) :
    pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z) = D.c (closedPoint k) := by
  refine D.eq_c_of_specializes hz ?_
  have := ((specializes_closedPoint z).map (strictLocalizationToBase D.s').continuous).map
    (pullback.fst D.fC D.fC).continuous
  rwa [D.τ'_closedPoint, ← Scheme.Hom.comp_apply D.s', D.s'_fst] at this

lemma snd_eq_c {z : D.T'}
    (hz : D.p (pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z)) =
      M.y (closedPoint k)) :
    pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z) = D.c (closedPoint k) := by
  refine D.eq_c_of_specializes hz ?_
  have := ((specializes_closedPoint z).map (strictLocalizationToBase D.s').continuous).map
    (pullback.snd D.fC D.fC).continuous
  rwa [D.τ'_closedPoint, ← Scheme.Hom.comp_apply D.s', D.s'_snd] at this

/-- **Regular parameters of `T'`**: the maximal ideal of the strict local ring of `T'` is
generated by `ξ` and `η`, the uniformizers at `c` of the two factors. -/
lemma exists_parameters : ∃ ξ η : strictHenselization D.s',
    maximalIdeal (strictHenselization D.s') = Ideal.span {ξ, η} ∧
    (∀ z : D.T', pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z) =
      D.c (closedPoint k) ↔ ξ ∈ z.asIdeal) ∧
    (∀ z : D.T', pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z) =
      D.c (closedPoint k) ↔ η ∈ z.asIdeal) := by
  have h₁ : (D.s' ≫ pullback.fst D.fC D.fC) ≫ D.fC = 𝟙 _ := by rw [s'_fst, c_comp_fC]
  have h₂ : (D.s' ≫ pullback.snd D.fC D.fC) ≫ D.fC = 𝟙 _ := by rw [s'_snd, c_comp_fC]
  obtain ⟨ξ, η, hm, hξ, hη⟩ := exists_strictHenselization_parameters D.fC D.fC D.s' h₁ h₂
  rw [D.s'_fst] at hξ
  rw [D.s'_snd] at hη
  exact ⟨ξ, η, hm, hξ, hη⟩

/-- The strict local ring of `T'` is a regular local ring of dimension two. -/
lemma regular : IsRegularLocalRing (strictHenselization D.s') ∧
    ringKrullDim (strictHenselization D.s') = 2 := by
  have : SmoothOfRelativeDimension (1 + 1) (pullback.fst D.fC D.fC ≫ D.fC) :=
    smoothOfRelativeDimension_comp (n := 1) (m := 1) (pullback.fst D.fC D.fC) D.fC
  obtain ⟨h₁, h₂⟩ := isRegularLocalRing_strictHenselization_of_smoothOfRelativeDimension _ (1 + 1)
    D.s' (by rw [← Category.assoc, s'_fst, c_comp_fC])
  exact ⟨h₁, by rw [h₂]; rfl⟩

/-- A point of `T'` whose two coordinates lie over `y` is the closed point. -/
lemma eq_closedPoint {z : D.T'}
    (h₁ : D.p (pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z)) = M.y (closedPoint k))
    (h₂ : D.p (pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z)) = M.y (closedPoint k)) :
    z = closedPoint (strictHenselization D.s') := by
  obtain ⟨ξ, η, hm, hξ, hη⟩ := D.exists_parameters
  refine PrimeSpectrum.ext ((le_maximalIdeal Ideal.IsPrime.ne_top').antisymm ?_)
  rw [hm, Ideal.span_le]
  rintro _ (rfl | rfl)
  exacts [(hξ z).mp (D.fst_eq_c h₁), (hη z).mp (D.snd_eq_c h₂)]

lemma π_mem_range_iff {Z : Scheme.{u}} (ι : Z ⟶ pullback M.f M.f) (z : D.T') :
    D.π z ∈ Set.range (pullback.snd ι M.τ) ↔
      D.g (strictLocalizationToBase D.s' z) ∈ Set.range ι := by
  rw [Scheme.Pullback.range_snd, Set.mem_preimage, ← Scheme.Hom.comp_apply, π_comp_τ,
    Scheme.Hom.comp_apply]

lemma π_closedPoint_mem {Z : Scheme.{u}} (ι : Z ⟶ pullback M.f M.f)
    (t : Spec (.of k) ⟶ Z) (hι : t ≫ ι = M.diagPoint) :
    D.π (closedPoint (strictHenselization D.s')) ∈ Set.range (pullback.snd ι M.τ) := by
  rw [D.π_mem_range_iff, D.τ'_closedPoint, ← Scheme.Hom.comp_apply, s'_comp_g, ← hι]
  exact ⟨_, rfl⟩

lemma p_snd_of_mem_hH {z : D.T'} (hz : D.π z ∈ Set.range M.hH) :
    D.p (pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z)) = M.y (closedPoint k) := by
  obtain ⟨w, hw⟩ := (D.π_mem_range_iff M.horizontal z).mp hz
  rw [← D.snd_g_apply, ← hw, ← Scheme.Hom.comp_apply, horizontal, pullback.lift_snd,
    Scheme.Hom.comp_apply, Subsingleton.elim (M.f w) (closedPoint k)]

lemma p_fst_of_mem_a {z : D.T'} (hz : D.π z ∈ Set.range M.a)
    (h₂ : D.p (pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z)) = M.y (closedPoint k)) :
    D.p (pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z)) = M.y (closedPoint k) := by
  obtain ⟨w, hw⟩ := (D.π_mem_range_iff M.graph z).mp hz
  have e : pullback.snd M.f M.f (M.graph w) = w := by
    rw [← Scheme.Hom.comp_apply, graph, pullback.lift_snd]
    rfl
  have hw' : w = M.y (closedPoint k) := by
    rw [← h₂, ← D.snd_g_apply, ← hw, e]
  rw [← D.fst_g_apply, ← hw, ← Scheme.Hom.comp_apply, graph, pullback.lift_fst, hw',
    ← Scheme.Hom.comp_apply, M.y_comp_h]

lemma p_fst_of_mem_v {z : D.T'} (hz : D.π z ∈ Set.range M.v) :
    D.p (pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z)) = M.y (closedPoint k) := by
  obtain ⟨w, hw⟩ := (D.π_mem_range_iff M.vertical z).mp hz
  rw [← D.fst_g_apply, ← hw, ← Scheme.Hom.comp_apply, vertical, pullback.lift_fst,
    Scheme.Hom.comp_apply, Subsingleton.elim (M.f w) (closedPoint k)]

lemma p_fst_eq_p_snd_of_mem_b {z : D.T'} (hz : D.π z ∈ Set.range M.b) :
    D.p (pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z)) =
      D.p (pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z)) := by
  obtain ⟨w, hw⟩ := (D.π_mem_range_iff (pullback.diagonal M.f) z).mp hz
  rw [← D.fst_g_apply, ← D.snd_g_apply, ← hw, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply,
    pullback.diagonal_fst, pullback.diagonal_snd]

lemma mem_hH_of_snd {z : D.T'}
    (hz : pullback.snd D.fC D.fC (strictLocalizationToBase D.s' z) = D.c (closedPoint k)) :
    D.π z ∈ Set.range M.hH := by
  rw [D.π_mem_range_iff]
  refine M.mem_range_horizontal ?_
  rw [D.snd_g_apply, hz, D.p_c]

lemma mem_v_of_fst {z : D.T'}
    (hz : pullback.fst D.fC D.fC (strictLocalizationToBase D.s' z) = D.c (closedPoint k)) :
    D.π z ∈ Set.range M.v := by
  rw [D.π_mem_range_iff]
  refine M.mem_range_vertical ?_
  rw [D.fst_g_apply, hz, D.p_c]

/-- The reduced inverse image `B'` of the diagonal contains a point other than the closed point:
the image of the generic point of the strict localization of `C` at `c` under the diagonal. -/
lemma exists_mem_b_ne_closedPoint : ∃ P : D.T', D.π P ∈ Set.range M.b ∧
    P ≠ closedPoint (strictHenselization D.s') := by
  obtain ⟨hreg, hdim⟩ :=
    isRegularLocalRing_strictHenselization_of_smoothOfRelativeDimension D.fC 1 D.c D.c_comp_fC
  let γ : PrimeSpectrum (strictHenselization D.c) := ⟨⊥, Ideal.isPrime_bot⟩
  have hγ : γ ≠ closedPoint _ := by
    intro h
    have hb : (⊥ : Ideal (strictHenselization D.c)) = maximalIdeal _ :=
      congrArg PrimeSpectrum.asIdeal h
    let := ((isField_iff_maximalIdeal_eq).mpr hb.symm).toField
    rw [ringKrullDim_eq_zero_of_field] at hdim
    exact absurd hdim (by decide)
  have hcΔ : D.c ≫ pullback.diagonal D.fC = D.s' :=
    pullback.hom_ext (by simp [s']) (by simp [s'])
  let ψ : strictLocalization D.c ⟶ D.T' :=
    strictLocalizationMap (pullback.diagonal D.fC) D.c ≫ eqToHom (by rw [hcΔ])
  have hψ : ψ ≫ strictLocalizationToBase D.s' =
      strictLocalizationToBase D.c ≫ pullback.diagonal D.fC := by
    rw [Category.assoc, eqToHom_comp_strictLocalizationToBase hcΔ,
      strictLocalizationMap_comp_strictLocalizationToBase]
  have hΔg : pullback.diagonal D.fC ≫ D.g = D.p ≫ pullback.diagonal M.f :=
    pullback.hom_ext (by simp [g]) (by simp [g])
  refine ⟨ψ γ, ?_, fun h ↦ hγ ?_⟩
  · rw [D.π_mem_range_iff, ← Scheme.Hom.comp_apply ψ (strictLocalizationToBase D.s'), hψ,
      ← Scheme.Hom.comp_apply, Category.assoc, hΔg, ← Category.assoc, Scheme.Hom.comp_apply]
    exact ⟨_, rfl⟩
  · refine eq_closedPoint_of_strictLocalizationToBase_eq_of_smooth D.fC D.c D.c_comp_fC γ ?_
    have h1 := congrArg (strictLocalizationToBase D.s') h
    rw [← Scheme.Hom.comp_apply, hψ, D.τ'_closedPoint, Scheme.Hom.comp_apply] at h1
    have h2 := congrArg (pullback.fst D.fC D.fC) h1
    have e : ∀ x, pullback.fst D.fC D.fC (pullback.diagonal D.fC x) = x := fun x ↦ by
      rw [← Scheme.Hom.comp_apply, pullback.diagonal_fst]
      rfl
    rwa [e, ← Scheme.Hom.comp_apply D.s', D.s'_fst] at h2


/-- The curves `D'`, `H'`, `B'` pass through the closed point of `T'`
(blueprint `lemma-tangent-cones-on-cover`). -/
theorem nonempty_curves' : Nonempty D.D' ∧ Nonempty D.H' ∧ Nonempty D.B' := by
  have key (Z : Set D.T') (hZ : closedPoint (strictHenselization D.s') ∈ Z) :
      Nonempty (reducedClosed (strictHenselization D.s') Z) := by
    have hne : PrimeSpectrum.vanishingIdeal Z ≠ ⊤ := fun h ↦
      Ideal.IsPrime.ne_top' (eq_top_iff.mpr (h ▸ PrimeSpectrum.vanishingIdeal_le_asIdeal hZ))
    have : Nontrivial (strictHenselization D.s' ⧸ PrimeSpectrum.vanishingIdeal Z) :=
      Ideal.Quotient.nontrivial_iff.mpr hne
    exact inferInstanceAs (Nonempty (PrimeSpectrum _))
  exact ⟨key _ (Or.inl (D.π_closedPoint_mem M.graph M.y M.y_comp_graph)),
    key _ (D.π_closedPoint_mem M.horizontal M.y M.y_comp_horizontal),
    key _ (D.π_closedPoint_mem (pullback.diagonal M.f) M.y M.y_comp_diagonal)⟩

/-- The curve `H'` is regular: its ring is a discrete valuation ring (blueprint
`lemma-tangent-cones-on-cover` (ii): `H'` is the axis `η = 0` of `T'`). -/
theorem isDiscreteValuationRing_H'' :
    ∃ _ : IsDomain Γ(D.H', ⊤), IsDiscreteValuationRing Γ(D.H', ⊤) := by
  obtain ⟨ξ, η, hm, -, hη⟩ := D.exists_parameters
  obtain ⟨hreg, hdim⟩ := D.regular
  obtain ⟨-, hloc, hregq, hdimq⟩ :=
    IsRegularLocalRing.quotient_span_singleton_of_maximalIdeal_eq_span_pair hdim hm
  have hI : PrimeSpectrum.vanishingIdeal (D.π.base ⁻¹' Set.range M.hH.base) =
      Ideal.span {η} := by
    have hprime : (Ideal.span {η}).IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
    let P : PrimeSpectrum (strictHenselization D.s') := ⟨Ideal.span {η}, hprime⟩
    have hP : P ∈ D.π.base ⁻¹' Set.range M.hH.base :=
      D.mem_hH_of_snd ((hη P).mpr (Ideal.mem_span_singleton_self η))
    refine le_antisymm (PrimeSpectrum.vanishingIdeal_le_asIdeal hP) ?_
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      PrimeSpectrum.mem_vanishingIdeal]
    intro z hz
    exact (hη z).mp (D.snd_eq_c (D.p_snd_of_mem_hH hz))
  let e : Γ(D.H', ⊤) ≃+* (strictHenselization D.s' ⧸ Ideal.span {η}) :=
    (Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv.trans (Ideal.quotEquivOfEq hI)
  have : IsRegularLocalRing Γ(D.H', ⊤) := .of_ringEquiv e.symm
  exact ⟨inferInstance,
    IsRegularLocalRing.isDiscreteValuationRing _ ((ringKrullDim_eq_of_ringEquiv e).trans hdimq)⟩

/-- The curves `D'` and `B'` have dimension one (blueprint `lemma-tangent-cones-on-cover`). -/
theorem ringKrullDim_D'_B'' : ringKrullDim Γ(D.D', ⊤) = 1 ∧ ringKrullDim Γ(D.B', ⊤) = 1 := by
  obtain ⟨ξ, η, hm, hξ, hη⟩ := D.exists_parameters
  obtain ⟨hreg, hdim⟩ := D.regular
  have hm' : maximalIdeal (strictHenselization D.s') = Ideal.span {η, ξ} := by
    rw [hm, Set.pair_comm]
  obtain ⟨-, hloc, hregq, hdimq⟩ :=
    IsRegularLocalRing.quotient_span_singleton_of_maximalIdeal_eq_span_pair hdim hm
  obtain ⟨-, hloc', hregq', hdimq'⟩ :=
    IsRegularLocalRing.quotient_span_singleton_of_maximalIdeal_eq_span_pair hdim hm'
  have hne (x : strictHenselization D.s')
      (hx : ringKrullDim (strictHenselization D.s' ⧸ Ideal.span {x}) = 1) :
      Ideal.span {x} ≠ maximalIdeal (strictHenselization D.s') := by
    intro h
    have := ringKrullDim_eq_of_ringEquiv (Ideal.quotEquivOfEq h)
    rw [hx, ringKrullDim_eq_zero_of_isField
      ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp (maximalIdeal.isMaximal _))] at this
    exact absurd this (by decide)
  let Pη : D.T' := ⟨Ideal.span {η}, (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance⟩
  let Pξ : D.T' := ⟨Ideal.span {ξ}, (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance⟩
  have hPηH : D.π Pη ∈ Set.range M.hH :=
    D.mem_hH_of_snd ((hη Pη).mpr (Ideal.mem_span_singleton_self η))
  have hPηne : Pη ≠ closedPoint _ := fun h ↦ hne η hdimq (congrArg PrimeSpectrum.asIdeal h)
  have key (Z : Set D.T') (hZ : IsClosed Z) (hηZ : Pη ∉ Z) (P : D.T') (hPZ : P ∈ Z)
      (hP : P ≠ closedPoint _) :
      ringKrullDim Γ(reducedClosed (strictHenselization D.s') Z, ⊤) = 1 := by
    rw [ringKrullDim_eq_of_ringEquiv (Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv]
    refine ringKrullDim_quotient_eq_one_of_dim_two hdim ?_ P.asIdeal
      (PrimeSpectrum.vanishingIdeal_le_asIdeal hPZ) fun h ↦ hP (PrimeSpectrum.ext h)
    intro h0
    apply hηZ
    rw [← hZ.closure_eq, ← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, h0]
    simp
  obtain ⟨PB, hPB, hPBne⟩ := D.exists_mem_b_ne_closedPoint
  refine ⟨key _ ?_ ?_ Pξ (Or.inr (D.mem_v_of_fst ((hξ Pξ).mpr (Ideal.mem_span_singleton_self ξ))))
    (fun h ↦ hne ξ hdimq' (congrArg PrimeSpectrum.asIdeal h)),
    key _ (D.isClosed_preimage_range M.b) ?_ PB hPB hPBne⟩
  · rw [Set.preimage_union]
    exact (D.isClosed_preimage_range M.a).union (D.isClosed_preimage_range M.v)
  · rintro (h | h)
    · exact hPηne (D.eq_closedPoint (D.p_fst_of_mem_a h (D.p_snd_of_mem_hH hPηH))
