/-! # Vanishing of the supported restriction for Frobenius

Source: literature/blueprint/latest/blueprint/part-duality-trace-formula/
sec-trace-formula/sec-tf-curve-local/sec-the-local-term-as-a-restriction-map/
sk-lem-tf-curve-restriction-zero/, statement and proof
(blueprint: sk-lem-tf-curve-restriction-zero).

The first statement uses the classical localization-triangle restriction with the
actual Verdier dual as its first factor. The second states its transport to the
specified condensed restriction of the supported-pairing lemma; the third records
that lemma's consequence for every coefficient morphism, without invertibility.
No coefficient model, supported restriction or local term is defined again.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.Etale.CurveLocalModel

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The classical supported restriction vanishes when `K` has zero stalk at `y`.
The model is that of the positive Frobenius iterate; `L` is `D_X K`, not an
independently supplied constructible first factor. `P` is any bounded-below
representative of the specified external product on the strict localization.

Source: sk-lem-tf-curve-restriction-zero, statement and proof
(blueprint: sk-lem-tf-curve-restriction-zero).
Proof: localization identifies `K` with extension by zero from the punctured trait
and its dual with the direct image of the punctured dual. External Künneth gives
`P = Rf_*g_!(N ⊠ Q)`. Strict locality and the zero closed stalk make both full
section complexes zero. Their localization triangles identify the shift of the
supported restriction with ordinary restriction to the punctured diagonal
(det-tf-restriction-zero-localization). Choose the two prime-to-ell covers of
equal degree `d` (det-tf-restriction-zero-covers). Their lisse models have finite
ell-group monodromy and the tangent cones of the reduced graph and vertical axis
avoid those of the diagonal and horizontal axis off the origin. Apply
sk-lem-tf-blowup-restriction upstairs. Ordinary pullback commutes with restriction
and extension by zero. The finite étale trace on the punctured diagonal multiplies
the downstairs restriction by `d^2`, a unit in the finite ell-primary ring, so the
downstairs punctured restriction, and hence the supported restriction, is zero
(det-tf-restriction-zero-trace-descent). -/
theorem curveSupportedRestriction_eq_zero
    {k₀ : Type u} [Field k₀] [Finite k₀] [Algebra k₀ k]
    (X : Over (Spec (.of k))) [QuasiCompact X.hom] [IsSeparated X.hom]
    [SmoothOfRelativeDimension 1 X.hom]
    {X₀ : Scheme.{u}} {f₀ : X₀ ⟶ Spec (.of k₀)} {p : X.left ⟶ X₀}
    {Φ : X ⟶ X}
    (hΦ : ProEtale.CondensedRing.IsModelFrobenius Φ f₀ p)
    (m : ℕ) (hm : 1 ≤ m)
    (y : ProEtale.CondensedRing.RationalPoint X)
    (hy : y ≫ ProEtale.CondensedRing.frobeniusIterate Φ m = y)
    {Λ : Type (u + 1)} [CommRing Λ] [Finite Λ]
    (ell : ℕ) [Fact ell.Prime] (hell : (ell : k) ≠ 0)
    (hΛ : ∃ n : ℕ, (ell : Λ) ^ n = 0)
    (K : DerivedCategory (Sheaf X.left.smallEtaleTopology (ModuleCat.{u + 1} Λ)))
    (hctf : DerivedCategory.boundedConstructibleFiniteTor Λ X.left K)
    (hK : IsZero (D((y.left)^*[ModuleCat.{u + 1} Λ]).obj K)) :
    let M := ofModelFrobenius hΦ hm y hy
    let L := (@verdierDual Λ _ _ M.X _ M.f
      (by
        have : Smooth M.f := SmoothOfRelativeDimension.smooth 1 M.f
        infer_instance)).obj (op K)
    ∀ (P : DerivedCategory.Plus
        (Sheaf M.T.smallEtaleTopology (ModuleCat.{u + 1} Λ)))
      (_eP : P.obj ≅ D((M.τ)^*[ModuleCat.{u + 1} Λ]).obj
        (externalProduct (ModuleCat.{u + 1} Λ) M.f M.f L K)),
      sectionsWithSupportRestriction (ModuleCat.{u + 1} Λ)
        M.b M.a M.yB M.openComplement_yB_le P = 0 := by
  let M := ofModelFrobenius hΦ hm y hy
  have : Smooth X.hom := SmoothOfRelativeDimension.smooth 1 X.hom
  have : HasInvertibleExponent Λ (Spec (.of k)) := by
    obtain ⟨n, hn⟩ := hΛ
    refine ⟨ell ^ n, pow_pos (Fact.out : ell.Prime).pos _, ?_, ?_⟩
    · simpa only [Nat.cast_pow] using hn
    · simpa only [map_pow, map_natCast, Nat.cast_pow] using
        ((pow_ne_zero n hell).isUnit.map (Scheme.ΓSpecIso (.of k)).inv.hom)
  have hKy : IsZero (L((M.y)^*[ModuleCat.{u + 1} Λ]).obj K) :=
    hK.of_iso (((M.y)^*[ModuleCat.{u + 1} Λ]).leftDerivedFunctorIsoMapDerivedCategory.app K)
  dsimp only
  intro P eP
  have eP' : P.obj ≅ L((M.τ)^*[ModuleCat.{u + 1} Λ]).obj
      (externalProduct (ModuleCat.{u + 1} Λ) M.f M.f
        ((verdierDual Λ X.hom).obj (op K)) K) :=
    eP ≪≫ (((M.τ)^*[ModuleCat.{u + 1} Λ]).leftDerivedFunctorIsoMapDerivedCategory.app _).symm
  exact M.sectionsWithSupportRestriction_eq_zero ell hell hΛ _ K
    (constructibleFiniteTor_verdierDual Λ X.hom hctf) hctf hKy P eP'

end AlgebraicGeometry.Etale.CurveLocalModel

open AlgebraicGeometry.ProEtale AlgebraicGeometry.ProEtale.CondensedRing
open WeilConjectures.FiniteRingTrace
open WeilConjectures.FiniteRingTrace.SupportedRestriction

namespace WeilConjectures.FiniteRingTrace.CurveSupportedPairing

attribute [local instance] vdDiscreteTopology tmDiscrete tmTopologicalRing tmCharPrime
  tmSeparated tmFiniteType tmQuasiCompact pointPiece_isProper

private theorem preimage_zero {C₁ C₂ : Type*} [Category C₁] [Category C₂]
    [HasZeroMorphisms C₁] [HasZeroMorphisms C₂] (F : C₁ ⥤ C₂) [F.Full] [F.Faithful]
    {B C : C₁} : F.preimage (0 : F.obj B ⟶ F.obj C) = 0 := by
  apply F.map_injective
  simp

variable {D : FiniteFieldDatum.{u}} (A : Type) [CommRing A] [Finite A]
  (ell : ℕ) [Fact ell.Prime] (hell : ell ≠ D.p)
  (hA : ∃ n : ℕ, 0 < n ∧ ∀ a : A, (ell ^ n) • a = 0)
  (X₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom]
  [IsSeparated X₀.hom] [SmoothOfRelativeDimension 1 X₀.hom]

set_option maxHeartbeats 800000 in
-- Repeated graph and fixed-scheme terms need the same budget as the pairing dependency.
end WeilConjectures.FiniteRingTrace.CurveSupportedPairing
