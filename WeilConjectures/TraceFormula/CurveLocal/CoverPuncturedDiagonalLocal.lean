/-!

# The strictly local cover of the curve

For a cover datum `p : C ⟶ X`, `c` of blueprint `det-tf-restriction-zero-covers`, let `X_y` and
`C_c` be the strict localizations of `X` at `y` and of `C` at `c`, and `ρ : C_c ⟶ X_y` the
induced morphism (`AlgebraicGeometry.Etale.CurveLocalModel.CoverDatum.ρ`). Then:

* `ρ` is finite (`CoverDatum.isFinite_ρ`), as `C_c` is an open and closed subscheme of the finite
  base change of `C ⟶ U` to `X_y`;
* `ρ` is étale away from the closed point (`CoverDatum.etale_ρ`), as `p` is étale over `W ∖ y`;
* the geometric fibre of `ρ` over the closed point is a single point
  (`CoverDatum.subsingleton_geometricFiber_ρ`).

-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing

namespace AlgebraicGeometry.Scheme

/-- Precomposing `ψ : Spec R ⟶ X` with `Spec φ` for a local homomorphism `φ` postcomposes the
induced local ring map with `φ`. -/
lemma stalkClosedPointToOfEq_spec_map_comp {R S : CommRingCat.{u}} [IsLocalRing R]
    [IsLocalRing S] {X : Scheme.{u}} (φ : R ⟶ S) [IsLocalHom φ.hom] (ψ : Spec R ⟶ X) (x : X)
    (hx : ψ (closedPoint R) = x) (hx' : (Spec.map φ ≫ ψ) (closedPoint S) = x) :
    stalkClosedPointToOfEq (Spec.map φ ≫ ψ) x hx' = stalkClosedPointToOfEq ψ x hx ≫ φ := by
  subst hx
  simp only [stalkClosedPointToOfEq, stalkClosedPointTo_spec_map_comp,
    TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_comp_assoc,
    TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]

/-- **The maximal ideal of the strict henselization of a curve.** Let `s` be a `k`-point of a
scheme `Y` over an algebraically closed field `k` whose local ring has principal maximal ideal
`(π)`. Then the maximal ideal of the strict henselization at `s` is generated by the image
of `π`. -/
theorem strictHenselization_maximalIdeal_eq_span_stalk {k : Type u} [Field k] [IsAlgClosed k]
    {Y : Scheme.{u}} (a : Y ⟶ Spec (.of k)) (s : Spec (.of k) ⟶ Y) (hs : s ≫ a = 𝟙 _)
    {π : Y.presheaf.stalk (s default)} (hπ : Ideal.span {π} = maximalIdeal _) :
    maximalIdeal (strictHenselization s) = Ideal.span
      {stalkClosedPointToOfEq (strictLocalizationToBase s) (s default)
        (strictLocalizationToBase_closedPoint s) π} := by
  obtain ⟨V, hV, hcV, _, -, φ, hφ, hker⟩ := exists_affineChart_of_point a s hs
  obtain ⟨_, ρ, hρ, hm⟩ := strictHenselization_chart_maximalIdeal Γ(Y, V) hV.fromSpec
    (Spec.map (CommRingCat.ofHom φ.toRingHom))
  subst hφ
  have e : ⊤ ≤ strictLocalizationToBase (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫
      hV.fromSpec) ⁻¹ᵁ V :=
    (preimage_eq_top_of_closedPoint_mem _ ((strictLocalizationToBase_closedPoint
      (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ hV.fromSpec)).symm ▸ hcV)).ge
  have hρ' : ρ = (strictLocalizationToBase _).appLE V ⊤ e ≫ (ΓSpecIso _).hom :=
    Spec.map_injective ((cancel_mono hV.fromSpec).mp (by rw [Spec_map_appLE_comp_fromSpec, hρ]))
  have hρx (x : Γ(Y, V)) : ρ x = stalkClosedPointToOfEq (strictLocalizationToBase _) _
      (strictLocalizationToBase_closedPoint _) (Y.presheaf.germ V _ hcV x) := by
    rw [stalkClosedPointToOfEq_germ, hρ']
    rfl
  refine le_antisymm ?_ ?_
  · have hpt : (Spec.map (CommRingCat.ofHom φ.toRingHom) (closedPoint k)).asIdeal =
        RingHom.ker φ.toRingHom := Spec_map_closedPoint_asIdeal (F := Γ(Y, V) →ₐ[k] k) φ
    rw [hm]
    refine le_trans (Ideal.map_mono (le_of_eq hpt)) ?_
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hπ ▸ hker x hx)
    rw [Ideal.mem_comap, hρx, ← hb, map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact map_mem_maximalIdeal_of_isLocalHom _ (hπ ▸ Ideal.mem_span_singleton_self π)

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Etale.CurveLocalModel

open Scheme

variable {k : Type u} [Field k] [IsAlgClosed k] (M : CurveLocalModel k)

/-- The strict localization `X_y` of the curve `X` at `y`. -/
noncomputable abbrev Xy : Scheme.{u} := strictLocalization M.y

/-- The punctured strict localization `X_y ∖ {y}`. -/
noncomputable def Xyo : M.Xy.Opens :=
  ⟨{closedPoint (strictHenselization M.y)}ᶜ, (isClosed_singleton_closedPoint _).isOpen_compl⟩

lemma mem_Xyo_iff (z : M.Xy) : z ∈ M.Xyo ↔ z ≠ closedPoint (strictHenselization M.y) :=
  Iff.rfl

/-- A point of `X_y` lying over `y` is the closed point. -/
lemma eq_closedPoint_of_toBase_eq (z : M.Xy) (hz : strictLocalizationToBase M.y z = M.y default) :
    z = closedPoint (strictHenselization M.y) :=
  eq_closedPoint_of_strictLocalizationToBase_eq M.y z
    (hz.trans (congrArg _ (Subsingleton.elim _ _)))

/-- Let `φ : R ⟶ S` be a finite homomorphism of local rings and `evR : R ⟶ k`, `evS : S ⟶ k`
compatible points with values in a field, where `evR` has a section and `ker evS` is the maximal
ideal. Then `evS` is the only point of `S` extending `evR`. -/
lemma _root_.CommRingCat.eq_of_comp_eq_of_finite {R S : CommRingCat.{u}} [IsLocalRing S]
    {K : Type u} [Field K] (φ : R ⟶ S) (hφ : φ.hom.Finite) (evR : R ⟶ CommRingCat.of K)
    (evS : S ⟶ CommRingCat.of K) (hS : φ ≫ evS = evR)
    (hker : RingHom.ker evS.hom = maximalIdeal S) (σ : CommRingCat.of K ⟶ R)
    (hσ : σ ≫ evR = 𝟙 _) (χ : S ⟶ CommRingCat.of K) (hχ : φ ≫ χ = evR) : χ = evS := by
  have hmax : (RingHom.ker evR.hom).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ fun a ↦ ⟨σ a, by
      rw [← CommRingCat.comp_apply, hσ, CommRingCat.id_apply]⟩
  have hχker : RingHom.ker χ.hom = maximalIdeal S := by
    refine IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_of_isIntegral_of_isMaximal_comap φ.hom hφ.to_isIntegral _ ?_)
    rw [RingHom.comap_ker, ← CommRingCat.hom_comp, hχ]
    exact hmax
  have key (χ' : S ⟶ CommRingCat.of K) (h : φ ≫ χ' = evR) (t : K) : χ' (φ (σ t)) = t := by
    have := congrArg (fun f ↦ f.hom t) (show σ ≫ φ ≫ χ' = 𝟙 _ by rw [h, hσ])
    simpa using this
  ext s
  have hsub : s - φ (σ (evS s)) ∈ RingHom.ker evS.hom := by
    rw [RingHom.mem_ker, map_sub, key evS hS, sub_self]
  rw [hker, ← hχker, RingHom.mem_ker, map_sub, sub_eq_zero, key χ hχ] at hsub
  exact hsub

namespace CoverDatum

variable {M} {ℓ : ℕ} {Λ : Type (u + 1)} [CommRing Λ]
  {PL PK : CochainComplex (Sheaf M.X.smallEtaleTopology (ModuleCat.{u + 1} Λ)) ℤ}
  (D : M.CoverDatum ℓ PL PK)

/-- The strict localization `C_c` of the cover curve `C` at `c`. -/
noncomputable abbrev Cc : Scheme.{u} := strictLocalization D.c

/-- The morphism `ρ : C_c ⟶ X_y` of strict localizations induced by `p`. -/
noncomputable def ρ : D.Cc ⟶ M.Xy :=
  strictLocalizationMap D.p D.c ≫ eqToHom (by rw [D.c_comp])

@[reassoc]
lemma ρ_comp_toBase :
    D.ρ ≫ strictLocalizationToBase M.y = strictLocalizationToBase D.c ≫ D.p := by
  rw [ρ, Category.assoc, eqToHom_comp_strictLocalizationToBase D.c_comp,
    strictLocalizationMap_comp_strictLocalizationToBase]

@[reassoc]
lemma pt_comp_ρ :
    Spec.map (strictHenselizationEval D.c) ≫ D.ρ = Spec.map (strictHenselizationEval M.y) := by
  rw [ρ, ← Category.assoc, spec_map_strictHenselizationEval_comp_strictLocalizationMap,
    spec_map_strictHenselizationEval_comp_eqToHom D.c_comp]

omit [IsAlgClosed k] in
lemma c_pU_ι : (D.c ≫ D.pU) ≫ D.U.ι = M.y := by
  rw [Category.assoc, D.pU_ι, D.c_comp]

/-- `ρ` factors through the strict localization of `U` at `y`. -/
lemma ρ_eq : D.ρ = strictLocalizationMap D.pU D.c ≫
    strictLocalizationMap D.U.ι (D.c ≫ D.pU) ≫ eqToHom (by rw [D.c_pU_ι]) := by
  refine hom_strictLocalization_ext M.y ?_ (Spec.map (strictHenselizationEval D.c))
    (closedPoint k) (spec_map_strictHenselizationEval_apply _ _) ?_
  · rw [ρ_comp_toBase, Category.assoc, Category.assoc,
      eqToHom_comp_strictLocalizationToBase D.c_pU_ι,
      strictLocalizationMap_comp_strictLocalizationToBase, ← Category.assoc,
      strictLocalizationMap_comp_strictLocalizationToBase, Category.assoc, D.pU_ι]
  · rw [pt_comp_ρ, ← Category.assoc, spec_map_strictHenselizationEval_comp_strictLocalizationMap,
      ← Category.assoc, spec_map_strictHenselizationEval_comp_strictLocalizationMap,
      spec_map_strictHenselizationEval_comp_eqToHom D.c_pU_ι]

instance isFinite_ρ : IsFinite D.ρ := by
  rw [ρ_eq]
  have : IsFinite (strictLocalizationMap D.pU D.c) := by
    rw [← strictLocalizationToPullback_fst D.pU D.c]
    infer_instance
  have := isIso_strictLocalizationMap_of_isOpenImmersion D.U.ι (D.c ≫ D.pU)
  infer_instance

/-- A point of `C_c` not over the closed point of `X_y` maps into `p⁻¹(W ∖ y)`. -/
lemma toBase_mem_of_mem_Xyo (z : D.Cc) (hz : D.ρ z ∈ M.Xyo) :
    strictLocalizationToBase D.c z ∈ D.p ⁻¹ᵁ puncturedOpens D.W _ M.isClosed_y := by
  refine ⟨range_strictLocalizationToBase_subset D.c (D.p ⁻¹ᵁ D.W : Set D.C)
    (D.p ⁻¹ᵁ D.W).isOpen default (by
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, D.c_comp]
      exact D.mem_W) ⟨z, rfl⟩, fun h ↦ hz (M.eq_closedPoint_of_toBase_eq _ ?_)⟩
  rw [← Scheme.Hom.comp_apply, ρ_comp_toBase, Scheme.Hom.comp_apply]
  exact h

/-- **`ρ` is étale away from the closed point**: `p` is étale over `W ∖ y`. -/
instance etale_ρ : Etale ((D.ρ ⁻¹ᵁ M.Xyo).ι ≫ D.ρ) := by
  let Wp := puncturedOpens D.W _ M.isClosed_y
  have hpU : D.pU ⁻¹ᵁ (D.U.ι ⁻¹ᵁ Wp) = D.p ⁻¹ᵁ Wp := by
    rw [← D.pU_ι]
    rfl
  have : Etale ((D.pU ⁻¹ᵁ (D.U.ι ⁻¹ᵁ Wp)).ι ≫ D.pU) := by
    have : Etale ((D.p ⁻¹ᵁ Wp).ι ≫ D.p) := by
      have := D.etale
      rw [← morphismRestrict_ι]
      infer_instance
    have : Etale ((D.pU ⁻¹ᵁ (D.U.ι ⁻¹ᵁ Wp)).ι ≫ D.pU ≫ D.U.ι) := by
      rw [D.pU_ι, hpU]
      exact this
    rw [← Category.assoc] at this
    exact Etale.of_comp _ D.U.ι
  let P := pullback (strictLocalizationToBase (D.c ≫ D.pU)) D.pU
  have hP := (IsPullback.of_hasPullback (strictLocalizationToBase (D.c ≫ D.pU)) D.pU).flip
  have := etale_comp_ι_of_isPullback hP (D.pU ⁻¹ᵁ (D.U.ι ⁻¹ᵁ Wp))
  let O := pullback.snd (strictLocalizationToBase (D.c ≫ D.pU)) D.pU ⁻¹ᵁ
    (D.pU ⁻¹ᵁ (D.U.ι ⁻¹ᵁ Wp))
  have hrange : Set.range ((D.ρ ⁻¹ᵁ M.Xyo).ι ≫ strictLocalizationToPullback D.pU D.c).base ⊆
      O := by
    rintro _ ⟨z, rfl⟩
    have h : (strictLocalizationToPullback D.pU D.c ≫ pullback.snd _ _) z.1 ∈
        D.pU ⁻¹ᵁ (D.U.ι ⁻¹ᵁ Wp) := by
      rw [strictLocalizationToPullback_snd, hpU]
      exact D.toBase_mem_of_mem_Xyo z.1 z.2
    exact h
  let l := IsOpenImmersion.lift O.ι ((D.ρ ⁻¹ᵁ M.Xyo).ι ≫ strictLocalizationToPullback D.pU D.c)
    (by rwa [Opens.range_ι])
  have hl : l ≫ O.ι = (D.ρ ⁻¹ᵁ M.Xyo).ι ≫ strictLocalizationToPullback D.pU D.c :=
    IsOpenImmersion.lift_fac _ _ _
  have : IsOpenImmersion l := by
    have : IsOpenImmersion (l ≫ O.ι) := by
      rw [hl]
      infer_instance
    exact IsOpenImmersion.of_comp l O.ι
  have := isIso_strictLocalizationMap_of_isOpenImmersion D.U.ι (D.c ≫ D.pU)
  have h : (D.ρ ⁻¹ᵁ M.Xyo).ι ≫ D.ρ = l ≫ (O.ι ≫ pullback.fst _ _) ≫
      strictLocalizationMap D.U.ι (D.c ≫ D.pU) ≫ eqToHom (by rw [D.c_pU_ι]) := by
    rw [Category.assoc, reassoc_of% hl, strictLocalizationToPullback_fst_assoc, ← ρ_eq]
  rw [h]
  infer_instance

/-- **The geometric fibre of `ρ` over the closed point is a single point**: a geometric point of
`C_c` over the closed point of `X_y` is the canonical one, as the residue field of `C_c` is
that of `X_y`. -/
lemma geometricFiber_ρ_eq (x : D.ρ.GeometricFiber (Spec.map (strictHenselizationEval M.y))) :
    x.1 = Spec.map (strictHenselizationEval D.c) := by
  obtain ⟨χ, hχ⟩ : ∃ χ, Spec.map χ = x.1 := ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨φ, hφ⟩ : ∃ φ, Spec.map φ = D.ρ := ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨σ, hσ⟩ : ∃ σ, Spec.map σ = strictLocalizationToBase M.y ≫ M.f :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hfin : φ.hom.Finite := by
    rw [← IsFinite.SpecMap_iff, hφ]
    infer_instance
  rw [← hχ]
  congr 1
  refine CommRingCat.eq_of_comp_eq_of_finite φ hfin (strictHenselizationEval M.y) _
    (Spec.map_injective ?_) (maximalIdeal_strictHenselization (s := D.c)).symm σ
    (Spec.map_injective ?_) χ (Spec.map_injective ?_)
  · rw [Spec.map_comp, hφ, pt_comp_ρ]
  · rw [Spec.map_comp, hσ, ← Category.assoc,
      spec_map_strictHenselizationEval_comp_strictLocalizationToBase,
      M.y_comp, Spec.map_id]
  · rw [Spec.map_comp, hφ, hχ, x.2]

/-- The ring map of `ρ` on strict henselizations is local: `ρ` maps the closed point to the
closed point. -/
instance isLocalHom_preimage_ρ : IsLocalHom (Spec.preimage D.ρ).hom := by
  have h : Spec.preimage D.ρ ≫ strictHenselizationEval D.c = strictHenselizationEval M.y :=
    Spec.map_injective (by rw [Spec.map_comp, Spec.map_preimage, pt_comp_ρ])
  refine ⟨fun a ha ↦ (isUnit_iff_strictHenselizationEval_ne_zero a).2 ?_⟩
  rw [← h, CommRingCat.comp_apply]
  exact (ha.map (strictHenselizationEval D.c).hom).ne_zero

/-- **Uniformizers of the strict henselizations**: a uniformizer `U` at `y` becomes `w Ξ^e` at
`c` for a unit `w` and a uniformizer `Ξ`. -/
theorem exists_uniformizers : ∃ (U : strictHenselization M.y) (Ξ w : strictHenselization D.c),
    Ideal.span {U} = maximalIdeal _ ∧ Ideal.span {Ξ} = maximalIdeal _ ∧ IsUnit w ∧
      Spec.preimage D.ρ U = w * Ξ ^ D.e := by
  obtain ⟨_, _⟩ := isDiscreteValuationRing_stalk_of_isClosed M.f M.isClosed_y
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible
    (M.X.presheaf.stalk (M.y (default : Spec (.of k))))
  obtain ⟨w, ξ, hw, hξ, hram⟩ := D.ramification ϖ hϖ.maximalIdeal_eq.symm
  have hpc : D.p (D.c default) = M.y default := by
    rw [← Scheme.Hom.comp_apply, D.c_comp]
  have hcomp : stalkClosedPointToOfEq (strictLocalizationToBase M.y) (M.y default)
      (strictLocalizationToBase_closedPoint M.y) ≫ Spec.preimage D.ρ =
      M.X.presheaf.stalkSpecializes (specializes_of_eq hpc) ≫ D.p.stalkMap (D.c default) ≫
        stalkClosedPointToOfEq (strictLocalizationToBase D.c) (D.c default)
          (strictLocalizationToBase_closedPoint D.c) := by
    have h₁ : Spec.map (Spec.preimage D.ρ) ≫ strictLocalizationToBase M.y =
        strictLocalizationToBase D.c ≫ D.p := by
      rw [Spec.map_preimage, ρ_comp_toBase]
    rw [← stalkClosedPointToOfEq_spec_map_comp _ _ _ _
        (by rw [h₁, Scheme.Hom.comp_apply, strictLocalizationToBase_closedPoint, hpc]),
      stalkClosedPointToOfEq_congr h₁, stalkClosedPointToOfEq_comp _ _ _
        (strictLocalizationToBase_closedPoint D.c) _ hpc]
  refine ⟨_, _, _, (strictHenselization_maximalIdeal_eq_span_stalk M.f M.y M.y_comp
    hϖ.maximalIdeal_eq.symm).symm, (strictHenselization_maximalIdeal_eq_span_stalk D.fC D.c
    D.c_comp_fC hξ).symm, hw.map (stalkClosedPointToOfEq (strictLocalizationToBase D.c)
      (D.c default) (strictLocalizationToBase_closedPoint D.c)).hom, ?_⟩
  have hram' : (M.X.presheaf.stalkSpecializes (specializes_of_eq hpc) ≫
      D.p.stalkMap (D.c default)).hom ϖ = w * ξ ^ D.e := hram
  rw [← CommRingCat.comp_apply, hcomp, ← Category.assoc, CommRingCat.comp_apply, hram',
    map_mul, map_pow]

/-- **The degree of `ρ`**: the geometric fibre of `ρ` over a geometric point of `X_y` away from
the closed point has `e` points. -/
theorem natCard_geometricFiber_ρ {Ω : Type u} [Field Ω] [IsSepClosed Ω]
    (z : Spec (.of Ω) ⟶ M.Xy) (hz : z default ∈ M.Xyo) :
    Nat.card (D.ρ.GeometricFiber z) = D.e := by
  obtain ⟨U, Ξ, w, hU, hΞ, hw, he⟩ := D.exists_uniformizers
  have hRX := isRegularLocalRing_strictHenselization_of_smoothOfRelativeDimension M.f 1 M.y
    M.y_comp
  have hRC := isRegularLocalRing_strictHenselization_of_smoothOfRelativeDimension D.fC 1 D.c
    D.c_comp_fC
  have := hRX.1
  have := hRC.1
  have : IsDiscreteValuationRing (strictHenselization M.y) :=
    IsRegularLocalRing.isDiscreteValuationRing _ (by exact_mod_cast hRX.2)
  have : IsDiscreteValuationRing (strictHenselization D.c) :=
    IsRegularLocalRing.isDiscreteValuationRing _ (by exact_mod_cast hRC.2)
  set φ := Spec.preimage D.ρ
  have hφ : Spec.map φ = D.ρ := Spec.map_preimage _
  let := φ.hom.toAlgebra
  have : Module.Finite (strictHenselization M.y) (strictHenselization D.c) := by
    have : φ.hom.Finite := by
      rw [← IsFinite.SpecMap_iff, hφ]
      infer_instance
    exact this
  obtain ⟨σ, hσ⟩ : ∃ σ, Spec.map σ = strictLocalizationToBase M.y ≫ M.f :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hσ' : σ ≫ strictHenselizationEval M.y = 𝟙 _ := Spec.map_injective (by
    rw [Spec.map_comp, hσ, ← Category.assoc,
      spec_map_strictHenselizationEval_comp_strictLocalizationToBase, M.y_comp, Spec.map_id])
  have hev : φ ≫ strictHenselizationEval D.c = strictHenselizationEval M.y :=
    Spec.map_injective (by rw [Spec.map_comp, hφ, pt_comp_ρ])
  obtain ⟨_, hrank⟩ := IsDiscreteValuationRing.flat_and_finrank_eq_of_algebraMap_eq
    (strictHenselizationEval M.y).hom (fun a ↦ ⟨σ a, by
      rw [← CommRingCat.comp_apply, hσ', CommRingCat.id_apply]⟩)
    (strictHenselizationEval D.c).hom (congrArg CommRingCat.Hom.hom hev)
    (maximalIdeal_strictHenselization (s := D.c)).symm hU hΞ hw D.one_le_e he
  have : Module.Free (strictHenselization M.y) (strictHenselization D.c) :=
    Module.free_of_flat_of_isLocalRing
  obtain ⟨ζ, hζ⟩ : ∃ ζ, Spec.map ζ = z := ⟨Spec.preimage _, Spec.map_preimage _⟩
  have het := etale_pullback_snd_of_range D.ρ M.Xyo z (by
    rintro _ ⟨q, rfl⟩
    rw [Subsingleton.elim q default]
    exact hz)
  rw [← hφ, ← hζ] at het
  have het' : Etale (pullback.fst (Spec.map ζ) (Spec.map φ)) := by
    rw [← pullbackSymmetry_hom_comp_snd]
    infer_instance
  rw [← hrank, ← hζ, ← hφ]
  have key := Scheme.Hom.natCard_geometricFiber_Spec_map_eq_finrank
    (R := strictHenselization M.y) (S := strictHenselization D.c) ζ.hom het'
  exact key

end CoverDatum

end AlgebraicGeometry.Etale.CurveLocalModel
