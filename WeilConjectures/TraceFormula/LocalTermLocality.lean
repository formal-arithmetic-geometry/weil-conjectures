/-!

# Local terms of contracting correspondences

Let `c = (c₁, c₂) : C ⟶ X × X` be an endocorrespondence of `(X, K)` with coefficient map
`u : Lc₂^* K ⟶ Rc₁^! K`, and let `y` be a `k`-point of `C` lying on the fixed locus,
`c₁(y) = c₂(y)`. Following Varshavsky (*Lefschetz–Verdier trace formula and a generalization of
a theorem of Fujiwara*, Def. 2.1.1), `c` is *contracting at `y`*
(`ProEtale.CondensedRing.Correspondence.IsContractingAt`) if the fibre `c₁⁻¹(c₁ y)` is the
reduced point `y` and, in the local ring `𝒪_{C,y}`,
```
(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}        for some n ≥ 1,
```
where `c_i^♯ 𝔪` is the ideal generated by the maximal ideal of `𝒪_{X, c_i(y)}`. For the graph
`(𝟙, Φ_m)` of a Frobenius this holds with `n = 1` at every fixed rational point: in affine
coordinates `Φ_m^♯ (t_i - a_i) = (t_i - a_i)^{q^m}`.

This file sets up the contracting correspondences used for the locality of local terms (blueprint
`corollary-contracting-local-terms-point`, `theorem-contracting-correspondences-local-terms`):

* the predicate `ProEtale.CondensedRing.Correspondence.IsContractingAt`;
* the restricted coefficient map `u_Z : K_x ⟶ K_x` at a point `y` of the fixed locus with
  reduced fibre `c₁⁻¹(x) = {y}` (`Correspondence.restrictedStalkMap`,
  `Correspondence.contractingStalkMap`) and the proper pushforward diagram `(x, y)` along which it
  is pushed to the closed piece `K^Z = Rx_* Lx^* K` (`Correspondence.restrictedClosedPieceDiagram`);
* the contraction of the Frobenius graph at its fixed rational points
  (`Correspondence.isContractingAt_ofGraph_frobeniusIterate`).

The locality statements themselves are downstream:
1. at a contracting fixed point the local term of a graph correspondence `(𝟙, h)` is the trace
   of the stalk map (`Correspondence.localTerm_traceClass_ofGraph_eq_trace_of_isContractingAt`,
   in `WeilConjectures.TraceFormula.ContractingGraph`);
2. at a contracting fixed point with zero stalk, the local term vanishes, in particular for the
   graph of a Frobenius (`Correspondence.localTerm_traceClass_eq_zero_of_isContractingAt`,
   `Correspondence.localTerm_traceClass_frobeniusGraph_eq_zero`, in
   `WeilConjectures.TraceFormula.ContractingLocalTerm`). On smooth curves the blueprint proves the
   Frobenius case without the contracting theorem
   (`Correspondence.localTerm_traceClass_frobeniusGraph_eq_zero_of_smooth`, blueprint
   `lemma-vanishing-local-term-zero-stalk--2`, in
   `WeilConjectures.TraceFormula.FrobeniusCurveLocalTerm`).

Both follow from Varshavsky's theorem
(`Correspondence.restrict_traceClass_eq_pushforward_of_isContractingAt`, in
`WeilConjectures.TraceFormula.ContractingLocalTerm`), which combines the additivity along the
pieces of `{x}` (`Correspondence.traceClass_eq_add_of_isPullback`, in
`WeilConjectures.TraceFormula.ContractingAdditivity`) and the vanishing of the trace class for
coefficients with zero stalk (`Correspondence.restrict_traceClass_eq_zero_of_isContractingAt`, in
`WeilConjectures.TraceFormula.Specialization.Vanishing`).

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

attribute [local instance] boundedConstructibleBraiding

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]
  {X : Over (Spec (.of k))} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  {K : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧}

namespace Correspondence

variable (c : Correspondence ℓ K)

/-- An endocorrespondence `c = (c₁, c₂)` is *contracting at* the `k`-point `y` of its support
(blueprint `corollary-contracting-local-terms-point`; Varshavsky, Def. 2.1.1, with the legs
interchanged): `y` lies on the fixed locus, the fibre `c₁⁻¹(c₁ y)` is the reduced point `y`, and
`(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}` in `𝒪_{C,y}` for some `n ≥ 1`, where `c_i^♯ 𝔪` is the ideal
generated by the maximal ideal of `𝒪_{X, c_i(y)}`. -/
structure IsContractingAt (y : RationalPoint c.C) : Prop where
  /-- `y` lies on the fixed locus. -/
  comp_c₁_eq_comp_c₂ : y ≫ c.c₁ = y ≫ c.c₂
  /-- the fibre `c₁⁻¹(c₁ y)` is the reduced point `y`: the square `y ≫ c₁ = 𝟙 ≫ (y ≫ c₁)` is
  cartesian. -/
  isPullback : IsPullback y (𝟙 (point k)) c.c₁ (y ≫ c.c₁)
  /-- the contraction condition `(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}`. -/
  exists_le_pow : ∃ n : ℕ, 1 ≤ n ∧
    ((IsLocalRing.maximalIdeal
        (X.left.presheaf.stalk (c.c₂.left (y.left (default : Spec (.of k)))))).map
        (c.c₂.left.stalkMap (y.left (default : Spec (.of k)))).hom) ^ n ≤
      ((IsLocalRing.maximalIdeal
        (X.left.presheaf.stalk (c.c₁.left (y.left (default : Spec (.of k)))))).map
        (c.c₁.left.stalkMap (y.left (default : Spec (.of k)))).hom) ^ (n + 1)

variable {c} in
/-- The *restricted coefficient map* `u_Z : K_x ⟶ K_x` of a correspondence at a `k`-point `y` of
the fixed locus whose fibre `c₁⁻¹(x)`, `x = c₁(y) = c₂(y)`, is the reduced point `y` (blueprint
`prose-E-29` for `Z = {x}`): the restriction
```
K_x ≅ Ly^* Lc₂^* K --Ly^* u--> Ly^* Rc₁^! K --β--> R(𝟙)^! K_x ≅ K_x
```
of `u` to `y`, where `β` is the base change mate of the cartesian square `y ≫ c₁ = 𝟙 ≫ x`: the
`R(𝟙)_! ⊣ R(𝟙)^!` adjoint of `R(𝟙)_! Ly^* Rc₁^! K ≅ Lx^* Rc₁_! Rc₁^! K ⟶ Lx^* K`. -/
noncomputable def restrictedStalkMap {y : RationalPoint c.C} (hy : y ≫ c.c₁ = y ≫ c.c₂)
    (sq : IsPullback y (𝟙 (point k)) c.c₁ (y ≫ c.c₁)) :
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).obj K ⟶
      (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).obj K :=
  haveI := isIso_boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq
  eqToHom (by rw [hy]) ≫
    (boundedConstructibleUpperStarComp (Profinite.padicAlgClRingObj ℓ) ℓ y c.c₂).hom.app K ≫
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ y).map c.u ≫
    (boundedConstructibleUpperShriekAdjunction ℓ
      (𝟙 (point k))).homEquiv _ _
      ((asIso (boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ sq)).inv.app
          ((boundedConstructibleUpperShriek ℓ c.c₁).obj K) ≫
        (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).map
          ((boundedConstructibleUpperShriekAdjunction ℓ
            c.c₁).counit.app K)) ≫
    (boundedConstructibleUpperShriekId ℓ (point k)).hom.app _

variable {c} in
/-- The restricted coefficient map `u_Z : K_x ⟶ K_x` (`restrictedStalkMap`) of a correspondence
contracting at `y`. -/
noncomputable abbrev contractingStalkMap {y : RationalPoint c.C} (hc : c.IsContractingAt y) :
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).obj K ⟶
      (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).obj K :=
  restrictedStalkMap hc.comp_c₁_eq_comp_c₂ hc.isPullback

variable {c} in
/-- If the fibre `c₁⁻¹(x)` of `x = c₁(y)` is the point `y` and `c₂(y) = x`, the closed
subscheme `{x}` is `c`-invariant: `c₁⁻¹(x) ⊆ c₂⁻¹(x)`, that is,
`c₂⁻¹(X ∖ {x}) ⊆ c₁⁻¹(X ∖ {x})`. -/
lemma preimage_pointComplOpens_le_of_isPullback {y : RationalPoint c.C}
    (hy : y ≫ c.c₁ = y ≫ c.c₂) (sq : IsPullback y (𝟙 (point k)) c.c₁ (y ≫ c.c₁)) :
    c.c₂.left ⁻¹ᵁ pointComplOpens (y ≫ c.c₁) ≤ c.c₁.left ⁻¹ᵁ pointComplOpens (y ≫ c.c₁) := by
  have hsq : IsPullback y.left (𝟙 _) c.c₁.left (y ≫ c.c₁).left := sq.map (Over.forget _)
  intro z hz
  simp only [pointComplOpens, Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_mk,
    Set.mem_compl_iff, Set.mem_range, not_exists] at hz ⊢
  intro p hp
  have hmem : z ∈ Set.range (pullback.fst c.c₁.left (y ≫ c.c₁).left) := by
    rw [Scheme.Pullback.range_fst]
    exact ⟨p, hp⟩
  obtain ⟨q, rfl⟩ := hmem
  refine hz (hsq.isoPullback.inv.base q) ?_
  refine (congrArg (fun f : point k ⟶ X ↦ f.left.base (hsq.isoPullback.inv.base q)) hy).trans ?_
  rw [← hsq.isoPullback_inv_fst]
  rfl

variable {c} in
/-- The proper pushforward diagram `(x, y)`, `x = c₁(y)`, from the identity correspondence of
the point with the restricted coefficient map `u_Z` to `c`: a diagram since `y ≫ c₁ = 𝟙 ≫ x`
and `y ≫ c₂ = 𝟙 ≫ x`. -/
noncomputable abbrev restrictedClosedPieceDiagram {y : RationalPoint c.C}
    (hy : y ≫ c.c₁ = y ≫ c.c₂) (sq : IsPullback y (𝟙 (point k)) c.c₁ (y ≫ c.c₁)) :
    (ofEnd _ (restrictedStalkMap hy sq)).ProperPushforwardDiagram X where
  f := y ≫ c.c₁
  D := c.C
  b₁ := c.c₁
  b₂ := c.c₂
  g := y
  w₁ := (Category.id_comp _).symm
  w₂ := hy.symm.trans (Category.id_comp _).symm

variable {c}

/-- Being contracting at a point only depends on the support of the correspondence. -/
lemma IsContractingAt.withCoeff {y : RationalPoint c.C} (hc : c.IsContractingAt y)
    (K' : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (u' : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ c.c₂).obj K' ⟶
      (boundedConstructibleUpperShriek ℓ c.c₁).obj K') :
    (c.withCoeff K' u').IsContractingAt y :=
  ⟨hc.1, hc.2, hc.3⟩

lemma comp_eq_of_isContractingAt_ofGraph {h : X ⟶ X}
    {v : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ h).obj K ⟶ K}
    {x : RationalPoint X} (hc : (ofGraph K h v).IsContractingAt x) : x ≫ h = x := by
  have := hc.comp_c₁_eq_comp_c₂
  simp only [ofGraph, Category.comp_id] at this
  exact this.symm

omit [Fact (ringChar k).Prime] [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
  [IsSeparated X.hom] in
/-- The underlying morphism of the iterate `Φ_m` of the model Frobenius lifts the `m`-th iterate
of the Frobenius `F₀` of the model: `Φ_m ≫ p = p ≫ F₀^m`. -/
lemma frobeniusIterate_left_comp_eq {X₀ : Scheme.{u}} {p : X.left ⟶ X₀}
    {Φ : X ⟶ X} {F₀ : X₀ ⟶ X₀} (hp : Φ.left ≫ p = p ≫ F₀) (m : ℕ) :
    (frobeniusIterate Φ m).left ≫ p = p ≫ End.asHom (End.of F₀ ^ m) := by
  rw [frobeniusIterate_left]
  exact End.asHom_pow_comp_eq_comp_asHom_pow hp m

/-- The stalk map of the identity maps the maximal ideal onto itself. -/
lemma _root_.AlgebraicGeometry.Scheme.map_maximalIdeal_stalkMap_id (S : Scheme.{u}) (y : S) :
    (IsLocalRing.maximalIdeal (S.presheaf.stalk ((𝟙 S : S ⟶ S).base y))).map
      ((𝟙 S : S ⟶ S).stalkMap y).hom = IsLocalRing.maximalIdeal (S.presheaf.stalk y) := by
  rw [Scheme.Hom.stalkMap_id]
  exact Ideal.map_id _

/-- **The Frobenius graph is contracting at its fixed rational points** (blueprint
`corollary-contracting-local-terms-point`, proof of item 3): for the model Frobenius `Φ` of a model
over a finite field, `m ≥ 1` and any coefficient map `v`, the graph correspondence `(𝟙, Φ_m)` is
contracting at a rational point `x` fixed by `Φ_m`: the fibre of `𝟙` is the reduced point, and
`Φ_m^♯ 𝔪 ⊆ 𝔪²` since `Φ_m^♯ (t_i - a_i) = (t_i - a_i)^{q^m}` in affine coordinates
(`AlgebraicGeometry.map_maximalIdeal_stalkMap_le_sq_of_isFrobenius`). -/
theorem isContractingAt_ofGraph_frobeniusIterate {k₀ : Type u} [Field k₀] [Finite k₀]
    [Algebra k₀ k] {X₀ : Scheme.{u}} {f₀ : X₀ ⟶ Spec (.of k₀)} {p : X.left ⟶ X₀} {Φ : X ⟶ X}
    (hΦ : IsModelFrobenius Φ f₀ p) {m : ℕ} (hm : 1 ≤ m)
    (v : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (frobeniusIterate Φ m)).obj K ⟶ K) (x : RationalPoint X)
    (hx : x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₁ =
      x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₂) :
    (ofGraph K (frobeniusIterate Φ m) v).IsContractingAt x := by
  obtain ⟨F₀, hF₀, hp⟩ := hΦ.exists_isFrobenius
  have hxa : x.left ≫ X.hom = 𝟙 _ := Over.w x
  have hfix : x.left ≫ (frobeniusIterate Φ m).left = x.left := by
    have := congrArg CommaMorphism.left hx
    simpa [ofGraph] using this.symm
  refine ⟨hx, ?_, 1, le_rfl, ?_⟩
  · have : IsIso (ofGraph K (frobeniusIterate Φ m) v).c₁ := inferInstanceAs (IsIso (𝟙 X))
    exact IsPullback.of_vert_isIso ⟨by rw [Category.id_comp]⟩
  refine (pow_one _).le.trans (le_of_le_of_eq
    (map_maximalIdeal_stalkMap_le_sq_of_isFrobenius hΦ.isPullback hm (hF₀.pow f₀ m)
      (Over.w (frobeniusIterate Φ m)) (frobeniusIterate_left_comp_eq hp m) x.left hxa hfix _) ?_)
  exact congrArg (· ^ 2) (Scheme.map_maximalIdeal_stalkMap_id X.left _).symm

end Correspondence

end AlgebraicGeometry.ProEtale.CondensedRing
