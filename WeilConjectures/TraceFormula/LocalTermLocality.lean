public import WeilConjectures.AlgebraicGeometry.Morphisms.FrobeniusContracting
public import WeilConjectures.Mathlib.CategoryTheory.Endomorphism
public import WeilConjectures.TraceFormula.GraphPieces
public import WeilConjectures.TraceFormula.PointNormalization
public import WeilConjectures.TraceFormula.ProperCompatibility

/-!

# Local terms of contracting correspondences

Let `c = (c₁, c₂) : C ⟶ X × X` be an endocorrespondence of `(X, K)` with coefficient map
`u : Lc₂^* K ⟶ Rc₁^! K`, and let `y` be a `k`-point of `C` lying on the fixed locus,
`c₁(y) = c₂(y)`. Following Varshavsky (*Lefschetz–Verdier trace formula and a generalization of
a theorem of Fujiwara*, Def. 2.1.1), `c` is *contracting at `y`*
(`ProEtale.CondensedRing.Correspondence.IsContractingAt`) if the fibre `c₁⁻¹(c₁ y)` is the
reduced point `y` and, in the local ring `𝒪_{C,y}`,
```
(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}        for some n ≥ 1,
```
where `c_i^♯ 𝔪` is the ideal generated by the maximal ideal of `𝒪_{X, c_i(y)}`. For the graph
`(𝟙, Φ_m)` of a Frobenius this holds with `n = 1` at every fixed rational point: in affine
coordinates `Φ_m^♯ (t_i - a_i) = (t_i - a_i)^{q^m}`.

This file states the locality of the local terms of contracting correspondences (blueprint
`lem-trf-local-term-locality`, `sk-i-curve-zero`):

1. at a contracting fixed point the local term of a graph correspondence `(𝟙, h)` is the trace
   of the stalk map
   (`Correspondence.localTerm_traceClass_ofGraph_eq_trace_of_isContractingAt`, in
   `WeilConjectures.TraceFormula.ContractingGraph`; the blueprint states this for every
   correspondence, with the stalk map of `u` defined through the base change map
   `Ly^* Rc₁^! ⟶ Ly^*`, which is only needed there for `c₁ = 𝟙`);
2. at a contracting fixed point with zero stalk, the local term vanishes
   (`ProEtale.CondensedRing.Correspondence.localTerm_traceClass_eq_zero_of_isContractingAt`);
3. for the graph of the model Frobenius and an arbitrary (not necessarily invertible) Frobenius
   coefficient morphism, the local term at a fixed rational point with zero stalk vanishes
   (`ProEtale.CondensedRing.Correspondence.localTerm_traceClass_frobeniusGraph_eq_zero`), in
   particular on smooth curves
   (`ProEtale.CondensedRing.Correspondence.localTerm_traceClass_frobeniusGraph_eq_zero_of_smooth`,
   blueprint `sk-i-curve-zero`).

Items 1 and 2 follow from Varshavsky's contracting-correspondence theorem (Thm. 2.1.3, blueprint
`sk-thm-tf-contracting-local-term`) for `Z = {x}`
(`Correspondence.restrict_traceClass_eq_pushforward_of_isContractingAt`): the trace class on `B`
is the pushforward of the trace class of the restricted coefficient map
`u_Z : K_x ⟶ K_x` (`Correspondence.contractingStalkMap`), which vanishes with `K_x`, and which
for a graph is the stalk map. The theorem itself is proved by specialization to the normal cone
in its own blueprint subsection.

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

attribute [local instance] boundedConstructibleBraiding

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]
  {X : Over (Spec (.of k))} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  {K : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧}

namespace Correspondence

variable (c : Correspondence ℓ K)

/-- An endocorrespondence `c = (c₁, c₂)` is *contracting at* the `k`-point `y` of its support
(blueprint `lem-trf-local-term-locality`; Varshavsky, Def. 2.1.1, with the legs interchanged):
`y` lies on the fixed locus, the fibre `c₁⁻¹(c₁ y)` is the reduced point `y`, and
`(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}` in `𝒪_{C,y}` for some `n ≥ 1`, where `c_i^♯ 𝔪` is the ideal
generated by the maximal ideal of `𝒪_{X, c_i(y)}`. -/
structure IsContractingAt (y : RationalPoint c.C) : Prop where
  /-- `y` lies on the fixed locus. -/
  comp_c₁_eq_comp_c₂ : y ≫ c.c₁ = y ≫ c.c₂
  /-- the fibre `c₁⁻¹(c₁ y)` is the reduced point `y`: the square `y ≫ c₁ = 𝟙 ≫ (y ≫ c₁)` is
  cartesian. -/
  isPullback : IsPullback y (𝟙 (point k)) c.c₁ (y ≫ c.c₁)
  /-- the contraction condition `(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}`. -/
  exists_le_pow : ∃ n : ℕ, 1 ≤ n ∧
    ((IsLocalRing.maximalIdeal
        (X.left.presheaf.stalk (c.c₂.left (y.left (default : Spec (.of k)))))).map
        (c.c₂.left.stalkMap (y.left (default : Spec (.of k)))).hom) ^ n ≤
      ((IsLocalRing.maximalIdeal
        (X.left.presheaf.stalk (c.c₁.left (y.left (default : Spec (.of k)))))).map
        (c.c₁.left.stalkMap (y.left (default : Spec (.of k)))).hom) ^ (n + 1)

variable {c}

/-- A `k`-point of the support lying on the fixed locus, as a point of the fixed locus. -/
noncomputable def FixedLocus.liftPoint (F : c.FixedLocus) (y : RationalPoint c.C)
    (hy : y ≫ c.c₁ = y ≫ c.c₂) : RationalPoint F.F :=
  F.isLimit.lift (Fork.ofι (P := point k) y hy)

@[reassoc (attr := simp)]
lemma FixedLocus.liftPoint_ι (F : c.FixedLocus) (y : RationalPoint c.C)
    (hy : y ≫ c.c₁ = y ≫ c.c₂) : F.liftPoint y hy ≫ F.ι = y :=
  Fork.IsLimit.lift_ι F.isLimit

variable (c)

variable {c} in
/-- The *restricted coefficient map* `u_Z : K_x ⟶ K_x` of a correspondence contracting at `y`,
`x = c₁(y) = c₂(y)` (blueprint `det-tf-contracting-restricted-morphism` for `Z = {x}`): the
restriction
```
K_x ≅ Ly^* Lc₂^* K --Ly^* u--> Ly^* Rc₁^! K --β--> R(𝟙)^! K_x ≅ K_x
```
of `u` to `y`, where `β` is the base change mate of the cartesian square `y ≫ c₁ = 𝟙 ≫ x`: the
`R(𝟙)_! ⊣ R(𝟙)^!` adjoint of `R(𝟙)_! Ly^* Rc₁^! K ≅ Lx^* Rc₁_! Rc₁^! K ⟶ Lx^* K`. -/
noncomputable def contractingStalkMap {y : RationalPoint c.C} (hc : c.IsContractingAt y) :
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).obj K ⟶
      (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).obj K :=
  haveI := isIso_boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ hc.isPullback
  eqToHom (by rw [hc.comp_c₁_eq_comp_c₂]) ≫
    (boundedConstructibleUpperStarComp (Profinite.padicAlgClRingObj ℓ) ℓ y c.c₂).hom.app K ≫
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ y).map c.u ≫
    (boundedConstructibleUpperShriekAdjunction (Profinite.padicAlgClRingObj ℓ) ℓ
      (𝟙 (point k))).homEquiv _ _
      ((asIso (boundedConstructibleLowerShriekBaseChange_padicAlgCl ℓ hc.isPullback)).inv.app
          ((boundedConstructibleUpperShriek (Profinite.padicAlgClRingObj ℓ) ℓ c.c₁).obj K) ≫
        (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (y ≫ c.c₁)).map
          ((boundedConstructibleUpperShriekAdjunction (Profinite.padicAlgClRingObj ℓ) ℓ
            c.c₁).counit.app K)) ≫
    (boundedConstructibleUpperShriekId ℓ (point k)).hom.app _

/-- **Contracting correspondences and local terms** (blueprint
`sk-thm-tf-contracting-local-term`, for the closed subscheme `Z = {x}` of the rational point
`x = c₁(y)`; Varshavsky, *Lefschetz–Verdier trace formula and a generalization of a theorem of
Fujiwara*, Thm. 2.1.3): let `c` be contracting at `y`, so that `C_Z = c₁⁻¹(x)` is the reduced
point `y`, the correspondence `c_Z` induced on `Z` is the identity correspondence of the point and
the restricted coefficient map is `u_Z = contractingStalkMap hc`. For an open and closed subscheme
`B` of the fixed locus, proper over `s`, with underlying set `{y}` and point `e : s ⟶ B`, the
restriction of the trace class of `c` to `B` is the pushforward along `e` of the trace class of
`u_Z`: `Tr_c(u)|_B = e_* Tr_{c_Z}(u_Z)`. The proof is Varshavsky's specialization to the normal
cone (blueprint `det-tf-contracting-vanishing`, `det-tf-contracting-closed-piece`). -/
theorem restrict_traceClass_eq_pushforward_of_isContractingAt (F : c.FixedLocus)
    {y : RationalPoint c.C} (hc : c.IsContractingAt y) {B : Over (Spec (.of k))}
    [QuasiCompact B.hom] [IsProper B.hom] (j : B ⟶ F.F) [IsOpenImmersion j.left]
    [IsClosedImmersion j.left] (e : point k ⟶ B) [IsProper e.left]
    (he : e ≫ j = F.liftPoint y hc.comp_c₁_eq_comp_c₂)
    (hB : Set.range j.left.base =
      {(F.liftPoint y hc.comp_c₁_eq_comp_c₂).left.base (default : Spec (.of k))}) :
    (c.traceClass F).restrict j = BorelMooreSection.pushforward e
      ((ofEnd _ (contractingStalkMap hc)).traceClass (fixedLocusOfEnd _)) :=
  sorry

/-- The trace class of a correspondence whose pulled back coefficient `Lc₂^* K` vanishes is
zero: the mate of `u` is a map out of the zero object. -/
lemma traceClass_eq_zero_of_isZero (F : c.FixedLocus)
    (hK : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ c.c₂).obj K)) :
    c.traceClass F = 0 := by
  have hm : c.mate = 0 := by
    rw [mate, ← MonoidalClosed.curry'_uncurry' (0 : 𝟙_ _ ⟶ _)]
    exact congrArg _ (hK.eq_of_src _ _)
  rw [traceClass, hm, zero_comp, Adjunction.homEquiv_counit, Functor.map_zero, zero_comp,
    comp_zero]

/-- **Zero-stalk vanishing of local terms** (blueprint `lem-trf-local-term-locality`, item 2;
Varshavsky, Thm. 2.1.3): if `c` is contracting at the fixed point `y`, `B` is an open and closed
subscheme of the fixed locus, proper over `s`, whose underlying set is `{y}`, and the stalk
`K_{c₁ y}` vanishes, then the local term of the trace class of `c` along `B` is zero, whatever
the coefficient map `u`. By `restrict_traceClass_eq_pushforward_of_isContractingAt` the trace
class on `B` is the pushforward of the trace class of the restricted map `u_Z`, an endomorphism of
the zero stalk. -/
theorem localTerm_traceClass_eq_zero_of_isContractingAt (F : c.FixedLocus)
    (y : RationalPoint c.C) (hc : c.IsContractingAt y) {B : Over (Spec (.of k))}
    [QuasiCompact B.hom] [IsProper B.hom] (j : B ⟶ F.F) [IsOpenImmersion j.left]
    [IsClosedImmersion j.left]
    (hB : Set.range j.left.base =
      {(F.liftPoint y hc.comp_c₁_eq_comp_c₂).left.base (default : Spec (.of k))})
    (hK : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (y ≫ c.c₁)).obj K)) :
    (c.traceClass F).localTerm j = 0 := by
  have hrange : Set.range (F.liftPoint y hc.comp_c₁_eq_comp_c₂).left.base ⊆
      Set.range j.left.base := by
    rw [hB]
    rintro _ ⟨z, rfl⟩
    rw [Subsingleton.elim (α := Spec (.of k)) z default]
    rfl
  let e : point k ⟶ B := Over.homMk (IsOpenImmersion.lift j.left _ hrange) (by
    rw [← Over.w j, ← Category.assoc, IsOpenImmersion.lift_fac]
    exact Over.w (F.liftPoint y hc.comp_c₁_eq_comp_c₂))
  have he : e ≫ j = F.liftPoint y hc.comp_c₁_eq_comp_c₂ :=
    Over.OverMorphism.ext (IsOpenImmersion.lift_fac _ _ _)
  have : IsProper (e.left ≫ B.hom) := by
    rw [Over.w e]
    exact inferInstanceAs (IsProper (𝟙 (Spec (.of k))))
  have : IsProper e.left := IsProper.of_comp e.left B.hom
  have h0 : (ofEnd _ (contractingStalkMap hc)).traceClass (fixedLocusOfEnd _) = 0 :=
    traceClass_eq_zero_of_isZero _ _ (hK.of_iso
      ((boundedConstructibleUpperStarId (Profinite.padicAlgClRingObj ℓ) ℓ (point k)).app _))
  have hp := BorelMooreSection.pushforward_add e (0 : BorelMooreSection ℓ (point k)) 0
  rw [add_zero] at hp
  rw [BorelMooreSection.localTerm,
    restrict_traceClass_eq_pushforward_of_isContractingAt c F hc j e he hB, h0]
  rw [show BorelMooreSection.pushforward e (0 : BorelMooreSection ℓ (point k)) = 0 by
    simpa using hp]
  exact BorelMooreSection.integral_zero

variable {c}

/-- Being contracting at a point only depends on the support of the correspondence. -/
lemma IsContractingAt.withCoeff {y : RationalPoint c.C} (hc : c.IsContractingAt y)
    (K' : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (u' : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ c.c₂).obj K' ⟶
      (boundedConstructibleUpperShriek (Profinite.padicAlgClRingObj ℓ) ℓ c.c₁).obj K') :
    (c.withCoeff K' u').IsContractingAt y :=
  ⟨hc.1, hc.2, hc.3⟩

lemma FixedLocus.liftPoint_withCoeff (F : c.FixedLocus)
    (K' : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (u' : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ c.c₂).obj K' ⟶
      (boundedConstructibleUpperShriek (Profinite.padicAlgClRingObj ℓ) ℓ c.c₁).obj K')
    (y : RationalPoint c.C) (hy : y ≫ c.c₁ = y ≫ c.c₂) :
    (F.withCoeff K' u').liftPoint y hy = F.liftPoint y hy :=
  rfl

lemma comp_eq_of_isContractingAt_ofGraph {h : X ⟶ X}
    {v : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ h).obj K ⟶ K}
    {x : RationalPoint X} (hc : (ofGraph K h v).IsContractingAt x) : x ≫ h = x := by
  have := hc.comp_c₁_eq_comp_c₂
  simp only [ofGraph, Category.comp_id] at this
  exact this.symm

omit [Fact (ringChar k).Prime] [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
  [IsSeparated X.hom] in
/-- The underlying morphism of the iterate `Φ_m` of the model Frobenius lifts the `m`-th iterate
of the Frobenius `F₀` of the model: `Φ_m ≫ p = p ≫ F₀^m`. -/
lemma frobeniusIterate_left_comp_eq {X₀ : Scheme.{u}} {p : X.left ⟶ X₀}
    {Φ : X ⟶ X} {F₀ : X₀ ⟶ X₀} (hp : Φ.left ≫ p = p ≫ F₀) (m : ℕ) :
    (frobeniusIterate Φ m).left ≫ p = p ≫ End.asHom (End.of F₀ ^ m) := by
  rw [frobeniusIterate_left]
  exact End.asHom_pow_comp_eq_comp_asHom_pow hp m

/-- The stalk map of the identity maps the maximal ideal onto itself. -/
lemma _root_.AlgebraicGeometry.Scheme.map_maximalIdeal_stalkMap_id (S : Scheme.{u}) (y : S) :
    (IsLocalRing.maximalIdeal (S.presheaf.stalk ((𝟙 S : S ⟶ S).base y))).map
      ((𝟙 S : S ⟶ S).stalkMap y).hom = IsLocalRing.maximalIdeal (S.presheaf.stalk y) := by
  rw [Scheme.Hom.stalkMap_id]
  exact Ideal.map_id _

/-- **The Frobenius graph is contracting at its fixed rational points** (blueprint
`lem-trf-local-term-locality`, proof of item 3): for the model Frobenius `Φ` of a model over a
finite field, `m ≥ 1` and any coefficient map `v`, the graph correspondence `(𝟙, Φ_m)` is
contracting at a rational point `x` fixed by `Φ_m`: the fibre of `𝟙` is the reduced point, and
`Φ_m^♯ 𝔪 ⊆ 𝔪²` since `Φ_m^♯ (t_i - a_i) = (t_i - a_i)^{q^m}` in affine coordinates
(`AlgebraicGeometry.map_maximalIdeal_stalkMap_le_sq_of_isFrobenius`). -/
theorem isContractingAt_ofGraph_frobeniusIterate {k₀ : Type u} [Field k₀] [Finite k₀]
    [Algebra k₀ k] {X₀ : Scheme.{u}} {f₀ : X₀ ⟶ Spec (.of k₀)} {p : X.left ⟶ X₀} {Φ : X ⟶ X}
    (hΦ : IsModelFrobenius Φ f₀ p) {m : ℕ} (hm : 1 ≤ m)
    (v : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (frobeniusIterate Φ m)).obj K ⟶ K) (x : RationalPoint X)
    (hx : x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₁ =
      x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₂) :
    (ofGraph K (frobeniusIterate Φ m) v).IsContractingAt x := by
  obtain ⟨F₀, hF₀, hp⟩ := hΦ.exists_isFrobenius
  have hxa : x.left ≫ X.hom = 𝟙 _ := Over.w x
  have hfix : x.left ≫ (frobeniusIterate Φ m).left = x.left := by
    have := congrArg CommaMorphism.left hx
    simpa [ofGraph] using this.symm
  refine ⟨hx, ?_, 1, le_rfl, ?_⟩
  · have : IsIso (ofGraph K (frobeniusIterate Φ m) v).c₁ := inferInstanceAs (IsIso (𝟙 X))
    exact IsPullback.of_vert_isIso ⟨by rw [Category.id_comp]⟩
  refine (pow_one _).le.trans (le_of_le_of_eq
    (map_maximalIdeal_stalkMap_le_sq_of_isFrobenius hΦ.isPullback hm (hF₀.pow f₀ m)
      (Over.w (frobeniusIterate Φ m)) (frobeniusIterate_left_comp_eq hp m) x.left hxa hfix _) ?_)
  exact congrArg (· ^ 2) (Scheme.map_maximalIdeal_stalkMap_id X.left _).symm

/-- **Zero-stalk vanishing for the Frobenius graph** (blueprint `lem-trf-local-term-locality`,
item 3): let `Φ` be the model Frobenius of a model `X₀` of finite type over a finite field
`k₀`, `m ≥ 1`, let `v : LΦ_m^* K ⟶ K` be an arbitrary, not necessarily invertible, map (for
instance the iterate `ψ_m` of a Frobenius coefficient morphism `ψ`, or `φ_m` for a Weil object)
and `x` a rational point fixed by `Φ_m`. If the stalk `K_x` vanishes, the local term of the
graph correspondence `(𝟙, Φ_m)` with coefficient map `v` along an open and
closed subscheme `B` of the fixed locus, proper over `s`, with underlying set `{x}`, is zero.
The graph is contracting at `x` since `Φ_m^♯ (t_i - a_i) = (t_i - a_i)^{q^m}` in affine
coordinates, and the claim is item 2. -/
theorem localTerm_traceClass_frobeniusGraph_eq_zero {k₀ : Type u} [Field k₀] [Finite k₀]
    [Algebra k₀ k] {X₀ : Scheme.{u}} {f₀ : X₀ ⟶ Spec (.of k₀)} [LocallyOfFiniteType f₀]
    {p : X.left ⟶ X₀} {Φ : X ⟶ X} (hΦ : IsModelFrobenius Φ f₀ p)
    {m : ℕ} (hm : 1 ≤ m)
    (v : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (frobeniusIterate Φ m)).obj K ⟶ K)
    (F : (ofGraph K (frobeniusIterate Φ m) v).FixedLocus) (x : RationalPoint X)
    (hx : x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₁ = x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₂)
    {B : Over (Spec (.of k))} [QuasiCompact B.hom] [IsProper B.hom] (j : B ⟶ F.F)
    [IsOpenImmersion j.left] [IsClosedImmersion j.left]
    (hB : Set.range j.left.base = {(F.liftPoint x hx).left.base (default : Spec (.of k))})
    (hK : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ x).obj K)) :
    ((ofGraph K (frobeniusIterate Φ m) v).traceClass F).localTerm j = 0 := by
  have hc := isContractingAt_ofGraph_frobeniusIterate hΦ hm v x hx
  refine localTerm_traceClass_eq_zero_of_isContractingAt _ F x hc j hB ?_
  have h₁ : x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₁ = x := Category.comp_id x
  rw [h₁]
  exact hK

/-- **Zero-stalk vanishing on a smooth curve** (blueprint `sk-i-curve-zero`): for `X` smooth of
relative dimension one over `s` with the model Frobenius `Φ` of a model over a finite field, an
`m ≥ 1`, an arbitrary map `v : LΦ_m^* K ⟶ K` and a rational point `x` fixed by `Φ_m`
with `K_x = 0`, the local term of the graph correspondence `(𝟙, Φ_m)` with coefficient `v`
along an open and closed subscheme of the fixed locus, proper over `s`, with underlying set `{x}`
is zero. This is the smooth-curve case of
`ProEtale.CondensedRing.Correspondence.localTerm_traceClass_frobeniusGraph_eq_zero`. -/
theorem localTerm_traceClass_frobeniusGraph_eq_zero_of_smooth
    [SmoothOfRelativeDimension 1 X.hom] {k₀ : Type u} [Field k₀] [Finite k₀]
    [Algebra k₀ k] {X₀ : Scheme.{u}} {f₀ : X₀ ⟶ Spec (.of k₀)} [LocallyOfFiniteType f₀]
    {p : X.left ⟶ X₀} {Φ : X ⟶ X} (hΦ : IsModelFrobenius Φ f₀ p)
    {m : ℕ} (hm : 1 ≤ m)
    (v : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (frobeniusIterate Φ m)).obj K ⟶ K)
    (F : (ofGraph K (frobeniusIterate Φ m) v).FixedLocus) (x : RationalPoint X)
    (hx : x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₁ = x ≫ (ofGraph K (frobeniusIterate Φ m) v).c₂)
    {B : Over (Spec (.of k))} [QuasiCompact B.hom] [IsProper B.hom] (j : B ⟶ F.F)
    [IsOpenImmersion j.left] [IsClosedImmersion j.left]
    (hB : Set.range j.left.base = {(F.liftPoint x hx).left.base (default : Spec (.of k))})
    (hK : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ x).obj K)) :
    ((ofGraph K (frobeniusIterate Φ m) v).traceClass F).localTerm j = 0 :=
  localTerm_traceClass_frobeniusGraph_eq_zero hΦ hm v F x hx j hB hK

end Correspondence

end AlgebraicGeometry.ProEtale.CondensedRing
