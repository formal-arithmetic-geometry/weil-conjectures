module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.Separated
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Invertible

import WeilConjectures.AlgebraicGeometry.RelativeEffectiveCartier

/-!
# Cartier sections of smooth relative curves

Source: Stacks Project, Divisors, Tag 067R (blueprint: lem-trf-smooth-curve-section-cartier).

The section of a separated smooth relative curve is a closed immersion, and its defining
quasi-coherent ideal is locally generated by one non-zero-divisor.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- A section of a separated smooth relative curve is a closed immersion whose defining ideal
is invertible, hence locally generated by one non-zero-divisor.

Source: Stacks Project, Divisors, Tag 067R (blueprint: lem-trf-smooth-curve-section-cartier).

Proof: Apply the separated-section closed-immersion lemma to `f` and `σ`. Regard the section's
source as the resulting closed subscheme of `X`; its structure map to `S` is the identity and is
finite, flat, and locally of finite presentation. Apply the finite-locally-free Cartier
criterion for a smooth relative curve to obtain invertibility of the defining ideal. The
invertibility predicate is the affine-local one-generator non-zero-divisor condition.
-/
theorem smoothCurveSection_cartier
    {X S : Scheme.{u}} (f : X ⟶ S) [IsSeparated f]
    [SmoothOfRelativeDimension 1 f] (σ : S ⟶ X) (hσ : σ ≫ f = 𝟙 S) :
    IsClosedImmersion σ ∧ σ.ker.IsInvertible := by
  have : IsClosedImmersion (σ ≫ f) := by rw [hσ]; infer_instance
  have : IsClosedImmersion σ := IsClosedImmersion.of_comp σ f
  refine ⟨inferInstance, ?_⟩
  have : IsIso (σ.toImage ≫ (σ.imageι ≫ f)) := by
    rw [← Category.assoc, Scheme.Hom.toImage_imageι, hσ]
    infer_instance
  have : IsIso (σ.imageι ≫ f) := IsIso.of_isIso_comp_left σ.toImage _
  exact Scheme.IdealSheafData.isInvertible_of_isFinite_of_flat f
    inferInstance inferInstance inferInstance

end AlgebraicGeometry
