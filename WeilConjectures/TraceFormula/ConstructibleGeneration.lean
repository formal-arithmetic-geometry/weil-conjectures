module

public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.Derived.BoundedConstructibleTriangulated
public import WeilConjectures.AlgebraicGeometry.AffineSpaceEmbedding
public import WeilConjectures.TraceFormula.OpenClosedTriangle
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.Derived.LocallyFreeDualizable
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.Derived.PointImageVanishing
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.LocallyFreeOfFinitelyPresented

/-!

# Generation of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` by extensions by zero of dualizable objects

Let `Y` be a separated `k`-scheme of finite type. The *lisse generators* of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧`
(`ProEtale.CondensedRing.lisseGenerator`) are the objects isomorphic to `Rg_! Rj_! L`, where
`g : Z ⟶ Y` is a closed immersion, `j : U ⟶ Z` an open immersion with `U` affine, and `L` a
dualizable object of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧` (for instance a lisse sheaf placed in some degree).

## Main statements

- `ProEtale.CondensedRing.triangEnvelope_lisseGenerator`: every object of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` lies in
  the triangulated subcategory generated by the lisse generators. This is the constructible
  dévissage at the coefficient stage `ℚ̄_ℓ` (blueprint `lem-trf-devissage-generation`, section
  `sec-six-functors-basics`, states it for finite coefficients). The proof is a noetherian
  induction on the support (`ProEtale.CondensedRing.triangEnvelope_lisseGenerator_lowerStar`),
  in which the closed subscheme may be replaced by its reduction (topological invariance):
  a complex on a reduced scheme is generated by dualizable objects on a nonempty affine open
  subscheme (`ProEtale.CondensedRing.exists_isOpenImmersion_triangEnvelope_isDualizable`, by the
  truncation triangles), and the open–closed triangle splits off this open subscheme.
- `ProEtale.CondensedRing.exists_isDualizable_upperStar_singleFunctor`: **generic lisseness**.
  Every nonempty open subscheme of a reduced `Z` contains a nonempty open subscheme on which a
  given constructible `ℚ̄_ℓ`-sheaf is dualizable: it meets the interior of a stratum, on which the
  sheaf is locally finitely presented, hence locally free, hence dualizable
  (`ProEtale.CondensedRing.isDualizable_singleFunctor_of_isLocallyFree`).

## Inputs

That a locally finitely presented `ℚ̲̄_ℓ`-module is locally free
(`ProEtale.CondensedRing.isLocallyFree_of_isLocallyFinitelyPresented`) rests on the description
of the sections of `ℚ̲̄_ℓ` over quasi-compact quasi-separated schemes
(`ProEtale.CondensedRing.exists_endRegularRingEquiv`), itself proved from Bhatt–Scholze,
Lemma 4.2.12
(`ProEtale.isIso_continuousMapComparison`).

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (ℓ : ℕ) [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]

variable (Y : Over (Spec (.of k))) [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
  [IsSeparated Y.hom]

/-- The *lisse generators* of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧`: the objects isomorphic to `Rg_! Rj_! L` for a
closed immersion `g : Z ⟶ Y`, an open immersion `j : U ⟶ Z` with `U` affine, and a dualizable
`L ∈ Dᵇc(U)⟦ℚ̲̄_ℓ⟧`. -/
def lisseGenerator : ObjectProperty (Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧) := fun N ↦
  ∃ (Z : Over (Spec (.of k))) (_ : LocallyOfFiniteType Z.hom) (_ : QuasiCompact Z.hom)
    (_ : IsSeparated Z.hom) (g : Z ⟶ Y) (_ : IsClosedImmersion g.left)
    (U : Over (Spec (.of k))) (_ : LocallyOfFiniteType U.hom) (_ : QuasiCompact U.hom)
    (_ : IsSeparated U.hom) (_ : IsAffine U.left) (j : U ⟶ Z) (_ : IsOpenImmersion j.left)
    (L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧) (_ : IsDualizable L),
    Nonempty (N ≅ (boundedConstructibleLowerShriek ℓ g).obj
      ((boundedConstructibleLowerShriek ℓ j).obj L))

/-- The lisse generators form a nonempty family: `Rj_! 𝟙` for the empty open subscheme `j` of `Y`
is one. -/
instance nonempty_lisseGenerator : (lisseGenerator ℓ Y).Nonempty :=
  have : IsClosedImmersion (𝟙 Y : Y ⟶ Y).left := inferInstanceAs (IsClosedImmersion (𝟙 Y.left))
  have : IsAffine (overRestrict Y ⊥).left := isAffineOpen_bot Y.left
  ⟨⟨_, Y, inferInstance, inferInstance, inferInstance, 𝟙 Y, inferInstance, overRestrict Y ⊥,
    inferInstance, inferInstance, inferInstance, inferInstance, overRestrictι Y ⊥, inferInstance,
    𝟙_ _, isDualizable_unit, ⟨Iso.refl _⟩⟩⟩

variable {Y}

/-- On an empty scheme, every complex of module objects over `ℚ̲̄_ℓ` is zero: all sections of a
sheaf over the (empty) objects of the pro-étale site are zero. -/
lemma isZero_derivedCategory_of_isEmpty {Z : Scheme.{u}} [IsEmpty Z]
    (K : DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology Z) Ab.{u + 1})
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z))) : IsZero K := by
  have hA (M : Mod (Sheaf (Scheme.ProEt.topology Z) Ab.{u + 1})
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z)) : IsZero M :=
    isZero_of_isZero_X _ (IsZero.of_full_of_faithful_of_isZero (sheafToPresheaf _ _) _
      (Functor.isZero _ fun T ↦
        have : IsEmpty T.unop.left := ⟨fun t ↦ IsEmpty.false (α := Z) (T.unop.hom.base t)⟩
        (ProEt.isTerminalSectionsOfIsEmpty M.X T.unop).isZero))
  refine IsZero.of_iso (Functor.map_isZero DerivedCategory.Q ?_)
    (DerivedCategory.Q.objObjPreimageIso K).symm
  rw [IsZero.iff_id_eq_zero]
  exact HomologicalComplex.hom_ext _ _ fun n ↦ (hA _).eq_of_src _ _

omit [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ℓ)] in
/-- On an empty scheme, every bounded constructible complex is zero. -/
lemma isZero_boundedConstructible_of_isEmpty {Z : Over (Spec (.of k))} [IsEmpty Z.left]
    (N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧) : IsZero N :=
  IsZero.of_full_of_faithful_of_isZero (boundedConstructible _).ι N
    (isZero_derivedCategory_of_isEmpty ℓ N.obj)

/-- For a closed immersion `g : Z ⟶ Y`, an open immersion `j : U ⟶ Z` with `U` affine and `L` in
the triangulated subcategory of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧` generated by the dualizable objects,
`Rg_* Rj_! L` lies in the triangulated subcategory generated by the lisse generators: the
composite `Rg_* ∘ Rj_!` is triangulated and sends a dualizable `L` to `Rg_* Rj_! L ≅ Rg_! Rj_! L`.
-/
lemma triangEnvelope_lisseGenerator_lowerStar_lowerShriek {Z U : Over (Spec (.of k))}
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom]
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom] [IsSeparated U.hom] [IsAffine U.left]
    (g : Z ⟶ Y) [IsClosedImmersion g.left] (j : U ⟶ Z) [IsOpenImmersion j.left]
    {L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧}
    (hL : ObjectProperty.triangEnvelope (C := Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
      IsDualizable L) :
    (lisseGenerator ℓ Y).triangEnvelope
      ((boundedConstructibleLowerStar ℓ g).obj
        ((boundedConstructibleLowerShriek ℓ j).obj L)) := by
  let F := boundedConstructibleLowerShriek ℓ j ⋙
    boundedConstructibleLowerStar ℓ g
  have : ((lisseGenerator ℓ Y).triangEnvelope.inverseImage F).IsStableUnderRetracts :=
    ⟨fun r h ↦ ObjectProperty.IsStableUnderRetracts.of_retract
      (P := (lisseGenerator ℓ Y).triangEnvelope) (r.map F) h⟩
  refine (ObjectProperty.triangEnvelope_le_iff _
    (Q := (lisseGenerator ℓ Y).triangEnvelope.inverseImage F)).2 (fun L hL ↦ ?_) L hL
  exact ObjectProperty.le_triangEnvelope _ _ ⟨Z, inferInstance, inferInstance, inferInstance, g,
    inferInstance, U, inferInstance, inferInstance, inferInstance, inferInstance, j, inferInstance,
    L, hL, ⟨(boundedConstructibleLowerShriekIsoLowerStar_padicAlgCl ℓ g).symm.app _⟩⟩

/-- The pullback of a dualizable object is dualizable, the pullback being strong monoidal. -/
lemma isDualizable_boundedConstructibleUpperStar_obj {X X' : Over (Spec (.of k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    [LocallyOfFiniteType X'.hom] [QuasiCompact X'.hom] [IsSeparated X'.hom] (f : X' ⟶ X)
    {L : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hL : IsDualizable L) :
    IsDualizable ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ f).obj L) := by
  obtain ⟨_⟩ := hL
  exact ⟨@HasRightDual.mk _ _ _ _ _
    (ExactPairing.map (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ f) L Lᘁ)⟩

/-- The restriction of a dualizable object to a smaller open subscheme is dualizable. -/
lemma isDualizable_upperStar_overRestrictι_of_le {Z : Over (Spec (.of k))}
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom] {W W' : Z.left.Opens}
    (hle : W' ≤ W) {L : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧}
    (hL : IsDualizable ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (overRestrictι Z W)).obj L)) :
    IsDualizable ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (overRestrictι Z W')).obj L) := by
  let e : overRestrict Z W' ⟶ overRestrict Z W :=
    Over.homMk (Z.left.homOfLE hle) (by simp [Scheme.homOfLE_ι_assoc])
  have hj : e ≫ overRestrictι Z W = overRestrictι Z W' :=
    Over.OverMorphism.ext (by simp [e, Scheme.homOfLE_ι])
  have := IsDualizable.of_iso
    ((boundedConstructibleUpperStarComp (Profinite.padicAlgClRingObj ℓ) ℓ e _).app _).symm
    (isDualizable_boundedConstructibleUpperStar_obj ℓ e hL)
  rwa [hj] at this

omit [Fact ℓ.Prime] [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ℓ)] in
/-- A morphism from a reduced scheme whose image lies in the image of an immersion factors
through it: it factors through the open subscheme in which the immersion is closed, and then
through the closed immersion, the base change of which to the reduced source is a surjective
closed immersion, hence an isomorphism. -/
lemma exists_comp_eq_of_isImmersion_of_isReduced {T X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsImmersion i] (g : T ⟶ X) [IsReduced T] (h : Set.range g ⊆ Set.range i) :
    ∃ l : T ⟶ Z, l ≫ i = g := by
  have hi : Set.range i ⊆ Set.range i.coborderRange.ι := by
    rw [Scheme.Opens.range_ι]; exact subset_coborder
  let g' : T ⟶ i.coborderRange := IsOpenImmersion.lift i.coborderRange.ι g (h.trans hi)
  have hg' : g' ≫ i.coborderRange.ι = g := IsOpenImmersion.lift_fac _ _ _
  have : Surjective (pullback.snd i.liftCoborder g') := ⟨by
    rw [← Set.range_eq_univ, Scheme.Pullback.range_snd, Set.preimage_eq_univ_iff]
    rintro _ ⟨t, rfl⟩
    obtain ⟨z, hz⟩ := h ⟨t, rfl⟩
    refine ⟨z, i.coborderRange.ι.isEmbedding.injective ?_⟩
    rw [← Scheme.Hom.comp_apply, Scheme.Hom.liftCoborder_ι, hz, ← Scheme.Hom.comp_apply, hg']⟩
  have := isIso_of_isClosedImmersion_of_surjective (pullback.snd i.liftCoborder g')
  refine ⟨inv (pullback.snd i.liftCoborder g') ≫ pullback.fst i.liftCoborder g', ?_⟩
  have hl : (inv (pullback.snd i.liftCoborder g') ≫ pullback.fst i.liftCoborder g') ≫
      i.liftCoborder = g' := by
    rw [Category.assoc, pullback.condition, IsIso.inv_hom_id_assoc]
  calc _ = ((inv (pullback.snd i.liftCoborder g') ≫ pullback.fst i.liftCoborder g') ≫
        i.liftCoborder) ≫ i.coborderRange.ι := by
          simp only [Category.assoc, Scheme.Hom.liftCoborder_ι]
    _ = g := by rw [hl, hg']

/-- The derived pullback of a module object placed in degree `0` is the pullback of the module
object, placed in degree `0`: the pullback of module objects is exact. -/
noncomputable def boundedConstructibleUpperStarSingleFunctorIso {Z W : Over (Spec (.of k))}
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom]
    [LocallyOfFiniteType W.hom] [QuasiCompact W.hom] [IsSeparated W.hom] (g : W ⟶ Z)
    (M : Mod (Sheaf (Scheme.ProEt.topology Z.left) Ab.{u + 1})
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z.left))
    (hM : IsConstructibleModuleObject
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z.left) M) :
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ g).obj
        ⟨(DerivedCategory.singleFunctor _ 0).obj M,
          boundedConstructible_singleFunctor_obj _ Z.left 0 M hM⟩ ≅
      ⟨(DerivedCategory.singleFunctor _ 0).obj
          ((g.left)^*⟦Profinite.padicAlgClRingObj ℓ⟧.obj M),
        boundedConstructible_singleFunctor_obj _ W.left 0 _
          (IsConstructibleModuleObject.upperStar _ g.left hM)⟩ :=
  (boundedConstructible _).fullyFaithfulι.preimageIso
    ((boundedConstructibleUpperStarCompatibility _ ℓ g).app _ ≪≫
      (leftDerivedUpperStarIsoMapDerivedCategory _ g.left).app _ ≪≫
      ((g.left)^*⟦Profinite.padicAlgClRingObj ℓ⟧.mapDerivedCategorySingleFunctor 0).app M)

/-- **Generic lisseness** (the local input of the constructible dévissage): let `M` be a
constructible `ℚ̄_ℓ`-sheaf on a reduced separated `k`-scheme of finite type `Z`, placed in degree
`0`. Every nonempty open subscheme `V` of `Z` contains a nonempty open subscheme `W` on which `M`
becomes dualizable. Indeed `V` meets the interior of a stratum of a stratification witnessing the
constructibility of `M` (the union of these interiors is dense); on the intersection `W`, `M` is
pro-étale locally finitely presented, as `Z` is reduced, hence locally free
(`isLocallyFree_of_isLocallyFinitelyPresented`), hence dualizable
(`isDualizable_singleFunctor_of_isLocallyFree`). -/
theorem exists_isDualizable_upperStar_singleFunctor (Z : Over (Spec (.of k)))
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom] [IsReduced Z.left]
    (M : Mod (Sheaf (Scheme.ProEt.topology Z.left) Ab.{u + 1})
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z.left))
    (hM : IsConstructibleModuleObject
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z.left) M)
    (V : Z.left.Opens) (hV : (V : Set Z.left).Nonempty) :
    ∃ W : Z.left.Opens, W ≤ V ∧ (W : Set Z.left).Nonempty ∧
      IsDualizable ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
        (overRestrictι Z W)).obj ⟨(DerivedCategory.singleFunctor _ 0).obj M,
          boundedConstructible_singleFunctor_obj _ Z.left 0 M hM⟩) := by
  obtain ⟨S, hS⟩ := id hM
  obtain ⟨x, hxV, hxS⟩ := S.dense_iUnion_interior_stratum.inter_open_nonempty V V.isOpen hV
  obtain ⟨a, hxa⟩ := Set.mem_iUnion.1 hxS
  let W : Z.left.Opens := V ⊓ ⟨interior (S.stratum a), isOpen_interior⟩
  have : IsReduced (overRestrict Z W).left := inferInstanceAs (IsReduced W.toScheme)
  obtain ⟨l, hl⟩ := exists_comp_eq_of_isImmersion_of_isReduced (S.immersion a)
    (overRestrictι Z W).left (by
      change Set.range W.ι ⊆ _
      rw [Scheme.Opens.range_ι, S.range_immersion]
      exact fun y hy ↦ interior_subset hy.2)
  have hWM : IsLocallyFinitelyPresented
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) (overRestrict Z W).left)
      (((overRestrictι Z W).left)^*⟦Profinite.padicAlgClRingObj ℓ⟧.obj M) :=
    (IsLocallyFinitelyPresented.upperStar _ l
      ((isLocallyFinitelyPresented_mapMod_iff _ _ _).1 (hS a))).of_iso
      (((upperStarComp _ l (S.immersion a)).app M).symm ≪≫ (upperStarCongr _ hl).app M)
  refine ⟨W, inf_le_left, ⟨x, hxV, hxa⟩, IsDualizable.of_iso
    (boundedConstructibleUpperStarSingleFunctorIso ℓ (overRestrictι Z W) M hM).symm ?_⟩
  exact isDualizable_singleFunctor_of_isLocallyFree ℓ (overRestrict Z W)
    (((overRestrictι Z W).left)^*⟦Profinite.padicAlgClRingObj ℓ⟧.obj M)
    (isLocallyFree_of_isLocallyFinitelyPresented ℓ (overRestrict Z W) hWM)

/-- **Generic dualizability**: a bounded constructible `ℚ̄_ℓ`-complex `N` on a nonempty reduced
separated `k`-scheme of finite type `Z` lies, on some nonempty affine open subscheme `U` of `Z`, in
the triangulated subcategory of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧` generated by the dualizable objects. By the
truncation triangles `N` is an iterated extension of its shifted cohomology sheaves
(`DerivedCategory.exists_iteratedExtensions_of_bounded`); shrinking a nonempty open subscheme
once for each of the finitely many nonzero ones, they all become dualizable on a nonempty open
subscheme (`exists_isDualizable_upperStar_singleFunctor`), and `U` is an affine open subscheme of
it. -/
theorem exists_isOpenImmersion_triangEnvelope_isDualizable (Z : Over (Spec (.of k)))
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom] [IsReduced Z.left]
    [Nonempty Z.left]
    (N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    ∃ (U : Over (Spec (.of k))) (_ : LocallyOfFiniteType U.hom) (_ : QuasiCompact U.hom)
      (_ : IsSeparated U.hom) (_ : IsAffine U.left) (_ : Nonempty U.left) (j : U ⟶ Z)
      (_ : IsOpenImmersion j.left),
      ObjectProperty.triangEnvelope (C := Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
        IsDualizable
        ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).obj N) := by
  classical
  obtain ⟨⟨a, b, hab⟩, hH⟩ := (mem_boundedConstructible_iff _ N.obj).1 N.property
  -- a nonempty open subscheme on which the cohomology sheaves in degrees `[a, b]` are dualizable
  have hfin : ∀ s : Finset ℤ, ∃ W : Z.left.Opens, (W : Set Z.left).Nonempty ∧ ∀ n ∈ s,
      IsDualizable ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
        (overRestrictι Z W)).obj ⟨(DerivedCategory.singleFunctor _ 0).obj
          ((DerivedCategory.homologyFunctor _ n).obj N.obj),
          boundedConstructible_singleFunctor_obj _ Z.left 0 _ (hH n)⟩) := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨⊤, ⟨Classical.arbitrary Z.left, trivial⟩, by simp⟩
    | insert n s _ ih =>
      obtain ⟨W, hW, hWs⟩ := ih
      obtain ⟨W', hW'W, hW', hW'n⟩ :=
        exists_isDualizable_upperStar_singleFunctor ℓ Z _ (hH n) W hW
      refine ⟨W', hW', fun m hm ↦ ?_⟩
      rcases Finset.mem_insert.1 hm with rfl | hm
      · exact hW'n
      · exact isDualizable_upperStar_overRestrictι_of_le ℓ hW'W (hWs m hm)
  obtain ⟨W, ⟨x, hx⟩, hW⟩ := hfin (Finset.Icc a b)
  obtain ⟨U', hU', hxU', hU'V⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Z.left.isBasis_affineOpens) (U := W) hx
  have : IsAffine (overRestrict Z U').left := hU'
  have : Nonempty (overRestrict Z U').left := ⟨⟨x, hxU'⟩⟩
  refine ⟨overRestrict Z U', inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, overRestrictι Z U', inferInstance, ?_⟩
  let F := boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ (overRestrictι Z U')
  let E := ObjectProperty.triangEnvelope
    (C := Dᵇc((overRestrict Z U').left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    IsDualizable
  have : ObjectProperty.Nonempty
      (C := Dᵇc((overRestrict Z U').left)⟦Profinite.padicAlgClRingObj ℓ⟧) IsDualizable :=
    ⟨_, isDualizable_unit⟩
  -- the cohomology sheaves whose restriction to `U'` lies in `E`
  let P : ObjectProperty (Mod (Sheaf (Scheme.ProEt.topology Z.left) Ab.{u + 1})
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z.left)) := fun M ↦
    ∃ hM : IsConstructibleModuleObject _ M, E (F.obj ⟨(DerivedCategory.singleFunctor _ 0).obj M,
      boundedConstructible_singleFunctor_obj _ Z.left 0 M hM⟩)
  -- the bounded constructible complexes whose restriction to `U'` lies in `E`
  let Q : ObjectProperty (DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology Z.left) Ab.{u + 1})
      (condensedRingObj (Profinite.padicAlgClRingObj ℓ) Z.left))) := fun K ↦
    ∃ hK : boundedConstructible _ K, E (F.obj ⟨K, hK⟩)
  have hPiso : P.IsClosedUnderIsomorphisms := ⟨fun {M M'} e ⟨hM, h⟩ ↦
    ⟨IsConstructibleModuleObject.of_iso e hM, E.prop_of_iso (F.mapIso
      ((boundedConstructible _).fullyFaithfulι.preimageIso
        (X := ⟨_, boundedConstructible_singleFunctor_obj _ Z.left 0 M hM⟩)
        (Y := ⟨_, boundedConstructible_singleFunctor_obj _ Z.left 0 M'
          (IsConstructibleModuleObject.of_iso e hM)⟩)
        ((DerivedCategory.singleFunctor _ 0).mapIso e))) h⟩⟩
  have hQiso : Q.IsClosedUnderIsomorphisms := ⟨fun {K K'} e ⟨hK, h⟩ ↦
    ⟨(boundedConstructible _).prop_of_iso e hK, E.prop_of_iso (F.mapIso
      ((boundedConstructible _).fullyFaithfulι.preimageIso (X := ⟨K, hK⟩)
        (Y := ⟨K', (boundedConstructible _).prop_of_iso e hK⟩) e)) h⟩⟩
  have hQ : Q.IsTriangulatedClosed₂ := .mk' fun T hT ⟨h₁, e₁⟩ ⟨h₃, e₃⟩ ↦ by
    have h₂ := (boundedConstructible _).ext_of_isTriangulatedClosed₂ T hT h₁ h₃
    obtain ⟨δ', hT'⟩ := ObjectProperty.exists_distTriang_of_ι (boundedConstructible _)
      (A := ⟨T.obj₁, h₁⟩) (B := ⟨T.obj₂, h₂⟩) (C := ⟨T.obj₃, h₃⟩)
      (ObjectProperty.homMk T.mor₁) (ObjectProperty.homMk T.mor₂) T.mor₃ hT
    exact ⟨h₂, E.ext_of_isTriangulatedClosed₂ _ (F.map_distinguished _ hT') e₁ e₃⟩
  have hPQ : DerivedCategory.singleObjects P ≤ Q := by
    refine fun K hK ↦ ?_
    obtain ⟨n, M, ⟨hM, h⟩, ⟨e⟩⟩ := hK
    have hK := (boundedConstructible _).prop_of_iso e.symm
      (boundedConstructible_singleFunctor_obj _ Z.left n M hM)
    refine ⟨hK, E.prop_of_iso ?_ (ObjectProperty.le_shift (P := E) (-n) _ h)⟩
    exact ((F.commShiftIso (-n)).app _).symm ≪≫ F.mapIso
      ((boundedConstructible _).fullyFaithfulι.preimageIso
        ((((boundedConstructible _).ι.commShiftIso (-n)).app _) ≪≫
          ((DerivedCategory.singleFunctors _).shiftIso (-n) n 0 (by simp)).app M ≪≫ e.symm))
  have hP : ∀ n, P ((DerivedCategory.homologyFunctor _ n).obj N.obj) := by
    intro n
    refine ⟨hH n, ?_⟩
    by_cases hn : n ∈ Finset.Icc a b
    · exact ObjectProperty.le_triangEnvelope _ _
        (isDualizable_upperStar_overRestrictι_of_le ℓ hU'V (hW n hn))
    · refine E.prop_of_isZero (F.map_isZero (IsZero.of_full_of_faithful_of_isZero
        (boundedConstructible _).ι
        (⟨_, boundedConstructible_singleFunctor_obj _ Z.left 0 _ (hH n)⟩ : Dᵇc(Z.left)⟦_⟧)
        (Functor.map_isZero (DerivedCategory.singleFunctor _ 0) (hab n ?_))))
      simp only [Finset.mem_Icc, not_and_or, not_le] at hn
      exact hn
  obtain ⟨d, hd⟩ := DerivedCategory.exists_iteratedExtensions_of_bounded P N.obj N.property.1 hP
  obtain ⟨_, h⟩ := DerivedCategory.iteratedExtensions_le P hPQ d N.obj hd
  exact h

/-- The dévissage, by noetherian induction on the support: for a closed immersion `g : Z ⟶ Y`
with image in the closed subset `C` of `Y` and `N ∈ Dᵇc(Z)⟦ℚ̲̄_ℓ⟧`, `Rg_* N` lies in the
triangulated subcategory generated by the lisse generators. On a nonempty affine open `U ⊆ Z`
the restriction of `N` is generated by dualizable objects
(`exists_isOpenImmersion_triangEnvelope_isDualizable`), and the open–closed triangle
`Rj_! Lj^* N ⟶ N ⟶ Ri_* Li^* N` reduces `N` to its restriction to the closed complement of `U`,
whose image in `Y` is strictly smaller. By topological invariance
(`isIso_unit_boundedConstructibleUpperStarLowerStarAdjunction`) we may first replace `Z` by its
reduction, which has the same image in `Y`. -/
theorem triangEnvelope_lisseGenerator_lowerStar (C : TopologicalSpace.Closeds Y.left) :
    ∀ (Z : Over (Spec (.of k))) [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
      [IsSeparated Z.hom] (g : Z ⟶ Y) [IsClosedImmersion g.left],
      Set.range g.left.base ⊆ C → ∀ N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧,
        (lisseGenerator ℓ Y).triangEnvelope
          ((boundedConstructibleLowerStar ℓ g).obj N) := by
  induction C using WellFoundedLT.induction with
  | _ C ih =>
  -- by topological invariance, we may replace `Z` by its reduction
  suffices H : ∀ (Z : Over (Spec (.of k))) [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
      [IsSeparated Z.hom] [IsReduced Z.left] (g : Z ⟶ Y) [IsClosedImmersion g.left],
      Set.range g.left.base ⊆ C → ∀ N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧,
        (lisseGenerator ℓ Y).triangEnvelope
          ((boundedConstructibleLowerStar ℓ g).obj N) by
    intro Z _ _ _ g _ hg N
    let r := overReductionι Z
    have : IsClosedImmersion (r ≫ g).left := by rw [Over.comp_left]; infer_instance
    have := isIso_unit_boundedConstructibleUpperStarLowerStarAdjunction ℓ r
    refine ObjectProperty.prop_of_iso _
      ((boundedConstructibleLowerStar ℓ g).mapIso
        (asIso ((boundedConstructibleUpperStarLowerStarAdjunction
          ℓ r).unit.app N)).symm) ?_
    exact ObjectProperty.prop_of_iso _
      ((boundedConstructibleLowerStarComp ℓ r g).app _).symm
      (H _ (r ≫ g) (fun y ⟨z, hz⟩ ↦ hg ⟨r.left.base z, by simpa using hz⟩) _)
  intro Z _ _ _ _ g _ hg N
  rcases isEmpty_or_nonempty Z.left with hZ | hZ
  · exact ObjectProperty.prop_of_isZero _
      (Functor.map_isZero _ (isZero_boundedConstructible_of_isEmpty ℓ N))
  obtain ⟨U, _, _, _, _, ⟨u⟩, j, _, hN⟩ := exists_isOpenImmersion_triangEnvelope_isDualizable ℓ Z N
  let i := overClosedComplement j
  have hcompl := isCompl_range_overClosedComplement j
  obtain ⟨δ, hT⟩ := exists_distTriang_openClosed_boundedConstructible ℓ (j := j) (i := i)
    hcompl.symm N
  have : IsClosedImmersion (i ≫ g).left := by rw [Over.comp_left]; infer_instance
  have hlt : (⟨Set.range (i ≫ g).left.base, (i ≫ g).left.isClosedEmbedding.isClosed_range⟩ :
      TopologicalSpace.Closeds Y.left) < C := by
    refine lt_of_le_of_ne (fun y ⟨z, hz⟩ ↦ hg ⟨i.left.base z, by simpa using hz⟩) fun h ↦ ?_
    have hy : g.left.base (j.left.base u) ∈ (C : Set Y.left) := hg ⟨_, rfl⟩
    rw [← h] at hy
    obtain ⟨z, hz⟩ := hy
    have hz' : i.left.base z = j.left.base u :=
      g.left.isClosedEmbedding.injective (by simpa using hz)
    exact Set.disjoint_left.1 hcompl.disjoint ⟨z, hz'⟩ ⟨u, rfl⟩
  refine ObjectProperty.ext_of_isTriangulatedClosed₂ _ _
    ((boundedConstructibleLowerStar ℓ g).map_distinguished _ hT)
    (triangEnvelope_lisseGenerator_lowerStar_lowerShriek ℓ g j hN) ?_
  exact ObjectProperty.prop_of_iso _
    ((boundedConstructibleLowerStarComp ℓ i g).app _).symm
    (ih _ hlt _ (i ≫ g) subset_rfl _)

variable (Y) in
/-- **Constructible dévissage** at the coefficient stage `ℚ̄_ℓ` (the analogue of blueprint
`lem-trf-devissage-generation`, section `sec-six-functors-basics`, which is stated for finite
coefficients). Every bounded constructible `ℚ̄_ℓ`-complex on `Y` lies in the triangulated
subcategory of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` generated by the lisse generators `Rg_! Rj_! L`: this is
`triangEnvelope_lisseGenerator_lowerStar` for the identity of `Y`. -/
theorem triangEnvelope_lisseGenerator (N : Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    (lisseGenerator ℓ Y).triangEnvelope N :=
  have : IsClosedImmersion (𝟙 Y : Y ⟶ Y).left := inferInstanceAs (IsClosedImmersion (𝟙 Y.left))
  ObjectProperty.prop_of_iso _ ((boundedConstructibleLowerStarId ℓ Y).app N)
    (triangEnvelope_lisseGenerator_lowerStar ℓ ⊤ Y (𝟙 Y) (Set.subset_univ _) N)

