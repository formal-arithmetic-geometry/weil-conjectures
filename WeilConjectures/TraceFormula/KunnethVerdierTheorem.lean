module

public import WeilConjectures.TraceFormula.KunnethVerdierUnit
public import WeilConjectures.TraceFormula.ExceptionalKunnethRestriction
public import WeilConjectures.TraceFormula.KunnethVerdierClosed
public import WeilConjectures.TraceFormula.PurityCompatibility

/-!
# The Künneth–Verdier theorem for `ℚ̄_ℓ`-coefficients

For separated `k`-schemes of finite type `X`, `Y` and bounded constructible `M` on `X`, `N` on
`Y`, the Künneth–Verdier map `κ_{M,N} : M ⊠ D_Y N ⟶ RHom(Lp_Y^* N, Rp_X^! M)` is an isomorphism
(`ProEtale.CondensedRing.isIso_kunnethVerdierMap`, blueprint
`lemma-external-duality-trace-morphism--1`).

## Proof

By dévissage in `N`: the objects `N` with `κ_{M,N⟦n⟧}` invertible for all `n` form a triangulated
subcategory (`isIso_kunnethVerdierMap_of_triangEnvelope_right`), and `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` is generated by
the objects `Rg_! Rj_! L` with `g` a closed immersion, `j : U ⟶ Z` an open immersion, `U` affine and
`L` dualizable (`triangEnvelope_lisseGenerator`). Closed pushforward and extension by zero along
open immersions are compatible with `κ`
(`isIso_kunnethVerdierMap_lowerShriek_iff_of_isClosedImmersion`,
`isIso_kunnethVerdierMap_lowerShriek`), and for dualizable `L` on `U` the map `κ_{M,L}` is
invertible as soon as the exceptional Künneth map `α : M ⊠ ω_U ⟶ Rp_X^! M` is
(`isIso_kunnethVerdierMap_of_exactPairing`).

It remains to see that `α` is invertible for affine `U`
(`isIso_exceptionalKunnethMap_of_isAffine`). Embed `U` as a closed subscheme of an affine space
`𝔸ⁿ`, with open complement `W`. Since `𝔸ⁿ` and `W` are smooth, `α` is invertible for them by smooth
purity (`isIso_exceptionalKunnethMap_of_smooth`), so `κ_{M,ℚ̄_ℓ}` and `κ_{M, j_!ℚ̄_ℓ}` are
invertible on `X ⨯ 𝔸ⁿ`; the open–closed triangle `j_! ℚ̄_ℓ ⟶ ℚ̄_ℓ ⟶ i_* ℚ̄_ℓ` gives
`κ_{M, i_* ℚ̄_ℓ}`, hence `κ_{M,ℚ̄_ℓ}` on `X ⨯ U`, which is `α` up to isomorphisms
(`isIso_kunnethVerdierMap_unit_iff`).
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory MonoidalClosed Pretriangulated

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

attribute [local instance] boundedConstructibleBraiding

variable (ℓ : ℕ) [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]

section Lemmas

variable {X Y U : Over (Spec (.of k))}
  [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom] [LocallyOfFiniteType Y.hom]
  [QuasiCompact Y.hom] [IsSeparated Y.hom] [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
  [IsSeparated U.hom]

/-- The invertibility of `κ_{M,N}` only depends on `N` up to isomorphism. -/
lemma isIso_kunnethVerdierMap_of_iso_right (M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    {N N' : Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (e : N ≅ N')
    (h : IsIso (kunnethVerdierMap ℓ M N')) : IsIso (kunnethVerdierMap ℓ M N) := by
  let l := (boundedConstructibleUpperStar _ ℓ (prod.fst : X ⨯ Y ⟶ X)).obj M ◁
    (boundedConstructibleUpperStar _ ℓ (prod.snd : X ⨯ Y ⟶ Y)).map
      ((pre e.hom).app (dualizingComplex' ℓ Y))
  have w : l ≫ kunnethVerdierMap ℓ M N = _ := kunnethVerdierMap_naturality_right_pre ℓ M e.hom
  have : IsIso ((pre ((boundedConstructibleUpperStar _ ℓ (prod.snd : X ⨯ Y ⟶ Y)).map e.hom)).app
      ((boundedConstructibleUpperShriek ℓ (prod.fst : X ⨯ Y ⟶ X)).obj M)) :=
    isIso_pre_app_of_isIso _ _
  have : IsIso ((pre e.hom).app (dualizingComplex' ℓ Y)) := isIso_pre_app_of_isIso _ _
  have : IsIso l := by dsimp only [l]; infer_instance
  have : IsIso (l ≫ kunnethVerdierMap ℓ M N) := by rw [w]; infer_instance
  exact IsIso.of_isIso_comp_left l _

/-- For a dualizable `N`, `κ_{M,N}` is invertible as soon as the exceptional Künneth map is. -/
lemma isIso_kunnethVerdierMap_of_isDualizable (M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    {N : Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hN : IsDualizable N)
    [IsIso (exceptionalKunnethMap ℓ (Y := Y) M)] : IsIso (kunnethVerdierMap ℓ M N) := by
  obtain ⟨_⟩ := hN
  let := BraidedCategory.exactPairing_swap N Nᘁ
  exact isIso_kunnethVerdierMap_of_exactPairing ℓ M N Nᘁ

/-- `Lj^* Rj_! L ≅ L` for an open immersion `j`. -/
noncomputable def upperStarLowerShriekIsoOfIsOpenImmersion (j : U ⟶ Y) [IsOpenImmersion j.left]
    (L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).obj
      ((boundedConstructibleLowerShriek ℓ j).obj L) ≅ L :=
  (boundedConstructibleUpperStar _ ℓ j).mapIso
      ((boundedConstructibleLowerShriekIsoOpenImmersionLowerShriek_padicAlgCl ℓ j).app L) ≪≫
    (asIso ((boundedConstructibleOpenImmersionLowerShriekUpperStarAdjunction _ ℓ j).unit.app
      L)).symm

/-- The extension by zero `Rj_! L` of a dualizable `L` along an open immersion `j : U ⟶ Y`:
`κ_{M, Rj_! L}` is invertible as soon as the exceptional Künneth map of `U` is. -/
lemma isIso_kunnethVerdierMap_lowerShriek_of_isDualizable (j : U ⟶ Y) [IsOpenImmersion j.left]
    (M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    {L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hL : IsDualizable L)
    [IsIso (exceptionalKunnethMap ℓ (Y := U) M)] :
    IsIso (kunnethVerdierMap ℓ (Y := Y) M
      ((boundedConstructibleLowerShriek ℓ j).obj L)) :=
  isIso_kunnethVerdierMap_lowerShriek ℓ j M (exceptionalKunnethMapRestriction ℓ j M) L
    (isIso_kunnethVerdierMap_of_iso_right ℓ M (upperStarLowerShriekIsoOfIsOpenImmersion ℓ j L)
      (isIso_kunnethVerdierMap_of_isDualizable ℓ M hL))

end Lemmas

/-- **The exceptional Künneth map of an affine scheme is invertible**: for `U` affine, separated
and of finite type over `k`, `α : M ⊠ ω_U ⟶ Rp_X^! M` is an isomorphism. -/
theorem isIso_exceptionalKunnethMap_of_isAffine {X : Over (Spec (.of k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    (U : Over (Spec (.of k))) [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [IsSeparated U.hom] [IsAffine U.left] (M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    IsIso (exceptionalKunnethMap ℓ (Y := U) M) := by
  let e := affineSpaceEmbedding U
  rw [← isIso_kunnethVerdierMap_unit_iff,
    ← isIso_kunnethVerdierMap_lowerShriek_iff_of_isClosedImmersion ℓ e.i]
  have := isIso_exceptionalKunnethMap_of_smooth ℓ (Y := affineSpaceOver k e.n) M
  have := isIso_exceptionalKunnethMap_of_smooth ℓ (Y := e.complOver) M
  obtain ⟨δ, hT⟩ := exists_distTriang_openClosed_boundedConstructible ℓ (j := e.complι)
    (i := e.i) e.isCompl_range.symm (𝟙_ _)
  have hT' := rot_of_distTriang _ hT
  -- the shifts of the unit and of the extension by zero of the unit of `W`
  have h₁ : ∀ n : ℤ, IsIso (kunnethVerdierMap ℓ M
      ((shiftFunctor (Dᵇc((affineSpaceOver k e.n).left)⟦Profinite.padicAlgClRingObj ℓ⟧) n).obj
        (𝟙_ _))) :=
    fun n ↦ isIso_kunnethVerdierMap_of_isDualizable ℓ M (isDualizable_shift_unit ℓ _ n)
  have h₃ : ∀ n : ℤ, IsIso (kunnethVerdierMap ℓ M
      ((shiftFunctor (Dᵇc((affineSpaceOver k e.n).left)⟦Profinite.padicAlgClRingObj ℓ⟧) n).obj
        ((shiftFunctor _ (1 : ℤ)).obj
          ((boundedConstructibleLowerShriek ℓ e.complι).obj
            ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ e.complι).obj
              (𝟙_ _)))))) := by
    intro n
    let F := boundedConstructibleLowerShriek ℓ e.complι
    let L := (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ e.complι).obj
      (𝟙_ _)
    have hL : IsDualizable L :=
      IsDualizable.of_iso (Functor.Monoidal.εIso _) isDualizable_unit
    refine isIso_kunnethVerdierMap_of_iso_right ℓ M
      ((shiftFunctor _ n).mapIso ((F.commShiftIso (1 : ℤ)).app L).symm ≪≫
        ((F.commShiftIso n).app _).symm) ?_
    exact isIso_kunnethVerdierMap_lowerShriek_of_isDualizable ℓ e.complι M
      (IsDualizable.shift ℓ (IsDualizable.shift ℓ hL 1) n)
  have := isIso_kunnethVerdierMap_of_distinguished_right ℓ M _ hT' h₁ h₃ 0
  refine isIso_kunnethVerdierMap_of_iso_right ℓ M
    ((boundedConstructibleLowerShriekIsoLowerStar_padicAlgCl ℓ e.i).app _ ≪≫
      (boundedConstructibleLowerStar ℓ e.i).mapIso
        (Functor.Monoidal.εIso (boundedConstructibleUpperStar _ ℓ e.i)) ≪≫
      ((shiftFunctorZero _ ℤ).app _).symm) this

variable {X Y : Over (Spec (.of k))}
  [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom] [LocallyOfFiniteType Y.hom]
  [QuasiCompact Y.hom] [IsSeparated Y.hom]

/-- **The Künneth–Verdier isomorphism** (blueprint `lemma-external-duality-trace-morphism--1`): for
bounded constructible `M` on `X` and `N` on `Y`, the Künneth–Verdier map
`κ_{M,N} : M ⊠ D_Y N ⟶ RHom(Lp_Y^* N, Rp_X^! M)` is an isomorphism. -/
instance isIso_kunnethVerdierMap (M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (N : Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    IsIso (kunnethVerdierMap ℓ M N) := by
  refine isIso_kunnethVerdierMap_of_triangEnvelope_right ℓ M ?_
    (triangEnvelope_lisseGenerator ℓ Y N)
  rintro N ⟨Z, _, _, _, g, _, U, _, _, _, _, j, _, L, hL, ⟨eN⟩⟩ n
  have := isIso_exceptionalKunnethMap_of_isAffine ℓ U M
  let F := boundedConstructibleLowerShriek ℓ g
  let G := boundedConstructibleLowerShriek ℓ j
  refine isIso_kunnethVerdierMap_of_iso_right ℓ M
    ((shiftFunctor _ n).mapIso eN ≪≫ ((F.commShiftIso n).app _).symm ≪≫
      F.mapIso ((G.commShiftIso n).app L).symm) ?_
  rw [isIso_kunnethVerdierMap_lowerShriek_iff_of_isClosedImmersion ℓ g]
  exact isIso_kunnethVerdierMap_lowerShriek_of_isDualizable ℓ j M (IsDualizable.shift ℓ hL n)

end AlgebraicGeometry.ProEtale.CondensedRing
