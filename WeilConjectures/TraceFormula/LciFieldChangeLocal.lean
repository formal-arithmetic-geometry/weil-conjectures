module

public import WeilConjectures.RingTheory.CompleteIntersectionLocal
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
import WeilConjectures.TraceFormula.LciConormalNumericalCriterion
import all WeilConjectures.AlgebraicGeometry.DimensionAtPointFieldExtension
import Mathlib.RingTheory.Extension.Presentation.Basic
import WeilConjectures.SixFunctors.TraceFormula.LciConormalFibreFieldChange

/-!
# Complete-intersection local rings under extension of the base field

Source: Stacks Project, Algebra, Lemma 10.135.10, Tag 00SI
(blueprint: lem-trf-lci-field-change-local).
-/

@[expose] public section

set_option autoImplicit false

universe u v w

open scoped TensorProduct

namespace Algebra

set_option maxHeartbeats 800000 in
-- Polynomial base change and prime contraction involve several algebra towers.
/-- Complete-intersection local rings at corresponding primes are invariant under any
extension of the base field. The contraction uses `c ↦ 1 ⊗ c`, and the tensor product
has its canonical left-factor `K`-algebra structure. No separability, algebraicity, or
completeness assumption is imposed.

Source: Stacks Project, Algebra, Lemma 10.135.10, Tag 00SI
(blueprint: lem-trf-lci-field-change-local).

Proof:
1. Choose a finite polynomial presentation `P → C`. Its scalar extension is
   `P_K → K ⊗ C`; the presentation base-change theorem identifies its kernel
   with the ideal generated by the coefficientwise images of the original kernel.
2. The dimension-at-a-point field-extension theorem identifies the local topological
   dimensions at the corresponding primes. Tensor commutativity puts the theorem's
   right-factor field extension into the left-factor convention used here.
3. The conormal-fibre field-change theorem identifies the dimensions of the two
   conormal fibres over their respective residue fields.
4. Apply `isCompleteIntersectionLocal_iff_conormal_finrank` to both presentations.
   Both sides say that the local dimension is an integer `d ≤ n` and the conormal
   fibre has dimension `n - d`. Steps 2 and 3 make these conditions identical.
   The numerical criterion proves both directions using principal CI neighbourhoods,
   the conormal rank theorem, Nakayama, and localized regular equations. -/
theorem isCompleteIntersectionLocal_fieldChange
    (k : Type u) (K : Type v) (C : Type w)
    [Field k] [Field K] [CommRing C] [Algebra k K] [Algebra k C]
    [FiniteType k C] (qK : Ideal (K ⊗[k] C)) [qK.IsPrime] :
    IsCompleteIntersectionLocal k
        (Localization.AtPrime
          (qK.comap (Algebra.TensorProduct.includeRight (R := k) (A := K)).toRingHom)) ↔
      IsCompleteIntersectionLocal K (Localization.AtPrime qK) := by
  classical
  obtain ⟨n, π, hπ⟩ := FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : FiniteType k C)
  let G := Generators.ofAlgHom π hπ
  let P : Presentation k C (Fin n) G.ker := {
    toGenerators := G
    relation := Subtype.val
    span_range_relation_eq_ker := by
      rw [Subtype.range_coe_subtype]
      exact Ideal.span_eq G.ker }
  let πK := AlgebraicGeometry.lciBaseChangePresentationMap k K C n π
  have hπK : Function.Surjective πK := (G.baseChange K).aeval_val_surjective
  have : FiniteType K (K ⊗[k] C) := FiniteType.of_surjective πK hπK
  have hker : RingHom.ker πK.toRingHom =
      (RingHom.ker π.toRingHom).map (MvPolynomial.map (algebraMap k K)) := by
    have h := P.span_range_relation_eq_ker_baseChange K
    have hG : G.ker = RingHom.ker π.toRingHom := by
      rw [Generators.ker_eq_ker_aeval_val]
      congr 1
      ext i
      simp [G, Generators.ofAlgHom, Generators.ofSurjective]
    change Ideal.span (Set.range (fun i : G.ker ↦
      MvPolynomial.map (algebraMap k K) i.val)) = RingHom.ker πK.toRingHom at h
    rw [← h, ← hG, ← Ideal.span_eq G.ker, Ideal.map_span]
    congr 1
    ext x
    simp
  let q := qK.comap (TensorProduct.includeRight (R := k) (A := K)).toRingHom
  let qPK := qK.comap πK.toRingHom
  have hcomp : πK.toRingHom.comp (MvPolynomial.map (algebraMap k K)) =
      (TensorProduct.includeRight (R := k) (A := K)).toRingHom.comp π.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [πK, AlgebraicGeometry.lciBaseChangePresentationMap]
    · intro i
      simp [πK, AlgebraicGeometry.lciBaseChangePresentationMap]
  have hqP : qPK.comap (MvPolynomial.map (algebraMap k K)) = q.comap π.toRingHom := by
    simp only [qPK, q, Ideal.comap_comap, hcomp]
  have hdim : topologicalKrullDimAt (⟨q, inferInstance⟩ : PrimeSpectrum C) =
      topologicalKrullDimAt (⟨qK, inferInstance⟩ : PrimeSpectrum (K ⊗[k] C)) := by
    let E := TensorProduct.comm k C K
    let H := PrimeSpectrum.homeomorphOfRingEquiv E.toRingEquiv
    let p : PrimeSpectrum (K ⊗[k] C) := ⟨qK, inferInstance⟩
    have hd := AlgebraicGeometry.topologicalKrullDimAt_spec_tensorProduct_field_extension
      (H.symm p)
    have hp : PrimeSpectrum.comap
        (TensorProduct.includeLeftRingHom (R := k) (A := C) (B := K)) (H.symm p) =
        (⟨q, inferInstance⟩ : PrimeSpectrum C) := by
      apply PrimeSpectrum.ext
      ext c
      simp [H, E, p, q, PrimeSpectrum.homeomorphOfRingEquiv,
        TensorProduct.comm_symm]
    rw [hp] at hd
    exact hd.trans ((AlgebraicGeometry.localDim_homeomorph H (H.symm p)).trans
      (congrArg topologicalKrullDimAt (H.apply_symm_apply p)))
  obtain ⟨_, _, _, _, hrank⟩ :=
    AlgebraicGeometry.lciConormalFibreFieldChange k K C n π hπ qK
  change Module.finrank qPK.ResidueField
      (AlgebraicGeometry.lciConormalFibre qPK
        ((RingHom.ker π.toRingHom).map (MvPolynomial.map (algebraMap k K)))) =
    Module.finrank (qPK.comap (MvPolynomial.map (algebraMap k K))).ResidueField
      (AlgebraicGeometry.lciConormalFibre
        (qPK.comap (MvPolynomial.map (algebraMap k K)))
        (RingHom.ker π.toRingHom)) at hrank
  have hrank' : Module.finrank (qK.comap πK.toRingHom).ResidueField
      (AlgebraicGeometry.lciConormalFibre (qK.comap πK.toRingHom)
        (RingHom.ker πK.toRingHom)) =
      Module.finrank (q.comap π.toRingHom).ResidueField
        (AlgebraicGeometry.lciConormalFibre (q.comap π.toRingHom)
          (RingHom.ker π.toRingHom)) := by
    rw [hker]
    refine hrank.trans ?_
    exact (show ∀ (p q : Ideal (MvPolynomial (Fin n) k)) [p.IsPrime] [q.IsPrime],
        p = q → Module.finrank p.ResidueField
            (AlgebraicGeometry.lciConormalFibre p (RingHom.ker π.toRingHom)) =
          Module.finrank q.ResidueField
            (AlgebraicGeometry.lciConormalFibre q (RingHom.ker π.toRingHom)) from by
      intro p q _ _ h
      subst q
      rfl) _ _ hqP
  change IsCompleteIntersectionLocal k (Localization.AtPrime q) ↔ _
  rw [isCompleteIntersectionLocal_iff_conormal_finrank k C n π hπ q,
    isCompleteIntersectionLocal_iff_conormal_finrank K (K ⊗[k] C) n πK hπK qK,
    ← hdim]
  simp only [hrank']

end Algebra
