/-!
# Affine presentations of the Frobenius equalizer

Source: latest Weil conjectures blueprint, sec-smooth-purity,
sk-cor-sp-all-coefficients, thm-trf-frobenius-fixed-points.proof.md, Steps 0–1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation).

## Main definitions

The affine model, its scalar-extended chart map, tensor Frobenius, difference ideal,
coefficient-extended relation ideal and coordinate power ideal are explicit constructions.

## Main statements

`presentation` supplies finite model charts, their stability, the canonical quotient
presentation and its compatibility with restriction. No separatedness is assumed.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped TensorProduct

namespace WeilConjectures.FiniteFieldDatum.FrobeniusAffineEqualizer

/-- The affine model Spec A with its specified structure map to Spec k₀.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Step 0
(blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
noncomputable def model (D : WeilConjectures.FiniteFieldDatum.{u}) (A : CommAlgCat.{u} D.k₀) :
    Over (Spec (.of D.k₀)) :=
  Over.mk (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ A)))

/-- The scalar extension of a model chart, expressed on its tensor-product spectrum.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Step 0
(blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
noncomputable def chartMap (D : WeilConjectures.FiniteFieldDatum.{u})
    (X₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom]
    (A : CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀) :
    Spec (.of (A ⊗[D.k₀] D.k)) ⟶ (D.geometricFiber X₀).left :=
  (pullbackSpecIso D.k₀ A D.k).inv ≫
    ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ D.k)))).map j).left

/-- Tensoring the m-th finite-field Frobenius with the identity of the closure.
Only an enumeration of the already finite base is chosen; the ring map is explicit.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Steps 0–1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
noncomputable def tensorFrobenius (D : WeilConjectures.FiniteFieldDatum.{u})
    (A : CommAlgCat.{u} D.k₀) (m : ℕ) :
    (A ⊗[D.k₀] D.k) →ₐ[D.k₀] (A ⊗[D.k₀] D.k) :=
  letI : Fintype D.k₀ := Fintype.ofFinite D.k₀
  Algebra.TensorProduct.map ((FiniteField.frobeniusAlgHom D.k₀ A) ^ m)
    (AlgHom.id D.k₀ D.k)

/-- The ideal generated by every difference φ(b) - b, rather than its nonideal kernel.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Steps 0–1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
noncomputable def differenceIdeal (D : WeilConjectures.FiniteFieldDatum.{u})
    (A : CommAlgCat.{u} D.k₀) (m : ℕ) : Ideal (A ⊗[D.k₀] D.k) :=
  Ideal.span (Set.range (fun b ↦ tensorFrobenius D A m b - b))

/-- Extension of the relation ideal along coefficientwise scalar extension.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Step 1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
noncomputable def extendedIdeal (D : WeilConjectures.FiniteFieldDatum.{u}) (r : ℕ)
    (a : Ideal (MvPolynomial (Fin r) D.k₀)) : Ideal (MvPolynomial (Fin r) D.k) :=
  a.map (MvPolynomial.map (algebraMap D.k₀ D.k))

/-- The ideal generated by the coordinate power differences tᵢ^(q^m) - tᵢ.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Step 1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation). -/
noncomputable def powerIdeal (D : WeilConjectures.FiniteFieldDatum.{u}) (m r : ℕ) :
    Ideal (MvPolynomial (Fin r) D.k) :=
  Ideal.span (Set.range (fun i : Fin r ↦
    (MvPolynomial.X i : MvPolynomial (Fin r) D.k) ^ (D.q ^ m) - MvPolynomial.X i))

/-- Frobenius on a pure tensor has the q^m power formula.
The finite-field Frobenius power theorem supplies the calculation. -/
private theorem tensorFrobenius_tmul (D : FiniteFieldDatum.{u})
    (A : CommAlgCat.{u} D.k₀) (m : ℕ) (a : A) (c : D.k) :
    tensorFrobenius D A m (a ⊗ₜ c) = (a ^ (D.q ^ m)) ⊗ₜ c := by
  classical
  set_option linter.style.haveILetI false in
    letI : Fintype D.k₀ := Fintype.ofFinite D.k₀
  change ((FiniteField.frobeniusAlgHom D.k₀ A) ^ m) a ⊗ₜ[D.k₀] c =
    (a ^ (D.q ^ m)) ⊗ₜ[D.k₀] c
  rw [congrFun (FiniteField.coe_frobeniusAlgHom_pow D.k₀ A m) a]
  rw [Fintype.card_eq_nat_card, D.card_base, D.cardinality_eq]

/-- Scalar extension of a presented algebra, from Mathlib tensor and quotient equivalences. -/
private theorem polynomial_tensor_equiv (D : FiniteFieldDatum.{u})
    (A : CommAlgCat.{u} D.k₀) (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀))
    (p : (MvPolynomial (Fin r) D.k₀ ⧸ a) ≃ₐ[D.k₀] A) :
    ∃ θ : (A ⊗[D.k₀] D.k) ≃+*
      (MvPolynomial (Fin r) D.k ⧸ extendedIdeal D r a),
      ∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
        θ (p (Ideal.Quotient.mk a f) ⊗ₜ c) =
          Ideal.Quotient.mk (extendedIdeal D r a)
            (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c) := by
  classical
  let t : (MvPolynomial (Fin r) D.k₀ ⊗[D.k₀] D.k) ≃+*
      MvPolynomial (Fin r) D.k :=
    (Algebra.TensorProduct.comm D.k₀ _ _).toRingEquiv.trans
      (MvPolynomial.algebraTensorAlgEquiv D.k₀ D.k).toRingEquiv
  have ht (f : MvPolynomial (Fin r) D.k₀) (c : D.k) :
      t (f ⊗ₜ c) = MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c := by
    simp [t, Algebra.smul_def, mul_comm]
  have hmap : MvPolynomial.map (algebraMap D.k₀ D.k) =
      t.toRingHom.comp (algebraMap (MvPolynomial (Fin r) D.k₀)
        (MvPolynomial (Fin r) D.k₀ ⊗[D.k₀] D.k)) := by
    apply RingHom.ext
    intro f
    simpa using (ht f 1).symm
  have hi : extendedIdeal D r a =
      (a.map (algebraMap (MvPolynomial (Fin r) D.k₀)
        (MvPolynomial (Fin r) D.k₀ ⊗[D.k₀] D.k))).map t.toRingHom := by
    rw [Ideal.map_map]
    exact congrArg (fun f ↦ a.map f) hmap
  let θ := ((Algebra.TensorProduct.congr p.symm (AlgEquiv.refl : D.k ≃ₐ[D.k₀] D.k)).trans
    (Algebra.TensorProduct.quotientTensorEquiv D.k₀ D.k _ a)).toRingEquiv.trans
      (Ideal.quotientEquiv _ _ t hi)
  refine ⟨θ, ?_⟩
  intro f c
  change Ideal.quotientEquiv _ _ t hi
    (Algebra.TensorProduct.quotientTensorEquiv D.k₀ D.k _ a
      (Algebra.TensorProduct.congr p.symm (AlgEquiv.refl : D.k ≃ₐ[D.k₀] D.k)
        (p (Ideal.Quotient.mk a f) ⊗ₜ c))) = _
  rw [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
  change Ideal.quotientEquiv _ _ t hi
    (Algebra.TensorProduct.quotientTensorEquiv D.k₀ D.k _ a
      (p.symm (p (Ideal.Quotient.mk a f)) ⊗ₜ c)) = _
  rw [AlgEquiv.symm_apply_apply, Algebra.TensorProduct.quotientTensorEquiv_apply_tmul,
    Ideal.quotientEquiv_mk, ht]

/-- The pure-tensor power formula commutes with every model algebra homomorphism. -/
private theorem tensorFrobenius_natural (D : FiniteFieldDatum.{u})
    (A A' : CommAlgCat.{u} D.k₀) (m : ℕ) (f : A →ₐ[D.k₀] A')
    (b : A ⊗[D.k₀] D.k) :
    Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k) (tensorFrobenius D A m b) =
      tensorFrobenius D A' m (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k) b) := by
  induction b using TensorProduct.induction_on with
  | zero => simp
  | tmul a c => simp [tensorFrobenius_tmul]
  | add b c hb hc => simp [map_add, hb, hc]

/-- Naturality carries each Frobenius difference generator into the target difference ideal. -/
private theorem differenceIdeal_natural (D : FiniteFieldDatum.{u})
    (A A' : CommAlgCat.{u} D.k₀) (m : ℕ) (f : A →ₐ[D.k₀] A') :
    differenceIdeal D A m ≤ (differenceIdeal D A' m).comap
      (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨b, rfl⟩
  change Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)
    (tensorFrobenius D A m b - b) ∈ differenceIdeal D A' m
  rw [map_sub, tensorFrobenius_natural]
  exact Ideal.subset_span ⟨_, rfl⟩

/-- Polynomial universality identifies the difference ideal with the coordinate power ideal. -/
private theorem differenceIdeal_polynomial (D : FiniteFieldDatum.{u})
    (A : CommAlgCat.{u} D.k₀) (m r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀))
    (p : (MvPolynomial (Fin r) D.k₀ ⧸ a) ≃ₐ[D.k₀] A)
    (θ : (A ⊗[D.k₀] D.k) ≃+* (MvPolynomial (Fin r) D.k ⧸ extendedIdeal D r a))
    (hθ : ∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
      θ (p (Ideal.Quotient.mk a f) ⊗ₜ c) =
        Ideal.Quotient.mk (extendedIdeal D r a)
          (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c)) :
    (differenceIdeal D A m).map θ.toRingHom =
      (powerIdeal D m r).map (Ideal.Quotient.mk (extendedIdeal D r a)) := by
  classical
  let I := extendedIdeal D r a
  let H := (powerIdeal D m r).map (Ideal.Quotient.mk I)
  let π := Ideal.Quotient.mk H
  let L : MvPolynomial (Fin r) D.k₀ →+* A ⊗[D.k₀] D.k :=
    (Algebra.TensorProduct.includeLeft : A →ₐ[D.k₀] A ⊗[D.k₀] D.k).toRingHom.comp
      (p.toRingHom.comp (Ideal.Quotient.mk a))
  have hcoords (i : Fin r) :
      π (θ (tensorFrobenius D A m (L (MvPolynomial.X i)))) =
        π (θ (L (MvPolynomial.X i))) := by
    change π (θ (tensorFrobenius D A m
      (p (Ideal.Quotient.mk a (MvPolynomial.X i)) ⊗ₜ (1 : D.k)))) =
        π (θ (p (Ideal.Quotient.mk a (MvPolynomial.X i)) ⊗ₜ (1 : D.k)))
    rw [tensorFrobenius_tmul]
    rw [← map_pow, ← map_pow, hθ, hθ]
    simp only [map_pow, MvPolynomial.map_X, MvPolynomial.C_1, mul_one]
    apply Ideal.Quotient.eq.mpr
    change Ideal.Quotient.mk I ((MvPolynomial.X i) ^ (D.q ^ m)) -
      Ideal.Quotient.mk I (MvPolynomial.X i) ∈ H
    rw [← map_sub]
    apply Ideal.mem_map_of_mem
    exact Ideal.subset_span ⟨i, rfl⟩
  have hpoly : (π.comp θ.toRingHom).comp ((tensorFrobenius D A m).toRingHom.comp L) =
      (π.comp θ.toRingHom).comp L := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change π (θ (tensorFrobenius D A m (L (MvPolynomial.C c)))) =
        π (θ (L (MvPolynomial.C c)))
      have hL : L (MvPolynomial.C c) = algebraMap D.k₀ (A ⊗[D.k₀] D.k) c := by
        exact ((Algebra.TensorProduct.includeLeft : A →ₐ[D.k₀] A ⊗[D.k₀] D.k).comp
          (p.toAlgHom.comp (Ideal.Quotient.mkₐ D.k₀ a))).commutes c
      rw [hL, AlgHom.commutes]
    · exact hcoords
  have hfix (b : A ⊗[D.k₀] D.k) :
      π (θ (tensorFrobenius D A m b)) = π (θ b) := by
    induction b using TensorProduct.induction_on with
    | zero => simp
    | add b c hb hc => simp [map_add, hb, hc]
    | tmul x c =>
      obtain ⟨x, rfl⟩ := p.surjective x
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hf := DFunLike.congr_fun hpoly f
      have hs : tensorFrobenius D A m ((1 : A) ⊗ₜ c) = (1 : A) ⊗ₜ c := by
        simp [tensorFrobenius_tmul]
      have ht : p (Ideal.Quotient.mk a f) ⊗ₜ c =
          (L f) * ((1 : A) ⊗ₜ c) := by simp [L, Algebra.TensorProduct.tmul_mul_tmul]
      rw [ht, map_mul, map_mul, map_mul, hs, map_mul, map_mul]
      exact congrArg (fun x ↦ x * π (θ ((1 : A) ⊗ₜ c))) hf
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    apply Ideal.span_le.mpr
    rintro _ ⟨b, rfl⟩
    change θ (tensorFrobenius D A m b - b) ∈ H
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [map_sub, sub_eq_zero]
    exact hfix b
  · rw [powerIdeal, Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    have hb : tensorFrobenius D A m
        (p (Ideal.Quotient.mk a (MvPolynomial.X i)) ⊗ₜ (1 : D.k)) -
        (p (Ideal.Quotient.mk a (MvPolynomial.X i)) ⊗ₜ (1 : D.k)) ∈
          differenceIdeal D A m := Ideal.subset_span ⟨_, rfl⟩
    have ht := Ideal.mem_map_of_mem θ.toRingHom hb
    rw [tensorFrobenius_tmul, map_sub] at ht
    change θ (((p (Ideal.Quotient.mk a (MvPolynomial.X i))) ^ (D.q ^ m)) ⊗ₜ
      (1 : D.k)) - θ (p (Ideal.Quotient.mk a (MvPolynomial.X i)) ⊗ₜ (1 : D.k)) ∈ _ at ht
    rw [← map_pow, ← map_pow, hθ, hθ] at ht
    simp only [map_pow, MvPolynomial.map_X, MvPolynomial.C_1, mul_one,
      map_sub] at ht ⊢
    exact ht

/-- The two tensor projections identify the base change of a model chart restriction. -/
private theorem chartMap_natural (D : FiniteFieldDatum.{u})
    (X₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom]
    (A A' : CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀) (j' : model D A' ⟶ X₀)
    (f : A →ₐ[D.k₀] A')
    (hf : Spec.map (CommRingCat.ofHom f.toRingHom) ≫ j.left = j'.left) :
    Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)).toRingHom) ≫ chartMap D X₀ A j =
        chartMap D X₀ A' j' := by
  apply pullback.hom_ext
  · have hc : Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)).toRingHom) ≫
          Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[D.k₀] D.k)) =
        Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : A' →+* A' ⊗[D.k₀] D.k)) ≫
            Spec.map (CommRingCat.ofHom f.toRingHom) := by
      rw [← Spec.map_comp, ← Spec.map_comp]
      congr 1
    simpa [chartMap, model, Over.pullback_map_left, Category.assoc, ← hf] using
      congrArg (fun z ↦ z ≫ j.left) hc
  · have hc : Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)).toRingHom) ≫
          Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight : D.k →ₐ[D.k₀] A ⊗[D.k₀] D.k).toRingHom) =
        Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : D.k →ₐ[D.k₀] A' ⊗[D.k₀] D.k).toRingHom) := by
      rw [← Spec.map_comp]
      congr 1
      ext c
      simp
    simpa [chartMap, model, Over.pullback_map_left, Category.assoc] using hc

/-- A finite affine cover over an affine base carries finitely generated base algebras. -/
private theorem finite_model_cover (D : FiniteFieldDatum.{u})
    (X₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom] :
    ∃ (n : ℕ) (A : Fin n → CommAlgCat.{u} D.k₀)
      (j : ∀ i, model D (A i) ⟶ X₀),
      (∀ i, Algebra.FiniteType D.k₀ (A i) ∧ IsOpenImmersion (j i).left) ∧
        (∀ x : X₀.left, ∃ i, x ∈ Set.range (j i).left) := by
  classical
  let : CompactSpace X₀.left := QuasiCompact.compactSpace_of_compactSpace X₀.hom
  let C := X₀.left.affineCover.finiteSubcover
  let e := Fintype.equivFin C.I₀
  let R (i : C.I₀) := Γ(C.X i, ⊤)
  let f (i : C.I₀) : Spec (R i) ⟶ X₀.left := (C.X i).isoSpec.inv ≫ C.f i
  let φ (i : C.I₀) : CommRingCat.of D.k₀ ⟶ R i := Spec.preimage (f i ≫ X₀.hom)
  let algebra (i : C.I₀) : Algebra D.k₀ (R i) := (φ i).hom.toAlgebra
  let A (i : C.I₀) : CommAlgCat.{u} D.k₀ := CommAlgCat.of D.k₀ (R i)
  have hf (i) : Spec.map (CommRingCat.ofHom (algebraMap D.k₀ (A i))) =
      f i ≫ X₀.hom := Spec.map_preimage _
  let j (i) : model D (A i) ⟶ X₀ := Over.homMk (f i) (hf i).symm
  have ht (i : C.I₀) : Algebra.FiniteType D.k₀ (A i) ∧
      IsOpenImmersion (j i).left := by
    have : LocallyOfFiniteType (Spec.map (φ i)) := by
      rw [Spec.map_preimage]
      dsimp [f]
      infer_instance
    have ht : (φ i).hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp inferInstance
    refine ⟨(RingHom.finiteType_algebraMap).mp ht, ?_⟩
    change IsOpenImmersion ((C.X i).isoSpec.inv ≫ C.f i)
    infer_instance
  refine ⟨_, (fun i ↦ A (e.symm i)), (fun i ↦ j (e.symm i)),
    (fun i ↦ ht (e.symm i)), ?_⟩
  intro x
  apply (e.exists_congr_left (p := fun i ↦ x ∈ Set.range (j i).left)).mp
  obtain ⟨y, hy⟩ := C.covers x
  refine ⟨C.idx x, ?_⟩
  change ∃ z : Spec Γ(C.X (C.idx x), ⊤),
    C.f (C.idx x) ((C.X (C.idx x)).isoSpec.inv z) = x
  exact ⟨(C.X (C.idx x)).isoSpec.hom y, by simpa using hy⟩

/-- Tensor Frobenius and geometric Frobenius have compatible powers on an affine model. -/
private theorem tensorFrobenius_chart (D : FiniteFieldDatum.{u})
    (A : CommAlgCat.{u} D.k₀) [LocallyOfFiniteType (model D A).hom]
    [QuasiCompact (model D A).hom] (m : ℕ) :
    Spec.map (CommRingCat.ofHom (tensorFrobenius D A m).toRingHom) ≫
        (pullbackSpecIso D.k₀ A D.k).inv =
      (pullbackSpecIso D.k₀ A D.k).inv ≫ D.schemeFrobeniusIterate (model D A) m := by
  classical
  let : Fintype D.k₀ := Fintype.ofFinite D.k₀
  have : LocallyOfFiniteType
      (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ A)))).hom :=
    inferInstanceAs (LocallyOfFiniteType (model D A).hom)
  have hone : Spec.map (CommRingCat.ofHom (tensorFrobenius D A 1).toRingHom) ≫
      (pullbackSpecIso D.k₀ A D.k).inv =
      (pullbackSpecIso D.k₀ A D.k).inv ≫ D.schemeFrobenius (model D A) := by
    rw [← cancel_mono (pullbackSpecIso D.k₀ A D.k).hom]
    simpa [tensorFrobenius, schemeFrobenius, model, Category.assoc] using
      (D.relativeFrobenius_affine A).symm
  have hzero : tensorFrobenius D A 0 = AlgHom.id D.k₀ _ := by
    apply AlgHom.ext
    intro b
    induction b using TensorProduct.induction_on with
    | zero => simp
    | add b c hb hc => simp [map_add, hb, hc]
    | tmul a c => simp [tensorFrobenius_tmul]
  have hsucc (n : ℕ) : tensorFrobenius D A (n + 1) =
      (tensorFrobenius D A 1).comp (tensorFrobenius D A n) := by
    apply AlgHom.ext
    intro b
    induction b using TensorProduct.induction_on with
    | zero => simp
    | add b c hb hc => simp [map_add, hb, hc]
    | tmul a c => simp [tensorFrobenius_tmul, ← pow_mul, pow_succ, mul_comm]
  induction m with
  | zero =>
    change _ ≫ (pullbackSpecIso D.k₀ A D.k).inv =
      (pullbackSpecIso D.k₀ A D.k).inv ≫ 𝟙 _
    simp [hzero]
  | succ m ih =>
    have hs : Spec.map (CommRingCat.ofHom (tensorFrobenius D A (m + 1)).toRingHom) =
        Spec.map (CommRingCat.ofHom (tensorFrobenius D A 1).toRingHom) ≫
          Spec.map (CommRingCat.ofHom (tensorFrobenius D A m).toRingHom) := by
      rw [← Spec.map_comp, hsucc]
      rfl
    rw [hs, Category.assoc, ih, ← Category.assoc, hone, Category.assoc]
    simp only [schemeFrobeniusIterate, pow_succ, End.mul_def]

/-- Affine equalizers are spectra of the quotient by all endomorphism differences. -/
private theorem affine_fixed_iso (D : FiniteFieldDatum.{u})
    (X : Over (Spec (.of D.k))) (h : X ⟶ X) (R : CommRingCat.{u})
    (φ : R →+* R) (j : Spec R ⟶ X.left) [Mono j]
    (hc : Spec.map (CommRingCat.ofHom φ) ≫ j = j ≫ h.left) :
    ∃ e : pullback (WeilConjectures.trfEndomorphismFixedInclusion X h) j ≅
        Spec (.of (R ⧸ Ideal.span (Set.range (fun b ↦ φ b - b)))),
      e.hom ≫ Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (Ideal.span (Set.range (fun b ↦ φ b - b))))) =
          pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion X h) j := by
  let J : Ideal R := Ideal.span (Set.range (fun b ↦ φ b - b))
  let i := WeilConjectures.trfEndomorphismFixedInclusion X h
  let P := pullback i j
  let g : P ⟶ Spec R := pullback.snd i j
  let q : Spec (.of (R ⧸ J)) ⟶ Spec R :=
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
  have hi : Mono i := inferInstanceAs (Mono (pullback.fst _ _))
  have hg : g ≫ Spec.map (CommRingCat.ofHom φ) = g := by
    apply (cancel_mono j).mp
    rw [Category.assoc, hc, ← Category.assoc, ← pullback.condition]
    exact (WeilConjectures.trfEndomorphismFixedScheme_equalizer X h P
      (pullback.fst i j ≫ i)).1 (pullback.fst i j)
  have hJ : J ≤ RingHom.ker ((Scheme.ΓSpecIso R).inv ≫ g.appTop).hom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨b, rfl⟩
    have he := congrArg (fun f ↦ (Scheme.ΓSpecIso R).inv ≫ f.appTop) hg
    rw [Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality] at he
    have hb := congrArg (fun f : R ⟶ Γ(P, ⊤) ↦ f b) he
    change ((Scheme.ΓSpecIso R).inv ≫ g.appTop).hom (φ b - b) = 0
    rw [map_sub, sub_eq_zero]
    exact hb
  let a : P ⟶ Spec (.of (R ⧸ J)) := g.liftQuotient J hJ
  have ha : a ≫ q = g := g.liftQuotient_comp J hJ
  have hq : q ≫ Spec.map (CommRingCat.ofHom φ) = q := by
    rw [← Spec.map_comp]
    congr 1
    ext b
    apply Ideal.Quotient.eq.mpr
    exact Ideal.subset_span ⟨b, rfl⟩
  have ht : (q ≫ j) ≫ h.left = q ≫ j := by
    rw [Category.assoc, ← hc, ← Category.assoc, hq]
  obtain ⟨t, ht, _⟩ :=
    (WeilConjectures.trfEndomorphismFixedScheme_equalizer X h _ (q ≫ j)).2.mpr ht
  let b : Spec (.of (R ⧸ J)) ⟶ P := pullback.lift t q ht
  have hb : b ≫ g = q := pullback.lift_snd _ _ _
  refine ⟨⟨a, b, ?_, ?_⟩, ha⟩
  · apply (cancel_mono g).mp
    simp only [Category.assoc, hb, ha, Category.id_comp]
  · apply (cancel_mono q).mp
    rw [Category.assoc, ha, hb, Category.id_comp]

/-- Geometric part of the affine equalizer presentation.
The finite-type cover is obtained over the affine base from the finite-cover
characterization of finite type. Absolute Frobenius is the identity on the
underlying model space, so its iterate preserves every model open; base change
and the affine formula for scheme Frobenius give the stable chart map and the
q^m action on sections. On a stable affine chart, the second projection g of the
fixed-point pullback satisfies g ≫ Spec(φ) = g, so by the Γ-Spec adjunction it
kills every φ(b) - b and factors through Spec of the quotient by the difference
ideal. Conversely the quotient map is fixed by Frobenius and lifts to the
fixed-point pullback; cancelling the monomorphic projections to the chart shows
the two maps are inverse, giving the displayed spectrum isomorphism.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Step 0.
(blueprint: lem-trf-frobenius-affine-equalizer-presentation) -/
theorem geometry_helper (D : FiniteFieldDatum.{u}) (X₀ : Over (Spec (.of D.k₀)))
    [LocallyOfFiniteType X₀.hom] [QuasiCompact X₀.hom] (m : ℕ) (_hm : 1 ≤ m) :
    (∃ (n : ℕ) (A : Fin n → CommAlgCat.{u} D.k₀)
      (j : ∀ i, model D (A i) ⟶ X₀),
      (∀ i, Algebra.FiniteType D.k₀ (A i) ∧ IsOpenImmersion (j i).left) ∧
        (∀ x : X₀.left, ∃ i, x ∈ Set.range (j i).left)) ∧
    (∀ U : X₀.left.Opens,
      X₀.left.iterateFrobenius D.prime (D.model_characteristic X₀.hom) (D.a * m) ⁻¹ᵁ U = U) ∧
    ∃ h : D.geometricFiber X₀ ⟶ D.geometricFiber X₀,
      h.left = D.schemeFrobeniusIterate X₀ m ∧
      ∀ (A : CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀), IsOpenImmersion j.left →
        (Spec.map (CommRingCat.ofHom (tensorFrobenius D A m).toRingHom) ≫
            chartMap D X₀ A j = chartMap D X₀ A j ≫ h.left) ∧
        (h.left ⁻¹' Set.range (chartMap D X₀ A j) = Set.range (chartMap D X₀ A j)) ∧
        (∃ e : pullback (WeilConjectures.trfEndomorphismFixedInclusion
          (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅
          Spec (.of ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m)),
          e.hom ≫ Spec.map (CommRingCat.ofHom
            (Ideal.Quotient.mk (differenceIdeal D A m))) =
            pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
              (D.geometricFiber X₀) h) (chartMap D X₀ A j)) := by
  classical
  let b := Spec.map (CommRingCat.ofHom (algebraMap D.k₀ D.k))
  let B := Over.pullback b
  let Φ : End (pullback X₀.hom b) := D.schemeFrobenius X₀
  have hbase (n : ℕ) : (Φ ^ n) ≫ (D.geometricFiber X₀).hom =
      (D.geometricFiber X₀).hom := by
    induction n with
    | zero => simp [End.one_def]
    | succ n ih =>
      rw [pow_succ, End.mul_def, Category.assoc, ih]
      exact (D.relativeFrobenius_projections X₀).2
  let h : D.geometricFiber X₀ ⟶ D.geometricFiber X₀ := Over.homMk (Φ ^ m) (hbase m)
  refine ⟨finite_model_cover D X₀, (fun _ ↦ rfl), h, rfl, ?_⟩
  intro A j hj
  let : IsOpenImmersion j.left := hj
  have : LocallyOfFiniteType (model D A).hom := by
    rw [← j.w]
    infer_instance
  have : QuasiCompact (model D A).hom :=
    inferInstanceAs (QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ A))))
  let J : pullback (Spec.map (CommRingCat.ofHom (algebraMap D.k₀ A))) b ⟶
      pullback X₀.hom b := (B.map j).left
  have hJmap : J = pullback.map (model D A).hom b X₀.hom b
      j.left (𝟙 _) (𝟙 _) (by simp) (by simp) := by
    apply pullback.hom_ext <;> simp [J, B, Over.pullback_map_left]
  have : IsOpenImmersion J := by rw [hJmap]; infer_instance
  have hJrange : Set.range J = pullback.fst X₀.hom b ⁻¹' Set.range j.left := by
    rw [hJmap]
    have hr := Scheme.Pullback.range_map (model D A).hom b X₀.hom b
      j.left (𝟙 _) (𝟙 _) (by simp) (by simp)
    rw [show Set.range (𝟙 (Spec (.of D.k))) = Set.univ from
      Set.range_eq_univ.mpr (fun x ↦ ⟨x, rfl⟩), Set.preimage_univ, Set.inter_univ] at hr
    exact hr
  have : IsOpenImmersion (chartMap D X₀ A j) := by
    dsimp [chartMap]
    change IsOpenImmersion ((pullbackSpecIso D.k₀ A D.k).inv ≫ J)
    infer_instance
  have hcomm : Spec.map (CommRingCat.ofHom (tensorFrobenius D A m).toRingHom) ≫
      chartMap D X₀ A j = chartMap D X₀ A j ≫ h.left := by
    have hs := (D.frobenius_open_square (model D A) X₀ j m).1.w
    change D.schemeFrobeniusIterate (model D A) m ≫ J =
      J ≫ D.schemeFrobeniusIterate X₀ m at hs
    change _ ≫ ((pullbackSpecIso D.k₀ A D.k).inv ≫ J) =
      ((pullbackSpecIso D.k₀ A D.k).inv ≫ J) ≫ _
    rw [← Category.assoc, tensorFrobenius_chart, Category.assoc, hs, Category.assoc]
    rfl
  refine ⟨hcomm, ?_, affine_fixed_iso D (D.geometricFiber X₀) h
    (.of (A ⊗[D.k₀] D.k)) (tensorFrobenius D A m).toRingHom (chartMap D X₀ A j) hcomm⟩
  have hr : Set.range (chartMap D X₀ A j) =
      pullback.fst X₀.hom b ⁻¹' Set.range j.left := by
    change Set.range (fun x ↦ J ((pullbackSpecIso D.k₀ A D.k).inv x)) = _
    apply Eq.trans _ hJrange
    exact Function.Surjective.range_comp
      (show Function.Surjective (pullbackSpecIso D.k₀ A D.k).inv from
        (pullbackSpecIso D.k₀ A D.k).inv.homeomorph.surjective) J
  have hp (x : (pullback X₀.hom b : Scheme.{u})) :
      pullback.fst X₀.hom b (Φ.asHom x) = pullback.fst X₀.hom b x := by
    exact congrArg (fun f ↦ f x) (D.relativeFrobenius_projections X₀).1
  have hpow (n : ℕ) (x : (pullback X₀.hom b : Scheme.{u})) :
      pullback.fst X₀.hom b ((Φ ^ n).asHom x) = pullback.fst X₀.hom b x := by
    induction n generalizing x with
    | zero => rfl
    | succ n ih =>
      simp only [pow_succ, End.mul_def, Scheme.Hom.comp_apply]
      rw [ih, hp]
  rw [hr]
  ext x
  exact Iff.of_eq (congrArg (fun z ↦ z ∈ Set.range j.left) (hpow m x))


/-- Coordinate and restriction part of the affine equalizer presentation.
For a polynomial presentation, coefficient extension and the tensor universal
property construct the scalar-extended polynomial quotient equivalence. Pure
tensors determine it, and the polynomial universal property transports the
Frobenius difference generators to the coordinate power generators. Quotient
operations then induce the displayed quotient ring equivalence and its spectrum
map. For a smaller model chart, the tensor map descends through the two
transported ideals; the pullback universal property gives the comparison map
and its projection and coherence equations.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Step 1.
(blueprint: lem-trf-frobenius-affine-equalizer-presentation) -/
theorem algebra_helper (D : FiniteFieldDatum.{u})
    (X₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType X₀.hom]
    [QuasiCompact X₀.hom] (m : ℕ) (_hm : 1 ≤ m)
    (h : D.geometricFiber X₀ ⟶ D.geometricFiber X₀)
    (A : CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀) (hj : IsOpenImmersion j.left)
    (e : pullback (WeilConjectures.trfEndomorphismFixedInclusion
      (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅
      Spec (.of ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m)))
    (he : e.hom ≫ Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (differenceIdeal D A m))) =
      pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
        (D.geometricFiber X₀) h) (chartMap D X₀ A j)) :
    (∀ (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀))
      (p : (MvPolynomial (Fin r) D.k₀ ⧸ a) ≃ₐ[D.k₀] A),
      ∃ θ : (A ⊗[D.k₀] D.k) ≃+*
        (MvPolynomial (Fin r) D.k ⧸ extendedIdeal D r a),
        (∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
          θ (p (Ideal.Quotient.mk a f) ⊗ₜ c) =
            Ideal.Quotient.mk (extendedIdeal D r a)
              (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c)) ∧
        (differenceIdeal D A m).map θ.toRingHom =
          (powerIdeal D m r).map (Ideal.Quotient.mk (extendedIdeal D r a)) ∧
        ∃ ν : ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m) ≃+*
          (MvPolynomial (Fin r) D.k ⧸ (extendedIdeal D r a ⊔ powerIdeal D m r)),
          (∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
            ν (Ideal.Quotient.mk (differenceIdeal D A m)
              (p (Ideal.Quotient.mk a f) ⊗ₜ c)) =
              Ideal.Quotient.mk (extendedIdeal D r a ⊔ powerIdeal D m r)
                (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c)) ∧
          (∃ ep : pullback (WeilConjectures.trfEndomorphismFixedInclusion
            (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅
            Spec (.of (MvPolynomial (Fin r) D.k ⧸
              (extendedIdeal D r a ⊔ powerIdeal D m r))),
            ep.hom = e.hom ≫ Spec.map (CommRingCat.ofHom ν.symm.toRingHom))) ∧
          (∀ (A' : CommAlgCat.{u} D.k₀) (j' : model D A' ⟶ X₀)
            (f : A →ₐ[D.k₀] A'), IsOpenImmersion j'.left →
            Spec.map (CommRingCat.ofHom f.toRingHom) ≫ j.left = j'.left →
            ∀ e' : pullback (WeilConjectures.trfEndomorphismFixedInclusion
              (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ≅
              Spec (.of ((A' ⊗[D.k₀] D.k) ⧸ differenceIdeal D A' m)),
            e'.hom ≫ Spec.map (CommRingCat.ofHom
              (Ideal.Quotient.mk (differenceIdeal D A' m))) =
              pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
                (D.geometricFiber X₀) h) (chartMap D X₀ A' j') →
            ∃ ρ : ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m) →+*
              ((A' ⊗[D.k₀] D.k) ⧸ differenceIdeal D A' m),
              (∀ b : A ⊗[D.k₀] D.k,
                ρ (Ideal.Quotient.mk (differenceIdeal D A m) b) =
                  Ideal.Quotient.mk (differenceIdeal D A' m)
                    (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k) b)) ∧
              ∃ s : pullback (WeilConjectures.trfEndomorphismFixedInclusion
                (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ⟶
                pullback (WeilConjectures.trfEndomorphismFixedInclusion
                  (D.geometricFiber X₀) h) (chartMap D X₀ A j),
                s ≫ pullback.fst (WeilConjectures.trfEndomorphismFixedInclusion
                  (D.geometricFiber X₀) h) (chartMap D X₀ A j) =
                  pullback.fst (WeilConjectures.trfEndomorphismFixedInclusion
                    (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ∧
                s ≫ pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
                  (D.geometricFiber X₀) h) (chartMap D X₀ A j) =
                  pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion
                    (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ≫
                    Spec.map (CommRingCat.ofHom
                      (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)).toRingHom) ∧
                s ≫ e.hom = e'.hom ≫ Spec.map (CommRingCat.ofHom ρ)) := by
  classical
  cases hj
  constructor
  · intro r a p
    obtain ⟨θ, hθ⟩ := polynomial_tensor_equiv D A r a p
    have hI := differenceIdeal_polynomial D A m r a p θ hθ
    let ν := (Ideal.quotientEquiv (differenceIdeal D A m)
      ((powerIdeal D m r).map (Ideal.Quotient.mk (extendedIdeal D r a))) θ hI.symm).trans
        (DoubleQuot.quotQuotEquivQuotSup (extendedIdeal D r a) (powerIdeal D m r))
    refine ⟨θ, hθ, hI, ν, ?_, ?_⟩
    · intro f c
      change DoubleQuot.quotQuotEquivQuotSup _ _
        (Ideal.Quotient.mk _ (θ (p (Ideal.Quotient.mk a f) ⊗ₜ c))) = _
      rw [hθ]
      exact DoubleQuot.quotQuotEquivQuotSup_quotQuotMk _ _ _
    · exact ⟨e ≪≫ Scheme.Spec.mapIso ν.toCommRingCatIso.symm.op, rfl⟩
  · intro A' j' f _hj' hf e' he'
    let T := Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k)
    let ρ := Ideal.quotientMap (differenceIdeal D A' m) T.toRingHom
      (differenceIdeal_natural D A A' m f)
    have hρ : Spec.map (CommRingCat.ofHom ρ) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (differenceIdeal D A m))) =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (differenceIdeal D A' m))) ≫
        Spec.map (CommRingCat.ofHom T.toRingHom) := by
      rw [← Spec.map_comp, ← Spec.map_comp]
      congr 1
    let s := e'.hom ≫ Spec.map (CommRingCat.ofHom ρ) ≫ e.inv
    have hs : s ≫ e.hom = e'.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
      simp [s]
    have hsnd : s ≫ pullback.snd _ _ =
        pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom T.toRingHom) := by
      rw [← he, ← Category.assoc, hs, Category.assoc, hρ, ← Category.assoc, he']
    refine ⟨ρ, (fun b ↦ rfl), s, ?_, hsnd, hs⟩
    have : Mono (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) :=
      inferInstanceAs (Mono (pullback.fst _ _))
    apply (cancel_mono
      (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h)).mp
    rw [Category.assoc, pullback.condition, ← Category.assoc, hsnd, Category.assoc,
      chartMap_natural D X₀ A A' j j' f hf, ← pullback.condition]

/-- Finite stable model affines and the canonical Frobenius equalizer presentation.
Source: latest blueprint, thm-trf-frobenius-fixed-points.proof.md, Steps 0–1
(blueprint: lem-trf-frobenius-affine-equalizer-presentation).

Proof:
1. Apply the finite-cover characterization of `def-weil-finite-type-morphism` over
   Spec k₀ to obtain finitely many affine charts with finitely generated algebras.
2. `def-weil-absolute-frobenius-scheme` is identity on the model's underlying space.
   Its m-th q-power iterate preserves all opens. Base change and the affine formula of
   `def-trf-scheme-frobenius` give a ⊗ c ↦ a^(q^m) ⊗ c. The multiplication and unit
   are those of `lem-weil-pbc-algebra-tensor-pushout-universal-property`; the geometric
   chart identification is `lem-weil-pbc-fibre-product-affine-spectra`.
3. For a presentation k₀[t]/a ≃ A, coefficient extension sends a into a_k. The tensor
   universal property gives θ(a ⊗ c) = a_k c. Conversely evaluate at [tᵢ] ⊗ 1;
   the relations vanish, so evaluation descends. Both composites fix the coordinates
   and the scalars, and hence are identities by `def-weil-pbc-mv-polynomial-ring`.
   Pure tensors span by `def-weil-pbc-module-tensor-product`.
4. Maps to Spec(B/J) are ring maps killing all φ(b)-b, equivalently maps equalizing
   φ and the identity. The natural affine adjunction
   `lem-a1-locally-ringed-space-affine-adjunction` identifies these with fixed maps
   into the stable chart. The two pullback universal properties `def-pc-fibre-product`
   give precisely the same maps into F ×_X U. Yoneda iso detection
   `lem-coef-joyal-homset-iso-detection` gives e, over U via Spec of the quotient map.
5. The coordinate power differences lie in J. Conversely, modulo their ideal the
   two k-algebra maps induced by φ and the identity agree on scalars and coordinates,
   so polynomial universality makes them equal. Thus J is exactly that ideal.
   Equivalently expand a polynomial and telescope each monomial difference; its
   factors u^n-v^n are divisible by u-v. No assertion c^(q^m)=c for c in k is used.
6. Lifting the finitely many multipliers of the coordinate differences shows that
   the composite k[t] → B/J has kernel a_k plus the power ideal. The maps [f] ↦ [[f]]
   and [[f]] ↦ [f] give ν, and contravariant `def-weil-affine-spectrum` gives ep.
7. A smaller model affine is stable too. Both restricted pullbacks represent fixed
   maps into that smaller affine. Their universal identifications therefore agree:
   the induced tensor map descends to ρ, and s is characterized by both projections.
   The equation s ≫ e.hom = e'.hom ≫ Spec ρ is this uniqueness. No separatedness,
   principal-open hypothesis or affine-intersection hypothesis is used. -/
theorem presentation (D : FiniteFieldDatum.{u}) (X₀ : Over (Spec (.of D.k₀))) [LocallyOfFiniteType
    X₀.hom] [QuasiCompact X₀.hom] (m : ℕ) (_hm : 1 ≤ m) : (∃ (n : ℕ) (A : Fin n → CommAlgCat.{u}
    D.k₀) (j : ∀ i, model D (A i) ⟶ X₀), (∀ i, Algebra.FiniteType D.k₀ (A i) ∧ IsOpenImmersion (j
    i).left) ∧ (∀ x : X₀.left, ∃ i, x ∈ Set.range (j i).left)) ∧ (∀ U : X₀.left.Opens,
    X₀.left.iterateFrobenius D.prime (D.model_characteristic X₀.hom) (D.a * m) ⁻¹ᵁ U = U) ∧ ∃ h :
    D.geometricFiber X₀ ⟶ D.geometricFiber X₀, h.left = D.schemeFrobeniusIterate X₀ m ∧ ∀ (A :
    CommAlgCat.{u} D.k₀) (j : model D A ⟶ X₀), IsOpenImmersion j.left → (∀ a : A, ∀ c : D.k,
    tensorFrobenius D A m (a ⊗ₜ c) = (a ^ (D.q ^ m)) ⊗ₜ c) ∧ (Spec.map (CommRingCat.ofHom
    (tensorFrobenius D A m).toRingHom) ≫ chartMap D X₀ A j = chartMap D X₀ A j ≫ h.left) ∧ (h.left
    ⁻¹' Set.range (chartMap D X₀ A j) = Set.range (chartMap D X₀ A j)) ∧ ∃ e : pullback
    (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅
    Spec (.of ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m)), e.hom ≫ Spec.map (CommRingCat.ofHom
    (Ideal.Quotient.mk (differenceIdeal D A m))) = pullback.snd
    (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀ A j) ∧ (∀
    (r : ℕ) (a : Ideal (MvPolynomial (Fin r) D.k₀)) (p : (MvPolynomial (Fin r) D.k₀ ⧸ a) ≃ₐ[D.k₀]
    A), ∃ θ : (A ⊗[D.k₀] D.k) ≃+* (MvPolynomial (Fin r) D.k ⧸ extendedIdeal D r a), (∀ f :
    MvPolynomial (Fin r) D.k₀, ∀ c : D.k, θ (p (Ideal.Quotient.mk a f) ⊗ₜ c) = Ideal.Quotient.mk
    (extendedIdeal D r a) (MvPolynomial.map (algebraMap D.k₀ D.k) f * MvPolynomial.C c)) ∧
    (differenceIdeal D A m).map θ.toRingHom = (powerIdeal D m r).map (Ideal.Quotient.mk
    (extendedIdeal D r a)) ∧ ∃ ν : ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m) ≃+* (MvPolynomial (Fin
    r) D.k ⧸ (extendedIdeal D r a ⊔ powerIdeal D m r)), (∀ f : MvPolynomial (Fin r) D.k₀, ∀ c : D.k,
    ν (Ideal.Quotient.mk (differenceIdeal D A m) (p (Ideal.Quotient.mk a f) ⊗ₜ c)) =
    Ideal.Quotient.mk (extendedIdeal D r a ⊔ powerIdeal D m r) (MvPolynomial.map (algebraMap D.k₀
    D.k) f * MvPolynomial.C c)) ∧ ∃ ep : pullback (WeilConjectures.trfEndomorphismFixedInclusion
    (D.geometricFiber X₀) h) (chartMap D X₀ A j) ≅ Spec (.of (MvPolynomial (Fin r) D.k ⧸
    (extendedIdeal D r a ⊔ powerIdeal D m r))), ep.hom = e.hom ≫ Spec.map (CommRingCat.ofHom
    ν.symm.toRingHom)) ∧ (∀ (A' : CommAlgCat.{u} D.k₀) (j' : model D A' ⟶ X₀) (f : A →ₐ[D.k₀] A'),
    IsOpenImmersion j'.left → Spec.map (CommRingCat.ofHom f.toRingHom) ≫ j.left = j'.left → ∀ e' :
    pullback (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀
    A' j') ≅ Spec (.of ((A' ⊗[D.k₀] D.k) ⧸ differenceIdeal D A' m)), e'.hom ≫ Spec.map
    (CommRingCat.ofHom (Ideal.Quotient.mk (differenceIdeal D A' m))) = pullback.snd
    (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀ A' j') →
    ∃ ρ : ((A ⊗[D.k₀] D.k) ⧸ differenceIdeal D A m) →+* ((A' ⊗[D.k₀] D.k) ⧸ differenceIdeal D A' m),
    (∀ b : A ⊗[D.k₀] D.k, ρ (Ideal.Quotient.mk (differenceIdeal D A m) b) = Ideal.Quotient.mk
    (differenceIdeal D A' m) (Algebra.TensorProduct.map f (AlgHom.id D.k₀ D.k) b)) ∧ ∃ s : pullback
    (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ⟶
    pullback (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀
    A j), s ≫ pullback.fst (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h)
    (chartMap D X₀ A j) = pullback.fst (WeilConjectures.trfEndomorphismFixedInclusion
    (D.geometricFiber X₀) h) (chartMap D X₀ A' j') ∧ s ≫ pullback.snd
    (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D X₀ A j) =
    pullback.snd (WeilConjectures.trfEndomorphismFixedInclusion (D.geometricFiber X₀) h) (chartMap D
    X₀ A' j') ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.map f (AlgHom.id D.k₀
    D.k)).toRingHom) ∧ s ≫ e.hom = e'.hom ≫ Spec.map (CommRingCat.ofHom ρ)) := by
  rcases geometry_helper D X₀ m _hm with ⟨hc, hs, h, hh, hall⟩
  refine ⟨hc, hs, h, hh, ?_⟩
  intro A j hj
  rcases hall A j hj with ⟨hcj, hr, e, he⟩
  refine ⟨?_, hcj, hr, e, he, ?_⟩
  · intro a c
    exact tensorFrobenius_tmul D A m a c
  · exact algebra_helper D X₀ m _hm h A j hj e he

end WeilConjectures.FiniteFieldDatum.FrobeniusAffineEqualizer
