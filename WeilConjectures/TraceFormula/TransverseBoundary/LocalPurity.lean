module

public import WeilConjectures.TraceFormula.TransverseBoundary.Basic
public import WeilConjectures.AlgebraicGeometry.Sites.Kummer
public import WeilConjectures.AlgebraicGeometry.Sites.StrictHenselization

/-!
# Local purity for a regular divisor of an étale limit of smooth surfaces

Let `Z` be an étale limit with affine transition maps of smooth surfaces over an algebraically
closed field `k` (`AlgebraicGeometry.Scheme.IsEtaleLimitOfSmoothSurfaces`), `i : D ⟶ Z` a regular
divisor with `D` regular, `j : U ⟶ Z` its open complement, `ℓ` a prime invertible in `k`, and
`ybar` a geometric point of `Z` lying on `D`. Let `S = Z_(ybar)` be the strict localization and
`P = U ×_Z S = S - D_S`. Then

* `H^q(P, ℤ/ℓ) = 0` for `q ≥ 2`, and `H⁰(P, ℤ/ℓ) ≅ H¹(P, ℤ/ℓ) ≅ ℤ/ℓ`;
* `H¹(P, μ_ℓ)` is generated by the Kummer class of a local equation `t` of `D`: the map
  `ℤ/ℓ ⟶ H¹(P, μ_ℓ)`, `1 ↦ δ₀(t)`, is bijective

(blueprint `det-tf-transverse-corner-constant`, *the surface*).

*Proof.* Near the image of `ybar`, purity on a smooth chart computes the direct images
`R^q j_* ℤ/ℓ`: `ℤ/ℓ` in degree `0`, `i_* ℤ/ℓ(-1)` in degree `1`, and `0` above
(`AlgebraicGeometry.Scheme.exists_higherDirectImage_of_isEtaleLimitOfSmoothSurfaces`). Base change
to the strictly local scheme `S` and its exact global sections give
`H^q(P, ℤ/ℓ) = Γ(S, R^q j_* ℤ/ℓ |_S)`
(`AlgebraicGeometry.Etale.nonempty_addEquiv_sheafH_constantZMod_of_isPullback_strictLocalization`),
which is `ℤ/ℓ`, `Γ(D_S, ℤ/ℓ) = ℤ/ℓ`, `0`. Finally `t` is a prime element of the noetherian
local domain `Γ(S, 𝒪)` and `P = Spec Γ(S, 𝒪)[1/t]`, so `t` is not an `ℓ`-th power on `P` and its
Kummer class is a nonzero element of the group `H¹(P, μ_ℓ) ≅ ℤ/ℓ` of prime order.

## Main statements

- `AlgebraicGeometry.Scheme.subsingleton_sheafH_pullback_strictLocalizationToBase`
- `AlgebraicGeometry.Scheme.nonempty_addEquiv_sheafH_pullback_strictLocalizationToBase`
- `AlgebraicGeometry.Scheme.bijective_nsmul_kummerδ₀_pullback_strictLocalizationToBase`
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

variable {k : Type u} [Field k] [IsAlgClosed k] {Z D U : Scheme.{u}} (aZ : Z ⟶ Spec (.of k))
  (hZ : IsEtaleLimitOfSmoothSurfaces aZ) [IsLocallyNoetherian Z] [IsRegular Z] (iD : D ⟶ Z)
  [IsRegularImmersion 1 iD] [IsRegular D] (j : U ⟶ Z) [IsOpenImmersion j]
  (hj : Set.range j = (Set.range iD)ᶜ) {ℓ : ℕ} [Fact ℓ.Prime] (hℓ : (ℓ : k) ≠ 0)
  {Ω : Type u} [Field Ω] [IsSepClosed Ω] (ybar : Spec (.of Ω) ⟶ Z)
  (hy : Set.range ybar ⊆ Set.range iD)

include hZ hj hℓ hy

/-- Blueprint `det-tf-transverse-corner-constant`: for a geometric point `ybar` on a regular
divisor `D` of an étale limit of smooth surfaces, `H^q(S - D_S, ℤ/ℓ) = 0` for `q ≥ 2`, where
`S = Z_(ybar)`. -/
theorem subsingleton_sheafH_pullback_strictLocalizationToBase (q : ℕ) (hq : 2 ≤ q) :
    Subsingleton (Sheaf.H ((pullback j (strictLocalizationToBase ybar)).constantZMod ℓ) q) := by
  sorry

/-- Blueprint `det-tf-transverse-corner-constant`: for a geometric point `ybar` on a regular
divisor `D` of an étale limit of smooth surfaces, `H⁰(S - D_S, ℤ/ℓ)` and
`H¹(S - D_S, ℤ/ℓ) ≅ 𝔽_ℓ(-1)` are free of rank one over `𝔽_ℓ`, where `S = Z_(ybar)`. -/
theorem nonempty_addEquiv_sheafH_pullback_strictLocalizationToBase (q : ℕ) (hq : q ≤ 1) :
    Nonempty (Sheaf.H ((pullback j (strictLocalizationToBase ybar)).constantZMod ℓ) q ≃+
      ZMod ℓ) := by
  sorry

/-- Blueprint `det-tf-transverse-corner-constant`: the Kummer class of a local equation
generates `H¹(S - D_S, μ_ℓ)`. Let `t` be a function on an affine open `V` of `Z` containing the
image of `ybar` which generates the ideal of `D` on `V`, and `tP` its pullback to
`P = S - D_S`, a unit (through any factorization `φ : P ⟶ V` of `P ⟶ Z`). Then
`ℤ/ℓ ⟶ H¹(P, μ_ℓ)`, `a ↦ a • δ₀(tP)`, is bijective. -/
theorem bijective_nsmul_kummerδ₀_pullback_strictLocalizationToBase (V : Z.affineOpens)
    (hyV : Set.range ybar ⊆ (V : Set Z)) (t : Γ(Z, V))
    (ht : (Scheme.Hom.ker iD).ideal V = Ideal.span {t})
    (φ : pullback j (strictLocalizationToBase ybar) ⟶ V.1.toScheme)
    (hφ : φ ≫ V.1.ι = pullback.fst j (strictLocalizationToBase ybar) ≫ j)
    (tP : Γ(pullback j (strictLocalizationToBase ybar), ⊤)ˣ)
    (htP : (tP : Γ(pullback j (strictLocalizationToBase ybar), ⊤)) = φ.appTop (V.1.topIso.inv t))
    (hℓP : IsUnit (ℓ : Γ(pullback j (strictLocalizationToBase ybar), ⊤))) :
    Function.Bijective (fun a : ZMod ℓ ↦
      a.val • (pullback j (strictLocalizationToBase ybar)).kummerδ₀ ℓ hℓP (Additive.ofMul tP)) := by
  sorry

end AlgebraicGeometry.Scheme
