module

public import Mathlib.AlgebraicGeometry.AffineTransitionLimit
public import WeilConjectures.AlgebraicGeometry.Morphisms.RegularImmersion
public import WeilConjectures.AlgebraicGeometry.Regular
public import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Local charts of regular divisors on limits of schemes

Let `Z` be the limit of a cofiltered diagram `E` of schemes with affine transition maps, `Z`
regular and locally noetherian, and `i : D ⟶ Z` a regular divisor with `D` regular. Near a point
`y` of `D`, a local equation of `D` comes from a function `t` on an affine open `V` of some
stage `Eᵢ`: on `πᵢ⁻¹(V)` the divisor `D` is the zero locus of `πᵢ^* t`, and the germ of `t` at
`πᵢ(y)` lies in `𝔪 \ 𝔪²` because its image in the regular local ring `𝒪_{Z,y}` does, the
quotient `𝒪_{Z,y}/(t) = 𝒪_{D,y}` being regular.

This is the *local chart* of blueprint `lemma-punctured-surface-punctured-curve--1` for an étale
limit of smooth surfaces.

## Main statements

- `IsRegularLocalRing.notMem_maximalIdeal_sq_of_isRegularLocalRing_quotient`
- `AlgebraicGeometry.exists_appLE_π_eq_of_isLimit`
- `AlgebraicGeometry.Scheme.exists_isLimit_chart`
-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing

/-- A nonzero element `x` of the maximal ideal of a regular local ring `R` with `R ⧸ (x)` regular
does not lie in `𝔪²`: by `IsRegularLocalRing.exists_span_eq_of_isRegularLocalRing_quotient` the
ideal `(x)` is generated by elements independent in `𝔪 / 𝔪²`, and if `x ∈ 𝔪²` they all vanish
there, so `(x) = 0`. Used for the local chart of blueprint
`lemma-punctured-surface-punctured-curve--1`. -/
theorem IsRegularLocalRing.notMem_maximalIdeal_sq_of_isRegularLocalRing_quotient {R : Type u}
    [CommRing R] [IsRegularLocalRing R] {x : R} (hx : x ∈ maximalIdeal R) (hx₀ : x ≠ 0)
    [IsRegularLocalRing (R ⧸ Ideal.span {x})] :
    x ∉ maximalIdeal R ^ 2 := by
  obtain ⟨s, -, hspan, hli⟩ := exists_span_eq_of_isRegularLocalRing_quotient (Ideal.span {x})
    ((Ideal.span_singleton_le_iff_mem _).mpr hx)
  intro hx₂
  have hs : s = ∅ := by
    rw [Set.eq_empty_iff_forall_notMem]
    intro a ha
    apply hli.ne_zero ha
    rw [Ideal.toCotangent_eq_zero]
    exact (Ideal.span_singleton_le_iff_mem _).mpr hx₂ (hspan ▸ Ideal.subset_span ⟨a, ha, rfl⟩)
  rw [hs, Set.image_empty, Ideal.span_empty, eq_comm, Ideal.span_singleton_eq_bot] at hspan
  exact hx₀ hspan

namespace AlgebraicGeometry

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
open Scheme.Opens in
/-- **Functions on an affine preimage descend to a stage** (used for the local chart of
blueprint `lemma-punctured-surface-punctured-curve--1`). For a limit cone `c` of a cofiltered
diagram `D` with affine transition maps and an affine open `V` of `D_i`, every function on
`π_i⁻¹(V)` is the pullback of a function on `D(j ⟶ i)⁻¹(V)` for some `j ⟶ i`. -/
theorem exists_appLE_π_eq_of_isLimit {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) [∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)] (c : Cone D)
    (hc : IsLimit c) {i : I} {V : (D.obj i).Opens} (hV : IsAffineOpen V)
    (r : Γ(c.pt, c.π.app i ⁻¹ᵁ V)) :
    ∃ (j : I) (fji : j ⟶ i) (s : Γ(D.obj j, D.map fji ⁻¹ᵁ V))
      (h : c.π.app i ⁻¹ᵁ V ≤ c.π.app j ⁻¹ᵁ D.map fji ⁻¹ᵁ V),
      (c.π.app j).appLE _ _ h s = r := by
  have (j : _) : IsAffine ((opensDiagram D i V).op.obj j).unop := hV.preimage _
  have (j : _) : IsAffine ((opensDiagram D i V).obj j) := hV.preimage _
  obtain ⟨⟨j⟩, s, hs⟩ := (Types.jointly_surjective_of_isColimit (isColimitOfPreserves
    (Scheme.Γ ⋙ forget _) (isLimitOpensCone D c hc i V).op) ((c.π.app i ⁻¹ᵁ V).topIso.inv r))
  obtain ⟨s, rfl⟩ := (D.map j.hom ⁻¹ᵁ V).topIso.symm.commRingCatIsoToRingEquiv.surjective s
  have h : c.π.app j.left ⁻¹ᵁ D.map j.hom ⁻¹ᵁ V = c.π.app i ⁻¹ᵁ V := congr($(c.w j.hom) ⁻¹ᵁ V)
  refine ⟨j.left, j.hom, s, h.ge, ?_⟩
  symm
  convert!
    show r = ((topIso _).inv ≫ ((opensCone D c i V).π.app j).appTop ≫ (topIso _).hom) s from
      (c.π.app i ⁻¹ᵁ V).topIso.commRingCatIsoToRingEquiv.symm_apply_eq.mp hs.symm using 3
  simp [Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE]

end AlgebraicGeometry

namespace AlgebraicGeometry.Scheme

/-- **Local charts of a regular divisor on a limit** (blueprint
`lemma-punctured-surface-punctured-curve--1`). Let `c` be a limit cone of a cofiltered diagram `E`
of schemes with affine transition maps, with `c.pt` regular and locally noetherian, and
`i : D ⟶ c.pt` a regular closed immersion of codimension one with `D` regular. For every point
`y` of `D` there are a stage `j`, an open `V` of `E_j` containing `π_j(y)` and a function `t` on
`V` such that

* on `π_j⁻¹(V)` the support of `D` is the inverse image of the zero locus of `t`;
* the germ of `t` at `π_j(y)` lies in the maximal ideal but not in its square. -/
theorem exists_isLimit_chart {I : Type u} [SmallCategory I] [IsCofiltered I]
    (E : I ⥤ Scheme.{u}) [∀ {i j : I} (f : i ⟶ j), IsAffineHom (E.map f)] (c : Cone E)
    (hc : IsLimit c) [IsLocallyNoetherian c.pt] [IsRegular c.pt] {D : Scheme.{u}}
    (iD : D ⟶ c.pt) [IsRegularImmersion 1 iD] [IsRegular D] (y : c.pt)
    (hy : y ∈ Set.range iD) :
    ∃ (j : I) (V : (E.obj j).Opens) (t : Γ(E.obj j, V)) (hyV : c.π.app j y ∈ V),
      (∀ z : c.pt, c.π.app j z ∈ V →
        (z ∈ Set.range iD ↔ c.π.app j z ∉ (E.obj j).basicOpen t)) ∧
      (E.obj j).presheaf.germ V _ hyV t ∈
        IsLocalRing.maximalIdeal ((E.obj j).presheaf.stalk (c.π.app j y)) ∧
      (E.obj j).presheaf.germ V _ hyV t ∉
        IsLocalRing.maximalIdeal ((E.obj j).presheaf.stalk (c.π.app j y)) ^ 2 := by
  obtain ⟨x, rfl⟩ := hy
  obtain ⟨A, hxA, r, hr, hreg, hI⟩ :=
    IsRegularImmersion.exists_isWeaklyRegular_generators (c := 1) (i := iD) (iD x)
  obtain ⟨f, rfl⟩ := List.length_eq_one_iff.mp hr
  rw [Ideal.ofList_singleton] at hI
  obtain ⟨_, ⟨i, V', hV', rfl⟩, hxV', hV'A⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp (isBasis_preimage_isAffineOpen E c hc) hxA
  obtain ⟨j, fji, t, h, ht⟩ := exists_appLE_π_eq_of_isLimit E c hc hV'
    (c.pt.presheaf.map (homOfLE hV'A).op f)
  have hV (z : c.pt) : c.π.app j z ∈ E.map fji ⁻¹ᵁ V' ↔ z ∈ c.π.app i ⁻¹ᵁ V' :=
    SetLike.ext_iff.mp congr($(c.w fji) ⁻¹ᵁ V') z
  -- the stalk maps of `π_j` send the germs of `t` to the germs of `f`
  have hgerm (z : c.pt) (hz : z ∈ c.π.app i ⁻¹ᵁ V') :
      (c.π.app j).stalkMap z ((E.obj j).presheaf.germ _ _ ((hV z).mpr hz) t) =
        c.pt.presheaf.germ A z (hV'A hz) f := by
    rw [Hom.germ_stalkMap_apply]
    exact (c.pt.presheaf.germ_res_apply (homOfLE h) z hz _).symm.trans
      (congr(c.pt.presheaf.germ _ z hz $ht).trans (c.pt.presheaf.germ_res_apply _ z hz f))
  have hbasic (z : c.pt) (hz : z ∈ c.π.app i ⁻¹ᵁ V') :
      c.π.app j z ∈ (E.obj j).basicOpen t ↔ z ∈ c.pt.basicOpen f := by
    rw [mem_basicOpen _ _ _ ((hV z).mpr hz), mem_basicOpen _ _ _ (hV'A hz), ← hgerm z hz]
    exact (isUnit_map_iff _ _).symm
  have hsupp (z : c.pt) (hz : z ∈ A.1) : z ∈ Set.range iD ↔ z ∉ c.pt.basicOpen f := by
    rw [← iD.isClosedEmbedding.isClosed_range.closure_eq, ← Hom.support_ker]
    refine (IdealSheafData.mem_support_iff_of_mem hz).trans ?_
    rw [← hI, zeroLocus_span, zeroLocus_singleton]
    rfl
  refine ⟨j, E.map fji ⁻¹ᵁ V', t, (hV _).mpr hxV', fun z hz ↦ ?_, ?_⟩
  · rw [hsupp z (hV'A ((hV z).mp hz)), hbasic z ((hV z).mp hz)]
  -- the germ `g` of `f` at `y` lies in `𝔪_y \ 𝔪_y²`
  set R := c.pt.presheaf.stalk (iD x)
  set g := c.pt.presheaf.germ A (iD x) hxA f
  have hg : g ∈ maximalIdeal R := by
    rw [mem_maximalIdeal, mem_nonunits_iff, ← mem_basicOpen]
    exact (hsupp _ hxA).mp ⟨x, rfl⟩
  have hg₀ : g ≠ 0 := by
    let := c.pt.presheaf.algebra_section_stalk ⟨iD x, hxA⟩
    have := A.2.isLocalization_stalk ⟨iD x, hxA⟩
    have : Module.Flat Γ(c.pt, A.1) R :=
      IsLocalization.flat _ (A.2.primeIdealOf ⟨iD x, hxA⟩).asIdeal.primeCompl
    have hreg' := hreg.of_flat (S := R)
    rw [List.map_singleton, RingTheory.Sequence.isWeaklyRegular_singleton_iff] at hreg'
    intro hg₀
    refine one_ne_zero (hreg' (a₁ := (1 : R)) (a₂ := 0) ?_)
    simp only [smul_eq_mul, mul_one, mul_zero]
    exact hg₀
  have hker : Ideal.span {g} = RingHom.ker (iD.stalkMap x).hom := by
    rw [iD.ker_stalkMap A x hxA, ← hI, Ideal.map_span, Set.image_singleton]
  have : IsRegularLocalRing (R ⧸ Ideal.span {g}) := by
    rw [hker]
    exact .of_ringEquiv (RingHom.quotientKerEquivOfSurjective (iD.stalkMap_surjective x)).symm
  have hg₂ := IsRegularLocalRing.notMem_maximalIdeal_sq_of_isRegularLocalRing_quotient hg hg₀
  -- the stalk map of `π_j` at `y` is local and sends the germ of `t` to `g`
  have hφ : (c.π.app j).stalkMap (iD x) ((E.obj j).presheaf.germ _ _ ((hV _).mpr hxV') t) = g :=
    hgerm _ hxV'
  rw [← hφ] at hg hg₂
  refine ⟨?_, fun ht₂ ↦ hg₂ ?_⟩
  · rw [mem_maximalIdeal, mem_nonunits_iff] at hg ⊢
    exact fun hu ↦ hg (hu.map _)
  · refine Ideal.pow_right_mono (map_maximalIdeal_le ((c.π.app j).stalkMap (iD x)).hom) 2 ?_
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ ht₂

end AlgebraicGeometry.Scheme
