module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import WeilConjectures.Mathlib.Algebra.MvPolynomial.Expand
public import WeilConjectures.Mathlib.FieldTheory.Finite.Polynomial
public import WeilConjectures.Mathlib.LinearAlgebra.Lagrange

/-!
# The algebra of the Frobenius fixed points

Let `F` be a finite field with `Q` elements (for instance `𝔽_{q^m}`) and `L` an `F`-algebra
(for instance an algebraically closed field `k ⊇ 𝔽_{q^m}`, in which the image of `F` is the set of
roots of `t^Q - t`). Evaluation at the points `λ ∈ F^σ` identifies
`L[t_i]_{i ∈ σ} / (t_i^Q - t_i)_i` with the product `∏_{λ ∈ F^σ} L`, and its quotient by an ideal
`𝔞 L[t]` with the product over the zeros `λ ∈ F^σ` of `𝔞` (blueprint
`det-tf-fixed-point-algebra`). For an ideal `𝔞 ⊆ k₀[t]` over a finite field `k₀` with `q`
elements, these are the `𝔽_{q^m}`-points of `X₀ = Spec k₀[t]/𝔞`. The ideal of the
fixed scheme of the `q^m`-Frobenius of `L[t]/𝔞 L[t]` is generated by the `t_i^{q^m} - t_i`
(blueprint `det-tf-fixed-point-equations`).

## Main definitions

- `MvPolynomial.evalPoints`: the evaluation `L[t] → ∏_{λ ∈ F^σ} L`, `f ↦ (f(λ))_λ`.
- `MvPolynomial.quotientSpanXPowSubXAlgEquiv`: `L[t] / (t_i^Q - t_i)_i ≃ₐ[L] ∏_{λ ∈ F^σ} L`.
- `MvPolynomial.quotientSupSpanXPowSubXAlgEquiv`: `L[t] / (J + (t_i^Q - t_i)_i) ≃ₐ[L] ∏_{λ ∈ Z} L`
  for an ideal `J` of `L[t]` with zero set `Z ⊆ F^σ`.
- `MvPolynomial.quotientMapSupSpanXPowSubXAlgEquiv`:
  `L[t] / (𝔞 L[t] + (t_i^Q - t_i)_i) ≃ₐ[L] ∏_{λ ∈ F^σ, 𝔞(λ) = 0} L` for an ideal `𝔞` of `k₀[t]`.

## Main statements

- `MvPolynomial.ker_evalPoints`: the kernel of `evalPoints` is `(t_i^Q - t_i)_i`.
- `MvPolynomial.span_range_quotientMapₐ_expand_sub_self` (in
  `WeilConjectures.Mathlib.Algebra.MvPolynomial.Expand`): in `B = L[t]/J` with `J` stable under
  the substitution `φ : t_i ↦ t_i^n`, the ideal generated by the `φ(b) - b` is generated by the
  `t_i^n - t_i`.
- `MvPolynomial.span_range_frobenius_sub_self`: the case `J = 𝔞 L[t]`, `n = q^m`, where `φ` is
  the base change of the `q^m`-power Frobenius of `k₀[t]/𝔞`
  (`MvPolynomial.quotientMapₐ_expand_mk_map`).
-/

@[expose] public section

noncomputable section

namespace MvPolynomial

variable {σ : Type*}

/-- If `r (u_i - c_i) = 0` for all `i`, then `r f(u) = f(c) r` for every multivariate
polynomial `f`. -/
theorem mul_aeval_eq_of_mul_sub_eq_zero {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    {u : σ → A} {c : σ → R} {r : A} (h : ∀ i, r * (u i - algebraMap R A (c i)) = 0)
    (f : MvPolynomial σ R) : r * aeval u f = algebraMap R A (eval c f) * r := by
  induction f using MvPolynomial.induction_on with
  | C a => simp [mul_comm]
  | add p q hp hq => simp only [map_add, mul_add, add_mul, hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, aeval_X, eval_X]
    linear_combination u i * hp + algebraMap R A (eval c p) * h i

/-- Over a finite field `K` with `q` elements, `expand (q ^ m) f = f ^ (q ^ m)`. -/
theorem expand_card_pow {K : Type*} [Field K] [Fintype K] (m : ℕ) (f : MvPolynomial σ K) :
    expand (Fintype.card K ^ m) f = f ^ Fintype.card K ^ m := by
  induction m generalizing f with
  | zero => simp
  | succ m ih => rw [pow_succ, expand_mul, expand_card, ih, ← pow_mul, mul_comm]

section EvalPoints

variable (F L : Type*) [Field F] [CommRing L] [Algebra F L]

/-- The evaluation `L[t_i]_{i ∈ σ} → ∏_{λ ∈ F^σ} L`, `f ↦ (f(λ))_λ`, at the points of `F^σ`
(blueprint `det-tf-fixed-point-algebra`). -/
def evalPoints (σ : Type*) : MvPolynomial σ L →ₐ[L] (σ → F) → L :=
  AlgHom.pi fun a ↦ aeval fun i ↦ algebraMap F L (a i)

variable {F L}

@[simp]
lemma evalPoints_apply (f : MvPolynomial σ L) (a : σ → F) :
    evalPoints F L σ f a = aeval (fun i ↦ algebraMap F L (a i)) f :=
  rfl

variable (L) in
/-- The evaluation `L[t] → ∏_{λ ∈ Z} L` at the points of a subset `Z ⊆ F^σ`. -/
def evalPointsOn (Z : Set (σ → F)) : MvPolynomial σ L →ₐ[L] Z → L :=
  (AlgHom.pi fun z : Z ↦ Pi.evalAlgHom L (fun _ : σ → F ↦ L) z.1).comp (evalPoints F L σ)

@[simp]
lemma evalPointsOn_apply (Z : Set (σ → F)) (f : MvPolynomial σ L) (z : Z) :
    evalPointsOn L Z f z = evalPoints F L σ f z.1 :=
  rfl

/-- The evaluations of the Lagrange idempotents at the points of `F^σ` are the indicator
functions of the points. -/
lemma evalPoints_lagrangeIdem [Fintype F] [Fintype σ] [DecidableEq F] (a b : σ → F) :
    evalPoints F L σ (FiniteField.lagrangeIdem ((C : L →+* MvPolynomial σ L).comp
      (algebraMap F L)) X a) b = if a = b then 1 else 0 := by
  let g : MvPolynomial σ L →+* L := (aeval fun i ↦ algebraMap F L (b i) : _ →ₐ[L] L)
  have hg : g.comp ((C : L →+* MvPolynomial σ L).comp (algebraMap F L)) = algebraMap F L := by
    ext; simp [g]
  have h : evalPoints F L σ (FiniteField.lagrangeIdem ((C : L →+* MvPolynomial σ L).comp
      (algebraMap F L)) X a) b =
      FiniteField.lagrangeIdem (algebraMap F L) (fun i ↦ algebraMap F L (b i)) a := by
    rw [evalPoints_apply]
    change g _ = _
    rw [FiniteField.map_lagrangeIdem, hg]
    simp [g]
  rw [h]
  split_ifs with hab
  · subst hab
    exact FiniteField.lagrangeIdem_self _ _
  · have hu : ∀ i, algebraMap F L (b i) ^ Fintype.card F = algebraMap F L (b i) := fun i ↦ by
      rw [← map_pow, FiniteField.pow_card]
    have := FiniteField.lagrangeIdem_mul_lagrangeIdem (algebraMap F L) hu hab
    rwa [FiniteField.lagrangeIdem_self, mul_one] at this

/-- Evaluation at the points of `F^σ` is surjective onto `∏_{λ ∈ F^σ} L`, `σ` finite. -/
lemma surjective_evalPoints [Finite F] [Finite σ] : Function.Surjective (evalPoints F L σ) := by
  classical
  have := Fintype.ofFinite σ
  have := Fintype.ofFinite F
  intro g
  refine ⟨∑ a, g a • FiniteField.lagrangeIdem ((C : L →+* MvPolynomial σ L).comp
    (algebraMap F L)) X a, funext fun b ↦ ?_⟩
  simp only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, evalPoints_lagrangeIdem,
    smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

/-- Evaluation at the points of a subset `Z ⊆ F^σ` is surjective onto `∏_{λ ∈ Z} L`. -/
lemma surjective_evalPointsOn [Finite F] [Finite σ] (Z : Set (σ → F)) :
    Function.Surjective (evalPointsOn L Z) := by
  classical
  intro g
  obtain ⟨f, hf⟩ := surjective_evalPoints (F := F) (L := L) (σ := σ)
    fun a ↦ if h : a ∈ Z then g ⟨a, h⟩ else 0
  refine ⟨f, funext fun z ↦ ?_⟩
  change evalPoints F L σ f z.1 = g z
  rw [hf]
  exact dite_eq_left z.2

variable [Fintype F]

/-- The `t_i^Q - t_i` vanish at the points of `F^σ`, `Q = #F`. -/
lemma span_le_ker_evalPoints :
    Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L)) ≤
      RingHom.ker (evalPoints F L σ) := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  refine (RingHom.mem_ker).mpr (funext fun a ↦ ?_)
  simp only [evalPoints_apply, map_sub, map_pow, aeval_X, Pi.zero_apply]
  rw [← map_pow, FiniteField.pow_card, sub_self]

/-- The kernel of the evaluation at the points of `F^σ` is generated by the `t_i^Q - t_i`,
`Q = #F` (blueprint `det-tf-fixed-point-algebra`): modulo these, the Lagrange idempotents of the
points form a complete family of idempotents. -/
theorem ker_evalPoints [Finite σ] :
    RingHom.ker (evalPoints F L σ) =
      Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L)) := by
  classical
  have := Fintype.ofFinite σ
  set I := Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L))
  refine le_antisymm (fun f hf ↦ ?_) span_le_ker_evalPoints
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  let ψ : F →+* MvPolynomial σ L ⧸ I :=
    (Ideal.Quotient.mk I).comp ((C : L →+* MvPolynomial σ L).comp (algebraMap F L))
  let u : σ → MvPolynomial σ L ⧸ I := fun i ↦ Ideal.Quotient.mk I (X i)
  have hu (i : σ) : u i ^ Fintype.card F = u i := by
    rw [← map_pow, Ideal.Quotient.eq]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hmk : Ideal.Quotient.mk I f = aeval u f := by
    rw [← Ideal.Quotient.mkₐ_eq_mk L, aeval_unique (Ideal.Quotient.mkₐ L I)]
    rfl
  have key (a : σ → F) : FiniteField.lagrangeIdem ψ u a * Ideal.Quotient.mk I f = 0 := by
    rw [hmk, mul_aeval_eq_of_mul_sub_eq_zero (c := fun i ↦ algebraMap F L (a i))
      (fun i ↦ FiniteField.lagrangeIdem_mul_sub ψ hu a i)]
    have : eval (fun i ↦ algebraMap F L (a i)) f = 0 := by
      simpa using congr_fun ((RingHom.mem_ker).mp hf) a
    rw [this, map_zero, zero_mul]
  rw [← one_mul (Ideal.Quotient.mk I f), ← FiniteField.sum_lagrangeIdem ψ u, Finset.sum_mul]
  exact Finset.sum_eq_zero fun a _ ↦ key a

variable (F L) in
/-- **The algebra of `F`-points** (blueprint `det-tf-fixed-point-algebra`): for a finite field
`F` with `Q` elements and an `F`-algebra `L`, evaluation at the points of `F^σ` is an isomorphism
`L[t_i]_{i ∈ σ} / (t_i^Q - t_i)_i ≃ₐ[L] ∏_{λ ∈ F^σ} L`. For `F = 𝔽_{q^m}` and `L = k`
algebraically closed, the points of `F` are the roots of `t^{q^m} - t` in `k`. -/
def quotientSpanXPowSubXAlgEquiv [Finite σ] :
    (MvPolynomial σ L ⧸
      Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L))) ≃ₐ[L]
      ((σ → F) → L) :=
  (Ideal.quotientEquivAlgOfEq L ker_evalPoints.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective surjective_evalPoints)

@[simp]
lemma quotientSpanXPowSubXAlgEquiv_mk [Finite σ] (f : MvPolynomial σ L) :
    quotientSpanXPowSubXAlgEquiv F L (Ideal.Quotient.mk _ f) = evalPoints F L σ f :=
  rfl

/-! ### Zero sets -/

variable {J : Ideal (MvPolynomial σ L)} {Z : Set (σ → F)}

/-- If `Z ⊆ F^σ` is the zero set of an ideal `J` of `L[t]`, in the sense that the elements of `J`
vanish on `Z` and at every point outside `Z` some element of `J` takes a unit value, the kernel
of the evaluation at the points of `Z` is `J + (t_i^Q - t_i)_i` (blueprint
`det-tf-fixed-point-algebra`). -/
theorem ker_evalPointsOn [Finite σ] (hZ₁ : ∀ a ∈ Z, ∀ f ∈ J, evalPoints F L σ f a = 0)
    (hZ₂ : ∀ a ∉ Z, ∃ f ∈ J, IsUnit (evalPoints F L σ f a)) :
    RingHom.ker (evalPointsOn L Z) =
      J ⊔ Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L)) := by
  classical
  have := Fintype.ofFinite σ
  rw [← ker_evalPoints (F := F), RingHom.ker_eq_comap_bot (evalPoints F L σ),
    ← Ideal.comap_map_of_surjective (f := evalPoints F L σ) surjective_evalPoints]
  ext f
  simp only [RingHom.mem_ker, Ideal.mem_comap]
  constructor
  · intro hf
    have hf' : ∀ a ∈ Z, evalPoints F L σ f a = 0 := fun a ha ↦ congr_fun hf ⟨a, ha⟩
    rw [← Finset.univ_sum_single (evalPoints F L σ f)]
    refine Ideal.sum_mem _ fun a _ ↦ ?_
    by_cases ha : a ∈ Z
    · rw [hf' a ha, Pi.single_zero]
      exact zero_mem _
    · obtain ⟨g, hg, u, hu⟩ := hZ₂ a ha
      have : Pi.single a (evalPoints F L σ f a) =
          Pi.single a (evalPoints F L σ f a * ↑u⁻¹) * evalPoints F L σ g := by
        funext b
        by_cases hb : b = a
        · subst hb
          simp [← hu]
        · simp [hb]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hg)
  · intro hf
    funext z
    have hle : J.map (evalPoints F L σ) ≤
        RingHom.ker (Pi.evalRingHom (fun _ : σ → F ↦ L) z.1) := by
      rw [Ideal.map_le_iff_le_comap]
      intro g hg
      exact hZ₁ z.1 z.2 g hg
    exact hle hf

/-- **The algebra of the `F`-points of a closed subscheme** (blueprint
`det-tf-fixed-point-algebra`): if `Z ⊆ F^σ` is the zero set of an ideal `J` of `L[t]` (the
elements of `J` vanish on `Z`, and at every point outside `Z` some element of `J` takes a unit
value), evaluation at the points of `Z` is an isomorphism
`L[t] / (J + (t_i^Q - t_i)_i) ≃ₐ[L] ∏_{λ ∈ Z} L`. -/
def quotientSupSpanXPowSubXAlgEquiv [Finite σ] (hZ₁ : ∀ a ∈ Z, ∀ f ∈ J, evalPoints F L σ f a = 0)
    (hZ₂ : ∀ a ∉ Z, ∃ f ∈ J, IsUnit (evalPoints F L σ f a)) :
    (MvPolynomial σ L ⧸
      (J ⊔ Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L)))) ≃ₐ[L]
      (Z → L) :=
  (Ideal.quotientEquivAlgOfEq L (ker_evalPointsOn hZ₁ hZ₂).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (surjective_evalPointsOn Z))

@[simp]
lemma quotientSupSpanXPowSubXAlgEquiv_mk [Finite σ]
    (hZ₁ : ∀ a ∈ Z, ∀ f ∈ J, evalPoints F L σ f a = 0)
    (hZ₂ : ∀ a ∉ Z, ∃ f ∈ J, IsUnit (evalPoints F L σ f a)) (f : MvPolynomial σ L) (z : Z) :
    quotientSupSpanXPowSubXAlgEquiv hZ₁ hZ₂ (Ideal.Quotient.mk _ f) z = evalPoints F L σ f z.1 :=
  rfl

variable {k₀ : Type*} [CommRing k₀] [Algebra k₀ F] [Algebra k₀ L] [IsScalarTower k₀ F L]

omit [Fintype F] in
/-- Evaluating the base change to `L` of a polynomial over `k₀` at a point of `F^σ`. -/
lemma evalPoints_map (f : MvPolynomial σ k₀) (a : σ → F) :
    evalPoints F L σ (map (algebraMap k₀ L) f) a = algebraMap F L (aeval a f) := by
  rw [evalPoints_apply, aeval_map_algebraMap, ← aeval_algebraMap_apply]
  rfl

variable (F L) in
/-- **The algebra of the fixed points** (blueprint `det-tf-fixed-point-algebra`): for an ideal
`𝔞` of `k₀[t_i]_{i ∈ σ}`, a finite field `F ⊇ k₀` with `Q` elements (for instance
`𝔽_{q^m} ⊇ 𝔽_q`) and an `F`-algebra `L`, evaluation at the zeros `λ ∈ F^σ` of `𝔞` (the
`F`-points of `Spec k₀[t]/𝔞`) is an isomorphism
`L[t] / (𝔞 L[t] + (t_i^Q - t_i)_i) ≃ₐ[L] ∏_{λ ∈ F^σ, 𝔞(λ) = 0} L`. -/
def quotientMapSupSpanXPowSubXAlgEquiv [Finite σ] (𝔞 : Ideal (MvPolynomial σ k₀)) :
    (MvPolynomial σ L ⧸ (𝔞.map (map (algebraMap k₀ L)) ⊔
      Ideal.span (Set.range fun i ↦ (X i ^ Fintype.card F - X i : MvPolynomial σ L)))) ≃ₐ[L]
      ({a : σ → F // ∀ f ∈ 𝔞, aeval a f = 0} → L) :=
  quotientSupSpanXPowSubXAlgEquiv (Z := {a : σ → F | ∀ f ∈ 𝔞, aeval a f = 0})
    (fun a ha g hg ↦ by
      have hle : 𝔞.map (map (algebraMap k₀ L)) ≤
          RingHom.ker ((Pi.evalRingHom (fun _ : σ → F ↦ L) a).comp
            (evalPoints F L σ : MvPolynomial σ L →+* (σ → F) → L)) := by
        rw [Ideal.map_le_iff_le_comap]
        intro f hf
        simp only [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, Pi.evalRingHom_apply,
          RingHom.coe_coe]
        rw [evalPoints_map, ha f hf, map_zero]
      simpa [RingHom.mem_ker] using hle hg)
    (fun a ha ↦ by
      obtain ⟨f, hf, hfa⟩ := not_forall₂.mp ha
      exact ⟨_, Ideal.mem_map_of_mem _ hf, by
        rw [evalPoints_map]
        exact (Ne.isUnit hfa).map _⟩)

@[simp]
lemma quotientMapSupSpanXPowSubXAlgEquiv_mk [Finite σ] (𝔞 : Ideal (MvPolynomial σ k₀))
    (f : MvPolynomial σ L) (z : {a : σ → F // ∀ f ∈ 𝔞, aeval a f = 0}) :
    quotientMapSupSpanXPowSubXAlgEquiv F L 𝔞 (Ideal.Quotient.mk _ f) z =
      evalPoints F L σ f z.1 :=
  rfl

end EvalPoints

/-! ### The equations of the fixed scheme -/

section Equations

variable {k₀ L : Type*} [Field k₀] [Fintype k₀] [CommRing L] [Algebra k₀ L]

/-- The extension `𝔞 L[t]` of an ideal `𝔞` of `k₀[t]`, `k₀` a finite field with `q` elements, is
stable under the substitution `t_i ↦ t_i^{q^m}`: this substitution is the base change of the
`q^m`-power Frobenius of `k₀[t]`. -/
lemma map_le_comap_expand_map (𝔞 : Ideal (MvPolynomial σ k₀)) (m : ℕ) :
    𝔞.map (map (algebraMap k₀ L)) ≤
      (𝔞.map (map (algebraMap k₀ L))).comap (expand (Fintype.card k₀ ^ m)) := by
  rw [Ideal.map_le_iff_le_comap]
  intro f hf
  rw [Ideal.mem_comap, Ideal.mem_comap, ← map_expand, expand_card_pow]
  exact Ideal.mem_map_of_mem _ (Ideal.pow_mem_of_mem _ hf _ (by positivity))

/-- The `k₀`-linear endomorphism `t_i ↦ t_i^{q^m}` of `L[t]/𝔞 L[t]` is the base change of the
`q^m`-power Frobenius of `k₀[t]/𝔞`. -/
lemma quotientMapₐ_expand_mk_map (𝔞 : Ideal (MvPolynomial σ k₀)) (m : ℕ)
    (f : MvPolynomial σ k₀) :
    Ideal.quotientMapₐ (𝔞.map (map (algebraMap k₀ L)))
      (expand (σ := σ) (R := L) (Fintype.card k₀ ^ m))
      (map_le_comap_expand_map 𝔞 m)
      (Ideal.Quotient.mk _ (map (algebraMap k₀ L) f)) =
        Ideal.Quotient.mk _ (map (algebraMap k₀ L) f) ^ (Fintype.card k₀ ^ m) := by
  rw [Ideal.quotient_map_mkₐ, Ideal.Quotient.mkₐ_eq_mk, ← map_expand, expand_card_pow, map_pow,
    map_pow]

/-- **The equations of the Frobenius fixed scheme** (blueprint
`det-tf-fixed-point-equations`): for an ideal `𝔞` of `k₀[t_i]_{i ∈ σ}`, `k₀` a finite field with
`q` elements, and `φ` the base change to `B = L[t]/𝔞 L[t]` of the `q^m`-power Frobenius of
`k₀[t]/𝔞`, the ideal of `B` generated by the `φ(b) - b` is generated by the `t_i^{q^m} - t_i`. -/
theorem span_range_frobenius_sub_self (𝔞 : Ideal (MvPolynomial σ k₀)) (m : ℕ) :
    Ideal.span (Set.range fun b : MvPolynomial σ L ⧸ 𝔞.map (map (algebraMap k₀ L)) ↦
      Ideal.quotientMapₐ (𝔞.map (map (algebraMap k₀ L)))
        (expand (σ := σ) (R := L) (Fintype.card k₀ ^ m))
        (map_le_comap_expand_map 𝔞 m) b - b) =
      (Ideal.span (Set.range fun i ↦
        (X i ^ (Fintype.card k₀ ^ m) - X i : MvPolynomial σ L))).map (Ideal.Quotient.mk _) :=
  span_range_quotientMapₐ_expand_sub_self _ _ _

end Equations

end MvPolynomial
