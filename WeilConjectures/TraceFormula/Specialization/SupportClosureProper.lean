module

public import WeilConjectures.TraceFormula.Specialization.SupportCompactSupportExchange

/-!

# Properness of the deformation map of the compactified support

For the compactification `c̄ : C̄ ⟶ X ⨯ X` of the support of a correspondence contracting at `y`,
`x = c₁(y)` and `Z' = c̄⁻¹(x, x)`, we show that the morphism of deformation spaces
`D_{Z'} C̄ ⟶ D_x X ×_{𝔸¹} D_x X` (`supportClosureSpaceMap`) is proper.

The proof: `Z' = c̄₁⁻¹(x) + c̄₂⁻¹(x)` (`supportClosureIdeal_le_sup`), and for ideal sheaves
`J ⊆ J₁ + J₂` on a scheme `S` the morphism `D_J S ⟶ D_{J₁} S ×_S D_{J₂} S` is a closed immersion
(`AlgebraicGeometry.Scheme.IdealSheafData.isClosedImmersion_deformationSpaceToFibreProduct`): on
charts, `S[t, J t⁻¹]` is generated by the images of `S[t, J₁ t⁻¹]` and `S[t, J₂ t⁻¹]`
(`Ideal.mem_closure_extendedReesAlgebraMap_sup`). Combined with the closed immersions
`D_{c̄ᵢ⁻¹(x)} C̄ ⟶ C̄ ×_X D_x X`, the morphism `D_{Z'} C̄ ⟶ C̄ ×_{X ⨯ X} (D_x X ×_{𝔸¹} D_x X)` is a
closed immersion, and the second projection is the base change of the proper `c̄`
(`isProper_deformationSpaceProdLift_of_le`).

-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite LaurentPolynomial

namespace Ideal

/-- For `J ⊆ φ(I₁) + φ(I₂)` with `φ` surjective, `S[t, J t⁻¹]` is generated as a ring by the
images of `R[t, I₁ t⁻¹]` and `R[t, I₂ t⁻¹]`. -/
theorem mem_closure_extendedReesAlgebraMap_sup {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (hφ : Function.Surjective φ) {I₁ I₂ : Ideal R} {J : Ideal S}
    (h₁ : I₁.map φ ≤ J) (h₂ : I₂.map φ ≤ J) (hJ : J ≤ I₁.map φ ⊔ I₂.map φ)
    (y : J.extendedReesAlgebra) :
    y ∈ Subring.closure (Set.range (I₁.extendedReesAlgebraMap φ J h₁) ∪
      Set.range (I₂.extendedReesAlgebraMap φ J h₂)) := by
  set M := Subring.closure (Set.range (I₁.extendedReesAlgebraMap φ J h₁) ∪
    Set.range (I₂.extendedReesAlgebraMap φ J h₂))
  have hm₁ (z) : I₁.extendedReesAlgebraMap φ J h₁ z ∈ M :=
    Subring.subset_closure (Or.inl ⟨z, rfl⟩)
  have hm₂ (z) : I₂.extendedReesAlgebraMap φ J h₂ z ∈ M :=
    Subring.subset_closure (Or.inr ⟨z, rfl⟩)
  obtain ⟨y, hy⟩ := y
  induction hy using Algebra.adjoin_induction with
  | mem z hz =>
    obtain rfl | ⟨x, hx, rfl⟩ := hz
    · convert hm₁ I₁.extendedReesAlgebraT using 1
      exact (extendedReesAlgebraMap_T φ J h₁).symm
    · obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp (hJ hx)
      obtain ⟨a', ha', rfl⟩ := (mem_map_iff_of_surjective φ hφ).mp ha
      obtain ⟨b', hb', rfl⟩ := (mem_map_iff_of_surjective φ hφ).mp hb
      convert M.add_mem (hm₁ ⟨_, C_mul_T_neg_one_mem_extendedReesAlgebra ha'⟩)
        (hm₂ ⟨_, C_mul_T_neg_one_mem_extendedReesAlgebra hb'⟩) using 1
      ext1
      simp [LaurentPolynomial.mapRingHom_C, LaurentPolynomial.mapRingHom_T, add_mul]
  | algebraMap s =>
    obtain ⟨r, rfl⟩ := hφ s
    convert hm₁ (algebraMap R _ r) using 1
    rw [extendedReesAlgebraMap_algebraMap]
    rfl
  | add x y _ _ ihx ihy => exact M.add_mem ihx ihy
  | mul x y _ _ ihx ihy => exact M.mul_mem ihx ihy

end Ideal

namespace AlgebraicGeometry.Scheme.IdealSheafData

open AffineZariskiSite

variable {S : Scheme.{u}} (J₁ J₂ J : S.IdealSheafData)
  (h₁ : ∀ ⦃U' : S.AffineZariskiSite⦄ ⦃U : S.AffineZariskiSite⦄ (hU : U'.1 ≤ (𝟙 S) ⁻¹ᵁ U.1),
    (J₁.siteIdeal U).map (Scheme.Hom.appLE (𝟙 S) U.1 U'.1 hU).hom ≤ J.siteIdeal U')
  (h₂ : ∀ ⦃U' : S.AffineZariskiSite⦄ ⦃U : S.AffineZariskiSite⦄ (hU : U'.1 ≤ (𝟙 S) ⁻¹ᵁ U.1),
    (J₂.siteIdeal U).map (Scheme.Hom.appLE (𝟙 S) U.1 U'.1 hU).hom ≤ J.siteIdeal U')

/-- The morphism `D_J S ⟶ D_{J₁} S ×_S D_{J₂} S` for `J₁, J₂ ⊆ J`. -/
noncomputable def deformationSpaceToFibreProduct :
    J.deformationSpace ⟶ pullback J₁.deformationSpaceProj J₂.deformationSpaceProj :=
  pullback.lift (deformationSpaceMap (𝟙 S) J₁ J h₁) (deformationSpaceMap (𝟙 S) J₂ J h₂) (by
    rw [deformationSpaceMap_toBase, deformationSpaceMap_toBase])

/-- If `J ⊆ J₁ + J₂`, then `D_J S ⟶ D_{J₁} S ×_S D_{J₂} S` is a closed immersion. -/
theorem isClosedImmersion_deformationSpaceToFibreProduct (hJ : J ≤ J₁ ⊔ J₂) :
    IsClosedImmersion (deformationSpaceToFibreProduct J₁ J₂ J h₁ h₂) := by
  set R₁ := relativeGluingData J₁.coequifibered_toReesPresheaf
  set R₂ := relativeGluingData J₂.coequifibered_toReesPresheaf
  set R := relativeGluingData J.coequifibered_toReesPresheaf
  set D₁ := extendedReesPullbackData (𝟙 S) J₁ J h₁
  set D₂ := extendedReesPullbackData (𝟙 S) J₂ J h₂
  have hU (U : S.AffineZariskiSite) : U.1 ≤ (𝟙 S) ⁻¹ᵁ U.1 := le_rfl
  have key (U : S.AffineZariskiSite) : ∃ (j : Spec (pushout (J₁.toReesPresheaf.app (op U))
      (J₂.toReesPresheaf.app (op U))) ⟶ pullback J₁.deformationSpaceProj J₂.deformationSpaceProj),
      IsOpenImmersion j ∧
      IsPullback j (Spec.map (pushout.inl _ _) ≫ R₁.natTrans.app U)
        (pullback.fst _ _ ≫ J₁.deformationSpaceProj) U.1.ι ∧
      IsPullback (colimit.ι R.functor U) (Spec.map (pushout.desc (D₁.map (hU U))
        (D₂.map (hU U)) (by rw [D₁.app_comp_map, D₂.app_comp_map])))
        (deformationSpaceToFibreProduct J₁ J₂ J h₁ h₂) j := by
    have hZ : IsPullback (Spec.map (pushout.inl (J₁.toReesPresheaf.app (op U))
        (J₂.toReesPresheaf.app (op U)))) (Spec.map (pushout.inr _ _)) (R₁.natTrans.app U)
        (R₂.natTrans.app U) := by
      have := (isPullback_SpecMap_of_isPushout _ _ _ _ (IsPushout.of_hasPushout
        (J₁.toReesPresheaf.app (op U)) (J₂.toReesPresheaf.app (op U)))).paste_horiz
        (IsPullback.of_horiz_isIso (fst := 𝟙 _) (g := (restrictIsoSpec S).inv.app U)
          (f := R₁.natTrans.app U) (snd := Spec.map (J₁.toReesPresheaf.app (op U)))
          ⟨Category.id_comp _⟩)
      rwa [Category.comp_id] at this
    have hB := IsPullback.of_isPullback_of_baseChange (R₁.isPullback_natTrans_ι_toBase U).flip
      (R₂.isPullback_natTrans_ι_toBase U).flip (IsPullback.id_vert U.1.ι) (Category.comp_id _)
      (Category.comp_id _) (R₁.isPullback_natTrans_ι_toBase U).w
      (R₂.isPullback_natTrans_ι_toBase U).w (IsPullback.of_hasPullback _ _) hZ
      (z := pullback.lift (Spec.map (pushout.inl _ _) ≫ colimit.ι R₁.functor U)
        (Spec.map (pushout.inr _ _) ≫ colimit.ι R₂.functor U) (by
          rw [Category.assoc, Category.assoc, ← (R₁.isPullback_natTrans_ι_toBase U).w,
            ← (R₂.isPullback_natTrans_ι_toBase U).w, hZ.w_assoc]))
      (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _)
    refine ⟨_, MorphismProperty.of_isPullback hB.flip inferInstance, hB, IsPullback.of_bot ?_ ?_ hB⟩
    · have e₁ : Spec.map (pushout.desc (D₁.map (hU U)) (D₂.map (hU U))
          (by rw [D₁.app_comp_map, D₂.app_comp_map])) ≫ Spec.map (pushout.inl _ _) ≫
          R₁.natTrans.app U = R.natTrans.app U := by
        rw [← cancel_mono U.1.ι, Category.assoc, Category.assoc,
          (R₁.isPullback_natTrans_ι_toBase U).w, ← Spec.map_comp_assoc, pushout.inl_desc,
          (R.isPullback_natTrans_ι_toBase U).w]
        erw [← D₁.ι_comparison_assoc _ _ (hU U), D₁.comparison_toBase]
        rfl
      have e₂ : deformationSpaceToFibreProduct J₁ J₂ J h₁ h₂ ≫ pullback.fst _ _ ≫
          J₁.deformationSpaceProj = J.deformationSpaceProj := by
        rw [deformationSpaceToFibreProduct, pullback.lift_fst_assoc, deformationSpaceMap_toBase,
          Category.comp_id]
      rw [e₁, e₂]
      exact (R.isPullback_natTrans_ι_toBase U).flip
    · apply pullback.hom_ext
      · rw [Category.assoc, Category.assoc, deformationSpaceToFibreProduct, pullback.lift_fst,
          pullback.lift_fst, ← Spec.map_comp_assoc, pushout.inl_desc]
        exact D₁.ι_comparison _ _ (hU U)
      · rw [Category.assoc, Category.assoc, deformationSpaceToFibreProduct, pullback.lift_snd,
          pullback.lift_snd, ← Spec.map_comp_assoc, pushout.inr_desc]
        exact D₂.ι_comparison _ _ (hU U)
  choose j hj sqB sqL using key
  refine IsZariskiLocalAtTarget.of_forall_isPullback (P := @IsClosedImmersion) _ j
    (fun p ↦ ?_) _ _ sqL fun U ↦ IsClosedImmersion.spec_of_surjective _ fun y ↦ ?_
  · obtain ⟨U, s, hs⟩ := (directedCover S).exists_eq
      ((pullback.fst _ _ ≫ J₁.deformationSpaceProj).base p)
    obtain ⟨q, -, hq⟩ := exists_preimage_of_isPullback (sqB U).flip s p hs
    exact ⟨U, q, hq⟩
  · have hid : Scheme.Hom.appLE (𝟙 S) U.1 U.1 (hU U) = 𝟙 _ := by
      simp only [Scheme.Hom.appLE, Scheme.Hom.id_app, Category.id_comp]
      exact S.presheaf.map_id _
    have hφ : Function.Surjective (Scheme.Hom.appLE (𝟙 S) U.1 U.1 (hU U)).hom := by
      rw [hid]
      exact Function.surjective_id
    have hle : Subring.closure (Set.range (D₁.map (hU U)).hom ∪ Set.range (D₂.map (hU U)).hom) ≤
        (pushout.desc (D₁.map (hU U)) (D₂.map (hU U))
          (by rw [D₁.app_comp_map, D₂.app_comp_map])).hom.range := by
      refine Subring.closure_le.mpr (Set.union_subset ?_ ?_)
      · rintro _ ⟨z, rfl⟩
        refine ⟨(pushout.inl (J₁.toReesPresheaf.app (op U)) _).hom z, ?_⟩
        rw [← CommRingCat.comp_apply, pushout.inl_desc]
      · rintro _ ⟨z, rfl⟩
        refine ⟨(pushout.inr _ (J₂.toReesPresheaf.app (op U))).hom z, ?_⟩
        rw [← CommRingCat.comp_apply, pushout.inr_desc]
    refine hle (Ideal.mem_closure_extendedReesAlgebraMap_sup _ hφ (h₁ (hU U)) (h₂ (hU U))
      ((hJ ⟨U.1, U.2⟩).trans ?_) y)
    rw [hid, CommRingCat.hom_id, Ideal.map_id, Ideal.map_id]
    exact le_rfl

end AlgebraicGeometry.Scheme.IdealSheafData

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

section Product

variable {k : Type u} [Field k] {X : Over (Spec (.of k))}

variable (X) in
/-- The projection `D_I X ×_{𝔸¹} D_I X ⟶ X ⨯ X`. -/
noncomputable def deformationSpacesToProd (I : X.left.IdealSheafData) :
    pullback (deformationSpaceToAffineLine X I) (deformationSpaceToAffineLine X I) ⟶
      (X ⨯ X).left :=
  have hp : I.deformationSpaceProj ≫ X.hom =
      deformationSpaceToAffineLine X I ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k) := by
    rw [deformationSpaceToAffineLine, IdealSheafData.deformationSpaceProj_over']
  (isPullback_prod_left X X).lift (pullback.fst _ _ ≫ I.deformationSpaceProj)
    (pullback.snd _ _ ≫ I.deformationSpaceProj) (by
      rw [Category.assoc, Category.assoc, hp, pullback.condition_assoc])

/-- For a proper `p : C ⟶ X ⨯ X` and `Z` between `p₁⁻¹ I, p₂⁻¹ I` and `p₁⁻¹ I + p₂⁻¹ I`, the
morphism `D_Z C ⟶ D_I X ×_{𝔸¹} D_I X` is proper: with `G = C ×_{X ⨯ X} (D_I X ×_{𝔸¹} D_I X)`, it
is `D_Z C ⟶ G` (a closed immersion) followed by the base change `G ⟶ D_I X ×_{𝔸¹} D_I X` of `p`.
The first map is a closed immersion since its composite with the monomorphism
`G ⟶ (C ×_X D_I X) ×_C (C ×_X D_I X)` is the closed immersion
`D_Z C ⟶ D_{p₁⁻¹ I} C ×_C D_{p₂⁻¹ I} C ⟶ (C ×_X D_I X) ×_C (C ×_X D_I X)`. -/
lemma isProper_deformationSpaceProdLift_of_le {C : Over (Spec (.of k))} (p : C ⟶ X ⨯ X)
    [IsProper p.left] (I : X.left.IdealSheafData) (Z : C.left.IdealSheafData)
    (hle₁ : I.comap (p ≫ prod.fst).left ≤ Z) (hle₂ : I.comap (p ≫ prod.snd).left ≤ Z)
    (hZ : Z ≤ I.comap (p ≫ prod.fst).left ⊔ I.comap (p ≫ prod.snd).left) :
    IsProper (deformationSpaceProdLift (p ≫ prod.fst)
      (IdealSheafData.map_siteIdeal_le_of_comap_le _ hle₁) (p ≫ prod.snd)
      (IdealSheafData.map_siteIdeal_le_of_comap_le _ hle₂)) := by
  have k₁ := IdealSheafData.map_siteIdeal_le_of_comap_le (𝟙 C.left)
    ((IdealSheafData.comap_id _).trans_le hle₁)
  have k₂ := IdealSheafData.map_siteIdeal_le_of_comap_le (𝟙 C.left)
    ((IdealSheafData.comap_id _).trans_le hle₂)
  have hΨ := IdealSheafData.isClosedImmersion_deformationSpaceToFibreProduct _ _ _ k₁ k₂ hZ
  have t₁ := IdealSheafData.isClosedImmersion_deformationSpaceToPullback (p ≫ prod.fst).left I _
    (IdealSheafData.map_siteIdeal_le_comap _ I) rfl
  have t₂ := IdealSheafData.isClosedImmersion_deformationSpaceToPullback (p ≫ prod.snd).left I _
    (IdealSheafData.map_siteIdeal_le_comap _ I) rfl
  have s₁ := IdealSheafData.deformationSpaceToPullback_snd (p ≫ prod.fst).left I _
    (IdealSheafData.map_siteIdeal_le_comap _ I)
  have s₂ := IdealSheafData.deformationSpaceToPullback_snd (p ≫ prod.snd).left I _
    (IdealSheafData.map_siteIdeal_le_comap _ I)
  have hM := MorphismProperty.pullbackMap (P := @IsClosedImmersion) t₁ t₂ s₁.symm s₂.symm
  have hπ₁ : deformationSpacesToProd X I ≫ (prod.fst : X ⨯ X ⟶ X).left =
      pullback.fst _ _ ≫ I.deformationSpaceProj := IsPullback.lift_fst _ _ _ _
  have hπ₂ : deformationSpacesToProd X I ≫ (prod.snd : X ⨯ X ⟶ X).left =
      pullback.snd _ _ ≫ I.deformationSpaceProj := IsPullback.lift_snd _ _ _ _
  let Θ : Z.deformationSpace ⟶ pullback p.left (deformationSpacesToProd X I) :=
    pullback.lift Z.deformationSpaceProj (deformationSpaceProdLift (p ≫ prod.fst)
      (IdealSheafData.map_siteIdeal_le_of_comap_le _ hle₁) (p ≫ prod.snd)
      (IdealSheafData.map_siteIdeal_le_of_comap_le _ hle₂)) (by
        apply (isPullback_prod_left X X).hom_ext
        · rw [Category.assoc, Category.assoc, hπ₁, deformationSpaceProdLift,
            pullback.lift_fst_assoc, IdealSheafData.deformationSpaceMap_toBase]
          rfl
        · rw [Category.assoc, Category.assoc, hπ₂, deformationSpaceProdLift,
            pullback.lift_snd_assoc, IdealSheafData.deformationSpaceMap_toBase]
          rfl)
  let g : pullback p.left (deformationSpacesToProd X I) ⟶
      pullback (pullback.snd I.deformationSpaceProj (p ≫ prod.fst).left)
        (pullback.snd I.deformationSpaceProj (p ≫ prod.snd).left) :=
    pullback.lift (pullback.lift (pullback.snd _ _ ≫ pullback.fst _ _) (pullback.fst _ _) (by
        rw [Category.assoc, ← hπ₁, ← pullback.condition_assoc]
        rfl))
      (pullback.lift (pullback.snd _ _ ≫ pullback.snd _ _) (pullback.fst _ _) (by
        rw [Category.assoc, ← hπ₂, ← pullback.condition_assoc]
        rfl)) (by simp)
  have : Mono g := by
    refine ⟨fun a b hab ↦ pullback.hom_ext ?_ (pullback.hom_ext ?_ ?_)⟩
    · simpa [g, -pullback.fst_comp_eq_toBase, -pullback.snd_comp_eq_toBase]
        using congr($hab ≫ pullback.fst _ _ ≫ pullback.snd _ _)
    · simpa [g, -pullback.fst_comp_eq_toBase, -pullback.snd_comp_eq_toBase]
        using congr($hab ≫ pullback.fst _ _ ≫ pullback.fst _ _)
    · simpa [g, -pullback.fst_comp_eq_toBase, -pullback.snd_comp_eq_toBase]
        using congr($hab ≫ pullback.snd _ _ ≫ pullback.fst _ _)
  have e : Θ ≫ g = IdealSheafData.deformationSpaceToFibreProduct _ _ Z k₁ k₂ ≫
      pullback.map _ _ _ _ _ _ (𝟙 _) ((Category.comp_id _).trans s₁.symm)
        ((Category.comp_id _).trans s₂.symm) := by
    apply pullback.hom_ext <;> apply pullback.hom_ext
    · simp only [Θ, g, deformationSpaceProdLift, IdealSheafData.deformationSpaceToFibreProduct,
        Category.assoc, pullback.lift_fst, pullback.lift_fst_assoc, pullback.lift_snd_assoc,
        IdealSheafData.deformationSpaceToPullback_fst]
      rw [IdealSheafData.deformationSpaceMap_comp_of_isOpenImmersion _ _ _ _
        (IdealSheafData.map_siteIdeal_le_of_comap_le (𝟙 _ ≫ (p ≫ prod.fst).left)
          (by rw [Category.id_comp]; exact hle₁))]
      congr 1
    · simp only [Θ, g, IdealSheafData.deformationSpaceToFibreProduct, Category.assoc,
        pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc,
        IdealSheafData.deformationSpaceToPullback_snd, IdealSheafData.deformationSpaceMap_toBase,
        Category.comp_id]
    · simp only [Θ, g, deformationSpaceProdLift, IdealSheafData.deformationSpaceToFibreProduct,
        Category.assoc, pullback.lift_fst, pullback.lift_snd, pullback.lift_snd_assoc,
        IdealSheafData.deformationSpaceToPullback_fst]
      rw [IdealSheafData.deformationSpaceMap_comp_of_isOpenImmersion _ _ _ _
        (IdealSheafData.map_siteIdeal_le_of_comap_le (𝟙 _ ≫ (p ≫ prod.snd).left)
          (by rw [Category.id_comp]; exact hle₂))]
      congr 1
    · simp only [Θ, g, IdealSheafData.deformationSpaceToFibreProduct, Category.assoc,
        pullback.lift_fst, pullback.lift_snd, pullback.lift_snd_assoc,
        IdealSheafData.deformationSpaceToPullback_snd, IdealSheafData.deformationSpaceMap_toBase,
        Category.comp_id]
  have : IsClosedImmersion (Θ ≫ g) := by
    rw [e]
    infer_instance
  have := IsClosedImmersion.of_comp Θ g
  have hs : IsProper (pullback.snd p.left (deformationSpacesToProd X I)) :=
    MorphismProperty.pullback_snd _ _ inferInstance
  rw [show deformationSpaceProdLift (p ≫ prod.fst) _ (p ≫ prod.snd) _ = Θ ≫ pullback.snd _ _ from
    (pullback.lift_snd _ _ _).symm]
  infer_instance

end Product

namespace Correspondence.IsContractingAt

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]
  {X : Over (Spec (.of k))} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  {K : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧} {c : Correspondence ℓ K}
  {y : RationalPoint c.C}

variable (c y) in
/-- `c̄_q⁻¹(x) ⊆ Z'` for a retraction `q` of the diagonal. -/
lemma comap_supportClosureLeg_le (q : X ⨯ X ⟶ X) (hq : diag X ≫ q = 𝟙 X) :
    (y ≫ c.c₁).left.ker.comap (supportClosureMap c ≫ q).left ≤ supportClosureIdeal c y := by
  rw [show (supportClosureMap c ≫ q).left = (supportClosureMap c).left ≫ q.left from rfl,
    IdealSheafData.comap_comp, supportClosureIdeal]
  refine IdealSheafData.comap_mono (f := _) ?_
  rw [IdealSheafData.comap_le_ker_iff, ← Over.comp_left, Category.assoc, hq, Category.comp_id]

variable (c y) in
/-- `Z' = c̄⁻¹(x, x)` is contained in `c̄₁⁻¹(x) + c̄₂⁻¹(x)`: on the closed subscheme
`c̄₁⁻¹(x) ∩ c̄₂⁻¹(x)`, both legs of `c̄` factor through the same point `x`. -/
lemma supportClosureIdeal_le_sup :
    supportClosureIdeal c y ≤ (y ≫ c.c₁).left.ker.comap (supportClosureMap c ≫ prod.fst).left ⊔
      (y ≫ c.c₁).left.ker.comap (supportClosureMap c ≫ prod.snd).left := by
  set Z := (y ≫ c.c₁).left.ker.comap (supportClosureMap c ≫ prod.fst).left ⊔
    (y ≫ c.c₁).left.ker.comap (supportClosureMap c ≫ prod.snd).left
  have : IsClosedImmersion (y ≫ c.c₁).left :=
    isClosedImmersion_of_comp_eq_id X.hom (y ≫ c.c₁).left (Over.w (y ≫ c.c₁))
  have H₁ : (y ≫ c.c₁).left.ker ≤ (Z.subschemeι ≫ (supportClosureMap c ≫ prod.fst).left).ker := by
    rw [← IdealSheafData.comap_le_ker_iff, IdealSheafData.ker_subschemeι]
    exact le_sup_left
  have H₂ : (y ≫ c.c₁).left.ker ≤ (Z.subschemeι ≫ (supportClosureMap c ≫ prod.snd).left).ker := by
    rw [← IdealSheafData.comap_le_ker_iff, IdealSheafData.ker_subschemeι]
    exact le_sup_right
  have e (g : Z.subscheme ⟶ Spec (.of k)) : g = g ≫ (y ≫ c.c₁).left ≫ X.hom := by
    rw [Over.w (y ≫ c.c₁)]
    exact (Category.comp_id g).symm
  have hab : IsClosedImmersion.lift _ _ H₂ = IsClosedImmersion.lift _ _ H₁ := by
    rw [e (IsClosedImmersion.lift _ _ H₂), e (IsClosedImmersion.lift _ _ H₁),
      IsClosedImmersion.lift_fac_assoc, IsClosedImmersion.lift_fac_assoc]
    simp only [Over.comp_left, Category.assoc, Over.w]
  have hc : Z.subschemeι ≫ (supportClosureMap c).left =
      IsClosedImmersion.lift _ _ H₁ ≫ ((y ≫ c.c₁) ≫ diag X).left := by
    apply (isPullback_prod_left X X).hom_ext
    · have hd : ((y ≫ c.c₁) ≫ diag X).left ≫ (prod.fst : X ⨯ X ⟶ X).left =
          (y ≫ c.c₁).left := by
        rw [← Over.comp_left, Category.assoc, diag, prod.lift_fst, Category.comp_id]
      rw [Category.assoc, Category.assoc, hd, IsClosedImmersion.lift_fac]
      rfl
    · have hd : ((y ≫ c.c₁) ≫ diag X).left ≫ (prod.snd : X ⨯ X ⟶ X).left =
          (y ≫ c.c₁).left := by
        rw [← Over.comp_left, Category.assoc, diag, prod.lift_snd, Category.comp_id]
      rw [Category.assoc, Category.assoc, hd, ← hab, IsClosedImmersion.lift_fac]
      rfl
  rw [← IdealSheafData.ker_subschemeι Z, supportClosureIdeal, IdealSheafData.comap_le_ker_iff, hc]
  exact Hom.le_ker_comp _ _

/-- The morphism `D_{Z'} C̄ ⟶ D_x X ×_{𝔸¹} D_x X` given by the legs of the compactified
support is proper. -/
instance isProper_supportClosureSpaceMap : IsProper (supportClosureSpaceMap c y) :=
  isProper_deformationSpaceProdLift_of_le (supportClosureMap c) _ _
    (comap_supportClosureLeg_le c y _ (by rw [diag, prod.lift_fst]))
    (comap_supportClosureLeg_le c y _ (by rw [diag, prod.lift_snd]))
    (supportClosureIdeal_le_sup c y)

end Correspondence.IsContractingAt

