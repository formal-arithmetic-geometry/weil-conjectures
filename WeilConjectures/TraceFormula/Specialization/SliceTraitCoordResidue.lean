module

public import WeilConjectures.TraceFormula.Specialization.SliceTraitValuation
public import WeilConjectures.TraceFormula.Specialization.SliceTraitExists
public import WeilConjectures.TraceFormula.Specialization.SliceTraitGaloisLayer
public import WeilConjectures.SixFunctors.NearbyCycles.TraitChangeInduction.SliceGaloisFields
public import WeilConjectures.RingTheory.Valuation.ResidueLinearIndependent
public import WeilConjectures.FieldTheory.PerfectClosureLinearIndependent

/-!
# The residue of the coordinate of a slice trait is not a `p`-th power

Let `D` be a slice trait over a complete strictly henselian trait `S₁ = Spec R₁` of residue
characteristic `p`, with valuation `v` on `Ω'` (`AlgebraicGeometry.SliceTrait.valuationSubring`)
and compositum `L = Ω₁(R) ⊆ Ω'`. Let `x ∈ R` have residue `x̄` transcendental over the residue
field `k` of `R₁`, the residue field of `R` being separable algebraic over `k(x̄)`. Then `x̄` is
not a `p`-th power in the residue field of `L`: `v(x - z ^ p) = 1` for every `z ∈ L` with
`v(z) ≤ 1` (`AlgebraicGeometry.SliceTrait.valuation_a_sub_pow_eq_one_of_isSeparable`). This
applies to the strict localization of `𝔸¹_{S₁}` and its coordinate
(`AlgebraicGeometry.SliceTrait.valuation_a_sub_pow_eq_one_of_complete`).

The proof: write `z = ∑ ωᵢ kᵢ` with `ωᵢ ∈ Ω₁` and `kᵢ ∈ R`. By the cartesian lemma for the complete
discrete valuation ring `R₁` (`ValuationSubring.exists_basis_residuallyIndependent`), the
`Frac R₁`-span of the `kᵢ` in `Frac R` has a basis `eⱼ` of units of `R` with residues linearly
independent over `k`, hence over the perfect closure of `k`
(`LinearIndependent.algebraMap_perfectClosure_of_transcendental`), which contains the residues of
the integral elements of `Ω₁`. Thus `z = ∑ ω'ⱼ eⱼ` with `v(z) = maxⱼ v(ω'ⱼ)`, and the residue of
`z` lies in the ring generated by `k^{perf}` and the residue field of `R`, where `x̄` has no
`p`-th root (`sum_mul_pow_ne_algebraMap`).
-/

@[expose] public section

universe u

open IsLocalRing IntermediateField

open scoped TensorProduct

namespace AlgebraicGeometry.SliceTrait

attribute [local instance] algebraR algebraΩ algebraBaseΩ algebraRΩ

section FractionField

variable {R : Type u} [CommRing R] [IsLocalRing R] {Ω : Type u} [Field Ω] [Algebra R Ω]
  {κ : Type u} [Field κ] {b : R →+* κ} (D : SliceTrait (algebraMap R Ω) b)

instance isLocalHom_algebraMap_R : IsLocalHom (algebraMap R D.R) :=
  D.isLocalHom_φ

instance faithfulSMul_Ω : FaithfulSMul D.R D.Ω :=
  (faithfulSMul_iff_algebraMap_injective _ _).2 D.injective_a

/-- The algebra structure `Frac R ⟶ Ω'` of a slice trait. -/
noncomputable abbrev algebraFracΩ : Algebra (FractionRing D.R) D.Ω :=
  FractionRing.liftAlgebra D.R D.Ω

attribute [local instance] algebraFracΩ

/-- The valuation subring of `Frac R` induced by the valuation of `Ω'`. -/
noncomputable def fracValuationSubring : ValuationSubring (FractionRing D.R) :=
  D.valuationSubring.comap (algebraMap (FractionRing D.R) D.Ω)

lemma algebraMap_fractionRing_Ω (s : D.R) :
    algebraMap (FractionRing D.R) D.Ω (algebraMap D.R _ s) = D.a s :=
  (IsScalarTower.algebraMap_apply D.R (FractionRing D.R) D.Ω s).symm

lemma mem_fracValuationSubring_iff {y : FractionRing D.R} :
    y ∈ D.fracValuationSubring ↔ algebraMap (FractionRing D.R) D.Ω y ∈ D.valuationSubring :=
  Iff.rfl

/-- Units of `R` have value `1` in `Frac R`. -/
lemma valuation_fracValuationSubring_unit (u : D.Rˣ) :
    D.fracValuationSubring.valuation (algebraMap D.R _ u) = 1 := by
  rw [fracValuationSubring, ValuationSubring.valuation_comap_eq_one_iff,
    algebraMap_fractionRing_Ω, D.valuation_a_eq_one_iff]
  exact u.isUnit

/-- An element of `Frac R` of value `≤ 1` lies in `R`. -/
lemma exists_algebraMap_eq_of_mem_fracValuationSubring {y : FractionRing D.R}
    (hy : y ∈ D.fracValuationSubring) : ∃ s : D.R, algebraMap D.R _ s = y := by
  rcases eq_or_ne y 0 with rfl | hy0
  · exact ⟨0, map_zero _⟩
  rcases ValuationRing.isInteger_or_isInteger D.R y with h | ⟨s, hs⟩
  · exact h
  have hs0 : D.a s ≠ 0 := by
    rw [← algebraMap_fractionRing_Ω, hs]
    exact (map_ne_zero _).2 (inv_ne_zero hy0)
  have hu : IsUnit s := by
    rw [← D.valuation_a_eq_one_iff]
    refine D.valuationSubring.valuation_eq_one_of_inv_mem hs0 (D.a_mem_valuationSubring s) ?_
    rwa [← algebraMap_fractionRing_Ω, hs, ← map_inv₀, inv_inv]
  refine ⟨↑hu.unit⁻¹, ?_⟩
  rw [← inv_inv y, ← hs]
  refine eq_inv_of_mul_eq_one_left ?_
  rw [← map_mul, IsUnit.val_inv_mul, map_one]

end FractionField

section Uniformizer

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [IsStrictlyHenselianLocalRing R] {Ω : Type u} [Field Ω] [Algebra R Ω]
  {κ : Type u} [Field κ] {b : R →+* κ} (D : SliceTrait (algebraMap R Ω) b)

attribute [local instance] algebraFracΩ

/-- The structure map of a slice trait maps a uniformizer to a uniformizer. -/
lemma irreducible_φ {ϖ : R} (hϖ : Irreducible ϖ) : Irreducible (D.φ ϖ) := by
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer] at hϖ ⊢
  rw [D.maximalIdeal_eq, hϖ, Ideal.map_span, Set.image_singleton]

instance faithfulSMul_fractionRing : FaithfulSMul R (FractionRing D.R) :=
  (faithfulSMul_iff_algebraMap_injective _ _).2 fun x y h ↦ D.injective_φ
    (IsFractionRing.injective D.R (FractionRing D.R)
      (by rwa [IsScalarTower.algebraMap_apply R D.R (FractionRing D.R),
        IsScalarTower.algebraMap_apply R D.R (FractionRing D.R) y] at h))

/-- The algebra structure `Frac R₁ ⟶ Frac R` of a slice trait. -/
noncomputable abbrev algebraFrac : Algebra (FractionRing R) (FractionRing D.R) :=
  FractionRing.liftAlgebra R _

attribute [local instance] algebraFrac

lemma algebraMap_fractionRing_fractionRing_Ω (r : R) :
    algebraMap (FractionRing D.R) D.Ω (algebraMap (FractionRing R) _ (algebraMap R _ r)) =
      D.a (D.φ r) := by
  rw [← IsScalarTower.algebraMap_apply R (FractionRing R) (FractionRing D.R),
    IsScalarTower.algebraMap_apply R D.R (FractionRing D.R), algebraMap_fractionRing_Ω]
  rfl

/-- The intersection of the valuation ring of `Frac R` with `Frac R₁` is `R₁`. -/
lemma algebraMap_mem_fracValuationSubring_iff (c : FractionRing R) :
    algebraMap (FractionRing R) (FractionRing D.R) c ∈ D.fracValuationSubring ↔
      c ∈ (algebraMap R (FractionRing R)).range := by
  refine ⟨fun hc ↦ ?_, ?_⟩
  · rcases eq_or_ne c 0 with rfl | hc0
    · exact ⟨0, map_zero _⟩
    rcases ValuationRing.isInteger_or_isInteger R c with h | ⟨r, hr⟩
    · exact h
    by_cases hu : IsUnit r
    · refine ⟨↑hu.unit⁻¹, ?_⟩
      rw [← inv_inv c, ← hr]
      refine eq_inv_of_mul_eq_one_left ?_
      rw [← map_mul, IsUnit.val_inv_mul, map_one]
    have hφ : ¬IsUnit (D.φ r) := fun h ↦ hu (isUnit_of_map_unit D.φ r h)
    have hlt := D.valuation_a_lt_one_iff.2 ((mem_maximalIdeal _).2 hφ)
    rw [mem_fracValuationSubring_iff, ← ValuationSubring.valuation_le_one_iff] at hc
    have h1 : algebraMap (FractionRing D.R) D.Ω (algebraMap (FractionRing R) _ c) * D.a (D.φ r) =
        1 := by
      rw [← algebraMap_fractionRing_fractionRing_Ω, ← map_mul, ← map_mul, hr,
        mul_inv_cancel₀ hc0, map_one, map_one]
    have := congrArg D.valuationSubring.valuation h1
    rw [map_mul, map_one] at this
    exact (((mul_le_of_le_one_left' hc).trans_lt hlt).ne this).elim
  · rintro ⟨r, rfl⟩
    rw [mem_fracValuationSubring_iff, algebraMap_fractionRing_fractionRing_Ω]
    exact D.a_mem_valuationSubring _

/-- Every value of `Frac R` is a value of `Frac R₁`: a uniformizer of `R₁` is one of `R`. -/
lemma exists_valuation_fracValuationSubring_eq (y : FractionRing D.R) (hy : y ≠ 0) :
    ∃ c : FractionRing R, D.fracValuationSubring.valuation y =
      D.fracValuationSubring.valuation (algebraMap (FractionRing R) _ c) := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have key (s : D.R) (hs : s ≠ 0) : ∃ n : ℕ, D.fracValuationSubring.valuation
      (algebraMap D.R _ s) = D.fracValuationSubring.valuation
        (algebraMap (FractionRing R) _ (algebraMap R _ (ϖ ^ n))) := by
    obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs
      (D.irreducible_φ hϖ)
    refine ⟨n, ?_⟩
    rw [map_mul, map_mul, valuation_fracValuationSubring_unit, one_mul,
      ← IsScalarTower.algebraMap_apply R (FractionRing R) (FractionRing D.R),
      IsScalarTower.algebraMap_apply R D.R (FractionRing D.R)]
    simp only [map_pow]
    rfl
  obtain ⟨s, t, ht, rfl⟩ := IsFractionRing.div_surjective (A := D.R) y
  have ht0 : t ≠ 0 := nonZeroDivisors.ne_zero ht
  have hs0 : s ≠ 0 := by
    rintro rfl
    simp at hy
  obtain ⟨n, hn⟩ := key s hs0
  obtain ⟨m, hm⟩ := key t ht0
  refine ⟨algebraMap R _ (ϖ ^ n) / algebraMap R _ (ϖ ^ m), ?_⟩
  rw [map_div₀, map_div₀, hn, hm, map_div₀]

/-- The elements of `Frac R₁` lie in the image of `Ω₁` in `Ω'`. -/
lemma exists_ωS_eq (c : FractionRing R) :
    ∃ w : Ω, D.ωS w = algebraMap (FractionRing D.R) D.Ω (algebraMap (FractionRing R) _ c) := by
  obtain ⟨r, s, -, rfl⟩ := IsFractionRing.div_surjective (A := R) c
  refine ⟨algebraMap R Ω r / algebraMap R Ω s, ?_⟩
  rw [map_div₀, map_div₀, map_div₀, algebraMap_fractionRing_fractionRing_Ω,
    algebraMap_fractionRing_fractionRing_Ω, ← RingHom.comp_apply, ← RingHom.comp_apply, D.ωS_comp]
  rfl

/-- **Residual independence gives linear independence of residues.** If the images in `Frac R` of
`uⱼ ∈ R` are residually independent over `Frac R₁`, their residues are linearly independent over
the residue field of `R₁`. -/
lemma linearIndependent_residue {ι : Type*} [Fintype ι] (u : ι → D.R)
    (h : D.fracValuationSubring.valuation.ResiduallyIndependent (FractionRing R)
      fun j ↦ algebraMap D.R (FractionRing D.R) (u j)) :
    LinearIndependent (ResidueField R) fun j ↦ residue D.R (u j) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc j
  choose r hr using fun j ↦ residue_surjective (c j)
  have hsum : ∑ j, D.φ (r j) * u j ∈ maximalIdeal D.R := by
    rw [← residue_eq_zero_iff, ← hc, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [← hr, Algebra.smul_def, ResidueField.algebraMap_residue, map_mul]
    rfl
  have hj := h (fun j ↦ algebraMap R (FractionRing R) (r j)) (fun j ↦ ?_) ?_ j
  · rw [fracValuationSubring, ValuationSubring.valuation_comap_lt_one_iff,
      algebraMap_fractionRing_fractionRing_Ω, D.valuation_a_lt_one_iff] at hj
    rw [← hr, residue_eq_zero_iff]
    exact (mem_maximalIdeal _).2 fun hu ↦ (mem_maximalIdeal _).1 hj (hu.map D.φ)
  · rw [fracValuationSubring, ValuationSubring.valuation_comap_le_one_iff,
      algebraMap_fractionRing_fractionRing_Ω, ValuationSubring.valuation_le_one_iff]
    exact D.a_mem_valuationSubring _
  · rw [fracValuationSubring, ValuationSubring.valuation_comap_lt_one_iff, map_sum]
    convert D.valuation_a_lt_one_iff.2 hsum using 2
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Algebra.smul_def, map_mul, map_mul, algebraMap_fractionRing_fractionRing_Ω,
      algebraMap_fractionRing_Ω]

end Uniformizer

section ValuationRing

variable {R : Type u} [CommRing R] [IsLocalRing R] {Ω : Type u} [Field Ω] [Algebra R Ω]
  {κ : Type u} [Field κ] {b : R →+* κ} (D : SliceTrait (algebraMap R Ω) b)

/-- The algebra structure `R ⟶ 𝒪` over the valuation ring `𝒪` of `Ω'`. -/
noncomputable abbrev algebraValuationSubring : Algebra D.R D.valuationSubring :=
  (D.a.codRestrict D.valuationSubring D.a_mem_valuationSubring).toAlgebra

/-- The algebra structure `R₁ ⟶ 𝒪` over the valuation ring `𝒪` of `Ω'`. -/
noncomputable abbrev algebraBaseValuationSubring : Algebra R D.valuationSubring :=
  ((D.a.codRestrict D.valuationSubring D.a_mem_valuationSubring).comp D.φ).toAlgebra

attribute [local instance] algebraValuationSubring algebraBaseValuationSubring

lemma coe_algebraMap_valuationSubring (s : D.R) :
    (algebraMap D.R D.valuationSubring s : D.Ω) = D.a s :=
  rfl

instance isScalarTower_valuationSubring : IsScalarTower R D.R D.valuationSubring :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

instance isScalarTower_valuationSubring_Ω : IsScalarTower R D.valuationSubring D.Ω :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

instance isLocalHom_algebraMap_valuationSubring :
    IsLocalHom (algebraMap D.R D.valuationSubring) :=
  ⟨fun _ hr ↦ D.valuation_a_eq_one_iff.1 ((D.valuationSubring.valuation_eq_one_iff _).1 hr)⟩

instance isLocalHom_algebraMap_base_valuationSubring :
    IsLocalHom (algebraMap R D.valuationSubring) :=
  ⟨fun r hr ↦ isUnit_of_map_unit D.φ r (isUnit_of_map_unit (algebraMap D.R _) _ hr)⟩

/-- The elements of the compositum `L = Ω₁(R)` are the sums `∑ ωᵢ kᵢ`, `ωᵢ ∈ Ω₁`, `kᵢ ∈ R`, when
`Spec(Ω₁ ⊗_{R₁} R)` is a point. -/
lemma exists_finset_eq_sum_of_mem_compositum [Subsingleton (PrimeSpectrum (Ω ⊗[R] D.R))]
    {z : D.Ω} (hz : z ∈ D.compositum) :
    ∃ s : Finset (Ω × D.R), z = ∑ i ∈ s, D.ωS i.1 * D.a i.2 := by
  obtain ⟨t, ht⟩ := surjective_traitTensorToCompositum R D.R Ω D.Ω ⟨z, hz⟩
  have h : (traitTensorToCompositum R D.R Ω D.Ω t : D.Ω) = z := congrArg Subtype.val ht
  obtain ⟨s, rfl⟩ := TensorProduct.exists_finset t
  refine ⟨s, ?_⟩
  rw [← h, map_sum, AddSubmonoidClass.coe_finsetSum]
  rfl

end ValuationRing

section Main

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [IsStrictlyHenselianLocalRing R] {Ω : Type u} [Field Ω] [Algebra R Ω]
  {κ : Type u} [Field κ] {b : R →+* κ} (D : SliceTrait (algebraMap R Ω) b)

attribute [local instance] algebraFracΩ algebraFrac algebraValuationSubring
  algebraBaseValuationSubring

/-- The residues of the integral elements of `Ω₁` lie in the perfect closure of the residue field
of `R₁`: they are integral over `R₁`, hence algebraic over its separably closed residue field. -/
lemma residue_mem_perfectClosure [FaithfulSMul R Ω] [Algebra.IsAlgebraic R Ω] {ω : Ω}
    (hω : D.ωS ω ∈ D.valuationSubring) :
    residue D.valuationSubring ⟨D.ωS ω, hω⟩ ∈
      perfectClosure (ResidueField R) (ResidueField D.valuationSubring) := by
  have := D.isAlgebraic_a
  have hint : _root_.IsIntegral R ω := by
    have h : ω ∈ (IsDiscreteValuationRing.integralClosureValuationSubring D.R D.Ω).comap
        (algebraMap Ω D.Ω) := hω
    rwa [IsDiscreteValuationRing.comap_integralClosureValuationSubring (R := R)] at h
  have h₁ : _root_.IsIntegral R (⟨D.ωS ω, hω⟩ : D.valuationSubring) := by
    rw [← isIntegral_algHom_iff (IsScalarTower.toAlgHom R D.valuationSubring D.Ω)
      Subtype.val_injective]
    exact hint.map (IsScalarTower.toAlgHom R Ω D.Ω)
  have h₂ : _root_.IsIntegral (ResidueField R) (residue D.valuationSubring ⟨D.ωS ω, hω⟩) :=
    (h₁.map (IsScalarTower.toAlgHom R D.valuationSubring
      (ResidueField D.valuationSubring))).tower_top
  exact le_perfectClosure _ _ (algebraicClosure _ _) (mem_algebraicClosure_iff.2 h₂.isAlgebraic)

/-- **The residue of `x` is not a `p`-th power in the residue field of the compositum.** Let `D`
be a slice trait over a complete strictly henselian trait `R₁` of residue characteristic `p`,
with `Spec(Ω₁ ⊗_{R₁} R)` a point, and `x ∈ R` whose residue `x̄` is transcendental over the
residue field `k` of `R₁`, the residue field of `R` being separable algebraic over `k(x̄)`. Then
`v(x - z ^ p) = 1` for every `z` in the compositum `L = Ω₁(R)` with `v(z) ≤ 1`. -/
theorem valuation_a_sub_pow_eq_one_of_isSeparable [IsAdicComplete (maximalIdeal R) R]
    (p : ℕ) [Fact p.Prime] [CharP (ResidueField R) p] [FaithfulSMul R Ω]
    [Algebra.IsAlgebraic R Ω] [Subsingleton (PrimeSpectrum (Ω ⊗[R] D.R))] {x : D.R}
    (htr : Transcendental (ResidueField R) (residue D.R x))
    (hsep : ∀ y : ResidueField D.R, IsSeparable (ResidueField R)⟮residue D.R x⟯ y)
    {z : D.Ω} (hz : z ∈ D.compositum) (hz1 : D.valuationSubring.valuation z ≤ 1) :
    D.valuationSubring.valuation (D.a x - z ^ p) = 1 := by
  classical
  obtain ⟨s, rfl⟩ := D.exists_finset_eq_sum_of_mem_compositum hz
  -- the cartesian lemma for the span of the `kᵢ` over `Frac R₁`
  let V : Submodule (FractionRing R) (FractionRing D.R) :=
    Submodule.span (FractionRing R) (Set.range fun i : s ↦ algebraMap D.R (FractionRing D.R) i.1.2)
  have : FiniteDimensional (FractionRing R) V :=
    FiniteDimensional.span_of_finite _ (Set.finite_range _)
  obtain ⟨e, he1, hind⟩ := ValuationSubring.exists_basis_residuallyIndependent (R := R)
    (𝒪 := D.fracValuationSubring) D.algebraMap_mem_fracValuationSubring_iff
    D.exists_valuation_fracValuationSubring_eq V
  have hmem (j) : (e j : FractionRing D.R) ∈ D.fracValuationSubring :=
    (ValuationSubring.valuation_le_one_iff _ _).1 (he1 j).le
  choose u hu using fun j ↦ D.exists_algebraMap_eq_of_mem_fracValuationSubring (hmem j)
  have hu1 (j) : D.valuationSubring.valuation (D.a (u j)) = 1 := by
    rw [← algebraMap_fractionRing_Ω, hu j, ← ValuationSubring.valuation_comap_eq_one_iff]
    exact he1 j
  -- the residues of the `uⱼ` are linearly independent over the perfect closure of `k`
  have hlin : LinearIndependent (ResidueField R) fun j ↦ residue D.R (u j) :=
    D.linearIndependent_residue u (by simpa only [hu] using hind)
  have hlin' := hlin.algebraMap_perfectClosure_of_transcendental
    (E := ResidueField D.valuationSubring) htr hsep
  have hres : D.valuationSubring.valuation.ResiduallyIndependent Ω
      fun j ↦ ((algebraMap D.R D.valuationSubring (u j) : D.valuationSubring) : D.Ω) :=
    Valuation.ResiduallyIndependent.of_linearIndependent_residue
      (A := perfectClosure (ResidueField R) (ResidueField D.valuationSubring))
      (fun _ hc ↦ ⟨⟨_, D.residue_mem_perfectClosure hc⟩, rfl⟩) _ hlin'
  -- rewrite `z = ∑ ω'ⱼ uⱼ` with `ω'ⱼ ∈ Ω₁`
  choose w hw using D.exists_ωS_eq
  have hk (i : s) : algebraMap D.R (FractionRing D.R) i.1.2 ∈ V := Submodule.subset_span ⟨i, rfl⟩
  have hDa (i : s) : D.a i.1.2 = ∑ j, D.ωS (w (e.repr ⟨_, hk i⟩ j)) * D.a (u j) := by
    have hrepr : algebraMap D.R (FractionRing D.R) i.1.2 =
        ∑ j, e.repr ⟨_, hk i⟩ j • (e j : FractionRing D.R) := by
      have h := congrArg Subtype.val (e.sum_repr ⟨_, hk i⟩)
      rw [AddSubmonoidClass.coe_finsetSum] at h
      simpa using h.symm
    rw [← algebraMap_fractionRing_Ω]
    refine (congrArg (algebraMap (FractionRing D.R) D.Ω) hrepr).trans ?_
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Algebra.smul_def, map_mul, hw, ← hu j, algebraMap_fractionRing_Ω]
  let W (j) : Ω := ∑ i : s, i.1.1 * w (e.repr ⟨_, hk i⟩ j)
  have hz : ∑ i ∈ s, D.ωS i.1 * D.a i.2 =
      ∑ j, W j • ((algebraMap D.R D.valuationSubring (u j) : D.valuationSubring) : D.Ω) := by
    rw [← Finset.sum_coe_sort s]
    simp_rw [hDa, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Algebra.smul_def, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_mul, coe_algebraMap_valuationSubring, mul_assoc]
    rfl
  -- `v(z) = maxⱼ v(ω'ⱼ)`, so that the `ω'ⱼ` are integral
  have hval := hres.map_sum_smul (fun j ↦ hu1 j) W
  rw [← hz] at hval
  have hWmem (j) : D.ωS (W j) ∈ D.valuationSubring :=
    (ValuationSubring.valuation_le_one_iff _ _).1 ((Finset.le_sup
      (f := fun j ↦ D.valuationSubring.valuation (algebraMap Ω D.Ω (W j)))
      (Finset.mem_univ j)).trans (hval ▸ hz1))
  -- the residue of `z` lies in the ring generated by `k^{perf}` and the residue field of `R`
  let Z : D.valuationSubring :=
    ∑ j, ⟨D.ωS (W j), hWmem j⟩ * algebraMap D.R D.valuationSubring (u j)
  have hZ : ((algebraMap D.R D.valuationSubring x - Z ^ p : D.valuationSubring) : D.Ω) =
      D.a x - (∑ i ∈ s, D.ωS i.1 * D.a i.2) ^ p := by
    rw [hz]
    simp [Z, Algebra.smul_def]
    rfl
  have : CharP (ResidueField D.valuationSubring) p :=
    charP_of_injective_algebraMap (algebraMap (ResidueField R) _).injective p
  rw [← hZ]
  refine (D.valuationSubring.valuation_lt_one_or_eq_one _).resolve_left fun hlt ↦ ?_
  rw [← ValuationSubring.valuation_lt_one_iff, ← residue_eq_zero_iff, map_sub, sub_eq_zero,
    map_pow, ← ResidueField.algebraMap_residue] at hlt
  refine sum_mul_pow_ne_algebraMap (k := ResidueField R) p htr hsep Finset.univ
    (fun j ↦ residue D.valuationSubring ⟨D.ωS (W j), hWmem j⟩)
    (fun j ↦ D.residue_mem_perfectClosure (hWmem j)) (fun j ↦ residue D.R (u j)) ?_
  rw [hlt]
  simp [Z, ResidueField.algebraMap_residue]

end Main

section StrictLocalization

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [IsStrictlyHenselianLocalRing R] {Ω : Type u} [Field Ω] {a : R →+* Ω}
  (ha : Function.Injective a) (halg : letI := a.toAlgebra; Algebra.IsAlgebraic R Ω)
  {κ : Type u} [Field κ] {b : R →+* κ} (hb : RingHom.ker b = maximalIdeal R)

local notation "𝒟" => sliceTraitOfStrictLocalization (a₁ := a) (b₁ := b) ha halg hb

/-- The evaluation `κ(R) ⟶ κ₁(x)^alg` of the residue field of the strict localization as a map of
algebras over the residue field of `R₁`. -/
noncomputable abbrev residueEvalAlgHom :
    letI := a.toAlgebra
    letI := ((algebraMap κ (traitSliceField κ)).comp (residueFieldLiftOfKerEq b hb)).toAlgebra
    ResidueField (𝒟).R →ₐ[ResidueField R] traitSliceField κ :=
  letI := a.toAlgebra
  letI := ((algebraMap κ (traitSliceField κ)).comp (residueFieldLiftOfKerEq b hb)).toAlgebra
  { sliceTraitResidueEval b with
    commutes' := fun c ↦ DFunLike.congr_fun (sliceTraitResidueEval_comp_algebraMap b hb) c }

include ha halg hb in
lemma residueEvalAlgHom_residue (x : (𝒟).R) :
    residueEvalAlgHom ha halg hb (residue (𝒟).R x) = (𝒟).b x :=
  rfl

include ha halg hb in
/-- The residue of an element of the strict localization evaluating to the coordinate is
transcendental over the residue field of `R₁`. -/
lemma transcendental_residue_of_b_eq {x : (𝒟).R} (hx : (𝒟).b x = traitSliceCoord κ) :
    letI := a.toAlgebra
    Transcendental (ResidueField R) (residue (𝒟).R x) := by
  let := a.toAlgebra
  let := ((algebraMap κ (traitSliceField κ)).comp (residueFieldLiftOfKerEq b hb)).toAlgebra
  rw [Transcendental, ← isAlgebraic_algHom_iff (residueEvalAlgHom ha halg hb)
    (residueEvalAlgHom ha halg hb).toRingHom.injective, residueEvalAlgHom_residue, hx]
  exact transcendental_residueField_traitSliceCoord b hb

include ha halg hb in
/-- The residue field of the strict localization is separable algebraic over the subfield
generated by the residue of an element evaluating to the coordinate. -/
lemma isSeparable_residue_of_b_eq {x : (𝒟).R} (hx : (𝒟).b x = traitSliceCoord κ) :
    letI := a.toAlgebra
    ∀ y : ResidueField (𝒟).R, IsSeparable (ResidueField R)⟮residue (𝒟).R x⟯ y := by
  let := a.toAlgebra
  let := ((algebraMap κ (traitSliceField κ)).comp (residueFieldLiftOfKerEq b hb)).toAlgebra
  let := (slicePrimeResidueFieldHom b).toAlgebra
  intro y
  have hmap : ((ResidueField R)⟮residue (𝒟).R x⟯).map (residueEvalAlgHom ha halg hb) =
      (ResidueField R)⟮traitSliceCoord κ⟯ := by
    rw [IntermediateField.adjoin_map, Set.image_singleton, residueEvalAlgHom_residue, hx]
  have hmem (w : (RingHom.ker (sliceTraitPointRingHom b)).ResidueField) :
      slicePrimeResidueFieldHom b w ∈
        ((ResidueField R)⟮residue (𝒟).R x⟯).map (residueEvalAlgHom ha halg hb) :=
    hmap ▸ slicePrimeResidueFieldHom_mem_adjoin b hb w
  let e := IntermediateField.equivMap (ResidueField R)⟮residue (𝒟).R x⟯
    (residueEvalAlgHom ha halg hb)
  refine IsSeparable.of_ringHom_comp_apply (F := ResidueField (𝒟).R)
    (sliceTraitResidueEval b : ResidueField (𝒟).R →+* traitSliceField κ)
    (e.symm.toRingEquiv.toRingHom.comp ((slicePrimeResidueFieldHom b).codRestrict _ hmem))
    (RingHom.ext fun w ↦ ?_) (isSeparable_sliceTraitResidueEval b y)
  have h := IntermediateField.coe_equivMap_apply _ (residueEvalAlgHom ha halg hb)
    (e.symm ⟨_, hmem w⟩)
  rw [AlgEquiv.apply_symm_apply] at h
  exact h.symm

include ha halg hb in
/-- **The residue of the coordinate is not a `p`-th power** in the residue field of the
compositum `L = Ω(S(x))` of the strict localization of `𝔸¹` over a complete strictly henselian
trait, `p` the residual characteristic: `v(x - z ^ p) = 1` for `z ∈ L` with `v(z) ≤ 1`. -/
theorem valuation_a_sub_pow_eq_one_of_complete [IsAlgClosed Ω] [IsSepClosed κ]
    [IsAdicComplete (maximalIdeal R) R] (p : ℕ)
    [Fact p.Prime] [CharP (ResidueField R) p] {x : (𝒟).R} (hx : (𝒟).b x = traitSliceCoord κ)
    {z : (𝒟).Ω} (hz : letI := a.toAlgebra; z ∈ (𝒟).compositum)
    (hz1 : (𝒟).valuationSubring.valuation z ≤ 1) :
    (𝒟).valuationSubring.valuation ((𝒟).a x - z ^ p) = 1 := by
  let := a.toAlgebra
  have : FaithfulSMul R Ω := (faithfulSMul_iff_algebraMap_injective _ _).2 ha
  have := halg
  have := (𝒟).subsingleton_primeSpectrum ha halg
  exact (𝒟).valuation_a_sub_pow_eq_one_of_isSeparable p
    (transcendental_residue_of_b_eq ha halg hb hx) (isSeparable_residue_of_b_eq ha halg hb hx)
    hz hz1

end StrictLocalization

end AlgebraicGeometry.SliceTrait
