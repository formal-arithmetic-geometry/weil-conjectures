module

public import WeilConjectures.TraceFormula.Specialization.NearbyCycles
public import Mathlib.AlgebraicGeometry.Morphisms.Finite

/-!

# The fixed locus of the specialized correspondence

Let `c = (c₁, c₂) : C ⟶ X × X` be contracting at the `k`-point `y` of its support, with
`x = c₁(y) = c₂(y)`, and let `c' = (γ₁, γ₂) : N_y C ⊗ k' ⟶ N_x X ⊗ k'` be the specialized
correspondence (`ProEtale.CondensedRing.Correspondence.IsContractingAt.specialCorrespondence`).
Following Varshavsky (*Lefschetz–Verdier trace formula and a generalization of a theorem of
Fujiwara*, §1–2), we show:

* the first special leg `γ₁` maps only the zero section into the zero section
  (`ProEtale.CondensedRing.Correspondence.IsContractingAt.mem_range_zeroSection_of_specialLeg₁`,
  blueprint `lemma-normal-cones-contracting-ideals` (1)): since the fibre `c₁⁻¹(x)` is the reduced
  point `y`, the ideal of `y` is generated by the pullback of the ideal of `x`;
* the zero locus of the special fibre of the deformation to the normal cone of a rational point
  has at most one point (`ProEtale.CondensedRing.subsingleton_deformationSpecialZeroLocus`);
* hence the fixed locus of `c'` has at most one point
  (`ProEtale.CondensedRing.Correspondence.IsContractingAt.subsingleton_specialFixedLocus`), and is
  proper over `k'`
  (`ProEtale.CondensedRing.Correspondence.IsContractingAt.isProper_specialFixedLocus_hom`).

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry

namespace ProEtale.CondensedRing

open Scheme

section ZeroLocus

variable {k : Type u} [Field k] {X : Over (Spec (.of k))} (x : RationalPoint X)
  (k' : Type u) [Field k'] [Algebra k k']

/-- The lift `Spec k ⟶ V(ker x)` of a rational point `x` is an isomorphism. -/
instance isIso_quotientSpecLift : IsIso (quotientSpecLift x) := by
  have : IsClosedImmersion x.left := isClosedImmersion_of_comp_eq_id X.hom x.left (Over.w x)
  rw [(existsUnique_quotientSpecLift x).unique (quotientSpecLift_toBase x)
    x.left.toQuotientSpec_toBase]
  infer_instance

/-- The zero locus `Z₀` of the special fibre of the deformation to the normal cone of a rational
point `x` is the fibre product `Spec k' ×_{𝔸¹_k} V(ker x)` of the origin of the affine line with
the composite `V(ker x) ⟶ N_x X ⟶ D_x X ⟶ 𝔸¹_k`. -/
lemma isPullback_deformationSpecialZeroLocus (I : X.left.IdealSheafData) :
    IsPullback (deformationSpecialZeroLocus X I k').hom
      (deformationSpecialZeroLocusToQuotientSpec X I k')
      (traitClosedPoint k' ≫ traitToAffineLine k k')
      (I.normalConeZeroSection ≫ I.normalConeToDeformationSpace ≫
        deformationSpaceToAffineLine X I) := by
  have hA : IsPullback (deformationSpecialZeroLocusToQuotientSpec X I k')
      (deformationSpecialFibreZeroSection X I k').left I.normalConeZeroSection
      (deformationSpecialFibreToNormalCone X I k') :=
    (IsPullback.of_hasPullback _ _).flip
  have hB : IsPullback (deformationSpecialFibreToNormalCone X I k') (𝟙 _)
      I.normalConeToDeformationSpace
      (deformationSpecialFibreToNormalCone X I k' ≫ I.normalConeToDeformationSpace) :=
    (IsPullback.of_horiz_isIso_mono (fst := 𝟙 _) ⟨by simp⟩).flip
  have hC : IsPullback
      (deformationSpecialFibreToNormalCone X I k' ≫ I.normalConeToDeformationSpace)
      (deformationSpecialFibre X I k').hom (deformationSpaceToAffineLine X I)
      (traitClosedPoint k' ≫ traitToAffineLine k k') := by
    rw [deformationSpecialFibreToNormalCone_normalConeToDeformationSpace]
    exact (isPullback_deformationSpecialFibre X I k').paste_horiz
      (isPullback_deformationTotal X I k')
  have := (hA.paste_vert hB).paste_vert hC
  rw [Category.comp_id, Category.assoc] at this
  exact this.flip

/-- **The zero locus of the special fibre is a point**: the zero locus `Z₀` of the special fibre
`N_x X ⊗ k'` of the deformation to the normal cone of a rational point `x` has at most one point
(it is `Spec k ×_k Spec k' = Spec k'`). -/
theorem subsingleton_deformationSpecialZeroLocus :
    Subsingleton (deformationSpecialZeroLocus X x.left.ker k').left := by
  have hv : x.left.ker.normalConeZeroSection ≫ x.left.ker.normalConeToDeformationSpace ≫
      deformationSpaceToAffineLine X x.left.ker =
      inv (quotientSpecLift x) ≫ AffineSpace.zeroSection (ULift.{u} (Fin 1)) (Spec (.of k)) := by
    rw [IsIso.eq_inv_comp, ← deformationSpaceVertex_deformationSpaceToAffineLine x,
      deformationSpaceVertex, Category.assoc, Category.assoc]
  have : IsClosedImmersion (AffineSpace.zeroSection (ULift.{u} (Fin 1)) (Spec (.of k))) :=
    isClosedImmersion_of_comp_eq_id _ _ (AffineSpace.zeroSection_over _ _)
  have h := MorphismProperty.of_isPullback (P := @IsClosedImmersion)
    (isPullback_deformationSpecialZeroLocus k' x.left.ker).flip (by rw [hv]; infer_instance)
  have : Subsingleton (Spec (.of k')) := inferInstanceAs (Subsingleton (PrimeSpectrum k'))
  exact h.isClosedEmbedding.injective.subsingleton

end ZeroLocus

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]
  {X : Over (Spec (.of k))} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  {K : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧}

namespace Correspondence

variable {c : Correspondence ℓ K} {y : RationalPoint c.C} (hc : c.IsContractingAt y)
  (k' : Type u) [Field k'] [Algebra k k']

namespace IsContractingAt

include hc in
/-- **The ideal of `y` is generated by the ideal of `x = c₁(y)`**: for `c` contracting at `y`,
the fibre `c₁⁻¹(x)` is the reduced point `y`, so on all pairs of affine opens `U' ⊆ c₁⁻¹ U` the
ideal of `y` is the extension of the ideal of `x` (blueprint `lemma-normal-cones-contracting-ideals`
(1)). -/
lemma ker_map_eq_c₁ ⦃U' : c.C.left.AffineZariskiSite⦄ ⦃U : X.left.AffineZariskiSite⦄
    (hU : U'.1 ≤ c.c₁.left ⁻¹ᵁ U.1) :
    ((y ≫ c.c₁).left.ker.siteIdeal U).map (c.c₁.left.appLE U.1 U'.1 hU).hom =
      y.left.ker.siteIdeal U' := by
  have : IsClosedImmersion (y ≫ c.c₁).left :=
    isClosedImmersion_of_comp_eq_id X.hom _ (Over.w (y ≫ c.c₁))
  have sq : IsPullback y.left (𝟙 _) c.c₁.left (y ≫ c.c₁).left := hc.isPullback.map (Over.forget _)
  have hker : y.left.ker = (y ≫ c.c₁).left.ker.comap c.c₁.left := by
    rw [← sq.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
      IdealSheafData.ker_fst_of_isClosedImmersion]
  rw [hker]
  exact (IdealSheafData.ideal_comap_appLE _ _ ⟨U.1, U.2⟩ ⟨U'.1, U'.2⟩ hU).symm

/-- **The first special leg reflects the zero section** (blueprint
`lemma-normal-cones-contracting-ideals` (1); Varshavsky, *Lefschetz–Verdier trace formula and a
generalization of a theorem of Fujiwara*, §1–2): a point of the special fibre `N_y C ⊗ k'` which
`γ₁` maps into the zero section of `N_x X ⊗ k'` lies on the zero section of `N_y C ⊗ k'`. -/
theorem mem_range_zeroSection_of_specialLeg₁ {p : (deformationSpecialFibre c.C y.left.ker k').left}
    (hp : (hc.specialLeg₁ k').left p ∈
      Set.range (deformationSpecialFibreZeroSection X (y ≫ c.c₁).left.ker k').left) :
    p ∈ Set.range (deformationSpecialFibreZeroSection c.C y.left.ker k').left := by
  rw [range_deformationSpecialFibreZeroSection] at hp ⊢
  rw [Set.mem_preimage, ← Scheme.Hom.comp_apply, deformationSpecialFibreMap_toNormalCone,
    Scheme.Hom.comp_apply] at hp
  rw [Set.mem_preimage,
    ← IdealSheafData.preimage_range_normalConeZeroSection _ _ _ hc.ker_map_eq_c₁]
  exact hp

variable [IsSepClosed k'] [Fact (ringChar k').Prime] [Fact (ringChar k' ≠ ℓ)]

/-- **The fixed locus of the specialized correspondence is at most a point** (Varshavsky,
*Lefschetz–Verdier trace formula and a generalization of a theorem of Fujiwara*, §2; blueprint
`lemma-normal-cones-contracting-ideals`): a point of the fixed locus `F'` of `c' = (γ₁, γ₂)` maps to
a point `p` of `N_y C ⊗ k'` with `γ₁ p = γ₂ p`; as `γ₂` lands in the zero section, so does `γ₁ p`,
hence `p` lies on the zero section of `N_y C ⊗ k'`, which is a single point. -/
theorem subsingleton_specialFixedLocus : Subsingleton (hc.specialFixedLocus k').F.left := by
  change Subsingleton (fixedLocusOfDiag (hc.specialLeg₁ k') (hc.specialLeg₂ k')).left
  have hι : Function.Injective (fixedLocusOfDiag.ι (hc.specialLeg₁ k') (hc.specialLeg₂ k')).left :=
    Scheme.Hom.injective _
  have : Subsingleton (deformationSpecialZeroLocus c.C y.left.ker k').left :=
    subsingleton_deformationSpecialZeroLocus y k'
  have hmem (q : (fixedLocusOfDiag (hc.specialLeg₁ k') (hc.specialLeg₂ k')).left) :
      (fixedLocusOfDiag.ι (hc.specialLeg₁ k') (hc.specialLeg₂ k')).left q ∈
        Set.range (deformationSpecialFibreZeroSection c.C y.left.ker k').left := by
    refine hc.mem_range_zeroSection_of_specialLeg₁ k' ?_
    have hw := congrArg (fun f ↦ f.left q) (fixedLocusOfDiag.w (hc.specialLeg₁ k')
      (hc.specialLeg₂ k'))
    simp only [Over.comp_left, Scheme.Hom.comp_apply] at hw
    exact hw ▸ hc.range_specialLeg₂_subset k' (Set.mem_range_self _)
  refine ⟨fun q₁ q₂ ↦ hι ?_⟩
  obtain ⟨z₁, hz₁⟩ := hmem q₁
  obtain ⟨z₂, hz₂⟩ := hmem q₂
  rw [← hz₁, ← hz₂, Subsingleton.elim z₁ z₂]

/-- **The fixed locus of the specialized correspondence is proper** over `k'`: it is of finite
type and separated over the field `k'` and has at most one point
(`ProEtale.CondensedRing.Correspondence.IsContractingAt.subsingleton_specialFixedLocus`), hence
is finite. -/
instance isProper_specialFixedLocus_hom : IsProper (hc.specialFixedLocus k').F.hom := by
  have : Subsingleton (fixedLocusOfDiag (hc.specialLeg₁ k') (hc.specialLeg₂ k')).left :=
    hc.subsingleton_specialFixedLocus k'
  change IsProper (fixedLocusOfDiag (hc.specialLeg₁ k') (hc.specialLeg₂ k')).hom
  exact isProper_of_subsingleton _

end IsContractingAt

end Correspondence

end ProEtale.CondensedRing

end AlgebraicGeometry
