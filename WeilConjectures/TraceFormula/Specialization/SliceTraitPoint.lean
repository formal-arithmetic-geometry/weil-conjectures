/-!

# The generic point of the special fibre of `𝔸¹` over a trait

Let `R₁` be a local ring, `κ₁` a field and `b₁ : R₁ →+* κ₁` a ring map with kernel the maximal
ideal of `R₁` (so `κ₁` is a field extension of the residue field of `R₁`). Let
`K = κ₁(x)^alg` (`AlgebraicGeometry.traitSliceField`). The geometric point
`AlgebraicGeometry.sliceTraitPoint b₁ : Spec K ⟶ 𝔸¹_{R₁}` given by `r ↦ b₁ r` on coefficients and
`x ↦ x` lies over the generic point of the special fibre of `𝔸¹_{R₁}`. Its prime in `R₁[x]` is
`𝔪 R₁[x]`, as `x` is transcendental over `κ₁`.

When `R₁` is a discrete valuation ring with uniformizer `π`, the local ring of `𝔸¹_{R₁}` at this
point, `R₁[x]_{(π)}`, is a discrete valuation ring; being regular of dimension one passes to strict
henselizations, so the strict henselization `𝒪^{sh}_{𝔸¹_{R₁}, s}` is a discrete valuation ring
whose maximal ideal is generated by `π`. This generalises
`AlgebraicGeometry.isDiscreteValuationRing_strictHenselization_genericSlicePoint`
(the case `R₁ = k'⟦t⟧`, `b₁ = constantCoeff`, see
`AlgebraicGeometry.genericSlicePoint_eq_sliceTraitPoint`).

## Main results

- `AlgebraicGeometry.ker_sliceTraitPointRingHom`: the prime of `R₁[x]` under `s` is `𝔪 R₁[x]`.
- `AlgebraicGeometry.isDiscreteValuationRing_strictHenselization_sliceTraitPoint`
- `AlgebraicGeometry.maximalIdeal_strictHenselization_sliceTraitPoint`: the maximal ideal of the
  strict localization is generated by the maximal ideal of `R₁`.
- `AlgebraicGeometry.injective_sliceTraitStructureMap`, `isLocalHom_sliceTraitStructureMap`.
- `AlgebraicGeometry.weaklyEtale_strictLocalizationToBase_sliceTraitPoint`
- `AlgebraicGeometry.genericSlicePoint_eq_sliceTraitPoint`: compatibility with the case
  `R₁ = k'⟦t⟧`.

-/

@[expose] public section

universe u

open CategoryTheory IsLocalRing

namespace AlgebraicGeometry

open Scheme

variable {R₁ : Type u} [CommRing R₁] {κ₁ : Type u} [Field κ₁] (b₁ : R₁ →+* κ₁)

/-- The ring map `R₁[x] ⟶ K` (`K = κ₁(x)^alg`) of the geometric point `sliceTraitPoint b₁`:
coefficients are mapped by `b₁` and `x ↦ x`. -/
noncomputable def sliceTraitPointRingHom :
    MvPolynomial (ULift.{u} (Fin 1)) R₁ →+* traitSliceField κ₁ :=
  MvPolynomial.eval₂Hom ((algebraMap κ₁ (traitSliceField κ₁)).comp b₁)
    fun _ ↦ traitSliceCoord κ₁

/-- The geometric point `Spec K ⟶ 𝔸¹_{R₁}` (`K = κ₁(x)^alg`) over the generic point of the special
fibre of `𝔸¹_{R₁}`. -/
noncomputable def sliceTraitPoint :
    Spec (.of (traitSliceField κ₁)) ⟶ 𝔸(ULift.{u} (Fin 1); Spec (.of R₁)) :=
  Spec.map (CommRingCat.ofHom (sliceTraitPointRingHom b₁)) ≫
    (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv

/-- The geometric point `sliceTraitPoint b₁` in the affine chart `Spec R₁[x] ≅ 𝔸¹_{R₁}`. -/
lemma sliceTraitPoint_eq :
    sliceTraitPoint b₁ = Spec.map (CommRingCat.ofHom (sliceTraitPointRingHom b₁)) ≫
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv :=
  rfl

/-- `sliceTraitPointRingHom` factors as `MvPolynomial.map b₁` followed by the evaluation
`κ₁[x] ⟶ K` at `x`. -/
lemma sliceTraitPointRingHom_eq :
    sliceTraitPointRingHom b₁ =
      (MvPolynomial.aeval (R := κ₁) fun _ : ULift.{u} (Fin 1) ↦ traitSliceCoord κ₁).toRingHom.comp
        (MvPolynomial.map b₁) := by
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
  · simp [sliceTraitPointRingHom]
  · simp [sliceTraitPointRingHom]

/-- The kernel of `R₁[x] ⟶ K` is the extension of the kernel of `b₁`, as `x` is transcendental
over `κ₁`. -/
lemma ker_sliceTraitPointRingHom' :
    RingHom.ker (sliceTraitPointRingHom b₁) = (RingHom.ker b₁).map MvPolynomial.C := by
  have hinj : Function.Injective
      (MvPolynomial.aeval (R := κ₁) fun _ : ULift.{u} (Fin 1) ↦ traitSliceCoord κ₁) :=
    algebraicIndependent_iff_injective_aeval.mp
      ((algebraicIndependent_unique_type_iff (R := κ₁)
        (x := fun _ : ULift.{u} (Fin 1) ↦ traitSliceCoord κ₁)).mpr
          (transcendental_traitSliceCoord κ₁))
  rw [sliceTraitPointRingHom_eq, RingHom.ker_comp_of_injective _ hinj, MvPolynomial.ker_map]

/-- **The prime of the generic point of the special fibre.** If `ker b₁ = 𝔪`, the kernel of
`R₁[x] ⟶ K` is `𝔪 R₁[x]`. -/
lemma ker_sliceTraitPointRingHom [IsLocalRing R₁] (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    RingHom.ker (sliceTraitPointRingHom b₁) = (maximalIdeal R₁).map MvPolynomial.C := by
  rw [ker_sliceTraitPointRingHom', hb₁]

/-- For a discrete valuation ring `R₁` with uniformizer `π`, the prime of `R₁[x]` under the generic
point of the special fibre is `(π)`. -/
lemma ker_sliceTraitPointRingHom_eq_span [IsDomain R₁] [IsDiscreteValuationRing R₁]
    (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) {π : R₁} (hπ : Irreducible π) :
    RingHom.ker (sliceTraitPointRingHom b₁) = Ideal.span {MvPolynomial.C π} := by
  rw [ker_sliceTraitPointRingHom b₁ hb₁, hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]

/-- The maximal ideal of the localization of `R₁[x]` at `(π)` is generated by `π`. -/
lemma maximalIdeal_localization_ker_sliceTraitPointRingHom [IsDomain R₁]
    [IsDiscreteValuationRing R₁] (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) {π : R₁}
    (hπ : Irreducible π) :
    maximalIdeal (Localization.AtPrime (RingHom.ker (sliceTraitPointRingHom b₁))) =
      Ideal.span {(algebraMap (MvPolynomial (ULift.{u} (Fin 1)) R₁)
        (Localization.AtPrime (RingHom.ker (sliceTraitPointRingHom b₁)))
        (MvPolynomial.C π))} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (RingHom.ker (sliceTraitPointRingHom b₁)),
    ← Set.image_singleton, ← Ideal.map_span]
  exact congrArg _ (ker_sliceTraitPointRingHom_eq_span b₁ hb₁ hπ)

/-- The local ring of `𝔸¹_{R₁}` at the generic point of the special fibre, the localization of
`R₁[x]` at `(π)`, is a discrete valuation ring with uniformizer `π`. -/
theorem isDiscreteValuationRing_localization_ker_sliceTraitPointRingHom [IsDomain R₁]
    [IsDiscreteValuationRing R₁] (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    IsDiscreteValuationRing
      (Localization.AtPrime (RingHom.ker (sliceTraitPointRingHom b₁))) := by
  set q := RingHom.ker (sliceTraitPointRingHom b₁)
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R₁
  refine .of_maximalIdeal_eq_span_singleton ?_
    (maximalIdeal_localization_ker_sliceTraitPointRingHom b₁ hb₁ hπ)
  rw [ne_eq, map_eq_zero_iff _ (IsLocalization.injective (Localization.AtPrime q)
      q.primeCompl_le_nonZeroDivisors), MvPolynomial.C_eq_zero]
  exact hπ.ne_zero

/-- The prime of the affine chart under the generic point of the special fibre. -/
private lemma asIdeal_sliceTraitPoint_closedPoint :
    (Spec.map (CommRingCat.ofHom (sliceTraitPointRingHom b₁))
      (IsLocalRing.closedPoint (traitSliceField κ₁))).asIdeal =
        RingHom.ker (sliceTraitPointRingHom b₁) := by
  rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.eq_bot_of_prime
    (IsLocalRing.closedPoint (traitSliceField κ₁)).asIdeal, ← RingHom.ker_eq_comap_bot]
  rfl

/-- The strict henselization of `𝔸¹_{R₁}` at the generic point of the special fibre is a regular
local ring of dimension one. -/
theorem isRegularLocalRing_and_ringKrullDim_strictHenselization_sliceTraitPoint [IsDomain R₁]
    [IsDiscreteValuationRing R₁] (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    IsRegularLocalRing (strictHenselization (sliceTraitPoint b₁)) ∧
      ringKrullDim (strictHenselization (sliceTraitPoint b₁)) = 1 := by
  rw [sliceTraitPoint_eq]
  obtain ⟨q, _, K, _, _, _, _, _, _, b, hq, -, -, hH⟩ :=
    Scheme.strictHenselization_chart_isStrictHenselization _
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv
      (Spec.map (CommRingCat.ofHom (sliceTraitPointRingHom b₁)))
  obtain rfl : q = RingHom.ker (sliceTraitPointRingHom b₁) := by
    rw [hq, asIdeal_sliceTraitPoint_closedPoint]
  have := isDiscreteValuationRing_localization_ker_sliceTraitPointRingHom b₁ hb₁
  refine ⟨(Algebra.isRegularLocalRing_iff_strictHenselization _ K _ hH).mp inferInstance, ?_⟩
  rw [← Algebra.ringKrullDim_eq_of_isStrictHenselization _ K _ hH,
    IsDiscreteValuationRing.ringKrullDim_eq_one]

/-- The strict henselization of `𝔸¹_{R₁}` at the generic point of the special fibre is a
domain. -/
theorem isDomain_strictHenselization_sliceTraitPoint [IsDomain R₁] [IsDiscreteValuationRing R₁]
    (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    IsDomain (strictHenselization (sliceTraitPoint b₁)) :=
  have := (isRegularLocalRing_and_ringKrullDim_strictHenselization_sliceTraitPoint b₁ hb₁).1
  inferInstance

/-- **The strict localization of `𝔸¹_{R₁}` at the generic point of the special fibre is a
trait**: its ring is a discrete valuation ring. -/
theorem isDiscreteValuationRing_strictHenselization_sliceTraitPoint [IsDomain R₁]
    [IsDiscreteValuationRing R₁] (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    letI := isDomain_strictHenselization_sliceTraitPoint b₁ hb₁
    IsDiscreteValuationRing (strictHenselization (sliceTraitPoint b₁)) :=
  have := (isRegularLocalRing_and_ringKrullDim_strictHenselization_sliceTraitPoint b₁ hb₁).1
  IsRegularLocalRing.isDiscreteValuationRing _
    (isRegularLocalRing_and_ringKrullDim_strictHenselization_sliceTraitPoint b₁ hb₁).2

/-- The structure map `R₁ ⟶ 𝒪^{sh}_{𝔸¹_{R₁}, s}` of the strict localization at the generic point
of the special fibre. -/
noncomputable def sliceTraitStructureMap :
    R₁ →+* strictHenselization (sliceTraitPoint b₁) :=
  (Spec.preimage (strictLocalizationToBase (sliceTraitPoint b₁) ≫
    𝔸(ULift.{u} (Fin 1); Spec (.of R₁)) ↘ Spec (.of R₁))).hom

/-- **The maximal ideal of the strict localization** at the generic point of the special fibre of
`𝔸¹_{R₁}` is generated by the maximal ideal of the discrete valuation ring `R₁`. -/
theorem maximalIdeal_strictHenselization_sliceTraitPoint [IsDomain R₁]
    [IsDiscreteValuationRing R₁] (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    maximalIdeal (strictHenselization (sliceTraitPoint b₁)) =
      (maximalIdeal R₁).map (sliceTraitStructureMap b₁) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R₁
  rw [sliceTraitStructureMap, sliceTraitPoint_eq]
  obtain ⟨q, _, K, _, _, _, _, _, _, b, hq, hb, hcomp, hH⟩ :=
    Scheme.strictHenselization_chart_isStrictHenselization _
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv
      (Spec.map (CommRingCat.ofHom (sliceTraitPointRingHom b₁)))
  obtain rfl : q = RingHom.ker (sliceTraitPointRingHom b₁) := by
    rw [hq, asIdeal_sliceTraitPoint_closedPoint]
  obtain ⟨_, hm⟩ := Algebra.strictHenselization_local_maximalIdeal _ K _ hH
  have hpre : Spec.preimage (strictLocalizationToBase _ ≫
      𝔸(ULift.{u} (Fin 1); Spec (.of R₁)) ↘ Spec (.of R₁)) =
        CommRingCat.ofHom MvPolynomial.C ≫ b := by
    apply Spec.map_injective
    rw [Spec.map_preimage, ← hb, Category.assoc, AffineSpace.SpecIso_inv_over,
      Spec.map_comp]
  rw [hm, maximalIdeal_localization_ker_sliceTraitPointRingHom b₁ hb₁ hπ, Ideal.map_span,
    Set.image_singleton, hcomp, hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton, hpre]
  rfl

/-- The structure map `R₁ ⟶ 𝒪^{sh}` followed by the evaluation `𝒪^{sh} ⟶ K` at the geometric point
is `b₁` followed by `κ₁ ⟶ K`. -/
lemma strictHenselizationEval_comp_sliceTraitStructureMap :
    (strictHenselizationEval (sliceTraitPoint b₁)).hom.comp (sliceTraitStructureMap b₁) =
      (algebraMap κ₁ (traitSliceField κ₁)).comp b₁ := by
  have h : (algebraMap κ₁ (traitSliceField κ₁)).comp b₁ =
      (sliceTraitPointRingHom b₁).comp MvPolynomial.C := by
    ext r
    simp [sliceTraitPointRingHom]
  rw [h]
  suffices CommRingCat.ofHom ((strictHenselizationEval (sliceTraitPoint b₁)).hom.comp
      (sliceTraitStructureMap b₁)) = CommRingCat.ofHom ((sliceTraitPointRingHom b₁).comp
        MvPolynomial.C) from congrArg CommRingCat.Hom.hom this
  refine Spec.map_injective ?_
  rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
    CommRingCat.ofHom_hom, sliceTraitStructureMap, CommRingCat.ofHom_hom, Spec.map_preimage,
    ← Category.assoc, spec_map_strictHenselizationEval_comp_strictLocalizationToBase,
    sliceTraitPoint_eq, Category.assoc, AffineSpace.SpecIso_inv_over]

/-- The value at the geometric point of the image of `r : R₁` in the strict henselization. -/
lemma strictHenselizationEval_sliceTraitStructureMap (r : R₁) :
    strictHenselizationEval (sliceTraitPoint b₁) (sliceTraitStructureMap b₁ r) =
      algebraMap κ₁ (traitSliceField κ₁) (b₁ r) :=
  DFunLike.congr_fun (strictHenselizationEval_comp_sliceTraitStructureMap b₁) r

/-- The structure map `R₁ ⟶ 𝒪^{sh}_{𝔸¹_{R₁}, s}` is a local ring map: an element of `R₁` whose image
is a unit has nonzero value at the geometric point, so it does not lie in `ker b₁ = 𝔪`. -/
theorem isLocalHom_sliceTraitStructureMap [IsLocalRing R₁]
    (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) : IsLocalHom (sliceTraitStructureMap b₁) := by
  refine ⟨fun r hr ↦ ?_⟩
  by_contra h
  have hr' : b₁ r = 0 := by
    rw [← RingHom.mem_ker, hb₁]
    exact (mem_maximalIdeal r).2 h
  refine (isUnit_iff_strictHenselizationEval_ne_zero _).1 hr ?_
  rw [strictHenselizationEval_sliceTraitStructureMap, hr', map_zero]

/-- The structure map `R₁ ⟶ 𝒪^{sh}_{𝔸¹_{R₁}, s}` is injective: its kernel is a prime of the
discrete valuation ring `R₁`, and it is not the maximal ideal, since otherwise the maximal ideal
of the discrete valuation ring `𝒪^{sh}`, generated by the maximal ideal of `R₁`, would vanish. -/
theorem injective_sliceTraitStructureMap [IsDomain R₁] [IsDiscreteValuationRing R₁]
    (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) : Function.Injective (sliceTraitStructureMap b₁) := by
  have := isDomain_strictHenselization_sliceTraitPoint b₁ hb₁
  have := isDiscreteValuationRing_strictHenselization_sliceTraitPoint b₁ hb₁
  rw [RingHom.injective_iff_ker_eq_bot]
  by_contra hne
  have hmax : RingHom.ker (sliceTraitStructureMap b₁) = maximalIdeal R₁ :=
    IsLocalRing.eq_maximalIdeal ((RingHom.ker_isPrime _).isMaximal hne)
  refine IsDiscreteValuationRing.not_a_field (strictHenselization (sliceTraitPoint b₁)) ?_
  rw [maximalIdeal_strictHenselization_sliceTraitPoint b₁ hb₁, ← hmax, eq_bot_iff,
    Ideal.map_le_iff_le_comap, ← RingHom.ker_eq_comap_bot]

/-- The ring map `R₁[x] ⟶ 𝒪^{sh}_{𝔸¹_{R₁},s}` of the strict localization at the generic point of
the special fibre, read on the affine chart `𝔸¹_{R₁} ≅ Spec R₁[x]`. -/
noncomputable def sliceTraitChartRingHom :
    MvPolynomial (ULift.{u} (Fin 1)) R₁ →+* strictHenselization (sliceTraitPoint b₁) :=
  (Spec.preimage (strictLocalizationToBase (sliceTraitPoint b₁) ≫
    (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).hom)).hom

/-- The strict localization at the generic point of the special fibre is given on the affine
chart by `sliceTraitChartRingHom`. -/
lemma spec_sliceTraitChartRingHom :
    Spec.map (CommRingCat.ofHom (sliceTraitChartRingHom b₁)) ≫
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv =
      strictLocalizationToBase (sliceTraitPoint b₁) := by
  rw [sliceTraitChartRingHom, CommRingCat.ofHom_hom, Spec.map_preimage, Category.assoc,
    Iso.hom_inv_id, Category.comp_id]

/-- The strict localization of `𝔸¹_{R₁}` at the generic point of the special fibre is weakly
étale over `𝔸¹_{R₁}`: its ring is ind-étale over the affine chart `R₁[x]`. -/
instance weaklyEtale_strictLocalizationToBase_sliceTraitPoint :
    WeaklyEtale (strictLocalizationToBase (sliceTraitPoint b₁)) := by
  rw [← spec_sliceTraitChartRingHom]
  have hind := strictHenselization_indEtale_of_affine_chart (sliceTraitPoint b₁)
    (.of (MvPolynomial (ULift.{u} (Fin 1)) R₁))
    (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv
    ((AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv.surjective _)
    (Iso.refl _) (sliceTraitChartRingHom b₁) (by
      rw [spec_sliceTraitChartRingHom, Iso.refl_hom, Category.id_comp])
  have : WeaklyEtale (Spec.map (CommRingCat.ofHom (sliceTraitChartRingHom b₁))) := by
    let := (sliceTraitChartRingHom b₁).toAlgebra
    rw [WeaklyEtale.Spec_iff]
    exact RingHom.IndEtale.weaklyEtale ((RingHom.IndEtale.algebraMap_iff _ _).2 hind)
  exact MorphismProperty.comp_mem _ _ _ this (MorphismProperty.of_isIso @WeaklyEtale _)

/-- For the trait `S = Spec k'⟦t⟧` with `b₁` the constant coefficient, `sliceTraitPointRingHom`
is `genericSlicePointRingHom`. -/
lemma genericSlicePointRingHom_eq_sliceTraitPointRingHom (k' : Type u) [Field k'] :
    genericSlicePointRingHom k' = sliceTraitPointRingHom (PowerSeries.constantCoeff (R := k')) := by
  rw [genericSlicePointRingHom_eq, sliceTraitPointRingHom_eq]

/-- For the trait `S = Spec k'⟦t⟧` with `b₁` the constant coefficient, `sliceTraitPoint` is the
generic slice point `genericSlicePoint k'`. -/
lemma genericSlicePoint_eq_sliceTraitPoint (k' : Type u) [Field k'] :
    genericSlicePoint k' = sliceTraitPoint (PowerSeries.constantCoeff (R := k')) := by
  rw [genericSlicePoint_eq, genericSlicePointRingHom_eq_sliceTraitPointRingHom, sliceTraitPoint_eq]

end AlgebraicGeometry
