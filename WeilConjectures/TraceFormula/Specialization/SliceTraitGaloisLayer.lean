module

public import WeilConjectures.TraceFormula.Specialization.SliceTrait
public import WeilConjectures.TraceFormula.Specialization.TraitChangeGaloisLayer
public import WeilConjectures.TraceFormula.Specialization.SliceTraitGaloisTame
public import WeilConjectures.RingTheory.DiscreteValuationRing.SeparablyClosedFractionField

/-!

# The change of generic fibres over a slice trait is a pro-`p` Galois layer

Let `D` be a slice trait over the strictly henselian trait `S₁ = Spec R₁`
(`AlgebraicGeometry.SliceTrait`), with geometric generic points `Spec Ω' ⟶ Spec Ω₁`, `Ω₁`
algebraically closed and algebraic over `R₁`. Then (SGA 4½, [Th. finitude], 3.4):

* `Spec(Ω₁ ⊗_{R₁} R)` is a single point (`AlgebraicGeometry.SliceTrait.subsingleton_primeSpectrum`):
  `Frac R₁` is separably closed in `Frac R`, as `R₁ ⟶ R` preserves uniformizers and the residue
  extension is regular (`IsDiscreteValuationRing.mem_range_of_isSeparable`);
* for `L = Ω₁(R) ⊆ Ω'`, the extension `L^sep / L` is Galois with pro-`p` group, `p` the residual
  characteristic exponent: the tame extensions of `Frac R` are generated by roots of the common
  uniformizer, which lie in `Ω₁` (`AlgebraicGeometry.SliceTrait.exists_finrank_eq_pow`).

So for every morphism of models `φ : M ⟶ N` over `Spec R ⟶ Spec R₁` compatible with the
geometric generic points, the change of geometric generic fibres `φ.toCartesian` is, up to
universal homeomorphisms, the projection of the Galois layer of `L^sep / L`
(`NearbyCyclesModel.Hom.traitChangeModel`), and its pullback exchange is a split monomorphism
with torsion coefficients in which `p` is invertible
(`AlgebraicGeometry.SliceTrait.isSplitMono_toCartesian_pullbackExchange_app`). This applies to the
slice of a model along `c : 𝒳_N ⟶ 𝔸¹_{S₁}`
(`NearbyCyclesModel.isSplitMono_pullbackExchange_app_toCartesian_sliceTraitHom`).

-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing

open scoped TensorProduct CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.SliceTrait

open Scheme ProEtale.CondensedRing

variable {R₁ : Type u} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
  [IsStrictlyHenselianLocalRing R₁] {Ω₁ : Type u} [Field Ω₁] {a₁ : R₁ →+* Ω₁}
  {κ₁ : Type u} [Field κ₁] {b₁ : R₁ →+* κ₁} (D : SliceTrait a₁ b₁)

section Galois

variable [IsAlgClosed Ω₁] (ha₁ : Function.Injective a₁)
  (halg : letI := a₁.toAlgebra; Algebra.IsAlgebraic R₁ Ω₁)

end Galois

end AlgebraicGeometry.SliceTrait

namespace AlgebraicGeometry.ProEtale.CondensedRing.NearbyCyclesModel.Hom

open Scheme IsLocalRing

variable {R₁ : Type u} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
  [IsStrictlyHenselianLocalRing R₁] {Ω₁ : Type u} [Field Ω₁] {a₁ : R₁ →+* Ω₁}
  {κ₁ : Type u} [Field κ₁] {b₁ : R₁ →+* κ₁} (D : SliceTrait a₁ b₁)

section Split

variable [IsAlgClosed Ω₁] (ha₁ : Function.Injective a₁)
  (halg : letI := a₁.toAlgebra; Algebra.IsAlgebraic R₁ Ω₁)
  {X X' Y Y' : Scheme.{u}} {M : NearbyCyclesModel X X'} {N : NearbyCyclesModel Y Y'}
  {f : X ⟶ Y} {f' : X' ⟶ Y'} (φ : M.Hom N f f')
  {q : M.total ⟶ Spec (.of D.R)} {g : M.generic ⟶ Spec (.of D.Ω)}
  {q₁ : N.total ⟶ Spec (.of R₁)} {g₁ : N.generic ⟶ Spec (.of Ω₁)}

end Split

end AlgebraicGeometry.ProEtale.CondensedRing.NearbyCyclesModel.Hom

namespace AlgebraicGeometry.ProEtale.CondensedRing.NearbyCyclesModel

open Scheme IsLocalRing

variable {R₁ : Type u} [CommRing R₁] [IsDomain R₁] [IsDiscreteValuationRing R₁]
  [IsStrictlyHenselianLocalRing R₁] {Ω₁ : Type u} [Field Ω₁] [IsAlgClosed Ω₁] {a₁ : R₁ →+* Ω₁}
  {κ₁ : Type u} [Field κ₁] {b₁ : R₁ →+* κ₁} (D : SliceTrait a₁ b₁)
  {Y Y' : Scheme.{u}} (N : NearbyCyclesModel Y Y')
  (c : N.total ⟶ 𝔸(ULift.{u} (Fin 1); Spec (.of R₁))) {q₁ : N.total ⟶ Spec (.of R₁)}
  (hc : c ≫ 𝔸(ULift.{u} (Fin 1); Spec (.of R₁)) ↘ Spec (.of R₁) = q₁)
  {g₁ : N.generic ⟶ Spec (.of Ω₁)}
  (hNj : IsPullback N.j g₁ q₁ (Spec.map (CommRingCat.ofHom a₁)))
  {p₁ : Y' ⟶ Spec (.of κ₁)} (hNi : IsPullback N.i p₁ q₁ (Spec.map (CommRingCat.ofHom b₁)))

end AlgebraicGeometry.ProEtale.CondensedRing.NearbyCyclesModel
