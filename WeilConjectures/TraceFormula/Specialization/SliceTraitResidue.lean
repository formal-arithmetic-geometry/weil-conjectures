/-!

# The residue field of the strict localization of `𝔸¹` over a trait

Let `R₁` be a local ring, `b₁ : R₁ → κ₁` a map to a field with kernel the maximal ideal, and
`s = AlgebraicGeometry.sliceTraitPoint b₁ : Spec K ⟶ 𝔸¹_{R₁}` (`K = κ₁(x)^alg`) the geometric
point at the generic point of the special fibre. Let `𝔮 ⊆ R₁[x]` be the prime of `s`, with residue
field `κ(𝔮) = k(x)`, `k` the residue field of `R₁`.

We show that every element of the residue field of the strict henselization `𝒪^{sh}_{𝔸¹_{R₁}, s}`
which is algebraic over `k` lies in `k`, provided `k` is separably closed. Viewing the residue
field inside `K` through the evaluation (`AlgebraicGeometry.sliceTraitResidueEval`):

* every element is separable over `κ(𝔮)` (`AlgebraicGeometry.isSeparable_sliceTraitResidueEval`,
  from `AlgebraicGeometry.Scheme.strictHenselization_residue_separable_model`);
* an element algebraic over the separably closed field `k` is purely inseparable over `k`, hence
  over `κ(𝔮)`, so it lies in `κ(𝔮)` (`mem_range_algebraMap_of_isAlgebraic_of_isSeparable`);
* `κ(𝔮)` lands in `k⟮x⟯ ⊆ K` with `x` transcendental over `k`, and `k` is algebraically closed in
  `k⟮x⟯ ≅ k(X)` (`mem_range_algebraMap_of_isAlgebraic_of_mem_adjoin`).

## Main result

- `AlgebraicGeometry.mem_range_algebraMap_residueField_sliceTraitPoint`

-/

@[expose] public section

universe u

open CategoryTheory IsLocalRing

/-- Let `L` be separably closed and `E` a field, both mapping to a field `K` with the image of `L`
contained in that of `E`. An element of `K` algebraic over `L` and separable over `E` lies in the
image of `E`: it is purely inseparable over `L`, hence over `E`. -/
lemma mem_range_algebraMap_of_isAlgebraic_of_isSeparable {L E K : Type*} [Field L] [Field E]
    [Field K] [Algebra L K] [Algebra E K] [IsSepClosed L]
    (hLE : (algebraMap L K).range ≤ (algebraMap E K).range) {y : K} (hy : IsAlgebraic L y)
    (hsep : IsSeparable E y) : y ∈ (algebraMap E K).range := by
  have h₁ : y ∈ perfectClosure L K :=
    le_perfectClosure L K (algebraicClosure L K) (mem_algebraicClosure_iff.2 hy)
  have := (algebraMap L K).expChar (algebraMap L K).injective (ringExpChar K)
  have := (algebraMap E K).expChar (algebraMap E K).injective (ringExpChar K)
  obtain ⟨n, hn⟩ := (mem_perfectClosure_iff_pow_mem (ringExpChar K)).1 h₁
  have h₂ : y ∈ separableClosure E K ⊓ perfectClosure E K :=
    ⟨mem_separableClosure_iff.2 hsep, (mem_perfectClosure_iff_pow_mem (ringExpChar K)).2
      ⟨n, hLE hn⟩⟩
  rw [separableClosure_inf_perfectClosure] at h₂
  exact IntermediateField.mem_bot.1 h₂

/-- An element of the field `L⟮x⟯` generated by an element `x` transcendental over `L` which is
algebraic over `L` lies in `L`: `L⟮x⟯ ≅ L(X)` and non-constant rational functions are
transcendental. -/
lemma mem_range_algebraMap_of_isAlgebraic_of_mem_adjoin {L K : Type*} [Field L] [Field K]
    [Algebra L K] {x : K} (hx : Transcendental L x) {y : K}
    (hy : y ∈ IntermediateField.adjoin L {x}) (halg : IsAlgebraic L y) :
    y ∈ (algebraMap L K).range := by
  let e := RatFunc.algEquivOfTranscendental x hx
  have hu : IsAlgebraic L (e.symm ⟨y, hy⟩) :=
    ((isAlgebraic_algHom_iff (IntermediateField.val _) Subtype.val_injective).1 halg).algHom
      e.symm.toAlgHom
  obtain ⟨c, hc⟩ : ∃ c, e.symm ⟨y, hy⟩ = RatFunc.C c := by
    by_contra h
    exact RatFunc.transcendental_of_ne_C _ h hu
  refine ⟨c, ?_⟩
  have h : (⟨y, hy⟩ : IntermediateField.adjoin L {x}) = e (algebraMap L (RatFunc L) c) := by
    rw [RatFunc.algebraMap_eq_C, ← hc, AlgEquiv.apply_symm_apply]
  rw [AlgEquiv.commutes] at h
  exact (congrArg Subtype.val h).symm

/-- If `z` is separable over `k₀` via `f : k₀ → L`, and `ψ ∘ h = ē ∘ f` for field maps
`h : k₀ → F`, `ψ : F → K`, `ē : L → K`, then `ē z` is separable over `F` via `ψ`. -/
lemma isSeparable_of_comp_eq {k₀ F L K : Type*} [Field k₀] [Field F] [Field L] [Field K]
    (f : k₀ →+* L) (h : k₀ →+* F) (ψ : F →+* K) (ē : L →+* K) (hcomm : ψ.comp h = ē.comp f)
    (z : L) (hz : letI := f.toAlgebra; IsSeparable k₀ z) :
    letI := ψ.toAlgebra; IsSeparable F (ē z) := by
  let := f.toAlgebra
  let := ψ.toAlgebra
  refine (Polynomial.Separable.map (p := minpoly k₀ z) (f := h) hz).of_dvd (minpoly.dvd F (ē z) ?_)
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, RingHom.algebraMap_toAlgebra, hcomm,
    ← Polynomial.hom_eval₂, ← RingHom.algebraMap_toAlgebra f, ← Polynomial.aeval_def,
    minpoly.aeval, map_zero]

namespace AlgebraicGeometry

open Scheme

variable {R₁ : Type u} [CommRing R₁] {κ₁ : Type u} [Field κ₁] (b₁ : R₁ →+* κ₁)

/-- The evaluation `κ(𝒪^{sh}) ⟶ K` of the residue field of the strict henselization at the generic
point of the special fibre of `𝔸¹_{R₁}`, induced by `strictHenselizationEval`. -/
noncomputable def sliceTraitResidueEval :
    ResidueField (strictHenselization (sliceTraitPoint b₁)) →+* traitSliceField κ₁ :=
  ResidueField.lift (strictHenselizationEval (sliceTraitPoint b₁)).hom

/-- The field map `κ(𝔮) ⟶ K` induced by `R₁[x] ⟶ K`, where `𝔮` is its kernel. -/
noncomputable def slicePrimeResidueFieldHom :
    (RingHom.ker (sliceTraitPointRingHom b₁)).ResidueField →+* traitSliceField κ₁ :=
  Ideal.ResidueField.lift _ (sliceTraitPointRingHom b₁) le_rfl fun _ ha ↦
    isUnit_iff_ne_zero.2 fun h ↦ ha (RingHom.mem_ker.2 h)

/-- `slicePrimeResidueFieldHom` on the image of `R₁[x]`. -/
lemma slicePrimeResidueFieldHom_algebraMap (a : MvPolynomial (ULift.{u} (Fin 1)) R₁) :
    slicePrimeResidueFieldHom b₁ (algebraMap _ _ a) = sliceTraitPointRingHom b₁ a :=
  Ideal.ResidueField.lift_algebraMap _ _ _ _ a

/-- `slicePrimeResidueFieldHom` extends `sliceTraitPointRingHom`. -/
lemma slicePrimeResidueFieldHom_comp :
    (slicePrimeResidueFieldHom b₁).comp (algebraMap _ _) = sliceTraitPointRingHom b₁ :=
  RingHom.ext (slicePrimeResidueFieldHom_algebraMap b₁)

/-- **Separability of the residue field of the strict localization.** Every element of the
residue field of `𝒪^{sh}_{𝔸¹_{R₁}, s}`, viewed in `K` via the evaluation, is separable over the
residue field `κ(𝔮)` of `R₁[x]` at the prime `𝔮` of the generic point of the special fibre. -/
theorem isSeparable_sliceTraitResidueEval
    (z : ResidueField (strictHenselization (sliceTraitPoint b₁))) :
    letI := (slicePrimeResidueFieldHom b₁).toAlgebra
    IsSeparable (RingHom.ker (sliceTraitPointRingHom b₁)).ResidueField
      (sliceTraitResidueEval b₁ z) := by
  let : Field (ResidueField (strictHenselization (sliceTraitPoint b₁))) := ResidueField.field _
  obtain ⟨s, f, hsep, heq⟩ := strictHenselization_residue_separable_model
    (A := strictHenselization (sliceTraitPoint b₁)) (sliceTraitPoint b₁) (Iso.refl _)
  have hg : Spec.map (CommRingCat.ofHom ((sliceTraitResidueEval b₁).comp f)) ≫
      𝔸(ULift.{u} (Fin 1); Spec (.of R₁)).fromSpecResidueField s = sliceTraitPoint b₁ := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, heq, Iso.refl_hom,
      Category.id_comp, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      sliceTraitResidueEval, ResidueField.lift_comp_residue, CommRingCat.ofHom_hom,
      spec_map_strictHenselizationEval_comp_strictLocalizationToBase]
  let m : Spec (CommRingCat.of (Ideal.ResidueField (RingHom.ker (sliceTraitPointRingHom b₁)))) ⟶
      𝔸(ULift.{u} (Fin 1); Spec (.of R₁)) :=
    Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R₁)).inv
  have hm : Spec.map (CommRingCat.ofHom (slicePrimeResidueFieldHom b₁)) ≫ m =
      sliceTraitPoint b₁ := by
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, sliceTraitPoint_eq]
    rw [slicePrimeResidueFieldHom_comp]
  have hs : s = m (closedPoint _) := by
    have h₁ := congrArg (fun t ↦ t (closedPoint (traitSliceField κ₁))) (hg.trans hm.symm)
    simp only [Scheme.Hom.comp_apply] at h₁
    exact (fromSpecResidueField_apply s _).symm.trans
      (h₁.trans (congrArg m (Subsingleton.elim _ _)))
  subst hs
  have hh := descResidueField_stalkClosedPointTo_fromSpecResidueField _ _ m
  have hgψ : (slicePrimeResidueFieldHom b₁).comp
      (descResidueField (stalkClosedPointTo m)).hom = (sliceTraitResidueEval b₁).comp f := by
    suffices descResidueField (stalkClosedPointTo m) ≫
        CommRingCat.ofHom (slicePrimeResidueFieldHom b₁) =
          CommRingCat.ofHom ((sliceTraitResidueEval b₁).comp f) from
      congrArg CommRingCat.Hom.hom this
    refine Spec.map_injective ((cancel_mono (fromSpecResidueField _ _)).1 ?_)
    rw [hg, Spec.map_comp, Category.assoc, hh, hm]
  exact isSeparable_of_comp_eq f _ _ _ hgψ z (hsep z)

section ResidueField

variable [IsLocalRing R₁]

/-- A ring map from a local ring to a field whose kernel is the maximal ideal is local. -/
lemma isLocalHom_of_ker_eq_maximalIdeal (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    IsLocalHom b₁ := by
  refine ⟨fun r hr ↦ ?_⟩
  by_contra h
  refine hr.ne_zero ?_
  rw [← RingHom.mem_ker, hb₁]
  exact (mem_maximalIdeal r).2 h

/-- The field map `κ(R₁) ⟶ κ₁` induced by `b₁`, whose kernel is the maximal ideal. -/
noncomputable def residueFieldLiftOfKerEq (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    ResidueField R₁ →+* κ₁ :=
  have := isLocalHom_of_ker_eq_maximalIdeal b₁ hb₁
  ResidueField.lift b₁

/-- `residueFieldLiftOfKerEq` on residues. -/
lemma residueFieldLiftOfKerEq_residue (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) (r : R₁) :
    residueFieldLiftOfKerEq b₁ hb₁ (residue R₁ r) = b₁ r :=
  rfl

/-- The values of `R₁[x] ⟶ K` lie in the subfield `κ(R₁)⟮x⟯` of `K` generated over the residue
field of `R₁` by the coordinate `x`. -/
lemma sliceTraitPointRingHom_mem_adjoin (hb₁ : RingHom.ker b₁ = maximalIdeal R₁)
    (a : MvPolynomial (ULift.{u} (Fin 1)) R₁) :
    letI := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
    sliceTraitPointRingHom b₁ a ∈
      IntermediateField.adjoin (ResidueField R₁) {traitSliceCoord κ₁} := by
  let := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
  induction a using MvPolynomial.induction_on with
  | C r =>
    have h : sliceTraitPointRingHom b₁ (MvPolynomial.C r) =
        algebraMap (ResidueField R₁) (traitSliceField κ₁) (residue R₁ r) := by
      simp [sliceTraitPointRingHom, RingHom.algebraMap_toAlgebra,
        residueFieldLiftOfKerEq_residue]
    rw [h]
    exact IntermediateField.algebraMap_mem _ _
  | add p q hp hq =>
    rw [map_add]
    exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul]
    refine mul_mem hp ?_
    simpa [sliceTraitPointRingHom] using IntermediateField.mem_adjoin_simple_self _ _

/-- The values of `κ(𝔮) ⟶ K` lie in the subfield `κ(R₁)⟮x⟯` of `K`: `κ(𝔮)` is the fraction field
of `R₁[x]/𝔮`. -/
lemma slicePrimeResidueFieldHom_mem_adjoin (hb₁ : RingHom.ker b₁ = maximalIdeal R₁)
    (w : (RingHom.ker (sliceTraitPointRingHom b₁)).ResidueField) :
    letI := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
    slicePrimeResidueFieldHom b₁ w ∈
      IntermediateField.adjoin (ResidueField R₁) {traitSliceCoord κ₁} := by
  let := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective
    (A := MvPolynomial (ULift.{u} (Fin 1)) R₁ ⧸ RingHom.ker (sliceTraitPointRingHom b₁)) w
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [map_div₀, ← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
    ← IsScalarTower.algebraMap_apply, slicePrimeResidueFieldHom_algebraMap,
    slicePrimeResidueFieldHom_algebraMap]
  exact div_mem (sliceTraitPointRingHom_mem_adjoin b₁ hb₁ a)
    (sliceTraitPointRingHom_mem_adjoin b₁ hb₁ b)

/-- The coordinate `x ∈ K` is transcendental over the residue field of `R₁`. -/
lemma transcendental_residueField_traitSliceCoord (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    letI := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
    Transcendental (ResidueField R₁) (traitSliceCoord κ₁) := by
  let := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
  rintro ⟨p, hp, hpx⟩
  refine transcendental_traitSliceCoord κ₁ ⟨p.map (residueFieldLiftOfKerEq b₁ hb₁),
    (Polynomial.map_ne_zero_iff (residueFieldLiftOfKerEq b₁ hb₁).injective).2 hp, ?_⟩
  rw [Polynomial.aeval_def, Polynomial.eval₂_map]
  rw [Polynomial.aeval_def] at hpx
  exact hpx

/-- The evaluation of the residue field of the strict henselization is compatible with the maps
from the residue field of `R₁`. -/
lemma sliceTraitResidueEval_comp_algebraMap (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    letI := (sliceTraitStructureMap b₁).toAlgebra
    haveI : IsLocalHom (algebraMap R₁ (strictHenselization (sliceTraitPoint b₁))) :=
      isLocalHom_sliceTraitStructureMap b₁ hb₁
    (sliceTraitResidueEval b₁).comp
        (algebraMap (ResidueField R₁) (ResidueField (strictHenselization (sliceTraitPoint b₁)))) =
      (algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁) := by
  let := (sliceTraitStructureMap b₁).toAlgebra
  have : IsLocalHom (algebraMap R₁ (strictHenselization (sliceTraitPoint b₁))) :=
    isLocalHom_sliceTraitStructureMap b₁ hb₁
  refine RingHom.ext fun c ↦ ?_
  obtain ⟨r, rfl⟩ := residue_surjective c
  rw [RingHom.comp_apply, ResidueField.algebraMap_residue, sliceTraitResidueEval,
    ResidueField.lift_residue_apply, RingHom.comp_apply, residueFieldLiftOfKerEq_residue]
  exact strictHenselizationEval_sliceTraitStructureMap b₁ r

/-- **The residue condition for the strict localization of `𝔸¹` over a trait.** Let `R₁` be a
local ring with separably closed residue field `k`, and `b₁ : R₁ → κ₁` a map to a field with kernel
the maximal ideal. Every element of the residue field of the strict henselization
`𝒪^{sh}_{𝔸¹_{R₁}, s}` at the generic point of the special fibre which is algebraic over `k` lies
in `k`. Indeed, it is separable over `κ(𝔮) = k(x)` (`isSeparable_sliceTraitResidueEval`) and purely
inseparable over `k`, hence lies in `k(x)`, and `k` is algebraically closed in `k(x)`. -/
theorem mem_range_algebraMap_residueField_sliceTraitPoint [IsSepClosed (ResidueField R₁)]
    (hb₁ : RingHom.ker b₁ = maximalIdeal R₁) :
    letI := (sliceTraitStructureMap b₁).toAlgebra
    haveI : IsLocalHom (algebraMap R₁ (strictHenselization (sliceTraitPoint b₁))) :=
      isLocalHom_sliceTraitStructureMap b₁ hb₁
    ∀ z : ResidueField (strictHenselization (sliceTraitPoint b₁)),
      IsAlgebraic (ResidueField R₁) z →
        z ∈ (algebraMap (ResidueField R₁)
          (ResidueField (strictHenselization (sliceTraitPoint b₁)))).range := by
  let := (sliceTraitStructureMap b₁).toAlgebra
  have : IsLocalHom (algebraMap R₁ (strictHenselization (sliceTraitPoint b₁))) :=
    isLocalHom_sliceTraitStructureMap b₁ hb₁
  let := ((algebraMap κ₁ (traitSliceField κ₁)).comp (residueFieldLiftOfKerEq b₁ hb₁)).toAlgebra
  intro z hz
  have hcomp := sliceTraitResidueEval_comp_algebraMap b₁ hb₁
  let ē : ResidueField (strictHenselization (sliceTraitPoint b₁)) →ₐ[ResidueField R₁]
      traitSliceField κ₁ :=
    { sliceTraitResidueEval b₁ with commutes' := fun c ↦ DFunLike.congr_fun hcomp c }
  have hy : IsAlgebraic (ResidueField R₁) (sliceTraitResidueEval b₁ z) := hz.algHom ē
  let := (slicePrimeResidueFieldHom b₁).toAlgebra
  have hrange : (algebraMap (ResidueField R₁) (traitSliceField κ₁)).range ≤
      (algebraMap (RingHom.ker (sliceTraitPointRingHom b₁)).ResidueField
        (traitSliceField κ₁)).range := by
    rintro _ ⟨c, rfl⟩
    obtain ⟨r, rfl⟩ := residue_surjective c
    refine ⟨algebraMap _ _ (MvPolynomial.C (σ := ULift.{u} (Fin 1)) r), ?_⟩
    rw [RingHom.algebraMap_toAlgebra, slicePrimeResidueFieldHom_algebraMap]
    simp [sliceTraitPointRingHom, RingHom.algebraMap_toAlgebra, residueFieldLiftOfKerEq_residue]
  obtain ⟨w, hw⟩ := mem_range_algebraMap_of_isAlgebraic_of_isSeparable hrange hy
    (isSeparable_sliceTraitResidueEval b₁ z)
  have hadj := slicePrimeResidueFieldHom_mem_adjoin b₁ hb₁ w
  rw [← RingHom.algebraMap_toAlgebra (slicePrimeResidueFieldHom b₁), hw] at hadj
  obtain ⟨c, hc⟩ := mem_range_algebraMap_of_isAlgebraic_of_mem_adjoin
    (transcendental_residueField_traitSliceCoord b₁ hb₁) hadj hy
  refine ⟨c, (sliceTraitResidueEval b₁).injective ?_⟩
  rw [← RingHom.comp_apply, hcomp]
  exact hc

end ResidueField

end AlgebraicGeometry
