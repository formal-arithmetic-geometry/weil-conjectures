module

public import WeilConjectures.TraceFormula.Specialization.GenericSlicePoint
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
import WeilConjectures.AlgebraicGeometry.StrictHenselizationLocalPresentation
import WeilConjectures.Mathlib.RingTheory.DiscreteValuationRing.TFAE
import WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs
import WeilConjectures.RingTheory.StrictHenselizationDimension
import WeilConjectures.RingTheory.StrictHenselizationLocalMaximalIdeal
import WeilConjectures.RingTheory.StrictHenselizationRegular

/-!

# The strict localization of `𝔸¹_S` at the generic point of its special fibre is a trait

Let `S = Spec k'⟦t⟧`, `K = k'(x)^alg` and `s = genericSlicePoint k' : Spec K ⟶ 𝔸¹_S` the
geometric point at the generic point of the special fibre `𝔸¹_{k'}`. The image of `s` in
`Spec k'⟦t⟧[x]` is the prime `(t)` (as `x` is transcendental over `k'`), so the local ring of
`𝔸¹_S` there is a noetherian local domain with principal maximal ideal `(t) ≠ 0`, i.e. a discrete
valuation ring. Being regular of dimension one passes to strict henselizations, so the strict
henselization `𝒪^{sh}_{𝔸¹_S, s}` is a discrete valuation ring as well.

## Main results

- `AlgebraicGeometry.ker_genericSlicePointRingHom`: the prime of `k'⟦t⟧[x]` under `s` is `(t)`.
- `AlgebraicGeometry.isDomain_strictHenselization_genericSlicePoint`
- `AlgebraicGeometry.isDiscreteValuationRing_strictHenselization_genericSlicePoint`
- `AlgebraicGeometry.maximalIdeal_strictHenselization_genericSlicePoint`: `t` is a uniformizer.

-/

@[expose] public section

universe u

open CategoryTheory IsLocalRing

namespace AlgebraicGeometry

open Scheme

variable (k' : Type u) [Field k']

/-- The ring map `k'⟦t⟧[x] ⟶ K` (`K = k'(x)^alg`) of the geometric point `genericSlicePoint k'`:
`t ↦ 0` and `x ↦ x`. -/
noncomputable def genericSlicePointRingHom :
    MvPolynomial (ULift.{u} (Fin 1)) (PowerSeries k') →+* traitSliceField k' :=
  PowerSeries.constantCoeff.comp (traitSliceRingHom (traitSliceCoord k'))

/-- The geometric point `genericSlicePoint k'` in the affine chart `Spec k'⟦t⟧[x] ≅ 𝔸¹_S`. -/
lemma genericSlicePoint_eq :
    genericSlicePoint k' = Spec.map (CommRingCat.ofHom (genericSlicePointRingHom k')) ≫
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of (PowerSeries k'))).inv := by
  rw [genericSlicePoint, traitClosedPoint, traitSlice, ← Spec.map_comp_assoc,
    ← CommRingCat.ofHom_comp]
  rfl

/-- `genericSlicePointRingHom` factors as reduction modulo `t` followed by the evaluation
`k'[x] ⟶ K` at `x`. -/
lemma genericSlicePointRingHom_eq :
    genericSlicePointRingHom k' =
      (MvPolynomial.aeval (R := k') fun _ : ULift.{u} (Fin 1) ↦ traitSliceCoord k').toRingHom.comp
        (MvPolynomial.map PowerSeries.constantCoeff) := by
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
  · simp [genericSlicePointRingHom, traitSliceRingHom, constantCoeff_map_apply]
  · simp [genericSlicePointRingHom, traitSliceRingHom]

/-- **The prime of the generic point of the special fibre.** The kernel of `k'⟦t⟧[x] ⟶ K`,
`t ↦ 0`, `x ↦ x`, is the ideal `(t)`, as `x` is transcendental over `k'`. -/
lemma ker_genericSlicePointRingHom :
    RingHom.ker (genericSlicePointRingHom k') = Ideal.span {MvPolynomial.C PowerSeries.X} := by
  have hinj : Function.Injective
      (MvPolynomial.aeval (R := k') fun _ : ULift.{u} (Fin 1) ↦ traitSliceCoord k') :=
    algebraicIndependent_iff_injective_aeval.mp
      ((algebraicIndependent_unique_type_iff (R := k')
        (x := fun _ : ULift.{u} (Fin 1) ↦ traitSliceCoord k')).mpr
          (transcendental_traitSliceCoord k'))
  rw [genericSlicePointRingHom_eq, RingHom.ker_comp_of_injective _ hinj, MvPolynomial.ker_map]
  have hker : RingHom.ker (PowerSeries.constantCoeff (R := k')) = Ideal.span {PowerSeries.X} := by
    ext φ
    rw [RingHom.mem_ker, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff]
  rw [hker, Ideal.map_span, Set.image_singleton]

/-- The maximal ideal of the localization of `k'⟦t⟧[x]` at `(t)` is generated by `t`. -/
lemma maximalIdeal_localization_ker_genericSlicePointRingHom :
    maximalIdeal (Localization.AtPrime (RingHom.ker (genericSlicePointRingHom k'))) =
      Ideal.span {(algebraMap (MvPolynomial (ULift.{u} (Fin 1)) (PowerSeries k'))
        (Localization.AtPrime (RingHom.ker (genericSlicePointRingHom k')))
        (MvPolynomial.C PowerSeries.X))} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (RingHom.ker (genericSlicePointRingHom k')),
    ← Set.image_singleton, ← Ideal.map_span]
  exact congrArg _ (ker_genericSlicePointRingHom k')

/-- The local ring of `𝔸¹_S` at the generic point of the special fibre, the localization of
`k'⟦t⟧[x]` at `(t)`, is a discrete valuation ring with uniformizer `t`. -/
theorem isDiscreteValuationRing_localization_ker_genericSlicePointRingHom :
    IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker (genericSlicePointRingHom k'))) := by
  set q := RingHom.ker (genericSlicePointRingHom k')
  refine .of_maximalIdeal_eq_span_singleton ?_
    (maximalIdeal_localization_ker_genericSlicePointRingHom k')
  rw [ne_eq, map_eq_zero_iff _ (IsLocalization.injective (Localization.AtPrime q)
      q.primeCompl_le_nonZeroDivisors), MvPolynomial.C_eq_zero]
  exact PowerSeries.X_ne_zero

/-- The strict henselization of `𝔸¹_S` at the generic point of the special fibre is a regular
local ring of dimension one: in the chart `Spec k'⟦t⟧[x] ≅ 𝔸¹_S` it is a strict henselization of
the discrete valuation ring `k'⟦t⟧[x]_{(t)}`. -/
theorem isRegularLocalRing_and_ringKrullDim_strictHenselization_genericSlicePoint :
    IsRegularLocalRing (strictHenselization (genericSlicePoint k')) ∧
      ringKrullDim (strictHenselization (genericSlicePoint k')) = 1 := by
  rw [genericSlicePoint_eq]
  obtain ⟨q, _, K, _, _, _, _, _, _, b, hq, -, -, hH⟩ :=
    Scheme.strictHenselization_chart_isStrictHenselization _
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of (PowerSeries k'))).inv
      (Spec.map (CommRingCat.ofHom (genericSlicePointRingHom k')))
  obtain rfl : q = RingHom.ker (genericSlicePointRingHom k') := by
    rw [hq, Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.eq_bot_of_prime
      (IsLocalRing.closedPoint (traitSliceField k')).asIdeal, ← RingHom.ker_eq_comap_bot]
    rfl
  have := isDiscreteValuationRing_localization_ker_genericSlicePointRingHom k'
  refine ⟨(Algebra.isRegularLocalRing_iff_strictHenselization _ K _ hH).mp inferInstance, ?_⟩
  rw [← Algebra.ringKrullDim_eq_of_isStrictHenselization _ K _ hH,
    IsDiscreteValuationRing.ringKrullDim_eq_one]

/-- The strict henselization of `𝔸¹_S` at the generic point of the special fibre is a domain. -/
theorem isDomain_strictHenselization_genericSlicePoint :
    IsDomain (strictHenselization (genericSlicePoint k')) :=
  have := (isRegularLocalRing_and_ringKrullDim_strictHenselization_genericSlicePoint k').1
  inferInstance

/-- **The strict localization of `𝔸¹_S` at the generic point of the special fibre is a trait**:
its ring is a discrete valuation ring. -/
theorem isDiscreteValuationRing_strictHenselization_genericSlicePoint :
    letI := isDomain_strictHenselization_genericSlicePoint k'
    IsDiscreteValuationRing (strictHenselization (genericSlicePoint k')) :=
  have := (isRegularLocalRing_and_ringKrullDim_strictHenselization_genericSlicePoint k').1
  IsRegularLocalRing.isDiscreteValuationRing _
    (isRegularLocalRing_and_ringKrullDim_strictHenselization_genericSlicePoint k').2

/-- **The uniformizer of the strict localization**: the maximal ideal of the strict
henselization of `𝔸¹_S` at the generic point of the special fibre is generated by the image of
`t` under the structure map `k'⟦t⟧ ⟶ 𝒪^{sh}`. -/
theorem maximalIdeal_strictHenselization_genericSlicePoint :
    maximalIdeal (strictHenselization (genericSlicePoint k')) = Ideal.span
      {(Spec.preimage (strictLocalizationToBase (genericSlicePoint k') ≫
        𝔸(ULift.{u} (Fin 1); trait k') ↘ trait k')).hom PowerSeries.X} := by
  rw [genericSlicePoint_eq]
  obtain ⟨q, _, K, _, _, _, _, _, _, b, hq, hb, hcomp, hH⟩ :=
    Scheme.strictHenselization_chart_isStrictHenselization _
      (AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of (PowerSeries k'))).inv
      (Spec.map (CommRingCat.ofHom (genericSlicePointRingHom k')))
  obtain rfl : q = RingHom.ker (genericSlicePointRingHom k') := by
    rw [hq, Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.eq_bot_of_prime
      (IsLocalRing.closedPoint (traitSliceField k')).asIdeal, ← RingHom.ker_eq_comap_bot]
    rfl
  obtain ⟨_, hm⟩ := Algebra.strictHenselization_local_maximalIdeal _ K _ hH
  have hpre : Spec.preimage (strictLocalizationToBase _ ≫
      𝔸(ULift.{u} (Fin 1); trait k') ↘ trait k') = CommRingCat.ofHom MvPolynomial.C ≫ b := by
    apply Spec.map_injective
    rw [Spec.map_preimage, ← hb, Category.assoc, AffineSpace.SpecIso_inv_over, Spec.map_comp]
  rw [hm, maximalIdeal_localization_ker_genericSlicePointRingHom, Ideal.map_span,
    Set.image_singleton, hcomp, hpre]
  rfl

end AlgebraicGeometry
