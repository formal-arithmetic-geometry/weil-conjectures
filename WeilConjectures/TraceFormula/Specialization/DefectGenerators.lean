module

public import WeilConjectures.TraceFormula.Specialization.DefectTriangulated
public import WeilConjectures.TraceFormula.ConstructibleGeneration

/-!

# Reduction of the vanishing of the defect to lisse generators

The bounded constructible `ℚ̄_ℓ`-complexes with vanishing defect `C_{X,Z}` form a triangulated
subcategory (`ProEtale.CondensedRing.isTriangulated_vanishingDefect`), and every bounded
constructible complex lies in the triangulated subcategory generated by the lisse generators
`Rg_! Rj_! L` (`ProEtale.CondensedRing.triangEnvelope_lisseGenerator`). Hence the defect vanishes
for all bounded constructible complexes as soon as it vanishes on the lisse generators
(`ProEtale.CondensedRing.isZero_specializationDefect_of_lisseGenerator`).

-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)] (k' : Type u) [Field k'] [Algebra k k']
  (X : Over (Spec (.of k))) [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  (I : X.left.IdealSheafData)

instance (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ] :
    (vanishingDefect X I k' Λ).IsStableUnderRetracts where
  of_retract {A B} r hB := by
    rw [vanishingDefect_eq_isoLocus] at hB ⊢
    have : IsIso (((zeroSectionDeformationModelHom X I k').pullbackExchange Λ).app B) := hB
    exact NatTrans.isIso_app_of_retract _ r

instance (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ] :
    (vanishingDefect X I k' Λ).IsClosedUnderIsomorphisms where
  of_iso e h := h.of_iso (nonempty_specializationDefect_iso X I k' Λ e).some.symm

/-- **Reduction to lisse generators**: if the defect `C_{X,Z}` vanishes on the lisse generators
`Rg_! Rj_! L` of `Dᵇc(X)⟦ℚ̲̄_ℓ⟧`, it vanishes on every bounded constructible complex. -/
theorem isZero_specializationDefect_of_lisseGenerator
    (h : ∀ N : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧, lisseGenerator ℓ X N →
      IsZero (specializationDefect X I k' (Profinite.padicAlgClRingObj ℓ) N.obj))
    (L : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    IsZero (specializationDefect X I k' (Profinite.padicAlgClRingObj ℓ) L.obj) := by
  let Q := (vanishingDefect X I k' (Profinite.padicAlgClRingObj ℓ)).inverseImage
    (boundedConstructible (condensedRingObj (Profinite.padicAlgClRingObj ℓ) X.left)).ι
  have : Q.IsStableUnderRetracts :=
    ⟨fun r hB ↦ (vanishingDefect X I k' _).prop_of_retract (r.map (boundedConstructible _).ι) hB⟩
  have hQ : (lisseGenerator ℓ X).triangEnvelope ≤ Q :=
    (ObjectProperty.triangEnvelope_le_iff _).mpr fun N hN ↦ h N hN
  exact hQ _ (triangEnvelope_lisseGenerator ℓ X L)

end AlgebraicGeometry.ProEtale.CondensedRing
