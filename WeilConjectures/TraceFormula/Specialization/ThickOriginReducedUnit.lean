module

public import WeilConjectures.AlgebraicGeometry.DeformationSpace.SmoothProj
public import WeilConjectures.TraceFormula.Specialization.GenericDivisorConstantFamily
public import WeilConjectures.TraceFormula.Specialization.NearbySmoothExchange
public import WeilConjectures.TraceFormula.Specialization.ThickOriginCentre
public import WeilConjectures.Mathlib.CategoryTheory.Iso

/-!

# The specialization unit of the deformation of the reduced origin of the affine line

Let `V(x) ⊆ 𝔸¹_k` be the (reduced) origin. Its deformation to the normal cone over the trait
`S = Spec k'⟦t⟧` is `𝔸¹_u × S` (with `x = t u`), smooth over `S`: the deformation space of a
section of a smooth morphism is smooth over `𝔸¹`
(`AlgebraicGeometry.Scheme.Hom.smooth_deformationSpaceProj`). So the projection to the constant
family of the point, `𝒟_{V(x)} 𝔸¹ ⟶ 𝒟_⊥ (Spec k) = S`, is a smooth morphism of deformation models,
and smooth base change for nearby cycles
(`ProEtale.CondensedRing.isIso_pullbackExchange_deformationModel_app_of_smooth`) together with the
point case (`ProEtale.CondensedRing.isIso_deformationModel_bot_unit_of_isIso`) shows that the
specialization unit `σ : Λ ⟶ Ψ(Λ)` of `𝒟_{V(x)} 𝔸¹` is an isomorphism
(`ProEtale.CondensedRing.isIso_deformationModel_polyAffineThickOrigin_one_unit`).

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

section Geometry

variable (k : Type u) [Field k]

/-- The ideal of the origin of the polynomial ring in one variable is generated by the
variable. -/
lemma ker_constantCoeff_mvPolynomial_fin_one :
    RingHom.ker (MvPolynomial.constantCoeff (σ := Fin 1) (R := k)) =
      Ideal.span {MvPolynomial.X (Fin.last 0)} := by
  refine le_antisymm (fun p hp ↦ ?_) ?_
  · have h := sub_C_constantCoeff_mem_mvPolynomialOrigin p
    rwa [RingHom.mem_ker.1 hp, map_zero, sub_zero, Ideal.mvPolynomialOrigin, Set.range_unique,
      Subsingleton.elim (default : Fin 1) (Fin.last 0)] at h
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
      MvPolynomial.constantCoeff_X]

/-- The reduced origin `V(x)` of `𝔸¹_k` is the closed subscheme cut out by the origin
`Spec k ⟶ 𝔸¹_k`. -/
lemma polyAffineThickOrigin_one_eq_ker :
    polyAffineThickOrigin k 1 = (polyAffineOrigin k).ker := by
  refine IdealSheafData.ext_of_isAffine ?_
  rw [polyAffineThickOrigin, IdealSheafData.ideal_top_ofIdealTop, Scheme.Hom.ker_apply]
  refine le_antisymm ?_ fun a ha ↦ ?_
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
    exact polyAffineOrigin_appTop_coord_pow k one_pos
  obtain ⟨p, rfl⟩ : ∃ p, (ΓSpecIso (.of (MvPolynomial (Fin 1) k))).inv p = a :=
    ⟨(ΓSpecIso _).hom a, Iso.hom_inv_id_apply _ _⟩
  have hp : p ∈ RingHom.ker (MvPolynomial.constantCoeff (σ := Fin 1) (R := k)) := by
    have h := congr((ΓSpecIso (.of k)).hom ($(Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.constantCoeff (σ := Fin 1) (R := k)))) p))
    rw [CommRingCat.comp_apply, CommRingCat.comp_apply, Iso.inv_hom_id_apply] at h
    rw [RingHom.mem_ker] at ha ⊢
    exact h.trans ((congrArg (fun y ↦ (ΓSpecIso (.of k)).hom y) ha).trans (map_zero _))
  rw [ker_constantCoeff_mvPolynomial_fin_one, Ideal.mem_span_singleton] at hp
  obtain ⟨q, rfl⟩ := hp
  rw [map_mul, pow_one]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)

instance : Smooth (polyAffine k 1).hom :=
  have : Algebra.Smooth k (MvPolynomial (Fin 1) k) := ⟨inferInstance, inferInstance⟩
  HasRingHomProperty.Spec_iff.mpr (RingHom.smooth_algebraMap.mpr this)

instance : IsClosedImmersion (polyAffineOrigin k) :=
  isClosedImmersion_of_comp_eq_id _ _ (polyAffineOrigin_hom k)

/-- The deformation space of the reduced origin `V(x) ⊆ 𝔸¹_k` is smooth over `𝔸¹_k`. -/
instance smooth_deformationSpaceToAffineLine_polyAffineThickOrigin_one :
    Smooth (deformationSpaceToAffineLine (polyAffine k 1) (polyAffineThickOrigin k 1)) := by
  rw [polyAffineThickOrigin_one_eq_ker]
  exact Scheme.Hom.smooth_deformationSpaceProj _ _ (polyAffineOrigin_hom k)

end Geometry

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)] (k' : Type u) [Field k'] [Algebra k k'] [IsSepClosed k']
  [Fact (ringChar k').Prime] [Fact (ringChar k' ≠ ℓ)]

/-- Any morphism `f : X ⟶ Y` pulls the zero ideal back into any ideal `J` of `X`. -/
lemma siteIdeal_bot_map_appLE_le {X Y : Scheme.{u}} (f : X ⟶ Y) (J : X.IdealSheafData)
    ⦃U' : X.AffineZariskiSite⦄ ⦃U : Y.AffineZariskiSite⦄ (hU : U'.1 ≤ f ⁻¹ᵁ U.1) :
    ((⊥ : Y.IdealSheafData).siteIdeal U).map (f.appLE U.1 U'.1 hU).hom ≤ J.siteIdeal U' := by
  refine Ideal.map_le_iff_le_comap.2 fun x hx ↦ ?_
  obtain rfl : x = 0 := hx
  exact zero_mem _

/-- The morphism from the deformation of the reduced origin `V(x) ⊆ 𝔸¹_k` to the constant family
of the point, induced by the structure morphism `𝔸¹_k ⟶ Spec k`. -/
noncomputable abbrev polyAffineThickOriginOneModelHom :=
  deformationModelHom (Over.homMk (polyAffine k 1).hom : polyAffine k 1 ⟶ point k)
    (siteIdeal_bot_map_appLE_le _ (polyAffineThickOrigin k 1)) k'

/-- The morphism of total spaces from the deformation of the reduced origin `V(x) ⊆ 𝔸¹_k` to the
constant family of the point is smooth: it is the base change of the morphism of deformation
spaces, which is `D_{V(x)} 𝔸¹_k ⟶ 𝔸¹_k` up to the isomorphism `D_⊥ (Spec k) ≅ 𝔸¹_k`. -/
instance smooth_polyAffineThickOriginOneModelHom_total :
    Smooth (polyAffineThickOriginOneModelHom (k := k) k').total := by
  have : IsIso (point k).hom := inferInstanceAs (IsIso (𝟙 _))
  have : Smooth (IdealSheafData.deformationSpaceMap
      (Over.homMk (polyAffine k 1).hom : polyAffine k 1 ⟶ point k).left ⊥
      (polyAffineThickOrigin k 1) (siteIdeal_bot_map_appLE_le _ _)) := by
    rw [← MorphismProperty.cancel_right_of_respectsIso (P := @Smooth) _
      (deformationSpaceToAffineLine (point k) ⊥)]
    exact (deformationSpaceMap_deformationSpaceToAffineLine
      (Over.homMk (polyAffine k 1).hom : polyAffine k 1 ⟶ point k) _).symm ▸ inferInstance
  exact MorphismProperty.of_isPullback
    (isPullback_deformationTotalMap_toSpace _ _ k').flip inferInstance

/-- **The specialization unit of the deformation of the reduced origin**: for the deformation to
the normal cone `𝒟` of the origin `V(x) ⊆ 𝔸¹_k` over the trait `Spec k'⟦t⟧`, the specialization
unit `σ : ℚ̄_ℓ ⟶ Ψ(ℚ̄_ℓ)` is an isomorphism. The total space of `𝒟` is smooth over the trait, so
by smooth base change the pullback exchange of `𝒟 ⟶ 𝒟_⊥ (Spec k)` is invertible at the unit, and
the specialization unit of the trait is an isomorphism. -/
theorem isIso_deformationModel_polyAffineThickOrigin_one_unit :
    IsIso ((deformationModel (polyAffine k 1) (polyAffineThickOrigin k 1) k').unit
      (Profinite.padicAlgClRingObj ℓ)) := by
  have hφ := isIso_pullbackExchange_deformationModel_app_of_smooth k'
    (polyAffineThickOriginOneModelHom (k := k) k') (isPullback_deformationGenericMap _ _ k')
    (K := 𝟙_ _) (𝟙_ (Dᵇc((point k).left)⟦Profinite.padicAlgClRingObj ℓ⟧)).property
  have : IsIso (point k).hom := inferInstanceAs (IsIso (𝟙 _))
  have := isIso_deformationModel_bot_unit_of_isIso (Profinite.padicAlgClRingObj ℓ) (point k) k'
  have h := (polyAffineThickOriginOneModelHom (k := k) k').map_unit_comp_pullbackExchange_app
    (Profinite.padicAlgClRingObj ℓ)
  revert hφ h this
  normalize_precoherent
  intro hφ hN h
  have := hφ
  exact isIso_of_comp_eq_comp_comp h

end AlgebraicGeometry.ProEtale.CondensedRing
