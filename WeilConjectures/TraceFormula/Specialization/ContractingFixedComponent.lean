/-!
# Connected components of the fixed locus of a contracting correspondence

Let `c = (c₁, c₂)` be contracting at the rational point `y` of `C`, with `x = c₁(y) = c₂(y)`.
Blueprint `lemma-fixed-point-scheme-deformation`, first assertion, for `Z = {x}`: a connected
subscheme `B` of `C` on which the two legs agree and which contains `y` (for instance a connected
open and closed subscheme of the fixed locus containing `y`) is set-theoretically the point `y`,
so that `d⁻¹(Z)_red = B_red`.

The proof follows the blueprint. On the local ring `𝒪_{B,y}` the two legs induce the same ideal
`I = 𝔪_x 𝒪_{B,y}`, and the contraction condition gives `I^n ⊆ I^{n+1}`, so `I^n = 0` by
Nakayama's lemma. Every generization of `y` in `B` is a prime of `𝒪_{B,y}`, hence contains `I` and
maps to `x`; as the fibre `c₁⁻¹(x)` is the point `y`, the point `y` has no proper generization.
A closed point without proper generization of a scheme locally of finite type over a field is
open (`AlgebraicGeometry.Scheme.isOpen_singleton_of_stableUnderGeneralization`), and `B` is
connected.

## Main statements

- `ProEtale.CondensedRing.Correspondence.IsContractingAt.subsingleton_of_connected`
- `AlgebraicGeometry.ProEtale.CondensedRing.Correspondence.IsContractingAt.subsingleton_component`
-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry

/-- In a locally noetherian Jacobson scheme, a closed point without proper generizations is
open. -/
lemma Scheme.isOpen_singleton_of_stableUnderGeneralization {S : Scheme.{u}}
    [IsLocallyNoetherian S] [JacobsonSpace S] {s : S} (h₁ : IsClosed ({s} : Set S))
    (h₂ : StableUnderGeneralization ({s} : Set S)) : IsOpen ({s} : Set S) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hsU, -⟩ :=
    S.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ s) isOpen_univ
  have : IsNoetherianRing Γ(S, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have : JacobsonSpace (Spec Γ(S, U)) :=
    JacobsonSpace.of_isOpenEmbedding hU.fromSpec.isOpenEmbedding
  have : IsJacobsonRing Γ(S, U) := PrimeSpectrum.isJacobsonRing_iff_jacobsonSpace.mpr this
  have hinj := hU.fromSpec.isOpenEmbedding.injective
  obtain ⟨p, hp⟩ : s ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hsU
  have hpre : hU.fromSpec ⁻¹' {s} = {p} := by
    ext q
    simp only [Set.mem_preimage, Set.mem_singleton_iff, ← hp]
    exact hinj.eq_iff
  have hc : IsClosed ({p} : Set (PrimeSpectrum Γ(S, U))) :=
    hpre ▸ h₁.preimage hU.fromSpec.continuous
  have hg : StableUnderGeneralization ({p} : Set (PrimeSpectrum Γ(S, U))) := by
    intro a b hab ha
    rw [Set.mem_singleton_iff] at ha ⊢
    have hb' : hU.fromSpec b ∈ ({s} : Set S) :=
      h₂ (hab.map hU.fromSpec.continuous) (by rw [ha, hp]; rfl)
    exact hinj (hb'.trans hp.symm)
  have ho : IsOpen ({p} : Set (PrimeSpectrum Γ(S, U))) :=
    ((PrimeSpectrum.isOpen_singleton_tfae_of_isNoetherian_of_isJacobsonRing p).out 3 1).mp
      (And.intro hc hg)
  have := hU.fromSpec.isOpenEmbedding.isOpenMap _ ho
  rwa [Set.image_singleton, hp] at this

/-- The ideal generated by the pullback of the maximal ideal along a morphism only depends on the
morphism. -/
lemma Scheme.Hom.map_maximalIdeal_stalkMap_eq_of_eq {B X : Scheme.{u}} {f g : B ⟶ X} (h : f = g)
    (s : B) :
    (maximalIdeal (X.presheaf.stalk (f s))).map (f.stalkMap s).hom =
      (maximalIdeal (X.presheaf.stalk (g s))).map (g.stalkMap s).hom := by
  subst h
  rfl

/-- If `e ≫ c₁ = e ≫ c₂` and `(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}` in `𝒪_{C, e(s)}`, then the ideal
`I = (e ≫ c₁)^♯ 𝔪` of `𝒪_{B, s}` satisfies `I^n ⊆ I^{n+1}`. -/
lemma Scheme.Hom.map_maximalIdeal_stalkMap_comp_pow_le {B C X : Scheme.{u}} (e : B ⟶ C)
    (c₁ c₂ : C ⟶ X) (he : e ≫ c₁ = e ≫ c₂) (s : B) {n : ℕ}
    (hle : (maximalIdeal (X.presheaf.stalk (c₂ (e s)))).map (c₂.stalkMap (e s)).hom ^ n ≤
      (maximalIdeal (X.presheaf.stalk (c₁ (e s)))).map (c₁.stalkMap (e s)).hom ^ (n + 1)) :
    (maximalIdeal (X.presheaf.stalk ((e ≫ c₁) s))).map ((e ≫ c₁).stalkMap s).hom ^ n ≤
      (maximalIdeal (X.presheaf.stalk ((e ≫ c₁) s))).map ((e ≫ c₁).stalkMap s).hom ^ (n + 1) := by
  have h₁ : (maximalIdeal (X.presheaf.stalk ((e ≫ c₁) s))).map ((e ≫ c₁).stalkMap s).hom =
      ((maximalIdeal (X.presheaf.stalk (c₁ (e s)))).map (c₁.stalkMap (e s)).hom).map
        (e.stalkMap s).hom := by
    rw [Ideal.map_map, ← CommRingCat.hom_comp, ← Scheme.Hom.stalkMap_comp]
    rfl
  have h₂ : (maximalIdeal (X.presheaf.stalk ((e ≫ c₁) s))).map ((e ≫ c₁).stalkMap s).hom =
      ((maximalIdeal (X.presheaf.stalk (c₂ (e s)))).map (c₂.stalkMap (e s)).hom).map
        (e.stalkMap s).hom := by
    rw [map_maximalIdeal_stalkMap_eq_of_eq he, Ideal.map_map, ← CommRingCat.hom_comp,
      ← Scheme.Hom.stalkMap_comp]
    rfl
  calc _ = _ := by rw [h₂, ← Ideal.map_pow]
    _ ≤ _ := Ideal.map_mono hle
    _ = _ := by rw [Ideal.map_pow, ← h₁]

/-- Let `e : B ⟶ C` equalize `c₁, c₂ : C ⟶ X`, with `B` locally noetherian, and suppose that
`(c₂^♯ 𝔪)^n ⊆ (c₁^♯ 𝔪)^{n+1}` in `𝒪_{C, e(s)}`. Then the ideal `I = 𝔪 𝒪_{B, s}` is nilpotent
(Nakayama), so every generization of `s` has the same image as `s` in `X`. -/
lemma Scheme.Hom.apply_eq_of_specializes_of_pow_le {B C X : Scheme.{u}} [IsLocallyNoetherian B]
    (e : B ⟶ C) (c₁ c₂ : C ⟶ X) (he : e ≫ c₁ = e ≫ c₂) (s : B) {n : ℕ}
    (hle : (maximalIdeal (X.presheaf.stalk (c₂ (e s)))).map (c₂.stalkMap (e s)).hom ^ n ≤
      (maximalIdeal (X.presheaf.stalk (c₁ (e s)))).map (c₁.stalkMap (e s)).hom ^ (n + 1))
    {z : B} (hz : z ⤳ s) : (e ≫ c₁) z = (e ≫ c₁) s := by
  have hJ := map_maximalIdeal_stalkMap_comp_pow_le e c₁ c₂ he s hle
  obtain ⟨J, hJdef⟩ : ∃ J, J =
      (maximalIdeal (X.presheaf.stalk ((e ≫ c₁) s))).map ((e ≫ c₁).stalkMap s).hom := ⟨_, rfl⟩
  rw [← hJdef] at hJ
  have hJm : J ≤ maximalIdeal (B.presheaf.stalk s) := by
    rw [hJdef]
    exact Ideal.map_le_iff_le_comap.mpr fun a ha ↦ (mem_maximalIdeal _).mpr fun hu ↦
      ha (isUnit_of_map_unit _ _ hu)
  have hJn : J ^ n = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot J (J ^ n) (IsNoetherian.noetherian _)
      (by rw [smul_eq_mul, ← pow_succ']; exact hJ)
      (hJm.trans (jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge)
  obtain ⟨w, rfl⟩ : z ∈ Set.range (B.fromSpecStalk s) := by
    rw [Scheme.range_fromSpecStalk]; exact hz
  have hw : J ≤ w.asIdeal := w.isPrime.le_of_pow_le (hJn.le.trans bot_le)
  have hcl : (Spec.map ((e ≫ c₁).stalkMap s)) w =
      closedPoint (X.presheaf.stalk ((e ≫ c₁) s)) := by
    refine PrimeSpectrum.ext ((maximalIdeal.isMaximal (X.presheaf.stalk ((e ≫ c₁) s))).eq_of_le
      (PrimeSpectrum.isPrime ((Spec.map ((e ≫ c₁).stalkMap s)) w)).ne_top fun a ha ↦ ?_).symm
    change ((e ≫ c₁).stalkMap s).hom a ∈ w.asIdeal
    exact hw (hJdef ▸ Ideal.mem_map_of_mem _ ha)
  rw [← Scheme.Hom.comp_apply, ← Scheme.SpecMap_stalkMap_fromSpecStalk, Scheme.Hom.comp_apply,
    hcl, Scheme.fromSpecStalk_closedPoint]

namespace ProEtale.CondensedRing.Correspondence.IsContractingAt

variable {ℓ : ℕ} [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]
  {X : Over (Spec (.of k))} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
  {K : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧} {c : Correspondence ℓ K}
  {y : RationalPoint c.C}

/-- **Connected components of the fixed locus at a contracting point** (blueprint
`lemma-fixed-point-scheme-deformation`, first assertion `d⁻¹(Z)_red = F_red`, for `Z = {x}`): if
`c` is contracting at `y`, then a connected scheme `B`, locally of finite type over `k`, with a
morphism `e : B ⟶ C` injective on points on which the two legs agree, and a rational point `b`
over `y`, is set-theoretically the single point `b`. -/
theorem subsingleton_of_connected (hc : c.IsContractingAt y) {B : Over (Spec (.of k))}
    [LocallyOfFiniteType B.hom] [ConnectedSpace B.left] (e : B ⟶ c.C)
    (he : e ≫ c.c₁ = e ≫ c.c₂) (hinj : Function.Injective e.left.base) (b : RationalPoint B)
    (hb : b ≫ e = y) : Subsingleton B.left := by
  have : IsLocallyNoetherian B.left := LocallyOfFiniteType.isLocallyNoetherian B.hom
  have : JacobsonSpace B.left := LocallyOfFiniteType.jacobsonSpace B.hom
  have : Subsingleton (Spec (.of k)) := inferInstanceAs (Subsingleton (PrimeSpectrum k))
  have : Subsingleton (point k).left := inferInstanceAs (Subsingleton (PrimeSpectrum k))
  obtain ⟨s, hs⟩ : ∃ s, s = b.left (default : Spec (.of k)) := ⟨_, rfl⟩
  have hes : e.left s = y.left (default : Spec (.of k)) := by
    rw [hs, ← Scheme.Hom.comp_apply, ← Over.comp_left, hb]
  have he' : e.left ≫ c.c₁.left = e.left ≫ c.c₂.left := by
    rw [← Over.comp_left, he, Over.comp_left]
  obtain ⟨n, -, hle⟩ := hc.exists_le_pow
  rw [← hes] at hle
  -- the fibre of `c₁` over `x` is the point `y`
  have hsq : IsPullback y.left (𝟙 _) c.c₁.left (y ≫ c.c₁).left :=
    hc.isPullback.map (Over.forget _)
  have hfib : ∀ p : c.C.left, c.c₁.left p = c.c₁.left (y.left (default : Spec (.of k))) →
      p = y.left (default : Spec (.of k)) := by
    intro p hp
    have hmem : p ∈ Set.range (pullback.fst c.c₁.left (y ≫ c.c₁).left) := by
      rw [Scheme.Pullback.range_fst]
      exact ⟨_, hp.symm⟩
    obtain ⟨q, rfl⟩ := hmem
    rw [← hsq.isoPullback_inv_fst, Scheme.Hom.comp_apply]
    exact congrArg _ (Subsingleton.elim _ _)
  -- hence `s` has no proper generization
  have hstab : StableUnderGeneralization ({s} : Set B.left) := by
    intro a z hz ha
    rw [Set.mem_singleton_iff] at ha ⊢
    subst ha
    have h := Scheme.Hom.apply_eq_of_specializes_of_pow_le e.left c.c₁.left c.c₂.left he' a hle hz
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hes] at h
    exact hinj ((hfib _ h).trans hes.symm)
  have hcl : IsClosed ({s} : Set B.left) := hs ▸ RationalPoint.isClosed_singleton b
  have huniv := IsClopen.eq_univ
    ⟨hcl, Scheme.isOpen_singleton_of_stableUnderGeneralization hcl hstab⟩
    (Set.singleton_nonempty s)
  refine ⟨fun z₁ z₂ ↦ ?_⟩
  have h₁ : z₁ ∈ ({s} : Set B.left) := huniv ▸ Set.mem_univ _
  have h₂ : z₂ ∈ ({s} : Set B.left) := huniv ▸ Set.mem_univ _
  exact h₁.trans h₂.symm

/-- **Connected components of the fixed locus at a contracting point** (blueprint
`lemma-fixed-point-scheme-deformation`, first assertion, for `Z = {x}`): if `c` is contracting at
`y`, a connected subscheme `j : B ⟶ F` of the fixed locus (e.g. a connected open and closed
subscheme) which is closed in `F` and contains a rational point `b` over `y` is set-theoretically
the single point `b`; in particular `d = c₁ ∘ ι` maps `B` to `x`. -/
theorem subsingleton_component (hc : c.IsContractingAt y) (F : c.FixedLocus)
    {B : Over (Spec (.of k))} [LocallyOfFiniteType B.hom] [ConnectedSpace B.left] (j : B ⟶ F.F)
    [IsClosedImmersion j.left] (b : RationalPoint B) (hb : b ≫ j ≫ F.ι = y) :
    Subsingleton B.left :=
  hc.subsingleton_of_connected (j ≫ F.ι) (by rw [Category.assoc, F.w, Category.assoc])
    (by
      rw [Over.comp_left]
      exact (j.left ≫ F.ι.left).isClosedEmbedding.injective) b hb

end ProEtale.CondensedRing.Correspondence.IsContractingAt

end AlgebraicGeometry
