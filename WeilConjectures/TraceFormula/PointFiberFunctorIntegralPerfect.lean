module

public import WeilConjectures.CategoryTheory.DerivedCategory.Complete.Perfect
public import WeilConjectures.TraceFormula.PointFiberFunctorIntegral

/-!

# Integral point fibres are perfect

Over the separably closed point `s = Spec k`, the integral point fibre functor
`Fib_s : Dᵇc(s)⟦𝒪̲_E⟧ ⥤ D(𝒪_E)` (`ProEtale.CondensedRing.pointFiberFunctorIntegral`) takes values
in perfect complexes: the cohomology of `Fib_s(N)` is bounded and finitely generated over the
discrete valuation ring `𝒪_E`, hence `Fib_s(N)` is perfect
(`ProEtale.CondensedRing.isPerfect_pointFiberFunctorIntegral_obj`).

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme PadicAlgCl

variable (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k] [IsSepClosed k]
  (E : FiniteIntermediateField ℓ)

/-- The sections over the point of the unit `𝒪̲_E,s` form a finitely generated `𝒪_E`-module,
generated by the identity: every endomorphism of the unit is the action of a scalar. -/
lemma moduleFinite_pointSectionsIntegral_obj_unit :
    Module.Finite (Shrink.{u + 1} (integers ℓ E.1))
      ((pointSectionsIntegral ℓ k E).obj (𝟙_ (PointModIntegral ℓ k E))) := by
  let x : (pointSectionsIntegral ℓ k E).obj (𝟙_ (PointModIntegral ℓ k E)) := 𝟙 _
  refine Module.Finite.of_surjective (LinearMap.toSpanSingleton _ _ x) fun t ↦ ?_
  obtain ⟨r, hr⟩ := surjective_pointIntegersUnitEndRingHom ℓ k E t
  exact ⟨shrinkRingEquiv ℓ E.1 r, (Category.comp_id _).trans ((congrArg
    (pointIntegersUnitEndRingHom ℓ k E) ((shrinkRingEquiv ℓ E.1).symm_apply_apply r)).trans hr)⟩

/-- The sections over the point of a finitely presented `𝒪̲_E,s`-module form a finitely
generated `𝒪_E`-module: they are a quotient of the sections of a free module of finite rank. -/
lemma moduleFinite_pointSectionsIntegral_obj {M : PointModIntegral ℓ k E}
    (hM : Mod.IsFinitelyPresented _ M) :
    Module.Finite (Shrink.{u + 1} (integers ℓ E.1)) ((pointSectionsIntegral ℓ k E).obj M) := by
  obtain ⟨n, m, g, ⟨e⟩⟩ := hM
  let G := pointSectionsIntegral ℓ k E
  let f : Fin n → PointModIntegral ℓ k E := fun _ ↦ 𝟙_ (PointModIntegral ℓ k E)
  have : Module.Finite (Shrink.{u + 1} (integers ℓ E.1))
      (ModuleCat.of (Shrink.{u + 1} (integers ℓ E.1)) (∀ j, (G.obj ∘ f) j)) :=
    Module.Finite.pi (h := fun _ ↦ moduleFinite_pointSectionsIntegral_obj_unit ℓ k E)
  have : Module.Finite (Shrink.{u + 1} (integers ℓ E.1)) (G.obj (⨁ f)) :=
    Module.Finite.equiv (G.mapBiproduct f ≪≫ ModuleCat.biproductIsoPi _).toLinearEquiv.symm
  exact Module.Finite.of_surjective (G.map (cokernel.π g ≫ e.inv)).hom
    ((ModuleCat.epi_iff_surjective _).1 inferInstance)

/-- **Integral point fibres are perfect**: for a bounded constructible `𝒪_E`-complex `N` over the
separably closed point, `Fib_s(N)` is a perfect complex of `𝒪_E`-modules. -/
theorem isPerfect_pointFiberFunctorIntegral_obj
    (N : Dᵇc((point k).left)⟦Profinite.padicIntegersRingObj ℓ E.1⟧) :
    ((pointFiberFunctorIntegral ℓ k E).obj N).IsPerfect := by
  let G := pointSectionsIntegral ℓ k E
  let K := (pointFiberFunctorIntegral ℓ k E).obj N
  obtain ⟨⟨⟨a, ha⟩, ⟨b, hb⟩⟩, -⟩ := N.property
  have hK : K.IsGE a := G.isGE_mapDerivedCategory_obj N.obj a
  have : K.IsLE b := G.isLE_mapDerivedCategory_obj N.obj b
  refine DerivedCategory.isPerfect_of_isGE_of_isLE (b - a + 1).toNat a K hK
    (DerivedCategory.TStructure.t.isLE_of_le K b _ (by clear * - a b; omega)) fun n _ _ ↦ ?_
  obtain ⟨p, q, g, ⟨e⟩⟩ := isFinitelyPresented_upperStar_of_isConstructibleModuleObject
    (Profinite.padicIntegersRingObj ℓ E.1) (Field.toIsField k) IsField.isSepClosed_toField
    (((mem_boundedConstructible_iff _ _).1 N.property).2 n) (𝟙 _)
  have : Module.Finite (Shrink.{u + 1} (integers ℓ E.1))
      ((DerivedCategory.homologyFunctor (PointModIntegral ℓ k E) n ⋙ G).obj N.obj) :=
    moduleFinite_pointSectionsIntegral_obj ℓ k E
      (M := (DerivedCategory.homologyFunctor (PointModIntegral ℓ k E) n).obj N.obj)
      ⟨p, q, g, ⟨((upperStarId _ _).app _).symm ≪≫ e⟩⟩
  exact Module.Finite.equiv ((G.mapDerivedCategoryHomologyFunctorIso n).app N.obj).toLinearEquiv

end AlgebraicGeometry.ProEtale.CondensedRing
