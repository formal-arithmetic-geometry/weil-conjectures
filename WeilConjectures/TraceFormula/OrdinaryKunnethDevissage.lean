/-!
# Dévissage for the ordinary Künneth map

The Künneth map `M ⊠ Rj_* B ⟶ R(𝟙 × j)_* (M ⊠ B)` (`ProEtale.CondensedRing.openKunnethMap`) is
the component at `M` of the natural transformation `CategoryTheory.Adjunction.kunnethNatTrans`
between triangulated functors of `M ∈ Dᵇc(X)⟦ℚ̲̄_ℓ⟧`, and it commutes with the shifts. Hence the
objects `M` for which it is an isomorphism form a triangulated subcategory
(`ProEtale.CondensedRing.isIso_openKunnethMap_of_triangEnvelope`), and it suffices to treat the
generators `Rg_! Rj'_! L` of `Dᵇc(X)⟦ℚ̲̄_ℓ⟧` (`triangEnvelope_lisseGenerator`), with `g` a closed
immersion, `j'` an open immersion and `L` dualizable. The closed pushforward `Rg_!` is removed by
`ProEtale.CondensedRing.isIso_openKunnethMap_lowerStar_of_isClosedImmersion`. For `Rj'_! L`, the
Künneth map restricts over `V ⨯ Y` to the dualizable case
(`ProEtale.CondensedRing.isIso_upperStar_map_openKunnethMap_of_isOpenImmersion`), and over the
closed complement `Z ⨯ Y` its source vanishes, so that it remains to show that its target
vanishes there (`ProEtale.CondensedRing.isZero_upperStar_lowerStar_externalProduct_lowerShriek`).
This vanishing is transported to integral models of `L` and `B` over a common `𝒪_E`, along the
compatibilities of the extension of scalars `𝒪_E ⟶ ℚ̄_ℓ` with the operations involved, and the
integral statement is reduced to the Künneth formula with finite coefficients.

The extension by zero `Rj'_! Lj'^* K` of the restriction of a dualizable `K` on `X` is formal
(`ProEtale.CondensedRing.isIso_openKunnethMap_lowerShriek_upperStar_of_isDualizable`, by the
open–closed triangle).
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

open scoped CategoryTheory.Functor CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (ℓ : ℕ) [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]

attribute [local instance 2000] MonoidalCategory.toMonoidalCategoryStruct

/-- The oplax structure map of the derived pullback commutes with the shifts in the first
variable (`commShift_boundedConstructibleUpperStarδFlip`). -/
instance commShift_δFlip_boundedConstructibleUpperStar {A B : Over (Spec (.of k))}
    [LocallyOfFiniteType A.hom] [QuasiCompact A.hom] [IsSeparated A.hom]
    [LocallyOfFiniteType B.hom] [QuasiCompact B.hom] [IsSeparated B.hom] (f : A ⟶ B)
    (C : Dᵇc(B.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    NatTrans.CommShift (Functor.OplaxMonoidal.δFlip
      (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ f) C) ℤ :=
  inferInstanceAs (NatTrans.CommShift
    (boundedConstructibleUpperStarδFlip ℓ f C) ℤ)

/-- The identification `Lg^* = Lg'^*` along an equality `g = g'` commutes with the shifts. -/
lemma commShift_eqToHom_boundedConstructibleUpperStar {A B : Over (Spec (.of k))}
    [LocallyOfFiniteType A.hom] [QuasiCompact A.hom] [IsSeparated A.hom]
    [LocallyOfFiniteType B.hom] [QuasiCompact B.hom] [IsSeparated B.hom] {g g' : A ⟶ B}
    (h : boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ g =
      boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ g') (hg : g = g') :
    NatTrans.CommShift (eqToHom h) ℤ := by
  subst hg
  rw [eqToHom_refl]
  infer_instance

variable {X Y U : Over (Spec (.of k))}
  [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom] [LocallyOfFiniteType Y.hom]
  [QuasiCompact Y.hom] [IsSeparated Y.hom] [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
  [IsSeparated U.hom]

variable (j : U ⟶ Y) (B : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧)

/-- **Dévissage for the Künneth map**: if `M ⊠ Rj_* B ⟶ R(𝟙 × j)_* (M ⊠ B)` is an isomorphism for
the objects `M` of a class `P`, it is an isomorphism for every `M` in the triangulated subcategory
generated by `P`. -/
theorem isIso_openKunnethMap_of_triangEnvelope
    {P : ObjectProperty (Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)}
    (h : ∀ M, P M → IsIso (openKunnethMap ℓ j M B))
    {M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hM : P.triangEnvelope M) :
    IsIso (openKunnethMap ℓ j M B) := by
  unfold openKunnethMap at h ⊢
  have : NatTrans.CommShift (prodMapUpperStarFstIso ℓ (X := X) j).hom ℤ := by
    dsimp only [prodMapUpperStarFstIso, Iso.trans_hom, Iso.symm_hom, eqToIso.hom]
    have := commShift_eqToHom_boundedConstructibleUpperStar ℓ
      (by rw [prod.map_fst, Category.comp_id])
      (show prod.map (𝟙 X) j ≫ (prod.fst : X ⨯ Y ⟶ X) = prod.fst by
        rw [prod.map_fst, Category.comp_id])
    infer_instance
  have := Adjunction.commShift_kunnethNatTrans
    (boundedConstructibleUpperStarLowerStarAdjunction ℓ
      (prod.map (𝟙 X) j)) (prodMapUpperStarFstIso ℓ j) (openKunnethSecondFactor ℓ j B) ℤ
  exact NatTrans.isIso_app_of_triangEnvelope _ h hM

/-- **Two out of three for the Künneth map**: for a distinguished triangle
`M₁ ⟶ M₂ ⟶ M₃ ⟶ M₁[1]`, if the Künneth maps of `M₂` and `M₃` are isomorphisms, so is that of
`M₁`. -/
theorem isIso_openKunnethMap_of_distTriang₁
    (T : Pretriangulated.Triangle (Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧))
    (hT : T ∈ Pretriangulated.distinguishedTriangles)
    (h₂ : IsIso (openKunnethMap ℓ j T.obj₂ B)) (h₃ : IsIso (openKunnethMap ℓ j T.obj₃ B)) :
    IsIso (openKunnethMap ℓ j T.obj₁ B) := by
  let P : ObjectProperty (Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :=
    fun M ↦ IsIso (openKunnethMap ℓ j M B)
  have : P.Nonempty := ⟨_, h₂⟩
  exact isIso_openKunnethMap_of_triangEnvelope ℓ j B (P := P) (fun _ h ↦ h)
    (P.triangEnvelope.ext_of_isTriangulatedClosed₁ T hT (P.le_triangEnvelope _ h₂)
      (P.le_triangEnvelope _ h₃))

/-- The invertibility of the Künneth map only depends on `M` up to isomorphism. -/
lemma isIso_openKunnethMap_of_iso {M M' : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (e : M ≅ M')
    (h : IsIso (openKunnethMap ℓ j M' B)) : IsIso (openKunnethMap ℓ j M B) := by
  unfold openKunnethMap at h ⊢
  exact ObjectProperty.prop_of_iso (NatTrans.isoLocus _) e.symm h

/-- **The Künneth map for the extension by zero of a restriction**: for an open immersion
`j' : V ⟶ X` and a dualizable `K ∈ Dᵇc(X)⟦ℚ̲̄_ℓ⟧`, the Künneth map of `Rj'_! Lj'^* K` is an
isomorphism. By the open–closed triangle `Rj'_! Lj'^* K ⟶ K ⟶ Ri_* Li^* K ⟶`, this follows from the
dualizable case for `K` and for `Li^* K` and the compatibility with closed pushforward. Thus the
generator case `isIso_openKunnethMap_lowerShriek_of_isDualizable` only fails to be formal for
dualizable objects on `V` which do not extend to dualizable objects on `X`. -/
theorem isIso_openKunnethMap_lowerShriek_upperStar_of_isDualizable [IsOpenImmersion j.left]
    {V : Over (Spec (.of k))} [LocallyOfFiniteType V.hom] [QuasiCompact V.hom] [IsSeparated V.hom]
    (j' : V ⟶ X) [IsOpenImmersion j'.left]
    {K : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hK : IsDualizable K) :
    IsIso (openKunnethMap ℓ j
      ((boundedConstructibleLowerShriek ℓ j').obj
        ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j').obj K)) B) := by
  obtain ⟨δ, hT⟩ := exists_distTriang_openClosed_boundedConstructible ℓ (j := j')
    (i := overClosedComplement j') (isCompl_range_overClosedComplement j').symm K
  have key := fun h₂ h₃ ↦ isIso_openKunnethMap_of_distTriang₁ ℓ j B _ hT h₂ h₃
  exact key (isIso_openKunnethMap_of_isDualizable ℓ j hK B)
    (isIso_openKunnethMap_lowerStar_of_isClosedImmersion ℓ _ j _ B
      (isIso_openKunnethMap_of_isDualizable ℓ j
        (isDualizable_boundedConstructibleUpperStar_obj ℓ _ hK) B))

omit [Fact (ringChar k).Prime] [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
  [IsSeparated X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsSeparated Y.hom] in
/-- The products `i × 𝟙_Y` and `j' × 𝟙_Y` of complementary closed and open immersions have
complementary ranges. -/
lemma isCompl_range_prodMap_id {Z V : Over (Spec (.of k))} (i : Z ⟶ X) (j' : V ⟶ X)
    (hij : IsCompl (Set.range i.left.base) (Set.range j'.left.base)) :
    IsCompl (Set.range (prod.map i (𝟙 Y)).left.base)
      (Set.range (prod.map j' (𝟙 Y)).left.base) := by
  have hr {T : Over (Spec (.of k))} (a : T ⟶ X) :
      Set.range (prod.map a (𝟙 Y)).left.base =
        (prod.fst : X ⨯ Y ⟶ X).left.base ⁻¹' Set.range a.left.base := by
    have s := (IsPullback.of_prod_fst_with_id a Y).map (Over.forget _)
    exact Scheme.range_snd_of_isPullback (f := a.left) s
  rw [hr i, hr j']
  exact hij.preimage _

attribute [local instance] boundedConstructibleBraiding in
/-- **The generator case as a vanishing statement**: for an open immersion `j' : V ⟶ X` with
closed complement `i : Z ⟶ X` and a dualizable `L` on `V`, the Künneth map of `Rj'_! L` is an
isomorphism as soon as `R(𝟙 × j)_* (Rj'_! L ⊠ B)` vanishes on `Z ⨯ Y`. Over `V ⨯ Y` the Künneth
map restricts to the dualizable case, and over `Z ⨯ Y` its source vanishes. -/
theorem isIso_openKunnethMap_lowerShriek_of_isZero [IsOpenImmersion j.left]
    {V : Over (Spec (.of k))} [LocallyOfFiniteType V.hom] [QuasiCompact V.hom] [IsSeparated V.hom]
    (j' : V ⟶ X) [IsOpenImmersion j'.left]
    {L : Dᵇc(V.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hL : IsDualizable L)
    (h₀ : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (prod.map (overClosedComplement j') (𝟙 Y))).obj
      ((boundedConstructibleLowerStar ℓ (prod.map (𝟙 X) j)).obj
        (externalProduct ℓ
          ((boundedConstructibleLowerShriek ℓ j').obj L) B)))) :
    IsIso (openKunnethMap ℓ j
      ((boundedConstructibleLowerShriek ℓ j').obj L) B) := by
  have : QuasiCompact j'.left := by
    have : QuasiCompact (j'.left ≫ X.hom) := by rw [Over.w j']; infer_instance
    exact QuasiCompact.of_comp j'.left X.hom
  have : QuasiCompact (prod.map j' (𝟙 Y)).left :=
    MorphismProperty.of_isPullback ((IsPullback.of_prod_fst_with_id j' Y).map (Over.forget _))
      (inferInstanceAs (QuasiCompact j'.left))
  have : IsClosedImmersion (prod.map (overClosedComplement j') (𝟙 Y)).left :=
    MorphismProperty.of_isPullback
      ((IsPullback.of_prod_fst_with_id (overClosedComplement j') Y).map (Over.forget _))
      (inferInstanceAs (IsClosedImmersion (overClosedComplement j').left))
  refine isIso_of_isIso_boundedConstructibleUpperStar_map_of_isCompl _ ℓ
    (prod.map (overClosedComplement j') (𝟙 Y)) (prod.map j' (𝟙 Y))
    (isCompl_range_prodMap_id _ _ (isCompl_range_overClosedComplement j')) _ ?_ ?_
  · refine isIso_upperStar_map_openKunnethMap_of_isOpenImmersion ℓ j' j _ B ?_
    have e : (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j').obj
        ((boundedConstructibleLowerShriek ℓ j').obj L) ≅ L :=
      (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j').mapIso
          ((boundedConstructibleLowerShriekIsoOpenImmersionLowerShriek_padicAlgCl ℓ j').app L) ≪≫
        (asIso ((boundedConstructibleOpenImmersionLowerShriekUpperStarAdjunction
          (Profinite.padicAlgClRingObj ℓ) ℓ j').unit.app L)).symm
    exact isIso_openKunnethMap_of_iso ℓ j B e (isIso_openKunnethMap_of_isDualizable ℓ j hL B)
  · have hg : Disjoint (Set.range j'.left.base)
        (Set.range (prod.map (overClosedComplement j') (𝟙 Y) ≫ prod.fst).left.base) := by
      rw [prod.map_fst, Over.comp_left, Scheme.Hom.comp_base, TopCat.coe_comp]
      exact (isCompl_range_overClosedComplement j').disjoint.symm.mono_right
        (Set.range_comp_subset_range _ _)
    have h₁ : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
        (prod.map (overClosedComplement j') (𝟙 Y))).obj
        ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
          (prod.fst : X ⨯ Y ⟶ X)).obj
          ((boundedConstructibleLowerShriek ℓ j').obj L))) :=
      (isZero_boundedConstructibleUpperStar_obj_openImmersionLowerShriek _ ℓ j' _ hg L).of_iso
        ((boundedConstructibleUpperStarComp (Profinite.padicAlgClRingObj ℓ) ℓ _ _).symm.app _ ≪≫
          (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ _).mapIso
            ((boundedConstructibleLowerShriekIsoOpenImmersionLowerShriek_padicAlgCl ℓ j').app L))
    have h₂ : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
        (prod.map (overClosedComplement j') (𝟙 Y))).obj
        (externalProduct ℓ ((boundedConstructibleLowerShriek ℓ
          j').obj L)
          ((boundedConstructibleLowerStar ℓ j).obj B))) := by
      refine IsZero.of_iso ?_ (Functor.Monoidal.μIso _ _ _).symm
      exact isZero_tensorObj_of_isZero_left h₁ _
    exact ⟨⟨0, h₂.eq_of_src _ _, h₀.eq_of_src _ _⟩⟩

/-- **Vanishing on the boundary** (the remaining content of the ordinary Künneth formula, blueprint
`lemma-kunneth-one-identity-factor--1`; SGA 4½, [Th. finitude], Corollaire 1.11): for an open
immersion `j' : V ⟶ X` with closed complement `i : Z ⟶ X`, any morphism `j : U ⟶ Y` and any `L` on
`V`, the complex `R(𝟙 × j)_* (Rj'_! L ⊠ B)` vanishes on `Z ⨯ Y`.

Following the proof of blueprint `lemma-kunneth-one-identity-factor--1`, `L` and `B` have integral
models `L₀`, `B₀` over a common `𝒪_E` (`ProEtale.exists_padicAlgCl_iso_integralModel_pair`), the
extension of scalars `𝒪_E ⟶ ℚ̄_ℓ` commutes with the operations involved
(`boundedConstructibleUpperStarIntegersToPadicAlgClIso`,
`boundedConstructibleLowerStarIntegersToPadicAlgClIso`,
`boundedConstructibleOpenImmersionLowerShriekIntegersToPadicAlgClIso`,
`boundedConstructibleIntegersToPadicAlgClExternalProductIso`), and the integral statement
(`PadicIntegersRingObj.isZero_upperStar_prodMap_lowerStar_prodMap_externalProduct`) is deduced
from finite coefficients. -/
theorem isZero_upperStar_lowerStar_externalProduct_lowerShriek
    {V : Over (Spec (.of k))} [LocallyOfFiniteType V.hom] [QuasiCompact V.hom] [IsSeparated V.hom]
    (j' : V ⟶ X) [IsOpenImmersion j'.left] (L : Dᵇc(V.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (prod.map (overClosedComplement j') (𝟙 Y))).obj
      ((boundedConstructibleLowerStar ℓ (prod.map (𝟙 X) j)).obj
        (externalProduct ℓ
          ((boundedConstructibleLowerShriek ℓ j').obj L) B))) := by
  have := noetherianSpace_left_of_over V
  have := noetherianSpace_left_of_over U
  obtain ⟨E, L₀, B₀, ⟨eL⟩, ⟨eB⟩⟩ := ProEtale.exists_padicAlgCl_iso_integralModel_pair V.left
    U.left ℓ L B
  let N₀ := (boundedConstructibleOpenImmersionLowerShriek
    (Profinite.padicIntegersRingObj ℓ E.1) ℓ j').obj L₀
  have hN : IsZero ((boundedConstructibleUpperStar (Profinite.padicIntegersRingObj ℓ E.1) ℓ
      (overClosedComplement j')).obj N₀) :=
    isZero_boundedConstructibleUpperStar_obj_openImmersionLowerShriek _ ℓ j' _
      (isCompl_range_overClosedComplement j').disjoint.symm L₀
  have : (boundedConstructibleExtendScalars (overClosedComplementObj j' ⨯ Y).left ℓ
      E).PreservesZeroMorphisms := inferInstance
  have : (constructibleToPadicAlgCl (overClosedComplementObj j' ⨯ Y).left ℓ
      E).PreservesZeroMorphisms :=
    inferInstanceAs (boundedConstructibleToPadicAlgCl _ ℓ E).PreservesZeroMorphisms
  have h₀ := Functor.map_isZero
    (boundedConstructibleIntegersToPadicAlgCl ℓ E (overClosedComplementObj j' ⨯ Y))
    (PadicIntegersRingObj.isZero_upperStar_prodMap_lowerStar_prodMap_externalProduct
      ℓ E (overClosedComplement j') j hN B₀)
  let eM : (boundedConstructibleIntegersToPadicAlgCl ℓ E X).obj N₀ ≅
      (boundedConstructibleLowerShriek ℓ j').obj L :=
    (boundedConstructibleOpenImmersionLowerShriekIntegersToPadicAlgClIso ℓ E j').app L₀ ≪≫
      (boundedConstructibleOpenImmersionLowerShriek _ ℓ j').mapIso eL ≪≫
      (boundedConstructibleLowerShriekIsoOpenImmersionLowerShriek_padicAlgCl ℓ j').symm.app L
  refine h₀.of_iso ?_
  exact ((boundedConstructibleUpperStarIntegersToPadicAlgClIso ℓ E
      (prod.map (overClosedComplement j') (𝟙 Y))).app _ ≪≫
    (boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ
      (prod.map (overClosedComplement j') (𝟙 Y))).mapIso
      ((boundedConstructibleLowerStarIntegersToPadicAlgClIso ℓ E (prod.map (𝟙 X) j)).app _ ≪≫
        (boundedConstructibleLowerStar ℓ (prod.map (𝟙 X) j)).mapIso
          (boundedConstructibleIntegersToPadicAlgClExternalProductIso ℓ E eM eB))).symm

/-- **The ordinary Künneth formula for the extension by zero of a dualizable object**: for an
open immersion `j' : V ⟶ X` and a dualizable `L ∈ Dᵇc(V)⟦ℚ̲̄_ℓ⟧`, the Künneth map
`Rj'_! L ⊠ Rj_* B ⟶ R(𝟙 × j)_* (Rj'_! L ⊠ B)` is an isomorphism. This is the generator case of the
ordinary Künneth formula (blueprint `lemma-kunneth-one-identity-factor--1`; SGA 4½, [Th. finitude],
Corollaire 1.11), the only case not reached by generic base change and the dévissage: it amounts to
the vanishing of `R(𝟙 × j)_* (Rj'_! L ⊠ B)` on `(X ∖ V) ⨯ Y`. -/
theorem isIso_openKunnethMap_lowerShriek_of_isDualizable [IsOpenImmersion j.left]
    {V : Over (Spec (.of k))} [LocallyOfFiniteType V.hom] [QuasiCompact V.hom] [IsSeparated V.hom]
    (j' : V ⟶ X) [IsOpenImmersion j'.left]
    {L : Dᵇc(V.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (hL : IsDualizable L) :
    IsIso (openKunnethMap ℓ j
      ((boundedConstructibleLowerShriek ℓ j').obj L) B) :=
  isIso_openKunnethMap_lowerShriek_of_isZero ℓ j B j' hL
    (isZero_upperStar_lowerStar_externalProduct_lowerShriek ℓ j B j' L)

omit j B in
/-- **The ordinary Künneth formula along an open immersion**, at the coefficient stage `ℚ̄_ℓ`
(blueprint `lemma-kunneth-one-identity-factor--1`, section `chap-The-six-operations-on-Dbctf`,
states it for finite coefficients and a general morphism `f`; here `f = j` is an open immersion).
For an open immersion `j : U ⟶ Y`, `M ∈ Dᵇc(X)⟦ℚ̲̄_ℓ⟧` and `B ∈ Dᵇc(U)⟦ℚ̲̄_ℓ⟧`, the Künneth map
`M ⊠ Rj_* B ⟶ R(𝟙 × j)_* (M ⊠ B)` is an isomorphism (SGA 4½, [Th. finitude], Corollaire 1.11).

By dévissage (`isIso_openKunnethMap_of_triangEnvelope`, `triangEnvelope_lisseGenerator`) it
reduces to the generators `Rg_! Rj'_! L`; the closed pushforward `Rg_!` is removed by
`isIso_openKunnethMap_lowerStar_of_isClosedImmersion`, and the extension by zero of a dualizable
object is `isIso_openKunnethMap_lowerShriek_of_isDualizable`. -/
theorem isIso_openKunnethMap (j : U ⟶ Y) [IsOpenImmersion j.left]
    (M : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
    (B : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    IsIso (openKunnethMap ℓ j M B) := by
  refine isIso_openKunnethMap_of_triangEnvelope ℓ j B ?_ (triangEnvelope_lisseGenerator ℓ X M)
  rintro N ⟨Z, _, _, _, g, _, V, _, _, _, _, j', _, L, hL, ⟨eN⟩⟩
  refine isIso_openKunnethMap_of_iso ℓ j B
    (eN ≪≫ (boundedConstructibleLowerShriekIsoLowerStar_padicAlgCl ℓ g).app _) ?_
  exact isIso_openKunnethMap_lowerStar_of_isClosedImmersion ℓ g j _ B
    (isIso_openKunnethMap_lowerShriek_of_isDualizable ℓ j B j' hL)

end AlgebraicGeometry.ProEtale.CondensedRing
