/-!
# Finite bounded torsion modules are generated by their prime cyclic factors

Source: Stacks Project, Tag 0F08, cyclic-coefficient reduction;
Mathlib.GroupTheory.FiniteAbelian.Basic, finite abelian group structure theorem.
(blueprint: lem-sbc-finite-torsion-extension-induction)
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace ModuleCat

/--
Prime-power induction step in the finite torsion dévissage.

Source: Stacks Project, Tag 0F08, cyclic-coefficient reduction.

Proof: Induct on `e`. For `e = 0`, `ZMod (r ^ 0)` is the zero module, so
`hzero` applies. For the successor, use the standard short exact sequence
`ZMod (r ^ e) → ZMod (r ^ (e + 1)) → ZMod r`, where the first map is
multiplication by `r` and the second is reduction modulo `r`. The kernel of the
second map is the image of the first, and the first map is injective. Apply
`hext` to the induction hypothesis and `hprime`, transporting along the
canonical module isomorphisms with `hiso`.
(blueprint: lem-sbc-finite-torsion-prime-power-step)
-/
theorem finite_torsion_prime_power_step
    (P : ModuleCat.{u + 1} (ULift.{u + 1} ℤ) → Prop)
    (hzero : ∀ A, IsZero A → P A)
    (hiso : ∀ {A B}, (A ≅ B) → P A → P B)
    (hext : ∀ (S : ShortComplex (ModuleCat.{u + 1} (ULift.{u + 1} ℤ))),
      S.ShortExact → P S.X₁ → P S.X₃ → P S.X₂)
    (r e : ℕ) (hr : r.Prime)
    (hprime : P (ModuleCat.of (ULift.{u + 1} ℤ) (ULift.{u + 1} (ZMod r)))) :
    P (ModuleCat.of (ULift.{u + 1} ℤ) (ULift.{u + 1} (ZMod (r ^ e)))) := by
  induction e with
  | zero =>
      apply hzero
      simpa using (ModuleCat.isZero_of_subsingleton
        (ModuleCat.of (ULift.{u + 1} ℤ)
          (ULift.{u + 1} (ZMod (1 : ℕ)))))
  | succ e ih =>
      exact finite_torsion_prime_power_successor P hiso hext r e hr ih hprime

private theorem property_finite_pi
    {R : Type (u + 1)} [Ring R]
    (P : ModuleCat.{u + 1} R → Prop)
    (hzero : ∀ A, IsZero A → P A)
    (hiso : ∀ {A B}, (A ≅ B) → P A → P B)
    (hext : ∀ (S : ShortComplex (ModuleCat.{u + 1} R)),
      S.ShortExact → P S.X₁ → P S.X₃ → P S.X₂)
    (ι : Type) [Finite ι]
    (A : ι → Type (u + 1)) [∀ i, AddCommGroup (A i)]
    [∀ i, Module R (A i)]
    (hA : ∀ i, P (ModuleCat.of R (A i))) :
    P (ModuleCat.of R (∀ i, A i)) := by
  have hprod (B C : ModuleCat.{u + 1} R) (hB : P B) (hC : P C) :
      P (ModuleCat.of R (B × C)) := by
    apply hiso (biprodIsoProd B C)
    exact hext _ (ShortComplex.Splitting.ofHasBinaryBiproduct B C).shortExact hB hC
  let := Fintype.ofFinite ι
  revert A
  refine Fintype.induction_empty_option ?_ ?_ ?_ ι
  · intro α β _ e ih A _ _ hA
    exact hiso (LinearEquiv.piCongrLeft R A e).toModuleIso
      (ih (fun i ↦ A (e i)) (fun i ↦ hA (e i)))
  · intro A _ _ hA
    exact hzero _ (isZero_of_subsingleton _)
  · intro α _ ih A _ _ hA
    apply hiso (LinearEquiv.piOptionEquivProd R).symm.toModuleIso
    exact hprod _ _ (hA none) (ih (fun i ↦ A (some i)) (fun i ↦ hA (some i)))

private def liftedIntegerLinearEquiv
    {A B : Type (u + 1)} [AddCommGroup A] [AddCommGroup B]
    [Module (ULift.{u + 1} ℤ) A] [Module (ULift.{u + 1} ℤ) B]
    (f : A ≃+ B) : A ≃ₗ[ULift.{u + 1} ℤ] B where
  __ := f
  map_smul' r x := by
    simp only [RingHom.id_apply, AddEquiv.toFun_eq_coe]
    have hr : ((r.down : ℤ) : ULift.{u + 1} ℤ) = r := by
      ext
      simp
    simpa only [hr] using map_intCast_smul f (ULift.{u + 1} ℤ)
      (ULift.{u + 1} ℤ) r.down x

private theorem injective_nsmul_pow
    {A : Type (u + 1)} [AddCommGroup A] (r : ℕ)
    (hr : Function.Injective (fun x : A ↦ r • x)) (e : ℕ) :
    Function.Injective (fun x : A ↦ (r ^ e) • x) := by
  induction e with
  | zero =>
      intro x y h
      simpa only [pow_zero, one_nsmul] using h
  | succ e ih =>
      intro x y h
      apply ih
      apply hr
      simpa only [pow_succ, mul_nsmul] using h

/--
Assemble finitely many prime-power cyclic summands by split short exact
sequences.

Source: Stacks Project, Tag 0F08, cyclic-coefficient reduction; Mathlib's
finite abelian group decomposition.

Proof: Decompose the finite underlying additive group of `M` as a finite direct
sum of cyclic groups of prime-power order. The annihilation hypothesis implies
each nontrivial cyclic order divides `n`, and hence its prime divides `n`. If
multiplication by that prime on `M` were injective, multiplication by its power
would also be injective; since that power kills the embedded cyclic generator,
this would force the generator to be zero, a contradiction. The hypothesis `hp`
gives `P` for every nontrivial summand, and `hzero` handles trivial ones. Induct on the
finite index set of summands, using the split short exact sequence for adjoining
a direct summand, and transport the result back to `M` with `hiso`; the empty
sum is zero and is handled by `hzero`.
(blueprint: lem-sbc-finite-torsion-assemble-prime-powers)
-/
theorem finite_torsion_assemble_prime_powers
    (P : ModuleCat.{u + 1} (ULift.{u + 1} ℤ) → Prop)
    (hzero : ∀ A, IsZero A → P A)
    (hiso : ∀ {A B}, (A ≅ B) → P A → P B)
    (hext : ∀ (S : ShortComplex (ModuleCat.{u + 1} (ULift.{u + 1} ℤ))),
      S.ShortExact → P S.X₁ → P S.X₃ → P S.X₂)
    (M : ModuleCat.{u + 1} (ULift.{u + 1} ℤ)) [Finite M] (n : ℕ) (hn : n ≠ 0)
    (hM : ∀ x : M, n • x = 0)
    (hp : ∀ r e : ℕ, r.Prime → r ∣ n →
      ¬ Function.Injective (fun x : M ↦ r • x) →
      P (ModuleCat.of (ULift.{u + 1} ℤ) (ULift.{u + 1} (ZMod (r ^ e))))) : P M := by
  classical
  -- Nonzero is part of the original interface; assembly also holds when n = 0.
  have _ := hn
  obtain ⟨ι, hι, p, hprime, e, ⟨f⟩⟩ := AddCommGroup.equiv_directSum_zmod_of_finite M
  let F : M ≃+ (∀ i, ULift.{u + 1} (ZMod (p i ^ e i))) :=
    (f.trans (DirectSum.addEquivProd _)).trans
      (AddEquiv.piCongrRight fun _ ↦ AddEquiv.ulift.symm)
  apply hiso (liftedIntegerLinearEquiv F).symm.toModuleIso
  apply property_finite_pi P hzero hiso hext
  intro i
  by_cases he : e i = 0
  · apply hzero
    have : Subsingleton (ZMod (p i ^ e i)) :=
      ZMod.subsingleton_iff.mpr (by simp only [he, pow_zero])
    exact isZero_of_subsingleton _
  · let g : ZMod (p i ^ e i) →+ M :=
      f.symm.toAddMonoidHom.comp (DirectSum.of (fun j ↦ ZMod (p j ^ e j)) i)
    have hg : Function.Injective g :=
      f.symm.injective.comp (DirectSum.of_injective i)
    have hkill : (n : ZMod (p i ^ e i)) = 0 := by
      rw [← nsmul_one]
      apply hg
      rw [map_nsmul, map_zero]
      exact hM (g 1)
    have hdiv : p i ∣ n :=
      (dvd_pow_self (p i) he).trans ((ZMod.natCast_eq_zero_iff _ _).mp hkill)
    have hni : ¬ Function.Injective (fun x : M ↦ p i • x) := by
      intro hinj
      have hpow := injective_nsmul_pow (p i) hinj (e i)
      have hz : g (1 : ZMod (p i ^ e i)) = 0 := by
        apply hpow
        change (p i ^ e i) • g 1 = (p i ^ e i) • (0 : M)
        rw [← map_nsmul, nsmul_one]
        simp
      have hone : (1 : ZMod (p i ^ e i)) = 0 := hg (by simpa using hz)
      have hq : 1 < p i ^ e i := one_lt_pow₀ (hprime i).one_lt he
      have hbad := (ZMod.natCast_eq_zero_iff 1 (p i ^ e i)).mp (by simpa using hone)
      have := Nat.le_of_dvd (by omega : 0 < 1) hbad
      omega
    exact hp (p i) (e i) (hprime i) hdiv hni

theorem finite_torsion_property_of_prime
    (P : ModuleCat.{u + 1} (ULift.{u + 1} ℤ) → Prop)
    (hzero : ∀ A, IsZero A → P A)
    (hiso : ∀ {A B}, (A ≅ B) → P A → P B)
    (hext : ∀ (S : ShortComplex (ModuleCat.{u + 1} (ULift.{u + 1} ℤ))),
      S.ShortExact → P S.X₁ → P S.X₃ → P S.X₂)
    (M : ModuleCat.{u + 1} (ULift.{u + 1} ℤ)) [Finite M]
    (n : ℕ) (hn : n ≠ 0) (hM : ∀ x : M, n • x = 0)
    (hprime : ∀ r : ℕ, r.Prime → r ∣ n →
      ¬ Function.Injective (fun x : M ↦ r • x) →
      P (ModuleCat.of (ULift.{u + 1} ℤ) (ULift.{u + 1} (ZMod r)))) :
    P M := by
  apply finite_torsion_assemble_prime_powers P hzero hiso hext M n hn hM
  intro r e hr hdiv hni
  apply finite_torsion_prime_power_step P hzero hiso hext r e hr
  exact hprime r hr hdiv hni

end ModuleCat
