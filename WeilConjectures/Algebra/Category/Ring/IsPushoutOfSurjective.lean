module

public import Mathlib.Algebra.Category.Ring.Basic
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Defs
public import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Algebra.Category.Ring.Colimits
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Pushouts of commutative rings along surjections

A commutative square of commutative rings with surjective vertical maps `q : A ⟶ C` and
`r : B ⟶ D`, such that the kernel of `r` is generated by the image of the kernel of `q`, is a
pushout (`CommRingCat.isPushout_of_map_ker_eq_ker`): `D = B / (ker q) B = B ⊗_A A / ker q`.
Source: Stacks Project, Tag 00DE.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace CommRingCat

/-- A ring square with surjective vertical maps, whose right kernel is generated by the
image of the left kernel, is a pushout of commutative rings.
Source: Stacks Project, Tag 00DE (base change of a quotient). -/
theorem isPushout_of_map_ker_eq_ker {A B C D : CommRingCat.{u}}
    (f : A ⟶ B) (q : A ⟶ C) (r : B ⟶ D) (s : C ⟶ D)
    (hw : f ≫ r = q ≫ s) (hq : Function.Surjective q) (hr : Function.Surjective r)
    (hk : (RingHom.ker q.hom).map f.hom = RingHom.ker r.hom) :
    IsPushout f q r s := by
  classical
  apply IsPushout.of_isColimit (c := PushoutCocone.mk r s hw)
  apply PushoutCocone.isColimitAux'
  intro t
  have hker : RingHom.ker r.hom ≤ RingHom.ker t.inl.hom := by
    rw [← hk, Ideal.map_le_iff_le_comap]
    intro a ha
    have ht := ConcreteCategory.congr_hom t.condition a
    change t.inl (f a) = t.inr (q a) at ht
    change t.inl (f a) = 0
    rw [show q a = 0 from ha, map_zero] at ht
    exact ht
  let δ : D ⟶ t.pt := CommRingCat.ofHom
    (r.hom.liftOfSurjective hr ⟨t.inl.hom, hker⟩)
  have hd (b : B) : δ (r b) = t.inl b :=
    RingHom.liftOfSurjective_comp_apply _ _ _ _
  refine ⟨δ, ?_, ?_, ?_⟩
  · ext b
    exact hd b
  · ext c
    obtain ⟨a, rfl⟩ := hq c
    have hw' := ConcreteCategory.congr_hom hw a
    change r (f a) = s (q a) at hw'
    change δ (s (q a)) = t.inr (q a)
    rw [← hw', hd]
    exact ConcreteCategory.congr_hom t.condition a
  · intro m hm _
    ext d
    obtain ⟨b, rfl⟩ := hr d
    exact (ConcreteCategory.congr_hom hm b).trans (hd b).symm

end CommRingCat
