/-!
# Base change of homology over a reduced ring

Let `A` be a reduced ring, `S : X₁ ⟶ X₂ ⟶ X₃` a short complex of finitely generated `A`-modules
with `X₃` projective, and `K` a field which is an `A`-algebra, with kernel `t ⊆ A`. If the
dimension of the homology of `L ⊗[A] S` is the same for every field `L` over `A` whose kernel is
contained in `t`, then the base change map `K ⊗[A] H(S) ⟶ H(K ⊗[A] S)` is bijective
(`CategoryTheory.ShortComplex.bijective_homologyBaseChange_of_finrank_eq`).

This is the linear algebra behind Grauert's theorem. Over the local ring `R = A_t`, the
dimension of the homology at a point is `c₁ + c₂ - rank X₃`, where `c₁`, `c₂` are the fibre
dimensions of the cokernels of the two maps; these can only drop under generisation, so both are
constant on `Spec R`. A finitely generated module with constant fibre dimension over a reduced
local ring is free (`Module.free_of_finrank_residueField_tensor_eq`), so the cokernel of `g` is
flat over `R`, and then tensoring preserves the left exact sequence `0 ⟶ ker g ⟶ X₂ ⟶ X₃`.
-/

@[expose] public section

universe u

open CategoryTheory TensorProduct Module

section LeftExact

variable {R : Type*} [CommRing R] {M₂ M₃ : Type*} [AddCommGroup M₂] [Module R M₂]
  [AddCommGroup M₃] [Module R M₃]

/-- **Tensoring preserves a left exact sequence with flat cokernel.** For `g : M₂ ⟶ M₃` with
`M₃` and `M₃ ⧸ im g` flat, tensoring with any module `N` preserves the left exact sequence
`0 ⟶ ker g ⟶ M₂ ⟶ M₃`. -/
theorem LinearMap.injective_exact_lTensor_ker_of_flat (g : M₂ →ₗ[R] M₃) [Module.Flat R M₃]
    [Module.Flat R (M₃ ⧸ LinearMap.range g)] (N : Type*) [AddCommGroup N] [Module R N] :
    Function.Injective ((LinearMap.ker g).subtype.lTensor N) ∧
      Function.Exact ((LinearMap.ker g).subtype.lTensor N) (g.lTensor N) := by
  have hB : Function.Exact (LinearMap.range g).subtype (LinearMap.range g).mkQ := by
    intro x
    simp
  have : Module.Flat R (LinearMap.range g) :=
    Module.Flat.of_exact_of_flat_of_flat_right _ _ Subtype.val_injective
      (Submodule.mkQ_surjective _) hB
  have hBinj : Function.Injective ((LinearMap.range g).subtype.lTensor N) :=
    LinearMap.lTensor_injective_of_exact_of_flat _ (Submodule.mkQ_surjective _) _
      Subtype.val_injective hB N
  have hZ : Function.Exact (LinearMap.ker g).subtype g.rangeRestrict := by
    intro x
    simp [LinearMap.mem_ker, Subtype.ext_iff]
  refine ⟨LinearMap.lTensor_injective_of_exact_of_flat _ g.surjective_rangeRestrict _
    Subtype.val_injective hZ N, ?_⟩
  have hex := lTensor_exact N hZ g.surjective_rangeRestrict
  have hcomp : g.lTensor N =
      (LinearMap.range g).subtype.lTensor N ∘ₗ g.rangeRestrict.lTensor N := by
    rw [← LinearMap.lTensor_comp]
    rfl
  intro y
  rw [hcomp, LinearMap.comp_apply, map_eq_zero_iff _ hBinj]
  exact hex y

end LeftExact

open IsLocalRing
namespace Module



variable {R : Type u} [CommRing R] [IsLocalRing R] (M : Type u) [AddCommGroup M] [Module R M]

/-- A finitely generated module over a local ring is generated by `dim_k (k ⊗ M)` elements. -/
lemma exists_surjective_fin_finrank_residueField [Module.Finite R M] :
    ∃ φ : (Fin (finrank (ResidueField R) (ResidueField R ⊗[R] M)) → R) →ₗ[R] M,
      Function.Surjective φ := by
  set n := finrank (ResidueField R) (ResidueField R ⊗[R] M)
  let b := Module.finBasis (ResidueField R) (ResidueField R ⊗[R] M)
  choose v hv using fun i ↦ TensorProduct.mk_surjective R M (ResidueField R)
    IsLocalRing.residue_surjective (b i)
  refine ⟨Fintype.linearCombination R v, ?_⟩
  rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
  exact IsLocalRing.span_eq_top_of_tmul_eq_basis v b hv

/-- **Upper semicontinuity of the fibre dimension** at the closed point of a local ring: for a
finitely generated module `M`, `dim_L (L ⊗ M) ≤ dim_k (k ⊗ M)` for every field `L` over `R`. -/
lemma finrank_tensor_le_finrank_residueField (L : Type u) [Field L] [Algebra R L]
    [Module.Finite R M] :
    finrank L (L ⊗[R] M) ≤ finrank (ResidueField R) (ResidueField R ⊗[R] M) := by
  obtain ⟨φ, hφ⟩ := exists_surjective_fin_finrank_residueField (R := R) M
  have hs : Function.Surjective (φ.baseChange L) := by
    rw [LinearMap.baseChange_eq_ltensor]
    exact LinearMap.lTensor_surjective L hφ
  have h := LinearMap.finrank_range_le (φ.baseChange L)
  rw [LinearMap.range_eq_top.2 hs, finrank_top, Module.finrank_baseChange (M' := Fin _ → R),
    Module.finrank_fin_fun] at h
  exact h

/-- The fibre dimension of a module at a field `L` over `R`, through a local homomorphism, is its
fibre dimension at the closed point. -/
lemma finrank_tensor_eq_finrank_residueField (L : Type u) [Field L] [Algebra R L]
    [IsLocalHom (algebraMap R L)] :
    finrank L (L ⊗[R] M) = finrank (ResidueField R) (ResidueField R ⊗[R] M) := by
  let : Algebra (ResidueField R) L := (ResidueField.lift (algebraMap R L)).toAlgebra
  have : IsScalarTower R (ResidueField R) L := IsScalarTower.of_algebraMap_eq fun x ↦
    (congrArg (· x) (ResidueField.lift_comp_residue (algebraMap R L))).symm
  rw [← (AlgebraTensorModule.cancelBaseChange R (ResidueField R) L L M).finrank_eq,
    Module.finrank_baseChange]

/-- **A module of constant fibre dimension over a reduced local ring is free.** -/
theorem free_of_finrank_residueField_tensor_eq [IsReduced R] [Module.Finite R M]
    (h : ∀ (P : Ideal R) [P.IsPrime], finrank P.ResidueField (P.ResidueField ⊗[R] M) =
      finrank (ResidueField R) (ResidueField R ⊗[R] M)) :
    Module.Free R M := by
  obtain ⟨φ, hφ⟩ := exists_surjective_fin_finrank_residueField (R := R) M
  refine Module.Free.of_equiv (LinearEquiv.ofBijective φ ⟨?_, hφ⟩)
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro x hx
  rw [LinearMap.mem_ker] at hx
  rw [Submodule.mem_bot]
  funext i
  have hmem : x i ∈ nilradical R := by
    rw [nilradical_eq_sInf, Submodule.mem_sInf]
    intro P hP
    have : Ideal.IsPrime P := hP
    let L := Ideal.ResidueField P
    have hs : Function.Surjective (φ.baseChange L) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective L hφ
    have hinj : Function.Injective (φ.baseChange L) := by
      refine (LinearMap.injective_iff_surjective_of_finrank_eq_finrank ?_).2 hs
      rw [Module.finrank_baseChange, Module.finrank_fin_fun, h P]
    have h1 : (1 : L) ⊗ₜ[R] x = 0 := hinj (by rw [LinearMap.baseChange_tmul, hx, tmul_zero,
      map_zero])
    have h2 := congrArg ((TensorProduct.rid R L).toLinearMap ∘ₗ
      (LinearMap.proj (R := R) i).lTensor L) h1
    simp only [LinearMap.comp_apply, LinearMap.lTensor_tmul, LinearMap.proj_apply,
      map_zero] at h2
    rw [← Ideal.ker_algebraMap_residueField P, RingHom.mem_ker, Algebra.algebraMap_eq_smul_one]
    exact h2
  rw [nilradical_eq_zero] at hmem
  exact hmem

end Module

section Fibre

variable {R : Type u} [CommRing R] {X Y : Type u} [AddCommGroup X] [Module R X] [AddCommGroup Y]
  [Module R Y]

/-- The fibre dimension of a cokernel: `dim (L ⊗ coker h) + rank (L ⊗ h) = dim (L ⊗ Y)`. -/
lemma LinearMap.finrank_tensor_cokernel_add_finrank_range (h : X →ₗ[R] Y) (L : Type u) [Field L]
    [Algebra R L] [FiniteDimensional L (L ⊗[R] Y)] :
    finrank L (L ⊗[R] (Y ⧸ LinearMap.range h)) + finrank L (LinearMap.range (h.baseChange L)) =
      finrank L (L ⊗[R] Y) := by
  let q := (LinearMap.range h).mkQ.baseChange L
  have hq : Function.Surjective q := by
    rw [LinearMap.baseChange_eq_ltensor]
    exact LinearMap.lTensor_surjective L (Submodule.mkQ_surjective _)
  have hex : Function.Exact (h.baseChange L) q := by
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    exact lTensor_exact L (LinearMap.exact_iff.2 (Submodule.ker_mkQ _))
      (Submodule.mkQ_surjective _)
  have h₁ := LinearMap.finrank_range_add_finrank_ker q
  rw [LinearMap.range_eq_top.2 hq, finrank_top, LinearMap.exact_iff.1 hex] at h₁
  exact h₁

end Fibre

section Transitivity

variable {A : Type u} [CommRing A] (R : Type u) [CommRing R] [Algebra A R] (L : Type u)
  [Field L] [Algebra A L] [Algebra R L] [IsScalarTower A R L] {X Y : Type u} [AddCommGroup X]
  [Module A X] [AddCommGroup Y] [Module A Y]

/-- Base change in two steps `A ⟶ R ⟶ L` does not change the rank of a linear map. -/
lemma LinearMap.finrank_range_baseChange_baseChange (h : X →ₗ[A] Y) :
    finrank L (LinearMap.range ((h.baseChange R).baseChange L)) =
      finrank L (LinearMap.range (h.baseChange L)) := by
  let eX := AlgebraTensorModule.cancelBaseChange A R L L X
  let eY := AlgebraTensorModule.cancelBaseChange A R L L Y
  have hc : eY.toLinearMap ∘ₗ (h.baseChange R).baseChange L = h.baseChange L ∘ₗ eX.toLinearMap := by
    refine LinearMap.ext fun x ↦ ?_
    induction x using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => rw [map_add, map_add, hx, hy]
    | tmul l y =>
      induction y using TensorProduct.induction_on with
      | zero => simp
      | add y y' hy hy' =>
        rw [tmul_add, map_add, map_add, hy, hy']
      | tmul r x =>
        simp [eX, eY, AlgebraTensorModule.cancelBaseChange_tmul]
  have h₁ := congrArg LinearMap.range hc
  rw [LinearMap.range_comp, LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range eX)] at h₁
  rw [← h₁, LinearEquiv.finrank_map_eq]

end Transitivity

namespace CategoryTheory.ShortComplex

open IsLocalRing

variable {A : Type u} [CommRing A] (S : ShortComplex (ModuleCat.{u} A))

/-- The dimension of the homology of `L ⊗[A] S` over a field `L` which is an algebra over an
`A`-algebra `R`, in terms of the fibre dimensions at `L` of the cokernels of `R ⊗[A] S`. -/
lemma finrank_homology_baseChange_add_finrank (R : Type u) [CommRing R] [Algebra A R]
    (L : Type u) [Field L] [Algebra A L] [Algebra R L] [IsScalarTower A R L]
    [Module.Finite A S.X₂] [Module.Finite A S.X₃] :
    finrank L (S.baseChange L).homology + finrank L (L ⊗[A] S.X₃) =
      finrank L (L ⊗[R] (R ⊗[A] S.X₂ ⧸ LinearMap.range (S.f.hom.baseChange R))) +
        finrank L (L ⊗[R] (R ⊗[A] S.X₃ ⧸ LinearMap.range (S.g.hom.baseChange R))) := by
  have : FiniteDimensional L (S.baseChange L).X₂ :=
    inferInstanceAs (FiniteDimensional L (L ⊗[A] S.X₂))
  have h₁ := (S.baseChange L).finrank_homology_add_finrank_range_add_finrank_range
  have h₂ := (S.g.hom.baseChange R).finrank_tensor_cokernel_add_finrank_range L
  have h₃ := (S.f.hom.baseChange R).finrank_tensor_cokernel_add_finrank_range L
  rw [LinearMap.finrank_range_baseChange_baseChange,
    (AlgebraTensorModule.cancelBaseChange A R L L S.X₃).finrank_eq] at h₂
  rw [LinearMap.finrank_range_baseChange_baseChange,
    (AlgebraTensorModule.cancelBaseChange A R L L S.X₂).finrank_eq] at h₃
  change finrank L (S.baseChange L).homology + finrank L (LinearMap.range (S.g.hom.baseChange L)) +
    finrank L (LinearMap.range (S.f.hom.baseChange L)) = finrank L (L ⊗[A] S.X₂) at h₁
  omega

/-- **Base change of homology over a reduced ring** (the linear algebra of Grauert's theorem).
Let `A` be a reduced ring, `S : X₁ ⟶ X₂ ⟶ X₃` a short complex of finitely generated `A`-modules
with `X₃` projective, and `K` a field over `A`, with kernel `t`. If `dim_L H(L ⊗[A] S)` equals
`dim_K H(K ⊗[A] S)` for every field `L` over `A` whose kernel is contained in `t` (the points of
`Spec A` generalising `t`), then the base change map `K ⊗[A] H(S) ⟶ H(K ⊗[A] S)` is bijective. -/
theorem bijective_homologyBaseChange_of_finrank_eq [IsReduced A] [Module.Finite A S.X₁]
    [Module.Finite A S.X₂] [Module.Finite A S.X₃] [Module.Projective A S.X₃]
    (K : Type u) [Field K] [Algebra A K]
    (h : ∀ (L : Type u) [Field L] [Algebra A L],
      RingHom.ker (algebraMap A L) ≤ RingHom.ker (algebraMap A K) →
        finrank L (S.baseChange L).homology = finrank K (S.baseChange K).homology) :
    Function.Bijective (S.homologyBaseChange K) := by
  set t := RingHom.ker (algebraMap A K)
  have : t.IsPrime := RingHom.ker_isPrime _
  let R := Localization.AtPrime t
  have hunit (y : t.primeCompl) : IsUnit (algebraMap A K y) :=
    isUnit_iff_ne_zero.2 fun h0 ↦ y.2 h0
  let : Algebra R K := (IsLocalization.lift hunit).toAlgebra
  have : IsScalarTower A R K :=
    IsScalarTower.of_algebraMap_eq fun a ↦ (IsLocalization.lift_eq hunit a).symm
  have hmax : maximalIdeal R ≤ RingHom.ker (algebraMap R K) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal t R, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, ← IsScalarTower.algebraMap_apply]
    exact ha
  have : IsLocalHom (algebraMap R K) := ⟨fun x hx ↦ by
    by_contra hx'
    exact (hx.ne_zero) (hmax hx')⟩
  -- the cokernels of the maps of `R ⊗[A] S`
  let C₁ := R ⊗[A] S.X₂ ⧸ LinearMap.range (S.f.hom.baseChange R)
  let C₂ := R ⊗[A] S.X₃ ⧸ LinearMap.range (S.g.hom.baseChange R)
  have : Module.Free R (R ⊗[A] S.X₃) := Module.free_of_flat_of_isLocalRing
  -- fibre dimensions at a field `L` over `R`
  have key (L : Type u) [Field L] [Algebra A L] [Algebra R L] [IsScalarTower A R L] :
      finrank L (S.baseChange L).homology + finrank R (R ⊗[A] S.X₃) =
        finrank L (L ⊗[R] C₁) + finrank L (L ⊗[R] C₂) := by
    rw [← S.finrank_homology_baseChange_add_finrank R L,
      ← (AlgebraTensorModule.cancelBaseChange A R L L S.X₃).finrank_eq,
      Module.finrank_baseChange (R := L) (S := R) (M' := R ⊗[A] S.X₃)]
  have hK := key K
  rw [Module.finrank_tensor_eq_finrank_residueField (R := R) C₁ K,
    Module.finrank_tensor_eq_finrank_residueField (R := R) C₂ K] at hK
  -- the fibre dimension of `C₂` is constant on `Spec R`
  have hC₂ (P : Ideal R) [P.IsPrime] : finrank P.ResidueField (P.ResidueField ⊗[R] C₂) =
      finrank (ResidueField R) (ResidueField R ⊗[R] C₂) := by
    let : Algebra A P.ResidueField :=
      ((algebraMap R P.ResidueField).comp (algebraMap A R)).toAlgebra
    have : IsScalarTower A R P.ResidueField := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
    have hP : RingHom.ker (algebraMap A P.ResidueField) ≤ t := by
      intro a ha
      have ha' : algebraMap A R a ∈ maximalIdeal R := by
        refine (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)) ?_
        rw [← Ideal.ker_algebraMap_residueField P, RingHom.mem_ker]
        exact ha
      rw [← Localization.AtPrime.under_maximalIdeal (I := t)]
      exact ha'
    have hL := key P.ResidueField
    rw [h P.ResidueField hP] at hL
    have l₁ := Module.finrank_tensor_le_finrank_residueField (R := R) C₁ P.ResidueField
    have l₂ := Module.finrank_tensor_le_finrank_residueField (R := R) C₂ P.ResidueField
    omega
  have : Module.Free R C₂ := Module.free_of_finrank_residueField_tensor_eq (R := R) C₂ hC₂
  -- tensoring with `K` over `R` preserves the left exact sequence `0 ⟶ ker g ⟶ X₂ ⟶ X₃`
  obtain ⟨hinjR, hexR⟩ :=
    LinearMap.injective_exact_lTensor_ker_of_flat (S.g.hom.baseChange R) K
  -- the cycles of `R ⊗[A] S` are the base change of those of `S`, `R` being flat over `A`
  set Z := LinearMap.ker S.g.hom
  set gR := S.g.hom.baseChange R
  have hZg : S.g.hom ∘ₗ Z.subtype = 0 := by
    ext x
    exact x.2
  have hgZ (x : R ⊗[A] Z) : gR (Z.subtype.baseChange R x) = 0 := by
    rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp, hZg, LinearMap.baseChange_zero,
      LinearMap.zero_apply]
  let jR : R ⊗[A] Z →ₗ[R] LinearMap.ker gR := (Z.subtype.baseChange R).codRestrict _ hgZ
  have hexZ : Function.Exact Z.subtype S.g.hom := fun x ↦ by
    simp [Z]
  have hjR : Function.Bijective jR := by
    constructor
    · intro x y hxy
      have hxy' := congrArg Subtype.val hxy
      simp only [jR, LinearMap.codRestrict_apply, LinearMap.baseChange_eq_ltensor] at hxy'
      exact Module.Flat.lTensor_preserves_injective_linearMap _ Subtype.val_injective hxy'
    · rintro ⟨y, hy⟩
      have hy' : S.g.hom.lTensor R y = 0 := by
        rw [← LinearMap.baseChange_eq_ltensor]
        exact hy
      obtain ⟨x, hx⟩ := ((Module.Flat.lTensor_exact R hexZ) y).1 hy'
      exact ⟨x, Subtype.ext (by
        simp only [jR, LinearMap.codRestrict_apply, LinearMap.baseChange_eq_ltensor]
        exact hx)⟩
  let eJ := LinearEquiv.ofBijective jR hjR
  let cZ := (AlgebraTensorModule.cancelBaseChange A R K K Z).symm
  let c₂ := (AlgebraTensorModule.cancelBaseChange A R K K S.X₂).symm
  let c₃ := (AlgebraTensorModule.cancelBaseChange A R K K S.X₃).symm
  have hA (w : K ⊗[A] Z) : (LinearMap.ker gR).subtype.lTensor K (eJ.lTensor K (cZ w)) =
      c₂ (Z.subtype.lTensor K w) := by
    induction w using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul k z =>
      simp only [cZ, c₂, AlgebraTensorModule.cancelBaseChange_symm_tmul, LinearMap.lTensor_tmul,
        LinearEquiv.lTensor_tmul]
      rfl
  have hB (v : K ⊗[A] S.X₂) : gR.lTensor K (c₂ v) = c₃ (S.g.hom.lTensor K v) := by
    induction v using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul k x =>
      simp only [c₂, c₃, gR, AlgebraTensorModule.cancelBaseChange_symm_tmul,
        LinearMap.lTensor_tmul, LinearMap.baseChange_tmul]
  rw [bijective_homologyBaseChange_iff]
  refine S.bijective_homologyBaseChangeAux_of_exact K (fun w w' hw ↦ ?_) (fun v ↦ ?_)
  · have := congrArg c₂ hw
    rw [← hA, ← hA] at this
    exact cZ.injective ((eJ.lTensor K).injective (hinjR this))
  · rw [← map_eq_zero_iff _ c₃.injective, ← hB, hexR]
    constructor
    · rintro ⟨u, hu⟩
      obtain ⟨u, rfl⟩ := (eJ.lTensor K).surjective u
      obtain ⟨w, rfl⟩ := cZ.surjective u
      refine ⟨w, c₂.injective ?_⟩
      rw [← hA, ← hu]
    · rintro ⟨w, rfl⟩
      exact ⟨_, hA w⟩

end CategoryTheory.ShortComplex
