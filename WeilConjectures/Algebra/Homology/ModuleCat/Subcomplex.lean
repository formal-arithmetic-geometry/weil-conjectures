/-!
# Subcomplexes of complexes of modules

Let `L` be a cochain complex of `R`-modules. A family of submodules `N n ≤ Lⁿ` which is stable
under the differential defines a subcomplex `CochainComplex.subcomplex L N` of `L`, with its
inclusion `CochainComplex.subcomplexι L N`.

The subcomplexes with finitely generated terms which vanish outside a finite interval exhaust
`L`, also after tensoring with any complex `F`: every element of `(L ⊗ F)ʲ` comes from
`(L' ⊗ F)ʲ` for such a subcomplex `L'` (`CochainComplex.exists_mem_range_tensor`). If the terms
of `F` are flat, `L' ⊗ F` is a subcomplex of `L ⊗ F`
(`CochainComplex.injective_subcomplexι_whiskerRight_f`).

## Main definitions

- `CochainComplex.SubcomplexFamily`: a family of submodules stable under the differential.
- `CochainComplex.subcomplex`, `CochainComplex.subcomplexι`: the corresponding subcomplex.
- `CochainComplex.SubcomplexFamily.IsFinite`: the family consists of finitely generated
  submodules, vanishing outside a finite interval.

## Main statements

- `CochainComplex.exists_mem_range_tensor`: every element of `(L ⊗ F)ʲ` lies in the image of
  `(L' ⊗ F)ʲ` for a finite subcomplex `L'` of `L`.
- `CochainComplex.injective_subcomplexι_whiskerRight_f`: if the terms of `F` are flat
  modules, the inclusion `L' ⊗ F ⟶ L ⊗ F` is injective in every degree.
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory

namespace CochainComplex

variable {R : Type u} [CommRing R] (L : CochainComplex (ModuleCat.{u} R) ℤ)

/-- A family of submodules `N n ≤ Lⁿ` of the terms of a complex of modules `L`, stable under
the differential. -/
structure SubcomplexFamily where
  /-- The submodule of the term in degree `n`. -/
  N (n : ℤ) : Submodule R (L.X n)
  map_d_le (n : ℤ) : (N n).map (L.d n (n + 1)).hom ≤ N (n + 1)

namespace SubcomplexFamily

variable {L}

instance : LE L.SubcomplexFamily where
  le N N' := ∀ n, N.N n ≤ N'.N n

instance : Max L.SubcomplexFamily where
  max N N' :=
    { N := fun n ↦ N.N n ⊔ N'.N n
      map_d_le := fun n ↦ by
        rw [Submodule.map_sup]
        exact sup_le_sup (N.map_d_le n) (N'.map_d_le n) }

instance : Bot L.SubcomplexFamily where
  bot :=
    { N := fun _ ↦ ⊥
      map_d_le := fun n ↦ by simp }

lemma le_max_left (N N' : L.SubcomplexFamily) : N ≤ max N N' := fun _ ↦ le_sup_left

lemma le_max_right (N N' : L.SubcomplexFamily) : N' ≤ max N N' := fun _ ↦ le_sup_right

/-- A family of submodules is *finite* if its members are finitely generated and vanish outside
a finite interval. -/
def IsFinite (N : L.SubcomplexFamily) : Prop :=
  (∀ n, (N.N n).FG) ∧ ∃ a b : ℤ, ∀ n, n < a ∨ b < n → N.N n = ⊥

lemma isFinite_bot : (⊥ : L.SubcomplexFamily).IsFinite :=
  ⟨fun _ ↦ Submodule.fg_bot, 0, 0, fun _ _ ↦ rfl⟩

lemma IsFinite.max {N N' : L.SubcomplexFamily} (hN : N.IsFinite) (hN' : N'.IsFinite) :
    (max N N').IsFinite := by
  obtain ⟨h₁, a, b, h₂⟩ := hN
  obtain ⟨h₁', a', b', h₂'⟩ := hN'
  refine ⟨fun n ↦ (h₁ n).sup (h₁' n), min a a', Max.max b b', fun n hn ↦ ?_⟩
  change N.N n ⊔ N'.N n = ⊥
  rw [h₂ n (by omega), h₂' n (by omega), sup_bot_eq]

/-- The subcomplex generated by an element `x` of `Lᵖ`: it is spanned by `x` in degree `p` and
by `dx` in degree `p + 1`. -/
noncomputable def span {p : ℤ} (x : L.X p) : L.SubcomplexFamily where
  N n := (⨆ h : p = n, Submodule.span R {(L.XIsoOfEq h).hom x}) ⊔
    Submodule.span R {(L.d p n).hom x}
  map_d_le n := by
    rw [Submodule.map_sup, Submodule.map_iSup]
    refine sup_le (iSup_le fun h ↦ ?_) ?_
    · subst h
      rw [Submodule.map_span, Set.image_singleton]
      refine le_sup_of_le_right (Submodule.span_mono ?_)
      simp
    · rw [Submodule.map_span, Set.image_singleton, ← ModuleCat.comp_apply, L.d_comp_d]
      simp

lemma mem_span_self {p : ℤ} (x : L.X p) : x ∈ (span x).N p := by
  refine Submodule.mem_sup_left (Submodule.mem_iSup_of_mem rfl ?_)
  simp

lemma isFinite_span {p : ℤ} (x : L.X p) : (span x).IsFinite := by
  refine ⟨fun n ↦ ?_, p, p + 1, fun n hn ↦ ?_⟩
  · refine Submodule.FG.sup ?_ (Submodule.fg_span_singleton _)
    by_cases h : p = n
    · subst h
      simpa using Submodule.fg_span_singleton x
    · simpa [h] using Submodule.fg_bot
  · change (⨆ h : p = n, _) ⊔ _ = ⊥
    have h₁ : ¬ p = n := by omega
    rw [L.shape p n (by simp; omega)]
    simp [h₁]

end SubcomplexFamily

variable {L} (N : L.SubcomplexFamily)

/-- The subcomplex of `L` defined by a family of submodules stable under the differential. -/
noncomputable def subcomplex : CochainComplex (ModuleCat.{u} R) ℤ :=
  CochainComplex.of (fun n ↦ ModuleCat.of R (N.N n))
    (fun n ↦ ModuleCat.ofHom ((L.d n (n + 1)).hom.restrict
      fun x hx ↦ N.map_d_le n ⟨x, hx, rfl⟩))
    (fun n ↦ by
      ext x
      change (L.d (n + 1) (n + 1 + 1)).hom ((L.d n (n + 1)).hom x.1) = 0
      rw [← ModuleCat.comp_apply, L.d_comp_d]
      rfl)

/-- The inclusion of the subcomplex defined by a family of submodules. -/
noncomputable def subcomplexι : subcomplex N ⟶ L :=
  CochainComplex.ofHom (fun n ↦ ModuleCat.ofHom (N.N n).subtype)
    (fun n ↦ by simp only [subcomplex, CochainComplex.of_d]; rfl)

lemma subcomplexι_f_apply (n : ℤ) (x : (subcomplex N).X n) :
    (subcomplexι N).f n x = ((show N.N n from x) : L.X n) := rfl

lemma injective_subcomplexι_f (n : ℤ) : Function.Injective ((subcomplexι N).f n) :=
  Subtype.val_injective

lemma range_subcomplexι_f (n : ℤ) : LinearMap.range ((subcomplexι N).f n).hom = N.N n :=
  Submodule.range_subtype _

/-- The inclusion of subcomplexes defined by families `N ≤ N'`. -/
noncomputable def subcomplexMap {N N' : L.SubcomplexFamily} (h : N ≤ N') :
    subcomplex N ⟶ subcomplex N' :=
  CochainComplex.ofHom (fun n ↦ ModuleCat.ofHom (Submodule.inclusion (h n)))
    (fun n ↦ by simp only [subcomplex, CochainComplex.of_d]; rfl)

@[reassoc (attr := simp)]
lemma subcomplexMap_subcomplexι {N N' : L.SubcomplexFamily} (h : N ≤ N') :
    subcomplexMap h ≫ subcomplexι N' = subcomplexι N := rfl

/-- A finite subcomplex is bounded below. -/
lemma isStrictlyGE_subcomplex {N : L.SubcomplexFamily} {a : ℤ}
    (h : ∀ n, n < a → N.N n = ⊥) : (subcomplex N).IsStrictlyGE a := by
  rw [isStrictlyGE_iff]
  intro n hn
  rw [ModuleCat.isZero_iff_subsingleton]
  change Subsingleton (N.N n)
  rw [h n hn]
  infer_instance

/-- A finite subcomplex is bounded above. -/
lemma isStrictlyLE_subcomplex {N : L.SubcomplexFamily} {b : ℤ}
    (h : ∀ n, b < n → N.N n = ⊥) : (subcomplex N).IsStrictlyLE b := by
  rw [isStrictlyLE_iff]
  intro n hn
  rw [ModuleCat.isZero_iff_subsingleton]
  change Subsingleton (N.N n)
  rw [h n hn]
  infer_instance

lemma SubcomplexFamily.IsFinite.finite {N : L.SubcomplexFamily} (hN : N.IsFinite) (n : ℤ) :
    Module.Finite R ((subcomplex N).X n) :=
  Module.Finite.iff_fg.2 (hN.1 n)

section Tensor

variable (F : CochainComplex (ModuleCat.{u} R) ℤ)

lemma range_subcomplexι_whiskerRight_f_mono {N N' : L.SubcomplexFamily} (h : N ≤ N') (j : ℤ) :
    LinearMap.range ((subcomplexι N ▷ F).f j).hom ≤
      LinearMap.range ((subcomplexι N' ▷ F).f j).hom := by
  rw [← subcomplexMap_subcomplexι h, comp_whiskerRight, HomologicalComplex.comp_f,
    ModuleCat.hom_comp]
  exact LinearMap.range_comp_le_range _ _

variable (L) in
/-- The elements of `(L ⊗ F)ʲ` coming from a finite subcomplex of `L`. -/
noncomputable def tensorFiniteSubmodule (j : ℤ) : Submodule R ((L ⊗ F).X j) where
  carrier := {x | ∃ N : L.SubcomplexFamily, N.IsFinite ∧
    x ∈ LinearMap.range ((subcomplexι N ▷ F).f j).hom}
  zero_mem' := ⟨⊥, SubcomplexFamily.isFinite_bot, zero_mem _⟩
  add_mem' := by
    rintro x y ⟨N, hN, hx⟩ ⟨N', hN', hy⟩
    exact ⟨max N N', hN.max hN',
      add_mem (range_subcomplexι_whiskerRight_f_mono F (SubcomplexFamily.le_max_left N N') j hx)
        (range_subcomplexι_whiskerRight_f_mono F (SubcomplexFamily.le_max_right N N') j hy)⟩
  smul_mem' := by
    rintro r x ⟨N, hN, hx⟩
    exact ⟨N, hN, Submodule.smul_mem _ r hx⟩

lemma range_ιTensorObj_le (p q j : ℤ) (h : p + q = j) :
    LinearMap.range (HomologicalComplex.ιTensorObj L F p q j h).hom ≤
      tensorFiniteSubmodule L F j := by
  rintro _ ⟨z, rfl⟩
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add z z' hz hz' => simpa using add_mem hz hz'
  | tmul l f =>
    let N := SubcomplexFamily.span l
    let y : ((subcomplex N).X p ⊗ F.X q : ModuleCat.{u} R) :=
      (show (subcomplex N).X p from ⟨l, SubcomplexFamily.mem_span_self l⟩) ⊗ₜ f
    refine ⟨N, SubcomplexFamily.isFinite_span l,
      HomologicalComplex.ιTensorObj (subcomplex N) F p q j h y, ?_⟩
    refine (ConcreteCategory.congr_hom
      (HomologicalComplex.ι_mapBifunctorMap (subcomplexι N) (𝟙 F) (curriedTensor _) (.up ℤ)
        p q j h) y).trans ?_
    rfl

/-- Every element of `(L ⊗ F)ʲ` comes from `(L' ⊗ F)ʲ` for a subcomplex `L'` of `L` with
finitely generated terms, vanishing outside a finite interval. -/
lemma exists_mem_range_tensor (j : ℤ) (x : (L ⊗ F).X j) :
    ∃ N : L.SubcomplexFamily, N.IsFinite ∧
      x ∈ LinearMap.range ((subcomplexι N ▷ F).f j).hom := by
  let S := tensorFiniteSubmodule L F j
  let π : (L ⊗ F).X j ⟶ ModuleCat.of R ((L ⊗ F).X j ⧸ S) := ModuleCat.ofHom S.mkQ
  have hπ : π = 0 := HomologicalComplex.mapBifunctor.hom_ext fun p q h ↦ by
    ext z
    change S.mkQ (HomologicalComplex.ιTensorObj L F p q j h z) = 0
    exact (Submodule.Quotient.mk_eq_zero S).2 (range_ιTensorObj_le F p q j h ⟨z, rfl⟩)
  have : π x = 0 := by rw [hπ]; rfl
  exact (Submodule.Quotient.mk_eq_zero S).1 this

/-- If the terms of `F` are flat, the inclusion `L' ⊗ F ⟶ L ⊗ F` of a subcomplex is a
monomorphism in every degree: it is the coproduct of the monomorphisms `L'ᵖ ⊗ F^q ⟶ Lᵖ ⊗ F^q`.
-/
lemma mono_subcomplexι_whiskerRight_f (hF : ∀ q, ObjectProperty.flat (F.X q)) (j : ℤ) :
    Mono ((subcomplexι N ▷ F).f j) := by
  have (i : ℤ × ℤ) : Mono ((subcomplexι N).f i.1 ▷ F.X i.2) := by
    have : PreservesFiniteLimits (tensorRight (F.X i.2)) := (hF i.2).tensorRight.1
    have : PreservesLimitsOfShape WalkingCospan (tensorRight (F.X i.2)) := inferInstance
    have : Mono ((subcomplexι N).f i.1) :=
      (ModuleCat.mono_iff_injective _).2 (injective_subcomplexι_f N i.1)
    exact (tensorRight (F.X i.2)).map_mono ((subcomplexι N).f i.1)
  exact MorphismProperty.IsStableUnderColimitsOfShape.condition
    (W := MorphismProperty.monomorphisms (ModuleCat.{u} R)) _ _ (colimit.cocone _)
    (colimit.cocone _) (colimit.isColimit _) (colimit.isColimit _)
    (Discrete.natTrans fun i ↦ (subcomplexι N).f i.as.1.1 ▷ F.X i.as.1.2)
    (fun i ↦ this i.as.1) _ (fun ⟨⟨⟨p, q⟩, h⟩⟩ ↦ by
      refine (HomologicalComplex.ι_mapBifunctorMap (subcomplexι N) (𝟙 F) _ _ p q j h).trans ?_
      simp only [curriedTensor_obj_obj, curriedTensor_map_app, HomologicalComplex.id_f,
        curriedTensor_obj_map, whiskerLeft_id, Category.id_comp,
        Functor.mapBifunctorHomologicalComplex_obj_obj_toGradedObject,
        Discrete.functor_obj_eq_as, Functor.const_obj_obj]
      rfl)

lemma injective_subcomplexι_whiskerRight_f (hF : ∀ q, ObjectProperty.flat (F.X q)) (j : ℤ) :
    Function.Injective ((subcomplexι N ▷ F).f j) :=
  (ModuleCat.mono_iff_injective _).1 (mono_subcomplexι_whiskerRight_f N F hF j)

end Tensor

end CochainComplex
