module

public import Mathlib.Algebra.EuclideanDomain.Int
public import Mathlib.Algebra.Module.Injective
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.Tactic.LinearCombination
public import Mathlib.Data.ZMod.Basic
public import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# `ℤ/n` is self-injective and cogenerates

Let `R` be a commutative ring which is a quotient `ℤ/n` of the integers, `n > 0` (e.g. `ZMod n`
or `ULift (ZMod n)`), in the sense that `ℤ ⟶ R` is surjective with kernel `nℤ`. Then:

* `R` is an injective `R`-module (`ZModLike.injective_self`): by Baer's criterion, every ideal
  of `R` is generated by a divisor `D` of `n`, and a map `g : (D) ⟶ R` is multiplication by an
  element, since `g(D)` is killed by `n / D`, hence divisible by `D`;
* `R` cogenerates: every nonzero element `x` of an `R`-module `M` is detected by a linear form
  `M ⟶ R` (`ZModLike.exists_apply_ne_zero`): the annihilator of `x` is `(E)` for a divisor
  `E ≠ ±1` of `n`, so `r • x ↦ r (n / E)` is a well-defined injective map `R x ⟶ R`, which
  extends to `M` by injectivity.

These are the inputs for the degreewise Poincaré duality with coefficients `ℤ/ℓᵐ`: over a
self-injective ring the dual of a complex is computed degreewise, and over a cogenerator the
duality pairing on finite modules is nondegenerate.
-/

@[expose] public section

universe v

namespace ZModLike

variable {R : Type v} [CommRing R] {n : ℕ}

/-- Every ideal of `ℤ/n` is generated by a divisor of `n`. -/
lemma exists_ideal_eq_span (hn : 0 < n) (h0 : ((n : ℤ) : R) = 0) (I : Ideal R) :
    ∃ D : ℤ, D ∣ n ∧ D ≠ 0 ∧ ∀ z : ℤ, (z : R) ∈ I ↔ D ∣ z := by
  obtain ⟨D, hD⟩ := (IsPrincipalIdealRing.principal (I.comap (Int.castRingHom R))).principal
  have hmem (z : ℤ) : (z : R) ∈ I ↔ D ∣ z := by
    have h := Set.ext_iff.1 (congrArg (fun J : Ideal ℤ ↦ (J : Set ℤ)) hD) z
    simp only [SetLike.mem_coe, Ideal.mem_comap, eq_intCast] at h
    rw [h]
    exact Ideal.mem_span_singleton
  have hDn : D ∣ n := (hmem n).1 (by rw [h0]; exact I.zero_mem)
  refine ⟨D, hDn, ?_, hmem⟩
  rintro rfl
  rw [zero_dvd_iff] at hDn
  omega

/-- **`ℤ/n` is self-injective**, by Baer's criterion. -/
theorem baer_self (hn : 0 < n) (h0 : ((n : ℤ) : R) = 0)
    (hsurj : Function.Surjective (Int.castRingHom R)) (hker : ∀ z : ℤ, (z : R) = 0 → (n : ℤ) ∣ z) :
    Module.Baer R R := by
  intro I g
  obtain ⟨D, hDn, hD0, hmem⟩ := exists_ideal_eq_span hn h0 I
  obtain ⟨c, hc⟩ := hDn
  have hDI : (D : R) ∈ I := (hmem D).2 dvd_rfl
  obtain ⟨A, hA⟩ := hsurj (g ⟨D, hDI⟩)
  -- `g(D)` is killed by `c = n / D`
  have hca : ((c * A : ℤ) : R) = 0 := by
    have : (c : R) • (⟨D, hDI⟩ : I) = 0 := by
      ext
      change (c : R) * D = 0
      rw [← Int.cast_mul, mul_comm, ← hc, h0]
    rw [Int.cast_mul, ← eq_intCast (Int.castRingHom R) A, hA, ← smul_eq_mul, ← map_smul, this,
      map_zero]
  obtain ⟨k, hk⟩ := hker _ hca
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hc
    omega
  have hDA : D ∣ A := ⟨k, mul_left_cancel₀ hc0 (by rw [hk, hc]; ring)⟩
  obtain ⟨b, rfl⟩ := hDA
  refine ⟨LinearMap.mulRight R (b : R), fun x hx ↦ ?_⟩
  obtain ⟨z, rfl⟩ := hsurj x
  obtain ⟨w, hw⟩ := (hmem z).1 hx
  have : (⟨(Int.castRingHom R) z, hx⟩ : I) = (w : R) • ⟨D, hDI⟩ := by
    ext
    change ((z : ℤ) : R) = (w : R) * D
    rw [hw, Int.cast_mul, mul_comm]
  rw [this, map_smul, ← hA, LinearMap.mulRight_apply, smul_eq_mul]
  change ((z : ℤ) : R) * (b : R) = (w : R) * ((Int.castRingHom R) (D * b))
  rw [hw, eq_intCast]
  push_cast
  ring

/-- **`ℤ/n` cogenerates.** Every nonzero element of an `R`-module (in the universe of `R`) is
detected by a linear form. -/
theorem exists_apply_ne_zero (hn : 0 < n) (h0 : ((n : ℤ) : R) = 0)
    (hsurj : Function.Surjective (Int.castRingHom R)) (hker : ∀ z : ℤ, (z : R) = 0 → (n : ℤ) ∣ z)
    [Module.Injective R R] {M : Type v} [AddCommGroup M] [Module R M] {x : M} (hx : x ≠ 0) :
    ∃ χ : M →ₗ[R] R, χ x ≠ 0 := by
  let φ : R →ₗ[R] M := LinearMap.toSpanSingleton R M x
  obtain ⟨E, hEn, -, hmem⟩ := exists_ideal_eq_span hn h0 (LinearMap.ker φ)
  obtain ⟨c, hc⟩ := hEn
  let ψ : R →ₗ[R] R := LinearMap.mulRight R (c : R)
  have hle : LinearMap.ker φ ≤ LinearMap.ker ψ := by
    intro r hr
    obtain ⟨z, rfl⟩ := hsurj r
    obtain ⟨w, hw⟩ := (hmem z).1 hr
    have hwc : E * w * c = w * (n : ℤ) := by
      rw [hc]
      ring
    rw [LinearMap.mem_ker, LinearMap.mulRight_apply, eq_intCast, hw, ← Int.cast_mul, hwc,
      Int.cast_mul, h0, mul_zero]
  let ψ' : LinearMap.range φ →ₗ[R] R :=
    ((LinearMap.ker φ).liftQ ψ hle).comp φ.quotKerEquivRange.symm.toLinearMap
  obtain ⟨χ, hχ⟩ := Module.Injective.out (LinearMap.range φ).subtype Subtype.val_injective ψ'
  refine ⟨χ, fun hχx ↦ hx ?_⟩
  have hx1 : φ 1 = x := by simp [φ]
  have hcx : (c : R) = 0 := by
    have h := hχ ⟨φ 1, LinearMap.mem_range_self φ 1⟩
    rw [Submodule.subtype_apply] at h
    change χ (φ 1) = (LinearMap.ker φ).liftQ ψ hle (φ.quotKerEquivRange.symm ⟨φ 1, _⟩) at h
    rw [LinearMap.quotKerEquivRange_symm_apply_image, Submodule.mkQ_apply, Submodule.liftQ_apply,
      LinearMap.mulRight_apply, one_mul, hx1, hχx] at h
    exact h.symm
  obtain ⟨k, hk⟩ := hker c hcx
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hc
    omega
  have hEk : E * k = 1 := by
    have : c * (E * k) = c * 1 := by linear_combination (-k) * hc - hk
    exact mul_left_cancel₀ hc0 this
  rw [← hx1]
  have h1 : ((1 : ℤ) : R) ∈ LinearMap.ker φ := (hmem 1).2 ⟨k, hEk.symm⟩
  rwa [Int.cast_one, LinearMap.mem_ker] at h1

/-- **`ℤ/n` is self-injective.** -/
theorem injective_self (hn : 0 < n) (h0 : ((n : ℤ) : R) = 0)
    (hsurj : Function.Surjective (Int.castRingHom R)) (hker : ∀ z : ℤ, (z : R) = 0 → (n : ℤ) ∣ z) :
    Module.Injective R R :=
  Module.Baer.injective (baer_self hn h0 hsurj hker)

end ZModLike

/-- `ZMod n` is an injective module over itself. -/
instance ZMod.moduleInjective_self (n : ℕ) [NeZero n] : Module.Injective (ZMod n) (ZMod n) :=
  ZModLike.injective_self (Nat.pos_of_ne_zero (NeZero.ne n)) (by simp) ZMod.intCast_surjective
    fun z hz ↦ (ZMod.intCast_zmod_eq_zero_iff_dvd z n).1 hz

/-- `ULift (ZMod n)` is an injective module over itself. -/
instance ZMod.moduleInjective_ulift_self (n : ℕ) [NeZero n] :
    Module.Injective (ULift.{v} (ZMod n)) (ULift.{v} (ZMod n)) :=
  ZModLike.injective_self (Nat.pos_of_ne_zero (NeZero.ne n)) (ULift.ext (by simp))
    (fun x ↦ ⟨(ZMod.intCast_surjective x.down).choose, ULift.ext (by
      simpa using (ZMod.intCast_surjective x.down).choose_spec)⟩)
    fun z hz ↦ (ZMod.intCast_zmod_eq_zero_iff_dvd z n).1 (by simpa using congrArg ULift.down hz)
