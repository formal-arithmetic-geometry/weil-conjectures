module

public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.Algebra.Exact

/-!
# Extensions of `A ⧸ (f₁, …, fₜ)` by explicit Koszul cycles

Let `f : Fin t → A` and `J = Ideal.span (Set.range f)`. We define the module
`M_f = A^t ⧸ ⟨f i • e j - f j • e i⟩` with its augmentation `μ : M_f → A`, the module of
Koszul `1`-cycles `Z_f(P) = {x : Fin t → P | f i • x j = f j • x i}`, *admissible* cycles (those
whose induced map `M_f → P` kills `ker μ`), and for a tuple `x` the module
`E_f(P, x) = (P × A) ⧸ ⟨(x i, -f i)⟩` with maps `P → E_f(P, x) → A ⧸ J`.

We show that for admissible `x` this is a short exact sequence, that every extension of `A ⧸ J`
by `P` with a chosen lift `e` of `1` is isomorphic to some `E_f(P, x)`, and that changing `x`
by a coboundary gives an isomorphic extension (Stacks, Tags 05ED, 05EE).
-/

@[expose] public section

namespace CyclicExtension

open Submodule

variable {A P E : Type*} [CommRing A] [AddCommGroup P] [Module A P] [AddCommGroup E] [Module A E]
  {t : ℕ} (f : Fin t → A)

/-- The submodule of `A^t` generated by the Koszul relations `f i • e j - f j • e i`. -/
def koszulRelations : Submodule A (Fin t → A) :=
  span A (Set.range fun ij : Fin t × Fin t =>
    f ij.1 • Pi.single ij.2 (1 : A) - f ij.2 • Pi.single ij.1 1)

/-- The module `M_f = A^t ⧸ ⟨f i • e j - f j • e i⟩`. -/
abbrev KoszulQuotient : Type _ := (Fin t → A) ⧸ koszulRelations f

/-- A linear map `A^t → M` sending `e i` to `x i` kills the Koszul relations iff
`f i • x j = f j • x i` for all `i j`. -/
theorem koszulRelations_le_ker_iff {M : Type*} [AddCommGroup M] [Module A M] (x : Fin t → M) :
    koszulRelations f ≤ LinearMap.ker (Fintype.linearCombination A x) ↔
      ∀ i j, f i • x j = f j • x i := by
  classical
  simp [koszulRelations, span_le, Set.range_subset_iff, sub_eq_zero]

/-- The augmentation `μ : M_f →ₗ[A] A`, `ē i ↦ f i`. -/
noncomputable def koszulAug : KoszulQuotient f →ₗ[A] A :=
  (koszulRelations f).liftQ (Fintype.linearCombination A f)
    ((koszulRelations_le_ker_iff f f).mpr fun i j => by simp [smul_eq_mul, mul_comm])

/-- The Koszul `1`-cycles `Z_f(P) = {x | ∀ i j, f i • x j = f j • x i}`. -/
def koszulCycles (P : Type*) [AddCommGroup P] [Module A P] : Submodule A (Fin t → P) where
  carrier := {x | ∀ i j, f i • x j = f j • x i}
  add_mem' hx hy i j := by simp [hx i j, hy i j]
  zero_mem' i j := by simp
  smul_mem' a x hx i j := by simp [smul_comm (f i) a, smul_comm (f j) a, hx i j]

variable {f}

/-- The map `x̂ : M_f →ₗ[A] P`, `ē i ↦ x i`, attached to a Koszul cycle `x`. -/
noncomputable def koszulCycleLift {x : Fin t → P} (hx : x ∈ koszulCycles f P) :
    KoszulQuotient f →ₗ[A] P :=
  (koszulRelations f).liftQ (Fintype.linearCombination A x)
    ((koszulRelations_le_ker_iff f x).mpr hx)

variable (f) in
/-- A tuple `x` is an *admissible* cycle if it is a Koszul cycle and `x̂` kills `ker μ`. -/
def IsAdmissible (x : Fin t → P) : Prop :=
  ∃ hx : x ∈ koszulCycles f P, LinearMap.ker (koszulAug f) ≤ LinearMap.ker (koszulCycleLift hx)

/-- `x` is admissible iff `∑ a i • x i = 0` for every relation `∑ a i * f i = 0`. -/
theorem isAdmissible_iff {x : Fin t → P} :
    IsAdmissible f x ↔ ∀ a : Fin t → A, ∑ i, a i * f i = 0 → ∑ i, a i • x i = 0 := by
  classical
  constructor
  · rintro ⟨hx, h⟩ a ha
    have hmem : Submodule.Quotient.mk (p := koszulRelations f) a ∈
        LinearMap.ker (koszulAug f) := by
      simpa [koszulAug, Fintype.linearCombination_apply] using ha
    simpa [koszulCycleLift, Fintype.linearCombination_apply] using h hmem
  · intro h
    have hx : x ∈ koszulCycles f P := fun i j => by
      have := h (f i • Pi.single j 1 - f j • Pi.single i 1) (by
        simp [sub_mul, Finset.sum_sub_distrib, Pi.single_apply, mul_comm])
      simpa [sub_smul, Finset.sum_sub_distrib, Pi.single_apply, smul_smul, sub_eq_zero,
        mul_comm] using this
    refine ⟨hx, fun m hm => ?_⟩
    induction m using Submodule.Quotient.induction_on with
    | H a =>
      simp only [LinearMap.mem_ker, koszulAug, liftQ_apply,
        Fintype.linearCombination_apply, smul_eq_mul] at hm
      simpa [koszulCycleLift, Fintype.linearCombination_apply] using h a hm

/-- Admissible tuples are Koszul cycles. -/
theorem IsAdmissible.mem_koszulCycles {x : Fin t → P} (hx : IsAdmissible f x) :
    x ∈ koszulCycles f P :=
  hx.1

variable (f) in
/-- The submodule `W_x` of `P × A` generated by the elements `(x i, -f i)`. -/
def extensionRelations (x : Fin t → P) : Submodule A (P × A) :=
  span A (Set.range fun i => (x i, -f i))

variable (f) in
/-- The module `E_f(P, x) = (P × A) ⧸ ⟨(x i, -f i)⟩`. -/
abbrev Extension (x : Fin t → P) : Type _ := (P × A) ⧸ extensionRelations f x

variable (f) in
/-- The map `ι_x : P → E_f(P, x)`, `p ↦ [(p, 0)]`. -/
noncomputable def Extension.inl (x : Fin t → P) : P →ₗ[A] Extension f x :=
  (extensionRelations f x).mkQ ∘ₗ LinearMap.inl A P A

variable (f) in
/-- The map `π_x : E_f(P, x) → A ⧸ J`, `[(p, a)] ↦ a mod J`, where `J = (f₁, …, fₜ)`. -/
noncomputable def Extension.proj (x : Fin t → P) :
    Extension f x →ₗ[A] A ⧸ Ideal.span (Set.range f) :=
  (extensionRelations f x).liftQ ((Ideal.span (Set.range f)).mkQ ∘ₗ LinearMap.snd A P A) (by
    rw [extensionRelations, span_le, Set.range_subset_iff]
    intro i
    simpa using Ideal.subset_span ⟨i, rfl⟩)

@[simp]
theorem Extension.inl_apply (x : Fin t → P) (p : P) :
    Extension.inl f x p = Submodule.Quotient.mk (p, 0) :=
  rfl

@[simp]
theorem Extension.proj_mk (x : Fin t → P) (p : P) (a : A) :
    Extension.proj f x (Submodule.Quotient.mk (p, a)) = Submodule.Quotient.mk a :=
  rfl

theorem mem_extensionRelations_iff {x : Fin t → P} {y : P × A} :
    y ∈ extensionRelations f x ↔ ∃ b : Fin t → A, ∑ i, b i • x i = y.1 ∧ -∑ i, b i * f i = y.2 := by
  rw [extensionRelations, mem_span_range_iff_exists_fun]
  simp [Prod.ext_iff, Prod.fst_sum, Prod.snd_sum, Finset.sum_neg_distrib]

/-- **Part (1).** For admissible `x`, `0 → P → E_f(P, x) → A ⧸ J → 0` is exact. -/
theorem Extension.exact_of_isAdmissible {x : Fin t → P} (hx : IsAdmissible f x) :
    Function.Injective (Extension.inl f x) ∧
      Function.Exact (Extension.inl f x) (Extension.proj f x) ∧
      Function.Surjective (Extension.proj f x) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro p hp
    rw [inl_apply, Submodule.Quotient.mk_eq_zero, mem_extensionRelations_iff] at hp
    obtain ⟨b, hb₁, hb₂⟩ := hp
    rw [← hb₁]
    exact isAdmissible_iff.mp hx b (neg_eq_zero.mp hb₂)
  · intro y
    induction y using Submodule.Quotient.induction_on with
    | H y =>
      obtain ⟨p, a⟩ := y
      rw [proj_mk, Submodule.Quotient.mk_eq_zero, Ideal.mem_span_range_iff_exists_fun]
      constructor
      · rintro ⟨b, hb⟩
        refine ⟨p + ∑ i, b i • x i, ?_⟩
        rw [inl_apply, Submodule.Quotient.eq, mem_extensionRelations_iff]
        exact ⟨b, by simp, by simp [hb]⟩
      · rintro ⟨q, hq⟩
        rw [inl_apply, Submodule.Quotient.eq, mem_extensionRelations_iff] at hq
        obtain ⟨b, -, hb⟩ := hq
        exact ⟨-b, by simpa [Finset.sum_neg_distrib, neg_mul] using hb⟩
  · intro z
    induction z using Submodule.Quotient.induction_on with
    | H a => exact ⟨Submodule.Quotient.mk (0, a), rfl⟩

end CyclicExtension
