/-! # Approximation data with the base colimit
Source: Stacks Tag 00R0, expanded from the non-local version of Tag 00QV.
(blueprint: lem-weil-pbc-limit-finite-presentation-core)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace Algebra

/-- The finite-type models, their pushout squares, and the base colimit.
Source: Stacks Tag 00R0, expanded from the non-local version of Tag 00QV.
Proof: choose a finite polynomial quotient presentation of `S` over `R`. Let `C`
be the integer subalgebra generated by all coefficients of its finitely many
relations. Index by the finitely generated integer subalgebras `T` of `R`
containing `C`. This is a small nonempty directed preorder: it contains `C`,
and adjoining the union of two finite sets of generators gives an upper bound.
Every element `r` of `R` belongs to the subalgebra generated by `C` and `r`.
Thus compatible maps from all these subalgebras define a unique map on `R`:
choose a subalgebra containing an element to define its image; common upper
bounds prove independence and the ring laws. This proves the base colimit.
Define `S_T` as the polynomial quotient over `T` by the same relations.
Inclusions induce maps of quotients; these fix variable classes, hence preserve
identities, composition, and compatibility with the presentation map to `S`.
The variable classes generate `S_T` over `T`; each `T` is finite type over ℤ.
For `T ≤ U`, polynomial scalar extension and the quotient universal property
identify `S_T ⊗[T] U` with `S_U`: maps in both directions fix coefficients and
variable classes, hence are inverse. The tensor-product universal property
makes the transition square a pushout. Taking `U = R` and composing with the
chosen presentation gives the final pushout square at every index. The same
argument permits zero variables, zero relations, and the zero ring.
(blueprint: lem-weil-pbc-limit-finite-presentation-core)
-/
theorem exists_limit_finite_presentation_core
    {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : RingHom.FinitePresentation φ) :
    ∃ (Λ : Type u) (_hpo : Preorder Λ) (_hne : Nonempty Λ)
      (_hdir : IsDirected Λ (fun a b => a ≤ b))
      (Rfun : Λ ⥤ CommRingCat) (Sfun : Λ ⥤ CommRingCat)
      (η : Rfun ⟶ Sfun) (cR : Cocone Rfun) (cS : Cocone Sfun),
      cR.pt = CommRingCat.of R ∧ cS.pt = CommRingCat.of S ∧
      (∀ l (hR : cR.pt = CommRingCat.of R) (hS : cS.pt = CommRingCat.of S),
        η.app l ≫ cS.ι.app l = cR.ι.app l ≫
          (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm)) ∧
      (∀ l, RingHom.FiniteType (η.app l).hom) ∧
      (∀ l, RingHom.FiniteType (algebraMap ℤ (Rfun.obj l))) ∧
      (∀ l m (h : l ≤ m),
        Nonempty (CategoryTheory.IsPushout (η.app l) (Rfun.map (homOfLE h))
          (Sfun.map (homOfLE h)) (η.app m))) ∧
      (∀ l (hR : cR.pt = CommRingCat.of R) (hS : cS.pt = CommRingCat.of S),
        Nonempty (CategoryTheory.IsPushout (η.app l) (cR.ι.app l) (cS.ι.app l)
          (eqToHom hR ≫ CommRingCat.ofHom φ ≫ eqToHom hS.symm))) ∧
      Nonempty (IsColimit cR)
:= by
  sorry

end Algebra
