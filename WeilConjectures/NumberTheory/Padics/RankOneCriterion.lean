module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.NumberTheory.Padics.PadicIntegers
public import Mathlib.RingTheory.Nakayama

/-!
# A criterion for a `ℤ_p`-module to be free of rank one

Let `M` be a finitely generated `ℤ_[p]`-module together with surjections `ρₘ : M → Qₘ` whose
kernel is `pᵐ M` and such that `Qₘ` has `pᵐ` elements for `m > 0`. Then `M ≃ ℤ_[p]`.

## Main statements

* `PadicInt.nonempty_linearEquiv_of_nat_card`: the criterion above.

The proof: since `Q₁` has prime order, it is generated by `ρ₁ x` for any `x` with `ρ₁ x ≠ 0`,
so `M = ℤ_[p] x + p M` and Nakayama gives `M = ℤ_[p] x`. If `c • x = 0` with `c ≠ 0` of valuation
`k`, then `pᵏ M = 0`, so `ρₖ₊₁` and `ρₖ₊₂` are bijective, contradicting `pᵏ⁺¹ ≠ pᵏ⁺²`.
-/

@[expose] public section

namespace PadicInt

/-- A finitely generated `ℤ_[p]`-module `M` with surjections `ρₘ : M → Qₘ` of kernel `pᵐ M` onto
modules with `pᵐ` elements (for `m > 0`) is free of rank one. -/
theorem nonempty_linearEquiv_of_nat_card (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M]
    [Module ℤ_[p] M] [Module.Finite ℤ_[p] M] {Q : ℕ → Type*} [∀ m, AddCommGroup (Q m)]
    [∀ m, Module ℤ_[p] (Q m)] (ρ : ∀ m, M →ₗ[ℤ_[p]] Q m) (hρ : ∀ m, Function.Surjective (ρ m))
    (hker : ∀ m x, ρ m x = 0 → ∃ x', x = (p : ℤ_[p]) ^ m • x')
    (hcard : ∀ m, 0 < m → Nat.card (Q m) = p ^ m) :
    Nonempty (M ≃ₗ[ℤ_[p]] ℤ_[p]) := by
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  have hQ1 : Nat.card (Q 1) = p := by rw [hcard 1 one_pos, pow_one]
  obtain ⟨x, hx⟩ : ∃ x, ρ 1 x ≠ 0 := by
    by_contra! h
    have : Subsingleton (Q 1) := ⟨fun a b ↦ by
      obtain ⟨a, rfl⟩ := hρ 1 a
      obtain ⟨b, rfl⟩ := hρ 1 b
      rw [h, h]⟩
    have := Nat.card_of_subsingleton (0 : Q 1)
    omega
  -- Nakayama: `x` generates `M`
  have hspan : ⊤ ≤ Submodule.span ℤ_[p] {x} := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) fun y _ ↦ ?_
    obtain ⟨n, hn⟩ := (AddSubmonoid.mem_multiples_iff _ _).1
      (mem_multiples_of_prime_card hQ1 hx (g' := ρ 1 y))
    obtain ⟨y', hy'⟩ := hker 1 (y - n • x) (by rw [map_sub, map_nsmul, hn, sub_self])
    refine Submodule.mem_sup.2 ⟨n • x, nsmul_mem (Submodule.mem_span_singleton_self x) n,
      y - n • x, ?_, add_sub_cancel _ _⟩
    rw [hy', pow_one]
    exact Submodule.smul_mem_smul (by simp [maximalIdeal_eq_span_p]) trivial
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton ℤ_[p] M x) := by
    rw [← LinearMap.range_eq_top, LinearMap.range_toSpanSingleton]
    exact eq_top_iff.2 hspan
  have hinj : Function.Injective (LinearMap.toSpanSingleton ℤ_[p] M x) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro c hc
    by_contra hc0
    rw [LinearMap.toSpanSingleton_apply, unitCoeff_spec hc0, mul_comm, ← smul_smul, smul_comm,
      ← Units.smul_def, smul_eq_zero_iff_eq] at hc
    have hkill (z : M) : (p : ℤ_[p]) ^ c.valuation • z = 0 := by
      obtain ⟨a, rfl⟩ := hsurj z
      rw [LinearMap.toSpanSingleton_apply, smul_smul, mul_comm, ← smul_smul, hc, smul_zero]
    have hbij (m : ℕ) (hm : c.valuation ≤ m) : Function.Bijective (ρ m) := by
      refine ⟨(injective_iff_map_eq_zero _).2 fun z hz ↦ ?_, hρ m⟩
      obtain ⟨z', rfl⟩ := hker m z hz
      rw [← Nat.add_sub_cancel' hm, pow_add, mul_comm, ← smul_smul, hkill, smul_zero]
    have h1 := Nat.card_congr (Equiv.ofBijective _ (hbij (c.valuation + 1) (by omega)))
    have h2 := Nat.card_congr (Equiv.ofBijective _ (hbij (c.valuation + 2) (by omega)))
    rw [hcard _ (by omega)] at h1 h2
    have := Nat.pow_right_injective hp1 (h1.symm.trans h2)
    omega
  exact ⟨(LinearEquiv.ofBijective _ ⟨hinj, hsurj⟩).symm⟩

end PadicInt
