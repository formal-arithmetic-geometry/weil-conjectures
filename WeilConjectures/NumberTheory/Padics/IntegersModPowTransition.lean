module

public import Mathlib.RingTheory.Ideal.Quotient.PowTransition
public import WeilConjectures.NumberTheory.Padics.IntegersModPow

/-!
# The transition maps `𝒪_E ⧸ ℓⁿ⁺¹ → 𝒪_E ⧸ ℓⁿ`

The transition map `𝒪_E ⧸ ℓⁿ⁺¹ → 𝒪_E ⧸ ℓⁿ` (`PadicAlgCl.integersModPowTransition`) is surjective
with principal kernel generated by the class of `ℓⁿ`, also after lifting the rings to a higher
universe (`PadicAlgCl.integersModPowULiftTransition`). These are the hypotheses under which the
derived extension of scalars along it is defined
(`AlgebraicGeometry.Etale.derivedExtendScalars`).
-/

@[expose] public section

universe w

namespace PadicAlgCl

variable (l : ℕ) [Fact l.Prime] (E : Type) [Field E] [Algebra E (PadicAlgCl l)] (n : ℕ)

lemma integersModPowTransition_surjective :
    Function.Surjective (integersModPowTransition l E n) :=
  Ideal.Quotient.factor_surjective _

/-- The kernel of `𝒪_E ⧸ ℓⁿ⁺¹ → 𝒪_E ⧸ ℓⁿ` is generated by the class of `ℓⁿ`. -/
lemma ker_integersModPowTransition :
    RingHom.ker (integersModPowTransition l E n) =
      Ideal.span {integersModPowMk l E (n + 1) ((l : integers l E) ^ n)} := by
  rw [integersModPowTransition, Ideal.Quotient.factor_ker, Ideal.map_span, Set.image_singleton]
  rfl

/-- The transition map `𝒪_E ⧸ ℓⁿ⁺¹ → 𝒪_E ⧸ ℓⁿ` between the rings lifted to the universe `w`. -/
noncomputable def integersModPowULiftTransition :
    ULift.{w} (integersModPow l E (n + 1)) →+* ULift.{w} (integersModPow l E n) :=
  ULift.ringEquiv.symm.toRingHom.comp
    ((integersModPowTransition l E n).comp ULift.ringEquiv.toRingHom)

lemma integersModPowULiftTransition_surjective :
    Function.Surjective (integersModPowULiftTransition.{w} l E n) :=
  ULift.ringEquiv.symm.surjective.comp
    ((integersModPowTransition_surjective l E n).comp ULift.ringEquiv.surjective)

/-- The kernel of the lifted transition map `𝒪_E ⧸ ℓⁿ⁺¹ → 𝒪_E ⧸ ℓⁿ` is generated by the class of
`ℓⁿ`. -/
lemma ker_integersModPowULiftTransition :
    RingHom.ker (integersModPowULiftTransition.{w} l E n) =
      Ideal.span {ULift.up (integersModPowMk l E (n + 1) ((l : integers l E) ^ n))} := by
  ext x
  have h : integersModPowTransition l E n x.down = 0 ↔
      integersModPowMk l E (n + 1) ((l : integers l E) ^ n) ∣ x.down := by
    rw [← RingHom.mem_ker, ker_integersModPowTransition, Ideal.mem_span_singleton]
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  refine ⟨fun hx ↦ ?_, fun ⟨c, hc⟩ ↦ ULift.ext (h.2 ⟨c.down, congrArg ULift.down hc⟩)⟩
  obtain ⟨c, hc⟩ := h.1 (congrArg ULift.down hx)
  exact ⟨ULift.up c, ULift.ext hc⟩

end PadicAlgCl
