module

public import WeilConjectures.NumberTheory.Padics.IntegersResidueField

/-!
# The residue field of `𝒪_E ⧸ ℓⁿ`

Let `E` be a subfield of `ℚ̄_ℓ` with ring of integers `𝒪_E`, and `n ≥ 1`. Since `ℓ` lies in the
maximal ideal of `𝒪_E`, the residue map `𝒪_E → 𝔽_E` factors through the reduction
`𝒪_E → 𝒪_E ⧸ ℓⁿ` (`PadicAlgCl.integersModPowToResidueField`). For a generator `ϖ` of the maximal
ideal of `𝒪_E`, its image in `𝒪_E ⧸ ℓⁿ` generates the kernel of `𝒪_E ⧸ ℓⁿ → 𝔽_E`
(`PadicAlgCl.ker_integersModPowToResidueField`) and is nilpotent
(`PadicAlgCl.isNilpotent_integersModPowMk_of_mem_maximalIdeal`).
-/

@[expose] public section

namespace PadicAlgCl

variable (l : ℕ) [Fact l.Prime] (E : Type) [Field E] [Algebra E (PadicAlgCl l)] (n : ℕ)
  [NeZero n]

/-- The residue map `𝒪_E ⧸ ℓⁿ → 𝔽_E` for `n ≥ 1`, induced by the residue map `𝒪_E → 𝔽_E`, which
kills `ℓ`. -/
noncomputable def integersModPowToResidueField :
    integersModPow l E n →+* integersResidueField l E :=
  Ideal.Quotient.lift _ (integersResidue l E) fun a ha ↦ by
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 ha
    rw [map_mul, map_pow, map_natCast, natCast_eq_zero_integersResidueField,
      zero_pow (NeZero.ne n), mul_zero]

/-- The residue map of `𝒪_E ⧸ ℓⁿ` composed with the reduction `𝒪_E → 𝒪_E ⧸ ℓⁿ` is the residue map
of `𝒪_E`. -/
lemma integersModPowToResidueField_comp_integersModPowMk :
    (integersModPowToResidueField l E n).comp (integersModPowMk l E n) = integersResidue l E :=
  RingHom.ext fun _ ↦ rfl


lemma integersModPowToResidueField_integersModPowMk (x : integers l E) :
    integersModPowToResidueField l E n (integersModPowMk l E n x) = integersResidue l E x :=
  rfl

lemma integersModPowToResidueField_surjective :
    Function.Surjective (integersModPowToResidueField l E n) := fun y ↦ by
  obtain ⟨x, rfl⟩ := integersResidue_surjective l E y
  exact ⟨integersModPowMk l E n x, rfl⟩

/-- The kernel of `𝒪_E ⧸ ℓⁿ → 𝔽_E` is generated by the image of a generator `ϖ` of the maximal
ideal of `𝒪_E`. -/
lemma ker_integersModPowToResidueField {ϖ : integers l E}
    (hϖ : IsLocalRing.maximalIdeal (integers l E) = Ideal.span {ϖ}) :
    RingHom.ker (integersModPowToResidueField l E n) =
      Ideal.span {integersModPowMk l E n ϖ} := by
  ext x
  obtain ⟨y, rfl⟩ := integersModPowMk_surjective l E n x
  rw [RingHom.mem_ker, Ideal.mem_span_singleton']
  constructor
  · intro hy
    have hy' : y ∈ Ideal.span {ϖ} := hϖ ▸ (IsLocalRing.residue_eq_zero_iff y).1 hy
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hy'
    exact ⟨integersModPowMk l E n c, (map_mul _ _ _).symm⟩
  · rintro ⟨c, hc⟩
    obtain ⟨c, rfl⟩ := integersModPowMk_surjective l E n c
    have h0 : integersResidue l E ϖ = 0 :=
      (IsLocalRing.residue_eq_zero_iff ϖ).2 (hϖ ▸ Ideal.mem_span_singleton_self ϖ)
    rw [← hc, map_mul, integersModPowToResidueField_integersModPowMk,
      integersModPowToResidueField_integersModPowMk, h0, mul_zero]

omit [NeZero n] in
/-- The image in `𝒪_E ⧸ ℓⁿ` of an element of the maximal ideal of `𝒪_E` is nilpotent: its norm is
`< 1`, so that a power of it has norm `≤ ℓ⁻ⁿ`. -/
lemma isNilpotent_integersModPowMk_of_mem_maximalIdeal {ϖ : integers l E}
    (hϖ : ϖ ∈ IsLocalRing.maximalIdeal (integers l E)) :
    IsNilpotent (integersModPowMk l E n ϖ) := by
  rw [mem_maximalIdeal_integers_iff] at hϖ
  obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (pow_pos (inv_prime_pos l) n) hϖ
  refine ⟨m, ?_⟩
  rw [← map_pow, integersModPowMk_eq_zero_iff]
  have : ((ϖ ^ m : integers l E) : E) = (ϖ : E) ^ m := by simp
  rw [this, map_pow, norm_pow]
  exact hm.le

end PadicAlgCl
