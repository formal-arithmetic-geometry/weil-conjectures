module

public import Mathlib.Order.ConditionallyCompleteLattice.Basic
public import Mathlib.Topology.Constructible

/-!
# Stratifications of topological spaces

Following [Stacks 09XZ], a *stratification* of a topological space `X` is a partition of
`X` into pairwise disjoint locally closed subsets covering `X`. `Topology.Stratification`
additionally requires the partition to be finite and the strata to be constructible subsets
(`Topology.IsConstructible`), the case relevant for constructible sheaves [Stacks 03RW].
-/

@[expose] public section

namespace Topology

/-- A *stratification* of a topological space `X`: a finite partition of `X` into pairwise
disjoint locally closed *constructible* subsets — the *strata* — covering `X`.

This is the notion of [Stacks 09XZ] (a partition into locally closed subsets) with two
additional requirements, neither of which is part of loc. cit.: the partition is finite, and
the strata are constructible (`Topology.IsConstructible`: in the Boolean algebra generated by
the retrocompact open subsets). Both are the requirements made of the strata in the definition
of a constructible sheaf [Stacks 03RW], which asks for finite decompositions into
*constructible* locally closed subschemes. Without constructibility, on a quasi-compact scheme
`X` with a non-quasi-compact open `U`, the extension by zero of the constant sheaf on `U` would
be constructible. Neither condition on the strata implies the other: a constructible subset
need not be locally closed, and on a non-Noetherian space a locally closed subset need not be
constructible (a closed non-open point of the spectrum of an infinite product of fields). On a
Noetherian space every locally closed subset is constructible. -/
@[stacks 09XZ]
structure Stratification (X : Type*) [TopologicalSpace X] where
  /-- The number of strata. -/
  n : ℕ
  /-- The strata. -/
  stratum : Fin n → Set X
  isLocallyClosed_stratum : ∀ i, IsLocallyClosed (stratum i)
  /-- The strata are constructible subsets of `X`. -/
  isConstructible_stratum : ∀ i, IsConstructible (stratum i)
  iUnion_stratum_eq_univ : ⋃ i, stratum i = Set.univ
  pairwise_disjoint_stratum : Pairwise (Function.onFun Disjoint stratum)

end Topology
