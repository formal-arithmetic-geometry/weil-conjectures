module

public import Mathlib.Topology.Sheaves.Abelian
public import Mathlib.Topology.Compactness.Compact
public import WeilConjectures.Topology.AbelianOpenExtensionByZero
import WeilConjectures.Topology.AbelianSheafFiniteGeneratorStages
import WeilConjectures.Topology.AbelianSheafDirectedStalkColimit

/-! # Finite generation exhaustion of abelian sheaves

## References

* Stacks Project, Tag 02UX.
-/

@[expose] public section

universe u
open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
namespace TopCat

/-- Every abelian sheaf is a directed colimit of subsheaves generated by finitely many
sections on quasi-compact opens. -/
theorem abelianSheaf_finiteGeneration_exhaustion
    (X : TopCat.{u})
    (hbas : ∀ (U : Set X), IsOpen U → ∀ x ∈ U, ∃ V : Set X, IsOpen V ∧
      IsCompact V ∧ x ∈ V ∧ V ⊆ U)
    (F : X.Sheaf AddCommGrpCat.{u}) :
    ∃ (I : Type u) (_ : Preorder I) (_ : Nonempty I) (_ : IsDirected I (· ≤ ·))
      (D : I ⥤ X.Sheaf AddCommGrpCat.{u}) (c : D ⟶ (Functor.const I).obj F),
      Nonempty (IsColimit (Cocone.mk F c)) ∧
      ∀ i : I, Mono (c.app i) ∧
      (∃ (n : ℕ) (U : Fin n → Opens X)
        (_ : ∀ i, IsCompact ((U i : Opens X) : Set X)),
        ∃ g : (∐ fun i ↦
          (TopCat.Sheaf.abelianOpenExtensionByZero (U i)).obj
          ((constantSheaf
            (Opens.grothendieckTopology ((Opens.toTopCat X).obj (U i)))
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))) ⟶ (D.obj i), Epi g) := by
  classical
  let S := Σ U : {U : Opens X // IsCompact (U : Set X)}, F.obj.obj (op U.val)
  obtain ⟨D, c, hcover, hstage⟩ := abelianSheaf_finiteGenerator_stages X hbas F
  refine ⟨Finset S, inferInstance, inferInstance, inferInstance, D, c, ?_, hstage⟩
  exact abelianSheaf_directed_stalk_colimit X F (Finset S) D c
    (fun i ↦ (hstage i).1) hcover

end TopCat
