/-!
# Grothendieck vanishing

Let `X` be a noetherian topological space of dimension `n`. Then `H^q(X, F) = 0` for every sheaf
of abelian groups `F` on `X` and every `q > n` [Stacks, Tag 02UZ], [Hartshorne, III.2.7].

We follow Hartshorne's proof, but work on `X` throughout with sheaves supported on closed subsets
`Z` of `X` instead of restricting to `Z`: by induction on `n`, every sheaf supported on a closed
subset of dimension `< n` has vanishing cohomology in degrees `≥ n`.

* Cohomology commutes with filtered colimits on a noetherian space
  (`TopCat.Sheaf.exists_H_map_colimit_ι_eq`), and every sheaf is the filtered colimit of its
  finitely generated subsheaves. This reduces to sheaves generated by finitely many sections,
  and then by induction on the number of generators to quotients of a single `ℤ_U`.
* Writing the support as a finite union of irreducible closed subsets reduces to a quotient `E` of
  `ℤ_U` supported on an irreducible closed subset `T`.
* The sheaf `A_T` of functions which are constant on `T` and vanish off `T` is flasque, and `E`
  is a quotient of its subsheaf `ℤ_{U ∩ T}`. Subsheaves of `A_T` are controlled by Hartshorne's
  minimal-generator argument, the quotients that appear being supported on proper closed subsets
  of `T`, which have smaller dimension.

## Main statements

- `TopCat.Sheaf.subsingleton_H_of_topologicalKrullDim_lt`: Grothendieck vanishing.
-/

@[expose] public section

universe u

open CategoryTheory Limits TopologicalSpace Opposite

namespace TopCat.Sheaf

variable {X : TopCat.{u}}

section Cohomology

variable {F G : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}}

lemma subsingleton_H_of_isZero (hF : IsZero F) (n : ℕ) : Subsingleton (Sheaf.H F n) := by
  refine ⟨fun x y ↦ ?_⟩
  rw [← Sheaf.H.map_id_apply x, ← Sheaf.H.map_id_apply y, hF.eq_of_src (𝟙 F) 0,
    Sheaf.H.map_apply, Sheaf.H.map_apply, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero,
    Abelian.Ext.comp_zero]

variable {S : ShortComplex (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})}
  (hS : S.ShortExact)

include hS

lemma subsingleton_H_X₂ (n : ℕ) [Subsingleton (Sheaf.H S.X₁ n)]
    [Subsingleton (Sheaf.H S.X₃ n)] : Subsingleton (Sheaf.H S.X₂ n) := by
  refine ⟨fun x y ↦ ?_⟩
  have key (z : Sheaf.H S.X₂ n) : z = 0 := by
    obtain ⟨w, hw⟩ := ((Sheaf.H.exact_map_map hS n) z).1 (Subsingleton.elim _ _)
    rw [← hw, Subsingleton.elim w 0, map_zero]
  rw [key x, key y]

lemma subsingleton_H_X₃ (n : ℕ) [Subsingleton (Sheaf.H S.X₂ n)]
    [Subsingleton (Sheaf.H S.X₁ (n + 1))] : Subsingleton (Sheaf.H S.X₃ n) := by
  refine ⟨fun x y ↦ ?_⟩
  have key (z : Sheaf.H S.X₃ n) : z = 0 := by
    obtain ⟨w, hw⟩ := ((Sheaf.H.exact_map_δSucc hS n) z).1 (Subsingleton.elim _ _)
    rw [← hw, Subsingleton.elim w 0, map_zero]
  rw [key x, key y]

lemma subsingleton_H_X₁ (n : ℕ) [Subsingleton (Sheaf.H S.X₃ n)]
    [Subsingleton (Sheaf.H S.X₂ (n + 1))] : Subsingleton (Sheaf.H S.X₁ (n + 1)) := by
  refine ⟨fun x y ↦ ?_⟩
  have key (z : Sheaf.H S.X₁ (n + 1)) : z = 0 := by
    obtain ⟨w, hw⟩ := ((Sheaf.H.exact_δSucc_map hS n) z).1 (Subsingleton.elim _ _)
    rw [← hw, Subsingleton.elim w 0, map_zero]
  rw [key x, key y]

end Cohomology

section Sections

variable {F G : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}}

/-- A morphism of abelian sheaves which is locally surjective on sections is an epimorphism. -/
lemma epi_of_locally (f : F ⟶ G)
    (h : ∀ (V : Opens X) (t : G.obj.obj (op V)) (x : X), x ∈ V → ∃ (W : Opens X) (hWV : W ≤ V)
      (_ : x ∈ W) (s : F.obj.obj (op W)), f.hom.app (op W) s = G.obj.map (homOfLE hWV).op t) :
    Epi f := by
  refine (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (φ := f)).1 ⟨fun {V} t ↦ ?_⟩
  refine (Opens.mem_grothendieckTopology X).2 fun x hx ↦ ?_
  obtain ⟨W, hWV, hxW, s, hs⟩ := h V t x hx
  exact ⟨W, homOfLE hWV, ⟨s, hs⟩, hxW⟩

/-- A morphism of abelian sheaves is zero as soon as it vanishes on all sections. -/
lemma hom_eq_zero_of_forall (f : F ⟶ G) (h : ∀ (V : Opens X) (s : F.obj.obj (op V)),
    f.hom.app (op V) s = 0) : f = 0 := by
  refine CategoryTheory.Sheaf.hom_ext ?_
  ext V s
  exact (h _ s).trans (by simp)

/-- The cokernel of a morphism `f : F ⟶ G` is supported on `Z` as soon as every section of `G`
over an open disjoint from `Z` lies in the image of `f`. -/
lemma isSupportedOn_cokernel (f : F ⟶ G) {Z : Set X}
    (h : ∀ (V : Opens X), Disjoint (V : Set X) Z → ∀ t : G.obj.obj (op V),
      ∃ s : F.obj.obj (op V), f.hom.app (op V) s = t) :
    IsSupportedOn (cokernel f) Z := by
  intro V hV t
  refine eq_zero_of_locally _ t fun x hx ↦ ?_
  obtain ⟨W, hWV, hxW, s, hs⟩ := exists_map_eq_of_epi (cokernel.π f) t hx
  refine ⟨W, hWV, hxW, ?_⟩
  obtain ⟨r, rfl⟩ := h W (hV.mono_left hWV) s
  rw [← hs]
  have : (f ≫ cokernel.π f).hom.app (op W) r = 0 := by
    rw [cokernel.condition]
    rfl
  exact this

end Sections

section ConstOn

variable {T : Set X}

/-- The functions `f` on an open `V` with values in `dℤ` which vanish off `T`, are constant on
`V ∩ T`, and vanish on `T` outside `W`. -/
def constOnSubgroup (W : Opens X) (d : ℤ) (V : Opens X) : AddSubgroup (V → ℤ) where
  carrier := {f | (∀ x : V, x.1 ∉ T → f x = 0) ∧ (∀ x, d ∣ f x) ∧
    (∀ x : V, x.1 ∈ T → f x ≠ 0 → x.1 ∈ W) ∧ ∀ x y : V, x.1 ∈ T → y.1 ∈ T → f x = f y}
  zero_mem' := ⟨fun _ _ ↦ rfl, fun _ ↦ dvd_zero _, fun _ _ h ↦ (h rfl).elim, fun _ _ _ _ ↦ rfl⟩
  add_mem' {f g} hf hg := by
    refine ⟨fun x hx ↦ ?_, fun x ↦ dvd_add (hf.2.1 x) (hg.2.1 x), fun x hx h ↦ ?_,
      fun x y hx hy ↦ ?_⟩
    · simp [hf.1 x hx, hg.1 x hx]
    · by_cases h' : f x = 0
      · refine hg.2.2.1 x hx fun h'' ↦ h ?_
        simp [h', h'']
      · exact hf.2.2.1 x hx h'
    · simp [hf.2.2.2 x y hx hy, hg.2.2.2 x y hx hy]
  neg_mem' {f} hf := by
    refine ⟨fun x hx ↦ ?_, fun x ↦ (dvd_neg).2 (hf.2.1 x), fun x hx h ↦ hf.2.2.1 x hx ?_,
      fun x y hx hy ↦ ?_⟩
    · simp [hf.1 x hx]
    · simpa using h
    · simp [hf.2.2.2 x y hx hy]

/-- The data of the sheaf `TopCat.Sheaf.constOn`. -/
def constOnData (hT : IsIrreducible T) (W : Opens X) (d : ℤ) :
    SubgroupOfFunctions (fun _ : X ↦ ℤ) where
  subgroup := constOnSubgroup (T := T) W d
  restrict_mem {U V} h f hf := ⟨fun x hx ↦ hf.1 _ hx, fun x ↦ hf.2.1 _,
    fun x hx h' ↦ hf.2.2.1 _ hx h', fun x y hx hy ↦ hf.2.2.2 _ _ hx hy⟩
  mem_of_forall {ι} U f hf := by
    refine ⟨fun x hx ↦ ?_, fun x ↦ ?_, fun x hx h' ↦ ?_, fun x y hx hy ↦ ?_⟩
    · obtain ⟨i, hi⟩ := Opens.mem_iSup.1 x.2
      exact (hf i).1 ⟨x.1, hi⟩ hx
    · obtain ⟨i, hi⟩ := Opens.mem_iSup.1 x.2
      exact (hf i).2.1 ⟨x.1, hi⟩
    · obtain ⟨i, hi⟩ := Opens.mem_iSup.1 x.2
      exact (hf i).2.2.1 ⟨x.1, hi⟩ hx h'
    · obtain ⟨i, hi⟩ := Opens.mem_iSup.1 x.2
      obtain ⟨j, hj⟩ := Opens.mem_iSup.1 y.2
      obtain ⟨z, hzT, hzi, hzj⟩ := hT.2 _ _ (U i).isOpen (U j).isOpen ⟨x.1, hx, hi⟩
        ⟨y.1, hy, hj⟩
      have h₁ := (hf i).2.2.2 ⟨x.1, hi⟩ ⟨z, hzi⟩ hx hzT
      have h₂ := (hf j).2.2.2 ⟨z, hzj⟩ ⟨y.1, hj⟩ hzT hy
      exact h₁.trans h₂

/-- The sheaf of functions with values in `dℤ` which vanish off the irreducible set `T`, are
constant on `T`, and vanish on `T` outside the open `W`. For `W = ⊤` and `d = 1` this is the
constant sheaf `ℤ` on `T`, extended by zero; in general it is the subsheaf `d · ℤ_{W ∩ T}`. -/
noncomputable def constOn (hT : IsIrreducible T) (W : Opens X) (d : ℤ) :
    CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} :=
  (constOnData hT W d).sheaf

variable {hT : IsIrreducible T}

/-- The underlying function of a section of `TopCat.Sheaf.constOn`. -/
def constOn.toFun {W : Opens X} {d : ℤ} {V : Opens X} (s : (constOn hT W d).obj.obj (op V)) :
    V → ℤ :=
  (show constOnSubgroup (T := T) W d V from s).1

lemma constOn.mem {W : Opens X} {d : ℤ} {V : Opens X} (s : (constOn hT W d).obj.obj (op V)) :
    constOn.toFun s ∈ constOnSubgroup (T := T) W d V :=
  (show constOnSubgroup (T := T) W d V from s).2

/-- A section of `TopCat.Sheaf.constOn` from its underlying function. -/
def constOn.mk {W : Opens X} {d : ℤ} {V : Opens X} (f : V → ℤ)
    (hf : f ∈ constOnSubgroup (T := T) W d V) : (constOn hT W d).obj.obj (op V) :=
  (⟨f, hf⟩ : constOnSubgroup (T := T) W d V)

@[simp]
lemma constOn.toFun_mk {W : Opens X} {d : ℤ} {V : Opens X} (f : V → ℤ)
    (hf : f ∈ constOnSubgroup (T := T) W d V) : constOn.toFun (constOn.mk (hT := hT) f hf) = f :=
  rfl

@[ext]
lemma constOn.ext {W : Opens X} {d : ℤ} {V : Opens X} {s t : (constOn hT W d).obj.obj (op V)}
    (h : ∀ x, constOn.toFun s x = constOn.toFun t x) : s = t :=
  Subtype.ext (funext h)

@[simp]
lemma constOn.toFun_map {W : Opens X} {d : ℤ} {U V : Opens X} (i : V ⟶ U)
    (s : (constOn hT W d).obj.obj (op U)) (x : V) :
    constOn.toFun ((constOn hT W d).obj.map i.op s) x = constOn.toFun s ⟨x.1, i.le x.2⟩ :=
  rfl

@[simp]
lemma constOn.toFun_add {W : Opens X} {d : ℤ} {V : Opens X}
    (s t : (constOn hT W d).obj.obj (op V)) (x : V) :
    constOn.toFun (s + t) x = constOn.toFun s x + constOn.toFun t x :=
  rfl

@[simp]
lemma constOn.toFun_zsmul {W : Opens X} {d : ℤ} {V : Opens X} (n : ℤ)
    (s : (constOn hT W d).obj.obj (op V)) (x : V) :
    constOn.toFun (n • s) x = n * constOn.toFun s x :=
  rfl

@[simp]
lemma constOn.toFun_zero {W : Opens X} {d : ℤ} {V : Opens X} (x : V) :
    constOn.toFun (0 : (constOn hT W d).obj.obj (op V)) x = 0 :=
  rfl

/-- The inclusion `constOn T W d ⟶ constOn T W' d'` for `W ≤ W'` and `d' ∣ d`. -/
noncomputable def constOnIncl {W W' : Opens X} {d d' : ℤ} (hW : W ≤ W') (hd : d' ∣ d) :
    constOn hT W d ⟶ constOn hT W' d' :=
  ObjectProperty.homMk
    { app V := AddCommGrpCat.ofHom (AddSubgroup.inclusion (H := constOnSubgroup W d V.unop)
        (K := constOnSubgroup W' d' V.unop) fun _ hf ↦ ⟨hf.1, fun x ↦ hd.trans (hf.2.1 x),
          fun x hx h ↦ hW (hf.2.2.1 x hx h), hf.2.2.2⟩)
      naturality _ _ _ := rfl }

@[simp]
lemma constOnIncl_toFun {W W' : Opens X} {d d' : ℤ} (hW : W ≤ W') (hd : d' ∣ d) {V : Opens X}
    (s : (constOn hT W d).obj.obj (op V)) (x : V) :
    constOn.toFun ((constOnIncl (hT := hT) hW hd).hom.app (op V) s) x = constOn.toFun s x :=
  rfl

instance {W W' : Opens X} {d d' : ℤ} (hW : W ≤ W') (hd : d' ∣ d) :
    Mono (constOnIncl (hT := hT) hW hd) :=
  mono_of_injective_app _ fun U s t h ↦ by
    have := congrArg (fun r ↦ constOn.toFun (V := U.unop) r) h
    exact constOn.ext fun x ↦ congrFun this x

/-- The section of `TopCat.Sheaf.constOn` over `W` with value `d` on `T`. -/
noncomputable def constOnGen (h : IsIrreducible T) (W : Opens X) (d : ℤ) :
    (constOn h W d).obj.obj (op W) := by
  classical
  exact constOn.mk (fun x ↦ if x.1 ∈ T then d else 0)
    ⟨fun x hx ↦ if_neg hx, fun x ↦ by dsimp only; split_ifs <;> simp, fun x _ _ ↦ x.2,
      fun x y hx hy ↦ by dsimp only; rw [if_pos hx, if_pos hy]⟩

lemma constOnGen_toFun (W : Opens X) (d : ℤ) (x : W) (hx : x.1 ∈ T) :
    constOn.toFun (constOnGen hT W d) x = d := by
  classical
  exact if_pos hx

lemma constOn.toFun_eq_zero {W : Opens X} {d : ℤ} {V : Opens X}
    (s : (constOn hT W d).obj.obj (op V)) (x : V) (hx : x.1 ∉ T) : constOn.toFun s x = 0 :=
  (constOn.mem s).1 x hx

lemma constOn.toFun_eq {W : Opens X} {d : ℤ} {V : Opens X}
    (s : (constOn hT W d).obj.obj (op V)) (x y : V) (hx : x.1 ∈ T) (hy : y.1 ∈ T) :
    constOn.toFun s x = constOn.toFun s y :=
  (constOn.mem s).2.2.2 x y hx hy

lemma constOn.dvd_toFun {W : Opens X} {d : ℤ} {V : Opens X}
    (s : (constOn hT W d).obj.obj (op V)) (x : V) : d ∣ constOn.toFun s x :=
  (constOn.mem s).2.1 x

lemma constOn.mem_of_toFun_ne_zero {W : Opens X} {d : ℤ} {V : Opens X}
    (s : (constOn hT W d).obj.obj (op V)) (x : V) (hx : x.1 ∈ T) (h : constOn.toFun s x ≠ 0) :
    x.1 ∈ W :=
  (constOn.mem s).2.2.1 x hx h

/-- A section of `TopCat.Sheaf.constOn` which vanishes at one point of `T` vanishes. -/
lemma constOn.eq_zero_of_toFun_eq_zero {W : Opens X} {d : ℤ} {V : Opens X}
    (s : (constOn hT W d).obj.obj (op V)) (x : V) (hx : x.1 ∈ T) (h : constOn.toFun s x = 0) :
    s = 0 := by
  refine constOn.ext fun y ↦ ?_
  by_cases hy : y.1 ∈ T
  · rw [constOn.toFun_eq s y x hy hx, h, constOn.toFun_zero]
  · rw [constOn.toFun_eq_zero s y hy, constOn.toFun_zero]

lemma isSupportedOn_constOn (W : Opens X) (d : ℤ) : IsSupportedOn (constOn hT W d) T :=
  fun _ hV s ↦ constOn.ext fun x ↦ constOn.toFun_eq_zero s x
    (Set.disjoint_left.1 hV x.2)

instance isFlasque_constOn (d : ℤ) : Presheaf.IsFlasque (constOn hT ⊤ d).obj where
  epi {U V} i := by
    classical
    rw [AddCommGrpCat.epi_iff_surjective]
    intro s
    by_cases h : ∃ x : V.unop, x.1 ∈ T
    · obtain ⟨x, hx⟩ := h
      let c := constOn.toFun s x
      refine ⟨constOn.mk (fun y ↦ if y.1 ∈ T then c else 0)
        ⟨fun y hy ↦ if_neg hy, fun y ↦ ?_, fun y _ _ ↦ by simp, fun y z hy hz ↦ ?_⟩, ?_⟩
      · dsimp only
        split_ifs
        · exact constOn.dvd_toFun s x
        · exact dvd_zero _
      · dsimp only
        rw [if_pos hy, if_pos hz]
      · refine constOn.ext fun y ↦ ?_
        change (if y.1 ∈ T then c else 0) = _
        split_ifs with hy
        · exact constOn.toFun_eq s x y hx hy
        · exact (constOn.toFun_eq_zero s y hy).symm
    · refine ⟨0, ?_⟩
      rw [map_zero]
      refine constOn.ext fun y ↦ ?_
      rw [constOn.toFun_zero, constOn.toFun_eq_zero s y fun hy ↦ h ⟨y, hy⟩]

/-- The morphism `ℤ_W ⟶ constOn T W d` given by the generator `TopCat.Sheaf.constOnGen`. -/
noncomputable def constOnπ (h : IsIrreducible T) (W : Opens X) (d : ℤ) :
    freeYoneda.obj W ⟶ constOn h W d :=
  (freeYonedaHomEquiv _ W).symm (constOnGen h W d)

lemma constOnπ_freeYonedaGen (W : Opens X) (d : ℤ) :
    (constOnπ hT W d).hom.app (op W) (freeYonedaGen W) = constOnGen hT W d := by
  rw [← freeYonedaHomEquiv_apply, constOnπ, Equiv.apply_symm_apply]

lemma constOnπ_map_freeYonedaGen {W V : Opens X} (h : V ≤ W) (d : ℤ) :
    (constOnπ hT W d).hom.app (op V) ((freeYoneda.obj W).obj.map (homOfLE h).op
      (freeYonedaGen W)) = (constOn hT W d).obj.map (homOfLE h).op (constOnGen hT W d) := by
  rw [NatTrans.naturality_apply, constOnπ_freeYonedaGen]

/-- `ℤ_W ⟶ constOn T W d` is an epimorphism when `T` is closed. -/
lemma epi_constOnπ (hTc : IsClosed T) (W : Opens X) (d : ℤ) : Epi (constOnπ hT W d) := by
  classical
  refine epi_of_locally _ fun V t x hx ↦ ?_
  by_cases hxT : x ∈ T
  · by_cases hc : constOn.toFun t ⟨x, hx⟩ = 0
    · refine ⟨V, le_rfl, hx, 0, ?_⟩
      rw [map_zero, constOn.eq_zero_of_toFun_eq_zero t ⟨x, hx⟩ hxT hc, map_zero]
    · have hxW : x ∈ W := constOn.mem_of_toFun_ne_zero t ⟨x, hx⟩ hxT hc
      obtain ⟨m, hm⟩ := constOn.dvd_toFun t ⟨x, hx⟩
      refine ⟨V ⊓ W, inf_le_left, ⟨hx, hxW⟩, m • (freeYoneda.obj W).obj.map
        (homOfLE inf_le_right).op (freeYonedaGen W), ?_⟩
      rw [map_zsmul, constOnπ_map_freeYonedaGen]
      refine constOn.ext fun y ↦ ?_
      rw [constOn.toFun_zsmul, constOn.toFun_map, constOn.toFun_map]
      by_cases hyT : y.1 ∈ T
      · rw [constOnGen_toFun W d ⟨y.1, y.2.2⟩ hyT, constOn.toFun_eq t ⟨y.1, y.2.1⟩ ⟨x, hx⟩ hyT hxT,
          hm, mul_comm]
      · rw [constOn.toFun_eq_zero _ ⟨y.1, y.2.2⟩ hyT, constOn.toFun_eq_zero _ ⟨y.1, y.2.1⟩ hyT,
          mul_zero]
  · refine ⟨V ⊓ ⟨Tᶜ, hTc.isOpen_compl⟩, inf_le_left, ⟨hx, hxT⟩, 0, ?_⟩
    rw [map_zero]
    refine constOn.ext fun y ↦ ?_
    rw [constOn.toFun_zero, constOn.toFun_map, constOn.toFun_eq_zero _ ⟨y.1, y.2.1⟩ y.2.2]

end ConstOn

variable (X) in
/-- The statement of Grothendieck vanishing in dimension `n`: every abelian sheaf supported on a
closed subset of dimension less than `n` has vanishing cohomology in degrees at least `n`. -/
def VanishingBelow (n : ℕ) : Prop :=
  ∀ (Z : Set X), IsClosed Z → topologicalKrullDim Z < n →
    ∀ (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}),
      IsSupportedOn F Z → ∀ i : ℕ, n ≤ i → Subsingleton (Sheaf.H F i)

section Irreducible

variable {n : ℕ} (ih : VanishingBelow X n) {T : Set X} (hT : IsIrreducible T)
  (hTc : IsClosed T) (hdim : topologicalKrullDim T ≤ n)

include ih hT hTc hdim

omit ih in
/-- Removing an open meeting the irreducible closed set `T` from `T` lowers the dimension. -/
lemma topologicalKrullDim_inter_compl_lt {W : Opens X} (hW : ((W : Set X) ∩ T).Nonempty) :
    topologicalKrullDim (T ∩ (W : Set X)ᶜ : Set X) < n := by
  refine topologicalKrullDim_lt_of_ssubset hT (hTc.inter W.isOpen.isClosed_compl)
    Set.inter_subset_left (fun he ↦ ?_) hdim
  obtain ⟨x, hxW, hxT⟩ := hW
  have : x ∈ T ∩ (W : Set X)ᶜ := by rw [he]; exact hxT
  exact this.2 hxW

/-- `H^i(constOn T W d) = 0` for `i > n` when `W` meets `T`: `constOn T W d` is the kernel of the
flasque sheaf `constOn T ⊤ d` onto a sheaf supported on `T ∖ W`. -/
lemma subsingleton_H_constOn {W : Opens X} (hW : ((W : Set X) ∩ T).Nonempty) (d : ℤ) (i : ℕ)
    (hi : n < i) : Subsingleton (Sheaf.H (constOn hT W d) i) := by
  obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
  let f := constOnIncl (hT := hT) (le_top : W ≤ ⊤) (dvd_refl d)
  let S := ShortComplex.mk f (cokernel.π f) (cokernel.condition f)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  have hsupp : IsSupportedOn S.X₃ (T ∩ (W : Set X)ᶜ) := by
    refine isSupportedOn_cokernel f fun V hV t ↦ ⟨constOn.mk (constOn.toFun t)
      ⟨(constOn.mem t).1, (constOn.mem t).2.1, fun x hx h ↦ ?_, (constOn.mem t).2.2.2⟩, rfl⟩
    by_contra hxW
    exact Set.disjoint_left.1 hV x.2 ⟨hx, hxW⟩
  have : Subsingleton (Sheaf.H S.X₃ j) :=
    ih _ (hTc.inter W.isOpen.isClosed_compl)
      (topologicalKrullDim_inter_compl_lt hT hTc hdim hW) _ hsupp j (by omega)
  have : Subsingleton (Sheaf.H S.X₂ (j + 1)) :=
    IsFlasque.subsingleton_H (X := X) (constOn hT ⊤ d) j
  exact subsingleton_H_X₁ hS j

omit ih hTc hdim in
/-- The value at a point of `T` of the image of a combination of restricted sections. -/
lemma toFun_app_map_add {K : CategoryTheory.Sheaf (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}} {W' : Opens X} {d' : ℤ} (m : K ⟶ constOn hT W' d') {V₁ V₂ V : Opens X}
    (h₁ : V ≤ V₁) (h₂ : V ≤ V₂) (k₁ : K.obj.obj (op V₁)) (k₂ : K.obj.obj (op V₂)) (a b : ℤ)
    (x : V) :
    constOn.toFun (m.hom.app (op V) (a • K.obj.map (homOfLE h₁).op k₁ +
      b • K.obj.map (homOfLE h₂).op k₂)) x =
      a * constOn.toFun (m.hom.app (op V₁) k₁) ⟨x.1, h₁ x.2⟩ +
        b * constOn.toFun (m.hom.app (op V₂) k₂) ⟨x.1, h₂ x.2⟩ := by
  rw [map_add, map_zsmul, map_zsmul, NatTrans.naturality_apply, NatTrans.naturality_apply]
  rfl

/-- **Subsheaves of the constant sheaf on `T`** (Hartshorne's minimal-generator argument). Every
subsheaf `K` of `constOn T ⊤ 1` has `H^i(K) = 0` for `i > n`: if `d` is the least positive value
of a section of `K` and `W₀` an open where it is attained, then `K` contains `constOn T W₀ d`,
and the quotient is supported on `T ∖ W₀`. -/
lemma subsingleton_H_of_mono {K : CategoryTheory.Sheaf (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}} (m : K ⟶ constOn hT ⊤ 1) [Mono m] (i : ℕ) (hi : n < i) :
    Subsingleton (Sheaf.H K i) := by
  classical
  by_cases hK : ∀ (V : Opens X) (k : K.obj.obj (op V)), k = 0
  · exact subsingleton_H_of_isZero (isZero_of_forall_eq_zero K hK) i
  simp only [not_forall] at hK
  obtain ⟨V, k, hk⟩ := hK
  have hmk : m.hom.app (op V) k ≠ 0 := fun h ↦
    hk (injective_app_of_mono m (op V) (h.trans (map_zero _).symm))
  obtain ⟨x, hx⟩ : ∃ x, constOn.toFun (m.hom.app (op V) k) x ≠ 0 := by
    by_contra! h
    exact hmk (constOn.ext fun x ↦ h x)
  have hxT : x.1 ∈ T := by
    by_contra h
    exact hx (constOn.toFun_eq_zero _ x h)
  -- the least positive value `d` of a section of `K`
  let P : ℕ → Prop := fun d ↦ 0 < d ∧ ∃ (V : Opens X) (k : K.obj.obj (op V)) (x : V),
    x.1 ∈ T ∧ constOn.toFun (m.hom.app (op V) k) x = d
  have hP : ∃ d, P d := by
    rcases Int.natAbs_eq (constOn.toFun (m.hom.app (op V) k) x) with h | h
    · exact ⟨_, Int.natAbs_pos.2 hx, V, k, x, hxT, h⟩
    · refine ⟨_, Int.natAbs_pos.2 hx, V, -k, x, hxT, ?_⟩
      rw [map_neg]
      change -constOn.toFun (m.hom.app (op V) k) x = _
      omega
  obtain ⟨hd, W₀, k₀, x₀, hx₀T, hk₀⟩ := Nat.find_spec hP
  set d := Nat.find hP with hd_def
  -- every value of a section of `K` is divisible by `d`
  have hdvd (V : Opens X) (k : K.obj.obj (op V)) (y : V) (hy : y.1 ∈ T) :
      (d : ℤ) ∣ constOn.toFun (m.hom.app (op V) k) y := by
    obtain ⟨z, hzT, hzV, hzW⟩ := hT.2 _ _ V.isOpen W₀.isOpen ⟨y.1, hy, y.2⟩ ⟨x₀.1, hx₀T, x₀.2⟩
    set c := constOn.toFun (m.hom.app (op V) k) y
    let e := Int.gcdA c d • K.obj.map (homOfLE (inf_le_left : V ⊓ W₀ ≤ V)).op k +
      Int.gcdB c d • K.obj.map (homOfLE (inf_le_right : V ⊓ W₀ ≤ W₀)).op k₀
    have he : constOn.toFun (m.hom.app (op (V ⊓ W₀)) e) ⟨z, hzV, hzW⟩ = Int.gcd c d := by
      rw [toFun_app_map_add, Int.gcd_eq_gcd_ab, constOn.toFun_eq _ _ y hzT hy,
        constOn.toFun_eq _ _ x₀ hzT hx₀T, hk₀]
      ring
    have hgpos : 0 < Int.gcd c d := Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast hd.ne')
    have hle : d ≤ Int.gcd c d := Nat.find_min' hP ⟨hgpos, _, e, ⟨z, hzV, hzW⟩, hzT, he⟩
    have hge : Int.gcd c d ≤ d :=
      Nat.le_of_dvd hd (Int.natCast_dvd_natCast.1 (Int.gcd_dvd_right c d))
    have h := Int.gcd_dvd_left c (d : ℤ)
    rwa [le_antisymm hge hle] at h
  -- the subsheaf `constOn T W₀ d` of `K`, generated by `k₀`
  have hW₀ : ((W₀ : Set X) ∩ T).Nonempty := ⟨x₀.1, x₀.2, hx₀T⟩
  let e₀ := constOnπ hT W₀ (d : ℤ)
  have : Epi e₀ := epi_constOnπ hTc W₀ d
  let f₀ : freeYoneda.obj W₀ ⟶ K := (freeYonedaHomEquiv K W₀).symm k₀
  let ι₀ := constOnIncl (hT := hT) (le_top : W₀ ≤ ⊤) (one_dvd (d : ℤ))
  have hf₀ : f₀ ≫ m = e₀ ≫ ι₀ := by
    apply (freeYonedaHomEquiv _ W₀).injective
    rw [freeYonedaHomEquiv_comp, freeYonedaHomEquiv_comp, Equiv.apply_symm_apply]
    change _ = ι₀.hom.app (op W₀) ((freeYonedaHomEquiv _ W₀)
      ((freeYonedaHomEquiv _ W₀).symm (constOnGen hT W₀ d)))
    rw [Equiv.apply_symm_apply]
    refine constOn.ext fun y ↦ ?_
    rw [constOnIncl_toFun]
    by_cases hy : y.1 ∈ T
    · rw [constOnGen_toFun _ _ _ hy, constOn.toFun_eq _ y x₀ hy hx₀T, hk₀]
    · rw [constOn.toFun_eq_zero _ y hy, constOn.toFun_eq_zero _ y hy]
  have hker : kernel.ι e₀ ≫ f₀ = 0 := by
    rw [← cancel_mono m, Category.assoc, hf₀, kernel.condition_assoc, zero_comp, zero_comp]
  let j := Abelian.epiDesc e₀ f₀ hker
  have hj : j ≫ m = ι₀ := by
    rw [← cancel_epi e₀, ← Category.assoc, Abelian.comp_epiDesc, hf₀]
  have : Mono j := mono_of_mono_fac hj
  let S := ShortComplex.mk j (cokernel.π j) (cokernel.condition j)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  have hsupp : IsSupportedOn S.X₃ (T ∩ (W₀ : Set X)ᶜ) := by
    refine isSupportedOn_cokernel j fun V hV κ ↦ ?_
    let s : (constOn hT W₀ d).obj.obj (op V) := constOn.mk
      (constOn.toFun (m.hom.app (op V) κ)) ⟨(constOn.mem _).1, fun y ↦ by
        by_cases hy : y.1 ∈ T
        · exact hdvd V κ y hy
        · rw [constOn.toFun_eq_zero _ y hy]
          exact dvd_zero _, fun y hy _ ↦ by
        by_contra hyW
        exact Set.disjoint_left.1 hV y.2 ⟨hy, hyW⟩, (constOn.mem _).2.2.2⟩
    refine ⟨s, injective_app_of_mono m (op V) ?_⟩
    exact (congrArg (fun φ : (constOn hT W₀ d ⟶ constOn hT ⊤ 1) ↦ φ.hom.app (op V) s)
      hj).trans (constOn.ext fun y ↦ rfl)
  have : Subsingleton (Sheaf.H S.X₁ i) := subsingleton_H_constOn ih hT hTc hdim hW₀ d i hi
  have : Subsingleton (Sheaf.H S.X₃ i) :=
    ih _ (hTc.inter W₀.isOpen.isClosed_compl)
      (topologicalKrullDim_inter_compl_lt hT hTc hdim hW₀) _ hsupp i hi.le
  exact subsingleton_H_X₂ hS i

/-- **Quotients of `ℤ_U` supported on `T`.** If `E` is supported on the irreducible closed set `T`
and is a quotient of `ℤ_U`, then `H^i(E) = 0` for `i > n`: `E` is a quotient of `constOn T U 1`
by a subsheaf of `constOn T ⊤ 1`. -/
lemma subsingleton_H_of_epi_freeYoneda {E : CategoryTheory.Sheaf (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}} (hE : IsSupportedOn E T) {U : Opens X} (π : freeYoneda.obj U ⟶ E)
    [Epi π] (i : ℕ) (hi : n < i) : Subsingleton (Sheaf.H E i) := by
  by_cases hUT : ((U : Set X) ∩ T).Nonempty
  · let e := constOnπ hT U 1
    have : Epi e := epi_constOnπ hTc U 1
    have hker : kernel.ι e ≫ π = 0 := by
      refine hom_eq_zero_of_forall _ fun V σ ↦ ?_
      let τ := (kernel.ι e).hom.app (op V) σ
      have hτ : e.hom.app (op V) τ = 0 := by
        change (kernel.ι e ≫ e).hom.app (op V) σ = 0
        rw [kernel.condition]
        rfl
      change π.hom.app (op V) τ = 0
      refine eq_zero_of_locally E _ fun x hx ↦ ?_
      obtain ⟨W, hWV, hxW, hW⟩ := exists_freeYoneda_eq U τ hx
      refine ⟨W, hWV, hxW, ?_⟩
      rw [← NatTrans.naturality_apply]
      rcases hW with ⟨hWU, c, hc⟩ | hc
      · by_cases hWT : ((W : Set X) ∩ T).Nonempty
        · obtain ⟨y, hyW, hyT⟩ := hWT
          have h := congrArg (fun r ↦ constOn.toFun (V := W) r ⟨y, hyW⟩)
            ((NatTrans.naturality_apply e.hom (homOfLE hWV).op τ).trans
              (by rw [hτ, map_zero]))
          change π.hom.app _ ((freeYoneda.obj U).obj.map (homOfLE hWV).op τ) = 0
          rw [hc, map_zsmul, constOnπ_map_freeYonedaGen, constOn.toFun_zsmul,
            constOn.toFun_map, constOnGen_toFun _ _ _ hyT, mul_one, constOn.toFun_zero] at h
          rw [hc, h, zero_smul, map_zero]
        · refine hE W (Set.disjoint_left.2 fun y hyW hyT ↦ hWT ⟨y, hyW, hyT⟩) _
      · change π.hom.app _ ((freeYoneda.obj U).obj.map (homOfLE hWV).op τ) = 0
        rw [hc, map_zero]
    let p := Abelian.epiDesc e π hker
    have hp : e ≫ p = π := Abelian.comp_epiDesc e π hker
    have : Epi p := epi_of_epi_fac hp
    let S := ShortComplex.mk (kernel.ι p) p (kernel.condition p)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel p) inferInstance inferInstance
    have : Subsingleton (Sheaf.H S.X₂ i) := subsingleton_H_constOn ih hT hTc hdim hUT 1 i hi
    have : Subsingleton (Sheaf.H S.X₁ (i + 1)) :=
      subsingleton_H_of_mono ih hT hTc hdim
        (kernel.ι p ≫ constOnIncl (le_top : U ≤ ⊤) (dvd_refl 1)) (i + 1) (by omega)
    exact subsingleton_H_X₃ hS i
  · have hπ : π = 0 := by
      apply (freeYonedaHomEquiv E U).injective
      rw [hE U (Set.disjoint_left.2 fun y hyU hyT ↦ hUT ⟨y, hyU, hyT⟩)
        (freeYonedaHomEquiv E U π), freeYonedaHomEquiv_apply]
      simp
    exact subsingleton_H_of_isZero (IsZero.of_epi_eq_zero π hπ) i

end Irreducible

section Reducible

variable {n : ℕ} (ih : VanishingBelow X n)

include ih

/-- **Quotients of `ℤ_U` supported on a finite union of irreducible closed sets.** If `E` is
supported on a finite union of irreducible closed sets of dimension at most `n` and is a quotient
of `ℤ_U`, then `H^i(E) = 0` for `i > n`. Removing the other components from `U`, the image of
`ℤ_{U ∖ Z'}` in `E` is supported on one component `T`, and the quotient by it is supported on the
union `Z'` of the others. -/
lemma subsingleton_H_of_epi_freeYoneda_of_finset (S : Finset (Set X))
    (hS : ∀ T ∈ S, IsIrreducible T ∧ IsClosed T ∧ topologicalKrullDim T ≤ n) :
    ∀ {E : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}},
      IsSupportedOn E (⋃ T ∈ S, T) → ∀ {U : Opens X} (π : freeYoneda.obj U ⟶ E) [Epi π]
        (i : ℕ), n < i → Subsingleton (Sheaf.H E i) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    intro E hE U π _ i _
    exact subsingleton_H_of_isZero (IsSupportedOn.isZero (by simpa using hE)) i
  | insert T S hTS ihS =>
    intro E hE U π _ i hi
    obtain ⟨hT, hTc, hdim⟩ := hS T (Finset.mem_insert_self _ _)
    have hS' : ∀ T' ∈ S, IsIrreducible T' ∧ IsClosed T' ∧ topologicalKrullDim T' ≤ n :=
      fun T' hT' ↦ hS T' (Finset.mem_insert_of_mem hT')
    have hZ'c : IsClosed (⋃ T' ∈ S, T') := isClosed_biUnion_finset fun T' hT' ↦ (hS' T' hT').2.1
    let Zc : Opens X := ⟨(⋃ T' ∈ S, T')ᶜ, hZ'c.isOpen_compl⟩
    let Tc : Opens X := ⟨Tᶜ, hTc.isOpen_compl⟩
    let V : Opens X := U ⊓ Zc
    let g : freeYoneda.obj V ⟶ E := freeYoneda.map (homOfLE inf_le_left) ≫ π
    have hg : freeYonedaHomEquiv E V g = E.obj.map (homOfLE inf_le_left).op
        (freeYonedaHomEquiv E U π) := freeYonedaHomEquiv_naturality E _ π
    -- the image of `ℤ_V` is supported on `T`
    have hE' : IsSupportedOn (image g) T := by
      have h := isSupportedOn_compl_of_epi (factorThruImage g) Tc (by
        apply injective_app_of_mono (image.ι g)
        rw [map_zero, NatTrans.naturality_apply, freeYonedaHomEquiv_apply,
          ← comp_hom_app_apply, image.fac, ← freeYonedaHomEquiv_apply]
        refine hE _ (Set.disjoint_left.2 fun y hy hy' ↦ ?_) _
        simp only [Set.mem_iUnion, Finset.mem_insert, exists_prop] at hy'
        obtain ⟨⟨-, hyZ'⟩, hyT⟩ := hy
        obtain ⟨T', hT', hyT'⟩ := hy'
        rcases hT' with rfl | hT'
        · exact hyT hyT'
        · exact hyZ' (Set.mem_biUnion hT' hyT'))
      exact h.mono (by simp [Tc])
    -- the quotient is supported on the other components
    let S₀ := ShortComplex.mk (image.ι g) (cokernel.π (image.ι g)) (cokernel.condition _)
    have hS₀ : S₀.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    have hQ : IsSupportedOn S₀.X₃ (⋃ T' ∈ S, T') := by
      have h := isSupportedOn_compl_of_epi (π ≫ cokernel.π (image.ι g)) Zc (by
        rw [freeYonedaHomEquiv_comp, ← NatTrans.naturality_apply]
        change (cokernel.π (image.ι g)).hom.app _ (E.obj.map (homOfLE inf_le_left).op
          (freeYonedaHomEquiv E U π)) = 0
        have h0 : g ≫ cokernel.π (image.ι g) = 0 :=
          calc g ≫ cokernel.π (image.ι g) =
              factorThruImage g ≫ image.ι g ≫ cokernel.π (image.ι g) := by
                rw [← Category.assoc, image.fac]
            _ = 0 := by rw [cokernel.condition, comp_zero]
        rw [← hg, freeYonedaHomEquiv_apply, ← comp_hom_app_apply, h0]
        rfl)
      exact h.mono (by simp [Zc])
    have : Subsingleton (Sheaf.H S₀.X₁ i) :=
      subsingleton_H_of_epi_freeYoneda ih hT hTc hdim hE' (factorThruImage g) i hi
    have : Subsingleton (Sheaf.H S₀.X₃ i) :=
      ihS hS' hQ (π ≫ cokernel.π (image.ι g)) i hi
    exact subsingleton_H_X₂ hS₀ i

attribute [local instance] Abelian.hasFiniteBiproducts in
/-- **Finitely generated sheaves.** If `E` is supported on a finite union of irreducible closed
sets of dimension at most `n` and is a quotient of a finite direct sum of sheaves `ℤ_U`, then
`H^i(E) = 0` for `i > n`, by induction on the number of summands. -/
lemma subsingleton_H_of_epi_biproduct (S : Finset (Set X))
    (hS : ∀ T ∈ S, IsIrreducible T ∧ IsClosed T ∧ topologicalKrullDim T ≤ n)
    (ι : Type u) [Fintype ι] :
    ∀ (U : ι → Opens X) {E : CategoryTheory.Sheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}}, IsSupportedOn E (⋃ T ∈ S, T) →
      ∀ (p : ⨁ (fun k ↦ freeYoneda.obj (U k)) ⟶ E) [Epi p] (i : ℕ), n < i →
        Subsingleton (Sheaf.H E i) := by
  refine Fintype.induction_empty_option (P := fun ι _ ↦ ∀ (U : ι → Opens X)
      {E : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}},
      IsSupportedOn E (⋃ T ∈ S, T) → ∀ (p : ⨁ (fun k ↦ freeYoneda.obj (U k)) ⟶ E) [Epi p]
        (i : ℕ), n < i → Subsingleton (Sheaf.H E i)) ?_ ?_ ?_ ι
  · intro α β _ e h U E hE p _ i hi
    have : Fintype α := Fintype.ofEquiv β e.symm
    let w : ⨁ (fun a ↦ freeYoneda.obj (U (e a))) ≅ ⨁ (fun k ↦ freeYoneda.obj (U k)) :=
      biproduct.whiskerEquiv (f := fun a ↦ freeYoneda.obj (U (e a)))
        (g := fun k ↦ freeYoneda.obj (U k)) e fun _ ↦ Iso.refl _
    exact h (fun a ↦ U (e a)) hE (w.hom ≫ p) i hi
  · intro U E _ p _ i _
    have : IsZero (⨁ (fun k : PEmpty ↦ freeYoneda.obj (U k))) :=
      (IsZero.iff_id_eq_zero _).2 (biproduct.hom_ext' _ _ fun j ↦ isEmptyElim j)
    exact subsingleton_H_of_isZero (IsZero.of_epi p this) i
  · intro α _ h U E hE p _ i hi
    let incl : ⨁ (fun a : α ↦ freeYoneda.obj (U (some a))) ⟶
        ⨁ (fun k ↦ freeYoneda.obj (U k)) :=
      biproduct.desc fun a ↦ biproduct.ι (fun k ↦ freeYoneda.obj (U k)) (some a)
    let g := incl ≫ p
    let S₀ := ShortComplex.mk (image.ι g) (cokernel.π (image.ι g)) (cokernel.condition _)
    have hS₀ : S₀.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    have : Subsingleton (Sheaf.H S₀.X₁ i) :=
      h (fun a ↦ U (some a)) (hE.of_mono (image.ι g)) (factorThruImage g) i hi
    have hg0 : incl ≫ p ≫ cokernel.π (image.ι g) = 0 :=
      calc incl ≫ p ≫ cokernel.π (image.ι g) =
          factorThruImage g ≫ image.ι g ≫ cokernel.π (image.ι g) := by
            rw [image.fac_assoc, Category.assoc]
        _ = 0 := by rw [cokernel.condition, comp_zero]
    let φ := biproduct.ι (fun k ↦ freeYoneda.obj (U k)) none ≫ p ≫ cokernel.π (image.ι g)
    have : Epi φ := by
      refine Preadditive.epi_of_cancel_zero _ fun {Z} k hk ↦ ?_
      have h0 : p ≫ cokernel.π (image.ι g) ≫ k = 0 := by
        refine biproduct.hom_ext' _ _ fun j ↦ ?_
        rcases j with _ | a
        · simpa [φ] using hk
        · have : biproduct.ι (fun k ↦ freeYoneda.obj (U k)) (some a) =
              biproduct.ι (fun a : α ↦ freeYoneda.obj (U (some a))) a ≫ incl :=
            (biproduct.ι_desc (fun a ↦ biproduct.ι (fun k ↦ freeYoneda.obj (U k)) (some a))
              a).symm
          rw [this, comp_zero]
          simp only [Category.assoc, reassoc_of% hg0, zero_comp, comp_zero]
      rw [← Category.assoc] at h0
      exact zero_of_epi_comp _ h0
    have : Subsingleton (Sheaf.H S₀.X₃ i) :=
      subsingleton_H_of_epi_freeYoneda_of_finset ih S hS (hE.of_epi (cokernel.π _)) φ i hi
    exact subsingleton_H_X₂ hS₀ i

variable [NoetherianSpace X]

attribute [local instance] Abelian.hasFiniteBiproducts in
/-- **Reduction to finitely generated sheaves.** If `F` is supported on a finite union of
irreducible closed sets of dimension at most `n`, then `H^i(F) = 0` for `i > n`: `F` is the
filtered colimit of its subsheaves generated by finitely many sections, and on a noetherian space
cohomology classes of a filtered colimit come from the members of the diagram. -/
lemma subsingleton_H_of_isSupportedOn_finset (S : Finset (Set X))
    (hS : ∀ T ∈ S, IsIrreducible T ∧ IsClosed T ∧ topologicalKrullDim T ≤ n)
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    (hF : IsSupportedOn F (⋃ T ∈ S, T)) (i : ℕ) (hi : n < i) : Subsingleton (Sheaf.H F i) := by
  classical
  let J := Finset (Σ U : Opens X, (F.obj.obj (op U) : Type u))
  have : IsFiltered J := isFiltered_of_semilatticeSup_nonempty _
  have : HasColimitsOfShape J
      (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) :=
    HasFilteredColimitsOfSize.HasColimitsOfShape _
  let σ (s : J) : ⨁ (fun a : s ↦ freeYoneda.obj a.1.1) ⟶ F :=
    biproduct.desc fun a ↦ (freeYonedaHomEquiv F a.1.1).symm a.1.2
  have hσ {s s' : J} (h : s ≤ s') : σ s = biproduct.desc (fun a : s ↦
      biproduct.ι (fun a : s' ↦ freeYoneda.obj a.1.1) ⟨a.1, h a.2⟩) ≫ σ s' := by
    refine biproduct.hom_ext' _ _ fun a ↦ ?_
    simp [σ]
  have hmono : Monotone fun s : J ↦ imageSubobject (σ s) := fun s s' h ↦ by
    change imageSubobject (σ s) ≤ imageSubobject (σ s')
    rw [hσ h]
    exact imageSubobject_comp_le _ _
  let D : J ⥤ CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} :=
    hmono.functor ⋙ Subobject.underlying
  let c : Cocone D :=
    { pt := F
      ι := { app := fun s ↦ (imageSubobject (σ s)).arrow
             naturality := fun s s' f ↦ by
               exact (Subobject.underlying_arrow _).trans (Category.comp_id _).symm } }
  have : HasColimit D := HasColimitsOfShape.has_colimit D
  have hc (s : J) : colimit.ι D s ≫ colimit.desc D c = (imageSubobject (σ s)).arrow :=
    colimit.ι_desc c s
  have hmono' : Mono (colimit.desc D c) := by
    refine mono_of_injective_app _ fun V ↦ (injective_iff_map_eq_zero _).2 fun t ht ↦ ?_
    obtain ⟨s, t', rfl⟩ := exists_app_eq_of_isColimit (colimit.isColimit D)
      (NoetherianSpace.isCompact (V.unop : Set X)) t
    have h0 : (imageSubobject (σ s)).arrow.hom.app V t' = 0 :=
      (congrArg (fun φ : D.obj s ⟶ F ↦ φ.hom.app V t') (hc s)).symm.trans ht
    rw [injective_app_of_mono _ V (h0.trans (map_zero _).symm)]
    exact map_zero _
  have hepi : Epi (colimit.desc D c) := by
    refine epi_of_surjective_app _ fun V a ↦ ?_
    let s : J := {⟨V.unop, a⟩}
    let a' : s := ⟨⟨V.unop, a⟩, Finset.mem_singleton_self _⟩
    refine ⟨(colimit.ι D s).hom.app V ((factorThruImageSubobject (σ s)).hom.app V
      ((biproduct.ι (fun a : s ↦ freeYoneda.obj a.1.1) a').hom.app V (freeYonedaGen _))), ?_⟩
    refine (congrArg (fun φ : D.obj s ⟶ F ↦ φ.hom.app V _) (hc s)).trans ?_
    change ((biproduct.ι (fun a : s ↦ freeYoneda.obj a.1.1) a' ≫
      factorThruImageSubobject (σ s)) ≫ (imageSubobject (σ s)).arrow).hom.app V
        (freeYonedaGen _) = a
    rw [Category.assoc, imageSubobject_arrow_comp]
    change (biproduct.ι _ a' ≫ biproduct.desc
      fun a : s ↦ (freeYonedaHomEquiv F a.1.1).symm a.1.2).hom.app V (freeYonedaGen _) = a
    rw [biproduct.ι_desc, ← freeYonedaHomEquiv_apply]
    exact Equiv.apply_symm_apply _ _
  have : IsIso (colimit.desc D c) := isIso_of_mono_of_epi _
  refine ⟨fun ξ₁ ξ₂ ↦ ?_⟩
  have key (ξ : Sheaf.H F i) : ξ = 0 := by
    obtain ⟨s, ξ', hξ'⟩ := exists_H_map_colimit_ι_eq i D
      (Sheaf.H.map (inv (colimit.desc D c)) i ξ)
    have : Subsingleton (Sheaf.H (D.obj s) i) :=
      subsingleton_H_of_epi_biproduct ih S hS s (fun a ↦ a.1.1)
        (hF.of_mono (imageSubobject (σ s)).arrow) (factorThruImageSubobject (σ s)) i hi
    rw [← Sheaf.H.map_id_apply ξ, ← IsIso.inv_hom_id (colimit.desc D c),
      Sheaf.H.map_comp_apply, ← hξ', Subsingleton.elim ξ' 0, map_zero, map_zero]
  rw [key ξ₁, key ξ₂]

end Reducible

/-- An element of `WithBot ℕ∞` below `n + 1` is at most `n`. -/
private lemma le_of_lt_natCast_add_one {x : WithBot ℕ∞} {n : ℕ} (h : x < (n + 1 : ℕ)) :
    x ≤ n := by
  induction x using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe x =>
    induction x using ENat.recTopCoe with
    | top =>
      rw [WithBot.coe_top] at h
      exact absurd h (not_lt.2 le_top)
    | coe x =>
      have : x < n + 1 := by exact_mod_cast h
      exact_mod_cast Nat.lt_succ_iff.1 this

variable [NoetherianSpace X]

/-- **Grothendieck vanishing for sheaves with support of bounded dimension.** On a noetherian
space, an abelian sheaf supported on a closed subset of dimension less than `n` has vanishing
cohomology in degrees at least `n`. -/
theorem vanishingBelow (n : ℕ) : VanishingBelow X n := by
  induction n with
  | zero =>
    intro Z _ hdim F hF i _
    have hZ : Z = ∅ := by
      by_contra hZ
      obtain ⟨z, hz⟩ := Set.nonempty_iff_ne_empty.2 hZ
      rw [topologicalKrullDim, Order.krullDim_lt_coe_iff] at hdim
      exact Nat.not_lt_zero _ (hdim (RelSeries.singleton _
        ⟨closure {(⟨z, hz⟩ : Z)}, isIrreducible_singleton.closure, isClosed_closure⟩))
    subst hZ
    exact subsingleton_H_of_isZero hF.isZero i
  | succ n ih =>
    intro Z hZ hdim F hF i hi
    obtain ⟨S, hSf, hSc, hSi, rfl⟩ := NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
    refine subsingleton_H_of_isSupportedOn_finset ih hSf.toFinset (fun T hT ↦ ?_) F
      (by simpa [Set.sUnion_eq_biUnion] using hF) i (by omega)
    rw [Set.Finite.mem_toFinset] at hT
    refine ⟨hSi T hT, hSc T hT, le_trans ?_ (le_of_lt_natCast_add_one hdim)⟩
    exact (Topology.IsInducing.of_comp (continuous_inclusion (Set.subset_sUnion_of_mem hT))
      continuous_subtype_val Topology.IsInducing.subtypeVal).topologicalKrullDim_le

/-- **Grothendieck vanishing.** On a noetherian topological space `X`, `H^q(X, F) = 0` for every
abelian sheaf `F` and every `q` larger than the dimension of `X`. -/
@[stacks 02UZ]
theorem subsingleton_H_of_topologicalKrullDim_lt
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) {q : ℕ}
    (hq : topologicalKrullDim X < q) : Subsingleton (Sheaf.H F q) := by
  refine vanishingBelow q Set.univ isClosed_univ ?_ F (fun V hV s ↦ ?_) q le_rfl
  · rwa [(Homeomorph.Set.univ X).isHomeomorph.topologicalKrullDim_eq]
  · have hV' : V = ⊥ := eq_bot_iff.2 fun x hx ↦ (Set.disjoint_left.1 hV hx (Set.mem_univ x)).elim
    have := AddCommGrpCat.subsingleton_of_isZero
      (isTerminalOfEqEmpty (C := AddCommGrpCat.{u}) F hV').isZero
    exact Subsingleton.elim _ _

end TopCat.Sheaf
