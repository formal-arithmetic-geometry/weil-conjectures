module

public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.RingTheory.Flat.Basic
public import WeilConjectures.RingTheory.IsMittagLeffler
import WeilConjectures.RingTheory.FinitePresentationTensorProducts
import WeilConjectures.SecTraceFormula.CoherentProductFlat
import WeilConjectures.SecTraceFormula.FlatMittagLefflerCriterion

/-!
# Product of copies of a Noetherian ring is flat Mittag-Leffler

Source: Stacks Project, Algebra, Tag 05D0, lemma-product-over-Noetherian-ring
(blueprint: lem-trf-product-noetherian-flat-mittag-leffler).
-/

@[expose] public section

universe u v

namespace Module

/-- Let `R` be a Noetherian commutative ring and `A` any set. The product module
`R^A`, with componentwise module operations, is flat over `R` and is a
Mittag-Leffler `R`-module. Source: Stacks Project, Algebra, Tag 05D0,
lemma-product-over-Noetherian-ring (blueprint: lem-trf-product-noetherian-flat-mittag-leffler).

Proof (following the five steps of the node):

1. Apply `lem-trf-noetherian-submodule-finitely-presented` to the finite module `R`,
   generated by `1`, including for the zero ring. Every ideal is a submodule of `R`,
   so each finitely generated ideal is finitely presented. This is the coherence
   hypothesis of `lem-trf-coherent-product-flat`.
2. Put `M = R^A`. The tensor universal property
   `def-weil-pbc-module-tensor-product` gives the natural unit isomorphism
   `N ⊗[R] R ≃ N`, sending `n ⊗ r` to `r • n`, with inverse `n ↦ n ⊗ 1`.
   Consequently tensoring an injection with `R` stays injective, so `R` is flat
   by `def-weil-pbc-flat-ring-map`. Apply `lem-trf-coherent-product-flat` to the
   constant family with value `R`, obtaining flatness of `M` for arbitrary `A`.
3. For finite free `F`, the node `lem-trf-noetherian-submodule-finitely-presented`
   makes every submodule `G` of `F`, and `F` itself, finitely presented. By
   `lem-trf-finite-presentation-tensor-products` and the unit maps from step 2,
   there are isomorphisms `G ⊗[R] M ≃ G^A` and `F ⊗[R] M ≃ F^A`.
   The first sends `g ⊗ (r_a)` to `(r_a • g)`, and likewise for `F`. For the
   inclusion `i : G → F`, both composites send this tensor to `(r_a • i(g))`.
   Since pure tensors generate by `def-weil-pbc-module-tensor-product`, the
   square commutes. Thus the tensor inclusion is identified with `G^A → F^A`.
4. For `x` corresponding to `(x_a)` in `F^A`, let `G₀` be the span of its
   coordinates. Step 3 shows that `x` belongs to the tensor image of `G`
   exactly when every `x_a` belongs to `G`, equivalently when `G₀ ≤ G`.
   Taking `G = G₀` shows that `G₀` supports `x`, so it is the least such
   submodule. For empty `A`, this span is zero and the same argument applies.
5. Apply `lem-trf-flat-mittag-leffler-criterion` to `M`: step 2 supplies
   flatness, and steps 3 and 4 supply the least-submodule condition for every
   finite free `F` and every tensor `x`. This gives the Mittag-Leffler
   conclusion, together with the flatness already established.
-/
theorem product_noetherian_flat_mittag_leffler
    {R : Type u} [CommRing R] [IsNoetherianRing R] (A : Type v) :
    Module.Flat R (∀ _ : A, R) ∧
      Module.IsMittagLeffler R (∀ _ : A, R) := by
  sorry

end Module
