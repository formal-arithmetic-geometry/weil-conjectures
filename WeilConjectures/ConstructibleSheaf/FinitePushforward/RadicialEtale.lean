/-!
# Generic radicial-étale factorization of finite algebras

Let `A` be a Noetherian domain with exponential characteristic `p` and `R` a reduced finite
`A`-algebra. For `e ≥ 0` let `C_e ⊆ R` be the `A`-subalgebra generated by the `p ^ e`-th powers.
Then `R` is a universal homeomorphism over every `C_e`
(`AlgebraicGeometry.Algebra.IsUniversalHomeomorphism.adjoin_pow`), and for `e` large `C_e`
becomes étale over `A` after inverting a nonzero element of `A`
(`Algebra.exists_subalgebra_isUniversalHomeomorphism_etale`).

In characteristic zero `C_e = R`, whose generic fibre is a reduced finite algebra over the
fraction field, hence étale (`Algebra.mem_unramifiedLocus_of_charZero`). In characteristic
`p > 0` the ranks of the decreasing subalgebras `C_e` stabilize, so that `C_e` is generated up to
torsion by `p`-th powers and its Kähler differentials are torsion
(`Algebra.exists_forall_exists_smul_eq_zero_kaehlerDifferential_adjoin_pow`). In both cases `C_e`
is unramified over the generic point of `A`, and generic flatness spreads this out to étaleness
over a nonempty basic open (`Algebra.exists_etale_localization_of_mem_unramifiedLocus`).

This is the algebraic input to the blueprint lemma
`lem-weil-pbc-finite-pushforward-generic-constructible`.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

variable {A R : Type u} [CommRing A] [CommRing R] [Algebra A R]

/-- Let `p` be the exponential characteristic of `A` and `R` an integral `A`-algebra. Then `R` is
a universal homeomorphism over the `A`-subalgebra generated by the `p ^ e`-th powers: two ring
maps from `R` to a field agreeing on the `p ^ e`-th powers agree, the `p ^ e`-th power map of a
field of characteristic `p` being injective. -/
theorem Algebra.IsUniversalHomeomorphism.adjoin_pow [Algebra.IsIntegral A R] (p : ℕ)
    [hp : ExpChar A p] (e : ℕ) :
    Algebra.IsUniversalHomeomorphism (Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}) R where
  isUniversalHomeomorphism := by
    set C := Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}
    let f := Spec.map (CommRingCat.ofHom (algebraMap C R))
    have : Algebra.IsIntegral C R := Algebra.IsIntegral.tower_top (R := A)
    have h1 : IsIntegralHom f := IsIntegralHom.SpecMap_iff.mpr
      ((algebraMap_isIntegral_iff (R := C) (A := R)).mpr inferInstance)
    have h2 : Surjective f := ⟨Algebra.IsIntegral.comap_surjective C R⟩
    have h3 : UniversallyInjective f := by
      refine ((tfae_universallyInjective f).out 1 0).mp ?_
      intro K _ g₁ g₂ hg
      rw [← Spec.map_preimage g₁, ← Spec.map_preimage g₂] at hg ⊢
      simp only [f, ← Spec.map_comp] at hg
      have h := congrArg CommRingCat.Hom.hom (Spec.map_injective hg)
      congr 1
      ext y
      set φ₁ := (Spec.preimage g₁).hom
      set φ₂ := (Spec.preimage g₂).hom
      have hC (c : C) : φ₁ (algebraMap C R c) = φ₂ (algebraMap C R c) :=
        congr($h c)
      have hy : φ₁ y ^ p ^ e = φ₂ y ^ p ^ e := by
        simpa [← map_pow] using hC ⟨y ^ p ^ e, Algebra.subset_adjoin ⟨y, rfl⟩⟩
      cases hp with
      | zero => simpa using hy
      | prime hprime =>
        have hK : (p : K) = 0 := by
          rw [← map_natCast (φ₁.comp (algebraMap A R)) p, CharP.cast_eq_zero, map_zero]
        have : CharP K p := (CharP.charP_iff_prime_eq_zero hprime).2 hK
        have : ExpChar K p := .prime hprime
        exact (iterateFrobenius K p e).injective (by simpa [iterateFrobenius_def] using hy)
    exact { }

end AlgebraicGeometry

namespace Algebra

variable {A R : Type u} [CommRing A] [CommRing R] [Algebra A R]

/-- The subalgebras generated by the `p ^ e`-th powers decrease with `e`. -/
lemma adjoin_pow_succ_le (p e : ℕ) :
    Algebra.adjoin A {x : R | ∃ y, y ^ p ^ (e + 1) = x} ≤
      Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x} := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨y, rfl⟩
  exact Algebra.subset_adjoin ⟨y ^ p, by rw [← pow_mul, ← pow_succ']⟩

/-- Over a Noetherian domain, the decreasing subalgebras generated by the `p ^ e`-th powers of a
finite algebra eventually agree up to torsion: their ranks stabilize, and a submodule of full
rank has torsion quotient. -/
theorem exists_smul_mem_adjoin_pow_succ [IsDomain A] [IsNoetherianRing A] [Module.Finite A R]
    (p : ℕ) : ∃ e : ℕ, ∀ x ∈ Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x},
      ∃ a : A, a ≠ 0 ∧ a • x ∈ Algebra.adjoin A {x : R | ∃ y, y ^ p ^ (e + 1) = x} := by
  set N : ℕ → Submodule A R := fun e ↦
    Subalgebra.toSubmodule (Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}) with hNdef
  have hN (e : ℕ) : N (e + 1) ≤ N e := adjoin_pow_succ_le (A := A) (R := R) p e
  obtain ⟨e, he⟩ : ∃ e, ∀ e', Module.finrank A (N e) ≤ Module.finrank A (N e') := by
    obtain ⟨e, he⟩ := Nat.sInf_mem (Set.range_nonempty fun e ↦ Module.finrank A (N e))
    exact ⟨e, fun e' ↦ (le_of_eq he).trans (Nat.sInf_le ⟨e', rfl⟩)⟩
  refine ⟨e, fun x hx ↦ ?_⟩
  have heq : Module.finrank A (N (e + 1)) = Module.finrank A (N e) :=
    le_antisymm (Submodule.finrank_mono (hN e)) (he _)
  let P : Submodule A (N e) := (N (e + 1)).comap (N e).subtype
  have hP : Module.rank A P = Module.rank A (N (e + 1)) :=
    (Submodule.comapSubtypeEquivOfLe (hN e)).rank_eq
  have hrank := rank_quotient_add_rank_of_isDomain P
  have h1 : Module.rank A (N (e + 1)) = Module.rank A (N e) := by
    rw [← Module.finrank_eq_rank, ← Module.finrank_eq_rank, heq]
  rw [hP, h1] at hrank
  have h0 : Module.rank A (N e ⧸ P) = 0 := by
    obtain ⟨k, hk⟩ := Cardinal.lt_aleph0.1 (Module.rank_lt_aleph0 A (N e ⧸ P))
    have hn : (Module.finrank A (N e) : Cardinal) = Module.rank A (N e) :=
      Module.finrank_eq_rank _ _
    rw [hk, ← hn] at hrank
    rw [hk]
    norm_cast at hrank ⊢
    omega
  obtain ⟨a, ha, hax⟩ := rank_eq_zero_iff.1 h0 (Submodule.Quotient.mk ⟨x, hx⟩)
  refine ⟨a, ha, ?_⟩
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hax
  exact hax

/-- In characteristic `p`, the differential of the `A`-algebra generated by the `p ^ e`-th powers
kills the `p ^ (e + 1)`-th powers, these being `p`-th powers. -/
theorem kaehlerD_eq_zero_of_mem_adjoin_pow_succ (p : ℕ) [CharP A p] (e : ℕ) {x : R}
    (hx : x ∈ Algebra.adjoin A {x : R | ∃ y, y ^ p ^ (e + 1) = x}) :
    KaehlerDifferential.D A (Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x})
      ⟨x, adjoin_pow_succ_le p e hx⟩ = 0 := by
  set C := Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨y, rfl⟩ := hx
    have hy : y ^ p ^ e ∈ C := Algebra.subset_adjoin ⟨y, rfl⟩
    have : (⟨y ^ p ^ (e + 1), adjoin_pow_succ_le p e
        (Algebra.subset_adjoin ⟨y, rfl⟩)⟩ : C) = ⟨y ^ p ^ e, hy⟩ ^ p := by
      ext
      simp [← pow_mul, ← pow_succ]
    rw [this, Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul A, CharP.cast_eq_zero, zero_smul]
  | algebraMap a =>
    exact (KaehlerDifferential.D A C).map_algebraMap a
  | add x y hx hy ihx ihy =>
    have : (⟨x + y, adjoin_pow_succ_le p e (add_mem hx hy)⟩ : C) =
        ⟨x, adjoin_pow_succ_le p e hx⟩ + ⟨y, adjoin_pow_succ_le p e hy⟩ := rfl
    rw [this, map_add, ihx, ihy, add_zero]
  | mul x y hx hy ihx ihy =>
    have : (⟨x * y, adjoin_pow_succ_le p e (mul_mem hx hy)⟩ : C) =
        ⟨x, adjoin_pow_succ_le p e hx⟩ * ⟨y, adjoin_pow_succ_le p e hy⟩ := rfl
    rw [this, Derivation.leibniz, ihx, ihy, smul_zero, smul_zero, add_zero]

/-- If every Kähler differential of `C` over `A` is killed by a nonzero element of the domain
`A`, then `C` is unramified over `A` at every prime lying over the generic point of `A`. -/
theorem mem_unramifiedLocus_of_forall_exists_smul_eq_zero {C : Type u} [CommRing C] [Algebra A C]
    [IsDomain A] (h : ∀ ω : Ω[C⁄A], ∃ a : A, a ≠ 0 ∧ a • ω = 0) (Q : PrimeSpectrum C)
    (hQ : Q.asIdeal.comap (algebraMap A C) = ⊥) : Q ∈ Algebra.unramifiedLocus A C := by
  rw [Algebra.unramifiedLocus_eq_compl_support, Set.mem_compl_iff, Module.notMem_support_iff']
  intro ω
  obtain ⟨a, ha, hω⟩ := h ω
  refine ⟨algebraMap A C a, fun haQ ↦ ha ?_, by rwa [algebraMap_smul]⟩
  rw [← Ideal.mem_bot, ← hQ]
  exact haQ

/-- The Kähler differentials of `C` over a domain `A` are torsion as soon as the differentials
of the elements of `C` are. -/
theorem exists_smul_eq_zero_of_forall_exists_smul_kaehlerD_eq_zero {C : Type u} [CommRing C]
    [Algebra A C] [IsDomain A]
    (h : ∀ c : C, ∃ a : A, a ≠ 0 ∧ a • KaehlerDifferential.D A C c = 0) (ω : Ω[C⁄A]) :
    ∃ a : A, a ≠ 0 ∧ a • ω = 0 := by
  have hω : ω ∈ Submodule.span C (Set.range (KaehlerDifferential.D A C)) := by
    rw [KaehlerDifferential.span_range_derivation]
    trivial
  induction hω using Submodule.span_induction with
  | mem ω hω =>
    obtain ⟨c, rfl⟩ := hω
    exact h c
  | zero => exact ⟨1, one_ne_zero, smul_zero _⟩
  | add ω₁ ω₂ _ _ h₁ h₂ =>
    obtain ⟨a₁, ha₁, h₁⟩ := h₁
    obtain ⟨a₂, ha₂, h₂⟩ := h₂
    refine ⟨a₁ * a₂, mul_ne_zero ha₁ ha₂, ?_⟩
    rw [smul_add, mul_comm, mul_smul, h₁, mul_comm, mul_smul, h₂, smul_zero, smul_zero,
      add_zero]
  | smul c ω _ h =>
    obtain ⟨a, ha, h⟩ := h
    exact ⟨a, ha, by rw [smul_comm, h, smul_zero]⟩

/-- In characteristic `p > 0`, for `e` large the `A`-algebra generated by the `p ^ e`-th powers
of a finite `A`-algebra has torsion Kähler differentials. -/
theorem exists_forall_exists_smul_eq_zero_kaehlerDifferential_adjoin_pow [IsDomain A]
    [IsNoetherianRing A] [Module.Finite A R] (p : ℕ) [CharP A p] :
    ∃ e : ℕ, ∀ ω : Ω[(Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x})⁄A],
      ∃ a : A, a ≠ 0 ∧ a • ω = 0 := by
  obtain ⟨e, he⟩ := exists_smul_mem_adjoin_pow_succ (A := A) (R := R) p
  refine ⟨e, exists_smul_eq_zero_of_forall_exists_smul_kaehlerD_eq_zero fun ⟨c, hc⟩ ↦ ?_⟩
  obtain ⟨a, ha, hac⟩ := he c hc
  refine ⟨a, ha, ?_⟩
  have := kaehlerD_eq_zero_of_mem_adjoin_pow_succ p e hac
  rwa [show (⟨a • c, adjoin_pow_succ_le p e hac⟩ :
      Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}) = a • ⟨c, hc⟩ from rfl,
    Derivation.map_smul] at this

attribute [local instance] IsArtinianRing.fieldOfSubtypeIsMaximal in
/-- A reduced finite algebra over a field of characteristic zero is étale: it is a finite product
of finite field extensions, which are separable. -/
theorem FormallyEtale.of_isReduced_of_charZero (K L : Type u) [Field K] [CharZero K] [CommRing L]
    [Algebra K L] [IsReduced L] [Module.Finite K L] : Algebra.FormallyEtale K L := by
  have : IsArtinianRing L := isArtinian_of_tower K inferInstance
  rw [Algebra.FormallyEtale.iff_of_equiv ((IsArtinianRing.equivPi L).restrictScalars K),
    Algebra.FormallyEtale.pi_iff]
  intro I
  have : Module.Finite K (L ⧸ I.asIdeal) :=
    Module.Finite.of_surjective ((Ideal.Quotient.mkₐ K I.asIdeal).toLinearMap)
      Ideal.Quotient.mk_surjective
  exact Algebra.FormallyEtale.of_isSeparable K _

/-- In characteristic zero, a reduced finite algebra `C` over a domain `A` is unramified at every
prime lying over the generic point of `A`: its generic fibre is a reduced finite algebra over the
fraction field `K` of `A`, hence étale over `K`, and the localizations of `C` at the primes over
`(0)` are localizations of the generic fibre. -/
theorem mem_unramifiedLocus_of_charZero {C : Type u} [CommRing C] [Algebra A C] [IsDomain A]
    [CharZero A] [IsReduced C] [Module.Finite A C] (Q : PrimeSpectrum C)
    (hQ : Q.asIdeal.comap (algebraMap A C) = ⊥) : Q ∈ Algebra.unramifiedLocus A C := by
  classical
  have : CharZero (FractionRing A) :=
    charZero_of_injective_algebraMap (IsFractionRing.injective A (FractionRing A))
  have := FormallyEtale.of_isReduced_of_charZero (FractionRing A)
    (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A)))
  have : IsScalarTower A (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) :=
    isScalarTower_localizationAlgebra _ _
  have : Algebra.FormallyUnramified A
      (Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))) :=
    Algebra.FormallyUnramified.comp A (FractionRing A) _
  have hle : Algebra.algebraMapSubmonoid C (nonZeroDivisors A) ≤ Q.asIdeal.primeCompl := by
    rintro _ ⟨a, ha, rfl⟩ haQ
    have : a ∈ Q.asIdeal.comap (algebraMap A C) := haQ
    rw [hQ, Ideal.mem_bot] at this
    exact nonZeroDivisors.ne_zero ha this
  set CK := Localization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))
  set CQ := Localization.AtPrime Q.asIdeal
  let := IsLocalization.localizationAlgebraOfSubmonoidLe CK CQ _ _ hle
  have := IsLocalization.localization_isScalarTower_of_submonoid_le CK CQ _ _ hle
  have := IsLocalization.isLocalization_of_submonoid_le CK CQ _ _ hle
  have : Algebra.FormallyUnramified CK CQ := Algebra.FormallyUnramified.of_isLocalization
    (Q.asIdeal.primeCompl.map (algebraMap C CK))
  have : IsScalarTower A CK CQ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A C CK, ← IsScalarTower.algebraMap_apply C CK CQ,
      ← IsScalarTower.algebraMap_apply]
  exact Algebra.FormallyUnramified.comp A CK CQ

/-- **Generic étaleness.** Let `C` be a finite algebra over a Noetherian domain `A` which is
unramified at the primes lying over the generic point of `A`. Then `C` becomes étale after
inverting a nonzero element `r` of `A`: the non-unramified locus is closed with closed image in
`Spec A` (`C` being integral over `A`) missing the generic point, and by generic flatness `C`
becomes flat after inverting a further nonzero element. -/
theorem exists_etale_localization_of_mem_unramifiedLocus [IsDomain A] [IsNoetherianRing A]
    {C : Type u} [CommRing C] [Algebra A C] [Module.Finite A C]
    (h : ∀ Q : PrimeSpectrum C, Q.asIdeal.comap (algebraMap A C) = ⊥ →
      Q ∈ Algebra.unramifiedLocus A C) :
    ∃ r : A, r ≠ 0 ∧ Algebra.Etale (Localization.Away r)
      (Localization (Algebra.algebraMapSubmonoid C (.powers r))) := by
  classical
  -- the image of the ramification locus misses the generic point
  set W := PrimeSpectrum.comap (algebraMap A C) '' (Algebra.unramifiedLocus A C)ᶜ
  have hW : IsClosed W := PrimeSpectrum.isClosedMap_comap_of_isIntegral (algebraMap A C)
    ((algebraMap_isIntegral_iff (R := A) (A := C)).mpr inferInstance) _
    Algebra.isOpen_unramifiedLocus.isClosed_compl
  have hη : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∉ W := by
    rintro ⟨Q, hQ, hQη⟩
    exact hQ (h Q (congrArg PrimeSpectrum.asIdeal hQη))
  rw [← hW.closure_eq, ← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
    PrimeSpectrum.mem_zeroLocus, Set.not_subset] at hη
  obtain ⟨f₁, hf₁W, hf₁⟩ := hη
  have hf₁ : f₁ ≠ 0 := fun h ↦ hf₁ (by simp [h])
  -- generic flatness
  obtain ⟨f₂, hf₂, hflat⟩ := Module.exists_flat_localizedModule_powers (R := A) (S := C) C
  set r := f₁ * f₂
  refine ⟨r, mul_ne_zero hf₁ hf₂, ?_⟩
  set Ar := Localization.Away r
  set Cr := Localization (Algebra.algebraMapSubmonoid C (.powers r))
  have : IsScalarTower A Ar Cr := isScalarTower_localizationAlgebra _ _
  -- flatness
  have : Module.Flat A (LocalizedModule (.powers r) C) := (Module.flatAway_iff r).1
    (((Module.flatAway_iff f₂).2 hflat).of_dvd (dvd_mul_left f₂ f₁))
  have : Module.Flat A Cr := Module.Flat.of_linearEquiv
    (IsLocalizedModule.iso (.powers r) (IsScalarTower.toAlgHom A C Cr).toLinearMap).symm
  have : Module.Flat Ar Cr := (Module.flat_iff_of_isLocalization Ar (.powers r) Cr).2 ‹_›
  -- unramifiedness
  have hsub : Algebra.algebraMapSubmonoid C (.powers r) = .powers (algebraMap A C r) :=
    Submonoid.map_powers _ _
  have : IsLocalization (Algebra.algebraMapSubmonoid C (.powers r))
      (Localization.Away (algebraMap A C r)) := by
    rw [hsub]
    exact Localization.isLocalization
  have : Algebra.FormallyUnramified A (Localization.Away (algebraMap A C r)) := by
    refine Algebra.basicOpen_subset_unramifiedLocus_iff.1 fun Q hQ ↦ ?_
    by_contra hQu
    refine hQ ?_
    rw [map_mul]
    exact Ideal.mul_mem_right _ _
      ((PrimeSpectrum.mem_vanishingIdeal W f₁).1 hf₁W _ ⟨Q, hQu, rfl⟩)
  have : Algebra.FormallyUnramified A Cr := Algebra.FormallyUnramified.of_equiv
    ((IsLocalization.algEquiv (Algebra.algebraMapSubmonoid C (.powers r))
      (Localization.Away (algebraMap A C r)) Cr).restrictScalars A)
  have : Algebra.FormallyUnramified Ar Cr := Algebra.FormallyUnramified.of_restrictScalars A _ _
  -- finite presentation
  have : Module.Finite Ar Cr := Module.Finite.of_isLocalization A C (.powers r)
  have : Algebra.FinitePresentation Ar Cr :=
    Algebra.FinitePresentation.of_finiteType.1 inferInstance
  exact Algebra.Etale.of_formallyUnramified_of_flat

/-- A subalgebra of a finite algebra over a Noetherian ring is finite. -/
lemma _root_.Subalgebra.moduleFinite_of_isNoetherianRing [IsNoetherianRing A] [Module.Finite A R]
    (C : Subalgebra A R) : Module.Finite A C :=
  inferInstanceAs (Module.Finite A (Subalgebra.toSubmodule C))

/-- **Generic radicial-étale factorization.** A reduced finite algebra `R` over a Noetherian
domain `A` contains an `A`-subalgebra `C` such that `R` is a universal homeomorphism over `C`
and `C` becomes étale over `A` after inverting a nonzero element `r` of `A`. One takes for `C`
the subalgebra generated by the `p ^ e`-th powers, `p` the exponential characteristic of `A` and
`e` large: in characteristic zero `C = R` is generically étale, being reduced, and in
characteristic `p > 0` the Kähler differentials of `C` are torsion for `e` large. -/
theorem exists_subalgebra_isUniversalHomeomorphism_etale [IsDomain A] [IsNoetherianRing A]
    [IsReduced R] [Module.Finite A R] :
    ∃ (C : Subalgebra A R) (r : A), r ≠ 0 ∧ Algebra.IsUniversalHomeomorphism C R ∧
      Algebra.Etale (Localization.Away r)
        (Localization (Algebra.algebraMapSubmonoid C (.powers r))) := by
  obtain ⟨p, hp⟩ := ExpChar.exists A
  obtain ⟨e, he⟩ : ∃ e : ℕ, ∀ Q : PrimeSpectrum (Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}),
      Q.asIdeal.comap (algebraMap A _) = ⊥ → Q ∈ Algebra.unramifiedLocus A _ := by
    cases hp with
    | zero =>
      refine ⟨0, fun Q hQ ↦ ?_⟩
      have := (Algebra.adjoin A {x : R | ∃ y, y ^ 1 ^ 0 = x}).moduleFinite_of_isNoetherianRing
      have : IsReduced (Algebra.adjoin A {x : R | ∃ y, y ^ 1 ^ 0 = x}) :=
        isReduced_of_injective (Algebra.adjoin A {x : R | ∃ y, y ^ 1 ^ 0 = x}).val
          Subtype.val_injective
      exact mem_unramifiedLocus_of_charZero Q hQ
    | prime hprime =>
      obtain ⟨e, he⟩ :=
        exists_forall_exists_smul_eq_zero_kaehlerDifferential_adjoin_pow (A := A) (R := R) p
      exact ⟨e, mem_unramifiedLocus_of_forall_exists_smul_eq_zero he⟩
  have := (Algebra.adjoin A {x : R | ∃ y, y ^ p ^ e = x}).moduleFinite_of_isNoetherianRing
  obtain ⟨r, hr, hEt⟩ := exists_etale_localization_of_mem_unramifiedLocus he
  exact ⟨_, r, hr, AlgebraicGeometry.Algebra.IsUniversalHomeomorphism.adjoin_pow p e, hEt⟩

end Algebra
