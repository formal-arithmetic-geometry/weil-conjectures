module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import WeilConjectures.ConstructibleSheaf.Defs

/-!
# Constructible sheaves on the small pro-étale site

The specialization of `WeilConjectures.ConstructibleSheaf.Defs` to
`P = Q = @WeaklyEtale`. The underlying category is
`AlgebraicGeometry.Scheme.ProEt X = MorphismProperty.Over @WeaklyEtale ⊤ X`, the small
pro-étale site of `X`.

## The topology

`X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)` is the topology on `X.ProEt`
whose covers are the jointly surjective families of weakly étale maps. This is *not*
mathlib's `AlgebraicGeometry.Scheme.ProEt.topology`, which is generated by
`AlgebraicGeometry.proetalePrecoverage` and additionally imposes a quasi-compactness
condition on the covers ([Bhatt–Scholze, Definition 4.1.1]); the two topologies live on the
same category and the pro-étale one is the finer of the two
(`AlgebraicGeometry.Scheme.ProEt.zariskiTopology_le_topology` in the `proetale` package
compares the analogous pair). Whether the constructible sheaves for the two agree is not
addressed here.

## Geometric points

A geometric point `Spec Ω ⟶ X`, with `Ω` a separably closed field, defines a point of the
small pro-étale site with the same fiber functor `V ↦ Hom_X(Spec Ω, V)` as in the étale
case (`AlgebraicGeometry.Scheme.pointSmallEtale`). Its three axioms are sorried: cofiltered
elements, initial smallness, and joint surjectivity on fibers over a cover. The last is the
lifting property of weakly étale morphisms against a separably closed field, the analogue
of `AlgebraicGeometry.Scheme.exists_fac_of_etale_of_isSepClosed`.
-/

@[expose] public section

universe u u'

open CategoryTheory Limits Opposite

noncomputable section

namespace AlgebraicGeometry.ProEt

variable {X : Scheme.{u}}

/-- The point of the small pro-étale site of `X` attached to a geometric point
`s : Spec Ω ⟶ X` with `Ω` separably closed: its fiber functor sends a weakly étale
`V ⟶ X` to the set of `X`-morphisms `Spec Ω ⟶ V`. This is the pro-étale analogue of
`AlgebraicGeometry.Scheme.pointSmallEtale`. -/
def pointSmallProEt {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ X) :
    (X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)).Point where
  fiber := Scheme.ProEt.forget X ⋙ coyoneda.obj (op (Over.mk s))
  isCofiltered := sorry
  initiallySmall := sorry
  jointly_surjective := sorry

/-- A geometric point of `X` is a point of the small pro-étale site of `X`. -/
instance hasGeometricPoints : Scheme.HasGeometricPoints @WeaklyEtale @WeaklyEtale where
  point s := pointSmallProEt s

section LocallyConstant

variable {A : Type u'} [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]

/-- A sheaf on the small pro-étale site of `X` is *locally constant* if there is a weakly
étale cover of `X` on whose members it becomes constant. -/
abbrev IsLocallyConstantSheaf
    (F : Sheaf (X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)) A) : Prop :=
  Scheme.IsLocallyConstantSheaf @WeaklyEtale @WeaklyEtale le_rfl F

end LocallyConstant

section FiniteSheaf

variable {A : Type u'} [Category.{u + 1} A]
  {FA : A → A → Type (u + 1)} {CA : A → Type (u + 1)}
  [∀ X Y, FunLike (FA X Y) (CA X) (CA Y)] [ConcreteCategory.{u + 1} A FA]
  [HasColimitsOfSize.{u, u} A]

/-- A sheaf on the small pro-étale site of `X` with values in a concrete category is
*finite* if its stalk at every geometric point of `X` is finite. -/
abbrev IsFiniteSheaf
    (F : Sheaf (X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)) A) : Prop :=
  Scheme.IsFiniteSheaf @WeaklyEtale @WeaklyEtale F

end FiniteSheaf

section Constructible

variable {A : Type u'} [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
  {FA : A → A → Type (u + 1)} {CA : A → Type (u + 1)}
  [∀ X Y, FunLike (FA X Y) (CA X) (CA Y)] [ConcreteCategory.{u + 1} A FA]

/-- A sheaf on the small pro-étale site of `X` with values in a concrete category is
*finite locally constant* if it is locally constant and finite. -/
abbrev IsFiniteLocallyConstantSheaf
    (F : Sheaf (X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)) A) : Prop :=
  Scheme.IsFiniteLocallyConstantSheaf @WeaklyEtale @WeaklyEtale le_rfl F

/-- A sheaf on the small pro-étale site of `X` with values in a concrete category is
*constructible* if there is a stratification of `X` such that the pullback of the sheaf to
each stratum is finite locally constant. -/
abbrev IsConstructibleSheaf
    (F : Sheaf (X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)) A) : Prop :=
  Scheme.IsConstructibleSheaf @WeaklyEtale @WeaklyEtale le_rfl F

end Constructible

end AlgebraicGeometry.ProEt
