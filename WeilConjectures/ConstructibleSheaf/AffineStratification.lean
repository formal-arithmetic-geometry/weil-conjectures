module

public import WeilConjectures.ConstructibleSheaf.Refinement
public import WeilConjectures.AlgebraicGeometry.NoetherianApproximation
public import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Immersed strata over affine schemes

A locally closed subset of an affine scheme `Spec R` is the image of an immersion
(`AlgebraicGeometry.Scheme.exists_isImmersion_range_eq_of_isLocallyClosed`), so a stratification
of the underlying space of `Spec R` is the underlying stratification of a scheme stratification
(`AlgebraicGeometry.Scheme.Stratification.ofAffine`). With the descent of stratifications to a
finitely generated subring, every stratification of `Spec A` comes from a scheme stratification
of a Noetherian affine scheme (`AlgebraicGeometry.exists_finset_schemeStratification`), which is
the stratification part of Step 2 of `lem-weil-pbc-constructible-finite-pushforward-approximation`.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry
/-- **Locally closed subsets of an affine scheme are images of immersions**: `U ∩ Z` is the image
of the open subscheme over `U` of the closed subscheme `Spec (R ⧸ I(Z))`. -/
lemma Scheme.exists_isImmersion_range_eq_of_isLocallyClosed {R : CommRingCat.{u}}
    {s : Set (Spec R)} (hs : IsLocallyClosed s) :
    ∃ (D : Scheme.{u}) (ι : D ⟶ Spec R), IsImmersion ι ∧ Set.range ι.base = s := by
  obtain ⟨U, Z, hU, hZ, rfl⟩ := hs
  let I : Ideal R := _root_.PrimeSpectrum.vanishingIdeal Z
  let c : Spec (.of (R ⧸ I)) ⟶ Spec R := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))
  have hc : Set.range c.base = Z := by
    change Set.range (_root_.PrimeSpectrum.comap (Ideal.Quotient.mk I)) = Z
    rw [_root_.range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
      _root_.PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hZ.closure_eq]
  let W : (Spec (.of (R ⧸ I))).Opens := c ⁻¹ᵁ ⟨U, hU⟩
  refine ⟨W, W.ι ≫ c, inferInstance, ?_⟩
  rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, Scheme.Opens.range_ι]
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨hy, hc ▸ ⟨y, rfl⟩⟩
  · rintro ⟨hxU, hxZ⟩
    rw [← hc] at hxZ
    obtain ⟨y, rfl⟩ := hxZ
    exact ⟨y, hxU, rfl⟩

/-- A stratification of the underlying space of an affine scheme, with immersed strata. -/
noncomputable def Scheme.Stratification.ofAffine {R : CommRingCat.{u}}
    (T : Topology.Stratification (Spec R)) : Scheme.Stratification (Spec R) where
  toStratification := T
  domain i :=
    (exists_isImmersion_range_eq_of_isLocallyClosed (T.isLocallyClosed_stratum i)).choose
  immersion i := (exists_isImmersion_range_eq_of_isLocallyClosed
    (T.isLocallyClosed_stratum i)).choose_spec.choose
  isImmersion i := (exists_isImmersion_range_eq_of_isLocallyClosed
    (T.isLocallyClosed_stratum i)).choose_spec.choose_spec.1
  range_immersion i := (exists_isImmersion_range_eq_of_isLocallyClosed
    (T.isLocallyClosed_stratum i)).choose_spec.choose_spec.2

/-- **Scheme stratifications of an affine scheme descend to a finite stage**: every
stratification of `Spec A` is, stratum by stratum, the preimage of the strata of a scheme
stratification of `Spec A₁` for the subring `A₁ ⊆ A` generated by a finite set. -/
theorem exists_finset_schemeStratification {A : Type u} [CommRing A]
    (S : Topology.Stratification (PrimeSpectrum A)) :
    ∃ (F : Finset A) (T : Scheme.Stratification (Spec (.of (Algebra.adjoin ℤ (F : Set A)))))
      (e : Fin T.n ≃ Fin S.n), ∀ i,
        PrimeSpectrum.comap (Algebra.adjoin ℤ (F : Set A)).val.toRingHom ⁻¹' T.stratum i =
          S.stratum (e i) := by
  obtain ⟨F, T, e, h⟩ := exists_finset_stratification S
  exact ⟨F, Scheme.Stratification.ofAffine T, e, h⟩

/-- **Constructible sheaves on an affine scheme are trivialised on strata coming from a finite
stage.** For a constructible sheaf `C` on `Spec A`, there is a scheme stratification `T` of
`Spec A₁`, for a subring `A₁ ⊆ A` generated by a finite set, such that the pullback of `C` to
each stratum of the pullback of `T` to `Spec A` is finite locally constant: the strata agree with
those of a stratification witnessing constructibility, and finite local constancy on a stratum
does not depend on its scheme structure. -/
theorem Scheme.IsConstructibleSheaf.exists_finset_stratification_pullback {A : Type u}
    [CommRing A] {Λ : Type (u + 1)} [Ring Λ]
    (C : Sheaf (Spec (.of A)).smallEtaleTopology (ModuleCat.{u + 1} Λ))
    [Scheme.IsConstructibleSheaf C] :
    ∃ (F : Finset A) (T : Scheme.Stratification (Spec (.of (Algebra.adjoin ℤ (F : Set A))))),
      ∀ i, Scheme.IsFiniteLocallyConstantSheaf ((Etale.upperStar _
        ((T.pullback (Spec.map (CommRingCat.ofHom
          (Algebra.adjoin ℤ (F : Set A)).val.toRingHom))).immersion i)).obj C) := by
  obtain ⟨S, hS⟩ := ‹Scheme.IsConstructibleSheaf C›.exists_stratification
  obtain ⟨F, T, e, h⟩ := exists_finset_schemeStratification S.toStratification
  refine ⟨F, T, fun i ↦ ?_⟩
  have hC := hS (e i)
  have := S.isImmersion (e i)
  refine (Scheme.isFiniteLocallyConstantSheaf_upperStar_iff_of_range_eq (S.immersion (e i)) _
    ?_ C).1 hC
  rw [S.range_immersion, (T.pullback _).range_immersion]
  exact (h i).symm

end AlgebraicGeometry
