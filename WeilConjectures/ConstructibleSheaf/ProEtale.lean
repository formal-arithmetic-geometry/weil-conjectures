module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import WeilConjectures.ConstructibleSheaf.Defs

/-!
# Constructible sheaves on the small pro-étale site

This is the pro-étale counterpart of `WeilConjectures.ConstructibleSheaf.Etale`, for
mathlib's pro-étale site `AlgebraicGeometry.Scheme.ProEt.topology`: the topology on the
category `X.ProEt` of weakly étale schemes over `X` whose covers are the pro-étale covers
of [Bhatt–Scholze, Definition 4.1.1], that is, the fpqc covers by weakly étale morphisms.

It is *not* an instance of the `P`, `Q` framework of
`WeilConjectures.ConstructibleSheaf.Defs`: the pro-étale topology is generated by
`AlgebraicGeometry.proetalePrecoverage`, which imposes a quasi-compactness condition on
covers, whereas `X.smallGrothendieckTopology @WeaklyEtale (Q := @WeaklyEtale)` is
generated by all jointly surjective families of weakly étale morphisms. The two topologies
live on the same category. Unifying them is left for later; the definitions below are the
literal transcriptions of the étale ones.

## Main definitions

- `AlgebraicGeometry.ProEtale.pointProEtale`: the point of the small pro-étale site
  attached to a geometric point, with fiber functor `V ↦ Hom_X(Spec Ω, V)`. Its three
  axioms are sorried; the substantive one is joint surjectivity on fibers, which is the
  lifting property of weakly étale morphisms against a separably closed field, the
  analogue of `AlgebraicGeometry.Scheme.exists_fac_of_etale_of_isSepClosed`.
- `AlgebraicGeometry.ProEtale.upperStar`: the pullback of pro-étale sheaves along an
  arbitrary morphism of schemes, needed to restrict a sheaf to a stratum. Unlike the
  pushforward it needs no continuity of the base change functor, only sheafification and
  the left Kan extensions of
  `CategoryTheory.GrothendieckTopology.hasLeftKanExtension_op_overPullback`, which are
  stated for the base change functor and so are independent of the topology.
- `AlgebraicGeometry.ProEtale.IsLocallyConstantSheaf`,
  `AlgebraicGeometry.ProEtale.IsFiniteSheaf`,
  `AlgebraicGeometry.ProEtale.IsFiniteLocallyConstantSheaf` and
  `AlgebraicGeometry.ProEtale.IsConstructibleSheaf`.
-/

@[expose] public section

universe u u'

open CategoryTheory Limits Opposite

noncomputable section

namespace AlgebraicGeometry

/-- The members of a pro-étale cover are weakly étale. -/
lemma Scheme.Cover.weaklyEtale_map {X : Scheme.{u}}
    (𝒰 : X.Cover Scheme.proetalePrecoverage) (i : 𝒰.I₀) : WeaklyEtale (𝒰.f i) :=
  Scheme.proetalePrecoverage_le_precoverage_weaklyEtale _ 𝒰.mem₀ ⟨i⟩

namespace ProEtale

variable {X : Scheme.{u}}

/-- The object of the small pro-étale site of `X` given by a member of a pro-étale cover
of `X`. -/
abbrev Cover.toProEt (𝒰 : X.Cover Scheme.proetalePrecoverage) (i : 𝒰.I₀) : X.ProEt :=
  MorphismProperty.Over.mk ⊤ (𝒰.f i) (𝒰.weaklyEtale_map i)

section Point

/-- The point of the small pro-étale site of `X` attached to a geometric point
`s : Spec Ω ⟶ X` with `Ω` separably closed: its fiber functor sends a weakly étale
`V ⟶ X` to the set of `X`-morphisms `Spec Ω ⟶ V`. This is the pro-étale analogue of
`AlgebraicGeometry.Scheme.pointSmallEtale`. -/
def pointProEtale {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ X) :
    (Scheme.ProEt.topology X).Point where
  fiber := Scheme.ProEt.forget X ⋙ coyoneda.obj (op (Over.mk s))
  isCofiltered := sorry
  initiallySmall := sorry
  jointly_surjective := sorry

end Point

section UpperStar

variable (A : Type u') [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
variable {W U : Scheme.{u}}

/-- The pullback `g^*` of pro-étale sheaves along an arbitrary morphism `g : W ⟶ U`: left
Kan extension along the opposite of base change, followed by sheafification. -/
def upperStar (g : W ⟶ U) :
    Sheaf (Scheme.ProEt.topology U) A ⥤ Sheaf (Scheme.ProEt.topology W) A :=
  Functor.sheafPullbackConstruction.sheafPullback
    (MorphismProperty.Over.pullback @WeaklyEtale ⊤ g) A
    (Scheme.ProEt.topology U) (Scheme.ProEt.topology W)

end UpperStar

section LocallyConstant

variable {A : Type u'} [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]

/-- The datum of a trivialization of a sheaf `F` on the small pro-étale site of `X`: a
pro-étale cover of `X` such that the restriction of `F` to the site localized at each
member of the cover is constant in the sense of `CategoryTheory.Sheaf.IsConstant`. -/
structure LocallyConstantDatum (F : Sheaf (Scheme.ProEt.topology X) A) where
  /-- The trivializing pro-étale cover. -/
  cover : X.Cover Scheme.proetalePrecoverage
  /-- The restriction of `F` to the site localized at each member of the cover is
  constant. -/
  isConstant (i : cover.I₀) : (F.over (Cover.toProEt cover i)).IsConstant
    ((Scheme.ProEt.topology X).over (Cover.toProEt cover i))

/-- A sheaf on the small pro-étale site of `X` is *locally constant* if there is a
pro-étale cover of `X` trivializing it. -/
class IsLocallyConstantSheaf (F : Sheaf (Scheme.ProEt.topology X) A) : Prop where
  nonempty_locallyConstantDatum : Nonempty (LocallyConstantDatum F)

end LocallyConstant

section FiniteSheaf

variable {A : Type u'} [Category.{u + 1} A]
  {FA : A → A → Type (u + 1)} {CA : A → Type (u + 1)}
  [∀ X Y, FunLike (FA X Y) (CA X) (CA Y)] [ConcreteCategory.{u + 1} A FA]
  [HasColimitsOfSize.{u, u} A]

/-- A sheaf on the small pro-étale site of `X` with values in a concrete category is
*finite* if its stalk at every geometric point of `X` is finite. -/
class IsFiniteSheaf (F : Sheaf (Scheme.ProEt.topology X) A) : Prop where
  finite_sheafFiber (Ω : Type u) [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ X) :
    Finite (ToType ((pointProEtale s).sheafFiber.obj F))

end FiniteSheaf

section Constructible

variable {A : Type u'} [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
  {FA : A → A → Type (u + 1)} {CA : A → Type (u + 1)}
  [∀ X Y, FunLike (FA X Y) (CA X) (CA Y)] [ConcreteCategory.{u + 1} A FA]

/-- A sheaf on the small pro-étale site of `X` with values in a concrete category is
*finite locally constant* if it is locally constant and finite. -/
class IsFiniteLocallyConstantSheaf (F : Sheaf (Scheme.ProEt.topology X) A) : Prop
    extends IsLocallyConstantSheaf F, IsFiniteSheaf F

/-- A sheaf on the small pro-étale site of `X` with values in a concrete category is
*constructible* if there is a stratification of `X` such that the pullback of the sheaf to
each stratum is finite locally constant. -/
class IsConstructibleSheaf (F : Sheaf (Scheme.ProEt.topology X) A) : Prop where
  exists_stratification : ∃ S : Scheme.Stratification X, ∀ i : Fin S.n,
    IsFiniteLocallyConstantSheaf ((upperStar A (S.immersion i)).obj F)

end Constructible

end ProEtale

end AlgebraicGeometry
