public import Mathlib.LinearAlgebra.Eigenspace.Triangularizable
public import WeilConjectures.Mathlib.RepresentationTheory.Semisimple

/-!
# Geometrically irreducible constituents after a constant extension

Let `ρ` be a finite-dimensional representation of a group `G` over an algebraically closed field
`k`, let `N ⊴ G` be a normal subgroup on which `ρ` restricts semisimply and let `φ ∈ G`. In the
application `G` is the Weil group of a geometrically connected curve over a finite field, `N` is
the geometric fundamental group and `φ` is a Frobenius lift, so that the subgroup
`N ⊔ zpowers (φ ^ m)` is the Weil group after the constant extension of degree `m`.

We show that for a suitable `m > 0`, every irreducible subrepresentation of the restriction of
`ρ` to `N ⊔ zpowers (φ ^ m)` stays irreducible on `N`. The proof is Clifford theory:

* translation by `ρ g` permutes the isomorphism classes of `N`-irreducible subrepresentations,
  and there are finitely many of them, so some power `φ ^ m` fixes all of them;
* if `W` is irreducible under `N ⊔ zpowers ψ` and `S ⊆ W` is `N`-irreducible with
  `ρ ψ S ≅ S`, then `f ↦ ρ ψ ∘ f ∘ T` is an invertible operator on `Hom_N(S, W)`, where `T` is
  the twisted automorphism of `S` given by the isomorphism; an eigenvector `f` has image stable
  under `N` and `ψ`, hence equal to `W`, and `f : S ≃ W` shows that `W` is `N`-irreducible.

## Main statements

* `Representation.exists_pos_forall_isIrreducible_comp_inclusion`: the core statement.
* `Representation.exists_pos_iSupIndep_isIrreducible_comp_inclusion`: a semisimple
  representation is, after replacing `φ` by a power, a direct sum of subrepresentations of
  `N ⊔ zpowers (φ ^ m)` which are irreducible under `N`.

## Blueprint

`lem-a1-geometric-constituent-reduction`, at the level of representations of the Weil group.
-/

@[expose] public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- If `G ⧸ N` is cyclic, generated by the image of `g`, then every subgroup containing the
normal subgroup `N` is normal. -/
theorem Normal.normal_of_le_of_sup_zpowers_eq_top {N K : Subgroup G} (hN : N.Normal) {g : G}
    (hg : N ⊔ zpowers g = ⊤) (hK : N ≤ K) : K.Normal := by
  have hpow (x : G) : ∃ n : ℤ, (x : G ⧸ N) = ((g ^ n : G) : G ⧸ N) := by
    obtain ⟨y, hy, z, hz, rfl⟩ := mem_sup_of_normal_left.1 (hg ▸ mem_top x)
    obtain ⟨n, rfl⟩ := mem_zpowers_iff.1 hz
    refine ⟨n, QuotientGroup.eq.2 ?_⟩
    simpa [mul_assoc] using hN.conj_mem' _ (N.inv_mem hy) (g ^ n)
  refine ⟨fun x hx y ↦ ?_⟩
  obtain ⟨a, ha⟩ := hpow y
  obtain ⟨b, hb⟩ := hpow x
  have h : ((y * x * y⁻¹ : G) : G ⧸ N) = (x : G ⧸ N) := by
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv, ha, hb,
      QuotientGroup.mk_zpow, QuotientGroup.mk_zpow, ((Commute.refl _).zpow_zpow a b).eq,
      mul_inv_cancel_right]
  have hmem : x⁻¹ * (y * x * y⁻¹) ∈ K := hK (QuotientGroup.eq.1 h.symm)
  simpa using K.mul_mem hx hmem

end Subgroup

namespace Representation

variable {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]

/-- The elements of `G` under which a subspace `U` is stable, in the sense that `ρ g v ∈ U` if
and only if `v ∈ U`, form a subgroup. -/
def stabilizer (ρ : Representation k G V) (U : Submodule k V) : Subgroup G where
  carrier := {g | ∀ v, ρ g v ∈ U ↔ v ∈ U}
  mul_mem' {g h} hg hh v := by
    rw [map_mul, Module.End.mul_apply, hg, hh]
  one_mem' v := by
    rw [map_one, Module.End.one_apply]
  inv_mem' {g} hg v := by
    rw [← hg, self_inv_apply]

/-- Membership in `Representation.stabilizer`. -/
theorem mem_stabilizer_iff {ρ : Representation k G V} {U : Submodule k V} {g : G} :
    g ∈ ρ.stabilizer U ↔ ∀ v, ρ g v ∈ U ↔ v ∈ U :=
  Iff.rfl

/-- An element `g` such that `U` is stable under `ρ g` and `ρ g⁻¹` lies in the stabilizer
of `U`. -/
theorem mem_stabilizer_of_forall_mem {ρ : Representation k G V} {U : Submodule k V} {g : G}
    (h₁ : ∀ v ∈ U, ρ g v ∈ U) (h₂ : ∀ v ∈ U, ρ g⁻¹ v ∈ U) : g ∈ ρ.stabilizer U :=
  fun v ↦ ⟨fun hv ↦ by simpa using h₂ _ hv, h₁ v⟩

end Representation

namespace Subrepresentation

variable {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]

/-- The action on a subrepresentation is the restricted action. -/
@[simp]
theorem coe_toRepresentation_apply {ρ : Representation k G V} (U : Subrepresentation ρ) (g : G)
    (x : U.toSubmodule) : (U.toRepresentation g x : V) = ρ g x :=
  rfl

section Translate

variable {ρ : Representation k G V} {N : Subgroup G} [N.Normal]

/-- Translating by `h` and then by `g` is translating by `g * h`. -/
theorem translate_translate (g h : G) (U : Subrepresentation (ρ.comp N.subtype)) :
    translate ρ N g (translate ρ N h U) = translate ρ N (g * h) U :=
  SetLike.ext fun v ↦ by
    rw [mem_translate, mem_translate, mem_translate, mul_inv_rev, map_mul, Module.End.mul_apply]

/-- Translating by `1` is the identity. -/
theorem translate_one (U : Subrepresentation (ρ.comp N.subtype)) : translate ρ N 1 U = U :=
  SetLike.ext fun v ↦ by rw [mem_translate, inv_one, map_one, Module.End.one_apply]

/-- The linear isomorphism `ρ g : U ≃ ρ g U` onto the translate of a subrepresentation of the
restriction of `ρ` to a normal subgroup. -/
noncomputable def translateLinearEquiv (g : G) (U : Subrepresentation (ρ.comp N.subtype)) :
    U.toSubmodule ≃ₗ[k] (translate ρ N g U).toSubmodule :=
  (LinearEquiv.ofLinearMap (ρ g) (ρ g⁻¹) (LinearMap.ext (ρ.self_inv_apply g))
    (LinearMap.ext (ρ.inv_self_apply g))).ofSubmodules _ _ rfl

/-- `translateLinearEquiv g U` is given by `ρ g`. -/
@[simp]
theorem coe_translateLinearEquiv_apply (g : G) (U : Subrepresentation (ρ.comp N.subtype))
    (x : U.toSubmodule) : (translateLinearEquiv g U x : V) = ρ g x :=
  rfl

/-- The inverse of `translateLinearEquiv g U` is given by `ρ g⁻¹`. -/
@[simp]
theorem coe_translateLinearEquiv_symm_apply (g : G) (U : Subrepresentation (ρ.comp N.subtype))
    (x : (translate ρ N g U).toSubmodule) : ((translateLinearEquiv g U).symm x : V) = ρ g⁻¹ x :=
  rfl

/-- Translation by `g` carries an equivalence between subrepresentations of the restriction of
`ρ` to a normal subgroup `N` to an equivalence between their translates. -/
noncomputable def translateEquiv (g : G) {X Y : Subrepresentation (ρ.comp N.subtype)}
    (e : X.toRepresentation.Equiv Y.toRepresentation) :
    (translate ρ N g X).toRepresentation.Equiv (translate ρ N g Y).toRepresentation :=
  .mk ((translateLinearEquiv g X).symm ≪≫ₗ e.toLinearEquiv ≪≫ₗ translateLinearEquiv g Y)
    fun n ↦ LinearMap.ext fun x ↦ by
      have hn : g⁻¹ * n * g ∈ N := by simpa using ‹N.Normal›.conj_mem _ n.2 g⁻¹
      have hx : (translateLinearEquiv g X).symm ((translate ρ N g X).toRepresentation n x) =
          X.toRepresentation ⟨_, hn⟩ ((translateLinearEquiv g X).symm x) := by
        ext
        simp only [coe_translateLinearEquiv_symm_apply, coe_toRepresentation_apply,
          MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype]
        rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
        simp [mul_assoc]
      ext
      simp only [LinearEquiv.coe_coe, LinearEquiv.trans_apply, LinearMap.coe_comp,
        Function.comp_apply, hx, Representation.Equiv.toLinearEquiv_apply,
        Representation.Equiv.coe_toIntertwiningMap, Representation.Equiv.apply_apply,
        coe_translateLinearEquiv_apply, coe_toRepresentation_apply, MonoidHom.coe_comp,
        Subgroup.coe_subtype]
      rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
      simp [mul_assoc]

end Translate

/-- In a semisimple representation which is the join of a set `s` of irreducible
subrepresentations, every irreducible subrepresentation is equivalent to a member of `s`. -/
theorem exists_mem_nonempty_equiv_of_sSup_eq_top {ρ : Representation k G V}
    [Representation.IsSemisimpleRepresentation ρ] {s : Set (Subrepresentation ρ)}
    (hs : ∀ S ∈ s, IsAtom S)
    (htop : sSup s = ⊤) {T : Subrepresentation ρ} (hT : IsAtom T) :
    ∃ S ∈ s, Nonempty (S.toRepresentation.Equiv T.toRepresentation) := by
  obtain ⟨C, hC⟩ := exists_isCompl T
  have hC' : IsCompl T.toSubmodule C.toSubmodule :=
    ⟨disjoint_toSubmodule_iff.2 hC.1, codisjoint_iff.2 (by
      rw [← toSubmodule_sup, hC.sup_eq_top, toSubmodule_top])⟩
  let p := T.toSubmodule.projectionOnto C.toSubmodule hC'
  have hp (g : G) (v : V) : p (ρ g v) = T.toRepresentation g (p v) := by
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 (hC'.sup_eq_top ▸ Submodule.mem_top (x := v))
    simp only [p, map_add]
    rw [Submodule.projectionOnto_apply_of_mem_left hC' ha,
      Submodule.projectionOnto_apply_of_mem_left hC' (T.apply_mem_toSubmodule g ha),
      Submodule.projectionOnto_apply_of_mem_right hC' hb,
      Submodule.projectionOnto_apply_of_mem_right hC' (C.apply_mem_toSubmodule g hb), add_zero,
      map_zero,
      add_zero]
    rfl
  have : T.toRepresentation.IsIrreducible := isIrreducible_toRepresentation_iff_isAtom.2 hT
  by_contra! h
  have hS (S : Subrepresentation ρ) (hSs : S ∈ s) : S.toSubmodule ≤ LinearMap.ker p := by
    have : S.toRepresentation.IsIrreducible :=
      isIrreducible_toRepresentation_iff_isAtom.2 (hs S hSs)
    let f : Representation.IntertwiningMap S.toRepresentation T.toRepresentation :=
      ⟨p ∘ₗ S.toSubmodule.subtype, fun g ↦ LinearMap.ext fun x ↦ hp g x⟩
    rcases Representation.IsIrreducible.bijective_or_eq_zero f with hf | hf
    · exact ((h S hSs).false (f.ofBijective hf)).elim
    · intro x hx
      exact DFunLike.congr_fun hf ⟨x, hx⟩
  obtain ⟨t, ht, ht0⟩ :=
    T.toSubmodule.exists_mem_ne_zero_of_ne_bot fun h0 ↦ hT.1 (toSubmodule_injective h0)
  have htop' : ⊤ ≤ LinearMap.ker p := by
    rw [← toSubmodule_top (ρ := ρ), ← htop, toSubmodule_sSup]
    exact iSup₂_le hS
  have hpt := htop' (Submodule.mem_top (x := t))
  rw [LinearMap.mem_ker, Submodule.projectionOnto_apply_of_mem_left hC' ht] at hpt
  exact ht0 congr(($hpt : V))

/-- Pigeonhole step of Clifford theory: if `ρ` restricts semisimply to a normal subgroup `N`,
then for every `φ ∈ G` some positive power `φ ^ m` maps every irreducible subrepresentation of
the restriction to `N` to an equivalent one. -/
theorem exists_pos_forall_isAtom_nonempty_equiv_translate [FiniteDimensional k V]
    (ρ : Representation k G V) (N : Subgroup G) [N.Normal]
    [Representation.IsSemisimpleRepresentation (ρ.comp N.subtype)] (φ : G) :
    ∃ m > 0, ∀ S : Subrepresentation (ρ.comp N.subtype), IsAtom S →
      Nonempty (S.toRepresentation.Equiv (translate ρ N (φ ^ m) S).toRepresentation) := by
  obtain ⟨s, hind, htop, hat⟩ := exists_sSupIndep_of_sSup_atoms_eq_top
    (sSup_atoms_eq_top (α := Subrepresentation (ρ.comp N.subtype)))
  have : Finite s := (WellFoundedGT.finite_of_sSupIndep hind).to_subtype
  have hat' (n : ℕ) (i : s) : IsAtom (translate ρ N (φ ^ n) i) :=
    ((translate ρ N _).isAtom_iff _).2 (hat i.2)
  choose c hc he using fun (n : ℕ) (i : s) ↦
    exists_mem_nonempty_equiv_of_sSup_eq_top hat htop (hat' n i)
  let c' (n : ℕ) (i : s) : s := ⟨c n i, hc n i⟩
  obtain ⟨a, b, hab, hcab⟩ : ∃ a b, a < b ∧ c' a = c' b := by
    obtain ⟨a, b, hne, h⟩ := Finite.exists_ne_map_eq_of_infinite c'
    rcases hne.lt_or_gt with h' | h'
    · exact ⟨a, b, h', h⟩
    · exact ⟨b, a, h', h.symm⟩
  have hφ : (φ ^ a)⁻¹ * φ ^ b = φ ^ (b - a) := by
    rw [inv_mul_eq_iff_eq_mul, pow_mul_pow_sub _ hab.le]
  have hs (i : s) : Nonempty ((i : Subrepresentation (ρ.comp N.subtype)).toRepresentation.Equiv
      (translate ρ N (φ ^ (b - a)) i).toRepresentation) := by
    have hci : c a i = c b i := congr(($hcab i : Subrepresentation (ρ.comp N.subtype)))
    obtain ⟨e₁⟩ := he a i
    obtain ⟨e₂⟩ := he b i
    rw [hci] at e₁
    have e := translateEquiv (φ ^ a)⁻¹ (e₁.symm.trans e₂)
    rw [translate_translate, translate_translate, inv_mul_cancel, translate_one, hφ] at e
    exact ⟨e⟩
  refine ⟨b - a, Nat.sub_pos_of_lt hab, fun S hS ↦ ?_⟩
  obtain ⟨j, hj, ⟨e⟩⟩ := exists_mem_nonempty_equiv_of_sSup_eq_top hat htop hS
  obtain ⟨e'⟩ := hs ⟨j, hj⟩
  exact ⟨e.symm.trans (e'.trans (translateEquiv _ e))⟩

/-- **Clifford theory, eigenvector step.** Let `W` be an irreducible subrepresentation of the
restriction of `ρ` to `N ⊔ zpowers ψ`, and let `S ⊆ W` be an irreducible subrepresentation of
the restriction to `N` whose translate `ρ ψ S` is equivalent to `S`. Then `W` is irreducible
under `N`. -/
theorem isIrreducible_comp_inclusion_of_equiv_translate [IsAlgClosed k]
    [FiniteDimensional k V] {ρ : Representation k G V} {N : Subgroup G} [N.Normal] {ψ : G}
    {W : Subrepresentation (ρ.comp (N ⊔ Subgroup.zpowers ψ).subtype)}
    (hW : W.toRepresentation.IsIrreducible) {S : Subrepresentation (ρ.comp N.subtype)}
    (hS : IsAtom S) (hSW : S.toSubmodule ≤ W.toSubmodule)
    (e : S.toRepresentation.Equiv (translate ρ N ψ S).toRepresentation) :
    Representation.IsIrreducible
      (W.toRepresentation.comp (Subgroup.inclusion le_sup_left)) := by
  let H := N ⊔ Subgroup.zpowers ψ
  let σ := W.toRepresentation.comp (Subgroup.inclusion (le_sup_left : N ≤ H))
  have : S.toRepresentation.IsIrreducible := isIrreducible_toRepresentation_iff_isAtom.2 hS
  let ψ' : H := ⟨ψ, Subgroup.mem_sup_right (Subgroup.mem_zpowers ψ)⟩
  -- The automorphism `T = ρ ψ⁻¹ ∘ e` of `S`, twisting the action by conjugation by `ψ`.
  let T : S.toSubmodule →ₗ[k] S.toSubmodule :=
    (translateLinearEquiv ψ S).symm.toLinearMap ∘ₗ e.toLinearMap
  have hTsurj : Function.Surjective T :=
    (translateLinearEquiv ψ S).symm.surjective.comp e.toLinearEquiv.surjective
  let conj (n : N) : N := ⟨ψ⁻¹ * n * ψ, by simpa using ‹N.Normal›.conj_mem _ n.2 ψ⁻¹⟩
  have hT (n : N) (x : S.toSubmodule) :
      T (S.toRepresentation n x) = S.toRepresentation (conj n) (T x) := by
    ext
    simp only [T, LinearMap.comp_apply, LinearEquiv.coe_coe, coe_translateLinearEquiv_symm_apply,
      Representation.Equiv.coe_toLinearMap, Representation.Equiv.apply_apply,
      coe_toRepresentation_apply, MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype,
      conj]
    rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
    simp [mul_assoc]
  -- The operator `f ↦ ρ ψ ∘ f ∘ T` on `Hom_N(S, W)`.
  let Φ : Module.End k (Representation.IntertwiningMap S.toRepresentation σ) :=
    { toFun f := ⟨W.toRepresentation ψ' ∘ₗ f.toLinearMap ∘ₗ T, fun n ↦ LinearMap.ext fun x ↦ by
        simp only [LinearMap.comp_apply]
        rw [hT, Representation.IntertwiningMap.toLinearMap_apply,
          Representation.IntertwiningMap.isIntertwining _ _ f]
        ext
        simp only [σ, coe_toRepresentation_apply, MonoidHom.coe_comp, Function.comp_apply,
          Subgroup.coe_subtype, Subgroup.coe_inclusion, conj, ψ']
        rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
        simp [mul_assoc]⟩
      map_add' f g := by
        ext
        simp
      map_smul' c f := by
        ext
        simp }
  let ι : Representation.IntertwiningMap S.toRepresentation σ →ₗ[k]
      (S.toSubmodule →ₗ[k] W.toSubmodule) :=
    { toFun f := f.toLinearMap
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }
  have : FiniteDimensional k (Representation.IntertwiningMap S.toRepresentation σ) :=
    Module.Finite.of_injective ι fun f g h ↦ Representation.IntertwiningMap.ext h
  have : Nontrivial (Representation.IntertwiningMap S.toRepresentation σ) := by
    obtain ⟨x, hx, hx0⟩ :=
      S.toSubmodule.exists_mem_ne_zero_of_ne_bot fun h0 ↦ hS.1 (toSubmodule_injective h0)
    refine nontrivial_of_ne ⟨Submodule.inclusion hSW, fun n ↦ rfl⟩ 0 fun h0 ↦ hx0 ?_
    simpa using congrArg Subtype.val (DFunLike.congr_fun h0 ⟨x, hx⟩)
  obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue Φ
  obtain ⟨f, hf⟩ := hc.exists_hasEigenvector
  have hΦf (x : S.toSubmodule) :
      W.toRepresentation ψ' (f.toLinearMap (T x)) = c • f.toLinearMap x :=
    DFunLike.congr_fun hf.apply_eq_smul x
  have hc0 : c ≠ 0 := by
    rintro rfl
    refine hf.2 (Representation.IntertwiningMap.ext (LinearMap.ext fun y ↦ ?_))
    obtain ⟨x, rfl⟩ := hTsurj y
    rw [← W.toRepresentation.inv_self_apply ψ' (f.toLinearMap (T x))]
    exact (congrArg (W.toRepresentation ψ'⁻¹) ((hΦf x).trans (zero_smul k _))).trans (map_zero _)
  -- The image of `f` is stable under `N` and `ψ`, hence under `H`.
  let U := LinearMap.range f.toLinearMap
  have hle : H ≤ (W.toRepresentation.stabilizer U).map H.subtype := by
    refine sup_le (fun n hn ↦ ⟨⟨n, le_sup_left (a := N) hn⟩, ?_, rfl⟩)
      ((Subgroup.zpowers_le).2 ⟨ψ', ?_, rfl⟩)
    · refine Representation.mem_stabilizer_of_forall_mem ?_ ?_
      · rintro _ ⟨x, rfl⟩
        exact ⟨S.toRepresentation ⟨n, hn⟩ x,
          Representation.IntertwiningMap.isIntertwining _ _ f _ _⟩
      · rintro _ ⟨x, rfl⟩
        exact ⟨S.toRepresentation ⟨n, hn⟩⁻¹ x,
          Representation.IntertwiningMap.isIntertwining _ _ f _ _⟩
    · refine Representation.mem_stabilizer_of_forall_mem ?_ ?_
      · rintro _ ⟨x, rfl⟩
        obtain ⟨y, rfl⟩ := hTsurj x
        exact ⟨c • y, (map_smul f.toLinearMap c y).trans (hΦf y).symm⟩
      · rintro _ ⟨x, rfl⟩
        refine ⟨c⁻¹ • T x, ?_⟩
        rw [map_smul]
        refine (inv_smul_eq_iff₀ hc0).2 ?_
        rw [← map_smul, ← hΦf, Representation.inv_self_apply]
  have hmem (h : H) (y : W.toSubmodule) : W.toRepresentation h y ∈ U ↔ y ∈ U := by
    obtain ⟨h', hh', hh'h⟩ := hle h.2
    obtain rfl : h' = h := Subtype.ext hh'h
    exact hh' y
  let U' : Subrepresentation W.toRepresentation := ⟨U, fun h y hy ↦ (hmem h y).2 hy⟩
  have hU' : U' = ⊤ := (hW.eq_bot_or_eq_top U').resolve_left fun h0 ↦ hf.2
    (Representation.IntertwiningMap.ext (LinearMap.range_eq_bot.1 congr(($h0).toSubmodule)))
  have hsurj : Function.Surjective f := fun y ↦ by
    have hy : y ∈ U' := by
      rw [hU']
      trivial
    exact LinearMap.mem_range.1 hy
  have hinj : Function.Injective f :=
    (Representation.IsIrreducible.injective_or_eq_zero f).resolve_right hf.2
  exact (f.ofBijective ⟨hinj, hsurj⟩).isIrreducible_iff.1 ‹_›

end Subrepresentation

namespace Representation

variable {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]

/-- **Geometrically irreducible constituents after a constant extension.** Let `ρ` be a
finite-dimensional representation over an algebraically closed field which restricts semisimply
to a normal subgroup `N`, and let `φ ∈ G`. For some `m > 0`, every irreducible subrepresentation
of the restriction of `ρ` to `N ⊔ zpowers (φ ^ m)` stays irreducible under `N`.
(blueprint: `lem-a1-geometric-constituent-reduction`) -/
theorem exists_pos_forall_isIrreducible_comp_inclusion [IsAlgClosed k] [FiniteDimensional k V]
    (ρ : Representation k G V) (N : Subgroup G) [N.Normal]
    [Representation.IsSemisimpleRepresentation (ρ.comp N.subtype)] (φ : G) :
    ∃ m > 0, ∀ W : Subrepresentation (ρ.comp (N ⊔ Subgroup.zpowers (φ ^ m)).subtype),
      W.toRepresentation.IsIrreducible →
        IsIrreducible (W.toRepresentation.comp (Subgroup.inclusion le_sup_left)) := by
  obtain ⟨m, hm, hS⟩ := Subrepresentation.exists_pos_forall_isAtom_nonempty_equiv_translate ρ N φ
  refine ⟨m, hm, fun W hW ↦ ?_⟩
  let W' : Subrepresentation (ρ.comp N.subtype) :=
    ⟨W.toSubmodule, fun n _ hv ↦ W.apply_mem_toSubmodule (Subgroup.inclusion le_sup_left n) hv⟩
  have hW' : W' ≠ ⊥ := fun h ↦ by
    have := hW.nontrivial
    exact Submodule.nontrivial_iff_ne_bot.1 this congr(($h).toSubmodule)
  have : IsAtomic (Subrepresentation (ρ.comp N.subtype)) :=
    isAtomic_of_orderBot_wellFounded_lt wellFounded_lt
  obtain ⟨S, hS', hSW⟩ := (eq_bot_or_exists_atom_le W').resolve_left hW'
  obtain ⟨e⟩ := hS S hS'
  exact Subrepresentation.isIrreducible_comp_inclusion_of_equiv_translate hW hS' hSW e

/-- **Geometrically irreducible constituents after a constant extension**, decomposition form.
Let `ρ` be a finite-dimensional semisimple representation over an algebraically closed field,
`N` a normal subgroup and `φ ∈ G` such that `G ⧸ N` is generated by the image of `φ`. For some
`m > 0`, the restriction of `ρ` to `N ⊔ zpowers (φ ^ m)` is a direct sum of subrepresentations
which are irreducible under `N`.
(blueprint: `lem-a1-geometric-constituent-reduction`) -/
theorem exists_pos_iSupIndep_isIrreducible_comp_inclusion [IsAlgClosed k]
    [FiniteDimensional k V] (ρ : Representation k G V) [IsSemisimpleRepresentation ρ]
    (N : Subgroup G) [N.Normal] {φ : G} (hφ : N ⊔ Subgroup.zpowers φ = ⊤) :
    ∃ m > 0, ∃ s : Set (Subrepresentation (ρ.comp (N ⊔ Subgroup.zpowers (φ ^ m)).subtype)),
      (∀ U ∈ s, IsIrreducible (U.toRepresentation.comp (Subgroup.inclusion le_sup_left))) ∧
        iSupIndep (fun U : s ↦ U.1.toSubmodule) ∧ ⨆ U : s, U.1.toSubmodule = ⊤ := by
  obtain ⟨m, hm, h⟩ := exists_pos_forall_isIrreducible_comp_inclusion ρ N φ
  have : (N ⊔ Subgroup.zpowers (φ ^ m)).Normal :=
    ‹N.Normal›.normal_of_le_of_sup_zpowers_eq_top hφ le_sup_left
  obtain ⟨s, hirr, hind, htop⟩ := isSemisimpleRepresentation_iff_exists_iSupIndep.1
    (inferInstance : IsSemisimpleRepresentation (ρ.comp (N ⊔ Subgroup.zpowers (φ ^ m)).subtype))
  exact ⟨m, hm, s, fun U hU ↦ h U (hirr U hU), hind, htop⟩

end Representation
