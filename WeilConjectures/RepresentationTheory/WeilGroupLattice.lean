namespace Module.Basis

variable {K Ω V ι : Type*} [Field K] [Field Ω] [Algebra K Ω] [AddCommGroup V] [Module Ω V]
  [Fintype ι]

/-- The vector of `V` with coordinates (in the basis `b`) in a subalgebra `A` of the scalars. -/
noncomputable def ofSubalgebraCoord (b : Basis ι Ω V) (A : Subalgebra K Ω) :
    (ι → A) →+ V where
  toFun x := b.equivFun.symm fun i ↦ (x i : Ω)
  map_zero' := by simp
  map_add' x y := by
    rw [← map_add]
    rfl

end Module.Basis

/-! ### Automorphisms defined over a subalgebra -/

namespace LinearEquiv

open Matrix

variable {K Ω V ι : Type*} [Field K] [Field Ω] [Algebra K Ω] [AddCommGroup V] [Module Ω V]
  [Fintype ι] [DecidableEq ι]

/-- The matrix entries of `F` and `F⁻¹` in the basis `b` lie in the subalgebra `A`. -/
def IsDefinedOver (F : V ≃ₗ[Ω] V) (b : Basis ι Ω V) (A : Subalgebra K Ω) : Prop :=
  ∀ i k, LinearMap.toMatrix b b F.toLinearMap i k ∈ A ∧
    LinearMap.toMatrix b b F.symm.toLinearMap i k ∈ A

theorem isDefinedOver_symm {F : V ≃ₗ[Ω] V} {b : Basis ι Ω V} {A : Subalgebra K Ω}
    (h : F.IsDefinedOver b A) : F.symm.IsDefinedOver b A :=
  fun i k ↦ (h i k).symm

omit [DecidableEq ι] in
theorem _root_.Subalgebra.mul_apply_mem_of_forall_mem {A : Subalgebra K Ω} {P Q : Matrix ι ι Ω}
    (hP : ∀ i k, P i k ∈ A) (hQ : ∀ i k, Q i k ∈ A) (i k : ι) : (P * Q) i k ∈ A :=
  Subalgebra.sum_mem _ fun j _ ↦ mul_mem (hP i j) (hQ j k)

/-- The automorphisms defined over `A` form a subgroup. -/
def definedOverSubgroup (b : Basis ι Ω V) (A : Subalgebra K Ω) : Subgroup (V ≃ₗ[Ω] V) where
  carrier := {F | F.IsDefinedOver b A}
  mul_mem' {F G} hF hG i k := by
    have hsymm : (F * G).symm = G.symm * F.symm := rfl
    rw [hsymm, coe_toLinearMap_mul, coe_toLinearMap_mul, LinearMap.toMatrix_mul,
      LinearMap.toMatrix_mul]
    exact ⟨Subalgebra.mul_apply_mem_of_forall_mem (fun i k ↦ (hF i k).1)
      (fun i k ↦ (hG i k).1) i k, Subalgebra.mul_apply_mem_of_forall_mem (fun i k ↦ (hG i k).2)
      (fun i k ↦ (hF i k).2) i k⟩
  one_mem' i k := by
    have hsymm : (1 : V ≃ₗ[Ω] V).symm = 1 := rfl
    rw [hsymm, coe_toLinearMap_one, LinearMap.toMatrix_id, Matrix.one_apply, and_self]
    split_ifs
    exacts [one_mem A, zero_mem A]
  inv_mem' {F} hF := isDefinedOver_symm hF

theorem mem_definedOverSubgroup {b : Basis ι Ω V} {A : Subalgebra K Ω} {F : V ≃ₗ[Ω] V} :
    F ∈ definedOverSubgroup b A ↔ F.IsDefinedOver b A :=
  Iff.rfl

end LinearEquiv

