/-! ### Compact groups: finite field of definition by Baire category -/

namespace PadicAlgCl

open Polynomial IntermediateField

variable {ℓ : ℕ} [Fact ℓ.Prime]

/-- Every element `x` of `ℚ̄_ℓ` lies in `ℚ_ℓ(y)` for some `y` algebraic over `ℚ`: approximate the
minimal polynomial of `x` by a rational polynomial `g`; by continuity of roots `g` has a root `y`
closer to `x` than all conjugates of `x`, and Krasner's lemma gives `x ∈ ℚ_ℓ(y)`. -/
theorem exists_mem_adjoin_aeval_rat_eq_zero (x : PadicAlgCl ℓ) :
    ∃ g : ℚ[X], g.Monic ∧ ∃ y : PadicAlgCl ℓ, aeval y g = 0 ∧ x ∈ ℚ_[ℓ]⟮y⟯ := by
  classical
  have hx : IsIntegral ℚ_[ℓ] x := Algebra.IsIntegral.isIntegral x
  set f := minpoly ℚ_[ℓ] x
  have fmon : f.Monic := minpoly.monic hx
  have fa0 : aeval x f = 0 := minpoly.aeval ℚ_[ℓ] x
  have fnatdeg0 : f.natDegree ≠ 0 := (minpoly.natDegree_pos hx).ne'
  let S : Finset (PadicAlgCl ℓ) := {x' ∈ (f.rootSet (PadicAlgCl ℓ)).toFinset | x' ≠ x}
  let δ : ℝ := if hS : S.Nonempty then Finset.min' (S.image fun x' ↦ ‖x - x'‖)
      (Finset.image_nonempty.mpr hS) else 1
  have norm_sub_le (x' : PadicAlgCl ℓ) (conj : IsConjRoot ℚ_[ℓ] x x') (ne : x ≠ x') :
      δ ≤ ‖x - x'‖ := by
    have hmem : x' ∈ S := by
      simp only [Finset.mem_filter, Set.mem_toFinset, S]
      exact ⟨(isConjRoot_iff_mem_minpoly_rootSet hx).1 conj, ne.symm⟩
    have hS : S.Nonempty := ⟨x', hmem⟩
    simp only [hS, ↓reduceDIte, δ]
    exact Finset.min'_le _ _ (Finset.mem_image_of_mem _ hmem)
  have δpos : δ > 0 := by
    by_cases hS : S.Nonempty <;> simp only [hS, ↓reduceDIte, δ]
    · simp only [gt_iff_lt, Finset.lt_min'_iff, Finset.mem_image, forall_exists_index, and_imp,
        forall_apply_eq_imp_iff₂]
      rintro x' hx'
      simp only [Finset.mem_filter, Set.mem_toFinset, S] at hx'
      rw [norm_pos_iff, sub_ne_zero]
      exact hx'.2.symm
    · exact one_pos
  have hε : (δ / (max ‖x‖ 1)) ^ f.natDegree / (f.natDegree + 1) > 0 := by positivity
  have hi : DenseRange (algebraMap ℚ ℚ_[ℓ]) := by
    have : ⇑(algebraMap ℚ ℚ_[ℓ]) = ((↑) : ℚ → ℚ_[ℓ]) := funext fun q ↦ by simp
    rw [this]
    exact Padic.denseRange_ratCast ℓ
  obtain ⟨g, gmon, gdeg, gcoeff⟩ :=
    exists_monic_and_natDegree_eq_and_norm_map_algebraMap_coeff_sub_lt hi fmon hε
  obtain ⟨b, hb, hab⟩ := exists_aroots_norm_sub_lt_of_norm_coeff_sub_lt
      hε fa0 fmon (gmon.map _) (gdeg ▸ (g.natDegree_map _)) gcoeff (IsAlgClosed.splits _)
  have hab : ‖x - b‖ < δ := by
    rw [← Real.rpow_natCast, ← mul_comm_div, div_self, one_mul,
        ← Real.rpow_mul (div_pos δpos (by positivity)).le, mul_inv_cancel₀] at hab
    · simpa [mul_assoc, div_mul_cancel₀ _ (by positivity : (max ‖x‖ 1) > 0).ne'] using hab
    · simp [fnatdeg0]
    · positivity
  simp only [Polynomial.mem_roots', ne_eq, Polynomial.map_eq_zero, Polynomial.IsRoot.def,
    Polynomial.eval_map_algebraMap] at hb
  refine ⟨g, gmon, b, ?_, IsKrasner.krasner (minpoly.irreducible hx).separable
    (IsAlgClosed.splits _) (Algebra.IsIntegral.isIntegral b)
    fun x' h1 h2 ↦ lt_of_lt_of_le hab (norm_sub_le x' h1 h2)⟩
  simpa [Polynomial.aeval_map_algebraMap] using hb.2

/-- **`ℚ̄_ℓ` is a countable increasing union of finite extensions of `ℚ_ℓ`.** -/
theorem exists_monotone_finiteDimensional_cover :
    ∃ E : ℕ → IntermediateField ℚ_[ℓ] (PadicAlgCl ℓ), Monotone E ∧
      (∀ m, FiniteDimensional ℚ_[ℓ] (E m)) ∧ ∀ x, ∃ m, x ∈ E m := by
  have : Countable ℚ[X] := Cardinal.mk_le_aleph0_iff.1
    (Polynomial.cardinalMk_le_max.trans (by simp))
  set S : Set (PadicAlgCl ℓ) := {y | ∃ g : ℚ[X], g.Monic ∧ aeval y g = 0}
  have hS : S.Countable := by
    refine (Set.countable_iUnion fun g : ℚ[X] ↦ (g.rootSet_finite (PadicAlgCl ℓ)).countable).mono ?_
    rintro y ⟨g, hg, hy⟩
    exact Set.mem_iUnion.2 ⟨g, (Polynomial.mem_rootSet_of_ne hg.ne_zero).2 hy⟩
  have hne : S.Nonempty := ⟨0, X, monic_X, by simp⟩
  obtain ⟨e, he⟩ := hS.exists_eq_range hne
  refine ⟨fun m ↦ adjoin ℚ_[ℓ] (e '' Set.Iic m), fun m n h ↦ adjoin.mono _ _ _
    (Set.image_mono (Set.Iic_subset_Iic.2 h)), fun m ↦ ?_, fun x ↦ ?_⟩
  · have : Finite (e '' Set.Iic m) := ((Set.finite_Iic m).image e).to_subtype
    exact finiteDimensional_adjoin fun x _ ↦ Algebra.IsIntegral.isIntegral x
  · obtain ⟨g, hg, y, hy, hxy⟩ := exists_mem_adjoin_aeval_rat_eq_zero x
    obtain ⟨m, rfl⟩ : y ∈ Set.range e := he ▸ ⟨g, hg, hy⟩
    exact ⟨m, adjoin_simple_le_iff.2 (subset_adjoin ℚ_[ℓ] (e '' Set.Iic m)
      (Set.mem_image_of_mem e (Set.mem_Iic.2 le_rfl))) hxy⟩

end PadicAlgCl

namespace LinearEquiv

variable {K Ω V ι : Type*} [Field K] [Field Ω] [Algebra K Ω] [AddCommGroup V] [Module Ω V]
  [Fintype ι] [DecidableEq ι]

theorem IsDefinedOver.mono {F : V ≃ₗ[Ω] V} {b : Basis ι Ω V} {A B : Subalgebra K Ω}
    (h : F.IsDefinedOver b A) (hAB : A ≤ B) : F.IsDefinedOver b B :=
  fun i k ↦ ⟨hAB (h i k).1, hAB (h i k).2⟩

/-- If `Ω` is the increasing union of subalgebras `E m`, every automorphism is defined over some
`E m`. -/
theorem exists_isDefinedOver_of_monotone {E : ℕ → Subalgebra K Ω} (hE : Monotone E)
    (hcover : ∀ x, ∃ m, x ∈ E m) (F : V ≃ₗ[Ω] V) (b : Basis ι Ω V) :
    ∃ m, F.IsDefinedOver b (E m) := by
  choose m hm using hcover
  obtain ⟨M, hM⟩ := Finite.exists_le fun p : ι × ι ↦
    max (m (LinearMap.toMatrix b b F.toLinearMap p.1 p.2))
      (m (LinearMap.toMatrix b b F.symm.toLinearMap p.1 p.2))
  exact ⟨M, fun i k ↦ ⟨hE ((le_max_left _ _).trans (hM (i, k))) (hm _),
    hE ((le_max_right _ _).trans (hM (i, k))) (hm _)⟩⟩

/-- **A compact group of automorphisms is defined over a finite extension** (Baire category).
Let `G` be a compact Hausdorff group acting on `V` through `σ`, with continuous matrix
coefficients, and let `Ω` be the increasing union of closed subalgebras `E m`. Then all `σ(g)`
are defined over a single `E m`: by Baire, some `{g | σ(g) defined over E m}` has interior, hence
contains a translate of an open neighbourhood `N` of `1`, and finitely many translates of `N`
cover `G`. -/
theorem exists_isDefinedOver_of_compactSpace [TopologicalSpace Ω] {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    (σ : G →* (V ≃ₗ[Ω] V)) (b : Basis ι Ω V)
    (hσ : ∀ i k, Continuous fun g ↦ LinearMap.toMatrix b b (σ g).toLinearMap i k)
    {E : ℕ → Subalgebra K Ω} (hE : Monotone E) (hclosed : ∀ m, IsClosed (E m : Set Ω))
    (hcover : ∀ x, ∃ m, x ∈ E m) : ∃ m, ∀ g, (σ g).IsDefinedOver b (E m) := by
  set C : ℕ → Set G := fun m ↦ σ ⁻¹' (definedOverSubgroup b (E m) : Set (V ≃ₗ[Ω] V))
  have hsymm (g : G) : (σ g).symm = σ g⁻¹ := (map_inv σ g).symm
  have hC (m : ℕ) : IsClosed (C m) := by
    have : C m = ⋂ p : ι × ι,
        ((fun g ↦ LinearMap.toMatrix b b (σ g).toLinearMap p.1 p.2) ⁻¹' (E m) ∩
          (fun g ↦ LinearMap.toMatrix b b (σ g⁻¹).toLinearMap p.1 p.2) ⁻¹' (E m)) := by
      ext g
      simp only [C, Set.mem_preimage, SetLike.mem_coe, mem_definedOverSubgroup, IsDefinedOver,
        Set.mem_iInter, Set.mem_inter_iff, hsymm, Prod.forall]
    rw [this]
    exact isClosed_iInter fun p ↦ ((hclosed m).preimage (hσ p.1 p.2)).inter
      ((hclosed m).preimage ((hσ p.1 p.2).comp continuous_inv))
  have hU : ⋃ m, C m = Set.univ :=
    Set.eq_univ_of_forall fun g ↦ Set.mem_iUnion.2 (exists_isDefinedOver_of_monotone hE hcover _ b)
  obtain ⟨m, g₀, hg₀⟩ := nonempty_interior_of_iUnion_of_closed hC hU
  set N : Set G := (fun g ↦ g * g₀) ⁻¹' interior (C m)
  have hN : IsOpen N := isOpen_interior.preimage (continuous_mul_const g₀)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun h : G ↦ (fun g ↦ h⁻¹ * g) ⁻¹' N)
    (fun h ↦ hN.preimage (continuous_const_mul h⁻¹))
    fun g _ ↦ Set.mem_iUnion.2 ⟨g, by simpa [N] using hg₀⟩
  choose mh hmh using fun h : G ↦ exists_isDefinedOver_of_monotone hE hcover (σ h) b
  refine ⟨max m (t.sup mh), fun g ↦ ?_⟩
  obtain ⟨h, hh, hg⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ g))
  have hmM : E m ≤ E (max m (t.sup mh)) := hE (le_max_left _ _)
  have h₁ : σ h ∈ definedOverSubgroup b (E (max m (t.sup mh))) :=
    (hmh h).mono (hE ((Finset.le_sup hh).trans (le_max_right _ _)))
  have h₂ : σ (h⁻¹ * g * g₀) ∈ definedOverSubgroup b (E (max m (t.sup mh))) :=
    IsDefinedOver.mono (interior_subset hg) hmM
  have h₃ : σ g₀ ∈ definedOverSubgroup b (E (max m (t.sup mh))) :=
    IsDefinedOver.mono (interior_subset hg₀) hmM
  have hg : σ g = σ h * σ (h⁻¹ * g * g₀) * (σ g₀)⁻¹ := by
    rw [← map_inv, ← map_mul, ← map_mul]
    group
  rw [← mem_definedOverSubgroup, hg]
  exact mul_mem (mul_mem h₁ h₂) (inv_mem h₃)

end LinearEquiv

