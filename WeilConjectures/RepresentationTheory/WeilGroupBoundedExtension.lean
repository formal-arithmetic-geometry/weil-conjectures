/-!
# From bounded Weil group actions to continuous actions of `ℤ̂`

Deligne, *La conjecture de Weil II*, 1.3.14, shows that an irreducible `ℚ̄_ℓ`-representation of
the Weil group `W` of `X₀` whose restriction to `I = ker deg` is bounded becomes bounded on
all of `W` after a twist (`Representation.exists_isBoundedOn_twist`). The point of the
statement is that a bounded representation of `W` comes from an `ℓ`-adic representation of the
arithmetic fundamental group, i.e. extends continuously to the profinite completion of `W`.
In the proof one uses that the image of `W` then lies in `GL(L)` for an `𝒪_E`-lattice `L`, `E`
a finite extension of `ℚ_ℓ`, and that `GL(L)` is profinite. This file proves the elementary
ingredients of this step, in the basic case `W = ℤ` generated by a Frobenius `F`.

## Linear algebra (eigenvalues of bounded automorphisms)

* `Module.End.norm_eq_one_of_hasEigenvalue`: over any normed field, if the orbits
  `{Fⁿ v | n ∈ ℤ}` of an invertible endomorphism are bounded, every eigenvalue of `F` has norm
  one.
* `Module.End.isWeaklyBounded_range_zpow_apply_iff_norm_eq_one`: over an algebraically closed
  ultrametric normed field (such as `ℚ̄_ℓ = PadicAlgCl ℓ`) and in finite dimension, this is an
  equivalence: the powers of `F` are bounded iff all eigenvalues of `F` are `ℓ`-adic units.
  No diagonalisability is needed: the characteristic polynomial then has integral coefficients
  and `Fⁿ v` is an integral combination of `v, F v, …, F^(d-1) v` (`|n| ≤ 1` for the
  unipotent part, by the ultrametric inequality).
* `Representation.IsBoundedOn.norm_eq_one_of_hasEigenvalue` and
  `Representation.exists_norm_eq_zpow_of_hasEigenvalue`: consequence of Weil II 1.3.14: for an
  irreducible representation of a Weil-type group bounded on `ker deg` there is `b` such that
  all eigenvalues of `ρ(w)` have absolute value `‖b‖ ^ deg w`.

## Continuity of `n ↦ Fⁿ` for the profinite topology

* `LinearEquiv.exists_pow_sub_mem_of_finite_quotient`: pigeonhole in the finite group
  `GL(L ⧸ N)`: if `F` stabilises `N` and `L ⧸ N` is finite, some power `F^m`, `m > 0`, is the
  identity modulo `N`.
* `LinearEquiv.exists_zpow_sub_zpow_mem_ideal_smul_top` and
  `LinearEquiv.exists_zpow_sub_zpow_mem_pow_smul_top`: for a finitely generated `ℤ_ℓ`-module `L`
  (e.g. an `𝒪_E`-lattice) and every `k` there is `m > 0` with `Fⁿ ≡ Fⁿ' (mod ℓᵏ L)` whenever
  `n ≡ n' (mod m)`: `n ↦ Fⁿ` is uniformly continuous from the profinite to the `ℓ`-adic
  topology.
* `LinearEquiv.zhatAction`: for `L ⧸ N` finite, the continuous (locally constant) extension
  `ℤ̂ →* GL(L ⧸ N)` of `n ↦ Fⁿ mod N`, where `ℤ̂` is Mathlib's profinite completion of `ℤ`;
  these are compatible with the reductions `L ⧸ N → L ⧸ N'` (`LinearEquiv.zhatAction_factor`),
  i.e. they form a continuous action of `ℤ̂` on the pro-system `(L ⧸ ℓᵏ L)_k`.

## Extension to `ℤ̂` on a complete lattice

* `LinearEquiv.zhatHom`: if `L` is `I`-adically complete with all `L ⧸ Iᵏ L` finite, the
  finite-level actions glue to a homomorphism `ℤ̂ →* GL(L)` extending `n ↦ Fⁿ`
  (`LinearEquiv.zhatHom_ofInt`), continuous for the `I`-adic topology
  (`LinearEquiv.isLocallyConstant_mkQ_zhatHom_apply`) and unique with these properties
  (`LinearEquiv.eq_of_isLocallyConstant_of_ofInt`).
* `PadicInt.existsUnique_zhat_extension_of_free`: for every automorphism `F` of a finite free
  `ℤ_ℓ`-module `L` (a lattice), `n ↦ Fⁿ` extends uniquely to an `ℓ`-adically continuous
  homomorphism `ℤ̂ →* GL(L)`. Completeness of `L` comes from `IsAdicComplete.pi` and
  `IsAdicComplete.of_linearEquiv`.

To apply this to a bounded `F ∈ GL(V)` over `ℚ̄_ℓ` one still needs that `F` is defined over a
finite extension `E` of `ℚ_ℓ` and stabilises an `𝒪_E`-lattice; over `ℚ̄_ℓ` itself the
valuation ring is not noetherian and `L ⧸ ℓ L` is infinite, so the pigeonhole argument does
not apply directly.
-/

@[expose] public section

open Module Polynomial

/-- The closed unit ball of an ultrametric normed field, as a subring (the valuation ring). -/
def NormedField.unitBallSubring (k : Type*) [NormedField k] [IsUltrametricDist k] : Subring k where
  carrier := {x | ‖x‖ ≤ 1}
  mul_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, norm_mul] at *
    exact (mul_le_of_le_one_left (norm_nonneg _) hx).trans hy
  one_mem' := by simp
  add_mem' {x y} hx hy := (IsUltrametricDist.norm_add_le_max x y).trans (max_le hx hy)
  zero_mem' := by simp
  neg_mem' {x} hx := by simpa using hx

/-- Membership in `NormedField.unitBallSubring`. -/
theorem NormedField.mem_unitBallSubring {k : Type*} [NormedField k] [IsUltrametricDist k]
    {x : k} :
    x ∈ unitBallSubring k ↔ ‖x‖ ≤ 1 :=
  Iff.rfl

/-- Over an ultrametric normed field, a monic polynomial whose roots have norm at most one
lifts to the valuation ring. -/
theorem Polynomial.prod_X_sub_C_mem_lifts_unitBallSubring {k : Type*} [NormedField k]
    [IsUltrametricDist k] (s : Multiset k) (hs : ∀ x ∈ s, ‖x‖ ≤ 1) :
    (s.map (X - C ·)).prod ∈ lifts (NormedField.unitBallSubring k).subtype := by
  rw [lifts_iff_liftsRing]
  refine Subring.multiset_prod_mem _ _ fun p hp ↦ ?_
  obtain ⟨x, hx, rfl⟩ := Multiset.mem_map.1 hp
  exact sub_mem ((lifts_iff_liftsRing _ _).1 (X_mem_lifts _))
    ((lifts_iff_liftsRing _ _).1 (C_mem_lifts (NormedField.unitBallSubring k).subtype ⟨x, hs x hx⟩))

namespace Module.End

variable {k V : Type*} [NormedField k] [AddCommGroup V] [Module k V]

/-- **Bounded powers have eigenvalues of norm at most one.** If the forward orbits
`{Fⁿ v | n ∈ ℕ}` of an endomorphism are weakly bounded, every eigenvalue `μ` of `F` satisfies
`‖μ‖ ≤ 1`: on an eigenvector `v`, `φ (Fⁿ v) = μⁿ φ v`. -/
theorem norm_le_one_of_hasEigenvalue {F : End k V}
    (hF : ∀ v, IsWeaklyBounded k (Set.range fun n : ℕ ↦ (F ^ n) v)) {μ : k}
    (hμ : F.HasEigenvalue μ) : ‖μ‖ ≤ 1 := by
  obtain ⟨v, hv⟩ := hμ.exists_hasEigenvector
  obtain ⟨φ, hφ⟩ := Projective.exists_dual_ne_zero k hv.2
  obtain ⟨C, hC⟩ := hF v φ
  by_contra! h
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (C / ‖φ v‖) h
  have hpos : 0 < ‖φ v‖ := norm_pos_iff.2 hφ
  have := hC _ ⟨n, rfl⟩
  rw [div_lt_iff₀ hpos] at hn
  simp only [hv.pow_apply, map_smul, smul_eq_mul, norm_mul, norm_pow] at this
  linarith

/-- **Unit eigenvalues give bounded powers.** Over an algebraically closed ultrametric normed
field, if all eigenvalues of an endomorphism `F` of a finite-dimensional space have norm at most
one, the forward orbits `{Fⁿ v | n ∈ ℕ}` are weakly bounded. Indeed the characteristic
polynomial `χ` of `F` then has integral coefficients, so `Fⁿ v = (Xⁿ mod χ)(F) v` is an integral
combination of `v, F v, …, F^(d-1) v`, and the ultrametric inequality applies. -/
theorem isWeaklyBounded_range_pow_apply_of_norm_le_one [IsAlgClosed k] [IsUltrametricDist k]
    [FiniteDimensional k V] {F : End k V} (hF : ∀ μ, F.HasEigenvalue μ → ‖μ‖ ≤ 1) (v : V) :
    IsWeaklyBounded k (Set.range fun n : ℕ ↦ (F ^ n) v) := by
  set S := NormedField.unitBallSubring k
  have hlifts : F.charpoly ∈ lifts S.subtype := by
    rw [(IsAlgClosed.splits F.charpoly).eq_prod_roots_of_monic (LinearMap.charpoly_monic F)]
    refine prod_X_sub_C_mem_lifts_unitBallSubring _ fun μ hμ ↦ hF μ ?_
    rw [hasEigenvalue_iff_isRoot_charpoly]
    exact isRoot_of_mem_roots hμ
  obtain ⟨q, hq, -, hqm⟩ := lifts_and_natDegree_eq_and_monic hlifts (LinearMap.charpoly_monic F)
  intro φ
  set d := F.charpoly.natDegree
  refine ⟨∑ i ∈ Finset.range (d + 1), ‖φ ((F ^ i) v)‖, ?_⟩
  rintro _ ⟨n, rfl⟩
  have hr : (X ^ n %ₘ F.charpoly).natDegree < d + 1 :=
    Nat.lt_succ_of_le (natDegree_modByMonic_le _ (LinearMap.charpoly_monic F))
  have hcoeff (i : ℕ) : ‖(X ^ n %ₘ F.charpoly).coeff i‖ ≤ 1 := by
    rw [← hq, ← map_X S.subtype, ← Polynomial.map_pow, ← map_modByMonic _ hqm, coeff_map]
    exact (X ^ n %ₘ q).coeff i |>.2
  have key : aeval F (X ^ n %ₘ F.charpoly) = F ^ n := by
    simpa [LinearMap.aeval_self_charpoly] using
      congrArg (aeval F) (modByMonic_add_div (X ^ n) F.charpoly)
  beta_reduce
  rw [← key,aeval_eq_sum_range' hr, LinearMap.sum_apply, map_sum]
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg
    (Finset.sum_nonneg fun _ _ ↦ norm_nonneg _) fun i hi ↦ ?_
  rw [LinearMap.smul_apply, map_smul, smul_eq_mul, norm_mul]
  exact (mul_le_of_le_one_left (norm_nonneg _) (hcoeff i)).trans
    (Finset.single_le_sum (f := fun i ↦ ‖φ ((F ^ i) v)‖) (fun _ _ ↦ norm_nonneg _) hi)


/-- If `F` is invertible, `v` is an eigenvector of `F⁻¹` for `μ` iff it is one of `F` for `μ⁻¹`. -/
theorem HasEigenvector.of_units_inv {F : (End k V)ˣ} {μ : k} {v : V}
    (h : (↑F⁻¹ : End k V).HasEigenvector μ v) : (F : End k V).HasEigenvector μ⁻¹ v := by
  have hμ : μ ≠ 0 := by
    rintro rfl
    apply h.2
    rw [← Module.End.one_apply (R := k) v, ← F.mul_inv, Module.End.mul_apply, h.apply_eq_smul,
      zero_smul,
      map_zero]
  refine ⟨mem_eigenspace_iff.2 ?_, h.2⟩
  conv_lhs => rw [← inv_smul_smul₀ hμ v, ← h.apply_eq_smul, map_smul, ← Module.End.mul_apply,
    F.mul_inv, Module.End.one_apply]

/-- The eigenvalues of `F⁻¹` are the inverses of those of `F`. -/
theorem hasEigenvalue_units_inv {F : (End k V)ˣ} {μ : k}
    (h : (↑F⁻¹ : End k V).HasEigenvalue μ) : (F : End k V).HasEigenvalue μ⁻¹ := by
  obtain ⟨v, hv⟩ := h.exists_hasEigenvector
  exact hasEigenvalue_of_hasEigenvector hv.of_units_inv

/-- The two-sided orbit `{Fⁿ v | n ∈ ℤ}` is the union of the forward orbits of `v` under `F` and
under `F⁻¹`. -/
theorem isWeaklyBounded_range_zpow_apply_iff {F : (End k V)ˣ} {v : V} :
    IsWeaklyBounded k (Set.range fun n : ℤ ↦ (↑(F ^ n) : End k V) v) ↔
      IsWeaklyBounded k (Set.range fun n : ℕ ↦ ((F : End k V) ^ n) v) ∧
        IsWeaklyBounded k (Set.range fun n : ℕ ↦ ((↑F⁻¹ : End k V) ^ n) v) := by
  refine ⟨fun h ↦ ⟨h.mono ?_, h.mono ?_⟩, fun h ↦ (h.1.union h.2).mono ?_⟩
  · rintro _ ⟨n, rfl⟩
    exact ⟨n, by simp⟩
  · rintro _ ⟨n, rfl⟩
    exact ⟨-n, by simp⟩
  · rintro _ ⟨n, rfl⟩
    obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg n
    · exact Or.inl ⟨n, by simp⟩
    · exact Or.inr ⟨n, by simp⟩

/-- **Bounded powers have unit eigenvalues.** If the two-sided orbits `{Fⁿ v | n ∈ ℤ}` of an
invertible endomorphism are weakly bounded, every eigenvalue of `F` has norm one. -/
theorem norm_eq_one_of_hasEigenvalue {F : (End k V)ˣ}
    (hF : ∀ v, IsWeaklyBounded k (Set.range fun n : ℤ ↦ (↑(F ^ n) : End k V) v)) {μ : k}
    (hμ : (F : End k V).HasEigenvalue μ) : ‖μ‖ = 1 := by
  simp_rw [isWeaklyBounded_range_zpow_apply_iff] at hF
  refine le_antisymm (norm_le_one_of_hasEigenvalue (fun v ↦ (hF v).1) hμ) ?_
  obtain ⟨v, hv⟩ := hμ.exists_hasEigenvector
  have hv' : (↑F⁻¹ : End k V).HasEigenvector μ⁻¹ v := by
    simpa using HasEigenvector.of_units_inv (F := F⁻¹) (by simpa using hv)
  have := norm_le_one_of_hasEigenvalue (fun v ↦ (hF v).2) (hasEigenvalue_of_hasEigenvector hv')
  rwa [norm_inv, inv_le_one₀ (norm_pos_iff.2 ?_)] at this
  rintro rfl
  apply hv.2
  rw [← Module.End.one_apply (R := k) v, ← F.inv_mul, Module.End.mul_apply, hv.apply_eq_smul,
    zero_smul,
    map_zero]

/-- **Weil II, 1.3.14, linear algebra.** Over an algebraically closed ultrametric normed field
(e.g. `ℚ̄_ℓ`), the two-sided orbits of an invertible endomorphism `F` of a finite-dimensional
space are bounded if and only if all eigenvalues of `F` have norm one. -/
theorem isWeaklyBounded_range_zpow_apply_iff_norm_eq_one [IsAlgClosed k] [IsUltrametricDist k]
    [FiniteDimensional k V] {F : (End k V)ˣ} :
    (∀ v, IsWeaklyBounded k (Set.range fun n : ℤ ↦ (↑(F ^ n) : End k V) v)) ↔
      ∀ μ, (F : End k V).HasEigenvalue μ → ‖μ‖ = 1 := by
  refine ⟨fun hF μ hμ ↦ norm_eq_one_of_hasEigenvalue hF hμ, fun h v ↦ ?_⟩
  rw [isWeaklyBounded_range_zpow_apply_iff]
  refine ⟨isWeaklyBounded_range_pow_apply_of_norm_le_one (fun μ hμ ↦ (h μ hμ).le) v,
    isWeaklyBounded_range_pow_apply_of_norm_le_one (fun μ hμ ↦ ?_) v⟩
  have := h _ (hasEigenvalue_units_inv hμ)
  rw [norm_inv, inv_eq_one] at this
  exact this.le

end Module.End

namespace Module.End

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]

/-- If `μ` is an eigenvalue of `f`, then `c * μ` is an eigenvalue of `c • f`. -/
theorem HasEigenvalue.smul {f : End k V} {μ : k} (h : f.HasEigenvalue μ) (c : k) :
    (c • f).HasEigenvalue (c * μ) := by
  obtain ⟨v, hv⟩ := h.exists_hasEigenvector
  refine hasEigenvalue_of_hasEigenvector ⟨mem_eigenspace_iff.2 ?_, hv.2⟩
  rw [LinearMap.smul_apply, hv.apply_eq_smul, smul_smul]

end Module.End

namespace Representation

variable {k W V : Type*} [NormedField k] [Group W] [AddCommGroup V] [Module k V]

/-- A representation bounded on all of `W` has unit eigenvalues: every eigenvalue of every
`ρ(w)` has norm one. -/
theorem IsBoundedOn.norm_eq_one_of_hasEigenvalue {ρ : Representation k W V}
    (hρ : ρ.IsBoundedOn Set.univ) (w : W) {μ : k} (hμ : Module.End.HasEigenvalue (ρ w) μ) :
    ‖μ‖ = 1 := by
  rw [← asGroupHom_apply] at hμ
  refine Module.End.norm_eq_one_of_hasEigenvalue (fun v ↦ (hρ v).mono ?_) hμ
  rintro _ ⟨n, rfl⟩
  exact ⟨w ^ n, Set.mem_univ _, by simp [← map_zpow, asGroupHom_apply]⟩

/-- **Weil II, 1.3.14, eigenvalues.** Let `ρ` be an irreducible finite-dimensional representation
of a Weil-type group `W` over an algebraically closed normed field, bounded on `I = ker deg`.
Then there is `b ∈ kˣ` such that every eigenvalue of every `ρ(w)` has norm `‖b‖ ^ deg w`. In
particular all eigenvalues of a Frobenius element (`deg F = 1`) have the same absolute value. -/
theorem exists_norm_eq_zpow_of_hasEigenvalue [IsAlgClosed k] [FiniteDimensional k V]
    (ρ : Representation k W V) [ρ.IsIrreducible] {deg : W →* Multiplicative ℤ}
    (hdeg : Function.Surjective deg) (hI : ρ.IsBoundedOn deg.ker) :
    ∃ b : kˣ, ∀ w μ, Module.End.HasEigenvalue (ρ w) μ →
      ‖μ‖ = ‖(b : k)‖ ^ Multiplicative.toAdd (deg w) := by
  obtain ⟨b, hb⟩ := ρ.exists_isBoundedOn_twist hdeg hI
  refine ⟨b, fun w μ hμ ↦ ?_⟩
  have := hb.norm_eq_one_of_hasEigenvalue w
    (hμ.smul ((degreeCharacter deg b⁻¹ w : kˣ) : k))
  rw [norm_mul, degreeCharacter_apply, Units.val_zpow_eq_zpow_val, Units.val_inv_eq_inv_val,
    inv_zpow, norm_inv, norm_zpow, inv_mul_eq_one₀] at this
  · exact this.symm
  · exact zpow_ne_zero _ (norm_ne_zero_iff.2 b.ne_zero)

end Representation

namespace LinearEquiv

variable {R L : Type*} [Ring R] [AddCommGroup L] [Module R L]

/-- An automorphism `F` of `L` stabilising a submodule `N` acts on `L ⧸ N` compatibly with all
its integral powers. -/
theorem mkQ_zpow_apply (F : L ≃ₗ[R] L) {N : Submodule R L} (hN : N.map (F : L →ₗ[R] L) = N)
    (n : ℤ) (x : L) :
    N.mkQ ((F ^ n) x) = (Submodule.Quotient.equiv N N F hN ^ n) (N.mkQ x) := by
  induction n using Int.induction_on generalizing x with
  | zero => simp
  | succ n ih =>
    rw [zpow_add_one, zpow_add_one, LinearEquiv.mul_apply, ih, LinearEquiv.mul_apply]
    rfl
  | pred n ih =>
    rw [sub_eq_add_neg, zpow_add, zpow_add, zpow_neg_one, zpow_neg_one, LinearEquiv.mul_apply,
      ih, LinearEquiv.mul_apply]
    congr 1

/-- **Pigeonhole for automorphisms modulo a finite-index submodule.** If an automorphism `F` of
`L` stabilises a submodule `N` with `L ⧸ N` finite, then some positive power of `F` is congruent
to the identity modulo `N`: the induced automorphism of the finite module `L ⧸ N` has finite
order. -/
theorem exists_pow_sub_mem_of_finite_quotient (F : L ≃ₗ[R] L) {N : Submodule R L}
    [Finite (L ⧸ N)] (hN : N.map (F : L →ₗ[R] L) = N) :
    ∃ m : ℕ, 0 < m ∧ ∀ (n : ℤ), (m : ℤ) ∣ n → ∀ x, (F ^ n) x - x ∈ N := by
  have : Finite ((L ⧸ N) ≃ₗ[R] (L ⧸ N)) :=
    Finite.of_injective (fun e : (L ⧸ N) ≃ₗ[R] (L ⧸ N) ↦ (e : L ⧸ N → L ⧸ N))
      DFunLike.coe_injective
  set e := Submodule.Quotient.equiv N N F hN
  refine ⟨orderOf e, (isOfFinOrder_of_finite e).orderOf_pos, ?_⟩
  rintro _ ⟨j, rfl⟩ x
  rw [← Submodule.Quotient.eq, ← Submodule.mkQ_apply, ← Submodule.mkQ_apply, mkQ_zpow_apply F hN,
    zpow_mul, zpow_natCast, pow_orderOf_eq_one, one_zpow, LinearEquiv.coe_one, id]

/-- **Continuity of `n ↦ Fⁿ` for the profinite topology.** Under the hypotheses of
`exists_pow_sub_mem_of_finite_quotient`, there is `m > 0` such that `Fⁿ ≡ Fⁿ'` modulo `N`
whenever `n ≡ n' (mod m)`. -/
theorem exists_zpow_sub_zpow_mem_of_finite_quotient (F : L ≃ₗ[R] L) {N : Submodule R L}
    [Finite (L ⧸ N)] (hN : N.map (F : L →ₗ[R] L) = N) :
    ∃ m : ℕ, 0 < m ∧ ∀ n n' : ℤ, n ≡ n' [ZMOD m] → ∀ x, (F ^ n) x - (F ^ n') x ∈ N := by
  obtain ⟨m, hm, h⟩ := F.exists_pow_sub_mem_of_finite_quotient hN
  refine ⟨m, hm, fun n n' hnn' x ↦ ?_⟩
  have := h (n - n') (Int.ModEq.dvd hnn'.symm) ((F ^ n') x)
  rwa [← LinearEquiv.mul_apply, ← zpow_add, sub_add_cancel] at this

end LinearEquiv

namespace LinearEquiv

variable {R L : Type*} [CommRing R] [AddCommGroup L] [Module R L]

/-- A linear automorphism stabilises `I • ⊤` for every ideal `I`. -/
theorem map_ideal_smul_top (F : L ≃ₗ[R] L) (I : Ideal R) :
    (I • ⊤ : Submodule R L).map (F : L →ₗ[R] L) = I • ⊤ := by
  rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]

/-- **Weil II, 1.3.14, finite levels.** Let `L` be a finitely generated module over a commutative
ring `R` (a lattice over the ring of integers `𝒪` of a finite extension of `ℚ_ℓ`), `I` an ideal
with `R ⧸ I` finite (e.g. `I = ℓᵏ 𝒪`) and `F` an automorphism of `L`. Then there is `m > 0`
such that `Fⁿ ≡ Fⁿ'` modulo `I L` whenever `n ≡ n' (mod m)`. -/
theorem exists_zpow_sub_zpow_mem_ideal_smul_top [Module.Finite R L] (F : L ≃ₗ[R] L) (I : Ideal R)
    [Finite (R ⧸ I)] :
    ∃ m : ℕ, 0 < m ∧ ∀ n n' : ℤ, n ≡ n' [ZMOD m] → ∀ x,
      (F ^ n) x - (F ^ n') x ∈ I • (⊤ : Submodule R L) := by
  have : Finite (L ⧸ (I • ⊤ : Submodule R L)) := Module.finite_of_finite (R ⧸ I)
  exact F.exists_zpow_sub_zpow_mem_of_finite_quotient (F.map_ideal_smul_top I)

end LinearEquiv

namespace PadicInt

variable {ℓ : ℕ} [Fact ℓ.Prime]

/-- `ℤ_ℓ ⧸ ℓᵏ ≅ ℤ ⧸ ℓᵏ` is finite. -/
instance finite_quotient_span_pow (k : ℕ) : Finite (ℤ_[ℓ] ⧸ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k}) := by
  rw [← ker_toZModPow]
  exact Finite.of_injective _ (RingHom.kerLift_injective _)

end PadicInt

namespace LinearEquiv

variable {ℓ : ℕ} [Fact ℓ.Prime] {L : Type*} [AddCommGroup L] [Module ℤ_[ℓ] L]
  [Module.Finite ℤ_[ℓ] L]

/-- **Weil II, 1.3.14, `ℓ`-adic continuity.** For an automorphism `F` of a finitely generated
`ℤ_ℓ`-module `L` (e.g. a lattice over the ring of integers of a finite extension of `ℚ_ℓ`, viewed
over `ℤ_ℓ`), the map `ℤ → GL(L)`, `n ↦ Fⁿ`, is uniformly continuous from the profinite
topology to the `ℓ`-adic topology: for each `k` there is `m > 0` with `Fⁿ ≡ Fⁿ' (mod ℓᵏ L)`
whenever `n ≡ n' (mod m)`. -/
theorem exists_zpow_sub_zpow_mem_pow_smul_top (F : L ≃ₗ[ℤ_[ℓ]] L) (k : ℕ) :
    ∃ m : ℕ, 0 < m ∧ ∀ n n' : ℤ, n ≡ n' [ZMOD m] → ∀ x,
      (F ^ n) x - (F ^ n') x ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} • (⊤ : Submodule ℤ_[ℓ] L) :=
  F.exists_zpow_sub_zpow_mem_ideal_smul_top _

end LinearEquiv

namespace ProfiniteGrp.ProfiniteCompletion

open CategoryTheory

universe u

variable {G A : Type u} [Group G] [Group A] [Finite A]

/-- The extension of a homomorphism `G →* A` to a finite group to the profinite completion
of `G`, via the universal property (`A` with the discrete topology is profinite). -/
noncomputable def liftFinite (ψ : G →* A) : completion (GrpCat.of G) →* A :=
  (lift (P := ProfiniteGrp.ofFiniteGrp (FiniteGrp.of A)) (GrpCat.ofHom ψ)).hom.toMonoidHom

/-- The extension `liftFinite ψ` is continuous for the discrete topology on `A`. -/
theorem isLocallyConstant_liftFinite (ψ : G →* A) : IsLocallyConstant (liftFinite ψ) := by
  let P := ProfiniteGrp.ofFiniteGrp (FiniteGrp.of A)
  have : DiscreteTopology P := ⟨rfl⟩
  exact fun s ↦ (isOpen_discrete (α := P) s).preimage
    (lift (P := P) (GrpCat.ofHom ψ)).hom.continuous_toFun

@[simp]
theorem liftFinite_etaFn (ψ : G →* A) (g : G) : liftFinite ψ (etaFn (GrpCat.of G) g) = ψ g :=
  ConcreteCategory.congr_hom (lift_eta (P := ProfiniteGrp.ofFiniteGrp (FiniteGrp.of A))
    (GrpCat.ofHom ψ)) g

omit [Group A] [Finite A] in
/-- Two locally constant functions on the profinite completion which agree on the image of `G`
are equal (the image of `G` is dense). -/
theorem eq_of_isLocallyConstant {X : Type*} {f g : completion (GrpCat.of G) → X}
    (hf : IsLocallyConstant f) (hg : IsLocallyConstant g)
    (h : ∀ x, f (etaFn (GrpCat.of G) x) = g (etaFn (GrpCat.of G) x)) : f = g := by
  let : TopologicalSpace X := ⊥
  have : DiscreteTopology X := ⟨rfl⟩
  exact (denseRange (G := GrpCat.of G)).equalizer hf.continuous hg.continuous (funext h)

/-- The profinite completion `ℤ̂` of `ℤ`, as the profinite completion of `Multiplicative ℤ`. -/
abbrev Zhat := completion (GrpCat.of (Multiplicative ℤ))

/-- The image of `n ∈ ℤ` in `ℤ̂`. -/
def Zhat.ofInt (n : ℤ) : Zhat :=
  etaFn (GrpCat.of (Multiplicative ℤ)) (Multiplicative.ofAdd n : Multiplicative ℤ)

end ProfiniteGrp.ProfiniteCompletion

namespace LinearEquiv

open ProfiniteGrp.ProfiniteCompletion

/-- The automorphism group of a finite module is finite. -/
instance finite_of_finite {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M] [Finite M] :
    Finite (M ≃ₗ[R] M) :=
  Finite.of_injective (fun e : M ≃ₗ[R] M ↦ (e : M → M)) DFunLike.coe_injective

variable {R L : Type} [Ring R] [AddCommGroup L] [Module R L]

/-- **Extension to `ℤ̂` at a finite level.** An automorphism `F` of `L` stabilising a submodule
`N` with `L ⧸ N` finite induces a continuous (locally constant) action `ℤ̂ →* GL(L ⧸ N)`
extending `n ↦ Fⁿ mod N`. -/
noncomputable def zhatAction (F : L ≃ₗ[R] L) {N : Submodule R L} [Finite (L ⧸ N)]
    (hN : N.map (F : L →ₗ[R] L) = N) : Zhat →* ((L ⧸ N) ≃ₗ[R] (L ⧸ N)) :=
  liftFinite (zpowersHom _ (Submodule.Quotient.equiv N N F hN))

/-- The `ℤ̂`-action on `L ⧸ N` is continuous (`L ⧸ N` being discrete). -/
theorem isLocallyConstant_zhatAction (F : L ≃ₗ[R] L) {N : Submodule R L} [Finite (L ⧸ N)]
    (hN : N.map (F : L →ₗ[R] L) = N) : IsLocallyConstant (F.zhatAction hN) :=
  isLocallyConstant_liftFinite _

/-- On the image of `n ∈ ℤ`, the `ℤ̂`-action is `Fⁿ mod N`. -/
theorem zhatAction_ofInt_apply (F : L ≃ₗ[R] L) {N : Submodule R L} [Finite (L ⧸ N)]
    (hN : N.map (F : L →ₗ[R] L) = N) (n : ℤ) (x : L) :
    F.zhatAction hN (Zhat.ofInt n) (N.mkQ x) = N.mkQ ((F ^ n) x) := by
  rw [zhatAction, Zhat.ofInt, liftFinite_etaFn, zpowersHom_apply, toAdd_ofAdd,
    mkQ_zpow_apply F hN]

/-- The finite-level actions of `ℤ̂` are compatible with the reductions `L ⧸ N → L ⧸ N'` for
`N ≤ N'`; together they form a continuous action of `ℤ̂` on the pro-system `(L ⧸ N)_N`. -/
theorem zhatAction_factor (F : L ≃ₗ[R] L) {N N' : Submodule R L} [Finite (L ⧸ N)]
    [Finite (L ⧸ N')] (hN : N.map (F : L →ₗ[R] L) = N) (hN' : N'.map (F : L →ₗ[R] L) = N')
    (h : N ≤ N') (a : Zhat) (y : L ⧸ N) :
    F.zhatAction hN' a (Submodule.factor h y) = Submodule.factor h (F.zhatAction hN a y) := by
  obtain ⟨x, rfl⟩ := N.mkQ_surjective y
  refine congrFun (eq_of_isLocallyConstant
    ((isLocallyConstant_zhatAction F hN').comp fun e ↦ e (Submodule.factor h (N.mkQ x)))
    ((isLocallyConstant_zhatAction F hN).comp fun e ↦ Submodule.factor h (e (N.mkQ x)))
    fun g ↦ ?_) a
  obtain ⟨n, rfl⟩ := (Multiplicative.ofAdd (α := ℤ)).surjective g
  have := zhatAction_ofInt_apply F hN' n x
  simp only [Zhat.ofInt] at this
  simp only [Function.comp_apply, Submodule.factor_mk, this]
  have h2 := zhatAction_ofInt_apply F hN n x
  simp only [Zhat.ofInt] at h2
  rw [h2, Submodule.factor_mk]

end LinearEquiv

section AdicComplete

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {I : Ideal R}

/-- Adic completeness is transported along linear equivalences. -/
theorem IsAdicComplete.of_linearEquiv [IsAdicComplete I M] (e : M ≃ₗ[R] N) :
    IsAdicComplete I N := by
  have hmap (n : ℕ) (f : M ≃ₗ[R] N) :
      (I ^ n • ⊤ : Submodule R M).map (f : M →ₗ[R] N) = I ^ n • ⊤ := by
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
  have hmap' (n : ℕ) : (I ^ n • ⊤ : Submodule R N).map (e.symm : N →ₗ[R] M) = I ^ n • ⊤ := by
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
  refine { toIsHausdorff := ⟨fun x hx ↦ ?_⟩, toIsPrecomplete := ⟨fun f hf ↦ ?_⟩ }
  · rw [← e.symm.map_eq_zero_iff]
    refine IsHausdorff.haus' (I := I) _ fun n ↦ ?_
    simpa [hmap'] using (hx n).map (e.symm : N →ₗ[R] M)
  · obtain ⟨y, hy⟩ := IsPrecomplete.prec' (I := I) (fun n ↦ e.symm (f n)) fun {m n} hmn ↦ by
      simpa [hmap'] using (hf hmn).map (e.symm : N →ₗ[R] M)
    refine ⟨e y, fun n ↦ ?_⟩
    simpa [hmap n e] using (hy n).map (e : M →ₗ[R] N)

/-- `J • R = J` for an ideal `J` of `R`. -/
theorem Ideal.smul_top_self (J : Ideal R) : (J • ⊤ : Submodule R R) = J := by
  rw [Ideal.smul_eq_mul, Ideal.mul_top]

/-- A finite power of an `I`-adically complete ring is `I`-adically complete. -/
instance IsAdicComplete.pi {ι : Type*} [Finite ι] [IsAdicComplete I R] :
    IsAdicComplete I (ι → R) := by
  refine { toIsHausdorff := ⟨fun x hx ↦ funext fun i ↦ ?_⟩, toIsPrecomplete := ⟨fun f hf ↦ ?_⟩ }
  · refine IsHausdorff.haus' (I := I) (x i) fun n ↦ ?_
    have := (hx n)
    rw [SModEq.sub_mem, Ideal.mem_smul_top_pi_iff] at this
    rw [SModEq.sub_mem, Ideal.smul_top_self]
    simpa using this i
  · have hf' (i : ι) {m n : ℕ} (hmn : m ≤ n) :
        f m i ≡ f n i [SMOD (I ^ m • ⊤ : Submodule R R)] := by
      have := hf hmn
      rw [SModEq.sub_mem, Ideal.mem_smul_top_pi_iff] at this
      rw [SModEq.sub_mem, Ideal.smul_top_self]
      simpa using this i
    choose y hy using fun i ↦ IsPrecomplete.prec' (I := I) (fun n ↦ f n i) (hf' i)
    refine ⟨y, fun n ↦ ?_⟩
    rw [SModEq.sub_mem, Ideal.mem_smul_top_pi_iff]
    intro i
    have := hy i n
    rw [SModEq.sub_mem, Ideal.smul_top_self] at this
    simpa using this

/-- `ℤ_ℓ` is `ℓ`-adically complete. -/
instance PadicInt.isAdicComplete_span_p {p : ℕ} [Fact p.Prime] :
    IsAdicComplete (Ideal.span {(p : ℤ_[p])}) ℤ_[p] := by
  rw [← PadicInt.maximalIdeal_eq_span_p]
  infer_instance

end AdicComplete

namespace LinearEquiv

open ProfiniteGrp.ProfiniteCompletion

variable {R L : Type} [CommRing R] [AddCommGroup L] [Module R L] {I : Ideal R}
  [hfin : ∀ k, Finite (L ⧸ (I ^ k • ⊤ : Submodule R L))]

/-- The action of `a ∈ ℤ̂` on `L ⧸ Iᵏ L`. -/
noncomputable abbrev zhatActionPow (F : L ≃ₗ[R] L) (I : Ideal R)
    [∀ k, Finite (L ⧸ (I ^ k • ⊤ : Submodule R L))] (k : ℕ) :
    Zhat →* ((L ⧸ (I ^ k • ⊤ : Submodule R L)) ≃ₗ[R] (L ⧸ (I ^ k • ⊤ : Submodule R L))) :=
  F.zhatAction (F.map_ideal_smul_top (I ^ k))

omit hfin in
/-- **Passage to the limit.** If `L` is `I`-adically precomplete, the compatible family of
finite-level actions `a • (x mod Iᵏ L)` (`LinearEquiv.zhatAction_factor`) has a limit in `L`. -/
theorem exists_zhatSMul (F : L ≃ₗ[R] L) (I : Ideal R)
    [∀ k, Finite (L ⧸ (I ^ k • ⊤ : Submodule R L))] [IsPrecomplete I L] (a : Zhat) (x : L) :
    ∃ y : L, ∀ k, (I ^ k • ⊤ : Submodule R L).mkQ y =
      F.zhatActionPow I k a ((I ^ k • ⊤ : Submodule R L).mkQ x) := by
  choose f hf using fun k ↦ (I ^ k • ⊤ : Submodule R L).mkQ_surjective
    (F.zhatActionPow I k a ((I ^ k • ⊤ : Submodule R L).mkQ x))
  obtain ⟨y, hy⟩ := IsPrecomplete.prec ‹_› (f := f) fun {m n} hmn ↦ by
    have hle : (I ^ n • ⊤ : Submodule R L) ≤ I ^ m • ⊤ :=
      Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn)
    rw [SModEq, ← Submodule.mkQ_apply, ← Submodule.mkQ_apply, hf m, ← Submodule.factor_mk hle (f n),
      hf n, ← Submodule.factor_mk hle x, zhatAction_factor]
  refine ⟨y, fun k ↦ ?_⟩
  rw [← hf k]
  exact (hy k).symm

variable [IsAdicComplete I L]

/-- **The action of `ℤ̂` on an `I`-adically complete module.** For `a ∈ ℤ̂`, `F.zhatSMul I a x` is
the unique element of `L` whose reduction modulo every `Iᵏ L` is `a • (x mod Iᵏ L)`. -/
noncomputable def zhatSMul (F : L ≃ₗ[R] L) (I : Ideal R)
    [∀ k, Finite (L ⧸ (I ^ k • ⊤ : Submodule R L))] [IsAdicComplete I L] (a : Zhat) (x : L) : L :=
  (F.exists_zhatSMul I a x).choose

/-- The reduction of `a • x` modulo `Iᵏ L` is the finite-level action `zhatActionPow`. -/
theorem mkQ_zhatSMul (F : L ≃ₗ[R] L) (a : Zhat) (x : L) (k : ℕ) :
    (I ^ k • ⊤ : Submodule R L).mkQ (F.zhatSMul I a x) =
      F.zhatActionPow I k a ((I ^ k • ⊤ : Submodule R L).mkQ x) :=
  (F.exists_zhatSMul I a x).choose_spec k

/-- `F.zhatSMul I a x` is characterised by its reductions modulo the `Iᵏ L`. -/
theorem zhatSMul_eq_iff (F : L ≃ₗ[R] L) {a : Zhat} {x y : L} :
    F.zhatSMul I a x = y ↔ ∀ k, (I ^ k • ⊤ : Submodule R L).mkQ y =
      F.zhatActionPow I k a ((I ^ k • ⊤ : Submodule R L).mkQ x) := by
  refine ⟨fun h k ↦ h ▸ F.mkQ_zhatSMul a x k, fun h ↦ ?_⟩
  refine IsHausdorff.eq_iff_smodEq (I := I).2 fun k ↦ ?_
  rw [SModEq, ← Submodule.mkQ_apply, ← Submodule.mkQ_apply, mkQ_zhatSMul, h]

/-- The `ℤ̂`-action extends the action of `ℤ` by powers of `F`. -/
theorem zhatSMul_ofInt (F : L ≃ₗ[R] L) (n : ℤ) (x : L) :
    F.zhatSMul I (Zhat.ofInt n) x = (F ^ n) x :=
  F.zhatSMul_eq_iff.2 fun _ ↦ (F.zhatAction_ofInt_apply _ n x).symm

/-- `1 ∈ ℤ̂` acts trivially. -/
theorem zhatSMul_one (F : L ≃ₗ[R] L) (x : L) : F.zhatSMul I 1 x = x :=
  F.zhatSMul_eq_iff.2 fun _ ↦ by simp

/-- `(a * b) • x = a • (b • x)`. -/
theorem zhatSMul_mul (F : L ≃ₗ[R] L) (a b : Zhat) (x : L) :
    F.zhatSMul I (a * b) x = F.zhatSMul I a (F.zhatSMul I b x) := by
  refine (F.zhatSMul_eq_iff.2 fun k ↦ ?_).symm
  rw [mkQ_zhatSMul, mkQ_zhatSMul, map_mul, LinearEquiv.mul_apply]

/-- The action of each `a ∈ ℤ̂` is additive. -/
theorem zhatSMul_add (F : L ≃ₗ[R] L) (a : Zhat) (x y : L) :
    F.zhatSMul I a (x + y) = F.zhatSMul I a x + F.zhatSMul I a y :=
  F.zhatSMul_eq_iff.2 fun k ↦ by rw [map_add, map_add, map_add, mkQ_zhatSMul, mkQ_zhatSMul]

/-- The action of each `a ∈ ℤ̂` is `R`-linear. -/
theorem zhatSMul_smul (F : L ≃ₗ[R] L) (a : Zhat) (r : R) (x : L) :
    F.zhatSMul I a (r • x) = r • F.zhatSMul I a x :=
  F.zhatSMul_eq_iff.2 fun k ↦ by
    rw [LinearMap.map_smul, LinearMap.map_smul, LinearEquiv.map_smul, mkQ_zhatSMul]

/-- **Continuous extension to `ℤ̂`** (Weil II, 1.3.14, case `W = ℤ`). An automorphism `F` of an
`I`-adically complete module `L` with all `L ⧸ Iᵏ L` finite (e.g. a lattice over the ring of
integers of a finite extension of `ℚ_ℓ`, `I = (ℓ)`) extends to a homomorphism
`ℤ̂ →* GL(L)`, `ofInt n ↦ Fⁿ`, which is continuous for the `I`-adic topology
(`LinearEquiv.isLocallyConstant_mkQ_zhatHom_apply`). -/
noncomputable def zhatHom (F : L ≃ₗ[R] L) (I : Ideal R)
    [∀ k, Finite (L ⧸ (I ^ k • ⊤ : Submodule R L))] [IsAdicComplete I L] :
    Zhat →* (L ≃ₗ[R] L) where
  toFun a :=
    { toFun := F.zhatSMul I a
      map_add' := F.zhatSMul_add a
      map_smul' := F.zhatSMul_smul a
      invFun := F.zhatSMul I a⁻¹
      left_inv x := by rw [← zhatSMul_mul, inv_mul_cancel, zhatSMul_one]
      right_inv x := by rw [← zhatSMul_mul, mul_inv_cancel, zhatSMul_one] }
  map_one' := LinearEquiv.ext F.zhatSMul_one
  map_mul' a b := LinearEquiv.ext (F.zhatSMul_mul a b)

/-- `ℤ̂` acts on `L` through `LinearEquiv.zhatSMul`. -/
theorem zhatHom_apply (F : L ≃ₗ[R] L) (a : Zhat) (x : L) : F.zhatHom I a x = F.zhatSMul I a x :=
  rfl

/-- The extension of `n ↦ Fⁿ` to `ℤ̂`. -/
theorem zhatHom_ofInt (F : L ≃ₗ[R] L) (n : ℤ) : F.zhatHom I (Zhat.ofInt n) = F ^ n :=
  LinearEquiv.ext (F.zhatSMul_ofInt n)

/-- Continuity of the `ℤ̂`-action for the `I`-adic topology: for every `x` and `k`, the class of
`a • x` modulo `Iᵏ L` is a locally constant function of `a ∈ ℤ̂`. -/
theorem isLocallyConstant_mkQ_zhatHom_apply (F : L ≃ₗ[R] L) (x : L) (k : ℕ) :
    IsLocallyConstant fun a ↦ (I ^ k • ⊤ : Submodule R L).mkQ (F.zhatHom I a x) := by
  simp_rw [zhatHom_apply, mkQ_zhatSMul]
  exact (isLocallyConstant_zhatAction F _).comp fun e ↦ e _

omit hfin [IsAdicComplete I L] in
/-- **Uniqueness of the continuous extension to `ℤ̂`.** Two homomorphisms `ℤ̂ →* GL(L)` which
agree on `ℤ` and are continuous for the `I`-adic topology on an `I`-adically separated `L`
coincide. -/
theorem eq_of_isLocallyConstant_of_ofInt [IsHausdorff I L] {φ ψ : Zhat →* (L ≃ₗ[R] L)}
    (hφ : ∀ x k, IsLocallyConstant fun a ↦ (I ^ k • ⊤ : Submodule R L).mkQ (φ a x))
    (hψ : ∀ x k, IsLocallyConstant fun a ↦ (I ^ k • ⊤ : Submodule R L).mkQ (ψ a x))
    (h : ∀ n, φ (Zhat.ofInt n) = ψ (Zhat.ofInt n)) : φ = ψ := by
  refine MonoidHom.ext fun a ↦ LinearEquiv.ext fun x ↦ IsHausdorff.eq_iff_smodEq (I := I).2
    fun k ↦ ?_
  refine congrFun (eq_of_isLocallyConstant (hφ x k) (hψ x k) fun g ↦ ?_) a
  obtain ⟨n, rfl⟩ := (Multiplicative.ofAdd (α := ℤ)).surjective g
  exact congrArg (fun e : L ≃ₗ[R] L ↦ (I ^ k • ⊤ : Submodule R L).mkQ (e x)) (h n)

end LinearEquiv

namespace PadicInt

variable {ℓ : ℕ} [Fact ℓ.Prime] {L : Type} [AddCommGroup L] [Module ℤ_[ℓ] L]

/-- For a finitely generated `ℤ_ℓ`-module `L`, every `L ⧸ ℓᵏ L` is finite. -/
instance finite_quotient_span_pow_smul_top [Module.Finite ℤ_[ℓ] L] (k : ℕ) :
    Finite (L ⧸ (Ideal.span {(ℓ : ℤ_[ℓ])} ^ k • ⊤ : Submodule ℤ_[ℓ] L)) := by
  rw [Ideal.span_singleton_pow]
  exact Module.finite_of_finite (ℤ_[ℓ] ⧸ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k})

/-- **Weil II, 1.3.14, for `W = ℤ`: bounded Frobenius actions extend continuously to `ℤ̂`.**
Let `L` be a finitely generated `ℓ`-adically complete `ℤ_ℓ`-module (e.g. a lattice `𝒪_Eʳ` over
the ring of integers of a finite extension `E` of `ℚ_ℓ`; such a lattice is stable under a
bounded Frobenius) and `F` an automorphism of `L`. Then `n ↦ Fⁿ` extends uniquely to a
homomorphism `ℤ̂ →* GL(L)` which is continuous for the `ℓ`-adic topology on `L`. -/
theorem existsUnique_zhat_extension [Module.Finite ℤ_[ℓ] L]
    [IsAdicComplete (Ideal.span {(ℓ : ℤ_[ℓ])}) L] (F : L ≃ₗ[ℤ_[ℓ]] L) :
    ∃! φ : ProfiniteGrp.ProfiniteCompletion.Zhat →* (L ≃ₗ[ℤ_[ℓ]] L),
      (∀ n, φ (ProfiniteGrp.ProfiniteCompletion.Zhat.ofInt n) = F ^ n) ∧
      ∀ x k, IsLocallyConstant fun a ↦
        (Ideal.span {(ℓ : ℤ_[ℓ])} ^ k • ⊤ : Submodule ℤ_[ℓ] L).mkQ (φ a x) :=
  ⟨F.zhatHom _, ⟨F.zhatHom_ofInt, F.isLocallyConstant_mkQ_zhatHom_apply⟩, fun _ hψ ↦
    LinearEquiv.eq_of_isLocallyConstant_of_ofInt hψ.2 (F.isLocallyConstant_mkQ_zhatHom_apply)
      fun n ↦ (hψ.1 n).trans (F.zhatHom_ofInt n).symm⟩

end PadicInt

namespace PadicInt

variable {ℓ : ℕ} [Fact ℓ.Prime] {L : Type} [AddCommGroup L] [Module ℤ_[ℓ] L]

/-- A finite free `ℤ_ℓ`-module is `ℓ`-adically complete. -/
instance isAdicComplete_span_p_of_free [Module.Free ℤ_[ℓ] L] [Module.Finite ℤ_[ℓ] L] :
    IsAdicComplete (Ideal.span {(ℓ : ℤ_[ℓ])}) L :=
  IsAdicComplete.of_linearEquiv (Module.finBasis ℤ_[ℓ] L).equivFun.symm

/-- **Weil II, 1.3.14, for `W = ℤ` and a lattice.** If `F` is an automorphism of a lattice
`L ≅ ℤ_ℓʳ` (e.g. an `𝒪_E`-lattice, `E` a finite extension of `ℚ_ℓ`, viewed over `ℤ_ℓ`), then
`n ↦ Fⁿ` extends uniquely to an `ℓ`-adically continuous homomorphism `ℤ̂ →* GL(L)`. -/
theorem existsUnique_zhat_extension_of_free [Module.Free ℤ_[ℓ] L] [Module.Finite ℤ_[ℓ] L]
    (F : L ≃ₗ[ℤ_[ℓ]] L) :
    ∃! φ : ProfiniteGrp.ProfiniteCompletion.Zhat →* (L ≃ₗ[ℤ_[ℓ]] L),
      (∀ n, φ (ProfiniteGrp.ProfiniteCompletion.Zhat.ofInt n) = F ^ n) ∧
      ∀ x k, IsLocallyConstant fun a ↦
        (Ideal.span {(ℓ : ℤ_[ℓ])} ^ k • ⊤ : Submodule ℤ_[ℓ] L).mkQ (φ a x) :=
  existsUnique_zhat_extension F

end PadicInt
