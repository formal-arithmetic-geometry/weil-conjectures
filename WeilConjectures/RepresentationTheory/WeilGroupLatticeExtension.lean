/-!
# Bounded representations of Weil groups extend to the arithmetic fundamental group

Let `α : W →* P` be a homomorphism with dense image from an (abstract) Weil group `W` to a
topological group `P` (the arithmetic fundamental group `π₁(X₀)`), and let `W` be generated by
the image of a compact group `N` (the geometric fundamental group `π₁(X)`) and finitely many
elements (a Frobenius). Deligne (Weil II, 1.1.7 and 1.3.14) shows that a finite-dimensional
`ℚ̄_ℓ`-representation `ρ` of `W` which is bounded, and continuous on `N`, extends continuously to
`P`, provided the topology of `P` restricts on `W` to the topology defined by the normal
subgroups of finite index of `W` which are open on `N`.

The proof: `ρ` stabilises a lattice `L`
(`MonoidHom.exists_lattice_of_isWeaklyBounded_of_compactSpace`),
the congruence kernels `ker(W → GL(L / ℓᵏ L))` are normal of finite index and open on `N`, so the
matrix of `ρ` on `L` is uniformly continuous for the uniform structure of `P` and extends
continuously to `P` (`DenseRange.exists_continuous_extend_of_forall_mul_inv_mem`); the extension
is again a representation by density.

## Main results

* `DenseRange.exists_continuous_extend_of_forall_mul_inv_mem`: extension of maps from a group
  with a dense homomorphism to a topological group into a complete space.
* `Representation.exists_continuous_extension_of_isBoundedOn_of_finiteIndex`: the extension of
  bounded representations.
-/

@[expose] public section

open Filter Topology Uniformity

/-- **Extension along a dense homomorphism.** Let `α : W → P` have dense range in a topological
group `P`, and let `f : W → Y` be a map to a complete Hausdorff uniform space which is uniformly
continuous for the right uniform structure of `P` pulled back along `α`: for every entourage
`U` there is a neighbourhood `O` of `1` such that `(f w₁, f w₂) ∈ U` whenever
`α w₂ * (α w₁)⁻¹ ∈ O`. Then `f` extends to a continuous map `P → Y`. -/
theorem DenseRange.exists_continuous_extend_of_forall_mul_inv_mem {W P Y : Type*} [Group P]
    [TopologicalSpace P] [IsTopologicalGroup P] [UniformSpace Y] [CompleteSpace Y] [T0Space Y]
    {α : W → P} (hα : DenseRange α) (f : W → Y)
    (hf : ∀ U ∈ 𝓤 Y, ∃ O ∈ 𝓝 (1 : P), ∀ w₁ w₂, α w₂ * (α w₁)⁻¹ ∈ O → (f w₁, f w₂) ∈ U) :
    ∃ F : P → Y, Continuous F ∧ ∀ w, F (α w) = f w := by
  let uP : UniformSpace P := IsTopologicalGroup.rightUniformSpace P
  let _ : UniformSpace W := UniformSpace.comap α uP
  have he : IsUniformInducing α := ⟨rfl⟩
  have hfu : UniformContinuous f := by
    intro U hU
    obtain ⟨O, hO, h⟩ := hf U hU
    refine ⟨{p : P × P | p.2 * p.1⁻¹ ∈ O}, ⟨O, hO, fun _ hp ↦ hp⟩, fun p hp ↦ h p.1 p.2 hp⟩
  exact ⟨(he.isDenseInducing hα).extend f,
    (uniformContinuous_uniformly_extend he hα hfu).continuous, uniformly_extend_of_ind he hα hfu⟩

/-- The congruence ideals `ℓᵏ ℤ_ℓ` of `ℤ_ℓ` are open. -/
theorem PadicInt.isOpen_span_pow {ℓ : ℕ} [Fact ℓ.Prime] (k : ℕ) :
    IsOpen {z : ℤ_[ℓ] | z ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k}} := by
  have h : {z : ℤ_[ℓ] | z ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k}} =
      Metric.closedBall 0 ((ℓ : ℝ) ^ (-(k : ℤ))) := by
    ext z
    rw [Set.mem_ofPred_eq, ← PadicInt.norm_le_pow_iff_mem_span_pow, Metric.mem_closedBall,
      dist_zero_right]
  rw [h]
  refine IsUltrametricDist.isOpen_closedBall _ (zpow_ne_zero _ ?_)
  exact_mod_cast (Fact.out : ℓ.Prime).ne_zero

/-- In a free module, `x ∈ I • M` if and only if all coordinates of `x` lie in `I`. -/
theorem Module.Basis.mem_ideal_smul_top_iff {R M ι : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [Finite ι] (b : Module.Basis ι R M) (I : Ideal R) (x : M) :
    x ∈ I • (⊤ : Submodule R M) ↔ ∀ i, b.repr x i ∈ I := by
  have hmap : (I • ⊤ : Submodule R M).map b.equivFun.toLinearMap = I • ⊤ := by
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
  have h := Ideal.mem_smul_top_pi_iff I (b.equivFun x)
  simp only [Module.Basis.equivFun_apply] at h
  rw [← h, ← hmap]
  constructor
  · exact fun hx ↦ Submodule.mem_map_of_mem hx
  · rintro ⟨y, hy, hxy⟩
    rwa [b.equivFun.injective hxy] at hy

/-- A linear map `F` with `F (b i) - b i ∈ N` on a basis has `F x - x ∈ N` everywhere. -/
theorem Module.Basis.sub_mem_of_forall_basis {R M ι : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [Finite ι] (b : Module.Basis ι R M) {N : Submodule R M} (F : M →ₗ[R] M)
    (h : ∀ i, F (b i) - b i ∈ N) (x : M) : F x - x ∈ N := by
  have := Fintype.ofFinite ι
  rw [← b.sum_repr x, map_sum, ← Finset.sum_sub_distrib]
  refine N.sum_mem fun i _ ↦ ?_
  rw [map_smul, ← smul_sub]
  exact N.smul_mem _ (h i)

namespace LinearEquiv

variable {R L W : Type*} [CommRing R] [AddCommGroup L] [Module R L] [Group W]

/-- The action of `W` on `L ⧸ I L` induced by an action on `L`. -/
noncomputable def quotientIdealSmulTopHom (ρ : W →* (L ≃ₗ[R] L)) (I : Ideal R) :
    W →* ((L ⧸ (I • ⊤ : Submodule R L)) ≃ₗ[R] (L ⧸ (I • ⊤ : Submodule R L))) where
  toFun w := Submodule.Quotient.equiv _ _ (ρ w) ((ρ w).map_ideal_smul_top I)
  map_one' := by
    ext x
    induction x using Submodule.Quotient.induction_on
    simp
  map_mul' w w' := by
    ext x
    induction x using Submodule.Quotient.induction_on
    simp

/-- An element acts trivially on `L ⧸ I L` iff it moves every vector by an element of `I L`. -/
theorem mem_ker_quotientIdealSmulTopHom {ρ : W →* (L ≃ₗ[R] L)} {I : Ideal R} {w : W} :
    w ∈ (quotientIdealSmulTopHom ρ I).ker ↔ ∀ x, ρ w x - x ∈ (I • ⊤ : Submodule R L) := by
  rw [MonoidHom.mem_ker, LinearEquiv.ext_iff]
  refine ⟨fun h x ↦ ?_, fun h x ↦ ?_⟩
  · have := h (Submodule.Quotient.mk x)
    rwa [LinearEquiv.coe_one, id_eq, quotientIdealSmulTopHom, MonoidHom.coe_mk, OneHom.coe_mk,
      Submodule.Quotient.equiv_apply, Submodule.mapQ_apply, LinearEquiv.coe_coe,
      Submodule.Quotient.eq] at this
  · induction x using Submodule.Quotient.induction_on with
    | H x =>
      rw [LinearEquiv.coe_one, id_eq, quotientIdealSmulTopHom, MonoidHom.coe_mk, OneHom.coe_mk,
        Submodule.Quotient.equiv_apply, Submodule.mapQ_apply, LinearEquiv.coe_coe,
      Submodule.Quotient.eq]
      exact h x

/-- If `L ⧸ I L` is finite, the kernel of the action on it has finite index. -/
theorem finiteIndex_ker_quotientIdealSmulTopHom [Module.Finite R L] (ρ : W →* (L ≃ₗ[R] L))
    (I : Ideal R) [Finite (R ⧸ I)] : (quotientIdealSmulTopHom ρ I).ker.FiniteIndex := by
  have : Finite (L ⧸ (I • ⊤ : Submodule R L)) := Module.finite_of_finite (R ⧸ I)
  have : Finite ((L ⧸ (I • ⊤ : Submodule R L)) ≃ₗ[R] (L ⧸ (I • ⊤ : Submodule R L))) :=
    Finite.of_injective (fun e ↦ (e : L ⧸ (I • ⊤ : Submodule R L) → L ⧸ (I • ⊤ : Submodule R L)))
      DFunLike.coe_injective
  exact Subgroup.finiteIndex_ker _

end LinearEquiv

namespace Representation

open Module

variable {ℓ : ℕ} [Fact ℓ.Prime] {V : Type*} [AddCommGroup V] [Module (PadicAlgCl ℓ) V]
  {L : Type*} [AddCommGroup L] [Module ℤ_[ℓ] L] {κ : Type*}

/-- A semilinear map `j : L → V` from a free `ℤ_ℓ`-module expands in a basis `b` of `L` as
`j x = ∑ₐ xₐ j(bₐ)`. -/
theorem lattice_apply_eq_sum [Fintype κ] (j : L →+ V)
    (hsmul : ∀ (a : ℤ_[ℓ]) x, j (a • x) = algebraMap ℤ_[ℓ] (PadicAlgCl ℓ) a • j x)
    (b : Basis κ ℤ_[ℓ] L) (x : L) :
    j x = ∑ a, algebraMap ℤ_[ℓ] (PadicAlgCl ℓ) (b.repr x a) • j (b a) := by
  conv_lhs => rw [← b.sum_repr x]
  rw [map_sum]
  simp_rw [hsmul]

/-- The linear forms of `V` are continuous on the `ℤ_ℓ`-coordinates of a lattice. -/
theorem continuous_apply_lattice [Finite κ] (j : L →+ V)
    (hsmul : ∀ (a : ℤ_[ℓ]) x, j (a • x) = algebraMap ℤ_[ℓ] (PadicAlgCl ℓ) a • j x)
    (b : Basis κ ℤ_[ℓ] L) (φ : Dual (PadicAlgCl ℓ) V) :
    Continuous fun z : κ → ℤ_[ℓ] ↦ φ (j (b.equivFun.symm z)) := by
  have := Fintype.ofFinite κ
  have h (z : κ → ℤ_[ℓ]) : φ (j (b.equivFun.symm z)) =
      ∑ a, algebraMap ℤ_[ℓ] (PadicAlgCl ℓ) (z a) * φ (j (b a)) := by
    rw [lattice_apply_eq_sum j hsmul b, map_sum]
    simp only [map_smul, smul_eq_mul, ← Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
  simp_rw [h]
  exact continuous_finsetSum _ fun a _ ↦
    (PadicAlgCl.continuous_algebraMap_padicInt.comp (continuous_apply a)).mul continuous_const

/-- An injective semilinear map `j : L → V` from a lattice is a closed embedding on coordinates:
`z ↦ (bᵥ-coordinates of j(∑ zₐ bₐ))` is a closed embedding of `ℤ_ℓ^κ` into `ℚ̄_ℓ^n`. -/
theorem isClosedEmbedding_lattice [Finite κ] [FiniteDimensional (PadicAlgCl ℓ) V] (j : L →+ V)
    (hj : Function.Injective j)
    (hsmul : ∀ (a : ℤ_[ℓ]) x, j (a • x) = algebraMap ℤ_[ℓ] (PadicAlgCl ℓ) a • j x)
    (b : Basis κ ℤ_[ℓ] L) :
    Topology.IsClosedEmbedding fun (z : κ → ℤ_[ℓ]) (i : Fin (finrank (PadicAlgCl ℓ) V)) ↦
      (finBasis (PadicAlgCl ℓ) V).coord i (j (b.equivFun.symm z)) := by
  refine Continuous.isClosedEmbedding
    (continuous_pi fun i ↦ continuous_apply_lattice j hsmul b _) fun z z' h ↦ ?_
  refine b.equivFun.symm.injective (hj ((finBasis (PadicAlgCl ℓ) V).ext_elem fun i ↦ ?_))
  exact congrFun h i

/-- The coordinates of `A (B v)` in a basis, in terms of those of `B v` and of `A`. -/
theorem _root_.Module.Basis.coord_apply_apply {R M ι : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [Fintype ι] (b : Basis ι R M) (A B : M →ₗ[R] M) (v : M) (i : ι) :
    b.coord i (A (B v)) = ∑ m, b.coord m (B v) * b.coord i (A (b m)) := by
  conv_lhs => rw [← b.sum_repr (B v)]
  rw [map_sum, map_sum]
  simp only [map_smul, smul_eq_mul, Basis.coord_apply]

/-- **Bounded representations of Weil groups extend continuously** (Deligne, Weil II, 1.1.7 and
the proof of 1.3.14). Let `W` be generated by the image of a compact group `N` and a finite set
`S`, let `α : W →* P` have dense image in a topological group `P`, and assume that every normal
subgroup of finite index of `W` which is open on `N` contains the preimage of a neighbourhood of
`1` of `P`. Then every finite-dimensional `ℚ̄_ℓ`-representation `ρ` of `W` which is bounded, and
continuous on `N`, is `τ ∘ α` for a continuous representation `τ` of `P`. -/
theorem exists_continuous_extension_of_isBoundedOn_of_finiteIndex {W N P : Type*} [Group W]
    [Group N] [TopologicalSpace N] [IsTopologicalGroup N] [CompactSpace N] [T2Space N] [Group P]
    [TopologicalSpace P] [IsTopologicalGroup P] [FiniteDimensional (PadicAlgCl ℓ) V]
    (ρ : Representation (PadicAlgCl ℓ) W V) (ι : N →* W) {S : Set W} (hS : S.Finite)
    (hgen : Subgroup.closure (Set.range ι ∪ S) = ⊤) (hcont : ρ.IsContinuousOn ι)
    (hbdd : ρ.IsBoundedOn Set.univ) (α : W →* P) (hα : DenseRange α)
    (hopen : ∀ H : Subgroup W, H.Normal → H.FiniteIndex → IsOpen (ι ⁻¹' H : Set N) →
      ∃ O ∈ 𝓝 (1 : P), ∀ w, α w ∈ O → w ∈ H) :
    ∃ τ : Representation (PadicAlgCl ℓ) P V, (∀ w, τ (α w) = ρ w) ∧
      τ.IsContinuousOn (MonoidHom.id P) := by
  classical
  let ρ' : W →* (V ≃ₗ[PadicAlgCl ℓ] V) :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv (PadicAlgCl ℓ) V).toMonoidHom.comp
      ρ.asGroupHom
  have hρ' (w : W) (v : V) : ρ' w v = ρ w v := rfl
  obtain ⟨L, _, _, _, _, ρL, j, hj, hsmul, hint, hspan⟩ :=
    MonoidHom.exists_lattice_of_isWeaklyBounded_of_compactSpace ρ' ι hS hgen
      (fun v φ ↦ hcont φ v) (fun v ↦ by simpa only [Set.image_univ, hρ'] using hbdd v)
  set bL := Module.Free.chooseBasis ℤ_[ℓ] L
  set bV := finBasis (PadicAlgCl ℓ) V
  -- the action of `N` on the coordinates of the lattice is continuous
  have hgeom (a : Module.Free.ChooseBasisIndex ℤ_[ℓ] L) :
      Continuous fun g : N ↦ bL.equivFun (ρL (ι g) (bL a)) := by
    rw [(isClosedEmbedding_lattice j hj hsmul bL).continuous_iff]
    refine continuous_pi fun i ↦ ?_
    simp only [Function.comp_apply, LinearEquiv.symm_apply_apply, hint, hρ']
    exact hcont _ _
  -- the congruence kernels `ker(W → GL(L / ℓⁿ L))`
  let H (n : ℕ) := (LinearEquiv.quotientIdealSmulTopHom ρL (Ideal.span {(ℓ : ℤ_[ℓ]) ^ n})).ker
  have hH (n : ℕ) (w : W) : w ∈ H n ↔ ∀ a b,
      bL.equivFun (ρL w (bL a)) b - bL.equivFun (bL a) b ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} := by
    rw [LinearEquiv.mem_ker_quotientIdealSmulTopHom]
    refine ⟨fun h a b ↦ ?_, fun h ↦ bL.sub_mem_of_forall_basis (ρL w).toLinearMap fun a ↦ ?_⟩
    · have := (bL.mem_ideal_smul_top_iff _ _).1 (h (bL a)) b
      simpa only [map_sub, Finsupp.coe_sub, Pi.sub_apply, Basis.equivFun_apply] using this
    · refine (bL.mem_ideal_smul_top_iff _ _).2 fun b ↦ ?_
      simpa only [map_sub, Finsupp.coe_sub, Pi.sub_apply, Basis.equivFun_apply,
        LinearEquiv.coe_coe] using h a b
  have hHopen (n : ℕ) : IsOpen (ι ⁻¹' (H n : Set W)) := by
    have : ι ⁻¹' (H n : Set W) = ⋂ a, ⋂ b, (fun g ↦ bL.equivFun (ρL (ι g) (bL a)) b -
        bL.equivFun (bL a) b) ⁻¹' {z | z ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n}} := by
      ext g
      simp only [Set.mem_preimage, SetLike.mem_coe, hH, Set.mem_iInter, Set.mem_ofPred_eq]
    rw [this]
    exact isOpen_iInter_of_finite fun a ↦ isOpen_iInter_of_finite fun b ↦
      (PadicInt.isOpen_span_pow n).preimage
        (((continuous_apply b).comp (hgeom a)).sub continuous_const)
  -- the matrix of `ρ` on the lattice extends continuously to `P`
  let f : W → Module.Free.ChooseBasisIndex ℤ_[ℓ] L → Module.Free.ChooseBasisIndex ℤ_[ℓ] L →
      ℤ_[ℓ] := fun w a ↦ bL.equivFun (ρL w (bL a))
  obtain ⟨F, hF, hFα⟩ := hα.exists_continuous_extend_of_forall_mul_inv_mem f fun U hU ↦ by
    obtain ⟨ε, hε, hεU⟩ := Metric.mem_uniformity_dist.1 hU
    have hℓ : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hε (inv_lt_one_of_one_lt₀ hℓ)
    obtain ⟨O, hO, hOH⟩ := hopen (H n) inferInstance
      (LinearEquiv.finiteIndex_ker_quotientIdealSmulTopHom _ _) (hHopen n)
    refine ⟨O, hO, fun w₁ w₂ h ↦ hεU (lt_of_le_of_lt ?_ hn)⟩
    have hw : w₂ * w₁⁻¹ ∈ H n := hOH _ (by rwa [map_mul, map_inv])
    rw [LinearEquiv.mem_ker_quotientIdealSmulTopHom] at hw
    refine (dist_pi_le_iff (by positivity)).2 fun a ↦
      (dist_pi_le_iff (by positivity)).2 fun b ↦ ?_
    have h₁ := (bL.mem_ideal_smul_top_iff _ _).1 (hw (ρL w₁ (bL a))) b
    rw [← LinearEquiv.mul_apply, ← map_mul, inv_mul_cancel_right] at h₁
    have h₂ := (PadicInt.norm_le_pow_iff_mem_span_pow _ n).2 h₁
    rw [map_sub, Finsupp.coe_sub, Pi.sub_apply, zpow_neg, zpow_natCast, ← inv_pow] at h₂
    rw [dist_eq_norm, norm_sub_rev]
    simpa only [f, Basis.equivFun_apply] using h₂
  -- the representation of `P`
  have hspan' : Submodule.span (PadicAlgCl ℓ) (Set.range fun a ↦ j (bL a)) = ⊤ := by
    refine eq_top_iff.2 (hspan ▸ Submodule.span_le.2 ?_)
    rintro _ ⟨x, rfl⟩
    rw [lattice_apply_eq_sum j hsmul bL x]
    exact Submodule.sum_mem _ fun a _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
  choose c hc using fun i ↦ (Submodule.mem_span_range_iff_exists_fun (PadicAlgCl ℓ)).1
    (hspan' ▸ Submodule.mem_top : bV i ∈ Submodule.span (PadicAlgCl ℓ)
      (Set.range fun a ↦ j (bL a)))
  let T (y : Module.Free.ChooseBasisIndex ℤ_[ℓ] L → Module.Free.ChooseBasisIndex ℤ_[ℓ] L →
      ℤ_[ℓ]) : V →ₗ[PadicAlgCl ℓ] V :=
    bV.constr (PadicAlgCl ℓ) fun i ↦ ∑ a, c i a • j (bL.equivFun.symm (y a))
  have hT (w : W) : T (f w) = ρ w := bV.ext fun i ↦ by
    rw [Basis.constr_basis]
    simp only [f, LinearEquiv.symm_apply_apply, hint, hρ']
    rw [← hc i, map_sum]
    simp only [map_smul]
  have hTcont (φ : Dual (PadicAlgCl ℓ) V) (v : V) : Continuous fun y ↦ φ (T y v) := by
    have h (y) : φ (T y v) = ∑ i, bV.equivFun v i *
        ∑ a, c i a * φ (j (bL.equivFun.symm (y a))) := by
      simp only [T, Basis.constr_apply_fintype, map_sum, map_smul, smul_eq_mul]
    simp_rw [h]
    exact continuous_finsetSum _ fun i _ ↦ continuous_const.mul (continuous_finsetSum _
      fun a _ ↦ continuous_const.mul ((continuous_apply_lattice j hsmul bL φ).comp
        (continuous_apply a)))
  have hmul (p q : P) : T (F (p * q)) = T (F p) * T (F q) := by
    refine LinearMap.ext fun v ↦ bV.ext_elem fun i ↦ ?_
    have key := Continuous.ext_on (hα.prodMap hα)
      (f := fun x : P × P ↦ bV.coord i (T (F (x.1 * x.2)) v))
      (g := fun x : P × P ↦ ∑ m, bV.coord m (T (F x.2) v) * bV.coord i (T (F x.1) (bV m)))
      ((hTcont _ v).comp (hF.comp continuous_mul))
      (continuous_finsetSum _ fun m _ ↦ ((hTcont _ v).comp (hF.comp continuous_snd)).mul
        ((hTcont _ _).comp (hF.comp continuous_fst)))
      (by
        rintro _ ⟨⟨w₁, w₂⟩, rfl⟩
        simp only [Prod.map_fst, Prod.map_snd, ← map_mul, hFα, hT]
        rw [← bV.coord_apply_apply, map_mul, Module.End.mul_apply])
    have := congrFun key (p, q)
    simp only at this
    rw [← Basis.coord_apply, ← Basis.coord_apply, this, Module.End.mul_apply,
      bV.coord_apply_apply]
  let τ : Representation (PadicAlgCl ℓ) P V :=
    { toFun p := T (F p)
      map_one' := by rw [← map_one α, hFα, hT, map_one]
      map_mul' := hmul }
  exact ⟨τ, fun w ↦ (congrArg T (hFα w)).trans (hT w), fun φ v ↦ (hTcont φ v).comp hF⟩

end Representation
