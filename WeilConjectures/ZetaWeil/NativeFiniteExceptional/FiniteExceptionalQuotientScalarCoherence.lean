/-! # Actual finite quotient coefficient identities

Source: latest blueprint, part-duality-trace-formula/sec-poincare-duality/
sec-perfect-complexes-on-the-point-and-two-exchange-formulas/sk-def-ops/sk-thm-sf-package/
lem-coef-finite-exceptional.proof.md, tensor associativity and unit normalization
(blueprint: def-sf-finite-exceptional-quotient-scalar-coherence).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
universe u
open CategoryTheory AlgebraicGeometry
open AlgebraicGeometry.ProEtale.CondensedRing

namespace WeilConjectures.NativeFiniteExceptional

variable (ell : ℕ) [Fact ell.Prime] (E : Type u) [Field E]
  [Algebra (Padic ell) E] [FiniteDimensional (Padic ell) E]

/-- Quotient maps compose as actual condensed coefficient maps.
Source: latest blueprint finite quotient convention and tensor associativity
(blueprint: def-sf-finite-exceptional-quotient-scalar-coherence).
Proof: quotient induction gives equality on residue classes. Postcomposition with
these ring maps gives equality on continuous functions, and the forgetful functor
preserves composition. No coefficient flatness is used. -/
theorem supportQuotientScalar_comp {r m n : ℕ} (h : m ≤ r) (k : n ≤ m) :
    quotientScalar ell E h ≫ quotientScalar ell E k = quotientScalar ell E (k.trans h) := by
  sorry

/-- The equal-index quotient is the identity condensed coefficient map.
Source: latest blueprint finite quotient convention and unit normalization
(blueprint: def-sf-finite-exceptional-quotient-scalar-coherence).
Proof: the quotient factor sends every residue class to itself. Its postcomposition
on continuous functions is the identity, as is its image under the forgetful functor. -/
theorem supportQuotientScalar_id (n : ℕ) :
    quotientScalar ell E (le_refl n) = 𝟙 (coefficient ell E n) := by
  sorry

/-- Restrict the prescribed tensor associator, with the quotient-composition equality.
Source: latest blueprint, tensor associativity in the final proof paragraph
(blueprint: def-sf-finite-exceptional-quotient-scalar-coherence). -/
def finiteSupportTower (T : Scheme.{u}) {r m n : ℕ} (h : m ≤ r) (k : n ≤ m) :
    Q ell E T h ⋙ Q ell E T k ≅ Q ell E T (k.trans h) := by
  let e := Functor.isoWhiskerLeft (domain ell E T r).ι
    ((scalarSixTower (quotientScalar ell E h) (quotientScalar ell E k) T) ≪≫
      eqToIso (congrArg (fun a ↦ scalarSixChange a T)
        (supportQuotientScalar_comp ell E h k)))
  let ff := (domain ell E T n).fullyFaithfulι.whiskeringRight
    (domain ell E T r).FullSubcategory
  exact ff.preimageIso e

/-- Restrict the normalized scalar unit, with the equal-index quotient equality.
Source: latest blueprint, unit normalization in the final proof paragraph
(blueprint: def-sf-finite-exceptional-quotient-scalar-coherence). -/
def finiteSupportUnit (T : Scheme.{u}) (n : ℕ) :
    Q ell E T (le_refl n) ≅ 𝟭 (domain ell E T n).FullSubcategory := by
  let e := Functor.isoWhiskerLeft (domain ell E T n).ι
    (eqToIso (congrArg (fun a ↦ scalarSixChange a T)
      (supportQuotientScalar_id ell E n)) ≪≫ scalarChangeUnit (coefficient ell E n) T)
  let ff := (domain ell E T n).fullyFaithfulι.whiskeringRight
    (domain ell E T n).FullSubcategory
  exact ff.preimageIso e

end WeilConjectures.NativeFiniteExceptional
