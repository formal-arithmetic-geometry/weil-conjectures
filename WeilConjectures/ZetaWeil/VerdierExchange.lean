/-- Formal biduality construction used for the second and fourth exchanges.
Source: Verdier exchange, proof step 3 (blueprint: sk-thm-sf-verdier-exchange). -/
def verdierBidualExchangeIso
    {C D : Type*} [Category* C] [Category* D]
    (DC : Cᵒᵖ ⥤ C) (DD : Dᵒᵖ ⥤ D)
    (bC : 𝟭 C ≅ DC.rightOp ⋙ DC) (bD : 𝟭 D ≅ DD.rightOp ⋙ DD)
    (F G : C ⥤ D) (e : F.op ⋙ DD ≅ DC ⋙ G) :
    DC ⋙ F ≅ G.op ⋙ DD := by
  let a : G ≅ DC.rightOp ⋙ (F.op ⋙ DD) :=
    (Functor.leftUnitor G).symm ≪≫ Functor.isoWhiskerRight bC G ≪≫
      Functor.associator DC.rightOp DC G ≪≫ Functor.isoWhiskerLeft DC.rightOp e.symm
  exact (Functor.rightUnitor (DC ⋙ F)).symm ≪≫
    Functor.isoWhiskerLeft (DC ⋙ F) bD ≪≫
    Functor.isoWhiskerRight (NatIso.op a) DD

private theorem bidualExchangeIso_hom
    {C D : Type*} [Category* C] [Category* D]
    (DC : Cᵒᵖ ⥤ C) (DD : Dᵒᵖ ⥤ D)
    (bC : 𝟭 C ≅ DC.rightOp ⋙ DC) (bD : 𝟭 D ≅ DD.rightOp ⋙ DD)
    (F G : C ⥤ D) (e : F.op ⋙ DD ≅ DC ⋙ G) (K : C) :
    (verdierBidualExchangeIso DC DD bC bD F G e).hom.app (op K) =
      (bD.app (F.obj (DC.obj (op K)))).hom ≫
        DD.map ((G.map (bC.app K).hom ≫ (e.app (op (DC.obj (op K)))).inv).op) := by
  simp [verdierBidualExchangeIso]

private theorem inverseExchangeSquare
    {C : Type*} [Category* C] {X Y X' Y' : C}
    (e : X ≅ Y) (e' : X' ≅ Y') (p : X ⟶ X') (q : Y ⟶ Y')
    (h : e.hom ≫ q = p ≫ e'.hom) : e.inv ≫ p = q ≫ e'.inv := by
  rw [Iso.inv_comp_eq, ← Category.assoc, h, Category.assoc,
    Iso.hom_inv_id, Category.comp_id]

private theorem mateTerminalComposition
    {A B C D : Type*} [Category* A] [Category* B] [Category* C] [Category* D]
    {F : A ⥤ B} {R : B ⥤ A} (af : F ⊣ R)
    {G : B ⥤ C} {S : C ⥤ B} (ag : G ⊣ S)
    {H : C ⥤ D} {T : D ⥤ C} (ah : H ⊣ T)
    {P : A ⥤ C} {Q : C ⥤ A} (ap : P ⊣ Q)
    {AY : B ⥤ D} {RY : D ⥤ B} (ay : AY ⊣ RY)
    {AX : A ⥤ D} {RX : D ⥤ A} (ax : AX ⊣ RX)
    (c : F ⋙ G ≅ P) (d : G ⋙ H ≅ AY) (e : F ⋙ AY ≅ AX) (p : P ⋙ H ≅ AX)
    (h : Functor.isoWhiskerRight c H ≪≫ p =
      Functor.associator F G H ≪≫ Functor.isoWhiskerLeft F d ≪≫ e) (K : D) :
    R.map ((conjugateIsoEquiv (ag.comp ah) ay d.symm).hom.app K) ≫
      (conjugateIsoEquiv (af.comp ay) ax e.symm).hom.app K =
    (conjugateIsoEquiv (af.comp ag) ap c.symm).hom.app (T.obj K) ≫
      (conjugateIsoEquiv (ap.comp ah) ax p.symm).hom.app K := by
  have hh := congrArg (fun z ↦
    conjugateIsoEquiv ((af.comp ag).comp ah) ax z.symm) h
  simp only [Iso.trans_symm, Functor.isoWhiskerRight_symm,
    Functor.isoWhiskerLeft_symm] at hh
  rw [conjugateIsoEquiv_trans _ (ap.comp ah),
    conjugateIsoEquiv_trans _ (af.comp (ag.comp ah)),
    conjugateIsoEquiv_trans _ (af.comp ay),
    conjugateIsoEquiv_isoWhiskerRight, conjugateIsoEquiv_isoWhiskerLeft,
    conjugateIsoEquiv_iso_symm] at hh
  simp only [conjugateIsoEquiv_iso_symm, conjugateIsoEquiv_associator] at hh
  simpa only [Iso.trans_hom, NatTrans.comp_app, Functor.isoWhiskerLeft_hom,
    Functor.whiskerLeft_app, Functor.isoWhiskerRight_hom, Functor.whiskerRight_app,
    Functor.associator_inv_app, Category.id_comp, Iso.symm_hom,
    conjugateIsoEquiv_iso_symm] using
      (congrArg (fun z ↦ z.hom.app K) hh).symm

private theorem normalizeTerminalCompositors
    {A B C D : Type*} [Category* A] [Category* B] [Category* C] [Category* D]
    (F : A ⥤ B) (G : B ⥤ C) (H : C ⥤ D) (P : A ⥤ C)
    {I J : Type*} (M : I → B ⥤ D) (N : J → A ⥤ D) (u : I → J)
    (c : F ⋙ G ≅ P) {a b : I} {x t : J}
    (hi : a = b) (hx : x = u a) (hj : u b = t)
    (d : G ⋙ H ≅ M a) (p : P ⋙ H ≅ N x)
    (e : ∀ i, F ⋙ M i ≅ N (u i))
    (ha : Functor.isoWhiskerRight c H ≪≫ p ≪≫ eqToIso (congrArg N hx) =
      Functor.associator F G H ≪≫ Functor.isoWhiskerLeft F d ≪≫ e a) :
    Functor.isoWhiskerRight c H ≪≫ p ≪≫
        eqToIso (congrArg N (hx.trans ((congrArg u hi).trans hj))) =
      Functor.associator F G H ≪≫
        Functor.isoWhiskerLeft F (d ≪≫ eqToIso (congrArg M hi)) ≪≫
          e b ≪≫ eqToIso (congrArg N hj) := by
  cases hi
  cases hj
  cases hx
  simpa only [eqToIso_refl, Iso.trans_refl, Functor.isoWhiskerLeft_trans,
    Functor.isoWhiskerLeft_refl] using ha

private theorem naturality_paste
    {C D E : Type*} [Category C] [Category D] [Category E]
    (Q : C ⥤ E) (F : C ⥤ D) (G : D ⥤ E) (d : Q ≅ F ⋙ G)
    {A₀ A₁ A₂ A₃ : C} {B₀ B₁ : D} {V W : E}
    (a : V ⟶ Q.obj A₀) (e : A₀ ⟶ A₁) (j : A₁ ⟶ A₂) (k : A₂ ⟶ A₃)
    (t : V ⟶ W) (b : W ⟶ G.obj B₀) (c : B₀ ⟶ F.obj A₁)
    (l : B₀ ⟶ B₁) (m : B₁ ⟶ F.obj A₂)
    (hc : a ≫ Q.map e ≫ d.hom.app A₁ = t ≫ b ≫ G.map c)
    (hn : l ≫ m = c ≫ F.map j) :
    a ≫ Q.map (e ≫ j ≫ k) ≫ d.hom.app A₃ =
      t ≫ b ≫ G.map l ≫ G.map (m ≫ F.map k) := by
  have hd := d.hom.naturality (j ≫ k)
  change Q.map (j ≫ k) ≫ d.hom.app A₃ =
    d.hom.app A₁ ≫ G.map (F.map (j ≫ k)) at hd
  calc
    _ = (a ≫ Q.map e ≫ d.hom.app A₁) ≫ G.map (F.map (j ≫ k)) := by
      rw [Q.map_comp, Category.assoc, hd]
      simp only [Category.assoc]
    _ = (t ≫ b ≫ G.map c) ≫ G.map (F.map (j ≫ k)) :=
      congrArg (fun z ↦ z ≫ G.map (F.map (j ≫ k))) hc
    _ = _ := by
      simp only [Functor.map_comp, Category.assoc]
      rw [← G.map_comp_assoc, ← hn]
      simp only [Functor.map_comp, Category.assoc]

private theorem evaluationPairing_naturality
    {C : Type*} [Category* C] [MonoidalCategory C] [BraidedCategory C]
    [MonoidalClosed C] {L L' W Q Q' : C}
    (a : L ⟶ L') (c : Q' ⟶ Q) (e : Q ⟶ (ihom L).obj W)
    (e' : Q' ⟶ (ihom L').obj W)
    (h : c ≫ e = e' ≫ (MonoidalClosed.pre a).app W) :
    c ▷ L ≫ e ▷ L ≫ (β_ ((ihom L).obj W) L).hom ≫ (ihom.ev L).app W =
      Q' ◁ a ≫ e' ▷ L' ≫ (β_ ((ihom L').obj W) L').hom ≫ (ihom.ev L').app W := by
  rw [← comp_whiskerRight_assoc, h, comp_whiskerRight_assoc,
    BraidedCategory.braiding_naturality_left_assoc,
    MonoidalClosed.id_tensor_pre_app_comp_ev,
    ← BraidedCategory.braiding_naturality_right_assoc, whisker_exchange_assoc]

private theorem fourStepPaste
    {C : Type*} [Category* C]
    {A₀ A₁ A₂ A₃ B₁ B₂ B₃ C₁ C₂ C₃ : C}
    (u : A₀ ⟶ A₁) (v : A₁ ⟶ A₂) (w : A₂ ⟶ A₃)
    (r : A₁ ⟶ B₁) (s : B₁ ⟶ B₂) (t : B₂ ⟶ B₃) (d : B₃ ⟶ A₃)
    (b : A₀ ⟶ C₁) (q : C₁ ⟶ B₁) (z : C₁ ⟶ C₂) (p : C₂ ⟶ B₂)
    (t' : C₂ ⟶ C₃) (e : C₃ ⟶ B₃)
    (he : v ≫ w = r ≫ s ≫ t ≫ d) (hn : u ≫ r = b ≫ q)
    (hd : q ≫ s = z ≫ p) (ht : p ≫ t = t' ≫ e) :
    u ≫ v ≫ w = b ≫ z ≫ t' ≫ e ≫ d := by
  rw [he, ← Category.assoc u r, hn]
  simp only [Category.assoc]
  rw [← Category.assoc q s, hd]
  simp only [Category.assoc]
  rw [← Category.assoc p t, ht]
  simp only [Category.assoc]

private theorem scalarDualReverse
    {C D : Type*} [Category* C] [Category* D]
    (T : C ⥤ D) (DC : Cᵒᵖ ⥤ C) (DD : Dᵒᵖ ⥤ D)
    (δ : 𝟭 D ⟶ DD.rightOp ⋙ DD)
    {A B : C} {A' B' : D} (v : A ⟶ DC.obj (op B))
    (v' : A' ⟶ DD.obj (op B')) (c : T.obj B ⟶ B') (b : T.obj A ⟶ A')
    (dB : T.obj (DC.obj (op B)) ⟶ DD.obj (op (T.obj B)))
    (dDB : T.obj (DC.obj (op (DC.obj (op B)))) ⟶
      DD.obj (op (T.obj (DC.obj (op B)))))
    (dA : T.obj (DC.obj (op A)) ⟶ DD.obj (op (T.obj A)))
    (δB : B ⟶ DC.obj (op (DC.obj (op B))))
    (hδ : T.map δB ≫ dDB = δ.app (T.obj B) ≫ DD.map dB.op)
    (hn : T.map (DC.map v.op) ≫ dA = dDB ≫ DD.map (T.map v).op)
    (hv : T.map v ≫ dB = b ≫ v' ≫ DD.map c.op) :
    T.map (δB ≫ DC.map v.op) ≫ dA =
      c ≫ δ.app B' ≫ DD.map v'.op ≫ DD.map b.op := by
  rw [T.map_comp, Category.assoc, hn, ← Category.assoc, hδ,
    Category.assoc, ← DD.map_comp, ← op_comp, hv]
  simp only [op_comp, DD.map_comp, Category.assoc]
  have hc := δ.naturality c
  dsimp only [Functor.id_map, Functor.comp_map, Functor.rightOp_map] at hc
  rw [← reassoc_of% hc]

