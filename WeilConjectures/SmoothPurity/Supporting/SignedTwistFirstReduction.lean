module

public import WeilConjectures.AlgebraicGeometry.Intrinsic.IntrinsicCoefficientTwistsUnrestricted
public import WeilConjectures.SmoothPurity.Derived.DerivedScalarExtensionRestrictionAdjunctionSupplement
import all WeilConjectures.AlgebraicGeometry.Pur.PurTwistIntegralLocalModels
import all WeilConjectures.AlgebraicGeometry.Pur.PurInverseImageScalarComparison

/-! # Normalized reduction of the completed first Tate line

Source: definition-tate-twists--10, finite coefficient paragraph.
(blueprint: lem-weil-twist-first-quotient-normalization).
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxSize 4096
universe u
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped ChangeOfRings
namespace WeilConjectures

variable (l : ℕ) [Fact l.Prime] (E : Type u) [Field E] [Algebra (Padic l) E]
  [FiniteDimensional (Padic l) E] (S : Scheme.{u})

/-- The completed first line has its root-normalized quotient comparison.
Source: definition-tate-twists--10, first line and finite coefficient paragraph.
(blueprint: lem-weil-twist-first-quotient-normalization).

Proof: the completed action on the integral first line restricts along the
constant-coefficient completion map to the original root tensor module. Quotient
by the uniformizer power can be computed before or after completion: both ideals
are generated by the same uniformizer, and the completion projection has that
kernel. The tensor/restriction adjunctions therefore identify their quotient tensor
functors, with units preserved by uniqueness of the left-adjoint comparison.
Apply this comparison to the root tensor line. Its target is the prescribed
finite first line. Preservation of the adjunction unit gives the displayed
sheafification of 1 tensor x on every test object. This also handles the empty
scheme and zero section rings; no choice of a root basis is used. -/
theorem signedTwistFirstReduction (n : ℕ) :
    ∃ b : SheafOfModules.changeOfRingsOfUniverses.{u, u + 1, u + 1, u + 1}
        (completedIntegralCommRingProjectionUnrestricted l E S n)
        (purTwistIntegralModule S l E) ≅ purTwistFiniteOne S l E n,
      ∀ (U : S.ProEtᵒᵖ) (x : (purTwistIntegralModule S l E).val.obj U),
        b.hom.val.app U (SheafOfModules.scalarExtensionSection
          (completedIntegralCommRingProjectionUnrestricted l E S n)
          (purTwistIntegralModule S l E) U 1 x) =
          ((((PresheafOfModules.sheafificationAdjunction
            (𝟙 (integralCoefficientSheaf l E S n).obj)).unit.app
              (SheafOfModules.changeOfRingsPresheafOfUniverses.{u, u + 1, u + 1, u + 1}
                (purTwistIntegralQuotient S l E n) (purTwistIntegralOne S l E))).app U)
            ((1 : (integralCoefficientSheaf l E S n).obj.obj U) ⊗ₜ[
              (purTwistIntegralConstant S l E).obj.obj U,
              ((purTwistIntegralQuotient S l E n).hom.app U).hom] x)) := by
  classical
  let φ := purTwistIntegralCompletionMap S l E
  let q := purTwistIntegralQuotient S l E n
  let p := completedIntegralCommRingProjectionUnrestricted l E S n
  let M := purTwistIntegralModule S l E
  let h := (purTwistIntegralCompletionMap_existsUnique S l E).exists.choose_spec n
  let hq := fun U ↦ (integralQuotient_sections S l E U n).1
  have hk : ∀ U : S.ProEtᵒᵖ, RingHom.ker (p.hom.app U).hom =
      Ideal.span ((φ.hom.app U).hom '' (RingHom.ker (q.hom.app U).hom : Set _)) := by
    intro U
    rw [← Ideal.map_span, Ideal.span_eq]
    exact integralProjection_kernel S l E U n
  let aq := quotientTensorAdjunction φ q p h hq hk
  let ap := PurScalar.tensorAdjunction p
  let e := (Adjunction.leftAdjointUniq aq ap).app M
  let b := e.symm ≪≫ (PurScalar.tensorFunctor q).mapIso (integralForgetIso S l E)
  refine ⟨b, ?_⟩
  intro U x
  have hu := Adjunction.unit_leftAdjointUniq_hom_app aq ap M
  have hu := congrArg (fun f ↦ f.val.app U x) hu
  change ((PurScalar.tensorFunctor q).map (integralForgetIso S l E).hom).val.app U
    (e.inv.val.app U (SheafOfModules.scalarExtensionSection p M U 1 x)) = _
  have hq_unit : (aq.unit.app M).val.app U x =
      SheafOfModules.scalarExtensionSection q ((localRes φ).obj M) U 1 x := by
    unfold aq quotientTensorAdjunction
    rfl
  have hp_unit : (ap.unit.app M).val.app U x =
      SheafOfModules.scalarExtensionSection p M U 1 x := by
    unfold ap PurScalar.tensorAdjunction
    rfl
  change e.hom.val.app U ((aq.unit.app M).val.app U x) =
    (ap.unit.app M).val.app U x at hu
  rw [hq_unit, hp_unit] at hu
  have hi : e.inv.val.app U (SheafOfModules.scalarExtensionSection p M U 1 x) =
      SheafOfModules.scalarExtensionSection q ((localRes φ).obj M) U 1 x := by
    rw [← hu]
    exact congrArg (fun f ↦ f.val.app U
      (SheafOfModules.scalarExtensionSection q ((localRes φ).obj M) U 1 x)) e.hom_inv_id
  rw [hi]
  have hn := (PresheafOfModules.sheafificationAdjunction (𝟙
    (integralCoefficientSheaf l E S n).obj)).unit.naturality
      ((PurScalar.tensorPresheafFunctor q).map (integralForgetIso S l E).hom)
  exact (congrArg (fun f ↦ f.app U
    ((1 : (integralCoefficientSheaf l E S n).obj.obj U) ⊗ₜ[
      (purTwistIntegralConstant S l E).obj.obj U,
      (q.hom.app U).hom] x)) hn).symm

end WeilConjectures
