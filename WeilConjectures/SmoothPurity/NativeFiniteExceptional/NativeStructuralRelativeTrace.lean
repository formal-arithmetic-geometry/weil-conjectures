/-! # The counit-normalized native structural relative trace

Source: current blueprint, finite exceptional proof paragraph 2, the structural
absolute-counit transpose through compact-support composition.
(blueprint: lem-sf-native-structural-relative-trace).
The proper/open interchange is selected from a theorem proving its uniqueness.
The trace itself is constructed by the recorded absolute adjunction Hom equivalence.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option synthInstance.maxSize 4096

universe u
open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry AlgebraicGeometry.ProEtale
open AlgebraicGeometry.ProEtale.CondensedRing
open scoped CategoryTheory.Obj CategoryTheory.Functor CategoryTheory.TwoSquare

namespace WeilConjectures.NativeFiniteExceptional

section StructuralTrace

variable (Λ : ScalarSixRing.{u})
  {X Y Z : Scheme.{u}} {f : X ⟶ Y} {g : Y ⟶ Z}
  (c : Compactification f) (d : Compactification g)
  (r : Compactification.BoundaryCompactification (c.g ≫ d.i))
  [IsSchemeTheoreticallyDominant r.obj.obj.i]

/-- Existence and uniqueness of the prescribed proper/open interchange after extension
by zero. Source: compact-support composition
(blueprint: lem-sf-native-structural-relative-trace).
Proof: apply the proper/open interchange normalization theorem. -/
theorem traceInterchange_existsUnique
    (A : DerivedCategory (ModuleRingedComparison.internalModules Λ.X X)) :
    ∃! m, compositionInterchangeIsNormalized Λ.X c.g d.i r
      ((openImmersionLowerShriek Λ.X c.i).mapDerivedCategory.obj A) m := by
  obtain ⟨m, hm, hu⟩ := properOpenInterchange_normalized Λ.X c.g d.i r
    ((openImmersionLowerShriek Λ.X c.i).mapDerivedCategory.obj A)
  exact ⟨m, hm, hu⟩

/-- The unique normalized interchange used in the structural compositor.
Source: compact-support composition (blueprint: lem-sf-native-structural-relative-trace). -/
def traceInterchange
    (A : DerivedCategory (ModuleRingedComparison.internalModules Λ.X X)) :=
  (traceInterchange_existsUnique Λ c d r A).choose

/-- The chosen interchange has the required open-unit normalization.
Source: compact-support composition (blueprint: lem-sf-native-structural-relative-trace).
Proof: use the defining property of the unique chosen map. -/
theorem traceInterchange_normalized
    (A : DerivedCategory (ModuleRingedComparison.internalModules Λ.X X)) :
    compositionInterchangeIsNormalized Λ.X c.g d.i r
      ((openImmersionLowerShriek Λ.X c.i).mapDerivedCategory.obj A)
      (traceInterchange Λ c d r A) :=
  (traceInterchange_existsUnique Λ c d r A).choose_spec.1

omit [IsSchemeTheoreticallyDominant r.obj.obj.i] in
end StructuralTrace

end WeilConjectures.NativeFiniteExceptional
