#!/usr/bin/env python3
"""thp-off CMD [ARG...]: run CMD with transparent huge pages off for it and its children (prctl PR_SET_THP_DISABLE,
kept across fork and execve). 2026-10-26 (the human): Lean madvises its heap for huge pages and every page fault then ran
synchronous memory compaction, most of it failing; single-file compiles run through this. If the call fails, CMD runs anyway."""
import os, sys
try:
    import ctypes
    ctypes.CDLL(None, use_errno=True).prctl(41, 1, 0, 0, 0)
except Exception:   # noqa: BLE001
    pass
os.execvp(sys.argv[1], sys.argv[1:])
