module

public import Submission.WeilConjectures.SixFunctors.ProEtale.Adic.Constructible
public import Submission.WeilConjectures.SixFunctors.ProEtale.Adic.LatticeSections

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Lisse sheaves from lattices on a cover

A sheaf `F` of `ℚ̄_ℓ,S`-modules is lisse as soon as its pullback along a single weakly étale,
surjective, quasi-compact `p : Y ⟶ S` is a finite direct sum of copies of `ℚ̄_ℓ,Y`
(`AlgebraicGeometry.ProEtale.IsAdicLisseSheaf.of_upperStar_iso`). Combined with
`AlgebraicGeometry.ProEtale.AdicSheaf.nonempty_iso_of_lattice`, this is the case when `p^* F` is
generated by a finitely generated `𝒪_E`-lattice
(`AlgebraicGeometry.ProEtale.IsAdicLisseSheaf.of_lattice`).
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

attribute [local instance] Abelian.hasFiniteBiproducts

namespace AlgebraicGeometry.ProEtale

variable {l : ℕ} [Fact l.Prime] {S Y : Scheme.{u}} (p : Y ⟶ S) [WeaklyEtale p] [Surjective p]
  [QuasiCompact p]

/-- A sheaf whose pullback along a weakly étale, surjective, quasi-compact morphism is a finite
direct sum of copies of `ℚ̄_ℓ` is lisse. -/
theorem IsAdicLisseSheaf.of_upperStar_iso {F : AdicSheaf l S} {n : ℕ}
    (e : (p)^*ᵃ[l].obj F ≅ ⨁ fun _ : Fin n ↦ AdicSheaf.unit l Y) : IsAdicLisseSheaf F := by
  refine ⟨.singleton p, Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale)
    inferInstance, fun V f hf ↦ ?_⟩
  obtain ⟨⟩ := hf
  exact ⟨n, ⟨e⟩⟩

open AdicSheaf PadicAlgCl in
/-- **A sheaf generated by a finitely generated lattice on a cover is lisse**: let
`p : Y ⟶ S` be weakly étale, surjective and quasi-compact, `R ⊆ E` a principal ideal domain in a
finite subextension `E ⊆ ℚ̄_ℓ` (typically `𝒪_E`), `M` a finitely generated `R`-module with its
module topology, and `ψ_U : C(U, M) → (p^* F)(U)` natural semilinear maps. If `p^* F` is
locally generated over `ℚ̄_ℓ,Y` by the image of `ψ`, and `ψ` maps bases of `M` modulo torsion to
sections linearly independent over `ℚ̄_ℓ,Y(U)` for every `U`, then `F` is lisse. -/
theorem IsAdicLisseSheaf.of_lattice {F : AdicSheaf l S}
    {R : Type} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [TopologicalSpace R]
    [IsTopologicalRing R] (ι : R →+* PadicAlgCl l) (hι : Continuous ι)
    (hιinj : Function.Injective ι) {E : IntermediateField ℚ_[l] (PadicAlgCl l)}
    [FiniteDimensional ℚ_[l] E] (hιE : ∀ x, ι x ∈ E)
    {M : Type} [AddCommGroup M] [Module R M] [Module.Finite R M] [TopologicalSpace M]
    [IsTopologicalAddGroup M] [ContinuousSMul R M] [IsModuleTopology R M]
    (ψ : ∀ U : Y.ProEt, C(U.left, M) →+ ((p)^*ᵃ[l].obj F).X.obj.obj (op U))
    (hψ : ∀ ⦃U V : Y.ProEt⦄ (f : V ⟶ U) (m : C(U.left, M)),
      ψ V (m.comp f.left.base.hom) = ((p)^*ᵃ[l].obj F).X.obj.map f.op (ψ U m))
    (hψι : ∀ (U : Y.ProEt) (g : C(U.left, R)) (m : C(U.left, M)),
      ψ U (g • m) = sectionAct _ (ULift.up (ringValuedFunction ι hι hιE g)) (ψ U m))
    (hinj : ∀ b : Fin (Module.finrank R (M ⧸ Submodule.torsion R M)) → M,
      LinearIndependent R ((Submodule.torsion R M).mkQ ∘ b) → ∀ U, Function.Injective
        (sectionsLinearMap _ (fun i ↦ ψ (proEtTop Y) (ContinuousMap.const _ (b i))) U))
    (hgen : ∀ (U : Y.ProEt) (x : ((p)^*ᵃ[l].obj F).X.obj.obj (op U)),
      ∃ T ∈ Scheme.ProEt.topology Y U, ∀ ⦃V : Y.ProEt⦄ (f : V ⟶ U), T f → ∃ (n : ℕ)
        (a : Fin n → (adicConstantSheaf l Y).obj.obj (op V)) (m : Fin n → C(V.left, M)),
          ((p)^*ᵃ[l].obj F).X.obj.map f.op x = ∑ j, sectionAct _ (a j) (ψ V (m j))) :
    IsAdicLisseSheaf F :=
  have ⟨e⟩ := nonempty_iso_of_lattice ι hι hιE _ ψ hψ hψι hιinj hinj hgen
  IsAdicLisseSheaf.of_upperStar_iso p e.symm

end AlgebraicGeometry.ProEtale
