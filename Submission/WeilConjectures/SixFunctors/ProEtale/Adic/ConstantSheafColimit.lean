module

public import Submission.WeilConjectures.CategoryTheory.RingObjects.EllAdic
public import Submission.WeilConjectures.SixFunctors.ProEtale.Adic.PadicAlgClSheafIso

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# The constant `ℓ`-adic sheaf as the colimit of the sheaves `E_X`

The repository has two models of the `ℚ̄_ℓ`-sheaf of Bhatt–Scholze (*The pro-étale topology for
schemes*, §6.8) on the pro-étale site of a scheme `X`: the sheaf
`AlgebraicGeometry.ProEtale.adicConstantSheaf` of locally finite functions `U → ℚ̄_ℓ`, and the
sheafification `AlgebraicGeometry.ProEtale.padicAlgClSheaf` of the functions with values in a
finite subextension `E ⊆ ℚ̄_ℓ`, which is the colimit `colim_E E_X` of the sheaves `E_X = C(-, E)`
(`AlgebraicGeometry.ProEtale.isColimitPadicAlgClSheafCocone`). They agree
(`AlgebraicGeometry.ProEtale.padicAlgClSheafIsoAdicConstantSheaf`), so the abelian sheaf
underlying `ℚ̄_ℓ,X` is `colim_E E_X`
(`AlgebraicGeometry.ProEtale.isColimitPadicAlgClSheafCoconeExtend`). This is the first step of
the comparison of `ℓ`-adic sheaves with `ℓ`-adic towers of torsion sheaves needed for the
finiteness theorem (`WeilConjectures.SixFunctors.ProEtale.Adic.LowerStar`).

We also show that on a compact space a locally finite function takes values in a finite
subextension (`PadicAlgCl.mem_finiteIntermediateFieldValued_of_mem_locallyFiniteFunctions`).
-/

@[expose] public section
universe u

open CategoryTheory Limits Opposite

namespace PadicAlgCl

variable {l : ℕ} [Fact l.Prime] {T : Type*} [TopologicalSpace T]

/-- On a compact space, a locally finite function takes values in a finite subextension of
`ℚ̄_ℓ`: the span of its values is finite-dimensional, and the subfield generated by a finite
spanning set is a finite extension of `ℚ_ℓ`, `ℚ̄_ℓ` being algebraic over `ℚ_ℓ`. -/
lemma mem_finiteIntermediateFieldValued_of_mem_locallyFiniteFunctions [CompactSpace T]
    {f : C(T, PadicAlgCl l)} (hf : f ∈ locallyFiniteFunctions l T) :
    f ∈ finiteIntermediateFieldValued l T := by
  have hfin := finiteDimensional_span_range_of_mem_locallyFiniteFunctions hf
  obtain ⟨S, hS⟩ := Module.Finite.iff_fg.1 hfin
  refine ⟨IntermediateField.adjoin ℚ_[l] (S : Set (PadicAlgCl l)),
    IntermediateField.finiteDimensional_adjoin fun x _ ↦ Algebra.IsIntegral.isIntegral x,
    fun x ↦ ?_⟩
  have hx : f x ∈ Submodule.span ℚ_[l] (Set.range f) := Submodule.subset_span ⟨x, rfl⟩
  rw [← hS] at hx
  exact (Submodule.span_le.2 (IntermediateField.subset_adjoin ℚ_[l] _) :
    Submodule.span ℚ_[l] (S : Set (PadicAlgCl l)) ≤
      Subalgebra.toSubmodule (IntermediateField.adjoin ℚ_[l] _).toSubalgebra) hx

end PadicAlgCl

namespace AlgebraicGeometry.ProEtale

variable (X : Scheme.{u}) (l : ℕ) [Fact l.Prime]

/-- **`ℚ̄_ℓ,X = colim_E E_X`**: the abelian sheaf underlying the constant `ℓ`-adic sheaf
`ℚ̄_ℓ,X` is the colimit of the sheaves `E_X` of continuous `E`-valued functions over the finite
subextensions `E ⊆ ℚ̄_ℓ` of `ℚ_ℓ` (Bhatt–Scholze, §6.8). -/
noncomputable def isColimitPadicAlgClSheafCoconeExtend :
    IsColimit ((padicAlgClSheafCocone X l).extend
      (padicAlgClSheafIsoAdicConstantSheaf X l).hom) :=
  IsColimit.extendIso _ (isColimitPadicAlgClSheafCocone X l)

end AlgebraicGeometry.ProEtale
