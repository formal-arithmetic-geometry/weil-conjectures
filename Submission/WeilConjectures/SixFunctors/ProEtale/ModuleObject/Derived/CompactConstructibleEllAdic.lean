/-!
# Compactness of constructible sheaves with `ℓ`-adic coefficients

For the `ℓ`-adic coefficient rings `Λ = E, 𝒪_E, ℚ̄_ℓ` on a separated finite-type scheme `X` over a
field `k` which is finite or separably closed, every constructible sheaf placed in degree `0` is
compact in `Loc(Dᵇc(X, Λ))` (blueprints `sk-thm-constructible-compactness`,
`sk-prop-int-compactness`):

* `AlgebraicGeometry.ProEtale.CondensedRing.isCompactObj_singleFunctor_continuousMapRingObj`,
* `AlgebraicGeometry.ProEtale.CondensedRing.isCompactObj_singleFunctor_padicIntegersRingObj`,
* `AlgebraicGeometry.ProEtale.CondensedRing.isCompactObj_singleFunctor_padicAlgClRingObj`.

They follow from the abstract argument
`AlgebraicGeometry.ProEtale.isCompactObj_singleFunctor_of_isIndConstructibleHeart` (finite
window, left completeness of the pro-étale derived category by repleteness,
`AlgebraicGeometry.ProEtale.CondensedRing.countableAB4Star_mod`) and the inputs below.

## Inputs

For each of the three coefficient rings, proved here:

* `isIndConstructibleHeart_*` (blueprints `sk-prop-ind-heart` (2), for `𝒪_E`
  `sk-lem-int-integral-heart` and `det-prop-int-compactness-compact` (1)): the ind-constructible
  sheaves are closed under kernels, cokernels, extensions and direct sums;
* `hasConstructibleExtContinuity_*` (blueprints `sk-lem-constructible-ext-continuity` (1), for
  `𝒪_E` `sk-lem-int-ext` (1)): morphisms `C ⟶ B[n]` out of a constructible sheaf `C` into a
  filtered colimit `B = colim Bᵢ` of sheaves factor through some `Bᵢ[n]`;

and still sorried:

* `hasUniformConstructibleExtBound_*` (blueprints `sk-lem-uniform-constructible-ext`, for `𝒪_E`
  `sk-lem-int-ext` (2)): `Ext^q(C, N) = 0` for `C` constructible, `q > d_C` and all constructible
  `N`; this uses that `k` is finite or separably closed.

The proofs are in the modules `...Derived.IndConstructibleHeart` (the heart, from the
continuity), `...Derived.HomFilteredColimitEllAdic` (the continuity) and
`...Derived.UniformExtBoundEllAdic` (the bound), under
`WeilConjectures.SixFunctors.ProEtale.ModuleObject`.
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory MonObj Limits

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

attribute [local irreducible] upperStarFromPoint CondensedRing.upperStar

variable (ℓ : ℕ) [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k ≠ ℓ)]

private noncomputable def continuousIso
    {A B : Type} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    (e : A ≃+* B) (he : Continuous e) (hei : Continuous e.symm) :
    Mon.mk (Profinite.continuousMapRingObj.{u} A) ≅
      Mon.mk (Profinite.continuousMapRingObj.{u} B) := by
  let eR : Profinite.continuousMapRingSheaf.{u} A ≅
      Profinite.continuousMapRingSheaf.{u} B :=
    { hom := Profinite.continuousMapRingSheafMap e.toRingHom he
      inv := Profinite.continuousMapRingSheafMap e.symm.toRingHom hei
      hom_inv_id := by
        ext S f
        apply ULift.ext
        ext x
        exact e.symm_apply_apply _
      inv_hom_id := by
        ext S f
        apply ULift.ext
        ext x
        exact e.apply_symm_apply _ }
  let eAb := (sheafCompose (coherentTopology Profinite.{u})
    (forget₂ RingCat.{u + 1} Ab.{u + 1})).mapIso eR
  have : IsMonHom eAb.hom := Sheaf.isMonHom_sheafCompose_map _ eR.hom
  have : IsMonHom eAb.inv := Sheaf.isMonHom_sheafCompose_map _ eR.inv
  exact
    { hom := Mon.ofHom eAb.hom
      inv := Mon.ofHom eAb.inv
      hom_inv_id := Mon.Hom.ext eAb.hom_inv_id
      inv_hom_id := Mon.Hom.ext eAb.inv_hom_id }

private theorem integralCoeffIso (ℓ : ℕ) [Fact ℓ.Prime]
    (E : Type) [Field E] [Algebra E (PadicAlgCl ℓ)] [Algebra ℚ_[ℓ] E]
    [IsScalarTower ℚ_[ℓ] E (PadicAlgCl ℓ)] [FiniteDimensional ℚ_[ℓ] E] :
    ∃ F : PadicAlgCl.FiniteIntermediateField ℓ,
      Nonempty (Mon.mk (Profinite.padicIntegersRingObj.{u} ℓ E) ≅
        Mon.mk (Profinite.padicIntegersRingObj.{u} ℓ F)) := by
  let := PadicAlgCl.normedFieldOfAlgebra ℓ E
  let f := IsScalarTower.toAlgHom ℚ_[ℓ] E (PadicAlgCl ℓ)
  let F : PadicAlgCl.FiniteIntermediateField ℓ :=
    ⟨f.fieldRange, f.equivFieldRange.toLinearEquiv.finiteDimensional⟩
  let e : E ≃ₐ[ℚ_[ℓ]] F := f.equivFieldRange
  let t : PadicAlgCl.integers ℓ E ≃+* PadicAlgCl.integers ℓ F :=
    { toFun := fun x ↦ ⟨e x.val, x.property⟩
      invFun := fun x ↦ ⟨e.symm x.val, by
        have h := (PadicAlgCl.mem_integers_iff ℓ F x.val).mp x.property
        change ‖algebraMap E (PadicAlgCl ℓ) (e.symm x.val)‖₊ ≤ 1
        change ‖(e (e.symm x.val)).val‖₊ ≤ 1
        simpa only [e.apply_symm_apply, IntermediateField.algebraMap_apply] using h⟩
      left_inv := fun x ↦ Subtype.ext (e.symm_apply_apply x.val)
      right_inv := fun x ↦ Subtype.ext (e.apply_symm_apply x.val)
      map_add' := fun x y ↦ Subtype.ext (e.map_add x.val y.val)
      map_mul' := fun x y ↦ Subtype.ext (e.map_mul x.val y.val) }
  let := PadicAlgCl.normedFieldOfAlgebra ℓ F
  have ht : Isometry t := by
    apply Isometry.of_dist_eq
    intro x y
    rfl
  have hti : Continuous t.symm :=
    (show _ ≃ᵢ _ from ⟨t.toEquiv, ht⟩).symm.continuous
  exact ⟨F, ⟨continuousIso t ht.continuous hti⟩⟩

private theorem ellAdicFactorsOfContinuity
    {A : Type*} [Category.{u + 1} A] [Abelian A] [HasDerivedCategory.{u + 1} A]
    [HasColimitsOfSize.{u + 1, u + 1} A] (S : DerivedCategory A)
    (hcont : ∀ (I : Type (u + 1)) [SmallCategory I] [IsFiltered I] (F : I ⥤ A)
      (c : Cocone F), IsColimit c → ∀ q : ℤ,
      IsIso (colimit.desc _ ((DerivedCategory.singleFunctor A 0 ⋙ shiftFunctor _ q ⋙
        preadditiveCoyoneda.obj (Opposite.op S)).mapCocone c))) :
    DerivedCategory.HomFactorsThroughFilteredColimits.{u + 1} S := by
  classical
  let Y := preadditiveCoyoneda.obj (Opposite.op S)
  intro I _ _ F c hc n f
  let G := DerivedCategory.singleFunctor A n ⋙ Y
  have : IsIso (colimit.post F (DerivedCategory.singleFunctor A 0 ⋙
      shiftFunctor _ (-n) ⋙ Y)) :=
    hcont I F (colimit.cocone F) (colimit.isColimit F) (-n)
  have : PreservesColimit F (DerivedCategory.singleFunctor A 0 ⋙
      shiftFunctor _ (-n) ⋙ Y) := preservesColimit_of_isIso_post _ _
  have : PreservesColimit F ((DerivedCategory.singleFunctor A 0 ⋙
      shiftFunctor _ (-n)) ⋙ Y) :=
    preservesColimit_of_natIso F (Functor.associator _ _ _).symm
  have : PreservesColimit F G := preservesColimit_of_natIso F
    (Functor.isoWhiskerRight ((DerivedCategory.singleFunctors A).shiftIso (-n) n 0
      (by omega)) Y)
  obtain ⟨i, g, hg⟩ := Concrete.isColimit_exists_rep (F ⋙ G)
    (isColimitOfPreserves G hc) f
  exact ⟨i, g, hg.symm⟩

private theorem fieldCoeffIso (ℓ : ℕ) [Fact ℓ.Prime]
    (E : Type) [NormedField E] [NormedAlgebra ℚ_[ℓ] E] [FiniteDimensional ℚ_[ℓ] E] :
    ∃ F : PadicAlgCl.FiniteIntermediateField ℓ,
      Nonempty (Mon.mk (Profinite.continuousMapRingObj.{u} E) ≅
        Mon.mk (Profinite.continuousMapRingObj.{u} F)) := by
  obtain ⟨F, hF, σ, hσ, hσi, _⟩ :=
    NormedCoefficientRealization.normed_coefficient_realization ℓ E (PadicAlgCl ℓ)
      (fun x ↦ norm_algebraMap' E x) (PadicAlgCl.norm_extends ℓ)
  exact ⟨⟨F, hF⟩, ⟨continuousIso σ.toRingEquiv hσ hσi⟩⟩

private theorem ellAdicHeartOfCoefficientIso
    (X : Scheme.{u})
    {ΛE ΛF : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}}
    [MonObj ΛE] [IsCommMonObj ΛE] [MonObj ΛF] [IsCommMonObj ΛF]
    (e : Mon.mk ΛE ≅ Mon.mk ΛF)
    (hF : IsIndConstructibleHeart (condensedRingObj ΛF X)) :
    IsIndConstructibleHeart (condensedRingObj ΛE X) := by
  let φ := (upperStarFromPoint X).map e.inv.hom
  let G := Mod.comap (D := Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) φ
  let QE : ObjectProperty _ := IsConstructibleModuleObject (condensedRingObj ΛE X)
  let QF : ObjectProperty _ := IsConstructibleModuleObject (condensedRingObj ΛF X)
  have : G.IsEquivalence := (Mod.comapEquivalenceOfIsIso φ).isEquivalence_functor
  have : QF.IsClosedUnderIsomorphisms := ⟨fun e h ↦ constructible_of_iso e h⟩
  have : QF.ind.IsClosedUnderKernels := hF.isClosedUnderKernels
  have : QF.ind.IsClosedUnderCokernels := hF.isClosedUnderCokernels
  have : QF.ind.IsClosedUnderExtensions := hF.isClosedUnderExtensions
  have hbase : QF.inverseImage G = QE := by
    funext M
    apply propext
    change QF (G.obj M) ↔ QE M
    constructor
    · intro hM
      apply constructible_of_iso ((Mod.comapEquivalenceOfIsIso φ).unitIso.app M).symm
      exact constructible_comap (inv φ) hM
    · intro hM
      exact constructible_comap φ hM
  have hprop : QF.ind.inverseImage G = QE.ind := by
    rw [← ObjectProperty.ind_inverseImage_eq_of_isEquivalence QF G]
    exact congrArg ObjectProperty.ind hbase
  refine ⟨?_, ?_, ?_, ?_⟩
  · change QE.ind.IsClosedUnderKernels
    rw [← hprop]
    constructor
    rintro Y ⟨f, c, hc, h₁, h₂⟩
    exact QF.ind.prop_of_isLimit_kernelFork (c.mapIsLimit hc G) h₁ h₂
  · change QE.ind.IsClosedUnderCokernels
    rw [← hprop]
    constructor
    rintro Y ⟨f, c, hc, h₁, h₂⟩
    exact QF.ind.prop_of_isColimit_cokernelCofork (c.mapIsColimit hc G) h₁ h₂
  · change QE.ind.IsClosedUnderExtensions
    rw [← hprop]
    infer_instance
  · intro J
    have : QF.ind.IsClosedUnderColimitsOfShape (Discrete J) :=
      hF.isClosedUnderColimitsOfShape_discrete J
    change QE.ind.IsClosedUnderColimitsOfShape (Discrete J)
    rw [← hprop]
    infer_instance

private theorem ellAdicFactorsAlongEquivalence
    {A B : Type*} [Category.{u + 1} A] [Category.{u + 1} B]
    [Abelian A] [Abelian B] [HasDerivedCategory.{u + 1} A]
    [HasDerivedCategory.{u + 1} B]
    (G : A ⥤ B) [G.IsEquivalence] [G.Additive] (M : A)
    (h : DerivedCategory.HomFactorsThroughFilteredColimits.{u + 1}
      ((DerivedCategory.singleFunctor B 0).obj (G.obj M))) :
    DerivedCategory.HomFactorsThroughFilteredColimits.{u + 1}
      ((DerivedCategory.singleFunctor A 0).obj M) := by
  intro I _ _ F c hc n f
  let D := G.mapDerivedCategory
  let eM := G.mapDerivedCategorySingleFunctor 0
  let eN := G.mapDerivedCategorySingleFunctor n
  obtain ⟨i, g, hg⟩ := h I (F ⋙ G) (G.mapCocone c) (isColimitOfPreserves G hc) n
    ((eM.app M).inv ≫ D.map f ≫ (eN.app c.pt).hom)
  refine ⟨i, D.preimage ((eM.app M).hom ≫ g ≫ (eN.app (F.obj i)).inv), ?_⟩
  apply D.map_injective
  rw [D.map_comp, D.map_preimage]
  apply (cancel_epi (eM.app M).inv).mp
  apply (cancel_mono (eN.app c.pt).hom).mp
  have hn : D.map ((DerivedCategory.singleFunctor A n).map (c.ι.app i)) ≫
      (eN.app c.pt).hom = (eN.app (F.obj i)).hom ≫
        (DerivedCategory.singleFunctor B n).map (G.map (c.ι.app i)) :=
    eN.hom.naturality (c.ι.app i)
  simpa only [Category.assoc, hn, Iso.inv_hom_id_assoc, Functor.comp_obj,
    Functor.mapCocone_pt, Functor.mapCocone_ι_app] using hg

