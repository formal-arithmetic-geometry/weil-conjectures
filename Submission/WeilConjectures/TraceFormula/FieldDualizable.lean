module

public import Submission.WeilConjectures.CategoryTheory.DerivedCategory.Monoidal.DualizableProjectiveUnit
public import Submission.WeilConjectures.CategoryTheory.Monoidal.DualizableDetection
public import Submission.WeilConjectures.CategoryTheory.Monoidal.Dualizable
public import Submission.WeilConjectures.CategoryTheory.Triangulated.IdempotentCompleteOfCoproducts
public import Submission.WeilConjectures.TraceFormula.ConstructibleGeneration

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Bounded constructible complexes on a field are dualizable

Let `k` be a field of characteristic `≠ ℓ`. Every object of `Dᵇc(Spec k)⟦ℚ̲̄_ℓ⟧` is dualizable
(`ProEtale.CondensedRing.isDualizable_point`), and has a left dual
(`ProEtale.CondensedRing.nonempty_hasLeftDual_point`).

## Proof

By generic dualizability
(`ProEtale.CondensedRing.exists_isOpenImmersion_triangEnvelope_isDualizable`)
the restriction of `N` to a nonempty open subscheme `U` of `Spec k` lies in the triangulated
subcategory generated by the dualizable objects; `U ⟶ Spec k` is an isomorphism, `Spec k` having a
single point. The objects of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧` which are dualizable in the ambient derived category
form a triangulated subcategory stable under retracts: dualizable objects of `D(Mod_{ℚ̲̄_ℓ,U})` are
stable under shifts and cones (`DerivedCategory.isDualizable_shift`,
`DerivedCategory.isDualizable_obj₃_of_distTriang`) and under retracts, the derived category being
idempotent complete (it has coproducts). Finally an object of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧` dualizable in the
ambient category is dualizable in `Dᵇc(U)⟦ℚ̲̄_ℓ⟧`, which is stable under internal homs
(`CategoryTheory.ObjectProperty.isDualizable_of_isDualizable_obj`).
-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Pretriangulated

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (ℓ : ℕ) [Fact ℓ.Prime]

set_option hygiene false in
/-- The condensed field `ℚ̄_ℓ`. -/
local notation "𝐐" => Profinite.padicAlgClRingObj ℓ

/-- The derived category of `ℚ̲̄_ℓ`-modules on the pro-étale site of a scheme is idempotent
complete: it has coproducts. -/
instance isIdempotentComplete_derivedCategory_padicAlgCl (X : Scheme.{u}) :
    IsIdempotentComplete (DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj 𝐐 X))) :=
  have : HasCoproducts.{u + 1} (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj 𝐐 X)) := fun _ ↦ inferInstance
  have : HasCoproducts.{u + 1} (DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology X)
      Ab.{u + 1}) (condensedRingObj 𝐐 X))) := fun K ↦
    DerivedCategory.hasColimitsOfShape_discrete K
  Pretriangulated.isIdempotentComplete_of_hasCoproducts

/-- The dualizable objects of the derived category of `ℚ̲̄_ℓ`-modules on the pro-étale site of a
scheme. -/
abbrev ambientDualizable (X : Scheme.{u}) :
    ObjectProperty (DerivedCategory (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
      (condensedRingObj 𝐐 X))) :=
  IsDualizable

instance (X : Scheme.{u}) : (ambientDualizable ℓ X).IsClosedUnderIsomorphisms :=
  ⟨fun e h ↦ IsDualizable.of_iso e h⟩

instance (X : Scheme.{u}) : (ambientDualizable ℓ X).IsStableUnderRetracts :=
  ⟨fun r h ↦ IsDualizable.of_retract r h⟩

instance (X : Scheme.{u}) : (ambientDualizable ℓ X).IsTriangulated where
  exists_zero := ⟨_, isZero_zero _, DerivedCategory.isDualizable_obj₃_of_distTriang _
    (contractible_distinguished (𝟙_ _)) isDualizable_unit isDualizable_unit⟩
  isStableUnderShiftBy n := ⟨fun _ h ↦ DerivedCategory.isDualizable_shift h n⟩
  toIsTriangulatedClosed₂ := .mk' fun _ hT h₁ h₃ ↦
    DerivedCategory.isDualizable_obj₃_of_distTriang _ (inv_rot_of_distTriang _ hT)
      (DerivedCategory.isDualizable_shift h₃ (-1)) h₁

variable {k : Type u} [Field k] [Fact (ringChar k).Prime] [Fact (ringChar k ≠ ℓ)]

attribute [local instance] DerivedCategory.braidedCategory' in
/-- An object of `Dᵇc(Z)⟦ℚ̲̄_ℓ⟧` is dualizable if and only if it is dualizable in the ambient
derived category. -/
lemma isDualizable_iff_isDualizable_obj {Z : Over (Spec (.of k))} [LocallyOfFiniteType Z.hom]
    [QuasiCompact Z.hom] [IsSeparated Z.hom] (K : Dᵇc(Z.left)⟦𝐐⟧) :
    IsDualizable K ↔ IsDualizable K.obj := by
  refine ⟨fun ⟨_⟩ ↦ ⟨@HasRightDual.mk _ _ _ _ _
    (ExactPairing.map (boundedConstructible (condensedRingObj 𝐐 Z.left)).ι K Kᘁ)⟩,
    fun h ↦ ObjectProperty.isDualizable_of_isDualizable_obj _ K h⟩

/-- **Bounded constructible complexes on a field are dualizable**: every object of
`Dᵇc(Spec k)⟦ℚ̲̄_ℓ⟧` is dualizable, `k` a field of characteristic `≠ ℓ`. -/
theorem isDualizable_point (N : Dᵇc((point k).left)⟦𝐐⟧) : IsDualizable N := by
  have : IsReduced (point k).left := inferInstanceAs (IsReduced (Spec (.of k)))
  have : Nonempty (point k).left := inferInstanceAs (Nonempty (Spec (.of k)))
  obtain ⟨U, _, _, _, _, _, j, _, hE⟩ := exists_isOpenImmersion_triangEnvelope_isDualizable ℓ
    (point k) N
  -- the dualizable objects of `Dᵇc(U)` lie in the ambient dualizable ones, which form a
  -- triangulated subcategory stable under retracts
  have : ((ambientDualizable ℓ U.left).inverseImage
      (boundedConstructible (condensedRingObj 𝐐 U.left)).ι).IsStableUnderRetracts :=
    ⟨fun r h ↦ IsDualizable.of_retract (r.map _) h⟩
  have hle : ObjectProperty.triangEnvelope (C := Dᵇc(U.left)⟦𝐐⟧) IsDualizable ≤
      (ambientDualizable ℓ U.left).inverseImage (boundedConstructible _).ι :=
    (ObjectProperty.triangEnvelope_le_iff _).2 fun K hK ↦
      (isDualizable_iff_isDualizable_obj ℓ K).1 hK
  have hU := (isDualizable_iff_isDualizable_obj ℓ _).2 (hle _ hE)
  -- `j` is an isomorphism, `Spec k` having a single point
  have : Subsingleton (point k).left := inferInstanceAs (Subsingleton (PrimeSpectrum k))
  have : Surjective j.left := ⟨fun x ↦ ⟨Classical.arbitrary U.left, Subsingleton.elim _ _⟩⟩
  have : IsIso j.left := (isIso_iff_isOpenImmersion_and_surjective _).2 ⟨inferInstance, this⟩
  have : IsIso ((Over.forget _).map j) := this
  have : IsIso j := isIso_of_reflects_iso _ (Over.forget _)
  refine IsDualizable.of_iso ?_ (isDualizable_boundedConstructibleUpperStar_obj ℓ (inv j) hU)
  exact ((boundedConstructibleUpperStarComp 𝐐 ℓ (inv j) j).app N).symm ≪≫
    eqToIso (by rw [IsIso.inv_hom_id]) ≪≫ (boundedConstructibleUpperStarId 𝐐 ℓ (point k)).app N

/-- Every object of `Dᵇc(Spec k)⟦ℚ̲̄_ℓ⟧` has a left dual: it has a right dual
(`ProEtale.CondensedRing.isDualizable_point`) and `Dᵇc(Spec k)⟦ℚ̲̄_ℓ⟧` is braided
(`ProEtale.CondensedRing.boundedConstructibleBraiding`). -/
theorem nonempty_hasLeftDual_point (N : Dᵇc((point k).left)⟦𝐐⟧) : Nonempty (HasLeftDual N) := by
  obtain ⟨_⟩ := isDualizable_point ℓ N
  let := boundedConstructibleBraiding (X := point k) (ℓ := ℓ)
  exact ⟨{ leftDual := Nᘁ, exact := BraidedCategory.exactPairing_swap N Nᘁ }⟩

end AlgebraicGeometry.ProEtale.CondensedRing
