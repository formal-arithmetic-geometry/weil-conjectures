/-!
# Curves on a two-dimensional factorial local ring are principal

Let `R` be a noetherian local factorial domain of dimension `2` (for instance the strict
henselization of a smooth surface at a closed point, a regular local ring of dimension `2`).
A reduced curve `V(I) ⊆ Spec R` (`I` radical with `dim R/I = 1`) is principal: its minimal
primes have height one, hence are generated by prime elements, and `I` is generated by their
product (`Ideal.exists_eq_span_singleton_of_isRadical_of_ringKrullDim_quotient_eq_one`). If
moreover `R/I` has a principal maximal ideal (a regular curve), the generator has order one
(`IsLocalRing.hasOrder_one_of_isPrincipal_maximalIdeal_quotient`).

These are used to bring the curves of the blow-up restriction vanishing
(`AlgebraicGeometry.Etale.sectionsRestriction_app_eq_zero_of_tangentConesMeetAtOrigin`) into the
principal form of `AlgebraicGeometry.Etale.blowupRestriction_eq_zero`.
-/

@[expose] public section

open IsLocalRing

namespace Ideal

variable {R : Type*} [CommRing R]

/-- If finitely many pairwise distinct prime ideals `p ∈ s` are generated by prime elements
`g p`, and each of them contains `x`, then the product of the `g p` divides `x`. -/
theorem prod_dvd_of_forall_mem_span_singleton [IsDomain R] {ι : Type*} (s : Finset ι)
    (g : ι → R) (hg : ∀ i ∈ s, Prime (g i))
    (hinj : ∀ i ∈ s, ∀ j ∈ s, Associated (g i) (g j) → i = j) {x : R}
    (hx : ∀ i ∈ s, g i ∣ x) : ∏ i ∈ s, g i ∣ x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s his ih =>
    obtain ⟨y, rfl⟩ := ih (fun j hj ↦ hg j (Finset.mem_insert_of_mem hj))
      (fun j hj k hk ↦ hinj j (Finset.mem_insert_of_mem hj) k (Finset.mem_insert_of_mem hk))
      (fun j hj ↦ hx j (Finset.mem_insert_of_mem hj))
    rw [Finset.prod_insert his]
    have hi := hg i (Finset.mem_insert_self i s)
    rcases hi.dvd_or_dvd (hx i (Finset.mem_insert_self i s)) with h | h
    · obtain ⟨j, hj, hij⟩ := (hi.dvd_finsetProd_iff _).1 h
      have := hinj i (Finset.mem_insert_self i s) j (Finset.mem_insert_of_mem hj)
        (hi.associated_of_dvd (hg j (Finset.mem_insert_of_mem hj)) hij)
      exact absurd (this ▸ hj) his
    · rw [mul_comm (g i)]
      exact mul_dvd_mul_left _ h

variable [IsLocalRing R] [IsDomain R] [IsNoetherianRing R]

omit [IsNoetherianRing R] in
/-- In a noetherian local factorial domain of dimension `2`, a prime ideal other than `0` and
the maximal ideal is generated by a prime element. -/
theorem exists_prime_eq_span_singleton_of_ringKrullDim_eq_two [UniqueFactorizationMonoid R]
    (hR : ringKrullDim R = 2) {p : Ideal R} [p.IsPrime] (hp0 : p ≠ ⊥)
    (hpm : p ≠ maximalIdeal R) : ∃ q : R, Prime q ∧ p = span {q} := by
  obtain ⟨q, hqp, hq⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹_› hp0
  refine ⟨q, hq, ?_⟩
  by_contra hne
  have : (span {q}).IsPrime := (span_singleton_prime hq.ne_zero).2 hq
  have h₁ := height_add_one_le_of_lt_of_isPrime (I := (⊥ : Ideal R)) (J := span {q})
    (bot_lt_iff_ne_bot.2 (by simpa using hq.ne_zero))
  have h₂ := height_add_one_le_of_lt_of_isPrime
    (lt_of_le_of_ne ((span_singleton_le_iff_mem _).2 hqp) (Ne.symm hne))
  have h₃ := height_add_one_le_of_lt_of_isPrime
    (lt_of_le_of_ne (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)) hpm)
  have h₄ : (maximalIdeal R).height = 2 := by
    have := maximalIdeal_height_eq_ringKrullDim (R := R)
    rw [hR, ← WithBot.coe_ofNat] at this
    exact WithBot.coe_injective this
  have h₅ : (1 : ℕ∞) + 1 + 1 ≤ 2 := by
    calc (1 : ℕ∞) + 1 + 1 ≤ (span {q}).height + 1 + 1 := by
          gcongr
          exact le_trans le_add_self h₁
      _ ≤ p.height + 1 := by gcongr
      _ ≤ 2 := h₄ ▸ h₃
  norm_num at h₅

/-- In a noetherian local factorial domain of dimension `2`, a radical ideal `I` with
`dim R/I = 1` (the ideal of a reduced curve) is principal. -/
theorem exists_eq_span_singleton_of_isRadical_of_ringKrullDim_quotient_eq_one
    [UniqueFactorizationMonoid R] (hR : ringKrullDim R = 2) {I : Ideal R} (hI : I.IsRadical)
    (hdim : ringKrullDim (R ⧸ I) = 1) : ∃ f : R, I = span {f} := by
  classical
  have hmin (p : Ideal R) (hp : p ∈ I.minimalPrimes) : ∃ q : R, Prime q ∧ p = span {q} := by
    have : p.IsPrime := hp.1.1
    refine exists_prime_eq_span_singleton_of_ringKrullDim_eq_two hR ?_ ?_
    · rintro rfl
      have hI0 : I = ⊥ := le_bot_iff.1 hp.1.2
      subst hI0
      rw [ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot R), hR] at hdim
      exact absurd hdim (by decide)
    · rintro rfl
      have hIm : I = maximalIdeal R := by
        rw [← hI.radical, ← sInf_minimalPrimes]
        refine le_antisymm (sInf_le hp) (le_sInf fun q hq ↦ ?_)
        have : q.IsPrime := hq.1.1
        exact hp.2 hq.1 (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›))
      subst hIm
      rw [ringKrullDim_eq_zero_of_isField
        ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).1 inferInstance)] at hdim
      exact absurd hdim (by decide)
  choose! g hg hgp using hmin
  have hfin := I.finite_minimalPrimes_of_isNoetherianRing R
  refine ⟨∏ p ∈ hfin.toFinset, g p, le_antisymm (fun x hx ↦ ?_) ?_⟩
  · rw [mem_span_singleton]
    refine prod_dvd_of_forall_mem_span_singleton _ g (fun p hp ↦ hg p (hfin.mem_toFinset.1 hp))
      (fun p hp q hq hpq ↦ ?_) (fun p hp ↦ ?_)
    · rw [hgp p (hfin.mem_toFinset.1 hp), hgp q (hfin.mem_toFinset.1 hq)]
      exact span_singleton_eq_span_singleton.2 hpq
    · rw [← mem_span_singleton, ← hgp p (hfin.mem_toFinset.1 hp)]
      exact (hfin.mem_toFinset.1 hp).1.2 hx
  · have h : ∏ p ∈ hfin.toFinset, g p ∈ sInf I.minimalPrimes := by
      refine (mem_sInf).2 fun p hp ↦ ?_
      rw [hgp p hp]
      exact mem_span_singleton.2 (Finset.dvd_prod_of_mem _ (hfin.mem_toFinset.2 hp))
    rw [sInf_minimalPrimes, hI.radical] at h
    exact (span_singleton_le_iff_mem _).2 h

omit [IsDomain R] [IsNoetherianRing R] in
/-- In a local ring of dimension `2`, if `dim R/(f) = 1` then `f` is a nonzero element of the
maximal ideal. -/
theorem mem_maximalIdeal_and_ne_zero_of_ringKrullDim_quotient_eq_one (hR : ringKrullDim R = 2)
    {f : R} (hdim : ringKrullDim (R ⧸ span {f}) = 1) : f ∈ maximalIdeal R ∧ f ≠ 0 := by
  refine ⟨by_contra fun hf ↦ ?_, ?_⟩
  · rw [span_singleton_eq_top.2 (not_not.1 ((mem_maximalIdeal f).not.1 hf)),
      ringKrullDim_eq_bot_of_subsingleton] at hdim
    exact absurd hdim (by decide)
  · rintro rfl
    rw [span_singleton_eq_bot.2 rfl, ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot R), hR]
      at hdim
    exact absurd hdim (by decide)

end Ideal

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- Let `R` be a noetherian local ring whose maximal ideal is not principal and `φ : R →+* A` a
surjection onto a local ring with principal maximal ideal (a regular curve). If the kernel of
`φ` is generated by `h`, then `h` has order one: `h ∈ 𝔪 ∖ 𝔪²`. -/
theorem hasOrder_one_of_ker_eq_span_singleton (hR : 2 ≤ (maximalIdeal R).spanFinrank)
    {A : Type*} [CommRing A] [IsLocalRing A] (hA : (maximalIdeal A).IsPrincipal)
    (φ : R →+* A) (hφ : Function.Surjective φ) {h : R} (hker : RingHom.ker φ = Ideal.span {h}) :
    HasOrder h 1 := by
  have hcomap : (maximalIdeal A).comap φ = maximalIdeal R :=
    have := Ideal.comap_isMaximal_of_surjective φ hφ (K := maximalIdeal A)
    eq_maximalIdeal this
  have hhm : h ∈ maximalIdeal R := by
    rw [← hcomap, Ideal.mem_comap, RingHom.mem_ker.1 (hker ▸ Ideal.mem_span_singleton_self h)]
    exact zero_mem _
  refine ⟨by rwa [pow_one], fun hh2 ↦ ?_⟩
  obtain ⟨y, hy⟩ := hA
  obtain ⟨x, rfl⟩ := hφ y
  have hxm : x ∈ maximalIdeal R := by
    rw [← hcomap, Ideal.mem_comap, hy]
    exact Ideal.mem_span_singleton_self _
  have hle : maximalIdeal R ≤ Ideal.span {x} ⊔ maximalIdeal R • maximalIdeal R := by
    intro a ha
    have ha' : φ a ∈ Ideal.span {φ x} := by
      rw [← Ideal.submodule_span_eq, ← hy, ← Ideal.mem_comap, hcomap]
      exact ha
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 ha'
    obtain ⟨c, rfl⟩ := hφ c
    have hker' : a - c * x ∈ Ideal.span {h} := by
      rw [← hker, RingHom.mem_ker, map_sub, map_mul, hc, sub_self]
    refine Submodule.mem_sup.2 ⟨c * x, Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self x),
      a - c * x, ?_, by ring⟩
    rw [smul_eq_mul, ← pow_two]
    exact (Ideal.span_singleton_le_iff_mem _).2 hh2 hker'
  have hmx : maximalIdeal R = Ideal.span {x} :=
    le_antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot (maximalIdeal R).fg_of_isNoetherianRing
      (by rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top]) hle)
      ((Ideal.span_singleton_le_iff_mem _).2 hxm)
  have h1 : (maximalIdeal R).spanFinrank ≤ 1 := by
    rw [hmx]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton x)).trans
      (Set.ncard_singleton x).le
  omega

end IsLocalRing

namespace AlgebraicGeometry

open CategoryTheory

universe u

section ClosedSubscheme

variable {R : CommRingCat.{u}} {D : Scheme.{u}} (d : D ⟶ Spec R)

/-- For a closed immersion `d : D ⟶ Spec R`, the ring map `R ⟶ Γ(D, ⊤)` is surjective. -/
lemma Scheme.Hom.surjective_ΓSpecIso_inv_comp_appTop [IsClosedImmersion d] :
    Function.Surjective ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom := by
  rw [CommRingCat.hom_comp, RingHom.coe_comp]
  exact (IsClosedImmersion.isAffine_surjective_of_isAffine d).2.comp
    (Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv.symm.surjective

/-- The range of a closed immersion `d : D ⟶ Spec R` is the zero locus of the kernel of
`R ⟶ Γ(D, ⊤)`. -/
lemma Scheme.Hom.range_eq_zeroLocus_ker [IsClosedImmersion d] :
    Set.range d =
      PrimeSpectrum.zeroLocus (RingHom.ker ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom) := by
  obtain ⟨I, e, rfl⟩ := IsClosedImmersion.Spec_iff.1 ‹IsClosedImmersion d›
  have hker : RingHom.ker ((Scheme.ΓSpecIso R).inv ≫
      (e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).appTop).hom = I := by
    have : IsIso e.hom.appTop := inferInstanceAs (IsIso (Scheme.Γ.map e.hom.op))
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc, CommRingCat.hom_comp, RingHom.ker_comp_of_injective, CommRingCat.hom_ofHom,
      Ideal.mk_ker]
    exact (ConcreteCategory.bijective_of_isIso (C := CommRingCat) _).1
  have hr : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) =
      PrimeSpectrum.zeroLocus (I : Set R) := by
    rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
  rw [hker]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact hr.subset ⟨e.hom y, rfl⟩
  · intro hx
    obtain ⟨z, rfl⟩ := hr.symm.subset hx
    obtain ⟨y, rfl⟩ := e.hom.surjective z
    exact ⟨y, rfl⟩

/-- If the ideal of a closed immersion `d : D ⟶ Spec R` is generated by `f`, its open complement
is the basic open `D(f)`. -/
lemma Scheme.Hom.openComplement_eq_basicOpen [IsClosedImmersion d] {f : R}
    (hf : RingHom.ker ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom = Ideal.span {f}) :
    d.openComplement = PrimeSpectrum.basicOpen f := by
  ext1
  rw [Scheme.Hom.coe_openComplement, Scheme.Hom.range_eq_zeroLocus_ker, hf,
    PrimeSpectrum.zeroLocus_span, PrimeSpectrum.basicOpen_eq_zeroLocus_compl]

/-- A morphism `d : D ⟶ Spec R` whose ring map `R ⟶ Γ(D, ⊤)` kills `J` factors through
`Spec (R ⧸ J)`. -/
noncomputable def Scheme.Hom.toSpecQuotient {J : Ideal R}
    (hJ : J ≤ RingHom.ker ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom) :
    D ⟶ Spec (.of (R ⧸ J)) :=
  D.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
    (Ideal.Quotient.lift J ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom fun _ ha ↦ hJ ha))

@[reassoc (attr := simp)]
lemma Scheme.Hom.toSpecQuotient_comp {J : Ideal R}
    (hJ : J ≤ RingHom.ker ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom) :
    d.toSpecQuotient hJ ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) = d := by
  rw [toSpecQuotient, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
    Ideal.Quotient.lift_comp_mk, CommRingCat.ofHom_hom, Spec.map_comp,
    ← Scheme.toSpecΓ_naturality_assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]

/-- A point of `D` sent by `D ⟶ Spec (R ⧸ J)` to the closed point lies over the closed point
of `Spec R`. -/
lemma Scheme.Hom.apply_eq_closedPoint_of_toSpecQuotient [IsLocalRing R] {J : Ideal R}
    [IsLocalRing (R ⧸ J)]
    (hJ : J ≤ RingHom.ker ((Scheme.ΓSpecIso R).inv ≫ d.appTop).hom) {x : D}
    (hx : d.toSpecQuotient hJ x = closedPoint (R ⧸ J)) : d x = closedPoint R := by
  rw [← d.toSpecQuotient_comp hJ, Scheme.Hom.comp_apply, hx]
  refine PrimeSpectrum.ext (eq_maximalIdeal ?_)
  exact Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    (K := maximalIdeal (R ⧸ J))

end ClosedSubscheme

end AlgebraicGeometry

namespace AlgebraicGeometry.Etale

open CategoryTheory Limits Scheme

variable {k : Type u} [Field k] [IsAlgClosed k] (S : Over (Spec (.of k)))
  [SmoothOfRelativeDimension 2 S.hom] (t : Spec (.of k) ⟶ S.left)

/-- **Blowup restriction vanishing**, with the complements `T - D` and `T - (D ∪ H)` given by
opens equal to the basic opens `D(f)` and `D(fh)`, and the punctured curve `B - t` replaced by any
scheme `Y` with a map `Y ⟶ T - D` factoring through the punctured spectrum of `R/(g)`. -/
theorem globalSectionsRestriction_eq_zero_of_eq_basicOpen {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓ : (ℓ : k) ≠ 0) {Λ : Type (u + 1)} [CommRing Λ] [Finite Λ] (hΛ : IsNilpotent (ℓ : Λ))
    (ht : t ≫ S.hom = 𝟙 _) {f g h : Scheme.strictHenselization t}
    [Fact (g ∈ maximalIdeal (Scheme.strictHenselization t))]
    (hf : f ≠ 0) (hg : g ≠ 0) (hh : HasOrder h 1)
    (hDB : TangentConesMeetAtOrigin _ (Ideal.span {f}) (Ideal.span {g}))
    (hDH : TangentConesMeetAtOrigin _ (Ideal.span {f}) (Ideal.span {h}))
    {U V : (Spec (.of (Scheme.strictHenselization t))).Opens}
    (hU : U = specBasicOpen (R := .of _) f)
    (hV : V = specBasicOpen (R := .of _) (f * h)) (hVU : V ≤ U) {Y : Scheme.{u}} (ψ : Y ⟶ U)
    (χ : Y ⟶ (puncturedSpec (Scheme.strictHenselization t ⧸ Ideal.span {g})).toScheme)
    (hχ : χ ≫ (puncturedSpec _).ι ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) =
      ψ ≫ U.ι)
    (E : DerivedCategory (Sheaf V.toScheme.smallEtaleTopology (ModuleCat.{u + 1} Λ)))
    (hE : HasFiniteEllMonodromy ℓ E) :
    globalSectionsRestriction ψ ((openImmersionLowerShriek (ModuleCat.{u + 1} Λ)
      ((Spec (.of (Scheme.strictHenselization t))).homOfLE hVU)).mapDerivedCategory.obj E) =
        0 := by
  subst hU hV
  obtain rfl : χ ≫ Scheme.puncturedCurveMap (maximalIdeal_le_radical_of_smooth S t ht hDB) = ψ := by
    rw [← cancel_mono (specBasicOpen (R := .of _) f).ι, Category.assoc, Scheme.puncturedCurveMap,
      IsOpenImmersion.lift_fac, hχ]
  have hc := globalSectionsRestriction_comp
    (Scheme.puncturedCurveMap (maximalIdeal_le_radical_of_smooth S t ht hDB)) χ
    ((openImmersionLowerShriek (ModuleCat.{u + 1} Λ)
      ((Spec (.of (Scheme.strictHenselization t))).homOfLE hVU)).mapDerivedCategory.obj E)
  rw [blowupRestriction_eq_zero S t hℓ hΛ ht hf hg hh hDB hDH E hE, zero_comp] at hc
  exact (cancel_mono _).1 (hc.trans zero_comp.symm)

end AlgebraicGeometry.Etale
