module

public import Submission.WeilConjectures.SixFunctors.ProEtale.ModuleObject.Derived.OpenImmersionLowerStar
public import Submission.WeilConjectures.TraceFormula.ConstructibleGeneration

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!

# Generation of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` by direct images of dualizable objects

This is the dual (lower-star) form of the constructible dévissage of
`WeilConjectures.TraceFormula.ConstructibleGeneration`. Let `Y` be a separated `k`-scheme of finite
type. The *lower-star lisse generators* of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧`
(`ProEtale.CondensedRing.lisseLowerStarGenerator`) are the objects isomorphic to `Rg_* Rj_* L`,
where `g : Z ⟶ Y` is a closed immersion, `j : U ⟶ Z` an open immersion with `U` affine, and `L` a
dualizable object of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧`.

## Main statements

- `ProEtale.CondensedRing.triangEnvelope_lisseLowerStarGenerator`: every object of
  `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` lies in the triangulated subcategory generated by the lower-star lisse
  generators. The proof is the noetherian induction on the support of
  `ProEtale.CondensedRing.triangEnvelope_lisseGenerator_lowerStar`, in which the open–closed
  triangle `Rj_! Lj^* N ⟶ N ⟶ Ri_* Li^* N` is replaced by the triangle
  `F ⟶ N ⟶ Rj_* Lj^* N ⟶ F[1]` completing the unit of `Lj^* ⊣ Rj_*`. As `Lj^*` kills `F`
  (`ProEtale.CondensedRing.isZero_upperStar_of_distTriang_unit`), the open–closed triangle
  identifies `F` with `Ri_* Li^* F`
  (`ProEtale.CondensedRing.isIso_unit_upperStarLowerStar_of_isZero_upperStar`), whose support is
  strictly smaller.

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Pretriangulated

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (ℓ : ℕ) [Fact ℓ.Prime] {k : Type u} [Field k] [Fact (ringChar k).Prime]
  [Fact (ringChar k ≠ ℓ)]

variable (Y : Over (Spec (.of k))) [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
  [IsSeparated Y.hom]

/-- The *lower-star lisse generators* of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧`: the objects isomorphic to `Rg_* Rj_* L`
for a closed immersion `g : Z ⟶ Y`, an open immersion `j : U ⟶ Z` with `U` affine, and a
dualizable `L ∈ Dᵇc(U)⟦ℚ̲̄_ℓ⟧`. -/
def lisseLowerStarGenerator : ObjectProperty (Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :=
  fun N ↦
  ∃ (Z : Over (Spec (.of k))) (_ : LocallyOfFiniteType Z.hom) (_ : QuasiCompact Z.hom)
    (_ : IsSeparated Z.hom) (g : Z ⟶ Y) (_ : IsClosedImmersion g.left)
    (U : Over (Spec (.of k))) (_ : LocallyOfFiniteType U.hom) (_ : QuasiCompact U.hom)
    (_ : IsSeparated U.hom) (_ : IsAffine U.left) (j : U ⟶ Z) (_ : IsOpenImmersion j.left)
    (L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧) (_ : IsDualizable L),
    Nonempty (N ≅ (boundedConstructibleLowerStar ℓ g).obj
      ((boundedConstructibleLowerStar ℓ j).obj L))

/-- The lower-star lisse generators form a nonempty family: `Rj_* 𝟙` for the empty open
subscheme `j` of `Y` is one. -/
instance nonempty_lisseLowerStarGenerator : (lisseLowerStarGenerator ℓ Y).Nonempty :=
  have : IsClosedImmersion (𝟙 Y : Y ⟶ Y).left := inferInstanceAs (IsClosedImmersion (𝟙 Y.left))
  have : IsAffine (overRestrict Y ⊥).left := isAffineOpen_bot Y.left
  ⟨⟨_, Y, inferInstance, inferInstance, inferInstance, 𝟙 Y, inferInstance, overRestrict Y ⊥,
    inferInstance, inferInstance, inferInstance, inferInstance, overRestrictι Y ⊥, inferInstance,
    𝟙_ _, isDualizable_unit, ⟨Iso.refl _⟩⟩⟩

variable {Y}

/-- For a closed immersion `g : Z ⟶ Y`, an open immersion `j : U ⟶ Z` with `U` affine and `L` in
the triangulated subcategory of `Dᵇc(U)⟦ℚ̲̄_ℓ⟧` generated by the dualizable objects,
`Rg_* Rj_* L` lies in the triangulated subcategory generated by the lower-star lisse generators:
the composite `Rg_* ∘ Rj_*` is triangulated. -/
lemma triangEnvelope_lisseLowerStarGenerator_lowerStar_lowerStar {Z U : Over (Spec (.of k))}
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom]
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom] [IsSeparated U.hom] [IsAffine U.left]
    (g : Z ⟶ Y) [IsClosedImmersion g.left] (j : U ⟶ Z) [IsOpenImmersion j.left]
    {L : Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧}
    (hL : ObjectProperty.triangEnvelope (C := Dᵇc(U.left)⟦Profinite.padicAlgClRingObj ℓ⟧)
      IsDualizable L) :
    (lisseLowerStarGenerator ℓ Y).triangEnvelope
      ((boundedConstructibleLowerStar ℓ g).obj
        ((boundedConstructibleLowerStar ℓ j).obj L)) := by
  let F := boundedConstructibleLowerStar ℓ j ⋙
    boundedConstructibleLowerStar ℓ g
  have : ((lisseLowerStarGenerator ℓ Y).triangEnvelope.inverseImage F).IsStableUnderRetracts :=
    ⟨fun r h ↦ ObjectProperty.IsStableUnderRetracts.of_retract
      (P := (lisseLowerStarGenerator ℓ Y).triangEnvelope) (r.map F) h⟩
  refine (ObjectProperty.triangEnvelope_le_iff _
    (Q := (lisseLowerStarGenerator ℓ Y).triangEnvelope.inverseImage F)).2 (fun L hL ↦ ?_) L hL
  exact ObjectProperty.le_triangEnvelope _ _ ⟨Z, inferInstance, inferInstance, inferInstance, g,
    inferInstance, U, inferInstance, inferInstance, inferInstance, inferInstance, j, inferInstance,
    L, hL, ⟨Iso.refl _⟩⟩

/-- For an open immersion `j : U ⟶ Z` and a distinguished triangle `F ⟶ N ⟶ Rj_* Lj^* N ⟶ F[1]`
whose second map is the unit of `Lj^* ⊣ Rj_*`, the restriction `Lj^* F` vanishes: `Lj^*` of the
unit is an isomorphism, by the triangle identity and the invertibility of the counit. -/
lemma isZero_upperStar_of_distTriang_unit {Z U : Over (Spec (.of k))}
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom]
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom] [IsSeparated U.hom] (j : U ⟶ Z)
    [IsOpenImmersion j.left] {F N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧} (a : F ⟶ N)
    (c : (boundedConstructibleLowerStar ℓ j).obj
        ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).obj N) ⟶
      (shiftFunctor _ (1 : ℤ)).obj F)
    (hT : Triangle.mk a ((boundedConstructibleUpperStarLowerStarAdjunction
      ℓ j).unit.app N) c ∈ distTriang _) :
    IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).obj F) := by
  let adj := boundedConstructibleUpperStarLowerStarAdjunction ℓ j
  have : IsIso adj.counit :=
    (Adjunction.Triple.mk
      (boundedConstructibleOpenImmersionLowerShriekUpperStarAdjunction
        (Profinite.padicAlgClRingObj ℓ) ℓ j) adj).isIso_unit_iff_isIso_counit.1 inferInstance
  have h : IsIso ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).map
      (adj.unit.app N)) := isIso_of_comp_hom_eq_id _ (adj.left_triangle_components N)
  exact Triangle.isZero₁_of_isIso₂ _
    ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).map_distinguished _ hT) h

/-- For an open immersion `j` and a closed immersion `i` onto its complement, a bounded
constructible complex `F` whose restriction `Lj^* F` vanishes is the direct image of its
restriction to the closed complement: the unit `F ⟶ Ri_* Li^* F` is an isomorphism, as the first
term `Rj_! Lj^* F` of the open–closed triangle vanishes. -/
lemma isIso_unit_upperStarLowerStar_of_isZero_upperStar {X Z U : Over (Spec (.of k))}
    [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] [IsSeparated X.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsSeparated Z.hom]
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom] [IsSeparated U.hom]
    {j : U ⟶ X} {i : Z ⟶ X} [IsOpenImmersion j.left] [IsClosedImmersion i.left]
    (hcompl : IsCompl (Set.range j.left.base) (Set.range i.left.base))
    {F : Dᵇc(X.left)⟦Profinite.padicAlgClRingObj ℓ⟧}
    (hF : IsZero ((boundedConstructibleUpperStar (Profinite.padicAlgClRingObj ℓ) ℓ j).obj F)) :
    IsIso ((boundedConstructibleUpperStarLowerStarAdjunction ℓ
      i).unit.app F) := by
  obtain ⟨δ, hT⟩ := exists_distTriang_openClosed_boundedConstructible ℓ hcompl F
  exact (Triangle.isZero₁_iff_isIso₂ _ hT).1
    ((boundedConstructibleLowerShriek ℓ j).map_isZero hF)

/-- The lower-star dévissage, by noetherian induction on the support: for a closed immersion
`g : Z ⟶ Y` with image in the closed subset `C` of `Y` and `N ∈ Dᵇc(Z)⟦ℚ̲̄_ℓ⟧`, `Rg_* N` lies in
the triangulated subcategory generated by the lower-star lisse generators. On a nonempty affine
open `U ⊆ Z` the restriction of `N` is generated by dualizable objects
(`exists_isOpenImmersion_triangEnvelope_isDualizable`); completing the unit
`N ⟶ Rj_* Lj^* N` to a distinguished triangle `F ⟶ N ⟶ Rj_* Lj^* N ⟶ F[1]`, the complex `F`
is killed by `Lj^*`, hence is the direct image of its restriction to the closed complement of `U`
(`isIso_unit_upperStarLowerStar_of_isZero_upperStar`), whose image in `Y` is strictly smaller.
By topological invariance we may first replace `Z` by its reduction. -/
theorem triangEnvelope_lisseLowerStarGenerator_lowerStar (C : TopologicalSpace.Closeds Y.left) :
    ∀ (Z : Over (Spec (.of k))) [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
      [IsSeparated Z.hom] (g : Z ⟶ Y) [IsClosedImmersion g.left],
      Set.range g.left.base ⊆ C → ∀ N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧,
        (lisseLowerStarGenerator ℓ Y).triangEnvelope
          ((boundedConstructibleLowerStar ℓ g).obj N) := by
  induction C using WellFoundedLT.induction with
  | _ C ih =>
  -- by topological invariance, we may replace `Z` by its reduction
  suffices H : ∀ (Z : Over (Spec (.of k))) [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
      [IsSeparated Z.hom] [IsReduced Z.left] (g : Z ⟶ Y) [IsClosedImmersion g.left],
      Set.range g.left.base ⊆ C → ∀ N : Dᵇc(Z.left)⟦Profinite.padicAlgClRingObj ℓ⟧,
        (lisseLowerStarGenerator ℓ Y).triangEnvelope
          ((boundedConstructibleLowerStar ℓ g).obj N) by
    intro Z _ _ _ g _ hg N
    let r := overReductionι Z
    have : IsClosedImmersion (r ≫ g).left := by rw [Over.comp_left]; infer_instance
    have := isIso_unit_boundedConstructibleUpperStarLowerStarAdjunction
      ℓ r
    refine ObjectProperty.prop_of_iso _
      ((boundedConstructibleLowerStar ℓ g).mapIso
        (asIso ((boundedConstructibleUpperStarLowerStarAdjunction
          ℓ r).unit.app N)).symm) ?_
    exact ObjectProperty.prop_of_iso _
      ((boundedConstructibleLowerStarComp ℓ r g).app _).symm
      (H _ (r ≫ g) (fun y ⟨z, hz⟩ ↦ hg ⟨r.left.base z, by simpa using hz⟩) _)
  intro Z _ _ _ _ g _ hg N
  rcases isEmpty_or_nonempty Z.left with hZ | hZ
  · exact ObjectProperty.prop_of_isZero _
      (Functor.map_isZero _ (isZero_boundedConstructible_of_isEmpty ℓ N))
  obtain ⟨U, _, _, _, _, ⟨u⟩, j, _, hN⟩ := exists_isOpenImmersion_triangEnvelope_isDualizable ℓ Z N
  let i := overClosedComplement j
  have hcompl := isCompl_range_overClosedComplement j
  obtain ⟨F, a, c, hT⟩ := distinguished_cocone_triangle₁
    ((boundedConstructibleUpperStarLowerStarAdjunction ℓ
      j).unit.app N)
  have := isIso_unit_upperStarLowerStar_of_isZero_upperStar ℓ hcompl.symm
    (isZero_upperStar_of_distTriang_unit ℓ j a c hT)
  have : IsClosedImmersion (i ≫ g).left := by rw [Over.comp_left]; infer_instance
  have hlt : (⟨Set.range (i ≫ g).left.base, (i ≫ g).left.isClosedEmbedding.isClosed_range⟩ :
      TopologicalSpace.Closeds Y.left) < C := by
    refine lt_of_le_of_ne (fun y ⟨z, hz⟩ ↦ hg ⟨i.left.base z, by simpa using hz⟩) fun h ↦ ?_
    have hy : g.left.base (j.left.base u) ∈ (C : Set Y.left) := hg ⟨_, rfl⟩
    rw [← h] at hy
    obtain ⟨z, hz⟩ := hy
    have hz' : i.left.base z = j.left.base u :=
      g.left.isClosedEmbedding.injective (by simpa using hz)
    exact Set.disjoint_left.1 hcompl.disjoint ⟨z, hz'⟩ ⟨u, rfl⟩
  refine ObjectProperty.ext_of_isTriangulatedClosed₂ _ _
    ((boundedConstructibleLowerStar ℓ g).map_distinguished _ hT)
    ?_ (triangEnvelope_lisseLowerStarGenerator_lowerStar_lowerStar ℓ g j hN)
  exact ObjectProperty.prop_of_iso _
    (((boundedConstructibleLowerStarComp ℓ i g).app _).symm ≪≫
      (boundedConstructibleLowerStar ℓ g).mapIso
        (asIso ((boundedConstructibleUpperStarLowerStarAdjunction
          ℓ i).unit.app F)).symm)
    (ih _ hlt _ (i ≫ g) subset_rfl _)

variable (Y) in
/-- **Constructible dévissage, lower-star form**: every bounded constructible `ℚ̄_ℓ`-complex on
`Y` lies in the triangulated subcategory of `Dᵇc(Y)⟦ℚ̲̄_ℓ⟧` generated by the lower-star lisse
generators `Rg_* Rj_* L`: this is `triangEnvelope_lisseLowerStarGenerator_lowerStar` for the
identity of `Y`. -/
theorem triangEnvelope_lisseLowerStarGenerator
    (N : Dᵇc(Y.left)⟦Profinite.padicAlgClRingObj ℓ⟧) :
    (lisseLowerStarGenerator ℓ Y).triangEnvelope N :=
  have : IsClosedImmersion (𝟙 Y : Y ⟶ Y).left := inferInstanceAs (IsClosedImmersion (𝟙 Y.left))
  ObjectProperty.prop_of_iso _ ((boundedConstructibleLowerStarId ℓ Y).app N)
    (triangEnvelope_lisseLowerStarGenerator_lowerStar ℓ ⊤ Y (𝟙 Y) (Set.subset_univ _) N)

end AlgebraicGeometry.ProEtale.CondensedRing
