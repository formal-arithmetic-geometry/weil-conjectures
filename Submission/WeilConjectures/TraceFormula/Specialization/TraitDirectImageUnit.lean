/-!

# The unit of the geometric generic point of the trait

Let `k'` be a separably closed field, `S = Spec k'⟦t⟧` the strictly henselian trait,
`i : Spec k' ⟶ S` its closed point and `j : Spec Ω ⟶ S` its geometric generic point. For a
commutative condensed ring `Λ`, the unit `Λ_S ⟶ j_* j^* Λ_S` becomes an isomorphism after `i^*`
(`ProEtale.CondensedRing.isIso_upperStar_traitClosedPoint_map_unit_app`).

It suffices to check this on sections over the henselian lifts `W = Spec H_{k'⟦t⟧}(C̄)` of the
w-contractible ind-étale `k'`-algebras `C̄`, which compute the sections of `i^*`
(`ProEtale.CondensedRing.isIso_upperStar_traitClosedPoint_map_of_forall`).

Here `W = Spec H` and `W ×_S Spec Ω = Spec (H ⊗ Ω)` are spectra of w-contractible rings
(`ProEtale.isWContractibleRing_closedLift_tensorProduct_traitGenericField`), so the sections of
`Λ_S` over `W` and of `Λ_Ω` over `W ×_S Spec Ω` are `Λ(π₀ W)` and `Λ(π₀(W ×_S Spec Ω))`, and on
sections the unit is the map induced by `π₀(W ×_S Spec Ω) ⟶ π₀(W)`
(`ProEtale.bijective_unitCompUpperStarCompInv_app`). This is a homeomorphism, every idempotent of
`H ⊗ Ω` coming from `H`
(`ProEtale.bijective_pullback_fst_comp_closedLiftSpec_traitGenericPoint`).

-/

@[expose] public section

universe u

open CategoryTheory Limits MonoidalCategory Opposite

open scoped CategoryTheory.Obj TensorProduct

namespace AlgebraicGeometry.ProEtale

open Scheme

variable {k' : Type u} [Field k'] [IsSepClosed k']

/-- Ring maps `B ⟶ H_{k'⟦t⟧}(C̄)` and `B ⟶ H_{k'⟦t⟧}(C̄) ⊗ Ω` from a ring `B` additively
generated by idempotents correspond, through `H ⟶ H ⊗ Ω`: the latter injects and every
idempotent of `H ⊗ Ω` comes from `H`. Geometrically: morphisms `Spec (H ⊗ Ω) ⟶ Spec B` factor
uniquely through the projection to `Spec H`. -/
theorem bijective_specMap_includeLeft_comp_closedLift (C : Type u) [CommRing C]
    [Algebra (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    [Algebra (PowerSeries k') C]
    [IsScalarTower (PowerSeries k')
      (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    (B : CommRingCat.{u})
    (hB : ∀ b : B, b ∈ AddSubgroup.closure {e : B | IsIdempotentElem e}) :
    Function.Bijective (fun h : Spec (.of (Algebra.ClosedLift (PowerSeries k') C)) ⟶ Spec B ↦
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := PowerSeries k')
        (A := Algebra.ClosedLift (PowerSeries k') C) (B := traitGenericField k'))) ≫ h) := by
  have hC0 (a : PowerSeries k') (ha : a ∈ IsLocalRing.maximalIdeal (PowerSeries k')) :
      algebraMap (PowerSeries k') C a = 0 := by
    rw [PowerSeries.maximalIdeal_eq_span_X] at ha
    rw [IsScalarTower.algebraMap_apply (PowerSeries k')
      (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C,
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
  have hΩ : Function.Injective (algebraMap (PowerSeries k') (traitGenericField k')) :=
    (algebraMap (FractionRing (PowerSeries k')) (traitGenericField k')).injective.comp
      (IsFractionRing.injective (PowerSeries k') (FractionRing (PowerSeries k')))
  have hring := RingHom.bijective_comp_of_forall_exists_eq hB
    (Algebra.TensorProduct.includeLeftRingHom (R := PowerSeries k')
      (A := Algebra.ClosedLift (PowerSeries k') C) (B := traitGenericField k'))
    (Algebra.ClosedLift.injective_includeLeft hΩ) fun ε hε ↦
      (Algebra.ClosedLift.exists_includeLeft_eq_of_isIdempotentElem hC0 hΩ hε).imp
        fun _ h ↦ h.2
  refine ⟨fun h₁ h₂ h ↦ ?_, fun g ↦ ?_⟩
  · obtain ⟨r₁, rfl⟩ := Spec.map_surjective h₁
    obtain ⟨r₂, rfl⟩ := Spec.map_surjective h₂
    simp only [← Spec.map_comp] at h
    have := congrArg CommRingCat.Hom.hom (Spec.map_injective h)
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp] at this
    exact congrArg Spec.map (CommRingCat.hom_ext (hring.1 this))
  · obtain ⟨s, rfl⟩ := Spec.map_surjective g
    obtain ⟨r, hr⟩ := hring.2 s.hom
    refine ⟨Spec.map (CommRingCat.ofHom r), ?_⟩
    dsimp only
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact RingHom.congr_fun hr x

/-- Morphisms from the geometric generic fibre `W ×_S Spec Ω` of the henselian lift
`W = Spec H_{k'⟦t⟧}(C̄)` to the spectrum of `LC(S, ℤ)` factor uniquely through the projection to
`W`: the spaces of connected components of `W ×_S Spec Ω` and of `W` agree. -/
theorem bijective_pullback_fst_comp_closedLiftSpec_traitGenericPoint (C : Type u) [CommRing C]
    [Algebra (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    [Algebra (PowerSeries k') C]
    [IsScalarTower (PowerSeries k')
      (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    (S : Profinite.{u}) :
    Function.Bijective
      (fun h : (closedLiftSpec (.of (PowerSeries k')) C).left ⟶ profiniteToScheme.obj S ↦
        pullback.fst (closedLiftSpec (.of (PowerSeries k')) C).hom (traitGenericPoint k') ≫ h) := by
  have hS := bijective_specMap_includeLeft_comp_closedLift (k' := k') C
    (CommRingCat.of (LocallyConstant S ℤ)) LocallyConstant.mem_closure_isIdempotentElem
  have hiso : Function.Bijective (fun g : Spec (.of (Algebra.ClosedLift (PowerSeries k') C ⊗[
      PowerSeries k'] traitGenericField k')) ⟶ profiniteToScheme.obj S ↦
        (pullbackSpecIso (PowerSeries k') (Algebra.ClosedLift (PowerSeries k') C)
          (traitGenericField k')).hom ≫ g) :=
    ⟨fun a b h ↦ (cancel_epi _).1 h, fun g ↦ ⟨(pullbackSpecIso _ _ _).inv ≫ g, by simp⟩⟩
  have hf : pullback.fst (closedLiftSpec (.of (PowerSeries k')) C).hom (traitGenericPoint k') =
      (pullbackSpecIso (PowerSeries k') (Algebra.ClosedLift (PowerSeries k') C)
        (traitGenericField k')).hom ≫
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) :=
    (pullbackSpecIso_hom_fst ..).symm
  simp only [hf, Category.assoc]
  exact hiso.comp hS

end AlgebraicGeometry.ProEtale

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]

/-- On underlying sheaves, the unit `Λ_Y ⟶ f_* f^* Λ_Y` of module objects followed by `f_*` of the
identification `(f^* Λ_Y).X ≅ Λ_X` is the canonical coefficient morphism `η_f : Λ_Y ⟶ f_* Λ_X`. -/
lemma unit_app_hom_comp_map_η_hom {X Y : Scheme.{u}} (f : X ⟶ Y) :
    ((upperStarLowerStarAdjunction Λ f).unit.app (𝟙_ _)).hom ≫
      (f)_*[Ab.{u + 1}].map (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom =
    condensedPushforwardHom Λ f := by
  rw [upperStarLowerStarAdjunction_unit_app_hom, Category.assoc, ← Functor.map_comp,
    upperStarUnitHom, extendUnitHom_η_upperStar]
  rfl

/-- The unit `Λ_Y ⟶ f_* f^* Λ_Y` of module objects is bijective on sections over `V` as soon as the
canonical coefficient morphism `η_f : Λ_Y ⟶ f_* Λ_X` is. -/
lemma bijective_unit_app_hom_app_of_bijective {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.ProEt)
    (h : Function.Bijective ((condensedPushforwardHom Λ f).hom.app (op V))) :
    Function.Bijective
      (((upperStarLowerStarAdjunction Λ f).unit.app (𝟙_ _)).hom.hom.app (op V)) := by
  have : IsIso (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom := by
    have : IsIso (upperStarUnitHom Λ f (𝟙_ _) ≫ (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom) := by
      rw [upperStarUnitHom, extendUnitHom_η_upperStar]
      infer_instance
    exact IsIso.of_isIso_comp_left (upperStarUnitHom Λ f (𝟙_ _)) _
  have : IsIso (((f)_*[Ab.{u + 1}].map (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom).hom.app (op V)) :=
    inferInstanceAs (IsIso (((sheafToPresheaf _ _ ⋙ (CategoryTheory.evaluation _ _).obj (op V)).map
      ((f)_*[Ab.{u + 1}].map (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom))))
  have : IsIso ((condensedPushforwardHom Λ f).hom.app (op V)) :=
    (ConcreteCategory.isIso_iff_bijective _).2 h
  have hk := congrArg (fun g ↦ g.hom.app (op V)) (unit_app_hom_comp_map_η_hom Λ f)
  simp only [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app] at hk
  have : IsIso (((upperStarLowerStarAdjunction Λ f).unit.app (𝟙_ _)).hom.hom.app (op V) ≫
      ((f)_*[Ab.{u + 1}].map (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom).hom.app (op V)) := by
    rw [hk]
    infer_instance
  have := IsIso.of_isIso_comp_right
    (((upperStarLowerStarAdjunction Λ f).unit.app (𝟙_ _)).hom.hom.app (op V))
    (((f)_*[Ab.{u + 1}].map (Functor.OplaxMonoidal.η (f)^*⟦Λ⟧).hom).hom.app (op V))
  exact ConcreteCategory.bijective_of_isIso _

omit [MonObj Λ] [IsCommMonObj Λ] in
/-- The canonical coefficient morphism `η_f : Λ_Y ⟶ f_* Λ_X` is the morphism adjoint to the
composition isomorphism of the pullbacks, followed by `f_*` of `f ≫ π_Y = π_X`. -/
lemma bijective_condensedPushforwardHom_app_of_bijective {X Y : Scheme.{u}} (f : X ⟶ Y)
    (V : Y.ProEt)
    (h : Function.Bijective (((ProEtale.upperStarLowerStarAdjunction Ab.{u + 1} f).unit.app
        ((toSpecZ Y)^*[Ab.{u + 1}].obj (pointUpperStar.obj Λ)) ≫
      (f)_*[Ab.{u + 1}].map ((ProEtale.upperStarComp Ab.{u + 1} f (toSpecZ Y)).inv.app
        (pointUpperStar.obj Λ) ≫
          (eqToHom (congrArg (ProEtale.upperStar Ab.{u + 1}) (comp_toSpecZ f))).app
            (pointUpperStar.obj Λ))).hom.app (op V))) :
    Function.Bijective ((condensedPushforwardHom Λ f).hom.app (op V)) := by
  rw [← unitAlgHom_comp_map_condensedPullbackHom, condensedPullbackHom_eq]
  exact h

/-- The unit `Λ_S ⟶ j_* j^* Λ_S` of the geometric generic point `j : Spec Ω ⟶ S` of the trait is
bijective on sections over the henselian lift `W = Spec H_{k'⟦t⟧}(C̄)` of a w-contractible
ind-étale `k'⟦t⟧ ⧸ (t)`-algebra `C̄`: both `W` and `W ×_S Spec Ω` are spectra of w-contractible
rings, so the sections of `Λ_S` over `W` and of `Λ_Ω` over `W ×_S Spec Ω` are `Λ(π₀ W)` and
`Λ(π₀(W ×_S Spec Ω))` (`AlgebraicGeometry.ProEtale.bijective_unitCompUpperStarCompInv_app`), and
`π₀(W ×_S Spec Ω) ≅ π₀(W)` since every idempotent of `H ⊗ Ω` comes from `H`. -/
theorem bijective_unit_app_hom_app_closedLiftSpec {k' : Type u} [Field k'] [IsSepClosed k']
    (C : Type u) [CommRing C]
    [Algebra (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    [Algebra (PowerSeries k') C]
    [IsScalarTower (PowerSeries k')
      (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    [Algebra.IndEtale (PowerSeries k' ⧸ Ideal.span {(PowerSeries.X : PowerSeries k')}) C]
    (hC : IsWContractibleRing C) :
    Function.Bijective (((upperStarLowerStarAdjunction Λ (traitGenericPoint k')).unit.app
      (𝟙_ _)).hom.hom.app (op (closedLiftSpec (.of (PowerSeries k')) C))) := by
  have := isWContractibleRing_closedLift_tensorProduct_traitGenericField (k' := k') C hC
  refine bijective_unit_app_hom_app_of_bijective Λ _ _
    (bijective_condensedPushforwardHom_app_of_bijective Λ _ _
      (bijective_unit_app_comp_lowerStar_map_upperStarComp_inv_app_comp Λ _ _ _
        (comp_toSpecZ (traitGenericPoint k')) _ ?_ ?_
        (bijective_pullback_fst_comp_closedLiftSpec_traitGenericPoint C)))
  · -- `W` is the spectrum of a w-contractible ring.
    exact bijective_toSheafify_connectedComponentsAlong_of_forall_exists_retraction _ Λ
      (Algebra.ClosedLift.exists_retraction (A := PowerSeries k') (C := C)
        (Ideal.span {(PowerSeries.X : PowerSeries k')})
        fun T _ _ _ _ ↦ IsWContractibleRing.exists_retraction C T)
      (Iso.refl (Spec (.of (Algebra.ClosedLift (PowerSeries k') C))))
  · -- `W ×_S Spec Ω` is the spectrum of a w-contractible ring.
    exact bijective_toSheafify_connectedComponentsAlong_of_forall_exists_retraction _ Λ
      (fun T _ _ _ _ ↦ IsWContractibleRing.exists_retraction _ T)
      (pullbackSpecIso (PowerSeries k') (Algebra.ClosedLift (PowerSeries k') C)
        (traitGenericField k'))

variable (k' : Type u) [Field k'] [IsSepClosed k']

/-- After restriction to the closed point of the trait, the unit `Λ_S ⟶ j_* j^* Λ_S` of the
geometric generic point `j : Spec Ω ⟶ S` is an isomorphism. -/
theorem isIso_upperStar_traitClosedPoint_map_unit_app :
    IsIso ((traitClosedPoint k')^*⟦Λ⟧.map
      ((upperStarLowerStarAdjunction Λ (traitGenericPoint k')).unit.app (𝟙_ _))) :=
  isIso_upperStar_traitClosedPoint_map_of_forall Λ _ fun C _ _ _ _ _ hC ↦
    bijective_unit_app_hom_app_closedLiftSpec Λ C hC

end AlgebraicGeometry.ProEtale.CondensedRing
