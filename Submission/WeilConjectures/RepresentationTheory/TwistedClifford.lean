module

public import Submission.WeilConjectures.RepresentationTheory.Clifford

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Clifford theory for an operator twisting a representation

Let `ρ` be a nonzero finite-dimensional representation of a group `G` over an algebraically
closed field and `Θ` a linear automorphism of the underlying space which twists `ρ`: for every
`g` there is `g'` with `ρ(g) ∘ Θ = Θ ∘ ρ(g')`. Then some irreducible subrepresentation is
stable under a positive power of `Θ`
(`Representation.exists_isIrreducible_pow_apply_mem_of_twist`). In the application `G` is the
geometric fundamental group, acting on a stalk of a lisse sheaf, and `Θ` is a local Frobenius.
-/

@[expose] public section

namespace Representation

variable {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]

/-- Conjugation by an operator `Θ` twisting `ρ` preserves the subalgebra generated by `ρ`. -/
theorem symm_mul_mul_mem_adjoin_of_twist (ρ : Representation k G V) (Θ : V ≃ₗ[k] V)
    (hΘ : ∀ g, ∃ g', ∀ v, ρ g (Θ v) = Θ (ρ g' v)) {a : Module.End k V}
    (ha : a ∈ Algebra.adjoin k (ρ '' (⊤ : Subgroup G))) :
    (Θ.symm : Module.End k V) * a * (Θ : Module.End k V) ∈
      Algebra.adjoin k (ρ '' (⊤ : Subgroup G)) := by
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨g, -, rfl⟩ := hx
    obtain ⟨g', hg'⟩ := hΘ g
    have : (Θ.symm : Module.End k V) * ρ g * (Θ : Module.End k V) = ρ g' := by
      ext v
      simp [hg']
    rw [this]
    exact Algebra.subset_adjoin ⟨g', Subgroup.mem_top g', rfl⟩
  | algebraMap c =>
    have : (Θ.symm : Module.End k V) * algebraMap k (Module.End k V) c * (Θ : Module.End k V) =
        algebraMap k (Module.End k V) c := by
      ext v
      simp
    rw [this]
    exact Subalgebra.algebraMap_mem _ c
  | add x y _ _ hx hy =>
    rw [mul_add, add_mul]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    have : (Θ.symm : Module.End k V) * (x * y) * (Θ : Module.End k V) =
        (Θ.symm : Module.End k V) * x * (Θ : Module.End k V) *
          ((Θ.symm : Module.End k V) * y * (Θ : Module.End k V)) := by
      ext v
      simp
    rw [this]
    exact mul_mem hx hy


variable [IsAlgClosed k] [FiniteDimensional k V]

/-- **Clifford theory for a twisting operator.** Let `ρ` be a nonzero finite-dimensional
representation of `G` over an algebraically closed field and `Θ` a linear automorphism with
`ρ(g) ∘ Θ = Θ ∘ ρ(g')` for some `g'` depending on `g`. Then there is a nonzero subspace `C`,
stable under `ρ`, irreducible (every `ρ`-stable subspace of `C` is `0` or `C`), and stable under a
positive power of `Θ`. -/
theorem exists_isIrreducible_pow_apply_mem_of_twist [Nontrivial V] (ρ : Representation k G V)
    (Θ : V ≃ₗ[k] V) (hΘ : ∀ g, ∃ g', ∀ v, ρ g (Θ v) = Θ (ρ g' v)) :
    ∃ j, 0 < j ∧ ∃ C : Submodule k V, C ≠ ⊥ ∧ (∀ g, ∀ x ∈ C, ρ g x ∈ C) ∧
      (∀ D : Submodule k V, (∀ g, ∀ x ∈ D, ρ g x ∈ D) → D ≤ C → D = ⊥ ∨ D = C) ∧
      ∀ x ∈ C, ((Θ : Module.End k V) ^ j) x ∈ C := by
  set A := Algebra.adjoin k (ρ '' (⊤ : Subgroup G))
  have hA (a : A) : (Θ.symm : Module.End k V) * a * (Θ : Module.End k V) ∈ A :=
    ρ.symm_mul_mul_mem_adjoin_of_twist Θ hΘ a.2
  -- conjugation by `Θ` is an injective, hence bijective, endomorphism of `A`
  let φ : A →ₗ[k] A :=
    { toFun a := ⟨(Θ.symm : Module.End k V) * a * (Θ : Module.End k V), hA a⟩
      map_add' a b := Subtype.ext (by simp [mul_add, add_mul])
      map_smul' c a := Subtype.ext (by simp) }
  have hφ : Function.Injective φ := by
    intro a b hab
    have h := congrArg (fun x : A ↦ (Θ : Module.End k V) * x * (Θ.symm : Module.End k V)) hab
    refine Subtype.ext ?_
    ext v
    have := LinearMap.congr_fun h v
    simpa [φ] using this
  have hφs : Function.Surjective φ := LinearMap.injective_iff_surjective.1 hφ
  have h₁ (a : A) :
      ∃ b : A, ∀ m : V, (Θ : Module.End k V) (a • m) = b • (Θ : Module.End k V) m := by
    obtain ⟨b, hb⟩ := hφs a
    refine ⟨b, fun m ↦ ?_⟩
    have := LinearMap.congr_fun (congrArg Subtype.val hb) m
    simp only [φ, LinearMap.coe_mk, AddHom.coe_mk, Module.End.mul_apply] at this
    rw [Subalgebra.smul_def, Subalgebra.smul_def, Module.End.smul_def, Module.End.smul_def,
      ← this]
    simp
  have h₂ (a : A) : ∃ b : A, ∀ m : V, (Θ : Module.End k V) (b • m) = a • (Θ : Module.End k V) m :=
    ⟨φ a, fun m ↦ by simp [φ, Subalgebra.smul_def]⟩
  obtain ⟨j, hj, C, hC, hCΘ⟩ := Submodule.exists_isSimpleModule_pow_apply_mem
    (R := A) (Θ := (Θ : Module.End k V)) Θ.bijective h₁ h₂
  have hCat := isSimpleModule_iff_isAtom.mp hC
  refine ⟨j, hj, C.restrictScalars k, fun h ↦ hCat.1 ?_, fun g x hx ↦ ?_, fun D hD hDC ↦ ?_, hCΘ⟩
  · rw [← Submodule.restrictScalars_eq_bot_iff k, h]
  · exact C.smul_mem ⟨ρ g, Algebra.subset_adjoin ⟨g, Subgroup.mem_top g, rfl⟩⟩ hx
  · let D' : Submodule A V :=
      { D.toAddSubmonoid with
        smul_mem' a _ hx :=
          ρ.le_comap_of_mem_adjoin_image ⊤ (fun g _ ↦ fun x hx ↦ hD g x hx) a.2 hx }
    have hDD' : D = D'.restrictScalars k := rfl
    have hD'C : D' ≤ C := hDC
    rcases hCat.le_iff.mp hD'C with h | h
    · left
      rw [hDD', h, Submodule.restrictScalars_bot]
    · right
      rw [hDD', h]

end Representation
