/-!
# Extending homomorphisms from dense subgroups of compact groups

Let `α : W →* Π` be a homomorphism with dense range into a compact Hausdorff group and
`A : W →* Γ` a homomorphism into a compact Hausdorff group which is "uniformly continuous along
`α`": for every neighbourhood `U` of `1` in `Γ` there is a neighbourhood `O` of `1` in `Π` with
`α w ∈ O → A w ∈ U`. Then `A` factors as `σ ∘ α` for a continuous homomorphism `σ : Π →* Γ`
(`MonoidHom.exists_continuous_comp_eq_of_denseRange`): the closure of the graph of `(α, A)` is a
compact subgroup of `Π × Γ` mapping bijectively, hence homeomorphically, onto `Π`.

For Weil-type groups (Deligne, Weil II, 1.1.7) the uniform continuity follows from continuity on
the geometric part (`MonoidHom.exists_continuous_comp_eq_of_deg`): if `W` is generated by the
image of a compact group `G₀ → W` (on which `α` is a closed embedding and `A` is continuous) and
an element `γ` of degree one, and `α` detects the degree modulo every `m`, then `A` extends.
This is how a representation of the Weil group `W(X₀) ⊆ π₁(X₀)` with compact image extends to a
continuous representation of `π₁(X₀)`.

## Main statements

- `MonoidHom.exists_continuous_comp_eq_of_denseRange`.
- `MonoidHom.exists_continuous_comp_eq_of_deg`.
-/

@[expose] public section

open Topology

namespace MonoidHom

variable {W P Γ : Type*} [Group W] [Group P] [TopologicalSpace P] [IsTopologicalGroup P]
  [CompactSpace P] [T2Space P] [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
  [CompactSpace Γ] [T2Space Γ]

/-- **Continuous extension from a dense subgroup.** Let `α : W →* Π` have dense range in a
compact Hausdorff group, and `A : W →* Γ` take values in a compact Hausdorff group, such that
for every neighbourhood `U` of `1` in `Γ` there is a neighbourhood `O` of `1` in `Π` with
`α w ∈ O → A w ∈ U`. Then `A = σ ∘ α` for a continuous homomorphism `σ : Π →* Γ`: the closure
`H` of the graph `{(α w, A w)}` is a compact subgroup of `Π × Γ` whose first projection is
surjective (its image is compact and dense) and injective (an element `(1, x)` of `H` has `x` in
the closure of every neighbourhood of `1`), hence a homeomorphism `H ≅ Π`. -/
theorem exists_continuous_comp_eq_of_denseRange (α : W →* P) (A : W →* Γ) (hα : DenseRange α)
    (hA : ∀ U ∈ 𝓝 (1 : Γ), ∃ O ∈ 𝓝 (1 : P), ∀ w, α w ∈ O → A w ∈ U) :
    ∃ σ : P →* Γ, Continuous σ ∧ σ.comp α = A := by
  set f : W →* P × Γ := α.prod A
  set H : Subgroup (P × Γ) := f.range.topologicalClosure
  have hHc : IsClosed (H : Set (P × Γ)) := f.range.isClosed_topologicalClosure
  have : CompactSpace H := isCompact_iff_compactSpace.1 hHc.isCompact
  have hfH (w : W) : f w ∈ H := f.range.le_topologicalClosure ⟨w, rfl⟩
  let q : H →* P := (MonoidHom.fst P Γ).comp H.subtype
  have hqc : Continuous q := continuous_fst.comp continuous_subtype_val
  have hqα (w : W) : q ⟨f w, hfH w⟩ = α w := rfl
  have hsurj : Function.Surjective q := by
    have hcl : IsClosed (Set.range q) := (isCompact_range hqc).isClosed
    have hsub : Set.range α ⊆ Set.range q := by
      rintro _ ⟨w, rfl⟩
      exact ⟨_, hqα w⟩
    have := hcl.closure_subset_iff.2 hsub
    rw [hα.closure_range] at this
    exact fun x ↦ this (Set.mem_univ x)
  have hinj : Function.Injective q := by
    refine (injective_iff_map_eq_one q).2 fun x hx ↦ ?_
    obtain ⟨⟨x₁, x₂⟩, hxH⟩ := x
    obtain rfl : x₁ = 1 := hx
    -- `x₂` lies in the closure of every neighbourhood of `1`
    have hcl (U : Set Γ) (hU : U ∈ 𝓝 (1 : Γ)) : x₂ ∈ closure U := by
      obtain ⟨O, hO, hOU⟩ := hA U hU
      refine mem_closure_iff_nhds.2 fun V hV ↦ ?_
      have hmem : ((1 : P), x₂) ∈ closure (Set.range f) := hxH
      obtain ⟨_, hy, ⟨w, rfl⟩⟩ :=
        mem_closure_iff_nhds.1 hmem _ (prod_mem_nhds hO hV)
      exact ⟨A w, hy.2, hOU w hy.1⟩
    by_contra hne
    have hne' : x₂ ≠ 1 := fun h ↦ hne (Subtype.ext (Prod.ext rfl h))
    obtain ⟨U, hU, hUc, hUs⟩ := exists_mem_nhds_isClosed_subset
      (isOpen_compl_singleton.mem_nhds hne'.symm)
    exact hUs (hUc.closure_subset (hcl U hU)) rfl
  let e : H ≃* P := MulEquiv.ofBijective q ⟨hinj, hsurj⟩
  let h : H ≃ₜ P := hqc.homeoOfEquivCompactToT2 (f := e.toEquiv)
  refine ⟨(MonoidHom.snd P Γ).comp (H.subtype.comp e.symm.toMonoidHom), ?_, ?_⟩
  · exact continuous_snd.comp (continuous_subtype_val.comp h.symm.continuous)
  · ext w
    have he : e.symm (α w) = ⟨f w, hfH w⟩ := e.symm_apply_eq.2 (hqα w).symm
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, he, Subgroup.coe_subtype,
      MonoidHom.coe_snd]
    rfl

/-- **Continuous extension from a Weil-type group.** Let `W` be a group with a degree
`deg : W →* ℤ`, an element `γ` of degree one, and a homomorphism `θ : G₀ →* W` from a compact
Hausdorff group onto `ker deg`. Let `α : W →* Π` have dense range in a profinite group, such that
`α ∘ θ` is continuous and injective, and such that `α` detects the degree modulo every `m > 0`
(an open neighbourhood `O` of `1` with `α w ∈ O → m ∣ deg w`). Then every homomorphism
`A : W →* Γ` into a profinite group with `A ∘ θ` continuous is `σ ∘ α` for a continuous
`σ : Π →* Γ`.

Given an open normal subgroup `N` of `Γ`, the open subgroup `(A ∘ θ)⁻¹ N` of `G₀` is cut out by an
open normal subgroup `O₂` of `Π`, `α ∘ θ` being a closed embedding; for `m` the index of
`O₂ × N`, `(α γ ^ m, A γ ^ m) ∈ O₂ × N`, and then `α w ∈ O₂ ∩ O_m` forces `A w ∈ N`. -/
theorem exists_continuous_comp_eq_of_deg [TotallyDisconnectedSpace P] [TotallyDisconnectedSpace Γ]
    {G₀ : Type*} [Group G₀] [TopologicalSpace G₀] [CompactSpace G₀]
    (deg : W →* Multiplicative ℤ) {γ : W} (hγ : deg γ = Multiplicative.ofAdd 1) (θ : G₀ →* W)
    (hθ : ∀ w, deg w = 1 → ∃ g, θ g = w) (α : W →* P) (A : W →* Γ) (hα : DenseRange α)
    (hαθ : Continuous (α.comp θ)) (hαθinj : Function.Injective (α.comp θ))
    (hAθ : Continuous (A.comp θ))
    (hdeg : ∀ m : ℕ, 0 < m → ∃ O : Set P, IsOpen O ∧ (1 : P) ∈ O ∧
      ∀ w, α w ∈ O → (m : ℤ) ∣ Multiplicative.toAdd (deg w)) :
    ∃ σ : P →* Γ, Continuous σ ∧ σ.comp α = A := by
  refine exists_continuous_comp_eq_of_denseRange α A hα fun U hU ↦ ?_
  obtain ⟨N, hNU⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one
    isOpen_interior (mem_interior_iff_mem_nhds.2 hU)
  have hNU' : (N : Set Γ) ⊆ U := hNU.trans interior_subset
  -- the open subgroup `(A ∘ θ)⁻¹ N` of `G₀` is cut out by an open normal subgroup of `Π`
  have hemb : IsClosedEmbedding (α.comp θ) := hαθ.isClosedEmbedding hαθinj
  have hS : IsOpen ((A.comp θ) ⁻¹' (N : Set Γ)) := N.isOpen.preimage hAθ
  obtain ⟨O₁, hO₁, hO₁S⟩ := hemb.isInducing.isOpen_iff.1 hS
  have h1O₁ : (1 : P) ∈ O₁ := by
    have : (1 : G₀) ∈ (α.comp θ) ⁻¹' O₁ := by
      rw [hO₁S]
      simp
    simpa using this
  obtain ⟨O₂, hO₂⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hO₁ h1O₁
  -- a power `γ ^ m`, `m > 0`, lands in `O₂ × N`
  set K : Subgroup (P × Γ) := (O₂ : Subgroup P).prod (N : Subgroup Γ)
  have hKo : IsOpen (K : Set (P × Γ)) := O₂.isOpen.prod N.isOpen
  have : Finite ((P × Γ) ⧸ K) := Subgroup.quotient_finite_of_isOpen K hKo
  set m := K.index
  have hm : 0 < m := Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite (H := K))
  have hγm : (α γ ^ m, A γ ^ m) ∈ K := by
    have := K.pow_index_mem (α γ, A γ)
    simpa using this
  obtain ⟨Om, hOm, h1Om, hOmdeg⟩ := hdeg m hm
  refine ⟨(O₂ : Set P) ∩ Om, Filter.inter_mem (O₂.isOpen.mem_nhds O₂.one_mem) (hOm.mem_nhds h1Om),
    fun w hw ↦ hNU' ?_⟩
  obtain ⟨n, hn⟩ := hOmdeg w hw.2
  set k := Multiplicative.toAdd (deg w)
  -- `w = θ g * γ ^ (m n)`
  obtain ⟨g, hg⟩ := hθ (w * γ ^ (-k)) (by
    rw [map_mul, map_zpow, hγ, ← ofAdd_zsmul, smul_eq_mul, mul_one]
    change deg w * Multiplicative.ofAdd (-Multiplicative.toAdd (deg w)) = 1
    rw [ofAdd_neg, ofAdd_toAdd, mul_inv_cancel])
  have hw' : w = θ g * (γ ^ m) ^ n := by
    rw [hg, ← zpow_natCast, ← zpow_mul, ← hn, zpow_neg, inv_mul_cancel_right]
  have hαg : α (θ g) ∈ O₂ := by
    have : α (θ g) = α w * ((α γ ^ m) ^ n)⁻¹ := by
      rw [hw', map_mul, map_zpow, map_pow, mul_inv_cancel_right]
    rw [this]
    exact O₂.mul_mem hw.1 (O₂.inv_mem (O₂.zpow_mem (Subgroup.mem_prod.1 hγm).1 n))
  have hAg : A (θ g) ∈ N := by
    have : g ∈ (α.comp θ) ⁻¹' O₁ := hO₂ hαg
    rw [hO₁S] at this
    exact this
  rw [hw', map_mul, map_zpow, map_pow]
  exact N.mul_mem hAg (N.zpow_mem (Subgroup.mem_prod.1 hγm).2 n)

end MonoidHom
