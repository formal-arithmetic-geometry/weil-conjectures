/-!
# Base change and intersections of fundamental classes of regular immersions

Let `i : Z ⟶ X` be a regular closed immersion of codimension `c`, with `X` smooth over a perfect
field `k` and `Z` regular, and let `[Z ⊂ X] ∈ H^{2c}_Z(X, Λ(c))` be its fundamental class
(`AlgebraicGeometry.Etale.fundamentalClass`).

* *Flat base change.* For a flat `e : X' ⟶ X` with `X'` smooth over `k` and the base change
  `i' : Z' ⟶ X'` with `Z'` regular, the restriction of `[Z ⊂ X]` along `e` is `[Z' ⊂ X']`:
  Zariski frames of `i` pull back to Zariski frames of `i'`, and Kummer boundary products are
  compatible with pullback along any morphism. This applies in particular to a smooth `e`, for
  which the hypotheses on the base change are automatic.
* *Frames of an intersection.* For regular closed immersions `i₁ : Y₁ ⟶ X`, `i₂ : Y₂ ⟶ X` and
  `Y = Y₁ ×_X Y₂`, two frames `(U₁, f)` of `i₁` and `(U₂, g)` of `i₂` give the frame
  `(U₁ ×_X U₂, (f, g))` of `Y ⟶ X`. The key fact is `V(s ∪ t) = V(s) ×_U V(t)` for sets `s`, `t`
  of global functions on a scheme `U`.

## Main statements

- `AlgebraicGeometry.Scheme.isPullback_zeroLocusSubschemeι_union`: `V(s ∪ t) = V(s) ×_U V(t)`.
- `AlgebraicGeometry.Scheme.Hom.EtaleFrame.inter`: the frame of an intersection.
- `AlgebraicGeometry.Scheme.Hom.exists_etaleFrame_inter`: Zariski frames of an intersection.
- `AlgebraicGeometry.Etale.restrictSupportedClass_fundamentalClass_of_flat`,
  `AlgebraicGeometry.Etale.restrictSupportedClass_fundamentalClass_of_smooth`: base change of the
  fundamental class.
-/

@[expose] public section

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

open Scheme

namespace Scheme

variable {X : Scheme.{u}}

/-- The ideal sheaf generated by a sum of ideals of global sections is the sum of the ideal
sheaves. -/
lemma IdealSheafData.ofIdealTop_sup (I J : Ideal Γ(X, ⊤)) :
    ofIdealTop (I ⊔ J) = ofIdealTop I ⊔ ofIdealTop J := by
  ext U : 2
  simp [IdealSheafData.ideal_sup, Ideal.map_sup]

/-- If `I` contains the kernel of a closed immersion `j`, then `I` is the pushforward of its
pullback along `j`. -/
private lemma IdealSheafData.map_comap_of_ker_le' {U Y : Scheme.{u}} (j : U ⟶ Y)
    [IsClosedImmersion j] (I : Y.IdealSheafData) (hI : j.ker ≤ I) : (I.comap j).map j = I := by
  have hI' : j.ker ≤ I.subschemeι.ker := by rwa [IdealSheafData.ker_subschemeι]
  have hpb : IsPullback (IsClosedImmersion.lift j I.subschemeι hI') (𝟙 _) j I.subschemeι :=
    IsPullback.of_vert_isIso_mono ⟨by simp⟩
  have : IsIso (pullback.snd j I.subschemeι) := by
    rw [← hpb.isoPullback_inv_snd, Category.comp_id]
    infer_instance
  rw [IdealSheafData.map, ← IdealSheafData.comapIso_hom_fst, Category.assoc,
    Scheme.Hom.ker_comp_of_isIso, pullback.condition, Scheme.Hom.ker_comp_of_isIso,
    IdealSheafData.ker_subschemeι]

/-- If `S` generates the ideal generated by `s ∪ t`, then `V(S) ⊆ V(s)`. -/
lemma ofIdealTop_span_le_left {S s t : Set Γ(X, ⊤)}
    (hS : Ideal.span S = Ideal.span s ⊔ Ideal.span t) :
    IdealSheafData.ofIdealTop (Ideal.span s) ≤ .ofIdealTop (Ideal.span S) := by
  rw [hS, IdealSheafData.ofIdealTop_sup]
  exact le_sup_left

/-- If `S` generates the ideal generated by `s ∪ t`, then `V(S) ⊆ V(t)`. -/
lemma ofIdealTop_span_le_right {S s t : Set Γ(X, ⊤)}
    (hS : Ideal.span S = Ideal.span s ⊔ Ideal.span t) :
    IdealSheafData.ofIdealTop (Ideal.span t) ≤ .ofIdealTop (Ideal.span S) := by
  rw [hS, IdealSheafData.ofIdealTop_sup]
  exact le_sup_right

/-- **The zero locus of a union is a fibre product**: if the functions `S` generate the ideal
generated by `s ∪ t`, then `V(S) = V(s) ×_X V(t)`. -/
lemma isPullback_zeroLocusSubschemeι_union {S s t : Set Γ(X, ⊤)}
    (hS : Ideal.span S = Ideal.span s ⊔ Ideal.span t) :
    IsPullback (IdealSheafData.inclusion (ofIdealTop_span_le_left hS))
      (IdealSheafData.inclusion (ofIdealTop_span_le_right hS))
      (X.zeroLocusSubschemeι s) (X.zeroLocusSubschemeι t) := by
  set ιs := X.zeroLocusSubschemeι s
  have : IsClosedImmersion (IdealSheafData.inclusion (ofIdealTop_span_le_left hS) ≫ ιs) := by
    rw [IdealSheafData.inclusion_subschemeι]; infer_instance
  have := IsClosedImmersion.of_comp_isClosedImmersion
    (IdealSheafData.inclusion (ofIdealTop_span_le_left hS)) ιs
  refine isPullback_of_isClosedImmersion _ _ _ _ (by simp [ιs]) ?_
  -- compare the pushforwards along the closed immersion `V(s) ⟶ X`
  have inj : ∀ A B : (X.zeroLocusSubscheme s).IdealSheafData, A.map ιs = B.map ιs → A = B := by
    intro A B h
    rw [← IdealSheafData.comap_map_of_isClosedImmersion ιs A,
      ← IdealSheafData.comap_map_of_isClosedImmersion ιs B, h]
  apply inj
  rw [IdealSheafData.map_ker, IdealSheafData.inclusion_subschemeι, IdealSheafData.ker_subschemeι,
    IdealSheafData.ker_subschemeι]
  have hker : ιs.ker = .ofIdealTop (Ideal.span s) := IdealSheafData.ker_subschemeι _
  calc ((IdealSheafData.ofIdealTop (Ideal.span t)).comap ιs).map ιs
      = ((IdealSheafData.ofIdealTop (Ideal.span t) ⊔ ιs.ker).comap ιs).map ιs := by
        rw [(IdealSheafData.map_gc ιs).l_sup, Scheme.Hom.comap_ker_self, sup_bot_eq]
    _ = IdealSheafData.ofIdealTop (Ideal.span t) ⊔ ιs.ker :=
        IdealSheafData.map_comap_of_ker_le' ιs _ le_sup_right
    _ = IdealSheafData.ofIdealTop (Ideal.span S) := by
        rw [hker, hS, IdealSheafData.ofIdealTop_sup, sup_comm]

end Scheme

/-- Pasting pullback squares: if `A₁ = Y₁ ×_X W`, `A₂ = Y₂ ×_X W`, `P = A₁ ×_W A₂` and
`Y = Y₁ ×_X Y₂`, then `P = Y ×_X W`. -/
lemma _root_.CategoryTheory.IsPullback.of_isPullback_inter {C : Type*} [Category C]
    {P A₁ A₂ W Y Y₁ Y₂ X : C} {p₁ : P ⟶ A₁} {p₂ : P ⟶ A₂} {ι₁ : A₁ ⟶ W} {ι₂ : A₂ ⟶ W}
    {b₁ : A₁ ⟶ Y₁} {b₂ : A₂ ⟶ Y₂} {e : W ⟶ X} {i₁ : Y₁ ⟶ X} {i₂ : Y₂ ⟶ X} {j₁ : Y ⟶ Y₁}
    {j₂ : Y ⟶ Y₂} (hP : IsPullback p₁ p₂ ι₁ ι₂) (h₁ : IsPullback b₁ ι₁ i₁ e)
    (h₂ : IsPullback b₂ ι₂ i₂ e) (hY : IsPullback j₁ j₂ i₁ i₂) :
    IsPullback (hY.lift (p₁ ≫ b₁) (p₂ ≫ b₂) (by simp [h₁.w, h₂.w, reassoc_of% hP.w]))
      (p₂ ≫ ι₂) (j₂ ≫ i₂) e := by
  have outer : IsPullback (p₁ ≫ b₁) p₂ i₁ (b₂ ≫ i₂) := h₂.w ▸ hP.paste_horiz h₁
  have sq : IsPullback (hY.lift (p₁ ≫ b₁) (p₂ ≫ b₂) (by simp [h₁.w, h₂.w, reassoc_of% hP.w]))
      p₂ j₂ b₂ :=
    IsPullback.of_right (by rwa [hY.lift_fst]) (hY.lift_snd _ _ _) hY
  exact sq.paste_vert h₂

namespace Scheme.Hom

variable {X Y Y₁ Y₂ : Scheme.{u}} {c₁ c₂ : ℕ} {i₁ : Y₁ ⟶ X} {i₂ : Y₂ ⟶ X} {i : Y ⟶ X}
  {j₁ : Y ⟶ Y₁} {j₂ : Y ⟶ Y₂}

/-- The ideal generated by the entries of `Fin.append f g` is generated by those of `f` and
`g`. -/
lemma _root_.Ideal.span_range_fin_append {R : Type*} [Semiring R] {m n : ℕ} (f : Fin m → R)
    (g : Fin n → R) :
    Ideal.span (Set.range (Fin.append f g)) = Ideal.span (Set.range f) ⊔ Ideal.span (Set.range g) :=
  by rw [Fin.range_append, Ideal.span_union]

/-- The map `V(a₁^* f, a₂^* g) ⟶ Y₁ ×_X Y₂` for frames `(U₁, f)` of `Y₁ ⟶ X` and `(U₂, g)` of
`Y₂ ⟶ X`, and maps `a₁ : W ⟶ U₁`, `a₂ : W ⟶ U₂` over `X`. -/
noncomputable def EtaleFrame.interToZ (hY : IsPullback j₁ j₂ i₁ i₂) (F₁ : i₁.EtaleFrame c₁)
    (F₂ : i₂.EtaleFrame c₂) {W : Scheme.{u}} (a₁ : W ⟶ F₁.U) (a₂ : W ⟶ F₂.U)
    (h : a₁ ≫ F₁.e = a₂ ≫ F₂.e) :
    W.zeroLocusSubscheme (Set.range (Fin.append (fun t ↦ a₁.appTop (F₁.f t))
      (fun t ↦ a₂.appTop (F₂.f t)))) ⟶ Y :=
  hY.lift
    ((IdealSheafData.inclusion (ofIdealTop_span_le_left (Ideal.span_range_fin_append
        (fun t ↦ a₁.appTop (F₁.f t)) (fun t ↦ a₂.appTop (F₂.f t)))) ≫
      a₁.zeroLocusSubschemeMap (Set.range F₁.f) (Set.range fun t ↦ a₁.appTop (F₁.f t))
        (by rw [← Set.range_comp]; rfl)) ≫ F₁.toZ)
    ((IdealSheafData.inclusion (ofIdealTop_span_le_right (Ideal.span_range_fin_append
        (fun t ↦ a₁.appTop (F₁.f t)) (fun t ↦ a₂.appTop (F₂.f t)))) ≫
      a₂.zeroLocusSubschemeMap (Set.range F₂.f) (Set.range fun t ↦ a₂.appTop (F₂.f t))
        (by rw [← Set.range_comp]; rfl)) ≫ F₂.toZ)
    (by
      simp only [Category.assoc, F₁.isPullback.w, F₂.isPullback.w,
        zeroLocusSubschemeMap_zeroLocusSubschemeι_assoc,
        IdealSheafData.inclusion_subschemeι_assoc, h])

/-- `V(a₁^* f, a₂^* g) = Y ×_X W` for `Y = Y₁ ×_X Y₂`. -/
lemma EtaleFrame.isPullback_interToZ (hY : IsPullback j₁ j₂ i₁ i₂) (hi : j₁ ≫ i₁ = i)
    (F₁ : i₁.EtaleFrame c₁) (F₂ : i₂.EtaleFrame c₂) {W : Scheme.{u}} (a₁ : W ⟶ F₁.U)
    (a₂ : W ⟶ F₂.U) (h : a₁ ≫ F₁.e = a₂ ≫ F₂.e) :
    IsPullback (EtaleFrame.interToZ hY F₁ F₂ a₁ a₂ h)
      (W.zeroLocusSubschemeι (Set.range (Fin.append (fun t ↦ a₁.appTop (F₁.f t))
        (fun t ↦ a₂.appTop (F₂.f t))))) i (a₁ ≫ F₁.e) := by
  have hP := Scheme.isPullback_zeroLocusSubschemeι_union (Ideal.span_range_fin_append
    (fun t ↦ a₁.appTop (F₁.f t)) (fun t ↦ a₂.appTop (F₂.f t)))
  have h₁ := (isPullback_zeroLocusSubschemeι a₁ (Set.range F₁.f)
    (Set.range fun t ↦ a₁.appTop (F₁.f t)) (by rw [← Set.range_comp]; rfl)).paste_horiz
      F₁.isPullback
  have h₂ := (isPullback_zeroLocusSubschemeι a₂ (Set.range F₂.f)
    (Set.range fun t ↦ a₂.appTop (F₂.f t)) (by rw [← Set.range_comp]; rfl)).paste_horiz
      F₂.isPullback
  rw [← h] at h₂
  have := IsPullback.of_isPullback_inter hP h₁ h₂ hY
  rw [IdealSheafData.inclusion_subschemeι, ← hY.w, hi] at this
  exact this

/-- The *frame of an intersection*: for `Y = Y₁ ×_X Y₂ ⟶ X` and frames `(U₁, f)` of `Y₁` and
`(U₂, g)` of `Y₂`, the frame `(U₁ ×_X U₂, (f, g))` of `Y`, since
`V(f, g) = V(f) ×_{U₁ ×_X U₂} V(g)`. -/
noncomputable def EtaleFrame.inter (hY : IsPullback j₁ j₂ i₁ i₂) (hi : j₁ ≫ i₁ = i)
    (F₁ : i₁.EtaleFrame c₁) (F₂ : i₂.EtaleFrame c₂) : i.EtaleFrame (c₁ + c₂) where
  U := pullback F₁.e F₂.e
  e := pullback.fst F₁.e F₂.e ≫ F₁.e
  etale := inferInstance
  f := Fin.append (fun t ↦ (pullback.fst F₁.e F₂.e).appTop (F₁.f t))
    (fun t ↦ (pullback.snd F₁.e F₂.e).appTop (F₂.f t))
  toZ := EtaleFrame.interToZ hY F₁ F₂ _ _ pullback.condition
  isPullback := EtaleFrame.isPullback_interToZ hY hi F₁ F₂ _ _ pullback.condition

lemma EtaleFrame.inter_e (hY : IsPullback j₁ j₂ i₁ i₂) (hi : j₁ ≫ i₁ = i)
    (F₁ : i₁.EtaleFrame c₁) (F₂ : i₂.EtaleFrame c₂) :
    (EtaleFrame.inter hY hi F₁ F₂).e = pullback.fst F₁.e F₂.e ≫ F₁.e := rfl

lemma EtaleFrame.inter_f (hY : IsPullback j₁ j₂ i₁ i₂) (hi : j₁ ≫ i₁ = i)
    (F₁ : i₁.EtaleFrame c₁) (F₂ : i₂.EtaleFrame c₂) :
    (EtaleFrame.inter hY hi F₁ F₂).f = Fin.append
      (fun t ↦ (pullback.fst F₁.e F₂.e).appTop (F₁.f t))
      (fun t ↦ (pullback.snd F₁.e F₂.e).appTop (F₂.f t)) := rfl

/-- A point of `Y = Y₁ ×_X Y₂` lying in the frames `F₁` of `Y₁` and `F₂` of `Y₂` lies in the
frame of the intersection. -/
lemma EtaleFrame.mem_range_inter_toZ (hY : IsPullback j₁ j₂ i₁ i₂) (hi : j₁ ≫ i₁ = i)
    (F₁ : i₁.EtaleFrame c₁) (F₂ : i₂.EtaleFrame c₂) (y : Y) (hy₁ : j₁ y ∈ Set.range F₁.toZ)
    (hy₂ : j₂ y ∈ Set.range F₂.toZ) : y ∈ Set.range (EtaleFrame.inter hY hi F₁ F₂).toZ := by
  obtain ⟨q₁, hq₁⟩ := hy₁
  obtain ⟨q₂, hq₂⟩ := hy₂
  have hx₁ : F₁.e (F₁.U.zeroLocusSubschemeι _ q₁) = i y := by
    rw [← Scheme.Hom.comp_apply, ← F₁.isPullback.w, Scheme.Hom.comp_apply, hq₁, ← hi,
      Scheme.Hom.comp_apply]
  have hx₂ : F₂.e (F₂.U.zeroLocusSubschemeι _ q₂) = i y := by
    rw [← Scheme.Hom.comp_apply, ← F₂.isPullback.w, Scheme.Hom.comp_apply, hq₂, ← hi, hY.w,
      Scheme.Hom.comp_apply]
  obtain ⟨w, hw, -⟩ := (IsPullback.of_hasPullback F₁.e F₂.e).exists_scheme_point _ _
    (hx₁.trans hx₂.symm)
  obtain ⟨q, hq, -⟩ := (EtaleFrame.inter hY hi F₁ F₂).isPullback.exists_scheme_point y w (by
    change i y = (pullback.fst F₁.e F₂.e ≫ F₁.e) w
    rw [Scheme.Hom.comp_apply, hw, hx₁])
  exact ⟨q, hq⟩

/-- **Zariski frames of an intersection.** Let `Y = Y₁ ×_X Y₂ ⟶ X`, and let `F₁`, `F₂` be
frames of `Y₁ ⟶ X` and `Y₂ ⟶ X` by open immersions. Every point `y` of `Y` lying in both frames
lies in a frame `F` of `Y ⟶ X` by an open immersion, whose domain maps to the domains of `F₁` and
`F₂` and whose functions are the pullbacks of those of `F₁` followed by those of `F₂`. -/
theorem exists_etaleFrame_inter (hY : IsPullback j₁ j₂ i₁ i₂) (hi : j₁ ≫ i₁ = i)
    (F₁ : i₁.EtaleFrame c₁) (F₂ : i₂.EtaleFrame c₂) [IsOpenImmersion F₁.e]
    [IsOpenImmersion F₂.e] (y : Y) (hy₁ : j₁ y ∈ Set.range F₁.toZ)
    (hy₂ : j₂ y ∈ Set.range F₂.toZ) :
    ∃ (F : i.EtaleFrame (c₁ + c₂)) (a₁ : F.U ⟶ F₁.U) (a₂ : F.U ⟶ F₂.U),
      IsOpenImmersion F.e ∧ y ∈ Set.range F.toZ ∧ a₁ ≫ F₁.e = F.e ∧ a₂ ≫ F₂.e = F.e ∧
        F.f = Fin.append (fun t ↦ a₁.appTop (F₁.f t)) (fun t ↦ a₂.appTop (F₂.f t)) :=
  ⟨EtaleFrame.inter hY hi F₁ F₂, pullback.fst F₁.e F₂.e, pullback.snd F₁.e F₂.e,
    inferInstanceAs (IsOpenImmersion (pullback.fst F₁.e F₂.e ≫ F₁.e)),
    EtaleFrame.mem_range_inter_toZ hY hi F₁ F₂ y hy₁ hy₂, rfl, pullback.condition.symm, rfl⟩

end Scheme.Hom

namespace Etale

variable (Λ : Type (u + 1)) [CommRing Λ] {X Z : Scheme.{u}} [Finite Λ]

attribute [local instance] HasInvertibleExponent.opens

variable [HasKummerClass Λ] [HasKummerClass.IsNormalized Λ] [HasInvertibleExponent Λ X]
  {k : Type u} [Field k] [PerfectField k] (c : ℕ) (i : Z ⟶ X) [IsRegularImmersion c i]

/-- Blueprint `prop-pur-regular-immersion-purity-compatibilities`: Compatibilities of purity for
regular immersions

**Flat base change of the fundamental class**, `[Z' ⊂ X'] = e^* [Z ⊂ X]`: for a flat
`e : X' ⟶ X` with `X'` smooth over `k` and the base change `i' : Z' ⟶ X'` of `i` with `Z'`
regular, the restriction of supports along `e`
(`AlgebraicGeometry.Etale.restrictSupportedClass`) carries the fundamental class of `i` to that
of `i'`. Near a point of `Z'`, a Zariski frame `(U, f)` of `i` pulls back to the Zariski frame
`(e⁻¹ U, e^* f)` of `i'`, and the product of Kummer boundaries of `f` restricts to that of
`e^* f` (`AlgebraicGeometry.Etale.restrictSupportedClass_kummerBoundaryProduct`). -/
theorem restrictSupportedClass_fundamentalClass_of_flat (aX : X ⟶ Spec (.of k)) [Smooth aX]
    (hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) {X' Z' : Scheme.{u}} (e : X' ⟶ X)
    [Flat e] [Smooth (e ≫ aX)] (i' : Z' ⟶ X') (g : Z' ⟶ Z) (hg : IsPullback g i' i e)
    (hZ' : ∀ z : Z', IsRegularLocalRing (Z'.presheaf.stalk z)) :
    haveI := IsRegularImmersion.of_isPullback c hg
    haveI : HasInvertibleExponent Λ X' := .of_hom e
    restrictSupportedClass Λ e i i' g hg
        (leftDerivedUpperStarConstantComplexIso Λ e).inv (leftDerivedUpperStarTateShiftIso Λ e c)
        (fundamentalClass Λ c i aX hZ) = fundamentalClass Λ c i' (e ≫ aX) hZ' := by
  have := IsRegularImmersion.of_isPullback c hg
  have : HasInvertibleExponent Λ X' := .of_hom e
  refine eq_of_forall_exists_frameRestriction_eq Λ c i' (e ≫ aX) hZ' fun z' ↦ ?_
  obtain ⟨F, hFo, ⟨w₀, hw₀⟩, -, -⟩ := i.exists_etaleFrame_isOpenImmersion c (g z')
  have := hFo
  -- the preimage of the frame `F` in `X'`
  let W : X'.Opens := e ⁻¹ᵁ F.e.opensRange
  have hrange : Set.range (W.ι ≫ e).base ⊆ Set.range F.e.base := by
    rintro _ ⟨y, rfl⟩
    exact y.2
  let a := IsOpenImmersion.lift F.e (W.ι ≫ e) hrange
  have hab : a ≫ F.e = W.ι ≫ e := IsOpenImmersion.lift_fac _ _ _
  let f' : Fin c → Γ(W.toScheme, ⊤) := fun t ↦ a.appTop (F.f t)
  obtain ⟨m, hm⟩ : ∃ m, IsPullback m (W.toScheme.zeroLocusSubschemeι (Set.range f'))
      (F.U.zeroLocusSubschemeι (Set.range F.f)) a :=
    ⟨_, isPullback_zeroLocusSubschemeι a (Set.range F.f) (Set.range f')
      (by rw [← Set.range_comp]; rfl)⟩
  have hout : IsPullback (m ≫ F.toZ) (W.toScheme.zeroLocusSubschemeι (Set.range f')) i
      (W.ι ≫ e) := hab ▸ hm.paste_horiz F.isPullback
  let toZ := hg.lift (m ≫ F.toZ) (W.toScheme.zeroLocusSubschemeι (Set.range f') ≫ W.ι)
    (by rw [hout.w, Category.assoc])
  have hH : IsPullback toZ (W.toScheme.zeroLocusSubschemeι (Set.range f')) i' W.ι :=
    IsPullback.of_right (by rw [IsPullback.lift_fst]; exact hout) (hg.lift_snd _ _ _) hg
  -- the pulled back frame of `i'`
  let H : i'.EtaleFrame c :=
    { U := W.toScheme
      e := W.ι
      etale := inferInstance
      f := f'
      toZ := toZ
      isPullback := hH }
  refine ⟨H, inferInstanceAs (IsOpenImmersion W.ι), ?_, ?_⟩
  · obtain ⟨p, hp⟩ : i' z' ∈ Set.range W.ι.base := by
      rw [Scheme.Opens.range_ι]
      refine ⟨F.U.zeroLocusSubschemeι _ w₀, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← F.isPullback.w, Scheme.Hom.comp_apply, hw₀,
        ← Scheme.Hom.comp_apply, hg.w, Scheme.Hom.comp_apply]
    obtain ⟨q, hq, -⟩ := hH.exists_scheme_point z' p hp.symm
    exact ⟨q, hq⟩
  · rw [frameRestriction_fundamentalClass]
    have hF := frameRestriction_fundamentalClass Λ c i aX hZ F
    rw [frameRestriction] at hF
    rw [frameRestriction, ← restrictSupportedClass_comp_tateShift Λ W.ι e (W.ι ≫ e) rfl i i' _ g
      hg toZ hH (m ≫ F.toZ) hout, restrictSupportedClass_comp_tateShift Λ a F.e (W.ι ≫ e)
      hab.symm i _ _ F.toZ F.isPullback m hm (m ≫ F.toZ) hout, hF]
    exact restrictSupportedClass_kummerBoundaryProduct Λ a F.f f' (fun _ ↦ rfl) m hm

/-- Blueprint `prop-pur-regular-immersion-purity-compatibilities`: Compatibilities of purity for
regular immersions

**Smooth base change of the fundamental class**, `[Z' ⊂ X'] = e^* [Z ⊂ X]` for a smooth
`e : X' ⟶ X` and the base change `i' : Z' ⟶ X'` of `i`
(`AlgebraicGeometry.Etale.restrictSupportedClass_fundamentalClass_of_flat`). The hypotheses on
the base change are derived: `e` is flat, `X'` is smooth over `k`, and `Z'` is smooth over `Z`,
which is smooth over the perfect field `k` (`AlgebraicGeometry.IsRegularImmersion.smooth_comp`),
hence regular. -/
theorem restrictSupportedClass_fundamentalClass_of_smooth (aX : X ⟶ Spec (.of k)) [Smooth aX]
    (hZ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) {X' Z' : Scheme.{u}} (e : X' ⟶ X)
    [Smooth e] (i' : Z' ⟶ X') (g : Z' ⟶ Z) (hg : IsPullback g i' i e) :
    haveI := IsRegularImmersion.of_isPullback c hg
    haveI : HasInvertibleExponent Λ X' := .of_hom e
    restrictSupportedClass Λ e i i' g hg
        (leftDerivedUpperStarConstantComplexIso Λ e).inv (leftDerivedUpperStarTateShiftIso Λ e c)
        (fundamentalClass Λ c i aX hZ) = fundamentalClass Λ c i' (e ≫ aX)
          (haveI := IsRegularImmersion.smooth_comp c i aX hZ
          haveI : Smooth g := MorphismProperty.of_isPullback (P := @Smooth) hg.flip inferInstance
          Smooth.isRegularLocalRing_stalk (g ≫ i ≫ aX)) :=
  restrictSupportedClass_fundamentalClass_of_flat Λ c i aX hZ e i' g hg _

