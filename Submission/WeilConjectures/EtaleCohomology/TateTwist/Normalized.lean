module

public import Submission.WeilConjectures.EtaleCohomology.TateTwist.AffineLine

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# The rank-one normalisation of the Kummer classes

For the Kummer classes of the Tate twist `Λ(1) = μₙ ⊗ Λ` (`AlgebraicGeometry.Etale.hasKummerClass`),
the Kummer boundary `∂κ(t)` of the coordinate `t` of `𝔸¹_B` is the fundamental class of the zero
section: its adjoint `Λ_{V(t)} ⟶ Rs^! (Λ(1)[2])` is an isomorphism
(`AlgebraicGeometry.Etale.isIso_supportedClassMap_kummerBoundary_coord`, blueprint `sk-prop-a1`).
Hence the rank-one datum is normalized (`AlgebraicGeometry.Etale.hasKummerClass_isNormalized`).
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

open Scheme

namespace Etale

variable (Λ : Type (u + 1)) [CommRing Λ] [Finite Λ] [NeZero (ringChar Λ)]

/-- Blueprint `sk-prop-a1`: Rank-one orientation: the fundamental class of the zero section.

For `B` separated and locally of finite type over a field, on which the characteristic `n` of `Λ`
is invertible, let `t` be the coordinate of `𝔸¹_B` and `s : V(t) ⟶ 𝔸¹_B` the zero section. For the
Kummer classes of the Tate twist `μₙ ⊗ Λ`, the adjoint `Λ_{V(t)} ⟶ Rs^! (Λ(1)[2])` of the Kummer
boundary `∂κ(t)` is an isomorphism: `Rs^! (Λ(1)[2])` is concentrated in degree zero and its
cohomology sheaf is the constant sheaf, generated by `∂κ(t)`.

The proof applies `Rp_*` to the localization triangle of the zero section and its open
complement `𝔾_{m,B}`
(`AlgebraicGeometry.Etale.isIso_supportedClassMap_kummerBoundary_coord_of_affineLine`) and uses
the computations of `sk-prop-a1-kummer` for `𝔸¹_B` and `𝔾_{m,B}`. -/
theorem isIso_supportedClassMap_kummerBoundary_coord {k : Type u} [Field k] (B : Scheme.{u})
    (aB : B ⟶ Spec (.of k)) [IsSeparated aB] [LocallyOfFiniteType aB]
    [HasInvertibleExponent Λ B] :
    IsIso (supportedClassMap Λ (𝔸(ULift.{u} (Fin 1); B).zeroLocusSubschemeι
        {AffineSpace.coord B (ULift.up 0)})
      (shiftSupportedClass Λ _ 2
        (kummerBoundary Λ (AffineSpace.coord B (ULift.up 0))))) :=
  isIso_supportedClassMap_kummerBoundary_coord_of_affineLine Λ B
    (isZero_homology_rightDerivedLowerStar_tateObject_affineLine Λ B aB)
    (isIso_homology_zero_map_unit_multiplicativeGroup Λ B aB)
    (isIso_shiftMap_kummerClassAffineLineDirectImage Λ B aB)
    (isZero_homology_rightDerivedLowerStar_tateObject_basicOpen Λ B aB)

/-- The Kummer classes of the Tate twist `μₙ ⊗ Λ` are normalized. -/
instance hasKummerClass_isNormalized : HasKummerClass.IsNormalized Λ where
  isIso_supportedClassMap_kummerBoundary_coord B aB :=
    isIso_supportedClassMap_kummerBoundary_coord Λ B aB

end Etale

end AlgebraicGeometry
