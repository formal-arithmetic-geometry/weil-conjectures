set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Descent of morphisms along the geometric fibre and along Galois coverings

Let `k` be a finite field, `f : X₀ ⟶ Spec k`, `p : X̄ ⟶ X₀` the projection of the geometric
fibre and `Fr` its geometric Galois Frobenius. The Weil objects of the geometric fibre coming from
the model are `p^* M` with the canonical structure `Fr^* p^* M ≅ p^* M`
(`AlgebraicGeometry.ProEtale.CondensedRing.geometricFiberWeil`). This file proves the first
ingredient of Galois descent for them (Deligne, Weil II, 1.3.14), descent of morphisms:

* the pullback of abelian sheaves and of module objects along a quasi-compact surjective weakly
  étale morphism is faithful (`AlgebraicGeometry.ProEtale.faithful_upperStar_ab`,
  `AlgebraicGeometry.ProEtale.CondensedRing.faithful_upperStar`); in particular the projection of
  the geometric fibre is such a morphism (`Scheme.Hom.weaklyEtale_geometricFiberProj`, ...), so
  `geometricFiberWeil` is faithful
  (`AlgebraicGeometry.ProEtale.CondensedRing.faithful_geometricFiberWeil`);
* **descent of morphisms along a Galois covering**: for a quasi-compact surjective weakly étale
  `q : Y ⟶ X` with a Galois action `ρ` over `X` (`AlgebraicGeometry.ProEtale.IsGaloisAction`,
  e.g. a finite étale Galois covering), a morphism `q^* M ⟶ q^* N` commuting with the canonical
  isomorphisms `(ρ i)^* q^* ≅ (ρ i ≫ q)^* = q^*` descends to `M ⟶ N`, for abelian sheaves
  (`AlgebraicGeometry.ProEtale.exists_upperStar_map_eq_of_isGaloisAction`) and for module objects
  over a condensed ring
  (`AlgebraicGeometry.ProEtale.CondensedRing.exists_upperStar_map_eq_of_isGaloisAction`). The
  proof is the sheaf condition along the covering `V ×_X Y ⟶ V` in the form of
  `CategoryTheory.Presheaf.baseChangeDescend`;
* for a cyclic Galois group generated by an endomorphism `g` it suffices that the morphism
  commutes with the structure isomorphism `g^* q^* ≅ q^*`, i.e. that it is a morphism of Weil
  objects, and then the descended morphism is unique
  (`AlgebraicGeometry.ProEtale.CondensedRing.existsUnique_upperStar_map_eq_of_isGaloisAction_pow`).

The covering `p : X̄ ⟶ X₀` itself is a pro-Galois covering with group `Ẑ`, and the powers of
`Fr` are not a Galois action on it in the sense of `IsGaloisAction` (two `k̄`-points of
`Spec (k̄ ⊗_k k̄)` differ by an element of `Ẑ`, not necessarily of `ℤ`); the descent of
`Fr`-invariant morphisms `p^* M ⟶ p^* N` needs finiteness hypotheses on `M` and `N` (so that the
morphism is defined at a finite level `X₀ ⊗ 𝔽_{qⁿ}`, where the results above apply).
-/

@[expose] public section

universe u

open CategoryTheory Limits

open scoped CategoryTheory.Obj

namespace AlgebraicGeometry.ProEtale

variable {X Y : Scheme.{u}} (g : Y ⟶ X) [WeaklyEtale g] [Surjective g] [QuasiCompact g]

/-- The pullback of abelian pro-étale sheaves along a quasi-compact surjective weakly étale
morphism is faithful, its unit being a monomorphism. -/
instance faithful_upperStar_ab : (g)^*[Ab.{u + 1}].Faithful :=
  (upperStarLowerStarAdjunction Ab.{u + 1} g).faithful_L_of_mono_unit_app

namespace CondensedRing

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]

/-- The pullback of module objects over `Λ` along a quasi-compact surjective weakly étale
morphism is faithful. -/
instance faithful_upperStar : (g)^*⟦Λ⟧.Faithful where
  map_injective {M N} φ ψ h := by
    ext : 1
    refine (g)^*[Ab.{u + 1}].map_injective ?_
    have hφ := (upperStarForgetIso Λ g).hom.naturality φ
    have hψ := (upperStarForgetIso Λ g).hom.naturality ψ
    simp only [Functor.comp_map, Mod.forget_map] at hφ hψ
    rw [← cancel_mono ((upperStarForgetIso Λ g).hom.app N), hφ, hψ, h]

end CondensedRing

end AlgebraicGeometry.ProEtale

namespace AlgebraicGeometry.Scheme.Hom

variable {k : Type u} [Field k] [Finite k] {X₀ : Scheme.{u}} (f : X₀ ⟶ Spec (.of k))

/-- The projection `X̄ = X₀ ×_k k̄ ⟶ X₀` is weakly étale: it is the base change of
`Spec k̄ ⟶ Spec k`, and `k̄` is an ind-étale `k`-algebra. -/
instance weaklyEtale_geometricFiberProj : WeaklyEtale f.geometricFiberProj := by
  have : Algebra.IndEtale k (AlgebraicClosure k) :=
    Algebra.IndEtale.of_isSeparable k (AlgebraicClosure k)
  have : WeaklyEtale (Scheme.specAlgebraicClosure k).hom := by
    change WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))
    infer_instance
  rw [Scheme.Hom.geometricFiberProj]
  infer_instance

/-- The projection `X̄ ⟶ X₀` of the geometric fibre is surjective. -/
instance surjective_geometricFiberProj : Surjective f.geometricFiberProj := by
  have : Surjective (Scheme.specAlgebraicClosure k).hom := by
    change Surjective (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))
    exact ⟨fun _ ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩
  rw [Scheme.Hom.geometricFiberProj]
  infer_instance

/-- The projection `X̄ ⟶ X₀` of the geometric fibre is quasi-compact (it is affine). -/
instance quasiCompact_geometricFiberProj : QuasiCompact f.geometricFiberProj := by
  have : QuasiCompact (Scheme.specAlgebraicClosure k).hom := by
    change QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))
    infer_instance
  rw [Scheme.Hom.geometricFiberProj]
  infer_instance

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.ProEtale.CondensedRing

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]
  {k : Type u} [Field k] [Finite k] {X₀ : Scheme.{u}} (f : X₀ ⟶ Spec (.of k))

/-- **Descent of morphisms, injectivity**: the Weil objects `p^* M` of the geometric fibre
coming from the model `X₀` form a faithful functor of `M`. -/
instance faithful_geometricFiberWeil : (geometricFiberWeil Λ f).Faithful :=
  have : (geometricFiberWeil Λ f ⋙ Endofunctor.IsoAlgebra.forget _).Faithful := by
    rw [geometricFiberWeil_comp_forget]
    infer_instance
  Functor.Faithful.of_comp _ (Endofunctor.IsoAlgebra.forget _)

end AlgebraicGeometry.ProEtale.CondensedRing

namespace AlgebraicGeometry.ProEtale

open Scheme

variable {X Y : Scheme.{u}} (q : Y ⟶ X) [WeaklyEtale q]

/-- Let `s` be an endomorphism of `Y` over `X`. If `ψ : j_q^* H ⟶ j_q^* H'` is invariant under
`s` (it commutes with `j_s^* j_q^* ≅ j_{s ≫ q}^* = j_q^*`), then its adjoint
`H ⟶ q_* j_q^* H'`, whose sections over `V` are `H(V) ⟶ H'(V ×_X Y)`, is invariant under the
action of `s` on `V ×_X Y`. -/
lemma homEquiv_comp_baseChangeAction_of_invariant (s : Y ⟶ Y) (hs : s ≫ q = q)
    (hws : WeaklyEtale s) {H H' : Sheaf (ProEt.topology X) Ab.{u + 1}}
    (ψ : (localizationRestriction Ab.{u + 1} q inferInstance).obj H ⟶
      (localizationRestriction Ab.{u + 1} q inferInstance).obj H')
    (hψ : (localizationRestrictionComp Ab.{u + 1} s q hws inferInstance q hs.symm
        inferInstance).hom.app H ≫ (localizationRestriction Ab.{u + 1} s hws).map ψ ≫
        (localizationRestrictionComp Ab.{u + 1} s q hws inferInstance q hs.symm
          inferInstance).inv.app H' = ψ) :
    ((localizationRestrictionLowerStarAdjunction Ab.{u + 1} q inferInstance).homEquiv _ _
        ψ).hom ≫ Presheaf.baseChangeAction (baseChangeAction q s hs) H'.obj =
      ((localizationRestrictionLowerStarAdjunction Ab.{u + 1} q inferInstance).homEquiv _ _
        ψ).hom := by
  refine NatTrans.ext (funext fun V ↦ ?_)
  obtain ⟨V⟩ := V
  let P := (MorphismProperty.Over.pullback @WeaklyEtale ⊤ q).obj V
  let α : (MorphismProperty.Over.map ⊤ hws).obj P ⟶ P :=
    MorphismProperty.Over.homMk ((baseChangeAction q s hs).app V).left
      (baseChangeAction_app_left_snd q s hs V) trivial
  have h₁ : (baseChangeAction q s hs).app V =
      (MorphismProperty.Over.mapComp ⊤ hws (inferInstance : WeaklyEtale q) q
        hs.symm).hom.app P ≫
        (MorphismProperty.Over.map ⊤ (inferInstance : WeaklyEtale q)).map α := by
    refine MorphismProperty.Over.Hom.ext ?_
    simp only [Functor.comp_obj, MorphismProperty.Comma.comp_hom, Comma.comp_left,
      MorphismProperty.Over.mapComp_hom_app_left, MorphismProperty.Over.map_map_left, α]
    exact (Category.id_comp _).symm
  have h₂ : (MorphismProperty.Over.map ⊤ (inferInstance : WeaklyEtale q)).map α ≫
      (baseChangeProj q).app V =
      (MorphismProperty.Over.mapComp ⊤ hws (inferInstance : WeaklyEtale q) q
        hs.symm).inv.app P ≫ (baseChangeProj q).app V := by
    refine MorphismProperty.Over.Hom.ext ?_
    simp only [Functor.id_obj, MorphismProperty.Over.mapPullbackAdj_counit_app,
      MorphismProperty.Comma.comp_hom, MorphismProperty.Over.homMk_hom, Comma.comp_left,
      MorphismProperty.Over.map_map_left, Over.homMk_left, Functor.comp_obj,
      MorphismProperty.Over.mapComp_inv_app_left, α, baseChangeAction_app_left_fst]
    exact (Category.id_comp _).symm
  have hψP := congrArg (fun φ ↦ φ.hom.app (Opposite.op P)) hψ
  simp only [Functor.comp_obj] at hψP
  have hn := ψ.hom.naturality α.op
  have e : (((localizationRestrictionLowerStarAdjunction Ab.{u + 1} q inferInstance).homEquiv
        _ _ ψ).hom.app (Opposite.op V)) =
      H.obj.map ((baseChangeProj q).app V).op ≫ ψ.hom.app (Opposite.op P) := by
    simp [Adjunction.homEquiv_unit]
    rfl
  have h₃ : H.obj.map ((baseChangeProj q).app V).op ≫
      ((localizationRestriction Ab.{u + 1} q inferInstance).obj H).obj.map α.op =
      H.obj.map ((baseChangeProj q).app V).op ≫ H.obj.map
        ((MorphismProperty.Over.mapComp ⊤ hws (inferInstance : WeaklyEtale q) q
          hs.symm).inv.app P).op :=
    calc _ = H.obj.map ((MorphismProperty.Over.map ⊤ (inferInstance : WeaklyEtale q)).map α ≫
          (baseChangeProj q).app V).op := (H.obj.map_comp _ _).symm
      _ = _ := by rw [h₂, op_comp, H.obj.map_comp]
  rw [NatTrans.comp_app, e, Presheaf.baseChangeAction_app, h₁, op_comp, Functor.map_comp,
    Category.assoc]
  erw [← reassoc_of% hn]
  rw [reassoc_of% h₃, ← hψP]
  rfl

/-- An endomorphism `s` of `Y` over `X` is weakly étale when `q : Y ⟶ X` is. -/
lemma weaklyEtale_of_comp_eq_self {s : Y ⟶ Y} (hs : s ≫ q = q) : WeaklyEtale s :=
  have : WeaklyEtale (s ≫ q) := by rw [hs]; infer_instance
  WeaklyEtale.of_comp s q

/-- **Descent of morphisms along a Galois covering, restriction form.** Let `q : Y ⟶ X` be a
quasi-compact surjective weakly étale morphism with a Galois action `ρ` over `X`
(`AlgebraicGeometry.ProEtale.IsGaloisAction`). A morphism `ψ : j_q^* H ⟶ j_q^* H'` of
restrictions of abelian sheaves which is invariant under all `ρ i` comes from a morphism
`H ⟶ H'`. -/
theorem exists_localizationRestriction_map_eq [Surjective q] [QuasiCompact q]
    {Γ : Type u} {ρ : Γ → (Y ⟶ Y)} (hρ : ∀ i, ρ i ≫ q = q) (hgal : IsGaloisAction q ρ)
    {H H' : Sheaf (ProEt.topology X) Ab.{u + 1}}
    (ψ : (localizationRestriction Ab.{u + 1} q inferInstance).obj H ⟶
      (localizationRestriction Ab.{u + 1} q inferInstance).obj H')
    (hψ : ∀ i, (localizationRestrictionComp Ab.{u + 1} (ρ i) q
        (weaklyEtale_of_comp_eq_self q (hρ i)) inferInstance q (hρ i).symm
          inferInstance).hom.app H ≫
        (localizationRestriction Ab.{u + 1} (ρ i) (weaklyEtale_of_comp_eq_self q (hρ i))).map ψ ≫
        (localizationRestrictionComp Ab.{u + 1} (ρ i) q (weaklyEtale_of_comp_eq_self q (hρ i))
          inferInstance q (hρ i).symm inferInstance).inv.app H' = ψ) :
    ∃ φ : H ⟶ H', (localizationRestriction Ab.{u + 1} q inferInstance).map φ = ψ := by
  let adj := localizationRestrictionLowerStarAdjunction Ab.{u + 1} q inferInstance
  obtain ⟨d, hd⟩ : ∃ d : H.obj ⟶ H'.obj,
      d ≫ Presheaf.baseChangeUnit (baseChangeProj q) H'.obj = (adj.homEquiv _ _ ψ).hom :=
    ⟨_, Presheaf.baseChangeDescend_comp (ProEt.topology X)
      (fun i ↦ baseChangeAction q (ρ i) (hρ i)) (generate_singleton_baseChangeProj_mem q)
      (isGalois_baseChangeAction q hρ hgal) (isSheaf_comp_forget H') _
      fun i ↦ homEquiv_comp_baseChangeAction_of_invariant q (ρ i) (hρ i)
        (weaklyEtale_of_comp_eq_self q (hρ i)) ψ (hψ i)⟩
  refine ⟨ObjectProperty.homMk d, (adj.homEquiv _ _).injective ?_⟩
  rw [Adjunction.homEquiv_unit, adj.unit_naturality]
  exact ObjectProperty.hom_ext _ hd

/-- **Descent of morphisms of abelian sheaves along a Galois covering.** Let `q : Y ⟶ X` be a
quasi-compact surjective weakly étale morphism with a Galois action `ρ` over `X`. A morphism
`ψ : q^* H ⟶ q^* H'` of abelian sheaves which commutes with the canonical isomorphisms
`(ρ i)^* q^* ≅ (ρ i ≫ q)^* = q^*` comes from a morphism `H ⟶ H'`. -/
theorem exists_upperStar_map_eq_of_isGaloisAction [Surjective q] [QuasiCompact q]
    {Γ : Type u} {ρ : Γ → (Y ⟶ Y)} (hρ : ∀ i, ρ i ≫ q = q) (hgal : IsGaloisAction q ρ)
    {H H' : Sheaf (ProEt.topology X) Ab.{u + 1}}
    (ψ : (q)^*[Ab.{u + 1}].obj H ⟶ (q)^*[Ab.{u + 1}].obj H')
    (hψ : ∀ i, (ρ i)^*[Ab.{u + 1}].map ψ ≫ (upperStarComp Ab.{u + 1} (ρ i) q).inv.app H' ≫
        (upperStarCongr Ab.{u + 1} (hρ i)).hom.app H' =
      ((upperStarComp Ab.{u + 1} (ρ i) q).inv.app H ≫
        (upperStarCongr Ab.{u + 1} (hρ i)).hom.app H) ≫ ψ) :
    ∃ φ : H ⟶ H', (q)^*[Ab.{u + 1}].map φ = ψ := by
  let e := upperStarIsoLocalizationRestriction Ab.{u + 1} q inferInstance
  have key (i : Γ) : (upperStarComp' Ab.{u + 1} (ρ i) q q (hρ i).symm).hom.app H ≫
      (ρ i)^*[Ab.{u + 1}].map ψ ≫
        (upperStarComp' Ab.{u + 1} (ρ i) q q (hρ i).symm).inv.app H' = ψ := by
    have hc (K : Sheaf (ProEt.topology X) Ab.{u + 1}) :
        (upperStarCongr Ab.{u + 1} (hρ i).symm).inv.app K =
          (upperStarCongr Ab.{u + 1} (hρ i)).hom.app K := rfl
    have hc' (K : Sheaf (ProEt.topology X) Ab.{u + 1}) :
        (upperStarCongr Ab.{u + 1} (hρ i).symm).hom.app K =
          (upperStarCongr Ab.{u + 1} (hρ i)).inv.app K := rfl
    simp only [upperStarComp', Iso.trans_hom, Iso.trans_inv, NatTrans.comp_app,
      Category.assoc, hc, hc']
    rw [hψ i]
    simp
  obtain ⟨φ, hφ⟩ := exists_localizationRestriction_map_eq q hρ hgal
    (e.inv.app H ≫ ψ ≫ e.hom.app H') fun i ↦ by
      rw [← upperStarComp'_conj Ab.{u + 1} (ρ i) q (weaklyEtale_of_comp_eq_self q (hρ i))
        inferInstance q (hρ i).symm inferInstance ψ]
      rw [reassoc_of% (key i)]
  refine ⟨φ, ?_⟩
  rw [← cancel_mono (e.hom.app H'), e.hom.naturality, hφ]
  simp

end AlgebraicGeometry.ProEtale

namespace CategoryTheory.Mod

open MonoidalCategory

open scoped MonoidalLeftAction MonObj

variable {C : Type*} [Category* C] [MonoidalCategory C] {A : C} [MonObj A]

/-- A morphism `d` of underlying objects whose composition with a morphism of module objects `g`
that is a monomorphism of underlying objects is a morphism of module objects `f` is compatible
with the actions. -/
lemma smul_hom_of_comp_eq {M N P : Mod C A} (f : M ⟶ P) (g : N ⟶ P) [Mono g.hom]
    (d : M.X ⟶ N.X) (h : d ≫ g.hom = f.hom) :
    γ[A, M.X] ≫ d = A ⊴ₗ d ≫ γ[A, N.X] := by
  rw [← cancel_mono g.hom, Category.assoc, h, Category.assoc, IsModHom.smul_hom (f := g.hom),
    ← MonoidalLeftAction.actionHomRight_comp_assoc, h]
  exact IsModHom.smul_hom

end CategoryTheory.Mod

namespace AlgebraicGeometry.ProEtale.CondensedRing

open Scheme

variable (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ] [IsCommMonObj Λ]
  {X Y : Scheme.{u}}

/-- The identifications `upperStarForgetIso` are compatible with the transports along equal
morphisms. -/
lemma upperStarCongr_hom_app_upperStarForgetIso {a b : X ⟶ Y} (h : a = b)
    (M : Mod (Sheaf (Scheme.ProEt.topology Y) Ab.{u + 1}) (condensedRingObj Λ Y)) :
    (ProEtale.upperStarCongr Ab.{u + 1} h).hom.app ((Mod.forget _).obj M) ≫
        (upperStarForgetIso Λ b).hom.app M =
      (upperStarForgetIso Λ a).hom.app M ≫ (Mod.forget _).map ((upperStarCongr Λ h).hom.app M) := by
  subst h
  simp only [upperStarCongr, ProEtale.upperStarCongr, eqToIso_refl, Iso.refl_hom,
    NatTrans.id_app, Category.id_comp, CategoryTheory.Functor.map_id]
  exact (Category.comp_id _).symm

/-- For an endomorphism `s` of `Y` over `X`, the identifications `upperStarForgetIso` are
compatible with the canonical isomorphisms `s^* q^* ≅ (s ≫ q)^* = q^*` of abelian sheaves and of
module objects. -/
lemma upperStarComp_inv_upperStarCongr_hom_app_upperStarForgetIso (q : Y ⟶ X) {s : Y ⟶ Y}
    (hs : s ≫ q = q)
    (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)) :
    (ProEtale.upperStarComp Ab.{u + 1} s q).inv.app ((Mod.forget _).obj M) ≫
        (ProEtale.upperStarCongr Ab.{u + 1} hs).hom.app ((Mod.forget _).obj M) ≫
        (upperStarForgetIso Λ q).hom.app M =
      (s)^*[Ab.{u + 1}].map ((upperStarForgetIso Λ q).hom.app M) ≫
        (upperStarForgetIso Λ s).hom.app ((q)^*⟦Λ⟧.obj M) ≫
        (Mod.forget _).map ((upperStarComp Λ s q).inv.app M ≫
          (upperStarCongr Λ hs).hom.app M) := by
  rw [← cancel_epi ((ProEtale.upperStarComp Ab.{u + 1} s q).hom.app ((Mod.forget _).obj M)),
    Iso.hom_inv_id_app_assoc, upperStarCongr_hom_app_upperStarForgetIso,
    reassoc_of% (upperStarComp_hom_app_upperStarForgetIso Λ s q M), ← Functor.map_comp,
    Iso.hom_inv_id_app_assoc]

/-- **Descent of morphisms of module objects along a Galois covering.** Let `q : Y ⟶ X` be a
quasi-compact surjective weakly étale morphism with a Galois action `ρ` over `X`
(`AlgebraicGeometry.ProEtale.IsGaloisAction`), for instance a finite étale Galois covering. A
morphism `ψ : q^* M ⟶ q^* N` of module objects over `Λ` which commutes with the canonical
isomorphisms `(ρ i)^* q^* ≅ (ρ i ≫ q)^* = q^*` comes from a morphism `M ⟶ N`, which is unique
since `q^*` is faithful (`AlgebraicGeometry.ProEtale.CondensedRing.faithful_upperStar`). -/
theorem exists_upperStar_map_eq_of_isGaloisAction (q : Y ⟶ X) [WeaklyEtale q] [Surjective q]
    [QuasiCompact q] {Γ : Type u} {ρ : Γ → (Y ⟶ Y)} (hρ : ∀ i, ρ i ≫ q = q)
    (hgal : IsGaloisAction q ρ)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (ψ : (q)^*⟦Λ⟧.obj M ⟶ (q)^*⟦Λ⟧.obj N)
    (hψ : ∀ i, (ρ i)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ (ρ i) q).inv.app N ≫
        (upperStarCongr Λ (hρ i)).hom.app N =
      ((upperStarComp Λ (ρ i) q).inv.app M ≫ (upperStarCongr Λ (hρ i)).hom.app M) ≫ ψ) :
    ∃ φ : M ⟶ N, (q)^*⟦Λ⟧.map φ = ψ := by
  let F := upperStarForgetIso Λ q
  obtain ⟨φ₀, hφ₀⟩ := ProEtale.exists_upperStar_map_eq_of_isGaloisAction q hρ hgal
    (F.hom.app M ≫ ψ.hom ≫ F.inv.app N) fun i ↦ by
      have hC := upperStarComp_inv_upperStarCongr_hom_app_upperStarForgetIso Λ q (hρ i)
      have hnat := (upperStarForgetIso Λ (ρ i)).hom.naturality ψ
      simp only [Functor.comp_map, Mod.forget_map] at hnat
      have hψ' := congrArg Mod.Hom.hom (hψ i)
      simp only [Mod.comp_hom', Category.assoc] at hψ'
      rw [← cancel_mono (F.hom.app N)]
      simp only [Category.assoc, Iso.inv_hom_id_app, Functor.comp_obj, F]
      rw [hC N, Functor.map_comp_assoc, Functor.map_comp_assoc, ← Functor.map_comp_assoc
        (ρ i)^*[Ab.{u + 1}] ((upperStarForgetIso Λ q).inv.app N), Iso.inv_hom_id_app,
        CategoryTheory.Functor.map_id, Category.id_comp, reassoc_of% hnat]
      rw [reassoc_of% (hC M)]
      simp only [Mod.forget_map, Mod.comp_hom', Category.assoc]
      rw [hψ']
      erw [Category.comp_id]
  let adj := upperStarLowerStarAdjunction Λ q
  have hu : φ₀ ≫ (adj.unit.app N).hom = (adj.homEquiv _ _ ψ).hom := by
    rw [upperStarLowerStarAdjunction_homEquiv_hom, upperStarLowerStarAdjunction_unit_app_hom]
    have hn := (ProEtale.upperStarLowerStarAdjunction Ab.{u + 1} q).unit.naturality φ₀
    simp only [Functor.id_map, Functor.comp_map] at hn
    erw [reassoc_of% hn]
    rw [← Functor.map_comp, hφ₀]
    simp only [F, Category.assoc, ← upperStarForgetIso_hom_app, Iso.inv_hom_id_app]
    rfl
  have : Mono (adj.unit.app N).hom := by
    rw [upperStarLowerStarAdjunction_unit_app_hom]
    infer_instance
  let φ : M ⟶ N := Mod.Hom.mk' φ₀ (Mod.smul_hom_of_comp_eq _ _ φ₀ hu)
  refine ⟨φ, (adj.homEquiv _ _).injective ?_⟩
  rw [Adjunction.homEquiv_unit, adj.unit_naturality]
  ext : 1
  exact hu

/-- The canonical isomorphisms `s^* q^* ≅ (s ≫ q)^* = q^*` for endomorphisms `s` of `Y` over `X`
are multiplicative: that of `s ≫ t` is `s^* t^* q^* ≅ s^* q^* ≅ q^*`. -/
lemma upperStarComp_inv_upperStarCongr_hom_app_comp (q : Y ⟶ X) {s t : Y ⟶ Y}
    (hs : s ≫ q = q) (ht : t ≫ q = q)
    (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)) :
    (upperStarComp Λ (s ≫ t) q).inv.app M ≫
        (upperStarCongr Λ (by rw [Category.assoc, ht, hs] : (s ≫ t) ≫ q = q)).hom.app M =
      (upperStarComp Λ s t).hom.app ((q)^*⟦Λ⟧.obj M) ≫
        (s)^*⟦Λ⟧.map ((upperStarComp Λ t q).inv.app M ≫ (upperStarCongr Λ ht).hom.app M) ≫
        (upperStarComp Λ s q).inv.app M ≫ (upperStarCongr Λ hs).hom.app M := by
  rw [← cancel_epi ((upperStarComp Λ (s ≫ t) q).hom.app M), Iso.hom_inv_id_app_assoc,
    reassoc_of% (upperStarComp_hom_app_comp_upperStarComp_hom_app Λ s t q M),
    ← Functor.map_comp_assoc, Iso.hom_inv_id_app_assoc,
    upperStarComp_hom_app_map_upperStarCongr_hom_app_assoc, Iso.hom_inv_id_app_assoc]
  simp only [upperStarCongr_hom_app_eq_eqToHom, eqToHom_trans]

/-- If `ψ : q^* M ⟶ q^* N` commutes with the canonical isomorphisms `s^* q^* ≅ q^*` and
`t^* q^* ≅ q^*`, it commutes with the canonical isomorphism `(s ≫ t)^* q^* ≅ q^*`. -/
lemma upperStar_map_comp_upperStarComp_inv_of_comp (q : Y ⟶ X) {s t : Y ⟶ Y}
    (hs : s ≫ q = q) (ht : t ≫ q = q)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (ψ : (q)^*⟦Λ⟧.obj M ⟶ (q)^*⟦Λ⟧.obj N)
    (h₁ : (s)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ s q).inv.app N ≫
        (upperStarCongr Λ hs).hom.app N =
      ((upperStarComp Λ s q).inv.app M ≫ (upperStarCongr Λ hs).hom.app M) ≫ ψ)
    (h₂ : (t)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ t q).inv.app N ≫
        (upperStarCongr Λ ht).hom.app N =
      ((upperStarComp Λ t q).inv.app M ≫ (upperStarCongr Λ ht).hom.app M) ≫ ψ) :
    (s ≫ t)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ (s ≫ t) q).inv.app N ≫
        (upperStarCongr Λ (by rw [Category.assoc, ht, hs] : (s ≫ t) ≫ q = q)).hom.app N =
      ((upperStarComp Λ (s ≫ t) q).inv.app M ≫
        (upperStarCongr Λ (by rw [Category.assoc, ht, hs] : (s ≫ t) ≫ q = q)).hom.app M) ≫ ψ := by
  rw [upperStarComp_inv_upperStarCongr_hom_app_comp Λ q hs ht N,
    upperStarComp_inv_upperStarCongr_hom_app_comp Λ q hs ht M,
    reassoc_of% ((upperStarComp Λ s t).hom.naturality ψ)]
  simp only [Category.assoc]
  rw [← Functor.map_comp_assoc, h₂, Functor.map_comp_assoc, h₁]
  simp only [Functor.map_comp, Category.assoc]

/-- The commutation of `ψ : q^* M ⟶ q^* N` with the canonical isomorphism `s^* q^* ≅ q^*` only
depends on the endomorphism `s`. -/
lemma upperStar_map_comp_upperStarComp_inv_of_eq (q : Y ⟶ X) {s s' : Y ⟶ Y} (e : s = s')
    (hs : s ≫ q = q) (hs' : s' ≫ q = q)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (ψ : (q)^*⟦Λ⟧.obj M ⟶ (q)^*⟦Λ⟧.obj N)
    (h : (s)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ s q).inv.app N ≫
        (upperStarCongr Λ hs).hom.app N =
      ((upperStarComp Λ s q).inv.app M ≫ (upperStarCongr Λ hs).hom.app M) ≫ ψ) :
    (s')^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ s' q).inv.app N ≫
        (upperStarCongr Λ hs').hom.app N =
      ((upperStarComp Λ s' q).inv.app M ≫ (upperStarCongr Λ hs').hom.app M) ≫ ψ := by
  subst e
  obtain rfl : hs = hs' := rfl
  exact h

/-- If `ρ` enumerates the positive powers `ρ n = gⁿ⁺¹` of an endomorphism `g` of `Y` over `X`,
all the `ρ n` are endomorphisms over `X`. -/
lemma comp_eq_of_eq_pow (q : Y ⟶ X) {g : Y ⟶ Y} (hg : g ≫ q = q) {ρ : ℕ → (Y ⟶ Y)}
    (hρ₀ : ρ 0 = g) (hρ : ∀ n, ρ (n + 1) = g ≫ ρ n) (n : ℕ) : ρ n ≫ q = q := by
  induction n with
  | zero => rw [hρ₀, hg]
  | succ n ih => rw [hρ, Category.assoc, ih, hg]

/-- If `ψ : q^* M ⟶ q^* N` commutes with the canonical isomorphism `g^* q^* ≅ q^*`, it commutes
with the canonical isomorphisms `(gⁿ⁺¹)^* q^* ≅ q^*` of all the positive powers of `g`. -/
lemma upperStar_map_comp_upperStarComp_inv_of_eq_pow (q : Y ⟶ X) {g : Y ⟶ Y}
    (hg : g ≫ q = q) {ρ : ℕ → (Y ⟶ Y)} (hρ₀ : ρ 0 = g) (hρ : ∀ n, ρ (n + 1) = g ≫ ρ n)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (ψ : (q)^*⟦Λ⟧.obj M ⟶ (q)^*⟦Λ⟧.obj N)
    (hψ : (g)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ g q).inv.app N ≫
        (upperStarCongr Λ hg).hom.app N =
      ((upperStarComp Λ g q).inv.app M ≫ (upperStarCongr Λ hg).hom.app M) ≫ ψ) (n : ℕ) :
    (ρ n)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ (ρ n) q).inv.app N ≫
        (upperStarCongr Λ (comp_eq_of_eq_pow q hg hρ₀ hρ n)).hom.app N =
      ((upperStarComp Λ (ρ n) q).inv.app M ≫
        (upperStarCongr Λ (comp_eq_of_eq_pow q hg hρ₀ hρ n)).hom.app M) ≫ ψ := by
  induction n with
  | zero => exact upperStar_map_comp_upperStarComp_inv_of_eq Λ q hρ₀.symm _ _ ψ hψ
  | succ n ih =>
    exact upperStar_map_comp_upperStarComp_inv_of_eq Λ q (hρ n).symm _ _ ψ
      (upperStar_map_comp_upperStarComp_inv_of_comp Λ q hg _ ψ hψ ih)

/-- **Descent of morphisms along a Galois covering with cyclic group.** Let `q : Y ⟶ X` be a
quasi-compact surjective weakly étale morphism, `g` an endomorphism of `Y` over `X`, and assume
that the positive powers `ρ n = gⁿ⁺¹` of `g` form a Galois action, for instance a finite étale
Galois covering with cyclic group generated by `g`. Then a morphism `ψ : q^* M ⟶ q^* N` which
commutes with the canonical isomorphism `g^* q^* ≅ (g ≫ q)^* = q^*` is `q^* φ` for a unique
`φ : M ⟶ N`. -/
theorem existsUnique_upperStar_map_eq_of_isGaloisAction_pow (q : Y ⟶ X) [WeaklyEtale q]
    [Surjective q] [QuasiCompact q] {g : Y ⟶ Y} (hg : g ≫ q = q) {ρ : ℕ → (Y ⟶ Y)}
    (hρ₀ : ρ 0 = g) (hρ : ∀ n, ρ (n + 1) = g ≫ ρ n)
    (hgal : IsGaloisAction q fun n : ULift.{u} ℕ ↦ ρ n.down)
    {M N : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)}
    (ψ : (q)^*⟦Λ⟧.obj M ⟶ (q)^*⟦Λ⟧.obj N)
    (hψ : (g)^*⟦Λ⟧.map ψ ≫ (upperStarComp Λ g q).inv.app N ≫
        (upperStarCongr Λ hg).hom.app N =
      ((upperStarComp Λ g q).inv.app M ≫ (upperStarCongr Λ hg).hom.app M) ≫ ψ) :
    ∃! φ : M ⟶ N, (q)^*⟦Λ⟧.map φ = ψ := by
  generalize eρ : (fun n : ULift.{u} ℕ ↦ ρ n.down) = ρ' at hgal
  have hρ' (n : ULift.{u} ℕ) : ρ' n ≫ q = q := by
    subst eρ
    exact comp_eq_of_eq_pow q hg hρ₀ hρ n.down
  have e (n : ULift.{u} ℕ) : ρ n.down = ρ' n := by rw [← eρ]
  obtain ⟨φ, hφ⟩ := exists_upperStar_map_eq_of_isGaloisAction Λ q hρ' hgal ψ fun n ↦
    upperStar_map_comp_upperStarComp_inv_of_eq Λ q (e n) _ _ ψ
      (upperStar_map_comp_upperStarComp_inv_of_eq_pow Λ q hg hρ₀ hρ ψ hψ n.down)
  exact ⟨φ, hφ, fun φ' h ↦ (q)^*⟦Λ⟧.map_injective (h.trans hφ.symm)⟩

end AlgebraicGeometry.ProEtale.CondensedRing
