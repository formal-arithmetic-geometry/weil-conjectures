module

public import Mathlib.FieldTheory.KummerExtension
public import Mathlib.RingTheory.Trace.Basic

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Generators of Galois extensions of prime degree

Let `M/L` be a Galois extension of prime degree `p`.

* `IsGalois.exists_not_mem_range_pow_sub_self_mem_range`: if `L` has characteristic `p`, then
  `M` contains an element `θ ∉ L` with `θ ^ p - θ ∈ L` (Artin–Schreier generator). The proof is
  additive Hilbert 90: for a generator `σ` of `Gal(M/L)`, the image of `σ - 1` is the kernel of
  the trace, which contains `1`.
* `IsGalois.exists_not_mem_range_pow_mem_range`: if `L` contains a primitive `p`-th root of
  unity, then `M` contains an element `θ ∉ L` with `θ ^ p ∈ L` (Kummer generator).
-/

@[expose] public section

open Module Polynomial IntermediateField

namespace IsGalois

variable {L M : Type*} [Field L] [Field M] [Algebra L M]

/-- In a finite Galois extension with cyclic Galois group generated by `σ`, an element fixed by
`σ` lies in the base field. -/
theorem mem_range_algebraMap_of_apply_eq [FiniteDimensional L M] [IsGalois L M]
    {σ : Gal(M/L)} (hσ : ∀ g, g ∈ Subgroup.zpowers σ) {x : M} (hx : σ x = x) :
    x ∈ Set.range (algebraMap L M) := by
  rw [mem_range_algebraMap_iff_fixed]
  intro g
  exact (Subgroup.zpowers_le (H := MulAction.stabilizer Gal(M/L) x)).2 hx (hσ g)

/-- **Artin–Schreier generator.** If `L` has characteristic `p` and `M/L` is Galois of degree
`p`, then there is `θ ∈ M \ L` with `θ ^ p - θ ∈ L`. -/
theorem exists_not_mem_range_pow_sub_self_mem_range (p : ℕ) [hp : Fact p.Prime] [CharP L p]
    [IsGalois L M] (hM : finrank L M = p) :
    ∃ θ : M, θ ∉ Set.range (algebraMap L M) ∧ θ ^ p - θ ∈ Set.range (algebraMap L M) := by
  have : FiniteDimensional L M := Module.finite_of_finrank_pos (hM ▸ hp.out.pos)
  have : CharP M p := charP_of_injective_algebraMap (algebraMap L M).injective p
  have : IsCyclic Gal(M/L) := isCyclic_of_prime_card (p := p) (by
    rw [IsGalois.card_aut_eq_finrank, hM])
  obtain ⟨σ, hσ⟩ := IsCyclic.exists_generator (α := Gal(M/L))
  let f : M →ₗ[L] M := σ.toLinearMap - LinearMap.id
  have hker : LinearMap.ker f = LinearMap.range (Algebra.linearMap L M) := by
    ext x
    simp only [LinearMap.mem_ker, LinearMap.sub_apply, AlgEquiv.toLinearMap_apply,
      LinearMap.id_apply, sub_eq_zero, LinearMap.mem_range, Algebra.linearMap_apply, f]
    refine ⟨mem_range_algebraMap_of_apply_eq hσ, ?_⟩
    rintro ⟨y, rfl⟩
    exact σ.commutes y
  have hrange : LinearMap.range f = LinearMap.ker (Algebra.trace L M) := by
    apply Submodule.eq_of_le_of_finrank_eq
    · rintro _ ⟨x, rfl⟩
      simp [f, Algebra.trace_eq_of_algEquiv]
    · have h1 := LinearMap.finrank_range_add_finrank_ker f
      have h2 := LinearMap.finrank_range_add_finrank_ker (Algebra.trace L M)
      rw [hker, LinearMap.finrank_range_of_inj (f := Algebra.linearMap L M)
        (algebraMap L M).injective, finrank_self] at h1
      rw [LinearMap.range_eq_top.2 (Algebra.trace_surjective L M), finrank_top,
        finrank_self] at h2
      omega
  obtain ⟨θ, hθ⟩ : (1 : M) ∈ LinearMap.range f := by
    rw [hrange, LinearMap.mem_ker, ← map_one (algebraMap L M), Algebra.trace_algebraMap, hM]
    simp
  have hσθ : σ θ = θ + 1 := by
    rw [← hθ]
    simp [f]
  refine ⟨θ, ?_, mem_range_algebraMap_of_apply_eq hσ ?_⟩
  · rintro ⟨a, rfl⟩
    simp at hσθ
  · rw [map_sub, map_pow, hσθ, add_pow_char, one_pow]
    ring

/-- **Kummer generator.** If `L` contains a primitive `p`-th root of unity and `M/L` is Galois of
prime degree `p`, then there is `θ ∈ M \ L` with `θ ^ p ∈ L`. -/
theorem exists_not_mem_range_pow_mem_range (p : ℕ) [hp : Fact p.Prime]
    (hζ : (primitiveRoots p L).Nonempty) [IsGalois L M] (hM : finrank L M = p) :
    ∃ θ : M, θ ∉ Set.range (algebraMap L M) ∧ θ ^ p ∈ Set.range (algebraMap L M) := by
  have : FiniteDimensional L M := Module.finite_of_finrank_pos (hM ▸ hp.out.pos)
  have : IsCyclic Gal(M/L) := isCyclic_of_prime_card (p := p) (by
    rw [IsGalois.card_aut_eq_finrank, hM])
  obtain ⟨θ, hθp, hθ⟩ := exists_root_adjoin_eq_top_of_isCyclic L M (hM ▸ hζ)
  refine ⟨θ, ?_, hM ▸ hθp⟩
  rintro ⟨a, rfl⟩
  rw [adjoin_simple_eq_bot_iff.2 (IntermediateField.algebraMap_mem _ a),
    bot_eq_top_iff_finrank_eq_one, hM] at hθ
  exact hp.out.one_lt.ne' hθ

end IsGalois
