module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.Algebra.Algebra.ZMod
import Mathlib.Algebra.CharP.Algebra
import Mathlib.Algebra.CharP.Lemmas

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Differential independence excludes the last root from the preceding field

Source: Stacks Project, Algebra, Tag 07DZ, the displayed Frobenius computation.
(blueprint: lem-weil-pbc-pth-root-not-mem-previous-adjoin).
-/

@[expose] public section

universe u v

namespace IntermediateField

attribute [local instance] ZMod.algebra

/-- The final root cannot belong to the field generated by the preceding roots.
Source: Stacks Project, Algebra, Tag 07DZ, proof of Lemma 10.158.3.
(blueprint: lem-weil-pbc-pth-root-not-mem-previous-adjoin).

Proof: Let L be the field generated by the first n roots. The k-span R of their
bounded monomials contains 1 and each generator (p is prime, hence p > 1).
It is closed under multiplication: reduce every exponent modulo p, absorbing
alpha_i^p = a_i into the k-coefficient. Thus R is a finite-dimensional k-algebra
and a domain inside Omega. Multiplication by a nonzero element is injective on
R, hence surjective by finite dimensionality, and therefore R is a field.
Minimality of L gives L = R. No linear independence of these monomials is used.
If the last root belongs to L, express it as a finite k-linear combination of
these monomials. Taking p-th powers yields a_last = sum_E lambda_E^p a^E;
Frobenius is additive, and injectivity of k -> Omega makes this an equality in k.
Apply the universal derivation over ZMod p. It kills lambda_E^p by the Leibniz
rule and characteristic p. Differentiating each a^E expresses d(a_last) as a
k-linear combination of the preceding d(a_i). The coefficient of d(a_last) in
the resulting relation is 1, contradicting the assumed linear independence.
For n = 0, R = k and this says directly that d(beta^p) = 0. -/
theorem pth_root_not_mem_previous_adjoin
    (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p]
    (Ω : Type v) [Field Ω] [Algebra k Ω]
    (n : ℕ) (a : Fin (n + 1) → k)
    (hind : LinearIndependent k
      (fun i : Fin (n + 1) ↦ KaehlerDifferential.D (ZMod p) k (a i)))
    (α : Fin (n + 1) → Ω)
    (hα : ∀ i : Fin (n + 1), α i ^ p = algebraMap k Ω (a i)) :
    α (Fin.last n) ∉ adjoin k (Set.range (fun i : Fin n ↦ α i.castSucc)) := by
  have : CharP Ω p := charP_of_injective_algebraMap (algebraMap k Ω).injective p
  let D := KaehlerDifferential.D (ZMod p) k
  let S := Submodule.span k (Set.range (fun i : Fin n ↦ D (a i.castSucc)))
  -- The universal derivation kills all p-th powers in the base field.
  have hp : ∀ c : k, D (c ^ p) = 0 := by
    intro c
    rw [D.leibniz_pow, ← Nat.cast_smul_eq_nsmul k, CharP.cast_eq_zero, zero_smul]
  -- Keep the power and its differential together through field-adjoin induction.
  have hspan : ∀ x ∈ adjoin k (Set.range (fun i : Fin n ↦ α i.castSucc)),
      ∃ b : k, x ^ p = algebraMap k Ω b ∧ D b ∈ S := by
    intro x hx
    induction hx using adjoin_induction with
    | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact ⟨a i.castSucc, hα i.castSucc, Submodule.subset_span ⟨i, rfl⟩⟩
    | algebraMap c =>
        exact ⟨c ^ p, (map_pow (algebraMap k Ω) c p).symm, by rw [hp]; exact S.zero_mem⟩
    | add x y hx hy ihx ihy =>
        obtain ⟨b, hb, hdb⟩ := ihx
        obtain ⟨c, hc, hdc⟩ := ihy
        refine ⟨b + c, ?_, ?_⟩
        · rw [add_pow_char, hb, hc, map_add]
        · rw [map_add]
          exact S.add_mem hdb hdc
    | inv x hx ih =>
        obtain ⟨b, hb, hdb⟩ := ih
        refine ⟨b⁻¹, ?_, ?_⟩
        · rw [inv_pow, hb, map_inv₀]
        · rw [Derivation.leibniz_inv]
          exact S.smul_mem _ hdb
    | mul x y hx hy ihx ihy =>
        obtain ⟨b, hb, hdb⟩ := ihx
        obtain ⟨c, hc, hdc⟩ := ihy
        refine ⟨b * c, ?_, ?_⟩
        · rw [mul_pow, hb, hc, map_mul]
        · rw [Derivation.leibniz]
          exact S.add_mem (S.smul_mem _ hdc) (S.smul_mem _ hdb)
  intro hmem
  obtain ⟨b, hb, hdb⟩ := hspan _ hmem
  have hab : a (Fin.last n) = b := (algebraMap k Ω).injective ((hα _).symm.trans hb)
  apply hind.notMem_span (Fin.last n)
  apply (Submodule.span_mono (show Set.range (fun i : Fin n ↦ D (a i.castSucc)) ⊆
      (fun i : Fin (n + 1) ↦ D (a i)) '' {Fin.last n}ᶜ from ?_))
  · simpa only [hab] using hdb
  · rintro _ ⟨i, rfl⟩
    exact ⟨i.castSucc, by simp, rfl⟩

end IntermediateField
