/-!
# Linear disjointness from the perfect closure and `p`-th roots of a transcendental

Let `k ⊆ F ⊆ E` be fields.

* `LinearIndependent.algebraMap_perfectClosure`: if `F ⊗_k k^{perf}` is reduced, where
  `k^{perf}` is the perfect closure of `k` in `E` (e.g. if `F / k` is separably generated), then
  every `k`-linearly independent family of `F` stays linearly independent over `k^{perf}` in `E`.
* `Algebra.isSeparablyGenerated_of_transcendental` and
  `LinearIndependent.algebraMap_perfectClosure_of_transcendental`: the same when `F` is separable
  algebraic over `k(x)` for some `x` transcendental over `k`.
* `sum_mul_pow_ne_algebraMap`: if `x ∈ F` is transcendental over `k` and `F` is separable
  algebraic over `k(x)`, then (in characteristic `p`) `x` is not the `p`-th power of an element
  of the ring generated by `k^{perf}` and `F` in `E`.
-/

@[expose] public section

open scoped TensorProduct IntermediateField

open Polynomial IntermediateField

/-- Separability transported along a ring map `f : F → K` compatible with a map `C → M` of base
fields. -/
lemma IsSeparable.of_ringHom_comp {C M F K : Type*} [Field C] [Field M] [Field F] [Field K]
    [Algebra C F] [Algebra M K] (f : F →+* K) (h : C →+* M)
    (hcomm : (algebraMap M K).comp h = f.comp (algebraMap C F)) {y : F}
    (hy : IsSeparable C y) : IsSeparable M (f y) := by
  refine (Polynomial.Separable.map (f := h) hy).of_dvd (minpoly.dvd M (f y) ?_)
  rw [aeval_def, eval₂_map, hcomm, ← hom_eval₂, ← aeval_def, minpoly.aeval, map_zero]

/-- Separability pulled back along a field map `f : F → K` compatible with a map `C → M` of base
fields. -/
lemma IsSeparable.of_ringHom_comp_apply {C M F K : Type*} [Field C] [Field M] [Field F] [Field K]
    [Algebra C K] [Algebra M F] (f : F →+* K) (h : C →+* M)
    (hcomm : f.comp ((algebraMap M F).comp h) = algebraMap C K) {y : F}
    (hy : IsSeparable C (f y)) : IsSeparable M y := by
  refine (Polynomial.Separable.map (f := h) hy).of_dvd (minpoly.dvd M y (f.injective ?_))
  rw [map_zero, aeval_def, eval₂_map, hom_eval₂, hcomm, ← aeval_def, minpoly.aeval]

/-- `X` is not a proper power in `K(X)`. -/
lemma RatFunc.pow_ne_X {K : Type*} [Field K] {n : ℕ} (hn : 2 ≤ n) (r : RatFunc K) :
    r ^ n ≠ RatFunc.X := by
  intro h
  have hr : r ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at h
    exact RatFunc.X_ne_zero h.symm
  have key (m : ℕ) : (r ^ m).intDegree = m * r.intDegree := by
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, RatFunc.intDegree_mul (pow_ne_zero _ hr) hr, ih]
      push_cast
      ring
  have h1 := key n
  rw [h, RatFunc.intDegree_X] at h1
  have := Int.eq_one_of_mul_eq_one_right (by positivity) h1.symm
  omega

variable {k F E : Type*} [Field k] [Field F] [Field E] [Algebra k F] [Algebra k E] [Algebra F E]
  [IsScalarTower k F E]

/-- **Linear disjointness from the perfect closure.** If `F ⊗_k k^{perf}` is reduced, `k^{perf}`
the perfect closure of `k` in `E`, then a `k`-linearly independent family of `F` is linearly
independent over `k^{perf}` in `E`. -/
theorem LinearIndependent.algebraMap_perfectClosure
    [IsReduced (F ⊗[k] perfectClosure k E)] {ι : Type*} {e : ι → F}
    (he : LinearIndependent k e) :
    LinearIndependent (perfectClosure k E) (algebraMap F E ∘ e) := by
  classical
  obtain ⟨q, _⟩ := ExpChar.exists k
  rw [linearIndependent_iff]
  intro l hl
  let μ : F ⊗[k] perfectClosure k E →ₐ[k] E := Algebra.TensorProduct.productMap
    (IsScalarTower.toAlgHom k F E) (IsScalarTower.toAlgHom k (perfectClosure k E) E)
  let t : F ⊗[k] perfectClosure k E := l.sum fun i c ↦ e i ⊗ₜ c
  have hμt : μ t = 0 := by
    rw [← hl, Finsupp.linearCombination_apply]
    simp only [t, Finsupp.sum, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    simp [Algebra.smul_def, mul_comm]
  obtain ⟨n, f, hf⟩ := IsPurelyInseparable.exists_pow_pow_mem_range_tensorProduct_of_expChar q t
  have hf0 : f = 0 := by
    apply (algebraMap F E).injective
    have hμ : μ (t ^ q ^ n) = μ t ^ q ^ n := μ.toRingHom.map_pow t _
    have := congrArg μ hf
    rw [hμ, hμt, zero_pow (expChar_pow_pos k q n).ne'] at this
    rw [map_zero, ← this, Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.productMap_apply_tmul]
    simp
  have ht : t = 0 := IsNilpotent.eq_zero ⟨q ^ n, by rw [← hf, hf0, map_zero]⟩
  have ht' : Finsupp.linearCombination (perfectClosure k E)
      (fun i ↦ (1 : perfectClosure k E) ⊗ₜ[k] e i) l = 0 := by
    have := congrArg (Algebra.TensorProduct.comm k F (perfectClosure k E)) ht
    rw [map_zero] at this
    rw [← this, Finsupp.linearCombination_apply]
    simp only [t, Finsupp.sum, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Algebra.TensorProduct.comm_tmul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have hli := Module.Flat.linearIndependent_one_tmul (S := perfectClosure k E) (M := F) he
  exact linearIndependent_iff.1 hli l ht'

/-- **A transcendental is not a `p`-th power after a separable extension.** Let `x ∈ F` be
transcendental over `k`, with `F` separable algebraic over `k(x)`, and `E ⊇ F` of characteristic
`p`. Then `x` is not the `p`-th power of an element `∑ cᵢ eᵢ` with `cᵢ` in the perfect closure of
`k` in `E` and `eᵢ ∈ F`: such an element is separable over `k^{perf}(x)`, so it would lie in
`k^{perf}(x) ≅ k^{perf}(X)`, where `X` is not a `p`-th power. -/
theorem sum_mul_pow_ne_algebraMap (p : ℕ) [Fact p.Prime] [CharP E p] {x : F}
    (hx : Transcendental k x) (hsep : ∀ y : F, IsSeparable k⟮x⟯ y) {ι : Type*} (s : Finset ι)
    (c : ι → E) (hc : ∀ i, c i ∈ perfectClosure k E) (e : ι → F) :
    (∑ i ∈ s, c i * algebraMap F E (e i)) ^ p ≠ algebraMap F E x := by
  intro hpow
  have hξk : Transcendental k (algebraMap F E x) :=
    (isAlgebraic_algHom_iff (IsScalarTower.toAlgHom k F E) (algebraMap F E).injective).not.2 hx
  have hξ : Transcendental (perfectClosure k E) (algebraMap F E x) :=
    (Algebra.IsAlgebraic.transcendental_iff k (perfectClosure k E)).1 hξk
  let B := (perfectClosure k E)⟮algebraMap F E x⟯
  have : ExpChar B p := (algebraMap B E).expChar (algebraMap B E).injective p
  have hmem (w : k⟮x⟯) : algebraMap F E w ∈ B := by
    have hle : k⟮x⟯ ≤ (B.restrictScalars k).comap (IsScalarTower.toAlgHom k F E) :=
      adjoin_simple_le_iff.2 (mem_adjoin_simple_self _ _)
    exact hle w.2
  let j : k⟮x⟯ →+* B := ((algebraMap F E).comp (algebraMap k⟮x⟯ F)).codRestrict B hmem
  have hsepE (y : F) : IsSeparable B (algebraMap F E y) :=
    IsSeparable.of_ringHom_comp (algebraMap F E) j (RingHom.ext fun _ ↦ rfl) (hsep y)
  have hy : ∑ i ∈ s, c i * algebraMap F E (e i) ∈ separableClosure B E := by
    refine sum_mem fun i _ ↦ mul_mem ?_ (mem_separableClosure_iff.2 (hsepE _))
    have hcB : c i ∈ B := IntermediateField.algebraMap_mem B (⟨c i, hc i⟩ : perfectClosure k E)
    exact mem_separableClosure_iff.2 (isSeparable_algebraMap (⟨c i, hcB⟩ : B))
  have hy' : ∑ i ∈ s, c i * algebraMap F E (e i) ∈ perfectClosure B E :=
    (mem_perfectClosure_iff_pow_mem p).2
      ⟨1, by
        rw [pow_one, hpow]
        exact ⟨AdjoinSimple.gen _ _, rfl⟩⟩
  have hbot : ∑ i ∈ s, c i * algebraMap F E (e i) ∈ (⊥ : IntermediateField B E) := by
    rw [← separableClosure_inf_perfectClosure B E]
    exact ⟨hy, hy'⟩
  obtain ⟨b, hb⟩ := IntermediateField.mem_bot.1 hbot
  have hbp : b ^ p = AdjoinSimple.gen (perfectClosure k E) (algebraMap F E x) :=
    (algebraMap B E).injective (by
      rw [map_pow, hb, hpow]
      rfl)
  apply RatFunc.pow_ne_X (Fact.out : p.Prime).two_le
    ((RatFunc.algEquivOfTranscendental _ hξ).symm b)
  rw [← map_pow, hbp, RatFunc.algEquivOfTranscendental_symm_gen]

/-- A field `F` which is separable algebraic over `k(x)`, with `x` transcendental over `k`, is
separably generated over `k`, with separating transcendence basis `{x}`. -/
theorem Algebra.isSeparablyGenerated_of_transcendental {x : F} (hx : Transcendental k x)
    (hsep : ∀ y : F, IsSeparable k⟮x⟯ y) :
    Algebra.IsSeparablyGenerated k F := by
  have : Algebra.IsSeparable k⟮x⟯ F := ⟨hsep⟩
  refine ⟨{x}, ?_, this⟩
  have hind : AlgebraicIndependent k ((↑) : ({x} : Set F) → F) :=
    algebraicIndependent_unique_type_iff.2 (by simpa using hx)
  rw [hind.isTranscendenceBasis_iff_isAlgebraic, Subtype.range_coe]
  let S := Algebra.adjoin k ({x} : Set F)
  let : Algebra S k⟮x⟯ :=
    (Subalgebra.inclusion (IntermediateField.algebra_adjoin_le_adjoin k _)).toRingHom.toAlgebra
  have : IsScalarTower S k⟮x⟯ F := IsScalarTower.of_algebraMap_eq (congrFun rfl)
  have : Algebra.IsAlgebraic S k⟮x⟯ := by
    refine ⟨fun y ↦ ?_⟩
    obtain ⟨P, Q, hy⟩ := (mem_adjoin_simple_iff k _).1 y.2
    by_cases hQ : aeval x Q = 0
    · rw [hQ, div_zero] at hy
      obtain rfl : y = 0 := Subtype.ext hy
      exact isAlgebraic_zero
    let p : S := ⟨aeval x P, aeval_mem_adjoin_singleton k x⟩
    let q : S := ⟨aeval x Q, aeval_mem_adjoin_singleton k x⟩
    have hq : q ≠ 0 := fun h ↦ hQ (congrArg Subtype.val h)
    refine ⟨C q * X - C p, fun h ↦ hq ?_, ?_⟩
    · simpa using congrArg (coeff · 1) h
    · apply (algebraMap k⟮x⟯ F).injective
      simp only [map_sub, map_mul, aeval_C, aeval_X, map_zero, ← IsScalarTower.algebraMap_apply,
        IntermediateField.algebraMap_apply, Subalgebra.algebraMap_eq, hy, p, q]
      field_simp
      simp [mul_comm]
  exact Algebra.IsAlgebraic.trans S k⟮x⟯ F

/-- **Linear disjointness from the perfect closure, transcendence degree one.** If `x ∈ F` is
transcendental over `k` and `F` is separable algebraic over `k(x)`, then a `k`-linearly
independent family of `F` is linearly independent over the perfect closure of `k` in `E`. -/
theorem LinearIndependent.algebraMap_perfectClosure_of_transcendental {x : F}
    (hx : Transcendental k x) (hsep : ∀ y : F, IsSeparable k⟮x⟯ y) {ι : Type*} {e : ι → F}
    (he : LinearIndependent k e) :
    LinearIndependent (perfectClosure k E) (algebraMap F E ∘ e) :=
  have := Algebra.isReduced_tensorProduct_of_isSeparablyGenerated k F (perfectClosure k E)
    (Algebra.isSeparablyGenerated_of_transcendental hx hsep)
  he.algebraMap_perfectClosure
