/-! # Localization at a regular principal prime -/

@[expose] public section

namespace IsLocalization

private theorem factor_of_bound {C : Type*} [CommRing C] [IsLocalRing C]
    (x : C) (hm : IsLocalRing.maximalIdeal C = Ideal.span {x}) (N : ℕ) :
    ∀ b : C, b ∉ IsLocalRing.maximalIdeal C ^ N →
      ∃ n : ℕ, ∃ u : C, IsUnit u ∧ b = x ^ n * u := by
  induction N with
  | zero => simp
  | succ N ih =>
    intro b hb
    by_cases hu : IsUnit b
    · exact ⟨0, b, hu, by simp⟩
    have hbmem : b ∈ IsLocalRing.maximalIdeal C := by
      simpa [IsLocalRing.mem_maximalIdeal] using hu
    rw [hm, Ideal.mem_span_singleton] at hbmem
    obtain ⟨c, hc⟩ := hbmem
    have hcnot : c ∉ IsLocalRing.maximalIdeal C ^ N := by
      intro hcN
      apply hb
      rw [hc, pow_succ']
      exact Ideal.mul_mem_mul (by rw [hm]; exact Ideal.subset_span (by simp)) hcN
    obtain ⟨n, u, hu, hcu⟩ := ih c hcnot
    refine ⟨n + 1, u, hu, ?_⟩
    rw [hc, hcu, pow_succ']
    ring

private theorem factor_nonzero {C : Type*} [CommRing C] [IsLocalRing C]
    [IsNoetherianRing C] (x : C)
    (hm : IsLocalRing.maximalIdeal C = Ideal.span {x}) (b : C) (hb : b ≠ 0) :
    ∃ n : ℕ, ∃ u : C, IsUnit u ∧ b = x ^ n * u := by
  have hex : ∃ N : ℕ, b ∉ IsLocalRing.maximalIdeal C ^ N := by
    by_contra! h
    apply hb
    have hmem : b ∈ ⨅ N : ℕ, IsLocalRing.maximalIdeal C ^ N :=
      by simpa only [Submodule.mem_iInf] using h
    rwa [Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal C)
      (Ideal.IsMaximal.ne_top inferInstance), Submodule.mem_bot] at hmem
  obtain ⟨N, hN⟩ := hex
  exact factor_of_bound x hm N b hN

private theorem dvr_of_regular_maximal_generator {C : Type*} [CommRing C]
    [IsLocalRing C] [IsNoetherianRing C] (x : C) (hreg : IsLeftRegular x)
    (hm : IsLocalRing.maximalIdeal C = Ideal.span {x}) :
    ∃ (_ : IsDomain C), IsDiscreteValuationRing C := by
  have : NoZeroDivisors C := by
    constructor
    intro b c hbc
    by_cases hb : b = 0
    · exact Or.inl hb
    obtain ⟨n, u, hu, hbu⟩ := factor_nonzero x hm b hb
    right
    have hzero : x ^ n * (u * c) = x ^ n * 0 := by
      rw [← mul_assoc, ← hbu, hbc, mul_zero]
    exact hu.mul_right_eq_zero.mp ((hreg.pow n) hzero)
  let : IsDomain C := (isDomain_iff_noZeroDivisors_and_nontrivial C).mpr
    ⟨inferInstance, inferInstance⟩
  refine ⟨inferInstance, ?_⟩
  have hx : x ≠ 0 := by
    intro h
    have : (1 : C) = 0 := hreg (by simp [h])
    exact one_ne_zero this
  apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
  refine ⟨x, IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal x hx hm, ?_⟩
  intro b hb
  obtain ⟨n, u, hu, hbu⟩ := factor_nonzero x hm b hb
  obtain ⟨v, hv⟩ := hu
  exact ⟨n, v, by simpa [hv, mul_comm] using hbu.symm⟩

/-- Localizing a Noetherian ring at a regular principal prime gives a DVR whose
uniformizer is the image of the generator.

Source: Stacks Project, Tags 00PD and 00IP (principal maximal ideal criterion and
Krull intersection); the principal-prime localization step of
lem-sbc-root-normalization-dvr-comparison.
(blueprint: lem-sbc-regular-principal-prime-localization-dvr)

Proof: Localization preserves regularity and Noetherianity. The maximal ideal of
B is the extension of (g), hence is generated by its image pi. Krull intersection
makes the intersection of the maximal-ideal powers zero. A nonzero element is
outside some power; induction on that power factors it as pi^n times a unit.
Regularity of pi then makes B a domain. The generator is nonzero and irreducible,
and the factorization criterion gives the DVR structure. -/
theorem regular_principal_prime_dvr
    {H B : Type*} [CommRing H] [CommRing B] [Algebra H B]
    [IsNoetherianRing H] (g : H) (hg : IsSMulRegular H g)
    [hprime : (Ideal.span {g}).IsPrime] [IsLocalization.AtPrime B (Ideal.span {g})] :
    ∃ (hB : IsDomain B), letI := hB
      ∃ (hDvr : IsDiscreteValuationRing B), letI := hDvr
        Irreducible (algebraMap H B g) := by
  let : IsLocalRing B := IsLocalization.AtPrime.isLocalRing B (Ideal.span {g})
  let : IsNoetherianRing B :=
    IsLocalization.isNoetherianRing (Ideal.span {g}).primeCompl B inferInstance
  have hreg : IsLeftRegular (algebraMap H B g) := by
    exact hg.of_isLocalization B (Ideal.span {g}).primeCompl
  have hm : IsLocalRing.maximalIdeal B = Ideal.span {algebraMap H B g} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (Ideal.span {g}) B,
      Ideal.map_span, Set.image_singleton]
  obtain ⟨hB, hDvr⟩ := dvr_of_regular_maximal_generator (algebraMap H B g) hreg hm
  let := hB
  let := hDvr
  refine ⟨hB, hDvr, ?_⟩
  have hne : algebraMap H B g ≠ 0 := by
    intro h
    have : (1 : B) = 0 := hreg (by simp [h])
    exact one_ne_zero this
  exact IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hne hm

end IsLocalization
