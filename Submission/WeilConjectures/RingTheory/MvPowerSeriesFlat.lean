module

public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.RingTheory.MvPowerSeries.Equiv
import Mathlib.RingTheory.AdicCompletion.AsTensorProduct

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Flatness of the constant inclusion into power series

Source: Stacks Project, Tag 0EYA, first paragraph; Tag 00MB.
(blueprint: lem-sbc-mv-power-series-constants-flat)
-/

@[expose] public section

universe u
namespace MvPowerSeries

/-- The inclusion of constants into a finite-variable power-series ring is flat.

Source: Stacks Project, Tag 0EYA, first paragraph; Tag 00MB.
(blueprint: lem-sbc-mv-power-series-constants-flat)

Proof: The polynomial ring in finitely many variables over B is Noetherian.
Its completion for the ideal generated by the variables is the power-series
ring: modulo the kth power both rings are the polynomials of total degree
less than k, and a compatible family of truncations specifies each coefficient.
Noetherian adic completion is flat (00MB). The polynomial ring is free over B,
with its monomial basis, hence flat. Compose these two flat maps and identify
their composite with C by its action on constants. This includes n = 0,
where C is an isomorphism, and the zero ring. -/
theorem constants_flat (B : Type u) [CommRing B] [IsNoetherianRing B] (n : ℕ) :
    (C (σ := Fin n) (R := B)).Flat := by
  let P := MvPolynomial (Fin n) B
  let I := MvPolynomial.idealOfVars (Fin n) B
  let e := toAdicCompletionAlgEquiv (Fin n) B
  have hP : (algebraMap B P).Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  have hC : (algebraMap P (AdicCompletion I P)).Flat :=
    RingHom.flat_algebraMap_iff.mpr inferInstance
  have hflat := hP.comp hC
  have heq : e.toRingHom.comp (C (σ := Fin n) (R := B)) =
      (algebraMap P (AdicCompletion I P)).comp (algebraMap B P) := by
    apply RingHom.ext
    intro b
    change e (C b) = _
    rw [← MvPolynomial.coe_C, toAdicCompletionAlgEquiv_apply, toAdicCompletion_coe]
    rfl
  apply (RingHom.Flat.comp_iff_of_bijective_left
    (f := C (σ := Fin n) (R := B)) (g := e.toRingHom) e.bijective).mp
  rwa [heq]

end MvPowerSeries
