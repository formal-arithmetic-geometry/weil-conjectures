module

public import Submission.WeilConjectures.RingTheory.BlowupChartStrictH
public import Submission.WeilConjectures.RingTheory.BlowupChartLocalization
public import Submission.WeilConjectures.Mathlib.RingTheory.RegularLocalRing.Defs

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# The open part of a blow-up chart off the strict transform of a curve

Let `C = R[T]/(xT - y)` be a chart of the blow-up of a local ring `R` with maximal ideal
`(x, y)`, and `Z = Spec C[1/f']` for an element `f' ∈ C`. We describe:

* the exceptional divisor `Y = V(x) ⊆ Z`: `C[1/f']/(x) = κ[T][1/f']`, a regular domain
  (`BlowupChart.isDomain_quotient_x`, `BlowupChart.isRegularRing_quotient_x`);
* the strict transform `X = V(h') ⊆ Z` of a regular curve `V(h)`:
  `C[1/f']/(h') = (R/(h))[1/f']`, a regular ring (`BlowupChart.isRegularRing_quotient_h'`);
* `X ∩ Y` is a reduced point (`BlowupChart.isField_quotient`);
* the complements `Z - Y = Spec R[1/(xf)]` and `Z - (X ∪ Y) = Spec R[1/(xfh)]`
  (`BlowupChart.isLocalization_x`, `BlowupChart.isLocalization_xh`).
-/

@[expose] public section

universe u

open Polynomial IsLocalRing

namespace BlowupChart

variable {R : Type u} [CommRing R] {x y : R}

/-- The ideal generated by the image of an ideal of `C` in `C[1/f']`, for a principal ideal. -/
theorem map_span_singleton_algebraMap {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]
    (a : A) : (Ideal.span {a}).map (algebraMap A S) = Ideal.span {algebraMap A S a} := by
  rw [Ideal.map_span, Set.image_singleton]

section Exceptional

variable [IsLocalRing R]

/-- `C[1/f']/(x) ≅ κ[T][1/f']`. -/
noncomputable def quotientXEquiv (hm : maximalIdeal R = Ideal.span {x, y})
    (f' : R[X] ⧸ Ideal.span {C x * X - C y}) :
    Localization.Away f' ⧸ Ideal.span {algebraMap R (Localization.Away f') x} ≃+*
      Localization.Away (toResidue (hm ▸ Ideal.subset_span (by simp) : x ∈ maximalIdeal R)
        (hm ▸ Ideal.subset_span (by simp) : y ∈ maximalIdeal R) f') :=
  (Ideal.quotEquivOfEq (by
    rw [ker_toResidue hm, map_span_singleton_algebraMap,
      ← IsScalarTower.algebraMap_apply])).trans
    (quotientAwayEquiv _ (toResidue_surjective _ _) f')

/-- The exceptional divisor `Y = V(x) ⊆ Spec C[1/f']` is integral, if `f' ∉ (x)`. -/
theorem isDomain_quotient_x (hm : maximalIdeal R = Ideal.span {x, y}) (p : R[X])
    (hp : p.map (residue R) ≠ 0) :
    IsDomain (Localization.Away (Ideal.Quotient.mk (Ideal.span {C x * X - C y}) p) ⧸
      Ideal.span {algebraMap R (Localization.Away
        (Ideal.Quotient.mk (Ideal.span {C x * X - C y}) p)) x}) := by
  have hx : x ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hy : y ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have : IsDomain (Localization.Away (toResidue hx hy (Ideal.Quotient.mk _ p))) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors
      (by rwa [toResidue_mk]))
  exact (quotientXEquiv hm _).injective.isDomain (quotientXEquiv hm _).toRingHom

/-- The exceptional divisor `Y = V(x) ⊆ Spec C[1/f']` is regular. -/
theorem isRegularRing_quotient_x (hm : maximalIdeal R = Ideal.span {x, y})
    (f' : R[X] ⧸ Ideal.span {C x * X - C y}) :
    IsRegularRing (Localization.Away f' ⧸ Ideal.span {algebraMap R (Localization.Away f') x}) :=
  IsRegularRing.of_ringEquiv (quotientXEquiv hm f').symm

end Exceptional

section StrictTransform

variable {q₁ : R} (hq₁ : IsUnit q₁) (q₀ : R)

include hq₁ in
/-- The strict transform `X = V(h') ⊆ Spec C[1/f']` of a regular curve `V(h)` is regular. -/
theorem isRegularRing_quotient_h' (hreg : IsRegularRing (R ⧸ Ideal.span {q₀ * x + q₁ * y}))
    (f' : R[X] ⧸ Ideal.span {C x * X - C y}) :
    IsRegularRing (Localization.Away f' ⧸
      Ideal.span {algebraMap _ (Localization.Away f') (strictEquation q₀ x y (q₁ := q₁))}) :=
  IsRegularRing.of_ringEquiv ((Ideal.quotEquivOfEq (by
    rw [ker_toQuotient hq₁, map_span_singleton_algebraMap])).trans
    (quotientAwayEquiv _ (toQuotient_surjective hq₁ q₀ x y) f')).symm

/-- `X ∩ Y` is a reduced point of `Spec C[1/f']`, if `f'` does not vanish there. -/
theorem isField_quotient [IsLocalRing R] (hm : maximalIdeal R = Ideal.span {x, y}) (p : R[X])
    (hp : p.eval (root hq₁ q₀) ∉ maximalIdeal R) :
    IsField (Localization.Away (Ideal.Quotient.mk (Ideal.span {C x * X - C y}) p) ⧸
      Ideal.span {algebraMap R (Localization.Away
        (Ideal.Quotient.mk (Ideal.span {C x * X - C y}) p)) x,
        algebraMap _ (Localization.Away (Ideal.Quotient.mk (Ideal.span {C x * X - C y}) p))
          (strictEquation q₀ x y (q₁ := q₁))}) := by
  have hx : x ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  have hy : y ∈ maximalIdeal R := hm ▸ Ideal.subset_span (by simp)
  set ψ := toResidueField hq₁ q₀ x y hx hy
  have hψ : IsUnit (ψ (Ideal.Quotient.mk _ p)) := by
    rw [toResidueField_mk, isUnit_iff_ne_zero, Ne, residue_eq_zero_iff]
    exact hp
  have e := (Ideal.quotEquivOfEq (by
    rw [ker_toResidueField hq₁ q₀ x y hm, Ideal.map_span, Set.image_pair,
      ← IsScalarTower.algebraMap_apply])).trans
    ((quotientAwayEquiv ψ (toResidueField_surjective hq₁ q₀ x y hx hy) _).trans
      (IsLocalization.atUnits (ResidueField R) (Submonoid.powers (ψ (Ideal.Quotient.mk _ p)))
        (S := Localization.Away (ψ (Ideal.Quotient.mk _ p)))
        (by
          rw [Submonoid.powers_le]
          exact hψ)).symm.toRingEquiv)
  exact MulEquiv.isField (Field.toIsField _) e.toMulEquiv

end StrictTransform

section Localization

variable [IsDomain R] (hx : x ≠ 0)
  (hy : ∀ a : R ⧸ Ideal.span {x}, Ideal.Quotient.mk _ y * a = 0 → a = 0)
  {f' : R[X] ⧸ Ideal.span {C x * X - C y}} (hf' : f' ≠ 0) {f : R} {d : ℕ}
  (hf : algebraMap R _ f = algebraMap R (R[X] ⧸ Ideal.span {C x * X - C y}) x ^ d * f')

include hx hy hf' hf

/-- `Z - Y = Spec R[1/(xf)]`: inverting `x` on `Spec C[1/f']` is inverting `xf` on `R`, where
`f = x ^ d f'` on `C`. -/
theorem isLocalization_x :
    IsLocalization.Away (x * f)
      (Localization.Away (algebraMap R (Localization.Away f') x)) := by
  have := isDomain hx hy
  have h1 : IsLocalization.Away (algebraMap _ (Localization.Away f') (algebraMap R
      (R[X] ⧸ Ideal.span {C x * X - C y}) x))
      (Localization.Away (algebraMap R (Localization.Away f') x)) := by
    rw [← IsScalarTower.algebraMap_apply]
    infer_instance
  have := IsLocalization.Away.mul (Localization.Away f')
    (Localization.Away (algebraMap R (Localization.Away f') x)) f' (algebraMap R _ x)
  exact isLocalization_away_mul (algebraMap_injective hx)
    ((map_ne_zero_iff _ (algebraMap_injective hx)).mpr hx) (exists_pow_mul_eq_algebraMap x y)
    hf' hf

/-- `Z - (X ∪ Y) = Spec R[1/(xfh)]`, where `f = x ^ d f'` and `h = x h'` on `C`. -/
theorem isLocalization_xh {h' : R[X] ⧸ Ideal.span {C x * X - C y}} (hh' : h' ≠ 0) {h : R}
    (hh : algebraMap R _ h = algebraMap R (R[X] ⧸ Ideal.span {C x * X - C y}) x * h') :
    IsLocalization.Away (x * f * h)
      (Localization.Away (algebraMap R (Localization.Away f') x *
        algebraMap _ (Localization.Away f') h')) := by
  have := isDomain hx hy
  have h1 : IsLocalization.Away (algebraMap _ (Localization.Away f') (algebraMap R
      (R[X] ⧸ Ideal.span {C x * X - C y}) x * h'))
      (Localization.Away (algebraMap R (Localization.Away f') x *
        algebraMap _ (Localization.Away f') h')) := by
    rw [map_mul, ← IsScalarTower.algebraMap_apply]
    infer_instance
  have h2 := IsLocalization.Away.mul (Localization.Away f')
    (Localization.Away (algebraMap R (Localization.Away f') x *
        algebraMap _ (Localization.Away f') h')) f' (algebraMap R _ x * h')
  rw [show (algebraMap R (R[X] ⧸ Ideal.span {C x * X - C y}) x * h') * f' =
    algebraMap R _ x * (f' * h') by ring] at h2
  rw [mul_assoc]
  exact isLocalization_away_mul (algebraMap_injective hx)
    ((map_ne_zero_iff _ (algebraMap_injective hx)).mpr hx) (exists_pow_mul_eq_algebraMap x y)
    (mul_ne_zero hf' hh') (k := d + 1) (by rw [map_mul, hf, hh]; ring)

omit hf in
/-- `x` is a non-zero-divisor on `C[1/f']`. -/
theorem algebraMap_mem_nonZeroDivisors :
    algebraMap R (Localization.Away f') x ∈ nonZeroDivisors (Localization.Away f') := by
  have := isDomain hx hy
  have := IsLocalization.isDomain_localization (M := Submonoid.powers f')
    (powers_le_nonZeroDivisors_of_noZeroDivisors hf')
  refine mem_nonZeroDivisors_of_ne_zero ?_
  rw [IsScalarTower.algebraMap_apply R (R[X] ⧸ Ideal.span {C x * X - C y}) (Localization.Away f'),
    map_ne_zero_iff _ (IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors
      hf')), map_ne_zero_iff _ (algebraMap_injective hx)]
  exact hx

omit hf in
/-- A nonzero element of `C` is a non-zero-divisor on `C[1/f']`. -/
theorem algebraMap_mem_nonZeroDivisors' {h' : R[X] ⧸ Ideal.span {C x * X - C y}} (hh' : h' ≠ 0) :
    algebraMap _ (Localization.Away f') h' ∈ nonZeroDivisors (Localization.Away f') := by
  have := isDomain hx hy
  have := IsLocalization.isDomain_localization (M := Submonoid.powers f')
    (powers_le_nonZeroDivisors_of_noZeroDivisors hf')
  refine mem_nonZeroDivisors_of_ne_zero ?_
  rwa [map_ne_zero_iff _ (IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors
      hf'))]

end Localization

end BlowupChart
