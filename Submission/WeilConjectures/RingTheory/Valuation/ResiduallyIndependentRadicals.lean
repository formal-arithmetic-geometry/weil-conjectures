/-!
# Unramified radical extensions generated by `p`-independent units

Let `𝒪` be a valuation subring of a field `Ω` whose residue field has exponential
characteristic `p`, and let `F → Ω` be a field. Let `θ i` (`i ∈ ι`, finite) be elements of `Ω`
with `θ i ^ p ^ n = u i ∈ F` of value `1`, such that the residues of the `u i` are
"`p ^ n`-independent" over the residue field of `F`. Then the monomials
`∏ i, θ i ^ E i`, `0 ≤ E i < p ^ n`, are residually independent over `F`: the extension
`F(θ)` is unramified of degree `p ^ (n * #ι)` and its values are values of `F`.

## Main definitions

- `Field.PowIndependent q b`: the monomials `b ^ E`, `0 ≤ E i < q`, are linearly independent
  over the subfield of `q`-th powers (for `q = p` this is `p`-independence).
- `Valuation.ResiduallyPowIndependent v F q u`: the residual analogue for a family `u` of
  elements of `F`.

## Main statements

- `Field.PowIndependent.pow`: `p`-independence implies `p ^ n`-independence.
- `Valuation.residuallyPowIndependent_of_powIndependent`: residual `q`-independence from
  `q`-independence of the residues, when `F` is the fraction field of a local ring `R` with
  `𝒪 ∩ F = R`.
- `ValuationSubring.residuallyIndependent_prod_pow`: the monomials in the `θ i` are residually
  independent.
- `IntermediateField.mem_span_prod_pow_of_mem_adjoin`: `F(θ)` is spanned by these monomials.
- `ValuationSubring.exists_valuation_eq_of_mem_adjoin`,
  `ValuationSubring.basisProdPow`, `ValuationSubring.finrank_adjoin_eq`: consequences.
-/

@[expose] public section

open Module

namespace Field

variable {k : Type*} [Field k] {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- A family `b` is `q`-independent if the monomials `∏ i, b i ^ E i`, `0 ≤ E i < q`, are
linearly independent over the subfield of `q`-th powers. For `q = p` the characteristic, this is
`p`-independence. -/
def PowIndependent (q : ℕ) (b : ι → k) : Prop :=
  ∀ g : (ι → Fin q) → k, ∑ E, g E ^ q * ∏ i, b i ^ (E i : ℕ) = 0 → ∀ E, g E = 0

/-- The decomposition of exponents `< p ^ (n + 1)` as `E₁ + p * E₂` with `E₁ < p` and
`E₂ < p ^ n`. -/
def finPowSuccEquiv (ι : Type*) (p n : ℕ) :
    (ι → Fin (p ^ n)) × (ι → Fin p) ≃ (ι → Fin (p ^ (n + 1))) :=
  (Equiv.arrowProdEquivProdArrow ι (fun _ => Fin (p ^ n)) (fun _ => Fin p)).symm.trans
    (Equiv.piCongrRight fun _ => finProdFinEquiv)

lemma finPowSuccEquiv_apply_val (ι : Type*) (p n : ℕ) (E : (ι → Fin (p ^ n)) × (ι → Fin p))
    (i : ι) : (finPowSuccEquiv ι p n E i : ℕ) = E.2 i + p * E.1 i :=
  finProdFinEquiv_apply_val _

/-- **`p`-independence implies `p ^ n`-independence.** -/
theorem PowIndependent.pow {p : ℕ} [ExpChar k p] {b : ι → k} (h : PowIndependent p b) (n : ℕ) :
    PowIndependent (p ^ n) b := by
  induction n with
  | zero =>
    unfold PowIndependent
    intro g hg E
    have h0 (x : Fin (p ^ 0)) : (x : ℕ) = 0 := Nat.lt_one_iff.1 (x.2.trans_eq (pow_zero p))
    have hE (E' : ι → Fin (p ^ 0)) : E' = E := funext fun i => Fin.ext (by rw [h0, h0])
    rw [Finset.sum_eq_single E (fun E' _ hE' => (hE' (hE E')).elim)
      (fun h => (h (Finset.mem_univ E)).elim)] at hg
    simpa [h0] using hg
  | succ n ih =>
    unfold PowIndependent
    intro g hg E
    obtain ⟨E, rfl⟩ := (finPowSuccEquiv ι p n).surjective E
    have hg' : ∑ E₁ : ι → Fin p, (∑ E₂ : ι → Fin (p ^ n),
        g (finPowSuccEquiv ι p n (E₂, E₁)) ^ p ^ n * ∏ i, b i ^ (E₂ i : ℕ)) ^ p *
          ∏ i, b i ^ (E₁ i : ℕ) = 0 := by
      rw [← hg, ← (finPowSuccEquiv ι p n).sum_comp, Fintype.sum_prod_type_right]
      refine Finset.sum_congr rfl fun E₁ _ => ?_
      rw [← frobenius_def, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun E₂ _ => ?_
      simp only [frobenius_def, finPowSuccEquiv_apply_val, mul_pow, ← Finset.prod_pow, pow_add,
        pow_mul, Finset.prod_mul_distrib, pow_succ]
      ring_nf
    exact ih _ (h _ hg' E.2) E.1

end Field

namespace Valuation

variable {Ω Γ₀ : Type*} [Field Ω] [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation Ω Γ₀)
  (F : Type*) [Field F] [Algebra F Ω] {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- A family `u` of elements of `F` is residually `q`-independent over `F` (for `v`) if every
`v`-integral combination `∑ E, c E ^ q * ∏ i, u i ^ E i` (`0 ≤ E i < q`) of value `< 1` has all
its coefficients of value `< 1`; i.e. the residues of the `u i` are `q`-independent over the
residue field of `F`. -/
def ResiduallyPowIndependent (q : ℕ) (u : ι → F) : Prop :=
  ∀ c : (ι → Fin q) → F, (∀ E, v (algebraMap F Ω (c E)) ≤ 1) →
    v (algebraMap F Ω (∑ E, c E ^ q * ∏ i, u i ^ (E i : ℕ))) < 1 →
      ∀ E, v (algebraMap F Ω (c E)) < 1

end Valuation

namespace ValuationSubring

open IsLocalRing

variable {Ω : Type*} [Field Ω] (𝒪 : ValuationSubring Ω)

/-- Elements of `𝒪` whose residues are `q`-independent in the residue field of the local ring
`R` with fraction field `F` and `𝒪 ∩ F = R` are residually `q`-independent over `F`. -/
theorem residuallyPowIndependent_of_powIndependent {R F : Type*} [CommRing R] [IsLocalRing R]
    [Field F] [Algebra R F] [IsFractionRing R F] [Algebra F Ω] [Algebra R Ω]
    [IsScalarTower R F Ω] {𝒪 : ValuationSubring Ω}
    (hO : ∀ x : F, algebraMap F Ω x ∈ 𝒪 ↔ x ∈ (algebraMap R F).range) {ι : Type*} [Fintype ι]
    [DecidableEq ι] {q : ℕ} {t : ι → R} (ht : Field.PowIndependent q fun i => residue R (t i)) :
    𝒪.valuation.ResiduallyPowIndependent F q fun i => algebraMap R F (t i) := by
  intro c hc hlt E
  choose r hr using fun E => (hO (c E)).1 ((valuation_le_one_iff _ _).1 (hc E))
  have hsum : ∑ E, c E ^ q * ∏ i, algebraMap R F (t i) ^ (E i : ℕ) =
      algebraMap R F (∑ E, r E ^ q * ∏ i, t i ^ (E i : ℕ)) := by
    simp [← hr, map_sum, map_prod]
  rw [hsum, ← IsScalarTower.algebraMap_apply] at hlt
  have hnu : ∑ E, r E ^ q * ∏ i, t i ^ (E i : ℕ) ∈ maximalIdeal R := fun hu =>
    (valuation_algebraMap_unit hO hu.unit).not_lt hlt
  rw [← residue_eq_zero_iff] at hnu
  simp only [map_sum, map_mul, map_pow, map_prod] at hnu
  have h0 := ht _ hnu E
  rw [residue_eq_zero_iff, mem_maximalIdeal] at h0
  rw [← hr, ← IsScalarTower.algebraMap_apply]
  exact valuation_algebraMap_lt_one hO (_root_.mem_nonunits_iff.1 h0)

/-- In residue characteristic `p`, the `p ^ n`-th power of a sum of integral elements is
congruent to the sum of the `p ^ n`-th powers modulo the maximal ideal. -/
theorem valuation_sum_pow_sub_lt_one {p : ℕ} [ExpChar (ResidueField 𝒪) p] (n : ℕ) {α : Type*}
    [Fintype α] (x : α → Ω) (hx : ∀ a, 𝒪.valuation (x a) ≤ 1) :
    𝒪.valuation ((∑ a, x a) ^ p ^ n - ∑ a, x a ^ p ^ n) < 1 := by
  let y : α → 𝒪 := fun a => ⟨x a, (valuation_le_one_iff _ _).1 (hx a)⟩
  have h := (valuation_lt_one_iff 𝒪 ((∑ a, y a) ^ p ^ n - ∑ a, y a ^ p ^ n)).1 (by
    rw [← residue_eq_zero_iff, map_sub, sub_eq_zero, map_pow, map_sum, map_sum,
      ← iterateFrobenius_def (R := ResidueField 𝒪) p n, map_sum]
    simp only [iterateFrobenius_def, map_pow])
  simpa [y] using h

/-- Products of powers of elements of value `1` have value `1`. -/
lemma valuation_prod_pow_eq_one {ι : Type*} [Fintype ι] {θ : ι → Ω}
    (hθ : ∀ i, 𝒪.valuation (θ i) = 1) (E : ι → ℕ) : 𝒪.valuation (∏ i, θ i ^ E i) = 1 := by
  simp [map_prod, hθ]

/-- **Residual independence of monomials in `p ^ n`-th roots.** If `θ i ^ p ^ n = u i ∈ F` are
of value `1` and the `u i` are residually `p ^ n`-independent over `F`, then the monomials
`∏ i, θ i ^ E i`, `0 ≤ E i < p ^ n`, are residually independent over `F`. -/
theorem residuallyIndependent_prod_pow {F : Type*} [Field F] [Algebra F Ω] {p : ℕ}
    [ExpChar (ResidueField 𝒪) p] {ι : Type*} [Fintype ι] [DecidableEq ι] {n : ℕ} {θ : ι → Ω}
    {u : ι → F} (hθ : ∀ i, θ i ^ p ^ n = algebraMap F Ω (u i))
    (hu : ∀ i, 𝒪.valuation (algebraMap F Ω (u i)) = 1)
    (h : 𝒪.valuation.ResiduallyPowIndependent F (p ^ n) u) :
    𝒪.valuation.ResiduallyIndependent F fun E : ι → Fin (p ^ n) => ∏ i, θ i ^ (E i : ℕ) := by
  intro c hc hlt
  refine h c hc ?_
  have hpn : p ^ n ≠ 0 := pow_ne_zero n (expChar_pos (ResidueField 𝒪) p).ne'
  have hθ1 (i : ι) : 𝒪.valuation (θ i) = 1 := by
    rw [← pow_eq_one_iff_left hpn, ← map_pow, hθ, hu]
  have hx (E : ι → Fin (p ^ n)) : 𝒪.valuation (c E • ∏ i, θ i ^ (E i : ℕ)) ≤ 1 := by
    rw [Algebra.smul_def, map_mul, valuation_prod_pow_eq_one 𝒪 hθ1, mul_one]
    exact hc E
  have h1 := valuation_sum_pow_sub_lt_one 𝒪 (p := p) n _ hx
  have h2 : 𝒪.valuation ((∑ E, c E • ∏ i, θ i ^ (E i : ℕ)) ^ p ^ n) < 1 := by
    rw [map_pow]
    exact pow_lt_one₀ zero_le hlt hpn
  have key : algebraMap F Ω (∑ E, c E ^ p ^ n * ∏ i, u i ^ (E i : ℕ)) =
      ∑ E, (c E • ∏ i, θ i ^ (E i : ℕ)) ^ p ^ n := by
    simp only [map_sum, map_mul, map_prod, map_pow, ← hθ, Algebra.smul_def, mul_pow,
      ← Finset.prod_pow, ← pow_mul, mul_comm]
  rw [key, ← sub_sub_cancel ((∑ E, c E • ∏ i, θ i ^ (E i : ℕ)) ^ p ^ n)
    (∑ E, (c E • ∏ i, θ i ^ (E i : ℕ)) ^ p ^ n)]
  exact Valuation.map_sub_lt _ h2 h1

end ValuationSubring

namespace IntermediateField

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω] {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma prod_pow_update (θ : ι → Ω) {q : ℕ} (E : ι → Fin q) (i : ι) (x : Fin q) :
    ∏ j, θ j ^ (Function.update E i x j : ℕ) =
      θ i ^ (x : ℕ) * ∏ j ∈ Finset.univ.erase i, θ j ^ (E j : ℕ) := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i), Function.update_self]
  congr 1
  refine Finset.prod_congr rfl fun j hj => ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]

omit [DecidableEq ι] in
/-- If `θ i ^ q ∈ F` for all `i`, then `F(θ)` is spanned over `F` by the monomials
`∏ i, θ i ^ E i` with `0 ≤ E i < q`. -/
theorem mem_span_prod_pow_of_mem_adjoin {q : ℕ} (hq : 0 < q) {θ : ι → Ω}
    (hθ : ∀ i, θ i ^ q ∈ (algebraMap F Ω).range) {y : Ω} (hy : y ∈ adjoin F (Set.range θ)) :
    y ∈ Submodule.span F (Set.range fun E : ι → Fin q => ∏ i, θ i ^ (E i : ℕ)) := by
  classical
  set V := Submodule.span F (Set.range fun E : ι → Fin q => ∏ i, θ i ^ (E i : ℕ))
  have hmem (E : ι → Fin q) : ∏ i, θ i ^ (E i : ℕ) ∈ V := Submodule.subset_span ⟨E, rfl⟩
  have hmul (i : ι) (E : ι → Fin q) : θ i * ∏ j, θ j ^ (E j : ℕ) ∈ V := by
    have hE := prod_pow_update θ E i (E i)
    rw [Function.update_eq_self] at hE
    rw [hE, ← mul_assoc, ← pow_succ']
    by_cases h : (E i : ℕ) + 1 < q
    · have := hmem (Function.update E i ⟨_, h⟩)
      rwa [prod_pow_update] at this
    · obtain ⟨a, ha⟩ := hθ i
      have h' : (E i : ℕ) + 1 = q := by omega
      have := V.smul_mem a (hmem (Function.update E i ⟨0, hq⟩))
      rw [prod_pow_update, pow_zero, one_mul, Algebra.smul_def, ha] at this
      rwa [h']
  have hmulV (i : ι) {w : Ω} (hw : w ∈ V) : θ i * w ∈ V := by
    induction hw using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨E, rfl⟩ := hx
      exact hmul i E
    | zero => simp
    | add x y _ _ hx hy =>
      rw [mul_add]
      exact V.add_mem hx hy
    | smul a x _ hx =>
      rw [mul_smul_comm]
      exact V.smul_mem a hx
  have halg (x : Ω) (hx : x ∈ Set.range θ) : IsAlgebraic F x := by
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨a, ha⟩ := hθ i
    exact ⟨Polynomial.X ^ q - Polynomial.C a,
      (Polynomial.monic_X_pow_sub_C a hq.ne').ne_zero, by simp [ha]⟩
  rw [← mem_toSubalgebra, adjoin_toSubalgebra_of_isAlgebraic halg] at hy
  have key (x : Ω) (hx : x ∈ Algebra.adjoin F (Set.range θ)) (w : Ω) (hw : w ∈ V) :
      x * w ∈ V := by
    induction hx using Algebra.adjoin_induction generalizing w with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hmulV i hw
    | algebraMap r =>
      rw [← Algebra.smul_def]
      exact V.smul_mem r hw
    | add x y _ _ hx hy =>
      rw [add_mul]
      exact V.add_mem (hx w hw) (hy w hw)
    | mul x y _ _ hx hy =>
      rw [mul_assoc]
      exact hx _ (hy w hw)
  simpa using key y hy _ (hmem fun _ => (⟨0, hq⟩ : Fin q))

omit [DecidableEq ι] in
lemma prod_pow_mem_adjoin (θ : ι → Ω) {q : ℕ} (E : ι → Fin q) :
    ∏ i, θ i ^ (E i : ℕ) ∈ adjoin F (Set.range θ) :=
  prod_mem fun i _ => pow_mem (subset_adjoin F (Set.range θ) ⟨i, rfl⟩) _

end IntermediateField

namespace ValuationSubring

open IsLocalRing IntermediateField

variable {Ω : Type*} [Field Ω] (𝒪 : ValuationSubring Ω) {F : Type*} [Field F] [Algebra F Ω]
  {p : ℕ} [ExpChar (ResidueField 𝒪) p] {ι : Type*} [Fintype ι] [DecidableEq ι] {n : ℕ}
  {θ : ι → Ω} {u : ι → F}

/-- **Valuation of elements of `F(θ)`.** Every element `y` of `F(θ)` is a combination of the
monomials `∏ i, θ i ^ E i`, `0 ≤ E i < p ^ n`, and its value is the maximum of the values of
the coefficients. -/
theorem exists_eq_sum_smul_prod_pow (hθ : ∀ i, θ i ^ p ^ n = algebraMap F Ω (u i))
    (hu : ∀ i, 𝒪.valuation (algebraMap F Ω (u i)) = 1)
    (h : 𝒪.valuation.ResiduallyPowIndependent F (p ^ n) u) {y : Ω}
    (hy : y ∈ adjoin F (Set.range θ)) :
    ∃ c : (ι → Fin (p ^ n)) → F, y = ∑ E, c E • ∏ i, θ i ^ (E i : ℕ) ∧
      𝒪.valuation y = Finset.univ.sup fun E => 𝒪.valuation (algebraMap F Ω (c E)) := by
  have hpn : 0 < p ^ n := pow_pos (expChar_pos (ResidueField 𝒪) p) n
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun F).1
    (mem_span_prod_pow_of_mem_adjoin hpn (fun i => ⟨u i, (hθ i).symm⟩) hy)
  have hθ1 (i : ι) : 𝒪.valuation (θ i) = 1 := by
    rw [← pow_eq_one_iff_left hpn.ne', ← map_pow, hθ, hu]
  exact ⟨c, rfl, (residuallyIndependent_prod_pow 𝒪 hθ hu h).map_sum_smul
    (fun E => valuation_prod_pow_eq_one 𝒪 hθ1 _) c⟩

/-- **The values of `F(θ)` are values of `F`.** -/
theorem exists_valuation_eq_of_mem_adjoin (hθ : ∀ i, θ i ^ p ^ n = algebraMap F Ω (u i))
    (hu : ∀ i, 𝒪.valuation (algebraMap F Ω (u i)) = 1)
    (h : 𝒪.valuation.ResiduallyPowIndependent F (p ^ n) u) {y : Ω}
    (hy : y ∈ adjoin F (Set.range θ)) :
    ∃ c : F, 𝒪.valuation y = 𝒪.valuation (algebraMap F Ω c) := by
  obtain ⟨c, -, hc⟩ := exists_eq_sum_smul_prod_pow 𝒪 hθ hu h hy
  have : Nonempty (ι → Fin (p ^ n)) :=
    ⟨fun _ => ⟨0, pow_pos (expChar_pos (ResidueField 𝒪) p) n⟩⟩
  obtain ⟨E, -, hE⟩ := Finset.univ.exists_mem_eq_sup Finset.univ_nonempty
    (fun E => 𝒪.valuation (algebraMap F Ω (c E)))
  exact ⟨c E, hc.trans hE⟩

/-- The monomials `∏ i, θ i ^ E i`, `0 ≤ E i < p ^ n`, form a basis of `F(θ)` over `F`. -/
noncomputable def basisProdPow (hθ : ∀ i, θ i ^ p ^ n = algebraMap F Ω (u i))
    (hu : ∀ i, 𝒪.valuation (algebraMap F Ω (u i)) = 1)
    (h : 𝒪.valuation.ResiduallyPowIndependent F (p ^ n) u) :
    Basis (ι → Fin (p ^ n)) F (adjoin F (Set.range θ)) :=
  have hθ1 (i : ι) : 𝒪.valuation (θ i) = 1 := by
    rw [← pow_eq_one_iff_left (pow_pos (expChar_pos (ResidueField 𝒪) p) n).ne', ← map_pow, hθ,
      hu]
  Basis.mk (v := fun E => ⟨∏ i, θ i ^ (E i : ℕ), prod_pow_mem_adjoin θ E⟩)
    (LinearIndependent.of_comp (adjoin F (Set.range θ)).val.toLinearMap
      ((residuallyIndependent_prod_pow 𝒪 hθ hu h).linearIndependent
        (fun E => valuation_prod_pow_eq_one 𝒪 hθ1 _)))
    (by
      rintro ⟨y, hy⟩ -
      obtain ⟨c, rfl, -⟩ := exists_eq_sum_smul_prod_pow 𝒪 hθ hu h hy
      rw [Submodule.mem_span_range_iff_exists_fun]
      exact ⟨c, Subtype.ext (by simp)⟩)

/-- **Degree of `F(θ)`.** -/
theorem finrank_adjoin_eq (hθ : ∀ i, θ i ^ p ^ n = algebraMap F Ω (u i))
    (hu : ∀ i, 𝒪.valuation (algebraMap F Ω (u i)) = 1)
    (h : 𝒪.valuation.ResiduallyPowIndependent F (p ^ n) u) :
    finrank F (adjoin F (Set.range θ)) = p ^ (n * Fintype.card ι) := by
  rw [finrank_eq_card_basis (basisProdPow 𝒪 hθ hu h), Fintype.card_fun, Fintype.card_fin,
    pow_mul]

end ValuationSubring
