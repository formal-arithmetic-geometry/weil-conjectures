set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Approximation by lifts of a Frobenius-closed basis

Let `𝒪` be a valuation subring of a field `Ω` with residue field `ℓ` of characteristic `p`, and
let `K₀ ≤ K` and `K₀ ≤ D ≤ L` be subfields of `Ω` such that

* `D` is discretely valued, with value group generated by `v ϖ`, `ϖ ∈ K₀`;
* `K₀` has the full residue field of `K`;
* the residue field `E` of `D` has a `k`-basis `1, u i ^ p ^ n` (`k` the residue field of `K`),
  and the residue `x̄` of an element `x ∈ D ∩ 𝒪` is a polynomial of degree `< p` in any element
  `ρ ∈ E` which is not a `p`-th power, with coefficients `p`-th powers in `E`.

Lifting the `u i` to `w i ∈ D ∩ 𝒪`, the monomials `w i ^ p ^ n` are valuation independent over
`K`, every element of `D ∩ 𝒪` (and every element of a finite `K`-combination of such elements)
is approximated to arbitrary precision by combinations of the monomials with coefficients in a
discrete subfield `Kst ≤ K`, and the elements of the field generated by `K` and `D ∩ 𝒪` by
combinations with coefficients in `K` (`ValuationSubring.exists_frobeniusLift_package`).
-/

@[expose] public section

open IsLocalRing

namespace ValuationSubring

variable {Ω : Type*} [Field Ω] (𝒪 : ValuationSubring Ω)

/-- **Approximation by lifts of a Frobenius-closed basis** (abstract form). Lifting the `u i` to
`w i ∈ D ∩ 𝒪`, there are a subring `A ⊆ L ∩ 𝒪` containing the `w i` and a discretely valued
subfield `Kst ⊆ K` (with uniformizer `ϖ'`) such that:

* the monomials `1, w i ^ p ^ n` are valuation independent over `K`;
* if a `K`-combination `S` of the monomials with integral coefficients has a unit coefficient on
  some `w i`, then `x` is congruent to a polynomial in `S` with `p`-th power coefficients;
* the elements of `A`, and `α`, are approximated to arbitrary precision by `Kst`-combinations of
  the monomials, and the elements of the field generated by `K` and `A` by `K`-combinations;
* `A` contains the inverses of its units and the integral elements of `Kst`, and the residues of
  `Kst` are `p`-th powers. -/
theorem exists_frobeniusLift_package {p : ℕ} [Fact p.Prime] [CharP (ResidueField 𝒪) p]
    (K K₀ D L : Subfield Ω) (hK₀K : K₀ ≤ K) (hK₀D : K₀ ≤ D) (hDL : D ≤ L) (hKL : K ≤ L)
    {ϖ : Ω} (hϖ : ϖ ∈ K₀) (hϖ0 : ϖ ≠ 0) (hϖ1 : 𝒪.valuation ϖ < 1)
    (hdisc : ∀ z ∈ D, z ≠ 0 → ∃ m : ℤ, 𝒪.valuation z = 𝒪.valuation ϖ ^ m)
    (harch : ∀ z : Ω, z ≠ 0 →
      ∃ n : ℕ, 0 < n ∧ ∃ m : ℤ, 𝒪.valuation z ^ n = 𝒪.valuation ϖ ^ m)
    (hKroot : ∀ n : ℕ, 0 < n → ∀ y ∈ K, ∃ z ∈ K, z ^ n = y)
    (halg : ∀ c ∈ K, IsAlgebraic K₀ c)
    (hfull : ∀ y ∈ K, 𝒪.valuation y ≤ 1 → ∃ z ∈ K₀, 𝒪.valuation (y - z) < 1)
    {x : 𝒪}
    {ι : Type*} {u : ι → ResidueField 𝒪} (hu : ∀ i, u i ∈ 𝒪.residueSubfield D)
    (hli : LinearIndependent (𝒪.residueSubfield K)
      (fun j : Option (ι × ℕ) ↦ j.elim 1 fun i ↦ u i.1 ^ p ^ i.2))
    (hsp : ∀ e ∈ 𝒪.residueSubfield D, e ∈ Submodule.span (𝒪.residueSubfield K)
      (Set.range fun j : Option (ι × ℕ) ↦ j.elim 1 fun i ↦ u i.1 ^ p ^ i.2))
    (hpth : ∀ ρ ∈ 𝒪.residueSubfield D, (∀ z ∈ 𝒪.residueSubfield D, z ^ p ≠ ρ) →
      ∃ y : ℕ → ResidueField 𝒪, (∀ j, y j ∈ 𝒪.residueSubfield D) ∧
        residue 𝒪 x = ∑ j ∈ Finset.range p, y j ^ p * ρ ^ j)
    {α : Ω} (hα : ∃ (n : ℕ) (c a : Fin n → Ω), (∀ l, c l ∈ K) ∧
      (∀ l, a l ∈ D ∧ 𝒪.valuation (a l) ≤ 1) ∧ α = ∑ l, c l * a l) :
    ∃ (w : ι → Ω) (A : Subring Ω) (Kst : Subfield Ω), Kst ≤ K ∧
      -- (P1) the lifts and the ring `A`
      (∀ i, w i ∈ A) ∧ (∀ y ∈ A, y ∈ L ∧ 𝒪.valuation y ≤ 1) ∧ (∀ i, 𝒪.valuation (w i) = 1) ∧
      -- (P2) valuation independence over `K`
      (∀ c : Option (ι × ℕ) →₀ Ω, (∀ j, c j ∈ K) →
        ∀ j, 𝒪.valuation (c j) ≤ 𝒪.valuation (frobeniusComb p w c)) ∧
      -- (P3) the residue of `x` is a polynomial with `p`-th power coefficients
      (∀ c : Option (ι × ℕ) →₀ Ω, (∀ j, c j ∈ K) → (∀ j, 𝒪.valuation (c j) ≤ 1) →
        (∃ i, 𝒪.valuation (c (some (i, 0))) = 1) →
        ∃ (N : ℕ) (y : ℕ → Ω), (∀ k, y k ∈ L ∧ 𝒪.valuation (y k) ≤ 1) ∧
          𝒪.valuation ((x : Ω) - ∑ k ∈ Finset.range N, y k ^ p * frobeniusComb p w c ^ k) < 1) ∧
      -- (P4) `Kst` is discretely valued
      (∃ ϖ' ∈ Kst, 0 < 𝒪.valuation ϖ' ∧ 𝒪.valuation ϖ' < 1 ∧
        (∀ c ∈ Kst, c ≠ 0 → ∃ n : ℤ, 𝒪.valuation c = 𝒪.valuation ϖ' ^ n) ∧
        ∀ t : Ω, t ≠ 0 → ∃ N : ℕ, 𝒪.valuation ϖ' ^ N < 𝒪.valuation t) ∧
      -- (P5) approximation of the elements of `A` over `Kst`
      (∀ y ∈ A, ∀ t : Ω, t ≠ 0 → ∃ e : Option (ι × ℕ) →₀ Ω, (∀ k, e k ∈ Kst) ∧
        𝒪.valuation (y - frobeniusComb p w e) < 𝒪.valuation t) ∧
      -- (P6) approximation of `α` over `Kst`
      (∀ t : Ω, t ≠ 0 → ∃ e : Option (ι × ℕ) →₀ Ω, (∀ k, e k ∈ Kst) ∧
        𝒪.valuation (α - frobeniusComb p w e) < 𝒪.valuation t) ∧
      -- (P7) approximation of the field generated by `K` and `A` over `K`
      (∀ y ∈ Subfield.closure ((K : Set Ω) ∪ A), ∀ t : Ω, t ≠ 0 →
        ∃ c : Option (ι × ℕ) →₀ Ω, (∀ j, c j ∈ K) ∧
          𝒪.valuation (y - frobeniusComb p w c) < 𝒪.valuation t) ∧
      -- (P8) units, integral elements and residues of `Kst`
      (∀ y ∈ A, 𝒪.valuation y = 1 → y⁻¹ ∈ A) ∧
      (∀ c ∈ Kst, 𝒪.valuation c ≤ 1 → c ∈ A) ∧
      (∀ c ∈ Kst, 𝒪.valuation c ≤ 1 → ∃ d ∈ Kst, 𝒪.valuation (d ^ p - c) < 1) := by
  classical
  have hp : p.Prime := Fact.out
  -- the residues of `K` are residues of integral elements of `K₀`
  have hlift : ∀ a ∈ 𝒪.residueSubfield K, ∃ z : 𝒪, (z : Ω) ∈ K₀ ∧ residue 𝒪 z = a := by
    rintro _ ⟨y, hyK, rfl⟩
    obtain ⟨z, hzK₀, hz⟩ := hfull y hyK (valuation_le_one _ y)
    have hz1 : 𝒪.valuation z ≤ 1 := by
      have h := 𝒪.valuation.map_sub_le (valuation_le_one 𝒪 y) hz.le
      rwa [sub_sub_cancel] at h
    exact ⟨⟨z, (valuation_le_one_iff _ _).1 hz1⟩, hzK₀,
      ((valuation_sub_lt_one_iff y ⟨z, (valuation_le_one_iff _ _).1 hz1⟩).1 hz).symm⟩
  have hKD : 𝒪.residueSubfield K ≤ 𝒪.residueSubfield D := fun a ha ↦ by
    obtain ⟨z, hzK₀, rfl⟩ := hlift a ha
    exact ⟨z, hK₀D hzK₀, rfl⟩
  -- the lifts `W i` of the `u i`
  choose W hWD hW using hu
  have hW1 (i : ι) : 𝒪.valuation (W i : Ω) = 1 := by
    refine valuation_eq_one_of_residue_ne_zero ?_
    simpa [hW] using hli.ne_zero (some (i, 0))
  have hγ : 𝒪.valuation ϖ ≠ 0 := (𝒪.valuation.ne_zero_iff).2 hϖ0
  have hprec (t : Ω) (ht : t ≠ 0) : ∃ N : ℕ, 𝒪.valuation ϖ ^ N < 𝒪.valuation t := by
    obtain ⟨n, hn, m, hm⟩ := harch t ht
    exact Valuation.exists_pow_lt_of_pow_eq_zpow hγ hϖ1 hn hm
  have happrox (d : Ω) (hd : d ∈ D) (hd1 : 𝒪.valuation d ≤ 1) (N : ℕ) :
      ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ K₀) ∧
        𝒪.valuation (d - frobeniusComb p (fun i ↦ (W i : Ω)) e) ≤ 𝒪.valuation ϖ ^ N :=
    exists_valuation_sub_le_pow hK₀D hsp hlift hW hWD hϖ hϖ0 hϖ1 hdisc N hd hd1
  have hSalg (S : Subfield Ω) (hS : S ≤ K) (c : Ω) (hc : c ∈ S) : IsAlgebraic D c :=
    (halg c (hS hc)).of_subfield_le hK₀D
  -- the discretely valued subfield `Kst`
  obtain ⟨nα, cα, aα, hcα, haα, rfl⟩ := hα
  let F : IntermediateField K₀ Ω := IntermediateField.adjoin K₀ (Set.range cα)
  have : FiniteDimensional K₀ F := IntermediateField.finiteDimensional_adjoin fun _ ⟨l, hl⟩ ↦
    hl ▸ (halg _ (hcα l)).isIntegral
  have hFK : F.toSubfield ≤ K := by
    rw [IntermediateField.adjoin_toSubfield]
    refine Subfield.closure_le.2 (Set.union_subset ?_ ?_)
    · rintro _ ⟨a, rfl⟩
      exact hK₀K a.2
    · rintro _ ⟨l, rfl⟩
      exact hcα l
  have hK₀F : K₀ ≤ F.toSubfield := fun a ha ↦ F.algebraMap_mem ⟨a, ha⟩
  obtain ⟨ϖ', hϖ'F, hϖ'0, hϖ'1, hϖ'disc, M, hM0, hϖ'M⟩ :=
    Valuation.exists_uniformizer_of_finiteDimensional F hϖ hϖ0 hϖ1
      fun a ha ha0 ↦ hdisc a (hK₀D ha) ha0
  -- the ring `A`
  let B := Subfield.closure ((F.toSubfield : Set Ω) ∪ D)
  have hBL : B ≤ L :=
    Subfield.closure_le.2 (Set.union_subset (fun _ hz ↦ hKL (hFK hz)) fun _ hz ↦ hDL hz)
  refine ⟨fun i ↦ (W i : Ω), B.toSubring ⊓ 𝒪.toSubring, F.toSubfield, hFK,
    fun i ↦ ⟨Subfield.subset_closure (Or.inr (hWD i)), (W i).2⟩,
    fun y hy ↦ ⟨hBL hy.1, (valuation_le_one_iff _ _).2 hy.2⟩, hW1,
    fun c hc j ↦ valuation_le_valuation_frobeniusComb hli hW hc j, ?_, ?_, ?_, ?_, ?_,
    fun y hy hy1 ↦ ⟨B.inv_mem hy.1, (valuation_le_one_iff _ _).1 (by rw [map_inv₀, hy1, inv_one])⟩,
    fun c hc hc1 ↦ ⟨Subfield.subset_closure (Or.inl hc), (valuation_le_one_iff _ _).1 hc1⟩, ?_⟩
  -- (P3)
  · rintro c hcK hc1 ⟨i, hi⟩
    obtain ⟨y, hy, hlt⟩ := exists_valuation_sub_sum_pow_mul_pow_lt_one hKD
      (fun i ↦ ⟨W i, hWD i, hW i⟩) hli hsp hpth hW hcK hc1 hi
    exact ⟨p, y, fun k ↦ ⟨hDL (hy k).1, (hy k).2⟩, hlt⟩
  -- (P4)
  · refine ⟨ϖ', hϖ'F, hϖ'0, hϖ'1, hϖ'disc, fun t ht ↦ ?_⟩
    obtain ⟨N, hN⟩ := hprec t ht
    refine ⟨M * N, lt_of_le_of_lt ?_ hN⟩
    rw [pow_mul]
    exact pow_le_pow_left₀ zero_le hϖ'M N
  -- (P5)
  · intro y hy t ht
    exact Valuation.exists_valuation_sub_frobeniusComb_lt_of_mem_closure hK₀F
      (hSalg _ hFK) (hK₀F hϖ) (hK₀D hϖ) hϖ0 hdisc hprec happrox hy.1 ht
  -- (P6)
  · intro t ht
    exact Valuation.exists_valuation_sub_frobeniusComb_lt_of_sum hK₀F hprec happrox
      (fun l ↦ IntermediateField.subset_adjoin _ _ ⟨l, rfl⟩) haα ht
  -- (P7)
  · intro y hy t ht
    have hBK : B ≤ Subfield.closure ((K : Set Ω) ∪ D) :=
      Subfield.closure_mono (Set.union_subset_union_left _ hFK)
    have hle : Subfield.closure ((K : Set Ω) ∪ (B.toSubring ⊓ 𝒪.toSubring : Subring Ω)) ≤
        Subfield.closure ((K : Set Ω) ∪ D) :=
      Subfield.closure_le.2 (Set.union_subset (fun _ hz ↦ Subfield.subset_closure (Or.inl hz))
        fun _ hz ↦ hBK hz.1)
    exact Valuation.exists_valuation_sub_frobeniusComb_lt_of_mem_closure hK₀K (hSalg K le_rfl)
      (hK₀K hϖ) (hK₀D hϖ) hϖ0 hdisc hprec happrox (hle hy) ht
  -- (P8) residues of `Kst` are `p`-th powers
  · intro c hc hc1
    obtain ⟨z, hzK, hzc⟩ := hKroot p hp.pos c (hFK hc)
    have hz1 : 𝒪.valuation z ≤ 1 := by
      by_contra h
      have h' := one_lt_pow₀ (not_le.1 h) hp.ne_zero
      rw [← map_pow, hzc] at h'
      exact h'.not_ge hc1
    let Z : 𝒪 := ⟨z, (valuation_le_one_iff _ _).1 hz1⟩
    obtain ⟨z', hz'K₀, hz'res⟩ := hlift (residue 𝒪 Z) ⟨Z, hzK, rfl⟩
    refine ⟨z', hK₀F hz'K₀, ?_⟩
    have heq : (z' : Ω) ^ p - c = ((z' ^ p : 𝒪) : Ω) - ((Z ^ p : 𝒪) : Ω) := by
      rw [← hzc]
      push_cast
      rfl
    rw [heq, valuation_sub_lt_one_iff, map_pow, map_pow, hz'res]

end ValuationSubring
