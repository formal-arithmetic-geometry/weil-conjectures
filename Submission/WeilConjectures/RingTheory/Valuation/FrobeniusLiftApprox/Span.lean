public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Fields generated by an algebraic subfield and a discretely valued subfield

Let `v` be a valuation on `Ω`, `D ⊆ Ω` a subfield whose nonzero values are the powers of `v ϖ`
(`ϖ ∈ D`), and `S ⊆ Ω` a subfield containing `ϖ` whose elements are algebraic over `D`. Every
element of the field generated by `S` and `D` is a finite sum `∑ c l * d l` with `c l ∈ S` and
`d l ∈ D` integral (`Valuation.exists_eq_sum_mul_of_mem_closure`).

Consequently, if the integral elements of `D` are approximated to arbitrary precision by
combinations of lifted Frobenius monomials with coefficients in `K₀ ≤ S`, so are the elements of
the field generated by `S` and `D`, with coefficients in `S`
(`Valuation.exists_valuation_sub_frobeniusComb_lt_of_mem_closure`).
-/

@[expose] public section

open Polynomial

/-- An element algebraic over a subfield is algebraic over every larger subfield. -/
lemma IsAlgebraic.of_subfield_le {Ω : Type*} [Field Ω] {K₀ D : Subfield Ω} (h : K₀ ≤ D)
    {x : Ω} (hx : IsAlgebraic K₀ x) : IsAlgebraic D x := by
  obtain ⟨P, hP, hPx⟩ := hx
  refine ⟨P.map (Subfield.inclusion h), (Polynomial.map_ne_zero_iff
    (Subfield.inclusion h).injective).2 hP, ?_⟩
  rw [aeval_def, eval₂_map]
  exact hPx

/-- A combination of lifted Frobenius monomials is additive in the coefficients. -/
lemma frobeniusComb_sum {Ω : Type*} [Field Ω] {ι α : Type*} (p : ℕ) (w : ι → Ω) (s : Finset α)
    (f : α → Option (ι × ℕ) →₀ Ω) :
    frobeniusComb p w (∑ a ∈ s, f a) = ∑ a ∈ s, frobeniusComb p w (f a) :=
  map_sum (AddMonoidHom.mk' (frobeniusComb p w) (frobeniusComb_add p)) f s

namespace Valuation

variable {Ω Γ₀ : Type*} [Field Ω] [LinearOrderedCommGroupWithZero Γ₀] {v : Valuation Ω Γ₀}

/-- **Fields generated by an algebraic subfield and a discretely valued subfield.** If the
nonzero values of `D` are powers of `v ϖ`, `ϖ ∈ S ∩ D`, and the elements of `S` are algebraic
over `D`, then every element of the field generated by `S` and `D` is a finite sum
`∑ c l * d l` with `c l ∈ S` and `d l ∈ D` integral. -/
theorem exists_eq_sum_mul_of_mem_closure {S D : Subfield Ω} (hSalg : ∀ c ∈ S, IsAlgebraic D c)
    {ϖ : Ω} (hϖS : ϖ ∈ S) (hϖD : ϖ ∈ D) (hϖ0 : ϖ ≠ 0)
    (hdisc : ∀ z ∈ D, z ≠ 0 → ∃ m : ℤ, v z = v ϖ ^ m) {y : Ω}
    (hy : y ∈ Subfield.closure ((S : Set Ω) ∪ D)) :
    ∃ (n : ℕ) (c d : Fin n → Ω), (∀ l, c l ∈ S) ∧ (∀ l, d l ∈ D ∧ v (d l) ≤ 1) ∧
      y = ∑ l, c l * d l := by
  have hle : Subfield.closure ((S : Set Ω) ∪ D) ≤
      (IntermediateField.adjoin D (S : Set Ω)).toSubfield := by
    refine Subfield.closure_le.2 (Set.union_subset (IntermediateField.subset_adjoin _ _)
      fun z hz ↦ ?_)
    exact IntermediateField.algebraMap_mem _ (⟨z, hz⟩ : D)
  have hyA : y ∈ Algebra.adjoin D (S : Set Ω) := by
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic hSalg]
    exact hle hy
  rw [← Subalgebra.mem_toSubmodule, Algebra.adjoin_eq_span, Submodule.mem_span_set'] at hyA
  obtain ⟨n, f, g, rfl⟩ := hyA
  have hgS (l : Fin n) : (g l : Ω) ∈ S :=
    Submonoid.closure_le.2 (fun _ h ↦ h) (g l).2
  have hγ : v ϖ ≠ 0 := (v.ne_zero_iff).2 hϖ0
  have hterm (a : D) (b : Ω) (hb : b ∈ S) :
      ∃ c d : Ω, c ∈ S ∧ (d ∈ D ∧ v d ≤ 1) ∧ a • b = c * d := by
    by_cases ha : (a : Ω) = 0
    · refine ⟨0, 0, S.zero_mem, ⟨D.zero_mem, by rw [map_zero]; exact zero_le⟩, ?_⟩
      rw [Subfield.smul_def, smul_eq_mul, ha, zero_mul, zero_mul]
    obtain ⟨m, hm⟩ := hdisc _ a.2 ha
    refine ⟨b * ϖ ^ m, ϖ ^ (-m) * a, S.mul_mem hb (S.zpow_mem hϖS m),
      ⟨D.mul_mem (D.zpow_mem hϖD _) a.2, ?_⟩, ?_⟩
    · rw [map_mul, map_zpow₀, hm, ← zpow_add₀ hγ, neg_add_cancel, zpow_zero]
    · rw [Subfield.smul_def, smul_eq_mul, zpow_neg, mul_assoc,
        mul_inv_cancel_left₀ (zpow_ne_zero _ hϖ0), mul_comm]
  choose c d hc hd heq using fun l ↦ hterm (f l) (g l) (hgS l)
  exact ⟨n, c, d, hc, hd, Finset.sum_congr rfl fun l _ ↦ heq l⟩

/-- **Approximation of finite combinations.** If every integral element of `D` is approximated
to precision `γ ^ N` by a combination of lifted Frobenius monomials with coefficients in
`K₀ ≤ S`, and the powers of `γ` are cofinal near `0`, then every combination `∑ c l * d l` with
`c l ∈ S` and `d l ∈ D` integral is approximated to any precision by combinations with
coefficients in `S`. -/
theorem exists_valuation_sub_frobeniusComb_lt_of_sum {S K₀ D : Subfield Ω} (hK₀S : K₀ ≤ S)
    {ι : Type*} {p : ℕ} {w : ι → Ω} {γ : Γ₀}
    (hprec : ∀ t : Ω, t ≠ 0 → ∃ N : ℕ, γ ^ N < v t)
    (happrox : ∀ d ∈ D, v d ≤ 1 → ∀ N : ℕ, ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ K₀) ∧
      v (d - frobeniusComb p w e) ≤ γ ^ N)
    {n : ℕ} {c d : Fin n → Ω} (hc : ∀ l, c l ∈ S) (hd : ∀ l, d l ∈ D ∧ v (d l) ≤ 1) {t : Ω}
    (ht : t ≠ 0) :
    ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ S) ∧
      v (∑ l, c l * d l - frobeniusComb p w e) < v t := by
  have hvt : 0 < v t := zero_lt_iff.2 ((v.ne_zero_iff).2 ht)
  have hterm (l : Fin n) : ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ K₀) ∧
      v (c l * (d l - frobeniusComb p w e)) < v t := by
    by_cases hcl : c l = 0
    · exact ⟨0, fun _ ↦ K₀.zero_mem, by rwa [hcl, zero_mul, map_zero]⟩
    obtain ⟨N, hN⟩ := hprec _ (div_ne_zero ht hcl)
    obtain ⟨e, heK, he⟩ := happrox _ (hd l).1 (hd l).2 N
    refine ⟨e, heK, ?_⟩
    have hcpos : 0 < v (c l) := zero_lt_iff.2 ((v.ne_zero_iff).2 hcl)
    calc v (c l * (d l - frobeniusComb p w e)) ≤ v (c l) * γ ^ N := by
          rw [map_mul]
          gcongr
      _ < v (c l) * v (t / c l) := mul_lt_mul_of_pos_left hN hcpos
      _ = v t := by rw [map_div₀, mul_div_cancel₀ _ hcpos.ne']
  choose e heK he using hterm
  refine ⟨∑ l, c l • e l, fun j ↦ ?_, ?_⟩
  · rw [Finsupp.finsetSum_apply]
    exact S.sum_mem fun l _ ↦ S.mul_mem (hc l) (hK₀S (heK l j))
  · rw [frobeniusComb_sum, ← Finset.sum_sub_distrib]
    refine v.map_sum_lt hvt.ne' fun l _ ↦ ?_
    rw [frobeniusComb_smul, ← mul_sub]
    exact he l

/-- **Approximation in the field generated by `S` and `D`.** Combination of
`Valuation.exists_eq_sum_mul_of_mem_closure` and
`Valuation.exists_valuation_sub_frobeniusComb_lt_of_sum`. -/
theorem exists_valuation_sub_frobeniusComb_lt_of_mem_closure {S K₀ D : Subfield Ω}
    (hK₀S : K₀ ≤ S) (hSalg : ∀ c ∈ S, IsAlgebraic D c) {ϖ : Ω} (hϖS : ϖ ∈ S) (hϖD : ϖ ∈ D)
    (hϖ0 : ϖ ≠ 0) (hdisc : ∀ z ∈ D, z ≠ 0 → ∃ m : ℤ, v z = v ϖ ^ m)
    {ι : Type*} {p : ℕ} {w : ι → Ω} {γ : Γ₀}
    (hprec : ∀ t : Ω, t ≠ 0 → ∃ N : ℕ, γ ^ N < v t)
    (happrox : ∀ d ∈ D, v d ≤ 1 → ∀ N : ℕ, ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ K₀) ∧
      v (d - frobeniusComb p w e) ≤ γ ^ N)
    {y : Ω} (hy : y ∈ Subfield.closure ((S : Set Ω) ∪ D)) {t : Ω} (ht : t ≠ 0) :
    ∃ e : Option (ι × ℕ) →₀ Ω, (∀ j, e j ∈ S) ∧ v (y - frobeniusComb p w e) < v t := by
  obtain ⟨n, c, d, hc, hd, rfl⟩ := exists_eq_sum_mul_of_mem_closure hSalg hϖS hϖD hϖ0 hdisc hy
  exact exists_valuation_sub_frobeniusComb_lt_of_sum hK₀S hprec happrox hc hd ht

end Valuation
