set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Étale coordinates adapted to a complete intersection

Let `A` be a smooth `R`-algebra whose Kähler differentials have constant rank `n`, and let
`I = (f₁, …, f_c)` be an ideal of `A` such that `B = A ⧸ I` is smooth over `R` with Kähler
differentials of constant rank `m`, where `m + c = n`. Then near every prime `p ⊇ I` of `A`
there are `g₁, …, g_m : A` such that `R[t₁, …, t_c, s₁, …, s_m] → A[1/a]`, `t ↦ f`, `s ↦ g`,
is étale for some `a ∉ p`.

The proof follows the conormal sequence `I/I² → B ⊗[A] Ω[A⁄R] → Ω[B⁄R] → 0`: choosing the
`g` so that the `d gbⱼ` form a basis of `Ω[B⁄R]` at `p`, the differentials `d fᵢ, d gⱼ` span
`Ω[A⁄R]` at `p`, hence form a basis there (both sides being free of rank `n`), hence after
inverting some `a ∉ p`. One concludes by the étaleness criterion
`MvPolynomial.etale_aeval_of_basis_kaehlerDifferential`.

## Main results

- `KaehlerDifferential.ker_map_le_of_surjective`: for a surjection `A → B` with kernel `I`, the
  kernel of `Ω[A⁄R] → Ω[B⁄R]` is contained in `A • d(I) + I • Ω[A⁄R]`.
- `Algebra.exists_etale_aeval_sumElim_of_ker`: the étale coordinates described above.
-/

@[expose] public section

open KaehlerDifferential TensorProduct

namespace KaehlerDifferential

variable {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
  [Algebra A B] [IsScalarTower R A B]

/-- For a surjection `A → B` with kernel `I`, the kernel of `Ω[A⁄R] → Ω[B⁄R]` is contained in
`A • d(I) + I • Ω[A⁄R]`. -/
theorem ker_map_le_of_surjective (h : Function.Surjective (algebraMap A B)) :
    LinearMap.ker (map R R A B) ≤
      Submodule.span A (D R A '' (RingHom.ker (algebraMap A B) : Set A)) ⊔
        RingHom.ker (algebraMap A B) • ⊤ := by
  intro x hx
  set I := RingHom.ker (algebraMap A B)
  have h₁ : (1 : B) ⊗ₜ[A] x ∈ LinearMap.ker (mapBaseChange R A B) := by
    rw [LinearMap.mem_ker, mapBaseChange_tmul, one_smul]
    exact hx
  obtain ⟨z, hz⟩ := (exact_kerCotangentToTensor_mapBaseChange R A B h _).mp h₁
  obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective _ z
  rw [kerCotangentToTensor_toCotangent] at hz
  have h₂ : (1 : B) ⊗ₜ[A] (x - D R A y) = 0 := by rw [TensorProduct.tmul_sub, hz, sub_self]
  let e₀ : (A ⧸ I) ≃ₐ[A] B := Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId A B) h
  let e : B ≃ₗ[A] A ⧸ I := e₀.symm.toLinearEquiv
  have h₄ : e.toLinearMap.rTensor Ω[A⁄R] ((1 : B) ⊗ₜ[A] (x - D R A y)) =
      (1 : A ⧸ I) ⊗ₜ (x - D R A y) := by
    rw [LinearMap.rTensor_tmul]
    congr 1
    exact map_one e₀.symm
  have h₃ : Submodule.Quotient.mk (p := I • (⊤ : Submodule A Ω[A⁄R])) (x - D R A y) = 0 := by
    rw [← TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul, ← h₄, h₂, map_zero, map_zero]
  rw [Submodule.Quotient.mk_eq_zero] at h₃
  rw [show x = D R A y + (x - D R A y) by abel]
  exact Submodule.add_mem_sup (Submodule.subset_span ⟨y, y.2, rfl⟩) h₃

/-- The differentials of the elements of the ideal generated by a family `f` lie in the span of
the `d fᵢ` up to `(f) • Ω[A⁄R]`. -/
theorem span_D_image_span_le {ι : Type*} (f : ι → A) :
    Submodule.span A (D R A '' (Ideal.span (Set.range f) : Set A)) ≤
      Submodule.span A (Set.range (D R A ∘ f)) ⊔ Ideal.span (Set.range f) • ⊤ := by
  rw [Submodule.span_le]
  rintro _ ⟨y, hy, rfl⟩
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    exact Submodule.mem_sup_left (Submodule.subset_span ⟨i, rfl⟩)
  | zero => simp
  | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
  | smul a y hy hy' =>
    rw [smul_eq_mul, Derivation.leibniz]
    exact add_mem (Submodule.smul_mem _ a hy')
      (Submodule.mem_sup_right (Submodule.smul_mem_smul hy trivial))

end KaehlerDifferential

namespace IsLocalizedModule

variable {R M M' : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup M']
  [Module R M'] (S : Submonoid R) (Rₛ : Type*) [CommRing Rₛ] [Algebra R Rₛ]
  [IsLocalization S Rₛ] [Module Rₛ M'] [IsScalarTower R Rₛ M'] (f : M →ₗ[R] M')
  [IsLocalizedModule S f]

/-- If the image of a subset `s` of a finite module `M` spans a localization of `M` at `S`, then
some `t ∈ S` multiplies `M` into the span of `s`. -/
theorem exists_smul_mem_span_of_span_eq_top [Module.Finite R M] (s : Set M)
    (hs : Submodule.span Rₛ (f '' s) = ⊤) :
    ∃ t ∈ S, ∀ x : M, t • x ∈ Submodule.span R s := by
  classical
  have key : ∀ x : M, ∃ t ∈ S, t • x ∈ Submodule.span R s := by
    intro x
    have hx : f x ∈ (Submodule.span R s).localized' Rₛ S f := by
      rw [Submodule.localized'_span, hs]
      trivial
    obtain ⟨y, hy, u, hyu⟩ := (Submodule.mem_localized' _ _ _ _ _).mp hx
    rw [mk'_eq_iff, Submonoid.smul_def, ← map_smul] at hyu
    obtain ⟨c, hc⟩ := exists_of_eq (S := S) hyu
    refine ⟨c * u, mul_mem c.2 u.2, ?_⟩
    rw [mul_smul, ← Submonoid.smul_def c, ← hc, Submonoid.smul_def]
    exact Submodule.smul_mem _ _ hy
  obtain ⟨G, hG⟩ := Module.Finite.fg_top (R := R) (M := M)
  choose t ht hts using key
  refine ⟨∏ g ∈ G, t g, prod_mem fun g _ ↦ ht g, fun x ↦ ?_⟩
  have hx : x ∈ Submodule.span R (G : Set M) := hG ▸ trivial
  induction hx using Submodule.span_induction with
  | mem g hg =>
    rw [← Finset.prod_erase_mul _ _ (Finset.mem_coe.mp hg), mul_smul]
    exact Submodule.smul_mem _ _ (hts g)
  | zero => simp
  | add y z _ _ hy hz => rw [smul_add]; exact add_mem hy hz
  | smul a y _ hy => rw [smul_comm]; exact Submodule.smul_mem _ a hy

end IsLocalizedModule

namespace Algebra

variable {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
  [Algebra A B] [IsScalarTower R A B]

/-- **Étale coordinates adapted to a complete intersection.** Let `A` be smooth over `R` with
Kähler differentials of constant rank `n`, and let `A → B` be surjective with kernel generated
by `f₁, …, f_c`, where `B` is smooth over `R` with Kähler differentials of constant rank `m` and
`m + c = n`. Then for every prime `p` of `A` containing the kernel there are `a ∉ p` and
`g₁, …, g_m : A` such that `R[t₁, …, t_c, s₁, …, s_m] → A[1/a]`, `t ↦ f`, `s ↦ g`, is étale. -/
theorem exists_etale_aeval_sumElim_of_ker [Smooth R A] [Smooth R B]
    (h : Function.Surjective (algebraMap A B)) {c m n : ℕ} (f : Fin c → A)
    (hf : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B))
    (hA : ∀ P, Module.rankAtStalk (R := A) Ω[A⁄R] P = n)
    (hB : ∀ Q, Module.rankAtStalk (R := B) Ω[B⁄R] Q = m)
    (hmn : m + c = n) (p : Ideal A) [p.IsPrime] (hp : RingHom.ker (algebraMap A B) ≤ p) :
    ∃ (a : A) (g : Fin m → A), a ∉ p ∧
      (MvPolynomial.aeval (algebraMap A (Localization.Away a) ∘ Sum.elim f g) :
          MvPolynomial (Fin c ⊕ Fin m) R →ₐ[R] Localization.Away a).toRingHom.Etale := by
  classical
  set I := RingHom.ker (algebraMap A B)
  set q : Ideal B := p.map (algebraMap A B)
  have hq : q.IsPrime := Ideal.map_isPrime_of_surjective h hp
  -- a basis `d gbⱼ` of `Ω[B⁄R]` at `q`
  let Bq := Localization.AtPrime q
  let lB := LocalizedModule.mkLinearMap q.primeCompl Ω[B⁄R]
  have hspanB : Submodule.span Bq (Set.range fun b : B ↦ lB (D R B b)) = ⊤ := by
    have := span_eq_top_of_isLocalizedModule Bq q.primeCompl lB (span_range_derivation R B)
    rwa [← Set.range_comp] at this
  obtain ⟨κ, gb, bB, hbB⟩ := Module.exists_basis_of_span_of_flat _ hspanB
  have : Finite κ := Module.Finite.finite_basis bB
  let := Fintype.ofFinite κ
  have hκ : Fintype.card κ = m := by
    rw [← hB ⟨q, hq⟩, ← Module.finrank_eq_card_basis bB]
    rfl
  let eκ : Fin m ≃ κ := (Fintype.equivFinOfCardEq hκ).symm
  let g₀ : Fin m → B := gb ∘ eκ
  have hspan₀ : Submodule.span Bq (lB '' Set.range (D R B ∘ g₀)) = ⊤ := by
    rw [← bB.span_eq, ← Set.range_comp]
    congr 1
    ext ω
    simp only [Set.mem_range, Function.comp_apply, hbB, g₀]
    exact ⟨fun ⟨j, hj⟩ ↦ ⟨eκ j, hj⟩, fun ⟨j, hj⟩ ↦ ⟨eκ.symm j, by simpa using hj⟩⟩
  obtain ⟨t, htq, ht⟩ :=
    IsLocalizedModule.exists_smul_mem_span_of_span_eq_top q.primeCompl Bq lB _ hspan₀
  -- lift to `A`
  let σ := Function.surjInv h
  have hσ : ∀ b, algebraMap A B (σ b) = b := Function.surjInv_eq h
  let g : Fin m → A := σ ∘ g₀
  let t' := σ t
  have ht'p : t' ∉ p := fun ht' ↦ htq (by rw [← hσ t]; exact Ideal.mem_map_of_mem _ ht')
  let u : Fin c ⊕ Fin m → A := Sum.elim f g
  let N := Submodule.span A (Set.range (D R A ∘ u))
  -- the `d fᵢ, d gⱼ` span `Ω[A⁄R]` modulo `p` after multiplying by `t'`
  have hN : ∀ ω : Ω[A⁄R], t' • ω ∈ N ⊔ p • ⊤ := by
    intro ω
    have h₁ : map R R A B (t' • ω) ∈ Submodule.span B (Set.range (D R B ∘ g₀)) := by
      rw [LinearMap.map_smul, ← algebraMap_smul B, hσ]
      exact ht _
    obtain ⟨cB, hcB⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp h₁
    have h₂ : t' • ω - ∑ j, σ (cB j) • D R A (g j) ∈ LinearMap.ker (map R R A B) := by
      rw [LinearMap.mem_ker, map_sub, map_sum, ← hcB, sub_eq_zero]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [LinearMap.map_smul, map_D, ← algebraMap_smul B (σ (cB j)), hσ]
      simp [g, hσ]
    have h₃ : _ ∈ Submodule.span A (D R A '' (I : Set A)) ⊔ I • ⊤ :=
      ker_map_le_of_surjective h h₂
    rw [← hf] at h₃
    have hfp : Ideal.span (Set.range f) ≤ p := by rw [hf]; exact hp
    have h₄ : Submodule.span A (D R A '' (Ideal.span (Set.range f) : Set A)) ⊔
        Ideal.span (Set.range f) • ⊤ ≤ N ⊔ p • ⊤ := by
      have h₅ : Ideal.span (Set.range f) • (⊤ : Submodule A Ω[A⁄R]) ≤ N ⊔ p • ⊤ :=
        le_sup_of_le_right (Submodule.smul_mono_left hfp)
      refine sup_le ((span_D_image_span_le (R := R) f).trans (sup_le ?_ h₅)) h₅
      exact le_sup_of_le_left
        (Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨Sum.inl i, rfl⟩))
    rw [show t' • ω = (t' • ω - ∑ j, σ (cB j) • D R A (g j)) + ∑ j, σ (cB j) • D R A (g j)
      by abel]
    refine add_mem (h₄ h₃) (Submodule.mem_sup_left (sum_mem fun j _ ↦ ?_))
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inr j, rfl⟩)
  -- the `d fᵢ, d gⱼ` form a basis of `Ω[A⁄R]` at `p`
  let Ap := Localization.AtPrime p
  let e : (Fin c ⊕ Fin m →₀ A) →ₗ[A] Ω[A⁄R] := Finsupp.linearCombination A (D R A ∘ u)
  let l₁ : (Fin c ⊕ Fin m →₀ A) →ₗ[A] (Fin c ⊕ Fin m →₀ Ap) :=
    Finsupp.mapRange.linearMap (Algebra.linearMap A Ap)
  let l₂ := LocalizedModule.mkLinearMap p.primeCompl Ω[A⁄R]
  let eₚ := IsLocalizedModule.mapExtendScalars p.primeCompl l₁ l₂ Ap e
  have he : ∀ x, eₚ (l₁ x) = l₂ (e x) := fun x ↦
    IsLocalizedModule.map_apply p.primeCompl l₁ l₂ e x
  have hsurj : Function.Surjective eₚ := by
    refine LinearMap.range_eq_top.mp (top_unique ?_)
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal Ap)
      Module.Finite.fg_top (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
    have hspanA : Submodule.span Ap (l₂ '' Set.univ) = ⊤ :=
      span_eq_top_of_isLocalizedModule Ap p.primeCompl l₂ Submodule.span_univ
    rw [← hspanA, Submodule.span_le]
    rintro _ ⟨ω, -, rfl⟩
    have hle : N ⊔ p • ⊤ ≤ ((LinearMap.range eₚ ⊔ IsLocalRing.maximalIdeal Ap • ⊤).restrictScalars
        A).comap l₂ := by
      refine sup_le ?_ (Submodule.smul_le.mpr fun r hr ω' _ ↦ ?_)
      · rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        refine Submodule.mem_sup_left ⟨l₁ (Finsupp.single i 1), ?_⟩
        rw [he]
        simp [e]
      · simp only [Submodule.mem_comap, Submodule.restrictScalars_mem]
        rw [map_smul, ← algebraMap_smul Ap r (l₂ ω')]
        refine Submodule.mem_sup_right (Submodule.smul_mem_smul ?_ Submodule.mem_top)
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Ap p r).mpr hr
    have h₁ : algebraMap A Ap t' • l₂ ω ∈
        LinearMap.range eₚ ⊔ IsLocalRing.maximalIdeal Ap • ⊤ := by
      rw [algebraMap_smul, ← map_smul]
      exact hle (hN ω)
    have hu : IsUnit (algebraMap A Ap t') :=
      IsLocalization.map_units Ap (⟨t', ht'p⟩ : p.primeCompl)
    have := Submodule.smul_mem _ (hu.unit⁻¹ : Apˣ).1 h₁
    rw [smul_smul, hu.val_inv_mul, one_smul] at this
    rw [SetLike.mem_coe, hspanA]
    exact this
  have : Module.Free Ap (LocalizedModule p.primeCompl Ω[A⁄R]) :=
    Module.free_of_flat_of_isLocalRing
  have hrank : Module.finrank Ap (Fin c ⊕ Fin m →₀ Ap) =
      Module.finrank Ap (LocalizedModule p.primeCompl Ω[A⁄R]) := by
    rw [Module.finrank_finsupp_self, Fintype.card_sum, Fintype.card_fin, Fintype.card_fin,
      add_comm, hmn, ← hA ⟨p, inferInstance⟩]
    rfl
  have hinj : Function.Injective eₚ :=
    OrzechProperty.injective_of_surjective_of_injective
      (LinearEquiv.ofFinrankEq _ _ hrank).toLinearMap eₚ (LinearEquiv.injective _) hsurj
  have hbij : Function.Bijective (IsLocalizedModule.map p.primeCompl l₁ l₂ e) := ⟨hinj, hsurj⟩
  -- spread out to a basic open
  obtain ⟨a, ha, hbij'⟩ := Module.FinitePresentation.exists_notMem_bijective e p l₁ l₂ hbij
  let T := Localization.Away a
  let l₁ₜ : (Fin c ⊕ Fin m →₀ A) →ₗ[A] (Fin c ⊕ Fin m →₀ T) :=
    Finsupp.mapRange.linearMap (Algebra.linearMap A T)
  let l₂ₜ : Ω[A⁄R] →ₗ[A] Ω[T⁄R] := map R R A T
  rw [← IsLocalizedModule.map_bijective_iff_localizedModuleMap_bijective l₁ₜ l₂ₜ] at hbij'
  let eₜ := IsLocalizedModule.mapExtendScalars (Submonoid.powers a) l₁ₜ l₂ₜ T e
  let bT : Module.Basis (Fin c ⊕ Fin m) T Ω[T⁄R] := .ofRepr (LinearEquiv.ofBijective eₜ hbij').symm
  have hbT : ∀ i, bT i = D R T ((algebraMap A T ∘ u) i) := by
    intro i
    simp +zetaDelta [IsLocalizedModule.map_linearCombination]
  have : FormallySmooth R T := .comp R A T
  have : FinitePresentation R T := .trans R A T
  exact ⟨a, g, ha, MvPolynomial.etale_aeval_of_basis_kaehlerDifferential _ bT hbT⟩

end Algebra
