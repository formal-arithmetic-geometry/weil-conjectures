section FinitePresentation

open TensorProduct

variable {A}


/-- **Étale algebras spread out to a finitely generated subring.** An étale `A`-algebra `B` is
the base change of an étale algebra over the subring `A₀ ⊆ A` generated by a finite set: `B`
has a submersive presentation with as many relations as variables, whose Jacobian `J` is a unit
in `B`. Choosing a lift `g` of its inverse and an expression `J g - 1 = ∑ cⱼ fⱼ` in terms of the
relations, the coefficients of the `fⱼ`, `g` and `cⱼ` generate `A₀`, and the lifted presentation
over `A₀` is again submersive. -/
theorem exists_finset_algEquiv_tensorProduct_of_etale (B : Type u) [CommRing B] [Algebra A B]
    [Algebra.Etale A B] :
    ∃ (F : Finset A) (B₀ : Type u) (_ : CommRing B₀)
      (_ : Algebra (Algebra.adjoin ℤ (F : Set A)) B₀),
      Algebra.Etale (Algebra.adjoin ℤ (F : Set A)) B₀ ∧
        Nonempty (A ⊗[Algebra.adjoin ℤ (F : Set A)] B₀ ≃ₐ[A] B) := by
  classical
  obtain ⟨ι, σ, _, _, P, hP⟩ :=
    (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.1 ‹_›).out
  have : Fintype σ := Fintype.ofFinite σ
  have : Fintype ι := Fintype.ofFinite ι
  -- an inverse of the Jacobian modulo the relations
  obtain ⟨u, hu⟩ := P.jacobian_isUnit.exists_right_inv
  obtain ⟨g, rfl⟩ := P.algebraMap_surjective u
  have hJ : P.jacobiMatrix.det * g - 1 ∈ P.ker := by
    rw [Algebra.Generators.ker, RingHom.mem_ker, map_sub, map_mul, map_one]
    erw [← P.jacobian_eq_jacobiMatrix_det]
    erw [hu]
    rw [sub_self]
  rw [← P.span_range_relation_eq_ker] at hJ
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hJ
  let F : Finset A := (Finset.univ.biUnion fun j ↦ (P.relation j).coeffs) ∪ g.coeffs ∪
    (Finset.univ.biUnion fun j ↦ (c j).coeffs)
  let R₀ := Algebra.adjoin ℤ (F : Set A)
  have hR {a : A} (ha : a ∈ F) : a ∈ R₀ := Algebra.subset_adjoin (Finset.mem_coe.2 ha)
  have hinj : Function.Injective R₀.val.toRingHom := Subtype.val_injective
  have hliftMv (x : MvPolynomial ι A) (hx : ∀ a ∈ x.coeffs, a ∈ F) :
      x ∈ Set.range (MvPolynomial.map R₀.val.toRingHom) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro a ha
    exact ⟨⟨a, hR (hx a ha)⟩, rfl⟩
  choose v hv using fun j ↦ hliftMv (P.relation j) fun a ha ↦ Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_biUnion.2 ⟨j, Finset.mem_univ _, ha⟩))
  choose d hd using fun j ↦ hliftMv (c j) fun a ha ↦ Finset.mem_union_right _
    (Finset.mem_biUnion.2 ⟨j, Finset.mem_univ _, ha⟩)
  obtain ⟨g₀, hg₀⟩ := hliftMv g fun a ha ↦ Finset.mem_union_left _ (Finset.mem_union_right _ ha)
  let B₀ := MvPolynomial ι R₀ ⧸ Ideal.span (Set.range v)
  let Q₀ : Algebra.Presentation R₀ B₀ ι σ := Algebra.Presentation.naive (v := v)
  let Q : Algebra.PreSubmersivePresentation R₀ B₀ ι σ :=
    { toPresentation := Q₀
      map := P.map
      map_inj := P.map_inj }
  -- the Jacobian of the lifted presentation lifts that of `P`
  have hjac : MvPolynomial.map R₀.val.toRingHom Q.jacobiMatrix.det = P.jacobiMatrix.det := by
    rw [RingHom.map_det]
    congr 1
    refine Matrix.ext fun i j ↦ ?_
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply,
      Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    rw [← MvPolynomial.pderiv_map]
    change MvPolynomial.pderiv (P.map i) (MvPolynomial.map _ (v j)) = _
    rw [hv j]
  have heq : Q.jacobiMatrix.det * g₀ - 1 = ∑ j, d j * v j := by
    apply MvPolynomial.map_injective _ hinj
    rw [map_sub, map_mul, map_one, hjac, hg₀, ← hc, map_sum]
    simp only [map_mul, hd, hv]
  have hunit : IsUnit Q.jacobian := by
    refine isUnit_iff_exists_inv.2 ⟨algebraMap Q.Ring B₀ g₀, ?_⟩
    rw [Q.jacobian_eq_jacobiMatrix_det, ← map_mul, ← sub_eq_zero, ← map_one (algebraMap Q.Ring B₀),
      ← map_sub, heq]
    change Ideal.Quotient.mk _ _ = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  let Qs : Algebra.SubmersivePresentation R₀ B₀ ι σ := { Q with jacobian_isUnit := hunit }
  refine ⟨F, B₀, inferInstance, inferInstance, ?_, ⟨?_⟩⟩
  · have : Algebra.IsStandardSmoothOfRelativeDimension 0 R₀ B₀ :=
      Qs.isStandardSmoothOfRelativeDimension (by rw [← hP]; rfl)
    exact Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.2 this
  · have hker : (Q₀.baseChange A).ker = P.ker := by
      rw [← (Q₀.baseChange A).span_range_relation_eq_ker, ← P.span_range_relation_eq_ker]
      congr 1
      ext y
      simp only [Set.mem_range, Algebra.Presentation.baseChange_relation, Q₀,
        Algebra.Presentation.naive_relation]
      constructor
      · rintro ⟨j, rfl⟩
        exact ⟨j, (hv j).symm⟩
      · rintro ⟨j, rfl⟩
        exact ⟨j, hv j⟩
    exact (Q₀.baseChange A).quotientEquiv.symm.restrictScalars A |>.trans
      ((Ideal.quotientEquivAlgOfEq A hker).trans (P.quotientEquiv.restrictScalars A))


end FinitePresentation

end AlgebraicGeometry
