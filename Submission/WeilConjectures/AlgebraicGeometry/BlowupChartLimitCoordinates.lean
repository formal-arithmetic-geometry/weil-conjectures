set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Étale coordinates of a smooth surface at a rational point

Let `S` be a smooth surface over an algebraically closed field `k`, `t` a `k`-point of `S` and
`R = 𝒪^{sh}_{S,t}` the strict henselization. There is an affine pointed étale neighbourhood
`V = Spec A` of `t` and an étale map `g : k[X₀, X₁] → A` (étale coordinates centred at `t`) such
that the maximal ideal of `R` is generated by the images `x₀, y₀` of `g(X₀), g(X₁)`
(`AlgebraicGeometry.Scheme.exists_etaleCoordinates_strictHenselization`).
-/

@[expose] public section

universe u

open CategoryTheory Limits IsLocalRing MvPolynomial

namespace AlgebraicGeometry.Scheme

variable {k : Type u} [Field k] (S : Over (Spec (.of k))) (t : Spec (.of k) ⟶ S.left)

/-- **Étale coordinates on an affine open chart.** A smooth surface over `k` has, near a
`k`-point `t`, an affine open chart `Spec R₀ ⊆ S` through which `t` factors, with an étale map
`g : k[X₀, X₁] → R₀` compatible with the structure morphisms to `Spec k`. -/
theorem exists_affine_chart_etale_mvPolynomial [SmoothOfRelativeDimension 2 S.hom] :
    ∃ (R₀ : CommRingCat.{u}) (i : Spec R₀ ⟶ S.left) (_ : IsOpenImmersion i)
      (xR : Spec (.of k) ⟶ Spec R₀) (g : CommRingCat.of (MvPolynomial (Fin 2) k) ⟶ R₀),
      xR ≫ i = t ∧ g.hom.Etale ∧ Spec.map (CommRingCat.ofHom (g.hom.comp C)) = i ≫ S.hom := by
  obtain ⟨U, hU, V, hV, hxV, e, hsm⟩ :=
    (inferInstance : SmoothOfRelativeDimension 2 S.hom).exists_isStandardSmoothOfRelativeDimension
      (t (IsLocalRing.closedPoint k))
  obtain rfl : U = ⊤ := by
    ext z
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    rw [Subsingleton.elim z (S.hom (t (IsLocalRing.closedPoint k)))]
    exact e hxV
  obtain ⟨g₀, hg₀C, hg₀⟩ := hsm.exists_etale_mvPolynomial
  let ε : CommRingCat.of k ≅ Γ(Spec (.of k), ⊤) := (Scheme.ΓSpecIso (.of k)).symm
  let εe : k ≃+* Γ(Spec (.of k), ⊤) := ε.commRingCatIsoToRingEquiv
  let g : CommRingCat.of (MvPolynomial (Fin 2) k) ⟶ Γ(S.left, V) :=
    CommRingCat.ofHom (g₀.comp (MvPolynomial.map ε.hom.hom))
  have hgC : g.hom.comp C = (S.hom.appLE ⊤ V e).hom.comp ε.hom.hom := by
    ext r
    simp [g, ← hg₀C]
  refine ⟨Γ(S.left, V), hV.fromSpec, inferInstance,
    IsOpenImmersion.lift hV.fromSpec t ?_, g, IsOpenImmersion.lift_fac _ _ _, ?_, ?_⟩
  · rintro _ ⟨z, rfl⟩
    rw [hV.range_fromSpec, Subsingleton.elim z (IsLocalRing.closedPoint k)]
    exact hxV
  · have hb : Function.Bijective (MvPolynomial.map (σ := Fin 2) ε.hom.hom) :=
      (MvPolynomial.mapEquiv (Fin 2) εe).bijective
    exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hb) hg₀
  · rw [hgC, ← IsAffineOpen.SpecMap_appLE_fromSpec S.hom (isAffineOpen_top _) hV e,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
    rw [← Spec.map_comp]
    rfl

/-- The ideal of the origin of the plane: the kernel of the constant coefficient map
`k[X₀, X₁] → k` is `(X₀, X₁)`. -/
lemma ker_constantCoeff_fin_two {k : Type u} [Field k] :
    RingHom.ker (constantCoeff : MvPolynomial (Fin 2) k →+* k) = Ideal.span {X 0, X 1} := by
  classical
  ext p
  have hs : ({X 0, X 1} : Set (MvPolynomial (Fin 2) k)) = X '' Set.univ := by
    ext q
    simp [Fin.exists_fin_two, eq_comm]
  rw [RingHom.mem_ker, hs, mem_ideal_span_X_image]
  constructor
  · intro h m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (mem_support_iff.mp hm) (by simpa [constantCoeff] using h)
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, hi⟩
  · intro h
    by_contra h'
    have : (0 : Fin 2 →₀ ℕ) ∈ p.support := by
      rw [mem_support_iff]
      simpa [constantCoeff] using h'
    obtain ⟨i, -, hi⟩ := h 0 this
    exact hi rfl

/-- **Étale coordinates generate the maximal ideal.** Let `g : k[X₀, X₁] → A` be étale and
`φ : A → k` a `k`-point lying over the origin (`φ ∘ g` is the constant coefficient map). If
`ρ : A → R` is a ring map to a local ring carrying the ideal of the point onto the maximal ideal,
then the maximal ideal of `R` is generated by `ρ(g(X₀))` and `ρ(g(X₁))`. -/
theorem maximalIdeal_eq_span_of_etale {k : Type u} [Field k] {A R : Type u} [CommRing A]
    [CommRing R] [IsLocalRing R] (g : MvPolynomial (Fin 2) k →+* A) (hg : g.Etale)
    (φ : A →+* k) (hφ : φ.comp g = constantCoeff) (ρ : A →+* R)
    (hρ : (RingHom.ker φ).map ρ = maximalIdeal R) :
    maximalIdeal R = Ideal.span {ρ (g (X 0)), ρ (g (X 1))} := by
  classical
  algebraize [g]
  set q := RingHom.ker φ
  have hφs : Function.Surjective φ := fun r ↦ ⟨g (C r), by simpa using congr($hφ (C r))⟩
  have hqmax : q.IsMaximal := RingHom.ker_isMaximal_of_surjective φ hφs
  let p := q.under (MvPolynomial (Fin 2) k)
  have hp : p = Ideal.span {X 0, X 1} := by
    rw [← ker_constantCoeff_fin_two, ← hφ]
    rfl
  let := Localization.AtPrime.algebraOfLiesOver p q
  have : Algebra.FormallyUnramified (MvPolynomial (Fin 2) k) (Localization.AtPrime q) :=
    Algebra.FormallyUnramified.comp _ A _
  have h := ((Algebra.isUnramifiedAt_iff_map_eq (MvPolynomial (Fin 2) k) p q).mp this).2
  have hcomap : (maximalIdeal R).comap ρ = q := by
    refine (hqmax.eq_of_le (Ideal.IsPrime.ne_top inferInstance) ?_).symm
    rw [← hρ]
    exact Ideal.le_comap_map
  let ρ' : Localization.AtPrime q →+* R := IsLocalization.lift (M := q.primeCompl)
    (S := Localization.AtPrime q) (g := ρ) (fun s ↦ by
      have : ρ s ∉ maximalIdeal R := fun h ↦ s.2 (by
        have h' : (s : A) ∈ (maximalIdeal R).comap ρ := h
        rwa [hcomap] at h')
      exact IsLocalRing.notMem_maximalIdeal.mp this)
  have hρ' : ρ'.comp (algebraMap A _) = ρ := IsLocalization.lift_comp _
  calc maximalIdeal R = q.map ρ := hρ.symm
    _ = (q.map (algebraMap A (Localization.AtPrime q))).map ρ' := by rw [Ideal.map_map, hρ']
    _ = (maximalIdeal _).map ρ' := by rw [Localization.AtPrime.map_eq_maximalIdeal]
    _ = (p.map (algebraMap (MvPolynomial (Fin 2) k) (Localization.AtPrime q))).map ρ' := by
      rw [h]
    _ = p.map (ρ.comp g) := by
      rw [Ideal.map_map, IsScalarTower.algebraMap_eq (MvPolynomial (Fin 2) k) A
        (Localization.AtPrime q), ← RingHom.comp_assoc, hρ']
      rfl
    _ = Ideal.span {ρ (g (X 0)), ρ (g (X 1))} := by
      rw [hp, Ideal.map_span, Set.image_pair]
      rfl

/-- The chart lemma `strictHenselization_chart_maximalIdeal`, for a geometric point `t` given
together with a factorization `t = xR ≫ i` through an affine open chart. -/
lemma strictHenselization_chart_maximalIdeal' {X : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsAlgClosed Ω] (R : CommRingCat.{u}) (i : Spec R ⟶ X) [IsOpenImmersion i]
    (xR : Spec (.of Ω) ⟶ Spec R) (s : Spec (.of Ω) ⟶ X) (hs : xR ≫ i = s) :
    ∃ (_ : IsLocalRing (strictHenselization s)) (ρ : R ⟶ strictHenselization s),
      Spec.map ρ ≫ i = strictLocalizationToBase s ∧
      IsLocalRing.maximalIdeal (strictHenselization s) =
        (xR (IsLocalRing.closedPoint Ω)).asIdeal.map ρ.hom := by
  subst hs
  exact strictHenselization_chart_maximalIdeal R i xR

/-- The transition maps of the ring diagram `strictHenselizationAffineDiagram` defining the strict
henselization are étale. -/
lemma etale_strictHenselizationAffineDiagram_map {X : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ X)
    {i j : (SmallModel.{u} (strictHenselizationNeighbourhoods s))ᵒᵖ}
    (f : i ⟶ j) : ((strictHenselizationAffineDiagram s).map f).hom.Etale := by
  let g := ((AffineEtale.Spec X).map
    ((equivSmallModel.{u} (strictHenselizationNeighbourhoods s)).inverse.map f.unop).1).left
  have hg : Etale g := inferInstance
  have : IsAffine ((AffineEtale.Spec X).obj
      ((equivSmallModel.{u} (strictHenselizationNeighbourhoods s)).inverse.obj j.unop).1).left :=
    inferInstanceAs (IsAffine (Spec _))
  have : IsAffine ((AffineEtale.Spec X).obj
      ((equivSmallModel.{u} (strictHenselizationNeighbourhoods s)).inverse.obj i.unop).1).left :=
    inferInstanceAs (IsAffine (Spec _))
  exact HasRingHomProperty.appTop (P := @Etale) g hg

variable [IsAlgClosed k]

/-- **Étale coordinates of a smooth surface at a rational point generate the maximal ideal of
the strict henselization.** For a smooth surface `S` over `k` and a `k`-point `t`, there is an
affine pointed étale neighbourhood `j₀` of `t`, with coordinate ring `A = D(j₀)`, and an étale map
`g : k[X₀, X₁] → A` compatible with the `k`-algebra structure of `R = 𝒪^{sh}_{S,t}`, such that
the maximal ideal of `R` is generated by the images of `g(X₀)` and `g(X₁)`. -/
theorem exists_etaleCoordinates_strictHenselization [SmoothOfRelativeDimension 2 S.hom]
    (ht : t ≫ S.hom = 𝟙 _) :
    letI := strictHenselizationAlgebra S t
    ∃ (j₀ : SmallModel.{u} (strictHenselizationNeighbourhoods t))
      (g : CommRingCat.of (MvPolynomial (Fin 2) k) ⟶
        (strictHenselizationAffineDiagram t).obj (Opposite.op j₀)),
      g.hom.Etale ∧
      (∀ r : k, ((smallStrictHenselizationCocone t).ι.app (Opposite.op j₀)).hom (g.hom (C r)) =
        algebraMap k (strictHenselization t) r) ∧
      maximalIdeal (strictHenselization t) = Ideal.span
        {((smallStrictHenselizationCocone t).ι.app (Opposite.op j₀)).hom (g.hom (X 0)),
          ((smallStrictHenselizationCocone t).ι.app (Opposite.op j₀)).hom (g.hom (X 1))} := by
  let := strictHenselizationAlgebra S t
  obtain ⟨R₀, i, _, xR, g₁, hxR, hg₁, hSpec⟩ := exists_affine_chart_etale_mvPolynomial S t
  obtain ⟨_, ρ, hρ, hm⟩ := strictHenselization_chart_maximalIdeal' R₀ i xR t hxR
  obtain ⟨φ, rfl⟩ := Spec.map_surjective xR
  -- the point `t` is the `k`-point `φ : R₀ → k` of the chart
  have hφC : CommRingCat.ofHom (g₁.hom.comp C) ≫ φ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hSpec, ← Category.assoc, hxR, ht, Spec.map_id]
  have hφC' (r : k) : φ.hom (g₁.hom (C r)) = r := congr($(hφC).hom r)
  have hker : ((Spec.map φ) (IsLocalRing.closedPoint k)).asIdeal = RingHom.ker φ.hom := by
    rw [Spec.map_base]
    change Ideal.comap φ.hom (maximalIdeal k) = _
    rw [IsLocalRing.maximalIdeal_eq_bot, RingHom.ker_eq_comap_bot]
  -- étale coordinates centred at `t`
  let a₀ := φ.hom (g₁.hom (X 0))
  let a₁ := φ.hom (g₁.hom (X 1))
  let g₂ : CommRingCat.of (MvPolynomial (Fin 2) k) ⟶ R₀ :=
    CommRingCat.ofHom (g₁.hom.comp (affineSubst 0 (-a₀) (-a₁)).toRingHom)
  have hg₂ : g₂.hom.Etale := etale_comp_affineSubst hg₁ _ _ _
  have hg₂C (r : k) : g₂.hom (C r) = g₁.hom (C r) := by simp [g₂]
  have hφg₂ : φ.hom.comp g₂.hom = constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [hg₂C, hφC']
    · intro j
      fin_cases j
      · simp [g₂, hφC', a₀]
      · simp [g₂, hφC', a₁]
  have hmax := maximalIdeal_eq_span_of_etale g₂.hom hg₂ φ.hom hφg₂ ρ.hom (by rw [← hker, hm])
  -- the algebra structure
  have halg : CommRingCat.ofHom (g₁.hom.comp C) ≫ ρ =
      Spec.preimage (strictLocalizationToBase t ≫ S.hom) := by
    apply Spec.map_injective
    rw [Spec.map_comp, hSpec, Spec.map_preimage, ← Category.assoc, hρ]
  -- a stage of the small diagram over the chart
  let N := strictHenselizationNeighbourhoods t
  let rep := (equivSmallModel.{u} N).inverse
  let a : AffineEtale S.left := AffineEtale.mk i
  let y : (pointSmallEtale t).fiber.obj ((AffineEtale.Spec S.left).obj a) :=
    Over.homMk (Spec.map φ) hxR
  let n : N := (AffineEtale.Spec S.left ⋙ (pointSmallEtale t).fiber).elementsMk a y
  let j₀ := rep.objPreimage n
  let η := rep.objObjPreimageIso n
  let h := ((AffineEtale.Spec S.left).map η.hom.1).left
  have hh : h ≫ i = ((AffineEtale.Spec S.left).obj (rep.obj j₀).1).hom := η.hom.1.w
  let Rj : CommRingCat.{u} := (rep.obj j₀).1.left.unop
  let ψ : R₀ ⟶ Rj := Spec.preimage h
  let θ : Rj ⟶ strictHenselization t :=
    (Scheme.ΓSpecIso Rj).inv ≫ (smallStrictHenselizationCocone t).ι.app (Opposite.op j₀)
  have hθ : Spec.map θ ≫ ((AffineEtale.Spec S.left).obj (rep.obj j₀).1).hom =
      strictLocalizationToBase t := by
    rw [Spec.map_comp, Category.assoc]
    exact strictHenselizationStructuralMap_eq t j₀
  have hψθ : ψ ≫ θ = ρ := by
    apply Spec.map_injective
    rw [← cancel_mono i, hρ, Spec.map_comp, Category.assoc, Spec.map_preimage, hh, hθ]
  have hhet : Etale h := by
    have : Etale (h ≫ i) := by rw [hh]; infer_instance
    exact MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) h i inferInstance this
  have hψ : ψ.hom.Etale :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mp (by rw [Spec.map_preimage]; exact hhet)
  have hΓ : (Scheme.ΓSpecIso Rj).inv.hom.Etale :=
    RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
  have key (p : MvPolynomial (Fin 2) k) :
      ((smallStrictHenselizationCocone t).ι.app (Opposite.op j₀)).hom
        ((g₂ ≫ ψ ≫ (Scheme.ΓSpecIso Rj).inv).hom p) = ρ.hom (g₂.hom p) :=
    congr($(hψθ).hom (g₂.hom p))
  refine ⟨j₀, g₂ ≫ ψ ≫ (Scheme.ΓSpecIso Rj).inv, ?_, fun r ↦ ?_, ?_⟩
  · exact RingHom.Etale.stableUnderComposition _ _ hg₂
      (RingHom.Etale.stableUnderComposition _ _ hψ hΓ)
  · refine (key (C r)).trans ?_
    rw [hg₂C]
    exact congr($(halg).hom r)
  · erw [key, key]
    exact hmax

end AlgebraicGeometry.Scheme
