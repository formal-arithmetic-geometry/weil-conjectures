public import Mathlib.Algebra.Regular.SMul
public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Normalization
public import Mathlib.AlgebraicGeometry.Noetherian
public import Submission.WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.EffectiveCartier

import Submission.WeilConjectures.AlgebraicGeometry.Morphisms.RegularCartierGenericStalkDvr
import Submission.WeilConjectures.AlgebraicGeometry.Morphisms.PuncturedDvrNormalizationStalkTorsionFree
import Mathlib.RingTheory.Flat.TorsionFree

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-! # Flat stalks of a root-cover normalization at the divisor generic point

Source: Stacks Project, Tag 0EYG, the height-one local calculation.
-/

@[expose] public section
universe u
open CategoryTheory CategoryTheory.Limits
namespace AlgebraicGeometry.Scheme

set_option linter.unusedVariables false in
/-- The finite relative normalization of a punctured finite etale cover has flat stalks
above the generic point of the root divisor. No ramification bound is needed for flatness.

Source: Stacks Project, Tag 0EYG, the DVR at the prime generated by the root;
Tags 0307 (localization), 0539 and 0AUW (torsion-free DVR modules are flat/free).
(blueprint: lem-sbc-root-normalization-generic-stalk-flat)

Proof: The support condition puts j(eta) outside D(g), so g belongs to its prime.
The root relation t^n=g and primality put t in the same prime. The assumed
regularity of the corresponding prime localization transports to the scheme stalk.
The integral effective Cartier centre has a field stalk at eta. Its stalk-map kernel
is therefore the maximal ideal of the ambient stalk, and is generated by a
nonzerodivisor. The regular-local domain theorem and the principal maximal ideal
criterion make this ambient stalk a DVR (regular_cartier_generic_stalk_dvr).
Transport this property along the displayed image equality. Apply
punctured_dvr_normalization_stalk_torsionFree to the finite etale cover of D(g).
This remaining localization comparison gives torsion-freeness for the precise
algebra structure of the normalization stalk map. Mathlib's torsion-free flatness
instance over a Dedekind domain then gives the required flatness. The finiteness
of the normalization, hg, and the quotient-domain hypothesis are retained in the
signature but are unnecessary for this shorter argument. Empty covers are vacuous;
n=1 is included and no ramification bound is used. -/
theorem root_normalization_generic_stalk_flat
    (H : CommRingCat.{u}) [IsNoetherianRing H] (g : H)
    (hg : IsSMulRegular H g) [IsDomain (H ⧸ Ideal.span {g})]
    (n : ℕ) (hn : 0 < n) :
    let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
    let N := Spec (CommRingCat.of A)
    let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
    (∀ (Q : Ideal A) (hQ : Q.IsPrime),
      letI := hQ
      AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g) ∈ Q →
        IsRegularLocalRing (Localization.AtPrime Q)) →
    ∀ (hN : IsLocallyNoetherian N),
    letI := hN
    ∀ (P : Scheme.{u}) (p : P ⟶ V.toScheme) (hp : IsFinite p),
    letI := hp
    let a := p ≫ V.ι
    Etale p → IsFinite a.fromNormalization →
    ∀ (D : Scheme.{u}) (j : D ⟶ N),
      IsIntegral D → IsEffectiveCartierCenter j →
      (∀ z : N, z ∈ V ↔ z ∉ Set.range j) →
      ∀ (η : D), IsGenericPoint η Set.univ →
      ∀ (x : a.normalization), a.fromNormalization x = j η →
        (a.fromNormalization.stalkMap x).hom.Flat := by
  dsimp only
  intro hroot hN P p hp hetale hfinite D j hD hj hV η hη x hx
  let := hN
  let := hp
  let A := AdjoinRoot ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
  let N := Spec (CommRingCat.of A)
  let V : N.Opens := PrimeSpectrum.basicOpen (algebraMap H A g)
  let a := p ≫ V.ι
  have hs : j η ∉ V := by
    intro hs
    exact (hV (j η)).mp hs ⟨η, rfl⟩
  have ht : AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
      ∈ (j η).asIdeal := by
    have hg' : algebraMap H A g ∈ (j η).asIdeal := by
      exact Classical.not_not.mp (show ¬ algebraMap H A g ∉ (j η).asIdeal from hs)
    have heq : AdjoinRoot.root ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
        ^ n = algebraMap H A g := by
      have heval := AdjoinRoot.eval₂_root
        ((Polynomial.X : Polynomial H) ^ n - Polynomial.C g)
      simpa only [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, sub_eq_zero, ← AdjoinRoot.algebraMap_eq] using heval
    exact ((j η).isPrime.pow_mem_iff_mem n hn).mp (heq ▸ hg')
  have hreg : IsRegularLocalRing (N.presheaf.stalk (j η)) := by
    let := hroot (j η).asIdeal (j η).isPrime ht
    exact IsRegularLocalRing.of_ringEquiv
      (AlgebraicGeometry.StructureSheaf.stalkIso A (j η)).toRingEquiv
  have hdata : ∃ hdom : IsDomain (N.presheaf.stalk (a.fromNormalization x)),
      letI := hdom
      IsDiscreteValuationRing (N.presheaf.stalk (a.fromNormalization x)) := by
    rw [show a.fromNormalization x = j η from hx]
    exact regular_cartier_generic_stalk_dvr j hD hj η hη hreg
  obtain ⟨hdom, hdvr⟩ := hdata
  let := hdom
  let := hdvr
  have hs' : a.fromNormalization x ∉ V := by rwa [hx]
  let := (a.fromNormalization.stalkMap x).hom.toAlgebra
  have htors := punctured_dvr_normalization_stalk_torsionFree V p hetale x hs'
  let := htors
  change Module.Flat (N.presheaf.stalk (a.fromNormalization x))
    (a.normalization.presheaf.stalk x)
  infer_instance

end AlgebraicGeometry.Scheme
