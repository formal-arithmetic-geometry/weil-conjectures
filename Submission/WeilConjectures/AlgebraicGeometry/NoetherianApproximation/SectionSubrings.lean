set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Finitely generated subrings of section rings

Auxiliary results for finite affine gluing presentations
(`WeilConjectures.AlgebraicGeometry.NoetherianApproximation.GluingPresentation`):

- `Subring.finiteType_closure_finset`: a subring generated by a finite set is a finitely
  generated `ℤ`-algebra.
- `RingHom.exists_finset_closure_eq_range`: the image of a ring homomorphism out of a finitely
  generated `ℤ`-algebra is generated, as a subring, by a finite set.
-/

@[expose] public section

universe u

open CategoryTheory Limits

/-- A subring generated by a finite set is a finitely generated `ℤ`-algebra. -/
lemma Subring.finiteType_closure_finset {R : Type*} [Ring R] (s : Finset R) :
    Algebra.FiniteType ℤ (Subring.closure (s : Set R)) := by
  have : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (s : Set R)) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset s)
  have h : (Algebra.adjoin ℤ (s : Set R)).toSubring = Subring.closure (s : Set R) := by
    rw [Algebra.adjoin_int]
    rfl
  exact Algebra.FiniteType.equiv this (RingEquiv.subringCongr h).toIntAlgEquiv

/-- The image of a ring homomorphism out of a finitely generated `ℤ`-algebra is generated, as a
subring, by a finite set. -/
lemma RingHom.exists_finset_closure_eq_range {R S : Type*} [CommRing R] [Ring S]
    [hR : Algebra.FiniteType ℤ R] (φ : R →+* S) :
    ∃ s : Finset S, Subring.closure (s : Set S) = φ.range := by
  classical
  obtain ⟨t, ht⟩ := hR.out
  have ht' : Subring.closure (t : Set R) = ⊤ := by
    have := congrArg Subalgebra.toSubring ht
    rwa [Algebra.adjoin_int] at this
  refine ⟨t.image φ, ?_⟩
  rw [Finset.coe_image, ← RingHom.map_closure, ht', RingHom.range_eq_map]

namespace AlgebraicGeometry.Scheme.NoetherianApproximation

variable {S : Scheme.{u}} (N : S.NoetherianApproximation)

/-- The projection from `S` to the stage `k`, with source syntactically `S`. -/
def proj (k : N.I) : S ⟶ N.D.obj k :=
  N.π.app k

@[reassoc (attr := simp)]
lemma proj_comp_map {j k : N.I} (g : j ⟶ k) : N.proj j ≫ N.D.map g = N.proj k :=
  (Cone.mk S N.π).w g

lemma proj_preimage_map_preimage {j k : N.I} (g : j ⟶ k) (V : (N.D.obj k).Opens) :
    N.proj j ⁻¹ᵁ (N.D.map g ⁻¹ᵁ V) = N.proj k ⁻¹ᵁ V := by
  rw [← Scheme.Hom.comp_preimage, proj_comp_map]


/-- Finitely many affine opens of a quasi-compact quasi-separated scheme are the preimages of
affine opens of a single stage of a Noetherian approximation. -/
lemma exists_isAffineOpen_preimage_eq {σ : Type*} [Finite σ] (U : σ → S.Opens)
    (hU : ∀ a, IsAffineOpen (U a)) :
    ∃ (k : N.I) (V : σ → (N.D.obj k).Opens),
      (∀ a, IsAffineOpen (V a)) ∧ ∀ a, N.proj k ⁻¹ᵁ V a = U a := by
  classical
  cases nonempty_fintype σ
  have hc : IsLimit (Cone.mk S N.π) := N.isLimit
  have h1 : ∀ a, ∃ (i : N.I) (V : (N.D.obj i).Opens),
      IsAffineOpen V ∧ N.proj i ⁻¹ᵁ V = U a := by
    intro a
    obtain ⟨i₀, W, hWc, hW⟩ : ∃ (i₀ : N.I) (W : (N.D.obj i₀).Opens),
        IsCompact (W : Set (N.D.obj i₀)) ∧ N.proj i₀ ⁻¹ᵁ W = U a :=
      exists_preimage_eq N.D (Cone.mk S N.π) hc (U a) (hU a).isCompact
    obtain ⟨j, hj⟩ : ∃ j : Over i₀, IsAffineOpen (N.D.map j.hom ⁻¹ᵁ W) :=
      exists_isAffineOpen_preimage hc hWc (hW ▸ hU a)
    exact ⟨j.left, _, hj, (N.proj_preimage_map_preimage j.hom W).trans hW⟩
  choose i V hV hVU using h1
  obtain ⟨k, fk⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image i)
  have g : ∀ a, k ⟶ i a := fun a ↦ (fk (by simp)).some
  exact ⟨k, fun a ↦ N.D.map (g a) ⁻¹ᵁ V a, fun a ↦ (hV a).preimage _,
    fun a ↦ (N.proj_preimage_map_preimage (g a) (V a)).trans (hVU a)⟩

/-- Finitely many sections over preimages of affine opens `V a` of a stage `k` come from
sections over the preimages of the `V a` at a single later stage. -/
lemma exists_hom_forall_exists_appLE_eq {k : N.I} {σ : Type*} [Finite σ]
    (V : σ → (N.D.obj k).Opens) (hV : ∀ a, IsAffineOpen (V a)) (U : σ → S.Opens)
    (hVU : ∀ a, N.proj k ⁻¹ᵁ V a = U a) (T : ∀ a, Set Γ(S, U a)) (hT : ∀ a, (T a).Finite) :
    ∃ (k₁ : N.I) (g : k₁ ⟶ k), ∀ a, ∀ x ∈ T a, ∃ t : Γ(N.D.obj k₁, N.D.map g ⁻¹ᵁ V a),
      (N.proj k₁).appLE (N.D.map g ⁻¹ᵁ V a) (U a)
        ((N.proj_preimage_map_preimage g (V a)).trans (hVU a)).ge t = x := by
  have hc : IsLimit (Cone.mk S N.π) := N.isLimit
  have : ∀ a, Finite (T a) := fun a ↦ (hT a).to_subtype
  obtain ⟨k₁, g, hk₁⟩ : ∃ (k₁ : N.I) (g : k₁ ⟶ k), ∀ (p : Σ a, T a)
      (e : N.proj k ⁻¹ᵁ V p.1 ≤ N.proj k₁ ⁻¹ᵁ (N.D.map g ⁻¹ᵁ V p.1)),
      S.presheaf.map (homOfLE (hVU p.1).le).op p.2.1 ∈
        Set.range ((N.proj k₁).appLE (N.D.map g ⁻¹ᵁ V p.1) (N.proj k ⁻¹ᵁ V p.1) e) :=
    exists_hom_forall_mem_range_appLE hc k (fun p : Σ a, T a ↦ hV p.1) _
  refine ⟨k₁, g, fun a x hx ↦ ?_⟩
  have e := (N.proj_preimage_map_preimage g (V a)).ge
  obtain ⟨t, ht⟩ := hk₁ ⟨a, x, hx⟩ e
  refine ⟨t, ?_⟩
  calc (N.proj k₁).appLE (N.D.map g ⁻¹ᵁ V a) (U a) _ t
      = S.presheaf.map (homOfLE (hVU a).ge).op
          ((N.proj k₁).appLE (N.D.map g ⁻¹ᵁ V a) (N.proj k ⁻¹ᵁ V a) e t) := by
        rw [← Scheme.Hom.appLE_map _ e (homOfLE (hVU a).ge).op]
        rfl
    _ = S.presheaf.map (homOfLE (hVU a).ge).op
          (S.presheaf.map (homOfLE (hVU a).le).op x) := by rw [ht]
    _ = x := by
        change (S.presheaf.map (homOfLE (hVU a).le).op ≫
          S.presheaf.map (homOfLE (hVU a).ge).op) x = x
        rw [← Functor.map_comp, ← op_comp,
          show homOfLE (hVU a).ge ≫ homOfLE (hVU a).le = 𝟙 _ from Subsingleton.elim _ _,
          op_id, CategoryTheory.Functor.map_id]
        rfl

/-- If finitely many pairs of quasi-compact opens of a stage `k` have equal preimages in `S`,
then their preimages agree at a single later stage. -/
lemma exists_hom_forall_map_preimage_eq {k : N.I} {σ : Type*} [Finite σ]
    (W W' : σ → (N.D.obj k).Opens) (hW : ∀ a, IsCompact (W a : Set (N.D.obj k)))
    (hW' : ∀ a, IsCompact (W' a : Set (N.D.obj k)))
    (h : ∀ a, N.proj k ⁻¹ᵁ W a = N.proj k ⁻¹ᵁ W' a) :
    ∃ (k₁ : N.I) (g : k₁ ⟶ k), ∀ a, N.D.map g ⁻¹ᵁ W a = N.D.map g ⁻¹ᵁ W' a := by
  refine IsCofiltered.exists_forall_of_finite
    (fun a {l} (g : l ⟶ k) ↦ N.D.map g ⁻¹ᵁ W a = N.D.map g ⁻¹ᵁ W' a)
    (fun a _ _ f g hP ↦ ?_) fun a ↦ ?_
  · simp only [Functor.map_comp, Scheme.Hom.comp_preimage] at hP ⊢
    rw [hP]
  · exact exists_map_preimage_eq_map_preimage N.D (Cone.mk S N.π) N.isLimit (hW a) (hW' a)
      (h a)

end AlgebraicGeometry.Scheme.NoetherianApproximation
