/-! # Extension of a fixed module pair to the action site

Source: the agent-formulated twisted variant of Stacks Tag 00W0, step 4.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor Opposite

namespace CategoryTheory.TwistedActionRingedSite

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    (s : C ≌ C) [s.functor.IsContinuous J J] [s.inverse.IsContinuous J J]
    (R : Sheaf J CommRingCat.{u})
    (a : (s.inverse.sheafPushforwardContinuous CommRingCat.{u} J J).obj R ≅ R)

private def generator (S : Site J s R a) (X : C) :
    letI := S.category
    letI := S.inclusion_continuous
    S.inclusion.obj (s.inverse.obj X) ⟶ S.inclusion.obj X := by
  let := S.category
  let := S.inclusion_continuous
  exact (S.arrows (s.inverse.obj X) X).symm ⟨-1, 𝟙 _⟩

private theorem isIso_of_composites {D : Type*} [Category D] {X Y : D}
    (f : X ⟶ Y) (g : Y ⟶ X) [IsIso (f ≫ g)] [IsIso (g ≫ f)] : IsIso f := by
  let l := inv (g ≫ f) ≫ g
  let r := g ≫ inv (f ≫ g)
  have hl : l ≫ f = 𝟙 _ := by simp [l, Category.assoc]
  have hr : f ≫ r = 𝟙 _ := by simp [r, ← Category.assoc]
  have h : l = r := by
    calc
      l = l ≫ (f ≫ r) := by rw [hr, Category.comp_id]
      _ = r := by rw [← Category.assoc, hl, Category.id_comp]
  exact ⟨⟨r, hr, by rw [← h]; exact hl⟩⟩

omit [s.functor.IsContinuous J J] in
private theorem generator_isIso (S : Site J s R a) (X : C) :
    letI := S.category
    letI := S.inclusion_continuous
    IsIso (generator J s R a S X) := by
  let := S.category
  let := S.inclusion_continuous
  let g : S.inclusion.obj X ⟶ S.inclusion.obj (s.inverse.obj X) :=
    (S.arrows X (s.inverse.obj X)).symm ⟨1, s.counitInv.app X⟩
  have hfg : generator J s R a S X ≫ g = S.inclusion.map
      (s.inverse.map (s.counitInv.app X) ≫
        (S.powerComp (-1) 1).hom.app (s.inverse.obj X)) := by
    apply (S.arrows _ _).injective
    dsimp only [generator, g]
    rw [S.arrows_comp, S.arrows_inclusion]
    simp
  have hgf : g ≫ generator J s R a S X = S.inclusion.map
      (s.counitInv.app X ≫ (S.powerComp 1 (-1)).hom.app X) := by
    apply (S.arrows _ _).injective
    dsimp only [generator, g]
    rw [S.arrows_comp, S.arrows_inclusion]
    simp
  have : IsIso (generator J s R a S X ≫ g) := by rw [hfg]; infer_instance
  have : IsIso (g ≫ generator J s R a S X) := by rw [hgf]; infer_instance
  exact isIso_of_composites _ g

-- The integer-labelled presentation is generated by base arrows and one invertible arrow.

omit [s.functor.IsContinuous J J] in
private theorem generator_induction (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (P : ∀ {X Y : C}, (S.inclusion.obj X ⟶ S.inclusion.obj Y) → Prop)
        (_hzero : ∀ {X Y : C} (f : X ⟶ Y), P (S.inclusion.map f))
        (_hcomp : ∀ {X Y Z : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
          (g : S.inclusion.obj Y ⟶ S.inclusion.obj Z), P f → P g → P (f ≫ g))
        (_hinv : ∀ {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
          [IsIso f], P f → P (inv f))
        (_hgen : ∀ X : C, P (generator J s R a S X))
        {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y),
        P f := by
  let := S.category
  let := S.inclusion_continuous
  intro P hzero hcomp hinv hgen X Y f
  let Q (n : ℤ) := ∀ (X Y : C) (f : X ⟶ (s ^ n).functor.obj Y),
    P ((S.arrows X Y).symm ⟨n, f⟩)
  have h₀ : Q 0 := by
    intro X Y f
    have hf := (S.arrows X Y).symm_apply_apply (S.inclusion.map f)
    rw [S.arrows_inclusion] at hf
    rw [hf]
    exact hzero f
  have hm : Q (-1) := by
    intro X Y f
    let k := f ≫ (S.powerComp 0 (-1)).inv.app Y
    have he : (S.arrows X Y).symm ⟨-1, f⟩ =
        S.inclusion.map k ≫ generator J s R a S Y := by
      apply (S.arrows X Y).injective
      have hk := (S.arrows X (s.inverse.obj Y)).symm_apply_apply (S.inclusion.map k)
      rw [S.arrows_inclusion] at hk
      rw [← hk]
      dsimp only [generator]
      rw [S.arrows_comp, Equiv.apply_symm_apply]
      simp [k, Category.assoc]
    rw [he]
    exact hcomp _ _ (hzero k) (hgen Y)
  have hp : Q 1 := by
    intro X Y f
    let g := generator J s R a S (s.functor.obj Y)
    have : IsIso g := generator_isIso J s R a S _
    let t := (S.arrows (s.functor.obj Y) Y).symm ⟨1, 𝟙 _⟩
    have ht : g ≫ t = S.inclusion.map ((S.powerComp (-1) 1).hom.app Y) := by
      apply (S.arrows _ _).injective
      dsimp only [g, generator, t]
      rw [S.arrows_comp, S.arrows_inclusion]
      simp
    have ht' : t = inv g ≫ S.inclusion.map ((S.powerComp (-1) 1).hom.app Y) := by
      rw [← ht, ← Category.assoc, IsIso.inv_hom_id, Category.id_comp]
    have hpt : P t := by
      rw [ht']
      exact hcomp _ _ (hinv g (hgen _)) (hzero _)
    let k := f ≫ (S.powerComp 0 1).inv.app Y
    have he : (S.arrows X Y).symm ⟨1, f⟩ = S.inclusion.map k ≫ t := by
      apply (S.arrows X Y).injective
      have hk := (S.arrows X (s.functor.obj Y)).symm_apply_apply (S.inclusion.map k)
      rw [S.arrows_inclusion] at hk
      rw [← hk]
      dsimp only [t]
      rw [S.arrows_comp, Equiv.apply_symm_apply]
      simp [k, Category.assoc]
    rw [he]
    exact hcomp _ _ (hzero k) hpt
  have hadd (n m : ℤ) (hn : Q n) (hm : Q m) : Q (n + m) := by
    intro X Y f
    let k := f ≫ (S.powerComp n m).inv.app Y
    have he : (S.arrows X Y).symm ⟨n + m, f⟩ =
        (S.arrows X ((s ^ m).functor.obj Y)).symm ⟨n, k⟩ ≫
          (S.arrows ((s ^ m).functor.obj Y) Y).symm ⟨m, 𝟙 _⟩ := by
      apply (S.arrows X Y).injective
      rw [S.arrows_comp, Equiv.apply_symm_apply]
      simp [k, Category.assoc]
    rw [he]
    exact hcomp _ _ (hn _ _ _) (hm _ _ _)
  have hall (n : ℤ) : Q n := by
    induction n using Int.induction_on with
    | zero => exact h₀
    | succ i hi => exact hadd _ _ hi hp
    | pred i hi => simpa only [sub_eq_add_neg] using hadd _ _ hi hm
  rcases h : S.arrows X Y f with ⟨n, g⟩
  have hf := (S.arrows X Y).symm_apply_apply f
  rw [h] at hf
  rw [← hf]
  exact hall n X Y g

/-- An individual fixed module pair extends to a module sheaf on the action site.

Source: the object and sheaf-condition part of step 4 of the agent-formulated twisted
variant of Stacks 00W0, `sites.tex`, proposition-sheaves-on-group; Stacks 03CV
(blueprint: lem-sf-twisted-action-module-object-extension).

Proof: for a fixed pair P, put its section module at X on the copied object X,
transporting scalars along coefficientRestriction.hom. Define restriction along
an integer-labelled arrow by the base restriction followed by the corresponding
iterate of the pair isomorphism, using its inverse for negative powers. Start
with the minus-one restriction equal to the inverse of P.str. Successive powers
of s are compared by the specified powerComp maps; arrows_comp and naturality
of P.str give identity and composition. The coefficient_generator equation gives
semilinearity for the generator; iteration gives semilinearity for every labelled
arrow. On degree-zero covering sieves a matching family and its unique gluing
are exactly those of the original module sheaf P.obj.a. Each other arrow factors
through an invertible power generator, so no new gluing condition is introduced.
The sheaf topologies agree on this basis by topology_eq: the sheaf-condition
Grothendieck topology contains every generating sieve, and these generators
already require the base sheaf condition. Thus the constructed presheaf is a
module sheaf N. Its degree-zero restriction is P.obj.a, with the scalar transport
providing b. On the minus-one generator the defining formula reads exactly as
the displayed equation. This only constructs objects and their restriction
isomorphisms; it asserts no extension of morphisms, functor, or equivalence. Zero
modules, the zero ring, and empty covering families use the same construction. -/
theorem moduleObjectExtension [HasPullbacks C] (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    let U : Modules S.coefficient ⥤ Modules R := SheafOfModules.pushforward
      ((sheafCompose J (forget₂ CommRingCat RingCat)).map S.coefficientRestriction.inv)
    ∀ P : Pairs (sigma J s R a),
      ∃ (N : Modules S.coefficient) (b : U.obj N ≅ P.obj.a),
        ∀ (X : C) (x : ((sigma J s R a).obj P.obj.a).val.obj (op X)),
          b.inv.val.app (op (s.inverse.obj X)) x =
            N.val.map ((S.arrows (s.inverse.obj X) X).symm ⟨-1, 𝟙 _⟩).op
              (b.inv.val.app (op X) (P.obj.str.val.app (op X) x)) := by
  let := S.category
  let := S.inclusion_continuous
  dsimp only
  intro P
  let F := P.obj.a.val.presheaf ⋙ forget Ab
  let τ : s.inverse.op ⋙ F ≅ F :=
    isoWhiskerRight ((PresheafOfModules.toPresheaf (ring R).obj).mapIso
      ((SheafOfModules.forget (ring R)).mapIso (pairIso P))) (forget Ab)
  obtain ⟨G, c, hc⟩ := twistedPresheafExtension J s R a S F τ
  have hc' (X : C) (x : G.obj (op (S.inclusion.obj X))) :
      c.hom.app (op (s.inverse.obj X))
          (G.map (generator J s R a S X).op x) =
        (pairIso P).inv.val.app (op X) (c.hom.app (op X) x) :=
    ConcreteCategory.congr_hom (hc X) x
  -- Compare the extended sets with the old section modules and coefficient ring.
  let moduleMap {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
      (x : P.obj.a.val.obj (op Y)) : P.obj.a.val.obj (op X) :=
    c.hom.app (op X) (G.map f.op (c.inv.app (op Y) x))
  let scalarMap {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
      (r : R.obj.obj (op Y)) : R.obj.obj (op X) :=
    S.coefficientRestriction.hom.hom.app (op X)
      (S.coefficient.obj.map f.op (S.coefficientRestriction.inv.hom.app (op Y) r))
  have qhi (X : Cᵒᵖ)
      (r : S.coefficient.obj.obj (S.inclusion.op.obj X)) :
      S.coefficientRestriction.inv.hom.app X
          (S.coefficientRestriction.hom.hom.app X r) = r :=
    ConcreteCategory.congr_hom
      (congrArg (fun t ↦ t.hom.app X) S.coefficientRestriction.hom_inv_id) r
  have qih (X : Cᵒᵖ) (r : R.obj.obj X) :
      S.coefficientRestriction.hom.hom.app X
          (S.coefficientRestriction.inv.hom.app X r) = r :=
    ConcreteCategory.congr_hom
      (congrArg (fun t ↦ t.hom.app X) S.coefficientRestriction.inv_hom_id) r
  have moduleMap_comp {X Y Z : C}
      (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
      (g : S.inclusion.obj Y ⟶ S.inclusion.obj Z) (x : P.obj.a.val.obj (op Z)) :
      moduleMap (f ≫ g) x =
        moduleMap f (moduleMap g x) := by
    simp only [moduleMap, op_comp, Functor.map_comp, types_comp_apply,
      Iso.hom_inv_id_app_apply]
  have scalarMap_comp {X Y Z : C}
      (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
      (g : S.inclusion.obj Y ⟶ S.inclusion.obj Z) (r : R.obj.obj (op Z)) :
      scalarMap (f ≫ g) r =
        scalarMap f (scalarMap g r) := by
    simp only [scalarMap, op_comp, Functor.map_comp,
      CommRingCat.comp_apply, qhi]
  have moduleMap_id (X : C) (x : P.obj.a.val.obj (op X)) :
      moduleMap (𝟙 (S.inclusion.obj X)) x = x := by
    simp only [moduleMap, op_id, Functor.map_id, types_id_apply,
      Iso.inv_hom_id_app_apply]
  have scalarMap_id (X : C) (r : R.obj.obj (op X)) :
      scalarMap (𝟙 (S.inclusion.obj X)) r = r := by
    simpa only [scalarMap, op_id, Functor.map_id,
      CommRingCat.id_apply] using qih (op X) r
  have moduleMap_base {X Y : C} (f : X ⟶ Y)
      (x : P.obj.a.val.obj (op Y)) :
      moduleMap (S.inclusion.map f) x = P.obj.a.val.map f.op x := by
    have h := ConcreteCategory.congr_hom (c.hom.naturality f.op) (c.inv.app (op Y) x)
    change c.hom.app (op X)
        (G.map (S.inclusion.map f).op (c.inv.app (op Y) x)) =
      P.obj.a.val.map f.op (c.hom.app (op Y) (c.inv.app (op Y) x)) at h
    simpa only [moduleMap, Iso.inv_hom_id_app_apply] using h
  have scalarMap_base {X Y : C} (f : X ⟶ Y) (r : R.obj.obj (op Y)) :
      scalarMap (S.inclusion.map f) r = R.obj.map f.op r := by
    have h := ConcreteCategory.congr_hom
      (S.coefficientRestriction.hom.hom.naturality f.op)
      (S.coefficientRestriction.inv.hom.app (op Y) r)
    change S.coefficientRestriction.hom.hom.app (op X)
        (S.coefficient.obj.map (S.inclusion.map f).op
          (S.coefficientRestriction.inv.hom.app (op Y) r)) =
      R.obj.map f.op (S.coefficientRestriction.hom.hom.app (op Y)
        (S.coefficientRestriction.inv.hom.app (op Y) r)) at h
    simpa only [scalarMap, qih] using h
  -- The algebraic laws are stable under composition and inversion.
  have moduleMap_linear :
      ∀ {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y),
        (∀ x y, moduleMap f (x + y) =
          moduleMap f x + moduleMap f y) ∧
        (∀ r x, moduleMap f (r • x) =
          scalarMap f r • moduleMap f x) := by
    intro X Y f
    apply generator_induction J s R a S
      (fun {X Y} f ↦
        (∀ x y, moduleMap f (x + y) =
          moduleMap f x + moduleMap f y) ∧
        (∀ r x, moduleMap f (r • x) =
          scalarMap f r • moduleMap f x)) ?_ ?_ ?_ ?_ f
    · intro X Y f
      constructor
      · intro x y
        simp only [moduleMap_base]
        exact map_add (P.obj.a.val.map f.op).hom x y
      · intro r x
        simp only [moduleMap_base, scalarMap_base]
        exact P.obj.a.val.map_smul f.op r x
    · intro X Y Z f g hf hg
      constructor
      · intro x y
        simp only [moduleMap_comp, hg.1, hf.1]
      · intro r x
        simp only [moduleMap_comp, scalarMap_comp, hg.2, hf.2]
    · intro X Y f _ hf
      have hM (x : P.obj.a.val.obj (op X)) :
          moduleMap f (moduleMap (inv f) x) = x := by
        rw [← moduleMap_comp, IsIso.hom_inv_id, moduleMap_id]
      have hM' (x : P.obj.a.val.obj (op Y)) :
          moduleMap (inv f) (moduleMap f x) = x := by
        rw [← moduleMap_comp, IsIso.inv_hom_id, moduleMap_id]
      have hR (r : R.obj.obj (op X)) :
          scalarMap f (scalarMap (inv f) r) = r := by
        rw [← scalarMap_comp, IsIso.hom_inv_id, scalarMap_id]
      have hinj : Function.Injective (moduleMap f) :=
        Function.LeftInverse.injective hM'
      constructor
      · intro x y
        apply hinj
        rw [hM, hf.1, hM, hM]
      · intro r x
        apply hinj
        rw [hM, hf.2, hR, hM]
    · intro X
      have h (x : P.obj.a.val.obj (op X)) :
          moduleMap (generator J s R a S X) x =
            (pairIso P).inv.val.app (op X) x := by
        have hh := hc' X (c.inv.app (op X) x)
        simpa only [moduleMap, Iso.inv_hom_id_app_apply] using hh
      have hr (r : R.obj.obj (op X)) :
          scalarMap (generator J s R a S X) r = a.inv.hom.app (op X) r := by
        have hh := S.coefficient_generator X (S.coefficientRestriction.inv.hom.app (op X) r)
        simpa only [scalarMap, generator, qih] using hh
      constructor
      · intro x y
        simp only [h]
        exact map_add ((pairIso P).inv.val.app (op X)).hom x y
      · intro r x
        simp only [h, hr]
        exact ((pairIso P).inv.val.app (op X)).hom.map_smul r x
  -- Account for the inclusion being an object copy, rather than a definitional identity.
  let copyIso (X : Object C) : S.inclusion.obj X.base ≅ X :=
    eqToIso (S.inclusion_obj X.base)
  let copyArrow {X Y : (Object C)ᵒᵖ} (f : X ⟶ Y) :
      S.inclusion.obj Y.unop.base ⟶ S.inclusion.obj X.unop.base :=
    (copyIso Y.unop).hom ≫ f.unop ≫ (copyIso X.unop).inv
  have copyArrow_id (X : (Object C)ᵒᵖ) :
      copyArrow (𝟙 X) = 𝟙 _ := by
    simp [copyArrow]
  have copyArrow_comp {X Y Z : (Object C)ᵒᵖ} (f : X ⟶ Y) (g : Y ⟶ Z) :
      copyArrow (f ≫ g) =
        copyArrow g ≫ copyArrow f := by
    simp [copyArrow, Category.assoc]
  have coefficient_copy_cancel (X : Object C) (r : S.coefficient.obj.obj (op X)) :
      S.coefficient.obj.map (copyIso X).inv.op
          (S.coefficient.obj.map (copyIso X).hom.op r) = r :=
    ConcreteCategory.congr_hom (S.coefficient.obj.mapIso (copyIso X).op).hom_inv_id r
  have set_copy_cancel (X : Object C) (x : G.obj (op X)) :
      G.map (copyIso X).inv.op (G.map (copyIso X).hom.op x) = x :=
    ConcreteCategory.congr_hom (G.mapIso (copyIso X).op).hom_inv_id x
  let localScalar (X : (Object C)ᵒᵖ) :
      S.coefficient.obj.obj X →+* R.obj.obj (op X.unop.base) :=
    (S.coefficient.obj.map (copyIso X.unop).hom.op ≫
      S.coefficientRestriction.hom.hom.app (op X.unop.base)).hom
  have localScalar_apply (X : (Object C)ᵒᵖ) (r : S.coefficient.obj.obj X) :
      localScalar X r = S.coefficientRestriction.hom.hom.app (op X.unop.base)
        (S.coefficient.obj.map (copyIso X.unop).hom.op r) := rfl
  have localScalar_map {X Y : (Object C)ᵒᵖ} (f : X ⟶ Y)
      (r : S.coefficient.obj.obj X) :
      scalarMap (copyArrow f) (localScalar X r) =
        localScalar Y (S.coefficient.obj.map f r) := by
    simp only [scalarMap, localScalar_apply, copyArrow, op_comp, Functor.map_comp,
      CommRingCat.comp_apply, qhi, coefficient_copy_cancel, Quiver.Hom.op_unop]
  have hadd := fun {X Y} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y) ↦
    (moduleMap_linear f).1
  have hsmul := fun {X Y} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y) ↦
    (moduleMap_linear f).2
  -- Construct the module presheaf from the old modules, with actual scalar restrictions.
  let moduleObj (X : (Object C)ᵒᵖ) : ModuleCat.{u} ((ring S.coefficient).obj.obj X) :=
    (ModuleCat.restrictScalars (localScalar X)).obj (P.obj.a.val.obj (op X.unop.base))
  let V : PresheafOfModules.{u} (ring S.coefficient).obj := {
    obj := moduleObj
    map {X Y} f := ModuleCat.ofHom (X := moduleObj X)
      (Y := (ModuleCat.restrictScalars ((ring S.coefficient).obj.map f).hom).obj
        (moduleObj Y)) {
      toFun := moduleMap (copyArrow f)
      map_add' := hadd _
      map_smul' := by
        intro r x
        change moduleMap (copyArrow f)
            (localScalar X r • x) =
          localScalar Y (S.coefficient.obj.map f r) •
            moduleMap (copyArrow f) x
        rw [hsmul, localScalar_map] }
    map_id X := by
      ext x
      change moduleMap (copyArrow (𝟙 X)) x = x
      rw [copyArrow_id, moduleMap_id]
    map_comp f g := by
      ext x
      change moduleMap (copyArrow (f ≫ g)) x =
        moduleMap (copyArrow g)
          (moduleMap (copyArrow f) x)
      rw [copyArrow_comp, moduleMap_comp] }
  -- The underlying sets of the constructed module are isomorphic to G.
  let d :
      (V).presheaf ⋙ forget Ab ≅ G := by
    refine NatIso.ofComponents (fun X ↦ ?_) ?_
    · exact (c.app (op X.unop.base)).symm ≪≫
        (G.mapIso (copyIso X.unop).op).symm
    · intro X Y f
      ext x
      change G.map (copyIso Y.unop).inv.op
          (c.inv.app (op Y.unop.base) (moduleMap (copyArrow f) x)) =
        G.map f (G.map (copyIso X.unop).inv.op (c.inv.app (op X.unop.base) x))
      simp only [moduleMap, copyArrow, op_comp, Functor.map_comp, types_comp_apply,
        Iso.hom_inv_id_app_apply, set_copy_cancel, Quiver.Hom.op_unop]
  let baseIso (X : C) : (S.inclusion.obj X).base ≅ X :=
    eqToIso (congrArg Object.base (S.inclusion_obj X))
  have copyIso_inclusion (X : C) :
      (copyIso (S.inclusion.obj X)).hom =
        S.inclusion.map (baseIso X).hom := by
    dsimp [copyIso, baseIso, eqToIso.hom]
    rw [eqToHom_map]
  have restriction_component (X : C) (x : P.obj.a.val.obj (op X)) :
      c.hom.app (op (S.inclusion.obj X).base)
        (G.map (copyIso (S.inclusion.obj X)).hom.op
          (c.inv.app (op X) x)) =
        P.obj.a.val.map (baseIso X).hom.op x := by
    rw [copyIso_inclusion]
    exact moduleMap_base _ x
  have localScalar_inclusion (X : C) (r : R.obj.obj (op X)) :
      localScalar (op (S.inclusion.obj X))
          (S.coefficientRestriction.inv.hom.app (op X) r) =
        R.obj.map (baseIso X).hom.op r := by
    rw [localScalar_apply, copyIso_inclusion]
    exact scalarMap_base _ r
  -- The existing descent criterion applies to the underlying sets.
  have hG : Presheaf.IsSheaf S.topology G :=
    twistedSheafOfRestriction J s R a S G ((Presheaf.isSheaf_of_iso_iff c).mpr
      (Presheaf.isSheaf_comp_of_isSheaf J P.obj.a.val.presheaf (forget Ab)
        P.obj.a.isSheaf))
  let N : Modules S.coefficient := ⟨V,
    Presheaf.isSheaf_of_isSheaf_comp S.topology V.presheaf (forget Ab)
      ((Presheaf.isSheaf_of_iso_iff d).mpr hG)⟩
  let U : Modules S.coefficient ⥤ Modules R := SheafOfModules.pushforward
    ((sheafCompose J (forget₂ CommRingCat RingCat)).map S.coefficientRestriction.inv)
  -- The inverse restriction comparison is linear on the original section modules.
  let z : S.inclusion.op ⋙ (V.presheaf ⋙ forget Ab) ≅ F :=
    isoWhiskerLeft S.inclusion.op d ≪≫ c
  have hz (X : C) (x : P.obj.a.val.obj (op X)) :
      z.inv.app (op X) x = P.obj.a.val.map (baseIso X).hom.op x :=
    restriction_component X x
  let inverseSection (X : Cᵒᵖ) (x : P.obj.a.val.obj X) :
      P.obj.a.val.obj (op (S.inclusion.obj X.unop).base) := z.inv.app X x
  have inverseSection_eq (X : C) (x : P.obj.a.val.obj (op X)) :
      inverseSection (op X) x = P.obj.a.val.map (baseIso X).hom.op x := hz X x
  let β : P.obj.a.val ⟶ (U.obj N).val := {
    app X := ModuleCat.ofHom (X := P.obj.a.val.obj X) (Y := (U.obj N).val.obj X) {
      toFun := inverseSection X
      map_add' := by
        intro x y
        change inverseSection (op X.unop) (x + y) =
          inverseSection (op X.unop) x + inverseSection (op X.unop) y
        simp only [inverseSection_eq]
        exact map_add (P.obj.a.val.map (baseIso X.unop).hom.op).hom x y
      map_smul' := by
        intro r x
        change inverseSection (op X.unop) (r • x) =
          localScalar (op (S.inclusion.obj X.unop))
              (S.coefficientRestriction.inv.hom.app X r) • inverseSection (op X.unop) x
        rw [inverseSection_eq, inverseSection_eq, localScalar_inclusion]
        exact P.obj.a.val.map_smul (baseIso X.unop).hom.op r x }
    naturality := by
      intro X Y f
      ext x
      exact ConcreteCategory.congr_hom (z.inv.naturality f) x }
  let e : P.obj.a.val ≅ (U.obj N).val := PresheafOfModules.isoMk
    (fun X ↦ (LinearEquiv.ofBijective (β.app X).hom
      (by exact ConcreteCategory.bijective_of_isIso (z.inv.app X))).toModuleIso)
    (by intro X Y f; exact β.naturality f)
  let b : U.obj N ≅ P.obj.a :=
    ((SheafOfModules.fullyFaithfulForget (ring R)).preimageIso
      (X := P.obj.a) (Y := U.obj N) e).symm
  refine ⟨N, b, ?_⟩
  -- Check the displayed normalization on the minus-one generator.
  intro X x
  have hb (Y : C) (y : P.obj.a.val.obj (op Y)) :
      b.inv.val.app (op Y) y = z.inv.app (op Y) y := rfl
  rw [hb, hb]
  have hγ : G.map (generator J s R a S X).op
      (c.inv.app (op X) (P.obj.str.val.app (op X) x)) =
        c.inv.app (op (s.inverse.obj X)) x := by
    apply (ConcreteCategory.bijective_of_isIso
      (c.hom.app (op (s.inverse.obj X)))).injective
    rw [hc']
    have h := congrArg (fun t ↦ t.val.app (op X) x) (pairIso P).hom_inv_id
    change (pairIso P).inv.val.app (op X) ((pairIso P).hom.val.app (op X) x) = x at h
    have hhom : (pairIso P).hom = P.obj.str := rfl
    rw [hhom] at h
    simpa only [Iso.inv_hom_id_app_apply] using h
  apply (ConcreteCategory.bijective_of_isIso
    (d.hom.app (op (S.inclusion.obj (s.inverse.obj X))))).injective
  have hd := ConcreteCategory.congr_hom (d.hom.naturality (generator J s R a S X).op)
    (z.inv.app (op X) (P.obj.str.val.app (op X) x))
  have hd_cancel (Y : (Object C)ᵒᵖ) (y : G.obj Y) :
      d.hom.app Y (d.inv.app Y y) = y :=
    ConcreteCategory.congr_hom (Iso.inv_hom_id_app d Y) y
  simp only [z, Iso.trans_inv, isoWhiskerLeft_inv, NatTrans.comp_app,
    whiskerLeft_app, Functor.op_obj, types_comp_apply] at hd ⊢
  have hd' := hd.trans (congrArg (fun y ↦ G.map (generator J s R a S X).op y)
    (hd_cancel (op (S.inclusion.obj X))
      (c.inv.app (op X) (P.obj.str.val.app (op X) x))))
  exact (hd_cancel (op (S.inclusion.obj (s.inverse.obj X)))
    (c.inv.app (op (s.inverse.obj X)) x)).trans (hγ.symm.trans hd'.symm)

end CategoryTheory.TwistedActionRingedSite
