/-! # Sets on a fixed twisted action site

Source: the agent-formulated twisted variant of Stacks Tag 00W0, original steps 3.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits Opposite MonoidalCategory

namespace CategoryTheory.TwistedActionRingedSite

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    (s : C ≌ C) [s.functor.IsContinuous J J] [s.inverse.IsContinuous J J]
    (R : Sheaf J CommRingCat.{u})
    (a : (s.inverse.sheafPushforwardContinuous CommRingCat.{u} J J).obj R ≅ R)

private def generator (S : Site J s R a) (X : C) :
    letI := S.category
    letI := S.inclusion_continuous
    S.inclusion.obj (s.inverse.obj X) ⟶ S.inclusion.obj X := by
  let := S.category
  let := S.inclusion_continuous
  exact (S.arrows (s.inverse.obj X) X).symm ⟨-1, 𝟙 _⟩

omit [s.functor.IsContinuous J J] in
private theorem generator_naturality (S : Site J s R a) {X Y : C} (f : X ⟶ Y) :
    letI := S.category
    letI := S.inclusion_continuous
    S.inclusion.map (s.inverse.map f) ≫ generator J s R a S Y =
          generator J s R a S X ≫ S.inclusion.map f := by
  let := S.category
  let := S.inclusion_continuous
  have h₀ (Z : C) := S.arrows_comp (s.inverse.obj Z) (s.inverse.obj Z) Z
    0 (-1) (𝟙 _) (𝟙 _)
  have h₁ (Z : C) := S.arrows_comp (s.inverse.obj Z) Z Z
    (-1) 0 (𝟙 _) (𝟙 _)
  have h₀' (Z : C) : (S.powerComp 0 (-1)).hom.app Z = 𝟙 _ := by
    have hi := (S.arrows (s.inverse.obj Z) (s.inverse.obj Z)).symm_apply_apply (𝟙 _)
    rw [S.arrows_id] at hi
    have h := h₀ Z
    simp only [hi, Category.id_comp, Equiv.apply_symm_apply, Functor.map_id] at h
    exact (eq_of_heq (Sigma.mk.inj h).2).symm
  have h₁' (Z : C) : (S.powerComp (-1) 0).hom.app Z = 𝟙 _ := by
    have hi := (S.arrows Z Z).symm_apply_apply (𝟙 _)
    rw [S.arrows_id] at hi
    have h := h₁ Z
    simp only [hi, Category.comp_id, Equiv.apply_symm_apply, Functor.map_id,
      Category.id_comp] at h
    exact (eq_of_heq (Sigma.mk.inj h).2).symm
  apply (S.arrows _ _).injective
  have hf := (S.arrows _ _).symm_apply_apply (S.inclusion.map f)
  have hsf := (S.arrows _ _).symm_apply_apply (S.inclusion.map (s.inverse.map f))
  rw [S.arrows_inclusion] at hf hsf
  rw [← hf, ← hsf]
  dsimp only [generator]
  rw [S.arrows_comp, S.arrows_comp]
  simp [h₀', h₁']

private theorem isIso_of_composites {D : Type*} [Category D] {X Y : D}
    (f : X ⟶ Y) (g : Y ⟶ X) [IsIso (f ≫ g)] [IsIso (g ≫ f)] : IsIso f := by
  let l := inv (g ≫ f) ≫ g
  let r := g ≫ inv (f ≫ g)
  have hl : l ≫ f = 𝟙 _ := by simp [l, Category.assoc]
  have hr : f ≫ r = 𝟙 _ := by simp [r, ← Category.assoc]
  have h : l = r := by
    calc
      l = l ≫ (f ≫ r) := by rw [hr, Category.comp_id]
      _ = r := by rw [← Category.assoc, hl, Category.id_comp]
  exact ⟨⟨r, hr, by rw [← h]; exact hl⟩⟩

omit [s.functor.IsContinuous J J] in
private theorem generator_isIso (S : Site J s R a) (X : C) :
    letI := S.category
    letI := S.inclusion_continuous
    IsIso (generator J s R a S X) := by
  let := S.category
  let := S.inclusion_continuous
  let g : S.inclusion.obj X ⟶ S.inclusion.obj (s.inverse.obj X) :=
    (S.arrows X (s.inverse.obj X)).symm ⟨1, s.counitInv.app X⟩
  have hfg : generator J s R a S X ≫ g = S.inclusion.map
      (s.inverse.map (s.counitInv.app X) ≫
        (S.powerComp (-1) 1).hom.app (s.inverse.obj X)) := by
    apply (S.arrows _ _).injective
    dsimp only [generator, g]
    rw [S.arrows_comp, S.arrows_inclusion]
    simp
  have hgf : g ≫ generator J s R a S X = S.inclusion.map
      (s.counitInv.app X ≫ (S.powerComp 1 (-1)).hom.app X) := by
    apply (S.arrows _ _).injective
    dsimp only [generator, g]
    rw [S.arrows_comp, S.arrows_inclusion]
    simp
  have : IsIso (generator J s R a S X ≫ g) := by rw [hfg]; infer_instance
  have : IsIso (g ≫ generator J s R a S X) := by rw [hgf]; infer_instance
  exact isIso_of_composites _ g

-- The integer-labelled presentation is generated by base arrows and one invertible arrow.

omit [s.functor.IsContinuous J J] in
private theorem generator_induction (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (P : ∀ {X Y : C}, (S.inclusion.obj X ⟶ S.inclusion.obj Y) → Prop)
        (_hzero : ∀ {X Y : C} (f : X ⟶ Y), P (S.inclusion.map f))
        (_hcomp : ∀ {X Y Z : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
          (g : S.inclusion.obj Y ⟶ S.inclusion.obj Z), P f → P g → P (f ≫ g))
        (_hinv : ∀ {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y)
          [IsIso f], P f → P (inv f))
        (_hgen : ∀ X : C, P (generator J s R a S X))
        {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y),
        P f := by
  let := S.category
  let := S.inclusion_continuous
  intro P hzero hcomp hinv hgen X Y f
  let Q (n : ℤ) := ∀ (X Y : C) (f : X ⟶ (s ^ n).functor.obj Y),
    P ((S.arrows X Y).symm ⟨n, f⟩)
  have h₀ : Q 0 := by
    intro X Y f
    have hf := (S.arrows X Y).symm_apply_apply (S.inclusion.map f)
    rw [S.arrows_inclusion] at hf
    rw [hf]
    exact hzero f
  have hm : Q (-1) := by
    intro X Y f
    let k := f ≫ (S.powerComp 0 (-1)).inv.app Y
    have he : (S.arrows X Y).symm ⟨-1, f⟩ =
        S.inclusion.map k ≫ generator J s R a S Y := by
      apply (S.arrows X Y).injective
      have hk := (S.arrows X (s.inverse.obj Y)).symm_apply_apply (S.inclusion.map k)
      rw [S.arrows_inclusion] at hk
      rw [← hk]
      dsimp only [generator]
      rw [S.arrows_comp, Equiv.apply_symm_apply]
      simp [k, Category.assoc]
    rw [he]
    exact hcomp _ _ (hzero k) (hgen Y)
  have hp : Q 1 := by
    intro X Y f
    let g := generator J s R a S (s.functor.obj Y)
    have : IsIso g := generator_isIso J s R a S _
    let t := (S.arrows (s.functor.obj Y) Y).symm ⟨1, 𝟙 _⟩
    have ht : g ≫ t = S.inclusion.map ((S.powerComp (-1) 1).hom.app Y) := by
      apply (S.arrows _ _).injective
      dsimp only [g, generator, t]
      rw [S.arrows_comp, S.arrows_inclusion]
      simp
    have ht' : t = inv g ≫ S.inclusion.map ((S.powerComp (-1) 1).hom.app Y) := by
      rw [← ht, ← Category.assoc, IsIso.inv_hom_id, Category.id_comp]
    have hpt : P t := by
      rw [ht']
      exact hcomp _ _ (hinv g (hgen _)) (hzero _)
    let k := f ≫ (S.powerComp 0 1).inv.app Y
    have he : (S.arrows X Y).symm ⟨1, f⟩ = S.inclusion.map k ≫ t := by
      apply (S.arrows X Y).injective
      have hk := (S.arrows X (s.functor.obj Y)).symm_apply_apply (S.inclusion.map k)
      rw [S.arrows_inclusion] at hk
      rw [← hk]
      dsimp only [t]
      rw [S.arrows_comp, Equiv.apply_symm_apply]
      simp [k, Category.assoc]
    rw [he]
    exact hcomp _ _ (hzero k) hpt
  have hadd (n m : ℤ) (hn : Q n) (hm : Q m) : Q (n + m) := by
    intro X Y f
    let k := f ≫ (S.powerComp n m).inv.app Y
    have he : (S.arrows X Y).symm ⟨n + m, f⟩ =
        (S.arrows X ((s ^ m).functor.obj Y)).symm ⟨n, k⟩ ≫
          (S.arrows ((s ^ m).functor.obj Y) Y).symm ⟨m, 𝟙 _⟩ := by
      apply (S.arrows X Y).injective
      rw [S.arrows_comp, Equiv.apply_symm_apply]
      simp [k, Category.assoc]
    rw [he]
    exact hcomp _ _ (hn _ _ _) (hm _ _ _)
  have hall (n : ℤ) : Q n := by
    induction n using Int.induction_on with
    | zero => exact h₀
    | succ i hi => exact hadd _ _ hi hp
    | pred i hi => simpa only [sub_eq_add_neg] using hadd _ _ hi hm
  rcases h : S.arrows X Y f with ⟨n, g⟩
  have hf := (S.arrows X Y).symm_apply_apply f
  rw [h] at hf
  rw [← hf]
  exact hall n X Y g

private def restrictionInv (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (M : Sheaf S.topology (Type u)),
    (S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).obj M ⟶
          (s.inverse.sheafPushforwardContinuous (Type u) J J).obj
            ((S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).obj M) := by
  let := S.category
  let := S.inclusion_continuous
  intro M
  exact ⟨{
    app := fun X ↦ M.obj.map (generator J s R a S X.unop).op
    naturality := by
      intro X Y f
      change M.obj.map (S.inclusion.map f.unop).op ≫
          M.obj.map (generator J s R a S Y.unop).op =
        M.obj.map (generator J s R a S X.unop).op ≫
          M.obj.map (S.inclusion.map (s.inverse.map f.unop)).op
      rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp,
        generator_naturality] }⟩

omit [s.functor.IsContinuous J J] in
private theorem restrictionInv_isIso (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (M : Sheaf S.topology (Type u)), IsIso (restrictionInv J s R a S M) := by
  let := S.category
  let := S.inclusion_continuous
  intro M
  have : ∀ X : Cᵒᵖ, IsIso ((restrictionInv J s R a S M).hom.app X) := by
    intro X
    have := generator_isIso J s R a S X.unop
    exact M.obj.map_isIso (generator J s R a S X.unop).op
  have : IsIso (restrictionInv J s R a S M).hom := NatIso.isIso_of_isIso_app _
  exact (ObjectProperty.isIso_hom_iff _).mp inferInstance

omit [s.functor.IsContinuous J J] in
private theorem restrictionInv_naturality (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ {M N : Sheaf S.topology (Type u)} (f : M ⟶ N),
    restrictionInv J s R a S M ≫
            (s.inverse.sheafPushforwardContinuous (Type u) J J).map
              ((S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).map f) =
          (S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).map f ≫
            restrictionInv J s R a S N := by
  let := S.category
  let := S.inclusion_continuous
  intro M N f
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext X
  exact f.hom.naturality (generator J s R a S X.unop).op

private noncomputable def setRestrictionFunctor (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    Sheaf S.topology (Type u) ⥤
          Pairs (s.inverse.sheafPushforwardContinuous (Type u) J J) := by
  let := S.category
  let := S.inclusion_continuous
  exact {
    obj M := by
      have := restrictionInv_isIso J s R a S M
      exact ⟨{ a := (S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).obj M
               str := inv (restrictionInv J s R a S M) }, inferInstance⟩
    map {M N} f := by
      have := restrictionInv_isIso J s R a S M
      have := restrictionInv_isIso J s R a S N
      exact ⟨{ f := (S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).map f
               h := by
                 change (s.inverse.sheafPushforwardContinuous (Type u) J J).map
                     ((S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).map f) ≫
                     inv (restrictionInv J s R a S N) =
                   inv (restrictionInv J s R a S M) ≫
                     (S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).map f
                 rw [IsIso.eq_inv_comp, ← Category.assoc, IsIso.comp_inv_eq]
                 exact restrictionInv_naturality J s R a S f }⟩ }

omit [s.functor.IsContinuous J J] in
private theorem naturality_on_generators (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (F G : (Object C)ᵒᵖ ⥤ Type u)
        (η : S.inclusion.op ⋙ F ⟶ S.inclusion.op ⋙ G)
        (_hη : ∀ X : C,
          F.map (generator J s R a S X).op ≫ η.app (op (s.inverse.obj X)) =
            η.app (op X) ≫ G.map (generator J s R a S X).op)
        {X Y : C} (f : S.inclusion.obj X ⟶ S.inclusion.obj Y),
        F.map f.op ≫ η.app (op X) = η.app (op Y) ≫ G.map f.op := by
  let := S.category
  let := S.inclusion_continuous
  intro F G η hη X Y f
  apply generator_induction J s R a S
    (fun {X Y} f ↦ F.map f.op ≫ η.app (op X) = η.app (op Y) ≫ G.map f.op)
    (fun f ↦ η.naturality f.op) ?_ ?_ hη f
  · intro X Y Z f g hf hg
    simp only [op_comp, Functor.map_comp]
    calc
      (F.map g.op ≫ F.map f.op) ≫ η.app (op X) =
          F.map g.op ≫ (F.map f.op ≫ η.app (op X)) := Category.assoc _ _ _
      _ = F.map g.op ≫ (η.app (op Y) ≫ G.map f.op) := by rw [hf]
      _ = (F.map g.op ≫ η.app (op Y)) ≫ G.map f.op :=
        (Category.assoc _ _ _).symm
      _ = _ := by rw [hg, Category.assoc]
  · intro X Y f _ hf
    simp only [op_inv, Functor.map_inv]
    rw [IsIso.inv_comp_eq, ← Category.assoc, IsIso.eq_comp_inv]
    exact hf.symm

private def objectIso (S : Site J s R a) (X : Object C) :
    letI := S.category
    letI := S.inclusion_continuous
    S.inclusion.obj X.base ≅ X := by
  let := S.category
  let := S.inclusion_continuous
  exact eqToIso (S.inclusion_obj X.base)

private def extendMap (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (F G : (Object C)ᵒᵖ ⥤ Type u)
        (η : S.inclusion.op ⋙ F ⟶ S.inclusion.op ⋙ G)
        (_hη : ∀ X : C,
          F.map (generator J s R a S X).op ≫ η.app (op (s.inverse.obj X)) =
            η.app (op X) ≫ G.map (generator J s R a S X).op),
        F ⟶ G := by
  let := S.category
  let := S.inclusion_continuous
  intro F G η hη
  exact {
    app X := F.map (objectIso J s R a S X.unop).hom.op ≫
      η.app (op X.unop.base) ≫ G.map (objectIso J s R a S X.unop).inv.op
    naturality {X Y} f := by
      let eX := objectIso J s R a S X.unop
      let eY := objectIso J s R a S Y.unop
      have h := naturality_on_generators J s R a S F G η hη
        (eY.hom ≫ f.unop ≫ eX.inv)
      apply (cancel_epi (F.map eX.inv.op)).1
      apply (cancel_mono (G.map eY.hom.op)).1
      change (F.map eX.inv.op ≫ (F.map f ≫
          F.map eY.hom.op ≫ η.app (op Y.unop.base) ≫ G.map eY.inv.op)) ≫
            G.map eY.hom.op =
        (F.map eX.inv.op ≫ (F.map eX.hom.op ≫
          η.app (op X.unop.base) ≫ G.map eX.inv.op) ≫ G.map f) ≫ G.map eY.hom.op
      have hXX : F.map eX.inv.op ≫ F.map eX.hom.op = 𝟙 _ := by
        rw [← Functor.map_comp, ← op_comp, Iso.hom_inv_id, op_id, Functor.map_id]
      have hYY : G.map eY.inv.op ≫ G.map eY.hom.op = 𝟙 _ := by
        rw [← Functor.map_comp, ← op_comp, Iso.hom_inv_id, op_id, Functor.map_id]
      simp only [Category.assoc]
      rw [hYY, Category.comp_id]
      rw [← Category.assoc (F.map eX.inv.op) (F.map eX.hom.op), hXX,
        Category.id_comp]
      simpa only [op_comp, Functor.map_comp, Category.assoc, Quiver.Hom.op_unop] using h }

omit [s.functor.IsContinuous J J] in
private theorem extendMap_app (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∀ (F G : (Object C)ᵒᵖ ⥤ Type u)
        (η : S.inclusion.op ⋙ F ⟶ S.inclusion.op ⋙ G) (hη) (X : C),
        (extendMap J s R a S F G η hη).app (op (S.inclusion.obj X)) = η.app (op X) := by
  let := S.category
  let := S.inclusion_continuous
  intro F G η hη X
  let e := objectIso J s R a S (S.inclusion.obj X)
  let b := eqToIso (congrArg Object.base (S.inclusion_obj X))
  have he : e.hom = S.inclusion.map b.hom := by
    dsimp only [e, objectIso, b, eqToIso.hom]
    rw [eqToHom_map]
  have hn := η.naturality b.hom.op
  change F.map (S.inclusion.map b.hom).op ≫ η.app (op (S.inclusion.obj X).base) =
    η.app (op X) ≫ G.map (S.inclusion.map b.hom).op at hn
  rw [← he] at hn
  change F.map e.hom.op ≫ η.app (op (S.inclusion.obj X).base) ≫ G.map e.inv.op = _
  rw [← Category.assoc, hn, Category.assoc, ← Functor.map_comp, ← op_comp,
    Iso.inv_hom_id, op_id]
  simp

omit [s.functor.IsContinuous J J] in
private theorem setRestrictionFunctor_faithful (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    (setRestrictionFunctor J s R a S).Faithful := by
  let := S.category
  let := S.inclusion_continuous
  exact {
    map_injective := by
      intro M N f g h
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext X
      have h' := congrArg (fun t ↦ t.hom.f.hom.app (op X.unop.base)) h
      change f.hom.app (op (S.inclusion.obj X.unop.base)) =
        g.hom.app (op (S.inclusion.obj X.unop.base)) at h'
      have hX : op (S.inclusion.obj X.unop.base) = X :=
        congrArg op (S.inclusion_obj X.unop.base)
      exact hX ▸ h' }

omit [s.functor.IsContinuous J J] in
private theorem setRestrictionFunctor_full (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    (setRestrictionFunctor J s R a S).Full := by
  let := S.category
  let := S.inclusion_continuous
  exact {
    map_surjective := by
      intro M N f
      let η : S.inclusion.op ⋙ M.obj ⟶ S.inclusion.op ⋙ N.obj := f.hom.f.hom
      have hη (X : C) :
          M.obj.map (generator J s R a S X).op ≫ η.app (op (s.inverse.obj X)) =
            η.app (op X) ≫ N.obj.map (generator J s R a S X).op := by
        have := restrictionInv_isIso J s R a S M
        have := restrictionInv_isIso J s R a S N
        have h := f.hom.h
        change (s.inverse.sheafPushforwardContinuous (Type u) J J).map f.hom.f ≫
            inv (restrictionInv J s R a S N) =
          inv (restrictionInv J s R a S M) ≫ f.hom.f at h
        have h' : restrictionInv J s R a S M ≫
            (s.inverse.sheafPushforwardContinuous (Type u) J J).map f.hom.f =
            f.hom.f ≫ restrictionInv J s R a S N := by
          calc
            _ = restrictionInv J s R a S M ≫
                ((s.inverse.sheafPushforwardContinuous (Type u) J J).map f.hom.f ≫
                  inv (restrictionInv J s R a S N)) ≫
                  restrictionInv J s R a S N := by simp
            _ = _ := by rw [h]; simp
        exact congrArg (fun t ↦ t.hom.app (op X)) h'
      refine ⟨⟨extendMap J s R a S M.obj N.obj η hη⟩, ?_⟩
      apply ObjectProperty.hom_ext
      apply Endofunctor.Algebra.Hom.ext
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext X
      exact extendMap_app J s R a S M.obj N.obj η hη X.unop }

private theorem setRestrictionFunctor_essSurj [HasPullbacks C] (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    (setRestrictionFunctor J s R a S).EssSurj := by
  let := S.category
  let := S.inclusion_continuous
  exact {
    mem_essImage M := by
      let τ : s.inverse.op ⋙ M.obj.a.obj ≅ M.obj.a.obj :=
        (sheafToPresheaf J (Type u)).mapIso (pairIso M)
      obtain ⟨G, c, hc⟩ := twistedPresheafExtension J s R a S M.obj.a.obj τ
      have hG : Presheaf.IsSheaf S.topology G :=
        twistedSheafOfRestriction J s R a S G
          ((Presheaf.isSheaf_of_iso_iff c).mpr M.obj.a.property)
      let N : Sheaf S.topology (Type u) := ⟨G, hG⟩
      let e : (S.inclusion.sheafPushforwardContinuous (Type u) J S.topology).obj N ≅
          M.obj.a := ObjectProperty.isoMk _ c
      have := restrictionInv_isIso J s R a S N
      have hα : restrictionInv J s R a S N ≫
          (s.inverse.sheafPushforwardContinuous (Type u) J J).map e.hom =
            e.hom ≫ (pairIso M).inv := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext X
        exact hc X.unop
      have he : (s.inverse.sheafPushforwardContinuous (Type u) J J).map e.hom ≫
          M.obj.str = ((setRestrictionFunctor J s R a S).obj N).obj.str ≫ e.hom := by
        change _ = inv (restrictionInv J s R a S N) ≫ e.hom
        calc
          _ = inv (restrictionInv J s R a S N) ≫
              (restrictionInv J s R a S N ≫
                (s.inverse.sheafPushforwardContinuous (Type u) J J).map e.hom) ≫
                  M.obj.str := by simp
          _ = inv (restrictionInv J s R a S N) ≫
              (e.hom ≫ (pairIso M).inv) ≫ M.obj.str := by rw [hα]
          _ = _ := by
            change _ ≫ (_ ≫ (pairIso M).inv) ≫ (pairIso M).hom = _
            simp [Category.assoc]
      exact ⟨N, ⟨ObjectProperty.isoMk _ (Endofunctor.Algebra.isoMk e he)⟩⟩ }

/-- Set-sheaf restriction for a specified underlying twisted action site.

Source: original step 3 of the agent-formulated twisted variant of Stacks 00W0,
`sites.tex`, proposition-sheaves-on-group
(blueprint: lem-sf-twisted-action-set-restriction).

Proof: let γ_X be the arrow labelled (-1, identity). Its composites with the
arrow labelled (1, s.counitInv at X) are images of base isomorphisms, so γ_X is
invertible. The identity and composition rules normalize the power comparisons
in degrees (0,-1) and (-1,0), giving naturality of γ. Restrict each sheaf and take
the inverse of its γ restriction as its fixed-pair structure. Naturality of a
sheaf morphism gives the intertwining equation.

For full faithfulness, consider any property of arrows closed under composition
and inversion which holds on base arrows and γ. Degree one follows by composing
an inverse γ with a base isomorphism. To combine degrees n and m, compose the
arrows labelled (n, f followed by powerComp.inv) and (m, identity). Their composite
is exactly (n+m,f). Integer induction therefore proves the property for every
arrow. Apply this to naturality of an intertwiner, and transport its components
along inclusion_obj to obtain a sheaf map. Its restriction is the original
intertwiner, and these same object identifications prove uniqueness.

For essential surjectivity, twistedPresheafExtension extends the underlying
presheaf and invertible translation of one fixed pair. Its degree-zero comparison
identifies its restriction with the original sheaf; twistedSheafOfRestriction
therefore makes the extension a sheaf. The extension's generator equation,
multiplied by the invertible structure maps, makes the comparison an isomorphism
of fixed pairs. Use Functor.asEquivalence on this full, faithful and essentially
surjective functor. Forgetting the pair is definitionally restriction, so take
the identity natural comparison. The asserted section equation is the inverse
identity for the γ restriction map. No module operation, geometric adjunction,
nonzero ring, or nonempty site is used. -/
theorem setRestriction [HasPullbacks C] (S : Site J s R a) :
    letI := S.category
    letI := S.inclusion_continuous
    ∃ (e : Sheaf S.topology (Type u) ≌
        Pairs (s.inverse.sheafPushforwardContinuous (Type u) J J))
      (c : e.functor ⋙ forgetPairs (s.inverse.sheafPushforwardContinuous (Type u) J J) ≅
        S.inclusion.sheafPushforwardContinuous (Type u) J S.topology),
      ∀ (M : Sheaf S.topology (Type u)) (X : C)
        (x : (e.functor.obj M).obj.a.obj.obj (op (s.inverse.obj X))),
        (c.hom.app M).hom.app (op (s.inverse.obj X)) x =
          M.obj.map ((S.arrows (s.inverse.obj X) X).symm ⟨-1, 𝟙 _⟩).op
            ((c.hom.app M).hom.app (op X)
              ((e.functor.obj M).obj.str.hom.app (op X) x)) := by
  let := S.category
  let := S.inclusion_continuous
  let := setRestrictionFunctor_faithful J s R a S
  let := setRestrictionFunctor_full J s R a S
  let := setRestrictionFunctor_essSurj J s R a S
  let : (setRestrictionFunctor J s R a S).IsEquivalence := {}
  refine ⟨(setRestrictionFunctor J s R a S).asEquivalence, Iso.refl _, ?_⟩
  intro M X x
  have := restrictionInv_isIso J s R a S M
  have h := congrArg (fun t ↦ t.hom.app (op X) x)
    (IsIso.inv_hom_id (restrictionInv J s R a S M))
  exact h.symm

end CategoryTheory.TwistedActionRingedSite
