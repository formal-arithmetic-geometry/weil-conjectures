module

public import Submission.WeilConjectures.CategoryTheory.DerivedCategory.Complete.IntegralCoefficient
public import Submission.WeilConjectures.CategoryTheory.DerivedCategory.Coproducts
public import Submission.WeilConjectures.Mathlib.CategoryTheory.Abelian.GrothendieckCategory.Basic
public import Submission.WeilConjectures.CategoryTheory.Triangulated.IdempotentCompleteOfCoproducts
public import Submission.WeilConjectures.FromJoel.CategoryTheory.ObjectProperty.Retract

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-!
# Idempotent completeness of `D_comp(J, 𝒪_E)`

For an ideal `I = (ϖ)` generated by a nonzerodivisor, the derived complete objects of `D(J, R)`
are the right orthogonal of the objects on which `ϖ` acts invertibly
(`DerivedCategory.derivedComplete_iff_rightOrthogonal`), hence are stable under retracts. As
`D(J, R)` has coproducts, it is idempotent complete (Bökstedt–Neeman,
`CategoryTheory.Pretriangulated.isIdempotentComplete_of_hasCoproducts`), and so is the full
subcategory `D_comp(J, 𝒪_E)` of derived complete objects.

## Main statements

- `DerivedCategory.isStableUnderRetracts_derivedComplete`
- `DerivedCategoryDerivedCompleteIntegral.isIdempotentComplete`
-/

@[expose] public section

universe w u

open CategoryTheory Limits

namespace DerivedCategory

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  (J : GrothendieckTopology C) {R : Type (u + 1)} [CommRing R]

/-- The derived category of sheaves of `R`-modules is idempotent complete: it has coproducts
(Bökstedt–Neeman). -/
instance isIdempotentComplete_sheaf :
    IsIdempotentComplete (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) :=
  have : HasCoproducts.{u + 1} (Sheaf J (ModuleCat.{u + 1} R)) := fun K ↦
    IsGrothendieckAbelian.hasColimitsOfShape_discrete (Sheaf J (ModuleCat.{u + 1} R)) K
  have : HasCoproducts.{u + 1} (DerivedCategory (Sheaf J (ModuleCat.{u + 1} R))) := fun K ↦
    DerivedCategory.hasColimitsOfShape_discrete K
  Pretriangulated.isIdempotentComplete_of_hasCoproducts

/-- For an ideal `I = (ϖ)` generated by a nonzerodivisor, derived complete objects are stable
under retracts: they are the right orthogonal of the objects on which `ϖ` acts invertibly. -/
lemma isStableUnderRetracts_derivedComplete {I : Ideal R} {ϖ : R} (hϖ : ϖ ∈ nonZeroDivisors R)
    (hI : I = Ideal.span {ϖ}) : (derivedComplete J I).IsStableUnderRetracts where
  of_retract {M N} e hN := by
    rw [derivedComplete_iff_rightOrthogonal hϖ hI] at hN ⊢
    intro Y f hY
    rw [← Category.comp_id f, ← e.retract, ← Category.assoc, hN (f ≫ e.i) hY, zero_comp]

end DerivedCategory

section RingOfIntegers

variable {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u + 1} C]
  (J : GrothendieckTopology C) (l : ℕ) [Fact l.Prime] (E : Type w) [Field E]
  [Algebra E (PadicAlgCl l)] [Algebra ℚ_[l] E] [IsScalarTower ℚ_[l] E (PadicAlgCl l)]
  [FiniteDimensional ℚ_[l] E] [Small.{u + 1} E]

/-- The derived complete objects of `D(J, 𝒪_E)` are stable under retracts. -/
instance DerivedCategory.isStableUnderRetracts_derivedCompleteIntegral :
    (DerivedCategory.derivedCompleteIntegral J l E).IsStableUnderRetracts := by
  obtain ⟨ϖ, hϖ, hI⟩ :=
    PadicAlgCl.exists_mem_nonZeroDivisors_maximalIdealShrink_eq_span.{w, u} l E
  exact DerivedCategory.isStableUnderRetracts_derivedComplete J hϖ hI

/-- The category `D_comp(J, 𝒪_E)` of derived complete objects is idempotent complete. -/
instance DerivedCategoryDerivedCompleteIntegral.isIdempotentComplete :
    IsIdempotentComplete (DerivedCategoryDerivedCompleteIntegral J l E) :=
  inferInstanceAs <|
    IsIdempotentComplete (DerivedCategory.derivedCompleteIntegral J l E).FullSubcategory

end RingOfIntegers
