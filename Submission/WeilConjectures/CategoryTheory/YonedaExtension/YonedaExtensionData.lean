module

public import Mathlib.CategoryTheory.Abelian.Basic
public import Mathlib.Algebra.Homology.ExactSequence
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.Basic
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExtClass
public import Mathlib.CategoryTheory.Preadditive.Injective.Basic
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-! # Exact Yoneda extensions

Source: Stacks Project, Tags 06XU, 06XV, and Homology Section 010I.
The extension objects, endpoint-fixed equivalence and geometric Baer construction
are moved here unchanged from the comparison module to permit separate proofs.
(blueprint: def-coef-yoneda-extension-data)
-/

@[expose] public section

universe u v w

namespace CategoryTheory

open Limits Abelian

/-- A degree `i` extension `0 → V → E₁ → ⋯ → Eᵢ → U → 0`.
The endpoint isomorphisms allow the use of the same sequence with named endpoints.

Source: Stacks Project, Derived Categories, definition preceding Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
structure YonedaExtension (A : Type u) [Category.{v} A] [HasZeroMorphisms A]
    (V U : A) (i : ℕ) where
  /-- The nonzero part of the sequence. -/
  sequence : ComposableArrows A (i + 1)
  /-- Identification of its left endpoint. -/
  leftIso : sequence.left ≅ V
  /-- Identification of its right endpoint. -/
  rightIso : sequence.right ≅ U
  /-- Exactness at all middle terms. -/
  exact : sequence.Exact
  /-- Exactness at the left endpoint. -/
  first_mono : Mono (sequence.map' 0 1)
  /-- Exactness at the right endpoint. -/
  last_epi : Epi (sequence.map' i (i + 1))

namespace YonedaExtension

variable {A : Type u} [Category.{v} A] [HasZeroMorphisms A]

/-- The map induced on the left endpoint by a map of extension sequences.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def leftMap {V U V' U' : A} {i : ℕ} (E : YonedaExtension A V U i)
    (F : YonedaExtension A V' U' i) (φ : E.sequence ⟶ F.sequence) : V ⟶ V' :=
  E.leftIso.inv ≫ φ.app 0 ≫ F.leftIso.hom

/-- The map induced on the right endpoint by a map of extension sequences.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def rightMap {V U V' U' : A} {i : ℕ} (E : YonedaExtension A V U i)
    (F : YonedaExtension A V' U' i) (φ : E.sequence ⟶ F.sequence) : U ⟶ U' :=
  E.rightIso.inv ≫ φ.app (Fin.last (i + 1)) ≫ F.rightIso.hom

/-- A generating endpoint-fixed arrow for Yoneda equivalence.

Source: Stacks Project, Derived Categories, definition preceding Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def Related {V U : A} {i : ℕ} (E F : YonedaExtension A V U i) : Prop :=
  ∃ φ : E.sequence ⟶ F.sequence, E.leftMap F φ = 𝟙 V ∧ E.rightMap F φ = 𝟙 U

/-- The equivalence relation generated by endpoint-fixed arrows, including both
orientations and finite compositions.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def Equivalent {V U : A} {i : ℕ} (E F : YonedaExtension A V U i) : Prop :=
  Relation.EqvGen Related E F

/-- Actual Yoneda extension classes, without any identification with derived Ext.

Source: Stacks Project, Derived Categories, Tag 06XU
(blueprint: lem-coef-yoneda-derived-ext-comparison). -/
def Classes (V U : A) (i : ℕ) : Type (max u v) :=
  Quot (Equivalent (A := A) (V := V) (U := U) (i := i))

end YonedaExtension

namespace YonedaExtension

variable {A : Type u} [Category.{v} A] [Abelian A]

end YonedaExtension

end CategoryTheory
