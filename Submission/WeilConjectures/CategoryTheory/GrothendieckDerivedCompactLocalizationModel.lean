module
public import Submission.WeilConjectures.CategoryTheory.CompactlyGenerated
public import Submission.WeilConjectures.CategoryTheory.GrothendieckAbelian.HasDerivedCategory
import Mathlib.CategoryTheory.Adjunction.Additive
import Submission.WeilConjectures.CategoryTheory.GrothendieckDerivedExactLocalization
import Submission.WeilConjectures.CategoryTheory.GrothendieckDerivedGabrielPopescuPresentation

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 3

/-! # A compactly generated source for derived Gabriel--Popescu localization

Source: Stacks Project, Tags 0F5V and 0F5X, first paragraph.
-/

@[expose] public section

universe w uA vA vH

open CategoryTheory.Limits

namespace CategoryTheory

/-- A Grothendieck derived category admits an exact localization from a compactly
 generated triangulated category. Source: Stacks Project, Tag 0F5V and the compact
 generation observation in the first paragraph of Tag 0F5X.
 (auxiliary; not a blueprint node)

 Proof in words: choose a generator G of A and shrink its endomorphism ring
 (with the appropriate opposite for left modules) to universe w by local smallness.
 Gabriel--Popescu gives an exact left adjoint F from w-sized modules, with fully
 faithful right adjoint U. The size extension requires an argument. For a larger
 family A_i, form P = the coproduct of A_i[0] in D(A), using the displayed
 coproduct hypothesis. For every Y in D(A) in degrees at least 1, Hom(P,Y) is
 the product of the zero groups Hom(A_i[0],Y); hence P is in degrees at most 0.
 Truncation gives Hom(P,X[0]) = Hom(H^0(P),X). Thus H^0(P), with its induced
 inclusions, is the coproduct of A_i in A; no assertion that H^0 preserves all
 derived coproducts is needed.

 Extend F to larger modules by a concrete free presentation: for M, take the
 free module on its elements, then the free module on the elements of its kernel,
 and take in A the cokernel of the corresponding map between coproducts of G.
 The presentation gives Hom(F(M),X) = Hom(M,U(X)), naturally in M and X.
 This F agrees with the original F on w-sized modules, so its counit is invertible.
 It remains exact: for injective I in A, the original Gabriel--Popescu theorem
 makes U(I) injective among w-sized modules. Baer's criterion (Stacks Tag 05NU)
 tests only ideals of the w-sized ring, so U(I), lifted to the larger universe,
 is also injective there. The adjunction and enough injectives in A now show
 that F preserves monomorphisms; as a left adjoint it is right exact.
 Take modules in universe
 max(w,vH) and their derived category with Hom types in that universe. The exact
 left adjoint induces L on derived categories, with its shift comparison and
 preservation of distinguished triangles. Derive the right adjoint on K-injective
 representatives. The abelian counit is invertible termwise, hence the derived
 counit is invertible. The source has arbitrary coproducts and is compactly
 generated by the free rank-one module in degree zero: maps from its shifts
 compute cohomology, commute with sums, and jointly detect zero objects. Finally
 lift the source object universe to max(uA,vA,max(w,vH)+1), transporting all these
 structures and the adjunction along the equivalence. None of this construction
 uses a functor H or a Brown representation. -/
theorem grothendieckDerived_compact_localization_model
    {A : Type uA} [Category.{vA} A] [Abelian A]
    [IsGrothendieckAbelian.{w} A] [HasDerivedCategory.{w} A]
    [HasCoproducts.{max w vA vH} (DerivedCategory A)] :
    ∃ (B : Type (max uA vA ((max w vH) + 1))) (cB : Category.{max w vH} B),
      letI := cB
      ∃ (zB : HasZeroObject B) (sB : HasShift B ℤ) (pB : Preadditive B),
      letI := zB
      letI := sB
      letI := pB
      ∃ aB : ∀ n : ℤ, (shiftFunctor B n).Additive,
      letI := aB
      ∃ tB : Pretriangulated B,
      letI := tB
      ∃ (iB : IsTriangulated B) (sumsB : HasCoproducts.{max w vH} B),
      letI := iB
      letI := sumsB
      IsCompactlyGeneratedTriangulated.{max w vH} B ∧
      ∃ (L : B ⥤ DerivedCategory A) (R : DerivedCategory A ⥤ B)
        (adj : L ⊣ R) (sL : L.CommShift ℤ),
      letI := sL
      L.IsTriangulated ∧ IsIso adj.counit := by
  obtain ⟨S, rS, hD, F, U, adj₀, addF, limF, colimF, hc₀,
    B, cB, zB, sB, pB, aB, tB, iB, sumsB, hB, e, se, he⟩ :=
    grothendieckDerived_gabriel_popescu_presentation.{w, uA, vA, vH} (A := A)
  let := rS
  let := hD
  let := addF
  let := limF
  let := colimF
  let := cB
  let := zB
  let := sB
  let := pB
  let := aB
  let := tB
  let := iB
  let := sumsB
  let := se
  let := he
  let := adj₀.right_adjoint_additive
  obtain ⟨hL, hc⟩ := grothendieckDerived_exact_localization F U adj₀ hc₀
  let RD := U.rightDerivedFunctor
  let adj := adj₀.mapDerivedCategoryRightDerivedAdjunction
  let L := e.functor ⋙ F.mapDerivedCategory
  let R := RD ⋙ e.inverse
  let adjB : L ⊣ R := e.toAdjunction.comp adj
  have hcB : IsIso adjB.counit := by
    let := hc
    have : ∀ X, IsIso (adjB.counit.app X) := by
      intro X
      change IsIso ((e.toAdjunction.comp adj).counit.app X)
      rw [Adjunction.comp_counit_app]
      infer_instance
    exact NatIso.isIso_of_isIso_app _
  exact ⟨B, cB, zB, sB, pB, aB, tB, iB, sumsB, hB,
    L, R, adjB, inferInstance, inferInstance, hcB⟩

end CategoryTheory
