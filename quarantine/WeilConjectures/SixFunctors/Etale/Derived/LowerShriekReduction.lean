/-!
# `Rf_!` and reduction modulo a regular sequence

For `f : X ⟶ Y` admitting a compactification, the objects `L` of `D(Y_ét)` at which the
projection map `PF : Rf_! K ⊗ᴸ L ⟶ Rf_!(K ⊗ᴸ Lf^* L)` is an isomorphism for every `K` contain the
unit (`AlgebraicGeometry.Etale.isIso_projectionMap_app_app_tensorUnit`) and are closed under
isomorphisms and cones, the projection map commuting with the shifts in `L`.

For a commutative ring `Λ` and a Λ-module `M` on which `r ∈ Λ` is a nonzerodivisor, the constant
complex `(M/rM)_Y` is the cone of `r` on `M_Y`. Hence the projection map is an isomorphism at
`(Λ/J)_Y` whenever `J` is generated by a weakly regular sequence, and `Rf_!` commutes with the
reduction `K ↦ K ⊗ᴸ (Λ/J)`
(`nonempty_iso_reductionModIdeal_rightDerivedLowerShriek_of_isWeaklyRegular`).
-/

@[expose] public section

universe u' u

open CategoryTheory Limits MonoidalCategory Pretriangulated Pointwise

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

section General

variable (A : Type u') [Category.{u + 1} A] [Abelian A] [IsGrothendieckAbelian.{u + 1} A]
  [MonoidalCategory A] [MonoidalPreadditive A] [SymmetricCategory A] [MonoidalClosed A]
  [Abelian.HasFunctorialFlatResolution A] [Etale.UpperStarPreservesFlat A]
  {FC : A → A → Type*} {CC : A → Type (u + 1)}
  [∀ (P Q : A), FunLike (FC P Q) (CC P) (CC Q)] [ConcreteCategory.{u + 1} A FC]
  [(CategoryTheory.forget A).ReflectsIsomorphisms]
  [PreservesFilteredColimitsOfSize.{u + 1, u + 1} (CategoryTheory.forget A)]
  [∀ Z : Scheme.{u}, Z.smallEtaleTopology.HasSheafCompose (CategoryTheory.forget A)]
  {X Y : Scheme.{u}} (f : X ⟶ Y) [HasCompactification f]

/-- The projection map `Rf_! K ⊗ᴸ L ⟶ Rf_!(K ⊗ᴸ Lf^* L)` is an isomorphism for every `K`. -/
def ProjectionFormulaAt (L : _root_.DerivedCategory (Sheaf Y.smallEtaleTopology A)) : Prop :=
  ∀ K : _root_.DerivedCategory (Sheaf X.smallEtaleTopology A), HasProjectionFormula A f K L

/-- The projection map `Rf_! K ⊗ᴸ 𝟙 ⟶ Rf_!(K ⊗ᴸ Lf^* 𝟙)` at the unit is an isomorphism: it is the
projection map of `Rg_*` at the unit, for the proper part `g` of the compactification, followed
by isomorphisms. -/
lemma projectionFormulaAt_tensorUnit : ProjectionFormulaAt A f (𝟙_ _) := fun K ↦ by
  change IsIso (((projectionMap A f).app K).app _)
  have := isIso_rightDerivedLowerStarProjectionMap_app_app_tensorUnit A
    (HasCompactification.compactification f).g
    (D(((HasCompactification.compactification f).i)_!open[A]).obj K)
  rw [projectionMap, projectionMapOfCompactification_app_app]
  infer_instance

variable {A f} in
/-- The projection formula at `L` passes to objects isomorphic to `L`. -/
lemma ProjectionFormulaAt.of_iso {L L' : _root_.DerivedCategory (Sheaf Y.smallEtaleTopology A)}
    (e : L ≅ L') (h : ProjectionFormulaAt A f L) : ProjectionFormulaAt A f L' := fun K ↦ by
  let τ : (-⊗ᴸ-(Y)[A]).obj ((R(f)_![A]).obj K) ⟶
      L((f)^*[A]) ⋙ (-⊗ᴸ-(X)[A]).obj K ⋙ R(f)_![A] := (projectionMap A f).app K
  have : IsIso (τ.app L) := h K
  have h' : τ.app L' = ((-⊗ᴸ-(Y)[A]).obj ((R(f)_![A]).obj K)).map e.inv ≫ τ.app L ≫
      (L((f)^*[A]) ⋙ (-⊗ᴸ-(X)[A]).obj K ⋙ R(f)_![A]).map e.hom := by
    rw [← τ.naturality, ← Category.assoc, ← Functor.map_comp, e.inv_hom_id,
      CategoryTheory.Functor.map_id, Category.id_comp]
  change IsIso (τ.app L')
  rw [h']
  infer_instance

variable {A f} in
/-- The projection formula at the first two objects of a distinguished triangle gives it at the
third: the projection map commutes with the shifts, between triangulated functors. -/
lemma ProjectionFormulaAt.obj₃
    {T : Triangle (_root_.DerivedCategory (Sheaf Y.smallEtaleTopology A))}
    (hT : T ∈ distTriang _) (h₁ : ProjectionFormulaAt A f T.obj₁)
    (h₂ : ProjectionFormulaAt A f T.obj₂) : ProjectionFormulaAt A f T.obj₃ := fun K ↦ by
  let τ : (-⊗ᴸ-(Y)[A]).obj ((R(f)_![A]).obj K) ⟶
      L((f)^*[A]) ⋙ (-⊗ᴸ-(X)[A]).obj K ⋙ R(f)_![A] := (projectionMap A f).app K
  have h₁ : IsIso (τ.app T.obj₁) := h₁ K
  have h₂ : IsIso (τ.app T.obj₂) := h₂ K
  exact NatTrans.isIso_app_obj₃_of_isIso_app_obj₁₂ τ hT h₁ h₂

/-- The projection formula at the constant complex `(M_Y)[0]` on an object `M` of `A`. -/
abbrev ProjectionFormulaAtConstant (M : A) : Prop :=
  ProjectionFormulaAt A f ((_root_.DerivedCategory.singleFunctor _ 0).obj
    ((constantSheaf Y.smallEtaleTopology A).obj M))

variable {A f} in
lemma ProjectionFormulaAtConstant.of_iso {M M' : A} (e : M ≅ M')
    (h : ProjectionFormulaAtConstant A f M) : ProjectionFormulaAtConstant A f M' :=
  ProjectionFormulaAt.of_iso ((_root_.DerivedCategory.singleFunctor _ 0).mapIso
    ((constantSheaf Y.smallEtaleTopology A).mapIso e)) h

end General

section Regular

variable {Λ : Type (u + 1)} [CommRing Λ] {X Y : Scheme.{u}} (f : X ⟶ Y) [HasCompactification f]

/-- The short exact sequence `0 ⟶ M ⟶ M ⟶ M/rM ⟶ 0` of `Λ`-modules, the first map being the
multiplication by `r`, for `r` regular on `M`. -/
noncomputable def smulQuotShortComplex (M : ModuleCat.{u + 1} Λ) (r : Λ) :
    ShortComplex (ModuleCat.{u + 1} Λ) :=
  ShortComplex.mk (r • 𝟙 M) (ModuleCat.ofHom (r • (⊤ : Submodule Λ M)).mkQ) (by
    ext x
    change Submodule.Quotient.mk (r • x) = 0
    rw [Submodule.Quotient.mk_eq_zero]
    exact Submodule.smul_mem_pointwise_smul x r ⊤ trivial)

lemma smulQuotShortComplex_shortExact (M : ModuleCat.{u + 1} Λ) {r : Λ}
    (hr : IsSMulRegular M r) : (smulQuotShortComplex M r).ShortExact := by
  refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
  · intro y
    change Submodule.Quotient.mk (p := r • (⊤ : Submodule Λ M)) y = 0 ↔ ∃ x : M, r • x = y
    rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_smul_pointwise_iff_exists]
    simp
  · intro x y hxy
    exact hr hxy
  · exact Submodule.Quotient.mk_surjective (r • (⊤ : Submodule Λ M))

/-- The constant complex `(M/rM)_Y` is the cone of the multiplication by `r` on `M_Y`. -/
lemma smulQuotTriangle_distinguished (M : ModuleCat.{u + 1} Λ) {r : Λ} (hr : IsSMulRegular M r) :
    (((smulQuotShortComplex_shortExact M hr).map_of_exact
      (constantSheaf Y.smallEtaleTopology (ModuleCat.{u + 1} Λ))).singleTriangle) ∈
        distTriang _ :=
  ((smulQuotShortComplex_shortExact M hr).map_of_exact _).singleTriangle_distinguished

lemma projectionFormulaAtConstant_unit :
    ProjectionFormulaAtConstant (ModuleCat.{u + 1} Λ) f (𝟙_ (ModuleCat.{u + 1} Λ)) :=
  (projectionFormulaAt_tensorUnit _ f).of_iso (singleFunctorObjUnitIso _ Y).symm

variable {f} in
lemma ProjectionFormulaAtConstant.quotSMulTop {M : ModuleCat.{u + 1} Λ} {r : Λ}
    (hr : IsSMulRegular M r) (h : ProjectionFormulaAtConstant (ModuleCat.{u + 1} Λ) f M) :
    ProjectionFormulaAtConstant (ModuleCat.{u + 1} Λ) f
      (ModuleCat.of Λ (QuotSMulTop r M)) :=
  ProjectionFormulaAt.obj₃ (smulQuotTriangle_distinguished (Y := Y) M hr) h h

variable {f} in
/-- The projection formula at constant complexes passes to quotients by weakly regular
sequences. -/
lemma ProjectionFormulaAtConstant.quotient_ofList (rs : List Λ) :
    ∀ (M : ModuleCat.{u + 1} Λ), RingTheory.Sequence.IsWeaklyRegular M rs →
      ProjectionFormulaAtConstant (ModuleCat.{u + 1} Λ) f M →
      ProjectionFormulaAtConstant (ModuleCat.{u + 1} Λ) f
        (ModuleCat.of Λ (M ⧸ (Ideal.ofList rs • ⊤ : Submodule Λ M))) := by
  induction rs with
  | nil =>
    intro M _ h
    exact h.of_iso (Submodule.quotEquivOfEqBot _ (by simp)).symm.toModuleIso
  | cons r rs ih =>
    intro M hrs h
    obtain ⟨hr, hrs⟩ := (RingTheory.Sequence.isWeaklyRegular_cons_iff M r rs).1 hrs
    exact (ih (ModuleCat.of Λ (QuotSMulTop r M)) hrs (h.quotSMulTop hr)).of_iso
      (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner M r rs).symm.toModuleIso

/-- **`Rf_!` commutes with reduction modulo a regular sequence.** For an ideal `J` of `Λ`
generated by a weakly regular sequence `rs`,
`Rf_!(K ⊗ᴸ (Λ/J)_X) ≅ (Rf_! K) ⊗ᴸ (Λ/J)_Y`, naturally in `K`: the projection map of `Rf_!` is an
isomorphism at `(Λ/J)_Y`, which is built from `Λ_Y` by iterated cones. This is the case of
`AlgebraicGeometry.Etale.nonempty_iso_reductionModIdeal_rightDerivedLowerShriek` in which `Λ/J`
has a Koszul resolution; it covers the principal ideals generated by nonzerodivisors and, over
a regular local coefficient ring, the maximal ideal. -/
theorem nonempty_iso_reductionModIdeal_rightDerivedLowerShriek_of_isWeaklyRegular
    (rs : List Λ) (hrs : RingTheory.Sequence.IsWeaklyRegular Λ rs) :
    Nonempty (R(f)_![ModuleCat.{u + 1} Λ] ⋙ reductionModIdeal Λ Y (Ideal.ofList rs) ≅
      reductionModIdeal Λ X (Ideal.ofList rs) ⋙ R(f)_![ModuleCat.{u + 1} Λ]) := by
  have h₀ : ProjectionFormulaAtConstant (ModuleCat.{u + 1} Λ) f (ModuleCat.of Λ Λ) :=
    projectionFormulaAtConstant_unit f
  have h := (h₀.quotient_ofList rs (ModuleCat.of Λ Λ) hrs).of_iso
    (Submodule.quotEquivOfEq _ _ (by rw [Ideal.smul_eq_mul, Ideal.mul_top])).toModuleIso
  obtain ⟨e⟩ := nonempty_iso_rightDerivedLowerShriek_comp_derivedTensorRight _ f
    ((_root_.DerivedCategory.singleFunctor _ 0).obj
      ((constantSheaf Y.smallEtaleTopology (ModuleCat.{u + 1} Λ)).obj
        (ModuleCat.of Λ (Λ ⧸ Ideal.ofList rs)))) h
  exact ⟨e ≪≫ Functor.isoWhiskerRight ((-⊗ᴸ-(X)[ModuleCat.{u + 1} Λ]).flip.mapIso
    (leftDerivedUpperStarSingleConstantSheafIso (ModuleCat.{u + 1} Λ) f _)) _⟩

end Regular

end Etale

end AlgebraicGeometry
