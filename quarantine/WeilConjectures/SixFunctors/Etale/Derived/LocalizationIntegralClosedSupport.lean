module

public import WeilConjectures.Mathlib.CategoryTheory.Triangulated.Subcategory
public import WeilConjectures.SixFunctors.Etale.Derived.LocalizationIntegral

/-!
# The closed-support triangle on `Dᵇc(-, 𝒪_E)` without an exceptional adjoint

Let `Λ` be a noetherian ring and `I = (ϖ)` an ideal generated by a nonzerodivisor, with `Λ ⧸ I`
of exponent invertible on a field `k`: the integral stage `Λ = 𝒪_E`, `I = 𝔪_E`. Let `i : Z ⟶ X`
be a closed immersion and `j : U ⟶ X` the complementary quasi-compact open immersion, `X` being
of finite type over `k`. This file proves clauses (1)–(4) of blueprint
`prop-sf-localization-all-stages` at the integral stage on the full subcategories `Dᵇc(-, Λ)` of
`AlgebraicGeometry.Etale.DerivedCategory.boundedConstructibleIntegral`, with no exceptional
adjunction `Ri_! ⊣ Ri^!` on `D(X_ét, Λ)` (all names below are in `AlgebraicGeometry.Etale`):

1. `Rj_* : Dᵇc(U, Λ) ⥤ Dᵇc(X, Λ)` (`boundedConstructibleIntegralRightDerivedLowerStar`);
2. `i_* : Dᵇc(Z, Λ) ⥤ Dᵇc(X, Λ)` has a right adjoint `Ri^!`
   (`boundedConstructibleIntegralClosedUpperShriekAdjunction`), with the Tor amplitude bound (2')
   (`torAmplitudeIn_reductionModIdeal_boundedConstructibleIntegralClosedUpperShriek`);
3. for `K ∈ Dᵇc(X, Λ)` the counit `i_* Ri^! K ⟶ K` and the unit `K ⟶ Rj_* j^* K` extend to a
   distinguished triangle with a unique third arrow
   (`existsUnique_distTriang_boundedConstructibleIntegralClosedSupportTriangle`), functorial in
   `K`, because `Hom(i_* Q[m], Rj_* G) = 0`;
4. `Ri^! Rj_* = 0` and the unit `Q ⟶ Ri^! i_* Q` is an isomorphism
   (`isZero_boundedConstructibleIntegralClosedUpperShriek_obj`,
   `isIso_boundedConstructibleIntegralClosedUpperShriekAdjunction_unit`).

When `D(X_ét, Λ)` does carry the exceptional adjunction, this `Ri^!` is the restriction of the
exceptional inverse image (`boundedConstructibleIntegralClosedUpperShriekIso`).

## Implementation notes

The hypothesis `I = (ϖ)` is recorded as a `Fact`, and the triangulated structure on `Dᵇc(-, Λ)`
(`AlgebraicGeometry.Etale.DerivedCategory.isTriangulated_boundedConstructibleIntegral`) uses that
`Λ` is noetherian and `Λ ⧸ I` is finite.
-/

@[expose] public section

universe u

open CategoryTheory Limits Pretriangulated

open scoped CategoryTheory.Functor

namespace AlgebraicGeometry

open Scheme

namespace Etale

/-- The small étale site of a scheme is essentially small. Instance search does not find this
in the presence of the imports of this file. -/
local instance (X : Scheme.{u}) : EssentiallySmall.{u + 1} X.Etale :=
  have : LocallySmall.{u + 1} X.Etale :=
    @locallySmall_of_univLE X.Etale _ (@univLE_of_max.{u, u + 1} UnivLE.self)
  essentiallySmall_of_small_of_locallySmall _

variable {Λ : Type (u + 1)} [CommRing Λ] {I : Ideal Λ} {ϖ : Λ}

/-! ### The operations on `Dᵇc(-, 𝒪_E)`

From here on the hypothesis `I = (ϖ)` for a nonzerodivisor `ϖ` is recorded as a `Fact`, so that
the functors between the full subcategories `Dᵇc(-, Λ)` can be stated without it. -/

section Operations

variable {U X Y : Scheme.{u}} [hϖI : Fact (∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})]

variable (I) in
/-- The pullback `j^* : Dᵇc(X, Λ) ⥤ Dᵇc(U, Λ)` along an open immersion, the restriction of
`Lj^*` (`AlgebraicGeometry.Etale.boundedConstructibleIntegral_leftDerivedUpperStar`).
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
noncomputable abbrev boundedConstructibleIntegralUpperStar (j : U ⟶ X) [IsOpenImmersion j] :
    (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory ⥤
      (DerivedCategory.boundedConstructibleIntegral I U).FullSubcategory :=
  ObjectProperty.liftFullSubcategory _ _ (L((j)^*[ModuleCat.{u + 1} Λ])) fun _ hK ↦
    have ⟨_, hϖ, hI⟩ := hϖI.out
    boundedConstructibleIntegral_leftDerivedUpperStar hϖ hI j hK

variable [IsNoetherianRing Λ] {k : Type u} [Field k] [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))]

variable (I) in
/-- The direct image `Rf_* : Dᵇc(Y, Λ) ⥤ Dᵇc(X, Λ)`, the restriction of `Rf_*`
(`AlgebraicGeometry.Etale.boundedConstructibleIntegral_rightDerivedLowerStar_obj`), for `f`
separated, quasi-compact and locally of finite type, `X` being of finite type over `k`.
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
noncomputable abbrev boundedConstructibleIntegralRightDerivedLowerStar (aX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType aX] [QuasiCompact aX] (f : Y ⟶ X) [IsSeparated f] [QuasiCompact f]
    [LocallyOfFiniteType f] :
    (DerivedCategory.boundedConstructibleIntegral I Y).FullSubcategory ⥤
      (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory :=
  ObjectProperty.liftFullSubcategory _ _ (R((f)_*[ModuleCat.{u + 1} Λ])) fun _ hG ↦
    have ⟨_, hϖ, hI⟩ := hϖI.out
    boundedConstructibleIntegral_rightDerivedLowerStar_obj hϖ hI aX f hG

/-- The adjunction `j^* ⊣ Rj_*` on `Dᵇc(-, Λ)` for a quasi-compact open immersion `j`, the
restriction of `AlgebraicGeometry.Etale.derivedUpperStarLowerStarAdjunction`.
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
noncomputable def boundedConstructibleIntegralUpperStarLowerStarAdjunction
    (aX : X ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX] (j : U ⟶ X)
    [IsOpenImmersion j] [QuasiCompact j] :
    boundedConstructibleIntegralUpperStar I j ⊣
      boundedConstructibleIntegralRightDerivedLowerStar I aX j :=
  (derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) j).restrictFullyFaithful
    (ObjectProperty.fullyFaithfulι _) (ObjectProperty.fullyFaithfulι _) (Iso.refl _) (Iso.refl _)

/-- For a quasi-compact open immersion `j`, the counit `j^* Rj_* ⟶ 𝟭` on `Dᵇc(-, Λ)` is an
isomorphism: `Rj_*` is fully faithful.
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
instance isIso_boundedConstructibleIntegralUpperStarLowerStarAdjunction_counit
    (aX : X ⟶ Spec (.of k)) [LocallyOfFiniteType aX] [QuasiCompact aX] (j : U ⟶ X)
    [IsOpenImmersion j] [QuasiCompact j] :
    IsIso (boundedConstructibleIntegralUpperStarLowerStarAdjunction (I := I) aX j).counit := by
  have hff :=
    (derivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) j).fullyFaithfulROfIsIsoCounit
  have := hff.full
  have := hff.faithful
  exact Adjunction.counit_isIso_of_R_fully_faithful _

end Operations

/-! ### The closed-support triangle on `Dᵇc(-, 𝒪_E)`

The recollement argument (`CategoryTheory.Pretriangulated.Recollement`) on the triangulated
categories `Dᵇc(-, Λ)`, as for the stage `ℚ̄_ℓ` in
`WeilConjectures.SixFunctors.ProEtale.Adic.Localization`: it produces the right adjoint `Ri^!` of
`i_*` without an exceptional adjoint on `D(X_ét, Λ)`. The inputs are that `Ri_*` is fully
faithful, that `j^* ⊣ Rj_*` has invertible counit, that `j^* Ri_* = 0`, and that an object
`K` of `Dᵇc(X, Λ)` with `j^* K = 0` is `Ri_*` of the object `i^* K` of `Dᵇc(Z, Λ)`
(`AlgebraicGeometry.Etale.boundedConstructibleIntegral_of_rightDerivedLowerStar_obj`). -/

section ClosedSupport

variable {U Z X : Scheme.{u}} [IsNoetherianRing Λ]
  [Fact (∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})] {k : Type u} [Field k]
  [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))] (aX : X ⟶ Spec (.of k))
  [LocallyOfFiniteType aX] [QuasiCompact aX] (i : Z ⟶ X) [IsClosedImmersion i] (j : U ⟶ X)
  [IsOpenImmersion j] [QuasiCompact j] (hij : Set.range i.base = (Set.range j.base)ᶜ)

omit [QuasiCompact j] in
include hij in
/-- `j^* i_* = 0` on `Dᵇc(-, Λ)`
(`AlgebraicGeometry.Etale.isZero_leftDerivedUpperStar_obj_rightDerivedLowerStar_obj`).
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
lemma isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj
    (M : (DerivedCategory.boundedConstructibleIntegral I Z).FullSubcategory) :
    IsZero ((boundedConstructibleIntegralUpperStar I j).obj
      ((boundedConstructibleIntegralRightDerivedLowerStar I aX i).obj M)) :=
  IsZero.of_full_of_faithful_of_isZero (DerivedCategory.boundedConstructibleIntegral I U).ι _
    (isZero_leftDerivedUpperStar_obj_rightDerivedLowerStar_obj i j (hij ▸ disjoint_compl_left)
      M.obj)

omit [QuasiCompact j] in
include hij in
/-- An object `K` of `Dᵇc(X, Λ)` with `j^* K = 0` is `i_*` of the object `i^* K` of
`Dᵇc(Z, Λ)`: the unit `K ⟶ Ri_* i^* K` is an isomorphism
(`AlgebraicGeometry.Etale.isIso_mapDerivedUpperStarLowerStarAdjunction_unit_app_of_isZero`), and
`i^* K` lies in `Dᵇc(Z, Λ)` since `Ri_* i^* K ≅ K` lies in `Dᵇc(X, Λ)`
(`AlgebraicGeometry.Etale.boundedConstructibleIntegral_of_rightDerivedLowerStar_obj`).
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
lemma boundedConstructibleIntegralRightDerivedLowerStar_essImage_of_isZero
    (K : (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory)
    (hK : IsZero ((boundedConstructibleIntegralUpperStar I j).obj K)) :
    (boundedConstructibleIntegralRightDerivedLowerStar I aX i).essImage K := by
  obtain ⟨_, hϖ, hI⟩ := (Fact.out : ∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})
  have := DerivedCategory.isClosedUnderIsomorphisms_boundedConstructibleIntegral (X := X) hϖ hI
  have := isIso_mapDerivedUpperStarLowerStarAdjunction_unit_app_of_isZero i j hij
    ((DerivedCategory.boundedConstructibleIntegral I U).ι.map_isZero hK)
  let e := asIso ((mapDerivedUpperStarLowerStarAdjunction (ModuleCat.{u + 1} Λ) i).unit.app K.obj)
  exact ⟨⟨_, boundedConstructibleIntegral_of_rightDerivedLowerStar_obj hϖ hI i
    ((DerivedCategory.boundedConstructibleIntegral I X).prop_of_iso e K.property)⟩,
    ⟨ObjectProperty.isoMk _ e.symm⟩⟩

variable [Finite (Λ ⧸ I)]

include hij in
/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the integral stage `𝒪_E`, the
vanishing: `Hom(i_* Q[m], Rj_* G) = 0` for `Q ∈ Dᵇc(Z, Λ)` and `G ∈ Dᵇc(U, Λ)`. -/
lemma subsingleton_hom_shift_boundedConstructibleIntegral
    (Q : (DerivedCategory.boundedConstructibleIntegral I Z).FullSubcategory)
    (G : (DerivedCategory.boundedConstructibleIntegral I U).FullSubcategory) (m : ℤ) :
    Subsingleton (((boundedConstructibleIntegralRightDerivedLowerStar I aX i).obj Q)⟦m⟧ ⟶
      (boundedConstructibleIntegralRightDerivedLowerStar I aX j).obj G) :=
  Recollement.subsingleton_hom_shift _ _
    (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij) Q G m

include j hij in
/-- The direct image `i_* : Dᵇc(Z, Λ) ⥤ Dᵇc(X, Λ)` along a closed immersion is a left adjoint
(`CategoryTheory.Pretriangulated.Recollement.isLeftAdjoint`).
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
lemma isLeftAdjoint_boundedConstructibleIntegralRightDerivedLowerStar :
    (boundedConstructibleIntegralRightDerivedLowerStar I aX i).IsLeftAdjoint :=
  Recollement.isLeftAdjoint (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (.ofFullyFaithful _)
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij)
    (boundedConstructibleIntegralRightDerivedLowerStar_essImage_of_isZero aX i j hij)

variable (I) in
include aX i j hij in
/-- Blueprint `prop-sf-localization-all-stages`, clause (2) at the integral stage `𝒪_E`: the
exceptional inverse image `Ri^! : Dᵇc(X, Λ) ⥤ Dᵇc(Z, Λ)` along a closed immersion, the right
adjoint of `i_*`
(`AlgebraicGeometry.Etale.isLeftAdjoint_boundedConstructibleIntegralRightDerivedLowerStar`). -/
noncomputable def boundedConstructibleIntegralClosedUpperShriek :
    (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory ⥤
      (DerivedCategory.boundedConstructibleIntegral I Z).FullSubcategory :=
  have := isLeftAdjoint_boundedConstructibleIntegralRightDerivedLowerStar (I := I) aX i j hij
  (boundedConstructibleIntegralRightDerivedLowerStar I aX i).rightAdjoint

/-- Blueprint `prop-sf-localization-all-stages`, clause (2) at the integral stage `𝒪_E`: the
direct image `i_* : Dᵇc(Z, Λ) ⥤ Dᵇc(X, Λ)` along a closed immersion has the right adjoint
`Ri^!`. It is constructed by the recollement argument
(`CategoryTheory.Pretriangulated.Recollement.isLeftAdjoint`), with no exceptional adjoint on
`D(X_ét, Λ)`: the fibre of the unit `K ⟶ Rj_* j^* K` is killed by `j^*`, hence is `i_*` of an
object of `Dᵇc(Z, Λ)`, and it represents `Hom(i_* -, K)` since `Hom(i_* Q[m], Rj_* G) = 0`. -/
noncomputable def boundedConstructibleIntegralClosedUpperShriekAdjunction :
    boundedConstructibleIntegralRightDerivedLowerStar I aX i ⊣
      boundedConstructibleIntegralClosedUpperShriek I aX i j hij :=
  have := isLeftAdjoint_boundedConstructibleIntegralRightDerivedLowerStar (I := I) aX i j hij
  Adjunction.ofIsLeftAdjoint _

/-- The closed-support triangle `i_* Ri^! K ⟶ K ⟶ Rj_* j^* K ⟶ (i_* Ri^! K)[1]` on
`Dᵇc(X, Λ)`, with third arrow `w`.
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
noncomputable abbrev boundedConstructibleIntegralClosedSupportTriangle
    (K : (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory)
    (w : (boundedConstructibleIntegralRightDerivedLowerStar I aX j).obj
        ((boundedConstructibleIntegralUpperStar I j).obj K) ⟶
      ((boundedConstructibleIntegralRightDerivedLowerStar I aX i).obj
        ((boundedConstructibleIntegralClosedUpperShriek I aX i j hij).obj K))⟦(1 : ℤ)⟧) :
    Triangle (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory :=
  Recollement.triangle (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (boundedConstructibleIntegralClosedUpperShriekAdjunction aX i j hij) K w

/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the integral stage `𝒪_E`: for
`K ∈ Dᵇc(X, Λ)`, the counit `i_* Ri^! K ⟶ K` and the unit `K ⟶ Rj_* j^* K` extend to a
distinguished triangle `i_* Ri^! K ⟶ K ⟶ Rj_* j^* K ⟶ (i_* Ri^! K)[1]` of `Dᵇc(X, Λ)`, and its
third arrow is unique, as `Hom(i_* Q[m], Rj_* G) = 0`
(`AlgebraicGeometry.Etale.subsingleton_hom_shift_boundedConstructibleIntegral`). -/
theorem existsUnique_distTriang_boundedConstructibleIntegralClosedSupportTriangle
    (K : (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory) :
    ∃! w, boundedConstructibleIntegralClosedSupportTriangle aX i j hij K w ∈ distTriang _ :=
  Recollement.existsUnique_distTriang_counit_unit _ _ (.ofFullyFaithful _)
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij)
    (boundedConstructibleIntegralRightDerivedLowerStar_essImage_of_isZero aX i j hij) K

/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the integral stage `𝒪_E`,
functoriality: for `φ : K ⟶ K'` in `Dᵇc(X, Λ)` and distinguished closed-support triangles of `K`
and `K'`, the triple `(i_* Ri^! φ, φ, Rj_* j^* φ)` is a morphism of triangles. -/
theorem exists_triangleHom_boundedConstructibleIntegralClosedSupportTriangle
    {K K' : (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory} (φ : K ⟶ K')
    {w w'} (hw : boundedConstructibleIntegralClosedSupportTriangle aX i j hij K w ∈ distTriang _)
    (hw' : boundedConstructibleIntegralClosedSupportTriangle aX i j hij K' w' ∈ distTriang _) :
    ∃ τ : boundedConstructibleIntegralClosedSupportTriangle aX i j hij K w ⟶
        boundedConstructibleIntegralClosedSupportTriangle aX i j hij K' w',
      τ.hom₁ = (boundedConstructibleIntegralRightDerivedLowerStar I aX i).map
          ((boundedConstructibleIntegralClosedUpperShriek I aX i j hij).map φ) ∧
        τ.hom₂ = φ ∧
        τ.hom₃ = (boundedConstructibleIntegralRightDerivedLowerStar I aX j).map
          ((boundedConstructibleIntegralUpperStar I j).map φ) :=
  Recollement.exists_triangleHom _ _
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij)
    φ hw hw'

/-- Blueprint `prop-sf-localization-all-stages`, clause (3) at the integral stage `𝒪_E`,
functoriality: a morphism of distinguished closed-support triangles is determined by its middle
component. -/
theorem boundedConstructibleIntegralClosedSupportTriangle_hom_ext
    {K K' : (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory} {w w'}
    (hw : boundedConstructibleIntegralClosedSupportTriangle aX i j hij K w ∈ distTriang _)
    (hw' : boundedConstructibleIntegralClosedSupportTriangle aX i j hij K' w' ∈ distTriang _)
    {τ τ' : boundedConstructibleIntegralClosedSupportTriangle aX i j hij K w ⟶
      boundedConstructibleIntegralClosedSupportTriangle aX i j hij K' w'}
    (h : τ.hom₂ = τ'.hom₂) : τ = τ' :=
  Recollement.triangleHom_ext _ _
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij)
    hw hw' h

/-- Blueprint `prop-sf-localization-all-stages`, clause (4) at the integral stage `𝒪_E`:
`Ri^! Rj_* G = 0` for `G ∈ Dᵇc(U, Λ)`, as `Hom(Q, Ri^! Rj_* G) = Hom(i_* Q, Rj_* G) = 0`. -/
theorem isZero_boundedConstructibleIntegralClosedUpperShriek_obj
    (G : (DerivedCategory.boundedConstructibleIntegral I U).FullSubcategory) :
    IsZero ((boundedConstructibleIntegralClosedUpperShriek I aX i j hij).obj
      ((boundedConstructibleIntegralRightDerivedLowerStar I aX j).obj G)) :=
  Recollement.isZero_obj_obj (boundedConstructibleIntegralUpperStarLowerStarAdjunction aX j)
    (boundedConstructibleIntegralClosedUpperShriekAdjunction aX i j hij)
    (isZero_boundedConstructibleIntegralUpperStar_obj_rightDerivedLowerStar_obj aX i j hij) G

/-- Blueprint `prop-sf-localization-all-stages`, clause (4) at the integral stage `𝒪_E`: the
unit `Q ⟶ Ri^! i_* Q` is an isomorphism, `i_*` being fully faithful on `Dᵇc(-, Λ)` (blueprint
`prop-sf-closed-unit-all-stages`). -/
instance isIso_boundedConstructibleIntegralClosedUpperShriekAdjunction_unit :
    IsIso (boundedConstructibleIntegralClosedUpperShriekAdjunction (I := I) aX i j hij).unit :=
  Adjunction.unit_isIso_of_L_fully_faithful _

/-- Blueprint `prop-sf-localization-all-stages`, clause (2') at the integral stage `𝒪_E`: if the
reductions of `K ∈ Dᵇc(X, Λ)` have Tor amplitude in `[a, b]` and the open complement `U` has
dimension `≤ d`, the reductions of `Ri^! K` have Tor amplitude in `[a, b + 2d + 1]`
(`AlgebraicGeometry.Etale.torAmplitudeIn_reductionModIdeal_of_distTriang`, applied to the
closed-support triangle). -/
theorem torAmplitudeIn_reductionModIdeal_boundedConstructibleIntegralClosedUpperShriek
    (K : (DerivedCategory.boundedConstructibleIntegral I X).FullSubcategory) (d : ℕ)
    (hd : topologicalKrullDim U ≤ (d : WithBot ℕ∞)) (a b : ℤ)
    (hab : ∀ n : ℕ, DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) X a b
      ((reductionModIdeal Λ X (I ^ (n + 1))).obj K.obj)) (n : ℕ) :
    DerivedCategory.torAmplitudeIn (ModuleCat.{u + 1} Λ) Z a (b + 2 * (d : ℤ) + 1)
      ((reductionModIdeal Λ Z (I ^ (n + 1))).obj
        ((boundedConstructibleIntegralClosedUpperShriek I aX i j hij).obj K).obj) := by
  obtain ⟨_, hϖ, hI⟩ := (Fact.out : ∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})
  obtain ⟨w, hw, -⟩ :=
    existsUnique_distTriang_boundedConstructibleIntegralClosedSupportTriangle aX i j hij K
  exact torAmplitudeIn_reductionModIdeal_of_distTriang hϖ hI aX i j K.property
    ((boundedConstructibleIntegralRightDerivedLowerStar I aX i).obj _).property
    ((DerivedCategory.boundedConstructibleIntegral I X).ι.map_distinguished _ hw) (Iso.refl _)
    (Iso.refl _) (Iso.refl _) d hd a b hab n

end ClosedSupport

/-! ### Comparison with the exceptional inverse image -/

section Comparison

variable {U Z X : Scheme.{u}} [IsDomain Λ] [IsNoetherianRing Λ] [IsAdicComplete I Λ]
  [Finite (Λ ⧸ I)] [Fact (∃ ϖ ∈ nonZeroDivisors Λ, I = Ideal.span {ϖ})]
  {k : Type u} [Field k] [HasInvertibleExponent (Λ ⧸ I) (Spec (.of k))]
  (hϖ : ϖ ∈ nonZeroDivisors Λ) (hI : I = Ideal.span {ϖ})
  (aX : X ⟶ Spec (.of k)) (aZ : Z ⟶ Spec (.of k))
  [LocallyOfFiniteType aX] [QuasiCompact aX] [LocallyOfFiniteType aZ] [QuasiCompact aZ]
  [IsSeparated aX] [IsSeparated aZ] [HasCompactification aX] [HasCompactification aZ]
  [(R(aX)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] [(R(aZ)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint]
  (i : Z ⟶ X) (hi : i ≫ aX = aZ) [IsClosedImmersion i] [HasCompactification i]
  [(R(i)_![ModuleCat.{u + 1} Λ]).IsLeftAdjoint] (j : U ⟶ X) [IsOpenImmersion j]
  [QuasiCompact j] (hij : Set.range i.base = (Set.range j.base)ᶜ)

/-- The adjunction `i_* ⊣ Ri^!` on `Dᵇc(-, Λ)` given by the restriction of the exceptional
inverse image `Ri^!` (the derived limit `R lim_n Res_n Ri_n^! K_n` of blueprint
`def-weil-exceptional-inverse-image`, by
`AlgebraicGeometry.Etale.boundedConstructibleIntegral_exceptionalAdjoint`), under the hypotheses
providing the exceptional adjunction on `D(X_ét, Λ)`. Without them, the right adjoint of `i_*`
is `AlgebraicGeometry.Etale.boundedConstructibleIntegralClosedUpperShriek`, and the two agree
(`AlgebraicGeometry.Etale.boundedConstructibleIntegralClosedUpperShriekIso`).
Blueprint `prop-sf-localization-all-stages` (integral stage `𝒪_E`). -/
noncomputable def boundedConstructibleIntegralRightDerivedLowerStarUpperShriekAdjunction :
    boundedConstructibleIntegralRightDerivedLowerStar I aX i ⊣
      boundedConstructibleIntegralRightDerivedUpperShriek I hϖ hI aX aZ i hi :=
  (rightDerivedLowerStarUpperShriekAdjunction Λ i).restrictFullyFaithful
    (ObjectProperty.fullyFaithfulι _) (ObjectProperty.fullyFaithfulι _) (Iso.refl _) (Iso.refl _)

/-- Blueprint `prop-sf-localization-all-stages`, clause (2) at the integral stage `𝒪_E`: when
`D(X_ét, Λ)` carries the exceptional adjunction `Ri_! ⊣ Ri^!`, the right adjoint `Ri^!` of
`i_* : Dᵇc(Z, Λ) ⥤ Dᵇc(X, Λ)` built by the recollement argument is the restriction of the
exceptional inverse image `Ri^!`: both are right adjoint to `i_*`. -/
noncomputable def boundedConstructibleIntegralClosedUpperShriekIso :
