module

public import Sheaf.AlgebraicGeometry.ProEtaleCompletedCoefficients
public import WeilConjectures.CategoryTheory.ModuleObjects.Abelian
import Mathlib.CategoryTheory.Sites.Limits
import Mathlib.CategoryTheory.Sites.LocallyBijective
import WeilConjectures.AlgebraicGeometry.SiteSheafificationSectionsLocal
import Sheaf.Paper.CompletedCondensedCoefficients

/-!
# Reduction of pulled-back condensed ell-adic integers

Source: blueprint main-20261015, sec-proetale-coefficients,
`sk-def-sp-tate-twist/_section.md`, integral coefficient comparison, and
`sk-prop-sfb-qlbar-colimit-x/_section.md`, final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power).

The reduction is the normalized integral-limit projection of the recorded completed
coefficient comparison. The quotient is the actual cokernel of scalar multiplication
in sheaves of modules. Its ring structure is characterized by the quotient projection
being a ring map. The comparison is simultaneously a ring and module isomorphism.
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace AlgebraicGeometry.ProEtale

/-- The normalized integral-limit reduction cone on the point, supplied by the completed
coefficient comparison. Its projections are uniquely determined: after restriction to
every point of a profinite set, the normalization is the usual quotient of `ℤ_[ℓ]`.
Source: completed-coefficient proposition, integral comparison and final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlPointReduction (ℓ : ℕ) [Fact ℓ.Prime] :
    (Functor.const ℕᵒᵖ).obj (Mon.mk (Profinite.continuousMapRingObj.{u} ℤ_[ℓ])) ⟶
      sfbCoefficientQuotientTower ℤ_[ℓ]
        (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ⋙ sfbPointConstantRing :=
  (sfb_completed_coefficients.{u} ℓ).2.1.choose

/-- The normalized identification of the integral quotient tower with the `ZMod` tower.
The comparison theorem fixes every component on every quotient class.
Source: completed-coefficient proposition, final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlResidueTowerIso (ℓ : ℕ) [Fact ℓ.Prime] :
    sfbCoefficientQuotientTower ℤ_[ℓ]
      (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ≅ sfbZModCoefficientTower.{u} ℓ :=
  (sfb_completed_coefficients.{u} ℓ).2.2.1.choose

/-- Pullback of the finite constant quotient tower to `X`. This is the ring comparison
from the integral-limit theorem, not a choice of an unstructured sheaf isomorphism.
Each finite quotient is a cyclic ring; its constant sheaf, and its inverse image, are
locally generated by the unit as rings. Consequently a ring comparison between these
constant sheaves is unique, including at exponent zero and on the empty scheme.
Source: completed-coefficient proposition, integral comparison
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlConstantPullbackIso (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) :
    (sfbCoefficientQuotientTower ℤ_[ℓ]
      (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ⋙ sfbPointConstantRing ⋙
        (upperStarFromPoint X).mapMon) ≅
      (sfbCoefficientQuotientTower ℤ_[ℓ]
        (Ideal.span ({(ℓ : ℤ_[ℓ])} : Set ℤ_[ℓ])) ⋙ sfbConstantRing X) :=
  ((sfb_completed_coefficients.{u} ℓ).2.1.choose_spec.2.1 X).2.some

/-- The canonical reduction `ρ_r`: pull back the normalized integral-limit projection,
identify the pulled-back finite constant ring, then use its normalized `ZMod` presentation.
These are precisely the projections of the integral comparison at `E = ℚ_[ℓ]`.
Source: completed-coefficient proposition, final paragraph; Tate twists, integral comparison
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlReduction (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) (r : ℕ) :
    coefficientRing X (Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ])) ⟶
      (sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r)) :=
  (upperStarFromPoint X).mapMon.map ((purZlPointReduction ℓ).app (op r)) ≫
    (purZlConstantPullbackIso ℓ X).hom.app (op r) ≫
      (sfbConstantRing X).map ((purZlResidueTowerIso ℓ).hom.app (op r))

/-- Multiplication by `ℓ^r` on the regular module of the pulled-back condensed integers.
Source: Tate twists, integral coefficient comparison, image ideal `ℓ^r R_X`
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlPowerMultiplication (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (r : ℕ) :=
  ℓ ^ r • 𝟙 (Mod.regular (condensedRingObj (Profinite.continuousMapRingObj ℤ_[ℓ]) X))

/-- The sheaf quotient by the image ideal of multiplication by `ℓ^r`, computed as the
cokernel in modules, whose underlying abelian sheaf is also the sheaf cokernel.
Source: Tate twists, integral coefficient comparison; Stacks, Tag 00WH
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlQuotient (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) (r : ℕ) :=
  Mod.cokernelObj (purZlPowerMultiplication ℓ X r)

/-- The quotient projection, with its actual induced `R_X`-module structure.
Source: Tate twists, integral coefficient comparison; Stacks, Tag 00WH
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlQuotientProjection (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) (r : ℕ) :=
  Mod.cokernelπ (purZlPowerMultiplication ℓ X r)

/-- The finite residue sheaf with scalar action through the canonical reduction `ρ_r`.
Source: Tate twists, integral coefficient comparison, module assertion
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power). -/
noncomputable def purZlResidueModule (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{u}) (r : ℕ) :=
  (Mod.comap (purZlReduction ℓ X r).hom).obj
    (Mod.regular ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op r))).X)

/-- Reduction identifies the sheaf quotient by `ℓ^r` with the finite constant residue
sheaf, as rings and as modules over the pulled-back condensed integers, compatibly at
all positive exponents. `n + 1` ranges over exactly the positive integers.
The ring structures below are quotient-ring structures, since their projections are
ring maps; the projection is epimorphic, so this characterizes their operations.

Source: blueprint main-20261015, Tate twists, integral coefficient comparison, and
completed-coefficient proposition, final paragraph
(blueprint: lem-pur-condensed-zl-reduction-mod-ell-power).

Proof:
1. Use sk-prop-sfb-qlbar-colimit-x at `E = ℚ_ℓ`. Its normalized integral cone gives the
   displayed reductions. Limits of sheaves are sectionwise by
   lem-weil-pbc-site-sheaf-sets-limits-sectionwise, with coordinatewise ring operations.
2. The label map `Z/ℓ^n → Z/ℓ^(n+r)`, `k ↦ ℓ^r k`, is injective, with image the kernel
   of reduction to `Z/ℓ^r`, by integer divisibility and cancellation of `ℓ^r`.
   Constant-sheaf local representatives and local equality
   (lem-weil-pbc-site-sheafification-sections-local) give the same assertion on sections:
   local divided labels agree uniquely and glue.
3. If a compatible tuple has r-th coordinate zero, divide its (n+r)-th coordinates
   uniquely as in Step 2. Uniqueness makes the divided coordinates compatible; their
   tuple is a section whose product with `ℓ^r` is the original section. Conversely every
   such multiple reduces to zero. Thus the kernel equals the image ideal sheaf.
4. Every finite constant section is locally a label. An integer representative gives
   a compatible tuple lifting that label. This proves local surjectivity; the lifts
   need not glue as sections of the original ring.
5. The presheaf of quotient rings, using def-weil-pbc-algebra-hom-quotient, is locally
   bijective onto the residue sheaf. Its sheafification is therefore isomorphic to it
   by lem-weil-pbc-site-sheafification-iso-locally-bijective. The universal property of
   def-weil-pbc-sheafification identifies this with the cokernel sheaf quotient used
   here. Ring operations descend and the projection is a ring map. Locally the
   comparison sends the class of x to `ρ_r(x)`, so it and its inverse preserve products
   and units, and it is linear for the scalar action through `ρ_r`.
6. Limit projections satisfy `ρ_r = ρ_(r+1)` followed by finite reduction. Inclusion
   of successive image ideals induces the quotient transition, uniquely determined
   by the quotient projections. The two comparison composites agree on every local
   quotient representative, proving the final commuting square.
-/
theorem pur_condensed_zl_reduction_mod_ell_power (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) :
    ∃ (m : ∀ n : ℕ, MonObj (purZlQuotient ℓ X (n + 1)).X)
      (e : ∀ n : ℕ, purZlQuotient ℓ X (n + 1) ≅ purZlResidueModule ℓ X (n + 1)),
      (∀ n : ℕ,
        @IsMonHom _ _ _ _ _
          (coefficientRing X (Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ]))).mon
          (m n) (purZlQuotientProjection ℓ X (n + 1)).hom ∧
        @IsMonHom _ _ _ _ _ (m n)
          ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op (n + 1)))).mon
          (e n).hom.hom ∧
        @IsMonHom _ _ _ _ _
          ((sfbConstantRing X).obj ((sfbZModCoefficientTower ℓ).obj (op (n + 1)))).mon
          (m n) (e n).inv.hom ∧
        (purZlQuotientProjection ℓ X (n + 1)).hom ≫ (e n).hom.hom =
          (purZlReduction ℓ X (n + 1)).hom) ∧
      (∀ n : ℕ,
        purZlReduction ℓ X (n + 2) ≫
          (sfbZModCoefficientTower ℓ ⋙ sfbConstantRing X).map
            (homOfLE (Nat.le_succ (n + 1))).op = purZlReduction ℓ X (n + 1)) ∧
      (∀ n : ℕ, ∃ t : purZlQuotient ℓ X (n + 2) ⟶ purZlQuotient ℓ X (n + 1),
        purZlQuotientProjection ℓ X (n + 2) ≫ t = purZlQuotientProjection ℓ X (n + 1) ∧
        t.hom ≫ (e n).hom.hom =
          (e (n + 1)).hom.hom ≫
            ((sfbZModCoefficientTower ℓ ⋙ sfbConstantRing X).map
              (homOfLE (Nat.le_succ (n + 1))).op).hom) := by
  sorry

end AlgebraicGeometry.ProEtale
