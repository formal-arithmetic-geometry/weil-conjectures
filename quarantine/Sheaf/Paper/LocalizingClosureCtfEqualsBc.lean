/-!
# Constructible finite Tor objects and bounded constructible objects

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
node det-def-localizing-closure-ctf-equals-bc (blueprint: det-def-localizing-closure-ctf-equals-bc).
-/

@[expose] public section

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry Scheme
open AlgebraicGeometry.ProEtale
open scoped CategoryTheory.Obj
open scoped MonoidalCategory

namespace AlgebraicGeometry.ProEtale

/-- The scalar residue module used in the finite-ring examples: the quotient of
`ℤ/ℓ²` by the ideal generated by `ℓ`.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
abbrev scalarResidue (ℓ : ℕ) : Type :=
  let A := ZMod (ℓ ^ 2)
  A ⧸ Ideal.span ({(ℓ : A)} : Set A)

/-- Multiplication by a scalar as a morphism of module objects.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
noncomputable def scalarMulHom (A : Type u) [CommRing A] (a : A) :
    ModuleCat.of A A ⟶ ModuleCat.of A A :=
  ModuleCat.ofHom (LinearMap.mulLeft A a)

/-- The two-term complex `[A \xrightarrow{ℓ} A]`, represented by a mapping cone.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
noncomputable def scalarTwoTermComplex (ℓ : ℕ) :
    DerivedCategory (ModuleCat.{0} (ZMod (ℓ ^ 2))) :=
  let A := ZMod (ℓ ^ 2)
  let F := CochainComplex.singleFunctor (ModuleCat.{0} A) 0
  let f : F.obj (ModuleCat.of A A) ⟶ F.obj (ModuleCat.of A A) :=
    F.map (scalarMulHom A (ℓ : A))
  DerivedCategory.Q.obj (CochainComplex.mappingCone f)

/-- Scalar and cohomology assertions for the `ℤ/ℓ²` periodic-resolution example.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
def scalarFiniteRingExample (ℓ : ℕ) : Prop :=
  Module.Finite (ZMod (ℓ ^ 2)) (scalarResidue ℓ) ∧
  ¬ ModuleCat.HasFiniteProjectiveDimension
    (ModuleCat.of (ZMod (ℓ ^ 2)) (scalarResidue ℓ)) ∧
  DerivedCategory.IsPerfectRingComplex (scalarTwoTermComplex ℓ) ∧
  ¬ DerivedCategory.IsPerfectRingComplex
    ((DerivedCategory.singleFunctor (ModuleCat.{0} (ZMod (ℓ ^ 2))) 0).obj
      (ModuleCat.of (ZMod (ℓ ^ 2)) (scalarResidue ℓ)))

/-- The residue module over the condensed coefficient ring on the point.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
noncomputable def constantResidueModule (ℓ : ℕ) :
    CategoryTheory.Mod (Sheaf (coherentTopology Profinite) Ab)
      (Profinite.continuousCoefficientRingObj (ZMod (ℓ ^ 2))) := by
  let Λ := Profinite.continuousCoefficientRingObj (ZMod (ℓ ^ 2))
  let C := CategoryTheory.Mod (Sheaf (coherentTopology Profinite) Ab) Λ
  let e : 𝟙_ C ⟶ 𝟙_ C := 𝟙 _
  exact cokernel ((ℓ : ℕ) • e)

/-- Pull the residue module to the small pro-étale site of a separably closed point.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
noncomputable def constantResidueModuleOnSpec (ℓ : ℕ) (k : Type) [Field k] :
    CategoryTheory.Mod
      (Sheaf (Scheme.ProEt.topology
        (Scheme.Spec.obj (Opposite.op (CommRingCat.of k)))) Ab)
      (condensedRingObj (Profinite.continuousCoefficientRingObj (ZMod (ℓ ^ 2)))
        (Scheme.Spec.obj (Opposite.op (CommRingCat.of k)))) :=
  (((upperStarFromPoint (Scheme.Spec.obj (Opposite.op (CommRingCat.of k)))).mapMod
    (Profinite.continuousCoefficientRingObj (ZMod (ℓ ^ 2)))).obj
    (constantResidueModule ℓ))

/-- The constant-sheaf residue module has infinite Tor amplitude at a separably closed point.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
def constantFiniteRingExample (ℓ : ℕ) : Prop :=
  ∀ (k : Type) [Field k] [IsSepClosed k],
    let X := Scheme.Spec.obj (Opposite.op (CommRingCat.of k))
    let Λ := Profinite.continuousCoefficientRingObj (ZMod (ℓ ^ 2))
    let M := constantResidueModuleOnSpec ℓ k
    IsConstantModelConstructible Λ X M ∧
      ¬ DerivedCategory.finiteTorAmplitude _
        ((DerivedCategory.singleFunctor _ 0).obj M)

/-- Failure of finite-coefficient `Dctf` truncation stability at a separably closed point.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
def finiteRingTruncationFailure (ℓ : ℕ) : Prop :=
  ∀ (k : Type) [Field k] [IsSepClosed k],
    let X := Scheme.Spec.obj (Opposite.op (CommRingCat.of k))
    let Λ := Profinite.continuousCoefficientRingObj (ZMod (ℓ ^ 2))
    ∃ K : DerivedCategory
      (CategoryTheory.Mod (Sheaf (Scheme.ProEt.topology X) Ab)
        (condensedRingObj Λ X)),
      (constantModelBoundedConstructible Λ X ⊓ DerivedCategory.finiteTorAmplitude _) K ∧
      ¬ (constantModelBoundedConstructible Λ X ⊓ DerivedCategory.finiteTorAmplitude _)
        ((DerivedCategory.TStructure.t.truncGE 0).obj K)

/-- The Tor-amplitude, boundedness, and localizing-closure assertions for the five
coefficient rings in the source statement. The degree-zero object associated to a module
is represented by `DerivedCategory.singleFunctor`.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
clauses 1--2 and finite-ring examples.
(blueprint: det-def-localizing-closure-ctf-equals-bc). -/
def localizingClosureCtfEqualsBcAssertions
    (ℓ : ℕ) (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ]
    [IsCommMonObj Λ] (X : Scheme.{u}) : Prop :=
  (∀ (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)),
    IsConstantModelConstructible Λ X M →
      DerivedCategory.torAmplitudeIn
        (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))
        (-1 : ℤ) 0 ((DerivedCategory.singleFunctor
          (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)) 0).obj M)) ∧
  (∀ (K : DerivedCategory
      (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)))
      (a b : ℤ), a ≤ b →
      constantModelBoundedConstructible Λ X K →
      DerivedCategory.homologyConcentratedIn a b K →
      DerivedCategory.torAmplitudeIn
        (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))
        (a - 1) b K) ∧
  ((constantModelBoundedConstructible Λ X ⊓ DerivedCategory.finiteTorAmplitude _) =
    constantModelBoundedConstructible Λ X) ∧
  (CategoryTheory.localizingClosure
      (constantModelBoundedConstructible Λ X ⊓ DerivedCategory.finiteTorAmplitude _) =
    CategoryTheory.localizingClosure (constantModelBoundedConstructible Λ X)) ∧
  (∀ (A : Type u) [CommRing A] [Finite A] [TopologicalSpace A]
      [DiscreteTopology A] [IsTopologicalRing A]
      (T : Scheme.{u}) [CompactSpace T] [QuasiSeparatedSpace T],
    (constantModelBoundedConstructible (Profinite.continuousCoefficientRingObj A) T ⊓
      DerivedCategory.finiteTorAmplitude _).IsTriangulated ∧
    (constantModelBoundedConstructible (Profinite.continuousCoefficientRingObj A) T ⊓
      DerivedCategory.finiteTorAmplitude _).IsStableUnderRetracts) ∧
  scalarFiniteRingExample ℓ ∧
  constantFiniteRingExample ℓ ∧
  finiteRingTruncationFailure ℓ

/-- For a prime `ℓ`, an algebraic closure of `ℚ_ℓ`, and a finite extension `E`, every
qcqs scheme has the stated Tor bounds for the integral and field coefficient cases; hence
`Dᵇ_ctf = Dᵇ_c` and their localizing closures agree. The final conjunction records the
field specialization of the first bound. The scalar perfectness convention is the
`DerivedCategory.IsPerfectRingComplex` predicate from the cited definition node.

Source: blueprint main-20261015, sec-proetale-coefficients/sk-def-localizing-closure,
node det-def-localizing-closure-ctf-equals-bc (blueprint: det-def-localizing-closure-ctf-equals-bc).

Proof plan, following the twelve source steps: (1) evaluate the condensed coefficient ring
at the point and construct finite free resolutions over the DVRs and fields, including the
zero and rank-zero cases; (2) pull those exact scalar sequences to constant sheaves and use
the integral flatness criterion to obtain local models; (3) use finite direct sums, K-flatness,
and the derived tensor projection formula to compute the local Tor interval; (4) prove cover
locality by exact slice restriction, compatibility with derived tensor, and joint conservativity;
(5) induct on the number of constructible strata, choosing an affine neighbourhood with a
closed stratum and quasi-compact open complement; (6) pull the presentations to the closed and
open pieces, using the canonical module pullback and dropping the empty strata; (7) apply the
open--closed exact sequence to detect vanishing of tensor cohomology and conclude the module
bound; (8) induct on the cohomological interval using the truncation triangle, the homology
long exact sequence, the single-cohomology base case, and the extension rule; (9) identify
`Dctf` with `Dbc` object by object and use the defining intersections for their localizing
closures; (10) for a finite discrete ring, transfer the finite locally constant description
through the classical-sheaf equivalence and deduce Serre, triangulated, and retract closure;
(11) for `A = ℤ/ℓ²`, use the periodic multiplication-by-`ℓ` resolution to show the residue
module is constructible but has infinite projective dimension, and pull the same example to
`Spec k` for separably closed `k`; (12) use the bounded two-term finite-free complex to show
perfectness of the whole complex while both residue cohomology modules are nonperfect, and
apply its standard truncations to exhibit failure of truncation stability. The scalar notion
of perfectness in steps 11--12 is `DerivedCategory.IsPerfectRingComplex`.
-/
theorem localizingClosure_ctf_equals_bc
    (ℓ : ℕ) [Fact ℓ.Prime]
    (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X]
    (Λ : Sheaf (coherentTopology Profinite.{u}) Ab.{u + 1}) [MonObj Λ]
    [IsCommMonObj Λ]
    (hΛ :
      Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.continuousMapRingObj ℤ_[ℓ])) ∨
      Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.continuousMapRingObj ℚ_[ℓ])) ∨
      (∃ E : PadicAlgCl.FiniteIntermediateField ℓ,
        Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.padicIntegersRingObj ℓ E.1)) ∨
        Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.continuousMapRingObj E.1))) ∨
      Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.padicAlgClRingObj ℓ))) :
    localizingClosureCtfEqualsBcAssertions ℓ Λ X ∧
    ((Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.continuousMapRingObj ℚ_[ℓ])) ∨
      (∃ E : PadicAlgCl.FiniteIntermediateField ℓ,
        Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.continuousMapRingObj E.1))) ∨
      Nonempty (Mon.mk Λ ≅ Mon.mk (Profinite.padicAlgClRingObj ℓ))) →
      ∀ (M : Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X)),
        IsConstantModelConstructible Λ X M →
          DerivedCategory.torAmplitudeIn
            (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1}) (condensedRingObj Λ X))
            0 0 ((DerivedCategory.singleFunctor
              (Mod (Sheaf (Scheme.ProEt.topology X) Ab.{u + 1})
                (condensedRingObj Λ X)) 0).obj M)) := by
  sorry

end AlgebraicGeometry.ProEtale
