module

public import WeilConjectures.RingTheory.IsStrictHenselization
public import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Ideal
import Sheaf.RingTheory.StrictHenselizationSurjectiveQuotient

/-! # Divisor quotients of algebraic strict henselizations of prime localizations

Source: Stacks Project, Tag 05WS (strict henselization of a quotient), and localization
of a quotient, as in Mathlib.RingTheory.Localization.Ideal.
(blueprint: lem-sbc-algebraic-strict-henselization-localized-divisor-quotient)
-/

@[expose] public section

universe u
namespace Algebra

/-- Quotient compatibility for an algebraic strict henselization of R_q, with f in q.
The ring C and its structural map are arbitrary; no geometric construction is assumed.
Source: Stacks Project, Tag 05WS, with localization of quotients.
(blueprint: lem-sbc-algebraic-strict-henselization-localized-divisor-quotient)

Proof: Set A = R_q and a = f/1. Since f belongs to q, a belongs to the maximal ideal of
A, so I = (a) is contained in that maximal ideal. Let p be the image of q in R/(f).
The containment (f) <= q makes p prime and its inverse image is q. The quotient
localization theorem gives the canonical ring isomorphism A/I = (R/(f))_p, sending the
class of r/s to the fraction of the classes of r and s. It identifies the residue fields
because their maximal ideals are the images of q. Transport the given separable closure
K along this residue-field isomorphism, with its base action factoring through the residue
field. By Tag 05WS, C/IC is the strict henselization of A/I for that closure. In the
pointed etale description, base change modulo I sends the original etale diagram to the
quotient diagram; lifting pointed etale presentations across the quotient is cofinal,
and tensoring the universal cocone with A/I preserves its colimit. The compatibility
hbase identifies IC with (b(f)), since extension of a principal ideal is generated by
the image of its generator. Transport the base-algebra structure and the universal
cocone along the two ring isomorphisms. The resulting pointed algebra cocone proves
Algebra.IsStrictHenselization over (R/(f))_p. This works for f = 0 as well; no regularity,
Noetherianity, or nonzerodivisor hypothesis enters. -/
theorem IsStrictHenselization.localized_divisor_quotient
    (R C : Type u) [CommRing R] [CommRing C]
    (q : Ideal R) [q.IsPrime]
    (K : Type u) [Field K]
    [Algebra (IsLocalRing.ResidueField (Localization.AtPrime q)) K]
    [IsSepClosure (IsLocalRing.ResidueField (Localization.AtPrime q)) K]
    [Algebra (Localization.AtPrime q) K]
    [IsScalarTower (Localization.AtPrime q)
      (IsLocalRing.ResidueField (Localization.AtPrime q)) K]
    [Algebra (Localization.AtPrime q) C]
    (hC : IsStrictHenselization (Localization.AtPrime q) K C)
    (b : R →+* C)
    (hbase : ∀ r : R, algebraMap (Localization.AtPrime q) C
      (algebraMap R (Localization.AtPrime q) r) = b r)
    (f : R) (hf : f ∈ q) :
    ∃ (p : Ideal (R ⧸ Ideal.span {f})) (_ : p.IsPrime)
      (L : Type u) (_ : Field L)
      (_ : Algebra (IsLocalRing.ResidueField (Localization.AtPrime p)) L)
      (_ : IsSepClosure (IsLocalRing.ResidueField (Localization.AtPrime p)) L)
      (_ : Algebra (Localization.AtPrime p) L)
      (_ : IsScalarTower (Localization.AtPrime p)
        (IsLocalRing.ResidueField (Localization.AtPrime p)) L)
      (_ : Algebra (Localization.AtPrime p) (C ⧸ Ideal.span {b f})),
      IsStrictHenselization (Localization.AtPrime p) L
        (C ⧸ Ideal.span {b f}) := by
  classical
  let J : Ideal R := Ideal.span {f}
  let p : Ideal (R ⧸ J) := q.map (Ideal.Quotient.mk J)
  have hJ : J ≤ q := (Ideal.span_singleton_le_iff_mem q).mpr hf
  have hp : p.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by simpa only [Ideal.mk_ker] using hJ)
  let := hp
  let A := Localization.AtPrime q
  let I : Ideal A := J.map (algebraMap R A)
  have hcomap : p.comap (Ideal.Quotient.mk J) = q := by
    change (q.map (Ideal.Quotient.mk J)).comap (Ideal.Quotient.mk J) = q
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
    change q ⊔ RingHom.ker (Ideal.Quotient.mk J) = q
    rw [Ideal.mk_ker, sup_eq_left.mpr hJ]
  have hmonoid : Algebra.algebraMapSubmonoid (R ⧸ J) q.primeCompl = p.primeCompl := by
    change q.primeCompl.map (Ideal.Quotient.mk J) = p.primeCompl
    simpa only [hcomap] using
      Ideal.map_primeCompl_comap_of_surjective
        (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective p
  have hloc : IsLocalization p.primeCompl (A ⧸ I) := by
    rw [← hmonoid]
    exact inferInstance
  let e : (A ⧸ I) ≃+* Localization.AtPrime p :=
    (IsLocalization.algEquiv p.primeCompl (A ⧸ I) (Localization.AtPrime p)).toRingEquiv
  let π : A →+* Localization.AtPrime p := e.toRingHom.comp (Ideal.Quotient.mk I)
  have hπ : Function.Surjective π := e.surjective.comp Ideal.Quotient.mk_surjective
  have hker : RingHom.ker π = I := by
    rw [RingHom.ker_equiv_comp, Ideal.mk_ker]
  have hIeq : I = Ideal.span {algebraMap R A f} := by
    simp only [I, J, Ideal.map_span, Set.image_singleton]
  have hI : I ≤ IsLocalRing.maximalIdeal A := by
    rw [hIeq, Ideal.span_singleton_le_iff_mem]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff A q f).mpr hf
  have hquot := hC.surjective_quotient A K C (Localization.AtPrime p) π hπ I hI hker
  have hIC : I.map (algebraMap A C) = Ideal.span {b f} := by
    rw [hIeq, Ideal.map_span, Set.image_singleton, hbase f]
  refine ⟨p, hp, ?_⟩
  rw [hIC] at hquot
  exact hquot

end Algebra
